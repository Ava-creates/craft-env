urn to face the workshop before using it\n  target_direction = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0])\n  current_angle = env._current_state.dir * (np.pi / 2)  # Convert direction index to angle\n\n  delta_angle = target_direction - current_angle\n  if delta_angle < 0:\n      delta_angle += 2 * np.pi\n\n  while delta_angle >= np.pi / 4:\n      actions.append(3)  # Turn right\n      current_angle += np.pi / 2\n      delta_angle -= np.pi / 2\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 6, "scores": {"3": 3.7}}
{"timestamp": "2025-09-06T16:00:26.965561", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Calculate the path to the closest workshop position using A* algorithm\n  grid_width, grid_height = env._current_state.grid.shape[:2]\n  open_set = collections.PriorityQueue()\n  open_set.put((0, pos))\n  came_from = {}\n  g_score = {tuple(pos): 0}\n  f_score = {tuple(pos): min_distance}\n\n  while not open_set.empty():\n      _, current_pos = open_set.get()\n\n      if np.array_equal(current_pos, nearest_target_pos):\n          break\n\n      for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n          neighbor = current_pos + [dx, dy]\n\n          if 0 <= neighbor[0] < grid_width and 0 <= neighbor[1] < grid_height:\n              tentative_g_score = g_score[tuple(current_pos)] + 1\n\n              if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n                  came_from[tuple(neighbor)] = current_pos\n                  g_score[tuple(neighbor)] = tentative_g_score\n                  f_score[tuple(neighbor)] = tentative_g_score + np.linalg.norm(nearest_target_pos - neighbor, ord=2)\n                  open_set.put((f_score[tuple(neighbor)], neighbor))\n\n  if nearest_target_pos not in came_from:\n      raise ValueError(\"No path to workshop found\")\n\n  # Reconstruct the path\n  current_pos = tuple(nearest_target_pos)\n  path = []\n  while current_pos != tuple(pos):\n      path.append(current_pos)\n      current_pos = came_from[current_pos]\n  path.reverse()\n\n  for next_pos in path:\n      dx, dy = np.array(next_pos) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T16:02:31.883080", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          # Find the nearest workshop position to the agent's current position\n          nearest_workshop_pos = None\n          min_nearest_distance = float('inf')\n\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_nearest_distance:\n                  nearest_workshop_pos = target_pos\n                  min_nearest_distance = distance\n\n          # Check if this is the closest workshop to the agent\n          if min_nearest_distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = min_nearest_distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = np.array(nearest_workshop_pos)\n\n  # Move to the closest workshop position while considering direction changes\n  target_directions = [\n      (1, 0), (-1, 0), (0, 1), (0, -1)  # RIGHT, LEFT, DOWN, UP\n  ]\n\n  current_direction = None\n\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = (1 if dx > 0 else -1, 0)\n      else:  # Then move in y-direction\n          direction = (0, 1 if dy > 0 else -1)\n\n      if current_direction != direction:\n          # Determine the action based on the direction to move\n          actions.append(target_directions.index(direction))\n          current_direction = direction\n\n      pos += np.array(direction)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 1.0}}
{"timestamp": "2025-09-06T16:02:33.047004", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          # Find the nearest workshop position to the agent's current position\n          nearest_workshop_pos = None\n          min_nearest_distance = float('inf')\n\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_nearest_distance:\n                  nearest_workshop_pos = target_pos\n                  min_nearest_distance = distance\n\n          # Check if this is the closest workshop to the agent\n          if min_nearest_distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = min_nearest_distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = np.array(nearest_workshop_pos)\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n      else:  # If both directions are equal, choose one direction to prioritize (e.g., x-direction)\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:05:11.156922", "function_name": "craft", "function_body": "  def move_towards(pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - pos\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n              dx = target_pos[0] - pos[0]\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n              dy = target_pos[1] - pos[1]\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n  actions.extend(move_towards(pos, nearest_target_pos))\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:05:12.140583", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* algorithm\n  def heuristic(a, b):\n      return np.abs(a[0] - b[0]) + np.abs(a[1] - b[1])\n\n  def a_star(start, goal):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {tuple(start): 0}\n      f_score = {tuple(start): heuristic(start, goal)}\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if np.array_equal(current, goal):\n              path = []\n              while tuple(current) in came_from:\n                  path.append(tuple(current))\n                  current = came_from[tuple(current)]\n              path.reverse()\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = tuple(np.array(current) + np.array((dx, dy)))\n              tentative_g_score = g_score[tuple(current)] + heuristic(tuple(current), neighbor)\n\n              if not (0 <= neighbor[0] < env._current_state.grid.shape[0] and 0 <= neighbor[1] < env._current_state.grid.shape[1]):\n                  continue\n\n              if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.put((f_score[neighbor], neighbor))\n\n      return None\n\n  path = a_star(tuple(pos), tuple(nearest_target_pos))\n  \n  if not path:\n      raise ValueError(\"No path to workshop found\")\n\n  # Convert the path into actions\n  for next_step in path[1:]:  # Skip the start position which is the current position\n      dx, dy = np.array(next_step) - pos\n      if dx > 0:\n          actions.append(3)\n      elif dx < 0:\n          actions.append(2)\n      elif dy > 0:\n          actions.append(1)\n      else:  # dy < 0\n          actions.append(0)\n      \n      pos = np.array(next_step)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-06T16:12:21.638832", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  def find_closest_workshop(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  closest_workshop_idx = find_closest_workshop(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  def find_nearest_target_pos(workshop_idx):\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos, min_distance = None, float('inf')\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_distance:\n              nearest_target_pos = target_pos\n              min_distance = distance\n      return nearest_target_pos\n\n  nearest_target_pos = find_nearest_target_pos(closest_workshop_idx)\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n      else:  # If both directions are equally close, choose one direction to break the tie\n          actions.append(3)  # Move right by default\n          pos[0] += 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-06T16:12:22.699588", "function_name": "craft", "function_body": "  def move_to_target(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  def find_closest_workshop(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx, min_distance\n\n  closest_workshop_idx, _ = find_closest_workshop(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  def find_nearest_target_pos(workshop_idx):\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos, min_distance = None, float('inf')\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_distance:\n              nearest_target_pos = target_pos\n              min_distance = distance\n      return nearest_target_pos\n\n  nearest_target_pos = find_nearest_target_pos(closest_workshop_idx)\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:13:15.892024", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos, workshop_indices):\n      nearest_target_pos = None\n      min_distance = float('inf')\n      \n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          nearest_workshop_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n          distance = np.linalg.norm(nearest_workshop_pos - pos)\n\n          if distance < min_distance:\n              min_distance = distance\n              nearest_target_pos = nearest_workshop_pos\n      \n      return nearest_target_pos\n\n  def move_towards(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  target_pos = find_closest_workshop(env._current_state.grid, np.array(env._current_state.pos), env.world.workshop_indices)\n\n  if target_pos is None:\n      raise ValueError(\"No workshop found for crafting the item\")\n\n  # Move towards and use the closest workshop\n  actions = move_towards(env, target_pos)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:13:16.972325", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos, workshop_indices):\n      # Calculate distances to each type of workshop and keep the minimum distance\n      min_distance = float('inf')\n      nearest_target_pos = None\n\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          distances = np.linalg.norm(workshop_pos_list - pos, axis=1)\n          nearest_pos = workshop_pos_list[np.argmin(distances)]\n\n          if distances.min() < min_distance:\n              min_distance = distances.min()\n              nearest_target_pos = nearest_pos\n\n      return nearest_target_pos\n\n  def move_towards_position(pos, target):\n      actions = []\n      \n      while not np.array_equal(pos, target):\n          dx, dy = target - pos\n          \n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  grid = env._current_state.grid\n  pos = np.array(env._current_state.pos)\n  nearest_workshop_pos = find_closest_workshop(grid, pos, env.world.workshop_indices)\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No workshop available to craft the item\")\n\n  # Generate actions to move towards and use the closest workshop\n  actions = move_towards_position(pos, nearest_workshop_pos)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:14:10.473439", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  target_positions = []\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          target_positions.extend(workshop_pos_list)\n\n  if not target_positions:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest target position\n  nearest_target_pos = min(target_positions, key=lambda pos2: np.linalg.norm(pos - pos2, ord=2))\n\n  # Calculate and append movement actions to move towards the nearest target position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
