{"timestamp": "2025-09-06T12:53:48.737565", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          nearest_target_pos = min(workshop_pos_list, key=lambda p: np.linalg.norm(pos - p))\n          distance = np.linalg.norm(pos - nearest_target_pos)\n\n          if distance < min_distance:\n              closest_workshop_idx, target_pos, min_distance = workshop_idx, nearest_target_pos, distance\n\n  if closest_workshop_idx is None or target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 6, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T12:56:46.646835", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  def find_closest_workshop(pos):\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      \n      for workshop_idx in workshop_indices:\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_positions) > 0:\n              mean_pos = workshop_positions.mean(axis=0)\n              distance = np.linalg.norm(pos - mean_pos, ord=2)\n\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_idx = workshop_idx\n      \n      return closest_workshop_idx\n\n  def find_nearest_position(workshop_idx):\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      distances = [np.linalg.norm(pos - tp, ord=2) for tp in workshop_positions]\n      nearest_target_pos = workshop_positions[np.argmin(distances)]\n      return nearest_target_pos\n\n  def calculate_move_actions(start, target):\n      actions = []\n      current_pos = start\n      \n      while not np.array_equal(current_pos, target):\n          dx, dy = target - current_pos\n\n          # Adjust movement priority based on remaining distance\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              direction = 3 if dx > 0 else 2\n              current_pos[0] += 1 if dx > 0 else -1\n          elif abs(dy) > abs(dx):  # Then move in y-direction\n              direction = 1 if dy > 0 else 0\n              current_pos[1] += 1 if dy > 0 else -1\n          else:\n              # If dx == dy, choose a random direction to break ties\n              direction = np.random.choice([3 if dx > 0 else 2, 1 if dy > 0 else 0])\n              actions.append(direction)\n              current_pos[0] += 1 if direction == 3 else -1 if direction == 2 else 0\n              current_pos[1] += 1 if direction == 1 else -1 if direction == 0 else 0\n      \n      return actions\n\n  pos = np.array(env._current_state.pos)\n  closest_workshop_idx = find_closest_workshop(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  target_pos = find_nearest_position(closest_workshop_idx)\n\n  # Calculate actions to move to the nearest position\n  move_actions = calculate_move_actions(pos, target_pos)\n  actions.extend(move_actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T12:56:47.675499", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Get the recipe for the desired item\n  recipe = cookbook.recipes.get(goal_index)\n  \n  if not recipe:\n      raise ValueError(f\"No crafting recipe found for {item}\")\n\n  def find_closest_workshop(pos, required_ingredients):\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      \n      for workshop_idx in workshop_indices:\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_positions) > 0:\n              mean_pos = workshop_positions.mean(axis=0)\n              distance = np.linalg.norm(pos - mean_pos, ord=2)\n\n              # Check if this workshop can craft the item\n              available_ingredients = env._current_state.inventory & set(recipe.keys())\n              if required_ingredients.issubset(available_ingredients) and distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_idx = workshop_idx\n      \n      return closest_workshop_idx\n\n  def find_nearest_position(workshop_idx):\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      distances = [np.linalg.norm(pos - tp, ord=2) for tp in workshop_positions]\n      nearest_target_pos = workshop_positions[np.argmin(distances)]\n      return nearest_target_pos\n\n  pos = np.array(env._current_state.pos)\n  \n  # Determine required ingredients\n  required_ingredients = set(recipe.keys())\n  \n  closest_workshop_idx = find_closest_workshop(pos, required_ingredients)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found that can craft the desired item\")\n\n  target_pos = find_nearest_position(closest_workshop_idx)\n\n  # Calculate actions to move to the nearest position\n  def calculate_move_actions(start, target):\n      actions = []\n      current_pos = start\n      \n      while not np.array_equal(current_pos, target):\n          dx, dy = target - current_pos\n\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              direction = 3 if dx > 0 else 2\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              direction = 1 if dy > 0 else 0\n              current_pos[1] += 1 if dy > 0 else -1\n\n          actions.append(direction)\n      \n      return actions\n\n  move_actions = calculate_move_actions(pos, target_pos)\n  actions.extend(move_actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T12:59:04.485792", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = np.argmax([abs(dx), abs(dy)])\n          if direction == 0:  # x-direction\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          elif direction == 1:  # y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  distances_to_workshops = {}\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = np.linalg.norm(pos - workshop_pos_list, axis=1)\n          nearest_target_pos = workshop_pos_list[np.argmin(distances)]\n          distance = np.min(distances)\n          distances_to_workshops[workshop_idx] = (distance, nearest_target_pos)\n\n  if not distances_to_workshops:\n      raise ValueError(\"No available workshop found\")\n\n  # Get the closest workshop based on their distances\n  closest_workshop_idx, (min_distance, nearest_target_pos) = min(distances_to_workshops.items(), key=lambda x: x[1][0])\n\n  # Move to the closest workshop position\n  actions.extend(move_towards(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T12:59:05.551515", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = np.argmax([abs(dx), abs(dy)])\n          if direction == 1:  # y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n          elif direction == 0:  # x-direction\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  distances_to_workshops = {}\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = np.linalg.norm(pos - workshop_pos_list, axis=1)\n          nearest_target_pos = workshop_pos_list[np.argmin(distances)]\n          distance = np.min(distances)\n          distances_to_workshops[workshop_idx] = (distance, nearest_target_pos)\n\n  # Get the closest workshops based on their distances\n  closest_workshops_indices = sorted(distances_to_workshops, key=lambda x: distances_to_workshops[x][0])\n\n  for workshop_idx in closest_workshops_indices:\n      distance, nearest_target_pos = distances_to_workshops[workshop_idx]\n\n      if distance < float('inf'):\n          # Move to the closest workshop position\n          actions.extend(move_towards(pos, nearest_target_pos))\n\n          # Use the workshop to craft the item\n          actions.append(4)  # USE\n\n          return actions\n\n  raise ValueError(\"No available workshop found\")", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T13:01:57.192648", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Ensure the agent faces the correct direction for the workshop\n  target_direction = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0])\n  current_direction = np.arctan2(env._current_state.dir[1], env._current_state.dir[0])\n\n  angle_diff = (target_direction - current_direction + 4*np.pi) % (2*np.pi)\n\n  if angle_diff < np.pi:\n      actions.append(3)  # Turn right\n  else:\n      actions.append(2)  # Turn left\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
