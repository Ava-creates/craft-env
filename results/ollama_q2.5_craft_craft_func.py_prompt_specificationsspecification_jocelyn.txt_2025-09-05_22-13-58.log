{"timestamp": "2025-09-06T02:45:19.747567", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  min_distance = float('inf')\n  target_workshop_idx = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          mean_pos = workshop_positions.mean(axis=0)\n          current_distance = np.linalg.norm(np.array(env._current_state.pos) - mean_pos, ord=2)\n\n          if current_distance < min_distance:\n              target_workshop_idx = workshop_idx\n              min_distance = current_distance\n\n  if target_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the closest position to move towards among all positions of the target workshop\n  nearest_pos = np.argwhere(env._current_state.grid[:, :, target_workshop_idx]).min(axis=0)\n  pos = np.array(env._current_state.pos)\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_pos):\n      dx, dy = nearest_pos - pos\n\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T02:45:20.727981", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  # Verify that the crafting action will succeed\n  recipe = cookbook.recipes.get(goal_index, {})\n  for ingredient_idx, count in recipe.items():\n      if ingredient_idx == \"_key\":\n          continue\n      if env._current_state.inventory[ingredient_idx] < count:\n          raise ValueError(f\"Not enough {cookbook.index.get(ingredient_idx)} to craft {item}\")\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T02:47:48.726998", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  min_distance = float('inf')\n  target_workshop_idx = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          mean_pos = workshop_positions.mean(axis=0)\n          current_distance = np.linalg.norm(np.array(env._current_state.pos) - mean_pos, ord=2)\n\n          if current_distance < min_distance:\n              target_workshop_idx = workshop_idx\n              min_distance = current_distance\n\n  if target_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the closest position to move towards among all positions of the target workshop\n  nearest_pos = np.argwhere(env._current_state.grid[:, :, target_workshop_idx]).min(axis=0)\n  pos = np.array(env._current_state.pos)\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_pos):\n      dx, dy = nearest_pos - pos\n\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T02:47:49.714765", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  min_distance = float('inf')\n  target_workshop_idx = None\n  current_pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          mean_pos = workshop_positions.mean(axis=0)\n          current_distance = np.linalg.norm(current_pos - mean_pos, ord=2)\n\n          if current_distance < min_distance:\n              target_workshop_idx = workshop_idx\n              min_distance = current_distance\n\n  if target_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the closest position to move towards among all positions of the target workshop\n  nearest_pos = np.argwhere(env._current_state.grid[:, :, target_workshop_idx]).min(axis=0)\n\n  # Calculate path using A* algorithm for optimal movement\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  def a_star(start, goal, grid_shape):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Directions: UP, DOWN, LEFT, RIGHT\n              neighbor = (current[0] + dx, current[1] + dy)\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n\n              if not (0 <= neighbor[0] < grid_shape[0] and 0 <= neighbor[1] < grid_shape[1]):\n                  continue\n\n              if neighbor in came_from and tentative_g_score >= g_score.get(neighbor, float('inf')):\n                  continue\n\n              came_from[neighbor] = current\n              g_score[neighbor] = tentative_g_score\n              f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              open_set.put((f_score[neighbor], neighbor))\n\n      return []\n\n  path = a_star(tuple(current_pos), tuple(nearest_pos), env._current_state.grid.shape[:2])\n\n  for next_pos in path:\n      dx, dy = np.array(next_pos) - current_pos\n\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          current_pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          current_pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": -1}}
