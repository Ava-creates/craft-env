pos[1] += 1 if dy > 0 else -1\n\n      # Ensure the agent faces the correct direction before using the workshop\n      current_direction = env._current_state.direction\n      target_direction = np.sign(nearest_target_pos - pos)\n\n      if target_direction[0] != 0:  # Moving horizontally\n          if target_direction[0] > 0 and current_direction != 3:\n              actions.append(3)  # Turn right\n              env._current_state.direction = 3\n          elif target_direction[0] < 0 and current_direction != 2:\n              actions.append(2)  # Turn left\n              env._current_state.direction = 2\n      else:  # Moving vertically\n          if target_direction[1] > 0 and current_direction != 1:\n              actions.append(1)  # Turn up\n              env._current_state.direction = 1\n          elif target_direction[1] < 0 and current_direction != 0:\n              actions.append(0)  # Turn down\n              env._current_state.direction = 0\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
