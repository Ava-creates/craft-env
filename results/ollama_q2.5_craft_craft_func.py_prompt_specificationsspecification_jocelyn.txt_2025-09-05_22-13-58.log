{"timestamp": "2025-09-06T09:37:24.195337", "function_name": "craft", "function_body": "  def move_to_target(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of the workshops\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = [np.linalg.norm(pos - tp, ord=2) for tp in workshop_pos_list]\n          nearest_target_pos = workshop_pos_list[np.argmin(distances)]\n          distance = np.linalg.norm(pos - nearest_target_pos, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the chosen workshop position\n  actions += move_to_target(pos, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T09:37:25.267925", "function_name": "craft", "function_body": "  def move_to_target(target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_workshops = []\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of the workshops\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = [np.linalg.norm(pos - tp, ord=2) for tp in workshop_pos_list]\n          nearest_target_pos = workshop_pos_list[np.argmin(distances)]\n          distance = np.linalg.norm(pos - nearest_target_pos, ord=2)\n\n          if distance < min_distance:\n              nearest_workshops = [(workshop_idx, nearest_target_pos)]\n              min_distance = distance\n          elif distance == min_distance:\n              nearest_workshops.append((workshop_idx, nearest_target_pos))\n\n  if not nearest_workshops:\n      raise ValueError(\"No available workshop found\")\n\n  # Randomly choose one of the nearest workshops\n  closest_workshop_idx, nearest_target_pos = nearest_workshops[np.random.choice(len(nearest_workshops))]\n\n  # Move to the chosen workshop position\n  actions.extend(move_to_target(nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T09:39:44.912792", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_workshop_pos, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_positions) == 0:  # Check if there is any location for the workshop\n          continue\n      \n      distances = np.linalg.norm(pos - workshop_positions, axis=1)\n      nearest_workshop_pos_for_type = workshop_positions[np.argmin(distances)]\n      distance_to_nearest = distances.min()\n      \n      if distance_to_nearest < min_distance:\n          nearest_workshop_pos = nearest_workshop_pos_for_type\n          min_distance = distance_to_nearest\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_workshop_pos):\n      dx, dy = nearest_workshop_pos - pos\n\n      # Determine direction to move in\n      direction = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = 3 if dx > 0 else 2\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          direction = 1 if dy > 0 else 0\n          pos[1] += 1 if dy > 0 else -1\n\n      actions.append(direction)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T09:39:46.031365", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T09:42:49.819386", "function_name": "craft", "function_body": "  def move_to_target(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      direction_mapping = {\n          (0, -1): 0,  # UP\n          (0, 1): 1,   # DOWN\n          (-1, 0): 2,  # LEFT\n          (1, 0): 3    # RIGHT\n      }\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              direction = (1, 0) if dx > 0 else (-1, 0)\n          else:  # Then move in y-direction\n              direction = (0, 1) if dy > 0 else (0, -1)\n\n          actions.append(direction_mapping[direction])\n          pos += np.array(direction)\n\n      return actions\n\n  def find_closest_workshop(env, goal_index):\n      cookbook = env.world.cookbook\n      workshop_indices = env.world.workshop_indices\n      \n      closest_workshop_idx, min_distance = None, float('inf')\n      pos = np.array(env._current_state.pos)\n      \n      for workshop_idx in workshop_indices:\n          # Get all positions of the current type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # No workshops of this type, skip\n              continue\n          \n          # Find the closest workshop position to the agent\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      \n      return closest_workshop_idx\n\n  def find_nearest_target_position(env, workshop_idx):\n      pos = np.array(env._current_state.pos)\n      \n      # Calculate the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n      \n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n      \n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Get the primitives required for crafting\n  primitives_required = cookbook.primitives.get(goal_index, [])\n  \n  actions = []\n\n  # Collect all required primitives before crafting\n  for primitive in primitives_required:\n      # Move to and collect each primitive\n      pos = np.array(env._current_state.pos)\n      \n      target_positions = np.argwhere(env._current_state.grid[:, :, primitive])\n      if len(target_positions) == 0:  # No primitives available, skip\n          continue\n      \n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n      \n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n      \n      actions.extend(move_to_target(env, nearest_target_pos))\n      actions.append(4)  # USE to collect the primitive\n\n  workshop_idx = find_closest_workshop(env, goal_index)\n  \n  if workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = find_nearest_target_position(env, workshop_idx)\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(env, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T09:42:50.953324", "function_name": "craft", "function_body": "  def find_nearest_workshop(env):\n      pos = np.array(env._current_state.pos)\n      cookbook = env.world.cookbook\n      workshop_indices = env.world.workshop_indices\n\n      closest_workshop_idx, min_distance = None, float('inf')\n      \n      for workshop_idx in workshop_indices:\n          # Get all positions of the current type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # No workshops of this type, skip\n              continue\n\n          # Find the closest workshop position to the agent\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      \n      return closest_workshop_idx, min_distance\n\n  def move_to_target(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      direction_mapping = {\n          (0, -1): 0,  # UP\n          (0, 1): 1,   # DOWN\n          (-1, 0): 2,  # LEFT\n          (1, 0): 3    # RIGHT\n      }\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              direction = (1, 0) if dx > 0 else (-1, 0)\n          else:  # Then move in y-direction\n              direction = (0, 1) if dy > 0 else (0, -1)\n\n          actions.append(direction_mapping[direction])\n          pos += np.array(direction)\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_idx, min_distance = find_nearest_workshop(env)\n  \n  if workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = np.argwhere(env._current_state.grid[:, :, workshop_idx]).mean(axis=0)\n\n  # Move to the closest workshop position\n  actions = move_to_target(env, nearest_target_pos.astype(int))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 4.7}}
