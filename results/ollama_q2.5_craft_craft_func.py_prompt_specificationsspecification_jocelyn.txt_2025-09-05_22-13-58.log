{"timestamp": "2025-09-06T16:37:44.389710", "function_name": "craft", "function_body": "  def move_to_position(current_pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          elif abs(dx) < abs(dy):  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n          else:  # If both directions are equal, choose one direction to prioritize (e.g., x-direction)\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) == 0:  # No available workshops of this type\n          continue\n\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_mean = workshop_pos_list.mean(axis=0)\n\n      distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n      if closest_workshop_idx is None or distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(pos - target_positions, axis=1))]\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-06T16:37:45.536709", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          # Find the nearest workshop position to the agent's current position\n          nearest_workshop_pos = None\n          min_nearest_distance = float('inf')\n\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_nearest_distance:\n                  nearest_workshop_pos = target_pos\n                  min_nearest_distance = distance\n\n          # Check if this is the closest workshop to the agent\n          if min_nearest_distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = min_nearest_distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = np.array(nearest_workshop_pos)\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n      else:  # If both directions are equal, choose one direction to prioritize (e.g., x-direction)\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:39:05.612665", "function_name": "craft", "function_body": "  def find_closest_workshop_position(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      \n      # Iterate over all workshop indices to find the closest one that can be used for crafting\n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n          \n          return nearest_target_pos, workshop_idx\n      \n      raise ValueError(\"No suitable workshop found for crafting\")\n\n  def move_towards_position(env, target_pos):\n      actions = []\n      pos = np.array(env._current_state.pos)\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can be used for crafting\n  target_pos, _ = find_closest_workshop_position(env, goal_index)\n  \n  # Move towards the closest workshop\n  actions = move_towards_position(env, target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:39:06.601310", "function_name": "craft", "function_body": "  def move_towards_workshop(env, workshop_idx):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return None\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find which workshops can craft the desired item\n  possible_workshops = [workshop_idx for workshop_idx in env.world.workshop_indices \n                        if any(workshop_idx == ingredient or \"_key\" in ingredients and workshop_idx in ingredients[\"_key\"]\n                           for ingredients in cookbook.recipes.values() if goal_index in ingredients)]\n\n  # Find the closest valid workshop\n  closest_workshop_actions = None\n  closest_distance = float('inf')\n\n  for workshop_idx in possible_workshops:\n      actions = move_towards_workshop(env, workshop_idx)\n      if actions is not None and len(actions) < closest_distance:\n          closest_workshop_actions = actions\n          closest_distance = len(actions)\n\n  return closest_workshop_actions or []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T16:45:35.178747", "function_name": "craft", "function_body": "  def move_towards_position(pos, target_pos):\n      actions = []\n      dx, dy = target_pos - pos\n\n      # Determine direction to move in\n      while not np.array_equal(pos, target_pos):\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n              dx -= 1 if dx > 0 else 1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n              dy -= 1 if dy > 0 else 1\n\n      return actions\n\n  def find_closest_workshop(env, workshop_indices):\n      current_pos = np.array(env._current_state.pos)\n\n      closest_workshop = None\n      min_distance = float('inf')\n\n      for workshop_idx in workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_positions) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          for pos in workshop_positions:\n              distance = np.linalg.norm(pos - current_pos)\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop = pos\n\n      return closest_workshop\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check if we have all required ingredients in inventory\n  primitives_required = cookbook.primitives_for(goal_index)\n\n  for primitive, count in primitives_required.items():\n      if env._current_state.inventory[primitive] < count:\n          return []  # Cannot craft as we lack some ingredient\n\n  # Find the closest workshop that can be used to craft the desired item\n  closest_workshop_pos = find_closest_workshop(env, env.world.workshop_indices)\n\n  if closest_workshop_pos is None:\n      return []  # No suitable workshops found\n\n  # Move towards the closest workshop and use it\n  actions = move_towards_position(np.array(env._current_state.pos), closest_workshop_pos)\n  actions.append(4)  # USE action to craft the item\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T16:45:36.243910", "function_name": "craft", "function_body": "  def move_towards_workshop(workshop_idx):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return None\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check if we have all required ingredients in inventory\n  primitives_required = cookbook.primitives_for(goal_index)\n\n  for primitive, count in primitives_required.items():\n      if env._current_state.inventory[primitive] < count:\n          return []  # Cannot craft as we lack some ingredient\n\n  # Find the workshop that can craft the desired item\n  actions = None\n  for workshop_idx in env.world.workshop_indices:\n      actions = move_towards_workshop(workshop_idx)\n      if actions is not None:  # If valid actions found, break out of loop\n          actions.append(4)  # USE to craft\n          break\n\n  return actions if actions else []", "island_id": 0, "scores": {"3": 5.0}}
{"timestamp": "2025-09-06T16:47:35.717625", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Calculate path to the closest workshop position using A* algorithm\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=1)\n\n  def a_star_search(start, goal, grid):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      cost_so_far = {}\n      came_from[tuple(start)] = None\n      cost_so_far[tuple(start)] = 0\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if np.array_equal(current, goal):\n              break\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Possible moves\n              neighbor = (current[0] + dx, current[1] + dy)\n              if grid[neighbor].sum() == 0:  # Check if the cell is free to move into\n                  new_cost = cost_so_far[tuple(current)] + 1\n                  if tuple(neighbor) not in cost_so_far or new_cost < cost_so_far[tuple(neighbor)]:\n                      cost_so_far[tuple(neighbor)] = new_cost\n                      priority = new_cost + heuristic(goal, neighbor)\n                      open_set.put((priority, neighbor))\n                      came_from[tuple(neighbor)] = current\n\n      # Reconstruct the path from goal to start using came_from dictionary\n      path = []\n      while np.array_equal(current, start) == False:\n          path.append(tuple(current))\n          current = came_from[tuple(current)]\n      path.reverse()\n      return path\n\n  path = a_star_search(pos.tolist(), nearest_target_pos.tolist(), env._current_state.grid)\n\n  # Convert path to actions\n  for i in range(1, len(path)):\n      dx, dy = path[i][0] - pos[0], path[i][1] - pos[1]\n      if dx == 1:\n          actions.append(3)  # RIGHT\n      elif dx == -1:\n          actions.append(2)  # LEFT\n      elif dy == 1:\n          actions.append(1)  # UP\n      elif dy == -1:\n          actions.append(0)  # DOWN\n      pos = np.array(path[i])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-06T16:47:36.699748", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Determine the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  current_pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Find all positions of the workshops of this type on the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          # Calculate the closest position among these workshops\n          nearest_workshop_pos = min(\n              workshop_positions,\n              key=lambda pos: np.linalg.norm(current_pos - pos, ord=2)\n          )\n          distance = np.linalg.norm(current_pos - nearest_workshop_pos, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the path to the nearest workshop\n  target_position = np.array(closest_workshop_pos)\n  while not np.array_equal(current_pos, target_position):\n      dx, dy = target_position - current_pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)  # RIGHT or LEFT\n          current_pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)  # UP or DOWN\n          current_pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-06T16:48:34.481143", "function_name": "craft", "function_body": "  def move_towards_workshop(env):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Get all workshops that can craft the goal item\n      for recipe in env.world.cookbook.recipes.values():\n          if goal_index in recipe:\n              workshop_idx = list(set(recipe.keys()) & set(env.world.workshop_indices))[0]\n              \n              # Find all positions of this type of workshop\n              workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n              \n              if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n                  continue\n\n              # Calculate the closest position to move towards\n              nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n              while not np.array_equal(pos, nearest_target_pos):\n                  dx, dy = nearest_target_pos - pos\n\n                  # Determine direction to move in\n                  if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n                      actions.append(3 if dx > 0 else 2)\n                      pos[0] += 1 if dx > 0 else -1\n                  else:  # Then move in y-direction\n                      actions.append(1 if dy > 0 else 0)\n                  pos[1] += 1 if dy > 0 else -1\n\n              # Use the workshop to craft the item\n              actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T16:48:35.554968", "function_name": "craft", "function_body": "  def find_closest_workshop(pos):\n      min_dist = float('inf')\n      closest_workshop_idx = None\n      nearest_target_pos = None\n\n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) == 0:\n              continue\n\n          for target_pos in workshop_pos_list:\n              dist = np.linalg.norm(target_pos - pos)\n              if dist < min_dist:\n                  min_dist = dist\n                  closest_workshop_idx = workshop_idx\n                  nearest_target_pos = target_pos\n\n      return closest_workshop_idx, nearest_target_pos\n\n  def move_towards_position(pos, target_pos):\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          if abs(dx) > abs(dy):\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop\n  pos = np.array(env._current_state.pos)\n  workshop_idx, nearest_target_pos = find_closest_workshop(pos)\n\n  if workshop_idx is None:\n      raise ValueError(\"No available workshop to craft the item\")\n\n  actions = move_towards_position(pos, nearest_target_pos)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:50:10.102904", "function_name": "craft", "function_body": "  def move_to_target(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:50:11.076334", "function_name": "craft", "function_body": "  def move_to_target(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  target_workshop_pos, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              target_workshop_pos = workshop_pos_mean\n              min_distance = distance\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards from the mean position\n  nearest_target_pos = np.argwhere(env._current_state.grid[:, :, workshop_indices[0]])[0]  # Assume at least one exists\n  min_nearest_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      for target_pos in workshop_pos_list:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-06T16:51:45.533323", "function_name": "craft", "function_body": "  def find_closest_workshop(goal_index):\n      pos = np.array(env._current_state.pos)\n      closest_workshop_pos = None\n      min_distance = float('inf')\n\n      # Find all workshops that can craft this item (assuming any workshop can)\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          distances = np.linalg.norm(workshop_pos_list - pos, axis=1)\n          nearest_target_pos = workshop_pos_list[np.argmin(distances)]\n          distance = distances.min()\n\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop_pos = nearest_target_pos\n\n      return closest_workshop_pos\n\n  def move_to_position(target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_pos = find_closest_workshop(goal_index)\n\n  if closest_workshop_pos is not None:\n      actions = move_to_position(closest_workshop_pos)\n      actions.append(4)  # USE to craft the item\n  else:\n      raise ValueError(\"No available workshops to craft the item\")\n\n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:51:46.695355", "function_name": "craft", "function_body": "  def move_towards_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Determine the required workshop type from the recipe\n      for output_idx, ingredients in env.world.cookbook.recipes.items():\n          if output_idx == goal_index:\n              ingredient_indices = [i for i in ingredients if isinstance(i, int)]\n              break\n\n      # Find all workshops that can craft this item (assuming any workshop can)\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n          while not np.array_equal(pos, nearest_target_pos):\n              dx, dy = nearest_target_pos - pos\n\n              # Determine direction to move in\n              if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n                  actions.append(3 if dx > 0 else 2)\n                  pos[0] += 1 if dx > 0 else -1\n              else:  # Then move in y-direction\n                  actions.append(1 if dy > 0 else 0)\n                  pos[1] += 1 if dy > 0 else -1\n\n          # Use the workshop to craft the item\n          actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env, goal_index)\n\n  return actions", "island_id": 0, "scores": {"3": 5.1}}
{"timestamp": "2025-09-06T16:53:15.364010", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = [idx for idx in cookbook.recipes[goal_index].keys() if idx in env.world.workshop_indices]\n  \n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest available workshop\n  nearest_workshop_pos = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_positions) == 0: \n          continue\n      \n      # Find the closest position of this workshop type to the current position\n      closest_pos, closest_distance = min(\n          [(pos2, np.linalg.norm(pos - pos2)) for pos2 in workshop_positions], \n          key=lambda x: x[1]\n      )\n\n      if closest_distance < min_distance:\n          nearest_workshop_pos = closest_pos\n          min_distance = closest_distance\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_workshop_pos):\n      dx, dy = nearest_workshop_pos - pos\n      direction = np.argmax([abs(dx), abs(dy)])\n\n      # Determine direction to move in based on the dominant axis\n      if direction == 0:\n          actions.append(1 if dy > 0 else 0)  # Move up or down\n          pos[1] += 1 if dy > 0 else -1\n      else:\n          actions.append(3 if dx > 0 else 2)  # Move left or right\n          pos[0] += 1 if dx > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE action to start crafting\n  return actions", "island_id": 8, "scores": {"3": -1}}
