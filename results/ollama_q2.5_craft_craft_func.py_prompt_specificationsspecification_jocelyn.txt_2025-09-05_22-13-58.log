{"timestamp": "2025-09-06T15:53:16.132976", "function_name": "craft", "function_body": "  def move_to_target(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  def find_closest_workshop(pos, workshop_indices):\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      \n      for idx in workshop_indices:\n          # Find positions of all workshops of this type\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, idx])\n          \n          if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n              # Calculate mean position\n              workshop_pos_mean = workshop_positions.mean(axis=0)\n              \n              # Calculate distance to this workshop type's mean position\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              \n              # Update closest workshop if necessary\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_idx = idx\n      \n      return closest_workshop_idx\n\n  def find_nearest_target(pos, workshop_idx):\n      # Find positions of all workshops of the type closest_workshop_idx\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(target_positions) == 0:\n          raise ValueError(\"No positions found for this workshop type\")\n      \n      # Calculate distances to each position and find nearest one\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - target, ord=2) for target in target_positions])]\n      \n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx = find_closest_workshop(np.array(env._current_state.pos), workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = find_nearest_target(np.array(env._current_state.pos), closest_workshop_idx)\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(np.array(env._current_state.pos), nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T15:53:17.203946", "function_name": "craft", "function_body": "  def move_to_target(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check if the item can be crafted\n  if goal_index not in cookbook.recipes:\n      raise ValueError(f\"Cannot craft {item} as it has no recipe.\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can be used to craft the item\n  # For simplicity, we assume any workshop can craft anything.\n  # In a real scenario, you would need to check which workshops can craft the specific item.\n\n  closest_workshop_idx, min_distance = None, float('inf')\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - target, ord=2) for target in target_positions])]\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T15:55:53.517753", "function_name": "craft", "function_body": "  def move_to_target(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          # Prioritize moving in the direction that minimizes distance first\n          if abs(dx) >= abs(dy):  \n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  def get_closest_workshop_position(pos, workshop_idx):\n      # Find positions of all workshops of the specified type\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      # Calculate distances to each position and find nearest one\n      nearest_target_pos = workshop_positions[np.argmin([np.linalg.norm(pos - target, ord=2) for target in workshop_positions])]\n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  min_distance, closest_workshop_idx = float('inf'), None\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = get_closest_workshop_position(pos, closest_workshop_idx)\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T15:55:54.648604", "function_name": "craft", "function_body": "  def move_to_target(current_pos: np.ndarray, target_pos: np.ndarray) -> list[int]:\n      \"\"\"\n      Generates a sequence of actions to move from current position to the target position.\n      \n      Args:\n          current_pos (np.ndarray): Current position as (x, y).\n          target_pos (np.ndarray): Target position as (x, y).\n          \n      Returns:\n          List[int]: Actions required to reach the target position.\n      \"\"\"\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          \n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              action = 3 if dx > 0 else 2\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              action = 1 if dy > 0 else 0\n              current_pos[1] += 1 if dy > 0 else -1\n          \n          actions.append(action)\n      return actions\n\n  def find_closest_workshop(current_pos: np.ndarray, workshop_indices: list[int]) -> int:\n      \"\"\"\n      Finds the closest workshop index to the given position from a list of workshop indices.\n      \n      Args:\n          current_pos (np.ndarray): Current position as (x, y).\n          workshop_indices (List[int]): List of workshop indices to consider.\n          \n      Returns:\n          int: Index of the closest workshop. Raises ValueError if no workshops are found.\n      \"\"\"\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      \n      for idx in workshop_indices:\n          # Find positions of all workshops of this type\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, idx])\n          \n          if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n              # Calculate mean position\n              workshop_pos_mean = workshop_positions.mean(axis=0)\n              \n              # Calculate distance to this workshop type's mean position\n              distance = np.linalg.norm(current_pos - workshop_pos_mean, ord=2)\n              \n              # Update closest workshop if necessary\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_idx = idx\n      \n      if closest_workshop_idx is None:\n          raise ValueError(\"No available workshop found\")\n      \n      return closest_workshop_idx\n\n  def find_nearest_target(current_pos: np.ndarray, workshop_idx: int) -> np.ndarray:\n      \"\"\"\n      Finds the nearest target position of a given workshop type from the current position.\n      \n      Args:\n          current_pos (np.ndarray): Current position as (x, y).\n          workshop_idx (int): Index of the workshop to find the nearest target for.\n          \n      Returns:\n          np.ndarray: Position of the nearest target. Raises ValueError if no targets are found.\n      \"\"\"\n      # Find positions of all workshops of the type closest_workshop_idx\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(target_positions) == 0:\n          raise ValueError(\"No positions found for this workshop type\")\n      \n      # Calculate distances to each position and find nearest one\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(current_pos - target, ord=2) for target in target_positions])]\n      \n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx = find_closest_workshop(np.array(env._current_state.pos), workshop_indices)\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = find_nearest_target(np.array(env._current_state.pos), closest_workshop_idx)\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(np.array(env._current_state.pos), nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
