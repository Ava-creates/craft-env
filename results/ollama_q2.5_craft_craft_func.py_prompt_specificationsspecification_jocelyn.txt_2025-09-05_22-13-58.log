 -1\n\n      # Recalculate the remaining distance to the target after each step\n      dx, dy = nearest_target_pos - pos\n  \n  # Turn towards the final position if needed\n  if dx == 0 and dy > 0:\n      actions.append(1)\n  elif dx == 0 and dy < 0:\n      actions.append(0)\n  elif dy == 0 and dx > 0:\n      actions.append(3)\n  elif dy == 0 and dx < 0:\n      actions.append(2)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 9, "scores": {"3": -1}}
