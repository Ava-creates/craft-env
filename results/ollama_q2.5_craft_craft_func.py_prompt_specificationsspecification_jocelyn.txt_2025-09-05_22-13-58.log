{"timestamp": "2025-09-06T15:26:45.848091", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  def find_closest_workshop(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx, min_distance\n\n  closest_workshop_idx, _ = find_closest_workshop(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  def find_nearest_target_pos(workshop_idx):\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos, min_distance = None, float('inf')\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_distance:\n              nearest_target_pos = target_pos\n              min_distance = distance\n      return nearest_target_pos\n\n  nearest_target_pos = find_nearest_target_pos(closest_workshop_idx)\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T15:29:12.560009", "function_name": "craft", "function_body": "  def get_direction(dx: int, dy: int):\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return (3 if dx > 0 else 2)\n      else:\n          return (1 if dy > 0 else 0)\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  \n  if len(target_positions) == 0:\n      raise ValueError(\"No positions for the selected workshop were found.\")\n\n  nearest_target_pos = min(target_positions, key=lambda p: np.linalg.norm(pos - p))\n \n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      \n      actions.append(direction)\n      \n      # Update agent's current position based on direction moved\n      if direction == 3:\n          pos[0] += 1\n      elif direction == 2:\n          pos[0] -= 1\n      elif direction == 1:\n          pos[1] += 1\n      else:  # direction == 0\n          pos[1] -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T15:29:13.633183", "function_name": "craft", "function_body": "  def get_direction(dx: int, dy: int):\n      if abs(dx) > abs(dy):  \n          return (3 if dx > 0 else 2)\n      elif abs(dx) < abs(dy):\n          return (1 if dy > 0 else 0)\n      else:\n          # If both distances are equal, prioritize moving in the direction of positive x or y\n          return (3 if dx >= 0 else 2) if dx != 0 else (1 if dy >= 0 else 0)\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n  \n  # Find the closest workshop that can craft the desired item\n  min_distance = float('inf')\n  nearest_target_pos = None\n  \n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_positions) > 0:  \n          distances = np.linalg.norm(pos - workshop_positions, axis=1)\n          target_index = np.argmin(distances)\n          nearest_pos = workshop_positions[target_index]\n          distance = distances[target_index]\n          \n          if distance < min_distance:\n              nearest_target_pos = nearest_pos\n              min_distance = distance\n  \n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      \n      direction = get_direction(dx, dy)\n      \n      actions.append(direction)\n      \n      # Update agent's current position based on direction moved\n      if direction == 3:\n          pos[0] += 1\n      elif direction == 2:\n          pos[0] -= 1\n      elif direction == 1:\n          pos[1] += 1\n      else:  # direction == 0\n          pos[1] -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T15:31:24.365092", "function_name": "craft", "function_body": "  def get_direction(dx: int, dy: int):\n      if abs(dx) > abs(dy):  \n          return (3 if dx > 0 else 2)\n      elif abs(dx) < abs(dy):\n          return (1 if dy > 0 else 0)\n      else:\n          # If both distances are equal, prioritize moving in the direction of positive x or y\n          return (3 if dx >= 0 else 2) if dx != 0 else (1 if dy >= 0 else 0)\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n  \n  # Find the closest workshop that can craft the desired item\n  min_distance = float('inf')\n  nearest_target_pos = None\n  \n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_positions) > 0:  \n          distances = np.linalg.norm(pos - workshop_positions, axis=1)\n          target_index = np.argmin(distances)\n          nearest_pos = workshop_positions[target_index]\n          distance = distances[target_index]\n          \n          if distance < min_distance:\n              nearest_target_pos = nearest_pos\n              min_distance = distance\n  \n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      \n      direction = get_direction(dx, dy)\n      \n      actions.append(direction)\n      \n      # Update agent's current position based on direction moved\n      if direction == 3:\n          pos[0] += 1\n      elif direction == 2:\n          pos[0] -= 1\n      elif direction == 1:\n          pos[1] += 1\n      else:  # direction == 0\n          pos[1] -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T15:31:25.513326", "function_name": "craft", "function_body": "  def get_direction(dx: int, dy: int):\n    if abs(dx) > abs(dy):  \n      return (3 if dx > 0 else 2)\n    elif abs(dx) < abs(dy):\n      return (1 if dy > 0 else 0)\n    else:\n      # If both distances are equal, prioritize moving in the direction of positive x or y\n      return (3 if dx >= 0 else 2) if dx != 0 else (1 if dy >= 0 else 0)\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n  \n  # Find the closest workshop that can craft the desired item\n  min_distance = float('inf')\n  nearest_target_pos = None\n  \n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    \n    if len(workshop_positions) > 0:  \n      distances = np.linalg.norm(pos - workshop_positions, axis=1)\n      target_index = np.argmin(distances)\n      nearest_pos = workshop_positions[target_index]\n      \n      # Check if the workshop can craft the desired item\n      if goal_index in cookbook.recipes:\n        min_distance = distances[target_index]\n        nearest_target_pos = nearest_pos\n  \n  if nearest_target_pos is None:\n    raise ValueError(\"No available workshop found that can craft the desired item\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      \n      direction = get_direction(dx, dy)\n      \n      actions.append(direction)\n      \n      # Update agent's current position based on direction moved\n      if direction == 3:\n          pos[0] += 1\n      elif direction == 2:\n          pos[0] -= 1\n      elif direction == 1:\n          pos[1] += 1\n      else:  # direction == 0\n          pos[1] -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T15:33:06.755871", "function_name": "craft", "function_body": "  def move_towards_workshop(workshop_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos[np.argmin(np.linalg.norm(workshop_pos - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the recipe for the desired item\n  recipe = cookbook.recipes.get(goal_index)\n  \n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  actions = []\n\n  # Check for the required workshop in the recipe\n  if \"_key\" in recipe:\n      workshop_key = recipe[\"_key\"]\n      \n      # Find all positions of workshops with the specified key\n      for workshop_idx in env.world.workshop_indices:\n          workshop_name = cookbook.index.get(workshop_idx)\n          \n          if workshop_key in workshop_name:\n              workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n              \n              if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n                  continue\n\n              actions.extend(move_towards_workshop(workshop_pos_list))\n              break\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T15:33:07.808949", "function_name": "craft", "function_body": "  def move_towards_workshop(env):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n          while not np.array_equal(pos, nearest_target_pos):\n              dx, dy = nearest_target_pos - pos\n\n              # Determine direction to move in\n              if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n                  actions.append(3 if dx > 0 else 2)\n                  pos[0] += 1 if dx > 0 else -1\n              else:  # Then move in y-direction\n                  actions.append(1 if dy > 0 else 0)\n                  pos[1] += 1 if dy > 0 else -1\n\n          # Use the workshop to craft the item\n          actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check if we have all required ingredients in inventory\n  primitives_required = cookbook.primitives_for(goal_index)\n\n  for primitive, count in primitives_required.items():\n      if env._current_state.inventory[primitive] < count:\n          return []  # Cannot craft as we lack some ingredient\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env)\n\n  return actions", "island_id": 0, "scores": {"3": 5.0}}
{"timestamp": "2025-09-06T15:34:45.303533", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
