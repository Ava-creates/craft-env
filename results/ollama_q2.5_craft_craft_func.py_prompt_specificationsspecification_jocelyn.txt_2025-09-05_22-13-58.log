{"timestamp": "2025-09-06T17:04:23.387335", "function_name": "craft", "function_body": "  def move_towards_workshop(env, workshop_idx):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return None\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find all workshops that can be used to craft this item\n  possible_workshops = [workshop_idx for workshop_idx in env.world.workshop_indices \n                        if any(workshop_idx in recipe.values() for recipe in cookbook.recipes.values())]\n\n  actions = []\n  for workshop_idx in possible_workshops:\n      new_actions = move_towards_workshop(env, workshop_idx)\n      if new_actions is not None:  # If a path to this workshop was found\n          actions.extend(new_actions)\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T17:04:24.480631", "function_name": "craft", "function_body": "  def move_towards_position(pos_target: np.ndarray, env):\n      pos_current = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos_current, pos_target):\n          dx, dy = pos_target - pos_current\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos_current[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos_current[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  pos_workshops = np.array([])\n  for workshop_idx in env.world.workshop_indices:\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          continue\n\n      # Append to list of all workshops found\n      pos_workshops = np.append(pos_workshops, workshop_pos_list).reshape(-1, 2)\n\n  if len(pos_workshops) == 0:\n      raise ValueError(\"No available workshops\")\n\n  # Calculate the closest position to move towards\n  pos_current = np.array(env._current_state.pos)\n  nearest_target_pos = pos_workshops[np.argmin(np.linalg.norm(pos_workshops - pos_current, axis=1))]\n\n  actions_move_to_workshop = move_towards_position(nearest_target_pos, env)\n\n  # Append the USE action to craft the item\n  actions_use = [4]\n\n  return actions_move_to_workshop + actions_use", "island_id": 2, "scores": {"3": 4.7}}
