{"timestamp": "2025-09-06T12:49:49.688444", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  current_pos = np.array(env._current_state.pos)\n\n  # Calculate distances to all workshops and choose the closest one\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) == 0:  # Skip if no workshops of this type are present\n          continue\n      \n      workshop_mean_pos = workshop_positions.mean(axis=0)\n      distance_to_workshop = np.linalg.norm(current_pos - workshop_mean_pos, ord=2)\n\n      if distance_to_workshop < min_distance:\n          closest_workshop_idx = workshop_idx\n          min_distance = distance_to_workshop\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest specific position of the closest workshop type\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in np.argwhere(env._current_state.grid[:, :, closest_workshop_idx]):\n      distance_to_target = np.linalg.norm(current_pos - target_pos, ord=2)\n      if distance_to_target < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance_to_target\n\n  # Move to the nearest workshop position\n  while not np.array_equal(current_pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - current_pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          current_pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          current_pos[1] += 1 if dy > 0 else -1\n\n  # Check if already next to the workshop (in case of diagonal adjacency)\n  adjacent_positions = [(current_pos + [dx, dy]) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n  is_adjacent = any(np.array_equal(adj_pos, nearest_target_pos) for adj_pos in adjacent_positions)\n\n  if not is_adjacent:\n      # Move one step closer if necessary\n      dx, dy = nearest_target_pos - current_pos\n      direction = None\n      if abs(dx) > abs(dy):\n          direction = 3 if dx > 0 else 2\n      else:\n          direction = 1 if dy > 0 else 0\n      actions.append(direction)\n      current_pos += np.array([1 if direction in [3, 2] and (direction == 3 or direction == 2) else -1,\n                                1 if direction in [1, 0] and (direction == 1 or direction == 0) else -1])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 1, "scores": {"3": 0.2}}
{"timestamp": "2025-09-06T12:49:50.759033", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  current_pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop type that can be used to craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) == 0:  # Skip if no workshops of this type are present\n          continue\n      \n      workshop_mean_pos = workshop_positions.mean(axis=0)\n      distance_to_workshop = np.linalg.norm(current_pos - workshop_mean_pos, ord=2)\n\n      if distance_to_workshop < min_distance:\n          closest_workshop_idx = workshop_idx\n          min_distance = distance_to_workshop\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest specific position of the closest workshop type\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in np.argwhere(env._current_state.grid[:, :, closest_workshop_idx]):\n      distance_to_target = np.linalg.norm(current_pos - target_pos, ord=2)\n      if distance_to_target < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance_to_target\n\n  # Move to the nearest workshop position\n  while not np.array_equal(current_pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - current_pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          current_pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          current_pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T12:52:04.694700", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    actions = []\n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n\n      # Prioritize moving in the direction with the largest distance first\n      if abs(dx) > abs(dy):  # Move in x-direction\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):  # Move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n      else:  # If both directions are equal, choose one arbitrarily (e.g., x-direction)\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n\n    return actions\n  \n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_towards(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T12:52:05.754831", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  distances_to_workshops = {}\n\n  for workshop_idx in workshop_indices:\n    target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    if len(target_positions) > 0:  # Check if there are any positions\n      workshop_pos_mean = target_positions.mean(axis=0)\n      distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n      distances_to_workshops[workshop_idx] = (distance, target_positions)\n\n  # Get the closest workshops based on their distances\n  closest_workshops_indices = sorted(distances_to_workshops.keys(), key=lambda k: distances_to_workshops[k][0])\n\n  for workshop_idx in closest_workshops_indices:\n    _, target_positions = distances_to_workshops[workshop_idx]\n    \n    nearest_target_pos = None\n    min_nearest_distance = float('inf')\n    for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n        nearest_target_pos = target_pos\n        min_nearest_distance = distance\n\n    # Move to the closest workshop position\n    while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      \n      actions.append(3 if dx > 0 else 2) if abs(dx) >= abs(dy) else actions.append(1 if dy > 0 else 0)\n      \n      # Update position\n      pos[0] += 1 if dx > 0 else (-1 if dx < 0 else 0)\n      pos[1] += 1 if dy > 0 else (-1 if dy < 0 else 0)\n\n    # Use the workshop to craft the item\n    actions.append(4)  # USE\n\n    return actions\n\n  raise ValueError(\"No available workshop found\")", "island_id": 9, "scores": {"3": 0.7}}
