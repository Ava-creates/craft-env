{"timestamp": "2025-09-06T14:48:20.536029", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = np.argmax([abs(dx), abs(dy)])\n          if direction == 1:  # y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n          elif direction == 0:  # x-direction\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  distances_to_workshops = {}\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = np.linalg.norm(pos - workshop_pos_list, axis=1)\n          nearest_target_pos = workshop_pos_list[np.argmin(distances)]\n          distance = np.min(distances)\n          distances_to_workshops[workshop_idx] = (distance, nearest_target_pos)\n\n  if not distances_to_workshops:\n      raise ValueError(\"No available workshop found\")\n\n  # Get the closest workshop based on their distances\n  closest_workshop_idx, (min_distance, nearest_target_pos) = min(distances_to_workshops.items(), key=lambda x: x[1][0])\n\n  actions = []\n\n  # Move to the closest workshop position\n  actions.extend(move_towards(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T14:48:21.626010", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    actions = []\n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      if abs(dx) > abs(dy):\n        # Move in the x-direction first\n        actions.append(3 if dx > 0 else 2)\n        pos[0] += 1 if dx > 0 else -1\n      else:\n        # Move in the y-direction\n        actions.append(1 if dy > 0 else 0)\n        pos[1] += 1 if dy > 0 else -1\n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  distances_to_workshops = {}\n\n  for workshop_idx in workshop_indices:\n    workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n      nearest_target_pos = min(workshop_pos_list, key=lambda p: np.linalg.norm(pos - p))\n      distances_to_workshops[workshop_idx] = (np.linalg.norm(pos - nearest_target_pos), nearest_target_pos)\n\n  if not distances_to_workshops:\n    raise ValueError(\"No available workshop found\")\n\n  # Get the closest workshop based on their distances\n  _, nearest_target_pos = min(distances_to_workshops.values(), key=lambda x: x[0])\n\n  # Move to the closest workshop position\n  actions = move_towards(pos, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
