{"timestamp": "2025-09-06T09:56:28.631382", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position while avoiding obstacles\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          next_x_pos = pos[0] + (1 if dx > 0 else -1)\n          if env._current_state.grid[next_x_pos, pos[1]].sum() == 0:\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:\n              # Handle obstacle in x-direction, move in y-direction if possible\n              next_y_pos = pos[1] + (1 if dy > 0 else -1)\n              if env._current_state.grid[pos[0], next_y_pos].sum() == 0:\n                  actions.append(1 if dy > 0 else 0)\n                  pos[1] += 1 if dy > 0 else -1\n      elif abs(dx) < abs(dy):  # Then move in y-direction\n          next_y_pos = pos[1] + (1 if dy > 0 else -1)\n          if env._current_state.grid[pos[0], next_y_pos].sum() == 0:\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n          else:\n              # Handle obstacle in y-direction, move in x-direction if possible\n              next_x_pos = pos[0] + (1 if dx > 0 else -1)\n              if env._current_state.grid[next_x_pos, pos[1]].sum() == 0:\n                  actions.append(3 if dx > 0 else 2)\n                  pos[0] += 1 if dx > 0 else -1\n      else:  # If equal distance, move in both directions (diagonal move is not supported, so choose one direction)\n          next_x_pos = pos[0] + (1 if dx > 0 else -1)\n          if env._current_state.grid[next_x_pos, pos[1]].sum() == 0:\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:\n              next_y_pos = pos[1] + (1 if dy > 0 else -1)\n              if env._current_state.grid[pos[0], next_y_pos].sum() == 0:\n                  actions.append(1 if dy > 0 else 0)\n                  pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-06T09:56:29.609330", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* search algorithm to find the shortest path to the closest workshop position\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  def a_star_search(start, goal):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if np.array_equal(current, goal):\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n\n              if env._current_state.grid[neighbor[0], neighbor[1]].sum() == 0:  # Check if the next position is valid (not blocked)\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                      open_set.put((f_score[neighbor], neighbor))\n\n      return None\n\n  path = a_star_search(tuple(pos), tuple(nearest_target_pos))\n  if not path:\n      raise ValueError(\"No valid path to the workshop found\")\n\n  for target in path[1:]:  # Skip the starting position\n      actions.append({\n          (0, -1): 0,  # UP\n          (0, 1): 1,   # DOWN\n          (-1, 0): 2,  # LEFT\n          (1, 0): 3    # RIGHT\n      }[tuple(target) - tuple(pos)])\n      pos = target\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-06T09:58:43.856828", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  current_state = env._current_state\n  pos = np.array(current_state.pos)\n\n  # Find the closest workshop that can craft the desired item and its nearest position\n  def find_closest_workshop_and_position():\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      nearest_target_pos = None\n      \n      for workshop_idx in workshop_indices:\n          workshop_positions = np.argwhere(current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n              mean_pos = workshop_positions.mean(axis=0)\n              distance = np.linalg.norm(pos - mean_pos, ord=2)\n\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_idx = workshop_idx\n                  nearest_target_pos = workshop_positions[np.argmin(distances)]\n      \n      return closest_workshop_idx, nearest_target_pos\n\n  closest_workshop_idx, target_pos = find_closest_workshop_and_position()\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate actions to move to the nearest position\n  def calculate_move_actions(target):\n      actions = []\n      current_pos = np.array(current_state.pos)\n      \n      while not np.array_equal(current_pos, target):\n          dx, dy = target - current_pos\n\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              direction = 3 if dx > 0 else 2\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              direction = 1 if dy > 0 else 0\n              current_pos[1] += 1 if dy > 0 else -1\n\n          actions.append(direction)\n      \n      return actions\n\n  move_actions = calculate_move_actions(target_pos)\n  actions.extend(move_actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T09:58:44.923190", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  current_state = env._current_state\n  pos = np.array(current_state.pos)\n\n  # Function to find the closest position to any of the specified workshop indices\n  def find_closest_workshop_position():\n      min_distance = float('inf')\n      closest_target_pos = None\n      \n      for workshop_idx in workshop_indices:\n          workshop_positions = np.argwhere(current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n              distances = [np.linalg.norm(pos - tp, ord=2) for tp in workshop_positions]\n              nearest_target_pos = workshop_positions[np.argmin(distances)]\n              \n              distance = np.linalg.norm(pos - nearest_target_pos, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_target_pos = nearest_target_pos\n      \n      return closest_target_pos\n\n  target_pos = find_closest_workshop_position()\n\n  if target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Function to calculate actions to move to the specified position\n  def calculate_move_actions(target):\n      actions = []\n      current_pos = np.array(current_state.pos)\n      \n      while not np.array_equal(current_pos, target):\n          dx, dy = target - current_pos\n\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              direction = 3 if dx > 0 else 2\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              direction = 1 if dy > 0 else 0\n              current_pos[1] += 1 if dy > 0 else -1\n\n          actions.append(direction)\n      \n      return actions\n\n  move_actions = calculate_move_actions(target_pos)\n  actions.extend(move_actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T10:00:55.133023", "function_name": "craft", "function_body": "  def move_to_target(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          elif dy != 0:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  def find_closest_workshop(pos, workshop_indices, grid):\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      nearest_target_pos = None\n\n      for workshop_idx in workshop_indices:\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n              if distance < min_distance:\n                  closest_workshop_idx = workshop_idx\n                  min_distance = distance\n\n                  # Calculate the closest position to move towards\n                  nearest_target_pos = None\n                  min_nearest_distance = float('inf')\n\n                  for target_pos in workshop_pos_list:\n                      dist_to_target = np.linalg.norm(pos - target_pos, ord=2)\n                      if dist_to_target < min_nearest_distance:\n                          nearest_target_pos = target_pos\n                          min_nearest_distance = dist_to_target\n\n      return closest_workshop_idx, nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, nearest_target_pos = find_closest_workshop(pos, workshop_indices, env._current_state.grid)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 6, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T10:00:56.205165", "function_name": "craft", "function_body": "  def move_towards(target_pos):\n      actions = []\n      current_pos = np.array(env._current_state.pos)\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          elif dy != 0:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest available position for any workshop that can craft the desired item\n  min_distance = float('inf')\n  nearest_target_pos = None\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) == 0:\n          continue\n\n      # Calculate the closest position among all workshops of this type\n      distances = np.linalg.norm(pos - workshop_positions, axis=1)\n      nearest_workshop_pos = workshop_positions[np.argmin(distances)]\n      distance_to_nearest_workshop = distances.min()\n\n      if distance_to_nearest_workshop < min_distance:\n          min_distance = distance_to_nearest_workshop\n          nearest_target_pos = nearest_workshop_pos\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  actions.extend(move_towards(nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n  return actions", "island_id": 6, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T10:03:11.649376", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) == 0: \n          continue\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.linalg.norm(workshop_pos_list - pos, axis=1).argmin()]\n      distance = np.linalg.norm(nearest_target_pos - pos, ord=2)\n\n      if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.linalg.norm(target_positions - pos, axis=1).argmin()]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction if not already at the target y position\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T10:03:12.627114", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for recipe in cookbook.recipes.values():\n      if goal_index in recipe:\n          # Calculate the mean position of all workshops of this type\n          workshop_idx = list(recipe.keys())[0]\n          if \"_key\" not in workshop_idx:  # Ensure it's a workshop index, not \"_key\"\n              workshop_pos_list = np.argwhere(env._current_state.grid[:, :, int(workshop_idx)])\n              if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n                  workshop_pos_mean = workshop_pos_list.mean(axis=0)\n                  distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n                  if distance < min_distance:\n                      closest_workshop_idx, min_distance = int(workshop_idx), distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found for the item\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.linalg.norm(target_positions - pos, axis=1).argmin()]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction if not already at the target y position\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T10:05:36.559574", "function_name": "craft", "function_body": "  def get_direction(dx: int, dy: int):\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n\n      actions.append(direction)\n      \n      # Update agent's current position based on direction moved\n      if direction == 3:\n          pos[0] += 1\n      elif direction == 2:\n          pos[0] -= 1\n      elif direction == 1:\n          pos[1] += 1\n      else:  # direction == 0\n          pos[1] -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T10:05:37.651631", "function_name": "craft", "function_body": "  def get_direction(dx: int, dy: int):\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return (3 if dx > 0 else 2)\n      else:\n          return (1 if dy > 0 else 0)\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      \n      actions.append(direction)\n      \n      # Update agent's current position based on direction moved\n      if direction == 3:\n          pos[0] += 1\n      elif direction == 2:\n          pos[0] -= 1\n      elif direction == 1:\n          pos[1] += 1\n      else:  # direction == 0\n          pos[1] -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T10:08:07.270567", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the shortest path to the closest position of the nearest workshop\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[0]  # Assuming the first one as initial\n\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=1)\n\n  def a_star(start, goal, grid):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {tuple(start): 0}\n      f_score = {tuple(start): heuristic(start, goal)}\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if np.array_equal(current, goal):\n              return reconstruct_path(came_from, current)\n\n          for neighbor in [(current[0] + 1, current[1]), (current[0] - 1, current[1]), \n                           (current[0], current[1] + 1), (current[0], current[1] - 1)]:\n              if grid[neighbor[0], neighbor[1]] == 0:  # Assuming 0 is walkable\n                  tentative_g_score = g_score[tuple(current)] + 1\n\n                  if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n                      came_from[tuple(neighbor)] = current\n                      g_score[tuple(neighbor)] = tentative_g_score\n                      f_score[tuple(neighbor)] = tentative_g_score + heuristic(neighbor, goal)\n                      open_set.put((f_score[tuple(neighbor)], neighbor))\n\n      return []\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while tuple(current) in came_from:\n          current = came_from[tuple(current)]\n          total_path.append(current)\n      return list(reversed(total_path))\n\n  path = a_star(pos, nearest_target_pos, env._current_state.grid[:, :, closest_workshop_idx])\n  \n  # Move along the shortest path to reach the workshop\n  for i in range(len(path) - 1):\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T10:08:08.257147", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* pathfinding\n  actions.extend(a_star(env._current_state.grid, pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
