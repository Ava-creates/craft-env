se the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T18:42:51.968741", "function_name": "craft", "function_body": "  def find_nearest_workshop(grid, pos, workshop_indices):\n      nearest_target_pos = None\n      min_distance = float('inf')\n      \n      for workshop_idx in workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          distances = np.linalg.norm(workshop_pos_list - pos, axis=1)\n          nearest_workshop_in_type = workshop_pos_list[np.argmin(distances)]\n          \n          if distances.min() < min_distance:\n              min_distance = distances.min()\n              nearest_target_pos = nearest_workshop_in_type\n\n      return nearest_target_pos\n\n  def move_towards_position(pos, target_pos):\n      actions = []\n      dx, dy = target_pos - pos\n      \n      while not np.array_equal(pos, target_pos):\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  current_pos = np.array(env._current_state.pos)\n  nearest_workshop = find_nearest_workshop(env._current_state.grid, current_pos, env.world.workshop_indices)\n\n  if nearest_workshop is None:\n      raise ValueError(\"No workshop found to craft the item\")\n\n  actions_to_workshop = move_towards_position(current_pos, nearest_workshop)\n  actions_to_workshop.append(4)  # USE\n\n  return actions_to_workshop", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:42:53.069519", "function_name": "craft", "function_body": "  def move_towards_position(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  def find_nearest_workshop_for_item(env, goal_index):\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - env._current_state.pos, axis=1))]\n          return nearest_target_pos, workshop_idx\n\n      raise ValueError(\"No available workshop to craft the item\")\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  nearest_workshop_pos, _ = find_nearest_workshop_for_item(env, goal_index)\n\n  # Move towards the closest workshop\n  actions = move_towards_position(env, nearest_workshop_pos)\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T18:44:03.005293", "function_name": "craft", "function_body": "  def find_closest_workshop_position(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      \n      # Find the closest workshop that can craft the desired item\n      workshop_indices_with_recipe = set()\n      for output_index in cookbook.recipes:\n          if goal_index in cookbook.recipes[output_index].values():\n              workshop_indices_with_recipe.add(output_index)\n\n      closest_workshop_idx, nearest_target_pos = None, None\n      min_distance = float('inf')\n\n      for workshop_idx in workshop_indices_with_recipe.intersection(env.world.workshop_indices):\n          locations = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(locations) == 0:\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_location = locations[np.argmin(np.linalg.norm(locations - pos, axis=1))]\n          distance = np.linalg.norm(nearest_location - pos, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              nearest_target_pos = nearest_location\n\n      return closest_workshop_idx, nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, nearest_target_pos = find_closest_workshop_position(env, goal_index)\n\n  if closest_workshop_idx is None or nearest_target_pos is None:\n      raise ValueError(\"No available workshops found\")\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in based on Manhattan distance\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:44:04.065203", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos, workshop_indices):\n      min_distance = float('inf')\n      closest_workshop_idx, nearest_target_pos = None, None\n\n      for workshop_idx in workshop_indices:\n          # Find all positions of this type of workshop\n          locations = np.argwhere(grid[:, :, workshop_idx])\n          if len(locations) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          distances = np.linalg.norm(locations - pos, axis=1)\n          nearest_loc_idx = np.argmin(distances)\n\n          distance = distances[nearest_loc_idx]\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop_idx = workshop_idx\n              nearest_target_pos = locations[nearest_loc_idx]\n\n      return closest_workshop_idx, nearest_target_pos\n\n  def move_towards_position(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  grid = env._current_state.grid\n  pos = np.array(env._current_state.pos)\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, nearest_target_pos = find_closest_workshop(grid, pos, workshop_indices)\n\n  if closest_workshop_idx is None or nearest_target_pos is None:\n      raise ValueError(\"No available workshops found\")\n\n  # Move to the closest workshop position\n  actions = move_towards_position(pos, nearest_target_pos)\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T18:44:54.507610", "function_name": "craft", "function_body": "  def move_towards_workshop(env, target_workshop_idx):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find all positions of the target workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, target_workshop_idx])\n\n      if len(workshop_pos_list) == 0:\n          return []  # No workshops of this type exist\n\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      actions.append(4)  # USE the workshop to craft the item\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Identify the workshops that can be used for crafting the desired item\n  target_workshop_indices = []\n  for workshop_idx in env.world.workshop_indices:\n      recipe = cookbook.recipes.get(goal_index)\n      if recipe and (workshop_idx in recipe or \"_key\" in recipe):\n          target_workshop_indices.append(workshop_idx)\n\n  # Try to move towards each potential workshop\n  for workshop_idx in target_workshop_indices:\n      actions = move_towards_workshop(env, workshop_idx)\n      if actions:  # If we found a valid path to a workshop, return those actions\n          return actions\n\n  raise ValueError(\"No reachable workshop found to craft the desired item\")", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:44:55.473459", "function_name": "craft", "function_body": "  def get_closest_workshop_pos(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      \n      # Find all workshops that can be used to craft the desired item\n      for workshop_idx in env.world.workshop_indices:\n          if \"_key\" in cookbook.recipes[goal_index] and cookbook.recipes[goal_index][\"_key\"] == workshop_idx:\n              workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n              \n              if len(workshop_pos_list) > 0:  # Skip if no workshops of this type exist\n                  nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n                  return nearest_target_pos\n\n      raise ValueError(\"No suitable workshop found for crafting the item\")\n\n  def move_towards_position(pos, target):\n      actions = []\n      \n      while not np.array_equal(pos, target):\n          dx, dy = target - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  target_pos = get_closest_workshop_pos(env, goal_index)\n\n  # Generate actions to move towards and use the workshop\n  pos = np.array(env._current_state.pos)\n  actions = move_towards_position(pos, target_pos)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:45:53.062914", "function_name": "craft", "function_body": "  def get_recipe_for_item(cookbook, goal_index):\n      # Retrieve recipe for the goal index\n      if goal_index in cookbook.recipes:\n          return cookbook.recipes[goal_index]\n      else:\n          raise ValueError(\"No recipe found for this item\")\n\n  def move_towards_workshop(env, workshop_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos[np.argmin(np.linalg.norm(workshop_pos - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  def find_workshop(env, ingredient_indices):\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Check if the workshop can craft an item with any of the given ingredients\n          for _, recipe in env.world.cookbook.recipes.items():\n              if \"_key\" not in recipe:\n                  if any(ingredient_idx in recipe.keys() for ingredient_idx in ingredient_indices):\n                      return workshop_pos_list, workshop_idx\n\n      raise ValueError(\"No suitable workshop found\")\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Get the required ingredients for the desired item\n  recipe = get_recipe_for_item(cookbook, goal_index)\n  ingredient_indices = [ingredient_idx for ingredient_idx in recipe.keys() if ingredient_idx != \"_key\"]\n\n  # Find and move towards a suitable workshop that can craft the desired item\n  workshop_pos_list, _ = find_workshop(env, ingredient_indices)\n  actions = move_towards_workshop(env, workshop_pos_list)\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T18:45:54.024681", "function_name": "craft", "function_body": "  def move_towards_workshop(env):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find the workshop index that can create the item\n      for recipe in env.world.cookbook.recipes.values():\n          if goal_index == recipe.get(\"_key\"):\n              workshop_idx = next(iter(recipe.keys() - {\"_key\"}))\n              break\n\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          raise ValueError(\"No workshop available to craft the item\")\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:46:42.713762", "function_name": "craft", "function_body": "  def move_towards_workshop(workshop_index):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_index])\n\n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return None\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find all workshops that can be used to craft the desired item\n  possible_workshops = []\n  for recipe in cookbook.recipes.values():\n      if goal_index in recipe.values() or goal_index == recipe.get(\"_key\"):\n          workshop_idx = next((ws_idx for ws_idx in env.world.workshop_indices if ws_idx in recipe), None)\n          if workshop_idx is not None:\n              possible_workshops.append(workshop_idx)\n\n  # Attempt to move towards each workshop until successful\n  actions = None\n  for workshop_index in possible_workshops:\n      actions = move_towards_workshop(workshop_index)\n      if actions is not None:\n          break\n\n  if actions is None:\n      raise ValueError(\"No suitable workshop found\")\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:46:43.682869", "function_name": "craft", "function_body": "  def move_towards_target(target_pos, env):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Identify the required workshop indices for crafting the goal item\n  workshop_indices_for_goal = set()\n  for recipe_output, recipe in cookbook.recipes.items():\n      if recipe_output == goal_index:\n          ingredients_or_key = list(recipe.keys())[0]\n          if isinstance(ingredients_or_key, str) and \"_key\" in ingredients_or_key:\n              continue\n          else:\n              # Assume this workshop can craft the goal item\n              workshop_indices_for_goal.add(workshop_indices[recipe[ingredients_or_key]])\n\n  # Find and move towards the closest available workshop for crafting the desired item\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices_for_goal:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          continue\n\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      actions += move_towards_target(nearest_target_pos, env)\n      actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:47:38.781692", "function_name": "craft", "function_body": "  def get_closest_workshop_position(env):\n      pos = np.array(env._current_state.pos)\n      closest_workshop_pos = None\n      min_distance = float('inf')\n\n      # Iterate over all workshop indices to find the nearest one\n      for workshop_idx in env.world.workshop_indices:\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_positions) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate distances from current position to all workshop positions\n          distances = np.linalg.norm(workshop_positions - pos, axis=1)\n          nearest_workshop_pos = workshop_positions[np.argmin(distances)]\n          distance = distances.min()\n\n          # Update closest workshop if a closer one is found\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop_pos = nearest_workshop_pos\n\n      return closest_workshop_pos\n\n  def move_towards(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Get the position of the closest workshop\n  closest_workshop_pos = get_closest_workshop_position(env)\n\n  if closest_workshop_pos is None:\n      raise ValueError(\"No workshops found in the environment.\")\n\n  # Move towards the closest workshop\n  actions = move_towards(env, closest_workshop_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T18:47:39.851255", "function_name": "craft", "function_body": "  def move_towards_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Determine the required workshop type from the recipe\n      for output_idx, ingredients in env.world.cookbook.recipes.items():\n          if output_idx == goal_index:\n              ingredient_indices = [i for i in ingredients if isinstance(i, int)]\n              break\n\n      # Find all workshops that can craft this item (assuming any workshop can)\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n          while not np.array_equal(pos, nearest_target_pos):\n              dx, dy = nearest_target_pos - pos\n\n              # Determine direction to move in\n              if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n                  actions.append(3 if dx > 0 else 2)\n                  pos[0] += 1 if dx > 0 else -1\n              else:  # Then move in y-direction\n                  actions.append(1 if dy > 0 else 0)\n                  pos[1] += 1 if dy > 0 else -1\n\n          # Use the workshop to craft the item\n          actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env, goal_index)\n\n  return actions", "island_id": 0, "scores": {"3": 5.1}}
{"timestamp": "2025-09-06T18:48:59.310863", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* algorithm to find the shortest path to the nearest workshop position\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star_search(start, goal):\n      open_set = collections.deque([(0, start)])\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          _, current = open_set.popleft()\n\n          if np.array_equal(current, goal):\n              path = []\n              while current in came_from:\n                  path.append(tuple(current))\n                  current = came_from[current]\n              return path[::-1]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = np.array([current[0] + dx, current[1] + dy])\n              if not (0 <= neighbor[0] < env._current_state.grid.shape[0]) or not (0 <= neighbor[1] < env._current_state.grid.shape[1]):\n                  continue\n              tentative_g_score = g_score[current] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[tuple(neighbor)] = tuple(current)\n                  g_score[tuple(neighbor)] = tentative_g_score\n                  f_score[tuple(neighbor)] = tentative_g_score + heuristic(tuple(neighbor), goal)\n                  open_set.append((f_score[tuple(neighbor)], neighbor))\n\n      return []\n\n  path_to_workshop = a_star_search(pos, nearest_target_pos)\n\n  if not path_to_workshop:\n      raise ValueError(\"No valid path to the workshop found\")\n\n  # Convert the path into actions\n  for next_pos in path_to_workshop[1:]:  # Exclude start position\n      dx, dy = next_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:49:00.435835", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest target position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x, ord=2))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T18:49:49.886356", "function_name": "craft", "function_body": "  def move_to_position(pos_target):\n      pos_current = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos_current, pos_target):\n          dx, dy = pos_target - pos_current\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos_current[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos_current[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Determine the required workshop type from the recipe\n  for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if output_idx == goal_index:\n          ingredient_indices = [i for i in ingredients if isinstance(i, int)]\n          break\n\n  # Find all workshops that can craft this item (assuming any workshop can)\n  actions = []\n  for workshop_idx in env.world.workshop_indices:\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          continue\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - env._current_state.pos, axis=1))]\n\n      actions.extend(move_to_position(nearest_target_pos))\n      actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 4.8999996}}
