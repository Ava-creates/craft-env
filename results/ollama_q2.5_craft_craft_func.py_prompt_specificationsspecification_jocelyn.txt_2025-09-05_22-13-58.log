se the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T15:41:36.188857", "function_name": "craft", "function_body": "  def move_towards_workshop(env):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find the nearest workshop that can craft the desired item\n      for workshop_idx in env.world.workshop_indices:\n          # Check if this workshop is relevant to crafting the goal item\n          if any(ingredient_index == workshop_idx for ingredient_index, _ in cookbook.recipes.get(goal_index, {}).items()):\n              workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n              \n              if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n                  continue\n\n              # Calculate the closest position to move towards\n              nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n              while not np.array_equal(pos, nearest_target_pos):\n                  dx, dy = nearest_target_pos - pos\n\n                  # Determine direction to move in\n                  if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n                      actions.append(3 if dx > 0 else 2)\n                      pos[0] += 1 if dx > 0 else -1\n                  else:  # Then move in y-direction\n                      actions.append(1 if dy > 0 else 0)\n                      pos[1] += 1 if dy > 0 else -1\n\n              # Use the workshop to craft the item\n              actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the nearest workshop that can craft the desired item\n  actions = move_towards_workshop(env)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T15:41:37.169237", "function_name": "craft", "function_body": "  def get_closest_workshop(workshop_indices):\n      pos = np.array(env._current_state.pos)\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      closest_pos = None\n\n      for workshop_idx in workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          distances = np.linalg.norm(workshop_pos_list - pos, axis=1)\n          nearest_target_pos = workshop_pos_list[np.argmin(distances)]\n          distance = distances.min()\n\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop_idx = workshop_idx\n              closest_pos = nearest_target_pos\n\n      return closest_workshop_idx, closest_pos\n\n  def move_to_position(target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  workshop_indices = [idx for idx in env.world.workshop_indices if any(goal_index in recipe.values() for recipe in cookbook.recipes.values())]\n  closest_workshop_idx, closest_pos = get_closest_workshop(workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No suitable workshop found\")\n\n  actions = move_to_position(closest_pos)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T15:43:18.868299", "function_name": "craft", "function_body": "  def move_towards_workshop(workshop_idx):\n      pos = np.array(state.pos)\n      actions = []\n\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return None\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  state = env._current_state\n  grid = state.grid\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check if there's a recipe for the goal item\n  if goal_index not in cookbook.recipes:\n      return []  # No crafting needed\n\n  # Determine which workshops can craft the desired item\n  possible_workshops = []\n  for workshop_idx in env.world.workshop_indices:\n      if any(ingredient_index == \"_key\" or grid[:, :, ingredient_index].sum() > 0 for ingredient_index in cookbook.recipes[goal_index]):\n          possible_workshops.append(workshop_idx)\n\n  # If no workshops can craft the item, return an empty list of actions\n  if not possible_workshops:\n      return []\n\n  # Move towards the closest workshop that can craft the desired item\n  best_actions = None\n  for workshop_idx in possible_workshops:\n      actions = move_towards_workshop(workshop_idx)\n      if actions is not None:\n          if best_actions is None or len(actions) < len(best_actions):\n              best_actions = actions\n\n  return best_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T15:43:19.839181", "function_name": "craft", "function_body": "  def calculate_path(start_pos, target_pos):\n      dx, dy = target_pos - start_pos\n      path_actions = []\n      while not np.array_equal(start_pos, target_pos):\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              path_actions.append(3 if dx > 0 else 2)\n              start_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              path_actions.append(1 if dy > 0 else 0)\n              start_pos[1] += 1 if dy > 0 else -1\n      return path_actions\n\n  def move_towards_workshop(env, workshop_idx):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return None\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      # Calculate path actions\n      actions.extend(calculate_path(pos, nearest_target_pos))\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find all recipes that can produce the desired item\n  for recipe_output, recipe in cookbook.recipes.items():\n      if recipe_output == goal_index:\n          # Check which workshop type can be used to craft this item\n          for ingredient_or_key, count in recipe.items():\n              if ingredient_or_key.startswith(\"_\"):\n                  workshop_type = int(ingredient_or_key[1:])\n                  actions = move_towards_workshop(env, workshop_type)\n                  if actions is not None:\n                      return actions\n\n  raise ValueError(\"No suitable workshop found to craft the item\")", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T15:45:02.220599", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  closest_workshop_idx, nearest_target_pos = None, None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) == 0:\n          continue\n\n      workshop_mean_pos = workshop_positions.mean(axis=0)\n      distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n\n      if distance < min_distance:\n          min_distance = distance\n          closest_workshop_idx = workshop_idx\n\n          # Find the nearest target position from current position\n          for target_pos in workshop_positions:\n              target_distance = np.linalg.norm(pos - target_pos, ord=2)\n              if target_distance < min_nearest_distance:\n                  nearest_target_pos = target_pos\n                  min_nearest_distance = target_distance\n\n  if closest_workshop_idx is None or nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 4, "scores": {"3": 