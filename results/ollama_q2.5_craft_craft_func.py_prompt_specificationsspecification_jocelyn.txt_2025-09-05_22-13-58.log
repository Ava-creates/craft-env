{"timestamp": "2025-09-06T13:12:11.154213", "function_name": "craft", "function_body": "  def move_towards(position: np.ndarray) -> list[int]:\n      \"\"\"Move towards a given position.\"\"\"\n      current_pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(current_pos, position):\n          dx, dy = position - current_pos\n          direction = None\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              direction = 3 if dx > 0 else 2\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              direction = 1 if dy > 0 else 0\n              current_pos[1] += 1 if dy > 0 else -1\n\n          actions.append(direction)\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find workshops that can craft the desired item\n  recipe_workshops = []\n  for workshop_idx in env.world.workshop_indices:\n      if any(workshop_idx == idx for idx, _ in cookbook.recipes[goal_index]):\n          recipe_workshops.append(workshop_idx)\n\n  if not recipe_workshops:\n      raise ValueError(\"No available workshops that can craft the desired item\")\n\n  # Choose the closest workshop\n  actions = []\n  pos = np.array(env._current_state.pos)\n  nearest_target_pos, min_distance = None, float('inf')\n\n  for workshop_idx in recipe_workshops:\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(target_positions) == 0:  # Skip if no workshops of this type are available\n          continue\n\n      closest_target_pos = min(\n          (pos, np.linalg.norm(pos - pos, ord=2)) for pos in target_positions\n      )[0]\n\n      distance = np.linalg.norm(pos - closest_target_pos, ord=2)\n      if distance < min_distance:\n          nearest_target_pos = closest_target_pos\n          min_distance = distance\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshops found\")\n\n  # Move to the closest workshop position\n  actions.extend(move_towards(nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T13:12:12.146020", "function_name": "craft", "function_body": "  def move_towards(position: np.ndarray) -> list[int]:\n      \"\"\"Move towards a given position.\"\"\"\n      current_pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(current_pos, position):\n          dx, dy = position - current_pos\n          direction = None\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              direction = 3 if dx > 0 else 2\n          else:  # Then move in y-direction\n              direction = 1 if dy > 0 else 0\n\n          actions.append(direction)\n          current_pos += np.array([direction == 3, direction == 1]) - np.array([direction == 2, direction == 0])\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_towards(nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T13:19:33.626381", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    actions = []\n    while not np.array_equal(pos, target_pos):\n        dx, dy = target_pos - pos\n        # Prioritize moving in the direction with the larger distance\n        if abs(dx) > abs(dy):\n            actions.append(3 if dx > 0 else 2)\n            pos[0] += 1 if dx > 0 else -1\n        elif abs(dy) > abs(dx):\n            actions.append(1 if dy > 0 else 0)\n            pos[1] += 1 if dy > 0 else -1\n        # If distances are equal, move in the direction of the current target position\n        else:\n            actions.append(3 if dx > 0 else 2) if dx >= 0 else actions.append(2)\n            actions.append(1 if dy > 0 else 0) if dy >= 0 else actions.append(0)\n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  distances_to_workshops = {}\n\n  for workshop_idx in workshop_indices:\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(target_positions) > 0:  # Check if there are any positions\n          distances = np.linalg.norm(pos - target_positions, axis=1)\n          nearest_target_pos = target_positions[np.argmin(distances)]\n          distance_to_nearest = distances.min()\n          distances_to_workshops[workshop_idx] = (distance_to_nearest, nearest_target_pos)\n\n  # Get the closest workshops based on their distances\n  sorted_workshops = sorted(distances_to_workshops.items(), key=lambda x: x[1][0])\n\n  actions = []\n\n  for workshop_idx, (_, nearest_target_pos) in sorted_workshops:\n      # Move to the closest workshop position\n      actions.extend(move_towards(pos, nearest_target_pos))\n      pos = nearest_target_pos\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  raise ValueError(\"No available workshop found\")", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T13:19:34.612620", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    actions = []\n    while not np.array_equal(pos, target_pos):\n        dx, dy = target_pos - pos\n        direction = np.argmax([abs(dx), abs(dy)])\n        if direction == 0:  # x-direction\n            actions.append(3 if dx > 0 else 2)\n            pos[0] += 1 if dx > 0 else -1\n        elif direction == 1:  # y-direction\n            actions.append(1 if dy > 0 else 0)\n            pos[1] += 1 if dy > 0 else -1\n    return actions\n\n  def find_closest_workshop_position(env, pos):\n      workshop_indices = env.world.workshop_indices\n      distances_to_workshops = {}\n\n      for workshop_idx in workshop_indices:\n          target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(target_positions) > 0:  # Check if there are any positions\n              distances = np.linalg.norm(pos - target_positions, axis=1)\n              nearest_target_pos = target_positions[np.argmin(distances)]\n              distance_to_nearest = distances.min()\n              distances_to_workshops[workshop_idx] = (distance_to_nearest, nearest_target_pos)\n\n      # Get the closest workshops based on their distances\n      sorted_workshops = sorted(distances_to_workshops.items(), key=lambda x: x[1][0])\n\n      if not sorted_workshops:\n          raise ValueError(\"No available workshop found\")\n\n      return sorted_workshops[0][1]\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  pos = np.array(env._current_state.pos)\n  nearest_target_pos = find_closest_workshop_position(env, pos)\n\n  # Move to the closest workshop position\n  actions = move_towards(pos, nearest_target_pos)\n  pos = nearest_target_pos\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T13:21:51.579749", "function_name": "craft", "function_body": "  def move_to_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      workshop_indices = env.world.workshop_indices\n      actions = []\n\n      # Check if the current position is already next to a valid workshop\n      for workshop_idx in workshop_indices:\n          if env._current_state.next_to(workshop_idx):\n              return actions  # No need to move\n\n      # Find the closest workshop that can craft the desired item\n      closest_workshop_idx, min_distance = None, float('inf')\n\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              \n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n      if closest_workshop_idx is None:\n          raise ValueError(\"No available workshop found\")\n\n      # Find the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n      nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n      # Move to the closest workshop position\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  actions = move_to_workshop(env, goal_index)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 3.7}}
{"timestamp": "2025-09-06T13:21:52.583711", "function_name": "craft", "function_body": "  def get_closest_workshops_by_distance(current_pos, workshop_indices):\n      \"\"\"\n      Returns a sorted list of (workshop_index, average_position, distance) tuples\n      based on the closest average positions to the current position.\n      \"\"\"\n      workshops_distances = []\n\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(current_pos - workshop_pos_mean, ord=2)\n              workshops_distances.append((workshop_idx, workshop_pos_mean, distance))\n\n      return sorted(workshops_distances, key=lambda x: x[2])\n\n  def move_to_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      workshop_indices = env.world.workshop_indices\n      actions = []\n\n      # Find the closest workshops that can craft the desired item by distance\n      closest_workshops = get_closest_workshops_by_distance(pos, workshop_indices)\n\n      if not closest_workshops:\n          raise ValueError(\"No available workshop found\")\n\n      for workshop_idx, nearest_target_pos in closest_workshops[:1]:\n          # Move to the closest workshop position\n          while not np.array_equal(pos, nearest_target_pos):\n              dx, dy = nearest_target_pos - pos\n\n              if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n                  actions.append(3 if dx > 0 else 2)\n                  pos[0] += 1 if dx > 0 else -1\n              else:  # Then move in y-direction\n                  actions.append(1 if dy > 0 else 0)\n                  pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  actions = move_to_workshop(env, goal_index)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
