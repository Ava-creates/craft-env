se the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T03:04:24.024835", "function_name": "craft", "function_body": "  def move_to_target(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      direction_mapping = {\n          (0, -1): 0,  # UP\n          (0, 1): 1,   # DOWN\n          (-1, 0): 2,  # LEFT\n          (1, 0): 3    # RIGHT\n      }\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine the direction with the largest absolute difference to prioritize moving in that direction first\n          if abs(dx) > abs(dy):\n              direction = (1, 0) if dx > 0 else (-1, 0)\n          else:\n              direction = (0, 1) if dy > 0 else (0, -1)\n\n          actions.append(direction_mapping[direction])\n          pos += np.array(direction)\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check which workshops can craft the desired item\n  workshop_indices = []\n  for i, recipe in enumerate(cookbook.recipes):\n      if goal_index in recipe.products:\n          workshop_indices.append(env.world.workshop_indices[i])\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(env, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T03:04:24.994198", "function_name": "craft", "function_body": "  def move_to_target(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      direction_mapping = {\n          (0, -1): 0,  # UP\n          (0, 1): 1,   # DOWN\n          (-1, 0): 2,  # LEFT\n          (1, 0): 3    # RIGHT\n      }\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine the direction with the largest absolute difference to prioritize moving in that direction first\n          if abs(dx) > abs(dy):\n              direction = (1, 0) if dx > 0 else (-1, 0)\n          elif abs(dy) > abs(dx):\n              direction = (0, 1) if dy > 0 else (0, -1)\n          else:  # If both are equal, choose any one direction\n              direction = (1, 0) if dx > 0 else (-1, 0)\n\n          actions.append(direction_mapping[direction])\n          pos += np.array(direction)\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Get the list of required primitives for the item from the cookbook\n  recipe = cookbook.primitives.get(goal_index, [])\n  inventory = env._current_state.inventory\n\n  actions = []\n\n  # Check if all required primitives are in inventory\n  for primitive in recipe:\n      if inventory[primitive] < 1:  # Assuming we need at least one unit of each primitive\n          raise ValueError(f\"Missing {cookbook.index.get(primitive, 'unknown')} in inventory\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(env, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T03:06:21.038546", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  min_distance = float('inf')\n  target_workshop_idx = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          mean_pos = workshop_positions.mean(axis=0)\n          current_distance = np.linalg.norm(np.array(env._current_state.pos) - mean_pos, ord=2)\n\n          if current_distance < min_distance:\n              target_workshop_idx = workshop_idx\n              min_distance = current_distance\n\n  if target_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the closest position to move towards among all positions of the target workshop\n  nearest_pos = np.argwhere(env._current_state.grid[:, :, target_workshop_idx]).min(axis=0)\n  pos = np.array(env._current_state.pos)\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_pos):\n      dx, dy = nearest_pos - pos\n\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T03:06:22.128388", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  min_distance = float('inf')\n  target_workshop_idx = None\n  all_workshops_positions = np.array([])\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          distances = np.linalg.norm(np.array(env._current_state.pos) - workshop_positions, axis=1)\n          min_distance_in_workshop = distances.min()\n\n          if min_distance_in_workshop < min_distance:\n              target_workshop_idx = workshop_idx\n              nearest_pos = workshop_positions[np.argmin(distances)]\n              min_distance = min_distance_in_workshop\n\n  if target_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  pos = np.array(env._current_state.pos)\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_pos):\n      dx, dy = nearest_pos - pos\n\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T03:08:19.800688", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  for recipe in cookbook.recipes.values():\n      if goal_index in recipe.values():\n          for ingredient, count in recipe.items():\n              if ingredient != \"_key\":\n                  workshop_idx = int(ingredient)\n                  break\n\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n              # Calculate the closest position to move towards\n              target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n              nearest_target_pos = None\n              min_nearest_distance = float('inf')\n\n              for target_pos in target_positions:\n                  distance = np.linalg.norm(pos - target_pos, ord=2)\n                  if distance < min_nearest_distance:\n                      nearest_target_pos = target_pos\n                      min_nearest_distance = distance\n\n              # Move to the closest workshop position\n              while not np.array_equal(pos, nearest_target_pos):\n                  dx, dy = nearest_target_pos - pos\n\n                  # Determine direction to move in\n                  if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n                      actions.append(3 if dx > 0 else 2)\n                      pos[0] += 1 if dx > 0 else -1\n                  else:  # Then move in y-direction\n                      actions.append(1 if dy > 0 else 0)\n                      pos[1] += 1 if dy > 0 else -1\n\n              # Use the workshop to craft the item\n              actions.append(4)  # USE\n          break\n  else:\n      raise ValueError(\"No available workshop found for the item\")\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
