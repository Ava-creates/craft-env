{"timestamp": "2025-09-06T04:47:04.390445", "function_name": "craft", "function_body": "  def move_to_target(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              action = 3 if dx > 0 else 2\n              actions.append(action)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              action = 1 if dy > 0 else 0\n              actions.append(action)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n  \n  def find_closest_workshop(env, goal_index):\n      cookbook = env.world.cookbook\n      workshop_indices = env.world.workshop_indices\n      \n      closest_workshop_idx, min_distance = None, float('inf')\n      pos = np.array(env._current_state.pos)\n      \n      for workshop_idx in workshop_indices:\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      \n      return closest_workshop_idx\n\n  def find_nearest_target_position(env, workshop_idx):\n      pos = np.array(env._current_state.pos)\n      \n      # Calculate the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n      \n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n      \n      return nearest_target_pos\n\n  def is_workshop_active(env, workshop_idx):\n      # Check if there is at least one non-zero value in the grid for the given workshop index\n      return np.any(env._current_state.grid[:, :, workshop_idx] > 0)\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find all workshops that can craft the desired item\n  required_workshops = set()\n  for recipe in cookbook.recipes.values():\n      if goal_index in recipe.output_indices:\n          required_workshops.update(recipe.workshop_indices)\n\n  active_workshops = [ws_idx for ws_idx in required_workshops if is_workshop_active(env, ws_idx)]\n\n  if not active_workshops:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the closest active workshop\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n  \n  for workshop_idx in active_workshops:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  nearest_target_pos = find_nearest_target_position(env, closest_workshop_idx)\n\n  # Move to the closest workshop position\n  actions = move_to_target(env, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T04:47:05.479970", "function_name": "craft", "function_body": "  def move_to_target(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      direction_mapping = {\n          (0, -1): 0,  # UP\n          (0, 1): 1,   # DOWN\n          (-1, 0): 2,  # LEFT\n          (1, 0): 3    # RIGHT\n      }\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              direction = (1, 0) if dx > 0 else (-1, 0)\n          else:  # Then move in y-direction\n              direction = (0, 1) if dy > 0 else (0, -1)\n\n          actions.append(direction_mapping[direction])\n          pos += np.array(direction)\n\n      return actions\n\n  def find_closest_workshop(env, goal_index):\n      cookbook = env.world.cookbook\n      workshop_indices = env.world.workshop_indices\n      \n      closest_workshop_idx, min_distance = None, float('inf')\n      pos = np.array(env._current_state.pos)\n      \n      for workshop_idx in workshop_indices:\n          # Get all positions of the current type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # No workshops of this type, skip\n              continue\n          \n          # Find the closest workshop position to the agent\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      \n      return closest_workshop_idx\n\n  def find_nearest_target_position(env, workshop_idx):\n      pos = np.array(env._current_state.pos)\n      \n      # Calculate the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n      \n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n      \n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_idx = find_closest_workshop(env, goal_index)\n  \n  if workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = find_nearest_target_position(env, workshop_idx)\n\n  # Move to the closest workshop position\n  actions = move_to_target(env, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T04:49:07.013380", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for recipe_output, ingredients in cookbook.recipes.items():\n      if goal_index == recipe_output:\n          # Determine which workshops are needed based on ingredient indices\n          required_workshops = set()\n          for ingredient, _ in ingredients.items():\n              if ingredient != \"_key\":  # Skip the key entry\n                  # Check which workshop can craft the ingredient or if it's a primitive\n                  if env.world.cookbook.primitives_for(ingredient) or ingredient not in env.world.non_grabbable_indices:\n                      for workshop_idx in workshop_indices:\n                          required_workshops.add(workshop_idx)\n\n          # Calculate the mean position of all workshops that are needed\n          if required_workshops:\n              workshop_positions = np.concatenate([np.argwhere(env._current_state.grid[:, :, w]) for w in required_workshops], axis=0)\n              workshop_pos_mean = workshop_positions.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n          break\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-06T04:49:07.994109", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  # Iterate through recipes to find a recipe for the goal\n  for recipe_output, ingredients in cookbook.recipes.items():\n      if goal_index == recipe_output:\n          # Check which workshop can craft any ingredient\n          for workshop_idx in workshop_indices:\n              if env.world.cookbook.primitives_for(ingredient) or ingredient not in env.world.non_grabbable_indices:\n                  workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n                  if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n                      workshop_pos_mean = workshop_pos_list.mean(axis=0)\n                      distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n                      if distance < min_distance:\n                          closest_workshop_idx, min_distance = workshop_idx, distance\n\n          break\n\n  # If no suitable workshop found, raise error\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest target position on the grid for the closest workshop\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x, ord=2))\n\n  # Generate move actions to reach the nearest target position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Prioritize moving in the direction with larger distance first\n      if abs(dx) > abs(dy):  # Move horizontally\n          actions.append(3 if dx > 0 else 2)  # RIGHT or LEFT\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Move vertically\n          actions.append(1 if dy > 0 else 0)  # UP or DOWN\n          pos[1] += 1 if dy > 0 else -1\n\n  # Append the USE action to craft the item at the workshop\n  actions.append(4)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-06T04:51:13.014969", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  \n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction if needed\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 8, "scores": {"3": 4.7}}
