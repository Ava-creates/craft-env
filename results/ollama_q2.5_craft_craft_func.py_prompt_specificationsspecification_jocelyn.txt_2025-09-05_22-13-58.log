{"timestamp": "2025-09-06T14:06:53.983333", "function_name": "craft", "function_body": "  def move_to_target(pos, target_pos):\n      dx, dy = target_pos - pos\n\n      # Determine direction to move in based on shortest path heuristic\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x, ord=2))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      direction = move_to_target(pos, nearest_target_pos)\n      actions.append(direction)\n\n      # Update agent's position based on the action taken\n      if direction == 3:\n          pos[0] += 1\n      elif direction == 2:\n          pos[0] -= 1\n      elif direction == 1:\n          pos[1] += 1\n      elif direction == 0:\n          pos[1] -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T14:06:55.053050", "function_name": "craft", "function_body": "  def move_to_target(pos, target_pos):\n      \"\"\"Calculate direction to move towards the target position.\"\"\"\n      dx, dy = target_pos - pos\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return (3 if dx > 0 else 2)\n      else:  # Then move in y-direction\n          return (1 if dy > 0 else 0)\n\n  def get_closest_workshop_pos(env):\n      \"\"\"Find the closest workshop position for crafting.\"\"\"\n      pos = np.array(env._current_state.pos)\n      workshop_indices = env.world.workshop_indices\n\n      min_distance, closest_workshop_pos = float('inf'), None\n      for idx in workshop_indices:\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, idx])\n          if len(workshop_positions) > 0:\n              mean_pos = workshop_positions.mean(axis=0)\n              distance = np.linalg.norm(pos - mean_pos, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_pos = workshop_positions[np.argmin(np.linalg.norm(workshop_positions - pos, axis=1))]\n      return closest_workshop_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop position\n  nearest_target_pos = get_closest_workshop_pos(env)\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      direction = move_to_target(pos, nearest_target_pos)\n      actions.append(direction)\n\n      # Update agent's position based on the action taken\n      if direction == 3:\n          pos[0] += 1\n      elif direction == 2:\n          pos[0] -= 1\n      elif direction == 1:\n          pos[1] += 1\n      elif direction == 0:\n          pos[1] -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T14:09:09.498333", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Check if the current state already satisfies the goal\n  if env._current_state.satisfies(\"\", goal_index):\n      return actions  # No need to craft if we already have it\n\n  # Find all positions of all workshops available in the environment\n  pos = np.array(env._current_state.pos)\n  workshop_positions = []\n\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      workshop_positions.extend(workshop_pos_list)\n\n  if not workshop_positions:\n      raise ValueError(\"No available workshops found\")\n\n  # Find the nearest workshop using Manhattan distance for better performance\n  nearest_workshop_pos = min(workshop_positions, key=lambda tp: np.abs(tp - pos).sum())\n\n  # Calculate the direction to move towards the nearest workshop\n  dx, dy = nearest_workshop_pos - pos\n\n  # Determine directions to move in based on the difference in coordinates\n  while not np.array_equal(pos, nearest_workshop_pos):\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n          dx -= 1 if dx > 0 else -1\n      elif dy != 0:  # Move in y-direction only if not already at the correct y position\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n          dy -= 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T14:14:09.612391", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Check if the current state already satisfies the goal\n  if env._current_state.satisfies(\"\", goal_index):\n      return actions  # No need to craft if we already have it\n\n  # Find all positions of all workshops available in the environment\n  pos = np.array(env._current_state.pos)\n  workshop_positions = []\n\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      workshop_positions.extend(workshop_pos_list)\n\n  if not workshop_positions:\n      raise ValueError(\"No available workshops found\")\n\n  # Find the nearest workshop using Manhattan distance for better performance\n  nearest_workshop_pos = min(workshop_positions, key=lambda tp: np.abs(tp - pos).sum())\n\n  # Move towards the closest workshop while considering the direction already facing\n  current_direction = env._current_state.dir\n\n  while not np.array_equal(pos, nearest_workshop_pos):\n      dx, dy = nearest_workshop_pos - pos\n\n      target_directions = [\n          (3, 0),  # RIGHT: x+1\n          (2, 0),  # LEFT: x-1\n          (1, 1),  # DOWN: y+1\n          (0, -1)  # UP: y-1\n      ]\n\n      for dir_action, direction in enumerate(target_directions):\n          if (pos + direction == nearest_workshop_pos).all():\n              actions.append(dir_action)\n              pos += direction\n              current_direction = dir_action\n              break\n\n  # Use the workshop to craft the item\n  if env._current_state.next_to(nearest_workshop_pos):\n      actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:16:10.788968", "function_name": "craft", "function_body": "  def move_towards_workshop(env):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n          while not np.array_equal(pos, nearest_target_pos):\n              dx, dy = nearest_target_pos - pos\n\n              # Determine direction to move in\n              if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n                  actions.append(3 if dx > 0 else 2)\n                  pos[0] += 1 if dx > 0 else -1\n              else:  # Then move in y-direction\n                  actions.append(1 if dy > 0 else 0)\n                  pos[1] += 1 if dy > 0 else -1\n\n          # Use the workshop to craft the item\n          actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env)\n\n  return actions", "island_id": 0, "scores": {"3": 5.1}}
{"timestamp": "2025-09-06T14:16:11.755061", "function_name": "craft", "function_body": "  def move_towards_position(pos_target):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, pos_target):\n          dx, dy = pos_target - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n  \n  def get_workshop_for_item(item_index):\n      cookbook = env.world.cookbook\n      for output, ingredients in cookbook.recipes.items():\n          if item_index == output:\n              return ingredients.get(\"_key\", None)\n      return None\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_key = get_workshop_for_item(goal_index)\n\n  if workshop_key is not None:\n      # Find the corresponding workshop index for the recipe key\n      workshop_index = cookbook.index.get(workshop_key, None)\n      \n      if workshop_index is not None and workshop_index in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_index])\n          \n          if len(workshop_pos_list) > 0:\n              # Calculate the closest position to move towards\n              nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - np.array(env._current_state.pos), axis=1))]\n              \n              actions_to_workshop = move_towards_position(nearest_target_pos)\n              actions_to_use_workshop = [4]  # USE\n\n              return actions_to_workshop + actions_to_use_workshop\n          else:\n              raise ValueError(\"Workshop not found in the grid\")\n      else:\n          raise ValueError(\"Workshop index not found in workshop_indices or cookbook.index\")\n\n  else:\n      raise ValueError(\"No recipe for item in cookbook\")", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:18:03.051663", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for recipe in cookbook.recipes.values():\n      if goal_index in recipe[\"_key\"]:\n          break\n  else:\n      raise ValueError(\"No recipe found for the given item\")\n\n  # Assuming that any workshop can be used to craft the desired item (need refinement)\n  closest_workshop_idx = workshop_indices[0]  # This is a placeholder; need to find actual closest\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  if closest_workshop_idx is None or nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:18:04.125141", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  \n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  target_workshops = []\n\n  for workshop_idx in workshop_indices:\n    # Check if there are workshops of this type on the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    if len(workshop_positions) > 0:\n      target_workshops.append((workshop_idx, workshop_positions))\n\n  if not target_workshops:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate distances to all workshops and find the closest one\n  closest_workshop = None\n  min_distance = float('inf')\n\n  for workshop_idx, positions in target_workshops:\n    mean_position = positions.mean(axis=0)\n    distance = np.linalg.norm(pos - mean_position, ord=2)\n    if distance < min_distance:\n      closest_workshop = (workshop_idx, positions)\n      min_distance = distance\n\n  if not closest_workshop:\n      raise ValueError(\"No available workshop found\")\n\n  # Determine the nearest position to move towards\n  workshop_idx, positions = closest_workshop\n  target_position = positions[np.argmin([np.linalg.norm(pos - p, ord=2) for p in positions])]\n\n  # Calculate actions to move towards the target position\n  while not np.array_equal(pos, target_position):\n    dx, dy = target_position - pos\n\n    if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n      actions.append(3 if dx > 0 else 2)\n      pos[0] += 1 if dx > 0 else -1\n    else:  # Then move in y-direction\n      actions.append(1 if dy > 0 else 0)\n      pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T14:20:19.582365", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = [np.linalg.norm(pos - tp, ord=2) for tp in workshop_pos_list]\n          nearest_target_pos = workshop_pos_list[np.argmin(distances)]\n          distance = np.min(distances)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance, target_position = workshop_idx, distance, nearest_target_pos\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, target_position):\n      dx, dy = target_position - pos\n\n      # Determine direction to move in based on Manhattan distance for better performance\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Move in y-direction only if not already at the correct y position\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T14:20:20.582292", "function_name": "craft", "function_body": "  def move_to_position(current_pos: np.ndarray, target_pos: np.ndarray) -> list[int]:\n      \"\"\"Helper function to generate a sequence of movement actions to reach a target position.\"\"\"\n      actions = []\n      dx, dy = target_pos - current_pos\n      while not np.array_equal(current_pos, target_pos):\n          # Prioritize moving in the direction with the largest difference first\n          if abs(dx) > abs(dy):\n              direction = 3 if dx > 0 else 2\n              current_pos[0] += 1 if dx > 0 else -1\n              dx -= 1 if dx > 0 else -1\n          else:\n              direction = 1 if dy > 0 else 0\n              current_pos[1] += 1 if dy > 0 else -1\n              dy -= 1 if dy > 0 else -1\n          actions.append(direction)\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  current_pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=2)\n          distance = np.linalg.norm(current_pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(current_pos - tp, ord=2) for tp in target_positions])]\n\n  # Generate movement actions to reach the nearest workshop position\n  actions.extend(move_to_position(current_pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:22:23.064816", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the goal index\n  recipe = cookbook.recipes.get(goal_index)\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])[0]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in based on Manhattan distance\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T14:22:24.177301", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the goal index\n  recipe = cookbook.recipes.get(goal_index)\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Check if there are any workshops in the grid that can craft the desired item\n  workshop_locations = {}\n  for workshop_idx in workshop_indices:\n      locations = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(locations) > 0:\n          workshop_locations[workshop_idx] = locations\n\n  if not workshop_locations:\n      raise ValueError(\"No available workshops found\")\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, nearest_target_pos = None, None\n  min_distance = float('inf')\n\n  for workshop_idx, locations in workshop_locations.items():\n      mean_location = np.mean(locations, axis=0)\n      distance = np.linalg.norm(pos - mean_location, ord=2)\n\n      if distance < min_distance:\n          closest_workshop_idx = workshop_idx\n          nearest_target_pos = locations[np.argmin(np.linalg.norm(locations - pos, axis=1))]\n\n  if closest_workshop_idx is None or nearest_target_pos is None:\n      raise ValueError(\"No available workshops found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in based on Manhattan distance\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T14:24:05.282680", "function_name": "craft", "function_body": "  def get_closest_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      \n      # Find all workshops that can be used to craft the desired item\n      for workshop_idx in env.world.workshop_indices:\n          if (workshop_idx in env.world.cookbook.recipes[goal_index]) or (workshop_idx in env.world.cookbook.primitives_for(goal_index)):\n              workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n              \n              if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n                  continue\n\n              # Calculate the closest position to move towards\n              nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n              return nearest_target_pos, workshop_idx\n      \n      raise ValueError(\"No suitable workshop found for crafting item\")\n\n  def move_towards_workshop(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  target_pos, workshop_idx = get_closest_workshop(env, goal_index)\n\n  # Find and move towards the closest suitable workshop that can craft the desired item\n  actions = move_towards_workshop(env, target_pos)\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:24:06.252656", "function_name": "craft", "function_body": "  def move_towards_workshop(workshop_index):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_index])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return None\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Determine which workshop can craft the desired item\n  for recipe in cookbook.recipes.values():\n      if goal_index == recipe[\"_key\"]:\n          for ingredient, count in recipe.items():\n              if isinstance(ingredient, int) and ingredient in env.world.workshop_indices:\n                  actions = move_towards_workshop(ingredient)\n                  if actions is not None:\n                      return actions\n\n  return []  # No workshop found to craft the desired item", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:26:22.917595", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Orient the agent towards the workshop to use it correctly\n  target_dir = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0])\n  current_angle = env._current_state.dir * (np.pi / 2)\n  angle_diff = (target_dir - current_angle) % (2 * np.pi)\n\n  if angle_diff < np.pi:\n      actions.append(3)  # RIGHT\n  elif angle_diff > np.pi:\n      actions.append(2)  # LEFT\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 8, "scores": {"3": 2.5}}
{"timestamp": "2025-09-06T14:26:24.052758", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  # print(actions)\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T14:28:08.061127", "function_name": "craft", "function_body": "  def move_towards_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Determine the workshop type needed for the goal\n      recipe_ingredients = env.world.cookbook.recipes[goal_index]\n      \n      if \"_key\" in recipe_ingredients:\n          workshop_type = int(recipe_ingredients[\"_key\"])\n      else:\n          raise ValueError(\"Recipe does not specify a workshop.\")\n\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_type])\n\n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return None\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env, goal_index)\n\n  if actions is None:\n      return []  # Return an empty list of actions if no suitable workshop was found\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:28:09.144240", "function_name": "craft", "function_body": "  def move_towards_workshop(env):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n          while not np.array_equal(pos, nearest_target_pos):\n              dx, dy = nearest_target_pos - pos\n\n              # Determine direction to move in\n              if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n                  actions.append(3 if dx > 0 else 2)\n                  pos[0] += 1 if dx > 0 else -1\n              else:  # Then move in y-direction\n                  actions.append(1 if dy > 0 else 0)\n                  pos[1] += 1 if dy > 0 else -1\n\n          # Use the workshop to craft the item\n          actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env)\n\n  return actions", "island_id": 2, "scores": {"3": 5.1}}
{"timestamp": "2025-09-06T14:30:02.856594", "function_name": "craft", "function_body": "  def find_closest_workshop_pos(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      workshop_positions = []\n\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Add the position to the list of possible workshop positions\n          for wp in workshop_pos_list:\n              workshop_positions.append(wp)\n\n      if not workshop_positions:\n          raise ValueError(\"No workshops found\")\n\n      # Calculate distances from current pos to each workshop and return the nearest one\n      distances = np.linalg.norm(workshop_positions - pos, axis=1)\n      closest_workshop_idx = np.argmin(distances)\n      return tuple(workshop_positions[closest_workshop_idx])\n\n  def move_towards_position(env, target_pos):\n      actions = []\n      pos = np.array(env._current_state.pos)\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop position that can craft the desired item\n  closest_workshop_pos = find_closest_workshop_pos(env, goal_index)\n\n  # Move towards the closest workshop and use it to craft the item\n  actions = move_towards_position(env, closest_workshop_pos) + [4]  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T14:30:03.827732", "function_name": "craft", "function_body": "  def find_closest_workshop(env):\n      pos = np.array(env._current_state.pos)\n      closest_distance = float('inf')\n      closest_workshop_pos = None\n      workshop_idx = None\n\n      for idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          for wpos in workshop_pos_list:\n              distance = np.linalg.norm(wpos - pos)\n              if distance < closest_distance:\n                  closest_distance = distance\n                  closest_workshop_pos = wpos\n                  workshop_idx = idx\n\n      return closest_workshop_pos, workshop_idx\n  \n  def move_towards(pos, target):\n      actions = []\n      current_pos = np.array(env._current_state.pos)\n\n      while not np.array_equal(current_pos, pos):\n          dx, dy = pos - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  workshop_pos, workshop_idx = find_closest_workshop(env)\n\n  if workshop_pos is not None:\n      actions = move_towards(workshop_pos)\n      actions.append(4)  # USE to craft the item at the workshop\n  else:\n      raise ValueError(\"No available workshop to craft the desired item\")\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:32:33.005186", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  recipe = cookbook.recipes.get(goal_index)\n\n  # Check if the item can be crafted (i.e., has a recipe)\n  if not recipe:\n      raise ValueError(f\"No crafting recipe found for item: {item}\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  # Ensure that we are checking only those workshops which are in the recipe\n  for ingredient_index, count in recipe.items():\n      if ingredient_index.startswith(\"_\"):  # This is a key indicating a workshop type\n          workshop_type = ingredient_index[1:]  # Remove the \"_\" prefix\n          if workshop_type == \"any\":\n              workshop_indices_to_check = workshop_indices\n          else:\n              workshop_indices_to_check = [env.world.cookbook.index[f\"WORKSHOP{workshop_type}\"]]\n          break\n\n  for workshop_idx in workshop_indices_to_check:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_