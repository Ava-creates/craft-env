-1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T04:27:48.690705", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check if the item has a recipe in the cookbook\n  if goal_index not in cookbook.recipes:\n      raise ValueError(f\"No crafting recipe for {item}\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  # Filter workshops by checking if they have a recipe for the goal_index\n  filtered_workshops = []\n  for workshop_idx in workshop_indices:\n      for output_idx in cookbook.recipes:\n          if goal_index == output_idx:\n              filtered_workshops.append(workshop_idx)\n              break\n\n  if not filtered_workshops:\n      raise ValueError(\"No available workshops can craft the desired item\")\n\n  # Calculate the closest position of any workshop that can craft the desired item\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for workshop_idx in filtered_workshops:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) == 0: continue\n\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_mean = workshop_positions.mean(axis=0)\n\n      distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = workshop_pos_mean\n          min_nearest_distance = distance\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n      pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-09-06T04:30:12.929947", "function_name": "craft", "function_body": "  def move_to_target(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(env, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T04:30:14.005253", "function_name": "craft", "function_body": "  def move_to_target(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n  \n  def find_closest_workshop(env, goal_index):\n      cookbook = env.world.cookbook\n      workshop_indices = env.world.workshop_indices\n      pos = np.array(env._current_state.pos)\n\n      closest_workshop_idx, min_distance = None, float('inf')\n\n      for workshop_idx in workshop_indices:\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n      return closest_workshop_idx\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  closest_workshop_idx = find_closest_workshop(env, goal_index)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  pos = np.array(env._current_state.pos)\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions = move_to_target(env, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T04:32:20.000960", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  min_distance = float('inf')\n  target_workshop_idx = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          mean_pos = workshop_positions.mean(axis=0)\n          current_distance = np.linalg.norm(np.array(env._current_state.pos) - mean_pos, ord=2)\n\n          if current_distance < min_distance:\n              target_workshop_idx = workshop_idx\n              min_distance = current_distance\n\n  if target_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the closest position to move towards among all positions of the target workshop\n  nearest_pos = np.argwhere(env._current_state.grid[:, :, target_workshop_idx]).min(axis=0)\n  pos = np.array(env._current_state.pos)\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_pos):\n      dx, dy = nearest_pos - pos\n\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Ensure the agent faces the correct direction to use the workshop\n  workshop_direction = nearest_pos - pos\n\n  if abs(workshop_direction[0]) > abs(workshop_direction[1]):\n      facing_direction = 3 if workshop_direction[0] > 0 else 2\n  else:\n      facing_direction = 1 if workshop_direction[1] > 0 else 0\n\n  # Adjust direction if necessary\n  current_facing = env._current_state.dir  # Assuming the agent has a direction attribute\n  if facing_direction != current_facing:\n      actions.append((facing_direction - current_facing) % 4)\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": 3.7}}
