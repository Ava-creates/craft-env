se the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T19:07:55.127425", "function_name": "craft", "function_body": "  def find_closest_workshop(pos: np.ndarray, workshop_indices: list[int]) -> tuple[int, np.ndarray]:\n      closest_workshop_idx = None\n      min_distance = float('inf')\n\n      for workshop_idx in workshop_indices:\n          # Calculate positions of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              min_workshop_distance = float('inf')\n              nearest_workshop_pos = None\n\n              for workshop_pos in workshop_pos_list:\n                  distance = np.linalg.norm(pos - workshop_pos, ord=2)\n                  if distance < min_workshop_distance:\n                      nearest_workshop_pos = workshop_pos\n                      min_workshop_distance = distance\n\n              if min_workshop_distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, min_workshop_distance\n\n      return closest_workshop_idx, np.array(nearest_target_pos) if closest_workshop_idx is not None else None\n\n  def move_to_position(start_pos: np.ndarray, target_pos: np.ndarray) -> list[int]:\n      actions = []\n      pos = start_pos.copy()\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = np.sign(dx), np.sign(dy)\n\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if direction[0] == 1 else 2)\n              pos[0] += direction[0]\n          elif abs(dy) > abs(dx):  # Then move in y-direction\n              actions.append(1 if direction[1] == 1 else 0)\n              pos[1] += direction[1]\n\n      return actions\n\n  def rotate_and_move_to_position(start_pos: np.ndarray, target_pos: np.ndarray) -> list[int]:\n      \"\"\"Rotates the agent towards the target position and then moves to it.\"\"\"\n      actions = []\n      pos = start_pos.copy()\n      current_direction = env._current_state.state[\"direction\"]  # Assuming direction is part of state\n      target_angle = np.arctan2(target_pos[1] - pos[1], target_pos[0] - pos[0])\n      current_angle = np.pi / 4 * (current_direction % 8)  # Assuming directions are 0 to 7 in a circle\n\n      angle_diff = (target_angle - current_angle + 2 * np.pi) % (2 * np.pi)\n      if angle_diff < np.pi:\n          while angle_diff > np.pi / 4:  # Turn right\n              actions.append(5)  # TURN_RIGHT\n              current_direction += 1\n              current_angle = np.pi / 4 * (current_direction % 8)\n              angle_diff = (target_angle - current_angle + 2 * np.pi) % (2 * np.pi)\n      else:\n          while angle_diff > 3 * np.pi / 4:  # Turn left\n              actions.append(6)  # TURN_LEFT\n              current_direction -= 1\n              current_angle = np.pi / 4 * (current_direction % 8)\n              angle_diff = (target_angle - current_angle + 2 * np.pi) % (2 * np.pi)\n\n      # Move towards the target position\n      actions.extend(move_to_position(pos, target_pos))\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, nearest_target_pos = find_closest_workshop(np.array(env._current_state.pos), workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Rotate and move to the closest workshop position\n  actions.extend(rotate_and_move_to_position(np.array(env._current_state.pos), nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-06T19:07:56.091064", "function_name": "craft", "function_body": "  def find_closest_workshop(pos: np.ndarray, workshop_indices: list[int]) -> tuple[int, np.ndarray]:\n      closest_workshop_idx = None\n      min_distance = float('inf')\n\n      for workshop_idx in workshop_indices:\n          # Calculate positions of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              min_workshop_distance = float('inf')\n              nearest_workshop_pos = None\n\n              for workshop_pos in workshop_pos_list:\n                  distance = np.linalg.norm(pos - workshop_pos, ord=2)\n                  if distance < min_workshop_distance:\n                      nearest_workshop_pos = workshop_pos\n                      min_workshop_distance = distance\n\n              if min_workshop_distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, min_workshop_distance\n\n      return closest_workshop_idx, np.array(nearest_target_pos) if closest_workshop_idx is not None else None\n\n  def move_to_position(start_pos: np.ndarray, target_pos: np.ndarray) -> list[int]:\n      actions = []\n      pos = start_pos.copy()\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              direction = 3 if dx > 0 else 2\n          else:  # Then move in y-direction\n              direction = 1 if dy > 0 else 0\n\n          actions.append(direction)\n          pos += np.array([1, 0]) if direction == 3 else np.array([-1, 0]) if direction == 2 else \\\n                 np.array([0, 1]) if direction == 1 else np.array([0, -1])\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, nearest_target_pos = find_closest_workshop(np.array(env._current_state.pos), workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  actions.extend(move_to_position(np.array(env._current_state.pos), nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-06T19:08:47.526326", "function_name": "craft", "function_body": "  def find_closest_workshop_index(pos, grid):\n    # Find all workshops in the grid\n    workshops = []\n    for workshop_idx in env.world.workshop_indices:\n        workshop_pos_list = np.argwhere(grid[:, :, workshop_idx])\n        workshops.extend(workshop_pos_list)\n\n    if not workshops:\n        return None\n\n    # Calculate distances to each workshop and find the closest one\n    distances = np.linalg.norm(np.array(workshops) - pos, axis=1)\n    nearest_index = np.argmin(distances)\n    return workshops[nearest_index]\n\n  def move_towards_pos(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  grid = env._current_state.grid\n  nearest_workshop_pos = find_closest_workshop_index(pos, grid)\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshops to craft the item\")\n\n  # Generate actions to move towards the closest workshop\n  actions = move_towards_pos(env, nearest_workshop_pos)\n  \n  # Add USE action to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T19:08:48.659915", "function_name": "craft", "function_body": "  def find_closest_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      \n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n          return nearest_target_pos, workshop_idx\n      \n      raise ValueError(\"No available workshop found\")\n\n  def move_to_position(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  nearest_target_pos, _ = find_closest_workshop(env, goal_index)\n\n  # Move towards the found workshop\n  actions_to_move = move_to_position(env, nearest_target_pos)\n  \n  # Use the workshop to craft the item\n  actions_to_move.append(4)  # USE\n\n  return actions_to_move", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T19:09:50.035659", "function_name": "craft", "function_body": "  def move_to_position(pos_target: np.array, current_pos: np.array) -> list[int]:\n      actions = []\n      while not np.array_equal(current_pos, pos_target):\n          dx, dy = pos_target - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  def get_closest_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n\n      # Find all possible workshops that can craft the desired item\n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n          return nearest_target_pos, workshop_idx\n\n      raise ValueError(\"No suitable workshop found for crafting\")\n\n  def move_towards_workshop(env, goal_index):\n      closest_workshop_pos, _ = get_closest_workshop(env, goal_index)\n      current_pos = np.array(env._current_state.pos)\n\n      actions = move_to_position(closest_workshop_pos, current_pos)\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = m