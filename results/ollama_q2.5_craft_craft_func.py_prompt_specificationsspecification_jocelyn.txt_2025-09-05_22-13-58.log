rient the agent towards the workshop before using it\n  target_direction = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0])\n  current_orientation = env._current_state.orientation  # Assuming the state has an orientation attribute\n  angle_diff = (target_direction - current_orientation) % (2 * np.pi)\n\n  if angle_diff > np.pi:\n      angle_diff -= 2 * np.pi\n\n  # Rotate to face the workshop\n  while abs(angle_diff) > 0.1:  # Small threshold for floating point comparison\n      actions.append(5 if angle_diff < 0 else 6)  # Assuming LEFT_TURN and RIGHT_TURN actions are 5 and 6 respectively\n      current_orientation += np.pi / 4  # Assuming a turn action changes orientation by pi/4 radians\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 6, "scores": {"3": -1}}
