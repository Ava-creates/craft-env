{"timestamp": "2025-09-06T13:40:48.936024", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  min_distance = float('inf')\n  nearest_target_pos = None\n\n  for workshop_idx in workshop_indices:\n      # Calculate the positions of all workshops of this type\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          distances = np.linalg.norm(env._current_state.pos - workshop_positions, axis=1)\n          nearest_pos = workshop_positions[np.argmin(distances)]\n          distance = np.linalg.norm(env._current_state.pos - nearest_pos)\n\n          if distance < min_distance:\n              nearest_target_pos = nearest_pos\n              min_distance = distance\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  pos = np.array(env._current_state.pos)\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T13:40:49.921910", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Check and align the agent's direction to match the required orientation for using the workshop\n  target_direction = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0])\n  current_direction = env._current_state.direction\n  required_direction = (np.pi / 2) * int((target_direction + np.pi / 4) / (np.pi / 2))\n\n  if not np.isclose(current_direction, required_direction):\n      actions.append(int((required_direction - current_direction) % (2 * np.pi) // (np.pi / 2)))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-06T13:43:57.837069", "function_name": "craft", "function_body": "  def move_towards(pos: np.ndarray, target_pos: np.ndarray):\n    \"\"\"Move towards a target position from the current position.\"\"\"\n    path = []\n    \n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      \n      # Prioritize moving in x-direction first\n      if abs(dx) > abs(dy):  \n        action = 3 if dx > 0 else 2  # RIGHT or LEFT\n        path.append(action)\n        pos[0] += 1 if dx > 0 else -1\n      else:\n        action = 1 if dy > 0 else 0  # UP or DOWN\n        path.append(action)\n        pos[1] += 1 if dy > 0 else -1\n\n    return path\n\n  def find_closest_workshop(env, goal_index: int) -> int:\n    \"\"\"Find the closest workshop that can craft the desired item.\"\"\"\n    cookbook = env.world.cookbook\n    workshop_indices = env.world.workshop_indices\n    \n    pos = np.array(env._current_state.pos)\n    closest_workshop_idx, min_distance = None, float('inf')\n\n    for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n        workshop_pos_mean = workshop_pos_list.mean(axis=0)\n        distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n        if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, distance\n\n    return closest_workshop_idx\n  \n  def find_nearest_target_position(env, workshop_idx: int) -> np.ndarray:\n    \"\"\"Find the nearest target position to move towards for a given workshop.\"\"\"\n    pos = np.array(env._current_state.pos)\n    \n    # Calculate the closest position to move towards\n    target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    nearest_target_pos = None\n    min_distance = float('inf')\n    \n    for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      \n      if distance < min_distance:\n        nearest_target_pos = target_pos\n        min_distance = distance\n\n    return nearest_target_pos\n  \n  def check_inventory(env, item: str) -> bool:\n    \"\"\"Check if the required items for crafting are in the inventory.\"\"\"\n    cookbook = env.world.cookbook\n    goal_index = cookbook.index[item]\n    \n    if goal_index is None:\n      raise ValueError(\"Unknown item\")\n    \n    required_items = cookbook.primitives[goal_index]  # Assuming primitives stores required items for each recipe\n    \n    # Check if all required items are in the inventory\n    for primitive, amount in required_items.items():\n      if env._current_state.inventory.get(primitive, 0) < amount:\n        return False\n    \n    return True\n  \n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  # Check if the required items are in the inventory\n  if not check_inventory(env, item):\n    raise ValueError(\"Required items for crafting are missing from the inventory\")\n\n  closest_workshop_idx = find_closest_workshop(env, goal_index)\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = find_nearest_target_position(env, closest_workshop_idx)\n  \n  # Move to the closest workshop position\n  actions = move_towards(np.array(env._current_state.pos), nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
