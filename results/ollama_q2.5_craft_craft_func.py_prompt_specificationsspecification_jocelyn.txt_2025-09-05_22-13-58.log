{"timestamp": "2025-09-06T17:09:03.095490", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda p: np.linalg.norm(pos - p))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n      else:  # If both directions are equal, choose one arbitrarily (e.g., x-direction)\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T17:09:04.060478", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  # Determine which workshop index corresponds to the required ingredients\n  # We assume that the first workshop found is the correct one (improvement needed)\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_towards(env._current_state.pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T17:11:20.490401", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Get all positions of this workshop type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the shortest path to one of the target positions\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* pathfinding algorithm\n  open_list = []\n  closed_set = set()\n  start_node = (tuple(pos), [])\n  \n  # Push the start node onto the heap with a priority of 0 (distance)\n  open_list.append((0, start_node))\n  heapq.heapify(open_list)\n\n  while open_list:\n      current_distance, (current_pos, path) = heapq.heappop(open_list)\n\n      if current_pos in closed_set:\n          continue\n\n      closed_set.add(current_pos)\n\n      # Check if we have reached the target position\n      if np.array_equal(np.array(current_pos), nearest_target_pos):\n          actions.extend(path)\n          break\n      \n      # Get neighbors (up, down, left, right)\n      neighbors = [\n          (current_pos[0] + 1, current_pos[1]),  # Down\n          (current_pos[0] - 1, current_pos[1]),  # Up\n          (current_pos[0], current_pos[1] + 1),  # Right\n          (current_pos[0], current_pos[1] - 1)   # Left\n      ]\n\n      for neighbor in neighbors:\n          if not (0 <= neighbor[0] < env._current_state.grid.shape[0]) or not (0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              continue\n\n          # Calculate the new distance to this neighbor\n          new_distance = current_distance + np.linalg.norm(np.array(current_pos) - np.array(neighbor), ord=2)\n          \n          if neighbor in closed_set:\n              continue\n\n          # Create a new path by appending the direction action\n          direction = 0 if neighbor[1] < current_pos[1] else (1 if neighbor[1] > current_pos[1] else (2 if neighbor[0] < current_pos[0] else 3))\n          new_path = path + [direction]\n\n          heapq.heappush(open_list, (new_distance, (neighbor, new_path)))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-06T17:11:21.472845", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Get all positions of this workshop type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_mean_pos = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest target position\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using a more efficient pathfinding algorithm (A*)\n  start_node = tuple(pos)\n  end_node = tuple(nearest_target_pos)\n\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  def astar(start, goal):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              tentative_g_score = g_score[current] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.put((f_score[neighbor], neighbor))\n\n      return None\n\n  path = astar(start_node, end_node)\n\n  if not path:\n      raise ValueError(\"No path found to the nearest workshop\")\n\n  # Convert path to actions\n  for next_pos in path:\n      dx, dy = np.array(next_pos) - pos\n\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          direction = 1 if dy > 0 else 0\n      \n      actions.append(direction)\n      pos = np.array(next_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-06T17:13:12.788196", "function_name": "craft", "function_body": "  def move_to_target(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T17:13:13.850030", "function_name": "craft", "function_body": "  def move_to_target(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  def find_closest_workshop(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx, min_distance\n\n  closest_workshop_idx, _ = find_closest_workshop(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  def find_nearest_target_pos(workshop_idx):\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos, min_distance = None, float('inf')\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_distance:\n              nearest_target_pos = target_pos\n              min_distance = distance\n      return nearest_target_pos\n\n  nearest_target_pos = find_nearest_target_pos(closest_workshop_idx)\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T17:15:32.633832", "function_name": "craft", "function_body": "  def move_to_target(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          elif abs(dy) > abs(dx):  # Prioritize moving in y-direction first\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n          else:  # If dx == dy, decide based on the direction with a small random perturbation\n              random_direction = np.random.choice([0, 2])  # Randomly choose to move in x or y direction\n              actions.append(3 if random_direction == 0 and dx > 0 else (2 if random_direction == 0 else (1 if dy > 0 else 0)))\n              current_pos[0] += 1 if random_direction == 0 and dx > 0 else (-1 if random_direction == 0 else 0)\n              current_pos[1] += 1 if random_direction == 2 and dy > 0 else (-1 if random_direction == 2 else 0)\n      return actions\n\n  def find_closest_workshop(current_pos, workshop_indices):\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      \n      for workshop_idx in workshop_indices:\n          # Find positions of all workshops of this type\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_positions) == 0:  # No workshops found, skip to the next type\n              continue\n\n          # Calculate mean position for each workshop type and find the closest one\n          workshop_pos_mean = workshop_positions.mean(axis=0)\n          distance = np.linalg.norm(current_pos - workshop_pos_mean, ord=2)\n          \n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop_idx = workshop_idx\n      \n      return closest_workshop_idx\n\n  def find_nearest_target(current_pos, workshop_idx):\n      # Find positions of all workshops of the type closest_workshop_idx\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(target_positions) == 0:\n          raise ValueError(\"No positions found for this workshop type\")\n      \n      # Calculate distances to each position and find nearest one\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(current_pos - target, ord=2) for target in target_positions])]\n      \n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx = find_closest_workshop(np.array(env._current_state.pos), workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = find_nearest_target(np.array(env._current_state.pos), closest_workshop_idx)\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(np.array(env._current_state.pos), nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T17:15:33.604044", "function_name": "craft", "function_body": "  def move_to_target(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  def find_closest_workshop(current_pos, workshop_indices):\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      \n      for workshop_idx in workshop_indices:\n          # Find positions of all workshops of this type\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_positions) == 0:  # No workshops found, skip to the next type\n              continue\n\n          # Calculate mean position for each workshop type and find the closest one\n          workshop_pos_mean = workshop_positions.mean(axis=0)\n          distance = np.linalg.norm(current_pos - workshop_pos_mean, ord=2)\n          \n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop_idx = workshop_idx\n      \n      return closest_workshop_idx\n\n  def find_nearest_target(current_pos, workshop_idx):\n      # Find positions of all workshops of the type closest_workshop_idx\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(target_positions) == 0:\n          raise ValueError(\"No positions found for this workshop type\")\n      \n      # Calculate distances to each position and find nearest one\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(current_pos - target, ord=2) for target in target_positions])]\n      \n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  current_state = env._current_state\n  actions = []\n\n  # Determine the recipe for the item and identify required workshops\n  recipe = cookbook.recipes[goal_index]\n  required_workshops = set()\n  \n  for ingredient, quantity in recipe.items():\n      if ingredient not in cookbook.primitives:\n          required_workshops.add(cookbook.recipes[ingredient].workshop)\n      else:\n          required_workshops.add(None)  # Primitives don't require a workshop\n\n  # For simplicity, we'll just find the closest workshop for now\n  closest_workshop_idx = find_closest_workshop(np.array(current_state.pos), workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = find_nearest_target(np.array(current_state.pos), closest_workshop_idx)\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(np.array(current_state.pos), nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T17:17:00.491952", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      elif dy < 0:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      pos += (direction == 3) - (direction == 2), (direction == 1) - (direction == 0)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T17:17:01.559715", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(pos - target_positions, axis=1))]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T17:18:15.361423", "function_name": "craft", "function_body": "  def move_to_position(pos_target):\n      pos_current = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos_current, pos_target):\n          dx, dy = pos_target - pos_current\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos_current[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos_current[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the workshop indices that are needed for this recipe\n  required_workshop_indices = set()\n  for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if output_idx == goal_index:\n          ingredient_indices = [i for i in ingredients if isinstance(i, int)]\n          break\n\n  for ingredient in ingredient_indices:\n      primitives_needed = cookbook.primitives_for(ingredient)\n      required_workshop_indices.update(primitives_needed.keys())\n\n  # Move to each workshop and use it\n  actions = []\n  for workshop_idx in env.world.workshop_indices:\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          continue\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - env._current_state.pos, axis=1))]\n\n      actions.extend(move_to_position(nearest_target_pos))\n      actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-06T17:18:16.472961", "function_name": "craft", "function_body": "  def find_nearest_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      \n      # Determine the required workshop type from the recipe\n      for output_idx, ingredients in env.world.cookbook.recipes.items():\n          if output_idx == goal_index:\n              ingredient_indices = [i for i in ingredients if isinstance(i, int)]\n              break\n\n      closest_workshop_pos = None\n      min_distance = float('inf')\n      \n      # Find all workshops that can craft this item (assuming any workshop can)\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n          distance = np.linalg.norm(nearest_target_pos - pos)\n          \n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop_pos = nearest_target_pos\n\n      return closest_workshop_pos\n\n\n  def move_to_position(env, target_pos):\n      actions = []\n      pos = np.array(env._current_state.pos)\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  nearest_workshop_pos = find_nearest_workshop(env, goal_index)\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshops to craft the item.\")\n\n  # Move towards the nearest workshop\n  actions_to_move = move_to_position(env, nearest_workshop_pos)\n  \n  # Use the workshop to craft the item\n  actions_to_move.append(4)  # USE\n\n  return actions_to_move", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T17:19:18.527906", "function_name": "craft", "function_body": "  def get_recipe_workshops(cookbook, goal_index):\n      # This function should find which workshops are involved in crafting the desired item\n      for output_idx, recipe in cookbook.recipes.items():\n          if output_idx == goal_index:\n              return set(workshop_idx for workshop_idx in env.world.workshop_indices \n                          if any(k in str(cookbook.index.get(i)) for i, k in recipe.items() if isinstance(i, int)))\n      return set()\n\n  def move_towards_workshop(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find relevant workshops for crafting the desired item\n  recipe_workshops = get_recipe_workshops(cookbook, goal_index)\n\n  closest_target_pos = None\n  min_distance = float('inf')\n  \n  for workshop_idx in recipe_workshops:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          continue\n\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - np.array(env._current_state.pos), axis=1))]\n      distance = np.linalg.norm(nearest_target_pos - np.array(env._current_state.pos))\n\n      if distance < min_distance:\n          min_distance = distance\n          closest_target_pos = nearest_target_pos\n\n  if closest_target_pos is not None:\n      actions = move_towards_workshop(env, closest_target_pos)\n  else:\n      raise ValueError(\"No workshop found that can craft the item\")\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T17:19:19.583635", "function_name": "craft", "function_body": "  def get_closest_pos(pos, target_positions):\n      return target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n  def move_towards_workshop(env):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find the closest workshop that can craft the desired item\n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          nearest_workshop_pos = get_closest_pos(pos, workshop_pos_list)\n          while not np.array_equal(pos, nearest_workshop_pos):\n              dx, dy = nearest_workshop_pos - pos\n              \n              # Determine direction to move in\n              actions.append(3 if dx > 0 else (2 if dx < 0 else (1 if dy > 0 else 0)))\n              pos[0] += 1 if dx > 0 else (-1 if dx < 0 else 0)\n              pos[1] += 1 if dy > 0 else (-1 if dy < 0 else 0)\n\n          # Use the workshop to craft the item\n          actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env)\n\n  return actions", "island_id": 2, "scores": {"3": 0.9}}
