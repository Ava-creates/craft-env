os = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      actions.extend(move_to_position(nearest_target_pos, pos))\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_type_idx = find_workshop_for_recipe(env, goal_index)\n  \n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env, workshop_type_idx)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
