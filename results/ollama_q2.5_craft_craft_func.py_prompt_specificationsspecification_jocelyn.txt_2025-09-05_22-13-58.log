{"timestamp": "2025-09-06T05:49:08.526501", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Determine the nearest workshop from the current position\n  pos = np.array(env._current_state.pos)\n\n  closest_workshop_pos, min_distance = None, float('inf')\n  for workshop_idx in workshop_indices:\n      # Get all positions of this type of workshop\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          nearest_workshop_pos = min(workshop_positions, key=lambda tp: np.linalg.norm(pos - tp))\n          distance = np.linalg.norm(pos - nearest_workshop_pos)\n          \n          if distance < min_distance:\n              closest_workshop_pos, min_distance = nearest_workshop_pos, distance\n\n  if closest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the actions needed to move towards the nearest workshop\n  while not np.array_equal(pos, closest_workshop_pos):\n      dx, dy = closest_workshop_pos - pos\n      \n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction if not already at the same row\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T05:51:16.490983", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest position among all workshops that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_target_pos, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = [np.linalg.norm(pos - tp, ord=2) for tp in workshop_pos_list]\n          nearest_tp = workshop_pos_list[np.argmin(distances)]\n          distance_to_nearest_tp = min(distances)\n          if distance_to_nearest_tp < min_distance:\n              nearest_target_pos, min_distance = nearest_tp, distance_to_nearest_tp\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the direction to move towards\n  dx, dy = nearest_target_pos - pos\n\n  # Move in a diagonal if possible, otherwise move straight\n  while not np.array_equal(pos, nearest_target_pos):\n      if dx != 0 and dy != 0:\n          actions.append(3 + (dx > 0) * 1 + (dy < 0) * 2)\n          pos += [np.sign(dx), np.sign(dy)]\n      elif dx != 0:\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += np.sign(dx)\n      else:  # dy != 0\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += np.sign(dy)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T05:51:17.618291", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_workshop_pos, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = [np.linalg.norm(pos - tp, ord=2) for tp in workshop_pos_list]\n          nearest_tp = workshop_pos_list[np.argmin(distances)]\n          distance_to_nearest_tp = min(distances)\n          if distance_to_nearest_tp < min_distance:\n              nearest_workshop_pos, min_distance = nearest_tp, distance_to_nearest_tp\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_workshop_pos):\n      dx, dy = nearest_workshop_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T05:53:54.475200", "function_name": "craft", "function_body": "  def move_to_target(pos, target_pos):\n      direction_mapping = {\n          (0, -1): 0,  # UP\n          (0, 1): 1,   # DOWN\n          (-1, 0): 2,  # LEFT\n          (1, 0): 3    # RIGHT\n      }\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              direction = (1, 0) if dx > 0 else (-1, 0)\n          else:  # Then move in y-direction\n              direction = (0, 1) if dy > 0 else (0, -1)\n\n          actions.append(direction_mapping[direction])\n          pos += np.array(direction)\n\n      return actions\n\n  def find_closest_workshop(env, goal_index):\n      cookbook = env.world.cookbook\n      workshop_indices = env.world.workshop_indices\n      \n      closest_workshop_idx, min_distance = None, float('inf')\n      current_pos = np.array(env._current_state.pos)\n      \n      for workshop_idx in workshop_indices:\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(current_pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      \n      return closest_workshop_idx\n\n  def find_nearest_target_position(env, workshop_idx):\n      current_pos = np.array(env._current_state.pos)\n      \n      # Calculate the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n      \n      for target_pos in target_positions:\n          distance = np.linalg.norm(current_pos - target_pos, ord=2)\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n      \n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_idx = find_closest_workshop(env, goal_index)\n  \n  if workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = find_nearest_target_position(env, workshop_idx)\n\n  # Move to the closest workshop position\n  actions = move_to_target(np.array(env._current_state.pos), nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T05:53:55.453496", "function_name": "craft", "function_body": "  def get_action(dx, dy):\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = (1, 0) if dx > 0 else (-1, 0)\n      else:  # Then move in y-direction\n          direction = (0, 1) if dy > 0 else (0, -1)\n\n      return {\n          (0, -1): 0,  # UP\n          (0, 1): 1,   # DOWN\n          (-1, 0): 2,  # LEFT\n          (1, 0): 3    # RIGHT\n      }[direction]\n\n  def move_to_target(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          action = get_action(dx, dy)\n          actions.append(action)\n          pos += np.array(direction_mapping[action])\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  current_pos = np.array(env._current_state.pos)\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(current_pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(current_pos - x, ord=2))\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(current_pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T05:56:26.308301", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for recipe in cookbook.recipes.values():\n      if goal_index in recipe:\n          for ingredient, count in recipe.items():\n              if ingredient != \"_key\":\n                  workshop_idx = env.world.cookbook.index.get(cookbook.index.reverse_contents[ingredient])\n                  if workshop_idx in workshop_indices:\n                      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n                      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n                          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n                          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n                          if distance < min_distance:\n                              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-06T05:56:27.401290", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  current_pos = np.array(env._current_state.pos)\n\n  # Calculate distances to all workshops and choose the closest one\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) == 0:  # Skip if no workshops of this type are present\n          continue\n      \n      workshop_mean_pos = workshop_positions.mean(axis=0)\n      distance_to_workshop = np.linalg.norm(current_pos - workshop_mean_pos, ord=2)\n\n      if distance_to_workshop < min_distance:\n          closest_workshop_idx = workshop_idx\n          min_distance = distance_to_workshop\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest specific position of the closest workshop type\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in np.argwhere(env._current_state.grid[:, :, closest_workshop_idx]):\n      distance_to_target = np.linalg.norm(current_pos - target_pos, ord=2)\n      if distance_to_target < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance_to_target\n\n  # Move to the nearest workshop position\n  while not np.array_equal(current_pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - current_pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          current_pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          current_pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
