se the workshop to craft the item\n  actions.append(4)  # USE\n  \n  # Check if all ingredients are available in inventory\n  recipe = cookbook.recipes.get(goal_index, {})\n  for ingredient_idx, count in recipe.items():\n      if ingredient_idx == \"_key\":\n          continue  # Skip the key which holds metadata\n      if env._current_state.inventory[ingredient_idx] < count:\n          raise ValueError(f\"Insufficient ingredients: missing {cookbook.index.get(ingredient_idx)}\")\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
