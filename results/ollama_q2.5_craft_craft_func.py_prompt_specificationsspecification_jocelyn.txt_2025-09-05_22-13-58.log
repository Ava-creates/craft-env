{"timestamp": "2025-09-05T23:57:24.104217", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item.\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Calculate the path to the closest workshop position using A* algorithm.\n  def heuristic(a, b):\n      return np.sum(np.abs(np.array(a) - np.array(b)))\n\n  open_set = collections.PriorityQueue()\n  came_from = {}\n  g_score = {tuple(pos): 0}\n  f_score = {tuple(pos): heuristic(tuple(pos), tuple(nearest_target_pos))}\n\n  open_set.put((f_score[tuple(pos)], tuple(pos)))\n\n  while not open_set.empty():\n      _, current = open_set.get()\n\n      if np.array_equal(np.array(current), nearest_target_pos):\n          path = []\n          while current in came_from:\n              path.append(tuple(current))\n              current = came_from[current]\n          path.reverse()\n          break\n\n      for neighbor in [(current[0] + 1, current[1]), (current[0] - 1, current[1]), (current[0], current[1] + 1), (current[0], current[1] - 1)]:\n          tentative_g_score = g_score[tuple(current)] + 1\n\n          if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n              came_from[tuple(neighbor)] = tuple(current)\n              g_score[tuple(neighbor)] = tentative_g_score\n              f_score[tuple(neighbor)] = tentative_g_score + heuristic(tuple(neighbor), tuple(nearest_target_pos))\n              open_set.put((f_score[tuple(neighbor)], tuple(neighbor)))\n\n  if 'path' not in locals():\n      raise ValueError(\"No valid path to workshop found\")\n\n  # Convert the path into actions\n  for i in range(len(path) - 1):\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx > 0:\n          actions.append(3)\n      elif dx < 0:\n          actions.append(2)\n      elif dy > 0:\n          actions.append(1)\n      elif dy < 0:\n          actions.append(0)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-06T00:00:15.459381", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      dx, dy = target_pos - pos\n      actions = []\n      \n      # Prioritize moving in the direction with larger distance first\n      if abs(dx) > abs(dy):  # Prioritize x-direction\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n      return actions, pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      new_actions, pos = move_towards(pos, nearest_target_pos)\n      actions.extend(new_actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T00:00:16.458173", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Calculate the path to the closest workshop position using A* algorithm\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  def a_star(start, goal, grid):\n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      came_from = {}\n      g_score = {tuple(start): 0}\n      f_score = {tuple(start): heuristic(start, goal)}\n\n      while open_set:\n          _, current = heapq.heappop(open_set)\n\n          if np.array_equal(np.array(current), np.array(goal)):\n              path = []\n              while tuple(current) in came_from:\n                  path.append(tuple(current))\n                  current = came_from[tuple(current)]\n              path.append(start)\n              return path[::-1]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = np.array((current[0] + dx, current[1] + dy))\n              if grid[neighbor[0], neighbor[1]] == 0:  # Assuming 0 is the traversable path\n                  tentative_g_score = g_score[tuple(current)] + 1\n\n                  if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n                      came_from[tuple(neighbor)] = current\n                      g_score[tuple(neighbor)] = tentative_g_score\n                      f_score[tuple(neighbor)] = tentative_g_score + heuristic(neighbor, goal)\n                      heapq.heappush(open_set, (f_score[tuple(neighbor)], tuple(neighbor)))\n\n      return None\n\n  path_to_workshop = a_star(tuple(pos), nearest_target_pos, env._current_state.grid)\n\n  if path_to_workshop is None:\n      raise ValueError(\"No valid path to workshop found\")\n\n  # Convert the path into actions\n  for i in range(len(path_to_workshop) - 1):\n      current, next_step = path_to_workshop[i], path_to_workshop[i + 1]\n      dx, dy = np.array(next_step) - np.array(current)\n\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T00:07:41.404667", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n      actions = []\n      dx, dy = target_pos - current_pos\n\n      while not np.array_equal(current_pos, target_pos):\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              action = 3 if dx > 0 else 2\n              pos_change = (1, 0) if dx > 0 else (-1, 0)\n          elif abs(dx) < abs(dy):  # Then move in y-direction\n              action = 1 if dy > 0 else 0\n              pos_change = (0, 1) if dy > 0 else (0, -1)\n          else:  # If equal, prioritize moving in the x-direction\n              action = 3 if dx > 0 else 2\n              pos_change = (1, 0) if dx > 0 else (-1, 0)\n\n          actions.append(action)\n          current_pos += pos_change\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_to_position(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-06T00:07:42.526128", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  # Calculate distances to all workshops in the grid and find the nearest one.\n  def calculate_distance(target_positions, current_pos):\n      return np.linalg.norm(target_positions - current_pos, axis=1).min()\n\n  workshop_distances = {}\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_distances[workshop_idx] = calculate_distance(workshop_pos_list, pos)\n\n  if not workshop_distances:\n      raise ValueError(\"No available workshop found\")\n\n  closest_workshop_idx = min(workshop_distances, key=workshop_distances.get)\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  \n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n \n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in. Prioritize moving in the direction with larger absolute difference first.\n      if abs(dx) > abs(dy):  \n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):  \n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n      else:  \n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 4.7}}
