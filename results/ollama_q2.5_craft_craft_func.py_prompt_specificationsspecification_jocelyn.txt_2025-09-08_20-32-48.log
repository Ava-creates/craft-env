ambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T09:56:29.551835", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if abs(dx) >= abs(dy):\n          return 3 if dx > 0 else 2\n      else:\n          return 1 if dy > 0 else 0\n\n  def find_closest_workshop(goal_index, workshop_indices, current_pos) -> int:\n      \"\"\"Find the closest available workshop for crafting.\"\"\"\n      min_distance = float('inf')\n      closest_workshop_idx = None\n\n      for workshop_idx in workshop_indices:\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_positions) == 0:  # No workshops of this type\n              continue\n\n          distances = np.linalg.norm(current_pos - workshop_positions, axis=1)\n          nearest_workshop_pos = workshop_positions[np.argmin(distances)]\n\n          distance_to_nearest_workshop = np.linalg.norm(current_pos - nearest_workshop_pos)\n          if distance_to_nearest_workshop < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance_to_nearest_workshop\n\n      if closest_workshop_idx is None:\n          raise ValueError(\"No available workshop found\")\n\n      return closest_workshop_idx, nearest_workshop_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index not in cookbook.recipes:\n      raise ValueError(f\"No recipe for {item}\")\n\n  workshop_indices = env.world.workshop_indices\n  current_pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, nearest_workshop_pos = find_closest_workshop(goal_index, workshop_indices, current_pos)\n\n  actions = []\n  pos = current_pos\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_workshop_pos):\n      dx, dy = nearest_workshop_pos - pos\n      direction = calculate_direction(dx, dy)\n      actions.append(direction)\n      pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T09:56:30.520436", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if abs(dx) >= abs(dy):\n          return 3 if dx > 0 else 2\n      else:\n          return 1 if dy > 0 else 0\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check if the item can be crafted (i.e., has a recipe)\n  if goal_index not in cookbook.recipes:\n      raise ValueError(f\"No recipe for {item}\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find all workshops that have the desired item in their recipes\n  valid_workshops = []\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          valid_workshops.append((workshop_idx, workshop_pos_list))\n\n  if not valid_workshops:\n      raise ValueError(\"No available workshops found that can craft the desired item\")\n\n  # Filter workshops to find those that have the required ingredients and can craft the goal item\n  available_workshops = []\n  for workshop_idx, workshop_positions in valid_workshops:\n      recipe = cookbook.recipes[goal_index]\n      if all(ingredient in env._current_state.inventory for ingredient in recipe):\n          available_workshops.append((workshop_idx, workshop_positions))\n\n  if not available_workshops:\n      raise ValueError(\"No workshops found with the required ingredients to craft the desired item\")\n\n  # Find the closest valid workshop\n  closest_workshop_idx, min_distance = None, float('inf')\n  for workshop_idx, workshop_positions in available_workshops:\n      workshop_pos_mean = workshop_positions.mean(axis=0)\n      distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n      if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, workshop_positions\n\n  # Calculate the closest position to move towards\n  target_positions = closest_workshop_idx[1]\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = calculate_direction(dx, dy)\n      actions.append(direction)\n      pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T09:57:42.933712", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  def move_towards(env, target_pos):\n      actions = []\n      pos = np.array(env._current_state.pos)\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  actions += move_towards(env, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T09:57:43.896439", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  def move_towards(env, target_pos):\n      actions = []\n      pos = np.array(env._current_state.pos)\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Check if any workshop can craft the desired item\n  available_workshops = [i for i in workshop_indices if i in cookbook.recipes[goal_index].get('workshop', [])]\n\n  if not available_workshops:\n      raise ValueError(\"No suitable workshop found\")\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in available_workshops:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  actions += move_towards(env, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-09T09:58:55.462318", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  def calculate_actions_to_target(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          current_pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  def find_closest_workshop_and_target(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      nearest_target_pos = None\n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              distances = np.linalg.norm(pos - workshop_pos_list, axis=1)\n              nearest_workshop_pos = workshop_pos_list[np.argmin(distances)]\n              distance = np.linalg.norm(nearest_workshop_pos - pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n                  nearest_target_pos = nearest_workshop_pos\n      return closest_workshop_idx, nearest_target_pos\n\n  def move_to_workshop_and_use(pos):\n      closest_workshop_idx, nearest_target_pos = find_closest_workshop_and_target(pos)\n      if closest_workshop_idx is None:\n          raise ValueError(\"No available workshop found\")\n      actions = calculate_actions_to_target(pos, nearest_target_pos)\n      actions.append(4)  # USE\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  pos = np.array(env._current_state.pos)\n\n  actions = move_to_workshop_and_use(pos)\n  return actions", "island_id": 1, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T09:58:56.522037", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  def calculate_actions_to_target(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          current_pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  def find_closest_workshop(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              distances = np.linalg.norm(pos - workshop_pos_list, axis=1)\n              nearest_workshop_pos = workshop_pos_list[np.argmin(distances)]\n              distance = np.linalg.norm(nearest_workshop_pos - pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  def find_target_position(workshop_idx):\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(np.array(env._current_state.pos) - tp, ord=2) for tp in target_positions])]\n      return nearest_target_pos\n\n  def move_to_workshop_and_use(pos, closest_workshop_idx):\n      nearest_target_pos = find_target_position(closest_workshop_idx)\n      actions = calculate_actions_to_target(pos, nearest_target_pos)\n      actions.append(4)  # USE\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  pos = np.array(env._current_state.pos)\n\n  closest_workshop_idx = find_closest_workshop(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  actions = move_to_workshop_and_use(pos, closest_workshop_idx)\n  return actions", "island_id": 1, "scores": {"3": 5.2}}
