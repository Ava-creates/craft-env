arget_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  pos = move_towards(pos, nearest_target_pos, actions)\n\n  # Use the workshop to craft the item only if it's not already there\n  if not env._current_state.grid[nearest_target_pos[0], nearest_target_pos[1], goal_index]:  # Check if item is already crafted at the workshop\n      actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 5.2}}
