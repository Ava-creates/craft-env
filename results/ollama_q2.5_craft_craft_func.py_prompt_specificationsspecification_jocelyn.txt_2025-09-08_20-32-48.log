{"timestamp": "2025-09-09T08:15:54.277012", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  \n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = heuristic(pos, tuple(workshop_pos_mean))\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, tuple(target_pos))\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 9, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T08:15:55.335899", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = heuristic(pos, tuple(workshop_pos_mean))\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, tuple(target_pos))\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T08:16:59.979202", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  def move_to_target(pos, target_pos) -> list[int]:\n      \"\"\"Move the agent to the target position.\"\"\"\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T08:17:01.039995", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if abs(dx) >= abs(dy):\n          return 3 if dx > 0 else 2\n      else:\n          return 1 if dy > 0 else 0\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = calculate_direction(dx, dy)\n      actions.append(direction)\n      pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T08:18:08.557493", "function_name": "craft", "function_body": "  def calculate_movement_actions(start, target):\n      dx = target[0] - start[0]\n      dy = target[1] - start[1]\n\n      actions = []\n      \n      # Determine direction to move in, prioritize x-direction first\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # DOWN\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # UP\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          for wp in workshop_positions:\n              distance = np.linalg.norm(pos - wp, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = wp\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  actions.extend(calculate_movement_actions(pos, target_workshop_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T08:18:09.621970", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          for wp in workshop_positions:\n              distance = np.linalg.norm(pos - wp, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = wp\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Function to calculate the direction and move towards the target position using A* algorithm for better pathfinding\n  def a_star(start, goal):\n      neighbors = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {tuple(start): 0}\n      f_score = {tuple(start): np.linalg.norm(np.array(goal) - start)}\n\n      while not open_set.empty():\n          current = tuple(open_set.get()[1])\n\n          if current == tuple(goal):\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n\n          for dx, dy in neighbors:\n              neighbor = (current[0] + dx, current[1] + dy)\n\n              # Ensure the neighbor is within grid bounds and walkable\n              if 0 <= neighbor[0] < env._current_state.grid.shape[0] and \\\n                 0 <= neighbor[1] < env._current_state.grid.shape[1] and \\\n                 env._current_state.grid[neighbor[0], neighbor[1], :].sum() == 0:\n                  tentative_g_score = g_score[tuple(current)] + 1\n\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + np.linalg.norm(np.array(goal) - np.array(neighbor))\n                      open_set.put((f_score[neighbor], neighbor))\n\n      return None\n\n  path = a_star(tuple(pos), tuple(target_workshop_pos))\n\n  if not path:\n      raise ValueError(\"No valid path to workshop found\")\n\n  # Convert path into actions\n  for next_step in path[1:]:  # Skip the starting position which is current position\n      dx, dy = next_step[0] - pos[0], next_step[1] - pos[1]\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in, prioritize x-direction first\n      if dir_x is not None:\n          actions.append(dir_x)\n      elif dir_y is not None:\n          actions.append(dir_y)\n\n      pos[0], pos[1] = next_step\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-09T08:19:52.312414", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  def calculate_path(start: np.array, target: np.array) -> list[int]:\n      \"\"\"Calculate a path from start to target using BFS.\"\"\"\n      directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n      queue = collections.deque([(start.tolist(), [])])\n      visited = set()\n\n      while queue:\n          current_pos, path = queue.popleft()\n          if tuple(current_pos) in visited:\n              continue\n          visited.add(tuple(current_pos))\n\n          if np.array_equal(current_pos, target):\n              return path\n\n          for dx, dy in directions:\n              new_pos = np.array(current_pos) + [dx, dy]\n              if 0 <= new_pos[0] < env._current_state.grid.shape[0] and 0 <= new_pos[1] < env._current_state.grid.shape[1]:\n                  direction = calculate_direction(dx, dy)\n                  queue.append((new_pos.tolist(), path + [direction]))\n\n      return []\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          nearest_target_pos = workshop_pos_list[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in workshop_pos_list])]\n          distance = np.linalg.norm(pos - nearest_target_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Check if the recipe requires any specific workshop\n  recipe = cookbook.recipes[goal_index]\n  required_workshop_indices = set()\n  for ingredient in recipe['ingredients']:\n      if 'workshop' in ingredient:\n          required_workshop_indices.add(cookbook.index[ingredient['workshop']])\n\n  if len(required_workshop_indices) > 0 and closest_workshop_idx not in required_workshop_indices:\n      # If the closest workshop is not suitable, find another one\n      for workshop_idx in required_workshop_indices:\n          if workshop_idx in workshop_indices:\n              workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n              if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n                  nearest_target_pos = workshop_pos_list[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in workshop_pos_list])]\n                  distance = np.linalg.norm(pos - nearest_target_pos, ord=2)\n                  if distance < min_distance:\n                      closest_workshop_idx, min_distance = workshop_idx, distance\n\n      if closest_workshop_idx is None or closest_workshop_idx not in required_workshop_indices:\n          raise ValueError(\"No suitable workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Calculate the path to the closest workshop position\n  actions.extend(calculate_path(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-09T08:19:53.365304", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  def calculate_path(start: np.array, target: np.array) -> list[int]:\n      \"\"\"Calculate a path from start to target using BFS.\"\"\"\n      directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n      queue = collections.deque([(start.tolist(), [])])\n      visited = set()\n\n      while queue:\n          current_pos, path = queue.popleft()\n          if tuple(current_pos) in visited:\n              continue\n          visited.add(tuple(current_pos))\n\n          if np.array_equal(current_pos, target):\n              return path\n\n          for dx, dy in directions:\n              new_pos = np.array(current_pos) + [dx, dy]\n              if 0 <= new_pos[0] < env._current_state.grid.shape[0] and 0 <= new_pos[1] < env._current_state.grid.shape[1]:\n                  direction = calculate_direction(dx, dy)\n                  queue.append((new_pos.tolist(), path + [direction]))\n\n      return []\n\n  def get_workshops_for_item(cookbook, goal_index):\n      \"\"\"Get all workshops that can craft the desired item.\"\"\"\n      for workshop_idx in range(len(env.world.workshop_indices)):\n          recipe = cookbook.recipes.get(workshop_idx)\n          if recipe and goal_index in recipe:\n              yield workshop_idx\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find workshops that can craft the desired item\n  available_workshops = list(get_workshops_for_item(cookbook, goal_index))\n\n  if not available_workshops:\n      raise ValueError(\"No workshop can craft this item\")\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in available_workshops:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          nearest_target_pos = workshop_pos_list[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in workshop_pos_list])]\n          distance = np.linalg.norm(pos - nearest_target_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Calculate the path to the closest workshop position\n  actions.extend(calculate_path(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-09T08:21:31.472369", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Determine the workshop(s) that can craft the desired item based on the recipe\n  for recipe in cookbook.recipes.values():\n      if recipe.output == goal_index:\n          required_workshop = recipe.workshop\n          break\n  else:\n      raise ValueError(f\"No workshop found to craft {item}\")\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop of the required type\n  target_positions = np.argwhere(env._current_state.grid[:, :, required_workshop])\n  if len(target_positions) == 0:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, tuple(target_pos))\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-09T08:21:32.612152", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = heuristic(pos, tuple(workshop_pos_mean))\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, tuple(target_pos))\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T08:22:41.102882", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  def move_to_target(current_pos, target_pos) -> list[int]:\n      \"\"\"Generate actions to move from current position to target position.\"\"\"\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          current_pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check if the item can be crafted (i.e., has a recipe)\n  if goal_index not in cookbook.recipes:\n      raise ValueError(f\"No recipe for {item}\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position and use it\n  actions.extend(move_to_target(pos, nearest_target_pos))\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 5.2}}
