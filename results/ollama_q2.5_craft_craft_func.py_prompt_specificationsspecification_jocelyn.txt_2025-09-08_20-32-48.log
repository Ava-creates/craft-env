irection + 1) % 4)  # Turn right\n                  current_direction = (current_direction + 1) % 4\n              return\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      adjust_direction(dx, dy)\n\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 4, "scores": {"3": 1.7}}
{"timestamp": "2025-09-08T22:16:55.416395", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Determine the closest position among all workshops that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_target_pos = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_distance:\n                  nearest_target_pos = target_pos\n                  min_distance = distance\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-08T22:16:56.487820", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  target_workshops = []\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          target_workshops.append((workshop_idx, workshop_pos_list))\n\n  if not target_workshops:\n      raise ValueError(\"No available workshop found\")\n\n  pos = np.array(env._current_state.pos)\n\n  # Determine the closest position among all workshops by considering individual positions\n  nearest_target_pos = None\n  min_distance = float('inf')\n  for _, workshop_pos_list in target_workshops:\n      for target_pos in workshop_pos_list:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_distance:\n              nearest_target_pos = target_pos\n              min_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-08T22:17:59.766215", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  \n  # Find the closest available position for a workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  closest_target_pos, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  \n          continue\n\n      # Find the nearest position to move towards among the workshops\n      nearest_target_pos = min(workshop_pos_list, key=lambda p: np.linalg.norm(pos - p))\n      \n      # Update closest target position based on nearest position found\n      distance = np.linalg.norm(pos - nearest_target_pos)\n      if distance < min_distance:\n          closest_target_pos = nearest_target_pos\n          min_distance = distance\n\n  if closest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest target position\n  while not np.array_equal(pos, closest_target_pos):\n      dx, dy = closest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-08T22:18:00.735953", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  \n          continue\n\n      # Find the closest position to move towards\n      nearest_target_pos = min(workshop_pos_list, key=lambda p: np.linalg.norm(pos - p, ord=2))\n\n      # Update closest workshop based on nearest position found\n      distance = np.linalg.norm(pos - nearest_target_pos, ord=2)\n      if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, nearest_target_pos\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  target_position = closest_workshop_idx[1]\n  \n  while not np.array_equal(pos, target_position):\n      dx, dy = target_position - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-08T22:18:46.827659", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          for wp in workshop_positions:\n              distance = np.linalg.norm(pos - wp, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = wp\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position using A* search for better pathfinding\n  path = a_star(pos, target_workshop_pos, env._current_state.grid)\n  actions.extend(path_to_actions(path))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-08T22:18:47.900875", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          for wp in workshop_positions:\n              distance = np.linalg.norm(pos - wp, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = wp\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, target_workshop_pos):\n      dx, dy = target_workshop_pos - pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in, prioritize x-direction first\n      if dir_x is not None:\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif dir_y is not None:\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": 5.2}}
{"timestamp": "2025-09-08T22:19:46.043598", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  target_workshops = []\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          target_workshops.extend([(workshop_idx, pos) for pos in workshop_pos_list])\n\n  if not target_workshops:\n      raise ValueError(\"No available workshop found\")\n\n  pos = np.array(env._current_state.pos)\n\n  # Determine the closest position among all workshops\n  nearest_target_pos = min(target_workshops, key=lambda x: np.linalg.norm(pos - np.array(x[1]), ord=2))[1]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-08T22:19:47.054242", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  target_workshops = []\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          target_workshops.append((workshop_idx, workshop_pos_list))\n\n  if not target_workshops:\n      raise ValueError(\"No available workshop found\")\n\n  pos = np.array(env._current_state.pos)\n\n  # Determine the closest position among all workshops\n  nearest_target_pos = None\n  min_distance = float('inf')\n  for workshop_idx, workshop_pos_list in target_workshops:\n      for workshop_pos in workshop_pos_list:\n          distance = np.linalg.norm(pos - workshop_pos, ord=2)\n          if distance < min_distance:\n              nearest_target_pos = workshop_pos\n              min_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  # Turn around after crafting (optional)\n  current_dir = env._current_state.pos\n  actions.append((current_dir + 2) % 4)  # Turn around\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-08T22:21:10.051071", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_mean_pos = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n  # Move to the closest workshop position while avoiding obstacles\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          if env._current_state.next_to(env.world.stone_index) or env._current_state.next_to(env.world.water_index):\n              actions.append(3 if dx < 0 else 2)  # Move opposite direction in x\n              pos[0] -= 1 if dx > 0 else -1\n          elif not np.array_equal(pos + [1, 0], nearest_target_pos) and env._current_state.next_to(env.world.stone_index) or env._current_state.next_to(env.world.water_index):\n              actions.append(3 if dx < 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          if env._current_state.next_to(env.world.stone_index) or env._current_state.next_to(env.world.water_index):\n              actions.append(1 if dy < 0 else 0)  # Move opposite direction in y\n              pos[1] -= 1 if dy > 0 else -1\n          elif not np.array_equal(pos + [0, 1], nearest_target_pos) and env._current_state.next_to(env.world.stone_index) or env._current_state.next_to(env.world.water_index):\n              actions.append(1 if dy < 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n          else:\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-08T22:21:11.017338", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_mean_pos = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n  # Move to the closest workshop position while avoiding obstacles\n  path = astar(pos, nearest_target_pos, env)\n  for next_pos in path:\n      if not np.array_equal(pos, next_pos):\n          dx, dy = next_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n\n          pos = next_pos\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-08T22:22:31.357719", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, target_pos)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 5.2}}
{"timestamp": "2025-09-08T22:22:32.489412", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) == 0: continue\n\n      # Calculate the mean position of all workshops of this type\n      mean_workshop_pos = workshop_positions.mean(axis=0)\n      distance = np.linalg.norm(pos - mean_workshop_pos, ord=2)\n\n      if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Determine the nearest target position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  # Generate actions to navigate to the nearest target position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-08T22:23:39.908559", "function_name": "craft", "function_body": "  def find_closest_workshop_positions(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      target_positions = []\n      \n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_mean_pos = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n              \n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n                  target_positions = workshop_pos_list\n      \n      return closest_workshop_idx, target_positions\n\n  def move_towards_target_position(target_pos):\n      actions = []\n      pos = np.array(env._current_state.pos)\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              if env._current_state.next_to(env.world.stone_index) or env._current_state.next_to(env.world.water_index):\n                  actions.append(2 if dx < 0 else 3)  # Move opposite direction in x\n                  pos[0] -= 1 if dx > 0 else -1\n              else:\n                  actions.append(2 if dx < 0 else 3)\n                  pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              if env._current_state.next_to(env.world.stone_index) or env._current_state.next_to(env.world.water_index):\n                  actions.append(0 if dy < 0 else 1)  # Move opposite direction in y\n                  pos[1] -= 1 if dy > 0 else -1\n              else:\n                  actions.append(0 if dy < 0 else 1)\n                  pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  pos = np.array(env._current_state.pos)\n  closest_workshop_idx, target_positions = find_closest_workshop_positions(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n  \n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n  actions = move_towards_target_position(nearest_target_pos)\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-08T22:23:40.896647", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_mean_pos = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n  # Move to the closest workshop position while avoiding obstacles\n  path = a_star_search(env._current_state.grid, tuple(pos), tuple(nearest_target_pos))\n\n  for move in path:\n      dx, dy = np.array(move) - pos\n\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx < 0 else 2)\n      else:  # Then move in y-direction\n          actions.append(1 if dy < 0 else 0)\n\n      pos = np.array(move)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-08T22:24:42.645895", "function_name": "craft", "function_body": "  def move_towards(target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          # Determine direction to move in\n          if abs(dx) > abs(dy):  \n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  \n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  \n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n  # Move to the closest workshop position\n  actions = move_towards(nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-08T22:24:43.789164", "function_name": "craft", "function_body": "  def move_towards(target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          # Determine direction to move in based on the Manhattan distance metric\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n  # Move to the closest workshop position\n  actions = move_towards(nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-08T22:25:54.684079", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              if dx > 0:\n                  actions.append(3)\n              else:\n                  actions.append(2)\n\n              pos[0] += (1 if dx > 0 else -1)\n          else:  # Then move in y-direction\n              if dy > 0:\n                  actions.append(1)\n              else:\n                  actions.append(0)\n\n              pos[1] += (1 if dy > 0 else -1)\n      return actions\n\n  def find_closest_workshop(item_index):\n      cookbook = env.world.cookbook\n      workshop_indices = env.world.workshop_indices\n      \n      # Identify which workshops can craft the item\n      eligible_workshops = set()\n      for output_idx, recipe in cookbook.recipes.items():\n          if \"_workshop\" in recipe and item_index == output_idx:\n              workshop_type = recipe[\"_workshop\"]\n              if workshop_type in env.world.cookbook.index:\n                  workshop_idx = env.world.cookbook.index[workshop_type]\n                  eligible_workshops.add(workshop_idx)\n      \n      pos = np.array(env._current_state.pos)\n\n      closest_workshop_idx, min_distance = None, float('inf')\n      for workshop_idx in eligible_workshops:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      \n      return closest_workshop_idx\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest eligible workshop to craft the desired item\n  closest_workshop_idx = find_closest_workshop(goal_index)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found for crafting the item\")\n\n  actions = []\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(np.array(env._current_state.pos) - x, ord=2))\n\n  # Navigate to the nearest workshop position\n  actions.extend(move_towards(np.array(env._current_state.pos), nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-08T22:25:55.635709", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    actions = []\n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      \n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          if dx > 0:\n              actions.append(3)\n          else:\n              actions.append(2)\n\n          pos[0] += (1 if dx > 0 else -1)\n      else:  # Then move in y-direction\n          if dy > 0:\n              actions.append(1)\n          else:\n              actions.append(0)\n\n          pos[1] += (1 if dy > 0 else -1)\n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for recipe in cookbook.recipes.values():\n    if goal_index in recipe['result']:\n      for workshop_idx in recipe['workshops']:\n        workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n        if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n            workshop_pos_mean = workshop_pos_list.mean(axis=0)\n            distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n            if distance < min_distance:\n                closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x, ord=2))\n\n  # Navigate to the nearest workshop position\n  actions = move_towards(pos, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-08T22:26:45.487665", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          for wp in workshop_positions:\n              distance = np.linalg.norm(pos - wp, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = wp\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, target_workshop_pos):\n      dx, dy = target_workshop_pos - pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in, prioritize x-direction first\n      if dir_x is not None:\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif dir_y is not None:\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": 5.2}}
{"timestamp": "2025-09-08T22:26:46.635841", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          for wp in workshop_positions:\n              distance = np.linalg.norm(pos - wp, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = wp\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, target_workshop_pos):\n      dx, dy = target_workshop_pos - pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in, prioritize x-direction first\n      direction_to_move = None\n      if abs(dx) >= abs(dy):\n          direction_to_move = dir_x if dx != 0 else dir_y\n      else:\n          direction_to_move = dir_y if dy != 0 else dir_x\n\n      actions.append(direction_to_move)\n\n      # Update position based on the direction moved\n      pos += np.array([1 if dir_x == 3 else -1 if dir_x == 2 else 0,\n                       1 if dir_y == 1 else -1 if dir_y == 0 else 0])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"3": 0.7}}
{"timestamp": "2025-09-08T22:28:29.666837", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, target_pos)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 5.2}}
{"timestamp": "2025-09-08T22:28:30.719028", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, target_pos)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 5.2}}
{"timestamp": "2025-09-08T22:29:27.697304", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest specific position of any available workshop type that can craft the desired item\n  nearest_target_pos, min_nearest_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(target_positions) == 0:\n          continue\n\n      # Calculate distance to each workshop position and find the nearest one\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the nearest specific position of any available workshop type\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in: prioritize x-direction first if abs(dx) > abs(dy)\n      if abs(dx) > abs(dy):  \n          actions.append(3 if dx > 0 else 2)  # Move RIGHT or LEFT\n          pos[0] += 1 if dx > 0 else -1\n      else:\n          actions.append(1 if dy > 0 else 0)  # Move DOWN or UP\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-08T22:29:28.773769", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) == 0:\n          continue\n\n      # Calculate distances to all workshops of this type\n      distances = np.linalg.norm(pos - workshop_positions, axis=1)\n      nearest_distance = distances.min()\n\n      # Update closest workshop if a closer one is found\n      if nearest_distance < min_distance:\n          closest_workshop_idx = workshop_idx\n          min_distance = nearest_distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest specific position of the closest workshop type\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  distances = np.linalg.norm(pos - workshop_positions, axis=1)\n  nearest_target_pos = workshop_positions[np.argmin(distances)]\n\n  # Move to the nearest specific position of the closest workshop type\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      if abs(dx) > abs(dy):  \n          actions.append(3 if dx > 0 else 2)  # RIGHT or LEFT\n          pos[0] += 1 if dx > 0 else -1\n      else:\n          actions.append(1 if dy > 0 else 0)  # DOWN or UP\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
