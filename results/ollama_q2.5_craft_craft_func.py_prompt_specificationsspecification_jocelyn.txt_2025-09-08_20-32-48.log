urrent_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Check if we already have the item in our inventory before moving to the workshop\n  if not env._current_state.inventory[goal_index]:\n      # Move to the closest workshop position and use it\n      actions.extend(move_to_target(pos, nearest_target_pos))\n      actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 5.2}}
