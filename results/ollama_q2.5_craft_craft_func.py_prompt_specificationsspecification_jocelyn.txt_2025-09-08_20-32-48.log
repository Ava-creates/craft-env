f env._current_state.grid[new_pos[0], new_pos[1], env.world.stone_index] == 0 and env._current_state.grid[new_pos[0], new_pos[1], env.world.water_index] == 0:\n              return d\n      return None\n\n  # Move to the closest workshop position and avoid obstacles\n  while not np.array_equal(pos, nearest_target_pos):\n      step = get_next_step(pos, nearest_target_pos)\n      if step is None:\n          break  # No safe move available, exit loop\n      actions.append(3 if step[0] > 0 else (2 if step[0] < 0 else 1 if step[1] > 0 else 0))\n      pos += np.array(step)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T06:04:15.417864", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Function to calculate the next step towards the target position while avoiding obstacles\n  def get_next_step(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0) if dx != 0 else (0, np.sign(dy)) for dy in range(np.abs(dy))]\n      best_direction = None\n      min_blockage = float('inf')\n\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          blockage = env._current_state.grid[new_pos[0], new_pos[1], env.world.stone_index] + env._current_state.grid[new_pos[0], new_pos[1], env.world.water_index]\n          if blockage < min_blockage:\n              best_direction, min_blockage = d, blockage\n\n      return best_direction\n\n  # Move to the closest workshop position and avoid obstacles\n  while not np.array_equal(pos, nearest_target_pos):\n      step = get_next_step(pos, nearest_target_pos)\n      if step is None:\n          break  # No safe move available, exit loop\n      actions.append(3 if step[0] > 0 else (2 if step[0] < 0 else 1 if step[1] > 0 else 0))\n      pos += np.array(step)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-09T06:05:31.376558", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  def move_to_target(current_pos, target_pos):\n      \"\"\"Generate actions to move from current position to target position.\"\"\"\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          current_pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  \n  for workshop_idx in env.world.workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(np.array(env._current_state.pos) - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(np.array(env._current_state.pos) - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position and use it\n  actions = move_to_target(np.array(env._current_state.pos), nearest_target_pos)\n  \n  if not env._current_state.grid[nearest_target_pos[0], nearest_target_pos[1], goal_index]: # Check if item is already crafted at the workshop\n      actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T06:05:32.503829", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if abs(dx) > abs(dy):\n          return 3 if dx > 0 else 2  # RIGHT or LEFT\n      else:\n          return 1 if dy > 0 else 0  # UP or DOWN\n\n  def move_to_target(current_pos, target_pos):\n      \"\"\"Generate actions to move from current position to target position.\"\"\"\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          # Update current position based on the direction moved\n          if direction == 3:\n              current_pos[0] += 1\n          elif direction == 2:\n              current_pos[0] -= 1\n          elif direction == 1:\n              current_pos[1] += 1\n          else:  # direction == 0\n              current_pos[1] -= 1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  \n  for workshop_idx in env.world.workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(np.array(env._current_state.pos) - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(np.array(env._current_state.pos) - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position and use it\n  actions = move_to_target(np.array(env._current_state.pos), nearest_target_pos)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T06:06:46.882642", "function_name": "craft", "function_body": "  def move_to_position(current_pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          step = get_next_step(current_pos, target_pos)\n          if step is None:\n              break\n          action = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}.get(tuple(step))\n          actions.append(action)\n          current_pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0)] + [(0, np.sign(dy))] if dx != 0 else [(0, np.sign(dy))]\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          # Check if the new position is blocked by stone or water\n          if not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index):\n              return d\n      return None\n\n  def find_closest_workshop(goal_index: int, workshop_indices: list[int]) -> np.ndarray:\n      pos = np.array(env._current_state.pos)\n      closest_target_pos = None\n      min_distance = float('inf')\n\n      for workshop_idx in workshop_indices:\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_positions) > 0:\n              # Calculate the mean position of all available workshops of this type\n              workshop_mean_pos = workshop_positions.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n\n              if distance < min_distance:\n                  closest_target_pos = min(workshop_positions, key=lambda x: np.linalg.norm(pos - x))\n                  min_distance = distance\n\n      return closest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest position to move towards among all workshops\n  nearest_target_pos = find_closest_workshop(goal_index, workshop_indices)\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T06:06:47.951771", "function_name": "craft", "function_body": "  def move_to_position(current_pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          step = get_next_step(current_pos, target_pos)\n          if step is None:\n              break\n          action = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}.get(tuple(step))\n          actions.append(action)\n          current_pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      directions = [(np.sign(target_pos[0] - current_pos[0]), 0), (0, np.sign(target_pos[1] - current_pos[1]))]\n      for dx, dy in directions:\n          if dx == 0 and dy == 0:\n              continue\n          new_pos = current_pos + np.array([dx, dy])\n          # Check if the new position is blocked by stone or water\n          if env._current_state.next_to(env.world.stone_index) or env._current_state.next_to(env.world.water_index):\n              continue\n          return dx, dy\n      return None\n\n  def find_closest_workshop(goal_index: int, workshop_indices: list[int]) -> np.ndarray:\n      pos = np.array(env._current_state.pos)\n      closest_target_pos = None\n      min_distance = float('inf')\n\n      for workshop_idx in workshop_indices:\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_positions) > 0:\n              # Calculate the mean position of all available workshops of this type\n              workshop_mean_pos = workshop_positions.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n\n              if distance < min_distance:\n                  closest_target_pos = min(workshop_positions, key=lambda x: np.linalg.norm(pos - x))\n                  min_distance = distance\n\n      return closest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest position to move towards among all workshops\n  nearest_target_pos = find_closest_workshop(goal_index, workshop_indices)\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T06:08:09.633486", "function_name": "craft", "function_body": "  def move_to_position(pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          step = get_next_step(pos, target_pos)\n          if step is None:\n              break\n          direction = step[0]\n          # Convert relative movement to action index (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n          actions.append(3 if direction > 0 else (2 if direction < 0 else 1 if step[1] > 0 else 0))\n          pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0)] + [(0, np.sign(dy))] if dx != 0 else [(0, np.sign(dy))]\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          # Check if the next step is blocked by stone or water and skip those positions\n          if not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index):\n              return d\n      return None\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the recipe for the desired item\n  primitives_required = cookbook.primitives[goal_index]  # Assuming primitives are stored in a dictionary with keys as item indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Collect all required primitives if they're not already in inventory\n  for primitive, count in primitives_required.items():\n      while env._current_state.inventory[primitive] < count:\n          actions.extend(collect_primitive(primitive))\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:\n          # Calculate the mean position of all available workshops of this type\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-09T06:08:10.703818", "function_name": "craft", "function_body": "  def move_to_position(current_pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          step = get_next_step(current_pos, target_pos)\n          if step is None:\n              break\n          action_idx = direction_to_action(step)\n          actions.append(action_idx)\n          current_pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - current_pos\n      directions = []\n      if dx != 0:\n          directions.append((np.sign(dx), 0))  # move in x-direction\n      if dy != 0:\n          directions.append((0, np.sign(dy)))  # move in y-direction\n\n      for direction in directions:\n          new_pos = current_pos + np.array(direction)\n          # Check if the next step is blocked by stone or water and skip those positions\n          if not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index):\n              return direction\n      return None\n\n  def direction_to_action(step: tuple[int, int]) -> int:\n      dx, dy = step\n      if dx == 1:\n          return 3  # RIGHT\n      elif dx == -1:\n          return 2  # LEFT\n      elif dy == 1:\n          return 0  # DOWN\n      elif dy == -1:\n          return 1  # UP\n      else:\n          raise ValueError(\"Invalid direction\")\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:\n          # Calculate the mean position of all available workshops of this type\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
