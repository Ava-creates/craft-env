ey=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T04:07:03.539518", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  def find_closest_workshop(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          current_pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  def craft_at_workshop(workshop_idx):\n      # Calculate the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n      actions.extend(move_to_position(pos, nearest_target_pos))\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n  closest_workshop_idx = find_closest_workshop(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Check if we are already at a workshop\n  current_dir = env._current_state.dir\n  current_tile_index = env.world.cookbook.index[env._current_state.grid[pos[0], pos[1], :].nonzero()[0][0]]\n  \n  if current_tile_index in workshop_indices:\n      actions.extend(move_to_position(pos, np.array([pos[0] + (current_dir == 3) - (current_dir == 2),\n                                                    pos[1] + (current_dir == 1) - (current_dir == 0)])))\n  else:\n      craft_at_workshop(closest_workshop_idx)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-09T04:07:04.509092", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  def find_closest_workshop(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          current_pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  def craft_at_workshop(workshop_idx):\n      # Calculate the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n      actions.extend(move_to_position(pos, nearest_target_pos))\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n  closest_workshop_idx = find_closest_workshop(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  recipe = cookbook.recipes[goal_index]\n  required_primitives = recipe.primitives\n  \n  for primitive in required_primitives:\n    actions.extend(collect(env, primitive))\n  \n  craft_at_workshop(closest_workshop_idx)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-09T04:09:01.004942", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = heuristic(pos, tuple(workshop_pos_mean))\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, tuple(target_pos))\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx):\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n      # If dx == dy, move in the direction that brings you closer to the goal faster\n      else:\n          if heuristic((pos[0] + dx, pos[1]), goal_pos) < heuristic((pos[0], pos[1] + dy), goal_pos):\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Check if the agent is blocked and needs to find an alternative path\n      if not env._current_state.grid[pos[0], pos[1], env.world.cookbook.index['empty']]:\n          raise ValueError(\"Blocked path\")\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-09T04:09:01.995825", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n    return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find workshops that can craft the desired item\n  workshop_indices = [key for key, value in cookbook.recipes.items() if goal_index in value]\n  \n  if not workshop_indices:\n      raise ValueError(\"No available workshop found to craft this item\")\n  \n  actions = []\n\n  # Calculate the closest position to move towards among all applicable workshops\n  pos = np.array(env._current_state.pos)\n  nearest_workshop_pos = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_positions) == 0: continue\n      \n      # Calculate the closest position of this type of workshop\n      distances = [heuristic(pos, tuple(wp)) for wp in workshop_positions]\n      nearest_pos_index = np.argmin(distances)\n      distance = distances[nearest_pos_index]\n\n      if distance < min_distance:\n          nearest_workshop_pos = workshop_positions[nearest_pos_index]\n          min_distance = distance\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Convert the nearest position to tuple\n  goal_pos = tuple(nearest_workshop_pos)\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  \n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx):\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n      # If dx == dy, move in the direction that brings you closer to the goal faster\n      else:\n          if heuristic((pos[0] + dx, pos[1]), goal_pos) < heuristic((pos[0], pos[1] + dy), goal_pos):\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-09T04:10:14.635734", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          for wp in workshop_positions:\n              distance = np.linalg.norm(pos - wp, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = wp\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position using A* search for pathfinding\n  start = tuple(pos)\n  goal = tuple(target_workshop_pos)\n\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  frontier = []\n  heapq.heappush(frontier, (0, start))\n  came_from = {}\n  cost_so_far = {}\n  came_from[start] = None\n  cost_so_far[start] = 0\n\n  while frontier:\n      current = heapq.heappop(frontier)[1]\n\n      if current == goal:\n          break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          next_pos = (current[0] + dx, current[1] + dy)\n          \n          # Check if the next position is within bounds and not a boundary\n          if (0 <= next_pos[0] < env._current_state.grid.shape[0] and \n              0 <= next_pos[1] < env._current_state.grid.shape[1] and \n              not env._current_state.grid[next_pos[0], next_pos[1], env.world.cookbook.index[\"BOUNDARY\"]]):\n              \n              new_cost = cost_so_far[current] + heuristic(current, next_pos)\n              if next_pos not in cost_so_far or new_cost < cost_so_far[next_pos]:\n                  cost_so_far[next_pos] = new_cost\n                  priority = new_cost + heuristic(goal, next_pos)\n                  heapq.heappush(frontier, (priority, next_pos))\n                  came_from[next_pos] = current\n\n  # Reconstruct path from start to goal\n  if goal not in came_from:\n      raise ValueError(\"No path found to the workshop\")\n\n  current = goal\n  path = []\n  while current != start:\n      path.append(current)\n      current = came_from[current]\n  path.reverse()\n\n  # Convert path to actions\n  for i in range(len(path) - 1):\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      \n      if dx == 1:\n          actions.append(3)  # RIGHT\n      elif dx == -1:\n          actions.append(2)  # LEFT\n      elif dy == 1:\n          actions.append(1)  # DOWN\n      elif dy == -1:\n          actions.append(0)  # UP\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-09T04:15:14.745248", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          for wp in workshop_positions:\n              distance = np.linalg.norm(pos - wp, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = wp\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, target_workshop_pos):\n      dx, dy = target_workshop_pos - pos\n      \n      # Calculate direction based on differences in x and y coordinates\n      if abs(dx) > abs(dy): \n          dir_x = 3 if dx > 0 else 2  # RIGHT or LEFT\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):\n          dir_y = 1 if dy > 0 else 0  # DOWN or UP\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-09T04:16:18.690674", "function_name": "craft", "function_body": "  def get_closest_position(current_pos: np.ndarray, target_positions: np.ndarray):\n      distances = np.linalg.norm(target_positions - current_pos, axis=1)\n      min_distance_idx = np.argmin(distances)\n      return target_positions[min_distance_idx]\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = get_closest_position(pos, target_positions)\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(env, pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T04:16:19.814942", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  min_distance = float('inf')\n  nearest_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          distances = np.linalg.norm(workshop_positions - pos, axis=1)\n          nearest_workshop_index = np.argmin(distances)\n\n          if distances[nearest_workshop_index] < min_distance:\n              min_distance = distances[nearest_workshop_index]\n              nearest_workshop_pos = workshop_positions[nearest_workshop_index]\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_workshop_pos):\n      dx, dy = nearest_workshop_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n      else:  # If distances are equal, choose a direction randomly or based on preference\n          direction = np.random.choice([3 if dx > 0 else 2, 1 if dy > 0 else 0])\n          actions.append(direction)\n          if direction in [3, 2]:\n              pos[0] += 1 if dx > 0 else -1\n          else:\n              pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T04:17:52.238752", "function_name": "craft", "function_body": "  def is_safe_to_move(current_pos):\n      # Check if moving in any direction would result in the agent being next to stone or water\n      safe = True\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor_pos = current_pos + np.array([dx, dy])\n          if env._current_state.next_to(env.world.stone_index) or env._current_state.next_to(env.world.water_index):\n              safe = False\n              break\n      return safe\n\n  def bfs_shortest_path(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {tuple(start): None}\n\n      while queue:\n          current = queue.popleft()\n          if tuple(current) == tuple(goal):\n              path = []\n              while current is not None:\n                  path.append(tuple(current))\n                  current = parent[tuple(current)]\n              return path[::-1]\n\n          visited.add(tuple(current))\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if is_safe_to_move(np.array(neighbor)) and tuple(neighbor) not in visited:\n                  queue.append(neighbor)\n                  parent[tuple(neighbor)] = current\n\n      return None\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Find the shortest path to the closest workshop position while avoiding obstacles\n  path = bfs_shortest_path(tuple(pos), tuple(nearest_target_pos))\n\n  if not path:\n      raise ValueError(\"No safe path found\")\n\n  for step in path[1:]:  # Skip the starting point\n      actions.append(3 if (step[0] - pos[0]) > 0 else (2 if (step[0] - pos[0]) < 0 else 1 if (step[1] - pos[1]) > 0 else 0))\n      pos = np.array(step)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T04:17:53.538147", "function_name": "craft", "function_body": "  def is_safe_to_move(current_pos):\n      return not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index)\n\n  def bfs_shortest_path(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {tuple(start): None}\n\n      while queue:\n          current = queue.popleft()\n          if tuple(current) == tuple(goal):\n              path = []\n              while current is not None:\n                  path.append(tuple(current))\n                  current = parent[tuple(current)]\n              return path[::-1]\n\n          visited.add(tuple(current))\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if is_safe_to_move(np.array(neighbor)) and tuple(neighbor) not in visited:\n                  queue.append(neighbor)\n                  parent[tuple(neighbor)] = current\n\n      return None\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Find the shortest path to the closest workshop position while avoiding obstacles\n  path = bfs_shortest_path(tuple(pos), tuple(nearest_target_pos))\n\n  if not path:\n      raise ValueError(\"No safe path found\")\n\n  for step in path[1:]:  # Skip the starting point\n      actions.append(3 if (step[0] - pos[0]) > 0 else (2 if (step[0] - pos[0]) < 0 else 1 if (step[1] - pos[1]) > 0 else 0))\n      pos = np.array(step)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T04:24:09.341621", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Function to calculate the next step towards the target position while avoiding obstacles and considering all directions\n  def get_next_step(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]  # Right, Left, Down, Up\n\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          if not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index):\n              return d\n      return None\n\n  # Move to the closest workshop position and avoid obstacles\n  while not np.array_equal(pos, nearest_target_pos):\n      step = get_next_step(pos, nearest_target_pos)\n      if step is None:\n          break  # No safe move available, exit loop\n      actions.append(3 if step[0] > 0 else (2 if step[0] < 0 else 1 if step[1] > 0 else 0))\n      pos += np.array(step)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T04:24:10.412841", "function_name": "craft", "function_body": "  def is_safe_to_move(current_pos):\n      return not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index)\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Function to calculate the next step towards the target position while avoiding obstacles\n  def get_next_step(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      directions = []\n      if dx != 0:\n          directions.append((np.sign(dx), 0))  # move in x-direction\n      if dy != 0:\n          directions.append((0, np.sign(dy)))  # move in y-direction\n\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          if is_safe_to_move(new_pos):\n              return d\n      return None\n\n  # Move to the closest workshop position and avoid obstacles\n  while not np.array_equal(pos, nearest_target_pos):\n      step = get_next_step(pos, nearest_target_pos)\n      if step is None:\n          break  # No safe move available, exit loop\n      actions.append(3 if step[0] > 0 else (2 if step[0] < 0 else 1 if step[1] > 0 else 0))\n      pos += np.array(step)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T04:25:28.174129", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  def find_closest_workshop(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          current_pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  def craft_at_workshop(workshop_idx):\n      # Calculate the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n      actions.extend(move_to_position(pos, nearest_target_pos))\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n  closest_workshop_idx = find_closest_workshop(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  craft_at_workshop(closest_workshop_idx)\n  \n  # Return all accumulated actions\n  return actions", "island_id": 1, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T04:25:29.145043", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  def find_closest_workshop(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          current_pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  def craft_at_workshop(workshop_idx):\n      # Calculate the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n      actions.extend(move_to_position(pos, nearest_target_pos))\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n  closest_workshop_idx = find_closest_workshop(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Check if the goal item is already in inventory\n  if env._current_state.next_item == goal_index:\n      return actions\n\n  craft_at_workshop(closest_workshop_idx)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-09T04:31:45.760505", "function_name": "craft", "function_body": "  def get_closest_position(current_pos: np.ndarray, target_positions: np.ndarray):\n    distances = np.linalg.norm(target_positions - current_pos, axis=1)\n    min_distance_idx = np.argmin(distances)\n    return target_positions[min_distance_idx]\n\n  def move_towards(env, current_pos, target_pos) -> list[int]:\n    actions = []\n    while not np.array_equal(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      direction_priority = [(3, (1, 0)), (2, (-1, 0)), (1, (0, 1)), (0, (0, -1))]\n      for dir_idx, (dx_adj, dy_adj) in direction_priority:\n        if dx == dx_adj and dy == dy_adj:\n          actions.append(dir_idx)\n          current_pos += [dx_adj, dy_adj]\n          break\n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  current_pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    if len(workshop_positions) > 0:  # Check if there are any locations for the workshop\n      nearest_target_pos = get_closest_position(current_pos, workshop_positions)\n      distance = np.linalg.norm(nearest_target_pos - current_pos)\n      if distance < min_distance:\n        closest_workshop_idx = workshop_idx\n        min_distance = distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = get_closest_position(current_pos, target_positions)\n\n  # Move to the closest workshop position\n  actions.extend(move_towards(env, current_pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T04:31:46.772420", "function_name": "craft", "function_body": "  def get_closest_position(current_pos: np.ndarray, target_positions: np.ndarray):\n      distances = np.linalg.norm(target_positions - current_pos, axis=1)\n      min_distance_idx = np.argmin(distances)\n      return target_positions[min_distance_idx]\n\n  def pathfinding_bfs(start_pos: np.ndarray, target_positions: np.ndarray, grid: np.ndarray) -> list[np.ndarray]:\n      queue = collections.deque([start_pos])\n      visited = set(tuple(pos) for pos in [start_pos])\n      parent = {tuple(start_pos): None}\n\n      while queue:\n          current_pos = queue.popleft()\n          if any(np.array_equal(current_pos, target_pos) for target_pos in target_positions):\n              path = []\n              while tuple(current_pos) != tuple(start_pos):\n                  path.append(tuple(current_pos))\n                  current_pos = parent[tuple(current_pos)]\n              path.reverse()\n              return [np.array(p) for p in path]\n\n          neighbors = [(current_pos[0] + dx, current_pos[1] + dy) \n                         for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n          \n          valid_neighbors = [np.array(n) for n in neighbors if grid[tuple(n)].sum() == 0 and tuple(n) not in visited]\n\n          for neighbor in valid_neighbors:\n              queue.append(neighbor)\n              visited.add(tuple(neighbor))\n              parent[tuple(neighbor)] = current_pos\n\n      return []\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  grid = np.sum(env._current_state.grid, axis=2)\n  current_pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) > 0:  # Check if there are any locations for the workshop\n          # Find the closest position to move towards\n          nearest_target_pos = get_closest_position(current_pos, workshop_positions)\n          distance = np.linalg.norm(nearest_target_pos - current_pos)\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = get_closest_position(current_pos, target_positions)\n\n  # Pathfinding to the closest workshop position\n  path_to_workshop = pathfinding_bfs(current_pos, target_positions, grid)\n  if not path_to_workshop:\n      raise ValueError(\"Path to workshop could not be found\")\n\n  # Convert path positions to actions\n  for next_pos in path_to_workshop:\n      direction = get_direction(current_pos, next_pos)\n      actions.append(direction)\n      current_pos = next_pos\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T04:33:32.705449", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = heuristic(pos, tuple(workshop_pos_mean))\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: heuristic(tuple(pos), tuple(x)))\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      direction = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = (3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          direction = (1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n      actions.append(direction)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T04:33:33.763189", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = heuristic(pos, tuple(workshop_pos_mean))\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: heuristic(tuple(pos), tuple(x)))\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Check if the agent is already at a workshop before using it\n  if any(env._current_state.grid[pos[0], pos[1], w_idx] for w_idx in workshop_indices):\n      actions.append(4)  # USE only if at a workshop\n  else:\n      raise ValueError(\"Agent not at a workshop\")\n\n  return actions", "island_id": 6, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T04:34:55.454242", "function_name": "craft", "function_body": "  def move_to_position(current_pos: np.ndarray, target_pos: np.ndarray):\n      \"\"\"Moves the agent from current_pos to target_pos avoiding stones and water.\"\"\"\n      actions = []\n      path = find_path(current_pos, target_pos)\n      for step in path:\n          direction = (step[0] - current_pos[0], step[1] - current_pos[1])\n          action = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}.get(direction)\n          actions.append(action)\n          current_pos = step\n      return actions\n\n  def find_path(start: np.ndarray, end: np.ndarray):\n      \"\"\"Finds a path from start to end avoiding stones and water.\"\"\"\n      # Use A* search algorithm to find the shortest path\n      open_set = collections.deque([(start[0], start[1])])\n      came_from = {}\n      cost_so_far = {(start[0], start[1]): 0}\n\n      while open_set:\n          current = open_set.popleft()\n\n          if np.array_equal(current, end):\n              break\n\n          for next_pos in [(current[0] + dx, current[1] + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]:\n              new_cost = cost_so_far[current] + 1\n              if (next_pos not in cost_so_far or new_cost < cost_so_far[next_pos]) and \\\n                 not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index):\n                  cost_so_far[next_pos] = new_cost\n                  came_from[next_pos] = current\n                  open_set.append(next_pos)\n\n      path = []\n      while np.array_equal(current, end):\n          path.append(current)\n          current = came_from[current]\n      return list(reversed(path))\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:\n          # Calculate the mean position of all available workshops of this type\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-09T04:34:56.521669", "function_name": "craft", "function_body": "  def move_to_position(pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          step = get_next_step(pos, target_pos)\n          if step is None:\n              break\n          direction = step[0]\n          # Convert relative movement to action index (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n          actions.append(3 if direction > 0 else (2 if direction < 0 else 1 if step[1] > 0 else 0))\n          pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0)] + [(0, np.sign(dy))] if dx != 0 else [(0, np.sign(dy))]\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          # Check if the next step is blocked by stone or water and skip those positions\n          if not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index):\n              return d\n      return None\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:\n          # Calculate the mean position of all available workshops of this type\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T04:36:08.844368", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  def find_closest_workshop(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              distances = np.linalg.norm(pos - workshop_pos_list, axis=1)\n              nearest_workshop_pos = workshop_pos_list[np.argmin(distances)]\n              distance = np.linalg.norm(nearest_workshop_pos - pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          current_pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  closest_workshop_idx = find_closest_workshop(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n\n  # Check if the agent is at a workshop and use it\n  if env._current_state.grid[pos[0], pos[1], closest_workshop_idx] > 0:\n      actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 5.2}}
