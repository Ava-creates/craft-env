= np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n\n  # Check if the agent is at a workshop and use it\n  if env._current_state.grid[pos[0], pos[1], closest_workshop_idx] > 0:\n      actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
