{"timestamp": "2025-09-09T09:29:33.803317", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          current_pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Check which workshops have the required ingredients\n  available_workshops = []\n  for workshop_idx in workshop_indices:\n      if any(pos.any() for pos in np.argwhere(env._current_state.grid[:, :, workshop_idx])):\n          available_workshops.append(workshop_idx)\n\n  if not available_workshops:\n      raise ValueError(\"No available workshops with required ingredients\")\n\n  # Find the closest workshop among those that have the required ingredients\n  closest_workshop_idx, min_distance = None, float('inf')\n  for workshop_idx in available_workshops:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      workshop_pos_mean = workshop_pos_list.mean(axis=0)\n      distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n      if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, distance\n\n  # Find the nearest target position within range of the closest workshop\n  workshop_pos_list = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(workshop_pos_list, key=lambda tp: np.linalg.norm(pos - tp, ord=2))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T09:29:34.828833", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  def find_closest_workshop(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          current_pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  closest_workshop_idx = find_closest_workshop(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the position to move towards based on the recipe\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda tp: np.linalg.norm(pos - tp, ord=2))\n\n  # Determine the final movement direction if necessary\n  dx, dy = nearest_target_pos - pos\n  if abs(dx) > 1 or abs(dy) > 1:\n      # Adjust position to be within range of USE action\n      adjusted_x = current_pos[0] + (1 if dx > 0 else (-1 if dx < 0 else 0))\n      adjusted_y = current_pos[1] + (1 if dy > 0 else (-1 if dy < 0 else 0))\n      nearest_target_pos = np.array([adjusted_x, adjusted_y])\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-09T09:30:57.420084", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if abs(dx) > abs(dy):\n          return 3 if dx > 0 else 2  # RIGHT or LEFT\n      elif abs(dy) > abs(dx):\n          return 1 if dy > 0 else 0  # UP or DOWN\n\n  def calculate_path(start: np.array, target: np.array) -> list[int]:\n      \"\"\"Calculate a path from start to target using BFS.\"\"\"\n      directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n      queue = collections.deque([(start.tolist(), [])])\n      visited = set()\n\n      while queue:\n          current_pos, path = queue.popleft()\n          if tuple(current_pos) in visited:\n              continue\n          visited.add(tuple(current_pos))\n\n          if np.array_equal(current_pos, target):\n              return path\n\n          for dx, dy in directions:\n              new_pos = np.array(current_pos) + [dx, dy]\n              if 0 <= new_pos[0] < env._current_state.grid.shape[0] and 0 <= new_pos[1] < env._current_state.grid.shape[1]:\n                  direction = calculate_direction(dx, dy)\n                  queue.append((new_pos.tolist(), path + [direction]))\n\n      return []\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = [w for w in env.world.workshop_indices if env._current_state.grid[:, :, w].sum() > 0]\n  \n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest available workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          nearest_target_pos = workshop_pos_list[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in workshop_pos_list])]\n          distance = np.linalg.norm(pos - nearest_target_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Calculate the path to the closest workshop position\n  actions.extend(calculate_path(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 5.2}}
