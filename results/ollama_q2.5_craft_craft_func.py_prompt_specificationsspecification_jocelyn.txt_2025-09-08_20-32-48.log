{"timestamp": "2025-09-08T21:27:57.606508", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position and face it correctly\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Calculate the direction to face towards the target position\n  direction_to_face = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0]) * 180 / np.pi\n  current_direction = env._current_state.dir\n\n  if 45 <= direction_to_face < 135:\n      target_dir = 1  # UP\n  elif -45 <= direction_to_face < 45:\n      target_dir = 2  # LEFT\n  elif -135 <= direction_to_face < -45:\n      target_dir = 0  # DOWN\n  else:\n      target_dir = 3  # RIGHT\n\n  while current_direction != target_dir:\n      if (current_direction + 1) % 4 == target_dir or (current_direction - 3) % 4 == target_dir:\n          actions.append(2)  # LEFT\n      elif (current_direction - 1) % 4 == target_dir or (current_direction + 3) % 4 == target_dir:\n          actions.append(3)  # RIGHT\n      current_direction = (current_direction + 1) % 4 if current_direction != target_dir else target_dir\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 0.19999999}}
{"timestamp": "2025-09-08T21:32:57.659833", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in (prioritize moving directly towards the target)\n      dir_to_move = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          dir_to_move = 3 if dx > 0 else 2\n          new_pos = pos + np.array([1, 0]) if dx > 0 else np.array([-1, 0])\n      else:  # Then move in y-direction\n          dir_to_move = 1 if dy > 0 else 0\n          new_pos = pos + np.array([0, 1]) if dy > 0 else np.array([0, -1])\n\n      # Check if the next position is valid (not blocked)\n      if env._current_state.grid[new_pos[0], new_pos[1]].sum() == 0:\n          actions.append(dir_to_move)\n          pos = new_pos\n      else:  # If blocked, try the other direction\n          dir_to_move = 3 if dx < 0 else 2 if dx > 0 else 1 if dy < 0 else 0\n          new_pos = pos + np.array([1, 0]) if dx < 0 else np.array([-1, 0]) if dx > 0 else np.array([0, 1]) if dy < 0 else np.array([0, -1])\n          if env._current_state.grid[new_pos[0], new_pos[1]].sum() == 0:\n              actions.append(dir_to_move)\n              pos = new_pos\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-08T21:34:10.827900", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can use to craft the desired item by checking recipes\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in env.world.workshop_indices:\n      # Check if any recipe for the goal item uses this workshop type\n      for output_index, ingredients in cookbook.recipes.items():\n          if output_index == goal_index and \"_key\" in ingredients and ingredients[\"_key\"] == workshop_idx:\n              # Calculate the mean position of all workshops of this type\n              workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n              if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n                  workshop_pos_mean = workshop_pos_list.mean(axis=0)\n                  distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n                  if distance < min_distance:\n                      closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found that can craft the desired item\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move i