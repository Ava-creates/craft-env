ld.stone_index] == 0 and\\\n             env._current_state.grid[int(new_pos[0]), int(new_pos[1]), env.world.water_index] == 0:\n              distance = np.linalg.norm(target_pos - new_pos, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  next_step = (dx, dy)\n\n      return next_step\n\n  # Move to the closest workshop position and avoid obstacles\n  while not np.array_equal(current_pos, nearest_target_pos):\n      step = get_next_step(current_pos, nearest_target_pos)\n      if step is None:\n          break  # No safe move available, exit loop\n      direction = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}.get(tuple(step))\n      actions.append(direction)\n      current_pos += np.array(step)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 5.2}}
