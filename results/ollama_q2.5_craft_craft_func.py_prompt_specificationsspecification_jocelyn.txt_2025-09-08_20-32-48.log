{"timestamp": "2025-09-08T22:59:33.042966", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  target_workshops = []\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          target_workshops.append((workshop_idx, workshop_pos_list))\n\n  if not target_workshops:\n      raise ValueError(\"No available workshop found\")\n\n  pos = np.array(env._current_state.pos)\n\n  # Determine the closest position among all workshops\n  nearest_target_pos = None\n  min_distance = float('inf')\n  for workshop_idx, workshop_pos_list in target_workshops:\n      for workshop_pos in workshop_pos_list:\n          distance = np.linalg.norm(pos - workshop_pos, ord=2)\n          if distance < min_distance:\n              nearest_target_pos = workshop_pos\n              min_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-08T23:00:57.250430", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* algorithm\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=1)\n\n  def a_star(start, goal):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if np.array_equal(current, goal):\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.put((f_score[neighbor], neighbor))\n\n      return None\n\n  path_to_workshop = a_star(tuple(pos), tuple(nearest_target_pos))\n  \n  if path_to_workshop is None:\n    raise ValueError(\"No valid path to the workshop found\")\n\n  # Convert path to actions\n  for next_pos in path_to_workshop:\n      dx, dy = next_pos[0] - pos[0], next_pos[1] - pos[1]\n      \n      if dx == 1:\n          actions.append(3)  # RIGHT\n      elif dx == -1:\n          actions.append(2)  # LEFT\n      elif dy == 1:\n          actions.append(1)  # UP\n      else:  # dy == -1\n          actions.append(0)  # DOWN\n\n      pos = np.array(next_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-08T23:05:57.368275", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = None\n\n      # Determine the primary and secondary directions based on absolute differences\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = (3 if dx > 0 else 2)\n      elif abs(dx) < abs(dy):  # Then move in y-direction\n          direction = (1 if dy > 0 else 0)\n\n      actions.append(direction)\n\n      # Update the position based on the chosen direction\n      if direction == 3:\n          pos[0] += 1\n      elif direction == 2:\n          pos[0] -= 1\n      elif direction == 1:\n          pos[1] += 1\n      else:  # direction == 0\n          pos[1] -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-08T23:07:02.081750", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          for wp in workshop_positions:\n              distance = np.linalg.norm(pos - wp, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = wp\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, target_workshop_pos):\n      dx, dy = target_workshop_pos - pos\n      \n      # Calculate direction based on differences in x and y coordinates\n      if dx != 0:\n          dir_x = 3 if dx > 0 else 2  # RIGHT or LEFT\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:\n          dir_y = 1 if dy > 0 else 0  # DOWN or UP\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": 5.2}}
{"timestamp": "2025-09-08T23:07:03.067835", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          for wp in workshop_positions:\n              distance = np.linalg.norm(pos - wp, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = wp\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position using the shortest path algorithm (BFS)\n  visited = np.zeros_like(env._current_state.grid[:, :, 0], dtype=bool)\n  queue = collections.deque([tuple(pos)])\n  parent = {}\n  \n  while queue:\n      x, y = queue.popleft()\n      \n      if (x, y) == tuple(target_workshop_pos):\n          break\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          \n          if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1] and not visited[nx, ny]:\n              visited[nx, ny] = True\n              queue.append((nx, ny))\n              parent[(nx, ny)] = (x, y)\n  \n  if target_workshop_pos not in parent:\n      raise ValueError(\"No path to the workshop found\")\n  \n  # Reconstruct the path from start position to target workshop position\n  path = []\n  current = tuple(target_workshop_pos)\n  while current != tuple(pos):\n      path.append(current)\n      current = parent[current]\n  path.reverse()\n\n  # Translate the path into actions (UP, DOWN, LEFT, RIGHT)\n  for i in range(len(path) - 1):\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 1:\n          actions.append(3)  # RIGHT\n      elif dx == -1:\n          actions.append(2)  # LEFT\n      elif dy == 1:\n          actions.append(1)  # DOWN\n      elif dy == -1:\n          actions.append(0)  # UP\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-08T23:08:04.521306", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-08T23:08:05.587469", "function_name": "craft", "function_body": "  def find_closest_workshop_positions(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      target_positions = []\n      \n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_mean_pos = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n              \n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n                  target_positions = workshop_pos_list\n      \n      return closest_workshop_idx, target_positions\n\n  def move_towards_target_position(target_pos):\n      actions = []\n      pos = np.array(env._current_state.pos)\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  pos = np.array(env._current_state.pos)\n  closest_workshop_idx, target_positions = find_closest_workshop_positions(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n  \n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n  actions = move_towards_target_position(nearest_target_pos)\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-08T23:09:46.629589", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_mean_pos = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n  def move_to_position_avoiding_obstacles(current_pos: np.ndarray, target_pos: np.ndarray, actions: list[int]):\n      UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              dir_ = RIGHT if dx > 0 else LEFT\n          else:  # Then move in y-direction\n              dir_ = DOWN if dy > 0 else UP\n\n          actions.append(dir_)\n          current_pos += [1, 0] if dir_ == RIGHT else [-1, 0] if dir_ == LEFT else [0, 1] if dir_ == DOWN else [0, -1]\n\n          # Check for obstacles and avoid them\n          if env._current_state.next_to(env.world.stone_index) or env._current_state.next_to(env.world.water_index):\n              # Move back in the opposite direction to avoid obstacle\n              actions.append(LEFT if dir_ == RIGHT else RIGHT if dir_ == LEFT else UP if dir_ == DOWN else DOWN)\n              current_pos += [-1, 0] if dir_ == RIGHT else [1, 0] if dir_ == LEFT else [0, -1] if dir_ == DOWN else [0, 1]\n\n  move_to_position_avoiding_obstacles(pos, nearest_target_pos, actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-08T23:09:47.595702", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_mean_pos = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n  def move_to_position_avoiding_obstacles(current_pos: np.ndarray, target_pos: np.ndarray, actions: list[int]):\n      # Use A* algorithm to find the shortest path avoiding obstacles\n      class Node:\n          def __init__(self, position, parent=None):\n              self.position = position\n              self.parent = parent\n              self.g = 0  # Cost from start to current node\n              self.h = 0  # Heuristic cost estimate to target\n              self.f = 0  # Total cost (g + h)\n\n          def __eq__(self, other):\n              return np.array_equal(self.position, other.position)\n\n      def heuristic(a, b):\n          return np.linalg.norm(a - b, ord=2)\n\n      open_list = []\n      closed_list = set()\n      start_node = Node(pos)\n      target_node = Node(target_pos)\n\n      open_list.append(start_node)\n\n      while len(open_list) > 0:\n          current_node = min(open_list, key=lambda x: x.f)\n          open_list.remove(current_node)\n          closed_list.add(tuple(current_node.position))\n\n          if np.array_equal(current_node.position, target_pos):\n              path = []\n              while current_node is not None:\n                  path.append(current_node.position.tolist())\n                  current_node = current_node.parent\n              return path[::-1]  # Return reversed path\n\n          neighbors = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # UP, DOWN, LEFT, RIGHT\n\n          for new_position in neighbors:\n              node_position = current_node.position + np.array(new_position)\n\n              if not (0 <= node_position[0] < env._current_state.grid.shape[0] and\n                      0 <= node_position[1] < env._current_state.grid.shape[1]):\n                  continue\n\n              if env._current_state.next_to(env.world.stone_index, node_position) or \\\n                 env._current_state.next_to(env.world.water_index, node_position):\n                  continue\n\n              neighbor_node = Node(node_position, current_node)\n              neighbor_node.g = current_node.g + 1\n              neighbor_node.h = heuristic(neighbor_node.position, target_pos)\n              neighbor_node.f = neighbor_node.g + neighbor_node.h\n\n              if tuple(neighbor_node.position) in closed_list:\n                  continue\n\n              if any(open_node for open_node in open_list if neighbor_node == open_node and neighbor_node.g > open_node.g):\n                  continue\n\n              open_list.append(neighbor_node)\n\n      return []  # No path found\n\n  path = move_to_position_avoiding_obstacles(pos, nearest_target_pos, actions)\n  \n  for next_pos in path:\n      dx, dy = np.array(next_pos) - pos\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          if dx > 0:\n              actions.append(3)  # RIGHT\n              pos[0] += 1\n          else:\n              actions.append(2)  # LEFT\n              pos[0] -= 1\n      else:  # Then move in y-direction\n          if dy > 0:\n              actions.append(1)  # DOWN\n              pos[1] += 1\n          else:\n              actions.append(0)  # UP\n              pos[1] -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-08T23:10:49.045684", "function_name": "craft", "function_body": "  def move_towards(target_pos):\n    pos = np.array(env._current_state.pos)\n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      direction = None\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = (3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          direction = (1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n      actions.append(direction)\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  move_towards(nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 3, "scores": {"3": 4.7}}
{"timestamp": "2025-09-08T23:10:50.027414", "function_name": "craft", "function_body": "  def move_towards(target_pos):\n    current_pos = np.array(env._current_state.pos)\n    while not np.array_equal(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      direction = None\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = (3 if dx > 0 else 2)\n          current_pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          direction = (1 if dy > 0 else 0)\n          current_pos[1] += 1 if dy > 0 else -1\n\n      actions.append(direction)\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item to determine which workshop is required\n  recipe = cookbook.recipes.get(goal_index)\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_type_required = recipe.workshop\n  workshop_idx = env.world.cookbook.index[workshop_type_required]\n\n  actions = []\n\n  # Calculate the closest position to move towards the required workshop type\n  target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n  if not len(target_positions):\n      raise ValueError(\"No available workshops of the required type found\")\n\n  nearest_target_pos = min(\n      target_positions, key=lambda pos: np.linalg.norm(np.array(env._current_state.pos) - pos)\n  )\n\n  # Move to the closest workshop position\n  move_towards(nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 3, "scores": {"3": -1}}
