{"timestamp": "2025-09-09T01:11:35.048380", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check if the item can be crafted at any workshop available in the environment\n  workshop_indices = [idx for idx, workshops in enumerate(env._current_state.grid) if np.any(workshops)]\n  \n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  for workshop_idx in workshop_indices:\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(target_positions) > 0:  # Check if there is any location for the workshop\n          nearest_target_pos = min(target_positions, key=lambda pos: heuristic(pos, tuple(pos)))\n          \n          distance = heuristic(tuple(pos), tuple(nearest_target_pos))\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-09T01:13:20.077525", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Get the list of workshops that can craft the desired item from the recipe\n  recipes = [recipe for recipe in cookbook.recipes if goal_index in recipe['outputs']]\n  workshop_indices = {workshop_idx for recipe in recipes for workshop_idx in recipe.get('workshops', [])}\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = heuristic(pos, tuple(workshop_pos_mean))\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, tuple(target_pos))\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-09T01:13:21.147267", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, target_pos)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T01:14:42.940464", "function_name": "craft", "function_body": "  def move_to_position(current_pos: np.ndarray, target_pos: np.ndarray):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      actions = []\n      \n      # Move in x-direction\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      # Move in y-direction\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      return actions\n\n  def get_closest_workshop(goal_index: int, workshop_indices: list[int]) -> (int, np.ndarray):\n      pos = np.array(env._current_state.pos)\n      closest_workshop_idx, min_distance = None, float('inf')\n      \n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n              # Check if the workshop can craft the desired item\n              if can_use_workshop(workshop_idx, goal_index):\n                  if distance < min_distance:\n                      closest_workshop_idx, min_distance = workshop_idx, distance\n      \n      return closest_workshop_idx\n\n  def can_use_workshop(workshop_idx: int, goal_index: int) -> bool:\n      # Check if the current workshop can craft the desired item\n      recipes = env.world.cookbook.recipes.get(goal_index, [])\n      for recipe in recipes:\n          if workshop_idx in recipe['workshops']:\n              return True\n      return False\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx = get_closest_workshop(goal_index, workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-09T01:14:43.887897", "function_name": "craft", "function_body": "  def move_to_position(current_pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          step = get_next_step(current_pos, target_pos)\n          if step is None:\n              break\n          action = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}.get(tuple(step))\n          actions.append(action)\n          current_pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0)] + [(0, np.sign(dy))] if dx != 0 else [(0, np.sign(dy))]\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          # Check if the next position is blocked by stone or water\n          if not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index):\n              return d\n      return None\n\n  def find_closest_workshop(goal_index: int, workshop_indices: list[int]) -> (int, np.ndarray):\n      pos = np.array(env._current_state.pos)\n      closest_workshop_idx, min_distance = None, float('inf')\n      \n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n              if distance < min_distance and can_use_workshop(workshop_idx, goal_index):\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  def can_use_workshop(workshop_idx: int, goal_index: int) -> bool:\n      # Check if the workshop can craft the desired item by looking at the recipe\n      recipes = env.world.cookbook.recipes.get(goal_index)\n      if not recipes:\n          return False\n      \n      for recipe in recipes:\n          if workshop_idx in recipe.workshops:\n              return True\n      return False\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx = find_closest_workshop(goal_index, workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-09T01:15:56.305738", "function_name": "craft", "function_body": "  def move_to_position(pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          step = get_next_step(pos, target_pos)\n          if step is None:\n              break\n          actions.append(3 if step[0] > 0 else (2 if step[0] < 0 else 1 if step[1] > 0 else 0))\n          pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0)] + [(0, np.sign(dy))] if dx != 0 else [(0, np.sign(dy))]\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          # Check if the next step is safe (not blocked by stone or water)\n          if not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index):\n              return d\n      return None\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Retrieve the recipe for the item to determine which workshop is needed\n  recipe = cookbook.primitives.get(goal_index)\n  if not recipe or 'workshop' not in recipe:\n      raise ValueError(f\"No workshop specified in the recipe for {item}\")\n\n  workshop_type = recipe['workshop']\n  workshop_indices = [w_idx for w_idx, w_name in enumerate(env.world.cookbook.index) if f\"WORKSHOP{workshop_type}\" in w_name]\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop of the required type that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-09T01:15:57.401385", "function_name": "craft", "function_body": "  def move_to_position(pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          step = get_next_step(pos, target_pos)\n          if step is None:\n              break\n          actions.append(3 if step[0] > 0 else (2 if step[0] < 0 else 1 if step[1] > 0 else 0))\n          pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0)] + [(0, np.sign(dy))] if dx != 0 else [(0, np.sign(dy))]\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          if not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index):\n              return d\n      return None\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T01:17:07.049305", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  def find_closest_workshop(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          current_pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  def craft_at_workshop(workshop_idx):\n      # Calculate the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n      actions.extend(move_to_position(pos, nearest_target_pos))\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n  closest_workshop_idx = find_closest_workshop(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  craft_at_workshop(closest_workshop_idx)\n\n  return actions", "island_id": 1, "scores": {"3": 5.2}}
