_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Check the direction to align with the workshop position before using it.\n  dx, dy = nearest_target_pos - pos\n  target_directions = []\n  if dx != 0:\n      target_directions.append(3 if dx > 0 else 2)\n  elif dy != 0:\n      target_directions.append(1 if dy > 0 else 0)\n\n  # If the agent is not already facing the workshop, align direction\n  current_dir = env._current_state.dir\n  dir_map = {0: (0, -1), 1: (0, 1), 2: (-1, 0), 3: (1, 0)}\n\n  # Calculate required direction to face the target position\n  required_dir = None\n  for d, vec in dir_map.items():\n      if np.array_equal(vec, dx, dy):\n          required_dir = d\n          break\n\n  if current_dir != required_dir:\n      actions.append(required_dir)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T07:06:16.094218", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find all workshops and their positions on the grid\n  workshop_positions = collections.defaultdict(list)\n  for idx in workshop_indices:\n      pos_list = np.argwhere(env._current_state.grid[:, :, idx])\n      if len(pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_positions[idx] = pos_list\n\n  closest_workshop_idx, nearest_target_pos = None, None\n  min_distance = float('inf')\n  pos = np.array(env._current_state.pos)\n\n  # Iterate through all workshops to find the closest one that can craft the item\n  for idx in workshop_indices:\n      # Check if this workshop can craft the desired item\n      recipe_workshops = cookbook.index[env.world.cookbook.recipes[goal_index]['workshop']]\n      if idx not in recipe_workshops:\n          continue\n\n      pos_list = np.argwhere(env._current_state.grid[:, :, idx])\n      if len(pos_list) > 0:  # Check if there is any location for the workshop\n          mean_pos = pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - mean_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx = idx\n              nearest_target_pos = pos_list[np.argmin([heuristic(mean_pos, target) for target in pos_list])]\n              min_distance = distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found that can craft the desired item\")\n\n  # Use A* to find the shortest path to the nearest target position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-09T07:06:17.055814", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Check which workshop(s) can craft the desired item\n  for idx, recipe in enumerate(cookbook.recipes):\n      if goal_index in recipe:\n          workshop_idx = cookbook.workshops[idx]\n          break\n  else:\n      raise ValueError(\"No workshop can craft the item\")\n\n  # Find all positions of the required workshop on the grid\n  pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n  if len(pos_list) == 0:  # Check if there is any location for the workshop\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards using mean position of all workshops\n  workshop_pos_mean = pos_list.mean(axis=0)\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for target_pos in pos_list:\n      distance = heuristic(pos, target_pos)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n