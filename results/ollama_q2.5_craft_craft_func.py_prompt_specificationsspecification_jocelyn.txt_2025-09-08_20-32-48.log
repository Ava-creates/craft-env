{"timestamp": "2025-09-09T02:01:25.169355", "function_name": "craft", "function_body": "  def get_closest_position(current_pos, target_positions):\n      min_distance = float('inf')\n      closest_pos = None\n      for pos in target_positions:\n          distance = np.linalg.norm(np.array(pos) - current_pos)\n          if distance < min_distance:\n              min_distance = distance\n              closest_pos = pos\n      return closest_pos\n\n  def get_direction(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      direction_priority = [(3, (1, 0)), (2, (-1, 0)), (1, (0, 1)), (0, (0, -1))]\n      for dir_idx, (dx_adj, dy_adj) in direction_priority:\n          if dx == dx_adj and dy == dy_adj:\n              return dir_idx\n      # If exact direction not found, prioritize closer movement\n      abs_dx, abs_dy = abs(dx), abs(dy)\n      if abs_dx > abs_dy:\n          return 3 if dx > 0 else 2\n      elif abs_dx < abs_dy:\n          return 1 if dy > 0 else 0\n      # If distances are equal, choose a direction randomly or based on preference\n      return np.random.choice([3 if dx > 0 else 2, 1 if dy > 0 else 0])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  current_pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) > 0:  # Check if there are any locations for the workshop\n          # Find the closest position to move towards\n          nearest_target_pos = get_closest_position(current_pos, workshop_positions)\n          distance = np.linalg.norm(nearest_target_pos - current_pos)\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = get_closest_position(current_pos, target_positions)\n\n  # Move to the closest workshop position\n  while not np.array_equal(current_pos, nearest_target_pos):\n      direction = get_direction(current_pos, nearest_target_pos)\n      actions.append(direction)\n      current_pos += [1 if direction in [3] else -1 if direction in [2] else 0,\n                      1 if direction in [1] else -1 if direction in [0] else 0]\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 5.2}}
