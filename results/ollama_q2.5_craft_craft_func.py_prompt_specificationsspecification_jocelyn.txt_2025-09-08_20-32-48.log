{"timestamp": "2025-09-09T07:43:26.831957", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  def move_towards(pos, target_pos, actions):\n      \"\"\"Move the agent towards the target position.\"\"\"\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return pos\n\n  def find_closest_workshop(goal_index):\n      \"\"\"Find the closest workshop that can craft the desired item.\"\"\"\n      workshop_indices = env.world.workshop_indices\n      actions = []\n      pos = np.array(env._current_state.pos)\n\n      # Find the closest workshop that can craft the desired item\n      closest_workshop_idx, min_distance = None, float('inf')\n\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n      if closest_workshop_idx is None:\n          raise ValueError(\"No available workshop found\")\n\n      # Calculate the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n      return closest_workshop_idx, nearest_target_pos\n\n  def get_recipe_ingredients(goal_index):\n      \"\"\"Get the list of ingredients required to craft the item.\"\"\"\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[goal_index]\n      ingredients = [ingredient for ingredient in recipe if not isinstance(ingredient, str) and ingredient >= 0]\n      return ingredients\n\n  def check_inventory_for_ingredients(ingredients):\n      \"\"\"Check if all required ingredients are in the inventory.\"\"\"\n      current_state = env._current_state\n      for ingredient in ingredients:\n          if not current_state.inventory[ingredient] > 0:\n              return False\n      return True\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check if the required ingredients are available in the inventory\n  ingredients = get_recipe_ingredients(goal_index)\n  if not check_inventory_for_ingredients(ingredients):\n      raise ValueError(\"Required ingredients not available in the inventory\")\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, nearest_target_pos = find_closest_workshop(goal_index)\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Move to the closest workshop position\n  pos = move_towards(pos, nearest_target_pos, actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T07:45:12.389534", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n    return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  \n  # Get the current position of the agent\n  pos = np.array(env._current_state.pos)\n\n  min_distance, closest_workshop_idx, nearest_target_pos = float('inf'), None, None\n  \n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_mean = workshop_pos_list.mean(axis=0)\n          distance_to_workshop = heuristic(pos, tuple(workshop_mean))\n          \n          if distance_to_workshop < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = distance_to_workshop\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest target position among all workshops of that type\n  for target_pos in np.argwhere(env._current_state.grid[:, :, closest_workshop_idx]):\n      target_dist = heuristic(pos, tuple(target_pos))\n      \n      if nearest_target_pos is None or target_dist < min_distance:\n          nearest_target_pos = target_pos\n          min_distance = target_dist\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      if dir_x is not None:\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif dir_y is not None:\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T07:45:13.370620", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n    return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  min_distance, closest_workshop_idx, nearest_target_pos = float('inf'), None, None\n  \n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  \n          # Calculate mean position of all workshops\n          workshop_mean_pos = workshop_positions.mean(axis=0)\n          distance_to_workshop = heuristic(pos, tuple(workshop_mean_pos))\n          \n          if distance_to_workshop < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = distance_to_workshop\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest target position among all workshops of that type\n  for target_pos in np.argwhere(env._current_state.grid[:, :, closest_workshop_idx]):\n      target_dist = heuristic(pos, tuple(target_pos))\n      \n      if nearest_target_pos is None or target_dist < min_distance:\n          nearest_target_pos = target_pos\n          min_distance = target_dist\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  \n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      if dir_x is not None and env._current_state.grid[pos[0] + (1 if dx > 0 else -1), pos[1], env._current_state.env.world.workshop_indices[0]] == 1:\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif dir_y is not None and env._current_state.grid[pos[0], pos[1] + (1 if dy > 0 else -1), env._current_state.env.world.workshop_indices[0]] == 1:\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  \n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-09T07:47:04.561453", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = heuristic(pos, workshop_pos_mean)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, target_pos)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Check the direction to align with the workshop position before using it.\n  dx, dy = nearest_target_pos - pos\n  if dx != 0:\n      actions.append(3 if dx > 0 else 2)\n  elif dy != 0:\n      actions.append(1 if dy > 0 else 0)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T07:47:05.561147", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check the available workshops for crafting the item\n  workshop_indices = [idx for idx, recipe in enumerate(cookbook.recipes) if goal_index in recipe.get('produces', [])]\n  \n  if not workshop_indices:\n      raise ValueError(f\"No workshop can craft {item}\")\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = heuristic(pos, workshop_pos_mean)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, target_pos)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Align the agent's direction to face the workshop\n  dx, dy = nearest_target_pos - pos\n  if dx != 0:\n      actions.append(3 if dx > 0 else 2)\n  elif dy != 0:\n      actions.append(1 if dy > 0 else 0)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T07:47:53.010055", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          for wp in workshop_positions:\n              distance = np.linalg.norm(pos - wp, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = wp\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, target_workshop_pos):\n      dx, dy = target_workshop_pos - pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in, prioritize x-direction first\n      if dir_x is not None:\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif dir_y is not None:\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T07:47:53.995152", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          for wp in workshop_positions:\n              distance = np.linalg.norm(pos - wp, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = wp\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  path = astar_pathfinding(env._current_state.grid, pos, target_workshop_pos)\n\n  for p in path:\n      dx, dy = p - pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in, prioritize x-direction first\n      if dir_x is not None:\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif dir_y is not None:\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-09T07:49:04.265694", "function_name": "craft", "function_body": "  def move_to_position(pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          step = get_next_step(pos, target_pos)\n          if step is None:\n              break\n          direction = step[0]\n          # Convert relative movement to action index (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n          actions.append(3 if direction > 0 else (2 if direction < 0 else 1 if step[1] > 0 else 0))\n          pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0)] + [(0, np.sign(dy))] if dx != 0 else [(0, np.sign(dy))]\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          # Check if the next step is blocked by stone or water and skip those positions\n          if env._current_state.grid[int(new_pos[0]), int(new_pos[1]), env.world.stone_index] == 0 and \\\n             env._current_state.grid[int(new_pos[0]), int(new_pos[1]), env.world.water_index] == 0:\n              return d\n      return None\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:\n          # Calculate the mean position of all available workshops of this type\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T07:49:05.333934", "function_name": "craft", "function_body": "  def move_to_position(pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          step = get_next_step(pos, target_pos)\n          if step is None:\n              break\n          direction = step[0]\n          # Convert relative movement to action index (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n          actions.append(3 if direction > 0 else (2 if direction < 0 else 1 if step[1] > 0 else 0))\n          pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0)] + [(0, np.sign(dy))] if dx != 0 else [(0, np.sign(dy))]\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          # Check if the next step is blocked by stone or water and skip those positions\n          if not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index):\n              return d\n      return None\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:\n          # Calculate the mean position of all available workshops of this type\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T07:50:29.808979", "function_name": "craft", "function_body": "  def move_to_position(pos: np.ndarray, target_pos: np.ndarray):\n      path = astar_search(pos, target_pos)\n      actions = []\n      for step in path:\n          action = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}.get(tuple(step))\n          actions.append(action)\n      return actions\n\n  def astar_search(start: np.ndarray, goal: np.ndarray):\n      open_set = collections.deque([(start, [])])\n      closed_set = set()\n      while open_set:\n          current_pos, path = open_set.popleft()\n          if tuple(current_pos) == tuple(goal):\n              return path + [np.array(goal) - current_pos]\n          closed_set.add(tuple(current_pos))\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              next_pos = np.array(current_pos) + np.array((dx, dy))\n              if tuple(next_pos) not in closed_set and is_valid_move(next_pos):\n                  open_set.append((next_pos, path + [np.array(next_pos) - current_pos]))\n      return []\n\n  def is_valid_move(pos: np.ndarray):\n      # Check boundaries\n      if pos[0] < 0 or pos[0] >= env._current_state.grid.shape[0] or pos[1] < 0 or pos[1] >= env._current_state.grid.shape[1]:\n          return False\n      # Check for obstacles (stone and water)\n      if env._current_state.next_to(env.world.stone_index) or env._current_state.next_to(env.world.water_index):\n          return False\n      return True\n\n  def find_closest_workshop(goal_index: int, workshop_indices: list[int]):\n      pos = np.array(env._current_state.pos)\n      closest_target_pos = None\n      min_distance = float('inf')\n\n      for workshop_idx in workshop_indices:\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_positions) > 0:\n              # Calculate the mean position of all available workshops of this type\n              workshop_mean_pos = workshop_positions.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n\n              if distance < min_distance:\n                  closest_target_pos = min(workshop_positions, key=lambda x: np.linalg.norm(pos - x))\n                  min_distance = distance\n\n      return closest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest position to move towards among all workshops\n  nearest_target_pos = find_closest_workshop(goal_index, workshop_indices)\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-09T07:50:30.904924", "function_name": "craft", "function_body": "  def move_to_position(pos: np.ndarray, target_pos: np.ndarray):\n      path = find_path(pos, target_pos)\n      actions = []\n      for step in path:\n          action = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}.get(tuple(step))\n          actions.append(action)\n      return actions\n\n  def find_path(start_pos: np.ndarray, target_pos: np.ndarray):\n      \"\"\"Use BFS to find the shortest path.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set()\n      \n      while queue:\n          current_pos, path = queue.popleft()\n          \n          if np.array_equal(current_pos, target_pos):\n              return path\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              new_pos = current_pos + np.array((dx, dy))\n              \n              # Check boundaries and if the next position is blocked by stone or water\n              if not (0 <= new_pos[0] < env._current_state.grid.shape[0] and \n                      0 <= new_pos[1] < env._current_state.grid.shape[1]):\n                  continue\n              if env._current_state.next_to(env.world.stone_index) or env._current_state.next_to(env.world.water_index):\n                  continue\n\n              if tuple(new_pos) not in visited:\n                  visited.add(tuple(new_pos))\n                  queue.append((new_pos, path + [(dx, dy)]))\n\n      return []\n\n  def find_closest_workshop(goal_index: int, workshop_indices: list[int]) -> np.ndarray:\n      pos = np.array(env._current_state.pos)\n      closest_target_pos = None\n      min_distance = float('inf')\n\n      for workshop_idx in workshop_indices:\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_positions) > 0:\n              # Calculate the mean position of all available workshops of this type\n              workshop_mean_pos = workshop_positions.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n\n              if distance < min_distance:\n                  closest_target_pos = min(workshop_positions, key=lambda x: np.linalg.norm(pos - x))\n                  min_distance = distance\n\n      return closest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest position to move towards among all workshops\n  nearest_target_pos = find_closest_workshop(goal_index, workshop_indices)\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T07:51:55.493259", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if abs(dy) > abs(dx):\n          return 0 if dy < 0 else 1  # DOWN or UP\n      else:\n          return 2 if dx < 0 else 3  # LEFT or RIGHT\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = calculate_direction(dx, dy)\n      actions.append(direction)\n      pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T07:51:56.479573", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if abs(dy) > abs(dx):\n          return 0 if dy < 0 else 1  # DOWN or UP\n      else:\n          return 2 if dx < 0 else 3  # LEFT or RIGHT\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position using a more efficient pathfinding algorithm (A*)\n  def heuristic(a, b):\n      return np.abs(a[0] - b[0]) + np.abs(a[1] - b[1])\n\n  def astar(array, start, goal):\n      neighbors = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n\n      close_set = set()\n      came_from = {}\n      gscore = {start: 0}\n      fscore = {start: heuristic(start, goal)}\n      oheap = []\n\n      heapq.heappush(oheap, (fscore[start], start))\n\n      while oheap:\n          current = heapq.heappop(oheap)[1]\n\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data\n\n          close_set.add(current)\n          for i, j in neighbors:\n              neighbor = current[0] + i, current[1] + j\n              tentative_g_score = gscore[current] + heuristic(current, neighbor)\n              if 0 <= neighbor[0] < array.shape[0]:\n                  if 0 <= neighbor[1] < array.shape[1]:\n                      if array[neighbor[0]][neighbor[1]] == 0:\n                          continue\n                  else:\n                      # array bound y walls\n                      continue\n              else:\n                  # array bound x walls\n                  continue\n\n              if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                  continue\n\n              if tentative_g_score < gscore.get(neighbor, 0) or neighbor not in [i[1] for i in oheap]:\n                  came_from[neighbor] = current\n                  gscore[neighbor] = tentative_g_score\n                  fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  heapq.heappush(oheap, (fscore[neighbor], neighbor))\n\n      return False\n\n  path = astar(env._current_state.grid[:, :, closest_workshop_idx].astype(bool), tuple(pos), tuple(nearest_target_pos))\n  if path:\n      for point in path[:-1]:  # Exclude the last point as it is the target position\n          dx, dy = np.array(point) - pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-09T07:53:44.590934", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n    return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = heuristic(pos, workshop_pos_mean)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, target_pos)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      direction = np.arctan2(dy, dx)\n      if abs(direction) < np.pi/4 or abs(direction) > 3*np.pi/4:  # Move horizontally\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif direction > 0 and direction <= np.pi/4:  # Move up-right\n          actions.append(1)\n          pos[1] += 1\n      elif direction < 0 and direction >= -np.pi/4:  # Move down-right\n          actions.append(0)\n          pos[1] -= 1\n      elif direction > np.pi/4 and direction <= 3*np.pi/4:  # Move up\n          actions.append(1)\n          pos[1] += 1\n      else:  # Move down\n          actions.append(0)\n          pos[1] -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T07:53:45.649992", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n    return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  def find_path(start_pos, goal_pos):\n    open_set = set()\n    came_from = {}\n    g_score = {start_pos: 0}\n    f_score = {start_pos: heuristic(start_pos, goal_pos)}\n    open_set.add(start_pos)\n\n    while open_set:\n        current = min(open_set, key=lambda x: f_score[x])\n\n        if current == goal_pos:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            return path\n\n        open_set.remove(current)\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n            neighbor = (current[0] + dx, current[1] + dy)\n\n            if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n                0 <= neighbor[1] < env._current_state.grid.shape[1]):\n                tentative_g_score = g_score[current] + heuristic(current, neighbor)\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                    open_set.add(neighbor)\n\n    raise ValueError(\"No valid path found\")\n\n  def actions_to_target(start_pos, target_pos):\n    actions = []\n    pos = np.array(start_pos)\n    \n    path = find_path(tuple(pos), tuple(target_pos))\n    \n    for target in path:\n        dx, dy = np.array(target) - pos\n\n        # Determine direction to move in\n        if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n            actions.append(3 if dx > 0 else 2)\n            pos[0] += 1 if dx > 0 else -1\n        elif dy != 0:  # Then move in y-direction\n            actions.append(1 if dy > 0 else 0)\n            pos[1] += 1 if dy > 0 else -1\n\n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = heuristic(pos, workshop_pos_mean)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, target_pos)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(actions_to_target(tuple(pos), tuple(nearest_target_pos)))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T07:55:23.816100", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = heuristic(pos, tuple(workshop_pos_mean))\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[min(range(len(target_positions)), key=lambda i: heuristic(pos, tuple(target_positions[i])))]\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n 