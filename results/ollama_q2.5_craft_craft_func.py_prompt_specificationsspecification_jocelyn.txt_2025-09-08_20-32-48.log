se the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T08:24:40.268540", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check if the required ingredients are in the inventory\n  required_ingredients = cookbook.primitives(goal_index)\n  if not all(ingredient in env._current_state.inventory for ingredient in required_ingredients):\n      raise ValueError(\"Missing required ingredients\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = heuristic(pos, workshop_pos_mean)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, target_pos)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Align the agent with the workshop position before using it.\n  dx, dy = nearest_target_pos - pos\n  if abs(dx) > abs(dy):  # Prioritize aligning in x-direction first\n      actions.append(3 if dx > 0 else 2)\n      pos[0] += 1 if dx > 0 else -1\n  elif dy != 0:  # Then align in y-direction\n      actions.append(1 if dy > 0 else 0)\n      pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T08:24:41.300806", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the item to determine which workshop can craft it.\n  recipe = cookbook.primitives.get(goal_index)\n  if recipe is None or \"_workshop\" not in recipe:\n      raise ValueError(f\"No recipe found for {item} or no _workshop specified.\")\n\n  workshop_type = recipe[\"_workshop\"]\n  if workshop_type not in env.world.workshop_indices:\n      raise ValueError(f\"No index found for workshop type: {workshop_type}\")\n\n  workshop_idx = env.world.workshop_indices[workshop_type]\n\n  actions = []\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  pos = np.array(env._current_state.pos)\n  for target_pos in target_positions:\n      distance = heuristic(pos, target_pos)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop position found\")\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_start)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Align the agent with the workshop position before using it.\n  dx, dy = nearest_target_pos - pos\n  if abs(dx) > abs(dy):  # Prioritize aligning in x-direction first\n      actions.append(3 if dx > 0 else 2)\n      pos[0] += 1 if dx > 0 else -1\n  elif dy != 0:  # Then align in y-direction\n      actions.append(1 if dy > 0 else 0)\n      pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T08:25:54.402030", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  def move_towards(pos, target_pos, actions):\n      \"\"\"Move the agent towards the target position.\"\"\"\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return pos\n\n  def is_workshop_for_item(workshop_idx, goal_index):\n      \"\"\"Check if the workshop can craft the desired item.\"\"\"\n      for recipe in cookbook.recipes.values():\n          if \"_workshop\" in recipe and recipe[\"_workshop\"] == workshop_idx:\n              for ingredient, count in recipe.items():\n                  if ingredient == str(goal_index) or (ingredient.isdigit() and int(ingredient) == goal_index):\n                      return True\n      return False\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  current_state = env._current_state\n  pos = np.array(current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      if is_workshop_for_item(workshop_idx, goal_index):\n          workshop_pos_list = np.argwhere(current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  pos = move_towards(pos, nearest_target_pos, actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T08:25:55.555474", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  def move_towards(pos, target_pos, actions):\n      \"\"\"Move the agent towards the target position.\"\"\"\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  current_state = env._current_state\n  pos = np.array(current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = np.linalg.norm(pos - workshop_pos_list, ord=2, axis=1)\n          nearest_workshop_pos = workshop_pos_list[np.argmin(distances)]\n          distance = np.min(distances)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance, nearest_target_pos = workshop_idx, distance, nearest_workshop_pos\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  pos = move_towards(pos, nearest_target_pos, actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T08:27:41.188713", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  def get_path(start_pos, goal_pos):\n      open_set = set()\n      came_from = {}\n      g_score = {start_pos: 0}\n      f_score = {start_pos: heuristic(start_pos, goal_pos)}\n      open_set.add(start_pos)\n\n      while open_set:\n          current = min(open_set, key=lambda x: f_score[x])\n\n          if current == goal_pos:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              return path\n\n          open_set.remove(current)\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n              neighbor = (current[0] + dx, current[1] + dy)\n\n              if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n                  0 <= neighbor[1] < env._current_state.grid.shape[1]):\n                  tentative_g_score = g_score[current] + heuristic(current, neighbor)\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                      open_set.add(neighbor)\n\n      raise ValueError(\"No valid path found\")\n\n  def get_closest_workshop(item_index):\n      pos = np.array(env._current_state.pos)\n      workshop_indices = env.world.workshop_indices\n\n      closest_workshop_idx, min_distance = None, float('inf')\n\n      for workshop_idx in workshop_indices:\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = heuristic(pos, tuple(workshop_pos_mean))\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n      return closest_workshop_idx, min_distance\n\n  def get_nearest_target_position(workshop_idx):\n      pos = np.array(env._current_state.pos)\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n\n      for target_pos in target_positions:\n          distance = heuristic(pos, tuple(target_pos))\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n\n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_idx, _ = get_closest_workshop(goal_index)\n  nearest_target_pos = get_nearest_target_position(workshop_idx)\n\n  start_pos = tuple(np.array(env._current_state.pos))\n  goal_pos = tuple(nearest_target_pos)\n\n  path = get_path(start_pos, goal_pos)\n\n  actions = []\n  pos = np.array(start_pos)\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T08:27:42.370445", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = heuristic(pos, tuple(workshop_pos_mean))\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, tuple(target_pos))\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T08:28:58.465757", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Function to calculate the next step towards the target position while avoiding obstacles\n  def get_next_step(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      directions = []\n      if dx != 0:\n          directions.append((np.sign(dx), 0))  # move in x-direction\n      if dy != 0:\n          directions.append((0, np.sign(dy)))  # move in y-direction\n\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          if not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index):\n              return d\n      return None\n\n  # Move to the closest workshop position and avoid obstacles\n  while not np.array_equal(pos, nearest_target_pos):\n      step = get_next_step(pos, nearest_target_pos)\n      if step is None:\n          break  # No safe move available, exit loop\n      actions.append(3 if step[0] > 0 else (2 if step[0] < 0 else 1 if step[1] > 0 else 0))\n      pos += np.array(step)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T08:28:59.589303", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Function to calculate the next step towards the target position while avoiding obstacles\n  def get_next_step(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      directions = []\n      if dx != 0:\n          directions.append((np.sign(dx), 0))  # move in x-direction\n      if dy != 0:\n          directions.append((0, np.sign(dy)))  # move in y-direction\n\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          if not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index):\n              return d\n      return None\n\n  # Move to the closest workshop position and avoid obstacles\n  while not np.array_equal(pos, nearest_target_pos):\n      step = get_next_step(pos, nearest_target_pos)\n      if step is None:\n          break  # No safe move available, exit loop\n      actions.append(3 if step[0] > 0 else (2 if step[0] < 0 else 1 if step[1] > 0 else 0))\n      pos += np.array(step)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T08:35:11.343093", "function_name": "craft", "function_body": "  def move_to_position(current_pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          step = get_next_step(current_pos, target_pos)\n          if step is None:\n              break\n          direction = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}.get(tuple(step))\n          actions.append(direction)\n          current_pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      directions = [(np.sign(target_pos[0] - current_pos[0]), 0)] + [(0, np.sign(target_pos[1] - current_pos[1]))]\n      \n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          # Check for obstacles (stone or water)\n          nx, ny = int(new_pos[0]), int(new_pos[1])\n          if not env._current_state.grid[nx, ny, env.world.stone_index] and\\\n             not env._current_state.grid[nx, ny, env.world.water_index]:\n              return d\n      return None\n\n  def find_closest_workshop(goal_index, workshop_indices):\n      current_pos = np.array(env._current_state.pos)\n      closest_workshop_idx, min_distance = None, float('inf')\n      \n      for workshop_idx in workshop_indices:\n          # Find all positions of workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              distances = np.linalg.norm(current_pos - workshop_pos_list, axis=1)\n              nearest_workshop_pos = workshop_pos_list[np.argmin(distances)]\n              distance = np.linalg.norm(current_pos - nearest_workshop_pos)\n\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n      return closest_workshop_idx, min_distance\n  \n  def get_recipe_requirements(cookbook, goal_index):\n      # This function should parse the cookbook to find the ingredients required for the given item.\n      # For simplicity, we'll assume this information is available in some form.\n      # Here we just return a placeholder list of ingredient indices.\n      return []\n\n  def collect_primitives(env, required_primitives):\n      actions = []\n      current_state = env._current_state\n      \n      for primitive in required_primitives:\n          if not current_state.next_to(primitive):\n              target_positions = np.argwhere(current_state.grid[:, :, primitive])\n              if len(target_positions) > 0:\n                  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(np.array(current_state.pos) - x))\n                  actions.extend(move_to_position(np.array(current_state.pos), nearest_target_pos))\n                  actions.append(4)  # Collect the primitive using USE action\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Get the list of required primitives for crafting the item\n  required_primitives = get_recipe_requirements(cookbook, goal_index)\n  \n  # Collect all required primitives if not already in inventory\n  actions.extend(collect_primitives(env, required_primitives))\n  \n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = find_closest_workshop(goal_index, workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
