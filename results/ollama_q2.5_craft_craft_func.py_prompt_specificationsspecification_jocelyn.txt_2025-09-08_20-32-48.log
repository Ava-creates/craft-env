{"timestamp": "2025-09-09T09:49:46.918317", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  available_workshops = []\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          available_workshops.append((workshop_idx, workshop_pos_list))\n\n  if not available_workshops:\n      raise ValueError(\"No available workshops found\")\n\n  closest_workshop_info = min(available_workshops, key=lambda info: np.linalg.norm(pos - info[1].mean(axis=0), ord=2))\n  closest_workshop_idx, target_positions = closest_workshop_info\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Plan a path using A* algorithm\n  grid_shape = env._current_state.grid.shape[:2]\n  start = tuple(pos)\n  goal = tuple(nearest_target_pos)\n\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  def get_neighbors(node):\n      neighbors = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          x, y = node[0] + dx, node[1] + dy\n          if 0 <= x < grid_shape[0] and 0 <= y < grid_shape[1]:\n              neighbors.append((x, y))\n      return neighbors\n\n  open_set = collections.PriorityQueue()\n  came_from = {}\n  g_score = {start: 0}\n  f_score = {start: heuristic(start, goal)}\n\n  open_set.put((f_score[start], start))\n\n  while not open_set.empty():\n      _, current = open_set.get()\n\n      if current == goal:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          return [calculate_direction(x - pos[0], y - pos[1]) for x, y in path]\n\n      for neighbor in get_neighbors(current):\n          tentative_g_score = g_score.get(start, float('inf')) + 1\n\n          if tentative_g_score < g_score.get(neighbor, float('inf')):\n              came_from[neighbor] = current\n              g_score[neighbor] = tentative_g_score\n              f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              open_set.put((f_score[neighbor], neighbor))\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T09:49:47.898714", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Check which workshops have the required recipe for the item\n  available_workshops = []\n\n  for workshop_idx in workshop_indices:\n      if goal_index in cookbook.recipes and any(workshop_idx == ingredient for ingredient in cookbook.recipes[goal_index]):\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              available_workshops.append((workshop_idx, workshop_pos_list))\n\n  if not available_workshops:\n      raise ValueError(\"No available workshops found with required recipe\")\n\n  closest_workshop_info = min(available_workshops, key=lambda info: np.linalg.norm(pos - info[1].mean(axis=0), ord=2))\n  closest_workshop_idx, target_positions = closest_workshop_info\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = calculate_direction(dx, dy)\n      actions.append(direction)\n      pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-09T09:50:44.779240", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if abs(dy) > abs(dx):\n          return 0 if dy < 0 else 1\n      else:\n          return 2 if dx < 0 else 3\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = np.linalg.norm(pos - workshop_pos_list, ord=2, axis=1)\n          nearest_workshop_pos = workshop_pos_list[np.argmin(distances)]\n          distance = distances.min()\n          if distance < min_distance:\n              closest_workshop_idx, min_distance, nearest_target_pos = workshop_idx, distance, nearest_workshop_pos\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = calculate_direction(dx, dy)\n      actions.append(direction)\n      pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 5.2}}
