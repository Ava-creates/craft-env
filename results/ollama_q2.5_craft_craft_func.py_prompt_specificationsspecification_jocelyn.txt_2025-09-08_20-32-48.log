heck if the workshop is usable (e.g., no obstacles in front of it)\n  # This step ensures that the agent can actually use the workshop once it reaches the position\n  if env._current_state.next_to_workshop(closest_workshop_idx):\n      actions.append(4)  # USE\n  else:\n      raise ValueError(\"Workshop is not usable\")\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
