{"timestamp": "2025-09-09T04:51:59.915207", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position while avoiding obstacles\n  def is_clear(x: int, y: int) -> bool:\n      \"\"\"Check if a cell is clear (not blocked).\"\"\"\n      return np.all(env._current_state.grid[x, y] == 0)\n\n  path = a_star(pos, nearest_target_pos, is_clear)\n  for step in path[1:]:  # Start from the second element to skip current position\n      dx, dy = step - pos\n      direction = calculate_direction(dx, dy)\n      actions.append(direction)\n      pos = np.array(step)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-09T04:53:10.108956", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  def calculate_actions_to_target(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          current_pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  def find_closest_workshop(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              distances = np.linalg.norm(pos - workshop_pos_list, axis=1)\n              nearest_workshop_pos = workshop_pos_list[np.argmin(distances)]\n              distance = np.linalg.norm(nearest_workshop_pos - pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  def find_target_position(workshop_idx):\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(np.array(env._current_state.pos) - tp, ord=2) for tp in target_positions])]\n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  closest_workshop_idx = find_closest_workshop(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = find_target_position(closest_workshop_idx)\n\n  actions.extend(calculate_actions_to_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T04:53:11.175397", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if abs(dx) > abs(dy):\n          return 3 if dx > 0 else 2\n      else:\n          return 1 if dy > 0 else 0\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          current_pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  def find_closest_workshop(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:\n              nearest_workshop_pos = workshop_pos_list[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in workshop_pos_list])]\n              distance = np.linalg.norm(nearest_workshop_pos - pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  closest_workshop_idx = find_closest_workshop(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T04:54:12.229422", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for recipe_output, recipe in cookbook.recipes.items():\n      if goal_index == recipe_output:\n          for ingredient_or_key, count in recipe.items():\n              if isinstance(ingredient_or_key, str) and ingredient_or_key.startswith(\"_key\"):\n                  key_name = ingredient_or_key[5:]  # remove \"_key\" prefix\n                  workshop_idx = cookbook.index[key_name]\n                  if workshop_idx in workshop_indices:\n                      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n                      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n                          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n                          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n                          if distance < min_distance:\n                              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = calculate_direction(dx, dy)\n      actions.append(direction)\n      pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-09T04:54:13.305725", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest available workshop for crafting the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = calculate_direction(dx, dy)\n      actions.append(direction)\n      pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T04:55:08.858596", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          for wp in workshop_positions:\n              distance = np.linalg.norm(pos - wp, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = wp\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, target_workshop_pos):\n      dx, dy = target_workshop_pos - pos\n      direction = [dx, dy]\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) >= abs(dx):\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T04:55:09.826796", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          for wp in workshop_positions:\n              distance = np.linalg.norm(pos - wp, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = wp\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Function to get the path using A* algorithm\n  def astar(start, goal):\n      open_set = collections.deque([start])\n      came_from = {}\n      g_score = {tuple(start): 0}\n      f_score = {tuple(start): min_distance}\n\n      while open_set:\n          current = open_set.popleft()\n          if np.array_equal(current, goal):\n              path = []\n              while tuple(current) in came_from:\n                  path.append(tuple(current))\n                  current = came_from[tuple(current)]\n              return path[::-1]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = np.array((current[0] + dx, current[1] + dy))\n              tentative_g_score = g_score[tuple(current)] + 1\n\n              if not env.world.is_valid_position(neighbor):\n                  continue\n\n              if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n                  came_from[tuple(neighbor)] = current\n                  g_score[tuple(neighbor)] = tentative_g_score\n                  f_score[tuple(neighbor)] = tentative_g_score + np.linalg.norm(goal - neighbor, ord=2)\n                  open_set.append(tuple(neighbor))\n      return []\n\n  # Get the path to the closest workshop position using A* algorithm\n  path = astar(pos, target_workshop_pos)\n\n  if not path:\n      raise ValueError(\"No valid path found\")\n\n  for step in path:\n      dx, dy = step - pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in, prioritize x-direction first\n      if dir_x is not None:\n          actions.append(dir_x)\n      elif dir_y is not None:\n          actions.append(dir_y)\n      pos = step\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-09T04:56:29.145167", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          step = get_next_step(current_pos, target_pos)\n          if step is None:\n              break\n          direction = step[0]\n          action = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}.get(tuple(step))\n          actions.append(action)\n          current_pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0)] + [(0, np.sign(dy))] if dx != 0 else [(0, np.sign(dy))]\n      \n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          # Check for obstacles and boundaries\n          x, y = int(new_pos[0]), int(new_pos[1])\n          if (0 <= x < env._current_state.grid.shape[0] and 0 <= y < env._current_state.grid.shape[1]) and \\\n             env._current_state.grid[x, y, env.world.stone_index] == 0 and \\\n             env._current_state.grid[x, y, env.world.water_index] == 0:\n              return d\n      return None\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T04:56:30.270940", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          step = get_next_step(current_pos, target_pos)\n          if step is None:\n              break\n          direction = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}.get(tuple(step))\n          actions.append(direction)\n          current_pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0)] + [(0, np.sign(dy))] if dx != 0 else [(0, np.sign(dy))]\n      \n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          # Check for obstacles\n          if env._current_state.grid[int(new_pos[0]), int(new_pos[1]), env.world.stone_index] == 0 and\\\n             env._current_state.grid[int(new_pos[0]), int(new_pos[1]), env.world.water_index] == 0:\n              return d\n      return None\n\n  def find_closest_workshop(goal_index, workshop_indices):\n      current_pos = np.array(env._current_state.pos)\n      closest_workshop_idx, min_distance = None, float('inf')\n      \n      for workshop_idx in workshop_indices:\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(current_pos - workshop_pos_mean, ord=2)\n\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n      return closest_workshop_idx, min_distance\n  \n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = find_closest_workshop(goal_index, workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T04:58:09.438510", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, target_pos)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T04:58:10.411707", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = heuristic(pos, tuple(workshop_pos_mean))\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, tuple(target_pos))\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
