{"timestamp": "2025-09-09T07:39:17.879959", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  def find_closest_workshop(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          # Simulate movement by updating the position based on direction\n          new_pos = current_pos + np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n          \n          # Check if the move is valid\n          if env._current_state.next_state(new_pos).is_valid():\n              actions.append(direction)\n              current_pos = new_pos\n      return actions\n\n  closest_workshop_idx = find_closest_workshop(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-09T07:40:55.394138", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  def move_towards(pos, target_pos, actions):\n      \"\"\"Move the agent towards the target position.\"\"\"\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return pos\n\n  def find_closest_workshop(item_index: int, workshop_indices: list[int]) -> tuple[int, int]:\n      \"\"\"Find the closest workshop that can craft the desired item.\"\"\"\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index]\n      \n      min_distance = float('inf')\n      closest_workshop_idx = None\n      nearest_target_pos = None\n      \n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              target_positions = []\n              for pos in workshop_pos_list:\n                  if all(ingredient in env._current_state.grid[pos[0], pos[1]] for ingredient in recipe):\n                      target_positions.append(pos)\n              \n              if len(target_positions) > 0:  # Check if there are valid positions to interact\n                  nearest_tp = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n                  distance = np.linalg.norm(pos - nearest_tp, ord=2)\n                  if distance < min_distance:\n                      closest_workshop_idx, min_distance, nearest_target_pos = workshop_idx, distance, nearest_tp\n      \n      return closest_workshop_idx, nearest_target_pos\n\n  def check_item_crafted(item_index: int, pos: tuple[int, int]) -> bool:\n      \"\"\"Check if the item is already crafted at the given position.\"\"\"\n      grid = env._current_state.grid\n      return grid[pos[0], pos[1], item_index]\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item and the nearest valid position to interact\n  closest_workshop_idx, nearest_target_pos = find_closest_workshop(goal_index, workshop_indices)\n\n  if closest_workshop_idx is None or nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  pos = move_towards(pos, nearest_target_pos, actions)\n\n  # Check if the item is already crafted\n  if not check_item_crafted(goal_index, nearest_target_pos):\n      actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T07:40:56.426643", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if abs(dx) > abs(dy):\n          return 3 if dx > 0 else 2  # RIGHT or LEFT\n      else:\n          return 1 if dy > 0 else 0  # UP or DOWN\n\n  def move_towards(pos, target_pos, actions):\n      \"\"\"Move the agent towards the target position.\"\"\"\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return pos\n\n  def find_closest_workshop(item_index: int, workshop_indices: list[int]) -> int:\n      \"\"\"Find the closest workshop that can craft the desired item.\"\"\"\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index]\n      \n      possible_workshops = []\n      for idx in workshop_indices:\n          if any(ingredient in recipe for ingredient in recipe):\n              possible_workshops.append(idx)\n      \n      min_distance = float('inf')\n      closest_workshop_idx = None\n      \n      for workshop_idx in possible_workshops:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      \n      return closest_workshop_idx\n\n  def find_closest_position_to_use(workshop_idx: int) -> tuple[int, int]:\n      \"\"\"Find the closest position to interact with a workshop.\"\"\"\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      pos = env._current_state.pos\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n      return nearest_target_pos\n\n  def check_item_availability_at_workshop(item_index: int, workshop_idx: int) -> bool:\n      \"\"\"Check if the item is already crafted at the workshop.\"\"\"\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index]\n      \n      # Assuming that the presence of all ingredients indicates the item can be crafted\n      return not any(env._current_state.grid[tp[0], tp[1], ingredient] for tp in np.argwhere(env._current_state.grid[:, :, workshop_idx]) for ingredient in recipe)\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx = find_closest_workshop(goal_index, workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = find_closest_position_to_use(closest_workshop_idx)\n\n  # Move to the closest workshop position\n  pos = move_towards(pos, nearest_target_pos, actions)\n\n  # Check if the item is already crafted at the workshop before using it\n  if not check_item_availability_at_workshop(goal_index, closest_workshop_idx):\n      actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
