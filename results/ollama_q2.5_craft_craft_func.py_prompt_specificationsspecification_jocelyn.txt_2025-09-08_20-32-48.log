ce\n\n      return closest_workshop_idx, min_distance\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, _ = find_closest_workshop(goal_index)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(np.array(env._current_state.pos) - x))\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T08:38:10.121324", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          for wp in workshop_positions:\n              distance = np.linalg.norm(pos - wp, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = wp\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Use a more efficient pathfinding approach to reach the closest workshop position\n  def bfs_shortest_path(grid, start, end):\n      queue = collections.deque([(start, [])])\n      visited = set()\n      \n      while queue:\n          (x, y), path = queue.popleft()\n          \n          if (x, y) == end:\n              return path\n      \n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  queue.append(((nx, ny), path + [(dx, dy)]))\n      return []\n\n  shortest_path = bfs_shortest_path(env._current_state.grid[:, :, goal_index], tuple(pos), tuple(target_workshop_pos))\n\n  if not shortest_path:\n      raise ValueError(\"No reachable path to the workshop found\")\n\n  # Translate direction differences to actions\n  for dx, dy in shortest_path:\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # DOWN\n      elif dy < 0:\n          actions.append(0)  # UP\n\n  # Ensure the agent faces the workshop before using it\n  target_direction = np.sign(target_workshop_pos - pos)\n  if target_direction[0] != 0:  # Prioritize x-direction first\n      if target_direction[0] > 0:\n          actions.append(3)  # RIGHT\n      else:\n          actions.append(2)  # LEFT\n  elif target_direction[1] != 0:\n      if target_direction[1] > 0:\n          actions.append(1)  # DOWN\n      else:\n          actions.append(0)  # UP\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": 0.7}}
{"timestamp": "2025-09-09T08:38:11.198102", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          for wp in workshop_positions:\n              distance = np.linalg.norm(pos - wp, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = wp\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Use a more efficient pathfinding approach to reach the closest workshop position\n  def bfs_shortest_path(grid, start, end):\n      queue = collections.deque([(start, [])])\n      visited = set()\n      \n      while queue:\n          (x, y), path = queue.popleft()\n          \n          if (x, y) == end:\n              return path\n      \n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  queue.append(((nx, ny), path + [(dx, dy)]))\n      return []\n\n  shortest_path = bfs_shortest_path(env._current_state.grid[:, :, goal_index], tuple(pos), tuple(target_workshop_pos))\n\n  if not shortest_path:\n      raise ValueError(\"No reachable path to the workshop found\")\n\n  # Translate direction differences to actions\n  for dx, dy in shortest_path:\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # DOWN\n      elif dy < 0:\n          actions.append(0)  # UP\n\n  # Rotate to face the workshop before using it\n  current_dir = env._current_state.dir  # Assuming the state has a direction attribute\n  target_pos = np.array(target_workshop_pos)\n  dx, dy = target_pos - pos\n  \n  if abs(dx) >= abs(dy):\n      if dx > 0:\n          new_dir = 3  # RIGHT\n      else:\n          new_dir = 2  # LEFT\n  else:\n      if dy > 0:\n          new_dir = 1  # DOWN\n      else:\n          new_dir = 0  # UP\n\n  if current_dir != new_dir:\n      actions.append(new_dir)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": 2.7}}
{"timestamp": "2025-09-09T08:39:07.206571", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = calculate_direction(dx, dy)\n      actions.append(direction)\n      pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T08:39:08.266294", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  available_workshops = []\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          available_workshops.append((workshop_idx, workshop_pos_list))\n\n  if not available_workshops:\n      raise ValueError(\"No available workshops found\")\n\n  closest_workshop_info = min(available_workshops, key=lambda info: np.linalg.norm(pos - info[1].mean(axis=0), ord=2))\n  closest_workshop_idx, target_positions = closest_workshop_info\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = calculate_direction(dx, dy)\n      actions.append(direction)\n      pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T08:40:21.431507", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  def move_to_target(pos, target_pos) -> list[int]:\n      \"\"\"Move the agent to the target position.\"\"\"\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the recipe for the item to determine required workshops\n  recipe = cookbook.recipes.get(goal_index, {})\n  workshop_indices_required = set()\n\n  for ingredient_idx in recipe.keys():\n      # Determine the workshop type required for this ingredient\n      workshop_type = cookbook.workshop_types.get(ingredient_idx, None)\n      if workshop_type is not None:\n          workshop_indices_required.add(workshop_type)\n\n  # Get available workshops in the environment\n  workshop_indices_available = env.world.workshop_indices\n\n  # Filter available workshops to only those that can craft the required ingredients\n  usable_workshops = [idx for idx in workshop_indices_available if idx in workshop_indices_required]\n\n  if not usable_workshops:\n      raise ValueError(\"No usable workshops found for crafting the item\")\n\n  current_state = env._current_state\n  pos = np.array(current_state.pos)\n  actions = []\n\n  # Find the closest usable workshop\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in usable_workshops:\n      workshop_pos_list = np.argwhere(current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
