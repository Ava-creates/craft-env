{"timestamp": "2025-09-09T03:29:33.674512", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* pathfinding algorithm\n  open_list = []\n  closed_set = set()\n  g_costs = {tuple(pos): 0}\n  f_costs = {tuple(pos): np.linalg.norm(nearest_target_pos - pos, ord=2)}\n  came_from = {}\n\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(b) - np.array(a), ord=2)\n\n  heapq.heappush(open_list, (f_costs[tuple(pos)], tuple(pos)))\n\n  while open_list:\n      current_f_cost, current_pos_tuple = heapq.heappop(open_list)\n      current_pos = np.array(current_pos_tuple)\n\n      if np.array_equal(current_pos, nearest_target_pos):\n          break\n\n      closed_set.add(tuple(current_pos))\n\n      neighbors = [(current_pos[0] + 1, current_pos[1]),\n                   (current_pos[0] - 1, current_pos[1]),\n                   (current_pos[0], current_pos[1] + 1),\n                   (current_pos[0], current_pos[1] - 1)]\n\n      for neighbor in neighbors:\n          if tuple(neighbor) in closed_set or not env._current_state.grid[neighbor[0], neighbor[1], closest_workshop_idx]:\n              continue\n\n          tentative_g_cost = g_costs[tuple(current_pos)] + 1\n\n          if tuple(neighbor) not in g_costs or tentative_g_cost < g_costs[tuple(neighbor)]:\n              came_from[tuple(neighbor)] = tuple(current_pos)\n              g_costs[tuple(neighbor)] = tentative_g_cost\n              f_costs[tuple(neighbor)] = tentative_g_cost + heuristic(tuple(neighbor), nearest_target_pos)\n              if tuple(neighbor) not in [item[1] for item in open_list]:\n                  heapq.heappush(open_list, (f_costs[tuple(neighbor)], tuple(neighbor)))\n\n  # Reconstruct path\n  current_pos_tuple = tuple(nearest_target_pos)\n  while current_pos_tuple != tuple(pos):\n      previous_pos_tuple = came_from[current_pos_tuple]\n      dx = previous_pos_tuple[0] - current_pos_tuple[0]\n      dy = previous_pos_tuple[1] - current_pos_tuple[1]\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      else:\n          actions.append(0)  # DOWN\n\n      current_pos_tuple = previous_pos_tuple\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-09T03:29:34.791686", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n      else:  # If distances are equal, choose a direction randomly or based on preference\n          direction = np.random.choice([3 if dx > 0 else 2, 1 if dy > 0 else 0])\n          actions.append(direction)\n          if direction in [3, 2]:\n              pos[0] += 1 if dx > 0 else -1\n          else:\n              pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-09T03:30:46.912900", "function_name": "craft", "function_body": "  def move_to_position(pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          step = get_next_step(pos, target_pos)\n          if step is None:\n              break\n          actions.append(3 if step[0] > 0 else (2 if step[0] < 0 else 1 if step[1] > 0 else 0))\n          pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0)] + [(0, np.sign(dy))] if dx != 0 else [(0, np.sign(dy))]\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          if not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index):\n              return d\n      return None\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0: # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T03:30:48.056525", "function_name": "craft", "function_body": "  def move_to_position(pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          step = get_next_step(pos, target_pos)\n          if step is None:\n              break\n          actions.append(3 if step[0] > 0 else (2 if step[0] < 0 else 1 if step[1] > 0 else 0))\n          pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      # Determine the direction to move based on differences in x and y coordinates\n      dx, dy = target_pos - current_pos\n      directions = []\n      if dx != 0:\n          directions.append((np.sign(dx), 0))  # Move horizontally towards the target\n      if dy != 0:\n          directions.append((0, np.sign(dy)))  # Move vertically towards the target\n\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          # Check if moving to this position would not result in being next to an obstacle\n          if (not env._current_state.next_to(env.world.stone_index) and \n              not env._current_state.next_to(env.world.water_index)):\n              return d\n      return None  # No safe move available\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Get all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Ensure there are positions available\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest specific position of the closest workshop\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T03:32:17.998413", "function_name": "craft", "function_body": "  def move_to_position(current_pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          step = get_next_step(current_pos, target_pos)\n          if step is None:\n              break\n          action = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}.get(tuple(step))\n          actions.append(action)\n          current_pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0)] + [(0, np.sign(dy))] if dx != 0 else [(0, np.sign(dy))]\n      \n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          # Check if the next position is not blocked by stone or water\n          if (not env._current_state.grid[new_pos[0], new_pos[1], env.world.stone_index] and \n              not env._current_state.grid[new_pos[0], new_pos[1], env.world.water_index]):\n              return d\n      return None\n\n  def find_closest_workshop(goal_index: int, workshop_indices: list[int]) -> np.ndarray:\n      pos = np.array(env._current_state.pos)\n      closest_target_pos = None\n      min_distance = float('inf')\n      \n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:\n              nearest_workshop_pos = min(\n                  workshop_pos_list, key=lambda x: np.linalg.norm(pos - x))\n              distance = np.linalg.norm(pos - nearest_workshop_pos)\n              if distance < min_distance:\n                  closest_target_pos = nearest_workshop_pos\n                  min_distance = distance\n      \n      return closest_target_pos\n\n  def get_required_primitives(cookbook, goal_index):\n      \"\"\"Return a list of required primitives to craft the item.\"\"\"\n      required_primitives = []\n      \n      for primitive in cookbook.primitives:\n          if cookbook.prerequisites[goal_index][primitive] > 0:\n              required_primitives.append(primitive)\n      \n      return required_primitives\n\n  def collect_primitive(env, primitive):\n      \"\"\"Return a list of actions to collect the specified primitive.\"\"\"\n      pos = np.array(env._current_state.pos)\n      target_pos_list = np.argwhere(env._current_state.grid[:, :, env.world.cookbook.index[primitive]])\n      \n      if len(target_pos_list) == 0:\n          raise ValueError(f\"No available {primitive} found\")\n      \n      nearest_target_pos = min(\n          target_pos_list, key=lambda x: np.linalg.norm(pos - x))\n      \n      actions = move_to_position(pos, nearest_target_pos)\n      actions.append(4)  # USE\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  required_primitives = get_required_primitives(cookbook, goal_index)\n  \n  actions = []\n  \n  # Collect all required primitives first\n  for primitive in required_primitives:\n      actions.extend(collect_primitive(env, primitive))\n  \n  # Find the closest workshop position that can craft the desired item\n  target_pos = find_closest_workshop(goal_index, workshop_indices)\n\n  if target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position and avoid obstacles\n  actions.extend(move_to_position(pos, target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-09T03:32:18.960924", "function_name": "craft", "function_body": "  def move_to_position(current_pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          step = get_next_step(current_pos, target_pos)\n          if step is None:\n              break\n          action = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}.get(tuple(step))\n          actions.append(action)\n          current_pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0)] + [(0, np.sign(dy))] if dx != 0 else [(0, np.sign(dy))]\n      \n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          # Check if the next position is not blocked by stone or water\n          if (not env._current_state.grid[new_pos[0], new_pos[1], env.world.stone_index] and \n              not env._current_state.grid[new_pos[0], new_pos[1], env.world.water_index]):\n              return d\n      return None\n\n  def find_closest_workshop(goal_index: int, workshop_indices: list[int]) -> np.ndarray:\n      pos = np.array(env._current_state.pos)\n      closest_target_pos = None\n      min_distance = float('inf')\n      \n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:\n              nearest_workshop_pos = min(\n                  workshop_pos_list, key=lambda x: np.linalg.norm(pos - x))\n              distance = np.linalg.norm(pos - nearest_workshop_pos)\n              if distance < min_distance:\n                  closest_target_pos = nearest_workshop_pos\n                  min_distance = distance\n      \n      return closest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = [idx for idx in env.world.workshop_indices \n                      if cookbook.recipes[goal_index].get(idx, 0) > 0]\n  \n  if not workshop_indices:\n      raise ValueError(f\"No workshops found that can craft the {item}\")\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop position that can craft the desired item\n  target_pos = find_closest_workshop(goal_index, workshop_indices)\n\n  if target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position and avoid obstacles\n  actions.extend(move_to_position(pos, target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-09T03:34:09.684005", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the workshop index that can craft the desired item\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Check which workshop indices are relevant for crafting this item\n  relevant_workshop_indices = set()\n\n  for recipe in cookbook.recipes:\n      if goal_index == recipe.output_item_index and any(index in workshop_indices for index in recipe.workshop_indices):\n          relevant_workshop_indices.update(recipe.workshop_indices & set(workshop_indices))\n          break\n\n  if not relevant_workshop_indices:\n      raise ValueError(\"No available workshop found that can craft this item\")\n\n  # Find the closest workshop of the relevant type\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in relevant_workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = heuristic(pos, tuple(workshop_pos_mean))\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, tuple(target_pos))\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-09T03:34:10.676142", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic for A* pathfinding.\"\"\"\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check if the item can be crafted with the current inventory\n  recipe = cookbook.recipes.get(goal_index)\n  if recipe is None or not all(item in env._current_state.inventory for item in recipe):\n      raise ValueError(f\"Missing ingredients to craft {item}\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = heuristic(pos, tuple(workshop_pos_mean))\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = heuristic(pos, tuple(target_pos))\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_target_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-09T03:36:10.297520", "function_name": "craft", "function_body": "  def is_safe_to_move(current_pos):\n    \"\"\"\n    Check if it's safe to move into a given position.\n    \n    Args:\n        current_pos (np.ndarray): The current position of the agent.\n\n    Returns:\n        bool: True if it's safe to move, False otherwise.\n    \"\"\"\n    # Ensure not next to stone or water\n    return not env._current_state.next_to(env.world.stone_index) and\\\n           not env._current_state.next_to(env.world.water_index)\n\n  def bfs_shortest_path(start, goal):\n    \"\"\"\n    Perform a Breadth-First Search (BFS) to find the shortest path from start to goal.\n    \n    Args:\n        start (tuple): The starting position.\n        goal (tuple): The goal position.\n\n    Returns:\n        list: A list of positions representing the shortest path from start to goal.\n    \"\"\"\n    queue = collections.deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      current = queue.popleft()\n\n      # Check if we reached the goal\n      if current == goal:\n        path = []\n        while current is not None:\n          path.append(current)\n          current = parent[current]\n        return path[::-1]  # Return reversed path for correct order\n\n      visited.add(current)\n\n      # Explore neighbors in all four directions (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n\n        # Check if the neighbor is safe to move into and hasn't been visited\n        if is_safe_to_move(np.array(neighbor)) and neighbor not in visited:\n          queue.append(neighbor)\n          parent[neighbor] = current\n\n    return None  # No path found\n\n  def get_direction(current_pos, next_pos):\n    \"\"\"\n    Determine the direction to move from the current position to the next position.\n    \n    Args:\n        current_pos (tuple): The current position of the agent.\n        next_pos (tuple): The next position in the path.\n\n    Returns:\n        int: The action index corresponding to the direction to move.\n             0 - DOWN\n             1 - UP\n             2 - LEFT\n             3 - RIGHT\n    \"\"\"\n    dx = next_pos[0] - current_pos[0]\n    dy = next_pos[1] - current_pos[1]\n\n    if dx > 0:\n      return 3  # RIGHT\n    elif dx < 0:\n      return 2  # LEFT\n    elif dy > 0:\n      return 1  # UP\n    elif dy < 0:\n      return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n    # Calculate the mean position of all workshops of this type\n    workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n    if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n      workshop_pos_mean = tuple(workshop_pos_list.mean(axis=0))\n      distance = np.linalg.norm(np.array(pos) - np.array(workshop_pos_mean), ord=2)\n\n      if distance < min_distance:\n        closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = tuple(target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))])\n\n  # Find the shortest path to the closest workshop position while avoiding obstacles\n  path = bfs_shortest_path(pos, nearest_target_pos)\n\n  if not path:\n    raise ValueError(\"No safe path found\")\n\n  for step in path[1:]:  # Skip the starting point\n    actions.append(get_direction(pos, step))\n    pos = step\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T03:36:11.654034", "function_name": "craft", "function_body": "  def is_safe_to_move(current_pos):\n    \"\"\"\n    Check if it's safe to move into a given position.\n    \n    Args:\n        current_pos (np.ndarray): The current position of the agent.\n\n    Returns:\n        bool: True if it's safe to move, False otherwise.\n    \"\"\"\n    # Ensure not next to stone or water\n    return not env._current_state.next_to(env.world.stone_index) and\\\n           not env._current_state.next_to(env.world.water_index)\n\n  def bfs_shortest_path(start, goal):\n    \"\"\"\n    Perform a Breadth-First Search (BFS) to find the shortest path from start to goal.\n    \n    Args:\n        start (tuple): The starting position.\n        goal (tuple): The goal position.\n\n    Returns:\n        list: A list of positions representing the shortest path from start to goal.\n    \"\"\"\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current = queue.popleft()\n\n      # Check if we reached the goal\n      if tuple(current) == tuple(goal):\n        path = []\n        while current is not None:\n          path.append(tuple(current))\n          current = parent[tuple(current)]\n        return path[::-1]  # Return reversed path for correct order\n\n      visited.add(tuple(current))\n\n      # Explore neighbors in all four directions (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n\n        # Check if the neighbor is safe to move into and hasn't been visited\n        if is_safe_to_move(np.array(neighbor)) and tuple(neighbor) not in visited:\n          queue.append(neighbor)\n          parent[tuple(neighbor)] = current\n\n    return None  # No path found\n\n  def get_direction(current_pos, next_pos):\n    \"\"\"\n    Determine the direction to move from the current position to the next position.\n    \n    Args:\n        current_pos (np.ndarray): The current position of the agent.\n        next_pos (tuple): The next position in the path.\n\n    Returns:\n        int: The action index corresponding to the direction to move.\n             0 - DOWN\n             1 - UP\n             2 - LEFT\n             3 - RIGHT\n    \"\"\"\n    dx = next_pos[0] - current_pos[0]\n    dy = next_pos[1] - current_pos[1]\n\n    if dx > 0:\n      return 3  # RIGHT\n    elif dx < 0:\n      return 2  # LEFT\n    elif dy > 0:\n      return 1  # UP\n    elif dy < 0:\n      return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n    # Calculate the mean position of all workshops of this type\n    workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n    if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n      workshop_pos_mean = workshop_pos_list.mean(axis=0)\n      distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n      if distance < min_distance:\n        closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n    distance = np.linalg.norm(pos - target_pos, ord=2)\n    if distance < min_nearest_distance:\n      nearest_target_pos = target_pos\n      min_nearest_distance = distance\n\n  # Find the shortest path to the closest workshop position while avoiding obstacles\n  path = bfs_shortest_path(tuple(pos), tuple(nearest_target_pos))\n\n  if not path:\n    raise ValueError(\"No safe path found\")\n\n  for step in path[1:]:  # Skip the starting point\n    actions.append(get_direction(pos, step))\n    pos = np.array(step)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T03:37:32.209404", "function_name": "craft", "function_body": "  def move_to_position(current_pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          step = get_next_step(current_pos, target_pos)\n          if step is None:\n              break\n          action = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}.get(tuple(step))\n          actions.append(action)\n          current_pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0)] + [(0, np.sign(dy))] if dx != 0 else [(0, np.sign(dy))]\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          # Ensure the new position is within grid boundaries and not blocked by stone or water\n          if (0 <= new_pos[0] < env._current_state.grid.shape[0] and \n              0 <= new_pos[1] < env._current_state.grid.shape[1] and \n              not env._current_state.next_to(env.world.stone_index) and \n              not env._current_state.next_to(env.world.water_index)):\n              return d\n      return None\n\n  def find_closest_workshop(goal_index: int, workshop_indices: list[int]) -> np.ndarray:\n      pos = np.array(env._current_state.pos)\n      closest_target_pos = None\n      min_distance = float('inf')\n\n      for workshop_idx in workshop_indices:\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_positions) > 0:\n              # Calculate the mean position of all available workshops of this type\n              workshop_mean_pos = workshop_positions.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n\n              if distance < min_distance:\n                  closest_target_pos = min(workshop_positions, key=lambda x: np.linalg.norm(pos - x))\n                  min_distance = distance\n\n      return closest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest position to move towards among all workshops\n  nearest_target_pos = find_closest_workshop(goal_index, workshop_indices)\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T03:37:33.172497", "function_name": "craft", "function_body": "  def move_to_position(current_pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          step = get_next_step(current_pos, target_pos)\n          if step is None:\n              break\n          action = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}.get(tuple(step))\n          actions.append(action)\n          current_pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0)] + [(0, np.sign(dy))] if dx != 0 else [(0, np.sign(dy))]\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          # Check if the new position is blocked by stone or water\n          if (not env._current_state.next_to(env.world.stone_index) and \n              not env._current_state.next_to(env.world.water_index)):\n              return d\n      return None\n\n  def find_closest_workshop(goal_index: int, workshop_indices: list[int]) -> np.ndarray:\n      pos = np.array(env._current_state.pos)\n      closest_target_pos = None\n      min_distance = float('inf')\n\n      for workshop_idx in workshop_indices:\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_positions) > 0:\n              # Calculate the mean position of all available workshops of this type\n              workshop_mean_pos = workshop_positions.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n\n              if distance < min_distance:\n                  closest_target_pos = min(workshop_positions, key=lambda x: np.linalg.norm(pos - x))\n                  min_distance = distance\n\n      return closest_target_pos\n\n  def get_workshop_for_item(cookbook, goal_index):\n      for recipe in cookbook.recipes.values():\n          if goal_index in recipe.outputs:\n              return recipe.workshop\n      raise ValueError(\"No workshop found for the specified item\")\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the specific workshop that can craft the desired item\n  required_workshop_idx = get_workshop_for_item(cookbook, goal_index)\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest position to move towards among all workshops of the required type\n  nearest_target_pos = find_closest_workshop(goal_index, [required_workshop_idx])\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-09T03:39:22.604532", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  recipe = cookbook.recipes[goal_index]\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      if goal_index not in cookbook.recipes[workshop_idx]:\n          continue\n\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* search to find the safest path to the nearest workshop position while avoiding obstacles (stone and water)\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  class PriorityQueue:\n      def __init__(self):\n          self.elements = {}\n      \n      def empty(self):\n          return len(self.elements) == 0\n      \n      def put(self, item, priority):\n          self.elements[item] = priority\n      \n      def get(self):\n          best_item, best_priority = min(self.elements.items(), key=lambda x: x[1])\n          del self.elements[best_item]\n          return best_item\n\n  def a_star_search(start, goal):\n      frontier = PriorityQueue()\n      frontier.put(tuple(start), 0)\n      came_from = {}\n      cost_so_far = {}\n      came_from[tuple(start)] = None\n      cost_so_far[tuple(start)] = 0\n      \n      while not frontier.empty():\n          current = frontier.get()\n\n          if np.array_equal(np.array(current), goal):\n              break\n\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:  # Explore all possible directions\n              next_pos = tuple([current[0] + dx, current[1] + dy])\n              if not env._current_state.grid[next_pos][env.world.stone_index] and not env._current_state.grid[next_pos][env.world.water_index]:\n                  new_cost = cost_so_far[current] + 1\n                  if next_pos not in cost_so_far or new_cost < cost_so_far[next_pos]:\n                      cost_so_far[next_pos] = new_cost\n                      priority = new_cost + heuristic(next_pos, goal)\n                      frontier.put(next_pos, priority)\n                      came_from[next_pos] = current\n      \n      return reconstruct_path(came_from, start, goal)\n\n  def reconstruct_path(came_from, start, goal):\n      current = tuple(goal)\n      path = []\n      while current != tuple(start):\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return path\n\n  # Find the safest path to the nearest workshop position\n  path_to_workshop = a_star_search(tuple(pos), tuple(nearest_target_pos))\n\n  for next_pos in path_to_workshop:\n      dx, dy = np.array(next_pos) - pos\n      if dx > 0:\n          actions.append(3)\n      elif dx < 0:\n          actions.append(2)\n      elif dy > 0:\n          actions.append(1)\n      elif dy < 0:\n          actions.append(0)\n      pos = next_pos\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
