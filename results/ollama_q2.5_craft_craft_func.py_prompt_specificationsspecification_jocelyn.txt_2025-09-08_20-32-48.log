{"timestamp": "2025-09-08T22:48:04.728770", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest position to move towards among all workshops that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  closest_target_pos, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) == 0:  \n          continue\n\n      # Find the nearest position to move towards among the workshops\n      nearest_target_pos = min(workshop_pos_list, key=lambda p: np.linalg.norm(pos - p))\n      \n      # Update closest target position based on nearest position found\n      distance = np.linalg.norm(pos - nearest_target_pos)\n      if distance < min_distance:\n          closest_target_pos = nearest_target_pos\n          min_distance = distance\n\n  if closest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest target position\n  while not np.array_equal(pos, closest_target_pos):\n      dx, dy = closest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-08T22:48:05.860216", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  \n  # Find the closest available position for a workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  closest_target_pos, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  \n          continue\n\n      # Find the nearest position to move towards among the workshops\n      nearest_target_pos = min(workshop_pos_list, key=lambda p: np.linalg.norm(pos - p))\n      \n      # Update closest target position based on nearest position found\n      distance = np.linalg.norm(pos - nearest_target_pos)\n      if distance < min_distance:\n          closest_target_pos = nearest_target_pos\n          min_distance = distance\n\n  if closest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest target position\n  while not np.array_equal(pos, closest_target_pos):\n      dx, dy = closest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx):\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n      else:\n          # If dx == dy, choose a random direction to move in.\n          if np.random.choice([True, False]):\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
