ems(), key=lambda x: x[1])\n          del self.elements[best_item]\n          return best_item\n\n  def a_star_search(start, goal):\n      frontier = PriorityQueue()\n      frontier.put(tuple(start), 0)\n      came_from = {}\n      cost_so_far = {}\n      came_from[tuple(start)] = None\n      cost_so_far[tuple(start)] = 0\n      \n      while not frontier.empty():\n          current = frontier.get()\n\n          if np.array_equal(np.array(current), goal):\n              break\n\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:  # Explore all possible directions\n              next_pos = tuple([current[0] + dx, current[1] + dy])\n              if not env._current_state.grid[next_pos][env.world.stone_index] and not env._current_state.grid[next_pos][env.world.water_index]:\n                  new_cost = cost_so_far[current] + 1\n                  if next_pos not in cost_so_far or new_cost < cost_so_far[next_pos]:\n                      cost_so_far[next_pos] = new_cost\n                      priority = new_cost + heuristic(next_pos, goal)\n                      frontier.put(next_pos, priority)\n                      came_from[next_pos] = current\n      \n      return reconstruct_path(came_from, start, goal)\n\n  def reconstruct_path(came_from, start, goal):\n      current = tuple(goal)\n      path = []\n      while current != tuple(start):\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return path\n\n  # Find the safest path to the nearest workshop position\n  path_to_workshop = a_star_search(tuple(pos), tuple(nearest_target_pos))\n\n  for next_pos in path_to_workshop:\n      dx, dy = np.array(next_pos) - pos\n      if dx > 0:\n          actions.append(3)\n      elif dx < 0:\n          actions.append(2)\n      elif dy > 0:\n          actions.append(1)\n      elif dy < 0:\n          actions.append(0)\n      pos = next_pos\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T03:40:43.884911", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Function to calculate the next step towards the target position while avoiding obstacles\n  def get_next_step(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0) if dx != 0 else (0, np.sign(dy)) for _ in range(2)]\n      directions.append((0, 0))  # Stay still if no safe move available\n\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          if not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index):\n              return d\n      return (0, 0)\n\n  # Move to the closest workshop position and avoid obstacles\n  while not np.array_equal(pos, nearest_target_pos):\n      step = get_next_step(pos, nearest_target_pos)\n      if step == (0, 0):\n          break  # No safe move available, exit loop\n\n      direction_mapping = {(1, 0): 3, (-1, 0): 2, (0, 1): 1, (0, -1): 0}\n      actions.append(direction_mapping.get(step, 0))  # Default to DOWN if no matching direction found\n      pos += np.array(step)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T03:40:44.845924", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = [i for i in env.world.workshop_indices if cookbook.primitives[goal_index][i]]\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Function to calculate the next step towards the target position while avoiding obstacles\n  def get_next_step(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0) if dx != 0 else (0, np.sign(dy)) for _ in range(2)]\n      directions.append((0, 0))  # Stay still if no safe move available\n\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          if not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index):\n              return d\n      return (0, 0)\n\n  # Move to the closest workshop position and avoid obstacles\n  while not np.array_equal(pos, nearest_target_pos):\n      step = get_next_step(pos, nearest_target_pos)\n      if step == (0, 0):\n          break  # No safe move available, exit loop\n\n      direction_mapping = {(1, 0): 3, (-1, 0): 2, (0, 1): 1, (0, -1): 0}\n      actions.append(direction_mapping.get(step, 0))  # Default to DOWN if no matching direction found\n      pos += np.array(step)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-09T03:42:11.548359", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if abs(dy) > abs(dx):\n          return 0 if dy < 0 else 1\n      return 2 if dx < 0 else 3\n\n  def move_to(pos: np.ndarray, target_pos: np.ndarray) -> list[int]:\n      \"\"\"Generates a list of actions to move from pos to target_pos.\"\"\"\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  def collect_primitives(env, primitives: list[str]) -> list[int]:\n      \"\"\"Generates a list of actions to collect the required primitives.\"\"\"\n      actions = []\n      pos = np.array(env._current_state.pos)\n      cookbook = env.world.cookbook\n      for primitive in primitives:\n          primitive_index = cookbook.index[primitive]\n          if primitive_index is None:\n              raise ValueError(f\"Unknown primitive: {primitive}\")\n\n          # Find all positions of the primitive in the grid\n          target_positions = np.argwhere(env._current_state.grid[:, :, primitive_index])\n          if len(target_positions) == 0:\n              raise ValueError(f\"No available {primitive} found\")\n\n          nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n          actions.extend(move_to(pos, nearest_target_pos))\n          actions.append(4)  # USE\n          pos = nearest_target_pos  # Update the current position after collecting\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the recipe for the item\n  recipe = cookbook.recipes.get(goal_index)\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  primitives = [cookbook.index[primitive] for primitive in recipe if primitive != \"_key\"]\n  actions = []\n\n  pos = np.array(env._current_state.pos)\n\n  # Collect all required primitives\n  action_primitive = collect_primitives(env, [cookbook.index.get(primitive) for primitive in recipe if primitive != \"_key\"])\n  actions.extend(action_primitive)\n  \n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  actions.extend(move_to(pos + np.array([0, len(action_primitive)]), nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-09T03:42:12.514689", "function_name": "craft", "function_body": "  def move_to(pos: np.ndarray, target_pos: np.ndarray) -> list[int]:\n      \"\"\"Generates a list of actions to move from pos to target_pos.\"\"\"\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  def calculate_direction(dx: int, dy: int) -> int:\n      \"\"\"Calculate direction based on differences in coordinates.\"\"\"\n      if abs(dy) > abs(dx):\n          return 0 if dy < 0 else 1\n      return 2 if dx < 0 else 3\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the recipe for the item\n  recipe = cookbook.recipes.get(goal_index)\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Identify workshops that can craft the desired item based on the recipe\n  available_workshops = [workshop_idx for workshop_idx in workshop_indices if recipe.get(workshop_idx, 0) > 0]\n  \n  if not available_workshops:\n      raise ValueError(\"No suitable workshop found to craft the item\")\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in available_workshops:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  actions.extend(move_to(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-09T03:43:28.535181", "function_name": "craft", "function_body": "  def is_safe_to_move(current_pos):\n      return not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index)\n\n  def get_shortest_path(start, end):\n      queue = collections.deque([(start, [])])\n      visited = set([tuple(start)])\n      \n      while queue:\n          pos, path = queue.popleft()\n          \n          if np.array_equal(pos, end):\n              return path\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              new_pos = pos + np.array([dx, dy])\n              \n              if tuple(new_pos) not in visited and is_safe_to_move(new_pos):\n                  visited.add(tuple(new_pos))\n                  queue.append((new_pos, path + [4 if dx == dy else (3 if dx > 0 else (2 if dx < 0 else 1 if dy > 0 else 0))]))\n      \n      return []\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Get the shortest path to the nearest workshop position and avoid obstacles\n  path_to_workshop = get_shortest_path(pos, nearest_target_pos)\n\n  actions.extend(path_to_workshop)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": 5.2}}
