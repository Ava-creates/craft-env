se -1\n\n      actions.append(direction)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-08T22:51:31.178109", "function_name": "craft", "function_body": "  def find_closest_workshop_positions(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      target_positions = []\n      \n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_mean_pos = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n              \n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n                  target_positions = workshop_pos_list\n      \n      return closest_workshop_idx, target_positions\n\n  def move_towards_target_position(target_pos):\n      actions = []\n      pos = np.array(env._current_state.pos)\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(2 if dx < 0 else 3)  # LEFT or RIGHT\n              pos[0] += -1 if dx < 0 else 1\n          else:  # Then move in y-direction\n              actions.append(0 if dy < 0 else 1)  # UP or DOWN\n              pos[1] += -1 if dy < 0 else 1\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  pos = np.array(env._current_state.pos)\n  closest_workshop_idx, target_positions = find_closest_workshop_positions(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n  \n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n  actions = move_towards_target_position(nearest_target_pos)\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-08T22:51:32.150982", "function_name": "craft", "function_body": "  def find_closest_workshop_positions(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      target_positions = []\n      \n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_mean_pos = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_mean_pos, ord=2)\n              \n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n                  target_positions = workshop_pos_list\n      \n      return closest_workshop_idx, target_positions\n\n  def move_towards_target_position(target_pos):\n      actions = []\n      pos = np.array(env._current_state.pos)\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              if env._current_state.next_to(env.world.stone_index) or env._current_state.next_to(env.world.water_index):\n                  actions.append(3 if dx < 0 else 2)  # Move opposite direction in x\n                  pos[0] -= 1 if dx > 0 else -1\n              else:\n                  actions.append(2 if dx < 0 else 3)\n                  pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              if env._current_state.next_to(env.world.stone_index) or env._current_state.next_to(env.world.water_index):\n                  actions.append(1 if dy < 0 else 0)  # Move opposite direction in y\n                  pos[1] -= 1 if dy > 0 else -1\n              else:\n                  actions.append(0 if dy < 0 else 1)\n                  pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  def adjust_direction(dx, dy):\n      \"\"\"Determine the direction based on dx and dy.\"\"\"\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx < 0 else 2  # LEFT or RIGHT\n      else:  # Then move in y-direction\n          return 1 if dy < 0 else 0  # UP or DOWN\n\n  def find_workshop_by_recipe(item_index):\n      \"\"\"Find the workshop index that can craft the given item.\"\"\"\n      for recipe, required_items in env.world.cookbook.items.items():\n          if item_index in recipe:\n              return recipe[0]\n      return None\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  pos = np.array(env._current_state.pos)\n  \n  # Find the correct workshop index based on the recipe\n  workshop_idx = find_workshop_by_recipe(goal_index)\n\n  if workshop_idx is None or workshop_idx not in env.world.workshop_indices:\n      raise ValueError(\"No suitable workshop found for the item\")\n\n  workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n  \n  if len(workshop_pos_list) == 0:  # Check if there is any location for the workshop\n      raise ValueError(\"No available workshop found\")\n  \n  nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n  actions = move_towards_target_position(nearest_target_pos)\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-08T22:52:32.873099", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  # Assuming all workshops are capable of crafting any item (as per typical game design)\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": 4.7}}
{"timestamp": "2025-09-08T22:57:32.987167", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_workshop_pos = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Get all positions of this type of workshop\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_positions) == 0: \n          continue\n      \n      # Find the closest position among these workshops\n      for workshop_pos in workshop_positions:\n          distance = np.linalg.norm(pos - workshop_pos, ord=2)\n          if distance < min_distance:\n              nearest_workshop_pos = workshop_pos\n              min_distance = distance\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_workshop_pos):\n      dx, dy = nearest_workshop_pos - pos\n\n      # Determine direction to move in\n      direction = np.argmax(np.abs([dx, dy]))  # Choose direction with largest distance difference\n      if direction == 0:  # Move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n      elif direction == 1:  # Move in x-direction\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE action\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-08T22:58:33.373496", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  min_distance = float('inf')\n  closest_workshop_idx, closest_pos = None, None\n\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = np.linalg.norm(pos - workshop_pos_list, axis=1)\n          nearest_target_pos = workshop_pos_list[np.argmin(distances)]\n          distance = np.min(distances)\n\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              closest_pos = nearest_target_pos\n              min_distance = distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, closest_pos):\n      dx, dy = closest_pos - pos\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Move in y-direction only if there's a difference\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 9, "scores": {"3": 4.7}}
