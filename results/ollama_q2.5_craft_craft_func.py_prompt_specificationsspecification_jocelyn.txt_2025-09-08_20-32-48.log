ey=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T01:53:44.745484", "function_name": "craft", "function_body": "  def move_to_position(current_pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          step = get_next_step(current_pos, target_pos)\n          if step is None:\n              break\n          direction = tuple(step)\n          action = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}.get(direction)\n          actions.append(action)\n          current_pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - current_pos\n      steps = [(np.sign(dx), 0)] + [(0, np.sign(dy))] if dx != 0 else [(0, np.sign(dy))]\n      for step in steps:\n          new_pos = current_pos + np.array(step)\n          if not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index):\n              return step\n      return None\n\n  def find_closest_workshop(goal_index: int, workshop_indices: list[int]) -> (int, np.ndarray):\n      pos = np.array(env._current_state.pos)\n      closest_workshop_idx, min_distance = None, float('inf')\n      \n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:\n              # Calculate the mean position of all available workshops of this type\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n              if distance < min_distance and can_use_workshop(workshop_idx, goal_index):\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  def can_use_workshop(workshop_idx: int, goal_index: int) -> bool:\n      # Check if the workshop has the required items to craft the desired item\n      primitives_needed = env.world.cookbook.primitives_needed(goal_index)\n      for primitive in primitives_needed:\n          if not env._current_state.next_to(primitive):\n              return False\n      return True\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx = find_closest_workshop(goal_index, workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-09T01:53:45.818955", "function_name": "craft", "function_body": "  def move_to_position(pos: np.ndarray, target_pos: np.ndarray):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          step = get_next_step(pos, target_pos)\n          if step is None:\n              break\n          action = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}.get(tuple(step))\n          actions.append(action)\n          pos += np.array(step)\n      return actions\n\n  def get_next_step(current_pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - current_pos\n      directions = [(np.sign(dx), 0)] + [(0, np.sign(dy))] if dx != 0 else [(0, np.sign(dy))]\n      for d in directions:\n          new_pos = current_pos + np.array(d)\n          if not env._current_state.next_to(env.world.stone_index) and not env._current_state.next_to(env.world.water_index):\n              return d\n      return None\n\n  def find_closest_workshop(goal_index: int, workshop_indices: list[int]) -> (int, np.ndarray):\n      pos = np.array(env._current_state.pos)\n      closest_workshop_idx, min_distance = None, float('inf')\n      \n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:\n              # Calculate the mean position of all available workshops of this type\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n      return closest_workshop_idx, workshop_pos_mean\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, target_pos_mean = find_closest_workshop(goal_index, workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = min(np.argwhere(env._current_state.grid[:, :, closest_workshop_idx]), key=lambda x: np.linalg.norm(pos - x))\n\n  actions.extend(move_to_position(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T01:54:53.416606", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          for wp in workshop_positions:\n              distance = np.linalg.norm(pos - wp, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = wp\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, target_workshop_pos):\n      dx, dy = target_workshop_pos - pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in, prioritize x-direction first\n      if dir_x is not None:\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif dir_y is not None:\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T01:54:54.409116", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          for wp in workshop_positions:\n              distance = np.linalg.norm(pos - wp, ord=2)\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = wp\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position using A* pathfinding\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=1)\n\n  def a_star(start, goal):\n      open_set = set()\n      closed_set = set()\n      g_costs = {start: 0}\n      f_costs = {start: heuristic(start, goal)}\n      came_from = {}\n\n      open_set.add(tuple(start))\n\n      while open_set:\n          current = min(open_set, key=lambda o: f_costs[o])\n\n          if current == tuple(goal):\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              return path\n\n          open_set.remove(tuple(current))\n          closed_set.add(tuple(current))\n\n          neighbors = [(current[0] + 1, current[1]), (current[0] - 1, current[1]),\n                       (current[0], current[1] + 1), (current[0], current[1] - 1)]\n\n          for neighbor in neighbors:\n              if tuple(neighbor) in closed_set or not env._current_state.grid[neighbor[0], neighbor[1], 0]:  # Assuming cell [0] is walkable\n                  continue\n\n              tentative_g_cost = g_costs[tuple(current)] + heuristic(current, neighbor)\n\n              if tuple(neighbor) not in open_set or tentative_g_cost < g_costs[tuple(neighbor)]:\n                  came_from[tuple(neighbor)] = current\n                  g_costs[tuple(neighbor)] = tentative_g_cost\n                  f_costs[tuple(neighbor)] = tentative_g_cost + heuristic(neighbor, goal)\n                  if tuple(neighbor) not in open_set:\n                      open_set.add(tuple(neighbor))\n\n      return None\n\n  path = a_star(tuple(pos), tuple(target_workshop_pos))\n\n  if path is None:\n      raise ValueError(\"No valid path to workshop found\")\n\n  for p in path:\n      dx, dy = np.array(p) - pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in, prioritize x-direction first\n      if dir_x is not None:\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif dir_y is not None:\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-09T01:56:59.562848", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the desired item and identify required workshops\n  recipe = cookbook.recipes.get(goal_index)\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_indices_required = set()\n  for ingredient in recipe:\n    if isinstance(ingredient, tuple):\n      _, workshop_idx = ingredient\n      workshop_indices_required.add(workshop_idx)\n\n  # If no workshops are required, assume the crafting can be done directly at any available workshop\n  if not workshop_indices_required:\n    workshop_indices_required.update(env.world.workshop_indices)\n\n  actions = []\n\n  # For each required workshop, move to it and use it to craft ingredients/items needed for the final item\n  for workshop_idx in workshop_indices_required:\n      pos = np.array(env._current_state.pos)\n  \n      # Calculate the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = min(target_positions, key=lambda x: heuristic(tuple(pos), tuple(x)))\n  \n      # Use A* to find the shortest path to the closest workshop position\n      start_pos = tuple(pos)\n      goal_pos = tuple(nearest_target_pos)\n  \n      open_set = set()\n      came_from = {}\n      g_score = {start_pos: 0}\n      f_score = {start_pos: heuristic(start_pos, goal_pos)}\n      open_set.add(start_pos)\n  \n      while open_set:\n          current = min(open_set, key=lambda x: f_score[x])\n  \n          if current == goal_pos:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              break\n  \n          open_set.remove(current)\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n              neighbor = (current[0] + dx, current[1] + dy)\n  \n              if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n                  0 <= neighbor[1] < env._current_state.grid.shape[1]):\n                  tentative_g_score = g_score[current] + heuristic(current, neighbor)\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                      open_set.add(neighbor)\n  \n      # Convert path to actions\n      if 'path' not in locals():\n          raise ValueError(\"No valid path found\")\n  \n      for target in path:\n          dx, dy = np.array(target) - pos\n  \n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n  \n      # Use the workshop to craft required items/ingredients\n      actions.append(4)  # USE\n\n  # After crafting all necessary items, move to a final workshop to craft the desired item\n  for workshop_idx in env.world.workshop_indices:\n    pos = np.array(env._current_state.pos)\n  \n    # Calculate the closest position to move towards\n    target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    nearest_target_pos = min(target_positions, key=lambda x: heuristic(tuple(pos), tuple(x)))\n  \n    # Use A* to find the shortest path to the closest workshop position\n    start_pos = tuple(pos)\n    goal_pos = tuple(nearest_target_pos)\n  \n    open_set = set()\n    came_from = {}\n    g_score = {start_pos: 0}\n    f_score = {start_pos: heuristic(start_pos, goal_pos)}\n    open_set.add(start_pos)\n  \n    while open_set:\n        current = min(open_set, key=lambda x: f_score[x])\n  \n        if current == goal_pos:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            break\n  \n        open_set.remove(current)\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n            neighbor = (current[0] + dx, current[1] + dy)\n  \n            if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n                0 <= neighbor[1] < env._current_state.grid.shape[1]):\n                tentative_g_score = g_score[current] + heuristic(current, neighbor)\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                    open_set.add(neighbor)\n  \n    # Convert path to actions\n    if 'path' not in locals():\n        raise ValueError(\"No valid path found\")\n  \n    for target in path:\n        dx, dy = np.array(target) - pos\n  \n        # Determine direction to move in\n        if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n            actions.append(3 if dx > 0 else 2)\n            pos[0] += 1 if dx > 0 else -1\n        else:  # Then move in y-direction\n            actions.append(1 if dy > 0 else 0)\n            pos[1] += 1 if dy > 0 else -1\n  \n    # Use the workshop to craft the desired item\n    actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-09T01:57:00.520375", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  workshop_indices = [i for i, recipe in enumerate(cookbook.recipes) if goal_index in recipe.products]\n  \n  if not workshop_indices:\n      raise ValueError(f\"No workshops found to craft {item}\")\n\n  actions = []\n\n  pos = np.array(env._current_state.pos)\n\n  # Calculate the closest position to move towards\n  target_positions = []\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          nearest_target_pos = min(workshop_pos_list, key=lambda x: heuristic(tuple(pos), tuple(x)))\n          target_positions.append(nearest_target_pos)\n\n  if not target_positions:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_workshop_pos = min(target_positions, key=lambda x: heuristic(tuple(pos), tuple(x)))\n\n  # Use A* to find the shortest path to the closest workshop position\n  start_pos = tuple(pos)\n  goal_pos = tuple(nearest_workshop_pos)\n\n  open_set = set()\n  came_from = {}\n  g_score = {start_pos: 0}\n  f_score = {start_pos: heuristic(start_pos, goal_pos)}\n  open_set.add(start_pos)\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n\n      if current == goal_pos:\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n              0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  open_set.add(neighbor)\n\n  # Convert path to actions\n  if 'path' not in locals():\n      raise ValueError(\"No valid path found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-09T01:58:11.668844", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  def find_closest_workshop_with_recipe(pos, goal_index):\n      closest_workshop_idx, min_distance = None, float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n              # Verify if this workshop can craft the desired item\n              recipe = cookbook.recipes.get(workshop_idx, {})\n              if goal_index in recipe.values():\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n      return closest_workshop_idx\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          current_pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  def craft_at_workshop(workshop_idx):\n      # Calculate the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n      actions.extend(move_to_position(pos, nearest_target_pos))\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n  closest_workshop_idx = find_closest_workshop_with_recipe(pos, goal_index)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found that can craft the desired item\")\n\n  craft_at_workshop(closest_workshop_idx)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-09T01:58:12.750687", "function_name": "craft", "function_body": "  def calculate_direction(dx: int, dy: int) -> int:\n      if dx > 0 and abs(dx) >= abs(dy):\n          return 3  # RIGHT\n      elif dx < 0 and abs(dx) >= abs(dy):\n          return 2  # LEFT\n      elif dy > 0 and abs(dy) > abs(dx):\n          return 1  # UP\n      elif dy < 0 and abs(dy) > abs(dx):\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  def find_closest_workshop(pos):\n      closest_workshop_idx, min_distance = None, float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = calculate_direction(dx, dy)\n          actions.append(direction)\n          current_pos += np.array([(direction == 3) - (direction == 2), (direction == 1) - (direction == 0)])\n      return actions\n\n  closest_workshop_idx = find_closest_workshop(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to a position within range of the closest workshop\n  workshop_pos_list = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = workshop_pos_list[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in workshop_pos_list])]\n  actions.extend(move_to_position(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 5.2}}
{"timestamp": "2025-09-09T02:00:00.492166", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* search to find the safest path to the nearest workshop position while avoiding obstacles (stone and water)\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  class PriorityQueue:\n      def __init__(self):\n          self.elements = {}\n      \n      def empty(self):\n          return len(self.elements) == 0\n      \n      def put(self, item, priority):\n          self.elements[item] = priority\n      \n      def get(self):\n          best_item, best_priority = min(self.elements.items(), key=lambda x: x[1])\n          del self.elements[best_item]\n          return best_item\n\n  def a_star_search(start, goal):\n      frontier = PriorityQueue()\n      frontier.put(tuple(start), 0)\n      came_from = {}\n      cost_so_far = {}\n      came_from[tuple(start)] = None\n      cost_so_far[tuple(start)] = 0\n      \n      while not frontier.empty():\n          current = frontier.get()\n\n          if np.array_equal(np.array(current), goal):\n              break\n\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:  # Explore all possible directions\n              next_pos = tuple([current[0] + dx, current[1] + dy])\n              if not env._current_state.grid[next_pos][env.world.stone_index] and not env._current_state.grid[next_pos][env.world.water_index]:\n                  new_cost = cost_so_far[current] + 1\n                  if next_pos not in cost_so_far or new_cost < cost_so_far[next_pos]:\n                      cost_so_far[next_pos] = new_cost\n                      priority = new_cost + heuristic(next_pos, goal)\n                      frontier.put(next_pos, priority)\n                      came_from[next_pos] = current\n      \n      return reconstruct_path(came_from, start, goal)\n\n  def reconstruct_path(came_from, start, goal):\n      current = tuple(goal)\n      path = []\n      while current != tuple(start):\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return path\n\n  # Find the safest path to the nearest workshop position\n  path_to_workshop = a_star_search(tuple(pos), tuple(nearest_target_pos))\n\n  for next_pos in path_to_workshop:\n      dx, dy = np.array(next_pos) - pos\n      if dx > 0:\n          actions.append(3)\n      elif dx < 0:\n          actions.append(2)\n      elif dy > 0:\n          actions.append(1)\n      elif dy < 0:\n          actions.append(0)\n      pos = next_pos\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 5.2}}
