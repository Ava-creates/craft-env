{"timestamp": "2025-08-19T19:42:01.843005", "function_name": "craft", "function_body": "  def calculate_path(start_pos, target_pos):\n    path = []\n    while start_pos != target_pos:\n        if start_pos[0] < target_pos[0]:\n            path.append(3)  # RIGHT\n        elif start_pos[0] > target_pos[0]:\n            path.append(2)  # LEFT\n        elif start_pos[1] < target_pos[1]:\n            path.append(0)  # DOWN\n        else:\n            path.append(1)  # UP\n        # Move one step towards the target position\n        if start_pos[0] < target_pos[0]:\n            start_pos = (start_pos[0] + 1, start_pos[1])\n        elif start_pos[0] > target_pos[0]:\n            start_pos = (start_pos[0] - 1, start_pos[1])\n        elif start_pos[1] < target_pos[1]:\n            start_pos = (start_pos[0], start_pos[1] + 1)\n        else:\n            start_pos = (start_pos[0], start_pos[1] - 1)\n    return path\n\n  item_index = env.world.cookbook.index[item]\n\n  # Fetch the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  actions = []\n\n  # Check if we need to go to a workshop to craft this item\n  required_workshop = None\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          required_workshop_name = env.world.cookbook.index.get(count)\n          break\n\n  if required_workshop_name is not None:\n      # Find the position of the required workshop in the world\n      target_index = env.world.workshop_indices.index(required_workshop_name)\n      \n      if target_index == -1:\n          raise ValueError(f\"Workshop {required_workshop_name} not found in the grid\")\n\n      # Assuming workshops are aligned along one axis, find its position based on index\n      workshop_positions = [(i, 0) for i in range(len(env.world.workshop_indices))]\n      \n      target_pos = workshop_positions[target_index]\n\n      if not target_pos:\n          raise ValueError(f\"Workshop {required_workshop_name} not found in the grid\")\n\n      # Calculate the path to the workshop\n      start_pos = env._current_state.pos\n      path_actions = calculate_path(start_pos, target_pos)\n      actions.extend(path_actions)\n\n  # Use action at the workshop\n  actions.append(4)  # Assuming USE action is indexed as 4\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-19T19:42:02.891188", "function_name": "craft", "function_body": "  # Translate item name to index using cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Fetch the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  actions = []\n\n  # Check if a workshop is required to craft this item\n  required_workshop = None\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          workshop_name = recipe[\"_key\"]\n          workshop_index = env.world.cookbook.index[workshop_name]\n          required_workshop = workshop_index\n          break\n\n  if required_workshop is not None:\n      # Find the position of the required workshop in the grid\n      target_pos = find_target_position(env, required_workshop)\n      \n      if not target_pos:\n          raise ValueError(f\"Workshop {required_workshop} not found in the grid\")\n\n      # Calculate path to the closest matching workshop using A* algorithm\n      start_pos = env._current_state.pos\n      path_actions = a_star_search(env, start_pos, target_pos)\n\n      if not path_actions:\n          raise ValueError(f\"Unable to calculate path to {required_workshop}\")\n\n      actions.extend(path_actions)\n\n  # Use action at the workshop to craft the item\n  actions.append(4)  # Assuming USE action is indexed as 4\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
