{"timestamp": "2025-08-19T18:17:29.191786", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  \n  # Get the workshop required for crafting this item\n  recipe = env.world.cookbook.recipes[goal_index]\n  required_workshop_key = next((key for key, value in recipe.items() if \"_key\" in str(key)), None)\n  \n  actions = []\n\n  if required_workshop_key:\n    workshop_number = int(required_workshop_key.split('_')[1]) # Extract the workshop number from _key\n    target_workshop_pos = env.world.workshop_indices[workshop_number]\n    \n    # Get current position of the agent in the grid\n    current_pos = env._current_state.pos\n    \n    # Calculate relative movement to reach the workshop\n    path = a_star(env, current_pos, target_workshop_pos)\n    actions.extend(path_to_actions(path))\n    \n    # Once at the workshop, use the USE action to craft\n    actions.append(4)  # Assuming USE is represented by action index 4\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T18:18:32.352488", "function_name": "craft", "function_body": "  # Define constants for actions\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  item_index = env.world.cookbook.index[item]\n\n  # Determine which workshop is required to craft this item\n  recipes = env.world.cookbook.recipes\n  \n  # Find a workshop that has a recipe with this output\n  for workshop in env.world.workshop_indices:\n      if any(output == item_index for output, _ in recipes.items()):\n          required_workshop = workshop\n          break\n\n  # Get the current position and direction of the agent\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  # Function to calculate Manhattan distance between two positions\n  def manhattan_distance(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  # Find the nearest workshop using a simple greedy approach\n  closest_workshop = min(env.world.workshop_indices, key=lambda w: manhattan_distance(current_pos, env._current_state.grid[:, :, w].nonzero()))\n\n  # Calculate path to the nearest workshop\n  def calculate_path(start, target):\n      directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # UP, DOWN, LEFT, RIGHT\n      queue = collections.deque([(start, [])])\n      visited = set()\n      \n      while queue:\n          current, path = queue.popleft()\n          if current == target:\n              return path\n          x, y = current\n          for dx, dy in directions:\n              new_x, new_y = x + dx, y + dy\n              if (new_x, new_y) not in visited and 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n                  queue.append(((new_x, new_y), path + [(dx, dy)]))\n                  visited.add((new_x, new_y))\n      return []\n\n  # Calculate the path to the closest workshop\n  target_pos = (env._current_state.grid[:, :, closest_workshop].nonzero()[0][0], env._current_state.grid[:, :, closest_workshop].nonzero()[1][0])\n  path_to_workshop = calculate_path(current_pos, target_pos)\n\n  # Convert path to actions\n  for dx, dy in path_to_workshop:\n      if dx == 0 and dy == -1:  # UP\n          actions_to_take.append(UP)\n      elif dx == 0 and dy == 1:  # DOWN\n          actions_to_take.append(DOWN)\n      elif dx == -1 and dy == 0:  # LEFT\n          actions_to_take.append(LEFT)\n      elif dx == 1 and dy == 0:  # RIGHT\n          actions_to_take.append(RIGHT)\n\n  # Append the USE action to craft the item at the workshop\n  actions_to_take.append(USE)\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
