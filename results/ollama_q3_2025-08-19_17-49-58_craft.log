{"timestamp": "2025-08-19T19:11:08.143197", "function_name": "craft", "function_body": "  def move_towards(target_pos):\n    current_pos = env._current_state.pos\n    x_diff, y_diff = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions = []\n    if x_diff > 0:\n      actions.extend([env.action_specs()[\"DOWN\"] for _ in range(x_diff)])\n    elif x_diff < 0:\n      actions.extend([env.action_specs()[\"UP\"] for _ in range(-x_diff)])\n\n    if y_diff > 0:\n      actions.extend([env.action_specs()[\"RIGHT\"] for _ in range(y_diff)])\n    elif y_diff < 0:\n      actions.extend([env.action_specs()[\"LEFT\"] for _ in range(-y_diff)])\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Determine the required workshop for crafting (if any)\n  workshop_type = None\n  for recipe_output, recipe in env.world.cookbook.recipes.items():\n      if recipe_output == item_index:\n          if \"_key\" in recipe:\n              workshop_type = recipe[\"_key\"]\n          break\n\n  # If no workshop is needed, return an empty list of actions (assuming the items are already available)\n  if not workshop_type:\n      return []\n\n  # Find the index of the required workshop\n  workshop_index = env.world.cookbook.index[workshop_type]\n\n  # Determine the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # If no workshop is found, return an empty list of actions (this should not happen if the item has a recipe and requires a workshop)\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the nearest workshop\n  agent_pos = np.array(env._current_state.pos)\n  nearest_workshop_idx = np.argmin(np.sum((workshop_positions - agent_pos)**2, axis=1))\n  nearest_workshop = tuple(workshop_positions[nearest_workshop_idx])\n\n  actions_to_move = move_towards(nearest_workshop)\n\n  # Check if we are already at the workshop\n  if env._current_state.pos == nearest_workshop:\n      actions_to_move.append(env.action_specs()[\"USE\"])\n  else:\n      for _ in range(len(actions_to_move)):\n          action = actions_to_move.pop(0)\n          reward, done, observations = env.step(action)\n          total_reward += reward\n          if done or len(actions_to_move) == 0:\n              break\n\n      # Check if we are at the workshop after moving\n      if env._current_state.pos == nearest_workshop:\n          actions_to_move.append(env.action_specs()[\"USE\"])\n\n  return actions_to_move", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T19:11:09.243879", "function_name": "craft", "function_body": "  def move_towards(target_pos):\n    current_pos = env._current_state.pos\n    x_diff, y_diff = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions = []\n    if x_diff > 0:\n      actions.extend([env.action_specs()[\"DOWN\"] for _ in range(x_diff)])\n    elif x_diff < 0:\n      actions.extend([env.action_specs()[\"UP\"] for _ in range(-x_diff)])\n\n    if y_diff > 0:\n      actions.extend([env.action_specs()[\"RIGHT\"] for _ in range(y_diff)])\n    elif y_diff < 0:\n      actions.extend([env.action_specs()[\"LEFT\"] for _ in range(-y_diff)])\n\n    return actions\n\n  def collect_primitives(env, primitives_needed):\n    \"\"\"Collects the required primitives to craft the item.\n    \n    Args:\n        env (CraftLab): The CraftLab environment instance.\n        primitives_needed (dict): Dictionary of primitive kinds and their counts.\n\n    Returns:\n        List[int]: A list of action indices the agent can execute to collect the required primitives.\n    \"\"\"\n    actions = []\n    for primitive_index, count in primitives_needed.items():\n      primitive_name = env.world.cookbook.index.get(primitive_index)\n      \n      if not primitive_name:\n        continue\n\n      # Find positions of the required primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n\n      # If no primitives are found, continue to the next one\n      if len(primitive_positions) == 0:\n        continue\n\n      for _ in range(count):\n        # Choose the nearest primitive\n        agent_pos = np.array(env._current_state.pos)\n        nearest_primitive_idx = np.argmin(np.sum((primitive_positions - agent_pos)**2, axis=1))\n        nearest_primitive = tuple(primitive_positions[nearest_primitive_idx])\n\n        actions.extend(move_towards(nearest_primitive))\n\n        # Add the USE action to collect the primitive\n        actions.append(env.action_specs()[\"USE\"])\n\n        # Update grid after collecting the primitive\n        env._current_state.grid[nearest_primitive] -= 1\n\n    return actions\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Determine the required workshop for crafting (if any)\n  workshop_type = None\n  for recipe_output, recipe in env.world.cookbook.recipes.items():\n      if recipe_output == item_index:\n          if \"_key\" in recipe:\n              workshop_type = recipe[\"_key\"]\n          break\n\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n\n  # Collect the required primitives\n  actions_to_collect_primitives = collect_primitives(env, primitives_needed)\n  \n  # If no workshop is needed, return the actions to collect primitives (assuming the items are already available)\n  if not workshop_type:\n      return actions_to_collect_primitives\n\n  # Find the index of the required workshop\n  workshop_index = env.world.cookbook.index[workshop_type]\n\n  # Determine the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # If no workshop is found, return an empty list of actions (this should not happen if the item has a recipe and requires a workshop)\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the nearest workshop\n  agent_pos = np.array(env._current_state.pos)\n  nearest_workshop_idx = np.argmin(np.sum((workshop_positions - agent_pos)**2, axis=1))\n  nearest_workshop = tuple(workshop_positions[nearest_workshop_idx])\n\n  actions_to_move_to_workshop = move_towards(nearest_workshop)\n\n  # Add the USE action to craft the item\n  actions_to_move_to_workshop.append(env.action_specs()[\"USE\"])\n\n  return actions_to_collect_primitives + actions_to_move_to_workshop", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-19T19:11:40.426047", "function_name": "craft", "function_body": "  # Get the index for the item to craft\n  goal_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  actions = []\n\n  # Check if there is a workshop required in the recipe\n  required_workshop_key = next((key for key, value in recipe.items() if \"_key\" in str(key)), None)\n\n  if required_workshop_key:\n    workshop_number = int(required_workshop_key.split('_')[1]) # Extract the workshop number from _key\n    target_workshop_pos = env.world.workshop_indices[workshop_number]\n\n    current_pos = env._current_state.pos\n\n    # Calculate relative movement to reach the workshop\n    delta_x, delta_y = calculate_relative_movement(current_pos, target_workshop_pos)\n\n    actions.extend(move_to(env, (delta_x, delta_y)))\n\n    # Once at the workshop, use the USE action to craft\n    actions.append(4)  # Assuming USE is represented by action index 4\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T19:11:41.492181", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  \n  # Get the workshop required for crafting this item\n  recipe = env.world.cookbook.recipes[goal_index]\n  required_workshop_key = next((key for key, value in recipe.items() if \"_key\" in str(key)), None)\n  \n  actions = []\n\n  if required_workshop_key:\n    workshop_number = int(required_workshop_key.split('_')[1]) # Extract the workshop number from _key\n    target_workshop_pos = env.world.workshop_indices[workshop_number]\n    \n    # Get current position of the agent in the grid\n    current_pos = env._current_state.pos\n    \n    # Calculate relative movement to reach the workshop\n    actions.extend(move_to(env, target_workshop_pos))\n    \n    # Once at the workshop, use the USE action to craft\n    actions.append(4)  # Assuming USE is represented by action index 4\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T19:12:33.323321", "function_name": "craft", "function_body": "  def pathfinding(grid, start, target):\n    \"\"\"Pathfinding function to find the shortest path from start to target.\"\"\"\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # Right, Down, Left, Up\n    queue = collections.deque([(start, [])])\n    visited = set()\n    \n    while queue:\n        current_pos, path = queue.popleft()\n        if current_pos == target:\n            return path\n        \n        for dx, dy in directions:\n            new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n            if (new_x >= 0 and new_x < grid.shape[0] and\n                new_y >= 0 and new_y < grid.shape[1] and\n                grid[new_x, new_y].sum() == 0 and  # Assuming an empty cell has a sum of 0\n                (new_x, new_y) not in visited):\n                queue.append(((new_x, new_y), path + [(dx, dy)]))\n                visited.add((new_x, new_y))\n    \n    return []\n\n  item_index = env.world.cookbook.index[item]\n\n  actions = []\n\n  if item_index in env.world.workshop_indices:\n      workshop_type = env.world.workshop_indices.index(item_index)\n      target_workshop = env.world.workshop_indices[workshop_type]\n      \n      # Find the position of the target workshop\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, target_workshop] > 0)\n      \n      if workshop_positions.size > 0:\n          # Choose a random position to go to the workshop (for simplicity, choose the first one)\n          target_pos = tuple(workshop_positions[0])\n          \n          # Calculate the actions needed to move to the target position\n          current_pos = env._current_state.pos\n          path_to_workshop = pathfinding(env._current_state.grid, current_pos, target_pos)\n          \n          for (dx, dy) in path_to_workshop:\n              if dx > 0:\n                  actions.append(craft.ACTIONS.RIGHT)\n              elif dx < 0:\n                  actions.append(craft.ACTIONS.LEFT)\n              \n              if dy > 0:\n                  actions.append(craft.ACTIONS.DOWN)\n              elif dy < 0:\n                  actions.append(craft.ACTIONS.UP)\n          \n          # Add the USE action to craft the item\n          actions.append(craft.ACTIONS.USE)\n      else:\n          raise ValueError(f\"No workshop of type {item_index} found in the environment.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T19:12:34.305679", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, target_workshop):\n    positions = np.argwhere(grid[:, :, target_workshop] > 0)\n    if len(positions) == 0:\n      return None\n    distances = [np.linalg.norm(np.array(env._current_state.pos) - pos) for pos in positions]\n    closest_idx = np.argmin(distances)\n    return tuple(positions[closest_idx])\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if item_index not in env.world.workshop_indices:\n      raise ValueError(f\"No workshop available to craft the item {item}.\")\n\n  target_workshop = env.world.workshop_indices.index(item_index)\n  closest_workshop_pos = find_closest_workshop(env._current_state.grid, target_workshop)\n\n  if closest_workshop_pos is None:\n    raise ValueError(\"No valid workshop found in the environment.\")\n\n  # Calculate actions to move to the closest workshop\n  path_to_workshop = pathfinding(env._current_state.pos, closest_workshop_pos, env._current_state.grid)\n  actions.extend(path_to_workshop)\n\n  # Perform the USE action at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-19T19:13:14.271457", "function_name": "craft", "function_body": "  # Get the index of the item from the cookbook.\n  item_index = env.world.cookbook.index[item]\n\n  # Find which workshop can craft this item\n  workshop_index = None\n  for recipe in env.world.cookbook.recipes.values():\n      if recipe.get(\"_key\") == item_index:\n          workshop_index = env.world.workshop_indices[0]  # Assuming the first workshop can handle all recipes\n          break\n\n  # If no workshop is found, raise an error.\n  if workshop_index is None:\n      raise ValueError(f\"No workshop found to craft {item}\")\n\n  # Move to the workshop.\n  actions_to_take = []\n  \n  # This is a placeholder for actual pathfinding logic to move to the workshop.\n  actions_to_take.extend([craft.UP] * 5)  # Move up 5 steps as an example.\n\n  # Perform the USE action at the workshop.\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-19T19:13:15.240626", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Dictionary to map item indices to workshop indices (assuming we know this mapping)\n  workshop_map = {\n      # Example mappings, replace with actual mappings from your environment\n      1: 0,  # Item index 1 uses Workshop 0\n      2: 1,  # Item index 2 uses Workshop 1\n      3: 0   # Item index 3 also uses Workshop 0\n  }\n  \n  # Get the workshop index for the item\n  workshop_index = workshop_map.get(item_index)\n  \n  if workshop_index is None:\n      raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Get the coordinates of the workshop from workshop_indices list in CraftWorld\n  workshop_coords = env.world.workshop_indices[workshop_index]\n  \n  # Convert grid-based position to agent's position tuple (x, y)\n  agent_position = np.array(env._current_state.pos)\n  workshop_position = np.array(workshop_coords)\n  \n  # Calculate the direction the agent needs to move to reach the workshop\n  direction_to_workshop = workshop_position - agent_position\n  \n  # Determine the movement actions needed to reach the workshop\n  actions = []\n  if direction_to_workshop[0] > 0:\n      actions.extend([env.world.N_ACTIONS[\"RIGHT\"]] * int(direction_to_workshop[0]))\n  elif direction_to_workshop[0] < 0:\n      actions.extend([env.world.N_ACTIONS[\"LEFT\"]] * abs(int(direction_to_workshop[0])))\n  \n  if direction_to_workshop[1] > 0:\n      actions.extend([env.world.N_ACTIONS[\"UP\"]] * int(direction_to_workshop[1]))\n  elif direction_to_workshop[1] < 0:\n      actions.extend([env.world.N_ACTIONS[\"DOWN\"]] * abs(int(direction_to_workshop[1])))\n  \n  # Add the USE action to craft the item\n  actions.append(env.world.N_ACTIONS[\"USE\"])\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
