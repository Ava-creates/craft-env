\n    # The agent should now be next to a workshop\n    found_workshop = True\n\n  if found_workshop:\n      actions.append(env.world.n_actions - 1)  # USE action to craft the item\n\n  return actions", "island_id": 5, "scores": {"3": 2.7}}
{"timestamp": "2025-08-19T20:18:33.511888", "function_name": "craft", "function_body": "  def move_towards_target(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n    actions = []\n    \n    while (dx != 0 or dy != 0):\n        direction_to_move = None\n        if abs(dx) > abs(dy):\n            direction_to_move = 2 if dx < 0 else 3\n        else:\n            direction_to_move = 0 if dy < 0 else 1\n\n        actions.append(direction_to_move)\n        current_pos = (current_pos[0] + (direction_to_move == 3) - (direction_to_move == 2),\n                       current_pos[1] + (direction_to_move == 1) - (direction_to_move == 0))\n        dx = target_pos[0] - current_pos[0]\n        dy = target_pos[1] - current_pos[1]\n\n    return actions\n\n  actions = []\n\n  # Get the index of the item to be crafted\n  item_index = env.world.cookbook.index[item]\n\n  # Find a suitable workshop for crafting\n  found_workshop = False\n\n  # Determine if the agent is already next to any workshop\n  current_pos = env._current_state.pos\n  for workshop_index in env.world.workshop_indices:\n    if env._current_state.next_to(workshop_index):\n      found_workshop = True\n      break\n\n  if not found_workshop:\n    # If not next to any workshop, move towards the nearest one\n    closest_workshop_index = None\n    min_distance = float('inf')\n    for workshop_index in env.world.workshop_indices:\n        # Find all positions of the current workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n        \n        # Calculate the Manhattan distance to each position and find the closest one\n        for wp in workshop_positions:\n            distance = abs(wp[0] - current_pos[0]) + abs(wp[1] - current_pos[1])\n            if distance < min_distance:\n                min_distance = distance\n                closest_workshop_index = workshop_index\n\n    # Move towards the closest workshop\n    target_pos = np.argwhere(env._current_state.grid[:, :, closest_workshop_index])[0]\n    actions.extend(move_towards_target(current_pos, target_pos))\n\n    # The agent should now be next to a workshop\n    found_workshop = True\n\n  if found_workshop:\n      actions.append(env.world.n_actions - 1)  # USE action to craft the item\n\n  return actions", "island_id": 5, "scores": {"3": 2.7}}
{"timestamp": "2025-08-19T20:19:40.554278", "function_name": "craft", "function_body": "  def find_closest_workshop(current_pos, grid):\n    distances = {}\n    for idx in env.world.workshop_indices:\n      pos = (idx // grid.shape[1], idx % grid.shape[1])  # Convert index to 2D position\n      distance = np.linalg.norm(np.array(pos) - np.array(current_pos))\n      distances[distance] = pos\n    return distances[min(distances.keys())]\n\n  def find_shortest_path(start, goal, grid):\n    \"\"\"Simple BFS pathfinding.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if (x, y) == goal:\n        return path + [4]  # Append the USE action at the end\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if (nx, ny) not in visited:\n            visited.add((nx, ny))\n            queue.append(((nx, ny), path + [3 - (dy // abs(dy)) if dy != 0 else (dx // abs(dx))]))\n\n    return []  # No valid path found\n\n  cookbook = env.world.cookbook\n  i_item = cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = cookbook.recipes.get(i_item)\n  if not recipe:\n    return []  # No recipe found for the item\n  \n  workshop_key = recipe.get(\"_key\")\n  if workshop_key is None:\n    return []  # The item does not require a workshop to craft\n\n  current_state = env._current_state\n  closest_workshop_pos = find_closest_workshop(current_state.pos, current_state.grid)\n  path_to_workshop = find_shortest_path(current_state.pos, closest_workshop_pos, current_state.grid)\n\n  actions = []\n  actions.extend(path_to_workshop)\n\n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T20:19:41.631923", "function_name": "craft", "function_body": "  def find_closest_entity(grid, entity_index):\n    # This function is supposed to find the closest position of an entity given by its index in the grid\n    positions = np.argwhere(grid[:, :, entity_index] == 1)\n    if len(positions) == 0:\n      return None, float('inf')\n    \n    distances = [np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)) for pos in positions]\n    min_distance_index = np.argmin(distances)\n    return tuple(positions[min_distance_index]), distances[min_distance_index]\n\n  def find_shortest_path(start_pos, end_pos, grid):\n    # This function is supposed to find the shortest path from start_pos to end_pos\n    width, height, _ = grid.shape\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {start_pos: None}\n    \n    while queue:\n      current_pos = queue.popleft()\n      if current_pos == end_pos:\n        break\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n        if (0 <= next_x < width and 0 <= next_y < height) and grid[next_x, next_y].sum() == 0 and (next_x, next_y) not in visited:\n          queue.append((next_x, next_y))\n          visited.add((next_x, next_y))\n          parent[(next_x, next_y)] = current_pos\n    \n    path = []\n    while end_pos is not None:\n      path.append(end_pos)\n      end_pos = parent[end_pos]\n    return list(reversed(path))\n\n  cookbook = env.world.cookbook\n  i_item = cookbook.index[item]\n\n  # Check if the item can be crafted\n  recipe = cookbook.recipes.get(i_item, {})\n  workshop_key = recipe.get(\"_key\")\n  if not workshop_key:\n    return []  # No workshop key found in the recipe\n\n  # Find the closest workshop of the required type\n  current_state = env._current_state\n  closest_workshop_pos, _ = find_closest_entity(current_state.grid, cookbook.index[workshop_key])\n  if closest_workshop_pos is None:\n    return []  # No workshop available\n  \n  # Calculate path to the closest workshop\n  path_to_workshop = find_shortest_path(current_state.pos, closest_workshop_pos, current_state.grid)\n  actions = []\n  for pos in path_to_workshop:\n      dx, dy = pos[0] - current_state.pos[0], pos[1] - current_state.pos[1]\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n      current_state = env._current_state  # Update state after each move\n\n  # Perform the USE action at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n\n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T20:20:05.947298", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  \n  # Get the workshop required for crafting this item\n  recipe = env.world.cookbook.recipes[goal_index]\n  required_workshop_key = next((key for key, value in recipe.items() if \"_key\" in str(key)), None)\n\n  actions = []\n\n  if required_workshop_key:\n    workshop_number = int(required_workshop_key.split('_')[1]) # Extract the workshop number from _key\n    target_workshop_pos = env.world.workshop_indices[workshop_number]\n    \n    # Get current position of the agent in the grid\n    current_pos = env._current_state.pos\n    \n    # Calculate relative movement to reach the workshop\n    delta_x = target_workshop_pos[0] - current_pos[0]\n    delta_y = target_workshop_pos[1] - current_pos[1]\n\n    actions.extend(move_to(env, (delta_x, delta_y)))\n    \n    # Once at the workshop, use the USE action to craft\n    actions.append(4)  # Assuming USE is represented by action index 4\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T20:20:06.993562", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  \n  # Get the workshop required for crafting this item\n  recipe = env.world.cookbook.recipes[goal_index]\n  required_workshop_key = next((key for key, value in recipe.items() if \"_key\" in str(key)), None)\n\n  actions = []\n\n  if required_workshop_key:\n    workshop_number = int(required_workshop_key.split('_')[1]) # Extract the workshop number from _key\n    target_workshop_pos = env.world.workshop_indices[workshop_number]\n    \n    current_state = env._current_state\n    \n    # Calculate relative movement to reach the workshop\n    actions.extend(move_to(env, target_workshop_pos))\n    \n    # Once at the workshop, use the USE action to craft\n    actions.append(4)  # Assuming USE is represented by action index 4\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T20:20:39.297581", "function_name": "craft", "function_body": "  def find_closest_entity(grid, entity_index):\n    positions = np.argwhere(grid[:, :, entity_index])\n    closest_pos = min(positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(current_state.pos)))\n    return tuple(closest_pos)\n\n  def pathfinding(start, goal, grid):\n    # Simple BFS for pathfinding\n    queue = collections.deque([start])\n    visited = set()\n    parent = {}\n\n    while queue:\n      current = queue.popleft()\n      if current == goal:\n        break\n      visited.add(current)\n      x, y = current\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor = (x + dx, y + dy)\n          if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1] and grid[neighbor][env.world.non_grabbable_indices].sum() == 0 and neighbor not in visited:\n              queue.append(neighbor)\n              parent[neighbor] = current\n\n    # Reconstruct path\n    path = []\n    while goal != start:\n        path.append(goal)\n        goal = parent[goal]\n    path.reverse()\n    return [action_map[current - prev] for prev, current in zip(path[:-1], path[1:])]\n\n  cookbook = env.world.cookbook\n  i_item = cookbook.index[item]\n  current_state = env._current_state\n\n  if i_item not in env.world.workshop_indices:\n    return []  # The item does not require a workshop to craft\n\n  closest_workshop_pos, _ = find_closest_entity(current_state.grid, i_item)\n  path_to_workshop = pathfinding(current_state.pos, closest_workshop_pos, current_state.grid)\n\n  actions = path_to_workshop + [4]  # Assuming USE action is represented by index 4\n\n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T20:20:40.347275", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  i_item = cookbook.index[item]\n  \n  if i_item not in cookbook.recipes:\n    return []  # No recipe found for the item\n  \n  workshop_key = cookbook.recipes[i_item].get(\"_key\")\n  if workshop_key is None:\n    return []  # The item does not require a workshop to craft\n\n  current_state = env._current_state\n  closest_workshop_pos, _ = find_closest_entity(current_state.grid, workshop_key)\n  path_to_workshop = pathfinding(current_state.pos, closest_workshop_pos, current_state.grid)\n\n  actions = path_to_workshop + [4]  # Assuming USE action is represented by index 4\n\n  return actions", "island_id": 7, "scores": {"3": 0.0}}
