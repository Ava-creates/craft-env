{"timestamp": "2025-08-19T18:43:16.073634", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Determine the required workshop for crafting (if any)\n  workshop_type = None\n  for recipe_output, recipe in env.world.cookbook.recipes.items():\n    if recipe_output == item_index:\n      if \"_key\" in recipe:\n        workshop_type = recipe[\"_key\"]\n      break\n\n  # If no workshop is needed, return an empty list of actions (assuming the items are already available)\n  if not workshop_type:\n    return []\n\n  # Find the index of the required workshop\n  workshop_index = env.world.cookbook.index[workshop_type]\n\n  # Determine the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # If no workshop is found, return an empty list of actions (this should not happen if the item has a recipe and requires a workshop)\n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose the nearest workshop\n  agent_pos = np.array(env._current_state.pos)\n  nearest_workshop_idx = np.argmin(np.sum((workshop_positions - agent_pos)**2, axis=1))\n  nearest_workshop = tuple(workshop_positions[nearest_workshop_idx])\n\n  actions_to_move = []\n\n  # Calculate the actions needed to move to the nearest workshop\n  while not (env._current_state.pos == nearest_workshop):\n    current_pos = env._current_state.pos\n    x_diff, y_diff = nearest_workshop[0] - current_pos[0], nearest_workshop[1] - current_pos[1]\n\n    # Determine direction of movement\n    if x_diff > 0:\n      actions_to_move.append(env.action_specs()[\"DOWN\"])\n    elif x_diff < 0:\n      actions_to_move.append(env.action_specs()[\"UP\"])\n    \n    if y_diff > 0:\n      actions_to_move.append(env.action_specs()[\"RIGHT\"])\n    elif y_diff < 0:\n      actions_to_move.append(env.action_specs()[\"LEFT\"])\n\n    # Perform the move action\n    _, _, _ = env.step(actions_to_move[-1])\n\n  # Add the USE action to craft the item\n  actions_to_move.append(env.action_specs()[\"USE\"])\n\n  return actions_to_move", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T18:43:17.172416", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Determine if a workshop is required for crafting this item and which type\n  workshop_type = None\n  for recipe_output, recipe in env.world.cookbook.recipes.items():\n    if recipe_output == item_index:\n      if \"_key\" in recipe:\n        workshop_type = recipe[\"_key\"]\n      break\n\n  # If no workshop is needed, return an empty list of actions (assuming the items are already available)\n  if not workshop_type:\n    return []\n\n  # Find the index of the required workshop\n  workshop_index = env.world.cookbook.index[workshop_type]\n\n  # Determine the positions of all workshops of the required type in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  # If no workshops are found, return an empty list of actions (this should not happen if the item has a recipe and requires a workshop)\n  if len(workshop_positions) == 0:\n    return []\n\n  # Calculate the distances from the agent's current position to all workshops\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.sum((workshop_positions - agent_pos)**2, axis=1)\n\n  # Choose the nearest workshop\n  nearest_workshop_idx = np.argmin(distances)\n  nearest_workshop = tuple(workshop_positions[nearest_workshop_idx])\n\n  # Calculate actions needed to move to the nearest workshop\n  actions_to_move = []\n  while env._current_state.pos != nearest_workshop:\n    current_pos = env._current_state.pos\n    x_diff, y_diff = nearest_workshop[0] - current_pos[0], nearest_workshop[1] - current_pos[1]\n\n    if x_diff > 0:\n      actions_to_move.append(env.action_specs()[\"DOWN\"])\n    elif x_diff < 0:\n      actions_to_move.append(env.action_specs()[\"UP\"])\n\n    if y_diff > 0:\n      actions_to_move.append(env.action_specs()[\"RIGHT\"])\n    elif y_diff < 0:\n      actions_to_move.append(env.action_specs()[\"LEFT\"])\n\n    # Perform the move action\n    _, _, _ = env.step(actions_to_move[-1])\n\n  # Add the USE action to craft the item\n  actions_to_move.append(env.action_specs()[\"USE\"])\n\n  return actions_to_move", "island_id": 8, "scores": {"3": 0.0}}
