{"timestamp": "2025-08-19T18:48:28.358830", "function_name": "craft", "function_body": "  def move_towards(target_pos):\n    current_pos = env._current_state.pos\n    x_diff, y_diff = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions = []\n    if x_diff > 0:\n        actions.append(env.action_specs()[\"DOWN\"])\n    elif x_diff < 0:\n        actions.append(env.action_specs()[\"UP\"])\n\n    if y_diff > 0:\n        actions.append(env.action_specs()[\"RIGHT\"])\n    elif y_diff < 0:\n        actions.append(env.action_specs()[\"LEFT\"])\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Determine the required workshop for crafting (if any)\n  workshop_type = None\n  for recipe_output, recipe in env.world.cookbook.recipes.items():\n      if recipe_output == item_index:\n          if \"_key\" in recipe:\n              workshop_type = recipe[\"_key\"]\n          break\n\n  # If no workshop is needed, return an empty list of actions (assuming the items are already available)\n  if not workshop_type:\n      return []\n\n  # Find the index of the required workshop\n  workshop_index = env.world.cookbook.index[workshop_type]\n\n  # Determine the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # If no workshop is found, return an empty list of actions (this should not happen if the item has a recipe and requires a workshop)\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the nearest workshop\n  agent_pos = np.array(env._current_state.pos)\n  nearest_workshop_idx = np.argmin(np.sum((workshop_positions - agent_pos)**2, axis=1))\n  nearest_workshop = tuple(workshop_positions[nearest_workshop_idx])\n\n  actions_to_move = move_towards(nearest_workshop)\n\n  # Add the USE action to craft the item\n  actions_to_move.append(env.action_specs()[\"USE\"])\n\n  return actions_to_move", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T18:48:29.476227", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Determine the required workshop for crafting (if any)\n  workshop_type = None\n  for recipe_output, recipe in env.world.cookbook.recipes.items():\n    if recipe_output == item_index:\n      if \"_key\" in recipe:\n        workshop_type = recipe[\"_key\"]\n      break\n\n  # If no workshop is needed, return an empty list of actions (assuming the items are already available)\n  if not workshop_type:\n    return []\n\n  # Find the index of the required workshop\n  workshop_index = env.world.cookbook.index[workshop_type]\n\n  # Determine the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # If no workshop is found, return an empty list of actions (this should not happen if the item has a recipe and requires a workshop)\n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose the nearest workshop\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.sum((workshop_positions - agent_pos)**2, axis=1)\n  nearest_workshop_idx = np.argmin(distances)\n  nearest_workshop = tuple(workshop_positions[nearest_workshop_idx])\n\n  # Calculate the actions needed to move to the nearest workshop\n  actions_to_move = []\n  \n  while not (env._current_state.pos == nearest_workshop):\n    current_pos = env._current_state.pos\n    x_diff, y_diff = nearest_workshop[0] - current_pos[0], nearest_workshop[1] - current_pos[1]\n\n    # Determine direction of movement\n    if x_diff > 0:\n      actions_to_move.append(env.action_specs()[\"DOWN\"])\n    elif x_diff < 0:\n      actions_to_move.append(env.action_specs()[\"UP\"])\n    \n    if y_diff > 0:\n      actions_to_move.append(env.action_specs()[\"RIGHT\"])\n    elif y_diff < 0:\n      actions_to_move.append(env.action_specs()[\"LEFT\"])\n\n    # Perform the move action\n    _, _, _ = env.step(actions_to_move[-1])\n\n  # Add the USE action to craft the item\n  actions_to_move.append(env.action_specs()[\"USE\"])\n\n  return actions_to_move", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T18:49:28.055702", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Initialize actions list\n  actions = []\n\n  # Find the workshop required for crafting the item\n  for recipe in env.world.cookbook.recipes.values():\n    if recipe[\"_key\"] == item_index:\n      workshop_indices = [ingredient for ingredient, count in recipe.items() if ingredient != \"_key\"]\n      break\n\n  # Filter out non-workshop indices and assume there is only one relevant workshop type\n  workshop_type = next((index for index in workshop_indices if index in env.world.workshop_indices), None)\n\n  if workshop_type is None:\n    raise ValueError(f\"No workshop found for crafting {item}\")\n\n  # Find the position of the closest workshop\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, workshop_type] == 1)\n  \n  if len(positions) == 0:\n    raise ValueError(f\"No workshops of type {workshop_type} found in the grid\")\n\n  # Calculate distances to all workshop positions and find the closest one\n  agent_pos = env._current_state.pos\n  distances = np.linalg.norm(positions - agent_pos, axis=1)\n  closest_workshop_pos = positions[np.argmin(distances)]\n\n  # Convert closest workshop position to actions (need a pathfinding function here)\n  # For simplicity, let's assume we have a function `path_to` that computes the sequence of actions needed to move from one point to another\n  def path_to(start, end):\n      actions = []\n      while start != end:\n          if start[0] < end[0]:\n              actions.append(3)  # RIGHT\n              start = (start[0] + 1, start[1])\n          elif start[0] > end[0]:\n              actions.append(2)  # LEFT\n              start = (start[0] - 1, start[1])\n          elif start[1] < end[1]:\n              actions.append(1)  # UP\n              start = (start[0], start[1] + 1)\n          else:\n              actions.append(0)  # DOWN\n              start = (start[0], start[1] - 1)\n      return actions\n\n  actions.extend(path_to(agent_pos, closest_workshop_pos))\n  \n  # Add the USE action to craft the item\n  actions.append(4)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-19T18:49:29.021905", "function_name": "craft", "function_body": "  # Get the index for the item we want to craft\n  goal_idx = env.world.cookbook.index.index(item)\n\n  # Determine which workshop is needed based on the goal index.\n  # For simplicity, we will assume each recipe requires a specific type of workshop.\n  # In reality, you would need to parse the cookbook recipes to determine this mapping.\n  # Here, we'll use a predefined mapping for demonstration purposes.\n  workshop_mapping = {\n      \"PLANK\": env.world.workshop_indices[0],\n      \"STICK\": env.world.workshop_indices[1],\n      # Add other mappings as needed\n  }\n  workshop_idx = workshop_mapping.get(item, None)\n\n  if workshop_idx is None:\n    raise ValueError(f\"No known workshop for crafting {item}\")\n\n  # Get the agent's current position and direction.\n  pos = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Calculate the direction to move towards the workshop. For simplicity,\n  # we will assume a direct path to the workshop is possible.\n  # In reality, you would need to use a pathfinding algorithm.\n  target_pos = get_workshop_position(env, workshop_idx)\n  direction_to_move = calculate_direction(pos, target_pos)\n\n  # Create a list of actions to move towards the workshop and craft the item.\n  actions = []\n  while pos != target_pos:\n      pos = (pos[0] + direction_to_move[0], pos[1] + direction_to_move[1])\n      actions.append(direction_dict.get(direction_to_move, None))\n      if actions[-1] is None:\n          raise ValueError(\"Invalid movement direction\")\n\n  # Add the USE action to craft the item.\n  actions.append(env.world.n_actions - 1)  # Assuming USE is the last action\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
