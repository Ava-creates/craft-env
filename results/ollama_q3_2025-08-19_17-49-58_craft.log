{"timestamp": "2025-08-19T19:39:56.468829", "function_name": "craft", "function_body": "  def move_to_closest(workshop_positions):\n    current_pos = env._current_state.pos\n    distances = [abs(current_pos[0] - pos[1]) + abs(current_pos[1] - pos[0]) for pos in workshop_positions]\n    closest_workshop_idx = np.argmin(distances)\n    return (workshop_positions[closest_workshop_idx][1], workshop_positions[closest_workshop_idx][0])\n\n  def move_to_position(env, target_pos):\n      current_pos = env._current_state.pos\n      actions = []\n\n      # Calculate the difference in position.\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      # Move horizontally first if necessary.\n      if x_diff < 0:\n          actions.extend([2] * abs(x_diff))  # LEFT\n      elif x_diff > 0:\n          actions.extend([3] * abs(x_diff))  # RIGHT\n\n      # Then move vertically if necessary.\n      if y_diff < 0:\n          actions.extend([1] * abs(y_diff))  # UP\n      elif y_diff > 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  index_map = cookbook.index\n  item_index = index_map[item]\n\n  actions = []\n\n  # Get the workshop key for the item if it exists.\n  if \"_key\" in cookbook.recipes.get(item_index, {}):\n      workshop_key = cookbook.recipes[item_index][\"_key\"]\n      workshop_index = index_map[workshop_key]\n      \n      # Find positions of all workshops with the required type.\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n      \n      if len(workshop_positions) > 0:\n          closest_workshop_pos = move_to_closest(workshop_positions)\n          \n          # Move to the closest workshop.\n          actions.extend(move_to_position(env, closest_workshop_pos))\n      \n      # Perform the crafting action (USE).\n      actions.append(4)  # USE action\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T19:41:03.816139", "function_name": "craft", "function_body": "  def get_direction_actions(current_pos, target_pos):\n      x_diff, y_diff = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n      actions = []\n      while x_diff != 0 or y_diff != 0:\n          if x_diff > 0:\n              actions.append(env.action_specs()[\"DOWN\"])\n              x_diff -= 1\n          elif x_diff < 0:\n              actions.append(env.action_specs()[\"UP\"])\n              x_diff += 1\n          elif y_diff > 0:\n              actions.append(env.action_specs()[\"RIGHT\"])\n              y_diff -= 1\n          elif y_diff < 0:\n              actions.append(env.action_specs()[\"LEFT\"])\n              y_diff += 1\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Determine the required workshop for crafting (if any)\n  workshop_type = None\n  for recipe_output, recipe in env.world.cookbook.recipes.items():\n    if recipe_output == item_index:\n      if \"_key\" in recipe:\n        workshop_type = recipe[\"_key\"]\n      break\n\n  # If no workshop is needed, return an empty list of actions (assuming the items are already available)\n  if not workshop_type:\n    return []\n\n  # Find the index of the required workshop\n  workshop_index = env.world.cookbook.index[workshop_type]\n\n  # Determine the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # If no workshop is found, return an empty list of actions (this should not happen if the item has a recipe and requires a workshop)\n  if len(workshop_positions) == 0:\n    return []\n\n  # Choose the nearest workshop\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.sum((workshop_positions - agent_pos)**2, axis=1)\n  nearest_workshop_idx = np.argmin(distances)\n  nearest_workshop = tuple(workshop_positions[nearest_workshop_idx])\n\n  # Calculate the actions needed to move to the nearest workshop\n  actions_to_move = get_direction_actions(env._current_state.pos, nearest_workshop)\n\n  return actions_to_move + [env.action_specs()[\"USE\"]]", "island_id": 8, "scores": {"3": 0.0}}
