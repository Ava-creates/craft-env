{"timestamp": "2025-09-13T22:59:50.912060", "function_name": "craft", "function_body": "  # The function below checks if we have the item in our inventory. If we do, return empty list.\n  def has_item(item_index):\n    return env._current_state.inventory[item_index] > 0\n\n  # The function below checks if we have the required primitives for the item. \n  # If we don't, we return the list of primitives we need.\n  def missing_primitives(item_index):\n    # Get the recipe for the item from the cookbook\n    recipe = env.world.cookbook.recipes.get(item_index)\n    if recipe is None:\n      # If no recipe, then we cannot craft the item\n      return []\n    # Get the primitives required for the recipe\n    primitives = []\n    for primitive, count in recipe.items():\n      if primitive == \"_at\":\n        continue\n      if not has_item(primitive):\n        primitives.append(primitive)\n    return primitives\n\n  # The function below gets the workshop index from the recipe.\n  def get_workshop_index(item_index):\n    # Get the recipe for the item from the cookbook\n    recipe = env.world.cookbook.recipes.get(item_index)\n    if recipe is None:\n      # If no recipe, then we cannot craft the item\n      return None\n    workshop = recipe.get(\"_at\")\n    # Get the index of the workshop from the environment\n    workshop_index = env.world.index.get(workshop)\n    return workshop_index\n\n  # The function below moves the agent to the workshop.\n  def move_to_workshop(workshop_index):\n    # Get the current position and direction\n    pos = env._current_state.pos\n    dir = env._current_state.dir\n    # Get the workshop location (we assume workshop_index is a kind index)\n    workshop_location = find_entity(env._current_state.grid, workshop_index)\n    if workshop_location is None:\n      # If workshop not found, return empty list\n      return []\n    # Calculate the direction to move to reach the workshop\n    dx = workshop_location[0] - pos[0]\n    dy = workshop_location[1] - pos[1]\n    # Determine the direction to move\n    if dx > 0:\n      move_dir = RIGHT\n    elif dx < 0:\n      move_dir = LEFT\n    elif dy > 0:\n      move_dir = DOWN\n    else:\n      move_dir = UP\n    # Move in the determined direction\n    return [move_dir]\n\n  # The function below finds the location of an entity in the grid.\n  def find_entity(grid, entity_index):\n    # Find the coordinates of the entity in the grid\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, entity_index] > 0:\n          return (i, j)\n    return None\n\n  # The function below collects a primitive.\n  def collect_primitive(primitive):\n    # Collect the primitive using the COLLECT_FUNC\n    # The action list for collecting a primitive is [COLLECT_FUNC, primitive_index]\n    # But we need to find the index of the primitive\n    primitive_index = env.world.index.get(primitive)\n    if primitive_index is None:\n      return []\n    return [COLLECT_FUNC, primitive_index]\n\n  # Get the item index from the environment\n  item_index = env.world.index.get(item)\n  if item_index is None:\n    return []\n\n  # Check if we have the item already\n  if has_item(item_index):\n    return []\n\n  # Check if we are missing any primitives\n  missing = missing_primitives(item_index)\n  if missing:\n    # If we are missing primitives, collect them\n    actions = []\n    for primitive in missing:\n      actions.extend(collect_primitive(primitive))\n    return actions\n\n  # If we have all the primitives, move to the workshop\n  workshop_index = get_workshop_index(item_index)\n  if workshop_index is None:\n    return []\n\n  # Move to the workshop\n  actions = move_to_workshop(workshop_index)\n  if not actions:\n    return []\n\n  # Perform the USE action at the workshop\n  actions.append(USE)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
