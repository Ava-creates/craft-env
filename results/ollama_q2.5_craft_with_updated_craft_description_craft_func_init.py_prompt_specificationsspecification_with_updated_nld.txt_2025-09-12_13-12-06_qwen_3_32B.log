{"timestamp": "2025-09-12T13:46:36.071348", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted.\n  item_index = env.world.cookbook.index.index(item)\n  # Get the recipe for the item.\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check if the recipe is valid.\n  if not recipe:\n      return []\n\n  # Get the required ingredients for the recipe.\n  ingredients = recipe\n\n  # Check if all the ingredients are available in the inventory.\n  inventory = env._current_state.inventory\n  for ingredient, count in ingredients.items():\n      if inventory[ingredient] < count:\n          # If any ingredient is missing, return an empty action list.\n          return []\n\n  # If all ingredients are available, proceed to craft the item.\n  workshop_indices = env.world.workshop_indices\n  # Find the closest workshop of the required type.\n  closest_workshop = None\n  min_distance = float('inf')\n  for workshop_index in workshop_indices:\n      workshop_pos = env._current_state.grid == workshop_index\n      # Find the position of the workshop.\n      for i in range(env._current_state.grid.shape[0]):\n          for j in range(env._current_state.grid.shape[1]):\n              if workshop_pos[i][j]:\n                  # Calculate the distance between the agent and the workshop.\n                  distance = abs(env._current_state.pos[0] - i) + abs(env._current_state.pos[1] - j)\n                  if distance < min_distance:\n                      min_distance = distance\n                      closest_workshop = (i, j)\n                      break\n          if closest_workshop:\n              break\n\n  # If no workshop is found, return an empty action list.\n  if not closest_workshop:\n      return []\n\n  # Move to the workshop.\n  actions = []\n  current_pos = env._current_state.pos\n  while current_pos != closest_workshop:\n      # Calculate the direction to move.\n      if closest_workshop[0] < current_pos[0]:\n          actions.append(craft.CraftWorld.DOWN)\n      elif closest_workshop[0] > current_pos[0]:\n          actions.append(craft.CraftWorld.UP)\n      if closest_workshop[1] < current_pos[1]:\n          actions.append(craft.CraftWorld.LEFT)\n      elif closest_workshop[1] > current_pos[1]:\n          actions.append(craft.CraftWorld.RIGHT)\n      # Execute the action and update the current position.\n      reward, done, observations = env.step(actions[-1])\n      current_pos = env._current_state.pos\n\n  # Once at the workshop, perform the USE action to craft the item.\n  actions.append(craft.CraftWorld.USE)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
