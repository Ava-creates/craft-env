{"timestamp": "2025-09-12T13:18:33.329934", "function_name": "craft", "function_body": "  # Get the item index\n  item_idx = env.world.cookbook.index.index(item)\n\n  # Check if the item is a primitive\n  if item_idx in env.world.cookbook.primitives:\n    return collect(env, item)\n\n  # Check if the item can be crafted\n  if item_idx not in env.world.cookbook.recipes:\n    return []\n\n  # Get the recipe\n  recipe = env.world.cookbook.recipes[item_idx]\n\n  # Check if the recipe has the \"_key\" field (the workshop where the item can be crafted)\n  if \"_key\" not in recipe:\n    return []\n\n  workshop_idx = recipe[\"_key\"]\n\n  # Check if the workshop is present in the environment\n  workshop_pos = None\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[x, y, workshop_idx] > 0:\n        workshop_pos = (x, y)\n        break\n    if workshop_pos:\n      break\n\n  if not workshop_pos:\n    return []\n\n  # Move to the workshop\n  move_actions = move_to(env, workshop_pos)\n  if not move_actions:\n    return []\n\n  # Check if all the ingredients are present in the inventory\n  for ingredient_idx, count in recipe.items():\n    if ingredient_idx == \"_key\":\n      continue\n    if env._current_state.inventory[ingredient_idx] < count:\n      return []\n\n  # Craft the item\n  move_actions.append(crafting.ACTION_USE)\n  return move_actions", "island_id": 9, "scores": {"3": 0.0}}
