{"timestamp": "2025-09-12T13:22:55.992041", "function_name": "craft", "function_body": "  # Get the index of the item in the environment's cookbook index\n  index = env.scenario.world.cookbook.index\n  item_idx = index.index(item)\n  if item_idx == 0:\n    return []\n  # Get the recipe for the item\n  recipes = env.scenario.world.cookbook.recipes\n  if item_idx not in recipes:\n    return []\n  recipe = recipes[item_idx]\n\n  # Check if we have all the required ingredients\n  required_ingredients = recipe\n  inventory = env._current_state.inventory\n  for ingredient, count in required_ingredients.items():\n    if inventory[ingredient] < count:\n      return []\n\n  # If we have all the required ingredients, go to the workshop and use it\n  workshop_idx = recipe[\"_key\"]\n  workshop_name = index.get(workshop_idx)\n  workshop_pos = np.where(env._current_state.grid[:, :, workshop_idx] > 0)\n  if len(workshop_pos[0]) == 0:\n    return []\n  workshop_pos = (workshop_pos[0][0], workshop_pos[1][0])\n  actions = go_to(env, workshop_pos)\n  actions.append(env.action_specs()[craft.ACTION_USE])\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-12T13:23:51.894952", "function_name": "craft", "function_body": "  # Get the index of the item in the environment's cookbook index\n  index = env.scenario.world.cookbook.index\n  item_idx = index.index(item)\n\n  # Check if the item has a recipe in the cookbook\n  cookbook = env.scenario.world.cookbook\n  if item_idx not in cookbook.recipes:\n    return []\n\n  # Get the required ingredients for the item\n  recipe = cookbook.recipes[item_idx]\n  ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n\n  # Check if we have all the required ingredients in the inventory\n  inventory = env._current_state.inventory\n  for ing_idx, count in ingredients.items():\n    if inventory[ing_idx] < count:\n      return []\n\n  # Find the workshop index for the item's recipe\n  workshop_idx = recipe.get(\"_key\")\n  if workshop_idx is None:\n    return []\n\n  # Find the position of the workshop in the grid\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  workshop_pos = None\n  for x in range(grid.shape[0]):\n    for y in range(grid.shape[1]):\n      if grid[x, y, workshop_idx] > 0:\n        workshop_pos = (x, y)\n        break\n    if workshop_pos is not None:\n      break\n\n  if workshop_pos is None:\n    return []\n\n  # Move to the workshop position\n  actions = []\n  dx, dy = workshop_pos[0] - pos[0], workshop_pos[1] - pos[1]\n  if dx > 0:\n    actions.extend([env.action_specs()['DOWN']] * dx)\n  elif dx < 0:\n    actions.extend([env.action_specs()['UP']] * (-dx))\n  if dy > 0:\n    actions.extend([env.action_specs()['RIGHT']] * dy)\n  elif dy < 0:\n    actions.extend([env.action_specs()['LEFT']] * (-dy))\n\n  # Use the workshop to craft the item\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-12T13:23:53.887676", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted.\n  item_index = env.world.cookbook.index.index(item)\n  # Get the recipe for the item.\n  recipe = env.world.cookbook.recipes.get(item_index)\n  # If the item is a primitive, return an empty list of actions.\n  if item_index in env.world.cookbook.primitives:\n    return []\n  # Get the required ingredients for the item.\n  ingredients = recipe\n  # Check if all the required ingredients are present in the inventory.\n  inventory = env._current_state.inventory\n  for ingredient in ingredients:\n    if inventory[ingredient] < ingredients[ingredient]:\n      return []\n  # Get the workshop where the item can be crafted.\n  workshop = ingredients[\"_key\"]\n  # Move to the workshop.\n  actions = move_to(env, workshop)\n  if not actions:\n    return []\n  # Use the workshop to craft the item.\n  actions.append(env.action_specs()[env.action_specs().keys()[-1]])\n  return actions", "island_id": 1, "scores": {"3": -1}}
