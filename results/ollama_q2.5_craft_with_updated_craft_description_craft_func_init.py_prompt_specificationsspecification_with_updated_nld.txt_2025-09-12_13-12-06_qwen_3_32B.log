{"timestamp": "2025-09-12T15:28:45.667818", "function_name": "craft", "function_body": "  # Get the index of the item in the environment's cookbook\n  index = env.scenario.world.cookbook.index\n  item_idx = index.index(item)\n  \n  # Check if the item is a primitive\n  if item_idx in env.scenario.world.cookbook.primitives:\n      return []  # Primitives cannot be crafted, they can only be collected\n  \n  # Get the recipe for the item\n  recipe = env.scenario.world.cookbook.recipes.get(item_idx, {})\n  \n  # Check if the recipe is empty\n  if not recipe:\n      return []  # No recipe for the item\n  \n  # Check if the workshop is specified in the recipe\n  workshop_idx = recipe.get('_key', None)\n  if workshop_idx is None:\n      return []  # No workshop specified for the item\n  \n  # Get the position of the workshop in the environment\n  grid = env._current_state.grid\n  workshop_pos = None\n  for x in range(grid.shape[0]):\n      for y in range(grid.shape[1]):\n          if grid[x, y, workshop_idx] > 0:\n              workshop_pos = (x, y)\n              break\n      if workshop_pos is not None:\n          break\n  \n  # If no workshop is found, return empty action list\n  if workshop_pos is None:\n      return []\n  \n  # Move to the workshop\n  pos = env._current_state.pos\n  dir = env._current_state.dir\n  actions = []\n  \n  # Calculate the direction to the workshop\n  dx = workshop_pos[0] - pos[0]\n  dy = workshop_pos[1] - pos[1]\n  \n  # If the workshop is in the same position, just use it\n  if dx == 0 and dy == 0:\n      actions.append(env.action_specs()[env.action_specs().index('USE')])\n  else:\n      # Otherwise, move towards the workshop\n      if dx > 0:\n          actions.append(env.action_specs()[env.action_specs().index('RIGHT')])\n      elif dx < 0:\n          actions.append(env.action_specs()[env.action_specs().index('LEFT')])\n      if dy > 0:\n          actions.append(env.action_specs()[env.action_specs().index('DOWN')])\n      elif dy < 0:\n          actions.append(env.action_specs()[env.action_specs().index('UP')])\n  \n  # Use the workshop to craft the item\n  actions.append(env.action_specs()[env.action_specs().index('USE')])\n  \n  return actions", "island_id": 9, "scores": {"3": 0.0}}
