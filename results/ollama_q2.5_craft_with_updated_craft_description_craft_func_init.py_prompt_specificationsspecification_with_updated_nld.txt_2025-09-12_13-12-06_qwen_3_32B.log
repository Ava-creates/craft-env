{"timestamp": "2025-09-12T13:21:43.803394", "function_name": "craft", "function_body": "  def get_recipe_requirements(recipe):\n    # Get the recipe requirements for the item to be crafted\n    required_items = {}\n    for ingredient, count in recipe.items():\n      if ingredient != '_key':\n        required_items[ingredient] = count\n    return required_items\n\n  def check_inventory(required_items):\n    # Check if the required items are present in the inventory\n    for ingredient, count in required_items.items():\n      if env._current_state.inventory[ingredient] < count:\n        return False\n    return True\n\n  def move_to_workshop(workshop_index):\n    # Move to the workshop location\n    workshop_pos = None\n    for i in range(env._current_state.grid.shape[0]):\n      for j in range(env._current_state.grid.shape[1]):\n        if env._current_state.grid[i][j][workshop_index] > 0:\n          workshop_pos = (i, j)\n          break\n      if workshop_pos:\n        break\n\n    if workshop_pos is None:\n      return []\n\n    current_pos = env._current_state.pos\n    actions = []\n    # Move to the workshop\n    if current_pos[0] < workshop_pos[0]:\n      actions.append(craft.UP)\n    elif current_pos[0] > workshop_pos[0]:\n      actions.append(craft.DOWN)\n    elif current_pos[1] < workshop_pos[1]:\n      actions.append(craft.RIGHT)\n    elif current_pos[1] > workshop_pos[1]:\n      actions.append(craft.LEFT)\n    return actions\n\n  # Get the index of the item to be crafted\n  item_index = env.world.cookbook.index.index(item)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe is None:\n    return []\n\n  required_items = get_recipe_requirements(recipe)\n  if not check_inventory(required_items):\n    return []\n\n  # Find the workshop for the item\n  workshop_index = recipe.get('_key')\n  if workshop_index is None:\n    return []\n\n  # Move to the workshop and use it\n  actions = move_to_workshop(workshop_index)\n  actions.append(craft.USE)\n  return actions", "island_id": 2, "scores": {"3": -1}}
