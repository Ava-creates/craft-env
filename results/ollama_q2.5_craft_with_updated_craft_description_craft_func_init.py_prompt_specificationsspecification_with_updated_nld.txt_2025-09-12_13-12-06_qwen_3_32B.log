{"timestamp": "2025-09-12T13:20:22.143689", "function_name": "craft", "function_body": "  def get_recipe_info(item_name):\n    recipe = env.world.cookbook.recipes.get(item_index)\n    if not recipe:\n      return None\n    required_items = {}\n    for key, value in recipe.items():\n      if key == '_key':\n        continue\n      item_idx = key\n      count = value\n      required_items[env.world.cookbook.index.get(env.world.cookbook.index.reverse_contents.get(item_idx))] = count\n    return required_items\n\n  def check_inventory(required_items):\n    for item_name, required_count in required_items.items():\n      current_count = env._current_state.inventory[env.world.cookbook.index.get(item_name)]\n      if current_count < required_count:\n        return False\n    return True\n\n  def collect_missing_items(required_items):\n    for item_name, required_count in required_items.items():\n      current_count = env._current_state.inventory[env.world.cookbook.index.get(item_name)]\n      if current_count < required_count:\n        return [COLLECT_FUNC, item_name]\n    return []\n\n  def move_to_workshop():\n    workshop_name = recipe.get('_key', None)\n    if not workshop_name:\n      return []\n    workshop_index = env.world.cookbook.index.get(workshop_name)\n    # Find position of the workshop\n    grid = env._current_state.grid\n    pos = np.where(grid[:, :, workshop_index] > 0)\n    if len(pos[0]) == 0:\n      return []\n    workshop_pos = (pos[0][0], pos[1][0])\n    # Move to the workshop\n    return navigate_to_position(workshop_pos)\n\n  def navigate_to_position(target_pos):\n    current_pos = env._current_state.pos\n    # Determine direction to move\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n    if dx > 0:\n      return [DOWN] * dx\n    elif dx < 0:\n      return [UP] * (-dx)\n    elif dy > 0:\n      return [RIGHT] * dy\n    elif dy < 0:\n      return [LEFT] * (-dy)\n    return []\n\n  def use_workshop():\n    return [USE]\n\n  # Main logic\n  item_index = env.world.cookbook.index.get(item)\n  if item_index is None:\n    return []\n\n  recipe = get_recipe_info(item)\n  if not recipe:\n    return []\n\n  if not check_inventory(recipe):\n    return collect_missing_items(recipe)\n\n  workshop_actions = move_to_workshop()\n  if not workshop_actions:\n    return []\n\n  return workshop_actions + use_workshop()\n\n  return []", "island_id": 0, "scores": {"3": -1}}
