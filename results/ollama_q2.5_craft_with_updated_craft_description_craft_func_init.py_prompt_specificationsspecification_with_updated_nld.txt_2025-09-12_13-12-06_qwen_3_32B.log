{"timestamp": "2025-09-12T15:29:37.199774", "function_name": "craft", "function_body": "  # Get the index of the item in the environment's cookbook.\n  item_index = env.world.cookbook.index.index(item)\n  # Get the recipe for the item.\n  recipe = env.world.cookbook.recipes[item_index]\n  # Check if the recipe is valid.\n  if not recipe:\n    return []\n  # Get the list of required ingredients.\n  ingredients = list(recipe.keys())\n  # Check if we have all the required ingredients.\n  inventory = env._current_state.inventory\n  for ingredient in ingredients:\n    if inventory[ingredient] < recipe[ingredient]:\n      return []\n  # Get the workshop where the item can be crafted.\n  workshop = recipe[\"_key\"]\n  # Get the index of the workshop in the environment's cookbook.\n  workshop_index = env.world.cookbook.index.index(workshop)\n  # Get the position of the workshop.\n  workshop_pos = np.where(env._current_state.grid[:, :, workshop_index] > 0)\n  if len(workshop_pos[0]) == 0:\n    return []\n  workshop_pos = (workshop_pos[0][0], workshop_pos[1][0])\n  # Move to the workshop.\n  actions = []\n  pos = env._current_state.pos\n  while pos != workshop_pos:\n    # Calculate the direction to move.\n    if workshop_pos[0] < pos[0]:\n      actions.append(craft.LEFT)\n    elif workshop_pos[0] > pos[0]:\n      actions.append(craft.RIGHT)\n    elif workshop_pos[1] < pos[1]:\n      actions.append(craft.UP)\n    else:\n      actions.append(craft.DOWN)\n    # Execute the action.\n    reward, done, _ = env.step(actions[-1])\n    pos = env._current_state.pos\n    if done:\n      return []\n  # Use the workshop to craft the item.\n  actions.append(craft.USE)\n  return actions", "island_id": 7, "scores": {"3": -1}}
