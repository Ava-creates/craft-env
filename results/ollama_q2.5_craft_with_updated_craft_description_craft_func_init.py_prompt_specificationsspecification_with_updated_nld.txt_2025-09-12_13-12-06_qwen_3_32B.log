{"timestamp": "2025-09-12T13:14:12.408545", "function_name": "craft", "function_body": "  recipe = env.world.cookbook.recipes.get(item)\n  if recipe is None:\n      return []\n  ingredients = {}\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue\n      ingredient_name = env.world.cookbook.index.get(ingredient)\n      ingredients[ingredient_name] = count\n  workshop = recipe[\"_key\"]\n  workshop_name = env.world.cookbook.index.get(workshop)\n  actions = []\n  # Check if all ingredients are in inventory\n  for ingredient_name, count in ingredients.items():\n      if env._current_state.inventory[env.world.cookbook.index.index(ingredient_name)] < count:\n          return []\n  # Move to workshop\n  workshop_pos = None\n  for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[y, x, env.world.cookbook.index.index(workshop_name)] > 0:\n              workshop_pos = (x, y)\n              break\n      if workshop_pos:\n          break\n  if workshop_pos is None:\n      return []\n  # Move to workshop\n  x, y = env._current_state.pos\n  wx, wy = workshop_pos\n  dx = wx - x\n  dy = wy - y\n  while dx < 0:\n      actions.append(craft.LEFT)\n      dx += 1\n  while dx > 0:\n      actions.append(craft.RIGHT)\n      dx -= 1\n  while dy < 0:\n      actions.append(craft.UP)\n      dy += 1\n  while dy > 0:\n      actions.append(craft.DOWN)\n      dy -= 1\n  # Use workshop\n  actions.append(craft.USE)\n  return actions\n  return []", "island_id": 6, "scores": {"3": 0.0}}
