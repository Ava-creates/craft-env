{"timestamp": "2025-09-12T15:11:45.297326", "function_name": "craft", "function_body": "  def get_recipe(item):\n    \"\"\"\n    Helper function to extract the recipe for the given item from the environment's cookbook.\n    If the item is a primitive, return None.\n    \"\"\"\n    cookbook = env._current_state.scenario.world.cookbook\n    if item in cookbook.primitives:\n      return None\n    if item in cookbook.recipes:\n      return cookbook.recipes[item]\n    return None\n\n  def check_prerequisites(recipe):\n    \"\"\"\n    Check if all required ingredients for the recipe are available in the inventory.\n    \"\"\"\n    inventory = env._current_state.inventory\n    for ingredient, count in recipe.items():\n      if inventory[ingredient] < count:\n        return False\n    return True\n\n  def find_and_move_to_workshop(item):\n    \"\"\"\n    Find the workshop required for the given item and move to it.\n    \"\"\"\n    current_pos = env._current_state.pos\n    workshop_index = env._current_state.scenario.world.cookbook.recipes[item][\"_key\"]\n    workshop_name = env._current_state.scenario.world.cookbook.reverse_contents[workshop_index]\n    workshop_pos = find_position(env._current_state.grid, workshop_index)\n    # Calculate the direction to move towards the workshop\n    # This is a simplified example; actual pathfinding would be more complex\n    if workshop_pos is None:\n      return []  # Workshop not found\n    # Generate movement actions to reach the workshop\n    return move_to_position(current_pos, workshop_pos)\n\n  def find_position(grid, kind_index):\n    \"\"\"\n    Find the position of the specified kind in the grid.\n    \"\"\"\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if grid[y, x, kind_index] > 0:\n          return (x, y)\n    return None\n\n  def move_to_position(current_pos, target_pos):\n    \"\"\"\n    Generate a list of movement actions to move from current_pos to target_pos.\n    \"\"\"\n    # This is a simplified example; actual pathfinding would be more complex\n    actions = []\n    x, y = current_pos\n    tx, ty = target_pos\n    while x != tx or y != ty:\n      if x < tx:\n        actions.append(craft.RIGHT)\n        x += 1\n      elif x > tx:\n        actions.append(craft.LEFT)\n        x -= 1\n      elif y < ty:\n        actions.append(craft.DOWN)\n        y += 1\n      elif y > ty:\n        actions.append(craft.UP)\n        y -= 1\n    return actions\n\n  def craft_item():\n    \"\"\"\n    Perform the USE action to craft the item at the workshop.\n    \"\"\"\n    return [craft.USE]\n\n  # Main function logic\n  recipe = get_recipe(item)\n  if recipe is None:\n    return []  # Item is a primitive, cannot be crafted\n\n  if not check_prerequisites(recipe):\n    return []  # Not all ingredients are available\n\n  move_actions = find_and_move_to_workshop(item)\n  if not move_actions:\n    return []  # Could not find or reach the workshop\n\n  return move_actions + craft_item()\n  return []", "island_id": 6, "scores": {"3": 0.0}}
