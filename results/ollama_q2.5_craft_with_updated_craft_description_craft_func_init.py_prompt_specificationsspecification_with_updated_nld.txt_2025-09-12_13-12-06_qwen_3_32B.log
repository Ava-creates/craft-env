{"timestamp": "2025-09-12T15:09:54.810324", "function_name": "craft", "function_body": "  def get_workshop_index(recipe_item):\n    # Get the workshop index for the recipe\n    workshop_index = env.world.cookbook.recipes[recipe_item].get('_key', None)\n    if workshop_index is None:\n      workshop_index = 0  # Default to first workshop if not specified\n    return workshop_index\n\n  # Check if the item is a valid goal in the environment\n  if item not in env.world.cookbook.index.reverse_contents:\n    return []\n\n  # Convert the item name to its index\n  item_index = env.world.cookbook.index.index(item)\n\n  # Check if the recipe exists for the item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  recipe = env.world.cookbook.recipes[item_index]\n  if '_key' in recipe:\n    del recipe['_key']\n\n  # Check if all required ingredients are available in inventory\n  current_inventory = env._current_state.inventory.copy()\n  for ingredient, count in recipe.items():\n    if current_inventory[ingredient] < count:\n      return []  # Not all ingredients are available\n\n  # Get the workshop index for the recipe\n  workshop_index = get_workshop_index(item_index)\n\n  # Check if the workshop is present in the environment\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  if workshop_name not in env.world.cookbook.index.reverse_contents:\n    return []\n\n  # Get the position of the workshop\n  grid = env._current_state.grid\n  workshop_pos = None\n  for x in range(grid.shape[0]):\n    for y in range(grid.shape[1]):\n      if grid[x, y, workshop_index] > 0:\n        workshop_pos = (x, y)\n        break\n    if workshop_pos is not None:\n      break\n\n  if workshop_pos is None:\n    return []  # Workshop not found\n\n  # Calculate the direction to face the workshop\n  current_pos = env._current_state.pos\n  dx = workshop_pos[0] - current_pos[0]\n  dy = workshop_pos[1] - current_pos[1]\n\n  if dx > 0:\n    dir = craft.DOWN\n  elif dx < 0:\n    dir = craft.UP\n  elif dy > 0:\n    dir = craft.RIGHT\n  else:\n    dir = craft.LEFT\n\n  # Move to the workshop position\n  move_actions = []\n  while env._current_state.pos != workshop_pos:\n    action = dir\n    move_actions.append(action)\n    reward, done, observations = env.step(action)\n    if done:\n      return []\n\n  # Face the workshop\n  current_dir = env._current_state.dir\n  target_dir = 0  # Assuming the workshop is to the right\n  if current_dir != target_dir:\n    turn_actions = []\n    while current_dir != target_dir:\n      turn_actions.append(craft.RIGHT)\n      current_dir = (current_dir + 1) % 4\n    move_actions.extend(turn_actions)\n\n  # Use the workshop to craft the item\n  move_actions.append(craft.USE)\n\n  return move_actions", "island_id": 9, "scores": {"3": 0.0}}
