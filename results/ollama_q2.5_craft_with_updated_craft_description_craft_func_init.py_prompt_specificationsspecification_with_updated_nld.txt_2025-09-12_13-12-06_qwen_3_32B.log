{"timestamp": "2025-09-12T15:14:26.716073", "function_name": "craft", "function_body": "  def get_recipe_items(recipe):\n    # Extract the list of items (as indices) required for the recipe\n    return list(recipe.keys())\n\n  def has_all_items(items):\n    # Check if all items in the list are present in the inventory\n    for i in items:\n      if env._current_state.inventory[i] <= 0:\n        return False\n    return True\n\n  def move_to_workshop(workshop_index):\n    # Find the location of the workshop and move there\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    workshop_pos = None\n    for x in range(grid.shape[0]):\n      for y in range(grid.shape[1]):\n        if grid[x, y, workshop_index] > 0:\n          workshop_pos = (x, y)\n          break\n      if workshop_pos:\n        break\n\n    if not workshop_pos:\n      return []\n\n    # Calculate the direction to move\n    actions = []\n    dx = workshop_pos[0] - pos[0]\n    dy = workshop_pos[1] - pos[1]\n\n    while dx != 0 or dy != 0:\n      if dx > 0:\n        actions.append(craft.RIGHT)\n        dx -= 1\n      elif dx < 0:\n        actions.append(craft.LEFT)\n        dx += 1\n      elif dy > 0:\n        actions.append(craft.DOWN)\n        dy -= 1\n      elif dy < 0:\n        actions.append(craft.UP)\n        dy += 1\n    return actions\n\n  recipe = env.world.cookbook.recipes.get(item, {})\n  if not recipe:\n    return []\n\n  required_items = get_recipe_items(recipe)\n  if not has_all_items(required_items):\n    return []\n\n  workshop_index = env.world.cookbook.index.index[workshop]\n  actions = move_to_workshop(workshop_index)\n  actions.append(craft.USE)\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
