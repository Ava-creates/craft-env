{"timestamp": "2025-09-12T15:03:29.178574", "function_name": "craft", "function_body": "  # Get the index of the item in the cookbook\n  cookbook = env.world.cookbook\n  item_index = cookbook.index.index(item)\n  item_recipe = cookbook.recipes.get(item_index)\n  if not item_recipe:\n    return []  # Cannot craft this item\n\n  # Check if all required ingredients are present in inventory\n  inventory = env._current_state.inventory\n  required_ingredients = item_recipe\n  for ingredient_idx, count in required_ingredients.items():\n    if inventory[ingredient_idx] < count:\n      return []  # Not enough of this ingredient\n\n  # Move to the workshop location specified in the recipe\n  workshop_idx = item_recipe.get(\"_key\")\n  if not workshop_idx:\n    return []  # No workshop specified for this item\n\n  workshop_name = cookbook.index.get(workshop_idx)\n  workshop_index = cookbook.index.index(workshop_name)\n  workshop_positions = np.argwhere(env._current_state.grid[..., workshop_index] > 0)\n  if len(workshop_positions) == 0:\n    return []  # Workshop not found in the grid\n\n  workshop_pos = workshop_positions[0]\n  current_pos = env._current_state.pos\n  dir_to_workshop = get_direction(current_pos, workshop_pos)\n  if dir_to_workshop is None:\n    return []  # Workshop not in adjacent cells\n\n  # Move towards the workshop\n  actions = []\n  while env._current_state.pos != workshop_pos:\n    actions.append(dir_to_workshop)\n    reward, done, observations = env.step(dir_to_workshop)\n    if done:\n      return actions\n    # Update current state\n    env._current_state = observations['features_dict']['state']\n\n  # Once at the workshop, perform the USE action to craft the item\n  actions.append(env.action_specs()[craft.ACTION_USE])\n  return actions", "island_id": 4, "scores": {"3": -1}}
