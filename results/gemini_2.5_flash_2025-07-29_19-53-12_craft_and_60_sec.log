{"timestamp": "2025-07-29T20:09:25.613399", "function_name": "craft", "function_body": "  world = env.world\n  cookbook = world.cookbook\n  initial_craft_state = env._current_state\n\n  # Action constants (from DMLab-style action space)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n  MOVE_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]\n\n  # Memoization cache for (state_hash, target_item_id) -> list_of_actions\n  # This cache stores results for solving a sub-problem from a specific state\n  # to avoid redundant computations.\n  _memo = {} \n\n  def _get_state_hash(state):\n      \"\"\"\n      Generates a hashable tuple representing the current CraftState.\n      Includes agent's position, direction, current inventory, and the entire grid state.\n      Using .tobytes() for numpy arrays for efficient hashing.\n      \"\"\"\n      return (state.pos, state.dir, state.inventory.tobytes(), state.grid.tobytes())\n\n  def _plan_item_recursive(current_state, target_item, depth):\n      \"\"\"\n      Recursively plans the actions required to obtain a target item from a given state.\n      It handles both picking up primitive items and crafting items from recipes.\n      \"\"\"\n      # Set a maximum depth to prevent infinite recursion in cyclic dependencies\n      # or if a solution path is excessively long.\n      MAX_PLANNING_DEPTH = 50 \n      if depth > MAX_PLANNING_DEPTH:\n          return None # Exceeded depth limit, plan not found on this path\n\n      current_state_hash = _get_state_hash(current_state)\n      # Check if this sub-problem from this exact state has already been solved.\n      if (current_state_hash, target_item) in _memo:\n          return _memo[(current_state_hash, target_item)]\n\n      # Base case: If the target item is already in inventory, no actions are needed.\n      if current_state.inventory[target_item] > 0:\n          _memo[(current_state_hash, target_item)] = []\n          return []\n\n      # --- Attempt to obtain the item ---\n\n      # 1. Try to pick up the item if it's a primitive and can be grabbed.\n      if target_item in cookbook.primitives and target_item in world.grabbable_indices:\n          # Use Breadth-First Search (BFS) to find the shortest path to a cell\n          # adjacent to the item, then apply the USE action.\n          q = collections.deque([(current_state, [])])\n          # Keep track of visited states (including grid/inventory) to avoid cycles\n          # and redundant path explorations in the BFS.\n          visited_states_in_bfs = {current_state_hash} \n          \n          while q:\n              s, path = q.popleft()\n              \n              # If the agent is next to the target primitive, attempt to pick it up.\n              if s.next_to(target_item):\n                  _, next_s = s.step(ACTION_USE)\n                  # Check if the item was successfully picked up (inventory increased).\n                  if next_s.inventory[target_item] > s.inventory[target_item]:\n                      actions_found = path + [ACTION_USE]\n                      _memo[(current_state_hash, target_item)] = actions_found\n                      return actions_found # Successfully found a plan for this primitive\n              \n              # Explore movement actions (UP, DOWN, LEFT, RIGHT) from the current position.\n              for action in MOVE_ACTIONS:\n                  _, next_s = s.step(action) # s.step returns a new CraftState\n                  next_s_hash = _get_state_hash(next_s)\n                  if next_s_hash not in visited_states_in_bfs:\n                      visited_states_in_bfs.add(next_s_hash)\n                      q.append((next_s, path + [action]))\n          # If BFS completes without finding the item, it's not reachable or grabbable from here.\n\n      # 2. Try to craft the item if a recipe exists in the cookbook.\n      if target_item in cookbook.recipes:\n          recipe = cookbook.recipes[target_item]\n          ingredients_needed = {}\n          for ing_id_val, count in recipe.items():\n              if ing_id_val == \"_key\": # \"_key\" is a special identifier, not an ingredient.\n                  continue\n              ingredients_needed[int(ing_id_val)] = count # Ensure ingredient IDs are integers.\n\n          current_plan_for_crafting = []\n          # `current_planning_state` tracks the state as we gather ingredients.\n          current_planning_state = current_state \n\n          # Recursively plan to gather all required ingredients for the recipe.\n          all_ingredients_collected = True\n          for ing_id, needed_count in ingredients_needed.items():\n              while current_planning_state.inventory[ing_id] < needed_count:\n                  # Plan to obtain one unit of the current ingredient.\n                  actions_for_ing = _plan_item_recursive(current_planning_state, ing_id, depth + 1)\n                  if actions_for_ing is None:\n                      all_ingredients_collected = False\n                      break # Failed to obtain an ingredient, thus cannot craft the main item.\n                  \n                  current_plan_for_crafting.extend(actions_for_ing)\n                  # Apply the actions to update `current_planning_state` for the next sub-goal.\n                  for action in actions_for_ing:\n                      _, current_planning_state = current_planning_state.step(action)\n              if not all_ingredients_collected:\n                  break # Break from ingredients loop if any ingredient failed to be collected.\n\n          if all_ingredients_collected:\n              # All ingredients are now gathered. Proceed to craft at the workshop.\n              workshop_kind_id = None\n              if \"_key\" in recipe: # A specific crafting station might be specified in the recipe.\n                  workshop_kind_id = cookbook.index[recipe[\"_key\"]]\n              elif world.workshop_indices: # Otherwise, use a general workshop if available.\n                  workshop_kind_id = world.workshop_indices[0] # Assume the first available workshop is suitable.\n\n              if workshop_kind_id is None:\n                  # No valid workshop specified or found for this recipe, cannot craft.\n                  pass \n              else:\n                  # BFS to find the shortest path to the workshop and then use it.\n                  q = collections.deque([(current_planning_state, [])])\n                  visited_states_in_bfs = {_get_state_hash(current_planning_state)}\n                  \n                  temp_craft_actions = None # To store actions specifically for reaching and using the workshop.\n                  while q:\n                      s, path = q.popleft()\n                      \n                      # If the agent is next to the workshop, attempt to USE it.\n                      if s.next_to(workshop_kind_id):\n                          _, next_s = s.step(ACTION_USE)\n                          # Check if crafting was successful (target item count increased).\n                          if next_s.inventory[target_item] > s.inventory[target_item]:\n                              temp_craft_actions = path + [ACTION_USE]\n                              break # Found a path to successfully craft the item.\n                      \n                      # Explore movement actions.\n                      for action in MOVE_ACTIONS:\n                          _, next_s = s.step(action)\n                          next_s_hash = _get_state_hash(next_s)\n                          if next_s_hash not in visited_states_in_bfs:\n                              visited_states_in_bfs.add(next_s_hash)\n                              q.append((next_s, path + [action]))\n                  \n                  if temp_craft_actions:\n                      # Combine the plan for gathering ingredients with the plan for crafting.\n                      actions_found = current_plan_for_crafting + temp_craft_actions\n                      _memo[(current_state_hash, target_item)] = actions_found\n                      return actions_found # Successfully found a plan for crafting.\n\n      # If the item cannot be obtained either by picking it up (if primitive)\n      # or by crafting it (if recipe exists), return None.\n      _memo[(current_state_hash, target_item)] = None # Memoize this failure to avoid re-attempting.\n      return None\n\n  # Start the planning process from the initial environment state.\n  final_plan = _plan_item_recursive(initial_craft_state, item_id, 0)\n  \n  if final_plan is None:\n      return [] # Return an empty list if no valid plan is found.\n  else:\n      return final_plan", "island_id": 4, "scores": {"3": -1}}
