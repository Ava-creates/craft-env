{"timestamp": "2025-08-15T13:53:11.209766", "function_name": "collect", "function_body": "  # Get the index of the primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Check if the agent already has this primitive in inventory\n  if state.inventory[primitive_index] > 0:\n      return state, reward, action_list\n\n  # Find all cells that contain the primitive\n  primitive_positions = []\n  for i in range(state.grid.shape[0]):\n      for j in range(state.grid.shape[1]):\n          if state.grid[i, j, primitive_index] == 1:\n              primitive_positions.append((i, j))\n\n  # If no positions found, return empty action list\n  if not primitive_positions:\n      return state, reward, action_list\n\n  # Use BFS to find the shortest path from current position to any primitive cell\n  queue = collections.deque([(state.pos[0], state.pos[1], 0)])  # (x, y, distance)\n  visited = set()\n  visited.add(state.pos)\n\n  directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]  # Right, Left, Down, Up\n  actions = [3, 2, 1, 0]  # RIGHT, LEFT, DOWN, UP\n\n  while queue:\n      x, y, dist = queue.popleft()\n\n      if (x, y) in primitive_positions:\n          # Found a path to the primitive, now backtrack to find action sequence\n          return state, reward, action_list\n\n      for i, (dx, dy) in enumerate(directions):\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n              if (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  queue.append((nx, ny, dist + 1))\n\n  return state, reward, action_list", "island_id": 5, "scores": {"3": -1}}
