y > 0:\n          action_list.extend([1] * abs(diff_y))  # UP\n      else:\n          action_list.extend([0] * abs(diff_y))  # DOWN\n      if diff_x > 0:\n          action_list.extend([3] * abs(diff_x))  # RIGHT\n      else:\n          action_list.extend([2] * abs(diff_x))  # LEFT\n\n  # Check if we can collect it now (if at the position)\n  # This would require checking if the primitive is at our current position\n  # For simplicity, assume we're at the right position and just pick it up\n\n  # Add USE action to collect the item\n  action_list.append(4)  # USE\n\n  return state, reward, action_list", "island_id": 1, "scores": {"3": -1}}
