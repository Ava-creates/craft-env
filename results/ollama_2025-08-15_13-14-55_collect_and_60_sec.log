{"timestamp": "2025-08-15T14:05:11.725976", "function_name": "collect", "function_body": "  def get_action_from_pos(pos):\n    if pos[0] > state.pos[0]:\n        return 1\n    elif pos[0] < state.pos[0]:\n        return 2\n    elif pos[1] > state.pos[1]:\n        return 3\n    elif pos[1] < state.pos[1]:\n        return 4\n    else:\n        return 5\n\n  def bfs_to_primitive(state, primitive):\n      queue = collections.deque([(state.pos, [])])\n      visited = set()\n      visited.add(state.pos)\n      while queue:\n          pos, actions = queue.popleft()\n          if primitive in [env._current_state.grid[pos[0], pos[1], i] for i in range(env.world.cookbook.n_kinds)]:\n              return actions\n          for d in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n              new_pos = (pos[0] + d[0], pos[1] + d[1])\n              if new_pos not in visited and env._current_state.grid[new_pos[0], new_pos[1], 0] != 0:\n                  visited.add(new_pos)\n                  queue.append((new_pos, actions + [get_action_from_pos(new_pos)]))\n      return []\n\n  primitive_idx = env.world.cookbook.index[primitive]\n  state = env._current_state\n  if state.inventory[primitive_idx] > 0:\n      return [], 0, []\n  \n  actions = bfs_to_primitive(state, primitive)\n  reward = 0\n  for a in actions:\n      r, state = env.step(state, a)\n      reward += r\n\n  return state, reward, actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-15T14:05:12.985658", "function_name": "collect", "function_body": "  # Helper function to determine the action needed to move from current position to target position\n  def get_action_from_pos(pos):\n    if pos[0] > state.pos[0]:\n        return 3  # RIGHT\n    elif pos[0] < state.pos[0]:\n        return 4  # LEFT\n    elif pos[1] > state.pos[1]:\n        return 1  # DOWN\n    elif pos[1] < state.pos[1]:\n        return 2  # UP\n    else:\n        return 5  # USE\n\n  # Breadth-First Search to find the shortest path to a cell containing the primitive\n  def bfs_to_primitive(state, primitive):\n      queue = collections.deque([(state.pos, [])])\n      visited = set()\n      visited.add(state.pos)\n      \n      while queue:\n          pos, actions = queue.popleft()\n          \n          # Check if the current cell contains the primitive we're looking for\n          grid_value = state.grid[pos[0], pos[1]]\n          if grid_value == primitive_idx:\n              return actions\n          \n          # Explore neighbors (up, down, left, right)\n          for d in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n              new_pos = (pos[0] + d[0], pos[1] + d[1])\n              \n              # Skip if already visited or out of bounds\n              if new_pos in visited or not (0 <= new_pos[0] < state.grid.shape[0] and 0 <= new_pos[1] < state.grid.shape[1]):\n                  continue\n                  \n              # Check if the cell is walkable (not a boundary or water)\n              cell_value = state.grid[new_pos[0], new_pos[1]]\n              if cell_value != 0:  # 0 might represent empty space or walkable area\n                  visited.add(new_pos)\n                  queue.append((new_pos, actions + [get_action_from_pos(new_pos)]))\n      \n      return []\n\n  # Get the index of the primitive from the environment's cookbook\n  primitive_idx = env.world.cookbook.index[primitive]\n  \n  # Check if we already have the primitive in inventory\n  state = env._current_state\n  if state.inventory[primitive_idx] > 0:\n      return [], 0, []\n  \n  # Find path to collect the primitive\n  actions = bfs_to_primitive(state, primitive)\n  reward = 0\n  \n  # Execute actions and compute reward\n  for a in actions:\n      r, state = env.step(state, a)\n      reward += r\n\n  return state, reward, actions", "island_id": 0, "scores": {"3": -1}}
