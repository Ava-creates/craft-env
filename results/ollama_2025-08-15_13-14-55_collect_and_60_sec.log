{"timestamp": "2025-08-15T14:49:16.549142", "function_name": "collect", "function_body": "  # Initialize the environment and variables\n  action_list = [] \n  reward = 0\n  state = env._current_state\n\n  # If the primitive is already in inventory, return empty actions\n  if state.inventory[env.world.cookbook.index[primitive]] > 0:\n      return state, reward, action_list\n\n  # Define a helper function to check if a cell is traversable\n  def is_traversable(cell_index):\n      # Check if the cell is not water or stone (i.e., it's walkable)\n      if cell_index in [env.world.water_index, env.world.stone_index]:\n          return False\n      return True\n\n  # Get the index of the primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Check if primitive is available in the environment\n  if primitive_index not in env.world.grabbable_indices:\n      raise ValueError(f\"Primitive {primitive} is not grabbable.\")\n\n  # Find the nearest instance of the primitive\n  pos = state.pos\n  grid = state.grid\n\n  # BFS to find the nearest primitive\n  queue = collections.deque([pos])\n  visited = set()\n  visited.add(pos)\n  parent = {}\n  found = False\n\n  while queue:\n      current_pos = queue.popleft()\n      \n      if grid[current_pos[0], current_pos[1], primitive_index] > 0:\n          found = True\n          break\n      \n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n          neighbor = (current_pos[0] + dx, current_pos[1] + dy)\n          if (\n              0 <= neighbor[0] < grid.shape[0] and\n              0 <= neighbor[1] < grid.shape[1] and\n              neighbor not in visited and\n              is_traversable(grid[neighbor[0], neighbor[1], 0])\n          ):\n              visited.add(neighbor)\n              queue.append(neighbor)\n              parent[neighbor] = current_pos\n\n  if not found:\n      # If the primitive is not found, we might need to craft tools to access it\n      pass  # This part needs to be expanded based on specific crafting rules\n\n  # Reconstruct path from start to goal\n  if found:\n      path = []\n      current = neighbor\n      while current != pos:\n          path.append(current)\n          current = parent[current]\n      path.reverse()\n      \n      # Convert path to actions\n      for i in range(len(path) - 1):\n          current_pos = path[i]\n          next_pos = path[i + 1]\n          \n          if next_pos[0] > current_pos[0]:\n              action_list.append(1)  # UP\n          elif next_pos[0] < current_pos[0]:\n              action_list.append(0)  # DOWN\n          elif next_pos[1] > current_pos[1]:\n              action_list.append(3)  # RIGHT\n          elif next_pos[1] < current_pos[1]:\n              action_list.append(2)  # LEFT\n\n  # If we have a path, add the final pickup action\n  if found and len(action_list) > 0:\n      action_list.append(4)  # USE to pick up the item\n\n  for a in action_list:\n      r, state = env.step(state, a)\n      reward += r\n\n  return state, reward, action_list", "island_id": 5, "scores": {"3": -1}}
