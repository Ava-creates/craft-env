{"timestamp": "2025-08-15T14:56:48.616464", "function_name": "collect", "function_body": "  def manhattan_distance(pos1, pos2):\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def is_walkable(pos):\n    x, y = pos\n    if x < 0 or x >= grid.shape[0] or y < 0 or y >= grid.shape[1]:\n      return False\n    # Check if the cell is walkable (not a boundary or water unless we have a bridge)\n    if grid[x, y, env.world.cookbook.index[\"BOUNDARY\"]] > 0:\n      return False\n    if grid[x, y, env.world.cookbook.index[\"WATER\"]] > 0:\n      # Check if we can cross water with a bridge or other tool\n      if not (env.world.cookbook.index[\"BRIDGE\"] in env._current_state.inventory and \n              env._current_state.inventory[env.world.cookbook.index[\"BRIDGE\"]] > 0):\n        return False\n    return True\n\n  def bfs_find_path(start, goal):\n    from collections import deque\n    queue = deque([(start, [])])\n    visited = set()\n    visited.add(start)\n    \n    while queue:\n      current_pos, path = queue.popleft()\n      if current_pos == goal:\n        return path\n      \n      # Check neighbors (up, down, left, right)\n      for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n        neighbor = (current_pos[0] + dx, current_pos[1] + dy)\n        if neighbor not in visited and is_walkable(neighbor):\n          visited.add(neighbor)\n          queue.append((neighbor, path + [neighbor]))\n    \n    return None  # No path found\n\n  action_list = [] \n  reward = 0\n  state = env._current_state\n\n  # Check if the primitive is already in inventory\n  primitive_index = env.world.cookbook.index[primitive]\n  if state.inventory[primitive_index] > 0:\n    return state, reward, action_list\n\n  # Check if the primitive is available in the grid\n  pos = state.pos\n  grid = state.grid\n\n  # If the primitive is at the current position\n  if grid[pos[0], pos[1], primitive_index] > 0:\n    action_list.append(4)  # USE action to collect\n    return state, reward, action_list\n\n  # Find the nearest location of the primitive in the grid\n  min_distance = float('inf')\n  target_pos = None\n  for i in range(grid.shape[0]):\n    for j in range(grid.shape[1]):\n      if grid[i, j, primitive_index] > 0:\n        distance = manhattan_distance(pos, (i, j))\n        if distance < min_distance:\n          min_distance = distance\n          target_pos = (i, j)\n\n  if target_pos is None:\n    return state, reward, action_list\n\n  # Find path to the target position\n  path = bfs_find_path(pos, target_pos)\n  if path is None:\n    return state, reward, action_list  # No path found\n\n  # Convert path to actions\n  for step in path:\n    dx = step[0] - pos[0]\n    dy = step[1] - pos[1]\n    \n    if dx == 1: action_list.append(3)  # RIGHT\n    elif dx == -1: action_list.append(2)  # LEFT\n    elif dy == 1: action_list.append(0)  # UP\n    elif dy == -1: action_list.append(1)  # DOWN\n    \n    pos = step\n\n  # Use the primitive once we reach it\n  action_list.append(4)  # USE action to collect\n  \n  return state, reward, action_list", "island_id": 9, "scores": {"3": -1}}
