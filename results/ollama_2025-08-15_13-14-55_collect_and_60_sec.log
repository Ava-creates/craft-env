{"timestamp": "2025-08-15T14:57:55.318027", "function_name": "collect", "function_body": "  # Get the index of the primitive\n  prim_idx = env.world.cookbook.index[primitive]\n  \n  # If we already have it, return empty action list\n  if state.inventory[prim_idx] > 0:\n      return [], 0.0, []\n\n  # Find where it is in the grid\n  pos = None\n  for i in range(state.grid.shape[0]):\n      for j in range(state.grid.shape[1]):\n          if state.grid[i][j][prim_idx] == 1:\n              pos = (i,j)\n              break\n      if pos is not None:\n          break\n\n  # If we can't find it, return empty list\n  if pos is None:\n      return [], -0.1, []\n  \n  # If it's adjacent to us, just pick it up\n  if abs(pos[0] - state.pos[0]) <= 1 and abs(pos[1] - state.pos[1]) <= 1:\n      return [env.ACTIONS.USE], 0.0, [env.ACTIONS.USE]\n  \n  # Otherwise, move toward it\n  actions = []\n  if pos[0] > state.pos[0]:\n      actions.append(env.ACTIONS.DOWN)\n  elif pos[0] < state.pos[0]:\n      actions.append(env.ACTIONS.UP)\n  if pos[1] > state.pos[1]:\n      actions.append(env.ACTIONS.RIGHT)\n  elif pos[1] < state.pos[1]:\n      actions.append(env.ACTIONS.LEFT)\n\n  return [], 0.0, actions", "island_id": 5, "scores": {"3": -1}}
