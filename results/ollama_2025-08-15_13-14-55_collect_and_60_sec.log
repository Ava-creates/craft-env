{"timestamp": "2025-08-15T15:10:57.558987", "function_name": "collect", "function_body": "  # Get the index for the primitive\n  primitive_idx = env.world.cookbook.index[primitive]\n  \n  # Check if we can already collect it directly\n  if state.next_to(primitive_idx):\n      return [craft.USE]  # Use action to collect\n\n  # If not next to it, find a path to get there\n  # This is a simplified approach - in practice, you'd need a proper pathfinder\n  actions = []\n  \n  # Try to move towards the primitive (simplified logic)\n  pos = state.pos\n  grid = state.grid\n  \n  # Find all cells with the primitive\n  primitive_positions = np.where(grid[:, :, primitive_idx] > 0)\n  \n  if len(primitive_positions[0]) > 0:\n      # Move towards first found primitive position\n      target_pos = (primitive_positions[0][0], primitive_positions[1][0])\n      \n      # Simple pathfinding logic\n      dx = target_pos[0] - pos[0]\n      dy = target_pos[1] - pos[1]\n      \n      if abs(dx) > abs(dy):\n          actions.append(craft.DOWN if dx > 0 else craft.UP)\n      else:\n          actions.append(craft.RIGHT if dy > 0 else craft.LEFT)\n  \n  # Add USE action at the end to collect\n  actions.append(craft.USE)\n  \n  return state, reward, actions", "island_id": 1, "scores": {"3": -1}}
