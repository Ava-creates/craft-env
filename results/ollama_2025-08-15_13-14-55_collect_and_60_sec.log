{"timestamp": "2025-08-15T14:45:06.682693", "function_name": "collect", "function_body": "  # Get the index of the primitive\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  # Check if primitive is already in inventory\n  if state.inventory[primitive_index] > 0:\n      return [], 0, []\n\n  # Find all locations where the primitive is present\n  locations = []\n  for i in range(env.world.cookbook.n_kinds):\n      if i != primitive_index and env.world.cookbook.index.get(i) == primitive:\n          locations.extend(np.where(state.grid[:, :, i] > 0).T.tolist())\n\n  # If no locations found, return error or handle appropriately\n  if not locations:\n      raise ValueError(f\"Primitive {primitive} not found in the environment.\")\n\n  # Get current position of agent\n  current_pos = state.pos\n\n  # Find the closest location to current position\n  min_distance = float('inf')\n  target_location = None\n  for loc in locations:\n      distance = abs(loc[0] - current_pos[0]) + abs(loc[1] - current_pos[1])\n      if distance < min_distance:\n          min_distance = distance\n          target_location = loc\n\n  # Compute path to the target location using BFS or A* algorithm\n  path = find_path(state.grid, current_pos, target_location, env.world.cookbook.index)\n  \n  # Convert path to actions (e.g., move up/down/left/right)\n  action_list = []\n  for i in range(len(path) - 1):\n      curr_pos = path[i]\n      next_pos = path[i + 1]\n      if next_pos[0] > curr_pos[0]:\n          action_list.append(3)  # RIGHT\n      elif next_pos[0] < curr_pos[0]:\n          action_list.append(2)  # LEFT\n      elif next_pos[1] > curr_pos[1]:\n          action_list.append(1)  # DOWN\n      elif next_pos[1] < curr_pos[1]:\n          action_list.append(0)  # UP\n\n  return state, reward, action_list", "island_id": 3, "scores": {"3": -1}}
