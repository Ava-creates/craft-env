{"timestamp": "2025-08-15T15:29:20.117265", "function_name": "collect", "function_body": "  def get_action_from_pos(pos):\n      if pos[0] > state.pos[0]:\n          return 1\n      elif pos[0] < state.pos[0]:\n          return 2\n      elif pos[1] > state.pos[1]:\n          return 3\n      elif pos[1] < state.pos[1]:\n          return 4\n      else:\n          return 5\n\n  def bfs_to_primitive(state, primitive):\n      queue = collections.deque([(state.pos, [])])\n      visited = set()\n      visited.add(state.pos)\n      \n      while queue:\n          pos, actions = queue.popleft()\n          \n          # Check if we've found the primitive\n          for i in range(env.world.cookbook.n_kinds):\n              if env.world.cookbook.index[primitive] == i and state.grid[pos[0], pos[1], i] > 0:\n                  return actions\n          \n          # Explore neighbors\n          for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n              new_pos = (pos[0] + dx, pos[1] + dy)\n              \n              # Validate new position\n              if (new_pos not in visited and \n                  0 <= new_pos[0] < state.grid.shape[0] and \n                  0 <= new_pos[1] < state.grid.shape[1]):\n                  \n                  # Check if cell is walkable\n                  cell_content = [state.grid[new_pos[0], new_pos[1], j] for j in range(env.world.cookbook.n_kinds)]\n                  if not any(cell == 0 for cell in cell_content):  # Not a boundary\n                      visited.add(new_pos)\n                      queue.append((new_pos, actions + [get_action_from_pos(new_pos)]))\n      \n      return []\n\n  primitive_idx = env.world.cookbook.index[primitive]\n  state = env._current_state\n  \n  # If we already have it, return empty actions\n  if state.inventory[primitive_idx] > 0:\n      return [], 0, []\n  \n  # Perform BFS to find path to the primitive\n  actions = bfs_to_primitive(state, primitive)\n  reward = 0\n  \n  for a in actions:\n      r, state = env.step(state, a)\n      reward += r\n\n  return state, reward, actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-15T15:29:21.500245", "function_name": "collect", "function_body": "  # Get the index of the primitive\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  # If we already have it, return empty action list\n  if env._current_state.inventory[primitive_idx] > 0:\n      return [], 0, []\n\n  # Use BFS to find the shortest path to the primitive\n  queue = collections.deque([(env._current_state.pos, [])])\n  visited = set()\n  visited.add(env._current_state.pos)\n\n  while queue:\n      pos, actions = queue.popleft()\n\n      # Check if the current position contains the primitive\n      grid_cell = env._current_state.grid[pos[0], pos[1]]\n      if primitive_idx in grid_cell and grid_cell[primitive_idx] > 0:\n          return actions, 0, actions\n\n      # Explore neighbors (up, down, left, right)\n      for d in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n          new_pos = (pos[0] + d[0], pos[1] + d[1])\n          \n          # Check if the new position is valid and not visited\n          if (new_pos not in visited and \n              0 <= new_pos[0] < env._current_state.grid.shape[0] and \n              0 <= new_pos[1] < env._current_state.grid.shape[1]):\n              \n              visited.add(new_pos)\n              \n              # Add to queue for exploration\n              queue.append((new_pos, actions + [env.world.cookbook.index[primitive]]))\n\n  return [], -1, []", "island_id": 0, "scores": {"3": 0.0}}
