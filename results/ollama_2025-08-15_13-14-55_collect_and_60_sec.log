{"timestamp": "2025-08-15T14:42:22.007147", "function_name": "collect", "function_body": "  # Get the index of the primitive\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  # Check if we can directly collect it\n  if state.next_to(primitive_index):\n      return [env.action_specs()['USE']]\n  \n  # Otherwise, we need to find a way to reach it\n  # For now, let's implement a simple pathfinding logic\n  pos = state.pos\n  grid = state.grid\n  width, height, n_kinds = grid.shape\n\n  # Simple BFS to find the nearest instance of the primitive\n  queue = collections.deque([(pos[0], pos[1], 0)])\n  visited = set()\n  visited.add(pos)\n\n  while queue:\n      x, y, steps = queue.popleft()\n\n      # Check neighbors\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n          nx, ny = x + dx, y + dy\n\n          if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n              visited.add((nx, ny))\n              if grid[nx, ny, primitive_index] > 0:\n                  # Found the primitive\n                  path = []\n                  # Reconstruct path to (nx, ny)\n                  current = (nx, ny)\n                  while current != pos:\n                      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n                          nx, ny = current[0] + dx, current[1] + dy\n                          if (nx, ny) in visited and grid[nx, ny, primitive_index] > 0:\n                              path.append((dx, dy))\n                              current = (nx, ny)\n                              break\n                  # Convert to actions\n                  actions = []\n                  for dx, dy in path:\n                      if dx == 1:\n                          actions.append(env.action_specs()['RIGHT'])\n                      elif dx == -1:\n                          actions.append(env.action_specs()['LEFT'])\n                      elif dy == 1:\n                          actions.append(env.action_specs()['DOWN'])\n                      elif dy == -1:\n                          actions.append(env.action_specs()['UP'])\n                  return actions\n              queue.append((nx, ny, steps + 1))\n  \n  # If we get here, we couldn't find the primitive\n  return []", "island_id": 6, "scores": {"3": -1}}
