{"timestamp": "2025-08-15T15:22:40.427708", "function_name": "collect", "function_body": "  def manhattan_distance(pos1, pos2):\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  action_list = [] \n  reward = 0\n  state = env._current_state\n\n  # Check if the primitive is already in inventory\n  primitive_index = env.world.cookbook.index[primitive]\n  if state.inventory[primitive_index] > 0:\n    return state, reward, action_list\n\n  # Check if the primitive is available in the grid\n  pos = state.pos\n  grid = state.grid\n\n  # If the primitive is at the current position\n  if grid[pos[0], pos[1], primitive_index] > 0:\n    action_list.append(4)  # USE action to collect\n    return state, reward, action_list\n\n  # Find the nearest location of the primitive in the grid\n  min_distance = float('inf')\n  target_pos = None\n  for i in range(grid.shape[0]):\n    for j in range(grid.shape[1]):\n      if grid[i, j, primitive_index] > 0:\n        distance = manhattan_distance(pos, (i, j))\n        if distance < min_distance:\n          min_distance = distance\n          target_pos = (i, j)\n\n  if target_pos is None:\n    return state, reward, action_list\n\n  # Simple pathfinding to reach the target position using BFS\n  queue = collections.deque([(pos[0], pos[1], 0)])\n  visited = set()\n  visited.add(pos)\n  actions = [0, 1, 2, 3]  # DOWN, UP, LEFT, RIGHT\n\n  while queue:\n    x, y, steps = queue.popleft()\n\n    if (x, y) == target_pos:\n      # Found the path, now reconstruct actions\n      # For simplicity, we will return a list of actions to move towards the target\n      return state, reward, action_list\n\n    for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n      nx, ny = x + dx, y + dy\n      if (nx, ny) not in visited and 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n        visited.add((nx, ny))\n        queue.append((nx, ny, steps + 1))\n\n  return state, reward, action_list", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-15T15:22:41.681879", "function_name": "collect", "function_body": "  def manhattan_distance(pos1, pos2):\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  action_list = [] \n  reward = 0\n  state = env._current_state\n\n  # Check if the primitive is already in inventory\n  primitive_index = env.world.cookbook.index[primitive]\n  if state.inventory[primitive_index] > 0:\n    return state, reward, action_list\n\n  # Check if the primitive is available in the grid\n  pos = state.pos\n  grid = state.grid\n\n  # If the primitive is at the current position\n  if grid[pos[0], pos[1], primitive_index] > 0:\n    action_list.append(4)  # USE action to collect\n    return state, reward, action_list\n\n  # Find the nearest location of the primitive in the grid\n  min_distance = float('inf')\n  target_pos = None\n  for i in range(grid.shape[0]):\n    for j in range(grid.shape[1]):\n      if grid[i, j, primitive_index] > 0:\n        distance = manhattan_distance(pos, (i, j))\n        if distance < min_distance:\n          min_distance = distance\n          target_pos = (i, j)\n\n  if target_pos is None:\n    return state, reward, action_list\n\n  # Simple pathfinding to reach the primitive\n  current_pos = pos\n  while current_pos != target_pos:\n    # Move towards the target position\n    if current_pos[0] < target_pos[0]:\n      action_list.append(1)  # UP\n      current_pos = (current_pos[0] + 1, current_pos[1])\n    elif current_pos[0] > target_pos[0]:\n      action_list.append(0)  # DOWN\n      current_pos = (current_pos[0] - 1, current_pos[1])\n    elif current_pos[1] < target_pos[1]:\n      action_list.append(3)  # RIGHT\n      current_pos = (current_pos[0], current_pos[1] + 1)\n    elif current_pos[1] > target_pos[1]:\n      action_list.append(2)  # LEFT\n      current_pos = (current_pos[0], current_pos[1] - 1)\n\n  return state, reward, action_list", "island_id": 9, "scores": {"3": 0.0}}
