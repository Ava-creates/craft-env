{"timestamp": "2025-08-15T14:24:15.540094", "function_name": "collect", "function_body": "  # get the index of the primitive\n  index = env.world.cookbook.index[primitive]\n  \n  # get the position of the primitive\n  pos = np.where(env._current_state.grid[:,:,index] == 1)\n  \n  # if the primitive is not in the grid, return empty list\n  if len(pos[0]) == 0:\n      return []\n  \n  # if the primitive is at the current position, return USE action\n  if pos[0][0] == env._current_state.pos[0] and pos[1][0] == env._current_state.pos[1]:\n      return [craft.USE]\n  \n  # otherwise, move towards the primitive\n  actions = []\n  current_pos = env._current_state.pos\n  target_pos = (pos[0][0], pos[1][0])\n  \n  while current_pos != target_pos:\n      if current_pos[0] < target_pos[0]:\n          actions.append(craft.DOWN)\n          current_pos = (current_pos[0]+1, current_pos[1])\n      elif current_pos[0] > target_pos[0]:\n          actions.append(craft.UP)\n          current_pos = (current_pos[0]-1, current_pos[1])\n      elif current_pos[1] < target_pos[1]:\n          actions.append(craft.RIGHT)\n          current_pos = (current_pos[0], current_pos[1]+1)\n      elif current_pos[1] > target_pos[1]:\n          actions.append(craft.LEFT)\n          current_pos = (current_pos[0], current_pos[1]-1)\n  \n  # if the primitive is a water, we need to use a bridge\n  if primitive == \"WATER\":\n      # check if we have a bridge in our inventory\n      bridge_index = env.world.cookbook.index[\"BRIDGE\"]\n      if env._current_state.inventory[bridge_index] > 0:\n          actions.append(craft.USE)\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
