{"timestamp": "2025-08-15T14:07:11.970233", "function_name": "collect", "function_body": "  # Find the index for the primitive\n  cookbook = env.world.cookbook\n  primitive_index = cookbook.index.get(primitive)\n  if primitive_index is None:\n      raise ValueError(f\"Primitive '{primitive}' not found in cookbook\")\n\n  # Check if primitive is already in inventory\n  if state.inventory[primitive_index] > 0:\n      return [], 0.0, []\n\n  # Find the position of the primitive\n  pos = state.pos\n  grid = state.grid\n  width, height, n_kinds = grid.shape\n\n  # Simple pathfinding to find the nearest primitive\n  visited = set()\n  queue = collections.deque([(pos[0], pos[1], 0)])  # (x, y, steps)\n  found = False\n  target_pos = None\n\n  while queue and not found:\n      x, y, steps = queue.popleft()\n      \n      if (x, y) in visited:\n          continue\n      visited.add((x, y))\n\n      if grid[x, y, primitive_index] > 0:\n          target_pos = (x, y)\n          found = True\n          break\n\n      # Add neighbors to queue\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < width and 0 <= ny < height:\n              if grid[nx, ny, primitive_index] > 0 or steps < 10:  # Arbitrary limit to avoid infinite loops\n                  queue.append((nx, ny, steps + 1))\n\n  if not found:\n      return [], -1.0, []  # Could not find primitive\n\n  # Simple movement towards target\n  action_list = []\n  current_pos = pos\n\n  while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          if dx > 0:\n              action = craft.RIGHT\n          else:\n              action = craft.LEFT\n      else:\n          if dy > 0:\n              action = craft.UP\n          else:\n              action = craft.DOWN\n\n      action_list.append(action)\n      current_pos = (current_pos[0] + (1 if dx > 0 else -1 if dx < 0 else 0),\n                     current_pos[1] + (1 if dy > 0 else -1 if dy < 0 else 0))\n\n  # Collect the primitive\n  action_list.append(craft.USE)\n\n  return state, reward, action_list", "island_id": 4, "scores": {"3": -1}}
