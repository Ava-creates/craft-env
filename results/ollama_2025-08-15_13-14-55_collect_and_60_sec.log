{"timestamp": "2025-08-15T14:44:54.879320", "function_name": "collect", "function_body": "  # Get the index of the primitive\n  idx = env.world.cookbook.index[primitive]\n\n  # Find all positions with this primitive in the grid\n  locations = np.where(env._current_state.grid[:, :, idx] > 0)\n\n  if len(locations[0]) == 0:\n      return [], 0, []\n  \n  # Select the first location (could be improved to select closest)\n  target_pos = (locations[0][0], locations[1][0])\n  \n  # Compute path to the primitive using A* or simple movement\n  actions = []\n  pos = env._current_state.pos\n\n  while pos != target_pos:\n      dx = target_pos[0] - pos[0]\n      dy = target_pos[1] - pos[1]\n\n      if abs(dx) > abs(dy):\n          # Move horizontally\n          action = craft.DOWN if dx > 0 else craft.UP\n          actions.append(action)\n          pos = (pos[0] + 1 if dx > 0 else pos[0] - 1, pos[1])\n      else:\n          # Move vertically\n          action = craft.RIGHT if dy > 0 else craft.LEFT\n          actions.append(action)\n          pos = (pos[0], pos[1] + 1 if dy > 0 else pos[1] - 1)\n\n  # Add pickup action at the final position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
