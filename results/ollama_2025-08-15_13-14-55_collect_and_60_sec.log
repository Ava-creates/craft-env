{"timestamp": "2025-08-15T13:40:51.054032", "function_name": "collect", "function_body": "  # Get the current state\n  state = env._current_state\n  \n  # Get the index of the primitive we want to collect\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  # Check if the primitive is already in inventory\n  if state.inventory[primitive_index] > 0:\n      return [], 0, []\n  \n  # Get all positions where this primitive exists in the grid\n  positions = np.where(state.grid[:,:,primitive_index] == 1)\n  if len(positions[0]) == 0:\n      # Primitive not found in grid, return empty action list and negative reward\n      return [], -10, []\n  \n  # Find the nearest position to the agent's current position\n  min_distance = float('inf')\n  target_pos = None\n  for i in range(len(positions[0])):\n      pos = (positions[0][i], positions[1][i])\n      distance = abs(pos[0] - state.pos[0]) + abs(pos[1] - state.pos[1])\n      if distance < min_distance:\n          min_distance = distance\n          target_pos = pos\n  \n  # If no position found, return empty action list and negative reward\n  if target_pos is None:\n      return [], -10, []\n  \n  # Plan path to the target position\n  actions = plan_to_position(state.pos, target_pos, env.world)\n  \n  # Add a USE action at the final position if needed\n  if actions and actions[-1] in [0, 1, 2, 3]:  # Movement actions\n      actions.append(4)  # Use action to collect\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
