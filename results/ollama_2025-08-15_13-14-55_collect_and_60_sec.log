{"timestamp": "2025-08-15T14:15:25.893200", "function_name": "collect", "function_body": "  # Initialize the action list\n  action_list = []\n  reward = 0\n  state = env._current_state\n\n  # Create a mapping from primitive names to indices\n  primitive_index_map = {\n      'BOUNDARY': env.world.index['boundary'],\n      'WATER': env.world.index['water'],\n      'STONE': env.world.index['stone'],\n      'WORKSHOP0': env.world.index['workshop_0'],\n      'WORKSHOP1': env.world.index['workshop_1'],\n      'WORKSHOP2': env.world.index['workshop_2'],\n      'WOOD': env.world.index['wood'],\n      'IRON': env.world.index['iron'],\n      'GRASS': env.world.index['grass'],\n      'ROCK': env.world.index['rock'],\n      'GOLD': env.world.index['gold'],\n      'GEM': env.world.index['gem']\n  }\n\n  # Get the index for the primitive\n  target_primitive = primitive_index_map.get(primitive)\n  if target_primitive is None:\n      raise ValueError(f\"Unknown primitive: {primitive}\")\n\n  # Check if the agent can directly collect the primitive\n  if state.next_to(target_primitive):\n      # If the primitive is in the immediate neighborhood, use USE to collect it\n      action_list.append(craft.USE)\n      r, state = env.step(state, craft.USE)\n      reward += r\n      return state, reward, action_list\n\n  # If the primitive is not next to the agent, we need to move towards it.\n  # Find all cells that contain the target primitive\n  primitive_cells = []\n  for i in range(env.world.WIDTH):\n      for j in range(env.world.HEIGHT):\n          if state.grid[i][j][target_primitive] == 1:\n              primitive_cells.append((i, j))\n\n  # If no cells found, return empty action list (or handle as error)\n  if not primitive_cells:\n      return state, reward, action_list\n\n  # Find the closest cell to the agent\n  min_distance = float('inf')\n  closest_cell = None\n  for cell in primitive_cells:\n      distance = abs(state.pos[0] - cell[0]) + abs(state.pos[1] - cell[1])\n      if distance < min_distance:\n          min_distance = distance\n          closest_cell = cell\n\n  # If no closest cell found, return empty action list\n  if closest_cell is None:\n      return state, reward, action_list\n\n  # Move towards the closest primitive cell\n  while state.pos != closest_cell:\n      # Determine the direction to move\n      dx = closest_cell[0] - state.pos[0]\n      dy = closest_cell[1] - state.pos[1]\n\n      if abs(dx) > abs(dy):\n          if dx > 0:\n              action = craft.RIGHT\n          else:\n              action = craft.LEFT\n      else:\n          if dy > 0:\n              action = craft.DOWN\n          else:\n              action = craft.UP\n\n      # Take the action\n      r, state = env.step(state, action)\n      reward += r\n      action_list.append(action)\n\n  # After reaching the cell, use USE to collect the primitive\n  r, state = env.step(state, craft.USE)\n  reward += r\n  action_list.append(craft.USE)\n\n  return state, reward, action_list", "island_id": 3, "scores": {"3": -1}}
