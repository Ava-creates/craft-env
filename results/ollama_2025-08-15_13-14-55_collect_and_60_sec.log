{"timestamp": "2025-08-15T14:41:26.687116", "function_name": "collect", "function_body": "  # Get the index of the primitive\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  # Check if the primitive is already in inventory\n  if env._current_state.inventory[primitive_index] > 0:\n    return []\n\n  # Check if the primitive is available in the grid at current position\n  pos = env._current_state.pos\n  grid = env._current_state.grid\n\n  if grid[pos[0], pos[1], primitive_index] > 0:\n    return [4]  # USE action to collect\n\n  # Find a path to the primitive using BFS\n  queue = collections.deque([(pos, [])])\n  visited = set()\n  visited.add(pos)\n  \n  while queue:\n    current_pos, actions = queue.popleft()\n    \n    if grid[current_pos[0], current_pos[1], primitive_index] > 0:\n      return actions\n    \n    # Check neighbors\n    for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n      new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n      \n      if (new_pos not in visited and \n          0 <= new_pos[0] < grid.shape[0] and \n          0 <= new_pos[1] < grid.shape[1]):\n        \n        # Check if we can move to this cell\n        if np.any(grid[new_pos[0], new_pos[1], :]) or new_pos == pos:\n          visited.add(new_pos)\n          new_actions = actions + [env.world.cookbook.index[\"UP\"] if dx == 0 and dy == 1 else\n                                  env.world.cookbook.index[\"DOWN\"] if dx == 0 and dy == -1 else\n                                  env.world.cookbook.index[\"LEFT\"] if dx == -1 and dy == 0 else\n                                  env.world.cookbook.index[\"RIGHT\"]]\n          queue.append((new_pos, new_actions))\n  \n  return []  # No path found", "island_id": 9, "scores": {"3": -1}}
