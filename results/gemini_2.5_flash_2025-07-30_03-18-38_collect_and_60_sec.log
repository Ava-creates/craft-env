{"timestamp": "2025-07-31T00:44:02.966417", "function_name": "collect", "function_body": "  # Action constants derived from CraftLab.action_specs()\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Helper function to check if an item at item_pos is within the 3x3 square\n  # around agent_pos. This means the agent can 'USE' the item from agent_pos.\n  def _can_use_from_pos(agent_pos, item_pos):\n      ar, ac = agent_pos\n      ir, ic = item_pos\n      return abs(ar - ir) <= 1 and abs(ac - ic) <= 1\n\n  actions = []\n  \n  # Get the current CraftState instance from the environment.\n  # CraftLab stores the current state in its _current_state attribute.\n  current_state = env._current_state \n  \n  # 1. Check if the primitive is already in the agent's inventory.\n  # If so, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return actions \n\n  # 2. Locate the primitive on the grid.\n  # The grid is part of the current state, structured as (WIDTH, HEIGHT, n_kinds).\n  grid = current_state.grid \n  \n  # Find all coordinates (row, col) where the specified primitive exists on the grid.\n  # np.argwhere returns an array of (row, col) pairs.\n  primitive_coords = np.argwhere(grid[:, :, primitive] > 0)\n\n  # If the primitive is not found on the grid, it cannot be collected directly.\n  if len(primitive_coords) == 0:\n      return actions\n\n  # Find the instance of the primitive that is closest to the agent's current position.\n  current_pos = current_state.pos # Agent's current (row, col)\n  \n  closest_dist = float('inf')\n  target_primitive_pos = None\n\n  for r_item, c_item in primitive_coords:\n      # Calculate Manhattan distance to each primitive instance.\n      dist = abs(r_item - current_pos[0]) + abs(c_item - current_pos[1])\n      if dist < closest_dist:\n          closest_dist = dist\n          target_primitive_pos = (r_item, c_item)\n          \n  # This case should ideally not be reached if primitive_coords was not empty.\n  if target_primitive_pos is None:\n      return actions \n\n  # 3. Plan a sequence of movement actions to reach a position from which the primitive\n  # can be 'USED', followed by the 'USE' action itself.\n  \n  # Initialize a simulated agent position for planning, starting from the current position.\n  sim_pos = list(current_pos) \n  \n  # Set a maximum number of planning steps to prevent infinite loops in cases\n  # where a path might be impossible or excessively long (e.g., due to obstacles\n  # not handled by this simple pathfinding).\n  MAX_PLANNING_STEPS = 200 \n  current_planning_steps = 0\n\n  # Loop until the simulated agent is in a 'can_use' position relative to the target primitive.\n  # This loop implements a greedy pathfinding strategy.\n  while not _can_use_from_pos(sim_pos, target_primitive_pos):\n      # If the planning exceeds the maximum allowed steps, abort and return an empty list.\n      if current_planning_steps >= MAX_PLANNING_STEPS:\n          return [] \n          \n      r_curr, c_curr = sim_pos\n      r_target, c_target = target_primitive_pos\n\n      dr = r_target - r_curr # Difference in rows (vertical distance)\n      dc = c_target - c_curr # Difference in columns (horizontal distance)\n      \n      move_made = False\n      # Prioritize movement along the dimension with the larger absolute difference.\n      # This ensures progress towards the target. This simple greedy approach does not\n      # account for obstacles or finding the truly shortest path in complex environments.\n      \n      if abs(dr) > 0: # If there's a vertical distance to cover\n          if dr > 0: # Target is below, move DOWN\n              actions.append(ACTION_DOWN)\n              sim_pos[0] += 1\n          else: # Target is above, move UP\n              actions.append(ACTION_UP)\n              sim_pos[0] -= 1\n          move_made = True\n      elif abs(dc) > 0: # If horizontal distance exists (and no vertical difference or it's smaller)\n          if dc > 0: # Target is to the right, move RIGHT\n              actions.append(ACTION_RIGHT)\n              sim_pos[1] += 1\n          else: # Target is to the left, move LEFT\n              actions.append(ACTION_LEFT)\n              sim_pos[1] -= 1\n          move_made = True\n\n      # This condition acts as a safeguard. If no move was made but _can_use_from_pos\n      # is still False, it might indicate an unexpected state or an issue.\n      if not move_made:\n          break \n          \n      current_planning_steps += 1\n\n  # Once a position from which the primitive can be used is reached (simulated),\n  # append the 'USE' action to the sequence.\n  actions.append(ACTION_USE)\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:45:31.194603", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n  # Assuming env_factory and its constants are available globally or imported externally\n  from env_factory import ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE\n  from env_factory import WORLD_DIM\n\n  # Get world dimensions from env_factory\n  WIDTH, HEIGHT = WORLD_DIM\n\n  # Define movement deltas (dx, dy) for (x, y) coordinates\n  # Assuming (0,0) is top-left, x increases right, y increases down\n  DELTAS = {\n      ACTION_DOWN: (0, 1),   # (dx, dy)\n      ACTION_UP: (0, -1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0),\n  }\n\n  current_state = env._current_state\n  world = env.world # CraftWorld instance\n  \n  # 1. Check if the primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # 2. Identify potential target locations for the primitive on the grid\n  # Find all (x, y) coordinates where the primitive_idx is present\n  # np.where returns (row_indices, col_indices) for a 2D array, so (y_coords, x_coords)\n  primitive_y_coords, primitive_x_coords = np.where(current_state.grid[:, :, primitive] > 0)\n  primitive_locations = set(zip(primitive_x_coords, primitive_y_coords))\n\n  if not primitive_locations:\n      # The primitive is not on the map\n      return []\n\n  # 3. BFS for pathfinding\n  q = collections.deque()\n  visited = set() # Stores (x, y) tuples to avoid cycles and redundant exploration\n  \n  start_x, start_y = current_state.pos\n\n  q.append((start_x, start_y, [])) # (current_x, current_y, list_of_actions_to_reach_here)\n  visited.add((start_x, start_y))\n\n  while q:\n      x, y, path = q.popleft()\n\n      # Check if (x, y) is a position from which the primitive can be collected via ACTION_USE.\n      # This means `CraftState.next_to(primitive)` would be True if the agent was at (x,y).\n      # `next_to` checks the 3x3 neighborhood around (x,y) for `primitive`.\n      is_target_position_for_use = False\n      for dx_adj in [-1, 0, 1]:\n          for dy_adj in [-1, 0, 1]:\n              adj_x, adj_y = x + dx_adj, y + dy_adj\n              # Check if the adjacent cell is within bounds and contains the primitive\n              if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT and (adj_x, adj_y) in primitive_locations:\n                  is_target_position_for_use = True\n                  break\n          if is_target_position_for_use:\n              break\n\n      if is_target_position_for_use:\n          # Found a path to a cell from which the primitive can be collected\n          return path + [ACTION_USE]\n\n      # Explore adjacent cells\n      for action, (dx, dy) in DELTAS.items():\n          next_x, next_y = x + dx, y + dy\n          next_pos = (next_x, next_y)\n\n          # Check bounds\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check traversability for the next cell\n          # Agent cannot move through 'stone' or 'water'\n          # (assuming water and stone are always untraversable obstacles unless special tools are used)\n          if current_state.grid[next_x, next_y, world.stone_index] > 0 or \\\n             current_state.grid[next_x, next_y, world.water_index] > 0:\n              continue # Cannot move through these obstacles\n\n          if next_pos not in visited:\n              visited.add(next_pos)\n              q.append((next_x, next_y, path + [action]))\n  \n  # If BFS completes without finding a path\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:45:31.263488", "function_name": "collect", "function_body": "    # Define action constants based on CraftLab.action_specs()\n    # These would typically be imported or globally defined in a larger project.\n    # For this specific completion, defining them locally within the function scope.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Map action integers to (dx, dy) changes for grid coordinates (column, row)\n    _ACTION_TO_DELTA = {\n        UP: (0, -1),   # dy decreases (row decreases)\n        DOWN: (0, 1),    # dy increases (row increases)\n        LEFT: (-1, 0),   # dx decreases (column decreases)\n        RIGHT: (1, 0),   # dx increases (column increases)\n    }\n\n    state = env._current_state # Access the internal CraftState instance\n\n    # 1. Check current inventory\n    if state.inventory[primitive] > 0:\n        return [] # Already collected\n\n    # 2. If agent is already next to the primitive, no movement is needed, just USE\n    # This check is crucial for efficiency and correctness.\n    if state.next_to(primitive):\n        return [USE]\n\n    grid = state.grid\n    agent_pos = state.pos # (col, row)\n    \n    # Get grid dimensions for boundary checks\n    WIDTH, HEIGHT, _ = grid.shape \n\n    # 3. Find the primitive on the grid and determine the closest target position for the agent to move to\n    primitive_locations = []\n    for c in range(WIDTH):\n        for r in range(HEIGHT):\n            if grid[c, r, primitive] == 1:\n                primitive_locations.append((c, r))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the map\n\n    min_dist = float('inf')\n    best_target_pos = None # The grid cell the agent should move to\n\n    for p_c, p_r in primitive_locations:\n        # Check all 4 adjacent cells around the primitive\n        for dx, dy in _ACTION_TO_DELTA.values(): # Iterate through delta values for neighbors\n            adj_c, adj_r = p_c + dx, p_r + dy\n            \n            # Ensure adjacent cell is within bounds\n            if 0 <= adj_c < WIDTH and 0 <= adj_r < HEIGHT:\n                # Calculate Manhattan distance from agent's current position to this adjacent cell\n                dist = abs(agent_pos[0] - adj_c) + abs(agent_pos[1] - adj_r)\n                if dist < min_dist:\n                    min_dist = dist\n                    best_target_pos = (adj_c, adj_r)\n\n    if best_target_pos is None:\n        # This can happen if the primitive is completely surrounded or inaccessible.\n        return [] \n    \n    # 4. BFS pathfinding to `best_target_pos`\n    # Queue stores tuples of ((current_col, current_row), [list_of_actions_to_reach_here])\n    # Using a list as a queue with a manual index for efficiency (similar to deque).\n    queue = [(agent_pos, [])] \n    visited = {agent_pos}\n    \n    final_actions_path = []\n\n    q_idx = 0 # Manual queue index to simulate popleft efficiently\n    while q_idx < len(queue):\n        (curr_c, curr_r), path_so_far = queue[q_idx]\n        q_idx += 1\n\n        if (curr_c, curr_r) == best_target_pos:\n            final_actions_path = path_so_far\n            break # Path found\n\n        # Explore neighbors\n        for action, (dx, dy) in _ACTION_TO_DELTA.items():\n            next_c, next_r = curr_c + dx, curr_r + dy\n\n            # Check bounds and if not already visited\n            # For v2, we assume all cells are traversable unless they are explicitly non-walkable.\n            if 0 <= next_c < WIDTH and 0 <= next_r < HEIGHT and (next_c, next_r) not in visited:\n                visited.add((next_c, next_r))\n                queue.append(((next_c, next_r), path_so_far + [action]))\n\n    if not final_actions_path:\n        # No path found to the target position\n        return []\n\n    # 5. Add the USE action after reaching the target position\n    final_actions_path.append(USE)\n    \n    return final_actions_path", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:46:25.245111", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement vectors (dx, dy) to action IDs.\n  # These actions move the agent AND set its facing direction.\n  _MOVE_VEC_TO_ACTION = {\n      (0, -1): ACTION_UP,    # Move North, face North\n      (0, 1): ACTION_DOWN,   # Move South, face South\n      (-1, 0): ACTION_LEFT,  # Move West, face West\n      (1, 0): ACTION_RIGHT   # Move East, face East\n  }\n\n  # Map agent's internal direction ID to its corresponding facing vector (dx, dy).\n  # 0: North (-Y), 1: East (+X), 2: South (+Y), 3: West (-X)\n  _DIR_TO_VEC = {\n      0: (0, -1),\n      1: (1, 0),\n      2: (0, 1),\n      3: (-1, 0)\n  }\n\n  initial_observation = env.observations()\n  # The grid is static for planning a path to a primitive.\n  current_grid = initial_observation['features_dict']['features_global']\n  # Agent's starting position (x, y) as a tuple of integers for consistent hashing.\n  initial_pos_x, initial_pos_y = initial_observation['features_dict']['pos'].astype(int)\n  initial_pos_tuple = (initial_pos_x, initial_pos_y)\n  # Agent's starting direction, converted from one-hot vector to an integer ID (0-3).\n  initial_direction = np.argmax(initial_observation['features_dict']['direction'])\n\n  grid_width, grid_height, _ = current_grid.shape\n  # Get indices of entities that cannot be picked up or moved through (obstacles).\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a coordinate is within grid bounds\n  def _is_valid_coordinate(x, y):\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  # Helper function to check if a cell is traversable.\n  # A cell is not traversable if it's out of bounds or contains any non-grabbable entity.\n  def _is_traversable(x, y):\n      if not _is_valid_coordinate(x, y):\n          return False\n      for idx in non_grabbable_indices:\n          if current_grid[x, y, idx] > 0:\n              return False # Cell contains an obstacle\n      return True # Traversable\n\n  # BFS state: (position_tuple, direction_int)\n  # Queue stores (position_tuple, direction_int) for states to explore.\n  bfs_queue = collections.deque([(initial_pos_tuple, initial_direction)])\n  # Visited set stores (position_tuple, direction_int) to avoid redundant exploration and cycles.\n  visited_states = set([(initial_pos_tuple, initial_direction)])\n  \n  # parent_map stores: (current_pos, current_dir) -> ((parent_pos, parent_dir), action_taken_to_reach_current)\n  parent_path_map = {}\n  \n  # Stores the BFS state from which the 'USE' action can be applied to collect the primitive.\n  target_collection_state = None\n\n  while bfs_queue:\n      current_pos, current_dir = bfs_queue.popleft()\n      current_bfs_state_key = (current_pos, current_dir)\n\n      # Determine the coordinates of the cell directly in front of the agent\n      facing_vector = _DIR_TO_VEC[current_dir]\n      front_cell_x, front_cell_y = current_pos[0] + facing_vector[0], current_pos[1] + facing_vector[1]\n\n      # Check if the desired primitive is located in the cell directly in front.\n      if _is_valid_coordinate(front_cell_x, front_cell_y) and current_grid[front_cell_x, front_cell_y, primitive] > 0:\n          # Found the primitive in front, this is our target state for the BFS.\n          target_collection_state = current_bfs_state_key\n          break # Shortest path found due to BFS, exit search\n\n      # Explore all possible movement actions (UP, DOWN, LEFT, RIGHT).\n      # Each move action also changes the agent's facing direction to match the movement.\n      for move_vector, move_action_id in _MOVE_VEC_TO_ACTION.items():\n          next_x, next_y = current_pos[0] + move_vector[0], current_pos[1] + move_vector[1]\n          next_pos_tuple = (next_x, next_y)\n          # The new direction is set by the move action itself.\n          next_direction = move_action_id \n          next_bfs_state_key = (next_pos_tuple, next_direction)\n\n          # Only proceed if the next cell is traversable and this state hasn't been visited before.\n          if _is_traversable(next_x, next_y) and next_bfs_state_key not in visited_states:\n              visited_states.add(next_bfs_state_key)\n              # Store the parent state and the action taken to reach this new state\n              parent_path_map[next_bfs_state_key] = (current_bfs_state_key, move_action_id)\n              bfs_queue.append(next_bfs_state_key)\n\n  # If a path to the target was found, reconstruct the action sequence.\n  if target_collection_state:\n      action_sequence = [ACTION_USE] # The very last action is always 'USE' to collect the primitive\n      \n      # Backtrack from the found target state to the initial state.\n      current_trace_state = target_collection_state\n      initial_bfs_state_key = (initial_pos_tuple, initial_direction)\n\n      while current_trace_state != initial_bfs_state_key:\n          # Get the parent state and the action that led from parent to current_trace_state\n          parent_state, action_to_reach_current = parent_path_map[current_trace_state]\n          action_sequence.append(action_to_reach_current)\n          current_trace_state = parent_state\n      \n      # The path was built in reverse order (from goal to start), so reverse it to get chronological order.\n      return action_sequence[::-1]\n\n  # If the queue became empty and no path was found, it means the primitive is unreachable.\n  # Return an empty list of actions in this case.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:46:26.220310", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # --- Action and Direction Constants ---\n  # These define the integer IDs for actions used by the CraftLab environment.\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Maps a relative movement vector (dx, dy) to the corresponding action ID.\n  # Performing these actions moves the agent and implicitly sets its facing direction\n  # to align with the direction of movement.\n  MOVE_VEC_TO_ACTION = {\n      (0, -1): ACTION_UP,    # Move North (decreases Y coordinate)\n      (0, 1): ACTION_DOWN,   # Move South (increases Y coordinate)\n      (-1, 0): ACTION_LEFT,  # Move West (decreases X coordinate)\n      (1, 0): ACTION_RIGHT   # Move East (increases X coordinate)\n  }\n\n  # Maps the agent's internal direction ID (0-3) to its corresponding facing vector (dx, dy).\n  # Standard convention for direction IDs:\n  # 0: North (facing -Y)\n  # 1: East (facing +X)\n  # 2: South (facing +Y)\n  # 3: West (facing -X)\n  DIR_ID_TO_FACING_VEC = {\n      0: (0, -1),  # Agent faces North\n      1: (1, 0),   # Agent faces East\n      2: (0, 1),   # Agent faces South\n      3: (-1, 0)   # Agent faces West\n  }\n\n  # Maps a movement vector to the agent's new facing direction ID after that move.\n  # This ensures the agent's internal direction state correctly reflects its orientation\n  # after a movement action. It's crucial for subsequent `USE` actions or pathfinding.\n  MOVE_VEC_TO_NEW_DIR_ID = {\n      (0, -1): 0,  # Moving North (via UP action) results in facing North (ID 0)\n      (1, 0): 1,   # Moving East (via RIGHT action) results in facing East (ID 1)\n      (0, 1): 2,   # Moving South (via DOWN action) results in facing South (ID 2)\n      (-1, 0): 3   # Moving West (via LEFT action) results in facing West (ID 3)\n  }\n\n  # --- Initial State Extraction from Environment ---\n  # Retrieve the current state observations from the environment.\n  initial_obs = env.observations()\n  \n  # The global grid representation is static for pathfinding a primitive,\n  # containing all entities and obstacles.\n  current_grid = initial_obs['features_dict']['features_global']\n  \n  # Agent's starting position (x, y) as a tuple, which is hashable and suitable\n  # for use in sets and dictionary keys (e.g., visited states, parent map).\n  initial_pos = tuple(initial_obs['features_dict']['pos'].astype(int))\n  \n  # Agent's starting direction, converted from a one-hot vector to an integer ID (0-3).\n  initial_dir = np.argmax(initial_obs['features_dict']['direction'])\n\n  # Extract grid dimensions from the current grid array.\n  grid_width, grid_height, _ = current_grid.shape\n  \n  # Get the set of entity indices that represent impassable obstacles.\n  # The agent cannot move into cells containing these entities.\n  impassable_entity_indices = env.world.non_grabbable_indices\n\n  # --- Helper Functions for Grid and Movement Checks ---\n\n  def _is_valid_coord(x: int, y: int) -> bool:\n      \"\"\"\n      Checks if a given (x, y) coordinate is within the boundaries of the grid.\n      \"\"\"\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  def _is_traversable(x: int, y: int) -> bool:\n      \"\"\"\n      Checks if the cell at (x, y) is traversable by the agent.\n      A cell is considered non-traversable if it's out of grid bounds or\n      if it contains any entity explicitly marked as non-grabbable (an obstacle).\n      \"\"\"\n      if not _is_valid_coord(x, y):\n          return False # Coordinate is outside the grid\n      # Iterate through impassable entity indices to check for obstacles.\n      for entity_idx in impassable_entity_indices:\n          if current_grid[x, y, entity_idx] > 0:\n              return False # Cell contains an obstacle\n      return True # Cell is clear and traversable\n\n  # --- Breadth-First Search (BFS) for Pathfinding ---\n\n  # BFS Queue: Stores states to explore. Each state is a tuple:\n  # ((current_x, current_y), current_direction_id).\n  # Using collections.deque provides efficient O(1) append and pop operations.\n  bfs_queue = collections.deque([(initial_pos, initial_dir)])\n  \n  # Visited States Set: Stores states (position, direction) that have already been\n  # added to the queue or processed. This prevents revisiting states, cycles, and\n  # ensures the shortest path is found.\n  visited_states = set([(initial_pos, initial_dir)])\n  \n  # Parent Path Map: Used to reconstruct the optimal path once the target is found.\n  # Maps a child_state_key -> (parent_state_key, action_taken_to_reach_child).\n  parent_path_map = {}\n  \n  # This variable will store the BFS state from which the 'USE' action can be applied\n  # to successfully collect the primitive. This means the primitive is directly in front\n  # of the agent in this state.\n  collection_ready_state = None\n\n  while bfs_queue:\n      # Dequeue the current state (position and direction) to explore.\n      current_pos, current_dir = bfs_queue.popleft()\n      current_bfs_state_key = (current_pos, current_dir)\n\n      # Determine the coordinates of the cell directly in front of the agent,\n      # based on its current position and facing direction.\n      facing_vector = DIR_ID_TO_FACING_VEC[current_dir]\n      front_x, front_y = current_pos[0] + facing_vector[0], current_pos[1] + facing_vector[1]\n\n      # Check if the desired `primitive` is located in this front cell.\n      if _is_valid_coord(front_x, front_y) and current_grid[front_x, front_y, primitive] > 0:\n          # If the primitive is found, this is the goal state for our pathfinding.\n          collection_ready_state = current_bfs_state_key\n          break # Exit BFS, as the shortest path to a valid collection point has been found.\n\n      # Explore all possible movement actions (UP, DOWN, LEFT, RIGHT) from the current state.\n      for move_vector, action_id in MOVE_VEC_TO_ACTION.items():\n          # Calculate the next position after performing this move.\n          next_x, next_y = current_pos[0] + move_vector[0], current_pos[1] + move_vector[1]\n          next_pos = (next_x, next_y)\n          \n          # Determine the agent's new facing direction ID after completing this movement.\n          next_dir = MOVE_VEC_TO_NEW_DIR_ID[move_vector]\n          \n          next_bfs_state_key = (next_pos, next_dir)\n\n          # Only proceed if the next cell is traversable and this specific state\n          # (combination of position and direction) has not been visited before.\n          if _is_traversable(next_x, next_y) and next_bfs_state_key not in visited_states:\n              visited_states.add(next_bfs_state_key)\n              # Record the parent state and the action taken to reach this new state.\n              parent_path_map[next_bfs_state_key] = (current_bfs_state_key, action_id)\n              bfs_queue.append(next_bfs_state_key)\n\n  # --- Path Reconstruction ---\n  # If a path to the primitive was found (i.e., `collection_ready_state` is not None):\n  if collection_ready_state:\n      # The final action in the sequence is always `ACTION_USE` to collect the primitive.\n      actions_sequence = [ACTION_USE]\n      \n      # Start backtracking from the `collection_ready_state` to reconstruct the path.\n      current_state_in_path = collection_ready_state\n      initial_bfs_state_key = (initial_pos, initial_dir)\n\n      # Backtrack using the `parent_path_map` until we reach the original initial state.\n      while current_state_in_path != initial_bfs_state_key:\n          # Retrieve the parent state and the action that led from the parent to the current state.\n          parent_state, action_from_parent = parent_path_map[current_state_in_path]\n          actions_sequence.append(action_from_parent)\n          current_state_in_path = parent_state\n      \n      # The actions were collected in reverse order (from goal state to initial state).\n      # Reverse the list to get the correct chronological sequence of actions.\n      return actions_sequence[::-1]\n  else:\n      # If the BFS completed and the queue became empty without finding the primitive,\n      # it means the primitive is unreachable from the initial state.\n      # In this case, return an empty list of actions.\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:47:58.386343", "function_name": "collect", "function_body": "    from collections import deque\n    import numpy as np\n\n    # Get action integer mappings from the environment's specification.\n    # This ensures compatibility with the specific CraftLab instance.\n    action_specs_map = env.action_specs()\n    ACTION_DOWN = action_specs_map['DOWN']\n    ACTION_UP = action_specs_map['UP']\n    ACTION_LEFT = action_specs_map['LEFT']\n    ACTION_RIGHT = action_specs_map['RIGHT']\n    ACTION_USE = action_specs_map['USE']\n\n    q = deque()\n    # The initial state for the BFS is the current state of the environment.\n    initial_craft_state = env._current_state\n    q.append((initial_craft_state, []))\n\n    world = initial_craft_state.world\n    target_item_idx = primitive  # The item we need to collect (its integer index)\n\n    # Determine the primitive ingredients required to craft the target_item_idx.\n    # If target_item_idx is itself a base primitive (like 'wood', 'stone'),\n    # world.cookbook.primitives_for will return an empty dictionary.\n    # If it's a crafted item (like 'axe'), it will return a dict of required base primitives and their counts.\n    required_primitives_info = world.cookbook.primitives_for(target_item_idx)\n\n    # Identify all item indices whose inventory counts are relevant for determining a unique state.\n    # This includes the target item itself and all its ultimate primitive ingredients.\n    relevant_item_indices = set(required_primitives_info.keys())\n    relevant_item_indices.add(target_item_idx)\n    sorted_relevant_indices = sorted(list(relevant_item_indices))\n\n    # For each relevant item, determine the count we are interested in for the visited set.\n    # For primitive ingredients, it's the count required for crafting (from required_primitives_info).\n    # For the target_item_idx itself, we only need to obtain at least one.\n    target_inventory_thresholds = {\n        idx: required_primitives_info.get(idx, 1)  # Default to 1 if not a specific ingredient count (e.g., for the target item itself)\n        for idx in sorted_relevant_indices\n    }\n\n    # Visited set to prevent cycles and redundant exploration.\n    # A state is defined by (agent_position_tuple, agent_direction_int, tuple_of_relevant_inventory_counts).\n    # The inventory tuple stores `min(actual_count, threshold)` for each relevant item,\n    # ensuring we only distinguish states based on whether sufficient quantities are met or not,\n    # rather than exact large counts.\n    visited = set()\n\n    while q:\n        current_state, actions_taken = q.popleft()\n\n        # Check if the goal is satisfied: the target item is in the inventory.\n        if current_state.inventory[target_item_idx] > 0:\n            return actions_taken\n\n        # Create a hashable representation of the current relevant inventory for the visited set.\n        # Use `min` to cap the count at the required threshold, as more than needed doesn't change state relevance for the goal.\n        current_relevant_inventory_tuple = tuple(\n            min(int(current_state.inventory[idx]), target_inventory_thresholds[idx])\n            for idx in sorted_relevant_indices\n        )\n        current_visited_tuple = (current_state.pos, current_state.dir, current_relevant_inventory_tuple)\n\n        if current_visited_tuple in visited:\n            continue\n        visited.add(current_visited_tuple)\n\n        # Explore all possible actions from the current state.\n        for action in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]:\n            # Simulate the action. CraftState.step handles all game logic (movement, pickups, crafting).\n            # It returns (reward, new_state_object). We only care about the new state.\n            _, next_state = current_state.step(action)\n\n            # Add the new state and the actions taken to reach it to the queue for further exploration.\n            q.append((next_state, actions_taken + [action]))\n\n    # If the queue is exhausted and the goal was not reached, the item is considered unreachable.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:47:58.461243", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants as defined in CraftLab action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Delta movements for (dx, dy) for each action (assuming (x, y) coordinates with (0,0) top-left)\n    DELTAS = {\n        ACTION_DOWN: (0, 1),\n        ACTION_UP: (0, -1),\n        ACTION_LEFT: (-1, 0),\n        ACTION_RIGHT: (1, 0),\n    }\n\n    # 1. Get initial state information from the environment\n    obs = env.observations()\n    initial_grid = obs['features_dict']['features_global']\n    initial_pos = tuple(obs['features_dict']['pos'])  # Agent's starting (x, y) position\n    initial_inventory = obs['features_dict']['inventory']\n\n    # Check if the primitive is already in the agent's inventory\n    if initial_inventory[primitive] > 0:\n        return []  # Already collected, no actions needed\n\n    width, height, _ = initial_grid.shape\n\n    # Identify all locations on the grid where the primitive exists\n    primitive_locations = []\n    for x in range(width):\n        for y in range(height):\n            if initial_grid[x, y, primitive] == 1.0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return []  # Primitive not found on the map, cannot collect\n\n    # Get the indices of non-grabbable items, which are considered obstacles for movement\n    obstacle_indices = env.world.non_grabbable_indices\n\n    # Helper function to check if a given cell (x, y) is walkable\n    def is_walkable(x, y, grid):\n        # Check if the coordinates are within grid boundaries\n        if not (0 <= x < width and 0 <= y < height):\n            return False  # Out of bounds\n\n        # Check if the cell contains any obstacle (non-grabbable item)\n        for k_idx in obstacle_indices:\n            if grid[x, y, k_idx] == 1.0:\n                return False  # Cell contains an impassable obstacle\n        return True\n\n    # 2. Determine target cells: cells adjacent to any primitive location that are walkable\n    # The agent needs to reach one of these cells to perform the USE action.\n    target_cells = set()\n    for px, py in primitive_locations:\n        for dx, dy in DELTAS.values():  # Check all four cardinal neighbors\n            nx, ny = px + dx, py + dy\n            if is_walkable(nx, ny, initial_grid):\n                target_cells.add((nx, ny))\n    \n    if not target_cells:\n        return []  # No walkable adjacent cells to any primitive, impossible to reach\n\n    # 3. Perform a Breadth-First Search (BFS) to find the shortest path to a target_cell\n    q = collections.deque([(initial_pos, [])])  # Queue stores (current_position, path_taken_to_reach_here)\n    visited = {initial_pos}  # Set to keep track of visited (x, y) positions to avoid cycles\n\n    best_path = []\n    path_found = False\n\n    # Check if the agent is already at a target adjacent cell\n    if initial_pos in target_cells:\n        best_path = []  # No movement needed\n        path_found = True\n    else:\n        while q and not path_found:\n            current_pos, current_path = q.popleft()\n\n            # Explore neighbors\n            for action_type, (dx, dy) in DELTAS.items():\n                next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n                next_pos = (next_x, next_y)\n\n                if is_walkable(next_x, next_y, initial_grid) and next_pos not in visited:\n                    new_path = current_path + [action_type]\n                    if next_pos in target_cells:\n                        best_path = new_path\n                        path_found = True\n                        break  # Shortest path found\n                    \n                    visited.add(next_pos)\n                    q.append((next_pos, new_path))\n        \n        if not path_found:\n            return []  # No path found to any adjacent cell\n\n    # 4. Append the USE action to the found movement path\n    final_actions = best_path + [ACTION_USE]\n\n    return final_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:49:10.862286", "function_name": "collect", "function_body": "    # Get action mappings from the environment\n    action_spec = env.action_specs()\n    DOWN = action_spec['DOWN']\n    UP = action_spec['UP']\n    LEFT = action_spec['LEFT']\n    RIGHT = action_spec['RIGHT']\n    USE = action_spec['USE']\n\n    # Get current state from the environment\n    current_state = env._current_state\n    current_grid = current_state.grid\n    current_pos = current_state.pos\n    current_inventory = current_state.inventory\n\n    # Check if the primitive is already collected\n    if current_inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions and specific indices from world config\n    height, width, _ = current_grid.shape\n    # We assume water blocks movement. Other non-grabbable items might also block,\n    # but for a basic `collect` function, this is a reasonable simplification.\n    water_index = current_state.world.water_index \n\n    # Define movement deltas and their corresponding actions\n    # (dr, dc) -> action_id\n    move_deltas = {\n        (-1, 0): UP,    # Move North\n        (1, 0): DOWN,   # Move South\n        (0, -1): LEFT,  # Move West\n        (0, 1): RIGHT,  # Move East\n    }\n\n    # BFS Initialization\n    q = deque([(current_pos, [])]) # (position (r, c), path_to_position_as_actions)\n    visited = {current_pos}\n\n    path_to_primitive = None\n\n    # BFS Loop\n    while q:\n        (r, c), path_so_far = q.popleft()\n\n        # Check if the current cell contains the primitive\n        if current_grid[r, c, primitive] > 0:\n            path_to_primitive = path_so_far\n            break # Found the primitive, shortest path found by BFS\n\n        # Explore neighbors\n        for dr, dc in move_deltas.keys():\n            nr, nc = r + dr, c + dc\n\n            # Check bounds\n            if not (0 <= nr < height and 0 <= nc < width):\n                continue\n\n            # Check if already visited\n            if (nr, nc) in visited:\n                continue\n\n            # Check traversability: cannot move into water\n            if current_grid[nr, nc, water_index] > 0:\n                continue \n\n            # Add to queue and visited set\n            visited.add((nr, nc))\n            action_to_move = move_deltas[(dr, dc)]\n            q.append(((nr, nc), path_so_far + [action_to_move]))\n\n    # If a path was found, append the USE action\n    if path_to_primitive is not None:\n        return path_to_primitive + [USE]\n    else:\n        # Primitive not found or not reachable\n        return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:49:10.935799", "function_name": "collect", "function_body": "    # Mappings for movement actions (dx, dy) based on CraftWorld grid (WIDTH, HEIGHT) and (x, y) pos\n    # ACTION_UP: agent moves +0 in x, -1 in y (y decreases as you go up)\n    # ACTION_DOWN: agent moves +0 in x, +1 in y (y increases as you go down)\n    # ACTION_LEFT: agent moves -1 in x, +0 in y\n    # ACTION_RIGHT: agent moves +1 in x, +0 in y\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    MOVE_ACTION_DELTAS = {\n        ACTION_UP: (0, -1),\n        ACTION_DOWN: (0, 1),\n        ACTION_LEFT: (-1, 0),\n        ACTION_RIGHT: (1, 0),\n    }\n\n    # Helper function to check adjacency to a primitive\n    # Defined inside the main function to be self-contained as per request\n    def is_adjacent_to_primitive(agent_x, agent_y, primitive_idx, grid_data, width, height):\n        \"\"\"\n        Checks if any cell in the 3x3 neighborhood around (agent_x, agent_y) contains the primitive.\n        grid_data is assumed to be (WIDTH, HEIGHT, n_kinds).\n        \"\"\"\n        for dx in [-1, 0, 1]:\n            for dy in [-1, 0, 1]:\n                nx, ny = agent_x + dx, agent_y + dy\n                # Check if neighbor is within grid boundaries\n                if 0 <= nx < width and 0 <= ny < height:\n                    # Check if the grid cell contains the primitive kind\n                    if grid_data[nx, ny, primitive_idx] > 0:\n                        return True\n        return False\n\n    # 1. Get initial state observation from the environment\n    obs = env.observations()\n    initial_features_dict = obs['features_dict']\n    initial_grid = initial_features_dict['features_global'] # This is the full allocentric grid\n    initial_pos = tuple(initial_features_dict['pos'])       # Agent's current (x, y) position\n    initial_inventory = initial_features_dict['inventory']  # Agent's current inventory counts\n\n    # Get grid dimensions from the global grid (initial_grid shape is (WIDTH, HEIGHT, n_kinds))\n    grid_width, grid_height, _ = initial_grid.shape\n\n    # 2. Check if the primitive is already in the agent's inventory\n    if initial_inventory[primitive] > 0:\n        return [] # Primitive is already collected, no actions needed\n\n    # 3. Perform a Breadth-First Search (BFS) to find the shortest path to a cell adjacent to the primitive\n    q = collections.deque([(initial_pos, [])]) # Queue stores (current_position (x, y), list_of_actions_taken_to_reach_here)\n    visited = set([initial_pos])              # Set to keep track of visited positions to avoid cycles and redundant exploration\n\n    path_to_adjacent = None # This will store the sequence of actions once a path is found\n\n    while q:\n        (current_x, current_y), path_so_far = q.popleft()\n\n        # Check if the current position is \"adjacent\" to the target primitive\n        # This uses the helper function to mimic CraftState.next_to behavior\n        if is_adjacent_to_primitive(current_x, current_y, primitive, initial_grid, grid_width, grid_height):\n            path_to_adjacent = path_so_far\n            break # Found the shortest path, exit BFS\n\n        # Explore possible next moves (UP, DOWN, LEFT, RIGHT)\n        for action in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n            dx, dy = MOVE_ACTION_DELTAS[action]\n            new_x, new_y = current_x + dx, current_y + dy\n            new_pos_tuple = (new_x, new_y)\n\n            # Check if the new position is within grid boundaries\n            if 0 <= new_x < grid_width and 0 <= new_y < grid_height:\n                # Check if this position has been visited before\n                if new_pos_tuple not in visited:\n                    visited.add(new_pos_tuple)\n                    # Add the new state (position and path) to the queue\n                    q.append((new_pos_tuple, path_so_far + [action]))\n\n    # 4. If no path was found after exploring all reachable positions, the primitive is unreachable\n    if path_to_adjacent is None:\n        return []\n\n    # 5. If a path was found, append the 'USE' action to the path\n    # This assumes that once adjacent, 'USE' action will collect the primitive\n    final_actions = path_to_adjacent + [ACTION_USE]\n\n    return final_actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:50:36.577238", "function_name": "collect", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:50:36.647899", "function_name": "collect", "function_body": "    import collections # This import should ideally be at the top of the file, not inside the function.\n    import numpy as np # This import should ideally be at the top of the file, not inside the function.\n\n    # Define action constants based on the CraftLab action_specs\n    # These constants should ideally be defined globally or in a shared module.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # 1. Get initial state information from observations\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    \n    # Extract grid, current position, and inventory from the features dictionary.\n    # The 'features_global' is the full allocentric grid.\n    grid = features_dict['features_global']\n    # The 'pos' is a normalized numpy array, but for grid traversal, we need integer coordinates.\n    # Assuming the \"normalized\" here refers to the dtype (float32) rather than a [0,1] scale,\n    # and the values themselves are the actual integer grid coordinates.\n    start_pos = tuple(map(int, features_dict['pos'])) \n    inventory = features_dict['inventory']\n    \n    # Check if the primitive is already collected in the inventory.\n    if inventory[primitive] > 0:\n        return [] # If already collected, no actions are needed.\n\n    # 2. Extract grid dimensions and non-grabbable indices for obstacle checking.\n    width, height, n_kinds = grid.shape\n    # Non-grabbable indices identify items that act as obstacles or cannot be picked up.\n    # These are obtained from the CraftWorld instance which is accessible via CraftLab's 'world' attribute.\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # 3. Identify all locations on the grid where the target primitive exists.\n    primitive_locations = []\n    for x in range(width):\n        for y in range(height):\n            # Check if the primitive kind is present at this grid cell.\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    # If the primitive is not found anywhere on the map, it cannot be collected.\n    if not primitive_locations:\n        return []\n\n    # 4. Determine all 'use points' (cells from which the primitive can be successfully 'USE'd).\n    # Based on the description of CraftState.next_to(), a 'USE' action works if the item\n    # is within the 3x3 neighborhood around the agent's position.\n    # Therefore, for each primitive location (px, py), any cell (tx, ty) within\n    # |tx - px| <= 1 and |ty - py| <= 1 is a valid 'use point'.\n    target_use_points = set()\n    for px, py in primitive_locations:\n        for dx in [-1, 0, 1]:  # Relative x-coordinates for the 3x3 neighborhood\n            for dy in [-1, 0, 1]:  # Relative y-coordinates for the 3x3 neighborhood\n                tx, ty = px + dx, py + dy\n                # Ensure the calculated 'use point' is within grid boundaries.\n                if 0 <= tx < width and 0 <= ty < height:\n                    target_use_points.add((tx, ty))\n    \n    # 5. Perform a Breadth-First Search (BFS) to find the shortest path to any 'use point'.\n    # The queue stores tuples of (current_position_tuple, list_of_actions_taken_to_reach_here).\n    q = collections.deque([(start_pos, [])]) \n    # 'visited' set keeps track of grid positions that have already been explored\n    # to prevent cycles and redundant path computations.\n    visited = {start_pos}\n\n    # Define possible cardinal moves and their corresponding action IDs.\n    # This maps a (dx, dy) displacement to the action constant.\n    moves = [\n        (0, -1, UP),    # Move North (decreases Y-coordinate)\n        (0, 1, DOWN),   # Move South (increases Y-coordinate)\n        (-1, 0, LEFT),  # Move West (decreases X-coordinate)\n        (1, 0, RIGHT)   # Move East (increases X-coordinate)\n    ]\n\n    best_path_to_use_point = None # Stores the action sequence if a path is found.\n    \n    while q:\n        (curr_x, curr_y), path_actions = q.popleft()\n\n        # If the current position is one of our target 'use points', we've found\n        # the shortest path (due to BFS property).\n        if (curr_x, curr_y) in target_use_points:\n            best_path_to_use_point = path_actions # The path to reach this use point.\n            break # Exit BFS as the optimal path has been found.\n\n        # Explore all valid adjacent cells (neighbors).\n        for dx, dy, action in moves:\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_pos = (next_x, next_y)\n\n            # Check if the next position is within the grid boundaries.\n            if not (0 <= next_x < width and 0 <= next_y < height):\n                continue\n\n            # Check if this position has already been visited during the BFS.\n            if next_pos in visited:\n                continue\n\n            # Check if the next position is an obstacle.\n            # A cell is considered an obstacle if it contains any non-grabbable item.\n            is_obstacle = False\n            for k_idx in non_grabbable_indices:\n                if grid[next_x, next_y, k_idx] > 0: # If this type of item is present at the cell.\n                    is_obstacle = True\n                    break # Found an obstacle, no need to check other non-grabbable kinds.\n            if is_obstacle:\n                continue # Cannot move to this cell, skip to the next neighbor.\n\n            # If the next position is valid and not an obstacle, add it to the queue\n            # and mark it as visited for future explorations.\n            visited.add(next_pos)\n            q.append((next_pos, path_actions + [action]))\n\n    # 6. Construct the final action sequence.\n    if best_path_to_use_point is not None:\n        # If a path to a 'use point' was found, append the 'USE' action\n        # as the final step to collect the primitive.\n        return best_path_to_use_point + [USE]\n    else:\n        # If no path could be found to any 'use point' (e.g., primitive is unreachable),\n        # return an empty list of actions.\n        return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:52:05.720418", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action mappings for CraftLab\n  # These are internal constants or derived from action_specs\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map (dx, dy) to action for moving to a neighbor\n  # (dx, dy) is the change in (x, y) coordinates from current to next cell\n  # Assuming x-axis increases right, y-axis increases down\n  MOVE_DELTAS_TO_ACTION = {\n      (0, 1): ACTION_DOWN,   # (x, y+1)\n      (0, -1): ACTION_UP,    # (x, y-1)\n      (-1, 0): ACTION_LEFT,  # (x-1, y)\n      (1, 0): ACTION_RIGHT,  # (x+1, y)\n  }\n\n  # Relative coordinates for 4-way movement (dx, dy)\n  NEIGHBOR_DELTAS_4_WAY = [\n      (0, 1),   # Down\n      (0, -1),  # Up\n      (-1, 0),  # Left\n      (1, 0),   # Right\n  ]\n\n  # Relative coordinates for 3x3 neighborhood (dx, dy) including center\n  NEIGHBORHOOD_DELTAS_3x3 = [\n      (-1, -1), (-1, 0), (-1, 1),\n      (0, -1),  (0, 0),  (0, 1), # (0,0) is current cell\n      (1, -1),  (1, 0),  (1, 1),\n  ]\n\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  grid = features_dict['features_global']\n  inventory = features_dict['inventory']\n  \n  WIDTH, HEIGHT, _ = grid.shape # N_KINDS is not directly needed for pathfinding\n\n  # 1. Check if primitive is already collected\n  if inventory[primitive] > 0:\n      return []\n\n  # 2. Get current agent position from normalized coordinates\n  # Assuming normalization: coord_norm = coord_int / (DIM_SIZE - 1)\n  current_pos_norm = features_dict['pos']\n  current_x = int(current_pos_norm[0] * (WIDTH - 1))\n  current_y = int(current_pos_norm[1] * (HEIGHT - 1))\n  current_pos = (current_x, current_y)\n  \n  # 3. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          if grid[x, y, primitive] == 1:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # Primitive not found anywhere on the map\n      return []\n\n  # 4. Determine target cells for BFS: any cell from which the primitive can be 'USE'd.\n  # This means any cell (tx, ty) such that a primitive (px, py) is in its 3x3 neighborhood.\n  # Conversely, this is any cell (tx, ty) that is in the 3x3 neighborhood of a primitive (px, py).\n  target_bfs_cells = set()\n  for px, py in primitive_locations:\n      for dx, dy in NEIGHBORHOOD_DELTAS_3x3:\n          tx, ty = px + dx, py + dy\n          # Ensure target cell is within grid boundaries\n          if 0 <= tx < WIDTH and 0 <= ty < HEIGHT:\n              target_bfs_cells.add((tx, ty))\n\n  # 5. Perform BFS to find the shortest path to any target_bfs_cell\n  # Queue stores (current_position_tuple, list_of_actions_to_reach_here)\n  queue = collections.deque([(current_pos, [])])\n  visited = {current_pos} # Set of positions already visited in BFS\n\n  while queue:\n      (curr_x, curr_y), actions_path = queue.popleft()\n\n      # Check if the current cell is one of our target BFS cells\n      if (curr_x, curr_y) in target_bfs_cells:\n          # Double-check if a primitive is indeed collectable from this position\n          # (i.e., if any primitive is in the 3x3 neighborhood of (curr_x, curr_y))\n          is_collectable_from_here = False\n          for px, py in primitive_locations:\n              if abs(curr_x - px) <= 1 and abs(curr_y - py) <= 1:\n                  is_collectable_from_here = True\n                  break\n          \n          if is_collectable_from_here:\n              # Found the shortest path to a collectable position. Add the USE action.\n              return actions_path + [ACTION_USE]\n\n      # Explore 4-way neighbors\n      for dx, dy in NEIGHBOR_DELTAS_4_WAY:\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # Check if next position is within grid boundaries and not visited\n          # Assuming all cells are traversable unless explicitly defined as obstacles\n          if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT and next_pos not in visited:\n              visited.add(next_pos)\n              move_action = MOVE_DELTAS_TO_ACTION[(dx, dy)]\n              queue.append((next_pos, actions_path + [move_action]))\n\n  # If the BFS completes and no path to a collectable primitive was found (e.g., unreachable)\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:52:05.791165", "function_name": "collect", "function_body": "    # Define action constants within the function scope for clarity and self-containment.\n    # These integer values correspond to standard CraftLab actions.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    actions = []\n    # Reset the environment to its initial state to start the collection process.\n    current_obs = env.reset()\n\n    # Set a maximum number of steps to prevent infinite loops during exploration.\n    max_collection_steps = 200\n\n    for _ in range(max_collection_steps):\n        # Get the current inventory from the observations.\n        current_inventory = current_obs['features_dict']['inventory']\n\n        # Check if the primitive item has been successfully collected.\n        if current_inventory[primitive] > 0:\n            return actions\n\n        # Get the egocentric view of the grid (what the agent sees around itself).\n        features_ego = current_obs['features_dict']['features_ego']\n        ego_w, ego_h, _ = features_ego.shape  # Dimensions of the egocentric view.\n\n        # The agent is typically located at the center of the egocentric view.\n        agent_x, agent_y = ego_w // 2, ego_h // 2\n\n        action_to_take = None\n\n        # 1. Prioritize using the item if it's in an immediately adjacent cell.\n        # Define relative coordinates for the four cardinal directions from the agent.\n        # Assuming (x, y) where +x is right, +y is down on the grid.\n        adjacent_deltas = [\n            (0, -1),  # North (up)\n            (0, 1),   # South (down)\n            (-1, 0),  # West (left)\n            (1, 0)    # East (right)\n        ]\n\n        # Check each adjacent cell for the primitive.\n        for dx, dy in adjacent_deltas:\n            nx, ny = agent_x + dx, agent_y + dy\n            # Ensure the coordinates are within the bounds of the egocentric view\n            # and check if the primitive is present at that location.\n            if 0 <= nx < ego_w and 0 <= ny < ego_h and features_ego[nx, ny, primitive] == 1.0:\n                action_to_take = USE  # Primitive is adjacent, so use the 'USE' action.\n                break  # Found an adjacent primitive, no need to check further.\n\n        # 2. If no primitive is adjacent, search for the closest one in the egocentric view\n        #    and determine a movement action to get closer.\n        if action_to_take is None:\n            closest_target_dx, closest_target_dy = None, None\n            min_dist_sq = float('inf')\n\n            # Iterate through the entire egocentric view to find the primitive.\n            for x in range(ego_w):\n                for y in range(ego_h):\n                    if features_ego[x, y, primitive] == 1.0:\n                        # Calculate relative coordinates from the agent's position.\n                        _dx, _dy = x - agent_x, y - agent_y\n                        dist_sq = _dx**2 + _dy**2\n\n                        # Skip the agent's own square; we're looking for items to move towards or use.\n                        if dist_sq == 0:\n                            continue\n\n                        # Update if this primitive is closer than any found so far.\n                        if dist_sq < min_dist_sq:\n                            min_dist_sq = dist_sq\n                            closest_target_dx, closest_target_dy = _dx, _dy\n\n            if closest_target_dx is not None:  # Primitive found somewhere in the egocentric view.\n                # Determine the primary direction (horizontal or vertical) to move closer.\n                if abs(closest_target_dx) > abs(closest_target_dy):\n                    action_to_take = RIGHT if closest_target_dx > 0 else LEFT\n                else:\n                    action_to_take = DOWN if closest_target_dy > 0 else UP\n            else:\n                # 3. If the primitive is not found in the egocentric view, explore randomly.\n                # This is a basic exploration strategy; more advanced versions could use\n                # global pathfinding or systematic search patterns.\n                action_to_take = np.random.choice([UP, DOWN, LEFT, RIGHT])\n\n        # Execute the chosen action in the environment.\n        reward, done, current_obs = env.step(action_to_take)\n        actions.append(action_to_take)\n\n        # If the environment indicates that the episode is done (e.g., max steps reached\n        # internally, or goal achieved by the environment's own criteria).\n        if done:\n            # Check inventory one last time to confirm if the primitive was collected.\n            current_inventory = current_obs['features_dict']['inventory']\n            if current_inventory[primitive] > 0:\n                return actions\n            # If done and primitive not collected, the task might have failed within the env's limits.\n            # Return the actions taken so far.\n            return actions\n\n    # If the loop finishes (max_collection_steps reached) without collecting the primitive,\n    # return the sequence of actions attempted.\n    return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:53:25.885688", "function_name": "collect", "function_body": "    current_state = env._current_state\n    actions = []\n\n    # Check if the primitive is already in the inventory\n    # `primitive` is an integer index for the item in the inventory array.\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed.\n\n    agent_pos = current_state.pos  # (row, column)\n    grid = current_state.grid      # numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds)\n    grid_width, grid_height, _ = grid.shape # Extract dimensions, n_kinds not used here\n\n    # Find all locations where the primitive is present on the grid.\n    primitive_locations = []\n    for r in range(grid_width):\n        for c in range(grid_height):\n            # Assuming grid[r, c, primitive] is 1 if the primitive is at (r,c), 0 otherwise.\n            if grid[r, c, primitive] == 1:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        # The primitive is not found anywhere on the map.\n        return []\n\n    # For simplicity, we target the first found primitive location.\n    # A more sophisticated version (e.g., `collect_v3`) might find the closest one\n    # using a proper pathfinding algorithm like Breadth-First Search (BFS).\n    target_r, target_c = primitive_locations[0]\n\n    # Define action integer mappings. These are standard for CraftLab.\n    # In a production setting, one might dynamically get these from `env.action_specs()`.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Simulate the agent's position to generate the sequence of actions.\n    sim_r, sim_c = agent_pos\n\n    # First, adjust the agent's column (horizontal movement).\n    # This greedy approach moves the agent directly towards the target column.\n    # It does not account for obstacles or optimal paths.\n    while sim_c != target_c:\n        if sim_c < target_c:\n            actions.append(ACTION_RIGHT)\n            sim_c += 1\n        else: # sim_c > target_c\n            actions.append(ACTION_LEFT)\n            sim_c -= 1\n\n    # Second, adjust the agent's row (vertical movement).\n    # This continues the greedy approach, moving directly towards the target row.\n    while sim_r != target_r:\n        if sim_r < target_r:\n            actions.append(ACTION_DOWN)\n            sim_r += 1\n        else: # sim_r > target_r\n            actions.append(ACTION_UP)\n            sim_r -= 1\n\n    # After these movements, the simulated agent position `(sim_r, sim_c)` is\n    # now at the target primitive's location `(target_r, target_c)`.\n    # Assume that grabbable primitives are collected by moving onto their tile\n    # and then performing the 'USE' action.\n    actions.append(ACTION_USE)\n\n    return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:53:25.962330", "function_name": "collect", "function_body": "    \"\"\"Improved version of `collect_v1`.\"\"\"\n    import collections\n    import numpy as np\n\n    # Action mappings as per CraftLab.action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Delta movements for each action (dx, dy) where x is col, y is row\n    # (col_change, row_change)\n    ACTION_TO_DELTA = {\n        ACTION_DOWN: (0, 1),   # Move down (increase row index)\n        ACTION_UP: (0, -1),    # Move up (decrease row index)\n        ACTION_LEFT: (-1, 0),  # Move left (decrease col index)\n        ACTION_RIGHT: (1, 0)   # Move right (increase col index)\n    }\n\n    def _bfs_path_to_adjacent(start_pos, target_kind_idx, grid):\n        \"\"\"\n        Performs a Breadth-First Search to find the shortest path from start_pos\n        to any cell adjacent to the target_kind_idx, appending a USE action.\n        Returns a list of actions or an empty list if no path is found.\n        \"\"\"\n        # grid.shape is (WIDTH, HEIGHT, n_kinds)\n        WIDTH, HEIGHT, _ = grid.shape\n\n        q = collections.deque([(start_pos, [])]) # (current_x, current_y), list_of_actions\n        visited = {start_pos} # Set of (x, y) tuples to avoid cycles\n\n        while q:\n            (curr_x, curr_y), actions_so_far = q.popleft()\n\n            # Check if current position is adjacent to the target primitive\n            # If so, we can use the item from here.\n            for dx_adj, dy_adj in ACTION_TO_DELTA.values():\n                adj_x, adj_y = curr_x + dx_adj, curr_y + dy_adj\n\n                # Check bounds for the adjacent cell\n                if not (0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT):\n                    continue\n\n                # Check if the adjacent cell contains the primitive\n                if grid[adj_x, adj_y, target_kind_idx] > 0:\n                    # Found a cell with the primitive next to current position.\n                    # This path leads to a position from which we can USE.\n                    return actions_so_far + [ACTION_USE]\n\n            # Explore movement neighbors\n            for action_val, (dx, dy) in ACTION_TO_DELTA.items():\n                new_x, new_y = curr_x + dx, curr_y + dy\n\n                # Check bounds for the new position\n                if not (0 <= new_x < WIDTH and 0 <= new_y < HEIGHT):\n                    continue\n\n                # Check if the new position has not been visited yet\n                if (new_x, new_y) not in visited:\n                    visited.add((new_x, new_y))\n                    q.append(((new_x, new_y), actions_so_far + [action_val]))\n\n        return [] # No path found\n\n    obs = env.observations()\n    current_grid = obs['features_dict']['features_global']\n    \n    # Convert normalized position [x_norm, y_norm] to (col, row) integer coordinates\n    current_pos_norm = obs['features_dict']['pos']\n    WIDTH = current_grid.shape[0]\n    HEIGHT = current_grid.shape[1]\n    \n    # Using round for robust conversion from float to int grid coordinates\n    current_col = int(round(current_pos_norm[0] * WIDTH))\n    current_row = int(round(current_pos_norm[1] * HEIGHT))\n    current_agent_pos = (current_col, current_row)\n\n    # Check if the primitive is already in inventory. If so, no actions are needed.\n    if obs['features_dict']['inventory'][primitive] > 0:\n        return []\n\n    # Find the path using BFS\n    # The _bfs_path_to_adjacent function is designed to return the full action sequence\n    # including the final USE action, if a path to an adjacent cell is found.\n    action_sequence = _bfs_path_to_adjacent(current_agent_pos, primitive, current_grid)\n    \n    return action_sequence", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:54:40.812575", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:54:41.791476", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants based on CraftLab.action_specs\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # A reasonable internal limit for the BFS path length.\n  # This prevents excessively long paths if the target is far or unreachable,\n  # while allowing for thorough exploration on typical CraftWorld maps.\n  MAX_COLLECT_STEPS = 200 \n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"Returns the coordinates of the cell directly in front of (y,x) based on direction.\n      Direction mapping: 0=Up, 1=Right, 2=Down, 3=Left.\"\"\"\n      if direction == 0: return y - 1, x # UP\n      if direction == 1: return y, x + 1 # RIGHT\n      if direction == 2: return y + 1, x # DOWN\n      if direction == 3: return y, x - 1 # LEFT\n      return y, x # Should not be reached for valid movement directions\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state for pathfinding.\n  current_obs = env.reset() \n  current_state = env._current_state \n\n  # Ensure the primitive is a valid kind known to the world\n  if primitive not in current_state.world.cookbook.kinds:\n      return [] \n\n  # Check if the primitive is already in the inventory\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir # Agent's current facing direction from the reset state\n\n  # Define impassable kinds for movement.\n  # Workshops (if any) are typically traversable, even if non-grabbable.\n  # Water/lava (if present) are generally blocking.\n  impassable_for_movement = set()\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  # Add other non-grabbable indices that are NOT workshop_indices to the impassable set.\n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n\n  # Define movement actions and their resulting directions and (dy, dx) changes.\n  # Direction mapping: 0=Up, 1=Right, 2=Down, 3=Left\n  # These map agent's action to the resulting direction it faces and its grid movement.\n  movement_actions_map = {\n      ACTION_UP:    (0, -1, 0), # (resulting_direction, dy, dx) for facing UP\n      ACTION_RIGHT: (1, 0, 1),  # (resulting_direction, dy, dx) for facing RIGHT\n      ACTION_DOWN:  (2, 1, 0),  # (resulting_direction, dy, dx) for facing DOWN\n      ACTION_LEFT:  (3, 0, -1)  # (resulting_direction, dy, dx) for facing LEFT\n  }\n\n  q = collections.deque()\n  # BFS state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  q.append((start_y, start_x, start_dir, []))\n  # Visited set tracks (position, direction) to avoid redundant exploration and cycles.\n  visited = {(start_y, start_x, start_dir)} \n\n  path_to_execute = None # Will store the sequence of actions including the final ACTION_USE\n\n  # --- BFS to find a path to a position and orientation suitable for collection ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Check if the primitive is directly in front of the agent at current (y,x,dir)\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Ensure facing coordinates are within bounds\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width):\n          # Check if the cell directly in front contains the primitive\n          if full_grid[facing_y, facing_x, primitive] > 0:\n              # We found a path to a position and orientation where ACTION_USE should work.\n              candidate_path = path + [ACTION_USE]\n              \n              # Only accept paths that are within MAX_COLLECT_STEPS.\n              # Since BFS finds shortest paths first, the first valid path found will be the shortest.\n              if len(candidate_path) <= MAX_COLLECT_STEPS:\n                  path_to_execute = candidate_path\n                  break # Path found and within limits, exit BFS\n\n      # Explore neighbors by applying movement actions\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          \n          # Prune BFS branches early if adding another step exceeds MAX_COLLECT_STEPS.\n          if len(path) + 1 > MAX_COLLECT_STEPS:\n              continue\n\n          # Check bounds for the next agent position\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the next cell is traversable using the refined impassable set\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n          \n          # Check if this (position, direction) state has been visited\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n  \n  # --- Execute the found path (if any) ---\n  if path_to_execute is None:\n      return [] # No path found within MAX_COLLECT_STEPS to collect the primitive\n\n  for action in path_to_execute:\n      actions_taken.append(action)\n      # The `path_to_execute` is guaranteed to be within `MAX_COLLECT_STEPS` due to BFS pruning,\n      # so no explicit length check is needed here during execution.\n      \n      reward, done, _ = env.step(action)\n      current_state = env._current_state # Update state after the step\n\n      # If the episode terminated *and* the primitive was not collected,\n      # it means the collection failed (e.g., ran out of environment steps mid-path).\n      if done and current_state.inventory[primitive] <= 0:\n          return [] \n\n      # If the primitive is now in the inventory, we have successfully collected it.\n      # Return the sequence of actions taken so far.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n  \n  # Final check: if the primitive was collected after executing the full path.\n  # This covers cases where the collection might happen on the very last step.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If we reached here, the full path was executed, but collection failed.\n      # This implies an issue with the environment or assumptions, as the BFS found a valid path.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:56:04.561757", "function_name": "collect", "function_body": "    current_state = env._current_state\n\n    # Action constants (assuming these are globally defined as per `CraftLab.action_specs()`)\n    # DOWN = 0\n    # UP = 1\n    # LEFT = 2\n    # RIGHT = 3\n    # USE = 4\n\n    # Direction vectors for agent's absolute facing direction (0:N, 1:E, 2:S, 3:W)\n    # Corresponds to (dy, dx) change for moving \"UP\" (forward)\n    _DIRECTIONS = {\n        0: (-1, 0),  # North: row-1, col\n        1: (0, 1),   # East: row, col+1\n        2: (1, 0),   # South: row+1, col\n        3: (0, -1)   # West: row, col-1\n    }\n\n    # 1. Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir # Agent's current facing direction (0-3)\n    \n    height, width, _ = grid.shape\n\n    # Find the location of the primitive on the grid\n    primitive_location = None\n    for r_idx in range(height):\n        for c_idx in range(width):\n            if grid[r_idx, c_idx, primitive] == 1:\n                primitive_location = (r_idx, c_idx)\n                break\n        if primitive_location:\n            break\n\n    if not primitive_location:\n        # Primitive not found on the map, cannot collect\n        return []\n\n    # BFS setup for state (row, col, direction)\n    # Use collections.deque for efficient popleft\n    q = collections.deque()\n    visited = set() # Stores (r, c, d) states already visited\n\n    # Initial state: (row, col, direction, list_of_actions_taken)\n    q.append((initial_pos[0], initial_pos[1], initial_dir, []))\n    visited.add((initial_pos[0], initial_pos[1], initial_dir))\n\n    pr, pc = primitive_location # Row, Col of the primitive\n\n    while q:\n        r, c, d, actions = q.popleft()\n\n        # Check if the current state (r, c, d) allows for immediate collection of the primitive\n        # We need to be adjacent to (pr, pc) and facing it\n        \n        # Calculate the vector from current position (r, c) to primitive (pr, pc)\n        target_vec_dy, target_vec_dx = pr - r, pc - c\n\n        # Is the primitive directly in front of the agent?\n        # i.e., is the vector to the primitive the same as the vector for current direction 'd'?\n        if target_vec_dy == _DIRECTIONS[d][0] and target_vec_dx == _DIRECTIONS[d][1]:\n            # Yes, agent is adjacent and facing the primitive.\n            return actions + [USE]\n\n        # Explore possible next states (movements and turns)\n        \n        # 1. Move Forward (UP)\n        nr_up, nc_up = r + _DIRECTIONS[d][0], c + _DIRECTIONS[d][1]\n        if 0 <= nr_up < height and 0 <= nc_up < width and (nr_up, nc_up, d) not in visited:\n            q.append((nr_up, nc_up, d, actions + [UP]))\n            visited.add((nr_up, nc_up, d))\n\n        # 2. Move Backward (DOWN)\n        nr_down, nc_down = r - _DIRECTIONS[d][0], c - _DIRECTIONS[d][1]\n        if 0 <= nr_down < height and 0 <= nc_down < width and (nr_down, nc_down, d) not in visited:\n            q.append((nr_down, nc_down, d, actions + [DOWN]))\n            visited.add((nr_down, nc_down, d))\n\n        # 3. Turn Left (LEFT)\n        nd_left = (d - 1 + 4) % 4 # Ensure positive modulo result\n        if (r, c, nd_left) not in visited:\n            q.append((r, c, nd_left, actions + [LEFT]))\n            visited.add((r, c, nd_left))\n\n        # 4. Turn Right (RIGHT)\n        nd_right = (d + 1) % 4\n        if (r, c, nd_right) not in visited:\n            q.append((r, c, nd_right, actions + [RIGHT]))\n            visited.add((r, c, nd_right))\n\n    # If BFS completes without finding a path to collect the primitive (e.g., unreachable)\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:56:05.534856", "function_name": "collect", "function_body": "  import collections\n\n  # Helper mapping for cardinal directions and corresponding facing directions\n  # CraftState.dir: 0=North, 1=East, 2=South, 3=West\n  # (dr, dc) for (North, East, South, West)\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # North (row decreases, col same)\n      1: (0, 1),   # East (row same, col increases)\n      2: (1, 0),   # South (row increases, col same)\n      3: (0, -1)   # West (row same, col decreases)\n  }\n  # Map delta from agent to primitive to the required agent facing direction\n  DELTA_TO_DIR = {v: k for k, v in DIR_TO_DELTA.items()}\n\n  # Action IDs (from CraftLab action_specs) and their corresponding movement deltas and resulting facing directions\n  # These constants are assumed to be provided by the env_factory module.\n  ACTION_MOVEMENT_MAP = {\n      env_factory.UP: (-1, 0),    # Move North\n      env_factory.DOWN: (1, 0),   # Move South\n      env_factory.LEFT: (0, -1),  # Move West\n      env_factory.RIGHT: (0, 1),  # Move East\n  }\n  # When moving, the agent's facing direction typically aligns with the direction of movement.\n  ACTION_TO_NEW_DIR = {\n      env_factory.UP: 0,     # UP movement implies facing North (dir=0)\n      env_factory.DOWN: 2,   # DOWN movement implies facing South (dir=2)\n      env_factory.LEFT: 3,   # LEFT movement implies facing West (dir=3)\n      env_factory.RIGHT: 1,  # RIGHT movement implies facing East (dir=1)\n  }\n\n  current_state = env._current_state\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  grid_height, grid_width, _ = current_state.grid.shape\n\n  # 1. Locate all instances of the primitive on the grid\n  primitive_locations = []\n  for r in range(grid_height):\n      for c in range(grid_width):\n          if current_state.grid[r, c, primitive] > 0:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      # No primitive found in the world\n      return []\n\n  # 2. BFS to find the shortest path to an adjacent cell of a primitive,\n  #    ending in the correct orientation to USE it.\n  # Queue stores (row, col, current_direction, path_actions)\n  q = collections.deque([(initial_pos[0], initial_pos[1], initial_dir, [])])\n  # Visited set stores (row, col, direction) to avoid cycles and redundant paths\n  visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n  while q:\n      r, c, current_dir, path = q.popleft()\n\n      # Check if we are adjacent to any primitive and are facing it correctly\n      for pr, pc in primitive_locations:\n          # Calculate delta from agent position (r,c) to primitive position (pr,pc)\n          dr_prime, dc_prime = pr - r, pc - c\n          \n          # Check if (pr, pc) is directly adjacent to (r,c)\n          if (dr_prime, dc_prime) in DELTA_TO_DIR:\n              required_dir = DELTA_TO_DIR[(dr_prime, dc_prime)]\n              if current_dir == required_dir:\n                  # Found a path to a position where we can USE the primitive\n                  return path + [env_factory.USE]\n\n      # Explore movement actions\n      for action_id, (dr, dc) in ACTION_MOVEMENT_MAP.items():\n          new_r, new_c = r + dr, c + dc\n          new_dir = ACTION_TO_NEW_DIR[action_id] # Agent's facing direction changes based on movement\n\n          # Check bounds\n          if not (0 <= new_r < grid_height and 0 <= new_c < grid_width):\n              continue\n\n          # Check for obstacles (non-grabbable entities) in the new cell\n          is_blocked = False\n          # Iterate through all kinds in the target cell to see if any are non-grabbable and block movement\n          for kind_idx in current_state.world.non_grabbable_indices:\n              if current_state.grid[new_r, new_c, kind_idx] > 0:\n                  is_blocked = True\n                  break\n          if is_blocked:\n              continue # Cannot move into a blocked cell\n\n          # If the new state (position and direction) has not been visited, add it to the queue\n          if (new_r, new_c, new_dir) not in visited:\n              visited.add((new_r, new_c, new_dir))\n              q.append((new_r, new_c, new_dir, path + [action_id]))\n\n  return [] # No path found to collect the primitive", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:58:12.802479", "function_name": "collect", "function_body": "    from collections import deque\n\n    # Get action IDs dynamically from the environment's action_specs\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['RIGHT']  # Note: Left/Right might be swapped based on problem-specific mapping, typically LEFT is -X and RIGHT is +X\n    RIGHT = action_map['LEFT']  # Let's double check standard mappings if issue arises. Default often: 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT, 4:USE.\n    # Re-checking action_specs documentation: \"dict mapping DOWN\u21920, UP\u21921, LEFT\u21922, RIGHT\u21923, USE\u21924\"\n    # So, the standard mapping is:\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    current_state = env._current_state\n\n    # 1. Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    grid = current_state.grid\n    WIDTH, HEIGHT, _ = grid.shape\n    start_pos = current_state.pos\n\n    # 2. Identify all grid cells that contain the target primitive\n    target_object_positions = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            # Assuming that grid[x, y, primitive] == 1 indicates the presence of the primitive at (x, y)\n            if grid[x, y, primitive] == 1:\n                target_object_positions.append((x, y))\n\n    if not target_object_positions:\n        return [] # The primitive is not found anywhere on the current grid\n\n    # 3. Use Breadth-First Search (BFS) to find the shortest path to any target position\n    # The queue stores tuples: (current_position, [path_of_coordinates_from_start_to_current_inclusive])\n    q = deque([(start_pos, [start_pos])])\n    visited = {start_pos} # Keep track of visited positions to avoid cycles and redundant processing\n\n    # Define possible cardinal movements (dx, dy)\n    # (0, -1) -> Move UP (decreasing Y-coordinate)\n    # (0, 1)  -> Move DOWN (increasing Y-coordinate)\n    # (-1, 0) -> Move LEFT (decreasing X-coordinate)\n    # (1, 0)  -> Move RIGHT (increasing X-coordinate)\n    moves_dxdy = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n\n    final_path_coords = None\n\n    while q:\n        current_pos, path_coords = q.popleft()\n\n        # If the current position is one of our target object positions, we've found a path\n        if current_pos in target_object_positions:\n            final_path_coords = path_coords\n            break # Exit BFS as we found the shortest path\n\n        # Explore all valid neighboring cells\n        for dx, dy in moves_dxdy:\n            next_pos = (current_pos[0] + dx, current_pos[1] + dy)\n\n            # Check if the next position is within grid boundaries and hasn't been visited yet\n            if 0 <= next_pos[0] < WIDTH and \\\n               0 <= next_pos[1] < HEIGHT and \\\n               next_pos not in visited:\n                visited.add(next_pos) # Mark as visited\n                q.append((next_pos, path_coords + [next_pos])) # Add to queue with updated path\n\n    if final_path_coords is None:\n        return [] # No path could be found to any instance of the primitive\n\n    # 4. Convert the found coordinate path into a sequence of agent actions\n    actions = []\n    # Iterate through the path, from the start_pos to the target_pos\n    for i in range(len(final_path_coords) - 1):\n        p1 = final_path_coords[i]     # Current position in the path\n        p2 = final_path_coords[i+1]   # Next position in the path\n\n        dx = p2[0] - p1[0] # Change in X-coordinate\n        dy = p2[1] - p1[1] # Change in Y-coordinate\n\n        # Determine the action based on the change in coordinates\n        if dx == 1:\n            actions.append(RIGHT)\n        elif dx == -1:\n            actions.append(LEFT)\n        elif dy == 1:\n            actions.append(DOWN)\n        elif dy == -1:\n            actions.append(UP)\n    \n    # 5. Determine if a 'USE' action is required after reaching the target\n    # This assumes that specific primitives like water and stone require a 'USE' action\n    # while other grabbable items are collected simply by walking onto their cell.\n    water_idx = env.world.water_index\n    stone_idx = env.world.stone_index\n\n    # If the target primitive is water or stone, append the 'USE' action\n    # The agent will be on the cell containing the primitive after following the path.\n    if primitive == water_idx or primitive == stone_idx:\n        actions.append(USE)\n\n    return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:58:12.874402", "function_name": "collect", "function_body": "        actions_list = []\n        obs = env.observations()\n        inventory = obs['features_dict']['inventory']\n\n        # Check if the primitive is already in inventory\n        if inventory[primitive] > 0:\n            return [] # Already collected\n\n        grid = obs['features_dict']['features_global']\n        agent_pos_arr = obs['features_dict']['pos'] # This is a numpy array of [x, y] coordinates\n        current_x, current_y = int(agent_pos_arr[0]), int(agent_pos_arr[1])\n\n        # Find all locations of the primitive on the grid\n        # np.argwhere on a (WIDTH, HEIGHT) slice returns (x_coord, y_coord) if grid is (WIDTH, HEIGHT, ...)\n        primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n\n        if len(primitive_locations) == 0:\n            return [] # Primitive not found on map, cannot collect\n\n        # Find the closest primitive using Manhattan distance\n        closest_primitive_pos = None\n        min_dist = float('inf')\n        for px, py in primitive_locations:\n            dist = abs(px - current_x) + abs(py - current_y)\n            if dist < min_dist:\n                min_dist = dist\n                closest_primitive_pos = (px, py)\n\n        target_x, target_y = closest_primitive_pos\n\n        # Determine the best adjacent position to stand on and the action to face the primitive\n        # The agent must be adjacent to the target AND facing it for USE to work.\n        # ACTIONS = Struct(DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)\n        \n        adj_candidates_with_facing = [\n            ((target_x - 1, target_y), ACTIONS.RIGHT), # Primitive is to agent's RIGHT if agent stands here\n            ((target_x + 1, target_y), ACTIONS.LEFT),  # Primitive is to agent's LEFT if agent stands here\n            ((target_x, target_y - 1), ACTIONS.DOWN),  # Primitive is to agent's DOWN if agent stands here\n            ((target_x, target_y + 1), ACTIONS.UP)     # Primitive is to agent's UP if agent stands here\n        ]\n\n        GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n        \n        best_adj_pos = None\n        best_face_action = None\n        min_dist_to_adj = float('inf')\n\n        # Filter valid adjacent cells (within grid bounds) and find the closest one\n        for (ax, ay), face_action in adj_candidates_with_facing:\n            if 0 <= ax < GRID_WIDTH and 0 <= ay < GRID_HEIGHT:\n                dist = abs(ax - current_x) + abs(ay - current_y)\n                if dist < min_dist_to_adj:\n                    min_dist_to_adj = dist\n                    best_adj_pos = (ax, ay)\n                    best_face_action = face_action\n\n        if best_adj_pos is None:\n            return [] # No valid adjacent spot found (e.g., if primitive is at grid edge with no free adjacent cell)\n\n        # Pathfinding to best_adj_pos\n        # We need to ensure the LAST movement action sets the agent's direction to `best_face_action`.\n        path_x_moves = []\n        path_y_moves = []\n\n        # Generate X movements\n        temp_x = current_x\n        while temp_x != best_adj_pos[0]:\n            if best_adj_pos[0] > temp_x:\n                path_x_moves.append(ACTIONS.RIGHT)\n                temp_x += 1\n            else:\n                path_x_moves.append(ACTIONS.LEFT)\n                temp_x -= 1\n\n        # Generate Y movements\n        temp_y = current_y\n        while temp_y != best_adj_pos[1]:\n            if best_adj_pos[1] > temp_y:\n                path_y_moves.append(ACTIONS.DOWN)\n                temp_y += 1\n            else:\n                path_y_moves.append(ACTIONS.UP)\n                temp_y -= 1\n        \n        # Concatenate path components to ensure the last move aligns the agent's direction\n        # If the target facing is horizontal (LEFT/RIGHT), X movement component should be last.\n        if best_face_action in [ACTIONS.LEFT, ACTIONS.RIGHT]:\n            actions_list.extend(path_y_moves) # First move vertically\n            actions_list.extend(path_x_moves) # Then move horizontally (last action sets horizontal direction)\n        # If the target facing is vertical (UP/DOWN), Y movement component should be last.\n        elif best_face_action in [ACTIONS.UP, ACTIONS.DOWN]:\n            actions_list.extend(path_x_moves) # First move horizontally\n            actions_list.extend(path_y_moves) # Then move vertically (last action sets vertical direction)\n        \n        # Finally, add the USE action\n        actions_list.append(ACTIONS.USE)\n\n        return actions_list", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:00:15.378280", "function_name": "collect", "function_body": "    # Action constants (assuming these are defined elsewhere in the global scope\n    # or are hardcoded integer values per the DMLab-style interface).\n    # DOWN = 0\n    # UP = 1\n    # LEFT = 2\n    # RIGHT = 3\n    # USE = 4\n\n    # Get the current CraftState object from the environment.\n    # We access the internal `_current_state` attribute of CraftLab for detailed state info.\n    initial_state = env._current_state\n    \n    # 1. Check if the primitive is already in inventory\n    if initial_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed.\n\n    # BFS Queue: stores (current_x, current_y, current_dir, current_inventory_primitive_count, path_so_far, current_grid_copy, current_inventory_copy)\n    # Using a list as a queue and `pop(0)` is inefficient for large graphs but avoids `collections.deque` import.\n    queue = []\n    \n    # Visited set: stores (x, y, dir, has_primitive_in_inventory_bool) to prevent cycles and re-exploring same states.\n    # The grid state is too large to include in `visited` directly for efficient hashing, so we assume\n    # the environment is largely static except for the target primitive.\n    visited = set()\n\n    # Initial state for BFS\n    initial_x, initial_y = initial_state.pos\n    initial_dir = initial_state.dir # Agent's facing direction (0, 1, 2, 3)\n    initial_has_primitive = 1 if initial_state.inventory[primitive] > 0 else 0\n\n    # Grid dimensions and non-grabbable indices from the world configuration\n    grid_width, grid_height, n_kinds = initial_state.grid.shape\n    non_grabbable_indices = env.world.non_grabbable_indices # From CraftLab -> CraftWorld\n\n    # Find the primitive's initial location on the grid.\n    # This location is assumed to be static until collected.\n    primitive_grid_location = None\n    for x in range(grid_width):\n        for y in range(grid_height):\n            # Check if this cell contains the primitive kind.\n            # Assuming `> 0` means presence, as quantities can be > 1.\n            if initial_state.grid[x, y, primitive] > 0:\n                primitive_grid_location = (x, y)\n                break\n        if primitive_grid_location:\n            break\n\n    if not primitive_grid_location:\n        return [] # Primitive not found on the map, cannot collect.\n\n    # Define movement deltas for (dx, dy) based on action constants\n    # (dx, dy) for (RIGHT, LEFT, DOWN, UP) for (x, y) coordinates\n    # Assuming standard action mapping: RIGHT (positive X), LEFT (negative X),\n    # DOWN (positive Y), UP (negative Y).\n    move_deltas = {\n        RIGHT: (1, 0),\n        LEFT: (-1, 0),\n        DOWN: (0, 1),\n        UP: (0, -1)\n    }\n\n    # Add initial state to the BFS queue\n    # The grid and inventory are copied for each state in BFS to allow modification.\n    queue.append((initial_x, initial_y, initial_dir, initial_has_primitive, [], initial_state.grid.copy(), initial_state.inventory.copy()))\n    visited.add((initial_x, initial_y, initial_dir, initial_has_primitive))\n    \n    # BFS loop\n    while queue:\n        # Pop the current state from the front of the queue\n        current_x, current_y, current_dir, current_has_primitive, path_so_far, current_grid, current_inventory = queue.pop(0)\n\n        # If goal is met (primitive collected in this simulated state), return the path\n        if current_has_primitive > 0:\n            return path_so_far\n        \n        # Check if the agent is next to the primitive location (3x3 neighborhood)\n        # and try the USE action if so.\n        is_next_to_primitive = False\n        if primitive_grid_location: # Only check if primitive still exists on map (in simulation)\n            px, py = primitive_grid_location\n            # Check 3x3 neighborhood around the agent's current position (including current cell)\n            for dx in [-1, 0, 1]:\n                for dy in [-1, 0, 1]:\n                    nx, ny = current_x + dx, current_y + dy\n                    if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                        if current_grid[nx, ny, primitive] > 0:\n                            is_next_to_primitive = True\n                            break\n                if is_next_to_primitive:\n                    break\n\n        if is_next_to_primitive:\n            # Simulate the USE action\n            # For a primitive resource, USE is assumed to collect it.\n            next_inventory = current_inventory.copy()\n            next_inventory[primitive] += 1 # Assume 1 unit is collected\n\n            next_grid = current_grid.copy()\n            # Remove the primitive from its location on the grid in the simulated state\n            # This assumes primitive is a single item picked up, not a continuous source.\n            if primitive_grid_location:\n                 next_grid[primitive_grid_location[0], primitive_grid_location[1], primitive] = 0 \n            \n            next_has_primitive = 1 # Now the primitive is in inventory\n\n            next_state_tuple = (current_x, current_y, current_dir, next_has_primitive)\n\n            if next_state_tuple not in visited:\n                visited.add(next_state_tuple)\n                # Enqueue the new state after USE\n                queue.append((current_x, current_y, current_dir, next_has_primitive, path_so_far + [USE], next_grid, next_inventory))\n                # If this state results in collected primitive, the `if current_has_primitive > 0` at the top will catch it.\n\n        # Explore movement actions (UP, DOWN, LEFT, RIGHT)\n        for action in [UP, DOWN, LEFT, RIGHT]:\n            dx_move, dy_move = move_deltas[action]\n            next_x, next_y = current_x + dx_move, current_y + dy_move\n            next_dir = current_dir # Movement actions typically don't change agent's facing direction.\n            \n            # Check for validity of the new position (bounds and collisions)\n            is_walkable = True\n            if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n                is_walkable = False # Out of bounds\n            else:\n                # Check for collision with non-grabbable entities in the target cell\n                cell_contents = current_grid[next_x, next_y, :]\n                for k_idx in range(n_kinds):\n                    if cell_contents[k_idx] > 0 and k_idx in non_grabbable_indices:\n                        is_walkable = False\n                        break\n\n            if is_walkable:\n                next_state_tuple = (next_x, next_y, next_dir, current_has_primitive)\n                if next_state_tuple not in visited:\n                    visited.add(next_state_tuple)\n                    # Enqueue the new state after movement\n                    # grid and inventory remain unchanged by simple movement.\n                    queue.append((next_x, next_y, next_dir, current_has_primitive, path_so_far + [action], current_grid.copy(), current_inventory.copy()))\n\n    return [] # If the queue becomes empty and goal not met, no path was found.", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:00:15.452569", "function_name": "collect", "function_body": "    import collections\n\n    # Action constants (assuming these are defined in env_factory or globally)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Direction deltas (row, col) for agent facing directions (N, E, S, W)\n    # Assuming 0: North (-1,0), 1: East (0,1), 2: South (1,0), 3: West (0,-1)\n    _DIR_DELTAS = {\n        0: (-1, 0),  # North\n        1: (0, 1),   # East\n        2: (1, 0),   # South\n        3: (0, -1)   # West\n    }\n    # Opposite direction for moving backward or facing\n    _OPPOSITE_DIR = {\n        0: 2,  # North -> South\n        1: 3,  # East -> West\n        2: 0,  # South -> North\n        3: 1   # West -> East\n    }\n    # Turning left (updates agent direction)\n    _TURN_LEFT_DIR = {\n        0: 3,  # North -> West\n        1: 0,  # East -> North\n        2: 1,  # South -> East\n        3: 2   # West -> South\n    }\n    # Turning right (updates agent direction)\n    _TURN_RIGHT_DIR = {\n        0: 1,  # North -> East\n        1: 2,  # East -> South\n        2: 3,  # South -> West\n        3: 0   # West -> North\n    }\n\n    current_state = env._current_state\n    grid = current_state.grid\n    current_pos = current_state.pos\n    current_dir = current_state.dir\n\n    width, height, n_kinds = grid.shape\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # Helper function to check if a cell is blocked for agent movement\n    def is_blocked(r, c):\n        # Check boundary conditions\n        if not (0 <= r < width and 0 <= c < height):\n            return True\n\n        # If the cell contains the primitive itself, the agent cannot move onto it\n        # as it needs to be adjacent to perform USE action.\n        if grid[r, c, primitive] > 0:\n            return True\n\n        # Check for other non-grabbable obstacles (e.g., water, stone walls, etc.)\n        for k_idx in non_grabbable_indices:\n            if grid[r, c, k_idx] > 0:\n                return True\n        return False\n\n    # Find all locations of the primitive on the grid\n    primitive_locations = []\n    for r in range(width):\n        for c in range(height):\n            if grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the grid\n\n    # BFS state: (row, col, direction, list_of_actions_taken)\n    queue = collections.deque([(current_pos[0], current_pos[1], current_dir, [])])\n    # Visited set to avoid cycles and redundant explorations: (row, col, direction)\n    visited = set([(current_pos[0], current_pos[1], current_dir)])\n\n    while queue:\n        r, c, d, actions = queue.popleft()\n\n        # Check if current state (r, c, d) is a valid pre-collection state for any primitive\n        for pr, pc in primitive_locations:\n            # Check all 4 adjacent cells around the primitive location (pr, pc)\n            for facing_dir, (dr_prim, dc_prim) in _DIR_DELTAS.items():\n                # Candidate agent position (ar, ac) adjacent to the primitive\n                ar, ac = pr - dr_prim, pc - dc_prim # This is the agent's position if it's facing (pr, pc)\n\n                # If the agent is currently at this adjacent position\n                if r == ar and c == ac:\n                    # And is facing the primitive correctly\n                    if d == facing_dir:\n                        # Path found! Add the USE action and return.\n                        return actions + [ACTION_USE]\n\n        # Explore next possible states by applying actions\n        # 1. Move Forward (ACTION_DOWN)\n        dr_fwd, dc_fwd = _DIR_DELTAS[d]\n        next_r_fwd, next_c_fwd = r + dr_fwd, c + dc_fwd\n        if not is_blocked(next_r_fwd, next_c_fwd) and (next_r_fwd, next_c_fwd, d) not in visited:\n            visited.add((next_r_fwd, next_c_fwd, d))\n            queue.append((next_r_fwd, next_c_fwd, d, actions + [ACTION_DOWN]))\n\n        # 2. Move Backward (ACTION_UP)\n        dr_bwd, dc_bwd = _DIR_DELTAS[_OPPOSITE_DIR[d]]\n        next_r_bwd, next_c_bwd = r + dr_bwd, c + dc_bwd\n        if not is_blocked(next_r_bwd, next_c_bwd) and (next_r_bwd, next_c_bwd, d) not in visited:\n            visited.add((next_r_bwd, next_c_bwd, d))\n            queue.append((next_r_bwd, next_c_bwd, d, actions + [ACTION_UP]))\n\n        # 3. Turn Left (ACTION_LEFT)\n        next_d_left = _TURN_LEFT_DIR[d]\n        if (r, c, next_d_left) not in visited:\n            visited.add((r, c, next_d_left))\n            queue.append((r, c, next_d_left, actions + [ACTION_LEFT]))\n\n        # 4. Turn Right (ACTION_RIGHT)\n        next_d_right = _TURN_RIGHT_DIR[d]\n        if (r, c, next_d_right) not in visited:\n            visited.add((r, c, next_d_right))\n            queue.append((r, c, next_d_right, actions + [ACTION_RIGHT]))\n\n    return [] # No path found to collect the primitive", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:01:23.162224", "function_name": "collect", "function_body": "    import collections\n\n    # Define action constants based on action_specs()\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    def _get_move_action(current_pos, next_pos):\n        \"\"\"Determines the action (UP/DOWN/LEFT/RIGHT) to move from current_pos to next_pos.\"\"\"\n        dx = next_pos[0] - current_pos[0]\n        dy = next_pos[1] - current_pos[1]\n\n        if dx == 0 and dy == -1: return UP\n        if dx == 0 and dy == 1: return DOWN\n        if dx == -1 and dy == 0: return LEFT\n        if dx == 1 and dy == 0: return RIGHT\n        # This case should not be reached if called with valid adjacent positions\n        raise ValueError(f\"Invalid move from {current_pos} to {next_pos}\")\n\n    def _get_neighbors_coords(pos, grid_width, grid_height):\n        \"\"\"Returns valid neighboring (x, y) coordinates within grid bounds.\"\"\"\n        x, y = pos\n        neighbors = []\n        # Define relative moves for Up, Down, Left, Right\n        for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                neighbors.append((nx, ny))\n        return neighbors\n\n    def _is_walkable(grid, pos, world):\n        \"\"\"\n        Checks if a given grid cell at `pos` is walkable.\n        A cell is not walkable if it contains any entity from `world.non_grabbable_indices`.\n        \"\"\"\n        for kind_idx in world.non_grabbable_indices:\n            if grid[pos[0], pos[1], kind_idx] > 0: # Check if this non-grabbable kind is present\n                return False\n        return True # No non-grabbable item found at this position\n\n    def _find_primitive_locations(grid, primitive_idx):\n        \"\"\"\n        Finds all (x, y) coordinates on the grid where the `primitive_idx` is located.\n        \"\"\"\n        locations = []\n        width, height, _ = grid.shape\n        for x in range(width):\n            for y in range(height):\n                if grid[x, y, primitive_idx] > 0: # If the primitive is at this cell\n                    locations.append((x, y))\n        return locations\n\n    def _bfs_path(start_pos, target_adj_cells, grid, world):\n        \"\"\"\n        Performs Breadth-First Search (BFS) to find the shortest path from `start_pos`\n        to any of the `target_adj_cells`.\n        Returns a list of actions (UP/DOWN/LEFT/RIGHT) or None if no path exists.\n        \"\"\"\n        q = collections.deque([(start_pos, [])]) # (current_pos, path_to_current_pos)\n        visited = {start_pos}\n\n        width, height, _ = grid.shape\n\n        while q:\n            current_pos, current_path = q.popleft()\n\n            if current_pos in target_adj_cells:\n                return current_path\n\n            for neighbor_pos in _get_neighbors_coords(current_pos, width, height):\n                if neighbor_pos not in visited and _is_walkable(grid, neighbor_pos, world):\n                    visited.add(neighbor_pos)\n                    action = _get_move_action(current_pos, neighbor_pos)\n                    q.append((neighbor_pos, current_path + [action]))\n        return None # No path found\n\n    # Main logic for collect_v2\n    state = env._current_state\n    world = env.world\n    inventory = state.inventory\n\n    # 1. Check if the primitive is already in the agent's inventory\n    if inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    start_pos = state.pos\n    grid = state.grid\n    width, height, _ = grid.shape\n\n    # 2. Find all locations on the grid where the primitive exists\n    primitive_locations = _find_primitive_locations(grid, primitive)\n    if not primitive_locations:\n        return [] # Primitive not found on the map, cannot collect\n\n    # 3. Determine all possible walkable cells adjacent to any primitive location\n    target_adj_cells = set()\n    for p_loc in primitive_locations:\n        for n_loc in _get_neighbors_coords(p_loc, width, height):\n            # The agent must be able to stand on this cell to use the primitive.\n            if _is_walkable(grid, n_loc, world):\n                target_adj_cells.add(n_loc)\n    \n    if not target_adj_cells:\n        # Primitive exists but is surrounded by non-walkable items (e.g., water),\n        # so there are no walkable adjacent cells to stand on.\n        return []\n\n    # 4. Find the shortest sequence of actions to reach any of the target adjacent cells\n    path_to_primitive_adj = _bfs_path(start_pos, target_adj_cells, grid, world)\n\n    if path_to_primitive_adj is None:\n        return [] # No path found to reach the primitive (e.g., it's on an inaccessible island)\n\n    # 5. Once adjacent, use the 'USE' action to collect the primitive\n    final_actions = path_to_primitive_adj + [USE]\n    return final_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:01:23.234500", "function_name": "collect", "function_body": "    # ACTION CONSTANTS based on CraftLab.action_specs()\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Assuming collections.deque is available (e.g., from standard library or pre-imported)\n    import collections\n\n    state = env._current_state\n    grid = state.grid\n    current_pos = state.pos\n    grid_width, grid_height, _ = grid.shape\n\n    # Determine if the primitive is grabbable (picked up by movement onto its cell)\n    # or if it requires a 'USE' action from an adjacent cell.\n    primitive_is_grabbable = primitive in state.world.grabbable_indices\n\n    # Find all locations on the grid where the primitive exists\n    primitive_locations = []\n    for x_coord in range(grid_width):\n        for y_coord in range(grid_height):\n            if grid[x_coord, y_coord, primitive] > 0:\n                primitive_locations.append((x_coord, y_coord))\n\n    if not primitive_locations:\n        # If the primitive is not found on the grid, no actions can collect it.\n        return []\n\n    # BFS setup: Queue stores (position, actions_taken_to_reach_pos)\n    q = collections.deque([(current_pos, [])])\n    # Set to keep track of visited positions to avoid redundant explorations and cycles\n    visited = {current_pos}\n\n    # Variable to store the shortest path actions found\n    best_path_actions = []\n    \n    # Perform Breadth-First Search\n    while q:\n        (x, y), path_actions = q.popleft()\n\n        # Check if the current position meets the goal criteria:\n        # - If grabbable: agent needs to be ON the primitive's location.\n        # - If not grabbable: agent needs to be ADJACENT to the primitive's location.\n        is_goal_achieved_at_current_pos = False\n        if primitive_is_grabbable:\n            if (x, y) in primitive_locations:\n                is_goal_achieved_at_current_pos = True\n        else:\n            for px, py in primitive_locations:\n                # Check for adjacency using Manhattan distance (1 unit away)\n                if (abs(x - px) + abs(y - py)) == 1:\n                    is_goal_achieved_at_current_pos = True\n                    break\n\n        if is_goal_achieved_at_current_pos:\n            # A shortest path to a valid collection point has been found\n            best_path_actions = list(path_actions) # Make a copy of the path taken\n            if not primitive_is_grabbable:\n                # If the item is not grabbable, a 'USE' action is required after reaching the spot\n                best_path_actions.append(ACTION_USE)\n            break # Exit BFS as the shortest path is guaranteed by BFS\n\n        # Explore neighboring cells (UP, DOWN, LEFT, RIGHT)\n        # (nx, ny, action_to_reach_neighbor) tuples for movement directions\n        neighbors = [\n            (x, y - 1, ACTION_UP),\n            (x, y + 1, ACTION_DOWN),\n            (x - 1, y, ACTION_LEFT),\n            (x + 1, y, ACTION_RIGHT)\n        ]\n\n        for nx, ny, action in neighbors:\n            # Check if the neighbor is within the grid boundaries\n            if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                # Assuming all grid cells are traversable for movement in CraftWorld.\n                # If there were specific obstacles (e.g., walls), additional checks would be needed here.\n                if (nx, ny) not in visited:\n                    visited.add((nx, ny))\n                    new_path = list(path_actions) # Create a new path list for the neighbor\n                    new_path.append(action)\n                    q.append(((nx, ny), new_path))\n    \n    return best_path_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:02:52.372726", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants based on action_specs dict mapping\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Mapping of (dr, dc) to agent's required facing direction (N=0, E=1, S=2, W=3)\n  DIRECTION_VECTORS = {\n      (-1, 0): 0,  # North (row-1, col)\n      (0, 1): 1,   # East (row, col+1)\n      (1, 0): 2,   # South (row+1, col)\n      (0, -1): 3   # West (row, col-1)\n  }\n\n  def get_actions_to_turn(current_dir, target_dir):\n      \"\"\"Returns a list of actions (LEFT/RIGHT) to turn from current_dir to target_dir.\"\"\"\n      actions_to_take = []\n      # Calculate difference in directions, handling wrap-around (0-3)\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # Turn Right\n          actions_to_take.append(RIGHT)\n      elif diff == 2: # Turn 180 (two rights or two lefts)\n          actions_to_take.extend([RIGHT, RIGHT]) # Two rights or two lefts work\n      elif diff == 3: # Turn Left\n          actions_to_take.append(LEFT)\n      return actions_to_take\n\n  actions_sequence = []\n\n  # Get current state information directly from env._current_state\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos # (row, col) tuple\n  current_dir = current_state.dir # int (0-3)\n  inventory = current_state.inventory\n  \n  # Get non-grabbable indices from the world configuration\n  non_grabbable = env.world.non_grabbable_indices\n\n  WIDTH, HEIGHT, _ = grid.shape # N_KINDS is not directly used for grid dimensions\n\n  # 1. Check if the primitive is already in inventory\n  if inventory[primitive] > 0:\n      return []\n\n  # 2. Find all locations of the primitive on the grid\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          if grid[r, c, primitive] > 0:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      # Primitive not found anywhere on the map\n      return []\n\n  # 3. Find the closest primitive and a path to an adjacent traversable cell\n  min_path_len = float('inf')\n  best_path_to_adj_coords = []\n  best_target_primitive_pos = None # The actual (r,c) of the primitive we're aiming for\n\n  for item_r, item_c in primitive_locations:\n      # Define potential adjacent cells to the primitive\n      potential_adj_cells = [\n          (item_r - 1, item_c), (item_r + 1, item_c),\n          (item_r, item_c - 1), (item_r, item_c + 1)\n      ]\n      \n      valid_adj_for_this_item = []\n      for ar, ac in potential_adj_cells:\n          # Check if adjacent cell is within grid bounds\n          if 0 <= ar < WIDTH and 0 <= ac < HEIGHT:\n              # Check if adjacent cell is traversable (not blocked by non-grabbable items)\n              is_blocked_adj = False\n              for non_grab_idx in non_grabbable:\n                  if grid[ar, ac, non_grab_idx] > 0:\n                      is_blocked_adj = True\n                      break\n              if not is_blocked_adj:\n                  valid_adj_for_this_item.append((ar, ac))\n\n      if not valid_adj_for_this_item:\n          continue # No traversable adjacent cells for this primitive instance\n\n      # BFS to find the shortest path from current_pos to any of valid_adj_for_this_item\n      # q stores (current_coords_tuple, path_coords_list_from_start_to_current)\n      q = collections.deque([(current_pos, [])])\n      visited = {current_pos}\n\n      while q:\n          curr_node, current_path_coords = q.popleft()\n          cr, cc = curr_node\n\n          if curr_node in valid_adj_for_this_item:\n              # Found a path to an adjacent cell. Check if it's the shortest overall.\n              if len(current_path_coords) < min_path_len:\n                  min_path_len = len(current_path_coords)\n                  best_path_to_adj_coords = current_path_coords\n                  best_target_primitive_pos = (item_r, item_c)\n              # Optimization: Since BFS finds shortest path in terms of steps,\n              # we can break this inner BFS once we find the first path to *any*\n              # of the valid adjacent cells for this primitive instance.\n              # This assumes all adj cells are equally good for distance.\n              # To truly find the globally shortest path to *any* primitive's adj cell,\n              # this inner BFS should complete for each primitive_location, then select the minimum.\n              # The current structure will find the shortest path to *one* adjacent cell for the *first*\n              # primitive instance encountered in `primitive_locations` that has a valid path,\n              # or a shorter path to an adjacent cell for a later primitive.\n              # For competitive programming, this might be okay. For a full robust solution, a single BFS\n              # targeting all valid adjacent cells for all primitives at once would be more efficient.\n              break \n\n          # Explore neighbors (Up, Right, Down, Left)\n          for dr, dc in DIRECTION_VECTORS.keys(): # Keys are (-1,0), (0,1), (1,0), (0,-1) corresponding to N,E,S,W\n              nr, nc = cr + dr, cc + dc\n              next_node = (nr, nc)\n\n              # Check if next cell is within bounds and not visited\n              if 0 <= nr < WIDTH and 0 <= nc < HEIGHT and next_node not in visited:\n                  is_next_cell_blocked = False\n                  # Cannot move onto non-grabbable items\n                  for non_grab_idx in non_grabbable:\n                      if grid[nr, nc, non_grab_idx] > 0:\n                          is_next_cell_blocked = True\n                          break\n                  # Cannot move onto the target primitive itself during pathfinding (we want to be adjacent)\n                  if next_node == (item_r, item_c):\n                      is_next_cell_blocked = True\n                  \n                  if not is_next_cell_blocked:\n                      visited.add(next_node)\n                      q.append((next_node, current_path_coords + [next_node]))\n\n  if not best_path_to_adj_coords:\n      # No path found to any primitive's adjacent cell\n      return []\n\n  # 4. Convert path coordinates to action sequence\n  # We simulate agent's position and direction along the planned path\n  curr_r, curr_c = current_pos\n  sim_dir = current_dir # Simulate the agent's direction\n\n  for next_r, next_c in best_path_to_adj_coords:\n      dr, dc = next_r - curr_r, next_c - curr_c\n      \n      required_dir_to_move = DIRECTION_VECTORS.get((dr, dc))\n      if required_dir_to_move is None:\n          # This should not happen if pathfinding is correct and only uses cardinal moves.\n          return [] # Abort if an invalid step is generated\n\n      # Add turn actions to face the required direction\n      actions_sequence.extend(get_actions_to_turn(sim_dir, required_dir_to_move))\n      sim_dir = required_dir_to_move # Update simulated agent's direction\n\n      # Add move action (UP means move forward in current direction)\n      actions_sequence.append(UP)\n      curr_r, curr_c = next_r, next_c # Update simulated agent's position\n\n  # 5. Agent is now adjacent to the target primitive. Turn to face it and USE.\n  if best_target_primitive_pos:\n      item_r, item_c = best_target_primitive_pos\n      # Vector from simulated agent's final position to the primitive\n      dr, dc = item_r - curr_r, item_c - curr_c \n      \n      required_dir_for_use = DIRECTION_VECTORS.get((dr, dc))\n      if required_dir_for_use is not None:\n          # Add turn actions to face the primitive\n          actions_sequence.extend(get_actions_to_turn(sim_dir, required_dir_for_use))\n          # No need to update sim_dir as this is the final action in the sequence.\n          \n          # Add USE action\n          actions_sequence.append(USE)\n  \n  return actions_sequence", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:02:53.353609", "function_name": "collect", "function_body": "  import collections\n\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos  # (x, y)\n\n  # Grid shape is (WIDTH, HEIGHT, n_kinds)\n  width, height, n_kinds = grid.shape\n\n  # Get non-grabbable indices from the CraftWorld instance\n  # These are assumed to be obstacles for movement\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # 1. Identify all potential target positions (cells where agent can be to USE the primitive)\n  # A cell (x, y) is a target if it contains the primitive, or is adjacent to a primitive.\n  # The `CraftState.next_to` method implies a 3x3 neighborhood (including self).\n  # Assuming 4-directional adjacency for movement, we consider the primitive's cell and its 4 neighbors.\n  target_coords = set()\n  for x in range(width):\n    for y in range(height):\n      if grid[x, y, primitive] > 0:  # Primitive found at (x, y)\n        # Add the primitive's location itself\n        target_coords.add((x, y))\n\n        # Add 4-directional neighbors (cells from which agent can USE)\n        # These are potential positions from which `next_to(primitive)` would be true.\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < width and 0 <= ny < height:\n            target_coords.add((nx, ny))\n\n  # If no primitive found on the map, cannot collect\n  if not target_coords:\n    return []\n\n  # 2. Check if agent is already in a position to USE the primitive\n  # This uses the built-in `next_to` check, which is more robust than just checking `start_pos` against `target_coords`\n  if current_state.next_to(primitive):\n    return [env_factory.USE]\n\n  # 3. Perform BFS to find the shortest path to any target_coord\n  q = collections.deque([(start_pos, [])])  # (current_pos, actions_taken_to_reach_current_pos)\n  visited = {start_pos}\n\n  moves = [\n      (-1, 0, env_factory.LEFT),   # (dx, dy, action)\n      (1, 0, env_factory.RIGHT),\n      (0, -1, env_factory.UP),\n      (0, 1, env_factory.DOWN)\n  ]\n\n  while q:\n    (curr_x, curr_y), actions = q.popleft()\n\n    # If current position is one of the target coordinates, we found the shortest path.\n    if (curr_x, curr_y) in target_coords:\n      # We found the path. Add the USE action as the final step.\n      return actions + [env_factory.USE]\n\n    for dx, dy, action in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check boundaries\n      if not (0 <= next_x < width and 0 <= next_y < height):\n        continue\n\n      # Check if already visited\n      if (next_x, next_y) in visited:\n        continue\n\n      # Check if the cell is traversable (not an impassable obstacle)\n      is_traversable = True\n      for obs_idx in non_grabbable_indices:\n        if grid[next_x, next_y, obs_idx] > 0:\n          is_traversable = False\n          break\n\n      if is_traversable:\n        visited.add((next_x, next_y))\n        q.append(((next_x, next_y), actions + [action]))\n\n  # If BFS completes and no path was found to any target_coord\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:04:02.185768", "function_name": "collect", "function_body": "    import collections\n\n    state = env._current_state\n    grid = state.grid\n    current_pos = state.pos\n    world = state.world\n    \n    # Grid dimensions (WIDTH, HEIGHT) based on numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds)\n    max_x, max_y = grid.shape[0], grid.shape[1] \n\n    non_grabbable_indices = world.non_grabbable_indices\n\n    # Action IDs based on CraftLab.action_specs()\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Mapping of (dx, dy) to action ID for agent at (x, y)\n    # (dx, dy) is (change_in_x, change_in_y)\n    # Up: (x, y-1) -> (0, -1)\n    # Down: (x, y+1) -> (0, 1)\n    # Left: (x-1, y) -> (-1, 0)\n    # Right: (x+1, y) -> (1, 0)\n    _ACTION_MAP_DXDY = {\n        (0, -1): ACTION_UP,     \n        (0, 1): ACTION_DOWN,    \n        (-1, 0): ACTION_LEFT,   \n        (1, 0): ACTION_RIGHT,   \n    }\n    _ADJACENT_DIRS = list(_ACTION_MAP_DXDY.keys()) # Possible movement directions\n\n    # 1. Find all locations of the primitive in the grid\n    primitive_locs = []\n    for x in range(max_x):\n        for y in range(max_y):\n            if grid[x, y, primitive] == 1:\n                primitive_locs.append((x, y))\n\n    if not primitive_locs:\n        return [] # Primitive not found in the grid\n\n    # 2. Identify potential agent target cells (neighbors of primitive)\n    target_cells = set()\n    for px, py in primitive_locs:\n        for dx, dy in _ADJACENT_DIRS:\n            nx, ny = px + dx, py + dy\n            \n            # Check if neighbor is within grid bounds\n            if 0 <= nx < max_x and 0 <= ny < max_y:\n                # Check if neighbor cell is walkable (does not contain any non-grabbable items)\n                is_walkable = True\n                for kind_idx in non_grabbable_indices:\n                    if grid[nx, ny, kind_idx] == 1:\n                        is_walkable = False\n                        break\n                if is_walkable:\n                    target_cells.add((nx, ny))\n    \n    if not target_cells:\n        # No valid reachable spot adjacent to the primitive\n        return []\n\n    # 3. Perform BFS to find the shortest path from current_pos to any target_cell\n    # Queue stores (position, list_of_actions_taken_to_reach_pos)\n    queue = collections.deque([(current_pos, [])])\n    visited = {current_pos}\n    \n    best_path_actions = None\n\n    while queue:\n        (cx, cy), path_actions = queue.popleft()\n\n        # If current position is one of the target cells, we found a path\n        if (cx, cy) in target_cells:\n            best_path_actions = path_actions\n            break # BFS guarantees the first path found is a shortest path\n\n        # Explore valid neighbors\n        for dx, dy in _ADJACENT_DIRS:\n            nx, ny = cx + dx, cy + dy\n            new_pos = (nx, ny)\n\n            # Check if new position is within bounds and not visited\n            if 0 <= nx < max_x and 0 <= ny < max_y and new_pos not in visited:\n                # Check if new position is walkable\n                is_walkable = True\n                for kind_idx in non_grabbable_indices:\n                    if grid[nx, ny, kind_idx] == 1:\n                        is_walkable = False\n                        break\n                \n                if is_walkable:\n                    visited.add(new_pos)\n                    # Get the action ID corresponding to this move\n                    action_id = _ACTION_MAP_DXDY[(dx, dy)]\n                    queue.append((new_pos, path_actions + [action_id]))\n\n    if best_path_actions is None:\n        return [] # No path found to any target cell\n\n    # Append the USE action after reaching the adjacent cell\n    return best_path_actions + [ACTION_USE]", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:04:02.257570", "function_name": "collect", "function_body": "    actions = []\n    MAX_ACTIONS = 200 # Safety limit to prevent infinite loops\n\n    # Get the initial state of the environment\n    # CraftLab stores the current state in its _current_state attribute\n    state = env._current_state\n\n    # Loop until the primitive is collected (inventory count > 0)\n    # or the maximum number of actions is reached\n    while state.inventory[primitive] == 0 and len(actions) < MAX_ACTIONS:\n        # First, check if the primitive is in the immediate vicinity (3x3 neighborhood)\n        # and can be collected using the USE action.\n        if state.next_to(primitive):\n            actions.append(env_factory.USE)\n            env.step(env_factory.USE) # Perform the USE action\n            # Update the state to reflect changes after the action for the next iteration\n            state = env._current_state\n            continue # Re-check inventory in the next loop iteration\n\n        # If not next to the agent, find the primitive's location on the grid\n        # state.grid is a numpy array of shape (WIDTH, HEIGHT, n_kinds)\n        # np.where(state.grid[:, :, primitive] > 0) returns (row_indices, col_indices)\n        # where the primitive is present.\n        primitive_locations_y, primitive_locations_x = np.where(state.grid[:, :, primitive] > 0)\n\n        # If the primitive is not found anywhere on the map, we can't collect it.\n        # This might happen if it's behind unmovable obstacles or simply doesn't exist.\n        if len(primitive_locations_x) == 0:\n            break # Give up if the primitive cannot be located\n\n        current_pos = state.pos # Agent's current position (x, y)\n        target_pos = None\n        min_distance = float('inf')\n\n        # Find the closest occurrence of the primitive using Manhattan distance\n        for i in range(len(primitive_locations_x)):\n            px, py = primitive_locations_x[i], primitive_locations_y[i]\n            dist = abs(px - current_pos[0]) + abs(py - current_pos[1])\n            if dist < min_distance:\n                min_distance = dist\n                target_pos = (px, py)\n\n        # If a target position was found, determine the next action to move towards it\n        if target_pos is not None:\n            delta_x = target_pos[0] - current_pos[0]\n            delta_y = target_pos[1] - current_pos[1]\n\n            action_to_take = -1 # Initialize with a sentinel value\n\n            # Prioritize movement along the axis with the larger absolute difference.\n            # If differences are equal, prioritize horizontal movement (X-axis).\n            if abs(delta_x) >= abs(delta_y) and delta_x != 0:\n                action_to_take = env_factory.RIGHT if delta_x > 0 else env_factory.LEFT\n            elif delta_y != 0: # If delta_y is larger/equal or delta_x is zero\n                action_to_take = env_factory.DOWN if delta_y > 0 else env_factory.UP\n            else:\n                # This case implies delta_x == 0 and delta_y == 0.\n                # The agent is already at the target_pos.\n                # If state.next_to(primitive) was False here, it means the item\n                # at the exact current_pos cannot be 'USE'd, or next_to logic\n                # somehow doesn't cover it. In such a scenario, we can't move\n                # closer, and we couldn't use it, so we are stuck.\n                break # Cannot proceed, break the loop\n\n            if action_to_take != -1:\n                actions.append(action_to_take)\n                env.step(action_to_take) # Perform the determined movement action\n                # Update the state after the action\n                state = env._current_state\n            else:\n                # If no action was determined but a target_pos existed, it means\n                # delta_x and delta_y were both 0. This should have been handled\n                # by the state.next_to(primitive) check earlier. If not, it's an\n                # unresolvable state for this simple logic.\n                break\n        else:\n            # target_pos is None implies primitive_locations_x was empty,\n            # which is handled by the `if len(primitive_locations_x) == 0:` break earlier.\n            # This 'else' should theoretically not be reached if the previous\n            # checks are correct.\n            break\n\n    return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:05:38.242394", "function_name": "collect", "function_body": "    actions_list = []\n    \n    # Get initial state observations\n    obs = env.observations()\n    initial_grid = obs['features_dict']['features_global']\n    initial_pos = tuple(obs['features_dict']['pos']) # (x, y)\n    initial_inventory = obs['features_dict']['inventory']\n\n    # Check if primitive is already collected\n    if initial_inventory[primitive] > 0:\n        return []\n\n    # Find the primitive's location(s) on the grid\n    # initial_grid has shape (WIDTH, HEIGHT, n_kinds)\n    primitive_locations = np.argwhere(initial_grid[:, :, primitive] == 1)\n\n    if len(primitive_locations) == 0:\n        # Primitive not found on the grid\n        return []\n\n    # Target the first found primitive location\n    target_px, target_py = primitive_locations[0]\n\n    grid_width, grid_height, _ = initial_grid.shape\n\n    # Define movement actions and their effects on position\n    # (dx, dy) mapping for agent's movement:\n    # UP: (0, -1) changes Y by -1\n    # RIGHT: (1, 0) changes X by +1\n    # DOWN: (0, 1) changes Y by +1\n    # LEFT: (-1, 0) changes X by -1\n    MOVE_DELTAS = {\n        env_factory.ACTIONS.UP: (0, -1),\n        env_factory.ACTIONS.RIGHT: (1, 0),\n        env_factory.ACTIONS.DOWN: (0, 1),\n        env_factory.ACTIONS.LEFT: (-1, 0)\n    }\n\n    # BFS to find the shortest path to a cell adjacent to the primitive\n    # State in BFS queue: ((current_x, current_y), list_of_actions_to_reach_here)\n    q = deque([(initial_pos, [])])\n    visited = {initial_pos} # Keep track of visited (x, y) positions\n\n    path_to_adjacent_cell = None\n    \n    # Safety limit for BFS to prevent infinite loops in complex or unreachable scenarios\n    max_bfs_steps = grid_width * grid_height * 2 \n\n    while q and max_bfs_steps > 0:\n        (curr_x, curr_y), current_path = q.popleft()\n        max_bfs_steps -= 1\n\n        # Check if the current position is adjacent to the primitive\n        is_adjacent_to_primitive = False\n        for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Check 4-connectivity\n            check_x, check_y = curr_x + dx_adj, curr_y + dy_adj\n            if (check_x == target_px) and (check_y == target_py):\n                is_adjacent_to_primitive = True\n                break\n\n        if is_adjacent_to_primitive:\n            path_to_adjacent_cell = current_path\n            break # Path to an adjacent cell found!\n\n        # Explore neighbors\n        for action_enum, (dx, dy) in MOVE_DELTAS.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_pos = (next_x, next_y)\n\n            # Check bounds\n            if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n                continue\n\n            # Check if already visited\n            if next_pos in visited:\n                continue\n\n            # Check traversability of the next cell\n            is_traversable = True\n            \n            # Agent cannot move into a cell currently occupied by the primitive it wants to collect.\n            # It also cannot move into cells occupied by non-grabbable items.\n            if initial_grid[next_x, next_y, primitive] == 1:\n                is_traversable = False\n            else: \n                # Check for other non-grabbable items\n                # `env.world.kinds` contains all possible item indices\n                for kind_idx in env.world.kinds: \n                    if kind_idx in env.world.non_grabbable_indices and initial_grid[next_x, next_y, kind_idx] == 1:\n                        is_traversable = False\n                        break\n            \n            if not is_traversable:\n                continue\n            \n            visited.add(next_pos)\n            q.append((next_pos, current_path + [action_enum]))\n\n    if path_to_adjacent_cell is None:\n        # No path found to any cell adjacent to the primitive within limits\n        return []\n\n    # Append the found path to the actions list\n    actions_list.extend(path_to_adjacent_cell)\n\n    # After reaching the adjacent cell, perform the USE action.\n    # This assumes that the USE action, in the context of this environment,\n    # can collect a grabbable item that is in an adjacent cell (e.g., within a 3x3 neighborhood),\n    # especially since there are no explicit \"turn\" actions.\n    actions_list.append(env_factory.ACTIONS.USE)\n\n    return actions_list", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:05:38.314411", "function_name": "collect", "function_body": "    actions = []\n\n    # 1. Get current state and relevant information\n    # Accessing private attribute _current_state as it's the only way to get state.\n    current_state = env._current_state\n    grid = current_state.grid\n    agent_pos = current_state.pos\n    world = current_state.world  # Needed for non_grabbable_indices\n\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n    ax, ay = agent_pos[0], agent_pos[1]\n\n    # Define action constants for readability\n    _ACTION_DOWN = 0\n    _ACTION_UP = 1\n    _ACTION_LEFT = 2\n    _ACTION_RIGHT = 3\n    _ACTION_USE = 4\n\n    # 2. Check if primitive is already collected\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # 3. Locate the primitive on the grid\n    # np.argwhere returns a list of (row, col) tuples where the condition is true.\n    primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n\n    if len(primitive_locations) == 0:\n        # Primitive not found on the grid\n        return []\n\n    # Choose the primitive instance closest to the agent\n    min_dist_to_primitive = float('inf')\n    target_primitive_pos = None\n\n    for p_coord in primitive_locations:\n        px, py = p_coord[0], p_coord[1]\n        dist = abs(px - ax) + abs(py - ay)\n        if dist < min_dist_to_primitive:\n            min_dist_to_primitive = dist\n            target_primitive_pos = (px, py)\n    \n    # This should not be None if primitive_locations was not empty, but for safety\n    if target_primitive_pos is None:\n        return []\n\n    px, py = target_primitive_pos\n\n    # 4. Determine target adjacent cell for agent to move to\n    adj_cells_around_primitive = [\n        (px - 1, py), (px + 1, py), (px, py - 1), (px, py + 1)\n    ]\n    \n    valid_target_adj_cells = []\n    for cx, cy in adj_cells_around_primitive:\n        # Check boundary conditions\n        if not (0 <= cx < WIDTH and 0 <= cy < HEIGHT):\n            continue\n\n        # Check if cell is an obstacle (non-grabbable items)\n        is_obstacle = False\n        for k_idx in world.non_grabbable_indices:\n            # If the current cell (cx,cy) contains k_idx, and k_idx is non-grabbable, it's an obstacle.\n            # Agent cannot move onto a cell containing a non-grabbable item.\n            if grid[cx, cy, k_idx] == 1:\n                is_obstacle = True\n                break\n        \n        # Also, the agent cannot move onto the primitive it wants to collect.\n        if grid[cx, cy, primitive] == 1:\n            is_obstacle = True  # The primitive itself is not a traversable spot for agent.\n\n        if not is_obstacle:\n            valid_target_adj_cells.append((cx, cy))\n\n    if not valid_target_adj_cells:\n        # No clear path to get next to the primitive\n        return []\n\n    # Choose the valid adjacent cell that is closest to the agent's current position\n    min_dist_to_adj = float('inf')\n    target_agent_pos = None  # This will be the (tx, ty)\n\n    for tac_x, tac_y in valid_target_adj_cells:\n        dist = abs(tac_x - ax) + abs(tac_y - ay)\n        if dist < min_dist_to_adj:\n            min_dist_to_adj = dist\n            target_agent_pos = (tac_x, tac_y)\n    \n    if target_agent_pos is None:  # Fallback, should not happen if valid_target_adj_cells is not empty\n        return []\n\n    tx, ty = target_agent_pos\n\n    # 5. Generate actions for movement (simple horizontal then vertical path)\n    # Simulate agent's position as we generate actions\n    current_sim_ax, current_sim_ay = ax, ay\n\n    while current_sim_ax != tx:\n        if current_sim_ax < tx:\n            actions.append(_ACTION_RIGHT)\n            current_sim_ax += 1\n        else:  # current_sim_ax > tx\n            actions.append(_ACTION_LEFT)\n            current_sim_ax -= 1\n\n    while current_sim_ay != ty:\n        if current_sim_ay < ty:\n            actions.append(_ACTION_DOWN)\n            current_sim_ay += 1\n        else:  # current_sim_ay > ty\n            actions.append(_ACTION_UP)\n            current_sim_ay -= 1\n\n    # 6. Add USE action\n    # The agent is now hypothetically next to the primitive, so USE should work based on next_to's 3x3 check.\n    actions.append(_ACTION_USE)\n\n    return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:06:57.611603", "function_name": "collect", "function_body": "  # Constants for actions based on CraftLab.action_specs()\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Get the initial CraftState from the CraftLab environment.\n  # `env` is an instance of `CraftLab`.\n  initial_state = env._current_state\n  \n  # Check if the primitive is already in the inventory. If so, no actions are needed.\n  if initial_state.inventory[primitive] > 0:\n    return []\n\n  # Initialize a deque for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple:\n  # (current_craft_state, list_of_actions_taken_to_reach_this_state).\n  # `collections.deque` is assumed to be imported at the file level.\n  q = collections.deque()\n  q.append((initial_state, []))\n\n  # Use a set to keep track of visited states to avoid cycles and redundant computations.\n  # A state is defined by the agent's (position, direction).\n  # For simple collection tasks, changes in inventory are usually only relevant at the goal,\n  # not for pathfinding to the item, unless items are keys for doors, etc.\n  visited = set()\n  visited.add((initial_state.pos, initial_state.dir))\n\n  # Movement actions as defined by CraftLab.action_specs()\n  movement_actions = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]\n\n  # Perform BFS\n  while q:\n    current_state, path_actions = q.popleft()\n\n    # Check if the agent is next to the target primitive.\n    # If it is, then the path to collect the primitive is found:\n    # move to this spot, then perform the USE action.\n    if current_state.next_to(primitive):\n      return path_actions + [ACTION_USE]\n    \n    # If not at the goal, explore all possible movement actions from the current state.\n    for action in movement_actions:\n      # Simulate the action to get the next state without modifying the actual environment.\n      # `CraftState.step` returns (reward, new_state). The reward is always 0.0 here, so we discard it.\n      _, new_state = current_state.step(action)\n      \n      # Form a hashable representation of the new state (position and direction).\n      new_pos_dir = (new_state.pos, new_state.dir)\n      \n      # If this new state has not been visited before, add it to the queue for exploration\n      # and mark it as visited.\n      if new_pos_dir not in visited:\n        visited.add(new_pos_dir)\n        q.append((new_state, path_actions + [action]))\n  \n  # If the queue becomes empty and the primitive was not found or collected,\n  # it means the primitive is unreachable from the initial state.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:06:57.681710", "function_name": "collect", "function_body": "    import collections\n\n    # Action constants as defined in action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    def _get_actions_to_turn(current_dir, target_dir):\n        \"\"\"Returns a list of actions (LEFT/RIGHT) to change current_dir to target_dir.\"\"\"\n        actions = []\n        if current_dir == target_dir:\n            return actions\n\n        # Calculate shortest turns (clockwise or counter-clockwise)\n        # Directions are 0=N, 1=E, 2=S, 3=W (clockwise)\n        diff = (target_dir - current_dir + 4) % 4\n        if diff == 1:  # 1 turn right (e.g., N(0) -> E(1))\n            actions.append(ACTION_RIGHT)\n        elif diff == 2:  # 2 turns (e.g., N(0) -> S(2)). Can be two rights or two lefts.\n            actions.append(ACTION_RIGHT)\n            actions.append(ACTION_RIGHT)\n        elif diff == 3:  # 1 turn left (e.g., N(0) -> W(3))\n            actions.append(ACTION_LEFT)\n        return actions\n\n    actions_taken = []\n    \n    # Get initial state information from the environment\n    obs = env.observations()\n    initial_inventory = obs['features_dict']['inventory']\n    \n    # 1. Check if the primitive is already in the inventory\n    if initial_inventory[primitive] > 0:\n        return []\n\n    # Get current grid, position, and direction from observations\n    grid = obs['features_dict']['features_global']\n    current_pos_float = obs['features_dict']['pos']\n    current_pos = (int(current_pos_float[0]), int(current_pos_float[1]))  # Convert normalized float pos to (row, col) int tuple\n    current_dir = np.argmax(obs['features_dict']['direction'])  # Convert one-hot direction to int (0=N, 1=E, 2=S, 3=W)\n    \n    # Get grid dimensions\n    HEIGHT, WIDTH, _ = grid.shape \n\n    # 2. Find all locations of the primitive on the grid\n    primitive_locations = []\n    for r in range(HEIGHT):\n        for c in range(WIDTH):\n            if grid[r, c, primitive] == 1.0:  # Assuming 1.0 indicates presence of the item\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        # Primitive not found on the map, so it cannot be collected\n        return []\n\n    # 3. Use Breadth-First Search (BFS) to find the shortest path to an *adjacent* cell\n    # to any of the primitive locations.\n    \n    # BFS state: (row, col, path_to_here)\n    queue = collections.deque([(current_pos, [])])\n    visited = {current_pos} # Keep track of visited (row, col) cells to avoid cycles and redundant paths\n    \n    # Define movement actions and their effects on (dr, dc) and resulting agent direction\n    # (dr, dc, resulting_direction_after_move)\n    move_action_map = {\n        ACTION_DOWN: (1, 0, 2),   # Move South, agent faces South (dir 2)\n        ACTION_UP: (-1, 0, 0),    # Move North, agent faces North (dir 0)\n        ACTION_LEFT: (0, -1, 3),  # Move West, agent faces West (dir 3)\n        ACTION_RIGHT: (0, 1, 1)   # Move East, agent faces East (dir 1)\n    }\n    \n    # Map relative position of target to the direction the agent needs to face to \"use\" it\n    # (dr, dc) from agent's position to primitive's position -> target_facing_direction_index\n    relative_pos_to_dir_idx = {\n        (-1, 0): 0,  # Primitive is North relative to agent, agent must face North\n        (0, 1): 1,   # Primitive is East relative to agent, agent must face East\n        (1, 0): 2,   # Primitive is South relative to agent, agent must face South\n        (0, -1): 3   # Primitive is West relative to agent, agent must face West\n    }\n\n    path_to_adjacent = None\n    final_agent_pos_after_path = None\n    target_primitive_loc = None # The specific primitive's location chosen for collection\n\n    while queue:\n        (r, c), path = queue.popleft()\n\n        # Check if the current cell (r,c) is adjacent to any primitive location\n        for pr, pc in primitive_locations:\n            if abs(r - pr) + abs(c - pc) == 1:  # Manhattan distance of 1 means adjacent\n                path_to_adjacent = path\n                final_agent_pos_after_path = (r, c)\n                target_primitive_loc = (pr, pc)\n                break\n        if path_to_adjacent:\n            break # Found the shortest path to an adjacent cell\n\n        # Explore valid neighbors\n        for action_val, (dr, dc, _) in move_action_map.items():\n            nr, nc = r + dr, c + dc\n            \n            # Check if neighbor is within grid boundaries\n            if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n                continue\n            \n            # Assuming all grid cells are traversable unless specified otherwise\n            # (e.g., no explicit \"wall\" type in grid data for pathfinding blockage)\n            \n            if (nr, nc) not in visited:\n                visited.add((nr, nc))\n                queue.append(((nr, nc), path + [action_val]))\n\n    if not path_to_adjacent:\n        # Could not find a path to any cell adjacent to the primitive\n        return []\n\n    actions_taken.extend(path_to_adjacent)\n    \n    # Determine the agent's final facing direction after executing the movement path.\n    # If a path was taken, the agent's direction updates to face the direction of the last move.\n    # If no path was needed (already adjacent), the direction remains the initial direction.\n    agent_final_dir = current_dir \n    if path_to_adjacent:\n        last_move_action = path_to_adjacent[-1]\n        _, _, agent_final_dir = move_action_map[last_move_action]\n\n    # 4. Add actions to turn the agent to face the target primitive\n    # Calculate the relative position of the primitive from the agent's final position\n    dr_target = target_primitive_loc[0] - final_agent_pos_after_path[0]\n    dc_target = target_primitive_loc[1] - final_agent_pos_after_path[1]\n    \n    target_face_dir = relative_pos_to_dir_idx.get((dr_target, dc_target), -1)\n\n    if target_face_dir == -1:\n        # This case should ideally not be reached if target_primitive_loc is truly adjacent\n        # to final_agent_pos_after_path\n        return []\n\n    turn_actions = _get_actions_to_turn(agent_final_dir, target_face_dir)\n    actions_taken.extend(turn_actions)\n\n    # 5. Add the USE action to collect the primitive\n    actions_taken.append(ACTION_USE)\n\n    return actions_taken", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:07:47.423341", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map movement vectors (dx, dy) to action IDs.\n  # These actions move the agent AND set its facing direction.\n  MOVE_VEC_TO_ACTION = {\n      (0, -1): UP,    # Move North, face North\n      (0, 1): DOWN,   # Move South, face South\n      (-1, 0): LEFT,  # Move West, face West\n      (1, 0): RIGHT   # Move East, face East\n  }\n\n  # Map agent's internal direction ID to its corresponding facing vector (dx, dy).\n  # 0: North (-Y), 1: East (+X), 2: South (+Y), 3: West (-X)\n  DIR_TO_VEC = {\n      0: (0, -1),\n      1: (1, 0),\n      2: (0, 1),\n      3: (-1, 0)\n  }\n\n  # --- Extract Initial State Information ---\n  initial_observation = env.observations()\n  # The grid configuration is static and doesn't change during pathfinding.\n  grid_layout = initial_observation['features_dict']['features_global']\n  \n  # Agent's starting position (x, y) coordinates.\n  initial_agent_x, initial_agent_y = initial_observation['features_dict']['pos'].astype(int)\n  \n  # Agent's starting direction (integer 0-3 converted from one-hot vector).\n  initial_agent_direction = np.argmax(initial_observation['features_dict']['direction'])\n\n  # --- World Properties Relevant for Pathfinding ---\n  grid_width, grid_height, _ = grid_layout.shape\n  # Entities that block movement (e.g., walls, water for a land-based agent).\n  blocking_entity_indices = env.world.non_grabbable_indices\n\n  # --- Helper Functions for BFS ---\n  def is_coordinate_in_bounds(x, y):\n      \"\"\"Checks if a given (x, y) coordinate is within the grid boundaries.\"\"\"\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  def is_cell_passable(x, y):\n      \"\"\"\n      Determines if the cell at (x, y) is traversable by the agent.\n      A cell is impassable if it's out of bounds or contains any blocking entity.\n      \"\"\"\n      if not is_coordinate_in_bounds(x, y):\n          return False\n      # Iterate through known blocking entity types.\n      # This is efficient given that the number of blocking types is typically small.\n      for entity_idx in blocking_entity_indices:\n          if grid_layout[x, y, entity_idx] > 0:\n              return False # This cell contains an obstacle\n      return True # Cell is clear for agent movement\n\n  # --- Breadth-First Search (BFS) Initialization ---\n  # A state in the BFS is represented as: ((x_coordinate, y_coordinate), direction_integer)\n  \n  # The queue holds states to be explored.\n  bfs_queue = collections.deque([((initial_agent_x, initial_agent_y), initial_agent_direction)])\n  \n  # The set of visited states prevents revisiting the same state and infinite loops.\n  # Stores ((x, y), direction) tuples.\n  visited_bfs_states = set([((initial_agent_x, initial_agent_y), initial_agent_direction)])\n  \n  # The parent_map is used to reconstruct the shortest path.\n  # Maps: (child_state) -> (parent_state, action_taken_from_parent_to_child)\n  parent_state_map = {}\n  \n  # This variable will store the BFS state from which the 'USE' action can be executed.\n  found_collect_ready_state = None\n\n  # --- BFS Traversal Loop ---\n  while bfs_queue:\n      current_pos_tuple, current_dir_int = bfs_queue.popleft()\n      current_bfs_state = (current_pos_tuple, current_dir_int)\n      current_x, current_y = current_pos_tuple\n\n      # Check if the target primitive is directly in front of the agent in the current state.\n      facing_vector_dx, facing_vector_dy = DIR_TO_VEC[current_dir_int]\n      front_cell_x, front_cell_y = current_x + facing_vector_dx, current_y + facing_vector_dy\n\n      if is_coordinate_in_bounds(front_cell_x, front_cell_y) and grid_layout[front_cell_x, front_cell_y, primitive] > 0:\n          # If the primitive is found in the cell directly ahead,\n          # this 'current_bfs_state' is our target state for pathfinding.\n          found_collect_ready_state = current_bfs_state\n          break # Shortest path found, exit BFS.\n\n      # Explore all possible movement actions from the current state.\n      for move_vec, movement_action_id in MOVE_VEC_TO_ACTION.items():\n          next_x, next_y = current_x + move_vec[0], current_y + move_vec[1]\n          # After a movement action, the agent's direction is set to the direction of movement.\n          next_agent_direction = movement_action_id \n          next_pos_tuple = (next_x, next_y)\n          next_bfs_state = (next_pos_tuple, next_agent_direction)\n\n          # If the next cell is passable and this state hasn't been visited yet:\n          if is_cell_passable(next_x, next_y) and next_bfs_state not in visited_bfs_states:\n              visited_bfs_states.add(next_bfs_state)\n              # Record how we reached this new state.\n              parent_state_map[next_bfs_state] = (current_bfs_state, movement_action_id)\n              bfs_queue.append(next_bfs_state)\n\n  # --- Path Reconstruction ---\n  actions_to_primitive = []\n  if found_collect_ready_state:\n      # The very last action required is always 'USE' to collect the primitive.\n      actions_to_primitive.append(USE) \n      \n      current_path_state = found_collect_ready_state\n      initial_bfs_state = ((initial_agent_x, initial_agent_y), initial_agent_direction)\n\n      # Backtrack from the found 'collect-ready' state to the initial state using the parent_state_map.\n      while current_path_state != initial_bfs_state:\n          # Retrieve the parent state and the action that led from the parent to the current state.\n          parent_of_current, action_from_parent = parent_state_map[current_path_state]\n          actions_to_primitive.append(action_from_parent)\n          current_path_state = parent_of_current\n      \n      # The path was constructed in reverse order (from goal back to start).\n      # Reverse the list to get the correct chronological sequence of actions.\n      return actions_to_primitive[::-1]\n\n  # If the BFS completed without finding a path to the primitive, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T01:07:48.395133", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map movement vectors (dx, dy) to action IDs.\n  # These actions move the agent AND set its facing direction.\n  MOVE_VEC_TO_ACTION = {\n      (0, -1): UP,    # Move North, face North\n      (0, 1): DOWN,   # Move South, face South\n      (-1, 0): LEFT,  # Move West, face West\n      (1, 0): RIGHT   # Move East, face East\n  }\n\n  # Map agent's internal direction ID to its corresponding facing vector (dx, dy).\n  # 0: North (-Y), 1: East (+X), 2: South (+Y), 3: West (-X)\n  DIR_TO_VEC = {\n      0: (0, -1),\n      1: (1, 0),\n      2: (0, 1),\n      3: (-1, 0)\n  }\n\n  initial_observation = env.observations()\n  # The grid is static for planning a path to a primitive; thus, 'initial_grid' is appropriate.\n  initial_grid = initial_observation['features_dict']['features_global']\n  initial_pos_x, initial_pos_y = initial_observation['features_dict']['pos'].astype(int)\n  initial_direction = np.argmax(initial_observation['features_dict']['direction'])\n\n  grid_width, grid_height, _ = initial_grid.shape\n  \n  # Improvement: First, check if the primitive can actually be picked up.\n  # CraftWorld defines 'non_grabbable_indices' as entities that cannot be picked up.\n  if primitive in env.world.non_grabbable_indices:\n      # If the primitive is non-grabbable, it's impossible to collect it.\n      return []\n\n  # 'non_grabbable_indices' also define cells that cannot be traversed by the agent.\n  # We'll use this set to determine traversable paths.\n  impassable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a coordinate is within grid bounds.\n  def is_valid_coordinate(x, y):\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  # Helper function to check if a cell is traversable.\n  # A cell is not traversable if it contains any entity from 'impassable_indices'.\n  def is_traversable(x, y):\n      if not is_valid_coordinate(x, y):\n          return False\n      for idx in impassable_indices:\n          if initial_grid[x, y, idx] > 0:\n              return False # This cell contains an impassable obstacle.\n      return True # The cell is clear for movement.\n\n  # BFS state: ((x, y), direction_int)\n  # The queue stores states to explore.\n  queue = collections.deque([((initial_pos_x, initial_pos_y), initial_direction)])\n  # The visited set prevents cycles and redundant exploration.\n  visited = set([((initial_pos_x, initial_pos_y), initial_direction)])\n  \n  # The parent_map stores the path: (current_state) -> (parent_state, action_to_reach_current)\n  parent_map = {}\n  \n  # This will store the BFS state from which the 'USE' action can be successfully applied.\n  found_target_bfs_state = None\n\n  while queue:\n      (current_x, current_y), current_dir = queue.popleft()\n      current_bfs_state_key = ((current_x, current_y), current_dir)\n\n      # Check if the target primitive is directly in front of the current position and facing direction.\n      facing_vector = DIR_TO_VEC[current_dir]\n      front_cell_x, front_cell_y = current_x + facing_vector[0], current_y + facing_vector[1]\n\n      if is_valid_coordinate(front_cell_x, front_cell_y) and initial_grid[front_cell_x, front_cell_y, primitive] > 0:\n          # If the primitive is found in the cell directly in front, this is our goal state.\n          found_target_bfs_state = current_bfs_state_key\n          break # Shortest path found due to BFS, exit search.\n\n      # Explore all four possible movement actions (UP, DOWN, LEFT, RIGHT).\n      # Each move action also sets the agent's facing direction.\n      for move_vector, move_action_id in MOVE_VEC_TO_ACTION.items():\n          next_x, next_y = current_x + move_vector[0], current_y + move_vector[1]\n          next_direction = move_action_id # The new direction is dictated by the move action itself.\n          next_bfs_state_key = ((next_x, next_y), next_direction)\n\n          # Only proceed if the next cell is traversable and the state hasn't been visited.\n          if is_traversable(next_x, next_y) and next_bfs_state_key not in visited:\n              visited.add(next_bfs_state_key)\n              # Store how we reached this new state for path reconstruction.\n              parent_map[next_bfs_state_key] = (current_bfs_state_key, move_action_id)\n              queue.append(next_bfs_state_key)\n\n  # If a path to a collectible primitive was found, reconstruct the action sequence.\n  if found_target_bfs_state:\n      # The last action will always be 'USE' to pick up the primitive.\n      action_sequence = [USE] \n      \n      current_backtrack_state = found_target_bfs_state\n      initial_bfs_state_key = ((initial_pos_x, initial_pos_y), initial_direction)\n\n      # Backtrack from the target state to the initial state using the parent map.\n      while current_backtrack_state != initial_bfs_state_key:\n          # Retrieve the parent state and the action that led to the current state.\n          parent_state, action_to_reach_current = parent_map[current_backtrack_state]\n          action_sequence.append(action_to_reach_current)\n          current_backtrack_state = parent_state\n      \n      # The path was built in reverse order, so reverse it to get the correct chronological sequence.\n      return action_sequence[::-1]\n\n  # If the BFS queue became empty and no path to the primitive was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T01:09:30.311935", "function_name": "collect", "function_body": "  # Constants for actions (assuming these are globally available from the module context)\n  # DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Directional movements (dx, dy) -> action_id, consistent with grid[x, y] and pos=(x, y)\n  ACTION_DELTAS_XY = {\n      (0, -1): UP,    # Move Y-1 (up)\n      (0, 1): DOWN,   # Move Y+1 (down)\n      (-1, 0): LEFT,  # Move X-1 (left)\n      (1, 0): RIGHT,  # Move X+1 (right)\n  }\n\n  # Max search depth for BFS to prevent very long paths or infinite loops\n  MAX_SEARCH_DEPTH = 50 \n\n  actions_to_take = []\n  \n  # Get the current CraftState from the CraftLab environment\n  current_state = env._current_state \n\n  # 1. Check if the primitive is already collected\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  grid = current_state.grid\n  # grid shape is (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = grid.shape \n\n  # 2. Find all locations of the primitive on the grid\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if grid[x, y, primitive] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # Primitive not found anywhere on the grid, cannot collect\n      return []\n\n  start_pos = current_state.pos # Agent's current position (x, y)\n\n  # 3. Define target cells for BFS: any cell from which the primitive is \"next_to\" (3x3 neighborhood)\n  target_adj_cells = set()\n  for px, py in primitive_locations:\n      # Iterate over 3x3 neighborhood around the primitive location\n      for dx_adj in [-1, 0, 1]:\n          for dy_adj in [-1, 0, 1]:\n              adj_x, adj_y = px + dx_adj, py + dy_adj\n              \n              # Check boundaries for the adjacent cell\n              if 0 <= adj_x < grid_width and 0 <= adj_y < grid_height:\n                  # Exclude the primitive's own cell if the agent cannot stand on it\n                  # (assuming agent can stand on empty cells or cells not explicitly blocked)\n                  # If the primitive itself is grabbable, standing on it makes it adjacent.\n                  # So, include all 3x3 cells within bounds.\n                  target_adj_cells.add((adj_x, adj_y))\n  \n  # Ensure the agent's current position is within the possible target cells if it's already adjacent\n  # This set will be the goal states for our BFS.\n\n  # 4. Perform BFS to find the shortest path to any target_adj_cell\n  queue = collections.deque([(start_pos, [])]) # (current_pos, current_path_actions)\n  visited = {start_pos}\n\n  final_path_actions = []\n\n  while queue:\n      (curr_x, curr_y), path = queue.popleft()\n\n      if len(path) > MAX_SEARCH_DEPTH:\n          continue # Prune paths that are too long to prevent infinite loops\n\n      # Check if the current position is one of the target adjacent cells\n      if (curr_x, curr_y) in target_adj_cells:\n          final_path_actions = path\n          break # Shortest path found!\n\n      # Explore neighbors\n      for (dx, dy), action in ACTION_DELTAS_XY.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # Check boundaries\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n          \n          # Check if already visited in this BFS path\n          if next_pos in visited:\n              continue\n\n          # In a more complex environment, you might check if next_pos is traversable (e.g., not an obstacle)\n          # For CraftWorld, the `env.step` method handles collisions. For pathfinding, we assume traversability\n          # unless explicitly blocked in a way the BFS can perceive (e.g., specific non-grabbable environment items).\n          # For v2, a basic BFS without complex obstacle avoidance is usually sufficient.\n\n          visited.add(next_pos)\n          queue.append((next_pos, path + [action]))\n            \n  if not final_path_actions and not current_state.next_to(primitive):\n      # No path found to any adjacent cell, and not currently adjacent\n      return []\n\n  # 5. Execute the found path\n  for action in final_path_actions:\n      actions_to_take.append(action)\n      # The environment internally updates its state\n      _, _, _ = env.step(action) \n\n  # Get the state after moving\n  current_state_after_move = env._current_state\n  \n  # 6. Perform USE action if adjacent and primitive not yet collected\n  if current_state_after_move.next_to(primitive) and current_state_after_move.inventory[primitive] == 0:\n      actions_to_take.append(USE)\n      _, _, _ = env.step(USE)\n      \n      # Update state after USE to check final inventory\n      current_state_after_use = env._current_state\n      if current_state_after_use.inventory[primitive] > 0:\n          return actions_to_take\n      else:\n          # Failed to collect even after USE action (e.g., primitive was removed, or not truly grabbable)\n          return [] # This indicates a failure to collect\n  else:\n      # Did not end up adjacent or primitive was already collected (handled at start).\n      # If the path led to a valid spot but next_to() is false, then the BFS logic or target cells are off,\n      # or the environment changed.\n      return [] # Indicate failure if primitive is not collected after all steps", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:09:31.356785", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:11:27.388314", "function_name": "collect", "function_body": "    import collections\n\n    state = env._current_state\n    i_primitive = primitive\n\n    # Helper function to check adjacency\n    def is_adjacent(pos1, pos2):\n        \"\"\"Checks if two positions are cardinally adjacent (Manhattan distance 1).\"\"\"\n        return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1]) == 1\n\n    # 1. Check if primitive is already in inventory\n    if state.inventory[i_primitive] > 0:\n        return []\n\n    # Get grid dimensions\n    WIDTH, HEIGHT = state.grid.shape[0], state.grid.shape[1]\n\n    # 1.5 Check if agent is already adjacent to any instance of the primitive\n    # If so, a single USE action is sufficient.\n    for x_p in range(WIDTH):\n        for y_p in range(HEIGHT):\n            # If a primitive instance is found at (x_p, y_p)\n            if state.grid[x_p, y_p, i_primitive] == 1:\n                # Check if the agent's current position is adjacent to this primitive\n                if is_adjacent(state.pos, (x_p, y_p)):\n                    return [4] # 4 is the USE action\n\n    # 2. Find all locations of the primitive on the grid\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if state.grid[x, y, i_primitive] == 1:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        # Primitive not found anywhere on the grid\n        return []\n\n    # Define action movements (dx, dy) based on the provided action_specs:\n    # DOWN (0): y increases\n    # UP (1): y decreases\n    # LEFT (2): x decreases\n    # RIGHT (3): x increases\n    ACTIONS_MAP = {\n        0: (0, 1),   # DOWN: (dx, dy)\n        1: (0, -1),  # UP: (dx, dy)\n        2: (-1, 0),  # LEFT: (dx, dy)\n        3: (1, 0)    # RIGHT: (dx, dy)\n    }\n\n    # 3. Pathfinding (BFS) to find the shortest sequence of actions\n    # to move the agent to a cell adjacent to any primitive location.\n    # Queue stores tuples: (current_position (x,y), list_of_actions_taken_to_reach_here)\n    q = collections.deque([(state.pos, [])])\n    visited = {state.pos}  # Set to keep track of visited positions to avoid cycles\n\n    path_to_adj = [] # This will store the final sequence of movement actions\n\n    while q:\n        curr_pos, curr_path = q.popleft()\n\n        # Check if the current position is adjacent to any of the primitive locations.\n        # This is our goal state for the movement phase.\n        for p_loc in primitive_locations:\n            if is_adjacent(curr_pos, p_loc):\n                path_to_adj = curr_path\n                break # Found a path to an adjacent cell, exit inner loop\n        if path_to_adj:\n            break # Found a path, exit BFS loop\n\n        # Explore possible next steps (neighbors)\n        for action, (dx, dy) in ACTIONS_MAP.items():\n            nx, ny = curr_pos[0] + dx, curr_pos[1] + dy\n            next_pos = (nx, ny)\n\n            # Check if the next position is within grid bounds and hasn't been visited\n            if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and next_pos not in visited:\n                visited.add(next_pos)\n                q.append((next_pos, curr_path + [action]))\n\n    # 4. If no path to an adjacent cell was found, the primitive might be unreachable.\n    if not path_to_adj:\n        return []\n\n    # 5. Append the USE action (action 4) to the path.\n    # This assumes the USE action works on any adjacent item, regardless of the agent's facing direction.\n    return path_to_adj + [4]", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:11:28.370230", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Get action mappings from env.action_specs() to ensure correct integer values\n  ACTION_MAP = env.action_specs()\n  DOWN = ACTION_MAP['DOWN']\n  UP = ACTION_MAP['UP']\n  LEFT = ACTION_MAP['LEFT']\n  RIGHT = ACTION_MAP['RIGHT']\n  USE = ACTION_MAP['USE']\n\n  # Direction mappings (0:N, 1:E, 2:S, 3:W) as per CraftState.dir\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Start with an empty list of actions to record the sequence\n  actions_list = []\n\n  # Get the integer index of the primitive from the cookbook\n  primitive_idx = env.world.cookbook.index(primitive)\n\n  # Reset the environment to get the initial state and observations\n  # env._current_state provides direct access to the CraftState object\n  obs = env.reset()\n  current_state = env._current_state\n\n  # If the primitive is already in inventory, no actions are needed\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Get grid dimensions and find all locations of the primitive\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] > 0)\n\n  # If the primitive is not on the grid, it cannot be collected\n  if len(primitive_locations) == 0:\n      return []\n\n  # Define all possible (agent_x, agent_y, agent_dir) states from which a primitive\n  # at (target_x, target_y) can be collected using the USE action.\n  # The USE action interacts with the cell *in front* of the agent.\n  # (tx, ty) = primitive's location\n  # (ax, ay) = agent's location\n  # (ad) = agent's direction\n  target_agent_states = set() # Stores (ax, ay, ad) tuples\n\n  for loc_x, loc_y in primitive_locations:\n      # If agent is at (loc_x, loc_y + 1) and faces North (0), it uses (loc_x, loc_y)\n      target_agent_states.add((loc_x, loc_y + 1, DIR_NORTH))\n      # If agent is at (loc_x - 1, loc_y) and faces East (1), it uses (loc_x, loc_y)\n      target_agent_states.add((loc_x - 1, loc_y, DIR_EAST))\n      # If agent is at (loc_x, loc_y - 1) and faces South (2), it uses (loc_x, loc_y)\n      target_agent_states.add((loc_x, loc_y - 1, DIR_SOUTH))\n      # If agent is at (loc_x + 1, loc_y) and faces West (3), it uses (loc_x, loc_y)\n      target_agent_states.add((loc_x + 1, loc_y, DIR_WEST))\n\n  # Filter out target states that are outside the grid boundaries\n  valid_target_agent_states = set()\n  for ax, ay, ad in target_agent_states:\n      if 0 <= ax < grid_width and 0 <= ay < grid_height:\n          valid_target_agent_states.add((ax, ay, ad))\n\n  # If no valid adjacent positions exist (e.g., primitive is at a corner with no space)\n  if not valid_target_agent_states:\n      return []\n\n  # Perform a Breadth-First Search (BFS) to find the shortest path\n  # to any of the valid target (position, direction) states.\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir\n\n  # Queue stores (current_x, current_y, current_dir, list_of_actions_to_reach_here)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n  # Visited set stores (x, y, dir) tuples to avoid cycles and redundant exploration\n  visited = set([(start_x, start_y, start_dir)])\n\n  # Define how each movement action changes position and direction\n  # (action_int, delta_x, delta_y, new_direction_after_action)\n  movement_definitions = [\n      (UP, 0, -1, DIR_NORTH),\n      (DOWN, 0, 1, DIR_SOUTH),\n      (LEFT, -1, 0, DIR_WEST),\n      (RIGHT, 1, 0, DIR_EAST),\n  ]\n\n  path_to_best_target_state = None\n\n  while queue:\n      curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n      # Check if the current state is one of our valid target states\n      if (curr_x, curr_y, curr_dir) in valid_target_agent_states:\n          path_to_best_target_state = path_actions\n          break # Found the shortest path\n\n      # Explore all possible next states from the current state\n      for action, dx, dy, next_dir in movement_definitions:\n          next_x, next_y = curr_x + dx, curr_y + dy\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Create the new state tuple (position and direction)\n          next_state = (next_x, next_y, next_dir)\n\n          # If this state has not been visited, add it to the queue\n          if next_state not in visited:\n              visited.add(next_state)\n              new_path_actions = path_actions + [action]\n              queue.append((next_x, next_y, next_dir, new_path_actions))\n\n  # If no path was found to any target state, return an empty list\n  if path_to_best_target_state is None:\n      return []\n\n  # Execute the found path in the environment\n  actions_list.extend(path_to_best_target_state)\n\n  for action in path_to_best_target_state:\n      _reward, _done, obs = env.step(action)\n      current_state = env._current_state\n      # If the episode ends prematurely, return the actions taken so far\n      if _done:\n          return actions_list\n      # Check if primitive was collected mid-path (unlikely for single-item collection)\n      if current_state.inventory[primitive_idx] > 0:\n          return actions_list\n\n  # After reaching the target (position, direction) state, use the primitive\n  actions_list.append(USE)\n  _reward, _done, obs = env.step(USE)\n  current_state = env._current_state\n\n  # Check if the primitive was collected after the first USE action\n  if current_state.inventory[primitive_idx] > 0:\n      return actions_list\n  else:\n      # Some items might require multiple USE actions (e.g., chopping a tree).\n      # Try using it a few more times if not collected immediately.\n      MAX_USE_ATTEMPTS = 5 # Arbitrary limit\n      for _ in range(MAX_USE_ATTEMPTS - 1): # Already attempted once\n          actions_list.append(USE)\n          _reward, _done, obs = env.step(USE)\n          current_state = env._current_state\n          if current_state.inventory[primitive_idx] > 0 or _done:\n              break # Stop if collected or episode ends\n\n      return actions_list # Return the full sequence of actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:13:00.550358", "function_name": "collect", "function_body": "  # Retrieve action mappings from the environment's action_specs\n  action_specs = env.action_specs()\n  DOWN = action_specs['DOWN']\n  UP = action_specs['UP']\n  LEFT = action_specs['LEFT']\n  RIGHT = action_specs['RIGHT']\n  USE = action_specs['USE']\n\n  MOVE_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n  # Reset the environment to a known initial state\n  # The seed is fixed for reproducibility within the function call's execution,\n  # ensuring consistent behavior for the same primitive and initial environment setup.\n  _ = env.reset(seed=0)\n  initial_craft_state = env._current_state # Get the internal CraftState object\n\n  # Check if the primitive is already collected in the initial state\n  if initial_craft_state.inventory[primitive] > 0:\n    return [] # Already have it, no actions needed\n\n  # Initialize the BFS queue with the initial state and an empty action path\n  # Each element in the queue is (CraftState object, list of actions to reach this state)\n  q = collections.deque([(initial_craft_state, [])])\n\n  # Initialize the set of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (agent_position, agent_direction, current_inventory_tuple).\n  # Inventory is a numpy array, so convert it to a tuple for hashing in the set.\n  visited = set()\n  visited.add((initial_craft_state.pos, initial_craft_state.dir, tuple(initial_craft_state.inventory.tolist())))\n\n  # Determine if the target primitive is grabbable (can be collected with USE action)\n  # This information is available from the CraftWorld instance, accessed via env.world.\n  is_primitive_grabbable = primitive in env.world.grabbable_indices\n\n  # BFS Loop: Explore states until the primitive is collected or all reachable states are exhausted\n  while q:\n    current_state, current_path = q.popleft()\n\n    # Priority: If we are next to the primitive and it's grabbable, try to USE it.\n    if is_primitive_grabbable and current_state.next_to(primitive):\n      # Simulate the USE action. CraftState.step returns a new state object.\n      # The reward is not relevant for pathfinding in this context.\n      _reward, next_state_after_use = current_state.step(USE)\n\n      # Check if the primitive was successfully collected after the USE action\n      if next_state_after_use.inventory[primitive] > 0:\n        return current_path + [USE] # Goal achieved! Return the complete action path.\n\n      # If USE action did not lead to collection (e.g., used on an obstacle, or a non-collectible item,\n      # or something else prevented the pickup), this branch is not productive for collection.\n      # We do not enqueue this specific outcome of the USE action, as it didn't advance the goal.\n\n    # Explore movement actions (DOWN, UP, LEFT, RIGHT)\n    for action in MOVE_ACTIONS:\n      # Simulate the movement action\n      # CraftState.step returns a new CraftState object representing the state after the action.\n      _reward, next_state = current_state.step(action)\n\n      # Check if the action actually resulted in a change of state (position, direction, or inventory).\n      # If the agent tried to move into an obstacle or wall, CraftState.step might return\n      # a state identical to the current_state. Such actions are unproductive.\n      if (next_state.pos == current_state.pos and\n          next_state.dir == current_state.dir and\n          np.array_equal(next_state.inventory, current_state.inventory)):\n        continue # Skip this action as it resulted in no effective change.\n\n      # Create a unique key for the next state to check against the visited set.\n      next_state_key = (next_state.pos, next_state.dir, tuple(next_state.inventory.tolist()))\n\n      # If this next state has not been visited yet, add it to the queue for exploration\n      if next_state_key not in visited:\n        visited.add(next_state_key) # Mark as visited to avoid redundant exploration\n        q.append((next_state, current_path + [action]))\n\n  # If the BFS queue becomes empty and the primitive was not found or collected,\n  # it means there is no reachable path to collect the primitive.\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:13:01.515583", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  actions_taken = []\n  \n  # Action constants as per problem description\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n  \n  # Direction constants (assuming 0=N, 1=E, 2=S, 3=W for CraftState.dir)\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Relative movement for (dx, dy) for UP, DOWN, LEFT, RIGHT actions\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Max steps for pathfinding in BFS to avoid infinite loops\n  MAX_BFS_STEPS = 500 \n  # Max actions to perform in the environment (overall budget for collect_v2)\n  MAX_TOTAL_ACTIONS = 1000 \n\n  # Reset the environment to get the initial state\n  # This ensures the internal _current_state of CraftLab is fresh for planning\n  _ = env.reset() \n  \n  # Get the initial CraftState object for dimensions and obstacle checks\n  current_state = env._current_state\n  \n  WIDTH, HEIGHT, N_KINDS = current_state.grid.shape\n\n  # Check if primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n      return [] # Already collected, no actions needed\n\n  # The main loop for planning and executing actions\n  # We loop until the primitive is collected or we run out of total action budget\n  for _ in range(MAX_TOTAL_ACTIONS): \n      current_state = env._current_state # Get the most recent state\n\n      # Check if primitive is now in inventory (target achieved)\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n      # --- Phase 1: Pathfinding to get adjacent to the primitive and then USE it ---\n      # BFS to find the shortest path of (pos, dir) states\n      q = collections.deque()\n      \n      # BFS state: (current_pos_x, current_pos_y, current_dir, list_of_actions_to_reach_here)\n      q.append((current_state.pos[0], current_state.pos[1], current_state.dir, []))\n      \n      # Visited states: set of (pos_x, pos_y, dir) to prevent cycles and re-exploring worse paths\n      visited = set()\n      visited.add((current_state.pos[0], current_state.pos[1], current_state.dir))\n\n      path_to_primitive_and_use = None\n\n      bfs_steps = 0\n      while q and bfs_steps < MAX_BFS_STEPS:\n          bfs_steps += 1\n          px, py, pdir, current_path = q.popleft()\n\n          # Check if current position (px, py) is adjacent to the primitive\n          # This mimics CraftState.next_to logic, but also finds the specific cell.\n          is_adjacent_and_faceable = False\n          target_dx, target_dy = 0, 0 # Relative coordinates of the primitive from (px, py)\n          \n          # Iterate through cardinal neighbors (where agent can USE)\n          for dx_rel, dy_rel in [(0, -1), (1, 0), (0, 1), (-1, 0)]: # N, E, S, W relative\n              neighbor_x, neighbor_y = px + dx_rel, py + dy_rel\n              \n              # Check grid boundaries\n              if not (0 <= neighbor_x < WIDTH and 0 <= neighbor_y < HEIGHT):\n                  continue\n              \n              # Check if this neighbor cell contains the primitive\n              if current_state.grid[neighbor_x, neighbor_y, primitive] > 0:\n                  is_adjacent_and_faceable = True\n                  target_dx, target_dy = dx_rel, dy_rel\n                  break \n          \n          if is_adjacent_and_faceable:\n              # We are adjacent to a primitive in a cardinal direction. Now determine actions to face it and USE.\n              required_dir = -1\n              if target_dx == 0 and target_dy == -1: required_dir = DIR_NORTH \n              elif target_dx == 1 and target_dy == 0: required_dir = DIR_EAST  \n              elif target_dx == 0 and target_dy == 1: required_dir = DIR_SOUTH \n              elif target_dx == -1 and target_dy == 0: required_dir = DIR_WEST \n              \n              # This block should always be entered if is_adjacent_and_faceable is True\n              if required_dir != -1: \n                  temp_path = list(current_path) # Copy the path to this adjacent cell\n                  \n                  # Add actions to turn to the required direction\n                  turn_diff = (required_dir - pdir + 4) % 4 # Shortest turns (0,1,2,3)\n                  \n                  if turn_diff == 1: # 90 deg clockwise\n                      temp_path.append(ACTION_RIGHT)\n                  elif turn_diff == 2: # 180 deg\n                      temp_path.append(ACTION_RIGHT) \n                      temp_path.append(ACTION_RIGHT) \n                  elif turn_diff == 3: # 90 deg counter-clockwise\n                      temp_path.append(ACTION_LEFT)\n                  \n                  temp_path.append(ACTION_USE) # Finally, USE\n                  path_to_primitive_and_use = temp_path\n                  break # Path found, exit BFS loop\n\n          # --- Explore movement and turn actions for BFS ---\n          # Try all 4 movement directions (UP, DOWN, LEFT, RIGHT)\n          for action_val, (dx, dy) in MOVE_DELTAS.items():\n              new_px, new_py = px + dx, py + dy\n              \n              # Check grid boundaries\n              if not (0 <= new_px < WIDTH and 0 <= new_py < HEIGHT):\n                  continue\n\n              # Check if the new cell is an obstacle (non-grabbable like water, stone)\n              # env.non_grabbable_indices contains indices of blocking entities\n              is_obstacle = False\n              for kind_idx in env.non_grabbable_indices:\n                  if current_state.grid[new_px, new_py, kind_idx] > 0:\n                      is_obstacle = True\n                      break\n              if is_obstacle:\n                  continue\n\n              new_dir = pdir # Movement actions don't change direction\n              new_state_tuple = (new_px, new_py, new_dir)\n\n              if new_state_tuple not in visited:\n                  visited.add(new_state_tuple)\n                  new_path = list(current_path) \n                  new_path.append(action_val)\n                  q.append((new_px, new_py, new_dir, new_path))\n          \n          # Explore turn actions (LEFT, RIGHT)\n          # Agent's direction changes, position stays the same.\n          \n          # Turn LEFT\n          new_dir_left = (pdir - 1 + 4) % 4\n          new_state_tuple_left = (px, py, new_dir_left)\n          if new_state_tuple_left not in visited:\n              visited.add(new_state_tuple_left)\n              new_path = list(current_path)\n              new_path.append(ACTION_LEFT)\n              q.append((px, py, new_dir_left, new_path))\n\n          # Turn RIGHT\n          new_dir_right = (pdir + 1) % 4\n          new_state_tuple_right = (px, py, new_dir_right)\n          if new_state_tuple_right not in visited:\n              visited.add(new_state_tuple_right)\n              new_path = list(current_path)\n              new_path.append(ACTION_RIGHT)\n              q.append((px, py, new_dir_right, new_path))\n\n      # --- End of BFS phase ---\n\n      if path_to_primitive_and_use:\n          # Execute the found path in the actual environment\n          for action in path_to_primitive_and_use:\n              _, done, _ = env.step(action) # reward, done, observations\n              actions_taken.append(action)\n              \n              # Check if the goal is achieved after each action, especially after USE\n              if env._current_state.inventory[primitive] > 0:\n                  return actions_taken \n              \n              if done: # If environment terminates prematurely (e.g., max_steps reached)\n                  return actions_taken \n      else:\n          # No path found to primitive from the current state. \n          # This means it's unreachable or doesn't exist.\n          break # Exit the main loop, as we can't find a path\n\n  return actions_taken # Return actions if goal not achieved after max_total_actions or no path found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:14:41.981436", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    if not hasattr(env, '_current_state') or env._current_state is None:\n        # The environment must be initialized, e.g., by calling env.reset()\n        # before collect_v2 is called.\n        return []\n\n    initial_state = env._current_state\n    \n    # If the primitive is already in inventory, no actions are needed.\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    grid = initial_state.grid\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n\n    # Define action mappings and related constants\n    ACTION_DELTAS = {\n        0: (1, 0),  # DOWN: (dr, dc) for row+1, col+0\n        1: (-1, 0), # UP: (dr, dc) for row-1, col+0\n        2: (0, -1), # LEFT: (dr, dc) for row+0, col-1\n        3: (0, 1)   # RIGHT: (dr, dc) for row+0, col+1\n    }\n    ACTION_TO_DIR = { # The direction the agent faces *after* taking a move action\n        0: 2, # DOWN action results in facing South (dir 2)\n        1: 0, # UP action results in facing North (dir 0)\n        2: 3, # LEFT action results in facing West (dir 3)\n        3: 1  # RIGHT action results in facing East (dir 1)\n    }\n    DIR_OFFSETS = { # Offset from agent's position to the cell *in front* based on agent's direction\n        0: (-1, 0), # North (dir 0) -> cell above\n        1: (0, 1),  # East (dir 1) -> cell to the right\n        2: (1, 0),  # South (dir 2) -> cell below\n        3: (0, -1)  # West (dir 3) -> cell to the left\n    }\n    USE_ACTION = 4\n    MOVE_ACTIONS = [0, 1, 2, 3]\n\n    start_pos = initial_state.pos\n    start_dir = initial_state.dir # Get current agent direction from the state\n\n    # Check if the primitive is grabbable. 'collect' via 'USE' typically applies to grabbable items.\n    is_grabbable = primitive in initial_state.world.grabbable_indices\n\n    if not is_grabbable:\n        # If the primitive is not grabbable, the 'USE' action will not \"collect\" it.\n        # This function aims to collect, so if it's not grabbable by USE, return empty.\n        return []\n\n    # Find all grid locations where the primitive exists\n    primitive_locations = []\n    for r in range(WIDTH):\n        for c in range(HEIGHT):\n            if grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        # Primitive does not exist anywhere on the map\n        return []\n\n    # Determine all possible (agent_r, agent_c, agent_dir) states from which the agent can USE the primitive\n    goal_states = set() # Stores (r, c, d) tuples representing agent's state before USE\n    for prim_r, prim_c in primitive_locations:\n        for agent_dir, (dr_front, dc_front) in DIR_OFFSETS.items():\n            # Calculate agent's potential position if the primitive is directly in front\n            agent_r, agent_c = prim_r - dr_front, prim_c - dc_front\n            \n            # Check if this calculated agent position is within grid boundaries\n            if 0 <= agent_r < WIDTH and 0 <= agent_c < HEIGHT:\n                goal_states.add((agent_r, agent_c, agent_dir))\n\n    # BFS for shortest path to any goal_state\n    # Queue stores tuples: ((current_row, current_col, current_direction), [list_of_actions_to_reach_this_state])\n    queue = collections.deque([((start_pos[0], start_pos[1], start_dir), [])])\n    # Visited set stores (row, col, direction) tuples to avoid cycles and redundant paths\n    visited = set([(start_pos[0], start_pos[1], start_dir)])\n\n    while queue:\n        (curr_r, curr_c, curr_d), path_actions = queue.popleft()\n\n        # Check if the current state is one of our pre-calculated goal states\n        if (curr_r, curr_c, curr_d) in goal_states:\n            return path_actions + [USE_ACTION] # Append USE action and return the plan\n\n        # Explore possible movement actions from the current state\n        for action in MOVE_ACTIONS:\n            dr_move, dc_move = ACTION_DELTAS[action]\n            next_r, next_c = curr_r + dr_move, curr_c + dc_move\n            next_d = ACTION_TO_DIR[action] # The new direction after this movement action\n\n            # Check if the next position is within grid boundaries.\n            # For collect_v2, we assume all cells within bounds are traversable.\n            # More advanced versions might check for obstacles (e.g., walls, water).\n            if 0 <= next_r < WIDTH and 0 <= next_c < HEIGHT:\n                # If this (position, direction) state has not been visited yet\n                if (next_r, next_c, next_d) not in visited:\n                    visited.add((next_r, next_c, next_d))\n                    queue.append(((next_r, next_c, next_d), path_actions + [action]))\n    \n    # If the BFS completes and no path to collect the primitive is found\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:14:42.980378", "function_name": "collect", "function_body": "  import collections\n  \n  # Constants for actions\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVES = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  def is_within_bounds(pos, grid_width, grid_height):\n      \"\"\"Checks if a given (x, y) position is within the grid boundaries.\"\"\"\n      x, y = pos\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  def is_next_to_primitive(grid, agent_pos, primitive_idx, grid_width, grid_height):\n      \"\"\"\n      Checks if the primitive is in the 3x3 neighborhood (including current cell)\n      around the agent's position.\n      \"\"\"\n      ax, ay = agent_pos\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = ax + dx, ay + dy\n              if is_within_bounds((nx, ny), grid_width, grid_height):\n                  # Check if the primitive kind exists at this neighboring cell\n                  if grid[nx, ny, primitive_idx] == 1:\n                      return True\n      return False\n\n  def is_traversable(grid, pos, non_grabbable_indices, grid_width, grid_height):\n      \"\"\"\n      Checks if a grid cell at 'pos' is traversable by the agent.\n      A cell is non-traversable if it contains any entity from 'non_grabbable_indices'.\n      \"\"\"\n      x, y = pos\n      if not is_within_bounds(pos, grid_width, grid_height):\n          return False\n      \n      # Check if any non-grabbable item blocks movement at this cell\n      for idx in non_grabbable_indices:\n          if grid[x, y, idx] == 1:\n              return False\n      return True\n\n  # 1. Get initial observations to understand the current state\n  obs = env.observations()\n  initial_grid = obs['features_dict']['features_global']\n  # Convert float position to integer tuple for grid indexing and BFS\n  initial_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  initial_inventory = obs['features_dict']['inventory']\n\n  # Get grid dimensions (width, height, number of kinds)\n  grid_width, grid_height, _ = initial_grid.shape\n\n  # Access non-grabbable entities from the CraftWorld instance via CraftLab\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # 2. Check if the primitive is already collected\n  if initial_inventory[primitive] > 0:\n      return [] # Primitive is already in inventory, no actions needed\n\n  # 3. BFS for pathfinding to a \"usable\" position (adjacent or on top of primitive)\n  q = collections.deque([(initial_pos, [])]) # Queue stores (current_pos, path_taken_to_current_pos)\n  visited = {initial_pos} # Set of visited positions to avoid cycles\n\n  target_path = None # This will store the sequence of actions to reach a usable position\n\n  while q:\n      current_pos, path = q.popleft()\n\n      # If the agent is currently at a position from which it can \"use\" to collect the primitive,\n      # this path is a candidate. We choose the first one found by BFS (which is shortest).\n      if is_next_to_primitive(initial_grid, current_pos, primitive, grid_width, grid_height):\n          target_path = path\n          break # Found the shortest path to a valid collection spot\n\n      # Explore neighbors by trying all movement actions\n      for action, (dx, dy) in MOVES.items():\n          next_pos = (current_pos[0] + dx, current_pos[1] + dy)\n\n          # Check if the next position is within bounds, has not been visited, and is traversable\n          if next_pos not in visited and \\\n             is_traversable(initial_grid, next_pos, non_grabbable_indices, grid_width, grid_height):\n              visited.add(next_pos)\n              q.append((next_pos, path + [action]))\n\n  # 4. If no path was found, return an empty list indicating unreachability\n  if target_path is None:\n      return []\n\n  # 5. Construct the final sequence of actions\n  # The `target_path` leads to a position where `USE` can be performed.\n  actions_to_execute = list(target_path)\n  actions_to_execute.append(USE) # Append the USE action to pick up the primitive\n\n  return actions_to_execute", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:16:00.137067", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Get current state from the environment\n    state = env._current_state\n    \n    # 1. Check if primitive is already collected\n    if state.inventory[primitive] > 0:\n        return []\n\n    # 2. Find the primitive's location on the grid\n    target_pos = None\n    WIDTH, HEIGHT, N_KINDS = state.grid.shape\n    \n    # Iterate through the grid to find the primitive's coordinates\n    # Assuming the primitive is represented by its index being 1 at its location\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if state.grid[x, y, primitive] == 1:\n                target_pos = (x, y)\n                break\n        if target_pos:\n            break\n            \n    if target_pos is None:\n        # Primitive not found on the grid, cannot collect it\n        return []\n\n    # 3. Prepare for BFS Pathfinding to an adjacent cell of the primitive\n    q = collections.deque([(state.pos, [])]) # (current_position, actions_so_far)\n    visited = {state.pos} # Set of (x, y) tuples that have been visited\n\n    # Mapping of movement actions to their (dx, dy) deltas\n    # These deltas correspond to the effect of the actions in CraftState.step\n    move_deltas = {\n        env_factory.ACTIONS.UP: (0, -1),\n        env_factory.ACTIONS.DOWN: (0, 1),\n        env_factory.ACTIONS.LEFT: (-1, 0),\n        env_factory.ACTIONS.RIGHT: (1, 0)\n    }\n\n    # Pre-compute a boolean mask for kinds that block movement\n    # A cell is considered blocked if it contains any non-grabbable item\n    # that is NOT a workshop. Workshops are assumed to be traversable.\n    block_kind_mask = np.zeros(N_KINDS, dtype=bool)\n    for k_idx in state.world.non_grabbable_indices:\n        if k_idx not in state.world.workshop_indices:\n            block_kind_mask[k_idx] = True\n\n    # Helper function to check if a cell is blocked\n    def is_cell_blocked(x, y):\n        # Check if the cell contains any kind marked as blocking\n        return np.any(state.grid[x, y, block_kind_mask])\n\n\n    # 4. Perform BFS\n    while q:\n        current_pos, current_actions = q.popleft()\n        cx, cy = current_pos\n\n        # Check if the current position is adjacent to the target primitive\n        # To collect, the agent must be in a cell directly adjacent (Manhattan distance 1)\n        # to the primitive's cell.\n        is_adjacent = False\n        for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]: # Check 4-directional adjacency\n            if (cx + dx, cy + dy) == target_pos:\n                is_adjacent = True\n                break\n\n        if is_adjacent:\n            # Found a path to an adjacent cell, now add the USE action\n            return current_actions + [env_factory.ACTIONS.USE]\n\n        # Explore neighbors by applying movement actions\n        for action, delta in move_deltas.items():\n            nx, ny = cx + delta[0], cy + delta[1]\n            new_pos = (nx, ny)\n\n            # Check boundary conditions\n            if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n                continue # Skip out-of-bounds cells\n\n            # Check if the new position is blocked by an obstacle\n            if is_cell_blocked(nx, ny):\n                continue # Skip blocked cells\n\n            # If the new position hasn't been visited, add it to the queue\n            if new_pos not in visited:\n                visited.add(new_pos)\n                q.append((new_pos, current_actions + [action]))\n\n    # If the queue becomes empty and no path to an adjacent cell was found,\n    # the primitive is unreachable in this scenario.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:16:01.103639", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:17:51.036328", "function_name": "collect", "function_body": "  # Constants for actions (from CraftLab.action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Directions (CraftState.dir)\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Relative delta for each direction (dx, dy)\n  # Agent at (px, py), looking in DIR, faces (px + dx, py + dy)\n  DIR_DELTAS = {\n      DIR_NORTH: (0, 1),\n      DIR_EAST: (1, 0),\n      DIR_SOUTH: (0, -1),\n      DIR_WEST: (-1, 0),\n  }\n\n  # Mapping from current direction to turning left/right\n  TURN_LEFT_MAP = {DIR_NORTH: DIR_WEST, DIR_EAST: DIR_NORTH, DIR_SOUTH: DIR_EAST, DIR_WEST: DIR_SOUTH}\n  TURN_RIGHT_MAP = {DIR_NORTH: DIR_EAST, DIR_EAST: DIR_SOUTH, DIR_SOUTH: DIR_WEST, DIR_WEST: DIR_NORTH}\n\n  MAX_COLLECT_STEPS = 200 # A reasonable upper bound for collection attempts\n\n  actions_taken = []\n\n  for _ in range(MAX_COLLECT_STEPS):\n      obs = env.observations()\n      current_inventory = obs['features_dict']['inventory']\n\n      # 1. Check if primitive is already collected\n      if current_inventory[primitive] > 0:\n          return actions_taken\n\n      # Access current state for precise navigation\n      # This relies on CraftLab exposing _current_state as a data attribute\n      current_state = env._current_state\n      current_pos_x, current_pos_y = current_state.pos\n      current_dir = current_state.dir # Agent's current facing direction\n      grid = current_state.grid\n      grid_width, grid_height, _ = grid.shape\n\n      # 2. Check if primitive is directly in front and can be USED\n      # Calculate cell in front of the agent\n      fdx, fdy = DIR_DELTAS[current_dir]\n      front_x, front_y = current_pos_x + fdx, current_pos_y + fdy\n\n      if 0 <= front_x < grid_width and 0 <= front_y < grid_height and grid[front_x, front_y, primitive] > 0:\n          # Primitive is in front, USE it\n          actions_taken.append(ACTION_USE)\n          _, done, _ = env.step(ACTION_USE)\n          if done:\n              return actions_taken\n          continue # Re-evaluate state after action (new inventory, new grid potentially)\n\n      # 3. Check if primitive is in any of the 4 cardinal neighboring cells (not including current cell)\n      # and plan turns and USE.\n      found_adjacent_primitive = False\n      target_dir_to_face = -1 # The direction the agent needs to face to use the item\n\n      # Check North, East, South, West neighbors relative to agent's position\n      # This maps (dx,dy) relative to agent to the direction needed to face that cell\n      cardinal_neighbor_relative_deltas = {\n          (0, 1): DIR_NORTH,  # North neighbor (px, py+1)\n          (1, 0): DIR_EAST,   # East neighbor (px+1, py)\n          (0, -1): DIR_SOUTH, # South neighbor (px, py-1)\n          (-1, 0): DIR_WEST,  # West neighbor (px-1, py)\n      }\n\n      for (dx, dy), dir_needed in cardinal_neighbor_relative_deltas.items():\n          nx, ny = current_pos_x + dx, current_pos_y + dy\n          if 0 <= nx < grid_width and 0 <= ny < grid_height and grid[nx, ny, primitive] > 0:\n              found_adjacent_primitive = True\n              target_dir_to_face = dir_needed\n              break\n\n      if found_adjacent_primitive:\n          # Turn agent to face the target_dir_to_face\n          while current_dir != target_dir_to_face:\n              # Determine shortest turn (left or right)\n              # Calculate distance clockwise\n              dist_right = (target_dir_to_face - current_dir + 4) % 4\n              # Calculate distance counter-clockwise\n              dist_left = (current_dir - target_dir_to_face + 4) % 4\n\n              if dist_right <= dist_left: # Prefer right turn or equal turns\n                  action_to_take = ACTION_RIGHT\n                  current_dir = TURN_RIGHT_MAP[current_dir]\n              else: # Prefer left turn\n                  action_to_take = ACTION_LEFT\n                  current_dir = TURN_LEFT_MAP[current_dir]\n\n              actions_taken.append(action_to_take)\n              _, done, _ = env.step(action_to_take)\n              if done:\n                  return actions_taken\n          \n          # Now agent is facing the primitive, USE it\n          actions_taken.append(ACTION_USE)\n          _, done, _ = env.step(ACTION_USE)\n          if done:\n              return actions_taken\n          continue # Re-evaluate state after action\n\n      # 4. If primitive not directly interactable, explore via random movement\n      # Use env.world.random for reproducibility if the seed is set\n      # The possible actions are 0-4, but only 0-3 are movement.\n      possible_move_actions = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]\n      \n      # CraftLab has self.world, and self.world has self.random (numpy.random.RandomState)\n      action_to_take = env.world.random.choice(possible_move_actions)\n      \n      actions_taken.append(action_to_take)\n      _, done, _ = env.step(action_to_take)\n      if done:\n          return actions_taken\n\n  # If loop finishes, primitive was not collected within MAX_COLLECT_STEPS\n  return actions_taken", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:17:52.148629", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Helper mapping for directions to (delta_row, delta_col)\n  _DIRECTIONS_MAP = {\n      0: (-1, 0),  # UP (decrease row)\n      1: (0, 1),   # RIGHT (increase col)\n      2: (1, 0),   # DOWN (increase row)\n      3: (0, -1)   # LEFT (decrease col)\n  }\n\n  # Helper mapping for direction index to movement action\n  _MOVEMENT_ACTION_MAP = {\n      0: env_factory.UP,\n      1: env_factory.RIGHT,\n      2: env_factory.DOWN,\n      3: env_factory.LEFT\n  }\n\n  def _get_turn_actions(current_dir, target_dir):\n      \"\"\"Calculates minimal turn actions to change from current_dir to target_dir.\"\"\"\n      actions = []\n      # Calculate difference in directions (modulo 4 for circularity)\n      # Positive delta means clockwise turns, negative means counter-clockwise\n      delta = (target_dir - current_dir + 4) % 4\n      if delta == 1:  # 90 degrees clockwise\n          actions.append(env_factory.RIGHT)\n      elif delta == 2:  # 180 degrees\n          actions.append(env_factory.RIGHT)\n          actions.append(env_factory.RIGHT)\n      elif delta == 3:  # 90 degrees counter-clockwise\n          actions.append(env_factory.LEFT)\n      return actions\n\n  # Get current state from the environment\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  rows, cols, _ = grid.shape\n\n  # If already collected the primitive, no actions needed for collection\n  # Assuming the goal is to obtain at least one instance.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # 1. Find all locations of the primitive on the grid\n  primitive_locations = []\n  for r in range(rows):\n      for c in range(cols):\n          # A cell contains a primitive if its value at the primitive index is 1\n          if grid[r, c, primitive] == 1:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      return [] # Primitive not found on the map\n\n  # 2. Find the closest primitive location (Manhattan distance)\n  closest_primitive_pos = None\n  min_dist = float('inf')\n  for pr, pc in primitive_locations:\n      dist = abs(pr - start_pos[0]) + abs(pc - start_pos[1])\n      if dist < min_dist:\n          min_dist = dist\n          closest_primitive_pos = (pr, pc)\n\n  tr, tc = closest_primitive_pos\n\n  # 3. Identify valid interaction cells (adjacent to the primitive, and empty)\n  # Each candidate is a tuple: ((row, col), direction_agent_must_face_target_from_this_cell)\n  interaction_candidates = [\n      ((tr - 1, tc), 2),  # Cell above target, agent faces DOWN\n      ((tr + 1, tc), 0),  # Cell below target, agent faces UP\n      ((tr, tc - 1), 1),  # Cell left of target, agent faces RIGHT\n      ((tr, tc + 1), 3)   # Cell right of target, agent faces LEFT\n  ]\n\n  target_interaction_cells_and_dirs = []\n  for (ir, ic), face_dir in interaction_candidates:\n      if 0 <= ir < rows and 0 <= ic < cols:\n          # Check if the interaction cell is empty (no other items)\n          # Assuming agent can only move into empty cells for pathfinding\n          if np.sum(grid[ir, ic, :]) == 0:\n              target_interaction_cells_and_dirs.append(((ir, ic), face_dir))\n\n  if not target_interaction_cells_and_dirs:\n      return [] # Primitive is unreachable (surrounded by non-empty cells or map boundaries)\n\n  # 4. BFS to find the shortest path to any target_interaction_cells_and_dirs\n  # Queue stores tuples: ((current_row, current_col), current_direction_index), list_of_actions_taken\n  queue = collections.deque([((start_pos, start_dir), [])])\n  # Visited set stores ((row, col), direction_index) to avoid cycles and redundant paths\n  visited = set([(start_pos, start_dir)])\n\n  while queue:\n      ((curr_r, curr_c), curr_d), path_actions = queue.popleft()\n\n      # Check if current state is one of the target interaction states\n      for (tir, tic), face_dir in target_interaction_cells_and_dirs:\n          if (curr_r, curr_c) == (tir, tic):\n              # Found a path to an interaction cell. Now turn and USE.\n              final_actions = list(path_actions) # Make a copy\n              final_actions.extend(_get_turn_actions(curr_d, face_dir))\n              final_actions.append(env_factory.USE)\n              return final_actions\n\n      # Explore possible next states (move and turn actions)\n\n      # Try moving forward in current direction\n      next_r, next_c = curr_r + _DIRECTIONS_MAP[curr_d][0], curr_c + _DIRECTIONS_MAP[curr_d][1]\n      if 0 <= next_r < rows and 0 <= next_c < cols:\n          # Check if the next cell is empty to move into\n          if np.sum(grid[next_r, next_c, :]) == 0:\n              if ((next_r, next_c), curr_d) not in visited:\n                  visited.add(((next_r, next_c), curr_d))\n                  queue.append((((next_r, next_c), curr_d), path_actions + [_MOVEMENT_ACTION_MAP[curr_d]]))\n\n      # Try turning RIGHT\n      next_d_right = (curr_d + 1) % 4\n      if ((curr_r, curr_c), next_d_right) not in visited:\n          visited.add(((curr_r, curr_c), next_d_right))\n          queue.append((((curr_r, curr_c), next_d_right), path_actions + [env_factory.RIGHT]))\n\n      # Try turning LEFT\n      next_d_left = (curr_d - 1 + 4) % 4\n      if ((curr_r, curr_c), next_d_left) not in visited:\n          visited.add(((curr_r, curr_c), next_d_left))\n          queue.append((((curr_r, curr_c), next_d_left), path_actions + [env_factory.LEFT]))\n\n  return [] # No path found to any valid interaction cell", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:19:11.706751", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # 1. Get action mappings from the environment's action specifications.\n    # This ensures compatibility with how the environment defines its actions.\n    action_specs = env.action_specs()\n    # Assuming action_specs provides a mapping from action names to integer IDs.\n    ACTION_DOWN = action_specs[\"DOWN\"]\n    ACTION_UP = action_specs[\"UP\"]\n    ACTION_LEFT = action_specs[\"LEFT\"]\n    ACTION_RIGHT = action_specs[\"RIGHT\"]\n    ACTION_USE = action_specs[\"USE\"]\n\n    # Access the current CraftState object for grid, position, and inventory information.\n    # This is necessary for planning as `observations()` might provide processed/normalized data.\n    current_state = env._current_state\n\n    # 2. Check if the primitive is already in the agent's inventory.\n    # If so, no actions are needed.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # 3. Get grid dimensions from the current state's grid.\n    WIDTH, HEIGHT, _ = current_state.grid.shape # N_KINDS is not directly used in pathfinding\n\n    # Helper function to check if a position is within grid boundaries.\n    def is_valid_pos(x, y):\n        return 0 <= x < WIDTH and 0 <= y < HEIGHT\n\n    # Helper function to get valid neighboring positions and the actions to reach them.\n    def get_neighbors_for_bfs(x, y):\n        neighbors = []\n        # Define possible moves and their corresponding actions.\n        # (dx, dy, action_to_move_there)\n        moves = [\n            (0, 1, ACTION_DOWN),  # Move South (down on grid)\n            (0, -1, ACTION_UP),   # Move North (up on grid)\n            (-1, 0, ACTION_LEFT), # Move West\n            (1, 0, ACTION_RIGHT), # Move East\n        ]\n        for dx, dy, action in moves:\n            nx, ny = x + dx, y + dy\n            if is_valid_pos(nx, ny):\n                # For pathfinding to collect, we assume agent can move into any valid empty cell.\n                # We specifically aim for a cell *adjacent* to the primitive, not on it.\n                neighbors.append(((nx, ny), action))\n        return neighbors\n\n    # 4. Locate all instances of the target primitive on the grid.\n    primitive_locations = []\n    # Iterate through the grid to find cells containing the primitive.\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if current_state.grid[x, y, primitive] > 0:\n                # Assuming the `primitive` argument implies it's a grabbable item\n                # and not an environment feature like 'water' or a 'workshop'.\n                primitive_locations.append((x, y))\n\n    # If no instances of the primitive are found on the grid, it cannot be collected.\n    if not primitive_locations:\n        return []\n\n    # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n    # to any cell that is adjacent to an instance of the target primitive.\n    # Queue stores tuples of ((current_x, current_y), [list_of_actions_to_reach_here])\n    q = collections.deque([(current_state.pos, [])])\n    # Keep track of visited positions to avoid cycles and redundant exploration.\n    visited = {current_state.pos}\n\n    # Pre-calculate all \"target adjacency cells\". These are the cells an agent\n    # needs to occupy to be able to \"USE\" an adjacent primitive.\n    target_adj_cells = set()\n    for px, py in primitive_locations:\n        # Check all 4 direct (non-diagonal) neighbors of the primitive's location.\n        for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n            nx, ny = px + dx, py + dy\n            if is_valid_pos(nx, ny):\n                target_adj_cells.add((nx, ny))\n\n    path_to_adjacent_cell = None\n\n    while q:\n        (curr_x, curr_y), path_actions = q.popleft()\n\n        # Check if the current position is one of our target adjacency cells.\n        if (curr_x, curr_y) in target_adj_cells:\n            # We found the shortest path to a cell from where the primitive can be 'USE'd.\n            path_to_adjacent_cell = path_actions\n            break # Exit BFS, as we found the shortest path.\n\n        # Explore neighbors\n        for (next_x, next_y), action_to_take in get_neighbors_for_bfs(curr_x, curr_y):\n            if (next_x, next_y) not in visited:\n                visited.add((next_x, next_y))\n                q.append(((next_x, next_y), path_actions + [action_to_take]))\n\n    # If no path was found to any adjacent cell, return an empty list.\n    if path_to_adjacent_cell is None:\n        return []\n\n    # 6. Append the 'USE' action to the found movement path.\n    # Once the agent reaches an adjacent cell, it needs to interact to collect.\n    final_actions = path_to_adjacent_cell + [ACTION_USE]\n\n    return final_actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:19:11.786198", "function_name": "collect", "function_body": "    import collections\n\n    # Define actions based on env_factory\n    UP = env_factory.ACTIONS['UP']\n    DOWN = env_factory.ACTIONS['DOWN']\n    LEFT = env_factory.ACTIONS['LEFT']\n    RIGHT = env_factory.ACTIONS['RIGHT']\n    USE = env_factory.ACTIONS['USE']\n\n    # Direction vectors for movement mapped to their corresponding actions.\n    # (dr, dc) represents (row_change, col_change)\n    move_deltas_to_action = {\n        (-1, 0): UP,    # Move up: decrease row index\n        (1, 0): DOWN,   # Move down: increase row index\n        (0, -1): LEFT,  # Move left: decrease col index\n        (0, 1): RIGHT   # Move right: increase col index\n    }\n\n    # Get world and grid dimensions from the scenario's initial grid.\n    # Assuming grid dimensions are consistent throughout the episode.\n    world = env.world\n    WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n    \n    # Get indices of non-grabbable entities to avoid them during pathfinding.\n    non_grabbable_indices = world.non_grabbable_indices\n    \n    # List to store all actions executed by this function.\n    all_actions_taken = []\n\n    # Main loop for attempting to collect the primitive.\n    # It continues until the primitive is in inventory or it becomes clear\n    # it cannot be collected within a reasonable number of attempts/steps.\n    # A max_attempts safeguard prevents infinite loops in edge cases.\n    max_attempts_per_call = 200  # Arbitrary limit to prevent runaway loops\n    attempts = 0\n\n    while attempts < max_attempts_per_call:\n        attempts += 1\n        \n        # Get the current state observations from the environment.\n        obs = env.observations()\n        current_grid = obs['features_dict']['features_global']\n        # The 'pos' from features_dict is 'normalized position array'.\n        # Assuming it represents integer (row, col) coordinates for the grid for simplicity.\n        current_pos = tuple(int(coord) for coord in obs['features_dict']['pos'])\n        current_inventory = obs['features_dict']['inventory']\n\n        # 1. Check if the primitive is already collected.\n        if current_inventory[primitive] > 0:\n            return all_actions_taken  # Goal achieved, return the sequence of actions.\n\n        # 2. Find all current locations of the target primitive on the grid.\n        primitive_locations = []\n        for r in range(WIDTH):\n            for c in range(HEIGHT):\n                if current_grid[r, c, primitive] == 1:\n                    primitive_locations.append((r, c))\n\n        if not primitive_locations:\n            # If the primitive is not on the grid (and not in inventory), it means\n            # it's either unspawned, removed, or unreachable from the current view.\n            # In such a case, we cannot collect it.\n            return all_actions_taken # Indicate failure to collect.\n\n\n        # 3. Use Breadth-First Search (BFS) to find the shortest path to\n        #    a cell that is either on the primitive itself or adjacent to it.\n        q = collections.deque([(current_pos, [])]) # Queue: (position_tuple, list_of_actions_to_reach_here)\n        visited = {current_pos} # Set to keep track of visited grid cells to avoid cycles.\n        \n        path_found_to_target = None # Will store the sequence of actions to reach the target cell.\n\n        while q:\n            (r, c), path_so_far = q.popleft()\n\n            # Check if the current cell (r,c) is the primitive's location.\n            # If so, we are already on it and can 'USE' immediately (path is complete).\n            is_on_primitive = False\n            if (r, c) in primitive_locations:\n                is_on_primitive = True\n                path_found_to_target = path_so_far\n                break # Path found!\n\n            # Check if the current cell (r,c) is adjacent to any primitive location.\n            # Adjacency means Manhattan distance of 1.\n            found_adjacent = False\n            for pr, pc in primitive_locations:\n                if abs(r - pr) + abs(c - pc) == 1:\n                    path_found_to_target = path_so_far\n                    found_adjacent = True\n                    break # Path found!\n            if found_adjacent:\n                break\n\n            # Explore all 4 neighbors (up, down, left, right).\n            for (dr, dc), action_val in move_deltas_to_action.items():\n                nr, nc = r + dr, c + dc # Calculate new neighbor coordinates\n\n                # Check if the neighbor is within grid boundaries.\n                if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n                    continue\n\n                # Check if the neighbor cell is traversable.\n                # A cell is traversable if it does not contain any non-grabbable items.\n                is_traversable = True\n                cell_contents = current_grid[nr, nc, :]\n                for k_idx in range(world.n_kinds):\n                    if cell_contents[k_idx] == 1 and k_idx in non_grabbable_indices:\n                        is_traversable = False\n                        break\n                if not is_traversable:\n                    continue\n\n                # If the neighbor is traversable and not yet visited, add it to the queue.\n                if (nr, nc) not in visited:\n                    visited.add((nr, nc))\n                    q.append(((nr, nc), path_so_far + [action_val]))\n\n        if path_found_to_target is None:\n            # If BFS completes and no path is found, it means the primitive is unreachable\n            # from the current position on the visible grid.\n            return all_actions_taken # Indicate failure to collect.\n\n        # 4. Execute the next action(s) based on the found path.\n        if len(path_found_to_target) > 0:\n            # If the path has movement steps, take the first one.\n            next_move_action = path_found_to_target[0]\n            _, done, _ = env.step(next_move_action)\n            all_actions_taken.append(next_move_action)\n            if done:\n                # If the episode ends (e.g., max_steps reached) before collection, return.\n                return all_actions_taken\n        else:\n            # If the path is empty, it means the agent is already at the target location\n            # (either directly on the primitive or adjacent to it).\n            # In this case, perform the 'USE' action to try and pick it up.\n            _, done, _ = env.step(USE)\n            all_actions_taken.append(USE)\n            if done:\n                # If the episode ends after 'USE', return.\n                return all_actions_taken\n\n    # If the loop finishes due to `max_attempts_per_call`, it implies\n    # the primitive could not be collected within the set limits.\n    return all_actions_taken", "island_id": 1, "scores": {"3": -1}}
