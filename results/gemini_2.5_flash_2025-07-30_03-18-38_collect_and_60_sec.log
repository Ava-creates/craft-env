{"timestamp": "2025-07-30T17:18:42.394714", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Mapping from movement action to the direction the agent would face after taking it\n  action_to_direction = {\n      DOWN_ACTION: SOUTH_DIR,\n      UP_ACTION: NORTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"Calculates the direction the agent needs to face to look at the item.\"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 0 and dy == 0:\n      return None # Agent is on top of item, should not happen when targeting an adjacent cell\n\n    # Prioritize cardinal directions based on largest component\n    if abs(dx) > abs(dy):\n      return EAST_DIR if dx > 0 else WEST_DIR\n    elif abs(dy) > abs(dx):\n      return SOUTH_DIR if dy > 0 else NORTH_DIR\n    else: # This branch is for diagonal cases (e.g., dx=1, dy=1), which aren't direct adjacent cells.\n          # For adjacent cells (dx=0 or dy=0), one of the above ifs will be true.\n          # If it were a diagonal, prioritize vertical or horizontal. For simplicity, match first non-zero.\n      if dy > 0: return SOUTH_DIR\n      if dy < 0: return NORTH_DIR\n      if dx > 0: return EAST_DIR\n      if dx < 0: return WEST_DIR\n    return None\n\n  def _get_turn_actions(current_dir, target_dir):\n    \"\"\"Returns a list of actions to turn from current_dir to target_dir.\"\"\"\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    # Calculate shortest turns (clockwise vs. counter-clockwise)\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION)\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION)\n    return actions\n\n  # Get primitive's integer ID\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Check if the primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  def is_walkable(x, y, current_grid):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-grabbable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item is present at (y, x)\n    for kind_idx in non_grabbable_kinds:\n      if current_grid[y, x, kind_idx] > 0:\n        return False\n    return True\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Find the closest primitive location to the agent's current position (Manhattan distance)\n  min_distance_to_primitive = float('inf')\n  closest_primitive_pos = None\n\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    distance = abs(item_x - start_pos_x) + abs(item_y - start_pos_y)\n    if distance < min_distance_to_primitive:\n      min_distance_to_primitive = distance\n      closest_primitive_pos = (item_x, item_y)\n\n  target_item_x, target_item_y = closest_primitive_pos\n\n  # Determine all valid and walkable adjacent positions to the chosen primitive.\n  target_adjacent_cells = []\n  cardinal_moves = {\n      RIGHT_ACTION: (1, 0),\n      LEFT_ACTION: (-1, 0),\n      DOWN_ACTION: (0, 1),\n      UP_ACTION: (0, -1)\n  }\n\n  for action_type_val, (dx, dy) in cardinal_moves.items():\n    adj_x, adj_y = target_item_x + dx, target_item_y + dy\n    if is_walkable(adj_x, adj_y, grid):\n      target_adjacent_cells.append((adj_x, adj_y))\n\n  if not target_adjacent_cells:\n    return []\n\n  # BFS to find the shortest sequence of movement actions to reach *any* target adjacent cell\n  queue = collections.deque([(start_pos_x, start_pos_y, [])])\n  visited = {(start_pos_x, start_pos_y)}\n\n  movement_actions_to_primitive = None\n\n  while queue:\n    curr_x, curr_y, path_actions = queue.popleft()\n\n    if (curr_x, curr_y) in target_adjacent_cells:\n      movement_actions_to_primitive = path_actions\n      break\n\n    for action_type, (dx, dy) in cardinal_moves.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      if is_walkable(next_x, next_y, grid) and (next_x, next_y) not in visited:\n        visited.add((next_x, next_y))\n        new_path_actions = list(path_actions) + [action_type]\n        queue.append((next_x, next_y, new_path_actions))\n\n  if movement_actions_to_primitive is None:\n    return [] # No path found to any adjacent cell\n\n  # Simulate the agent's final position AND direction after executing the movement actions\n  final_agent_pos_x, final_agent_pos_y = start_pos_x, start_pos_y\n  final_agent_dir = start_dir # Initialize with starting direction\n\n  for action in movement_actions_to_primitive:\n      dx, dy = cardinal_moves[action]\n      final_agent_pos_x += dx\n      final_agent_pos_y += dy\n      # Update agent's facing direction based on the last movement action\n      # This assumes taking a movement action immediately reorients the agent to face that direction.\n      if action in action_to_direction:\n          final_agent_dir = action_to_direction[action]\n\n  # Determine the direction the agent needs to face the primitive from its final position\n  target_face_dir = _get_target_facing_direction(final_agent_pos_x, final_agent_pos_y, target_item_x, target_item_y)\n\n  all_actions = list(movement_actions_to_primitive)\n\n  if target_face_dir is not None:\n    # Use the final_agent_dir (after movements) for calculating turn actions\n    turn_actions = _get_turn_actions(final_agent_dir, target_face_dir)\n    all_actions.extend(turn_actions)\n\n  all_actions.append(USE_ACTION)\n\n  return all_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:19:58.265488", "function_name": "collect", "function_body": "  # The CraftLab class holds a CraftState instance in _current_state\n  current_state = env._current_state\n  world = env.world # CraftLab has a reference to CraftWorld\n\n  # Check if the primitive is already in the inventory\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Get grid dimensions\n  WIDTH, HEIGHT, N_KINDS = current_state.grid.shape\n\n  # Find all precise locations of the primitive on the grid\n  primitive_cells = []\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          # Check if the primitive kind exists at this cell\n          if current_state.grid[x, y, primitive] > 0:\n              primitive_cells.append((x, y))\n\n  if not primitive_cells:\n      # Primitive not found on the grid, return empty actions\n      return []\n\n  # Define movement deltas and their corresponding new directions\n  # Action mapping: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE\n  DELTAS = {\n      0: (0, 1),  # DOWN: (dx, dy)\n      1: (0, -1), # UP: (dx, dy)\n      2: (-1, 0), # LEFT: (dx, dy)\n      3: (1, 0)   # RIGHT: (dx, dy)\n  }\n  \n  # Map (dx, dy) relative to agent's position to the action (direction) agent must face\n  # E.g., if target is (0,1) relative to agent (i.e., immediately DOWN), agent must face DOWN (action 0)\n  DIR_TO_ACTION = {\n      (0, 1): 0,  # Target is DOWN relative to agent, agent must face DOWN (action 0)\n      (0, -1): 1, # Target is UP relative to agent, agent must face UP (action 1)\n      (-1, 0): 2, # Target is LEFT relative to agent, agent must face LEFT (action 2)\n      (1, 0): 3   # Target is RIGHT relative to agent, agent must face RIGHT (action 3)\n  }\n\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Initial direction of the agent\n\n  # Use a list as a basic queue for BFS, as `collections.deque` import is disallowed by constraints.\n  # (current_x, current_y), current_direction, list_of_actions_to_reach_here\n  q = [((start_pos[0], start_pos[1]), start_dir, [])]\n  visited = set([((start_pos[0], start_pos[1]), start_dir)])\n\n  path_to_primitive_actions = None\n\n  head = 0 # Manual queue head for list-based queue\n  while head < len(q):\n      (cx, cy), c_dir, c_actions = q[head]\n      head += 1\n\n      # Check if this state is 'ready to USE' a primitive\n      for tx, ty in primitive_cells:\n          dx, dy = tx - cx, ty - cy\n\n          # Agent needs to be adjacent (cardinally) to the primitive cell\n          # and facing it to USE it.\n          if abs(dx) + abs(dy) == 1: # Cardinal adjacency (manhattan distance 1)\n              required_dir_to_face = DIR_TO_ACTION.get((dx, dy))\n              \n              if required_dir_to_face is not None and c_dir == required_dir_to_face:\n                  # Agent is at (cx, cy), facing (tx, ty), where the primitive is.\n                  path_to_primitive_actions = c_actions\n                  break # Found the path\n      \n      if path_to_primitive_actions:\n          break # Path found, exit BFS\n\n      # Explore next states by trying movement actions (0-3: DOWN, UP, LEFT, RIGHT)\n      for action_idx in range(4):\n          move_dx, move_dy = DELTAS[action_idx]\n          nx, ny = cx + move_dx, cy + move_dy\n          n_dir = action_idx # When moving, the agent's direction updates to the direction of movement\n\n          # Check grid bounds\n          if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n              continue\n\n          # Check for impassable terrain (non-grabbable environment items)\n          is_blocked = False\n          for k_idx in world.non_grabbable_indices:\n              if current_state.grid[nx, ny, k_idx] > 0:\n                  is_blocked = True\n                  break\n          if is_blocked:\n              continue\n\n          next_state_tuple = ((nx, ny), n_dir)\n          if next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              q.append((next_state_tuple, c_actions + [action_idx]))\n\n  if path_to_primitive_actions is None:\n      return [] # No path found to any primitive location from which it can be used\n\n  # Append the pathfinding actions\n  final_actions = list(path_to_primitive_actions)\n  # Finally, append the USE action (action 4)\n  final_actions.append(4)\n\n  return final_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:19:58.335183", "function_name": "collect", "function_body": "    import collections\n\n    # Define action constants for clarity\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    current_state = env._current_state  # Access the current CraftState\n    world = env.world  # Access the CraftWorld instance for non_grabbable_indices\n\n    # 1. Check if the primitive is already collected\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid_w, grid_h, n_kinds = current_state.grid.shape\n    initial_pos = current_state.pos\n\n    # Movement deltas for actions (x, y coordinates)\n    # (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT)\n    _dx = {ACTION_DOWN: 0, ACTION_UP: 0, ACTION_LEFT: -1, ACTION_RIGHT: 1}\n    _dy = {ACTION_DOWN: 1, ACTION_UP: -1, ACTION_LEFT: 0, ACTION_RIGHT: 0}\n\n    # BFS queue: stores (current_position, list_of_actions_to_reach_here)\n    queue = collections.deque([(initial_pos, [])])\n    # Set to keep track of visited positions to avoid cycles and redundant paths\n    visited = {initial_pos}\n\n    def is_traversable(x, y, grid, non_grabbable_indices):\n        \"\"\"Checks if a given grid cell is within bounds and traversable (not an obstacle).\"\"\"\n        if not (0 <= x < grid_w and 0 <= y < grid_h):\n            return False  # Out of bounds\n        # Check if any non-grabbable item (obstacle) is present at this position\n        for k_idx in non_grabbable_indices:\n            if grid[x, y, k_idx] > 0:\n                return False  # Obstacle present\n        return True\n\n    while queue:\n        (current_x, current_y), path_actions = queue.popleft()\n\n        # Check if the primitive is in the 3x3 neighborhood of the current position.\n        # This simulates `CraftState.next_to(primitive)`.\n        found_primitive_nearby = False\n        for dx_n in [-1, 0, 1]:\n            for dy_n in [-1, 0, 1]:\n                nx, ny = current_x + dx_n, current_y + dy_n\n                # Ensure neighborhood cell is within grid bounds\n                if 0 <= nx < grid_w and 0 <= ny < grid_h:\n                    # Check if the primitive kind exists at this neighborhood cell\n                    if current_state.grid[nx, ny, primitive] > 0:\n                        found_primitive_nearby = True\n                        break\n            if found_primitive_nearby:\n                break\n\n        if found_primitive_nearby:\n            # If the primitive is nearby, we can use the 'USE' action\n            return path_actions + [ACTION_USE]\n\n        # Explore possible movement actions\n        for action in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n            next_x, next_y = current_x + _dx[action], current_y + _dy[action]\n            next_pos = (next_x, next_y)\n\n            # Only add to queue if traversable and not yet visited\n            if is_traversable(next_x, next_y, current_state.grid, world.non_grabbable_indices) and \\\n               next_pos not in visited:\n                visited.add(next_pos)\n                queue.append((next_pos, path_actions + [action]))\n\n    # If the queue becomes empty and the primitive hasn't been found, it's unreachable\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:22:05.277225", "function_name": "collect", "function_body": "    # Constants for actions and directions, typically found in a common module or env_factory\n    # Defined here for self-containment, assuming numerical values from common CraftWorld implementations.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    NORTH = 0\n    EAST = 1\n    SOUTH = 2\n    WEST = 3\n\n    # Delta coordinates for each direction (row_delta, col_delta)\n    DIR_DELTAS = {\n        NORTH: (-1, 0),\n        EAST: (0, 1),\n        SOUTH: (1, 0),\n        WEST: (0, -1)\n    }\n\n    # Get current state information from the CraftLab environment\n    current_state = env._current_state\n    initial_grid = current_state.grid\n    initial_pos = current_state.pos  # (row, col)\n    initial_dir = current_state.dir  # Agent's starting direction (NORTH, EAST, SOUTH, WEST)\n\n    HEIGHT, WIDTH, _ = initial_grid.shape\n\n    # 1. Find all locations of the target primitive on the grid\n    primitive_locations = []\n    for r in range(HEIGHT):\n        for c in range(WIDTH):\n            # Check if the cell contains the primitive\n            if initial_grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        # If the primitive is not found on the grid, return an empty list of actions.\n        return []\n\n    # 2. Use Breadth-First Search (BFS) to find the shortest sequence of actions.\n    # The BFS state includes (row, col, current_direction, list_of_actions_taken).\n    # This ensures we find a path not only to an adjacent cell but also correctly orient the agent.\n    queue = collections.deque([(initial_pos[0], initial_pos[1], initial_dir, [])])\n    visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n    # Map movement actions to their resulting new direction and spatial delta.\n    # In CraftWorld, movement actions (UP, DOWN, LEFT, RIGHT) also set the agent's facing direction.\n    movement_actions_info = {\n        ACTION_UP: (NORTH, (-1, 0)),    # (new_direction_after_move, (delta_row, delta_col))\n        ACTION_DOWN: (SOUTH, (1, 0)),\n        ACTION_LEFT: (WEST, (0, -1)),\n        ACTION_RIGHT: (EAST, (0, 1))\n    }\n\n    while queue:\n        r, c, current_dir, path = queue.popleft()\n\n        # Check if the current agent state (position and direction) allows for collecting a primitive.\n        # This means the agent must be adjacent to a primitive and facing it.\n        for target_r, target_c in primitive_locations:\n            dr_to_target = target_r - r\n            dc_to_target = target_c - c\n\n            # If the primitive is exactly one step in the agent's current facing direction\n            if (dr_to_target, dc_to_target) == DIR_DELTAS[current_dir]:\n                # We found a path to an adjacent cell, and the agent is correctly oriented.\n                # Append the USE action and return the full path.\n                return path + [ACTION_USE]\n\n        # Explore possible next states by taking each possible movement action\n        for action, (new_dir_after_move, (dr, dc)) in movement_actions_info.items():\n            nr, nc = r + dr, c + dc  # Calculate the new row and column\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n                continue\n\n            # Check if the new cell (nr, nc) is the target primitive's cell.\n            # The agent cannot move onto the primitive itself, it must stay adjacent and USE it.\n            is_target_primitive_cell = False\n            for p_r, p_c in primitive_locations:\n                if (nr, nc) == (p_r, p_c):\n                    is_target_primitive_cell = True\n                    break\n            \n            if is_target_primitive_cell:\n                continue # Skip if the agent would move onto the primitive's cell.\n\n            # Create the tuple for the new state (position and direction)\n            new_state_tuple = (nr, nc, new_dir_after_move)\n\n            # If this new state has not been visited yet, add it to the queue\n            if new_state_tuple not in visited:\n                visited.add(new_state_tuple)\n                queue.append((nr, nc, new_dir_after_move, path + [action]))\n\n    # If the queue becomes empty and no path was found (meaning the primitive is unreachable),\n    # return an empty list of actions.\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:22:06.270017", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants (moved inside function scope to adhere to constraints)\n  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  # Mapping from movement action to (dr, dc) delta\n  ACTION_TO_DELTADIR = {\n      UP: (-1, 0),    # row decreases\n      DOWN: (1, 0),   # row increases\n      LEFT: (0, -1),  # col decreases\n      RIGHT: (0, 1)   # col increases\n  }\n\n  # Mapping from (dr, dc) delta to agent's internal direction integer\n  # Assuming 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT based on common DMLab conventions and `CraftState`'s `dir` attribute.\n  DELTADIR_TO_AGENT_DIR = {\n      (1, 0): 0,   # DOWN\n      (-1, 0): 1,  # UP\n      (0, -1): 2,  # LEFT\n      (0, 1): 3    # RIGHT\n  }\n\n  def get_turns(current_dir_int, target_dir_int):\n      \"\"\"\n      Calculates the sequence of LEFT/RIGHT turns needed to change from current_dir_int to target_dir_int.\n      Assumes directions are 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT.\n      \"\"\"\n      diff = (target_dir_int - current_dir_int + 4) % 4\n      if diff == 1: # e.g., current 0 (DOWN), target 3 (RIGHT) -> +1 (clockwise)\n          return [RIGHT]\n      elif diff == 3: # e.g., current 0 (DOWN), target 2 (LEFT) -> -1 (counter-clockwise)\n          return [LEFT]\n      elif diff == 2: # 180 degree turn\n          return [LEFT, LEFT] # or [RIGHT, RIGHT]\n      return [] # Already facing correctly (diff == 0)\n\n  collected_actions = []\n  MAX_TOTAL_STEPS = 500  # Safety limit to prevent infinite loops\n\n  # Access current state directly for convenience\n  current_state = env._current_state\n  current_steps = 0\n\n  # Check if primitive is already collected\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  while current_state.inventory[primitive] == 0 and current_steps < MAX_TOTAL_STEPS:\n      grid = current_state.grid\n      width, height, n_kinds = grid.shape\n      agent_r, agent_c = current_state.pos\n      agent_dir = current_state.dir\n\n      # 1. Find all locations of the primitive on the grid\n      primitive_locs = []\n      for r in range(width):\n          for c in range(height):\n              if grid[r, c, primitive] > 0:\n                  primitive_locs.append((r, c))\n\n      if not primitive_locs:\n          # Primitive not on grid and not in inventory. Cannot collect.\n          # This implies it's either already gone or was never there.\n          break # Exit loop, return current actions (empty or partial path)\n\n      # 2. Find the shortest path to a cell adjacent to the primitive, from which the agent can USE it.\n      # BFS state: ((row, col), [path_actions_taken_to_reach_this_pos])\n      q = collections.deque([((agent_r, agent_c), [])])\n      visited = {current_state.pos}\n\n      best_target_path = None\n      best_target_adj_pos = None\n      best_target_dir_to_face = None\n\n      target_found = False\n      while q and not target_found:\n          (r, c), path_actions = q.popleft()\n\n          # Check neighbors of (r,c) to see if any contain the primitive.\n          # If a neighbor (neighbor_r, neighbor_c) has the primitive, then (r,c) is a suitable\n          # adjacent position for the agent to stand and USE.\n          for move_action_to_neighbor, (dr_move, dc_move) in ACTION_TO_DELTADIR.items():\n              neighbor_r, neighbor_c = r + dr_move, c + dc_move\n\n              # Check if neighbor is within grid bounds and contains the primitive\n              if 0 <= neighbor_r < width and 0 <= neighbor_c < height and \\\n                 grid[neighbor_r, neighbor_c, primitive] > 0:\n                  \n                  # Found a cell (r,c) that is adjacent to a primitive at (neighbor_r, neighbor_c).\n                  # This (r,c) is our target adjacent position.\n                  # The direction to face the primitive from (r,c) is the same (dr_move, dc_move)\n                  # that would move the agent from (r,c) to (neighbor_r, neighbor_c).\n                  target_deltadir = (dr_move, dc_move)\n                  if target_deltadir in DELTADIR_TO_AGENT_DIR:\n                      target_agent_dir = DELTADIR_TO_AGENT_DIR[target_deltadir]\n\n                      # Since BFS explores layer by layer, the first path found is the shortest.\n                      best_target_path = path_actions\n                      best_target_adj_pos = (r, c)\n                      best_target_dir_to_face = target_agent_dir\n                      target_found = True\n                      break # Break from inner for loop, then outer while loop\n\n          if target_found:\n              break # Break from outer while loop (BFS)\n\n          # If no target found from (r,c), explore its neighbors for movement\n          for action_to_next, (dr_next, dc_next) in ACTION_TO_DELTADIR.items():\n              next_r, next_c = r + dr_next, c + dc_next\n              if 0 <= next_r < width and 0 <= next_c < height and (next_r, next_c) not in visited:\n                  # Assuming all cells are walkable by default unless specific environment rules prevent it.\n                  # `env.step` will handle actual collisions if they exist.\n                  visited.add((next_r, next_c))\n                  q.append(((next_r, next_c), path_actions + [action_to_next]))\n\n      if not target_found:\n          # No path found to any cell adjacent to a primitive.\n          break # Exit loop, return current actions (empty or partial path)\n\n      # 3. Execute movement actions to reach `best_target_adj_pos`\n      for action in best_target_path:\n          reward, done, obs = env.step(action)\n          current_state = env._current_state\n          collected_actions.append(action)\n          current_steps += 1\n          if current_state.inventory[primitive] > 0 or done:\n              return collected_actions\n\n      # Agent should now be at `best_target_adj_pos`.\n      # 4. Orient the agent towards `best_target_prim_pos` (the primitive itself)\n      turns = get_turns(current_state.dir, best_target_dir_to_face)\n      for turn_action in turns:\n          reward, done, obs = env.step(turn_action)\n          current_state = env._current_state\n          collected_actions.append(turn_action)\n          current_steps += 1\n          if current_state.inventory[primitive] > 0 or done:\n              return collected_actions\n\n      # 5. Execute `USE` action\n      reward, done, obs = env.step(USE)\n      current_state = env._current_state\n      collected_actions.append(USE)\n      current_steps += 1\n\n      if current_state.inventory[primitive] > 0:\n          return collected_actions\n      if done:\n          return collected_actions\n\n      # If the primitive was not collected after USE, and env is not done,\n      # the loop will repeat. This accounts for scenarios where USE might fail,\n      # or the item might have been consumed/moved by other game mechanics.\n      # The next iteration will re-scan the grid and find a new path if needed.\n\n  return collected_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:23:04.365572", "function_name": "collect", "function_body": "    _actions_map = env.action_specs()\n    _DOWN = _actions_map['DOWN']\n    _UP = _actions_map['UP']\n    _LEFT = _actions_map['LEFT']\n    _RIGHT = _actions_map['RIGHT']\n    _USE = _actions_map['USE']\n\n    # Get current state information from the environment's observations\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    \n    current_grid = features_dict['features_global'] # Full allocentric grid\n    \n    # Get grid dimensions from the scenario\n    WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape\n\n    # Denormalize current agent position\n    current_pos_normalized = features_dict['pos']\n    current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n    current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n    current_pos = (current_px, current_py)\n\n    # Check if the primitive is grabbable. If not, it cannot be collected.\n    if primitive not in env.world.grabbable_indices:\n        return []\n\n    # If the agent is already on the primitive, just use it.\n    if current_grid[current_px, current_py, primitive] == 1:\n        return [_USE]\n\n    # Find all locations where the primitive exists on the grid\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            # Check if the primitive kind exists at this cell\n            if current_grid[x, y, primitive] == 1:\n                primitive_locations.append((x, y))\n\n    # If no primitive is found on the grid, return an empty list of actions\n    if not primitive_locations:\n        return []\n\n    # Use Breadth-First Search (BFS) to find the shortest path to any primitive location\n    # Queue stores positions (x, y)\n    q = collections.deque() \n    q.append(current_pos)\n    \n    # Set to store visited positions to avoid cycles and re-processing longer paths\n    visited = {current_pos} \n\n    # Dictionary to reconstruct the path: maps (x, y) to ((parent_x, parent_y), action_from_parent)\n    came_from = {} \n\n    # Define possible movements and their corresponding actions\n    # (dx, dy): action\n    moves = {\n        (0, -1): _UP,\n        (0, 1): _DOWN,\n        (-1, 0): _LEFT,\n        (1, 0): _RIGHT\n    }\n\n    # Obstacle check function: A cell is considered an obstacle if it contains\n    # any non-grabbable item.\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    def is_obstacle(x, y, grid, non_grabbable_items_set):\n        \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle).\"\"\"\n        for k in non_grabbable_items_set:\n            if grid[x, y, k] == 1:\n                return True\n        return False\n\n    target_pos_found = None\n\n    while q:\n        cx, cy = q.popleft()\n\n        # If the current position contains the primitive, we found a path.\n        # Since it's BFS, this is guaranteed to be the shortest path to *a* primitive.\n        if current_grid[cx, cy, primitive] == 1:\n            target_pos_found = (cx, cy)\n            break # Exit BFS as the shortest path is found\n\n        # Explore neighbors\n        for (dx, dy), action in moves.items():\n            nx, ny = cx + dx, cy + dy\n\n            # Check boundaries\n            if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n                continue\n\n            # Check if already visited\n            if (nx, ny) in visited:\n                continue\n\n            # Check if the neighbor cell is an obstacle\n            if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n                continue\n\n            # If the neighbor is valid and not an obstacle, add it to the queue\n            q.append((nx, ny))\n            visited.add((nx, ny))\n            came_from[(nx, ny)] = ((cx, cy), action) # Store parent and action to reconstruct path\n  \n    actions_to_take = []\n    # If a path was found, reconstruct it and append the USE action\n    if target_pos_found is not None:\n        current = target_pos_found\n        path_actions = []\n        while current != current_pos:\n            parent_pos, action = came_from[current]\n            path_actions.insert(0, action) # Insert at the beginning to build path in correct order\n            current = parent_pos\n        actions_to_take = path_actions + [_USE]\n    \n    return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:23:05.347325", "function_name": "collect", "function_body": "  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # If the agent is already on the primitive, just use it.\n  if current_grid[current_px, current_py, primitive] == 1:\n      return [_USE]\n\n  # Check if the primitive exists anywhere on the grid.\n  # This avoids running BFS if the item is not present.\n  primitive_exists_on_grid = False\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      if current_grid[x, y, primitive] == 1:\n        primitive_exists_on_grid = True\n        break\n    if primitive_exists_on_grid:\n        break\n\n  if not primitive_exists_on_grid:\n    return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path to any primitive location\n  # Queue stores tuples: (current_x, current_y)\n  q = collections.deque()\n  q.append(current_pos) \n  \n  # Dictionary to reconstruct path: maps child_pos -> (parent_pos, action_taken_to_reach_child)\n  # This avoids costly list concatenations during BFS by reconstructing the path at the end.\n  parent_map = {current_pos: (None, None)} # Sentinel for the starting node\n  \n  # Set to store visited positions to avoid cycles and re-processing longer paths\n  visited = {current_pos} \n\n  # Define possible movements and their corresponding actions\n  # (dx, dy): action\n  moves = {\n      (0, -1): _UP,    # North\n      (0, 1): _DOWN,   # South\n      (-1, 0): _LEFT,  # West\n      (1, 0): _RIGHT  # East\n  }\n\n  # Obstacle check function: A cell is considered an obstacle if it contains\n  # any non-grabbable item.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle).\"\"\"\n    for k in non_grabbable_items_set:\n      if grid[x, y, k] == 1:\n        return True\n    return False\n\n  target_found_pos = None\n\n  while q:\n    cx, cy = q.popleft()\n\n    # If the current position contains the primitive, we found a path.\n    # Since it's BFS, this is guaranteed to be the shortest path to *a* primitive.\n    if current_grid[cx, cy, primitive] == 1:\n      target_found_pos = (cx, cy)\n      break # Exit BFS as the shortest path is found\n\n    # Explore neighbors\n    for (dx, dy), action in moves.items():\n      nx, ny = cx + dx, cy + dy\n\n      # Check boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if already visited\n      if (nx, ny) in visited:\n        continue\n\n      # Check if the neighbor cell is an obstacle\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n\n      # If the neighbor is valid and not an obstacle, add it to the queue and parent map\n      q.append(((nx, ny)))\n      visited.add((nx, ny))\n      parent_map[(nx, ny)] = ((cx, cy), action)\n  \n  actions_to_take = []\n  if target_found_pos is not None:\n    # Reconstruct the path by backtracking from the target\n    path_reconstruction_reversed = []\n    current = target_found_pos\n    \n    # Backtrack until we reach the start position (where parent is None)\n    while parent_map[current][0] is not None:\n      parent, action = parent_map[current]\n      path_reconstruction_reversed.append(action)\n      current = parent\n    \n    # The path is built in reverse, so reverse it to get actions from start to target\n    actions_to_take = path_reconstruction_reversed[::-1] + [_USE] # Reverses list and adds USE\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:25:37.253635", "function_name": "collect", "function_body": "    import collections # Ensure collections is available for deque\n\n    # Action constants (assuming these are fixed for CraftLab and globally available or defined elsewhere)\n    # ACTION_DOWN = 0\n    # ACTION_UP = 1\n    # ACTION_LEFT = 2\n    # ACTION_RIGHT = 3\n    # ACTION_USE = 4\n\n    # A reasonable maximum number of steps for collection, including pathfinding and USE.\n    # MAX_COLLECT_STEPS = 100 # Assuming this is also globally available\n\n    # Mapping direction integer (0-3) to (dy, dx) tuple. Assuming 0:N, 1:E, 2:S, 3:W\n    # DIR_DELTAS = {\n    #     0: (-1, 0), # North (UP)\n    #     1: (0, 1),  # East (RIGHT)\n    #     2: (1, 0),  # South (DOWN)\n    #     3: (0, -1)  # West (LEFT)\n    # }\n    # Mapping action to the resulting direction index (0-3)\n    # ACTION_TO_DIR = {\n    #     ACTION_UP: 0,\n    #     ACTION_RIGHT: 1,\n    #     ACTION_DOWN: 2,\n    #     ACTION_LEFT: 3\n    # }\n\n    def _find_path_to_collect_point(start_pos, initial_dir, full_grid, primitive_id, world):\n        \"\"\"\n        Performs BFS to find the shortest path of actions (moves) that places the agent\n        in a position where it can collect the primitive using the ACTION_USE.\n        Returns a list of actions (moves) or None if no path is found.\n        \"\"\"\n        grid_height, grid_width, _ = full_grid.shape\n        start_y, start_x = start_pos\n\n        # Entities that block movement (non_grabbable_indices typically implies impassable terrain)\n        impassable_movement_kinds = world.non_grabbable_indices\n\n        q = collections.deque([(start_y, start_x, initial_dir, [])]) # (y, x, current_direction, path_of_actions)\n        visited = {(start_y, start_x, initial_dir)}\n\n        while q:\n            curr_y, curr_x, curr_dir, path_actions = q.popleft()\n\n            # Check if the primitive is in the cell *in front* of the agent from current (y,x,dir)\n            # This is the target condition for performing ACTION_USE\n            front_dy, front_dx = DIR_DELTAS[curr_dir]\n            front_y, front_x = curr_y + front_dy, curr_x + front_dx\n\n            if (0 <= front_y < grid_height and 0 <= front_x < grid_width and\n                    full_grid[front_y, front_x, primitive_id] > 0):\n                # Agent is at (curr_y, curr_x) facing curr_dir, and primitive_id is directly in front.\n                # This is a valid position to use ACTION_USE.\n                return path_actions # Return only the movement actions to reach this state\n\n            # Explore neighbors (move actions)\n            move_actions = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n            for action in move_actions:\n                next_dir = ACTION_TO_DIR[action] # Direction after performing this move action\n                move_dy, move_dx = DIR_DELTAS[next_dir]\n                next_y, next_x = curr_y + move_dy, curr_x + move_dx\n\n                # Check bounds\n                if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                    continue\n\n                # Check if the next cell contains any impassable kinds for movement\n                is_traversable = True\n                for k_idx in impassable_movement_kinds:\n                    if full_grid[next_y, next_x, k_idx] > 0:\n                        is_traversable = False\n                        break\n                if not is_traversable:\n                    continue\n\n                # Check if this (position, direction) state has been visited to avoid cycles\n                if (next_y, next_x, next_dir) in visited:\n                    continue\n\n                visited.add((next_y, next_x, next_dir))\n                q.append((next_y, next_x, next_dir, path_actions + [action]))\n\n        return None # No path found to a collectible point\n\n    # Main logic for collect_v2\n    actions_taken = []\n\n    # Reset the environment to get the initial state\n    current_obs = env.reset()\n    # Access the internal CraftState instance for detailed information\n    current_state = env._current_state\n\n    # Ensure the primitive is a valid kind known to the world\n    if primitive not in current_state.world.cookbook.kinds:\n        return []\n\n    # Check if the primitive is already in the inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get initial state for pathfinding\n    start_pos = current_state.pos\n    initial_dir = current_state.dir # Agent's current facing direction\n    full_grid = current_state.features_dict()['features_global'] # Full allocentric grid view\n\n    # Find the path of movements to reach a position to USE the primitive\n    path_of_moves = _find_path_to_collect_point(start_pos, initial_dir, full_grid, primitive, current_state.world)\n\n    if path_of_moves is None:\n        return [] # No path found to the primitive on the map or it's unreachable\n\n    # Execute the found path of movements\n    for action in path_of_moves:\n        # Safeguard against excessively long action sequences if pathfinding becomes inefficient\n        if len(actions_taken) >= MAX_COLLECT_STEPS:\n            return [] # Max steps reached before fully executing path or collecting\n\n        actions_taken.append(action)\n        reward, done, current_obs = env.step(action)\n        current_state = env._current_state # Update state after the step\n\n        # Early exit: If the primitive was collected before the end of the calculated path\n        # (e.g., due to an implicit pickup mechanism not fully modeled, or multiple items)\n        if current_state.inventory[primitive] > 0:\n            return actions_taken\n\n    # After executing all movement actions, the agent should be in the correct position\n    # and facing the primitive. Now, attempt to USE it.\n    if len(actions_taken) < MAX_COLLECT_STEPS: # Ensure there's still room for the USE action\n        actions_taken.append(ACTION_USE)\n        reward, done, current_obs = env.step(ACTION_USE)\n        current_state = env._current_state # Update state after USE\n\n        if current_state.inventory[primitive] > 0:\n            return actions_taken # Successfully collected with USE\n        else:\n            # Collection failed even after reaching the correct position and attempting USE.\n            # This could be due to missing tools, workshop requirements (though 'primitives' usually don't), etc.\n            return []\n    else:\n        # Max steps hit exactly at the end of the movement path, no room for final USE action\n        return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:25:38.243023", "function_name": "collect", "function_body": "  # Constants for actions and directions (assuming these are globally available or imported)\n  # In a real scenario, these might be defined in a shared constants module or the env itself.\n  # For the purpose of this completion, we define them here to ensure completeness of the function.\n  \n  # Importing necessary modules within the function for self-containment as requested,\n  # though typically they would be at the top of the file.\n  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      ACTION_UP: DIR_NORTH,\n      ACTION_DOWN: DIR_SOUTH,\n      ACTION_LEFT: DIR_WEST,\n      ACTION_RIGHT: DIR_EAST\n  }\n\n  # Mapping of target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction to collect that target via ACTION_USE.\n  # This focuses on cardinal directions, as ACTION_USE typically applies to what's directly in front.\n  RELATIVE_TO_REQUIRED_DIR = {\n      (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n      (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n      (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n      (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_cell_in_front(pos, direction):\n      y, x = pos\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return None # Should not happen with valid directions\n\n  # Breadth-First Search (BFS) to find a path to the primitive, ensuring the agent\n  # ends up at a position AND orientation suitable for collection.\n  def _find_path_and_orientation_for_collection(start_pos, start_dir, full_grid, primitive_id, world):\n      grid_height, grid_width, _ = full_grid.shape\n      impassable_kinds = world.non_grabbable_indices\n      can_move_onto_primitive = primitive_id not in impassable_kinds # Is the primitive traversable?\n\n      # BFS state: (current_y, current_x, current_dir, path_of_actions)\n      q = collections.deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n      moves_options = [\n          (-1, 0, ACTION_UP, DIR_NORTH),\n          (1, 0, ACTION_DOWN, DIR_SOUTH),\n          (0, -1, ACTION_LEFT, DIR_WEST),\n          (0, 1, ACTION_RIGHT, DIR_EAST)\n      ]\n\n      while q:\n          curr_y, curr_x, curr_dir, path_actions = q.popleft()\n          \n          # Check if the primitive is on the current cell\n          if full_grid[curr_y, curr_x, primitive_id] > 0:\n              # If the primitive is on the current cell and is traversable/collectable directly from there,\n              # this is a valid collection point. (0,0) indicates it's on the agent's cell.\n              if can_move_onto_primitive:\n                  return (path_actions, (0, 0)) \n\n          # Check if the primitive is cardinally adjacent to the current cell AND agent is facing it\n          for rel_dy, rel_dx in RELATIVE_TO_REQUIRED_DIR.keys(): # Iterate through cardinal relative positions\n              adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n              # Check bounds and if the adjacent cell contains the primitive\n              if (0 <= adj_y < grid_height and 0 <= adj_x < grid_width and\n                      full_grid[adj_y, adj_x, primitive_id] > 0):\n                  \n                  # Primitive found at (adj_y, adj_x).\n                  # Now, check if the agent's current direction matches the direction required to collect it.\n                  required_dir_for_collection = RELATIVE_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n                  if curr_dir == required_dir_for_collection:\n                      # Found a path that leads to a position AND ensures the agent is oriented correctly.\n                      return (path_actions, (rel_dy, rel_dx))\n\n          # Explore neighboring cells\n          for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n              # Check bounds\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if the next cell is traversable for movement (i.e., does not contain any impassable kinds)\n              is_traversable_for_movement = True\n              for k_idx in impassable_kinds:\n                  if full_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable_for_movement = False\n                      break\n              if not is_traversable_for_movement:\n                  continue\n              \n              # Add to queue only if this new state (position and direction) hasn't been visited\n              if (next_y, next_x, new_dir_after_move) not in visited:\n                  visited.add((next_y, next_x, new_dir_after_move))\n                  q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n      return (None, None) # No path found to the primitive with correct orientation\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state\n  current_obs = env.reset() \n  current_state = env._current_state # Access the underlying CraftState instance\n\n  # Initial checks\n  if primitive not in current_state.world.cookbook.kinds:\n      return [] # The specified primitive ID is not recognized\n  if current_state.inventory[primitive] > 0:\n      return [] # The primitive has already been collected\n\n  full_grid = current_state.features_dict()['features_global']\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  \n  # Find the sequence of movements and the relative target coordinates\n  path_of_moves, relative_target_coords = _find_path_and_orientation_for_collection(\n      start_pos, start_dir, full_grid, primitive, current_state.world\n  )\n\n  if path_of_moves is None:\n      return [] # No path found that leads to the primitive with correct orientation\n\n  # Execute the found path of movements\n  for action in path_of_moves:\n      # Check if adding this movement action would exceed the total allowed steps\n      # (reserving at least one slot for the final ACTION_USE)\n      if len(actions_taken) + 1 >= MAX_COLLECT_STEPS: \n          return [] # Prevent excessively long action sequences\n      actions_taken.append(action)\n      _, _, _ = env.step(action) # Take the step, update state (reward, done, obs are ignored for this func)\n      current_state = env._current_state # Always update the internal state after a step\n\n  # After executing all movement actions, the agent should be at the correct position\n  # and facing the correct direction as determined by the BFS. Now, perform the USE action.\n  \n  # Verify that the primitive is indeed located where the agent expects to collect it from.\n  is_target_on_current_cell = (relative_target_coords == (0,0))\n  is_primitive_reachable_by_use = False\n\n  if is_target_on_current_cell:\n      # If the target is on the current cell, verify its presence there.\n      if full_grid[current_state.pos[0], current_state.pos[1], primitive] > 0:\n          is_primitive_reachable_by_use = True\n  else:\n      # If the target is adjacent, verify its presence in the cell the agent is currently facing.\n      target_cell_y, target_cell_x = _get_cell_in_front(current_state.pos, current_state.dir)\n      if target_cell_y is not None and \\\n         0 <= target_cell_y < grid_height and 0 <= target_cell_x < grid_width:\n          if full_grid[target_cell_y, target_cell_x, primitive] > 0:\n              is_primitive_reachable_by_use = True\n\n  if is_primitive_reachable_by_use:\n      # If the primitive is reachable, append and execute the ACTION_USE\n      if len(actions_taken) < MAX_COLLECT_STEPS: # Ensure there's still capacity for the USE action\n          actions_taken.append(ACTION_USE)\n          _, _, _ = env.step(ACTION_USE)\n          current_state = env._current_state # Update state after USE\n\n          # Final check: Confirm the primitive was successfully collected into inventory\n          if current_state.inventory[primitive] > 0:\n              return actions_taken # Successfully collected!\n          else:\n              # Collection failed even after reaching and attempting USE (e.g., requires specific tool,\n              # resource depleted, environmental constraint not modeled by simple traversability, etc.)\n              return [] \n      else:\n          # Max steps reached, no space left for the final USE action\n          return [] \n  else:\n      # This case indicates a discrepancy: BFS found a path, but the primitive is not\n      # in the expected location after executing the path. This should ideally not happen\n      # if the environment state is deterministic and the BFS logic is perfectly aligned.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:26:48.585433", "function_name": "collect", "function_body": "  # Get action integer mappings\n  actions_map = env.action_specs()\n  DOWN = actions_map['DOWN']\n  UP = actions_map['UP']\n  LEFT = actions_map['LEFT']\n  RIGHT = actions_map['RIGHT']\n  USE = actions_map['USE']\n\n  current_state = env._current_state\n  current_grid = current_state.grid\n  agent_x, agent_y = current_state.pos\n  # n_kinds = current_grid.shape[2] # Not directly needed for this logic\n  grid_width, grid_height = current_grid.shape[0], current_grid.shape[1]\n\n  actions = []\n\n  # 1. Check if the primitive is already in the inventory\n  if current_state.inventory[primitive] > 0:\n    return []  # Already collected\n\n  # 2. Locate the primitive on the grid\n  primitive_x, primitive_y = -1, -1\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if current_grid[x, y, primitive] == 1:\n        primitive_x, primitive_y = x, y\n        break\n    if primitive_x != -1:\n      break\n\n  if primitive_x == -1:\n    return []  # Primitive not found on the map\n\n  # 3. Check if the primitive is grabbable\n  if primitive not in env.world.grabbable_indices:\n    return []  # Cannot \"collect\" non-grabbable items\n\n  # 4. If the agent is already on the primitive's location, use it immediately\n  if agent_x == primitive_x and agent_y == primitive_y:\n    actions.append(USE)\n    return actions\n\n  # 5. Find the best adjacent cell for the agent to move to\n  # Candidate adjacent cells (relative to the primitive)\n  # (target_x, target_y) for the agent to move to.\n  adjacent_cells_candidates = [\n      (primitive_x, primitive_y - 1),  # Above primitive\n      (primitive_x, primitive_y + 1),  # Below primitive\n      (primitive_x - 1, primitive_y),  # Left of primitive\n      (primitive_x + 1, primitive_y)   # Right of primitive\n  ]\n\n  best_target_adj_x, best_target_adj_y = -1, -1\n  min_dist = float('inf')\n\n  for tx, ty in adjacent_cells_candidates:\n    # Check if the target cell is within grid boundaries\n    if 0 <= tx < grid_width and 0 <= ty < grid_height:\n      # Calculate Manhattan distance from agent's current position to this adjacent cell\n      dist = abs(agent_x - tx) + abs(agent_y - ty)\n      if dist < min_dist:\n        min_dist = dist\n        best_target_adj_x, best_target_adj_y = tx, ty\n\n  if best_target_adj_x == -1:\n    # No valid adjacent cell found (e.g., primitive is at the edge of a very small map\n    # and all adjacent spots are out of bounds or blocked if obstacles were considered).\n    return []\n\n  # 6. Generate movement actions to reach the best adjacent cell\n  # Simulate agent's position for planning the path\n  sim_agent_x, sim_agent_y = agent_x, agent_y\n\n  # Move horizontally\n  while sim_agent_x != best_target_adj_x:\n    if sim_agent_x < best_target_adj_x:\n      actions.append(RIGHT)\n      sim_agent_x += 1\n    else:  # sim_agent_x > best_target_adj_x\n      actions.append(LEFT)\n      sim_agent_x -= 1\n\n  # Move vertically\n  while sim_agent_y != best_target_adj_y:\n    if sim_agent_y < best_target_adj_y:\n      actions.append(DOWN)\n      sim_agent_y += 1\n    else:  # sim_agent_y > best_target_adj_y\n      actions.append(UP)\n      sim_agent_y -= 1\n\n  # 7. Add the USE action to pick up the primitive\n  actions.append(USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:26:48.654881", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants (assuming these are globally available or defined elsewhere)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    initial_state = env._current_state\n    \n    # 1. Check if the primitive is already in inventory\n    if initial_state.inventory[primitive] > 0:\n        return [] # Already collected\n\n    queue = collections.deque([(initial_state.pos, [])]) # (position, path_actions)\n    visited = {initial_state.pos} # set of visited (row, col) tuples\n\n    grid_height = initial_state.grid.shape[0]\n    grid_width = initial_state.grid.shape[1]\n\n    # First, find the absolute coordinates of *any* instance of the primitive on the grid.\n    # The BFS will then find a path to a cell from which this primitive can be 'USE'd.\n    found_primitive_coords = None\n    for r in range(grid_height):\n        for c in range(grid_width):\n            if initial_state.grid[r, c, primitive] > 0:\n                found_primitive_coords = (r, c)\n                break\n        if found_primitive_coords:\n            break\n    \n    if found_primitive_coords is None:\n        # Primitive not found on the grid, cannot collect.\n        return []\n\n    prim_r, prim_c = found_primitive_coords\n\n    # BFS to find a path to a cell from which the primitive can be 'USE'd\n    while queue:\n        current_pos, current_path = queue.popleft()\n        current_r, current_c = current_pos\n\n        # Check if the current position is adjacent to or on the primitive\n        # (i.e., within its 3x3 neighborhood, which allows the `USE` action)\n        if max(abs(current_r - prim_r), abs(current_c - prim_c)) <= 1:\n            # We are at a position where the primitive can be \"used\".\n            return current_path + [USE]\n\n        # Explore neighbors (movement actions)\n        # (dr, dc) defines the change in (row, column) for each action.\n        moves = [\n            ((-1, 0), UP),    # Move North (Up in grid)\n            ((1, 0), DOWN),   # Move South (Down in grid)\n            ((0, -1), LEFT),  # Move West (Left in grid)\n            ((0, 1), RIGHT)   # Move East (Right in grid)\n        ]\n\n        for (dr, dc), action in moves:\n            next_r, next_c = current_r + dr, current_c + dc\n            next_pos = (next_r, next_c)\n\n            # Check if the next position is within grid boundaries\n            if 0 <= next_r < grid_height and 0 <= next_c < grid_width:\n                # In a more complex environment, you might check if `next_pos` is blocked\n                # by an impassable object (e.g., walls, certain non_grabbable_indices).\n                # For `collect_v2`, we assume basic grid traversal is possible unless out of bounds.\n\n                if next_pos not in visited:\n                    visited.add(next_pos)\n                    queue.append((next_pos, current_path + [action]))\n\n    # If BFS completes and no path is found (e.g., primitive is unreachable)\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:27:57.438191", "function_name": "collect", "function_body": "  import collections\n  \n  # Assuming these constants are globally defined or imported from `env_factory`\n  # For completeness and local testing, they might look like this:\n  # ACTION_DOWN = 0\n  # ACTION_UP = 1\n  # ACTION_LEFT = 2\n  # ACTION_RIGHT = 3\n  # ACTION_USE = 4\n  # MAX_COLLECT_STEPS = 100 # A reasonable default if not provided\n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"Returns the coordinates of the cell directly in front of (y,x) based on direction.\"\"\"\n      if direction == 0: return y - 1, x # UP\n      if direction == 1: return y, x + 1 # RIGHT\n      if direction == 2: return y + 1, x # DOWN\n      if direction == 3: return y, x - 1 # LEFT\n      return y, x # Should not be reached for valid movement directions\n\n  def _get_direction_from_action(action):\n      \"\"\"Returns the direction integer (0-3) corresponding to a movement action.\"\"\"\n      if action == ACTION_UP: return 0\n      if action == ACTION_RIGHT: return 1\n      if action == ACTION_DOWN: return 2\n      if action == ACTION_LEFT: return 3\n      return -1 # Not a valid movement action\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state and access its internal CraftState.\n  # This ensures we start from a clean, known state for pathfinding.\n  env.reset() \n  current_state = env._current_state \n\n  # Ensure the primitive is a valid kind known to the world\n  if primitive not in current_state.world.cookbook.kinds:\n      return [] \n\n  # Check if the primitive is already in the inventory. If so, no actions needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir # Use the agent's current direction from the reset state\n\n  impassable_kinds = current_state.world.non_grabbable_indices\n\n  # Define movement actions and their resulting directions and (dy, dx) changes.\n  # Direction mapping: 0=Up, 1=Right, 2=Down, 3=Left\n  movement_actions_map = {\n      ACTION_UP:    (0, -1, 0), # (resulting_direction, dy, dx)\n      ACTION_RIGHT: (1, 0, 1),\n      ACTION_DOWN:  (2, 1, 0),\n      ACTION_LEFT:  (3, 0, -1)\n  }\n\n  q = collections.deque()\n  # BFS state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  q.append((start_y, start_x, start_dir, []))\n  # Visited set tracks (position, direction) to avoid redundant exploration and loops.\n  visited = {(start_y, start_x, start_dir)} \n\n  path_to_use = None # Will store the sequence of actions including the final USE action\n\n  # --- BFS to find a path to a position and orientation suitable for collection ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Optimization: Prune paths that are already too long before even exploring further.\n      # This helps to keep the search efficient within the MAX_COLLECT_STEPS budget.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # Check if the primitive is directly in front of the agent at current (y,x,dir)\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Ensure facing coordinates are within bounds\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width):\n          # Check if the cell directly in front contains the primitive\n          if full_grid[facing_y, facing_x, primitive] > 0:\n              # We found a path to a position and orientation where ACTION_USE should work.\n              path_to_use = path + [ACTION_USE]\n              break # Path found, exit BFS\n\n      # Explore neighbors by applying movement actions\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Check bounds for the next agent position\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the next cell is traversable (does not contain any impassable kind)\n          is_traversable = True\n          for k_idx in impassable_kinds:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n          \n          # Check if this (position, direction) state has been visited\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n  \n  # --- Execute the found path (if any) ---\n  if path_to_use is None:\n      return [] # No path found to directly collect the primitive\n\n  # Execute actions step by step, respecting MAX_COLLECT_STEPS\n  for action in path_to_use:\n      if len(actions_taken) >= MAX_COLLECT_STEPS:\n          # Stop if the total number of actions taken reaches the limit\n          break \n\n      actions_taken.append(action)\n      # Step the environment and update the internal state\n      _, _, _ = env.step(action) # Reward and done status are not used for pathfinding logic here\n      current_state = env._current_state # Update state after the step\n\n      # If the primitive is now in the inventory, we have successfully collected it.\n      # Return the sequence of actions taken so far.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n  \n  # If the loop completes without collecting the primitive (e.g., MAX_COLLECT_STEPS was hit\n  # or the path ultimately failed for other reasons), return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:27:58.403856", "function_name": "collect", "function_body": "  import collections\n  \n  # Constants like ACTION_DOWN, ACTION_UP, etc., and MAX_COLLECT_STEPS\n  # are assumed to be globally available or imported from `env_factory`.\n  # For example:\n  # from env_factory import ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE, MAX_COLLECT_STEPS\n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"Returns the coordinates of the cell directly in front of (y,x) based on direction.\"\"\"\n      if direction == 0: return y - 1, x # UP\n      if direction == 1: return y, x + 1 # RIGHT\n      if direction == 2: return y + 1, x # DOWN\n      if direction == 3: return y, x - 1 # LEFT\n      return y, x # Should not be reached for valid movement directions\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state\n  current_obs = env.reset() \n  # Access the internal CraftState instance for detailed information\n  current_state = env._current_state \n\n  # Ensure the primitive is a valid kind known to the world\n  if primitive not in current_state.world.cookbook.kinds:\n      return [] \n\n  # Check if the primitive is already in the inventory\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.init_dir # Agent's initial facing direction\n\n  impassable_kinds = current_state.world.non_grabbable_indices\n\n  # Define movement actions and their resulting directions and (dy, dx) changes.\n  # Direction mapping: 0=Up, 1=Right, 2=Down, 3=Left\n  movement_actions_map = {\n      ACTION_UP:    (0, -1, 0), # (resulting_direction, dy, dx)\n      ACTION_RIGHT: (1, 0, 1),\n      ACTION_DOWN:  (2, 1, 0),\n      ACTION_LEFT:  (3, 0, -1)\n  }\n\n  q = collections.deque()\n  # BFS state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  \n  # If MAX_COLLECT_STEPS is 0 or negative, no actions are allowed.\n  # If primitive is not already in inventory, it's impossible to collect.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # Initialize BFS queue with the starting state\n  q.append((start_y, start_x, start_dir, []))\n  # Visited set now tracks (position, direction) to allow for pathing through the same cell\n  # but facing a different direction, which is crucial for `ACTION_USE` success.\n  visited = {(start_y, start_x, start_dir)} \n\n  path_to_execute = None # Will store the sequence of actions including the final ACTION_USE\n\n  # --- BFS to find a path to a position and orientation suitable for collection ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Check if the primitive is directly in front of the agent at current (y,x,dir)\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Ensure facing coordinates are within bounds and check if the cell contains the primitive\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n          full_grid[facing_y, facing_x, primitive] > 0):\n          \n          # We found a path to a position and orientation where ACTION_USE should work.\n          candidate_path = path + [ACTION_USE]\n          \n          # This is an improvement: Only accept paths that are within MAX_COLLECT_STEPS.\n          # If a path is found, and it's shorter or equal to current best (or first found), store it.\n          # Since BFS finds shortest paths first, the first valid path found will be the shortest.\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              break # Path found and within limits, exit BFS\n          # Else, this path is too long, continue searching for a shorter one (if any exist)\n\n      # Explore neighbors (movement actions)\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          \n          # Prune BFS branches early if adding another step exceeds MAX_COLLECT_STEPS.\n          # This ensures we don't explore paths that are too long.\n          if len(path) + 1 > MAX_COLLECT_STEPS:\n              continue\n\n          # Check bounds for the next agent position\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the next cell is traversable (does not contain any impassable kind)\n          is_traversable = True\n          for k_idx in impassable_kinds:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n          \n          # Check if this (position, direction) state has been visited\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n  \n  # --- Execute the found path (if any) ---\n  if path_to_execute is None:\n      return [] # No path found within MAX_COLLECT_STEPS to collect the primitive\n\n  for action in path_to_execute:\n      actions_taken.append(action)\n      # No need to check MAX_COLLECT_STEPS here, as path_to_execute is guaranteed to be within limits\n      reward, done, _ = env.step(action)\n      current_state = env._current_state # Update state after the step\n\n      # If the goal is satisfied (primitive collected), we can stop early\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n  \n  # Final check: if the primitive was collected after executing the full path.\n  # This covers cases where the collection might happen on the very last step.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If we reached here, the full path was executed, but collection failed.\n      # This implies an issue with the environment or assumptions, as the BFS found a path.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:30:18.324859", "function_name": "collect", "function_body": "    # Action constants\n    DOWN = 0    # Move backward\n    UP = 1      # Move forward\n    LEFT = 2    # Turn left\n    RIGHT = 3   # Turn right\n    USE = 4     # Interact\n\n    # Direction constants (assuming 0=North, 1=East, 2=South, 3=West)\n    DIR_NORTH = 0\n    DIR_EAST = 1\n    DIR_SOUTH = 2\n    DIR_WEST = 3\n\n    # (dx, dy) for moving forward in each direction based on current facing direction\n    MOVE_FORWARD_DELTAS = {\n        DIR_NORTH: (0, -1), # North: -Y\n        DIR_EAST: (1, 0),   # East: +X\n        DIR_SOUTH: (0, 1),  # South: +Y\n        DIR_WEST: (-1, 0)   # West: -X\n    }\n\n    # (dx, dy) for moving backward in each direction based on current facing direction\n    MOVE_BACKWARD_DELTAS = {\n        DIR_NORTH: (0, 1),   # Backward from North: +Y\n        DIR_EAST: (-1, 0),   # Backward from East: -X\n        DIR_SOUTH: (0, -1),  # Backward from South: -Y\n        DIR_WEST: (1, 0)     # Backward from West: +X\n    }\n\n    # New direction after turning left\n    TURN_LEFT_DIR = {\n        DIR_NORTH: DIR_WEST,\n        DIR_EAST: DIR_NORTH,\n        DIR_SOUTH: DIR_EAST,\n        DIR_WEST: DIR_SOUTH\n    }\n\n    # New direction after turning right\n    TURN_RIGHT_DIR = {\n        DIR_NORTH: DIR_EAST,\n        DIR_EAST: DIR_SOUTH,\n        DIR_SOUTH: DIR_WEST,\n        DIR_WEST: DIR_NORTH\n    }\n\n    # Mapping from a (dx, dy) offset from agent_pos to target_pos to the required agent_dir\n    # E.g., if target is (0, -1) relative to agent, agent must face NORTH\n    REQUIRED_DIR_TO_FACE = {\n        (0, -1): DIR_NORTH, # Target is North of agent\n        (1, 0): DIR_EAST,   # Target is East of agent\n        (0, 1): DIR_SOUTH,  # Target is South of agent\n        (-1, 0): DIR_WEST   # Target is West of agent\n    }\n\n    current_state = env._current_state\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir\n    grid = current_state.grid\n    world = current_state.world\n\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n\n    # Determine if the primitive is grabbable (walk-over) or non-grabbable (requires USE)\n    is_grabbable = primitive in world.grabbable_indices\n\n    # Define impassable kinds for movement. Assume any non-grabbable item that is\n    # NOT the primitive itself is an obstacle for traversal.\n    impassable_kinds = set(world.non_grabbable_indices)\n    if primitive in impassable_kinds:\n        impassable_kinds.remove(primitive) # Agent can potentially occupy/pass through the primitive's cell if it's grabbable, or be adjacent to it for USE.\n    \n    def is_passable(x, y):\n        \"\"\"Checks if a given grid cell (x, y) is within bounds and not an obstacle.\"\"\"\n        if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n            return False # Out of bounds\n        for k_idx in impassable_kinds:\n            if grid[x, y, k_idx] > 0: # If cell contains an impassable kind\n                return False\n        return True\n\n    # 1. Find all locations of the primitive on the grid\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the grid\n\n    # BFS Setup for shortest path in (x, y, dir) state space\n    queue = [] # Using a Python list as a queue (less efficient than collections.deque but avoids extra import)\n    # Each state in the queue is a tuple: (current_x, current_y, current_direction, list_of_actions_taken)\n    queue.append((initial_pos[0], initial_pos[1], initial_dir, []))\n    \n    # Set to keep track of visited (x, y, dir) states to avoid cycles and redundant paths\n    visited = set()\n    visited.add((initial_pos[0], initial_pos[1], initial_dir))\n\n    best_path_actions = None # Will store the shortest sequence of actions\n\n    while queue:\n        cx, cy, cdir, path_actions = queue.pop(0) # Pop from the front of the list (BFS explores level by level)\n\n        # Goal check: Determine if the current state satisfies the collection goal\n        if is_grabbable:\n            # If the primitive is grabbable, the goal is to simply reach its location.\n            if (cx, cy) in primitive_locations:\n                best_path_actions = path_actions\n                break # Found the shortest path to a grabbable primitive\n        else: # non-grabbable\n            # If non-grabbable, the goal is to be adjacent to a primitive_location AND facing it,\n            # then perform a USE action.\n            \n            # Check all four cardinal neighbors relative to the agent's current position (cx, cy)\n            # to see if any of them contain the primitive.\n            for dx_adj_target, dy_adj_target in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # W, E, N, S offsets from agent\n                target_x_candidate = cx + dx_adj_target\n                target_y_candidate = cy + dy_adj_target\n                \n                # If this adjacent cell contains the primitive\n                if (target_x_candidate, target_y_candidate) in primitive_locations:\n                    # Calculate the direction the agent needs to be facing to use the primitive at this adjacent cell\n                    req_dir_to_face = REQUIRED_DIR_TO_FACE.get((dx_adj_target, dy_adj_target))\n                    \n                    # If the required direction is valid and the agent is currently facing it\n                    if req_dir_to_face is not None and cdir == req_dir_to_face:\n                        # We found a state where the agent is in position and facing correctly to USE the primitive\n                        best_path_actions = path_actions + [USE] # Add the USE action to the path\n                        break # Found the shortest path to collect a non-grabbable primitive\n            if best_path_actions:\n                break # Break the outer while loop if a solution path has been found\n\n        # Explore possible next states by applying each action type\n        \n        # 1. Try moving Forward (UP action)\n        ndx, ndy = MOVE_FORWARD_DELTAS[cdir] # Calculate new coordinates based on current direction\n        nx, ny = cx + ndx, cy + ndy\n        if is_passable(nx, ny) and (nx, ny, cdir) not in visited:\n            visited.add((nx, ny, cdir))\n            queue.append((nx, ny, cdir, path_actions + [UP]))\n\n        # 2. Try moving Backward (DOWN action)\n        ndx, ndy = MOVE_BACKWARD_DELTAS[cdir] # Calculate new coordinates\n        nx, ny = cx + ndx, cy + ndy\n        if is_passable(nx, ny) and (nx, ny, cdir) not in visited:\n            visited.add((nx, ny, cdir))\n            queue.append((nx, ny, cdir, path_actions + [DOWN]))\n        \n        # 3. Try turning Left (LEFT action)\n        n_dir_left = TURN_LEFT_DIR[cdir] # Calculate new direction\n        # Position remains the same, only direction changes\n        if (cx, cy, n_dir_left) not in visited:\n            visited.add((cx, cy, n_dir_left))\n            queue.append((cx, cy, n_dir_left, path_actions + [LEFT]))\n\n        # 4. Try turning Right (RIGHT action)\n        n_dir_right = TURN_RIGHT_DIR[cdir] # Calculate new direction\n        # Position remains the same\n        if (cx, cy, n_dir_right) not in visited:\n            visited.add((cx, cy, n_dir_right))\n            queue.append((cx, cy, n_dir_right, path_actions + [RIGHT]))\n\n    # If best_path_actions is still None after BFS, no path was found\n    if best_path_actions is None:\n        return []\n    else:\n        return best_path_actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:30:19.300546", "function_name": "collect", "function_body": "  actions_taken = []\n  \n  # Reset the environment to get initial state.\n  # This implies that `collect_v2` is expected to be called on a fresh environment\n  # for a new collection attempt.\n  _ = env.reset() \n\n  # Maximum number of steps to prevent infinite loops in complex or unsolvable scenarios.\n  MAX_STEPS_PER_PRIMITIVE = 200 # A reasonable limit for typical grid sizes\n  steps = 0\n\n  # Action constants as defined in CraftLab.action_specs\n  # DOWN->0, UP->1, LEFT->2, RIGHT->3, USE->4\n  DOWN_A = 0\n  UP_A = 1\n  LEFT_A = 2\n  RIGHT_A = 3\n  USE_A = 4\n\n  # Agent directions (common convention: 0=North, 1=East, 2=South, 3=West)\n  DIR_N = 0\n  DIR_E = 1\n  DIR_S = 2\n  DIR_W = 3\n\n  # Mapping (dx, dy) relative to current position to the direction an agent needs to face to interact with it.\n  # E.g., if an item is at (current_x, current_y - 1), it's North, so agent needs to face North (DIR_N).\n  DELTA_TO_FACING_DIR = {\n      (0, -1): DIR_N, # Item is North (Up)\n      (0, 1): DIR_S,  # Item is South (Down)\n      (1, 0): DIR_E,  # Item is East (Right)\n      (-1, 0): DIR_W, # Item is West (Left)\n  }\n\n  while True:\n    state = env._current_state # Access the underlying CraftState for detailed info\n\n    # 1. Check if the primitive is already collected\n    if state.inventory[primitive] > 0:\n      break # Goal achieved, stop collecting\n\n    # 2. Check for maximum steps to prevent infinite loops\n    if steps >= MAX_STEPS_PER_PRIMITIVE:\n      # print(f\"Warning: Max steps ({MAX_STEPS_PER_PRIMITIVE}) reached for primitive {env.cookbook.index.get(primitive)}. Returning partial path.\")\n      break # Give up after too many steps\n\n    current_x, current_y = state.pos\n    current_dir = state.dir\n    grid_data = state.grid # Access the current grid layout\n\n    action = None # Initialize action for the current step\n\n    # 3. Check if primitive is in a cardinal adjacent cell and determine action (turn or USE)\n    target_primitive_dx, target_primitive_dy = None, None\n    \n    # Iterate through potential cardinal neighbors (dx, dy)\n    # Order of preference: North, South, East, West.\n    cardinal_neighbor_deltas = [(0, -1), (0, 1), (1, 0), (-1, 0)] \n    \n    for dx, dy in cardinal_neighbor_deltas:\n        nx, ny = current_x + dx, current_y + dy\n\n        # Check bounds of the grid\n        if 0 <= nx < grid_data.shape[0] and 0 <= ny < grid_data.shape[1]:\n            # Check if the primitive is at this adjacent cell\n            if grid_data[nx, ny, primitive] == 1:\n                target_primitive_dx, target_primitive_dy = dx, dy\n                break # Found an adjacent primitive, prioritize this one\n    \n    if target_primitive_dx is not None:\n        # A primitive is found in an adjacent cardinal direction.\n        # Now, determine if we need to turn or can use it directly.\n        \n        required_facing_dir = DELTA_TO_FACING_DIR.get((target_primitive_dx, target_primitive_dy))\n\n        if required_facing_dir is not None:\n            if current_dir == required_facing_dir:\n                # Agent is already facing the primitive, so USE it\n                action = USE_A\n            else:\n                # Agent is not facing the primitive, need to turn.\n                # Calculate the shortest turn (1 step left/right, or 2 steps for 180 turn)\n                turn_diff = (required_facing_dir - current_dir + 4) % 4 # +4 to handle negative results of subtraction\n\n                if turn_diff == 1: # Turn right (e.g., from North to East)\n                    action = RIGHT_A\n                elif turn_diff == 3: # Turn left (e.g., from North to West)\n                    action = LEFT_A\n                else: # turn_diff == 2 (180 degree turn), either LEFT_A or RIGHT_A works\n                    action = LEFT_A # Arbitrarily pick left for 180 turn\n        else:\n            # This case should ideally not be reached if DELTA_TO_FACING_DIR is complete\n            # for all cardinal directions and an adjacent primitive was found.\n            # Fallback: if an adjacent primitive is found but cannot be faced for some reason,\n            # take a random move to try to resolve the situation.\n            action = np.random.choice([UP_A, DOWN_A, LEFT_A, RIGHT_A])\n    \n    # 4. If no action has been determined yet (primitive not immediately collectable):\n    #    Locate the primitive on the full grid and move towards it.\n    if action is None:\n        # Look for the primitive's location anywhere on the global grid\n        primitive_coords = np.argwhere(grid_data[:, :, primitive] == 1)\n\n        if primitive_coords.size > 0:\n            # Multiple instances might exist; find the closest one using Manhattan distance\n            min_dist = float('inf')\n            target_x, target_y = -1, -1\n\n            for px, py in primitive_coords:\n                dist = abs(px - current_x) + abs(py - current_y)\n                if dist < min_dist:\n                    min_dist = dist\n                    target_x, target_y = px, py\n            \n            # Determine the movement action to get closer to the target\n            dx_target = target_x - current_x\n            dy_target = target_y - current_y\n\n            if min_dist == 0:\n                # Agent is on the primitive, but it's not collected.\n                # This implies it might be non-collectable from under, or stuck.\n                # Take a random step to move off the item and re-evaluate.\n                action = np.random.choice([UP_A, DOWN_A, LEFT_A, RIGHT_A])\n            elif dx_target != 0:\n                # Prioritize horizontal movement if needed\n                action = RIGHT_A if dx_target > 0 else LEFT_A\n            elif dy_target != 0:\n                # If no horizontal movement needed, or after horizontal move,\n                # perform vertical movement\n                action = DOWN_A if dy_target > 0 else UP_A\n            else:\n                # Should not be reached if min_dist > 0 and (dx_target, dy_target) is not (0,0).\n                # Fallback to a random move in case of unexpected state.\n                action = np.random.choice([UP_A, DOWN_A, LEFT_A, RIGHT_A])\n        else:\n            # Primitive not found anywhere on the visible grid.\n            # Perform a random walk to explore and hopefully find it.\n            action = np.random.choice([UP_A, DOWN_A, LEFT_A, RIGHT_A])\n    \n    # Take the determined action and update the environment state\n    actions_taken.append(action)\n    # We only care about updating the internal state, so we discard reward, done, obs.\n    _, _, _ = env.step(action) \n    steps += 1\n\n  return actions_taken", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:31:53.240241", "function_name": "collect", "function_body": "  import collections\n\n  all_actions = []\n  max_total_steps = 500  # Max steps to prevent infinite loops\n\n  # Initial observations after environment reset\n  # env.reset() returns an observation dictionary\n  obs = env.reset()\n\n  # Check if the primitive is grabbable. If not, it cannot be 'collected' directly.\n  # We can access world via env.world from CraftLab.\n  # env.world.grabbable_indices is a set of int indices for entities that can be picked up\n  if primitive not in env.world.grabbable_indices:\n      # If the primitive is not directly grabbable, this function cannot collect it.\n      return []\n\n  for step_count in range(max_total_steps):\n      # 1. Check if the primitive is already collected\n      inventory = obs['features_dict']['inventory']\n      if inventory[primitive] > 0:\n          break  # Goal achieved, break loop\n\n      # 2. Get current state information\n      grid = obs['features_dict']['features_global']\n      H, W, _ = grid.shape  # H = rows, W = columns\n      \n      # Current agent position (row, col) from normalized coordinates\n      current_pos_normalized = obs['features_dict']['pos']\n      current_pos = (int(current_pos_normalized[0] * H), int(current_pos_normalized[1] * W))\n\n      # 3. Locate all instances of the primitive on the grid\n      primitive_locations = []\n      for r in range(H):\n          for c in range(W):\n              if grid[r, c, primitive] == 1:\n                  primitive_locations.append((r, c))\n\n      if not primitive_locations:\n          # Primitive not found on the grid and not in inventory. Cannot collect.\n          break # Exit loop, returning collected actions so far (likely empty)\n\n      # 4. Find the closest primitive location using Manhattan distance\n      def manhattan_distance(p1, p2):\n          return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n      target_primitive_loc = min(primitive_locations, key=lambda p: manhattan_distance(current_pos, p))\n\n      # 5. Pathfinding (BFS) to reach the target primitive's cell.\n      # The `USE` action in `CraftState` works if the agent is in the 3x3 neighborhood.\n      # Reaching the primitive's cell itself is a valid (and often shortest) way to be in range.\n      \n      queue = collections.deque([(current_pos, [])])  # (position: (r, c), path_actions: list)\n      visited = {current_pos}\n      path_to_target = None\n\n      while queue:\n          (r, c), path_actions = queue.popleft()\n\n          # If current position is the target primitive location, we found a path\n          if (r, c) == target_primitive_loc:\n              path_to_target = path_actions\n              break\n\n          # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n          # These action values are based on the problem's action_specs dict:\n          # DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3\n          # Corresponding (dr, dc)\n          ACTION_DR_DC = {\n              0: (1, 0),  # DOWN\n              1: (-1, 0), # UP\n              2: (0, -1), # LEFT\n              3: (0, 1)   # RIGHT\n          }\n\n          for action_val, (dr, dc) in ACTION_DR_DC.items():\n              nr, nc = r + dr, c + dc\n\n              # Check bounds and if already visited\n              if 0 <= nr < H and 0 <= nc < W and (nr, nc) not in visited:\n                  # Assuming all grid cells are traversable unless specified as obstacles.\n                  visited.add((nr, nc))\n                  queue.append(((nr, nc), path_actions + [action_val]))\n\n      if path_to_target is None:\n          # Cannot reach the primitive (e.g., blocked by terrain or unreachable)\n          break # Exit loop, cannot collect\n\n      # 6. Execute movement actions found by BFS\n      for action in path_to_target:\n          reward, done, obs = env.step(action)\n          all_actions.append(action)\n          if done:\n              return all_actions # Episode ended\n\n          # Check if collected *during* movement (unlikely for discrete items, but safe)\n          inventory = obs['features_dict']['inventory']\n          if inventory[primitive] > 0:\n              return all_actions # Collected already\n\n      # 7. Execute USE action after reaching the primitive's vicinity\n      # Agent should now be at target_primitive_loc or very close.\n      reward, done, obs = env.step(USE) # USE is action value 4\n      all_actions.append(USE)\n      if done:\n          return all_actions # Episode ended\n\n      # Re-check inventory after USE action\n      inventory = obs['features_dict']['inventory']\n      if inventory[primitive] > 0:\n          break  # Primitive collected, break outer loop\n\n  return all_actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:31:53.309352", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Helper functions defined locally to fit the \"only return code inside the function\" constraint.\n    # In a real module, these would typically be at module level.\n\n    # _DR and _DC map directions (0:North, 1:East, 2:South, 3:West) to row/column changes.\n    _DR = [-1, 0, 1, 0]  # Change in row for N, E, S, W\n    _DC = [0, 1, 0, -1]  # Change in col for N, E, S, W\n\n    def _is_valid(r, c, height, width):\n        \"\"\"Checks if a given (row, col) coordinate is within grid bounds.\"\"\"\n        return 0 <= r < height and 0 <= c < width\n\n    def _get_front_coord(r, c, direction):\n        \"\"\"Calculates the coordinates of the cell directly in front of (r, c) facing 'direction'.\"\"\"\n        return (r + _DR[direction], c + _DC[direction])\n\n    def _is_traversable(r, c, grid, non_traversable_kinds):\n        \"\"\"\n        Checks if a cell (r, c) is traversable by the agent.\n        A cell is considered non-traversable if it contains any 'non_traversable_kinds'.\n        \"\"\"\n        # Iterate over all non-traversable kinds to see if any are present at (r, c)\n        for k_idx in non_traversable_kinds:\n            if grid[r, c, k_idx] > 0:\n                return False\n        return True\n\n    # Get action mappings from the environment's action specifications.\n    action_map = env.action_specs()\n    MOVE_FORWARD = action_map[\"UP\"]\n    MOVE_BACKWARD = action_map[\"DOWN\"]\n    TURN_LEFT = action_map[\"LEFT\"]\n    TURN_RIGHT = action_map[\"RIGHT\"]\n    USE_ACTION = action_map[\"USE\"]\n\n    # Get the current state information directly from the CraftState instance.\n    state = env._current_state\n    initial_pos = state.pos  # tuple (row, col)\n    initial_dir = state.dir  # int (0:N, 1:E, 2:S, 3:W)\n    grid = state.grid        # numpy.ndarray (HEIGHT, WIDTH, N_KINDS)\n    inventory = state.inventory # numpy.ndarray (N_KINDS,)\n\n    # Check if the primitive is already in the agent's inventory.\n    if inventory[primitive] > 0:\n        return [] # Already collected, no actions needed.\n\n    # Determine grid dimensions.\n    HEIGHT, WIDTH, N_KINDS = grid.shape\n\n    # Get the set of indices for entities that cannot be walked through.\n    # This information is typically held by the CraftWorld instance.\n    non_traversable_kinds = env.world.non_grabbable_indices \n\n    # Initialize a queue for Breadth-First Search (BFS).\n    # Each item in the queue is a tuple: ((row, col), direction, [list_of_actions_taken_to_reach_this_state])\n    q = collections.deque()\n    q.append((initial_pos, initial_dir, []))\n\n    # Initialize a set to keep track of visited states to prevent cycles and redundant exploration.\n    # A state is defined by (position_tuple, direction_int).\n    visited = set()\n    visited.add((initial_pos, initial_dir))\n\n    # Perform BFS\n    while q:\n        current_pos, current_dir, actions_so_far = q.popleft()\n        r, c = current_pos\n\n        # --- Check if the primitive can be collected from the current state ---\n        # 1. Check the cell directly in front of the agent.\n        front_r, front_c = _get_front_coord(r, c, current_dir)\n        if _is_valid(front_r, front_c, HEIGHT, WIDTH) and grid[front_r, front_c, primitive] > 0:\n            # Primitive found in front; add USE action and return the path.\n            return actions_so_far + [USE_ACTION]\n        \n        # 2. Check the current cell (if the primitive can be picked up by standing on it).\n        if grid[r, c, primitive] > 0:\n            # Primitive found on the current cell; add USE action and return the path.\n            return actions_so_far + [USE_ACTION]\n\n        # --- Explore possible next states (movements and turns) ---\n\n        # Try moving Forward\n        next_r_fwd, next_c_fwd = _get_front_coord(r, c, current_dir)\n        if _is_valid(next_r_fwd, next_c_fwd, HEIGHT, WIDTH) and \\\n           _is_traversable(next_r_fwd, next_c_fwd, grid, non_traversable_kinds) and \\\n           ((next_r_fwd, next_c_fwd), current_dir) not in visited:\n            visited.add(((next_r_fwd, next_c_fwd), current_dir))\n            q.append(((next_r_fwd, next_c_fwd), current_dir, actions_so_far + [MOVE_FORWARD]))\n\n        # Try moving Backward\n        # To move backward, it's equivalent to moving forward after a 180-degree turn relative to the grid.\n        # The agent's direction (current_dir) does not change when moving backward.\n        back_r, back_c = _get_front_coord(r, c, (current_dir + 2) % 4) # Calculate coords behind agent\n        if _is_valid(back_r, back_c, HEIGHT, WIDTH) and \\\n           _is_traversable(back_r, back_c, grid, non_traversable_kinds) and \\\n           ((back_r, back_c), current_dir) not in visited:\n            visited.add(((back_r, back_c), current_dir))\n            q.append(((back_r, back_c), current_dir, actions_so_far + [MOVE_BACKWARD]))\n\n        # Try turning Left\n        next_dir_left = (current_dir - 1 + 4) % 4 # Ensure direction stays within 0-3\n        if ((r, c), next_dir_left) not in visited:\n            visited.add(((r, c), next_dir_left))\n            q.append(((r, c), next_dir_left, actions_so_far + [TURN_LEFT]))\n\n        # Try turning Right\n        next_dir_right = (current_dir + 1) % 4 # Ensure direction stays within 0-3\n        if ((r, c), next_dir_right) not in visited:\n            visited.add(((r, c), next_dir_right))\n            q.append(((r, c), next_dir_right, actions_so_far + [TURN_RIGHT]))\n\n    # If the BFS completes and no path to collect the primitive is found.\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:32:57.380022", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants for clarity (local to this function)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  ACTION_DR_DC = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  all_actions = []\n  max_total_steps = 500  # Max steps to prevent infinite loops\n\n  # Initial observations after environment reset\n  obs = env.reset()\n\n  # Helper to perform a step and update the actions list, returning only the done status\n  # and updating the 'obs' variable from the outer scope.\n  def _perform_action_and_update_state(action):\n      nonlocal obs  # Declare obs as nonlocal to allow modification of the outer 'obs'\n      reward, done, new_obs = env.step(action)\n      all_actions.append(action)\n      obs = new_obs  # Update the obs variable in the outer scope\n      return done\n\n  # Check if the primitive is grabbable. If not, it cannot be 'collected' directly.\n  if primitive not in env.world.grabbable_indices:\n      return []\n\n  for step_count in range(max_total_steps):\n      # 1. Check if the primitive is already collected\n      inventory = obs['features_dict']['inventory']\n      if inventory[primitive] > 0:\n          break  # Goal achieved, break loop\n\n      # 2. Get current state information\n      grid = obs['features_dict']['features_global']\n      H, W, _ = grid.shape  # H = rows, W = columns\n      \n      # Current agent position (row, col) from normalized coordinates\n      current_pos_normalized = obs['features_dict']['pos']\n      current_pos = (int(current_pos_normalized[0] * H), int(current_pos_normalized[1] * W))\n\n      # 3. Locate all instances of the primitive on the grid\n      primitive_locations = []\n      for r in range(H):\n          for c in range(W):\n              if grid[r, c, primitive] == 1:\n                  primitive_locations.append((r, c))\n\n      if not primitive_locations:\n          # Primitive not found on the grid and not in inventory. Cannot collect.\n          break \n\n      # 4. Determine valid target cells for the 'USE' action.\n      # An agent can 'USE' an object if it's in its 3x3 neighborhood (including self).\n      target_cells_for_use = set()\n      for pr, pc in primitive_locations:\n          for dr_offset in [-1, 0, 1]:\n              for dc_offset in [-1, 0, 1]:\n                  nr, nc = pr + dr_offset, pc + dc_offset\n                  if 0 <= nr < H and 0 <= nc < W:\n                      target_cells_for_use.add((nr, nc))\n      \n      # 5. Check if agent is already in a position to USE the primitive.\n      if current_pos in target_cells_for_use:\n          path_to_target_cell = []  # No movement needed\n      else:\n          # 6. Pathfinding (BFS) to reach any of the target cells.\n          queue = collections.deque([(current_pos, [])])  # (position: (r, c), path_actions: list)\n          visited = {current_pos}\n          path_to_target_cell = None\n\n          while queue:\n              (r, c), path_actions = queue.popleft()\n\n              # If current position is one of the target cells, we found a path\n              if (r, c) in target_cells_for_use:\n                  path_to_target_cell = path_actions\n                  break\n\n              # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n              for action_val, (dr, dc) in ACTION_DR_DC.items():\n                  nr, nc = r + dr, c + dc\n\n                  # Check bounds and if already visited\n                  if 0 <= nr < H and 0 <= nc < W and (nr, nc) not in visited:\n                      # Assuming all grid cells are traversable unless specified as obstacles.\n                      visited.add((nr, nc))\n                      queue.append(((nr, nc), path_actions + [action_val]))\n\n          if path_to_target_cell is None:\n              # Cannot reach any USE-able cell for the primitive.\n              break  # Exit loop, cannot collect\n\n      # 7. Execute movement actions found by BFS\n      for action in path_to_target_cell:\n          done = _perform_action_and_update_state(action)\n          if done:\n              return all_actions # Episode ended\n\n          # Check if collected *during* movement (unlikely for discrete items, but safe)\n          inventory = obs['features_dict']['inventory']\n          if inventory[primitive] > 0:\n              return all_actions # Collected already\n\n      # 8. Execute USE action after reaching a target cell's vicinity\n      done = _perform_action_and_update_state(USE)\n      if done:\n          return all_actions # Episode ended\n\n      # Re-check inventory after USE action\n      inventory = obs['features_dict']['inventory']\n      if inventory[primitive] > 0:\n          break  # Primitive collected, break outer loop\n\n  return all_actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:32:58.387709", "function_name": "collect", "function_body": "  import collections\n\n  # Constants for actions based on CraftLab.action_specs\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  all_actions = []\n  max_total_steps = 500\n\n  obs = env.reset()\n\n  # Check if the primitive is grabbable. If not, it cannot be 'collected' directly.\n  # We can access world via env.world from CraftLab.\n  # env.world.grabbable_indices is a set of int indices for entities that can be picked up\n  if primitive not in env.world.grabbable_indices:\n      # If the primitive is not directly grabbable, this function cannot collect it.\n      # It implies it might be an environment feature (like water) or needs crafting.\n      return []\n\n  for step_count in range(max_total_steps):\n      # 1. Check if the primitive is already collected\n      inventory = obs['features_dict']['inventory']\n      if inventory[primitive] > 0:\n          break  # Goal achieved, break loop\n\n      # 2. Get current state information\n      grid = obs['features_dict']['features_global']\n      H, W, n_kinds = grid.shape  # H = rows, W = columns, n_kinds for iterating over grid contents\n      \n      # Current agent position (row, col) from normalized coordinates\n      current_pos_normalized = obs['features_dict']['pos']\n      current_pos = (int(current_pos_normalized[0] * H), int(current_pos_normalized[1] * W))\n\n      # 3. Identify obstacles: cells containing any non-grabbable entity (like water, stone)\n      # These cells are generally not traversable by the agent.\n      obstacles = set()\n      for r in range(H):\n          for c in range(W):\n              is_obstacle_cell = False\n              # Check all kinds present at (r,c)\n              for k_idx in range(n_kinds):\n                  if grid[r, c, k_idx] == 1 and k_idx in env.world.non_grabbable_indices:\n                      is_obstacle_cell = True\n                      break\n              if is_obstacle_cell:\n                  obstacles.add((r, c))\n      \n      # The agent's current position should not be considered an obstacle for itself for BFS starting point\n      if current_pos in obstacles:\n          # This should ideally not happen if environment is set up well, but defensive.\n          # If agent starts on an obstacle, it cannot move.\n          return []\n\n\n      # 4. Locate all instances of the primitive on the grid\n      primitive_locations = []\n      for r in range(H):\n          for c in range(W):\n              if grid[r, c, primitive] == 1:\n                  primitive_locations.append((r, c))\n\n      if not primitive_locations:\n          # Primitive not found on the grid and not in inventory. Cannot collect.\n          break # Exit loop, returning collected actions so far (likely empty)\n\n      # 5. Determine valid \"agent target positions\" for 'USE' action\n      # A 'USE' action is effective if the agent is within a 3x3 neighborhood of the item.\n      # So, we find all traversable cells (not in 'obstacles') from which 'USE' could be effective.\n      target_agent_positions_for_use = set()\n      for prim_r, prim_c in primitive_locations:\n          # Iterate over the 3x3 neighborhood around the primitive's location\n          for dr_use in [-1, 0, 1]:\n              for dc_use in [-1, 0, 1]:\n                  potential_agent_r, potential_agent_c = prim_r + dr_use, prim_c + dc_use\n                  \n                  # Check bounds\n                  if 0 <= potential_agent_r < H and 0 <= potential_agent_c < W:\n                      # An agent can stand here IF this cell is traversable (not an obstacle)\n                      if (potential_agent_r, potential_agent_c) not in obstacles:\n                          target_agent_positions_for_use.add((potential_agent_r, potential_agent_c))\n\n      if not target_agent_positions_for_use:\n          # No safe or reachable spots from which to 'USE' the primitive\n          break\n\n      # 6. Pathfinding (BFS) to reach the closest valid agent target position.\n      queue = collections.deque([(current_pos, [])])  # (position: (r, c), path_actions: list)\n      visited = {current_pos}\n      path_to_target = None\n\n      ACTION_DR_DC = {\n          DOWN: (1, 0),\n          UP: (-1, 0),\n          LEFT: (0, -1),\n          RIGHT: (0, 1)\n      }\n\n      while queue:\n          (r, c), path_actions = queue.popleft()\n\n          # If current position is one of the valid 'USE' positions, we found a path\n          if (r, c) in target_agent_positions_for_use:\n              path_to_target = path_actions\n              break\n\n          # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n          for action_val, (dr, dc) in ACTION_DR_DC.items():\n              nr, nc = r + dr, c + dc\n\n              # Check bounds, if already visited, and if the cell is an obstacle\n              if 0 <= nr < H and 0 <= nc < W and (nr, nc) not in visited:\n                  if (nr, nc) not in obstacles: # Only add to queue if it's traversable\n                      visited.add((nr, nc))\n                      queue.append(((nr, nc), path_actions + [action_val]))\n\n      if path_to_target is None:\n          # Cannot reach any valid 'USE' position\n          break # Exit loop, cannot collect\n\n      # 7. Execute movement actions found by BFS\n      for action in path_to_target:\n          reward, done, obs = env.step(action)\n          all_actions.append(action)\n          if done:\n              return all_actions # Episode ended prematurely\n\n          # Check if collected *during* movement (e.g., if agent moved onto the item, though unlikely for 'USE')\n          inventory = obs['features_dict']['inventory']\n          if inventory[primitive] > 0:\n              return all_actions # Collected already\n\n      # 8. After movement, execute USE action.\n      # The agent should now be at `final_target_pos` (a cell from which USE is effective).\n      reward, done, obs = env.step(USE)\n      all_actions.append(USE)\n      if done:\n          return all_actions # Episode ended prematurely\n\n      # Re-check inventory after USE action\n      inventory = obs['features_dict']['inventory']\n      if inventory[primitive] > 0:\n          break  # Primitive collected, break outer loop\n\n  return all_actions", "island_id": 1, "scores": {"3": 0.0}}
