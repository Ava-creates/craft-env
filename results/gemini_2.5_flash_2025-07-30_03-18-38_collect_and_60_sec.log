{"timestamp": "2025-07-30T09:02:05.806706", "function_name": "collect", "function_body": "    import collections\n\n    # Constants for actions based on CraftLab.action_specs\n    # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Mapping of (dx, dy) movement deltas to corresponding action integers\n    DELTAS_TO_ACTIONS = {\n        (-1, 0): LEFT,  # Moving left changes x by -1\n        (1, 0): RIGHT,  # Moving right changes x by 1\n        (0, -1): UP,    # Moving up changes y by -1\n        (0, 1): DOWN,   # Moving down changes y by 1\n    }\n\n    def _is_primitive_in_3x3_neighborhood(primitive_idx, grid, pos):\n        \"\"\"\n        Helper function to check if the specified primitive is present\n        in the 3x3 neighborhood (including the current cell) around `pos`.\n        This mimics the logic of CraftState.next_to without needing to\n        instantiate a CraftState object.\n        \"\"\"\n        x, y = pos\n        WIDTH, HEIGHT, _ = grid.shape # Get grid dimensions\n\n        # Iterate through the 3x3 neighborhood around (x, y)\n        for dx_3x3 in [-1, 0, 1]:\n            for dy_3x3 in [-1, 0, 1]:\n                nx, ny = x + dx_3x3, y + dy_3x3\n                # Check boundary conditions for the neighbor cell\n                if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n                    # Check if the primitive_idx layer at (nx, ny) has a count greater than 0\n                    if grid[nx, ny, primitive_idx] > 0:\n                        return True # Primitive found in neighborhood\n        return False # Primitive not found in neighborhood\n\n    # Get the current state from the CraftLab environment\n    current_state = env._current_state\n\n    # 1. Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # Get initial grid layout, agent's starting position, and grid dimensions\n    grid = current_state.grid\n    start_pos = current_state.pos\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # Initialize BFS (Breadth-First Search)\n    # The queue stores tuples: (current_position, list_of_actions_to_reach_here)\n    q = collections.deque([(start_pos, [])])\n    # The 'visited' set keeps track of positions already explored to prevent cycles\n    visited = {start_pos}\n\n    # BFS loop\n    while q:\n        current_pos, current_path = q.popleft()\n\n        # 2. Check if the primitive can be collected from the current_pos\n        # This means checking if the primitive is in the 3x3 neighborhood\n        if _is_primitive_in_3x3_neighborhood(primitive, grid, current_pos):\n            # If collectable, append the 'USE' action to the current path and return it\n            return current_path + [USE]\n\n        # 3. Explore neighboring cells (4-connectivity: UP, DOWN, LEFT, RIGHT)\n        # These are relative movements from the current position\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (left, right, up, down)\n            next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n            next_pos = (next_x, next_y)\n\n            # Check boundary conditions: ensure the next position is within the grid\n            if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                continue # Skip if out of bounds\n\n            # Check if this position has already been visited during the BFS\n            if next_pos not in visited:\n                visited.add(next_pos) # Mark as visited\n                # Determine the action needed to move to next_pos\n                action_to_take = DELTAS_TO_ACTIONS[(dx, dy)]\n                # Add the next position and its path to the queue\n                q.append((next_pos, current_path + [action_to_take]))\n\n    # 4. If the BFS completes and no path to the primitive is found\n    return [] # Return an empty list of actions, indicating the primitive is not reachable", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:02:06.786036", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Constants for actions (from action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map action to (dr, dc) movement vector\n  ACTION_TO_MOVE_VECTOR = {\n      UP: (-1, 0),    # Moves North\n      DOWN: (1, 0),   # Moves South\n      LEFT: (0, -1),  # Moves West\n      RIGHT: (0, 1),  # Moves East\n  }\n\n  # Map action to resulting agent direction (0:N, 1:E, 2:S, 3:W)\n  ACTION_TO_DIR = {\n      UP: 0,      # Faces North\n      RIGHT: 1,   # Faces East\n      DOWN: 2,    # Faces South\n      LEFT: 3,    # Faces West\n  }\n\n  # Map direction (0:N, 1:E, 2:S, 3:W) to (dr, dc) vector\n  DIR_TO_VECTOR = {\n      0: (-1, 0),  # North\n      1: (0, 1),   # East\n      2: (1, 0),   # South\n      3: (0, -1),  # West\n  }\n\n\n  all_actions = []\n\n  # Initial check if primitive is already collected\n  obs = env.observations()\n  current_inventory = obs['features_dict']['inventory']\n  if current_inventory[primitive] > 0:\n    return []\n\n  # Use the internal CraftState for current game state information\n  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  H, W, _ = grid.shape # Grid dimensions\n\n  # Define what constitutes an impassable cell for pathfinding.\n  # Assume entities in env.world.environment are impassable walls/terrain.\n  impassable_kinds = env.world.environment\n  \n  def is_walkable(r: int, c: int) -> bool:\n    \"\"\"Checks if a cell (r, c) is within bounds and walkable.\"\"\"\n    if not (0 <= r < H and 0 <= c < W):\n      return False\n    \n    # Cannot walk onto the primitive itself (we want to be adjacent to it for USE)\n    if grid[r, c, primitive] == 1:\n      return False\n    \n    # Cannot walk onto any object considered an \"environment\" wall/block\n    for kind_idx in impassable_kinds:\n      if grid[r, c, kind_idx] == 1:\n        return False\n        \n    return True\n\n  # 1. Identify all potential target states (adjacent cell + required facing direction)\n  # A target state is (row, col, facing_direction) where (row, col) is adjacent to the primitive\n  # and facing_direction points towards the primitive.\n  target_states = set()\n  \n  # Find all locations of the primitive on the grid\n  primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n\n  for pr, pc in primitive_locations:\n    # Check the four cells adjacent to the primitive location (pr, pc)\n    for dr_adj, dc_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # N, S, W, E relative to primitive\n      adj_r, adj_c = pr + dr_adj, pc + dc_adj\n      \n      if is_walkable(adj_r, adj_c):\n        # Calculate the vector from the adjacent cell to the primitive\n        facing_vector = (pr - adj_r, pc - adj_c)\n        required_dir = None\n        \n        # Determine the agent's required direction index (0:N, 1:E, 2:S, 3:W)\n        for d_idx, vec in DIR_TO_VECTOR.items():\n          if vec == facing_vector:\n            required_dir = d_idx\n            break\n        \n        if required_dir is not None:\n          target_states.add((adj_r, adj_c, required_dir))\n\n  if not target_states:\n    # No primitive found or no reachable adjacent spots\n    return []\n\n  # 2. Perform Breadth-First Search (BFS) to find the shortest path to any target state.\n  # BFS state: ((row, col, direction), [actions_taken])\n  q = collections.deque([((initial_pos[0], initial_pos[1], initial_dir), [])])\n  visited = {(initial_pos[0], initial_pos[1], initial_dir)}\n\n  path_to_primitive_location = None\n\n  while q:\n    (r, c, d), path = q.popleft()\n\n    # If the current state is one of our target states, we found the path\n    if (r, c, d) in target_states:\n      path_to_primitive_location = path\n      break\n\n    # Explore possible movement actions\n    for action, move_vec in ACTION_TO_MOVE_VECTOR.items():\n      next_r, next_c = r + move_vec[0], c + move_vec[1]\n      next_d = ACTION_TO_DIR[action] # Agent's new direction after this action\n\n      if is_walkable(next_r, next_c):\n        if (next_r, next_c, next_d) not in visited:\n          visited.add((next_r, next_c, next_d))\n          q.append(((next_r, next_c, next_d), path + [action]))\n\n  if path_to_primitive_location is None:\n    # No path found to any of the primitive's adjacent locations\n    return []\n\n  # 3. Execute the found path and then perform the USE action\n  for action in path_to_primitive_location:\n    _reward, _done, _ = env.step(action)\n    all_actions.append(action)\n    \n    # Check if goal is satisfied after each step (unlikely for movement, but good practice)\n    current_inventory = env.observations()['features_dict']['inventory']\n    if current_inventory[primitive] > 0:\n      return all_actions\n\n  # After reaching the correct position and facing the primitive, perform USE\n  _reward, _done, _ = env.step(USE)\n  all_actions.append(USE)\n\n  # Final check if the primitive was collected\n  current_inventory = env.observations()['features_dict']['inventory']\n  if current_inventory[primitive] > 0:\n    return all_actions\n  else:\n    # If for some reason the USE action didn't result in collection (e.g., item already gone,\n    # or specific interaction rules not fully captured by this logic), return empty list.\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:03:30.510076", "function_name": "collect", "function_body": "    action_map = env.action_specs()\n    ACTION_UP = action_map[\"UP\"]\n    ACTION_DOWN = action_map[\"DOWN\"]\n    ACTION_LEFT = action_map[\"LEFT\"]\n    ACTION_RIGHT = action_map[\"RIGHT\"]\n    ACTION_USE = action_map[\"USE\"]\n\n    DELTAS = {\n        ACTION_UP: (-1, 0),\n        ACTION_DOWN: (1, 0),\n        ACTION_LEFT: (0, -1),\n        ACTION_RIGHT: (0, 1),\n    }\n\n    current_state = env._current_state\n    grid = current_state.grid\n    grid_h, grid_w, _ = grid.shape\n    start_pos = current_state.pos\n\n    world = env.world  # Get CraftWorld instance\n\n    # Define blocking kinds: these are entities that the agent cannot walk through.\n    # This includes all non-grabbable environment items and workshop locations.\n    # We assume the agent needs to stand *adjacent* to a primitive or workshop\n    # to interact with it using the USE action, not on the same cell.\n    blocking_kinds = set(world.environment)  # All non-grabbable entities\n    blocking_kinds.update(world.workshop_indices)  # Workshops are typically not traversable\n\n    def is_traversable_path_cell(r, c, grid, blocking_kinds_set, primitive_kind):\n        \"\"\"\n        Checks if a given grid cell (r, c) is traversable for pathfinding.\n        A cell is not traversable if it's out of bounds, contains the target primitive\n        (as we need to be adjacent, not on it), or contains any defined blocking entity.\n        \"\"\"\n        if not (0 <= r < grid_h and 0 <= c < grid_w):\n            return False  # Out of bounds\n\n        # If the cell contains the primitive we are looking for, it's not a path cell,\n        # but a target cell (for adjacency). So, we cannot walk *through* it.\n        if grid[r, c, primitive_kind] > 0:\n            return False\n\n        # Check if the cell contains any other blocking entity\n        for k_idx in range(grid.shape[2]):  # Iterate through all possible kinds\n            if grid[r, c, k_idx] > 0 and k_idx in blocking_kinds_set:\n                return False  # Contains a blocking entity\n        return True\n\n    # BFS Initialization\n    q = collections.deque([(start_pos, [])])  # (current_position (r, c), path_actions_list)\n    visited = {start_pos}\n\n    while q:\n        curr_pos, curr_path = q.popleft()\n        r, c = curr_pos\n\n        # Check if the current position is adjacent to the primitive\n        is_adjacent_to_primitive = False\n        for dr in [-1, 0, 1]:\n            for dc in [-1, 0, 1]:\n                if dr == 0 and dc == 0:\n                    continue  # Don't check the current cell itself\n                nr, nc = r + dr, c + dc\n                # Check if neighbor is within bounds and contains the primitive\n                if 0 <= nr < grid_h and 0 <= nc < grid_w and grid[nr, nc, primitive] > 0:\n                    is_adjacent_to_primitive = True\n                    break\n            if is_adjacent_to_primitive:\n                break\n\n        if is_adjacent_to_primitive:\n            # Found a position from which the primitive can be 'USED'.\n            # Add the USE action to the path and return.\n            return curr_path + [ACTION_USE]\n\n        # Explore neighbors\n        for action, delta in DELTAS.items():\n            dr, dc = delta\n            next_r, next_c = r + dr, c + dc\n            next_pos = (next_r, next_c)\n\n            # Check if the next position is within bounds, not visited, and traversable\n            if next_pos not in visited and is_traversable_path_cell(next_r, next_c, grid, blocking_kinds, primitive):\n                visited.add(next_pos)\n                q.append((next_pos, curr_path + [action]))\n\n    # If the queue becomes empty and no path is found (e.g., primitive is unreachable or doesn't exist)\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:03:31.578655", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action constants based on CraftLab.action_specs()\n  MOVE_DOWN = 0\n  MOVE_UP = 1\n  MOVE_LEFT = 2\n  MOVE_RIGHT = 3\n  ACTION_USE = 4\n\n  # Define direction constants (matching CraftState's internal representation)\n  # N=0, E=1, S=2, W=3\n  DIR_NORTH = 0  # Represents (row-1, col)\n  DIR_EAST = 1   # Represents (row, col+1)\n  DIR_SOUTH = 2  # Represents (row+1, col)\n  DIR_WEST = 3   # Represents (row, col-1)\n\n  # Mapping from a direction to its corresponding (delta_row, delta_col)\n  DIR_DELTAS = {\n      DIR_NORTH: (-1, 0),\n      DIR_EAST: (0, 1),\n      DIR_SOUTH: (1, 0),\n      DIR_WEST: (0, -1),\n  }\n\n  # Mapping from a movement action to the resulting agent direction\n  ACTION_TO_DIR = {\n      MOVE_UP: DIR_NORTH,\n      MOVE_RIGHT: DIR_EAST,\n      MOVE_DOWN: DIR_SOUTH,\n      MOVE_LEFT: DIR_WEST,\n  }\n\n  # List of all possible movement actions and their corresponding (dr, dc)\n  # Used for iterating through neighbors in BFS\n  MOVE_ACTIONS_AND_DELTAS = [\n      (MOVE_UP, (-1, 0)),\n      (MOVE_DOWN, (1, 0)),\n      (MOVE_LEFT, (0, -1)),\n      (MOVE_RIGHT, (0, 1)),\n  ]\n\n  # Get current state information from the environment\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos  # (row, col)\n  current_dir = current_state.dir  # 0, 1, 2, or 3 (N, E, S, W)\n\n  grid_height, grid_width, _ = grid.shape\n\n  # 1. Locate all positions on the grid where the primitive exists\n  primitive_locations = []\n  for r in range(grid_height):\n    for c in range(grid_width):\n      if grid[r, c, primitive] > 0:  # Check if the primitive (kind) is present at this cell\n        primitive_locations.append((r, c))\n\n  if not primitive_locations:\n    # If the primitive is not found anywhere on the grid, it cannot be collected.\n    return []\n\n  # 2. Use Breadth-First Search (BFS) to find the shortest path to a cell\n  #    from which the primitive can be collected.\n  #    A state in the queue is (row, col, current_direction, list_of_actions_to_reach_this_state)\n  q = deque()\n  q.append((current_pos[0], current_pos[1], current_dir, []))\n\n  # Keep track of visited states to avoid cycles and redundant processing.\n  # A state is defined by (row, col, current_direction).\n  visited = set([(current_pos[0], current_pos[1], current_dir)])\n\n  while q:\n    r, c, d, path = q.popleft()\n\n    # Check if the current position (r, c) is adjacent to any primitive location\n    # AND the agent is facing that primitive correctly.\n    for pr, pc in primitive_locations:\n      # Calculate the delta from the agent's current position to the primitive's position\n      delta_r, delta_c = pr - r, pc - c\n\n      # Check if the primitive is in an adjacent cell (Manhattan distance 1)\n      if abs(delta_r) + abs(delta_c) == 1:\n        # Check if the agent's current facing direction (d) points to the primitive\n        if (delta_r, delta_c) == DIR_DELTAS[d]:\n          # Found a valid path! The agent is at an adjacent cell and facing the primitive.\n          # Append the USE action and return the complete sequence of actions.\n          return path + [ACTION_USE]\n\n    # Explore valid neighboring cells (move actions)\n    for move_action, (dr, dc) in MOVE_ACTIONS_AND_DELTAS:\n      new_r, new_c = r + dr, c + dc\n      new_d = ACTION_TO_DIR[move_action]  # The agent's new direction after this move\n\n      # Check if the new position is within grid boundaries\n      if not (0 <= new_r < grid_height and 0 <= new_c < grid_width):\n        continue\n\n      # Check if this state (position and direction) has already been visited\n      if (new_r, new_c, new_d) in visited:\n        continue\n\n      # If not visited, add the new state to the queue and mark as visited\n      visited.add((new_r, new_c, new_d))\n      q.append((new_r, new_c, new_d, path + [move_action]))\n\n  # If the BFS completes and no path to collect the primitive is found, return an empty list.\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:04:51.238068", "function_name": "collect", "function_body": "    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    current_pos = tuple(obs['features_dict']['pos'])  # (r, c)\n    inventory = obs['features_dict']['inventory']\n\n    # 1. Check if primitive is already collected\n    if inventory[primitive] > 0:\n        return []\n\n    world = env.world\n    height, width, _ = grid.shape\n\n    is_grabbable = primitive in world.grabbable_indices\n    is_non_grabbable = primitive in world.non_grabbable_indices\n\n    # Get action mappings from the environment\n    action_map = env.action_specs()\n    _DOWN = action_map['DOWN']\n    _UP = action_map['UP']\n    _LEFT = action_map['LEFT']\n    _RIGHT = action_map['RIGHT']\n    _USE = action_map['USE']\n\n    # Direction deltas (dr, dc, action_id) for movement\n    _MOVES = [\n        (1, 0, _DOWN),\n        (-1, 0, _UP),\n        (0, -1, _LEFT),\n        (0, 1, _RIGHT),\n    ]\n\n    # Define a helper to check if a cell is traversable\n    def is_traversable(r, c):\n        if not (0 <= r < height and 0 <= c < width):\n            return False\n        # Check if the cell contains non-traversable items like water or stone.\n        # These are generally considered blockers. Other non-grabbables (e.g., workbench) are often walkable.\n        if grid[r, c, world.water_index] > 0 or grid[r, c, world.stone_index] > 0:\n            return False\n        return True\n\n    # BFS Initialization\n    # Using collections.deque (assumed to be available from module-level imports)\n    q = collections.deque([(current_pos, [])])  # (pos, path_actions)\n    visited = {current_pos}\n\n    while q:\n        (r, c), path = q.popleft()\n\n        # Check if current position (r, c) allows collecting the primitive\n        if is_grabbable:\n            # If the current cell contains the grabbable primitive, we are there.\n            if grid[r, c, primitive] > 0:\n                return path + [_USE]  # Path to the item + USE action\n        elif is_non_grabbable:\n            # For non-grabbable items, we need to be adjacent to them to USE.\n            # Check the 4-directional neighborhood around the current position for the primitive.\n            for dr_adj, dc_adj, _ in _MOVES:\n                nr_adj, nc_adj = r + dr_adj, c + dc_adj\n                if 0 <= nr_adj < height and 0 <= nc_adj < width and grid[nr_adj, nc_adj, primitive] > 0:\n                    # Found a non-grabbable primitive next to the current position (r,c)\n                    return path + [_USE]\n\n        # Explore neighbors\n        for dr, dc, action in _MOVES:\n            nr, nc = r + dr, c + dc\n            next_pos = (nr, nc)\n\n            if is_traversable(nr, nc) and next_pos not in visited:\n                visited.add(next_pos)\n                q.append((next_pos, path + [action]))\n\n    # If BFS completes without finding the primitive (e.g., it's unreachable or not present)\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:04:51.309697", "function_name": "collect", "function_body": "    # Define action constants based on CraftLab.action_specs()\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Define movement deltas for (row, col) coordinates.\n    # Maps action integer to (dr, dc) delta.\n    MOVE_DELTAS = {\n        ACTION_UP: (-1, 0),    # Move North/Up (decreases row)\n        ACTION_DOWN: (1, 0),   # Move South/Down (increases row)\n        ACTION_LEFT: (0, -1),  # Move West/Left (decreases col)\n        ACTION_RIGHT: (0, 1),  # Move East/Right (increases col)\n    }\n\n    current_state = env._current_state\n    \n    # If the primitive is already in inventory, no actions are needed.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    current_pos = current_state.pos\n    world = current_state.world # Reference to the CraftWorld instance\n\n    # Grid dimensions: (height, width, number_of_kinds)\n    grid_height, grid_width, n_kinds = grid.shape\n\n    # Identify entity kinds that act as obstacles for agent movement.\n    # Agent cannot walk onto these cells. This typically includes water, stone,\n    # and other non-grabbable features, excluding workshops (which are walkable).\n    obstacle_kinds = set()\n    if world.water_index is not None:\n        obstacle_kinds.add(world.water_index)\n    if world.stone_index is not None:\n        obstacle_kinds.add(world.stone_index)\n    \n    # Add other non-grabbable entities as obstacles, unless they are workshop locations.\n    for idx in world.non_grabbable_indices:\n        if idx not in world.workshop_indices:\n            obstacle_kinds.add(idx)\n\n    # Find all grid locations where the target primitive is present.\n    primitive_locations = []\n    for r in range(grid_height):\n        for c in range(grid_width):\n            if grid[r, c, primitive] == 1:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        # The primitive is not found on the map, so it cannot be collected.\n        return []\n\n    # Determine all valid cells adjacent to any primitive location.\n    # The agent needs to move to one of these cells to successfully `USE` the primitive.\n    potential_adjacent_targets = set()\n    for pr, pc in primitive_locations: # For each location of the primitive\n        for dr, dc in MOVE_DELTAS.values(): # Check all four cardinal directions around it\n            ar, ac = pr + dr, pc + dc # Candidate adjacent cell (adjacent_row, adjacent_col)\n\n            # Check if the candidate adjacent cell is within grid boundaries.\n            if 0 <= ar < grid_height and 0 <= ac < grid_width:\n                # Check if this candidate adjacent cell is an obstacle itself.\n                # The agent must be able to move onto this cell.\n                is_cell_an_obstacle = False\n                for k in range(n_kinds):\n                    if grid[ar, ac, k] == 1: # If this cell contains 'kind' k\n                        if k in obstacle_kinds:\n                            is_cell_an_obstacle = True\n                            break\n                        # Also, prevent pathfinding directly onto the primitive's own location,\n                        # as the goal is to stand *next to* it.\n                        if k == primitive:\n                            is_cell_an_obstacle = True\n                            break\n                \n                if not is_cell_an_obstacle:\n                    potential_adjacent_targets.add((ar, ac))\n\n    if not potential_adjacent_targets:\n        # No reachable adjacent spots for any primitive (e.g., all are blocked by obstacles).\n        return []\n\n    # Use Breadth-First Search (BFS) to find the shortest path.\n    # Queue stores tuples of (row, col, list_of_actions_taken_to_reach_here).\n    queue = collections.deque([(current_pos[0], current_pos[1], [])]) \n    visited = {(current_pos[0], current_pos[1])} # Keep track of visited (row, col) to avoid redundant paths and cycles.\n\n    while queue:\n        r, c, path_actions = queue.popleft()\n\n        # If the current cell is one of the potential adjacent targets, a path is found.\n        if (r, c) in potential_adjacent_targets:\n            # Append the USE action to the path and return.\n            return path_actions + [ACTION_USE] \n\n        # Explore all four possible movement directions from the current cell (r, c).\n        for move_action, (dr, dc) in MOVE_DELTAS.items():\n            nr, nc = r + dr, c + dc # Calculate the new (neighbor_row, neighbor_col)\n\n            # Check if the new position is within grid boundaries and has not been visited yet.\n            if 0 <= nr < grid_height and 0 <= nc < grid_width and (nr, nc) not in visited:\n                # Check if the new position (nr, nc) is an obstacle for movement.\n                is_cell_an_obstacle = False\n                for k_idx in range(n_kinds):\n                    if grid[nr, nc, k_idx] == 1: # If this cell contains 'kind' k_idx\n                        if k_idx in obstacle_kinds:\n                            is_cell_an_obstacle = True\n                            break\n                        # Agent cannot move onto the primitive resource itself.\n                        if k_idx == primitive:\n                            is_cell_an_obstacle = True\n                            break\n                \n                if not is_cell_an_obstacle:\n                    # If the new cell is not an obstacle, add it to visited and to the queue.\n                    visited.add((nr, nc))\n                    queue.append((nr, nc, path_actions + [move_action]))\n\n    # If the BFS completes and no path was found to any adjacent target cell, return an empty list.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:06:07.265425", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants based on CraftLab.action_specs\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  actions_taken = []\n  current_state = env._current_state  # Get the current state of the environment\n\n  # 1. Check if the primitive is already in the agent's inventory\n  if current_state.inventory[primitive] > 0:\n    return actions_taken\n\n  # 2. Get grid dimensions and the agent's current position\n  grid = current_state.grid\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n  start_pos = current_state.pos\n\n  # Define movement deltas and their corresponding actions\n  move_deltas = {\n      (0, 1): DOWN,   # (dx, dy) for moving Down (increasing y)\n      (0, -1): UP,    # (dx, dy) for moving Up (decreasing y)\n      (-1, 0): LEFT,  # (dx, dy) for moving Left (decreasing x)\n      (1, 0): RIGHT,  # (dx, dy) for moving Right (increasing x)\n  }\n\n  # 3. Perform a Breadth-First Search (BFS) on the grid to find the primitive's location\n  # The queue stores tuples of (current_position, path_to_current_position)\n  queue = collections.deque([(start_pos, [])])\n  visited = {start_pos}  # Set of (x, y) tuples to keep track of visited grid cells\n\n  target_location_found = False  # Flag to indicate if the primitive's location is found\n  path_to_primitive_location = None  # List of actions to reach the primitive's cell\n\n  while queue:\n    current_pos, path_so_far = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if the current cell contains the primitive\n    if grid[cx, cy, primitive] > 0:\n      target_location_found = True\n      path_to_primitive_location = path_so_far\n      break  # Primitive found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action in move_deltas.items():\n      nx, ny = cx + dx, cy + dy\n      new_pos = (nx, ny)\n\n      # Check if the new position is within grid boundaries and has not been visited\n      if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and new_pos not in visited:\n        visited.add(new_pos)\n        queue.append((new_pos, path_so_far + [action]))\n\n  # 4. If a path to the primitive's location was successfully found\n  if target_location_found:\n    actions_taken.extend(path_to_primitive_location)\n    \n    # After reaching the cell containing the primitive, the 'USE' action is required to collect it.\n    actions_taken.append(USE)\n    \n    return actions_taken\n  \n  # 5. If the primitive was not found on the grid (i.e., not visible or not reachable)\n  # An empty list is returned, indicating that the primitive cannot be collected with this strategy.\n  return []", "island_id": 4, "scores": {"3": -1}}
