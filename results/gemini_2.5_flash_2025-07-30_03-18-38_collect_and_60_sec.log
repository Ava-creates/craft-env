{"timestamp": "2025-07-30T06:31:47.469148", "function_name": "collect", "function_body": "    # Access the current state from the CraftLab environment\n    state = env._current_state\n\n    # Get relevant information from the state\n    current_grid = state.grid\n    current_pos = state.pos  # (row, col)\n    current_inventory = state.inventory\n    \n    # Store actions to be returned\n    actions = []\n\n    # 1. Check if the primitive is already in inventory\n    if current_inventory[primitive] > 0:\n        return actions # Already collected, no actions needed\n\n    # 2. Check if the agent is already next to the primitive and can use it\n    if state.next_to(primitive):\n        # If next to it, just perform the USE action\n        actions.append(env_factory.ACTIONS.USE)\n        return actions\n\n    # 3. Find all locations of the primitive on the grid\n    # np.argwhere returns a list of (row, col) coordinates where the condition is true\n    primitive_locs = np.argwhere(current_grid[:, :, primitive] > 0)\n\n    if len(primitive_locs) == 0:\n        # Primitive not found on the map, return empty actions\n        return actions\n\n    # 4. Find the closest primitive location to the current agent position\n    closest_primitive_loc = None\n    min_dist_to_primitive = float('inf')\n\n    for loc_r, loc_c in primitive_locs:\n        # Calculate Manhattan distance\n        dist = abs(loc_r - current_pos[0]) + abs(loc_c - current_pos[1])\n        if dist < min_dist_to_primitive:\n            min_dist_to_primitive = dist\n            closest_primitive_loc = (loc_r, loc_c)\n\n    if closest_primitive_loc is None: # Should not happen if primitive_locs was not empty\n        return actions\n    \n    # 5. Determine the target adjacent cell for the agent to move to\n    # We want to move to a cell (adj_r, adj_c) that is adjacent to closest_primitive_loc\n    # and minimizes the distance from current_pos to (adj_r, adj_c).\n    \n    # Grid dimensions (rows, cols, n_kinds)\n    grid_rows, grid_cols, _ = current_grid.shape\n\n    # Potential adjacent cells relative to the primitive (Up, Down, Left, Right)\n    potential_adj_offsets = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n\n    target_adj_cell = None\n    min_dist_to_adj_cell = float('inf')\n\n    for dr, dc in potential_adj_offsets:\n        adj_r, adj_c = closest_primitive_loc[0] + dr, closest_primitive_loc[1] + dc\n\n        # Check if the adjacent cell is within grid boundaries\n        if 0 <= adj_r < grid_rows and 0 <= adj_c < grid_cols:\n            # Calculate Manhattan distance from agent's current position to this adjacent cell\n            dist_to_current = abs(adj_r - current_pos[0]) + abs(adj_c - current_pos[1])\n            \n            if dist_to_current < min_dist_to_adj_cell:\n                min_dist_to_adj_cell = dist_to_current\n                target_adj_cell = (adj_r, adj_c)\n    \n    if target_adj_cell is None: # No valid adjacent cell found (e.g., primitive on very edge of tiny map)\n        return actions\n\n    # 6. Generate path actions to move from current_pos to target_adj_cell\n    # This generates a simple Manhattan path (does not account for obstacles)\n    current_r, current_c = current_pos\n    target_r, target_c = target_adj_cell\n\n    while current_r != target_r:\n        if current_r < target_r: # Target is below current\n            actions.append(env_factory.ACTIONS.DOWN)\n            current_r += 1\n        else: # Target is above current\n            actions.append(env_factory.ACTIONS.UP)\n            current_r -= 1\n            \n    while current_c != target_c:\n        if current_c < target_c: # Target is to the right of current\n            actions.append(env_factory.ACTIONS.RIGHT)\n            current_c += 1\n        else: # Target is to the left of current\n            actions.append(env_factory.ACTIONS.LEFT)\n            current_c -= 1\n            \n    # 7. Add the USE action after theoretically reaching the adjacent cell\n    actions.append(env_factory.ACTIONS.USE)\n\n    return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:31:48.413035", "function_name": "collect", "function_body": "  current_state = env._current_state\n  actions_sequence = []\n\n  # Get action mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Early exit if the primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  is_grabbable = primitive in current_state.world.grabbable_indices\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir # 0:N, 1:E, 2:S, 3:W\n\n  all_candidate_paths = [] # Stores (path_length, list_of_actions, final_agent_direction_after_path)\n\n  # Iterate through the grid to find all instances of the primitive\n  for px in range(WIDTH):\n    for py in range(HEIGHT):\n      if grid[px, py, primitive] > 0: # Found the primitive at (px, py)\n        # Determine potential target cells for the agent\n        # These are cells where the agent needs to stand to interact with (px, py)\n        target_agent_positions_and_actual_primitive = []\n\n        if is_grabbable:\n          # If grabbable, agent needs to move onto the primitive's cell\n          target_agent_positions_and_actual_primitive.append((px, py, px, py))\n        else:\n          # If non-grabbable, agent needs to move to an adjacent cell and face the primitive\n          # Candidate adjacent positions (ax, ay) relative to primitive (px, py)\n          # And the direction the agent needs to face (required_final_dir)\n          # (px, py) - actual primitive location\n          # (ax, ay) - agent's final position\n          # required_final_dir: 0:N, 1:E, 2:S, 3:W\n          #\n          # Example: If agent is at (px, py-1) (North of primitive), it needs to face SOUTH (2)\n          # (ax, ay, actual_px, actual_py)\n          adjacent_candidates_map = [\n              (px, py - 1, px, py), # Agent North of primitive\n              (px, py + 1, px, py), # Agent South of primitive\n              (px - 1, py, px, py), # Agent West of primitive\n              (px + 1, py, px, py), # Agent East of primitive\n          ]\n          \n          for ax, ay, actual_px, actual_py in adjacent_candidates_map:\n            if 0 <= ax < WIDTH and 0 <= ay < HEIGHT:\n              target_agent_positions_and_actual_primitive.append((ax, ay, actual_px, actual_py))\n\n        # For each potential target position, generate two path options (X-then-Y and Y-then-X)\n        for target_ax, target_ay, actual_px, actual_py in target_agent_positions_and_actual_primitive:\n          # Determine the required final direction for non-grabbables\n          required_final_dir = -1\n          if not is_grabbable:\n            if actual_px == target_ax: # Agent is on same X-axis as primitive\n              if actual_py == target_ay + 1: required_final_dir = 2 # Primitive is South of agent (agent faces S)\n              elif actual_py == target_ay - 1: required_final_dir = 0 # Primitive is North of agent (agent faces N)\n            elif actual_py == target_ay: # Agent is on same Y-axis as primitive\n              if actual_px == target_ax + 1: required_final_dir = 1 # Primitive is East of agent (agent faces E)\n              elif actual_px == target_ax - 1: required_final_dir = 3 # Primitive is West of agent (agent faces W)\n          \n          # --- Path Option 1: Move X then Y ---\n          temp_actions_xy = []\n          temp_x, temp_y = start_x, start_y\n          temp_dir_xy = start_dir\n          \n          # Move horizontally\n          while temp_x != target_ax:\n            if temp_x < target_ax:\n              temp_actions_xy.append(RIGHT)\n              temp_x += 1\n              temp_dir_xy = 1 # East\n            else: # temp_x > target_ax\n              temp_actions_xy.append(LEFT)\n              temp_x -= 1\n              temp_dir_xy = 3 # West\n          \n          # Move vertically\n          while temp_y != target_ay:\n            if temp_y < target_ay:\n              temp_actions_xy.append(DOWN)\n              temp_y += 1\n              temp_dir_xy = 2 # South\n            else: # temp_y > target_ay\n              temp_actions_xy.append(UP)\n              temp_y -= 1\n              temp_dir_xy = 0 # North\n          \n          # If no movement occurred, the direction remains the initial direction\n          if not temp_actions_xy:\n              final_dir_xy = start_dir\n          else:\n              final_dir_xy = temp_dir_xy\n\n          # Add path to candidates if it satisfies direction constraint (for non-grabbables) or if grabbable\n          if is_grabbable or (required_final_dir == -1) or (final_dir_xy == required_final_dir):\n            all_candidate_paths.append((len(temp_actions_xy), temp_actions_xy, final_dir_xy))\n\n          # --- Path Option 2: Move Y then X ---\n          temp_actions_yx = []\n          temp_x, temp_y = start_x, start_y\n          temp_dir_yx = start_dir\n          \n          # Move vertically\n          while temp_y != target_ay:\n            if temp_y < target_ay:\n              temp_actions_yx.append(DOWN)\n              temp_y += 1\n              temp_dir_yx = 2 # South\n            else: # temp_y > target_ay\n              temp_actions_yx.append(UP)\n              temp_y -= 1\n              temp_dir_yx = 0 # North\n          \n          # Move horizontally\n          while temp_x != target_ax:\n            if temp_x < target_ax:\n              temp_actions_yx.append(RIGHT)\n              temp_x += 1\n              temp_dir_yx = 1 # East\n            else: # temp_x > target_ax\n              temp_actions_yx.append(LEFT)\n              temp_x -= 1\n              temp_dir_yx = 3 # West\n\n          # If no movement occurred, the direction remains the initial direction\n          if not temp_actions_yx:\n              final_dir_yx = start_dir\n          else:\n              final_dir_yx = temp_dir_yx\n\n          # Add path to candidates if it satisfies direction constraint (for non-grabbables) or if grabbable\n          if is_grabbable or (required_final_dir == -1) or (final_dir_yx == required_final_dir):\n            all_candidate_paths.append((len(temp_actions_yx), temp_actions_yx, final_dir_yx))\n\n  # Select the shortest valid path\n  best_path_actions = []\n  min_path_len = float('inf')\n\n  if not all_candidate_paths:\n    return [] # No primitive found or no valid path to it\n\n  for path_len, actions, _ in all_candidate_paths:\n    if path_len < min_path_len:\n      min_path_len = path_len\n      best_path_actions = actions\n\n  actions_sequence.extend(best_path_actions)\n  actions_sequence.append(USE)\n\n  return actions_sequence", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:33:20.637080", "function_name": "collect", "function_body": "    import collections\n\n    # Action constants for CraftLab\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Mapping of CraftState.dir (int) to (dx, dy) delta for the cell in front\n    # Assuming dir: 0=North(Up), 1=East(Right), 2=South(Down), 3=West(Left)\n    DIR_TO_DELTA = {\n        0: (0, -1),  # North (Up in grid coords for Y)\n        1: (1, 0),   # East (Right in grid coords for X)\n        2: (0, 1),   # South (Down in grid coords for Y)\n        3: (-1, 0)   # West (Left in grid coords for X)\n    }\n\n    start_state = env._current_state\n    if start_state is None:\n        # Environment not initialized or in an invalid state\n        return []\n\n    # Get grid dimensions for boundary checks\n    grid_width, grid_height, _ = start_state.grid.shape\n\n    # BFS queue: stores (CraftState, list_of_actions_to_reach_this_state)\n    queue = collections.deque([(start_state, [])])\n    # Visited states: stores (pos_tuple, dir_int) to avoid redundant computation and loops\n    visited = set([(start_state.pos, start_state.dir)])\n\n    while queue:\n        current_state, path_actions = queue.popleft()\n\n        # 1. Check if the primitive is directly in front of the agent\n        fwd_dx, fwd_dy = DIR_TO_DELTA[current_state.dir]\n        front_x, front_y = current_state.pos[0] + fwd_dx, current_state.pos[1] + fwd_dy\n\n        # Check bounds and if the front cell contains the primitive\n        if (0 <= front_x < grid_width and\n                0 <= front_y < grid_height and\n                current_state.grid[front_x, front_y, primitive] > 0):\n            # Primitive is in front, so we can use the 'USE' action to collect it.\n            return path_actions + [USE]\n\n        # 2. Explore possible movement actions (UP, DOWN, LEFT, RIGHT)\n        for action in [UP, DOWN, LEFT, RIGHT]:\n            # Simulate the action to get the next state.\n            # The _reward is not used here as we are pathfinding, not optimizing reward.\n            _reward, next_state = current_state.step(action)\n\n            # Check if the next_state has been visited to prevent cycles and redundant paths.\n            # CraftState.step handles invalid moves (e.g., into a wall) by returning a state\n            # where pos might not have changed. The visited set naturally handles this.\n            if (next_state.pos, next_state.dir) not in visited:\n                visited.add((next_state.pos, next_state.dir))\n                queue.append((next_state, path_actions + [action]))\n\n    # If the queue is exhausted and no path to the primitive was found, return an empty list.\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:33:21.609939", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Constants for actions based on CraftLab.action_specs()\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n\n  # Direction mapping (CraftState.dir: 0=North, 1=East, 2=South, 3=West) to (dr, dc) delta\n  _DIR_TO_DELTA = {\n      0: (-1, 0),  # North\n      1: (0, 1),   # East\n      2: (1, 0),   # South\n      3: (0, -1)   # West\n  }\n\n  # Action (0-3: move actions) to ((delta_row, delta_col), new_facing_direction)\n  # This maps a movement action to its effect on position and the resulting agent direction.\n  _ACTION_EFFECTS = {\n      0: ((1, 0), 2),   # DOWN (action 0): moves (1,0) relative to current pos, faces South (dir 2)\n      1: ((-1, 0), 0),  # UP (action 1): moves (-1,0), faces North (dir 0)\n      2: ((0, -1), 3),  # LEFT (action 2): moves (0,-1), faces West (dir 3)\n      3: ((0, 1), 1)    # RIGHT (action 3): moves (0,1), faces East (dir 1)\n  }\n\n  # 1. Check if the primitive is already in the agent's inventory\n  current_inventory = env.observations()['features_dict']['inventory']\n  if current_inventory[primitive] > 0:\n      return [] # Already collected, no actions needed\n\n  # 2. Get initial state information from the environment\n  # Direct access to _current_state for the exact grid coordinates and direction\n  current_state = env._current_state\n  start_r, start_c = current_state.pos\n  start_dir = current_state.dir # Agent's starting direction\n\n  # Get the full global grid and its dimensions\n  grid = env.observations()['features_dict']['features_global']\n  width, height, _ = grid.shape # grid is (WIDTH, HEIGHT, n_kinds)\n\n  # Get the indices of entities that cannot be traversed (obstacles)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # BFS (Breadth-First Search) setup\n  queue = collections.deque()\n  # 'visited' set stores (row, col, direction) tuples to avoid cycles and redundant exploration\n  visited = set()\n  # 'path_actions' maps each (row, col, direction) state to the list of actions\n  # required to reach that state from the start.\n  path_actions = {}\n\n  # Initialize BFS with the agent's current state\n  initial_bfs_state = (start_r, start_c, start_dir)\n  queue.append(initial_bfs_state)\n  visited.add(initial_bfs_state)\n  path_actions[initial_bfs_state] = [] # No actions to reach the starting state\n\n  # 3. Perform BFS to find the shortest path to collect the primitive\n  while queue:\n      r, c, d = queue.popleft() # Current position (row, col) and direction (d)\n      current_path = path_actions[(r, c, d)] # Actions taken to reach this state\n\n      # Check if the primitive can be collected from the current state:\n      # The agent collects items in the cell it is currently facing.\n      faced_r, faced_c = r + _DIR_TO_DELTA[d][0], c + _DIR_TO_DELTA[d][1]\n\n      # Verify if the faced cell is within grid bounds and contains the target primitive\n      if 0 <= faced_r < width and 0 <= faced_c < height and grid[faced_r, faced_c, primitive] == 1:\n          # If so, the required actions are the path to this state plus the 'USE' action.\n          return current_path + [4] # 4 is the action ID for USE\n\n      # Explore possible next states by applying valid movement actions\n      # (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT)\n      for action_type in range(4): # Iterate through move action IDs\n          (dr, dc), new_dir = _ACTION_EFFECTS[action_type]\n          nr, nc = r + dr, c + dc # Calculate new position after action\n          next_bfs_state = (nr, nc, new_dir) # New state including new direction\n\n          # Check if the new position is within the grid boundaries\n          if not (0 <= nr < width and 0 <= nc < height):\n              continue # Invalid move, out of bounds\n\n          # Check if the new position is an obstacle (contains a non-grabbable entity)\n          is_obstacle = False\n          for k_idx in non_grabbable_indices:\n              if grid[nr, nc, k_idx] == 1: # If the cell contains this non-grabbable kind\n                  is_obstacle = True\n                  break\n          if is_obstacle:\n              continue # Cannot move into an obstacle cell\n\n          # Check if this new (position, direction) state has already been visited\n          if next_bfs_state in visited:\n              continue # Skip if already processed or in queue\n\n          # If the state is new and valid, add it to the queue and mark as visited\n          visited.add(next_bfs_state)\n          path_actions[next_bfs_state] = current_path + [action_type]\n          queue.append(next_bfs_state)\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:34:45.992538", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (assuming these are defined/imported from env_factory)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  current_state = env._current_state\n  grid = current_state.grid\n  H, W, K = grid.shape\n  start_pos_r, start_pos_c = current_state.pos\n  start_dir = current_state.dir\n\n  # Get obstacle kinds (non-grabbable items that block movement)\n  # A cell is considered an obstacle if it contains any item from the non_grabbable_indices set.\n  obstacle_kinds = env.world.non_grabbable_indices\n\n  # Find all locations of the primitive on the grid\n  primitive_locs = []\n  for r in range(H):\n    for c in range(W):\n      if grid[r, c, primitive] > 0:\n        primitive_locs.append((r, c))\n\n  if not primitive_locs:\n    return []  # Primitive not found on the map\n\n  # Define movement actions: (dr, dc), new_direction_after_move\n  # Directions: 0=NORTH(UP), 1=EAST(RIGHT), 2=SOUTH(DOWN), 3=WEST(LEFT)\n  move_actions = {\n      UP: ((-1, 0), 0),\n      DOWN: ((1, 0), 2),\n      LEFT: ((0, -1), 3),\n      RIGHT: ((0, 1), 1),\n  }\n\n  # Map of (delta_r, delta_c) from agent_pos to primitive_pos : required_agent_facing_direction_for_USE\n  # If agent is at (r,c) and primitive is at (pr, pc):\n  # (pr-r, pc-c) represents the vector from agent to primitive.\n  # The agent's current_dir must match the direction of this vector for USE.\n  # Example: If primitive is at (r-1, c) (NORTH of agent), then dr=-1, dc=0. Agent needs to face NORTH (0).\n  required_face_dir_map = {\n      (-1, 0): 0,  # Primitive is NORTH of agent, agent needs to face NORTH (UP)\n      (1, 0): 2,   # Primitive is SOUTH of agent, agent needs to face SOUTH (DOWN)\n      (0, -1): 3,  # Primitive is WEST of agent, agent needs to face WEST (LEFT)\n      (0, 1): 1,   # Primitive is EAST of agent, agent needs to face EAST (RIGHT)\n  }\n\n  q = collections.deque()\n  visited = set()  # Stores (r, c, direction) tuples to avoid cycles and redundant exploration\n\n  # Initial state: (current_row, current_col, current_direction, list_of_actions_so_far)\n  q.append((start_pos_r, start_pos_c, start_dir, []))\n  visited.add((start_pos_r, start_pos_c, start_dir))\n\n  while q:\n    r, c, current_dir, path = q.popleft()\n\n    # Check if we are currently adjacent to any primitive and facing it correctly\n    for pr, pc in primitive_locs:\n      dr_to_prim = pr - r\n      dc_to_prim = pc - c\n\n      # Check if adjacent (Manhattan distance 1, and not the same cell)\n      if (abs(dr_to_prim) + abs(dc_to_prim)) == 1:\n        # Check if we are facing the primitive from this adjacent position\n        if (dr_to_prim, dc_to_prim) in required_face_dir_map:\n          required_dir_for_use = required_face_dir_map[(dr_to_prim, dc_to_prim)]\n          if current_dir == required_dir_for_use:\n            return path + [USE] # Found path, append USE action and return\n\n    # Explore all possible movement actions from the current state\n    for action, ((dr, dc), new_dir) in move_actions.items():\n      next_r, next_c = r + dr, c + dc\n\n      # Check grid bounds\n      if not (0 <= next_r < H and 0 <= next_c < W):\n        continue\n\n      # Check if the next cell is an obstacle (contains any non-grabbable item)\n      is_next_obstacle = False\n      for k_idx in obstacle_kinds:\n        if grid[next_r, next_c, k_idx] > 0:\n          is_next_obstacle = True\n          break\n      if is_next_obstacle:\n        continue # Cannot move into an obstacle cell\n\n      # Add the new state to the queue if it hasn't been visited before\n      if (next_r, next_c, new_dir) not in visited:\n        visited.add((next_r, next_c, new_dir))\n        q.append((next_r, next_c, new_dir, path + [action]))\n\n  return []  # No path found to a suitable collection spot", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:34:46.970298", "function_name": "collect", "function_body": "  from collections import deque\n\n  # 1. Check if primitive is already collected\n  if env._current_state.inventory[primitive] > 0:\n    return []\n\n  # 2. Get current state information\n  grid = env._current_state.grid\n  current_pos = env._current_state.pos\n  WIDTH, HEIGHT = grid.shape[:2]\n\n  # 3. Find all locations of the primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      if grid[x, y, primitive] > 0:\n        primitive_locations.append((x, y))\n\n  # 4. Handle case: primitive not on grid\n  if not primitive_locations:\n    return []\n\n  # 5. BFS setup\n  q = deque([(current_pos, [])])  # Queue stores (position, list_of_actions_to_reach_here)\n  visited = {current_pos}         # Set of visited positions\n\n  # Map movement actions to coordinate deltas\n  # These constants are typically defined in env_factory or similar modules\n  action_to_delta = {\n      env_factory.DOWN: (0, 1),\n      env_factory.UP: (0, -1),\n      env_factory.LEFT: (-1, 0),\n      env_factory.RIGHT: (1, 0)\n  }\n\n  # 6. BFS search\n  while q:\n    pos, path = q.popleft()\n    x, y = pos\n\n    # Check if the current position is adjacent to any primitive location\n    # An item can be used if the agent is in a cell directly next to it (Manhattan distance 1)\n    for px, py in primitive_locations:\n      if abs(x - px) + abs(y - py) == 1:\n        # Found a path to a position from which the primitive can be collected\n        return path + [env_factory.USE]\n\n    # Explore valid neighboring cells\n    for action, delta in action_to_delta.items():\n      dx, dy = delta\n      next_x, next_y = x + dx, y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT:\n        # Check if this position has not been visited yet\n        if next_pos not in visited:\n          visited.add(next_pos)\n          q.append((next_pos, path + [action]))\n\n  # 7. If the queue becomes empty and no path to an adjacent primitive was found\n  return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:36:41.577812", "function_name": "collect", "function_body": "  import collections\n\n  state = env._current_state\n  world = state.world\n  cookbook = world.cookbook\n  \n  # Check if primitive is already in inventory\n  if state.inventory[primitive] > 0:\n      return []\n\n  actions_list = []\n\n  # Get relevant IDs and actions from the environment\n  ACTIONS = env.action_specs()\n  \n  # Prepare world_data dictionary for the helper function\n  world_data = {\n      \"cookbook\": cookbook,\n      \"actions\": ACTIONS,\n      \"grabbable_indices\": world.grabbable_indices,\n      \"non_grabbable_indices\": world.non_grabbable_indices,\n      \"workshop_indices\": world.workshop_indices,\n      \"recipes\": cookbook.recipes,\n      \"index\": cookbook.index \n  }\n\n  def _find_path_to_interact(start_pos, start_dir, target_kind_id, grid, world_data, for_crafting=False):\n      \"\"\"\n      Finds a sequence of actions to reach and interact with a target_kind_id.\n      - If for_crafting=True, finds path to a workshop (target_kind_id) and agent is on it, then USE.\n      - If for_crafting=False, finds path to be adjacent to target_kind_id (a grabbable item)\n        and facing it, then USE.\n      Returns (list_of_actions, final_pos, final_dir) or (None, None, None) if no path.\n      \"\"\"\n      WIDTH, HEIGHT, _ = grid.shape\n      WALL_IDX = world_data[\"cookbook\"].index.get_idx(\"wall\")\n      ACTIONS = world_data[\"actions\"]\n\n      MOVE_ACTIONS = [ACTIONS[\"UP\"], ACTIONS[\"DOWN\"], ACTIONS[\"LEFT\"], ACTIONS[\"RIGHT\"]]\n      ACTION_TO_DELTA = {\n          ACTIONS[\"UP\"]: (-1, 0),\n          ACTIONS[\"DOWN\"]: (1, 0),\n          ACTIONS[\"LEFT\"]: (0, -1),\n          ACTIONS[\"RIGHT\"]: (0, 1)\n      }\n      ACTION_TO_FINAL_DIR = { # The direction agent faces after taking the move action\n          ACTIONS[\"UP\"]: 0,  # North (0)\n          ACTIONS[\"RIGHT\"]: 1, # East (1)\n          ACTIONS[\"DOWN\"]: 2,  # South (2)\n          ACTIONS[\"LEFT\"]: 3   # West (3)\n      }\n      # Map relative delta from agent's position to the item's position to the direction the agent needs to face\n      DELTA_TO_FACING_DIR = { \n          (-1, 0): 0, # Target is North of agent\n          (0, 1): 1,  # Target is East of agent\n          (1, 0): 2,  # Target is South of agent\n          (0, -1): 3  # Target is West of agent\n      }\n      \n      q = collections.deque([(start_pos, start_dir, [])]) # (current_pos, current_direction, list_of_actions_taken)\n      visited = set([(start_pos, start_dir)]) # Track visited (pos, dir) states to avoid cycles\n\n      while q:\n          (r, c), current_dir, current_actions = q.popleft()\n\n          # --- Goal Check ---\n          if for_crafting: \n              # For crafting, the goal is to be *on* the workshop (or crafting surface like water for bridge)\n              if grid[r, c, target_kind_id] > 0:\n                  return current_actions + [ACTIONS[\"USE\"]], (r, c), current_dir\n          else: \n              # For grabbable items, the goal is to be *adjacent* to the item and facing it\n              for dr_adj, dc_adj in ACTION_TO_DELTA.values(): # Check 4 neighbors\n                  nr, nc = r + dr_adj, c + dc_adj\n                  # Check bounds and if neighbor cell contains the target item\n                  if 0 <= nr < WIDTH and 0 <= nc < HEIGHT and grid[nr, nc, target_kind_id] > 0:\n                      # Found target adjacent to current position (nr, nc)\n                      # Agent is at (r, c). It needs to be facing (nr, nc).\n                      required_facing_dir = DELTA_TO_FACING_DIR.get((dr_adj, dc_adj))\n                      if current_dir == required_facing_dir:\n                          return current_actions + [ACTIONS[\"USE\"]], (r, c), current_dir\n\n          # --- Explore Neighbors (Movement) ---\n          for action in MOVE_ACTIONS:\n              dr, dc = ACTION_TO_DELTA[action]\n              new_r, new_c = r + dr, c + dc\n              new_dir = ACTION_TO_FINAL_DIR[action] # Agent's direction after this move\n\n              # Check bounds\n              if not (0 <= new_r < WIDTH and 0 <= new_c < HEIGHT):\n                  continue\n\n              # Check for wall obstacles (cannot move into walls)\n              if grid[new_r, new_c, WALL_IDX] > 0:\n                  continue\n              \n              # Determine if the new cell is traversable\n              can_traverse = True\n              if grid[new_r, new_c].sum() > 0: # If cell is not empty\n                  # If target is a grabbable item (not for crafting), we cannot move *onto* it\n                  if not for_crafting and grid[new_r, new_c, target_kind_id] > 0:\n                      can_traverse = False\n                  else:\n                      # Check if it's another grabbable item (cannot move onto them)\n                      is_other_grabbable_obstacle = False\n                      for idx in world_data[\"grabbable_indices\"]:\n                          if grid[new_r, new_c, idx] > 0 and idx != target_kind_id:\n                              is_other_grabbable_obstacle = True\n                              break\n                      if is_other_grabbable_obstacle:\n                          can_traverse = False\n              \n              if not can_traverse:\n                  continue\n\n              # Add to queue if this (pos, dir) state has not been visited\n              if ((new_r, new_c), new_dir) not in visited:\n                  visited.add(((new_r, new_c), new_dir))\n                  q.append(((new_r, new_c), new_dir, current_actions + [action]))\n\n      return None, None, None # No path found\n\n  # --- Main Logic for collect_v2 ---\n  is_grabbable = primitive in world.grabbable_indices\n  is_craftable = primitive in cookbook.recipes\n\n  if is_grabbable:\n      # If the primitive is a simple grabbable item\n      path_actions, _, _ = _find_path_to_interact(state.pos, state.dir, primitive, state.grid, world_data, for_crafting=False)\n      if path_actions:\n          return path_actions\n      else:\n          return [] # Cannot find or collect this grabbable item\n  elif is_craftable:\n      # If the primitive needs to be crafted\n      recipe = cookbook.recipes.get(primitive)\n      if not recipe:\n          return [] # No recipe found for this craftable item\n\n      # Collect all ingredients required by the recipe\n      for ingredient_idx_raw, count in recipe.items():\n          # \"_key\" is a special entry in recipes, not an ingredient\n          if cookbook.index.get_name(ingredient_idx_raw) == \"_key\":\n              continue \n          \n          ingredient_idx = ingredient_idx_raw # Ingredient index is already an integer\n          \n          for _ in range(count):\n              # Recursively call collect_v2 to get actions for each required ingredient\n              ingredient_collection_actions = collect_v2(env, ingredient_idx)\n              \n              if not ingredient_collection_actions:\n                  # If any ingredient cannot be collected, the craft is impossible\n                  return []\n              \n              # Execute the ingredient collection actions in the environment\n              # This updates the `env._current_state` (agent's position, inventory, etc.)\n              for action in ingredient_collection_actions:\n                  env.step(action) # Rewards and observations are ignored here as they're not needed for pathfinding\n\n              actions_list.extend(ingredient_collection_actions)\n\n      # After collecting all ingredients, move to a workshop and craft the item\n      workshop_path_found = False\n      \n      # Determine the appropriate workshop/crafting surface\n      # Special case: crafting \"bridge\" requires being on \"water\"\n      if cookbook.index.get_name(primitive) == \"bridge\":\n          workshop_target_idx = cookbook.index.get_idx(\"water\")\n          # Try to find a path to the water tile\n          path_actions, _, _ = _find_path_to_interact(env._current_state.pos, env._current_state.dir, \n                                                      workshop_target_idx, env._current_state.grid, \n                                                      world_data, for_crafting=True)\n          if path_actions:\n              actions_list.extend(path_actions)\n              workshop_path_found = True\n              # Execute crafting actions\n              for action in path_actions:\n                  env.step(action)\n      else:\n          # For other crafts, iterate through all known workshop indices\n          for workshop_idx in world.workshop_indices:\n              path_actions, _, _ = _find_path_to_interact(env._current_state.pos, env._current_state.dir, \n                                                          workshop_idx, env._current_state.grid, \n                                                          world_data, for_crafting=True)\n              if path_actions:\n                  actions_list.extend(path_actions)\n                  workshop_path_found = True\n                  # Execute crafting actions\n                  for action in path_actions:\n                      env.step(action)\n                  break # Found a path to a workshop and crafted, no need to check other workshops\n\n      if not workshop_path_found:\n          return [] # Cannot craft if no suitable workshop found or reachable\n\n      # Final check: if the primitive is now in inventory, collection was successful\n      if env._current_state.inventory[primitive] > 0:\n          return actions_list\n      else:\n          # Crafting might have failed for other reasons (e.g., specific environment rules,\n          # or the recipe consumed ingredients but didn't yield the item).\n          # For this problem, we assume success if all steps are taken.\n          return [] \n\n  return [] # Primitive is neither grabbable nor craftable or unknown", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:36:41.646798", "function_name": "collect", "function_body": "    initial_state = env._current_state\n    primitive_idx = primitive\n\n    # If the primitive is already in the inventory, no actions are needed.\n    if initial_state.inventory[primitive_idx] > 0:\n        return []\n\n    # Use a deque for efficient BFS (Breadth-First Search).\n    # Each item in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_this_state)\n    q = collections.deque([(initial_state, [])])\n\n    # A set to keep track of visited states to prevent cycles and redundant exploration.\n    # A state is defined by its position, direction, and the content of its inventory.\n    # Inventory is converted to a sorted tuple of (item_index, count) for hashability.\n    visited = set()\n\n    # Helper function to create a hashable representation of the inventory.\n    # This is crucial for distinguishing states when inventory changes.\n    def get_inventory_hash(inventory_array):\n        # Extract items with count > 0 and store them as (index, count) tuples.\n        # Sort by index to ensure consistent hashing regardless of how items are added.\n        # Convert numpy int types to Python int for hashability.\n        active_items = tuple(sorted([(idx, int(count)) for idx, count in enumerate(inventory_array) if count > 0]))\n        return active_items\n    \n    # Add the initial state to the visited set.\n    initial_inventory_hash = get_inventory_hash(initial_state.inventory)\n    visited.add((initial_state.pos, initial_state.dir, initial_inventory_hash))\n\n    # Define possible actions (assuming these integer mappings are consistent with CraftLab).\n    # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4 as per CraftLab.action_specs\n    ACTIONS = [0, 1, 2, 3, 4] \n\n    # BFS loop\n    while q:\n        current_state, current_path = q.popleft()\n\n        for action in ACTIONS:\n            # Simulate the action: get the new state after applying the action.\n            # CraftState.step returns (reward, new_state). Reward is not used for pathfinding here.\n            _, new_state = current_state.step(action)\n            \n            # Form the new path by appending the current action.\n            new_path = current_path + [action]\n\n            # Check if the primitive has been collected in the new state's inventory.\n            if new_state.inventory[primitive_idx] > 0:\n                return new_path  # Goal achieved, return the sequence of actions.\n\n            # Create a hashable representation of the new state.\n            new_inventory_hash = get_inventory_hash(new_state.inventory)\n            state_tuple = (new_state.pos, new_state.dir, new_inventory_hash)\n\n            # If this new state has not been visited before, add it to the queue and visited set.\n            if state_tuple not in visited:\n                visited.add(state_tuple)\n                q.append((new_state, new_path))\n    \n    # If the queue becomes empty and the primitive has not been collected,\n    # it means no path was found.\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:38:16.305893", "function_name": "collect", "function_body": "    # Action constants (defined locally for self-containment as per instructions)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Direction vectors mapping CraftState's internal direction integer (0:N, 1:E, 2:S, 3:W)\n    # to (dx, dy) coordinate changes.\n    DIR_VECTORS = {\n        0: (0, -1),  # North (agent faces upwards on grid)\n        1: (1, 0),   # East (agent faces rightwards on grid)\n        2: (0, 1),   # South (agent faces downwards on grid)\n        3: (-1, 0)   # West (agent faces leftwards on grid)\n    }\n    # Mapping from a movement action to the direction the agent will be facing\n    # after performing that move. For example, moving UP makes the agent face North.\n    ACTION_TO_DIR = {\n        UP: 0,\n        RIGHT: 1,\n        DOWN: 2,\n        LEFT: 3\n    }\n\n    # Retrieve current state information from the environment\n    current_state = env._current_state\n    \n    # Check if the primitive is already in the agent's inventory.\n    # If it is, no actions are needed to collect it.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get observation details, especially the global grid\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    \n    # Get the agent's current position and direction\n    start_pos = current_state.pos\n    start_dir = current_state.dir\n\n    # Extract grid dimensions\n    HEIGHT, WIDTH, _ = grid.shape\n\n    # Find all locations where the desired primitive exists on the grid\n    primitive_locations = []\n    for y in range(HEIGHT):\n        for x in range(WIDTH):\n            if grid[y, x, primitive] > 0:  # Check if the primitive kind exists at (x, y)\n                primitive_locations.append((x, y))\n\n    # If the primitive is not found anywhere on the grid, return an empty action list.\n    if not primitive_locations:\n        return []\n\n    # Initialize Breadth-First Search (BFS)\n    # We use a list and a 'head' pointer to simulate a deque efficiently without importing 'collections'.\n    q = []  # Queue stores (path_so_far, current_position_tuple, current_direction_int)\n    q.append(([], start_pos, start_dir))\n    \n    # Visited set to keep track of explored states (position and direction)\n    visited = set()\n    visited.add((start_pos[0], start_pos[1], start_dir))\n\n    # Get the set of indices for non-grabbable entities, which act as obstacles\n    non_grabbable_indices = env.world.cookbook.non_grabbable_indices\n\n    head = 0 # Pointer for the front of the queue\n    while head < len(q):\n        path, (cx, cy), c_dir = q[head]\n        head += 1\n\n        # Check if the agent is currently in a position to collect the primitive.\n        # The USE action interacts with the cell directly in front of the agent.\n        target_dx, target_dy = DIR_VECTORS[c_dir]\n        target_x, target_y = cx + target_dx, cy + target_dy\n\n        # Check if the potential target cell is within grid boundaries\n        if 0 <= target_x < WIDTH and 0 <= target_y < HEIGHT:\n            # If the cell directly in front contains the primitive, we can collect it.\n            if grid[target_y, target_x, primitive] > 0:\n                return path + [USE] # Append the USE action and return the complete path\n\n        # Explore possible next states by trying all movement actions\n        possible_moves = [\n            (UP, 0, -1, ACTION_TO_DIR[UP]),\n            (DOWN, 0, 1, ACTION_TO_DIR[DOWN]),\n            (LEFT, -1, 0, ACTION_TO_DIR[LEFT]),\n            (RIGHT, 1, 0, ACTION_TO_DIR[RIGHT])\n        ]\n\n        for action, dx, dy, new_dir in possible_moves:\n            nx, ny = cx + dx, cy + dy  # Calculate the new position\n\n            # Check if the new position is within the grid boundaries\n            if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n                continue\n\n            # Define the new state (position and direction) as a tuple for the visited set\n            new_state_tuple = (nx, ny, new_dir)\n\n            # If this state has already been visited, skip it to avoid cycles and redundant work\n            if new_state_tuple in visited:\n                continue\n\n            # Check if the proposed new cell (nx, ny) is an obstacle\n            is_obstacle = False\n            for k_idx in non_grabbable_indices:\n                if grid[ny, nx, k_idx] > 0:\n                    is_obstacle = True\n                    break\n            \n            # If the cell is not an obstacle, add it to the visited set and the queue\n            if not is_obstacle:\n                visited.add(new_state_tuple)\n                q.append((path + [action], (nx, ny), new_dir))\n\n    # If the BFS queue is exhausted and no path to collect the primitive was found,\n    # return an empty list.\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:38:16.377394", "function_name": "collect", "function_body": "    import collections\n\n    # Define action constants from env_factory.action_map\n    ACTIONS = env_factory.action_map\n    DOWN, UP, LEFT, RIGHT, USE = ACTIONS[\"DOWN\"], ACTIONS[\"UP\"], ACTIONS[\"LEFT\"], ACTIONS[\"RIGHT\"], ACTIONS[\"USE\"]\n\n    # Cardinal directions: (dr, dc) for (N, E, S, W)\n    # dir 0: North (-1, 0)\n    # dir 1: East (0, 1)\n    # dir 2: South (1, 0)\n    # dir 3: West (0, -1)\n    DR = [-1, 0, 1, 0]\n    DC = [0, 1, 0, -1]\n\n    def _is_valid_pos(pos, height, width):\n        \"\"\"Checks if a given (row, col) position is within grid boundaries.\"\"\"\n        r, c = pos\n        return 0 <= r < height and 0 <= c < width\n\n    # Get initial state and primitive ID\n    current_state = env._current_state  # Access the internal CraftState instance\n    primitive_id = env.world.cookbook.index.index(primitive)\n    \n    # Check if primitive is already in inventory\n    if current_state.inventory[primitive_id] > 0:\n        return []\n\n    start_r, start_c = current_state.pos\n    start_dir = current_state.dir\n    grid = current_state.grid\n    height, width, _ = grid.shape\n\n    # BFS queue: stores (position (tuple), direction (int), list_of_actions)\n    q = collections.deque()\n    q.append(((start_r, start_c), start_dir, []))\n\n    # Visited set: stores ((row, col), direction) tuples to avoid cycles\n    visited = set()\n    visited.add(((start_r, start_c), start_dir))\n\n    while q:\n        (r, c), current_dir, actions = q.popleft()\n\n        # Check if the primitive is directly in front of the agent\n        front_r, front_c = r + DR[current_dir], c + DC[current_dir]\n        if _is_valid_pos((front_r, front_c), height, width) and grid[front_r, front_c, primitive_id] > 0:\n            # Found the primitive in front, add USE action and return path\n            return actions + [USE]\n\n        # Explore possible actions: Move Forward (DOWN), Turn Left, Turn Right\n        \n        # 1. Try moving forward (DOWN action)\n        next_r, next_c = r + DR[current_dir], c + DC[current_dir]\n        next_pos = (next_r, next_c)\n\n        if _is_valid_pos(next_pos, height, width):\n            # Check if the next position is blocked by a non-grabbable entity\n            is_blocked = False\n            for k_idx in env.world.non_grabbable_indices:\n                if grid[next_r, next_c, k_idx] > 0:\n                    is_blocked = True\n                    break\n            \n            if not is_blocked and (next_pos, current_dir) not in visited:\n                visited.add((next_pos, current_dir))\n                q.append((next_pos, current_dir, actions + [DOWN]))\n\n        # 2. Try turning Left\n        next_dir_left = (current_dir - 1 + 4) % 4\n        if ((r, c), next_dir_left) not in visited:\n            visited.add(((r, c), next_dir_left))\n            q.append(((r, c), next_dir_left, actions + [LEFT]))\n\n        # 3. Try turning Right\n        next_dir_right = (current_dir + 1) % 4\n        if ((r, c), next_dir_right) not in visited:\n            visited.add(((r, c), next_dir_right))\n            q.append(((r, c), next_dir_right, actions + [RIGHT]))\n\n    # If the queue becomes empty and no path was found to collect the primitive\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:39:39.651049", "function_name": "collect", "function_body": "    import collections\n\n    # Constants (assuming these are defined in the environment or accessible)\n    # These values typically align with DMLab's default action mapping.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Directions (mapping numerical index to cardinal direction)\n    DIR_NORTH = 0  # Typically (row-1, col)\n    DIR_EAST = 1   # Typically (row, col+1)\n    DIR_SOUTH = 2  # Typically (row+1, col)\n    DIR_WEST = 3   # Typically (row, col-1)\n\n    # Movement deltas for (row, col) given an action\n    MOVE_DELTAS = {\n        ACTION_UP: (-1, 0),\n        ACTION_DOWN: (1, 0),\n        ACTION_LEFT: (0, -1),\n        ACTION_RIGHT: (0, 1)\n    }\n\n    # Mapping from relative position of target to the direction agent needs to face it\n    # E.g., if target is at (-1, 0) relative to agent (i.e., North of agent),\n    # agent must face North (DIR_NORTH) to \"use\" it.\n    TARGET_DELTA_TO_FACE_DIR = {\n        (-1, 0): DIR_NORTH,\n        (1, 0): DIR_SOUTH,\n        (0, -1): DIR_WEST,\n        (0, 1): DIR_EAST\n    }\n\n    # 1. Get current state information from the environment\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    current_pos = tuple(obs['features_dict']['pos'])  # Agent's current (row, col)\n    current_dir_onehot = obs['features_dict']['direction']\n    current_dir = np.argmax(current_dir_onehot)  # Agent's current facing direction (0-3)\n    inventory = obs['features_dict']['inventory']\n    \n    # Get total number of kinds for grid dimensions\n    # Assuming grid shape is (WIDTH, HEIGHT, n_kinds)\n    _, _, n_kinds = grid.shape\n\n    # Check if the primitive is already collected\n    if inventory[primitive] > 0:\n        return []\n\n    # Get the CraftWorld instance to access non-grabbable items\n    world_instance = env.world\n    non_grabbable_indices = world_instance.non_grabbable_indices\n\n    # Helper function to determine if a grid cell is traversable by the agent\n    def is_traversable(r, c):\n        # Check if coordinates are within grid boundaries\n        if not (0 <= r < grid.shape[0] and 0 <= c < grid.shape[1]):\n            return False\n        \n        # A cell is not traversable if it contains any non-grabbable item\n        # (e.g., workshops, certain environment features like water/stone if not grabbable)\n        if np.any(grid[r, c, list(non_grabbable_indices)] > 0):\n            return False\n        \n        # A cell is also not traversable if it contains the target primitive itself.\n        # The agent needs to move *adjacent* to the primitive, not onto it, to use it.\n        if grid[r, c, primitive] > 0:\n            return False \n        \n        # Otherwise, the cell is considered traversable\n        return True\n\n    # 2. Find the target primitive's position on the grid\n    target_pos = None\n    for r in range(grid.shape[0]):\n        for c in range(grid.shape[1]):\n            if grid[r, c, primitive] > 0:\n                target_pos = (r, c)\n                break\n        if target_pos:\n            break\n\n    # If the primitive is not found on the map, it cannot be collected.\n    if not target_pos:\n        return []\n\n    # 3. Use Breadth-First Search (BFS) to find the shortest path from the agent's\n    # current position to any cell adjacent to the target primitive.\n    q = collections.deque([(current_pos, [])])  # Queue stores (position, list_of_actions_taken)\n    visited = {current_pos}  # Set of visited positions to avoid loops and redundant checks\n\n    path_to_approach = None  # List of actions to reach the approach position\n    final_approach_pos = None  # The (row, col) position adjacent to the target\n\n    while q:\n        current_search_pos, actions_so_far = q.popleft()\n\n        # Check if the current search position is adjacent to the target primitive\n        # (Manhattan distance of 1 means it's a cardinal neighbor)\n        dist = abs(current_search_pos[0] - target_pos[0]) + \\\n               abs(current_search_pos[1] - target_pos[1])\n        if dist == 1:\n            final_approach_pos = current_search_pos\n            path_to_approach = actions_so_far\n            break  # Shortest path to an adjacent cell found!\n\n        # Explore all four cardinal neighbors (UP, DOWN, LEFT, RIGHT)\n        for action_type, delta in MOVE_DELTAS.items():\n            next_r, next_c = current_search_pos[0] + delta[0], current_search_pos[1] + delta[1]\n            next_pos = (next_r, next_c)\n\n            # If the neighbor is traversable and hasn't been visited yet, add it to the queue\n            if next_pos not in visited and is_traversable(next_r, next_c):\n                visited.add(next_pos)\n                q.append((next_pos, actions_so_far + [action_type]))\n\n    # If no path to an adjacent cell was found (e.g., primitive is completely enclosed),\n    # then it's unreachable.\n    if not path_to_approach:\n        return []\n\n    # 4. Determine the turn actions required to face the target from the final_approach_pos.\n    turn_actions = []\n    \n    # Calculate the relative position of the target from the agent's final approach position\n    target_delta_from_approach = (target_pos[0] - final_approach_pos[0],\n                                  target_pos[1] - final_approach_pos[1])\n    \n    # Get the required direction the agent needs to face\n    required_dir = TARGET_DELTA_TO_FACE_DIR.get(target_delta_from_approach)\n    if required_dir is None:\n        # This case implies target_delta_from_approach is not a cardinal direction (which it should be if dist == 1).\n        # Should not happen with correct logic, but a safeguard.\n        return [] \n    \n    # Calculate the difference between the agent's initial direction and the required direction.\n    # The agent's direction does not change automatically with movement actions; it only changes with turn actions.\n    # So we use the `current_dir` obtained from the initial observation.\n    diff = (required_dir - current_dir + 4) % 4  # +4 handles negative results of modulo in Python\n\n    if diff == 1:  # Need to turn 90 degrees right\n        turn_actions.append(ACTION_RIGHT)\n    elif diff == 3:  # Need to turn 90 degrees left\n        turn_actions.append(ACTION_LEFT)\n    elif diff == 2:  # Need to turn 180 degrees (two right turns or two left turns)\n        turn_actions.extend([ACTION_RIGHT, ACTION_RIGHT])\n    # If diff is 0, no turns are needed.\n\n    # 5. Combine all actions: path to approach, turning, and then the USE action.\n    return path_to_approach + turn_actions + [ACTION_USE]", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:39:39.721935", "function_name": "collect", "function_body": "    \"\"\"Improved version of `collect_v1` using BFS to find a path to the primitive.\n    Operates by simulating steps on CraftState objects derived from current observations,\n    and returns a sequence of actions (movement and 'USE').\n    \"\"\"\n    import collections\n    import numpy as np\n\n    # Action constants (from action_specs)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Get current observations from the environment\n    obs = env.observations()\n    features_dict = obs['features_dict']\n\n    # Extract initial state properties for planning\n    # Grid dimensions are needed to convert normalized position back to (row, col)\n    grid_rows, grid_cols, _ = features_dict['features_global'].shape\n\n    # Position is (y_norm, x_norm). Convert to (row, col) integers.\n    initial_pos_normalized = features_dict['pos']\n    initial_pos = (int(initial_pos_normalized[0] * (grid_rows - 1)),\n                   int(initial_pos_normalized[1] * (grid_cols - 1)))\n\n    initial_dir_one_hot = features_dict['direction']\n    initial_dir = np.argmax(initial_dir_one_hot) # Assuming 0-3 for directions\n\n    initial_inventory = features_dict['inventory']\n    initial_grid = features_dict['features_global']\n\n    # Check if the primitive is already collected based on initial inventory\n    if initial_inventory[primitive_id] > 0:\n        return [] # Already have it, no actions needed\n\n    # BFS setup\n    q = collections.deque()\n    # Queue stores tuples of ((pos_r, pos_c), direction, list_of_actions_taken_so_far)\n    q.append((initial_pos, initial_dir, []))\n\n    visited = set()\n    visited.add((initial_pos, initial_dir))\n\n    # CraftLab holds the CraftScenario instance. We need it to construct CraftState.\n    # This is safe as per the CraftLab class definition's Data Attributes.\n    base_scenario = env.scenario\n\n    # Define possible movement actions (excluding USE for pathfinding)\n    movement_actions = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]\n\n    # BFS loop\n    while q:\n        (r, c), current_dir, path_so_far = q.popleft()\n\n        # Reconstruct a CraftState for simulation at this node in the search tree.\n        # For movement planning, the grid and inventory are static from the initial state.\n        # They only change after a 'USE' or 'CRAFT' action, which is not simulated within the BFS pathfinding.\n        sim_state = CraftState(\n            scenario=base_scenario,\n            grid=initial_grid,\n            pos=(r, c),\n            dir=current_dir,\n            inventory=initial_inventory\n        )\n\n        # Check if the current simulated state is adjacent to the primitive\n        if sim_state.next_to(primitive_id):\n            # If adjacent, we found a path. Append the USE action and return the full path.\n            # This assumes 'USE' will succeed in collecting the primitive if adjacent.\n            return path_so_far + [ACTION_USE]\n\n        # Explore possible movement actions\n        for action in movement_actions:\n            # Simulate the action to get the next state object.\n            # CraftState.step returns (reward, new_state_object). We only care about the new state.\n            _, next_sim_state = sim_state.step(action)\n\n            next_pos = next_sim_state.pos # This is already a (row, col) tuple\n            next_dir = next_sim_state.dir\n            next_state_tuple = (next_pos, next_dir)\n\n            if next_state_tuple not in visited:\n                visited.add(next_state_tuple)\n                q.append((next_pos, next_dir, path_so_far + [action]))\n\n    # If the queue is empty and no path to the primitive was found\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:41:13.805420", "function_name": "collect", "function_body": "    actions_list = []\n\n    # Get the current state\n    current_state = env._current_state \n\n    # Get primitive ID\n    primitive_id = env.world.cookbook.index(primitive)\n\n    # Check 1: If primitive is already in inventory\n    if current_state.inventory[primitive_id] > 0:\n        return [] \n\n    grid = current_state.grid\n    current_pos = current_state.pos\n\n    # Check 2: If agent is currently on the primitive itself\n    # In this case, simply use the item.\n    if grid[current_pos[0], current_pos[1], primitive_id] > 0:\n        return [ACTION_USE]\n\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n\n    # Map (dx, dy) to CraftLab action integer\n    # Assuming (0,0) is bottom-left, X increases right, Y increases up.\n    # UP: (0, 1) -> +Y, DOWN: (0, -1) -> -Y\n    # RIGHT: (1, 0) -> +X, LEFT: (-1, 0) -> -X\n    action_map = {\n        (0, 1): ACTION_UP,\n        (0, -1): ACTION_DOWN,\n        (1, 0): ACTION_RIGHT,\n        (-1, 0): ACTION_LEFT,\n    }\n    move_deltas = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n    \n    # Define blocking entities (e.g., water, stone, based on problem description)\n    blocking_indices = {env.world.water_index, env.world.stone_index} \n\n    # BFS setup to find shortest path to a cell adjacent to the primitive\n    q = collections.deque([(current_pos[0], current_pos[1], [])]) # (x, y, path_actions)\n    visited = set([(current_pos[0], current_pos[1])])\n\n    path_to_adjacent_cell = None\n\n    while q:\n        cx, cy, current_path = q.popleft()\n\n        # Check if the current cell (cx, cy) is adjacent to the target primitive\n        # An adjacent cell (px, py) to (cx, cy) contains the primitive\n        for dx_adj, dy_adj in move_deltas:\n            px, py = cx + dx_adj, cy + dy_adj # Potential primitive location\n\n            # Check bounds for potential primitive location\n            if not (0 <= px < WIDTH and 0 <= py < HEIGHT):\n                continue\n\n            # If primitive is found at (px, py), then (cx, cy) is a valid adjacent cell\n            if grid[px, py, primitive_id] > 0:\n                path_to_adjacent_cell = current_path\n                q.clear() # Found shortest path, clear queue to exit BFS\n                break # Exit inner loop\n        \n        if path_to_adjacent_cell is not None:\n            break # Exit outer while loop as well\n\n        # If not adjacent to a primitive, explore neighbors of (cx, cy)\n        for dx, dy in move_deltas:\n            nx, ny = cx + dx, cy + dy\n\n            # Check bounds for the next cell to move to\n            if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n                continue\n            \n            # Skip if already visited\n            if (nx, ny) in visited:\n                continue\n\n            # Determine traversability of (nx, ny)\n            is_traversable = True\n            \n            # If cell is not empty, check if it's a blocking entity\n            if np.sum(grid[nx, ny]) > 0: # If there's something in the cell\n                occupied_kind_idx = np.argmax(grid[nx, ny]) # Get the kind of item in the cell\n                if occupied_kind_idx in blocking_indices:\n                    is_traversable = False\n            \n            # If the cell is traversable and not visited, add to queue\n            if is_traversable:\n                visited.add((nx, ny))\n                new_path = current_path + [action_map[(dx, dy)]]\n                q.append((nx, ny, new_path))\n    \n    # If a path to an adjacent cell was found, extend actions with that path and then USE\n    if path_to_adjacent_cell is not None:\n        actions_list.extend(path_to_adjacent_cell)\n        actions_list.append(ACTION_USE)\n    \n    return actions_list", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:41:14.833029", "function_name": "collect", "function_body": "  import collections \n\n  # Constants for actions. These are fixed values for CraftWorld actions.\n  # They are not explicitly defined as class members in the description,\n  # but are commonly used constants in such environments.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Get the current state from the environment wrapper.\n  # The CraftLab class exposes _current_state as a CraftState instance.\n  current_state = env._current_state\n\n  # 1. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[primitive] > 0:\n      return [] # Already collected, no actions needed.\n\n  # --- Start BFS to find a path to a location from which the primitive can be collected ---\n  q = collections.deque()\n  # Queue stores tuples: (current_position_tuple, list_of_actions_taken_to_reach_here)\n  q.append((current_state.pos, []))\n  visited = {current_state.pos} # Set to keep track of visited positions to avoid cycles and redundant checks\n\n  # Get grid dimensions and world properties from the current state.\n  grid = current_state.grid\n  world = current_state.world \n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Define what constitutes an obstacle on the grid.\n  # Cells containing items whose indices are in `non_grabbable_indices` are considered blocked.\n  obstacle_indices = world.non_grabbable_indices\n\n  def _is_blocked(x, y):\n      \"\"\"Helper function to check if a cell (x, y) is blocked (out of bounds or contains an obstacle).\"\"\"\n      # Check grid boundaries first.\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return True # Out of bounds is blocked.\n      \n      # Check if any obstacle kind is present at this cell.\n      # A cell is blocked if it contains *any* item from the `non_grabbable_indices` set.\n      for obs_idx in obstacle_indices:\n          if grid[x, y, obs_idx] > 0: # If the grid cell (x,y) has a count > 0 for an obstacle kind.\n              return True\n      return False\n\n  # Define possible movement actions and their corresponding (dx, dy) changes.\n  # Assuming (x, y) coordinates where x is horizontal, y is vertical, and positive y is down.\n  moves_map = [\n      (0, 1, DOWN),  # Move down: (x, y+1)\n      (0, -1, UP),   # Move up: (x, y-1)\n      (-1, 0, LEFT), # Move left: (x-1, y)\n      (1, 0, RIGHT)  # Move right: (x+1, y)\n  ]\n\n  # Perform BFS\n  while q:\n      (curr_x, curr_y), path_so_far = q.popleft()\n\n      # Check if the current position is adjacent to (or on top of) the primitive.\n      # The `CraftState.next_to` method definition implies checking the 3x3 neighborhood.\n      # If the agent is within this neighborhood of the primitive, it can 'USE' it.\n      primitive_reachable_from_current_pos = False\n      for dx_adj in [-1, 0, 1]:\n          for dy_adj in [-1, 0, 1]:\n              adj_x, adj_y = curr_x + dx_adj, curr_y + dy_adj\n              # Ensure adjacent cell is within grid bounds\n              if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n                  # Check if the primitive is present at this adjacent cell\n                  if grid[adj_x, adj_y, primitive] > 0:\n                      primitive_reachable_from_current_pos = True\n                      break # Found a primitive nearby, no need to check other adjacent cells\n          if primitive_reachable_from_current_pos:\n              break # Break from outer loop too\n\n      if primitive_reachable_from_current_pos:\n          # If we've reached a position from which the primitive can be collected,\n          # append the USE action and return the full sequence of actions.\n          return path_so_far + [USE]\n\n      # If not yet adjacent to the primitive, explore unvisited and unblocked neighbors.\n      for dx, dy, action in moves_map:\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # If the next position is within bounds, not visited, and not blocked by an obstacle:\n          if next_pos not in visited and not _is_blocked(next_x, next_y):\n              visited.add(next_pos) # Mark as visited\n              # Add the next position to the queue with the updated path.\n              q.append((next_pos, path_so_far + [action]))\n\n  # If the BFS completes and no path to an adjacent primitive was found (e.g., primitive is not on the map, or unreachable)\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:42:52.809685", "function_name": "collect", "function_body": "    actions_log = []\n    # A hard cap on total steps to prevent infinite loops during exploration.\n    # This value can be tuned based on typical map sizes.\n    max_total_steps = 500 \n\n    while env._current_state.inventory[primitive] == 0 and len(actions_log) < max_total_steps:\n        current_state = env._current_state\n        current_pos = current_state.pos\n        current_dir = current_state.dir\n        grid = current_state.grid\n\n        # 1. Check if the primitive is in the cell directly in front of the agent.\n        # Determine the position of the cell directly in front.\n        dx_front, dy_front = env_factory.DIR_TO_VEC[current_dir]\n        front_x, front_y = current_pos[0] + dx_front, current_pos[1] + dy_front\n\n        primitive_in_front = False\n        if (0 <= front_x < env_factory.WIDTH and\n            0 <= front_y < env_factory.HEIGHT and\n            grid[front_x, front_y, primitive] > 0):\n            primitive_in_front = True\n        \n        if primitive_in_front:\n            # If the primitive is directly in front, attempt to USE it.\n            _, _, _ = env.step(env_factory.USE)\n            actions_log.append(env_factory.USE)\n            # Continue to the next loop iteration to re-check inventory.\n            continue \n\n        # 2. If not directly in front, check if it's in a *cardinal* neighbor cell.\n        # If so, turn to face it and then USE.\n        target_dir_to_primitive = -1\n        # Iterate through cardinal directions (North, East, South, West)\n        for d_idx, (vd_x, vd_y) in env_factory.DIR_TO_VEC.items():\n            neighbor_x, neighbor_y = current_pos[0] + vd_x, current_pos[1] + vd_y\n\n            if (0 <= neighbor_x < env_factory.WIDTH and\n                0 <= neighbor_y < env_factory.HEIGHT and\n                grid[neighbor_x, neighbor_y, primitive] > 0):\n                \n                target_dir_to_primitive = d_idx\n                break\n        \n        if target_dir_to_primitive != -1: # Primitive found in a cardinal neighbor\n            # Calculate the difference in direction to determine turns needed.\n            # diff = 1 means 90 deg right, 2 means 180 deg, 3 means 90 deg left.\n            diff = (target_dir_to_primitive - current_dir + env_factory.N_DIR) % env_factory.N_DIR\n            \n            if diff == 1: # Target is 90 degrees right\n                _, _, _ = env.step(env_factory.RIGHT)\n                actions_log.append(env_factory.RIGHT)\n            elif diff == 2: # Target is 180 degrees\n                _, _, _ = env.step(env_factory.RIGHT)\n                actions_log.append(env_factory.RIGHT)\n                # Ensure we don't exceed max_total_steps during turning\n                if len(actions_log) < max_total_steps: \n                    _, _, _ = env.step(env_factory.RIGHT)\n                    actions_log.append(env_factory.RIGHT)\n            elif diff == 3: # Target is 90 degrees left\n                _, _, _ = env.step(env_factory.LEFT)\n                actions_log.append(env_factory.LEFT)\n            \n            # After turning, the primitive should now be directly in front. Attempt to USE.\n            if len(actions_log) < max_total_steps: # Ensure not maxed out from turning\n                _, _, _ = env.step(env_factory.USE)\n                actions_log.append(env_factory.USE)\n            \n            # Continue to the next loop iteration to re-check inventory.\n            continue \n\n        # 3. If primitive is not immediately grabbable (not in front or cardinal neighbor), explore.\n        # Basic exploration strategy: Try to move forward. If blocked, turn right.\n        \n        # Determine the action required to move forward based on the agent's current direction.\n        action_to_take_forward = {\n            0: env_factory.UP,     # Facing North (dir 0), move UP\n            1: env_factory.RIGHT,  # Facing East (dir 1), move RIGHT\n            2: env_factory.DOWN,   # Facing South (dir 2), move DOWN\n            3: env_factory.LEFT    # Facing West (dir 3), move LEFT\n        }[current_dir]\n\n        original_pos = current_pos\n        _, _, _ = env.step(action_to_take_forward)\n        actions_log.append(action_to_take_forward)\n\n        # If the agent's position did not change after attempting to move forward,\n        # it means the path was blocked (e.g., by a wall or another object).\n        if env._current_state.pos == original_pos:\n            # When blocked, turn right to try a new direction for exploration.\n            _, _, _ = env.step(env_factory.RIGHT)\n            actions_log.append(env_factory.RIGHT)\n    \n    return actions_log", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:42:52.881739", "function_name": "collect", "function_body": "    # Action constants (from CraftLab.action_specs)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Map action to (dx, dy) delta for moving agent.\n    # Assuming (x, y) coordinates where x increases right, y increases down.\n    ACTION_DELTAS = {\n        ACTION_DOWN: (0, 1),   # (dx, dy) -> (x, y+1)\n        ACTION_UP: (0, -1),    # (dx, dy) -> (x, y-1)\n        ACTION_LEFT: (-1, 0),  # (dx, dy) -> (x-1, y)\n        ACTION_RIGHT: (1, 0),  # (dx, dy) -> (x+1, y)\n    }\n\n    # Map direction (which is also an action value) to (dx, dy) delta for \"what's in front\"\n    # If agent's direction is UP (ACTION_UP), item in front is at (x, y-1)\n    DIRECTION_DELTAS = {\n        ACTION_DOWN: (0, 1),\n        ACTION_UP: (0, -1),\n        ACTION_LEFT: (-1, 0),\n        ACTION_RIGHT: (1, 0),\n    }\n\n    def _get_abs_pos(normalized_pos, grid_shape):\n        \"\"\"Converts normalized (x_norm, y_norm) to absolute (x, y) integer coordinates.\"\"\"\n        # grid_shape is (WIDTH, HEIGHT, N_KINDS) as per CraftScenario/State\n        grid_width, grid_height, _ = grid_shape\n        # Rounding is important for float to int conversion to avoid off-by-one due to precision\n        return (int(round(normalized_pos[0] * grid_width)),\n                int(round(normalized_pos[1] * grid_height)))\n\n    def _get_coords_in_front(pos, direction):\n        \"\"\"Calculates coordinates of the cell directly in front of the agent.\"\"\"\n        curr_x, curr_y = pos\n        dx, dy = DIRECTION_DELTAS.get(direction, (0,0)) # default to (0,0) if direction is invalid\n        return (curr_x + dx, curr_y + dy)\n\n    obs = env.observations()\n    current_grid = obs['features_dict']['features_global']\n    current_pos_normalized = obs['features_dict']['pos']\n    current_dir = np.argmax(obs['features_dict']['direction'])\n    inventory = obs['features_dict']['inventory']\n\n    # Check if primitive is already collected\n    if inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions\n    grid_width, grid_height, _ = current_grid.shape\n    current_pos = _get_abs_pos(current_pos_normalized, current_grid.shape)\n\n    # Find all locations of the primitive on the grid\n    # np.argwhere returns (x, y) coordinates given current_grid is (WIDTH, HEIGHT, N_KINDS)\n    primitive_locations = set(tuple(loc) for loc in np.argwhere(current_grid[:, :, primitive] > 0))\n\n    if not primitive_locations:\n        # Primitive not found on the grid\n        return []\n\n    # BFS state: ((x, y), current_direction, path_actions)\n    # Using a list as a queue to strictly adhere to \"Do not imports\" rule\n    queue = [((current_pos[0], current_pos[1]), current_dir, [])]\n    visited = set([((current_pos[0], current_pos[1]), current_dir)])\n\n    target_actions = None\n\n    queue_idx = 0\n    while queue_idx < len(queue):\n        (curr_x, curr_y), curr_d, path = queue[queue_idx]\n        queue_idx += 1 # Manual pop_left equivalent\n\n        # Check if primitive is directly in front and can be used\n        front_x, front_y = _get_coords_in_front((curr_x, curr_y), curr_d)\n        if (0 <= front_x < grid_width and 0 <= front_y < grid_height and\n            (front_x, front_y) in primitive_locations):\n            target_actions = path + [ACTION_USE]\n            break\n\n        # Explore movements\n        for action_val, (dx, dy) in ACTION_DELTAS.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_d = action_val # Agent faces the direction of the last movement (e.g., MOVE_RIGHT -> face RIGHT)\n\n            # Check bounds\n            if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n                continue\n\n            # Check if this state has been visited\n            if ((next_x, next_y), next_d) in visited:\n                continue\n\n            # Assuming all cells are traversable.\n            # If not, an additional check for obstacles (e.g., current_grid[next_x, next_y, obstacle_kind] == 0)\n            # would be needed based on `non_grabbable_indices` from CraftWorld.\n            \n            visited.add(((next_x, next_y), next_d))\n            new_path = path + [action_val]\n            queue.append(((next_x, next_y), next_d, new_path))\n    \n    if target_actions is None:\n        return [] # Primitive not reachable\n    \n    return target_actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:44:43.615250", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:44:43.684762", "function_name": "collect", "function_body": "    # Action constants (assuming DMLab-like actions)\n    ACTION_DOWN = 0   # Move backwards\n    ACTION_UP = 1     # Move forwards\n    ACTION_LEFT = 2   # Turn left\n    ACTION_RIGHT = 3  # Turn right\n    ACTION_USE = 4    # Interact with object in front\n\n    # Direction mappings for (dr, dc) based on direction faced (N=0, E=1, S=2, W=3)\n    # (dr, dc) means (row_change, col_change)\n    DELTA_POS = {\n        0: (-1, 0),  # North: row-1\n        1: (0, 1),   # East: col+1\n        2: (1, 0),   # South: row+1\n        3: (0, -1)   # West: col-1\n    }\n\n    current_state = env._current_state\n    grid = current_state.grid\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir\n    initial_inventory = current_state.inventory\n    \n    # Check if primitive is already in inventory\n    if initial_inventory[primitive] > 0:\n        return []\n\n    grid_height, grid_width, _ = grid.shape\n\n    # BFS Queue: (current_row, current_col, current_direction, path_taken)\n    # Assuming 'collections' is imported at a higher scope.\n    queue = collections.deque([(initial_pos[0], initial_pos[1], initial_dir, [])])\n    \n    # Visited set: (row, col, direction) to prevent cycles and re-exploring states\n    visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n    # Helper to calculate the cell directly in front of the agent\n    def _get_cell_in_front(r, c, d):\n        dr, dc = DELTA_POS[d]\n        front_r, front_c = r + dr, c + dc\n        return front_r, front_c\n\n    while queue:\n        r, c, d, path = queue.popleft()\n\n        # Check if the primitive is directly in front of the agent from the current state (r, c, d).\n        # If it is, and we can 'USE' it, this path is a solution.\n        front_r, front_c = _get_cell_in_front(r, c, d)\n        \n        # Check if the cell in front is within grid boundaries\n        if 0 <= front_r < grid_height and 0 <= front_c < grid_width:\n            # Check if the primitive is present at the target location.\n            # grid[row, col, kind_idx] will be > 0 if the item is there.\n            if grid[front_r, front_c, primitive] > 0:\n                # Found the primitive, return the path to get to this state + ACTION_USE\n                return path + [ACTION_USE]\n\n        # Explore possible next states by applying movement and turn actions\n        for action in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n            new_r, new_c, new_d = r, c, d # Initialize new state with current state\n\n            if action == ACTION_UP:\n                dr, dc = DELTA_POS[d]\n                new_r, new_c = r + dr, c + dc\n            elif action == ACTION_DOWN:\n                dr, dc = DELTA_POS[(d + 2) % 4] # Opposite direction\n                new_r, new_c = r + dr, c + dc\n            elif action == ACTION_LEFT:\n                new_d = (d + 3) % 4 # Turn 90 degrees left (e.g., N(0) -> W(3))\n            elif action == ACTION_RIGHT:\n                new_d = (d + 1) % 4 # Turn 90 degrees right (e.g., N(0) -> E(1))\n\n            # Simulate interaction with grid boundaries:\n            # If the agent attempts to move off the grid, its position does not change.\n            # This simulates hitting an impassable boundary/wall.\n            is_new_pos_valid = (0 <= new_r < grid_height and 0 <= new_c < grid_width)\n            \n            # If the action was a move (UP/DOWN) and the new position is invalid (out of bounds),\n            # the agent's position effectively remains unchanged.\n            if action in [ACTION_UP, ACTION_DOWN] and not is_new_pos_valid:\n                new_r, new_c = r, c \n\n            next_state_tuple = (new_r, new_c, new_d)\n\n            # Add the new state to the queue if it hasn't been visited yet\n            if next_state_tuple not in visited:\n                visited.add(next_state_tuple)\n                queue.append((new_r, new_c, new_d, path + [action]))\n\n    # If the queue becomes empty and no path to collect the primitive was found\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:47:03.545466", "function_name": "collect", "function_body": "    # Action constants (assuming these are defined globally or from env_factory)\n    # DOWN = 0, UP = 1, LEFT = 2, RIGHT = 3, USE = 4\n\n    # Mapping movement actions to (dx, dy) and the resulting new facing direction.\n    # Assuming (0,0) is top-left, +Y is down, +X is right.\n    # Agent directions: 0=North (up), 1=East (right), 2=South (down), 3=West (left).\n    MOVE_ACTION_DATA = {\n        UP:    ((0, -1), 0),  # (dx, dy) and new_dir\n        RIGHT: ((1, 0),  1),\n        DOWN:  ((0, 1),  2),\n        LEFT:  ((-1, 0), 3),\n    }\n\n    # Mapping agent's facing direction to a (dx, dy) delta.\n    # Used to determine the cell directly in front of the agent for the USE action.\n    DIR_TO_DELTA = {\n        0: (0, -1),  # North\n        1: (1, 0),   # East\n        2: (0, 1),   # South\n        3: (-1, 0),  # West\n    }\n\n    # Get the current state of the environment without modifying it\n    initial_state = env._current_state\n    world = env.world\n    \n    # If the primitive is already in the inventory, no actions are needed\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    grid = initial_state.grid\n    WIDTH, HEIGHT, _ = grid.shape\n    water_idx = world.water_index\n\n    # Helper function to check if a grid position is traversable by the agent.\n    # A cell is considered traversable if it's within grid bounds and does not contain water.\n    def is_traversable(x, y):\n        if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n            return False  # Out of bounds\n        if grid[x, y, water_idx] > 0:\n            return False  # Contains water, which is an obstacle\n        # Additional checks for other non-traversable entities could be added here\n        # (e.g., specific items in `world.environment` if they are static obstacles)\n        return True\n\n    # BFS setup for finding the shortest path\n    queue = collections.deque()\n    # `visited` set stores (x, y, direction) tuples to prevent cycles and revisit redundant states.\n    visited = set()\n\n    # Get the agent's starting position and direction\n    start_x, start_y = initial_state.pos\n    start_dir = initial_state.dir\n    \n    # Initialize BFS queue with the starting state:\n    # (current_x, current_y, current_direction, list_of_actions_taken_to_reach_this_state)\n    queue.append((start_x, start_y, start_dir, []))\n    visited.add((start_x, start_y, start_dir))\n\n    # Perform Breadth-First Search\n    while queue:\n        curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n        # Check if the primitive can be collected from the current state (position and direction).\n        # Determine the cell directly in front of the agent based on its current direction.\n        dx_face, dy_face = DIR_TO_DELTA[curr_dir]\n        target_x, target_y = curr_x + dx_face, curr_y + dy_face\n\n        # If the cell in front is within bounds and contains the desired primitive,\n        # then the primitive can be collected with a 'USE' action.\n        if (0 <= target_x < WIDTH and 0 <= target_y < HEIGHT and\n            grid[target_x, target_y, primitive] > 0):\n            # A path to collect the primitive has been found.\n            return path_actions + [USE]\n\n        # Explore possible movement actions from the current state\n        for action, ((dx_move, dy_move), new_dir) in MOVE_ACTION_DATA.items():\n            next_x, next_y = curr_x + dx_move, curr_y + dy_move\n\n            # If the next position is traversable and this state (pos+dir) hasn't been visited yet,\n            # add it to the queue for further exploration.\n            if is_traversable(next_x, next_y):\n                if (next_x, next_y, new_dir) not in visited:\n                    visited.add((next_x, next_y, new_dir))\n                    queue.append((next_x, next_y, new_dir, path_actions + [action]))\n\n    # If the BFS queue becomes empty and no path to the primitive was found,\n    # it means the primitive is currently unreachable or not present on the grid.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:47:03.624660", "function_name": "collect", "function_body": "    # We need collections.deque for BFS and numpy for array operations.\n    # Assuming these imports are available in the scope where this function is placed.\n    import collections\n    import numpy as np\n\n    # Retrieve action mappings from the environment's `action_specs`\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    # Movement deltas for (dr, dc, new_dir) corresponding to actions 0-3\n    # Assumes these actions directly move in cardinal directions AND also set the agent's facing direction.\n    # Direction values are: 0 (DOWN), 1 (UP), 2 (LEFT), 3 (RIGHT).\n    MOVES = {\n        ACTION_DOWN: (1, 0, 0),   # Move (r+1, c) and face DOWN (dir 0)\n        ACTION_UP: (-1, 0, 1),    # Move (r-1, c) and face UP (dir 1)\n        ACTION_LEFT: (0, -1, 2),  # Move (r, c-1) and face LEFT (dir 2)\n        ACTION_RIGHT: (0, 1, 3)   # Move (r, c+1) and face RIGHT (dir 3)\n    }\n\n    # Maps (dr, dc) relative offset from agent to the required facing direction for the USE action.\n    # The USE action is assumed to operate on the cell directly in front of the agent (cardinal direction).\n    RELATIVE_DIRECTIONS = {\n        (1, 0): 0,  # Target is (r+1, c), agent needs to face DOWN (dir 0)\n        (-1, 0): 1, # Target is (r-1, c), agent needs to face UP (dir 1)\n        (0, -1): 2, # Target is (r, c-1), agent needs to face LEFT (dir 2)\n        (0, 1): 3   # Target is (r, c+1), agent needs to face RIGHT (dir 3)\n    }\n\n    # Get current state observations from the environment\n    obs = env.observations()\n    initial_grid = obs['features_dict']['features_global']\n    initial_pos_np = obs['features_dict']['pos'] # This is a numpy array [r, c]\n    initial_r, initial_c = int(initial_pos_np[0]), int(initial_pos_np[1])\n    initial_dir = np.argmax(obs['features_dict']['direction']) # Convert one-hot direction to an integer (0-3)\n    initial_inventory = obs['features_dict']['inventory']\n\n    # Get grid dimensions (WIDTH and HEIGHT are from the grid's first two dimensions)\n    WIDTH, HEIGHT, _ = initial_grid.shape\n\n    # If the primitive is already in inventory, no actions are needed.\n    if initial_inventory[primitive] > 0:\n        return []\n\n    # Get obstacle indices (non-grabbable items like water, stone are treated as impassable)\n    # The `world` attribute of CraftLab holds the Cookbook, which contains `non_grabbable_indices`.\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # BFS (Breadth-First Search) initialization\n    # Queue stores tuples: (current_row, current_col, current_direction, list_of_actions_to_reach_here)\n    queue = collections.deque([(initial_r, initial_c, initial_dir, [])])\n    # Visited set stores (row, col, direction) tuples to avoid redundant exploration and infinite loops\n    visited = set([(initial_r, initial_c, initial_dir)])\n\n    # BFS main loop\n    while queue:\n        r, c, current_dir, actions_path = queue.popleft()\n\n        # Determine the cell directly in front of the agent based on its current direction\n        facing_dr, facing_dc = 0, 0\n        if current_dir == 0:  # Facing DOWN\n            facing_dr, facing_dc = 1, 0\n        elif current_dir == 1:  # Facing UP\n            facing_dr, facing_dc = -1, 0\n        elif current_dir == 2:  # Facing LEFT\n            facing_dr, facing_dc = 0, -1\n        elif current_dir == 3:  # Facing RIGHT\n            facing_dr, facing_dc = 0, 1\n\n        target_r, target_c = r + facing_dr, c + facing_dc\n\n        # Check if the primitive is located in the cell directly in front of the agent\n        if (0 <= target_r < WIDTH and 0 <= target_c < HEIGHT and\n                initial_grid[target_r, target_c, primitive] == 1):\n            # Primitive found and the agent is correctly positioned and facing it.\n            # Append the USE action and return the full sequence of actions.\n            return actions_path + [ACTION_USE]\n\n        # Explore possible movement actions from the current state\n        # Each movement action (0-3) updates both position and facing direction\n        for action_value, (dr, dc, new_dir) in MOVES.items():\n            next_r, next_c = r + dr, c + dc\n            next_state = (next_r, next_c, new_dir) # New state tuple (position, direction)\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n                continue # Out of bounds, skip this move\n\n            # Check if the next position contains an obstacle\n            is_obstacle = False\n            for obstacle_idx in non_grabbable_indices:\n                if initial_grid[next_r, next_c, obstacle_idx] == 1:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue # Cannot move into an obstacle, skip this move\n\n            # Check if this (position, direction) state has already been visited\n            if next_state not in visited:\n                visited.add(next_state)\n                # Add the new state to the queue along with the updated path\n                queue.append((next_r, next_c, new_dir, actions_path + [action_value]))\n\n    # If the queue becomes empty and no path to collect the primitive was found,\n    # it means the primitive is unreachable or not present.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:48:34.808980", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Define action constants based on CraftState internal logic\n    # These integer values map to actions as processed by CraftState.step\n    ACTION_FORWARD = 0\n    ACTION_BACKWARD = 1\n    ACTION_TURN_LEFT = 2\n    ACTION_TURN_RIGHT = 3\n    ACTION_USE = 4\n\n    # Define direction vectors (row_change, col_change) for movement\n    # 0: North (row decreases, col same)\n    # 1: East (row same, col increases)\n    # 2: South (row increases, col same)\n    # 3: West (row same, col decreases)\n    DIRECTIONS_VECTORS = {\n        0: (-1, 0),  # N\n        1: (0, 1),   # E\n        2: (1, 0),   # S\n        3: (0, -1)   # W\n    }\n\n    class _BFSQueueItem:\n        \"\"\"Helper class for BFS queue items to manage state and path.\"\"\"\n        def __init__(self, pos, direction, path):\n            self.pos = pos\n            self.direction = direction\n            self.path = path\n\n        def __hash__(self):\n            # Used for `visited` set to quickly check if a state has been explored\n            return hash((self.pos, self.direction))\n\n        def __eq__(self, other):\n            # Used for `visited` set equality check\n            return self.pos == other.pos and self.direction == other.direction\n\n    def _is_cell_walkable(grid, world, r, c):\n        \"\"\"\n        Checks if a cell (r, c) is within grid bounds and does not contain\n        any non-grabbable (i.e., solid) items.\n        \"\"\"\n        height, width, _ = grid.shape\n        if not (0 <= r < height and 0 <= c < width):\n            return False  # Out of bounds\n\n        # Check if the cell contains any non-grabbable items which act as obstacles\n        for idx in world.non_grabbable_indices:\n            # Ensure index is valid for the grid's kind dimension\n            if idx < grid.shape[2] and grid[r, c, idx] > 0:\n                return False  # Contains a non-grabbable obstacle\n        return True\n\n    def _get_3x3_neighborhood_coords(pos):\n        \"\"\"\n        Returns a list of (row, col) coordinates for the 3x3 neighborhood\n        around the given position, including the center cell itself.\n        \"\"\"\n        r, c = pos\n        neighbors = []\n        for dr in [-1, 0, 1]:\n            for dc in [-1, 0, 1]:\n                neighbors.append((r + dr, c + dc))\n        return neighbors\n\n    # Get current state information from the environment\n    initial_state = env._current_state\n    start_pos = initial_state.pos\n    start_dir = initial_state.dir\n    grid = initial_state.grid\n    world = env.world\n    \n    # Store grid dimensions for boundary checks\n    height, width, _ = grid.shape\n\n    # --- Step 1: Check if the primitive can be collected immediately ---\n    # Re-implement CraftState.next_to logic to check if agent is adjacent to (or on) the primitive\n    is_already_next_to_primitive = False\n    for nr, nc in _get_3x3_neighborhood_coords(start_pos):\n        if 0 <= nr < height and 0 <= nc < width: # Check bounds\n            if primitive < grid.shape[2] and grid[nr, nc, primitive] > 0: # Check if primitive is present\n                is_already_next_to_primitive = True\n                break\n    \n    if is_already_next_to_primitive:\n        return [ACTION_USE] # If yes, just return the USE action\n\n    # --- Step 2: Use BFS to find the shortest path to a collectable position ---\n    # BFS setup\n    queue = collections.deque([_BFSQueueItem(start_pos, start_dir, [])])\n    visited = {(start_pos, start_dir)} # Set to keep track of visited (pos, dir) states\n\n    while queue:\n        current_item = queue.popleft()\n        current_pos = current_item.pos\n        current_dir = current_item.direction\n        actions_taken = current_item.path\n\n        # Check if the current position is a valid target position (i.e., adjacent to or on the primitive)\n        is_target_found = False\n        for nr, nc in _get_3x3_neighborhood_coords(current_pos):\n            if 0 <= nr < height and 0 <= nc < width:\n                if primitive < grid.shape[2] and grid[nr, nc, primitive] > 0:\n                    is_target_found = True\n                    break\n        \n        if is_target_found:\n            return actions_taken + [ACTION_USE] # Path found, return actions plus the USE action\n\n        # Explore possible next states by applying all move and turn actions\n        for action in [ACTION_FORWARD, ACTION_BACKWARD, ACTION_TURN_LEFT, ACTION_TURN_RIGHT]:\n            new_pos = current_pos\n            new_dir = current_dir\n\n            # Simulate the action to get the next position and direction\n            if action == ACTION_FORWARD:\n                dr, dc = DIRECTIONS_VECTORS[current_dir]\n                new_pos = (current_pos[0] + dr, current_pos[1] + dc)\n            elif action == ACTION_BACKWARD:\n                dr, dc = DIRECTIONS_VECTORS[current_dir]\n                new_pos = (current_pos[0] - dr, current_pos[1] - dc)\n            elif action == ACTION_TURN_LEFT:\n                new_dir = (current_dir - 1) % 4\n            elif action == ACTION_TURN_RIGHT:\n                new_dir = (current_dir + 1) % 4\n\n            # For move actions (FORWARD/BACKWARD), check if the new cell is walkable\n            if (action == ACTION_FORWARD or action == ACTION_BACKWARD):\n                if not _is_cell_walkable(grid, world, new_pos[0], new_pos[1]):\n                    continue  # Cannot move into an unwalkable cell\n\n            # If this new state (position, direction) has not been visited, add it to the queue\n            if (new_pos, new_dir) not in visited:\n                visited.add((new_pos, new_dir))\n                queue.append(_BFSQueueItem(new_pos, new_dir, actions_taken + [action]))\n\n    # If the BFS completes and no path to the primitive was found\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:48:35.806679", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:50:08.085245", "function_name": "collect", "function_body": "  actions = []\n  \n  # Reset the environment to get the initial state and inventory\n  obs = env.reset()\n  initial_inventory_count = obs['features_dict']['inventory'][primitive]\n  \n  max_total_steps = 200 # A reasonable limit to prevent infinite loops in search\n  \n  # Variables for the spiral exploration pattern\n  current_exploration_move_length = 1\n  steps_in_current_move_length = 0\n  current_phase = 0 # 0: UP, 1: RIGHT, 2: DOWN, 3: LEFT\n  move_sequence = [env_factory.ACTION_UP, env_factory.ACTION_RIGHT, \n                   env_factory.ACTION_DOWN, env_factory.ACTION_LEFT]\n  \n  # Direction offsets for the \"USE\" action (relative to agent's center in ego view)\n  # dir 0: UP (-1, 0), dir 1: RIGHT (0, 1), dir 2: DOWN (1, 0), dir 3: LEFT (0, -1)\n  dir_offsets = {0: (-1, 0), 1: (0, 1), 2: (1, 0), 3: (0, -1)}\n\n  for step_count in range(max_total_steps):\n    current_obs = env.observations()\n    current_inventory = current_obs['features_dict']['inventory']\n\n    # Check if the primitive has been collected\n    if current_inventory[primitive] > initial_inventory_count:\n      break # Goal achieved, exit loop\n\n    features_ego = current_obs['features_dict']['features_ego']\n    agent_dir = np.argmax(current_obs['features_dict']['direction'])\n    \n    ego_height, ego_width, _ = features_ego.shape\n    center_row, center_col = ego_height // 2, ego_width // 2\n\n    action_to_take = None\n\n    # Strategy 1: Check if the primitive is directly in front for a USE action\n    offset_r, offset_c = dir_offsets[agent_dir]\n    front_cell_r, front_cell_c = center_row + offset_r, center_col + offset_c\n    \n    # Ensure front_cell is within ego view bounds\n    is_valid_front_cell = (0 <= front_cell_r < ego_height and 0 <= front_cell_c < ego_width)\n\n    if is_valid_front_cell and features_ego[front_cell_r, front_cell_c, primitive] == 1:\n      action_to_take = env_factory.ACTION_USE\n    else:\n      # Strategy 2: Search for the primitive in the egocentric view for movement\n      # Find all locations where the primitive exists\n      primitive_locations = np.argwhere(features_ego[:, :, primitive] == 1)\n      \n      # Filter out the agent's own position, as collectables are usually adjacent\n      # (though features_ego[center_row, center_col, primitive] should ideally be 0)\n      primitive_locations = [loc for loc in primitive_locations if not np.array_equal(loc, [center_row, center_col])]\n\n      if len(primitive_locations) > 0:\n        # If multiple primitives, move towards the closest one (Manhattan distance implied by axis-aligned moves)\n        min_dist_sq = float('inf')\n        closest_loc = None\n        \n        for p_loc in primitive_locations:\n          # Using squared Euclidean distance for simplicity, which works for closest cell\n          dist_sq = (p_loc[0] - center_row)**2 + (p_loc[1] - center_col)**2\n          if dist_sq < min_dist_sq:\n            min_dist_sq = dist_sq\n            closest_loc = p_loc\n        \n        target_r, target_c = closest_loc\n        dr = target_r - center_row # Row difference (negative means target is \"up\" relative to agent)\n        dc = target_c - center_col # Column difference (negative means target is \"left\" relative to agent)\n\n        # Prioritize movement along the axis with the largest absolute difference\n        if abs(dr) > abs(dc):\n          if dr < 0:\n            action_to_take = env_factory.ACTION_UP\n          else:\n            action_to_take = env_factory.ACTION_DOWN\n        else: # abs(dc) >= abs(dr), or if dr == dc == 0 (should be filtered out by now)\n          if dc < 0:\n            action_to_take = env_factory.ACTION_LEFT\n          else: # dc > 0 \n            action_to_take = env_factory.ACTION_RIGHT\n      else:\n        # Strategy 3: Explore using a spiral pattern if primitive is not visible\n        action_to_take = move_sequence[current_phase]\n        steps_in_current_move_length += 1\n        \n        if steps_in_current_move_length >= current_exploration_move_length:\n          steps_in_current_move_length = 0\n          current_phase = (current_phase + 1) % 4\n          # Increase move length after every two turns (e.g., after UP and RIGHT segments)\n          if current_phase % 2 == 0: \n            current_exploration_move_length += 1\n            \n    # Add the chosen action to the list\n    actions.append(action_to_take)\n    \n    # Step the environment with the chosen action\n    reward, done, _ = env.step(action_to_take)\n    \n    # If the environment signals \"done\" (e.g., max_steps reached), stop\n    if done:\n      break\n      \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:50:08.154667", "function_name": "collect", "function_body": "    # Action constants (standard for CraftWorld/Lab)\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    actions = []\n    \n    current_state = env._current_state\n    grid = current_state.grid\n    current_pos = current_state.pos\n    \n    H, W, _ = grid.shape\n    \n    # Get indices of entities that block movement.\n    # From CraftWorld data attributes: non_grabbable_indices.\n    # Assume these are obstacles for pathfinding, unless they are the target primitive itself.\n    obstacle_kinds = env.world.non_grabbable_indices\n    \n    def is_obstacle(r, c):\n        \"\"\"Checks if cell (r,c) is out of bounds or contains an unpassable object.\"\"\"\n        if not (0 <= r < H and 0 <= c < W):\n            return True # Out of bounds\n        \n        # Check if this cell contains any obstacle kind that is not the primitive itself.\n        # This handles cases where the primitive itself might be in non_grabbable_indices (e.g., stone)\n        # but we need to move onto or through its square to get adjacent or collect it.\n        for kind_idx in obstacle_kinds:\n            if kind_idx == primitive:\n                continue # The primitive itself should not be considered an obstacle if it's our target.\n            if grid[r, c, kind_idx] > 0: # If this kind is present at (r,c)\n                return True\n        return False\n\n    # Find all locations of the primitive on the grid.\n    # This is not strictly necessary for BFS, but helps confirm if the primitive exists at all.\n    primitive_locations_on_grid = []\n    for r_idx in range(H):\n        for c_idx in range(W):\n            if grid[r_idx, c_idx, primitive] > 0:\n                primitive_locations_on_grid.append((r_idx, c_idx))\n\n    if not primitive_locations_on_grid:\n        # Primitive not found on the grid, cannot collect.\n        return []\n\n    # BFS to find the shortest path to a cell from which the primitive can be collected.\n    # A primitive can be collected if it's within the 3x3 neighborhood of the agent's current position,\n    # consistent with `CraftState.next_to()`.\n    queue = collections.deque([(current_pos, [])]) # (position, list_of_actions_to_reach_position)\n    visited = {current_pos} # Keep track of visited positions to avoid cycles and redundant paths.\n    \n    best_actions_path = []\n    found_path = False\n\n    while queue:\n        (r, c), path_actions = queue.popleft()\n\n        # Check if the current position (r,c) allows collection of the primitive.\n        # This means if 'primitive' is in the 3x3 neighborhood around (r,c), including (r,c) itself.\n        can_collect_from_here = False\n        for dr_check in [-1, 0, 1]:\n            for dc_check in [-1, 0, 1]:\n                nr_check, nc_check = r + dr_check, c + dc_check\n                # Check bounds for the neighborhood cell\n                if (0 <= nr_check < H and 0 <= nc_check < W) and grid[nr_check, nc_check, primitive] > 0:\n                    can_collect_from_here = True\n                    break\n            if can_collect_from_here:\n                break\n        \n        if can_collect_from_here:\n            # Found the shortest path to a position from which the primitive can be used.\n            best_actions_path = path_actions + [_USE]\n            found_path = True\n            break # Exit BFS, shortest path found.\n\n        # Explore neighbors (4-way movement only: UP, DOWN, LEFT, RIGHT)\n        # This defines the possible moves for the agent.\n        for dr, dc, action_val in [(-1, 0, _UP), (1, 0, _DOWN), (0, -1, _LEFT), (0, 1, _RIGHT)]:\n            nr, nc = r + dr, c + dc\n            next_pos = (nr, nc)\n\n            # Only move to valid, non-obstacle cells that haven't been visited yet.\n            if not is_obstacle(nr, nc) and next_pos not in visited:\n                visited.add(next_pos)\n                queue.append((next_pos, path_actions + [action_val]))\n                \n    return best_actions_path", "island_id": 5, "scores": {"3": -1}}
