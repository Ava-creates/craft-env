{"timestamp": "2025-07-30T07:35:53.440690", "function_name": "collect", "function_body": "    from collections import deque\n    import numpy as np\n\n    # Action constants as defined in CraftLab.action_specs\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Ensure CraftState is accessible, assuming it's available through env_factory\n    # or globally in the context this function will be placed.\n    # From the problem description, CraftState is a class, so it should be accessible.\n    try:\n        CraftState = env_factory.CraftState\n    except AttributeError:\n        # Fallback if env_factory.CraftState is not the one expected,\n        # assuming it's globally defined in the same scope as this function.\n        # This might occur if this code is pasted directly into a file defining CraftState.\n        # (Assuming CraftState from problem description is the target class)\n        # Note: This block might not be needed if env_factory correctly exposes CraftState.\n        pass # CraftState should be in scope from the provided problem description\n\n\n    obs = env.observations()\n    initial_grid = obs['features_dict']['features_global'].copy()\n    initial_pos = tuple(np.round(obs['features_dict']['pos']).astype(int))\n    initial_dir_idx = np.argmax(obs['features_dict']['direction'])\n    initial_inventory = obs['features_dict']['inventory'].copy()\n\n    # Access the CraftScenario instance from the CraftLab environment\n    scenario = env.scenario\n\n    # The total number of kinds (N_KINDS) is needed for inventory/grid dimensions\n    # It's stored in env.world.cookbook.n_kinds\n    # Ensure env.world is accessible, which it is according to CraftLab data attributes.\n    N_KINDS = env.world.cookbook.n_kinds\n\n    # Create the initial CraftState object for simulation\n    initial_sim_state = CraftState(\n        scenario, initial_grid, initial_pos, initial_dir_idx, initial_inventory\n    )\n\n    # Initialize a deque for BFS (Breadth-First Search)\n    # Each element in the queue is a tuple: (current_CraftState_object, list_of_actions_to_reach_this_state)\n    q = deque()\n    q.append((initial_sim_state, []))\n\n    # Initialize a set to store visited states to prevent cycles and redundant work.\n    # A state is defined by (agent_x, agent_y, agent_direction, count_of_primitive_in_inventory).\n    # We include primitive count to differentiate states where the same position/direction is reached\n    # but with different inventory status regarding the target primitive.\n    visited = set()\n    visited.add((initial_pos[0], initial_pos[1], initial_dir_idx, initial_inventory[primitive]))\n\n    # Define a maximum search depth to prevent excessively long searches or infinite loops\n    # in case the primitive is unreachable or the search space is too large.\n    max_search_depth = 200 # Heuristic limit, can be adjusted based on typical map sizes\n\n    while q:\n        current_state, path = q.popleft()\n\n        # Check if the goal (primitive collected) is satisfied in the current state\n        if current_state.inventory[primitive] > 0:\n            return path # Goal reached, return the sequence of actions\n\n        # Prune search if path length exceeds maximum depth\n        if len(path) >= max_search_depth:\n            continue\n\n        # Explore possible actions from the current state\n        for action in [DOWN, UP, LEFT, RIGHT, USE]:\n            # Simulate the action: get the next state\n            # CraftState.step returns (reward, new_state)\n            _, next_state = current_state.step(action)\n            next_path = path + [action]\n\n            # Create a hashable representation of the next state for the visited set\n            next_state_hash = (\n                next_state.pos[0],\n                next_state.pos[1],\n                next_state.dir,\n                next_state.inventory[primitive]\n            )\n\n            # If this state has not been visited before (with the same relevant attributes),\n            # add it to the visited set and the queue for further exploration.\n            if next_state_hash not in visited:\n                visited.add(next_state_hash)\n                q.append((next_state, next_path))\n\n    # If the queue becomes empty and the goal was not reached, the primitive is unreachable\n    # within the defined search limits.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T07:35:54.455309", "function_name": "collect", "function_body": "  import collections\n\n  # Define constants for actions based on CraftLab.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Map (dx, dy) movement to action value.\n  # Assumes agent's position is (x, y) where x is horizontal, y is vertical.\n  # (0,0) is typically top-left, y increases downwards.\n  _MOVES_TO_ACTIONS = {\n      (0, -1): DOWN,  # Change in (x,y)\n      (0, 1): UP,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT,\n  }\n  # Map action value to (dx, dy) movement for neighbor exploration\n  _ACTIONS_TO_MOVES = {v: k for k, v in _MOVES_TO_ACTIONS.items()}\n\n  def _is_walkable(r, c, grid_shape, non_grabbable_indices, grid_data):\n      \"\"\"\n      Checks if a cell (r, c) is within grid bounds and does not contain blocking items.\n      (r, c) here corresponds to (x, y) grid coordinates.\n      \"\"\"\n      width, height = grid_shape[0], grid_shape[1]\n      if not (0 <= r < width and 0 <= c < height):\n          return False\n      \n      # A cell is blocked if it contains *any* non-grabbable item.\n      for idx in non_grabbable_indices:\n          if grid_data[r, c, idx] > 0:\n              return False\n      return True\n\n  def _find_path_bfs_actions(start_pos, target_kind_idx, grid_data, world_instance):\n      \"\"\"\n      Finds a path of actions to reach/be adjacent to the target_kind_idx on the grid.\n      Returns a list of actions (int), or None if no path is found.\n      \"\"\"\n      grid_shape = grid_data.shape\n      non_grabbable_indices = world_instance.non_grabbable_indices\n      grabbable_indices = world_instance.grabbable_indices\n      \n      q = collections.deque([(start_pos, [])]) # (current_pos: (x,y), list_of_actions_so_far)\n      visited = {start_pos}\n      \n      is_target_grabbable = target_kind_idx in grabbable_indices\n      \n      while q:\n          current_pos, actions_so_far = q.popleft()\n          \n          # Check if current_pos satisfies the goal condition\n          # If target is grabbable, walking onto its cell collects it.\n          if is_target_grabbable and grid_data[current_pos[0], current_pos[1], target_kind_idx] > 0:\n              return actions_so_far # Path ends *at* the item, it's collected by walking onto it.\n          \n          # If target is non-grabbable, we need to be ADJACENT to it to use the USE action.\n          if not is_target_grabbable:\n              r_curr, c_curr = current_pos\n              # Check 4 direct neighbors of current_pos for the target_kind_idx.\n              # If any neighbor contains the target, then current_pos is adjacent.\n              for dr_adj, dc_adj in _ACTIONS_TO_MOVES.values(): # Iterate over (dx, dy) tuples for neighbors\n                  nr_adj, nc_adj = r_curr + dr_adj, c_curr + dc_adj\n                  if 0 <= nr_adj < grid_shape[0] and 0 <= nc_adj < grid_shape[1]:\n                      if grid_data[nr_adj, nc_adj, target_kind_idx] > 0:\n                          return actions_so_far # Path ends *adjacent* to the item\n                          \n          # Explore neighbors\n          for action_val, (dr, dc) in _ACTIONS_TO_MOVES.items():\n              next_r, next_c = current_pos[0] + dr, current_pos[1] + dc\n              next_pos = (next_r, next_c)\n              \n              if _is_walkable(next_r, next_c, grid_shape, non_grabbable_indices, grid_data) and \\\n                 next_pos not in visited:\n                  visited.add(next_pos)\n                  q.append((next_pos, actions_so_far + [action_val]))\n                  \n      return None # No path found\n\n  # --- Main collect_v2 logic ---\n  obs = env.observations()\n  \n  inventory = obs['features_dict']['inventory']\n  # If the primitive is already in inventory, no actions are needed.\n  if inventory[primitive] > 0:\n      return []\n\n  # Access the CraftState instance directly to get the agent's current integer grid position.\n  # This relies on the internal `_current_state` attribute of CraftLab.\n  current_pos = env._current_state.pos \n  \n  grid_data = obs['features_dict']['features_global']\n  world_instance = env.world # Get the CraftWorld instance from CraftLab for world data\n\n  # Find the sequence of movement actions to reach or be adjacent to the primitive.\n  actions = _find_path_bfs_actions(current_pos, primitive, grid_data, world_instance)\n\n  if actions is None:\n      # If no path is found, return an empty list of actions.\n      return []\n\n  # If the primitive requires a 'USE' action (i.e., it's non-grabbable), append it to the path.\n  if primitive in world_instance.non_grabbable_indices:\n      actions.append(USE)\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T07:36:40.836965", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  # Ensure position is int tuple. CraftState.pos is tuple(int, int)\n  # The features_dict['pos'] might be normalized or float, so convert to int tuple.\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  world = env.world\n  # non_grabbable_indices typically include obstacles like water, stone walls, workshops.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape\n\n  # Action constants (from problem description context)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVES = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # Offsets for 3x3 neighborhood, including the agent's own position (0,0)\n  # Used for checking CraftState.next_to logic, as the USE action requires\n  # the target item/block to be within this 3x3 area.\n  NEIGHBORHOOD_OFFSETS = [\n      (dx, dy) for dx in [-1, 0, 1] for dy in [-1, 0, 1]\n  ]\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for x in range(W):\n      for y in range(H):\n          # A cell is NOT traversable if it contains any non-grabbable item.\n          if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n              traversable_mask[x, y] = False\n  \n  # Ensure the agent's current position is marked as traversable.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] # Agent starts on an untraversable cell, no path possible.\n\n  # 2. Determine target kinds for collection.\n  # The 'primitive' input is the index of the *item* we want to collect (e.g., wood, water).\n  # Items can be collected in two ways:\n  #   a) Picked up directly if lying on the ground (check for `primitive` itself).\n  #   b) Harvested from a source block (e.g., water from a 'water' block, stone from a 'stone' block).\n  # The agent needs to be in a position where CraftState.next_to(target_kind) would be True.\n  \n  target_grid_indices = {primitive} # Always include the primitive itself for direct pickup\n\n  primitive_name = world.cookbook.index.get(primitive)\n  if primitive_name == 'water':\n      target_grid_indices.add(world.water_index) # Add water block index as a source\n  elif primitive_name == 'stone':\n      target_grid_indices.add(world.stone_index) # Add stone block index as a source\n  # Extend with more mappings if needed (e.g., 'wood' from a 'tree' block)\n\n  # 3. Perform BFS to find the shortest path to any location from which the primitive can be collected.\n  q = deque([current_pos]) \n  parent = {current_pos: (None, None)} # parent[child_pos] = (parent_pos, action_from_parent)\n  \n  found_target_pos = None\n\n  while q:\n      curr_pos = q.popleft()\n      curr_x, curr_y = curr_pos\n\n      # Check if the current position is a valid collection target\n      # A position is a target if, from this position, 'next_to' any of the\n      # target_grid_indices (primitive item or its source block) would be true.\n      is_valid_target_location = False\n      for target_idx in target_grid_indices:\n          for dx, dy in NEIGHBORHOOD_OFFSETS:\n              nx, ny = curr_x + dx, curr_y + dy\n              # Check bounds for the neighboring cell that might contain the target_idx\n              if 0 <= nx < W and 0 <= ny < H:\n                  # If a neighbor cell contains the target_idx, then curr_pos is a valid target location\n                  if grid[nx, ny, target_idx] > 0:\n                      is_valid_target_location = True\n                      break # Found a reason curr_pos is a target\n          if is_valid_target_location:\n              break # No need to check other target_grid_indices if one is found\n\n      if is_valid_target_location:\n          found_target_pos = curr_pos\n          break # Found the shortest path to a valid collection location\n\n      # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n      for action, (dx, dy) in MOVES.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # Check bounds, traversability, and if already visited (by checking `parent` dict)\n          if (0 <= next_x < W and 0 <= next_y < H and\n              traversable_mask[next_x, next_y] and # Agent cannot move onto non-grabbable obstacles\n              next_pos not in parent): # `parent` acts as a visited set\n              \n              parent[next_pos] = (curr_pos, action) # Store how we got to next_pos\n              q.append(next_pos)\n  \n  # If no path was found (e.g., primitive is unreachable or doesn't exist)\n  if found_target_pos is None:\n      return [] \n  \n  # 4. Reconstruct the path from found_target_pos back to current_pos\n  path_actions = []\n  node = found_target_pos\n  while node != current_pos:\n      prev_node, action_to_reach_node = parent[node]\n      path_actions.append(action_to_reach_node)\n      node = prev_node\n  \n  path_actions.reverse() # Reverse to get actions from start to target\n  \n  # 5. Append the USE action after the movement path.\n  actions.extend(path_actions)\n  actions.append(USE)\n  \n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T07:36:41.836631", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  # Ensure position is int tuple. CraftState.pos is tuple(int, int)\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  world = env.world\n  # non_grabbable_indices typically include obstacles like water, stone walls, workshops.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for x in range(W):\n      for y in range(H):\n          # A cell is NOT traversable if it contains any non-grabbable item.\n          if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n              traversable_mask[x, y] = False\n  \n  # Ensure the agent's current position is marked as traversable.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] # Agent starts on an untraversable cell, no path possible.\n\n  # Action constants (assuming these are globally defined or accessible)\n  # from collections import deque (assuming deque is available)\n  # import numpy as np (assuming numpy is available)\n  \n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVES = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # Offsets for 3x3 neighborhood, including the agent's own position (0,0)\n  # Used for checking CraftState.next_to logic, as the USE action requires\n  # the target item/block to be within this 3x3 area.\n  NEIGHBORHOOD_OFFSETS = [\n      (dx, dy) for dx in [-1, 0, 1] for dy in [-1, 0, 1]\n  ]\n\n  # 2. Determine target kinds for collection.\n  # The 'primitive' input is the index of the *item* we want to collect (e.g., wood, water).\n  # Items can be collected in two ways, necessitating the agent to be \"next to\" either:\n  #   a) The primitive item itself (if it's on the ground).\n  #   b) A source block that yields the primitive (e.g., water block for water item).\n  # These are the indices that, if found in the 3x3 neighborhood, make the current agent position a valid collection point.\n  \n  target_collect_indices = {primitive} # Always include the primitive item itself for direct pickup\n\n  primitive_name = world.cookbook.index.get(primitive)\n  if primitive_name == 'water':\n      target_collect_indices.add(world.water_index) # Add water block index as a source\n  elif primitive_name == 'stone':\n      target_collect_indices.add(world.stone_index) # Add stone block index as a source\n  # Extend with more mappings if other primitives have specific source blocks (e.g., 'wood' from 'tree')\n\n  # 3. Perform BFS to find the shortest path to any location from which the primitive can be collected.\n  q = deque([current_pos]) \n  parent = {current_pos: (None, None)} # parent[child_pos] = (parent_pos, action_from_parent)\n  \n  found_target_agent_pos = None\n\n  while q:\n      curr_agent_x, curr_agent_y = q.popleft()\n      curr_agent_pos = (curr_agent_x, curr_agent_y)\n\n      # Check if the current agent position `curr_agent_pos` is a valid collection target.\n      # A position is a target if, from this position, 'next_to' any of the\n      # `target_collect_indices` would be true.\n      is_valid_collection_location = False\n      for target_idx in target_collect_indices:\n          for dx, dy in NEIGHBORHOOD_OFFSETS:\n              # Check the cell in the neighborhood of `curr_agent_pos`\n              potential_target_block_x, potential_target_block_y = curr_agent_x + dx, curr_agent_y + dy\n              \n              # Check bounds for this potential target block cell\n              if (0 <= potential_target_block_x < W and 0 <= potential_target_block_y < H):\n                  # If this neighboring cell contains the `target_idx`, then `curr_agent_pos`\n                  # is a valid location to USE from.\n                  if grid[potential_target_block_x, potential_target_block_y, target_idx] > 0:\n                      is_valid_collection_location = True\n                      break # Found a reason curr_agent_pos is a target\n          if is_valid_collection_location:\n              break # No need to check other target_collect_indices if one is found\n\n      if is_valid_collection_location:\n          found_target_agent_pos = curr_agent_pos\n          break # Found the shortest path to a valid collection location for the agent\n\n      # Explore neighbors (UP, DOWN, LEFT, RIGHT) for the agent's next move\n      for action, (dx, dy) in MOVES.items():\n          next_agent_x, next_agent_y = curr_agent_x + dx, curr_agent_y + dy\n          next_agent_pos = (next_agent_x, next_agent_y)\n\n          # Check bounds, traversability, and if already visited (by checking `parent` dict)\n          if (0 <= next_agent_x < W and 0 <= next_agent_y < H and\n              traversable_mask[next_agent_x, next_agent_y] and # Agent cannot move onto non-grabbable obstacles\n              next_agent_pos not in parent): # `parent` also acts as visited set\n              \n              parent[next_agent_pos] = (curr_agent_pos, action) # Store how we got to next_agent_pos\n              q.append(next_agent_pos)\n  \n  # If no path was found (e.g., primitive is unreachable or doesn't exist)\n  if found_target_agent_pos is None:\n      return [] \n  \n  # 4. Reconstruct the path from found_target_agent_pos back to current_pos\n  path_actions = []\n  node = found_target_agent_pos\n  while node != current_pos:\n      prev_node, action_to_reach_node = parent[node]\n      path_actions.append(action_to_reach_node)\n      node = prev_node\n  \n  path_actions.reverse() # Reverse to get actions from start to target\n  \n  # 5. Append the USE action after the movement path.\n  actions.extend(path_actions)\n  actions.append(USE)\n  \n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T07:37:29.924827", "function_name": "collect", "function_body": "  import collections\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  # When an agent performs a movement action, it also faces that direction.\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map agent's direction integer to its (dx, dy) vector (change in position)\n  # This vector indicates the cell directly in front of the agent.\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y-coordinate\n      1: (1, 0),   # RIGHT: increases x-coordinate\n      2: (0, 1),   # DOWN: increases y-coordinate\n      3: (-1, 0)   # LEFT: decreases x-coordinate\n  }\n\n  # Pre-check: If the primitive is not a grabbable item, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get the initial state details for the BFS starting point\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Identify indices of entities that block movement (non-grabbable items like water, workshops etc.)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to determine if a cell is traversable.\n  def is_walkable(x, y):\n    # Check if the coordinates are within grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell contains any non-grabbable item that acts as an obstacle.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False # Cell is blocked by an obstacle\n    return True\n\n  # Initialize Breadth-First Search (BFS)\n  # Queue stores tuples: (current_x, current_y, current_direction)\n  queue = collections.deque([(start_x, start_y, start_dir)])\n\n  # Set to keep track of visited states (position and direction) to avoid cycles and redundant paths.\n  visited = set([(start_x, start_y, start_dir)])\n\n  # Dictionary to reconstruct the path: maps (current_state) -> (parent_state, action_from_parent)\n  parent_info = {}\n\n  goal_state_pre_use = None # Stores the state right before the final 'USE' action\n\n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft() # Dequeue the current state\n\n    # Check if the primitive can be collected from the current state.\n    # The 'USE' action affects the cell directly in front of the agent.\n    faced_dx, faced_dy = DIR_VEC[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # If the cell in front is within bounds and contains the target primitive:\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Goal reached! Store this state and break BFS.\n      goal_state_pre_use = (curr_x, curr_y, curr_dir)\n      break\n\n    # Explore all possible movement actions from the current state.\n    # Each movement action also sets the agent's new facing direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new position after performing this action.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # The agent's new facing direction\n      next_state_tuple = (next_x, next_y, next_dir)\n\n      # If the next cell is walkable and this new (position, direction) state has not been visited yet:\n      if is_walkable(next_x, next_y) and next_state_tuple not in visited:\n        visited.add(next_state_tuple)\n        # Store parent information for path reconstruction.\n        parent_info[next_state_tuple] = ((curr_x, curr_y, curr_dir), action)\n        queue.append(next_state_tuple)\n\n  # If no path was found (goal_state_pre_use remains None), return an empty list.\n  if goal_state_pre_use is None:\n    return []\n\n  # Reconstruct the path by backtracking from the goal state.\n  actions = [ACTION_USE] # The final action is always 'USE'\n\n  current_state = goal_state_pre_use\n  start_state_tuple = (start_x, start_y, start_dir)\n\n  # Backtrack until we reach the starting state\n  while current_state != start_state_tuple:\n    # Get the parent state and the action taken to reach current_state from parent.\n    parent_state, action_from_parent = parent_info[current_state]\n    actions.append(action_from_parent)\n    current_state = parent_state\n\n  # The path was built in reverse order, so reverse it to get the correct sequence.\n  return actions[::-1]", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T07:37:30.929613", "function_name": "collect", "function_body": "  import collections # Import necessary for deque\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  # When an agent performs a movement action, it also faces that direction.\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map agent's direction integer to its (dx, dy) vector (change in position)\n  # This vector indicates the cell directly in front of the agent.\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y-coordinate\n      1: (1, 0),   # RIGHT: increases x-coordinate\n      2: (0, 1),   # DOWN: increases y-coordinate\n      3: (-1, 0)   # LEFT: decreases x-coordinate\n  }\n\n  # Pre-check: If the primitive is not a grabbable item, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get the initial state details for the BFS starting point\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Identify indices of entities that block movement (non-grabbable items like water, workshops etc.)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to determine if a cell is traversable.\n  def is_walkable(x, y):\n    # Check if the coordinates are within grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell contains any non-grabbable item that acts as an obstacle.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False # Cell is blocked by an obstacle\n    return True\n\n  # Initialize Breadth-First Search (BFS)\n  # Queue stores tuples: (current_x, current_y, current_direction)\n  queue = collections.deque([(start_x, start_y, start_dir)])\n\n  # Set to keep track of visited states (position and direction) to avoid cycles and redundant paths.\n  visited = set([(start_x, start_y, start_dir)])\n\n  # Dictionary to reconstruct the path: maps (current_state) -> (parent_state, action_from_parent)\n  parent_info = {}\n\n  goal_state_pre_use = None # Stores the state right before the final 'USE' action\n\n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft() # Dequeue the current state\n\n    # Check if the primitive can be collected from the current state.\n    # The 'USE' action affects the cell directly in front of the agent.\n    faced_dx, faced_dy = DIR_VEC[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # If the cell in front is within bounds and contains the target primitive:\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Goal reached! Store this state and break BFS.\n      goal_state_pre_use = (curr_x, curr_y, curr_dir)\n      break\n\n    # Explore all possible movement actions from the current state.\n    # Each movement action also sets the agent's new facing direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new position after performing this action.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # The agent's new facing direction\n      next_state_tuple = (next_x, next_y, next_dir)\n\n      # If the next cell is walkable and this new (position, direction) state has not been visited yet:\n      if is_walkable(next_x, next_y) and next_state_tuple not in visited:\n        visited.add(next_state_tuple)\n        # Store parent information for path reconstruction.\n        parent_info[next_state_tuple] = ((curr_x, curr_y, curr_dir), action)\n        queue.append(next_state_tuple) # Enqueue the new state\n\n  # If no path was found (goal_state_pre_use remains None), return an empty list.\n  if goal_state_pre_use is None:\n    return []\n\n  # Reconstruct the path by backtracking from the goal state.\n  actions = [ACTION_USE] # The final action is always 'USE'\n\n  current_state_in_path = goal_state_pre_use\n  start_state_tuple = (start_x, start_y, start_dir)\n\n  # Backtrack until we reach the starting state\n  while current_state_in_path != start_state_tuple:\n    # Get the parent state and the action taken to reach current_state_in_path from parent.\n    parent_state, action_from_parent = parent_info[current_state_in_path]\n    actions.append(action_from_parent)\n    current_state_in_path = parent_state\n\n  # The path was built in reverse order, so reverse it to get the correct sequence.\n  return actions[::-1]", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T07:38:35.885328", "function_name": "collect", "function_body": "    import collections\n\n    # Define action constants based on CraftLab.action_specs()\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    # Delta movements for each action (row, col)\n    _DELTAS = {\n        _DOWN: (1, 0),\n        _UP: (-1, 0),\n        _LEFT: (0, -1),\n        _RIGHT: (0, 1)\n    }\n    _MOVE_ACTIONS = [_DOWN, _UP, _LEFT, _RIGHT]\n\n    # Get the current state from the environment\n    current_state = env._current_state\n\n    # 1. Check if the primitive is already in the inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    start_pos = current_state.pos\n    grid_height, grid_width, _ = grid.shape\n\n    # 2. Find all locations where the primitive exists on the grid\n    primitive_object_locations = set()\n    for r in range(grid_height):\n        for c in range(grid_width):\n            if grid[r, c, primitive] == 1:\n                primitive_object_locations.add((r, c))\n\n    if not primitive_object_locations:\n        # Primitive not found anywhere on the grid\n        return []\n\n    # 3. Calculate all \"target\" positions: cells where an agent can stand\n    #    to be able to \"USE\" the primitive. This includes the primitive's cell\n    #    and its 8 neighbors (3x3 area around each primitive object).\n    target_positions = set()\n    for pr, pc in primitive_object_locations:\n        for dr in [-1, 0, 1]:  # delta row\n            for dc in [-1, 0, 1]:  # delta col\n                nr, nc = pr + dr, pc + dc\n                # Check bounds\n                if 0 <= nr < grid_height and 0 <= nc < grid_width:\n                    target_positions.add((nr, nc))\n\n    # 4. If the agent is already at a target position and can use the item\n    #    (i.e., it's next to the primitive based on CraftState.next_to logic)\n    if current_state.next_to(primitive):\n        return [_USE]\n\n    # 5. BFS to find the shortest path from the agent's current position\n    #    to any of the calculated target_positions.\n    q = collections.deque([(start_pos, [])])  # (position, path_actions_taken_to_reach_here)\n    visited = {start_pos}\n    \n    path_to_target = []\n    found_path = False\n\n    while q:\n        curr_pos, curr_actions = q.popleft()\n\n        # If the current position is one of our target positions, we found a path\n        if curr_pos in target_positions:\n            path_to_target = curr_actions\n            found_path = True\n            break\n\n        # Explore neighbors\n        for action in _MOVE_ACTIONS:\n            dr, dc = _DELTAS[action]\n            next_pos = (curr_pos[0] + dr, curr_pos[1] + dc)\n            \n            nr, nc = next_pos\n            if (0 <= nr < grid_height and 0 <= nc < grid_width and \n                    next_pos not in visited):\n                visited.add(next_pos)\n                q.append((next_pos, curr_actions + [action]))\n\n    # 6. Construct the final action list\n    if found_path:\n        # Append the USE action after reaching the target position\n        path_to_target.append(_USE)\n        return path_to_target\n    else:\n        # Primitive is not reachable (e.g., surrounded by unpassable terrain,\n        # or no path found to any of its adjacent cells)\n        return []", "island_id": 0, "scores": {"3": -1}}
