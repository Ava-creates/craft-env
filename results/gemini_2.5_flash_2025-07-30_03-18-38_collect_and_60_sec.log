{"timestamp": "2025-07-30T22:19:59.781595", "function_name": "collect", "function_body": "    import collections # For deque\n\n    # Actions based on action_specs provided in the CraftLab class description.\n    # These integer mappings are specific to the CraftWorld environment.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Map movement actions to their effect on (delta_row, delta_col) and the agent's new facing direction.\n    # In CraftWorld, the agent's direction changes to the direction of its last movement.\n    ACTION_TO_EFFECT = {\n        UP: ((-1, 0), 0),    # Move North (decreases row), agent faces North (dir 0)\n        RIGHT: ((0, 1), 1),  # Move East (increases col), agent faces East (dir 1)\n        DOWN: ((1, 0), 2),   # Move South (increases row), agent faces South (dir 2)\n        LEFT: ((0, -1), 3),  # Move West (decreases col), agent faces West (dir 3)\n    }\n\n    # Map direction index to (delta_row, delta_col) indicating the cell directly in front of the agent.\n    # This is used to determine which cell the 'USE' action would target.\n    DIR_TO_FORWARD_DELTA = {\n        0: (-1, 0),  # North: cell above current row\n        1: (0, 1),   # East: cell to the right of current column\n        2: (1, 0),   # South: cell below current row\n        3: (0, -1)   # West: cell to the left of current column\n    }\n\n    # Retrieve the current state components from the CraftLab environment.\n    # `env._current_state` holds the active `CraftState` instance.\n    initial_state = env._current_state\n    initial_grid = initial_state.grid\n    initial_pos = initial_state.pos\n    initial_dir = initial_state.dir\n\n    # Pre-check: If the primitive is already in the agent's inventory, no actions are needed.\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    # Determine grid dimensions from the initial grid.\n    height, width, _ = initial_grid.shape\n\n    # Identify all locations on the grid where the target primitive resource is present.\n    # We iterate through the grid and find cells where the primitive's channel is active (value is 1).\n    primitive_locations = []\n    for r_idx in range(height):\n        for c_idx in range(width):\n            if initial_grid[r_idx, c_idx, primitive] == 1:\n                primitive_locations.append((r_idx, c_idx))\n\n    # If the primitive is not found anywhere on the grid, it cannot be collected directly.\n    # Return an empty list indicating that no plan is possible.\n    if not primitive_locations:\n        return []\n\n    # Initialize the Breadth-First Search (BFS) queue.\n    # Each element in the queue is a tuple: (current_row, current_col, current_direction, list_of_actions_taken_to_reach_this_state).\n    q = collections.deque()\n    q.append((initial_pos[0], initial_pos[1], initial_dir, []))\n\n    # Initialize a set to keep track of visited states.\n    # A state is defined by (row, col, direction) to avoid redundant exploration and infinite loops.\n    visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n    # Helper function to check if a given grid position is within the valid bounds.\n    # This implementation assumes all cells within bounds are traversable (no static obstacles like walls).\n    def is_valid_pos(r, c):\n        return 0 <= r < height and 0 <= c < width\n\n    # Main BFS loop to find the shortest action sequence.\n    while q:\n        r, c, d, path = q.popleft()\n\n        # GOAL CHECK:\n        # At each state, check if the agent is positioned correctly to collect the primitive using the 'USE' action.\n        # This involves calculating the cell directly in front of the agent.\n        dr_f, dc_f = DIR_TO_FORWARD_DELTA[d]\n        front_r, front_c = r + dr_f, c + dc_f\n\n        # If the cell in front is within grid bounds...\n        if is_valid_pos(front_r, front_c):\n            # ...and if that cell contains one of the target primitive locations...\n            if (front_r, front_c) in primitive_locations:\n                # ...then we have found a valid path to collect the primitive.\n                # Append the 'USE' action to the current path and return the complete sequence.\n                return path + [USE]\n\n        # EXPLORE NEIGHBORS (Movement Actions):\n        # Iterate through all possible movement actions (UP, DOWN, LEFT, RIGHT).\n        for action_val in [UP, DOWN, LEFT, RIGHT]:\n            (dr_move, dc_move), new_dir = ACTION_TO_EFFECT[action_val]\n            next_r, next_c = r + dr_move, c + dc_move\n\n            # Check if the potential next position is valid (within grid bounds)\n            # and if this new state (position + direction) has not been visited before.\n            if is_valid_pos(next_r, next_c) and (next_r, next_c, new_dir) not in visited:\n                # Mark the new state as visited.\n                visited.add((next_r, next_c, new_dir))\n                # Add the new state to the queue for further exploration,\n                # appending the current action to the path.\n                q.append((next_r, next_c, new_dir, path + [action_val]))\n\n    # If the BFS completes without finding any path to collect the primitive (i.e., the queue becomes empty),\n    # return an empty list, indicating that the primitive cannot be collected from the initial state\n    # under the given assumptions.\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:20:00.759283", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (assuming these map to integers 0-4 as per CraftLab.action_specs).\n  # These are typically defined in a module like env_factory or as global constants.\n  # Given `import env_factory` is at the top level, we can assume its constants are available.\n  try:\n    DOWN = env_factory.DOWN\n    UP = env_factory.UP\n    LEFT = env_factory.LEFT\n    RIGHT = env_factory.RIGHT\n    USE = env_factory.USE\n    ALL_ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n  except AttributeError:\n    # Fallback if env_factory does not define these, or is not set up that way.\n    # This provides robustness in environments where env_factory constants might not be direct attributes.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n    ALL_ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n\n  MAX_SEARCH_DEPTH = 50 # A reasonable limit for BFS depth to prevent excessive computation time.\n\n  # 1. Reset the environment to a consistent initial state for planning.\n  # This ensures the generated action sequence is valid from a fresh start.\n  _initial_observations = env.reset(seed=0)\n  initial_craft_state = env._current_state # Access the internal CraftState for BFS planning.\n\n  # 2. Check if the primitive is already present in the initial inventory.\n  if initial_craft_state.inventory[primitive] > 0:\n    return [] # If already collected, no actions are needed.\n\n  # 3. Initialize BFS structures.\n  queue = collections.deque()\n  # Each element in the queue is a tuple: (current_CraftState_object, list_of_actions_taken_to_reach_this_state)\n  queue.append((initial_craft_state, []))\n\n  # `visited` set to store unique state keys, preventing redundant exploration and infinite loops.\n  # A state key uniquely identifies a CraftState. For numpy arrays (grid, inventory),\n  # converting them to bytes (using .tobytes()) makes them hashable and efficient.\n  def get_state_key(state):\n    return (state.pos, state.dir, state.inventory.tobytes(), state.grid.tobytes())\n\n  visited = set()\n  visited.add(get_state_key(initial_craft_state))\n\n  # 4. Perform a Breadth-First Search to find the shortest sequence of actions.\n  while queue:\n    current_state, current_actions = queue.popleft()\n\n    # Prune this search path if it exceeds the maximum allowed depth.\n    if len(current_actions) >= MAX_SEARCH_DEPTH:\n      continue # Skip further exploration from this path.\n\n    # Check if the current state satisfies the goal (primitive has been collected).\n    if current_state.inventory[primitive] > 0:\n      return current_actions # Goal reached! Return the found sequence of actions.\n\n    # Explore all possible next actions from the current state.\n    for action in ALL_ACTIONS:\n      # Simulate the action: CraftState.step returns a *new* CraftState instance.\n      # This is crucial for BFS, as it allows exploring hypothetical future states without\n      # modifying the actual `env`'s current state.\n      _reward, next_state = current_state.step(action)\n      next_actions = current_actions + [action]\n      next_state_key = get_state_key(next_state)\n\n      # If this next state has not been visited before, add it to the queue for exploration.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        queue.append((next_state, next_actions))\n\n  # 5. If the queue becomes empty and the goal was not found within the search limits,\n  # it means no path to collect the primitive was discovered.\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:21:40.318042", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants (from CraftLab.action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map movement action to its corresponding (dx, dy) displacement\n  # (dx, dy) for (column, row) or (x, y) coordinates\n  ACTION_TO_DELTA = {\n      UP: (0, -1),   # Moving UP means y-1\n      DOWN: (0, 1),  # Moving DOWN means y+1\n      LEFT: (-1, 0), # Moving LEFT means x-1\n      RIGHT: (1, 0), # Moving RIGHT means x+1\n  }\n\n  state = env._current_state\n  \n  initial_pos = state.pos  # (x, y)\n  grid = state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 1. Check if the agent is already in a position to collect the primitive.\n  # The agent's current direction (state.dir) determines which cell 'USE' affects.\n  # state.dir is an int (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT) corresponding to action values.\n  current_x, current_y = initial_pos\n  current_dir_action = state.dir \n  \n  if current_dir_action in ACTION_TO_DELTA: # Ensure it's a valid cardinal direction\n      faced_dx, faced_dy = ACTION_TO_DELTA[current_dir_action]\n      faced_x, faced_y = current_x + faced_dx, current_y + faced_dy\n      \n      # Check if the faced cell is within bounds and contains the primitive\n      if (0 <= faced_x < WIDTH and 0 <= faced_y < HEIGHT and\n          grid[faced_x, faced_y, primitive] > 0):\n          return [USE] # Agent is already positioned and facing, just use it.\n\n  # 2. Find all locations of the primitive in the grid.\n  primitive_locations = []\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          if grid[x, y, primitive] > 0: # Assuming value > 0 indicates presence\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # Primitive not found anywhere on the grid\n      return []\n\n  # 3. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a cell from which the primitive can be collected.\n  # BFS queue stores (current_x, current_y, list_of_actions_to_reach_here)\n  queue = collections.deque()\n  queue.append((initial_pos[0], initial_pos[1], []))\n  \n  # Visited set stores (x, y) coordinates to prevent redundant exploration and cycles\n  visited = set()\n  visited.add((initial_pos[0], initial_pos[1]))\n\n  while queue:\n      curr_x, curr_y, path_actions = queue.popleft()\n\n      # Explore all four possible movement actions from the current cell\n      for action, (dx, dy) in ACTION_TO_DELTA.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n\n          # Check boundary conditions\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check if this cell has been visited\n          if (next_x, next_y) in visited:\n              continue\n          \n          # Add to visited set\n          visited.add((next_x, next_y))\n          new_path_actions = path_actions + [action]\n\n          # After moving to (next_x, next_y) with 'action', the agent's facing direction\n          # is implied to be the direction of 'action'.\n          # We need to check if, from this 'next_x, next_y' position and facing 'action's direction,\n          # the agent would be facing the target primitive.\n          \n          # Calculate the cell that would be affected by the 'USE' action\n          # if the agent takes 'action' to get to (next_x, next_y)\n          target_faced_x = next_x + dx # dx from ACTION_TO_DELTA for the current 'action'\n          target_faced_y = next_y + dy # dy from ACTION_TO_DELTA for the current 'action'\n\n          # Check if this calculated 'target_faced' position contains the desired primitive\n          # and is a valid grid cell.\n          if (0 <= target_faced_x < WIDTH and 0 <= target_faced_y < HEIGHT and\n              grid[target_faced_x, target_faced_y, primitive] > 0):\n              \n              # Found a path to an adjacent cell, and the primitive is correctly in front.\n              return new_path_actions + [USE]\n          \n          # If not a goal state, continue BFS by enqueuing the next position\n          queue.append((next_x, next_y, new_path_actions))\n\n  # If BFS completes and no path to collect the primitive is found\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:21:41.293478", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:23:09.605449", "function_name": "collect", "function_body": "  import collections # This import must be inside the function to adhere to the prompt's constraints.\n\n  # Helper function for BFS pathfinding, defined as a nested function.\n  def _find_path_to_adjacent(start_pos, target_item_pos, grid, water_index, WIDTH, HEIGHT, action_constants):\n      \"\"\"\n      Finds the shortest path from start_pos to any cell adjacent to target_item_pos.\n      Returns a list of actions (UP, DOWN, LEFT, RIGHT).\n      \"\"\"\n      # Retrieve action constants from the dictionary passed in.\n      UP, DOWN, LEFT, RIGHT = action_constants['UP'], action_constants['DOWN'], action_constants['LEFT'], action_constants['RIGHT']\n\n      # Determine walkable cells: those not containing water.\n      walkable_cells = (grid[:, :, water_index] == 0)\n\n      # Check if the target item position itself is within valid grid bounds.\n      if not (0 <= target_item_pos[0] < WIDTH and 0 <= target_item_pos[1] < HEIGHT):\n          return None # Target item is out of bounds, no path to an adjacent cell.\n\n      q = collections.deque([(start_pos, [])])\n      visited = {start_pos}\n\n      # Define possible moves and their corresponding actions.\n      moves = [\n          (0, -1, UP),    # Move Up (decrement y)\n          (0, 1, DOWN),   # Move Down (increment y)\n          (-1, 0, LEFT),  # Move Left (decrement x)\n          (1, 0, RIGHT)   # Move Right (increment x)\n      ]\n\n      while q:\n          current_node, current_path = q.popleft()\n\n          # Check if the current node is adjacent to the target item position (Manhattan distance of 1).\n          if abs(current_node[0] - target_item_pos[0]) + abs(current_node[1] - target_item_pos[1]) == 1:\n              return current_path # Path found to an adjacent cell.\n\n          for dx, dy, action in moves:\n              next_node = (current_node[0] + dx, current_node[1] + dy)\n\n              # Check if the next node is within grid bounds, is walkable, and has not been visited.\n              if (0 <= next_node[0] < WIDTH and\n                  0 <= next_node[1] < HEIGHT and\n                  walkable_cells[next_node[0], next_node[1]] and\n                  next_node not in visited):\n                  \n                  visited.add(next_node)\n                  q.append((next_node, current_path + [action]))\n      \n      return None # No path found to any cell adjacent to the target item.\n\n  # --- Start of collect_v2 function logic ---\n\n  # 1. Get current observation from the environment.\n  obs = env.observations()\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  inventory = obs['features_dict']['inventory']\n  if inventory[primitive] > 0:\n    return [] # Primitive is already collected, no actions needed.\n\n  # 3. Get the current grid state and agent's position.\n  current_grid = obs['features_dict']['features_global']\n  \n  # Get essential information from the CraftWorld instance via the environment.\n  world = env.world\n  water_index = world.water_index\n  WIDTH, HEIGHT, _ = current_grid.shape\n\n  # The 'pos' in features_dict is normalized (0.0 to 1.0). Denormalize it to grid coordinates.\n  # Assuming normalization maps (0,0) to (0.0,0.0) and (WIDTH-1, HEIGHT-1) to (1.0,1.0).\n  current_pos_normalized = obs['features_dict']['pos']\n  current_pos = (int(round(current_pos_normalized[0] * (WIDTH - 1))), \n                 int(round(current_pos_normalized[1] * (HEIGHT - 1))))\n  \n  # 4. Get action constants from the environment's action_specs for robustness.\n  action_specs_dict = {name: val for name, val in env.action_specs().items()}\n  \n  # 5. Find all locations on the grid where the primitive exists.\n  primitive_candidates = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      if current_grid[x, y, primitive] == 1:\n        primitive_candidates.append((x, y))\n  \n  if not primitive_candidates:\n    return [] # Primitive not found anywhere on the grid.\n\n  # 6. Find the shortest path to an adjacent cell of any found primitive instance.\n  best_path_actions = None\n  min_path_len = float('inf')\n\n  for candidate_pos in primitive_candidates:\n    # Call the nested helper function to find a path to an adjacent cell.\n    path = _find_path_to_adjacent(current_pos, candidate_pos, current_grid, water_index, WIDTH, HEIGHT, action_specs_dict)\n    \n    # Update if this path is shorter than any found so far.\n    if path is not None and len(path) < min_path_len:\n      min_path_len = len(path)\n      best_path_actions = path\n  \n  if best_path_actions is None:\n    return [] # Primitive found, but no reachable adjacent cell.\n\n  # 7. Construct the final action sequence: path to adjacent cell + USE action.\n  USE_ACTION = action_specs_dict[\"USE\"]\n  return best_path_actions + [USE_ACTION]", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:23:09.674989", "function_name": "collect", "function_body": "    ACTION_MAP = {\n        \"DOWN\": 0,\n        \"UP\": 1,\n        \"LEFT\": 2,\n        \"RIGHT\": 3,\n        \"USE\": 4,\n    }\n    MOVE_DELTAS = {\n        ACTION_MAP[\"DOWN\"]: (1, 0),  # (dy, dx) for moving Y+ (down)\n        ACTION_MAP[\"UP\"]: (-1, 0),   # (dy, dx) for moving Y- (up)\n        ACTION_MAP[\"LEFT\"]: (0, -1), # (dy, dx) for moving X- (left)\n        ACTION_MAP[\"RIGHT\"]: (0, 1), # (dy, dx) for moving X+ (right)\n    }\n\n    obs = env.observations()\n    current_grid = obs['features_dict']['features_global']\n    # Agent's position is normalized in features_dict\n    norm_pos_y, norm_pos_x = obs['features_dict']['pos']\n\n    height, width, _ = current_grid.shape\n    # Convert normalized position back to grid coordinates\n    current_pos_y = int(norm_pos_y * height)\n    current_pos_x = int(norm_pos_x * width)\n\n    primitive_idx = primitive\n\n    primitive_locations = []\n    for y in range(height):\n        for x in range(width):\n            if current_grid[y, x, primitive_idx] == 1.0:\n                primitive_locations.append((y, x))\n\n    if not primitive_locations:\n        return [] # No primitive of this kind found on the grid\n\n    # Find the closest primitive location using Manhattan distance\n    closest_primitive_pos = None\n    min_dist = float('inf')\n    for py, px in primitive_locations:\n        dist = abs(py - current_pos_y) + abs(px - current_pos_x)\n        if dist < min_dist:\n            min_dist = dist\n            closest_primitive_pos = (py, px)\n\n    target_py, target_px = closest_primitive_pos\n\n    # Use BFS to find the shortest path to a cell adjacent to the target primitive\n    q = collections.deque()\n    # Queue stores (current_y, current_x, path_taken_so_far)\n    q.append((current_pos_y, current_pos_x, []))\n    visited = set([(current_pos_y, current_pos_x)])\n\n    path_to_adj = []\n\n    while q:\n        y, x, path = q.popleft()\n\n        # Check if the current (y,x) position is adjacent to the closest_primitive_pos\n        # An agent can use an item if it's in an adjacent cell.\n        if abs(y - target_py) + abs(x - target_px) == 1:\n            path_to_adj = path\n            break # Found the shortest path to an adjacent cell\n\n        # Explore valid neighboring cells\n        for action, (dy, dx) in MOVE_DELTAS.items():\n            next_y, next_x = y + dy, x + dx\n\n            # Check boundary conditions\n            if not (0 <= next_y < height and 0 <= next_x < width):\n                continue\n\n            # Check if the next cell is blocked by a non-grabbable item (obstacle)\n            is_blocked = False\n            for kind_idx in env.world.non_grabbable_indices:\n                if current_grid[next_y, next_x, kind_idx] == 1.0:\n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue\n\n            # If not visited and not blocked, add to queue\n            if (next_y, next_x) not in visited:\n                visited.add((next_y, next_x))\n                q.append((next_y, next_x, path + [action]))\n\n    if not path_to_adj:\n        # No path found to any cell adjacent to the primitive\n        return []\n\n    # Once adjacent, use the 'USE' action to collect the primitive\n    return path_to_adj + [ACTION_MAP[\"USE\"]]", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:25:10.751412", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants\n  ACTIONS = {\n      \"DOWN\": 0,\n      \"UP\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4,\n  }\n\n  # Define direction constants (N=0, E=1, S=2, W=3)\n  DIRECTIONS = {\n      \"N\": 0,\n      \"E\": 1,\n      \"S\": 2,\n      \"W\": 3,\n  }\n\n  # Delta for cardinal movements based on action\n  # Assumes agent moves in the specified cardinal direction\n  _MOVE_DELTAS = {\n      ACTIONS[\"UP\"]: (-1, 0),    # North: row-1\n      ACTIONS[\"DOWN\"]: (1, 0),   # South: row+1\n      ACTIONS[\"LEFT\"]: (0, -1),  # West: col-1\n      ACTIONS[\"RIGHT\"]: (0, 1),  # East: col+1\n  }\n\n  # Delta for target cell based on current facing direction\n  # Assumes USE action targets the cell directly in front of the agent\n  _DIR_TO_DELTA = {\n      DIRECTIONS[\"N\"]: (-1, 0),\n      DIRECTIONS[\"E\"]: (0, 1),\n      DIRECTIONS[\"S\"]: (1, 0),\n      DIRECTIONS[\"W\"]: (0, -1),\n  }\n\n  # Map delta (dr, dc) to facing direction.\n  # Assumes agent's facing direction updates to the direction of its last movement.\n  _DELTAS_TO_DIR = {\n      (-1, 0): DIRECTIONS[\"N\"],\n      (0, 1): DIRECTIONS[\"E\"],\n      (1, 0): DIRECTIONS[\"S\"],\n      (0, -1): DIRECTIONS[\"W\"],\n  }\n\n  # Get initial state and world information\n  # Resetting the environment to ensure a consistent starting point for pathfinding\n  obs = env.reset(seed=0)\n  initial_state = obs['features_dict']\n  \n  grid = initial_state['features_global']\n  pos_norm = initial_state['pos']\n  # Convert normalized position to grid coordinates (row, col)\n  current_r = int(pos_norm[0] * grid.shape[0])\n  current_c = int(pos_norm[1] * grid.shape[1])\n  current_dir = np.argmax(initial_state['direction'])\n  inventory = initial_state['inventory']\n\n  HEIGHT, WIDTH, N_KINDS = grid.shape\n\n  # If the primitive is already in the inventory, no actions are needed\n  if inventory[primitive] > 0:\n    return []\n\n  # Define unwalkable terrain kinds.\n  # For CraftWorld, 'water' is typically an obstacle.\n  # More complex environments might have other fixed obstacles like walls.\n  unwalkable_kinds = {env.world.water_index}\n\n  q = collections.deque()\n  visited = set() # Stores (row, col, direction) tuples to avoid cycles and redundant exploration\n\n  # Initial state: (current_row, current_col, current_facing_direction, list_of_actions_taken_to_reach_here)\n  q.append((current_r, current_c, current_dir, []))\n  visited.add((current_r, current_c, current_dir))\n\n  while q:\n    r, c, d, path_actions = q.popleft()\n\n    # 1. Check if the agent can collect the primitive from the current state (r, c, d)\n    # The USE action targets the cell directly in front of the agent.\n    target_dr, target_dc = _DIR_TO_DELTA[d]\n    target_r, target_c = r + target_dr, c + target_dc\n\n    # Check if the target cell is within grid bounds\n    if 0 <= target_r < HEIGHT and 0 <= target_c < WIDTH:\n      # Check if the primitive exists at the target cell.\n      # If grid[target_r, target_c, primitive] > 0, it means the item is there.\n      if grid[target_r, target_c, primitive] > 0:\n        # We found a path to a state where applying the USE action will collect the primitive.\n        return path_actions + [ACTIONS[\"USE\"]]\n\n    # 2. Explore movement actions (UP, DOWN, LEFT, RIGHT)\n    for action_id, (dr_move, dc_move) in _MOVE_DELTAS.items():\n      new_r, new_c = r + dr_move, c + dc_move\n      # Agent's facing direction updates to the direction of its movement\n      new_d = _DELTAS_TO_DIR[(dr_move, dc_move)]\n\n      # Check if the new cell is within grid bounds\n      if not (0 <= new_r < HEIGHT and 0 <= new_c < WIDTH):\n        continue\n\n      # Check if the new cell is walkable (does not contain any unwalkable kinds)\n      is_unwalkable = False\n      for k in unwalkable_kinds:\n        if grid[new_r, new_c, k] > 0:\n          is_unwalkable = True\n          break\n      if is_unwalkable:\n        continue\n\n      # If this new state (position and direction) has not been visited, add it to the queue\n      if (new_r, new_c, new_d) not in visited:\n        visited.add((new_r, new_c, new_d))\n        q.append((new_r, new_c, new_d, path_actions + [action_id]))\n\n  # If the BFS queue becomes empty and no path to collect the primitive is found\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:25:11.738385", "function_name": "collect", "function_body": "  import collections\n\n  def bfs_path(grid, start_pos, target_pos, non_grabbables, width, height):\n      \"\"\"\n      Finds a shortest path from start_pos to target_pos on the grid using BFS.\n      Returns a list of (x, y) coordinates representing the path, including start and target.\n      Returns None if no path found.\n      \"\"\"\n      queue = collections.deque([(start_pos[0], start_pos[1], [(start_pos[0], start_pos[1])])])\n      visited = set([(start_pos[0], start_pos[1])])\n\n      while queue:\n          curr_x, curr_y, path = queue.popleft()\n\n          if (curr_x, curr_y) == target_pos:\n              return path\n\n          # Explore neighbors (N, S, E, W)\n          # Note: Order (0,-1) N, (0,1) S, (1,0) E, (-1,0) W\n          for dx, dy in [(0, -1), (0, 1), (1, 0), (-1, 0)]:\n              next_x, next_y = curr_x + dx, curr_y + dy\n\n              # Check bounds\n              if not (0 <= next_x < width and 0 <= next_y < height):\n                  continue\n\n              # Check if visited\n              if (next_x, next_y) in visited:\n                  continue\n\n              # Check if obstacle (non-grabbable entity)\n              is_obstacle = False\n              for k_idx in non_grabbables:\n                  if grid[next_x, next_y, k_idx] == 1:\n                      is_obstacle = True\n                      break\n              \n              if not is_obstacle:\n                  visited.add((next_x, next_y))\n                  queue.append((next_x, next_y, path + [(next_x, next_y)]))\n      \n      return None # No path found\n\n  def get_turn_actions(current_dir, target_dir, ACTIONS):\n      \"\"\"\n      Returns a list of actions (LEFT/RIGHT) to turn from current_dir to target_dir.\n      Assumes directions are 0=N, 1=E, 2=S, 3=W.\n      \"\"\"\n      turn_actions = []\n      # Calculate difference, normalized to [0, 3]\n      # 0 = no turn, 1 = 90 deg right, 2 = 180 deg, 3 = 90 deg left\n      diff = (target_dir - current_dir + 4) % 4 \n      \n      if diff == 1: # Turn right\n          turn_actions.append(ACTIONS['RIGHT'])\n      elif diff == 2: # Turn 180 degrees (two right turns)\n          turn_actions.append(ACTIONS['RIGHT'])\n          turn_actions.append(ACTIONS['RIGHT'])\n      elif diff == 3: # Turn left\n          turn_actions.append(ACTIONS['LEFT'])\n      return turn_actions\n\n\n  # Main function logic for collect_v2\n  current_state = env._current_state # Access the internal CraftState instance\n  world = current_state.world\n  grid = current_state.grid\n  agent_pos = current_state.pos\n  agent_dir = current_state.dir # 0:N, 1:E, 2:S, 3:W\n\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n  NON_GRABBABLES = world.non_grabbable_indices\n  ACTIONS = env_factory.ACTIONS # Assuming env_factory is accessible in this scope\n\n  primitive_locations = []\n  for y in range(HEIGHT):\n      for x in range(WIDTH):\n          # Check if the primitive kind exists at this grid cell\n          if grid[x, y, primitive] == 1:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      return [] # Primitive not found in the grid\n\n  target_adj_pos = None\n  final_primitive_pos = None # Stores the (x,y) of the primitive itself\n  best_path_len = float('inf')\n\n  # Iterate through all found primitive locations and their adjacent cells to find the best target\n  for px, py in primitive_locations:\n      # Check 4 adjacent positions: (N, S, E, W) relative to primitive\n      for ax, ay in [(px, py - 1), (px, py + 1), (px + 1, py), (px - 1, py)]:\n          if not (0 <= ax < WIDTH and 0 <= ay < HEIGHT):\n              continue # Adjacent cell out of bounds\n\n          # Check if this adjacent cell is traversable (not a non-grabbable obstacle)\n          is_obstacle = False\n          for k_idx in NON_GRABBABLES:\n              if grid[ax, ay, k_idx] == 1:\n                  is_obstacle = True\n                  break\n          \n          # If the agent is already at this adjacent cell, it means this cell is occupied by the agent\n          # and cannot be a target for pathfinding *to*.\n          if (ax, ay) == agent_pos:\n              is_obstacle = True \n\n          if not is_obstacle:\n              # Find path from agent's current position to this adjacent cell\n              path = bfs_path(grid, agent_pos, (ax, ay), NON_GRABBABLES, WIDTH, HEIGHT)\n              if path:\n                  # Path length is number of steps = len(path) - 1\n                  current_path_len = len(path) - 1 \n\n                  if current_path_len < best_path_len:\n                      best_path_len = current_path_len\n                      target_adj_pos = (ax, ay)\n                      final_primitive_pos = (px, py) # Store the exact primitive's position\n\n  if target_adj_pos is None:\n      return [] # Cannot reach any adjacent cell of the primitive\n\n  # Now that we have the best target_adj_pos, get the actual path\n  xy_path = bfs_path(grid, agent_pos, target_adj_pos, NON_GRABBABLES, WIDTH, HEIGHT)\n\n  # This check should ideally not be needed if target_adj_pos was successfully found,\n  # but it's good practice for robustness.\n  if not xy_path: \n      return []\n\n  actions_list = []\n  current_x, current_y = agent_pos\n  current_dir = agent_dir\n\n  # Iterate through the path to generate movement actions\n  # The path includes the starting position, so we iterate from the second element\n  for next_x, next_y in xy_path[1:]:\n      dx = next_x - current_x\n      dy = next_y - current_y\n\n      target_abs_dir_for_move = -1\n      # Determine the absolute direction needed to move from (current_x, current_y) to (next_x, next_y)\n      if dy < 0: # Moving North (Y decreases)\n          target_abs_dir_for_move = 0\n      elif dx > 0: # Moving East (X increases)\n          target_abs_dir_for_move = 1\n      elif dy > 0: # Moving South (Y increases)\n          target_abs_dir_for_move = 2\n      elif dx < 0: # Moving West (X decreases)\n          target_abs_dir_for_move = 3\n      \n      # Turn to face the direction of movement\n      turns = get_turn_actions(current_dir, target_abs_dir_for_move, ACTIONS)\n      actions_list.extend(turns)\n      current_dir = target_abs_dir_for_move # Agent's direction updates after turning\n\n      # Move forward\n      actions_list.append(ACTIONS['UP'])\n      current_x, current_y = next_x, next_y\n\n  # Agent is now at `target_adj_pos = (current_x, current_y)`\n  # Now turn to face the `final_primitive_pos` and `USE`\n  px, py = final_primitive_pos\n  dx = px - current_x\n  dy = py - current_y\n\n  target_abs_dir_for_use = -1\n  # Determine the absolute direction to face the primitive from the adjacent cell\n  if dy < 0: # Primitive is North of agent\n      target_abs_dir_for_use = 0\n  elif dx > 0: # Primitive is East of agent\n      target_abs_dir_for_use = 1\n  elif dy > 0: # Primitive is South of agent\n      target_abs_dir_for_use = 2\n  elif dx < 0: # Primitive is West of agent\n      target_abs_dir_for_use = 3\n\n  # Add turns to face the primitive, then the USE action\n  if target_abs_dir_for_use != -1: \n      turns = get_turn_actions(current_dir, target_abs_dir_for_use, ACTIONS)\n      actions_list.extend(turns)\n\n  actions_list.append(ACTIONS['USE'])\n\n  return actions_list", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:27:25.201798", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    current_state = env._current_state\n    world = env.world  # CraftWorld instance\n\n    # Check if the primitive is already in the inventory\n    if current_state.inventory[primitive] > 0:\n        return []  # Already collected\n\n    grid = current_state.grid\n    grid_h, grid_w, _ = grid.shape  # grid_h is HEIGHT, grid_w is WIDTH\n    start_pos = current_state.pos  # (x, y) tuple\n\n    # Action mappings for movement (from env_factory, assuming it's available)\n    # These map actions to their corresponding (dx, dy) deltas\n    move_deltas = {\n        env_factory.UP: (0, -1),\n        env_factory.DOWN: (0, 1),\n        env_factory.LEFT: (-1, 0),\n        env_factory.RIGHT: (1, 0)\n    }\n\n    # Map (dx, dy) deltas back to actions for path reconstruction\n    deltas_to_action_map = {v: k for k, v in move_deltas.items()}\n\n    # Identify impassable kinds of entities.\n    # Non-grabbable items are typically impassable (e.g., water, stone).\n    impassable_kinds = world.non_grabbable_indices\n\n    def is_valid_and_traversable(x, y):\n        \"\"\"\n        Checks if a given grid coordinate (x, y) is within bounds and traversable.\n        A cell is not traversable if it contains any of the impassable_kinds.\n        \"\"\"\n        if not (0 <= x < grid_w and 0 <= y < grid_h):\n            return False\n        # Check if the cell contains any impassable object\n        for k_idx in impassable_kinds:\n            if grid[y, x, k_idx] == 1:\n                return False\n        return True\n\n    # Find all locations where the primitive exists on the grid\n    primitive_locations = []\n    for y_coord in range(grid_h):\n        for x_coord in range(grid_w):\n            if grid[y_coord, x_coord, primitive] == 1:\n                primitive_locations.append((x_coord, y_coord))\n\n    if not primitive_locations:\n        return []  # Primitive not found on the map\n\n    # Determine all valid \"approach squares\" for collection:\n    # these are traversable squares directly adjacent to a primitive.\n    # The agent needs to move to an approach square before using the USE action.\n    approach_squares_target = set() # Store only the (ax, ay) tuples\n    for px, py in primitive_locations:\n        # Check 4 direct neighbors (up, down, left, right)\n        for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n            ax, ay = px + dx, py + dy  # Candidate approach square\n            if is_valid_and_traversable(ax, ay):\n                approach_squares_target.add((ax, ay))\n\n    if not approach_squares_target:\n        return []  # No reachable approach squares found\n\n    # BFS to find the shortest path to any approach square\n    queue = collections.deque([(start_pos, [])])  # (current_pos, list_of_actions_to_reach_current_pos)\n    visited = {start_pos}  # Keep track of visited (x, y) positions to avoid loops\n\n    # Set a maximum path length to prevent excessively long searches\n    max_path_length = 200 # A reasonable limit for typical grid sizes\n\n    while queue:\n        (curr_x, curr_y), path = queue.popleft()\n\n        if len(path) >= max_path_length:\n            continue  # Prune paths that are too long\n\n        # If the current position is one of our target approach squares, we've found a path\n        if (curr_x, curr_y) in approach_squares_target:\n            return path + [env_factory.USE]  # Append USE action and return the full sequence\n\n        # Explore neighbors\n        for action, (dx, dy) in move_deltas.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n\n            # Check if the neighbor is valid, traversable, and not yet visited\n            if (next_x, next_y) not in visited and is_valid_and_traversable(next_x, next_y):\n                visited.add((next_x, next_y))\n                queue.append(((next_x, next_y), path + [action]))\n\n    return []  # No path found to any primitive's adjacent square within search limits", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:27:25.275323", "function_name": "collect", "function_body": "    actions = []\n    MAX_COLLECT_STEPS = 500  # A reasonable upper limit for actions to attempt collection\n\n    # Helper functions (nested for scope or defined outside for clarity)\n    def get_discrete_pos(normalized_pos, width, height):\n        \"\"\"Converts normalized position [0,1] to integer grid coordinates.\"\"\"\n        # Round to nearest integer grid coordinates\n        return (int(round(normalized_pos[0] * (width - 1))),\n                int(round(normalized_pos[1] * (height - 1))))\n\n    def get_cell_content(ego_view, r_offset, c_offset, kind_idx, agent_row_ego, agent_col_ego):\n        \"\"\"Checks if a cell at a relative offset in egocentric view contains a specific kind.\"\"\"\n        target_r = agent_row_ego + r_offset\n        target_c = agent_col_ego + c_offset\n        H, W, _ = ego_view.shape\n        if 0 <= target_r < H and 0 <= target_c < W:\n            return ego_view[target_r, target_c, kind_idx] > 0\n        return False\n\n    def is_target_in_front(ego_view, direction_one_hot, target_kind):\n        \"\"\"Checks if the target kind is in the cell directly in front of the agent.\"\"\"\n        H, W, _ = ego_view.shape\n        mid_row, mid_col = H // 2, W // 2  # Agent's position in ego view\n        dir_idx = np.argmax(direction_one_hot)\n\n        front_r, front_c = mid_row, mid_col\n        if dir_idx == 0:  # North (UP)\n            front_r -= 1\n        elif dir_idx == 1:  # East (RIGHT)\n            front_c += 1\n        elif dir_idx == 2:  # South (DOWN)\n            front_r += 1\n        elif dir_idx == 3:  # West (LEFT)\n            front_c -= 1\n\n        # Check if the front cell is within bounds and contains the target kind\n        return get_cell_content(ego_view, front_r - mid_row, front_c - mid_col, target_kind, mid_row, mid_col)\n\n\n    # Initialize environment and get initial state info\n    # Use a fixed seed for deterministic behavior, as `v2` implies a robust solution.\n    current_obs = env.reset(seed=0) \n\n    # Get grid dimensions from scenario (CraftLab has a scenario attribute)\n    grid_width = env.scenario.init_grid.shape[0]\n    grid_height = env.scenario.init_grid.shape[1]\n\n    # Store visited (pos_x, pos_y, dir_idx) tuples to avoid obvious cycles during exploration.\n    # This helps in preventing the agent from getting stuck in simple loops.\n    visited_states = set()\n\n    initial_features_dict = current_obs['features_dict']\n    initial_pos_discrete = get_discrete_pos(initial_features_dict['pos'], grid_width, grid_height)\n    initial_dir_idx = np.argmax(initial_features_dict['direction'])\n    visited_states.add((initial_pos_discrete[0], initial_pos_discrete[1], initial_dir_idx))\n\n    # Define a simple, deterministic exploration pattern (e.g., UP, RIGHT, DOWN, LEFT cycle)\n    # This acts as a fallback when no target is visible.\n    exploration_action_sequence_idx = 0  # Index into actions_for_exploration\n    actions_for_exploration = [UP, RIGHT, DOWN, LEFT]\n\n\n    for step_count in range(MAX_COLLECT_STEPS):\n        features_dict = current_obs['features_dict']\n        ego_view = features_dict['features_ego']\n        current_dir_one_hot = features_dict['direction']\n        inventory = features_dict['inventory']\n        \n        # Check if primitive is already in inventory (goal met)\n        if inventory[primitive] > 0:\n            return actions\n\n        action_to_perform = None\n\n        # Strategy 1: If primitive is directly in front, USE it\n        if is_target_in_front(ego_view, current_dir_one_hot, primitive):\n            action_to_perform = USE\n        else:\n            # Strategy 2: If primitive is visible in egocentric view, move towards the closest one\n            H_ego, W_ego, _ = ego_view.shape\n            mid_row_ego, mid_col_ego = H_ego // 2, W_ego // 2\n            \n            visible_primitive_locations_relative = []\n            for r_ego in range(H_ego):\n                for c_ego in range(W_ego):\n                    if ego_view[r_ego, c_ego, primitive] > 0:\n                        # Add its relative coordinates (row_offset, col_offset)\n                        visible_primitive_locations_relative.append((r_ego - mid_row_ego, c_ego - mid_col_ego))\n\n            if visible_primitive_locations_relative:\n                # Sort by Manhattan distance to prioritize closer objects\n                visible_primitive_locations_relative.sort(key=lambda p: abs(p[0]) + abs(p[1]))\n                target_dr, target_dc = visible_primitive_locations_relative[0] # Closest one's relative coordinates\n\n                # Determine movement action based on relative position.\n                # Prioritize movement along the dimension with larger difference, or vertical if tied.\n                if abs(target_dr) >= abs(target_dc):\n                    if target_dr < 0:\n                        action_to_perform = UP\n                    elif target_dr > 0:\n                        action_to_perform = DOWN\n                \n                # If no vertical movement decided yet (e.g., target is on same row or horizontal difference is larger)\n                if action_to_perform is None: \n                    if target_dc < 0:\n                        action_to_perform = LEFT\n                    elif target_dc > 0:\n                        action_to_perform = RIGHT\n                \n                # Special case: If agent is standing on the primitive (target_dr, target_dc are 0,0)\n                # and USE didn't work (because it's not \"in front\"), then move off it.\n                if action_to_perform is None and (target_dr == 0 and target_dc == 0):\n                    action_to_perform = UP # Try moving UP to get off the primitive.\n\n        # Strategy 3: If no primitive visible or directly interactable, explore systematically\n        if action_to_perform is None:\n            # Cycle through preferred exploration actions to ensure coverage\n            action_to_perform = actions_for_exploration[exploration_action_sequence_idx]\n            # Increment index for the next time exploration is needed.\n            exploration_action_sequence_idx = (exploration_action_sequence_idx + 1) % len(actions_for_exploration)\n\n        # Perform the chosen action\n        actions.append(action_to_perform)\n        reward, done, new_obs = env.step(action_to_perform)\n        current_obs = new_obs  # Update current observation for next loop iteration\n\n        # Check for environment done condition after stepping\n        if done:\n            return actions\n\n        # Add new state (position, direction) to visited set if it's new.\n        # This primarily helps in avoiding infinite loops if the agent gets truly stuck in a cycle.\n        new_pos_discrete = get_discrete_pos(new_obs['features_dict']['pos'], grid_width, grid_height)\n        new_dir_idx = np.argmax(new_obs['features_dict']['direction'])\n        visited_states.add((new_pos_discrete[0], new_pos_discrete[1], new_dir_idx))\n        \n    # If MAX_COLLECT_STEPS reached and primitive not collected, return current actions\n    return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:28:38.728075", "function_name": "collect", "function_body": "  # Define action constants based on CraftLab.action_specs().\n  # In a full project, these would typically be imported from a central constants file.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  MOVE_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n  # Limits for the BFS search to prevent excessively long computations or memory usage.\n  # These are heuristic values and might need tuning based on map size/complexity.\n  MAX_BFS_NODES_EXPLORED = 5000\n  MAX_PATH_LENGTH = 200\n\n  # Get the current state from the CraftLab environment.\n  # CraftLab holds the current CraftState instance in its _current_state attribute.\n  initial_craft_state = env._current_state\n\n  # Check if the primitive is already in the agent's inventory.\n  # If so, no actions are needed.\n  if initial_craft_state.inventory[primitive] > 0:\n      return []\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each item in the queue is a tuple: (current_CraftState_instance, list_of_actions_taken_to_reach_this_state).\n  # We use collections.deque for efficient pop operations from the left.\n  from collections import deque\n  q = deque()\n  q.append((initial_craft_state, []))\n\n  # Initialize a set to keep track of visited states.\n  # A state is uniquely identified by (agent_x_position, agent_y_position, agent_direction).\n  # This prevents revisiting the same state and avoids infinite loops.\n  visited = set()\n  visited.add((initial_craft_state.pos[0], initial_craft_state.pos[1], initial_craft_state.dir))\n\n  nodes_processed_count = 0\n\n  # Perform BFS until the queue is empty or a solution is found.\n  while q:\n      current_state, current_path = q.popleft()\n      nodes_processed_count += 1\n\n      # Apply search limits to prevent exploring excessively long paths or too many nodes.\n      # If these limits are hit, we prune the current search branch.\n      if nodes_processed_count > MAX_BFS_NODES_EXPLORED or len(current_path) > MAX_PATH_LENGTH:\n          continue\n\n      # Check if the current state is adjacent to the primitive.\n      # This is the condition where we can use the 'USE' action to collect it.\n      if current_state.next_to(primitive):\n          # Goal reached: append the 'USE' action to the path and return the complete sequence.\n          return current_path + [USE]\n\n      # Explore all possible movement actions from the current state.\n      for action in MOVE_ACTIONS:\n          # Simulate the action. CraftState.step returns a new CraftState object\n          # (and a reward, which is always 0.0 for movements here).\n          # This allows exploring without modifying the actual environment state.\n          _reward, next_state = current_state.step(action)\n\n          # Create a unique identifier for the next state for the 'visited' set.\n          next_state_id = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n          # If this state has not been visited before, add it to the queue and mark as visited.\n          if next_state_id not in visited:\n              visited.add(next_state_id)\n              q.append((next_state, current_path + [action]))\n\n  # If the BFS queue becomes empty and no path was found (e.g., primitive is unreachable),\n  # return an empty list.\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:28:38.797163", "function_name": "collect", "function_body": "    state = env._current_state\n    grid = state.grid\n    current_pos = state.pos\n    current_inventory = state.inventory\n    world = env.world\n\n    # 1. Check if the primitive is already in inventory\n    if current_inventory[primitive] > 0:\n        return []\n\n    # 2. Check if the primitive is next to the current position (can be immediately used)\n    if state.next_to(primitive):\n        return [env_factory.ACTIONS.USE]\n\n    # Get grid dimensions (rows, columns)\n    NUM_ROWS, NUM_COLS, _ = grid.shape\n    WATER_IDX = world.water_index\n\n    # BFS for pathfinding\n    q = [(current_pos, [])]  # (position=(row, col), path_to_reach_position)\n    visited = {current_pos}\n\n    # Possible moves: (dr, dc, action)\n    MOVES = [\n        (-1, 0, env_factory.ACTIONS.UP),    # Change in row, change in column for UP\n        (1, 0, env_factory.ACTIONS.DOWN),   # Change in row, change in column for DOWN\n        (0, -1, env_factory.ACTIONS.LEFT),  # Change in row, change in column for LEFT\n        (0, 1, env_factory.ACTIONS.RIGHT),  # Change in row, change in column for RIGHT\n    ]\n\n    while q:\n        (r, c), path = q.pop(0)  # BFS: pop from the front of the list (slow for large queues)\n\n        for dr, dc, action in MOVES:\n            nr, nc = r + dr, c + dc  # New row, new column\n\n            # Check if new position is within grid bounds\n            if not (0 <= nr < NUM_ROWS and 0 <= nc < NUM_COLS):\n                continue\n\n            # Check if new position is traversable (e.g., not water)\n            # Assuming water is the only impassable terrain type\n            if grid[nr, nc, WATER_IDX] > 0:\n                continue\n\n            new_pos = (nr, nc)\n            # Check if new position has already been visited\n            if new_pos in visited:\n                continue\n\n            # Check if the primitive is in the 3x3 neighborhood of new_pos\n            # (i.e., if CraftState.next_to(primitive) would be true from new_pos)\n            found_primitive_nearby = False\n            # Iterate through the 3x3 neighborhood centered at (nr, nc)\n            for i in range(max(0, nr - 1), min(NUM_ROWS, nr + 2)):\n                for j in range(max(0, nc - 1), min(NUM_COLS, nc + 2)):\n                    if grid[i, j, primitive] > 0:\n                        found_primitive_nearby = True\n                        break\n                if found_primitive_nearby:\n                    break\n\n            if found_primitive_nearby:\n                # If a primitive is found in the 3x3 neighborhood of `new_pos`,\n                # this means we can move to `new_pos` and then `USE` to collect it.\n                return path + [action, env_factory.ACTIONS.USE]\n            else:\n                # If the primitive is not found nearby, add `new_pos` to visited and queue\n                # for further exploration.\n                visited.add(new_pos)\n                q.append((new_pos, path + [action]))\n\n    # If the BFS completes and the primitive is not found or reachable\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:29:59.858288", "function_name": "collect", "function_body": "    import collections\n    \n    initial_state = env._current_state\n    grid = initial_state.grid\n    current_pos = initial_state.pos\n\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n\n    # Get action mappings for clarity and robustness\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    # Identify obstacles: non-grabbable items that the agent cannot move through.\n    # CraftWorld's non_grabbable_indices are the best candidates for obstacles.\n    obstacle_indices = env.world.non_grabbable_indices\n\n    # 1. Find all locations on the grid where the primitive exists\n    primitive_locations = []\n    for r in range(WIDTH):\n        for c in range(HEIGHT):\n            if grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the grid\n\n    # 2. Choose the closest primitive by Manhattan distance as the target\n    target_primitive_pos = min(\n        primitive_locations,\n        key=lambda p: abs(p[0] - current_pos[0]) + abs(p[1] - current_pos[1])\n    )\n\n    # 3. Use Breadth-First Search (BFS) to find the shortest path\n    #    to a cell that is adjacent to the target primitive.\n    q = collections.deque()\n    visited = set() # Stores (r, c) tuples to avoid cycles and redundant processing\n    \n    # Each item in the queue is ((current_r, current_c), [actions_taken_to_reach_here])\n    q.append((current_pos, [])) \n    visited.add(current_pos)\n\n    final_path_actions = []\n    path_found = False\n\n    # Define possible movement actions and their corresponding (dr, dc) changes\n    # The direction of the agent implicitly changes with movement actions,\n    # but for next_to() and USE, only adjacency matters, not specific facing.\n    moves = {\n        ACTION_DOWN: (1, 0),\n        ACTION_UP: (-1, 0),\n        ACTION_RIGHT: (0, 1),\n        ACTION_LEFT: (0, -1)\n    }\n\n    while q and not path_found:\n        (r, c), current_path = q.popleft()\n\n        # Check if the current position is adjacent to the target primitive\n        pr, pc = target_primitive_pos\n        if abs(r - pr) + abs(c - pc) == 1: # Manhattan distance of 1 means adjacent\n            final_path_actions = current_path\n            path_found = True\n            break\n\n        # Explore neighboring cells\n        for action, (dr, dc) in moves.items():\n            nr, nc = r + dr, c + dc\n            next_node = (nr, nc)\n\n            # Boundary check: Ensure the new position is within grid limits\n            if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n                continue\n\n            # Obstacle check:\n            # 1. Agent cannot move onto the primitive itself (must stay adjacent).\n            # 2. Agent cannot move onto other defined obstacles (e.g., water, workshops if they are impassable).\n            is_obstacle = False\n            if grid[nr, nc, primitive] > 0: # Check if the target cell contains the primitive\n                is_obstacle = True\n            else: # Check for other non-grabbable items that act as obstacles\n                for obstacle_idx in obstacle_indices:\n                    if grid[nr, nc, obstacle_idx] > 0:\n                        is_obstacle = True\n                        break\n            \n            # If the next node is within bounds, not an obstacle, and not yet visited, add it to the queue\n            if next_node not in visited and not is_obstacle:\n                visited.add(next_node)\n                q.append((next_node, current_path + [action]))\n\n    if not path_found:\n        return [] # No path found to an adjacent cell, or primitive is unreachable\n\n    # 4. Once adjacent, add the USE action to collect the primitive\n    final_path_actions.append(ACTION_USE)\n\n    return final_path_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:29:59.929598", "function_name": "collect", "function_body": "    from collections import deque\n    import numpy as np\n\n    # Actions\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    # Relative position changes for movement actions\n    _POS_DELTA_BY_ACTION = {\n        UP: (0, -1),\n        DOWN: (0, 1),\n        LEFT: (-1, 0),\n        RIGHT: (1, 0)\n    }\n\n    # Direction vectors corresponding to agent's integer direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n    _DIR_VECTORS = {\n        0: (1, 0),   # RIGHT (East)\n        1: (0, -1),  # UP (North)\n        2: (-1, 0),  # LEFT (West)\n        3: (0, 1)    # DOWN (South)\n    }\n\n    current_state = env._current_state\n    \n    # 1. Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir\n    grid = current_state.grid\n    WIDTH, HEIGHT, _ = grid.shape # N_KINDS is not directly used for grid dimensions\n\n    # Get non-grabbable indices from the world configuration for obstacle checking\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # 2. Find the location of the primitive on the grid\n    # np.where returns a tuple of arrays (x_coords, y_coords) where the condition is true\n    target_coords = np.where(grid[:, :, primitive] == 1)\n\n    if len(target_coords[0]) == 0:\n        # Primitive not found anywhere on the grid\n        return []\n\n    # If multiple instances exist, we target the first one found by np.where,\n    # BFS will naturally find the shortest path to it.\n    primitive_x, primitive_y = target_coords[0][0], target_coords[1][0]\n\n    # 3. Use Breadth-First Search (BFS) to find the shortest sequence of actions\n    # to reach a state where the agent is adjacent to the primitive and facing it.\n    \n    # Queue stores tuples: (current_x, current_y, current_facing_direction, list_of_actions_taken)\n    q = deque()\n    q.append((initial_pos[0], initial_pos[1], initial_dir, []))\n\n    # Visited set stores (x, y, direction) tuples to prevent revisiting states\n    # and ensures finding the shortest path in an unweighted graph.\n    visited = set()\n    visited.add((initial_pos[0], initial_pos[1], initial_dir))\n\n    while q:\n        curr_x, curr_y, curr_dir_int, path_so_far = q.popleft()\n\n        # Check if the agent is currently adjacent to the primitive and facing it.\n        # This is the condition under which the 'USE' action can be performed.\n        dx_to_primitive = primitive_x - curr_x\n        dy_to_primitive = primitive_y - curr_y\n\n        # If adjacent (Manhattan distance of 1)\n        if abs(dx_to_primitive) + abs(dy_to_primitive) == 1:\n            target_dir_vector = (dx_to_primitive, dy_to_primitive)\n            curr_dir_vector = _DIR_VECTORS[curr_dir_int]\n\n            # If facing the primitive, we have found a path to collect it.\n            if target_dir_vector == curr_dir_vector:\n                return path_so_far + [USE]\n\n        # Explore possible movement actions (DOWN, UP, LEFT, RIGHT)\n        for action in [DOWN, UP, LEFT, RIGHT]:\n            dx, dy = _POS_DELTA_BY_ACTION[action]\n            next_x, next_y = curr_x + dx, curr_y + dy\n            # When a movement action is taken, the agent's facing direction updates to that action's direction.\n            next_dir_int = action \n\n            # Check if the next position is within grid boundaries\n            if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                continue\n\n            # Check if the next position contains any non-grabbable (obstacle) entity\n            is_obstacle = False\n            for obstacle_idx in non_grabbable_indices:\n                if grid[next_x, next_y, obstacle_idx] == 1:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n            \n            # If the next state (position and direction) has not been visited yet\n            if (next_x, next_y, next_dir_int) not in visited:\n                visited.add((next_x, next_y, next_dir_int))\n                q.append((next_x, next_y, next_dir_int, path_so_far + [action]))\n\n    # If the BFS completes and no path to collect the primitive was found\n    return []", "island_id": 8, "scores": {"3": -1}}
