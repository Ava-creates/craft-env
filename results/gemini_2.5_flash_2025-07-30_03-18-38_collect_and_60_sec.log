{"timestamp": "2025-07-30T13:54:50.604371", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants for clarity\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Directional deltas for (dx, dy) mapping actions/directions to coordinate changes\n  _DIRECTION_DELTAS = {\n      DOWN: (0, 1),   # Moving/facing DOWN means +1 in Y (assuming Y increases downwards)\n      UP: (0, -1),    # Moving/facing UP means -1 in Y\n      LEFT: (-1, 0),  # Moving/facing LEFT means -1 in X\n      RIGHT: (1, 0)   # Moving/facing RIGHT means +1 in X\n  }\n\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index.index(primitive) # Get the integer ID for the given primitive\n\n  current_state = env._current_state\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # 1. Early exit: If the primitive is already in the agent's inventory\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # No actions needed if already collected\n\n  # 2. Early exit: Check if the primitive is actually collectible based on world configuration.\n  #    It must either be in the `grabbable_indices` set, or be the special `water_index`.\n  #    This filters out non-collectible entities (e.g., workshops that are just for crafting).\n  grabbable_set = set(env.world.grabbable_indices)\n  \n  is_collectible_primitive = False\n  if primitive_idx in grabbable_set:\n      is_collectible_primitive = True\n  elif hasattr(env.world, 'water_index') and primitive_idx == env.world.water_index:\n      # Water is a special case: it might not be in `grabbable_indices` but is collectible.\n      is_collectible_primitive = True\n  elif hasattr(env.world, 'stone_index') and primitive_idx == env.world.stone_index:\n      # Stone might also be a special case if it's a primitive extracted from a tile.\n      # This check ensures that if stone is a primitive, it is considered collectible from a tile.\n      # This assumes that if a primitive is not grabbable, it must be collectable from the environment.\n      is_collectible_primitive = True\n\n  if not is_collectible_primitive:\n    # This item cannot be picked up or collected by the USE action, so return empty path.\n    return []\n\n  # 3. Pre-compute all grid locations where the target primitive exists.\n  target_primitive_locs = set() # Stores (x, y) coordinates of cells containing the primitive\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        target_primitive_locs.add((x, y))\n\n  if not target_primitive_locs:\n    return [] # Primitive not found anywhere on the map, so it's unreachable.\n\n  # 4. Define traversability: A cell is traversable if it's within grid boundaries and\n  #    does NOT contain any item from the `non_grabbable_indices` set (which act as obstacles).\n  impassable_kinds = set(env.world.non_grabbable_indices) # Convert to set for O(1) lookups\n\n  def _is_traversable(x, y):\n    \"\"\"\n    Checks if a cell (x, y) is traversable for agent movement.\n    A cell is traversable if it's within bounds and does not contain any\n    object classified as an impassable kind.\n    \"\"\"\n    # First, check boundary conditions\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check if any of the impassable kinds are present at this cell (x, y).\n    # Iterate directly over the known impassable kinds.\n    for k_val in impassable_kinds:\n        if grid[x, y, k_val] > 0: # If this specific impassable kind is present at (x,y)\n            return False # The cell is blocked\n    return True\n\n  # 5. Breadth-First Search (BFS) to find the shortest path to a collectible primitive.\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Initial direction from the CraftState\n\n  # The queue stores tuples: ((current_x, current_y), current_direction, [list_of_actions_to_reach_this_state])\n  queue = collections.deque([((start_pos[0], start_pos[1]), start_dir, [])])\n  \n  # The `visited` set stores ((x, y), direction) tuples to avoid cycles and redundant state exploration.\n  # The agent's direction matters because it affects the outcome of the 'USE' action.\n  visited = {((start_pos[0], start_pos[1]), start_dir)}\n\n  shortest_path = None # This will store the first (and thus shortest) path found\n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.popleft()\n\n    # Check if the primitive can be collected from the current state.\n    # The 'USE' action targets the cell directly in front of the agent.\n    face_dx, face_dy = _DIRECTION_DELTAS[curr_dir]\n    face_x, face_y = curr_x + face_dx, curr_y + face_dy\n\n    # If the cell in front is within bounds and contains the target primitive\n    if (0 <= face_x < grid_width and 0 <= face_y < grid_height and\n        (face_x, face_y) in target_primitive_locs):\n      # Found a state from which the primitive can be collected.\n      # Since BFS explores layer by layer, the first valid path found is guaranteed to be the shortest.\n      shortest_path = path_actions + [USE] # Add the final USE action\n      break # Path found, exit the BFS loop.\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    for action_idx in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      move_dx, move_dy = _DIRECTION_DELTAS[action_idx]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = action_idx # When moving, the agent's direction changes to the direction of movement.\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # Check if the next position is traversable AND this specific (position, direction) state\n      # has not been visited yet to avoid redundant work and loops.\n      if _is_traversable(next_x, next_y) and next_state_tuple not in visited:\n        visited.add(next_state_tuple)\n        # Add the new state to the queue along with the accumulated path\n        queue.append((next_state_tuple[0], next_state_tuple[1], path_actions + [action_idx]))\n        \n  return shortest_path if shortest_path is not None else []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T13:56:15.552388", "function_name": "collect", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:56:16.551010", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Ensure position is int tuple. CraftState.pos is tuple(int, int)\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  # Current direction is a one-hot array, convert to an integer (0=N, 1=E, 2=S, 3=W)\n  current_dir_one_hot = obs['features_dict']['direction']\n  current_dir = np.argmax(current_dir_one_hot)\n  \n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n  grabbable_indices = world.grabbable_indices\n  \n  W, H, K = grid.shape\n\n  # Action constants\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Map movement action values to (dx, dy) deltas\n  MOVEMENT_DELTAS = {\n      UP_ACTION: (0, -1),   # (dx, dy) for moving UP (North)\n      DOWN_ACTION: (0, 1),  # (dx, dy) for moving DOWN (South)\n      LEFT_ACTION: (-1, 0), # (dx, dy) for moving LEFT (West)\n      RIGHT_ACTION: (1, 0), # (dx, dy) for moving RIGHT (East)\n  }\n\n  # Map movement action values to the resulting agent direction (0=N, 1=E, 2=S, 3=W)\n  # This assumes that taking a movement action makes the agent face that direction.\n  ACTION_TO_DIRECTION = {\n      UP_ACTION: 0,    # UP action results in facing North\n      RIGHT_ACTION: 1, # RIGHT action results in facing East\n      DOWN_ACTION: 2,  # DOWN action results in facing South\n      LEFT_ACTION: 3,  # LEFT action results in facing West\n  }\n\n  # Map (dx, dy) from adjacent cell to target cell to the required agent direction\n  RELATIVE_POS_TO_DIRECTION = {\n      (0, -1): 0, # Item is UP relative to agent -> agent must face North\n      (1, 0): 1,  # Item is RIGHT relative to agent -> agent must face East\n      (0, 1): 2,  # Item is DOWN relative to agent -> agent must face South\n      (-1, 0): 3, # Item is LEFT relative to agent -> agent must face West\n  }\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  is_obstacle_kind = np.isin(np.arange(K), list(non_grabbable_indices))\n  has_obstacle = (grid[:, :, is_obstacle_kind] > 0).any(axis=-1)\n  traversable_mask = ~has_obstacle\n  \n  # Ensure the agent's current position is marked as traversable.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] # Agent starts on an untraversable cell, no path possible.\n\n  # 2. Determine target states for collection based on primitive type\n  # A target state is ((x, y), required_dir) representing the agent's position and facing direction\n  # from which it can successfully collect the primitive using the USE action.\n  target_collection_states = set() \n\n  if primitive in grabbable_indices:\n      # Case A: In-place collection (e.g., picking up wood, coal, etc.)\n      # Agent needs to be on the square with the primitive. Direction typically doesn't matter for these,\n      # but we add all 4 directions to be compatible with the BFS state (pos, dir) and potential nuances.\n      for x_item in range(W):\n          for y_item in range(H):\n              if grid[x_item, y_item, primitive] > 0: # Found the primitive at (x_item, y_item)\n                  # The cell must be traversable to stand on it.\n                  if traversable_mask[x_item, y_item]: \n                      for d in range(4): # Any direction is fine if on the square\n                          target_collection_states.add(((x_item, y_item), d))\n  else:\n      # Case B: Adjacent collection (e.g., mining stone, collecting water, interacting with workshops)\n      # Agent needs to be adjacent to the primitive and facing it.\n      for x_item in range(W):\n          for y_item in range(H):\n              if grid[x_item, y_item, primitive] > 0: # Found the primitive at (x_item, y_item)\n                  # Check its 4 cardinal neighbors as potential agent positions for collection\n                  for dx_adj, dy_adj in [ (0, -1), (0, 1), (-1, 0), (1, 0) ]: # Relative positions of neighbors to the item\n                      x_adj, y_adj = x_item + dx_adj, y_item + dy_adj\n                      \n                      if (0 <= x_adj < W and 0 <= y_adj < H and\n                          traversable_mask[x_adj, y_adj]): # Neighbor must be within bounds and traversable\n                          \n                          # Calculate the direction the agent needs to face from (x_adj, y_adj) towards (x_item, y_item)\n                          relative_item_pos = (x_item - x_adj, y_item - y_adj)\n                          required_dir = RELATIVE_POS_TO_DIRECTION.get(relative_item_pos)\n                          if required_dir is not None:\n                              target_collection_states.add(((x_adj, y_adj), required_dir))\n  \n  if not target_collection_states:\n      return [] # No primitive found or no reachable collection spots\n\n  # 3. Perform BFS to find the shortest sequence of actions to reach any target_collection_state\n  from collections import deque\n  q = deque([(current_pos, current_dir, [])]) # (current_pos, current_dir, path_actions_so_far)\n  visited = {(current_pos, current_dir)} \n\n  while q:\n      curr_pos, curr_dir, path_so_far = q.popleft()\n\n      # Check if the current state satisfies any of our target collection states\n      if (curr_pos, curr_dir) in target_collection_states:\n          return path_so_far + [USE_ACTION] # Path found, append USE and return\n\n      # Explore movement actions (and potential \"turn in place\" actions if move is blocked)\n      for action_val, (dx, dy) in MOVEMENT_DELTAS.items():\n          target_x, target_y = curr_pos[0] + dx, curr_pos[1] + dy\n          potential_next_dir = ACTION_TO_DIRECTION[action_val]\n\n          if (0 <= target_x < W and 0 <= target_y < H and\n              traversable_mask[target_x, target_y]):\n              # This is a valid movement: agent moves to next_pos\n              next_pos = (target_x, target_y)\n              next_dir = potential_next_dir\n              if (next_pos, next_dir) not in visited:\n                  visited.add((next_pos, next_dir))\n                  q.append((next_pos, next_dir, path_so_far + [action_val]))\n          else:\n              # This is a blocked movement: agent stays at curr_pos but its direction might still change.\n              # This allows for \"turning in place\" by attempting a blocked move.\n              next_pos = curr_pos\n              next_dir = potential_next_dir\n              # Only add to queue if the direction actually changes or it's a new (pos, dir) state\n              if (next_pos, next_dir) not in visited:\n                  visited.add((next_pos, next_dir))\n                  q.append((next_pos, next_dir, path_so_far + [action_val]))\n\n  return [] # No path found to a collection spot", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T13:57:57.332151", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants derived from CraftLab.action_specs()\n  # These are standard for the CraftWorld environment.\n  _DOWN = 0\n  _UP = 1\n  _LEFT = 2\n  _RIGHT = 3\n  _USE = 4\n\n  # Get current state from the environment's internal CraftState\n  current_state = env._current_state\n  initial_pos_r, initial_pos_c = current_state.pos\n  initial_dir = current_state.dir\n  initial_grid = current_state.grid\n  \n  # Get grid dimensions\n  WIDTH, HEIGHT, N_KINDS = initial_grid.shape\n  \n  # Agent's directions (0: UP, 1: RIGHT, 2: DOWN, 3: LEFT) to (dr, dc) delta\n  # This mapping represents what (dr, dc) corresponds to the agent's internal direction.\n  DIR_DELTAS = {\n      0: (-1, 0),  # UP (North)\n      1: (0, 1),   # RIGHT (East)\n      2: (1, 0),   # DOWN (South)\n      3: (0, -1)   # LEFT (West)\n  }\n\n  # Action (UP, DOWN, LEFT, RIGHT) to (dr, dc) delta\n  # This mapping represents how a specific action changes position.\n  ACTION_DELTAS = {\n      _UP: (-1, 0),\n      _DOWN: (1, 0),\n      _LEFT: (0, -1),\n      _RIGHT: (0, 1)\n  }\n  \n  # Helper function to simulate a movement action's effect on (r, c, d)\n  # Returns (new_r, new_c, new_d) or None if move is invalid/blocked.\n  # This function does not modify inventory or the grid, as it's for pathfinding simulation.\n  def _get_next_state_after_move_action(current_r, current_c, current_d, action):\n      new_r, new_c, new_d = current_r, current_c, current_d\n\n      dr, dc = ACTION_DELTAS[action]\n      test_r, test_c = current_r + dr, current_c + dc\n      \n      # Check boundaries\n      if not (0 <= test_r < WIDTH and 0 <= test_c < HEIGHT):\n          return None # Out of bounds\n      \n      # Check for obstacles: An agent typically cannot move onto a cell that contains any item.\n      # If the sum of all kind counts in the target cell is greater than 0, it's considered occupied.\n      if np.sum(initial_grid[test_r, test_c, :]) > 0:\n          return None # Cell is occupied by an item, cannot move there\n\n      # Valid move: update position and direction\n      new_r, new_c = test_r, test_c\n      if action == _UP: new_d = 0\n      elif action == _RIGHT: new_d = 1\n      elif action == _DOWN: new_d = 2\n      elif action == _LEFT: new_d = 3\n      \n      return (new_r, new_c, new_d)\n\n  # BFS Initialization\n  # Queue stores tuples of (row, col, direction, list_of_actions_to_reach_this_state).\n  q = collections.deque([(initial_pos_r, initial_pos_c, initial_dir, [])])\n  \n  # Visited set stores (row, col, direction) tuples to prevent revisiting states and infinite loops.\n  visited = set([(initial_pos_r, initial_pos_c, initial_dir)])\n  \n  # BFS Search Loop\n  while q:\n      r, c, d, current_path_actions = q.popleft()\n\n      # Check if the current state (r, c, d) allows for immediate collection of the primitive.\n      # This means the primitive is located in the cell directly in front of the agent.\n      front_r, front_c = r + DIR_DELTAS[d][0], c + DIR_DELTAS[d][1]\n      \n      # Check if the \"front\" cell is within grid boundaries and contains the primitive.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and \n          initial_grid[front_r, front_c, primitive] > 0):\n          \n          # Agent is adjacent to and facing the primitive.\n          # Append the USE action to the current path and return the complete sequence.\n          return current_path_actions + [_USE]\n\n      # Explore possible next states by trying all valid movement actions.\n      for action in [_UP, _DOWN, _LEFT, _RIGHT]:\n          next_state_tuple = _get_next_state_after_move_action(r, c, d, action)\n          \n          if next_state_tuple: # If the simulated move is valid (not out of bounds or blocked)\n              nr, nc, nd = next_state_tuple\n              if (nr, nc, nd) not in visited: # If this new state hasn't been visited yet\n                  visited.add((nr, nc, nd))\n                  q.append((nr, nc, nd, current_path_actions + [action]))\n  \n  # If the BFS completes and no path to collect the primitive is found, return an empty list.\n  return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:57:57.401589", "function_name": "collect", "function_body": "    import collections \n\n    actions_taken = []\n\n    # Get action mappings from the environment for clarity\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    # A reasonable limit to prevent infinite loops if the primitive is unreachable\n    max_collection_steps = 1000 \n\n    for _ in range(max_collection_steps):\n        current_state = env._current_state # Access the underlying CraftState instance\n\n        # 1. Check if the goal (primitive in inventory) is already satisfied\n        if current_state.satisfies(None, primitive):\n            break # Goal achieved, stop\n\n        # 2. Check if the primitive is in the agent's 3x3 neighborhood (including current cell)\n        if current_state.next_to(primitive):\n            # If so, use the item to collect it\n            actions_taken.append(ACTION_USE)\n            _, done, _ = env.step(ACTION_USE)\n            if done: # Check if the episode ended after this action\n                break\n            continue # After using, re-check if goal is satisfied in the next iteration\n\n        # 3. If not collected and not next to, plan a movement using BFS\n        grid = current_state.grid\n        current_pos = current_state.pos\n        # Obstacles are non-grabbable items which typically block movement\n        non_grabbable_indices = env.world.non_grabbable_indices\n\n        WIDTH, HEIGHT, _ = grid.shape\n\n        # BFS to find the shortest path to a cell containing the primitive\n        # Queue stores (current_position, path_taken_to_reach_current_position)\n        q = collections.deque([(current_pos, [])]) \n        visited = {current_pos} # Keep track of visited positions to avoid cycles and redundant checks\n        \n        path_to_primitive = None # This will store the sequence of (r, c) positions to take\n\n        # Define possible movement directions and corresponding actions\n        # (dr, dc, action_constant) - action is not used in BFS itself, only for the final move conversion\n        moves = [\n            (-1, 0, ACTION_UP),    # Up\n            (1, 0, ACTION_DOWN),   # Down\n            (0, -1, ACTION_LEFT),  # Left\n            (0, 1, ACTION_RIGHT)   # Right\n        ]\n\n        while q:\n            (r, c), path = q.popleft()\n\n            # Check if this cell contains the primitive. \n            # We exclude current_pos as a target since `next_to` handles it,\n            # and we want to *move* to a new cell containing the primitive if not adjacent.\n            if grid[r, c, primitive] > 0 and (r, c) != current_pos:\n                path_to_primitive = path\n                break # Found the nearest primitive, no need to search further\n\n            # Explore neighbors\n            for dr, dc, _ in moves: \n                nr, nc = r + dr, c + dc\n\n                # Check boundaries\n                if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n                    continue\n\n                # Check if the neighbor cell is an obstacle (contains any non-grabbable item)\n                is_obstacle = False\n                for obs_idx in non_grabbable_indices:\n                    if grid[nr, nc, obs_idx] > 0: # If any non-grabbable item is present at this cell\n                        is_obstacle = True\n                        break\n                if is_obstacle:\n                    continue\n\n                # If the neighbor is traversable and not visited, add to queue\n                if (nr, nc) not in visited:\n                    visited.add((nr, nc))\n                    q.append(((nr, nc), path + [(nr, nc)])) # Append new position to path\n\n        # If a path to a primitive was found by BFS\n        if path_to_primitive:\n            # Take the first step towards the target primitive\n            next_pos_on_path = path_to_primitive[0]\n            dr, dc = next_pos_on_path[0] - current_pos[0], next_pos_on_path[1] - current_pos[1]\n\n            action_to_take = None\n            if dr == -1 and dc == 0:\n                action_to_take = ACTION_UP\n            elif dr == 1 and dc == 0:\n                action_to_take = ACTION_DOWN\n            elif dr == 0 and dc == -1:\n                action_to_take = ACTION_LEFT\n            elif dr == 0 and dc == 1:\n                action_to_take = ACTION_RIGHT\n            \n            if action_to_take is not None:\n                actions_taken.append(action_to_take)\n                _, done, _ = env.step(action_to_take)\n                if done:\n                    break\n            else:\n                # This branch should ideally not be reached if path_to_primitive is valid\n                # (i.e., its first element is a direct, valid neighbor of current_pos).\n                # If it occurs, it indicates a planning or environmental inconsistency,\n                # so we break to prevent an infinite loop.\n                break \n        else:\n            # No path to the primitive found (e.g., unreachable or doesn't exist in the grid).\n            # In this case, the agent cannot collect the primitive.\n            # Stop attempting to collect.\n            break\n\n    return actions_taken", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:59:05.902577", "function_name": "collect", "function_body": "    actions = []\n\n    # Reset the environment to get the initial state and observations\n    # We use _ = env.reset() because the observations will be retrieved via env._current_state\n    # or env.observations() in the loop.\n    _ = env.reset() \n    \n    # The 'primitive' argument is already the integer index of the item.\n    primitive_idx = primitive\n\n    # Get the initial inventory count of the primitive.\n    # We access the internal _current_state attribute of CraftLab, which holds a CraftState instance.\n    initial_inventory_count = env._current_state.inventory[primitive_idx]\n\n    # Define action constants based on problem description\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Determine a maximum number of steps for the collection attempt\n    # Use env.max_steps if available, otherwise a reasonable default.\n    max_steps = getattr(env, 'max_steps', 200) \n\n    for _ in range(max_steps):\n        # Access the current CraftState directly from the CraftLab environment\n        current_state = env._current_state\n        current_grid = current_state.grid\n        current_pos = current_state.pos # tuple(int, int) (x, y)\n        current_inventory = current_state.inventory\n\n        # 1. Check if the primitive has been collected\n        if current_inventory[primitive_idx] > initial_inventory_count:\n            return actions # Goal achieved!\n\n        # 2. Check if the agent is next to the primitive\n        action_to_take = -1 # Initialize with an invalid action\n        if current_state.next_to(primitive_idx):\n            action_to_take = USE\n        else:\n            # 3. Find the closest instance of the primitive on the grid\n            target_x, target_y = -1, -1\n            min_dist = float('inf')\n\n            # Iterate through the entire grid to find the primitive's location\n            grid_width, grid_height, _ = current_grid.shape\n            \n            for x in range(grid_width):\n                for y in range(grid_height):\n                    # Check if the current cell contains the primitive\n                    if current_grid[x, y, primitive_idx] == 1:\n                        # Calculate Manhattan distance\n                        dist = abs(x - current_pos[0]) + abs(y - current_pos[1])\n                        if dist < min_dist:\n                            min_dist = dist\n                            target_x, target_y = x, y\n            \n            if target_x != -1: # Primitive found on the map\n                # Calculate the difference in coordinates\n                dx = target_x - current_pos[0]\n                dy = target_y - current_pos[1]\n\n                # Decide movement based on the larger absolute difference to move directly towards the target\n                if abs(dx) > abs(dy):\n                    action_to_take = RIGHT if dx > 0 else LEFT\n                else:\n                    action_to_take = DOWN if dy > 0 else UP\n            else:\n                # Primitive not found on the map (e.g., all collected, or not spawned)\n                # For `collect_v2`, if the primitive is not visible, try a random movement\n                # to explore and potentially reveal it.\n                action_to_take = np.random.choice([DOWN, UP, LEFT, RIGHT])\n        \n        # Execute the chosen action\n        actions.append(action_to_take)\n        _, done, _ = env.step(action_to_take)\n\n        # Check if the episode is done (e.g., max_steps reached in the environment)\n        if done:\n            break # Exit loop if the episode has ended\n\n    # Return the sequence of actions even if the primitive was not collected\n    # (e.g., if max_steps were reached without finding/collecting it).\n    return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:59:06.919256", "function_name": "collect", "function_body": "  # Get action mappings dynamically from the environment\n  action_map_str_to_int = env.action_specs()\n  ACTIONS = {\n      'DOWN': action_map_str_to_int['DOWN'],\n      'UP': action_map_str_to_int['UP'],\n      'LEFT': action_map_str_to_int['LEFT'],\n      'RIGHT': action_map_str_to_int['RIGHT'],\n      'USE': action_map_str_to_int['USE']\n  }\n\n  collected_actions = []\n  steps_taken = 0\n  MAX_COLLECT_STEPS = 500  # A safety limit to prevent infinite loops\n\n  while steps_taken < MAX_COLLECT_STEPS:\n      obs = env.observations()\n      current_inventory = obs['features_dict']['inventory']\n      current_pos = obs['features_dict']['pos']  # (x, y)\n      current_grid = obs['features_dict']['features_global']  # (width, height, n_kinds)\n\n      # 1. Check if the primitive is already collected\n      if current_inventory[primitive] > 0:\n          break  # Goal achieved\n\n      # 2. Check if the primitive is in the 3x3 neighborhood and try to USE\n      is_next_to_primitive = False\n      grid_width, grid_height, _ = current_grid.shape\n\n      # Iterate through the 3x3 neighborhood around current_pos (including current_pos itself)\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = current_pos[0] + dx, current_pos[1] + dy\n              # Check grid boundaries\n              if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                  if current_grid[nx, ny, primitive] == 1:\n                      is_next_to_primitive = True\n                      break  # Found an instance of the primitive in the neighborhood\n          if is_next_to_primitive:\n              break\n\n      if is_next_to_primitive:\n          # Try to use the item. The CraftState.step function's USE logic handles facing/grabbing.\n          collected_actions.append(ACTIONS['USE'])\n          # Execute the action in the environment and get the new state's observations\n          _reward, _done, new_obs = env.step(ACTIONS['USE'])\n          steps_taken += 1\n          \n          # Check if the primitive was successfully collected after the USE action\n          if new_obs['features_dict']['inventory'][primitive] > 0:\n              break  # Successfully collected\n          else:\n              # If USE didn't work (e.g., not grabbable, or specific facing required that wasn't met),\n              # continue the loop to potentially reposition or find another instance.\n              continue\n\n      # 3. If not next to primitive, find its location and move towards it\n      primitive_location = None  # Stores (px, py) of the closest primitive\n\n      # Find all coordinates where the primitive exists on the grid\n      primitive_coords = np.argwhere(current_grid[:, :, primitive] == 1)\n\n      if len(primitive_coords) > 0:\n          # Find the closest primitive instance using Manhattan distance\n          min_dist = float('inf')\n          for px, py in primitive_coords:\n              dist = abs(px - current_pos[0]) + abs(py - current_pos[1])\n              if dist < min_dist:\n                  min_dist = dist\n                  primitive_location = (px, py)\n      \n      if primitive_location is None:\n          # Primitive not found on the map, or all instances exhausted.\n          # Cannot proceed to collect.\n          break  # Exit loop, indicating failure to find/collect.\n\n      # Determine the next best movement action based on Manhattan distance\n      target_x, target_y = primitive_location[0], primitive_location[1]\n      \n      dx = target_x - current_pos[0]\n      dy = target_y - current_pos[1]\n\n      action_to_take = None\n      if abs(dx) > abs(dy):\n          # Prioritize horizontal movement if the horizontal distance is greater\n          if dx > 0:\n              action_to_take = ACTIONS['RIGHT']\n          else:  # dx < 0\n              action_to_take = ACTIONS['LEFT']\n      elif abs(dy) > 0:\n          # Prioritize vertical movement if vertical distance is greater or horizontal is zero\n          if dy > 0:\n              action_to_take = ACTIONS['DOWN']\n          else:  # dy < 0\n              action_to_take = ACTIONS['UP']\n      # If dx == 0 and dy == 0, it means current_pos == primitive_location.\n      # This case implies the agent is already on the primitive and should have been\n      # handled by the `is_next_to_primitive` and `USE` logic earlier.\n      # If we reach here with action_to_take being None, it implies a logical block\n      # or an uncollectable item/stuck state.\n\n      if action_to_take is not None:\n          collected_actions.append(action_to_take)\n          _reward, _done, _ = env.step(action_to_take)\n          steps_taken += 1\n      else:\n          # No productive movement action could be determined (e.g., already at target,\n          # but `USE` failed, or path is blocked).\n          break  # Exit loop to prevent infinite unproductive loops.\n\n  return collected_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:01:04.425649", "function_name": "collect", "function_body": "    # Helper for BFS pathfinding\n    def _find_path_bfs(grid, start_pos, target_kind, non_grabbable_indices, width, height, n_kinds):\n        \"\"\"\n        Finds the shortest path from start_pos to any cell containing target_kind\n        using Breadth-First Search (BFS).\n\n        Args:\n            grid (np.ndarray): The 3D grid (WIDTH, HEIGHT, n_kinds).\n            start_pos (tuple): (x, y) starting coordinates.\n            target_kind (int): The index of the item kind to find.\n            non_grabbable_indices (set): Set of indices for impassable obstacles.\n            width (int): Grid width.\n            height (int): Grid height.\n            n_kinds (int): Total number of kinds (for grid indexing safety).\n\n        Returns:\n            list: A list of (x, y) coordinates representing the path from a neighbor\n                  of start_pos to the target cell, or an empty list if no path is found.\n                  The list includes the target cell itself.\n        \"\"\"\n        q = [(start_pos, [])] # (current_pos, path_taken_so_far_coordinates)\n        visited = {start_pos}\n\n        # Directions for neighbors (dx, dy) - assuming grid[x,y] for (x,y) coordinates\n        # (0, 1) -> (x, y+1) -> DOWN\n        # (0, -1) -> (x, y-1) -> UP\n        # (1, 0) -> (x+1, y) -> RIGHT\n        # (-1, 0) -> (x-1, y) -> LEFT\n        directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n\n        while q:\n            (curr_x, curr_y), path = q.pop(0)\n\n            # Check if the current position contains the target kind\n            # Ensure target_kind is a valid index before accessing grid\n            if target_kind < n_kinds and grid[curr_x, curr_y, target_kind] == 1:\n                return path + [(curr_x, curr_y)] # Path includes the target cell\n\n            # Explore neighbors\n            for dx, dy in directions:\n                next_x, next_y = curr_x + dx, curr_y + dy\n                next_pos = (next_x, next_y)\n\n                # Check boundaries\n                if not (0 <= next_x < width and 0 <= next_y < height):\n                    continue\n\n                # Check if next cell is traversable (not a non-grabbable obstacle)\n                is_obstacle = False\n                for obstacle_idx in non_grabbable_indices:\n                    # Ensure obstacle_idx is a valid index\n                    if obstacle_idx < n_kinds and grid[next_x, next_y, obstacle_idx] == 1:\n                        is_obstacle = True\n                        break\n                if is_obstacle:\n                    continue\n\n                if next_pos not in visited:\n                    visited.add(next_pos)\n                    q.append((next_pos, path + [next_pos]))\n        return [] # No path found\n\n    # Helper to convert a path of (x,y) coordinates to CraftLab actions\n    def _path_to_actions(path_coords, current_pos_at_start, action_map):\n        \"\"\"\n        Converts a sequence of (x,y) coordinates into a list of CraftLab movement actions.\n\n        Args:\n            path_coords (list): A list of (x, y) tuples representing the sequence of cells\n                                to visit, starting from the cell *after* current_pos_at_start\n                                and ending at the target cell.\n            current_pos_at_start (tuple): The agent's starting (x, y) position.\n            action_map (dict): Dictionary mapping action names (str) to integer IDs.\n\n        Returns:\n            list: A list of integer actions (e.g., action_map['UP'], action_map['DOWN']).\n        \"\"\"\n        actions = []\n        # Prepend the starting position to the path for easier iteration\n        full_path = [current_pos_at_start] + path_coords\n\n        for i in range(len(full_path) - 1):\n            curr_x, curr_y = full_path[i]\n            next_x, next_y = full_path[i+1]\n\n            if next_x > curr_x:\n                actions.append(action_map['RIGHT'])\n            elif next_x < curr_x:\n                actions.append(action_map['LEFT'])\n            elif next_y > curr_y: # y increases downwards (typical grid coordinate system)\n                actions.append(action_map['DOWN'])\n            elif next_y < curr_y: # y decreases upwards\n                actions.append(action_map['UP'])\n            # If curr_x == next_x and curr_y == next_y, it means no movement,\n            # which should not happen in a valid path generated by BFS for distinct cells.\n        return actions\n\n    # 1. Get action mappings from the environment\n    action_map = env.action_specs()\n    ACTION_USE = action_map['USE']\n\n    # 2. Get current observations\n    obs = env.observations()\n    inventory = obs['features_dict']['inventory']\n    pos = tuple(obs['features_dict']['pos']) # Agent's current (x, y) position\n    grid = obs['features_dict']['features_global'] # Full allocentric grid (WIDTH, HEIGHT, n_kinds)\n\n    # Get grid dimensions and world info from the CraftLab instance's internal CraftWorld\n    width, height, n_kinds = grid.shape\n    \n    world = env.world # This is the CraftWorld instance\n    non_grabbable_indices = world.non_grabbable_indices # Set of indices for impassable obstacles\n\n    # 3. Check if primitive is already in inventory\n    # Ensure 'primitive' is a valid index for the inventory array\n    if 0 <= primitive < len(inventory) and inventory[primitive] > 0:\n        return [] # Already collected\n\n    # 4. Find path to the primitive on the grid using BFS\n    # The path_coords will be a list of (x,y) coordinates to traverse, ending at the target cell.\n    path_coords = _find_path_bfs(grid, pos, primitive, non_grabbable_indices, width, height, n_kinds)\n\n    if not path_coords:\n        return [] # No path found, cannot collect\n\n    # 5. Convert path coordinates to a list of movement actions\n    movement_actions = _path_to_actions(path_coords, pos, action_map)\n\n    # 6. Add the USE action if the primitive is a grabbable item\n    # After executing movement_actions, the agent will be at the target cell.\n    # We assume 'collecting' a primitive resource involves using it when standing on its tile.\n    # CraftWorld's `grabbable_indices` is a list.\n    if primitive in world.grabbable_indices:\n        return movement_actions + [ACTION_USE]\n    else:\n        # If the item is not grabbable, \"collecting\" it might not involve a USE action,\n        # or it might not be collectible in the traditional sense (e.g., an environment feature).\n        # For a 'collect' function focused on picking up items, we return the path to reach it.\n        # If the primitive isn't grabbable, a USE action would typically be ineffective for \"collection\".\n        return movement_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:01:04.496349", "function_name": "collect", "function_body": "    actions_sequence = []\n\n    obs = env.observations()\n    current_inventory = obs['features_dict']['inventory'].copy()\n\n    # 1. Check if primitive is already collected\n    if current_inventory[primitive] > 0:\n        return []\n\n    # Get relevant world information from the environment\n    world = env.world  # CraftLab has a world attribute\n    agent_current_pos = tuple(obs['features_dict']['pos'])  # Ensure it's a tuple for hashing\n    global_grid = obs['features_dict']['features_global']\n    height, width, _ = global_grid.shape\n\n    # Determine if the primitive is grabbable (picked up by moving onto)\n    # or requires a 'USE' action (like water/stone resources).\n    is_primitive_grabbable = primitive not in world.non_grabbable_indices\n    is_resource_node = (primitive == world.water_index or primitive == world.stone_index)\n\n    target_candidate_positions = []\n\n    # Find all locations of the primitive on the grid\n    for r in range(height):\n        for c in range(width):\n            if global_grid[r, c, primitive] == 1:\n                if is_resource_node:\n                    # For resource nodes (water, stone), we need to stand adjacent to them.\n                    # _get_neighbors_with_action is a helper function assumed to be available\n                    # in the module scope (or defined higher up).\n                    for (adj_r, adj_c), _ in _get_neighbors_with_action(r, c, height, width):\n                        target_candidate_positions.append((adj_r, adj_c))\n                else:\n                    # For grabbable items, we need to stand directly on their cell.\n                    target_candidate_positions.append((r, c))\n    \n    # Remove duplicate candidate positions\n    target_candidate_positions = list(set(target_candidate_positions))\n\n    if not target_candidate_positions:\n        # Primitive not found on the map or no accessible locations\n        return []\n\n    # Find the shortest path to any of the target candidate positions\n    best_path_actions = None\n\n    for target_pos_candidate in target_candidate_positions:\n        # _bfs_find_path_actions is a helper function assumed to be available\n        # in the module scope (or defined higher up). It handles obstacle avoidance.\n        path = _bfs_find_path_actions(agent_current_pos, target_pos_candidate, global_grid, world, primitive, is_primitive_grabbable)\n        \n        if path is not None:\n            if best_path_actions is None or len(path) < len(best_path_actions):\n                best_path_actions = path\n\n    if best_path_actions is None:\n        # No path found to any valid target position\n        return []\n\n    # Execute the movement actions\n    for action in best_path_actions:\n        _reward, _done, obs = env.step(action)\n        actions_sequence.append(action)\n        current_inventory = obs['features_dict']['inventory'].copy()\n        # Check if the primitive was collected after this move (e.g., walked onto a grabbable item)\n        if current_inventory[primitive] > 0:\n            return actions_sequence # Collected!\n\n    # After completing movement, if it's a resource node, perform a 'USE' action\n    if is_resource_node:\n        _reward, _done, obs = env.step(_USE) # _USE is an action constant (e.g., 4)\n        actions_sequence.append(_USE)\n        current_inventory = obs['features_dict']['inventory'].copy()\n        # Check if the primitive was collected after the 'USE' action\n        if current_inventory[primitive] > 0:\n            return actions_sequence # Collected!\n    \n    # If the primitive is still not collected after pathfinding and (optional) 'USE' action,\n    # return an empty list indicating failure to collect.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:02:35.722234", "function_name": "collect", "function_body": "    current_state = env._current_state\n    \n    # Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    start_pos = current_state.pos\n    start_dir = current_state.dir # Initial direction of the agent (0:N, 1:E, 2:S, 3:W)\n    height, width, n_kinds = grid.shape\n\n    # Action mappings (assuming standard DMLab Craft actions as per problem description)\n    # These are defined here for self-containment within the function.\n    ACTIONS = {\n        \"DOWN\": 0, \"UP\": 1, \"LEFT\": 2, \"RIGHT\": 3, \"USE\": 4\n    }\n\n    # BFS setup: queue stores (row, col, direction, list_of_actions_taken_to_get_here)\n    # Visited set stores (row, col, direction) tuples to avoid cycles and redundant paths.\n    q = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n    visited = {(start_pos[0], start_pos[1], start_dir)}\n\n    # Define movement actions and their effects on position and direction.\n    # Each entry maps an action value to (delta_row, delta_col, new_direction_after_move).\n    # Moving UP makes the agent face North (dir 0), moving DOWN makes it face South (dir 2), etc.\n    move_deltas = {\n        ACTIONS[\"UP\"]: (-1, 0, 0),    # Moves up, faces North (0)\n        ACTIONS[\"DOWN\"]: (1, 0, 2),   # Moves down, faces South (2)\n        ACTIONS[\"LEFT\"]: (0, -1, 3),  # Moves left, faces West (3)\n        ACTIONS[\"RIGHT\"]: (0, 1, 1),  # Moves right, faces East (1)\n    }\n\n    # Define delta_row, delta_col for each direction.\n    # This helps determine the cell directly in front of the agent.\n    dir_to_delta = {\n        0: (-1, 0), # North (UP)\n        1: (0, 1),  # East (RIGHT)\n        2: (1, 0),  # South (DOWN)\n        3: (0, -1)  # West (LEFT)\n    }\n\n    while q:\n        r, c, current_dir, path_so_far = q.popleft()\n\n        # STEP 1: Check if the primitive is directly in front of the agent from the current state.\n        # If so, we can perform the USE action to collect it.\n        dr_facing, dc_facing = dir_to_delta[current_dir]\n        fr, fc = r + dr_facing, c + dc_facing # Coordinates of the cell directly in front of the agent\n\n        # Check if the cell in front is within grid boundaries\n        if 0 <= fr < height and 0 <= fc < width:\n            # Check if the primitive is in the cell in front\n            if grid[fr, fc, primitive] > 0:\n                # Primitive found and agent is correctly oriented. Add USE action and return the path.\n                return path_so_far + [ACTIONS[\"USE\"]]\n\n        # STEP 2: Explore possible movement actions from the current state (r, c, current_dir).\n        # These actions move the agent to a new cell and also re-orient it.\n        for action_val, (dr_move, dc_move, new_dir) in move_deltas.items():\n            nr, nc = r + dr_move, c + dc_move # Calculate new position after this movement\n\n            # Check boundary conditions for the new position\n            if not (0 <= nr < height and 0 <= nc < width):\n                continue\n            \n            # For simplicity in collect_v2, we assume all cells are traversable for movement\n            # unless they are the target primitive. More advanced versions might check for\n            # obstacles like `world.non_grabbable_indices`.\n\n            # Check if this new state (position and direction) has been visited to avoid cycles\n            if (nr, nc, new_dir) not in visited:\n                visited.add((nr, nc, new_dir))\n                q.append((nr, nc, new_dir, path_so_far + [action_val]))\n\n    # If the queue is exhausted and no path to collect the primitive was found,\n    # it means the primitive is unreachable or does not exist.\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:02:36.687950", "function_name": "collect", "function_body": "  # Get an initial CraftState instance from the scenario to simulate from.\n  # This provides a clean starting point for the planning algorithm without\n  # modifying the actual environment's state.\n  initial_craft_state = env.scenario.init()\n  \n  # Store the initial inventory count of the primitive to detect collection.\n  # We make a copy to avoid modifying the original state's inventory count.\n  initial_primitive_count = initial_craft_state.inventory[primitive]\n\n  # Queue for BFS: stores (current_CraftState, list_of_actions_to_reach_this_state)\n  # A CraftState object encapsulates grid, pos, dir, and inventory.\n  q = collections.deque([(initial_craft_state, [])])\n\n  # Set to keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (position_tuple, inventory_tuple).\n  # Inventory is converted to a tuple for hashability.\n  visited = set()\n  visited.add((initial_craft_state.pos, tuple(initial_craft_state.inventory.tolist())))\n\n  # Define the movement actions to try.\n  # These are the direct grid movement actions.\n  # ACTION_USE is generally for interacting with workshops or non-grabbable items,\n  # and not typically for collecting basic primitive resources by walking over them.\n  # (Constants like ACTION_UP are assumed to be defined globally or in a parent scope.)\n  actions_to_try = [\n      1, # UP\n      0, # DOWN\n      2, # LEFT\n      3, # RIGHT\n  ]\n\n  while q:\n      current_state, current_path_actions = q.popleft()\n\n      # Check if the goal is satisfied:\n      # Has the primitive been collected? This means its count in the current\n      # inventory is greater than its count in the initial inventory.\n      if current_state.inventory[primitive] > initial_primitive_count:\n          return current_path_actions\n\n      # Explore all possible next states by applying each action\n      for action in actions_to_try:\n          # Simulate the action on a *copy* of the current_state.\n          # CraftState.step() returns a new CraftState object, which means\n          # the original current_state remains unchanged, allowing for proper BFS.\n          _reward, new_state = current_state.step(action)\n          \n          # Create a hashable representation of the new state for the visited set.\n          # Use new_state.pos (tuple) and tuple(new_state.inventory.tolist()) (tuple)\n          new_state_key = (new_state.pos, tuple(new_state.inventory.tolist()))\n\n          # If this new state hasn't been visited, add it to the queue and visited set.\n          if new_state_key not in visited:\n              visited.add(new_state_key)\n              q.append((new_state, current_path_actions + [action]))\n\n  # If the queue becomes empty and the goal was not reached, it means no path exists.\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:04:09.104105", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Constants for actions and directions\n    # These should ideally be imported or defined globally, but nested for strict compliance.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    NORTH = 0  # Assuming 0: North (row decreases)\n    EAST = 1   # 1: East (col increases)\n    SOUTH = 2  # 2: South (row increases)\n    WEST = 3   # 3: West (col decreases)\n\n    # Utility function mappings (nested for compliance)\n    _DELTA_TO_ACTION = {\n        (-1, 0): UP,\n        (1, 0): DOWN,\n        (0, -1): LEFT,\n        (0, 1): RIGHT\n    }\n\n    _DIR_TO_DELTA = {\n        NORTH: (-1, 0),\n        EAST: (0, 1),\n        SOUTH: (1, 0),\n        WEST: (0, -1)\n    }\n\n    def _get_turn_actions(current_dir, target_dir):\n        \"\"\"\n        Returns a list of actions (LEFT/RIGHT) to change from current_dir to target_dir.\n        Assumes current_dir and target_dir are 0 (N), 1 (E), 2 (S), 3 (W).\n        \"\"\"\n        actions = []\n        # Calculate difference in turns (clockwise, modulo 4)\n        diff = (target_dir - current_dir + 4) % 4\n        if diff == 1:  # 90 degrees clockwise\n            actions.append(RIGHT)\n        elif diff == 2:  # 180 degrees\n            actions.append(RIGHT)\n            actions.append(RIGHT) # Two rights or two lefts\n        elif diff == 3:  # 90 degrees counter-clockwise\n            actions.append(LEFT)\n        return actions\n\n    def _get_target_dir(agent_pos, item_pos):\n        \"\"\"\n        Calculates the direction the agent needs to face from agent_pos to item_pos.\n        Assumes agent_pos and item_pos are adjacent (Manhattan distance 1).\n        \"\"\"\n        dr = item_pos[0] - agent_pos[0]\n        dc = item_pos[1] - agent_pos[1]\n\n        if dr == -1 and dc == 0: return NORTH\n        if dr == 1 and dc == 0: return SOUTH\n        if dc == -1 and dr == 0: return WEST\n        if dc == 1 and dr == 0: return EAST\n        return None # Should not happen if positions are truly adjacent\n\n    def _is_valid_pos(pos, width, height):\n        \"\"\"Checks if a position (r, c) is within grid bounds.\"\"\"\n        r, c = pos\n        return 0 <= r < width and 0 <= c < height\n\n    # Access current state from the environment\n    # CraftLab wraps CraftState, which holds grid, pos, and dir.\n    current_state = env.unwrapped._current_state\n    grid = current_state.grid\n    start_pos = current_state.pos\n    start_dir = current_state.dir\n\n    width, height, _ = grid.shape # grid is (WIDTH, HEIGHT, n_kinds)\n\n    # 1. Find all locations of the primitive in the grid\n    # np.argwhere returns (row, col) tuples for non-zero elements\n    primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n    if len(primitive_locations) == 0:\n        return [] # Primitive not found in the grid\n\n    # 2. Identify all possible target cells (cells adjacent to any primitive)\n    target_cells = set()\n    # Relative movements for 4-directional adjacency (up, down, left, right)\n    adjacent_deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n    for p_r, p_c in primitive_locations:\n        for dr, dc in adjacent_deltas:\n            neighbor_pos = (p_r + dr, p_c + dc)\n            if _is_valid_pos(neighbor_pos, width, height):\n                target_cells.add(neighbor_pos)\n\n    if not target_cells:\n        # This case should be rare if primitive_locations is not empty,\n        # unless primitives are in a way that no valid adjacent cells exist (e.g., 1x1 grid).\n        return []\n\n    # 3. Breadth-First Search (BFS) to find the shortest action sequence\n    # BFS queue stores (current_position (tuple), current_direction (int), list_of_actions_taken)\n    queue = collections.deque([(start_pos, start_dir, [])])\n    # visited set stores (position (tuple), direction (int)) to avoid redundant states and cycles\n    visited = set([(start_pos, start_dir)])\n\n    while queue:\n        curr_pos, curr_dir, curr_actions = queue.popleft()\n\n        # Check if current position is one of the target cells\n        if curr_pos in target_cells:\n            # We found a path to a cell adjacent to *a* primitive.\n            # Now, determine which specific primitive it is adjacent to and face it.\n            found_primitive_item_pos = None\n            for p_r, p_c in primitive_locations:\n                # Check for 4-directional adjacency (Manhattan distance of 1)\n                if (abs(curr_pos[0] - p_r) + abs(curr_pos[1] - p_c) == 1):\n                    found_primitive_item_pos = (p_r, p_c)\n                    break\n            \n            if found_primitive_item_pos:\n                # Calculate the required direction to face the primitive from the current position\n                target_facing_dir = _get_target_dir(curr_pos, found_primitive_item_pos)\n                if target_facing_dir is not None:\n                    # Generate the turning actions to face the primitive\n                    turn_actions = _get_turn_actions(curr_dir, target_facing_dir)\n                    # Return the complete sequence: path actions + turn actions + USE action\n                    return curr_actions + turn_actions + [USE]\n\n        # Explore possible next states (movements and turns)\n\n        # 1. Explore movements (UP, DOWN, LEFT, RIGHT)\n        for dr, dc in _DELTA_TO_ACTION.keys(): # Iterates through (-1,0), (1,0), (0,-1), (0,1)\n            next_pos = (curr_pos[0] + dr, curr_pos[1] + dc)\n            move_action = _DELTA_TO_ACTION[(dr, dc)]\n\n            # Check if the next position is valid and not already visited with the current direction\n            if _is_valid_pos(next_pos, width, height) and (next_pos, curr_dir) not in visited:\n                # Assume all grid cells within bounds are traversable for movement.\n                visited.add((next_pos, curr_dir))\n                queue.append((next_pos, curr_dir, curr_actions + [move_action]))\n\n        # 2. Explore turns (LEFT, RIGHT) without changing position\n        for turn_action in [LEFT, RIGHT]:\n            # Calculate the new direction after the turn\n            next_dir = (curr_dir + (1 if turn_action == RIGHT else -1) + 4) % 4\n            \n            # Check if this (position, new_direction) state has been visited\n            if (curr_pos, next_dir) not in visited:\n                visited.add((curr_pos, next_dir))\n                queue.append((curr_pos, next_dir, curr_actions + [turn_action]))\n\n    # If the queue becomes empty and no path to a target cell was found\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:04:10.085519", "function_name": "collect", "function_body": "  import collections\n\n  # 1. Get Action Mappings\n  action_specs = env.action_specs()\n  ACT_UP = action_specs['UP']\n  ACT_DOWN = action_specs['DOWN']\n  ACT_LEFT = action_specs['LEFT']\n  ACT_RIGHT = action_specs['RIGHT']\n  ACT_USE = action_specs['USE']\n\n  # Mapping of (dr, dc) to action\n  # Assuming (dr, dc) represents (delta_row, delta_col)\n  _MOVE_DRDC_TO_ACTION = {\n      (-1, 0): ACT_UP,    # Decreasing row index is moving UP\n      (1, 0): ACT_DOWN,   # Increasing row index is moving DOWN\n      (0, -1): ACT_LEFT,  # Decreasing col index is moving LEFT\n      (0, 1): ACT_RIGHT   # Increasing col index is moving RIGHT\n  }\n\n  # 2. Get Initial State for pathfinding\n  obs = env.observations()\n  grid = obs['features_global']\n  # current_pos is a numpy array (y, x) or (row, col)\n  # Convert to tuple for hashing in sets/dicts\n  current_pos = tuple(obs['pos']) \n\n  # Grid dimensions: H for Height (rows), W for Width (columns)\n  H, W, K = grid.shape\n  \n  # Accessing non_grabbable_indices from the CraftLab instance itself\n  non_grabbable_indices = env.non_grabbable_indices\n\n  # 3. Pre-compute Primitive Locations and Accessible Targets\n  primitive_locations = []\n  for r in range(H):\n    for c in range(W):\n      if grid[r, c, primitive] == 1:\n        primitive_locations.append((r, c))\n\n  if not primitive_locations:\n    # Primitive not found on the map\n    return [] \n\n  # Target cells are any traversable cell from which the primitive can be 'USE'd.\n  # This means any traversable cell (nr, nc) that is in the 3x3 neighborhood\n  # (including diagonals and the cell itself if primitive is on it) of a primitive_location.\n  target_cells = set()\n  for pr, pc in primitive_locations:\n    # Iterate through 3x3 neighborhood around the primitive location\n    for dr in [-1, 0, 1]:\n      for dc in [-1, 0, 1]:\n        nr, nc = pr + dr, pc + dc\n        \n        # Check if neighbor is within grid bounds\n        if 0 <= nr < H and 0 <= nc < W:\n          # Check if (nr, nc) is traversable: it must not contain any non-grabbable item.\n          is_traversable = True\n          for ng_idx in non_grabbable_indices:\n            if grid[nr, nc, ng_idx] == 1: # If this cell contains a non-grabbable item\n              is_traversable = False\n              break\n          \n          # If traversable, it's a valid target cell for the agent to move to\n          if is_traversable:\n            target_cells.add((nr, nc))\n\n  # If the agent is already at a suitable collection spot, just use it.\n  if current_pos in target_cells:\n    return [ACT_USE]\n\n  # 4. BFS Pathfinding\n  # Queue stores (current_position_tuple, list_of_actions_to_reach_this_pos)\n  queue = collections.deque([(current_pos, [])])\n  visited = {current_pos} # Set of visited positions to avoid cycles and redundant checks\n\n  found_path_actions = None\n\n  while queue:\n    (r, c), path = queue.popleft()\n\n    # If the current position is one of the target cells, we found the shortest path.\n    if (r, c) in target_cells:\n      found_path_actions = path\n      break\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # North, South, West, East moves\n      nr, nc = r + dr, c + dc # Calculate new row and column\n\n      # Check if neighbor is within grid bounds and has not been visited yet\n      if 0 <= nr < H and 0 <= nc < W and (nr, nc) not in visited:\n        # Check if the neighbor cell is traversable\n        is_traversable = True\n        for ng_idx in non_grabbable_indices:\n          if grid[nr, nc, ng_idx] == 1: # If this cell contains a non-grabbable item\n            is_traversable = False\n            break\n        \n        if is_traversable:\n          visited.add((nr, nc))\n          # Get the action corresponding to this specific move (dr, dc)\n          action_for_move = _MOVE_DRDC_TO_ACTION[(dr, dc)]\n          queue.append(((nr, nc), path + [action_for_move]))\n\n  # 5. Return Actions\n  if found_path_actions is not None:\n    # If a path was found, append the USE action at the end\n    return found_path_actions + [ACT_USE]\n  else:\n    # No path found to a suitable collection spot\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:06:04.309625", "function_name": "collect", "function_body": "  # Constants from collect_v1\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Direction constants (assuming 0=N, 1=E, 2=S, 3=W clockwise from North)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper functions (copied from collect_v1 and adapted)\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"Calculates the direction the agent needs to face to look at the item.\"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 0 and dy == 0:\n      return None  # Agent is on top of item, should not happen when targeting an adjacent cell\n\n    # Prioritize cardinal directions based on largest component\n    if abs(dx) > abs(dy):\n      return EAST_DIR if dx > 0 else WEST_DIR\n    elif abs(dy) > abs(dx):\n      return SOUTH_DIR if dy > 0 else NORTH_DIR\n    else: # This branch is for diagonal cases (e.g., dx=1, dy=1), which aren't direct adjacent cells.\n          # For adjacent cells (dx=0 or dy=0), one of the above ifs will be true.\n          # If it were a diagonal, prioritize vertical or horizontal. For simplicity, match first non-zero.\n      if dy > 0: return SOUTH_DIR\n      if dy < 0: return NORTH_DIR\n      if dx > 0: return EAST_DIR\n      if dx < 0: return WEST_DIR\n    return None\n\n  def _get_turn_actions(current_dir, target_dir):\n    \"\"\"Returns a list of actions to turn from current_dir to target_dir.\"\"\"\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    # Calculate shortest turns (clockwise vs. counter-clockwise)\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION)\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION)\n    return actions\n\n  # Get primitive's integer ID\n  try:\n    primitive_id = env.world.cookbook.index[primitive]\n  except KeyError:\n    return [] # Primitive name not recognized by the cookbook index\n\n  current_state = env._current_state\n\n  # Check if primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Primitive already collected\n\n  grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  initial_agent_dir = current_state.dir # Agent's initial direction for turning later\n\n  grid_height, grid_width, _ = grid.shape # grid.shape is (HEIGHT, WIDTH, KINDS)\n\n  # Find all locations of the primitive on the grid\n  primitive_y_coords, primitive_x_coords = np.where(grid[:, :, primitive_id] == 1)\n  primitive_locations = [(px, py) for px, py in zip(primitive_x_coords, primitive_y_coords)]\n\n  if not primitive_locations:\n    return [] # Primitive not found on the grid\n\n  # Identify obstacle indices\n  # Assuming 'water' is an impassable obstacle. Add other indices if known to be impassable.\n  obstacle_indices = {env.world.water_index}\n\n  # BFS for shortest path from agent_pos to any cell adjacent to a primitive\n  queue = collections.deque([(agent_pos_x, agent_pos_y, [])]) # (x, y, path_actions)\n  visited = set([(agent_pos_x, agent_pos_y)])\n\n  # Movement deltas and corresponding actions\n  _MOVES = {\n      (0, -1): UP_ACTION,\n      (0, 1): DOWN_ACTION,\n      (-1, 0): LEFT_ACTION,\n      (1, 0): RIGHT_ACTION,\n  }\n\n  while queue:\n    curr_x, curr_y, path_actions = queue.popleft()\n\n    # Check if this current cell (curr_x, curr_y) is adjacent to any primitive\n    # We prioritize the first such path found by BFS, which guarantees it's the shortest path\n    # to *an* adjacent cell of *some* primitive.\n    for px, py in primitive_locations:\n      if abs(curr_x - px) + abs(curr_y - py) == 1: # Manhattan distance 1 means adjacent\n        # Path to adjacent cell found!\n        final_agent_pos_x, final_agent_pos_y = curr_x, curr_y\n        final_path_actions = list(path_actions) # Create a copy to extend\n\n        # Agent's direction after movement actions is still the initial_agent_dir,\n        # as movement actions (UP/DOWN/LEFT/RIGHT) typically don't change orientation.\n        agent_current_dir = initial_agent_dir\n\n        # Add turning actions to face the primitive from the final adjacent position\n        target_face_dir = _get_target_facing_direction(final_agent_pos_x, final_agent_pos_y, px, py)\n        if target_face_dir is not None:\n          final_path_actions.extend(_get_turn_actions(agent_current_dir, target_face_dir))\n          # The agent's direction would conceptually update after these turns\n          agent_current_dir = target_face_dir\n\n        # Add the USE action to collect the primitive\n        final_path_actions.append(USE_ACTION)\n        return final_path_actions\n\n    # Explore neighbors\n    for (dx, dy), action in _MOVES.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check bounds\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if next cell is an obstacle (e.g., water)\n      is_obstacle_cell = False\n      for obs_idx in obstacle_indices:\n        if grid[next_y, next_x, obs_idx] == 1:\n          is_obstacle_cell = True\n          break\n      if is_obstacle_cell:\n        continue\n\n      # If the cell has already been visited, skip\n      if (next_x, next_y) in visited:\n        continue\n\n      visited.add((next_x, next_y))\n      queue.append((next_x, next_y, path_actions + [action]))\n\n  # If BFS completes and no path to an adjacent primitive is found\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:06:05.296666", "function_name": "collect", "function_body": "  # Constants\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 0 and dy == 0:\n      return None\n\n    # Prioritize horizontal if magnitude is greater or equal, otherwise vertical\n    if abs(dx) >= abs(dy):\n      return EAST_DIR if dx > 0 else WEST_DIR\n    else: # abs(dy) > abs(dx)\n      return SOUTH_DIR if dy > 0 else NORTH_DIR\n\n  # Helper function: Returns actions to turn from current_dir to target_dir.\n  # Assumes LEFT_ACTION and RIGHT_ACTION (which are also movement actions)\n  # can be used as turning actions in this context.\n  def _get_turn_actions(current_dir, target_dir):\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION) # Turn right\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION) # Turn left\n    return actions\n\n  # Get primitive's integer ID\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir # Initial agent direction\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Find all locations of the primitive on the grid\n  # np.where returns (row_indices, col_indices) which correspond to (y_coords, x_coords)\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Find the closest primitive location to the agent's current position\n  min_distance = float('inf')\n  closest_primitive_pos = None\n\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    distance = abs(item_x - agent_pos_x) + abs(item_y - agent_pos_y)\n    if distance < min_distance:\n      min_distance = distance\n      closest_primitive_pos = (item_x, item_y)\n\n  target_item_x, target_item_y = closest_primitive_pos\n  \n  # Determine the target adjacent position for the agent to move to\n  # Try all 4 cardinal adjacent cells, pick the one closest to current agent_pos\n  # And ensure it's within grid bounds.\n  candidate_adj_positions = []\n  # (dx, dy) relative to item: (-1,0) left, (1,0) right, (0,-1) up, (0,1) down\n  for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: \n    adj_x, adj_y = target_item_x + dx, target_item_y + dy\n    if 0 <= adj_x < grid_width and 0 <= adj_y < grid_height:\n      candidate_adj_positions.append((adj_x, adj_y))\n  \n  if not candidate_adj_positions:\n    return [] # Should not happen for a non-trivial grid unless item is completely surrounded\n\n  # Find the candidate adjacent position that is closest to the agent's current position\n  min_adj_distance = float('inf')\n  chosen_adj_pos = None\n  for adj_x, adj_y in candidate_adj_positions:\n    distance = abs(adj_x - agent_pos_x) + abs(adj_y - agent_pos_y)\n    if distance < min_adj_distance:\n      min_adj_distance = distance\n      chosen_adj_pos = (adj_x, adj_y)\n\n  if chosen_adj_pos is None:\n    return [] # No valid adjacent position found\n\n  # --- BFS Pathfinding to chosen_adj_pos ---\n  # State for BFS: (current_x, current_y, list_of_actions_to_reach_here)\n  # Using a list as a queue (pop(0) is O(N), but necessary due to \"no imports\" rule for collections.deque)\n  queue = [(agent_pos_x, agent_pos_y, [])]\n  visited = set([(agent_pos_x, agent_pos_y)])\n  \n  path_to_adj_pos = []\n\n  # Define movement deltas for each action\n  ACTION_MOVES = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0),\n  }\n\n  while queue:\n    curr_x, curr_y, current_path = queue.pop(0) # Pop from the front for BFS\n\n    if (curr_x, curr_y) == chosen_adj_pos:\n      path_to_adj_pos = current_path\n      break\n\n    # Explore possible moves\n    for action, (dx, dy) in ACTION_MOVES.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check boundaries and if not visited\n      if 0 <= next_x < grid_width and 0 <= next_y < grid_height and \\\n         (next_x, next_y) not in visited:\n        \n        visited.add((next_x, next_y))\n        queue.append((next_x, next_y, current_path + [action]))\n\n  # If path_to_adj_pos is empty and agent is not already at target, it means no path found.\n  # This handles cases where chosen_adj_pos might be unreachable (e.g., if grid had obstacles).\n  if not path_to_adj_pos and (agent_pos_x, agent_pos_y) != chosen_adj_pos:\n    return []\n\n  # Initialize final actions list with the path found by BFS\n  final_actions = list(path_to_adj_pos)\n\n  # After movement, determine the direction agent needs to face the primitive.\n  # The agent's `dir` is its initial direction. Movement actions (UP/DOWN/LEFT/RIGHT)\n  # are assumed not to change this orientation until explicit turning actions are applied.\n  target_face_dir = _get_target_facing_direction(chosen_adj_pos[0], chosen_adj_pos[1], target_item_x, target_item_y)\n  \n  if target_face_dir is not None:\n    # Add turning actions to face the primitive\n    final_actions.extend(_get_turn_actions(agent_dir, target_face_dir))\n  \n  # Add the USE action to collect the primitive\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:07:39.557544", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Direction constants (assuming 0=N, 1=E, 2=S, 3=W clockwise from North)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper functions (copied from collect_v1 for scope, as per pattern)\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"Calculates the direction the agent needs to face to look at the item.\"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 0 and dy == 0:\n      return None # Agent is on top of item, should not happen when targeting an adjacent cell\n\n    # Prioritize cardinal directions based on largest component\n    if abs(dx) > abs(dy):\n      return EAST_DIR if dx > 0 else WEST_DIR\n    elif abs(dy) > abs(dx):\n      return SOUTH_DIR if dy > 0 else NORTH_DIR\n    else: # This branch is for diagonal cases or when dx=dy (e.g., dx=1, dy=1).\n          # For adjacent cells (dx=0 or dy=0 for direct adjacency), one of the above ifs will be true.\n          # If it were a diagonal, prioritize vertical or horizontal. For simplicity, match first non-zero.\n      if dy > 0: return SOUTH_DIR\n      if dy < 0: return NORTH_DIR\n      if dx > 0: return EAST_DIR\n      if dx < 0: return WEST_DIR\n    return None\n\n  def _get_turn_actions(current_dir, target_dir):\n    \"\"\"Returns a list of actions to turn from current_dir to target_dir.\n    Assumes LEFT_ACTION and RIGHT_ACTION are turn actions in this context.\"\"\"\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    # Calculate shortest turns (clockwise vs. counter-clockwise)\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION)\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION)\n    return actions\n\n  # Get primitive's integer ID\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  start_pos_x, start_pos_y = current_state.pos\n  # Agent's direction does not change with movement actions.\n  # It only changes with turn actions (LEFT_ACTION/RIGHT_ACTION via _get_turn_actions)\n  start_dir = current_state.dir \n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape \n\n  # Get non-grabbable entity indices to identify obstacles\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  def is_walkable(x, y, current_grid):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-grabbable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell (y, x) contains any non-grabbable item (obstacle)\n    for kind_idx in non_grabbable_kinds:\n      if current_grid[y, x, kind_idx] > 0:\n        return False\n    return True\n\n  # Find all locations of the primitive on the grid\n  # np.where returns (row_indices, col_indices) which correspond to (y_coords, x_coords)\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Find the closest primitive location to the agent's current position (Manhattan distance)\n  min_distance_to_primitive = float('inf')\n  closest_primitive_pos = None\n\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    distance = abs(item_x - start_pos_x) + abs(item_y - start_pos_y)\n    if distance < min_distance_to_primitive:\n      min_distance_to_primitive = distance\n      closest_primitive_pos = (item_x, item_y)\n\n  target_item_x, target_item_y = closest_primitive_pos\n  \n  # Determine all valid and walkable adjacent positions to the chosen primitive.\n  # These are the target cells for our BFS pathfinding.\n  target_adjacent_cells = []\n  # Define cardinal movement deltas with corresponding actions\n  cardinal_moves = {\n      RIGHT_ACTION: (1, 0),\n      LEFT_ACTION: (-1, 0),\n      DOWN_ACTION: (0, 1), # Y increases downwards\n      UP_ACTION: (0, -1)  # Y decreases upwards\n  }\n\n  for action, (dx, dy) in cardinal_moves.items():\n    adj_x, adj_y = target_item_x + dx, target_item_y + dy\n    if is_walkable(adj_x, adj_y, grid):\n      target_adjacent_cells.append((adj_x, adj_y))\n  \n  if not target_adjacent_cells:\n    return [] # No walkable adjacent position to the primitive found\n\n  # BFS to find the shortest sequence of movement actions to reach *any* target adjacent cell\n  # State in queue: (current_x, current_y, list_of_actions_to_reach_this_state)\n  queue = collections.deque([(start_pos_x, start_pos_y, [])]) \n  # Visited set: (x, y) coordinates to prevent cycles and ensure shortest path finding (for position only)\n  visited = {(start_pos_x, start_pos_y)} \n\n  movement_actions_to_primitive = None # Stores the sequence of actions if a path is found\n\n  while queue:\n    curr_x, curr_y, path_actions = queue.popleft()\n\n    if (curr_x, curr_y) in target_adjacent_cells:\n      # Found a path to an adjacent cell. Since BFS, this is the shortest path by moves.\n      movement_actions_to_primitive = path_actions\n      break # Exit BFS, shortest path found\n\n    # Explore neighbors (movement actions)\n    for action, (dx, dy) in cardinal_moves.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      if is_walkable(next_x, next_y, grid) and (next_x, next_y) not in visited:\n        visited.add((next_x, next_y))\n        new_path_actions = list(path_actions) + [action] # Append the action to the path\n        queue.append((next_x, next_y, new_path_actions))\n  \n  if movement_actions_to_primitive is None:\n    return [] # No path found to any adjacent walkable cell\n\n  # Construct the full sequence of actions:\n  # 1. Movement actions to reach the adjacent cell.\n  # 2. Turning actions to face the primitive.\n  # 3. The USE action.\n\n  # Simulate the agent's final position after executing the movement actions\n  final_agent_pos_x, final_agent_pos_y = start_pos_x, start_pos_y\n  for action in movement_actions_to_primitive:\n      dx, dy = cardinal_moves[action]\n      final_agent_pos_x += dx\n      final_agent_pos_y += dy\n\n  # Determine the direction the agent needs to face the primitive from its final position\n  # The agent's facing direction (`start_dir`) hasn't changed during movement actions.\n  target_face_dir = _get_target_facing_direction(final_agent_pos_x, final_agent_pos_y, target_item_x, target_item_y)\n  \n  all_actions = list(movement_actions_to_primitive) # Start with actions to move to the adjacent cell\n  \n  if target_face_dir is not None:\n    # Add turning actions, using the agent's initial direction (since movement doesn't change it)\n    turn_actions = _get_turn_actions(start_dir, target_face_dir)\n    all_actions.extend(turn_actions)\n  \n  # Add the USE action to collect the primitive\n  all_actions.append(USE_ACTION)\n\n  return all_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:07:40.595439", "function_name": "collect", "function_body": "  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Direction constants (assuming 0=N, 1=E, 2=S, 3=W clockwise from North)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Map movement actions to the direction the agent faces after taking that action\n  ACTION_TO_DIR_MAP = {\n      DOWN_ACTION: SOUTH_DIR,\n      UP_ACTION: NORTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  def _get_action_for_move_xy(current_x, current_y, target_x, target_y):\n    \"\"\"Returns the single action to move towards target_x, target_y from current_x, current_y.\n    Prioritizes horizontal movement if not at target_x, otherwise vertical.\n    \"\"\"\n    if target_x > current_x: return RIGHT_ACTION\n    if target_x < current_x: return LEFT_ACTION\n    if target_y > current_y: return DOWN_ACTION\n    if target_y < current_y: return UP_ACTION\n    return None # Already at target x or y\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"Calculates the direction the agent needs to face to look at the item.\n    Assumes item is adjacent to agent_x, agent_y.\n    \"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    # For adjacent cells, exactly one of dx or dy will be non-zero (or both zero if on same spot)\n    if dx > 0: return EAST_DIR\n    if dx < 0: return WEST_DIR\n    if dy > 0: return SOUTH_DIR\n    if dy < 0: return NORTH_DIR\n    return None # Should not be reached if item is adjacent and not on top of agent\n\n  def _get_turn_actions(current_dir, target_dir):\n    \"\"\"Returns a list of actions to turn from current_dir to target_dir.\"\"\"\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    # Calculate shortest turns (clockwise vs. counter-clockwise)\n    # Adding 4 and modulo 4 ensures positive results for subtraction (e.g., 0 - 3 = -3, (-3+4)%4 = 1)\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION) # Assuming RIGHT_ACTION makes agent turn clockwise\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION) # Assuming LEFT_ACTION makes agent turn counter-clockwise\n    return actions\n\n  # Get primitive's integer ID\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir\n  # grid.shape is (HEIGHT, WIDTH, KINDS)\n  grid_height, grid_width, _ = grid.shape\n\n  # Find all locations of the primitive on the grid\n  # np.where returns (row_indices, col_indices) which correspond to (y_coords, x_coords)\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Find the closest primitive location to the agent's current position (Manhattan distance)\n  min_distance = float('inf')\n  closest_primitive_pos = None\n\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    distance = abs(item_x - agent_pos_x) + abs(item_y - agent_pos_y)\n    if distance < min_distance:\n      min_distance = distance\n      closest_primitive_pos = (item_x, item_y)\n\n  target_item_x, target_item_y = closest_primitive_pos\n\n  # Determine the target adjacent position for the agent to move to.\n  # We look for the adjacent cell that is closest to the agent's current position.\n  candidate_adj_positions = []\n  # Iterate over cardinal neighbors relative to the item\n  for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (left, right, up, down)\n    adj_x, adj_y = target_item_x + dx, target_item_y + dy\n    # Check if the candidate adjacent position is within grid boundaries\n    if 0 <= adj_x < grid_width and 0 <= adj_y < grid_height:\n      candidate_adj_positions.append((adj_x, adj_y))\n\n  if not candidate_adj_positions:\n    return [] # Should not happen unless the primitive is stuck in a 1x1 area with no accessible neighbors\n\n  # Select the candidate adjacent position that is closest to the agent's initial position\n  min_adj_distance = float('inf')\n  chosen_adj_pos = None\n  for adj_x, adj_y in candidate_adj_positions:\n    distance = abs(adj_x - agent_pos_x) + abs(adj_y - agent_pos_y)\n    if distance < min_adj_distance:\n      min_adj_distance = distance\n      chosen_adj_pos = (adj_x, adj_y)\n\n  if chosen_adj_pos is None:\n    return [] # No valid adjacent position found (e.g., primitive is at a corner with no space)\n\n  # Generate movement actions to reach the chosen_adj_pos,\n  # while continuously updating the conceptual agent position and direction.\n  actions = []\n  curr_x, curr_y = agent_pos_x, agent_pos_y\n  curr_dir = agent_dir # Current conceptual direction of the agent\n  target_x, target_y = chosen_adj_pos\n\n  # Pathfinding: First move horizontally, then vertically.\n  # For each step, determine the action, add it, and update conceptual position and direction.\n  while curr_x != target_x:\n    move_action = _get_action_for_move_xy(curr_x, curr_y, target_x, target_y)\n    actions.append(move_action)\n    # Update conceptual position\n    if move_action == RIGHT_ACTION: curr_x += 1\n    elif move_action == LEFT_ACTION: curr_x -= 1\n    # Update conceptual direction based on the movement action\n    curr_dir = ACTION_TO_DIR_MAP[move_action]\n\n  while curr_y != target_y:\n    move_action = _get_action_for_move_xy(curr_x, curr_y, target_y, target_y) # This should be target_y not curr_y\n    # Fix: The target_x and target_y parameters in _get_action_for_move_xy need to be\n    # the final target, not the intermediate curr_y or target_y.\n    # The logic in _get_action_for_move_xy determines the *next step* towards the ultimate target.\n    move_action = _get_action_for_move_xy(curr_x, curr_y, target_x, target_y)\n    actions.append(move_action)\n    # Update conceptual position\n    if move_action == DOWN_ACTION: curr_y += 1\n    elif move_action == UP_ACTION: curr_y -= 1\n    # Update conceptual direction based on the movement action\n    curr_dir = ACTION_TO_DIR_MAP[move_action]\n\n  # After movement, the agent is conceptually at `chosen_adj_pos`.\n  # `curr_dir` holds the direction the agent is facing after the last movement action.\n  # Now, determine the direction the agent needs to face to look at the primitive from this adjacent position.\n  target_face_dir = _get_target_facing_direction(curr_x, curr_y, target_item_x, target_item_y)\n\n  if target_face_dir is not None:\n    # Add turning actions to face the primitive, based on the agent's current conceptual direction\n    # and the required final facing direction.\n    actions.extend(_get_turn_actions(curr_dir, target_face_dir))\n\n  # Add the USE action to collect the primitive\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:09:07.613832", "function_name": "collect", "function_body": "    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    state = env._current_state\n    current_inventory = state.inventory\n    grid = state.grid\n    current_pos = state.pos  # (x, y) tuple, typically (column, row)\n\n    # 1. Check if the primitive is already in the inventory.\n    if current_inventory[primitive] > 0:\n        return []\n\n    # 2. Check if the primitive is already in the agent's 3x3 neighborhood.\n    # If it is, the agent can collect it with a single USE action.\n    if state.next_to(primitive):\n        return [USE]\n\n    # 3. Find all locations of the primitive on the grid.\n    # grid.shape is (WIDTH, HEIGHT, n_kinds) assuming (x, y, kind) indexing\n    WIDTH, HEIGHT = grid.shape[0], grid.shape[1] \n    \n    primitive_locations = [] # Stores (x, y) coordinates where the primitive is\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] == 1:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        # Primitive not found on the map, cannot collect it.\n        return []\n\n    # 4. Use Breadth-First Search (BFS) to find the shortest path to a position\n    # from which the 'USE' action can successfully collect the primitive.\n    # A position (ax, ay) is 'pickup-ready' if any primitive location (px, py)\n    # is within its 3x3 neighborhood (i.e., |ax-px| <= 1 and |ay-py| <= 1).\n\n    # BFS queue: stores tuples of (current_position_tuple, path_of_actions_taken)\n    queue = collections.deque([(current_pos, [])])\n    visited = {current_pos} # Keep track of visited positions to avoid loops and redundant searches\n\n    # Define possible moves and their corresponding actions\n    # Assuming (x, y) corresponds to (column, row)\n    moves_and_actions = [\n        ((-1, 0), LEFT),  # Move Left (decrease x)\n        ((1, 0), RIGHT), # Move Right (increase x)\n        ((0, -1), UP),   # Move Up (decrease y)\n        ((0, 1), DOWN)   # Move Down (increase y)\n    ]\n\n    while queue:\n        (curr_x, curr_y), path_actions = queue.popleft()\n\n        for (dx, dy), action in moves_and_actions:\n            next_x, next_y = curr_x + dx, curr_y + dy\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                continue\n            \n            # Check if this position has already been visited\n            if (next_x, next_y) in visited:\n                continue\n\n            visited.add((next_x, next_y))\n            new_path_actions = path_actions + [action]\n\n            # Check if this new position (next_x, next_y) is 'pickup-ready'\n            # (i.e., if any primitive is within the 3x3 neighborhood of (next_x, next_y))\n            is_pickup_ready = False\n            for px, py in primitive_locations:\n                if abs(next_x - px) <= 1 and abs(next_y - py) <= 1:\n                    is_pickup_ready = True\n                    break\n            \n            if is_pickup_ready:\n                # Found the shortest path to a pickup-ready position,\n                # append the USE action and return the full action list.\n                return new_path_actions + [USE]\n            else:\n                # Not yet at a pickup-ready position, continue BFS\n                queue.append(((next_x, next_y), new_path_actions))\n\n    # If the BFS completes and no path to a collectable primitive is found\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:09:07.685647", "function_name": "collect", "function_body": "    # Get action mappings\n    action_specs = env.action_specs()\n    A_UP = action_specs[\"UP\"]\n    A_DOWN = action_specs[\"DOWN\"]\n    A_LEFT = action_specs[\"LEFT\"]\n    A_RIGHT = action_specs[\"RIGHT\"]\n    A_USE = action_specs[\"USE\"]\n\n    # Map movement actions to (dx, dy, new_facing_dir)\n    # The agent's dir attribute: 0=N (Up), 1=E (Right), 2=S (Down), 3=W (Left)\n    MOVE_MAPPING = {\n        A_UP: (0, -1, 0),   # (dx, dy, new_dir_after_move) -> North\n        A_DOWN: (0, 1, 2),  # (dx, dy, new_dir_after_move) -> South\n        A_LEFT: (-1, 0, 3), # (dx, dy, new_dir_after_move) -> West\n        A_RIGHT: (1, 0, 1)  # (dx, dy, new_dir_after_move) -> East\n    }\n\n    obs = env.observations()\n    current_grid = obs[\"features_dict\"][\"features_global\"]\n    current_pos = tuple(obs[\"features_dict\"][\"pos\"]) # (x, y)\n    # Direction is one-hot. Convert to int: [1,0,0,0] -> 0, [0,1,0,0] -> 1 etc.\n    current_dir = np.argmax(obs[\"features_dict\"][\"direction\"])\n    current_inventory = obs[\"features_dict\"][\"inventory\"]\n\n    # Check if the primitive is already in the inventory\n    if current_inventory[primitive] > 0:\n        return []\n\n    grid_width, grid_height, _ = current_grid.shape\n\n    # Find all locations of the primitive on the grid\n    primitive_locations = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if current_grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        # Primitive not found on the grid, so it's unreachable\n        return []\n\n    # Get non-grabbable indices from the world for pathfinding (obstacles)\n    # These are entities the agent cannot walk through.\n    non_grabbable_indices_list = list(env.world.non_grabbable_indices)\n\n    # BFS state: ((current_x, current_y), current_direction, list_of_actions_taken)\n    queue = collections.deque([(current_pos, current_dir, [])])\n    visited = set([(current_pos, current_dir)]) # Keep track of visited (pos, dir) states\n\n    while queue:\n        (x, y), current_d, path = queue.popleft()\n\n        # Check if the current position (x,y) is adjacent to any primitive location\n        # and if the agent is facing the correct direction to USE that primitive.\n        for px, py in primitive_locations:\n            dx, dy = px - x, py - y\n            if abs(dx) + abs(dy) == 1: # Manhattan distance of 1 means adjacent\n                # Determine the direction required to face (px, py) from (x, y)\n                required_d = -1\n                if dx == 0 and dy == -1: required_d = 0 # Primitive North, need to face North\n                elif dx == 1 and dy == 0: required_d = 1 # Primitive East, need to face East\n                elif dx == 0 and dy == 1: required_d = 2 # Primitive South, need to face South\n                elif dx == -1 and dy == 0: required_d = 3 # Primitive West, need to face West\n\n                if current_d == required_d:\n                    # Found a path where agent is adjacent to the primitive and facing it correctly\n                    return path + [A_USE]\n\n        # Explore possible next states by taking movement actions\n        for action, (mdx, mdy, new_dir_after_move) in MOVE_MAPPING.items():\n            nx, ny = x + mdx, y + mdy\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n                continue\n\n            # Check if the new position (nx, ny) is blocked by a non-grabbable item\n            # The agent cannot walk onto cells containing non-grabbable items.\n            is_blocked = False\n            if non_grabbable_indices_list:\n                # Check if any non-grabbable item is present at (nx, ny)\n                if np.any(current_grid[nx, ny, non_grabbable_indices_list] > 0):\n                    is_blocked = True\n            \n            if is_blocked:\n                continue\n\n            # If the new state (position and direction) has not been visited, add it to the queue\n            new_state = ((nx, ny), new_dir_after_move)\n            if new_state not in visited:\n                visited.add(new_state)\n                queue.append((new_state[0], new_state[1], path + [action]))\n\n    # If the BFS completes and no path is found to collect the primitive, return an empty list\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:10:51.947072", "function_name": "collect", "function_body": "  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dx == 0 and dy == 1: return SOUTH_DIR\n    if dx == 0 and dy == -1: return NORTH_DIR\n    return None # Should not happen if agent_pos and item_pos are cardinally adjacent\n\n  # Helper function: Checks if a cell is traversable (no non-grabbable items)\n  def _is_traversable(grid, x, y, non_grabbable_indices, grid_width, grid_height):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item (obstacle) is at (x, y)\n    for k_idx in non_grabbable_indices:\n      if grid[y, x, k_idx] == 1:\n        return False\n    return True\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Get non-grabbable indices for traversability check\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Prepare BFS goal states: ((agent_adj_x, agent_adj_y, agent_facing_dir), (primitive_x, primitive_y))\n  # A BFS goal state is a (position, direction) from which the primitive can be 'USE'd.\n  bfs_goal_states = []\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells for the agent to stand on\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (dx_adj, dy_adj) from item to agent\n      adj_x, adj_y = item_x + dx_adj, item_y + dy_adj\n\n      if _is_traversable(grid, adj_x, adj_y, non_grabbable_indices, grid_width, grid_height):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_goal_states.append(((adj_x, adj_y, required_dir), (item_x, item_y)))\n  \n  if not bfs_goal_states:\n    return [] # No traversable adjacent positions to any primitive instance\n\n  # BFS: (current_x, current_y, current_dir, list_of_actions_to_reach_here)\n  # Using a list as queue (pop(0) for BFS) - Note: pop(0) on list is O(N), but 'collections.deque' is not allowed.\n  queue = [(initial_agent_x, initial_agent_y, initial_agent_dir, [])]\n  # Visited set: (x, y, dir) to avoid cycles and redundant exploration\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Action definitions for BFS exploration:\n  # Assuming movement actions (UP, DOWN, LEFT, RIGHT) move the agent one step\n  # but DO NOT change its facing direction.\n  # LEFT_ACTION and RIGHT_ACTION can also be used as pure turn actions without movement.\n  movement_deltas = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n  \n  found_path_actions = None # Will store the shortest sequence of actions\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_so_far = queue.pop(0)\n\n    # Check if the current state is one of the goal states\n    for (goal_x, goal_y, goal_dir), _ in bfs_goal_states:\n      if (curr_x, curr_y, curr_dir) == (goal_x, goal_y, goal_dir):\n        found_path_actions = path_so_far\n        break # Found the shortest path to a goal\n    if found_path_actions is not None:\n      break # Exit BFS as soon as the shortest path is found\n\n    # Explore neighbors through movement actions (agent's direction doesn't change)\n    for action, (dx, dy) in movement_deltas.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = curr_dir # Direction remains the same after movement\n\n      if _is_traversable(grid, next_x, next_y, non_grabbable_indices, grid_width, grid_height):\n        if (next_x, next_y, next_dir) not in visited:\n          visited.add((next_x, next_y, next_dir))\n          queue.append((next_x, next_y, next_dir, path_so_far + [action]))\n    \n    # Explore neighbors through turning actions (position doesn't change)\n    # Based on collect_v1, LEFT_ACTION and RIGHT_ACTION can also be used for turning in place.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      next_x, next_y = curr_x, curr_y # Position does not change for a pure turn\n      \n      # Calculate new direction based on the turn action\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise (NORTH=0, WEST=3, SOUTH=2, EAST=1)\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4 # Turn clockwise\n      \n      if (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_so_far + [turn_action]))\n\n  if found_path_actions is None:\n    return [] # No path found to any primitive's collection point\n\n  # Final step: append the USE action after reaching the correct position and facing direction.\n  # The BFS path already ensures the agent is at the correct adjacent cell and facing the primitive.\n  final_actions = list(found_path_actions) # Make a copy to avoid modifying the list from queue\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:10:52.936369", "function_name": "collect", "function_body": "  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 0 and dy == 0:\n      return None\n\n    # Determine primary axis movement (horizontal or vertical) for facing\n    if abs(dx) >= abs(dy): # Prioritize horizontal if magnitude is greater or equal\n      return EAST_DIR if dx > 0 else WEST_DIR\n    else: # abs(dy) > abs(dx)\n      return SOUTH_DIR if dy > 0 else NORTH_DIR\n\n  # Helper function: Returns actions to turn from current_dir to target_dir.\n  # Assumes LEFT_ACTION and RIGHT_ACTION are used for turning.\n  def _get_turn_actions(current_dir, target_dir):\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION) # Turn right\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION) # Turn left\n    return actions\n\n  primitive_id = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n  agent_grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir # Agent's initial facing direction\n\n  grid_height, grid_width, _ = agent_grid.shape\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(agent_grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Step 1: Identify all potential collection points.\n  # These are cells from which the agent can be adjacent to *any* instance of the primitive\n  # and perform a USE action.\n  primitive_locations = set()\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n  \n  potential_collection_points = set()\n  # Define deltas for checking cardinal adjacency\n  ADJACENCY_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n\n  for px, py in primitive_locations:\n    for dx, dy in ADJACENCY_DELTAS:\n      adj_x, adj_y = px + dx, py + dy\n      if 0 <= adj_x < grid_width and 0 <= adj_y < grid_height:\n        # A cell is a potential collection point if it's within bounds AND\n        # it's not occupied by the primitive itself (agent cannot move onto the item it wants to collect).\n        # Assuming all other cells are traversable unless explicitly defined as obstacles.\n        if agent_grid[adj_y, adj_x, primitive_id] != 1:\n            potential_collection_points.add((adj_x, adj_y))\n  \n  if not potential_collection_points:\n      return [] # No valid collection points (e.g., item might be completely surrounded by other items or walls)\n\n  # Step 2: BFS Pathfinding to *any* of the potential_collection_points.\n  # The BFS finds the shortest path.\n  queue = [(agent_pos_x, agent_pos_y, [])]\n  visited = set([(agent_pos_x, agent_pos_y)])\n  \n  path_to_adj_pos = []\n  chosen_adj_pos = None # The specific adjacent position the agent will move to\n  target_item_pos_for_facing = None # The specific primitive instance to face\n\n  # Define movement deltas for BFS. These actions move the agent cardinally.\n  # They do NOT change the agent's facing direction.\n  ACTION_MOVES = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0),\n  }\n\n  while queue:\n    curr_x, curr_y, current_path = queue.pop(0)\n\n    # Check if the current position is one of the potential collection points\n    if (curr_x, curr_y) in potential_collection_points:\n      path_to_adj_pos = current_path\n      chosen_adj_pos = (curr_x, curr_y)\n      \n      # Now, identify *which* primitive instance this chosen_adj_pos is adjacent to.\n      # Any adjacent primitive will do for the USE action, so pick the first one found.\n      for dx, dy in ADJACENCY_DELTAS:\n          item_x, item_y = curr_x + dx, curr_y + dy\n          if 0 <= item_x < grid_width and 0 <= item_y < grid_height and \\\n             agent_grid[item_y, item_x, primitive_id] == 1:\n              target_item_pos_for_facing = (item_x, item_y)\n              break # Found the target item for facing\n      break # Path found to a valid collection point, exit BFS\n\n    # Explore possible moves from current position\n    for action, (dx, dy) in ACTION_MOVES.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check boundary conditions and if the cell has not been visited yet\n      if 0 <= next_x < grid_width and 0 <= next_y < grid_height and \\\n         (next_x, next_y) not in visited:\n        \n        # Ensure the next cell is traversable for movement.\n        # Here, we assume a cell is traversable if it doesn't contain the primitive itself.\n        # Additional checks for other obstacles (e.g., water, workshop) could be added if needed,\n        # but the problem description doesn't explicitly define them as movement blockers.\n        if agent_grid[next_y, next_x, primitive_id] != 1:\n            visited.add((next_x, next_y))\n            queue.append((next_x, next_y, current_path + [action]))\n\n  # If no path was found to any collection point (queue exhausted before finding a target)\n  if chosen_adj_pos is None:\n    return []\n\n  final_actions = list(path_to_adj_pos)\n\n  # After moving to the chosen_adj_pos, determine the direction the agent needs to face\n  # the primitive and add the necessary turning actions.\n  # The agent's `dir` (initial direction) is used as `current_dir` because the movement actions\n  # (UP, DOWN, LEFT, RIGHT) do not change the agent's facing direction.\n  if target_item_pos_for_facing is not None:\n    target_face_dir = _get_target_facing_direction(chosen_adj_pos[0], chosen_adj_pos[1], \n                                                   target_item_pos_for_facing[0], target_item_pos_for_facing[1])\n    if target_face_dir is not None:\n      final_actions.extend(_get_turn_actions(agent_dir, target_face_dir))\n  \n  # Finally, add the USE action to collect the primitive\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:12:46.837156", "function_name": "collect", "function_body": "    \"\"\"Improved version of `collect_v1`. Finds a path to collect the primitive using BFS.\n\n    This function attempts to find the shortest sequence of actions (movement and turns)\n    to reach a position from which the agent can successfully 'USE' the given primitive,\n    thereby collecting it into the inventory. It uses a Breadth-First Search (BFS)\n    on the state space (row, column, direction) to find the optimal path.\n    \"\"\"\n    \n    # 1. Get initial state information and environment constants\n    current_state = env._current_state # Access the CraftState object\n    initial_r, initial_c = current_state.pos\n    initial_dir = current_state.dir\n    grid = current_state.grid\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n\n    # Get integer action mappings from the environment\n    action_map = env.action_specs()\n    UP_ACTION = action_map['UP']\n    DOWN_ACTION = action_map['DOWN']\n    LEFT_ACTION = action_map['LEFT']\n    RIGHT_ACTION = action_map['RIGHT']\n    USE_ACTION = action_map['USE']\n\n    # Define direction deltas for (UP, RIGHT, DOWN, LEFT) corresponding to dir=0,1,2,3\n    # This maps agent's direction to the (dr, dc) vector it faces\n    dir_deltas = {\n        0: (-1, 0),  # UP (North: row decreases)\n        1: (0, 1),   # RIGHT (East: col increases)\n        2: (1, 0),   # DOWN (South: row increases)\n        3: (0, -1)   # LEFT (West: col decreases)\n    }\n    # Reverse mapping: (dr, dc) vector to the direction index\n    delta_to_dir = {v: k for k, v in dir_deltas.items()}\n\n    # Define movement actions and their effect on (dr, dc, new_dir)\n    # The new_dir is the agent's facing direction after the move.\n    move_actions_with_effects = {\n        UP_ACTION: (-1, 0, 0),\n        DOWN_ACTION: (1, 0, 2),\n        LEFT_ACTION: (0, -1, 3),\n        RIGHT_ACTION: (0, 1, 1),\n    }\n\n    # Get indices of entities that block agent movement\n    # These are typically environment items that cannot be walked through.\n    non_walkable_indices = env.world.non_grabbable_indices\n\n    # Check if the primitive itself is grabbable. If not, it cannot be collected via USE.\n    if primitive not in env.world.grabbable_indices:\n        return []\n\n    # 2. Find all grid locations where the primitive is present\n    primitive_locations = []\n    for r in range(WIDTH):\n        for c in range(HEIGHT):\n            if grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        return [] # Primitive not found anywhere on the grid\n\n    # 3. Pre-calculate all target (r, c, dir) states from which 'USE' action would collect the primitive.\n    # A target state for BFS is (agent_r, agent_c, agent_dir) such that:\n    # a) (agent_r, agent_c) is adjacent to a primitive location (pr, pc).\n    # b) The agent at (agent_r, agent_c) facing agent_dir looks directly at (pr, pc).\n    # c) (agent_r, agent_c) is a walkable cell for the agent.\n    use_targets = set()\n    for pr, pc in primitive_locations:\n        # Check all 4 adjacent cells around the primitive for potential agent positions\n        for dr_adj, dc_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Neighbors: N, S, W, E\n            agent_r, agent_c = pr + dr_adj, pc + dc_adj\n\n            # Ensure potential agent position is within grid boundaries\n            if not (0 <= agent_r < WIDTH and 0 <= agent_c < HEIGHT):\n                continue\n\n            # Check if this potential agent position is blocked by an obstacle\n            is_blocked = False\n            for obstacle_idx in non_walkable_indices:\n                if grid[agent_r, agent_c, obstacle_idx] > 0:\n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue\n            \n            # Calculate the vector from the agent's position to the primitive's position\n            vector_agent_to_primitive = (pr - agent_r, pc - agent_c)\n            \n            # The agent's facing direction must match this vector to 'USE' the primitive\n            if vector_agent_to_primitive in delta_to_dir:\n                agent_dir_to_face = delta_to_dir[vector_agent_to_primitive]\n                use_targets.add((agent_r, agent_c, agent_dir_to_face))\n    \n    if not use_targets:\n        return [] # No reachable position from which to use the primitive\n\n    # 4. Perform BFS to find the shortest path to any 'use_target' state\n    queue = collections.deque()\n    visited = set() # Stores (row, col, direction) to avoid redundant exploration\n\n    # Initial state for BFS: (current_row, current_col, current_direction, list_of_actions_so_far)\n    start_node = (initial_r, initial_c, initial_dir, [])\n    queue.append(start_node)\n    visited.add((initial_r, initial_c, initial_dir))\n\n    while queue:\n        r, c, current_dir, path_so_far = queue.popleft()\n\n        # If the current state (position and direction) matches one of our 'use_targets',\n        # we have found a path. Append the 'USE' action and return the full path.\n        if (r, c, current_dir) in use_targets:\n            return path_so_far + [USE_ACTION]\n\n        # Explore possible movement actions (UP, DOWN, LEFT, RIGHT)\n        for action, (dr, dc, new_dir) in move_actions_with_effects.items():\n            nr, nc = r + dr, c + dc # Calculate new position\n\n            # Check if new position is within grid boundaries\n            if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n                continue\n\n            # Check if the new position is blocked by any non-walkable obstacle\n            is_blocked = False\n            for obstacle_idx in non_walkable_indices:\n                if grid[nr, nc, obstacle_idx] > 0:\n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue\n\n            # If the new state (position and direction) has not been visited, add it to the queue\n            new_state_tuple = (nr, nc, new_dir)\n            if new_state_tuple not in visited:\n                visited.add(new_state_tuple)\n                queue.append((nr, nc, new_dir, path_so_far + [action]))\n        \n        # Explore turning actions (LEFT, RIGHT) without changing position\n        # These are important as the agent can change direction while standing still.\n        \n        # Turn Right\n        next_dir_right = (current_dir + 1) % 4\n        if (r, c, next_dir_right) not in visited:\n            visited.add((r, c, next_dir_right))\n            queue.append((r, c, next_dir_right, path_so_far + [RIGHT_ACTION]))\n\n        # Turn Left\n        next_dir_left = (current_dir - 1 + 4) % 4 # Ensure positive modulo result\n        if (r, c, next_dir_left) not in visited:\n            visited.add((r, c, next_dir_left))\n            queue.append((r, c, next_dir_left, path_so_far + [LEFT_ACTION]))\n\n    # If the queue becomes empty and no target state was reached, no path exists\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:12:47.846374", "function_name": "collect", "function_body": "  import collections\n  import numpy as np # numpy is already imported at module level as np\n\n  # Helper function to check if the primitive is in the 3x3 neighborhood of (r, c)\n  def is_adjacent_to_primitive(grid, r, c, primitive_idx):\n      # grid.shape is (WIDTH, HEIGHT, n_kinds)\n      width, height, _ = grid.shape\n      \n      # Check 3x3 neighborhood around (r,c) (current position included)\n      for dr in [-1, 0, 1]:  # change in row\n          for dc in [-1, 0, 1]:  # change in col\n              nr, nc = r + dr, c + dc\n              \n              # Ensure the neighbor is within grid bounds\n              # nr is row (0 to height-1), nc is col (0 to width-1)\n              if 0 <= nr < height and 0 <= nc < width:\n                  # Access grid using (col_idx, row_idx, kind_idx)\n                  if grid[nc, nr, primitive_idx] > 0:\n                      return True\n      return False\n\n  # Helper function to check if a cell (r, c) is traversable\n  def is_traversable(grid, r, c, world_ref, primitive_idx):\n      # grid.shape is (WIDTH, HEIGHT, n_kinds)\n      width, height, n_kinds = grid.shape\n      \n      # Iterate through all kinds in the cell (r, c)\n      for k_idx in range(n_kinds):\n          # Access grid using (col_idx, row_idx, kind_idx)\n          if grid[c, r, k_idx] > 0:  # if something exists at this (col, row) location for this kind\n              # A cell is considered blocked if it contains a non-grabbable item\n              # that is NOT the primitive we are trying to collect.\n              if k_idx in world_ref.non_grabbable_indices and k_idx != primitive_idx:\n                  return False\n      return True\n\n  # Define action constants from the environment's action_specs\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Get current observations from the environment\n  obs = env.observations()\n\n  # 1. Check if the primitive is already in inventory\n  if obs['features_dict']['inventory'][primitive] > 0:\n    return [] # Already collected, no actions needed\n\n  # Get current grid and agent position from observations\n  # The grid is a numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds)\n  grid = obs['features_dict']['features_global']\n  width, height, n_kinds = grid.shape\n\n  # Convert normalized position (x, y) from features_dict to integer grid coordinates (row, col)\n  # obs['features_dict']['pos'] is (normalized_x, normalized_y)\n  # normalized_x maps to column (0 to width-1)\n  # normalized_y maps to row (0 to height-1)\n  agent_col = int(round(obs['features_dict']['pos'][0] * (width - 1)))\n  agent_row = int(round(obs['features_dict']['pos'][1] * (height - 1)))\n  start_pos = (agent_row, agent_col) # Store as (row, col)\n\n  # 2. Check if the primitive is immediately adjacent (within 3x3) from the starting position\n  if is_adjacent_to_primitive(grid, start_pos[0], start_pos[1], primitive):\n      return [USE] # Primitive is immediately reachable, just use it.\n\n  # 3. Perform a Breadth-First Search (BFS) to find the shortest path to a cell adjacent to the primitive\n  q = collections.deque([(start_pos, [])]) # Queue stores (current_pos (row, col), path_so_far)\n  visited = {start_pos} # Set of visited (row, col) positions\n\n  # Define action deltas for (dr, dc) based on (row, col) movements\n  # (row, col) where row changes with UP/DOWN, col changes with LEFT/RIGHT\n  action_deltas = {\n      UP: (-1, 0),    # Move up: decrease row index\n      DOWN: (1, 0),   # Move down: increase row index\n      LEFT: (0, -1),  # Move left: decrease col index\n      RIGHT: (0, 1)   # Move right: increase col index\n  }\n\n  target_path = None # Will store the path to the target position\n\n  while q:\n      current_pos, path_so_far = q.popleft()\n      current_r, current_c = current_pos\n\n      # Explore all possible movements from the current position\n      for action, (dr, dc) in action_deltas.items():\n          next_r, next_c = current_r + dr, current_c + dc\n          next_pos = (next_r, next_c)\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= next_r < height and 0 <= next_c < width):\n              continue\n\n          # Check if the next position has already been visited\n          if next_pos in visited:\n              continue\n\n          # Check if the next position is traversable (not blocked by non-grabbable items)\n          # env.world is a reference to the CraftWorld instance, providing non_grabbable_indices\n          if not is_traversable(grid, next_r, next_c, env.world, primitive):\n              continue\n\n          # Mark the new position as visited and add it to the queue\n          visited.add(next_pos)\n          new_path = path_so_far + [action]\n          \n          # Check if this new position is adjacent to the primitive\n          if is_adjacent_to_primitive(grid, next_r, next_c, primitive):\n              target_path = new_path + [USE] # Path to the adjacent cell, then USE\n              break # Found the shortest path, exit inner loop\n          \n          q.append((next_pos, new_path)) # Add to queue for further exploration\n      \n      if target_path: # If a path was found in the inner loop, exit the outer BFS loop\n          break\n\n  # Return the found path (followed by a USE action) or an empty list if no path was found\n  return target_path if target_path else []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:13:33.574410", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Action constants, consistent with CraftLab/CraftWorld actions\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Defines the change in (x, y) coordinates for each movement action\n  MOVES = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # 1. Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global'] # The full grid layout\n  # Agent's current position (x, y) as an integer tuple\n  agent_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  world = env.world\n  # Indices of entities that cannot be walked through (e.g., walls, water)\n  non_grabbable_entity_indices = world.non_grabbable_indices\n  \n  grid_width, grid_height, num_kinds = grid.shape\n\n  # 2. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable obstacle.\n  \n  # Create a boolean mask where True indicates an entity kind is a non-grabbable obstacle.\n  is_obstacle_kind_mask = np.isin(np.arange(num_kinds), list(non_grabbable_entity_indices))\n  \n  # For each cell (x, y), check if any non-grabbable obstacle kind is present.\n  # This results in a (grid_width, grid_height) boolean array where True means an obstacle is present.\n  cell_has_obstacle = (grid[:, :, is_obstacle_kind_mask] > 0).any(axis=-1)\n  \n  # A cell is traversable if it does NOT contain any obstacles.\n  is_traversable = ~cell_has_obstacle\n  \n  # If the agent starts on an untraversable cell, no path can be found.\n  if not is_traversable[agent_pos[0], agent_pos[1]]:\n      return []\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples: (current_position, list_of_actions_taken_to_reach_here)\n  q = deque([(agent_pos, [])]) \n  # Set to keep track of grid positions that have already been visited by BFS\n  visited_positions = {agent_pos} \n  \n  path_to_primitive_found = [] # This will store the sequence of actions if a path is successfully found.\n\n  while q:\n      (current_x, current_y), actions_taken = q.popleft()\n\n      # Check if the current cell contains the target primitive.\n      if grid[current_x, current_y, primitive] > 0:\n          path_to_primitive_found = actions_taken\n          break # Shortest path found, terminate BFS.\n\n      # Explore all four cardinal neighbors (Up, Down, Left, Right)\n      for action_move, (dx, dy) in MOVES.items():\n          next_x, next_y = current_x + dx, current_y + dy\n          next_pos = (next_x, next_y)\n\n          # Check if the next position is within the grid boundaries\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Check if the next position is traversable (i.e., not an obstacle)\n          if not is_traversable[next_x, next_y]:\n              continue\n          \n          # Check if the next position has already been visited to avoid cycles and redundant paths\n          if next_pos in visited_positions:\n              continue\n              \n          # If all checks pass, add the next position to the queue and mark as visited.\n          visited_positions.add(next_pos)\n          q.append((next_pos, actions_taken + [action_move]))\n  \n  # 4. Construct the final sequence of actions.\n  # If `path_to_primitive_found` is empty after the BFS loop, it means:\n  #   a) The agent is already on the square containing the primitive (no movement needed).\n  #   b) The primitive is genuinely unreachable (e.g., blocked by obstacles, or not present on the map).\n  \n  # Check for case (b): if no path was found AND the agent is NOT already on the primitive,\n  # then the primitive is unreachable, so return an empty action list.\n  if not path_to_primitive_found and not (grid[agent_pos[0], agent_pos[1], primitive] > 0):\n      return [] \n\n  # The final actions consist of the movement path followed by a USE action to collect the primitive.\n  final_actions = []\n  final_actions.extend(path_to_primitive_found) # Add movement actions (could be empty if already on target)\n  final_actions.append(USE) # Add the action to pick up/use the item\n  \n  return final_actions", "island_id": 9, "scores": {"3": 0.0}}
