{"timestamp": "2025-07-30T19:27:48.519136", "function_name": "collect", "function_body": "  # Action constants for clarity\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction vectors for movement (row, col delta)\n  # Assuming (0,0) is top-left, increasing row is DOWN, increasing col is RIGHT\n  MOVE_DELTAS = {\n      ACTION_UP: (-1, 0),\n      ACTION_DOWN: (1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1),\n  }\n\n  # Mapping of (dr, dc) to action for path reconstruction\n  DELTA_TO_ACTION = {\n      (-1, 0): ACTION_UP,\n      (1, 0): ACTION_DOWN,\n      (0, -1): ACTION_LEFT,\n      (0, 1): ACTION_RIGHT,\n  }\n\n  # Get current state information from the environment's observations\n  observations = env.observations()\n  state_dict = observations['features_dict']\n  \n  grid = state_dict['features_global']\n  grid_height, grid_width, n_kinds = grid.shape\n  \n  # Convert normalized position from features_dict to grid integer coordinates\n  # Assuming normalized values are in [0, 1) range and map directly to grid indices\n  current_pos_normalized = state_dict['pos']\n  current_pos = (int(current_pos_normalized[0] * grid_height),\n                 int(current_pos_normalized[1] * grid_width))\n  \n  current_inventory = state_dict['inventory']\n\n  # 1. Check if the primitive is already in the inventory\n  if current_inventory[primitive] > 0:\n    return [] # Primitive is already collected, no actions needed.\n\n  # Get information about impassable entities from the CraftWorld instance\n  world = env.world # env is CraftLab, env.world is CraftWorld\n  impassable_indices = set()\n  \n  # For collect_v2, we consider 'water' and 'stone' as impassable obstacles,\n  # unless the primitive itself is water or stone (in which case, it's the target).\n  if hasattr(world, 'water_index') and world.water_index != primitive:\n      impassable_indices.add(world.water_index)\n  if hasattr(world, 'stone_index') and world.stone_index != primitive:\n      impassable_indices.add(world.stone_index)\n  \n  # Helper function to check if a cell is valid to move into\n  def is_valid_cell(r, c):\n    # Check grid boundaries\n    if not (0 <= r < grid_height and 0 <= c < grid_width):\n      return False\n    \n    # Check if the cell contains any impassable items\n    # A cell is considered impassable if any of the predefined impassable_indices\n    # are present at that location in the grid.\n    for idx in impassable_indices:\n      if idx < n_kinds and grid[r, c, idx] > 0: # Ensure index is valid and item is present\n        return False\n    return True\n\n  # 2. Find all locations of the primitive on the grid\n  primitive_locations = []\n  for r in range(grid_height):\n    for c in range(grid_width):\n      # If the cell contains the target primitive\n      if grid[r, c, primitive] > 0:\n        primitive_locations.append((r, c))\n\n  # If the primitive is not found anywhere on the map, it cannot be collected\n  if not primitive_locations:\n    return []\n\n  # 3. Perform a Breadth-First Search (BFS) to find the shortest path\n  # to a cell adjacent to the primitive.\n  # Using a list as a queue (q.pop(0)) since `collections.deque` import is disallowed.\n  q = [(current_pos, [])] # Each element is (current_position, list_of_actions_to_reach_here)\n  visited = {current_pos} # Set of visited positions to avoid cycles and redundant paths\n  \n  head = 0 # Manual pointer for the front of the queue\n\n  while head < len(q):\n    current_node, current_path_actions = q[head]\n    head += 1\n    \n    # Check if the current_node is adjacent (4-directional) to any primitive location\n    for prim_r, prim_c in primitive_locations:\n      if (abs(current_node[0] - prim_r) == 1 and current_node[1] == prim_c) or \\\n         (current_node[0] == prim_r and abs(current_node[1] - prim_c) == 1):\n        # Found a path to an adjacent cell. Append the USE action and return.\n        # BFS guarantees this is the shortest path.\n        return current_path_actions + [ACTION_USE]\n\n    # Explore valid neighboring cells\n    for action, (dr, dc) in MOVE_DELTAS.items():\n      next_r, next_c = current_node[0] + dr, current_node[1] + dc\n      next_node = (next_r, next_c)\n\n      if is_valid_cell(next_r, next_c) and next_node not in visited:\n        visited.add(next_node)\n        q.append((next_node, current_path_actions + [action]))\n\n  # If the BFS completes and no path to an adjacent primitive is found\n  return [] # The primitive is unreachable", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:28:47.488029", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      ACTION_UP: DIR_NORTH,\n      ACTION_DOWN: DIR_SOUTH,\n      ACTION_LEFT: DIR_WEST,\n      ACTION_RIGHT: DIR_EAST\n  }\n\n  # Mapping of target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction to collect that target via ACTION_USE.\n  # This focuses on cardinal directions, as ACTION_USE typically applies to what's directly in front.\n  RELATIVE_TO_REQUIRED_DIR = {\n      (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n      (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n      (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n      (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_cell_in_front(pos, direction):\n      y, x = pos\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return None # Should not happen with valid directions\n\n  # Breadth-First Search (BFS) to find a path to the primitive, ensuring the agent\n  # ends up at a position AND orientation suitable for collection.\n  def _find_path_and_orientation_for_collection(start_pos, start_dir, full_grid, primitive_id, world, max_steps):\n      grid_height, grid_width, _ = full_grid.shape\n      \n      # Determine truly impassable kinds for agent movement\n      impassable_for_movement = set()\n      if world.water_index in world.kinds: # Water is usually impassable\n          impassable_for_movement.add(world.water_index)\n      \n      # Other non-grabbable items are impassable, UNLESS they are workshops (which are traversable)\n      for k_idx in world.non_grabbable_indices:\n          if k_idx not in world.workshop_indices:\n              impassable_for_movement.add(k_idx)\n\n      # A primitive is \"traversable\" if the agent can stand on its cell (i.e., it's not impassable itself)\n      primitive_is_traversable = primitive_id not in impassable_for_movement\n\n      # BFS state: (current_y, current_x, current_dir, path_of_actions)\n      q = collections.deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n      # These moves are cardinal and also determine the new facing direction.\n      moves_options = [\n          (-1, 0, ACTION_UP, DIR_NORTH),\n          (1, 0, ACTION_DOWN, DIR_SOUTH),\n          (0, -1, ACTION_LEFT, DIR_WEST),\n          (0, 1, ACTION_RIGHT, DIR_EAST)\n      ]\n\n      while q:\n          curr_y, curr_x, curr_dir, path_actions = q.popleft()\n          \n          # Check for path length limit (reserving at least 1 step for ACTION_USE)\n          if len(path_actions) >= max_steps - 1:\n              continue # Skip expanding paths that are already too long\n\n          # --- Goal Check 1: Primitive is on the current cell and agent can pick it up directly ---\n          if primitive_is_traversable and full_grid[curr_y, curr_x, primitive_id] > 0:\n              # If agent can move onto the primitive and it's present, this is a direct collection point.\n              # Relative coordinates (0,0) indicates target is at agent's current position.\n              return (path_actions, (0, 0)) \n\n          # --- Goal Check 2: Primitive is cardinally adjacent AND agent is facing it correctly ---\n          for rel_dy, rel_dx in RELATIVE_TO_REQUIRED_DIR.keys(): \n              adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n              # Check bounds for the adjacent cell\n              if not (0 <= adj_y < grid_height and 0 <= adj_x < grid_width):\n                  continue\n\n              # Check if the adjacent cell contains the primitive\n              if full_grid[adj_y, adj_x, primitive_id] > 0:\n                  # Primitive found at (adj_y, adj_x). Now, verify agent's orientation.\n                  required_dir_for_collection = RELATIVE_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n                  if curr_dir == required_dir_for_collection:\n                      # Found a path that leads to a position AND ensures the agent is oriented correctly.\n                      return (path_actions, (rel_dy, rel_dx))\n\n          # --- Explore neighboring cells for movement ---\n          for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n              # Check bounds for the next movement cell\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if the next cell is traversable (i.e., does not contain any impassable kinds)\n              is_traversable_for_movement = True\n              for k_idx in impassable_for_movement:\n                  if full_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable_for_movement = False\n                      break\n              if not is_traversable_for_movement:\n                  continue\n              \n              # Add to queue only if this new state (position and direction) hasn't been visited\n              if (next_y, next_x, new_dir_after_move) not in visited:\n                  visited.add((next_y, next_x, new_dir_after_move))\n                  q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n      return (None, None) # No path found to the primitive with correct orientation\n\n\n  actions_taken = []\n  \n  # DO NOT reset the environment. Operate on the current state.\n  current_state = env._current_state \n\n  # Initial checks for early exit\n  if primitive not in current_state.world.cookbook.kinds:\n      # The specified primitive ID is not a recognized kind in the world.\n      return [] \n  if current_state.inventory[primitive] > 0:\n      # The primitive has already been collected or is present in inventory.\n      return [] \n\n  full_grid = current_state.features_dict()['features_global']\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  \n  # Find the sequence of movements and the relative target coordinates for collection.\n  path_of_moves, relative_target_coords = _find_path_and_orientation_for_collection(\n      start_pos, start_dir, full_grid, primitive, current_state.world, MAX_COLLECT_STEPS\n  )\n\n  if path_of_moves is None:\n      # No valid path was found to reach a position/orientation suitable for collection.\n      return [] \n\n  # Execute the found path of movements\n  for action in path_of_moves:\n      actions_taken.append(action)\n      # Step the environment with the current action.\n      # We ignore reward and done status for this function's goal, but update state.\n      _, done, _ = env.step(action) \n      current_state = env._current_state # Always update the internal state after a step\n\n      # If the episode ends prematurely before collecting, return empty.\n      if done and current_state.inventory[primitive] <= 0:\n          return []\n\n\n  # After executing all movement actions, the agent should be at the correct position\n  # and facing the correct direction as determined by the BFS. Now, perform the USE action.\n  \n  # Before attempting USE, verify the primitive is still at the expected location.\n  # This makes the solution more robust to potential dynamic environment changes (though\n  # CraftWorld's grid is static during these steps).\n  grid_height, grid_width, _ = full_grid.shape \n  is_primitive_reachable_by_use = False\n\n  if relative_target_coords == (0,0):\n      # Target is on the current cell (agent is standing on it)\n      if (0 <= current_state.pos[0] < grid_height and\n          0 <= current_state.pos[1] < grid_width and\n          current_state.grid[current_state.pos[0], current_state.pos[1], primitive] > 0):\n          is_primitive_reachable_by_use = True\n  else:\n      # Target is adjacent to the current cell, in the direction agent is facing.\n      target_cell_y, target_cell_x = _get_cell_in_front(current_state.pos, current_state.dir)\n      if (target_cell_y is not None and\n          0 <= target_cell_y < grid_height and 0 <= target_cell_x < grid_width and\n          current_state.grid[target_cell_y, target_cell_x, primitive] > 0):\n          is_primitive_reachable_by_use = True\n\n  if is_primitive_reachable_by_use:\n      # If the primitive is still present and reachable, append and execute the ACTION_USE.\n      if len(actions_taken) < MAX_COLLECT_STEPS: # Ensure there's still capacity for the USE action\n          actions_taken.append(ACTION_USE)\n          _, done, _ = env.step(ACTION_USE)\n          current_state = env._current_state # Update state after USE\n\n          # Final verification: Confirm the primitive was successfully collected into inventory.\n          if current_state.inventory[primitive] > 0:\n              return actions_taken # Successfully collected!\n          elif done:\n              # Episode ended right after the USE action, and primitive not collected.\n              return []\n          else:\n              # Collection failed even after reaching and attempting USE, and episode didn't end.\n              # This could happen if a tool is needed, or the resource depleted, etc.\n              return [] \n      else:\n          # Max steps reached, no space left for the final USE action.\n          return [] \n  else:\n      # Discrepancy: BFS found a path, but primitive is not in the expected location for collection\n      # after executing the path. This indicates a stale plan or dynamic environment changes not\n      # accounted for in the initial static grid planning.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:28:48.492500", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction to collect that target via ACTION_USE.\n  # This focuses on cardinal directions, as ACTION_USE typically applies to what's directly in front.\n  RELATIVE_TO_REQUIRED_DIR = {\n      (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n      (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n      (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n      (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_cell_in_front(pos, direction):\n      y, x = pos\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return None # Should not happen with valid directions\n\n  # Breadth-First Search (BFS) to find a path to the primitive, ensuring the agent\n  # ends up at a position AND orientation suitable for collection.\n  def _find_path_and_orientation_for_collection(start_pos, start_dir, initial_grid, primitive_id, world, max_steps):\n      grid_height, grid_width, _ = initial_grid.shape\n      \n      # Define impassable kinds for movement: water and non-grabbables that are not workshops.\n      impassable_for_movement = set()\n      if world.water_index in world.kinds:\n          impassable_for_movement.add(world.water_index)\n      for k_idx in world.non_grabbable_indices:\n          if k_idx not in world.workshop_indices:\n              impassable_for_movement.add(k_idx)\n\n      # A primitive is \"traversable\" if it's not in the set of impassable kinds.\n      # Agent can stand on a traversable primitive to collect it.\n      primitive_is_traversable = primitive_id not in impassable_for_movement\n\n      # BFS state: (current_y, current_x, current_dir, path_of_actions)\n      q = collections.deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n      # These moves are cardinal and also determine the new facing direction.\n      # The resulting_direction_after_move assumes the agent faces the direction it moved.\n      moves_options = [\n          (-1, 0, ACTION_UP, DIR_NORTH),\n          (1, 0, ACTION_DOWN, DIR_SOUTH),\n          (0, -1, ACTION_LEFT, DIR_WEST),\n          (0, 1, ACTION_RIGHT, DIR_EAST)\n      ]\n\n      while q:\n          curr_y, curr_x, curr_dir, path_actions = q.popleft()\n          \n          # Check for path length limit (reserving at least 1 step for ACTION_USE)\n          if len(path_actions) >= max_steps - 1:\n              continue # Skip expanding paths that are already too long\n\n          # --- Goal Check 1: Primitive is on the current cell and agent can pick it up directly ---\n          # This applies if the agent can traverse onto the primitive's cell.\n          if primitive_is_traversable and initial_grid[curr_y, curr_x, primitive_id] > 0:\n              # Found a path where the agent can stand on the primitive.\n              # The relative_target_coords (0,0) indicates the target is at the agent's current position.\n              return (path_actions, (0, 0)) \n\n          # --- Goal Check 2: Primitive is cardinally adjacent AND agent is facing it correctly ---\n          for rel_dy, rel_dx in RELATIVE_TO_REQUIRED_DIR.keys(): \n              adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n              # Check bounds for the adjacent cell\n              if not (0 <= adj_y < grid_height and 0 <= adj_x < grid_width):\n                  continue\n\n              # Check if the adjacent cell contains the primitive based on the initial grid\n              if initial_grid[adj_y, adj_x, primitive_id] > 0:\n                  # Primitive found at (adj_y, adj_x). Now, verify agent's orientation.\n                  required_dir_for_collection = RELATIVE_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n                  if curr_dir == required_dir_for_collection:\n                      # Found a path that leads to a position AND ensures the agent is oriented correctly.\n                      return (path_actions, (rel_dy, rel_dx))\n\n          # --- Explore neighboring cells for movement ---\n          for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n              # Check bounds for the next movement cell\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if the next cell is traversable (i.e., does not contain any impassable kinds)\n              is_traversable_for_movement = True\n              for k_idx in impassable_for_movement:\n                  if initial_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable_for_movement = False\n                      break\n              if not is_traversable_for_movement:\n                  continue\n              \n              # Add to queue only if this new state (position and direction) hasn't been visited\n              if (next_y, next_x, new_dir_after_move) not in visited:\n                  visited.add((next_y, next_x, new_dir_after_move))\n                  q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n      return (None, None) # No path found to the primitive with correct orientation\n\n\n  actions_taken = []\n  \n  # Access the current state of the environment. This function plans from the current state,\n  # rather than resetting the environment.\n  current_state = env._current_state \n\n  # Initial checks for early exit\n  if primitive not in current_state.world.cookbook.kinds:\n      # The specified primitive ID is not a recognized kind in the world.\n      return [] \n  if current_state.inventory[primitive] > 0:\n      # The primitive has already been collected or is present in inventory.\n      return [] \n\n  # Get the initial grid, position, and direction for path planning.\n  # The grid is assumed static during movement planning, but the final\n  # collection check will use the live grid.\n  initial_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = initial_grid.shape # Grid dimensions are constant\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  \n  # Find the sequence of movements and the relative target coordinates for collection.\n  path_of_moves, relative_target_coords = _find_path_and_orientation_for_collection(\n      start_pos, start_dir, initial_grid, primitive, current_state.world, MAX_COLLECT_STEPS\n  )\n\n  if path_of_moves is None:\n      # No valid path was found to reach a position/orientation suitable for collection.\n      return [] \n\n  # Execute the found path of movements\n  for action in path_of_moves:\n      actions_taken.append(action)\n      # Step the environment with the current action.\n      # We ignore reward and done status as this function's goal is just to return the action sequence.\n      _, _, _ = env.step(action) \n      current_state = env._current_state # Always update the internal state after a step\n\n      # If the primitive is unexpectedly collected mid-path (e.g., agent stepped onto it\n      # and it was auto-collected, or something unexpected happened), we are done.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n  # After executing all movement actions, the agent should be at the correct position\n  # and facing the correct direction as determined by the BFS. Now, perform the USE action.\n  \n  # Before attempting USE, verify the primitive is still at the expected location\n  # using the *current* grid state (current_state.grid). This handles cases where\n  # the grid might have dynamically changed after planning, though unlikely for static CraftWorld.\n  is_primitive_reachable_by_use = False\n\n  if relative_target_coords == (0,0):\n      # Target is on the current cell (agent is standing on it).\n      # Check the primitive's presence in the *current* grid at the agent's location.\n      if (0 <= current_state.pos[0] < grid_height and\n          0 <= current_state.pos[1] < grid_width and\n          current_state.grid[current_state.pos[0], current_state.pos[1], primitive] > 0):\n          is_primitive_reachable_by_use = True\n  else:\n      # Target is adjacent to the current cell, in the direction agent is facing.\n      # Check the primitive's presence in the *current* grid at the cell in front.\n      target_cell_y, target_cell_x = _get_cell_in_front(current_state.pos, current_state.dir)\n      if (target_cell_y is not None and\n          0 <= target_cell_y < grid_height and 0 <= target_cell_x < grid_width and\n          current_state.grid[target_cell_y, target_cell_x, primitive] > 0):\n          is_primitive_reachable_by_use = True\n\n  if is_primitive_reachable_by_use:\n      # If the primitive is still present and reachable, append and execute the ACTION_USE.\n      if len(actions_taken) < MAX_COLLECT_STEPS: # Ensure there's still capacity for the USE action\n          actions_taken.append(ACTION_USE)\n          _, _, _ = env.step(ACTION_USE)\n          current_state = env._current_state # Update state after USE\n\n          # Final verification: Confirm the primitive was successfully collected into inventory.\n          if current_state.inventory[primitive] > 0:\n              return actions_taken # Successfully collected!\n          else:\n              # Collection failed even after reaching and attempting USE (e.g., tool needed).\n              return [] \n      else:\n          # Max steps reached, no space left for the final USE action.\n          return [] \n  else:\n      # Discrepancy: BFS found a path, but primitive is not in the expected location for collection\n      # after executing the path. This indicates a stale plan or dynamic environment changes not\n      # accounted for in the initial static grid planning.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:29:40.085170", "function_name": "collect", "function_body": "  import collections\n\n  # Define constants for actions and directions\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0  # Agent facing UP (negative Y)\n  EAST_DIR = 1   # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2  # Agent facing DOWN (positive Y)\n  WEST_DIR = 3   # Agent facing LEFT (negative X)\n\n  # Mapping from movement action to (dx, dy) delta and resulting facing direction\n  ACTION_MOVE_INFO = {\n      UP_ACTION: (0, -1, NORTH_DIR),\n      DOWN_ACTION: (0, 1, SOUTH_DIR),\n      LEFT_ACTION: (-1, 0, WEST_DIR),\n      RIGHT_ACTION: (1, 0, EAST_DIR),\n  }\n\n  # Cardinal deltas for checking adjacent cells\n  ADJACENCY_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"\n    Calculates the direction the agent needs to face to look at an item.\n    Assumes the item is directly cardinally adjacent to the agent.\n    \"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dx == 0 and dy == 1: return SOUTH_DIR\n    if dx == 0 and dy == -1: return NORTH_DIR\n    return None # Item is not cardinally adjacent, or agent is on item\n\n  # Get target item's integer ID from the cookbook index\n  primitive_id = env.world.cookbook.index[primitive]\n\n  current_state = env._current_state\n\n  # Check if the primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  non_grabbable_indices = env.world.non_grabbable_indices\n  workshop_indices = env.world.workshop_indices\n\n  def _is_obstacle(x, y, current_grid, target_item_id):\n    \"\"\"\n    Checks if a grid cell (x, y) is an obstacle for agent movement.\n    A cell is considered an obstacle if:\n    1. It is out of grid bounds.\n    2. It contains any non-grabbable item (e.g., water, stone).\n    3. It contains a workshop (as workshops are typically not traversable).\n    4. It contains the `target_item_id` itself (as the agent needs to be adjacent, not on it, to collect/use).\n    \"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return True # Out of bounds is an obstacle\n\n    # Check for general non-grabbable items (e.g., water, stone)\n    for kind_idx in non_grabbable_indices:\n      if current_grid[y, x, kind_idx] > 0:\n        return True\n    \n    # Check for workshop locations, which are also typically non-traversable\n    for kind_idx in workshop_indices:\n      if current_grid[y, x, kind_idx] > 0:\n        return True\n\n    # If the cell contains the specific target item we are trying to interact with,\n    # it's considered an obstacle for movement, as interaction happens from an adjacent cell.\n    # The agent cannot move onto a cell occupied by the target item.\n    if current_grid[y, x, target_item_id] > 0:\n      return True\n\n    return False\n\n  # 1. Find all locations of the target item on the grid\n  item_y_coords, item_x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(item_x_coords) == 0:\n    return [] # Target item not found on the grid\n\n  # 2. Identify all target interaction points for BFS goal states.\n  # A target interaction point is (adjacent_x, adjacent_y, required_facing_direction_to_item).\n  # These are the states (position and direction) from which the agent can perform a USE action.\n  target_interaction_points = set()\n  for i in range(len(item_x_coords)):\n    item_x, item_y = item_x_coords[i], item_y_coords[i]\n    # Check all 4 cardinal neighbors of the item\n    for dx, dy in ADJACENCY_DELTAS:\n      adj_x, adj_y = item_x + dx, item_y + dy\n      \n      # A cell is a valid adjacent interaction point if it's not an obstacle for movement\n      # Note: We pass primitive_id as target_item_id to _is_obstacle, meaning agent cannot step ONTO the primitive.\n      if not _is_obstacle(adj_x, adj_y, grid, primitive_id):\n        \n        # Determine the direction the agent needs to face to use the item from this adjacent cell\n        required_facing_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_facing_dir is not None:\n          target_interaction_points.add((adj_x, adj_y, required_facing_dir))\n\n  if not target_interaction_points:\n    return [] # No reachable adjacent cells to any target item\n\n  # 3. Initialize BFS queue: stores (current_x, current_y, current_direction)\n  queue = collections.deque([(start_pos_x, start_pos_y, start_dir)])\n  \n  # 4. Initialize `parent_map` for path reconstruction:\n  # Maps (next_x, next_y, next_dir) to (curr_x, curr_y, curr_dir, action_taken_to_reach_next_state)\n  parent_map = {} \n  parent_map[(start_pos_x, start_pos_y, start_dir)] = None # The start state has no parent\n\n  # 5. Run BFS\n  goal_state_reached = None # Will store the (x, y, dir) of the goal state if found\n\n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state is a goal state (i.e., we are at a valid interaction point)\n    if (curr_x, curr_y, curr_dir) in target_interaction_points:\n      goal_state_reached = (curr_x, curr_y, curr_dir)\n      break # Path found, exit BFS\n\n    # --- Explore possible next states from current state ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for move_action, (dx, dy, new_dir_after_move) in ACTION_MOVE_INFO.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      \n      # Check if the next cell is traversable/walkable (not an obstacle)\n      if not _is_obstacle(next_x, next_y, grid, primitive_id):\n        \n        next_state = (next_x, next_y, new_dir_after_move)\n        # If this state has not been visited yet\n        if next_state not in parent_map: \n          parent_map[next_state] = (curr_x, curr_y, curr_dir, move_action)\n          queue.append(next_state)\n\n    # B. Turning Actions (LEFT, RIGHT)\n    # These actions change direction but not position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n\n      next_state = (curr_x, curr_y, next_dir)\n      # If this state has not been visited yet\n      if next_state not in parent_map: \n        parent_map[next_state] = (curr_x, curr_y, curr_dir, turn_action)\n        queue.append(next_state)\n\n  # 6. Reconstruct the path if a goal state was reached\n  if goal_state_reached is None:\n    return [] # No path found to any valid interaction point\n\n  path_actions = []\n  current = goal_state_reached\n  # Backtrack from the goal state to the start state using the parent_map\n  while parent_map[current] is not None: \n    parent_x, parent_y, parent_dir, action_to_get_here = parent_map[current]\n    path_actions.append(action_to_get_here)\n    current = (parent_x, parent_y, parent_dir)\n  \n  path_actions.reverse() # Actions were collected in reverse order, so reverse them\n\n  # Add the final USE action to interact with the target item\n  path_actions.append(USE_ACTION)\n\n  return path_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:29:41.108608", "function_name": "collect", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:30:45.723554", "function_name": "collect", "function_body": "  # Constants for actions\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  actions = []\n\n  # Get the current state from the environment\n  # env is a CraftLab instance, _current_state is a CraftState instance\n  current_state = env._current_state\n\n  # Get agent's current position and the grid\n  current_pos = current_state.pos  # (col, row)\n  grid = current_state.grid  # (WIDTH, HEIGHT, n_kinds)\n\n  # Find the target primitive on the grid\n  target_x, target_y = -1, -1\n  grid_width, grid_height, _ = grid.shape\n\n  found_primitive = False\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the primitive is present at this grid cell\n      if grid[x, y, primitive] > 0:\n        target_x, target_y = x, y\n        found_primitive = True\n        break  # Found it, break inner loop\n    if found_primitive:\n      break  # Break outer loop\n\n  if not found_primitive:\n    # Primitive not found anywhere on the grid, return an empty list of actions\n    return []\n\n  # Calculate the differences in coordinates needed to reach the target\n  # dx: horizontal distance (columns)\n  # dy: vertical distance (rows)\n  dx = target_x - current_pos[0]\n  dy = target_y - current_pos[1]\n\n  # Generate actions to move horizontally\n  if dx > 0:  # Need to move right\n    for _ in range(dx):\n      actions.append(ACTION_RIGHT)\n  elif dx < 0:  # Need to move left\n    for _ in range(abs(dx)):\n      actions.append(ACTION_LEFT)\n\n  # Generate actions to move vertically\n  if dy > 0:  # Need to move down\n    for _ in range(dy):\n      actions.append(ACTION_DOWN)\n  elif dy < 0:  # Need to move up\n    for _ in range(abs(dy)):\n      actions.append(ACTION_UP)\n\n  # After moving to the target location (or adjacent to it, which USE typically handles),\n  # add the USE action to pick up the item.\n  actions.append(ACTION_USE)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:30:45.793104", "function_name": "collect", "function_body": "    import collections # Required for deque for Breadth-First Search (BFS)\n\n    # Action constants mapping to integer values as defined in CraftLab\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Direction vectors for movement actions (row_delta, col_delta)\n    # These map an action (like UP) to the change in (row, column) coordinates.\n    MOVE_DELTAS = {\n        UP: (-1, 0),\n        DOWN: (1, 0),\n        LEFT: (0, -1),\n        RIGHT: (0, 1)\n    }\n\n    # Offsets for a 3x3 neighborhood (excluding the center) relative to the agent's position.\n    # This is used to determine if a target item is \"adjacent\" and can be collected with USE.\n    NEIGHBOR_OFFSETS = [\n        (-1, -1), (-1, 0), (-1, 1), # Top row of the 3x3 neighborhood\n        (0, -1),           (0, 1),  # Middle row (excluding the center, which is the agent's position)\n        (1, -1),  (1, 0),  (1, 1)   # Bottom row\n    ]\n\n    def _find_path_to_adjacent(current_state, target_kind_idx):\n        \"\"\"\n        Internal helper: Uses Breadth-First Search (BFS) to find the shortest sequence\n        of movement actions from the agent's `current_state.pos` to any position from\n        which an instance of `target_kind_idx` is in the 3x3 neighborhood.\n        This effectively finds a path to a cell where a 'USE' action would successfully\n        collect the target primitive.\n\n        Args:\n            current_state (CraftState): The current state of the crafting environment.\n            target_kind_idx (int): The integer index of the primitive item to find.\n\n        Returns:\n            list[int] or None: A list of movement actions (UP, DOWN, LEFT, RIGHT)\n                               to reach an adjacent position, or None if no such\n                               path exists (e.g., primitive is unreachable or not on map).\n        \"\"\"\n        grid = current_state.grid\n        start_pos = current_state.pos\n        # Determine grid dimensions (rows, columns, kinds)\n        # Assuming grid.shape is (height, width, n_kinds) consistent with numpy array indexing (row, col)\n        HEIGHT, WIDTH, _ = grid.shape \n\n        q = collections.deque([(start_pos, [])]) # Queue for BFS: (current_position, path_actions_to_reach_here)\n        visited = {start_pos} # Set of visited positions to avoid cycles and redundant exploration\n\n        while q:\n            (r, c), path_actions = q.popleft()\n\n            # Check if the current position (r, c) is adjacent to the target_kind_idx.\n            # This involves iterating through the 3x3 neighborhood of (r, c)\n            # to see if any cell contains the target primitive.\n            for dr_adj, dc_adj in NEIGHBOR_OFFSETS:\n                nr_adj, nc_adj = r + dr_adj, c + dc_adj\n                \n                # Ensure the neighboring cell being checked is within grid boundaries\n                if 0 <= nr_adj < HEIGHT and 0 <= nc_adj < WIDTH:\n                    # If the target primitive is found in a neighboring cell\n                    if grid[nr_adj, nc_adj, target_kind_idx] == 1:\n                        # We've found a path to a position (r,c) from which the primitive can be \"used\".\n                        return path_actions\n\n            # If the current position is not adjacent to the target, explore valid neighboring cells\n            # for the agent's next move.\n            for action in [UP, DOWN, LEFT, RIGHT]:\n                dr, dc = MOVE_DELTAS[action]\n                nr, nc = r + dr, c + dc\n\n                # Ensure the next agent position (nr, nc) is within grid boundaries\n                if 0 <= nr < HEIGHT and 0 <= nc < WIDTH:\n                    next_pos = (nr, nc)\n                    if next_pos not in visited:\n                        visited.add(next_pos)\n                        q.append((next_pos, path_actions + [action]))\n        \n        return None # No path found to any cell adjacent to the primitive within reachable bounds\n\n    # --- Main logic for collect_v1 ---\n    total_actions = []\n\n    # Get the current CraftState from the CraftLab environment.\n    # CraftLab's `_current_state` attribute holds the CraftState instance.\n    current_craft_state = env._current_state\n\n    # Loop to continuously try to collect the primitive until it's in the inventory.\n    # A maximum number of attempts is set to prevent infinite loops in case of uncollectible\n    # primitives or environmental changes not handled by simple pathfinding.\n    MAX_COLLECTION_ATTEMPTS = 500 # Arbitrary limit\n\n    for _attempt_num in range(MAX_COLLECTION_ATTEMPTS):\n        # First, check if the primitive is already in the inventory. If so, the task is complete.\n        if current_craft_state.inventory[primitive] > 0:\n            break # Exit loop as primitive is collected\n\n        # Find the sequence of movement actions required to get to a position\n        # from which the primitive can be collected (i.e., adjacent to it).\n        path_to_primitive_adj = _find_path_to_adjacent(current_craft_state, primitive)\n\n        if path_to_primitive_adj is None:\n            # If no path is found, the primitive might not be on the map,\n            # or it's currently unreachable from the agent's position.\n            # In this scenario, we cannot complete the collection.\n            return [] # Return an empty list indicating failure\n\n        # Execute the determined movement actions one by one.\n        for action in path_to_primitive_adj:\n            total_actions.append(action) # Add action to our total list\n            # Step the environment with the action. `env.step` updates the internal\n            # state of the CraftLab environment, including `env._current_state`.\n            _reward, _done, _obs = env.step(action)\n            current_craft_state = env._current_state # Update our local reference to the state\n\n        # After moving to an adjacent position, perform the USE action to collect the primitive.\n        total_actions.append(USE) # Add the USE action to the list\n        _reward, _done, _obs = env.step(USE) # Execute the USE action\n        current_craft_state = env._current_state # Update state after USE\n\n    # After the loop (either primitive collected or max attempts reached),\n    # check if the primitive was successfully added to the inventory.\n    if current_craft_state.inventory[primitive] > 0:\n        return total_actions # Return the sequence of actions that led to collection\n    else:\n        # If the loop finished but the primitive was not collected (e.g., hit MAX_COLLECTION_ATTEMPTS),\n        # return an empty list indicating that collection failed.\n        return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:32:21.684252", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n    from itertools import product\n\n    # Action constants (typically from env_factory, but defined locally for self-containment)\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    # Mapping movement actions to (dr, dc) deltas\n    _ACTION_DELTAS = {\n        _UP: (-1, 0),\n        _DOWN: (1, 0),\n        _LEFT: (0, -1),\n        _RIGHT: (0, 1),\n    }\n\n    # Agent directions: N=0, E=1, S=2, W=3 (clockwise)\n    # Mapped to (dr, dc) deltas relative to agent's current position\n    _AGENT_DIR_DELTAS = {\n        0: (-1, 0), # North\n        1: (0, 1),  # East\n        2: (1, 0),  # South\n        3: (0, -1)  # West\n    }\n\n    # Reverse map: (dr, dc) delta to agent direction index\n    _DELTA_TO_AGENT_DIR_IDX = {v: k for k, v in _AGENT_DIR_DELTAS.items()}\n\n    current_state = env._current_state\n    world = current_state.world\n    grid = current_state.grid\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir # Agent's initial facing direction (0=N, 1=E, 2=S, 3=W)\n    rows, cols, _ = grid.shape\n\n    # 1. Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Helper function to check if a cell is traversable\n    # A cell is traversable if it's within bounds and doesn't contain non-grabbable items.\n    def is_traversable(r, c):\n        if not (0 <= r < rows and 0 <= c < cols):\n            return False # Out of bounds\n\n        # Check if the cell contains any non-grabbable obstacle\n        occupied_kinds_in_cell = np.where(grid[r, c] > 0)[0]\n        for kind_idx in occupied_kinds_in_cell:\n            # world.non_grabbable_indices contains indices of entities that block movement\n            if kind_idx in world.non_grabbable_indices:\n                return False\n        return True\n\n    # 2. Find all locations where the primitive exists on the grid\n    primitive_locations = []\n    for r, c in product(range(rows), range(cols)):\n        if grid[r, c, primitive] > 0:\n            primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        return [] # Primitive not found anywhere in the grid\n\n    # 3. Determine potential target cells for the agent:\n    # These are traversable cells adjacent to any primitive location.\n    target_adj_squares = set()\n    # Map target_adj_square to the specific primitive location it's adjacent to.\n    # This is needed later to determine which way to face.\n    adj_to_primitive_map = {}\n\n    for pr, pc in primitive_locations:\n        # Check 4-directional neighbors around the primitive\n        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nr, nc = pr + dr, pc + dc\n            if is_traversable(nr, nc):\n                target_adj_squares.add((nr, nc))\n                adj_to_primitive_map[(nr, nc)] = (pr, pc)\n\n    if not target_adj_squares:\n        # This could happen if all primitives are fully surrounded by non-traversable items\n        return []\n\n    # 4. BFS to find the shortest path from initial_pos to any target_adj_square\n    # Queue stores: ((current_row, current_col), list_of_actions_to_reach_here)\n    q = collections.deque([(initial_pos, [])])\n    # Visited set to avoid cycles: (row, col)\n    visited = {initial_pos}\n\n    best_path_to_adj = None\n    final_agent_pos_after_path = None\n\n    while q:\n        (r, c), path_actions = q.popleft()\n\n        if (r, c) in target_adj_squares:\n            best_path_to_adj = path_actions\n            final_agent_pos_after_path = (r, c)\n            break # Found a path to an adjacent square\n\n        # Explore possible movement actions (UP, DOWN, LEFT, RIGHT)\n        for action, (dr, dc) in _ACTION_DELTAS.items():\n            nr, nc = r + dr, c + dc\n            if is_traversable(nr, nc) and (nr, nc) not in visited:\n                visited.add((nr, nc))\n                q.append(((nr, nc), path_actions + [action]))\n\n    if best_path_to_adj is None:\n        return [] # No path found to any cell adjacent to a primitive\n\n    # 5. Determine the necessary actions to face the primitive and USE it.\n    final_actions = list(best_path_to_adj) # Start with movement actions\n\n    # Get the specific primitive location that final_agent_pos_after_path is adjacent to\n    primitive_target_loc = adj_to_primitive_map[final_agent_pos_after_path]\n    \n    # Calculate relative position from agent's final position to the primitive\n    dr_to_primitive = primitive_target_loc[0] - final_agent_pos_after_path[0]\n    dc_to_primitive = primitive_target_loc[1] - final_agent_pos_after_path[1]\n\n    target_dir_delta = (dr_to_primitive, dc_to_primitive)\n\n    # Convert this delta to the required agent facing direction index (N, E, S, W)\n    target_agent_dir_idx = _DELTA_TO_AGENT_DIR_IDX.get(target_dir_delta)\n\n    if target_agent_dir_idx is not None:\n        # Calculate minimum turns required from initial_dir (agent's current direction after movement path)\n        # to face target_agent_dir_idx.\n        # N=0, E=1, S=2, W=3 (clockwise)\n        # Difference modulo 4: (target - current + 4) % 4\n        diff = (target_agent_dir_idx - initial_dir + 4) % 4\n\n        if diff == 1: # e.g., N -> E (1 step right)\n            final_actions.append(_RIGHT)\n        elif diff == 2: # e.g., N -> S (2 steps right/left)\n            final_actions.extend([_RIGHT, _RIGHT]) # Two rights (or two lefts, doesn't matter for path length)\n        elif diff == 3: # e.g., N -> W (1 step left)\n            final_actions.append(_LEFT)\n        # If diff == 0, already facing correctly, no turn actions needed.\n\n    # 6. Append the USE action to collect the primitive\n    final_actions.append(_USE)\n\n    return final_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:32:22.664485", "function_name": "collect", "function_body": "  # Action constants (assuming these are globally defined or otherwise available in scope)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Mapping movement actions to (dx, dy) for grid navigation\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Helper function for Breadth-First Search (BFS) pathfinding\n  # This function is nested to keep all code within the main function as per instructions.\n  # It assumes `collections` (specifically `collections.deque`) is available globally.\n  def _find_path_to_adjacent_primitive(start_pos, target_kind, grid, world):\n      \"\"\"\n      Finds a path of actions (movement only) from start_pos to a cell\n      adjacent to an instance of target_kind on the grid.\n      Returns (path_actions, target_primitive_pos) if found, else (None, None).\n      \"\"\"\n      import collections # Local import for deque, assuming it's acceptable given \"Do not imports\" constraint usually refers to top-level.\n\n      width, height, _ = grid.shape\n\n      # Identify all obstacle kinds for movement.\n      # This includes non-grabbable items and the target primitive itself,\n      # as the agent should move to a square *adjacent* to the primitive, not onto it.\n      obstacle_kinds = set(world.non_grabbable_indices)\n      obstacle_kinds.add(target_kind)\n\n      # Queue for BFS: (current_x, current_y), list_of_actions_to_reach_here\n      q = collections.deque([(start_pos, [])])\n      \n      # Visited set to prevent cycles and redundant paths: (x, y) tuples\n      visited = {start_pos}\n\n      # First, find all locations where the target_kind exists on the grid\n      primitive_locations = []\n      for x in range(width):\n          for y in range(height):\n              if grid[x, y, target_kind] == 1:\n                  primitive_locations.append((x, y))\n\n      if not primitive_locations:\n          return None, None # Primitive not found anywhere on the grid\n\n      # BFS loop to explore the grid\n      while q:\n          (curr_x, curr_y), path_actions = q.popleft()\n\n          # Check if the current position is adjacent to any of the primitive locations\n          for p_x, p_y in primitive_locations:\n              # Check for 4-directional adjacency (Manhattan distance of 1)\n              if (abs(curr_x - p_x) == 1 and curr_y == p_y) or \\\n                 (abs(curr_y - p_y) == 1 and curr_x == p_x):\n                  \n                  # Found a path to a cell adjacent to a primitive.\n                  return path_actions, (p_x, p_y)\n\n          # Explore valid neighboring cells (4-directional movement)\n          for action, (dx, dy) in MOVE_DELTAS.items():\n              next_x, next_y = curr_x + dx, curr_y + dy\n\n              # Check boundary conditions\n              if not (0 <= next_x < width and 0 <= next_y < height):\n                  continue\n\n              # Check if the cell has already been visited\n              if (next_x, next_y) in visited:\n                  continue\n\n              # Check for obstacles: agent cannot move into a cell that contains an obstacle_kind\n              is_obstacle = False\n              for kind_idx in obstacle_kinds:\n                  if grid[next_x, next_y, kind_idx] == 1:\n                      is_obstacle = True\n                      break\n              \n              # If the cell is not an obstacle, add it to the queue\n              if not is_obstacle:\n                  visited.add((next_x, next_y))\n                  q.append(((next_x, next_y), path_actions + [action]))\n      \n      return None, None # No path to an adjacent primitive found\n\n  # --- Main logic for collect_v2 ---\n  \n  # Access the current state of the environment\n  current_state = env._current_state \n  \n  # If the primitive is already in inventory, no actions are needed\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Get the CraftWorld instance for obstacle information\n  world = env.world \n  \n  # Find the shortest path (movement actions) to a cell adjacent to the primitive\n  path_to_adjacent, _ = _find_path_to_adjacent_primitive(\n      start_pos=current_state.pos, \n      target_kind=primitive, \n      grid=current_state.grid, \n      world=world\n  )\n\n  if path_to_adjacent is None:\n      # If no path is found (e.g., primitive is unreachable or doesn't exist), return an empty list\n      return [] \n  \n  # After reaching the adjacent square, perform the USE action to collect the primitive.\n  # The problem description of CraftState.next_to suggests USE operates on items in the 3x3 neighborhood,\n  # implying no specific facing direction is required once adjacent.\n  return path_to_adjacent + [ACTION_USE]", "island_id": 5, "scores": {"3": -1}}
