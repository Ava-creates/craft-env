{"timestamp": "2025-07-30T12:27:25.599505", "function_name": "collect", "function_body": "  import collections # For deque\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Maps movement actions to (dx, dy) changes in position.\n  DIRS_VEC = {\n      ACTION_DOWN: (0, 1),  # (dx, dy)\n      ACTION_UP: (0, -1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Maps movement actions to the agent's new facing direction.\n  # Agent directions: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Maps agent direction (int) to (dx, dy) of the cell it faces.\n  DIR_TO_COORDS_CHANGE = {\n      0: (0, -1),  # UP (faces cell above current pos)\n      1: (1, 0),   # RIGHT (faces cell to the right)\n      2: (0, 1),   # DOWN (faces cell below)\n      3: (-1, 0)   # LEFT (faces cell to the left)\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information\n  current_pos = env._current_state.pos\n  start_x, start_y = current_pos\n  start_dir = env._current_state.dir # Agent's current facing direction\n\n  grid = env.observations()['features_dict']['features_global']\n  grid_width, grid_height = grid.shape[0], grid.shape[1]\n\n  # Determine which entities block movement.\n  # We assume that `non_grabbable_indices` are generally obstacles,\n  # but `workshop_indices` are typically traversable locations where actions can be performed.\n  blocker_indices = env.world.non_grabbable_indices - set(env.world.workshop_indices)\n\n  def is_passable(x, y):\n    \"\"\"Checks if a given cell (x, y) is within bounds and does not contain blocking entities.\"\"\"\n    # Check grid bounds\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell contains any blocking entity\n    for blocker_idx in blocker_indices:\n      if grid[x, y, blocker_idx] == 1:\n        return False # This cell contains an unpassable obstacle\n    return True # Cell is passable\n\n  # BFS State: (x, y, agent_direction)\n  # Queue item: (current_x, current_y, current_direction, path_actions)\n  q = collections.deque()\n  visited = set() # Stores (x, y, direction) tuples to avoid redundant exploration and cycles\n\n  # Initial state: Agent's starting position and direction with an empty path\n  q.append((start_x, start_y, start_dir, []))\n  visited.add((start_x, start_y, start_dir))\n\n  while q:\n    cx, cy, c_dir, c_path = q.popleft()\n\n    # Check if the current state (cx, cy, c_dir) allows immediate collection of the primitive.\n    # Calculate coordinates of the cell the agent is currently facing.\n    faced_x, faced_y = cx + DIR_TO_COORDS_CHANGE[c_dir][0],\\\n                       cy + DIR_TO_COORDS_CHANGE[c_dir][1]\n\n    # If the faced cell is valid and contains the primitive, we can collect it.\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Goal reached! The current path leads to a position where a USE action can collect the primitive.\n      return c_path + [ACTION_USE]\n\n    # Explore all possible movement actions from the current state (cx, cy, c_dir)\n    for action_name, (dx, dy) in DIRS_VEC.items():\n      nx, ny = cx + dx, cy + dy\n      n_dir = ACTION_TO_DIR[action_name] # New direction after taking this action\n\n      # Check if the new position is passable and the new state (pos, dir) has not been visited.\n      if is_passable(nx, ny):\n        if (nx, ny, n_dir) not in visited:\n          visited.add((nx, ny, n_dir))\n          # Add the new state to the queue with the updated path\n          q.append((nx, ny, n_dir, c_path + [action_name]))\n\n  # If the queue is exhausted and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:28:52.078998", "function_name": "collect", "function_body": "    current_state = env._current_state  # Access the underlying CraftState instance\n\n    # 1. Check if the primitive is already collected or directly usable\n    # Check inventory\n    if current_state.inventory[primitive] > 0:\n        return []  # Already collected\n\n    # Check if agent is currently adjacent to the primitive (including on the same cell, due to 3x3 neighborhood)\n    # If so, a single USE action is sufficient.\n    if current_state.next_to(primitive):\n        return [4]  # USE action (action ID 4)\n\n    # 2. Get current grid information and agent position\n    grid = current_state.grid\n    current_pos = current_state.pos  # (row, col)\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # Identify non-grabbable (obstacle) indices from the world configuration.\n    # Cells occupied by these kinds are considered untraversable.\n    non_grabbable_indices = env.world.non_grabbable_indices\n    non_grabbable_set = set(non_grabbable_indices) # Convert to set for O(1) lookup\n\n    def is_traversable(r, c):\n        \"\"\"Checks if a given grid cell (r, c) is within bounds and not an obstacle.\"\"\"\n        if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n            return False  # Out of bounds\n        # Check if any non-grabbable item is present at (r, c)\n        for k_idx in non_grabbable_set:\n            if grid[r, c, k_idx] > 0:\n                return False  # Cell occupied by an untraversable obstacle\n        return True\n\n    # 3. Find all locations of the primitive on the grid\n    primitive_locations = []\n    # Using numpy.where to efficiently find coordinates where the primitive exists\n    rows, cols = np.where(grid[:, :, primitive] > 0)\n    for r, c in zip(rows, cols):\n        primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        return []  # Primitive not found on the map, cannot collect\n\n    # Convert primitive locations to a set for efficient adjacency checks during BFS\n    primitive_locations_set = set(primitive_locations)\n\n    # Define movement actions and their corresponding (delta_row, delta_col) offsets\n    # Action IDs: DOWN=0, UP=1, LEFT=2, RIGHT=3\n    MOVE_ACTIONS_MAP = {\n        0: (0, 1),   # DOWN: (row, col+1)\n        1: (0, -1),  # UP:   (row, col-1)\n        2: (-1, 0),  # LEFT: (row-1, col)\n        3: (1, 0),   # RIGHT: (row+1, col)\n    }\n\n    # 4. BFS to find the shortest path to a cell from which the primitive can be collected\n    # A cell is \"collectable from\" if it's adjacent to a primitive or on the primitive itself (and traversable).\n    q = collections.deque([(current_pos, [])])  # Queue stores ((row, col), list_of_actions_to_reach_here)\n    visited = {current_pos}  # Set of visited (row, col) positions\n\n    target_collection_pos = None\n    best_path_actions = []\n\n    while q:\n        (r, c), path_so_far = q.popleft()\n\n        # Check if the current position (r, c) is a valid \"collection spot\".\n        # This means it's either the primitive's location itself (and traversable),\n        # or it's directly adjacent (Manhattan distance 1) to a primitive location.\n        is_collection_spot = False\n\n        # Check if primitive is at current location (r, c) and agent can be there\n        if (r, c) in primitive_locations_set and is_traversable(r, c):\n            target_collection_pos = (r, c)\n            best_path_actions = path_so_far\n            is_collection_spot = True\n        else:\n            # Check if (r, c) is adjacent to a primitive location\n            for dr_move, dc_move in MOVE_ACTIONS_MAP.values():\n                check_r, check_c = r + dr_move, c + dc_move\n                if (check_r, check_c) in primitive_locations_set:\n                    target_collection_pos = (r, c)\n                    best_path_actions = path_so_far\n                    is_collection_spot = True\n                    break\n        \n        if is_collection_spot:\n            break  # Found the shortest path to a suitable collection position\n\n        # Explore possible next moves from (r, c)\n        for action, (dr_move, dc_move) in MOVE_ACTIONS_MAP.items():\n            nr, nc = r + dr_move, c + dc_move\n            \n            if is_traversable(nr, nc) and (nr, nc) not in visited:\n                visited.add((nr, nc))\n                q.append(((nr, nc), path_so_far + [action]))\n\n    if not target_collection_pos:\n        return []  # No path found to any suitable collection position\n\n    # 5. Add the USE action to the path\n    final_actions = list(best_path_actions)  # Make a mutable copy\n    final_actions.append(4)  # Add the USE action (action ID 4)\n\n    return final_actions", "island_id": 2, "scores": {"3": -1}}
