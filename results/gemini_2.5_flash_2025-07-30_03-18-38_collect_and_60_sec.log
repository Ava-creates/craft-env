{"timestamp": "2025-07-30T15:01:25.738226", "function_name": "collect", "function_body": "  # Define constants for actions and coordinate differences for clarity.\n  # These are based on CraftLab.action_specs and problem description.\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement actions to coordinate changes (dx, dy)\n  ACTION_TO_COORD_DIFF = {\n      ACTION_DOWN: (0, 1),\n      ACTION_UP: (0, -1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # 1. Get the integer index for the given primitive name\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Pre-checks:\n  #    a. Check if the primitive can be picked up (is grabbable).\n  #       If not, the USE action cannot collect it.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  #    b. Check if the primitive is already in the agent's inventory.\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 3. Retrieve grid dimensions and identify movement obstacles.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Define the set of indices for items that block movement.\n  # By default, we consider all non-grabbable items as impassable for movement.\n  # Converting to a list once for efficient NumPy fancy indexing.\n  impassable_movement_indices = list(env.world.non_grabbable_indices)\n  \n  # 4. Perform a Breadth-First Search (BFS) for the shortest path.\n  #    BFS state: ((current_x, current_y), current_direction)\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  # `collections.deque` is used for efficient queue operations.\n  # It is assumed to be imported by a preceding function (collect_v1).\n  queue = collections.deque([(start_pos, start_dir)])\n  \n  # `path_trace` stores (parent_state_tuple, action_taken_to_reach_current_state)\n  # This also implicitly serves as the `visited` set for BFS.\n  path_trace = {(start_pos, start_dir): (None, None)} \n\n  target_use_state = None # Will store the state from which the final USE action can be applied\n\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.popleft() # Dequeue the current state\n\n    # Calculate the coordinates of the cell directly in front of the agent.\n    # This is the cell that the USE action would interact with.\n    dx_dir, dy_dir = ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # If the target cell is within bounds and contains the desired primitive.\n    # This means we've found a state from which the primitive can be collected.\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      target_use_state = ((curr_x, curr_y), curr_dir)\n      break # Shortest path found, exit the BFS loop.\n\n    # Explore all four possible movement actions (DOWN, UP, LEFT, RIGHT).\n    # Moving changes both the agent's position and its facing direction.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to cardinal movements\n      dx_move, dy_move = ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # The agent's new direction is the direction of movement\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n\n      # Check if the potential next position is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position is impassable (contains any item from `impassable_movement_indices`).\n      # This check is performed only if the `impassable_movement_indices` list is not empty.\n      if impassable_movement_indices and np.any(grid[next_x, next_y, impassable_movement_indices]):\n        continue # Agent cannot move into this cell.\n      \n      # If this new state (position and direction) has not been visited yet:\n      if next_state_tuple not in path_trace:\n        # Store how we reached this new state and add it to the queue.\n        path_trace[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action)\n        queue.append(next_state_tuple)\n\n  if target_use_state is None:\n    return [] # If the BFS queue becomes empty and no path was found, the primitive is unreachable.\n\n  # 5. Reconstruct the sequence of actions by backtracking from the `target_use_state`.\n  path_actions = []\n  current_reconstruction_state = target_use_state\n  \n  # Backtrack until we reach the starting state, which has (None, None) as its parent info.\n  while path_trace[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = path_trace[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  # The path was built in reverse order (from target to start), so reverse it.\n  path_actions.reverse()\n  \n  # Add the final 'USE' action to complete the collection sequence.\n  return path_actions + [ACTION_USE]", "island_id": 5, "scores": {"3": -1}}
