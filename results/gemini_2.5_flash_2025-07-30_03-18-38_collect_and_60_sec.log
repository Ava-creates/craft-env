{"timestamp": "2025-07-30T04:37:30.977680", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  initial_state = env._current_state\n  initial_pos = initial_state.pos # (x, y)\n  initial_grid = initial_state.grid # (WIDTH, HEIGHT, n_kinds)\n  initial_inventory = initial_state.inventory\n  world = env.world\n  cookbook = world.cookbook\n  idx_map = cookbook.index # For looking up names (e.g., \"tree\" -> its ID)\n\n  WIDTH, HEIGHT, N_KINDS = initial_grid.shape\n\n  # Action mappings based on CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  \n  # Check if primitive is already collected\n  if initial_inventory[primitive] > 0:\n    return []\n\n  target_kind_on_grid = -1 # The kind index we are looking for on the grid\n  needs_adjacency_for_use = False # True if USE action needed while adjacent, False if move onto\n\n  # Determine what kind to look for and what action to do to obtain the primitive.\n  # This relies on conventions for how certain items are collected in CraftWorld.\n  if primitive in world.grabbable_indices:\n    # Item can be picked up by moving onto its square\n    target_kind_on_grid = primitive\n    needs_adjacency_for_use = False\n  else:\n    # Item likely requires a 'USE' action on an adjacent source (e.g., water_bucket from water).\n    # We need to map the desired 'primitive' (e.g., water_bucket's ID) to its source on the grid\n    # (e.g., water's ID).\n    try:\n      # Common mappings for items obtained via 'USE' action\n      if primitive == idx_map.index(\"water_bucket\"):\n        target_kind_on_grid = world.water_index\n        needs_adjacency_for_use = True\n      elif primitive == idx_map.index(\"wood\"):\n        target_kind_on_grid = idx_map.index(\"tree\") # Assuming 'tree' is indexed\n        needs_adjacency_for_use = True\n      elif primitive == idx_map.index(\"stone\"):\n        target_kind_on_grid = world.stone_index\n        needs_adjacency_for_use = True\n      else:\n        # If the primitive is not grabbable and not a recognized USE-source item,\n        # this collect function cannot handle it (e.g., it might be a crafted item).\n        return []\n    except ValueError:\n      # If a required name (like \"tree\" or \"water_bucket\") is not found in the index,\n      # it means the primitive is unknown or uncollectable by this method.\n      return []\n\n  if target_kind_on_grid == -1:\n    # This should not be reached if the above logic is exhaustive for collectable items.\n    return []\n\n  # BFS to find the shortest path to the target kind on the grid\n  queue = deque([(initial_pos, [])]) # (current_pos: tuple(int, int), actions_list: list[int])\n  visited = {initial_pos} # Set of (x, y) tuples to avoid cycles\n\n  # Define possible movement actions and their resulting (dx, dy)\n  move_actions = [\n      (0, 1, DOWN),  # Move South (increase y)\n      (0, -1, UP),   # Move North (decrease y)\n      (-1, 0, LEFT), # Move West (decrease x)\n      (1, 0, RIGHT), # Move East (increase x)\n  ]\n\n  while queue:\n    current_pos, path = queue.popleft()\n    cx, cy = current_pos\n\n    found_target_location = False\n    final_actions = []\n\n    if needs_adjacency_for_use:\n      # We need to be adjacent to the target_kind_on_grid\n      # Check the 3x3 neighborhood around the current position\n      for dx in [-1, 0, 1]:\n        for dy in [-1, 0, 1]:\n          nx, ny = cx + dx, cy + dy\n          # Check bounds and ensure it's an adjacent cell, not the agent's current cell\n          if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and (dx != 0 or dy != 0):\n            if initial_grid[nx, ny, target_kind_on_grid] > 0:\n              found_target_location = True\n              final_actions = [USE] # Append the USE action\n              break\n        if found_target_location:\n          break\n    else: # needs to be ON the cell for grabbable items\n      if initial_grid[cx, cy, target_kind_on_grid] > 0:\n        found_target_location = True\n        # No additional action is explicitly needed for grabbable items;\n        # picking them up is typically implicit upon moving onto their square.\n        final_actions = []\n\n    if found_target_location:\n      return path + final_actions\n    \n    # Explore neighboring cells\n    for dx, dy, action in move_actions:\n      new_x, new_y = cx + dx, cy + dy\n      new_pos = (new_x, new_y)\n\n      # Check bounds and if the new position has already been visited\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT and new_pos not in visited:\n        visited.add(new_pos)\n        queue.append((new_pos, path + [action]))\n  \n  # If the BFS completes and no path to the target is found\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:37:32.012823", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  current_pos = state.pos\n  inventory = state.inventory\n\n  # Check if the primitive is already in inventory\n  if inventory[primitive] > 0:\n    return []\n\n  width, height = grid.shape[0], grid.shape[1]\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # --- Helper functions for BFS ---\n\n  def is_valid_coord(x, y):\n    \"\"\"Checks if coordinates are within grid bounds.\"\"\"\n    return 0 <= x < width and 0 <= y < height\n\n  def is_traversable(x, y):\n    \"\"\"Checks if a cell is traversable by the agent.\"\"\"\n    if not is_valid_coord(x, y):\n      return False\n    # A cell is traversable if it does not contain any non-grabbable entity\n    return not any(grid[x, y, k] == 1 for k in non_grabbable_indices)\n\n  # --- Find all locations of the primitive ---\n  primitive_locations = []\n  for x in range(width):\n    for y in range(height):\n      if grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  if not primitive_locations:\n    # Primitive not found on the grid\n    return []\n\n  # --- BFS Setup ---\n  q = collections.deque()\n  # Queue stores (x, y, list_of_actions_to_reach_here)\n  q.append((current_pos[0], current_pos[1], []))\n\n  visited = set()\n  visited.add(current_pos)\n\n  # Cardinal directions and their corresponding action IDs\n  # (dx, dy) -> Action ID\n  # (0, -1): y decreases -> UP (ID 1)\n  # (0, 1): y increases -> DOWN (ID 0)\n  # (-1, 0): x decreases -> LEFT (ID 2)\n  # (1, 0): x increases -> RIGHT (ID 3)\n  MOVE_DELTAS_TO_ACTION = {\n      (0, -1): 1,  # UP\n      (0, 1): 0,   # DOWN\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  CARDINAL_DELTAS = list(MOVE_DELTAS_TO_ACTION.keys()) # [(0, -1), (0, 1), (-1, 0), (1, 0)]\n\n  ACTION_USE = 4\n\n  # --- BFS Execution ---\n  while q:\n    cx, cy, c_path = q.popleft()\n\n    # Check if current position is adjacent to any primitive location\n    # If so, we are in a position to USE the primitive\n    for px, py in primitive_locations:\n      # Check 4-neighborhood around the primitive\n      for dx_adj, dy_adj in CARDINAL_DELTAS:\n        adj_px, adj_py = px + dx_adj, py + dy_adj\n        if (cx, cy) == (adj_px, adj_py):\n          # Found a path to a square adjacent to a primitive\n          return list(c_path) + [ACTION_USE]\n\n    # Explore neighbors\n    for dx, dy in CARDINAL_DELTAS:\n      nx, ny = cx + dx, cy + dy\n\n      if is_traversable(nx, ny) and (nx, ny) not in visited:\n        visited.add((nx, ny))\n        new_actions = list(c_path) + [MOVE_DELTAS_TO_ACTION[(dx, dy)]]\n        q.append((nx, ny, new_actions))\n\n  # If BFS completes and no path is found\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:39:08.476679", "function_name": "collect", "function_body": "", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:39:09.490448", "function_name": "collect", "function_body": "  import collections # For deque\n\n  # Constants from the problem description, implicitly defined by actions\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction vectors for movement actions (dx, dy)\n  # These correspond to the order of actions UP, RIGHT, DOWN, LEFT\n  # (dx, dy) = (MOVE_DX[action_id], MOVE_DY[action_id])\n  MOVE_DX = [0, 1, 0, -1] \n  MOVE_DY = [-1, 0, 1, 0] \n  MOVE_ACTIONS = [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  current_pos = env._current_state.pos\n  current_x, current_y = current_pos\n  grid = env.observations()['features_dict']['features_global']\n  grid_width, grid_height, _ = grid.shape\n\n  # Helper function to check if a grid cell is within bounds and not an obstacle.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # Check if the cell is occupied by a non-grabbable item (which acts as an obstacle).\n    # Moving onto grabbable items (like other primitives) is allowed.\n    for k_idx in env.world.non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # 2. Identify all possible \"pre-final\" agent positions and the corresponding\n  #    \"final action\" to take from that position to collect the primitive.\n  #    A \"pre-final\" position (pf_ax, pf_ay) is a cell from which the agent\n  #    takes one last movement action (final_move_action) to reach (ax, ay),\n  #    which is adjacent to the primitive (px, py) and facing it.\n  #    Then, ACTION_USE is performed.\n  \n  # Maps (pre_final_x, pre_final_y) -> final_move_action\n  # This stores the valid \"endpoints\" for our BFS path.\n  goal_pre_final_positions = {} \n\n  # Iterate through the grid to find all locations where the primitive exists.\n  for px in range(grid_width):\n    for py in range(grid_height):\n      if grid[px, py, primitive] == 1: # Found a primitive at (px, py)\n        # Consider all 4 directions the agent could face to pick up (px, py)\n        for final_move_action in MOVE_ACTIONS:\n          dx = MOVE_DX[final_move_action]\n          dy = MOVE_DY[final_move_action]\n\n          # (ax, ay) is the cell the agent will stand ON when using the primitive.\n          # The agent will be at (ax, ay), facing `final_move_action`, and (px, py) is\n          # (ax + dx, ay + dy). Thus:\n          ax = px - dx\n          ay = py - dy\n          \n          # (pf_ax, pf_ay) is the cell BEFORE (ax, ay) from which final_move_action is taken.\n          # (ax, ay) = (pf_ax + dx, pf_ay + dy). Thus:\n          pf_ax = ax - dx\n          pf_ay = ay - dy\n\n          # Validate all relevant cells:\n          # 1. pre-final position (pf_ax, pf_ay) must be walkable.\n          # 2. final agent position (ax, ay) must be walkable.\n          # 3. final agent position (ax, ay) must NOT contain the primitive\n          #    (agent picks up an adjacent item, not one it's standing on).\n          if is_walkable(pf_ax, pf_ay) and \\\n             is_walkable(ax, ay) and \\\n             grid[ax, ay, primitive] == 0:\n            \n            # Store this valid pre-final position and its required final action.\n            # If multiple ways to reach a (pf_ax, pf_ay) allow collecting,\n            # we just store the first one encountered; BFS finds shortest path to position.\n            if (pf_ax, pf_ay) not in goal_pre_final_positions:\n              goal_pre_final_positions[(pf_ax, pf_ay)] = final_move_action\n  \n  if not goal_pre_final_positions:\n    return [] # No primitive instances found or no valid approach paths to them.\n\n  # 3. BFS Pathfinding\n  # State in BFS queue: (x, y, path_so_far)\n  # The direction of the agent doesn't need to be part of the BFS state\n  # because any sequence of movement actions will result in the agent\n  # facing the direction of the *last* movement action taken.\n  # The `final_move_action` step (which is appended at the end) ensures the agent\n  # ends up in the correct position AND facing the correct direction.\n  q = collections.deque([(current_x, current_y, [])])\n  \n  # Visited set: (x, y) to prevent cycles and re-exploring worse paths to a position.\n  visited = {(current_x, current_y)}\n\n  while q:\n    cx, cy, current_path = q.popleft()\n\n    # Check if current position is one of the goal pre-final positions\n    if (cx, cy) in goal_pre_final_positions:\n      final_move_action = goal_pre_final_positions[(cx, cy)]\n      # Path found! Append the final movement action and then the USE action.\n      return current_path + [final_move_action, ACTION_USE] \n\n    # Explore neighbors (possible movement actions)\n    for move_action in MOVE_ACTIONS:\n      nx = cx + MOVE_DX[move_action]\n      ny = cy + MOVE_DY[move_action]\n\n      if is_walkable(nx, ny) and (nx, ny) not in visited:\n        visited.add((nx, ny))\n        q.append((nx, ny, current_path + [move_action]))\n\n  # If the queue becomes empty and no path was found to any goal pre-final position\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T04:40:42.464258", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Get current state from the environment\n  current_state = env._current_state\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  inventory = current_state.inventory\n\n  # Get grid dimensions\n  grid_height, grid_width, _ = grid.shape\n\n  # Get action mappings from the environment's specs\n  action_specs = env.action_specs()\n  DOWN_ACTION = action_specs['DOWN']\n  UP_ACTION = action_specs['UP']\n  LEFT_ACTION = action_specs['LEFT']\n  RIGHT_ACTION = action_specs['RIGHT']\n  USE_ACTION = action_specs['USE']\n\n  # Define movement deltas and resulting agent directions\n  # Directions: 0=Right, 1=Down, 2=Left, 3=Up\n  MOVE_DELTAS = {\n      DOWN_ACTION: (1, 0),   # (dr, dc)\n      UP_ACTION: (-1, 0),\n      LEFT_ACTION: (0, -1),\n      RIGHT_ACTION: (0, 1),\n  }\n  MOVE_TO_DIR = {\n      DOWN_ACTION: 1, # Agent faces Down after moving Down\n      UP_ACTION: 3,   # Agent faces Up after moving Up\n      LEFT_ACTION: 2, # Agent faces Left after moving Left\n      RIGHT_ACTION: 0, # Agent faces Right after moving Right\n  }\n  # Maps agent direction to the delta of the cell directly in front\n  DELTAS_FROM_DIR = {\n      0: (0, 1),  # Right\n      1: (1, 0),  # Down\n      2: (0, -1), # Left\n      3: (-1, 0), # Up\n  }\n\n  # 1. Check if the primitive is already in inventory\n  if inventory[primitive] > 0:\n    return []\n\n  # 2. Locate all primitive instances on the grid\n  primitive_locations = []\n  for r in range(grid_height):\n    for c in range(grid_width):\n      if grid[r, c, primitive] > 0:\n        primitive_locations.append((r, c))\n\n  # If no primitive found on the grid, it cannot be collected\n  if not primitive_locations:\n    return []\n\n  # 3. Perform a Breadth-First Search (BFS) to find the shortest path\n  # State in BFS: (current_position, current_direction, list_of_actions_taken)\n  q = deque()\n  q.append((start_pos, start_dir, []))\n\n  # Visited set to prevent cycles and redundant exploration: (position, direction)\n  visited = set()\n  visited.add((start_pos, start_dir))\n\n  while q:\n    current_pos, current_dir, actions_taken = q.popleft()\n    r, c = current_pos\n\n    # Check if we are in a position to collect the primitive using USE action\n    front_dr, front_dc = DELTAS_FROM_DIR[current_dir]\n    target_r, target_c = r + front_dr, c + front_dc\n\n    # If the cell directly in front contains the primitive, we've found a path\n    if (target_r, target_c) in primitive_locations:\n      return actions_taken + [USE_ACTION]\n\n    # Explore possible movements\n    for move_action, (dr, dc) in MOVE_DELTAS.items():\n      next_r, next_c = r + dr, c + dc\n      next_pos = (next_r, next_c)\n      next_dir = MOVE_TO_DIR[move_action] # Agent faces the direction of movement\n\n      # Check bounds and if this state (pos, dir) has been visited\n      if (0 <= next_r < grid_height and 0 <= next_c < grid_width and\n          (next_pos, next_dir) not in visited):\n        visited.add((next_pos, next_dir))\n        q.append((next_pos, next_dir, actions_taken + [move_action]))\n\n  # If the queue is exhausted and no path was found, the primitive is unreachable\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:40:42.533855", "function_name": "collect", "function_body": "    import collections\n\n    # Constants for actions (matching DMLab-like typical mappings)\n    # These are defined locally to adhere to the prompt's requirement\n    # of only returning code that will fit inside the function.\n    ACTIONS = {\n        'DOWN': 0, \n        'UP': 1, \n        'LEFT': 2, \n        'RIGHT': 3, \n        'USE': 4\n    }\n\n    # Mapping from action_id (movement action) to the resulting direction ID\n    # Assuming 0:North(UP), 1:East(RIGHT), 2:South(DOWN), 3:West(LEFT)\n    ACTION_TO_DIR_MAP = {\n        ACTIONS['UP']: 0,\n        ACTIONS['RIGHT']: 1,\n        ACTIONS['DOWN']: 2,\n        ACTIONS['LEFT']: 3,\n    }\n\n    # Direction vectors (dx, dy) for each direction index\n    # (dx, dy) represents the change in (x, y) if moving one step in that direction\n    DIR_VECTORS = {\n        0: (0, -1),  # North (UP)\n        1: (1, 0),   # East (RIGHT)\n        2: (0, 1),   # South (DOWN)\n        3: (-1, 0),  # West (LEFT)\n    }\n    # Reverse mapping from (dx, dy) vector to direction index\n    VEC_TO_DIR_MAP = {v: k for k, v in DIR_VECTORS.items()}\n\n    current_state = env._current_state\n    \n    # 1. Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    # Determine grid dimensions from the grid shape (WIDTH, HEIGHT, n_kinds)\n    WIDTH, HEIGHT, _ = grid.shape \n    \n    # 2. Find all locations on the grid where the primitive exists\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        # If the primitive is not found anywhere on the map, it cannot be collected\n        return []\n\n    # 3. BFS (Breadth-First Search) setup for pathfinding\n    q = collections.deque()\n    # Visited set stores (x, y, direction) tuples to avoid cycles and redundant exploration\n    visited = set() \n\n    initial_pos_x, initial_pos_y = current_state.pos\n    initial_dir = current_state.dir\n\n    # Add the initial state to the queue: (current_x, current_y, current_direction, path_taken_so_far)\n    q.append((initial_pos_x, initial_pos_y, initial_dir, [])) \n    visited.add((initial_pos_x, initial_pos_y, initial_dir))\n\n    while q:\n        curr_x, curr_y, curr_dir, path = q.popleft()\n\n        # Check if the current state (position and direction) is a goal state.\n        # A goal state is one where the agent is adjacent to a primitive and facing it.\n        for px, py in primitive_locations:\n            dx = px - curr_x\n            dy = py - curr_y\n\n            # Check if (px, py) is directly adjacent to (curr_x, curr_y)\n            # and (dx, dy) corresponds to a cardinal direction vector.\n            if (dx, dy) in VEC_TO_DIR_MAP:\n                required_dir_to_face_primitive = VEC_TO_DIR_MAP[(dx, dy)]\n                if curr_dir == required_dir_to_face_primitive:\n                    # Agent is at an adjacent cell to the primitive and facing it.\n                    # This means we can perform the USE action to collect it.\n                    return path + [ACTIONS['USE']]\n\n        # If not a goal state, explore possible next moves (UP, DOWN, LEFT, RIGHT)\n        for action_name, action_id in ACTIONS.items():\n            if action_id == ACTIONS['USE']:\n                continue # The USE action is only performed at the goal state, not for movement exploration\n\n            next_x, next_y = curr_x, curr_y\n            \n            # Calculate the next position based on the movement action\n            if action_id == ACTIONS['UP']:\n                next_y -= 1\n            elif action_id == ACTIONS['DOWN']:\n                next_y += 1\n            elif action_id == ACTIONS['LEFT']:\n                next_x -= 1\n            elif action_id == ACTIONS['RIGHT']:\n                next_x += 1\n            \n            # The agent's direction updates to face the direction of the movement action\n            new_dir = ACTION_TO_DIR_MAP[action_id] \n\n            # Boundary check: Ensure the next position is within the grid\n            if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                continue\n\n            # Walkability check: For this environment, we assume all in-bounds cells are walkable.\n            # If certain entities (e.g., walls) were explicitly blocking,\n            # an additional check for grid[next_x, next_y, blocking_kind] would be needed.\n\n            # Check if this (position, direction) state has already been visited\n            if (next_x, next_y, new_dir) in visited:\n                continue\n\n            # Add the new state to the queue for further exploration\n            q.append((next_x, next_y, new_dir, path + [action_id]))\n            visited.add((next_x, next_y, new_dir))\n    \n    # If the BFS queue becomes empty and no path to collect the primitive was found,\n    # return an empty list of actions.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:41:55.919446", "function_name": "collect", "function_body": "  import collections\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position)\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y\n      1: (1, 0),   # RIGHT: increases x\n      2: (0, 1),   # DOWN: increases y\n      3: (-1, 0)   # LEFT: decreases x\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Helper function to check if a grid cell is within bounds and not an obstacle.\n  # Obstacles are defined by non_grabbable_indices.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # Check if the cell is occupied by any non-grabbable item.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # Helper function to check if primitive is in the 8-cell neighborhood around (px,py).\n  # This mimics the effect of CraftState.next_to for collection, assuming items\n  # are collected from adjacent cells, not the agent's own cell.\n  def is_primitive_adjacent(px, py, target_primitive_idx):\n    for dx_adj in [-1, 0, 1]:\n      for dy_adj in [-1, 0, 1]:\n        # Exclude the agent's own cell (0,0) as items are typically collected from adjacent cells.\n        if dx_adj == 0 and dy_adj == 0:\n          continue\n\n        adj_x, adj_y = px + dx_adj, py + dy_adj\n        if (0 <= adj_x < grid_width and 0 <= adj_y < grid_height and\n            grid[adj_x, adj_y, target_primitive_idx] == 1):\n          return True\n    return False\n\n  # Breadth-First Search (BFS) for shortest path\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n  # `current_direction`: The direction the agent is facing *after* arriving at (current_x, current_y)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to avoid redundant exploration and cycles.\n  # A state is defined by (x, y, direction) because the agent's direction matters\n  # for which cells it can move into.\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the primitive is adjacent to the current position.\n    # If it is, then ACTION_USE can be performed from this position.\n    # The agent's facing direction (curr_dir) does not restrict the USE action here,\n    # as per the CraftState.next_to description.\n    if is_primitive_adjacent(curr_x, curr_y, primitive):\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next movement actions\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Determine the new position and direction after this action\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # Agent's new facing direction after moving\n\n      # If the next cell is walkable and this (position, direction) state hasn't been visited\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T04:41:56.909903", "function_name": "collect", "function_body": "  import collections\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position)\n  DIR_VEC = {\n      0: (0, -1),  # UP: (dx, dy) - decreasing y\n      1: (1, 0),   # RIGHT: increasing x\n      2: (0, 1),   # DOWN: increasing y\n      3: (-1, 0)   # LEFT: decreasing x\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a grid cell is within bounds and not an obstacle.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # Check if the cell is occupied by any non-grabbable item (which acts as an obstacle).\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # 2. Pre-compute all (x, y, direction) states from which the primitive can be collected.\n  # A state (ax, ay, adir) is \"collectable\" if:\n  #   - (ax, ay) is walkable.\n  #   - The cell (px, py) pointed to by (ax, ay, adir) contains the primitive.\n  collectable_states = set()\n\n  # Iterate through all cells in the grid to find instances of the primitive\n  for px in range(grid_width):\n    for py in range(grid_height):\n      if grid[px, py, primitive] == 1:\n        # This cell (px, py) contains the primitive.\n        # Now, find all *agent positions* (ax, ay) and *agent directions* (adir)\n        # such that the agent at (ax, ay) facing adir would point to (px, py).\n\n        # Iterate over all possible agent directions (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n        for adir, (dx, dy) in DIR_VEC.items():\n          # If agent is at (ax, ay) and faces (dx, dy), then (ax+dx, ay+dy) is (px, py)\n          # So, the agent's position (ax, ay) must be (px-dx, py-dy)\n          ax, ay = px - dx, py - dy\n\n          if is_walkable(ax, ay):\n            collectable_states.add((ax, ay, adir))\n\n  # If there are no collectable primitive instances on the grid or no reachable collection points,\n  # return an empty path.\n  if not collectable_states:\n      return []\n\n  # 3. Breadth-First Search (BFS)\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n  # current_direction: The direction the agent is facing *after* arriving at (current_x, current_y)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to avoid redundant exploration and cycles.\n  # A state is defined by (x, y, direction) because the agent's direction affects\n  # what it can interact with (via ACTION_USE).\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the current state is one from which the primitive can be collected.\n    if (curr_x, curr_y, curr_dir) in collectable_states:\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next movement actions (UP, RIGHT, DOWN, LEFT)\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Determine the new position and direction after taking this action.\n      # The movement vector (dx, dy) corresponds to the direction integer of the action.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # Agent faces the direction of its last movement\n\n      # If the next cell is walkable and this (position, direction) state hasn't been visited\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T04:43:35.109639", "function_name": "collect", "function_body": "    current_state = env._current_state\n    # Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions (Height, Width, N_Kinds) from the current state's grid\n    HEIGHT, WIDTH, _ = current_state.grid.shape\n\n    # Helper constants for agent movement and direction, assumed to be defined globally\n    # _DIR_VECTORS = {0: (1, 0), 1: (-1, 0), 2: (0, 1), 3: (0, -1)} # South, North, East, West\n    # def _get_fwd_pos(pos, direction): ...\n    # def _get_back_pos(pos, direction): ...\n    # def _get_new_dir(current_dir, turn_action): ...\n\n    # Helper to check if a position is valid and traversable, defined locally to meet constraints\n    def _is_blocked(grid, r, c, non_grabbable_indices):\n        if not (0 <= r < grid.shape[0] and 0 <= c < grid.shape[1]):\n            return True # Out of bounds\n        \n        # Check if any non-grabbable item (e.g., water, walls) is present at (r, c)\n        for idx in non_grabbable_indices:\n            if grid[r, c, idx] == 1:\n                return True # Cell contains an impassable object\n        return False\n\n    # Queue for Breadth-First Search (BFS)\n    # Stores tuples: (row, col, direction, current_inventory_tuple, list_of_actions_taken_to_reach_here)\n    # Inventory is stored as a tuple for hashability in the `visited` set.\n    initial_inventory_tuple = tuple(current_state.inventory)\n    queue = collections.deque([(current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple, [])])\n    \n    # Set to keep track of visited states to prevent infinite loops and redundant exploration\n    # A state is defined by (row, col, direction, inventory_tuple)\n    visited = set([(current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)])\n\n    max_search_depth = 500 # Maximum number of actions in a path to limit search complexity\n\n    best_path = None # Stores the sequence of actions for the shortest path to collect the item\n\n    # BFS loop\n    while queue and len(queue[0][3]) < max_search_depth:\n        r, c, d, inv_tuple, actions_path = queue.popleft()\n\n        # Check if the goal (primitive in inventory) is satisfied in the current simulated state\n        if inv_tuple[primitive] > 0:\n            best_path = actions_path\n            break # Goal achieved, stop BFS and return this path\n\n        # Explore all possible actions from the current state\n        for action in [env_factory.ACTIONS.MOVE_FORWARD, env_factory.ACTIONS.MOVE_BACKWARD,\n                       env_factory.ACTIONS.TURN_LEFT, env_factory.ACTIONS.TURN_RIGHT,\n                       env_factory.ACTIONS.USE]:\n            \n            # Initialize next state components based on current state\n            next_pos_r, next_pos_c = r, c\n            next_dir = d\n            next_inv_list = list(inv_tuple) # Create a mutable copy for inventory updates\n\n            # Simulate the effect of the action\n            if action == env_factory.ACTIONS.MOVE_FORWARD:\n                temp_r, temp_c = _get_fwd_pos((r, c), d)\n                if not _is_blocked(current_state.grid, temp_r, temp_c, env.world.non_grabbable_indices):\n                    next_pos_r, next_pos_c = temp_r, temp_c\n            elif action == env_factory.ACTIONS.MOVE_BACKWARD:\n                temp_r, temp_c = _get_back_pos((r, c), d)\n                if not _is_blocked(current_state.grid, temp_r, temp_c, env.world.non_grabbable_indices):\n                    next_pos_r, next_pos_c = temp_r, temp_c\n            elif action == env_factory.ACTIONS.TURN_LEFT:\n                next_dir = _get_new_dir(d, env_factory.ACTIONS.TURN_LEFT)\n            elif action == env_factory.ACTIONS.TURN_RIGHT:\n                next_dir = _get_new_dir(d, env_factory.ACTIONS.TURN_RIGHT)\n            elif action == env_factory.ACTIONS.USE:\n                front_r, front_c = _get_fwd_pos((r, c), d)\n                # Check if the cell in front is within bounds and contains the primitive,\n                # and if that primitive is a grabbable item according to the world configuration.\n                if (0 <= front_r < HEIGHT and 0 <= front_c < WIDTH and\n                    current_state.grid[front_r, front_c, primitive] == 1 and\n                    primitive in env.world.grabbable_indices):\n                    next_inv_list[primitive] += 1 # Simulate collecting one unit of the item\n            \n            # Convert updated inventory back to a tuple for hashability\n            next_inv_tuple = tuple(next_inv_list)\n            # Define the new state tuple\n            next_state_tuple = (next_pos_r, next_pos_c, next_dir, next_inv_tuple)\n\n            # Add the new state to the queue if it hasn't been visited before\n            if next_state_tuple not in visited:\n                visited.add(next_state_tuple)\n                new_actions_path = actions_path + [action]\n                queue.append((next_pos_r, next_pos_c, next_dir, next_inv_tuple, new_actions_path))\n\n    # Return the found path or an empty list if no path was found within limits\n    return best_path if best_path is not None else []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:43:36.082616", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  # Ensure position is int tuple. CraftState.pos is tuple(int, int)\n  # The features_dict['pos'] might be normalized or float, so convert to int tuple.\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  world = env.world\n  # non_grabbable_indices typically include obstacles like water, stone walls, workshops.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  # Items to be collected (primitives) are generally traversable.\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for x in range(W):\n      for y in range(H):\n          # A cell is NOT traversable if it contains any non-grabbable item (obstacle).\n          if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n              traversable_mask[x, y] = False\n  \n  # Ensure the agent's current position is marked as traversable.\n  # This should always be true for valid states.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] # Agent starts on an untraversable cell, no path possible.\n\n  # Action constants (from problem description context)\n  # Defined here to ensure they are available within the function scope.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVES = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # 2. Perform BFS to find the shortest path to any location containing the primitive.\n  q = deque([(current_pos, [])]) # (current_pos, path_so_far_actions)\n  visited = {current_pos}\n  \n  path_to_primitive = []\n\n  while q:\n      (curr_x, curr_y), actions_so_far = q.popleft()\n\n      # Check if the current position contains the target primitive.\n      # If so, we've found a path to a primitive.\n      if grid[curr_x, curr_y, primitive] > 0:\n          path_to_primitive = actions_so_far\n          break # Found the shortest path to a primitive location\n\n      # Explore neighbors\n      for action, (dx, dy) in MOVES.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # Check bounds, traversability, and if already visited\n          if (0 <= next_x < W and 0 <= next_y < H and\n              traversable_mask[next_x, next_y] and\n              next_pos not in visited):\n              \n              visited.add(next_pos)\n              q.append((next_pos, actions_so_far + [action]))\n  \n  # If no path was found (e.g., primitive is unreachable or doesn't exist)\n  # and the agent is not already on the primitive itself, return empty list.\n  if not path_to_primitive and not grid[current_pos[0], current_pos[1], primitive] > 0:\n      return [] \n  \n  # 3. Append the USE action after the movement path.\n  # If path_to_primitive is empty, it implies the agent is already on the primitive's square.\n  actions.extend(path_to_primitive)\n  actions.append(USE)\n  \n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T04:45:36.095032", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    state = env._current_state\n    world = env.world # CraftWorld instance to access grabbable/non-grabbable indices\n\n    grid = state.grid\n    pos = state.pos\n    inventory = state.inventory\n    width, height, n_kinds = grid.shape\n\n    # Get action mappings dynamically from the environment\n    action_map = env.action_specs()\n    ACTION_USE = action_map[\"USE\"]\n    ACTION_UP = action_map[\"UP\"]\n    ACTION_DOWN = action_map[\"DOWN\"]\n    ACTION_LEFT = action_map[\"LEFT\"]\n    ACTION_RIGHT = action_map[\"RIGHT\"]\n\n    _CARDINAL_MOVE_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n    _MOVE_DELTAS = {\n        ACTION_UP: (0, 1),  # North (increasing Y)\n        ACTION_DOWN: (0, -1), # South (decreasing Y)\n        ACTION_LEFT: (-1, 0), # West (decreasing X)\n        ACTION_RIGHT: (1, 0) # East (increasing X)\n    }\n\n    # 1. Check if primitive is already in inventory\n    if inventory[primitive] > 0:\n        return []\n\n    # 2. Determine collection strategy based on whether it's grabbable or requires 'USE' from adjacent\n    # Assume items in world.non_grabbable_indices require a 'USE' action from an adjacent cell (e.g., stone, water)\n    requires_use_action_from_adjacent = primitive in world.non_grabbable_indices\n\n    # 3. BFS Setup\n    q = collections.deque([(pos, [])])  # Queue stores ((x, y), list_of_actions_to_reach_here)\n    visited = {pos} # Set of visited (x, y) coordinates\n\n    # 4. BFS Loop\n    while q:\n        (curr_x, curr_y), curr_path = q.popleft()\n\n        is_goal_reached = False\n        final_actions_at_goal = []\n\n        # Check if current position allows for goal action (collecting the primitive)\n        if requires_use_action_from_adjacent:\n            # For non-grabbable items, check if the primitive is in the 3x3 neighborhood (excluding current cell)\n            for dx_adj in [-1, 0, 1]:\n                for dy_adj in [-1, 0, 1]:\n                    if dx_adj == 0 and dy_adj == 0:\n                        continue # Skip current cell itself for adjacency check\n                    check_x, check_y = curr_x + dx_adj, curr_y + dy_adj\n\n                    # Ensure coordinates are within grid bounds\n                    if 0 <= check_x < width and 0 <= check_y < height:\n                        if grid[check_x, check_y, primitive] > 0:\n                            is_goal_reached = True\n                            final_actions_at_goal = [ACTION_USE]\n                            break\n                if is_goal_reached:\n                    break\n        else: # Primitive is grabbable (e.g., wood), check if it's on the current cell\n            if grid[curr_x, curr_y, primitive] > 0:\n                is_goal_reached = True\n                final_actions_at_goal = [] # Item is assumed to be collected by simply moving onto the cell\n\n        if is_goal_reached:\n            return curr_path + final_actions_at_goal\n\n        # Explore valid neighboring cells\n        for action in _CARDINAL_MOVE_ACTIONS:\n            dx, dy = _MOVE_DELTAS[action]\n            next_x, next_y = curr_x + dx, curr_y + dy\n\n            # Check bounds\n            if not (0 <= next_x < width and 0 <= next_y < height):\n                continue\n\n            # Check if already visited\n            if (next_x, next_y) in visited:\n                continue\n\n            # Check traversability: agent cannot move onto cells occupied by certain non-grabbable entities\n            is_traversable = True\n            for k in world.non_grabbable_indices:\n                if grid[next_x, next_y, k] > 0:\n                    # If the non-grabbable entity is the primitive we are searching for AND it requires USE from adjacent,\n                    # then we should not move *onto* it, but *next* to it. So, this cell is blocked for movement.\n                    if k == primitive and requires_use_action_from_adjacent:\n                        is_traversable = False # Do not move into the target primitive's cell if it needs to be 'USE'd from adjacent\n                        break\n                    elif k != primitive: # It's a different non-grabbable entity (e.g., another wall/obstacle)\n                        is_traversable = False\n                        break\n            \n            if is_traversable:\n                visited.add((next_x, next_y))\n                q.append(((next_x, next_y), curr_path + [action]))\n\n    # If no path found to collect the primitive\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:45:37.106327", "function_name": "collect", "function_body": "  import collections\n\n  # Constants for actions based on CraftLab.action_specs\n  _ACTION_MAP = env.action_specs()\n  ACTION_DOWN = _ACTION_MAP['DOWN']\n  ACTION_UP = _ACTION_MAP['UP']\n  ACTION_LEFT = _ACTION_MAP['LEFT']\n  ACTION_RIGHT = _ACTION_MAP['RIGHT']\n  ACTION_USE = _ACTION_MAP['USE']\n\n  all_actions = []\n  # Safety limit to prevent excessively long plans/loops in complex scenarios\n  max_total_steps = 1000 \n\n  for step_count in range(max_total_steps):\n    # Get current observations from the environment\n    obs = env.observations()\n    current_inventory = obs['features_dict']['inventory']\n\n    # Check if the primitive is already collected\n    if current_inventory[primitive] > 0:\n        break # Goal achieved, exit loop\n\n    current_state = env._current_state\n    \n    # Check if the primitive is immediately usable (i.e., adjacent to the agent)\n    if current_state.next_to(primitive):\n        env.step(ACTION_USE) # Perform the USE action\n        all_actions.append(ACTION_USE)\n        continue # Re-evaluate the state (inventory might be updated)\n    \n    # If not adjacent, plan movement using BFS\n    grid = current_state.grid\n    px, py = current_state.pos\n    width, height, n_kinds = grid.shape\n\n    # 1. Find all locations where the primitive is present on the grid\n    primitive_locations = []\n    for x in range(width):\n        for y in range(height):\n            # Check if this grid cell contains the target primitive\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n    \n    if not primitive_locations:\n        # Primitive is not found anywhere on the map and not in inventory.\n        # It means it's uncollectable from the current scenario.\n        return []\n\n    # 2. Determine target cells for BFS: any cell from which the primitive can be 'used'.\n    # This means cells that are 4-directionally adjacent to a primitive location.\n    adjacency_targets = set()\n    for tx, ty in primitive_locations:\n        # Explore 4-directional neighbors\n        for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n            nx, ny = tx + dx, ty + dy\n            # Check if neighbor is within grid bounds\n            if 0 <= nx < width and 0 <= ny < height:\n                adjacency_targets.add((nx, ny))\n    \n    # Remove the agent's current position from adjacency_targets if it exists there,\n    # as the `next_to` check should have already handled cases where we are already adjacent.\n    if (px, py) in adjacency_targets:\n        adjacency_targets.remove((px, py))\n\n    if not adjacency_targets:\n        # If no valid adjacent cells to move to (e.g., primitive is completely surrounded by obstacles)\n        return []\n\n    # 3. BFS to find the shortest path from the agent's current position (px, py)\n    # to any of the determined adjacency_targets.\n    q = collections.deque([(px, py, [])]) # Queue stores (x, y, path_of_actions_to_reach_here)\n    visited = {(px, py)} # Set of visited (x, y) coordinates\n    \n    path_to_adjacent = None\n\n    while q:\n        cx, cy, path = q.popleft()\n\n        # If current cell is one of the target adjacent cells, we found a path\n        if (cx, cy) in adjacency_targets:\n            path_to_adjacent = path\n            break # Found the shortest path, exit BFS\n        \n        # Explore 4-directional neighbors for movement\n        moves = [\n            (cx, cy + 1, ACTION_DOWN),\n            (cx, cy - 1, ACTION_UP),\n            (cx - 1, cy, ACTION_LEFT),\n            (cx + 1, cy, ACTION_RIGHT),\n        ]\n\n        for nx, ny, action in moves:\n            # Check if the neighbor cell is within bounds and not visited\n            if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n                # Check for movement obstacles (water, stone)\n                # `env.world.water_index` and `env.world.stone_index`\n                # are typically impassable entities in CraftWorld.\n                is_obstacle = False\n                if env.world.water_index >= 0 and grid[nx, ny, env.world.water_index] > 0:\n                    is_obstacle = True\n                if env.world.stone_index >= 0 and grid[nx, ny, env.world.stone_index] > 0:\n                    is_obstacle = True\n                \n                if not is_obstacle:\n                    visited.add((nx, ny))\n                    q.append((nx, ny, path + [action]))\n    \n    if path_to_adjacent:\n        # Execute the first action of the found shortest path\n        next_action = path_to_adjacent[0]\n        env.step(next_action) # Perform the movement action in the environment\n        all_actions.append(next_action)\n    else:\n        # No path found to any adjacent cell. This implies the primitive is unreachable,\n        # e.g., completely surrounded by obstacles, or no valid adjacent cells exist.\n        return []\n\n  return all_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:46:33.893838", "function_name": "collect", "function_body": "  import collections\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position)\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y\n      1: (1, 0),   # RIGHT: increases x\n      2: (0, 1),   # DOWN: increases y\n      3: (-1, 0)   # LEFT: decreases x\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get initial state information\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a grid cell is within bounds and not an obstacle.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # Check if the cell is occupied by any non-grabbable item.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # 2. Pre-compute all potential agent collection positions.\n  # These are cells (ax, ay) from which the agent can successfully perform ACTION_USE\n  # to collect the primitive, as per CraftState.next_to's 3x3 neighborhood logic.\n  target_agent_positions = set()\n  \n  # Iterate through every cell in the grid\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If this cell (x, y) contains the primitive\n      if grid[x, y, primitive] == 1:\n        # Any cell within a 3x3 neighborhood of (x,y) is a potential agent position\n        # from which the primitive at (x,y) can be collected.\n        for dx_adj in [-1, 0, 1]:\n          for dy_adj in [-1, 0, 1]:\n            adj_x, adj_y = x + dx_adj, y + dy_adj\n            # Check if this potential agent position is walkable\n            if is_walkable(adj_x, adj_y):\n              target_agent_positions.add((adj_x, adj_y))\n  \n  # If no primitive is found, or no walkable spots around primitives, return empty path\n  if not target_agent_positions:\n    return []\n\n  # 3. Breadth-First Search (BFS) for shortest path to any target_agent_position.\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to avoid redundant exploration and cycles.\n  # A state is defined by (x, y, direction).\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the current agent position is one of the pre-computed target positions.\n    if (curr_x, curr_y) in target_agent_positions:\n      # If so, we've found the shortest path to a suitable collection spot.\n      # Append the ACTION_USE to complete the collection.\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next movement actions (UP, RIGHT, DOWN, LEFT)\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Determine the new position and direction after taking this action\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # Agent's new facing direction after moving\n\n      # If the next cell is walkable and this (position, direction) state hasn't been visited\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T04:46:34.853905", "function_name": "collect", "function_body": "  import collections\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position)\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y\n      1: (1, 0),   # RIGHT: increases x\n      2: (0, 1),   # DOWN: increases y\n      3: (-1, 0)   # LEFT: decreases x\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Helper function to check if a grid cell is within bounds and not an obstacle.\n  # Obstacles are defined by non_grabbable_indices.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # Check if the cell is occupied by any non-grabbable item.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # Breadth-First Search (BFS) for shortest path\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n  # `current_direction`: The direction the agent is facing *after* arriving at (current_x, current_y)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to avoid redundant exploration and cycles.\n  # A state is defined by (x, y, direction) because the agent's direction matters\n  # for the 'USE' action.\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the primitive can be collected from the current position and direction.\n    # The 'USE' action is assumed to act on the cell directly in front of the agent.\n    faced_x, faced_y = curr_x + DIR_VEC[curr_dir][0], curr_y + DIR_VEC[curr_dir][1]\n\n    # Check if the faced cell is within bounds and contains the target primitive.\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Goal reached! Return the path including the 'USE' action.\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next movement actions (UP, RIGHT, DOWN, LEFT)\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Determine the new position and direction after this action.\n      # The direction of movement also sets the agent's new facing direction.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # Agent's new facing direction after moving\n\n      # If the next cell is walkable and this (position, direction) state hasn't been visited,\n      # add it to the queue for further exploration.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T04:48:20.377158", "function_name": "collect", "function_body": "    # Relative moves for (dx, dy) and their corresponding action IDs (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n    # Based on (x, y) coordinate system, where x is horizontal, y is vertical.\n    # Moving DOWN means y increases. Moving UP means y decreases.\n    # Moving LEFT means x decreases. Moving RIGHT means x increases.\n    # ACTION_USE is 4.\n    moves = [\n        (0, 1, 0),   # (dx, dy, action_id) -> (0, 1, ACTION_DOWN)\n        (0, -1, 1),  # (dx, dy, action_id) -> (0, -1, ACTION_UP)\n        (-1, 0, 2),  # (dx, dy, action_id) -> (-1, 0, ACTION_LEFT)\n        (1, 0, 3)    # (dx, dy, action_id) -> (1, 0, ACTION_RIGHT)\n    ]\n\n    current_state = env._current_state\n    # Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    pos = current_state.pos  # Agent's current (x, y) position\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # Find all locations on the grid where the primitive exists\n    primitive_locations = []\n    # np.where returns a tuple of arrays (x_indices, y_indices) for elements > 0\n    x_indices, y_indices = np.where(grid[:, :, primitive] > 0)\n    for x, y in zip(x_indices, y_indices):\n        primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        # If the primitive is not found anywhere on the grid, return empty actions\n        return []\n\n    # Find the closest target position (an empty cell adjacent to a primitive)\n    best_target_pos = None\n    min_dist = float('inf')  # Manhattan distance\n\n    # Iterate through all located primitives\n    for p_loc_x, p_loc_y in primitive_locations:\n        # Check all 4 cells adjacent to the current primitive location\n        for dx, dy, _ in moves: # The action_id part of `moves` is not used here\n            target_x, target_y = p_loc_x + dx, p_loc_y + dy\n            \n            # Check if the potential target cell is within the grid boundaries\n            if 0 <= target_x < WIDTH and 0 <= target_y < HEIGHT:\n                # Calculate Manhattan distance from the agent's current position to this target cell\n                dist = abs(pos[0] - target_x) + abs(pos[1] - target_y)\n\n                # If this target cell is closer, update our best choice\n                if dist < min_dist:\n                    min_dist = dist\n                    best_target_pos = (target_x, target_y)\n\n    if best_target_pos is None:\n        # This case should ideally not happen if primitive_locations is not empty\n        # and there's a valid grid, but as a safeguard.\n        return []\n\n    # Pathfinding using Breadth-First Search (BFS) to reach the best_target_pos\n    actions_to_reach_target = []\n    \n    # BFS queue stores (current_position_tuple, list_of_actions_to_reach_here)\n    # Using a list to simulate a queue (less efficient than collections.deque but avoids new imports)\n    queue = [(pos, [])]\n    # Set to keep track of visited positions to avoid cycles and redundant paths\n    visited = {pos}\n\n    path_found = False\n    head = 0 # Manual pointer to simulate deque.popleft() for list\n\n    while head < len(queue):\n        curr_pos, curr_path = queue[head]\n        head += 1\n\n        if curr_pos == best_target_pos:\n            actions_to_reach_target = curr_path\n            path_found = True\n            break\n\n        # Explore all four possible neighboring cells\n        for dx, dy, action in moves:\n            next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n            next_pos = (next_x, next_y)\n\n            # Check if the next cell is within bounds and has not been visited yet\n            if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT and next_pos not in visited:\n                # Assuming all grid cells are traversable for movement.\n                visited.add(next_pos)\n                queue.append((next_pos, curr_path + [action]))\n    \n    if not path_found:\n        # If no path is found (e.g., agent is trapped or target is unreachable)\n        return []\n\n    # After moving to the target position (adjacent to the primitive),\n    # perform the USE action to collect it. ACTION_USE is 4.\n    actions_to_reach_target.append(4) \n\n    return actions_to_reach_target", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:48:21.506873", "function_name": "collect", "function_body": "  # Action constants (retrieved from env.action_specs for clarity)\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  actions = []\n  current_state = env._current_state\n\n  # 1. Check if the primitive is already in the agent's inventory\n  if current_state.inventory[primitive] > 0:\n    return []  # Already collected\n\n  # 2. Find all occurrences of the primitive on the grid\n  primitive_locations = []\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive] > 0:\n        primitive_locations.append((x, y))\n\n  if not primitive_locations:\n    return []  # Primitive not found in the current world state\n\n  # 3. Choose the closest primitive location to the agent\n  agent_pos = current_state.pos\n  closest_primitive_loc = None\n  min_dist_to_primitive = float('inf')\n\n  for px, py in primitive_locations:\n    dist = abs(px - agent_pos[0]) + abs(py - agent_pos[1])\n    if dist < min_dist_to_primitive:\n      min_dist_to_primitive = dist\n      closest_primitive_loc = (px, py)\n\n  target_px, target_py = closest_primitive_loc\n\n  # 4. Determine the optimal adjacent cell (target_adj_x, target_adj_y)\n  # This is the cell adjacent to the primitive that is closest to the agent's current position.\n  possible_adj_cells = [\n      (target_px + 1, target_py),  # East\n      (target_px - 1, target_py),  # West\n      (target_px, target_py + 1),  # South\n      (target_px, target_py - 1)   # North\n  ]\n\n  target_adj_x, target_adj_y = None, None\n  min_dist_to_adj_cell = float('inf')\n\n  for ax, ay in possible_adj_cells:\n    # Check if the adjacent cell is within grid bounds\n    if 0 <= ax < grid_width and 0 <= ay < grid_height:\n      dist = abs(ax - agent_pos[0]) + abs(ay - agent_pos[1])\n      if dist < min_dist_to_adj_cell:\n        min_dist_to_adj_cell = dist\n        target_adj_x, target_adj_y = ax, ay\n\n  if target_adj_x is None:\n    # This case implies the primitive is completely surrounded or at a grid edge\n    # where no valid adjacent cell can be reached. For simplicity, we return empty.\n    return []\n\n  # 5. Generate movement actions to get from agent_pos to (target_adj_x, target_adj_y)\n  # The exact order of horizontal/vertical moves doesn't matter if USE is direction-agnostic\n  # for adjacent items, or if the direction updates are implicit from movement.\n  # We prioritize horizontal movement then vertical.\n\n  current_x, current_y = agent_pos\n\n  # Move horizontally\n  dx = target_adj_x - current_x\n  for _ in range(abs(dx)):\n    if dx > 0:\n      actions.append(ACTION_RIGHT)\n    else:\n      actions.append(ACTION_LEFT)\n    # No need to update current_x, current_y for planning as actions are absolute grid moves\n\n  # Move vertically\n  dy = target_adj_y - current_y\n  for _ in range(abs(dy)):\n    if dy > 0:\n      actions.append(ACTION_DOWN)\n    else:\n      actions.append(ACTION_UP)\n    # No need to update current_x, current_y for planning\n\n  # 6. Add the USE action once adjacent to the primitive\n  actions.append(ACTION_USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:49:24.043593", "function_name": "collect", "function_body": "  # `collect_v2` is an improvement over `collect_v1` by using Breadth-First Search (BFS)\n  # to find a path that respects obstacles and agent facing direction for the 'USE' action.\n  # Since `collections.deque` cannot be imported inside the function, a list is used\n  # as a queue (simulating deque's behavior by incrementing an index).\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position)\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y\n      1: (1, 0),   # RIGHT: increases x\n      2: (0, 1),   # DOWN: increases y\n      3: (-1, 0)   # LEFT: decreases x\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Helper function to check if a grid cell is within bounds and not an obstacle.\n  # Obstacles are defined by non_grabbable_indices (e.g., water, workshops).\n  non_grabbable_indices = env.world.non_grabbable_indices\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # Check if the cell is occupied by any non-grabbable item that blocks movement.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # Breadth-First Search (BFS) for shortest path\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n  # Using a list and an index to simulate a queue's `popleft` efficiently (amortized O(1) for appends, O(1) for popping by index).\n  queue = [(start_x, start_y, start_dir, [])]\n  queue_idx = 0\n\n  # Visited set to avoid redundant exploration and cycles.\n  # A state is defined by (x, y, direction) because the agent's direction matters for the 'USE' action.\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue_idx < len(queue):\n    curr_x, curr_y, curr_dir, path_actions = queue[queue_idx]\n    queue_idx += 1 # \"Pop\" the current state by advancing the index\n\n    # Check if the primitive can be collected from the current position and direction.\n    # The 'USE' action is assumed to act on the cell directly in front of the agent.\n    faced_dx, faced_dy = DIR_VEC[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # If the cell directly in front contains the target primitive and is within bounds:\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Goal reached! Return the path including the final 'USE' action.\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next movement actions (UP, RIGHT, DOWN, LEFT)\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Determine the new position and direction after this action.\n      # The agent moves in the direction of the action and faces that direction.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # Agent's new facing direction\n\n      # If the next cell is walkable and this (position, direction) state hasn't been visited,\n      # add it to the queue for further exploration.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T04:49:25.045206", "function_name": "collect", "function_body": "  import collections\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position).\n  # These define the change in coordinates when moving in a specific direction,\n  # and also represent the cell \"in front\" of the agent when facing that direction.\n  # dir 0: UP (decreases y)\n  # dir 1: RIGHT (increases x)\n  # dir 2: DOWN (increases y)\n  # dir 3: LEFT (decreases x)\n  DIR_VEC = {\n      0: (0, -1),\n      1: (1, 0),\n      2: (0, 1),\n      3: (-1, 0)\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information from the environment.\n  # We access `_current_state` directly as it holds the raw grid, position, and direction.\n  current_state = env._current_state\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = current_state.grid # The full allocentric grid layout\n  grid_width, grid_height, _ = grid.shape\n\n  # Helper function to check if a grid cell is within bounds and walkable.\n  # A cell is considered walkable if it's within the grid boundaries\n  # and does not contain any non-grabbable obstacle (e.g., walls, water).\n  non_grabbable_indices = env.world.non_grabbable_indices\n  def is_walkable(x, y):\n    # Check bounds\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check for obstacles (non-grabbable items that block movement)\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1: # If this cell contains an obstacle\n        return False\n    return True\n\n  # Breadth-First Search (BFS) to find the shortest path to collect the primitive.\n  # The state in our BFS queue is defined by (x, y, direction, actions_taken).\n  # We include 'direction' because the 'USE' action depends on the agent's facing direction.\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # A set to keep track of visited states to prevent cycles and redundant explorations.\n  # A state is (x, y, direction).\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Goal Check: Determine if the primitive can be collected from the current state.\n    # The 'USE' action operates on the cell directly in front of the agent.\n    faced_x, faced_y = curr_x + DIR_VEC[curr_dir][0], curr_y + DIR_VEC[curr_dir][1]\n\n    # If the cell in front is within bounds and contains the target primitive, we've found our goal.\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Append the 'USE' action to the path and return the complete sequence.\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next states by applying movement actions.\n    # In CraftWorld, movement actions (UP, DOWN, LEFT, RIGHT) also set the agent's facing direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new position and direction after taking this action.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # The agent faces the direction of movement after the move.\n\n      # If the next cell is walkable and this specific (position, direction) state\n      # has not been visited yet, add it to the queue for further exploration.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable (e.g., blocked by obstacles, or not on the map).\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T04:50:34.057483", "function_name": "collect", "function_body": "    actions_taken = []\n    MAX_COLLECT_ATTEMPTS = 500  # Safety limit to prevent infinite loops\n\n    # Retrieve action integer mappings from the environment's specifications\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    for _ in range(MAX_COLLECT_ATTEMPTS):\n        # Access the current state directly for grid, position, and inventory\n        current_state = env._current_state\n\n        # 1. Check if the primitive is already in the agent's inventory\n        if current_state.inventory[primitive] > 0:\n            break  # Primitive collected, exit loop\n\n        # 2. Check if the agent is next to (or on) the primitive to use it\n        if current_state.next_to(primitive):\n            actions_taken.append(USE)\n            reward, done, _ = env.step(USE)  # Perform the USE action\n            \n            # After attempting USE, re-check if the primitive was collected\n            if current_state.inventory[primitive] > 0:\n                break  # Primitive collected, exit loop\n            \n            # If not collected (e.g., wrong tool, multiple uses needed), continue\n            # The loop will re-evaluate the state and potentially try to use again or move.\n            continue \n\n        # 3. Find all locations of the primitive on the current grid\n        # np.argwhere returns a list of [x, y] coordinates where the condition is true\n        primitive_locations = np.argwhere(current_state.grid[:, :, primitive] == 1)\n\n        if len(primitive_locations) == 0:\n            # Primitive not found on the map. It might have been depleted,\n            # or was never there. Cannot collect.\n            break  # Exit loop\n\n        # 4. Determine the closest primitive instance to move towards\n        current_pos = np.array(current_state.pos)  # Agent's current (x, y) position\n\n        # Calculate Manhattan distance to each primitive instance\n        # primitive_locations contains [x_target, y_target] for each instance\n        distances = np.abs(primitive_locations - current_pos).sum(axis=1)\n        closest_idx = np.argmin(distances)\n        target_pos = primitive_locations[closest_idx]  # Closest [x_target, y_target]\n\n        # 5. Determine the next movement action (greedy approach: prioritize X then Y)\n        dx = target_pos[0] - current_pos[0]\n        dy = target_pos[1] - current_pos[1]\n\n        action_to_perform = -1  # Initialize with a sentinel value\n\n        if dx > 0:\n            action_to_perform = RIGHT\n        elif dx < 0:\n            action_to_perform = LEFT\n        elif dy > 0:\n            action_to_perform = DOWN\n        elif dy < 0:\n            action_to_perform = UP\n        else:\n            # Agent is already at the target_pos (dx=0, dy=0).\n            # This case should ideally be handled by the `next_to(primitive)` check above,\n            # as being on the same cell implies being in the 3x3 neighborhood.\n            # If we reach this point, it means the primitive cannot be collected\n            # from this exact cell by 'USE' or is not collectable.\n            break  # Exit loop, indicating inability to collect\n\n        # 6. Execute the determined movement action\n        actions_taken.append(action_to_perform)\n        reward, done, _ = env.step(action_to_perform)\n        \n        # If the overall task in the environment is considered 'done',\n        # stop further attempts to collect.\n        if done:\n            break\n\n    return actions_taken", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:50:35.061125", "function_name": "collect", "function_body": "  # Action constants from CraftLab.action_specs()\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  actions_taken = []\n  max_steps = 200 # Set a reasonable limit to prevent infinite loops\n\n  # A basic sweeping pattern for exploration when the primitive is not visible.\n  # This pattern moves a few steps in each cardinal direction.\n  # This is a very simple exploration and might not be robust in complex maps.\n  sweep_pattern = [\n      RIGHT, RIGHT, RIGHT, RIGHT, RIGHT,\n      UP, UP, UP, UP, UP,\n      LEFT, LEFT, LEFT, LEFT, LEFT,\n      DOWN, DOWN, DOWN, DOWN, DOWN,\n  ]\n  sweep_idx = 0\n\n  for _ in range(max_steps):\n    obs = env.observations()\n    inventory = obs['features_dict']['inventory']\n\n    # 1. Check if the primitive has already been collected\n    if inventory[primitive] > 0:\n      break # Goal achieved, stop and return actions taken\n\n    features_ego = obs['features_dict']['features_ego']\n    H, W, K = features_ego.shape\n    mid_h, mid_w = H // 2, W // 2 # Agent's relative position in the egocentric view\n\n    action_to_take = None\n\n    # 2. Check if the primitive is in the immediate 3x3 neighborhood for a USE action\n    # This aligns with the 'next_to' concept.\n    found_adjacent_primitive = False\n    for dh in [-1, 0, 1]:\n      for dw in [-1, 0, 1]:\n        if dh == 0 and dw == 0: # Skip the agent's own cell\n          continue\n        \n        nh, nw = mid_h + dh, mid_w + dw\n        if 0 <= nh < H and 0 <= nw < W: # Ensure coordinates are within bounds\n          if features_ego[nh, nw, primitive] == 1.0:\n            found_adjacent_primitive = True\n            break\n      if found_adjacent_primitive:\n        break\n\n    if found_adjacent_primitive:\n      action_to_take = USE\n    else:\n      # 3. If not adjacent, look for the primitive anywhere else in the egocentric view\n      # and try to move towards the closest visible instance.\n      target_r, target_c = -1, -1 # Relative coordinates of the closest visible primitive\n      min_dist_sq = float('inf')\n\n      for r in range(H):\n        for c in range(W):\n          if features_ego[r, c, primitive] == 1.0:\n            # Calculate squared Euclidean distance from the agent's center\n            dist_sq = (r - mid_h)**2 + (c - mid_w)**2\n            if dist_sq < min_dist_sq:\n              min_dist_sq = dist_sq\n              target_r, target_c = r, c\n\n      if target_r != -1: # Primitive found somewhere in the egocentric view\n        dr = target_r - mid_h # Row difference\n        dc = target_c - mid_w # Column difference\n\n        # Choose movement direction: prioritize the axis with larger difference\n        if abs(dr) > abs(dc):\n          action_to_take = DOWN if dr > 0 else UP\n        else: # abs(dc) >= abs(dr)\n          action_to_take = RIGHT if dc > 0 else LEFT\n      else:\n        # 4. If primitive is not visible in the egocentric view at all,\n        # perform a sweeping exploration movement.\n        action_to_take = sweep_pattern[sweep_idx]\n        sweep_idx = (sweep_idx + 1) % len(sweep_pattern)\n    \n    # Execute the chosen action and record it\n    if action_to_take is not None:\n      env.step(action_to_take)\n      actions_taken.append(action_to_take)\n    # The 'else' case (action_to_take is None) should ideally not be reached\n    # given the logic, but adding a fallback for robustness.\n    else:\n      env.step(RIGHT) # Default fallback move\n      actions_taken.append(RIGHT)\n            \n  return actions_taken", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:53:07.497502", "function_name": "collect", "function_body": "    actions = []\n    max_total_actions = 200 # Maximum number of actions to take in the environment\n\n    # Initialize environment and get initial observations\n    obs = env.reset()\n    current_inventory = obs['features_dict']['inventory']\n    if current_inventory[primitive] > 0:\n        return [] # Primitive already collected, no actions needed\n\n    initial_grid = obs['features_dict']['features_global']\n    # De-normalize agent's initial position from the observation's normalized [0,1] range\n    # Assuming grid_width, grid_height are available via scenario\n    grid_width = env.scenario.init_grid.shape[0]\n    grid_height = env.scenario.init_grid.shape[1]\n    initial_pos_r = int(obs['features_dict']['pos'][0] * grid_width)\n    initial_pos_c = int(obs['features_dict']['pos'][1] * grid_height)\n    initial_pos = (initial_pos_r, initial_pos_c)\n\n    # Determine if the primitive is grabbable (picked up by walking over) or non-grabbable (requires USE)\n    # Accessing internal `env.world` (CraftWorld instance) to get `grabbable_indices`.\n    is_grabbable = primitive in env.world.grabbable_indices\n\n    # Find all locations where the primitive exists on the grid.\n    target_locations = []\n    for r in range(grid_width):\n        for c in range(grid_height):\n            if initial_grid[r, c, primitive] == 1:\n                target_locations.append((r, c))\n\n    if not target_locations:\n        return [] # Primitive not found on the initial map, cannot collect\n\n    # BFS setup\n    # Queue stores (row, col, list_of_actions_to_reach_here)\n    q = deque([(initial_pos_r, initial_pos_c, [])])\n    visited = {(initial_pos_r, initial_pos_c)}\n\n    # Define movement deltas and their corresponding actions\n    move_deltas = {\n        ACTION_UP: (-1, 0),  # (dr, dc) for (row, col)\n        ACTION_DOWN: (1, 0),\n        ACTION_LEFT: (0, -1),\n        ACTION_RIGHT: (0, 1),\n    }\n\n    best_path_actions = None # To store the shortest sequence of actions\n\n    # BFS loop\n    while q:\n        r, c, path_so_far = q.popleft()\n\n        # Check if the current position is a successful target for collection\n        # For grabbable: agent needs to be ON the target location\n        # For non-grabbable: agent needs to be ADJACENT to the target location\n        \n        reached_target = False\n        if is_grabbable and (r, c) in target_locations:\n            reached_target = True\n        elif not is_grabbable:\n            for tr, tc in target_locations:\n                if abs(r - tr) + abs(c - tc) == 1: # Manhattan distance 1 means adjacent\n                    reached_target = True\n                    break\n\n        if reached_target:\n            best_path_actions = path_so_far\n            break # Found the shortest path\n\n        # Explore neighbors\n        for action, (dr, dc) in move_deltas.items():\n            nr, nc = r + dr, c + dc\n            \n            # Check grid boundaries\n            if not (0 <= nr < grid_width and 0 <= nc < grid_height):\n                continue\n\n            # Avoid revisiting cells\n            if (nr, nc) in visited:\n                continue\n\n            # Obstacle check: For this completion, we assume all cells are traversable\n            # unless they are explicitly 'walls' or truly block movement.\n            # As a general rule for 'collect', we assume agent can walk over objects\n            # that are not target for 'USE'. For simplicity, no specific blocking check\n            # is done in BFS other than boundary. Environment's step will handle actual collisions.\n\n            visited.add((nr, nc))\n            q.append((nr, nc, path_so_far + [action]))\n            \n            # Prevent BFS from exploring excessively deep\n            if len(path_so_far) + 1 > max_total_actions:\n                # If adding this next step exceeds max actions, don't queue further\n                pass\n\n    if not best_path_actions:\n        return [] # No path found to the primitive\n\n    # Execute the found path\n    for action in best_path_actions:\n        if len(actions) >= max_total_actions:\n            return [] # Abort if action limit reached during execution\n        \n        _, _, obs = env.step(action)\n        actions.append(action)\n        \n        # Check inventory after each step, as grabbable items are collected by walking over them\n        current_inventory = obs['features_dict']['inventory']\n        if current_inventory[primitive] > 0:\n            return actions # Primitive collected\n\n    # If the primitive is non-grabbable, we need to perform the USE action after reaching the target vicinity\n    if not is_grabbable:\n        # Agent is now at the end of the calculated path. Get current state.\n        current_state = env._current_state # Access internal CraftState object\n\n        # Find the specific primitive object to face and USE\n        agent_r, agent_c = current_state.pos\n        target_to_face = None\n        \n        for pr, pc in target_locations:\n            if abs(agent_r - pr) + abs(agent_c - pc) == 1: # Find an adjacent primitive\n                target_to_face = (pr, pc)\n                break # Prioritize first found adjacent primitive\n\n        if target_to_face:\n            # Calculate direction needed to face the target\n            tr, tc = target_to_face\n            dr_to_target = tr - agent_r\n            dc_to_target = tc - agent_c\n\n            # Map (dr, dc) to agent's direction index (0:N, 1:E, 2:S, 3:W)\n            required_dir_map = {\n                (-1, 0): 0, # North (row -1, col 0)\n                (0, 1): 1,  # East (row 0, col +1)\n                (1, 0): 2,  # South (row +1, col 0)\n                (0, -1): 3, # West (row 0, col -1)\n            }\n            required_dir = required_dir_map.get((dr_to_target, dc_to_target), -1)\n\n            if required_dir != -1 and current_state.dir != required_dir:\n                # Calculate minimum turns (left or right)\n                current_dir = current_state.dir\n                turn_right_count = (required_dir - current_dir + 4) % 4\n                turn_left_count = (current_dir - required_dir + 4) % 4\n\n                if turn_left_count <= turn_right_count:\n                    for _ in range(turn_left_count):\n                        if len(actions) >= max_total_actions: return []\n                        _, _, _ = env.step(ACTION_LEFT)\n                        actions.append(ACTION_LEFT)\n                else:\n                    for _ in range(turn_right_count):\n                        if len(actions) >= max_total_actions: return []\n                        _, _, _ = env.step(ACTION_RIGHT)\n                        actions.append(ACTION_RIGHT)\n            \n            # After turning (if needed), perform the USE action\n            if len(actions) < max_total_actions:\n                _, _, obs = env.step(ACTION_USE)\n                actions.append(ACTION_USE)\n                current_inventory = obs['features_dict']['inventory']\n                if current_inventory[primitive] > 0:\n                    return actions # Primitive collected after USE\n\n    # Final check of inventory in case collection happened by some indirect means or edge case\n    obs = env.observations()\n    current_inventory = obs['features_dict']['inventory']\n    if current_inventory[primitive] > 0:\n        return actions # Collected, return the sequence of actions taken\n\n    return [] # Failed to collect the primitive after all attempts", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:53:07.573426", "function_name": "collect", "function_body": "    actions = []\n    \n    # Pre-define constants for clarity and access to env_factory actions\n    USE_ACTION = env_factory.ACTIONS['USE']\n    MOVE_FORWARD_ACTION = env_factory.ACTIONS['UP'] # Assuming 'UP' means move forward in current direction\n    TURN_LEFT_ACTION = env_factory.ACTIONS['LEFT']\n    TURN_RIGHT_ACTION = env_factory.ACTIONS['RIGHT']\n\n    # Relative coordinates for (dx, dy) for N, E, S, W directions based on CraftState.dir\n    # N: dir=0, (0, -1)\n    # E: dir=1, (1, 0)\n    # S: dir=2, (0, 1)\n    # W: dir=3, (-1, 0)\n    DIR_VECTORS = {\n        0: (0, -1),  # North\n        1: (1, 0),   # East\n        2: (0, 1),   # South\n        3: (-1, 0)   # West\n    }\n\n    # Helper to calculate actions needed to face a target (dx, dy) from current direction\n    def _get_actions_to_face(current_dir, target_rel_dx, target_rel_dy):\n        # Determine target cardinal direction based on relative (dx, dy)\n        target_cardinal_dir = -1\n        if target_rel_dx == 0 and target_rel_dy == -1: target_cardinal_dir = 0 # North\n        elif target_rel_dx == 1 and target_rel_dy == 0: target_cardinal_dir = 1 # East\n        elif target_rel_dx == 0 and target_rel_dy == 1: target_cardinal_dir = 2 # South\n        elif target_rel_dx == -1 and target_rel_dy == 0: target_cardinal_dir = 3 # West\n        \n        # This function is designed to only handle cardinal target directions.\n        # If it's a diagonal or (0,0) or non-unit vector, it should not happen if called correctly.\n        if target_cardinal_dir == -1: \n            return [] # Indicates an invalid target relative to agent for direct facing\n\n        if target_cardinal_dir == current_dir:\n            return [] # Already facing correctly\n\n        # Calculate turns needed (clockwise difference)\n        diff = (target_cardinal_dir - current_dir + 4) % 4 \n\n        if diff == 1: # 90 degrees right turn\n            return [TURN_RIGHT_ACTION]\n        elif diff == 2: # 180 degrees turn\n            return [TURN_RIGHT_ACTION, TURN_RIGHT_ACTION] # Or two left turns\n        elif diff == 3: # 90 degrees left turn\n            return [TURN_LEFT_ACTION]\n        return [] # Should be covered\n\n    # Max steps to prevent infinite loop during search\n    MAX_SEARCH_STEPS = 1000 \n    # Max depth for BFS pathfinding\n    BFS_MAX_DEPTH = 250\n\n    for step_count in range(MAX_SEARCH_STEPS):\n        current_state = env._current_state\n        current_pos = current_state.pos\n        current_dir = current_state.dir\n\n        # 1. Check if primitive is already collected\n        if current_state.inventory[primitive] > 0:\n            break # Goal achieved\n\n        WIDTH, HEIGHT, _ = current_state.grid.shape\n\n        # 2. Check if primitive is on the current cell or cardinally adjacent\n        # This logic handles using the primitive if it's within reach.\n        \n        # Check if primitive is on the current cell\n        if current_state.grid[current_pos[0], current_pos[1], primitive] > 0:\n            # Primitive is on the same cell as the agent. Try to USE.\n            # For collecting, USE typically picks up items on the current cell.\n            _, _, _ = env.step(USE_ACTION)\n            actions.append(USE_ACTION)\n            if env._current_state.inventory[primitive] > 0:\n                break # Collected\n            # If USE didn't work (e.g., not a direct pickup), continue search.\n\n        else: # Primitive not on current cell, check cardinal neighbors\n            found_cardinal_next_to = False\n            target_pos_for_use = None \n\n            # Iterate over cardinal directions (N, S, W, E)\n            for rdx, rdy in [(0, -1), (0, 1), (-1, 0), (1, 0)]: \n                nx, ny = current_pos[0] + rdx, current_pos[1] + rdy\n                \n                if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n                    if current_state.grid[nx, ny, primitive] > 0:\n                        found_cardinal_next_to = True\n                        target_pos_for_use = (nx, ny)\n                        break # Found a cardinal neighbor with the primitive\n            \n            if found_cardinal_next_to:\n                # Calculate relative direction from agent to the target\n                rel_dx = target_pos_for_use[0] - current_pos[0]\n                rel_dy = target_pos_for_use[1] - current_pos[1]\n\n                # Get actions to turn and face the primitive\n                turn_actions = _get_actions_to_face(current_dir, rel_dx, rel_dy) \n                \n                # Execute turn actions\n                for action in turn_actions:\n                    _, _, _ = env.step(action)\n                    actions.append(action)\n                    current_state = env._current_state # Update state after each turn\n                \n                # Now agent should be facing the primitive. Perform USE.\n                _, _, _ = env.step(USE_ACTION)\n                actions.append(USE_ACTION)\n                if env._current_state.inventory[primitive] > 0:\n                    break # Collected\n                # If USE didn't work, continue search.\n            else:\n                # 3. Primitive not immediately reachable. Search the global map using BFS.\n                obs = env.observations()\n                global_grid = obs['features_dict']['features_global']\n                \n                primitive_locations = np.argwhere(global_grid[:, :, primitive] > 0)\n\n                if len(primitive_locations) > 0:\n                    # Find the closest primitive (Manhattan distance for BFS efficiency)\n                    current_pos_np = np.array(current_pos)\n                    distances = np.sum(np.abs(primitive_locations - current_pos_np), axis=1) # Manhattan distance\n                    closest_idx = np.argmin(distances)\n                    target_nx, target_ny = primitive_locations[closest_idx]\n\n                    # BFS queue stores (position_x, position_y, direction, path_taken_actions)\n                    bfs_queue = [(current_pos[0], current_pos[1], current_dir, [])]\n                    # visited stores (x, y, dir) to avoid redundant states in BFS\n                    bfs_visited = {(current_pos[0], current_pos[1], current_dir)} \n                    \n                    path_to_target_from_bfs = None\n                    \n                    while bfs_queue and len(bfs_queue[0][3]) < BFS_MAX_DEPTH:\n                        curr_x, curr_y, curr_d, curr_path = bfs_queue.pop(0)\n\n                        # Check if current BFS node (position) is the target location\n                        if curr_x == target_nx and curr_y == target_ny:\n                            path_to_target_from_bfs = curr_path\n                            break\n                        \n                        # Explore possible actions (turns and move forward)\n                        \n                        # Turn LEFT\n                        next_d_left = (curr_d + 3) % 4 # (curr_d - 1 + 4) % 4\n                        if (curr_x, curr_y, next_d_left) not in bfs_visited:\n                            bfs_visited.add((curr_x, curr_y, next_d_left))\n                            bfs_queue.append((curr_x, curr_y, next_d_left, curr_path + [TURN_LEFT_ACTION]))\n                        \n                        # Turn RIGHT\n                        next_d_right = (curr_d + 1) % 4\n                        if (curr_x, curr_y, next_d_right) not in bfs_visited:\n                            bfs_visited.add((curr_x, curr_y, next_d_right))\n                            bfs_queue.append((curr_x, curr_y, next_d_right, curr_path + [TURN_RIGHT_ACTION]))\n                        \n                        # Move forward (UP action)\n                        forward_dx, forward_dy = DIR_VECTORS[curr_d]\n                        next_x, next_y = curr_x + forward_dx, curr_y + forward_dy\n                        \n                        # Check if the next position is within grid bounds\n                        if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT:\n                            # Assume all grid cells are traversable for simplicity.\n                            # The env.step will handle collision with non-passable objects if any.\n                            if (next_x, next_y, curr_d) not in bfs_visited:\n                                bfs_visited.add((next_x, next_y, curr_d))\n                                bfs_queue.append((next_x, next_y, curr_d, curr_path + [MOVE_FORWARD_ACTION]))\n\n                    if path_to_target_from_bfs:\n                        # Execute the found path\n                        for action in path_to_target_from_bfs:\n                            _, _, _ = env.step(action)\n                            actions.append(action)\n                            # Check if goal achieved after each step (e.g., if item was collected by walking over it)\n                            if env._current_state.inventory[primitive] > 0:\n                                return actions \n                        # After executing path, loop will re-evaluate if primitive is collected/reachable for USE\n                        continue \n                    else:\n                        # No path found to primitive within BFS_MAX_DEPTH or it's unreachable.\n                        # Fallback to simple systematic exploration: turn right, move forward.\n                        _, _, _ = env.step(TURN_RIGHT_ACTION)\n                        actions.append(TURN_RIGHT_ACTION)\n\n                        _, _, _ = env.step(MOVE_FORWARD_ACTION) # Move forward\n                        actions.append(MOVE_FORWARD_ACTION)\n                else:\n                    # Primitive not found anywhere on the global map (e.g., map is empty of this primitive).\n                    # Explore blindly in a simple pattern.\n                    _, _, _ = env.step(TURN_RIGHT_ACTION)\n                    actions.append(TURN_RIGHT_ACTION)\n\n                    _, _, _ = env.step(MOVE_FORWARD_ACTION) # Move forward\n                    actions.append(MOVE_FORWARD_ACTION)\n\n    return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:54:26.120242", "function_name": "collect", "function_body": "  _ACTIONS = [\"DOWN\", \"UP\", \"LEFT\", \"RIGHT\", \"USE\"]\n  DOWN, UP, LEFT, RIGHT, USE = range(len(_ACTIONS))\n\n  NORTH, EAST, SOUTH, WEST = 0, 1, 2, 3\n\n  _RELATIVE_POS_TO_DIR = {\n      (-1, 0): NORTH, # Item is North of agent\n      (1, 0): SOUTH,  # Item is South of agent\n      (0, -1): WEST,  # Item is West of agent\n      (0, 1): EAST    # Item is East of agent\n  }\n\n  _MOVE_OFFSETS = {\n      UP: (-1, 0),    # Move North\n      DOWN: (1, 0),   # Move South\n      LEFT: (0, -1),  # Move West\n      RIGHT: (0, 1)   # Move East\n  }\n\n  def _calculate_turns_to_face(current_dir, target_dir):\n      \"\"\"Calculates minimal turns (LEFT/RIGHT) to face target_dir from current_dir.\"\"\"\n      if current_dir == target_dir:\n          return []\n\n      cw_dist = (target_dir - current_dir + 4) % 4\n      ccw_dist = (current_dir - target_dir + 4) % 4\n\n      actions = []\n      if cw_dist <= ccw_dist: # Prioritize clockwise or equal\n          for _ in range(cw_dist):\n              actions.append(RIGHT)\n      else: # Counter-clockwise is shorter\n          for _ in range(ccw_dist):\n              actions.append(LEFT)\n      return actions\n\n  def _get_direction_from_relative_coords(r_offset, c_offset):\n      \"\"\"Returns the direction constant (N, E, S, W) for a given relative offset.\"\"\"\n      return _RELATIVE_POS_TO_DIR.get((r_offset, c_offset))\n\n  # Get initial state from the environment\n  current_state = env._current_state\n  world = env.world # For accessing grabbable/non-grabbable indices\n\n  # 1. Check if primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # 2. BFS to find path to a location adjacent to the primitive\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  grid_width, grid_height, _ = current_state.grid.shape\n\n  # Queue stores (current_pos, current_dir, path_actions_to_reach_this_state)\n  # path_actions here are only movements (UP/DOWN/LEFT/RIGHT). Turning will be added later.\n  q = collections.deque([(start_pos, start_dir, [])])\n  # Visited set stores (pos_r, pos_c, dir) to avoid cycles in the state space\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  target_found_path_prefix = None # Path of movements to reach the interaction position\n  final_agent_dir_at_target_pos = None # Agent's direction upon arriving at interaction position\n  target_item_direction = None # Direction agent needs to face to interact with item\n\n  while q:\n      curr_pos, curr_dir, path_actions = q.popleft()\n\n      # Check 3x3 neighborhood for the primitive to interact with it\n      for dr_adj in [-1, 0, 1]:\n          for dc_adj in [-1, 0, 1]:\n              if dr_adj == 0 and dc_adj == 0: # Skip current agent cell\n                  continue\n\n              adj_r, adj_c = curr_pos[0] + dr_adj, curr_pos[1] + dc_adj\n\n              # Check bounds for adjacent cell\n              if not (0 <= adj_r < grid_width and 0 <= adj_c < grid_height):\n                  continue\n\n              # Check if the adjacent cell contains the primitive\n              # Note: current_state.grid refers to the *initial* grid for the scenario.\n              # A more robust solution might use a mutable grid for pathfinding if items can be removed/added during search.\n              # However, for simply *finding* a primitive that's present in the initial grid, this is fine.\n              if current_state.grid[adj_r, adj_c, primitive] > 0:\n                  # Found the primitive in the neighborhood!\n                  # Ensure it's grabbable, as we need to collect it.\n                  if primitive in world.grabbable_indices:\n                      target_found_path_prefix = path_actions\n                      final_agent_dir_at_target_pos = curr_dir\n                      target_item_direction = _get_direction_from_relative_coords(dr_adj, dc_adj)\n                      q.clear() # Clear queue to stop BFS as a target is found\n                      break\n          if target_found_path_prefix is not None:\n              break\n      if target_found_path_prefix is not None:\n          break\n\n      # Explore movements from curr_pos\n      for move_action, (dr_move, dc_move) in _MOVE_OFFSETS.items():\n          next_pos = (curr_pos[0] + dr_move, curr_pos[1] + dc_move)\n\n          # Boundary check\n          if not (0 <= next_pos[0] < grid_width and 0 <= next_pos[1] < grid_height):\n              continue\n\n          # Obstacle check: cannot move into cells occupied by non-grabbable items\n          is_walkable = True\n          for kind_idx in world.non_grabbable_indices:\n              if current_state.grid[next_pos[0], next_pos[1], kind_idx] > 0:\n                  is_walkable = False\n                  break\n          if not is_walkable:\n              continue\n\n          # Agent's direction does not change when performing simple movements (UP, DOWN, LEFT, RIGHT)\n          next_dir = curr_dir\n          new_state_tuple = (next_pos[0], next_pos[1], next_dir)\n\n          if new_state_tuple not in visited:\n              visited.add(new_state_tuple)\n              q.append((next_pos, next_dir, path_actions + [move_action]))\n\n  # 3. Construct the final action sequence\n  final_actions = []\n  if target_found_path_prefix is not None:\n      # First, execute the path of movements to reach the interaction position\n      final_actions.extend(target_found_path_prefix)\n\n      # Then, turn to face the item\n      turns = _calculate_turns_to_face(final_agent_dir_at_target_pos, target_item_direction)\n      final_actions.extend(turns)\n\n      # Finally, use the item to collect it\n      final_actions.append(USE)\n\n  return final_actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:54:27.089270", "function_name": "collect", "function_body": "  # Get the mapping of action names to IDs\n  action_map = env.action_specs()\n\n  # Get the initial state from the CraftLab environment\n  initial_craft_state = env._current_state\n\n  # Check if the primitive is already in inventory\n  if initial_craft_state.inventory[primitive] > 0:\n    return []\n\n  # BFS Initialization\n  q = collections.deque()\n  q.append((initial_craft_state, []))  # (state, path_to_state)\n\n  # Visited set to avoid cycles and redundant computations\n  # A state is defined by (position, direction, inventory, grid data)\n  # Using .tobytes() for numpy arrays provides an efficient hashable representation.\n  visited = set()\n\n  # Check if the primitive is grabbable. The term \"collect\" implies it can be picked up.\n  # CraftWorld instance is available via env.world.\n  is_grabbable = primitive in env.world.grabbable_indices\n\n  while q:\n    current_state, current_path = q.popleft()\n\n    # Create a hashable representation of the current_state\n    state_hash = (current_state.pos, current_state.dir,\n                  current_state.inventory.tobytes(),\n                  current_state.grid.tobytes())\n\n    if state_hash in visited:\n      continue\n    visited.add(state_hash)\n\n    # Check if primitive is collected in the current state's inventory\n    if current_state.inventory[primitive] > 0:\n      return current_path\n\n    # Check if USE action is applicable and would lead to goal\n    # This check is performed before exploring movements, as picking up is the goal.\n    if is_grabbable and current_state.next_to(primitive):\n      # Simulate the USE action\n      # The step method returns (reward, new_state)\n      _, next_state_after_use = current_state.step(action_map[\"USE\"])\n\n      # If the USE action successfully collected the primitive\n      if next_state_after_use.inventory[primitive] > 0:\n        return current_path + [action_map[\"USE\"]]\n\n    # Explore movement actions\n    movement_actions = [\n        action_map[\"DOWN\"],\n        action_map[\"UP\"],\n        action_map[\"LEFT\"],\n        action_map[\"RIGHT\"]\n    ]\n\n    for action_id in movement_actions:\n      # Simulate the action to get the next state\n      _, next_state = current_state.step(action_id)\n\n      # Generate hash for the next state\n      next_state_hash = (next_state.pos, next_state.dir,\n                         next_state.inventory.tobytes(),\n                         next_state.grid.tobytes())\n\n      if next_state_hash not in visited:\n        q.append((next_state, current_path + [action_id]))\n\n  # If the BFS completes without finding a path, return an empty list\n  return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:56:26.264245", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants (from CraftLab.action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  actions_to_return = []\n  max_steps_for_bfs = 200 # A reasonable limit for pathfinding\n\n  # Get initial observations to analyze the current state\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  inventory = features_dict['inventory']\n\n  # 1. Check if primitive is already collected\n  if inventory[primitive] > 0:\n      return []\n\n  grid = features_dict['features_global']\n  norm_pos = features_dict['pos']\n  H, W, _ = grid.shape\n\n  # Convert normalized position to integer grid coordinates\n  # Using round for robustness against floating point inaccuracies, then cast to int.\n  agent_r = int(round(norm_pos[0] * (H - 1)))\n  agent_c = int(round(norm_pos[1] * (W - 1)))\n  start_pos = (agent_r, agent_c)\n\n  # Determine the type of primitive for collection logic\n  # `env.world` provides access to CraftWorld attributes like water_index, stone_index, grabbable_indices.\n  is_source_primitive = (primitive == env.world.water_index or primitive == env.world.stone_index)\n  # For other potential 'use' sources (like workshop), the problem description doesn't explicitly link them\n  # to 'collecting' a primitive, so we focus on water/stone for 'USE' action.\n\n  # BFS setup\n  q = collections.deque([(start_pos, [])]) # Queue stores (current_pos, path_actions_to_reach_current_pos)\n  visited = {start_pos}\n\n  # Movement deltas for (row, col) corresponding to actions\n  DELTAS = {\n      ACTION_UP: (-1, 0),\n      ACTION_DOWN: (1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1),\n  }\n\n  path_found = False\n  final_actions = []\n\n  while q and len(q) < max_steps_for_bfs: # Limit queue size to prevent excessive search\n      current_path_pos, current_path_actions = q.popleft()\n\n      # Check goal condition based on primitive type\n      if is_source_primitive:\n          # For source primitives (e.g., water, stone), the agent needs to be adjacent\n          # to the source and use the ACTION_USE.\n          # Check 3x3 neighborhood around current_path_pos for the primitive source.\n          found_source_adjacent = False\n          for dr_adj in [-1, 0, 1]:\n              for dc_adj in [-1, 0, 1]:\n                  target_r, target_c = current_path_pos[0] + dr_adj, current_path_pos[1] + dc_adj\n                  if 0 <= target_r < H and 0 <= target_c < W:\n                      if grid[target_r, target_c, primitive] > 0:\n                          found_source_adjacent = True\n                          break\n              if found_source_adjacent:\n                  break\n          \n          if found_source_adjacent:\n              final_actions = current_path_actions + [ACTION_USE]\n              path_found = True\n              break\n      else: # Assume it's a grabbable item (e.g., wood)\n          # For grabbable items, the agent just needs to move onto the same square.\n          if grid[current_path_pos[0], current_path_pos[1], primitive] > 0:\n              final_actions = current_path_actions\n              path_found = True\n              break\n\n      # If goal not reached, explore neighbors\n      for action, (dr, dc) in DELTAS.items():\n          next_r, next_c = current_path_pos[0] + dr, current_path_pos[1] + dc\n          next_pos = (next_r, next_c)\n\n          # Check bounds and if the position has been visited in this BFS\n          if 0 <= next_r < H and 0 <= next_c < W and next_pos not in visited:\n              # Assuming all grid cells are traversable unless specified otherwise.\n              # The problem description does not specify impassable terrain/kinds.\n              visited.add(next_pos)\n              q.append((next_pos, current_path_actions + [action]))\n\n  # Return the found path or empty list if no path/goal found within the search limit\n  return final_actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:56:27.226342", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:58:04.238015", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants (assuming these map to integers 0-4 as per DMLab-style)\n    ACTIONS = {'DOWN': 0, 'UP': 1, 'LEFT': 2, 'RIGHT': 3, 'USE': 4}\n    MOVE_DELTAS = {\n        ACTIONS['DOWN']: (0, 1),  # (dx, dy) where dx is change in x (col), dy is change in y (row)\n        ACTIONS['UP']: (0, -1),\n        ACTIONS['LEFT']: (-1, 0),\n        ACTIONS['RIGHT']: (1, 0)\n    }\n\n    current_state = env._current_state\n    inventory = current_state.inventory\n\n    # 1. Check if the primitive is already collected\n    if inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    start_pos = current_state.pos\n    width, height, _ = grid.shape\n\n    # Get indices of entities that block movement (non-traversable).\n    # Assuming `env.non_grabbable_indices` includes such entities like walls, water, etc.\n    blocking_indices = env.non_grabbable_indices \n\n    def is_valid_coord(x, y):\n        \"\"\"Checks if a coordinate is within the grid boundaries.\"\"\"\n        return 0 <= x < width and 0 <= y < height\n\n    def is_traversable(x, y, current_grid):\n        \"\"\"Checks if a cell is traversable (not blocked by non-grabbable items).\"\"\"\n        if not is_valid_coord(x, y):\n            return False\n        # A cell is traversable if it does not contain any blocking entity\n        for idx in blocking_indices:\n            if current_grid[x, y, idx] > 0:\n                return False\n        return True\n\n    # BFS state: (current_x, current_y, list_of_actions_to_reach_here)\n    q = collections.deque([(start_pos[0], start_pos[1], [])])\n    visited = set([(start_pos[0], start_pos[1])])\n\n    while q:\n        curr_x, curr_y, path_actions = q.popleft()\n\n        # Check if current position is adjacent to the target primitive\n        # We need to consider the 4 cardinal neighbors of the current cell.\n        # If any neighbor contains the primitive, then (curr_x, curr_y) is an adjacent cell.\n        for action_name, (dx, dy) in MOVE_DELTAS.items(): # Re-using deltas for checking neighbors\n            adj_x, adj_y = curr_x + dx, curr_y + dy\n            \n            if is_valid_coord(adj_x, adj_y) and grid[adj_x, adj_y, primitive] > 0:\n                # Found a path to a cell (curr_x, curr_y) that is adjacent to the primitive.\n                # The agent needs to move to (curr_x, curr_y) and then perform the USE action.\n                return path_actions + [ACTIONS['USE']]\n\n        # Explore possible next moves (UP, DOWN, LEFT, RIGHT)\n        for action_name, (move_dx, move_dy) in MOVE_DELTAS.items():\n            next_x, next_y = curr_x + move_dx, curr_y + move_dy\n            next_pos = (next_x, next_y)\n\n            if next_pos not in visited:\n                # Check if the next cell is traversable (not blocked).\n                if is_traversable(next_x, next_y, grid):\n                    visited.add(next_pos)\n                    q.append((next_x, next_y, path_actions + [action_name]))\n\n    # If the queue is exhausted and no path to an adjacent primitive was found\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:58:05.269363", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:59:27.482771", "function_name": "collect", "function_body": "  # Get action integer mappings from the environment's action specifications\n  action_specs = env.action_specs()\n  UP = action_specs['UP']\n  DOWN = action_specs['DOWN']\n  LEFT = action_specs['LEFT']\n  RIGHT = action_specs['RIGHT']\n  USE = action_specs['USE']\n\n  # Get the current state from the environment\n  # CraftLab stores the current state in _current_state\n  current_state = env._current_state \n  \n  grid = current_state.grid\n  initial_pos = current_state.pos # tuple (row, col)\n  \n  # Grid dimensions\n  height, width, _ = grid.shape\n\n  # Get obstacle indices (non-grabbable items that cannot be traversed)\n  # These are entities like water, stone, workshops that block movement.\n  obstacle_indices = current_state.world.non_grabbable_indices\n  \n  # BFS Queue: stores tuples of (row, col, path_actions)\n  # path_actions is a list of actions to reach (row, col) from initial_pos\n  q = collections.deque([(initial_pos[0], initial_pos[1], [])])\n  \n  # Visited set: stores tuples of (row, col) to prevent cycles and redundant exploration\n  visited = set([(initial_pos[0], initial_pos[1])])\n\n  # Define possible cardinal moves and their corresponding action integers\n  # These map an action to a (delta_row, delta_col)\n  move_actions_map = {\n      UP: (-1, 0),  # Move North (decreases row)\n      DOWN: (1, 0),   # Move South (increases row)\n      LEFT: (0, -1),  # Move West (decreases col)\n      RIGHT: (0, 1),  # Move East (increases col)\n  }\n\n  # Relative coordinates for checking the 3x3 neighborhood around the agent's current position\n  # This includes the agent's own cell (0,0) and its 8 direct neighbors.\n  # This corresponds to the check done by CraftState.next_to()\n  neighborhood_offsets = []\n  for dr_offset in [-1, 0, 1]:\n      for dc_offset in [-1, 0, 1]:\n          neighborhood_offsets.append((dr_offset, dc_offset))\n\n  # Perform Breadth-First Search\n  while q:\n      r, c, path_to_current_cell = q.popleft()\n\n      # Check if the primitive is in the 3x3 neighborhood of the current cell (r, c)\n      # If so, we are in a position to 'USE' and collect it.\n      can_use_primitive_here = False\n      for dr_offset, dc_offset in neighborhood_offsets:\n          # Calculate coordinates of the neighbor cell\n          nr_neighbor, nc_neighbor = r + dr_offset, c + dc_offset\n          \n          # Check if neighbor is within grid bounds\n          if 0 <= nr_neighbor < height and 0 <= nc_neighbor < width:\n              # Check if the primitive is present at this neighbor location\n              if grid[nr_neighbor, nc_neighbor, primitive] > 0:\n                  can_use_primitive_here = True\n                  break # Found the primitive in the neighborhood, no need to check further offsets\n\n      if can_use_primitive_here:\n          # If we can use the primitive from here, append the USE action and return the full path\n          return path_to_current_cell + [USE]\n\n      # Explore all possible movement actions from the current cell (r, c)\n      for action, (dr, dc) in move_actions_map.items():\n          nr, nc = r + dr, c + dc # Calculate new row and column after taking 'action'\n\n          # Check if the new cell (nr, nc) is within the grid boundaries\n          if not (0 <= nr < height and 0 <= nc < width):\n              continue\n\n          # Check if this cell has already been visited during the BFS\n          if (nr, nc) in visited:\n              continue\n\n          # Check for obstacles: Determine if the new cell (nr, nc) is blocked by any non-grabbable item.\n          # A cell is considered blocked if any obstacle_index item is present there.\n          is_blocked = False\n          for obstacle_idx in obstacle_indices:\n              if grid[nr, nc, obstacle_idx] > 0: \n                  is_blocked = True\n                  break\n          \n          if is_blocked:\n              continue # Cannot move to a blocked cell\n\n          # If the cell is valid (within bounds, not visited, not blocked), add it to the queue\n          # and mark it as visited for future reference.\n          visited.add((nr, nc))\n          q.append((nr, nc, path_to_current_cell + [action]))\n\n  # If the queue becomes empty and no path to the primitive was found, return an empty list.\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:59:28.503144", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants (corresponding to CraftLab's action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Mapping of movement actions to (dx, dy) changes in coordinates\n  # Assuming (x, y) where x is horizontal (width) and y is vertical (height)\n  ACTIONS_MOVE = {\n      DOWN: (0, 1),   # Move down: x stays, y increases\n      UP: (0, -1),    # Move up: x stays, y decreases\n      LEFT: (-1, 0),  # Move left: x decreases, y stays\n      RIGHT: (1, 0),  # Move right: x increases, y stays\n  }\n\n  state = env._current_state\n  primitive_idx = primitive\n  world = state.world\n  width, height, _ = state.grid.shape\n  \n  # 1. Check if the primitive is already in the inventory\n  if state.inventory[primitive_idx] > 0:\n      return [] # Already collected, no actions needed\n\n  # 2. Determine how this primitive can be collected\n  # Grabbable items are collected by moving onto their cell.\n  is_grabbable = primitive_idx in world.grabbable_indices\n  # 'Use' items require the agent to be adjacent to them and perform a USE action.\n  is_use_item = (primitive_idx in world.workshop_indices or\n                 primitive_idx == world.water_index or\n                 primitive_idx == world.stone_index)\n  \n  # If the item is neither grabbable nor a recognized 'use' item, it cannot be collected\n  # by these methods.\n  if not is_grabbable and not is_use_item:\n      return []\n\n  # 3. Use Breadth-First Search (BFS) to find the shortest sequence of actions\n  # Queue stores tuples of ((current_x, current_y), list_of_actions_so_far)\n  q = collections.deque([(state.pos, [])])\n  # Keep track of visited positions to avoid cycles and redundant paths, ensuring shortest path\n  visited = {state.pos} \n  \n  final_actions = []\n\n  while q:\n      (x, y), current_path = q.popleft()\n\n      # Check if the current position (x, y) satisfies the goal condition for collection\n\n      # Case A: Primitive is grabbable (e.g., wood, iron)\n      # The goal is to reach a cell that *contains* the primitive.\n      if is_grabbable and state.grid[x, y, primitive_idx] == 1:\n          final_actions = current_path\n          break # Path to the grabbable item found\n\n      # Case B: Primitive requires 'USE' action (e.g., workbench, water, stone)\n      # The goal is to reach a cell *adjacent* to the primitive.\n      if is_use_item:\n          # Check the 3x3 neighborhood around the current position (x,y)\n          found_primitive_nearby = False\n          for dx_adj in [-1, 0, 1]:\n              for dy_adj in [-1, 0, 1]:\n                  # Exclude the agent's current cell itself (dx_adj=0, dy_adj=0)\n                  if dx_adj == 0 and dy_adj == 0:\n                      continue \n                  \n                  nx_adj, ny_adj = x + dx_adj, y + dy_adj\n                  # Check if the neighbor cell is within grid bounds and contains the primitive\n                  if (0 <= nx_adj < width and 0 <= ny_adj < height and\n                          state.grid[nx_adj, ny_adj, primitive_idx] == 1):\n                      found_primitive_nearby = True\n                      break # Found a primitive in the neighborhood\n              if found_primitive_nearby:\n                  break # Found a primitive in the neighborhood\n          \n          if found_primitive_nearby:\n              final_actions = current_path + [USE] # Add USE action after moving to adjacent cell\n              break # Path to use-item's vicinity found\n\n      # If goal not met at current position, explore valid neighboring cells\n      for action_val, (dx, dy) in ACTIONS_MOVE.items():\n          nx, ny = x + dx, y + dy\n          \n          # Check if the neighbor is within grid boundaries and has not been visited yet\n          # Assuming all cells are traversable unless explicitly stated as obstacles elsewhere.\n          if (0 <= nx < width and 0 <= ny < height and\n              (nx, ny) not in visited):\n              visited.add((nx, ny))\n              q.append(((nx, ny), current_path + [action_val]))\n  \n  return final_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:00:55.893252", "function_name": "collect", "function_body": "  import collections\n  \n  actions_list = []\n  \n  # Get action mappings from the environment\n  action_specs = env.action_specs()\n\n  # Define movement deltas for each action\n  move_deltas = {\n      action_specs[\"UP\"]: (0, -1),\n      action_specs[\"DOWN\"]: (0, 1),\n      action_specs[\"LEFT\"]: (-1, 0),\n      action_specs[\"RIGHT\"]: (1, 0),\n  }\n  \n  current_state = env._current_state\n  grid = current_state.grid\n  agent_pos = current_state.pos\n  world = current_state.world # Access the CraftWorld instance for obstacle information\n  \n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Determine which kinds of entities make a cell unwalkable for pathfinding\n  # Unwalkable entities are non-grabbable items that are NOT workshops (assuming workshops can be walked upon).\n  unwalkable_kinds = {idx for idx in world.non_grabbable_indices if idx not in world.workshop_indices}\n\n  # Helper function to check if a cell is walkable\n  def is_walkable(x, y):\n      # Check bounds first\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return False\n\n      # Check if any unwalkable kind is present at (x, y)\n      # grid[x, y, kind_idx] > 0 indicates presence of kind_idx at (x, y)\n      for kind_idx in unwalkable_kinds:\n          if grid[x, y, kind_idx] > 0:\n              return False # This cell contains an unwalkable obstacle\n\n      return True # Cell is within bounds and doesn't contain explicit obstacles\n\n  # Find all locations of the primitive on the grid\n  # np.argwhere returns coordinates (x, y) where grid[:, :, primitive] > 0\n  primitive_locs = np.argwhere(grid[:, :, primitive] > 0)\n\n  if not primitive_locs.size:\n      # Primitive not found on the grid, return empty action list\n      return []\n\n  # Choose the closest primitive location using Manhattan distance for grid pathfinding\n  closest_primitive_loc = None\n  min_manhattan_dist = float('inf')\n  \n  for ploc_x, ploc_y in primitive_locs:\n      manhattan_dist = abs(ploc_x - agent_pos[0]) + abs(ploc_y - agent_pos[1])\n      if manhattan_dist < min_manhattan_dist:\n          min_manhattan_dist = manhattan_dist\n          closest_primitive_loc = (ploc_x, ploc_y)\n\n  if closest_primitive_loc is None:\n      # Should not happen if primitive_locs was not empty, but as a safeguard\n      return []\n\n  px, py = closest_primitive_loc\n  \n  # Find all valid adjacent positions to the chosen primitive location\n  # The agent needs to move to one of these positions to use the primitive.\n  target_adj_positions = []\n  for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Cardinal directions (Left, Right, Up, Down)\n      tx, ty = px + dx, py + dy\n      if is_walkable(tx, ty): # Use the defined walkability check\n          target_adj_positions.append((tx, ty))\n\n  if not target_adj_positions:\n      # No valid adjacent positions (e.g., primitive is completely surrounded by walls or other primitives)\n      return []\n\n  # Breadth-First Search (BFS) to find the shortest path from the agent's current position\n  # to any of the target adjacent positions.\n  q = collections.deque([(agent_pos, [])]) # Queue stores (current_position, list_of_actions_to_reach_here)\n  visited = {agent_pos} # Set of visited (x, y) tuples to avoid cycles\n\n  path_to_target = None # Stores the action sequence once a target is reached\n\n  while q:\n      (curr_x, curr_y), path_actions = q.popleft()\n\n      # Check if the current position is one of the desired target adjacent positions\n      if (curr_x, curr_y) in target_adj_positions:\n          path_to_target = path_actions\n          break # Path found, exit BFS\n\n      # Explore neighbors\n      for action_val, (dx, dy) in move_deltas.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # If the next position is walkable and has not been visited yet\n          if is_walkable(next_x, next_y) and next_pos not in visited:\n              visited.add(next_pos) # Mark as visited\n              q.append((next_pos, path_actions + [action_val])) # Add to queue with updated path\n\n  if path_to_target is None:\n      # No path found to any adjacent position (e.g., primitive is unreachable)\n      return []\n\n  # Extend the action list with the movement path\n  actions_list.extend(path_to_target)\n  # Finally, add the USE action to collect the primitive\n  actions_list.append(action_specs[\"USE\"])\n\n  return actions_list", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:00:55.963210", "function_name": "collect", "function_body": "    current_state = env._current_state\n\n    # 1. Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid_width, grid_height, _ = current_state.grid.shape\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # Helper to check if a cell is traversable\n    def is_traversable(r, c):\n        if not (0 <= r < grid_width and 0 <= c < grid_height):\n            return False  # Out of bounds\n\n        # Check if the cell contains any non-grabbable item (obstacle)\n        cell_contents = current_state.grid[r, c]\n        for idx in non_grabbable_indices:\n            if cell_contents[idx] > 0:\n                return False  # Contains a non-grabbable obstacle\n        return True\n\n    # 2. Find the primitive's position(s) on the grid\n    primitive_positions = []\n    for r in range(grid_width):\n        for c in range(grid_height):\n            if current_state.grid[r, c, primitive] > 0:\n                primitive_positions.append((r, c))\n\n    if not primitive_positions:\n        # Primitive not found on the grid\n        return []\n\n    # For simplicity, target the first found primitive.\n    target_primitive_pos = primitive_positions[0]\n\n    # Special case: If agent starts on the primitive's location, it can just USE.\n    if current_state.pos == target_primitive_pos:\n        return [env_factory.actions.USE]\n\n    # 3. BFS to find a path to a cell from which the primitive can be collected\n    # A cell is \"collectable\" if it's within the 3x3 neighborhood (including itself)\n    # of the target primitive. `CraftState.next_to` implicitly checks this.\n    # So the BFS goal is to reach any cell (r, c) such that max(|r-rp|, |c-cp|) <= 1\n\n    q = collections.deque([(current_state.pos, [])])  # (current_pos, list_of_actions)\n    visited = {current_state.pos}\n\n    # Action to (dr, dc) mapping for movement actions\n    action_to_delta = {\n        env_factory.actions.DOWN: (1, 0),\n        env_factory.actions.UP: (-1, 0),\n        env_factory.actions.LEFT: (0, -1),\n        env_factory.actions.RIGHT: (0, 1)\n    }\n\n    path_to_collect_pos = None\n\n    while q:\n        (r, c), path_actions = q.popleft()\n\n        # Check if current position is within 3x3 neighborhood of the target primitive\n        # (i.e., Manhattan distance of 0 or 1, or Chebychev distance of 0 or 1)\n        if max(abs(r - target_primitive_pos[0]), abs(c - target_primitive_pos[1])) <= 1:\n            path_to_collect_pos = path_actions\n            break  # Found a path to a suitable cell for collection\n\n        # Explore neighbors\n        for action, (dr, dc) in action_to_delta.items():\n            next_r, next_c = r + dr, c + dc\n            next_pos = (next_r, next_c)\n\n            if is_traversable(next_r, next_c) and next_pos not in visited:\n                visited.add(next_pos)\n                q.append((next_pos, path_actions + [action]))\n\n    if path_to_collect_pos is not None:\n        return path_to_collect_pos + [env_factory.actions.USE]\n    else:\n        # No path found to a suitable collection position\n        return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:02:29.315912", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:02:29.386087", "function_name": "collect", "function_body": "    from collections import deque\n    import numpy as np\n    import env_factory # Assumed to provide actions (UP, DOWN, LEFT, RIGHT, USE)\n\n    # 1. Get Initial State and Grid Information\n    # CraftLab exposes its internal CraftState via _current_state\n    current_state = env._current_state\n    current_grid = current_state.grid  # numpy.ndarray of shape (HEIGHT, WIDTH, n_kinds)\n    current_pos = current_state.pos    # tuple(int, int) (row, col)\n\n    HEIGHT, WIDTH, _ = current_grid.shape\n\n    # Define movement actions and their corresponding (dr, dc) deltas\n    move_actions = {\n        (-1, 0): env_factory.actions.UP,\n        (1, 0): env_factory.actions.DOWN,\n        (0, -1): env_factory.actions.LEFT,\n        (0, 1): env_factory.actions.RIGHT\n    }\n    dr_move = [-1, 1, 0, 0]  # Deltas for UP, DOWN, LEFT, RIGHT (rows)\n    dc_move = [0, 0, -1, 1]  # Deltas for UP, DOWN, LEFT, RIGHT (cols)\n\n    # Get non-grabbable indices from the world for traversability checks\n    # These are typically things like water or walls that block movement\n    non_grabbable_indices = current_state.world.non_grabbable_indices\n\n    # 2. Identify \"use_positions\"\n    # A \"use_position\" is any cell (r, c) from which the agent can successfully \"USE\" the primitive.\n    # The `CraftState.next_to` method checks the 3x3 neighborhood (including the agent's current cell).\n    # So, a use_position is any cell that is within the 3x3 neighborhood of a cell containing the primitive.\n    use_positions = set()\n\n    # Deltas for a 3x3 neighborhood (row, col)\n    dr_3x3 = [-1, -1, -1, 0, 0, 0, 1, 1, 1]\n    dc_3x3 = [-1, 0, 1, -1, 0, 1, -1, 0, 1]\n\n    for r in range(HEIGHT):\n        for c in range(WIDTH):\n            # If this cell contains the target primitive\n            if current_grid[r, c, primitive] > 0:\n                # Add all cells in its 3x3 neighborhood as potential use_positions\n                for i in range(len(dr_3x3)):\n                    ur, uc = r + dr_3x3[i], c + dc_3x3[i]\n                    # Check bounds for the potential use_position\n                    if 0 <= ur < HEIGHT and 0 <= uc < WIDTH:\n                        use_positions.add((ur, uc))\n\n    # If no primitive is found anywhere on the map, then there are no use_positions\n    # In this case, it's impossible to collect, so return an empty list of actions.\n    if not use_positions:\n        return []\n\n    # 3. BFS to find the shortest path to any `use_position`\n    q = deque([(current_pos, [])])  # Queue stores (current_position, path_taken_to_reach_here)\n    visited = {current_pos}         # Set to keep track of visited positions to avoid cycles and redundant paths\n    path_to_use_pos = None          # Stores the shortest path once found\n\n    while q:\n        curr_pos, path = q.popleft()\n\n        # If the current position is one of our target \"use_positions\"\n        if curr_pos in use_positions:\n            path_to_use_pos = path\n            break  # Found the shortest path, no need to explore further\n\n        # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n        for i in range(len(dr_move)):\n            next_r, next_c = curr_pos[0] + dr_move[i], curr_pos[1] + dc_move[i]\n            next_pos = (next_r, next_c)\n            action_to_take = move_actions[(dr_move[i], dc_move[i])]\n\n            # Check bounds: ensure next position is within the grid\n            if not (0 <= next_r < HEIGHT and 0 <= next_c < WIDTH):\n                continue\n\n            # Check if this position has already been visited (to find shortest path)\n            if next_pos in visited:\n                continue\n\n            # Check traversability: Agent cannot move onto cells containing non-grabbable items\n            # (e.g., water, walls, if they are considered non-traversable obstacles).\n            # Primitive items are grabbable, so they are not in `non_grabbable_indices`,\n            # meaning the agent can walk onto/over them.\n            is_blocked = False\n            for k_idx in non_grabbable_indices:\n                if current_grid[next_r, next_c, k_idx] > 0:\n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue # Skip this path if blocked\n\n            # If valid and unvisited, add to queue and mark as visited\n            visited.add(next_pos)\n            q.append((next_pos, path + [action_to_take]))\n\n    # 4. Handle Case: No Path Found\n    if path_to_use_pos is None:\n        return []  # Primitive is unreachable from the current position\n\n    # 5. Construct Final Action Sequence\n    # The path found by BFS brings the agent to a `use_position`.\n    # From there, a single USE action is needed to collect the primitive.\n    full_action_sequence = list(path_to_use_pos) # Convert tuple path to mutable list\n    full_action_sequence.append(env_factory.actions.USE)\n\n    return full_action_sequence", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:04:14.811633", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:04:14.881956", "function_name": "collect", "function_body": "    import collections\n\n    # Define action constants based on the problem description's action_specs\n    _ACTION_DOWN = 0\n    _ACTION_UP = 1\n    _ACTION_LEFT = 2\n    _ACTION_RIGHT = 3\n    _ACTION_USE = 4\n\n    # Define direction constants based on DMLab Craft convention\n    # These are typically 0: North, 1: East, 2: South, 3: West\n    _DIR_NORTH = 0\n    _DIR_EAST = 1\n    _DIR_SOUTH = 2\n    _DIR_WEST = 3\n\n    # Define direction vectors (dx, dy) for each direction\n    # These represent the change in (x, y) when facing a specific direction\n    _DIR_VECTORS = {\n        _DIR_NORTH: (0, -1),  # Facing North: x is same, y decreases\n        _DIR_EAST: (1, 0),    # Facing East: x increases, y is same\n        _DIR_SOUTH: (0, 1),   # Facing South: x is same, y increases\n        _DIR_WEST: (-1, 0),   # Facing West: x decreases, y is same\n    }\n\n    # Define mapping from action to (dx, dy, new_dir) relative to grid coordinates\n    # This assumes movement actions instantly align the agent's direction with the move.\n    _ACTION_EFFECTS = {\n        _ACTION_UP: (0, -1, _DIR_NORTH),\n        _ACTION_DOWN: (0, 1, _DIR_SOUTH),\n        _ACTION_LEFT: (-1, 0, _DIR_WEST),\n        _ACTION_RIGHT: (1, 0, _DIR_EAST),\n    }\n\n    current_state = env._current_state\n    world = current_state.world\n    grid = current_state.grid\n    width, height, n_kinds = grid.shape\n\n    # 1. Check if the primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected\n\n    primitive_locations = []\n    # 2. Find all locations where the primitive exists on the grid\n    for x in range(width):\n        for y in range(height):\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the map\n\n    # 3. Identify potential target (approach) cells for BFS\n    # An approach cell is a traversable cell adjacent to a primitive location.\n    # We also determine the required direction the agent must face from this approach cell to \"USE\" the primitive.\n    final_targets = set() # Stores tuples: (approach_x, approach_y, dir_to_face_primitive)\n    for px, py in primitive_locations:\n        # For each primitive location, consider its 4 adjacent cells as potential approach points\n        for d_target_dir, (tdx, tdy) in _DIR_VECTORS.items():\n            # Calculate the approach cell (ax, ay) such that moving FROM (ax, ay)\n            # IN d_target_dir would lead to (px, py).\n            # So, (ax, ay) is (px - tdx, py - tdy).\n            ax, ay = px - tdx, py - tdy\n\n            # Check if the calculated approach cell is within grid boundaries\n            if 0 <= ax < width and 0 <= ay < height:\n                # Check if the approach cell (ax, ay) is an obstacle\n                # A cell is an obstacle if it contains any kind listed in world.non_grabbable_indices\n                is_obstacle = False\n                for k_idx in world.non_grabbable_indices:\n                    if grid[ax, ay, k_idx] > 0: # If this non-grabbable item is present\n                        is_obstacle = True\n                        break\n                \n                if not is_obstacle:\n                    # Add this valid target state: (position, required_direction_at_position)\n                    final_targets.add((ax, ay, d_target_dir))\n    \n    if not final_targets: \n        return [] # No reachable approach cells (e.g., primitive is surrounded by obstacles)\n\n    # 4. Perform BFS to find the shortest sequence of actions to reach any final_target state\n    queue = collections.deque()\n    visited = set() # Stores (x, y, dir) tuples to avoid revisiting states\n\n    start_pos = current_state.pos\n    start_dir = current_state.dir\n\n    # Initial state: (current_x, current_y, current_dir, list_of_actions_taken_so_far)\n    queue.append((start_pos[0], start_pos[1], start_dir, [])) \n    visited.add((start_pos[0], start_pos[1], start_dir))\n\n    best_path = None\n\n    while queue:\n        cx, cy, c_dir, path = queue.popleft()\n\n        # Check if the current state (position and direction) matches any of the target states\n        if (cx, cy, c_dir) in final_targets:\n            # Found a path to an approach cell with the correct orientation.\n            # Append the USE action to collect the primitive.\n            best_path = path + [_ACTION_USE]\n            break\n\n        # Explore possible movement actions from the current state\n        for action, (dx, dy, new_dir) in _ACTION_EFFECTS.items():\n            nx, ny = cx + dx, cy + dy # Calculate new position after action\n\n            # Check if new position is within grid boundaries\n            if 0 <= nx < width and 0 <= ny < height:\n                # Check if the new cell (nx, ny) is an obstacle\n                is_obstacle = False\n                for k_idx in world.non_grabbable_indices:\n                    if grid[nx, ny, k_idx] > 0:\n                        is_obstacle = True\n                        break\n\n                if not is_obstacle:\n                    # If the new state (position and direction) has not been visited\n                    if (nx, ny, new_dir) not in visited:\n                        visited.add((nx, ny, new_dir))\n                        queue.append((nx, ny, new_dir, path + [action]))\n\n    return best_path if best_path is not None else []", "island_id": 0, "scores": {"3": -1}}
