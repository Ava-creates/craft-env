{"timestamp": "2025-07-30T23:00:37.238514", "function_name": "collect", "function_body": "  import numpy as np\n  import collections\n\n  # Define constants for actions used in CraftLab.\n  MOVE_BACKWARD_ACTION = 0 # Moves agent one step backward relative to its current facing direction.\n  MOVE_FORWARD_ACTION = 1  # Moves agent one step forward relative to its current facing direction.\n  TURN_LEFT_ACTION = 2     # Turns agent 90 degrees left (counter-clockwise).\n  TURN_RIGHT_ACTION = 3    # Turns agent 90 degrees right (clockwise).\n  USE_ACTION = 4           # Interacts with the cell in front of the agent (e.g., collect, craft).\n\n  # Define constants for the agent's facing directions (0-3).\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Mapping agent's facing direction to (dx, dy) coordinate deltas for forward movement.\n  # (dx, dy) represents change in (column, row) or (x, y).\n  _DIR_TO_DELTA = {\n      NORTH_DIR: (0, -1),  # Moving North: x stays, y decreases\n      EAST_DIR: (1, 0),    # Moving East: x increases, y stays\n      SOUTH_DIR: (0, 1),   # Moving South: x stays, y increases\n      WEST_DIR: (-1, 0),   # Moving West: x decreases, y stays\n  }\n\n  # Get the integer ID for the target primitive from the cookbook.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state details from the environment.\n  current_state = env._current_state\n  agent_grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos # Agent's current (column, row) position.\n  agent_dir = current_state.dir             # Agent's current facing direction (0-3).\n\n  # Get grid dimensions.\n  grid_height, grid_width, _ = agent_grid.shape\n\n  # Define indices of entities that the agent cannot move onto (obstacles).\n  # This includes non-grabbable items, workshop locations, and the primitive itself.\n  movement_obstacle_indices = set()\n  movement_obstacle_indices.update(env.world.non_grabbable_indices)\n  movement_obstacle_indices.update(env.world.workshop_indices)\n  movement_obstacle_indices.add(primitive_id) # The agent cannot occupy the same cell as the primitive.\n\n  def is_traversable_for_movement(x, y):\n    \"\"\"\n    Checks if a given grid cell (x, y) is within grid bounds and is not occupied by any obstacle.\n    \"\"\"\n    # Check if coordinates are within the grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check if the cell is occupied by any defined obstacle.\n    # A cell is blocked if any of its channels corresponding to an obstacle index is 1.\n    for kind_idx in movement_obstacle_indices:\n      if agent_grid[y, x, kind_idx] == 1: # Assuming 1 indicates presence of the item.\n        return False\n    return True # Cell is traversable.\n\n  # Step 1: Find all actual locations of the primitive on the grid.\n  # np.where returns (row_indices, col_indices), which correspond to (y_coords, x_coords).\n  y_coords, x_coords = np.where(agent_grid[:, :, primitive_id] == 1)\n  primitive_locations = set() # Stores (x, y) tuples for each primitive instance.\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n  \n  if not primitive_locations:\n    # If the primitive is not found anywhere on the grid, no actions can collect it.\n    return []\n\n  # Step 2: Define the set of 'target' states for the BFS.\n  # A target state is (agent_x, agent_y, agent_dir) from which the agent can perform USE_ACTION\n  # to collect the primitive. This means (agent_x, agent_y) must be adjacent to a primitive\n  # and agent_dir must be facing that primitive.\n  target_bfs_states = set()\n\n  # Deltas for checking cardinal neighbors (used for adjacency).\n  ADJACENCY_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # (dx, dy): West, East, North, South\n\n  for px, py in primitive_locations: # For each instance of the primitive...\n    for dx_adj, dy_adj in ADJACENCY_DELTAS: # ...check its four cardinal neighbors.\n      adj_x, adj_y = px + dx_adj, py + dy_adj # A potential adjacent cell for the agent.\n\n      # Check if this adjacent cell is a valid traversable position for the agent.\n      if is_traversable_for_movement(adj_x, adj_y):\n        # Calculate the required facing direction from (adj_x, adj_y) towards (px, py).\n        # This is the direction the agent needs to face to 'USE' the primitive.\n        delta_x_to_item = px - adj_x\n        delta_y_to_item = py - adj_y\n\n        target_face_dir = None\n        if delta_x_to_item == 1 and delta_y_to_item == 0:  # Item is to the East of agent\n            target_face_dir = EAST_DIR\n        elif delta_x_to_item == -1 and delta_y_to_item == 0: # Item is to the West of agent\n            target_face_dir = WEST_DIR\n        elif delta_x_to_item == 0 and delta_y_to_item == 1:  # Item is to the South of agent\n            target_face_dir = SOUTH_DIR\n        elif delta_x_to_item == 0 and delta_y_to_item == -1: # Item is to the North of agent\n            target_face_dir = NORTH_DIR\n        \n        if target_face_dir is not None:\n          # Add this valid agent state (position, direction) to the set of BFS targets.\n          target_bfs_states.add((adj_x, adj_y, target_face_dir))\n\n  if not target_bfs_states:\n    # If no valid adjacent-and-facing states exist (e.g., primitive is fully enclosed by obstacles),\n    # then collection is impossible.\n    return []\n\n  # Step 3: Perform Breadth-First Search (BFS) to find the shortest action sequence\n  # from the agent's initial state to any of the `target_bfs_states`.\n  \n  # The state in the BFS queue is (current_x, current_y, current_dir, list_of_actions_taken_to_reach_here).\n  queue = collections.deque([(agent_pos_x, agent_pos_y, agent_dir, [])])\n  \n  # The visited set stores (x, y, dir) tuples to avoid redundant exploration and cycles.\n  visited = set([(agent_pos_x, agent_pos_y, agent_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, current_path = queue.popleft()\n\n    # Check if the current agent state (position and direction) is one of our target states.\n    if (curr_x, curr_y, curr_dir) in target_bfs_states:\n      # If so, we've found the shortest path. Append the USE_ACTION and return.\n      return current_path + [USE_ACTION] \n\n    # Explore all possible next states by applying each of the 5 actions.\n\n    # 1. Try MOVE_FORWARD_ACTION\n    dx_fwd, dy_fwd = _DIR_TO_DELTA[curr_dir] # Calculate displacement based on current direction.\n    next_x_fwd, next_y_fwd = curr_x + dx_fwd, curr_y + dy_fwd\n    next_dir_fwd = curr_dir # Direction doesn't change during movement.\n    \n    # Check if the next cell is traversable and if this state hasn't been visited yet.\n    if is_traversable_for_movement(next_x_fwd, next_y_fwd):\n      if (next_x_fwd, next_y_fwd, next_dir_fwd) not in visited:\n        visited.add((next_x_fwd, next_y_fwd, next_dir_fwd))\n        queue.append((next_x_fwd, next_y_fwd, next_dir_fwd, current_path + [MOVE_FORWARD_ACTION]))\n\n    # 2. Try MOVE_BACKWARD_ACTION\n    # To move backward, use the delta for the opposite direction.\n    dx_bwd, dy_bwd = _DIR_TO_DELTA[(curr_dir + 2) % 4] \n    next_x_bwd, next_y_bwd = curr_x + dx_bwd, curr_y + dy_bwd\n    next_dir_bwd = curr_dir # Direction doesn't change during movement.\n\n    if is_traversable_for_movement(next_x_bwd, next_y_bwd):\n      if (next_x_bwd, next_y_bwd, next_dir_bwd) not in visited:\n        visited.add((next_x_bwd, next_y_bwd, next_dir_bwd))\n        queue.append((next_x_bwd, next_y_bwd, next_dir_bwd, current_path + [MOVE_BACKWARD_ACTION]))\n\n    # 3. Try TURN_LEFT_ACTION\n    next_dir_left = (curr_dir - 1 + 4) % 4 # Turn 90 degrees counter-clockwise (ensure positive result).\n    # Position (x, y) remains unchanged during a turn.\n    if (curr_x, curr_y, next_dir_left) not in visited:\n      visited.add((curr_x, curr_y, next_dir_left))\n      queue.append((curr_x, curr_y, next_dir_left, current_path + [TURN_LEFT_ACTION]))\n\n    # 4. Try TURN_RIGHT_ACTION\n    next_dir_right = (curr_dir + 1) % 4 # Turn 90 degrees clockwise.\n    # Position (x, y) remains unchanged during a turn.\n    if (curr_x, curr_y, next_dir_right) not in visited:\n      visited.add((curr_x, curr_y, next_dir_right))\n      queue.append((curr_x, curr_y, next_dir_right, current_path + [TURN_RIGHT_ACTION]))\n      \n  # If the queue becomes empty and no path to a target state was found,\n  # it means the primitive is unreachable.\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T23:00:38.282473", "function_name": "collect", "function_body": "  import numpy as np\n  import collections\n\n  # Define constants for actions and directions, as used by CraftLab/CraftState\n  # These map directly to the integer action IDs (0, 1, 2, 3, 4) in CraftLab.\n  MOVE_BACKWARD_ACTION = 0 # Corresponds to DMLab's \"DOWN\"\n  MOVE_FORWARD_ACTION = 1  # Corresponds to DMLab's \"UP\"\n  TURN_LEFT_ACTION = 2     # Corresponds to DMLab's \"LEFT\"\n  TURN_RIGHT_ACTION = 3    # Corresponds to DMLab's \"RIGHT\"\n  USE_ACTION = 4\n\n  # Agent's facing directions (integers 0-3, typically NORTH=0, EAST=1, SOUTH=2, WEST=3)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Mapping agent's facing directions to (dx, dy) grid movement deltas.\n  # CraftWorld grids are typically (height, width, kinds) -> (y, x, kinds).\n  # (dx, dy) represents (change in X-coordinate, change in Y-coordinate).\n  _DIR_TO_DELTA = {\n      NORTH_DIR: (0, -1),  # Moving North: x same, y decreases\n      EAST_DIR: (1, 0),    # Moving East: x increases, y same\n      SOUTH_DIR: (0, 1),   # Moving South: x same, y increases\n      WEST_DIR: (-1, 0),   # Moving West: x decreases, y same\n  }\n\n  # Deltas for checking cardinal neighbors (used for finding adjacent cells).\n  CARDINAL_ADJACENCY_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # West, East, North, South\n\n\n  # --- Helper Function for Traversability ---\n  def _is_traversable(x, y, grid_data, grid_width, grid_height, obstacles_set):\n    \"\"\"\n    Checks if a given grid cell (x, y) is within bounds and is traversable\n    (i.e., not occupied by any specified obstacle kind).\n\n    Args:\n      x (int): X-coordinate (column) of the cell.\n      y (int): Y-coordinate (row) of the cell.\n      grid_data (np.ndarray): The current grid state, typically 3D (height, width, kinds).\n      grid_width (int): The width of the grid.\n      grid_height (int): The height of the grid.\n      obstacles_set (set): A set of integer kind IDs that represent impassable entities.\n\n    Returns:\n      bool: True if the cell is traversable, False otherwise.\n    \"\"\"\n    # Check grid boundaries first\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell is occupied by any specified obstacle kind.\n    # Assumes grid_data[y, x, kind_idx] == 1 indicates presence.\n    for kind_idx in obstacles_set:\n      if grid_data[y, x, kind_idx] == 1:\n        return False\n    return True # Cell is traversable\n\n\n  # --- Main collect_v2 Function Logic ---\n  \n  # 1. Get necessary information from the environment state.\n  try:\n    # Convert primitive name (string) to its integer ID using the cookbook index.\n    primitive_kind_id = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized by the cookbook, it cannot be collected.\n    return []\n\n  current_state = env._current_state\n  agent_grid = current_state.grid\n  agent_start_pos_x, agent_start_pos_y = current_state.pos\n  agent_start_dir = current_state.dir # Agent's initial facing direction\n\n  grid_height, grid_width, _ = agent_grid.shape\n\n  # Define the set of entities that block agent movement.\n  # This includes non-grabbable items, workshop locations, and the primitive itself\n  # (the agent cannot move onto the primitive's square, only next to it).\n  movement_obstacle_indices = set()\n  movement_obstacle_indices.update(env.world.non_grabbable_indices)\n  movement_obstacle_indices.update(env.world.workshop_indices)\n  movement_obstacle_indices.add(primitive_kind_id) # Agent cannot step on the item it wants to collect\n\n  # 2. Find all current locations of the target primitive on the grid.\n  primitive_locations = set() # Stores (x, y) coordinates for all instances of the primitive.\n  # np.where returns (row_indices, col_indices), which correspond to (y_coords, x_coords).\n  y_coords, x_coords = np.where(agent_grid[:, :, primitive_kind_id] == 1)\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n  \n  if not primitive_locations:\n    # If no instances of the primitive are found on the grid, it's unreachable.\n    return []\n\n  # 3. Determine all valid \"target\" states for BFS.\n  # A target state is defined by (agent_x, agent_y, agent_dir) from which\n  # a single USE_ACTION can successfully collect a primitive. This means:\n  # - (agent_x, agent_y) must be an empty, traversable cell adjacent to a primitive.\n  # - agent_dir must be facing that specific primitive instance.\n  target_bfs_states = set() # Stores (x, y, direction) tuples.\n\n  for item_x, item_y in primitive_locations: # Iterate through each primitive instance\n    for dx_adj, dy_adj in CARDINAL_ADJACENCY_DELTAS: # Check cells cardinally adjacent to the primitive\n      # Calculate the potential adjacent cell (agent's position)\n      agent_adj_x, agent_adj_y = item_x + dx_adj, item_y + dy_adj \n\n      # Only consider adjacent cells that are traversable for the agent's movement.\n      if _is_traversable(agent_adj_x, agent_adj_y, agent_grid, grid_width, grid_height, movement_obstacle_indices):\n        \n        # Calculate the required facing direction from the agent's adjacent position\n        # to the primitive's position.\n        delta_x_to_item = item_x - agent_adj_x\n        delta_y_to_item = item_y - agent_adj_y\n\n        required_face_dir = None\n        if delta_x_to_item == 1 and delta_y_to_item == 0:  # Item is to the agent's East\n            required_face_dir = EAST_DIR\n        elif delta_x_to_item == -1 and delta_y_to_item == 0: # Item is to the agent's West\n            required_face_dir = WEST_DIR\n        elif delta_x_to_item == 0 and delta_y_to_item == 1:  # Item is to the agent's South\n            required_face_dir = SOUTH_DIR\n        elif delta_x_to_item == 0 and delta_y_to_item == -1: # Item is to the agent's North\n            required_face_dir = NORTH_DIR\n        \n        if required_face_dir is not None:\n          # This (agent_x, agent_y, required_face_dir) tuple represents a valid state\n          # from which the agent can perform a USE_ACTION to collect the primitive.\n          target_bfs_states.add((agent_adj_x, agent_adj_y, required_face_dir))\n\n  if not target_bfs_states:\n    # If no valid collection points exist (e.g., all primitives are completely surrounded by obstacles),\n    # then the primitive cannot be collected.\n    return []\n\n  # 4. Perform Breadth-First Search (BFS) to find the shortest path to any target state.\n  # The state in BFS is (current_x, current_y, current_dir).\n  # Each element in the queue stores: (x, y, direction, list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([(agent_start_pos_x, agent_start_pos_y, agent_start_dir, [])])\n  # The visited set stores (x, y, direction) tuples to prevent revisiting states and cycles.\n  visited = set([(agent_start_pos_x, agent_start_pos_y, agent_start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, current_path = queue.popleft()\n\n    # Check if the current state (position and direction) is one of our target collection states.\n    if (curr_x, curr_y, curr_dir) in target_bfs_states:\n      # If so, we've found the shortest path. Append the USE_ACTION and return the path.\n      return current_path + [USE_ACTION] \n\n    # Explore all possible next states by applying each of the four movement/turning actions:\n    \n    # 1. Try MOVE_FORWARD_ACTION\n    fwd_dx, fwd_dy = _DIR_TO_DELTA[curr_dir] # Delta based on current facing direction\n    next_x_fwd, next_y_fwd = curr_x + fwd_dx, curr_y + fwd_dy\n    next_dir_fwd = curr_dir # Facing direction does not change with linear movement\n\n    if _is_traversable(next_x_fwd, next_y_fwd, agent_grid, grid_width, grid_height, movement_obstacle_indices):\n      if (next_x_fwd, next_y_fwd, next_dir_fwd) not in visited:\n        visited.add((next_x_fwd, next_y_fwd, next_dir_fwd))\n        queue.append((next_x_fwd, next_y_fwd, next_dir_fwd, current_path + [MOVE_FORWARD_ACTION]))\n\n    # 2. Try MOVE_BACKWARD_ACTION\n    # Moving backward is equivalent to moving forward in the opposite direction.\n    bwd_dx, bwd_dy = _DIR_TO_DELTA[(curr_dir + 2) % 4] # Opposite direction's delta\n    next_x_bwd, next_y_bwd = curr_x + bwd_dx, curr_y + bwd_dy\n    next_dir_bwd = curr_dir # Facing direction does not change with linear movement\n\n    if _is_traversable(next_x_bwd, next_y_bwd, agent_grid, grid_width, grid_height, movement_obstacle_indices):\n      if (next_x_bwd, next_y_bwd, next_dir_bwd) not in visited:\n        visited.add((next_x_bwd, next_y_bwd, next_dir_bwd))\n        queue.append((next_x_bwd, next_y_bwd, next_dir_bwd, current_path + [MOVE_BACKWARD_ACTION]))\n\n    # 3. Try TURN_LEFT_ACTION\n    next_dir_left = (curr_dir - 1 + 4) % 4 # Calculate new direction after a 90-degree counter-clockwise turn\n    # Position remains unchanged during a turn.\n    if (curr_x, curr_y, next_dir_left) not in visited:\n      visited.add((curr_x, curr_y, next_dir_left))\n      queue.append((curr_x, curr_y, next_dir_left, current_path + [TURN_LEFT_ACTION]))\n\n    # 4. Try TURN_RIGHT_ACTION\n    next_dir_right = (curr_dir + 1) % 4 # Calculate new direction after a 90-degree clockwise turn\n    # Position remains unchanged during a turn.\n    if (curr_x, curr_y, next_dir_right) not in visited:\n      visited.add((curr_x, curr_y, next_dir_right))\n      queue.append((curr_x, curr_y, next_dir_right, current_path + [TURN_RIGHT_ACTION]))\n      \n  # If the queue becomes empty and no path to a target state was found, the primitive is unreachable.\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T23:02:09.446864", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  # Agent directions. This mapping is assumed based on collect_v1's internal logic\n  # and how it relates actions to resulting directions and position changes.\n  # 0 = East, 1 = South, 2 = West, 3 = North.\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction to collect that target via ACTION_USE.\n  # This implies ACTION_USE only works on cardinally adjacent cells when facing them.\n  RELATIVE_TO_REQUIRED_DIR = {\n      (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n      (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n      (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n      (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  # This acts as a safeguard against infinite loops in complex or unsolvable scenarios.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent given its position and direction.\n  def _get_cell_in_front(pos, direction):\n      y, x = pos\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return None # Should not be reached with valid directions\n\n  # Breadth-First Search (BFS) to find a path to the primitive.\n  # The BFS aims to find a sequence of movement actions that places the agent\n  # at a position AND orientation suitable for collecting the target primitive.\n  def _find_path_and_orientation_for_collection(start_pos, start_dir, initial_grid, primitive_id, world, max_steps):\n      grid_height, grid_width, _ = initial_grid.shape\n      \n      # Determine truly impassable kinds for agent movement, refining collect_v1's logic.\n      # Start with all non-grabbable items.\n      impassable_for_movement = set(world.non_grabbable_indices)\n      # Workshops are non-grabbable but typically traversable; remove them from impassable.\n      impassable_for_movement.difference_update(world.workshop_indices)\n      # Water (if defined and present) is often an impassable entity for movement.\n      if world.water_index in world.kinds:\n          impassable_for_movement.add(world.water_index)\n\n      # BFS state: (current_y, current_x, current_dir, path_of_actions_so_far)\n      q = collections.deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set: (y, x, dir) to prevent revisiting the same state (position + orientation),\n      # avoiding cycles and redundant computation. Orientation is crucial as ACTION_USE depends on it.\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n      # Assuming that performing a movement action (like ACTION_UP) also reorients the agent\n      # to face the direction of movement (e.g., facing North after moving UP).\n      moves_options = [\n          (-1, 0, Action.UP, DIR_NORTH),\n          (1, 0, Action.DOWN, DIR_SOUTH),\n          (0, -1, Action.LEFT, DIR_WEST),\n          (0, 1, Action.RIGHT, DIR_EAST)\n      ]\n\n      while q:\n          curr_y, curr_x, curr_dir, path_actions = q.popleft()\n          \n          # Prune search early if the current path length (plus a necessary final USE action)\n          # would exceed the maximum allowed steps. We reserve at least one step for ACTION_USE.\n          if len(path_actions) >= max_steps - 1:\n              continue\n\n          # Check if the primitive is cardinally adjacent to the current cell AND\n          # the agent is currently oriented to face it.\n          for rel_dy, rel_dx in RELATIVE_TO_REQUIRED_DIR.keys():\n              adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n              # Check bounds and if the adjacent cell contains the primitive based on the initial grid.\n              if (0 <= adj_y < grid_height and 0 <= adj_x < grid_width and\n                      initial_grid[adj_y, adj_x, primitive_id] > 0):\n                  \n                  # Primitive found at (adj_y, adj_x). Now, check if agent is facing it correctly.\n                  required_dir_for_collection = RELATIVE_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n                  if curr_dir == required_dir_for_collection:\n                      # A valid path to a collecting state has been found.\n                      # BFS guarantees this is the shortest path in terms of actions.\n                      # Ensure the total path (moves + USE) doesn't exceed max_steps.\n                      if len(path_actions) + 1 <= max_steps:\n                          return path_actions # Return only the movement actions; USE will be appended later.\n\n          # Explore neighboring cells by applying movement actions.\n          for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n              # Check if the proposed next position is within the grid boundaries.\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if the proposed next cell is traversable (does not contain any impassable kinds).\n              is_traversable_for_movement = True\n              for k_idx in impassable_for_movement:\n                  if initial_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable_for_movement = False\n                      break\n              if not is_traversable_for_movement:\n                  continue\n              \n              # Add the new, valid state to the queue only if it hasn't been visited before.\n              if (next_y, next_x, new_dir_after_move) not in visited:\n                  visited.add((next_y, next_x, new_dir_after_move))\n                  q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n      return None # No path found to the primitive with correct orientation within the step limits.\n\n  actions_taken = [] # List to store the sequence of actions to be returned.\n  \n  # 1. Initialize environment state and perform preliminary checks.\n  # Reset the environment to ensure a fresh start and retrieve the initial CraftState.\n  _ = env.reset() \n  current_state = env._current_state # Direct access to the current CraftState instance.\n\n  # Verify the primitive is a recognized kind in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      return [] # Unknown primitive, cannot collect.\n\n  # Check if the primitive is already present in the agent's inventory.\n  if current_state.inventory[primitive] > 0:\n      return [] # Primitive already collected, no actions needed.\n\n  # Obtain the initial grid snapshot, agent's position, and direction for pathfinding.\n  initial_grid = current_state.features_dict()['features_global']\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  grid_height, grid_width, _ = initial_grid.shape # Get grid dimensions for boundary checks.\n\n  # 2. Find the sequence of movements required to reach the primitive.\n  path_of_moves = _find_path_and_orientation_for_collection(\n      start_pos, start_dir, initial_grid, primitive, current_state.world, MAX_COLLECT_STEPS\n  )\n\n  if path_of_moves is None:\n      return [] # No valid path found within MAX_COLLECT_STEPS to collect the primitive.\n\n  # 3. Execute the found path of movement actions in the environment.\n  for action in path_of_moves:\n      actions_taken.append(action)\n      \n      # Take a step in the simulation.\n      _, done, _ = env.step(action)\n      current_state = env._current_state # Always update the internal state reference.\n\n      # If the primitive is collected unexpectedly during movement (unlikely for static primitives, but robust),\n      # or if the episode ends prematurely, return the actions taken so far.\n      if current_state.inventory[primitive] > 0 or done:\n          return actions_taken \n      \n  # 4. After executing all movement actions, the agent should be positioned and oriented correctly.\n  # Perform the final ACTION_USE to attempt collection.\n  \n  # Determine the cell directly in front of the agent based on its CURRENT position and direction.\n  target_cell_y, target_cell_x = _get_cell_in_front(current_state.pos, current_state.dir)\n  \n  is_primitive_collectible_now = False\n  # Verify the target cell is within grid boundaries and contains the primitive,\n  # using the *current* grid state for maximum accuracy.\n  if target_cell_y is not None and \\\n     0 <= target_cell_y < grid_height and 0 <= target_cell_x < grid_width:\n      if current_state.grid[target_cell_y, target_cell_x, primitive] > 0: \n          is_primitive_collectible_now = True\n\n  if is_primitive_collectible_now:\n      # If the primitive is reachable and there's still capacity for the USE action within MAX_COLLECT_STEPS.\n      if len(actions_taken) < MAX_COLLECT_STEPS:\n          actions_taken.append(Action.USE)\n          _, _, _ = env.step(Action.USE)\n          current_state = env._current_state # Update state after USE.\n\n          # Final verification: Confirm the primitive was successfully collected into inventory.\n          if current_state.inventory[primitive] > 0:\n              return actions_taken # Successfully collected!\n          else:\n              # Collection failed even after reaching and attempting USE (e.g., requires tool, depleted, etc.)\n              return [] \n      else:\n          # Max steps reached; no space left for the final USE action.\n          return [] \n  else:\n      # This indicates a discrepancy: BFS found a path, but the primitive is not in the expected\n      # location (directly in front) after executing the path. This might happen if the grid\n      # state changed unexpectedly between planning and execution, or due to subtle logic mismatches.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T23:02:10.423896", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Re-aligned agent directions (based on collect_v0's implied CraftState.dir mapping:\n  # 0=North/Up, 1=East/Right, 2=South/Down, 3=West/Left)\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Mapping of target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction (`CraftState.dir` value) to collect that target via ACTION_USE.\n  RELATIVE_TO_REQUIRED_DIR = {\n      (-1, 0): DIR_NORTH,  # Target is to the North (y-1), agent must face North (dir=0)\n      (0, 1): DIR_EAST,    # Target is to the East (x+1), agent must face East (dir=1)\n      (1, 0): DIR_SOUTH,   # Target is to the South (y+1), agent must face South (dir=2)\n      (0, -1): DIR_WEST    # Target is to the West (x-1), agent must face West (dir=3)\n  }\n\n  # Maximum total actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_cell_in_front(pos, direction):\n      \"\"\"Returns the coordinates (y, x) of the cell directly in front of the agent.\"\"\"\n      y, x = pos\n      if direction == DIR_NORTH: # If agent dir is 0, they face North (y-1)\n          return (y - 1, x)\n      elif direction == DIR_EAST: # If agent dir is 1, they face East (x+1)\n          return (y, x + 1)\n      elif direction == DIR_SOUTH: # If agent dir is 2, they face South (y+1)\n          return (y + 1, x)\n      elif direction == DIR_WEST: # If agent dir is 3, they face West (x-1)\n          return (y, x - 1)\n      return None # Should not be reached with valid directions\n\n  # Breadth-First Search (BFS) to find a path to the primitive, ensuring the agent\n  # ends up at a position AND orientation suitable for collection.\n  def _find_path_and_orientation_for_collection(start_pos, start_dir, initial_grid, primitive_id, world):\n      \"\"\"\n      Performs a BFS to find the shortest sequence of movement actions that brings the agent\n      to a state (position, direction) from which the `primitive_id` can be collected.\n      Returns the list of movement actions or None if no such path is found within MAX_COLLECT_STEPS.\n      \"\"\"\n      grid_height, grid_width, _ = initial_grid.shape\n      \n      # Correctly define impassable kinds for movement:\n      # Start with all non-grabbable items.\n      impassable_for_movement = set(world.non_grabbable_indices)\n      \n      # Workshops are non-grabbable but typically traversable; remove them from the impassable set.\n      impassable_for_movement.difference_update(world.workshop_indices)\n      \n      # Water (if present) is usually an impassable entity for movement.\n      if world.water_index in world.kinds:\n          impassable_for_movement.add(world.water_index)\n      \n      # Note: Stone is a resource, typically traversable unless it's an unbreakable wall.\n      # Assuming it's traversable for movement unless explicitly stated otherwise.\n\n      # BFS state: (current_y, current_x, current_dir, path_of_actions_so_far)\n      q = collections.deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n      # When the agent moves, its facing direction typically updates to the direction of movement.\n      moves_options = [\n          (-1, 0, ACTION_UP, DIR_NORTH),    # Move North (y-1), action UP, agent faces North (dir=0)\n          (1, 0, ACTION_DOWN, DIR_SOUTH),   # Move South (y+1), action DOWN, agent faces South (dir=2)\n          (0, -1, ACTION_LEFT, DIR_WEST),   # Move West (x-1), action LEFT, agent faces West (dir=3)\n          (0, 1, ACTION_RIGHT, DIR_EAST)    # Move East (x+1), action RIGHT, agent faces East (dir=1)\n      ]\n\n      while q:\n          curr_y, curr_x, curr_dir, path_actions = q.popleft()\n          \n          # Check if the primitive is collectible from the current (position, direction) state\n          # Iterate through possible relative positions of the primitive (e.g., North, East, South, West)\n          for (rel_dy, rel_dx), required_dir_to_face in RELATIVE_TO_REQUIRED_DIR.items():\n              if curr_dir == required_dir_to_face: # Agent is facing the correct direction to use\n                  adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n                  # Check bounds and if the adjacent cell contains the primitive\n                  if (0 <= adj_y < grid_height and 0 <= adj_x < grid_width and\n                          initial_grid[adj_y, adj_x, primitive_id] > 0):\n                      # Found a path that leads to a position AND ensures the agent is oriented correctly.\n                      # This is the shortest path due to BFS.\n                      return path_actions \n\n          # Explore neighboring cells by applying movement actions\n          for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n              # Prune if adding this movement action would exceed the maximum allowed steps\n              # (reserving at least one slot for the final ACTION_USE).\n              if len(path_actions) + 1 >= MAX_COLLECT_STEPS: \n                  continue\n\n              # Check if the proposed next position is within the grid boundaries.\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if the proposed next cell is traversable (does not contain any impassable kinds).\n              is_traversable_for_movement = True\n              for k_idx in impassable_for_movement:\n                  if initial_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable_for_movement = False\n                      break\n              if not is_traversable_for_movement:\n                  continue\n              \n              # Add to queue only if this new state (position and direction) hasn't been visited.\n              if (next_y, next_x, new_dir_after_move) not in visited:\n                  visited.add((next_y, next_x, new_dir_after_move))\n                  q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n      return None # No path found to the primitive with correct orientation within limits\n\n  actions_taken = [] # List to store the sequence of actions to be returned\n  \n  # 1. Initialize environment state and perform preliminary checks\n  # Reset the environment to ensure a fresh start and retrieve the initial CraftState.\n  _ = env.reset() # The observation is not needed for pathfinding; we access internal state.\n  current_state = env._current_state # Direct access to the current CraftState instance\n\n  # Verify the primitive is a recognized kind in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      return [] # Unknown primitive, cannot collect.\n\n  # Check if the primitive is already present in the agent's inventory.\n  if current_state.inventory[primitive] > 0:\n      return [] # Primitive already collected, no actions needed.\n\n  # Obtain grid dimensions, agent's initial position, and facing direction.\n  initial_grid = current_state.features_dict()['features_global'] # Snapshot of the grid for pathfinding\n  start_pos = current_state.pos # Agent's starting Y, X coordinates\n  start_dir = current_state.dir # Agent's initial facing direction (e.g., DIR_NORTH)\n\n  # 2. Find the path to the primitive\n  path_of_moves = _find_path_and_orientation_for_collection(\n      start_pos, start_dir, initial_grid, primitive, current_state.world\n  )\n\n  if path_of_moves is None:\n      return [] # No valid path found within MAX_COLLECT_STEPS to collect the primitive.\n\n  # 3. Execute the found path in the environment\n  for action in path_of_moves:\n      actions_taken.append(action)\n      \n      # Take a step in the simulation.\n      _, _, _ = env.step(action) # We don't need reward/done for this intermediate step.\n      current_state = env._current_state # Always update the internal state reference after a step.\n\n      # Early exit if the primitive is unexpectedly collected mid-path (e.g., due to an environmental change,\n      # though unlikely in static CraftWorld scenarios).\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n      \n      # If the episode ends prematurely (e.g., max_steps reached) before all movement actions\n      # are executed and the goal is not met, this path effectively failed.\n      if env.steps >= env.max_steps: # Check if the environment's total step count has hit its limit\n          if current_state.inventory[primitive] <= 0:\n              return [] # Episode terminated before collection; path failed.\n\n  # 4. Perform the final ACTION_USE\n  # After executing all movement actions, the agent should be at the correct position\n  # and facing the correct direction as determined by the BFS.\n  \n  # Determine the cell directly in front of the agent based on its CURRENT position and direction.\n  target_cell_y, target_cell_x = _get_cell_in_front(current_state.pos, current_state.dir)\n  \n  is_primitive_collectible_now = False\n  if target_cell_y is not None:\n      grid_height, grid_width, _ = current_state.grid.shape # Get dimensions from current grid state\n      if (0 <= target_cell_y < grid_height and 0 <= target_cell_x < grid_width and\n              current_state.grid[target_cell_y, target_cell_x, primitive] > 0): \n          is_primitive_collectible_now = True\n\n  if is_primitive_collectible_now:\n      # If the primitive is reachable, append and execute the ACTION_USE.\n      # Ensure there's still capacity for the USE action within MAX_COLLECT_STEPS.\n      if len(actions_taken) < MAX_COLLECT_STEPS: \n          actions_taken.append(ACTION_USE)\n          _, _, _ = env.step(ACTION_USE)\n          current_state = env._current_state # Update state after USE\n\n          # Final verification: Confirm the primitive was successfully collected into inventory.\n          if current_state.inventory[primitive] > 0:\n              return actions_taken # Successfully collected!\n          else:\n              # This indicates a failure despite being at the correct spot and using ACTION_USE.\n              # E.g., requires specific tool, resource depleted, environmental constraint not modeled.\n              return [] \n      else:\n          # Max steps reached, no space left for the final USE action.\n          return [] \n  else:\n      # This indicates a discrepancy: BFS found a path, but the primitive is not\n      # in the expected location (directly in front) after executing the path.\n      # This could happen if the initial_grid snapshot used for planning became stale\n      # due to environmental changes, or if the `_get_cell_in_front` or `RELATIVE_TO_REQUIRED_DIR`\n      # logic doesn't perfectly match the environment's `USE` mechanics.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T23:03:36.421453", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:03:36.490202", "function_name": "collect", "function_body": "    import collections # For deque\n\n    current_state = env._current_state\n\n    # 1. Check if the primitive is already in the agent's inventory.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # 2. Verify if the primitive is a grabbable item. If not, it cannot be collected\n    #    via simple interaction (e.g., it might be a crafting station or an unmovable obstacle).\n    if primitive not in current_state.world.grabbable_indices:\n        return []\n\n    grid = current_state.grid\n    height, width, _ = grid.shape\n\n    # Helper function to determine if a given position is \"next to\" (within 3x3 neighborhood,\n    # including the position itself) an instance of the target_kind_idx on the grid.\n    # This mirrors the logic of CraftState.next_to.\n    def check_next_to_at_pos(pos, target_kind_idx):\n        r, c = pos\n        # Iterate over the 3x3 neighborhood around 'pos'\n        for dr in [-1, 0, 1]:\n            for dc in [-1, 0, 1]:\n                nr, nc = r + dr, c + dc\n                # Check if the neighbor coordinates are within grid bounds\n                if 0 <= nr < height and 0 <= nc < width:\n                    # If the target kind is found at this neighbor position, return True\n                    if grid[nr, nc, target_kind_idx] > 0:\n                        return True\n        return False\n\n    # 3. Check if the agent is already at a position from which the primitive can be collected.\n    if check_next_to_at_pos(current_state.pos, primitive):\n        return [env_factory.USE]\n\n    # 4. Perform a Breadth-First Search (BFS) to find the shortest path to a position\n    #    from which the primitive can be collected.\n    q = collections.deque([(current_state.pos, [])]) # Queue stores (current_position, path_to_current_position)\n    visited = {current_state.pos} # Set to keep track of visited positions to avoid cycles and redundant checks\n\n    # Define the mapping from action constants to their corresponding (row_delta, col_delta)\n    MOVES = {\n        env_factory.DOWN: (1, 0),\n        env_factory.UP: (-1, 0),\n        env_factory.LEFT: (0, -1),\n        env_factory.RIGHT: (0, 1)\n    }\n\n    while q:\n        current_pos, path_so_far = q.popleft()\n\n        # Iterate through all possible movement actions\n        for action, (dr, dc) in MOVES.items():\n            next_r, next_c = current_pos[0] + dr, current_pos[1] + dc\n            next_pos = (next_r, next_c)\n\n            # Check if the next position is within grid boundaries and has not been visited yet\n            if 0 <= next_r < height and 0 <= next_c < width and next_pos not in visited:\n                new_path = path_so_far + [action]\n\n                # If this new position is next to the primitive, we've found our path.\n                # Append the USE action and return the complete sequence.\n                if check_next_to_at_pos(next_pos, primitive):\n                    return new_path + [env_factory.USE]\n\n                # Mark the new position as visited and add it to the queue for further exploration\n                visited.add(next_pos)\n                q.append((next_pos, new_path))\n\n    # If the BFS completes and no path to the primitive was found, return an empty list.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:04:44.225945", "function_name": "collect", "function_body": "    actions_taken = []\n    current_state = env._current_state\n    \n    # Store initial primitive count to detect collection\n    initial_primitive_count = current_state.inventory[primitive]\n\n    # Retrieve action mappings from the environment for robustness\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    # Max steps to prevent infinite loops in case of unachievable goals or complex scenarios\n    max_total_steps = 500 \n\n    for _ in range(max_total_steps):\n        # 1. Check if the primitive has been collected\n        if current_state.inventory[primitive] > initial_primitive_count:\n            return actions_taken\n\n        # 2. Find all locations of the primitive on the grid\n        primitive_locations = []\n        grid = current_state.grid\n        WIDTH, HEIGHT, _ = grid.shape # N_KINDS is not needed for iterating through positions\n\n        for x in range(WIDTH):\n            for y in range(HEIGHT):\n                if grid[x, y, primitive] > 0:\n                    primitive_locations.append((x, y))\n\n        if not primitive_locations:\n            # If the primitive is no longer on the grid and we haven't collected it,\n            # it implies it's uncollectible this way (e.g., it was removed, or is crafted).\n            # Return actions taken so far, indicating failure to collect.\n            return actions_taken\n\n        # 3. Choose the closest primitive location using Manhattan distance\n        agent_pos = current_state.pos\n        closest_target_pos = None\n        min_dist = float('inf')\n\n        for tx, ty in primitive_locations:\n            dist = abs(tx - agent_pos[0]) + abs(ty - agent_pos[1])\n            if dist < min_dist:\n                min_dist = dist\n                closest_target_pos = (tx, ty)\n\n        # 4. Pathfinding using Breadth-First Search (BFS) to get adjacent to the target\n        # BFS state: ((current_x, current_y), [path_list_to_current_pos])\n        q = collections.deque([(agent_pos, [])])\n        visited = {agent_pos}\n\n        # Define possible moves and corresponding actions\n        # (dx, dy): action\n        movement_vectors = {\n            (0, -1): ACTION_UP,\n            (0, 1): ACTION_DOWN,\n            (-1, 0): ACTION_LEFT,\n            (1, 0): ACTION_RIGHT,\n        }\n        \n        path_to_target_adj = None\n\n        # Identify impassable terrain kinds (e.g., water, stone) based on CraftWorld attributes\n        world = current_state.world\n        impassable_kinds = {world.water_index, world.stone_index} if hasattr(world, 'water_index') and hasattr(world, 'stone_index') else set()\n\n        while q:\n            (curr_x, curr_y), path_so_far = q.popleft()\n\n            # If current position is adjacent to the target primitive, we found our path\n            if abs(curr_x - closest_target_pos[0]) + abs(curr_y - closest_target_pos[1]) == 1:\n                path_to_target_adj = path_so_far\n                break\n\n            for (dx, dy), action in movement_vectors.items():\n                next_x, next_y = curr_x + dx, curr_y + dy\n                next_pos = (next_x, next_y)\n\n                # Check bounds\n                if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                    continue\n\n                # Check if already visited in this BFS iteration\n                if next_pos in visited:\n                    continue\n\n                # Passability check: if the cell contains an impassable kind\n                is_impassable = False\n                for k_idx in impassable_kinds:\n                    if grid[next_x, next_y, k_idx] > 0: # If this kind is present at the cell\n                        is_impassable = True\n                        break\n                if is_impassable:\n                    continue\n                \n                # Add to queue\n                visited.add(next_pos)\n                q.append((next_pos, path_so_far + [action]))\n\n        if path_to_target_adj:\n            # 5. Execute path actions\n            for action in path_to_target_adj:\n                # Ensure we don't exceed max_total_steps during path execution\n                if len(actions_taken) >= max_total_steps:\n                    return actions_taken \n                \n                _, _, _ = env.step(action)\n                actions_taken.append(action)\n                current_state = env._current_state # Update current state after each step\n\n                # Check if collected during movement (e.g., by walking over it if it's passive collection)\n                if current_state.inventory[primitive] > initial_primitive_count:\n                    return actions_taken\n            \n            # 6. Once adjacent, use ACTION_USE to collect the primitive\n            if current_state.next_to(primitive):\n                if len(actions_taken) >= max_total_steps: # Final check before USE\n                    return actions_taken\n                \n                _, _, _ = env.step(ACTION_USE)\n                actions_taken.append(ACTION_USE)\n                current_state = env._current_state # Update current state\n                \n                if current_state.inventory[primitive] > initial_primitive_count:\n                    return actions_taken\n            # If not next_to(primitive) after path, something went wrong (e.g., primitive moved/disappeared).\n            # The loop will re-evaluate.\n        else:\n            # No path found to any primitive location.\n            # This means the primitive is unreachable or has disappeared.\n            return actions_taken # Failed to find a path to collect.\n\n    # If the loop finishes without collecting the primitive, it means max_total_steps was reached.\n    return actions_taken", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:04:45.189498", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:05:51.675965", "function_name": "collect", "function_body": "  import collections\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  actions_to_take = []\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Define specific indices that act as obstacles for movement.\n  # Water is explicitly mentioned as an entity and typically acts as a barrier.\n  # Assuming other non-grabbable entities might be traversable (e.g., workshops).\n  obstacles_indices = {env.world.water_index} \n\n  # Helper function to check if a cell (x, y) is traversable\n  def _is_traversable(x, y):\n      # Check bounds\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return False\n      \n      # Check if the cell contains any of the identified obstacles\n      for k_idx in obstacles_indices:\n          if current_grid[x, y, k_idx] == 1:\n              return False # Contains an obstacle, thus not traversable\n      return True # Traversable (no explicitly defined obstacles present)\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell\n      if current_grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  # Define potential target cells for the agent: any traversable cell in the 3x3 neighborhood of a primitive.\n  # The agent needs to reach one of these cells to successfully _USE the primitive.\n  potential_agent_targets = set()\n  for prim_x, prim_y in primitive_locations:\n    for dx in range(-1, 2):\n      for dy in range(-1, 2):\n        target_x, target_y = prim_x + dx, prim_y + dy\n        # Only add a cell as a potential target if it's within bounds and traversable\n        if _is_traversable(target_x, target_y):\n            potential_agent_targets.add((target_x, target_y))\n            \n  # If no traversable target positions can be found near any primitive, the primitive is unreachable.\n  if not potential_agent_targets:\n      return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path from the current position\n  # to any of the potential_agent_targets, considering obstacles.\n  queue = collections.deque([(current_pos, [])]) # Queue stores (position, path_actions_to_reach_position)\n  visited = {current_pos} # Set of visited (x,y) positions to prevent cycles and redundant exploration\n\n  target_path = None\n\n  while queue:\n    (curr_x, curr_y), path = queue.popleft()\n\n    # If the current position is one of our valid target positions, we've found the shortest path.\n    if (curr_x, curr_y) in potential_agent_targets:\n      target_path = path\n      break # Exit BFS as we found the shortest path\n\n    # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n    neighbors_info = [\n        ((curr_x, curr_y - 1), _UP),\n        ((curr_x, curr_y + 1), _DOWN),\n        ((curr_x - 1, curr_y), _LEFT),\n        ((curr_x + 1, curr_y), _RIGHT),\n    ]\n\n    for (nx, ny), action in neighbors_info:\n      # Check if the neighbor is traversable and has not been visited yet\n      if _is_traversable(nx, ny) and (nx, ny) not in visited:\n        visited.add((nx, ny)) # Mark as visited\n        queue.append(((nx, ny), path + [action])) # Add to queue with updated path\n\n  # If no path was found (e.g., all targets are unreachable due to obstacles)\n  if target_path is None:\n    return []\n\n  # The actions to take are the path to the target cell, followed by the USE action\n  actions_to_take = target_path + [_USE]\n\n  return actions_to_take", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T23:05:52.676035", "function_name": "collect", "function_body": "  import collections # For deque for BFS\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  actions_to_take = []\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Determine what constitutes an obstacle for movement.\n  # Assuming 'stone_index' is an impassable obstacle.\n  # Other environment items might be traversable (e.g., water, if not explicitly blocking).\n  # For robustness, we could consider all non_grabbable_indices that are not the target primitive\n  # as potential obstacles, or use a more specific list from the world config.\n  # For now, stick with stone_index as the primary blocker.\n  stone_index = env.world.stone_index\n\n  # Helper function to check if a position is adjacent to the primitive (within 3x3 neighborhood)\n  def _is_adjacent_to_kind(grid, x, y, kind_idx, width, height):\n    \"\"\"\n    Checks if any cell in the 3x3 neighborhood around (x,y) contains `kind_idx`.\n    This is similar to CraftState.next_to, but for an arbitrary grid and position.\n    \"\"\"\n    for dx in range(-1, 2):\n        for dy in range(-1, 2):\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < width and 0 <= ny < height:\n                if grid[nx, ny, kind_idx] == 1:\n                    return True\n    return False\n\n  # BFS to find the shortest path to a cell adjacent to the primitive\n  q = collections.deque([(current_pos, [])]) # Queue stores (position, path_actions_to_reach_pos)\n  visited = {current_pos} # Set of visited (x, y) tuples\n\n  # Define possible movements and their corresponding actions\n  # (dx, dy, action_id)\n  movements = [\n      (0, -1, _UP),    # Move North\n      (0, 1, _DOWN),   # Move South\n      (-1, 0, _LEFT),  # Move West\n      (1, 0, _RIGHT)   # Move East\n  ]\n\n  while q:\n    (curr_x, curr_y), path = q.popleft()\n\n    # Check if the current position is a valid target (adjacent to the primitive)\n    if _is_adjacent_to_kind(current_grid, curr_x, curr_y, primitive, WIDTH, HEIGHT):\n      # Found a path to a cell from which the primitive can be used\n      return path + [_USE]\n\n    # Explore neighbors\n    for dx, dy, action in movements:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check bounds\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check if obstacle (stone_index) is present at the next cell\n      # Assumes stone is impassable. Other items might block if they are also non-traversable.\n      if current_grid[next_x, next_y, stone_index] == 1:\n        continue\n\n      # Check if already visited\n      if next_pos in visited:\n        continue\n\n      # If valid and unvisited, add to queue\n      visited.add(next_pos)\n      q.append((next_pos, path + [action]))\n\n  # If BFS completes and no path is found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T23:07:07.889215", "function_name": "collect", "function_body": "    actions_taken = []\n    \n    # Get the mapping from action names to integer codes\n    action_specs = env.action_specs()\n    ACTION_DOWN = action_specs[\"DOWN\"]\n    ACTION_UP = action_specs[\"UP\"]\n    ACTION_LEFT = action_specs[\"LEFT\"]\n    ACTION_RIGHT = action_specs[\"RIGHT\"]\n    ACTION_USE = action_specs[\"USE\"]\n\n    # Direction vectors for North, East, South, West (0, 1, 2, 3)\n    # DRDC: (row_change, col_change) for moving in that direction\n    DRDC = {\n        0: (-1, 0),  # North (UP)\n        1: (0, 1),   # East (RIGHT)\n        2: (1, 0),   # South (DOWN)\n        3: (0, -1),  # West (LEFT)\n    }\n\n    # Map (dr, dc) to movement action\n    MOVE_ACTIONS = {\n        (-1, 0): ACTION_UP,\n        (1, 0): ACTION_DOWN,\n        (0, -1): ACTION_LEFT,\n        (0, 1): ACTION_RIGHT,\n    }\n\n    # Maximum steps to attempt collection to prevent infinite loops\n    # A generous limit based on grid size (e.g., twice the area)\n    MAX_COLLECT_STEPS = 2 * env._current_state.grid.shape[0] * env._current_state.grid.shape[1]\n    \n    current_steps = 0\n\n    while current_steps < MAX_COLLECT_STEPS:\n        state = env._current_state # Direct access to CraftState for detailed info\n\n        # 1. Check if primitive is already collected\n        if state.inventory[primitive] > 0:\n            return actions_taken\n\n        grid = state.grid\n        agent_row, agent_col = state.pos\n        agent_dir = state.dir # 0:N, 1:E, 2:S, 3:W\n        grid_height, grid_width, _ = grid.shape\n\n        # 2. Find target primitive location(s)\n        primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n\n        if len(primitive_locations) == 0:\n            # Primitive not found on map, perhaps impossible to collect or already gone.\n            # Fail to collect.\n            return []\n\n        # 3. Use BFS to find the shortest path to an *adjacent* cell of any primitive\n        \n        # Queue for BFS: ( (row, col), [path_actions_to_reach_this_cell] )\n        q = deque([((agent_row, agent_col), [])])\n        visited = { (agent_row, agent_col) }\n\n        # Variables to store the found path and target cell\n        target_primitive_location = None\n        actions_to_reach_adjacent_cell = None\n\n        while q and actions_to_reach_adjacent_cell is None:\n            (r, c), path_so_far = q.popleft()\n\n            # Check if this cell (r, c) is adjacent to a primitive\n            # Iterate through 4 neighbors (N, E, S, W) of (r, c)\n            for dr, dc in DRDC.values():\n                nr, nc = r + dr, c + dc # Neighbor cell coordinates\n                \n                # Check bounds for neighbor\n                if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n                    continue\n                \n                # Check if the neighbor cell (nr, nc) contains the primitive\n                if grid[nr, nc, primitive] == 1:\n                    # Found a primitive at (nr, nc) which is adjacent to (r, c).\n                    # The agent needs to move to (r, c), then turn to face (nr, nc), and USE.\n                    target_primitive_location = (nr, nc)\n                    actions_to_reach_adjacent_cell = path_so_far\n                    break # Stop BFS once any adjacent primitive is found\n            \n            if actions_to_reach_adjacent_cell is not None:\n                break # Path to an adjacent cell found, exit BFS\n\n            # Explore neighbors for BFS (movement)\n            for dr, dc in MOVE_ACTIONS.keys(): # Iterate through possible move directions\n                nr, nc = r + dr, c + dc\n\n                # Check bounds for neighbor\n                if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n                    continue\n                \n                # Check if neighbor cell (nr, nc) is traversable\n                # Obstacles are typically in env.world.cookbook.environment\n                is_obstacle = False\n                for env_idx in env.world.cookbook.environment:\n                    if grid[nr, nc, env_idx] == 1:\n                        is_obstacle = True\n                        break\n                if is_obstacle:\n                    continue # Skip obstacle cells\n\n                if (nr, nc) not in visited:\n                    visited.add((nr, nc))\n                    q.append(((nr, nc), path_so_far + [MOVE_ACTIONS[(dr, dc)]]))\n\n        if actions_to_reach_adjacent_cell is None:\n            # Cannot reach any primitive, potentially blocked or no path exists.\n            return [] # Fail to collect\n\n        # 4. Execute path to reach the cell adjacent to the primitive\n        for action in actions_to_reach_adjacent_cell:\n            reward, done, _ = env.step(action)\n            actions_taken.append(action)\n            current_steps += 1\n            if done or current_steps >= MAX_COLLECT_STEPS:\n                return actions_taken if state.inventory[primitive] > 0 else []\n            state = env._current_state # Update state reference after each step\n            # If primitive was picked up during path, we're done\n            if state.inventory[primitive] > 0:\n                return actions_taken\n\n        # After reaching the adjacent cell, update agent's current position and direction\n        agent_row, agent_col = state.pos\n        agent_dir = state.dir \n\n        # 5. Turn to face the primitive\n        tr, tc = target_primitive_location\n        dr_to_target = tr - agent_row\n        dc_to_target = tc - agent_col\n        \n        desired_dir = -1\n        for d, (row_change, col_change) in DRDC.items():\n            if row_change == dr_to_target and col_change == dc_to_target:\n                desired_dir = d\n                break\n        \n        while state.dir != desired_dir and current_steps < MAX_COLLECT_STEPS:\n            # Calculate shortest turn (left or right)\n            turn_left_steps = (state.dir - desired_dir + 4) % 4\n            turn_right_steps = (desired_dir - state.dir + 4) % 4\n\n            if turn_left_steps == 0: # Already facing the desired direction\n                break\n            \n            action_to_take = ACTION_LEFT if turn_left_steps <= turn_right_steps else ACTION_RIGHT\n            \n            reward, done, _ = env.step(action_to_take)\n            actions_taken.append(action_to_take)\n            current_steps += 1\n            if done or current_steps >= MAX_COLLECT_STEPS:\n                return actions_taken if state.inventory[primitive] > 0 else []\n            state = env._current_state # Update state reference\n\n        # 6. Use the item\n        if current_steps < MAX_COLLECT_STEPS:\n            reward, done, _ = env.step(ACTION_USE)\n            actions_taken.append(ACTION_USE)\n            current_steps += 1\n            if state.inventory[primitive] > 0:\n                return actions_taken\n            if done:\n                return actions_taken if state.inventory[primitive] > 0 else []\n            state = env._current_state # Update state reference\n\n    # If loop finishes without collecting (e.g., hit MAX_COLLECT_STEPS)\n    return actions_taken if state.inventory[primitive] > 0 else []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:07:07.960631", "function_name": "collect", "function_body": "    # 1. Get action mappings\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    # Define movement deltas for each action (dx, dy) for (x, y) coordinates\n    move_deltas = {\n        ACTION_UP: (0, -1),\n        ACTION_DOWN: (0, 1),\n        ACTION_LEFT: (-1, 0),\n        ACTION_RIGHT: (1, 0)\n    }\n\n    # 2. Get current state information\n    obs = env.observations()\n    inventory = obs['features_dict']['inventory']\n    current_pos = tuple(obs['features_dict']['pos'])  # Agent's current (x, y) position\n    grid = obs['features_dict']['grid']              # Grid: (WIDTH, HEIGHT, n_kinds)\n    grid_width, grid_height, _ = grid.shape\n\n    # 3. Check Inventory: If the primitive is already collected, no actions are needed.\n    if inventory[primitive] > 0:\n        return []\n\n    # 4. Find all locations of the primitive on the grid\n    primitive_locations = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if grid[x, y, primitive] == 1:\n                primitive_locations.append((x, y))\n\n    # If the primitive is not found on the grid, it cannot be collected.\n    if not primitive_locations:\n        return []\n\n    # 5. Determine if the primitive is grabbable (can be picked up directly)\n    #    or non-grabbable (e.g., a workshop that must be used from an adjacent cell).\n    is_grabbable = primitive in env.world.grabbable_indices\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # 6. Determine target cells for BFS (where the agent needs to be to 'use' the primitive)\n    target_cells = []\n    if is_grabbable:\n        # If grabbable, the agent needs to move onto the primitive's cell.\n        target_cells = primitive_locations\n    else:\n        # If non-grabbable, the agent needs to move to an adjacent cell to use it.\n        for px, py in primitive_locations:\n            for dx, dy in move_deltas.values():  # Check all 4 directions around the primitive\n                tx, ty = px + dx, py + dy\n                # Ensure adjacent cell is within grid bounds\n                if 0 <= tx < grid_width and 0 <= ty < grid_height:\n                    target_cells.append((tx, ty))\n        target_cells = list(set(target_cells))  # Remove duplicate target cells\n\n    # If no valid target cells are found (e.g., primitive is completely surrounded), it can't be reached.\n    if not target_cells:\n        return []\n\n    # 7. Perform BFS (Breadth-First Search) to find the shortest path to any target cell\n    q = deque([(current_pos, [])])  # Queue stores (position, path_actions_to_reach_position)\n    visited = {current_pos}\n    best_path_actions = None\n\n    while q:\n        (cx, cy), path_actions = q.popleft()\n\n        # If the current position is one of the target cells, we found the shortest path.\n        if (cx, cy) in target_cells:\n            best_path_actions = path_actions\n            break\n\n        # Explore neighbors\n        for action_type, (dx, dy) in move_deltas.items():\n            nx, ny = cx + dx, cy + dy\n            next_pos = (nx, ny)\n\n            # Check if next_pos is within grid bounds and has not been visited yet\n            if 0 <= nx < grid_width and 0 <= ny < grid_height and next_pos not in visited:\n                # Check for obstacles: A cell is considered an obstacle if it contains\n                # any non-grabbable item, as the agent cannot move onto such cells.\n                is_obstacle = False\n                for k_idx in non_grabbable_indices:\n                    if grid[nx, ny, k_idx] == 1:\n                        is_obstacle = True\n                        break\n\n                if not is_obstacle:  # Only move to non-obstacle cells\n                    q.append((next_pos, path_actions + [action_type]))\n                    visited.add(next_pos)\n\n    # 8. Construct the final list of actions\n    if best_path_actions is None:\n        # No path found to any target cell\n        return []\n    else:\n        # Append the USE action after reaching the target cell\n        final_actions = best_path_actions + [ACTION_USE]\n        return final_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:08:48.118663", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants are assumed to be available via env_factory\n  # as per the problem description's action_specs:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  # No need to redefine them if env_factory provides them.\n\n  _MOVE_ACTIONS = [\n      (0, -1, env_factory.UP),    # (dx, dy, action) for moving Up\n      (0, 1, env_factory.DOWN),   # (dx, dy, action) for moving Down\n      (-1, 0, env_factory.LEFT),  # (dx, dy, action) for moving Left\n      (1, 0, env_factory.RIGHT)   # (dx, dy, action) for moving Right\n  ]\n\n  MAX_TOTAL_ACTIONS = 500  # A safety limit to prevent infinite loops during collection attempts\n\n  current_state = env._current_state\n  actions_taken = []\n\n  # Get grid dimensions and world info from the initial state\n  grid_width, grid_height, _ = current_state.grid.shape\n  world = current_state.world\n  initial_grid = current_state.grid  # Use this grid for BFS pathfinding to avoid issues with dynamic changes during plan generation\n\n  # Check if the primitive is already in inventory at the start\n  # We need the name string for the satisfies method, which takes goal_name.\n  primitive_name = world.cookbook.index.get(primitive)\n  if current_state.satisfies(primitive_name, primitive):\n      return actions_taken # Already collected, no actions needed\n\n  # BFS setup to find the shortest path to a position adjacent to the primitive\n  q = collections.deque()\n  visited = set()  # Stores (x, y) tuples to avoid cycles\n\n  initial_pos = current_state.pos\n  q.append((initial_pos, []))  # Queue stores (current_position, path_to_this_position)\n  visited.add(initial_pos)\n\n  path_to_primitive_adjacency = None\n\n  while q:\n      current_pos, path = q.popleft()\n      \n      # Check if current_pos is a target for BFS:\n      # A target position is one from which a 'USE' action can be applied to collect the primitive.\n      # This means 'current_pos' must be adjacent (in 3x3 neighborhood) to a cell containing the primitive.\n      \n      found_primitive_neighbor = False\n      # Check 3x3 neighborhood around current_pos for the primitive\n      for dx_adj in [-1, 0, 1]:\n          for dy_adj in [-1, 0, 1]:\n              if dx_adj == 0 and dy_adj == 0: # This is the agent's current cell, not a neighbor to USE\n                  continue\n              \n              check_x, check_y = current_pos[0] + dx_adj, current_pos[1] + dy_adj\n              \n              # Check bounds for the cell potentially containing the primitive\n              if 0 <= check_x < grid_width and 0 <= check_y < grid_height:\n                  # Check if the primitive is at (check_x, check_y) in the initial grid.\n                  # This assumes primitive locations are static during path planning.\n                  if initial_grid[check_x, check_y, primitive] > 0:\n                      found_primitive_neighbor = True\n                      break\n          if found_primitive_neighbor:\n              break\n\n      if found_primitive_neighbor:\n          path_to_primitive_adjacency = path\n          break # Shortest path to an adjacent position found!\n\n      # Explore valid 4-directional neighbors for movement\n      for dx, dy, action in _MOVE_ACTIONS:\n          next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n          next_pos = (next_x, next_y)\n\n          # Check if next position is within grid bounds\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Check if next position is an obstacle (non-grabbable or water)\n          is_obstacle = False\n          # Get all kinds present at next_pos in the initial grid\n          kinds_at_next_pos = np.where(initial_grid[next_x, next_y] > 0)[0]\n          \n          for kind_idx in kinds_at_next_pos:\n              if kind_idx in world.non_grabbable_indices:\n                  is_obstacle = True\n                  break\n              # Check for water if it exists in this world configuration\n              if world.water_index is not None and kind_idx == world.water_index:\n                  is_obstacle = True\n                  break\n          \n          if is_obstacle:\n              continue\n\n          # If valid and not visited, add to queue\n          if next_pos not in visited:\n              visited.add(next_pos)\n              q.append((next_pos, path + [action]))\n\n  # If a path to an adjacent position was found by BFS, execute it in the environment\n  if path_to_primitive_adjacency is not None:\n      for action in path_to_primitive_adjacency:\n          # Stop executing if max actions limit is reached\n          if len(actions_taken) >= MAX_TOTAL_ACTIONS:\n              break \n          \n          # Perform the action in the actual environment\n          # We ignore reward and done status for this function's purpose.\n          env.step(action) \n          actions_taken.append(action)\n          \n          # After each movement, update current_state and check if the goal is already satisfied.\n          # This handles cases where the item might be collected without explicit USE (e.g., if walked over,\n          # or if another agent collected it, though not common in this setup).\n          current_state = env._current_state \n          if current_state.satisfies(primitive_name, primitive):\n              return actions_taken\n\n      # After reaching the adjacent position (or max actions hit), perform the USE action\n      # Ensure there's budget for the USE action within the total actions limit.\n      if len(actions_taken) < MAX_TOTAL_ACTIONS: \n          env.step(env_factory.USE)\n          actions_taken.append(env_factory.USE)\n          current_state = env._current_state # Get final state after USE\n          if current_state.satisfies(primitive_name, primitive):\n              return actions_taken\n\n  # Return the list of actions taken. \n  # If the goal was not met (e.g., no path found, or max actions reached), \n  # this list might be partial or empty.\n  return actions_taken", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:08:49.078876", "function_name": "collect", "function_body": "  import collections\n\n  def _is_passable(cell_content_vector, world):\n      \"\"\"\n      Determines if a cell is traversable by the agent.\n      A cell is considered impassable if it contains water or certain non-grabbable obstacles.\n      Workshops are generally considered passable.\n      \"\"\"\n      # Non-passable if it contains water\n      if cell_content_vector[world.water_index] > 0:\n          return False\n      \n      # Check for other non-grabbable items that act as obstacles (not workshops)\n      for k in world.non_grabbable_indices:\n          # Water is already handled. Workshops are generally passable.\n          if k == world.water_index or k in world.workshop_indices:\n              continue\n          # If the cell contains another non-grabbable and it's not a workshop, it's an obstacle.\n          if cell_content_vector[k] > 0:\n              return False\n              \n      return True # Cell is passable\n\n  def _bfs_path(start_pos, target_kind_idx, grid, world):\n      \"\"\"\n      Finds the shortest path from start_pos to any cell containing target_kind_idx using BFS.\n      Returns a list of (x, y) coordinates representing the path to follow,\n      excluding start_pos but including the target cell.\n      Returns None if no path is found.\n      \"\"\"\n      width, height, _ = grid.shape\n      \n      queue = collections.deque([(start_pos, [])]) # (current_pos, path_to_current_pos_from_start)\n      visited = {start_pos}\n      \n      # Directions for movement: (dx, dy) corresponding to N, E, S, W\n      # These are relative changes to (x, y) coordinates.\n      neighbors_deltas = [(0, -1), (1, 0), (0, 1), (-1, 0)] # N, E, S, W\n      \n      while queue:\n          (curr_x, curr_y), path_to_curr = queue.popleft()\n          \n          for dx, dy in neighbors_deltas:\n              next_x, next_y = curr_x + dx, curr_y + dy\n              next_pos = (next_x, next_y)\n              \n              # Check bounds\n              if not (0 <= next_x < width and 0 <= next_y < height):\n                  continue\n              \n              # Check if visited\n              if next_pos in visited:\n                  continue\n              \n              # If next_pos contains the target primitive, we found the path\n              if grid[next_x, next_y, target_kind_idx] > 0:\n                  return path_to_curr + [next_pos] # Return the path including the target cell\n              \n              # If not target, check passability to continue BFS\n              if not _is_passable(grid[next_x, next_y, :], world):\n                  continue\n                  \n              visited.add(next_pos)\n              queue.append((next_pos, path_to_curr + [next_pos]))\n              \n      return None # No path found\n\n  def _path_to_actions(start_pos, start_dir, path_coords, action_map):\n      \"\"\"\n      Converts a list of (x, y) path coordinates into a sequence of agent actions (turns, moves).\n      \"\"\"\n      actions = []\n      \n      if not path_coords:\n          return actions # No path, no actions\n          \n      curr_x, curr_y = start_pos\n      curr_dir = start_dir # 0:N, 1:E, 2:S, 3:W\n      \n      # Action mappings\n      UP = action_map['UP']\n      LEFT = action_map['LEFT']\n      RIGHT = action_map['RIGHT']\n      \n      # Mapping (dx, dy) to agent's facing direction (0:N, 1:E, 2:S, 3:W)\n      dir_deltas_map = {\n          (0, -1): 0, # N\n          (1, 0): 1,  # E\n          (0, 1): 2,  # S\n          (-1, 0): 3  # W\n      }\n      \n      for next_x, next_y in path_coords:\n          dx, dy = next_x - curr_x, next_y - curr_y\n          \n          target_dir = dir_deltas_map.get((dx, dy))\n          \n          if target_dir is None:\n              # This indicates an invalid step (e.g., non-cardinal or no movement)\n              # Should not happen with BFS-generated paths.\n              continue\n              \n          # Calculate turns needed to face the target direction\n          delta_dir = (target_dir - curr_dir + 4) % 4\n          \n          if delta_dir == 1: # Turn Right\n              actions.append(RIGHT)\n          elif delta_dir == 2: # Turn 180 degrees (two LEFTs or two RIGHTs)\n              actions.extend([LEFT, LEFT]) # Can also be [RIGHT, RIGHT]\n          elif delta_dir == 3: # Turn Left\n              actions.append(LEFT)\n              \n          # After turning, agent is facing the target, so move forward (UP action)\n          actions.append(UP)\n          \n          # Update current position and direction for the next step in the path\n          curr_x, curr_y = next_x, next_y\n          curr_dir = target_dir\n          \n      return actions\n\n  actions_taken = []\n  \n  # Get action mappings\n  act_map = env.action_specs()\n  USE = act_map['USE']\n\n  # Maximum number of steps to attempt collection to prevent infinite loops\n  MAX_COLLECT_STEPS = 500 \n\n  steps_taken = 0\n  while steps_taken < MAX_COLLECT_STEPS:\n      obs = env.observations()\n      state = env._current_state # Direct access to the underlying CraftState\n\n      # 1. Check if the primitive is already in inventory\n      if state.inventory[primitive] > 0:\n          break # Goal achieved\n\n      # 2. Check if the primitive is next to the agent and is grabbable\n      if primitive in state.world.grabbable_indices and state.next_to(primitive):\n          actions_taken.append(USE)\n          reward, done, _ = env.step(USE)\n          steps_taken += 1\n          # Re-check inventory immediately after attempting USE\n          if env._current_state.inventory[primitive] > 0:\n              break # Goal achieved\n          # If USE didn't pick it up, the loop will re-evaluate.\n          # For primitives, USE usually works if next_to and grabbable.\n\n      # 3. Pathfinding to the primitive if not already collected or next to agent\n      path_to_primitive = _bfs_path(state.pos, primitive, state.grid, state.world)\n\n      if path_to_primitive:\n          # Convert the path to a sequence of actions (turns and moves)\n          nav_actions = _path_to_actions(state.pos, state.dir, path_to_primitive, act_map)\n          \n          for action in nav_actions:\n              if steps_taken >= MAX_COLLECT_STEPS:\n                  break # Stop if max steps reached during navigation\n              actions_taken.append(action)\n              reward, done, _ = env.step(action)\n              steps_taken += 1\n              # After each step, re-check if goal is achieved (e.g., if item collected mid-path)\n              if env._current_state.inventory[primitive] > 0:\n                  return actions_taken # Goal achieved, return actions taken so far\n          \n      else:\n          # If no path is found (primitive unreachable or not on map),\n          # or if the agent is stuck, perform a simple exploration move (e.g., turn left).\n          # This helps prevent getting stuck if pathfinding fails or item is obscured.\n          actions_taken.append(LEFT) \n          reward, done, _ = env.step(LEFT)\n          steps_taken += 1\n\n  return actions_taken", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:10:05.524087", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:10:06.486162", "function_name": "collect", "function_body": "  import numpy as np\n\n  actions = []\n  obs = env.observations()\n  current_state_dict = obs['features_dict']\n\n  # 1. Check if the primitive is already collected in the agent's inventory\n  current_inventory = current_state_dict['inventory'].copy()\n  if current_inventory[primitive] > 0:\n    return [] # Already collected, no actions needed\n\n  current_grid = current_state_dict['features_global']\n  grid_width, grid_height, _ = current_grid.shape\n\n  # Convert normalized agent position to grid coordinates\n  sim_pos_x = int(current_state_dict['pos'][0] * grid_width)\n  sim_pos_y = int(current_state_dict['pos'][1] * grid_height)\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 2. Find all occurrences of the primitive on the current grid\n  target_primitive_coords = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If the primitive kind is present at this (x, y) location\n      if current_grid[x, y, primitive] == 1.0:\n        target_primitive_coords.append((x, y))\n\n  if not target_primitive_coords:\n    # Primitive not found on the grid, cannot collect\n    return []\n\n  # 3. Select the closest primitive as the target using Manhattan distance\n  closest_target = None\n  min_dist = float('inf')\n  for tx, ty in target_primitive_coords:\n    dist = abs(tx - sim_pos_x) + abs(ty - sim_pos_y)\n    if dist < min_dist:\n      min_dist = dist\n      closest_target = (tx, ty)\n\n  # This should not be None if target_primitive_coords was not empty\n  if closest_target is None:\n    return []\n\n  target_x, target_y = closest_target\n\n  # 4. Plan the path and actions\n  # A generous upper bound to prevent infinite loops for complex or unreachable paths.\n  # (Max grid steps in each dimension + buffer for USE and rotations/adjustments)\n  MAX_PLAN_STEPS = (grid_width + grid_height) * 2 + 5\n\n  for _ in range(MAX_PLAN_STEPS):\n    # Calculate relative position to the target\n    dx = target_x - sim_pos_x\n    dy = target_y - sim_pos_y\n\n    # Check if the agent is within the 3x3 neighborhood of the target (including on top of it)\n    # This aligns with CraftState's `next_to` function which checks the 3x3 area.\n    is_in_use_range = (abs(dx) <= 1 and abs(dy) <= 1)\n\n    if is_in_use_range:\n      # Agent is next to or on the primitive, apply the USE action\n      actions.append(USE)\n      # Simulate the pickup: update inventory and remove the primitive from the simulated grid\n      current_inventory[primitive] += 1\n      current_grid[target_x, target_y, primitive] = 0.0 # Remove from simulated grid\n\n      # If the goal is achieved (primitive collected), return the actions\n      if current_inventory[primitive] > 0:\n        return actions\n\n      # If USE didn't result in collection (e.g., resource depleted, not modeled here),\n      # we would typically break or re-plan. For this problem, assume one USE collects one primitive.\n      break # Exit loop after trying USE\n\n    # If not in USE range, move towards the target\n    # Simple greedy pathfinding: prioritize movement along the dimension with a larger difference\n    if abs(dx) > 0: # Move horizontally if there's horizontal distance\n      if dx > 0:\n        actions.append(RIGHT)\n        sim_pos_x += 1\n      else:\n        actions.append(LEFT)\n        sim_pos_x -= 1\n    elif abs(dy) > 0: # Move vertically if there's vertical distance (and no horizontal)\n      if dy > 0:\n        actions.append(DOWN) # Down in Y typically means increasing Y coordinate\n        sim_pos_y += 1\n      else:\n        actions.append(UP) # Up in Y typically means decreasing Y coordinate\n        sim_pos_y -= 1\n    else:\n      # This case should theoretically not be reached if the agent is not in use_range\n      # and dx, dy are both 0 (as that implies is_in_use_range is True).\n      # It implies no further movement is possible, perhaps stuck or target unreachable.\n      break # Cannot move further or target unreachable\n\n  # If the loop completes without successfully collecting the primitive\n  if current_inventory[primitive] > 0:\n    return actions\n  else:\n    return [] # Failed to collect after max steps or pathing issue", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:11:56.040662", "function_name": "collect", "function_body": "    # Constants for actions, typically defined globally but included here for self-containment\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    current_state = env._current_state\n    inventory = current_state.inventory\n\n    # 1. Check if the primitive is already collected\n    if inventory[primitive] > 0:\n        return []\n\n    actions = []\n\n    # 2. Check if the agent is already next to the primitive (or on the same cell)\n    # CraftState.next_to checks the 3x3 neighborhood, including the agent's current cell.\n    if current_state.next_to(primitive):\n        actions.append(USE)\n        return actions\n\n    # 3. If not, find all locations of the primitive on the grid\n    grid = current_state.grid\n    pos = current_state.pos  # Agent's current (x, y) position\n    width, height, _ = grid.shape\n\n    primitive_locations = []\n    for x in range(width):\n        for y in range(height):\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        # No primitive found on the grid, cannot collect\n        return []\n\n    # 4. Find the primitive instance that is closest to the agent\n    min_dist_to_primitive = float('inf')\n    target_primitive_pos = None\n\n    for px, py in primitive_locations:\n        # Calculate Manhattan distance to the primitive itself\n        dist = abs(pos[0] - px) + abs(pos[1] - py)\n        if dist < min_dist_to_primitive:\n            min_dist_to_primitive = dist\n            target_primitive_pos = (px, py)\n\n    # 5. Determine the best adjacent cell to move to\n    # The goal is to move to a cell (mx, my) that is adjacent to the target primitive\n    # and minimizes the distance from the agent's current position.\n    \n    target_x, target_y = target_primitive_pos\n    \n    adjacent_cells_to_primitive = []\n    # Possible relative positions for adjacent cells (Left, Right, Up, Down)\n    possible_deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n\n    for dx, dy in possible_deltas:\n        adj_x, adj_y = target_x + dx, target_y + dy\n        # Check if the adjacent cell is within grid boundaries\n        if 0 <= adj_x < width and 0 <= adj_y < height:\n            adjacent_cells_to_primitive.append((adj_x, adj_y))\n\n    if not adjacent_cells_to_primitive:\n        # This case should be rare (e.g., primitive at edge of a 1x1 grid)\n        return []\n\n    best_move_to_pos = None\n    min_dist_to_move_to_pos = float('inf')\n\n    for mx, my in adjacent_cells_to_primitive:\n        dist = abs(pos[0] - mx) + abs(pos[1] - my)\n        if dist < min_dist_to_move_to_pos:\n            min_dist_to_move_to_pos = dist\n            best_move_to_pos = (mx, my)\n    \n    if best_move_to_pos is None:\n        # Should not happen if adjacent_cells_to_primitive is not empty\n        return []\n\n    # 6. Generate the sequence of movement actions to reach best_move_to_pos\n    current_x, current_y = pos[0], pos[1]\n    target_move_x, target_move_y = best_move_to_pos[0], best_move_to_pos[1]\n\n    while current_x != target_move_x or current_y != target_move_y:\n        # Greedy movement: prioritize moving along the dimension with the larger difference\n        dx = target_move_x - current_x\n        dy = target_move_y - current_y\n\n        if abs(dx) >= abs(dy):\n            if dx > 0:\n                actions.append(RIGHT)\n                current_x += 1\n            elif dx < 0:\n                actions.append(LEFT)\n                current_x -= 1\n        else: # abs(dy) > abs(dx)\n            if dy > 0:\n                actions.append(DOWN)\n                current_y += 1\n            elif dy < 0:\n                actions.append(UP)\n                current_y -= 1\n        # This simple Manhattan path does not account for obstacles.\n\n    # 7. Add the USE action once adjacent to the primitive\n    actions.append(USE)\n    return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:11:57.046917", "function_name": "collect", "function_body": "  import collections\n\n  actions_list = []\n\n  # Get the initial state from the environment.\n  # The `env` argument is a `CraftLab` instance.\n  # Its current state is accessed via `_current_state`.\n  initial_env_state = env._current_state\n\n  # Check if the primitive is already in inventory. If so, nothing to do.\n  if initial_env_state.inventory[primitive] > 0:\n    return []\n\n  # BFS for pathfinding to find the shortest sequence of actions.\n  # State in BFS queue: ((current_x, current_y), list_of_actions_to_reach_here)\n  q = collections.deque([(initial_env_state.pos, [])])\n\n  # Set of visited positions to prevent cycles and redundant exploration.\n  # We only care about (x, y) positions for BFS, as agent direction is assumed\n  # to be handled by the environment's `step` method for `USE` action.\n  visited = {initial_env_state.pos}\n\n  # Define movement actions and their corresponding (dx, dy) deltas.\n  # These constants are expected to be available from `env_factory`.\n  move_deltas = {\n      env_factory.MOVE_UP: (0, -1),   # Decreases y-coordinate (moves North)\n      env_factory.MOVE_DOWN: (0, 1),  # Increases y-coordinate (moves South)\n      env_factory.MOVE_LEFT: (-1, 0), # Decreases x-coordinate (moves West)\n      env_factory.MOVE_RIGHT: (1, 0)  # Increases x-coordinate (moves East)\n  }\n\n  # Get grid dimensions for boundary checks.\n  # Grid shape is (HEIGHT, WIDTH, N_KINDS).\n  HEIGHT, WIDTH, _ = initial_env_state.grid.shape\n\n  path_to_target_found = None # This will store the list of actions if a path is found.\n\n  while q:\n    (curr_x, curr_y), path_taken = q.popleft()\n\n    # Create a temporary CraftState to check if the primitive is collectable\n    # from the current BFS position (curr_x, curr_y).\n    # We use the original grid and other static attributes from `initial_env_state`\n    # because we are planning on the current fixed world layout.\n    temp_craft_state = initial_env_state.scenario.init()\n    temp_craft_state.grid = initial_env_state.grid # Reference to original grid, no need to copy for read-only checks\n    temp_craft_state.pos = (curr_x, curr_y)\n    temp_craft_state.dir = initial_env_state.dir # Dir is needed for CraftState init but doesn't affect `next_to` check\n    temp_craft_state.inventory = initial_env_state.inventory # Also not affecting `next_to` directly\n\n    # Check if the primitive is in the 3x3 neighborhood of the current position.\n    if temp_craft_state.next_to(primitive):\n      # If so, this position is a valid spot to perform the USE action.\n      path_to_target_found = path_taken + [env_factory.USE]\n      break # Path found, exit BFS.\n\n    # Explore possible movement actions from the current position.\n    for action_code, (dx, dy) in move_deltas.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries.\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check if the next position has already been visited in this BFS.\n      if next_pos in visited:\n        continue\n\n      # Simulate the step using a temporary CraftState to check for walkability\n      # (e.g., if the cell is an obstacle like water or stone).\n      # This ensures we only add valid moves to the queue.\n      temp_state_for_move_check = initial_env_state.scenario.init()\n      temp_state_for_move_check.grid = initial_env_state.grid\n      temp_state_for_move_check.pos = (curr_x, curr_y)\n      temp_state_for_move_check.dir = initial_env_state.dir\n      temp_state_for_move_check.inventory = initial_env_state.inventory\n\n      _, state_after_simulated_move = temp_state_for_move_check.step(action_code)\n\n      # If the position actually changed, it means the move was valid and not blocked.\n      if state_after_simulated_move.pos != (curr_x, curr_y):\n        visited.add(next_pos)\n        q.append((next_pos, path_taken + [action_code]))\n\n  # If a path to collect the primitive was found, execute it on the actual environment.\n  if path_to_target_found:\n    for action in path_to_target_found:\n      # Perform the action in the actual CraftLab environment.\n      # We don't need reward, done, or observation for this function's return, but keep the call.\n      _, _, _ = env.step(action)\n      actions_list.append(action)\n\n      # After each action (especially after a USE action), check if the primitive is collected.\n      # This handles cases where the primitive might be collected earlier than the very end of the planned path.\n      if env._current_state.inventory[primitive] > 0:\n        return actions_list\n\n  # After attempting to execute the path, check the inventory one last time.\n  if env._current_state.inventory[primitive] > 0:\n    return actions_list\n  else:\n    # If the primitive was not collected after executing the path, return an empty list.\n    # This indicates failure to collect despite attempting a path.\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:13:08.134716", "function_name": "collect", "function_body": "    # Assuming action constants as per problem description (or common DMLab usage)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Get the current state from the environment's internal representation\n    # This relies on accessing the private attribute _current_state of CraftLab.\n    # In a real DMLab environment, one would typically derive state from observations().\n    state = env._current_state\n\n    # 1. Check if the primitive is already in the inventory\n    if state.inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions and indices for non-grabbable entities\n    HEIGHT, WIDTH, _ = state.grid.shape\n    non_grabbable_indices = state.world.non_grabbable_indices\n\n    # 2. Find all locations of the target primitive on the grid\n    primitive_locations = []\n    for r in range(HEIGHT):\n        for c in range(WIDTH):\n            if state.grid[r, c, primitive] > 0:\n                primitive_locations.append((c, r)) # Store as (col, row)\n\n    if not primitive_locations:\n        # Primitive not found on the map, cannot collect\n        return []\n\n    # Determine the closest primitive location using Manhattan distance\n    start_c, start_r = state.pos\n    closest_primitive_loc = None\n    min_dist = float('inf')\n    for pc, pr in primitive_locations:\n        dist = abs(pc - start_c) + abs(pr - start_r)\n        if dist < min_dist:\n            min_dist = dist\n            closest_primitive_loc = (pc, pr)\n\n    target_c, target_r = closest_primitive_loc\n\n    # 3. Determine traversable adjacent cells to the target primitive\n    # These are the cells the agent needs to reach before performing 'USE'\n    adj_cells_to_target = [\n        (target_c, target_r + 1), (target_c, target_r - 1),  # (col, row +/- 1)\n        (target_c + 1, target_r), (target_c - 1, target_r)   # (col +/- 1, row)\n    ]\n    traversable_adj_target_cells = []\n\n    for ac, ar in adj_cells_to_target:\n        # Check bounds\n        if not (0 <= ar < HEIGHT and 0 <= ac < WIDTH):\n            continue\n\n        # Check if cell is traversable (doesn't contain a non-grabbable block)\n        is_traversable = True\n        for kind_idx in non_grabbable_indices:\n            if state.grid[ar, ac, kind_idx] > 0:\n                is_traversable = False\n                break\n        \n        # The agent cannot step onto the primitive itself to collect it\n        if ac == target_c and ar == target_r:\n            is_traversable = False\n\n        if is_traversable:\n            traversable_adj_target_cells.append((ac, ar))\n\n    if not traversable_adj_target_cells:\n        # No traversable adjacent cell to the primitive found\n        return []\n\n    # 4. Use BFS to find a path from the agent's current position to any traversable adjacent cell\n    # BFS state: (current_col, current_row, current_direction, path_actions_so_far)\n    queue = [(start_c, start_r, state.dir, [])]\n    visited = set([(start_c, start_r, state.dir)])\n\n    # Define effects of movement actions: (delta_col, delta_row, new_direction_facing)\n    # Directions: 0=East, 1=South, 2=West, 3=North\n    action_effects = {\n        DOWN: (0, 1, 1),   # Move South (+row), face South\n        UP: (0, -1, 3),    # Move North (-row), face North\n        LEFT: (-1, 0, 2),  # Move West (-col), face West\n        RIGHT: (1, 0, 0)   # Move East (+col), face East\n    }\n\n    path_to_adj = []\n    final_agent_c, final_agent_r, final_agent_dir = None, None, None\n\n    # Safety limit for BFS path length to prevent very long computations\n    MAX_PATH_LENGTH = 100 \n\n    while queue:\n        current_c, current_r, current_dir, current_path = queue.pop(0)\n\n        # Check if the current position is one of the target adjacent cells\n        if (current_c, current_r) in traversable_adj_target_cells:\n            path_to_adj = current_path\n            final_agent_c, final_agent_r, final_agent_dir = current_c, current_r, current_dir\n            break # Path to an adjacent cell found\n\n        # Prune paths that are too long\n        if len(current_path) >= MAX_PATH_LENGTH:\n            continue\n\n        # Explore possible movement actions\n        for action_move, (dc, dr, new_dir_facing) in action_effects.items():\n            next_c, next_r = current_c + dc, current_r + dr\n\n            # Check if the next cell is within grid bounds\n            if not (0 <= next_r < HEIGHT and 0 <= next_c < WIDTH):\n                continue\n            \n            # Check if the next cell is traversable (doesn't contain a non-grabbable block)\n            is_traversable_next_cell = True\n            for kind_idx in non_grabbable_indices:\n                if state.grid[next_r, next_c, kind_idx] > 0:\n                    is_traversable_next_cell = False\n                    break\n            if not is_travis_traversable_next_cell:\n                continue\n\n            # Add to queue if not visited\n            if (next_c, next_r, new_dir_facing) not in visited:\n                visited.add((next_c, next_r, new_dir_facing))\n                queue.append((next_c, next_r, new_dir_facing, current_path + [action_move]))\n\n    full_action_sequence = []\n    if path_to_adj:\n        full_action_sequence.extend(path_to_adj)\n\n        # 5. After reaching an adjacent cell, turn to face the primitive and USE\n        \n        # Calculate the relative position of the primitive from the agent's final position\n        delta_c = target_c - final_agent_c\n        delta_r = target_r - final_agent_r\n\n        target_facing_dir = -1\n        if delta_c == 1 and delta_r == 0:   # Primitive is East of agent\n            target_facing_dir = 0           # Agent needs to face East (dir=0)\n        elif delta_c == -1 and delta_r == 0: # Primitive is West of agent\n            target_facing_dir = 2           # Agent needs to face West (dir=2)\n        elif delta_r == 1 and delta_c == 0: # Primitive is South of agent\n            target_facing_dir = 1           # Agent needs to face South (dir=1)\n        elif delta_r == -1 and delta_c == 0: # Primitive is North of agent\n            target_facing_dir = 3           # Agent needs to face North (dir=3)\n        \n        # If the primitive is directly adjacent (should always be true here)\n        if target_facing_dir != -1:\n            current_agent_dir = final_agent_dir\n            \n            # Calculate minimal turns needed\n            # (target_dir - current_dir + 4) % 4 gives turns clockwise (RIGHT)\n            diff = (target_facing_dir - current_agent_dir + 4) % 4\n            \n            if diff == 1: # One RIGHT turn\n                full_action_sequence.append(RIGHT)\n            elif diff == 2: # Two RIGHT turns (or two LEFT turns, pick one)\n                full_action_sequence.append(RIGHT)\n                full_action_sequence.append(RIGHT)\n            elif diff == 3: # One LEFT turn\n                full_action_sequence.append(LEFT)\n            \n            full_action_sequence.append(USE) # Perform the USE action to collect\n\n        return full_action_sequence\n    else:\n        # No path found to any traversable adjacent cell within MAX_PATH_LENGTH\n        return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:13:08.205651", "function_name": "collect", "function_body": "    current_state = env._current_state\n    grid = current_state.grid\n    agent_pos = current_state.pos\n    inventory = current_state.inventory\n    width, height, n_kinds = grid.shape\n\n    # Define action mappings for clarity\n    ACTIONS = {\n        \"DOWN\": 0, \"UP\": 1, \"LEFT\": 2, \"RIGHT\": 3, \"USE\": 4\n    }\n    MOVE_DIRECTION_TO_ACTION = {\n        (1, 0): ACTIONS[\"DOWN\"],   # (dr, dc) for Down movement\n        (-1, 0): ACTIONS[\"UP\"],    # (dr, dc) for Up movement\n        (0, -1): ACTIONS[\"LEFT\"],  # (dr, dc) for Left movement\n        (0, 1): ACTIONS[\"RIGHT\"],  # (dr, dc) for Right movement\n    }\n\n    # 1. Check if the primitive is already in inventory\n    if inventory[primitive] > 0:\n        return []\n\n    # 2. Find all grid locations where the primitive exists\n    primitive_locations = []\n    for r in range(width):\n        for c in range(height):\n            if grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    # If the primitive is not found anywhere on the grid, it cannot be collected\n    if not primitive_locations:\n        return []\n\n    # Helper function to check if a given position is adjacent (not diagonal) to any primitive location\n    def is_adjacent_to_primitive(pos, p_locs):\n        r, c = pos\n        for pr, pc in p_locs:\n            # Manhattan distance of 1 indicates direct adjacency (up, down, left, or right)\n            if abs(r - pr) + abs(c - pc) == 1:\n                return True\n        return False\n\n    # 3. Use Breadth-First Search (BFS) to find the shortest path\n    # The queue stores tuples of (current_position, list_of_actions_to_reach_here)\n    queue = [(agent_pos, [])]\n    # Keep track of visited positions to prevent infinite loops and redundant paths\n    visited = {agent_pos}\n\n    # Identify non-passable entities (like water, workshops, etc.) from the world configuration.\n    # We assume `non_grabbable_indices` are generally non-passable obstacles.\n    non_passable_indices = env.world.non_grabbable_indices\n\n    while queue:\n        current_pos, path_actions = queue.pop(0)\n        r, c = current_pos\n\n        # If the current position is adjacent to a primitive, we've found a path\n        # The next action will be 'USE' to collect it.\n        if is_adjacent_to_primitive(current_pos, primitive_locations):\n            return path_actions + [ACTIONS[\"USE\"]]\n\n        # Explore all four cardinal neighbors (Up, Down, Left, Right)\n        for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n            next_r, next_c = r + dr, c + dc\n            next_pos = (next_r, next_c)\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= next_r < width and 0 <= next_c < height):\n                continue\n\n            # Check if this position has already been visited\n            if next_pos in visited:\n                continue\n\n            # Check if the next cell contains a non-passable obstacle.\n            # We can move into cells that contain the target primitive itself (even if it's grabbable,\n            # we're only interested in *other* non-passable items as obstacles).\n            is_occupied_by_obstacle = False\n            for k_idx in non_passable_indices:\n                # If the cell is occupied by a non-passable item and it's not the primitive we're looking for\n                if grid[next_r, next_c, k_idx] > 0 and k_idx != primitive:\n                    is_occupied_by_obstacle = True\n                    break\n            if is_occupied_by_obstacle:\n                continue\n\n            # If the cell is valid and unvisited, add it to the queue\n            visited.add(next_pos)\n            action_to_reach_next_pos = MOVE_DIRECTION_TO_ACTION[(dr, dc)]\n            queue.append((next_pos, path_actions + [action_to_reach_next_pos]))\n\n    # If the BFS completes and no path is found (e.g., primitive is unreachable)\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:14:53.683871", "function_name": "collect", "function_body": "  import collections\n\n  # Get necessary info from the environment and world\n  current_state = env._current_state\n  world = env.world\n  action_map = env.action_specs()\n\n  # Check if primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Map action names to their integer values for clarity\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each movement action\n  # Assuming UP: -1 row, DOWN: +1 row, LEFT: -1 col, RIGHT: +1 col\n  DELTAS = {\n      UP_ACTION: (-1, 0),\n      DOWN_ACTION: (1, 0),\n      LEFT_ACTION: (0, -1),\n      RIGHT_ACTION: (0, 1),\n  }\n\n  grid_height, grid_width, _ = current_state.grid.shape\n  start_pos_r, start_pos_c = current_state.pos\n\n  # Define impassable kinds. These are entities the agent cannot move onto.\n  # Based on the descriptions, `non_grabbable_indices` are used as impassable.\n  impassable_indices_set = world.non_grabbable_indices\n\n  # Helper function to check if a cell is traversable\n  def is_traversable(r, c):\n      # Check bounds\n      if not (0 <= r < grid_height and 0 <= c < grid_width):\n          return False\n      # Check if any impassable kind is at this cell\n      # current_state.grid[r, c] contains counts for all kinds at (r,c)\n      for kind_idx in impassable_indices_set:\n          if current_state.grid[r, c, kind_idx] > 0:\n              return False\n      return True\n\n  # Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for r in range(grid_height):\n      for c in range(grid_width):\n          if current_state.grid[r, c, primitive] > 0:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      # Primitive not found on the grid, cannot collect\n      return []\n\n  # BFS to find the shortest path to a cell *adjacent* to any primitive location\n  # BFS queue stores: ((current_row, current_col), list_of_actions_to_reach_here)\n  q = collections.deque([((start_pos_r, start_pos_c), [])])\n  visited = {(start_pos_r, start_pos_c)} # Store visited (r, c) tuples to avoid cycles\n\n  found_path_to_adj = False\n  final_movement_path = []\n\n  while q and not found_path_to_adj:\n      (curr_r, curr_c), path = q.popleft()\n\n      # Check if the current position is adjacent to any of the primitive locations\n      # A cell (curr_r, curr_c) is adjacent to (prim_r, prim_c) if their Manhattan distance is 1.\n      for prim_r, prim_c in primitive_locations:\n          if abs(curr_r - prim_r) + abs(curr_c - prim_c) == 1:\n              final_movement_path = path\n              found_path_to_adj = True\n              break # Found an adjacent primitive, stop searching neighbors for this path\n      \n      if found_path_to_adj:\n          break # Path found, exit the BFS\n\n      # Explore neighbors\n      for action_val, (dr, dc) in DELTAS.items():\n          next_r, next_c = curr_r + dr, curr_c + dc\n          next_pos_tuple = (next_r, next_c)\n\n          if is_traversable(next_r, next_c) and next_pos_tuple not in visited:\n              visited.add(next_pos_tuple)\n              q.append((next_pos_tuple, path + [action_val]))\n\n  if not found_path_to_adj:\n      # No path found to any cell adjacent to a primitive\n      return []\n\n  # If a path to an adjacent cell is found, append the USE action.\n  # This assumes the USE action will succeed if the agent is adjacent to the primitive,\n  # irrespective of its facing direction (as explicit turn actions are not provided).\n  return final_movement_path + [USE_ACTION]", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:14:54.683580", "function_name": "collect", "function_body": "  state = env._current_state\n\n  # 1. Check if the primitive is already in the inventory\n  if state.inventory[primitive] > 0:\n    return []\n\n  actions = []\n\n  # Get current agent position and grid dimensions\n  agent_x, agent_y = state.pos\n  grid = state.grid\n  width, height, _ = grid.shape\n\n  # 2. Find the closest primitive on the grid\n  target_x, target_y = -1, -1\n  min_dist_to_primitive = float('inf')\n\n  for x in range(width):\n    for y in range(height):\n      # Check if the primitive is at this location\n      if grid[x, y, primitive] > 0:\n        dist = abs(x - agent_x) + abs(y - agent_y)\n        if dist < min_dist_to_primitive:\n          min_dist_to_primitive = dist\n          target_x, target_y = x, y\n\n  # If primitive not found on the grid, return an empty list\n  if target_x == -1:\n    return []\n\n  # 3. Determine the best adjacent cell to move to and the required final facing direction\n  # We need to position the agent at an adjacent cell and ensure its final movement action\n  # aligns its facing direction towards the target (for the USE action).\n  # `(adj_x, adj_y, final_move_action_that_sets_direction)`\n  potential_adj_cells_and_facing = []\n\n  # Agent needs to be at (tx, ty+1) to face North (UP action) towards (tx,ty)\n  potential_adj_cells_and_facing.append((target_x, target_y + 1, env_factory.UP))\n  # Agent needs to be at (tx-1, ty) to face East (RIGHT action) towards (tx,ty)\n  potential_adj_cells_and_facing.append((target_x - 1, target_y, env_factory.RIGHT))\n  # Agent needs to be at (tx, ty-1) to face South (DOWN action) towards (tx,ty)\n  potential_adj_cells_and_facing.append((target_x, target_y - 1, env_factory.DOWN))\n  # Agent needs to be at (tx+1, ty) to face West (LEFT action) towards (tx,ty)\n  potential_adj_cells_and_facing.append((target_x + 1, target_y, env_factory.LEFT))\n\n  best_adj_x, best_adj_y = -1, -1\n  final_move_action = -1\n  min_dist_to_adj_cell = float('inf')\n\n  # Find the closest valid adjacent cell from which to face the target\n  for ax, ay, move_action in potential_adj_cells_and_facing:\n    # Check if the adjacent cell is within grid bounds\n    if 0 <= ax < width and 0 <= ay < height:\n      dist = abs(ax - agent_x) + abs(ay - agent_y)\n      if dist < min_dist_to_adj_cell:\n        min_dist_to_adj_cell = dist\n        best_adj_x, best_adj_y = ax, ay\n        final_move_action = move_action\n\n  # If no valid adjacent cell found (e.g., target is at the edge and all adj cells are out of bounds)\n  if best_adj_x == -1:\n    return []\n\n  # 4. Calculate the intermediate position (prev_x, prev_y)\n  # This is the cell from which the `final_move_action` will take the agent to `(best_adj_x, best_adj_y)`.\n  prev_x, prev_y = best_adj_x, best_adj_y\n  if final_move_action == env_factory.UP:\n    prev_y += 1\n  elif final_move_action == env_factory.RIGHT:\n    prev_x -= 1\n  elif final_move_action == env_factory.DOWN:\n    prev_y -= 1\n  elif final_move_action == env_factory.LEFT:\n    prev_x += 1\n  else:\n    # This case should ideally not be reached if final_move_action is set correctly\n    return []\n\n  # 5. Path from current agent position to the intermediate position (prev_x, prev_y)\n  # This uses a simple X-then-Y movement strategy.\n  dx_to_prev = prev_x - agent_x\n  dy_to_prev = prev_y - agent_y\n\n  for _ in range(abs(dx_to_prev)):\n    if dx_to_prev > 0:\n      actions.append(env_factory.RIGHT)\n    else:\n      actions.append(env_factory.LEFT)\n\n  for _ in range(abs(dy_to_prev)):\n    if dy_to_prev > 0:\n      actions.append(env_factory.DOWN)\n    else:\n      actions.append(env_factory.UP)\n\n  # 6. Add the final movement action to reach `(best_adj_x, best_adj_y)` and set facing direction\n  actions.append(final_move_action)\n\n  # 7. Add the USE action to interact with the primitive\n  actions.append(env_factory.USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:16:20.049767", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Define action constants based on CraftLab.action_specs()\n    # Assuming these are fixed integer values as per typical DMLab interfaces\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Helper functions defined locally to strictly fit \"inside the function\"\n    def _get_next_pos_and_dir(current_pos, current_dir, action, grid_shape):\n        \"\"\"\n        Calculates the potential new position and direction after taking an action.\n        Returns (new_pos, new_dir) or (None, None) if out of bounds for movement.\n        \"\"\"\n        r, c = current_pos\n        rows, cols, _ = grid_shape\n        \n        new_r, new_c = r, c\n        new_dir = current_dir\n\n        if action == UP: # Move forward\n            if current_dir == 0: new_r -= 1 # North (Up)\n            elif current_dir == 1: new_c += 1 # East (Right)\n            elif current_dir == 2: new_r += 1 # South (Down)\n            elif current_dir == 3: new_c -= 1 # West (Left)\n        elif action == DOWN: # Move backward\n            if current_dir == 0: new_r += 1\n            elif current_dir == 1: new_c -= 1\n            elif current_dir == 2: new_r -= 1\n            elif current_dir == 3: new_c += 1\n        elif action == LEFT: # Turn left\n            new_dir = (current_dir - 1 + 4) % 4\n        elif action == RIGHT: # Turn right\n            new_dir = (current_dir + 1) % 4\n        \n        # Check bounds only for movement actions. Turning does not change position.\n        if action in [UP, DOWN]:\n            if not (0 <= new_r < rows and 0 <= new_c < cols):\n                return None, None # Out of bounds\n        \n        return (new_r, new_c), new_dir\n\n    def _get_direction_to_face(current_pos, target_pos):\n        \"\"\"\n        Calculates the cardinal direction (0-3) from current_pos to target_pos.\n        Assumes target_pos is a direct cardinal neighbor.\n        \"\"\"\n        dr = target_pos[0] - current_pos[0]\n        dc = target_pos[1] - current_pos[1]\n\n        if dr == -1 and dc == 0: return 0  # North (target is up)\n        if dr == 0 and dc == 1: return 1   # East (target is right)\n        if dr == 1 and dc == 0: return 2   # South (target is down)\n        if dr == 0 and dc == -1: return 3  # West (target is left)\n        return -1 # Not a direct cardinal neighbor\n\n    def _get_turning_actions(current_dir, target_dir):\n        \"\"\"\n        Returns a list of LEFT/RIGHT actions to turn from current_dir to target_dir.\n        Prioritizes shorter turns (e.g., a single LEFT vs. three RIGHTs).\n        \"\"\"\n        if current_dir == target_dir:\n            return []\n\n        # Calculate clockwise and counter-clockwise distances\n        cw_dist = (target_dir - current_dir + 4) % 4\n        ccw_dist = (current_dir - target_dir + 4) % 4\n\n        actions = []\n        if cw_dist <= ccw_dist: # Prefer right turns or if equal distance\n            for _ in range(cw_dist):\n                actions.append(RIGHT)\n        else: # Prefer left turns\n            for _ in range(ccw_dist):\n                actions.append(LEFT)\n        return actions\n\n    obs = env.observations()\n    state = obs['features_dict'] # This is the structured CraftState data\n    current_pos = tuple(state['pos']) # Convert to tuple for hashing in set\n    current_dir = np.argmax(state['direction']) # Convert one-hot to integer\n    grid = state['features_global']\n    inventory = state['inventory']\n\n    # 1. Check if primitive is already collected\n    if inventory[primitive] > 0:\n        return []\n\n    rows, cols, _ = grid.shape\n\n    # Get non-grabbable items that act as obstacles (e.g., water, workshops)\n    # The `environment` set from Cookbook contains indices of non-grabbable entities.\n    # We assume any cell containing these is an obstacle for movement.\n    non_walkable_kinds = set(env.world.non_grabbable_indices)\n    \n    # BFS Initialization\n    q = collections.deque()\n    # visited set stores (position, direction) to avoid cycles and redundant paths\n    visited = set()\n\n    # Start BFS from current state: (position, direction, path_actions_taken)\n    q.append((current_pos, current_dir, []))\n    visited.add((current_pos, current_dir))\n\n    while q:\n        pos, direction, path_actions = q.popleft()\n\n        # Check if any adjacent cell to the current 'pos' contains the primitive.\n        # If so, this is a potential collection point.\n        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Cardinal neighbors relative to agent\n            neighbor_r, neighbor_c = pos[0] + dr, pos[1] + dc\n            \n            if 0 <= neighbor_r < rows and 0 <= neighbor_c < cols:\n                # Check if this neighbor cell contains the primitive\n                if grid[neighbor_r, neighbor_c, primitive] > 0:\n                    # Found the primitive in an adjacent cell!\n                    # Calculate actions to turn to face it, then USE.\n                    target_dir = _get_direction_to_face(pos, (neighbor_r, neighbor_c))\n                    \n                    if target_dir != -1: # Ensure it's a cardinal neighbor (should always be)\n                        turn_actions = _get_turning_actions(direction, target_dir)\n                        return path_actions + turn_actions + [USE]\n\n        # If no primitive found in adjacent cells, explore movement actions\n        # UP, DOWN, LEFT, RIGHT are moves or turns\n        for action in [UP, DOWN, LEFT, RIGHT]:\n            new_pos, new_dir = _get_next_pos_and_dir(pos, direction, action, grid.shape)\n\n            if new_pos is None: # Out of bounds move\n                continue\n\n            is_obstacle = False\n            # Only check for obstacles if the agent is attempting to move to a new cell\n            if action in [UP, DOWN]: \n                # A cell is considered an obstacle if it contains any non-walkable kind\n                for kind_idx in non_walkable_kinds:\n                    if grid[new_pos[0], new_pos[1], kind_idx] > 0:\n                        is_obstacle = True\n                        break\n            \n            if is_obstacle:\n                continue\n\n            # If the new state (position, direction) has not been visited, add to queue\n            if (new_pos, new_dir) not in visited:\n                visited.add((new_pos, new_dir))\n                q.append((new_pos, new_dir, path_actions + [action]))\n\n    # If the BFS completes and no path is found to collect the primitive\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:16:20.119624", "function_name": "collect", "function_body": "    state = env._current_state\n\n    # If the primitive is already in the inventory, no actions are needed\n    if state.inventory[primitive] > 0:\n        return []\n\n    # Get action mappings from the environment\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    actions = []\n\n    # Find the primitive on the grid\n    target_pos = None\n    min_dist = float('inf')\n\n    # Get grid dimensions and current agent position\n    grid_height, grid_width, _ = state.grid.shape\n    agent_r, agent_c = state.pos\n\n    # Iterate through the grid to find the closest instance of the primitive\n    for r in range(grid_height):\n        for c in range(grid_width):\n            # Check if the current cell contains the primitive (value > 0)\n            if state.grid[r, c, primitive] > 0:\n                # Calculate Manhattan distance to prioritize closer primitives\n                dist = abs(r - agent_r) + abs(c - agent_c)\n                if dist < min_dist:\n                    min_dist = dist\n                    target_pos = (r, c)\n\n    # If the primitive is not found anywhere on the grid, return an empty list\n    if target_pos is None:\n        return []\n\n    # Once the target position is found, plan actions to move to it\n    target_r, target_c = target_pos\n\n    # Generate vertical movement actions\n    while agent_r != target_r:\n        if agent_r < target_r:\n            actions.append(DOWN)\n            agent_r += 1  # Simulate agent movement for path planning\n        else:  # agent_r > target_r\n            actions.append(UP)\n            agent_r -= 1  # Simulate agent movement for path planning\n\n    # Generate horizontal movement actions\n    while agent_c != target_c:\n        if agent_c < target_c:\n            actions.append(RIGHT)\n            agent_c += 1  # Simulate agent movement for path planning\n        else:  # agent_c > target_c\n            actions.append(LEFT)\n            agent_c -= 1  # Simulate agent movement for path planning\n\n    # After moving, the agent should be at the target cell (or an adjacent cell,\n    # if the primitive was already adjacent and movement loops didn't run).\n    # The 'USE' action applies to the 3x3 neighborhood around the agent,\n    # so being on the target cell itself is sufficient to \"use\" it.\n    actions.append(USE)\n\n    return actions", "island_id": 9, "scores": {"3": -1}}
