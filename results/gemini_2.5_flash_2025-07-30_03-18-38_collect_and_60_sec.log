{"timestamp": "2025-07-30T12:10:51.653719", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position).\n  # These define the change in coordinates when moving in a specific direction,\n  # and also represent the cell \"in front\" of the agent when facing that direction.\n  DIR_VEC = {\n      0: (0, -1), # UP (y decreases)\n      1: (1, 0),  # RIGHT (x increases)\n      2: (0, 1),  # DOWN (y increases)\n      3: (-1, 0)  # LEFT (x decreases)\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  current_state = env._current_state\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  non_grabbable_indices = env.world.non_grabbable_indices\n  \n  # Optimization: Pre-compute a boolean walkable map.\n  # A cell is considered unwalkable if it contains any non-grabbable item.\n  walkable_map = np.ones((grid_width, grid_height), dtype=bool)\n  \n  for k_idx in non_grabbable_indices:\n    # Find all cells containing this specific non-grabbable item\n    obstacle_coords = np.argwhere(grid[:, :, k_idx] == 1)\n    for ox, oy in obstacle_coords:\n        walkable_map[ox, oy] = False # Mark these cells as unwalkable\n\n  # Helper function to check if a grid cell is within bounds and walkable.\n  def is_walkable(x, y):\n    # Check bounds first\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Then use the pre-computed walkable map\n    return walkable_map[x, y]\n\n  # 2. Identify all target states (position, direction) from which the primitive can be collected.\n  # A target state is (agent_x, agent_y, agent_dir) such that the primitive is directly\n  # in front of the agent (i.e., at (agent_x + dx_facing, agent_y + dy_facing)).\n  target_states = set()\n  # Find all (x, y) coordinates where the primitive kind exists on the grid.\n  primitive_locations = np.argwhere(grid[:, :, primitive] == 1) \n\n  for px, py in primitive_locations:\n    # For each primitive location (px, py), consider all 4 adjacent cells.\n    # From each adjacent cell, the agent needs to face (px, py).\n    for dir_idx, (dx_facing, dy_facing) in DIR_VEC.items():\n      # Calculate the required agent position (ax, ay) to face (px, py).\n      # If agent is at (ax, ay) and faces (dx_facing, dy_facing), then (ax + dx_facing, ay + dy_facing) must be (px, py).\n      # So, ax = px - dx_facing, ay = py - dy_facing\n      ax, ay = px - dx_facing, py - dy_facing\n      \n      # Check if this potential agent position is within bounds and walkable.\n      if is_walkable(ax, ay):\n        target_states.add((ax, ay, dir_idx))\n\n  # If no primitive is found on the map, or no reachable spot to collect it, return an empty path.\n  if not target_states:\n    return []\n\n  # 3. Breadth-First Search (BFS) to find the shortest path of actions to any target state.\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_to_reach_here)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n  # Visited set to avoid redundant exploration and cycles. A state is defined by (x, y, direction).\n  visited = set([(start_x, start_y, start_dir)]) \n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Goal Check: If the current agent state (position and direction) matches\n    # one of our pre-calculated target collection states, we've found a solution.\n    if (curr_x, curr_y, curr_dir) in target_states:\n      return path_actions + [ACTION_USE] # Append the USE action and return the complete sequence.\n\n    # Explore possible next states by applying movement actions.\n    # CraftLab movement actions (UP, DOWN, LEFT, RIGHT) also set the agent's facing direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the change in coordinates for the given movement action.\n      # The direction of movement is ACTION_TO_DIR[action].\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]] \n      \n      # Calculate the new position after the movement.\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      \n      # The new facing direction is the direction of the movement itself.\n      next_dir = ACTION_TO_DIR[action] \n\n      # If the new cell is walkable and this specific (position, direction) state\n      # has not been visited yet, add it to the queue for further exploration.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the BFS queue becomes empty and no path to any target state was found,\n  # it means the primitive is unreachable.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:10:52.640354", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (copied for self-containment and clarity within the function)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement actions to the direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  # This reflects that the agent faces the direction it moves.\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position).\n  # These also represent the offset to the cell \"in front\" of the agent when facing that direction.\n  DIR_VEC = {\n      0: (0, -1), # UP (y decreases)\n      1: (1, 0),  # RIGHT (x increases)\n      2: (0, 1),  # DOWN (y increases)\n      3: (-1, 0)  # LEFT (x decreases)\n  }\n\n  # 1. Pre-checks and Initialization\n  # A primitive cannot be \"collected\" via the 'USE' action if it's not a grabbable item.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  current_state = env._current_state\n  start_x, start_y = current_state.pos  # Agent's initial (x, y) position\n  start_dir = current_state.dir        # Agent's initial facing direction (0-3)\n  grid = current_state.grid            # The current grid layout\n  grid_width, grid_height, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices # Indices of items that block movement\n\n  # Optimization: Pre-calculate a boolean mask indicating walkable cells on the grid.\n  # This avoids repeated iteration over 'non_grabbable_indices' for each 'is_walkable' call.\n  walkable_mask = np.ones((grid_width, grid_height), dtype=bool)\n  for k_idx in non_grabbable_indices:\n    # Mark cells containing any non-grabbable item as unwalkable.\n    walkable_mask[grid[:, :, k_idx] == 1] = False\n\n  # Helper function to check if a grid cell is within bounds and walkable (not an obstacle).\n  def is_walkable(x, y):\n    # First, ensure the coordinates are within the grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Then, use the pre-computed mask for an O(1) check for obstacles.\n    return walkable_mask[x, y]\n\n  # 2. Identify all potential \"target states\" (agent_x, agent_y, agent_dir)\n  # from which the 'USE' action can successfully collect the primitive.\n  target_states = set()\n  # Find all (x, y) coordinates on the grid where the primitive kind currently exists.\n  primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n\n  for px, py in primitive_locations:\n    # For each primitive found at (px, py), determine all possible agent positions (ax, ay)\n    # and facing directions (dir_idx) that would allow the 'USE' action to target (px, py).\n    # The 'USE' action interacts with the cell immediately in front of the agent.\n    # If the primitive is at (px, py) and the agent is at (ax, ay) facing (dx_facing, dy_facing),\n    # then (ax + dx_facing, ay + dy_facing) must equal (px, py).\n    # Therefore, ax = px - dx_facing and ay = py - dy_facing.\n    for dir_idx, (dx_facing, dy_facing) in DIR_VEC.items():\n      ax, ay = px - dx_facing, py - dy_facing # Calculate the required agent position\n\n      # If this calculated agent position is valid (within bounds and walkable),\n      # then this (agent_x, agent_y, agent_direction) tuple is a valid target state.\n      if is_walkable(ax, ay):\n        target_states.add((ax, ay, dir_idx))\n\n  # If no primitive instances are found on the map, or if all are in unreachable spots,\n  # there's no sequence of actions that can collect it.\n  if not target_states:\n    return []\n\n  # 3. Breadth-First Search (BFS) to find the shortest sequence of actions\n  # from the current agent state to any of the identified target states.\n  # The queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken_to_reach_here)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n  # The 'visited' set keeps track of (x, y, dir) states already explored.\n  # This prevents revisiting states, ensuring the shortest path is found and avoiding infinite loops.\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the current state (position and direction) matches any of our target states.\n    # If it does, we've found the shortest path to a position from which the primitive can be collected.\n    if (curr_x, curr_y, curr_dir) in target_states:\n      return path_actions + [ACTION_USE] # Append the final 'USE' action and return the complete sequence.\n\n    # Explore all possible movement actions (UP, RIGHT, DOWN, LEFT).\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Determine the new position and facing direction after applying this action.\n      # The agent moves in the direction of the action and then faces that direction.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # Agent's new facing direction\n\n      # If the new state (position and direction) is walkable and has not been visited yet,\n      # add it to the queue for further exploration.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        # Add the new state to the queue, extending the path with the current action.\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the BFS completes and the queue becomes empty without finding any target state,\n  # it means the primitive is unreachable from the starting position given current obstacles.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:12:17.603833", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get current observation from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  # `pos` is a normalized numpy array, convert to integer tuple (row, col)\n  pos = tuple(obs['features_dict']['pos'].astype(int))\n  inventory = obs['features_dict']['inventory']\n  # `direction` is a one-hot array, convert to integer (0:N, 1:E, 2:S, 3:W, based on DMLab convention)\n  current_dir_one_hot = obs['features_dict']['direction']\n  current_dir_int = np.where(current_dir_one_hot == 1)[0][0]\n\n  # 2. Check if the primitive is already in the inventory\n  if inventory[primitive] > 0:\n    return []\n\n  # 3. Find all locations of the target primitive in the global grid\n  primitive_locations = np.where(grid[:, :, primitive] == 1)\n  \n  if len(primitive_locations[0]) == 0:\n    # Primitive not found in the grid, so it cannot be collected\n    return []\n\n  # Find the closest primitive instance using Manhattan distance\n  min_dist = float('inf')\n  target_r, target_c = -1, -1\n  for i in range(len(primitive_locations[0])):\n    r_loc = primitive_locations[0][i]\n    c_loc = primitive_locations[1][i]\n    dist = abs(r_loc - pos[0]) + abs(c_loc - pos[1]) # Manhattan distance\n    if dist < min_dist:\n      min_dist = dist\n      target_r, target_c = r_loc, c_loc\n\n  # 4. Determine the best adjacent cell to move to and the required facing direction\n  # Directions map: 0:North, 1:East, 2:South, 3:West\n  # (adj_r, adj_c) is the cell the agent moves to, face_dir is the direction agent faces from that cell\n  # to look at the target_r, target_c\n  candidates = [\n      ((target_r + 1, target_c), 0),  # Agent moves to South of target, faces North (0)\n      ((target_r - 1, target_c), 2),  # Agent moves to North of target, faces South (2)\n      ((target_r, target_c + 1), 3),  # Agent moves to West of target, faces West (3)\n      ((target_r, target_c - 1), 1)   # Agent moves to East of target, faces East (1)\n  ]\n\n  best_adj_pos = None\n  best_face_dir = -1\n  min_adj_dist = float('inf')\n\n  for (adj_r, adj_c), face_dir in candidates:\n    # Check if the adjacent cell is within grid boundaries\n    if not (0 <= adj_r < grid.shape[0] and 0 <= adj_c < grid.shape[1]):\n      continue\n    \n    # Calculate Manhattan distance from current agent position to this adjacent cell\n    dist_to_adj = abs(adj_r - pos[0]) + abs(adj_c - pos[1])\n    if dist_to_adj < min_adj_dist:\n      min_adj_dist = dist_to_adj\n      best_adj_pos = (adj_r, adj_c)\n      best_face_dir = face_dir\n\n  if best_adj_pos is None:\n    # This case implies no valid adjacent cell could be found (e.g., target at map edge)\n    return []\n\n  # 5. Generate movement actions to reach the `best_adj_pos`\n  # Simulate the agent's position for path planning\n  current_r_sim, current_c_sim = pos\n\n  # Move vertically first\n  while current_r_sim != best_adj_pos[0]:\n    if current_r_sim < best_adj_pos[0]:\n      actions.append(0)  # DOWN (increases row index)\n      current_r_sim += 1\n    else:\n      actions.append(1)  # UP (decreases row index)\n      current_r_sim -= 1\n\n  # Then move horizontally\n  while current_c_sim != best_adj_pos[1]:\n    if current_c_sim < best_adj_pos[1]:\n      actions.append(3)  # RIGHT (increases column index)\n      current_c_sim += 1\n    else:\n      actions.append(2)  # LEFT (decreases column index)\n      current_c_sim -= 1\n\n  # 6. Generate turning actions to face the primitive from the `best_adj_pos`\n  # Action mapping for turns: LEFT=2, RIGHT=3\n  # Calculate the difference in directions (modulo 4 for cyclic difference)\n  turns_needed = (best_face_dir - current_dir_int + 4) % 4\n\n  if turns_needed == 1: # 90 degrees clockwise (e.g., N->E)\n    actions.append(3)  # RIGHT\n  elif turns_needed == 2: # 180 degrees (e.g., N->S)\n    actions.extend([3, 3]) # Two RIGHTS\n  elif turns_needed == 3: # 90 degrees counter-clockwise (e.g., N->W)\n    actions.append(2)  # LEFT\n\n  # 7. Add the USE action to interact with the primitive\n  actions.append(4)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
