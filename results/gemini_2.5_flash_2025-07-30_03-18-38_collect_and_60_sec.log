{"timestamp": "2025-07-30T03:54:42.685509", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Use action constants from env_factory.\n  # Assuming env_factory is imported at a higher level and `env_factory.actions` is available.\n  ACTION_DOWN = env_factory.actions.DOWN\n  ACTION_UP = env_factory.actions.UP\n  ACTION_LEFT = env_factory.actions.LEFT\n  ACTION_RIGHT = env_factory.actions.RIGHT\n  ACTION_USE = env_factory.actions.USE\n\n  # Get the current state from the environment wrapper\n  state = env._current_state\n\n  # 1. Check if the primitive is already in the agent's inventory\n  if state.inventory[primitive] > 0:\n      return []  # Already collected, no actions needed\n\n  # Get the full global grid and agent's current position\n  obs_dict = env.observations()\n  grid = obs_dict['features_dict']['features_global']\n  current_pos = state.pos  # Agent's current (x, y) position (col, row)\n  \n  # Get grid dimensions (WIDTH, HEIGHT)\n  grid_width, grid_height, _ = grid.shape\n\n  # Get indices of non-grabbable items to identify obstacles on the grid\n  non_grabbable_indices = state.world.non_grabbable_indices\n\n  # Define possible movement changes and their corresponding actions\n  # Assuming (x, y) where x is horizontal (column) and y is vertical (row)\n  # y increases downwards (standard image coordinates)\n  possible_moves = [\n      (0, 1, ACTION_DOWN),   # Move to (x, y+1)\n      (0, -1, ACTION_UP),    # Move to (x, y-1)\n      (-1, 0, ACTION_LEFT),  # Move to (x-1, y)\n      (1, 0, ACTION_RIGHT)   # Move to (x+1, y)\n  ]\n\n  # BFS Initialization\n  # The queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  queue = collections.deque([(current_pos, [])])\n  # The visited set keeps track of positions already explored to avoid cycles and redundant paths\n  visited = {current_pos}\n\n  # Helper function to check if a given position is within grid bounds and is traversable\n  def is_valid_and_traversable(p_x, p_y):\n      # Check if out of bounds\n      if not (0 <= p_x < grid_width and 0 <= p_y < grid_height):\n          return False\n      \n      # Check if the cell contains any non-grabbable obstacle\n      # The agent cannot move into a cell occupied by a non-grabbable item.\n      for idx in non_grabbable_indices:\n          if grid[p_x, p_y, idx] > 0:\n              return False  # This cell is blocked by an obstacle\n      return True\n\n  # BFS Loop to find the shortest path to a collectable primitive\n  while queue:\n      current_pos_bfs, path_actions = queue.popleft()\n\n      # Check if the current BFS position is a \"use\" candidate.\n      # This means checking the 3x3 neighborhood around current_pos_bfs for the primitive.\n      # If the primitive is found in the neighborhood, we can use it from current_pos_bfs.\n      for dx_neighbor in [-1, 0, 1]:\n          for dy_neighbor in [-1, 0, 1]:\n              neighbor_x, neighbor_y = current_pos_bfs[0] + dx_neighbor, current_pos_bfs[1] + dy_neighbor\n              \n              # Check if the neighbor coordinates are within grid bounds\n              if 0 <= neighbor_x < grid_width and 0 <= neighbor_y < grid_height:\n                  # If the neighbor cell contains the target primitive\n                  if grid[neighbor_x, neighbor_y, primitive] > 0:\n                      # Found a path to a position from which the primitive can be collected.\n                      # Append the USE action to the path and return the complete action sequence.\n                      return path_actions + [ACTION_USE]\n\n      # If current_pos_bfs is not a use candidate, explore its valid neighbors for movement\n      for dx, dy, action in possible_moves:\n          next_pos = (current_pos_bfs[0] + dx, current_pos_bfs[1] + dy)\n\n          # If the next position has not been visited and is valid/traversable\n          if next_pos not in visited and is_valid_and_traversable(next_pos[0], next_pos[1]):\n              visited.add(next_pos)  # Mark as visited\n              # Add the next position and updated path to the queue\n              queue.append((next_pos, path_actions + [action]))\n\n  # If the BFS completes and no path to a collectable primitive is found,\n  # it implies the primitive is unreachable or not present on the map.\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:56:23.433178", "function_name": "collect", "function_body": "    # Action constants (from CraftLab's action_specs)\n    # DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3, USE: 4\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    actions_taken = []\n    MAX_COLLECT_STEPS = 200 # A reasonable limit to prevent infinite loops\n\n    # The environment `env` (CraftLab instance) is assumed to be already set up\n    # and possibly in an ongoing episode. We do not call env.reset() here.\n\n    for _ in range(MAX_COLLECT_STEPS):\n        current_state = env._current_state # Access the current CraftState object\n\n        # 1. Check if the primitive is already in the agent's inventory\n        if current_state.inventory[primitive] > 0:\n            return actions_taken\n\n        # 2. Check if the primitive is in the agent's immediate vicinity (3x3 neighborhood)\n        # and can be collected using the USE action.\n        if current_state.next_to(primitive):\n            actions_taken.append(ACTION_USE)\n            # Perform the USE action\n            reward, done, obs = env.step(ACTION_USE)\n            # After trying to USE, re-check inventory to confirm collection\n            if env._current_state.inventory[primitive] > 0:\n                return actions_taken\n            # If USE didn't result in collection (e.g., missing tool, or item requires multiple uses),\n            # continue the loop to re-evaluate the state.\n            continue\n\n        # 3. If the primitive is not yet collected and not next to the agent, plan movement.\n        grid = current_state.grid\n        current_pos_x, current_pos_y = current_state.pos # Agent's position (x=col, y=row)\n\n        # Find all locations of the primitive on the grid.\n        # np.argwhere returns (row_index, col_index) tuples, i.e., (y, x).\n        primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n        if not primitive_locations.size:\n            # The primitive is not found anywhere on the grid.\n            # It's either already collected (checked above), or it's gone/unreachable.\n            return actions_taken # Cannot collect what's not there.\n\n        # Find the closest primitive location using Manhattan distance.\n        min_dist = float('inf')\n        target_y, target_x = -1, -1 # Placeholder for the closest target's (row, col)\n\n        for p_loc_y, p_loc_x in primitive_locations:\n            # Calculate Manhattan distance from current_pos (x,y) to primitive_location (y,x)\n            dist = abs(p_loc_y - current_pos_y) + abs(p_loc_x - current_pos_x)\n            if dist < min_dist:\n                min_dist = dist\n                target_y, target_x = p_loc_y, p_loc_x\n\n        # Calculate differences in coordinates to determine movement direction.\n        dy = target_y - current_pos_y # Difference in Y (row) coordinate\n        dx = target_x - current_pos_x # Difference in X (column) coordinate\n\n        chosen_action = None\n        \n        # Prioritize movement along the axis with the larger absolute difference.\n        # This heuristic aims to reduce the total Manhattan distance more efficiently.\n        if abs(dy) >= abs(dx): # Prioritize vertical movement if difference is equal or greater\n            if dy > 0:\n                chosen_action = ACTION_DOWN\n            elif dy < 0:\n                chosen_action = ACTION_UP\n            # If vertical difference is zero, but horizontal is not, fall back to horizontal.\n            elif dx > 0:\n                chosen_action = ACTION_RIGHT\n            elif dx < 0:\n                chosen_action = ACTION_LEFT\n        else: # Prioritize horizontal movement\n            if dx > 0:\n                chosen_action = ACTION_RIGHT\n            elif dx < 0:\n                chosen_action = ACTION_LEFT\n            # If horizontal difference is zero, but vertical is not, fall back to vertical.\n            elif dy > 0:\n                chosen_action = ACTION_DOWN\n            elif dy < 0:\n                chosen_action = ACTION_UP\n        \n        if chosen_action is None:\n            # This case implies dx=0 and dy=0, meaning the agent is exactly at target_pos.\n            # This should typically be caught by the `next_to` check earlier.\n            # If it's not and we're here, it means no movement is needed, but the item isn't collected.\n            # This could indicate an uncollectable item or a state issue. Break the loop.\n            break\n\n        # Execute the chosen action and check if it resulted in actual movement.\n        prev_pos = current_state.pos\n        actions_taken.append(chosen_action)\n        reward, done, obs = env.step(chosen_action)\n        \n        # If the agent's position did not change after the step, the action was blocked.\n        if env._current_state.pos == prev_pos:\n            # The primary chosen action was blocked. Attempt a secondary action if available.\n            actions_taken.pop() # Remove the blocked action from the list\n\n            secondary_action = None\n            if abs(dy) >= abs(dx): # Vertical was preferred, try horizontal if possible\n                if dx > 0: secondary_action = ACTION_RIGHT\n                elif dx < 0: secondary_action = ACTION_LEFT\n            else: # Horizontal was preferred, try vertical if possible\n                if dy > 0: secondary_action = ACTION_DOWN\n                elif dy < 0: secondary_action = ACTION_UP\n\n            if secondary_action is not None:\n                # Try the secondary action\n                # The agent's position is still `prev_pos` as the primary move failed.\n                actions_taken.append(secondary_action)\n                reward, done, obs = env.step(secondary_action)\n                if env._current_state.pos == prev_pos:\n                    # Both primary and secondary actions were blocked. Agent is likely stuck.\n                    actions_taken.pop() # Remove the secondary blocked action as well.\n                    break # Give up trying to move this step. Max_steps will eventually terminate.\n            else:\n                # No secondary action possible (e.g., already aligned on one axis and other is zero),\n                # or agent is completely stuck with no valid alternative moves.\n                break # Give up trying to move this step.\n\n    return actions_taken # Return actions taken if MAX_COLLECT_STEPS reached or agent got stuck.", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:56:23.512924", "function_name": "collect", "function_body": "        obs = env.observations()\n        action_map = env.action_specs()\n\n        # Extract grid and agent position\n        grid = obs['features_dict']['features_global']\n        height, width, _ = grid.shape\n\n        agent_x_normalized, agent_y_normalized = obs['features_dict']['pos']\n        # Convert normalized position to grid coordinates\n        agent_x = int(round(agent_x_normalized * (width - 1)))\n        agent_y = int(round(agent_y_normalized * (height - 1)))\n        agent_pos = (agent_y, agent_x) # (row, col) format\n\n        # Get non-grabbable indices to check for traversability\n        non_grabbable_indices = env.world.non_grabbable_indices\n        \n        # Helper function to check if a cell is traversable\n        def is_traversable(y, x):\n            if not (0 <= y < height and 0 <= x < width):\n                return False\n            # Check if any non-grabbable item (e.g., water, stone) is present\n            if np.any(grid[y, x, list(non_grabbable_indices)] > 0):\n                return False\n            return True\n\n        # Find all locations where the primitive exists on the grid\n        primitive_locations_raw = np.argwhere(grid[:, :, primitive] > 0)\n        if len(primitive_locations_raw) == 0:\n            return [] # Primitive not found on the grid\n\n        primitive_locations = set(tuple(loc) for loc in primitive_locations_raw)\n\n        # Define \"collectable\" squares: any traversable square from which the primitive can be collected.\n        # This includes the primitive's own square (if traversable) and its 8 adjacent traversable squares.\n        collectable_target_squares = set()\n        for py, px in primitive_locations:\n            # Check the primitive cell itself\n            if is_traversable(py, px):\n                collectable_target_squares.add((py, px))\n            \n            # Check 8 neighbors (Moore neighborhood)\n            for dy in [-1, 0, 1]:\n                for dx in [-1, 0, 1]:\n                    if dy == 0 and dx == 0:\n                        continue # Skip the primitive's own cell\n                    \n                    ny, nx = py + dy, px + dx\n                    if is_traversable(ny, nx):\n                        collectable_target_squares.add((ny, nx))\n        \n        if not collectable_target_squares:\n            return [] # No traversable spots near the primitive\n\n        # BFS to find the shortest path from the agent's current position\n        # to any of the collectable_target_squares.\n        # Queue stores (current_position, list_of_actions_taken_to_reach_here)\n        queue = collections.deque([(agent_pos, [])])\n        visited = {agent_pos} # Keep track of visited (y, x) coordinates to avoid cycles\n\n        # Movement actions and their corresponding (dy, dx) changes\n        moves = [\n            (-1, 0, action_map['UP']),\n            (1, 0, action_map['DOWN']),\n            (0, -1, action_map['LEFT']),\n            (0, 1, action_map['RIGHT'])\n        ]\n\n        target_path_actions = []\n        target_collectable_pos = None\n\n        while queue:\n            (cy, cx), path_so_far = queue.popleft()\n\n            # If the current position is a collectable target square, we've found the shortest path\n            if (cy, cx) in collectable_target_squares:\n                target_path_actions = path_so_far\n                target_collectable_pos = (cy, cx)\n                break \n\n            # Explore neighbors\n            for dy, dx, action_value in moves:\n                ny, nx = cy + dy, cx + dx\n                next_pos = (ny, nx)\n\n                if is_traversable(ny, nx) and next_pos not in visited:\n                    visited.add(next_pos)\n                    queue.append((next_pos, path_so_far + [action_value]))\n        \n        if not target_collectable_pos:\n            return [] # No path found to any collectable square\n\n        # Once the agent reaches a collectable position, execute the 'USE' action\n        return target_path_actions + [action_map['USE']]", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:57:47.057074", "function_name": "collect", "function_body": "    # Get initial state info directly from the CraftLab environment's current state\n    current_state = env._current_state\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir\n    grid = current_state.grid # numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds)\n\n    # Early exit: If the primitive is not grabbable, it cannot be collected\n    if primitive not in current_state.world.grabbable_indices:\n        return []\n\n    # Early exit: If primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    H, W, N_KINDS = grid.shape\n    target_kind_idx = primitive\n\n    # BFS setup\n    # Using a deque from the collections module for efficient pop operations.\n    q = collections.deque()\n    visited = set() # Stores (row, col, direction) tuples to avoid cycles and redundant exploration\n\n    # Start state and actions to reach it\n    start_state_tuple = (initial_pos[0], initial_pos[1], initial_dir)\n    q.append((start_state_tuple, [])) # (current_state_tuple, list_of_actions_to_reach_here)\n    visited.add(start_state_tuple)\n\n    # Direction vectors for checking what's in front of the agent based on CraftState.dir\n    # CraftState.dir mapping: 0=North, 1=East, 2=South, 3=West\n    DR_LOOKUP = [-1, 0, 1, 0] # Delta row for (North, East, South, West)\n    DC_LOOKUP = [0, 1, 0, -1] # Delta column for (North, East, South, West)\n\n    # Mapping from CraftLab actions to (delta_row, delta_col, new_CraftState_dir) for BFS state transitions\n    # When an agent moves, its direction (CraftState.dir) is updated to face the direction of movement.\n    ACTION_TRANSITIONS = {\n        env_factory.ACTIONS['DOWN']: (1, 0, 2),   # Move South (row + 1), face South (dir 2)\n        env_factory.ACTIONS['UP']: (-1, 0, 0),    # Move North (row - 1), face North (dir 0)\n        env_factory.ACTIONS['LEFT']: (0, -1, 3),  # Move West (col - 1), face West (dir 3)\n        env_factory.ACTIONS['RIGHT']: (0, 1, 1),  # Move East (col + 1), face East (dir 1)\n    }\n\n    while q:\n        (r, c, d), path_actions = q.popleft()\n\n        # Check if the target primitive is directly in front of the current state\n        front_r, front_c = r + DR_LOOKUP[d], c + DC_LOOKUP[d]\n\n        # Ensure the cell in front is within grid boundaries\n        if 0 <= front_r < H and 0 <= front_c < W:\n            # Check if the cell in front contains the target primitive\n            # grid[row, col, kind_index] == 1.0 indicates presence\n            if grid[front_r, front_c, target_kind_idx] == 1.0:\n                # If yes, we can use the 'USE' action to collect it.\n                # Return the sequence of actions to reach this state plus the 'USE' action.\n                return path_actions + [env_factory.ACTIONS['USE']]\n\n        # Explore possible movement actions from the current state\n        for action_val, (dr, dc, new_dir) in ACTION_TRANSITIONS.items():\n            nr, nc = r + dr, c + dc # Calculate the new position\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= nr < H and 0 <= nc < W):\n                continue # Cannot move out of bounds\n\n            # (Optional but robust): Add checks for obstacles if specific entities block movement.\n            # The problem description does not specify general obstacles for movement.\n            # For simplicity, we assume all valid grid cells are traversable unless specified otherwise.\n            # Example obstacle check (if water or stone were absolute barriers):\n            # if grid[nr, nc, current_state.world.water_index] == 1.0 or \\\n            #    grid[nr, nc, current_state.world.stone_index] == 1.0:\n            #     continue # Cannot move into an obstacle cell\n\n            new_state = (nr, nc, new_dir) # The new state tuple: (new_row, new_col, new_direction)\n\n            # If this new state has not been visited, add it to the queue for exploration\n            if new_state not in visited:\n                visited.add(new_state)\n                q.append((new_state, path_actions + [action_val]))\n\n    # If the BFS queue is exhausted and no path to collect the primitive was found\n    return []", "island_id": 2, "scores": {"3": -1}}
