{"timestamp": "2025-07-30T16:34:53.101245", "function_name": "collect", "function_body": "    actions_taken = []\n    \n    # Get action mappings from the environment\n    action_map = env.action_specs()\n    ACTION_UP = action_map[\"UP\"]\n    ACTION_DOWN = action_map[\"DOWN\"]\n    ACTION_LEFT = action_map[\"LEFT\"]\n    ACTION_RIGHT = action_map[\"RIGHT\"]\n    ACTION_USE = action_map[\"USE\"]\n\n    # Maximum steps for this collection attempt to prevent infinite loops\n    MAX_COLLECTION_STEPS = 200 \n    current_steps = 0\n\n    # Get the current state directly from the CraftLab instance.\n    # This state object holds grid, inventory, pos, dir, and methods like next_to.\n    current_craft_state = env._current_state\n\n    while current_steps < MAX_COLLECTION_STEPS:\n        # 1. Check if the primitive is already in inventory\n        if current_craft_state.inventory[primitive] > 0:\n            return actions_taken\n\n        # 2. Check if the agent is next to the primitive\n        if current_craft_state.next_to(primitive):\n            # If next to it, use the 'USE' action\n            _reward, _done, _obs = env.step(ACTION_USE)\n            actions_taken.append(ACTION_USE)\n            current_craft_state = env._current_state # Update state reference\n\n            # After 'USE', re-check if collected. The action might have completed the goal.\n            if current_craft_state.inventory[primitive] > 0:\n                return actions_taken\n            \n            # If the environment signals done and the primitive is not collected,\n            # it means the task failed (e.g., max_steps of the environment reached).\n            if _done:\n                return [] \n            \n            # Continue the loop to re-evaluate after 'USE' action\n            current_steps += 1\n            continue \n\n        # 3. If not next to the primitive, find its location and move towards it\n        # The grid is typically (HEIGHT, WIDTH, n_kinds) in numpy for visual representation,\n        # so np.argwhere returns (row, col) i.e. (y, x) coordinates.\n        primitive_locations = np.argwhere(current_craft_state.grid[:, :, primitive] > 0)\n\n        if len(primitive_locations) == 0:\n            # Primitive not found on the map. This implies failure to collect.\n            return []\n\n        # Find the closest primitive location using Euclidean distance\n        agent_x, agent_y = current_craft_state.pos # Agent's position is (x, y)\n        min_dist = float('inf')\n        best_target_x, best_target_y = None, None\n\n        for loc_y, loc_x in primitive_locations: # loc is (row, col) which maps to (y, x)\n            # Calculate Euclidean distance between agent (x,y) and target (x,y)\n            dist = np.linalg.norm(np.array([agent_x, agent_y]) - np.array([loc_x, loc_y]))\n            if dist < min_dist:\n                min_dist = dist\n                best_target_x, best_target_y = loc_x, loc_y\n\n        # Determine the next best movement action based on greedy approach\n        # Move along the axis with the larger absolute difference towards the target.\n        move_x = best_target_x - agent_x\n        move_y = best_target_y - agent_y\n\n        action_to_take = None\n        if abs(move_x) > abs(move_y):\n            if move_x > 0:\n                action_to_take = ACTION_RIGHT\n            else: # move_x < 0\n                action_to_take = ACTION_LEFT\n        else: # abs(move_y) >= abs(move_x)\n            if move_y > 0:\n                action_to_take = ACTION_DOWN\n            else: # move_y < 0\n                action_to_take = ACTION_UP\n        \n        # Take the determined movement action\n        if action_to_take is not None:\n            _reward, _done, _obs = env.step(action_to_take)\n            actions_taken.append(action_to_take)\n            current_craft_state = env._current_state # Update state reference\n            current_steps += 1\n            \n            # Check if episode ended by env's internal max_steps\n            if _done:\n                # Even if done, check if primitive was collected due to last action\n                if current_craft_state.inventory[primitive] > 0:\n                    return actions_taken\n                else:\n                    return [] # Failed to collect within env max_steps\n        else:\n            # This case means agent is at the target location (move_x=0, move_y=0),\n            # but next_to() was false and inventory[primitive] is 0.\n            # This implies the primitive might be uncollectable or agent is stuck.\n            return []\n\n    # If the loop finishes without collecting (max_collection_steps reached)\n    return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:34:54.073472", "function_name": "collect", "function_body": "  from collections import deque\n\n  actions_list = []\n  MAX_COLLECT_STEPS = 500 # Safety limit to prevent infinite loops\n\n  # Action constants (based on action_specs: DOWN\u21920, UP\u21921, LEFT\u21922, RIGHT\u21923, USE\u21924)\n  # We mostly use UP for forward, and LEFT/RIGHT for turning.\n  # USE is for interacting with the environment.\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction vectors for North, East, South, West (0, 1, 2, 3 respectively)\n  # _DX[dir], _DY[dir] gives the change in (x, y) for moving forward in that direction\n  _DX = [0, 1, 0, -1]  # Change in X: N(0), E(+1), S(0), W(-1)\n  _DY = [-1, 0, 1, 0]  # Change in Y: N(-1), E(0), S(+1), W(0)\n\n  def _get_actions_to_face(current_pos, current_dir, target_x, target_y):\n      \"\"\"\n      Calculates the sequence of turn actions (LEFT/RIGHT) needed to face the target position.\n      Assumes target_pos is an immediate cardinal neighbor or the same position.\n      \"\"\"\n      cx, cy = current_pos\n      actions = []\n\n      desired_dir = -1\n      if target_x > cx and target_y == cy:\n          desired_dir = 1 # East\n      elif target_x < cx and target_y == cy:\n          desired_dir = 3 # West\n      elif target_x == cx and target_y > cy:\n          desired_dir = 2 # South\n      elif target_x == cx and target_y < cy:\n          desired_dir = 0 # North\n      # If target_x, target_y is the same as current_pos, desired_dir remains -1, meaning no turn needed.\n\n      if desired_dir == -1 or desired_dir == current_dir:\n          return [] # Already facing the target or no specific direction required\n\n      # Calculate the difference in direction (clockwise)\n      diff = (desired_dir - current_dir + 4) % 4\n      if diff == 1: # 90 degrees clockwise (e.g., N->E)\n          actions.append(ACTION_RIGHT)\n      elif diff == 2: # 180 degrees (e.g., N->S)\n          actions.extend([ACTION_RIGHT, ACTION_RIGHT]) # Two right turns or two left turns\n      elif diff == 3: # 90 degrees counter-clockwise (e.g., N->W)\n          actions.append(ACTION_LEFT)\n      return actions\n\n  def _find_path_to_adjacent(grid, start_pos, target_kind_idx):\n      \"\"\"\n      Performs a Breadth-First Search (BFS) to find the shortest path from start_pos\n      to any cell that is directly adjacent (cardinal neighbor) to a cell containing `target_kind_idx`.\n      Returns a list of positions representing the path, or None if no path found.\n      \"\"\"\n      height, width, _ = grid.shape\n      q = deque([(start_pos, [])]) # Queue stores (current_pos, path_to_current_pos)\n      visited = {start_pos} # Set of visited positions\n\n      while q:\n          (curr_x, curr_y), path = q.popleft()\n\n          # Check if the current position is adjacent to the target_kind_idx\n          # This means we can USE the primitive from curr_x, curr_y\n          for i in range(4): # Check 4 cardinal neighbors\n              nx, ny = curr_x + _DX[i], curr_y + _DY[i]\n              if 0 <= nx < width and 0 <= ny < height:\n                  # If the neighbor cell contains the primitive\n                  if grid[ny, nx, target_kind_idx] > 0:\n                      return path # Path leads to (curr_x, curr_y), from which we can USE\n\n          # Explore traversable neighbors\n          for i in range(4):\n              next_x, next_y = curr_x + _DX[i], curr_y + _DY[i]\n              next_pos = (next_x, next_y)\n\n              if 0 <= next_x < width and 0 <= next_y < height and next_pos not in visited:\n                  # Assuming all cells are traversable unless specified otherwise.\n                  # A more complex scenario might check for obstacles (e.g., `non_grabbable_indices`)\n                  # For this problem, we assume movement is generally possible.\n                  visited.add(next_pos)\n                  q.append((next_pos, path + [next_pos]))\n      return None # No path found to an adjacent cell\n\n  # Main loop for collecting the primitive\n  for _ in range(MAX_COLLECT_STEPS):\n      current_state = env._current_state\n      # Check if the primitive is already in inventory\n      if current_state.inventory[primitive] > 0:\n          break # Goal achieved\n\n      current_pos = current_state.pos\n      current_dir = current_state.dir\n      grid = current_state.grid\n\n      # 1. Check if the primitive is immediately adjacent to the agent\n      found_adjacent_primitive = False\n      target_face_pos = None\n      for i in range(4): # Check 4 cardinal neighbors\n          nx, ny = current_pos[0] + _DX[i], current_pos[1] + _DY[i]\n          # Check bounds and if the neighbor cell contains the primitive\n          if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0] and grid[ny, nx, primitive] > 0:\n              target_face_pos = (nx, ny)\n              found_adjacent_primitive = True\n              break\n      \n      if found_adjacent_primitive:\n          # If adjacent, turn to face it and USE\n          turn_actions = _get_actions_to_face(current_pos, current_dir, target_face_pos[0], target_face_pos[1])\n          for action in turn_actions:\n              env.step(action)\n              actions_list.append(action)\n          \n          env.step(ACTION_USE)\n          actions_list.append(ACTION_USE)\n          continue # Continue to the next iteration to re-check inventory\n\n      # 2. If not immediately adjacent, find a path to a cell adjacent to the primitive\n      path_to_adj = _find_path_to_adjacent(grid, current_pos, primitive)\n\n      if path_to_adj:\n          # Take the first step on the determined path\n          next_step_pos = path_to_adj[0]\n          \n          # Turn to face the next step in the path\n          turn_actions = _get_actions_to_face(current_pos, current_dir, next_step_pos[0], next_step_pos[1])\n          for action in turn_actions:\n              env.step(action)\n              actions_list.append(action)\n          \n          # Move forward to the next step\n          env.step(ACTION_UP) # Move forward\n          actions_list.append(ACTION_UP)\n      else:\n          # 3. Fallback: Primitive not found on the map or unreachable.\n          # Implement a simple exploration strategy: try to move forward, turn if blocked.\n          original_pos = current_pos\n          original_dir = current_dir\n\n          env.step(ACTION_UP) # Try moving forward\n          actions_list.append(ACTION_UP)\n          \n          # After attempting to move, check if the agent's position or direction changed.\n          # If not, it likely hit an obstacle or the environment prevented movement.\n          new_state = env._current_state\n          if new_state.pos == original_pos and new_state.dir == original_dir:\n              # Agent is stuck or didn't move, try turning right to unblock\n              env.step(ACTION_RIGHT)\n              actions_list.append(ACTION_RIGHT)\n          # Else: Agent moved, continue exploration in the new position/direction\n\n  return actions_list", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:36:28.773229", "function_name": "collect", "function_body": "    # Get action mappings from the environment's specifications\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    # Get the current state of the CraftLab environment to start the search\n    initial_state = env._current_state\n\n    # Check if the primitive is already in the inventory in the initial state\n    if initial_state.satisfies(None, primitive):\n        return [] # Goal already achieved, no actions needed\n\n    # Initialize a deque for Breadth-First Search (BFS).\n    # Each element in the queue is a tuple: (current_CraftState_object, list_of_actions_taken_to_reach_this_state)\n    import collections\n    queue = collections.deque([(initial_state, [])])\n\n    # Helper function to find all grid locations containing the target primitive.\n    # This is crucial for tracking changes in the environment relevant to the goal.\n    def get_primitive_locations(state, primitive_idx):\n        # np.argwhere returns a (N, 2) numpy array of (row, col) coordinates where the condition is true.\n        locations = np.argwhere(state.grid[:, :, primitive_idx] == 1)\n        # Convert the numpy array of locations into a sorted tuple of tuples.\n        # This makes the representation hashable and consistent for set operations.\n        return tuple(map(tuple, locations))\n\n    # Function to create a hashable representation of a CraftState.\n    # This representation is used for the `visited` set to avoid revisiting states and cycles.\n    def get_state_repr(state):\n        # The state representation includes agent's position, direction, inventory,\n        # and crucially, the current locations of the target primitive on the grid.\n        return (state.pos, state.dir, tuple(state.inventory), get_primitive_locations(state, primitive))\n\n    # Set to keep track of visited state representations to avoid redundant exploration\n    visited = set()\n    initial_state_repr = get_state_repr(initial_state)\n    visited.add(initial_state_repr)\n\n    # Define a maximum search depth to prevent excessively long searches or infinite loops\n    # This is a safety measure for complex or unreachable goals.\n    MAX_SEARCH_DEPTH = 100 \n\n    # Start the BFS loop\n    while queue:\n        current_state, current_path = queue.popleft()\n\n        # If the current path exceeds the maximum allowed search depth, prune this branch.\n        if len(current_path) >= MAX_SEARCH_DEPTH:\n            continue\n\n        # Check if the primitive has been collected in the current state\n        if current_state.satisfies(None, primitive):\n            return current_path # Goal achieved, return the sequence of actions\n\n        # Prioritize the 'USE' action if the agent is adjacent to the primitive.\n        # This is a common heuristic in crafting worlds to attempt collection immediately.\n        if current_state.next_to(primitive):\n            # Simulate the 'USE' action using CraftState.step(), which returns a new state.\n            # The reward (always 0.0 in this implementation) is ignored for path cost.\n            _reward, next_state_use = current_state.step(USE)\n            next_path_use = current_path + [USE]\n            next_state_repr_use = get_state_repr(next_state_use)\n\n            # If the 'USE' action successfully collected the primitive, return this path.\n            if next_state_use.satisfies(None, primitive):\n                return next_path_use\n            \n            # If 'USE' did not immediately collect (e.g., resource depleted, wrong tool),\n            # but resulted in a new, unvisited state, add it to the queue for further exploration.\n            if next_state_repr_use not in visited:\n                visited.add(next_state_repr_use)\n                queue.append((next_state_use, next_path_use))\n        \n        # Explore movement actions (UP, DOWN, LEFT, RIGHT)\n        # These are typically explored after checking for direct interaction actions like 'USE'.\n        for action in [UP, DOWN, LEFT, RIGHT]:\n            # Simulate the movement action\n            _reward, next_state_move = current_state.step(action)\n            next_path_move = current_path + [action]\n            next_state_repr_move = get_state_repr(next_state_move)\n\n            # If the resulting state is new (unvisited), add it to the queue.\n            if next_state_repr_move not in visited:\n                visited.add(next_state_repr_move)\n                queue.append((next_state_move, next_path_move))\n    \n    # If the BFS queue is exhausted and the primitive has not been collected,\n    # it means the goal is unreachable within the `MAX_SEARCH_DEPTH` or the current grid configuration.\n    return [] # Return an empty list indicating no path found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:36:29.742036", "function_name": "collect", "function_body": "  import collections\n  \n  actions_to_return = []\n  \n  # Get current state from the environment\n  state = env._current_state\n  current_grid = state.grid\n  current_pos = state.pos\n  \n  # Get grid dimensions\n  # current_grid is (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = current_grid.shape\n  \n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Get indices for entities that block movement (obstacles)\n  # These are entities the agent cannot move onto.\n  obstacles_indices = env.world.non_grabbable_indices\n  \n  # Find all grid locations where the target primitive exists\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # Check if the cell (r, c) contains the primitive item\n          if current_grid[r, c, primitive] > 0:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      # If the primitive is not found anywhere on the grid, it cannot be collected.\n      return []\n\n  # Define potential movements (delta_row, delta_col) and their corresponding actions.\n  move_deltas_actions = [\n      ((-1, 0), ACTION_UP),    # Move Up (decreases row)\n      ((1, 0), ACTION_DOWN),   # Move Down (increases row)\n      ((0, -1), ACTION_LEFT),  # Move Left (decreases column)\n      ((0, 1), ACTION_RIGHT)   # Move Right (increases column)\n  ]\n\n  # Pre-calculate all valid target cells for the BFS.\n  # A target cell is any non-obstacle cell that is directly adjacent (4-directionally) to a primitive.\n  target_adjacent_cells = set()\n  for pr, pc in primitive_locations:\n      for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Check 4-directional neighbors\n          nr, nc = pr + dr, pc + dc\n          # Ensure the neighbor cell is within grid boundaries\n          if 0 <= nr < WIDTH and 0 <= nc < HEIGHT:\n              # Check if the neighbor cell itself is an obstacle (agent cannot stand on it)\n              is_adj_cell_obstacle = False\n              for k_idx in obstacles_indices:\n                  if current_grid[nr, nc, k_idx] > 0:\n                      is_adj_cell_obstacle = True\n                      break\n              if not is_adj_cell_obstacle:\n                  target_adjacent_cells.add((nr, nc))\n\n  # BFS Initialization\n  # The queue stores tuples: (current_row, current_col, list_of_actions_to_reach_here)\n  q = collections.deque()\n  q.append((current_pos[0], current_pos[1], [])) \n  \n  # The visited set stores (row, col) coordinates to prevent re-processing cells\n  # and ensure finding the shortest path.\n  visited = set([(current_pos[0], current_pos[1])])\n\n  # BFS loop to find the shortest path to any target_adjacent_cell.\n  while q:\n      r, c, path_actions = q.popleft()\n\n      # If the current cell (r, c) is one of our pre-calculated target adjacent cells,\n      # we have found the shortest path.\n      if (r, c) in target_adjacent_cells:\n          # Append the USE action, as the agent is now in position to collect the primitive.\n          actions_to_return = path_actions + [ACTION_USE]\n          return actions_to_return \n\n      # Explore all valid neighbors from the current cell (r, c).\n      for (dr, dc), action_val in move_deltas_actions:\n          nr, nc = r + dr, c + dc # Calculate neighbor coordinates\n\n          # Check if the neighbor is within grid boundaries.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n\n          # Check if the neighbor has already been visited during BFS.\n          if (nr, nc) in visited:\n              continue\n\n          # Check if the neighbor cell is an obstacle (agent cannot move onto it).\n          is_obstacle = False\n          for k_idx in obstacles_indices:\n              if current_grid[nr, nc, k_idx] > 0:\n                  is_obstacle = True\n                  break\n          \n          if not is_obstacle:\n              # If the neighbor is not an obstacle and has not been visited,\n              # add it to the queue for further exploration and mark it as visited.\n              visited.add((nr, nc))\n              q.append((nr, nc, path_actions + [action_val]))\n    \n  # If the BFS queue becomes empty and no path to an adjacent cell was found,\n  # it means the primitive is unreachable (e.g., completely surrounded by obstacles).\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:37:49.312969", "function_name": "collect", "function_body": "  import collections\n\n  initial_state = env._current_state\n  start_pos = initial_state.pos\n  start_dir = initial_state.dir\n  start_inventory = initial_state.inventory\n\n  # Queue for BFS: stores tuples of (CraftState object, list of actions taken to reach this state)\n  q = collections.deque([(initial_state, [])])\n\n  # Set to store visited states to prevent cycles and redundant exploration.\n  # A state is defined by (agent's position, agent's direction).\n  visited = {(start_pos, start_dir)}\n\n  # Define action constants from env_factory\n  # These are usually integers, e.g., 0, 1, 2, 3, 4\n  # Assuming env_factory provides these constants\n  # UP = env_factory.UP\n  # DOWN = env_factory.DOWN\n  # LEFT = env_factory.LEFT\n  # RIGHT = env_factory.RIGHT\n  # USE = env_factory.USE\n  # To avoid explicit imports that might not be allowed in the final context,\n  # and since the problem description implies these are part of the 'env_factory' context\n  # within the larger project, we refer to them via env_factory.\n  move_actions = [env_factory.UP, env_factory.DOWN, env_factory.LEFT, env_factory.RIGHT]\n  use_action = env_factory.USE\n\n  # BFS loop\n  while q:\n    current_state, actions_path = q.popleft()\n\n    # --- Check for collection (USE action) ---\n    # Simulate the USE action from the current state.\n    # The step method returns (reward, new_state). We only care about the new_state.\n    _, state_after_use = current_state.step(use_action)\n\n    # Check if the primitive was successfully collected by comparing inventory before and after USE.\n    # If the count of the primitive in the inventory increased, it means it was collected.\n    if state_after_use.inventory[primitive] > current_state.inventory[primitive]:\n      return actions_path + [use_action] # Goal achieved, return the sequence of actions.\n\n    # --- Explore movement actions ---\n    # For each possible movement action (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n      # Simulate the movement action from the current state.\n      _, next_state = current_state.step(action)\n\n      # A movement action might result in no actual position/direction change if, for example,\n      # the agent tries to move into a wall. In such cases, next_state will be identical to current_state.\n      # We should only explore genuinely new states.\n      next_state_key = (next_state.pos, next_state.dir)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        # Add the new state and the extended action path to the queue for further exploration.\n        q.append((next_state, actions_path + [action]))\n\n  # If the queue becomes empty and the primitive has not been collected, it means\n  # there is no path to collect the primitive from the initial state.\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:37:50.292555", "function_name": "collect", "function_body": "  import collections\n\n  # Helper function to calculate coordinates in front of the agent\n  def _get_facing_coordinates(pos, direction):\n      r, c = pos\n      # Directions: 0 (North), 1 (East), 2 (South), 3 (West)\n      if direction == 0:  # North\n          return (r - 1, c)\n      elif direction == 1:  # East\n          return (r, c + 1)\n      elif direction == 2:  # South\n          return (r + 1, c)\n      elif direction == 3:  # West\n          return (r, c - 1)\n      # Should not happen with valid directions 0-3\n      return pos \n\n  # Helper function to check if a position is within grid boundaries\n  def _is_valid_pos(pos, width, height):\n      r, c = pos\n      return 0 <= r < width and 0 <= c < height\n\n  q = collections.deque()\n  visited = set()\n\n  # Get initial state from the environment\n  # We access _current_state directly for full state details needed for BFS\n  initial_state = env._current_state\n  \n  # Check if the primitive is already collected in the initial state\n  if initial_state.inventory[primitive] > 0:\n      return [] # Already collected, no actions needed\n\n  # Add initial state to the queue\n  # The state tuple for the visited set needs to be hashable: (position, direction, tuple_of_inventory)\n  # Convert numpy array to list then to tuple for hashability.\n  initial_state_tuple = (initial_state.pos, initial_state.dir, tuple(initial_state.inventory.tolist()))\n  q.append((initial_state, [])) # Queue stores (CraftState object, list of actions to reach this state)\n  visited.add(initial_state_tuple)\n\n  # Determine if the primitive can be picked up using the USE action\n  is_primitive_grabbable = primitive in env.world.grabbable_indices\n  \n  # Get grid dimensions for boundary checks when simulating movement\n  WIDTH, HEIGHT, _ = initial_state.grid.shape\n\n  # BFS loop\n  while q:\n      current_state, path_so_far = q.popleft()\n\n      # Goal check: Is the primitive now in the inventory of the current state?\n      if current_state.inventory[primitive] > 0:\n          return path_so_far\n\n      # Attempt to use the 'USE' action if the primitive is grabbable and in front\n      if is_primitive_grabbable:\n          facing_pos = _get_facing_coordinates(current_state.pos, current_state.dir)\n          \n          # Check if the facing position is within grid boundaries\n          if _is_valid_pos(facing_pos, WIDTH, HEIGHT):\n              # Check if the primitive is actually present at the facing position\n              if current_state.grid[facing_pos[0], facing_pos[1], primitive] > 0:\n                  # Simulate the USE action to get the next state\n                  # _reward is always 0.0 for CraftState.step in this problem\n                  _reward, next_state_after_use = current_state.step(env_factory.USE)\n                  next_state_tuple_after_use = (next_state_after_use.pos, \n                                                next_state_after_use.dir, \n                                                tuple(next_state_after_use.inventory.tolist()))\n\n                  # Check if this new state has been visited to avoid cycles\n                  if next_state_tuple_after_use not in visited:\n                      # If after using, the primitive is collected, return the path immediately\n                      if next_state_after_use.inventory[primitive] > 0:\n                          return path_so_far + [env_factory.USE]\n                      \n                      # Add to visited and queue for further exploration\n                      visited.add(next_state_tuple_after_use)\n                      q.append((next_state_after_use, path_so_far + [env_factory.USE]))\n\n      # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT)\n      # Assuming env_factory defines these as integer constants\n      for action in [env_factory.DOWN, env_factory.UP, env_factory.LEFT, env_factory.RIGHT]:\n          # Simulate the movement action\n          _reward, next_state_move = current_state.step(action)\n          next_state_tuple_move = (next_state_move.pos, \n                                    next_state_move.dir, \n                                    tuple(next_state_move.inventory.tolist()))\n\n          # Check if this new state has been visited\n          if next_state_tuple_move not in visited:\n              visited.add(next_state_tuple_move)\n              q.append((next_state_move, path_so_far + [action]))\n\n  # If the BFS queue is exhausted and the goal (primitive collected) was not reached\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:39:51.009939", "function_name": "collect", "function_body": "  actions_taken = []\n  \n  # Get action mappings from the environment's action_specs\n  ACTION_MAP = env.action_specs()\n  ACTION_USE = ACTION_MAP['USE']\n  ACTION_UP = ACTION_MAP['UP']     # Represents moving one step forward (relative to agent's direction)\n  ACTION_LEFT = ACTION_MAP['LEFT'] # Represents turning left\n  \n  # Maximum number of steps to attempt collection, to prevent infinite loops.\n  # This provides a reasonable upper bound for exploration in typical scenarios.\n  # We use env.max_steps as a base, as the task itself has a step limit, and allow more for exploration.\n  max_exploration_steps = env.max_steps * 2 \n  \n  # Check initial state: If the primitive is already in inventory, no actions are needed.\n  initial_obs = env.observations()\n  if initial_obs['features_dict']['inventory'][primitive] > 0:\n      return []\n\n  # Main loop for exploration and collection attempts\n  for step_count in range(max_exploration_steps):\n      current_obs = env.observations()\n\n      # After any action, re-check if the primitive has been collected.\n      if current_obs['features_dict']['inventory'][primitive] > 0:\n          return actions_taken\n\n      # Access the internal CraftState object to use its `next_to` method.\n      # `next_to` checks if the primitive is in the 3x3 neighborhood around the agent's position.\n      if env._current_state.next_to(primitive):\n          # The primitive is near. Attempt to collect it.\n          # Since the `USE` action only works on the cell directly in front of the agent,\n          # and `next_to` can return true for items on diagonals, we need to try\n          # turning to face the item and then using the `USE` action.\n          # This loop attempts to USE in the current direction, then turns LEFT and repeats,\n          # covering all 4 cardinal directions around the agent.\n          for _ in range(4): \n              # Attempt to USE the item in the current facing direction\n              _reward, done, _ = env.step(ACTION_USE)\n              actions_taken.append(ACTION_USE)\n              \n              # Check if the item was collected immediately after this USE action\n              if env.observations()['features_dict']['inventory'][primitive] > 0:\n                  return actions_taken\n              \n              # If not collected (e.g., item was not directly in front, or an obstacle),\n              # turn LEFT to face a new direction for the next attempt.\n              _reward, done, _ = env.step(ACTION_LEFT)\n              actions_taken.append(ACTION_LEFT)\n              if done: # Check if the environment task finished (e.g., max_steps reached)\n                  return actions_taken\n          \n          # If, after trying all four directions, the item wasn't collected,\n          # it implies it might be on a diagonal, or there's an impassable obstacle.\n          # In this case, the agent will fall through to the general exploration strategy below (move forward).\n\n      # General exploration strategy: Move forward. If blocked, turn.\n      # This provides a basic systematic search.\n      \n      # Get the agent's current position before attempting to move.\n      current_pos = env.observations()['features_dict']['pos']\n      \n      # Attempt to move one step forward (relative to the agent's current facing direction)\n      _reward, done, _ = env.step(ACTION_UP)\n      actions_taken.append(ACTION_UP)\n      if done: # Check if the environment task finished (e.g., max_steps reached)\n          return actions_taken\n      \n      # Get the agent's new position after the move attempt\n      new_pos = env.observations()['features_dict']['pos']\n\n      # If the agent's position did not change after attempting to move forward,\n      # it means the path in that direction was blocked (e.g., by a wall or an unmovable object).\n      if np.array_equal(current_pos, new_pos):\n          # If blocked, turn LEFT to try a new direction in the next iteration.\n          _reward, done, _ = env.step(ACTION_LEFT)\n          actions_taken.append(ACTION_LEFT)\n          if done: # Check if the environment task finished\n              return actions_taken\n\n  # If the loop completes without collecting the primitive (i.e., max_exploration_steps reached),\n  # return the actions taken so far. This implies a failure to collect within the allowed steps.\n  return actions_taken", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:39:51.994567", "function_name": "collect", "function_body": "  actions = []\n  max_steps = 500  # Set a reasonable maximum number of steps to prevent infinite loops\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  # Map action names to their integer values\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  for current_step_count in range(max_steps):\n    obs = env.observations()\n    current_inventory = obs['features_dict']['inventory']\n\n    # 1. Check if the primitive is already collected\n    if current_inventory[primitive] > 0:\n      return actions  # Goal achieved\n\n    features_ego = obs['features_dict']['features_ego']\n    # features_ego shape: (WINDOW_HEIGHT, WINDOW_WIDTH, N_KINDS)\n    # Agent is at the center of the window.\n    ego_h, ego_w, _ = features_ego.shape\n    agent_y, agent_x = ego_h // 2, ego_w // 2  # Agent's relative position in ego view\n\n    # Find all coordinates where the primitive is present in the egocentric view\n    primitive_coords_in_ego = np.argwhere(features_ego[:, :, primitive] == 1)\n\n    action_to_take = None\n    \n    # Priority flags for target selection\n    found_cardinal_adjacent = False\n    target_dy, target_dx = 0, 0 # Stores relative (dy, dx) of the target\n\n    # Iterate through visible primitives to find the best target\n    # Prefer cardinal adjacent > diagonal adjacent > other visible\n    \n    # First pass: Check for cardinal adjacent\n    for py, px in primitive_coords_in_ego:\n      dy = py - agent_y\n      dx = px - agent_x\n      \n      # Skip agent's own cell\n      if dx == 0 and dy == 0:\n        continue\n\n      # Check if it's cardinal adjacent (N, S, E, W)\n      if (abs(dx) == 1 and dy == 0) or (abs(dy) == 1 and dx == 0):\n        found_cardinal_adjacent = True\n        target_dy, target_dx = dy, dx\n        break # Found a cardinal one, prioritize it immediately\n\n    if found_cardinal_adjacent:\n      # Primitive is cardinal adjacent. Determine target direction to face it.\n      target_face_dir = -1\n      if target_dy == -1: target_face_dir = 0  # North (UP)\n      elif target_dy == 1: target_face_dir = 2  # South (DOWN)\n      elif target_dx == 1: target_face_dir = 1  # East (RIGHT)\n      elif target_dx == -1: target_face_dir = 3  # West (LEFT)\n\n      current_dir_one_hot = obs['features_dict']['direction']\n      current_dir = np.argmax(current_dir_one_hot)\n\n      if current_dir != target_face_dir:\n        # Not facing, need to turn. Choose the shortest turn (left or right).\n        num_right_turns = (target_face_dir - current_dir + 4) % 4\n        num_left_turns = (current_dir - target_face_dir + 4) % 4\n\n        if num_right_turns <= num_left_turns:\n          action_to_take = RIGHT\n        else:\n          action_to_take = LEFT\n      else:\n        # Already facing, use it\n        action_to_take = USE\n\n    elif len(primitive_coords_in_ego) > 0:\n      # Primitive is in view (either diagonal adjacent or further away). Move towards it.\n      min_dist = float('inf')\n      best_dx, best_dy = 0, 0\n      \n      # Find the closest primitive (Manhattan distance)\n      for py, px in primitive_coords_in_ego:\n        dy = py - agent_y\n        dx = px - agent_x\n        if dx == 0 and dy == 0: # Skip if agent is on the primitive\n          continue\n        dist = abs(dx) + abs(dy)\n        if dist < min_dist:\n          min_dist = dist\n          best_dx, best_dy = dx, dy\n\n      # Move towards the closest visible primitive (prioritize reducing larger delta in x or y)\n      if abs(best_dx) > 0 and (abs(best_dy) == 0 or abs(best_dx) >= abs(best_dy)):\n        action_to_take = RIGHT if best_dx > 0 else LEFT\n      elif abs(best_dy) > 0:\n        action_to_take = DOWN if best_dy > 0 else UP\n      else:\n        # This case should ideally not be reached if primitive_coords_in_ego is not empty\n        # and best_dx/best_dy are not (0,0). It implies agent is already on the target\n        # or target is non-movable by simple actions (e.g., in a wall).\n        # Fallback to a simple exploratory move.\n        action_to_take = UP # Arbitrary default move\n    else:\n      # Primitive not in view. Explore the environment.\n      # Strategy: try moving forward. If blocked, turn right and try again.\n      current_dir_one_hot = obs['features_dict']['direction']\n      current_dir = np.argmax(current_dir_one_hot)\n\n      # Determine action to move forward based on current direction\n      if current_dir == 0: action_to_take = UP     # North\n      elif current_dir == 1: action_to_take = RIGHT # East\n      elif current_dir == 2: action_to_take = DOWN   # South\n      elif current_dir == 3: action_to_take = LEFT  # West\n\n      # Store current position to check if the move was successful (not blocked)\n      old_pos = obs['features_dict']['pos']\n      \n      # Execute the movement action\n      _, _, _ = env.step(action_to_take)\n      actions.append(action_to_take)\n      \n      # Re-observe the environment to get the new position\n      new_obs = env.observations()\n      new_pos = new_obs['features_dict']['pos']\n\n      if np.array_equal(old_pos, new_pos):\n        # If the position did not change, the move was blocked.\n        # Immediately perform a \"turn right\" action in the same step.\n        _, _, _ = env.step(RIGHT)\n        actions.append(RIGHT)\n        # Account for the extra action taken in this iteration\n        current_step_count += 1 \n      \n      # Since we already performed actions in the 'else' block,\n      # continue to the next iteration of the main loop.\n      if current_step_count >= max_steps:\n          break # Check again if max_steps was exceeded by the extra turn\n      continue # Skip the common action execution below\n\n    # Execute the chosen action if it was determined by the `if/elif` blocks\n    # (not by the `else` block which handles its own action execution)\n    if action_to_take is not None:\n      _, _, _ = env.step(action_to_take)\n      actions.append(action_to_take)\n\n  # If max_steps is reached and the primitive is not collected,\n  # return the actions taken so far, indicating failure to collect within the limit.\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:41:51.193079", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action mappings are typically fixed in CraftLab:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  MOVE_ACTIONS = {\n      0: (0, 1),   # DOWN: (dx, dy) for grid[x, y]\n      1: (0, -1),  # UP\n      2: (-1, 0),  # LEFT\n      3: (1, 0),   # RIGHT\n  }\n  USE_ACTION = 4\n\n  def _bfs_path(grid, start_pos, target_kind_idx, world):\n      \"\"\"\n      Finds a path of movement actions from start_pos to a cell from which\n      the target_kind_idx is reachable (i.e., within a 3x3 neighborhood including current cell).\n      Returns a list of movement actions (0-3) or None if no path.\n      \"\"\"\n      q = collections.deque([(start_pos, [])]) # Queue stores ((current_x, current_y), path_actions)\n      visited = {start_pos} # Set of (x, y) coordinates visited\n\n      width, height, n_kinds = grid.shape\n      \n      # Identify impassable terrain types from the world configuration\n      impassable_indices = set()\n      if hasattr(world, 'water_index') and world.water_index is not None:\n          impassable_indices.add(world.water_index)\n      if hasattr(world, 'stone_index') and world.stone_index is not None:\n          impassable_indices.add(world.stone_index)\n      \n      def is_traversable(x, y):\n          \"\"\"Checks if a cell (x, y) is within bounds and traversable.\"\"\"\n          if not (0 <= x < width and 0 <= y < height):\n              return False # Out of bounds\n          \n          # Get indices of items present at (x,y)\n          cell_contents = np.where(grid[x, y] > 0)[0] \n          \n          # A cell is impassable if it contains an object that is in \n          # `impassable_indices` AND is NOT the `target_kind_idx`.\n          # This allows the agent to walk onto the target primitive itself (e.g., water)\n          # if it's considered an \"impassable\" type for other purposes.\n          for item_idx in cell_contents:\n              if item_idx in impassable_indices and item_idx != target_kind_idx:\n                  return False # Contains an impassable object (e.g., wall, deep water)\n          return True\n\n      while q:\n          (curr_x, curr_y), path = q.popleft()\n\n          # Check if the current position is adjacent to the primitive (including self).\n          # CraftState.next_to checks a 3x3 neighborhood for the target.\n          found_target_adjacent = False\n          for dx_adj in [-1, 0, 1]:\n              for dy_adj in [-1, 0, 1]:\n                  adj_x, adj_y = curr_x + dx_adj, curr_y + dy_adj\n                  if 0 <= adj_x < width and 0 <= adj_y < height:\n                      if grid[adj_x, adj_y, target_kind_idx] > 0:\n                          found_target_adjacent = True\n                          break\n              if found_target_adjacent:\n                  break\n          \n          if found_target_adjacent:\n              return path # Path found to a position from which USE action is effective\n\n          # Explore neighboring cells\n          for action_val, (dx, dy) in MOVE_ACTIONS.items():\n              next_x, next_y = curr_x + dx, curr_y + dy\n              next_pos = (next_x, next_y)\n              \n              if next_pos not in visited and is_traversable(next_x, next_y):\n                  visited.add(next_pos)\n                  q.append((next_pos, path + [action_val]))\n\n      return None # No path found to the primitive or its adjacency\n\n  # Main collect_v2 function\n  # -------------------------\n  \n  # Get initial state information from the environment\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_pos = tuple(features_dict['pos'].tolist()) # Convert numpy array to tuple for hashing\n  current_inventory = features_dict['inventory']\n  full_grid = features_dict['features_global']\n  \n  # Access the CraftLab's internal CraftWorld instance for obstacle information\n  world = env.world \n\n  # 1. Check if the primitive is already in inventory\n  if current_inventory[primitive] > 0:\n      return [] # Already collected, no actions needed\n\n  # 2. Find a path to a location from which the primitive can be collected\n  path_to_primitive_adjacent = _bfs_path(full_grid, current_pos, primitive, world)\n\n  if path_to_primitive_adjacent is None:\n      # No path found to the primitive or its adjacency, cannot collect\n      return []\n\n  # 3. If a path is found, append the USE action to collect the primitive\n  return path_to_primitive_adjacent + [USE_ACTION]", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:41:52.164240", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n  # Import actions if not globally available in the test environment\n  # Assuming these are constant integer values\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map actions to coordinate deltas for movement\n  ACTION_TO_DELTAS = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  def _is_cell_walkable(x, y, grid, world, width, height, n_kinds):\n      \"\"\"\n      Checks if an agent can walk onto cell (x, y).\n      A cell is walkable if it's in bounds and does not contain a solid, unmovable obstacle.\n      \"\"\"\n      if not (0 <= x < width and 0 <= y < height):\n          return False  # Out of bounds\n\n      # Iterate over all kinds present in the cell\n      for k_idx in range(n_kinds):\n          if grid[x, y, k_idx] > 0:  # If there's something of this kind in the cell\n              # A cell is blocked if it contains a non-grabbable item that is NOT a workshop.\n              # This implies we can walk on grabbable items and workshops.\n              if k_idx in world.non_grabbable_indices and k_idx not in world.workshop_indices:\n                  return False # This kind is a blocking obstacle\n      return True # Cell is walkable\n\n  def _find_path_actions_bfs(start_pos, target_pos_list, state, world):\n      \"\"\"\n      Finds a shortest path from start_pos to any position in target_pos_list.\n      Returns a list of actions (moves only) to reach a target cell.\n      \"\"\"\n      grid = state.grid\n      width, height, n_kinds = grid.shape\n      \n      q = deque([(start_pos, [])]) # (pos, path_actions)\n      visited = set([start_pos])\n\n      target_set = set(target_pos_list)\n\n      while q:\n          (curr_x, curr_y), path_actions = q.popleft()\n\n          if (curr_x, curr_y) in target_set:\n              return path_actions # Path to a target cell found\n\n          # Explore neighbors (UP, DOWN, LEFT, RIGHT moves)\n          for action, (dx, dy) in ACTION_TO_DELTAS.items():\n              next_x, next_y = curr_x + dx, curr_y + dy\n              next_pos = (next_x, next_y)\n\n              if next_pos not in visited and \\\n                 _is_cell_walkable(next_x, next_y, grid, world, width, height, n_kinds):\n                  visited.add(next_pos)\n                  q.append((next_x, next_y, path_actions + [action]))\n      \n      return None # No path found\n\n  initial_state = env._current_state\n  world = initial_state.world\n  cookbook = world.cookbook\n  index = cookbook.index\n  \n  actions_history = [] # List to store all actions taken\n\n  # --- Tool Acquisition Logic (if needed) ---\n  required_tool_idx = None\n  \n  # Identify common primitive-tool relationships\n  # Using .getitem() for robustness if item is not indexed yet (though index() would add it)\n  water_idx = world.water_index if hasattr(world, 'water_index') else None\n  stone_idx = world.stone_index if hasattr(world, 'stone_index') else None\n\n  bucket_idx = index.getitem(\"bucket\")\n  pickaxe_idx = index.getitem(\"pickaxe\")\n  axe_idx = index.getitem(\"axe\") # Assuming axe for wood/tree, if applicable\n\n  # Check if the primitive to collect requires a specific tool\n  if primitive == water_idx and bucket_idx is not None:\n      required_tool_idx = bucket_idx\n  elif primitive == stone_idx and pickaxe_idx is not None:\n      required_tool_idx = pickaxe_idx\n  elif index.get(primitive) in [\"wood\", \"tree\"] and axe_idx is not None: # Heuristic for wood/tree\n      required_tool_idx = axe_idx\n\n  current_pos_for_plan = initial_state.pos # Agent's starting position for planning\n\n  # If a tool is needed and not currently in inventory\n  if required_tool_idx is not None and initial_state.inventory[required_tool_idx] == 0:\n      tool_name = index.get(required_tool_idx)\n      tool_recipe = cookbook.recipes.get(required_tool_idx)\n\n      if tool_recipe is None:\n          # Cannot craft tool if no recipe exists\n          return [] \n      \n      # Find available workshops on the grid\n      workshops_on_grid = []\n      for x in range(initial_state.grid.shape[0]):\n          for y in range(initial_state.grid.shape[1]):\n              for ws_idx in world.workshop_indices:\n                  if initial_state.grid[x, y, ws_idx] > 0: # If a workshop entity is at (x,y)\n                      workshops_on_grid.append((x, y))\n                      break # Found a workshop at this cell, move to next cell\n\n      if not workshops_on_grid:\n          # No workshop to craft tools\n          return [] \n      \n      # Find path to the closest workshop\n      path_to_workshop = _find_path_actions_bfs(current_pos_for_plan, workshops_on_grid, initial_state, world)\n      \n      if path_to_workshop is None:\n          # No path found to any workshop\n          return [] \n      \n      actions_history.extend(path_to_workshop)\n      actions_history.append(USE) # Action to craft the tool at the workshop\n\n      # Update agent's conceptual position for subsequent planning after crafting\n      # This is a virtual update, assuming the actions will be executed by the environment\n      for action in path_to_workshop:\n          dx, dy = ACTION_TO_DELTAS[action]\n          current_pos_for_plan = (current_pos_for_plan[0] + dx, current_pos_for_plan[1] + dy)\n      # The USE action itself doesn't change position, but it completes the crafting.\n\n  # --- Primitive Collection Logic ---\n  primitive_locations = []\n  width, height, n_kinds = initial_state.grid.shape\n  for x in range(width):\n      for y in range(height):\n          if initial_state.grid[x, y, primitive] > 0:\n              primitive_locations.append((x, y))\n  \n  if not primitive_locations:\n      # Primitive not found on the grid\n      return []\n\n  # Find the closest primitive and path to its adjacent cell\n  best_primitive_path = None\n  \n  for p_loc in primitive_locations:\n      adj_cells_for_primitive = []\n      for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]: # Check N, S, E, W neighbors\n          adj_x, adj_y = p_loc[0] + dx, p_loc[1] + dy\n          # Ensure the adjacent cell is within bounds and walkable\n          if _is_cell_walkable(adj_x, adj_y, initial_state.grid, world, width, height, n_kinds):\n              adj_cells_for_primitive.append((adj_x, adj_y))\n      \n      if not adj_cells_for_primitive:\n          continue # No walkable adjacent cells for this instance of the primitive\n\n      path_to_primitive = _find_path_actions_bfs(current_pos_for_plan, adj_cells_for_primitive, initial_state, world)\n      \n      if path_to_primitive is not None:\n          if best_primitive_path is None or len(path_to_primitive) < len(best_primitive_path):\n              best_primitive_path = path_to_primitive\n\n  if best_primitive_path is None:\n      # No path found to any collectable primitive instance\n      return []\n\n  actions_history.extend(best_primitive_path)\n  actions_history.append(USE) # Use action to collect the primitive\n\n  return actions_history", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:44:13.914886", "function_name": "collect", "function_body": "  import collections\n  \n  # Assuming these constants are globally defined or imported from `env_factory`\n  # For completeness and local testing, they might look like this:\n  # ACTION_DOWN = 0\n  # ACTION_UP = 1\n  # ACTION_LEFT = 2\n  # ACTION_RIGHT = 3\n  # ACTION_USE = 4\n  # MAX_COLLECT_STEPS = 100 # A reasonable default if not provided\n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"Returns the coordinates of the cell directly in front of (y,x) based on direction.\"\"\"\n      if direction == 0: return y - 1, x # UP\n      if direction == 1: return y, x + 1 # RIGHT\n      if direction == 2: return y + 1, x # DOWN\n      if direction == 3: return y, x - 1 # LEFT\n      return y, x # Should not be reached for valid movement directions\n\n  def _get_direction_from_action(action):\n      \"\"\"Returns the direction integer (0-3) corresponding to a movement action.\"\"\"\n      if action == ACTION_UP: return 0\n      if action == ACTION_RIGHT: return 1\n      if action == ACTION_DOWN: return 2\n      if action == ACTION_LEFT: return 3\n      return -1 # Not a valid movement action\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state\n  current_obs = env.reset() \n  # Access the internal CraftState instance for detailed information\n  current_state = env._current_state \n\n  # Ensure the primitive is a valid kind known to the world\n  if primitive not in current_state.world.cookbook.kinds:\n      return [] \n\n  # Check if the primitive is already in the inventory\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.init_dir # Agent's initial facing direction\n\n  impassable_kinds = current_state.world.non_grabbable_indices\n\n  # Define movement actions and their resulting directions and (dy, dx) changes.\n  # Assuming movement actions (UP, DOWN, LEFT, RIGHT) also set the agent's facing direction.\n  # Direction mapping: 0=Up, 1=Right, 2=Down, 3=Left\n  movement_actions_map = {\n      ACTION_UP:    (0, -1, 0), # (resulting_direction, dy, dx)\n      ACTION_RIGHT: (1, 0, 1),\n      ACTION_DOWN:  (2, 1, 0),\n      ACTION_LEFT:  (3, 0, -1)\n  }\n\n  q = collections.deque()\n  # BFS state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  q.append((start_y, start_x, start_dir, []))\n  # Visited set now tracks (position, direction) to allow for pathing through the same cell\n  # but facing a different direction.\n  visited = {(start_y, start_x, start_dir)} \n\n  path_to_use = None # Will store the sequence of actions including the final USE\n\n  # --- BFS to find a path to a position and orientation suitable for collection ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Check if the primitive is directly in front of the agent at current (y,x,dir)\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Ensure facing coordinates are within bounds\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width):\n          # Check if the cell directly in front contains the primitive\n          if full_grid[facing_y, facing_x, primitive] > 0:\n              # We found a path to a position and orientation where ACTION_USE should work.\n              path_to_use = path + [ACTION_USE]\n              break # Path found, exit BFS\n\n      # Explore neighbors (movement actions)\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Check bounds for the next agent position\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the next cell is traversable (does not contain any impassable kind)\n          is_traversable = True\n          for k_idx in impassable_kinds:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n          \n          # Check if this (position, direction) state has been visited\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n  \n  # --- Execute the found path (if any) ---\n  if path_to_use is None:\n      return [] # No path found to directly collect the primitive\n\n  # Execute actions step by step, respecting MAX_COLLECT_STEPS\n  for i, action in enumerate(path_to_use):\n      if len(actions_taken) >= MAX_COLLECT_STEPS:\n          # Prevent excessively long action sequences\n          break \n\n      actions_taken.append(action)\n      reward, done, _ = env.step(action)\n      current_state = env._current_state # Update state after the step\n\n      # If the goal is satisfied (primitive collected), we can stop early\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n  \n  # Final check: if the primitive was collected (e.g., ACTION_USE was the last action executed)\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If we reached here, the full path was executed, but collection failed\n      # or max steps was hit before completing the necessary actions for collection.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T16:44:13.985222", "function_name": "collect", "function_body": "    # Constants for CraftLab actions. These are defined inside the function\n    # to adhere to the prompt's request of \"only return code that will fit in that function\".\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # A reasonable maximum number of steps for a single collection attempt.\n    # This constant was implicitly used in collect_v0, so it's included here.\n    MAX_COLLECT_STEPS = 100 \n\n    # Direction vectors for agent's facing direction (0:Down, 1:Up, 2:Left, 3:Right)\n    # Maps direction index to (dy, dx) tuple.\n    DIR_VECTORS = {0: (1, 0), 1: (-1, 0), 2: (0, -1), 3: (0, 1)}\n    # Map movement action to the resulting agent direction.\n    ACTION_TO_DIR = {ACTION_DOWN: 0, ACTION_UP: 1, ACTION_LEFT: 2, ACTION_RIGHT: 3}\n\n    # Import collections.deque needed for BFS.\n    import collections\n\n    # Nested helper function for Breadth-First Search (BFS) to find a path to the primitive.\n    # This version extends _find_path_to_primitive_v1_bfs by being nested.\n    def _find_path_to_primitive_bfs(start_pos, start_dir, full_grid, primitive_id, world):\n        grid_height, grid_width, _ = full_grid.shape\n        start_y, start_x = start_pos\n\n        impassable_kinds = world.non_grabbable_indices\n        # Determine if the primitive itself is traversable (e.g., small item on ground)\n        # or if it's an obstacle (e.g., large resource node like stone, water).\n        can_move_onto_primitive = primitive_id not in impassable_kinds\n\n        q = collections.deque()\n        # State in queue: (y, x, current_direction, path_of_actions_to_reach_this_state)\n        q.append((start_y, start_x, start_dir, []))\n        visited = {(start_y, start_x, start_dir)} # Keep track of visited (pos, dir) states\n\n        # Information for movement actions: (dy, dx, action_to_take, new_facing_direction)\n        move_actions_info = [\n            (1, 0, ACTION_DOWN, 0),\n            (-1, 0, ACTION_UP, 1),\n            (0, -1, ACTION_LEFT, 2),\n            (0, 1, ACTION_RIGHT, 3)\n        ]\n\n        while q:\n            curr_y, curr_x, curr_dir, path_actions = q.popleft()\n\n            # Calculate the cell the agent is currently facing.\n            face_dy, face_dx = DIR_VECTORS[curr_dir]\n            facing_y, facing_x = curr_y + face_dy, curr_x + face_dx\n\n            # Check if the current state (position and direction) allows for immediate collection.\n            # This is the \"target\" condition for the BFS.\n            target_found = False\n            # Case 1: Primitive is traversable (e.g., loose item). Agent can stand on it.\n            # Assume 'USE' picks up from the current cell if standing on a traversable primitive.\n            if can_move_onto_primitive and full_grid[curr_y, curr_x, primitive_id] > 0:\n                target_found = True\n            # Case 2: Primitive is non-traversable (e.g., rock, water). Agent must be adjacent and facing it.\n            # This is the typical case for \"using\" an external object.\n            elif (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n                  full_grid[facing_y, facing_x, primitive_id] > 0):\n                target_found = True\n            \n            if target_found:\n                # Found a path to a state from which the primitive can be 'USE'd.\n                return path_actions \n\n            # Explore neighbors: Try each possible movement action.\n            for dy_move, dx_move, action_move, next_dir in move_actions_info:\n                next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n                # Check if the next position is within grid boundaries.\n                if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                    continue\n\n                # Check if this (position, direction) state has already been visited to prevent cycles.\n                if (next_y, next_x, next_dir) in visited:\n                    continue\n\n                # Check if the next cell is traversable (i.e., does not contain any impassable kind).\n                is_traversable = True\n                for k_idx in impassable_kinds:\n                    if full_grid[next_y, next_x, k_idx] > 0:\n                        is_traversable = False\n                        break\n                if not is_traversable:\n                    continue\n\n                # Add the new state to the queue and mark as visited.\n                visited.add((next_y, next_x, next_dir))\n                q.append((next_y, next_x, next_dir, path_actions + [action_move]))\n\n        return None # No path found to the primitive.\n\n    actions_taken = []\n    \n    # Reset the environment to get the initial state and access the internal CraftState.\n    current_obs = env.reset() \n    current_state = env._current_state \n\n    # ----- Improvement for v2: Validate the 'primitive' type. -----\n    # Ensure the given 'primitive' index actually corresponds to a primitive resource\n    # defined in the cookbook. This prevents attempts to 'collect' non-primitive items\n    # (like crafted goods or environment objects that aren't collectible primitives).\n    if primitive not in current_state.world.cookbook.primitives:\n        return [] # This function is only for collecting actual primitive resources.\n\n    # If the primitive is already in the inventory, no actions are needed.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get the full global grid and the agent's current position and direction for BFS and checks.\n    full_grid = current_state.features_dict()['features_global']\n    start_pos = current_state.pos\n    start_dir = current_state.dir\n    \n    grid_height, grid_width, _ = full_grid.shape # Get grid dimensions for boundary checks.\n\n    # Determine if the primitive itself is traversable for initial check and later.\n    impassable_kinds = current_state.world.non_grabbable_indices\n    can_move_onto_primitive = primitive not in impassable_kinds\n\n    # Check if we can collect immediately from the starting position and direction.\n    can_collect_immediately = False\n    if can_move_onto_primitive and full_grid[start_pos[0], start_pos[1], primitive] > 0:\n        can_collect_immediately = True\n    else:\n        # Check if agent is facing the primitive from an adjacent cell.\n        face_dy, face_dx = DIR_VECTORS[start_dir]\n        facing_y, facing_x = start_pos[0] + face_dy, start_pos[1] + face_dx\n        if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n                full_grid[facing_y, facing_x, primitive] > 0):\n            can_collect_immediately = True\n\n    if can_collect_immediately:\n        # If possible to collect immediately, add 'USE' action and verify.\n        if len(actions_taken) < MAX_COLLECT_STEPS:\n            actions_taken.append(ACTION_USE)\n            reward, done, _ = env.step(ACTION_USE)\n            current_state = env._current_state # Update state after the action.\n            if current_state.inventory[primitive] > 0:\n                return actions_taken # Successfully collected.\n            else:\n                return [] # Collection failed even though conditions seemed met.\n        else:\n            return [] # Max steps hit, cannot add USE action.\n\n    # Find a path to a position and direction from where the primitive can be collected using BFS.\n    path_of_moves = _find_path_to_primitive_bfs(start_pos, start_dir, full_grid, primitive, current_state.world)\n\n    if path_of_moves is None:\n        return [] # No path found to the primitive on the map or it's unreachable.\n\n    # Execute the found path of movements.\n    for action in path_of_moves:\n        # Stop if the total number of actions would exceed MAX_COLLECT_STEPS.\n        if len(actions_taken) >= MAX_COLLECT_STEPS:\n            break \n\n        actions_taken.append(action)\n        reward, done, current_obs = env.step(action)\n        current_state = env._current_state # Update state after each step.\n\n        # After each movement, check if the agent is now in a position and facing correctly to collect.\n        can_collect_now = False\n        if can_move_onto_primitive and full_grid[current_state.pos[0], current_state.pos[1], primitive] > 0:\n            can_collect_now = True\n        else:\n            face_dy, face_dx = DIR_VECTORS[current_state.dir]\n            facing_y, facing_x = current_state.pos[0] + face_dy, current_state.pos[1] + face_dx\n            if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n                    full_grid[facing_y, facing_x, primitive] > 0):\n                can_collect_now = True\n\n        if can_collect_now:\n            # If conditions are met, attempt to 'USE' and collect.\n            if len(actions_taken) < MAX_COLLECT_STEPS: # Ensure there's space for the USE action.\n                actions_taken.append(ACTION_USE)\n                reward, done, current_obs = env.step(ACTION_USE)\n                current_state = env._current_state # Update state after USE.\n                if current_state.inventory[primitive] > 0:\n                    return actions_taken # Successfully collected.\n                else:\n                    return [] # Collection failed after reaching and attempting USE.\n            else:\n                return [] # Max steps hit right before the final USE action could be added.\n\n    # If the loop completes, it means either the path was too long (hit MAX_COLLECT_STEPS)\n    # or collection wasn't possible at the end of the path (e.g., 'USE' failed).\n    # Return the actions only if the primitive was actually collected.\n    return actions_taken if current_state.inventory[primitive] > 0 else []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:45:28.528934", "function_name": "collect", "function_body": "    actions = []\n\n    # 1. Get Current State\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    raw_pos = obs['features_dict']['pos']\n    inventory = obs['features_dict']['inventory']\n\n    grid_height, grid_width, _ = grid.shape\n    \n    # Convert normalized position to grid coordinates (y, x)\n    # Note: raw_pos is [norm_x, norm_y], grid indexing is [y, x]\n    pos_x = int(raw_pos[0] * (grid_width - 1))\n    pos_y = int(raw_pos[1] * (grid_height - 1))\n    \n    current_pos = (pos_y, pos_x)\n\n    # 2. Check if Already Collected\n    if inventory[primitive] > 0:\n        return []\n\n    # 3. Find Target Primitive Locations\n    target_locations = []\n    for y in range(grid_height):\n        for x in range(grid_width):\n            # Check if this cell contains the primitive\n            # Assuming grid[y, x, k] > 0 means kind k is present at (y, x)\n            if grid[y, x, primitive] > 0:\n                target_locations.append((y, x))\n\n    if not target_locations:\n        # Primitive not found on the grid\n        return []\n\n    # 4. Find Closest Target and Path (BFS)\n    # Queue stores tuples of ((current_y, current_x), [path_actions_taken])\n    queue = collections.deque([(current_pos, [])]) \n    visited = {current_pos} # Set of visited (y, x) tuples to avoid cycles and redundant paths\n    \n    best_path_to_target = None\n    \n    # BFS to find path to ANY target_location\n    while queue:\n        (curr_y, curr_x), path_so_far = queue.popleft()\n\n        # Check if current position is one of the target locations\n        # If the agent is already on the primitive's cell, the path is empty.\n        if (curr_y, curr_x) in target_locations:\n            best_path_to_target = path_so_far\n            break # Found shortest path to a target\n\n        # Define possible moves and their corresponding actions\n        # (dy, dx, action_id)\n        # DOWN (0): +1 in y\n        # UP (1): -1 in y\n        # LEFT (2): -1 in x\n        # RIGHT (3): +1 in x\n        possible_moves = [\n            (1, 0, 0),  # (dy, dx, DOWN_ACTION)\n            (-1, 0, 1), # (dy, dx, UP_ACTION)\n            (0, -1, 2), # (dy, dx, LEFT_ACTION)\n            (0, 1, 3)   # (dy, dx, RIGHT_ACTION)\n        ]\n\n        for dy, dx, action in possible_moves:\n            next_y, next_x = curr_y + dy, curr_x + dx\n            next_pos = (next_y, next_x)\n\n            # Check bounds of the grid\n            if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                continue\n\n            # Check if this position has already been visited\n            if next_pos in visited:\n                continue\n\n            # Add to queue for further exploration\n            visited.add(next_pos)\n            queue.append((next_pos, path_so_far + [action]))\n\n    if best_path_to_target is None:\n        # No path found to any primitive location on the grid\n        return []\n\n    # 5. Append USE Action\n    # Once the agent reaches the primitive's cell (which is assumed for grabbable primitives),\n    # a single USE action is performed to collect it.\n    actions.extend(best_path_to_target)\n    actions.append(4) # USE_ACTION (as per action_specs: USE->4)\n\n    return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:45:29.509345", "function_name": "collect", "function_body": "  actions = []\n  max_iterations = 2000 # Safety limit to prevent infinite loops for complex or impossible paths\n\n  # Get initial count of the primitive in inventory\n  # This assumes the primitive is collectable and adds to inventory\n  initial_inventory_count = env._current_state.inventory[primitive]\n\n  for _ in range(max_iterations):\n    current_state = env._current_state\n\n    # 1. Check if primitive is already collected\n    if current_state.inventory[primitive] > initial_inventory_count:\n        return actions\n\n    # 2. Check if agent is next to the primitive\n    # The `next_to` method checks the 3x3 neighborhood, including the agent's current cell.\n    if current_state.next_to(primitive):\n        # Agent is next to it (or on it), so use the item\n        actions.append(4) # Action: USE\n        reward, done, _ = env.step(4)\n        # After 'USE', the primitive should be in inventory (if successful).\n        # The loop will re-check inventory in the next iteration.\n        if done: # If max_steps reached, stop even if not collected\n            return actions\n        continue # Continue to next loop iteration to re-check inventory status\n\n    # 3. Primitive not collected and not next to agent, need to move\n    grid = current_state.grid\n    current_pos = current_state.pos # Agent's current (row, col) as an integer tuple\n\n    # Find the primitive's location on the grid\n    # np.where returns (rows, cols) for non-zero elements where the primitive is present\n    primitive_locations_r, primitive_locations_c = np.where(grid[:, :, primitive] > 0)\n\n    # If the primitive is no longer on the grid, or never existed, we cannot collect it.\n    if primitive_locations_r.size == 0:\n        return actions # Return actions taken so far, indicating failure to collect.\n\n    # Pick the first instance found as the target for simplicity\n    target_r, target_c = primitive_locations_r[0], primitive_locations_c[0]\n\n    # Determine movement direction towards the target\n    curr_r, curr_c = current_pos\n    move_action = -1 # Initialize with an invalid action\n\n    dr = target_r - curr_r\n    dc = target_c - curr_c\n\n    # Prioritize vertical movement first (towards target row)\n    if dr > 0: # Target is below (increase row index)\n        move_action = 0 # Action: DOWN\n    elif dr < 0: # Target is above (decrease row index)\n        move_action = 1 # Action: UP\n    else: # dr == 0, target is on the same row, move horizontally\n        if dc > 0: # Target is to the right (increase col index)\n            move_action = 3 # Action: RIGHT\n        elif dc < 0: # Target is to the left (decrease col index)\n            move_action = 2 # Action: LEFT\n        # If dr == 0 and dc == 0: agent is exactly on target_pos.\n        # This case should have been handled by `current_state.next_to(primitive)`\n        # leading to a USE action. If we reach here, it implies a logical issue\n        # or the primitive cannot be collected this way, so we cannot proceed.\n        else:\n            return actions # Cannot move or collect from current state.\n\n    # Execute the determined movement action\n    actions.append(move_action)\n    reward, done, _ = env.step(move_action)\n\n    if done: # If max_steps reached or other 'done' condition, stop\n        return actions\n\n  # If the loop finishes (e.g., max_iterations reached) without collecting the primitive,\n  # return the actions taken so far. This indicates a failure to collect within limits.\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:46:55.330112", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Define action constants based on action_specs\n    # These are typically module-level constants, but are placed inside the function\n    # body to strictly adhere to the prompt's requirement to \"only return code that\n    # will fit in that function\" without relying on external (module-level) definitions\n    # that are not part of the provided snippet.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Map of (dx, dy) movement vectors to their corresponding action IDs\n    ACTION_MAP = {\n        (0, -1): UP,    # Moving up means decreasing y-coordinate\n        (0, 1): DOWN,   # Moving down means increasing y-coordinate\n        (-1, 0): LEFT,  # Moving left means decreasing x-coordinate\n        (1, 0): RIGHT   # Moving right means increasing x-coordinate\n    }\n\n    def _coords_to_actions(path_coords):\n        \"\"\"\n        Helper function to convert a list of (x, y) coordinates representing a path\n        into a list of corresponding action IDs.\n        \"\"\"\n        actions = []\n        for i in range(len(path_coords) - 1):\n            x1, y1 = path_coords[i]\n            x2, y2 = path_coords[i+1]\n            dx, dy = x2 - x1, y2 - y1\n            action = ACTION_MAP.get((dx, dy))\n            if action is not None:\n                actions.append(action)\n            else:\n                # This case should ideally not be reached if the path is valid and\n                # only consists of cardinal movements.\n                pass \n        return actions\n\n    actions = []\n    \n    # Get current state information from the environment\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    \n    # The agent's position is provided as a normalized numpy array; convert to integer tuple (x, y)\n    current_pos_normalized = obs['features_dict']['pos']\n    current_pos = (int(round(current_pos_normalized[0])), int(round(current_pos_normalized[1])))\n\n    # Determine grid dimensions (grid is of shape WIDTH, HEIGHT, n_kinds)\n    grid_width, grid_height, _ = grid.shape\n    \n    # Identify all grid locations where the primitive is present\n    target_locations = []\n    # np.where returns (row_indices, col_indices) for a 2D array. Here, grid[:, :, primitive]\n    # acts as a 2D array of (WIDTH, HEIGHT). So, x_coords are column indices, y_coords are row indices.\n    x_coords, y_coords = np.where(grid[:, :, primitive] > 0)\n    for x, y in zip(x_coords, y_coords):\n        target_locations.append((x, y))\n\n    # If the primitive is not found on the grid, there are no actions to collect it\n    if not target_locations:\n        return []\n\n    # Use Breadth-First Search (BFS) to find the shortest path to any target primitive\n    q = collections.deque()\n    # Queue stores tuples of ((current_x, current_y), list_of_coordinates_in_path_to_here)\n    q.append((current_pos, [current_pos])) \n    \n    visited = {current_pos} # Set to keep track of visited coordinates to avoid cycles and redundant exploration\n    \n    best_path = None # Stores the shortest path found to any target location\n    \n    while q:\n        (x, y), path = q.popleft()\n\n        # If the current position is one of the target primitive locations, we've found the shortest path\n        if (x, y) in target_locations:\n            best_path = path\n            break # Exit BFS as the shortest path to a target has been found\n        \n        # Explore neighboring cells (up, down, left, right)\n        for dx, dy in ACTION_MAP.keys():\n            nx, ny = x + dx, y + dy # Calculate new coordinates\n            \n            # Check if the new coordinates are within grid boundaries\n            if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                # Check if the cell has not been visited yet\n                if (nx, ny) not in visited:\n                    # Determine if the cell (nx, ny) contains an obstacle\n                    # Obstacles are defined as 'non-grabbable entities' in the world's cookbook environment\n                    is_obstacle = False\n                    for kind_idx in env.world.cookbook.environment:\n                        if grid[nx, ny, kind_idx] > 0: # If any non-grabbable entity is in the cell\n                            is_obstacle = True\n                            break\n                    \n                    if not is_obstacle:\n                        visited.add((nx, ny))\n                        q.append(((nx, ny), path + [(nx, ny)])) # Add neighbor to queue with updated path\n\n    if best_path:\n        # Convert the found coordinate path into a sequence of agent actions\n        actions = _coords_to_actions(best_path)\n        # After reaching the primitive's location, perform the USE action to collect it\n        actions.append(USE)\n    \n    return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:46:56.316689", "function_name": "collect", "function_body": "  # Constants for actions as per CraftLab.action_specs()\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  actions_taken = []\n  # Access the internal CraftState for direct manipulation and queries\n  current_state = env._current_state \n\n  # Max steps to prevent infinite loops in case of unreachable primitive or flawed logic\n  MAX_ATTEMPTS = 500 \n\n  for _ in range(MAX_ATTEMPTS):\n    # 1. Check if the primitive is already collected (in inventory)\n    if current_state.inventory[primitive] > 0:\n      break # Goal achieved, exit loop\n\n    # 2. Check if the primitive is in the agent's immediate vicinity (3x3 neighborhood)\n    if current_state.next_to(primitive):\n      # If it's nearby, attempt to 'USE' it (which typically means picking it up for primitives)\n      actions_taken.append(ACTION_USE)\n      # Perform the action in the environment and update the internal state reference\n      _, _, _ = env.step(ACTION_USE)\n      current_state = env._current_state \n      \n      # Re-check inventory immediately after attempting USE, as it might have been collected\n      if current_state.inventory[primitive] > 0:\n        break # Goal achieved after USE action\n\n    # 3. If the primitive is not yet collected and not next to the agent,\n    #    find the closest instance on the grid and move towards it.\n    grid = current_state.grid\n    agent_x, agent_y = current_state.pos\n\n    best_dist_sq = float('inf')\n    target_x, target_y = -1, -1\n    \n    grid_width, grid_height, _ = grid.shape\n\n    found_primitive_on_grid = False\n    # Iterate through the entire grid to find the closest primitive\n    for x in range(grid_width):\n      for y in range(grid_height):\n        # Check if this cell contains the primitive (grid value > 0 means presence)\n        if grid[x, y, primitive] > 0: \n          dist_sq = (x - agent_x)**2 + (y - agent_y)**2\n          if dist_sq < best_dist_sq:\n            best_dist_sq = dist_sq\n            target_x, target_y = x, y\n            found_primitive_on_grid = True\n    \n    if not found_primitive_on_grid:\n      # If the primitive is not found anywhere on the visible grid, \n      # this collection strategy cannot proceed.\n      break # Terminate if the primitive is unreachable or not present\n\n    # Determine the next movement action to get closer to the target primitive\n    move_action = -1\n    if target_x != agent_x:\n      # Prioritize horizontal movement to align with the target's X-coordinate\n      if target_x > agent_x:\n        move_action = ACTION_RIGHT\n      else: # target_x < agent_x\n        move_action = ACTION_LEFT\n    elif target_y != agent_y:\n      # If X-coordinates are aligned, move vertically to align with the target's Y-coordinate\n      if target_y > agent_y:\n        move_action = ACTION_DOWN\n      else: # target_y < agent_y\n        move_action = ACTION_UP\n    else:\n      # The agent is already at the target_x, target_y coordinates.\n      # If we reached this point, it means the primitive was not collected and not 'next_to'\n      # (even though it's at the same position). This might happen if the item at\n      # the agent's exact cell is not grabbable with 'USE', or if the 'next_to'\n      # definition doesn't include the current cell. In such a scenario,\n      # this simple greedy approach is stuck.\n      break \n\n    if move_action != -1:\n      actions_taken.append(move_action)\n      # Perform the determined movement action\n      _, _, _ = env.step(move_action)\n      current_state = env._current_state # Update state reference after action\n    else:\n      # This case should ideally not be reached if target_x, target_y are different from agent_x, agent_y.\n      # If it is, it implies no valid movement action was determined, suggesting the agent is stuck.\n      break\n\n  return actions_taken", "island_id": 7, "scores": {"3": -1}}
