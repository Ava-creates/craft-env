{"timestamp": "2025-07-31T02:48:31.704708", "function_name": "collect", "function_body": "  import collections\n  # numpy is implicitly available from top-level imports and used as np\n\n  # Action mappings from the environment's action_specs()\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']  # Assumed to be a cardinal move action (West) for pathfinding\n  _RIGHT = _actions_map['RIGHT'] # Assumed to be a cardinal move action (East) for pathfinding\n  _USE = _actions_map['USE']\n\n  # Define constants for movement and direction logic\n  # (dx, dy) deltas for cardinal movements (North, South, West, East)\n  _CARDINAL_MOVE_DELTAS = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n  # Corresponding movement actions. These are the actions that change the agent's position.\n  _CARDINAL_MOVE_ACTIONS = [_UP, _DOWN, _LEFT, _RIGHT]\n\n  # Mapping from a cardinal movement action to the agent's resulting facing direction (N=0, E=1, S=2, W=3).\n  # This assumes that after an agent moves, its facing direction aligns with the direction of movement.\n  _ACTION_TO_FINAL_DIR = {\n      _UP: 0,     # Moving North sets direction to North (0)\n      _RIGHT: 1,  # Moving East sets direction to East (1)\n      _DOWN: 2,   # Moving South sets direction to South (2)\n      _LEFT: 3    # Moving West sets direction to West (3)\n  }\n\n  # Mapping from a (dx, dy) vector (from agent's position to item's position)\n  # to the cardinal direction (0-3) the agent needs to face to use the item.\n  _VECTOR_TO_FACING_DIR = {\n      (0, -1): 0, # Item is North of agent, so face North\n      (1, 0): 1,  # Item is East of agent, so face East\n      (0, 1): 2,  # Item is South of agent, so face South\n      (-1, 0): 3, # Item is West of agent, so face West\n  }\n\n  def _get_current_env_state_info(env):\n    \"\"\"\n    Extracts current agent position, direction, grid, and grid dimensions from the environment.\n    \"\"\"\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    \n    current_grid = features_dict['features_global']\n    # Use initial grid shape for world dimensions, assuming they are constant.\n    WIDTH, HEIGHT, _ = env.scenario.init_grid.shape \n\n    # Convert normalized agent position to grid coordinates\n    current_pos_normalized = features_dict['pos']\n    current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n    current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n    current_pos = (current_px, current_py)\n\n    # Get current agent facing direction (0=N, 1=E, 2=S, 3=W)\n    current_dir = np.argmax(features_dict['direction']) \n    return current_grid, current_pos, current_dir, WIDTH, HEIGHT\n\n  def _is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"\n    Checks if the cell (x,y) contains any non-grabbable item (obstacle).\n    Boundary checks are typically handled by the calling BFS loop.\n    \"\"\"\n    for k in non_grabbable_items_set:\n      if grid[x, y, k] == 1:\n        return True\n    return False\n\n  def _find_shortest_path_to_target(start_pos, target_kind, grid, non_grabbable_indices, width, height, move_deltas, move_actions):\n    \"\"\"\n    Performs a Breadth-First Search (BFS) to find the shortest path to a cell\n    containing or adjacent to the specified target_kind.\n    \n    Returns:\n    - final_approach_pos: The (x, y) coordinates where the agent should stand to interact.\n    - item_pos_for_use: The (x, y) coordinates of the actual item to be used.\n    - parent_map: A dictionary mapping (child_pos) -> (parent_pos, action_taken_to_reach_child)\n                  for path reconstruction.\n    Returns (None, None, None) if the target is unreachable.\n    \"\"\"\n    q = collections.deque()\n    q.append(start_pos) \n    \n    parent_map = {start_pos: (None, None)} # Store parent position and action taken to reach child\n    visited = {start_pos} \n\n    final_approach_pos = None \n    item_pos_for_use = None   \n\n    while q:\n      cx, cy = q.popleft()\n\n      # Priority 1: Agent lands directly on the target_kind\n      if grid[cx, cy, target_kind] == 1:\n        final_approach_pos = (cx, cy)\n        item_pos_for_use = (cx, cy)\n        break \n\n      # Priority 2: Agent is adjacent to the target_kind\n      for dx_adj, dy_adj in move_deltas: \n        nx_adj, ny_adj = cx + dx_adj, cy + dy_adj\n\n        # Check grid boundaries for adjacent cell\n        if not (0 <= nx_adj < width and 0 <= ny_adj < height):\n            continue\n        \n        if grid[nx_adj, ny_adj, target_kind] == 1:\n            final_approach_pos = (cx, cy) # Agent's current position is the approach position\n            item_pos_for_use = (nx_adj, ny_adj) # The item is in the adjacent cell\n            break \n      \n      if final_approach_pos is not None:\n          break # Path found, exit BFS\n\n      # Explore neighbors\n      for (dx, dy), action in zip(move_deltas, move_actions):\n        nx, ny = cx + dx, cy + dy\n\n        # Check grid boundaries for neighbor\n        if not (0 <= nx < width and 0 <= ny < height):\n          continue\n        # Skip if already visited\n        if (nx, ny) in visited:\n          continue\n        # Skip if neighbor is an obstacle\n        if _is_obstacle(nx, ny, grid, non_grabbable_indices):\n          continue\n\n        q.append(((nx, ny)))\n        visited.add((nx, ny))\n        parent_map[(nx, ny)] = ((cx, cy), action) # Store how we reached this neighbor\n    \n    return final_approach_pos, item_pos_for_use, parent_map\n\n  def _get_actions_to_collect(parent_map, final_approach_pos, item_pos_for_use, initial_agent_dir, action_map, vector_to_facing_dir_map, action_to_final_dir_map):\n    \"\"\"\n    Reconstructs the movement path from the `parent_map` and appends necessary\n    turning and 'USE' actions to collect the item.\n    Assumes that cardinal movement actions update the agent's facing direction.\n    \"\"\"\n    actions_path = []\n    if final_approach_pos is None:\n        return actions_path # Target not found or unreachable\n\n    # Reconstruct the movement path in reverse order\n    current = final_approach_pos\n    last_path_move_action = None # To determine agent's final direction after movements\n    \n    while parent_map[current][0] is not None:\n        parent, action = parent_map[current]\n        actions_path.append(action)\n        last_path_move_action = action \n        current = parent\n    actions_path.reverse() # Reverse to get actions in correct order\n\n    # Determine the agent's final facing direction after executing all path movements.\n    # If no movement actions were taken (agent started on/adjacent to primitive),\n    # its direction remains its initial direction. Otherwise, it's set by the last move.\n    current_dir_at_final_pos = initial_agent_dir\n    if last_path_move_action is not None:\n        current_dir_at_final_pos = action_to_final_dir_map.get(last_path_move_action, initial_agent_dir)\n\n    # Append 'USE' action and any necessary turning actions\n    # If the agent is on the item, direct pickup. No facing/turning needed.\n    if final_approach_pos == item_pos_for_use:\n        actions_path.append(action_map['USE'])\n    else:\n        # Agent is adjacent to the item, needs to face it and then USE.\n        # Calculate the vector from agent's final position to the item's position.\n        dx_face = item_pos_for_use[0] - final_approach_pos[0]\n        dy_face = item_pos_for_use[1] - final_approach_pos[1]\n        \n        # Determine the target facing direction for the agent\n        target_facing_dir_idx = vector_to_facing_dir_map.get((dx_face, dy_face))\n\n        if target_facing_dir_idx is not None:\n            # Calculate the difference in direction to find minimal turns\n            # (0=no turn, 1=right turn, 2=180 degree turn, 3=left turn)\n            diff_dir = (target_facing_dir_idx - current_dir_at_final_pos + 4) % 4\n            \n            if diff_dir == 1: # Turn 90 degrees right\n                actions_path.append(action_map['RIGHT']) # Assumed to be a turn action here\n            elif diff_dir == 2: # Turn 180 degrees (two right turns)\n                actions_path.extend([action_map['RIGHT'], action_map['RIGHT']])\n            elif diff_dir == 3: # Turn 90 degrees left\n                actions_path.append(action_map['LEFT']) # Assumed to be a turn action here\n        \n        actions_path.append(action_map['USE'])\n    \n    return actions_path\n\n  # Main logic for collect_v2 function\n  # First, check if the primitive is actually grabbable according to the world rules\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information including agent's position, direction, and grid\n  current_grid, current_pos, current_dir, WIDTH, HEIGHT = _get_current_env_state_info(env)\n  non_grabbable_indices = env.world.non_grabbable_indices # Items that act as obstacles\n\n  # Find the shortest path to the primitive using BFS\n  final_approach_pos, item_pos_for_use, parent_map = _find_shortest_path_to_target(\n      current_pos, primitive, current_grid, non_grabbable_indices, \n      WIDTH, HEIGHT, _CARDINAL_MOVE_DELTAS, _CARDINAL_MOVE_ACTIONS\n  )\n\n  # Generate the full sequence of actions (movement, turns, and USE)\n  actions_to_take = _get_actions_to_collect(\n      parent_map, final_approach_pos, item_pos_for_use, current_dir, \n      _actions_map, _VECTOR_TO_FACING_DIR, _ACTION_TO_FINAL_DIR\n  )\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:49:30.500143", "function_name": "collect", "function_body": "  import collections\n\n  # Constants for actions (defined by CraftLab/CraftWorld)\n  _DOWN_ACTION = 0\n  _UP_ACTION = 1\n  _LEFT_ACTION = 2\n  _RIGHT_ACTION = 3\n  _USE_ACTION = 4\n\n  # Constants for agent's facing directions (mapping to integer IDs)\n  # These correspond to the directions defined within the CraftState/CraftWorld\n  _NORTH_DIR = 0\n  _EAST_DIR = 1\n  _SOUTH_DIR = 2\n  _WEST_DIR = 3\n\n  # Mapping movement actions to their (dx, dy) deltas on the grid\n  _ACTION_DELTAS = {\n      _UP_ACTION: (0, -1),   # Moving up decreases Y coordinate\n      _DOWN_ACTION: (0, 1),    # Moving down increases Y coordinate\n      _LEFT_ACTION: (-1, 0),  # Moving left decreases X coordinate\n      _RIGHT_ACTION: (1, 0),   # Moving right increases X coordinate\n  }\n\n  # Mapping movement actions to the agent's resulting facing direction\n  _ACTION_TO_DIR = {\n      _UP_ACTION: _NORTH_DIR,\n      _DOWN_ACTION: _SOUTH_DIR,\n      _LEFT_ACTION: _WEST_DIR,\n      _RIGHT_ACTION: _EAST_DIR,\n  }\n\n  # Mapping agent's facing directions to the (dx, dy) deltas for the cell in front\n  _DIR_TO_DELTA = {\n      _NORTH_DIR: (0, -1), # Facing North, cell in front is (0, -1) relative\n      _EAST_DIR: (1, 0),   # Facing East, cell in front is (1, 0) relative\n      _SOUTH_DIR: (0, 1),  # Facing South, cell in front is (0, 1) relative\n      _WEST_DIR: (-1, 0),  # Facing West, cell in front is (-1, 0) relative\n  }\n\n  # Helper function to get coordinates of the cell directly in front of the agent\n  def _get_facing_coords(x, y, direction):\n      dx, dy = _DIR_TO_DELTA[direction]\n      return x + dx, y + dy\n\n  # Get current state information from the environment\n  current_state = env._current_state\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape # Grid dimensions\n  start_x, start_y = current_state.pos # Agent's starting position\n  start_dir = current_state.dir # Agent's starting direction\n\n  # Pre-determine the type of primitive for efficient checks later\n  is_grabbable_primitive = primitive in env.world.grabbable_indices\n  is_use_primitive = (primitive == env.world.water_index or\n                      primitive == env.world.stone_index)\n\n  # If the primitive is neither grabbable nor interactable with USE, it's uncollectible by this function\n  if not is_grabbable_primitive and not is_use_primitive:\n      return []\n\n  # Initialize BFS queue: (current_x, current_y, current_direction, path_actions_list)\n  # path_actions_list stores the sequence of actions to reach this state.\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Initialize visited set: stores (x, y, direction) tuples to avoid redundant explorations and cycles\n  visited = set([(start_x, start_y, start_dir)])\n\n  # BFS loop\n  while queue:\n      curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n      # --- Check for Success Condition ---\n      # Condition 1: If the primitive is grabbable and the agent is on its cell.\n      # Grabbable items are collected simply by moving onto their location.\n      if is_grabbable_primitive:\n          if grid[curr_x, curr_y, primitive] > 0:\n              return path_actions # Path to reach the item's location\n\n      # Condition 2: If the primitive requires a USE action (e.g., water, stone)\n      # The agent must be adjacent to the item and facing it to use it.\n      elif is_use_primitive:\n          face_x, face_y = _get_facing_coords(curr_x, curr_y, curr_dir)\n\n          # Check if the cell directly in front is within bounds and contains the target primitive\n          if (0 <= face_x < WIDTH and 0 <= face_y < HEIGHT and\n                  grid[face_x, face_y, primitive] > 0):\n              return path_actions + [_USE_ACTION] # Path to position + face + USE action\n\n      # --- Explore Neighboring States via Movement Actions ---\n      for action_val in [_UP_ACTION, _DOWN_ACTION, _LEFT_ACTION, _RIGHT_ACTION]:\n          dx, dy = _ACTION_DELTAS[action_val]\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_dir = _ACTION_TO_DIR[action_val] # Agent's direction after performing this action\n\n          # 1. Check for out-of-bounds movement\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # 2. Check for impassable terrain in the next cell\n          # A cell is considered impassable if it contains any non-grabbable item\n          # that is not a workshop and not water. Workshops and water are typically traversable.\n          is_blocked_by_impassable = False\n          for k_idx in env.world.non_grabbable_indices:\n              if grid[next_x, next_y, k_idx] > 0: # If this non-grabbable item is present in the cell\n                  # If it's not a workshop or water, then it blocks movement\n                  if k_idx not in env.world.workshop_indices and k_idx != env.world.water_index:\n                      is_blocked_by_impassable = True\n                      break # Found a blocking object, no need to check further kinds for this cell\n          if is_blocked_by_impassable:\n              continue # This cell is blocked, cannot move here\n\n          # 3. If the new state (position and direction) has not been visited, add it to the queue\n          if (next_x, next_y, next_dir) not in visited:\n              visited.add((next_x, next_y, next_dir))\n              new_path_actions = path_actions + [action_val]\n              queue.append((next_x, next_y, next_dir, new_path_actions))\n\n  # If the BFS completes and no path was found, return an empty list\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:49:31.490511", "function_name": "collect", "function_body": "  import collections\n\n  # Constants for actions and directions (aligned with CraftLab.action_specs)\n  _DOWN_ACTION = 0\n  _UP_ACTION = 1\n  _LEFT_ACTION = 2\n  _RIGHT_ACTION = 3\n  _USE_ACTION = 4\n\n  # Directions as integers (standard for CraftWorld)\n  _NORTH_DIR = 0 # Corresponds to UP action\n  _EAST_DIR = 1  # Corresponds to RIGHT action\n  _SOUTH_DIR = 2 # Corresponds to DOWN action\n  _WEST_DIR = 3  # Corresponds to LEFT action\n\n  # Mapping movement actions to their (dx, dy) coordinate changes\n  _ACTION_DELTAS = {\n      _UP_ACTION: (0, -1),   # Move up (decreases y-coordinate)\n      _DOWN_ACTION: (0, 1),    # Move down (increases y-coordinate)\n      _LEFT_ACTION: (-1, 0),  # Move left (decreases x-coordinate)\n      _RIGHT_ACTION: (1, 0),   # Move right (increases x-coordinate)\n  }\n\n  # Mapping movement actions to the direction the agent will be facing after the action\n  _ACTION_TO_DIR = {\n      _UP_ACTION: _NORTH_DIR,\n      _DOWN_ACTION: _SOUTH_DIR,\n      _LEFT_ACTION: _WEST_DIR,\n      _RIGHT_ACTION: _EAST_DIR,\n  }\n\n  # Mapping directions to their (dx, dy) deltas to find the cell in front of the agent\n  _DIR_TO_DELTA = {\n      _NORTH_DIR: (0, -1),\n      _EAST_DIR: (1, 0),\n      _SOUTH_DIR: (0, 1),\n      _WEST_DIR: (-1, 0),\n  }\n\n  # Get current state and world configuration from the CraftLab environment\n  current_state = env._current_state\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape # Grid dimensions\n  start_x, start_y = current_state.pos # Agent's starting position\n  start_dir = current_state.dir # Agent's starting direction\n\n  # Cache frequently accessed world attributes for performance and clarity\n  world = env.world\n  grabbable_indices = world.grabbable_indices\n  non_grabbable_indices = world.non_grabbable_indices\n  workshop_indices = world.workshop_indices\n  water_index = world.water_index\n  stone_index = world.stone_index\n\n  # Determine how the primitive can be collected\n  is_grabbable = primitive in grabbable_indices\n  is_use_collectable = (primitive == water_index or primitive == stone_index)\n\n  # If the primitive is neither grabbable (picked up by walking over)\n  # nor a known \"use\"-collectable item (like water/stone), it cannot be collected by this function.\n  if not is_grabbable and not is_use_collectable:\n      return []\n\n  # Initialize BFS queue: (current_x, current_y, current_direction, list_of_actions_taken)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Initialize visited set: stores (x, y, direction) tuples to avoid redundant states and cycles\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n      curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n      # --- Check if the current state satisfies the collection goal ---\n      if is_grabbable:\n          # For grabbable items, the goal is to be on the same cell as the item.\n          if grid[curr_x, curr_y, primitive] > 0:\n              return path_actions # Path found to reach the grabbable item\n      elif is_use_collectable:\n          # For items collected via USE action (e.g., water, stone), agent must be adjacent and facing it.\n          face_dx, face_dy = _DIR_TO_DELTA[curr_dir] # Delta for the cell directly in front\n          face_x, face_y = curr_x + face_dx, curr_y + face_dy\n\n          # Check if the facing cell is within grid bounds and contains the primitive\n          if (0 <= face_x < WIDTH and 0 <= face_y < HEIGHT and\n                  grid[face_x, face_y, primitive] > 0):\n              return path_actions + [_USE_ACTION] # Path to position, face, then USE action\n\n      # --- Explore Neighbors via Movement Actions ---\n      # Iterate through all possible movement actions (UP, DOWN, LEFT, RIGHT)\n      for action_val in [_UP_ACTION, _DOWN_ACTION, _LEFT_ACTION, _RIGHT_ACTION]:\n          move_dx, move_dy = _ACTION_DELTAS[action_val] # Coordinate change for this action\n          next_x, next_y = curr_x + move_dx, curr_y + move_dy\n          next_dir = _ACTION_TO_DIR[action_val] # New direction after performing this action\n\n          # Check for out-of-bounds movement\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check if the next cell is blocked by impassable terrain.\n          # A cell is considered blocked if it contains any non-grabbable item\n          # that is not a workshop or water (workshops and water are typically traversable).\n          is_blocked = False\n          for k_idx in non_grabbable_indices:\n              if grid[next_x, next_y, k_idx] > 0: # If this non-grabbable item is present at next_x, next_y\n                  # If the item is not a workshop and not water, it blocks movement\n                  if k_idx not in workshop_indices and k_idx != water_index:\n                      is_blocked = True\n                      break # Found a blocking object, no need to check other kinds\n          if is_blocked:\n              continue # Cannot move to this blocked cell\n\n          # If the new state (position and direction) has not been visited, add it to the queue\n          if (next_x, next_y, next_dir) not in visited:\n              visited.add((next_x, next_y, next_dir))\n              queue.append((next_x, next_y, next_dir, path_actions + [action_val]))\n\n  # If the BFS completes and no path to collect the primitive is found, return an empty list.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:51:19.736929", "function_name": "collect", "function_body": "  import collections # Required for deque\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Define direction constants (assuming 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  _DIR_UP = 0\n  _DIR_RIGHT = 1\n  _DIR_DOWN = 2\n  _DIR_LEFT = 3\n\n  # Helper function to calculate turn actions to change from current_dir to target_dir\n  def _get_turn_actions(current_dir, target_dir):\n      turn_actions = []\n      \n      # Calculate shortest rotation\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # One clockwise turn needed (e.g., UP to RIGHT)\n          turn_actions.append(_RIGHT)\n      elif diff == 2: # Two turns needed (180 degrees)\n          turn_actions.extend([_RIGHT, _RIGHT]) # Can be two LEFTs too, same cost\n      elif diff == 3: # One counter-clockwise turn needed (e.g., UP to LEFT)\n          turn_actions.append(_LEFT)\n      \n      return turn_actions\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n\n  # Get current agent direction (convert one-hot array to integer)\n  current_dir_int = np.argmax(features_dict['direction'])\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Define truly impassable terrain for movement (e.g., water, walls)\n  impassable_movement_terrain_indices = {env.world.water_index} \n  # If stone is intended as an impassable wall, uncomment the line below:\n  # impassable_movement_terrain_indices.add(env.world.stone_index)\n\n  def is_obstacle(x, y, grid, impassable_kinds_set):\n    \"\"\"Checks if the cell (x,y) contains any truly impassable item for movement.\"\"\"\n    # Check boundaries first\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n        return True # Treat out of bounds as obstacle\n    for k in impassable_kinds_set:\n      if grid[x, y, k] == 1:\n        return True\n    return False\n\n  # BFS setup\n  # Queue stores tuples: (current_x, current_y, current_direction, [path_actions_to_reach_here])\n  q = collections.deque()\n  q.append((current_px, current_py, current_dir_int, [])) \n  \n  # Set to store visited states: ((x, y), direction) to avoid cycles and re-processing longer paths to same state\n  visited = set() \n  visited.add((current_px, current_py, current_dir_int))\n\n  # Directions for movement and the resulting new agent direction\n  # (dx, dy, new_dir_after_move, action_to_take_for_this_move)\n  move_options = [\n      (0, -1, _DIR_UP, _UP),    # Move North (Up)\n      (0, 1, _DIR_DOWN, _DOWN),  # Move South (Down)\n      (-1, 0, _DIR_LEFT, _LEFT), # Move West (Left)\n      (1, 0, _DIR_RIGHT, _RIGHT) # Move East (Right)\n  ]\n\n  # Offsets for checking adjacent cells for the primitive and the required direction to face them\n  # (dx, dy, required_agent_face_direction_to_interact_with_this_offset)\n  adjacent_check_offsets = [\n      (0, -1, _DIR_UP),    # North cell, requires agent to face UP\n      (0, 1, _DIR_DOWN),   # South cell, requires agent to face DOWN\n      (-1, 0, _DIR_LEFT),  # West cell, requires agent to face LEFT\n      (1, 0, _DIR_RIGHT)   # East cell, requires agent to face RIGHT\n  ]\n\n  while q:\n    cx, cy, cdir, current_path = q.popleft()\n\n    # --- GOAL CHECK ---\n    # Check if from the current position (cx, cy) and facing cdir,\n    # we are adjacent to a primitive and can immediately USE it.\n    # This loop is optimized to check only the four cardinal neighbors,\n    # rather than iterating through all primitive locations on the grid.\n    for dx_adj, dy_adj, required_face_dir_for_adj in adjacent_check_offsets:\n        adj_x, adj_y = cx + dx_adj, cy + dy_adj\n\n        # Check if adjacent cell is within grid boundaries and contains the primitive\n        if (0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT) and current_grid[adj_x, adj_y, primitive] == 1:\n            # Primitive is found in an adjacent cell. Calculate turns needed to face it.\n            turns_to_face = _get_turn_actions(cdir, required_face_dir_for_adj)\n            \n            # Since BFS explores layer by layer, the *first* time we hit such a state\n            # (position, direction from which _USE is possible), it represents\n            # the shortest path to collect any primitive.\n            return current_path + turns_to_face + [_USE]\n\n    # --- EXPLORE MOVEMENT NEIGHBORS ---\n    for dx_move, dy_move, new_agent_dir_after_move, move_action in move_options:\n      nx, ny = cx + dx_move, cy + dy_move\n\n      # Check if the potential target cell is an obstacle for movement (includes boundary check)\n      if is_obstacle(nx, ny, current_grid, impassable_movement_terrain_indices):\n        continue\n\n      # Calculate turns needed to align with the direction of the intended move\n      # The agent must face the direction of movement BEFORE moving.\n      turns_for_move = _get_turn_actions(cdir, new_agent_dir_after_move)\n      \n      # The state after moving: new position (nx, ny) and new direction (new_agent_dir_after_move)\n      new_state_tuple = (nx, ny, new_agent_dir_after_move)\n\n      if new_state_tuple not in visited:\n        # Construct the path segment for this step: turns + movement\n        path_segment = turns_for_move + [move_action]\n        new_total_path = current_path + path_segment\n        \n        visited.add(new_state_tuple)\n        q.append((nx, ny, new_agent_dir_after_move, new_total_path))\n  \n  # If BFS completes and no path to collect the primitive was found (e.g., unreachable)\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:51:20.719281", "function_name": "collect", "function_body": "  import collections # Required for deque\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Define direction constants (assuming 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  _DIR_UP = 0\n  _DIR_RIGHT = 1\n  _DIR_DOWN = 2\n  _DIR_LEFT = 3\n\n  # Helper function to calculate turn actions to change from current_dir to target_dir\n  def _get_turn_actions(current_dir, target_dir):\n      \"\"\"Calculates minimal turn actions to change from current_dir to target_dir.\"\"\"\n      turn_actions = []\n      \n      # Calculate shortest rotation\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # One clockwise turn needed\n          turn_actions.append(_RIGHT)\n      elif diff == 2: # Two turns needed (180 degrees)\n          turn_actions.extend([_RIGHT, _RIGHT]) # Can be two LEFTs too, same cost\n      elif diff == 3: # One counter-clockwise turn needed\n          turn_actions.append(_LEFT)\n      \n      return turn_actions\n\n  # Helper function to get the cardinal direction from (from_x, from_y) to (to_x, to_y)\n  def _get_relative_direction(from_x, from_y, to_x, to_y):\n      \"\"\"Determines the direction from (from_x, from_y) to (to_x, to_y) if adjacent.\"\"\"\n      if from_x == to_x:\n          if to_y == from_y - 1: return _DIR_UP\n          if to_y == from_y + 1: return _DIR_DOWN\n      elif from_y == to_y:\n          if to_x == from_x + 1: return _DIR_RIGHT\n          if to_x == from_x - 1: return _DIR_LEFT\n      return None # Not adjacent in a cardinal direction\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  # Ensure position is within grid bounds (due to rounding or float precision)\n  current_px = max(0, min(current_px, WIDTH - 1))\n  current_py = max(0, min(current_py, HEIGHT - 1))\n  current_pos = (current_px, current_py)\n\n\n  # Get current agent direction (convert one-hot array to integer)\n  current_dir_int = np.argmax(features_dict['direction'])\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = set() # Use a set for faster lookups\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell\n      if current_grid[x, y, primitive] == 1:\n        primitive_locations.add((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  # Define truly impassable terrain for movement (e.g., water, walls)\n  impassable_movement_terrain_indices = {env.world.water_index} \n  # If stone is intended as an impassable wall, uncomment the line below:\n  # impassable_movement_terrain_indices.add(env.world.stone_index)\n\n  def is_obstacle(x, y, grid, impassable_kinds_set):\n    \"\"\"Checks if the cell (x,y) contains any truly impassable item for movement.\"\"\"\n    for k in impassable_kinds_set:\n      if grid[x, y, k] == 1:\n        return True\n    return False\n\n  # BFS setup\n  # Queue stores tuples: (current_x, current_y, current_direction)\n  q = collections.deque()\n  \n  # Parent map: (child_x, child_y, child_dir) -> (parent_x, parent_y, parent_dir, [actions_from_parent])\n  # [actions_from_parent] is a list of actions (turns + 1 move)\n  parent = {} \n  \n  # Set to store visited states: (x, y, direction) to avoid cycles and re-processing longer paths to same state\n  visited = set() \n\n  start_state = (current_px, current_py, current_dir_int)\n  q.append(start_state)\n  visited.add(start_state)\n  parent[start_state] = None # No parent for start state\n\n  goal_found_state = None # Will store the (x,y,dir) state from which _USE is possible\n\n  # Directions for movement and the resulting new agent direction after taking the action.\n  # This matches the interpretation in collect_v1: agent's direction changes to match its move.\n  # (dx, dy, new_dir_after_move, action_to_take_for_this_move)\n  move_options = [\n      (0, -1, _DIR_UP, _UP),    # Move North (Up action)\n      (0, 1, _DIR_DOWN, _DOWN),  # Move South (Down action)\n      (-1, 0, _DIR_LEFT, _LEFT), # Move West (Left action)\n      (1, 0, _DIR_RIGHT, _RIGHT) # Move East (Right action)\n  ]\n\n  while q:\n    cx, cy, cdir = q.popleft()\n\n    # --- GOAL CHECK ---\n    # Check if from the current position (cx, cy) and facing cdir,\n    # we are adjacent to a primitive and can immediately USE it.\n    for px, py in primitive_locations:\n        # Check if (cx, cy) is adjacent to (px, py) (Manhattan distance 1)\n        if abs(cx - px) + abs(cy - py) == 1:\n            # Determine the required direction for the agent to face (px, py) from (cx, cy)\n            required_face_dir = _get_relative_direction(cx, cy, px, py)\n            \n            if required_face_dir is not None: # Ensure it's a valid cardinal neighbor\n                # If already facing the primitive, this state is a valid precursor to _USE.\n                if cdir == required_face_dir:\n                    goal_found_state = (cx, cy, cdir)\n                    break # Found the shortest path to a collectable state, exit BFS\n        if goal_found_state: break\n    if goal_found_state: break # Exit outer while loop too\n\n    # --- EXPLORE MOVEMENT NEIGHBORS ---\n    for dx, dy, new_agent_dir_after_move, move_action in move_options:\n      nx, ny = cx + dx, cy + dy\n\n      # Check boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if the potential target cell is an obstacle for movement\n      if is_obstacle(nx, ny, current_grid, impassable_movement_terrain_indices):\n        continue\n\n      # The next state in BFS (position and direction after move)\n      next_state = (nx, ny, new_agent_dir_after_move)\n\n      if next_state not in visited:\n        # Calculate actions to transition: turns to face move direction + the move action itself\n        actions_to_reach_next_state = _get_turn_actions(cdir, new_agent_dir_after_move) + [move_action]\n        \n        visited.add(next_state)\n        q.append(next_state)\n        parent[next_state] = (cx, cy, cdir, actions_to_reach_next_state) # Store sequence of actions\n\n  # --- Path Reconstruction ---\n  if not goal_found_state:\n    return [] # No path found\n\n  # Backtrack from the goal state to the start state\n  path = []\n  current_reconstruct_state = goal_found_state\n  \n  while current_reconstruct_state != start_state:\n    prev_state_tuple, actions_segment = parent[current_reconstruct_state]\n    path.extend(actions_segment) # Add the segment of actions (turns + move)\n    current_reconstruct_state = prev_state_tuple\n  \n  path.reverse() # Reverse to get actions from start to goal\n\n  # Add the final _USE action\n  path.append(_USE)\n\n  return path", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:53:20.301594", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos\n  agent_dir = state.dir\n  world = state.world\n\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n\n  # Define constants for actions and directions for readability\n  _NORTH = 0\n  _EAST = 1\n  _SOUTH = 2\n  _WEST = 3\n\n  _ACTION_DOWN = 0\n  _ACTION_UP = 1\n  _ACTION_LEFT = 2\n  _ACTION_RIGHT = 3\n  _ACTION_USE = 4\n\n  # Maps action (UP, DOWN, LEFT, RIGHT) to (dr, dc) delta\n  _ACTION_TO_DELT_MAP = {\n      _ACTION_UP: (-1, 0),\n      _ACTION_DOWN: (1, 0),\n      _ACTION_LEFT: (0, -1),\n      _ACTION_RIGHT: (0, 1)\n  }\n\n  # Maps direction (NORTH, EAST, SOUTH, WEST) to (dr, dc) delta\n  _DIR_TO_DELT_MAP = {\n      _NORTH: (-1, 0),\n      _EAST: (0, 1),\n      _SOUTH: (1, 0),\n      _WEST: (0, -1)\n  }\n\n  # Determine if the primitive is grabbable or a workshop\n  is_grabbable = primitive in world.grabbable_indices\n  is_workshop = primitive in world.workshop_indices\n\n  if not is_grabbable and not is_workshop:\n      # If the primitive is neither directly grabbable nor a workshop,\n      # this collection logic does not apply.\n      return []\n\n  # Find all locations of the primitive on the grid\n  target_locations = []\n  for r in range(WIDTH):\n    for c in range(HEIGHT):\n      if grid[r, c, primitive] == 1:\n        target_locations.append((r, c))\n\n  if not target_locations:\n    return [] # Primitive not found on the map\n\n  # BFS for pathfinding\n  # Queue state: (current_position (r,c), current_direction, list_of_actions_so_far)\n  queue = collections.deque([(agent_pos, agent_dir, [])])\n  # Visited states: (position (r,c), direction) to avoid cycles and redundant exploration\n  visited = set([(agent_pos, agent_dir)])\n\n  while queue:\n    current_pos, current_dir, current_path = queue.popleft()\n    r, c = current_pos\n\n    # Goal Check\n    if is_grabbable:\n        if current_pos in target_locations:\n            # Agent is on the primitive's square, meaning it's collected.\n            return current_path\n    elif is_workshop:\n        # Check if current_pos is adjacent to any workshop location\n        for tr, tc in target_locations:\n            if abs(r - tr) + abs(c - tc) == 1: # Manhattan distance 1 means adjacent\n                # Determine the direction to face the workshop from current_pos\n                dr_to_target = tr - r\n                dc_to_target = tc - c\n                target_face_dir = None\n                for d, delt in _DIR_TO_DELT_MAP.items():\n                    if delt == (dr_to_target, dc_to_target):\n                        target_face_dir = d\n                        break\n                \n                # IMPROVEMENT: Only consider this as a goal state if the agent is\n                # also facing the correct direction. This ensures the BFS finds\n                # the optimal path including necessary turns.\n                if target_face_dir is not None and current_dir == target_face_dir:\n                    # Found a state where agent is adjacent AND facing the workshop.\n                    final_actions = list(current_path)\n                    final_actions.append(_ACTION_USE) # Add the USE action\n                    return final_actions # Path found and complete\n\n    # Explore possible next states (movement actions)\n    for action_move, (dr, dc) in _ACTION_TO_DELT_MAP.items():\n        nr, nc = r + dr, c + dc\n        new_pos = (nr, nc)\n\n        # Check grid boundaries\n        if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n            continue\n\n        # Check traversability: A cell is considered an obstacle if it contains\n        # any item from `world.non_grabbable_indices`.\n        is_obstacle = False\n        for k_on_cell in range(N_KINDS):\n            if grid[nr, nc, k_on_cell] == 1 and k_on_cell in world.non_grabbable_indices:\n                is_obstacle = True\n                break\n        \n        if is_obstacle:\n            continue\n        \n        new_state_tuple = (new_pos, current_dir) # Movement actions do not change agent's orientation\n        if new_state_tuple not in visited:\n            visited.add(new_state_tuple)\n            queue.append((new_pos, current_dir, current_path + [action_move]))\n\n    # Explore possible next states (turning actions, no movement)\n    for turn_action in [_ACTION_LEFT, _ACTION_RIGHT]:\n        new_dir_val = current_dir\n        if turn_action == _ACTION_LEFT:\n            new_dir_val = (current_dir - 1 + 4) % 4\n        elif turn_action == _ACTION_RIGHT:\n            new_dir_val = (current_dir + 1) % 4\n        \n        new_state_tuple = (current_pos, new_dir_val)\n        if new_state_tuple not in visited:\n            visited.add(new_state_tuple)\n            queue.append((current_pos, new_dir_val, current_path + [turn_action]))\n\n  return [] # No path found after exploring all reachable states", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:53:21.274682", "function_name": "collect", "function_body": "", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:54:50.797225", "function_name": "collect", "function_body": "    # 1. Get initial observations from the environment\n    obs = env.observations()\n    state_dict = obs['features_dict']\n    # Agent's position is normalized, convert to integer grid coordinates\n    start_x, start_y = int(state_dict['pos'][0]), int(state_dict['pos'][1])\n    start_grid = state_dict['features_global']\n    WIDTH, HEIGHT, N_KINDS = start_grid.shape\n\n    # 2. Define Movement Actions and their deltas\n    # Action mapping from CraftLab: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    MOVE_DELTAS = { # action_id: (dx, dy)\n        0: (0, 1),  # DOWN\n        1: (0, -1), # UP\n        2: (-1, 0), # LEFT\n        3: (1, 0)   # RIGHT\n    }\n    USE_ACTION = 4\n\n    # 3. Identify Primitive Locations on the grid\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            # Check if this cell contains the desired primitive\n            if start_grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return [] # No primitive of this type found in the initial grid\n\n    # Get non-grabbable indices from the world configuration to identify obstacles\n    # These are entities the agent cannot pass through.\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    def is_passable(x, y):\n        \"\"\"Checks if a grid cell (x, y) is within bounds and not an obstacle.\"\"\"\n        if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n            return False # Out of bounds\n        for k_idx in non_grabbable_indices:\n            # If the cell contains any non-grabbable item, it's an obstacle\n            if start_grid[x, y, k_idx] > 0:\n                return False\n        return True\n\n    # 4. Perform Breadth-First Search (BFS) to find the shortest path\n    # The BFS state will be (current_x, current_y, list_of_actions_taken_to_reach_here)\n    # We use collections.deque for efficient queue operations.\n    queue = collections.deque([(start_x, start_y, [])])\n    # Keep track of visited (x, y) positions to avoid cycles and redundant paths\n    visited = {(start_x, start_y)} \n\n    while queue:\n        cx, cy, current_actions = queue.popleft()\n\n        # Check if the current position is adjacent to any of the primitive locations.\n        # We assume the 'USE' action works on any adjacent primitive regardless of agent's facing direction\n        # as there are no explicit 'turn' actions.\n        is_adjacent_to_primitive = False\n        for px, py in primitive_locations:\n            # Manhattan distance of 1 means the cells are directly adjacent (up, down, left, or right)\n            if abs(cx - px) + abs(cy - py) == 1:\n                is_adjacent_to_primitive = True\n                break\n        \n        if is_adjacent_to_primitive:\n            # If we are adjacent to the primitive, we have found a valid path.\n            # Append the 'USE' action to the path and return the complete sequence.\n            return current_actions + [USE_ACTION]\n\n        # Explore possible next moves (neighbors)\n        for action_id, (dx, dy) in MOVE_DELTAS.items():\n            nx, ny = cx + dx, cy + dy # Calculate new position\n\n            # If the new position is passable and has not been visited yet\n            if is_passable(nx, ny) and (nx, ny) not in visited:\n                visited.add((nx, ny)) # Mark as visited\n                # Add the new state to the queue with the updated path\n                queue.append((nx, ny, current_actions + [action_id]))\n\n    # If the queue becomes empty and no path to an adjacent primitive was found,\n    # it means the primitive is unreachable from the starting position.\n    return [] ", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:54:50.872272", "function_name": "collect", "function_body": "    # Helper function to check if a position is within grid bounds\n    def is_valid(r, c, H, W):\n        return 0 <= r < H and 0 <= c < W\n\n    # Helper function to check if any cell in the 3x3 neighborhood of 'pos' contains 'primitive_idx'\n    def is_next_to_primitive(grid, pos, primitive_idx):\n        r, c = pos\n        H, W, _ = grid.shape\n        # Iterate over rows: one up, current, one down\n        for dr in [-1, 0, 1]:\n            # Iterate over columns: one left, current, one right\n            for dc in [-1, 0, 1]:\n                nr, nc = r + dr, c + dc\n                if is_valid(nr, nc, H, W) and grid[nr, nc, primitive_idx] > 0:\n                    return True\n        return False\n\n    # Get current state information from the environment\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    normalized_pos = obs['features_dict']['pos']\n    current_inventory = obs['features_dict']['inventory']\n\n    # If we already have the primitive in inventory, no actions needed.\n    if current_inventory[primitive] > 0:\n        return []\n\n    H, W, _ = grid.shape  # H = rows, W = columns, _ = n_kinds\n\n    # Convert normalized position to integer grid coordinates (row, col)\n    # Assuming normalized_pos is [x_norm, y_norm] where x corresponds to columns and y to rows.\n    # So, y_norm * (H-1) gives row index, and x_norm * (W-1) gives column index.\n    # Using round for accurate conversion from float to nearest integer coordinate.\n    agent_row = int(round(normalized_pos[1] * (H - 1)))\n    agent_col = int(round(normalized_pos[0] * (W - 1)))\n    start_pos = (agent_row, agent_col)\n\n    # If the primitive is already next to the agent (or at agent's position),\n    # just use the 'USE' action immediately.\n    if is_next_to_primitive(grid, start_pos, primitive):\n        return [env.action_specs()['USE']]\n\n    # BFS Initialization\n    # Queue stores tuples of (current_position, list_of_actions_taken_to_reach_here)\n    # collections.deque is used for efficient popleft() operations.\n    queue = collections.deque([(start_pos, [])])\n    # Set to keep track of visited positions to avoid cycles and redundant exploration\n    visited = {start_pos}\n\n    # Get action integer mappings from the environment's action specifications\n    action_map = env.action_specs()\n    # Define movement deltas for each cardinal action (row_change, col_change)\n    move_action_deltas = {\n        action_map['UP']: (-1, 0),    # Move up: decrease row\n        action_map['DOWN']: (1, 0),   # Move down: increase row\n        action_map['LEFT']: (0, -1),  # Move left: decrease column\n        action_map['RIGHT']: (0, 1)   # Move right: increase column\n    }\n    use_action = action_map['USE']\n\n    # BFS search loop\n    while queue:\n        (r, c), path_actions = queue.popleft()\n\n        # Explore all possible move actions from the current position\n        for action, (dr, dc) in move_action_deltas.items():\n            nr, nc = r + dr, c + dc  # Calculate the new position (neighboring cell)\n            next_pos = (nr, nc)\n\n            # Check if the new position is valid (within grid bounds) and has not been visited yet\n            if is_valid(nr, nc, H, W) and next_pos not in visited:\n                visited.add(next_pos)  # Mark the new position as visited\n\n                # Check if reaching this new position allows us to collect the primitive.\n                # This means the primitive is in the 3x3 neighborhood of next_pos (or at next_pos itself).\n                if is_next_to_primitive(grid, next_pos, primitive):\n                    # Path found! Return the complete sequence of actions:\n                    # 1. The actions taken to reach `next_pos`.\n                    # 2. The move action (`action`) to transition from `(r, c)` to `next_pos`.\n                    # 3. The `USE` action to collect the primitive.\n                    return path_actions + [action, use_action]\n                else:\n                    # If not yet next to the primitive, add this new position to the queue\n                    # for further exploration, along with the updated list of actions taken.\n                    queue.append((next_pos, path_actions + [action]))\n\n    # If the BFS completes and no path to collect the primitive is found (e.g., unreachable or not present),\n    # return an empty list, indicating no actions can achieve the goal.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:56:10.134753", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action mappings based on CraftLab.action_specs()\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  actions_list = []\n\n  # Get initial state information from the environment\n  obs = env.observations()\n  initial_grid = obs['features_dict']['features_global']\n  \n  # Convert normalized agent position to grid coordinates\n  grid_height, grid_width, _ = initial_grid.shape\n  initial_pos_norm = obs['features_dict']['pos']\n  current_r = int(round(initial_pos_norm[0] * (grid_height - 1)))\n  current_c = int(round(initial_pos_norm[1] * (grid_width - 1)))\n  start_pos = (current_r, current_c)\n\n  # Get the index for water (non-walkable terrain)\n  # The `env` (CraftLab instance) has a `world` attribute (CraftWorld instance),\n  # which in turn has `water_index`.\n  water_idx = env.world.water_index \n  \n  # BFS setup: queue stores (position_tuple, path_list)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos}\n\n  # Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for r in range(grid_height):\n      for c in range(grid_width):\n          if initial_grid[r, c, primitive] == 1.0:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      # Primitive not found on the map, cannot collect\n      return []\n\n  # Path to primitive adjacency\n  path_to_primitive_adj = None\n\n  # Define possible movement actions and their corresponding (dr, dc) offsets\n  moves = [\n      (-1, 0, UP),    # Move North (row decreases)\n      (1, 0, DOWN),   # Move South (row increases)\n      (0, -1, LEFT),  # Move West (column decreases)\n      (0, 1, RIGHT)   # Move East (column increases)\n  ]\n\n  # BFS to find the shortest path to a cell adjacent to the primitive\n  while q:\n      (r, c), current_path = q.popleft()\n\n      # Check if the current position is adjacent to any primitive location\n      is_adjacent = False\n      for pr, pc in primitive_locations:\n          # Check if (r, c) is within the 3x3 neighborhood of (pr, pc)\n          if abs(r - pr) <= 1 and abs(c - pc) <= 1:\n              is_adjacent = True\n              break\n      \n      if is_adjacent:\n          path_to_primitive_adj = current_path\n          break # Found the path to an adjacent cell\n\n      # Explore valid neighbors\n      for dr, dc, action in moves:\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # Check grid bounds\n          if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n              continue\n\n          # Check if position already visited\n          if next_pos in visited:\n              continue\n\n          # Check if the cell is traversable (not water)\n          if initial_grid[next_r, next_c, water_idx] == 1.0:\n              continue\n\n          visited.add(next_pos)\n          q.append((next_pos, current_path + [action]))\n\n  if path_to_primitive_adj is None:\n      # Primitive is not reachable on the map\n      return []\n  \n  # The complete sequence of actions: move to an adjacent cell, then USE\n  actions_list.extend(path_to_primitive_adj)\n  actions_list.append(USE)\n  \n  return actions_list", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:56:10.204263", "function_name": "collect", "function_body": "        # Get action mappings dynamically from the environment\n        action_map = env.action_specs()\n        ACTION_DOWN = action_map['DOWN']\n        ACTION_UP = action_map['UP']\n        ACTION_LEFT = action_map['LEFT']\n        ACTION_RIGHT = action_map['RIGHT']\n        ACTION_USE = action_map['USE']\n\n        MAX_TOTAL_STEPS = 200  # A safety limit to prevent infinite loops\n\n        actions_taken = []\n        current_step_count = 0\n\n        while current_step_count < MAX_TOTAL_STEPS:\n            # Get current observations and state\n            obs = env.observations()\n            current_state = env._current_state  # Direct access to CraftState for detailed info\n\n            # 1. Check if primitive is already collected\n            if current_state.inventory[primitive] > 0:\n                return actions_taken\n\n            # 2. Check if primitive is in the immediate vicinity (3x3 neighborhood)\n            # and if it's a grabbable item that can be \"USE\"d.\n            if current_state.next_to(primitive):\n                if primitive in current_state.world.grabbable_indices:\n                    # Attempt to use (collect) the item\n                    _, _, _ = env.step(ACTION_USE)\n                    actions_taken.append(ACTION_USE)\n                    current_step_count += 1\n                    # Re-check inventory immediately after attempting to use\n                    if current_state.inventory[primitive] > 0:\n                        return actions_taken\n                    # If not collected after USE (e.g., item depleted, or non-collectable adjacent),\n                    # continue to the next loop iteration to re-evaluate or find another target.\n                    continue\n\n            # 3. If primitive not collected and not next to, find the closest instance on the grid\n            grid = current_state.grid\n            current_pos = current_state.pos\n            grid_width, grid_height, _ = grid.shape  # grid.shape is (WIDTH, HEIGHT, n_kinds)\n\n            target_primitive_pos = None\n            min_dist = float('inf')\n\n            # Iterate through the entire grid to find all occurrences of the primitive\n            # and select the one closest to the agent's current position (Manhattan distance)\n            for x in range(grid_width):\n                for y in range(grid_height):\n                    if grid[x, y, primitive] == 1:\n                        dist = abs(x - current_pos[0]) + abs(y - current_pos[1])\n                        if dist < min_dist:\n                            min_dist = dist\n                            target_primitive_pos = (x, y)\n\n            if target_primitive_pos is None:\n                # Primitive not found anywhere on the grid (e.g., already all collected, or not spawned)\n                # Cannot collect what's not there. Return actions taken so far (indicating failure).\n                return actions_taken\n\n            # 4. Move towards the target primitive position using a greedy strategy\n            move_action = None\n            dx = target_primitive_pos[0] - current_pos[0]\n            dy = target_primitive_pos[1] - current_pos[1]\n\n            # Prioritize moving along the axis with the larger absolute difference\n            if abs(dx) > abs(dy):\n                if dx > 0:\n                    move_action = ACTION_RIGHT\n                elif dx < 0:\n                    move_action = ACTION_LEFT\n                # If dx is 0, but dy is not, move along y-axis\n                elif dy > 0:\n                    move_action = ACTION_DOWN\n                elif dy < 0:\n                    move_action = ACTION_UP\n            else:  # abs(dy) >= abs(dx)\n                if dy > 0:\n                    move_action = ACTION_DOWN\n                elif dy < 0:\n                    move_action = ACTION_UP\n                # If dy is 0, but dx is not, move along x-axis\n                elif dx > 0:\n                    move_action = ACTION_RIGHT\n                elif dx < 0:\n                    move_action = ACTION_LEFT\n\n            if move_action is not None:\n                # Execute the chosen movement action\n                _, _, _ = env.step(move_action)\n                actions_taken.append(move_action)\n                current_step_count += 1\n            else:\n                # If move_action is None, it means current_pos == target_primitive_pos.\n                # In this case, if the primitive is grabbable and we are at its location,\n                # the `next_to` check at the start of the loop (or a subsequent one if it's 1x1)\n                # should trigger the USE action. If it's not grabbable, or already collected,\n                # we'll just hit MAX_TOTAL_STEPS. To avoid busy-waiting, a small break\n                # or a condition to exit if no progress for a few steps could be added.\n                # For this v2, we let the loop continue and eventually hit MAX_TOTAL_STEPS if stuck.\n                pass\n\n        # If the loop finishes, it means MAX_TOTAL_STEPS was reached without collecting the primitive.\n        return actions_taken", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:57:40.385616", "function_name": "collect", "function_body": "    # Action constants from CraftLab.action_specs()\n    # These are fixed integer values for the actions.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Mapping of movement actions to (dx, dy) deltas assuming (x, y) coordinates\n    # where x is column index and y is row index.\n    ACTION_DELTAS = {\n        UP: (0, -1),   # Moving up decreases row (y)\n        DOWN: (0, 1),    # Moving down increases row (y)\n        LEFT: (-1, 0),   # Moving left decreases column (x)\n        RIGHT: (1, 0)    # Moving right increases column (x)\n    }\n\n    # Relative coordinates for 4-connected neighbors used for checking adjacency\n    NEIGHBOR_DELTAS = [\n        (0, -1),  # North (up)\n        (0, 1),   # South (down)\n        (-1, 0),  # West (left)\n        (1, 0)    # East (right)\n    ]\n\n    # Assume 'collections' and 'np' (for numpy) are already imported at the top level\n    # as per the instruction \"Do not imports\".\n    import collections\n    import numpy as np\n\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    grid = features_dict['features_global']\n    agent_pos = features_dict['pos'].astype(int) # Agent's current (x, y) position\n\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n\n    # Access obstacle indices from the CraftWorld instance via the current state.\n    # We access `_current_state` of CraftLab to get the CraftState, and then its `world` attribute.\n    world_config = env._current_state.world\n    water_index = world_config.water_index\n    workshop_indices = world_config.workshop_indices\n    non_grabbable_indices = world_config.non_grabbable_indices\n\n    # Determine if the target primitive can be collected by stepping onto its cell\n    # (i.e., it's a grabbable item) or if it requires being adjacent (non-grabbable resource).\n    target_primitive_is_non_grabbable = primitive in non_grabbable_indices\n\n    def is_obstacle_for_path(cx, cy):\n        \"\"\"\n        Checks if a given cell (cx, cy) is an obstacle for agent movement.\n        Obstacles include out-of-bounds, water, workshops, and potentially the target primitive\n        if it's a non-grabbable type.\n        \"\"\"\n        # 1. Check bounds\n        if not (0 <= cx < WIDTH and 0 <= cy < HEIGHT):\n            return True\n\n        # 2. Check for universal impassable entities (water, workshops)\n        if grid[cx, cy, water_index] == 1:\n            return True\n        for wi in workshop_indices:\n            if grid[cx, cy, wi] == 1:\n                return True\n        \n        # 3. Check if the cell contains the target primitive, and if that primitive\n        #    is a non-grabbable type (meaning agent cannot step onto it to collect).\n        if grid[cx, cy, primitive] == 1 and target_primitive_is_non_grabbable:\n            return True\n        \n        # Otherwise, the cell is traversable.\n        return False\n\n    # BFS initialization\n    q = collections.deque()\n    visited = set()\n\n    start_x, start_y = agent_pos[0], agent_pos[1]\n    \n    # Add initial state to queue: (x, y, list_of_actions_taken)\n    q.append((start_x, start_y, []))\n    visited.add((start_x, start_y))\n\n    while q:\n        curr_x, curr_y, path_actions = q.popleft()\n\n        # Check if the current position satisfies the collection goal\n        if target_primitive_is_non_grabbable:\n            # If primitive is non-grabbable, we need to be adjacent to it and USE.\n            # Check if any adjacent cell contains the primitive.\n            for dx, dy in NEIGHBOR_DELTAS:\n                check_x, check_y = curr_x + dx, curr_y + dy\n                if 0 <= check_x < WIDTH and 0 <= check_y < HEIGHT:\n                    if grid[check_x, check_y, primitive] == 1:\n                        # Found a path to a cell adjacent to the non-grabbable primitive.\n                        # Add USE action and return the path.\n                        return path_actions + [USE]\n        else:\n            # If primitive is grabbable, we need to step onto its cell and USE.\n            # Check if the current cell contains the primitive.\n            if grid[curr_x, curr_y, primitive] == 1:\n                # Agent has reached the primitive's location.\n                # Add USE action and return the path.\n                return path_actions + [USE]\n\n        # Explore possible next states (move actions)\n        for action, (dx, dy) in ACTION_DELTAS.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n\n            # Check if the next cell is traversable and not yet visited\n            if not is_obstacle_for_path(next_x, next_y) and (next_x, next_y) not in visited:\n                q.append((next_x, next_y, path_actions + [action]))\n                visited.add((next_x, next_y))\n    \n    # If the queue is exhausted and no path to the primitive was found\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:57:41.347946", "function_name": "collect", "function_body": "  obs = env.observations()\n  grid = obs['features_global']\n  current_pos = tuple(obs['pos']) # Agent's current (row, col) position\n  height, width, n_kinds = grid.shape\n\n  # Action mappings to coordinate changes (dr, dc)\n  # Based on CraftLab.action_specs: DOWN=0, UP=1, LEFT=2, RIGHT=3\n  ACTION_DELTAS = {\n      0: (1, 0),   # DOWN (row + 1)\n      1: (-1, 0),  # UP (row - 1)\n      2: (0, -1),  # LEFT (col - 1)\n      3: (0, 1),   # RIGHT (col + 1)\n  }\n  ACTION_USE = 4 # Use action constant\n\n  # 1. Find all locations of the primitive on the grid\n  primitive_locations = []\n  for r in range(height):\n      for c in range(width):\n          # Check if the primitive kind is present at this cell\n          if grid[r, c, primitive] > 0:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      # If the primitive is not found anywhere on the map, return empty actions\n      return []\n\n  # 2. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a cell from which the primitive can be collected (adjacent or on top of it).\n  # Queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here])\n  queue = deque([(current_pos, [])])\n  visited = {current_pos} # Keep track of visited positions to avoid cycles\n\n  path_to_collect = []\n\n  while queue:\n      (r, c), actions_taken = queue.popleft()\n\n      # Check if the current position (r, c) allows collecting a primitive.\n      # This means being adjacent to the primitive, or on the same cell if USE works there.\n      # The CraftState's `next_to` method checks a 3x3 neighborhood including the agent's pos.\n      # So, a Manhattan distance <= 1 is a good general condition for \"collectable from here\".\n      is_collectable_from_here = False\n      for pr, pc in primitive_locations:\n          if abs(r - pr) + abs(c - pc) <= 1:\n              is_collectable_from_here = True\n              break\n      \n      if is_collectable_from_here:\n          # Found a path to a position where the primitive can be collected\n          path_to_collect = actions_taken\n          break\n\n      # Explore neighboring cells\n      for action_move, (dr, dc) in ACTION_DELTAS.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # Check if the new position is within grid boundaries\n          if 0 <= next_r < height and 0 <= next_c < width:\n              # Further checks could be added here for impassable terrain if necessary.\n              # For simplicity, we assume all grid cells are traversable unless specified otherwise.\n              if next_pos not in visited:\n                  visited.add(next_pos)\n                  queue.append((next_pos, actions_taken + [action_move]))\n  \n  # 3. If a path was found, append the USE action\n  if path_to_collect is not None:\n      return path_to_collect + [ACTION_USE]\n  else:\n      # No path found to any collectable primitive\n      return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:58:53.281741", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants (assuming these are standard for CraftLab)\n  _DOWN = 0\n  _UP = 1\n  _LEFT = 2\n  _RIGHT = 3\n  _USE = 4\n\n  # 1. Get current state information from the environment\n  obs = env.observations()\n  current_pos_norm = obs['features_dict']['pos']\n  global_grid = obs['features_dict']['features_global']\n  inventory = obs['features_dict']['inventory']\n\n  # Get grid dimensions (rows, columns, kinds)\n  # global_grid is a numpy array of shape (HEIGHT, WIDTH, n_kinds)\n  rows, cols, _ = global_grid.shape\n\n  # Convert normalized agent position to grid coordinates (x, y)\n  # features_dict['pos'] is typically normalized (x_coord/WIDTH, y_coord/HEIGHT)\n  current_pos_x = int(current_pos_norm[0] * cols)\n  current_pos_y = int(current_pos_norm[1] * rows)\n  current_pos = (current_pos_x, current_pos_y)\n\n  # 2. Check if the primitive is already collected\n  if inventory[primitive] > 0:\n    return []  # Primitive already in inventory, no actions needed\n\n  # 3. Find all locations of the primitive on the global grid\n  primitive_locations = []\n  # Iterate through the grid to find all cells containing the primitive\n  # global_grid is indexed as global_grid[y, x, kind_index]\n  for y in range(rows):\n    for x in range(cols):\n      if global_grid[y, x, primitive] == 1:\n        primitive_locations.append((x, y))  # Store as (x, y) coordinates\n\n  if not primitive_locations:\n    return []  # Primitive not found anywhere on the grid\n\n  # 4. Determine target cells: any cell adjacent to a primitive location\n  target_cells = set()\n  # Agent needs to be next to the primitive to USE it.\n  # Possible relative positions for an agent to be adjacent to a primitive (dx, dy)\n  adj_deltas = [(0, 1), (0, -1), (1, 0), (-1, 0)]  # (dx, dy) for Down, Up, Right, Left moves\n\n  for px, py in primitive_locations:\n    for dx, dy in adj_deltas:\n      target_x, target_y = px + dx, py + dy\n      # Check if the potential target cell is within the grid boundaries\n      if 0 <= target_x < cols and 0 <= target_y < rows:\n        target_cells.add((target_x, target_y))\n\n  if not target_cells:\n    return []  # No valid target cells found (e.g., primitives on map edge with no interior adjacent cells)\n\n  # 5. Use Breadth-First Search (BFS) to find the shortest path to any target cell\n  q = collections.deque([(current_pos, [])])  # Queue stores (current_coords (x,y), list_of_actions_taken)\n  visited = {current_pos}  # Set of visited coordinates to prevent cycles and redundant paths\n  path_found = None\n\n  # Map (dx, dy) movements to corresponding action IDs\n  move_actions = {\n      (0, 1): _DOWN,\n      (0, -1): _UP,\n      (-1, 0): _LEFT,\n      (1, 0): _RIGHT\n  }\n\n  while q:\n    coords, actions = q.popleft()  # Get current coordinates and the path taken to reach them\n\n    if coords in target_cells:\n      path_found = actions  # A path to a target cell has been found\n      break  # Exit BFS, as we found the shortest path\n\n    # Explore neighboring cells\n    for dx, dy in move_actions.keys():\n      next_x, next_y = coords[0] + dx, coords[1] + dy\n      next_coords = (next_x, next_y)\n\n      # Check if the next cell is within grid boundaries and has not been visited\n      # Assuming all cells are traversable unless explicitly specified as obstacles\n      if 0 <= next_x < cols and 0 <= next_y < rows and next_coords not in visited:\n        visited.add(next_coords)\n        q.append((next_coords, actions + [move_actions[(dx, dy)]]))\n\n  if path_found is None:\n    return []  # No path could be found to any cell adjacent to a primitive\n\n  # 6. Append the USE action to the movement path and return the complete sequence\n  return path_found + [_USE]", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:58:53.351276", "function_name": "collect", "function_body": "    # Constants for actions as specified in the problem description\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    actions_to_take = []\n    \n    # Get the current state of the environment\n    current_state = env._current_state\n    grid = current_state.grid\n    \n    primitive_pos = None\n    # Iterate through the grid to find the position of the desired primitive\n    # grid.shape is (WIDTH, HEIGHT, n_kinds)\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            # Check if this cell contains the primitive kind\n            if grid[x, y, primitive] == 1:\n                primitive_pos = (x, y)\n                break\n        if primitive_pos:\n            break\n            \n    if primitive_pos is None:\n        # If the primitive is not found on the grid (e.g., already collected, or not present),\n        # return an empty list of actions.\n        return [] \n        \n    # Set a maximum number of navigation steps to prevent infinite loops,\n    # especially in complex or blocked scenarios where a direct path might not exist.\n    # This is a heuristic based on grid size.\n    max_navigation_steps = grid.shape[0] * grid.shape[1] * 2 \n    steps_taken = 0\n\n    # Navigate until the agent is next to the primitive\n    # The loop continues as long as the agent is not next to the primitive\n    # and has not exceeded the maximum allowed navigation steps.\n    while not env._current_state.next_to(primitive) and steps_taken < max_navigation_steps:\n        state = env._current_state # Get the most current state from the environment\n        current_pos = state.pos    # Agent's current (x, y) position\n        \n        ax, ay = current_pos\n        px, py = primitive_pos\n        \n        dx = px - ax\n        dy = py - ay\n        \n        action_to_move = None\n        \n        # Determine the next movement action using a greedy Manhattan-distance heuristic.\n        # Prioritize movement along the axis with the larger absolute difference.\n        if abs(dx) > abs(dy):\n            if dx > 0:\n                action_to_move = ACTION_RIGHT\n            else: # dx < 0\n                action_to_move = ACTION_LEFT\n        elif abs(dy) > 0: # This condition covers cases where abs(dy) >= abs(dx) or dx == 0\n            if dy > 0:\n                action_to_move = ACTION_DOWN\n            else: # dy < 0\n                action_to_move = ACTION_UP\n        else: # dx == 0 and dy == 0: Agent is on the same tile as the primitive.\n            # If the agent is on the same tile but `next_to` is still False,\n            # it might be an ungrabbable object or a scenario not allowing direct collection.\n            # In such cases, further movement won't help, so break the navigation loop.\n            break \n\n        if action_to_move is not None:\n            # Apply the chosen movement action to the environment.\n            # The return values (_reward, _done, _obs) are not used for this function's logic\n            # but are necessary to advance the environment state.\n            _reward, _done, _obs = env.step(action_to_move)\n            actions_to_take.append(action_to_move)\n            steps_taken += 1\n        else:\n            # This else block is a safeguard. It should typically not be reached if\n            # dx or dy were non-zero. If it is, it means no valid movement action\n            # was determined, likely implying a stuck state.\n            break \n            \n    # After navigation, attempt to collect the primitive using the USE action.\n    # This action is only appended if the agent successfully reached a position next to the primitive.\n    if env._current_state.next_to(primitive):\n        _reward, _done, _obs = env.step(ACTION_USE)\n        actions_to_take.append(ACTION_USE)\n    \n    return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T03:00:17.810100", "function_name": "collect", "function_body": "    # Action constants\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Direction constants (matching typical 0=N, 1=E, 2=S, 3=W)\n    DIR_NORTH = 0\n    DIR_EAST = 1\n    DIR_SOUTH = 2\n    DIR_WEST = 3\n\n    # Mapping from action to (dr, dc) delta and new direction\n    # This assumes that movement actions also set the agent's direction.\n    ACTION_TO_STATE_CHANGE = {\n        ACTION_UP:    ((-1, 0), DIR_NORTH),\n        ACTION_DOWN:  ((1, 0), DIR_SOUTH),\n        ACTION_LEFT:  ((0, -1), DIR_WEST),\n        ACTION_RIGHT: ((0, 1), DIR_EAST),\n    }\n\n    # Mapping from direction to (dr, dc) delta for checking cell in front\n    DIR_TO_DELTAS = {\n        DIR_NORTH: (-1, 0),\n        DIR_EAST:  (0, 1),\n        DIR_SOUTH: (1, 0),\n        DIR_WEST:  (0, -1),\n    }\n\n    # Helper function for boundary checks\n    def _is_valid_pos(pos, grid_shape):\n        r, c = pos\n        height, width, _ = grid_shape\n        return 0 <= r < height and 0 <= c < width\n\n    # Helper function to get the cell directly in front of the agent\n    def _get_cell_in_front(pos, direction):\n        dr, dc = DIR_TO_DELTAS[direction]\n        return (pos[0] + dr, pos[1] + dc)\n\n    # Get the current state from the environment\n    current_state = env._current_state\n    \n    # Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions\n    grid_shape = current_state.grid.shape\n\n    # Determine if primitive is grabbable (collect by walking over) or non-grabbable (requires USE action)\n    is_grabbable = primitive in env.world.grabbable_indices\n    \n    # Identify impassable cells: any non-grabbable entity other than the primitive itself.\n    # We assume entities in env.world.non_grabbable_indices typically block movement.\n    impassable_kinds = set(env.world.non_grabbable_indices) - {primitive}\n    \n    # Helper function to check if a cell is an obstacle\n    def is_obstacle(r, c, grid):\n        # Out of bounds is an obstacle\n        if not _is_valid_pos((r, c), grid_shape):\n            return True \n        \n        # Check if cell contains any of the defined impassable kinds\n        for kind_idx in impassable_kinds:\n            if grid[r, c, kind_idx] > 0:\n                return True\n        return False\n\n    # BFS Initialization\n    queue = collections.deque()\n    # State in queue: ( (row, col), current_direction, list_of_actions_taken )\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir \n    queue.append((initial_pos, initial_dir, []))\n\n    # Visited set: ( (row, col), current_direction ) to avoid redundant exploration and cycles\n    visited = set([(initial_pos, initial_dir)])\n\n    # Perform BFS\n    while queue:\n        (r, c), current_dir, path = queue.popleft()\n\n        # Check if the goal is met from the current position/direction\n        if is_grabbable:\n            # For grabbable items, the goal is to reach the cell containing the primitive.\n            # The item is collected implicitly by entering the cell.\n            if current_state.grid[r, c, primitive] > 0:\n                 return path # Path found to collect the item\n        else: # Non-grabbable, requires ACTION_USE\n            # Check the cell directly in front of the agent\n            front_r, front_c = _get_cell_in_front((r, c), current_dir)\n            if _is_valid_pos((front_r, front_c), grid_shape) and \\\n               current_state.grid[front_r, front_c, primitive] > 0:\n                return path + [ACTION_USE] # Path found, append USE action\n\n        # Explore possible next states (movement actions)\n        for action, ((dr, dc), new_dir) in ACTION_TO_STATE_CHANGE.items():\n            new_r, new_c = r + dr, c + dc\n            new_pos = (new_r, new_c)\n\n            # Check if the new position is valid and not an obstacle\n            if _is_valid_pos(new_pos, grid_shape) and not is_obstacle(new_r, new_c, current_state.grid):\n                # If this state (position and direction) hasn't been visited yet\n                if (new_pos, new_dir) not in visited:\n                    visited.add((new_pos, new_dir))\n                    queue.append((new_pos, new_dir, path + [action]))\n    \n    # If the queue becomes empty and no path was found\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T03:00:17.880424", "function_name": "collect", "function_body": "    import collections\n\n    # Constants for actions - these are defined by the CraftLab interface\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Movement deltas corresponding to the cardinal actions (dx, dy)\n    # These are used for agent movement on the grid.\n    MOVE_DELTAS = {\n        ACTION_UP: (0, -1),\n        ACTION_DOWN: (0, 1),\n        ACTION_LEFT: (-1, 0),\n        ACTION_RIGHT: (1, 0),\n    }\n\n\n    # Get the current state information from the environment\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    current_grid = features_dict['features_global']\n    current_pos = tuple(features_dict['pos'].astype(int)) # Ensure (x, y) as int tuple\n    current_inventory = features_dict['inventory']\n    \n    # Get grid dimensions\n    width, height, n_kinds = current_grid.shape\n\n    # Helper function to check if coordinates are within grid boundaries\n    def is_valid_coord(pos):\n        x, y = pos\n        return 0 <= x < width and 0 <= y < height\n\n    # 1. Check if the primitive is already in the agent's inventory\n    if current_inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # 2. Find all locations on the grid where the primitive exists\n    primitive_locations = []\n    for x in range(width):\n        for y in range(height):\n            if current_grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the map, cannot collect\n\n    # 3. Perform a Breadth-First Search (BFS) to find the shortest path\n    #    to a cell from which the 'USE' action can be successfully performed.\n    #    According to CraftState.next_to, 'USE' works if the primitive is in the\n    #    3x3 neighborhood around the agent's position (including the agent's cell itself).\n    \n    q = collections.deque()\n    # Queue stores (current_position, list_of_actions_taken_to_reach_this_position)\n    q.append((current_pos, []))\n    \n    visited = {current_pos} # Set of visited positions to avoid cycles and redundant checks\n\n    # The goal of BFS is to reach *any* cell (tx, ty) such that (tx, ty) is \n    # within 1 unit (8-directional) of *any* primitive_location (px, py).\n    # This covers the 3x3 neighborhood rule.\n    \n    while q:\n        (x, y), path_actions = q.popleft()\n\n        # Check if the current position (x,y) is a valid \"use\" location for any primitive instance.\n        # This means checking if any primitive_location is within 1 unit (including diagonals)\n        # of the agent's current (x,y) position.\n        \n        is_use_location = False\n        for px, py in primitive_locations:\n            if abs(x - px) <= 1 and abs(y - py) <= 1:\n                is_use_location = True\n                break\n        \n        if is_use_location:\n            # Found the shortest path to a position from which 'USE' will work.\n            return path_actions + [ACTION_USE] # Append USE action and return the full plan\n\n        # Explore neighbors (agent can move in 4 cardinal directions)\n        for action, (dx, dy) in MOVE_DELTAS.items():\n            next_pos = (x + dx, y + dy)\n            \n            # Check if the next position is within bounds and has not been visited\n            if is_valid_coord(next_pos) and next_pos not in visited:\n                # Add to visited set and queue for further exploration\n                visited.add(next_pos)\n                q.append((next_pos, path_actions + [action]))\n    \n    # If the queue becomes empty and no primitive was found to be reachable, return empty list.\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T03:01:49.112834", "function_name": "collect", "function_body": "  import collections\n\n  initial_state = env._current_state\n  initial_grid = initial_state.grid\n  WIDTH, HEIGHT, _ = initial_grid.shape # Grid shape (width, height, n_kinds)\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Get initial direction from the current state\n\n  # Define actions and their (dx, dy) deltas.\n  # These map to the integer values returned by CraftLab.action_specs().\n  _DOWN_ACTION = 0\n  _UP_ACTION = 1\n  _LEFT_ACTION = 2\n  _RIGHT_ACTION = 3\n  _USE_ACTION = 4 # The USE action\n\n  # Map movement actions to the (dx, dy) deltas for position change.\n  _ACTION_DELTAS = {\n      _UP_ACTION: (0, -1),   # Move up (decrease y)\n      _DOWN_ACTION: (0, 1),    # Move down (increase y)\n      _LEFT_ACTION: (-1, 0),  # Move left (decrease x)\n      _RIGHT_ACTION: (1, 0),   # Move right (increase x)\n  }\n\n  # Map movement actions to the direction the agent will face after the move.\n  # CraftState directions are: 0 (North/Up), 1 (South/Down), 2 (West/Left), 3 (East/Right).\n  _ACTION_TO_NEW_DIR = {\n      _UP_ACTION: 0,   # Agent faces North (0) after moving UP\n      _DOWN_ACTION: 1,    # Agent faces South (1) after moving DOWN\n      _LEFT_ACTION: 2,  # Agent faces West (2) after moving LEFT\n      _RIGHT_ACTION: 3,   # Agent faces East (3) after moving RIGHT\n  }\n\n  # Map directions to their (dx, dy) deltas relative to the agent's current position.\n  # This defines where the agent is \"looking\" if it's facing this direction.\n  # Used for checking the cell targeted by _USE_ACTION.\n  _DIR_TO_DELTA = {\n      0: (0, -1),  # North (Up)\n      1: (0, 1),   # South (Down)\n      2: (-1, 0),  # West (Left)\n      3: (1, 0),   # East (Right)\n  }\n\n  is_grabbable = primitive in env.world.grabbable_indices\n  is_stone = primitive == env.world.stone_index\n  is_water = primitive == env.world.water_index\n\n  # This function aims to collect a primitive.\n  # If it's not grabbable, and not a 'use'-able environmental primitive (like stone or water),\n  # then this function cannot collect it directly.\n  if not is_grabbable and not is_stone and not is_water:\n      return []\n\n  # BFS Queue: stores (current_x, current_y, current_direction, path_actions_list)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to prevent cycles and redundant explorations.\n  # Includes direction in the state to account for different paths that lead\n  # to the same (x,y) but with different orientations, crucial for _USE_ACTION.\n  visited = set([(start_x, start_y, start_dir)])\n\n  # BFS loop\n  while queue:\n      curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n      # --- Check if the current state satisfies the collection condition ---\n      if is_grabbable:\n          # For grabbable items, the target is to be on the same cell as the item.\n          # Direction does not matter for grabbable items (they are picked up on entry).\n          if initial_grid[curr_x, curr_y, primitive] > 0:\n              return path_actions # Path to reach and collect the grabbable item\n      elif is_stone or is_water:\n          # For items requiring _USE_ACTION (like stone or water),\n          # the agent must be adjacent to the item AND facing it.\n          # Determine the coordinates of the cell directly in front of the agent based on curr_dir.\n          tdx, tdy = _DIR_TO_DELTA[curr_dir]\n          tx, ty = curr_x + tdx, curr_y + tdy\n\n          # Check boundary for the cell directly in front of the agent\n          if 0 <= tx < WIDTH and 0 <= ty < HEIGHT:\n              # Check if the cell directly in front contains the primitive\n              if initial_grid[tx, ty, primitive] > 0:\n                  # If it does, and the agent is facing it, we can USE it.\n                  return path_actions + [_USE_ACTION] # Path to position + USE action\n      # --- End of collection condition check ---\n\n      # Explore neighbors for movement actions (UP, DOWN, LEFT, RIGHT)\n      for action_val, (dx, dy) in _ACTION_DELTAS.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_dir = _ACTION_TO_NEW_DIR[action_val] # Agent's new direction after this move\n\n          # Check boundaries: ensure the next position is within the grid.\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check if the next cell is blocked by impassable terrain.\n          # A cell is considered blocked if it contains any non-grabbable item\n          # that is not a workshop and not water (as workshops and water are typically traversable).\n          is_blocked_by_impassable = False\n          for k_idx in env.world.non_grabbable_indices:\n              if initial_grid[next_x, next_y, k_idx] > 0:\n                  # Allow movement onto workshops and water, even if non-grabbable.\n                  if k_idx not in env.world.workshop_indices and k_idx != env.world.water_index:\n                      is_blocked_by_impassable = True\n                      break\n          if is_blocked_by_impassable:\n              continue # This cell is blocked, don't move here\n\n          # If the cell is not blocked and this specific (position, direction) state\n          # has not been visited yet, add it to the queue.\n          if (next_x, next_y, next_dir) not in visited:\n              visited.add((next_x, next_y, next_dir))\n              new_path_actions = path_actions + [action_val]\n              queue.append((next_x, next_y, next_dir, new_path_actions))\n\n  # If no path to collect the primitive is found after exploring all reachable states, return an empty list.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T03:01:50.098044", "function_name": "collect", "function_body": "  initial_state = env._current_state\n  initial_grid = initial_state.grid\n  WIDTH, HEIGHT, _ = initial_grid.shape # Grid shape (width, height, n_kinds)\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Get initial direction from the current state\n\n  # Define actions and their (dx, dy) deltas.\n  # These map to the integer values returned by CraftLab.action_specs().\n  _DOWN_ACTION = 0\n  _UP_ACTION = 1\n  _LEFT_ACTION = 2\n  _RIGHT_ACTION = 3\n  _USE_ACTION = 4 # The USE action\n\n  # Map movement actions to the (dx, dy) deltas for position change.\n  _ACTION_DELTAS = {\n      _UP_ACTION: (0, -1),   # Move up (decrease y)\n      _DOWN_ACTION: (0, 1),    # Move down (increase y)\n      _LEFT_ACTION: (-1, 0),  # Move left (decrease x)\n      _RIGHT_ACTION: (1, 0),   # Move right (increase x)\n  }\n\n  # Map movement actions to the direction the agent will face after the move.\n  # CraftState directions are: 0 (North/Up), 1 (South/Down), 2 (West/Left), 3 (East/Right).\n  _ACTION_TO_NEW_DIR = {\n      _UP_ACTION: 0,   # Agent faces North (0) after moving UP\n      _DOWN_ACTION: 1,    # Agent faces South (1) after moving DOWN\n      _LEFT_ACTION: 2,  # Agent faces West (2) after moving LEFT\n      _RIGHT_ACTION: 3,   # Agent faces East (3) after moving RIGHT\n  }\n\n  # Map directions to their (dx, dy) deltas relative to the agent's current position.\n  # Used for checking the cell targeted by _USE_ACTION.\n  _DIR_TO_DELTA = {\n      0: (0, -1),  # North (Up)\n      1: (0, 1),   # South (Down)\n      2: (-1, 0),  # West (Left)\n      3: (1, 0),   # East (Right)\n  }\n\n  is_grabbable = primitive in env.world.grabbable_indices\n  # An item is \"use-able\" if it's in the environment (on the grid) but not grabbable.\n  # This generalizes the `is_stone or is_water` check of collect_v0.\n  is_use_able_environmental = (primitive in env.world.environment and\n                               not is_grabbable)\n\n  # If the primitive is neither directly grabbable nor a use-able environmental entity,\n  # this function cannot collect it directly.\n  if not is_grabbable and not is_use_able_environmental:\n      return []\n\n  # BFS Queue: stores (current_x, current_y, current_direction, path_actions_list)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to prevent cycles and redundant explorations.\n  # Includes direction in the state.\n  visited = set([(start_x, start_y, start_dir)])\n\n  # BFS loop\n  while queue:\n      curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n      # --- Check if the current state satisfies the collection condition ---\n      if is_grabbable:\n          # For grabbable items, the target is to be on the same cell as the item.\n          if initial_grid[curr_x, curr_y, primitive] > 0:\n              return path_actions # Path to reach and collect the grabbable item\n      elif is_use_able_environmental:\n          # For items requiring _USE_ACTION, the agent must be adjacent to the item AND facing it.\n          # Determine the coordinates of the cell directly in front of the agent based on curr_dir.\n          tdx, tdy = _DIR_TO_DELTA[curr_dir]\n          tx, ty = curr_x + tdx, curr_y + tdy\n\n          # Check boundary for the cell directly in front of the agent\n          if 0 <= tx < WIDTH and 0 <= ty < HEIGHT:\n              # Check if the cell directly in front contains the primitive (which is the use-able entity)\n              if initial_grid[tx, ty, primitive] > 0:\n                  # If it does, and the agent is facing it, we can USE it.\n                  return path_actions + [_USE_ACTION] # Path to position + USE action\n      # --- End of collection condition check ---\n\n      # Explore neighbors for movement actions (UP, DOWN, LEFT, RIGHT)\n      for action_val, (dx, dy) in _ACTION_DELTAS.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_dir = _ACTION_TO_NEW_DIR[action_val] # Agent's new direction after this move\n\n          # Check boundaries: ensure the next position is within the grid.\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check if the next cell is blocked by impassable terrain.\n          # A cell is considered blocked if it contains any non-grabbable item\n          # that is not a workshop and not water, and is not the primitive itself\n          # if that primitive is an environmental USE-able item.\n          is_blocked_by_impassable = False\n          for k_idx in env.world.non_grabbable_indices:\n              if initial_grid[next_x, next_y, k_idx] > 0:\n                  # Allow movement onto workshops and water (as in collect_v0).\n                  # Also, if the primitive itself is a USE-able environmental item,\n                  # and the agent is moving *onto* it, this path is not valid for USE collection,\n                  # but moving onto it should still be blocked if it's generally impassable.\n                  # The check for USE-able items is for ADJACENT cells, not the current one.\n                  # So, the original impassable logic is fine for movement.\n                  if k_idx not in env.world.workshop_indices and k_idx != env.world.water_index:\n                      is_blocked_by_impassable = True\n                      break\n          if is_blocked_by_impassable:\n              continue # This cell is blocked, don't move here\n\n          # If the cell is not blocked and this specific (position, direction) state\n          # has not been visited yet, add it to the queue.\n          if (next_x, next_y, next_dir) not in visited:\n              visited.add((next_x, next_y, next_dir))\n              new_path_actions = path_actions + [action_val]\n              queue.append((next_x, next_y, next_dir, new_path_actions))\n\n  # If no path to collect the primitive is found after exploring all reachable states, return an empty list.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T03:02:47.252047", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-31T03:02:48.232600", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  # Define action constants explicitly, as they are used internally and\n  # are common in CraftWorld environments.\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent facing directions (consistent with CraftState.dir mapping)\n  DIR_NORTH = 0 # Agent facing UP\n  DIR_EAST = 1  # Agent facing RIGHT\n  DIR_SOUTH = 2 # Agent facing DOWN\n  DIR_WEST = 3  # Agent facing LEFT\n\n  # Maximum total actions allowed for collection, including movements and the final USE.\n  # This can prevent excessively long searches and protect against infinite loops in complex maps.\n  MAX_COLLECT_STEPS = 100 \n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"Returns the coordinates (y, x) of the cell directly in front of the agent.\"\"\"\n      if direction == DIR_NORTH:\n          return y - 1, x\n      elif direction == DIR_EAST:\n          return y, x + 1\n      elif direction == DIR_SOUTH:\n          return y + 1, x\n      elif direction == DIR_WEST:\n          return y, x - 1\n      return y, x # Fallback, though should not be reached with valid directions\n\n  actions_taken = []\n  \n  # Reset the environment to ensure a fresh start for pathfinding.\n  # This also initializes `env._current_state` with the scenario's initial setup.\n  env.reset() \n  current_state = env._current_state \n\n  # Pre-check: Verify the primitive index is known to the world.\n  if primitive not in current_state.world.cookbook.kinds:\n      return [] # Unknown primitive, cannot collect.\n\n  # Pre-check: If the primitive is already in the inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Get initial grid state and agent's position/direction for BFS.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir \n\n  # Define which entity kinds are impassable for agent movement.\n  # Start with all non-grabbable entities.\n  impassable_for_movement = set(current_state.world.non_grabbable_indices)\n  \n  # Workshops are typically non-grabbable but traversable for movement.\n  impassable_for_movement.difference_update(current_state.world.workshop_indices)\n  \n  # Water is typically an impassable entity for movement.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n\n  # Convert the set of impassable kinds to a list for efficient NumPy indexing.\n  impassable_kinds_list = list(impassable_for_movement)\n  \n  # Map movement actions to their (resulting_direction, dy, dx) changes.\n  # This is crucial for BFS to track agent orientation after a move.\n  movement_actions_map = {\n      ACTION_UP:    (DIR_NORTH, -1, 0), # Move North (y-1), agent faces North (dir=0)\n      ACTION_RIGHT: (DIR_EAST,  0, 1),  # Move East (x+1), agent faces East (dir=1)\n      ACTION_DOWN:  (DIR_SOUTH, 1, 0),  # Move South (y+1), agent faces South (dir=2)\n      ACTION_LEFT:  (DIR_WEST,  0, -1)  # Move West (x-1), agent faces West (dir=3)\n  }\n\n  q = collections.deque()\n  # BFS state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  q.append((start_y, start_x, start_dir, []))\n  \n  # Visited set: Tracks (y, x, dir) states to prevent cycles and redundant exploration.\n  visited = {(start_y, start_x, start_dir)} \n\n  path_to_use = None # This will store the full sequence of actions (moves + final USE).\n\n  # --- Breadth-First Search to find the shortest path to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Pruning: If the current path is already too long to allow for the final ACTION_USE,\n      # or if it hits the general step limit, discard it.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # Check if the primitive is directly in front of the agent at the current (position, direction).\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_dir)\n\n      # Ensure the facing coordinates are within grid boundaries.\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width):\n          # Check if the cell directly in front contains the primitive.\n          if full_grid[facing_y, facing_x, primitive] > 0:\n              # Found a path where the agent can collect the primitive.\n              # If there's still room for the ACTION_USE within MAX_COLLECT_STEPS,\n              # this is a valid solution.\n              if len(path) < MAX_COLLECT_STEPS:\n                  path_to_use = path + [ACTION_USE]\n                  break # Shortest path found, exit BFS.\n              # Else, current path is too long to append ACTION_USE, continue search.\n      \n      # Explore neighboring cells by applying movement actions.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Check if the proposed next agent position is within grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable (does not contain impassable kinds).\n          is_traversable = True\n          # Only perform numpy check if there are actual impassable kinds defined.\n          if impassable_kinds_list: \n              if np.any(full_grid[next_y, next_x, impassable_kinds_list] > 0):\n                  is_traversable = False\n          \n          if not is_traversable:\n              continue\n          \n          # Check if this (position, direction) state has already been visited.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # Add the new state to the queue and visited set.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n  \n  # --- Execute the found path in the environment (if any) ---\n  if path_to_use is None:\n      return [] # No valid path found to collect the primitive within the constraints.\n\n  for action in path_to_use:\n      # Before executing an action, check if the environment's internal step counter\n      # has reached its maximum, which would terminate the episode.\n      if env.steps >= env.max_steps: \n          break # Cannot perform more actions, path terminated prematurely.\n\n      actions_taken.append(action)\n      \n      # Execute the action in the environment.\n      reward, done, _ = env.step(action) \n      current_state = env._current_state # Update internal state reference.\n\n      # If the primitive is now in the inventory, we have successfully collected it.\n      # Return the sequence of actions taken.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n      \n      # If the environment becomes 'done' for any reason (e.g., reaching a terminal state\n      # or a specific failure condition) and the goal isn't met, the collection failed.\n      if done: \n          return [] \n  \n  # After attempting all actions in `path_to_use`:\n  # Check if the primitive was ultimately collected.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken # Successfully collected.\n  else:\n      return [] # Collection failed (e.g., max steps hit mid-path, or USE failed).", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T03:04:11.913350", "function_name": "collect", "function_body": "    # Action constants as per CraftLab.action_specs\n    # These are integers representing actions\n    DOWN_ACTION = 0\n    UP_ACTION = 1\n    LEFT_ACTION = 2\n    RIGHT_ACTION = 3\n    USE_ACTION = 4\n\n    current_state = env._current_state\n    world = env.world\n\n    # If the primitive is already in the inventory, no actions are needed.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    WIDTH, HEIGHT, _ = grid.shape\n    start_pos = current_state.pos\n\n    # Determine walkable cells on the grid.\n    # A cell is considered an obstacle if it contains any non-grabbable item (e.g., environment features, workshops).\n    is_obstacle_cell = np.zeros(grid.shape[:2], dtype=bool)\n    if world.non_grabbable_indices:\n        for k_idx in list(world.non_grabbable_indices):\n            # Ensure the kind index `k_idx` is valid for the current grid's n_kinds dimension\n            if k_idx < grid.shape[2]:\n                is_obstacle_cell |= (grid[:, :, k_idx] > 0)\n    walkable_grid = ~is_obstacle_cell # Invert to get walkable areas\n\n    # Check if the primitive exists anywhere on the grid. If not, return an empty list.\n    if not np.any(grid[:, :, primitive] > 0):\n        return []\n\n    # BFS for pathfinding to the primitive.\n    # The queue stores tuples of ((current_x, current_y), path_to_reach_here).\n    # Using a list as a queue (queue.pop(0)) as `collections.deque` cannot be imported here.\n    queue = [(start_pos, [])]\n    visited = {start_pos}\n\n    # Define possible movements and their corresponding actions.\n    # (dx, dy) represents change in (x, y) coordinates.\n    movements = [\n        ((0, 1), DOWN_ACTION),  # Move DOWN (increase Y)\n        ((0, -1), UP_ACTION),   # Move UP (decrease Y)\n        ((1, 0), RIGHT_ACTION), # Move RIGHT (increase X)\n        ((-1, 0), LEFT_ACTION)  # Move LEFT (decrease X)\n    ]\n\n    while queue:\n        (curr_x, curr_y), path_so_far = queue.pop(0) # Get the first element (BFS behavior)\n\n        # If the current position contains the primitive, we have found our target.\n        # According to CraftState's `next_to` definition, the agent being on the same cell\n        # as a grabbable primitive counts as being in its 3x3 neighborhood.\n        if grid[curr_x, curr_y, primitive] > 0:\n            return path_so_far + [USE_ACTION] # Append USE action to the path and return\n\n        # Explore neighbors\n        for (dx, dy), action in movements:\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_pos = (next_x, next_y)\n\n            # Check if the next position is within grid boundaries.\n            if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                continue\n\n            # Check if the next position is walkable and has not been visited yet.\n            if walkable_grid[next_x, next_y] and next_pos not in visited:\n                visited.add(next_pos) # Mark as visited\n                # Add the next position and its path to the queue\n                queue.append((next_pos, path_so_far + [action]))\n\n    # If the queue becomes empty and no path was found to the primitive, return an empty list.\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T03:04:11.984868", "function_name": "collect", "function_body": "    from collections import deque\n\n    # Define actions based on CraftLab.action_specs()\n    # These are fixed integers as per problem description.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Direction deltas for grid movement (dx, dy)\n    DELTAS = {\n        ACTION_UP: (0, -1),\n        ACTION_DOWN: (0, 1),\n        ACTION_LEFT: (-1, 0),\n        ACTION_RIGHT: (1, 0),\n    }\n\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    current_pos_normalized = obs['features_dict']['pos']\n    inventory = obs['features_dict']['inventory']\n\n    # 1. Check if the primitive is already in the agent's inventory.\n    if inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n\n    # Convert normalized agent position to grid coordinates\n    # Using round for robustness, assuming normalized positions might be floats\n    current_x = int(round(current_pos_normalized[0] * WIDTH))\n    current_y = int(round(current_pos_normalized[1] * HEIGHT))\n    start_pos = (current_x, current_y)\n\n    # Identify potential obstacle kinds: non-grabbable items excluding the target primitive itself.\n    # We exclude the primitive because the agent might need to move through a cell that *contains*\n    # the primitive if it's not the immediate target cell for collection.\n    non_grabbable_obstacles = set(env.world.non_grabbable_indices) - {primitive}\n\n    # BFS for pathfinding to a cell adjacent to the primitive\n    q = deque([(start_pos, [])])  # Queue stores (current_coords, list_of_actions_to_reach_here)\n    visited = {start_pos}         # Set of visited coordinates to prevent cycles\n\n    while q:\n        (cx, cy), path_so_far = q.popleft()\n\n        # Check if the current position (cx, cy) is adjacent to the primitive.\n        # This means one of its 4-directional neighbors contains the primitive.\n        is_adjacent_to_primitive = False\n        for dx_adj, dy_adj in DELTAS.values():\n            px_adj, py_adj = cx + dx_adj, cy + dy_adj\n            # Check bounds and if the neighbor cell contains the primitive\n            if 0 <= px_adj < WIDTH and 0 <= py_adj < HEIGHT and grid[px_adj, py_adj, primitive] > 0:\n                is_adjacent_to_primitive = True\n                break\n\n        if is_adjacent_to_primitive:\n            # Found a path to a cell from which the primitive can be collected.\n            final_actions = list(path_so_far)\n            # If the primitive is a grabbable item, append the USE action to collect it.\n            if primitive in env.world.grabbable_indices:\n                final_actions.append(ACTION_USE)\n            return final_actions\n\n        # Explore 4-directional neighbors\n        for action, (dx, dy) in DELTAS.items():\n            nx, ny = cx + dx, cy + dy\n\n            # Check if neighbor is within grid bounds and not already visited\n            if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT) or (nx, ny) in visited:\n                continue\n\n            # Check if the neighbor cell (nx, ny) is an obstacle\n            is_obstacle = False\n            for k_obstacle in non_grabbable_obstacles:\n                if grid[nx, ny, k_obstacle] > 0:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue  # Cannot move into this cell, it's an obstacle\n\n            # If the neighbor is traversable and not visited, add it to the queue\n            visited.add((nx, ny))\n            q.append(((nx, ny), path_so_far + [action]))\n\n    # If the primitive is unreachable or no path is found, return an empty list\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T03:05:32.742675", "function_name": "collect", "function_body": "  # Action mappings as per CraftLab.action_specs\n  # These constants are typically defined globally or within an action space definition.\n  # For this function, we define them here for clarity and self-containment.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Relative movement deltas for each action (row_change, col_change)\n  MOVE_DELTAS = {\n      UP: (-1, 0),    # Moving Up decreases row index\n      DOWN: (1, 0),   # Moving Down increases row index\n      LEFT: (0, -1),  # Moving Left decreases col index\n      RIGHT: (0, 1),  # Moving Right increases col index\n  }\n\n  # Access the current state from the CraftLab environment instance\n  current_state = env._current_state\n  current_pos = current_state.pos  # Agent's current (row, col)\n  grid = current_state.grid        # The full grid state (H, W, n_kinds)\n  inventory = current_state.inventory # Agent's current inventory\n\n  # Get grid dimensions\n  H, W, _ = grid.shape\n\n  # 1. Check if the primitive is already in the agent's inventory\n  if inventory[primitive] > 0:\n      return [] # Already collected, no actions needed\n\n  # 2. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to any cell containing the target primitive.\n  # Queue stores tuples: ((row, col), [list_of_actions_to_reach_here])\n  q = collections.deque([(current_pos, [])])\n  \n  # Set of (row, col) tuples already visited to prevent cycles and redundant exploration\n  visited = {current_pos}\n\n  target_path = None # To store the sequence of actions if a path is found\n\n  while q:\n      (r, c), path_actions = q.popleft()\n\n      # Check if the current cell contains the primitive\n      if grid[r, c, primitive] > 0:\n          target_path = path_actions\n          break # Found the primitive, shortest path guaranteed by BFS\n\n      # Explore neighboring cells (possible moves)\n      for action_type, (dr, dc) in MOVE_DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate new row and column\n\n          # Check if the new coordinates are within grid boundaries\n          # and if the cell has not been visited yet\n          if 0 <= nr < H and 0 <= nc < W and (nr, nc) not in visited:\n              # For simplicity, we assume movement is possible to any unvisited cell.\n              # In a more complex CraftWorld scenario, certain cells (e.g., walls, water)\n              # might be impassable without specific tools or actions.\n              # This implementation assumes basic grid traversal.\n              \n              new_path_actions = path_actions + [action_type]\n              q.append(((nr, nc), new_path_actions))\n              visited.add((nr, nc))\n\n  # 3. Construct the full action sequence\n  if target_path is not None:\n      # If a path was found, the agent moves to the cell containing the primitive.\n      # After reaching that cell, the 'USE' action is typically required to collect\n      # or interact with the item/resource.\n      return target_path + [USE]\n  else:\n      # The primitive was not found on the grid or is unreachable.\n      return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-31T03:05:33.714002", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Helper function to create a hashable key for a CraftState object.\n  # This is crucial for storing visited states in a set to prevent cycles and redundant exploration.\n  def get_state_key(state):\n      \"\"\"\n      Generates a hashable key for a CraftState instance.\n      Converts numpy arrays (grid, inventory) to bytes for hashing,\n      as numpy arrays are not hashable by default.\n      \"\"\"\n      return (state.pos, state.dir, state.inventory.tobytes(), state.grid.tobytes())\n\n\n  # Reset the environment to a fresh starting state for the search.\n  # This ensures the search begins from a known, consistent point.\n  initial_obs = env.reset()\n  initial_state = initial_obs['features_dict']['current_state']\n\n  # If the primitive is already present in the inventory at the start,\n  # no actions are needed, so return an empty list.\n  if initial_state.inventory[primitive] > 0:\n    return []\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element in the queue is a tuple: (CraftState instance, list of actions taken to reach this state).\n  q = collections.deque([(initial_state, [])])\n\n  # Initialize the set of visited states.\n  # We store the hashable keys of states to efficiently check if a state has been visited.\n  visited = {get_state_key(initial_state)}\n\n  # Start the BFS loop.\n  while q:\n    current_state, path = q.popleft()\n\n    # --- 1. Explore Movement Actions (DOWN, UP, LEFT, RIGHT) ---\n    # These actions change the agent's position and/or direction without affecting inventory or grid (initially).\n    move_actions = [env_factory.DOWN, env_factory.UP, env_factory.LEFT, env_factory.RIGHT]\n    for action in move_actions:\n      # CraftState.step returns a *new* CraftState object representing the state\n      # after applying the action. This is essential for BFS as it doesn't modify\n      # the 'current_state' object, allowing us to explore multiple paths.\n      _, next_state = current_state.step(action) # The first return value is reward (always 0.0 here)\n      next_state_key = get_state_key(next_state)\n\n      # If this 'next_state' has not been visited yet, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # --- 2. Explore USE Action ---\n    # The USE action is typically required to interact with objects in the environment,\n    # including picking up primitives. This action is only considered useful if the agent\n    # is next to the target primitive.\n    if current_state.next_to(primitive):\n      action = env_factory.USE\n      _, next_state_after_use = current_state.step(action)\n      \n      # Check if the USE action successfully collected the primitive.\n      # If the primitive count in the inventory increased, the goal is achieved.\n      if next_state_after_use.inventory[primitive] > 0:\n        return path + [action] # Goal achieved! Return the sequence of actions.\n\n      # Even if 'USE' didn't collect the target primitive (e.g., used on an irrelevant object),\n      # it might have changed the state in other ways. If this new state is unvisited,\n      # add it to the queue to explore further. This handles more complex scenarios\n      # where other interactions might be necessary or occur as a side-effect.\n      next_state_after_use_key = get_state_key(next_state_after_use)\n      if next_state_after_use_key not in visited:\n        visited.add(next_state_after_use_key)\n        q.append((next_state_after_use, path + [action]))\n\n  # If the BFS queue becomes empty and the goal (collecting the primitive)\n  # has not been reached, it means the primitive is unreachable or uncollectable\n  # from the initial state given the allowed actions.\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-31T03:07:05.113179", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action mappings for movement (dx, dy) where dx is change in x, dy is change in y\n    # The grid is typically indexed as [row, col] or [y, x].\n    # Agent's position is given as (x, y) or (col, row).\n    # So, grid access will be grid[y, x].\n    ACTION_MOVES = {\n        0: (0, 1),   # DOWN: (dx=0, dy=1) -> moves agent from (x,y) to (x, y+1)\n        1: (0, -1),  # UP:   (dx=0, dy=-1) -> moves agent from (x,y) to (x, y-1)\n        2: (-1, 0),  # LEFT: (dx=-1, dy=0) -> moves agent from (x,y) to (x-1, y)\n        3: (1, 0)    # RIGHT:(dx=1, dy=0) -> moves agent from (x,y) to (x+1, y)\n    }\n    USE_ACTION = 4\n\n    # Get current state information from the CraftLab environment\n    # We assume direct access to the internal _current_state for efficiency and clarity,\n    # as parsing and unnormalizing from observations could be complex without full spec.\n    current_state = env._current_state\n    grid = current_state.grid\n    current_pos = current_state.pos  # Agent's current position as (x, y) tuple\n\n    # Get grid dimensions (Height, Width, Kinds)\n    H, W, _ = grid.shape\n\n    # Identify indices of entities that are considered obstacles (non-grabbable environment items)\n    # The agent cannot move into cells occupied by these entities.\n    obstacle_indices = env.world.cookbook.environment\n\n    # Find all current locations of the target primitive on the grid\n    primitive_locs = []\n    for y_coord in range(H):\n        for x_coord in range(W):\n            # Check if the primitive (identified by its index) exists at this (x, y) location.\n            # A value > 0 typically indicates presence (e.g., in a one-hot or count-based layer).\n            if grid[y_coord, x_coord, primitive] > 0:\n                primitive_locs.append((x_coord, y_coord))\n\n    # If the primitive is not found anywhere on the grid, no actions can collect it.\n    if not primitive_locs:\n        return []\n\n    # Precompute a set of all valid grid cells that are adjacent to any primitive location.\n    # The agent needs to reach one of these cells to be able to 'USE' and collect the primitive.\n    target_adj_cells = set()\n    for px, py in primitive_locs:\n        for dx, dy in ACTION_MOVES.values(): # Check all 4 cardinal neighbors (UP, DOWN, LEFT, RIGHT)\n            nx, ny = px + dx, py + dy\n            \n            # Ensure the potential adjacent cell is within grid boundaries\n            if 0 <= nx < W and 0 <= ny < H:\n                # Check if this potential adjacent cell is an obstacle.\n                # If it's an obstacle, the agent cannot move to it.\n                is_obstacle = False\n                for k_idx in obstacle_indices:\n                    if grid[ny, nx, k_idx] > 0: # Grid is indexed as grid[y, x, kind]\n                        is_obstacle = True\n                        break\n                \n                # If the cell is traversable (not an obstacle), add it to our set of target adjacent cells.\n                if not is_obstacle:\n                    target_adj_cells.add((nx, ny))\n    \n    # If no traversable adjacent cells are found (e.g., all primitives are entirely surrounded by obstacles),\n    # then the primitive is unreachable.\n    if not target_adj_cells:\n        return []\n\n    # --- Breadth-First Search (BFS) to find the shortest path ---\n    # The queue stores tuples: (current_x, current_y, list_of_actions_to_reach_here)\n    q = collections.deque([(current_pos[0], current_pos[1], [])])\n    \n    # The visited set keeps track of (x, y) coordinates already explored to prevent cycles\n    # and ensure the shortest path is found.\n    visited = set([(current_pos[0], current_pos[1])])\n\n    while q:\n        x, y, path = q.popleft()\n\n        # Check if the current position (x, y) is one of our precomputed target adjacent cells.\n        # If it is, we have found a path to a location from which the primitive can be collected.\n        if (x, y) in target_adj_cells:\n            # Append the USE_ACTION to the path and return the complete sequence of actions.\n            return path + [USE_ACTION]\n\n        # Explore all possible movement actions from the current position.\n        for action_val, (dx, dy) in ACTION_MOVES.items():\n            nx, ny = x + dx, y + dy # Calculate the new potential position\n\n            # Check if the new position is within the valid bounds of the grid.\n            if 0 <= nx < W and 0 <= ny < H:\n                # Check if the new position is occupied by an obstacle.\n                is_obstacle = False\n                for k_idx in obstacle_indices:\n                    if grid[ny, nx, k_idx] > 0: # Grid is indexed as grid[y, x, kind]\n                        is_obstacle = True\n                        break\n                \n                # If the new position is not an obstacle and has not been visited yet,\n                # add it to the queue for further exploration.\n                if not is_obstacle and (nx, ny) not in visited:\n                    visited.add((nx, ny))\n                    q.append((nx, ny, path + [action_val]))\n\n    # If the BFS queue becomes empty and no path to a target adjacent cell was found,\n    # it means the primitive is unreachable from the current agent position.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T03:07:06.144061", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from CraftLab.action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map (dy, dx) offsets to actions for path reconstruction\n  INV_MOVEMENT_ACTIONS = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  # Movement offsets for neighbors in BFS (dy, dx)\n  MOVEMENT_OFFSETS = [\n      (-1, 0),  # UP\n      (1, 0),   # DOWN\n      (0, -1),  # LEFT\n      (0, 1),   # RIGHT\n  ]\n\n  # Get current state information from the environment\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  current_grid = features_dict['features_global']\n  # current_pos is a numpy array, convert to tuple for hashing in sets/dicts\n  current_pos = tuple(features_dict['pos'])\n  current_inventory = features_dict['inventory']\n\n  # Check if the primitive is already collected\n  if current_inventory[primitive] > 0:\n      return []\n\n  grid_height, grid_width, n_kinds = current_grid.shape\n\n  # Retrieve non-grabbable indices from the world configuration\n  # These entities are assumed to be impassable obstacles.\n  impassable_indices = env.world.non_grabbable_indices\n\n  # BFS to find the shortest path to a position adjacent to the primitive\n  # Queue stores (current_position, path_taken_so_far_as_actions)\n  q = collections.deque([(current_pos, [])])\n  visited = {current_pos}  # Set of visited (y, x) tuples to avoid cycles\n\n  best_actions = []\n\n  while q:\n      (y, x), path = q.popleft()\n\n      # Check if the current position is \"next to\" (adjacent to) the primitive.\n      # A 3x3 neighborhood is checked by CraftState.next_to.\n      found_primitive_nearby = False\n      for dy_adj in [-1, 0, 1]:\n          for dx_adj in [-1, 0, 1]:\n              # Exclude the current cell itself, as \"next to\" implies a different cell.\n              if dy_adj == 0 and dx_adj == 0:\n                  continue\n              \n              ny_adj, nx_adj = y + dy_adj, x + dx_adj\n              \n              # Check bounds for the adjacent cell\n              if 0 <= ny_adj < grid_height and 0 <= nx_adj < grid_width:\n                  # Check if the primitive is present in this adjacent cell\n                  if current_grid[ny_adj, nx_adj, primitive] == 1:\n                      found_primitive_nearby = True\n                      break\n          if found_primitive_nearby:\n              break\n\n      if found_primitive_nearby:\n          # If a primitive is found in the neighborhood, add a USE action and return the path\n          best_actions = path + [USE]\n          break # Found the shortest path to a suitable position\n\n      # Explore valid neighboring cells for movement\n      for dy, dx in MOVEMENT_OFFSETS:\n          ny, nx = y + dy, x + dx\n          next_pos = (ny, nx)\n\n          # Check bounds and if the cell has already been visited in this BFS\n          if 0 <= ny < grid_height and 0 <= nx < grid_width and next_pos not in visited:\n              \n              # Check if the next cell is walkable (i.e., does not contain impassable objects)\n              is_walkable = True\n              for k_idx in impassable_indices:\n                  if current_grid[ny, nx, k_idx] == 1:\n                      is_walkable = False\n                      break\n              \n              if is_walkable:\n                  visited.add(next_pos)\n                  action_to_reach = INV_MOVEMENT_ACTIONS[(dy, dx)]\n                  q.append((next_pos, path + [action_to_reach]))\n\n  return best_actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T03:08:34.520380", "function_name": "collect", "function_body": "  initial_state = env._current_state\n\n  # Check if primitive is already in inventory\n  if initial_state.inventory[primitive] > 0:\n    return []\n\n  # Get action mappings from the environment\n  action_specs = env.action_specs()\n  UP_ACTION = action_specs['UP']\n  DOWN_ACTION = action_specs['DOWN']\n  LEFT_ACTION = action_specs['LEFT']\n  RIGHT_ACTION = action_specs['RIGHT']\n  USE_ACTION = action_specs['USE']\n\n  # Mapping of (dr, dc) to the action that causes that movement\n  action_dir_map = {\n      (-1, 0): UP_ACTION,    # Move North\n      (1, 0): DOWN_ACTION,   # Move South\n      (0, -1): LEFT_ACTION,  # Move West\n      (0, 1): RIGHT_ACTION,  # Move East\n  }\n\n  # Find primitive's location on the initial grid\n  primitive_pos = None\n  grid = initial_state.grid\n  # Grid shape is (WIDTH, HEIGHT, n_kinds)\n  width, height, _ = grid.shape \n\n  for r in range(width):\n    for c in range(height):\n      if grid[r, c, primitive] == 1:\n        primitive_pos = (r, c)\n        break\n    if primitive_pos:\n      break\n\n  if not primitive_pos:\n    # Primitive not found on the map initially. Cannot collect.\n    return []\n\n  # Perform BFS to find the shortest path to the primitive's location\n  from collections import deque\n\n  # Queue stores (current_position, path_of_actions_to_reach_here)\n  q = deque([(initial_state.pos, [])])\n  # Visited set stores positions already explored to avoid cycles and redundant paths\n  visited = {initial_state.pos}\n\n  final_path_to_primitive = None\n\n  while q:\n    current_pos, current_path = q.popleft()\n\n    # If we reached the primitive's position, we found a path\n    if current_pos == primitive_pos:\n      final_path_to_primitive = current_path\n      break\n\n    # Explore neighbors (up, down, left, right)\n    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      next_r, next_c = current_pos[0] + dr, current_pos[1] + dc\n      next_pos = (next_r, next_c)\n\n      # Check bounds: ensure next position is within the grid\n      if 0 <= next_r < width and 0 <= next_c < height:\n        # Check if the next position has already been visited\n        if next_pos not in visited:\n          visited.add(next_pos)\n          action_to_take = action_dir_map[(dr, dc)]\n          q.append((next_pos, current_path + [action_to_take]))\n\n  # If a path to the primitive was found, append the USE action\n  if final_path_to_primitive is not None:\n    return final_path_to_primitive + [USE_ACTION]\n  else:\n    # Primitive is unreachable or no path found\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T03:08:34.589222", "function_name": "collect", "function_body": "    from collections import deque\n\n    # Get action mappings from the environment to ensure correct integer values for actions\n    action_specs = env.action_specs()\n    ACTION_DOWN = action_specs['DOWN']\n    ACTION_UP = action_specs['UP']\n    ACTION_LEFT = action_specs['LEFT']\n    ACTION_RIGHT = action_specs['RIGHT']\n    ACTION_USE = action_specs['USE']\n\n    # Reset the environment to its initial configuration to obtain a consistent starting state.\n    # This call also updates `env._current_state` with the initial `CraftState`.\n    _ = env.reset() \n\n    # Access the initial state details directly from the environment's internal state\n    current_state = env._current_state \n    initial_grid = current_state.grid \n    start_r, start_c = current_state.pos\n\n    # Get the dimensions of the grid\n    width, height, _ = initial_grid.shape\n\n    target_coord = None\n    # Search the initial grid for the specified primitive.\n    # The primitive is identified by its integer index.\n    for r in range(width):\n        for c in range(height):\n            # If the primitive is found at cell (r, c), mark it as the target.\n            if initial_grid[r, c, primitive] > 0:\n                target_coord = (r, c)\n                break  # Stop searching once the first instance is found\n        if target_coord:\n            break  # Stop outer loop if target found\n\n    # If the primitive was not found on the grid, it means it's either not present\n    # or is a craftable item (not directly grabbable from the map).\n    # In such cases, return an empty list of actions as direct collection is not possible.\n    if target_coord is None:\n        return []\n\n    # Initialize a queue for Breadth-First Search (BFS).\n    # Each item in the queue is (row, column, list_of_actions_to_reach_here).\n    q = deque([(start_r, start_c, [])])\n    # Keep track of visited cells to prevent infinite loops and redundant exploration.\n    visited = {(start_r, start_c)}\n    \n    found_path_actions = []\n\n    # Define possible movements (change in row, change in column) and their corresponding actions.\n    move_deltas = {\n        (1, 0): ACTION_DOWN,\n        (-1, 0): ACTION_UP,\n        (0, 1): ACTION_RIGHT,\n        (0, -1): ACTION_LEFT\n    }\n\n    # BFS loop to find the shortest path to the target primitive.\n    while q:\n        r, c, current_actions = q.popleft()\n\n        # If the current cell is the target cell, a path has been found.\n        if (r, c) == target_coord:\n            # Append the 'USE' action to the path. This assumes 'USE' collects the item\n            # when the agent is on the same square as the primitive.\n            found_path_actions = current_actions + [ACTION_USE]\n            break  # Exit BFS as the shortest path is found\n\n        # Explore all valid neighboring cells.\n        for dr, dc in move_deltas:\n            nr, nc = r + dr, c + dc  # Calculate neighbor coordinates\n\n            # Check if the neighbor is within grid boundaries and has not been visited.\n            # This simple BFS assumes all valid grid cells are traversable.\n            if 0 <= nr < width and 0 <= nc < height and (nr, nc) not in visited:\n                visited.add((nr, nc))  # Mark the neighbor as visited\n                # Add the neighbor to the queue with the updated list of actions taken to reach it.\n                q.append((nr, nc, current_actions + [move_deltas[(dr, dc)]]))\n    \n    # Return the sequence of actions to collect the primitive, or an empty list if no path was found.\n    return found_path_actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T03:09:37.833693", "function_name": "collect", "function_body": "  import collections\n\n  initial_state = env._current_state\n  initial_grid = initial_state.grid\n  WIDTH, HEIGHT, _ = initial_grid.shape # Grid shape (width, height, n_kinds)\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Get initial direction from the current state\n\n  # Define actions and their (dx, dy) deltas.\n  # These map to the integer values returned by CraftLab.action_specs().\n  _DOWN_ACTION = 0\n  _UP_ACTION = 1\n  _LEFT_ACTION = 2\n  _RIGHT_ACTION = 3\n  _USE_ACTION = 4 # The USE action\n\n  # Map movement actions to the (dx, dy) deltas for position change.\n  _ACTION_DELTAS = {\n      _UP_ACTION: (0, -1),   # Move up (decrease y)\n      _DOWN_ACTION: (0, 1),    # Move down (increase y)\n      _LEFT_ACTION: (-1, 0),  # Move left (decrease x)\n      _RIGHT_ACTION: (1, 0),   # Move right (increase x)\n  }\n\n  # Map movement actions to the direction the agent will face after the move.\n  # CraftState directions are: 0 (North/Up), 1 (South/Down), 2 (West/Left), 3 (East/Right).\n  _ACTION_TO_NEW_DIR = {\n      _UP_ACTION: 0,   # Agent faces North (0) after moving UP\n      _DOWN_ACTION: 1,    # Agent faces South (1) after moving DOWN\n      _LEFT_ACTION: 2,  # Agent faces West (2) after moving LEFT\n      _RIGHT_ACTION: 3,   # Agent faces East (3) after moving RIGHT\n  }\n\n  # Map directions to their (dx, dy) deltas relative to the agent's current position.\n  # This defines where the agent is \"looking\" if it's facing this direction.\n  # Used for checking the cell targeted by _USE_ACTION.\n  _DIR_TO_DELTA = {\n      0: (0, -1),  # North (Up)\n      1: (0, 1),   # South (Down)\n      2: (-1, 0),  # West (Left)\n      3: (1, 0),   # East (Right)\n  }\n\n  is_grabbable = primitive in env.world.grabbable_indices\n  is_stone = primitive == env.world.stone_index\n  is_water = primitive == env.world.water_index\n\n  # If the primitive is neither grabbable nor a 'use'-able environmental item (like stone or water),\n  # this function cannot collect it directly.\n  if not is_grabbable and not is_stone and not is_water:\n      return []\n\n  # Pre-calculate indices of impassable entities for movement.\n  # These are non-grabbable entities that are NOT workshops and NOT water,\n  # as workshops and water are typically traversable.\n  traversable_non_grabbable_set = set(env.world.workshop_indices)\n  traversable_non_grabbable_set.add(env.world.water_index)\n  impassable_indices = [\n      idx for idx in env.world.non_grabbable_indices\n      if idx not in traversable_non_grabbable_set\n  ]\n\n  # BFS Queue: stores (current_x, current_y, current_direction, path_actions_list)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to prevent cycles and redundant explorations.\n  # The state includes (x, y, direction) to account for paths reaching the same\n  # position but with different orientations.\n  visited = set([(start_x, start_y, start_dir)])\n\n  # BFS loop\n  while queue:\n      curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n      # --- Check if the current state satisfies the collection condition ---\n      if is_grabbable:\n          # For grabbable items, the agent must be on the same cell as the item.\n          if initial_grid[curr_x, curr_y, primitive] > 0:\n              return path_actions # Path to reach and collect the grabbable item\n      elif is_stone or is_water:\n          # For items requiring _USE_ACTION (like stone or water),\n          # the agent must be adjacent to the item AND facing it.\n          # Determine the coordinates of the cell directly in front of the agent.\n          tdx, tdy = _DIR_TO_DELTA[curr_dir]\n          tx, ty = curr_x + tdx, curr_y + tdy\n\n          # Check boundaries for the cell directly in front of the agent\n          if 0 <= tx < WIDTH and 0 <= ty < HEIGHT:\n              # Check if the cell directly in front contains the primitive\n              if initial_grid[tx, ty, primitive] > 0:\n                  # If it does, and the agent is facing it, we can USE it.\n                  return path_actions + [_USE_ACTION] # Path to position + USE action\n      # --- End of collection condition check ---\n\n      # Explore neighbors for movement actions (UP, DOWN, LEFT, RIGHT)\n      for action_val, (dx, dy) in _ACTION_DELTAS.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_dir = _ACTION_TO_NEW_DIR[action_val] # Agent's new direction after this move\n\n          # Check boundaries: ensure the next position is within the grid.\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check if the next cell is blocked by any impassable entities.\n          if any(initial_grid[next_x, next_y, k_idx] > 0 for k_idx in impassable_indices):\n              continue\n\n          # If the cell is not blocked and this specific (position, direction) state\n          # has not been visited yet, add it to the queue.\n          if (next_x, next_y, next_dir) not in visited:\n              visited.add((next_x, next_y, next_dir))\n              new_path_actions = path_actions + [action_val]\n              queue.append((next_x, next_y, next_dir, new_path_actions))\n\n  # If no path to collect the primitive is found after exploring all reachable states, return an empty list.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T03:09:38.848606", "function_name": "collect", "function_body": "  import collections\n\n  initial_state = env._current_state\n\n  # Improvement for collect_v2: Check if the primitive is already in the inventory.\n  # If so, no actions are needed to collect it.\n  if initial_state.inventory[primitive] > 0:\n      return []\n\n  initial_grid = initial_state.grid\n  WIDTH, HEIGHT, _ = initial_grid.shape # Grid shape (width, height, n_kinds)\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Get initial direction from the current state\n\n  # Define actions and their (dx, dy) deltas.\n  # These map to the integer values returned by CraftLab.action_specs().\n  _DOWN_ACTION = 0\n  _UP_ACTION = 1\n  _LEFT_ACTION = 2\n  _RIGHT_ACTION = 3\n  _USE_ACTION = 4 # The USE action\n\n  # Map movement actions to the (dx, dy) deltas for position change.\n  _ACTION_DELTAS = {\n      _UP_ACTION: (0, -1),   # Move up (decrease y)\n      _DOWN_ACTION: (0, 1),    # Move down (increase y)\n      _LEFT_ACTION: (-1, 0),  # Move left (decrease x)\n      _RIGHT_ACTION: (1, 0),   # Move right (increase x)\n  }\n\n  # Map movement actions to the direction the agent will face after the move.\n  # CraftState directions are: 0 (North/Up), 1 (South/Down), 2 (West/Left), 3 (East/Right).\n  _ACTION_TO_NEW_DIR = {\n      _UP_ACTION: 0,   # Agent faces North (0) after moving UP\n      _DOWN_ACTION: 1,    # Agent faces South (1) after moving DOWN\n      _LEFT_ACTION: 2,  # Agent faces West (2) after moving LEFT\n      _RIGHT_ACTION: 3,   # Agent faces East (3) after moving RIGHT\n  }\n\n  # Map directions to their (dx, dy) deltas relative to the agent's current position.\n  # This defines where the agent is \"looking\" if it's facing this direction.\n  # Used for checking the cell targeted by _USE_ACTION.\n  _DIR_TO_DELTA = {\n      0: (0, -1),  # North (Up)\n      1: (0, 1),   # South (Down)\n      2: (-1, 0),  # West (Left)\n      3: (1, 0),   # East (Right)\n  }\n\n  is_grabbable = primitive in env.world.grabbable_indices\n  is_stone = primitive == env.world.stone_index\n  is_water = primitive == env.world.water_index\n\n  # This function aims to collect a primitive.\n  # If it's not grabbable, and not a 'use'-able environmental primitive (like stone or water),\n  # then this function cannot collect it directly.\n  if not is_grabbable and not is_stone and not is_water:\n      return []\n\n  # BFS Queue: stores (current_x, current_y, current_direction, path_actions_list)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to prevent cycles and redundant explorations.\n  # Includes direction in the state to account for different paths that lead\n  # to the same (x,y) but with different orientations.\n  visited = set([(start_x, start_y, start_dir)])\n\n  # BFS loop\n  while queue:\n      curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n      # --- Check if the current state satisfies the collection condition ---\n      if is_grabbable:\n          # For grabbable items, the target is to be on the same cell as the item.\n          # Direction does not matter for grabbable items (they are picked up on entry).\n          if initial_grid[curr_x, curr_y, primitive] > 0:\n              return path_actions # Path to reach and collect the grabbable item\n      elif is_stone or is_water:\n          # For items requiring _USE_ACTION (like stone or water),\n          # the agent must be adjacent to the item AND facing it.\n          # Determine the coordinates of the cell directly in front of the agent based on curr_dir.\n          tdx, tdy = _DIR_TO_DELTA[curr_dir]\n          tx, ty = curr_x + tdx, curr_y + tdy\n\n          # Check boundary for the cell directly in front of the agent\n          if 0 <= tx < WIDTH and 0 <= ty < HEIGHT:\n              # Check if the cell directly in front contains the primitive\n              if initial_grid[tx, ty, primitive] > 0:\n                  # If it does, and the agent is facing it, we can USE it.\n                  return path_actions + [_USE_ACTION] # Path to position + USE action\n      # --- End of collection condition check ---\n\n      # Explore neighbors for movement actions (UP, DOWN, LEFT, RIGHT)\n      for action_val, (dx, dy) in _ACTION_DELTAS.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_dir = _ACTION_TO_NEW_DIR[action_val] # Agent's new direction after this move\n\n          # Check boundaries: ensure the next position is within the grid.\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check if the next cell is blocked by impassable terrain.\n          # A cell is considered blocked if it contains any non-grabbable item\n          # that is not a workshop and not water (as workshops and water are typically traversable).\n          is_blocked_by_impassable = False\n          for k_idx in env.world.non_grabbable_indices:\n              if initial_grid[next_x, next_y, k_idx] > 0:\n                  # Allow movement onto workshops and water, even if non-grabbable.\n                  if k_idx not in env.world.workshop_indices and k_idx != env.world.water_index:\n                      is_blocked_by_impassable = True\n                      break\n          if is_blocked_by_impassable:\n              continue # This cell is blocked, don't move here\n\n          # If the cell is not blocked and this specific (position, direction) state\n          # has not been visited yet, add it to the queue.\n          if (next_x, next_y, next_dir) not in visited:\n              visited.add((next_x, next_y, next_dir))\n              new_path_actions = path_actions + [action_val]\n              queue.append((next_x, next_y, next_dir, new_path_actions))\n\n  # If no path to collect the primitive is found after exploring all reachable states, return an empty list.\n  return []", "island_id": 7, "scores": {"3": -1}}
