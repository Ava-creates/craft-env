{"timestamp": "2025-07-30T12:19:12.260010", "function_name": "collect", "function_body": "    # Constants for directions (CraftState.dir values)\n    DIR_NORTH = 0\n    DIR_EAST = 1\n    DIR_SOUTH = 2\n    DIR_WEST = 3\n\n    # Map action to (dr, dc) movement\n    _ACTION_TO_DELTA = {\n        env_factory.ACTION_UP: (-1, 0),\n        env_factory.ACTION_DOWN: (1, 0),\n        env_factory.ACTION_LEFT: (0, -1),\n        env_factory.ACTION_RIGHT: (0, 1),\n    }\n\n    # Map action to resulting direction\n    _ACTION_TO_DIR = {\n        env_factory.ACTION_UP: DIR_NORTH,\n        env_factory.ACTION_DOWN: DIR_SOUTH,\n        env_factory.ACTION_LEFT: DIR_WEST,\n        env_factory.ACTION_RIGHT: DIR_EAST,\n    }\n\n    # Map delta (dr, dc) from agent to target to the expected facing direction\n    _DELTA_TO_DIR = {\n        (-1, 0): DIR_NORTH, # Target is North of agent\n        (1, 0): DIR_SOUTH,  # Target is South of agent\n        (0, -1): DIR_WEST,  # Target is West of agent\n        (0, 1): DIR_EAST,   # Target is East of agent\n    }\n\n    # Get current observation and state details\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    current_pos = env._current_state.pos # Agent's current (row, col)\n    current_dir = env._current_state.dir # Agent's current facing direction (0, 1, 2, or 3)\n\n    HEIGHT, WIDTH, _ = grid.shape\n\n    # Identify all primitive locations on the grid\n    primitive_locations = []\n    for r in range(HEIGHT):\n        for c in range(WIDTH):\n            if grid[r, c, primitive] > 0: # Check if the primitive exists at this cell\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        return [] # No primitive of this kind found anywhere\n\n    # Identify obstacle cells (non-grabbable items) that the agent cannot move onto\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # BFS setup for pathfinding\n    q = collections.deque()\n    # parent_map stores (current_state) -> ((parent_state), action_to_reach_current_state)\n    # State is (row, col, direction) to account for agent's orientation\n    parent_map = {}\n    \n    # Initial state: (row, col, direction, list_of_actions_so_far)\n    initial_state_tuple = (current_pos[0], current_pos[1], current_dir)\n    q.append((current_pos[0], current_pos[1], current_dir, []))\n    parent_map[initial_state_tuple] = None # Mark the starting state as visited\n\n    while q:\n        r, c, d, path_so_far = q.popleft()\n\n        # Check if the current state (position and direction) allows using a primitive\n        for pr, pc in primitive_locations:\n            dr_adj = pr - r\n            dc_adj = pc - c\n            \n            # Check if (pr, pc) is an adjacent cell (Manhattan distance of 1)\n            if abs(dr_adj) + abs(dc_adj) == 1:\n                # Calculate the direction the agent needs to face to look at (pr, pc)\n                expected_dir = _DELTA_TO_DIR.get((dr_adj, dc_adj))\n                \n                # If agent is already facing the primitive, we can USE it\n                if expected_dir is not None and d == expected_dir:\n                    # Found the shortest path to a valid position and orientation\n                    return path_so_far + [env_factory.ACTION_USE]\n\n        # Explore possible movement actions from the current state\n        for action in [env_factory.ACTION_UP, env_factory.ACTION_DOWN, \n                       env_factory.ACTION_LEFT, env_factory.ACTION_RIGHT]:\n            dr, dc = _ACTION_TO_DELTA[action]\n            new_r, new_c = r + dr, c + dc\n            new_d = _ACTION_TO_DIR[action] # Agent's direction changes to match the movement\n\n            # Check boundary conditions\n            if not (0 <= new_r < HEIGHT and 0 <= new_c < WIDTH):\n                continue\n\n            # Check if the new cell is an obstacle (non-grabbable item)\n            is_obstacle = False\n            for k_idx in non_grabbable_indices:\n                if grid[new_r, new_c, k_idx] > 0:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n            \n            # Prevent moving onto the primitive itself, as 'USE' implies interaction with an adjacent cell.\n            # This is critical for the \"adjacent and use\" collection strategy.\n            if grid[new_r, new_c, primitive] > 0:\n                continue \n\n            new_state_tuple = (new_r, new_c, new_d)\n            if new_state_tuple not in parent_map:\n                parent_map[new_state_tuple] = ((r, c, d), action)\n                q.append((new_r, new_c, new_d, path_so_far + [action]))\n    \n    # If the BFS completes without finding any path to collect the primitive, return an empty list\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:20:28.555488", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Action constants (assuming these are globally defined or accessible like this)\n  # From CraftLab.action_specs: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Delta movements for each cardinal direction (dx, dy)\n  # UP: (0, -1) -> decreased Y\n  # DOWN: (0, 1) -> increased Y\n  # LEFT: (-1, 0) -> decreased X\n  # RIGHT: (1, 0) -> increased X\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0),\n  }\n\n  # Offsets for a 3x3 neighborhood around the agent's position (including (0,0) for agent's cell)\n  # This matches the CraftState.next_to logic used for the USE action.\n  NEIGHBORHOOD_3X3_OFFSETS = [\n      (dx, dy) for dx in [-1, 0, 1] for dy in [-1, 0, 1]\n  ]\n\n  # Initialize the list of actions to be returned\n  actions_sequence = []\n  \n  # Get current state observation from the environment\n  obs = env.observations()\n  current_grid = obs['features_dict']['features_global']\n  \n  # Agent's current position (x, y) - ensure it's an integer tuple\n  agent_pos_x, agent_pos_y = obs['features_dict']['pos'].astype(int)\n  current_agent_pos = (agent_pos_x, agent_pos_y)\n  \n  world = env.world\n  # Non-grabbable items define obstacles (e.g., walls, water, workshops).\n  # These are typically untraversable for the agent's movement.\n  non_traversable_indices = world.non_grabbable_indices\n  \n  grid_width, grid_height, num_kinds = current_grid.shape\n\n  # 1. Create a traversability mask for the grid\n  # A cell is traversable if it does not contain any non-grabbable item.\n  traversable_map = np.ones((grid_width, grid_height), dtype=bool)\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # Mark cell as not traversable if it contains any non-grabbable entity\n          if any(current_grid[x, y, idx] > 0 for idx in non_traversable_indices):\n              traversable_map[x, y] = False\n  \n  # If the agent starts on an untraversable cell, no path can be found.\n  if not traversable_map[current_agent_pos[0], current_agent_pos[1]]:\n      return []\n\n  # 2. Determine target entity kinds that, if present, allow collection of the primitive.\n  # This includes the primitive item itself (if lying on the ground) and its source blocks.\n  collection_target_kinds = {primitive} # The primitive item itself\n  \n  # Add source block indices if the primitive is 'water' or 'stone'\n  primitive_name = world.cookbook.index.get(primitive)\n  if primitive_name == 'water':\n      # 'water_index' refers to the water *block* which can be harvested\n      collection_target_kinds.add(world.water_index) \n  elif primitive_name == 'stone':\n      # 'stone_index' refers to the stone *block* which can be harvested\n      collection_target_kinds.add(world.stone_index)\n  # Extend this logic for other harvestable primitives as needed (e.g., 'wood' from 'tree_block')\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path to a valid collection location.\n  # A valid collection location is any cell from which the agent can USE to collect the primitive.\n  \n  q = deque([current_agent_pos]) \n  visited_positions = {current_agent_pos} # Set to keep track of visited (x, y) positions\n  \n  # Dictionary to reconstruct path: parent_map[child_pos] = (parent_pos, action_to_reach_child)\n  parent_map = {} \n  \n  target_collection_pos = None\n\n  while q:\n      current_bfs_pos = q.popleft()\n      curr_x, curr_y = current_bfs_pos\n\n      # Check if the current BFS position is a valid spot to collect the primitive.\n      # This means checking if any of the 'collection_target_kinds' are in the 3x3 neighborhood.\n      is_valid_collection_location = False\n      for target_kind_idx in collection_target_kinds:\n          for dx, dy in NEIGHBORHOOD_3X3_OFFSETS:\n              neighbor_x, neighbor_y = curr_x + dx, curr_y + dy\n              \n              # Check if the neighbor cell is within grid bounds\n              if (0 <= neighbor_x < grid_width and 0 <= neighbor_y < grid_height):\n                  # If the neighbor cell contains the target kind, then current_bfs_pos is a valid location\n                  if current_grid[neighbor_x, neighbor_y, target_kind_idx] > 0:\n                      is_valid_collection_location = True\n                      break # Found a reason, stop checking offsets for this target_kind_idx\n          if is_valid_collection_location:\n              break # Found a reason, stop checking other target_kind_indices\n\n      if is_valid_collection_location:\n          target_collection_pos = current_bfs_pos\n          break # Shortest path to a valid collection location found, exit BFS\n\n      # Explore adjacent cells (UP, DOWN, LEFT, RIGHT movements)\n      for action_type, (dx, dy) in MOVE_DELTAS.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # Check bounds, traversability, and if the position has already been visited\n          if (0 <= next_x < grid_width and 0 <= next_y < grid_height and\n              traversable_map[next_x, next_y] and\n              next_pos not in visited_positions):\n              \n              visited_positions.add(next_pos)\n              parent_map[next_pos] = (current_bfs_pos, action_type) # Store the parent and action\n              q.append(next_pos)\n  \n  # If no path to a collection location was found (e.g., primitive is not in the world)\n  if target_collection_pos is None:\n      return [] \n  \n  # 4. Reconstruct the path of movement actions from the found target position back to the start.\n  current_path_node = target_collection_pos\n  while current_path_node != current_agent_pos:\n      # Get the parent position and the action taken to reach current_path_node from its parent\n      previous_node, action_to_take = parent_map[current_path_node]\n      actions_sequence.append(action_to_take)\n      current_path_node = previous_node # Move to the parent node\n  \n  actions_sequence.reverse() # Reverse the list to get actions from start to target\n  \n  # 5. Append the USE action, as the agent is now at a position from which it can collect.\n  actions_sequence.append(ACTION_USE)\n  \n  return actions_sequence", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:20:29.551900", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Constants for actions (from problem description context)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) to (dx, dy)\n  # Assuming 0: North/Up (-y), 1: East/Right (+x), 2: South/Down (+y), 3: West/Left (-x)\n  DIRECTION_TO_DELTA = {\n      0: (0, -1),  # UP\n      1: (1, 0),   # RIGHT\n      2: (0, 1),   # DOWN\n      3: (-1, 0)   # LEFT\n  }\n\n  # Map movement action to the direction agent faces after taking that action\n  # (Assuming agent faces the direction it just moved)\n  MOVE_ACTION_TO_DIRECTION = {\n      UP: 0,    # Action UP (1) results in facing UP (0)\n      DOWN: 2,  # Action DOWN (0) results in facing DOWN (2)\n      LEFT: 3,  # Action LEFT (2) results in facing LEFT (3)\n      RIGHT: 1  # Action RIGHT (3) results in facing RIGHT (1)\n  }\n\n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n\n  # Ensure position is int tuple. CraftState.pos is tuple(int, int)\n  # Convert numpy array to tuple of ints for hashing in visited set\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  # Convert one-hot direction to integer direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  initial_dir = np.argmax(obs['features_dict']['direction'])\n\n  world = env.world\n  # non_grabbable_indices typically include obstacles like water, stone walls.\n  # Assuming these prevent movement. Workshop indices might or might not be traversable\n  # depending on whether they are included in non_grabbable_indices by the environment setup.\n  non_grabbable_indices = world.non_grabbable_indices\n\n  W, H, K = grid.shape # Grid dimensions: Width, Height, Number of kinds\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for x in range(W):\n      for y in range(H):\n          # A cell is NOT traversable if it contains any non-grabbable item.\n          if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n              traversable_mask[x, y] = False\n\n  # If agent starts on an untraversable cell, no path is possible.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return []\n\n  # 2. Determine target kinds for collection.\n  # The 'primitive' input is the index of the *item* we want to collect.\n  # Items can be collected by 'USE' action either directly if lying on the ground (primitive itself)\n  # or by harvesting from a source block (e.g., water from a 'water' block, stone from a 'stone' block).\n  target_grid_indices = {primitive} # Always include the primitive itself for direct pickup\n\n  primitive_name = world.cookbook.index.get(primitive)\n  if primitive_name == 'water':\n      # Add water block index as a source if 'water' primitive is desired.\n      target_grid_indices.add(world.water_index)\n  elif primitive_name == 'stone':\n      # Add stone block index as a source if 'stone' primitive is desired.\n      target_grid_indices.add(world.stone_index)\n  # Extend with more mappings here if other primitives have specific source blocks (e.g., 'wood' from a 'tree' block).\n\n  # 3. Perform BFS to find the shortest sequence of actions (movement + final USE)\n  # BFS state: ((pos_x, pos_y), current_facing_direction, list_of_actions_so_far)\n  q = deque([((current_pos_x, current_pos_y), initial_dir, [])])\n\n  # Visited set: ((pos_x, pos_y), current_dir) to prevent revisiting states and cycles.\n  # A state is defined by both position and facing direction, as 'USE' is directional.\n  visited = {((current_pos_x, current_pos_y), initial_dir)}\n\n  while q:\n      (curr_x, curr_y), curr_dir, actions_so_far = q.popleft()\n\n      # Check if the current state allows collection of the primitive via the USE action.\n      # The USE action is assumed to apply to the cell directly in front of the agent.\n      front_dx, front_dy = DIRECTION_TO_DELTA[curr_dir] # Delta for the cell in front\n      target_x, target_y = curr_x + front_dx, curr_y + front_dy\n\n      # Check if the cell in front is within grid bounds AND contains any of the target items/sources.\n      if (0 <= target_x < W and 0 <= target_y < H and\n          any(grid[target_x, target_y, idx] > 0 for idx in target_grid_indices)):\n          # Goal reached: agent is positioned and facing a collectable resource.\n          # Append USE action to the path and return the sequence.\n          return actions_so_far + [USE]\n\n      # Explore possible next states by taking movement actions (UP, DOWN, LEFT, RIGHT).\n      for action_val in [UP, DOWN, LEFT, RIGHT]:\n          # After taking a movement action, the agent's direction changes to match the movement.\n          next_dir = MOVE_ACTION_TO_DIRECTION[action_val]\n\n          # Calculate the new position based on the new direction (agent moves one step in this direction).\n          dx, dy = DIRECTION_TO_DELTA[next_dir] # Note: dx, dy are for the new direction\n          next_x, next_y = curr_x + dx, curr_y + dy\n\n          # Check if the next cell is within bounds and is traversable.\n          if (0 <= next_x < W and 0 <= next_y < H and\n              traversable_mask[next_x, next_y]):\n\n              next_state_key = ((next_x, next_y), next_dir)\n\n              # If this (position, direction) state has not been visited yet, add to queue.\n              if next_state_key not in visited:\n                  visited.add(next_state_key)\n                  q.append(((next_x, next_y), next_dir, actions_so_far + [action_val]))\n\n  # If the queue becomes empty and no solution is found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:21:40.082669", "function_name": "collect", "function_body": "  import collections # Using collections.deque for efficient queue operations in BFS\n\n  # Define action mappings for clarity. These map movement actions to coordinate changes.\n  # The agent's new direction after a move action is equal to the action ID itself.\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  _USE_ACTION = 4 # The action ID for performing a 'USE' interaction\n\n  # 1. Resolve the primitive name to its integer index ID\n  # This uses the environment's cookbook to get the unique ID for the item.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Pre-check: Is the primitive even grabbable?\n  # If it's not in the list of grabbable items, it cannot be collected via USE.\n  if primitive_idx not in env.world.grabbable_indices:\n    return [] # Return an empty list of actions if it's not grabbable.\n\n  # 3. Pre-check: Does the agent already have the primitive in its inventory?\n  # If the agent already possesses the item, no actions are needed.\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already collected, return empty action list.\n\n  # 4. Prepare for BFS: Get grid dimensions and identify impassable terrain\n  game_grid = current_state.grid\n  grid_width, grid_height, _ = game_grid.shape\n  \n  # Non-grabbable items are typically impassable obstacles in CraftWorld.\n  impassable_indices = env.world.non_grabbable_indices\n  \n  # BFS state representation: ((x, y), direction) - A unique combination of position and facing.\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Initial facing direction of the agent.\n\n  # Queue for BFS: Stores states to visit. Using deque for O(1) popleft().\n  bfs_queue = collections.deque([(start_pos, start_dir)]) \n  \n  # Path reconstruction dictionary:\n  # Maps each visited state `((x, y), dir)` to `(parent_state, action_from_parent)`.\n  # This allows backtracking from the goal state to reconstruct the path.\n  path_reconstruction_map = {(start_pos, start_dir): (None, None)} \n\n  goal_use_state = None # To store the specific state from which the final USE action can be executed.\n\n  # Main BFS loop\n  while bfs_queue:\n    (curr_x, curr_y), curr_dir = bfs_queue.popleft() # Dequeue the current state\n\n    # --- Check for 'USE' action opportunity from the current state ---\n    # The 'USE' action targets the cell directly in front of the agent.\n    face_dx, face_dy = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_cell_x, target_cell_y = curr_x + face_dx, curr_y + face_dy\n\n    # If the target cell is within grid bounds AND contains the desired primitive\n    if (0 <= target_cell_x < grid_width and 0 <= target_cell_y < grid_height and\n        game_grid[target_cell_x, target_cell_y, primitive_idx] > 0):\n      # We've found a state from which the primitive can be collected.\n      goal_use_state = ((curr_x, curr_y), curr_dir)\n      break # Path found, no need to explore further in BFS.\n\n    # --- Explore movement actions from the current state ---\n    # Agent can move DOWN, UP, LEFT, RIGHT. Moving also sets the agent's new facing direction.\n    for move_action_id in range(4): # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n      move_dx, move_dy = _ACTION_TO_COORD_DIFF[move_action_id]\n      next_pos_x, next_pos_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = move_action_id # Agent's direction changes to the direction of movement.\n\n      next_state_tuple = ((next_pos_x, next_pos_y), next_dir)\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_pos_x < grid_width and 0 <= next_pos_y < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check if the next position is impassable (contains any non-grabbable item).\n      # Agent cannot move into cells occupied by these items.\n      is_impassable_destination = False\n      for kind_idx in impassable_indices:\n        if game_grid[next_pos_x, next_pos_y, kind_idx] > 0:\n          is_impassable_destination = True\n          break\n      if is_impassable_destination:\n        continue # Skip this move if the destination is an impassable obstacle.\n      \n      # If this new state has not been visited yet, add it to the queue.\n      if next_state_tuple not in path_reconstruction_map:\n        path_reconstruction_map[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action_id)\n        bfs_queue.append(next_state_tuple)\n\n  # If BFS finished but no path was found to a collectable state:\n  if goal_use_state is None:\n    return [] \n\n  # --- Reconstruct the action path ---\n  # Start from the `goal_use_state` and backtrack using `path_reconstruction_map`.\n  final_actions_sequence = []\n  current_reconstruction_state = goal_use_state\n  \n  # Backtrack until the parent is None (which indicates the starting state).\n  while path_reconstruction_map[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = path_reconstruction_map[current_reconstruction_state]\n    final_actions_sequence.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  # The path was built in reverse (from goal to start), so reverse it to get the correct order.\n  final_actions_sequence.reverse()\n  \n  # Finally, append the _USE_ACTION to perform the collection.\n  return final_actions_sequence + [_USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:21:41.075071", "function_name": "collect", "function_body": "  import collections # Using collections.deque for efficient queue operations in BFS\n\n  \"\"\"Improved version of `collect_v1`.\n\n  This version refines the obstacle checking logic for potential performance\n  gains by leveraging numpy array indexing for checking impassable cells,\n  and ensuring that `non_grabbable_indices` is converted to a list only once.\n  \"\"\"\n\n  # Re-defining constants for clarity within the function scope\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable\n  if primitive_idx not in env.world.grabbable_indices:\n    return [] # Not grabbable, cannot collect via USE.\n\n  # 3. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 4. Retrieve grid dimensions and non-grabbable indices for boundary and impassable checks\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # Convert the set of non-grabbable indices to a list once for efficient numpy fancy indexing.\n  non_grabbable_indices_list = list(env.world.non_grabbable_indices) \n  \n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    BFS state: (current_x, current_y, current_direction)\n  \n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  # Queue for BFS: stores tuples of ((x, y), direction)\n  queue = collections.deque([(start_pos, start_dir)]) \n  \n  # Dictionary to reconstruct the path: \n  # Keys are ((x, y), direction) tuples representing a state.\n  # Values are (parent_state_tuple, action_taken_to_reach_current_state).\n  # The starting state's parent info is (None, None).\n  path_trace = {(start_pos, start_dir): (None, None)} \n\n  target_use_state = None # Will store the state from which the final USE action can be applied\n\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.popleft() # Dequeue the current state\n\n    # Check if a 'USE' action is possible from this current state.\n    # This involves looking at the cell directly in front of the agent.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # If the target cell is within bounds and contains the desired primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      # We've found a valid state from which the primitive can be collected.\n      target_use_state = ((curr_x, curr_y), curr_dir)\n      break # Path found, exit the BFS loop.\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # Moving changes both the agent's position and its facing direction.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to cardinal movements\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # The agent's new direction is the direction of movement\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position is impassable (contains any non-grabbable item).\n      # The agent cannot move into cells occupied by these items.\n      # This is the primary improvement over collect_v1, using numpy.any for efficiency\n      # by checking all non-grabbable indices in the cell's stack at once.\n      if non_grabbable_indices_list and np.any(grid[next_x, next_y, non_grabbable_indices_list]):\n        continue # Skip this move if the destination is impassable\n      \n      # If this new state (position and direction) has not been visited yet during the BFS\n      if next_state_tuple not in path_trace: # path_trace acts as our visited set\n        # Store how we reached this new state\n        path_trace[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action)\n        queue.append(next_state_tuple) # Add the new state to the queue for further exploration\n\n  if target_use_state is None:\n    return [] # If the queue becomes empty and no path was found, the primitive is unreachable.\n\n  # Reconstruct the sequence of actions by backtracking from the `target_use_state`\n  # back to the `start_pos`/`start_dir` using the `path_trace` dictionary.\n  path_actions = []\n  current_reconstruction_state = target_use_state\n  \n  # Backtrack until we reach the starting state, which has (None, None) as its parent info\n  while path_trace[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = path_trace[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  # The path was built in reverse order (from target to start), so reverse it\n  path_actions.reverse()\n  \n  # Add the final 'USE' action to complete the collection sequence\n  return path_actions + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:23:05.596102", "function_name": "collect", "function_body": "  actions = []\n  \n  # Reset the environment to get a fresh start and initial state\n  _ = env.reset() # Discard the initial observation dict\n  current_state = env._current_state\n\n  # Maximum number of steps to prevent infinite loops in case of unachievable goal\n  # or complex terrain not handled by simple greedy movement.\n  max_collection_attempts = 250 # Arbitrary reasonable limit\n\n  for _ in range(max_collection_attempts):\n    # 1. Check if the primitive is already in the inventory\n    if current_state.inventory[primitive] > 0:\n      break # Goal achieved\n\n    # 2. Check if the primitive is in the agent's immediate vicinity and grabbable\n    if current_state.next_to(primitive) and primitive in env.world.grabbable_indices:\n      action = env_factory.ACTIONS.USE\n      actions.append(action)\n      # Perform the action and update the state\n      _, _, _ = env.step(action) # Discard reward, done, obs for this internal helper\n      current_state = env._current_state\n      # Continue to the next iteration to re-check inventory immediately\n      continue\n\n    # 3. If not in vicinity, find the primitive's location on the grid\n    # np.argwhere returns (row, col) for elements > 0\n    # current_state.grid has shape (WIDTH, HEIGHT, n_kinds)\n    primitive_locations = np.argwhere(current_state.grid[:, :, primitive] > 0)\n\n    if len(primitive_locations) == 0:\n      # The primitive is not on the map, or all instances have been collected by other means.\n      # For a \"collect\" function, this implies failure if not already in inventory.\n      break \n\n    # Get the agent's current position (row, col)\n    agent_r, agent_c = current_state.pos\n\n    # Find the closest primitive location using Manhattan distance\n    closest_loc = None\n    min_dist = float('inf')\n\n    for pr, pc in primitive_locations:\n      dist = abs(pr - agent_r) + abs(pc - agent_c)\n      if dist < min_dist:\n        min_dist = dist\n        closest_loc = (pr, pc)\n\n    # This should always be true if primitive_locations is not empty\n    if closest_loc is None:\n        break # Should not happen, but defensive programming\n\n    target_r, target_c = closest_loc\n\n    # Determine the best action to move towards the target\n    dr = target_r - agent_r # Difference in rows\n    dc = target_c - agent_c # Difference in columns\n\n    action_to_take = None\n\n    # Prioritize moving vertically if a difference exists, otherwise horizontally\n    if dr != 0: # Need to move vertically\n      action_to_take = env_factory.ACTIONS.DOWN if dr > 0 else env_factory.ACTIONS.UP\n    elif dc != 0: # Need to move horizontally (only if dr is 0)\n      action_to_take = env_factory.ACTIONS.RIGHT if dc > 0 else env_factory.ACTIONS.LEFT\n    else:\n      # Agent is exactly at the target location (dr=0, dc=0).\n      # If `next_to` didn't catch it, and `primitive in env.world.grabbable_indices` is true,\n      # it implies the primitive is on the same cell but not \"collectible\" via `USE` from there.\n      # This is an edge case; typically, being on the cell would trigger `next_to` if the item\n      # is meant to be collected like this. Break as we cannot progress.\n      break\n\n    if action_to_take is not None:\n      actions.append(action_to_take)\n      # Perform the movement action\n      _, _, _ = env.step(action_to_take)\n      current_state = env._current_state\n    else:\n      # This block should only be reached if dr=0 and dc=0 and the break condition above was not met.\n      # This scenario implies a logical flaw or an uncollectible primitive.\n      break\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:23:06.592604", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Constants for actions (defined in CraftLab's action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map (dy, dx) offsets for movement actions\n  MOVE_DELTAS = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1),\n  }\n\n  # Get initial observations to check inventory and grid\n  obs = env.observations()\n  inventory = obs['features_dict']['inventory']\n  \n  # 1. Check if primitive is already in inventory\n  if inventory[primitive] > 0:\n      return []\n\n  grid = obs['features_dict']['features_global']\n  current_pos_y, current_pos_x = obs['features_dict']['pos']\n  current_pos = (current_pos_y, current_pos_x)\n  \n  grid_height, grid_width, _ = grid.shape\n\n  # Get non-walkable indices (obstacles) from CraftWorld\n  # CraftLab -> CraftScenario -> CraftWorld\n  world = env.scenario.world\n  \n  # Initialize non_walkable_indices with the default non_grabbable items\n  non_walkable_indices = world.non_grabbable_indices.copy()\n  # Add specific common obstacles if they are not already in non_grabbable_indices\n  non_walkable_indices.add(world.water_index)\n  non_walkable_indices.add(world.stone_index)\n\n  target_pos = None\n  # 2. Locate the primitive on the grid\n  for r in range(grid_height):\n      for c in range(grid_width):\n          # Check if this cell contains the primitive\n          if grid[r, c, primitive] > 0:\n              target_pos = (r, c)\n              break\n      if target_pos:\n          break\n\n  if target_pos is None:\n      # Primitive not found on the grid\n      return []\n\n  # 3. Find all walkable adjacent cells to the target_pos\n  # The agent needs to path TO one of these adjacent cells, then USE.\n  adj_cells_to_target = []\n  # Iterate over 4 cardinal directions around the target_pos\n  for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n      adj_r, adj_c = target_pos[0] + dr, target_pos[1] + dc\n      adj_cell_pos = (adj_r, adj_c)\n\n      # Check bounds for adjacent cell\n      if not (0 <= adj_r < grid_height and 0 <= adj_c < grid_width):\n          continue\n\n      # Check if adjacent cell is walkable (not an obstacle)\n      is_walkable_adj_cell = True\n      for kind_idx in non_walkable_indices:\n          # If the adjacent cell contains any non-walkable item, it's an obstacle\n          if grid[adj_r, adj_c, kind_idx] > 0:\n              is_walkable_adj_cell = False\n              break\n      \n      # Also, ensure we are not trying to stand on the primitive's actual location\n      # as we typically interact with it from an adjacent square.\n      if adj_cell_pos == target_pos:\n          is_walkable_adj_cell = False\n\n      if is_walkable_adj_cell:\n          adj_cells_to_target.append(adj_cell_pos)\n\n  if not adj_cells_to_target:\n      # No walkable cell adjacent to the primitive found\n      return []\n\n  # 4. Pathfinding (BFS) from current_pos to any walkable adjacent cell\n  # Queue stores tuples of ((r, c), path_actions_to_reach_here)\n  queue = deque([(current_pos, [])])\n  visited = {current_pos} # Set of visited (r, c) positions\n  \n  path_to_adj_cell = None\n\n  while queue:\n      (r, c), path_actions = queue.popleft()\n\n      # If we reached any of the desired adjacent cells\n      if (r, c) in adj_cells_to_target:\n          path_to_adj_cell = path_actions\n          break\n\n      # Explore neighbors\n      for action, (dr, dc) in MOVE_DELTAS.items():\n          nr, nc = r + dr, c + dc\n          new_pos = (nr, nc)\n\n          # Check bounds\n          if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n              continue\n          \n          # Check if already visited\n          if new_pos in visited:\n              continue\n\n          # Check if new_pos is an obstacle (contains any non-walkable item)\n          is_obstacle = False\n          for kind_idx in non_walkable_indices:\n              if grid[nr, nc, kind_idx] > 0:\n                  is_obstacle = True\n                  break\n          \n          # Additionally, consider the target primitive's location as an obstacle for pathing\n          # since we want to stand adjacent to it, not on it.\n          if new_pos == target_pos:\n              is_obstacle = True\n\n          if is_obstacle:\n              continue\n          \n          visited.add(new_pos)\n          queue.append((new_pos, path_actions + [action]))\n\n  if path_to_adj_cell:\n      # If a path was found, append the USE action\n      return path_to_adj_cell + [USE]\n  else:\n      # No path found to any adjacent walkable cell\n      return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:24:44.377992", "function_name": "collect", "function_body": "    # Action constants (from problem description context)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Direction constants for agent orientation\n    DIR_UP = 0\n    DIR_RIGHT = 1\n    DIR_DOWN = 2\n    DIR_LEFT = 3\n\n    # Mapping from direction to (dx, dy) delta for movement\n    DIRECTION_TO_DELTA = {\n        DIR_UP: (0, -1),   # (dx, dy)\n        DIR_RIGHT: (1, 0),\n        DIR_DOWN: (0, 1),\n        DIR_LEFT: (-1, 0),\n    }\n\n    # Mapping from movement action to resulting agent direction\n    MOVE_ACTION_TO_DIRECTION = {\n        UP: DIR_UP,\n        RIGHT: DIR_RIGHT,\n        DOWN: DIR_DOWN,\n        LEFT: DIR_LEFT,\n    }\n\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    \n    # Extract current agent position and direction\n    current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n    current_dir = np.argmax(obs['features_dict']['direction'])\n    \n    world = env.world\n    cookbook = world.cookbook\n    non_grabbable_indices = world.non_grabbable_indices\n    \n    W, H, K = grid.shape # Grid dimensions (Width, Height, Kinds)\n\n    # 1. Determine traversable cells (cells without non-grabbable obstacles)\n    if non_grabbable_indices:\n        # A cell is non-traversable if ANY non-grabbable item is present in it.\n        obstacles_present = np.any(grid[:, :, list(non_grabbable_indices)] > 0, axis=2)\n        traversable_mask = ~obstacles_present # Invert to get traversable cells (True = traversable)\n    else:\n        # If there are no non-grabbable items defined, all cells are traversable.\n        traversable_mask = np.ones((W, H), dtype=bool)\n\n    # If the agent starts on an untraversable cell, no path is possible.\n    if not traversable_mask[current_pos_x, current_pos_y]:\n        return []\n\n    # 2. Identify all potential \"source\" cells (px, py) for the primitive.\n    # These are cells that, if the agent faces them, allow the 'USE' action to collect 'primitive'.\n    \n    # Get the name of the primitive item (e.g., 'water', 'stone')\n    primitive_name = cookbook.index.get(primitive) \n\n    # List to store (px, py) coordinates of cells containing harvestable resources\n    harvestable_resource_locations = []\n\n    for px in range(W):\n        for py in range(H):\n            # Case A: The primitive item itself is directly present on the ground at (px, py)\n            if grid[px, py, primitive] > 0:\n                harvestable_resource_locations.append((px, py))\n            \n            # Case B: The cell (px, py) contains a source block from which the primitive can be harvested.\n            # This handles specific mappings like 'water' item from 'water_index' block, 'stone' item from 'stone_index' block.\n            if primitive_name == 'water' and world.water_index is not None:\n                if grid[px, py, world.water_index] > 0:\n                    harvestable_resource_locations.append((px, py))\n            elif primitive_name == 'stone' and world.stone_index is not None:\n                if grid[px, py, world.stone_index] > 0:\n                    harvestable_resource_locations.append((px, py))\n            # Add more specific harvestable mappings here if applicable (e.g., 'wood' from a 'tree' block)\n\n    # Remove duplicates from the list of harvestable resource locations\n    harvestable_resource_locations = list(set(harvestable_resource_locations))\n\n    # If no harvestable source is found anywhere in the grid, return an empty path.\n    if not harvestable_resource_locations:\n        return []\n\n    # 3. Identify all valid agent \"goal states\" (ax, ay, adir) from which the USE action can be performed.\n    # A goal state is an agent position and direction such that the cell directly in front contains a harvestable resource.\n    primitive_target_states = set()\n    for source_x, source_y in harvestable_resource_locations:\n        for agent_facing_dir, (dx_face, dy_face) in DIRECTION_TO_DELTA.items():\n            # Calculate the agent's position (agent_x, agent_y) from which it would be facing (source_x, source_y).\n            # If agent at (ax, ay) faces (dx_face, dy_face), then the cell in front is (ax + dx_face, ay + dy_face).\n            # We want (ax + dx_face, ay + dy_face) == (source_x, source_y).\n            agent_x, agent_y = source_x - dx_face, source_y - dy_face\n\n            # Check if this calculated agent position is within grid bounds and is traversable.\n            if (0 <= agent_x < W and 0 <= agent_y < H and traversable_mask[agent_x, agent_y]):\n                primitive_target_states.add((agent_x, agent_y, agent_facing_dir))\n\n    # If, after considering all source locations and directions, no valid agent goal states are found, return empty.\n    if not primitive_target_states:\n        return []\n\n    # 4. A* Search Algorithm\n    # The state in our A* search is (agent_x, agent_y, agent_direction).\n    \n    # Heuristic function: Manhattan distance from current agent position to the closest\n    # *harvestable resource location*. This heuristic is admissible (never overestimates)\n    # and consistent. It focuses only on position, not direction, which simplifies computation\n    # and keeps it admissible given the action space.\n    def heuristic(x, y, agent_dir_ignored): # agent_dir_ignored is not used in this heuristic calculation\n        min_dist = float('inf')\n        for px, py in harvestable_resource_locations:\n            dist = abs(x - px) + abs(y - py)\n            min_dist = min(min_dist, dist)\n        return min_dist\n\n    # g_score[state]: actual cost (number of actions) from the start_state to the current state.\n    g_score = { (current_pos_x, current_pos_y, current_dir): 0 }\n\n    # f_score[state]: estimated total cost from start_state through state to goal (g_score + heuristic).\n    f_score = { (current_pos_x, current_pos_y, current_dir): heuristic(current_pos_x, current_pos_y, current_dir) }\n\n    # open_set: Priority queue of (f_score, g_score, state, path_taken_so_far).\n    # g_score is included as a tie-breaker in case of equal f_scores, preferring shorter actual paths.\n    open_set = [ (f_score[(current_pos_x, current_pos_y, current_dir)], \n                  0, # The g_score part of the tuple, used for tie-breaking in heapq\n                  (current_pos_x, current_pos_y, current_dir), \n                  []) ] # Initial path is empty\n\n    while open_set:\n        # Pop the state with the lowest f_score (and then lowest g_score) from the priority queue.\n        current_f, current_g, (curr_x, curr_y, curr_dir), actions_so_far = heapq.heappop(open_set)\n\n        # Optimization: If we've already found a shorter path to this state, skip processing this one.\n        if current_g > g_score.get((curr_x, curr_y, curr_dir), float('inf')):\n            continue\n\n        # Check if the current state is a goal state (one from which we can collect the primitive).\n        if (curr_x, curr_y, curr_dir) in primitive_target_states:\n            return actions_so_far + [USE] # Goal reached, append the USE action and return the complete path.\n\n        # Explore neighbor states by applying movement actions (UP, DOWN, LEFT, RIGHT).\n        for action_val in [UP, DOWN, LEFT, RIGHT]:\n            # When a movement action is taken, the agent's direction changes to match the movement.\n            next_dir = MOVE_ACTION_TO_DIRECTION[action_val]\n            \n            # Calculate the new position based on the new direction.\n            dx, dy = DIRECTION_TO_DELTA[next_dir]\n            next_x, next_y = curr_x + dx, curr_y + dy\n            \n            # Check if the next position is within grid boundaries and is traversable.\n            if (0 <= next_x < W and 0 <= next_y < H and traversable_mask[next_x, next_y]):\n                \n                new_g_score = current_g + 1 # Each movement action costs 1 unit.\n                next_state = (next_x, next_y, next_dir)\n\n                # If this path to next_state is shorter than any previously found path to next_state,\n                # or if this is the first time we're reaching next_state:\n                if new_g_score < g_score.get(next_state, float('inf')):\n                    g_score[next_state] = new_g_score\n                    f_score[next_state] = new_g_score + heuristic(next_x, next_y, next_dir)\n                    # Add the new state to the priority queue with its path.\n                    heapq.heappush(open_set, (f_score[next_state], new_g_score, next_state, actions_so_far + [action_val]))\n    \n    # If the open_set becomes empty and no goal state was reached, it means the primitive\n    # is unreachable from the current state.\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:24:45.358517", "function_name": "collect", "function_body": "  from collections import deque\n  import heapq # For A* search\n\n  # Action constants (from problem description context)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Direction constants\n  DIR_UP = 0    # Corresponds to facing North\n  DIR_RIGHT = 1 # Corresponds to facing East\n  DIR_DOWN = 2  # Corresponds to facing South\n  DIR_LEFT = 3  # Corresponds to facing West\n\n  # Delta (dx, dy) for each direction\n  DIRECTION_TO_DELTA = {\n      DIR_UP: (0, -1),   # (dx, dy) - decreasing Y is Up\n      DIR_RIGHT: (1, 0), # increasing X is Right\n      DIR_DOWN: (0, 1),  # increasing Y is Down\n      DIR_LEFT: (-1, 0), # decreasing X is Left\n  }\n\n  # Mapping from move action to the resulting agent direction\n  MOVE_ACTION_TO_DIRECTION = {\n      UP: DIR_UP,\n      RIGHT: DIR_RIGHT,\n      DOWN: DIR_DOWN,\n      LEFT: DIR_LEFT,\n  }\n\n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Agent's initial position and direction\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  current_dir = np.argmax(obs['features_dict']['direction']) # Convert one-hot to int\n\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape # Grid dimensions (Width, Height, Kinds)\n\n  # 1. Compute traversable_mask: Identifies cells the agent can occupy.\n  # A cell is non-traversable if ANY non-grabbable item (obstacle) is present in it.\n  if non_grabbable_indices:\n      # Select relevant channels and check if any are > 0 along the K (kinds) axis.\n      obstacles_present = np.any(grid[:, :, list(non_grabbable_indices)] > 0, axis=2)\n      traversable_mask = ~obstacles_present # Invert: True for traversable, False for obstacle\n  else:\n      # If no non-grabbable items are defined, all cells are traversable by default.\n      traversable_mask = np.ones((W, H), dtype=bool)\n  \n  # Validate agent's starting position: it must be traversable.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return [] # Agent starts in an invalid location, no path possible.\n\n  # 2. Identify all \"target\" agent states (pos_x, pos_y, dir)\n  # A target agent state is one from which the 'USE' action can successfully collect the primitive.\n  # This implies the agent is at (ax, ay) facing 'target_dir', and the cell (px, py) directly\n  # in front of it contains the primitive or a source block for it.\n  primitive_target_states = set() \n  \n  # Iterate through every cell in the grid to find locations of the primitive or its sources.\n  for px in range(W):\n      for py in range(H):\n          # Determine what 'source kinds' are present at (px, py) that can yield the primitive.\n          source_kinds_in_cell = set()\n          \n          # The primitive itself might be on the ground and collectible via USE.\n          if grid[px, py, primitive] > 0:\n              source_kinds_in_cell.add(primitive)\n          \n          # Also consider specific source blocks (like water or stone) if they produce the primitive.\n          primitive_name = world.cookbook.index.get(primitive)\n          if primitive_name == 'water' and world.water_index is not None and grid[px, py, world.water_index] > 0:\n              source_kinds_in_cell.add(world.water_index)\n          elif primitive_name == 'stone' and world.stone_index is not None and grid[px, py, world.stone_index] > 0:\n              source_kinds_in_cell.add(world.stone_index)\n          # Extend this logic for other primitive-source mappings (e.g., 'wood' from 'tree' block)\n          \n          if source_kinds_in_cell:\n              # For each source found at (px, py), determine all agent states from which it could be 'USED'.\n              for target_dir, (target_dx, target_dy) in DIRECTION_TO_DELTA.items():\n                  # If agent is at (ax, ay) facing `target_dir`, the cell in front is (ax+target_dx, ay+target_dy).\n                  # We want this cell to be (px, py). So, ax = px - target_dx, ay = py - target_dy.\n                  ax, ay = px - target_dx, py - target_dy\n\n                  # Check if the calculated agent position is within grid bounds and is traversable.\n                  if (0 <= ax < W and 0 <= ay < H and traversable_mask[ax, ay]):\n                      primitive_target_states.add((ax, ay, target_dir))\n\n  # If no reachable target states are found (e.g., primitive not in world), return empty path.\n  if not primitive_target_states:\n      return []\n\n  # 3. Precompute `min_cost_to_goal` for all states using a reverse multi-source BFS.\n  # This serves as a highly accurate (admissible and consistent) heuristic for the A* search.\n  # `min_cost_to_goal[(x, y, dir)]` stores the minimum number of steps from `(x, y, dir)`\n  # to *any* state in `primitive_target_states`.\n  min_cost_to_goal = {} # Dictionary to store costs\n  q_heuristic = deque() # Queue for the BFS\n\n  # Initialize the BFS queue with all target states, setting their cost to 0.\n  for target_state in primitive_target_states:\n      min_cost_to_goal[target_state] = 0\n      q_heuristic.append(target_state)\n\n  while q_heuristic:\n      curr_x, curr_y, curr_dir = q_heuristic.popleft() # Current state in the reverse BFS\n      current_cost = min_cost_to_goal[(curr_x, curr_y, curr_dir)]\n\n      # In reverse BFS, we look for states `(prev_x, prev_y, prev_dir)` that could have\n      # transitioned *into* `(curr_x, curr_y, curr_dir)` in one step.\n      # An agent at `(prev_x, prev_y)` taking a move action in `prev_dir` would arrive\n      # at `(curr_x, curr_y)` and face `prev_dir`.\n      # Therefore, for a single move action to result in `(curr_x, curr_y, curr_dir)`,\n      # the `prev_dir` MUST BE equal to `curr_dir`.\n      \n      # Calculate the position (prev_x, prev_y) from which moving in `curr_dir`\n      # would lead to (curr_x, curr_y).\n      dx_curr_dir, dy_curr_dir = DIRECTION_TO_DELTA[curr_dir]\n      prev_x = curr_x - dx_curr_dir\n      prev_y = curr_y - dy_curr_dir\n      \n      # The previous state is (prev_x, prev_y, curr_dir).\n      prev_state = (prev_x, prev_y, curr_dir)\n\n      # Check if this `prev_state` is valid (within bounds and traversable).\n      if (0 <= prev_x < W and 0 <= prev_y < H and traversable_mask[prev_x, prev_y]):\n          # If a shorter path to `prev_state` is found, update its cost and add to queue.\n          if prev_state not in min_cost_to_goal or current_cost + 1 < min_cost_to_goal[prev_state]:\n              min_cost_to_goal[prev_state] = current_cost + 1\n              q_heuristic.append(prev_state)\n    \n  # 4. A* Search (forward): Finds the shortest path from the agent's current state to any target state.\n  # A state in A* is (x, y, direction).\n  # A node in the priority queue is (f_score, g_score, state, path_actions_so_far).\n  \n  start_state = (current_pos_x, current_pos_y, current_dir)\n  \n  g_score = {start_state: 0} # Cost from start to current state\n  \n  # Heuristic for the start state: Use the precomputed min_cost_to_goal.\n  # If the start state is not in min_cost_to_goal (i.e., unreachable from any target state), use infinity.\n  h_start = min_cost_to_goal.get(start_state, float('inf'))\n  f_score = {start_state: h_start} # Estimated total cost from start through current to goal\n\n  # Priority queue: (f_score, g_score, state, list_of_actions_to_reach_state)\n  open_set = [(f_score[start_state], 0, start_state, [])]\n\n  while open_set:\n      current_f, current_g, (curr_x, curr_y, curr_dir), actions_so_far = heapq.heappop(open_set)\n\n      # If we've already found a shorter path to this state, skip processing this one.\n      if current_g > g_score.get((curr_x, curr_y, curr_dir), float('inf')):\n          continue\n\n      # Check if the current state is one of our target states (from which we can collect).\n      if (curr_x, curr_y, curr_dir) in primitive_target_states:\n          return actions_so_far + [USE] # Path found! Append the USE action.\n\n      # Explore neighbor states by applying movement actions.\n      for action_val in [UP, DOWN, LEFT, RIGHT]:\n          # A move action (e.g., UP) directly sets the agent's new direction (e.g., DIR_UP).\n          next_dir = MOVE_ACTION_TO_DIRECTION[action_val]\n          \n          # Calculate the new position based on the new direction.\n          dx, dy = DIRECTION_TO_DELTA[next_dir]\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_state = (next_x, next_y, next_dir)\n\n          # Check if the next position is valid (within grid bounds and traversable).\n          if (0 <= next_x < W and 0 <= next_y < H and traversable_mask[next_x, next_y]):\n              new_g_score = current_g + 1 # Each movement action has a cost of 1.\n\n              # If this path to `next_state` is shorter than any previously found path.\n              if new_g_score < g_score.get(next_state, float('inf')):\n                  g_score[next_state] = new_g_score\n                  \n                  # Get the precomputed heuristic for `next_state`.\n                  # If `next_state` is unreachable from any target, h_next will be infinity.\n                  h_next = min_cost_to_goal.get(next_state, float('inf'))\n                  f_score[next_state] = new_g_score + h_next\n                  \n                  # Add the `next_state` to the priority queue.\n                  heapq.heappush(open_set, (f_score[next_state], new_g_score, next_state, actions_so_far + [action_val]))\n    \n  # If the open_set becomes empty and no goal state was reached, it means the primitive\n  # is unreachable from the current state.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:25:40.354801", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Action constants (from CraftLab action_specs: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Direction constants (0=N, 1=E, 2=S, 3=W, as inferred from problem description)\n  # Map integer direction to (dx, dy) deltas\n  DIRECTION_TO_DELTA = {\n      0: (0, -1), # North (y-coordinate decreases, visually 'up')\n      1: (1, 0),  # East (x-coordinate increases, visually 'right')\n      2: (0, 1),  # South (y-coordinate increases, visually 'down')\n      3: (-1, 0)  # West (x-coordinate decreases, visually 'left')\n  }\n\n  # Map movement action to the resulting direction the agent will face.\n  # In DMLab-like environments, a movement action often makes the agent turn to face\n  # the direction of the intended movement before attempting to move.\n  MOVE_ACTION_TO_DIRECTION = {\n      UP: 0,      # Taking UP action results in facing North (direction 0)\n      RIGHT: 1,   # Taking RIGHT action results in facing East (direction 1)\n      DOWN: 2,    # Taking DOWN action results in facing South (direction 2)\n      LEFT: 3     # Taking LEFT action results in facing West (direction 3)\n  }\n\n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global'] # The full grid (W, H, K)\n\n  # Get the agent's current position (x, y) and direction (0-3)\n  # `features_dict['pos']` is a normalized array, convert to int tuple.\n  current_pos = tuple(obs['features_dict']['pos'].astype(int))\n  # `features_dict['direction']` is a one-hot array, convert to integer.\n  current_dir = np.argmax(obs['features_dict']['direction'])\n\n  world = env.world\n  # `non_grabbable_indices` are typically obstacles that block movement.\n  non_grabbable_indices = world.non_grabbable_indices\n\n  W, H, K = grid.shape # Grid dimensions (Width, Height, Number of Kinds)\n\n  # 1. Create a traversability mask for the grid\n  # A cell is considered traversable if it does not contain any non-grabbable item.\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for x in range(W):\n      for y in range(H):\n          # A cell is blocked if any non_grabbable_index item has a count > 0 in it.\n          if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n              traversable_mask[x, y] = False\n\n  # Edge case: If the agent starts on an untraversable cell, no path is possible.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return []\n\n  # Initialize BFS queue: (current_position_tuple, current_direction_int, list_of_actions_taken)\n  q = deque([(current_pos, current_dir, [])])\n\n  # Initialize visited set: (position_tuple, direction_integer) to avoid cycles and redundant paths.\n  visited = {(current_pos, current_dir)}\n\n  while q:\n      curr_pos, curr_dir, actions_so_far = q.popleft()\n      curr_x, curr_y = curr_pos\n\n      # Check if the current state allows for collecting the primitive using the USE action.\n      # The USE action applies to the cell immediately in front of the agent.\n      front_dx, front_dy = DIRECTION_TO_DELTA[curr_dir] # Delta for the cell in front\n      target_x, target_y = curr_x + front_dx, curr_y + front_dy\n\n      # Verify if the target cell is within bounds and contains the desired primitive.\n      if (0 <= target_x < W and 0 <= target_y < H and\n          grid[target_x, target_y, primitive] > 0):\n          # Goal reached: the agent is in position and facing the primitive.\n          # Append the USE action and return the complete sequence of actions.\n          return actions_so_far + [USE]\n\n      # Explore all possible movement actions (UP, DOWN, LEFT, RIGHT).\n      for action_val in [UP, DOWN, LEFT, RIGHT]:\n          # Determine the new direction the agent will face after taking this action.\n          next_dir = MOVE_ACTION_TO_DIRECTION[action_val]\n\n          # Calculate the potential next position based on the new direction.\n          # The agent attempts to move one step in the direction it will face.\n          dx, dy = DIRECTION_TO_DELTA[next_dir]\n          potential_next_x, potential_next_y = curr_x + dx, curr_y + dy\n\n          # Check if the potential next cell is within grid bounds AND traversable.\n          if (0 <= potential_next_x < W and 0 <= potential_next_y < H and\n              traversable_mask[potential_next_x, potential_next_y]):\n              # Valid move: agent successfully moves to the next position.\n              next_pos = (potential_next_x, potential_next_y)\n              next_state_key = (next_pos, next_dir)\n\n              # If this (position, direction) state hasn't been visited, add it to the queue.\n              if next_state_key not in visited:\n                  visited.add(next_state_key)\n                  q.append((next_pos, next_dir, actions_so_far + [action_val]))\n          else:\n              # Blocked move: the agent's position does not change, but its direction still changes.\n              # This simulates \"turning in place\" by attempting to move into an obstacle.\n              next_pos = curr_pos # Position remains the same\n              next_state_key = (next_pos, next_dir) # Only direction changes\n\n              # If this new (position, direction) state hasn't been visited, add it.\n              if next_state_key not in visited:\n                  visited.add(next_state_key)\n                  q.append((next_pos, next_dir, actions_so_far + [action_val]))\n\n  return [] # If the queue becomes empty and no path is found, return an empty list.", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:25:41.340667", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Action constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map agent direction (0=N, 1=E, 2=S, 3=W) to (dx, dy) delta for the cell in front\n  DIRECTION_TO_DELTA = {\n      0: (0, -1),  # North (UP)\n      1: (1, 0),   # East (RIGHT)\n      2: (0, 1),   # South (DOWN)\n      3: (-1, 0),  # West (LEFT)\n  }\n\n  # Map movement action to the resulting agent direction\n  # This defines the direction the agent faces *after* attempting the move action.\n  MOVE_ACTION_TO_DIRECTION = {\n      UP: 0,    # UP action results in facing North\n      RIGHT: 1, # RIGHT action results in facing East\n      DOWN: 2,  # DOWN action results in facing South\n      LEFT: 3,  # LEFT action results in facing West\n  }\n\n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Get initial agent position (x, y) and direction (0=N, 1=E, 2=S, 3=W)\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  initial_dir = np.argmax(obs['features_dict']['direction']) # Convert one-hot to integer direction\n\n  world = env.world\n  # non_grabbable_indices are assumed to be obstacles that cannot be traversed.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape # Grid dimensions: Width, Height, Number of kinds\n\n  # 1. Create a traversability mask for the grid\n  # A cell is traversable if it does not contain any non-grabbable item.\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for x in range(W):\n      for y in range(H):\n          # A cell is non-traversable if it contains any non-grabbable item.\n          if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n              traversable_mask[x, y] = False\n  \n  # The agent's starting position must be traversable for a valid path to exist.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return []\n\n  # BFS state: ((x, y), current_facing_direction, list_of_actions_so_far)\n  # The queue stores tuples: ((pos_x, pos_y), current_dir, actions_taken)\n  q = deque([((current_pos_x, current_pos_y), initial_dir, [])])\n  \n  # Visited set: ((pos_x, pos_y), current_dir) to prevent revisiting states and cycles\n  visited = {((current_pos_x, current_pos_y), initial_dir)}\n  \n  while q:\n      (curr_x, curr_y), curr_dir, actions_so_far = q.popleft()\n\n      # Check if the current state allows collection of the primitive (via USE action)\n      # The USE action applies to the cell directly in front of the agent.\n      front_dx, front_dy = DIRECTION_TO_DELTA[curr_dir] # Delta for the cell in front\n      target_x, target_y = curr_x + front_dx, curr_y + front_dy\n\n      # Check if the target cell is within grid bounds AND contains the primitive\n      if (0 <= target_x < W and 0 <= target_y < H and\n          grid[target_x, target_y, primitive] > 0):\n          # Goal reached: agent is positioned and facing a primitive resource.\n          # Append USE action to the path and return the sequence.\n          return actions_so_far + [USE]\n\n      # Explore possible next states by taking movement actions (UP, DOWN, LEFT, RIGHT)\n      for action_val in [UP, DOWN, LEFT, RIGHT]:\n          # Determine the direction the agent will face after this action\n          next_dir_after_action = MOVE_ACTION_TO_DIRECTION[action_val]\n          \n          # Calculate the potential new position if the move is successful\n          move_dx, move_dy = DIRECTION_TO_DELTA[next_dir_after_action]\n          proposed_next_x, proposed_next_y = curr_x + move_dx, curr_y + move_dy\n          \n          actual_next_x, actual_next_y = curr_x, curr_y # Default: stay in place\n\n          # Check if the proposed next cell is within bounds and traversable\n          if (0 <= proposed_next_x < W and 0 <= proposed_next_y < H and\n              traversable_mask[proposed_next_x, proposed_next_y]):\n              # If traversable, the agent actually moves\n              actual_next_x, actual_next_y = proposed_next_x, proposed_next_y\n          # Else: The agent stays at curr_pos, but its direction still changes.\n\n          next_state_key = ((actual_next_x, actual_next_y), next_dir_after_action)\n          \n          # If this (position, direction) state has not been visited yet, add to queue\n          if next_state_key not in visited:\n              visited.add(next_state_key)\n              q.append(((actual_next_x, actual_next_y), next_dir_after_action, actions_so_far + [action_val]))\n\n  return [] # No path found to a pickup spot for the primitive", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:26:42.999514", "function_name": "collect", "function_body": "  # Get the current state from the environment\n  # CraftLab holds _current_state, which is a CraftState instance\n  state = env._current_state \n\n  # 1. Check if the primitive is already in the inventory\n  if state.inventory[primitive] > 0:\n    return [] # Already collected, no actions needed\n\n  # 2. Check if the agent is next to the primitive and can use it\n  # The USE action is typically 4 according to CraftLab action_specs.\n  if state.next_to(primitive):\n    return [4] # Agent is adjacent, use the item\n\n  # 3. Find the closest instance of the primitive on the grid\n  current_pos = state.pos # Agent's (row, col) position\n  grid = state.grid      # (HEIGHT, WIDTH, n_kinds) grid\n  \n  target_coords = None\n  min_dist = float('inf')\n\n  # Iterate through the grid to find the primitive\n  # grid.shape[0] is Height, grid.shape[1] is Width\n  # Rows correspond to the first dimension, columns to the second.\n  for r in range(grid.shape[0]):\n    for c in range(grid.shape[1]):\n      # Check if this cell contains the primitive\n      # The grid stores one-hot encoding for the entities at each cell.\n      # If grid[r, c, primitive] is > 0 (e.g., 1.0), the primitive is there.\n      if grid[r, c, primitive] > 0:\n        # Calculate Manhattan distance to the primitive\n        dist = abs(r - current_pos[0]) + abs(c - current_pos[1])\n        if dist < min_dist:\n          min_dist = dist\n          target_coords = (r, c)\n\n  # 4. If primitive is not found on the grid, return an empty action list\n  if target_coords is None:\n    return []\n\n  # 5. Determine the best movement action towards the closest primitive\n  target_r, target_c = target_coords\n  agent_r, agent_c = current_pos\n\n  actions = []\n\n  # Calculate differences in row and column\n  dr = target_r - agent_r\n  dc = target_c - agent_c\n\n  # Prioritize movement in the direction with the largest absolute difference\n  # This makes the agent move more directly towards the target, reducing turns.\n  # Action mapping: DOWN=0, UP=1, LEFT=2, RIGHT=3\n  if abs(dr) >= abs(dc): # Prioritize vertical movement if dr is larger or equal\n    if dr > 0:\n      actions.append(0) # DOWN\n    elif dr < 0:\n      actions.append(1) # UP\n  else: # Prioritize horizontal movement if dc is larger\n    if dc > 0:\n      actions.append(3) # RIGHT\n    elif dc < 0:\n      actions.append(2) # LEFT\n  \n  return actions # This will contain at most one movement action.", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:26:44.004612", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Get action mappings from the environment's action_specs\n  # These map action names (strings) to integer IDs.\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # All possible actions that can be taken in the CraftWorld\n  ALL_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n  # Helper function to create a unique, hashable key for a CraftState.\n  # This is crucial for tracking visited states in the BFS to prevent cycles\n  # and redundant exploration. The key must capture all relevant aspects of the state\n  # that affect future actions and the goal condition: agent's position, direction,\n  # inventory contents, and the grid layout (since items can be removed from the grid).\n  def get_state_key(state):\n      return (state.pos, state.dir, tuple(state.inventory.tolist()), state.grid.tobytes())\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element in the queue is a tuple: (current_craft_state, list_of_actions_taken_to_reach_this_state).\n  # We start with the initial state of the environment, accessible via env._current_state,\n  # and an empty list of actions.\n  initial_craft_state = env._current_state\n  initial_path = []\n  q = collections.deque([(initial_craft_state, initial_path)])\n\n  # Initialize a set to store keys of visited states. This prevents revisiting the same\n  # state multiple times, which is essential for efficiency and correctness in BFS.\n  visited = {get_state_key(initial_craft_state)}\n\n  # Perform BFS until the queue is empty or the goal is reached.\n  while q:\n      current_state, current_actions = q.popleft()\n\n      # Check if the goal (collecting the primitive) is satisfied in the current state.\n      # The goal is satisfied if the count of the 'primitive' item in the inventory is greater than zero.\n      if current_state.inventory[primitive] > 0:\n          return current_actions  # Goal achieved! Return the sequence of actions.\n\n      # Explore all possible actions from the current state.\n      for action in ALL_ACTIONS:\n          # Simulate the action using the CraftState's own step method.\n          # CraftState.step creates and returns a *new* CraftState instance,\n          # representing the state after the action, without modifying the current_state.\n          # The reward is always 0.0 for CraftState.step, so we only need the new_state.\n          _reward, next_state = current_state.step(action)\n\n          # Construct the path to the next state by appending the current action.\n          new_actions = current_actions + [action]\n\n          # Get the unique key for the next state.\n          next_state_key = get_state_key(next_state)\n\n          # If this next state has not been visited before, add it to the queue\n          # and mark it as visited.\n          if next_state_key not in visited:\n              visited.add(next_state_key)\n              q.append((next_state, new_actions))\n\n  # If the BFS completes without finding a path to collect the primitive,\n  # it means the primitive is unreachable or does not exist in the environment\n  # in a way that allows collection. In this case, return an empty list.\n  return []", "island_id": 1, "scores": {"3": -1}}
