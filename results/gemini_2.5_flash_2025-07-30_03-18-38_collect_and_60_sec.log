{"timestamp": "2025-07-30T11:48:58.272189", "function_name": "collect", "function_body": "  from collections import deque\n  import heapq\n\n  # Constants for actions and directions\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  DIRECTION_TO_DELTA = {\n      DIR_UP: (0, -1),   # (dx, dy)\n      DIR_RIGHT: (1, 0),\n      DIR_DOWN: (0, 1),\n      DIR_LEFT: (-1, 0),\n  }\n\n  MOVE_ACTION_TO_DIRECTION = {\n      UP: DIR_UP,\n      RIGHT: DIR_RIGHT,\n      DOWN: DIR_DOWN,\n      LEFT: DIR_LEFT,\n  }\n\n  # Helper function to reconstruct the path from the came_from map\n  def _reconstruct_path(came_from_map, current_state_key, start_state_key):\n      \"\"\"\n      Reconstructs the sequence of actions from the start_state_key to the current_state_key\n      using the came_from_map.\n      \"\"\"\n      path = []\n      # The `current_state_key` is the (x, y, dir) tuple for the agent\n      # right before it would take the 'USE' action.\n      # We backtrack from this state to the start state.\n      while current_state_key != start_state_key:\n          # This check handles potential issues, though in a correct A* search\n          # every state in the path should be in came_from_map.\n          if current_state_key not in came_from_map:\n              # Fallback for unexpected scenarios\n              return [] \n          \n          previous_state_key, action_taken_to_reach_current = came_from_map[current_state_key]\n          path.append(action_taken_to_reach_current)\n          current_state_key = previous_state_key\n      \n      return path[::-1] # Reverse the path to get actions from start to goal\n\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Get initial agent position (x, y) and direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  initial_dir = np.argmax(obs['features_dict']['direction']) # Convert one-hot to integer direction\n\n  world = env.world\n  # Non-grabbable items define obstacles (e.g., walls, water, workshops).\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape # Grid dimensions: Width, Height, Number of kinds\n\n  # 1. Create a traversability mask for the grid\n  # A cell is traversable if it does not contain any non-grabbable item.\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for x in range(W):\n      for y in range(H):\n          if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n              traversable_mask[x, y] = False\n  \n  # The agent's starting position must be traversable for a valid path to exist.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return []\n\n  # Find all potential \"target\" states (agent_pos_x, agent_pos_y, agent_dir) from which\n  # a primitive at (px,py) can be collected using the USE action.\n  primitive_target_states = set() # Store as (agent_x, agent_y, agent_dir) for efficient lookup\n  primitive_locations = [] # Store just (primitive_x, primitive_y) for heuristic calculation\n\n  for px in range(W):\n      for py in range(H):\n          if grid[px, py, primitive] > 0:\n              primitive_locations.append((px, py))\n              # For each primitive location, determine the four possible adjacent agent positions\n              # and the required direction for the agent to face the primitive.\n              # (agent_dx, agent_dy) is the relative position from primitive to agent\n              for agent_dx, agent_dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: \n                  ax, ay = px + agent_dx, py + agent_dy\n                  \n                  # Check if this potential agent position is valid and traversable\n                  if not (0 <= ax < W and 0 <= ay < H and traversable_mask[ax, ay]):\n                      continue\n                  \n                  # Determine the direction the agent must face from (ax,ay) to collect (px,py)\n                  # The vector from agent to primitive is (px - ax, py - ay) = (-agent_dx, -agent_dy)\n                  required_agent_dir = -1\n                  for d_val, (delta_x, delta_y) in DIRECTION_TO_DELTA.items():\n                      if delta_x == -agent_dx and delta_y == -agent_dy:\n                          required_agent_dir = d_val\n                          break\n                  \n                  if required_agent_dir != -1:\n                      primitive_target_states.add((ax, ay, required_agent_dir))\n\n  # Heuristic function for A*: Manhattan distance to the closest (positional part of) target state.\n  def heuristic(x, y, direction): # direction is not used in this simple heuristic but kept for signature consistency\n      min_h = float('inf')\n      if not primitive_locations:\n          return min_h # No primitive found, infinite cost\n\n      # Calculate Manhattan distance to the closest primitive location.\n      for px, py in primitive_locations:\n          h_val = abs(x - px) + abs(y - py)\n          min_h = min(min_h, h_val)\n      return min_h\n\n  # A* search data structures\n  # g_score: (pos_x, pos_y, dir) -> cost from start node to current node\n  # f_score: (pos_x, pos_y, dir) -> g_score + heuristic_cost_estimate\n  # came_from: (pos_x, pos_y, dir) -> ((prev_x, prev_y, prev_dir), action_taken)\n  g_score = {} \n  f_score = {} \n  came_from = {} \n\n  start_state_key = (current_pos_x, current_pos_y, initial_dir)\n  g_score[start_state_key] = 0\n  f_score[start_state_key] = heuristic(current_pos_x, current_pos_y, initial_dir)\n\n  # Priority queue: (f_score, g_score, state_key)\n  # The g_score is included for tie-breaking: prefer paths with lower actual cost if f_scores are equal.\n  open_set = [(f_score[start_state_key], g_score[start_state_key], start_state_key)]\n\n  while open_set:\n      # Get the state with the lowest f_score (and lowest g_score for tie-breaking)\n      current_f, current_g_cost, (curr_x, curr_y, curr_dir) = heapq.heappop(open_set)\n\n      # If we've already found a shorter path to this state, skip this one\n      if current_g_cost > g_score.get((curr_x, curr_y, curr_dir), float('inf')):\n          continue\n\n      # Goal check: Is the current state one from which the primitive can be collected?\n      if (curr_x, curr_y, curr_dir) in primitive_target_states:\n          # Reconstruct path and append the USE action\n          path = _reconstruct_path(came_from, (curr_x, curr_y, curr_dir), start_state_key)\n          return path + [USE]\n\n      # Explore possible next states by taking movement actions (UP, DOWN, LEFT, RIGHT)\n      for action_val in [UP, DOWN, LEFT, RIGHT]:\n          # After taking a movement action, the agent's direction changes to match the movement.\n          next_dir = MOVE_ACTION_TO_DIRECTION[action_val]\n          \n          # Calculate the new position based on the new direction (move one step)\n          dx, dy = DIRECTION_TO_DELTA[next_dir]\n          next_x, next_y = curr_x + dx, curr_y + dy\n          \n          # Check if the next cell is within bounds and is traversable\n          if (0 <= next_x < W and 0 <= next_y < H and\n              traversable_mask[next_x, next_y]):\n              \n              new_g_score = current_g_cost + 1 # Each action costs 1\n              next_state_key = (next_x, next_y, next_dir)\n\n              # If this path to next_state is shorter than any previously found path\n              if new_g_score < g_score.get(next_state_key, float('inf')):\n                  g_score[next_state_key] = new_g_score\n                  f_score[next_state_key] = new_g_score + heuristic(next_x, next_y, next_dir)\n                  # Store how we got to next_state_key: from curr_state_key by action_val\n                  came_from[next_state_key] = ((curr_x, curr_y, curr_dir), action_val)\n                  # Add the new state to the priority queue\n                  heapq.heappush(open_set, (f_score[next_state_key], new_g_score, next_state_key))\n\n  # If the open set becomes empty and no path to a primitive was found\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T11:48:59.306948", "function_name": "collect", "function_body": "  from collections import deque\n  import heapq\n\n  # Constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  DIRECTION_TO_DELTA = {\n      DIR_UP: (0, -1),   # (dx, dy)\n      DIR_RIGHT: (1, 0),\n      DIR_DOWN: (0, 1),\n      DIR_LEFT: (-1, 0),\n  }\n\n  MOVE_ACTION_TO_DIRECTION = {\n      UP: DIR_UP,\n      RIGHT: DIR_RIGHT,\n      DOWN: DIR_DOWN,\n      LEFT: DIR_LEFT,\n  }\n\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  initial_dir = np.argmax(obs['features_dict']['direction'])\n\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n\n  W, H, K = grid.shape\n\n  # Optimized traversability mask creation using NumPy vectorization\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for idx in non_grabbable_indices:\n      # Cells containing any non-grabbable item are marked as non-traversable\n      traversable_mask[grid[:, :, idx] > 0] = False\n\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return []\n\n  # Find all potential \"target\" states (agent_pos_x, agent_pos_y, agent_dir) from which\n  # a primitive at (px,py) can be collected using the USE action.\n  primitive_target_states = set()\n  primitive_locations = []\n\n  # Find all locations of the target primitive on the grid\n  primitive_y, primitive_x = np.where(grid[:, :, primitive] > 0)\n  for px, py in zip(primitive_x, primitive_y): # Note: np.where returns (row_indices, col_indices)\n                                                # which corresponds to (y, x) for grid[x,y]\n      primitive_locations.append((px, py))\n      # For each primitive location, determine the four possible adjacent agent positions\n      # and the required direction for the agent to face the primitive.\n      for agent_dx, agent_dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Relative pos from primitive to agent\n          ax, ay = px + agent_dx, py + agent_dy\n          \n          # Check if this potential agent position is valid and traversable\n          if not (0 <= ax < W and 0 <= ay < H and traversable_mask[ax, ay]):\n              continue\n          \n          # Determine the direction the agent must face from (ax,ay) to collect (px,py)\n          # The vector from agent to primitive is (px - ax, py - ay) = (-agent_dx, -agent_dy)\n          required_agent_dir = -1\n          for d_val, (delta_x, delta_y) in DIRECTION_TO_DELTA.items():\n              if delta_x == -agent_dx and delta_y == -agent_dy:\n                  required_agent_dir = d_val\n                  break\n          \n          if required_agent_dir != -1:\n              primitive_target_states.add((ax, ay, required_agent_dir))\n\n  # Heuristic function for A*: Manhattan distance to the closest (positional part of) target state.\n  # This heuristic is admissible because it never overestimates the true cost.\n  def heuristic(x, y, direction):\n      min_h = float('inf')\n      if not primitive_locations:\n          return min_h # No primitive found, infinite cost\n\n      for px, py in primitive_locations:\n          h_val = abs(x - px) + abs(y - py)\n          min_h = min(min_h, h_val)\n      return min_h\n\n  # A* search data structures\n  # g_score: cost from start node to current node\n  # f_score: g_score + heuristic_cost_estimate\n  g_score = {} # (pos_x, pos_y, dir) -> cost\n  f_score = {} # (pos_x, pos_y, dir) -> estimated total cost\n\n  start_state = (current_pos_x, current_pos_y, initial_dir)\n  g_score[start_state] = 0\n  f_score[start_state] = heuristic(current_pos_x, current_pos_y, initial_dir)\n\n  # Priority queue: (f_score, g_score, (pos_x, pos_y, dir), actions_so_far)\n  # g_score is included for tie-breaking in heap if f_scores are equal (prefer shorter paths)\n  open_set = [(f_score[start_state], 0, start_state, [])]\n\n  while open_set:\n      # Get the state with the lowest f_score\n      current_f, current_g, (curr_x, curr_y, curr_dir), actions_so_far = heapq.heappop(open_set)\n\n      # If we've already found a shorter path to this state, skip\n      if current_g > g_score.get((curr_x, curr_y, curr_dir), float('inf')):\n          continue\n\n      # Goal check: Is the current state one from which the primitive can be collected?\n      if (curr_x, curr_y, curr_dir) in primitive_target_states:\n          return actions_so_far + [USE]\n\n      # Explore possible next states by taking movement actions\n      for action_val in [UP, DOWN, LEFT, RIGHT]:\n          # After taking a movement action, the agent's direction changes to match the movement.\n          next_dir = MOVE_ACTION_TO_DIRECTION[action_val]\n          \n          # Calculate the new position based on the new direction (move one step)\n          dx, dy = DIRECTION_TO_DELTA[next_dir]\n          next_x, next_y = curr_x + dx, curr_y + dy\n          \n          # Check if the next cell is within bounds and is traversable\n          if (0 <= next_x < W and 0 <= next_y < H and\n              traversable_mask[next_x, next_y]):\n              \n              new_g_score = current_g + 1 # Each action costs 1\n              next_state = (next_x, next_y, next_dir)\n\n              # If this path to next_state is shorter than any previously found path\n              if new_g_score < g_score.get(next_state, float('inf')):\n                  g_score[next_state] = new_g_score\n                  f_score[next_state] = new_g_score + heuristic(next_x, next_y, next_dir)\n                  heapq.heappush(open_set, (f_score[next_state], new_g_score, next_state, actions_so_far + [action_val]))\n\n  # If the open set becomes empty and no path to a primitive was found\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T11:50:01.867722", "function_name": "collect", "function_body": "  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name.\n  # The `index` method of the Cookbook's Index will add the primitive if it's new.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Pre-checks:\n  #    a. Check if the primitive can be picked up. If not, it cannot be collected via the USE action.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  #    b. Check if the primitive is already in the agent's inventory.\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 3. Retrieve grid dimensions for boundary checks.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # 4. Perform a Breadth-First Search (BFS) to find the shortest sequence of actions\n  #    that leads to a state (position + direction) from which the primitive can be collected.\n  # The BFS state will include: ((current_x, current_y), current_direction, [list_of_actions_taken])\n  # It is crucial to include direction because the USE action applies to the cell *in front* of the agent.\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's initial direction (0-3)\n\n  queue = [(start_pos, start_dir, [])] \n  # `visited` set tracks ((x, y), direction) tuples to avoid redundant exploration and cycles.\n  visited = {(start_pos, start_dir)} \n\n  while queue:\n    # Dequeue the current state: its position, facing direction, and the path to reach it.\n    (curr_x, curr_y), curr_dir, path_actions = queue.pop(0) \n\n    # Calculate the coordinates of the cell directly in front of the agent.\n    # This is the cell that the USE action would interact with.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # Check if the cell in front is within grid bounds and contains the desired primitive.\n    # If true, a valid path is found. Since this is BFS, it's the shortest path.\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      # Append the USE action to the found path and return it.\n      return path_actions + [USE_ACTION]\n    \n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # In CraftWorld, moving in a direction (e.g., UP) also sets the agent's facing direction (UP).\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT.\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # The agent's new direction becomes the direction of movement.\n\n      # Check if the potential next position is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet:\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple) # Mark the new state as visited.\n        # Enqueue the new state along with the updated path.\n        queue.append((next_state_tuple[0], next_state_tuple[1], path_actions + [move_action]))\n\n  # If the BFS queue becomes empty and no path was found, it means the primitive\n  # is currently unreachable from the agent's starting state.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T11:50:02.860534", "function_name": "collect", "function_body": "  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name.\n  # The index method will add the primitive to the cookbook's index if it doesn't already exist.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Improvement over collect_v1: Check if the primitive is grabbable.\n  #    Non-grabbable items (like water or fixed stone) cannot be \"collected\" via USE.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 4. Retrieve grid dimensions for boundary checks.\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a position and orientation from which the primitive can be collected via USE.\n  #    Improvement over collect_v1: BFS state includes both position AND direction,\n  #    which is crucial for correctly determining if a 'USE' action will succeed.\n  # BFS state: ((current_x, current_y), current_direction, [list_of_actions_to_reach_here])\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's initial direction (0-3)\n\n  queue = [(start_pos, start_dir, [])] \n  # Set of visited ((x, y), direction) tuples to prevent cycles and redundant path exploration\n  visited = {(start_pos, start_dir)} \n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.pop(0) # Dequeue for BFS\n\n    # Calculate the coordinates of the cell directly in front of the agent,\n    # which is the target for the USE action.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # Check if the cell in front is within bounds and contains the primitive.\n    # This is the correct goal condition for collecting an item via 'USE'.\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        current_state.grid[target_x, target_y, primitive_idx] > 0):\n      # Found a path where the agent can move to a position, face the primitive,\n      # and then USE to collect it. BFS guarantees this is the shortest path.\n      return path_actions + [USE_ACTION]\n    \n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # A movement action changes the agent's position and its facing direction\n    # to the direction of movement.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement\n\n      # Check if the next position is within the grid boundaries.\n      # Assumption: All grid cells are traversable unless they are outside bounds.\n      # In a more complex scenario, one might need to check if a cell is\n      # blocked by an impassable object (e.g., walls, certain non-grabbable entities).\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple) # Mark the new state as visited\n        # Add the new state and its path to the queue for further exploration\n        queue.append((next_state_tuple[0], next_state_tuple[1], path_actions + [move_action]))\n\n  # If the queue becomes empty and no path was found, it means the primitive\n  # is unreachable from the current state (e.g., not on the map, or surrounded by obstacles).\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T11:51:32.651954", "function_name": "collect", "function_body": "    import collections\n    # Action constants as defined in CraftLab.action_specs()\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Get initial CraftState from the CraftLab environment.\n    # CraftState.step is assumed to return a new, independent CraftState instance,\n    # making BFS state exploration straightforward without needing deep copies at each step.\n    initial_craft_state = env._current_state\n\n    # Initialize BFS queue: (CraftState_instance, list_of_actions_taken_to_reach_this_state)\n    q = collections.deque()\n    \n    # Initialize visited set to keep track of explored states.\n    # A state is uniquely defined by its position, direction, inventory, and grid layout.\n    # NumPy arrays (inventory, grid) must be converted to hashable types (tuples) for set membership.\n    visited = set()\n\n    # Initial state and its hashable key\n    initial_state_key = (\n        initial_craft_state.pos,\n        initial_craft_state.dir,\n        tuple(initial_craft_state.inventory),\n        tuple(initial_craft_state.grid.flatten())\n    )\n    \n    # Add the initial state to the queue and mark as visited\n    q.append((initial_craft_state, [])) # (current_CraftState_object, actions_taken_so_far)\n    visited.add(initial_state_key)\n\n    # All possible actions for exploration\n    all_actions = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n    while q:\n        curr_state, path_actions = q.popleft()\n\n        # Check if the goal (primitive collected) is achieved in the current state.\n        # The goal is achieved if the primitive's count in the inventory is greater than 0.\n        if curr_state.inventory[primitive] > 0:\n            return path_actions\n\n        # Explore possible next states by trying each action\n        for action in all_actions:\n            # Simulate the action. CraftState.step returns (reward, new_state).\n            # The new_state is expected to be a new independent CraftState object,\n            # not a modification of curr_state.\n            _reward, next_state = curr_state.step(action)\n\n            # Create a hashable key for the next state\n            next_state_key = (\n                next_state.pos,\n                next_state.dir,\n                tuple(next_state.inventory),\n                tuple(next_state.grid.flatten())\n            )\n\n            # If this state has not been visited, add it to the queue and visited set\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((next_state, path_actions + [action]))\n\n    # If the queue becomes empty and the goal is not reached,\n    # it implies the primitive is unreachable from the initial state within the search limits.\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:51:32.723915", "function_name": "collect", "function_body": "    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    agent_pos = tuple(obs['features_dict']['pos']) # Convert numpy array to tuple for hashing\n    inventory = obs['features_dict']['inventory']\n\n    # Get action mappings from the environment\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    # Access CraftWorld instance for non-grabbable indices\n    world_config = env.world # CraftWorld instance\n\n    # Check if primitive is already in inventory\n    if inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions (assuming grid.shape is (height, width, kinds))\n    grid_height, grid_width, _ = grid.shape\n\n    # Find all locations of the primitive on the grid\n    primitive_locations = []\n    for r in range(grid_height):\n        for c in range(grid_width):\n            if grid[r, c, primitive] == 1:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        # Primitive not found on the map\n        return []\n\n    # BFS for pathfinding\n    queue = collections.deque()\n    visited = set()\n    parent = {}  # Stores (r, c) -> (prev_r, prev_c) for path reconstruction\n    action_to_reach = {} # Stores (r, c) -> action taken to get there from parent\n\n    # Start BFS from agent's current position\n    queue.append(agent_pos)\n    visited.add(agent_pos)\n    parent[agent_pos] = None\n    action_to_reach[agent_pos] = None\n\n    # Possible moves (dr, dc) and corresponding actions\n    # (dr, dc) corresponds to (delta_row, delta_column)\n    moves = {\n        (-1, 0): ACTION_UP,\n        (1, 0): ACTION_DOWN,\n        (0, -1): ACTION_LEFT,\n        (0, 1): ACTION_RIGHT,\n    }\n\n    target_pos_found = None # The reachable position adjacent to a primitive\n    # target_primitive_pos tracks the specific primitive instance we are moving next to.\n    # Not strictly needed for action sequence, but useful for debugging.\n    # target_primitive_pos = None\n\n    while queue:\n        current_r, current_c = queue.popleft()\n\n        # Check if current position is adjacent (4-directionally) to any primitive location\n        # If yes, this is a potential target for pathfinding\n        for pr, pc in primitive_locations:\n            if (abs(current_r - pr) == 1 and current_c == pc) or \\\n               (abs(current_c - pc) == 1 and current_r == pr):\n                target_pos_found = (current_r, current_c)\n                # target_primitive_pos = (pr, pc)\n                break # Found a target, stop searching for this path\n        if target_pos_found:\n            break # Path found to an adjacent cell, exit BFS\n\n        for dr, dc in moves:\n            next_r, next_c = current_r + dr, current_c + dc\n\n            # Check bounds\n            if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n                continue\n\n            # Check if the cell is blocked (un-traversable)\n            is_blocked = False\n            # 1. Cannot move into the primitive's own cell (assuming it's an object to be picked up from adjacency)\n            if grid[next_r, next_c, primitive] == 1:\n                is_blocked = True\n            else:\n                # 2. Check for other non-grabbable obstacles (e.g., water, stone, if they act as walls)\n                # Iterate through all kinds present at the next cell\n                for k_idx in world_config.non_grabbable_indices:\n                    # If the cell contains a non-grabbable item (that is not our target primitive)\n                    # then it's considered an obstacle.\n                    if k_idx != primitive and grid[next_r, next_c, k_idx] == 1:\n                        is_blocked = True\n                        break # Found an obstacle, this path is blocked\n            \n            if is_blocked:\n                continue\n\n            # If the cell has already been visited, skip it to avoid cycles and redundant paths\n            if (next_r, next_c) in visited:\n                continue\n\n            # Mark as visited and add to queue\n            visited.add((next_r, next_c))\n            parent[(next_r, next_c)] = (current_r, current_c)\n            action_to_reach[(next_r, next_c)] = moves[(dr, dc)]\n            queue.append((next_r, next_c))\n\n    if not target_pos_found:\n        # No path found to any cell adjacent to the primitive\n        return []\n\n    # Reconstruct the path from agent_pos to target_pos_found\n    path = []\n    current = target_pos_found\n    while current != agent_pos:\n        path.append(action_to_reach[current])\n        current = parent[current]\n    path.reverse() # Reverse to get actions in chronological order (from start to target)\n\n    # Add the final USE action to collect the primitive\n    path.append(ACTION_USE)\n\n    return path", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:52:45.334794", "function_name": "collect", "function_body": "  import collections\n\n  # Actions are defined globally in the scope of the problem description\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT).\n  # Moving in a direction also sets the agent's facing direction.\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position).\n  # These vectors represent movement or the \"cell in front\" relative to the agent.\n  DIR_VEC = {\n      0: (0, -1),  # UP\n      1: (1, 0),   # RIGHT\n      2: (0, 1),   # DOWN\n      3: (-1, 0)   # LEFT\n  }\n\n  # Improvement: First, check if the primitive is already in the agent's inventory.\n  # If the agent already possesses the primitive, no actions are needed to collect it from the environment.\n  if env._current_state.inventory[primitive] > 0:\n    return []\n\n  # Pre-check: Verify if the target primitive can actually be collected.\n  # Only items in `grabbable_indices` can be picked up using the 'USE' action.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get initial state information: position, direction, and the full grid.\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction\n\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Identify non-grabbable (obstacle) indices from the world configuration.\n  # These are entities the agent cannot move onto.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to determine if a grid cell is traversable.\n  def is_walkable(x, y):\n    # Check if the coordinates are within the grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n\n    # Check if the cell is occupied by any non-grabbable item (e.g., water, workshop).\n    # If it is, the agent cannot move onto this cell.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False # Cell is blocked by an obstacle\n    return True # Cell is traversable\n\n  # Initialize Breadth-First Search (BFS):\n  # The queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken_so_far).\n  # `collections.deque` is used for efficient `popleft()` operations.\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # A set to keep track of visited states to avoid redundant computations and infinite loops.\n  # A state is defined by (x, y, direction), as the agent's facing direction is critical for the 'USE' action.\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    # Dequeue the current state and its accumulated path.\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the primitive can be collected from the current state.\n    # The 'USE' action targets the cell directly in front of the agent.\n    faced_dx, faced_dy = DIR_VEC[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # If the cell in front is within bounds AND contains the target primitive:\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Goal reached! Return the path with the final 'USE' action appended.\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next movement actions (UP, RIGHT, DOWN, LEFT).\n    # Note: Performing a movement action also updates the agent's facing direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new position and direction after this action.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]] # Movement vector based on action\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # New facing direction is the direction of movement\n\n      # If the next cell is walkable AND this new (position, direction) state\n      # has not been visited, add it to the queue for exploration.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable given the current environment and rules.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:52:46.347154", "function_name": "collect", "function_body": "  import collections\n\n  # Retrieve action mappings dynamically for robustness.\n  # This is an improvement over hardcoded action values, making the code\n  # resilient to potential changes in the environment's action mapping.\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Map movement actions to their corresponding cardinal direction integers.\n  # These direction integers (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) are used to\n  # determine the agent's facing direction after a movement action.\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map cardinal direction integers to their (dx, dy) vector components.\n  # These vectors represent the change in position for movement or the\n  # relative coordinates of the \"cell in front\" of the agent.\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y-coordinate\n      1: (1, 0),   # RIGHT: increases x-coordinate\n      2: (0, 1),   # DOWN: increases y-coordinate\n      3: (-1, 0)   # LEFT: decreases x-coordinate\n  }\n\n  # Pre-check: Verify if the target primitive is actually designated as \"grabbable\".\n  # Only items in `env.world.grabbable_indices` can be picked up by the agent.\n  if primitive not in env.world.grabbable_indices:\n    return [] # Cannot collect this primitive\n\n  # Get the current state details of the environment.\n  # This includes the agent's position, facing direction, and the full grid layout.\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Retrieve indices of entities that cannot be walked on (obstacles) from the world configuration.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Define a helper function to determine if a given grid cell is traversable by the agent.\n  def is_walkable(x, y):\n    # First, check if the coordinates are within the valid grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds means not walkable\n\n    # Then, check if the cell is occupied by any non-grabbable item (e.g., water, workshops).\n    # If an obstacle is present, the cell is not walkable.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False # Cell is blocked by an obstacle\n    return True # Cell is traversable\n\n  # Initialize the Breadth-First Search (BFS) algorithm.\n  # The queue will store tuples: (current_x, current_y, current_direction, list_of_actions_taken_to_reach_here).\n  # `collections.deque` is used for efficient append and pop operations.\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # A set to keep track of visited states. A state is defined by (x, y, direction)\n  # because both position and facing direction are crucial for movement and the 'USE' action.\n  # This prevents redundant computations and infinite loops in cyclic paths.\n  visited = set([(start_x, start_y, start_dir)])\n\n  # Start the BFS traversal.\n  while queue:\n    # Dequeue the current state and its accumulated action path.\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the primitive can be collected from the current state.\n    # The 'USE' action targets the grid cell directly in front of the agent.\n    faced_dx, faced_dy = DIR_VEC[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # If the cell in front is within bounds and contains the target primitive:\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Goal reached! Return the path with the final 'USE' action appended.\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next movement actions (UP, RIGHT, DOWN, LEFT).\n    # Moving in a direction also implicitly sets the agent's facing direction to that direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new position and direction after performing this action.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]] # Movement vector based on action's direction\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # Agent's new facing direction\n\n      # If the calculated next cell is walkable AND this specific (position, direction) state\n      # has not been visited yet, add it to the queue for further exploration.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found,\n  # it indicates that the primitive is unreachable from the current state.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T11:53:49.781801", "function_name": "collect", "function_body": "    actions_taken = []\n    obs = env.reset()  # Ensure a fresh start\n\n    # Constants for actions based on env.action_specs()\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    # Access current state from the environment\n    # This assumes CraftLab._current_state is a CraftState instance\n    current_state = env._current_state\n    \n    # Cache grid dimensions for bounds checking\n    grid_width, grid_height, _ = current_state.grid.shape\n\n    # Get non-grabbable indices from the world configuration\n    # These are entities the agent cannot move into and act as obstacles\n    non_traversable_indices = env.world.non_grabbable_indices\n\n    # Loop for a maximum number of steps to prevent infinite loops.\n    # A generous heuristic to allow for pathfinding and retries.\n    max_collect_steps = env.max_steps * 2 \n    \n    for _ in range(max_collect_steps):\n        current_state = env._current_state  # Get the latest state after any previous action\n        current_inventory = current_state.inventory\n        current_pos = current_state.pos\n        grid = current_state.grid\n\n        # 1. Check if the primitive is already collected\n        if current_inventory[primitive] > 0:\n            return actions_taken\n\n        # 2. Find all locations of the primitive on the grid\n        primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n\n        if not primitive_locations.size:\n            # Primitive not found on the map and not in inventory.\n            # If it's not present, we cannot collect it.\n            return actions_taken\n\n        # Find the closest primitive location using Manhattan distance\n        closest_primitive_loc = None\n        min_dist = float('inf')\n        for loc_array in primitive_locations:\n            loc = tuple(loc_array) # Convert numpy array to tuple for consistency\n            dist = abs(loc[0] - current_pos[0]) + abs(loc[1] - current_pos[1])\n            if dist < min_dist:\n                min_dist = dist\n                closest_primitive_loc = loc\n\n        if closest_primitive_loc is None: # Should not happen if primitive_locations is not empty\n            return actions_taken\n\n        # 3. Check if agent is already next to the primitive; if so, USE it\n        if current_state.next_to(primitive):\n            action_to_take = USE\n        else:\n            # 4. Perform BFS to find the shortest path to a cell adjacent to the primitive\n\n            # Define potential target cells (neighbors of the closest primitive)\n            pr, pc = closest_primitive_loc\n            potential_target_cells = []\n            # Relative coordinates for (Up, Down, Left, Right) from primitive\n            for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: \n                nr, nc = pr + dr, pc + dc\n                # Check boundaries and if the cell is traversable (not occupied by non-grabbable)\n                if (0 <= nr < grid_width and 0 <= nc < grid_height and\n                    not any(grid[nr, nc, k] == 1 for k in non_traversable_indices)):\n                    potential_target_cells.append((nr, nc))\n            \n            if not potential_target_cells:\n                # Primitive is surrounded by non-traversable cells, cannot reach it.\n                return actions_taken\n\n            # BFS queue: (current_position, path_actions_to_reach_here)\n            q = collections.deque([(current_pos, [])]) \n            visited = {current_pos}\n            \n            path_to_adjacent_cell = []\n\n            while q:\n                (r, c), path_actions = q.popleft()\n\n                if (r, c) in potential_target_cells:\n                    path_to_adjacent_cell = path_actions\n                    break\n\n                # Explore neighbors (Up, Down, Left, Right)\n                # Map (delta_row, delta_col) to action constant\n                move_options = [\n                    ((-1, 0), UP),    # Move Up: row decreases\n                    ((1, 0), DOWN),   # Move Down: row increases\n                    ((0, -1), LEFT),  # Move Left: col decreases\n                    ((0, 1), RIGHT)   # Move Right: col increases\n                ]\n\n                for (dr, dc), move_action in move_options:\n                    nr, nc = r + dr, c + dc\n                    # Check boundaries, if not visited, and if traversable\n                    if (0 <= nr < grid_width and 0 <= nc < grid_height and\n                        (nr, nc) not in visited and\n                        not any(grid[nr, nc, k] == 1 for k in non_traversable_indices)):\n                        \n                        visited.add((nr, nc))\n                        q.append(((nr, nc), path_actions + [move_action]))\n            \n            if not path_to_adjacent_cell:\n                # No path found to any adjacent traversable cell of the primitive.\n                # This means it's unreachable in the current state.\n                return actions_taken\n\n            action_to_take = path_to_adjacent_cell[0] # Take the first action on the shortest path\n\n        # Execute the chosen action\n        _, _, _ = env.step(action_to_take) # Reward, done, obs are not needed for this loop's logic\n        actions_taken.append(action_to_take)\n\n    # If the loop finishes (e.g., max_collect_steps reached) and primitive is not collected,\n    # return the actions taken so far.\n    return actions_taken", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:53:50.750758", "function_name": "collect", "function_body": "  # Action constants from CraftLab action_specs()\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Access the current CraftState from the CraftLab environment\n  current_state = env._current_state\n  \n  grid = current_state.grid\n  agent_pos = current_state.pos # (col, row)\n  \n  # Grid dimensions (note: numpy grid shape is (rows, columns, kinds))\n  grid_height, grid_width, _ = grid.shape\n\n  # 1. Find all coordinates (col, row) where the primitive exists on the grid\n  primitive_coords = set()\n  for r in range(grid_height):\n      for c in range(grid_width):\n          if grid[r, c, primitive] > 0:\n              primitive_coords.add((c, r)) # Store as (col, row) for consistency with agent_pos\n  \n  if not primitive_coords:\n      # Primitive not found on the grid, no actions possible\n      return []\n\n  # BFS setup\n  # Queue stores tuples of (current_position (col, row), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([(agent_pos, [])])\n  # Visited set stores positions (col, row) to prevent cycles and redundant exploration\n  visited = {agent_pos}\n\n  # Define delta (dx, dy) for each move action, where dx is change in column, dy is change in row\n  action_deltas = {\n      UP_ACTION: (0, -1),    # (col, row-1)\n      DOWN_ACTION: (0, 1),   # (col, row+1)\n      LEFT_ACTION: (-1, 0),  # (col-1, row)\n      RIGHT_ACTION: (1, 0)   # (col+1, row)\n  }\n\n  # BFS to find the shortest path to a cell adjacent to any primitive location\n  while queue:\n      (cx, cy), actions_so_far = queue.popleft()\n\n      # Check if the current position is adjacent to any of the primitive's locations\n      # A cell (cx, cy) is adjacent to (px, py) if their Chebyshev distance is 1 (max(abs(dx), abs(dy)) == 1)\n      # This covers all 8 neighbors (including diagonals, if allowed for 'next_to').\n      # CraftState.next_to description \"3x3 neighborhood around pos\" usually implies all 8 neighbors.\n      is_adjacent_to_primitive = False\n      for px, py in primitive_coords:\n          if max(abs(cx - px), abs(cy - py)) == 1:\n              is_adjacent_to_primitive = True\n              break\n      \n      if is_adjacent_to_primitive:\n          # Found a path to an adjacent cell, append the USE action and return the full sequence\n          return actions_so_far + [USE_ACTION]\n      \n      # Explore neighbors by trying all possible move actions\n      for action, (dx, dy) in action_deltas.items():\n          nx, ny = cx + dx, cy + dy\n          next_pos = (nx, ny)\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n          \n          # Check if the next position has already been visited\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Add the next position and the updated list of actions to the queue\n              queue.append((next_pos, actions_so_far + [action]))\n                \n  # If the queue becomes empty and no path to an adjacent cell was found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:54:30.605951", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Ensure position is int tuple. CraftState.pos is tuple(int, int)\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  # Current direction is a one-hot array, convert to an integer (0=N, 1=E, 2=S, 3=W)\n  current_dir_one_hot = obs['features_dict']['direction']\n  current_dir = np.argmax(current_dir_one_hot)\n  \n  world = env.world\n  # non_grabbable_indices are assumed to be obstacles that cannot be traversed.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape\n\n  # Action constants\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Map movement action values to (dx, dy) deltas\n  MOVEMENT_DELTAS = {\n      UP_ACTION: (0, -1),   # (dx, dy) for moving UP (North)\n      DOWN_ACTION: (0, 1),  # (dx, dy) for moving DOWN (South)\n      LEFT_ACTION: (-1, 0), # (dx, dy) for moving LEFT (West)\n      RIGHT_ACTION: (1, 0), # (dx, dy) for moving RIGHT (East)\n  }\n\n  # Map movement action values to the resulting agent direction (0=N, 1=E, 2=S, 3=W)\n  # This assumes that taking a movement action makes the agent face that direction.\n  ACTION_TO_DIRECTION = {\n      UP_ACTION: 0,    # UP action results in facing North\n      RIGHT_ACTION: 1, # RIGHT action results in facing East\n      DOWN_ACTION: 2,  # DOWN action results in facing South\n      LEFT_ACTION: 3,  # LEFT action results in facing West\n  }\n\n  # Map (dx, dy) from adjacent cell to target cell to the required agent direction\n  # e.g., if the item is (0,1) relative to the agent's position, the agent must face DOWN (2)\n  RELATIVE_POS_TO_DIRECTION = {\n      (0, -1): 0, # Item is UP relative to agent -> agent must face North\n      (1, 0): 1,  # Item is RIGHT relative to agent -> agent must face East\n      (0, 1): 2,  # Item is DOWN relative to agent -> agent must face South\n      (-1, 0): 3, # Item is LEFT relative to agent -> agent must face West\n  }\n\n  # 1. Determine traversable cells (efficiently using NumPy)\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  is_obstacle_kind = np.isin(np.arange(K), list(non_grabbable_indices))\n  has_obstacle = (grid[:, :, is_obstacle_kind] > 0).any(axis=-1)\n  traversable_mask = ~has_obstacle\n  \n  # Ensure the agent's current position is marked as traversable.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] # Agent starts on an untraversable cell, no path possible.\n\n  # 2. Find all potential (adjacent_pos, required_direction) states\n  # These are the states from which the agent can successfully USE the primitive.\n  target_pickup_states = set() # Stores elements as ((adj_x, adj_y), required_dir)\n  for x_item in range(W):\n      for y_item in range(H):\n          if grid[x_item, y_item, primitive] > 0: # Found the primitive at (x_item, y_item)\n              # Check its 4 cardinal neighbors as potential pickup spots\n              for dx_adj, dy_adj in [ (0, -1), (0, 1), (-1, 0), (1, 0) ]: # Relative positions of neighbors to the item\n                  x_adj, y_adj = x_item + dx_adj, y_item + dy_adj\n                  \n                  if (0 <= x_adj < W and 0 <= y_adj < H and\n                      traversable_mask[x_adj, y_adj]): # Neighbor must be within bounds and traversable\n                      \n                      # Calculate the direction the agent needs to face from (x_adj, y_adj) to (x_item, y_item)\n                      required_dir = RELATIVE_POS_TO_DIRECTION.get((x_item - x_adj, y_item - y_adj))\n                      if required_dir is not None:\n                          target_pickup_states.add(((x_adj, y_adj), required_dir))\n  \n  if not target_pickup_states:\n      return [] # No primitive found or no reachable pickup spots around it\n\n  # 3. Perform BFS to find the shortest sequence of actions to reach any target_pickup_state\n  from collections import deque\n  q = deque([(current_pos, current_dir, [])]) # (current_pos, current_dir, path_actions_so_far)\n  visited = {(current_pos, current_dir)} \n\n  while q:\n      curr_pos, curr_dir, path_so_far = q.popleft()\n\n      # Check if the current state satisfies any of our target pickup states\n      if (curr_pos, curr_dir) in target_pickup_states:\n          return path_so_far + [USE_ACTION] # Path found, append USE and return\n\n      # Explore movement actions (and potential \"turn in place\" actions if move is blocked)\n      for action_val, (dx, dy) in MOVEMENT_DELTAS.items():\n          target_x, target_y = curr_pos[0] + dx, curr_pos[1] + dy\n          potential_next_dir = ACTION_TO_DIRECTION[action_val]\n\n          if (0 <= target_x < W and 0 <= target_y < H and\n              traversable_mask[target_x, target_y]):\n              # This is a valid movement: agent moves to next_pos\n              next_pos = (target_x, target_y)\n              next_dir = potential_next_dir\n              if (next_pos, next_dir) not in visited:\n                  visited.add((next_pos, next_dir))\n                  q.append((next_pos, next_dir, path_so_far + [action_val]))\n          else:\n              # This is a blocked movement: agent stays at curr_pos but its direction might still change.\n              # This allows for \"turning in place\" by attempting a blocked move.\n              next_pos = curr_pos\n              next_dir = potential_next_dir\n              # Only add to queue if the direction actually changes or it's a new (pos, dir) state\n              if (next_pos, next_dir) not in visited:\n                  visited.add((next_pos, next_dir))\n                  q.append((next_pos, next_dir, path_so_far + [action_val]))\n\n  return [] # No path found to a pickup spot", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T11:54:31.580421", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  actions = []\n  \n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  # Current position and direction of the agent\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  current_dir = np.argmax(obs['features_dict']['direction']) # 0=N, 1=E, 2=S, 3=W (North, East, South, West)\n  \n  world = env.world\n  # non_grabbable_indices are assumed to be obstacles that cannot be traversed.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape # Grid dimensions (Width, Height, Kinds)\n\n  # Action constants (from problem description context)\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Map movement action values to (dx, dy) deltas\n  # (dx, dy) for moving: (horizontal change, vertical change)\n  MOVEMENT_DELTAS = {\n      UP_ACTION: (0, -1),   # North: y decreases\n      DOWN_ACTION: (0, 1),  # South: y increases\n      LEFT_ACTION: (-1, 0), # West: x decreases\n      RIGHT_ACTION: (1, 0), # East: x increases\n  }\n\n  # Map movement action values to the resulting agent direction (0=N, 1=E, 2=S, 3=W)\n  # Taking a movement action makes the agent face that direction.\n  ACTION_TO_DIRECTION = {\n      UP_ACTION: 0,    # UP action results in facing North (direction 0)\n      RIGHT_ACTION: 1, # RIGHT action results in facing East (direction 1)\n      DOWN_ACTION: 2,  # DOWN action results in facing South (direction 2)\n      LEFT_ACTION: 3,  # LEFT action results in facing West (direction 3)\n  }\n\n  # Map (dx, dy) from agent's position to item's position to the required agent direction.\n  # For example, if the item is at (agent_x+1, agent_y), the agent needs to face RIGHT (direction 1)\n  RELATIVE_ITEM_TO_AGENT_DIR = {\n      (0, -1): 0, # Item is UP (North) relative to agent -> agent must face North\n      (1, 0): 1,  # Item is RIGHT (East) relative to agent -> agent must face East\n      (0, 1): 2,  # Item is DOWN (South) relative to agent -> agent must face South\n      (-1, 0): 3, # Item is LEFT (West) relative to agent -> agent must face West\n  }\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  # Create a boolean mask indicating which kind indices are non-grabbable obstacles\n  is_obstacle_kind = np.isin(np.arange(K), list(non_grabbable_indices))\n  \n  # For each cell (x, y), check if any of the non-grabbable kinds are present (> 0 count)\n  # This results in a (W, H) boolean array where True means an obstacle is present.\n  has_obstacle = (grid[:, :, is_obstacle_kind] > 0).any(axis=-1)\n  \n  # A cell is traversable if it does NOT have any obstacles\n  traversable_mask = ~has_obstacle\n  \n  # Ensure the agent's current position is marked as traversable.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] # Agent starts on an untraversable cell, no path possible.\n\n  # 2. Identify all valid (adjacent_pos, required_direction) states for a successful pickup.\n  # These are states from which the agent can execute a USE action to collect the primitive.\n  target_pickup_states = set() # Stores elements as ((adj_x, adj_y), required_dir)\n  for x in range(W):\n      for y in range(H):\n          if grid[x, y, primitive] > 0: # Found the primitive at (x,y)\n              # Check its 4 cardinal neighbors as potential pickup spots\n              for dx_adj_rel, dy_adj_rel in MOVEMENT_DELTAS.values(): # Iterate over (dx,dy) for neighbors\n                  adj_x, adj_y = x + dx_adj_rel, y + dy_adj_rel\n                  \n                  # Check if neighbor is within bounds and traversable\n                  if (0 <= adj_x < W and 0 <= adj_y < H and\n                      traversable_mask[adj_x, adj_y]):\n                      \n                      # Calculate the relative position of the primitive FROM the agent's potential position\n                      # (item_x - agent_x, item_y - agent_y)\n                      item_rel_x, item_rel_y = x - adj_x, y - adj_y\n                      required_dir = RELATIVE_ITEM_TO_AGENT_DIR.get((item_rel_x, item_rel_y))\n                      \n                      if required_dir is not None:\n                          target_pickup_states.add(((adj_x, adj_y), required_dir))\n  \n  if not target_pickup_states:\n      return [] # No primitive found on the grid or no reachable pickup spots around it.\n\n  # 3. Perform BFS to find the shortest sequence of actions to reach any target_pickup_state.\n  # Queue stores (current_pos_tuple, current_dir_int, path_actions_list)\n  q = deque([(current_pos, current_dir, [])])\n  # Visited states are (position_tuple, direction_integer) to prevent redundant exploration\n  visited = {(current_pos, current_dir)} \n\n  while q:\n      curr_pos, curr_dir, path_so_far = q.popleft()\n\n      # Check if the current state satisfies any of our target pickup states\n      if (curr_pos, curr_dir) in target_pickup_states:\n          return path_so_far + [USE_ACTION] # Path found, append USE and return\n\n      # Explore all possible movement actions (UP, DOWN, LEFT, RIGHT)\n      for action_val, (delta_x, delta_y) in MOVEMENT_DELTAS.items():\n          # Calculate the intended next direction based on the action (agent turns to face action direction)\n          new_dir = ACTION_TO_DIRECTION[action_val]\n\n          # Calculate the tentative next position if the agent were to move\n          tentative_next_x, tentative_next_y = curr_pos[0] + delta_x, curr_pos[1] + delta_y\n\n          next_pos = None\n          # Check if the tentative next position is valid (in-bounds and traversable)\n          if (0 <= tentative_next_x < W and 0 <= tentative_next_y < H and\n              traversable_mask[tentative_next_x, tentative_next_y]):\n              # If valid, agent moves to this new position\n              next_pos = (tentative_next_x, tentative_next_y)\n          else:\n              # If not valid (e.g., blocked by an obstacle or out of bounds),\n              # agent stays at current position but still changes direction.\n              next_pos = curr_pos\n          \n          next_state = (next_pos, new_dir)\n\n          # If this (position, direction) state has not been visited, add it to the queue\n          if next_state not in visited:\n              visited.add(next_state)\n              q.append((next_pos, new_dir, path_so_far + [action_val]))\n\n  return [] # No path found to a pickup spot", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T11:56:16.280356", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  actions_list = []\n  action_map = env.action_specs()\n\n  # Initial state observation\n  obs = env.observations()\n  inventory = obs['features_dict']['inventory']\n  grid = obs['features_dict']['features_global']\n  \n  # Agent's current position (row, col)\n  pos = tuple(obs['features_dict']['pos'])\n  \n  # Agent's current direction (0:right, 1:up, 2:left, 3:down)\n  # Based on the problem description's example for CraftState, `dir` is an int.\n  # The `features_dict` has `direction` as a one-hot array.\n  current_dir = np.argmax(obs['features_dict']['direction'])\n\n  # Check if primitive is already collected\n  if inventory[primitive] > 0:\n      return []\n\n  # Determine grid dimensions\n  grid_rows, grid_cols, _ = grid.shape\n\n  # Helper function to check if coordinates are within grid boundaries\n  def _is_valid_coord(r, c):\n      return 0 <= r < grid_rows and 0 <= c < grid_cols\n\n  # Helper function to get the coordinates of the cell directly in front of the agent\n  # based on current position (r, c) and direction (d)\n  def _get_facing_coords(r, c, direction):\n      if direction == 0: return (r, c + 1) # Right\n      if direction == 1: return (r - 1, c) # Up\n      if direction == 2: return (r, c - 1) # Left\n      if direction == 3: return (r + 1, c) # Down\n      return None\n\n  # Find all locations of the primitive on the grid\n  primitive_locations = set()\n  for r in range(grid_rows):\n      for c in range(grid_cols):\n          if grid[r, c, primitive] == 1: # Assuming 1 indicates presence of the kind\n              primitive_locations.add((r, c))\n\n  if not primitive_locations:\n      # Primitive not found anywhere on the map\n      return []\n\n  # Define movement actions and their effects on (row, col)\n  # These are absolute grid movements\n  MOVE_ACTIONS = {\n      action_map['UP']: (-1, 0),    # Change in row, change in col for UP action\n      action_map['DOWN']: (1, 0),   # Change in row, change in col for DOWN action\n      action_map['LEFT']: (0, -1),  # Change in row, change in col for LEFT action\n      action_map['RIGHT']: (0, 1),  # Change in row, change in col for RIGHT action\n  }\n\n  # Identify all target positions where the agent, with its *fixed* `current_dir`,\n  # can stand to `USE` a primitive.\n  collectable_adjacent_positions = set()\n  for pr, pc in primitive_locations:\n      # Iterate over all 4 directions relative to the primitive to find an agent position\n      # that would allow facing the primitive.\n      # (dr_adj, dc_adj) are deltas for agent pos relative to primitive pos to face it.\n      # e.g., if primitive at (pr, pc) and agent wants to face RIGHT (dir=0) at (pr, pc-1)\n      # Then agent pos is (pr, pc-1), (dr,dc) to primitive is (0,1).\n      \n      # For each possible relative position of the agent (e.g., to the left of primitive),\n      # determine what direction the agent would need to be facing to see the primitive.\n      # If that required direction matches the agent's current_dir, then this agent position is a valid target.\n      \n      # Check agent position to the LEFT of primitive, facing RIGHT\n      agent_r, agent_c = pr, pc - 1\n      if _is_valid_coord(agent_r, agent_c) and current_dir == 0: # Agent faces Right to collect\n          collectable_adjacent_positions.add((agent_r, agent_c))\n\n      # Check agent position BELOW primitive, facing UP\n      agent_r, agent_c = pr + 1, pc\n      if _is_valid_coord(agent_r, agent_c) and current_dir == 1: # Agent faces Up to collect\n          collectable_adjacent_positions.add((agent_r, agent_c))\n\n      # Check agent position to the RIGHT of primitive, facing LEFT\n      agent_r, agent_c = pr, pc + 1\n      if _is_valid_coord(agent_r, agent_c) and current_dir == 2: # Agent faces Left to collect\n          collectable_adjacent_positions.add((agent_r, agent_c))\n\n      # Check agent position ABOVE primitive, facing DOWN\n      agent_r, agent_c = pr - 1, pc\n      if _is_valid_coord(agent_r, agent_c) and current_dir == 3: # Agent faces Down to collect\n          collectable_adjacent_positions.add((agent_r, agent_c))\n\n  if not collectable_adjacent_positions:\n      # No primitive is collectable from any position with the agent's current fixed direction\n      return []\n\n  # BFS to find the shortest path from the agent's current position to any collectable_adjacent_position\n  queue = collections.deque([(pos[0], pos[1], [])]) # (row, col, list_of_actions)\n  visited = set([(pos[0], pos[1])]) # Visited positions\n\n  while queue:\n      r, c, current_path = queue.popleft()\n\n      # If current position is one of the target collectable positions\n      if (r, c) in collectable_adjacent_positions:\n          # Agent has reached a position from which it can collect the primitive\n          return current_path + [action_map['USE']]\n\n      # Explore neighbor cells by moving (UP, DOWN, LEFT, RIGHT)\n      for move_action, (dr, dc) in MOVE_ACTIONS.items():\n          new_r, new_c = r + dr, c + dc\n          if _is_valid_coord(new_r, new_c):\n              new_pos_tuple = (new_r, new_c)\n              if new_pos_tuple not in visited:\n                  visited.add(new_pos_tuple)\n                  queue.append((new_r, new_c, current_path + [move_action]))\n\n  # If the BFS completes and no path is found to a collectable position\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:56:17.280705", "function_name": "collect", "function_body": "  # Action constants, derived from CraftLab.action_specs\n  # In a full system, these would likely be imported from a shared constants module.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # 1. Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  start_pos = tuple(obs['features_dict']['pos']) # (row, col)\n  inventory = obs['features_dict']['inventory']\n\n  world = env.world # Reference to the CraftWorld instance\n\n  # Get grid dimensions\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # 2. Check Inventory: If primitive is already collected, return empty path\n  if inventory[primitive] > 0:\n    return []\n\n  # Determine if the primitive is grabbable or non-grabbable\n  is_grabbable = primitive in world.grabbable_indices\n  is_non_grabbable = primitive in world.non_grabbable_indices\n\n  # If the primitive is not something that can be collected from the world (e.g., a crafted item)\n  if not is_grabbable and not is_non_grabbable:\n    return []\n\n  # 3. Find Primitive Location(s) on the grid\n  primitive_locations = []\n  for r in range(GRID_ROWS):\n    for c in range(GRID_COLS):\n      if grid[r, c, primitive] > 0:\n        primitive_locations.append((r, c))\n\n  if not primitive_locations:\n    return [] # Primitive not found anywhere in the world\n\n  # 4. Determine Agent's Target Cells for Pathfinding\n  # This is where the agent needs to be positioned to \"collect\" the primitive.\n  target_cells = set()\n  if is_grabbable:\n    # If grabbable, the agent must move directly onto the primitive's cell.\n    target_cells.update(primitive_locations)\n  elif is_non_grabbable:\n    # If non-grabbable, the agent must move to a cell adjacent to the primitive's cell.\n    for pr, pc in primitive_locations:\n      for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Up, Down, Left, Right relative moves\n        nr, nc = pr + dr, pc + dc\n        # Check bounds for neighbor cell\n        if 0 <= nr < GRID_ROWS and 0 <= nc < GRID_COLS:\n          target_cells.add((nr, nc))\n\n  if not target_cells:\n    return [] # No reachable target cells (e.g., non-grabbable item completely surrounded)\n\n  # 5. BFS Pathfinding\n  q = collections.deque([(start_pos, [])]) # Queue: (current_position, list_of_actions_to_reach_here)\n  visited = {start_pos} # Set of visited positions to avoid cycles and redundant paths\n\n  # Map (dr, dc) to action constant\n  move_actions_map = {\n      (-1, 0): UP,    # Move up (row - 1)\n      (1, 0): DOWN,   # Move down (row + 1)\n      (0, -1): LEFT,  # Move left (col - 1)\n      (0, 1): RIGHT,  # Move right (col + 1)\n  }\n\n  # Pre-calculate set of all non-grabbable indices that are NOT the target primitive\n  # These act as obstacles for movement.\n  obstacle_indices = {k for k in world.non_grabbable_indices if k != primitive}\n\n  while q:\n    (r, c), path = q.popleft()\n\n    # If the current position is one of the target cells\n    if (r, c) in target_cells:\n      # If the primitive is non-grabbable, we need to append a USE action.\n      # We must ensure that a primitive actually exists next to our current (r,c) to use.\n      if is_non_grabbable:\n        # Check if any neighbor cell contains the primitive we are trying to use\n        is_actually_adjacent_to_primitive = False\n        for dr_adj, dc_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nr_adj, nc_adj = r + dr_adj, c + dc_adj\n            if (0 <= nr_adj < GRID_ROWS and 0 <= nc_adj < GRID_COLS and\n                grid[nr_adj, nc_adj, primitive] > 0):\n                is_actually_adjacent_to_primitive = True\n                break\n        if is_actually_adjacent_to_primitive:\n            return path + [USE]\n        # If not actually adjacent to the primitive we want, this target_cell isn't good enough, continue BFS\n      else: # Grabbable primitive\n        # For grabbable items, reaching the cell means collection. No explicit USE action needed.\n        return path\n\n    # Explore neighbors\n    for move_dr, move_dc in move_actions_map:\n      nr, nc = r + move_dr, c + move_dc\n      action = move_actions_map[(move_dr, move_dc)]\n\n      # Check bounds and if already visited\n      if (0 <= nr < GRID_ROWS and 0 <= nc < GRID_COLS) and ((nr, nc) not in visited):\n\n        # Check traversability for the new cell (nr, nc)\n        is_traversable = True\n        \n        # Rule 1: Cannot move onto non-grabbable target primitive itself\n        if is_non_grabbable and grid[nr, nc, primitive] > 0:\n            is_traversable = False\n        \n        # Rule 2: Cannot move onto any other non-grabbable item (obstacles)\n        if is_traversable: # Only check if not already ruled out by Rule 1\n            for k_obstacle in obstacle_indices:\n                if grid[nr, nc, k_obstacle] > 0:\n                    is_traversable = False\n                    break\n        \n        if is_traversable:\n          visited.add((nr, nc))\n          q.append(((nr, nc), path + [action]))\n\n  return [] # No path found to any target cell", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:57:54.725576", "function_name": "collect", "function_body": "  actions = []\n  MAX_STEPS = 200  # A reasonable safety limit to prevent infinite loops\n\n  action_map = env.action_specs()\n  _DOWN, _UP, _LEFT, _RIGHT, _USE = (\n      action_map['DOWN'], action_map['UP'], action_map['LEFT'],\n      action_map['RIGHT'], action_map['USE']\n  )\n\n  # Directions for facing (as per CraftState.dir):\n  # 0: East (+X), 1: South (+Y), 2: West (-X), 3: North (-Y)\n\n  for step_count in range(MAX_STEPS):\n    current_state = env._current_state\n\n    # 1. Check if primitive is already collected\n    if current_state.inventory[primitive] > 0:\n      return actions\n\n    # 2. Try to USE the primitive if it's an orthogonal neighbor\n    cx, cy = current_state.pos\n    grid = current_state.grid\n\n    target_face_dir = -1\n\n    # Define candidate orthogonal cells and their corresponding facing directions\n    # Check East, West, South, North neighbors\n    ortho_candidates = [\n        (cx + 1, cy, 0),  # East\n        (cx - 1, cy, 2),  # West\n        (cx, cy + 1, 1),  # South\n        (cx, cy - 1, 3)  # North\n    ]\n\n    for nx, ny, required_dir in ortho_candidates:\n      # Check bounds and if the cell contains the primitive\n      if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and grid[nx, ny, primitive] == 1:\n        target_face_dir = required_dir\n        break  # Found an orthogonal neighbor with the primitive\n\n    if target_face_dir != -1:  # Primitive is an orthogonal neighbor\n      # Turn to face it\n      while current_state.dir != target_face_dir:\n        env.step(_RIGHT)  # Rotate clockwise until facing the target\n        actions.append(_RIGHT)\n        current_state = env._current_state  # Update state after turn\n        if len(actions) > MAX_STEPS:  # Safety break for turning\n          return []\n\n      # Now agent should be facing the primitive, attempt USE\n      env.step(_USE)\n      actions.append(_USE)\n\n      # Check if collected after USE. If so, return.\n      if env._current_state.inventory[primitive] > 0:\n        return actions\n      # If USE didn't work (e.g., ungrabbable, or already collected),\n      # the loop continues to re-evaluate, potentially moving to another instance.\n      # No 'else' return here to allow continued search if USE failed on this spot.\n\n    # 3. Find the primitive's location on the global grid\n    # Refresh current_state after potential USE attempt or previous moves\n    current_state = env._current_state\n    cx, cy = current_state.pos\n\n    global_grid = env.observations()['features_dict']['features_global']\n    grid_width, grid_height, _ = global_grid.shape\n\n    target_x, target_y = -1, -1\n    min_dist = float('inf')\n\n    # Find the closest instance of the primitive on the grid using Manhattan distance\n    for x_idx in range(grid_width):\n      for y_idx in range(grid_height):\n        if global_grid[x_idx, y_idx, primitive] == 1:\n          dist = abs(x_idx - cx) + abs(y_idx - cy)\n          if dist < min_dist:\n            min_dist = dist\n            target_x, target_y = x_idx, y_idx\n\n    if target_x == -1 and target_y == -1:\n      # Primitive not found anywhere on the map, cannot collect\n      return actions  # Return actions taken so far (possibly empty)\n\n    # If the agent is already at the target_x, target_y but hasn't collected,\n    # it implies the USE action was attempted and failed, or it's not directly collectable.\n    # No further movement actions will help for this specific instance.\n    if cx == target_x and cy == target_y:\n      return actions\n\n    # 4. Determine the best move to reduce Manhattan distance\n    dx = target_x - cx\n    dy = target_y - cy\n\n    move_action_candidates = []\n    # Prioritize movement along the larger absolute difference (reducing the dominant distance first)\n    if abs(dx) >= abs(dy):\n      if dx > 0:\n        move_action_candidates.append(_RIGHT)\n      elif dx < 0:\n        move_action_candidates.append(_LEFT)\n      # If dx is 0, still consider dy\n      if dy > 0:\n        move_action_candidates.append(_DOWN)\n      elif dy < 0:\n        move_action_candidates.append(_UP)\n    else:  # abs(dy) > abs(dx)\n      if dy > 0:\n        move_action_candidates.append(_DOWN)\n      elif dy < 0:\n        move_action_candidates.append(_UP)\n      # If dy is 0, still consider dx\n      if dx > 0:\n        move_action_candidates.append(_RIGHT)\n      elif dx < 0:\n        move_action_candidates.append(_LEFT)\n\n    if not move_action_candidates:\n      # Should not happen if cx != target_x or cy != target_y\n      return actions\n\n    original_pos = current_state.pos\n    moved_in_this_step = False\n\n    # Try moves in order of preference\n    for move_action in move_action_candidates:\n      env.step(move_action)\n      actions.append(move_action)\n\n      if env._current_state.pos != original_pos:\n        moved_in_this_step = True\n        break  # Successfully moved, proceed to next iteration\n      else:\n        # If didn't move (hit a wall or obstacle), revert action and try next candidate\n        actions.pop()  # Remove the failed action\n\n    if not moved_in_this_step:\n      # Agent is stuck or cannot reach the target (e.g., completely surrounded by impassable terrain)\n      return actions  # Cannot reach, give up.\n\n  return actions  # Max steps reached without collecting the primitive", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:57:54.795118", "function_name": "collect", "function_body": "    import collections\n\n    # Define action constants based on the problem description (action_specs)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Map movement actions to their delta row, delta column changes for agent's position\n    # These reflect how the agent's (r, c) coordinates change with each move action.\n    ACTION_DELTAS = {\n        UP: (-1, 0),    # Moving UP decreases row index\n        DOWN: (1, 0),   # Moving DOWN increases row index\n        LEFT: (0, -1),  # Moving LEFT decreases column index\n        RIGHT: (0, 1)   # Moving RIGHT increases column index\n    }\n\n    # Map movement actions to the direction the agent will face after the move.\n    # This is inferred: moving UP means the agent ends up facing UP (dir 0), etc.\n    # This aligns with CraftState._DIR_TO_DELTA where 0:UP, 1:DOWN, 2:LEFT, 3:RIGHT\n    ACTION_TO_DIR = {\n        UP: 0,\n        DOWN: 1,\n        LEFT: 2,\n        RIGHT: 3\n    }\n\n    # Map internal direction index to its delta row, delta column for the 'USE' action.\n    # This determines what cell is \"in front\" of the agent for interaction.\n    # This mapping is explicitly provided in the CraftState description.\n    _DIR_TO_DELTA = {\n        0: (-1, 0),  # Facing UP\n        1: (1, 0),   # Facing DOWN\n        2: (0, -1),  # Facing LEFT\n        3: (0, 1)    # Facing RIGHT\n    }\n\n    current_state = env._current_state\n    grid = current_state.grid\n    start_r, start_c = current_state.pos\n    start_dir = current_state.dir # Agent's current facing direction\n\n    width, height, _ = grid.shape\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # If the primitive is already in inventory, no actions needed.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # BFS state tuple: (row, col, current_direction, list_of_actions_taken_to_reach_here)\n    queue = collections.deque([(start_r, start_c, start_dir, [])])\n\n    # Visited set: (row, col, direction) to avoid redundant computations and cycles.\n    visited = set([(start_r, start_c, start_dir)])\n\n    # List of all possible movement actions (UP, DOWN, LEFT, RIGHT)\n    movement_actions = [UP, DOWN, LEFT, RIGHT]\n\n    while queue:\n        r, c, current_dir, actions_taken = queue.popleft()\n\n        # Check if the agent is in a position to USE the primitive:\n        # It must be adjacent to the primitive AND facing it.\n        dr_face, dc_face = _DIR_TO_DELTA[current_dir]\n        target_r, target_c = r + dr_face, c + dc_face\n\n        # Check bounds for the cell the agent is facing\n        if (0 <= target_r < width and 0 <= target_c < height and\n            grid[target_r, target_c, primitive] > 0):\n            # If the cell in front contains the primitive, we are ready to USE it.\n            return actions_taken + [USE]\n\n        # Explore possible next states by taking movement actions\n        for action in movement_actions:\n            dr_move, dc_move = ACTION_DELTAS[action]\n            next_r, next_c = r + dr_move, c + dc_move\n            next_dir = ACTION_TO_DIR[action] # The new direction after this move\n\n            # Check if the proposed next position is within grid boundaries\n            if not (0 <= next_r < width and 0 <= next_c < height):\n                continue\n\n            # Check if the proposed next position is an obstacle (contains a non-grabbable entity)\n            is_obstacle = False\n            for ng_idx in non_grabbable_indices:\n                if grid[next_r, next_c, ng_idx] > 0:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n\n            # If this specific state (position AND direction) has not been visited yet\n            if (next_r, next_c, next_dir) not in visited:\n                visited.add((next_r, next_c, next_dir))\n                queue.append((next_r, next_c, next_dir, actions_taken + [action]))\n\n    # If the BFS completes and no path to collect the primitive is found\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:59:23.689168", "function_name": "collect", "function_body": "    MAX_STEPS = 200 # Maximum number of steps to attempt collection\n    \n    actions_taken = []\n    action_map = env.action_specs() # Get the mapping of action names to integer IDs\n    \n    # Initialize the environment to a fresh state for the collection task\n    obs = env.reset()\n\n    # Define movement actions (excluding USE) for random exploration/unsticking\n    movement_actions = [action_map[k] for k in [\"DOWN\", \"UP\", \"LEFT\", \"RIGHT\"]]\n\n    # Loop until the primitive is collected (inventory count > 0) or max steps are reached\n    while obs[\"features_dict\"][\"inventory\"][primitive] == 0 and len(actions_taken) < MAX_STEPS:\n        current_craft_state = env._current_state # Access the internal CraftState instance\n\n        # 1. Check if the primitive is in the 3x3 neighborhood and is grabbable\n        if current_craft_state.next_to(primitive) and primitive in env.world.grabbable_indices:\n            action_to_take = action_map[\"USE\"]\n        else:\n            # 2. Primitive is not next to agent, so plan movement.\n            # Find the closest instance of the primitive on the global grid.\n            grid = obs[\"features_dict\"][\"features_global\"]\n            agent_x, agent_y = current_craft_state.pos # Agent's actual grid position (int, int)\n            \n            target_pos = None\n            min_dist_sq = float('inf')\n\n            # Iterate over the grid to find all occurrences of the primitive and pick the closest\n            width, height, _ = grid.shape\n            for x in range(width):\n                for y in range(height):\n                    # Check if the primitive kind is present at this cell\n                    if grid[x, y, primitive] > 0: \n                        dist_sq = (x - agent_x)**2 + (y - agent_y)**2\n                        if dist_sq < min_dist_sq:\n                            min_dist_sq = dist_sq\n                            target_pos = (x, y)\n            \n            chosen_movement_action = None\n            if target_pos:\n                # Calculate the difference vector to the target\n                target_x, target_y = target_pos\n                dx = target_x - agent_x\n                dy = target_y - agent_y\n\n                # Prioritize movement along the axis with the largest absolute difference\n                # This is a greedy approach that doesn't guarantee optimal path but works for simple cases.\n                if abs(dx) > abs(dy):\n                    if dx > 0: chosen_movement_action = action_map[\"RIGHT\"]\n                    elif dx < 0: chosen_movement_action = action_map[\"LEFT\"]\n                \n                # If no horizontal move was determined (e.g., dx=0) or if vertical difference is larger/equal\n                # (or if horizontal move was chosen but led to no actual movement, implying a block, in which case the agent might get stuck trying again without this branch)\n                if chosen_movement_action is None: \n                    if dy > 0: chosen_movement_action = action_map[\"DOWN\"]\n                    elif dy < 0: chosen_movement_action = action_map[\"UP\"]\n\n                # Fallback: If agent is at target (dx=0, dy=0) but primitive is not yet collected.\n                # This situation implies `next_to` didn't trigger `USE` for some reason (e.g., not grabbable directly\n                # at agent's exact spot, or a logic edge case). As a last resort to unstick or explore if logic fails:\n                if chosen_movement_action is None:\n                    chosen_movement_action = np.random.choice(movement_actions)\n            else:\n                # Primitive not found anywhere on the current grid (e.g., exhausted, not spawned yet, or too far).\n                # In this case, perform a random movement to explore the environment.\n                chosen_movement_action = np.random.choice(movement_actions)\n            \n            action_to_take = chosen_movement_action\n\n        # Execute the chosen action and update the environment state\n        # The step returns reward, done status, and new observations\n        _, _, obs = env.step(action_to_take)\n        actions_taken.append(action_to_take)\n    \n    return actions_taken", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:59:23.758911", "function_name": "collect", "function_body": "    # Define action constants based on CraftLab.action_specs()\n    DOWN, UP, LEFT, RIGHT, USE = range(5)\n    MOVEMENT_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n    initial_state = env._current_state\n\n    # 1. Initial check: If the primitive is already in inventory, no actions are needed.\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    # Determine if the primitive is a grabbable item (collected by moving onto it)\n    # or a workshop/crafting station (collected by using it while adjacent).\n    is_grabbable = primitive in env.world.grabbable_indices\n    is_workshop = primitive in env.world.workshop_indices\n\n    # BFS Queue: stores tuples of (current_CraftState_object, list_of_actions_to_reach_this_state)\n    q = collections.deque([(initial_state, [])])\n\n    # Visited set: stores (agent_position_tuple, agent_direction_int) to avoid redundant exploration\n    # This assumes that the grid state doesn't fundamentally change for pathfinding\n    # beyond the collection of the target primitive.\n    visited = set([(initial_state.pos, initial_state.dir)])\n\n    # Maximum number of steps to search to prevent extremely long or infinite loops\n    # for unreachable goals or very large maps.\n    MAX_SEARCH_STEPS = 200\n\n    while q:\n        current_state, current_path = q.popleft()\n\n        # Prune paths that exceed the maximum allowed search steps\n        if len(current_path) >= MAX_SEARCH_STEPS:\n            continue\n\n        # 2. Goal Check: If the primitive is now in inventory, we have found a valid sequence of actions.\n        # This covers cases where a grabbable item was collected by the last movement action.\n        if current_state.inventory[primitive] > 0:\n            return current_path\n\n        # 3. Handle 'USE' action for workshops:\n        # If the primitive is a workshop type AND the agent is currently next to it, try using it.\n        if is_workshop and current_state.next_to(primitive):\n            # Simulate performing the USE action from the current state.\n            # `step` returns (reward, new_state). We only care about the new_state.\n            _, state_after_use = current_state.step(USE)\n            \n            # If using the workshop resulted in collecting the primitive, we're done.\n            if state_after_use.inventory[primitive] > 0:\n                return current_path + [USE]\n            # If 'USE' didn't yield the primitive (e.g., wrong facing if required, or missing\n            # other ingredients for a recipe not handled by this function's scope),\n            # we simply continue searching for other movement paths.\n\n        # 4. Explore movement actions:\n        # For each possible movement action (DOWN, UP, LEFT, RIGHT), simulate its effect.\n        for action in MOVEMENT_ACTIONS:\n            # Simulate the action to get the next state.\n            _, next_state = current_state.step(action)\n            next_pos = next_state.pos\n            next_dir = next_state.dir # Agent's direction might not change for these actions, but included for generality.\n\n            # Create a unique key for the next state (position and direction) for the visited set.\n            state_key = (next_pos, next_dir)\n\n            # If this specific state (position and direction) has not been visited yet\n            # (or visited via a longer path, which BFS inherently handles by popping shorter paths first).\n            if state_key not in visited:\n                visited.add(state_key)      # Mark the state as visited.\n                new_path = current_path + [action] # Extend the sequence of actions.\n                q.append((next_state, new_path)) # Add the new state and its path to the queue for further exploration.\n\n                # Immediate check for grabbable items:\n                # If the primitive is a grabbable item, moving onto its cell should typically collect it.\n                # Check if it was collected immediately after the movement action.\n                if is_grabbable and next_state.inventory[primitive] > 0:\n                    return new_path # Found the item by moving onto it.\n\n    # If the BFS queue is exhausted and no path was found (e.g., item is unreachable or not on map),\n    # return an empty list indicating no solution.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:00:00.700650", "function_name": "collect", "function_body": "  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name\n  # The index method will add the primitive to the cookbook's index if it doesn't already exist.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable\n  if primitive_idx not in env.world.grabbable_indices:\n    # This primitive cannot be picked up (e.g., water, stone if not grabbable),\n    # so \"collecting\" it via USE is not possible.\n    return []\n\n  # 3. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 4. Retrieve grid dimensions and define impassable kinds\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # Define what constitutes an impassable object on the grid for movement.\n  # This includes non-grabbable entities and workshop locations.\n  impassable_kinds = env.world.non_grabbable_indices.union(set(env.world.workshop_indices))\n\n  # Helper function to check if a cell is walkable\n  def is_cell_walkable(x, y, current_grid, impassable_set, width, height):\n      # First, check if the cell is within grid boundaries\n      if not (0 <= x < width and 0 <= y < height):\n          return False \n      \n      # Then, check if the cell (x,y) contains any object that is considered impassable\n      for k_idx in impassable_set:\n          if current_grid[x, y, k_idx] > 0:\n              return False \n      return True\n\n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a position and orientation from which the primitive can be collected via USE.\n  # BFS state: ((current_x, current_y), current_direction)\n  # visited: {state_tuple: (parent_state_tuple, action_taken_to_reach_state)}\n  from collections import deque\n  queue = deque()\n  visited = {} # Stores ((parent_x, parent_y), parent_dir): action_from_parent\n\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  start_state_tuple = (start_pos, start_dir)\n\n  queue.append(start_state_tuple)\n  visited[start_state_tuple] = (None, None) # No parent for the start state\n\n  target_reached_state = None # To store the state from which USE can be applied\n\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.popleft() # Dequeue for BFS\n\n    # Check if the current state allows for immediate USE action on the primitive.\n    # Calculate the coordinates of the cell directly in front of the agent.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # Check if the cell in front is within bounds and contains the primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      # Found a state where the agent can perform USE to collect the primitive.\n      target_reached_state = ((curr_x, curr_y), curr_dir)\n      break # Path found, exit BFS loop\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement\n\n      # Check if the next position is within the grid boundaries AND is walkable.\n      if not is_cell_walkable(next_x, next_y, grid, impassable_kinds, grid_width, grid_height):\n        continue # Cannot move to this cell (obstacle or out of bounds)\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet\n      if next_state_tuple not in visited:\n        visited[next_state_tuple] = ((curr_x, curr_y), curr_dir), move_action\n        queue.append(next_state_tuple)\n\n  if target_reached_state is None:\n    return [] # If the queue becomes empty and no path was found, the primitive is unreachable.\n\n  # Reconstruct the path by backtracking from the target_reached_state to the start_state\n  path_actions = []\n  current_reconstruction_state = target_reached_state\n  \n  # Loop until we reach the starting state, which has (None, None) as its parent info\n  while visited[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = visited[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  # The path was built in reverse order, so reverse it to get the correct sequence\n  path_actions.reverse()\n  \n  # Add the final USE action to the collected path\n  return path_actions + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:00:01.688643", "function_name": "collect", "function_body": "  import collections # Using collections.deque for efficient queue operations in BFS\n\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # 3. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 4. Retrieve grid dimensions and define impassable kinds\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # IMPROVEMENT for collect_v2: Define impassable cells more accurately.\n  # Cells containing non-grabbable items OR workshop locations are impassable.\n  impassable_kinds = env.world.non_grabbable_indices.union(set(env.world.workshop_indices))\n\n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a position and orientation from which the primitive can be collected via USE.\n  # BFS state: ((current_x, current_y), current_direction, [list_of_actions_to_reach_here])\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  queue = collections.deque([(start_pos, start_dir, [])]) \n  \n  # Set of visited ((x, y), direction) tuples to prevent cycles and redundant path exploration\n  visited = {(start_pos, start_dir)} \n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.popleft() # Dequeue for BFS\n\n    # Calculate the coordinates of the cell directly in front of the agent,\n    # which is the target for the USE action.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # Check if the cell in front is within bounds and contains the primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      # Found a path where the agent can move to a position, face the primitive,\n      # and then USE to collect it.\n      return path_actions + [USE_ACTION]\n    \n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # A movement action changes the agent's position and its facing direction.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position is impassable (contains any item from the combined impassable_kinds set).\n      is_impassable = False\n      for k_idx in impassable_kinds:\n        if grid[next_x, next_y, k_idx] > 0:\n          is_impassable = True\n          break\n      if is_impassable:\n        continue\n      \n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple) # Mark the new state as visited\n        # Add the new state and its path to the queue for further exploration\n        queue.append((next_state_tuple[0], next_state_tuple[1], path_actions + [move_action]))\n\n  # If the queue becomes empty and no path was found, it means the primitive\n  # is unreachable from the current state.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:01:17.796588", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Access the current state from the CraftLab environment\n    state = env._current_state\n    grid = state.grid\n    current_pos = state.pos\n    grid_width, grid_height, n_kinds = grid.shape # grid is (WIDTH, HEIGHT, n_kinds)\n\n    # Define action constants based on CraftLab's action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Map movement actions to (dx, dy) coordinate changes\n    # (dx, dy) for (X-coordinate change, Y-coordinate change)\n    ACTION_DELTAS = {\n        ACTION_UP: (0, -1),\n        ACTION_DOWN: (0, 1),\n        ACTION_LEFT: (-1, 0),\n        ACTION_RIGHT: (1, 0),\n    }\n    MOVE_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]\n\n    # Identify obstacle kinds (non-grabbable entities)\n    # These are cells the agent generally cannot move onto.\n    obstacle_kinds = state.world.non_grabbable_indices\n\n    # 1. Find all locations of the primitive on the grid\n    primitive_locations = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if grid[x, y, primitive] == 1:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the grid\n\n    # 2. Find the closest primitive location to the agent\n    # If multiple instances of the primitive exist, prioritize the nearest one.\n    closest_primitive_pos = None\n    min_dist = float('inf')\n    for p_loc in primitive_locations:\n        dist = abs(p_loc[0] - current_pos[0]) + abs(p_loc[1] - current_pos[1]) # Manhattan distance\n        if dist < min_dist:\n            min_dist = dist\n            closest_primitive_pos = p_loc\n\n    if closest_primitive_pos is None: # Should not happen if primitive_locations is not empty\n        return []\n\n    target_x, target_y = closest_primitive_pos\n\n    # 3. Determine potential adjacent cells for the agent to stand on\n    # The agent needs to move to an adjacent cell to effectively USE the primitive.\n    potential_agent_targets = []\n    # Check 4 direct neighbors: Right, Left, Down, Up\n    for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n        nx, ny = target_x + dx, target_y + dy\n\n        # Check if the potential adjacent cell is within grid boundaries\n        if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n            continue\n\n        # Check if this neighbor cell is an obstacle or contains the primitive itself\n        # Agent should not move onto an obstacle.\n        # Agent should not move onto the primitive itself, but next to it.\n        is_unwalkable = False\n        for k_idx in obstacle_kinds:\n            if grid[nx, ny, k_idx] == 1:\n                is_unwalkable = True\n                break\n        # Also treat the primitive's own cell as unwalkable for agent movement\n        # (agent walks *to* a spot *next to* the primitive, not *onto* it)\n        if grid[nx, ny, primitive] == 1:\n            is_unwalkable = True\n\n        if not is_unwalkable:\n            potential_agent_targets.append((nx, ny))\n\n    if not potential_agent_targets:\n        # No reachable adjacent cell found, the primitive might be unreachable (e.g., surrounded by walls)\n        return []\n\n    # 4. Use Breadth-First Search (BFS) to find the shortest path\n    # BFS is suitable for finding the shortest path in an unweighted grid.\n    queue = collections.deque([(current_pos, [])]) # Queue stores (current_position, path_taken_to_reach_current_position)\n    visited = {current_pos} # Set to keep track of visited cells to avoid cycles and redundant processing\n\n    while queue:\n        (cx, cy), current_path = queue.popleft()\n\n        # Check if the current position is one of the valid adjacent targets\n        if (cx, cy) in potential_agent_targets:\n            # Path found! Append the USE action and return the full action sequence.\n            return current_path + [ACTION_USE]\n\n        # Explore possible moves from the current position\n        for action_move, (dx, dy) in ACTION_DELTAS.items():\n            nx, ny = cx + dx, cy + dy # Calculate new coordinates after action\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n                continue\n\n            # Check if the new position has already been visited\n            if (nx, ny) in visited:\n                continue\n\n            # Check if the potential next cell is unwalkable (obstacle or the primitive itself)\n            is_unwalkable_path = False\n            for k_idx in obstacle_kinds:\n                if grid[nx, ny, k_idx] == 1:\n                    is_unwalkable_path = True\n                    break\n            if grid[nx, ny, primitive] == 1: # Agent cannot move onto the primitive cell\n                is_unwalkable_path = True\n\n            if not is_unwalkable_path:\n                visited.add((nx, ny)) # Mark as visited\n                queue.append(((nx, ny), current_path + [action_move])) # Add to queue for further exploration\n\n    # If the BFS completes and no path is found to any adjacent target cell\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:01:17.867145", "function_name": "collect", "function_body": "    # Get current state information from the environment's observations\n    obs = env.observations()\n    current_grid = obs['features_dict']['features_global']\n    current_pos = obs['features_dict']['pos']\n    inventory = obs['features_dict']['inventory']\n\n    # Access constants for actions from env_factory\n    ACTION_DOWN = env_factory.actions.DOWN\n    ACTION_UP = env_factory.actions.UP\n    ACTION_LEFT = env_factory.actions.LEFT\n    ACTION_RIGHT = env_factory.actions.RIGHT\n    ACTION_USE = env_factory.actions.USE\n\n    # 1. Check if the primitive is already collected\n    if inventory[primitive] > 0:\n        return []\n\n    # 2. Get grid dimensions (grid is (HEIGHT, WIDTH, n_kinds))\n    HEIGHT, WIDTH, _ = current_grid.shape\n\n    # 3. Get non-grabbable indices from the world configuration\n    non_grabbable_kinds = env.world.non_grabbable_indices\n\n    # Helper function to check if a position is within 3x3 neighborhood of the primitive\n    # This simulates CraftState.next_to without needing a CraftState object.\n    def _is_adjacent_to_primitive_or_contains(grid, pos, target_primitive_idx):\n        r, c = pos\n        # Check 3x3 neighborhood around pos (including pos itself)\n        for dr in [-1, 0, 1]:\n            for dc in [-1, 0, 1]:\n                nr, nc = r + dr, c + dc\n                # Check bounds\n                if 0 <= nr < HEIGHT and 0 <= nc < WIDTH:\n                    # If the cell contains the target primitive\n                    if grid[nr, nc, target_primitive_idx] == 1:\n                        return True\n        return False\n\n    # 4. Initialize BFS queue and visited set\n    # Queue stores tuples of ((row, col), list_of_actions_to_reach_here)\n    q = collections.deque([(current_pos, [])])\n    visited = {current_pos} # Set of (row, col) tuples\n\n    # 5. BFS loop to find the shortest path to a position from which USE can be applied\n    while q:\n        (r, c), path_actions = q.popleft()\n\n        # If the current position (r, c) is already next to the primitive (or on it),\n        # we can perform the USE action here.\n        if _is_adjacent_to_primitive_or_contains(current_grid, (r, c), primitive):\n            return path_actions + [ACTION_USE]\n\n        # Define possible movement actions and their resulting deltas (dr, dc)\n        # for (row, column) coordinates\n        moves = [\n            ((1, 0), ACTION_DOWN),   # Move Down: r+1, c\n            ((-1, 0), ACTION_UP),    # Move Up: r-1, c\n            ((0, -1), ACTION_LEFT),  # Move Left: r, c-1\n            ((0, 1), ACTION_RIGHT),  # Move Right: r, c+1\n        ]\n\n        for (dr, dc), action in moves:\n            next_r, next_c = r + dr, c + dc\n            next_pos = (next_r, next_c)\n\n            # Check bounds: ensure the next position is within the grid\n            if not (0 <= next_r < HEIGHT and 0 <= next_c < WIDTH):\n                continue\n\n            # Check if the next position has already been visited\n            if next_pos in visited:\n                continue\n\n            # Check if the next cell is traversable.\n            # A cell is blocked if it contains any non-grabbable item.\n            is_blocked = False\n            for k in non_grabbable_kinds:\n                if current_grid[next_r, next_c, k] == 1: # Cell contains a non-grabbable item\n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue\n\n            # If the cell is valid and traversable, add it to the queue and mark as visited\n            visited.add(next_pos)\n            q.append((next_pos, path_actions + [action]))\n\n    # If the BFS completes and no path was found to a primitive or its adjacent cell,\n    # it means the primitive is unreachable or not on the map.\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:03:06.671075", "function_name": "collect", "function_body": "    current_state = env._current_state\n    \n    # 1. Check if the primitive is already collected\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get state information\n    agent_pos = current_state.pos\n    agent_dir = current_state.dir # 0:N, 1:E, 2:S, 3:W\n    grid = current_state.grid\n    width, height, _ = grid.shape\n\n    actions_list = []\n\n    # 2. Find all locations of the primitive on the grid\n    primitive_locations = []\n    for x in range(width):\n        for y in range(height):\n            if grid[x, y, primitive] == 1:\n                primitive_locations.append((x, y))\n\n    # 3. If no primitive found on the grid, return empty actions\n    if not primitive_locations:\n        return []\n\n    # 4. Find the closest primitive location (Manhattan distance)\n    closest_primitive_pos = None\n    min_dist = float('inf')\n    for px, py in primitive_locations:\n        dist = abs(px - agent_pos[0]) + abs(py - agent_pos[1])\n        if dist < min_dist:\n            min_dist = dist\n            closest_primitive_pos = (px, py)\n\n    # 5. Calculate the target adjacent position for the agent and the desired facing direction.\n    # The agent needs to be at a cell adjacent to the primitive and face it to use it.\n    \n    target_px, target_py = closest_primitive_pos\n    \n    # Candidate adjacent spots and the direction the agent should face towards the primitive:\n    # Agent at (adj_x, adj_y), primitive at (target_px, target_py)\n    # The second element in the tuple is the direction constant (0:N, 1:E, 2:S, 3:W)\n    candidate_adj_spots = [\n        ((target_px - 1, target_py), 1), # Agent to left of primitive, faces East (RIGHT)\n        ((target_px + 1, target_py), 3), # Agent to right of primitive, faces West (LEFT)\n        ((target_px, target_py - 1), 2), # Agent above primitive, faces South (DOWN)\n        ((target_px, target_py + 1), 0)  # Agent below primitive, faces North (UP)\n    ]\n\n    best_adj_candidate = None\n    min_adj_dist = float('inf')\n\n    # Find the closest valid adjacent spot that is within grid bounds\n    for adj_pos, dir_to_face in candidate_adj_spots:\n        ax, ay = adj_pos\n        if 0 <= ax < width and 0 <= ay < height: # Check if adjacent spot is within grid bounds\n            dist_to_adj = abs(ax - agent_pos[0]) + abs(ay - agent_pos[1])\n            if dist_to_adj < min_adj_dist:\n                min_adj_dist = dist_to_adj\n                best_adj_candidate = (adj_pos, dir_to_face)\n\n    if best_adj_candidate is None:\n        # Cannot reach an adjacent spot (e.g., primitive is at edge of map with no space around it)\n        return []\n    \n    target_adj_pos, desired_facing_dir = best_adj_candidate\n    tx, ty = target_adj_pos\n\n    # 6. Generate movement actions to reach `target_adj_pos`\n    # We simulate the agent's position and direction as actions are added to the list.\n    sim_pos_x, sim_pos_y = agent_pos\n    sim_dir = agent_dir # Current simulated direction of the agent\n\n    # Move horizontally first\n    while sim_pos_x != tx:\n        if sim_pos_x < tx:\n            actions_list.append(RIGHT)\n            sim_pos_x += 1\n            sim_dir = 1 # Agent faces East after moving right\n        else: # sim_pos_x > tx\n            actions_list.append(LEFT)\n            sim_pos_x -= 1\n            sim_dir = 3 # Agent faces West after moving left\n    \n    # Then move vertically\n    while sim_pos_y != ty:\n        if sim_pos_y < ty:\n            actions_list.append(DOWN)\n            sim_pos_y += 1\n            sim_dir = 2 # Agent faces South after moving down\n        else: # sim_pos_y > ty\n            actions_list.append(UP)\n            sim_pos_y -= 1\n            sim_dir = 0 # Agent faces North after moving up\n\n    # At this point, the agent is at `target_adj_pos` and `sim_dir` is its current facing direction.\n\n    # 7. Generate turning actions to face the primitive\n    # Calculate the shortest turns needed to align `sim_dir` with `desired_facing_dir`.\n    # Directions: 0:North, 1:East, 2:South, 3:West\n    delta_dir = (desired_facing_dir - sim_dir + 4) % 4 # +4 to handle negative results of subtraction\n\n    if delta_dir == 1: # Need to turn 90 degrees right\n        actions_list.append(RIGHT)\n    elif delta_dir == 2: # Need to turn 180 degrees (two rights or two lefts)\n        actions_list.append(RIGHT) \n        actions_list.append(RIGHT)\n    elif delta_dir == 3: # Need to turn 90 degrees left\n        actions_list.append(LEFT)\n\n    # 8. Add the USE action to collect the primitive\n    actions_list.append(USE)\n    \n    return actions_list", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:03:06.742150", "function_name": "collect", "function_body": "    # Define action constants (local to the function as per strict instruction)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Map actions to (dr, dc) deltas for movement (local to the function)\n    ACTION_TO_DELTA = {\n        UP: (-1, 0),\n        DOWN: (1, 0),\n        LEFT: (0, -1),\n        RIGHT: (0, 1),\n    }\n\n    actions_taken = []\n    \n    # Reset environment to get initial state\n    # The return value from reset is an observation dict, we need CraftState itself.\n    _ = env.reset() \n    state = env._current_state # Access the current state from the CraftLab instance\n\n    # Check if primitive is already in inventory\n    if state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # Get grid dimensions once\n    WIDTH, HEIGHT, _ = state.grid.shape \n\n    # Helper function for BFS pathfinding (local to collect_v2)\n    # Finds shortest path to any cell containing the target_kind_idx\n    def bfs_path_to_item(start_pos, target_kind_idx, current_grid, world_ref):\n        # collections.deque is needed here. Assumed available globally or handled by environment.\n        queue = collections.deque([(start_pos, [])]) # (position, path_actions_to_reach_pos)\n        visited = {start_pos}\n\n        while queue:\n            current_pos, path = queue.popleft()\n            r, c = current_pos\n\n            # If current cell contains the target primitive, this is a valid target cell.\n            # We assume primitives are grabbable and can be walked onto.\n            if current_grid[r, c, target_kind_idx] > 0:\n                return path # Path found to the cell containing the item\n\n            # Explore neighbors\n            for action, (dr, dc) in ACTION_TO_DELTA.items(): # ACTION_TO_DELTA is from outer scope\n                nr, nc = r + dr, c + dc\n\n                # Check bounds\n                if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT): # WIDTH, HEIGHT are from outer scope\n                    continue\n\n                if (nr, nc) in visited:\n                    continue\n\n                # Check passability of the neighbor cell (nr, nc)\n                is_passable_neighbor = False\n                \n                # Get all kinds present in the neighbor cell\n                occupying_kinds = np.where(current_grid[nr, nc, :] > 0)[0]\n                \n                # If the cell is empty (all zeros for kinds), it's passable\n                if not occupying_kinds.size: # Equivalent to np.all(current_grid[nr, nc, :] == 0)\n                    is_passable_neighbor = True\n                else:\n                    # If the cell contains the target primitive, it's passable (we want to walk on it)\n                    if target_kind_idx in occupying_kinds:\n                        is_passable_neighbor = True\n                    else:\n                        # Otherwise, check if all other occupying items are grabbable (meaning we can walk over them)\n                        can_pass_through_contents = True\n                        for k_idx in occupying_kinds:\n                            # If it's not the target AND it's not grabbable, then it's an obstacle\n                            if k_idx not in world_ref.grabbable_indices: # World ref is from outer scope\n                                can_pass_through_contents = False\n                                break\n                        if can_pass_through_contents:\n                            is_passable_neighbor = True\n                \n                if not is_passable_neighbor:\n                    continue # Skip this neighbor, it's blocked (e.g., a workshop or other unpassable)\n\n                visited.add((nr, nc))\n                new_path = path + [action]\n                queue.append(((nr, nc), new_path))\n        \n        return None # No path found to the primitive\n\n    # Main loop for collection\n    # Continue until the primitive is in the inventory\n    while state.inventory[primitive] == 0:\n        # Before moving, check if we are already next to the primitive\n        # If so, use the USE action.\n        if state.next_to(primitive):\n            actions_taken.append(USE)\n            reward, done, obs = env.step(USE)\n            state = env._current_state # Update state after action\n            \n            # If after USE, the primitive is now in inventory, we are done\n            if state.inventory[primitive] > 0:\n                return actions_taken\n            \n            # If 'done' is true (e.g., max_steps reached) and we haven't collected, return partial actions\n            if done:\n                return actions_taken\n\n            # If USE didn't collect the item (e.g., target depleted, or not actually grabbable despite being next to it),\n            # the loop will continue to try pathfinding again. This handles cases where `USE` might fail.\n\n        # If not next to the primitive, or if USE failed, find/take a step towards it\n        # Pass current grid and world reference to BFS, as they are part of CraftState and CraftWorld\n        path_to_item_actions = bfs_path_to_item(state.pos, primitive, state.grid, state.world)\n\n        if path_to_item_actions:\n            # Take only the first action in the path, then re-evaluate\n            move_action = path_to_item_actions[0]\n            actions_taken.append(move_action)\n            reward, done, obs = env.step(move_action)\n            state = env._current_state # Update state after action\n            \n            # If the environment indicates it's done (e.g., max steps)\n            # but we haven't collected the item yet, return current actions.\n            if done:\n                return actions_taken\n        else:\n            # No path found to the primitive. This implies it's not on the grid\n            # or it's currently unreachable/blocked.\n            # In a well-formed task, this shouldn't happen for a \"collect\" goal unless the item is truly gone.\n            # To prevent infinite loops in such a scenario, return the actions taken so far.\n            return actions_taken\n    \n    # If the loop breaks, it means state.inventory[primitive] > 0\n    return actions_taken", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:04:28.550739", "function_name": "collect", "function_body": "", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:04:28.620438", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action mappings as per CraftLab's action_specs\n    # These are typically globally defined constants or accessed via env.action_specs()\n    # Assuming they are accessible here as per prompt context of \"terminal function\"\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    # Get the actual current state from the environment.\n    # Accessing _current_state directly is for the purpose of this problem,\n    # allowing direct simulation of CraftState's internal logic for pathfinding.\n    initial_craft_state = env._current_state\n    \n    # Check if the primitive is already in the inventory.\n    if initial_craft_state.inventory[primitive] > 0:\n        return []\n\n    # BFS setup\n    # Each element in the queue is a tuple: (current_CraftState_instance, list_of_actions_to_reach_this_state)\n    queue = collections.deque([(initial_craft_state, [])]) \n    \n    # Visited set to avoid redundant exploration and cycles.\n    # We track (position, direction) tuples. We assume the grid (other than the collected item)\n    # remains static during pathfinding, simplifying the state representation for BFS.\n    visited = {(initial_craft_state.pos, initial_craft_state.dir)} \n\n    # BFS loop\n    while queue:\n        current_craft_state, actions_sequence = queue.popleft()\n\n        # Check if the primitive is in the 3x3 neighborhood around the current position.\n        # This means the agent is in a position to \"USE\" the primitive.\n        if current_craft_state.next_to(primitive):\n            # If so, the goal is reached. Append the USE action and return the sequence.\n            return actions_sequence + [USE]\n\n        # Explore possible movement actions (UP, DOWN, LEFT, RIGHT)\n        for action in [UP, DOWN, LEFT, RIGHT]:\n            # Simulate the step to get the new hypothetical state.\n            # CraftState.step returns a *new* CraftState instance, crucial for BFS without side effects.\n            # The reward is always 0.0 for movement steps in this problem context.\n            _, new_craft_state = current_craft_state.step(action) \n            \n            # Check if this new state (position, direction) has already been visited.\n            if (new_craft_state.pos, new_craft_state.dir) not in visited:\n                visited.add((new_craft_state.pos, new_craft_state.dir))\n                queue.append((new_craft_state, actions_sequence + [action]))\n\n    # If the queue becomes empty and the primitive hasn't been found/reached,\n    # it means the primitive is unreachable or not present on the map.\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:05:49.453433", "function_name": "collect", "function_body": "    current_state = env._current_state\n    \n    # 1. Initial Check: If already in inventory, return empty list.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    H, W, n_kinds = grid.shape\n    current_pos = current_state.pos\n    current_dir = current_state.dir # 0: UP, 1: RIGHT, 2: DOWN, 3: LEFT\n\n    # Get non-grabbable indices from the world object. These represent obstacles.\n    non_grabbable_indices = current_state.world.non_grabbable_indices\n\n    # Constants for movement deltas and direction mapping\n    MOVE_DELTAS = {\n        env_factory.UP: (-1, 0),\n        env_factory.DOWN: (1, 0),\n        env_factory.LEFT: (0, -1),\n        env_factory.RIGHT: (0, 1)\n    }\n\n    # Mapping from (target_r - agent_r, target_c - agent_c) to required agent direction.\n    # E.g., if target is (-1,0) relative to agent, agent must face UP (0).\n    DELTA_TO_DIR = {\n        (-1, 0): 0,  # Target is Up relative to agent, agent faces UP\n        (1, 0): 2,   # Target is Down relative to agent, agent faces DOWN\n        (0, -1): 3,  # Target is Left relative to agent, agent faces LEFT\n        (0, 1): 1    # Target is Right relative to agent, agent faces RIGHT\n    }\n\n    # 2. Find all locations of `primitive` on the grid.\n    primitive_locations = []\n    for r in range(H):\n        for c in range(W):\n            if grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the grid\n\n    # BFS Setup\n    # queue stores ( (pos_r, pos_c), direction, [actions_list] )\n    queue = collections.deque([((current_pos), current_dir, [])]) \n    # visited stores ( (pos_r, pos_c), direction ) to avoid cycles and redundant exploration\n    visited = set([(current_pos, current_dir)]) \n\n    # Pre-calculate target states for BFS: (agent_pos, required_agent_dir)\n    # These are the states from which a USE action can directly collect a primitive.\n    target_use_states = set()\n    for pr, pc in primitive_locations:\n        # Check cardinal neighbors only for USE action\n        for dr_adj, dc_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: \n            # (ar, ac) is the agent's potential position\n            # (dr_adj, dc_adj) is (target_r - agent_r, target_c - agent_c)\n            # So, agent_r = target_r - dr_adj, agent_c = target_c - dc_adj\n            ar, ac = pr - dr_adj, pc - dc_adj\n            \n            # Check if agent's potential position is within grid boundaries\n            if not (0 <= ar < H and 0 <= ac < W):\n                continue \n\n            # Determine the required direction the agent must be facing from (ar, ac) to USE (pr, pc)\n            required_dir = DELTA_TO_DIR.get((dr_adj, dc_adj))\n            if required_dir is not None:\n                target_use_states.add(((ar, ac), required_dir))\n\n    # BFS Loop\n    while queue:\n        (r, c), d, actions = queue.popleft()\n\n        # Check if current state is one of the \"target use states\"\n        # If agent is at (r, c) facing d, can it USE the primitive?\n        if ((r, c), d) in target_use_states:\n            # Verify that the primitive is actually in front of the agent at this state\n            target_r, target_c = r, c\n            if d == env_factory.UP: target_r -= 1\n            elif d == env_factory.RIGHT: target_c += 1\n            elif d == env_factory.DOWN: target_r += 1\n            elif d == env_factory.LEFT: target_c -= 1\n            \n            # Check if this cell is within bounds and contains the primitive\n            if 0 <= target_r < H and 0 <= target_c < W and grid[target_r, target_c, primitive] > 0:\n                 # Found a path to a position from which we can USE the primitive\n                return actions + [env_factory.USE]\n\n        # Explore possible next states (movement actions)\n        for action in [env_factory.UP, env_factory.DOWN, env_factory.LEFT, env_factory.RIGHT]:\n            dr, dc = MOVE_DELTAS[action]\n            next_r, next_c = r + dr, c + dc\n            next_dir = action # Agent's direction updates to match the last movement (as per CraftState description)\n\n            # Check bounds for next position\n            if not (0 <= next_r < H and 0 <= next_c < W):\n                continue\n\n            # Check if next cell is an obstacle (contains any non-grabbable item)\n            is_obstacle = False\n            # Iterate through all kinds in the cell to check for non_grabbable_indices\n            for k_idx in non_grabbable_indices:\n                if grid[next_r, next_c, k_idx] > 0:\n                    is_obstacle = True\n                    break\n            \n            if is_obstacle:\n                continue # Cannot move into an obstacle cell\n\n            next_state_key = ((next_r, next_c), next_dir)\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                queue.append(((next_r, next_c), next_dir, actions + [action]))\n\n    return [] # No path found to collect the primitive", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:05:50.388336", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:07:07.928147", "function_name": "collect", "function_body": "    # Get action mappings from the environment\n    action_spec = env.action_specs()\n    ACTION_UP = action_spec['UP']\n    ACTION_DOWN = action_spec['DOWN']\n    ACTION_LEFT = action_spec['LEFT']\n    ACTION_RIGHT = action_spec['RIGHT']\n    ACTION_USE = action_spec['USE']\n\n    # Map delta_rc (row_change, col_change) to action ID\n    delta_to_action = {\n        (-1, 0): ACTION_UP,\n        (1, 0): ACTION_DOWN,\n        (0, -1): ACTION_LEFT,\n        (0, 1): ACTION_RIGHT,\n    }\n\n    # Get current state information from the CraftLab environment\n    current_state = env._current_state\n    grid = current_state.grid\n    start_pos = current_state.pos  # Agent's current (row, col)\n    grid_height, grid_width, _ = grid.shape\n\n    # 1. Find all locations of the primitive on the grid\n    # np.argwhere returns a (N, 2) array of (row, col) coordinates where grid[:,:,primitive] > 0\n    primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n    if len(primitive_locations) == 0:\n        # Primitive not found in the world\n        return []\n\n    # Convert primitive_locations to a set of tuples for faster lookups during BFS\n    primitive_locations_set = set(tuple(loc) for loc in primitive_locations)\n\n    # 2. Breadth-First Search (BFS) to find the shortest path to any primitive location\n    # Queue stores (current_position_tuple, list_of_actions_to_reach_here)\n    # Using a list to simulate a deque by manually managing 'head' index to avoid\n    # a new import (`collections.deque`), adhering to problem constraints.\n    queue = [(start_pos, [])]\n    visited = {start_pos} # Set to keep track of visited (row, col) positions\n\n    shortest_path_actions = []\n    found_primitive_cell = False\n\n    head = 0 # Index for the front of the queue (simulating popleft())\n\n    while head < len(queue):\n        (r, c), path_so_far = queue[head]\n        head += 1\n\n        # Check if the current cell (r, c) contains the primitive\n        if (r, c) in primitive_locations_set:\n            shortest_path_actions = path_so_far\n            found_primitive_cell = True\n            break # Found the shortest path to a primitive cell, terminate BFS\n\n        # Explore valid neighbors (up, down, left, right)\n        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Delta for UP, DOWN, LEFT, RIGHT\n            nr, nc = r + dr, c + dc\n            next_pos = (nr, nc)\n\n            # Check boundary conditions and if the cell has not been visited yet\n            if (0 <= nr < grid_height and 0 <= nc < grid_width and next_pos not in visited):\n                # In CraftWorld, most cells are traversable. If there were explicit impassable\n                # objects (e.g., walls), a check like 'if grid[nr, nc, WALL_INDEX] == 0' would be added here.\n                # Assuming all non-primitive cells are traversable for movement.\n                \n                visited.add(next_pos)\n                action_to_move = delta_to_action[(dr, dc)]\n                queue.append((next_pos, path_so_far + [action_to_move]))\n\n    if not found_primitive_cell:\n        # If the primitive was found in the world but is unreachable (e.g., agent is trapped)\n        return []\n\n    # 3. Path found to the cell containing the primitive.\n    # After moving to the cell with the primitive, execute the USE action to pick it up.\n    # The `CraftState.next_to` method confirms that USE works within a 3x3 neighborhood,\n    # so being directly on the primitive's cell makes it grabbable.\n    final_actions = shortest_path_actions + [ACTION_USE]\n\n    return final_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:07:08.917922", "function_name": "collect", "function_body": "", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:08:18.327445", "function_name": "collect", "function_body": "    from collections import deque\n\n    # Helper function to find path and determine USE action\n    def _find_path_and_use_action(start_pos, item_idx, current_grid, non_grabbable_indices, action_map):\n        \"\"\"\n        Finds the shortest path from start_pos to a cell adjacent to item_idx,\n        and appends the USE action.\n        Returns a list of actions or None if no path found.\n        \"\"\"\n        height, width, _ = current_grid.shape\n        \n        # Map (dx, dy) to actions. pos is (x,y), grid is (y,x,kinds).\n        # (0, 1): move_y = +1 (UP in grid Y-axis)\n        # (0, -1): move_y = -1 (DOWN in grid Y-axis)\n        # (1, 0): move_x = +1 (RIGHT in grid X-axis)\n        # (-1, 0): move_x = -1 (LEFT in grid X-axis)\n        moves = {\n            (0, 1): action_map['UP'],\n            (0, -1): action_map['DOWN'],\n            (1, 0): action_map['RIGHT'],\n            (-1, 0): action_map['LEFT']\n        }\n\n        # Step 1: Identify all locations of the target item on the grid\n        item_locations = []\n        for y in range(height):\n            for x in range(width):\n                if current_grid[y, x, item_idx] > 0:\n                    item_locations.append((x, y))\n        \n        if not item_locations:\n            return None # Item not present on the grid\n\n        # Step 2: Identify all valid \"pre-use\" target cells for the agent\n        # A pre-use cell is an empty/traversable cell adjacent to an item location.\n        pre_use_targets = set()\n        for ix, iy in item_locations:\n            for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]: # 4-directional neighbors\n                nx, ny = ix + dx, iy + dy\n                \n                # Check bounds for the neighbor cell\n                if not (0 <= nx < width and 0 <= ny < height):\n                    continue\n                \n                # Check if this neighbor cell is traversable (not an obstacle)\n                is_obstacle = False\n                # A cell is an obstacle if it contains any non-grabbable item.\n                for kind_idx in non_grabbable_indices:\n                    if current_grid[ny, nx, kind_idx] > 0: # If cell contains an obstacle kind\n                        is_obstacle = True\n                        break\n                \n                if not is_obstacle:\n                    pre_use_targets.add((nx, ny))\n        \n        if not pre_use_targets:\n            # No traversable spots adjacent to the item (e.g., item surrounded by walls)\n            return None\n\n        # Step 3: Perform BFS to find the shortest path to any pre-use target\n        q = deque([(start_pos, [])]) # Queue stores (current_pos_tuple, list_of_actions_so_far)\n        visited = {start_pos} # Set of visited (x, y) tuples to avoid cycles and redundant paths\n\n        while q:\n            (curr_x, curr_y), path = q.popleft()\n\n            # If the current position is one of our pre-use targets\n            if (curr_x, curr_y) in pre_use_targets:\n                # Reached a suitable pre-use position. Add the USE action and return the full path.\n                return path + [action_map['USE']]\n\n            # Explore neighbors\n            for (dx, dy), action in moves.items():\n                next_x, next_y = curr_x + dx, curr_y + dy\n                next_pos = (next_x, next_y)\n\n                # Check bounds and if the cell has already been visited\n                if not (0 <= next_x < width and 0 <= next_y < height and next_pos not in visited):\n                    continue\n\n                # Check if the next cell is traversable (not an obstacle)\n                is_obstacle = False\n                for kind_idx in non_grabbable_indices:\n                    if current_grid[ny, nx, kind_idx] > 0:\n                        is_obstacle = True\n                        break\n                \n                if not is_obstacle:\n                    visited.add(next_pos)\n                    q.append((next_pos, path + [action]))\n        \n        return None # No path found to any pre-use target\n\n    # --- Main logic of collect_v2 function ---\n    \n    # 1. Get current state information from the CraftLab environment\n    # The `env` is a CraftLab instance which holds the current CraftState.\n    current_state = env._current_state \n    \n    # Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n    \n    # Extract necessary data for pathfinding from the current state and world\n    start_pos = current_state.pos # Agent's current position (x, y)\n    current_grid = current_state.grid # Current grid layout (height, width, n_kinds)\n    \n    # The world object (CraftWorld instance) contains general environment configurations\n    world = env.world \n    non_grabbable_indices = world.non_grabbable_indices # Set of indices for impassable entities\n    \n    # Get the action mapping (e.g., {'UP': 1, 'DOWN': 0, 'USE': 4}) from the environment\n    action_map = env.action_specs() \n\n    # 2. Call the helper function to find the sequence of actions to collect the primitive\n    actions_to_collect = _find_path_and_use_action(\n        start_pos, \n        primitive, \n        current_grid, \n        non_grabbable_indices, \n        action_map\n    )\n    \n    # Return the found actions or an empty list if no path was found (or item is unreachable)\n    if actions_to_collect is None:\n        return [] \n    else:\n        return actions_to_collect", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:08:18.398223", "function_name": "collect", "function_body": "    actions = []\n\n    # Get current state information from the CraftLab environment\n    current_state = env._current_state\n    grid = current_state.grid\n    current_pos = current_state.pos\n    world = current_state.world  # Reference to CraftWorld for grabbable info\n\n    primitive_locations = []\n    # Find all locations on the grid where the primitive exists\n    grid_width, grid_height, _ = grid.shape\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        # No primitive found on the map, cannot collect\n        return []\n\n    # Find the closest primitive location using Manhattan distance\n    target_pos = None\n    min_dist = float('inf')\n    for loc in primitive_locations:\n        dist = abs(loc[0] - current_pos[0]) + abs(loc[1] - current_pos[1])\n        if dist < min_dist:\n            min_dist = dist\n            target_pos = loc\n\n    # Generate actions to move to the target_pos\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n\n    # Move along X-axis\n    while current_x != target_x:\n        if target_x > current_x:\n            actions.append(env_factory.RIGHT)\n            current_x += 1\n        else:  # target_x < current_x\n            actions.append(env_factory.LEFT)\n            current_x -= 1\n\n    # Move along Y-axis\n    while current_y != target_y:\n        if target_y > current_y:\n            actions.append(env_factory.DOWN)  # Assuming Y increases downwards (moves down on screen)\n            current_y += 1\n        else:  # target_y < current_y\n            actions.append(env_factory.UP)  # Assuming Y decreases upwards (moves up on screen)\n            current_y -= 1\n    \n    # After reaching the target position, determine if a 'USE' action is needed.\n    # If the primitive is non-grabbable (e.g., water, stone, workshop), 'USE' is typically required.\n    # Grabbable items are usually collected by simply moving onto their square.\n    if primitive in world.non_grabbable_indices:\n        actions.append(env_factory.USE)\n\n    return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:09:33.965987", "function_name": "collect", "function_body": "  import collections\n\n  # Constants for actions\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement action to the direction it results in for the agent's facing (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  # When the agent moves, it also turns to face the direction of movement.\n  ACTION_TO_RESULTING_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map agent's direction integer to its (dx, dy) vector (change in position)\n  # This vector also identifies the cell directly in front of the agent when facing that direction.\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y-coordinate\n      1: (1, 0),   # RIGHT: increases x-coordinate\n      2: (0, 1),   # DOWN: increases y-coordinate\n      3: (-1, 0)   # LEFT: decreases x-coordinate\n  }\n\n  # Initial check: If the primitive item is not designated as \"grabbable\",\n  # then it cannot be collected by the agent. Return an empty path.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Retrieve the current state information from the environment.\n  # This includes the agent's initial position, direction, and the grid layout.\n  current_state = env._current_state\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = current_state.grid # The full allocentric grid layout\n  grid_width, grid_height, _ = grid.shape\n\n  # Get the set of indices for entities that block agent movement (e.g., walls, water, workshops).\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def _is_traversable(x: int, y: int) -> bool:\n    \"\"\"\n    Helper function to check if a given grid cell (x, y) is within bounds\n    and does not contain any non-grabbable obstacles.\n    \"\"\"\n    # First, verify if the coordinates are within the grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Next, check if the cell contains any entity that is designated as non-grabbable.\n    # If it does, the cell is blocked and cannot be traversed.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1: # If this cell contains a non-grabbable item\n        return False\n    return True # The cell is traversable\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue will store states as (current_x, current_y, current_direction).\n  queue = collections.deque([(start_x, start_y, start_dir)])\n\n  # The 'visited' set keeps track of all (x, y, direction) states already explored\n  # to prevent cycles and redundant path computations, ensuring the shortest path.\n  visited = set([(start_x, start_y, start_dir)])\n\n  # The 'parent_info' dictionary is used to reconstruct the path once the goal is found.\n  # It maps a `(child_state)` to `(parent_state, action_taken_from_parent_to_reach_child)`.\n  parent_info = {}\n\n  # This variable will store the state (x, y, dir) from which the 'USE' action can be taken\n  # to collect the primitive. It's set once the goal is found during BFS.\n  goal_state_pre_use = None\n\n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft() # Dequeue the current state to explore\n\n    # --- Goal Check ---\n    # Determine the coordinates of the cell directly in front of the agent.\n    faced_dx, faced_dy = DIR_VEC[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # If the cell in front is within grid boundaries AND contains the target primitive:\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # The primitive is reachable with a 'USE' action from the current position and direction.\n      goal_state_pre_use = (curr_x, curr_y, curr_dir)\n      break # Goal found, terminate BFS\n\n    # --- Explore Possible Movement Actions ---\n    # Iterate through all four cardinal movement actions (UP, RIGHT, DOWN, LEFT).\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new facing direction and movement vector based on the action.\n      new_facing_dir = ACTION_TO_RESULTING_DIR[action]\n      move_dx, move_dy = DIR_VEC[new_facing_dir]\n      \n      # Calculate the next position after performing this movement action.\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_state_tuple = (next_x, next_y, new_facing_dir)\n\n      # If the next cell is traversable AND this new (position, direction) state\n      # has not been visited yet:\n      if _is_traversable(next_x, next_y) and next_state_tuple not in visited:\n        visited.add(next_state_tuple) # Mark the new state as visited\n        # Store how we reached this state for path reconstruction.\n        parent_info[next_state_tuple] = ((curr_x, curr_y, curr_dir), action)\n        queue.append(next_state_tuple) # Enqueue the new state for further exploration\n\n  # If the BFS completed without finding a path to collect the primitive,\n  # 'goal_state_pre_use' will still be None. In this case, return an empty list.\n  if goal_state_pre_use is None:\n    return []\n\n  # --- Path Reconstruction ---\n  # Start reconstructing the path by adding the final 'USE' action.\n  actions_path = [ACTION_USE]\n\n  # Begin backtracking from the state identified as just before the 'USE' action.\n  current_state_in_path = goal_state_pre_use\n  start_state_tuple = (start_x, start_y, start_dir)\n\n  # Continue backtracking until the initial starting state is reached.\n  while current_state_in_path != start_state_tuple:\n    # Retrieve the parent state and the action that was taken from the parent\n    # to arrive at 'current_state_in_path'.\n    parent_state, action_from_parent = parent_info[current_state_in_path]\n    actions_path.append(action_from_parent) # Add this action to the path\n    current_state_in_path = parent_state # Move to the parent state\n\n  # The path was built in reverse order (from goal back to start).\n  # Reverse the list to get the correct chronological sequence of actions.\n  return actions_path[::-1]", "island_id": 6, "scores": {"3": 0.0}}
