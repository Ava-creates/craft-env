{"timestamp": "2025-07-30T23:44:50.780544", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Get current state information from the internal CraftState\n  current_state = env._current_state\n  agent_pos = current_state.pos  # (row, col)\n  agent_dir = current_state.dir  # Agent's current facing direction (0:N, 1:E, 2:S, 3:W)\n  grid = current_state.grid     # (WIDTH, HEIGHT, n_kinds)\n  current_inventory = current_state.inventory\n\n  # 0. Check if primitive is already in inventory\n  if current_inventory[primitive] > 0:\n    return []\n\n  WIDTH, HEIGHT, _ = grid.shape\n  world = current_state.world\n\n  # Obstacle indices (assuming water and stone are impassable terrain)\n  water_index = world.water_index\n  stone_index = world.stone_index\n  \n  # Grabbable items (the 'primitive' must be grabbable to be collected)\n  grabbable_indices = world.grabbable_indices\n  if primitive not in grabbable_indices:\n    # Cannot collect this item if it's not grabbable\n    return []\n\n  # Action mappings from CraftLab\n  ACTION_TO_INT = {v: k for k, v in env.action_specs().items()}\n  USE_ACTION = ACTION_TO_INT['USE']\n\n  # Define movement deltas and resulting new directions for each agent direction\n  # Directions: 0:North(UP), 1:East(RIGHT), 2:South(DOWN), 3:West(LEFT)\n  DIR_TO_DELTAS = {\n      0: (-1, 0), # North (corresponds to UP action movement)\n      1: (0, 1),  # East (corresponds to RIGHT action movement)\n      2: (1, 0),  # South (corresponds to DOWN action movement)\n      3: (0, -1), # West (corresponds to LEFT action movement)\n  }\n\n  # Maps movement action integer to (dr, dc) and the agent's new direction after taking that action\n  MOVE_ACTION_EFFECTS = {\n      ACTION_TO_INT['UP']:    {'delta': (-1, 0), 'new_dir': 0},\n      ACTION_TO_INT['DOWN']:  {'delta': (1, 0),  'new_dir': 2},\n      ACTION_TO_INT['LEFT']:  {'delta': (0, -1), 'new_dir': 3},\n      ACTION_TO_INT['RIGHT']: {'delta': (0, 1),  'new_dir': 1},\n  }\n\n  def is_traversable(r, c):\n    \"\"\"Checks if a given grid cell (r, c) is within bounds and not an obstacle.\"\"\"\n    # Check bounds\n    if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n      return False\n    # Check for obstacles (water, stone). Assumed to be impassable.\n    if grid[r, c, water_index] > 0 or grid[r, c, stone_index] > 0:\n      return False\n    return True\n\n  # BFS Initialization\n  # Queue stores (row, col, direction) tuples representing agent state\n  queue = collections.deque([(agent_pos[0], agent_pos[1], agent_dir)])\n  # Visited set stores (row, col, direction) to avoid redundant computations and cycles\n  visited = {(agent_pos[0], agent_pos[1], agent_dir)}\n  # Parent map: (current_r, current_c, current_dir) -> ((prev_r, prev_c, prev_dir), action_to_reach_current_state)\n  parent_map = {}\n\n  target_state = None  # Will store the (r, c, dir) from which the agent can USE the primitive\n\n  # BFS Loop\n  while queue:\n    r, c, current_dir = queue.popleft()\n\n    # Check if the current state (r, c, current_dir) is a goal state\n    # A goal state is one where the agent is facing the 'primitive'\n    dr_face, dc_face = DIR_TO_DELTAS[current_dir]\n    facing_r, facing_c = r + dr_face, c + dc_face # Cell directly in front of the agent\n\n    # Check if the cell in front is within bounds and contains the primitive\n    if (0 <= facing_r < WIDTH and 0 <= facing_c < HEIGHT and\n        grid[facing_r, facing_c, primitive] > 0):\n      # Found a state where the agent is positioned to collect the primitive\n      target_state = (r, c, current_dir)\n      break # Exit BFS, goal found\n\n    # Explore possible next states by taking movement actions\n    for action_val, effect in MOVE_ACTION_EFFECTS.items():\n      dr_move, dc_move = effect['delta']\n      new_dir = effect['new_dir']\n      \n      nr, nc = r + dr_move, c + dc_move # New position after movement\n      \n      # Check if new position is traversable and new state (position + direction) has not been visited\n      if is_traversable(nr, nc) and (nr, nc, new_dir) not in visited:\n        visited.add((nr, nc, new_dir))\n        # Store the parent state and the action taken to reach the current state\n        parent_map[(nr, nc, new_dir)] = ((r, c, current_dir), action_val)\n        queue.append((nr, nc, new_dir))\n  \n  if not target_state:\n    # Primitive not found or not reachable in a way that allows USE\n    return []\n\n  # Reconstruct the path of actions from the start state to the target_state\n  path_actions = []\n  current_path_node = target_state\n  start_state = (agent_pos[0], agent_pos[1], agent_dir)\n\n  # Traverse back from the target_state to the start_state using the parent_map\n  while current_path_node != start_state:\n    # This check ensures we don't try to access a parent for the initial state\n    if current_path_node not in parent_map:\n        break \n    prev_node, action_taken = parent_map[current_path_node]\n    path_actions.append(action_taken)\n    current_path_node = prev_node\n  \n  # Reverse the path to get actions in chronological order (start to target)\n  path_actions.reverse()\n\n  # Add the final USE action to collect the primitive\n  path_actions.append(USE_ACTION)\n\n  return path_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:44:50.849994", "function_name": "collect", "function_body": "    # Define constants for actions. These values are fixed for CraftWorld.\n    # Assuming these are implicitly available or come from env_factory.action_map.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Helper function to map movement deltas (dx, dy) to actions.\n    # (dx, dy) represents (change in x, change in y).\n    # Assuming x is horizontal (width) and y is vertical (height).\n    # Typically, +y is down, +x is right.\n    def _get_action_for_move(dx, dy):\n        if dx == 0 and dy == 1:\n            return DOWN\n        elif dx == 0 and dy == -1:\n            return UP\n        elif dx == 1 and dy == 0:\n            return RIGHT\n        elif dx == -1 and dy == 0:\n            return LEFT\n        return None # Should not be reached with valid cardinal deltas\n\n    # Helper function to check if a given position (pos_x, pos_y) is adjacent\n    # to (or on the same cell as) an item of 'primitive_idx' in the grid.\n    # This mimics the logic of CraftState.next_to, but for arbitrary positions.\n    def _is_next_to_primitive(grid, pos_x, pos_y, primitive_idx):\n        width, height, _ = grid.shape\n        # Check the 3x3 neighborhood around (pos_x, pos_y), including the center cell itself.\n        for dx in [-1, 0, 1]:\n            for dy in [-1, 0, 1]:\n                nx, ny = pos_x + dx, pos_y + dy\n                # Ensure the neighboring cell is within grid bounds.\n                if 0 <= nx < width and 0 <= ny < height:\n                    # If the cell contains the primitive, we are \"next to\" it.\n                    if grid[nx, ny, primitive_idx] > 0:\n                        return True\n        return False\n\n    # Helper function to determine if a cell at (x, y) is traversable by the agent.\n    # Assumes that any cell containing a non-grabbable item is an obstacle.\n    # This might be an oversimplification if some non-grabbables are background elements.\n    def _is_walkable(grid, x, y, non_grabbable_indices):\n        cell_contents = grid[x, y, :]\n        for idx in non_grabbable_indices:\n            if cell_contents[idx] > 0:\n                return False # Cell contains an impassable non-grabbable item\n        return True # Cell is walkable (either empty or contains grabbable items)\n\n    # Get the current state from the environment wrapper.\n    current_state = env._current_state\n    \n    # 1. Check if the primitive is already in the agent's inventory.\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed.\n\n    # 2. Check if the agent is already in a position to use the primitive.\n    if current_state.next_to(primitive):\n        return [USE] # Agent is next to it, just use.\n\n    # 3. Pathfinding (Breadth-First Search) to find the shortest path to a cell\n    #    from where the agent can use the primitive.\n    \n    # Grid dimensions.\n    WIDTH, HEIGHT = current_state.grid.shape[:2]\n    \n    # Starting position for the BFS.\n    start_pos = current_state.pos\n    \n    # Queue for BFS: stores tuples of (current_position, list_of_actions_to_reach_this_position).\n    # Assumes 'collections.deque' is available (i.e., 'collections' is imported at module level).\n    queue = collections.deque([(start_pos, [])])\n    \n    # Set to keep track of visited positions to avoid cycles and redundant paths.\n    visited = {start_pos}\n\n    # Variable to store the final path found by BFS.\n    final_path_to_adjacent = None\n\n    # Define cardinal moves and their corresponding actions.\n    # These are (dx, dy) tuples for x and y coordinate changes.\n    cardinal_moves = [\n        ((0, 1), DOWN),   # Move one step down (increase y)\n        ((0, -1), UP),    # Move one step up (decrease y)\n        ((1, 0), RIGHT),  # Move one step right (increase x)\n        ((-1, 0), LEFT),  # Move one step left (decrease x)\n    ]\n\n    while queue:\n        (curr_x, curr_y), path_so_far = queue.popleft()\n\n        # Check if the current cell is a suitable \"use\" position for the primitive.\n        if _is_next_to_primitive(current_state.grid, curr_x, curr_y, primitive):\n            final_path_to_adjacent = path_so_far\n            break # Found the shortest path, exit BFS.\n\n        # Explore neighboring cells.\n        for (dx, dy), action in cardinal_moves:\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_pos = (next_x, next_y)\n\n            # Check if the next position is within grid boundaries and has not been visited.\n            if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT and next_pos not in visited:\n                # Check if the next position is walkable (not an obstacle).\n                if _is_walkable(current_state.grid, next_x, next_y, current_state.world.non_grabbable_indices):\n                    visited.add(next_pos)\n                    # Add the new position and the updated path to the queue.\n                    queue.append((next_pos, path_so_far + [action]))\n\n    # 4. Construct the final sequence of actions.\n    if final_path_to_adjacent is not None:\n        # If a path to an adjacent cell was found, add the USE action at the end.\n        return final_path_to_adjacent + [USE]\n    else:\n        # If no path was found (primitive not on grid or unreachable), return an empty list.\n        return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:46:04.305741", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=Up (North), 1=Right (East), 2=Down (South), 3=Left (West))\n  DIR_UP = 0      # Agent facing North (decreases Y coordinate)\n  DIR_RIGHT = 1   # Agent facing East (increases X coordinate)\n  DIR_DOWN = 2    # Agent facing South (increases Y coordinate)\n  DIR_LEFT = 3    # Agent facing West (decreases X coordinate)\n\n  # Define a maximum number of steps for the BFS to find a path.\n  # This prevents excessively long search times and limits the total length\n  # of the generated action sequence, including the final ACTION_USE.\n  MAX_COLLECT_STEPS = 100 \n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent,\n      based on the agent's current position (y, x) and facing direction.\n\n      Args:\n          y (int): Agent's current row coordinate.\n          x (int): Agent's current column coordinate.\n          direction (int): Agent's current facing direction (DIR_UP, DIR_RIGHT, DIR_DOWN, DIR_LEFT).\n\n      Returns:\n          tuple[int, int]: (row, column) coordinates of the cell in front.\n      \"\"\"\n      if direction == DIR_UP:\n          return y - 1, x\n      elif direction == DIR_RIGHT:\n          return y, x + 1\n      elif direction == DIR_DOWN:\n          return y + 1, x\n      elif direction == DIR_LEFT:\n          return y, x - 1\n      # This case should ideally not be reached with valid direction inputs.\n      return y, x\n\n  actions_taken = []\n\n  # Access the underlying CraftState instance directly to get the current state information.\n  # This allows `collect_v2` to be called mid-episode without resetting the environment,\n  # supporting composition of actions.\n  current_state = env._current_state\n\n  # --- Initial validation and early exit conditions ---\n  \n  # 1. Check if the `primitive` ID is recognized by the world's cookbook.\n  # If the primitive is not a valid kind in the world, it cannot be collected.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # 2. Check if the `primitive` is already in the agent's inventory.\n  # If already collected, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n  \n  # 3. If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # --- Retrieve necessary environment information for pathfinding ---\n  full_grid = current_state.grid # Use the actual current grid state\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir\n\n  # Determine which entity kinds block agent movement (i.e., cells agents cannot traverse).\n  # Workshops are typically traversable, even if non-grabbable, to allow crafting.\n  impassable_for_movement = set()\n  \n  # Add water if it exists and is defined as a kind, as it's usually impassable.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  # Add other non-grabbable items that are not workshops to the impassable set.\n  # Convert workshop_indices to a set for faster lookup during traversal checks.\n  workshop_indices_set = set(current_state.world.workshop_indices) \n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in workshop_indices_set:\n          impassable_for_movement.add(k_idx)\n\n  # Convert to a list for efficient numpy indexing later if the set is populated.\n  impassable_kinds_list = list(impassable_for_movement)\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # The agent's direction is assumed to update to face the cardinal direction of its last movement.\n  # Format: {ACTION_CONSTANT: (resulting_direction_constant, dy, dx)}\n  # This mapping ensures consistency with CraftState.dir values (0=Up, 1=Right, etc.).\n  movement_actions_map = {\n      ACTION_UP:    (DIR_UP, -1, 0),    # Move North (dy=-1, dx=0), agent faces Up (North)\n      ACTION_RIGHT: (DIR_RIGHT, 0, 1),  # Move East (dy=0, dx=1), agent faces Right (East)\n      ACTION_DOWN:  (DIR_DOWN, 1, 0),   # Move South (dy=1, dx=0), agent faces Down (South)\n      ACTION_LEFT:  (DIR_LEFT, 0, -1)   # Move West (dy=0, dx=-1), agent faces Left (West)\n  }\n\n  # Initialize Breadth-First Search (BFS) queue.\n  # Each state in the queue is a tuple: (current_y, current_x, current_direction, path_of_actions_so_far).\n  # Storing the current direction is crucial because ACTION_USE depends on agent orientation for non-grabbables.\n  bfs_queue = collections.deque()\n  bfs_queue.append((start_y, start_x, start_dir, []))\n  \n  # Keep track of visited states (position + orientation) to prevent redundant exploration and infinite loops.\n  visited_states = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None  # This variable will store the final sequence of actions if a valid path is found.\n\n  # Determine if the primitive is a \"grabbable\" item (picked up by moving onto its cell and using USE)\n  # or a \"non-grabbable\" item (interacted with from an adjacent cell by facing it and using USE).\n  is_primitive_grabbable = primitive in current_state.world.grabbable_indices\n\n  # --- BFS to find the shortest action sequence to collect the primitive ---\n  while bfs_queue:\n      curr_y, curr_x, curr_dir, current_path_actions = bfs_queue.popleft()\n\n      # Pruning: If the current path length (movement actions only) is already\n      # strictly greater than MAX_COLLECT_STEPS, it cannot lead to a valid solution.\n      if len(current_path_actions) > MAX_COLLECT_STEPS:\n          continue\n\n      # --- Goal Check: Determine if the primitive can be collected from the current state (position and direction) ---\n      can_collect_now = False\n      if is_primitive_grabbable:\n          # For grabbable items, ACTION_USE collects them from the same cell, regardless of facing direction.\n          if full_grid[curr_y, curr_x, primitive] > 0:\n              can_collect_now = True\n      else:\n          # For non-grabbable items, ACTION_USE interacts with the object in the cell directly in front.\n          facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n          # Check if the facing cell is within grid boundaries and contains the target primitive.\n          if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n              full_grid[facing_y, facing_x, primitive] > 0):\n              can_collect_now = True\n      \n      if can_collect_now:\n          candidate_path = current_path_actions + [ACTION_USE]\n          # Ensure the total path length (including the USE action) does not exceed the limit.\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              break # Found the shortest path, exit BFS.\n\n      # --- Explore neighboring cells via movement actions ---\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          \n          # Pruning: If adding this movement action would result in a path length\n          # that *already equals or exceeds* the MAX_COLLECT_STEPS, it means there's\n          # no room left for the final ACTION_USE (which would make it MAX_COLLECT_STEPS + 1).\n          # This makes the search more efficient by stopping paths earlier.\n          if len(current_path_actions) + 1 >= MAX_COLLECT_STEPS: \n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable (does not contain impassable entities).\n          # If impassable_kinds_list is empty, np.any will operate on an empty array, returning False (no impassable items found).\n          if impassable_kinds_list and np.any(full_grid[next_y, next_x, impassable_kinds_list] > 0):\n              continue\n\n          # Check if this new (position, direction) state has already been visited\n          # to prevent redundant exploration and infinite loops.\n          if (next_y, next_x, next_dir) in visited_states:\n              continue\n\n          # If all checks pass, add the new state to the queue for further exploration.\n          visited_states.add((next_y, next_x, next_dir))\n          bfs_queue.append((next_y, next_x, next_dir, current_path_actions + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      # If no valid path was found within the step limit, return an empty list.\n      return []\n\n  for action in path_to_execute:\n      actions_taken.append(action)\n      # Perform the action in the environment. We only care about the resulting state.\n      _, done, _ = env.step(action)\n      \n      # Update the internal state reference to reflect the current environment after the step.\n      current_state = env._current_state\n\n      # If the primitive is successfully collected at any point (e.g., immediate pickup or during USE),\n      # we can stop early and return the actions taken so far.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n      # If the episode terminates (`done` is True) but the primitive was NOT collected,\n      # it implies failure. In this case, the current partial path is invalid.\n      if done and current_state.inventory[primitive] <= 0:\n          return []\n\n  # Final verification: After executing all actions in the `path_to_execute`,\n  # confirm that the primitive was indeed collected into the inventory.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it indicates an unhandled environmental factor (e.g., tool requirement, resource depletion).\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T23:46:05.277943", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:47:00.819335", "function_name": "collect", "function_body": "  import collections\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  actions_to_take = []\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario (they are constant for a scenario)\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position from [0,1] to grid coordinates\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Define specific indices that act as obstacles for movement.\n  # Water is explicitly defined as an entity and typically acts as an impassable barrier.\n  # Other non-grabbable entities like workshops might be traversable.\n  obstacles_indices = {env.world.water_index} \n\n  # Helper function to check if a cell (x, y) is traversable\n  def _is_traversable(x, y):\n      # Check bounds of the grid\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return False\n      \n      # Check if the cell contains any of the identified obstacles\n      for k_idx in obstacles_indices:\n          if current_grid[x, y, k_idx] == 1:\n              return False # Contains an obstacle, thus not traversable\n      return True # Traversable (no explicitly defined obstacles present)\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell (value 1 indicates presence)\n      if current_grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  # Define potential target cells for the agent. The agent needs to reach a traversable cell\n  # in the 3x3 neighborhood of a primitive to successfully _USE it.\n  potential_agent_targets = set()\n  for prim_x, prim_y in primitive_locations:\n    for dx in range(-1, 2): # -1, 0, 1 (relative x-offset)\n      for dy in range(-1, 2): # -1, 0, 1 (relative y-offset)\n        target_x, target_y = prim_x + dx, prim_y + dy\n        # Only add a cell as a potential target if it's within bounds and traversable\n        if _is_traversable(target_x, target_y):\n            potential_agent_targets.add((target_x, target_y))\n            \n  # If no traversable target positions can be found near any primitive (e.g., all are blocked by obstacles),\n  # the primitive is unreachable, so return an empty action list.\n  if not potential_agent_targets:\n      return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path from the current position\n  # to any of the potential_agent_targets, considering traversability.\n  queue = collections.deque([(current_pos, [])]) # Queue stores (position, path_actions_to_reach_position)\n  visited = {current_pos} # Set of visited (x,y) positions to prevent cycles and redundant exploration\n\n  target_path = None\n\n  while queue:\n    (curr_x, curr_y), path = queue.popleft()\n\n    # If the current position is one of our valid target positions, we've found the shortest path.\n    if (curr_x, curr_y) in potential_agent_targets:\n      target_path = path\n      break # Exit BFS as the shortest path to a target has been found\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n    neighbors_info = [\n        ((curr_x, curr_y - 1), _UP),\n        ((curr_x, curr_y + 1), _DOWN),\n        ((curr_x - 1, curr_y), _LEFT),\n        ((curr_x + 1, curr_y), _RIGHT),\n    ]\n\n    for (nx, ny), action in neighbors_info:\n      # Check if the neighbor is traversable and has not been visited yet\n      if _is_traversable(nx, ny) and (nx, ny) not in visited:\n        visited.add((nx, ny)) # Mark as visited to avoid cycles\n        queue.append(((nx, ny), path + [action])) # Add to queue with updated path\n\n  # If no path was found (e.g., all targets are unreachable due to obstacles, or no targets exist)\n  if target_path is None:\n    return []\n\n  # The actions to take are the path found by BFS to the target cell,\n  # followed by the _USE action to collect the primitive.\n  actions_to_take = target_path + [_USE]\n\n  return actions_to_take", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T23:47:01.798272", "function_name": "collect", "function_body": "  import collections\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  inventory = features_dict['inventory'] # Get current inventory\n\n  # IMPROVEMENT: If the primitive is already in the agent's inventory, no actions are needed to collect it.\n  if inventory[primitive] > 0:\n    return []\n\n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Define specific indices that act as obstacles for movement.\n  # Water is explicitly mentioned as an entity and typically acts as a barrier.\n  obstacles_indices = {env.world.water_index} \n\n  # Helper function to check if a cell (x, y) is traversable\n  def _is_traversable(x, y):\n      # Check bounds\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return False\n      \n      # Check if the cell contains any of the identified obstacles\n      for k_idx in obstacles_indices:\n          if current_grid[x, y, k_idx] == 1:\n              return False # Contains an obstacle, thus not traversable\n      return True # Traversable (no explicitly defined obstacles present)\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell\n      if current_grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  # Define potential target cells for the agent: any traversable cell in the 3x3 neighborhood of a primitive.\n  # The agent needs to reach one of these cells to successfully _USE the primitive.\n  potential_agent_targets = set()\n  for prim_x, prim_y in primitive_locations:\n    for dx in range(-1, 2):\n      for dy in range(-1, 2):\n        target_x, target_y = prim_x + dx, prim_y + dy\n        # Only add a cell as a potential target if it's within bounds and traversable\n        if _is_traversable(target_x, target_y):\n            potential_agent_targets.add((target_x, target_y))\n            \n  # If no traversable target positions can be found near any primitive, the primitive is unreachable.\n  if not potential_agent_targets:\n      return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path from the current position\n  # to any of the potential_agent_targets, considering obstacles.\n  queue = collections.deque([(current_pos, [])]) # Queue stores (position, path_actions_to_reach_position)\n  visited = {current_pos} # Set of visited (x,y) positions to prevent cycles and redundant exploration\n\n  target_path = None\n\n  while queue:\n    (curr_x, curr_y), path = queue.popleft()\n\n    # If the current position is one of our valid target positions, we've found the shortest path.\n    if (curr_x, curr_y) in potential_agent_targets:\n      target_path = path\n      break # Exit BFS as we found the shortest path\n\n    # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n    neighbors_info = [\n        ((curr_x, curr_y - 1), _UP),\n        ((curr_x, curr_y + 1), _DOWN),\n        ((curr_x - 1, curr_y), _LEFT),\n        ((curr_x + 1, curr_y), _RIGHT),\n    ]\n\n    for (nx, ny), action in neighbors_info:\n      # Check if the neighbor is traversable and has not been visited yet\n      if _is_traversable(nx, ny) and (nx, ny) not in visited:\n        visited.add((nx, ny)) # Mark as visited\n        queue.append(((nx, ny), path + [action])) # Add to queue with updated path\n\n  # If no path was found (e.g., all targets are unreachable due to obstacles)\n  if target_path is None:\n    return []\n\n  # The actions to take are the path to the target cell, followed by the USE action\n  actions_to_take = target_path + [_USE]\n\n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:48:41.251293", "function_name": "collect", "function_body": "  # Reset the environment to a known initial state\n  # This ensures we work from a consistent starting point for the pathfinding.\n  # The observation dictionary is not directly used for pathfinding, so we can discard it.\n  # The `env` is a CraftLab instance.\n  _ = env.reset() \n  current_state = env._current_state\n\n  initial_pos = current_state.pos\n  grid = current_state.grid\n  # Grid dimensions: (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Step 1: Check if already next to the primitive\n  # Action mapping: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  if current_state.next_to(primitive):\n      return [4] # USE action\n\n  # Step 2: Find all locations of the primitive on the grid\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          if grid[r, c, primitive] > 0:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      # Primitive not found anywhere on the grid\n      return []\n\n  # Step 3: Perform BFS to find the shortest path to a cell adjacent to the primitive\n  # Queue stores (row, col, list_of_actions_to_reach_here)\n  q = collections.deque([(initial_pos[0], initial_pos[1], [])])\n  visited = set([(initial_pos[0], initial_pos[1])])\n\n  # Mappings for movement actions (action_id, dr, dc)\n  moves = {\n      1: (-1, 0),    # UP\n      0: (1, 0),     # DOWN\n      2: (0, -1),    # LEFT\n      3: (0, 1)      # RIGHT\n  }\n\n  while q:\n      r, c, path_actions = q.popleft()\n\n      # Check if the current position (r, c) is adjacent to any primitive location\n      # This is our goal condition for BFS.\n      is_goal_position = False\n      for pr, pc in primitive_locations:\n          # Check if (r, c) is directly adjacent (up, down, left, right) to (pr, pc)\n          if (abs(r - pr) == 1 and c == pc) or (abs(c - pc) == 1 and r == pr):\n              is_goal_position = True\n              break\n      \n      if is_goal_position:\n          # Found the shortest path to a position from which `USE` can collect the primitive.\n          return path_actions + [4] # USE action\n\n      # Explore neighbors\n      for action, (dr, dc) in moves.items():\n          nr, nc = r + dr, c + dc\n\n          # Check boundaries\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n\n          # Check if the next cell (nr, nc) is an obstacle\n          # A cell is an obstacle if it contains any non-grabbable entity\n          # that is NOT the target primitive itself.\n          is_obstacle = False\n          # np.where returns a tuple of arrays, we want the first array for indices\n          kinds_at_cell = np.where(grid[nr, nc] > 0)[0] \n\n          for k_idx in kinds_at_cell:\n              if k_idx in current_state.world.non_grabbable_indices and k_idx != primitive:\n                  is_obstacle = True\n                  break\n          \n          if is_obstacle:\n              continue\n\n          if (nr, nc) not in visited:\n              visited.add((nr, nc))\n              q.append((nr, nc, path_actions + [action]))\n\n  # If BFS completes and no path was found to an adjacent cell\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:48:42.232612", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants, derived from action_specs in CraftLab\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Get current state from the environment\n  state = env._current_state\n\n  # Check if primitive is already in inventory\n  if state.inventory[primitive] > 0:\n    return [] # Primitive already collected, no actions needed\n\n  grid = state.grid\n  current_pos_x, current_pos_y = state.pos # Agent's current (x, y) position\n  world = env.world # Reference to CraftWorld for indices\n\n  # Get grid dimensions\n  # Assuming grid is (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Helper to check if a cell is traversable/walkable\n  # A cell is considered walkable if it's within bounds and not occupied by a non-grabbable obstacle\n  # (excluding workshops, which are typically walkable).\n  # The `non_grabbable_indices` set contains indices of items the agent cannot walk through.\n  # Workshops are explicitly defined as being in non_grabbable_indices, but are generally walkable.\n  def is_walkable(x, y):\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False # Out of bounds\n    \n    # Check if this cell contains any non-grabbable item that is not a workshop.\n    # If it does, it's considered an impassable obstacle for movement.\n    for kind_idx in world.non_grabbable_indices:\n      if kind_idx in world.workshop_indices:\n        continue # Workshops are walkable, so skip obstacle check for them\n      if grid[x, y, kind_idx] > 0:\n        return False # This cell is occupied by an impassable non-grabbable item\n    return True\n\n  # Find locations of the primitive on the grid\n  # np.argwhere returns (row, col) pairs. For a (WIDTH, HEIGHT, N) grid, this corresponds to (x, y).\n  primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n  if len(primitive_locations) == 0:\n    return [] # Primitive not found on the grid anywhere on the grid\n\n  # Determine if the primitive itself is a \"grabbable\" item (e.g., stone, wood, water)\n  # If it is grabbable, the agent can typically move onto its cell and then use it.\n  # If not grabbable (e.g., a crafted item from a workshop), the agent must be adjacent to it.\n  is_primitive_grabbable = primitive in world.grabbable_indices\n\n  # BFS setup to find the shortest path\n  q = collections.deque()\n  # Queue stores (x, y, list_of_actions_to_reach_here)\n  q.append((current_pos_x, current_pos_y, []))\n  \n  visited = set()\n  visited.add((current_pos_x, current_pos_y))\n\n  # Define movement deltas for each action (UP, DOWN, LEFT, RIGHT)\n  move_deltas = {\n      UP: (0, -1),   # (dx, dy) for moving UP (North)\n      DOWN: (0, 1),   # (dx, dy) for moving DOWN (South)\n      LEFT: (-1, 0),  # (dx, dy) for moving LEFT (West)\n      RIGHT: (1, 0),  # (dx, dy) for moving RIGHT (East)\n  }\n\n  while q:\n    curr_x, curr_y, path_so_far = q.popleft()\n\n    # Check if the current position (curr_x, curr_y) is a valid spot\n    # from which to collect the primitive (i.e., by performing a USE action).\n    # This means being either on top of a grabbable primitive, or adjacent to any primitive.\n    for p_x, p_y in primitive_locations:\n        if is_primitive_grabbable and (curr_x, curr_y) == (p_x, p_y):\n            # If the primitive is grabbable, the agent can be directly on its location.\n            # The `USE` action will then collect it.\n            return path_so_far + [USE]\n        elif not is_primitive_grabbable and (abs(curr_x - p_x) + abs(curr_y - p_y) == 1):\n            # If the primitive is not grabbable (e.g., a resource that needs to be \"mined\" or a crafted item),\n            # the agent needs to be adjacent to it.\n            # The `CraftState.next_to` method checks the 3x3 neighborhood, which includes adjacency.\n            # Assuming `USE` operates on adjacent items as well.\n            return path_so_far + [USE]\n\n    # Explore neighbors for next possible moves (UP, DOWN, LEFT, RIGHT)\n    for action, (dx, dy) in move_deltas.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      \n      if is_walkable(next_x, next_y) and (next_x, next_y) not in visited:\n        visited.add((next_x, next_y))\n        q.append((next_x, next_y, path_so_far + [action]))\n\n  return [] # No path found to collect the primitive", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:50:09.535109", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Constants for directions and actions, derived from CraftWorld/CraftLab design.\n    # Agent directions (NORTH, EAST, SOUTH, WEST) correspond to 0, 1, 2, 3 respectively.\n    DR = [-1, 0, 1, 0] # Delta Row for (N, E, S, W)\n    DC = [0, 1, 0, -1] # Delta Column for (N, E, S, W)\n\n    # Maps CraftLab move actions to (delta_row, delta_col, new_agent_direction)\n    # new_agent_direction is the integer 0-3 representing (N, E, S, W)\n    ACTION_MOVE_MAPPING = {\n        0: (1, 0, 2),  # DOWN: dr=1, dc=0, new_dir=SOUTH (2)\n        1: (-1, 0, 0), # UP: dr=-1, dc=0, new_dir=NORTH (0)\n        2: (0, -1, 3), # LEFT: dr=0, dc=-1, new_dir=WEST (3)\n        3: (0, 1, 1)   # RIGHT: dr=0, dc=1, new_dir=EAST (1)\n    }\n    ACTION_USE = 4\n\n    # Get the current state information from the environment.\n    # We access the internal _current_state of CraftLab for direct access\n    # to attributes like position and world details without normalization issues.\n    current_state = env._current_state\n    \n    grid = current_state.grid # (H, W, N_KINDS)\n    current_pos = current_state.pos # (row, col) tuple\n    current_dir = current_state.dir # integer (0-3 for N,E,S,W)\n    inventory = current_state.inventory # numpy array of item counts\n\n    H, W, N_KINDS = grid.shape\n\n    # Get indices of entities that cannot be traversed (obstacles for movement).\n    # These are typically non-grabbable items like water, stone (if not primitive itself).\n    # Workshops are not obstacles for movement.\n    obstacles_indices = current_state.world.non_grabbable_indices\n    \n    # 1. Check if the primitive is already in the inventory.\n    if inventory[primitive] > 0:\n        return []\n\n    # 2. Locate all instances of the primitive on the grid.\n    primitive_locations = []\n    for r in range(H):\n        for c in range(W):\n            if grid[r, c, primitive] == 1:\n                primitive_locations.append((r, c))\n    \n    if not primitive_locations:\n        # If the primitive is not found anywhere on the grid, it cannot be collected.\n        return []\n\n    # 3. Determine all valid \"pre-USE\" states (agent_r, agent_c, agent_dir)\n    # from which the 'USE' action would successfully target a primitive.\n    # The 'USE' action targets the cell directly in front of the agent.\n    # So, if a primitive is at (pr, pc), and the agent is at (ar, ac) facing 'd',\n    # then (ar + DR[d], ac + DC[d]) must equal (pr, pc).\n    # This implies (ar, ac) = (pr - DR[d], pc - DC[d]).\n    \n    use_target_states = set() # Stores (agent_r, agent_c, agent_dir) tuples\n    \n    for pr, pc in primitive_locations:\n        for d in range(4): # Iterate through all possible agent directions (N, E, S, W)\n            # Calculate the agent's position (ar, ac) that would allow 'USE' on (pr, pc)\n            ar = pr - DR[d]\n            ac = pc - DC[d]\n            \n            # Ensure this calculated agent position is within grid boundaries.\n            if not (0 <= ar < H and 0 <= ac < W):\n                continue\n            \n            # Ensure the agent's position itself is traversable (not an obstacle).\n            is_agent_pos_traversable = True\n            for k in obstacles_indices:\n                if grid[ar, ac, k] == 1: # If the cell (ar, ac) contains an obstacle\n                    is_agent_pos_traversable = False\n                    break\n            \n            if is_agent_pos_traversable:\n                use_target_states.add((ar, ac, d))\n    \n    # If no valid use_target_states can be formed (e.g., all primitives are surrounded by obstacles),\n    # then collection is impossible.\n    if not use_target_states:\n        return []\n\n    # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n    # from the current agent state to any of the `use_target_states`.\n    \n    q = collections.deque()\n    # BFS state: (current_row, current_col, current_agent_direction, list_of_actions_taken)\n    q.append((current_pos[0], current_pos[1], current_dir, []))\n    \n    # Keep track of visited states to avoid cycles and redundant paths.\n    # A state is defined by (row, col, agent_direction).\n    visited = set([(current_pos[0], current_pos[1], current_dir)])\n\n    while q:\n        r, c, d, path = q.popleft()\n\n        # Check if the current state (r, c, d) is one of our target states\n        # from which the 'USE' action can be immediately performed.\n        if (r, c, d) in use_target_states:\n            return path + [ACTION_USE]\n\n        # Explore all possible move actions from the current state.\n        for action_val, (dr_move, dc_move, new_dir) in ACTION_MOVE_MAPPING.items():\n            next_r, next_c = r + dr_move, c + dc_move\n            \n            # Check if the next cell is within grid boundaries.\n            if not (0 <= next_r < H and 0 <= next_c < W):\n                continue\n            \n            # Check if the next cell is an obstacle (not traversable).\n            is_obstacle = False\n            for k in obstacles_indices:\n                if grid[next_r, next_c, k] == 1:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n            \n            next_state = (next_r, next_c, new_dir)\n            \n            # If this next state has not been visited, add it to the queue.\n            if next_state not in visited:\n                visited.add(next_state)\n                q.append((next_r, next_c, new_dir, path + [action_val]))\n\n    # If the BFS queue becomes empty and no path to a `use_target_state` was found,\n    # it means the primitive is unreachable or uncollectible from the current state.\n    return []", "island_id": 1, "scores": {"3": -1}}
