{"timestamp": "2025-07-30T04:27:13.417748", "function_name": "collect", "function_body": "    # Assumed imports for collections and numpy are available in the scope\n    # import collections\n    # import numpy as np\n\n    # Action constants from env_factory\n    actions = env_factory.actions \n\n    # Map (dx, dy) movement to action and new facing direction.\n    # The direction mapping assumes: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT.\n    # This is consistent with common DMLab/gym-style environments\n    # where actions modify facing direction.\n    MOVE_MAP = {\n        (0, -1): (actions.UP,    0),  # Move UP (dy=-1), agent faces UP (dir=0)\n        (0, 1):  (actions.DOWN,  2),  # Move DOWN (dy=1), agent faces DOWN (dir=2)\n        (-1, 0): (actions.LEFT,  3),  # Move LEFT (dx=-1), agent faces LEFT (dir=3)\n        (1, 0):  (actions.RIGHT, 1)   # Move RIGHT (dx=1), agent faces RIGHT (dir=1)\n    }\n\n    # Map current facing direction (int) to its (dx, dy) offset for the cell directly in front.\n    FACING_OFFSETS = {\n        0: (0, -1),  # UP (dir=0) looks at (x, y-1)\n        1: (1, 0),   # RIGHT (dir=1) looks at (x+1, y)\n        2: (0, 1),   # DOWN (dir=2) looks at (x, y+1)\n        3: (-1, 0)   # LEFT (dir=3) looks at (x-1, y)\n    }\n\n    current_state = env._current_state\n    grid = current_state.grid\n    start_pos = current_state.pos\n    start_dir = current_state.dir # Initial facing direction of the agent\n\n    # Check if the primitive is already in the inventory\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected\n\n    # Grid dimensions (assuming grid is (WIDTH, HEIGHT, N_KINDS))\n    WIDTH, HEIGHT, _ = grid.shape\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # BFS Initialization\n    # Queue stores tuples: (current_x, current_y, current_facing_dir, list_of_actions_to_reach_here)\n    queue = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n    # Visited set stores tuples: (x, y, facing_dir) to prevent cycles and redundant exploration\n    visited = {(start_pos[0], start_pos[1], start_dir)}\n\n    while queue:\n        curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n        # 1. Check if the primitive is directly in front of the agent and can be collected\n        # Calculate the coordinates of the cell directly in front of the agent\n        front_dx, front_dy = FACING_OFFSETS[curr_dir]\n        front_x, front_y = curr_x + front_dx, curr_y + front_dy\n\n        # Check if the cell in front is within grid boundaries\n        if 0 <= front_x < WIDTH and 0 <= front_y < HEIGHT:\n            # Check if the primitive is present in the cell in front\n            if grid[front_x, front_y, primitive] > 0:\n                # If the primitive is there, we can use the USE action to collect it.\n                return path_actions + [actions.USE]\n\n        # 2. Explore movement actions (UP, DOWN, LEFT, RIGHT)\n        for (dx, dy), (action, new_dir) in MOVE_MAP.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n\n            # Check if the next cell is within grid boundaries\n            if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                continue\n\n            # Check if the next cell is traversable (not blocked by non-grabbable items)\n            is_blocked = False\n            for kind_idx in non_grabbable_indices:\n                if grid[next_x, next_y, kind_idx] > 0:\n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue\n\n            # If this state (position and facing direction) has not been visited yet\n            if (next_x, next_y, new_dir) not in visited:\n                visited.add((next_x, next_y, new_dir))\n                # Add the new state to the queue with the updated path\n                queue.append((next_x, next_y, new_dir, path_actions + [action]))\n    \n    # If the queue becomes empty and no path to collect the primitive was found\n    return []", "island_id": 8, "scores": {"3": -1}}
