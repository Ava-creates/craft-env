{"timestamp": "2025-07-30T21:41:40.787257", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants based on the problem description's action_specs\n  _DOWN = 0\n  _UP = 1\n  _LEFT = 2\n  _RIGHT = 3\n  _USE = 4\n\n  # 1. Initialize and reset env\n  # Resetting the environment to a known state for deterministic execution.\n  # In a larger system, this might be handled externally or depend on context.\n  _ = env.reset(seed=0)\n  current_state = env._current_state\n\n  primitive_idx = primitive\n  # Get grid dimensions (WIDTH, HEIGHT) and number of kinds\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # 2. Goal Check: Is the primitive already in the inventory?\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already collected, no actions needed\n\n  # Helper function to check if a position is valid and within grid bounds\n  def is_valid_pos(x, y):\n    return 0 <= x < WIDTH and 0 <= y < HEIGHT\n\n  # Helper function to check if a cell (x, y) is an obstacle\n  # An obstacle is a cell containing any non-grabbable item.\n  def is_obstacle(x, y):\n    if not is_valid_pos(x, y):\n      return True # Out of bounds is an obstacle\n    \n    # Iterate through all non-grabbable indices defined in the world\n    for non_grabbable_k_idx in current_state.world.non_grabbable_indices:\n      # If this non-grabbable item exists at (x, y) on its layer\n      if current_state.grid[x, y, non_grabbable_k_idx] > 0:\n        return True # It's an obstacle\n    return False\n\n  # 3. Scan the entire grid to find all locations where the primitive exists\n  all_primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive_idx layer at (x, y) has a value > 0\n      if current_state.grid[x, y, primitive_idx] > 0:\n        all_primitive_locations.append((x, y))\n\n  if not all_primitive_locations:\n    return [] # Primitive not found anywhere on the grid, cannot collect\n\n  # 4. Determine the best target position for the agent to stand (adjacent to a primitive)\n  # We need to find a cell (nx, ny) from which the agent can \"USE\" the primitive.\n  # This cell must be valid and reachable, and adjacent to a primitive.\n  \n  best_target_agent_pos = None\n  min_manhattan_dist = float('inf')\n  \n  # Possible movement deltas and their corresponding actions\n  # (dx, dy, action)\n  cardinal_moves = [\n      (0, 1, _DOWN),  # South\n      (0, -1, _UP),   # North\n      (1, 0, _RIGHT), # East\n      (-1, 0, _LEFT)  # West\n  ]\n\n  # Iterate through all discovered primitive locations\n  for px, py in all_primitive_locations:\n    # Consider the 4 cardinal neighbors of the primitive as potential agent target positions\n    for dx_adj, dy_adj, _ in cardinal_moves: # Action here is irrelevant for target selection\n      nx, ny = px + dx_adj, py + dy_adj # A potential spot for the agent\n      \n      # Check if this potential agent position is valid and not an obstacle\n      if is_valid_pos(nx, ny) and not is_obstacle(nx, ny):\n        # Calculate Manhattan distance from current agent position to this potential target\n        dist = abs(current_state.pos[0] - nx) + abs(current_state.pos[1] - ny)\n        \n        # If this target is closer, or equally close but preferred (e.g. by smaller coords)\n        if dist < min_manhattan_dist:\n          min_manhattan_dist = dist\n          best_target_agent_pos = (nx, ny)\n\n  if best_target_agent_pos is None:\n    # No reachable valid position adjacent to any primitive was found\n    return [] # Primitive is effectively unreachable\n\n  # 5. BFS to find the shortest path from the agent's current position to `best_target_agent_pos`\n  q_pathfind = collections.deque([(current_state.pos, [])]) # Queue: ((x, y), [actions_list])\n  visited_pathfind = {current_state.pos} # Set of visited (x, y) positions\n  \n  path_to_primitive_vicinity = []\n\n  while q_pathfind:\n    (cx, cy), current_path_actions = q_pathfind.popleft()\n\n    # If the current position is our target, we found the path\n    if (cx, cy) == best_target_agent_pos:\n      path_to_primitive_vicinity = current_path_actions\n      break # Path found, exit BFS\n\n    # Explore neighbors\n    for dx, dy, action in cardinal_moves:\n      nx, ny = cx + dx, cy + dy\n      \n      if is_valid_pos(nx, ny) and (nx, ny) not in visited_pathfind and not is_obstacle(nx, ny):\n        visited_pathfind.add((nx, ny))\n        q_pathfind.append(((nx, ny), current_path_actions + [action]))\n\n  if not path_to_primitive_vicinity and current_state.pos != best_target_agent_pos:\n    # This means the target position is unreachable (e.g., surrounded by obstacles)\n    # or the initial position is already the target and BFS didn't find an empty path.\n    # If current_state.pos == best_target_agent_pos, path_to_primitive_vicinity will be [] (correct).\n    # Otherwise, if it's not the target and no path was found, it's unreachable.\n    return [] \n\n  # 6. Execute the found path and then use the primitive\n  actions_taken = []\n  \n  # Execute movement actions\n  for action in path_to_primitive_vicinity:\n    _, done, _ = env.step(action)\n    actions_taken.append(action)\n    current_state = env._current_state # Update current_state after each step\n    \n    if done:\n      # Environment terminated before reaching target or collecting\n      return actions_taken\n    \n    # Check if primitive was collected incidentally during movement (unlikely but possible)\n    if current_state.inventory[primitive_idx] > 0:\n      return actions_taken\n\n  # Agent should now be at `best_target_agent_pos`, adjacent to the primitive.\n  # Now, attempt to USE the primitive.\n  \n  # Before using, ensure the primitive is actually next to the agent.\n  # This serves as a robustness check, though pathfinding should ensure it.\n  if not current_state.next_to(primitive_idx):\n    # This indicates an issue with target selection or primitive disappearance.\n    return actions_taken # Failed to collect, return actions taken so far.\n\n  # Perform USE action until collected or max attempts (to prevent infinite loops)\n  max_use_attempts = 5 \n  use_attempts = 0\n  while current_state.inventory[primitive_idx] == 0 and use_attempts < max_use_attempts:\n    _, done, _ = env.step(_USE)\n    actions_taken.append(_USE)\n    current_state = env._current_state # Update state after USE\n    use_attempts += 1\n    \n    if done:\n      # Environment terminated during USE attempts\n      break\n            \n  return actions_taken", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:41:41.749728", "function_name": "collect", "function_body": "  import collections\n\n  # Define constants for actions and directions locally for clarity within the function.\n  # CraftLab actions as mapped by action_specs:\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Maps CraftLab move actions to (dr, dc) deltas for grid traversal.\n  MOVE_DELTAS = {\n      ACTION_UP:    (-1, 0),  # Moving UP (row-1, col)\n      ACTION_DOWN:  (1, 0),   # Moving DOWN (row+1, col)\n      ACTION_LEFT:  (0, -1),  # Moving LEFT (row, col-1)\n      ACTION_RIGHT: (0, 1)    # Moving RIGHT (row, col+1)\n  }\n\n  # Maps CraftLab move actions to the agent's resulting internal direction (0-3).\n  # As per CraftState.step: UP=0(N), RIGHT=1(E), DOWN=2(S), LEFT=3(W).\n  ACTION_TO_AGENT_DIR = {\n      ACTION_UP:    0,  # UP action makes agent face North (0)\n      ACTION_RIGHT: 1,  # RIGHT action makes agent face East (1)\n      ACTION_DOWN:  2,  # DOWN action makes agent face South (2)\n      ACTION_LEFT:  3   # LEFT action makes agent face West (3)\n  }\n\n  # Maps agent's internal direction (0-3) to (dr, dc) delta for the USE action.\n  # This determines which cell the agent attempts to interact with.\n  AGENT_DIR_TO_DELTA = {\n      0: (-1, 0),  # North: targets cell (row-1, col)\n      1: (0, 1),   # East: targets cell (row, col+1)\n      2: (1, 0),   # South: targets cell (row+1, col)\n      3: (0, -1)   # West: targets cell (row, col-1)\n  }\n\n  # Get the current state from the CraftLab environment.\n  state = env._current_state\n  grid = state.grid\n  start_pos = state.pos\n  start_dir = state.dir  # The agent's initial facing direction\n\n  # Grid dimensions (height = rows, width = columns)\n  height, width, n_kinds = grid.shape\n\n  # Get indices of entities that cannot be walked upon (obstacles).\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Initialize a queue for Breadth-First Search (BFS).\n  # Each element in the queue is (current_position_tuple, current_agent_direction_int, list_of_actions_taken_so_far).\n  queue = collections.deque([(start_pos, start_dir, [])])\n\n  # Initialize a set to keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (position_tuple, agent_direction_int).\n  visited = set([(start_pos, start_dir)])\n\n  while queue:\n    curr_pos, curr_dir, path_actions = queue.popleft()\n\n    # --- Check if the primitive can be collected from the current state ---\n    # Determine the cell the agent would interact with if USE is performed.\n    target_dr, target_dc = AGENT_DIR_TO_DELTA[curr_dir]\n    target_r, target_c = curr_pos[0] + target_dr, curr_pos[1] + target_dc\n\n    # Check if the target cell is within grid boundaries.\n    if 0 <= target_r < height and 0 <= target_c < width:\n      # Check if the desired primitive is present in the target cell.\n      if grid[target_r, target_c, primitive] > 0:\n        # Goal reached: the primitive is in front of the agent.\n        # Append the USE action to the current path and return it.\n        return path_actions + [ACTION_USE]\n\n    # --- Explore possible move actions (UP, DOWN, LEFT, RIGHT) ---\n    for action_val in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n      dr, dc = MOVE_DELTAS[action_val]\n      next_r, next_c = curr_pos[0] + dr, curr_pos[1] + dc\n      next_pos = (next_r, next_c)\n\n      # Check if the next position is within the grid boundaries.\n      if not (0 <= next_r < height and 0 <= next_c < width):\n        continue  # Out of bounds, skip this move.\n\n      # Check if the next position is an obstacle.\n      is_obstacle = False\n      for idx in non_grabbable_indices:\n        if grid[next_r, next_c, idx] > 0:\n          is_obstacle = True\n          break\n      if is_obstacle:\n        continue  # Cannot move to an obstacle cell, skip this move.\n\n      # Determine the agent's new facing direction after this move.\n      next_dir = ACTION_TO_AGENT_DIR[action_val]\n\n      # If this new state (position and direction) has not been visited before, add it to the queue.\n      if (next_pos, next_dir) not in visited:\n        visited.add((next_pos, next_dir))\n        queue.append((next_pos, next_dir, path_actions + [action_val]))\n\n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable or not present in the accessible world.\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:43:18.313187", "function_name": "collect", "function_body": "  obs = env.observations()\n  current_grid = obs['features_dict']['features_global']\n  # `pos` is a numpy array (normalized floats), convert to integer tuple for grid coordinates\n  current_pos = (int(obs['features_dict']['pos'][0]), int(obs['features_dict']['pos'][1]))\n  current_inventory = obs['features_dict']['inventory']\n\n  WIDTH, HEIGHT, N_KINDS = current_grid.shape\n\n  # Check if the primitive is already collected\n  if current_inventory[primitive] > 0:\n    return [] # Already have it, no actions needed\n\n  # Find all locations on the grid where the primitive exists\n  target_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # A cell contains the primitive if its value at the primitive's kind index is > 0\n      if current_grid[x, y, primitive] > 0:\n        target_locations.append((x, y))\n\n  if not target_locations:\n    # Primitive not found anywhere on the current grid\n    return []\n\n  # Perform a Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples of (current_position, list_of_actions_to_reach_here)\n  # Using a list as a queue with a `head` index for efficiency (avoids pop(0) overhead)\n  q = [(current_pos, [])]\n  # Keep track of visited positions to avoid cycles and redundant paths\n  visited = {current_pos}\n\n  # Define movement actions (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT) and their corresponding (dx, dy) deltas\n  # Assuming (0,0) is top-left, x increases right, y increases down\n  action_deltas = {\n      0: (0, 1),   # DOWN\n      1: (0, -1),  # UP\n      2: (-1, 0),  # LEFT\n      3: (1, 0)    # RIGHT\n  }\n\n  shortest_path_actions = None\n  \n  # Manual queue processing using a head pointer\n  head = 0\n  while head < len(q):\n    curr_pos, path_actions = q[head]\n    head += 1\n\n    # If the current position contains the primitive, we've found a path\n    # For grabbable primitives, stepping on the tile is typically enough to collect them.\n    if curr_pos in target_locations:\n      shortest_path_actions = path_actions\n      break # Found the shortest path, no need to explore further\n\n    # Explore neighboring cells\n    for action_val, (dx, dy) in action_deltas.items():\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries and has not been visited\n      if (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT and next_pos not in visited):\n        # In this simplified model, we assume all cells are traversable unless specified.\n        # For typical CraftWorld primitives, agents can move onto item-containing cells.\n        visited.add(next_pos)\n        q.append((next_pos, path_actions + [action_val]))\n\n  if shortest_path_actions is None:\n    # No path found to any location containing the primitive\n    return []\n\n  return shortest_path_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:43:18.382908", "function_name": "collect", "function_body": "    current_state = env._current_state\n    \n    # 1. Check if the primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get relevant world info\n    world = env.world\n    grid = current_state.grid\n    HEIGHT, WIDTH, _ = grid.shape\n    \n    # Identify blocking entities based on CraftWorld common patterns\n    wall_idx = world.index.contents.get('wall') \n    \n    def is_traversable(r, c):\n        \"\"\"\n        Checks if the cell (r, c) is traversable for agent movement.\n        \"\"\"\n        if not (0 <= r < HEIGHT and 0 <= c < WIDTH):\n            return False # Out of bounds\n        \n        # Check for explicit walls\n        if wall_idx is not None and grid[r, c, wall_idx] > 0:\n            return False \n        \n        # Check for water/stone. These are generally obstacles for movement.\n        if grid[r, c, world.water_index] > 0 or grid[r, c, world.stone_index] > 0:\n            return False \n\n        # Workshops are generally traversable, and other grabbable items or floor are traversable.\n        return True\n\n    # Determine if primitive needs USE action or just movement (picked up by moving onto)\n    # Water, stone, and workshops typically require the USE action when adjacent.\n    needs_use = (primitive == world.water_index or\n                 primitive == world.stone_index or\n                 primitive in world.workshop_indices)\n\n    # BFS state: (row, col, agent_direction, path_taken)\n    queue = collections.deque([(current_state.pos[0], current_state.pos[1], current_state.dir, [])])\n    # Visited state: (row, col, agent_direction)\n    visited = set([(current_state.pos[0], current_state.pos[1], current_state.dir)])\n\n    # BFS search\n    while queue:\n        r, c, agent_dir, path = queue.popleft()\n\n        # Check if primitive is collected at current position\n        if not needs_use:\n            # For grabbable items, check if we've moved onto the cell containing it\n            if grid[r, c, primitive] > 0:\n                return path\n        else:\n            # For USE-able items, check if we are adjacent and can USE it\n            # Iterate through the 4 cells adjacent to the agent's current position (r, c)\n            for action_idx_move in [_ACTIONS[\"UP\"], _ACTIONS[\"DOWN\"], _ACTIONS[\"LEFT\"], _ACTIONS[\"RIGHT\"]]:\n                dr_adj, dc_adj = _DIRECTIONS_VEC[action_idx_move]\n                nr_adj, nc_adj = r + dr_adj, c + dc_adj\n                \n                # Check if the primitive is in this adjacent cell\n                if 0 <= nr_adj < HEIGHT and 0 <= nc_adj < WIDTH and grid[nr_adj, nc_adj, primitive] > 0:\n                    # Found the primitive in an adjacent cell. Now calculate turns and add USE.\n                    target_dir_vec = (dr_adj, dc_adj) # Vector from agent's current position to the primitive\n                    turn_actions = _get_turn_actions(agent_dir, target_dir_vec)\n                    return path + turn_actions + [_ACTIONS[\"USE\"]]\n\n        # Explore possible movement actions (UP, DOWN, LEFT, RIGHT)\n        # These actions move the agent to an adjacent traversable cell\n        for action_idx_move in [_ACTIONS[\"UP\"], _ACTIONS[\"DOWN\"], _ACTIONS[\"LEFT\"], _ACTIONS[\"RIGHT\"]]:\n            # Get the displacement for the action (which is also the direction vector)\n            dr, dc = _DIRECTIONS_VEC[action_idx_move] \n            \n            new_r, new_c = r + dr, c + dc\n            new_dir = agent_dir # Movement actions don't change agent's facing direction\n            \n            # Check if the new cell is traversable and not visited with the current direction\n            if is_traversable(new_r, new_c) and (new_r, new_c, new_dir) not in visited:\n                visited.add((new_r, new_c, new_dir))\n                queue.append((new_r, new_c, new_dir, path + [action_idx_move]))\n\n    return [] # No path found to collect the primitive", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:44:18.352379", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants for CraftLab environment, mapping numeric actions to their semantic meaning.\n  # These correspond to the values returned by CraftLab.action_specs().\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Define a maximum number of steps for the Breadth-First Search (BFS) to find a path.\n  # This serves as a practical limit on path length and prevents overly long computations\n  # in very large or complex environments.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to compute the grid coordinates of the cell directly in front of the agent.\n  # The agent's direction is assumed to follow a specific encoding:\n  # 0: Up (North), 1: Right (East), 2: Down (South), 3: Left (West).\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates (row, column) of the cell in front of the agent.\n\n      Args:\n          y (int): Agent's current row coordinate.\n          x (int): Agent's current column coordinate.\n          direction (int): Agent's current facing direction (0=Up, 1=Right, 2=Down, 3=Left).\n\n      Returns:\n          tuple[int, int]: (row, column) coordinates of the cell directly ahead.\n      \"\"\"\n      if direction == 0:  # Facing UP\n          return y - 1, x\n      if direction == 1:  # Facing RIGHT\n          return y, x + 1\n      if direction == 2:  # Facing DOWN\n          return y + 1, x\n      if direction == 3:  # Facing LEFT\n          return y, x - 1\n      # Fallback for unexpected direction values; typically not reached in a valid CraftWorld setup.\n      return y, x\n\n  # Retrieve the current state of the environment from the CraftLab wrapper.\n  # This allows the function to operate on the real-time state of the agent and grid,\n  # making it suitable for sequential planning without requiring an `env.reset()`.\n  current_state = env._current_state\n\n  # --- Initial Checks and Pre-conditions ---\n  \n  # 1. Validate the 'primitive' index. It must correspond to a known entity kind in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      # If the target primitive is unknown to the environment, it cannot be collected.\n      return []\n\n  # 2. Check if the primitive is already present in the agent's inventory.\n  # If the goal is already satisfied, no actions are necessary.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # 3. Defensive check: If the maximum allowed steps for pathfinding is non-positive,\n  # no path can be found, so return an empty list immediately.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # --- Extract Current Environment Information for Pathfinding ---\n\n  # Get the complete current grid layout, its dimensions, and the agent's initial position and direction.\n  full_grid = current_state.grid\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir \n\n  # Define the set of entity kinds that act as impassable obstacles for agent movement.\n  # This typically includes 'water' and any 'non-grabbable' items that are not designated as 'workshops'.\n  # Workshops (e.g., workbench, furnace) are usually traversable, even if they cannot be picked up.\n  impassable_for_movement = set()\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n\n  # Define how each movement action (UP, RIGHT, DOWN, LEFT) changes the agent's\n  # resulting direction (0-3) and its (dy, dx) grid displacement.\n  movement_actions_map = {\n      ACTION_UP:    (0, -1, 0),  # Action UP: agent faces UP (dir 0), moves North (dy=-1, dx=0)\n      ACTION_RIGHT: (1, 0, 1),   # Action RIGHT: agent faces RIGHT (dir 1), moves East (dy=0, dx=1)\n      ACTION_DOWN:  (2, 1, 0),   # Action DOWN: agent faces DOWN (dir 2), moves South (dy=1, dx=0)\n      ACTION_LEFT:  (3, 0, -1)   # Action LEFT: agent faces LEFT (dir 3), moves West (dy=0, dx=-1)\n  }\n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence ---\n\n  # BFS queue: Stores tuples of (current_y, current_x, current_direction, path_of_actions_taken_to_reach_here).\n  # Storing the direction is crucial because 'ACTION_USE' depends on agent orientation relative to the target.\n  q = collections.deque()\n  q.append((start_y, start_x, start_dir, []))\n  \n  # Set to keep track of visited states to prevent redundant exploration and infinite loops in cyclic maps.\n  # A state is defined by (position_y, position_x, direction) because the same grid cell\n  # with a different orientation is a distinct state for interaction purposes.\n  visited_states = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None  # This variable will store the optimal action sequence found by BFS.\n\n  while q:\n      curr_y, curr_x, curr_dir, current_path = q.popleft()\n\n      # Optimization: If the current path length already exceeds `MAX_COLLECT_STEPS`,\n      # this path branch cannot lead to a valid solution within the specified limits.\n      if len(current_path) > MAX_COLLECT_STEPS:\n          continue\n\n      # Calculate the coordinates of the grid cell that the agent is currently facing.\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Check if the facing cell is within grid boundaries and contains the target primitive.\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n          full_grid[facing_y, facing_x, primitive] > 0):\n          \n          # If the primitive is found in the facing cell, a valid interaction point is identified.\n          # The `ACTION_USE` must be appended to the current path.\n          candidate_path = current_path + [ACTION_USE]\n\n          # Ensure the complete path (including the final `ACTION_USE`) respects the step limit.\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              # Since BFS guarantees finding the shortest path first, we can stop as soon as one is found.\n              break # Exit the BFS loop\n\n      # Explore all possible next states from the current state by trying each movement action.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          new_path = current_path + [action_move]\n\n          # Pruning: If the prospective path length would exceed the maximum, skip this potential step.\n          if len(new_path) > MAX_COLLECT_STEPS:\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable.\n          # Iterates through `impassable_for_movement` to ensure the cell doesn't contain obstacles.\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0: # If the cell contains an impassable entity\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # Check if this new (position, direction) state has already been visited.\n          # This avoids redundant work and prevents getting stuck in loops within cyclic environments.\n          next_state_tuple = (next_y, next_x, next_dir)\n          if next_state_tuple in visited_states:\n              continue\n\n          # If all checks pass, add the new valid state to the queue for further exploration.\n          visited_states.add(next_state_tuple)\n          q.append((next_y, next_x, next_dir, new_path))\n\n  # --- Execute the Found Path (if any) and Monitor for Successful Collection ---\n\n  # If no valid path was found by the BFS within the step limit, return an empty list of actions.\n  if path_to_execute is None:\n      return []\n\n  actions_executed = []\n  for action in path_to_execute:\n      # Record the action that is about to be performed.\n      actions_executed.append(action)\n      \n      # Perform the action in the environment. `env.step()` updates the internal `env._current_state`.\n      reward, done, _ = env.step(action)\n      \n      # Update the reference to the `current_state` to reflect the environment's actual state after the step.\n      current_state = env._current_state\n\n      # Immediate check: If the primitive has been collected after this action, the goal is achieved.\n      # Return the sequence of actions taken so far.\n      if current_state.inventory[primitive] > 0:\n          return actions_executed\n\n      # Check for early termination of the episode without successfully collecting the item.\n      # This handles cases where the environment's `max_steps` limit is reached or other termination\n      # conditions occur before the collection goal is met.\n      if done and current_state.inventory[primitive] <= 0:\n          return [] # Episode ended, but the goal was not achieved.\n\n  # Final check after executing all actions in the `path_to_execute`.\n  # This covers scenarios where the primitive is collected on the very last action of the path.\n  if current_state.inventory[primitive] > 0:\n      return actions_executed\n  else:\n      # If the entire path was executed but the primitive was not collected,\n      # it implies a discrepancy (e.g., dynamic environment change, or an unexpected outcome of ACTION_USE).\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:44:19.359669", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Define a maximum number of steps for the BFS to find a path.\n  # This prevents excessively long search times and limits the length of the generated action sequence.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function defined inside to adhere to the \"only return code that will fit in that function\" rule.\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent.\n\n      Args:\n          y (int): Agent's current row coordinate.\n          x (int): Agent's current column coordinate.\n          direction (int): Agent's current facing direction (0=Up, 1=Right, 2=Down, 3=Left).\n\n      Returns:\n          tuple[int, int]: (row, column) coordinates of the cell in front.\n      \"\"\"\n      if direction == 0:  # UP\n          return y - 1, x\n      if direction == 1:  # RIGHT\n          return y, x + 1\n      if direction == 2:  # DOWN\n          return y + 1, x\n      if direction == 3:  # LEFT\n          return y, x - 1\n      # Fallback for unexpected direction value, though typically not reached during valid gameplay.\n      return y, x\n\n  actions_taken = []\n\n  # Access the internal CraftState instance directly to get the current state information.\n  # This allows the function to compute actions from the *current* state of the environment.\n  current_state = env._current_state\n\n  # Basic validation: Ensure the `primitive` is a recognized entity kind in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # Optimization: If the `primitive` is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # Retrieve necessary environment information for pathfinding.\n  full_grid = current_state.grid # Use the actual current grid state\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir # Use current_state.dir, as the agent's direction can change\n\n  # Determine which entity kinds are impassable for agent movement.\n  # This set will include water (if defined) and any non-grabbable items that are NOT workshops.\n  # Workshops (e.g., workbench, furnace) are typically traversable even if they cannot be picked up.\n  impassable_for_movement = set()\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n  \n  # Convert to a list for efficient numpy indexing later if the set is populated.\n  impassable_kinds_list = list(impassable_for_movement)\n\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # The agent's direction automatically updates based on the movement action performed.\n  # Direction mapping: 0=Up, 1=Right, 2=Down, 3=Left\n  movement_actions_map = {\n      ACTION_UP:    (0, -1, 0),  # Action UP: results in direction 0 (UP), moves North (dy=-1, dx=0)\n      ACTION_RIGHT: (1, 0, 1),   # Action RIGHT: results in direction 1 (RIGHT), moves East (dy=0, dx=1)\n      ACTION_DOWN:  (2, 1, 0),   # Action DOWN: results in direction 2 (DOWN), moves South (dy=1, dx=0)\n      ACTION_LEFT:  (3, 0, -1)   # Action LEFT: results in direction 3 (LEFT), moves West (dy=0, dx=-1)\n  }\n\n  q = collections.deque()\n  # BFS queue state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  # Storing the current direction is crucial because `ACTION_USE` is dependent on agent orientation.\n  q.append((start_y, start_x, start_dir, []))\n  \n  # Keep track of visited states to prevent redundant exploration and infinite loops in cyclic maps.\n  # A state is defined by (position_y, position_x, direction) because the same grid cell\n  # with a different orientation constitutes a distinct state for the purpose of `ACTION_USE`.\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None  # This variable will store the final sequence of actions if a valid path is found.\n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Optimization: If the current path length already exceeds MAX_COLLECT_STEPS,\n      # this branch cannot lead to a valid solution within the specified limits.\n      if len(path) > MAX_COLLECT_STEPS:\n          continue\n\n      # Calculate the coordinates of the grid cell that the agent is currently facing.\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Check if the facing cell is within grid boundaries and contains the target primitive.\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n          full_grid[facing_y, facing_x, primitive] > 0):\n\n          # We've found a position and orientation from which `ACTION_USE` can be performed successfully.\n          candidate_path = path + [ACTION_USE]\n\n          # Ensure the complete path (including the final `ACTION_USE`) is within the step limit.\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              # Since BFS guarantees finding the shortest path first, we can stop as soon as one is found.\n              break # Exit the BFS loop\n\n      # Explore all possible next states from the current state (curr_y, curr_x, curr_dir).\n      # This involves trying each possible movement action.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Pruning: If adding this move makes the path too long, skip this potential step.\n          if len(path) + 1 > MAX_COLLECT_STEPS:\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable.\n          # If the impassable_kinds_list is empty, all cells are traversable.\n          # Otherwise, check if any of the impassable kinds exist in the next cell.\n          if impassable_kinds_list and np.any(full_grid[next_y, next_x, impassable_kinds_list] > 0):\n              continue\n\n          # Check if this new (position, direction) state has already been visited.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # If all checks pass, add the new state to the queue for further exploration.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      # If no valid path was found within the step limit, return an empty list.\n      return []\n\n  for action in path_to_execute:\n      actions_taken.append(action)\n      \n      # Perform the action in the environment.\n      # env.step() updates env._current_state internally.\n      reward, done, _ = env.step(action)\n      \n      # After each step, update the internal state reference to reflect the current environment.\n      current_state = env._current_state\n\n      # Check for early termination of the episode without successfully collecting the primitive.\n      # This ensures robustness if the environment ends due to other reasons (e.g., `max_steps` reached\n      # by `CraftLab`) before the collection is complete.\n      if done and current_state.inventory[primitive] <= 0:\n          return []  # Episode ended, but the goal was not satisfied.\n\n      # If the primitive is collected, we can stop executing the remaining actions in the path.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n  # Final check after executing all actions in the `path_to_execute`.\n  # This handles cases where the primitive is collected on the very last action of the path.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it implies a discrepancy (e.g., the primitive disappeared dynamically,\n      # or the goal was already met and the action failed).\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:45:40.488126", "function_name": "collect", "function_body": "  import collections\n\n  # --- Action and Direction Constants ---\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Mapping from movement action to the direction the agent would face after taking it.\n  # In CraftWorld, taking a movement action automatically aligns the agent's direction.\n  ACTION_TO_DIRECTION = {\n      UP_ACTION: NORTH_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  # Mapping from movement action to (dx, dy) delta on the grid.\n  ACTION_TO_MOVE_DELTA = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  # Mapping from agent's direction to the (dx, dy) delta of the cell directly in front.\n  DIRECTION_TO_FRONT_DELTA = {\n      NORTH_DIR: (0, -1),\n      EAST_DIR: (1, 0),\n      SOUTH_DIR: (0, 1),\n      WEST_DIR: (-1, 0)\n  }\n\n  # Get the integer ID for the target primitive from the cookbook.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get the current state information from the environment.\n  current_state = env._current_state\n\n  # Optimization: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  # Extract current grid dimensions and agent's initial position/direction.\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Get indices of entities that block movement (cannot be walked through).\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  def is_walkable(x, y, current_grid):\n    \"\"\"\n    Checks if a given grid cell (x, y) is within bounds and does not contain\n    any non-grabbable items that would block agent movement.\n    This check is crucial and was missing in `collect_v1`'s pathfinding logic.\n    \"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n\n    # Check for any non-grabbable kind present at this cell.\n    for kind_idx in non_grabbable_kinds:\n      if current_grid[y, x, kind_idx] > 0:\n        return False # Cell is blocked by a non-grabbable item (e.g., wall, water).\n    return True\n\n  # Initialize BFS queue with the starting state.\n  # Each state in the queue is (current_x, current_y, current_direction, list_of_actions_taken).\n  # Using collections.deque for efficient appends and pops, unlike list.pop(0) in collect_v1.\n  queue = collections.deque([(start_pos_x, start_pos_y, start_dir, [])])\n  \n  # Initialize a set to keep track of visited (x, y, direction) states to avoid cycles\n  # and redundant exploration. Tracking direction in the visited set is key for correct\n  # pathfinding, unlike `collect_v1` which only tracked `(x, y)`.\n  visited = {(start_pos_x, start_pos_y, start_dir)}\n\n  # --- Start Breadth-First Search ---\n  # This BFS directly searches for a state from which the 'USE' action can be applied,\n  # combining position and orientation search into a single coherent process.\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft() # Get the next state to explore.\n\n    # --- Goal Check: Can we collect the primitive from this state? ---\n    # The agent collects an item by being adjacent to it and using the USE action.\n    # First, determine the coordinates of the cell directly in front of the agent.\n    front_dx, front_dy = DIRECTION_TO_FRONT_DELTA[curr_dir]\n    front_x, front_y = curr_x + front_dx, curr_y + front_dy\n\n    # Check if the cell in front is within bounds and contains the target primitive.\n    if (0 <= front_x < grid_width and 0 <= front_y < grid_height and\n        grid[front_y, front_x, primitive_id] > 0):\n      # Goal reached: The agent is at a position where it can use 'USE_ACTION'\n      # to collect the primitive. Return the path found + the USE action.\n      return path_actions + [USE_ACTION]\n\n    # --- Expand possible next states from the current state ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT)\n    # These actions change position and automatically update the agent's facing direction.\n    for move_action, (dx, dy) in ACTION_TO_MOVE_DELTA.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir_after_move = ACTION_TO_DIRECTION[move_action] # Direction aligns with movement.\n\n      # Check if the next cell is walkable and this specific (position, direction) state\n      # hasn't been visited yet. `is_walkable` ensures we don't try to move through obstacles.\n      if is_walkable(next_x, next_y, grid) and \\\n         (next_x, next_y, next_dir_after_move) not in visited:\n        \n        visited.add((next_x, next_y, next_dir_after_move)) # Mark as visited.\n        # Add to queue with the updated position, direction, and extended path.\n        queue.append((next_x, next_y, next_dir_after_move, path_actions + [move_action]))\n\n    # B. Turning Actions (LEFT, RIGHT)\n    # These actions change only the agent's direction, not its position.\n    # They represent \"turn in place\" actions to reorient the agent without moving.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      next_dir = curr_dir\n      if turn_action == LEFT_ACTION:\n        # Turn counter-clockwise: 0 (N) -> 3 (W), 1 (E) -> 0 (N), etc.\n        next_dir = (curr_dir - 1 + 4) % 4\n      elif turn_action == RIGHT_ACTION:\n        # Turn clockwise: 0 (N) -> 1 (E), 1 (E) -> 2 (S), etc.\n        next_dir = (curr_dir + 1) % 4\n\n      # Position (curr_x, curr_y) remains the same.\n      if (curr_x, curr_y, next_dir) not in visited:\n        visited.add((curr_x, curr_y, next_dir)) # Mark as visited.\n        # Add to queue with unchanged position, new direction, and extended path.\n        queue.append((curr_x, curr_y, next_dir, path_actions + [turn_action]))\n\n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 4, "scores": {"3": 0.0}}
