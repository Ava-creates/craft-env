{"timestamp": "2025-07-30T11:45:26.726240", "function_name": "collect", "function_body": "    actions_taken = []\n    \n    # Get action mappings from the environment's action_specs\n    action_map = env.action_specs()\n    A_DOWN = action_map[\"DOWN\"]\n    A_UP = action_map[\"UP\"]\n    A_LEFT = action_map[\"LEFT\"]\n    A_RIGHT = action_map[\"RIGHT\"]\n    A_USE = action_map[\"USE\"]\n\n    # Get initial observations to check current inventory\n    obs = env.observations()\n    initial_inventory = obs[\"features_dict\"][\"inventory\"]\n    \n    # If the primitive is already in the inventory, no actions are needed\n    if initial_inventory[primitive] > 0:\n        return []\n    \n    # Set a maximum number of steps to prevent infinite loops, using env's max_steps\n    max_steps = env.max_steps\n    current_steps = 0\n\n    while True:\n        # Check if max_steps is reached\n        if max_steps is not None and current_steps >= max_steps:\n            break\n\n        obs = env.observations()\n        features_dict = obs[\"features_dict\"]\n        \n        # Check if the primitive has been collected\n        current_inventory = features_dict[\"inventory\"]\n        if current_inventory[primitive] > 0:\n            break # Successfully collected\n\n        # Get current grid and agent's exact (integer) position\n        grid = features_dict[\"features_global\"]\n        agent_x, agent_y = env._current_state.pos # Use the un-normalized integer position\n        \n        action_to_take = None\n\n        # First, check if the primitive is in the agent's immediate vicinity (3x3 neighborhood)\n        if env._current_state.next_to(primitive):\n            action_to_take = A_USE\n        else:\n            # If not next to it, try to find it on the map and move towards it\n            primitive_locs = np.argwhere(grid[:, :, primitive] == 1)\n            \n            if len(primitive_locs) == 0:\n                # Primitive not found anywhere on the grid.\n                # In this case, no further intelligent action can be taken towards collection.\n                # The agent might just hit max_steps or get stuck if there's no path.\n                break \n            else:\n                # Find the closest primitive location using Manhattan distance\n                closest_loc = None\n                min_dist = float('inf')\n\n                for p_loc_x, p_loc_y in primitive_locs:\n                    dist = abs(p_loc_x - agent_x) + abs(p_loc_y - agent_y)\n                    if dist < min_dist:\n                        min_dist = dist\n                        closest_loc = (p_loc_x, p_loc_y)\n                \n                target_x, target_y = closest_loc\n                \n                # Determine the best movement action (greedy approach)\n                dx = target_x - agent_x\n                dy = target_y - agent_y\n\n                # Prioritize moving along the axis with the larger difference\n                if abs(dx) >= abs(dy): # Prefer horizontal movement (or if dx == dy)\n                    if dx > 0:\n                        action_to_take = A_RIGHT\n                    else: # dx < 0\n                        action_to_take = A_LEFT\n                else: # Prefer vertical movement\n                    if dy > 0:\n                        action_to_take = A_DOWN\n                    else: # dy < 0\n                        action_to_take = A_UP\n        \n        # If an action was determined, execute it\n        if action_to_take is not None:\n            # env.step returns (reward, done, observations)\n            reward, done, _ = env.step(action_to_take)\n            actions_taken.append(action_to_take)\n            current_steps += 1\n\n            # If the environment signals termination, break the loop\n            if done:\n                break\n        else:\n            # No action could be determined (e.g., primitive not found on grid)\n            # This should ideally be caught by `len(primitive_locs) == 0` break.\n            # But as a safeguard, break to prevent infinite loop if action_to_take remains None.\n            break\n\n    return actions_taken", "island_id": 4, "scores": {"3": -1}}
