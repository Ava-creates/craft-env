{"timestamp": "2025-07-30T20:17:25.797852", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Define a maximum number of steps for the BFS to find a path.\n  # This prevents excessively long search times and limits the length of the generated action sequence.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to calculate the grid coordinates of the cell directly in front of the agent.\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent.\n\n      Args:\n          y (int): Agent's current row coordinate.\n          x (int): Agent's current column coordinate.\n          direction (int): Agent's current facing direction (DIR_EAST, DIR_SOUTH, DIR_WEST, DIR_NORTH).\n\n      Returns:\n          tuple[int, int]: (row, column) coordinates of the cell in front.\n      \"\"\"\n      if direction == DIR_EAST:\n          return y, x + 1\n      elif direction == DIR_SOUTH:\n          return y + 1, x\n      elif direction == DIR_WEST:\n          return y, x - 1\n      elif direction == DIR_NORTH:\n          return y - 1, x\n      # This case should ideally not be reached with valid direction inputs.\n      return y, x\n\n  actions_taken = []\n\n  # Access the underlying CraftState instance directly to get the current state information.\n  # This allows `collect_v2` to be called mid-episode without resetting the environment.\n  current_state = env._current_state\n\n  # Basic validation: Ensure the `primitive` is a recognized entity kind in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # Optimization: If the `primitive` is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Retrieve necessary environment information for pathfinding.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir\n\n  # Define which entity kinds block agent movement.\n  # These are generally non-grabbable items that are not workshops (e.g., water, walls, trees).\n  impassable_for_movement = set()\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  for k_idx in current_state.world.non_grabbable_indices:\n      # Workshops (like workbench, furnace) are often non-grabbable but traversable.\n      if k_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # The agent's direction automatically updates based on the cardinal direction of its last movement.\n  # Format: {ACTION: (resulting_direction, dy, dx)}\n  movement_actions_map = {\n      ACTION_UP:    (DIR_NORTH, -1, 0),\n      ACTION_RIGHT: (DIR_EAST, 0, 1),\n      ACTION_DOWN:  (DIR_SOUTH, 1, 0),\n      ACTION_LEFT:  (DIR_WEST, 0, -1)\n  }\n\n  q = collections.deque()\n  # BFS queue state: (current_y, current_x, current_direction, path_of_actions_so_far)\n\n  # If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # Initialize BFS: Start from the agent's current position and direction with an empty action path.\n  q.append((start_y, start_x, start_dir, []))\n  # Keep track of visited states (position + orientation) to prevent redundant exploration and infinite loops.\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None  # This variable will store the final sequence of actions if a valid path is found.\n\n  # Determine if the primitive is a \"grabbable\" item (picked up by moving onto its cell and using USE).\n  # Or if it's a \"non-grabbable\" item (interacted with from an adjacent cell).\n  is_primitive_grabbable = primitive in current_state.world.grabbable_indices\n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # If the current path length already exceeds MAX_COLLECT_STEPS, this path is too long\n      # to append more actions and still be within the limit.\n      if len(path) > MAX_COLLECT_STEPS:\n          continue\n\n      # --- Goal Check: Determine if the primitive can be collected from the current state (position and direction) ---\n      candidate_path_if_use = path + [ACTION_USE]\n      \n      # Check if adding ACTION_USE keeps the total path length within the allowed maximum.\n      if len(candidate_path_if_use) <= MAX_COLLECT_STEPS:\n          # Scenario 1: Primitive is \"grabbable\" and located on the agent's current cell.\n          # For grabbable items, ACTION_USE picks it up from the current cell, regardless of direction.\n          if is_primitive_grabbable and full_grid[curr_y, curr_x, primitive] > 0:\n              path_to_execute = candidate_path_if_use\n              break # Found the shortest path, exit BFS.\n          \n          # Scenario 2: Primitive is \"non-grabbable\" and located in the cell the agent is currently facing.\n          # For non-grabbable items, ACTION_USE interacts with the item in the facing cell.\n          elif not is_primitive_grabbable:\n              facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n              # Check if the facing cell is within grid boundaries and contains the target primitive.\n              if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n                  full_grid[facing_y, facing_x, primitive] > 0):\n                  path_to_execute = candidate_path_if_use\n                  break # Found the shortest path, exit BFS.\n\n      # --- Explore neighboring cells via movement actions ---\n      # Only explore movement actions if adding one more step does not exceed the maximum allowed.\n      if len(path) + 1 <= MAX_COLLECT_STEPS:\n          for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n              next_y, next_x = curr_y + dy, curr_x + dx\n              \n              # Check if the proposed next position is within the grid boundaries.\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if the proposed next cell is traversable.\n              is_traversable = True\n              for k_idx in impassable_for_movement:\n                  if full_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable = False\n                      break\n              if not is_traversable:\n                  continue\n\n              # Check if this new (position, direction) state has already been visited.\n              visited_state = (next_y, next_x, next_dir)\n              if visited_state in visited:\n                  continue\n\n              # If all checks pass, add the new state to the queue for further exploration.\n              visited.add(visited_state)\n              q.append((next_y, next_x, next_dir, path + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      # If no valid path was found within the step limit, return an empty list.\n      return []\n\n  for action in path_to_execute:\n      actions_taken.append(action)\n      # Perform the action in the environment.\n      # We ignore reward and observation for the purpose of this planning function.\n      reward, done, _ = env.step(action)\n      \n      # Update the internal state reference after each step to reflect the current environment.\n      current_state = env._current_state\n\n      # Check for early termination of the episode or if the goal was satisfied.\n      # If the episode ended (e.g., max_steps reached) and the primitive wasn't collected,\n      # the plan failed, so return an empty list.\n      if done and current_state.inventory[primitive] <= 0:\n          return []\n\n      # If the primitive is successfully collected at any point during execution, stop and return the path.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n  # Final check: After executing all actions in the `path_to_execute`, confirm collection.\n  # This handles cases where the primitive is collected on the very last action.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it indicates a discrepancy (e.g., dynamic environment changes, or logical error).\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T20:17:26.785218", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Define a maximum number of steps for the BFS to find a path.\n  # This prevents excessively long search times and limits the total length\n  # of the generated action sequence, including the final ACTION_USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to calculate the grid coordinates of the cell directly in front of the agent.\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent.\n\n      Args:\n          y (int): Agent's current row coordinate.\n          x (int): Agent's current column coordinate.\n          direction (int): Agent's current facing direction (DIR_EAST, DIR_SOUTH, DIR_WEST, DIR_NORTH).\n\n      Returns:\n          tuple[int, int]: (row, column) coordinates of the cell in front.\n      \"\"\"\n      if direction == DIR_EAST:\n          return y, x + 1\n      elif direction == DIR_SOUTH:\n          return y + 1, x\n      elif direction == DIR_WEST:\n          return y, x - 1\n      elif direction == DIR_NORTH:\n          return y - 1, x\n      # Default: If an invalid direction is passed, the agent effectively faces its own cell.\n      return y, x\n\n  actions_taken = []\n\n  # Access the underlying CraftState instance directly to get the current state information.\n  # This allows `collect_v2` to be called mid-episode without resetting the environment.\n  current_state = env._current_state\n\n  # Basic validation: Ensure the `primitive` is a recognized entity kind in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # Optimization: If the `primitive` is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Retrieve necessary environment information for pathfinding.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir\n\n  # Define which entity kinds block agent movement.\n  # These are generally non-grabbable items that are not workshops (e.g., water, walls, trees).\n  impassable_for_movement = set()\n  # Add water if it exists and is defined as a kind.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  # Add other non-grabbable items that are not workshops to the impassable set.\n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # The agent's direction automatically updates based on the cardinal direction of its last movement.\n  # Format: {ACTION_CONSTANT: (resulting_direction_constant, dy, dx)}\n  movement_actions_map = {\n      ACTION_UP:    (DIR_NORTH, -1, 0),  # Action UP (1): moves North (dy=-1, dx=0), agent faces North (DIR_NORTH=3)\n      ACTION_RIGHT: (DIR_EAST, 0, 1),    # Action RIGHT (3): moves East (dy=0, dx=1), agent faces East (DIR_EAST=0)\n      ACTION_DOWN:  (DIR_SOUTH, 1, 0),   # Action DOWN (0): moves South (dy=1, dx=0), agent faces South (DIR_SOUTH=1)\n      ACTION_LEFT:  (DIR_WEST, 0, -1)    # Action LEFT (2): moves West (dy=0, dx=-1), agent faces West (DIR_WEST=2)\n  }\n\n  q = collections.deque()\n  # BFS queue state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  # Storing the current direction is crucial because `ACTION_USE` is dependent on agent orientation\n  # for non-grabbable items, and for BFS exploration, each unique (pos, dir) is a distinct state.\n\n  # If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # Initialize BFS: Start from the agent's current position and direction with an empty action path.\n  q.append((start_y, start_x, start_dir, []))\n  # Keep track of visited states (position + orientation) to prevent redundant exploration and infinite loops.\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None  # This variable will store the final sequence of actions if a valid path is found.\n\n  # Determine if the primitive is a \"grabbable\" item (picked up by moving onto its cell and using USE).\n  # Or if it's a \"non-grabbable\" item (interacted with from an adjacent cell by facing it and using USE).\n  is_primitive_grabbable = primitive in current_state.world.grabbable_indices\n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Optimization: If the current path length already equals or exceeds MAX_COLLECT_STEPS,\n      # this branch cannot lead to a valid solution within the specified limits because a final ACTION_USE\n      # would make it too long (or there's no room for any more actions).\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # --- Goal Check: Determine if the primitive can be collected from the current state (position and direction) ---\n\n      # Scenario 1: Primitive is \"grabbable\" and located on the agent's current cell.\n      # In this case, ACTION_USE picks it up, regardless of the agent's facing direction.\n      if is_primitive_grabbable and full_grid[curr_y, curr_x, primitive] > 0:\n          candidate_path = path + [ACTION_USE]\n          if len(candidate_path) <= MAX_COLLECT_STEPS: # Check if the final path is within limits\n              path_to_execute = candidate_path\n              # BFS guarantees the shortest path, so we can stop once a valid one is found.\n              break \n      \n      # Scenario 2: Primitive is \"non-grabbable\" and located in the cell the agent is currently facing.\n      # In this case, ACTION_USE interacts with the object in front.\n      elif not is_primitive_grabbable:\n          facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n          # Check if the facing cell is within grid boundaries and contains the target primitive.\n          if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n              full_grid[facing_y, facing_x, primitive] > 0):\n              \n              candidate_path = path + [ACTION_USE]\n              if len(candidate_path) <= MAX_COLLECT_STEPS: # Check if the final path is within limits\n                  path_to_execute = candidate_path\n                  break # Found the shortest path, exit BFS.\n\n      # --- Explore neighboring cells via movement actions ---\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          \n          # Pruning: If adding this movement action would make the path length such that there's\n          # no room left for the final ACTION_USE, then prune this branch.\n          # We need at least one slot for ACTION_USE. So, if `len(path) + 1` is already `MAX_COLLECT_STEPS`,\n          # then adding `ACTION_USE` would make the total path `MAX_COLLECT_STEPS + 1`, which is too long.\n          if len(path) + 1 >= MAX_COLLECT_STEPS:\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable.\n          # A cell is not traversable if it contains any item in the `impassable_for_movement` set.\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # Check if this new (position, direction) state has already been visited.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # If all checks pass, add the new state to the queue for further exploration.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      # If no valid path was found within the step limit, return an empty list.\n      return []\n\n  for action in path_to_execute:\n      actions_taken.append(action)\n      # Perform the action in the environment.\n      # We ignore reward and observation here as the goal is to get the action sequence.\n      reward, done, _ = env.step(action)\n      \n      # Update the internal state reference after each step to reflect the current environment.\n      current_state = env._current_state\n\n      # Check for early termination of the episode or if the primitive was collected.\n      # If the episode ends (`done` is True) and the primitive is NOT in inventory, it implies failure.\n      if done and current_state.inventory[primitive] <= 0:\n          return []\n\n      # If the primitive is successfully collected at any point, we can stop and return the path.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n  # Final check: After executing all actions in the `path_to_execute`, confirm collection.\n  # This handles cases where the primitive is collected on the very last action.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it indicates a discrepancy (e.g., dynamic environment changes, or a planning error).\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T20:19:12.084946", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world # CraftWorld instance\n\n  # Constants for actions (assuming they are defined globally or are available in this scope)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # 1. Check if the primitive is already in inventory\n  # inventory is a numpy array where inventory[item_idx] is its count.\n  if current_state.inventory[primitive] > 0:\n    return [] # Primitive is already collected\n\n  # 2. Locate the primitive on the grid\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape # grid.shape is (WIDTH, HEIGHT, n_kinds)\n  primitive_pos = None # Will store (x, y) coordinates of the primitive\n\n  # Search the entire grid for the first occurrence of the primitive\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If grid[x, y, primitive] > 0, it means the primitive exists at (x, y)\n      if grid[x, y, primitive] > 0:\n        primitive_pos = (x, y)\n        break\n    if primitive_pos:\n      break\n\n  if not primitive_pos:\n    # Primitive not found on the current grid. Cannot collect it.\n    return []\n\n  # 3. Pathfinding using BFS (Breadth-First Search) to reach a cell adjacent to the primitive\n  start_pos = current_state.pos # Agent's current (x, y) position\n\n  # Queue for BFS: stores tuples of (current_position (x,y), path_taken_so_far (list of actions))\n  queue = collections.deque([(start_pos, [])])\n  visited = {start_pos} # Set to keep track of visited (x,y) positions to avoid infinite loops\n\n  # Mapping of movement deltas (dx, dy) to corresponding action constants\n  # x corresponds to columns (horizontal), y to rows (vertical)\n  # (0, -1) means change in y by -1 (move up), (1, 0) means change in x by 1 (move right)\n  move_actions_map = {\n      (0, -1): ACTION_UP,    # Move agent up\n      (0, 1): ACTION_DOWN,   # Move agent down\n      (-1, 0): ACTION_LEFT,  # Move agent left\n      (1, 0): ACTION_RIGHT,  # Move agent right\n  }\n\n  # Define non-walkable kinds: these are assumed to block agent movement.\n  # This set comes from the CraftWorld object.\n  non_walkable_kinds = world.non_grabbable_indices\n\n  # Helper function to check if a cell (x, y) is valid and walkable\n  def is_walkable(x, y):\n    # Check grid boundaries\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell contains any non-walkable (blocking) entities.\n    # We iterate through all possible kinds at this position.\n    for kind_idx in range(grid.shape[2]):\n      if grid[x, y, kind_idx] > 0 and kind_idx in non_walkable_kinds:\n        return False # This cell contains a blocking object, so it's not walkable\n    return True # The cell is within bounds and does not contain blocking objects\n\n  path_to_primitive_adjacency = None # Will store the sequence of actions to reach an adjacent cell\n\n  while queue:\n    current_pos, path_so_far = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if the current position is adjacent to the primitive's position.\n    # Manhattan distance of 1 indicates adjacency (i.e., neighbor in a 4-directional grid).\n    if abs(cx - primitive_pos[0]) + abs(cy - primitive_pos[1]) == 1:\n      path_to_primitive_adjacency = path_so_far\n      break # Path found to an adjacent cell, BFS ensures it's the shortest path\n\n    # Explore all 4 neighbors (up, down, left, right)\n    for (dx, dy), action in move_actions_map.items():\n      next_x, next_y = cx + dx, cy + dy\n      next_pos = (next_x, next_y)\n\n      # Only consider valid, walkable, and unvisited neighbors\n      if next_pos not in visited and is_walkable(next_x, next_y):\n        visited.add(next_pos)\n        queue.append((next_pos, path_so_far + [action])) # Add to queue with updated path\n\n  if not path_to_primitive_adjacency:\n    # No path could be found to any cell adjacent to the primitive (e.g., primitive is enclosed)\n    return []\n\n  # 4. Append the USE action after the movement path.\n  # Once the agent is adjacent to the primitive, it needs to USE to collect it.\n  final_actions = path_to_primitive_adjacency + [ACTION_USE]\n\n  return final_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:19:13.138504", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = current_state.world\n  grid = current_state.grid\n  inventory = current_state.inventory\n  agent_pos = current_state.pos # (x, y) tuple\n  agent_dir = current_state.dir # int: 0=N, 1=E, 2=S, 3=W (assuming from typical CraftWorld implementations)\n\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  # Define how movement actions change position and direction\n  # `move_deltas`: (dx, dy) for each cardinal movement action\n  move_deltas = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0)\n  }\n  # `action_to_new_dir`: the new facing direction after performing a move action\n  action_to_new_dir = {\n      UP: 0,   # North\n      RIGHT: 1, # East\n      DOWN: 2,  # South\n      LEFT: 3   # West\n  }\n  # `dir_to_delta`: (dx, dy) that a given direction points to (for USE action target)\n  dir_to_delta = {\n      0: (0, -1), # North\n      1: (1, 0),  # East\n      2: (0, 1),  # South\n      3: (-1, 0)  # West\n  }\n\n  # 1. Check if primitive is already collected\n  if inventory[primitive] > 0:\n    return []\n\n  # 2. Find all primitive locations on the grid\n  primitive_locations = []\n  for y in range(HEIGHT):\n    for x in range(WIDTH):\n      if grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  if not primitive_locations:\n    return [] # Primitive not found on the map\n\n  # Helper to check if a cell is an obstacle for movement\n  # Cells with non-grabbable items (like water, stone) are assumed to be impassable terrain.\n  def is_obstacle(x, y):\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return True # Out of bounds\n    \n    for kind_idx in world.non_grabbable_indices:\n      if grid[x, y, kind_idx] == 1:\n        return True # Contains an impassable item\n    return False\n\n  # 3. BFS to find a path to a suitable collection state\n  # BFS state: ((curr_x, curr_y, curr_dir), path_actions_list)\n  # The goal is to reach a state (adj_x, adj_y, final_dir) such that\n  # (adj_x, adj_y) is adjacent to a primitive, AND final_dir points to that primitive.\n  queue = collections.deque([((agent_pos[0], agent_pos[1], agent_dir), [])])\n  visited = set([(agent_pos[0], agent_pos[1], agent_dir)])\n\n  final_path_actions = None\n\n  while queue:\n    (curr_x, curr_y, curr_dir), path_actions = queue.popleft()\n\n    # Check if current state (position and direction) allows for immediate collection\n    # The agent must be at (curr_x, curr_y), facing curr_dir.\n    # The cell directly in front of it must contain the primitive.\n    dir_dx, dir_dy = dir_to_delta[curr_dir]\n    front_x, front_y = curr_x + dir_dx, curr_y + dir_dy\n\n    if (front_x, front_y) in primitive_locations:\n      # Found a state where the agent is facing the primitive from an adjacent square.\n      final_path_actions = path_actions\n      break # Found shortest path, exit BFS\n\n    # Explore valid movement actions\n    for action in [UP, DOWN, LEFT, RIGHT]:\n      move_dx, move_dy = move_deltas[action]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = action_to_new_dir[action] # Direction after this move\n\n      if not is_obstacle(next_x, next_y) and \\\n         (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append(((next_x, next_y, next_dir), path_actions + [action]))\n\n  if final_path_actions is None:\n    return [] # No path found to a state where primitive can be collected\n\n  # 4. Append the USE action to the collected path\n  final_path_actions.append(USE)\n  \n  return final_path_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:20:33.761524", "function_name": "collect", "function_body": "    actions = []\n    \n    # Define action constants based on CraftLab.action_specs\n    MOVE_DOWN = 0\n    MOVE_UP = 1\n    MOVE_LEFT = 2\n    MOVE_RIGHT = 3\n    ACTION_USE = 4\n    \n    # Get the current state from the environment\n    state = env._current_state\n    \n    # 1. Check if the primitive is already in inventory\n    if state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n    \n    current_pos = state.pos\n    grid = state.grid\n    \n    # 2. Find the closest instance of the primitive on the grid\n    min_dist = float('inf')\n    target_location = None\n    \n    # grid has shape (WIDTH, HEIGHT, n_kinds)\n    width, height, _ = grid.shape \n    \n    for x in range(width):\n        for y in range(height):\n            # Check if this cell contains the primitive\n            if grid[x, y, primitive] > 0:\n                dist = abs(x - current_pos[0]) + abs(y - current_pos[1])\n                if dist < min_dist:\n                    min_dist = dist\n                    target_location = (x, y)\n    \n    # 3. If primitive not found, return empty list (cannot collect)\n    if target_location is None:\n        return []\n        \n    # 4. Generate actions to move to a cell adjacent to the target\n    # We will simulate agent's position to generate the path\n    sim_x, sim_y = current_pos\n    target_x, target_y = target_location\n\n    # Loop until the simulated agent is within the 3x3 neighborhood of the target.\n    # The CraftState.next_to method checks if any cell in the 3x3 neighborhood \n    # (including diagonals and the agent's current cell if the target is there)\n    # contains the kind. So, we need to reach a state where abs(dx) <= 1 and abs(dy) <= 1.\n    while not (abs(sim_x - target_x) <= 1 and abs(sim_y - target_y) <= 1):\n        \n        # Calculate relative distance to target from simulated position\n        dx = target_x - sim_x\n        dy = target_y - sim_y\n\n        moved = False\n        # Prioritize movement along the axis with the larger difference\n        if dx != 0 and (abs(dx) >= abs(dy) or dy == 0):\n            if dx > 0:\n                actions.append(MOVE_RIGHT)\n                sim_x += 1\n                moved = True\n            elif dx < 0:\n                actions.append(MOVE_LEFT)\n                sim_x -= 1\n                moved = True\n        \n        # If no horizontal movement was made, or if there's still vertical difference\n        if not moved and dy != 0:\n            if dy > 0:\n                actions.append(MOVE_DOWN)\n                sim_y += 1\n                moved = True\n            elif dy < 0:\n                actions.append(MOVE_UP)\n                sim_y -= 1\n                moved = True\n        \n        # Safety break: if no movement was possible, it indicates a potential issue\n        # (e.g., target unreachable due to obstacles not accounted for by this simple pathfinding)\n        if not moved:\n            break\n            \n    # 5. Add the USE action to collect the primitive\n    actions.append(ACTION_USE)\n    \n    return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:20:33.840599", "function_name": "collect", "function_body": "    ACTION_MAP = env.action_specs()\n    ACTION_UP = ACTION_MAP['UP']\n    ACTION_DOWN = ACTION_MAP['DOWN']\n    ACTION_LEFT = ACTION_MAP['LEFT']\n    ACTION_RIGHT = ACTION_MAP['RIGHT']\n    ACTION_USE = ACTION_MAP['USE']\n\n    # Mappings from (dr, dc) tuple to action integer for BFS path reconstruction\n    DRDC_TO_ACTION = {\n        (0, -1): ACTION_UP,\n        (0, 1): ACTION_DOWN,\n        (-1, 0): ACTION_LEFT,\n        (1, 0): ACTION_RIGHT,\n    }\n\n    # Maximum number of steps to prevent infinite loops, especially if primitive is unreachable\n    MAX_EPISODE_STEPS = 500\n\n    actions_taken = []\n\n    # Reset environment to get the initial state.\n    # CraftLab.reset() returns an observation dictionary. The actual state\n    # is stored internally as `env._current_state`.\n    _ = env.reset()\n    current_state = env._current_state\n\n    # Get grid dimensions and non-grabbable entity indices from the world configuration\n    grid_height, grid_width, _ = current_state.grid.shape\n    non_grabbable_indices = current_state.world.non_grabbable_indices\n\n    for _ in range(MAX_EPISODE_STEPS):\n        # 1. Check if the primitive is already in the inventory\n        if current_state.inventory[primitive] > 0:\n            break  # Goal achieved\n\n        # 2. Check if the agent is next to the primitive. If so, use it.\n        if current_state.next_to(primitive):\n            # Take the USE action to collect the primitive\n            _, done, _ = env.step(ACTION_USE)\n            actions_taken.append(ACTION_USE)\n            current_state = env._current_state  # Update the current state\n\n            if current_state.inventory[primitive] > 0:\n                break  # Primitive collected\n            if done:\n                break  # Episode ended for other reasons (e.g., max_steps of the CraftLab episode)\n        else:\n            # 3. Primitive not collected and not next to it, so find a path to it using BFS.\n            # Queue stores tuples of ((row, col), [path_of_actions_to_this_cell])\n            queue = collections.deque([(current_state.pos, [])])\n            visited = {current_state.pos}\n            path_to_target_cell = None\n\n            while queue:\n                (r, c), path = queue.popleft()\n\n                # Check if this cell contains the primitive\n                if current_state.grid[r, c, primitive] > 0:\n                    path_to_target_cell = path\n                    break  # Found the shortest path to a cell containing the primitive\n\n                # Explore valid neighbors\n                # (dr, dc) order: Down, Up, Right, Left for a consistent search pattern\n                for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n                    nr, nc = r + dr, c + dc\n\n                    # Check grid boundaries\n                    if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n                        continue\n\n                    # Check if the neighbor cell is an obstacle (contains non-grabbable items)\n                    is_obstacle = False\n                    for i_kind in non_grabbable_indices:\n                        if current_state.grid[nr, nc, i_kind] > 0:\n                            is_obstacle = True\n                            break\n                    if is_obstacle:\n                        continue\n\n                    # Check if the neighbor has already been visited\n                    if (nr, nc) in visited:\n                        continue\n\n                    visited.add((nr, nc))\n                    action_move = DRDC_TO_ACTION[(dr, dc)]\n                    queue.append(((nr, nc), path + [action_move]))\n\n            # After BFS: execute the path if found\n            if path_to_target_cell:\n                for action_move in path_to_target_cell:\n                    _, done, _ = env.step(action_move)\n                    actions_taken.append(action_move)\n                    current_state = env._current_state  # Update state after each step\n\n                    if current_state.inventory[primitive] > 0:\n                        break  # Primitive was collected during movement or a previous USE\n                    if done:\n                        break  # Episode ended\n\n                # After executing the path, re-check if the primitive is collected.\n                # If not, and we are now next to it, perform USE.\n                if current_state.inventory[primitive] > 0:\n                    break  # Primitive collected\n\n                if current_state.next_to(primitive):\n                    _, done, _ = env.step(ACTION_USE)\n                    actions_taken.append(ACTION_USE)\n                    current_state = env._current_state\n                    if current_state.inventory[primitive] > 0:\n                        break  # Primitive collected\n                    if done:\n                        break  # Episode ended\n\n            else:\n                # If BFS did not find a path to the primitive, it means it's unreachable\n                # or not present on the current grid. Further attempts are futile.\n                break\n\n    return actions_taken", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:22:04.764813", "function_name": "collect", "function_body": "    # Note: `collections` module is required for `collections.deque`.\n    # It is assumed to be imported at a higher scope based on the prompt's constraints.\n\n    # Get action constants from the env's action_specs\n    action_map = env.action_specs()\n    _ACTION_DOWN = action_map['DOWN']\n    _ACTION_UP = action_map['UP']\n    _ACTION_LEFT = action_map['LEFT']\n    _ACTION_RIGHT = action_map['RIGHT']\n    _ACTION_USE = action_map['USE']\n    _MOVE_ACTIONS = [_ACTION_DOWN, _ACTION_UP, _ACTION_LEFT, _ACTION_RIGHT]\n\n    initial_obs = env.observations()\n    initial_features_dict = initial_obs['features_dict']\n    initial_grid = initial_features_dict['features_global']\n    initial_pos_tuple = tuple(initial_features_dict['pos'])\n    initial_dir = np.argmax(initial_features_dict['direction'])\n    initial_inventory = initial_features_dict['inventory'].copy()\n\n    # The CraftLab `env` holds a reference to the `CraftState`\n    # and `CraftScenario`, which are needed to create new `CraftState` instances for simulation.\n    current_craft_state = env._current_state \n\n    # BFS setup\n    # State in queue/visited: (pos_y, pos_x, direction_int, path_list)\n    q = collections.deque()\n    visited = set()\n\n    # Start BFS from the current agent state\n    q.append((initial_pos_tuple[0], initial_pos_tuple[1], initial_dir, []))\n    visited.add((initial_pos_tuple[0], initial_pos_tuple[1], initial_dir))\n\n    # Grid dimensions (HEIGHT, WIDTH, N_KINDS)\n    HEIGHT, WIDTH, _ = initial_grid.shape\n\n    # Max search depth to prevent infinite loops or excessively long paths.\n    # A generous heuristic: 2 * (total cells) to allow for traversing back and forth\n    # without going infinitely, as optimal paths should be much shorter.\n    MAX_SEARCH_STEPS = HEIGHT * WIDTH * 2 \n\n    while q:\n        curr_y, curr_x, curr_dir, path = q.popleft()\n\n        if len(path) >= MAX_SEARCH_STEPS:\n            continue # Prune paths that are too long\n\n        # Create a CraftState instance to simulate movements from the current BFS node.\n        # It's crucial that this simulated state uses the *initial* grid and inventory\n        # for pathfinding, because we are looking for a path to *an existing item*.\n        # The 'USE' action will modify the grid/inventory, but that's the *result*\n        # of the path, not an intermediate state during pathfinding.\n        simulated_state = env_factory.CraftState(\n            current_craft_state.scenario, # Uses the same scenario as the main env\n            initial_grid,                # Grid state is fixed for pathfinding\n            (curr_y, curr_x),\n            curr_dir,\n            initial_inventory            # Inventory state is fixed for pathfinding\n        )\n\n        # Check if the primitive is collectable and next to the agent in this simulated state\n        # A primitive must be in `env.world.grabbable_indices` to be picked up.\n        is_primitive_grabbable = primitive in env.world.grabbable_indices\n\n        if is_primitive_grabbable and simulated_state.next_to(primitive):\n            # If so, we found a path to be adjacent to the primitive.\n            # Add the USE action and return the path.\n            return path + [_ACTION_USE]\n\n        # Explore possible next states by trying all movement actions\n        for action in _MOVE_ACTIONS:\n            # Simulate the step using the CraftState's own logic\n            # Reward is ignored for pathfinding\n            _, next_sim_state = simulated_state.step(action)\n            \n            next_y, next_x = next_sim_state.pos\n            next_dir = next_sim_state.dir\n            \n            next_state_key = (next_y, next_x, next_dir)\n\n            # Only add to queue if this state hasn't been visited with the same (pos, dir)\n            # This handles cycles and ensures we find shortest paths in terms of actions.\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((next_y, next_x, next_dir, path + [action]))\n\n    # If the queue becomes empty and no path to the primitive was found\n    return []", "island_id": 9, "scores": {"3": -1}}
