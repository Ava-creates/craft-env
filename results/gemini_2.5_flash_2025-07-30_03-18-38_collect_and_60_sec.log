current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Get non-grabbable indices for traversability check\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Prepare BFS goal states: (agent_x, agent_y, agent_facing_dir)\n  # These are the states from which the 'USE' action can be performed to collect the primitive.\n  bfs_target_agent_states = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells for the agent to stand on\n    # (dx_adj, dy_adj) represents the relative position of the agent to the item.\n    # These are offsets from the item to the agent's potential position.\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Left, Right, Up, Down relative to item\n      adj_x, adj_y = item_x + dx_adj, item_y + dy_adj\n\n      if _is_traversable(grid, adj_x, adj_y, non_grabbable_indices, grid_width, grid_height):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_target_agent_states.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_target_agent_states:\n    return [] # No traversable adjacent positions from which to collect the primitive\n\n  # BFS setup\n  # Queue stores (x, y, dir) tuples representing agent's state\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Parent map to reconstruct the path: {child_state: (parent_state, action_to_child)}\n  parent_map = {} \n  \n  found_goal_state = None # Stores the (x, y, dir) of the goal state once found\n\n  # Define movement actions and their effects: (dx, dy, resulting_direction)\n  # This interpretation assumes that UP/DOWN/LEFT/RIGHT actions move the agent\n  # in the specified cardinal direction AND also orient the agent to face that direction.\n  # This is a common action model for grid-based environments with such action names,\n  # implying no separate 'turn-in-place' actions are needed for navigation.\n  movement_actions_effect = {\n      UP_ACTION: (0, -1, NORTH_DIR),    # Move North (dy=-1), face North\n      DOWN_ACTION: (0, 1, SOUTH_DIR),   # Move South (dy=1), face South\n      LEFT_ACTION: (-1, 0, WEST_DIR),   # Move West (dx=-1), face West\n      RIGHT_ACTION: (1, 0, EAST_DIR)    # Move East (dx=1), face East\n  }\n  \n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state is one of the goal states\n    if (curr_x, curr_y, curr_dir) in bfs_target_agent_states:\n      found_goal_state = (curr_x, curr_y, curr_dir)\n      break # Found the shortest path to a goal\n\n    # Explore all possible movement actions from the current state.\n    # The agent's direction is directly determined by the movement action.\n    for action, (dx, dy, next_dir_from_move) in movement_actions_effect.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = next_dir_from_move # Direction is set by the movement itself.\n\n      next_state = (next_x, next_y, next_dir)\n      \n      # Check if the next cell is traversable and the state hasn't been visited\n      if _is_traversable(grid, next_x, next_y, non_grabbable_indices, grid_width, grid_height):\n        if next_state not in visited:\n          visited.add(next_state)\n          parent_map[next_state] = ((curr_x, curr_y, curr_dir), action)\n          queue.append(next_state)\n        \n    # Note: Unlike collect_v1, collect_v2 does not explore separate 'turn-in-place'\n    # actions (e.g., LEFT_ACTION and RIGHT_ACTION as pure turns). This is because\n    # the names UP/DOWN/LEFT/RIGHT strongly suggest movement actions that inherently\n    # set the agent's facing direction. This simplifies the action model and is\n    # consistent with many grid-based environment setups where these actions are\n    # for movement directly.\n\n  if found_goal_state is None:\n    return [] # No path found to any primitive's collection point\n\n  # Reconstruct the path from the goal state back to the initial state\n  actions = []\n  curr_state = found_goal_state\n  initial_state = (initial_agent_x, initial_agent_y, initial_agent_dir)\n\n  # Build the path by backtracking from the goal\n  while curr_state != initial_state:\n    # This check ensures robustness, although curr_state should always be in parent_map\n    # if found_goal_state was correctly reached via BFS.\n    if curr_state not in parent_map:\n        return [] \n    \n    parent_state, action = parent_map[curr_state]\n    actions.insert(0, action) # Prepend action to build path in correct order\n    curr_state = parent_state\n  \n  # Finally, append the USE action after reaching the correct position and facing direction.\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:34:03.101019", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  # Define constants for actions and directions.\n  # These are placed inside the function to ensure it's self-contained.\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent directions mapping to integers (0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Map relative target coordinates (dy, dx) to the required agent facing direction\n  # for the ACTION_USE to be effective (assuming cardinal interaction).\n  RELATIVE_TO_REQUIRED_DIR = {\n      (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n      (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n      (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n      (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n  }\n\n  # Maximum total actions allowed for collection (movements + final USE).\n  MAX_COLLECT_STEPS = 100 \n\n  def _find_path_and_orientation_for_collection(start_pos, start_dir, full_grid, primitive_id, world):\n      \"\"\"\n      Performs Breadth-First Search (BFS) to find a path of movement actions\n      that leads the agent to a position and orientation from which the primitive\n      can be collected using ACTION_USE.\n\n      Args:\n          start_pos: tuple(int, int) - Agent's starting (y, x) position.\n          start_dir: int - Agent's starting direction.\n          full_grid: numpy.ndarray - The full grid layout of the environment.\n          primitive_id: int - The index of the primitive item to collect.\n          world: CraftWorld instance - Reference to the world configuration.\n\n      Returns:\n          list[int] - A list of movement actions (ACTION_UP/DOWN/LEFT/RIGHT)\n                      to reach the collection point and orientation, or None if\n                      no such path is found.\n      \"\"\"\n      grid_height, grid_width, _ = full_grid.shape\n      impassable_kinds = world.non_grabbable_indices\n\n      # BFS state: (current_y, current_x, current_dir, path_of_actions_so_far)\n      q = collections.deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set to prevent cycles and redundant exploration: (y, x, dir)\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      # Possible movement actions and their resulting direction\n      moves_options = [\n          (-1, 0, ACTION_UP, DIR_NORTH),\n          (1, 0, ACTION_DOWN, DIR_SOUTH),\n          (0, -1, ACTION_LEFT, DIR_WEST),\n          (0, 1, ACTION_RIGHT, DIR_EAST)\n      ]\n\n      while q:\n          curr_y, curr_x, curr_dir, path_actions = q.popleft()\n          \n          # Check if the current position and orientation allow for immediate collection\n          # of the primitive using ACTION_USE (i.e., primitive is cardinally adjacent\n          # and agent is facing it).\n          for rel_dy, rel_dx in RELATIVE_TO_REQUIRED_DIR.keys():\n              adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n              # Check bounds and if the adjacent cell contains the primitive\n              if (0 <= adj_y < grid_height and 0 <= adj_x < grid_width and\n                      full_grid[adj_y, adj_x, primitive_id] > 0):\n                  \n                  # If primitive is found, check if the agent's current direction\n                  # matches the required direction to interact with it.\n                  required_dir_for_collection = RELATIVE_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n                  if curr_dir == required_dir_for_collection:\n                      # Path found that leads to a position AND ensures the agent\n                      # is oriented correctly for collection.\n                      return path_actions \n\n          # Explore neighboring cells\n          for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n              # Check grid boundaries\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if this state (position and direction) has already been visited\n              if (next_y, next_x, new_dir_after_move) in visited:\n                  continue\n\n              # Check if the next cell is traversable for movement (does not contain impassable kinds)\n              is_traversable_for_movement = True\n              for k_idx in impassable_kinds:\n                  if full_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable_for_movement = False\n                      break\n              if not is_traversable_for_movement:\n                  continue\n              \n              # Add new state to queue and mark as visited\n              visited.add((next_y, next_x, new_dir_after_move))\n              q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n      return None # No path found to the primitive with correct orientation\n\n  # --- Main logic of collect_v2 function ---\n  \n  actions_taken = []\n  \n  # Reset the environment to get the initial state and access the underlying CraftState.\n  env.reset() \n  current_state = env._current_state \n\n  # Perform initial checks for immediate return conditions.\n  if primitive not in current_state.world.cookbook.kinds:\n      # Primitive ID is not recognized by the world's cookbook.\n      return [] \n  if current_state.inventory[primitive] > 0:\n      # Primitive is already in inventory.\n      return []\n\n  # Get the current grid and agent state for pathfinding.\n  full_grid = current_state.features_dict()['features_global']\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  \n  # Find the sequence of movement actions to reach the primitive.\n  path_of_moves = _find_path_and_orientation_for_collection(\n      start_pos, start_dir, full_grid, primitive, current_state.world\n  )\n\n  if path_of_moves is None:\n      # No path found to reach the primitive with the correct orientation for collection.\n      return [] \n\n  # Check if the found path, plus the final ACTION_USE, exceeds the maximum allowed steps.\n  # We need to reserve at least one slot for the ACTION_USE.\n  if len(path_of_moves) + 1 > MAX_COLLECT_STEPS:\n      return [] # Path is too long.\n\n  # Execute the found path of movement actions.\n  for action in path_of_moves:\n      actions_taken.append(action)\n      # Take the step in the environment; reward, done, and observations are not\n      # directly used here, but the internal state (env._current_state) is updated.\n      _, _, _ = env.step(action)\n      current_state = env._current_state \n\n  # After all movements are executed, the agent should be at the correct position\n  # and facing the correct direction as determined by the BFS.\n  # Now, perform the final ACTION_USE to collect the primitive.\n  actions_taken.append(ACTION_USE)\n  _, _, _ = env.step(ACTION_USE)\n  current_state = env._current_state # Update state after the USE action.\n\n  # Final verification: Check if the primitive was successfully collected into inventory.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken # Successfully collected!\n  else:\n      # Collection failed even after reaching the location and attempting USE.\n      # This could happen if, for example, a tool is required, the resource\n      # was depleted by another agent (not expected in this static setup),\n      # or other environmental constraints not fully modeled by simple traversability.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:34:04.078435", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction to collect that target via ACTION_USE.\n  # This focuses on cardinal directions, as ACTION_USE typically applies to what's directly in front.\n  RELATIVE_TO_REQUIRED_DIR = {\n      (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n      (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n      (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n      (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_cell_in_front(pos, direction):\n      y, x = pos\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return None # Should not happen with valid directions\n\n  # Breadth-First Search (BFS) to find a path to the primitive, ensuring the agent\n  # ends up at a position AND orientation suitable for collection.\n  def _find_path_and_orientation_for_collection(start_pos, start_dir, initial_grid, primitive_id, world):\n      grid_height, grid_width, _ = initial_grid.shape\n      impassable_kinds = world.non_grabbable_indices\n\n      # BFS state: (current_y, current_x, current_dir, path_of_actions)\n      q = collections.deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n      # Assuming moving in a direction also sets the agent's facing direction.\n      moves_options = [\n          (-1, 0, ACTION_UP, DIR_NORTH),\n          (1, 0, ACTION_DOWN, DIR_SOUTH),\n          (0, -1, ACTION_LEFT, DIR_WEST),\n          (0, 1, ACTION_RIGHT, DIR_EAST)\n      ]\n\n      while q:\n          curr_y, curr_x, curr_dir, path_actions = q.popleft()\n          \n          # Check if the primitive is cardinally adjacent to the current cell AND agent is facing it\n          for rel_dy, rel_dx in RELATIVE_TO_REQUIRED_DIR.keys(): # Iterate through cardinal relative positions\n              adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n              # Check bounds and if the adjacent cell contains the primitive\n              if (0 <= adj_y < grid_height and 0 <= adj_x < grid_width and\n                      initial_grid[adj_y, adj_x, primitive_id] > 0):\n                  \n                  # Primitive found at (adj_y, adj_x).\n                  # Check if the agent's current direction matches the direction required to collect it.\n                  required_dir_for_collection = RELATIVE_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n                  if curr_dir == required_dir_for_collection:\n                      # Found a path that leads to a position AND ensures the agent is oriented correctly.\n                      return (path_actions, (rel_dy, rel_dx))\n\n          # Explore neighboring cells\n          for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n              # Check bounds\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if the next cell is traversable for movement (i.e., does not contain any impassable kinds)\n              is_traversable_for_movement = True\n              for k_idx in impassable_kinds:\n                  if initial_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable_for_movement = False\n                      break\n              if not is_traversable_for_movement:\n                  continue\n              \n              # Add to queue only if this new state (position and direction) hasn't been visited\n              if (next_y, next_x, new_dir_after_move) not in visited:\n                  visited.add((next_y, next_x, new_dir_after_move))\n                  q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n      return (None, None) # No path found to the primitive with correct orientation\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state\n  current_obs = env.reset() \n  current_state = env._current_state # Access the underlying CraftState instance\n\n  # Initial checks\n  if primitive not in current_state.world.cookbook.kinds:\n      return [] # The specified primitive ID is not recognized\n  if current_state.inventory[primitive] > 0:\n      return [] # The primitive has already been collected\n\n  # Use the initial grid snapshot for pathfinding\n  initial_grid = current_state.features_dict()['features_global']\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  grid_height, grid_width, _ = initial_grid.shape # Get grid dimensions for validation\n\n  # Find the sequence of movements and the relative target coordinates.\n  # `relative_target_coords` will indicate an adjacent cell if a path is found.\n  path_of_moves, _ = _find_path_and_orientation_for_collection(\n      start_pos, start_dir, initial_grid, primitive, current_state.world\n  )\n\n  if path_of_moves is None:\n      return [] # No path found that leads to the primitive with correct orientation\n\n  # Execute the found path of movements\n  for action in path_of_moves:\n      # Check if adding this movement action would exceed the total allowed steps\n      # (reserving at least one slot for the final ACTION_USE)\n      if len(actions_taken) + 1 >= MAX_COLLECT_STEPS: \n          return [] # Prevent excessively long action sequences or exceeding step limit\n      actions_taken.append(action)\n      _, _, _ = env.step(action) # Take the step, update state\n      current_state = env._current_state # Always update the internal state after a step\n\n  # After executing all movement actions, the agent should be at the correct position\n  # and facing the correct direction as determined by the BFS. Now, perform the USE action.\n  \n  # Determine the cell directly in front of the agent based on its CURRENT position and direction.\n  target_cell_y, target_cell_x = _get_cell_in_front(current_state.pos, current_state.dir)\n  \n  is_primitive_collectible_now = False\n  if target_cell_y is not None and \\\n     0 <= target_cell_y < grid_height and 0 <= target_cell_x < grid_width:\n      # **IMPROVEMENT FOR V2**: Use the CURRENT grid from current_state for verification,\n      # instead of the initial `full_grid` snapshot. This ensures robustness against any\n      # unexpected grid changes between planning and execution steps (though unlikely for static primitives).\n      if current_state.grid[target_cell_y, target_cell_x, primitive] > 0: \n          is_primitive_collectible_now = True\n\n  if is_primitive_collectible_now:\n      # If the primitive is reachable, append and execute the ACTION_USE\n      if len(actions_taken) < MAX_COLLECT_STEPS: # Ensure there's still capacity for the USE action\n          actions_taken.append(ACTION_USE)\n          _, _, _ = env.step(ACTION_USE)\n          current_state = env._current_state # Update state after USE\n\n          # Final check: Confirm the primitive was successfully collected into inventory\n          if current_state.inventory[primitive] > 0:\n              return actions_taken # Successfully collected!\n          else:\n              # Collection failed even after reaching and attempting USE \n              # (e.g., requires specific tool, resource depleted, environmental constraint)\n              return [] \n      else:\n          # Max steps reached, no space left for the final USE action\n          return [] \n  else:\n      # This indicates a discrepancy: BFS found a path, but the primitive is not\n      # in the expected location (directly in front) after executing the path.\n      # This should ideally not happen if the environment state is deterministic and\n      # the BFS logic is perfectly aligned with the game mechanics.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:34:53.871297", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs\n  # DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3, USE: 4\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  all_actions = []\n  max_total_steps = 500  # Max steps to prevent infinite loops\n\n  # Initial observations after environment reset (done once per function call)\n  obs = env.reset()\n\n  # Helper to perform a step and update the actions list, returning done status and new obs.\n  # This uses a nonlocal 'obs' to update the observation in the outer scope, simplifying the main loop.\n  def _perform_action_and_update_state(action):\n      nonlocal obs\n      reward, done, new_obs = env.step(action)\n      all_actions.append(action)\n      obs = new_obs\n      return done, obs\n\n  # Define action mapping for BFS movement\n  ACTION_DR_DC = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # Check if the primitive is grabbable. If not, this function cannot collect it.\n  if primitive not in env.world.grabbable_indices:\n      return []\n\n  # Get the indices of impassable items.\n  # These are entities that the agent cannot move through.\n  impassable_indices = env.world.non_grabbable_indices\n\n  for step_count in range(max_total_steps):\n      # 1. Check if the primitive is already collected\n      inventory = obs['features_dict']['inventory']\n      if inventory[primitive] > 0:\n          break  # Goal achieved, break loop\n\n      # 2. Get current state information\n      grid = obs['features_dict']['features_global']\n      H, W, _ = grid.shape  # H = rows, W = columns\n      \n      # Current agent position (row, col) from normalized coordinates\n      current_pos_normalized = obs['features_dict']['pos']\n      current_pos = (int(current_pos_normalized[0] * H), int(current_pos_normalized[1] * W))\n\n      # 3. Locate all instances of the primitive on the grid\n      primitive_locations = []\n      for r in range(H):\n          for c in range(W):\n              if grid[r, c, primitive] == 1:\n                  primitive_locations.append((r, c))\n\n      if not primitive_locations:\n          # Primitive not found on the grid and not in inventory. Cannot collect.\n          break\n\n      # 4. Determine all valid target cells for the 'USE' action.\n      # An agent can 'USE' an object if it's in its 3x3 neighborhood (Chebychev distance 1)\n      # of the object's location.\n      target_cells_for_use = set()\n      for pr, pc in primitive_locations:\n          for dr_offset in [-1, 0, 1]:\n              for dc_offset in [-1, 0, 1]:\n                  nr, nc = pr + dr_offset, pc + dc_offset\n                  if 0 <= nr < H and 0 <= nc < W:\n                      target_cells_for_use.add((nr, nc))\n      \n      # 5. Pathfinding (BFS) to reach any of the target_cells_for_use.\n      queue = collections.deque([(current_pos, [])])  # (position: (r, c), path_actions: list)\n      visited = {current_pos}\n      path_to_target_cell = None\n\n      while queue:\n          (r, c), path_actions = queue.popleft()\n\n          # If current position is one of the target cells, we found a path\n          if (r, c) in target_cells_for_use:\n              path_to_target_cell = path_actions\n              break\n\n          # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n          for action_val, (dr, dc) in ACTION_DR_DC.items():\n              nr, nc = r + dr, c + dc\n\n              # Check bounds\n              if not (0 <= nr < H and 0 <= nc < W):\n                  continue\n              \n              # Check if already visited\n              if (nr, nc) in visited:\n                  continue\n\n              # Check if the cell (nr, nc) is impassable\n              is_impassable = False\n              for k_idx in impassable_indices:\n                  if grid[nr, nc, k_idx] == 1: # If this cell contains an impassable item\n                      is_impassable = True\n                      break\n              if is_impassable:\n                  continue\n\n              visited.add((nr, nc))\n              queue.append(((nr, nc), path_actions + [action_val]))\n\n      if path_to_target_cell is None:\n          # Cannot reach any USE-able cell for the primitive.\n          break  # Exit loop, cannot collect\n\n      # 6. Execute movement actions found by BFS\n      for action in path_to_target_cell:\n          done, obs = _perform_action_and_update_state(action)\n          if done:\n              return all_actions # Episode ended\n\n          # Check if collected *during* movement (unlikely for discrete items, but safe)\n          inventory = obs['features_dict']['inventory']\n          if inventory[primitive] > 0:\n              return all_actions # Collected already\n\n      # 7. Execute USE action after reaching a target cell's vicinity\n      done, obs = _perform_action_and_update_state(USE)\n      if done:\n          return all_actions # Episode ended\n\n      # Re-check inventory after USE action\n      inventory = obs['features_dict']['inventory']\n      if inventory[primitive] > 0:\n          break  # Primitive collected, break outer loop\n\n  return all_actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:34:54.860502", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs\n  # DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3, USE: 4\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  ACTION_DR_DC = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  all_actions = []\n  max_total_steps = 500  # Max steps to prevent infinite loops\n\n  # Helper function to check if a cell contains an impassable object.\n  # A cell is considered impassable if it contains any item from the\n  # world's non-grabbable indices.\n  def _is_cell_impassable(current_grid, r, c, non_grabbable_indices):\n      for k_idx in non_grabbable_indices:\n          if current_grid[r, c, k_idx] == 1:\n              return True\n      return False\n\n  # Initial observations after environment reset\n  obs = env.reset()\n\n  # Check if the primitive is grabbable. If it's not in the grabbable_indices,\n  # this function cannot \"collect\" it.\n  if primitive not in env.world.grabbable_indices:\n      return []\n\n  # Get the set of non-grabbable indices for efficient lookups in BFS\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  for _ in range(max_total_steps):\n      # 1. Check if the primitive is already collected (goal achieved)\n      inventory = obs['features_dict']['inventory']\n      if inventory[primitive] > 0:\n          break\n\n      # 2. Get current state information\n      grid = obs['features_dict']['features_global']\n      H, W, _ = grid.shape # H = rows, W = columns\n      \n      # Current agent position (row, col) from normalized coordinates\n      current_pos_normalized = obs['features_dict']['pos']\n      current_pos = (int(current_pos_normalized[0] * H), int(current_pos_normalized[1] * W))\n\n      # 3. Locate all instances of the primitive on the grid\n      primitive_locations = []\n      for r in range(H):\n          for c in range(W):\n              if grid[r, c, primitive] == 1:\n                  primitive_locations.append((r, c))\n\n      if not primitive_locations:\n          # Primitive not found on the grid and not in inventory. Cannot collect.\n          break \n\n      # 4. Determine all possible target cells where the 'USE' action can be performed.\n      # This includes cells in the 3x3 neighborhood around any primitive location.\n      target_cells_for_use = set()\n      for pr, pc in primitive_locations:\n          for dr_offset in [-1, 0, 1]:\n              for dc_offset in [-1, 0, 1]:\n                  nr, nc = pr + dr_offset, pc + dc_offset\n                  # Ensure the neighborhood cell is within grid bounds\n                  if 0 <= nr < H and 0 <= nc < W:\n                      target_cells_for_use.add((nr, nc))\n      \n      # 5. Check if the agent is already in a position to USE the primitive.\n      path_to_reach_use_position = []\n      if current_pos not in target_cells_for_use:\n          # 6. Pathfinding (BFS) to reach any of the target cells.\n          queue = collections.deque([(current_pos, [])])  # (position: (r, c), path_actions: list)\n          visited = {current_pos}\n          \n          found_path = False\n          while queue:\n              (r, c), path_actions = queue.popleft()\n\n              # If current position is one of the target cells, we found a path\n              if (r, c) in target_cells_for_use:\n                  path_to_reach_use_position = path_actions\n                  found_path = True\n                  break\n\n              # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n              for action_val, (dr, dc) in ACTION_DR_DC.items():\n                  nr, nc = r + dr, c + dc\n\n                  # Check bounds, if already visited, and if the cell is impassable\n                  if (0 <= nr < H and 0 <= nc < W and\n                      (nr, nc) not in visited and\n                      not _is_cell_impassable(grid, nr, nc, non_grabbable_indices)):\n                      \n                      visited.add((nr, nc))\n                      queue.append(((nr, nc), path_actions + [action_val]))\n          \n          if not found_path:\n              # Cannot reach any USE-able cell for the primitive.\n              break  # Exit loop, cannot collect\n\n      # 7. Execute movement actions found by BFS\n      for action in path_to_reach_use_position:\n          reward, done, obs = env.step(action)\n          all_actions.append(action)\n          if done:\n              return all_actions # Episode ended prematurely\n\n          # Check if collected *during* movement (e.g., if there were multiple primitives\n          # and picking one up also affects others, or immediate pickup on step).\n          # This is a safeguard, though `USE` is usually required for collection.\n          inventory = obs['features_dict']['inventory']\n          if inventory[primitive] > 0:\n              return all_actions\n\n      # 8. Execute USE action after reaching a target cell's vicinity\n      reward, done, obs = env.step(USE)\n      all_actions.append(USE)\n      if done:\n          return all_actions # Episode ended prematurely\n\n      # Re-check inventory after USE action to confirm collection\n      inventory = obs['features_dict']['inventory']\n      if inventory[primitive] > 0:\n          break  # Primitive collected, break the main loop\n\n  return all_actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:36:11.830319", "function_name": "collect", "function_body": "  import collections # Required for deque\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Define direction constants (assuming 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  _DIR_UP = 0\n  _DIR_RIGHT = 1\n  _DIR_DOWN = 2\n  _DIR_LEFT = 3\n\n  # Helper function to calculate turn actions to change from current_dir to target_dir\n  def _get_turn_actions(current_dir, target_dir):\n      turn_actions = []\n      \n      # Calculate shortest rotation\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # One clockwise turn needed\n          turn_actions.append(_RIGHT)\n      elif diff == 2: # Two turns needed (180 degrees)\n          turn_actions.extend([_RIGHT, _RIGHT]) # Can be two LEFTs too, same cost\n      elif diff == 3: # One counter-clockwise turn needed\n          turn_actions.append(_LEFT)\n      \n      return turn_actions\n\n  # Helper function to get the cardinal direction from (from_x, from_y) to (to_x, to_y)\n  def _get_relative_direction(from_x, from_y, to_x, to_y):\n      \"\"\"Determines the direction from (from_x, from_y) to (to_x, to_y) if adjacent.\"\"\"\n      if from_x == to_x:\n          if to_y == from_y - 1: return _DIR_UP\n          if to_y == from_y + 1: return _DIR_DOWN\n      elif from_y == to_y:\n          if to_x == from_x + 1: return _DIR_RIGHT\n          if to_x == from_x - 1: return _DIR_LEFT\n      return None # Not adjacent in a cardinal direction\n\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Get current agent direction (convert one-hot array to integer)\n  current_dir_int = np.argmax(features_dict['direction'])\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = set() # Use a set for faster lookups\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell\n      if current_grid[x, y, primitive] == 1:\n        primitive_locations.add((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  # Define truly impassable terrain for movement (e.g., water, walls)\n  impassable_movement_terrain_indices = {env.world.water_index} \n  # If stone is intended as an impassable wall, uncomment the line below:\n  # impassable_movement_terrain_indices.add(env.world.stone_index)\n\n  def is_obstacle(x, y, grid, impassable_kinds_set):\n    \"\"\"Checks if the cell (x,y) contains any truly impassable item for movement.\"\"\"\n    for k in impassable_kinds_set:\n      if grid[x, y, k] == 1:\n        return True\n    return False\n\n  # BFS setup\n  # Queue stores tuples: (current_x, current_y, current_direction, [path_actions_to_reach_here])\n  q = collections.deque()\n  q.append((current_px, current_py, current_dir_int, [])) \n  \n  # Set to store visited states: ((x, y), direction) to avoid cycles and re-processing longer paths to same state\n  visited = set() \n  visited.add((current_px, current_py, current_dir_int))\n\n  # Directions for movement and the resulting new agent direction\n  # (dx, dy, new_dir_after_move, action_to_take_for_this_move)\n  move_options = [\n      (0, -1, _DIR_UP, _UP),    # Move North (Up)\n      (0, 1, _DIR_DOWN, _DOWN),  # Move South (Down)\n      (-1, 0, _DIR_LEFT, _LEFT), # Move West (Left)\n      (1, 0, _DIR_RIGHT, _RIGHT) # Move East (Right)\n  ]\n\n  # best_path_to_collect will store the first found shortest path (guaranteed by BFS)\n  best_path_to_collect = []\n\n  while q:\n    cx, cy, cdir, current_path = q.popleft()\n\n    # --- GOAL CHECK ---\n    # Check if from the current position (cx, cy) and facing cdir,\n    # we are adjacent to a primitive and can immediately USE it.\n    for px, py in primitive_locations:\n        # Check if (cx, cy) is adjacent to (px, py) (Manhattan distance 1)\n        if abs(cx - px) + abs(cy - py) == 1:\n            # Determine the required direction for the agent to face (px, py) from (cx, cy)\n            required_face_dir = _get_relative_direction(cx, cy, px, py)\n            \n            if required_face_dir is not None: # Ensure it's a valid cardinal neighbor\n                # Calculate turns needed to align with the required facing direction\n                turns_to_face = _get_turn_actions(cdir, required_face_dir)\n                \n                # If already facing or can turn to face, this is a valid interaction point.\n                # Since BFS explores layer by layer, the *first* time we hit such a state\n                # (position, direction from which _USE is possible), it represents\n                # the shortest path to collect any primitive.\n                best_path_to_collect = current_path + turns_to_face + [_USE]\n                return best_path_to_collect # Found the shortest path, return immediately\n\n    # --- EXPLORE MOVEMENT NEIGHBORS ---\n    for dx, dy, new_agent_dir_after_move, move_action in move_options:\n      nx, ny = cx + dx, cy + dy\n\n      # Check boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if the potential target cell is an obstacle for movement\n      if is_obstacle(nx, ny, current_grid, impassable_movement_terrain_indices):\n        continue\n\n      # Calculate turns needed to align with the direction of the intended move\n      # The agent must face the direction of movement BEFORE moving.\n      turns_for_move = _get_turn_actions(cdir, new_agent_dir_after_move)\n      \n      # The state after moving: new position (nx, ny) and new direction (new_agent_dir_after_move)\n      new_state_tuple = (nx, ny, new_agent_dir_after_move)\n\n      if new_state_tuple not in visited:\n        # Construct the path segment for this step: turns + movement\n        path_segment = turns_for_move + [move_action]\n        new_total_path = current_path + path_segment\n        \n        visited.add(new_state_tuple)\n        q.append((nx, ny, new_agent_dir_after_move, new_total_path))\n  \n  # If BFS completes and no path to collect the primitive was found (e.g., unreachable)\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:36:12.813689", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Define direction constants for agent's orientation (internal representation)\n  _DIR_UP = 0\n  _DIR_RIGHT = 1\n  _DIR_DOWN = 2\n  _DIR_LEFT = 3\n\n  # Get action mappings from the environment\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario (assuming they are consistent)\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position (features_dict['pos'] is normalized 0-1)\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  \n  # Get current agent direction (convert one-hot array to integer 0-3)\n  current_dir_int = np.argmax(features_dict['direction'])\n\n  # Early exit if the primitive is not grabbable\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Find all grid locations where the primitive exists\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell (assuming 1 for presence)\n      if current_grid[x, y, primitive] == 1: \n        primitive_locations.append((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  # Define truly impassable terrain indices (e.g., water)\n  impassable_movement_terrain_indices = {env.world.water_index} \n  # If stone or other entities are also intended to be impassable walls, add them here.\n  # impassable_movement_terrain_indices.add(env.world.stone_index)\n\n  def is_obstacle(x, y, grid, impassable_kinds_set):\n    \"\"\"\n    Checks if the cell (x,y) contains any truly impassable item for agent movement.\n    Assumes (x,y) is already validated to be within grid bounds.\n    \"\"\"\n    for k in impassable_kinds_set:\n      if grid[x, y, k] == 1: \n        return True\n    return False\n\n  # --- BFS for shortest path to an *interaction point* ---\n  # BFS queue stores tuples: ((current_x, current_y, current_direction), [path_actions_taken])\n  q = collections.deque()\n  start_state = (current_px, current_py, current_dir_int)\n  q.append((start_state, [])) \n  \n  # Set to store visited states (position + direction) to avoid cycles and redundant paths\n  visited = {start_state} \n\n  # Define possible movement actions, their resulting new position, and the agent's direction after the move\n  # Format: (dx, dy, environment_action_id, new_agent_direction_constant)\n  move_actions_info = [\n      (0, -1, _UP, _DIR_UP),    # Move up, agent faces up\n      (0, 1, _DOWN, _DIR_DOWN),  # Move down, agent faces down\n      (-1, 0, _LEFT, _DIR_LEFT), # Move left, agent faces left\n      (1, 0, _RIGHT, _DIR_RIGHT) # Move right, agent faces right\n  ]\n\n  # Define turning actions (in-place rotation)\n  # Format: (environment_action_id, direction_offset)\n  # offset -1 for left turn (counter-clockwise), +1 for right turn (clockwise)\n  turn_actions_info = [\n      (_LEFT, -1), \n      (_RIGHT, 1)  \n  ]\n\n  # Pre-calculate all target interaction states for all primitive locations.\n  # A target interaction state is (adjacent_x, adjacent_y, required_facing_direction)\n  # from which the agent can successfully _USE_ the primitive.\n  target_interaction_states = set()\n  for Px, Py in primitive_locations:\n      # If agent is at (Px-1, Py), it needs to face RIGHT (_DIR_RIGHT) to use (Px, Py)\n      if Px - 1 >= 0:  target_interaction_states.add((Px - 1, Py, _DIR_RIGHT))\n      # If agent is at (Px+1, Py), it needs to face LEFT (_DIR_LEFT) to use (Px, Py)\n      if Px + 1 < WIDTH: target_interaction_states.add((Px + 1, Py, _DIR_LEFT))\n      # If agent is at (Px, Py-1), it needs to face DOWN (_DIR_DOWN) to use (Px, Py)\n      if Py - 1 >= 0:  target_interaction_states.add((Px, Py - 1, _DIR_DOWN))\n      # If agent is at (Px, Py+1), it needs to face UP (_DIR_UP) to use (Px, Py)\n      if Py + 1 < HEIGHT: target_interaction_states.add((Px, Py + 1, _DIR_UP))\n    \n  # Main BFS loop\n  while q:\n    (cx, cy, c_dir), current_path = q.popleft()\n\n    # Check if the current state is one of the goal interaction states\n    if (cx, cy, c_dir) in target_interaction_states:\n        # Goal reached: agent is at a valid adjacent position, facing the primitive.\n        # Append the _USE action as the final step and return the path.\n        # BFS guarantees this is the shortest path.\n        return current_path + [_USE]\n\n    # Explore movement actions\n    for dx, dy, move_action_id, n_dir_after_move in move_actions_info:\n      nx, ny = cx + dx, cy + dy\n\n      # Check for valid grid bounds and if the new cell is an obstacle\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue # Out of bounds\n      if is_obstacle(nx, ny, current_grid, impassable_movement_terrain_indices):\n        continue # Obstacle present\n\n      new_state = (nx, ny, n_dir_after_move) \n      if new_state not in visited:\n        visited.add(new_state)\n        q.append((new_state, current_path + [move_action_id]))\n\n    # Explore turning actions (agent stays in the same cell but changes direction)\n    for turn_action_id, dir_offset in turn_actions_info:\n        n_dir_after_turn = (c_dir + dir_offset + 4) % 4 # Ensure direction wraps correctly (0-3)\n        new_state = (cx, cy, n_dir_after_turn)\n        if new_state not in visited:\n            visited.add(new_state)\n            q.append((new_state, current_path + [turn_action_id]))\n\n  # If BFS finishes and no path was found (e.g., primitive is entirely unreachable)\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:37:22.253878", "function_name": "collect", "function_body": "  # --- Constants ---\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  # Mapping: movement action -> (new_direction, delta_x, delta_y)\n  # When an agent moves, its facing direction also changes to the direction of movement.\n  ACTION_TO_EFFECT = {\n      ACTION_UP: (DIR_UP, 0, -1),    # Move up: new direction is UP, y-coordinate decreases\n      ACTION_DOWN: (DIR_DOWN, 0, 1),   # Move down: new direction is DOWN, y-coordinate increases\n      ACTION_LEFT: (DIR_LEFT, -1, 0),  # Move left: new direction is LEFT, x-coordinate decreases\n      ACTION_RIGHT: (DIR_RIGHT, 1, 0), # Move right: new direction is RIGHT, x-coordinate increases\n  }\n\n  # Mapping: (delta_x, delta_y) vector from agent's position to primitive's position -> required_agent_direction\n  # This determines which way the agent must face to 'USE' an adjacent primitive.\n  DELTA_TO_DIRECTION = {\n      (0, -1): DIR_UP,    # Primitive is directly \"up\" from agent\n      (1, 0): DIR_RIGHT,  # Primitive is directly \"right\" from agent\n      (0, 1): DIR_DOWN,   # Primitive is directly \"down\" from agent\n      (-1, 0): DIR_LEFT,  # Primitive is directly \"left\" from agent\n  }\n\n  # --- State Information Extraction ---\n  # Access the current state directly from the environment to get exact integer positions and directions.\n  # This avoids potential rounding issues or normalization conversions that might occur in `env.observations()['features_dict']`.\n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos_x, current_pos_y = current_state.pos\n  initial_dir = current_state.dir\n\n  world = env.world\n  # Convert the set of non-grabbable indices to a list for consistent numpy advanced indexing.\n  non_grabbable_indices = list(world.non_grabbable_indices) \n\n  W, H, K = grid.shape # W: grid width (number of columns, corresponds to x-dimension)\n                       # H: grid height (number of rows, corresponds to y-dimension)\n                       # K: number of different item kinds\n\n  # --- Grid Traversability Mask ---\n  # Create a boolean mask where True indicates a traversable cell.\n  traversable_mask = np.ones((W, H), dtype=bool)\n  if non_grabbable_indices:\n      # Identify cells that contain any non-grabbable item (obstacles).\n      # `grid[:, :, non_grabbable_indices]` selects all cells for these specific kinds.\n      # `np.any(..., axis=2)` checks if any of these non-grabbable kinds are present in a cell.\n      obstacles_present = np.any(grid[:, :, non_grabbable_indices] > 0, axis=2)\n      # Mark cells with obstacles as non-traversable (False).\n      traversable_mask[obstacles_present] = False\n  \n  # Define a helper function to quickly check if a given (x, y) coordinate is valid and traversable.\n  def is_valid_and_traversable(x, y):\n      return 0 <= x < W and 0 <= y < H and traversable_mask[x, y]\n\n  # Early exit: If the agent's starting position is not traversable, no path can be found.\n  if not is_valid_and_traversable(current_pos_x, current_pos_y):\n      return []\n\n  # --- Identify Primitive Locations ---\n  # Find all (x, y) coordinates on the grid where the target primitive exists.\n  primitive_locations = []\n  # `np.where(grid[:, :, primitive] > 0)` returns two arrays: (y_indices, x_indices).\n  # We iterate through them simultaneously to get (x, y) pairs.\n  py_coords, px_coords = np.where(grid[:, :, primitive] > 0)\n  for px, py in zip(px_coords, py_coords):\n      primitive_locations.append((px, py))\n\n  # Early exit: If the primitive doesn't exist anywhere on the map, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # --- Identify Primitive Target States ---\n  # A \"primitive target state\" is defined as a specific (agent_x, agent_y, agent_direction)\n  # from which the ACTION_USE can successfully collect the primitive.\n  # This requires the agent to be adjacent to the primitive and facing it correctly.\n  primitive_target_states = set()\n  for px, py in primitive_locations:\n      # Iterate over the four cells directly adjacent (cardinal neighbors) to the primitive.\n      # `(dx, dy)` here represents the vector from the agent's position to the primitive's position.\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: \n          # Calculate the agent's potential position (ax, ay) if it were to collect from this side.\n          # If the primitive is at (px, py) and the vector from agent to primitive is (dx, dy),\n          # then agent's position is (px - dx, py - dy).\n          ax, ay = px - dx, py - dy \n\n          # Check if this potential agent position is within grid boundaries and is traversable.\n          if not is_valid_and_traversable(ax, ay):\n              continue\n          \n          # Determine the required direction the agent must be facing from (ax, ay)\n          # to correctly 'USE' the primitive at (px, py). This direction is given by (dx, dy).\n          required_agent_dir = DELTA_TO_DIRECTION[(dx, dy)]\n          \n          # Add this valid agent state to our set of target states.\n          primitive_target_states.add((ax, ay, required_agent_dir))\n\n  # Early exit: If no valid states exist from which the primitive can be collected\n  # (e.g., all primitive locations are completely surrounded by untraversable cells),\n  # then it's uncollectable.\n  if not primitive_target_states:\n      return []\n\n  # --- Breadth-First Search (BFS) for Shortest Path ---\n  # A state in our search space is defined by (agent_x, agent_y, agent_direction).\n  start_state = (current_pos_x, current_pos_y, initial_dir)\n  \n  # The BFS queue stores tuples: ((current_x, current_y, current_dir), [list_of_actions_taken_to_reach_this_state])\n  q = deque([(start_state, [])]) \n  \n  # The `visited` set keeps track of (x, y, dir) states that have already been explored\n  # to prevent infinite loops (cycles) and redundant path computations.\n  visited = {start_state}\n\n  while q:\n      (curr_x, curr_y, curr_dir), actions_so_far = q.popleft()\n\n      # Check if the current state is one of our desired primitive target states.\n      # If it is, we have found the shortest path to a state from which the primitive can be collected.\n      if (curr_x, curr_y, curr_dir) in primitive_target_states:\n          # Append the 'USE' action to the path and return the complete sequence of actions.\n          return actions_so_far + [ACTION_USE]\n\n      # Explore all possible next states by applying movement actions.\n      for action_val, (next_dir, dx, dy) in ACTION_TO_EFFECT.items():\n          next_x, next_y = curr_x + dx, curr_y + dy # Calculate the new agent position after the movement action\n          next_state = (next_x, next_y, next_dir)    # The new state includes the new position and new facing direction\n\n          # Check if the next cell is within grid boundaries, is traversable,\n          # and if this specific (position, direction) state has not been visited yet.\n          if (is_valid_and_traversable(next_x, next_y) and\n              next_state not in visited):\n              \n              # Mark the new state as visited and add it to the queue for further exploration.\n              visited.add(next_state)\n              q.append((next_state, actions_so_far + [action_val]))\n  \n  # If the BFS queue becomes empty and no path to any primitive target state was found,\n  # it means the primitive is unreachable. Return an empty list of actions.\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:37:23.253502", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Action constants, aligning with CraftLab/CraftWorld definitions\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent direction constants\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  # Mapping of movement action to its effect: (new_agent_direction, delta_x, delta_y)\n  # (delta_x, delta_y) represents the change in (column, row) coordinates when moving.\n  ACTION_MOVEMENTS = {\n      ACTION_UP: (DIR_UP, 0, -1),\n      ACTION_DOWN: (DIR_DOWN, 0, 1),\n      ACTION_LEFT: (DIR_LEFT, -1, 0),\n      ACTION_RIGHT: (DIR_RIGHT, 1, 0),\n  }\n\n  # Mapping of a relative position vector (from agent to target) to the required agent facing direction.\n  # For example, if target is at (x+1, y) relative to agent, agent must face RIGHT.\n  RELATIVE_POS_TO_DIRECTION = {\n      (0, -1): DIR_UP,     # Target is directly above the agent\n      (0, 1): DIR_DOWN,    # Target is directly below the agent\n      (-1, 0): DIR_LEFT,   # Target is directly to the left of the agent\n      (1, 0): DIR_RIGHT,   # Target is directly to the right of the agent\n  }\n\n  # 1. Retrieve current state information from the environment.\n  obs = env.observations()\n  # The global grid, shape (WIDTH, HEIGHT, N_KINDS).\n  current_grid = obs['features_dict']['features_global']\n  # Agent's current position (column, row).\n  agent_current_x, agent_current_y = obs['features_dict']['pos'].astype(int)\n  # Agent's current facing direction (integer 0-3).\n  agent_current_direction = np.argmax(obs['features_dict']['direction'])\n\n  # Access world configuration to identify non-grabbable entities (obstacles).\n  world_config = env.world\n  # Convert set of obstacle indices to a tuple for efficient NumPy advanced indexing.\n  obstacle_kind_indices = tuple(world_config.non_grabbable_indices) \n\n  grid_width, grid_height, _ = current_grid.shape\n\n  # 2. Pre-calculate a traversability map for the grid.\n  # Initialize all cells as traversable (True).\n  traversable_map = np.ones((grid_width, grid_height), dtype=bool)\n  if obstacle_kind_indices: # Only update if there are obstacles defined.\n      # `np.any` checks if any of the specified obstacle kinds are present in a cell.\n      cells_with_obstacles = np.any(current_grid[:, :, obstacle_kind_indices] > 0, axis=2)\n      traversable_map[cells_with_obstacles] = False\n  \n  # Helper function to check if a coordinate (x, y) is within grid bounds and traversable.\n  def is_valid_and_traversable(x, y):\n      return 0 <= x < grid_width and 0 <= y < grid_height and traversable_map[x, y]\n\n  # If the agent starts on an untraversable cell, no path is possible.\n  if not is_valid_and_traversable(agent_current_x, agent_current_y):\n      return []\n\n  # 3. Identify all grid locations where the target primitive exists.\n  primitive_locations = [] # Stores (x, y) tuples of primitive positions.\n  # `np.where` returns (row_indices, col_indices) for elements satisfying the condition.\n  # So, `y_coords` are row indices and `x_coords` are column indices.\n  primitive_y_coords, primitive_x_coords = np.where(current_grid[:, :, primitive] > 0)\n  for px, py in zip(primitive_x_coords, primitive_y_coords):\n      primitive_locations.append((px, py))\n\n  # If the primitive is not present on the map, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # 4. Determine \"collection goal states\" for the agent.\n  # A collection goal state is (agent_x, agent_y, agent_direction) from which\n  # the `ACTION_USE` can successfully collect the primitive. This requires the agent to be:\n  #   a) Positioned on a traversable cell.\n  #   b) Adjacent (cardinally) to a primitive.\n  #   c) Facing that specific primitive.\n  collection_goal_states = set()\n  # Cardinal delta positions from agent to an adjacent cell (e.g., (0,1) means target is below agent).\n  CARDINAL_ADJACENCIES = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n  \n  for prim_x, prim_y in primitive_locations:\n      for delta_x_from_agent, delta_y_from_agent in CARDINAL_ADJACENCIES:\n          # Calculate the potential agent position relative to the primitive.\n          # If primitive is at (prim_x, prim_y) and delta_x_from_agent is (1,0) (primitive is right of agent),\n          # then the agent's position would be (prim_x - 1, prim_y).\n          potential_agent_x = prim_x - delta_x_from_agent\n          potential_agent_y = prim_y - delta_y_from_agent\n\n          # Check if this potential agent position is valid and traversable.\n          if not is_valid_and_traversable(potential_agent_x, potential_agent_y):\n              continue\n          \n          # Determine the required direction the agent must be facing from\n          # `(potential_agent_x, potential_agent_y)` to face `(prim_x, prim_y)`.\n          # This direction corresponds to the vector `(delta_x_from_agent, delta_y_from_agent)`.\n          required_agent_facing_direction = RELATIVE_POS_TO_DIRECTION[(delta_x_from_agent, delta_y_from_agent)]\n          \n          collection_goal_states.add((potential_agent_x, potential_agent_y, required_agent_facing_direction))\n\n  # If no valid collection states can be reached (e.g., all primitives are fully surrounded by obstacles).\n  if not collection_goal_states:\n      return []\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest action sequence.\n  # A state in BFS is defined by (agent_x, agent_y, agent_direction).\n  start_state = (agent_current_x, agent_current_y, agent_current_direction)\n  \n  # The queue stores tuples: (current_state_tuple, [list_of_actions_taken_to_reach_this_state]).\n  bfs_queue = deque([(start_state, [])]) \n  \n  # Set to keep track of visited states to prevent infinite loops and redundant path exploration.\n  visited_states = {start_state}\n\n  while bfs_queue:\n      (curr_x, curr_y, curr_dir), path_actions = bfs_queue.popleft()\n\n      # If the current state is one of our determined collection goal states,\n      # we have found the shortest path.\n      if (curr_x, curr_y, curr_dir) in collection_goal_states:\n          # Append the `ACTION_USE` to the path and return the complete sequence.\n          return path_actions + [ACTION_USE]\n\n      # Explore all possible next states by trying each movement action.\n      for action_value, (new_dir, dx, dy) in ACTION_MOVEMENTS.items():\n          # Calculate the next position and direction after taking `action_value`.\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_state = (next_x, next_y, new_dir)\n\n          # Check if the next position is valid and traversable, and if this new state\n          # has not been visited yet.\n          if (is_valid_and_traversable(next_x, next_y) and\n              next_state not in visited_states):\n              \n              visited_states.add(next_state)\n              # Add the new state to the queue with its accumulated path of actions.\n              bfs_queue.append((next_state, path_actions + [action_value]))\n  \n  # If the BFS queue becomes empty and no path to any collection goal state was found.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
