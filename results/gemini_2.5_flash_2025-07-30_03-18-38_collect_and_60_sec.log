{"timestamp": "2025-07-30T21:46:49.876663", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n  import numpy as np\n\n  # Define actions using IntEnum for clarity and compatibility\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  # Agent directions (matching CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"Returns the coordinates of the cell directly in front of (y,x) based on agent's direction.\"\"\"\n      if direction == DIR_EAST:\n          return y, x + 1\n      elif direction == DIR_SOUTH:\n          return y + 1, x\n      elif direction == DIR_WEST:\n          return y, x - 1\n      elif direction == DIR_NORTH:\n          return y - 1, x\n      return y, x # Should not be reached with valid directions\n\n  # Mapping of movement action to (resulting_facing_direction, dy, dx)\n  # Assumes agent faces the direction of its last movement.\n  MOVEMENT_MAP = {\n      Action.UP:    (DIR_NORTH, -1, 0), # Move North (dy=-1, dx=0), agent faces North\n      Action.DOWN:  (DIR_SOUTH, 1, 0),  # Move South (dy=1, dx=0), agent faces South\n      Action.LEFT:  (DIR_WEST, 0, -1),  # Move West (dy=0, dx=-1), agent faces West\n      Action.RIGHT: (DIR_EAST, 0, 1)    # Move East (dy=0, dx=1), agent faces East\n  }\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state and access its internal CraftState,\n  # ensuring a consistent starting point for pathfinding, as in v1.\n  env.reset() \n  current_state = env._current_state \n\n  world = current_state.world\n  cookbook = world.cookbook\n\n  # Initial checks for early exit\n  if primitive not in cookbook.kinds:\n      # The specified primitive ID is not a recognized kind in the world.\n      return [] \n  if current_state.inventory[primitive] > 0:\n      # The primitive has already been collected or is present in inventory.\n      return [] \n\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir # Use the agent's current direction from the reset state\n\n  # Determine truly impassable kinds for agent movement.\n  # Water is typically impassable. Workshops are non-grabbable but are usually traversable.\n  impassable_for_movement = set()\n  if world.water_index in world.kinds:\n      impassable_for_movement.add(world.water_index)\n  for k_idx in world.non_grabbable_indices:\n      # Exclude workshop indices if they are considered traversable for movement\n      if k_idx not in world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n  impassable_for_movement_list = list(impassable_for_movement) # Convert to list for numpy indexing\n\n  # Breadth-First Search (BFS) to find a path to the primitive, ensuring the agent\n  # ends up at a position AND orientation suitable for collection.\n  q = collections.deque()\n  # BFS state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  q.append((start_y, start_x, start_dir, []))\n  \n  # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_primitive_and_use = None # This will store the sequence of actions including the final USE\n\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n      \n      # Pruning: If the current path is already too long (reserving at least 1 step for ACTION_USE), skip.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # --- GOAL CHECK 1: Primitive is on the current cell and agent can pick it up directly ---\n      # This applies if the agent can move onto the primitive's cell and collect it (e.g., ground items like stone/wood).\n      # We ensure the primitive itself is not considered impassable for movement to reach this state.\n      if (primitive not in impassable_for_movement and \n          full_grid[curr_y, curr_x, primitive] > 0):\n          path_to_primitive_and_use = path + [Action.USE]\n          break # Path found, exit BFS\n\n      # --- GOAL CHECK 2: Primitive is cardinally adjacent AND agent is facing it correctly ---\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Check bounds for the cell directly in front of the agent\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width):\n          # Check if the cell directly in front contains the primitive\n          if full_grid[facing_y, facing_x, primitive] > 0:\n              # Found a path that leads to a position AND ensures the agent is oriented correctly.\n              path_to_primitive_and_use = path + [Action.USE]\n              break # Path found, exit BFS\n\n      # --- Explore neighboring cells for movement ---\n      for action_move, (new_dir_after_move, dy, dx) in MOVEMENT_MAP.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Check bounds for the next movement cell\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the next cell is traversable (i.e., does not contain any impassable kinds)\n          # Use numpy.any for efficient check against the list of impassable kinds.\n          if impassable_for_movement_list and np.any(full_grid[next_y, next_x, impassable_for_movement_list] > 0):\n              continue\n          \n          # Add to queue only if this new state (position and direction) hasn't been visited\n          if (next_y, next_x, new_dir_after_move) not in visited:\n              visited.add((next_y, next_x, new_dir_after_move))\n              q.append((next_y, next_x, new_dir_after_move, path + [action_move]))\n  \n  # --- Execute the found path (if any) ---\n  if path_to_primitive_and_use is None:\n      # No valid path was found to reach a position/orientation suitable for collection.\n      return [] \n\n  for action in path_to_primitive_and_use:\n      # Stop if the total number of actions taken reaches the limit\n      if len(actions_taken) >= MAX_COLLECT_STEPS:\n          break \n\n      actions_taken.append(action)\n      # Step the environment with the current action.\n      # We ignore reward, but track the 'done' status for early termination.\n      _, done, _ = env.step(action) \n      current_state = env._current_state # Always update the internal state after a step\n\n      # Check if the primitive has been collected after this step.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken # Successfully collected!\n\n      # If the episode ends prematurely (e.g., ran out of steps internally)\n      # before collecting, then this path failed.\n      if done:\n          return []\n  \n  # If the loop completes (either all planned actions executed or MAX_COLLECT_STEPS hit)\n  # and the primitive is not in inventory, it means collection failed.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken # Successfully collected after last step\n  else:\n      return [] # Collection failed after executing the path.", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:46:49.946964", "function_name": "collect", "function_body": "    actions_taken = []\n    \n    # Reset the environment to get the initial state and access its internal CraftState.\n    # This ensures we start from a clean, known state for pathfinding.\n    env.reset() \n    current_state = env._current_state \n\n    # Ensure the primitive is a valid kind known to the world\n    if primitive not in current_state.world.cookbook.kinds:\n        return [] \n\n    # Check if the primitive is already in the inventory. If so, no actions needed.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    full_grid = current_state.features_dict()['features_global']\n    grid_height, grid_width, _ = full_grid.shape\n    start_y, start_x = current_state.pos\n    start_dir = current_state.dir # Use the agent's current direction from the reset state\n\n    # Define constants based on CraftLab.action_specs and CraftState.dir attributes\n    # Actions from CraftLab.action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Agent directions (matches CraftState.dir: 0=East, 1=South, 2=West, 3=North)\n    DIR_EAST = 0\n    DIR_SOUTH = 1\n    DIR_WEST = 2\n    DIR_NORTH = 3\n\n    # (dy, dx) for movement (relative to agent's current position)\n    # These map the action to the resulting positional change\n    MOVE_DELTAS = {\n        ACTION_UP:    (-1, 0),  # Moving UP (action 1) changes y by -1\n        ACTION_DOWN:  (1, 0),   # Moving DOWN (action 0) changes y by 1\n        ACTION_LEFT:  (0, -1),  # Moving LEFT (action 2) changes x by -1\n        ACTION_RIGHT: (0, 1),   # Moving RIGHT (action 3) changes x by 1\n    }\n\n    # Maps movement action to the direction the agent will face after that action.\n    # Agent faces the direction of its last movement.\n    ACTION_TO_FACING_DIR = {\n        ACTION_UP:    DIR_NORTH,  # Action UP (1) -> faces North (3)\n        ACTION_DOWN:  DIR_SOUTH,  # Action DOWN (0) -> faces South (1)\n        ACTION_LEFT:  DIR_WEST,   # Action LEFT (2) -> faces West (2)\n        ACTION_RIGHT: DIR_EAST,   # Action RIGHT (3) -> faces East (0)\n    }\n\n    # (dy, dx) offsets to get the coordinates of the cell directly in front of the agent,\n    # based on the agent's current facing direction.\n    FACING_OFFSETS = {\n        DIR_EAST:   (0, 1),\n        DIR_SOUTH:  (1, 0),\n        DIR_WEST:   (0, -1),\n        DIR_NORTH:  (-1, 0),\n    }\n\n    # Maximum number of actions allowed for collection, including movements and the final USE.\n    MAX_COLLECT_STEPS = 100 \n\n    def _get_facing_coords(y, x, direction):\n        \"\"\"Returns the coordinates of the cell directly in front of (y,x) based on direction.\"\"\"\n        dy, dx = FACING_OFFSETS.get(direction, (0, 0)) # Default to no change if direction is invalid\n        return y + dy, x + dx\n\n    # Determine truly impassable kinds for agent movement.\n    # Non-grabbable entities are usually impassable, but workshops are a notable exception.\n    impassable_for_movement_set = set()\n    world = current_state.world\n\n    # Water is typically impassable\n    if world.water_index in world.kinds:\n        impassable_for_movement_set.add(world.water_index)\n    \n    # Other non-grabbable items are impassable, UNLESS they are workshops\n    for k_idx in world.non_grabbable_indices:\n        if k_idx not in world.workshop_indices:\n            impassable_for_movement_set.add(k_idx)\n    \n    # Convert to list for efficient numpy indexing in `np.any` check\n    impassable_for_movement_list = list(impassable_for_movement_set)\n\n    q = collections.deque()\n    # BFS state: (current_y, current_x, current_direction, path_of_actions_so_far)\n    q.append((start_y, start_x, start_dir, []))\n    # Visited set tracks (position, direction) to avoid redundant exploration and loops.\n    visited = {(start_y, start_x, start_dir)} \n\n    path_to_use = None # Will store the sequence of actions including the final USE action\n\n    # --- BFS to find a path to a position and orientation suitable for collection ---\n    while q:\n        curr_y, curr_x, curr_dir, path = q.popleft()\n\n        # Optimization: Prune paths that are already too long before even exploring further.\n        # We reserve at least one step for the final ACTION_USE.\n        if len(path) >= MAX_COLLECT_STEPS - 1: \n            continue\n\n        # Check if the primitive is directly in front of the agent at current (y,x,dir)\n        facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n        # Ensure facing coordinates are within bounds\n        if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width):\n            # Check if the cell directly in front contains the primitive\n            if full_grid[facing_y, facing_x, primitive] > 0:\n                # We found a path to a position and orientation where ACTION_USE should work.\n                path_to_use = path + [ACTION_USE]\n                break # Path found, exit BFS\n\n        # Explore neighbors by applying movement actions\n        for action_move, (dy, dx) in MOVE_DELTAS.items():\n            next_y, next_x = curr_y + dy, curr_x + dx\n            next_dir = ACTION_TO_FACING_DIR[action_move] # New direction after this move\n\n            # Check bounds for the next agent position\n            if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                continue\n\n            # Check if the next cell is traversable (does not contain any impassable kind)\n            # Only check if impassable_for_movement_list is not empty to avoid numpy errors\n            if impassable_for_movement_list and np.any(full_grid[next_y, next_x, impassable_for_movement_list] > 0):\n                continue\n            \n            # Check if this (position, direction) state has been visited\n            if (next_y, next_x, next_dir) in visited:\n                continue\n\n            visited.add((next_y, next_x, next_dir))\n            q.append((next_y, next_x, next_dir, path + [action_move]))\n    \n    # --- Execute the found path (if any) ---\n    if path_to_use is None:\n        return [] # No path found to directly collect the primitive\n\n    # Execute actions step by step, respecting MAX_COLLECT_STEPS\n    for action in path_to_use:\n        if len(actions_taken) >= MAX_COLLECT_STEPS:\n            # Stop if the total number of actions taken reaches the limit.\n            break \n\n        actions_taken.append(action)\n        # Step the environment and update the internal state\n        # We don't use the reward or done status for the internal logic of this function,\n        # but the state update is essential.\n        _, done, _ = env.step(action) \n        current_state = env._current_state # Update state after the step\n\n        # If the episode ends prematurely (e.g., ran out of steps in CraftLab),\n        # and we haven't collected the primitive yet, then this path failed.\n        if done and current_state.inventory[primitive] <= 0:\n            return []\n\n        # If the primitive is now in the inventory, we have successfully collected it.\n        # This check should be *after* each step, especially the final ACTION_USE.\n        if current_state.inventory[primitive] > 0:\n            return actions_taken\n    \n    # If the loop completes without collecting the primitive (e.g., MAX_COLLECT_STEPS was hit\n    # exactly, or the final USE didn't work as expected), return an empty list unless\n    # the primitive was somehow collected in the last step.\n    if current_state.inventory[primitive] > 0:\n        return actions_taken\n    else:\n        return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:48:37.373257", "function_name": "collect", "function_body": "    # Action constants (re-defined locally to ensure they are available within the function)\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    # Mapping from delta (dr, dc) to action for movement\n    # (dr, dc) represents (row_change, col_change)\n    _DELTA_TO_ACTION = {\n        (-1, 0): _UP,    # Moving up means row decreases\n        (1, 0): _DOWN,   # Moving down means row increases\n        (0, -1): _LEFT,  # Moving left means col decreases\n        (0, 1): _RIGHT   # Moving right means col increases\n    }\n\n    def _find_path_and_target(\n        start_pos,\n        target_kind_idx,\n        grid,\n        non_walkable_indices\n    ):\n        \"\"\"\n        Performs a Breadth-First Search (BFS) to find a path from `start_pos`\n        to a cell that is adjacent to or contains the `target_kind_idx`.\n\n        Args:\n            start_pos (tuple): Agent's starting (row, col) position.\n            target_kind_idx (int): The index of the primitive item to find.\n            grid (numpy.ndarray): The current grid state (WIDTH, HEIGHT, n_kinds).\n            non_walkable_indices (set): Set of integer indices for entities\n                                        that cannot be walked upon.\n\n        Returns:\n            tuple: (list_of_actions_to_reach_adjacent_cell, actual_target_primitive_pos)\n                   or (None, None) if the primitive is not found or unreachable.\n        \"\"\"\n        rows, cols, _ = grid.shape\n        # Queue stores tuples of (current_position, list_of_actions_to_reach_current_position)\n        q = collections.deque([(start_pos, [])])\n        visited = {start_pos} # Set to keep track of visited positions\n\n        # Pre-scan grid to find all locations of the target primitive\n        all_target_locations = []\n        for r_grid in range(rows):\n            for c_grid in range(cols):\n                if grid[r_grid, c_grid, target_kind_idx] > 0:\n                    all_target_locations.append((r_grid, c_grid))\n\n        if not all_target_locations:\n            return None, None # Primitive not found anywhere on the grid\n\n        # Possible moves (N, S, E, W) in (dr, dc) format\n        deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n        \n        # BFS loop\n        while q:\n            (r, c), path_actions = q.popleft()\n\n            # Check if the current position (r,c) is suitable for collecting the primitive.\n            # This means it's either adjacent to a target primitive or it IS the target primitive.\n            for tr, tc in all_target_locations:\n                # If current position (r,c) is directly adjacent (Manhattan distance 1) to (tr,tc)\n                if abs(r - tr) + abs(c - tc) == 1:\n                    # Found a path to an adjacent cell, return it along with the primitive's location\n                    return path_actions, (tr, tc)\n                # If current position (r,c) is the target primitive's location itself\n                if (r, c) == (tr, tc) and grid[tr, tc, target_kind_idx] > 0:\n                    # Agent is on the target. No movement to an adjacent cell is needed.\n                    return path_actions, (tr, tc)\n\n            # Explore neighbors\n            for dr, dc in deltas:\n                nr, nc = r + dr, c + dc # Calculate new row and col\n\n                # Check if new position is within grid boundaries\n                if not (0 <= nr < rows and 0 <= nc < cols):\n                    continue\n\n                # Check if the new position is walkable\n                is_walkable = True\n                # Iterate through all kinds at (nr, nc) to see if any are non-walkable\n                for k_idx in non_walkable_indices:\n                    if grid[nr, nc, k_idx] > 0: # If a non-walkable item exists at this cell\n                        is_walkable = False\n                        break\n                if not is_walkable:\n                    continue\n\n                # If new position is walkable and not yet visited, add to queue\n                if (nr, nc) not in visited:\n                    visited.add((nr, nc))\n                    action_to_reach_next_pos = _DELTA_TO_ACTION[(dr, dc)]\n                    q.append(((nr, nc), path_actions + [action_to_reach_next_pos]))\n\n        return None, None # No path found to any primitive location\n\n    def _get_actions_to_face(current_pos, current_dir, target_object_pos):\n        \"\"\"\n        Determines the actions (LEFT/RIGHT turns) required to change the agent's\n        `current_dir` to face `target_object_pos`.\n        Assumes `current_pos` is adjacent to or the same as `target_object_pos`.\n\n        Args:\n            current_pos (tuple): Agent's current (row, col) position.\n            current_dir (int): Agent's current facing direction (0:N, 1:E, 2:S, 3:W).\n            target_object_pos (tuple): The (row, col) of the object to face.\n\n        Returns:\n            list: A list of `_LEFT` or `_RIGHT` actions.\n        \"\"\"\n        actions = []\n        \n        # Calculate relative position of the target object\n        dr, dc = target_object_pos[0] - current_pos[0], target_object_pos[1] - current_pos[1]\n\n        target_dir = -1 # Initialize target direction\n        if dr == -1 and dc == 0:  # Target is North of current_pos\n            target_dir = 0 # Agent should face North\n        elif dr == 1 and dc == 0: # Target is South of current_pos\n            target_dir = 2 # Agent should face South\n        elif dr == 0 and dc == -1: # Target is West of current_pos\n            target_dir = 3 # Agent should face West\n        elif dr == 0 and dc == 1:  # Target is East of current_pos\n            target_dir = 1 # Agent should face East\n        elif dr == 0 and dc == 0: # Agent is on the target object\n            # If agent is on the target, it can 'USE' in any cardinal direction.\n            # Arbitrarily choose to face North (direction 0) for consistency.\n            target_dir = 0 \n        else:\n            # This case should ideally not be reached if target_object_pos is truly\n            # adjacent to or the same as current_pos in a cardinal sense.\n            return [] \n\n        if target_dir == -1: # Should not happen if valid cardinal target found\n          return []\n\n        # Calculate the difference in direction modulo 4 to find the shortest turn\n        # 0:N, 1:E, 2:S, 3:W\n        # delta_dir = (target_dir - current_dir + 4) % 4\n        # 0: already facing\n        # 1: 90 deg clockwise (RIGHT)\n        # 2: 180 deg (RIGHT, RIGHT)\n        # 3: 90 deg counter-clockwise (LEFT)\n        delta_dir = (target_dir - current_dir + 4) % 4\n        if delta_dir == 1: \n            actions.append(_RIGHT)\n        elif delta_dir == 2: \n            actions.extend([_RIGHT, _RIGHT]) \n        elif delta_dir == 3: \n            actions.append(_LEFT)\n        # If delta_dir is 0, agent is already facing the correct direction, no actions needed.\n\n        return actions\n\n    # --- Main logic for collect_v2 ---\n\n    # Get the current CraftState instance from the environment\n    current_state = env._current_state \n    \n    # Early exit: If the primitive is already in the inventory, no actions are needed\n    if current_state.inventory[primitive] > 0:\n        return [] \n\n    # Extract relevant information from the current state and world configuration\n    grid = current_state.grid\n    start_pos = current_state.pos\n    start_dir = current_state.dir # Initial direction of the agent\n    world = current_state.world\n    cookbook = world.cookbook\n    \n    # Retrieve indices of non-walkable entities from the cookbook (e.g., water, walls)\n    non_walkable_indices = cookbook.environment\n    \n    # Use BFS to find the sequence of movement actions to reach a cell\n    # from which the primitive can be collected.\n    # `target_object_pos_on_grid` is the actual (row, col) of the primitive itself.\n    path_to_adjacent, target_object_pos_on_grid = _find_path_and_target(\n        start_pos, primitive, grid, non_walkable_indices\n    )\n\n    # If no path to the primitive was found (e.g., it's unreachable or doesn't exist)\n    if path_to_adjacent is None:\n        return [] \n\n    all_actions = [] # List to store the complete sequence of actions\n\n    # Simulate the agent's movement to determine its final position and direction\n    # after executing `path_to_adjacent`. This is crucial for correctly calculating\n    # the turning actions before using the primitive.\n    current_sim_pos = start_pos\n    current_sim_dir = start_dir # Movement actions (UP, DOWN, LEFT, RIGHT) do not change direction\n\n    for action in path_to_adjacent:\n        all_actions.append(action) # Add the movement action to the overall plan\n        \n        # Update the simulated position based on the executed movement action\n        dr, dc = 0, 0\n        if action == _UP:\n            dr = -1\n        elif action == _DOWN:\n            dr = 1\n        elif action == _LEFT:\n            dc = -1\n        elif action == _RIGHT:\n            dc = 1\n        current_sim_pos = (current_sim_pos[0] + dr, current_sim_pos[1] + dc)\n        # `current_sim_dir` remains unchanged by movement actions (0-3).\n\n    # After moving to the cell adjacent to the primitive, determine the actions\n    # required to turn the agent to face the primitive.\n    facing_actions = _get_actions_to_face(current_sim_pos, current_sim_dir, target_object_pos_on_grid)\n    all_actions.extend(facing_actions) # Add the turning actions to the plan\n\n    # Finally, add the _USE action to collect the primitive.\n    all_actions.append(_USE)\n    \n    return all_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:48:37.453173", "function_name": "collect", "function_body": "    action_map = env.action_specs()\n    # Define movement actions (change in column, change in row)\n    # and their corresponding integer values from action_map.\n    actions_info = {\n        \"DOWN\": (0, 1, action_map[\"DOWN\"]),\n        \"UP\": (0, -1, action_map[\"UP\"]),\n        \"LEFT\": (-1, 0, action_map[\"LEFT\"]),\n        \"RIGHT\": (1, 0, action_map[\"RIGHT\"]),\n    }\n\n    current_obs = env.observations()\n    grid = current_obs[\"features_dict\"][\"features_global\"]\n    # Agent's position is normalized in 'pos' (x_norm, y_norm),\n    # convert to integer grid coordinates (col, row).\n    agent_pos_norm = current_obs[\"features_dict\"][\"pos\"]\n    inventory = current_obs[\"features_dict\"][\"inventory\"]\n\n    # Check if the primitive is already in the inventory\n    if inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions: grid shape is (WIDTH, HEIGHT, n_kinds), representing (cols, rows, kinds)\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # Convert normalized agent position (x_norm, y_norm) to integer (col, row)\n    agent_col = int(round(agent_pos_norm[0] * (WIDTH - 1)))\n    agent_row = int(round(agent_pos_norm[1] * (HEIGHT - 1)))\n\n    world = env.world\n    # Indices of entities that cannot be walked through\n    obstacle_kinds = world.non_grabbable_indices\n\n    # Find all cells containing the primitive item. Store as (col, row).\n    primitive_locations = []\n    for r_idx in range(HEIGHT):\n        for c_idx in range(WIDTH):\n            # Grid is indexed as [column, row, kind]\n            if grid[c_idx, r_idx, primitive] == 1:\n                primitive_locations.append((c_idx, r_idx))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the grid\n\n    # BFS for pathfinding to an adjacent cell of the primitive\n    # Using collections.deque (assuming it's imported at a higher level or implicitly available)\n    from collections import deque\n    q = deque([(agent_col, agent_row, [])])  # State: (current_col, current_row, list_of_actions_taken)\n    visited = set([(agent_col, agent_row)])\n\n    shortest_path_to_adj = None\n\n    while q:\n        c, r, path_actions = q.popleft()\n\n        # Check if the current position (c, r) is adjacent to any primitive location\n        for pc, pr in primitive_locations:  # Primitive location (col, row)\n            # Check 4-directional adjacency: (abs(col_diff) == 1 and row_same) or (abs(row_diff) == 1 and col_same)\n            if (abs(c - pc) == 1 and r == pr) or \\\n               (abs(r - pr) == 1 and c == pc):\n                shortest_path_to_adj = path_actions\n                # BFS guarantees the shortest path, so we can break once found\n                break\n        if shortest_path_to_adj is not None:\n            break\n\n        # Explore neighbors\n        for action_name, (dc, dr, action_val) in actions_info.items():\n            nc, nr = c + dc, r + dr\n\n            # Check bounds and if already visited\n            if 0 <= nc < WIDTH and 0 <= nr < HEIGHT and (nc, nr) not in visited:\n                # Check if the next cell is walkable (not an obstacle)\n                is_walkable = True\n                for k in obstacle_kinds:\n                    if grid[nc, nr, k] == 1: # Check grid at (new_col, new_row, kind)\n                        is_walkable = False\n                        break\n                \n                if is_walkable:\n                    visited.add((nc, nr))\n                    q.append((nc, nr, path_actions + [action_val]))\n\n    if shortest_path_to_adj is None:\n        return [] # No path found to any cell adjacent to the primitive\n\n    # Once at a cell adjacent to the primitive, perform the USE action.\n    # The `CraftState.next_to` method checks a 3x3 neighborhood, implying\n    # the 'USE' action works when the item is simply in proximity,\n    # regardless of agent's facing direction.\n    return shortest_path_to_adj + [action_map[\"USE\"]]", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:50:14.753235", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:50:14.822492", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # 1. Get initial state and constants\n    initial_obs = env.observations()\n    \n    # Check if primitive is already collected in the inventory\n    inventory = initial_obs['features_dict']['inventory']\n    if inventory[primitive] > 0:\n        return []\n\n    # Get action mappings from the environment\n    action_map = env.action_specs()\n    A_DOWN = action_map['DOWN']\n    A_UP = action_map['UP']\n    A_LEFT = action_map['LEFT']\n    A_RIGHT = action_map['RIGHT']\n    A_USE = action_map['USE']\n\n    # Retrieve the global grid and its dimensions\n    grid = initial_obs['features_dict']['features_global']\n    # According to CraftState: grid is (WIDTH, HEIGHT, n_kinds)\n    GRID_WIDTH, GRID_HEIGHT, N_KINDS = grid.shape\n\n    # Convert the normalized agent position (row_norm, col_norm) to grid (x, y) coordinates\n    # For a grid indexed as grid[x, y, kind], x corresponds to column, y to row.\n    # The 'pos' in features_dict is (normalized_row, normalized_col).\n    current_pos_norm = initial_obs['features_dict']['pos']\n    start_grid_y = int(round(current_pos_norm[0] * (GRID_HEIGHT - 1))) # normalized row -> grid y (height)\n    start_grid_x = int(round(current_pos_norm[1] * (GRID_WIDTH - 1)))  # normalized col -> grid x (width)\n    start_pos_grid = (start_grid_x, start_grid_y) # Agent's starting position (x, y) on the grid\n\n    # Get non-grabbable indices from the world for traversability checks\n    # CraftLab's 'world' attribute holds the CraftWorld instance.\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # Define possible moves as (dx, dy) changes in grid coordinates (x, y)\n    # and their corresponding actions.\n    MOVES = {\n        (0, -1): A_UP,    # (dx=0, dy=-1) means move up (decrease y)\n        (0, 1): A_DOWN,   # (dx=0, dy=1) means move down (increase y)\n        (-1, 0): A_LEFT,  # (dx=-1, dy=0) means move left (decrease x)\n        (1, 0): A_RIGHT   # (dx=1, dy=0) means move right (increase x)\n    }\n\n    # BFS Initialization\n    # Queue stores tuples: ((current_x, current_y), list_of_actions_to_reach_here)\n    q = collections.deque([(start_pos_grid, [])])\n    # Visited set stores (x, y) coordinates to avoid cycles and redundant paths\n    visited = {start_pos_grid}\n\n    while q:\n        (x, y), path = q.popleft()\n\n        # Check immediate adjacent cells for the primitive to be collected\n        # The agent needs to be adjacent to the primitive to USE it.\n        for (dx, dy), _ in MOVES.items():\n            nx, ny = x + dx, y + dy # Candidate position for the primitive\n\n            # Boundary check for the primitive's location\n            if not (0 <= nx < GRID_WIDTH and 0 <= ny < GRID_HEIGHT):\n                continue\n\n            # If the adjacent cell contains the primitive we're looking for\n            if grid[nx, ny, primitive] == 1:\n                # Path found! The agent moves to (x, y), then performs the USE action.\n                return path + [A_USE]\n        \n        # If the primitive is not immediately adjacent, explore possible movement steps\n        for (dx, dy), action in MOVES.items():\n            nx, ny = x + dx, y + dy # New agent position after taking 'action'\n\n            # Boundary check for the new agent position\n            if not (0 <= nx < GRID_WIDTH and 0 <= ny < GRID_HEIGHT):\n                continue\n\n            # Skip if this position has already been visited\n            if (nx, ny) in visited:\n                continue\n\n            # Determine if the cell (nx, ny) is an obstacle for movement\n            # A cell is an obstacle if it contains any non-grabbable item\n            # or if it contains the primitive itself (as we want to land *next* to it, not on it).\n            is_obstacle = False\n            for k_idx in non_grabbable_indices:\n                if grid[nx, ny, k_idx] == 1:\n                    is_obstacle = True\n                    break\n            \n            # If the cell contains the primitive itself, treat it as an obstacle for pathing through\n            if grid[nx, ny, primitive] == 1:\n                is_obstacle = True \n\n            # If the cell is not an obstacle, add it to the queue for further exploration\n            if not is_obstacle:\n                visited.add((nx, ny))\n                q.append(((nx, ny), path + [action]))\n\n    # If the queue is exhausted and no path to the primitive was found\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:51:26.391152", "function_name": "collect", "function_body": "  import collections\n\n  # Constants\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  action_to_direction = {\n      UP_ACTION: NORTH_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  action_to_move_delta = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"\n    Calculates the direction the agent needs to face to look at the item.\n    Assumes item is directly adjacent (cardinally) to the agent.\n    \"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dx == 0 and dy == 1: return SOUTH_DIR\n    if dx == 0 and dy == -1: return NORTH_DIR\n    return None # Item is not cardinally adjacent, or agent is on item\n\n  # Get target item's integer ID\n  target_id = env.world.cookbook.index[primitive]\n\n  # Determine if the target is a primitive resource or a workshop\n  is_primitive_resource = target_id in env.world.cookbook.primitives\n  is_workshop = target_id in env.world.workshop_indices\n\n  # If the goal is to collect a primitive resource and we already have it\n  current_state = env._current_state\n  if is_primitive_resource and current_state.inventory[target_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  def is_walkable(x, y, current_grid):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-grabbable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item is present at (y, x)\n    for kind_idx in non_grabbable_kinds:\n      if current_grid[y, x, kind_idx] > 0:\n        return False\n    return True\n\n  # 1. Find all locations of the target item on the grid\n  item_y_coords, item_x_coords = np.where(grid[:, :, target_id] == 1)\n\n  if len(item_x_coords) == 0:\n    return [] # Target item not found on the grid\n\n  # 2. Identify all target interaction points for BFS goal states.\n  # A target interaction point is (adjacent_x, adjacent_y, required_facing_direction_to_item).\n  target_interaction_points = set()\n  for i in range(len(item_x_coords)):\n    item_x, item_y = item_x_coords[i], item_y_coords[i]\n    # Check all 4 cardinal neighbors of the item\n    for action_val, (dx, dy) in action_to_move_delta.items():\n      adj_x, adj_y = item_x + dx, item_y + dy\n      if is_walkable(adj_x, adj_y, grid):\n        # Determine the direction the agent needs to face to use the item from this adjacent cell\n        required_facing_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_facing_dir is not None:\n          target_interaction_points.add((adj_x, adj_y, required_facing_dir))\n\n  if not target_interaction_points:\n    return [] # No reachable adjacent cells to any target item\n\n  # 3. Initialize BFS queue: (current_x, current_y, current_direction)\n  # We no longer store the path in the queue, but reconstruct it.\n  queue = collections.deque([(start_pos_x, start_pos_y, start_dir)])\n\n  # 4. Initialize `came_from` dictionary to reconstruct path\n  # Key: (x, y, dir), Value: (prev_x, prev_y, prev_dir, action_taken_to_reach_this_state)\n  came_from = {(start_pos_x, start_pos_y, start_dir): None} # Start node has no predecessor\n\n  # To store the found goal state for path reconstruction\n  found_goal_state = None\n\n  # 5. Run BFS\n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n    current_state_tuple = (curr_x, curr_y, curr_dir)\n\n    # Check if the current state is a goal state\n    if current_state_tuple in target_interaction_points:\n      found_goal_state = current_state_tuple\n      break # Found the shortest path, stop BFS\n\n    # --- Expand possible next states ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for move_action, (dx, dy) in action_to_move_delta.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      # After a movement action, the agent's direction automatically aligns with the movement.\n      next_dir_after_move = action_to_direction[move_action]\n      next_state_tuple = (next_x, next_y, next_dir_after_move)\n\n      if is_walkable(next_x, next_y, grid) and next_state_tuple not in came_from:\n        came_from[next_state_tuple] = (curr_x, curr_y, curr_dir, move_action)\n        queue.append(next_state_tuple)\n\n    # B. Turning Actions (LEFT, RIGHT)\n    # These actions change direction but not position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n\n      next_state_tuple = (curr_x, curr_y, next_dir) # Position remains the same\n\n      if next_state_tuple not in came_from:\n        came_from[next_state_tuple] = (curr_x, curr_y, curr_dir, turn_action)\n        queue.append(next_state_tuple)\n\n  # 6. Reconstruct the path if a goal state was found\n  if found_goal_state is None:\n    return [] # No path found\n\n  actions = []\n  current_path_state = found_goal_state\n  while came_from[current_path_state] is not None:\n    # Predecessor info: (prev_x, prev_y, prev_dir, action_to_reach_current_state)\n    prev_state_info = came_from[current_path_state]\n    action_to_get_here = prev_state_info[3] # The action that led to current_path_state\n    actions.append(action_to_get_here)\n    # Move to the previous state in the path\n    current_path_state = (prev_state_info[0], prev_state_info[1], prev_state_info[2])\n\n  actions.reverse() # Path was built in reverse, so reverse it\n\n  # Add the final USE action if it's a primitive resource\n  if is_primitive_resource:\n    actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:51:27.361767", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Mapping from movement action to the direction the agent would face after taking it\n  action_to_direction = {\n      UP_ACTION: NORTH_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  # Mapping from movement action to (dx, dy) delta\n  action_to_move_delta = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"\n    Calculates the direction the agent needs to face to look at the item.\n    Assumes item is directly adjacent (cardinally) to the agent.\n    \"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dx == 0 and dy == 1: return SOUTH_DIR\n    if dx == 0 and dy == -1: return NORTH_DIR\n    return None # Item is not cardinally adjacent, or agent is on item\n\n  # Get target item's integer ID\n  target_id = env.world.cookbook.index[primitive]\n\n  # As per the function's name \"collect\", it is intended for primitive resources.\n  # Check if the primitive is already in the agent's inventory.\n  current_state = env._current_state\n  if current_state.inventory[target_id] > 0:\n    return [] # Already collected, no actions needed.\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Non-grabbable items define obstacles in the environment.\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  def is_walkable(x, y, current_grid):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-grabbable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item is present at (y, x)\n    for kind_idx in non_grabbable_kinds:\n      if current_grid[y, x, kind_idx] > 0:\n        return False\n    return True\n\n  # 1. Find all locations of the target primitive on the grid\n  # np.where returns (row_indices, col_indices) which correspond to (y_coords, x_coords)\n  item_y_coords, item_x_coords = np.where(grid[:, :, target_id] == 1)\n\n  if len(item_x_coords) == 0:\n    return [] # Target primitive not found on the grid\n\n  # 2. Identify all target interaction points for BFS goal states.\n  # An interaction point is (adjacent_x, adjacent_y, required_facing_direction_to_item).\n  # To 'collect' a primitive, the agent must be adjacent to it and facing it to use the USE_ACTION.\n  target_interaction_points = set()\n  for i in range(len(item_x_coords)):\n    item_x, item_y = item_x_coords[i], item_y_coords[i]\n    # Check all 4 cardinal neighbors of the item\n    for action_val, (dx, dy) in action_to_move_delta.items():\n      adj_x, adj_y = item_x + dx, item_y + dy\n      if is_walkable(adj_x, adj_y, grid):\n        # Determine the direction the agent needs to face to use the item from this adjacent cell\n        required_facing_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_facing_dir is not None:\n          target_interaction_points.add((adj_x, adj_y, required_facing_dir))\n\n  if not target_interaction_points:\n    return [] # No reachable adjacent cells to any target primitive\n\n  # 3. Initialize BFS queue: (current_x, current_y, current_direction, path_actions_list)\n  queue = collections.deque([(start_pos_x, start_pos_y, start_dir, [])])\n  # 4. Initialize visited set to avoid cycles and redundant paths: (x, y, direction)\n  visited = {(start_pos_x, start_pos_y, start_dir)}\n\n  # 5. Run BFS to find the shortest path to an interaction point\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the current state is a goal state (agent is at an interaction point)\n    if (curr_x, curr_y, curr_dir) in target_interaction_points:\n      # Once at the correct position and facing, use the item to collect it.\n      return path_actions + [USE_ACTION]\n\n    # --- Expand possible next states from the current state ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for move_action, (dx, dy) in action_to_move_delta.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      # After a movement action, the agent's direction automatically aligns with the movement.\n      next_dir_after_move = action_to_direction[move_action]\n\n      if is_walkable(next_x, next_y, grid) and\\\n         (next_x, next_y, next_dir_after_move) not in visited:\n        visited.add((next_x, next_y, next_dir_after_move))\n        queue.append((next_x, next_y, next_dir_after_move, path_actions + [move_action]))\n\n    # B. Turning Actions (LEFT, RIGHT)\n    # These actions change direction but not position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n\n      # Position remains the same\n      if (curr_x, curr_y, next_dir) not in visited:\n        visited.add((curr_x, curr_y, next_dir))\n        queue.append((curr_x, curr_y, next_dir, path_actions + [turn_action]))\n\n  # If the queue becomes empty and no path to the target was found\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:52:30.881899", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Define action constants as per CraftLab.action_specs()\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    state = env._current_state\n    \n    # Check if the primitive is already in the agent's inventory\n    if state.inventory[primitive] > 0:\n        return []\n\n    grid = state.grid\n    # The grid shape is (WIDTH, HEIGHT, n_kinds) based on CraftScenario.\n    # pos is (x, y).\n    grid_width = grid.shape[0]\n    grid_height = grid.shape[1]\n\n    # BFS for pathfinding\n    # Queue stores tuples: (current_x, current_y, list_of_actions_taken_to_reach_here)\n    queue = collections.deque([(state.pos[0], state.pos[1], [])])\n    \n    # Visited set stores (x, y) coordinates to avoid cycles and redundant explorations\n    visited = set([(state.pos[0], state.pos[1])])\n\n    # Mapping movement actions to (dx, dy) deltas\n    # dx corresponds to change in x (width), dy to change in y (height)\n    ACTION_TO_DELTAS = {\n        ACTION_UP:    (0, -1),  # Decreases y-coordinate\n        ACTION_DOWN:  (0, 1),   # Increases y-coordinate\n        ACTION_LEFT:  (-1, 0),  # Decreases x-coordinate\n        ACTION_RIGHT: (1, 0)    # Increases x-coordinate\n    }\n\n    while queue:\n        curr_x, curr_y, path = queue.popleft()\n\n        # Check if the primitive can be 'USE'd from the current position (curr_x, curr_y)\n        # This means checking the 3x3 neighborhood around (curr_x, curr_y) for the primitive.\n        # This logic replicates CraftState.next_to(primitive).\n        can_use = False\n        for dx_neigh in [-1, 0, 1]:\n            for dy_neigh in [-1, 0, 1]:\n                check_x, check_y = curr_x + dx_neigh, curr_y + dy_neigh\n                \n                # Ensure the neighbor cell is within grid bounds\n                if 0 <= check_x < grid_width and 0 <= check_y < grid_height:\n                    # If the primitive is found in the neighborhood\n                    if grid[check_x, check_y, primitive] == 1:\n                        can_use = True\n                        break # Found a primitive, no need to check other neighbors\n            if can_use:\n                break # No need to check other rows of neighbors\n\n        if can_use:\n            # Found a path to a position from which the primitive can be collected.\n            # Append the USE action to the path and return.\n            return path + [ACTION_USE]\n\n        # If not collectable from current position, explore neighboring cells\n        for action, (dx, dy) in ACTION_TO_DELTAS.items():\n            new_x, new_y = curr_x + dx, curr_y + dy\n\n            # Check if the new position is within grid bounds\n            if 0 <= new_x < grid_width and 0 <= new_y < grid_height:\n                # Check if this position has not been visited before in this path\n                if (new_x, new_y) not in visited:\n                    visited.add((new_x, new_y))\n                    queue.append((new_x, new_y, path + [action]))\n\n    # If the BFS completes and no path to the primitive was found (e.g., primitive is unreachable)\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:52:31.855652", "function_name": "collect", "function_body": "", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:54:05.117194", "function_name": "collect", "function_body": "    _actions_map = env.action_specs()\n    _MOVE_BACKWARD = _actions_map['DOWN'] # DMLab standard: moves backward relative to current direction\n    _MOVE_FORWARD = _actions_map['UP']    # DMLab standard: moves forward relative to current direction\n    _TURN_LEFT = _actions_map['LEFT']     # DMLab standard: turns 90 degrees left\n    _TURN_RIGHT = _actions_map['RIGHT']   # DMLab standard: turns 90 degrees right\n    _USE = _actions_map['USE']            # Assumed to interact with the current cell for grabbable items\n\n    # Direction mappings for DMLab-style 0-indexed directions:\n    # 0: North (Up on grid), 1: East (Right on grid), 2: South (Down on grid), 3: West (Left on grid)\n    DIR_DX = [0, 1, 0, -1] # Change in X for moving forward in each direction\n    DIR_DY = [-1, 0, 1, 0] # Change in Y for moving forward in each direction\n\n    actions_to_take = []\n\n    # Get current state information from the environment's observations\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    \n    current_grid = features_dict['features_global'] # Full allocentric grid\n    \n    # Get grid dimensions from the scenario (N_KINDS is not strictly needed for pathfinding)\n    WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n    # Denormalize current agent position\n    current_pos_normalized = features_dict['pos']\n    current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n    current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n    current_pos = (current_px, current_py)\n\n    # Get current agent direction from the one-hot encoding (e.g., [1,0,0,0] -> 0 for North)\n    current_dir = np.argmax(features_dict['direction']) # 0=N, 1=E, 2=S, 3=W\n\n    # Check if the primitive is grabbable. If not, it cannot be collected.\n    if primitive not in env.world.grabbable_indices:\n        return []\n\n    # Find all locations where the primitive exists on the grid\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if current_grid[x, y, primitive] == 1: # Assuming 1 for presence\n                primitive_locations.append((x, y))\n\n    # If no primitive is found on the grid, return an empty list of actions\n    if not primitive_locations:\n        return []\n\n    # Define impassable terrain for movement.\n    # `water_index` is typically an impassable obstacle. `stone_index` might be or might not.\n    # We'll use the definition from collect_v1 which only explicitly includes water.\n    impassable_movement_terrain_indices = {env.world.water_index}\n\n    def is_obstacle(x, y, grid, impassable_kinds_set):\n        \"\"\"\n        Checks if the cell (x,y) contains any truly impassable item for movement.\n        This version distinguishes between non-grabbable items and actual movement obstacles.\n        \"\"\"\n        # Ensure coordinates are within bounds before checking grid contents\n        if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n            return True # Out of bounds is an obstacle\n\n        for k_idx in impassable_kinds_set:\n            if grid[x, y, k_idx] == 1:\n                return True\n        return False\n\n    # Use Breadth-First Search (BFS) to find the shortest path to any primitive location.\n    # The BFS state must now include the agent's current direction.\n    # Queue stores tuples: ((current_x, current_y), current_direction, [path_actions_to_reach_here])\n    q = collections.deque()\n    q.append((current_pos, current_dir, [])) \n    \n    # Set to store visited states to avoid cycles and re-processing longer paths.\n    # A state is defined by (x, y, direction).\n    visited = {(current_pos[0], current_pos[1], current_dir)} \n\n    target_found_path = None\n\n    while q:\n        (cx, cy), cdir, current_path = q.popleft()\n\n        # If the current position contains the primitive, we found a path.\n        # Since it's BFS, this is guaranteed to be the shortest path to *a* primitive.\n        # We assume `_USE` collects the primitive from the current cell the agent is on.\n        if current_grid[cx, cy, primitive] == 1:\n            target_found_path = current_path + [_USE]\n            break # Exit BFS as the shortest path is found\n\n        # Explore neighbors by applying possible actions (movements and turns)\n        \n        # 1. Try moving forward (_MOVE_FORWARD)\n        nx_f, ny_f = cx + DIR_DX[cdir], cy + DIR_DY[cdir]\n        # Check boundaries, if not an obstacle, and if not visited\n        if (0 <= nx_f < WIDTH and 0 <= ny_f < HEIGHT) and \\\n           not is_obstacle(nx_f, ny_f, current_grid, impassable_movement_terrain_indices) and \\\n           (nx_f, ny_f, cdir) not in visited:\n            q.append(((nx_f, ny_f), cdir, current_path + [_MOVE_FORWARD]))\n            visited.add((nx_f, ny_f, cdir))\n\n        # 2. Try moving backward (_MOVE_BACKWARD)\n        nx_b, ny_b = cx - DIR_DX[cdir], cy - DIR_DY[cdir]\n        if (0 <= nx_b < WIDTH and 0 <= ny_b < HEIGHT) and \\\n           not is_obstacle(nx_b, ny_b, current_grid, impassable_movement_terrain_indices) and \\\n           (nx_b, ny_b, cdir) not in visited:\n            q.append(((nx_b, ny_b), cdir, current_path + [_MOVE_BACKWARD]))\n            visited.add((nx_b, ny_b, cdir))\n\n        # 3. Try turning left (_TURN_LEFT)\n        ndir_l = (cdir - 1 + 4) % 4 # New direction, wraps around (0-3)\n        # Position does not change when turning, only direction.\n        if (cx, cy, ndir_l) not in visited:\n            q.append(((cx, cy), ndir_l, current_path + [_TURN_LEFT]))\n            visited.add((cx, cy, ndir_l))\n\n        # 4. Try turning right (_TURN_RIGHT)\n        ndir_r = (cdir + 1) % 4 # New direction, wraps around (0-3)\n        # Position does not change when turning, only direction.\n        if (cx, cy, ndir_r) not in visited:\n            q.append(((cx, cy), ndir_r, current_path + [_TURN_RIGHT]))\n            visited.add((cx, cy, ndir_r))", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:54:06.114880", "function_name": "collect", "function_body": "  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Constants for internal direction mapping (consistent with common Craft env patterns)\n  _DIR_UP = 0\n  _DIR_RIGHT = 1\n  _DIR_DOWN = 2\n  _DIR_LEFT = 3\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions\n  WIDTH, HEIGHT, _ = current_grid.shape # N_KINDS is not directly needed for dimensions\n\n  # Denormalize current agent position from normalized [0,1] range to grid coordinates\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Get current agent direction from the underlying CraftState\n  initial_dir = env._current_state.dir \n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Mapping from internal direction constants to (dx, dy) deltas\n  DIR_TO_DELTA = {\n      _DIR_UP:    (0, -1),\n      _DIR_RIGHT: (1, 0),\n      _DIR_DOWN:  (0, 1),\n      _DIR_LEFT:  (-1, 0)\n  }\n  \n  # Mapping from action ID to (delta_x, delta_y) for movement and the resulting new direction\n  # This assumes movement actions also set the agent's facing direction.\n  ACTION_MOVE_DATA = {\n      _UP:    ((0, -1), _DIR_UP),\n      _DOWN:  ((0, 1),  _DIR_DOWN),\n      _LEFT:  ((-1, 0), _DIR_LEFT),\n      _RIGHT: ((1, 0),  _DIR_RIGHT)\n  }\n\n  # Define indices for terrain that cannot be moved through\n  impassable_movement_terrain_indices = {env.world.water_index} \n  # Add other impassable items if necessary (e.g., env.world.stone_index if it acts as a wall)\n\n  def is_obstacle(x, y, grid, impassable_kinds_set, width, height):\n    \"\"\"\n    Checks if the cell (x,y) is out of bounds or contains any truly impassable item for movement.\n    \"\"\"\n    if not (0 <= x < width and 0 <= y < height):\n      return True # Out of bounds is considered an obstacle for movement\n    for k in impassable_kinds_set:\n      if grid[x, y, k] == 1: \n        return True\n    return False\n\n  # Initialize BFS Queue: (current_x, current_y, current_direction, [path_actions_to_reach_here])\n  q = collections.deque()\n  q.append((current_pos[0], current_pos[1], initial_dir, [])) \n  \n  # Set to store visited states to avoid cycles and redundant paths: {(x, y, direction)}\n  visited = {(current_pos[0], current_pos[1], initial_dir)} \n\n  target_found_path = None\n\n  while q:\n    cx, cy, c_dir, current_path = q.popleft()\n\n    # --- Goal Check: Is the cell *in front* of the agent the primitive? ---\n    # Calculate the coordinates of the cell directly in front of the agent based on current direction\n    fdx, fdy = DIR_TO_DELTA[c_dir]\n    fx, fy = cx + fdx, cy + fdy\n\n    # Check if this front cell is within bounds and contains the primitive\n    # We combine bounds check here for convenience, as an out-of-bounds `fx, fy` cannot contain the primitive.\n    if (0 <= fx < WIDTH and 0 <= fy < HEIGHT) and current_grid[fx, fy, primitive] == 1:\n      # Found a valid position and facing direction from which to 'USE' on the primitive\n      target_found_path = current_path + [_USE]\n      break # Exit BFS as the shortest path has been found\n\n    # Explore all possible movement actions from the current state\n    for action, ((dx, dy), new_dir) in ACTION_MOVE_DATA.items():\n      nx, ny = cx + dx, cy + dy # Calculate the new position after this action\n\n      # Check if the next cell is an obstacle or out of overall grid bounds for movement\n      if is_obstacle(nx, ny, current_grid, impassable_movement_terrain_indices, WIDTH, HEIGHT):\n        continue\n\n      # If this specific (position, direction) state has not been visited before\n      if (nx, ny, new_dir) not in visited:\n        new_path = current_path + [action] # Append the action to the path\n        q.append((nx, ny, new_dir, new_path)) # Add the new state to the queue\n        visited.add((nx, ny, new_dir)) # Mark this state as visited\n  \n  # Return the found path or an empty list if no path was found (primitive unreachable)\n  if target_found_path is not None:\n    return target_found_path\n  else:\n    return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:55:50.645886", "function_name": "collect", "function_body": "    import collections\n\n    actions_list = []\n\n    # Get initial state and relevant world information\n    # We access `_current_state` for simplicity as this is a completion within the same context.\n    # In a real API, `env.observations()` and parsing `features_dict` would be more standard.\n    current_state = env._current_state\n    world = env.world\n    grid = current_state.grid\n    pos = current_state.pos\n    inventory = current_state.inventory\n    \n    # Define action constants using env_factory.Actions\n    # Assuming env_factory.Actions is an enum-like class where attributes hold integer values.\n    MOVE_UP = env_factory.Actions.UP\n    MOVE_DOWN = env_factory.Actions.DOWN\n    MOVE_LEFT = env_factory.Actions.LEFT\n    MOVE_RIGHT = env_factory.Actions.RIGHT\n    ACTION_USE = env_factory.Actions.USE\n\n    # 1. Check if the primitive is already in inventory\n    if inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # Get grid dimensions\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # Define blocking elements (e.g., water, stone) which the agent cannot move through.\n    # These are usually indicated by specific indices in the CraftWorld.\n    blocking_indices = set()\n    if hasattr(world, 'water_index'):\n        blocking_indices.add(world.water_index)\n    if hasattr(world, 'stone_index'):\n        blocking_indices.add(world.stone_index)\n    \n    # 2. Locate all instances of the primitive on the grid\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] == 1:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        # Primitive not found in the current environment\n        return []\n\n    # 3. Determine target adjacent cells\n    # These are cells from which the agent can successfully use the 'USE' action\n    # to collect the primitive (i.e., cells directly next to a primitive).\n    target_adj_cells = set()\n    for px, py in primitive_locations:\n        # Consider 4 direct neighbors (up, down, left, right)\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            tx, ty = px + dx, py + dy\n            # Ensure the target adjacent cell is within grid boundaries\n            if 0 <= tx < WIDTH and 0 <= ty < HEIGHT:\n                target_adj_cells.add((tx, ty))\n\n    # 4. Perform Breadth-First Search (BFS) to find the shortest path\n    #    from the agent's current position to any `target_adj_cell`.\n    # Queue stores tuples: (current_x, current_y, list_of_actions_to_reach_here)\n    queue = collections.deque([(pos[0], pos[1], [])])\n    \n    # Set to keep track of visited cells to avoid cycles and redundant paths\n    visited = set([(pos[0], pos[1])])\n\n    # Mapping of action values to their (dx, dy) effects for movement\n    move_actions_map = {\n        MOVE_UP: (0, -1),\n        MOVE_DOWN: (0, 1),\n        MOVE_LEFT: (-1, 0),\n        MOVE_RIGHT: (1, 0)\n    }\n\n    while queue:\n        x, y, current_path = queue.popleft()\n\n        # If the current cell is one of the target adjacent cells, we found a path.\n        if (x, y) in target_adj_cells:\n            # Append the 'USE' action to collect the primitive and return the full action sequence.\n            return current_path + [ACTION_USE]\n\n        # Explore possible moves to neighboring cells\n        for action, (dx, dy) in move_actions_map.items():\n            new_x, new_y = x + dx, y + dy\n\n            # Check if the new coordinates are within grid boundaries\n            if not (0 <= new_x < WIDTH and 0 <= new_y < HEIGHT):\n                continue\n\n            # Check if the new cell is blocked by an obstacle (e.g., water, stone)\n            is_blocked = False\n            for blocking_idx in blocking_indices:\n                if grid[new_x, new_y, blocking_idx] == 1:\n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue\n\n            # If the cell is valid and not visited, add it to the queue\n            if (new_x, new_y) not in visited:\n                visited.add((new_x, new_y))\n                queue.append((new_x, new_y, current_path + [action]))\n    \n    # If the BFS queue is exhausted and no path to a primitive was found\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:55:51.641019", "function_name": "collect", "function_body": "  # Action constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map action to relative (dr, dc) movement\n  ACTION_DELTAS = {\n      UP: (-1, 0),    # Moves North\n      DOWN: (1, 0),   # Moves South\n      LEFT: (0, -1),  # Moves West\n      RIGHT: (0, 1),  # Moves East\n  }\n\n  # Map action to resulting facing direction (0=N, 1=E, 2=S, 3=W)\n  # Assumption: A movement action also sets the agent's facing direction to that cardinal direction.\n  ACTION_TO_FACING_DIR = {\n      UP: 0,      # Facing North\n      RIGHT: 1,   # Facing East\n      DOWN: 2,    # Facing South\n      LEFT: 3,    # Facing West\n  }\n\n  # Map (dr, dc) delta from agent's current pos to target pos, to the direction index the agent needs to face\n  DELTA_TO_FACING_DIR = {\n      (-1, 0): 0, # To a target North, face North\n      (0, 1): 1,  # To a target East, face East\n      (1, 0): 2,  # To a target South, face South\n      (0, -1): 3, # To a target West, face West\n  }\n\n  def _get_current_dir(one_hot_direction_array):\n      \"\"\"Converts a one-hot direction array to an integer direction (0-3).\"\"\"\n      return np.argmax(one_hot_direction_array)\n\n  def _is_obstacle(pos, grid, non_grabbable_indices, height, width):\n      \"\"\"Checks if a given grid position is an obstacle (out of bounds or non-grabbable).\"\"\"\n      r, c = pos\n      # Check if out of bounds\n      if not (0 <= r < height and 0 <= c < width):\n          return True\n      \n      # Check if any non-grabbable item is present at this cell\n      for idx in non_grabbable_indices:\n          if grid[r, c, idx] > 0:\n              return True\n      return False\n  \n  # Get initial observations to determine current state\n  obs = env.observations()\n  \n  # 1. Check if the primitive is already in inventory\n  if obs['features_dict']['inventory'][primitive] > 0:\n      return [] # Already collected, no actions needed\n\n  initial_pos = tuple(obs['features_dict']['pos'])\n  initial_dir = _get_current_dir(obs['features_dict']['direction'])\n  grid = obs['features_dict']['features_global']\n  \n  height, width, _ = grid.shape\n  # `non_grabbable_indices` are entities that cannot be picked up and block movement.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # 2. Find all locations where the primitive exists on the grid\n  primitive_locations = []\n  for r_idx in range(height):\n      for c_idx in range(width):\n          if grid[r_idx, c_idx, primitive] > 0:\n              primitive_locations.append((r_idx, c_idx))\n\n  if not primitive_locations:\n      return [] # Primitive not found anywhere on the map, cannot collect\n\n  # 3. Use BFS to find the shortest path to a state from which the primitive can be collected\n  # collections.deque is needed for efficient BFS.\n  # Assuming `collections` module is imported at the top level of the file.\n  q = collections.deque()\n  # BFS state: (current_position, current_facing_direction, path_taken)\n  q.append((initial_pos, initial_dir, []))\n  \n  # Visited set: stores (position, facing_direction) to avoid redundant exploration and cycles\n  visited = set([(initial_pos, initial_dir)])\n\n  while q:\n      (r, c), current_dir, path = q.popleft()\n\n      # Check if we are at a position (r, c) from which we can collect the primitive\n      # Iterate over neighbors (dr, dc) to see if a primitive is there\n      for dr_prim, dc_prim in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # North, South, West, East relative deltas\n          primitive_at_pos = (r + dr_prim, c + dc_prim)\n          \n          # Check if the neighbor position is one where the primitive actually exists\n          if primitive_at_pos in primitive_locations:\n              # We are adjacent to a primitive.\n              # Determine the required facing direction to USE the primitive at `primitive_at_pos`.\n              required_facing_dir_for_use = DELTA_TO_FACING_DIR.get((dr_prim, dc_prim))\n              \n              if required_facing_dir_for_use == current_dir:\n                  # We are at (r, c), adjacent to the primitive, and facing it correctly.\n                  # Add the USE action and return the complete path.\n                  return path + [USE]\n\n      # Explore neighbors by performing movement actions\n      for action_type in [UP, DOWN, LEFT, RIGHT]:\n          dr_move, dc_move = ACTION_DELTAS[action_type]\n          next_pos = (r + dr_move, c + dc_move)\n          next_dir = ACTION_TO_FACING_DIR[action_type] # New facing direction after this move action\n\n          # Check if the next position is valid (within bounds and not an obstacle)\n          if not _is_obstacle(next_pos, grid, non_grabbable_indices, height, width):\n              # Check if this (position, direction) state has been visited before\n              if (next_pos, next_dir) not in visited:\n                  visited.add((next_pos, next_dir))\n                  q.append((next_pos, next_dir, path + [action_type]))\n  \n  # If BFS completes and no path was found to a collectible state\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:57:20.905094", "function_name": "collect", "function_body": "  actions_taken = []\n\n  # 1. Reset the environment to get an initial state.\n  # This updates the internal state of the `env` object.\n  _ = env.reset()\n  \n  # Get the mapping of action names to integer IDs from the environment.\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 2. Locate the target primitive on the global grid.\n  # Access the current state from the environment's internal representation.\n  current_state = env._current_state \n  \n  # Get the full global grid from the current observations.\n  obs_dict = env.observations()['features_dict']\n  global_grid = obs_dict['features_global'] # This is a numpy array of shape (WIDTH, HEIGHT, n_kinds)\n  \n  primitive_kind_idx = primitive # The integer ID of the primitive to collect.\n\n  # Find all (row, col) coordinates where the primitive is present on the grid.\n  primitive_locations = np.argwhere(global_grid[:, :, primitive_kind_idx] > 0)\n\n  # If no primitive of this kind is found on the map, it's impossible to collect.\n  if len(primitive_locations) == 0:\n      return [] # Return an empty list of actions.\n\n  # Get the agent's current position (row, col).\n  agent_pos = current_state.pos\n\n  # Find the closest primitive location using Manhattan distance.\n  target_pos = None\n  min_dist = float('inf')\n\n  for loc_array in primitive_locations:\n      # Convert the numpy array coordinate [row, col] to a tuple (row, col).\n      loc_tuple = tuple(loc_array)\n      \n      # Calculate Manhattan distance from the agent's current position to the primitive.\n      dist = abs(loc_tuple[0] - agent_pos[0]) + abs(loc_tuple[1] - agent_pos[1])\n      \n      if dist < min_dist:\n          min_dist = dist\n          target_pos = loc_tuple\n\n  # This check handles cases where, despite `primitive_locations` not being empty,\n  # `target_pos` might somehow remain `None` (e.g., if primitive_locations contained no valid data).\n  if target_pos is None:\n      return []\n\n  # 3. Pathfind to the target primitive's location.\n  # The agent moves one step at a time, updating its position in the environment.\n  # `current_row` and `current_col` are updated dynamically based on `env._current_state.pos`.\n  current_row, current_col = agent_pos\n  target_row, target_col = target_pos\n\n  # First, move vertically (adjust row).\n  while current_row != target_row:\n      if current_row < target_row:\n          action = ACTION_DOWN\n      else: # current_row > target_row\n          action = ACTION_UP\n      \n      # Execute the action in the environment. We don't need the reward or done status here.\n      _, _, _ = env.step(action)\n      actions_taken.append(action)\n      \n      # Update the agent's current position from the environment's actual state.\n      current_row, current_col = env._current_state.pos\n\n  # Second, move horizontally (adjust column).\n  while current_col != target_col:\n      if current_col < target_col:\n          action = ACTION_RIGHT\n      else: # current_col > target_col\n          action = ACTION_LEFT\n      \n      # Execute the action in the environment.\n      _, _, _ = env.step(action)\n      actions_taken.append(action)\n      \n      # Update the agent's current position from the environment's actual state.\n      current_row, current_col = env._current_state.pos\n\n  # 4. Perform the 'USE' action to collect the primitive.\n  # It's assumed that once the agent is on the same cell as the primitive,\n  # the 'USE' action will pick it up or interact with it to put it into the inventory.\n  _, _, _ = env.step(ACTION_USE)\n  actions_taken.append(ACTION_USE)\n\n  return actions_taken", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:57:21.886661", "function_name": "collect", "function_body": "  import collections # BFS requires collections.deque\n\n  # These constants would typically be defined globally or imported from a common module.\n  # For the purpose of this completion, defining them here using a common naming convention.\n  # Assuming standard DMLab-style action mapping for CraftLab.\n  _ACTION_DOWN = 0\n  _ACTION_UP = 1\n  _ACTION_LEFT = 2\n  _ACTION_RIGHT = 3\n  _ACTION_USE = 4\n\n  # Map movement actions to their (dx, dy) effect on position.\n  # This assumes: UP moves North (dy=-1), DOWN moves South (dy=1), LEFT moves West (dx=-1), RIGHT moves East (dx=1).\n  _ACTION_MOVE_DELTAS = {\n      _ACTION_UP: (0, -1),\n      _ACTION_DOWN: (0, 1),\n      _ACTION_LEFT: (-1, 0),\n      _ACTION_RIGHT: (1, 0)\n  }\n\n  # Map movement actions to the resulting agent direction (0:N, 1:E, 2:S, 3:W).\n  # This is based on typical DMLab-style movement actions where a move action also sets facing direction.\n  _ACTION_TO_FINAL_DIR = {\n      _ACTION_UP: 0,      # Facing North after moving Up\n      _ACTION_RIGHT: 1,   # Facing East after moving Right\n      _ACTION_DOWN: 2,    # Facing South after moving Down\n      _ACTION_LEFT: 3     # Facing West after moving Left\n  }\n\n  # Map direction integers to their (dx, dy) for the cell directly in front of the agent.\n  # This is used for the USE action, to determine which cell would be interacted with.\n  _DIR_TO_FORWARD_DELTA = {\n      0: (0, -1), # North: (x, y-1) if agent is at (x,y)\n      1: (1, 0),  # East: (x+1, y)\n      2: (0, 1),  # South: (x, y+1)\n      3: (-1, 0)  # West: (x-1, y)\n  }\n\n  def _is_valid_pos(x: int, y: int, width: int, height: int) -> bool:\n      \"\"\"Checks if a given (x, y) coordinate is within grid boundaries.\"\"\"\n      return 0 <= x < width and 0 <= y < height\n\n  state = env._current_state\n  grid = state.grid\n  current_pos = state.pos # (x, y) tuple\n  current_dir = state.dir # int (0:N, 1:E, 2:S, 3:W)\n  inventory = state.inventory\n  world = state.world\n\n  # 1. Check if primitive is already collected\n  if inventory[primitive] > 0:\n      return []\n\n  # 2. Determine if the primitive is grabbable\n  is_grabbable = primitive in world.grabbable_indices\n  if not is_grabbable:\n      # If it's not grabbable, the 'collect' action (via USE) is not applicable.\n      # This function assumes 'collect' means to pick up an item into inventory.\n      return []\n\n  grid_width, grid_height, _ = grid.shape\n\n  # Find all locations of the primitive on the grid.\n  # The grid stores item counts, so any cell with `grid[x, y, primitive] > 0` contains the primitive.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if grid[x, y, primitive] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # Primitive not found anywhere on the grid.\n      return []\n\n  # Pre-calculate all desired (agent_pos, agent_dir) states that allow collecting a primitive.\n  # A goal state is ((agent_x, agent_y), agent_direction) such that:\n  # 1. The cell directly in front of the agent (based on agent_direction) is within grid bounds.\n  # 2. That cell contains the target `primitive`.\n  goal_states = set()\n  for px, py in primitive_locations:\n      for adir, (fdx, fdy) in _DIR_TO_FORWARD_DELTA.items():\n          # Calculate the agent's position (ax, ay) from which it would be facing (px, py)\n          # If agent is at (ax, ay) facing `adir`, it interacts with (ax + fdx, ay + fdy).\n          # We want (ax + fdx, ay + fdy) to be equal to (px, py).\n          ax, ay = px - fdx, py - fdy\n          \n          if _is_valid_pos(ax, ay, grid_width, grid_height):\n              goal_states.add(((ax, ay), adir))\n\n  # 3. Use Breadth-First Search (BFS) to find the shortest sequence of actions\n  # to reach any of the `goal_states`.\n  # BFS state: (current_pos_tuple, current_facing_direction_int, [actions_taken_so_far])\n  queue = collections.deque([((current_pos), current_dir, [])])\n  \n  # Visited set: (pos_tuple, facing_direction) to avoid redundant computations and infinite loops.\n  visited = {((current_pos), current_dir)}\n\n  while queue:\n      (cx, cy), c_dir, path_actions = queue.popleft()\n\n      # Check if the current state (agent's position and direction) is a goal state.\n      if ((cx, cy), c_dir) in goal_states:\n          # Found a path! Add the USE action at the end and return the complete action sequence.\n          return path_actions + [_ACTION_USE]\n\n      # Explore possible next states via movement actions.\n      # Movement actions change both position and the agent's facing direction.\n      for action, (mdx, mdy) in _ACTION_MOVE_DELTAS.items():\n          nx, ny = cx + mdx, cy + mdy\n          n_dir = _ACTION_TO_FINAL_DIR[action] # The new direction after this movement action.\n          \n          new_state = ((nx, ny), n_dir)\n\n          # Check if the new position is valid and if this (pos, dir) state hasn't been visited yet.\n          if _is_valid_pos(nx, ny, grid_width, grid_height) and new_state not in visited:\n              visited.add(new_state)\n              queue.append((new_state[0], new_state[1], path_actions + [action]))\n\n  # If the BFS completes without finding a goal state, it means the primitive is unreachable\n  # given the current environment and available actions.\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:58:46.405308", "function_name": "collect", "function_body": "    actions = []\n    \n    # Get initial inventory count for the primitive\n    initial_inventory = env.observations()['features_dict']['inventory']\n    initial_primitive_count = initial_inventory[primitive]\n\n    # Check if the primitive is already in inventory (at least one)\n    if initial_primitive_count > 0:\n        return [] # Already collected, no actions needed\n\n    # Constants for actions (consistent with CraftLab.action_specs)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Maximum steps to attempt collection to prevent infinite loops.\n    # This also accounts for scenarios where the primitive might be unreachable.\n    # Using a multiplier of CraftLab's max_steps for robustness.\n    max_attempt_steps = env.max_steps * 5 \n    if max_attempt_steps == 0: # Fallback for environments with very small or zero max_steps\n        max_attempt_steps = 1000\n\n    steps_taken = 0\n    while steps_taken < max_attempt_steps:\n        current_state = env._current_state # Get the current CraftState instance\n        agent_x, agent_y = current_state.pos\n        \n        # Check if current inventory already satisfies the goal (i.e., we picked it up)\n        current_inventory = env.observations()['features_dict']['inventory']\n        if current_inventory[primitive] > initial_primitive_count:\n            break # Successfully collected (inventory count increased)\n\n        # 1. Check if we are already adjacent to the primitive and can collect it\n        if current_state.next_to(primitive):\n            # We are next to the primitive, attempt to use it.\n            reward, done, _ = env.step(ACTION_USE)\n            actions.append(ACTION_USE)\n            steps_taken += 1\n            \n            # If the environment reports done after an action, we should stop trying.\n            if done:\n                # print(\"Environment reported 'done' after USE action during collection attempt.\")\n                break \n            # The loop will re-check `current_inventory[primitive] > initial_primitive_count`\n            # in the next iteration to confirm collection.\n\n        # 2. Find the closest instance of the primitive on the grid\n        current_grid = current_state.grid # Use CraftState's direct grid\n        grid_width, grid_height, _ = current_grid.shape\n        \n        primitive_locations = []\n        for x in range(grid_width):\n            for y in range(grid_height):\n                if current_grid[x, y, primitive] == 1:\n                    primitive_locations.append((x, y))\n\n        if not primitive_locations:\n            # Primitive not found on the grid. This means it's either not spawned\n            # or already collected (which was checked at the beginning of the loop).\n            # If truly not present, we cannot complete the collection.\n            # print(f\"Primitive {env.world.cookbook.index.get(primitive)} (ID: {primitive}) not found on grid.\")\n            return [] # Cannot collect\n\n        closest_primitive_pos = None\n        min_dist = float('inf')\n        \n        # Find the primitive closest to the agent's current position (Manhattan distance)\n        for px, py in primitive_locations:\n            dist = abs(px - agent_x) + abs(py - agent_y)\n            if dist < min_dist:\n                min_dist = dist\n                closest_primitive_pos = (px, py)\n        \n        if closest_primitive_pos is None:\n            # This should logically not be reached if primitive_locations is not empty.\n            # print(\"Error: No closest primitive position found despite locations being present.\")\n            break # Fatal error, give up.\n\n        target_x, target_y = closest_primitive_pos\n\n        # 3. Move towards the target primitive if not yet adjacent\n        # This uses a simple greedy movement strategy, prioritizing movement along the larger dimension difference.\n        # It does not perform sophisticated pathfinding and may get stuck behind obstacles.\n        \n        move_action = -1\n        dx = target_x - agent_x\n        dy = target_y - agent_y\n\n        # If min_dist is > 1, the agent is not yet adjacent (Manhattan sense)\n        if min_dist > 1:\n            if abs(dx) >= abs(dy): # Prioritize X movement if X difference is greater or equal\n                if dx > 0:\n                    move_action = ACTION_RIGHT\n                else:\n                    move_action = ACTION_LEFT\n            else: # Else (abs(dy) > abs(dx) or dx is 0), prioritize Y movement\n                if dy > 0:\n                    move_action = ACTION_DOWN\n                else:\n                    move_action = ACTION_UP\n        else: # min_dist is 0 or 1. Agent is on or adjacent to target.\n              # If `current_state.next_to(primitive)` was false, and we are already\n              # on or next to the target in Manhattan distance, it implies\n              # the primitive is not collectible from this position, or\n              # `next_to` has specific requirements not met by simple adjacency.\n              # In such a case, further movement with this simple strategy won't help.\n            # print(f\"Agent at ({agent_x},{agent_y}) is near target ({target_x},{target_y}) but not collectable. Giving up.\")\n            break # Stuck or uncollectable\n\n        if move_action != -1:\n            reward, done, _ = env.step(move_action)\n            actions.append(move_action)\n            steps_taken += 1\n        else:\n            # No valid move action determined, likely stuck (as per break condition above)\n            # print(\"Could not determine a valid move action to get closer or collect. Giving up.\")\n            break\n            \n        # Check if environment is done (e.g., max_steps reached in CraftLab)\n        if done:\n            # print(\"Environment reported 'done' during collection attempt.\")\n            break\n\n    # Final check: if collection was successful, return the sequence of actions.\n    # Otherwise, return an empty list indicating failure.\n    final_inventory = env.observations()['features_dict']['inventory']\n    if final_inventory[primitive] > initial_primitive_count:\n        return actions\n    else:\n        return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:58:47.367394", "function_name": "collect", "function_body": "  import collections\n  \n  # Action constants (assuming these are consistent with CraftLab.action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Delta movements for each action (dx, dy)\n  # Assuming (0,0) is top-left, positive Y is down, positive X is right\n  DELTAS = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0)\n  }\n\n  world = env.world\n  current_state = env._current_state\n\n  # 1. Check if the primitive is already in the inventory\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  # 2. Determine target coordinates for collection\n  # For grabbables, agent must move onto the cell with the item.\n  # For non-grabbables, agent must move to a cell adjacent to the item (to use CraftState.next_to).\n  \n  start_pos = current_state.pos\n  grid = current_state.grid\n  width, height, _ = grid.shape # n_kinds is not needed here\n\n  is_grabbable = primitive in world.grabbable_indices\n  is_non_grabbable = primitive in world.non_grabbable_indices\n\n  target_reach_coords = set()\n  \n  # Iterate through the grid to find locations of the primitive\n  for x in range(width):\n    for y in range(height):\n      if grid[x, y, primitive] > 0: # Found the primitive at (x,y)\n        if is_grabbable:\n          target_reach_coords.add((x, y)) # Agent needs to walk onto it\n        elif is_non_grabbable:\n          # Agent needs to be adjacent to it to USE. Add all valid neighbors.\n          # Also add the item's cell itself, in case the agent is already standing on it.\n          target_reach_coords.add((x,y)) \n          for dx, dy in DELTAS.values(): \n            nx, ny = x + dx, y + dy\n            if 0 <= nx < width and 0 <= ny < height: # Check if neighbor is within grid bounds\n              target_reach_coords.add((nx, ny))\n  \n  if not target_reach_coords:\n    # Primitive not found on the map or no reachable location for it\n    return []\n\n  # 3. Perform a Breadth-First Search (BFS) to find the shortest path\n  # BFS state: (current_position_tuple, list_of_actions_to_reach_here)\n  queue = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set of (x, y) tuples to avoid cycles and redundant paths\n\n  path_to_item = None\n\n  while queue:\n    current_pos, path = queue.popleft()\n    cx, cy = current_pos\n\n    # If current_pos is one of the desired target cells, we found the shortest path\n    if current_pos in target_reach_coords:\n      path_to_item = path\n      break # Found the shortest path, exit BFS\n\n    # Explore neighbors\n    for action, delta_pos in DELTAS.items():\n      dx, dy = delta_pos\n      next_x, next_y = cx + dx, cy + dy\n      next_pos = (next_x, next_y)\n\n      # Check bounds and if the next position has already been visited\n      if 0 <= next_x < width and 0 <= next_y < height and next_pos not in visited:\n        visited.add(next_pos)\n        new_path = path + [action]\n        queue.append((next_pos, new_path))\n  \n  if path_to_item is None:\n    # No path found to any target coordinate\n    return []\n\n  # 4. Compile the final list of actions\n  actions_to_perform = list(path_to_item) # Make a mutable copy\n\n  # If the primitive is non-grabbable, an additional 'USE' action is required\n  # The BFS ensures the agent is at a position where 'USE' can be effective (i.e., adjacent to the item).\n  if is_non_grabbable:\n    actions_to_perform.append(USE)\n    \n  return actions_to_perform", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:00:08.422582", "function_name": "collect", "function_body": "", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:00:09.478919", "function_name": "collect", "function_body": "  import collections # Required for deque\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Define direction constants (assuming 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  _DIR_UP = 0\n  _DIR_RIGHT = 1\n  _DIR_DOWN = 2\n  _DIR_LEFT = 3\n\n  # Helper function to calculate turn actions to change from current_dir to target_dir\n  def _get_turn_actions(current_dir, target_dir):\n      turn_actions = []\n      \n      # Calculate shortest rotation\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # One clockwise turn needed\n          turn_actions.append(_RIGHT)\n      elif diff == 2: # Two turns needed (180 degrees)\n          turn_actions.extend([_RIGHT, _RIGHT]) # Can be two LEFTs too, same cost\n      elif diff == 3: # One counter-clockwise turn needed\n          turn_actions.append(_LEFT)\n      \n      return turn_actions\n\n  # Helper function to get the cardinal direction from (from_x, from_y) to (to_x, to_y)\n  def _get_relative_direction(from_x, from_y, to_x, to_y):\n      \"\"\"Determines the direction from (from_x, from_y) to (to_x, to_y) if adjacent.\"\"\"\n      if from_x == to_x:\n          if to_y == from_y - 1: return _DIR_UP\n          if to_y == from_y + 1: return _DIR_DOWN\n      elif from_y == to_y:\n          if to_x == from_x + 1: return _DIR_RIGHT\n          if to_x == from_x - 1: return _DIR_LEFT\n      return None # Not adjacent in a cardinal direction\n\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  # IMPROVEMENT: Check if the primitive is already in the agent's inventory\n  current_inventory = features_dict['inventory']\n  if current_inventory[primitive] > 0:\n      return [] # Already collected, no actions needed\n\n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the current grid's shape.\n  WIDTH, HEIGHT, _ = current_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  # current_pos = (current_px, current_py) # Not directly used but useful for understanding.\n\n  # Get current agent direction (convert one-hot array to integer)\n  current_dir_int = np.argmax(features_dict['direction'])\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = set() # Use a set for faster lookups\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell\n      if current_grid[x, y, primitive] == 1:\n        primitive_locations.add((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  # Define truly impassable terrain for movement (e.g., water, walls)\n  impassable_movement_terrain_indices = {env.world.water_index} \n  # If stone is intended as an impassable wall, uncomment the line below:\n  # impassable_movement_terrain_indices.add(env.world.stone_index)\n\n  def is_obstacle(x, y, grid, impassable_kinds_set):\n    \"\"\"Checks if the cell (x,y) contains any truly impassable item for movement.\"\"\"\n    for k in impassable_kinds_set:\n      if grid[x, y, k] == 1:\n        return True\n    return False\n\n  # BFS setup\n  # Queue stores tuples: (current_x, current_y, current_direction, [path_actions_to_reach_here])\n  q = collections.deque()\n  q.append((current_px, current_py, current_dir_int, [])) \n  \n  # Set to store visited states: ((x, y), direction) to avoid cycles and re-processing longer paths to same state\n  visited = set() \n  visited.add((current_px, current_py, current_dir_int))\n\n  # Directions for movement and the resulting new agent direction\n  # (dx, dy, new_dir_after_move, action_to_take_for_this_move)\n  move_options = [\n      (0, -1, _DIR_UP, _UP),    # Move North (Up)\n      (0, 1, _DIR_DOWN, _DOWN),  # Move South (Down)\n      (-1, 0, _DIR_LEFT, _LEFT), # Move West (Left)\n      (1, 0, _DIR_RIGHT, _RIGHT) # Move East (Right)\n  ]\n\n  while q:\n    cx, cy, cdir, current_path = q.popleft()\n\n    # --- GOAL CHECK ---\n    # Check if from the current position (cx, cy) and facing cdir,\n    # we are adjacent to a primitive and can immediately USE it.\n    for px, py in primitive_locations:\n        # Check if (cx, cy) is adjacent to (px, py) (Manhattan distance 1)\n        if abs(cx - px) + abs(cy - py) == 1:\n            # Determine the required direction for the agent to face (px, py) from (cx, cy)\n            required_face_dir = _get_relative_direction(cx, cy, px, py)\n            \n            if required_face_dir is not None: # Ensure it's a valid cardinal neighbor\n                # Calculate turns needed to align with the required facing direction\n                turns_to_face = _get_turn_actions(cdir, required_face_dir)\n                \n                # If already facing or can turn to face, this is a valid interaction point.\n                # Since BFS explores layer by layer, the *first* time we hit such a state\n                # (position, direction from which _USE is possible), it represents\n                # the shortest path to collect any primitive.\n                return current_path + turns_to_face + [_USE] # Found the shortest path, return immediately\n\n    # --- EXPLORE MOVEMENT NEIGHBORS ---\n    for dx, dy, new_agent_dir_after_move, move_action in move_options:\n      nx, ny = cx + dx, cy + dy\n\n      # Check boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if the potential target cell is an obstacle for movement\n      if is_obstacle(nx, ny, current_grid, impassable_movement_terrain_indices):\n        continue\n\n      # Calculate turns needed to align with the direction of the intended move\n      turns_for_move = _get_turn_actions(cdir, new_agent_dir_after_move)\n      \n      # The state after moving: new position (nx, ny) and new direction (new_agent_dir_after_move)\n      new_state_tuple = (nx, ny, new_agent_dir_after_move)\n\n      if new_state_tuple not in visited:\n        # Construct the path segment for this step: turns + movement\n        path_segment = turns_for_move + [move_action]\n        new_total_path = current_path + path_segment\n        \n        visited.add(new_state_tuple)\n        q.append((nx, ny, new_agent_dir_after_move, new_total_path))\n  \n  # If BFS completes and no path to collect the primitive was found (e.g., unreachable)\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:01:47.075711", "function_name": "collect", "function_body": "  import collections\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dx == 0 and dy == 1: return SOUTH_DIR\n    if dx == 0 and dy == -1: return NORTH_DIR\n    return None # Should not happen if agent_pos and item_pos are cardinally adjacent\n\n  # Mapping from movement action to the direction the agent would face after taking it\n  # Based on CraftState.step behavior where movement changes agent's facing direction\n  action_to_direction = {\n      UP_ACTION: NORTH_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  \n  # Check if the primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n  grid = current_state.grid\n\n  grid_height, grid_width, _ = grid.shape\n\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def _is_walkable(x, y):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-grabbable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item is present at (y, x)\n    for kind_idx in non_grabbable_indices:\n      if grid[y, x, kind_idx] > 0:\n        return False\n    return True\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Prepare BFS goal states: (agent_x, agent_y, agent_dir) from which USE action can be applied\n  bfs_goal_states = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells for the agent to stand on\n    # (dx_adj, dy_adj) from item to agent\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: \n      adj_x, adj_y = item_x + dx_adj, item_y + dy_adj\n\n      if _is_walkable(adj_x, adj_y):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_goal_states.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_goal_states:\n    return [] # No traversable adjacent positions to any primitive instance\n\n  # BFS setup: (current_x, current_y, current_dir, list_of_actions_to_reach_here)\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir, [])])\n  # Visited set: (x, y, dir) to avoid cycles and redundant exploration\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  shortest_path_actions = None \n\n  while queue:\n    curr_x, curr_y, curr_dir, path_so_far = queue.popleft()\n\n    # Check if the current state is one of the goal states\n    if (curr_x, curr_y, curr_dir) in bfs_goal_states:\n        shortest_path_actions = path_so_far\n        break # Found the shortest path to a goal\n\n    # Explore neighbors through movement actions\n    move_deltas = {\n        UP_ACTION: (0, -1),\n        DOWN_ACTION: (0, 1),\n        LEFT_ACTION: (-1, 0),\n        RIGHT_ACTION: (1, 0)\n    }\n    \n    for action, (dx, dy) in move_deltas.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = action_to_direction[action] # Agent faces the direction of movement after moving\n\n      if _is_walkable(next_x, next_y):\n        state = (next_x, next_y, next_dir)\n        if state not in visited:\n          visited.add(state)\n          queue.append((next_x, next_y, next_dir, path_so_far + [action]))\n    \n    # Explore neighbors through turning actions\n    # Agent's position doesn't change, only direction\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      next_x, next_y = curr_x, curr_y \n      \n      # Calculate new direction based on the turn action\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4 # Turn clockwise\n      \n      state = (next_x, next_y, next_dir)\n      if state not in visited:\n        visited.add(state)\n        queue.append((next_x, next_y, next_dir, path_so_far + [turn_action]))\n\n  if shortest_path_actions is None:\n    return [] # No path found to any primitive's collection point\n\n  # Final step: append the USE action after reaching the correct position and facing direction.\n  final_actions = list(shortest_path_actions) # Make a copy\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:01:48.067881", "function_name": "collect", "function_body": "  import collections\n\n  # Define actions and directions\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Mapping from movement action to its (dx, dy) delta and the resulting agent direction.\n  # This assumes that performing a cardinal movement action (UP, DOWN, LEFT, RIGHT)\n  # also sets the agent's facing direction to that cardinal direction.\n  ACTION_TO_MOVE_AND_DIR = {\n      UP_ACTION: ((0, -1), NORTH_DIR),\n      DOWN_ACTION: ((0, 1), SOUTH_DIR),\n      LEFT_ACTION: ((-1, 0), WEST_DIR),\n      RIGHT_ACTION: ((1, 0), EAST_DIR),\n  }\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"Calculates the direction the agent needs to face from its (agent_x, agent_y)\n    to look directly at the item at (item_x, item_y). Assumes they are cardinally adjacent.\n    \"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dx == 0 and dy == 1: return SOUTH_DIR\n    if dx == 0 and dy == -1: return NORTH_DIR\n    return None # Should not happen for directly adjacent items\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir # Initial direction of the agent\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_walkable(x, y):\n    \"\"\"Checks if a cell is within grid bounds and traversable (does not contain non-grabbable items).\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item (obstacle) is at (x, y)\n    for k_idx in non_grabbable_indices:\n      if grid[y, x, k_idx] == 1: # Grid is typically (HEIGHT, WIDTH, KINDS)\n        return False\n    return True\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n  if len(x_coords) == 0:\n    return [] # Primitive not found anywhere on the grid\n\n  # Define BFS goal states: (agent_x, agent_y, agent_dir) from which the USE_ACTION can collect the primitive.\n  # A goal state means the agent is adjacent to the primitive and facing it.\n  bfs_goal_states = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Iterate over all 4 cardinal adjacent cells where the agent could stand\n    # (dx_from_item, dy_from_item) represents the vector from the item's position to the agent's potential position\n    for dx_from_item, dy_from_item in [(-1, 0), (1, 0), (0, -1), (0, 1)]: \n      adj_x, adj_y = item_x + dx_from_item, item_y + dy_from_item\n\n      if is_walkable(adj_x, adj_y):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_goal_states.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_goal_states:\n    return [] # No traversable adjacent positions that allow facing any primitive instance\n\n  # BFS Initialization\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken_to_reach_here)\n  queue = collections.deque([(start_x, start_y, start_dir, [])]) \n  # Visited set: (x, y, dir) to avoid cycles and redundant exploration\n  visited = {(start_x, start_y, start_dir)}\n  \n  shortest_path_actions = None\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_so_far = queue.popleft()\n\n    # Check if the current state (position and direction) is one of the goal states\n    if (curr_x, curr_y, curr_dir) in bfs_goal_states:\n      shortest_path_actions = path_so_far\n      break # Found the shortest path to a suitable collection point\n\n    # Explore possible next states by applying each of the 4 cardinal movement actions\n    for action in [UP_ACTION, DOWN_ACTION, LEFT_ACTION, RIGHT_ACTION]:\n      (dx, dy), new_dir_from_action = ACTION_TO_MOVE_AND_DIR[action]\n      \n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = new_dir_from_action # Agent's direction changes to match the cardinal move\n\n      # Check if the next state is valid and has not been visited yet\n      if is_walkable(next_x, next_y):\n        state_tuple = (next_x, next_y, next_dir)\n        if state_tuple not in visited:\n          visited.add(state_tuple)\n          queue.append((next_x, next_y, next_dir, path_so_far + [action]))\n\n  if shortest_path_actions is None:\n    return [] # No path found to any primitive's collection point\n\n  # The agent has reached a state (position and direction) from which it can use the primitive.\n  # Append the USE_ACTION as the final step.\n  final_actions = list(shortest_path_actions) # Create a mutable copy\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
