{"timestamp": "2025-07-30T22:03:17.759661", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Mapping from movement action to its (dx, dy) delta and the direction\n  # the agent will face after performing that action.\n  # This assumes movement actions (UP, DOWN, LEFT, RIGHT) also set the agent's facing direction.\n  ACTION_DATA = {\n      UP_ACTION: {'delta': (0, -1), 'dir': NORTH_DIR},\n      DOWN_ACTION: {'delta': (0, 1), 'dir': SOUTH_DIR},\n      LEFT_ACTION: {'delta': (-1, 0), 'dir': WEST_DIR},\n      RIGHT_ACTION: {'delta': (1, 0), 'dir': EAST_DIR},\n  }\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Optimization: Check if the primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_walkable(x, y):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-grabbable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item is present at (y, x)\n    for kind_idx in non_grabbable_indices:\n      if grid[y, x, kind_idx] > 0:\n        return False\n    return True\n\n  def get_coords_in_front(x, y, direction):\n    \"\"\"Returns the coordinates (tx, ty) of the cell directly in front of (x,y) when facing 'direction'.\"\"\"\n    if direction == NORTH_DIR: return x, y - 1\n    if direction == SOUTH_DIR: return x, y + 1\n    if direction == WEST_DIR: return x - 1, y\n    if direction == EAST_DIR: return x + 1, y\n    return None, None # Should not happen with valid directions\n\n  # BFS setup\n  # Queue stores (x, y, dir), representing agent's position and its facing direction.\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing.\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Parent map to reconstruct the path: {child_state: (parent_state, action_to_child)}.\n  parent_map = {} \n  \n  found_goal_state = None # Stores the (x, y, dir) of the goal state once found.\n\n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # --- Goal Check ---\n    # Check if the primitive is directly in front of the current agent state (position and direction).\n    item_x_in_front, item_y_in_front = get_coords_in_front(curr_x, curr_y, curr_dir)\n    \n    # Ensure the target cell is within grid bounds before checking its contents.\n    if (0 <= item_x_in_front < grid_width and 0 <= item_y_in_front < grid_height):\n      if grid[item_y_in_front, item_x_in_front, primitive_id] == 1:\n        found_goal_state = (curr_x, curr_y, curr_dir)\n        break # Found the shortest path to a state from which 'USE' can collect the primitive.\n\n    # --- Explore Neighbors via Movement Actions ---\n    # For each possible movement action (UP, DOWN, LEFT, RIGHT).\n    for action, data in ACTION_DATA.items():\n      dx, dy = data['delta']\n      next_dir = data['dir'] # The direction the agent will face *after* this move.\n\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_state = (next_x, next_y, next_dir)\n\n      # Check if the next cell is traversable and if this state hasn't been visited yet.\n      if is_walkable(next_x, next_y) and next_state not in visited:\n        visited.add(next_state)\n        parent_map[next_state] = ((curr_x, curr_y, curr_dir), action)\n        queue.append(next_state)\n\n  if found_goal_state is None:\n    return [] # No path found to any state from which the primitive can be collected.\n\n  # Reconstruct the path by backtracking from the found goal state to the initial state.\n  actions = []\n  curr_state = found_goal_state\n  initial_state = (initial_agent_x, initial_agent_y, initial_agent_dir)\n\n  while curr_state != initial_state:\n    parent_state, action = parent_map[curr_state]\n    actions.insert(0, action) # Prepend action to build the path in the correct chronological order.\n    curr_state = parent_state\n  \n  # Finally, append the USE action after reaching the correct position and facing direction.\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T22:04:21.066226", "function_name": "collect", "function_body": "  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2 # Turn left\n  RIGHT_ACTION = 3 # Turn right\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Define movement vectors based on direction\n  # (dx, dy) where dx is change in x (column) and dy is change in y (row)\n  DIR_VECTORS = {\n      NORTH_DIR: (0, -1),\n      EAST_DIR: (1, 0),\n      SOUTH_DIR: (0, 1),\n      WEST_DIR: (-1, 0),\n  }\n  # For moving backward (DOWN_ACTION) relative to current direction\n  OPPOSITE_DIR_VECTORS = {\n      NORTH_DIR: (0, 1),\n      EAST_DIR: (-1, 0),\n      SOUTH_DIR: (0, -1),\n      WEST_DIR: (1, 0),\n  }\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes item_x, item_y is cardinally adjacent to agent_x, agent_y\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    # An adjacent item will have either dx=0 or dy=0 (but not both), and the other will be +/-1.\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dx == 0 and dy == 1: return SOUTH_DIR\n    if dx == 0 and dy == -1: return NORTH_DIR\n    return None # Should not happen for a cardinally adjacent item\n\n  # Helper function: Returns actions to turn from current_dir to target_dir.\n  def _get_turn_actions(current_dir, target_dir):\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    # Calculate shortest turns (clockwise vs. counter-clockwise)\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION)\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION)\n    return actions\n\n  # Get primitive's integer ID from the cookbook\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information from the environment\n  current_state = env._current_state\n  grid = current_state.grid # (HEIGHT, WIDTH, KINDS)\n  agent_start_x, agent_start_y = current_state.pos\n  agent_start_dir = current_state.dir # Agent's initial facing direction\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Define impassable indices for traversability checks.\n  # These are entities the agent cannot move onto.\n  impassable_indices = set()\n  impassable_indices.update(env.world.non_grabbable_indices)\n  impassable_indices.update(env.world.workshop_indices)\n  impassable_indices.add(primitive_id) # Agent cannot move onto the primitive it's collecting\n\n  # Helper function to check if a grid cell is traversable.\n  def is_traversable(x, y):\n    # Check bounds first\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell is occupied by any impassable item\n    for idx in impassable_indices:\n        if grid[y, x, idx] == 1: # grid is (y, x, kind)\n            return False\n    return True # Cell is traversable\n\n  # Step 1: Find all actual locations of the primitive on the grid.\n  # np.where returns (row_indices, col_indices), which correspond to (y_coords, x_coords)\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n  primitive_locations = set()\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i])) # Store as (x, y)\n\n  if not primitive_locations:\n    return [] # Primitive not found on the grid, no actions possible\n\n  # Step 2: Identify all potential collection points.\n  # These are traversable cells from which the agent can be adjacent to *any* instance of the primitive.\n  potential_collection_points = set()\n  ADJACENCY_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Cardinal neighbors (dx, dy)\n  \n  for px, py in primitive_locations:\n    for dx, dy in ADJACENCY_DELTAS:\n      adj_x, adj_y = px + dx, py + dy\n      if is_traversable(adj_x, adj_y):\n        potential_collection_points.add((adj_x, adj_y))\n  \n  if not potential_collection_points:\n      return [] # No valid traversable adjacent positions exist for any primitive instance\n\n  # Step 3: BFS Pathfinding to *any* of the potential_collection_points.\n  # The state in the queue: (current_x, current_y, current_dir, list_of_actions_to_reach_here)\n  queue = [(agent_start_x, agent_start_y, agent_start_dir, [])]\n  # Visited set: (x, y, dir) to avoid revisiting the same state (position + orientation)\n  visited = set([(agent_start_x, agent_start_y, agent_start_dir)])\n  \n  path_to_adj_pos = []\n  final_agent_dir_at_target = -1 \n  chosen_adj_pos = None \n  target_item_pos_for_facing = None \n\n  while queue:\n    curr_x, curr_y, curr_dir, current_path = queue.pop(0)\n\n    # Check if the current position is a target collection point\n    if (curr_x, curr_y) in potential_collection_points:\n      path_to_adj_pos = list(current_path) # Make a copy\n      final_agent_dir_at_target = curr_dir\n      chosen_adj_pos = (curr_x, curr_y)\n      \n      # Identify *which* primitive instance this chosen_adj_pos is adjacent to,\n      # to determine the final facing direction.\n      for dx, dy in ADJACENCY_DELTAS:\n          item_x, item_y = curr_x + dx, curr_y + dy\n          if 0 <= item_x < grid_width and 0 <= item_y < grid_height and\\\n             grid[item_y, item_x, primitive_id] == 1:\n              target_item_pos_for_facing = (item_x, item_y)\n              break \n      break # Path found, exit BFS\n\n    # Explore possible actions: Movement and Turning\n    # 1. Try moving forward (UP_ACTION)\n    move_dx_fwd, move_dy_fwd = DIR_VECTORS[curr_dir]\n    next_x_fwd, next_y_fwd = curr_x + move_dx_fwd, curr_y + move_dy_fwd\n    next_dir_fwd = curr_dir # Direction doesn't change when moving\n\n    if is_traversable(next_x_fwd, next_y_fwd) and (next_x_fwd, next_y_fwd, next_dir_fwd) not in visited:\n      visited.add((next_x_fwd, next_y_fwd, next_dir_fwd))\n      queue.append((next_x_fwd, next_y_fwd, next_dir_fwd, current_path + [UP_ACTION]))\n\n    # 2. Try moving backward (DOWN_ACTION)\n    move_dx_back, move_dy_back = OPPOSITE_DIR_VECTORS[curr_dir]\n    next_x_back, next_y_back = curr_x + move_dx_back, curr_y + move_dy_back\n    next_dir_back = curr_dir \n    \n    if is_traversable(next_x_back, next_y_back) and (next_x_back, next_y_back, next_dir_back) not in visited:\n      visited.add((next_x_back, next_y_back, next_dir_back))\n      queue.append((next_x_back, next_y_back, next_dir_back, current_path + [DOWN_ACTION]))\n\n    # 3. Try turning left (LEFT_ACTION)\n    next_dir_left = (curr_dir - 1 + 4) % 4 # Counter-clockwise turn\n    if (curr_x, curr_y, next_dir_left) not in visited: # Position does not change\n      visited.add((curr_x, curr_y, next_dir_left))\n      queue.append((curr_x, curr_y, next_dir_left, current_path + [LEFT_ACTION]))\n\n    # 4. Try turning right (RIGHT_ACTION)\n    next_dir_right = (curr_dir + 1) % 4 # Clockwise turn\n    if (curr_x, curr_y, next_dir_right) not in visited: \n      visited.add((curr_x, curr_y, next_dir_right))\n      queue.append((curr_x, curr_y, next_dir_right, current_path + [RIGHT_ACTION]))\n\n  # If no path was found\n  if chosen_adj_pos is None:\n    return []\n\n  final_actions = list(path_to_adj_pos)\n\n  # After moving to the chosen_adj_pos, the agent must turn to face the primitive.\n  if target_item_pos_for_facing is not None:\n    target_face_dir = _get_target_facing_direction(chosen_adj_pos[0], chosen_adj_pos[1], \n                                                   target_item_pos_for_facing[0], target_item_pos_for_facing[1])\n    if target_face_dir is not None:\n      # Add turning actions from the agent's direction upon arriving at the chosen_adj_pos\n      final_actions.extend(_get_turn_actions(final_agent_dir_at_target, target_face_dir))\n  \n  # Finally, perform the USE action to collect the primitive\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T22:04:22.082293", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from CraftWorld/CraftLab)\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2 # Turn left\n  RIGHT_ACTION = 3 # Turn right\n  USE_ACTION = 4\n\n  # Direction constants (assuming 0=N, 1=E, 2=S, 3=W clockwise from North)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Movement deltas (dx, dy) for moving forward based on current direction\n  # (dx is change in x-coordinate, dy is change in y-coordinate)\n  # Grid: (0,0) is top-left, x increases right, y increases down\n  DIR_TO_DELTA = {\n      NORTH_DIR: (0, -1),  # Move up (decrease y)\n      EAST_DIR: (1, 0),    # Move right (increase x)\n      SOUTH_DIR: (0, 1),   # Move down (increase y)\n      WEST_DIR: (-1, 0),   # Move left (decrease x)\n  }\n\n  # Movement deltas (dx, dy) for moving backward based on current direction\n  OPPOSITE_DIR_TO_DELTA = {\n      NORTH_DIR: (0, 1),   # If facing North, moving backward is South\n      EAST_DIR: (-1, 0),   # If facing East, moving backward is West\n      SOUTH_DIR: (0, -1),  # If facing South, moving backward is North\n      WEST_DIR: (1, 0),    # If facing West, moving backward is East\n  }\n\n  # Cardinal adjacency deltas for checking neighbors (used for primitive locations)\n  CARDINAL_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # (dx, dy): West, East, North, South\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"\n    Calculates the cardinal direction the agent needs to face from (agent_x, agent_y)\n    to point towards (item_x, item_y). Assumes item is cardinally adjacent.\n    \"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 0 and dy == 0:\n      return None # Agent is on top of item, or item is not truly adjacent\n\n    # Prioritize horizontal or vertical based on which has a non-zero delta\n    if dx > 0 and dy == 0: return EAST_DIR\n    if dx < 0 and dy == 0: return WEST_DIR\n    if dy > 0 and dx == 0: return SOUTH_DIR\n    if dy < 0 and dx == 0: return NORTH_DIR\n    \n    return None # Should only be reached if item is diagonal or no clear cardinal direction\n\n  def _get_turn_actions(current_dir, target_dir):\n    \"\"\"\n    Returns a list of LEFT_ACTION or RIGHT_ACTION to turn from current_dir to target_dir.\n    Chooses the shortest turn path (clockwise or counter-clockwise).\n    \"\"\"\n    if current_dir == target_dir:\n      return []\n\n    # Calculate turns needed. Adding 4 and modulo 4 handles wrap-around for direction indices.\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    actions = []\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION) # Assuming RIGHT_ACTION turns clockwise\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION) # Assuming LEFT_ACTION turns counter-clockwise\n    return actions\n\n\n  # Get primitive's integer ID from the cookbook\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information from the environment\n  current_state = env._current_state\n  grid = current_state.grid\n  agent_start_x, agent_start_y = current_state.pos\n  agent_start_dir = current_state.dir # Agent's initial facing direction\n\n  grid_height, grid_width, _ = grid.shape # Grid is (HEIGHT, WIDTH, KINDS)\n\n  # Define impassable indices. These are entities the agent cannot move onto.\n  # Includes non-grabbable items, workshops, and the primitive itself (agent cannot walk onto it).\n  impassable_indices = set(env.world.non_grabbable_indices)\n  impassable_indices.update(env.world.workshop_indices)\n  impassable_indices.add(primitive_id) # Agent cannot move onto the primitive it's collecting\n\n  def is_traversable(x, y):\n    \"\"\"Checks if a grid cell (x, y) is within bounds and free of impassable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell is occupied by any impassable item\n    # Note: grid is indexed by (y, x, kind_idx)\n    for idx in impassable_indices:\n        if grid[y, x, idx] == 1:\n            return False\n    return True\n\n  # Step 1: Find all actual locations of the primitive on the grid.\n  # np.where returns (row_indices, col_indices), which correspond to (y_coords, x_coords)\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n  primitive_locations = set()\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n  \n  if not primitive_locations:\n    return [] # Primitive not found on the grid, no actions possible\n\n  # Step 2: Identify all potential collection points.\n  # These are traversable cells from which the agent can be cardinally adjacent to *any* instance of the primitive.\n  potential_collection_points = set()\n  for px, py in primitive_locations:\n    for dx, dy in CARDINAL_DELTAS:\n      adj_x, adj_y = px + dx, py + dy\n      if is_traversable(adj_x, adj_y): # Only add if the adjacent cell is traversable\n        potential_collection_points.add((adj_x, adj_y))\n  \n  if not potential_collection_points:\n      return [] # No valid traversable adjacent positions exist for any primitive instance\n\n  # Step 3: Breadth-First Search (BFS) for the shortest path to a collection point.\n  # The state in the queue includes current position (x, y), current direction, and path actions.\n  # Using collections.deque for efficient popping from the left end.\n  queue = collections.deque([(agent_start_x, agent_start_y, agent_start_dir, [])])\n  \n  # Visited set stores: (x, y, dir) to avoid revisiting the same state (position + orientation)\n  visited = set([(agent_start_x, agent_start_y, agent_start_dir)])\n  \n  # Variables to store the result of the BFS once a target is found\n  path_to_adj_pos = []\n  final_agent_dir_at_target = -1 # Agent's direction upon reaching chosen_adj_pos\n  chosen_adj_pos = None # The specific adjacent position the agent will move to\n  target_item_pos_for_facing = None # The specific primitive instance to face\n\n  while queue:\n    curr_x, curr_y, curr_dir, current_path = queue.popleft()\n\n    # Check if the current position is one of the target collection points.\n    if (curr_x, curr_y) in potential_collection_points:\n      path_to_adj_pos = current_path\n      final_agent_dir_at_target = curr_dir\n      chosen_adj_pos = (curr_x, curr_y)\n      \n      # Now, identify *which* primitive instance this chosen_adj_pos is adjacent to.\n      # We need this to determine the final facing direction. Any adjacent primitive will do.\n      for dx, dy in CARDINAL_DELTAS:\n          item_x, item_y = curr_x + dx, curr_y + dy\n          if (0 <= item_x < grid_width and 0 <= item_y < grid_height and\n              grid[item_y, item_x, primitive_id] == 1):\n              target_item_pos_for_facing = (item_x, item_y)\n              break # Found an adjacent primitive instance\n      break # Path found to a valid collection point, exit BFS\n\n    # Explore possible actions from the current state: Movement and Turning\n\n    # 1. Try moving forward (UP_ACTION)\n    move_dx_fwd, move_dy_fwd = DIR_TO_DELTA[curr_dir]\n    next_x_fwd, next_y_fwd = curr_x + move_dx_fwd, curr_y + move_dy_fwd\n    next_dir_fwd = curr_dir # Direction does not change when moving forward\n    \n    if is_traversable(next_x_fwd, next_y_fwd) and (next_x_fwd, next_y_fwd, next_dir_fwd) not in visited:\n      visited.add((next_x_fwd, next_y_fwd, next_dir_fwd))\n      queue.append((next_x_fwd, next_y_fwd, next_dir_fwd, current_path + [UP_ACTION]))\n\n    # 2. Try moving backward (DOWN_ACTION)\n    move_dx_back, move_dy_back = OPPOSITE_DIR_TO_DELTA[curr_dir]\n    next_x_back, next_y_back = curr_x + move_dx_back, curr_y + move_dy_back\n    next_dir_back = curr_dir # Direction does not change when moving backward\n    \n    if is_traversable(next_x_back, next_y_back) and (next_x_back, next_y_back, next_dir_back) not in visited:\n      visited.add((next_x_back, next_y_back, next_dir_back))\n      queue.append((next_x_back, next_y_back, next_dir_back, current_path + [DOWN_ACTION]))\n\n    # 3. Try turning left (LEFT_ACTION)\n    next_dir_left = (curr_dir - 1 + 4) % 4 # Counter-clockwise turn\n    # Position remains the same when turning\n    if (curr_x, curr_y, next_dir_left) not in visited:\n      visited.add((curr_x, curr_y, next_dir_left))\n      queue.append((curr_x, curr_y, next_dir_left, current_path + [LEFT_ACTION]))\n\n    # 4. Try turning right (RIGHT_ACTION)\n    next_dir_right = (curr_dir + 1) % 4 # Clockwise turn\n    # Position remains the same when turning\n    if (curr_x, curr_y, next_dir_right) not in visited:\n      visited.add((curr_x, curr_y, next_dir_right))\n      queue.append((curr_x, curr_y, next_dir_right, current_path + [RIGHT_ACTION]))\n\n  # If no path was found to any collection point after exhausting the queue\n  if chosen_adj_pos is None:\n    return []\n\n  final_actions = list(path_to_adj_pos)\n\n  # After moving to the chosen_adj_pos, the agent must turn to face the primitive.\n  # Calculate the required facing direction from the chosen adjacent position to the target item.\n  if target_item_pos_for_facing is not None:\n    target_face_dir = _get_target_facing_direction(chosen_adj_pos[0], chosen_adj_pos[1], \n                                                   target_item_pos_for_facing[0], target_item_pos_for_facing[1])\n    if target_face_dir is not None:\n      # Add turning actions from the agent's direction upon arriving at the chosen_adj_pos\n      final_actions.extend(_get_turn_actions(final_agent_dir_at_target, target_face_dir))\n  \n  # Finally, perform the USE action to collect the primitive\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T22:06:11.745928", "function_name": "collect", "function_body": "    actions_sequence = []\n    MAX_ITERATIONS = 500  # A reasonable limit to prevent infinite loops\n\n    # Action mappings (assuming 0-4 as per CraftLab action_specs)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    for i in range(MAX_ITERATIONS):\n        obs = env.observations()\n        current_state = env._current_state  # Access the CraftState object\n\n        # 1. Check if the primitive is already in inventory\n        if current_state.inventory[primitive] > 0:\n            return actions_sequence\n\n        # Get egocentric view and agent's position within it\n        features_dict = current_state.features_dict()\n        features_ego = features_dict['features_ego']\n        \n        # features_ego has shape (window_height, window_width, n_kinds)\n        ego_h, ego_w, _ = features_ego.shape\n        center_y, center_x = ego_h // 2, ego_w // 2\n\n        current_action = None\n\n        # 2. Search for the primitive in the egocentric view\n        closest_dist = float('inf')\n        target_ego_coords = None\n\n        # Iterate through the egocentric view to find the primitive\n        for y_ego in range(ego_h):\n            for x_ego in range(ego_w):\n                # Check if the current cell contains the primitive\n                if features_ego[y_ego, x_ego, primitive] == 1:\n                    dist = abs(y_ego - center_y) + abs(x_ego - center_x)\n                    if dist < closest_dist:\n                        closest_dist = dist\n                        target_ego_coords = (y_ego, x_ego)\n\n        if target_ego_coords:\n            target_y_ego, target_x_ego = target_ego_coords\n\n            # If the agent is currently on the primitive, use it\n            if target_y_ego == center_y and target_x_ego == center_x:\n                current_action = ACTION_USE\n            else:\n                # Move towards the primitive\n                dy = target_y_ego - center_y\n                dx = target_x_ego - center_x\n\n                # Prioritize movement along the axis with larger distance\n                if abs(dx) > abs(dy):\n                    if dx > 0:\n                        current_action = ACTION_RIGHT\n                    else: # dx < 0\n                        current_action = ACTION_LEFT\n                else: # Prioritize vertical movement (or if abs(dx) == abs(dy))\n                    if dy > 0:\n                        current_action = ACTION_DOWN\n                    else: # dy < 0\n                        current_action = ACTION_UP\n        else:\n            # 3. Primitive not found in the current view, explore systematically\n            # A simple cyclic exploration pattern: UP, RIGHT, DOWN, LEFT\n            exploration_moves = [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]\n            current_action = exploration_moves[i % len(exploration_moves)]\n            \n        # Add the chosen action to the sequence\n        actions_sequence.append(current_action)\n\n        # Execute the action in the environment (we don't need reward/done/obs for this loop logic)\n        _, _, _ = env.step(current_action)\n\n    # If MAX_ITERATIONS reached without collecting the primitive, return the actions taken\n    return actions_sequence", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:06:11.816530", "function_name": "collect", "function_body": "    import collections\n\n    # Define action constants (assuming these are fixed for CraftLab)\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    # Get current state from the environment\n    current_state = env._current_state\n    world = current_state.world\n    grid = current_state.grid\n    agent_pos = current_state.pos\n    \n    WIDTH, HEIGHT, N_KINDS = grid.shape # Get grid dimensions\n\n    # Helper for movement deltas based on action index\n    # (dx, dy) for (DOWN, UP, LEFT, RIGHT) actions\n    move_deltas = {\n        DOWN: (0, 1),\n        UP: (0, -1),\n        LEFT: (-1, 0),\n        RIGHT: (1, 0)\n    }\n\n    # Determine properties of the primitive for collection logic\n    is_primitive_grabbable = primitive in world.grabbable_indices\n    # A primitive resource (like water, stone) might be non-grabbable but still collectible via USE\n    is_primitive_resource_collectible_via_adj = (primitive in world.primitives and \n                                                primitive in world.non_grabbable_indices)\n\n    # Function to check if a cell is traversable for agent movement.\n    # A cell is traversable if it's within bounds and does not contain any entity\n    # that blocks movement (i.e., any non-grabbable item).\n    # Grabbable items can be walked over.\n    def is_traversable(x, y):\n        if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n            return False # Out of bounds\n        \n        # Check if the cell contains any non-grabbable item.\n        # If it does, it's considered an obstacle, as the agent cannot walk onto it.\n        for k_idx in world.non_grabbable_indices:\n            if grid[x, y, k_idx] > 0:\n                return False # Contains an impassable object\n        return True # Cell is empty or contains only grabbable items (and thus traversable)\n\n    # BFS Queue: (current_position, path_actions_to_reach_current_position)\n    q = collections.deque([(agent_pos, [])])\n    visited = {agent_pos}\n\n    found_path_actions = []\n\n    while q:\n        current_pos, current_path = q.popleft()\n        cx, cy = current_pos\n\n        # Check if we have reached a \"target\" state for collection\n        # Case 1: Primitive is grabbable. Target is the cell *containing* the primitive.\n        if is_primitive_grabbable:\n            if grid[cx, cy, primitive] > 0:\n                # Agent is on the cell containing the grabbable primitive. Collect it.\n                found_path_actions = current_path + [USE]\n                break # Path found, exit BFS\n\n        # Case 2: Primitive is a non-grabbable resource (e.g., water, stone) that can be collected.\n        # Target is a cell *adjacent* to the primitive.\n        elif is_primitive_resource_collectible_via_adj:\n            # Check if current_pos is adjacent to a cell containing the primitive resource\n            for dx, dy in move_deltas.values():\n                nx, ny = cx + dx, cy + dy\n                if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n                    if grid[nx, ny, primitive] > 0:\n                        # Agent is adjacent to the non-grabbable primitive resource. Use it.\n                        found_path_actions = current_path + [USE]\n                        break # Path found, break from neighbor loop\n            if found_path_actions:\n                break # Path found, break from BFS loop\n\n        # Explore neighbors\n        for action, (dx, dy) in move_deltas.items():\n            new_x, new_y = cx + dx, cy + dy\n            new_pos = (new_x, new_y)\n\n            if is_traversable(new_x, new_y) and new_pos not in visited:\n                visited.add(new_pos)\n                q.append((new_pos, current_path + [action]))\n    \n    return found_path_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:07:42.348880", "function_name": "collect", "function_body": "  import numpy as np\n\n  # Actions\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  actions = []\n  \n  MAX_COLLECT_STEPS = 200 \n\n  for _ in range(MAX_COLLECT_STEPS):\n      obs = env.observations()\n      current_inventory = obs['features_dict']['inventory']\n\n      if current_inventory[primitive] > 0:\n          break \n\n      current_pos = env._current_state.pos \n      \n      if env._current_state.next_to(primitive):\n          action_to_take = USE\n      else:\n          grid = obs['features_dict']['features_global']\n          \n          primitive_w_coords, primitive_h_coords = np.where(grid[:, :, primitive] > 0)\n\n          if len(primitive_w_coords) == 0:\n              break \n\n          min_dist = float('inf')\n          target_x, target_y = -1, -1\n\n          for i in range(len(primitive_w_coords)):\n              px, py = primitive_w_coords[i], primitive_h_coords[i]\n              dist = abs(px - current_pos[0]) + abs(py - current_pos[1])\n              if dist < min_dist:\n                  min_dist = dist\n                  target_x, target_y = px, py\n          \n          if current_pos[0] < target_x:\n              action_to_take = RIGHT\n          elif current_pos[0] > target_x:\n              action_to_take = LEFT\n          elif current_pos[1] < target_y:\n              action_to_take = DOWN\n          elif current_pos[1] > target_y:\n              action_to_take = UP\n          else:\n              break \n      \n      reward, done, _ = env.step(action_to_take)\n      actions.append(action_to_take)\n\n      if done:\n          break\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:07:42.418576", "function_name": "collect", "function_body": "    import numpy as np\n    from collections import deque\n\n    # Constants for direction vectors for (row, col)\n    # These map the integer direction ID to a (dr, dc) tuple for grid coordinates.\n    # CraftWorld typically uses: 0: East, 1: South, 2: West, 3: North.\n    # (row, col) indexing means row increases downwards (South), col increases rightwards (East).\n    _DIR_VECTORS = {\n        0: (0, 1),  # East: (row + 0, col + 1)\n        1: (1, 0),  # South: (row + 1, col + 0)\n        2: (0, -1), # West: (row + 0, col - 1)\n        3: (-1, 0)  # North: (row - 1, col + 0)\n    }\n\n    def _find_path_to_primitive_bfs(start_r, start_c, start_d, primitive_idx, grid, action_map):\n        \"\"\"\n        Performs a Breadth-First Search (BFS) to find the shortest path (sequence of actions)\n        to collect a specified primitive from the environment grid.\n\n        Args:\n            start_r (int): Agent's starting row.\n            start_c (int): Agent's starting column.\n            start_d (int): Agent's starting facing direction (0-3).\n            primitive_idx (int): The integer index of the primitive to collect.\n            grid (np.ndarray): The current grid layout (H, W, K).\n            action_map (dict): Mapping from action names (e.g., 'UP') to their integer codes.\n\n        Returns:\n            list[int]: A list of integer action codes representing the path to collect the\n                       primitive, or an empty list if no path is found.\n        \"\"\"\n        H, W, K = grid.shape\n        \n        # Extract numerical action codes from the provided action_map\n        UP = action_map['UP']\n        DOWN = action_map['DOWN']\n        LEFT = action_map['LEFT']\n        RIGHT = action_map['RIGHT']\n        USE = action_map['USE']\n\n        # Queue for BFS: stores (row, col, current_direction, path_taken)\n        q = deque([(start_r, start_c, start_d, [])])\n        # Set to keep track of visited states to avoid cycles and redundant exploration\n        visited = set([(start_r, start_c, start_d)])\n\n        # Pre-calculate all locations where the primitive exists on the grid for quick lookup\n        primitive_locs = []\n        for r_idx in range(H):\n            for c_idx in range(W):\n                # Assuming entities are represented by a '1' in their respective kind channel\n                if grid[r_idx, c_idx, primitive_idx] == 1:\n                    primitive_locs.append((r_idx, c_idx))\n        \n        if not primitive_locs:\n            return [] # The primitive is not found on the map, so no path exists.\n\n        while q:\n            r, c, d, path = q.popleft()\n\n            # Check if the current state allows for collecting the primitive with a 'USE' action.\n            # This means the agent must be adjacent to the primitive and facing it.\n            \n            # Calculate the cell directly in front of the agent based on its current direction.\n            dr, dc = _DIR_VECTORS[d]\n            target_r, target_c = r + dr, c + dc\n\n            # Check if the target cell is within grid boundaries\n            if 0 <= target_r < H and 0 <= target_c < W:\n                # Check if the target cell contains the primitive\n                if (target_r, target_c) in primitive_locs:\n                    # Found a primitive! Append the USE action and return the complete path.\n                    return path + [USE]\n\n            # Explore possible next states by applying movement actions.\n            # We assume that moving in a cardinal direction (UP, DOWN, LEFT, RIGHT)\n            # also updates the agent's internal facing direction to match the movement.\n            moves_and_new_dirs = [\n                (UP, r - 1, c, 3),   # Action: UP (move North), New Pos: (r-1, c), New Dir: North (3)\n                (DOWN, r + 1, c, 1), # Action: DOWN (move South), New Pos: (r+1, c), New Dir: South (1)\n                (LEFT, r, c - 1, 2), # Action: LEFT (move West), New Pos: (r, c-1), New Dir: West (2)\n                (RIGHT, r, c + 1, 0) # Action: RIGHT (move East), New Pos: (r, c+1), New Dir: East (0)\n            ]\n\n            for action, nr, nc, nd in moves_and_new_dirs:\n                # Check if the potential new position (nr, nc) is within grid boundaries\n                if 0 <= nr < H and 0 <= nc < W:\n                    # Check if this new state (position and direction) has not been visited yet\n                    if (nr, nc, nd) not in visited:\n                        visited.add((nr, nc, nd))\n                        # Add the new state to the queue with the updated path\n                        q.append((nr, nc, nd, path + [action]))\n        \n        return [] # No path found to reach and collect any primitive on the map\n\n    # --- End of helper function definition ---\n\n    # 1. Get the current state information from the environment.\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    \n    # Extract the full grid, agent's normalized position, and one-hot direction.\n    grid = features_dict['features_global']\n    norm_pos = features_dict['pos'] # Normalized position (e.g., [0.5, 0.5] for center)\n    one_hot_dir = features_dict['direction'] # One-hot encoded direction (e.g., [0,0,1,0] for West)\n\n    # Get grid dimensions (Height, Width, Number of Kinds)\n    H, W, K = grid.shape\n\n    # 2. Convert normalized agent position to integer grid coordinates.\n    # Assumes norm_pos[0] relates to row and norm_pos[1] to column, \n    # and positions are normalized by `pos_idx / dim_size`.\n    start_r = int(norm_pos[0] * H)\n    start_c = int(norm_pos[1] * W)\n    \n    # 3. Convert one-hot direction vector to a single integer direction ID (0-3).\n    start_d = np.argmax(one_hot_dir)\n\n    # 4. Get the action mapping dictionary from the environment to translate action names to codes.\n    action_map = env.action_specs()\n\n    # 5. Call the BFS helper to find the sequence of actions.\n    path_to_primitive = _find_path_to_primitive_bfs(\n        start_r, start_c, start_d, primitive, grid, action_map\n    )\n    \n    return path_to_primitive", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:09:13.857439", "function_name": "collect", "function_body": "    # Constants for actions (from problem description)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Constants for directions (N=0, E=1, S=2, W=3, commonly used in DMLab-like envs)\n    DIR_NORTH = 0\n    DIR_EAST = 1\n    DIR_SOUTH = 2\n    DIR_WEST = 3\n\n    # Mapping from action to (delta_row, delta_col, new_direction)\n    # Assumes moving with an action also sets the agent's facing direction to that cardinal direction.\n    _ACTION_MOVEMENT_MAP = {\n        ACTION_UP: (-1, 0, DIR_NORTH),    # Move North (row-1), face North\n        ACTION_RIGHT: (0, 1, DIR_EAST),   # Move East (col+1), face East\n        ACTION_DOWN: (1, 0, DIR_SOUTH),   # Move South (row+1), face South\n        ACTION_LEFT: (0, -1, DIR_WEST),   # Move West (col-1), face West\n    }\n\n    # Mapping from relative position of primitive to required agent direction to face it for USE action\n    _DELTA_TO_REQUIRED_DIR = {\n        (-1, 0): DIR_NORTH,  # Primitive is North of agent, agent must face North\n        (1, 0): DIR_SOUTH,   # Primitive is South of agent, agent must face South\n        (0, 1): DIR_EAST,    # Primitive is East of agent, agent must face East\n        (0, -1): DIR_WEST,   # Primitive is West of agent, agent must face West\n    }\n\n    # Get current observations from the environment\n    obs = env.observations()\n    current_grid = obs['features_dict']['features_global']\n    current_inventory = obs['features_dict']['inventory']\n\n    # If the primitive is already collected, no actions are needed\n    if current_inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions (Height, Width, Kinds)\n    HEIGHT, WIDTH, _ = current_grid.shape\n\n    # Denormalize current agent position (pos is (row_frac, col_frac))\n    current_pos_normalized = obs['features_dict']['pos']\n    current_r = int(round(current_pos_normalized[0] * (HEIGHT - 1)))\n    current_c = int(round(current_pos_normalized[1] * (WIDTH - 1)))\n\n    # Get current agent direction from one-hot encoding\n    current_d = np.argmax(obs['features_dict']['direction'])\n\n    # Get grabbable and non-grabbable (obstacle) indices from the world configuration\n    grabbable_indices = env.world.grabbable_indices\n    obstacle_indices = env.world.non_grabbable_indices\n\n    # Find all accessible locations of the target primitive on the grid\n    primitive_locations = []\n    for r_scan in range(HEIGHT):\n        for c_scan in range(WIDTH):\n            # Check if this cell contains the primitive AND if it's a grabbable primitive\n            if current_grid[r_scan, c_scan, primitive] == 1 and primitive in grabbable_indices:\n                primitive_locations.append((r_scan, c_scan))\n\n    if not primitive_locations:\n        # Primitive not found on the grid or is not grabbable, cannot collect\n        return []\n\n    # BFS (Breadth-First Search) to find the shortest path\n    # State in BFS: (row, col, direction)\n    # Queue stores: ((row, col, direction), path_to_this_state)\n    queue = collections.deque([((current_r, current_c, current_d), [])])\n    # Visited set to avoid redundant exploration and cycles\n    visited = set([(current_r, current_c, current_d)])\n\n    while queue:\n        (r, c, d), path = queue.popleft()\n\n        # Check if current agent position is adjacent to a primitive and facing it\n        # This means we are in a state from which we can immediately USE the primitive\n        for pr, pc in primitive_locations:\n            dr_to_prim, dc_to_prim = pr - r, pc - c # Vector from agent to primitive\n\n            # Check if adjacent (Manhattan distance of 1)\n            if (abs(dr_to_prim) == 1 and dc_to_prim == 0) or \\\n               (abs(dc_to_prim) == 1 and dr_to_prim == 0):\n                \n                # Check if the agent is facing the primitive\n                if (dr_to_prim, dc_to_prim) in _DELTA_TO_REQUIRED_DIR:\n                    required_dir = _DELTA_TO_REQUIRED_DIR[(dr_to_prim, dc_to_prim)]\n                    if d == required_dir:\n                        # Found a path to being in position to USE the primitive\n                        return path + [ACTION_USE]\n\n        # Explore possible movement actions from the current state\n        for action, (dr_move, dc_move, new_d) in _ACTION_MOVEMENT_MAP.items():\n            new_r, new_c = r + dr_move, c + dc_move\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= new_r < HEIGHT and 0 <= new_c < WIDTH):\n                continue\n\n            # Check if the new position is an obstacle\n            is_obstacle = False\n            # Iterate through all kinds that might be obstacles at the new cell\n            for k_idx in obstacle_indices:\n                if current_grid[new_r, new_c, k_idx] == 1:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n\n            # If the new state (position and direction) has not been visited, add it to the queue\n            new_state_tuple = (new_r, new_c, new_d)\n            if new_state_tuple not in visited:\n                visited.add(new_state_tuple)\n                queue.append((new_state_tuple, path + [action]))\n\n    # If the queue becomes empty and no path to collect the primitive was found\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:09:13.933253", "function_name": "collect", "function_body": "    # Get action constants from the environment\n    action_map = env.action_specs()\n    # Convert keys to uppercase for standard action names (e.g., 'UP', 'USE')\n    ACTIONS = {k.upper(): v for k, v in action_map.items()}\n\n    actions_taken = []\n    # Set a maximum number of simulated steps to prevent infinite loops\n    max_collect_steps = 200\n\n    # Get the integer index for the target primitive from the cookbook's index\n    # The `index` method will add the item to the cookbook's index if it's new\n    primitive_idx = env.world.cookbook.index.index(primitive)\n\n    # Start with the current state of the environment.\n    # We will simulate steps on this `current_state` object to generate the plan.\n    current_state = env._current_state \n\n    # 1. Check if the primitive is already in the inventory at the start\n    if current_state.satisfies(\"goal_name_placeholder\", primitive_idx):\n        return []\n\n    # Get properties of the egocentric view once for calculations\n    # Assuming the agent is located at the center of the egocentric view\n    obs_dict_initial = current_state.features_dict()\n    features_ego_sample = obs_dict_initial['features_ego']\n    ego_height, ego_width, _ = features_ego_sample.shape\n    agent_ego_r, agent_ego_c = ego_height // 2, ego_width // 2 # Agent's assumed position in the egocentric view\n\n    # Loop to generate actions until the primitive is collected or max steps are reached\n    for _step_count in range(max_collect_steps):\n        # 2. Re-check if the primitive is now in inventory after a simulated action\n        if current_state.satisfies(\"goal_name_placeholder\", primitive_idx):\n            break # Goal achieved\n\n        # 3. Check if the primitive is in the agent's immediate 3x3 neighborhood\n        # If so, append a 'USE' action\n        if current_state.next_to(primitive_idx):\n            actions_taken.append(ACTIONS['USE'])\n            # Assuming 'USE' successfully collects the primitive if `next_to` is true.\n            # The next loop iteration will confirm by checking `satisfies()`.\n            break \n            \n        # 4. If not next to, try to move towards the primitive if it's visible\n        obs_dict = current_state.features_dict()\n        features_ego = obs_dict['features_ego']\n        \n        # Find all locations of the primitive within the egocentric view\n        # `np.argwhere` returns (row, col) coordinates where the primitive is present\n        primitive_locations = np.argwhere(features_ego[:, :, primitive_idx] == 1)\n\n        best_move_action = None\n        min_dist = float('inf')\n\n        if len(primitive_locations) > 0:\n            # If primitives are visible, find the closest one (Manhattan distance)\n            closest_pr_coords = None\n            for r, c in primitive_locations:\n                dist = abs(r - agent_ego_r) + abs(c - agent_ego_c)\n                if dist < min_dist:\n                    min_dist = dist\n                    closest_pr_coords = (r, c)\n            \n            if closest_pr_coords:\n                pr_r, pr_c = closest_pr_coords\n                dr = pr_r - agent_ego_r # Delta row (negative means primitive is 'up')\n                dc = pr_c - agent_ego_c # Delta col (negative means primitive is 'left')\n\n                # Prioritize movement along the dimension where the primitive is further away\n                if abs(dr) > abs(dc):\n                    if dr < 0: # Primitive is above agent\n                        best_move_action = ACTIONS['UP']\n                    else: # Primitive is below agent\n                        best_move_action = ACTIONS['DOWN']\n                else:\n                    # Primitive is to the side, or equidistant in both dimensions\n                    if dc < 0: # Primitive is left of agent\n                        best_move_action = ACTIONS['LEFT']\n                    else: # Primitive is right of agent\n                        best_move_action = ACTIONS['RIGHT']\n        \n        # Add the chosen action to the list and simulate the step\n        if best_move_action is not None:\n            actions_taken.append(best_move_action)\n            # Simulate the step using the CraftState's `step` method, which returns a new state\n            _reward, new_state = current_state.step(best_move_action)\n            current_state = new_state # Update the state for the next iteration of planning\n        else:\n            # 5. Primitive is not visible in egocentric view and not next to the agent.\n            # Implement a basic exploration strategy: take a random directional move.\n            # More advanced strategies (e.g., wall-following, spiral search) would be more complex.\n            possible_exploration_actions = [\n                ACTIONS['UP'], ACTIONS['DOWN'], ACTIONS['LEFT'], ACTIONS['RIGHT']\n            ]\n            chosen_action = np.random.choice(possible_exploration_actions)\n            actions_taken.append(chosen_action)\n            _reward, new_state = current_state.step(chosen_action)\n            current_state = new_state\n            \n    return actions_taken", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:10:22.769187", "function_name": "collect", "function_body": "    # Define action deltas for (row, col) coordinates\n    _DELTA_RC = {\n        0: (1, 0),   # DOWN (corresponds to A.DOWN)\n        1: (-1, 0),  # UP (corresponds to A.UP)\n        2: (0, -1),  # LEFT (corresponds to A.LEFT)\n        3: (0, 1)    # RIGHT (corresponds to A.RIGHT)\n    }\n    USE_ACTION = 4 # Corresponds to A.USE\n\n    state = env._current_state\n    actions_list = []\n\n    # 1. Check if the primitive is already in the inventory\n    if state.inventory[primitive] > 0:\n        return []\n\n    # 2. Check if the agent is already next to the primitive\n    if state.next_to(primitive):\n        actions_list.append(USE_ACTION)\n        return actions_list\n\n    # 3. Locate all cells containing the primitive\n    grid = state.grid\n    height, width, _ = grid.shape\n    primitive_locations = []\n    for r in range(height):\n        for c in range(width):\n            if grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        # Primitive not found anywhere in the grid\n        return []\n\n    # 4. Define target adjacent cells for BFS\n    # These are cells (r, c) from which the agent can perform a USE action\n    # on a primitive (i.e., a cell adjacent to a primitive location).\n    target_adj_cells = set()\n    for pr, pc in primitive_locations:\n        for dr, dc in _DELTA_RC.values(): # Iterate over possible movement deltas\n            ar, ac = pr + dr, pc + dc  # Adjacent row, col\n            # Ensure adjacent cell is within grid bounds\n            if 0 <= ar < height and 0 <= ac < width:\n                target_adj_cells.add((ar, ac))\n\n    # 5. Perform Breadth-First Search (BFS) to find the shortest path\n    # to any target_adj_cell.\n    # q: A list used as a queue for BFS, storing (current_pos, path_so_far)\n    q = [(state.pos, [])]\n    # visited: A set to keep track of visited positions to avoid cycles and redundant checks\n    visited = {state.pos}\n    head = 0 # Pointer to simulate deque.popleft() for the list-based queue\n\n    while head < len(q):\n        (r, c), path = q[head]\n        head += 1\n\n        # If the current position is one of the target adjacent cells,\n        # we have found the shortest path to a position next to the primitive.\n        if (r, c) in target_adj_cells:\n            return path + [USE_ACTION] # Append the USE action and return the path\n\n        # Explore neighbors\n        for action_val, (dr, dc) in _DELTA_RC.items():\n            nr, nc = r + dr, c + dc # Calculate the next position\n\n            # Check if the next position is within grid bounds and has not been visited\n            if 0 <= nr < height and 0 <= nc < width and (nr, nc) not in visited:\n                # Check if the next position is an obstacle\n                is_obstacle = False\n                for k_idx in range(env.world.n_kinds):\n                    if grid[nr, nc, k_idx] > 0: # If this kind is present at (nr, nc)\n                        if k_idx == env.world.water_index: # Water typically blocks movement\n                            is_obstacle = True\n                            break\n                        # If it's a non-grabbable item and not a workshop (which might be walkable)\n                        if k_idx in env.world.non_grabbable_indices and k_idx not in env.world.workshop_indices:\n                            is_obstacle = True\n                            break\n                \n                if not is_obstacle:\n                    visited.add((nr, nc))\n                    q.append(((nr, nc), path + [action_val]))\n\n    # If the BFS completes and no path to a target_adj_cell is found,\n    # the primitive is unreachable.\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:10:22.839941", "function_name": "collect", "function_body": "    # Get action mappings from the environment\n    action_map = env.action_specs()\n    # E.g., {'DOWN': 0, 'UP': 1, 'LEFT': 2, 'RIGHT': 3, 'USE': 4}\n\n    actions_taken = []\n    # Reset the environment to ensure a fresh start and get initial state.\n    # The returned observation dict is not directly used for planning here,\n    # but it ensures env._current_state is properly set.\n    _ = env.reset() \n\n    MAX_STEPS = 1000 # Safety limit to prevent infinite loops\n\n    for _ in range(MAX_STEPS):\n        current_state = env._current_state\n\n        # Check if primitive is already in inventory\n        if current_state.inventory[primitive] > 0:\n            return actions_taken\n\n        # Check if primitive is next to the agent (within 3x3 neighborhood)\n        if current_state.next_to(primitive):\n            env.step(action_map['USE'])\n            actions_taken.append(action_map['USE'])\n            # After 'USE', the item might be collected. Loop will re-check inventory.\n            continue # Go to next iteration to re-evaluate state\n\n        # Get current agent position and the full grid\n        agent_pos = current_state.pos\n        grid = current_state.grid # Grid shape: (WIDTH, HEIGHT, n_kinds)\n\n        # Find all locations of the primitive on the grid\n        # np.argwhere returns (row, col) for each non-zero element\n        primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n        chosen_action = None\n        if len(primitive_locations) > 0:\n            # Find the closest primitive location using Manhattan distance\n            closest_loc = None\n            min_dist = float('inf')\n\n            for loc in primitive_locations:\n                # loc is (row, col), agent_pos is (row, col)\n                dist = abs(loc[0] - agent_pos[0]) + abs(loc[1] - agent_pos[1])\n                if dist < min_dist:\n                    min_dist = dist\n                    closest_loc = loc\n\n            # Determine movement towards the closest primitive\n            # dx is change in row, dy is change in col\n            dx = closest_loc[0] - agent_pos[0]\n            dy = closest_loc[1] - agent_pos[1]\n\n            # Prioritize moving along the axis with the larger difference\n            if abs(dx) > abs(dy): \n                if dx > 0: # Target is below agent (higher row index)\n                    chosen_action = action_map['DOWN']\n                elif dx < 0: # Target is above agent (lower row index)\n                    chosen_action = action_map['UP']\n            else: # Prioritize horizontal movement if larger difference or equal\n                if dy > 0: # Target is to the right of agent (higher col index)\n                    chosen_action = action_map['RIGHT']\n                elif dy < 0: # Target is to the left of agent (lower col index)\n                    chosen_action = action_map['LEFT']\n            \n            # If dx and dy are both 0, chosen_action remains None.\n            # This implies the agent is exactly on the target.\n            # In this case, 'next_to' should have triggered 'USE'.\n            # If not, the loop will continue to re-evaluate the state.\n\n        if chosen_action is not None:\n            # Apply the chosen movement action\n            env.step(chosen_action)\n            actions_taken.append(chosen_action)\n        else:\n            # If no primitive is found on the grid, or the agent is stuck\n            # (e.g., dx=0, dy=0 and 'next_to' somehow didn't resolve),\n            # perform a simple explorative move.\n            movement_actions = [action_map['DOWN'], action_map['UP'],\n                                action_map['LEFT'], action_map['RIGHT']]\n            random_move = np.random.choice(movement_actions)\n            env.step(random_move)\n            actions_taken.append(random_move)\n\n    # If MAX_STEPS reached and primitive not collected, return empty list\n    # This indicates failure to collect within the step limit.\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:12:19.342687", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Define action constants inside the function for self-containment\n  _ACTIONS = env_factory.action_map\n  DOWN, UP, LEFT, RIGHT, USE = _ACTIONS['down'], _ACTIONS['up'], _ACTIONS['left'], _ACTIONS['right'], _ACTIONS['use']\n\n  # Action deltas (dr, dc) for movement actions\n  ACTION_DELTAS = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1),\n  }\n\n  world = env._current_state.world\n  grid = env._current_state.grid\n  r0, c0 = env._current_state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 1. Check if the primitive is already in the inventory\n  if env._current_state.inventory[primitive] > 0:\n      return []\n\n  # 2. Determine walkable cells on the grid\n  # Agent cannot walk on certain non-grabbable items (e.g., walls, lava).\n  # Workshops are non-grabbable but agents can stand on them to craft.\n  # So, exclude workshop indices from the non-walkable set.\n  non_walkable_terrain_indices = set(world.non_grabbable_indices) - set(world.workshop_indices)\n\n  walkable_mask = np.ones((WIDTH, HEIGHT), dtype=bool)\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # A cell is non-walkable if it contains any entity from the non_walkable_terrain_indices set\n          if any(grid[r, c, idx] > 0 for idx in non_walkable_terrain_indices):\n              walkable_mask[r, c] = False\n\n  # Ensure the agent's starting position is marked walkable (it should always be)\n  walkable_mask[r0, c0] = True\n\n  # 3. Find all grid cells containing the primitive\n  primitive_cells_on_grid = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          if grid[r, c, primitive] > 0:\n              primitive_cells_on_grid.append((r, c))\n\n  # If the primitive is not found on the grid, it cannot be collected.\n  if not primitive_cells_on_grid:\n      return []\n\n  # 4. Determine the target collection points based on whether the primitive is grabbable\n  is_grabbable_primitive = primitive in world.grabbable_indices\n  target_collection_points = set()\n\n  if is_grabbable_primitive:\n      # For grabbable primitives (e.g., wood), the agent must move onto the cell\n      # containing the primitive and then USE.\n      for pr, pc in primitive_cells_on_grid:\n          if walkable_mask[pr, pc]: # Only if the primitive's cell itself is walkable\n              target_collection_points.add((pr, pc))\n  else:\n      # For non-grabbable primitives (e.g., water, stone), the agent must move\n      # to a cell adjacent to the primitive and then USE.\n      for pr, pc in primitive_cells_on_grid:\n          # Check 4 direct neighbors (up, down, left, right)\n          for dr, dc in ACTION_DELTAS.values():\n              nr, nc = pr + dr, pc + dc\n              # Ensure neighbor is within grid bounds and is walkable\n              if 0 <= nr < WIDTH and 0 <= nc < HEIGHT and walkable_mask[nr, nc]:\n                  target_collection_points.add((nr, nc))\n\n  # If no walkable target collection points are found, return empty path\n  if not target_collection_points:\n      return []\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples: (current_row, current_col, list_of_actions_taken_to_reach_here)\n  queue = deque([(r0, c0, [])])\n  # Visited set stores (row, col) to prevent cycles and redundant exploration\n  visited = set([(r0, c0)])\n\n  while queue:\n      curr_r, curr_c, path = queue.popleft()\n\n      # If the current position is one of the target collection points, we found the path\n      if (curr_r, curr_c) in target_collection_points:\n          # The final action to collect is USE\n          return path + [USE]\n\n      # Explore all possible movement actions from the current position\n      for action, (dr, dc) in ACTION_DELTAS.items():\n          next_r, next_c = curr_r + dr, curr_c + dc\n\n          # Check if the next cell is within grid bounds and is walkable\n          if 0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and walkable_mask[next_r, next_c]:\n              # If this cell has not been visited yet, add it to the queue\n              if (next_r, next_c) not in visited:\n                  visited.add((next_r, next_c))\n                  queue.append((next_r, next_c, path + [action]))\n\n  # If the queue becomes empty and no path to a target collection point was found\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:12:20.307287", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:13:42.459743", "function_name": "collect", "function_body": "  import collections # Ensure collections is available\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Mapping from a movement action_id to the resulting change in coordinates (dx, dy).\n  # (0,0) is top-left. positive X is right, positive Y is down.\n  # Note: The agent's direction changes upon movement, but for this version,\n  # we assume _USE collects items on the current square, so direction isn't critical\n  # for the final _USE action, only for pathfinding.\n  action_to_delta = {\n      _DOWN: (0, 1),   # Move Down (positive Y)\n      _UP: (0, -1),    # Move Up (negative Y)\n      _LEFT: (-1, 0),  # Move Left (negative X)\n      _RIGHT: (1, 0),  # Move Right (positive X)\n  }\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Identify non-grabbable items that act as obstacles (cannot be moved into)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle) that blocks movement.\"\"\"\n    if not non_grabbable_items_set: # Optimization: if set is empty, no obstacles can exist.\n        return False\n    # Check if any non-grabbable item is present at (x,y)\n    for k_idx in non_grabbable_items_set:\n      if grid[x, y, k_idx] == 1:\n        return True\n    return False\n\n  # Use Breadth-First Search (BFS) to find the shortest path to the primitive.\n  # This version assumes the _USE action collects the primitive if the agent is on the same square.\n  # Queue stores tuples: (current_x, current_y, [path_actions_to_reach_here])\n  q = collections.deque()\n  q.append((current_px, current_py, []))\n  \n  # Set to store visited states to avoid cycles and re-processing longer paths.\n  # A state is defined by (x, y) because direction is not a factor for picking up on the current square.\n  visited = {(current_px, current_py)}\n\n  while q:\n    cx, cy, c_path = q.popleft()\n\n    # 1. Check if the primitive is at the current location\n    if current_grid[cx, cy, primitive] == 1:\n      # If the primitive is at the current cell, we've found a path.\n      # The final action is to _USE.\n      return c_path + [_USE]\n\n    # 2. Explore movement actions (UP, DOWN, LEFT, RIGHT)\n    for action_id, (dx, dy) in action_to_delta.items():\n      nx, ny = cx + dx, cy + dy\n\n      # Check boundaries for the new position\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if the new cell is an obstacle\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n\n      # If this new position has not been visited\n      if (nx, ny) not in visited:\n        new_path = c_path + [action_id]\n        q.append((nx, ny, new_path))\n        visited.add((nx, ny))\n  \n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T22:13:43.468623", "function_name": "collect", "function_body": "  import collections\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Define internal direction indices based on the order in features_dict['direction']\n  # and action_specs: [DOWN, UP, LEFT, RIGHT]\n  _DIR_DOWN = 0\n  _DIR_UP = 1\n  _DIR_LEFT = 2\n  _DIR_RIGHT = 3\n\n  # Mapping from a movement action_id to the resulting agent facing direction.\n  # Taking action _UP makes the agent face _DIR_UP.\n  action_to_new_dir = {\n      _UP: _DIR_UP,\n      _DOWN: _DIR_DOWN,\n      _LEFT: _DIR_LEFT,\n      _RIGHT: _DIR_RIGHT,\n  }\n\n  # Mapping from internal direction integer to (dx, dy) for the cell *moved into* by that direction.\n  # (0,0) is top-left. positive X is right, positive Y is down.\n  # This mapping describes the delta of the agent's position when it moves in that direction.\n  dir_to_delta = {\n      _DIR_DOWN: (0, 1),   # Agent moves down: Y increases by 1\n      _DIR_UP: (0, -1),    # Agent moves up: Y decreases by 1\n      _DIR_LEFT: (-1, 0),  # Agent moves left: X decreases by 1\n      _DIR_RIGHT: (1, 0),  # Agent moves right: X increases by 1\n  }\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario (or current grid shape)\n  WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n\n  # Convert one-hot initial direction from features_dict to an integer index\n  initial_dir_idx = np.argmax(features_dict['direction'])\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Identify non-grabbable items that act as obstacles (cannot be moved into)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle) that blocks movement.\"\"\"\n    if not non_grabbable_items_set: # Optimization: if set is empty, no obstacles can exist.\n        return False\n    # Check if the cell contains *any* non-grabbable item that is an obstacle\n    for k_idx in non_grabbable_items_set:\n      if grid[x, y, k_idx] == 1:\n        return True\n    return False\n\n  # Use Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples: (current_x, current_y, current_direction_idx, [path_actions_to_reach_here])\n  q = collections.deque()\n  q.append((current_px, current_py, initial_dir_idx, []))\n  \n  # Set to store visited states to avoid cycles and re-processing longer paths.\n  # A state is defined by (x, y, direction_idx).\n  visited = {(current_px, current_py, initial_dir_idx)}\n\n  while q:\n    cx, cy, c_dir_idx, c_path = q.popleft()\n\n    # 1. Check if the primitive can be collected from the current state (position)\n    # The _USE action for grabbable items applies to the agent's current square.\n    if current_grid[cx, cy, primitive] == 1:\n      # If the primitive is at the current agent's position, we found a solution!\n      return c_path + [_USE]\n\n    # 2. Explore movement actions (UP, DOWN, LEFT, RIGHT)\n    # Each movement action updates both position and facing direction.\n    for action_id, new_dir_idx in action_to_new_dir.items():\n      # Calculate new position: the agent moves one step in the direction implied by the action.\n      # The `dir_to_delta` mapping tells us the (dx, dy) for moving in a given direction.\n      move_dx, move_dy = dir_to_delta[new_dir_idx] # new_dir_idx is the direction after the move\n      nx, ny = cx + move_dx, cy + move_dy\n\n      # Check boundaries for the new position\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if the new cell is an obstacle\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n\n      # If this new state (position and direction) has not been visited\n      if (nx, ny, new_dir_idx) not in visited:\n        new_path = c_path + [action_id]\n        q.append((nx, ny, new_dir_idx, new_path))\n        visited.add((nx, ny, new_dir_idx))\n  \n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T22:14:58.861638", "function_name": "collect", "function_body": "    actions_list = []\n\n    # Get action mappings from the environment\n    action_map = env.action_specs()\n    A_DOWN = action_map['DOWN']\n    A_UP = action_map['UP']\n    A_LEFT = action_map['LEFT']\n    A_RIGHT = action_map['RIGHT']\n    A_USE = action_map['USE']\n\n    # Get the current state from the environment.\n    # We assume the environment has been properly initialized (e.g., by an initial env.reset() call).\n    current_state = env._current_state  # CraftState instance\n\n    # Set a maximum number of steps for this collection task to prevent infinite loops.\n    # This will be either the environment's total max_steps or a default value.\n    max_steps_for_collection = env.max_steps if hasattr(env, 'max_steps') and env.max_steps is not None else 1000\n    steps_taken_for_collection = 0\n\n    while True:\n        # 1. Check if the goal is satisfied (primitive collected)\n        if current_state.inventory[primitive] > 0:\n            break  # Goal achieved\n\n        # 2. Check if the step limit for this collection task has been reached\n        if steps_taken_for_collection >= max_steps_for_collection:\n            # print(f\"Warning: collect_v2 reached step limit ({max_steps_for_collection}) before collecting primitive {primitive}.\")\n            break  # Failed to collect within limit\n\n        # 3. Check if the agent is next to the primitive\n        if current_state.next_to(primitive):\n            action_to_take = A_USE\n        else:\n            # 4. If not next to, find the closest primitive and determine movement\n            primitive_locations = []\n            grid = current_state.grid\n            n_kinds = grid.shape[2]  # Number of kinds available in the grid\n\n            # Ensure the primitive index is valid for the grid's kinds\n            if primitive >= n_kinds:\n                # print(f\"Error: Primitive index {primitive} is out of bounds for grid with {n_kinds} kinds.\")\n                return actions_list  # Cannot find or collect an invalid primitive\n\n            # Search the entire grid for instances of the primitive\n            for x_coord in range(grid.shape[0]):\n                for y_coord in range(grid.shape[1]):\n                    if grid[x_coord, y_coord, primitive] > 0:\n                        primitive_locations.append((x_coord, y_coord))\n\n            if not primitive_locations:\n                # print(f\"Warning: Primitive {primitive} not found on the grid.\")\n                break  # Cannot collect if the primitive is not present on the map\n\n            agent_x, agent_y = current_state.pos\n            min_dist = float('inf')\n            nearest_primitive_pos = None\n\n            # Find the primitive location closest to the agent using Manhattan distance\n            for p_x, p_y in primitive_locations:\n                dist = abs(p_x - agent_x) + abs(p_y - agent_y)\n                if dist < min_dist:\n                    min_dist = dist\n                    nearest_primitive_pos = (p_x, p_y)\n\n            if nearest_primitive_pos is None:\n                # This case should ideally not be reached if primitive_locations is not empty.\n                # print(f\"Error: Could not determine nearest primitive position despite locations being found.\")\n                break\n\n            target_x, target_y = nearest_primitive_pos\n\n            # Determine the next movement action to move closer to the target\n            dx = target_x - agent_x\n            dy = target_y - agent_y\n\n            if dx == 0 and dy == 0:\n                # Agent is already on the same tile as the primitive.\n                # If `next_to` didn't trigger `USE`, it implies it might not include the current cell\n                # or the primitive is un-usable on this tile (unlikely for a primitive).\n                # As a fallback, try to USE if not collected, otherwise, break.\n                if current_state.inventory[primitive] == 0:\n                    action_to_take = A_USE\n                else: # Already collected, should have broken earlier by inventory check\n                    break\n            elif abs(dx) > abs(dy):\n                # Prioritize horizontal movement if the horizontal distance is greater or equal\n                if dx > 0:\n                    action_to_take = A_RIGHT\n                else:\n                    action_to_take = A_LEFT\n            else:  # abs(dy) >= abs(dx)\n                # Prioritize vertical movement\n                if dy > 0:\n                    action_to_take = A_DOWN\n                else:\n                    action_to_take = A_UP\n            \n        # 5. Take the determined action\n        actions_list.append(action_to_take)\n        reward, done, obs = env.step(action_to_take)\n        steps_taken_for_collection += 1\n        \n        # Update current_state for the next iteration based on the new environment state\n        current_state = env._current_state\n\n        # If the environment signals 'done', stop processing this episode\n        if done:\n            break\n\n    return actions_list", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:14:59.830074", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants for clarity\n  # These map to the integer actions expected by CraftLab.step()\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Get the current state from the environment\n  # The CraftLab class has _current_state as a CraftState instance\n  state = env._current_state\n\n  # 1. Check if the primitive is already in the inventory\n  if state.inventory[primitive] > 0:\n    return [] # Already collected, no actions needed\n\n  # Get relevant state information\n  grid = state.grid\n  agent_pos = state.pos\n  \n  # Grid dimensions (grid shape is typically (WIDTH, HEIGHT, n_kinds))\n  WIDTH, HEIGHT, _ = grid.shape \n\n  # 2. Find all locations on the grid where the primitive exists\n  primitive_locations = []\n  for r in range(WIDTH):\n    for c in range(HEIGHT):\n      if grid[r, c, primitive] == 1:\n        primitive_locations.append((r, c))\n\n  # If the primitive is not found anywhere on the map, we cannot collect it.\n  if not primitive_locations:\n    return []\n\n  # 3. Use Breadth-First Search (BFS) to find the shortest sequence of actions\n  #    to reach any primitive location.\n  # The queue stores tuples: (current_position, list_of_actions_taken_to_reach_here)\n  q = collections.deque([(agent_pos, [])])\n  \n  # Set to keep track of visited positions to avoid cycles and re-processing\n  visited = {agent_pos}\n\n  actions_to_target = []\n  target_found = False\n\n  while q:\n    curr_pos, current_actions = q.popleft()\n    r, c = curr_pos\n\n    # If the current position is one of the primitive locations, we found our target\n    if curr_pos in primitive_locations:\n      actions_to_target = current_actions\n      target_found = True\n      break # Found the shortest path to one of the primitives\n\n    # Define possible moves and their corresponding actions\n    # (delta_row, delta_col, action_to_take_to_move_there)\n    # Assumes (0,0) is top-left, rows increase downwards, cols increase rightwards\n    possible_moves = [\n        (-1, 0, ACTION_UP),    # Move Up (decrease row)\n        (1, 0, ACTION_DOWN),   # Move Down (increase row)\n        (0, -1, ACTION_LEFT),  # Move Left (decrease column)\n        (0, 1, ACTION_RIGHT)   # Move Right (increase column)\n    ]\n\n    for dr, dc, action_to_move in possible_moves:\n      next_r, next_c = r + dr, c + dc\n      next_pos = (next_r, next_c)\n\n      # Check if the next position is within grid boundaries and has not been visited\n      if 0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and next_pos not in visited:\n        # Assuming all grid cells are traversable for movement (no specific obstacles in problem description)\n        visited.add(next_pos)\n        q.append((next_pos, current_actions + [action_to_move]))\n\n  # If no path was found to any primitive location after BFS\n  if not target_found:\n    return []\n\n  # 4. After navigating to the primitive's location, append the USE action\n  #    to collect it.\n  return actions_to_target + [ACTION_USE]", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:16:30.882282", "function_name": "collect", "function_body": "  import numpy as np\n  import collections\n\n  # Action constants matching CraftLab's action_specs mapping\n  DOWN_ACTION = 0  # Move backward relative to current direction\n  UP_ACTION = 1    # Move forward relative to current direction\n  LEFT_ACTION = 2  # Turn 90 degrees left (counter-clockwise)\n  RIGHT_ACTION = 3 # Turn 90 degrees right (clockwise)\n  USE_ACTION = 4   # Interact with object in front\n\n  # Agent's facing direction constants (matching CraftState.dir, 0:North, 1:East, etc.)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper mapping directions to (dx, dy) deltas\n  # These deltas represent a unit step \"forward\" for an agent facing that direction.\n  DIR_TO_DELTA = {\n      NORTH_DIR: (0, -1),  # North is typically decreasing Y\n      EAST_DIR: (1, 0),    # East is increasing X\n      SOUTH_DIR: (0, 1),   # South is increasing Y\n      WEST_DIR: (-1, 0),   # West is decreasing X\n  }\n\n  primitive_id = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n  agent_grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir # Agent's initial facing direction\n\n  grid_height, grid_width, _ = agent_grid.shape\n\n  # Define all indices that represent obstacles for agent movement.\n  # This includes non-grabbable items, workshop locations, and the primitive itself,\n  # as the agent cannot move onto the cell occupied by the primitive it intends to collect.\n  impassable_indices = set()\n  impassable_indices.update(env.world.non_grabbable_indices)\n  impassable_indices.update(env.world.workshop_indices)\n  impassable_indices.add(primitive_id) \n\n  def is_cell_traversable(x, y):\n    \"\"\"Checks if a given grid cell (x, y) is within bounds and traversable.\"\"\"\n    # First, check if coordinates are within grid boundaries\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Then, check if the cell is occupied by any impassable item\n    for kind_idx in impassable_indices:\n      if agent_grid[y, x, kind_idx] == 1: # Assuming '1' indicates presence of the item\n        return False\n    return True # Cell is traversable if it passes all checks\n\n  # Find all existing locations of the primitive on the grid\n  primitive_locations = set() # Stores (x, y) coordinates of primitive instances\n  y_coords, x_coords = np.where(agent_grid[:, :, primitive_id] == 1)\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n  \n  if not primitive_locations:\n    return [] # If the primitive is not found on the grid, no actions can collect it\n\n  # Identify all possible \"goal\" states for the BFS.\n  # A goal state is an (x, y, direction) tuple where the agent is adjacent to a primitive\n  # and is correctly facing it, ready to execute a USE_ACTION.\n  goal_bfs_states = set() \n\n  # Cardinal directions to check for adjacency (North, East, South, West)\n  CARDINAL_ADJACENCY_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n\n  for px, py in primitive_locations: # For each instance of the primitive\n    for dx_adj, dy_adj in CARDINAL_ADJACENCY_DELTAS: # Check its four cardinal neighbors\n      adj_x, adj_y = px + dx_adj, py + dy_adj # A potential adjacent cell from which to collect\n\n      if is_cell_traversable(adj_x, adj_y):\n        # Calculate the required facing direction from (adj_x, adj_y) to (px, py)\n        # This is essentially (primitive_x - adjacent_agent_x, primitive_y - adjacent_agent_y)\n        target_face_dx = px - adj_x\n        target_face_dy = py - adj_y\n\n        # Determine the exact direction (NORTH, EAST, SOUTH, WEST) corresponding to this delta\n        required_facing_dir = None\n        for direction_val, (delta_x, delta_y) in DIR_TO_DELTA.items():\n          if delta_x == target_face_dx and delta_y == target_face_dy:\n            required_facing_dir = direction_val\n            break\n        \n        # If a valid facing direction is found, add this (position, direction) as a goal state\n        if required_facing_dir is not None:\n          goal_bfs_states.add((adj_x, adj_y, required_facing_dir))\n\n  if not goal_bfs_states:\n    # No valid adjacent positions exist from which the primitive can be collected\n    # (e.g., the primitive might be completely surrounded by impassable objects).\n    return [] \n\n  # Perform Breadth-First Search (BFS) to find the shortest action sequence.\n  # The state in our BFS is (agent_x, agent_y, agent_direction).\n  # Queue elements: (current_x, current_y, current_dir, list_of_actions_taken_to_reach_here)\n  queue = collections.deque([(agent_pos_x, agent_pos_y, agent_dir, [])])\n  # Visited set: Stores (x, y, dir) tuples to prevent cycles and redundant exploration.\n  visited = set([(agent_pos_x, agent_pos_y, agent_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, current_path = queue.popleft()\n\n    # If the current state is one of our predefined goal states, we've found the shortest path.\n    if (curr_x, curr_y, curr_dir) in goal_bfs_states:\n      return current_path + [USE_ACTION] # Append USE_ACTION and return the complete path\n\n    # Explore all possible next actions from the current state:\n    # Move Forward (UP_ACTION), Move Backward (DOWN_ACTION), Turn Left (LEFT_ACTION), Turn Right (RIGHT_ACTION)\n    \n    # 1. Try Move Forward (UP_ACTION)\n    # Agent moves one step in its current facing direction. The agent's direction does not change.\n    fwd_dx, fwd_dy = DIR_TO_DELTA[curr_dir]\n    next_x_fwd, next_y_fwd = curr_x + fwd_dx, curr_y + fwd_dy\n    \n    if is_cell_traversable(next_x_fwd, next_y_fwd):\n      next_state_fwd = (next_x_fwd, next_y_fwd, curr_dir)\n      if next_state_fwd not in visited:\n        visited.add(next_state_fwd)\n        queue.append((next_x_fwd, next_y_fwd, curr_dir, current_path + [UP_ACTION]))\n\n    # 2. Try Move Backward (DOWN_ACTION)\n    # Agent moves one step in the opposite direction of its current facing. The agent's direction does not change.\n    bwd_dx, bwd_dy = DIR_TO_DELTA[(curr_dir + 2) % 4] # Calculate delta for opposite direction\n    next_x_bwd, next_y_bwd = curr_x + bwd_dx, curr_y + bwd_dy\n    \n    if is_cell_traversable(next_x_bwd, next_y_bwd):\n      next_state_bwd = (next_x_bwd, next_y_bwd, curr_dir)\n      if next_state_bwd not in visited:\n        visited.add(next_state_bwd)\n        queue.append((next_x_bwd, next_y_bwd, curr_dir, current_path + [DOWN_ACTION]))\n\n    # 3. Try Turn Left (LEFT_ACTION)\n    # Agent turns 90 degrees left. Its position remains unchanged.\n    next_dir_left = (curr_dir - 1 + 4) % 4 # Ensure direction stays within [0, 3]\n    next_state_left = (curr_x, curr_y, next_dir_left)\n    if next_state_left not in visited:\n      visited.add(next_state_left)\n      queue.append((curr_x, curr_y, next_dir_left, current_path + [LEFT_ACTION]))\n\n    # 4. Try Turn Right (RIGHT_ACTION)\n    # Agent turns 90 degrees right. Its position remains unchanged.\n    next_dir_right = (curr_dir + 1) % 4 # Ensure direction stays within [0, 3]\n    next_state_right = (curr_x, curr_y, next_dir_right)\n    if next_state_right not in visited:\n      visited.add(next_state_right)\n      queue.append((curr_x, curr_y, next_dir_right, current_path + [RIGHT_ACTION]))\n      \n  return [] # If the BFS queue is exhausted and no path to a goal state was found", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T22:16:31.834270", "function_name": "collect", "function_body": "  import numpy as np\n  import collections\n\n  # Define CraftLab action constants based on typical DMLab-style relative movements\n  # (as opposed to cardinal grid movements).\n  MOVE_BACKWARD_ACTION = 0 # Agent moves one step backward relative to its facing direction\n  MOVE_FORWARD_ACTION = 1  # Agent moves one step forward relative to its facing direction\n  TURN_LEFT_ACTION = 2     # Agent turns 90 degrees left (counter-clockwise)\n  TURN_RIGHT_ACTION = 3    # Agent turns 90 degrees right (clockwise)\n  USE_ACTION = 4           # Agent interacts with the object it is facing\n\n  # Agent's facing directions (integers 0-3) consistent with CraftWorld/CraftState\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Map directions to (dx, dy) deltas for movement on a grid where Y increases downwards (numpy array indexing)\n  _DIR_TO_DELTA = {\n      NORTH_DIR: (0, -1),  # Moving North (forward when facing North) means decreasing Y\n      EAST_DIR: (1, 0),    # Moving East (forward when facing East) means increasing X\n      SOUTH_DIR: (0, 1),   # Moving South (forward when facing South) means increasing Y\n      WEST_DIR: (-1, 0),   # Moving West (forward when facing West) means decreasing X\n  }\n\n  primitive_id = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n  agent_grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir # Agent's initial facing direction\n\n  grid_height, grid_width, _ = agent_grid.shape\n\n  # Define all indices for entities that block agent movement.\n  # The agent cannot move onto these cells. This set typically includes:\n  # - Non-grabbable environment features (e.g., walls, water, lava)\n  # - Workshop locations (crafting stations), which are fixed interaction points\n  # - The primitive itself, as collection happens from an adjacent cell, not by standing on it.\n  impassable_for_movement_indices = set()\n  impassable_for_movement_indices.update(env.world.non_grabbable_indices)\n  impassable_for_movement_indices.update(env.world.workshop_indices)\n  impassable_for_movement_indices.add(primitive_id) \n\n  def is_traversable(x, y, grid_data, obstacles_set):\n    \"\"\"Checks if a given grid cell (x, y) is within bounds and traversable by the agent.\"\"\"\n    # Check if the coordinates are within the grid boundaries\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False \n\n    # Check if the cell contains any obstacle from the `obstacles_set`\n    # A cell is traversable only if *no* impassable item is present at that location.\n    for kind_idx in obstacles_set:\n      if grid_data[y, x, kind_idx] == 1: # Assuming '1' indicates presence of an entity\n        return False # Cell contains an impassable obstacle\n    return True # Cell is traversable\n\n  # Find all actual locations of the primitive on the grid.\n  primitive_locations = set() # Stores (x, y) coordinates of each primitive instance\n  y_coords, x_coords = np.where(agent_grid[:, :, primitive_id] == 1)\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n  \n  if not primitive_locations:\n    return [] # If the primitive is not on the grid, no actions can be taken to collect it.\n\n  # Define the set of target states for the BFS. A target state is a (x, y, direction)\n  # tuple from which the agent can perform a USE_ACTION to collect a primitive.\n  # This requires the (x, y) position to be traversable and adjacent to a primitive,\n  # and the 'direction' to be facing that specific primitive instance.\n  target_bfs_states = set() \n\n  # Define deltas for checking all four cardinal neighbors (North, South, East, West)\n  CARDINAL_ADJACENCY_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n\n  for px, py in primitive_locations: # Iterate through each primitive instance on the grid\n    for dx_adj, dy_adj in CARDINAL_ADJACENCY_DELTAS: # Check its four cardinal neighbors\n      adj_x, adj_y = px + dx_adj, py + dy_adj # A potential adjacent cell from which to collect\n\n      # If this adjacent cell is traversable, it's a candidate collection point.\n      if is_traversable(adj_x, adj_y, agent_grid, impassable_for_movement_indices):\n        # Calculate the relative position of the primitive from this adjacent cell\n        # (item_x - agent_x, item_y - agent_y)\n        delta_x_to_item = px - adj_x\n        delta_y_to_item = py - adj_y\n\n        # Determine the required facing direction to look at the primitive from (adj_x, adj_y)\n        required_face_dir = None\n        if delta_x_to_item == 1 and delta_y_to_item == 0:  # Primitive is to the East (+X)\n            required_face_dir = EAST_DIR\n        elif delta_x_to_item == -1 and delta_y_to_item == 0: # Primitive is to the West (-X)\n            required_face_dir = WEST_DIR\n        elif delta_x_to_item == 0 and delta_y_to_item == 1:  # Primitive is to the South (+Y)\n            required_face_dir = SOUTH_DIR\n        elif delta_x_to_item == 0 and delta_y_to_item == -1: # Primitive is to the North (-Y)\n            required_face_dir = NORTH_DIR\n        \n        if required_face_dir is not None:\n          # Add this (position, direction) as a valid target state for our BFS\n          target_bfs_states.add((adj_x, adj_y, required_face_dir))\n\n  if not target_bfs_states:\n    # No valid adjacent, traversable cells were found from which to collect the primitive.\n    return [] \n\n  # BFS for finding the shortest sequence of actions in the (x, y, direction) state space.\n  # Each element in the queue is (current_x, current_y, current_dir, list_of_actions_taken_so_far).\n  queue = collections.deque([(agent_pos_x, agent_pos_y, agent_dir, [])])\n  \n  # `visited` set to keep track of (x, y, dir) states already explored,\n  # preventing cycles and ensuring the shortest path is found.\n  visited = set([(agent_pos_x, agent_pos_y, agent_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, current_path = queue.popleft()\n\n    # If the current state (position and direction) matches one of our target states,\n    # we have found the shortest path.\n    if (curr_x, curr_y, curr_dir) in target_bfs_states:\n      # Append the USE_ACTION to the sequence and return the complete path.\n      return current_path + [USE_ACTION] \n\n    # Explore all possible next states by applying each of the four movement/turning actions:\n    \n    # 1. Try MOVE_FORWARD_ACTION\n    dx_fwd, dy_fwd = _DIR_TO_DELTA[curr_dir] # Movement delta based on current facing direction\n    next_x_fwd, next_y_fwd = curr_x + dx_fwd, curr_y + dy_fwd\n    next_dir_fwd = curr_dir # Facing direction does not change during movement\n\n    if is_traversable(next_x_fwd, next_y_fwd, agent_grid, impassable_for_movement_indices):\n      if (next_x_fwd, next_y_fwd, next_dir_fwd) not in visited:\n        visited.add((next_x_fwd, next_y_fwd, next_dir_fwd))\n        queue.append((next_x_fwd, next_y_fwd, next_dir_fwd, current_path + [MOVE_FORWARD_ACTION]))\n\n    # 2. Try MOVE_BACKWARD_ACTION\n    # To move backward, the agent moves in the opposite cardinal direction of its current facing.\n    dx_bwd, dy_bwd = _DIR_TO_DELTA[(curr_dir + 2) % 4] \n    next_x_bwd, next_y_bwd = curr_x + dx_bwd, curr_y + dy_bwd\n    next_dir_bwd = curr_dir # Facing direction does not change during movement\n\n    if is_traversable(next_x_bwd, next_y_bwd, agent_grid, impassable_for_movement_indices):\n      if (next_x_bwd, next_y_bwd, next_dir_bwd) not in visited:\n        visited.add((next_x_bwd, next_y_bwd, next_dir_bwd))\n        queue.append((next_x_bwd, next_y_bwd, next_dir_bwd, current_path + [MOVE_BACKWARD_ACTION]))\n\n    # 3. Try TURN_LEFT_ACTION\n    next_dir_left = (curr_dir - 1 + 4) % 4 # Calculate new direction after a 90-degree left turn\n    # Position (x, y) remains unchanged during a turn action.\n    if (curr_x, curr_y, next_dir_left) not in visited:\n      visited.add((curr_x, curr_y, next_dir_left))\n      queue.append((curr_x, curr_y, next_dir_left, current_path + [TURN_LEFT_ACTION]))\n\n    # 4. Try TURN_RIGHT_ACTION\n    next_dir_right = (curr_dir + 1) % 4 # Calculate new direction after a 90-degree right turn\n    # Position (x, y) remains unchanged during a turn action.\n    if (curr_x, curr_y, next_dir_right) not in visited:\n      visited.add((curr_x, curr_y, next_dir_right))\n      queue.append((curr_x, curr_y, next_dir_right, current_path + [TURN_RIGHT_ACTION]))\n      \n  # If the BFS queue is exhausted and no path to a target collection state was found,\n  # it means the primitive is unreachable.\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T22:18:08.944062", "function_name": "collect", "function_body": "  import collections\n\n  # Actions\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Directions (matching CraftState's internal representation)\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Helper function: Calculates direction agent needs to face to look at an item.\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dy == 1 and dx == 0: return SOUTH_DIR\n    if dy == -1 and dx == 0: return NORTH_DIR\n    return None # Should not happen if agent_pos and item_pos are cardinally adjacent\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information from the environment\n  current_state = env._current_state\n  \n  # If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  # Extract grid and agent's initial position and direction\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Define all indices that represent un-traversable (obstacle) grid cells for movement.\n  # This includes non-grabbable items, workshops, and the primitive itself\n  # (as agent typically cannot walk onto the resource it needs to 'USE').\n  movement_obstacle_indices = set()\n  movement_obstacle_indices.update(env.world.non_grabbable_indices)\n  movement_obstacle_indices.update(env.world.workshop_indices)\n  movement_obstacle_indices.add(primitive_id) # Agent cannot walk onto the primitive itself\n\n\n  # Helper function: Checks if a given grid cell (x, y) is within bounds and does not contain\n  # any defined movement obstacle entities.\n  def _is_traversable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check if the cell contains any obstacle that blocks movement\n    for obs_idx in movement_obstacle_indices:\n      if grid[y, x, obs_idx] > 0: # grid is indexed as (height, width, kinds)\n        return False\n    return True\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid, so it's unreachable.\n\n  # Prepare BFS goal states: (agent_x, agent_y, agent_facing_dir)\n  # These are the specific agent states (position and direction) from which\n  # the 'USE' action can be successfully performed to collect the primitive.\n  bfs_target_agent_states = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells where the agent could stand\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Deltas from item_pos to agent_pos\n      adj_x, adj_y = item_x + dx_adj, item_y + dy_adj\n\n      # Check if this adjacent cell is traversable for the agent\n      if _is_traversable(adj_x, adj_y):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_target_agent_states.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_target_agent_states:\n    return [] # No traversable adjacent positions from which to collect the primitive\n\n  # BFS setup: state includes position (x,y) and facing direction (dir)\n  # Queue stores (x, y, dir) tuples representing agent's state\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Parent map to reconstruct the path: {child_state: (parent_state, action_to_child)}\n  parent_map = {} \n  \n  found_goal_state = None # Stores the (x, y, dir) of the goal state once found by BFS\n\n  # Define movement actions and their effects: (dx, dy, resulting_direction)\n  # When agent performs UP_ACTION, it moves UP (negative Y) and its facing direction becomes NORTH.\n  movement_actions_map = {\n      UP_ACTION: (0, -1, NORTH_DIR),\n      DOWN_ACTION: (0, 1, SOUTH_DIR),\n      LEFT_ACTION: (-1, 0, WEST_DIR),\n      RIGHT_ACTION: (1, 0, EAST_DIR)\n  }\n  \n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state is one of the desired goal states\n    if (curr_x, curr_y, curr_dir) in bfs_target_agent_states:\n      found_goal_state = (curr_x, curr_y, curr_dir)\n      break # Found the shortest path to a goal in terms of total actions\n\n    # Explore movement actions: agent moves and its direction automatically aligns with the movement.\n    for action, (dx, dy, resulting_dir) in movement_actions_map.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = resulting_dir # Direction is determined by the movement action\n\n      next_state = (next_x, next_y, next_dir)\n      \n      # Only add to queue if the next cell is traversable and state hasn't been visited\n      if _is_traversable(next_x, next_y) and next_state not in visited:\n        visited.add(next_state)\n        parent_map[next_state] = ((curr_x, curr_y, curr_dir), action)\n        queue.append(next_state)\n    \n    # Explore turning actions: agent changes direction without changing position.\n    # These actions are independent of movement and allow the agent to face a different direction\n    # while staying in the same spot.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]: \n      next_x, next_y = curr_x, curr_y # Position remains unchanged for a pure turn\n      \n      # Calculate new direction based on the turn action\n      # Assuming NORTH=0, EAST=1, SOUTH=2, WEST=3 for modular arithmetic\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n      \n      next_state = (next_x, next_y, next_dir)\n      \n      # No traversability check needed as position doesn't change for a turn.\n      # Only add to queue if this (pos, dir) state hasn't been visited.\n      if next_state not in visited:\n        visited.add(next_state)\n        parent_map[next_state] = ((curr_x, curr_y, curr_dir), turn_action)\n        queue.append(next_state)\n\n  if found_goal_state is None:\n    return [] # No path found to any primitive's collection point\n\n  # Reconstruct the path of actions from the found_goal_state back to the initial_state\n  actions = []\n  curr_state = found_goal_state\n  initial_state = (initial_agent_x, initial_agent_y, initial_agent_dir)\n\n  while curr_state != initial_state:\n    # Get the parent state and the action that led from parent to curr_state\n    parent_state, action = parent_map[curr_state]\n    actions.insert(0, action) # Prepend action to build the path in the correct chronological order\n    curr_state = parent_state\n  \n  # Once the agent reaches the correct position and is facing the primitive,\n  # the final action is to USE the primitive.\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T22:18:09.935104", "function_name": "collect", "function_body": "  import collections\n  # numpy is already imported at the top of the file\n\n  # Actions\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Directions (matching CraftState's internal representation)\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Helper function: Calculates direction agent needs to face to look at an item.\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx, dy = item_x - agent_x, item_y - agent_y\n    if dx == 0: # Item is vertically aligned (dy != 0)\n      return NORTH_DIR if dy < 0 else SOUTH_DIR\n    else: # Item is horizontally aligned (dx != 0)\n      return EAST_DIR if dx > 0 else WEST_DIR\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information from the environment\n  current_state = env._current_state\n  \n  # If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  # Extract grid and agent's initial position and direction\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Define all indices that represent un-traversable (obstacle) grid cells for movement.\n  # This includes non-grabbable items, workshops, and the primitive itself\n  # (as agent typically cannot walk onto the resource it needs to 'USE').\n  movement_obstacle_indices = set()\n  movement_obstacle_indices.update(env.world.non_grabbable_indices)\n  movement_obstacle_indices.update(env.world.workshop_indices)\n  movement_obstacle_indices.add(primitive_id)\n\n  # Pre-calculate a traversable map for faster lookups during BFS.\n  # Initialize all cells as traversable.\n  traversable_map = np.ones((grid_height, grid_width), dtype=bool)\n  for y in range(grid_height):\n      for x in range(grid_width):\n          for obs_idx in movement_obstacle_indices:\n              if grid[y, x, obs_idx] > 0: # grid is indexed as (height, width, kinds)\n                  traversable_map[y, x] = False\n                  break # This cell is blocked, no need to check further obstacles\n\n  # Helper function: Checks if a given grid cell (x, y) is within bounds and traversable.\n  def _is_traversable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    return traversable_map[y, x]\n\n  # Find all locations of the primitive on the grid\n  # np.where returns (row_indices, col_indices) which correspond to (y_coords, x_coords)\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid, so it's unreachable.\n\n  # Prepare BFS goal states: (agent_x, agent_y, agent_facing_dir).\n  # These are the specific agent states (position and direction) from which\n  # the 'USE' action can be successfully performed to collect the primitive.\n  bfs_target_agent_states = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells where the agent could stand\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Deltas from item_pos to agent_pos\n      adj_x, adj_y = item_x + dx_adj, item_y + dy_adj\n\n      # Check if this adjacent cell is traversable for the agent\n      if _is_traversable(adj_x, adj_y):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None: # Should always be not None for cardinally adjacent valid points\n          bfs_target_agent_states.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_target_agent_states:\n    return [] # No traversable adjacent positions from which to collect the primitive\n\n  # BFS setup\n  # Queue stores (x, y, dir) tuples representing agent's state\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Parent map to reconstruct the path: {child_state: (parent_state, action_to_child)}\n  parent_map = {} \n  \n  found_goal_state = None # Stores the (x, y, dir) of the goal state once found by BFS\n\n  # Define movement actions and their effects: (dx, dy, resulting_direction).\n  # When agent performs UP_ACTION, it moves UP (dy=-1) and its facing direction becomes NORTH.\n  movement_actions_map = {\n      UP_ACTION: (0, -1, NORTH_DIR),\n      DOWN_ACTION: (0, 1, SOUTH_DIR),\n      LEFT_ACTION: (-1, 0, WEST_DIR),\n      RIGHT_ACTION: (1, 0, EAST_DIR)\n  }\n  \n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state is one of the desired goal states\n    if (curr_x, curr_y, curr_dir) in bfs_target_agent_states:\n      found_goal_state = (curr_x, curr_y, curr_dir)\n      break # Found the shortest path to a goal\n\n    # Explore movement actions: agent moves and its direction automatically aligns with the movement.\n    for action, (dx, dy, resulting_dir) in movement_actions_map.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = resulting_dir # Direction is determined by the movement action\n\n      next_state = (next_x, next_y, next_dir)\n      \n      # Only add to queue if the next cell is traversable and state hasn't been visited\n      if _is_traversable(next_x, next_y)