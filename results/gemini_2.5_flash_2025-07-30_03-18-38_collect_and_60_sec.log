{"timestamp": "2025-07-30T23:18:18.389871", "function_name": "collect", "function_body": "    from collections import deque\n    import numpy as np\n\n    # Get all possible actions from the environment\n    action_map = env.action_specs()\n    actions = list(action_map.values()) # e.g., [0, 1, 2, 3, 4] representing UP, DOWN, LEFT, RIGHT, USE\n\n    # Initialize BFS queue with the initial state and an empty path.\n    # We access the internal _current_state of CraftLab to get the initial CraftState object.\n    initial_craft_state = env._current_state\n    queue = deque([(initial_craft_state, [])])\n\n    # Use a set to keep track of visited states to avoid cycles and redundant computations.\n    # A state is uniquely defined by its grid, agent's position, direction, and inventory.\n    # Since numpy arrays are not hashable, we convert them to bytes for the set key.\n    # The key format will be (grid.tobytes(), pos_tuple, dir_int, inventory.tobytes())\n    visited_states = set()\n\n    # Add the initial state to the visited set\n    initial_state_hashable = (\n        initial_craft_state.grid.tobytes(),\n        initial_craft_state.pos,\n        initial_craft_state.dir,\n        initial_craft_state.inventory.tobytes()\n    )\n    visited_states.add(initial_state_hashable)\n\n    while queue:\n        current_craft_state, current_path = queue.popleft()\n\n        # Check if the goal (primitive) is satisfied in the current state's inventory.\n        # The goal_name argument for satisfies() is ignored in CraftState, so pass None.\n        if current_craft_state.satisfies(None, primitive):\n            return current_path\n\n        # Explore all possible actions from the current state\n        for action in actions:\n            # Apply the action to get the next state.\n            # CraftState.step returns (reward, new_state). We only need new_state here.\n            _reward, next_craft_state = current_craft_state.step(action)\n\n            # Create a hashable representation of the next state\n            next_state_hashable = (\n                next_craft_state.grid.tobytes(),\n                next_craft_state.pos,\n                next_craft_state.dir,\n                next_craft_state.inventory.tobytes()\n            )\n\n            # If this state has not been visited before, add it to the queue and the visited set.\n            if next_state_hashable not in visited_states:\n                visited_states.add(next_state_hashable)\n                new_path = current_path + [action]\n                queue.append((next_craft_state, new_path))\n\n    # If the queue becomes empty and the goal was not reached, it means the primitive is unreachable.\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:18:18.468551", "function_name": "collect", "function_body": "    # Get the integer ID for the primitive from the cookbook's index\n    # The `primitive` input is expected to be a string name.\n    primitive_idx = env.world.cookbook.index[primitive]\n\n    # Get the initial state of the environment.\n    # CraftLab stores the current CraftState in its `_current_state` attribute.\n    current_state = env._current_state\n    \n    # Store the initial count of the primitive in the inventory.\n    # We want to collect at least one more than this amount.\n    initial_inventory_count = current_state.inventory[primitive_idx]\n\n    # List to store the sequence of actions planned\n    actions_taken = []\n    \n    # Define a maximum number of steps to prevent infinite planning loops\n    MAX_PLANNING_STEPS = 500 # Arbitrary limit, can be adjusted\n\n    # Loop to simulate steps and plan actions\n    for step_count in range(MAX_PLANNING_STEPS):\n        # Check if the goal has been achieved (primitive is in inventory)\n        if current_state.inventory[primitive_idx] > initial_inventory_count:\n            break # Goal achieved, stop planning\n\n        action_to_take = None\n\n        # Strategy 1: If the primitive is immediately next to the agent (within 3x3 neighborhood), use it.\n        if current_state.next_to(primitive_idx):\n            action_to_take = env_factory.ACTIONS.USE\n        else:\n            # Strategy 2: Primitive not next to agent, so find it on the global grid and move towards it.\n            # `current_state.grid` is a numpy array of shape (WIDTH, HEIGHT, n_kinds).\n            # `np.argwhere` returns (row, col) coordinates where the condition is true.\n            # So, `target_locations` will contain (y, x) tuples for the primitive's positions.\n            target_locations = np.argwhere(current_state.grid[:, :, primitive_idx] > 0)\n\n            if target_locations.size > 0:\n                # If primitive locations are found, move towards the closest one.\n                agent_x, agent_y = current_state.pos # Agent's position is (x, y)\n                \n                # Convert agent's position to (y, x) for distance calculation consistency with target_locations\n                agent_pos_yx = np.array([agent_y, agent_x]) \n                \n                # Calculate Euclidean distances from the agent to all target locations\n                distances = np.linalg.norm(target_locations - agent_pos_yx, axis=1)\n                closest_target_idx = np.argmin(distances)\n                closest_target_yx = target_locations[closest_target_idx] # This is (target_y, target_x)\n                \n                target_x = closest_target_yx[1] # Extract x-coordinate (column)\n                target_y = closest_target_yx[0] # Extract y-coordinate (row)\n\n                # Determine the best action (UP/DOWN/LEFT/RIGHT) to get closer\n                dx = target_x - agent_x\n                dy = target_y - agent_y\n\n                # Prioritize movement along the axis with the larger difference\n                if abs(dx) > abs(dy):\n                    if dx > 0:\n                        action_to_take = env_factory.ACTIONS.RIGHT\n                    elif dx < 0:\n                        action_to_take = env_factory.ACTIONS.LEFT\n                    else: # dx == 0, already aligned on x-axis, move along y\n                        if dy > 0:\n                            action_to_take = env_factory.ACTIONS.DOWN\n                        elif dy < 0:\n                            action_to_take = env_factory.ACTIONS.UP\n                else: # Prioritize Y movement, or if abs(dx) == abs(dy)\n                    if dy > 0:\n                        action_to_take = env_factory.ACTIONS.DOWN\n                    elif dy < 0:\n                        action_to_take = env_factory.ACTIONS.UP\n                    else: # dy == 0, already aligned on y-axis, move along x\n                        if dx > 0:\n                            action_to_take = env_factory.ACTIONS.RIGHT\n                        elif dx < 0:\n                            action_to_take = env_factory.ACTIONS.LEFT\n            else:\n                # Strategy 3: Primitive not currently visible on the grid. Explore.\n                # For `v2`, a simple exploration strategy is to cycle through cardinal directions.\n                # This ensures the agent eventually covers different areas if the primitive is off-screen.\n                action_to_take = step_count % 4 # Cycles through 0, 1, 2, 3 (DOWN, UP, LEFT, RIGHT)\n        \n        # Fallback if no specific action was determined (should not happen with complete logic)\n        if action_to_take is None:\n            action_to_take = env_factory.ACTIONS.RIGHT # Default to moving right\n\n        # Add the determined action to the plan\n        actions_taken.append(action_to_take)\n        \n        # Simulate the effect of the action on the current_state to plan the next step\n        # CraftState.step returns (reward, new_state)\n        _, current_state = current_state.step(action_to_take)\n    \n    return actions_taken", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:19:35.357542", "function_name": "collect", "function_body": "  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Action definitions where movement actions also set the agent's facing direction.\n  # This aligns with a common interpretation of such actions in grid worlds,\n  # and is consistent with `collect_v0`'s action model.\n  ACTION_DATA = {\n      UP_ACTION: {'delta': (0, -1), 'dir': NORTH_DIR},\n      DOWN_ACTION: {'delta': (0, 1), 'dir': SOUTH_DIR},\n      LEFT_ACTION: {'delta': (-1, 0), 'dir': WEST_DIR},\n      RIGHT_ACTION: {'delta': (1, 0), 'dir': EAST_DIR},\n  }\n\n  # Helper function: Checks if a given grid cell is within bounds and does not contain non-grabbable items.\n  def _is_traversable(grid, x, y, non_grabbable_indices, grid_width, grid_height):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item (obstacle) is present at (y, x)\n    for kind_idx in non_grabbable_indices:\n      if grid[y, x, kind_idx] > 0: # Assuming 1 means presence\n        return False\n    return True\n\n  # Helper function: Returns the coordinates (tx, ty) of the cell directly in front of (x,y)\n  # when facing 'direction'.\n  def _get_coords_in_front(x, y, direction):\n    if direction == NORTH_DIR: return x, y - 1\n    if direction == SOUTH_DIR: return x, y + 1\n    if direction == WEST_DIR: return x - 1, y\n    if direction == EAST_DIR: return x + 1, y\n    return None, None # Should not happen with valid directions\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  current_state = env._current_state\n\n  # Optimization: Check if the primitive is already in inventory.\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # BFS setup\n  # Improvement: Use collections.deque for efficient O(1) queue operations.\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir, [])])\n  \n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing.\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  found_path_actions = None # Stores the sequence of actions to the goal state.\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_so_far = queue.popleft()\n\n    # --- Goal Check ---\n    # Check if the primitive is directly in front of the current agent state (position and direction).\n    item_x_in_front, item_y_in_front = _get_coords_in_front(curr_x, curr_y, curr_dir)\n    \n    # Ensure the target cell is within grid bounds before checking its contents.\n    if (0 <= item_x_in_front < grid_width and 0 <= item_y_in_front < grid_height):\n      # If the cell in front contains the primitive, this is a goal state.\n      if grid[item_y_in_front, item_x_in_front, primitive_id] == 1:\n        found_path_actions = path_so_far\n        break # Found the shortest path to a state from which 'USE' can collect the primitive.\n\n    # --- Explore Neighbors via Movement Actions ---\n    # Each movement action (UP, DOWN, LEFT, RIGHT) moves the agent and sets its facing direction.\n    for action, data in ACTION_DATA.items():\n      dx, dy = data['delta']\n      next_dir = data['dir'] # The direction the agent will face *after* this move.\n\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_state_tuple = (next_x, next_y, next_dir)\n\n      # Check if the next cell is traversable and if this state hasn't been visited yet.\n      if _is_traversable(grid, next_x, next_y, non_grabbable_indices, grid_width, grid_height) and next_state_tuple not in visited:\n        visited.add(next_state_tuple)\n        queue.append((next_x, next_y, next_dir, path_so_far + [action]))\n    \n    # Note: Unlike `collect_v1`, `collect_v2` does not include separate \"turn in place\"\n    # actions. This simplification assumes that agent direction is primarily changed\n    # as a result of movement actions, aligning with the action model from `collect_v0`\n    # which seems more standard for this type of environment. If pure turns are needed\n    # and not implicitly part of movement actions, they would need explicit action IDs.\n\n  if found_path_actions is None:\n    return [] # No path found to any state from which the primitive can be collected.\n\n  # Append the USE action after reaching the correct position and facing direction.\n  final_actions = list(found_path_actions) # Create a new list to avoid modifying the path from the queue.\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:19:36.378322", "function_name": "collect", "function_body": "  import collections # This import is present in collect_v0, but collect_v1's comment implies deque is not allowed.\n                      # For collect_v2, we will assume the intent is to use a standard list for the queue\n                      # and pop(0) if deque is truly disallowed, aligning with collect_v1's context.\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Action data consistent with how CraftWorld movement actions are described (movement changes direction).\n  # This corrects the action model used in collect_v1 to match collect_v0 and typical CraftWorld behavior.\n  ACTION_DATA = {\n      UP_ACTION: {'delta': (0, -1), 'dir': NORTH_DIR},\n      DOWN_ACTION: {'delta': (0, 1), 'dir': SOUTH_DIR},\n      LEFT_ACTION: {'delta': (-1, 0), 'dir': WEST_DIR},\n      RIGHT_ACTION: {'delta': (1, 0), 'dir': EAST_DIR},\n  }\n\n  def _is_walkable(grid, x, y, non_grabbable_indices, grid_width, grid_height):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-grabbable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item is present at (y, x)\n    for kind_idx in non_grabbable_indices:\n      if grid[y, x, kind_idx] > 0:\n        return False\n    return True\n\n  def _get_coords_in_front(x, y, direction):\n    \"\"\"Returns the coordinates (tx, ty) of the cell directly in front of (x,y) when facing 'direction'.\"\"\"\n    if direction == NORTH_DIR: return x, y - 1\n    if direction == SOUTH_DIR: return x, y + 1\n    if direction == WEST_DIR: return x - 1, y\n    if direction == EAST_DIR: return x + 1, y\n    return None, None # Should not happen with valid directions\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  current_state = env._current_state\n\n  # Optimization: Check if the primitive is already in inventory (from collect_v0)\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # BFS setup\n  # Using a list as a queue and pop(0), adhering to the constraint mentioned in collect_v1.\n  queue = [(initial_agent_x, initial_agent_y, initial_agent_dir)]\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Parent map to reconstruct the path, more efficient than building lists in the queue (as in collect_v1).\n  parent_map = {} \n  \n  found_goal_state = None\n\n  while queue:\n    curr_x, curr_y, curr_dir = queue.pop(0) # This operation is O(N) for a list\n\n    # Goal Check: Is the primitive directly in front of the current agent state (position and direction)?\n    item_x_in_front, item_y_in_front = _get_coords_in_front(curr_x, curr_y, curr_dir)\n    \n    # Ensure the target cell is within grid bounds before checking its contents.\n    if (0 <= item_x_in_front < grid_width and 0 <= item_y_in_front < grid_height):\n      if grid[item_y_in_front, item_x_in_front, primitive_id] == 1:\n        found_goal_state = (curr_x, curr_y, curr_dir)\n        break # Found the shortest path to a state from which 'USE' can collect the primitive.\n\n    # Explore Neighbors via Movement Actions (correct action model from collect_v0)\n    for action, data in ACTION_DATA.items():\n      dx, dy = data['delta']\n      next_dir = data['dir'] # The direction the agent will face *after* this move.\n\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_state = (next_x, next_y, next_dir)\n\n      # Check if the next cell is traversable and if this state hasn't been visited yet.\n      if _is_walkable(grid, next_x, next_y, non_grabbable_indices, grid_width, grid_height) and next_state not in visited:\n        visited.add(next_state)\n        parent_map[next_state] = ((curr_x, curr_y, curr_dir), action)\n        queue.append(next_state)\n\n  if found_goal_state is None:\n    return [] # No path found to any state from which the primitive can be collected.\n\n  # Reconstruct the path by backtracking from the found goal state to the initial state.\n  # This method is more efficient than the list copying approach in collect_v1.\n  actions = []\n  curr_state = found_goal_state\n  initial_state = (initial_agent_x, initial_agent_y, initial_agent_dir)\n\n  while curr_state != initial_state:\n    parent_state, action = parent_map[curr_state]\n    actions.insert(0, action) # Prepend action to build the path in the correct chronological order.\n    curr_state = parent_state\n  \n  # Finally, append the USE action after reaching the correct position and facing direction.\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T23:20:53.420574", "function_name": "collect", "function_body": "    import numpy as np\n    import collections\n\n    # It's good practice to import directly what's needed from env_factory,\n    # assuming these are top-level attributes in env_factory.\n    from env_factory import ACTIONS, ACTION_DELTAS\n\n    # Get current state information from the environment\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    \n    grid = features_dict['features_global']\n    current_pos_normalized = features_dict['pos']\n    inventory = features_dict['inventory']\n    \n    # Get grid dimensions: numpy arrays are typically (rows, columns), so (HEIGHT, WIDTH)\n    HEIGHT, WIDTH, n_kinds = grid.shape\n    \n    # Convert normalized position to grid coordinates (int)\n    # current_pos_normalized[0] is typically x (column), current_pos_normalized[1] is y (row)\n    start_x = int(round(current_pos_normalized[0] * WIDTH))\n    start_y = int(round(current_pos_normalized[1] * HEIGHT))\n    \n    # Get obstacle indices (non-grabbable entities that agent cannot move into)\n    obstacle_indices = env.world.non_grabbable_indices\n    \n    # 1. Check if the primitive is already in inventory\n    if inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n        \n    # 2. Find all locations on the grid where the primitive exists\n    primitive_locations = set()\n    for y in range(HEIGHT):\n        for x in range(WIDTH):\n            if grid[y, x, primitive] == 1:\n                primitive_locations.add((x, y))\n                \n    # If the primitive is not found on the map, return an empty list\n    if not primitive_locations:\n        return []\n\n    # 3. BFS (Breadth-First Search) to find the shortest path to a primitive location\n    # BFS queue stores tuples of (current_x, current_y, list_of_actions_taken)\n    queue = collections.deque([(start_x, start_y, [])])\n    \n    # Visited set to prevent cycles and redundant exploration: stores (x, y) tuples\n    visited = set([(start_x, start_y)])\n    \n    while queue:\n        cx, cy, path = queue.popleft()\n        \n        # Check if the current position is a cell containing the primitive.\n        # As per CraftState.next_to logic, standing on the item allows collection.\n        if (cx, cy) in primitive_locations:\n            # Agent is on a cell containing the primitive, so now USE it.\n            return path + [ACTIONS.USE]\n            \n        # Explore possible neighboring cells by performing move actions (UP, DOWN, LEFT, RIGHT)\n        for action_id in [ACTIONS.UP, ACTIONS.DOWN, ACTIONS.LEFT, ACTIONS.RIGHT]:\n            dx, dy = ACTION_DELTAS[action_id]\n            nx, ny = cx + dx, cy + dy\n            \n            # Check if the new position (nx, ny) is within grid boundaries\n            if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n                continue # Out of bounds, skip this move\n            \n            # Check if the new position (nx, ny) is traversable (not an obstacle)\n            is_traversable = True\n            for k_idx in obstacle_indices:\n                if grid[ny, nx, k_idx] == 1: # An obstacle kind is present at this cell\n                    is_traversable = False\n                    break\n            \n            # If traversable and not yet visited, add to queue for exploration\n            if is_traversable and (nx, ny) not in visited:\n                visited.add((nx, ny))\n                queue.append((nx, ny, path + [action_id]))\n                \n    # If the BFS completes and no path was found to any primitive location\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:20:54.439145", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Helper function to check if a kind is next to a position on a grid\n  def _is_next_to_grid(grid, pos, kind_idx):\n    \"\"\"\n    Checks if any cell in the 3x3 neighborhood around pos contains kind_idx.\n    \"\"\"\n    height, width, _ = grid.shape\n    r, c = pos\n    for dr in [-1, 0, 1]:\n      for dc in [-1, 0, 1]:\n        nr, nc = r + dr, c + dc\n        if 0 <= nr < height and 0 <= nc < width:\n          if grid[nr, nc, kind_idx] > 0:  # Assuming 1 for presence\n            return True\n    return False\n\n  # Action deltas for movement (assuming env_factory defines these constants)\n  ACTION_DELTAS = {\n      env_factory.DOWN: (1, 0),\n      env_factory.UP: (-1, 0),\n      env_factory.LEFT: (0, -1),\n      env_factory.RIGHT: (0, 1),\n  }\n\n  current_state = env._current_state\n  initial_pos = current_state.pos\n  grid = current_state.grid\n  height, width, _ = grid.shape\n\n  # Check if the primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  # BFS queue: (row, col, list_of_actions_taken_to_reach_this_pos)\n  queue = collections.deque([(initial_pos[0], initial_pos[1], [])])\n  # Visited set: (row, col) to avoid redundant explorations\n  visited = set([(initial_pos[0], initial_pos[1])])\n\n  # Get non-grabbable indices from the world configuration\n  world = current_state.world\n  non_grabbable_indices = world.non_grabbable_indices\n\n  # Ensure the primitive is a type that can be \"collected\" (i.e., a primitive resource)\n  if primitive not in world.primitives:\n    # If it's not a primitive resource defined in the cookbook, it cannot be collected\n    # directly from the environment in this manner (e.g., it might be a craftable item).\n    return []\n\n  # Check initial state: If the agent is already next to the primitive, just USE it.\n  if _is_next_to_grid(grid, initial_pos, primitive):\n    return [env_factory.USE]\n\n  while queue:\n    r, c, path = queue.popleft()\n\n    # Explore all 4 cardinal movement directions (UP, DOWN, LEFT, RIGHT)\n    for action, (dr, dc) in ACTION_DELTAS.items():\n      nr, nc = r + dr, c + dc  # New row and column after taking the action\n\n      # Check grid boundaries\n      if not (0 <= nr < height and 0 <= nc < width):\n        continue\n\n      # Check if the new position is blocked by any non-grabbable item\n      is_blocked = False\n      for kind_idx in non_grabbable_indices:\n        if grid[nr, nc, kind_idx] > 0:\n          is_blocked = True\n          break\n      if is_blocked:\n        continue\n\n      new_pos_tuple = (nr, nc)\n      if new_pos_tuple not in visited:\n        visited.add(new_pos_tuple)\n        new_path = path + [action]\n\n        # After moving to (nr, nc), check if this new position is next to the primitive\n        if _is_next_to_grid(grid, new_pos_tuple, primitive):\n          # We are now next to the primitive, so the next action is USE\n          return new_path + [env_factory.USE]\n        else:\n          # Not next to it yet, add this position to the queue for further exploration\n          queue.append((nr, nc, new_path))\n\n  # If the BFS completes and no path is found to the primitive\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:22:21.642486", "function_name": "collect", "function_body": "  # Action constants (as per CraftLab.action_specs() mapping)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Delta mapping for movement actions (dx, dy)\n  # (dx is change in x-coordinate, dy is change in y-coordinate)\n  # Assuming (0,0) is top-left, x increases right, y increases down\n  ACTION_DELTAS = {\n      UP: (0, -1),   # Moving UP decreases y\n      DOWN: (0, 1),  # Moving DOWN increases y\n      LEFT: (-1, 0), # Moving LEFT decreases x\n      RIGHT: (1, 0)  # Moving RIGHT increases x\n  }\n\n  actions_taken = []\n  \n  # Get current state from the CraftLab environment\n  current_state = env._current_state\n  \n  # 1. Check if the primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n  start_pos = current_state.pos\n\n  # Get non-grabbable indices from the CraftWorld's cookbook, which is referenced by CraftLab\n  # env (CraftLab) -> world (CraftWorld) -> cookbook (Cookbook)\n  non_grabbable_indices = env.world.cookbook.non_grabbable_indices\n\n  # 2. Find all locations of the primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          if grid[x, y, primitive] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # Primitive not found anywhere on the initial grid\n      return []\n\n  # 3. Use BFS to find the shortest path to a cell *adjacent* to any primitive location\n  # The agent needs to move to a cell from which it can 'USE' the primitive.\n  # 'CraftState.next_to(self, i_kind)' checks the 3x3 neighborhood around agent's position.\n  # So, we need to find a path to a cell (curr_x, curr_y) such that max(|curr_x - p_x|, |curr_y - p_y|) == 1\n  # for any primitive location (p_x, p_y).\n\n  queue = collections.deque([(start_pos, [])]) # (current_pos: (x,y), list_of_actions_to_reach_here)\n  visited = {start_pos} # Set of visited (x,y) tuples to prevent cycles and re-exploring\n\n  final_target_adj_pos = None # The optimal cell the agent needs to move to\n  path_to_final_target_adj_pos = []\n\n  while queue:\n      (curr_x, curr_y), curr_path = queue.popleft()\n\n      # Check if current position is adjacent to any primitive location\n      for p_x, p_y in primitive_locations:\n          # Check if Chebyshev distance is 1 (i.e., immediate 3x3 neighborhood excluding itself)\n          if max(abs(curr_x - p_x), abs(curr_y - p_y)) == 1:\n              final_target_adj_pos = (curr_x, curr_y)\n              path_to_final_target_adj_pos = curr_path\n              break # Found the closest adjacent spot\n      if final_target_adj_pos:\n          break # Path to closest adjacent spot found, no need to explore further\n\n      # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n      for action, (dx, dy) in ACTION_DELTAS.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # Check bounds and if already visited\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT) or next_pos in visited:\n              continue\n\n          # Check for obstacles (non-grabbable items) at the next position\n          # A cell is considered blocked if it contains any non-grabbable item.\n          is_blocked = False\n          for kind_idx in non_grabbable_indices:\n              if grid[next_x, next_y, kind_idx] > 0: # If this kind is present at next_pos\n                  is_blocked = True\n                  break\n          if is_blocked:\n              continue\n\n          visited.add(next_pos)\n          queue.append((next_pos, curr_path + [action]))\n\n  if final_target_adj_pos is None:\n      # No path found to an adjacent cell of any primitive (either unreachable or not on map)\n      return []\n\n  # 4. Execute navigation actions\n  # Simulate actions using env.step() to update the environment's internal state.\n  # This is crucial because `env._current_state` (the agent's actual state) is updated by `env.step()`.\n  for action in path_to_final_target_adj_pos:\n      _reward, _done, _obs = env.step(action)\n      actions_taken.append(action)\n      if _done: # If the episode ends prematurely during navigation\n          return [] # Indicate failure or incomplete path\n\n  # 5. After navigating, perform the USE action\n  _reward, _done, _obs = env.step(USE)\n  actions_taken.append(USE)\n  \n  # 6. Verify collection\n  # The `env._current_state` has been updated by the last `env.step(USE)`.\n  if env._current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # Collection failed (e.g., primitive not actually grabbable from this position,\n      # or required tools/conditions not met, though for simple primitives, USE should work).\n      return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:22:21.711868", "function_name": "collect", "function_body": "    # Action constants (assuming these are consistent with CraftLab.action_specs())\n    DOWN_ACTION = 0\n    UP_ACTION = 1\n    LEFT_ACTION = 2\n    RIGHT_ACTION = 3\n    USE_ACTION = 4\n\n    # Get current observations to extract grid, position, and inventory.\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    \n    current_grid = features_dict['features_global']\n    \n    # The 'pos' in features_dict is described as a \"normalized position array\".\n    # We assume it provides the agent's integer (x, y) coordinates for grid lookup.\n    current_pos = tuple(features_dict['pos']) \n    \n    current_inventory = features_dict['inventory']\n\n    # If the primitive is already in the inventory, no actions are needed.\n    if current_inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions. The grid shape is (WIDTH, HEIGHT, n_kinds).\n    grid_x_dim, grid_y_dim, _ = current_grid.shape\n\n    # BFS setup:\n    # The queue stores tuples of (current_position (x, y), list_of_actions_to_reach_here).\n    q = deque()\n    q.append((current_pos, []))  \n    visited = {current_pos} # Set to keep track of visited positions.\n\n    # Define possible movements and their corresponding actions.\n    # (dx, dy) represents changes in (x, y) coordinates for grid[x, y, ...].\n    movements = {\n        (0, -1): UP_ACTION,    # Move up: decrease y-coordinate.\n        (0, 1): DOWN_ACTION,   # Move down: increase y-coordinate.\n        (-1, 0): LEFT_ACTION,  # Move left: decrease x-coordinate.\n        (1, 0): RIGHT_ACTION   # Move right: increase x-coordinate.\n    }\n\n    # BFS loop to find the shortest path to a cell containing the primitive.\n    while q:\n        (cx, cy), path_actions = q.popleft() # Dequeue current position and path.\n\n        # Check if the current cell (cx, cy) contains the target primitive.\n        if current_grid[cx, cy, primitive] == 1.0:\n            # Primitive found! Return the actions to reach it, followed by the USE action.\n            return path_actions + [USE_ACTION]\n\n        # Explore all four cardinal neighbors.\n        for (dx, dy), action in movements.items():\n            nx, ny = cx + dx, cy + dy # Calculate neighbor's coordinates.\n\n            # Check if the neighbor's coordinates are within grid boundaries.\n            if 0 <= nx < grid_x_dim and 0 <= ny < grid_y_dim:\n                new_pos = (nx, ny)\n                # If this neighbor has not been visited, add it to the queue.\n                if new_pos not in visited:\n                    visited.add(new_pos)\n                    q.append((new_pos, path_actions + [action]))\n\n    # If the BFS completes without finding the primitive on the grid,\n    # return an empty list, indicating no collection path was found.\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:24:21.090426", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:24:21.159822", "function_name": "collect", "function_body": "    # Constants for action mapping, derived from CraftLab.action_specs():\n    # DOWN -> 0, UP -> 1, LEFT -> 2, RIGHT -> 3, USE -> 4\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    actions = []\n    \n    # Start with a reference to the current state of the environment.\n    # CraftState.step returns a new CraftState instance, allowing for simulation\n    # without modifying the actual environment state until these actions are applied.\n    current_simulated_state = env._current_state \n    \n    # 1. Check if the primitive is already in the inventory. If so, no actions are needed.\n    if current_simulated_state.inventory[primitive] > 0:\n        return []\n\n    # 2. Find the primitive's location on the grid.\n    primitive_pos = None\n    width, height, _ = current_simulated_state.grid.shape\n    \n    # Iterate through all grid cells (x for columns, y for rows)\n    for x in range(width):\n        for y in range(height):\n            # If the current cell contains the primitive, record its position and break.\n            if current_simulated_state.grid[x, y, primitive] == 1:\n                primitive_pos = (x, y)\n                break\n        if primitive_pos: # If found, break the outer loop as well\n            break\n            \n    # If the primitive was not found on the grid, it's impossible to collect.\n    if primitive_pos is None:\n        return []\n\n    target_x, target_y = primitive_pos\n\n    # 3. Pathfinding: Greedily move the agent until it is adjacent to the primitive.\n    # A safety break to prevent infinite loops in complex or unreachable scenarios.\n    max_steps_for_path = width * height * 2 \n    steps_taken = 0\n\n    # Continue moving as long as the agent is not next to the primitive,\n    # hasn't already collected it (e.g., by moving over it), and hasn't exceeded max steps.\n    while not current_simulated_state.next_to(primitive) and \\\n          current_simulated_state.inventory[primitive] == 0 and \\\n          steps_taken < max_steps_for_path:\n        \n        agent_x, agent_y = current_simulated_state.pos\n        \n        # Calculate the distance to the target primitive\n        dx = target_x - agent_x\n        dy = target_y - agent_y\n\n        action_to_take = -1 \n        \n        # Prioritize movement along the axis with the larger absolute distance.\n        # This is a simple greedy heuristic for pathfinding.\n        if abs(dx) > abs(dy):\n            if dx > 0:\n                action_to_take = _RIGHT\n            else: # dx < 0\n                action_to_take = _LEFT\n        else: # abs(dy) >= abs(dx) (includes cases where dx or dy is zero)\n            if dy > 0:\n                action_to_take = _DOWN\n            else: # dy < 0\n                action_to_take = _UP\n        \n        # Simulate the chosen action to get the next state.\n        # CraftState.step handles collisions and boundary checks internally.\n        _, next_simulated_state = current_simulated_state.step(action_to_take)\n        \n        # If the agent's position did not change after the action, it means the move was blocked (e.g., by a wall).\n        if next_simulated_state.pos == current_simulated_state.pos:\n            # If blocked, try moving along the other axis as an alternative.\n            if abs(dx) <= abs(dy): # If Y was priority or distances were equal, try X\n                if dx > 0:\n                    action_to_take = _RIGHT\n                else: # dx < 0\n                    action_to_take = _LEFT\n            else: # If X was priority, try Y\n                if dy > 0:\n                    action_to_take = _DOWN\n                else: # dy < 0\n                    action_to_take = _UP\n            \n            # Simulate the alternative action.\n            _, next_simulated_state = current_simulated_state.step(action_to_take)\n            \n            # If still blocked after trying both axes, the agent is stuck or cannot reach the primitive with this strategy.\n            if next_simulated_state.pos == current_simulated_state.pos:\n                return [] # Indicate failure by returning an empty list\n                \n        actions.append(action_to_take)\n        current_simulated_state = next_simulated_state\n        steps_taken += 1\n\n    # 4. After pathfinding, check if the primitive is in inventory.\n    # It might have been collected already if the agent moved directly onto a grabbable item's cell.\n    if current_simulated_state.inventory[primitive] > 0:\n        return actions\n\n    # 5. If the primitive is not in inventory but the agent is next to it, perform the 'USE' action.\n    # This assumes the 'USE' action works on any adjacent item regardless of the agent's facing direction,\n    # as explicit 'turn' actions are not defined.\n    if current_simulated_state.next_to(primitive):\n        actions.append(_USE)\n        return actions\n    \n    # Fallback case: If the primitive couldn't be collected for any reason (e.g., pathfinding failed\n    # to reach adjacency, or it's not a grabbable/usable item type given current rules).\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:25:44.050028", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:25:44.119692", "function_name": "collect", "function_body": "    import collections\n\n    s0 = env._current_state\n\n    # 1. Check if primitive is already in inventory\n    if s0.inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions\n    WIDTH, HEIGHT, _ = s0.grid.shape\n\n    # Define mapping of agent's internal direction (0-3) to (dr, dc)\n    # 0:North, 1:East, 2:South, 3:West\n    HEADING_TO_DELTA = {\n        0: (-1, 0),  # North (row decreases for UP)\n        1: (0, 1),   # East (col increases for RIGHT)\n        2: (1, 0),   # South (row increases for DOWN)\n        3: (0, -1),  # West (col decreases for LEFT)\n    }\n\n    # Helper function to generate turn actions\n    # This aligns with env_factory.LEFT (2) and env_factory.RIGHT (3) actions\n    def get_turn_actions(current_dir, required_heading):\n        actions = []\n        turns_right = (required_heading - current_dir + 4) % 4\n        turns_left = (current_dir - required_heading + 4) % 4\n\n        if turns_right <= turns_left:\n            for _ in range(turns_right):\n                actions.append(env_factory.RIGHT)\n        else:\n            for _ in range(turns_left):\n                actions.append(env_factory.LEFT)\n        return actions\n\n    # 2. BFS to find path to a position from which the primitive can be collected\n    # BFS state: (row, col, direction) of the agent\n    # Queue stores: ((r, c), agent_dir, list_of_actions_to_reach_this_state)\n    queue = collections.deque([(s0.pos, s0.dir, [])])\n    # Visited set stores (r, c, dir) tuples to avoid cycles and redundant processing\n    visited = {(s0.pos[0], s0.pos[1], s0.dir)}\n\n    while queue:\n        current_pos, current_dir, path_so_far = queue.popleft()\n        curr_r, curr_c = current_pos\n\n        # Create a temporary CraftState to simulate actions and check conditions\n        # We use the *original* grid and inventory from s0 for simulation,\n        # as the world state isn't changing until the actual actions are performed.\n        temp_state = CraftState(s0.scenario, s0.grid, current_pos, current_dir, s0.inventory)\n\n        # Check if the primitive is directly in front of the agent (where USE action works)\n        front_dr, front_dc = HEADING_TO_DELTA[current_dir]\n        front_r, front_c = curr_r + front_dr, curr_c + front_dc\n\n        # Check bounds for the cell in front\n        if 0 <= front_r < WIDTH and 0 <= front_c < HEIGHT:\n            # Check if the cell in front contains the primitive\n            if s0.grid[front_r, front_c, primitive] > 0:\n                # Agent is already at a position and facing the primitive. Collect!\n                return path_so_far + [env_factory.USE]\n\n        # If not already facing the primitive, try turning to face any primitive in a cardinal direction\n        # Iterate over all possible internal agent headings (0-3)\n        for required_heading in range(4): # 0:North, 1:East, 2:South, 3:West\n            target_dr, target_dc = HEADING_TO_DELTA[required_heading]\n            target_r, target_c = curr_r + target_dr, curr_c + target_dc\n\n            # Check if this target cell is within bounds and contains the primitive\n            if 0 <= target_r < WIDTH and 0 <= target_c < HEIGHT:\n                if s0.grid[target_r, target_c, primitive] > 0:\n                    # Found a primitive in a cardinal direction from current_pos.\n                    # Calculate turn actions needed to face it.\n                    turn_actions = get_turn_actions(current_dir, required_heading)\n                    # Return the path to current_pos + turns + USE action\n                    return path_so_far + turn_actions + [env_factory.USE]\n\n        # If the primitive cannot be collected from this state (either not adjacent or not facing),\n        # explore neighbor states by trying movement/turning actions.\n        # We consider UP, DOWN (move forward/backward), LEFT, RIGHT (turn). USE is terminal.\n        for action in [env_factory.UP, env_factory.DOWN, env_factory.LEFT, env_factory.RIGHT]:\n            # Simulate the action on the temporary state to get the next agent position and direction\n            # The reward is not relevant for pathfinding here.\n            _, next_state = temp_state.step(action)\n            next_pos = next_state.pos\n            next_dir = next_state.dir\n\n            # If this next state (position and direction) has not been visited, add it to queue\n            if (next_pos[0], next_pos[1], next_dir) not in visited:\n                visited.add((next_pos[0], next_pos[1], next_dir))\n                queue.append((next_pos, next_dir, path_so_far + [action]))\n\n    # If the BFS completes and no path to collect the primitive is found, return an empty list.\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:27:11.293535", "function_name": "collect", "function_body": "    # Define actions based on the problem description as per `action_specs`\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Maximum number of steps to attempt collection to prevent infinite loops\n    MAX_COLLECT_STEPS = 1000\n\n    actions_taken = []\n    _ = env.reset() # Reset the environment to a known initial state\n\n    # Check if the target primitive is actually designated as grabbable in the world configuration.\n    # If not, this function is being asked to collect something that cannot be picked up.\n    if primitive not in env.world.grabbable_indices:\n        return [] # Return empty list if the item cannot be collected by picking up\n\n    step_count = 0\n    previous_pos = None # Used to detect if the agent gets stuck (e.g., hitting an obstacle)\n\n    # Continue looping until the primitive is in the agent's inventory\n    # or the maximum number of collection steps has been reached.\n    while env._current_state.inventory[primitive] == 0 and step_count < MAX_COLLECT_STEPS:\n        current_state = env._current_state\n        current_pos = current_state.pos\n\n        # Check if the agent's position has not changed from the previous step.\n        # This indicates that a movement action failed (e.g., hitting a wall),\n        # suggesting the agent is stuck in its current pathfinding logic.\n        if current_pos == previous_pos and step_count > 0:\n            break # Agent is stuck, give up on current collection attempt\n\n        previous_pos = current_pos # Update the previous position for the next iteration\n\n        # 1. Check if the agent is already next to (or on top of) the primitive.\n        # The `next_to` method checks the 3x3 neighborhood, which includes the agent's own cell.\n        if current_state.next_to(primitive):\n            # If adjacent, perform the USE action to attempt to collect the primitive.\n            action = USE\n            _, _, _ = env.step(action) # Take the USE action\n            actions_taken.append(action)\n            step_count += 1\n            \n            # After attempting to USE, check if the primitive has been collected.\n            if env._current_state.inventory[primitive] > 0:\n                break # Success! Primitive collected.\n            else:\n                # The USE action failed to collect the primitive. This could happen\n                # if the primitive requires a specific tool, is a workshop, or is\n                # not meant to be collected by a simple USE action.\n                # Break to prevent an infinite loop of failed USE attempts.\n                break\n\n        else:\n            # 2. If not adjacent, find the closest instance of the primitive on the grid.\n            primitive_coords = np.argwhere(current_state.grid[:, :, primitive] == 1)\n\n            if len(primitive_coords) == 0:\n                # No instances of the primitive found on the grid.\n                # It might have been depleted, or never present in the current scenario.\n                break # Cannot find the target, give up.\n\n            # Calculate Manhattan distances to all primitive instances to find the closest one.\n            # `current_pos` and `primitive_coords` are (x, y) tuples (column, row).\n            distances = [abs(p_coord[0] - current_pos[0]) + abs(p_coord[1] - current_pos[1]) \n                         for p_coord in primitive_coords]\n            closest_idx = np.argmin(distances)\n            target_primitive_pos = primitive_coords[closest_idx] # (tx, ty) of the closest primitive\n\n            # 3. Determine the next movement action to get closer to the primitive.\n            dx = target_primitive_pos[0] - current_pos[0] # Horizontal distance\n            dy = target_primitive_pos[1] - current_pos[1] # Vertical distance\n\n            action_to_take = None\n            if abs(dx) > abs(dy): # Prioritize horizontal movement if it's the larger difference\n                if dx > 0:\n                    action_to_take = RIGHT\n                elif dx < 0:\n                    action_to_take = LEFT\n            elif abs(dy) > 0: # If vertical difference is larger or equal, and non-zero\n                if dy > 0:\n                    action_to_take = DOWN\n                elif dy < 0:\n                    action_to_take = UP\n            # If both dx and dy are 0, it means current_pos == target_primitive_pos.\n            # This case should ideally be caught by the `current_state.next_to(primitive)` check\n            # at the beginning of the loop, leading to a USE action.\n            # If it reaches this point (action_to_take is None), it implies an unexpected state.\n\n            if action_to_take is not None:\n                _, _, _ = env.step(action_to_take) # Take the movement action\n                actions_taken.append(action_to_take)\n                step_count += 1\n            else:\n                # No valid movement action could be determined.\n                # This suggests the agent is already at the primitive's location\n                # but `next_to` didn't trigger, or some other unhandled scenario.\n                break # Cannot move, give up.\n\n    return actions_taken", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:27:12.280538", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:28:09.655554", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants derived from CraftLab.action_specs()\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Access current state from the CraftLab environment\n  # CraftLab._current_state holds the CraftState instance\n  current_state = env._current_state\n  current_grid = current_state.grid\n  current_pos = current_state.pos\n  inventory = current_state.inventory\n  world = current_state.world # CraftWorld instance\n\n  # If the primitive is already in inventory, no actions are needed to collect it.\n  if inventory[primitive] > 0:\n      return []\n\n  grid_height, grid_width, _ = current_grid.shape # Numpy shape is typically (rows, cols, channels)\n\n  # Identify entities that block movement (e.g., water)\n  # This set can be extended if other entities are also unpassable.\n  blocking_indices = {world.water_index} \n\n  # --- Step 1: Identify all \"use-ready\" cells ---\n  # A \"use-ready\" cell is a traversable cell (r_u, c_u) from which the agent can perform\n  # the USE action to collect the `primitive`. This means the `primitive` must be\n  # within the 3x3 neighborhood (including (r_u, c_u) itself) of (r_u, c_u).\n  use_ready_cells = set()\n  \n  # Iterate over all cells in the grid to find where the primitive exists\n  for r_p in range(grid_height):\n      for c_p in range(grid_width):\n          if current_grid[r_p, c_p, primitive] == 1:\n              # If a cell (r_p, c_p) contains the primitive, then any cell\n              # in its 3x3 neighborhood (including itself) *could* be a use-ready cell.\n              for dr_u in [-1, 0, 1]:\n                  for dc_u in [-1, 0, 1]:\n                      r_u, c_u = r_p + dr_u, c_p + dc_u\n\n                      # Check if the potential use-ready cell is within grid boundaries\n                      if not (0 <= r_u < grid_height and 0 <= c_u < grid_width):\n                          continue\n\n                      # Check if the potential use-ready cell is traversable\n                      is_blocked = False\n                      for blocking_idx in blocking_indices:\n                          if current_grid[r_u, c_u, blocking_idx] == 1:\n                              is_blocked = True\n                              break\n                      if not is_blocked:\n                          use_ready_cells.add((r_u, c_u))\n\n  if not use_ready_cells:\n      return [] # No place on the map from which to collect the primitive\n\n  # --- Step 2: Perform BFS to find the shortest path to any use-ready cell ---\n  queue = collections.deque([(current_pos, [])]) # (current_coords_tuple, list_of_actions_to_reach_here)\n  visited = {current_pos} # Set of (row, col) tuples to avoid cycles\n\n  while queue:\n      (r, c), path_actions = queue.popleft()\n\n      # If the current cell is a use-ready cell, we've found the shortest path.\n      if (r, c) in use_ready_cells:\n          return path_actions + [ACTION_USE] # Append the USE action and return the complete sequence\n\n      # Explore neighbors (move actions: UP, DOWN, LEFT, RIGHT)\n      for dr, dc, action in [(-1, 0, ACTION_UP), (1, 0, ACTION_DOWN), (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]:\n          nr, nc = r + dr, c + dc\n\n          # Check if the neighbor is within grid boundaries\n          if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n              continue\n\n          # Check if the neighbor has already been visited\n          if (nr, nc) in visited:\n              continue\n\n          # Check if the neighbor cell is an obstacle (e.g., water)\n          is_blocked = False\n          for blocking_idx in blocking_indices:\n              if current_grid[nr, nc, blocking_idx] == 1:\n                  is_blocked = True\n                  break\n          if is_blocked:\n              continue # Cannot move into this cell\n\n          # If valid and traversable, add to visited set and queue\n          visited.add((nr, nc))\n          queue.append(((nr, nc), path_actions + [action]))\n\n  # If the BFS completes and no path to any use-ready cell was found,\n  # the primitive is unreachable from the current position.\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:28:10.629510", "function_name": "collect", "function_body": "  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  actions = []\n  state = env._current_state # CraftState instance from CraftLab\n\n  # Check if the primitive is already in inventory\n  # If the goal is to collect one, and we already have it, then no actions are strictly needed\n  # unless the intent is to collect *more*. For simplicity, we assume one is enough.\n  if state.inventory[primitive] > 0:\n      return actions\n\n  current_pos = state.pos\n  grid = state.grid\n  WIDTH, HEIGHT, _ = grid.shape # Get dimensions from grid shape (WIDTH, HEIGHT, n_kinds)\n\n  target_pos = None\n  # Search for the primitive on the grid\n  # Iterate through all grid cells (x, y)\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          # Check if the primitive kind exists at this cell\n          if grid[x, y, primitive] > 0:\n              target_pos = (x, y)\n              break # Found the first occurrence, break inner loop\n      if target_pos:\n          break # Found, break outer loop\n\n  # If the primitive was not found on the grid, return an empty list\n  # as it cannot be collected in this manner.\n  if target_pos is None:\n      return actions\n\n  # Calculate the difference in coordinates between current position and target position\n  dx = target_pos[0] - current_pos[0]\n  dy = target_pos[1] - current_pos[1]\n\n  # Generate actions to move horizontally (X-axis)\n  for _ in range(abs(dx)):\n      if dx > 0: # Target is to the right (positive X direction)\n          actions.append(ACTION_RIGHT)\n      else: # Target is to the left (negative X direction)\n          actions.append(ACTION_LEFT)\n\n  # Generate actions to move vertically (Y-axis)\n  for _ in range(abs(dy)):\n      if dy > 0: # Target is below (positive Y direction, typically 'down')\n          actions.append(ACTION_DOWN)\n      else: # Target is above (negative Y direction, typically 'up')\n          actions.append(ACTION_UP)\n\n  # After moving to the target cell, use the item.\n  # This assumes 'USE' picks up an item from the agent's current cell if it's grabbable.\n  actions.append(ACTION_USE)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:30:02.721377", "function_name": "collect", "function_body": "    initial_state = env._current_state\n    \n    # Check if primitive is already collected\n    if initial_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # Define actions based on CraftLab's action_specs\n    # These constants are typically defined globally or as part of the CraftLab/CraftWorld class.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n    ALL_ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n    # BFS Queue: stores (current_state, actions_taken_to_reach_this_state)\n    # The `CraftState.step()` method returns a new state, so explicit deep copies are not needed here.\n    queue = deque([(initial_state, [])])\n\n    # Visited set: (pos_x, pos_y, dir, has_collected_primitive)\n    # has_collected_primitive is a boolean flag to track if we've collected the primitive\n    # in the inventory at this specific state. This helps avoid redundant exploration.\n    visited = set()\n    \n    # Initial visited state key\n    initial_inventory_primitive_collected = initial_state.inventory[primitive] > 0\n    visited.add((initial_state.pos, initial_state.dir, initial_inventory_primitive_collected))\n\n    # A reasonable maximum search depth to prevent excessive computation.\n    # This value can be tuned based on typical grid sizes and complexity.\n    MAX_SEARCH_DEPTH = 1000 \n\n    while queue:\n        current_state, actions_path = queue.popleft()\n\n        # Check if the goal is satisfied in the current state\n        if current_state.inventory[primitive] > 0:\n            return actions_path\n\n        # Pruning based on search depth to limit computational cost\n        if len(actions_path) >= MAX_SEARCH_DEPTH:\n            continue\n\n        for action in ALL_ACTIONS:\n            # Simulate the step. CraftState.step returns (reward, new_state).\n            # The reward is always 0.0 in this implementation, so we ignore it.\n            _reward, new_state = current_state.step(action)\n\n            # Determine the key for the visited set for the new state\n            new_inventory_primitive_collected = new_state.inventory[primitive] > 0\n            new_state_key = (new_state.pos, new_state.dir, new_inventory_primitive_collected)\n\n            # If this state hasn't been visited before (with the same collection status)\n            if new_state_key not in visited:\n                visited.add(new_state_key)\n                new_actions_path = actions_path + [action]\n                queue.append((new_state, new_actions_path))\n\n    # If the queue is empty and the goal hasn't been reached, the primitive is\n    # either unreachable or requires a path longer than MAX_SEARCH_DEPTH.\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:30:02.793612", "function_name": "collect", "function_body": "    import collections\n\n    # Constants for actions\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Helper function to calculate turning actions\n    def _get_actions_to_turn(current_dir, target_dir) -> list[int]:\n        \"\"\"\n        Calculates the minimal sequence of LEFT/RIGHT actions to change current_dir to target_dir.\n        Assumes LEFT (action 2) turns 90 deg counter-clockwise, RIGHT (action 3) turns 90 deg clockwise.\n        \"\"\"\n        actions = []\n        if current_dir == target_dir:\n            return actions\n        \n        # Directions: 0=N, 1=E, 2=S, 3=W (clockwise)\n        # Calculate the difference in direction modulo 4\n        diff = (target_dir - current_dir + 4) % 4\n        \n        if diff == 1: # 90 degrees clockwise (e.g., North to East)\n            actions.append(RIGHT)\n        elif diff == 2: # 180 degrees (e.g., North to South)\n            # Can be two RIGHTs or two LEFTs. Two RIGHTs is an arbitrary choice.\n            actions.extend([RIGHT, RIGHT]) \n        elif diff == 3: # 90 degrees counter-clockwise (e.g., North to West)\n            actions.append(LEFT)\n        return actions\n\n    # Helper function to get target facing direction\n    def _get_target_facing_direction(agent_pos, target_pos) -> int:\n        \"\"\"\n        Calculates the cardinal direction the agent at agent_pos needs to face to look at target_pos.\n        Returns: 0 (N), 1 (E), 2 (S), 3 (W). Returns -1 if target_pos is not directly adjacent.\n        \"\"\"\n        ax, ay = agent_pos\n        tx, ty = target_pos\n        \n        if tx > ax: return 1 # Target is to the East/Right\n        if tx < ax: return 3 # Target is to the West/Left\n        if ty > ay: return 2 # Target is to the South/Down\n        if ty < ay: return 0 # Target is to the North/Up\n        \n        # If the target is not directly adjacent (e.g., same position or diagonal), return -1\n        return -1 \n\n    state = env._current_state\n    grid = state.grid\n    current_pos = state.pos\n    current_dir = state.dir # Agent's initial facing direction\n    width, height, _ = grid.shape\n\n    # Find all locations of the primitive on the grid\n    primitive_locations = []\n    for x in range(width):\n        for y in range(height):\n            if grid[x, y, primitive] > 0: # Assuming 1 (or more) indicates presence\n                primitive_locations.append((x, y))\n    \n    if not primitive_locations:\n        return [] # Primitive not found on the grid\n\n    # BFS search state: (current_x, current_y, current_facing_direction, path_actions)\n    # The current_facing_direction tracks the agent's direction after the last movement action.\n    q = collections.deque([(current_pos[0], current_pos[1], current_dir, [])])\n    \n    # Visited set tracks (position_x, position_y, facing_direction) to avoid redundant paths\n    # and infinite loops, ensuring we find the shortest path to a (position, direction) state.\n    visited = {(current_pos[0], current_pos[1], current_dir)} \n\n    best_full_path_actions = None\n    \n    # Define possible movement actions. Each entry includes:\n    # (dx, dy): change in coordinates\n    # action_value: the action constant (DOWN, UP, LEFT, RIGHT)\n    # new_facing_dir: the agent's facing direction AFTER this action (assuming movement updates facing)\n    # Directions mapping: 0=N, 1=E, 2=S, 3=W\n    move_options = [\n        (0, 1, DOWN, 2),  # Move (0,1) -> action=DOWN, agent faces SOUTH (dir=2)\n        (0, -1, UP, 0),   # Move (0,-1) -> action=UP, agent faces NORTH (dir=0)\n        (-1, 0, LEFT, 3), # Move (-1,0) -> action=LEFT, agent faces WEST (dir=3)\n        (1, 0, RIGHT, 1)  # Move (1,0) -> action=RIGHT, agent faces EAST (dir=1)\n    ]\n\n    while q:\n        x, y, current_facing_dir, path_actions = q.popleft()\n\n        # Check if the current position is adjacent to any of the primitive locations\n        for px, py in primitive_locations:\n            # Manhattan distance of 1 implies direct adjacency (not diagonal or on top of)\n            if abs(x - px) + abs(y - py) == 1: \n                # Found an adjacent spot to a primitive. This is a potential end point for movement.\n                \n                # Determine the direction the agent needs to face from (x,y) to look at (px,py)\n                target_facing_dir = _get_target_facing_direction((x,y), (px,py))\n                \n                if target_facing_dir != -1: # Ensure a valid adjacent target direction was found\n                    # Calculate the turning actions needed to orient the agent\n                    turning_actions = _get_actions_to_turn(current_facing_dir, target_facing_dir)\n                    \n                    # Construct the complete action sequence: path to adjacent cell + turns + USE\n                    best_full_path_actions = path_actions + turning_actions + [USE]\n                    \n                    # Since BFS guarantees the shortest path (in terms of actions),\n                    # we can stop exploration once the first valid path is found.\n                    q.clear() \n                    break # Break from inner loop (primitive_locations)\n        \n        if best_full_path_actions:\n            break # Break from outer loop (BFS queue)\n\n        # If no primitive found yet at the current position's adjacency, explore neighbors\n        for dx, dy, action_val, new_facing_dir_after_move in move_options:\n            nx, ny = x + dx, y + dy\n            \n            # Check if the next position is within the grid boundaries\n            if 0 <= nx < width and 0 <= ny < height:\n                # Add the new state to the queue only if it hasn't been visited before\n                # A state is defined by (position_x, position_y, facing_direction)\n                if (nx, ny, new_facing_dir_after_move) not in visited:\n                    visited.add((nx, ny, new_facing_dir_after_move))\n                    new_path_actions = list(path_actions) # Create a copy of the path\n                    new_path_actions.append(action_val)\n                    q.append((nx, ny, new_facing_dir_after_move, new_path_actions))\n    \n    # Return the collected actions, or an empty list if no path was found\n    return best_full_path_actions if best_full_path_actions else []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:31:29.742100", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map movement vectors (dx, dy) to action IDs.\n  # These actions move the agent AND set its facing direction.\n  MOVE_VEC_TO_ACTION = {\n      (0, -1): UP,    # Move North, face North\n      (0, 1): DOWN,   # Move South, face South\n      (-1, 0): LEFT,  # Move West, face West\n      (1, 0): RIGHT   # Move East, face East\n  }\n\n  # Map agent's internal direction ID to its corresponding facing vector (dx, dy).\n  # 0: North (-Y)\n  # 1: East (+X)\n  # 2: South (+Y)\n  # 3: West (-X)\n  DIR_TO_VEC = {\n      0: (0, -1),  # North\n      1: (1, 0),   # East\n      2: (0, 1),   # South\n      3: (-1, 0)   # West\n  }\n\n  initial_obs = env.observations()\n  initial_grid = initial_obs['features_dict']['features_global']\n  initial_pos = tuple(initial_obs['features_dict']['pos'].astype(int))\n  # Agent's direction is a one-hot vector, convert to integer (0-3)\n  initial_dir = np.argmax(initial_obs['features_dict']['direction'])\n\n  # Grid dimensions: grid is (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = initial_grid.shape\n\n  # Get indices of non-grabbable items (obstacles) from the world\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a coordinate is within grid bounds\n  def is_valid_coord(x, y):\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  # Helper function to check if a cell is traversable.\n  # A cell is not traversable if it contains any non-grabbable entity.\n  def is_traversable(x, y, current_grid):\n      if not is_valid_coord(x, y):\n          return False\n      for idx in non_grabbable_indices:\n          if current_grid[x, y, idx] > 0:\n              return False # Contains an obstacle\n      return True # Traversable\n\n  # BFS search to find the shortest path to a position from which the primitive can be collected.\n  # The state in BFS is ((x, y), direction_int, actions_taken_so_far).\n  queue = collections.deque([((initial_pos), initial_dir, [])])\n  # Visited set stores (position, direction) tuples to prevent cycles and redundant exploration.\n  visited = set([((initial_pos), initial_dir)])\n\n  while queue:\n      (curr_x, curr_y), curr_dir_int, actions_so_far = queue.popleft()\n\n      # Check if the target primitive is directly in front of the current position and direction.\n      # If yes, add a USE action and this path is a solution.\n      facing_vec = DIR_TO_VEC[curr_dir_int]\n      front_x, front_y = curr_x + facing_vec[0], curr_y + facing_vec[1]\n\n      if is_valid_coord(front_x, front_y) and initial_grid[front_x, front_y, primitive] > 0:\n          # Found the primitive in front, append USE action and return the complete path.\n          return actions_so_far + [USE]\n\n      # Explore possible moves (UP, DOWN, LEFT, RIGHT).\n      # Each move action also changes the agent's direction to the direction of movement.\n      for move_vec, move_action in MOVE_VEC_TO_ACTION.items():\n          next_x, next_y = curr_x + move_vec[0], curr_y + move_vec[1]\n          next_dir_int = move_action # The new direction is set by the move action itself.\n\n          # Check if the next cell is traversable.\n          if is_traversable(next_x, next_y, initial_grid):\n              next_state_key = ((next_x, next_y), next_dir_int)\n              if next_state_key not in visited:\n                  visited.add(next_state_key)\n                  # Add the new state to the queue with the updated path.\n                  queue.append((next_state_key[0], next_state_key[1], actions_so_far + [move_action]))\n\n  # If the queue becomes empty and no path was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T23:31:29.811708", "function_name": "collect", "function_body": "    current_state = env._current_state\n    grid = current_state.grid\n    WIDTH, HEIGHT, _ = grid.shape # N_KINDS not needed for logic\n    start_pos = current_state.pos\n    start_dir = current_state.dir # Numeric direction: 0 (N), 1 (E), 2 (S), 3 (W)\n    \n    # Get actual action integer values from the environment\n    action_map = env.action_specs()\n    ACTION_UP = action_map['UP']\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    # Map move actions to their corresponding delta (dx, dy) and resulting facing direction (new_dir)\n    # The new_dir values (0:N, 1:E, 2:S, 3:W) correspond to the direction of movement.\n    # This dictates how `current_state.dir` changes after a move action.\n    MOVE_ACTION_DATA = [\n        (ACTION_UP, (0, -1, 0)),    # Move North (dy=-1), Face North (dir=0)\n        (ACTION_DOWN, (0, 1, 2)),    # Move South (dy=1), Face South (dir=2)\n        (ACTION_LEFT, (-1, 0, 3)),   # Move West (dx=-1), Face West (dir=3)\n        (ACTION_RIGHT, (1, 0, 1))    # Move East (dx=1), Face East (dir=1)\n    ]\n\n    # 1. Check if primitive is grabbable\n    if primitive not in env.grabbable_indices:\n        return []\n\n    # 2. Find all locations of the primitive on the grid\n    primitive_locations = [] # List of (x, y) coordinates where primitive is present\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return []\n\n    # 3. Identify all target_adjacent_cells from which a primitive can be collected\n    # A target adjacent cell is (ax, ay) from which a primitive at (px, py) can be \"used\".\n    # Store tuples: (adjacent_x, adjacent_y, primitive_x, primitive_y)\n    target_adjacent_cells = set()\n    for px, py in primitive_locations:\n        # Check all 4 cardinal directions around the primitive\n        for dx_adj, dy_adj, _ in [d for _, d in MOVE_ACTION_DATA]: # Use only the delta components\n            ax, ay = px + dx_adj, py + dy_adj\n\n            # Ensure adjacent cell is within bounds\n            if 0 <= ax < WIDTH and 0 <= ay < HEIGHT:\n                # Assuming agent cannot stand on the primitive itself to collect it.\n                # It must be on an empty or non-primitive cell adjacent to it.\n                # This ensures we're looking for an empty slot next to the primitive.\n                if grid[ax, ay, primitive] == 0: \n                    target_adjacent_cells.add((ax, ay, px, py))\n\n    if not target_adjacent_cells: # No valid adjacent cells found for any primitive (e.g., all are surrounded by other primitives)\n        return []\n\n    # 4. BFS to find the shortest path (in terms of actions) to any target_adjacent_cell\n    # BFS state: (current_x, current_y, current_facing_dir)\n    # BFS queue element: (current_x, current_y, current_facing_dir, path_actions_so_far)\n    \n    queue = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n    # visited set tracks (x, y, dir) to avoid revisiting states with longer paths\n    visited = set([(start_pos[0], start_pos[1], start_dir)]) \n\n    while queue:\n        cx, cy, cdir, cpath = queue.popleft()\n\n        # Check if the current position (cx, cy) is one of the target_adjacent_cells\n        found_target_primitive_pos = None # Stores (px, py) of the primitive to collect\n        for target_ax, target_ay, px, py in target_adjacent_cells:\n            if cx == target_ax and cy == target_ay:\n                found_target_primitive_pos = (px, py)\n                break\n        \n        if found_target_primitive_pos:\n            # We have reached an adjacent cell. Now, turn to face the primitive and use it.\n            px, py = found_target_primitive_pos\n            \n            # Calculate the required direction to face from (cx, cy) towards (px, py)\n            target_dx = px - cx\n            target_dy = py - cy\n\n            required_dir = -1\n            for action_val, (dx_m, dy_m, facing_dir_m) in MOVE_ACTION_DATA:\n                if dx_m == target_dx and dy_m == target_dy:\n                    required_dir = facing_dir_m\n                    break\n            \n            turn_actions = []\n            if cdir != required_dir:\n                # Calculate the shortest sequence of turns (LEFT or RIGHT)\n                # Directions are 0:N, 1:E, 2:S, 3:W (clockwise)\n                turn_right_count = (required_dir - cdir + 4) % 4\n                turn_left_count = (cdir - required_dir + 4) % 4\n\n                if turn_right_count <= turn_left_count:\n                    for _ in range(turn_right_count):\n                        turn_actions.append(ACTION_RIGHT)\n                else:\n                    for _ in range(turn_left_count):\n                        turn_actions.append(ACTION_LEFT)\n            \n            # The complete sequence of actions to reach, face, and use the primitive\n            return cpath + turn_actions + [ACTION_USE]\n\n        # If not at a target_adjacent_cell, explore valid neighbors (move actions)\n        for action_val, (dx, dy, new_dir) in MOVE_ACTION_DATA:\n            nx, ny = cx + dx, cy + dy\n\n            # Check bounds for the new position\n            if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n                continue\n            \n            # Check if this new state (position and direction) has already been visited\n            if (nx, ny, new_dir) not in visited:\n                visited.add((nx, ny, new_dir))\n                queue.append((nx, ny, new_dir, cpath + [action_val]))\n\n    # If BFS completes and no path was found (e.g., primitive is unreachable)\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:32:56.137342", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n  import heapq # For A* search\n\n  # Action constants (from action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map movement vectors (dx, dy) to action IDs.\n  # These actions move the agent AND set its facing direction.\n  MOVE_VEC_TO_ACTION = {\n      (0, -1): UP,    # Move North, face North\n      (0, 1): DOWN,   # Move South, face South\n      (-1, 0): LEFT,  # Move West, face West\n      (1, 0): RIGHT   # Move East, face East\n  }\n\n  # Map agent's internal direction ID to its corresponding facing vector (dx, dy).\n  # 0: North (-Y)\n  # 1: East (+X)\n  # 2: South (+Y)\n  # 3: West (-X)\n  DIR_TO_VEC = {\n      0: (0, -1),  # North\n      1: (1, 0),   # East\n      2: (0, 1),   # South\n      3: (-1, 0)   # West\n  }\n\n  initial_obs = env.observations()\n\n  # Improvement 1: Check if the primitive is already in the inventory.\n  # If so, no collection actions are needed.\n  initial_inventory = initial_obs['features_dict']['inventory']\n  if initial_inventory[primitive] > 0:\n      return [] # Already collected\n\n  initial_grid = initial_obs['features_dict']['features_global']\n  initial_pos = tuple(initial_obs['features_dict']['pos'].astype(int))\n  # Agent's direction is a one-hot vector, convert to integer (0-3)\n  initial_dir = np.argmax(initial_obs['features_dict']['direction'])\n\n  # Grid dimensions: grid is (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = initial_grid.shape\n\n  # Get indices of non-grabbable items (obstacles) from the world\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a coordinate is within grid bounds\n  def is_valid_coord(x, y):\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  # Helper function to check if a cell is traversable.\n  # A cell is not traversable if it contains any non-grabbable entity.\n  def is_traversable(x, y, current_grid):\n      if not is_valid_coord(x, y):\n          return False\n      for idx in non_grabbable_indices:\n          if current_grid[x, y, idx] > 0:\n              return False # Contains an obstacle\n      return True # Traversable\n\n  # Find all locations of the target primitive on the grid.\n  primitive_locations = []\n  for x_coord in range(grid_width):\n      for y_coord in range(grid_height):\n          if initial_grid[x_coord, y_coord, primitive] > 0:\n              primitive_locations.append((x_coord, y_coord))\n\n  # If the primitive is not found on the grid, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # Heuristic function for A* search:\n  # Estimates the minimum number of moves (Manhattan distance) required\n  # to reach a cell adjacent to any primitive location.\n  # This heuristic is admissible (never overestimates the cost).\n  def heuristic(current_x, current_y):\n      min_dist = float('inf')\n      for px, py in primitive_locations:\n          # We need to reach any of the 4 cells adjacent to (px, py)\n          # The closest distance to an adjacent cell is max(0, manhattan_distance - 1)\n          dist = abs(current_x - px) + abs(current_y - py)\n          min_dist = min(min_dist, max(0, dist - 1)) # Distance to be adjacent\n      return min_dist\n\n  # A* search setup:\n  # open_set: Priority queue storing tuples (f_score, (x, y, dir_int)), ordered by f_score.\n  # g_score: Dictionary storing the cost from the start state to a given state (x, y, dir_int).\n  # came_from: Dictionary to reconstruct the path, mapping (next_state) -> (current_state).\n  # actions_to_reach: Dictionary mapping (next_state) -> action_taken_to_reach_next_state.\n  open_set = []\n  g_score = {}\n  came_from = {}\n  actions_to_reach = {}\n\n  start_state = (initial_pos[0], initial_pos[1], initial_dir)\n  g_score[start_state] = 0\n  f_score_start = g_score[start_state] + heuristic(initial_pos[0], initial_pos[1])\n  heapq.heappush(open_set, (f_score_start, start_state))\n\n  while open_set:\n      # Pop the state with the lowest f_score\n      current_f_score, (curr_x, curr_y, curr_dir_int) = heapq.heappop(open_set)\n\n      # Check if the primitive is directly in front of the current position and direction.\n      # If yes, this path is a solution.\n      facing_vec = DIR_TO_VEC[curr_dir_int]\n      front_x, front_y = curr_x + facing_vec[0], curr_y + facing_vec[1]\n\n      if is_valid_coord(front_x, front_y) and initial_grid[front_x, front_y, primitive] > 0:\n          # Path found: Reconstruct the sequence of actions.\n          path = []\n          current = (curr_x, curr_y, curr_dir_int)\n          while current != start_state:\n              path.insert(0, actions_to_reach[current])\n              current = came_from[current]\n          return path + [USE] # Add the final USE action\n\n      # Explore possible moves (UP, DOWN, LEFT, RIGHT).\n      # Each move action also changes the agent's direction to the direction of movement.\n      for move_vec, move_action in MOVE_VEC_TO_ACTION.items():\n          next_x, next_y = curr_x + move_vec[0], curr_y + move_vec[1]\n          next_dir_int = move_action # The new direction is set by the move action itself.\n          next_state = (next_x, next_y, next_dir_int)\n\n          # Calculate tentative g_score for the next state (cost is 1 for each action).\n          tentative_g_score = g_score[(curr_x, curr_y, curr_dir_int)] + 1\n\n          # Check if the next cell is traversable and if this path is better (shorter)\n          # than any previously found path to `next_state`.\n          if is_traversable(next_x, next_y, initial_grid):\n              if next_state not in g_score or tentative_g_score < g_score[next_state]:\n                  g_score[next_state] = tentative_g_score\n                  f_score_next = tentative_g_score + heuristic(next_x, next_y)\n                  heapq.heappush(open_set, (f_score_next, next_state))\n                  came_from[next_state] = (curr_x, curr_y, curr_dir_int)\n                  actions_to_reach[next_state] = move_action\n\n  # If the open_set becomes empty and no path was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": -1}}
