{"timestamp": "2025-07-30T16:48:20.486323", "function_name": "collect", "function_body": "    import collections\n\n    # Define action constants based on the problem description's action_specs()\n    # (DOWN:0, UP:1, LEFT:2, RIGHT:3, USE:4)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    state = env._current_state\n    world = state.world\n\n    # 0. Check if primitive is already in inventory\n    if state.inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions\n    grid_width, grid_height, _ = state.grid.shape\n\n    # Define movement directions and corresponding actions\n    movement_actions = {\n        (0, 1): ACTION_DOWN,   # Delta (dx, dy) -> Action\n        (0, -1): ACTION_UP,\n        (1, 0): ACTION_RIGHT,\n        (-1, 0): ACTION_LEFT,\n    }\n\n    # Find all cells containing the primitive on the grid\n    primitive_locations = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            # Assuming primitive occupies a single \"slot\" in the one-hot encoding\n            if state.grid[x, y, primitive] > 0: \n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        # Primitive not found on the map, cannot collect\n        return []\n\n    # BFS for pathfinding\n    # Queue stores tuples of (current_position, actions_taken_to_reach_here)\n    q = collections.deque([(state.pos, [])]) \n    # Track visited positions to avoid cycles and redundant paths.\n    visited = {state.pos} \n\n    while q:\n        curr_pos, path = q.popleft()\n\n        # Check if the current agent position is \"adjacent\" to any primitive location.\n        # \"Adjacent\" in CraftWorld usually means within a 3x3 square (including the cell itself),\n        # matching the logic of CraftState.next_to.\n        is_adjacent_to_primitive = False\n        for px, py in primitive_locations:\n            # Check if (px, py) is within the 3x3 neighborhood of curr_pos\n            if abs(curr_pos[0] - px) <= 1 and abs(curr_pos[1] - py) <= 1:\n                is_adjacent_to_primitive = True\n                break\n        \n        if is_adjacent_to_primitive:\n            # Found a path to a position from which we can interact with the primitive.\n            # Add the USE action and return the complete path.\n            return path + [ACTION_USE]\n\n        # Explore neighbors (move actions)\n        for (dx, dy), action in movement_actions.items():\n            next_pos = (curr_pos[0] + dx, curr_pos[1] + dy)\n\n            # Check if next_pos is within grid bounds\n            if 0 <= next_pos[0] < grid_width and 0 <= next_pos[1] < grid_height:\n                # Assume all in-bounds cells are traversable for movement unless specified otherwise.\n                # CraftWorld doesn't explicitly define impassable terrain types for simple movement\n                # in this context; boundaries are the primary constraint.\n                \n                # Check if next_pos has not been visited\n                if next_pos not in visited:\n                    visited.add(next_pos)\n                    q.append((next_pos, path + [action]))\n\n    # If the BFS completes without finding a path, it means the primitive is unreachable.\n    return []", "island_id": 5, "scores": {"3": -1}}
