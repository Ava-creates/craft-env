{"timestamp": "2025-07-30T19:52:20.422703", "function_name": "collect", "function_body": "    import collections\n    from enum import IntEnum\n\n    # Constants must be defined within the function scope if not globally imported\n    # or available in the specific execution environment.\n    class Action(IntEnum):\n        DOWN = 0\n        UP = 1\n        LEFT = 2\n        RIGHT = 3\n        USE = 4\n\n    ACTION_DOWN = Action.DOWN\n    ACTION_UP = Action.UP\n    ACTION_LEFT = Action.LEFT\n    ACTION_RIGHT = Action.RIGHT\n    ACTION_USE = Action.USE\n\n    DIR_EAST = 0\n    DIR_SOUTH = 1\n    DIR_WEST = 2\n    DIR_NORTH = 3\n\n    RELATIVE_TARGET_TO_REQUIRED_DIR = {\n        (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n        (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n        (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n        (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n    }\n\n    MAX_COLLECT_STEPS = 100 \n\n    actions_taken = []\n    \n    # Reset the environment to get the initial state\n    current_obs = env.reset() \n    current_state = env._current_state # Access the underlying CraftState instance\n\n    # Initial checks\n    if primitive not in current_state.world.cookbook.kinds:\n        return [] # The specified primitive ID is not recognized\n    if current_state.inventory[primitive] > 0:\n        return [] # The primitive has already been collected\n\n    full_grid = current_state.features_dict()['features_global']\n    start_pos = current_state.pos\n    start_dir = current_state.dir\n    grid_height, grid_width, _ = full_grid.shape # Get grid dimensions for validation\n\n    # Get indices for categorizing entities (e.g., for traversability rules)\n    grabbable_indices = current_state.world.grabbable_indices\n    non_grabbable_indices = current_state.world.non_grabbable_indices\n\n    # --- Pre-compute all potential target (agent_y, agent_x, agent_dir) states ---\n    # These are the (agent_y, agent_x, agent_dir) states from which an agent\n    # can perform ACTION_USE to collect the primitive.\n    collectable_target_states = set()\n    \n    # Iterate over the grid to find all instances of the primitive\n    for py in range(grid_height):\n        for px in range(grid_width):\n            if full_grid[py, px, primitive] > 0:\n                # Case 1: Primitive is a grabbable item that can be picked up by being on its square\n                # and then using ACTION_USE. This assumes the primitive's cell is traversable.\n                is_primitive_traversable_for_movement = (primitive not in non_grabbable_indices)\n                is_grabbable_type = (primitive in grabbable_indices)\n                \n                if is_grabbable_type and is_primitive_traversable_for_movement:\n                    # Agent can move onto the primitive's cell (py, px).\n                    # Assume ACTION_USE works from any direction if on the same cell.\n                    # Add all four directions to collectable_target_states to allow BFS\n                    # to find a path without needing a specific final orientation.\n                    collectable_target_states.add((py, px, DIR_EAST))\n                    collectable_target_states.add((py, px, DIR_SOUTH))\n                    collectable_target_states.add((py, px, DIR_WEST))\n                    collectable_target_states.add((py, px, DIR_NORTH))\n\n                # Case 2: Primitive is a non-traversable resource (e.g., tree, stone block, water)\n                # or a grabbable item that *is* a non-grabbable/non-traversable map feature.\n                # Agent must be adjacent and face it to use it.\n                for rel_dy, rel_dx in RELATIVE_TARGET_TO_REQUIRED_DIR.keys():\n                    agent_y, agent_x = py - rel_dy, px - rel_dx\n                    required_agent_dir = RELATIVE_TARGET_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n                    # Check if this potential agent position is within grid bounds\n                    if 0 <= agent_y < grid_height and 0 <= agent_x < grid_width:\n                        # Check if the adjacent position itself is traversable for the agent to stand on.\n                        is_adj_pos_traversable = True\n                        for k_idx in non_grabbable_indices:\n                            if full_grid[agent_y, agent_x, k_idx] > 0:\n                                is_adj_pos_traversable = False\n                                break\n                        \n                        if is_adj_pos_traversable:\n                            collectable_target_states.add((agent_y, agent_x, required_agent_dir))\n    \n    if not collectable_target_states:\n        # No instances of the primitive found on the grid, or no valid collection points.\n        return [] \n\n    # --- Breadth-First Search (BFS) to find the shortest path to any target state ---\n    q = collections.deque()\n    # BFS state: (current_y, current_x, current_dir, path_of_actions)\n    q.append((start_pos[0], start_pos[1], start_dir, []))\n    \n    # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n    visited = {(start_pos[0], start_pos[1], start_dir)}\n\n    # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n    moves_options = [\n        (-1, 0, ACTION_UP, DIR_NORTH),\n        (1, 0, ACTION_DOWN, DIR_SOUTH),\n        (0, -1, ACTION_LEFT, DIR_WEST),\n        (0, 1, ACTION_RIGHT, DIR_EAST)\n    ]\n\n    path_to_primitive_collection = None\n\n    while q:\n        curr_y, curr_x, curr_dir, path_actions = q.popleft()\n        \n        # Check if current state (position and orientation) is one of our\n        # pre-computed collectable target states.\n        if (curr_y, curr_x, curr_dir) in collectable_target_states:\n            path_to_primitive_collection = path_actions\n            break # Found the shortest path to a valid collection point, exit BFS\n\n        # Explore neighboring cells\n        for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n            next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n            # Check bounds for the next cell\n            if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                continue\n\n            # Check if the next cell is traversable for movement.\n            # Impassable kinds are defined in the world's non_grabbable_indices.\n            is_traversable_for_movement = True\n            for k_idx in non_grabbable_indices:\n                if full_grid[next_y, next_x, k_idx] > 0:\n                    is_traversable_for_movement = False\n                    break\n            if not is_traversable_for_movement:\n                continue\n            \n            # Add to queue only if this new state (position and direction) hasn't been visited\n            if (next_y, next_x, new_dir_after_move) not in visited:\n                visited.add((next_y, next_x, new_dir_after_move))\n                q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n    \n    if path_to_primitive_collection is None:\n        return [] # No path found to any collectable primitive target state\n\n    # --- Execute the found path and perform the collection ---\n    \n    # Ensure the total number of actions (path + final USE) does not exceed MAX_COLLECT_STEPS\n    if len(path_to_primitive_collection) + 1 > MAX_COLLECT_STEPS:\n        return [] # Path is too long\n\n    # Execute the movements found by BFS\n    for action in path_to_primitive_collection:\n        actions_taken.append(action)\n        _, _, _ = env.step(action) # Take the step, update env's internal state\n        current_state = env._current_state # Update our reference to the current CraftState\n\n    # After executing all movement actions, the agent should be at the correct position\n    # and facing the correct direction as determined by the BFS. Now, perform the USE action.\n    actions_taken.append(ACTION_USE)\n    _, _, _ = env.step(ACTION_USE)\n    current_state = env._current_state # Update state after the USE action\n\n    # Final check: Confirm the primitive was successfully collected into inventory\n    if current_state.inventory[primitive] > 0:\n        return actions_taken # Successfully collected!\n    else:\n        # Collection failed even after reaching the correct position/orientation and attempting USE.\n        # This could happen if the primitive requires a tool, is depleted, or other unseen game mechanics.\n        return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:53:27.066597", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      ACTION_UP: DIR_NORTH,   # Agent moves North, faces North\n      ACTION_DOWN: DIR_SOUTH, # Agent moves South, faces South\n      ACTION_LEFT: DIR_WEST,  # Agent moves West, faces West\n      ACTION_RIGHT: DIR_EAST  # Agent moves East, faces East\n  }\n\n  # Maximum number of steps allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent,\n      based on CraftState.dir (0=East, 1=South, 2=West, 3=North).\n      \"\"\"\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return (y, x) # Fallback, should not be reached with valid directions\n\n  actions_taken = []\n\n  # Access the underlying CraftState instance to get the current state information.\n  current_state = env._current_state\n\n  # Improvement 1: Check if the primitive is actually a grabbable item.\n  # If it's not in the world's grabbable_indices, it cannot be collected by ACTION_USE.\n  if primitive not in current_state.world.grabbable_indices:\n      return []\n\n  # Basic validation: Ensure the `primitive` is a recognized entity kind in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # Optimization: If the `primitive` is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Retrieve necessary environment information for pathfinding.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, n_kinds = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir # Use current_state.dir, as env is not reset to init_dir.\n\n  # Improvement 2: Pre-calculate an impassable mask for efficient checking.\n  # Create a boolean mask where True indicates an impassable kind.\n  impassable_mask = np.zeros(n_kinds, dtype=bool)\n\n  # Water is typically impassable for movement.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_mask[current_state.world.water_index] = True\n  \n  # Any non-grabbable items that are NOT workshops are generally impassable.\n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in current_state.world.workshop_indices:\n          if k_idx < n_kinds: # Ensure index is within bounds of the grid's kind dimension\n              impassable_mask[k_idx] = True\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # Format: {action: (resulting_direction_after_move, dy, dx)}\n  movement_actions_map = {\n      ACTION_UP:    (ACTION_TO_DIR[ACTION_UP], -1, 0),    # Move North (dy=-1, dx=0), new dir=DIR_NORTH\n      ACTION_DOWN:  (ACTION_TO_DIR[ACTION_DOWN], 1, 0),   # Move South (dy=1, dx=0), new dir=DIR_SOUTH\n      ACTION_LEFT:  (ACTION_TO_DIR[ACTION_LEFT], 0, -1),  # Move West (dy=0, dx=-1), new dir=DIR_WEST\n      ACTION_RIGHT: (ACTION_TO_DIR[ACTION_RIGHT], 0, 1)  # Move East (dy=0, dx=1), new dir=DIR_EAST\n  }\n\n  q = collections.deque()\n  # BFS queue state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  q.append((start_y, start_x, start_dir, []))\n  \n  # Keep track of visited states to prevent redundant exploration and infinite loops.\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None\n\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # If the current path length already exceeds MAX_COLLECT_STEPS, prune this branch.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # Calculate the coordinates of the grid cell that the agent is currently facing.\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Check if the facing cell is within grid boundaries and contains the target primitive.\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n          full_grid[facing_y, facing_x, primitive] > 0):\n\n          # We've found a suitable position and orientation. Append ACTION_USE.\n          candidate_path = path + [ACTION_USE]\n\n          # Ensure the complete path (including ACTION_USE) is within the step limit.\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              break # Found the shortest path, exit BFS.\n\n      # Explore all possible next states from the current state.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Pruning: If this move makes the path too long (considering potential final USE action).\n          if len(path) + 1 >= MAX_COLLECT_STEPS: # +1 for the movement itself\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Improvement 2 (cont.): Efficiently check if the next cell is traversable using the mask.\n          # `np.any(full_grid[next_y, next_x, impassable_mask])` will be True if any impassable kind\n          # is present at the target cell.\n          if np.any(full_grid[next_y, next_x, impassable_mask]):\n              continue\n\n          # Check if this new (position, direction) state has already been visited.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # Add the new state to the queue for further exploration.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      return [] # No valid path was found.\n\n  for action in path_to_execute:\n      actions_taken.append(action)\n      reward, done, _ = env.step(action)\n      current_state = env._current_state # Update state after the step\n\n      # Check for early termination of the episode or if goal is satisfied.\n      if done and current_state.inventory[primitive] <= 0:\n          return [] # Episode ended, but primitive not collected.\n\n      if current_state.inventory[primitive] > 0:\n          return actions_taken # Primitive collected, stop executing.\n\n  # Final check after executing all actions in `path_to_execute`.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # This case should ideally not be reached if the BFS path was valid and\n      # environment mechanics are consistent, but included for robustness.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:53:28.067067", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions based on _get_facing_coords and common CraftWorld conventions.\n  # This mapping is crucial for correctly interpreting agent orientation.\n  # Assuming: 0=North (facing -Y), 1=East (facing +X), 2=South (facing +Y), 3=West (facing -X)\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Mapping of movement action to the resulting agent's facing direction.\n  # When an agent moves, it automatically reorients itself to face the direction of movement.\n  ACTION_TO_DIR = {\n      ACTION_UP:    DIR_NORTH,   # Agent moves North, faces North\n      ACTION_RIGHT: DIR_EAST,    # Agent moves East, faces East\n      ACTION_DOWN:  DIR_SOUTH,   # Agent moves South, faces South\n      ACTION_LEFT:  DIR_WEST     # Agent moves West, faces West\n  }\n\n  # Maximum number of steps allowed for collection, including movements and the final USE action.\n  # This prevents excessively long computations or paths in complex environments.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent.\n  # This function relies on the DIR_* constant mapping defined above.\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent,\n      based on the agent's current (y, x) position and direction.\n      \"\"\"\n      if direction == DIR_NORTH:\n          return (y - 1, x)\n      elif direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      return (y, x) # Should not be reached with valid directions\n\n  actions_taken = []\n\n  # Access the underlying CraftState instance from the CraftLab environment.\n  # This allows direct access to the current grid, inventory, position, and direction.\n  current_state = env._current_state\n\n  # --- Pre-computation and Validation Checks ---\n\n  # 1. Validate 'primitive' ID: Ensure it's a recognized entity kind in the world.\n  if primitive not in current_state.world.cookbook.kinds:\n      # If the primitive ID is unknown, it cannot be collected.\n      return []\n\n  # 2. Grabbability Check: Ensure the primitive can actually be collected via ACTION_USE.\n  # Non-grabbable items typically cannot be picked up.\n  if primitive not in current_state.world.grabbable_indices:\n      return []\n\n  # 3. Inventory Check: If the primitive is already in the inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Retrieve grid dimensions and agent's current position and direction.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir # Use current_state.dir, as this function plans from current state.\n\n  # Determine which entity kinds are impassable for agent movement.\n  # An entity is impassable if it's non-grabbable AND not a workshop (workshops are traversable).\n  # Explicitly add water if it exists and is considered impassable.\n  impassable_for_movement = set()\n  \n  # Add all non-grabbable items that are not workshops (as workshops are traversable).\n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n  \n  # Ensure water is explicitly considered impassable if it exists in the world.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n\n  # Define movement actions and their resulting new agent direction and grid coordinate changes.\n  # Format: {action: (resulting_direction_after_move, dy, dx)}\n  movement_actions_map = {\n      ACTION_UP:    (ACTION_TO_DIR[ACTION_UP], -1, 0),\n      ACTION_RIGHT: (ACTION_TO_DIR[ACTION_RIGHT], 0, 1),\n      ACTION_DOWN:  (ACTION_TO_DIR[ACTION_DOWN], 1, 0),\n      ACTION_LEFT:  (ACTION_TO_DIR[ACTION_LEFT], 0, -1)\n  }\n\n  q = collections.deque()\n  # BFS queue state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  # The direction is included in the state to correctly handle the 'ACTION_USE' requirement\n  # of facing the target primitive.\n  q.append((start_y, start_x, start_dir, []))\n  \n  # The 'visited' set keeps track of (position, direction) tuples to prevent redundant\n  # exploration and infinite loops in environments with cycles.\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None  # Stores the shortest action sequence to achieve collection.\n\n  # If the maximum allowed steps is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # --- Breadth-First Search (BFS) for Pathfinding ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Pruning 1: If the current path length already equals or exceeds the maximum allowed steps,\n      # any further expansion (including the final ACTION_USE) will make it too long.\n      # We check 'len(path) >= MAX_COLLECT_STEPS' here because at least one more action (USE)\n      # is required to collect the primitive.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # Check if the primitive is located in the cell directly in front of the agent.\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Ensure the facing coordinates are within grid boundaries.\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width):\n          # Check if the target primitive is actually in the cell the agent is facing.\n          if full_grid[facing_y, facing_x, primitive] > 0:\n              # A suitable position and orientation has been found to perform ACTION_USE.\n              candidate_path = path + [ACTION_USE]\n\n              # Pruning 2: Ensure the complete path (including ACTION_USE) is within the step limit.\n              if len(candidate_path) <= MAX_COLLECT_STEPS:\n                  path_to_execute = candidate_path\n                  # BFS guarantees the shortest path is found first, so we can terminate.\n                  break # Exit the BFS loop\n\n      # Explore all possible next states by trying each movement action.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Pruning 3: Check if adding this movement action would exceed the maximum steps\n          # even before considering the final ACTION_USE.\n          if len(path) + 1 >= MAX_COLLECT_STEPS:\n              continue\n\n          # Check if the next agent position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable.\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # Check if this (position, direction) state has already been visited.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # If all checks pass, add the new state to the queue for further exploration.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n\n  # --- Path Execution and Verification ---\n\n  # If no valid path was found by the BFS, return an empty list.\n  if path_to_execute is None:\n      return []\n\n  # Execute the found action sequence step by step.\n  for action in path_to_execute:\n      actions_taken.append(action)\n      reward, done, _ = env.step(action) # Apply the action to the environment.\n      current_state = env._current_state # Update the state reference to reflect environment changes.\n\n      # Check if the episode ended prematurely (e.g., due to CraftLab's max_steps).\n      # If the episode is done and the primitive was not collected, the path failed.\n      if done and current_state.inventory[primitive] <= 0:\n          return [] \n\n      # If the primitive is successfully collected, we can stop and return the actions taken so far.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n  # Final check after all actions in the path have been executed.\n  # This covers the edge case where the primitive is collected by the very last action.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it implies an unexpected state change or a mismatch between pathfinding\n      # assumptions and dynamic environment mechanics.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:54:51.992130", "function_name": "collect", "function_body": "  # Action constants (standard for this environment, defined here to fit the request)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  current_state = env._current_state\n  \n  # Check if the primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n    return [] # Already collected\n\n  actions = []\n  agent_pos = current_state.pos\n  grid = current_state.grid\n  \n  # Find the primitive's location on the grid\n  target_x, target_y = -1, -1\n  width, height, _ = grid.shape \n\n  for x in range(width):\n    for y in range(height):\n      # Assuming primitive is represented by a 1 in its specific channel\n      if grid[x, y, primitive] == 1: \n        target_x, target_y = x, y\n        break\n    if target_x != -1:\n      break\n\n  if target_x == -1:\n    # Primitive not found on the grid\n    return []\n\n  # Calculate potential adjacent target positions\n  # The agent needs to move to a square adjacent to the primitive's location\n  # before using the 'USE' action.\n  potential_adj_targets = []\n  \n  # Check horizontal neighbors\n  if target_x + 1 < width:\n    potential_adj_targets.append((target_x + 1, target_y))\n  if target_x - 1 >= 0:\n    potential_adj_targets.append((target_x - 1, target_y))\n  \n  # Check vertical neighbors\n  if target_y + 1 < height:\n    potential_adj_targets.append((target_x, target_y + 1))\n  if target_y - 1 >= 0:\n    potential_adj_targets.append((target_x, target_y - 1))\n\n  # Find the closest valid adjacent target square to the agent's current position\n  closest_adj_x, closest_adj_y = -1, -1\n  min_dist = float('inf')\n\n  for px, py in potential_adj_targets:\n    dist = abs(px - agent_pos[0]) + abs(py - agent_pos[1]) # Manhattan distance\n    if dist < min_dist:\n      min_dist = dist\n      closest_adj_x, closest_adj_y = px, py\n  \n  if closest_adj_x == -1:\n    # No valid adjacent square found (e.g., item in a 1x1 world corner)\n    return []\n\n  # Generate actions to path from current_state.pos to (closest_adj_x, closest_adj_y)\n  ax, ay = agent_pos[0], agent_pos[1]\n  \n  # Move horizontally\n  while ax != closest_adj_x:\n    if ax < closest_adj_x:\n      actions.append(RIGHT)\n      ax += 1\n    else: # ax > closest_adj_x\n      actions.append(LEFT)\n      ax -= 1\n\n  # Move vertically\n  while ay != closest_adj_y:\n    if ay < closest_adj_y:\n      actions.append(DOWN)\n      ay += 1\n    else: # ay > closest_adj_y\n      actions.append(UP)\n      ay -= 1\n\n  # After moving to the adjacent square, perform the USE action\n  actions.append(USE)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:54:52.061754", "function_name": "collect", "function_body": "    # 1. Initial Check: If primitive is already in inventory, return empty list.\n    obs = env.observations()\n    inventory = obs['features_dict']['inventory']\n    if inventory[primitive] > 0:\n        return []\n\n    # Get environment details\n    grid = obs['features_dict']['features_global']\n    # Grid shape is (WIDTH, HEIGHT, n_kinds)\n    grid_width, grid_height, _ = grid.shape\n    \n    # Current agent position (denormalized from normalized features_dict['pos'])\n    # features_dict['pos'] is (normalized_x, normalized_y)\n    current_pos_normalized = obs['features_dict']['pos']\n    current_x = int(current_pos_normalized[0] * grid_width)\n    current_y = int(current_pos_normalized[1] * grid_height)\n    start_pos = (current_x, current_y)\n\n    # Get indices of non-grabbable entities (obstacles)\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # Get action mappings from the environment (e.g., 'DOWN': 0)\n    action_map = env.action_specs()\n    \n    # Define movement deltas and their corresponding actions\n    # Assuming grid indexing is (x, y) where x is horizontal (width), y is vertical (height)\n    # actions.DOWN: move +y\n    # actions.UP: move -y\n    # actions.LEFT: move -x\n    # actions.RIGHT: move +x\n    move_deltas = {\n        action_map['DOWN']: (0, 1),   # (dx, dy)\n        action_map['UP']: (0, -1),\n        action_map['LEFT']: (-1, 0),\n        action_map['RIGHT']: (1, 0),\n    }\n\n    # 2. Find Primitive Location(s)\n    # np.argwhere returns (x, y) coordinates for non-zero elements in grid[:, :, primitive]\n    primitive_coords = np.argwhere(grid[:, :, primitive] == 1)\n\n    if len(primitive_coords) == 0:\n        # Primitive not found on the grid\n        return []\n\n    # For simplicity, target the first found instance of the primitive\n    target_x, target_y = primitive_coords[0]\n    \n    # Calculate all cells directly adjacent to the target primitive.\n    # The agent needs to reach one of these cells to 'USE' the primitive.\n    target_adjacent_cells = set()\n    adj_offsets = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Left, Right, Up, Down (relative to target)\n    for dx_adj, dy_adj in adj_offsets:\n        adj_x, adj_y = target_x + dx_adj, target_y + dy_adj\n        # Check if adjacent cell is within grid bounds\n        if 0 <= adj_x < grid_width and 0 <= adj_y < grid_height:\n            target_adjacent_cells.add((adj_x, adj_y))\n\n    # BFS for pathfinding to an adjacent cell\n    # Queue stores tuples: (current_x, current_y, list_of_actions_to_reach_here)\n    # Using a list as a queue (less efficient pop(0) than deque, but avoids extra import)\n    queue = [(start_pos[0], start_pos[1], [])]\n    visited = set([(start_pos[0], start_pos[1])])\n\n    while queue:\n        curr_x, curr_y, path_actions = queue.pop(0) # Dequeue first element\n\n        # Check if current position is adjacent to the primitive\n        if (curr_x, curr_y) in target_adjacent_cells:\n            # Path found! Add the USE action and return the complete sequence.\n            return path_actions + [action_map['USE']]\n\n        # Explore neighbors\n        for action, (dx, dy) in move_deltas.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n\n            # Check bounds\n            if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n                continue\n\n            # Check if cell is an obstacle (contains non-grabbable item)\n            is_obstacle = False\n            for k_idx in non_grabbable_indices:\n                if grid[next_x, next_y, k_idx] == 1:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n\n            # If the neighbor has not been visited, add it to the queue\n            if (next_x, next_y) not in visited:\n                visited.add((next_x, next_y))\n                queue.append((next_x, next_y, path_actions + [action]))\n\n    # If BFS completes and no path to an adjacent cell was found\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:56:37.579499", "function_name": "collect", "function_body": "    # Get the current state directly from the environment\n    # CraftLab wraps CraftState as _current_state\n    initial_state = env._current_state\n    \n    # If the primitive is already in inventory, no actions needed\n    if initial_state.satisfies(None, primitive):\n        return []\n\n    # Action constants (from DMLab/CraftWorld typically)\n    # These are mapped by CraftLab.action_specs(): DOWN->0, UP->1, LEFT->2, RIGHT->3, USE->4\n    # It's better to use env_factory.actions directly for clarity.\n    # e.g., env_factory.actions.UP\n\n    # Direction constants (agent's internal direction, 0:N, 1:E, 2:S, 3:W)\n    DIR_NORTH = 0\n    DIR_EAST = 1\n    DIR_SOUTH = 2\n    DIR_WEST = 3\n\n    # Mapping actions to their resulting agent direction and (dx, dy) movement\n    # Note: In CraftWorld, movement actions (UP, DOWN, LEFT, RIGHT) also rotate the agent\n    # to face the direction of movement.\n    ACTION_INFO = {\n        env_factory.actions.UP:    {'delta': (0, -1), 'new_dir': DIR_NORTH},\n        env_factory.actions.DOWN:  {'delta': (0, 1),  'new_dir': DIR_SOUTH},\n        env_factory.actions.LEFT:  {'delta': (-1, 0), 'new_dir': DIR_WEST},\n        env_factory.actions.RIGHT: {'delta': (1, 0),  'new_dir': DIR_EAST},\n    }\n\n    # Initialize BFS queue: ((pos_x, pos_y), agent_dir, [list_of_actions_taken])\n    start_pos_tuple = (initial_state.pos[0], initial_state.pos[1])\n    start_dir = initial_state.dir\n\n    queue = collections.deque([(start_pos_tuple, start_dir, [])])\n    \n    # Visited set to avoid cycles and redundant exploration: ((pos_x, pos_y), agent_dir)\n    visited = set([(start_pos_tuple, start_dir)])\n\n    grid_width, grid_height, _ = initial_state.grid.shape\n    \n    # Identify items that block movement. These are typically `non_grabbable_indices`\n    # (e.g., walls, water, workshops) as defined in the CraftWorld.\n    blocked_movement_kinds = set(env.world.non_grabbable_indices)\n    \n    # Find all locations of the primitive on the initial grid.\n    # We assume the primitive is fixed on the grid and doesn't move or get depleted\n    # until a successful USE action (which is the goal of this function).\n    primitive_locations = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if initial_state.grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n    \n    if not primitive_locations:\n        return [] # Primitive not found on the map\n\n    while queue:\n        (curr_x, curr_y), curr_dir, path_so_far = queue.popleft()\n\n        # Check if the current agent position and direction allows for a successful USE action.\n        # This means the agent must be facing a cell that contains the primitive.\n        \n        # Calculate coordinates of the cell directly in front of the agent\n        # (dx, dy) represents the delta from agent's position to the cell it's facing\n        face_dx, face_dy = 0, 0\n        if curr_dir == DIR_NORTH:\n            face_dx, face_dy = 0, -1\n        elif curr_dir == DIR_EAST:\n            face_dx, face_dy = 1, 0\n        elif curr_dir == DIR_SOUTH:\n            face_dx, face_dy = 0, 1\n        elif curr_dir == DIR_WEST:\n            face_dx, face_dy = -1, 0\n        \n        faced_x, faced_y = curr_x + face_dx, curr_y + face_dy\n\n        # Check if the cell faced is within bounds and contains the target primitive\n        if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n                (faced_x, faced_y) in primitive_locations):\n            # If the agent is positioned correctly and facing the primitive,\n            # we can append the USE action and return the path.\n            return path_so_far + [env_factory.actions.USE]\n\n        # Explore possible next states by trying movement actions (UP, DOWN, LEFT, RIGHT)\n        for action_type, info in ACTION_INFO.items():\n            dx, dy = info['delta']\n            next_dir = info['new_dir'] # The direction the agent will face after this move\n            \n            next_x, next_y = curr_x + dx, curr_y + dy\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n                continue\n\n            # Check if the next cell is blocked by any non-traversable object.\n            # We iterate through all kinds that are present in the `next_x, next_y` cell\n            # and see if any of them are in our `blocked_movement_kinds` set.\n            is_blocked = False\n            # Iterate over all possible kind indices at the potential next cell\n            for k_idx in range(initial_state.grid.shape[2]): \n                if initial_state.grid[next_x, next_y, k_idx] > 0: # If this kind is present in the cell\n                    if k_idx in blocked_movement_kinds: # And this kind is considered a blocking type\n                        is_blocked = True\n                        break\n            \n            if is_blocked:\n                continue # This path is blocked, skip to the next action\n\n            # If not blocked, add the new state to the queue if not visited\n            next_state_tuple = ((next_x, next_y), next_dir)\n            if next_state_tuple not in visited:\n                visited.add(next_state_tuple)\n                new_path = path_so_far + [action_type]\n                queue.append((next_state_tuple[0], next_state_tuple[1], new_path))\n    \n    return [] # No path found to collect the primitive", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:56:37.660055", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action mappings (as defined by CraftLab)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Direction vectors for (dx, dy) for agent's facing direction\n    # dir 0: SOUTH (dy=+1) - moving down in grid y-coordinate\n    # dir 1: NORTH (dy=-1) - moving up in grid y-coordinate\n    # dir 2: WEST (dx=-1)  - moving left in grid x-coordinate\n    # dir 3: EAST (dx=+1)  - moving right in grid x-coordinate\n    AGENT_DIR_VECS = {\n        0: (0, 1),  # SOUTH\n        1: (0, -1), # NORTH\n        2: (-1, 0), # WEST\n        3: (1, 0),  # EAST\n    }\n\n    def _get_facing_coords(pos, d):\n        \"\"\"Returns (x, y) coordinates of the cell directly in front of the agent.\"\"\"\n        dx, dy = AGENT_DIR_VECS[d]\n        return (pos[0] + dx, pos[1] + dy)\n\n    def _simulate_step(current_pos, current_dir, action, grid_shape):\n        \"\"\"\n        Simulates the agent's movement or turn based on the action.\n        Returns new_pos, new_dir.\n        Assumes grid boundaries are impassable. Does not account for in-grid obstacles.\n        \"\"\"\n        new_pos = current_pos\n        new_dir = current_dir\n\n        width, height, _ = grid_shape\n\n        if action == ACTION_UP:  # Move forward\n            dx, dy = AGENT_DIR_VECS[current_dir]\n            nx, ny = current_pos[0] + dx, current_pos[1] + dy\n            # Check boundaries; if moving out of bounds, agent stays in place\n            if 0 <= nx < width and 0 <= ny < height:\n                new_pos = (nx, ny)\n        elif action == ACTION_DOWN:  # Move backward\n            # Calculate the direction opposite to the current facing direction\n            opposite_dir = (current_dir + 2) % 4\n            dx, dy = AGENT_DIR_VECS[opposite_dir]\n            nx, ny = current_pos[0] + dx, current_pos[1] + dy\n            # Check boundaries\n            if 0 <= nx < width and 0 <= ny < height:\n                new_pos = (nx, ny)\n        elif action == ACTION_LEFT:  # Turn left\n            # Rotate direction counter-clockwise (e.g., SOUTH(0) -> EAST(3) -> NORTH(1) -> WEST(2) -> SOUTH(0))\n            new_dir = (current_dir + 1) % 4\n        elif action == ACTION_RIGHT:  # Turn right\n            # Rotate direction clockwise (e.g., SOUTH(0) -> WEST(2) -> NORTH(1) -> EAST(3) -> SOUTH(0))\n            new_dir = (current_dir - 1) % 4\n            # Python's modulo operator can return negative for negative inputs, adjust\n            if new_dir < 0:\n                new_dir += 4\n        # ACTION_USE does not change position or direction in this pathfinding simulation\n\n        return new_pos, new_dir\n\n    # Get the current state information from the environment\n    initial_state = env._current_state\n    start_pos = initial_state.pos\n    start_dir = initial_state.dir\n    grid_data = initial_state.grid # The grid is considered static for pathfinding\n    grid_shape = grid_data.shape\n\n    # Find all locations on the grid where the primitive exists\n    # np.argwhere returns (row_index, col_index) for a 2D array.\n    # Our grid indexing is (x_column, y_row, kind_idx).\n    # So if (row, col) from argwhere, it corresponds to (x=col, y=row) in our grid.\n    primitive_locations_raw = np.argwhere(grid_data[:, :, primitive] > 0)\n    primitive_locations = set()\n    for y, x in primitive_locations_raw: # argwhere gives (row, col) which maps to (y, x)\n        primitive_locations.add((x, y))\n\n    if not primitive_locations:\n        # If the primitive is not found anywhere on the map, it's unreachable.\n        return []\n\n    # Initialize BFS queue: (current_position, current_direction, list_of_actions_taken)\n    q = collections.deque([(start_pos, start_dir, [])])\n    # Initialize visited set: (position, direction) tuples to avoid redundant exploration and cycles\n    visited = {(start_pos, start_dir)}\n\n    # Perform BFS\n    while q:\n        current_pos, current_dir, path_actions = q.popleft()\n\n        # Check if the cell directly in front of the agent contains the primitive\n        facing_x, facing_y = _get_facing_coords(current_pos, current_dir)\n        if (facing_x, facing_y) in primitive_locations:\n            # We have found a path to a state where the agent is facing a primitive.\n            # Append the USE action to perform the collection and return the complete path.\n            return path_actions + [ACTION_USE]\n\n        # Explore all possible next states by trying each movement/turn action\n        for action in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n            new_pos, new_dir = _simulate_step(current_pos, current_dir, action, grid_shape)\n            next_state_tuple = (new_pos, new_dir)\n\n            # If this new state (position and direction) has not been visited, add it to the queue\n            if next_state_tuple not in visited:\n                visited.add(next_state_tuple)\n                q.append((new_pos, new_dir, path_actions + [action]))\n\n    # If the BFS completes and the queue becomes empty without finding a path\n    # to a state where a primitive can be used, the primitive is unreachable.\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:58:11.372422", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants based on CraftLab.action_specs\n  # (dx, dy) mapping to action IDs\n  _ACTION_MAP_MOVEMENT = {\n      (0, 1): 0,   # (dx=0, dy=1) -> DOWN\n      (0, -1): 1,  # (dx=0, dy=-1) -> UP\n      (-1, 0): 2,  # (dx=-1, dy=0) -> LEFT\n      (1, 0): 3,   # (dx=1, dy=0) -> RIGHT\n  }\n  USE_ACTION = 4\n\n  actions = []\n  current_state = env._current_state\n  world = current_state.world\n  primitive_index = primitive\n\n  grid_width, grid_height, _ = current_state.grid.shape\n\n  # Max steps for BFS pathfinding to prevent excessively long paths or infinite loops\n  MAX_PATHFINDING_STEPS = grid_width * grid_height * 2 # Allow paths up to twice the grid area\n  # Max attempts to find and collect the primitive (e.g., if multiple instances exist)\n  MAX_COLLECT_LOOPS = 50\n\n  def _is_adjacent_to_kind(test_pos, target_idx, grid, width, height):\n      \"\"\"\n      Helper function to check if a target_idx is in the 3x3 neighborhood of test_pos.\n      Mimics CraftState.next_to behavior for a given grid and position.\n      \"\"\"\n      x, y = test_pos\n      # Check 3x3 neighborhood (including the center cell itself)\n      for dx_adj in [-1, 0, 1]:\n          for dy_adj in [-1, 0, 1]:\n              nx_adj, ny_adj = x + dx_adj, y + dy_adj\n              if 0 <= nx_adj < width and 0 <= ny_adj < height:\n                  if grid[nx_adj, ny_adj, target_idx] > 0:\n                      return True\n      return False\n\n  def _find_path_to_kind_adjacency(start_pos, target_kind_index, current_grid, world_ref, max_steps):\n      \"\"\"\n      Performs a BFS to find the shortest path from start_pos to a cell (r, c)\n      from which the target_kind_index is in the 3x3 neighborhood.\n      Returns a list of movement actions (int) or None if no path found within max_steps.\n      \"\"\"\n      queue = collections.deque([(start_pos, [])]) # (position, path_actions)\n      visited = {start_pos}\n\n      while queue:\n          (r, c), path_actions = queue.popleft()\n\n          # If the current position (r, c) allows adjacency to the primitive, we've found our target.\n          if _is_adjacent_to_kind((r, c), target_kind_index, current_grid, grid_width, grid_height):\n              return path_actions # Path found to a position from which primitive is adjacent\n\n          # If path is too long, stop exploring this branch\n          if len(path_actions) >= max_steps:\n              continue\n\n          # Explore neighbors (cardinal directions only for movement)\n          for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]: # (dx, dy) for movement\n              nx, ny = r + dr, c + dc\n              action_to_take = _ACTION_MAP_MOVEMENT[(dr, dc)]\n\n              if 0 <= nx < grid_width and 0 <= ny < grid_height and (nx, ny) not in visited:\n                  # Check if the new cell (nx, ny) is traversable (not an obstacle)\n                  is_obstacle = False\n                  for k in world_ref.non_grabbable_indices:\n                      if current_grid[nx, ny, k] > 0:\n                          is_obstacle = True\n                          break\n                  \n                  if not is_obstacle:\n                      visited.add((nx, ny))\n                      queue.append(((nx, ny), path_actions + [action_to_take]))\n      return None # No path found\n\n  # Main collection loop\n  for _ in range(MAX_COLLECT_LOOPS):\n      # 1. Check if the primitive is already collected\n      if current_state.inventory[primitive_index] > 0:\n          return actions # Successfully collected, return all actions taken\n\n      # 2. Find a path to a position adjacent to the primitive\n      path_segment = _find_path_to_kind_adjacency(\n          current_state.pos,\n          primitive_index,\n          current_state.grid,\n          world,\n          MAX_PATHFINDING_STEPS\n      )\n\n      if path_segment is None:\n          # Cannot find the primitive or path is blocked\n          return actions # Return actions taken so far (failure to collect)\n\n      # 3. Execute the movement path\n      for action in path_segment:\n          # Apply the action and update the state\n          _, new_state = current_state.step(action)\n          actions.append(action)\n          current_state = new_state \n\n          # Check if collected during movement (unlikely for primitives, but robust)\n          if current_state.inventory[primitive_index] > 0:\n              return actions\n          \n          # If the goal is satisfied mid-path (e.g., if multiple items were picked up at once), exit.\n          # Although Craft items are usually 1:1, this adds robustness.\n\n      # 4. After path execution, the agent should be adjacent to the primitive. Use it.\n      if current_state.next_to(primitive_index):\n          _, new_state = current_state.step(USE_ACTION)\n          actions.append(USE_ACTION)\n          current_state = new_state\n          \n          # Check if successfully collected after USE action\n          if current_state.inventory[primitive_index] > 0:\n              return actions # Successfully collected\n\n  # If the loop finishes without successfully collecting the primitive\n  # (e.g., if it's exhausted, or no more instances are found)\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:58:11.441543", "function_name": "collect", "function_body": "    \"\"\"\n    Improved version of `collect_v1`.\n    Uses Breadth-First Search (BFS) to find a sequence of actions to collect\n    the specified primitive. It simulates CraftState transitions to explore the state space.\n    \"\"\"\n    \n    # Get the initial CraftState from the environment\n    initial_craft_state = env._current_state\n\n    # Check if the primitive is already in the inventory\n    if initial_craft_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # BFS queue: stores (current_CraftState_object, list_of_actions_to_reach_this_state)\n    q = deque([(initial_craft_state, [])])\n    \n    # Visited set: to prevent cycles and redundant exploration.\n    # A state is defined by (agent_row, agent_col, agent_direction, primitive_collected_status).\n    # The primitive_collected_status is 0 if not yet collected, 1 if collected.\n    # This handles the change in inventory for the target primitive.\n    \n    # Initial state representation for the visited set\n    start_pos_r, start_pos_c = initial_craft_state.pos\n    start_dir = initial_craft_state.dir\n    # At the start of the search, the primitive is not collected (checked above)\n    start_inventory_status = 0 \n    \n    visited_states_repr = set([(start_pos_r, start_pos_c, start_dir, start_inventory_status)])\n    \n    # Define max path length to prevent excessively long searches or infinite loops\n    # This can be tuned. For typical CraftWorld grids, 250 steps should be sufficient\n    # for a single primitive collection if reachable.\n    MAX_SEARCH_STEPS = 250 \n\n    # Assuming actions are 0 to 4 (DOWN, UP, LEFT, RIGHT, USE) based on action_specs()\n    N_ACTIONS = 5 \n\n    while q:\n        curr_state_obj, path_so_far = q.popleft()\n\n        # If path becomes too long, prune this branch to avoid excessively long searches\n        if len(path_so_far) >= MAX_SEARCH_STEPS:\n            continue\n\n        # Check if the primitive has been collected in the current state\n        if curr_state_obj.inventory[primitive] > 0:\n            return path_so_far # Goal reached, return the sequence of actions\n\n        # Explore all possible actions\n        for action in range(N_ACTIONS):\n            # Apply the action to get the next state.\n            # CraftState.step returns a *new* CraftState object, which is crucial for BFS.\n            reward, next_state_obj = curr_state_obj.step(action)\n\n            # Create a hashable representation of the next state for the visited set\n            next_pos_r, next_pos_c = next_state_obj.pos\n            next_dir = next_state_obj.dir\n            next_inventory_status = 1 if next_state_obj.inventory[primitive] > 0 else 0\n            \n            next_state_repr = (next_pos_r, next_pos_c, next_dir, next_inventory_status)\n\n            # If this state (position, direction, and primitive collection status) hasn't been visited yet\n            if next_state_repr not in visited_states_repr:\n                visited_states_repr.add(next_state_repr)\n                q.append((next_state_obj, path_so_far + [action]))\n\n    # If the queue is empty and the goal hasn't been reached, it means the primitive is unreachable\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:59:33.027435", "function_name": "collect", "function_body": "    # 1. Get initial state information\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    grid = features_dict['features_global']\n    agent_pos_norm = features_dict['pos'] # normalized position [0,1]\n    inventory = features_dict['inventory']\n\n    # Convert normalized position to grid coordinates (int)\n    # The grid is (HEIGHT, WIDTH, n_kinds)\n    HEIGHT, WIDTH, N_KINDS = grid.shape\n    \n    # agent_pos_norm is (row_normalized, col_normalized)\n    agent_r = int(round(agent_pos_norm[0] * (HEIGHT - 1)))\n    agent_c = int(round(agent_pos_norm[1] * (WIDTH - 1)))\n    initial_pos = (agent_r, agent_c)\n\n    # 2. Get action mapping\n    action_map = env.action_specs()\n\n    # 3. Check initial inventory\n    if inventory[primitive] > 0:\n        return [] # Already collected\n\n    # 4. Initialize BFS queue and visited set\n    # collections.deque is used for efficient queue operations\n    # Assuming `collections` module is available in the execution environment\n    # or implicitly imported at a higher level (like numpy is).\n    q = collections.deque([(initial_pos, [])]) # (current_pos (r,c), path_actions)\n    visited = {initial_pos} # Set of visited (r,c) tuples to avoid cycles\n\n    # Relative movements for (dr, dc) for each action\n    moves = {\n        action_map['UP']: (-1, 0),\n        action_map['DOWN']: (1, 0),\n        action_map['LEFT']: (0, -1),\n        action_map['RIGHT']: (0, 1),\n    }\n\n    # BFS loop to find the shortest path\n    while q:\n        current_pos, current_path = q.popleft()\n        r, c = current_pos\n\n        # Check for primitive in 3x3 neighborhood around current_pos\n        # This simulates CraftState.next_to behavior, which implies\n        # the 'USE' action can apply to any item in the 3x3 vicinity.\n        found_primitive_nearby = False\n        for dr in [-1, 0, 1]:\n            for dc in [-1, 0, 1]:\n                nr, nc = r + dr, c + dc\n                # Check bounds to ensure the cell is on the grid\n                if 0 <= nr < HEIGHT and 0 <= nc < WIDTH:\n                    # Check if the primitive kind is present at this cell\n                    # grid[nr, nc, primitive] == 1 means the primitive is at (nr, nc)\n                    if grid[nr, nc, primitive] == 1:\n                        found_primitive_nearby = True\n                        break # Primitive found in 3x3 neighborhood\n            if found_primitive_nearby:\n                break\n\n        if found_primitive_nearby:\n            # If the primitive is nearby, we can 'USE' it.\n            # Append the USE action and return the complete path.\n            return current_path + [action_map['USE']]\n\n        # Explore possible movement actions (UP, DOWN, LEFT, RIGHT)\n        for action_val, (dr, dc) in moves.items():\n            next_r, next_c = r + dr, c + dc\n            next_pos = (next_r, next_c)\n\n            # Check if next_pos is within grid bounds and has not been visited yet\n            if 0 <= next_r < HEIGHT and 0 <= next_c < WIDTH and next_pos not in visited:\n                visited.add(next_pos)\n                q.append((next_pos, current_path + [action_val]))\n\n    # If the BFS completes and no path to collect the primitive is found\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:59:33.099868", "function_name": "collect", "function_body": "    # Actions as integer constants, based on CraftLab.action_specs\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Helper function for BFS pathfinding.\n    # Defined inside to be self-contained as per instructions.\n    def _get_neighbors(x, y, grid_width, grid_height):\n        neighbors = []\n        # Define possible moves and their corresponding actions\n        moves = [\n            (0, 1, DOWN),  # Move Down (increment y)\n            (0, -1, UP),   # Move Up (decrement y)\n            (-1, 0, LEFT), # Move Left (decrement x)\n            (1, 0, RIGHT)  # Move Right (increment x)\n        ]\n        \n        for dx, dy, action in moves:\n            nx, ny = x + dx, y + dy\n            # Check if the new position is within grid boundaries\n            if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                neighbors.append((nx, ny, action))\n        return neighbors\n\n    # Get initial state information from the environment's observations\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    \n    grid = features_dict['features_global']\n    grid_width, grid_height, _ = grid.shape\n    \n    # Convert normalized agent position from features_dict to integer grid coordinates\n    start_pos_norm = features_dict['pos'] \n    start_x = int(start_pos_norm[0] * grid_width)\n    start_y = int(start_pos_norm[1] * grid_height)\n    start_pos = (start_x, start_y)\n\n    # Get indices of entities that act as obstacles for movement.\n    # The Cookbook's `environment` attribute contains indices for non-grabbable entities,\n    # which typically represent unpassable terrain.\n    obstacle_indices = env.world.cookbook.environment\n    \n    # Initialize a deque for Breadth-First Search (BFS)\n    # Each element in the queue is (current_position_tuple, list_of_actions_to_reach_here)\n    queue = collections.deque([(start_pos, [])]) \n    \n    # Initialize a set to keep track of visited grid cells to prevent infinite loops and redundant exploration\n    visited = {start_pos} \n\n    # BFS loop\n    while queue:\n        (cx, cy), path = queue.popleft()\n\n        # Check if the current position (cx, cy) is a valid \"use-position\" for the primitive.\n        # This means checking if the primitive is within the 3x3 neighborhood around (cx, cy),\n        # as described by `CraftState.next_to`.\n        found_primitive_adjacent = False\n        for dx_adj in [-1, 0, 1]:\n            for dy_adj in [-1, 0, 1]:\n                nx_adj, ny_adj = cx + dx_adj, cy + dy_adj\n                # Ensure the adjacent cell is within grid bounds\n                if 0 <= nx_adj < grid_width and 0 <= ny_adj < grid_height:\n                    # Check if the primitive is present (count > 0) at this adjacent cell\n                    if grid[nx_adj, ny_adj, primitive] > 0:\n                        found_primitive_adjacent = True\n                        break # Found, no need to check further adjacent cells for this (cx,cy)\n            if found_primitive_adjacent:\n                break # Found, no need to check further adjacent rows for this (cx,cy)\n\n        if found_primitive_adjacent:\n            # If the current position allows using the primitive,\n            # return the sequence of actions taken to reach this position plus the USE action.\n            return path + [USE]\n\n        # Explore valid neighboring cells\n        for nx, ny, action in _get_neighbors(cx, cy, grid_width, grid_height):\n            if (nx, ny) not in visited:\n                # Determine if the neighbor cell (nx, ny) is an obstacle.\n                # A cell is an obstacle if it contains any item from `obstacle_indices`\n                # AND that item is NOT the primitive itself (the agent might need to walk over the primitive to collect it).\n                is_obstacle = False\n                # Iterate through all possible item kinds at (nx, ny)\n                for k_idx in range(grid.shape[2]): \n                    if grid[nx, ny, k_idx] > 0 and k_idx in obstacle_indices and k_idx != primitive:\n                        is_obstacle = True\n                        break # Found a blocking obstacle at this cell\n                \n                if not is_obstacle:\n                    # If the neighbor is not an obstacle, add it to visited set and the queue\n                    visited.add((nx, ny))\n                    queue.append(((nx, ny), path + [action]))\n    \n    # If the BFS queue becomes empty and no path to the primitive was found,\n    # return an empty list, indicating the primitive is unreachable.\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:01:17.631702", "function_name": "collect", "function_body": "  import collections\n\n  # Action mapping from CraftLab - retrieve from the environment to be robust\n  action_spec_map = env.action_specs()\n  DOWN = action_spec_map[\"DOWN\"]\n  UP = action_spec_map[\"UP\"]\n  LEFT = action_spec_map[\"LEFT\"]\n  RIGHT = action_spec_map[\"RIGHT\"]\n  USE = action_spec_map[\"USE\"]\n\n  ACTION_DELTAS = {\n      UP: (-1, 0),   # (dr, dc) for moving UP (decreases row)\n      DOWN: (1, 0),  # (dr, dc) for moving DOWN (increases row)\n      LEFT: (0, -1), # (dr, dc) for moving LEFT (decreases col)\n      RIGHT: (0, 1)  # (dr, dc) for moving RIGHT (increases col)\n  }\n\n  # 1. Get current state and relevant info\n  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos\n  grid_h, grid_w, n_kinds = grid.shape\n\n  # 2. Find all locations of the primitive on the grid\n  primitive_locations = []\n  for r in range(grid_h):\n      for c in range(grid_w):\n          if grid[r, c, primitive] > 0:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      return [] # Primitive not found on the map\n\n  # 3. Find the closest primitive location to the agent (Manhattan distance)\n  closest_primitive_loc = None\n  min_dist = float('inf')\n  for loc in primitive_locations:\n      dist = abs(agent_pos[0] - loc[0]) + abs(agent_pos[1] - loc[1])\n      if dist < min_dist:\n          min_dist = dist\n          closest_primitive_loc = loc\n\n  # 4. Determine target adjacent cells for the closest primitive\n  target_adj_cells = set()\n  r_prim, c_prim = closest_primitive_loc\n  # Possible adjacent positions: North, South, West, East\n  for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      adj_r, adj_c = r_prim + dr, c_prim + dc\n      # Check if adjacent cell is within grid boundaries\n      if 0 <= adj_r < grid_h and 0 <= adj_c < grid_w:\n          target_adj_cells.add((adj_r, adj_c))\n\n  # 5. Perform BFS to find the shortest path to an adjacent cell\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(agent_pos, [])])\n  # Set to keep track of visited positions to avoid cycles and redundant paths\n  visited = {agent_pos}\n\n  while q:\n      current_pos, path = q.popleft()\n\n      # If the current position is adjacent to the primitive, we've found a path\n      if current_pos in target_adj_cells:\n          # The 'USE' action collects the primitive when standing next to it.\n          # CraftState.next_to checks a 3x3 neighborhood and does not require specific orientation.\n          return path + [USE]\n\n      # Explore neighbors\n      for action, (dr, dc) in ACTION_DELTAS.items():\n          next_r, next_c = current_pos[0] + dr, current_pos[1] + dc\n          next_pos = (next_r, next_c)\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= next_r < grid_h and 0 <= next_c < grid_w):\n              continue\n\n          # Check if the next position has already been visited\n          if next_pos in visited:\n              continue\n\n          # Check if the next position is an obstacle (contains a non-grabbable item)\n          is_obstacle = False\n          for kind_idx in state.world.non_grabbable_indices:\n              if grid[next_r, next_c, kind_idx] > 0:\n                  is_obstacle = True\n                  break\n          if is_obstacle:\n              continue # Cannot move into this cell\n\n          # If traversable and unvisited, add to queue\n          visited.add(next_pos)\n          q.append((next_pos, path + [action]))\n\n  # If the queue becomes empty and no path was found\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:01:17.701498", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # DMLab-style direction deltas (0: East, 1: South, 2: West, 3: North)\n    # This mapping assumes a standard (X, Y) coordinate system where +X is right, +Y is down.\n    # Agent facing East (0): moves +X\n    # Agent facing South (1): moves +Y\n    # Agent facing West (2): moves -X\n    # Agent facing North (3): moves -Y\n    _DELTAS_DMLAB = {\n        0: (1, 0),   # East\n        1: (0, 1),   # South\n        2: (-1, 0),  # West\n        3: (0, -1)   # North\n    }\n\n    def _find_path_to_primitive(start_pos, start_dir, target_pos, grid, world, actions):\n        \"\"\"\n        Finds a path of actions for the agent to move to a cell adjacent to `target_pos`\n        and facing `target_pos`, then appends a `USE` action.\n        Uses Breadth-First Search (BFS) to find the shortest sequence of actions.\n\n        Args:\n            start_pos (tuple): Agent's starting (x, y) coordinates.\n            start_dir (int): Agent's starting direction (0-3, DMLab-style).\n            target_pos (tuple): (x, y) coordinates of the primitive to collect.\n            grid (numpy.ndarray): The current global grid from observations.\n            world (CraftWorld): Reference to the CraftWorld instance, used for\n                                `non_grabbable_indices` to determine traversable cells.\n            actions (dict): Dictionary mapping action names (e.g., 'UP', 'LEFT') to int IDs.\n\n        Returns:\n            list[int]: A list of integer actions to reach and collect the primitive,\n                       or an empty list if no path is found.\n        \"\"\"\n        q = collections.deque()\n        # BFS state: (current_x, current_y, current_direction, path_so_far_list_of_actions)\n        q.append((start_pos[0], start_pos[1], start_dir, []))\n        \n        # Visited set to prevent cycles and re-exploring states\n        visited = set()\n        visited.add((start_pos[0], start_pos[1], start_dir))\n\n        width, height = grid.shape[0:2]\n        \n        # Define traversability helper function\n        def is_traversable(x, y):\n            # Check if coordinates are within grid bounds\n            if not (0 <= x < width and 0 <= y < height):\n                return False\n            # Check if the cell contains any non-grabbable entities (obstacles)\n            for kind_idx in world.non_grabbable_indices:\n                if grid[x, y, kind_idx] > 0:\n                    return False\n            # Note: This assumes `non_grabbable_indices` completely defines blocking terrain.\n            # Workshops are generally not movement blockers, but interaction points.\n            return True\n\n        # Map action names to their integer IDs for clarity\n        FORWARD = actions['UP'] # Assuming 'UP' means move forward relative to facing direction\n        TURN_LEFT = actions['LEFT']\n        TURN_RIGHT = actions['RIGHT']\n        USE = actions['USE']\n\n        while q:\n            curr_x, curr_y, curr_dir, path = q.popleft()\n\n            # Check if the current state is adjacent to the target_pos and facing it.\n            # Calculate the coordinates of the cell directly in front of the agent.\n            facing_x, facing_y = curr_x + _DELTAS_DMLAB[curr_dir][0], curr_y + _DELTAS_DMLAB[curr_dir][1]\n            \n            # If the cell directly in front of the agent is the target primitive's location,\n            # we have found a path to be in position to collect it.\n            if (facing_x, facing_y) == target_pos:\n                return path + [USE] # Append the USE action and return the complete path\n\n            # Explore possible next states by applying valid actions:\n\n            # 1. Try to Move Forward (UP action)\n            next_x_forward, next_y_forward = curr_x + _DELTAS_DMLAB[curr_dir][0], curr_y + _DELTAS_DMLAB[curr_dir][1]\n            \n            # Agent can move forward if:\n            # a) The destination cell is within bounds and is traversable (not an obstacle).\n            # b) The destination cell is NOT the target_pos itself, because `USE` typically works\n            #    on an adjacent cell *in front of* the agent, not the cell the agent is on.\n            # c) The resulting agent state (position and direction) has not been visited before.\n            if (is_traversable(next_x_forward, next_y_forward) and \n                (next_x_forward, next_y_forward) != target_pos and \n                (next_x_forward, next_y_forward, curr_dir) not in visited):\n                \n                visited.add((next_x_forward, next_y_forward, curr_dir))\n                q.append((next_x_forward, next_y_forward, curr_dir, path + [FORWARD]))\n\n            # 2. Try to Turn Left (LEFT action)\n            # A left turn changes the direction by 90 degrees counter-clockwise.\n            # DMLab-style: 0->3 (E->N), 1->0 (S->E), 2->1 (W->S), 3->2 (N->W)\n            new_dir_left = (curr_dir + 3) % 4 \n            if (curr_x, curr_y, new_dir_left) not in visited:\n                visited.add((curr_x, curr_y, new_dir_left))\n                q.append((curr_x, curr_y, new_dir_left, path + [TURN_LEFT]))\n\n            # 3. Try to Turn Right (RIGHT action)\n            # A right turn changes the direction by 90 degrees clockwise.\n            # DMLab-style: 0->1 (E->S), 1->2 (S->W), 2->3 (W->N), 3->0 (N->E)\n            new_dir_right = (curr_dir + 1) % 4 \n            if (curr_x, curr_y, new_dir_right) not in visited:\n                visited.add((curr_x, curr_y, new_dir_right))\n                q.append((curr_x, curr_y, new_dir_right, path + [TURN_RIGHT]))\n            \n        return [] # No path found after exhausting all reachable states\n\n    # 1. Get current state observations from the environment\n    obs = env.observations()\n    current_grid = obs['features_dict']['features_global']\n    # Convert numpy array position (e.g., [x, y]) to tuple (x, y)\n    current_pos = tuple(obs['features_dict']['pos']) \n    # Convert one-hot direction array (e.g., [0,1,0,0]) to integer direction (e.g., 1)\n    current_dir_one_hot = obs['features_dict']['direction']\n    current_dir = np.where(current_dir_one_hot == 1)[0][0]\n\n    # 2. Check if the primitive is already in the agent's inventory\n    if obs['features_dict']['inventory'][primitive] > 0:\n        return [] # Primitive already collected, no actions needed\n\n    # 3. Get action mappings from the environment's specifications\n    actions = env.action_specs()\n\n    # 4. Get reference to the CraftWorld instance for map details (e.g., non_grabbable_indices)\n    world = env.world\n    \n    # 5. Find all locations on the grid where the target primitive exists\n    target_primitive_locs = []\n    width, height, _ = current_grid.shape # _ is for n_kinds, which we don't need for iteration\n    for x in range(width):\n        for y in range(height):\n            # If the specific primitive kind is present at (x, y)\n            if current_grid[x, y, primitive] > 0:\n                target_primitive_locs.append((x, y))\n\n    if not target_primitive_locs:\n        # If the primitive is not found anywhere on the map, return empty list\n        # print(f\"Primitive {world.cookbook.index.get(primitive)} not found on the map.\")\n        return []\n\n    # 6. Find the closest primitive instance to the agent's current position\n    # Uses Manhattan distance for simplicity, as diagonal moves are not direct actions.\n    def manhattan_distance(p1, p2):\n        return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n    target_pos = None\n    min_dist = float('inf')\n    for loc in target_primitive_locs:\n        dist = manhattan_distance(current_pos, loc)\n        if dist < min_dist:\n            min_dist = dist\n            target_pos = loc\n    \n    # This check ensures `target_pos` is set (it should be if `target_primitive_locs` was not empty).\n    if target_pos is None: \n        return [] \n\n    # 7. Use BFS (`_find_path_to_primitive`) to find the shortest action path\n    #    to reach a position adjacent to and facing the primitive, then collect it.\n    path_actions = _find_path_to_primitive(\n        current_pos, current_dir, target_pos, current_grid, world, actions\n    )\n\n    if not path_actions:\n        # If BFS returns an empty list, no path was found to the primitive.\n        # print(f\"No path found to primitive {world.cookbook.index.get(primitive)} at {target_pos}.\")\n        return []\n        \n    return path_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:03:08.955482", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n  import time # Used for seeding the RNG for reset, if non-deterministic behavior is desired\n\n  # Action mappings based on CraftLab.action_specs\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction vectors for calculating neighbor positions based on action\n  # Maps (dx, dy) to the action that moves to (current_x+dx, current_y+dy)\n  ACTION_TO_DIFF = {\n      ACTION_UP: (0, -1),   # Moving up decreases y-coordinate\n      ACTION_DOWN: (0, 1),  # Moving down increases y-coordinate\n      ACTION_LEFT: (-1, 0), # Moving left decreases x-coordinate\n      ACTION_RIGHT: (1, 0), # Moving right increases x-coordinate\n  }\n\n  # Helper function to check if a position is passable\n  def _is_passable(grid, pos, non_grabbable_indices):\n      x, y = pos\n      WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n      \n      # Check if position is within grid boundaries\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return False\n      \n      # Check if the cell contains any non-grabbable item (acting as an obstacle)\n      for idx in non_grabbable_indices:\n          if grid[x, y, idx] == 1: \n              return False\n      return True\n\n  # Helper function to find a path using Breadth-First Search (BFS)\n  def _find_path(start_pos, target_pos, current_grid, non_grabbable_indices):\n      \"\"\"\n      Finds a path (list of actions) from start_pos to target_pos using BFS.\n      Returns the path (list of actions) or None if no path found.\n      \"\"\"\n      q = collections.deque([(start_pos, [])]) # Queue: (current_position, actions_taken_to_reach_current_position)\n      visited = {start_pos} # Set of visited positions to avoid cycles\n      \n      while q:\n          (curr_x, curr_y), path = q.popleft()\n\n          if (curr_x, curr_y) == target_pos:\n              return path # Path found!\n\n          # Explore neighbors\n          for action, (dx, dy) in ACTION_TO_DIFF.items():\n              next_x, next_y = curr_x + dx, curr_y + dy\n              next_pos = (next_x, next_y)\n              \n              if next_pos not in visited and _is_passable(current_grid, next_pos, non_grabbable_indices):\n                  visited.add(next_pos)\n                  q.append((next_pos, path + [action]))\n      \n      return None # No path found\n\n  # Helper function for simple exploration (random valid move)\n  def _pick_exploration_action(current_pos, current_grid, non_grabbable_indices):\n      valid_actions = []\n      for action, (dx, dy) in ACTION_TO_DIFF.items():\n          next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n          if _is_passable(current_grid, (next_x, next_y), non_grabbable_indices):\n              valid_actions.append(action)\n      \n      if not valid_actions:\n          # If completely stuck (no valid moves), try to USE as a fallback.\n          # This might be useful if the agent needs to clear an obstacle it's on, etc.\n          return ACTION_USE \n      \n      return np.random.choice(valid_actions) # Choose a random valid action\n\n  # --- Main collect_v2 function logic ---\n  actions_log = []\n  env.reset(seed=int(time.time())) # Reset environment, using current time for varied scenarios\n  MAX_STEPS = 1000 # A reasonable maximum number of steps to prevent infinite loops\n\n  for _ in range(MAX_STEPS):\n      obs = env.observations()\n      inventory = obs['features_dict']['inventory']\n\n      # 1. Check if the primitive is already collected (goal achieved)\n      if inventory[primitive] > 0:\n          return actions_log\n\n      current_state = env._current_state\n      current_pos = current_state.pos\n      grid = current_state.grid\n      non_grabbable_indices = env.world.non_grabbable_indices\n      grabbable_indices = env.world.grabbable_indices \n\n      action_to_take = None\n\n      # 2. Check if the primitive is immediately grabbable (on agent's cell or next to agent)\n      # If agent is on the primitive's cell and it's grabbable\n      if grid[current_pos[0], current_pos[1], primitive] == 1 and primitive in grabbable_indices:\n          action_to_take = ACTION_USE\n      # If primitive is in the 3x3 neighborhood of the agent and it's grabbable\n      elif current_state.next_to(primitive) and primitive in grabbable_indices:\n          action_to_take = ACTION_USE\n      \n      # 3. If not immediately grabbable, determine next move via pathfinding or exploration\n      if action_to_take is None:\n          global_grid = obs['features_dict']['features_global']\n          primitive_coords = np.argwhere(global_grid[:, :, primitive] == 1)\n\n          if primitive_coords.size > 0:\n              # Primitive found on the map, find the closest one\n              closest_primitive_pos = min(\n                  [tuple(p) for p in primitive_coords],\n                  key=lambda p: abs(p[0] - current_pos[0]) + abs(p[1] - current_pos[1])\n              )\n              \n              # Try to find a path to the closest primitive\n              path_to_primitive = _find_path(current_pos, closest_primitive_pos, grid, non_grabbable_indices)\n              \n              if path_to_primitive:\n                  # If a path is found, take the first step\n                  action_to_take = path_to_primitive[0]\n              elif current_pos == closest_primitive_pos and primitive in grabbable_indices:\n                  # Agent is already at the target primitive's location, but not yet collected (e.g. just moved there)\n                  action_to_take = ACTION_USE\n              else:\n                  # No path found (e.g., blocked) or path is empty (start=target, but not yet collected).\n                  # Fallback to exploration if pathfinding fails or is not applicable.\n                  action_to_take = _pick_exploration_action(current_pos, grid, non_grabbable_indices)\n          else:\n              # Primitive not found anywhere on the map, explore to find it\n              action_to_take = _pick_exploration_action(current_pos, grid, non_grabbable_indices)\n      \n      # Execute the chosen action\n      actions_log.append(action_to_take)\n      reward, done, _ = env.step(action_to_take)\n      \n      # Check if the overall task is done (e.g., max_steps reached by the environment)\n      if done:\n          # Re-check inventory as a final measure before returning\n          final_obs = env.observations()\n          final_inventory = final_obs['features_dict']['inventory']\n          if final_inventory[primitive] > 0:\n              return actions_log\n          else:\n              # Task done, but primitive not collected.\n              # Return actions taken, indicating failure to collect specific primitive.\n              return actions_log \n  \n  # If the loop finishes without collecting the primitive (MAX_STEPS reached)\n  return actions_log # Indicates failure to collect within the step limit", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:03:09.924337", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants as per CraftLab.action_specs()\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  # Declared locally to strictly adhere to \"only return code that will fit in that function\".\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  _current_state = env._current_state\n  grid = _current_state.grid\n  current_pos = _current_state.pos\n  inventory = _current_state.inventory\n  cookbook = env.world.cookbook # Access the cookbook\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 1. Check if the primitive is already collected\n  if inventory[primitive] > 0:\n      return []\n\n  # Map (dx, dy) to action IDs for movement\n  delta_to_action = {\n      (0, 1): DOWN,\n      (0, -1): UP,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT\n  }\n\n  # Map action IDs to (dx, dy) for movement (useful for BFS neighbors)\n  action_to_delta = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0)\n  }\n\n  target_indices_on_grid = [] # Indices of items we are looking for on the grid\n  \n  # 2. Determine if the primitive is a direct grid item or a crafted item\n  if primitive in cookbook.recipes:\n      recipe = cookbook.recipes[primitive]\n      \n      # A crafted item requires interacting with a specific \"key\" item (e.g., workshop)\n      workshop_name = recipe.get(\"_key\") # Use .get to safely retrieve \"_key\"\n\n      if workshop_name:\n          # Get the integer index for the workshop from the cookbook's index\n          try:\n              workshop_idx = cookbook.index[workshop_name]\n              target_indices_on_grid.append(workshop_idx)\n          except KeyError:\n              # Workshop name not found in index, cannot craft or locate.\n              return []\n      else:\n          # Recipe for crafted item has no \"_key\" (no specific workshop required).\n          # This scenario is ambiguous; assuming it cannot be collected by moving to a grid location and using USE.\n          return []\n          \n  elif primitive in cookbook.primitives or primitive in cookbook.environment:\n      # It's a primitive resource or environment item, which should appear on the grid\n      target_indices_on_grid.append(primitive)\n  else:\n      # The primitive index is not a crafted item, nor a known primitive/environment resource.\n      # It's an invalid or uncollectable item for this function.\n      return []\n\n  if not target_indices_on_grid:\n      return [] # No valid target found to search for on the grid\n\n  # BFS setup to find path to any cell containing one of the target_indices_on_grid\n  queue = collections.deque([(current_pos, [])]) # (position_tuple, list_of_actions_to_reach_here)\n  visited = {current_pos}\n  \n  path_to_target_cell = None\n\n  while queue:\n      (cx, cy), current_actions = queue.popleft()\n\n      # Check if the current cell contains any of the target indices\n      found_target_in_cell = False\n      for target_idx in target_indices_on_grid:\n          if grid[cx, cy, target_idx] > 0: # Check if the target item is present in this cell\n              found_target_in_cell = True\n              break # Found a target in this cell\n\n      if found_target_in_cell:\n          # We found a target (primitive resource or workshop)! Add a USE action and return the path.\n          path_to_target_cell = current_actions + [USE]\n          break # Exit BFS as soon as the first target is found\n\n      # Explore neighbors (4 cardinal directions for movement)\n      for action_id, (dx, dy) in action_to_delta.items():\n          nx, ny = cx + dx, cy + dy\n\n          # Check bounds and if already visited\n          if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and (nx, ny) not in visited:\n              visited.add((nx, ny))\n              new_actions = current_actions + [action_id]\n              queue.append(((nx, ny), new_actions))\n    \n  return path_to_target_cell if path_to_target_cell is not None else []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:04:45.698137", "function_name": "collect", "function_body": "  # Get the current state from the environment\n  current_state = env._current_state\n\n  # 1. Check if the primitive is already in the inventory\n  if current_state.inventory[primitive] > 0:\n    return [] # Already collected, no actions needed\n\n  initial_pos = current_state.pos\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape # We only need WIDTH and HEIGHT from grid shape\n\n  # 2. Find all locations of the primitive on the grid\n  primitive_locations = []\n  for r in range(WIDTH):\n    for c in range(HEIGHT):\n      # If the primitive kind exists at this grid cell (count > 0)\n      if grid[r, c, primitive] > 0:\n        primitive_locations.append((r, c))\n\n  # If the primitive is not found anywhere on the grid, it's unreachable\n  if not primitive_locations:\n    return []\n\n  # 3. Determine target positions for BFS.\n  # A target position is any cell (r,c) from which the agent can `USE` the primitive.\n  # Based on `CraftState.next_to` (which checks 3x3 neighborhood including agent's own cell),\n  # this means any cell that contains the primitive or is directly adjacent to it.\n  target_positions = set()\n  for pr, pc in primitive_locations:\n    # Add the primitive's own location (if agent stands on it)\n    target_positions.add((pr, pc))\n    # Add the 4 direct neighbors of the primitive's location\n    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (N, S, W, E relative)\n      ar, ac = pr + dr, pc + dc\n      if 0 <= ar < WIDTH and 0 <= ac < HEIGHT: # Check boundary conditions\n        target_positions.add((ar, ac))\n\n  # Action constants (from CraftLab.action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Mapping of relative movement (dr, dc) to action ID\n  move_actions_map = {\n      (-1, 0): UP,    # Move North\n      (1, 0): DOWN,   # Move South\n      (0, -1): LEFT,  # Move West\n      (0, 1): RIGHT   # Move East\n  }\n\n  # 4. BFS to find the shortest path (sequence of movement actions)\n  # from the agent's current position to any of the target_positions.\n  q = collections.deque([(initial_pos, [])]) # Queue: (current_pos_tuple, list_of_actions_so_far)\n  visited = {initial_pos} # Set of visited positions (tuples) to avoid cycles and redundant paths\n\n  best_path = None # To store the shortest action sequence found\n\n  # Check if agent is already at a valid target position from the start\n  if initial_pos in target_positions:\n    # If so, just needs to perform the USE action\n    return [USE]\n\n  while q:\n    current_pos, actions_path = q.popleft()\n\n    # Explore possible moves from the current position\n    for (dr, dc), action in move_actions_map.items():\n      next_r, next_c = current_pos[0] + dr, current_pos[1] + dc\n      next_pos = (next_r, next_c)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n        continue # Out of bounds\n\n      # For simplicity, assume all grid cells are traversable for movement.\n      # If there were explicit obstacles (e.g., walls, certain non-grabbable items),\n      # additional checks would be needed here (e.g., `if not is_obstacle(next_pos)`).\n\n      if next_pos not in visited:\n        visited.add(next_pos)\n        new_path = actions_path + [action]\n\n        # If this new position is one of our target positions, we found a path\n        if next_pos in target_positions:\n          best_path = new_path\n          # No need to explore further as BFS guarantees the shortest path\n          q.clear() # Clear the queue to stop BFS immediately\n          break # Break from inner loop (action exploration)\n        else:\n          # Otherwise, add to queue for further exploration\n          q.append((next_pos, new_path))\n    \n    if best_path is not None:\n      break # Break from outer loop (BFS) if a path was found\n\n  # If no path was found to any target position\n  if best_path is None:\n    return []\n\n  # 5. Once the agent is at a target position, perform the USE action to collect the primitive\n  return best_path + [USE]", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:04:45.767278", "function_name": "collect", "function_body": "    import collections\n\n    # Action constants\n    ACTIONS = {\n        \"DOWN\": 0,\n        \"UP\": 1,\n        \"LEFT\": 2,\n        \"RIGHT\": 3,\n        \"USE\": 4,\n    }\n\n    # Direction vectors for movement actions (dr, dc)\n    MOVE_DELTAS = {\n        ACTIONS[\"UP\"]: (-1, 0),\n        ACTIONS[\"DOWN\"]: (1, 0),\n        ACTIONS[\"LEFT\"]: (0, -1),\n        ACTIONS[\"RIGHT\"]: (0, 1),\n    }\n\n    current_state = env._current_state\n    world = current_state.world\n    grid = current_state.grid\n    current_pos = current_state.pos\n\n    HEIGHT, WIDTH, N_KINDS = grid.shape\n\n    # Identify non-walkable entities based on the world's non_grabbable_indices.\n    # We assume any cell containing one of these entities is an obstacle.\n    non_walkable_indices = world.non_grabbable_indices\n\n    def is_walkable(r, c):\n        \"\"\"Checks if a cell (r, c) is within bounds and does not contain any non-walkable items.\"\"\"\n        if not (0 <= r < HEIGHT and 0 <= c < WIDTH):\n            return False  # Out of bounds\n\n        # Check if the cell contains any non-walkable item\n        for kind_idx in non_walkable_indices:\n            if grid[r, c, kind_idx] > 0:\n                return False  # Cell contains a non-walkable item, so it's blocked\n        return True\n\n    def check_for_primitive_in_3x3_neighborhood(agent_r, agent_c, target_primitive_idx, grid_data):\n        \"\"\"\n        Checks if the target_primitive_idx is present in the 3x3 neighborhood (including self)\n        around (agent_r, agent_c). This mimics CraftState.next_to(i_kind).\n        \"\"\"\n        grid_height, grid_width, _ = grid_data.shape\n        for dr in [-1, 0, 1]:\n            for dc in [-1, 0, 1]:\n                nr, nc = agent_r + dr, agent_c + dc\n                if 0 <= nr < grid_height and 0 <= nc < grid_width:\n                    if grid_data[nr, nc, target_primitive_idx] > 0:\n                        return True\n        return False\n\n    q = collections.deque()\n    # Queue stores tuples of (position, actions_taken_to_reach_position)\n    q.append((current_pos, []))\n    # Visited set stores positions already added to the queue to prevent cycles and redundant paths\n    visited = {current_pos}\n\n    while q:\n        pos, path = q.popleft()\n        r, c = pos\n\n        # Check if the current position is a suitable spot to perform 'USE' action\n        # to collect the primitive. This is true if the primitive is visible in the\n        # 3x3 neighborhood of the agent's current position.\n        if check_for_primitive_in_3x3_neighborhood(r, c, primitive, grid):\n            # If so, we've found a path to a suitable collection spot.\n            # Append the 'USE' action to the path and return the complete sequence.\n            return path + [ACTIONS[\"USE\"]]\n\n        # Explore possible move actions (UP, DOWN, LEFT, RIGHT) from the current position\n        for action_val in [ACTIONS[\"UP\"], ACTIONS[\"DOWN\"], ACTIONS[\"LEFT\"], ACTIONS[\"RIGHT\"]]:\n            dr, dc = MOVE_DELTAS[action_val]\n            new_r, new_c = r + dr, c + dc\n            new_pos = (new_r, new_c)\n\n            # Only add to queue if the new position is walkable and has not been visited yet\n            if is_walkable(new_r, new_c) and new_pos not in visited:\n                visited.add(new_pos)\n                q.append((new_pos, path + [action_val]))\n\n    # If the Breadth-First Search completes and no path to collect the primitive was found\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:06:21.578316", "function_name": "collect", "function_body": "    actions_taken = []\n\n    # 1. Check if the primitive is already collected\n    obs = env.observations()\n    current_inventory = obs['features_dict']['inventory']\n    if current_inventory[primitive] > 0:\n        return []\n\n    # Get grid information and agent's initial position\n    grid = obs['features_dict']['features_global']\n    grid_rows, grid_cols, _ = grid.shape\n    agent_pos = obs['features_dict']['pos'] # (row, col) integer tuple\n\n    # Identify non-grabbable indices for pathfinding (obstacles)\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # 2. Find all locations of the primitive on the grid\n    primitive_locations = []\n    for r in range(grid_rows):\n        for c in range(grid_cols):\n            if grid[r, c, primitive] == 1:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        # Primitive not found on the grid\n        return []\n\n    # 3. Determine potential target cells for BFS.\n    # These are cells from which the agent can 'USE' to collect the primitive.\n    # According to CraftState.next_to, this means any cell within the 3x3 neighborhood\n    # of a primitive's location. The agent must also be able to move to this cell.\n    valid_target_cells = set()\n    for pr, pc in primitive_locations:\n        for dr in [-1, 0, 1]:\n            for dc in [-1, 0, 1]:\n                tr, tc = pr + dr, pc + dc\n                if 0 <= tr < grid_rows and 0 <= tc < grid_cols:\n                    # Check if the potential target cell is traversable.\n                    # A cell is traversable if it doesn't contain any non-grabbable entity.\n                    is_traversable_cell = True\n                    for obstacle_idx in non_grabbable_indices:\n                        if grid[tr, tc, obstacle_idx] == 1:\n                            is_traversable_cell = False\n                            break\n                    if is_traversable_cell:\n                        valid_target_cells.add((tr, tc))\n    \n    # If agent is already on a valid target cell and it's traversable, that's a valid starting point for USE\n    is_agent_pos_traversable = True\n    for obstacle_idx in non_grabbable_indices:\n        if grid[agent_pos[0], agent_pos[1], obstacle_idx] == 1:\n            is_agent_pos_traversable = False\n            break\n\n    if agent_pos in valid_target_cells and is_agent_pos_traversable:\n        # Agent is already at a good spot, no movement needed, just USE\n        shortest_path_to_target = []\n    else:\n        # 4. BFS to find the shortest path to a valid target cell\n        # Queue stores (position, path_to_position)\n        queue = collections.deque([(agent_pos, [])])\n        visited = {agent_pos}\n        shortest_path_to_target = None\n\n        # Define movement deltas and corresponding actions\n        # Assuming (row, col) for position and (dr, dc) for deltas\n        move_directions = {\n            UP_ACTION: (-1, 0),\n            DOWN_ACTION: (1, 0),\n            LEFT_ACTION: (0, -1),\n            RIGHT_ACTION: (0, 1),\n        }\n\n        while queue:\n            current_pos, current_path = queue.popleft()\n\n            # Check if the current position is one of our valid target cells\n            # (traversability check for current_pos already done at agent_pos or when added to queue)\n            if current_pos in valid_target_cells:\n                shortest_path_to_target = current_path\n                break # Found the shortest path\n\n            # Explore neighbors\n            for action_id, (dr, dc) in move_directions.items():\n                new_r, new_c = current_pos[0] + dr, current_pos[1] + dc\n                new_pos = (new_r, new_c)\n\n                # Check bounds\n                if not (0 <= new_r < grid_rows and 0 <= new_c < grid_cols):\n                    continue\n\n                # Check if already visited\n                if new_pos in visited:\n                    continue\n\n                # Check if the new position is traversable (not an obstacle)\n                is_new_pos_traversable = True\n                for obstacle_idx in non_grabbable_indices:\n                    if grid[new_r, new_c, obstacle_idx] == 1:\n                        is_new_pos_traversable = False\n                        break\n                \n                if is_new_pos_traversable:\n                    visited.add(new_pos)\n                    queue.append((new_pos, current_path + [action_id]))\n\n    if shortest_path_to_target is None:\n        # No path found to any cell from which the primitive can be collected\n        return []\n\n    # 5. Execute the found path\n    for action in shortest_path_to_target:\n        _reward, _done, obs = env.step(action)\n        actions_taken.append(action)\n        # Check if primitive was collected during movement (unlikely for USE items, but safe)\n        if obs['features_dict']['inventory'][primitive] > 0:\n            return actions_taken\n        if _done:\n            # Episode ended prematurely\n            return actions_taken\n\n    # 6. Once at the target cell, use the 'USE' action\n    _reward, _done, obs = env.step(USE_ACTION)\n    actions_taken.append(USE_ACTION)\n\n    # 7. Final check if the primitive was collected\n    if obs['features_dict']['inventory'][primitive] > 0:\n        return actions_taken\n    else:\n        # Failed to collect after path and USE.\n        # This might happen if the primitive was already gone, or other game mechanics.\n        # The function requests \"actions to find and collect\", so even if ultimately\n        # unsuccessful, these are the actions taken.\n        return actions_taken", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:06:22.564215", "function_name": "collect", "function_body": "  actions_taken = []\n  action_map = env.action_specs()\n\n  # Initial check: Is the primitive already in inventory?\n  initial_obs = env.observations()\n  initial_inventory = initial_obs['features_dict']['inventory']\n  if initial_inventory[primitive] > 0:\n    return []\n\n  # Maximum number of steps to attempt collection to prevent infinite loops\n  MAX_COLLECT_STEPS = 500 \n\n  for _ in range(MAX_COLLECT_STEPS):\n    obs = env.observations()\n    current_inventory = obs['features_dict']['inventory']\n\n    # 1. Check if primitive has been collected in the current step\n    if current_inventory[primitive] > 0:\n      return actions_taken\n\n    # 2. Check if primitive is in the 3x3 neighborhood and can be 'USE'd\n    # We access the internal CraftState instance via env._current_state.\n    if env._current_state.next_to(primitive):\n      action = action_map['USE']\n      env.step(action)\n      actions_taken.append(action)\n      # After attempting to USE, we loop again to re-check inventory\n      continue\n\n    # 3. Check egocentric view (features_ego) to move towards the primitive\n    ego_obs = obs['features_dict']['features_ego']\n    \n    # Find coordinates of the primitive within the egocentric view\n    # np.where returns (row_indices_array, col_indices_array)\n    primitive_locations = np.where(ego_obs[:, :, primitive] == 1)\n\n    chosen_move_action = None\n    if primitive_locations[0].size > 0: # If primitive is visible in the egocentric view\n      # Take the first visible instance (e.g., if multiple are visible, pick one)\n      target_row, target_col = primitive_locations[0][0], primitive_locations[1][0]\n\n      # Agent's position is typically at the center of the egocentric view slice\n      ego_height, ego_width, _ = ego_obs.shape\n      agent_row_in_ego = ego_height // 2\n      agent_col_in_ego = ego_width // 2\n\n      # Calculate relative displacement\n      delta_row = target_row - agent_row_in_ego\n      delta_col = target_col - agent_col_in_ego\n\n      # Prioritize movement along the dimension with the largest absolute difference\n      # This is a simple heuristic to move directly towards the target.\n      if abs(delta_row) > abs(delta_col):\n        if delta_row < 0: # Target is \"up\" from agent\n          chosen_move_action = action_map['UP']\n        elif delta_row > 0: # Target is \"down\" from agent\n          chosen_move_action = action_map['DOWN']\n      else: # abs(delta_col) >= abs(delta_row)\n        if delta_col < 0: # Target is \"left\" from agent\n          chosen_move_action = action_map['LEFT']\n        elif delta_col > 0: # Target is \"right\" from agent\n          chosen_move_action = action_map['RIGHT']\n      # If delta_row and delta_col are both 0, the primitive is on the agent's cell,\n      # which should have been handled by the `next_to` check and `USE` action.\n\n    if chosen_move_action is not None:\n      # Record current position and direction to detect if a move was blocked (hit a wall)\n      old_pos = tuple(env._current_state.pos)\n      old_dir = env._current_state.dir\n\n      env.step(chosen_move_action)\n      actions_taken.append(chosen_move_action)\n\n      new_pos = tuple(env._current_state.pos)\n      new_dir = env._current_state.dir\n\n      # Check if the agent actually moved or changed direction\n      if new_pos == old_pos and new_dir == old_dir:\n        # Action failed (e.g., hit a wall). Remove the failed action from the list.\n        actions_taken.pop() \n        \n        # Fallback: if direct movement failed, try to turn to escape being stuck.\n        # This is a simple recovery mechanism for `collect_v2`.\n        action = action_map['RIGHT'] # Arbitrarily try turning right\n        env.step(action)\n        actions_taken.append(action)\n        continue # Re-evaluate the state after turning\n      else:\n        # Move was successful, continue the loop to re-evaluate from the new position\n        continue\n\n    # 4. If primitive is not adjacent and not visible, perform an exploration move.\n    # This block is executed if `chosen_move_action` was None (primitive not visible)\n    # or if a chosen move action failed and was handled by a turn.\n    \n    # Define a sequence of preferred exploration moves (e.g., try moving right, then up, etc.)\n    preferred_exploration_moves = [action_map['RIGHT'], action_map['UP'], action_map['LEFT'], action_map['DOWN']]\n    \n    successful_exploration_move = False\n    for action_to_try in preferred_exploration_moves:\n      old_pos = tuple(env._current_state.pos)\n      old_dir = env._current_state.dir\n      \n      env.step(action_to_try)\n      actions_taken.append(action_to_try)\n      \n      new_pos = tuple(env._current_state.pos)\n      new_dir = env._current_state.dir\n\n      if new_pos != old_pos or new_dir != old_dir:\n        # Successfully moved or turned. Break from inner loop and continue main loop.\n        successful_exploration_move = True\n        break\n      else:\n        # This action failed (e.g., hit a wall). Remove it from list and try the next preferred action.\n        actions_taken.pop()\n    \n    if not successful_exploration_move:\n      # If all preferred exploration moves failed, the agent is likely stuck (e.g., surrounded by walls)\n      # or the primitive is unreachable within this limited search.\n      return [] # Indicate failure to collect\n\n  # If MAX_COLLECT_STEPS is reached and the primitive is still not collected,\n  # it indicates that the primitive could not be found or collected within the limit.\n  return [] # Indicate failure", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:08:41.057384", "function_name": "collect", "function_body": "    # Helper to get action constants from env.action_specs()\n    # This ensures compatibility with any specific action mapping of the environment.\n    def _get_actions_map(env_instance):\n        specs = env_instance.action_specs()\n        return {\n            'DOWN': specs['DOWN'],\n            'UP': specs['UP'],\n            'LEFT': specs['LEFT'],\n            'RIGHT': specs['RIGHT'],\n            'USE': specs['USE'],\n        }\n\n    # Direction mappings for agent's `dir` attribute (0=North, 1=East, 2=South, 3=West)\n    # These define the (dr, dc) vector for the cell directly in front of the agent when facing that direction.\n    DIR_VECTORS = {\n        0: (-1, 0),  # North (row decreases)\n        1: (0, 1),   # East (column increases)\n        2: (1, 0),   # South (row increases)\n        3: (0, -1)   # West (column decreases)\n    }\n\n    # Mapping relative position (dr, dc) of a target (if immediately adjacent)\n    # to the direction the agent needs to face to hit it with a USE action.\n    TARGET_POS_TO_FACING_DIR = {\n        (-1, 0): 0,  # Target is North relative to agent -> agent needs to face North (dir 0)\n        (0, 1): 1,   # Target is East relative to agent -> agent needs to face East (dir 1)\n        (1, 0): 2,   # Target is South relative to agent -> agent needs to face South (dir 2)\n        (0, -1): 3   # Target is West relative to agent -> agent needs to face West (dir 3)\n    }\n\n    actions_taken = []\n    \n    # Get action mappings from the environment instance\n    actions = _get_actions_map(env)\n    ACTION_DOWN = actions['DOWN']\n    ACTION_UP = actions['UP']\n    ACTION_LEFT = actions['LEFT']\n    ACTION_RIGHT = actions['RIGHT']\n    ACTION_USE = actions['USE']\n\n    # Access the current state of the environment (CraftState instance is private but accessible via _current_state)\n    state = env._current_state\n    \n    # Loop until the primitive is in inventory or max_steps/unreachable\n    while state.inventory[primitive] == 0:\n        r_agent, c_agent = state.pos\n        agent_dir = state.dir\n        current_grid = state.grid\n        \n        grid_height, grid_width, _ = current_grid.shape\n\n        primitive_cardinally_adjacent = False\n        target_r_prim, target_c_prim = -1, -1 # Stores the exact location of an adjacent primitive\n\n        # Define cardinal neighbors (N, S, W, E) for checking adjacency\n        cardinal_offsets = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n        \n        # Check if the primitive is in any of the four directly adjacent cells\n        for dr_offset, dc_offset in cardinal_offsets:\n            nr, nc = r_agent + dr_offset, c_agent + dc_offset\n            \n            # Check boundaries to ensure the neighbor cell is on the grid\n            if 0 <= nr < grid_height and 0 <= nc < grid_width:\n                # Check if the primitive kind exists at this neighbor cell\n                if current_grid[nr, nc, primitive] == 1:\n                    primitive_cardinally_adjacent = True\n                    target_r_prim, target_c_prim = nr, nc\n                    break # Found an adjacent primitive, no need to check further\n        \n        if primitive_cardinally_adjacent:\n            # The primitive is directly adjacent. Now, turn to face it and USE.\n            dr_face = target_r_prim - r_agent\n            dc_face = target_c_prim - c_agent\n            \n            # Determine the direction the agent needs to face to point at the primitive\n            required_dir = TARGET_POS_TO_FACING_DIR.get((dr_face, dc_face))\n\n            if required_dir is not None and agent_dir != required_dir:\n                # Calculate the minimum number of turns (left or right) to align direction\n                diff = (required_dir - agent_dir + 4) % 4 # Normalized difference (0-3)\n                \n                # Perform turns to align the agent's direction\n                if diff == 1: # Turn right once\n                    actions_taken.append(ACTION_RIGHT)\n                    _, done, _ = env.step(ACTION_RIGHT)\n                elif diff == 2: # Turn right twice (or left twice)\n                    actions_taken.extend([ACTION_RIGHT, ACTION_RIGHT])\n                    _, done, _ = env.step(ACTION_RIGHT)\n                    if not done: # Check done status after first step if doing multiple\n                        _, done, _ = env.step(ACTION_RIGHT)\n                elif diff == 3: # Turn left once\n                    actions_taken.append(ACTION_LEFT)\n                    _, done, _ = env.step(ACTION_LEFT)\n                \n                # Update the state after turning actions\n                state = env._current_state \n                if done: # If episode ended during turning, break\n                    break\n                agent_dir = state.dir # Ensure agent_dir is updated\n\n            # After turning (or if already facing), perform the USE action\n            actions_taken.append(ACTION_USE)\n            _, done, _ = env.step(ACTION_USE)\n            state = env._current_state # Update state after USE action\n            \n            if done: # If episode ended after USE (e.g., max_steps reached)\n                break\n            if state.inventory[primitive] > 0:\n                # Successfully collected the primitive\n                return actions_taken\n            else:\n                # USE action failed for some reason (e.g., item not grabbable,\n                # another agent picked it up, or an unexpected environment state).\n                # The loop will re-evaluate in the next iteration.\n                pass \n\n        else:\n            # Primitive is not directly adjacent, need to move towards it.\n            \n            # Find all locations where the primitive currently exists on the grid.\n            primitive_locations = []\n            for r in range(grid_height):\n                for c in range(grid_width):\n                    if current_grid[r, c, primitive] == 1:\n                        primitive_locations.append((r, c))\n            \n            if not primitive_locations:\n                # The primitive is no longer on the grid or was never there.\n                # This indicates an unachievable goal or an error in scenario setup.\n                break \n\n            # Find the closest primitive location using Manhattan distance.\n            min_dist = float('inf')\n            closest_target_r, closest_target_c = -1, -1\n            \n            for tr, tc in primitive_locations:\n                dist = abs(tr - r_agent) + abs(tc - c_agent)\n                if dist < min_dist:\n                    min_dist = dist\n                    closest_target_r, closest_target_c = tr, tc\n            \n            if closest_target_r == -1: # Should not happen if primitive_locations is not empty\n                 break\n\n            # Determine the best movement action to get closer to the primitive.\n            dr_move = closest_target_r - r_agent\n            dc_move = closest_target_c - c_agent\n            \n            move_action = None\n            # Prioritize movement in the direction with the larger absolute difference.\n            # If differences are equal, or one is zero, then prioritize the non-zero one.\n            if dr_move != 0 and (abs(dr_move) >= abs(dc_move) or dc_move == 0):\n                if dr_move < 0: # Target is North\n                    move_action = ACTION_UP\n                else: # Target is South\n                    move_action = ACTION_DOWN\n            elif dc_move != 0: # Target is West or East\n                if dc_move < 0: # Target is West\n                    move_action = ACTION_LEFT\n                else: # Target is East\n                    move_action = ACTION_RIGHT\n            else: # dr_move == 0 and dc_move == 0: Agent is on the target cell.\n                  # This implies it's either collected (caught by loop condition)\n                  # or uncollectible by movement onto it (requires USE from adjacent).\n                  # Since it's not adjacent (previous block), this is a stuck state.\n                break \n\n            if move_action is not None:\n                actions_taken.append(move_action)\n                # Store agent's position before the step to detect if movement occurred\n                prev_pos = state.pos \n                _, done, _ = env.step(move_action)\n                state = env._current_state # Update state after movement\n                \n                if done: # If episode ended during movement, break\n                    break\n                \n                # If agent tried to move but didn't change position (e.g., blocked by obstacle or the primitive itself)\n                # and the primitive is still not collected, it means it's stuck or the primitive needs specific handling.\n                # For `v2`, we let the loop continue; it will either eventually get adjacent or hit max_steps.\n                if state.pos == prev_pos and state.inventory[primitive] == 0:\n                    # If stuck, a more advanced version might explore other paths or give up.\n                    # For v2, we continue loop, relying on CraftLab.max_steps to prevent infinite loop.\n                    pass\n            else:\n                # No valid move action could be determined (e.g., completely surrounded).\n                break \n    \n    # If the loop finishes (e.g., max_steps reached, or primitive became unreachable),\n    # but the primitive is not in the inventory, return the actions taken so far, indicating failure.\n    return actions_taken", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:08:41.132072", "function_name": "collect", "function_body": "    # Action constants and helper mapping (local to function scope)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    DELTAS_TO_ACTION = {\n        (1, 0): ACTION_DOWN,\n        (-1, 0): ACTION_UP,\n        (0, -1): ACTION_LEFT,\n        (0, 1): ACTION_RIGHT,\n    }\n\n    # Helper functions defined locally within collect_v2\n    def _get_grid_dims(env_local):\n        \"\"\"Returns (height, width, n_kinds) from the scenario's grid shape.\"\"\"\n        # CraftScenario.init_grid has shape (WIDTH, HEIGHT, n_kinds)\n        # Assuming numpy.ndarray shape conventions (rows, columns, depth)\n        # So shape[0] is height (Y), shape[1] is width (X), shape[2] is n_kinds\n        grid_shape = env_local.scenario.init_grid.shape\n        return grid_shape[1], grid_shape[0], grid_shape[2] # Corrected for WIDTH, HEIGHT order in docs\n\n    def _is_walkable(y, x, grid, height, width, world_local):\n        \"\"\"Checks if a grid cell (y, x) is within bounds and not blocked by obstacles.\"\"\"\n        if not (0 <= y < height and 0 <= x < width):\n            return False # Out of bounds\n\n        # A cell is blocked if it contains any non-grabbable or environment item\n        blocked_kinds = world_local.non_grabbable_indices.union(world_local.cookbook.environment)\n        \n        # Check if any of the blocked kinds are present at (y, x)\n        for k_idx in blocked_kinds:\n            if k_idx < grid.shape[2] and grid[y, x, k_idx] > 0:\n                return False # Cell contains a blocked item\n        return True # Cell is walkable\n\n    def _find_item_locations(item_kind_local, grid_local):\n        \"\"\"Finds all (y, x) coordinates where `item_kind_local` is present in the grid.\"\"\"\n        locations = []\n        # Ensure item_kind_local is a valid index for n_kinds\n        if item_kind_local >= grid_local.shape[2]:\n            return locations\n            \n        # np.where returns (row_indices, col_indices) where condition is true\n        ys, xs = np.where(grid_local[:, :, item_kind_local] > 0)\n        for y, x in zip(ys, xs):\n            locations.append((y, x))\n        return locations\n\n    def _find_path(start_pos_local, target_pos_local, current_grid_local, height_local, width_local, world_local):\n        \"\"\"\n        Performs a Breadth-First Search (BFS) to find the shortest path from start_pos_local\n        to target_pos_local, avoiding non-walkable cells.\n        Returns a list of (y, x) positions, or None if no path exists.\n        \"\"\"\n        # Queue stores (current_y, current_x, path_list_to_current)\n        queue = [(start_pos_local[0], start_pos_local[1], [start_pos_local])]\n        visited = {start_pos_local}\n\n        while queue:\n            cy, cx, path = queue.pop(0)\n\n            # If current position is the target, we found the path\n            if (cy, cx) == target_pos_local:\n                return path\n\n            # Explore neighbors (dy, dx) for UP, DOWN, LEFT, RIGHT\n            for dy, dx in [(-1, 0), (1, 0), (0, -1), (0, 1)]: \n                ny, nx = cy + dy, cx + dx\n                \n                # Check bounds\n                if not (0 <= ny < height_local and 0 <= nx < width_local):\n                    continue\n                \n                # If the neighbor is the target itself, we can move to it\n                # (even if it's an item which might be \"unwalkable\" for intermediate steps,\n                # we assume we can move ONTO the target primitive to collect it)\n                if (ny, nx) == target_pos_local:\n                    return path + [(ny, nx)]\n\n                # For intermediate cells, check if they are walkable and not yet visited\n                if _is_walkable(ny, nx, current_grid_local, height_local, width_local, world_local) and (ny, nx) not in visited:\n                    visited.add((ny, nx))\n                    queue.append((ny, nx, path + [(ny, nx)]))\n        \n        return None # No path found to the target\n\n    def _path_to_actions(path_local):\n        \"\"\"Converts a path of (y, x) positions into a list of movement actions.\"\"\"\n        actions = []\n        if len(path_local) < 2:\n            return actions # A path needs at least a start and an end point to generate actions\n\n        for i in range(len(path_local) - 1):\n            y1, x1 = path_local[i]\n            y2, x2 = path_local[i+1]\n            \n            dy, dx = y2 - y1, x2 - x1\n            \n            action = DELTAS_TO_ACTION.get((dy, dx))\n            if action is not None:\n                actions.append(action)\n            else:\n                # This case indicates an invalid movement not covered by standard actions\n                # For robust implementation, consider logging or raising an error.\n                # For this completion, we'll silently skip, assuming valid paths.\n                pass \n        return actions\n\n    # --- Main collect_v2 logic ---\n\n    # Set a maximum number of steps to attempt collection, to prevent infinite loops\n    MAX_COLLECT_STEPS = 500 \n    \n    # Get current observations from the environment\n    obs = env.observations()\n\n    # Get grid dimensions (height, width, n_kinds) and world configuration\n    # Note: Corrected _get_grid_dims based on `(WIDTH, HEIGHT, n_kinds)` in docs\n    width, height, n_kinds = _get_grid_dims(env) \n    world = env.world # Reference to the CraftWorld instance\n\n    all_actions_taken = [] # Accumulates all actions performed\n    steps_taken_in_attempt = 0 # Tracks steps taken in current collection attempt\n\n    while steps_taken_in_attempt < MAX_COLLECT_STEPS:\n        current_inventory = obs['features_dict']['inventory']\n        # Check if the primitive is already collected\n        if current_inventory[primitive] > 0:\n            return all_actions_taken # Goal achieved, return actions taken\n\n        current_grid = obs['features_dict']['features_global']\n        \n        # Get agent's current integer position (y, x) from normalized coordinates\n        # Assumes `pos` is (y_normalized, x_normalized)\n        norm_pos = obs['features_dict']['pos']\n        current_pos_y = int(norm_pos[0] * height)\n        current_pos_x = int(norm_pos[1] * width)\n        current_pos = (current_pos_y, current_pos_x)\n\n        # Find all current locations of the primitive on the grid\n        primitive_locations = _find_item_locations(primitive, current_grid)\n\n        if not primitive_locations:\n            # If primitive is not found on the grid, it cannot be collected\n            return all_actions_taken \n\n        best_path = None\n        min_path_len = float('inf')\n\n        # Find the shortest path to any instance of the primitive\n        for target_loc in primitive_locations:\n            path = _find_path(current_pos, target_loc, current_grid, height, width, world)\n            if path and len(path) < min_path_len:\n                best_path = path\n                min_path_len = len(path)\n\n        if not best_path:\n            # No reachable path found to any primitive instance\n            return all_actions_taken\n\n        # Convert the found path of positions into a sequence of movement actions\n        movement_actions = _path_to_actions(best_path)\n\n        # Execute the movement actions one by one\n        for action in movement_actions:\n            _, done, obs = env.step(action) # Perform the action\n            all_actions_taken.append(action) # Record the action\n            steps_taken_in_attempt += 1\n\n            # Check if the episode ended or max steps reached after each action\n            if done or steps_taken_in_attempt >= MAX_COLLECT_STEPS:\n                return all_actions_taken \n\n        # After movements, the agent should now be on the same tile as the primitive.\n        # Perform the 'USE' action to collect the primitive.\n        _, done, obs = env.step(ACTION_USE)\n        all_actions_taken.append(ACTION_USE) # Record the USE action\n        steps_taken_in_attempt += 1\n\n        # Check conditions again after 'USE'\n        if done or steps_taken_in_attempt >= MAX_COLLECT_STEPS:\n            return all_actions_taken\n        \n        # The loop will re-evaluate: if primitive is collected, it exits.\n        # If not (e.g., if 'USE' failed or item was not grabbable), it will try to find another path.\n\n    # If the loop finishes without collecting the primitive (due to MAX_COLLECT_STEPS limit)\n    return all_actions_taken", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:09:54.685926", "function_name": "collect", "function_body": "    # Define action constants based on the problem description (CraftLab.action_specs)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Direction deltas (dr, dc) for UP, DOWN, LEFT, RIGHT movements\n    # Corresponds to (row_change, col_change)\n    _ACTION_DELTAS = {\n        UP: (-1, 0),    # Move up (decrease row)\n        DOWN: (1, 0),   # Move down (increase row)\n        LEFT: (0, -1),  # Move left (decrease column)\n        RIGHT: (0, 1),  # Move right (increase column)\n    }\n\n    # Map deltas back to actions for path reconstruction\n    _DELTAS_TO_ACTION = {\n        (-1, 0): UP,\n        (1, 0): DOWN,\n        (0, -1): LEFT,\n        (0, 1): RIGHT,\n    }\n\n    # Import deque locally as per strict interpretation of \"only code inside the function\"\n    from collections import deque\n\n    # Check if the primitive is already in the inventory\n    initial_inventory = env.observations()['features_dict']['inventory']\n    if initial_inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    actions = [] # List to store the sequence of actions\n\n    # Get current state information from the environment\n    current_state = env._current_state\n    grid = current_state.grid\n    start_pos = current_state.pos\n    height, width, _ = grid.shape\n\n    # Get non-grabbable indices from the CraftWorld to identify obstacles\n    # These are entities that cannot be picked up and block movement.\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # Find all locations of the target primitive in the grid\n    primitive_locations = []\n    for r in range(height):\n        for c in range(width):\n            if grid[r, c, primitive] > 0: # If the primitive kind is present at (r, c)\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        return [] # Primitive not found in the world\n\n    # Choose the closest primitive location as the target for pathfinding\n    target_primitive_loc = None\n    min_dist = float('inf')\n    for (pr_cand, pc_cand) in primitive_locations:\n        dist = abs(pr_cand - start_pos[0]) + abs(pc_cand - start_pos[1])\n        if dist < min_dist:\n            min_dist = dist\n            target_primitive_loc = (pr_cand, pc_cand)\n    \n    pr, pc = target_primitive_loc # Row and column of the closest target primitive\n\n    # Breadth-First Search (BFS) to find a path to a cell adjacent to the primitive\n    # The queue stores tuples: (current_position (r, c), path_of_coordinates_taken_to_reach_current_position)\n    q = deque([(start_pos, [])]) \n    visited = {start_pos} # Set of visited (row, col) tuples to prevent cycles and redundant exploration\n    \n    path_found_coords = None # This will store the list of (r, c) tuples from start to the target adjacent cell\n\n    while q:\n        curr_pos, current_path_segments = q.popleft()\n        curr_r, curr_c = curr_pos\n\n        # Check if the current position is adjacent to the target primitive\n        # An adjacent cell has a Manhattan distance of 1 from the primitive's location.\n        is_adjacent_to_primitive = abs(curr_r - pr) + abs(curr_c - pc) == 1\n        \n        # Check if the current cell is traversable.\n        # A cell is traversable if it's within grid bounds and does not contain any non-grabbable items.\n        is_traversable_curr_cell = True\n        if not (0 <= curr_r < height and 0 <= curr_c < width):\n            is_traversable_curr_cell = False # Should not happen if initial_pos is valid and BFS stays in bounds\n        else:\n            for k_idx in non_grabbable_indices:\n                if grid[curr_r, curr_c, k_idx] > 0:\n                    is_traversable_curr_cell = False\n                    break\n        \n        if is_adjacent_to_primitive and is_traversable_curr_cell:\n            # Path found! current_path_segments leads to curr_pos, so append curr_pos\n            path_found_coords = current_path_segments + [curr_pos]\n            break # Exit BFS loop\n\n        # Explore neighbors (up, down, left, right)\n        for action_val, (dr, dc) in _ACTION_DELTAS.items():\n            next_r, next_c = curr_r + dr, curr_c + dc\n            next_pos = (next_r, next_c)\n\n            # Check if the next position is within bounds and has not been visited yet\n            if not (0 <= next_r < height and 0 <= next_c < width) or next_pos in visited:\n                continue # Skip invalid or already visited neighbors\n            \n            # Check if the next cell is traversable\n            is_next_cell_traversable = True\n            for k_idx in non_grabbable_indices:\n                if grid[next_r, next_c, k_idx] > 0:\n                    is_next_cell_traversable = False\n                    break\n            \n            if is_next_cell_traversable:\n                visited.add(next_pos) # Mark as visited\n                # Add to queue: new position and the path taken to reach it\n                # The path includes the current_pos because we are moving *from* it.\n                q.append((next_pos, current_path_segments + [curr_pos]))\n\n    if not path_found_coords:\n        return [] # No path found to an adjacent traversable cell for the primitive\n\n    # Convert the found path of coordinates into a sequence of actions\n    for i in range(len(path_found_coords) - 1):\n        p1 = path_found_coords[i]\n        p2 = path_found_coords[i+1]\n        dr, dc = p2[0] - p1[0], p2[1] - p1[1] # Calculate delta from current to next position\n        action = _DELTAS_TO_ACTION.get((dr, dc)) # Map delta to an action (UP, DOWN, LEFT, RIGHT)\n        if action is not None:\n            actions.append(action)\n        else:\n            # This indicates an internal error in pathfinding or delta mapping,\n            # as a valid path should only consist of cardinal movements.\n            return [] # Invalidate the current attempt and return empty list\n            \n    # After moving to a cell adjacent to the primitive, add the USE action\n    # This action attempts to collect the primitive.\n    actions.append(USE)\n    \n    return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:09:54.756745", "function_name": "collect", "function_body": "    current_state = env._current_state\n    agent_pos = current_state.pos\n    grid = current_state.grid\n    world = current_state.world # This is the CraftWorld instance\n\n    # Get non-grabbable entities that act as obstacles\n    non_grabbable_indices = world.non_grabbable_indices\n\n    # Define dimensions\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # Define action codes\n    # DOWN = 0, UP = 1, LEFT = 2, RIGHT = 3, USE = 4\n\n    # Check if the primitive is already next to the agent (or at the agent's position).\n    # If so, just use it.\n    if current_state.next_to(primitive):\n        return [4] # USE action\n\n    # Find all locations of the primitive on the grid.\n    primitive_locs = np.argwhere(grid[:, :, primitive] > 0)\n\n    if len(primitive_locs) == 0:\n        # Primitive not found on the grid, or already collected.\n        return []\n\n    # Find the closest primitive location to pathfind to.\n    target_loc = None\n    min_dist = float('inf')\n    for loc_coords in primitive_locs:\n        dist = abs(loc_coords[0] - agent_pos[0]) + abs(loc_coords[1] - agent_pos[1])\n        if dist < min_dist:\n            min_dist = dist\n            target_loc = tuple(loc_coords) # Convert to tuple for consistent hashing\n\n    if target_loc is None:\n        # Should not happen if primitive_locs was not empty, but for safety.\n        return []\n\n    # Helper function to check if a cell is passable\n    def is_passable(px, py):\n        # Check bounds\n        if not (0 <= px < WIDTH and 0 <= py < HEIGHT):\n            return False\n        # Check for non-grabbable obstacles\n        for i_kind in non_grabbable_indices:\n            if grid[px, py, i_kind] > 0:\n                return False\n        return True\n\n    # BFS to find the shortest path to a cell adjacent to the target primitive\n    # Queue stores (current_position_tuple, list_of_actions_taken_so_far)\n    queue = collections.deque([(agent_pos, [])])\n    visited = {agent_pos}\n\n    # Action deltas: (dx, dy, action_code) for (DOWN, UP, LEFT, RIGHT)\n    move_actions = [\n        (0, 1, 0),  # DOWN\n        (0, -1, 1), # UP\n        (-1, 0, 2), # LEFT\n        (1, 0, 3)   # RIGHT\n    ]\n\n    while queue:\n        (curr_x, curr_y), path = queue.popleft()\n\n        for dx, dy, action in move_actions:\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_pos = (next_x, next_y)\n\n            if is_passable(next_x, next_y) and next_pos not in visited:\n                new_path = path + [action]\n\n                # Check if this new position is adjacent to the target primitive\n                # Manhattan distance of 1 means it's adjacent (N, S, E, W)\n                if abs(next_x - target_loc[0]) + abs(next_y - target_loc[1]) == 1:\n                    return new_path + [4] # Found path, append USE action\n\n                visited.add(next_pos)\n                queue.append((next_pos, new_path))\n\n    # If the queue is exhausted and no path was found (e.g., primitive unreachable)\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:11:04.225205", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 0 and dy == 0:\n      return None # Agent is on the item, or item is not displaced.\n\n    # Determine primary axis movement (horizontal or vertical) for facing\n    # Prioritize horizontal if magnitude is greater or equal, else vertical.\n    if abs(dx) >= abs(dy):\n      return EAST_DIR if dx > 0 else WEST_DIR\n    else: # abs(dy) > abs(dx)\n      return SOUTH_DIR if dy > 0 else NORTH_DIR\n\n  # Helper function: Returns actions to turn from current_dir to target_dir.\n  # Assumes LEFT_ACTION and RIGHT_ACTION are used for turning.\n  def _get_turn_actions(current_dir, target_dir):\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION) # Turn clockwise\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION) # Turn counter-clockwise\n    return actions\n\n  primitive_id = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n\n  # IMPROVEMENT: Check if primitive is already in inventory.\n  # If so, no actions are needed to collect it.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  grid = current_state.grid\n  agent_start_x, agent_start_y = current_state.pos\n  agent_start_dir = current_state.dir # Agent's initial facing direction\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Define all obstacle indices. These are entities the agent cannot move onto.\n  # This includes non-grabbable environment items (like water, stone) and workshops.\n  obstacle_indices = set(env.world.non_grabbable_indices)\n  obstacle_indices.update(env.world.workshop_indices)\n\n  # Find all locations where the target primitive exists on the grid.\n  primitive_y_coords, primitive_x_coords = np.where(grid[:, :, primitive_id] == 1)\n  \n  if len(primitive_x_coords) == 0:\n    return [] # Primitive not found anywhere on the grid.\n\n  primitive_locations = set()\n  for i in range(len(primitive_x_coords)):\n    primitive_locations.add((primitive_x_coords[i], primitive_y_coords[i]))\n  \n  # Step 1: Identify all potential agent positions (collection points)\n  # from which the agent can collect the primitive. These are traversable cells\n  # cardinally adjacent to any instance of the primitive.\n  potential_collection_points = set()\n  CARDINAL_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Directions for cardinal adjacency\n\n  for px, py in primitive_locations:\n    for dx, dy in CARDINAL_DELTAS:\n      adj_x, adj_y = px + dx, py + dy\n\n      # Check bounds for the adjacent cell\n      if not (0 <= adj_x < grid_width and 0 <= adj_y < grid_height):\n        continue\n\n      # A cell is traversable if:\n      # 1. It is not occupied by the target primitive itself (agent cannot move onto the item).\n      # 2. It is not occupied by any other defined obstacle (water, stone, workshop etc.).\n      is_primitive_at_adj = (grid[adj_y, adj_x, primitive_id] == 1)\n      is_other_obstacle_at_adj = any(grid[adj_y, adj_x, obs_idx] == 1 for obs_idx in obstacle_indices)\n      \n      if not is_primitive_at_adj and not is_other_obstacle_at_adj:\n        potential_collection_points.add((adj_x, adj_y))\n  \n  if not potential_collection_points:\n      return [] # No valid, traversable collection points found (e.g., item surrounded by obstacles).\n\n  # Step 2: Perform a Breadth-First Search (BFS) to find the shortest movement path\n  # from the agent's starting position to any of the potential_collection_points.\n  # The queue stores tuples: (current_x, current_y, list_of_actions_to_reach_here).\n  queue = collections.deque([(agent_start_x, agent_start_y, [])])\n  # A set to keep track of visited positions (x,y) to avoid cycles and redundant paths.\n  visited_positions = set([(agent_start_x, agent_start_y)])\n\n  shortest_movement_path_actions = []\n  final_agent_pos_for_collection = None # The (x,y) of the chosen collection point\n  target_item_pos_to_face = None       # The (x,y) of the specific primitive instance to face\n\n  # Mapping of movement actions to their corresponding (dx, dy) changes.\n  # These actions only change the agent's position, not its facing direction.\n  MOVEMENT_ACTIONS_TO_DELTAS = {\n      UP_ACTION: (0, -1),   # Move North (decreases Y)\n      DOWN_ACTION: (0, 1),  # Move South (increases Y)\n      LEFT_ACTION: (-1, 0), # Move West (decreases X)\n      RIGHT_ACTION: (1, 0), # Move East (increases X)\n  }\n\n  while queue:\n    curr_x, curr_y, current_path = queue.popleft()\n\n    # If the current position is one of our target collection points, we've found the shortest path.\n    if (curr_x, curr_y) in potential_collection_points:\n      shortest_movement_path_actions = current_path\n      final_agent_pos_for_collection = (curr_x, curr_y)\n      \n      # Now, identify *which* primitive instance this chosen_adj_pos is adjacent to.\n      # Any adjacent primitive will do for the USE action, so pick the first one found.\n      for dx, dy in CARDINAL_DELTAS:\n          item_x, item_y = curr_x + dx, curr_y + dy\n          if (item_x, item_y) in primitive_locations: # Check if it's an actual primitive location\n              target_item_pos_to_face = (item_x, item_y)\n              break \n      break # Path found, exit the BFS.\n\n    # Explore all possible movement actions from the current position.\n    for action, (dx, dy) in MOVEMENT_ACTIONS_TO_DELTAS.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check if the next position is within grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if this position has already been visited (implies a longer path or cycle).\n      if (next_x, next_y) in visited_positions:\n        continue\n\n      # Check if the next cell is traversable.\n      is_primitive_at_next = (grid[next_y, next_x, primitive_id] == 1)\n      is_other_obstacle_at_next = any(grid[next_y, next_x, obs_idx] == 1 for obs_idx in obstacle_indices)\n\n      if not is_primitive_at_next and not is_other_obstacle_at_next:\n        visited_positions.add((next_x, next_y))\n        queue.append((next_x, next_y, current_path + [action]))\n\n  # If the BFS completed without finding a path to any collection point.\n  if final_agent_pos_for_collection is None:\n    return []\n\n  # Step 3: Construct the full action sequence.\n  # This includes movement actions, then turning actions, then the USE action.\n  full_action_sequence = list(shortest_movement_path_actions) # Start with the movement path\n\n  # After moving, the agent's facing direction is still its initial direction (`agent_start_dir`)\n  # because movement actions do not change facing.\n  current_agent_dir = agent_start_dir \n\n  if target_item_pos_to_face is not None:\n    # Determine the required facing direction from the final collection position to the item.\n    required_face_dir = _get_target_facing_direction(\n        final_agent_pos_for_collection[0], final_agent_pos_for_collection[1],\n        target_item_pos_to_face[0], target_item_pos_to_face[1])\n    \n    if required_face_dir is not None:\n      # Append the necessary turning actions.\n      turn_actions = _get_turn_actions(current_agent_dir, required_face_dir)\n      full_action_sequence.extend(turn_actions)\n  \n  # Finally, append the USE action to collect the primitive.\n  full_action_sequence.append(USE_ACTION)\n\n  return full_action_sequence", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T20:11:05.240092", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from problem description context)\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Direction constants (standard North=0, East=1, South=2, West=3)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dy == 1 and dx == 0: return SOUTH_DIR\n    if dy == -1 and dx == 0: return NORTH_DIR\n    return None # Should not happen if agent_pos and item_pos are cardinally adjacent\n\n  # Helper function: Checks if a cell is traversable based on specific obstacle indices\n  def _is_traversable(grid, x, y, obstacle_indices, grid_width, grid_height):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any obstacle item is at (x, y)\n    for k_idx in obstacle_indices:\n      if grid[y, x, k_idx] == 1:\n        return False\n    return True\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # IMPROVEMENT from collect_v1: Check if primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Define obstacle indices for traversability (IMPROVEMENT from collect_v1)\n  # Agent cannot move onto non-grabbable items, workshop locations, or the primitive itself.\n  obstacle_indices = set()\n  obstacle_indices.update(env.world.non_grabbable_indices)\n  obstacle_indices.update(env.world.workshop_indices)\n  obstacle_indices.add(primitive_id) # Agent cannot occupy the same cell as the item it wants to collect\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Prepare BFS goal states: ((agent_adj_x, agent_adj_y, agent_facing_dir), (primitive_x, primitive_y))\n  # A BFS goal state is a (position, direction) from which the primitive can be 'USE'd.\n  bfs_goal_states = []\n  # Define deltas for checking cardinal adjacency to the primitive\n  ADJACENCY_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells for the agent to stand on\n    for dx_adj_from_item, dy_adj_from_item in ADJACENCY_DELTAS: \n      adj_x, adj_y = item_x + dx_adj_from_item, item_y + dy_adj_from_item\n\n      # Check if the adjacent cell is traversable for the agent\n      if _is_traversable(grid, adj_x, adj_y, obstacle_indices, grid_width, grid_height):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_goal_states.append(((adj_x, adj_y, required_dir), (item_x, item_y)))\n  \n  if not bfs_goal_states:\n    return [] # No traversable adjacent positions to any primitive instance\n\n  # BFS setup (state is represented as (x, y, dir))\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Parent map to reconstruct the path: {child_state: (parent_state, action_to_child)}\n  parent_map = {} \n  \n  found_goal_state_config = None # Stores the (x, y, dir) of the goal state once found\n\n  # Action definitions for BFS exploration (consistent with collect_v0's inferred action model):\n  # Movement actions (change position, agent direction does NOT change)\n  movement_actions = {\n      UP_ACTION: (0, -1),   # Move North (dy=-1)\n      DOWN_ACTION: (0, 1)    # Move South (dy=1)\n  }\n  \n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state (position and direction) is one of the goal states\n    for (goal_x, goal_y, goal_dir), _ in bfs_goal_states:\n      if (curr_x, curr_y, curr_dir) == (goal_x, goal_y, goal_dir):\n        found_goal_state_config = (curr_x, curr_y, curr_dir)\n        break # Found the shortest path to a goal\n    if found_goal_state_config is not None:\n      break # Exit BFS as soon as the shortest path is found\n\n    # Explore neighbors through MOVEMENT actions (UP_ACTION, DOWN_ACTION)\n    for action, (dx, dy) in movement_actions.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = curr_dir # Direction remains the same after movement in this model\n\n      next_state = (next_x, next_y, next_dir)\n      if _is_traversable(grid, next_x, next_y, obstacle_indices, grid_width, grid_height):\n        if next_state not in visited:\n          visited.add(next_state)\n          parent_map[next_state] = ((curr_x, curr_y, curr_dir), action)\n          queue.append(next_state)\n    \n    # Explore neighbors through TURNING actions (LEFT_ACTION, RIGHT_ACTION)\n    # These actions change direction but not position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]: \n      next_x, next_y = curr_x, curr_y # Position does not change for a pure turn\n      \n      # Calculate new direction based on the turn action\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise (NORTH=0, EAST=1, SOUTH=2, WEST=3)\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4 # Turn clockwise\n      \n      next_state = (next_x, next_y, next_dir)\n      # No traversability check needed for turning in place, only for moving into a cell.\n      if next_state not in visited:\n        visited.add(next_state)\n        parent_map[next_state] = ((curr_x, curr_y, curr_dir), turn_action)\n        queue.append(next_state)\n\n  if found_goal_state_config is None:\n    return [] # No path found to any primitive's collection point\n\n  # Reconstruct the path from the goal state back to the initial state\n  actions = []\n  curr_state = found_goal_state_config\n  initial_state = (initial_agent_x, initial_agent_y, initial_agent_dir)\n\n  while curr_state != initial_state:\n    parent_state, action = parent_map[curr_state]\n    actions.insert(0, action) # Prepend action to build path in correct order\n    curr_state = parent_state\n  \n  # Finally, append the USE action after reaching the correct position and facing direction.\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T20:12:38.921356", "function_name": "collect", "function_body": "    import collections # Keep this import inside to fit the \"only return code that will fit in that function\" constraint\n\n    # Direction mappings (from CraftState description)\n    # 0: DOWN (+R, increasing row)\n    # 1: UP (-R, decreasing row)\n    # 2: LEFT (-C, decreasing col)\n    # 3: RIGHT (+C, increasing col)\n\n    # (dr, dc) for each direction index\n    _DIR_VECTORS = {\n        0: (1, 0),   # DOWN\n        1: (-1, 0),  # UP\n        2: (0, -1),  # LEFT\n        3: (0, 1)    # RIGHT\n    }\n\n    # Mapping (dr, dc) to direction index\n    _VEC_TO_DIR = {\n        (1, 0): 0,\n        (-1, 0): 1,\n        (0, -1): 2,\n        (0, 1): 3\n    }\n\n    # Mapping action to its effect: ((dr, dc), new_dir)\n    # When a movement action is taken, the agent's position changes by (dr, dc)\n    # and its facing direction updates to new_dir.\n    _ACTION_EFFECTS = {\n        0: ((1, 0), 0),   # DOWN\n        1: ((-1, 0), 1),  # UP\n        2: ((0, -1), 2),  # LEFT\n        3: ((0, 1), 3)    # RIGHT\n    }\n\n    # Heuristic limit for BFS search steps to prevent excessive computation for unreachable goals.\n    # This is distinct from actual environment steps.\n    max_search_steps = 1000 \n\n    # Get action mappings from the environment\n    actions_map = env.action_specs()\n    ACTION_DOWN = actions_map['DOWN']\n    ACTION_UP = actions_map['UP']\n    ACTION_LEFT = actions_map['LEFT']\n    ACTION_RIGHT = actions_map['RIGHT']\n    ACTION_USE = actions_map['USE']\n\n    all_actions = []\n\n    # Get current state observations from the environment\n    obs = env.observations()\n\n    # Extract current agent state components\n    # 'pos' is normalized, convert to integer grid coordinates\n    current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n    current_dir_one_hot = obs['features_dict']['direction']\n    current_dir = np.argmax(current_dir_one_hot) # Convert one-hot direction to an integer index\n\n    # Get grid dimensions and non-grabbable indices (obstacles) from the CraftWorld instance\n    grid = obs['features_dict']['features_global']\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n    \n    # Non-grabbable items are considered impassable obstacles\n    non_grabbable_indices = env.world.non_grabbable_indices\n    \n    # Current inventory\n    inventory = obs['features_dict']['inventory']\n\n    # If the primitive is already in inventory, no actions are needed\n    if inventory[primitive] > 0:\n        return []\n\n    # Find all locations of the target primitive on the grid\n    primitive_locations = []\n    for r_grid in range(WIDTH):\n        for c_grid in range(HEIGHT):\n            if grid[r_grid, c_grid, primitive] == 1:\n                primitive_locations.append((r_grid, c_grid))\n\n    # If the primitive is not found on the grid, it cannot be collected\n    if not primitive_locations:\n        return []\n\n    # BFS to find the shortest path to a cell from which the primitive can be 'USE'd\n    # BFS state: (row, col, current_facing_direction, list_of_actions_to_reach_here)\n    q = collections.deque([(current_pos[0], current_pos[1], current_dir, [])]) \n    # Visited set to avoid cycles and redundant paths: (row, col, current_facing_direction)\n    visited = set([(current_pos[0], current_pos[1], current_dir)]) \n\n    path_found_in_bfs = False\n    best_action_sequence = []\n    current_search_steps = 0\n\n    while q and current_search_steps < max_search_steps:\n        r, c, c_dir, actions_path = q.popleft()\n\n        # Check if the current position (r, c) is adjacent to any primitive location\n        # AND if the agent is facing that primitive correctly to use it.\n        for prim_r, prim_c in primitive_locations:\n            dr = prim_r - r\n            dc = prim_c - c\n\n            # Check if (r,c) and (prim_r, prim_c) are cardinally adjacent\n            if abs(dr) + abs(dc) == 1: \n                # Determine the direction from (r, c) pointing towards (prim_r, prim_c)\n                target_dir_to_primitive = _VEC_TO_DIR.get((dr, dc))\n                \n                # If the agent's current direction matches the direction to the primitive,\n                # then this is a valid position to use the primitive from.\n                if target_dir_to_primitive is not None and c_dir == target_dir_to_primitive:\n                    best_action_sequence = actions_path + [ACTION_USE]\n                    path_found_in_bfs = True\n                    break # Found a path, exit inner loop over primitive_locations\n        \n        if path_found_in_bfs:\n            break # Found a path, exit BFS queue loop\n\n        # Explore possible next states (movement actions)\n        for action_val, ((move_dr, move_dc), next_dir_after_move) in _ACTION_EFFECTS.items():\n            next_r, next_c = r + move_dr, c + move_dc\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n                continue\n\n            # Check if the next position is an obstacle (contains any non-grabbable item)\n            is_obstacle = False\n            for k_idx in non_grabbable_indices:\n                if grid[next_r, next_c, k_idx] == 1:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n            \n            # If the new state (position and direction) has not been visited, add it to the queue\n            if (next_r, next_c, next_dir_after_move) not in visited:\n                visited.add((next_r, next_c, next_dir_after_move))\n                q.append((next_r, next_c, next_dir_after_move, actions_path + [action_val]))\n        \n        current_search_steps += 1\n\n    if not path_found_in_bfs:\n        # If BFS couldn't find a path (queue exhausted or max_search_steps reached)\n        return [] \n\n    # Execute the found sequence of actions in the environment\n    for action in best_action_sequence:\n        reward, done, obs = env.step(action) # Take the action and get the new state observations\n        all_actions.append(action)\n        \n        # After each action (especially after the ACTION_USE), check if the primitive has been collected\n        inventory = obs['features_dict']['inventory']\n        if inventory[primitive] > 0:\n            return all_actions # Successfully collected\n\n    # Fallback: This part should ideally not be reached if the BFS path was correct and the\n    # environment behaves deterministically. It means the actions were taken but the\n    # collection didn't register (e.g., due to a dynamic environment or misaligned expectations).\n    return all_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:12:39.901024", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants (assuming DMLab conventions from action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Deltas for movement actions (dx, dy)\n  # Mapping: action -> (dx, dy) for moving (x, y) to (x+dx, y+dy)\n  # Based on CraftLab.action_specs: DOWN->0, UP->1, LEFT->2, RIGHT->3\n  # Assuming (0,0) is top-left, x increases right, y increases down\n  ACTION_DELTAS = {\n      ACTION_DOWN: (0, 1),   # Moves agent from (x, y) to (x, y+1)\n      ACTION_UP: (0, -1),    # Moves agent from (x, y) to (x, y-1)\n      ACTION_LEFT: (-1, 0),  # Moves agent from (x, y) to (x-1, y)\n      ACTION_RIGHT: (1, 0)   # Moves agent from (x, y) to (x+1, y)\n  }\n\n  state = env._current_state\n\n  # 1. Check if the primitive is already in inventory\n  if state.inventory[primitive] > 0:\n      return []\n\n  grid = state.grid\n  width, height, _ = grid.shape\n  start_pos = state.pos # Agent's current (x, y) position\n\n  # 2. Find all locations on the grid where the primitive exists\n  primitive_locations = []\n  for x in range(width):\n      for y in range(height):\n          if grid[x, y, primitive] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      return [] # Primitive not found on the map, cannot collect\n\n  # 3. Determine all valid \"next-to\" target cells for the agent.\n  # These are cells from which a 'USE' action would successfully collect the primitive.\n  # According to CraftState.next_to, this means any cell in the 3x3 neighborhood around\n  # the primitive's location (excluding the primitive's cell itself).\n  target_next_to_cells = set()\n  for px, py in primitive_locations:\n      # Iterate over the 3x3 neighborhood (including diagonals)\n      for dx_adj in [-1, 0, 1]:\n          for dy_adj in [-1, 0, 1]:\n              # The agent cannot be at the exact primitive location to be \"next to\" it.\n              # This excludes the center (0,0) offset.\n              if dx_adj == 0 and dy_adj == 0:\n                  continue\n              \n              tx, ty = px + dx_adj, py + dy_adj\n              # Check if the potential target cell is within grid boundaries\n              if 0 <= tx < width and 0 <= ty < height:\n                  target_next_to_cells.add((tx, ty))\n\n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n  # from the agent's start_pos to any of the target_next_to_cells.\n  # The queue stores tuples: ((current_x, current_y), [actions_taken_to_reach_here])\n  queue = collections.deque([(start_pos, [])]) \n  # The visited set stores positions to avoid redundant computations and cycles in the search.\n  visited = {start_pos}\n\n  while queue:\n      current_pos, actions_path = queue.popleft()\n\n      # If the current position is one of our target \"next-to\" cells, we've found a path\n      if current_pos in target_next_to_cells:\n          # Append the USE action and return the complete sequence of actions\n          return actions_path + [ACTION_USE]\n\n      # Explore all possible movement actions from the current position\n      for action, (dx, dy) in ACTION_DELTAS.items():\n          next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n          next_pos = (next_x, next_y)\n\n          # Check if the next position is within grid boundaries and has not been visited yet\n          # This BFS assumes all cells are traversable unless explicitly blocked by boundaries.\n          if (0 <= next_x < width and 0 <= next_y < height) and next_pos not in visited:\n              visited.add(next_pos)\n              queue.append((next_pos, actions_path + [action]))\n  \n  # If the queue becomes empty and no path was found to any target_next_to_cell\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:14:19.878332", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:14:19.947834", "function_name": "collect", "function_body": "    actions = []\n    max_steps = 200 # Safety limit to prevent infinite loops in case primitive is unreachable or logic is imperfect\n\n    # Action mappings for clarity (derived from CraftLab.action_specs)\n    # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Direction deltas: maps agent_dir_idx (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT) to (delta_row, delta_col)\n    # This assumes the direction one-hot array [UP, RIGHT, DOWN, LEFT] maps to indices 0, 1, 2, 3 respectively.\n    DIR_DELTAS = {\n        0: (-1, 0),  # UP (negative row change)\n        1: (0, 1),   # RIGHT (positive col change)\n        2: (1, 0),   # DOWN (positive row change)\n        3: (0, -1)   # LEFT (negative col change)\n    }\n\n    for _ in range(max_steps):\n        obs = env.observations()\n\n        # Check if the primitive is already in inventory\n        if obs['features_dict']['inventory'][primitive] > 0:\n            return actions\n\n        ego_view = obs['features_dict']['features_ego']\n        current_dir_one_hot = obs['features_dict']['direction']\n        current_dir_idx = np.argmax(current_dir_one_hot)\n\n        # Determine agent's position within the egocentric view (assumed center)\n        # Assuming ego_view is square, e.g., (W, W, n_kinds)\n        ego_h, ego_w, _ = ego_view.shape\n        agent_row, agent_col = ego_h // 2, ego_w // 2\n\n        # 1. Check if the primitive is in the cell directly in front of the agent\n        dr_front, dc_front = DIR_DELTAS[current_dir_idx]\n        front_row, front_col = agent_row + dr_front, agent_col + dc_front\n\n        # Ensure front_row, front_col are within ego_view bounds\n        if 0 <= front_row < ego_h and 0 <= front_col < ego_w:\n            if ego_view[front_row, front_col, primitive] > 0:\n                actions.append(ACTION_USE)\n                # Execute action to update environment state before re-checking inventory\n                _, done, _ = env.step(ACTION_USE)\n                if done: # If the environment signals done, we should stop\n                    return actions\n                continue # Re-evaluate state (inventory, ego_view) in the next iteration\n\n        # 2. Search for the closest primitive in the entire egocentric view\n        found_target_loc = None\n        min_manhattan_dist = float('inf')\n\n        for r in range(ego_h):\n            for c in range(ego_w):\n                if (r, c) == (agent_row, agent_col): # Skip agent's own cell\n                    continue\n                if ego_view[r, c, primitive] > 0:\n                    # Found the primitive. Prioritize by Manhattan distance.\n                    dist = abs(r - agent_row) + abs(c - agent_col)\n                    if dist < min_manhattan_dist:\n                        min_manhattan_dist = dist\n                        found_target_loc = (r, c)\n\n        if found_target_loc:\n            target_row, target_col = found_target_loc\n            dr_target, dc_target = target_row - agent_row, target_col - agent_col\n\n            # Determine the desired cardinal direction to face the target\n            # Prioritize moving along the axis with the larger displacement\n            desired_dir_idx = -1\n            if abs(dr_target) >= abs(dc_target):\n                if dr_target < 0:\n                    desired_dir_idx = 0 # UP\n                elif dr_target > 0:\n                    desired_dir_idx = 2 # DOWN\n            else:\n                if dc_target > 0:\n                    desired_dir_idx = 1 # RIGHT\n                elif dc_target < 0:\n                    desired_dir_idx = 3 # LEFT\n            \n            # If target is at (0,0) relative to agent, it means it's the agent itself\n            # which we already skipped. This check is more for robustness if logic changes.\n            if desired_dir_idx != -1:\n                if current_dir_idx == desired_dir_idx:\n                    # Already facing the target direction, so move forward\n                    move_action = None\n                    if current_dir_idx == 0: move_action = ACTION_UP\n                    elif current_dir_idx == 1: move_action = ACTION_RIGHT\n                    elif current_dir_idx == 2: move_action = ACTION_DOWN\n                    elif current_dir_idx == 3: move_action = ACTION_LEFT\n\n                    if move_action is not None:\n                        actions.append(move_action)\n                        _, done, _ = env.step(move_action)\n                        if done: return actions\n                        continue # Re-evaluate state in the next iteration\n                else:\n                    # Not facing the correct direction, need to turn.\n                    # Calculate shortest turn (clockwise or counter-clockwise).\n                    # Directions: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n                    turn_cw_count = (desired_dir_idx - current_dir_idx + 4) % 4\n                    turn_ccw_count = (current_dir_idx - desired_dir_idx + 4) % 4\n\n                    if turn_cw_count <= turn_ccw_count: # Prefer RIGHT if equal or shorter\n                        actions.append(ACTION_RIGHT)\n                        _, done, _ = env.step(ACTION_RIGHT)\n                    else: # Prefer LEFT\n                        actions.append(ACTION_LEFT)\n                        _, done, _ = env.step(ACTION_LEFT)\n                    if done: return actions\n                    continue # Re-evaluate state in the next iteration\n\n        # 3. If no primitive found in view, or couldn't determine optimal move\n        # (e.g., target is diagonal and not directly alignable by current simple logic),\n        # perform a random movement action to explore.\n        random_move_action = np.random.choice([ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT])\n        actions.append(random_move_action)\n        _, done, _ = env.step(random_move_action)\n        if done: return actions\n        # Continue to the next iteration to re-evaluate after random move\n\n    # If max_steps reached and primitive not collected, return current actions\n    return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:15:41.069137", "function_name": "collect", "function_body": "    import collections # collections is not imported globally in the provided snippet\n\n    # Retrieve action mapping from the environment for robustness\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    # Direction deltas for (dx, dy) corresponding to actions\n    # Assuming grid coordinates (x, y) where x is horizontal (width), y is vertical (height)\n    # (0,0) is typically top-left. x increases right, y increases down.\n    MOVE_DELTAS = {\n        UP: (0, -1),\n        DOWN: (0, 1),\n        LEFT: (-1, 0),\n        RIGHT: (1, 0),\n    }\n\n    # 1. Check current inventory to see if the primitive is already collected\n    obs = env.observations()\n    inventory = obs['features_dict']['inventory']\n\n    if inventory[primitive] > 0:\n        return []  # Primitive is already collected, no actions needed\n\n    # Get current state details from the environment\n    current_state = env._current_state\n    grid = current_state.grid\n    start_pos = current_state.pos  # Agent's current (x, y) position\n    width, height, _ = grid.shape   # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n\n    # 2. Check if the primitive is at the agent's current starting position\n    # If it is, the agent just needs to USE it to collect it.\n    if grid[start_pos[0], start_pos[1], primitive] > 0:\n        return [USE]\n\n    # 3. Perform Breadth-First Search (BFS) to find the shortest path\n    # to any cell containing the target primitive.\n    q = collections.deque()\n    # The queue stores tuples: (current_position (x,y), list_of_actions_to_reach_here)\n    q.append((start_pos, []))\n\n    visited = {start_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n    while q:\n        (cx, cy), path = q.popleft()\n\n        # Explore all possible adjacent moves (UP, DOWN, LEFT, RIGHT)\n        for action, (dx, dy) in MOVE_DELTAS.items():\n            nx, ny = cx + dx, cy + dy\n            new_pos = (nx, ny)\n\n            # Check if the new position is within grid boundaries\n            if 0 <= nx < width and 0 <= ny < height:\n                # Check if this position has already been visited\n                if new_pos not in visited:\n                    # Check if the new position contains the primitive we are looking for\n                    if grid[nx, ny, primitive] > 0:\n                        # Found the primitive! Return the path to this cell followed by a USE action.\n                        # The agent moves to (nx, ny) via 'action', then uses the item.\n                        return path + [action, USE]\n\n                    # If the primitive is not at this new position, add it to the queue\n                    # for further exploration, and mark it as visited.\n                    visited.add(new_pos)\n                    q.append((new_pos, path + [action]))\n\n    # If the BFS completes without finding a path to the primitive,\n    # it means the primitive is either not on the map or is unreachable.\n    return []", "island_id": 7, "scores": {"3": -1}}
