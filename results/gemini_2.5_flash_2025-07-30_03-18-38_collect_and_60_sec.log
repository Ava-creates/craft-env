{"timestamp": "2025-07-31T03:11:35.166788", "function_name": "collect", "function_body": "  import collections\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Define internal direction indices based on the order expected for agent's direction:\n  # Assuming 0: Down (South), 1: Up (North), 2: Left (West), 3: Right (East)\n  # This mapping is derived from how `features_dict['direction']` one-hot array works\n  # and how movement actions typically affect facing.\n  _DIR_DOWN = 0\n  _DIR_UP = 1\n  _DIR_LEFT = 2\n  _DIR_RIGHT = 3\n\n  # Mapping from a movement action_id to the resulting agent facing direction.\n  # Taking action _UP makes the agent face _DIR_UP.\n  action_to_new_dir = {\n      _UP: _DIR_UP,\n      _DOWN: _DIR_DOWN,\n      _LEFT: _DIR_LEFT,\n      _RIGHT: _DIR_RIGHT,\n  }\n\n  # Mapping from internal direction integer to (dx, dy) for the cell *moved into* by that direction,\n  # AND for the cell *in front* of the agent when facing that direction.\n  # (0,0) is top-left. positive X is right, positive Y is down.\n  dir_to_delta = {\n      _DIR_DOWN: (0, 1),   # Agent moves/faces Down: Y increases by 1\n      _DIR_UP: (0, -1),    # Agent moves/faces Up: Y decreases by 1\n      _DIR_LEFT: (-1, 0),  # Agent moves/faces Left: X decreases by 1\n      _DIR_RIGHT: (1, 0),  # Agent moves/faces Right: X increases by 1\n  }\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario (or current grid shape)\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n\n  # Convert one-hot initial direction from features_dict to an integer index\n  initial_dir_idx = np.argmax(features_dict['direction'])\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Identify non-grabbable items that act as obstacles (cannot be moved into).\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item that blocks movement.\"\"\"\n    if not non_grabbable_items_set: # Optimization for empty set\n        return False\n    for k_idx in non_grabbable_items_set:\n      if grid[x, y, k_idx] == 1:\n        return True\n    return False\n\n  # Use Breadth-First Search (BFS) to find the shortest path.\n  # Queue stores state tuples: (current_x, current_y, current_direction_idx)\n  q = collections.deque()\n  initial_state = (current_px, current_py, initial_dir_idx)\n  q.append(initial_state)\n  \n  # Dictionary to reconstruct path: maps child_state -> (parent_state, action_taken_to_reach_child)\n  parent_map = {initial_state: (None, None)} \n  \n  # Set to store visited states to avoid cycles and re-processing longer paths.\n  # A state is defined by (x, y, direction_idx).\n  visited = {initial_state}\n\n  goal_state = None # Will store the (x, y, dir_idx) state from which the primitive can be collected\n\n  while q:\n    cx, cy, c_dir_idx = q.popleft()\n\n    # --- Goal Check 1: Primitive on the agent's current square ---\n    # If the agent is standing on the primitive, it can be collected with _USE.\n    if current_grid[cx, cy, primitive] == 1:\n      goal_state = (cx, cy, c_dir_idx)\n      break # Shortest path found\n\n    # --- Goal Check 2: Primitive in front of the agent (directional _USE) ---\n    # Calculate the coordinates of the cell directly in front of the agent.\n    facing_dx, facing_dy = dir_to_delta[c_dir_idx]\n    fx, fy = cx + facing_dx, cy + facing_dy\n\n    # Check boundaries for the cell in front\n    if (0 <= fx < WIDTH and 0 <= fy < HEIGHT):\n        # If the cell in front contains the primitive\n        if current_grid[fx, fy, primitive] == 1:\n            goal_state = (cx, cy, c_dir_idx)\n            break # Shortest path found to a state from which to interact.\n\n    # --- Explore Movement Actions (UP, DOWN, LEFT, RIGHT) ---\n    # Each movement action updates both position and facing direction.\n    for action_id, new_dir_idx in action_to_new_dir.items():\n      # Calculate new position: the agent moves one step in the direction implied by the action.\n      move_dx, move_dy = dir_to_delta[new_dir_idx] \n      nx, ny = cx + move_dx, cy + move_dy\n\n      new_state = (nx, ny, new_dir_idx)\n\n      # Check validity: within bounds, not an obstacle, and not previously visited state\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n      \n      # If this new state (position and direction) has not been visited\n      if new_state not in visited:\n        q.append(new_state)\n        visited.add(new_state)\n        parent_map[new_state] = ((cx, cy, c_dir_idx), action_id)\n  \n  # If the BFS completed without finding a goal state, return empty list.\n  if goal_state is None:\n    return []\n\n  # Reconstruct the path by backtracking from the `goal_state`\n  actions_to_take = []\n  current = goal_state\n  \n  # Backtrack until we reach the initial state (where parent is None)\n  while parent_map[current][0] is not None:\n    parent, action = parent_map[current]\n    actions_to_take.append(action)\n    current = parent\n  \n  # The path is built in reverse, so reverse it to get actions from start to `goal_state`\n  actions_to_take = actions_to_take[::-1]\n\n  # Finally, append the _USE action, as the `goal_state` is defined as the state\n  # from which the item can be collected.\n  actions_to_take.append(_USE)\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T03:11:36.135556", "function_name": "collect", "function_body": "  import collections\n  # numpy is implicitly available from top-level imports and used as np\n\n  # Action constants derived from env.action_specs()\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Standard DMLab-style direction indices: N=0, E=1, S=2, W=3.\n  # These typically correspond to the order in the one-hot direction vector from `features_dict`.\n  _DIR_N = 0\n  _DIR_E = 1\n  _DIR_S = 2\n  _DIR_W = 3\n\n  # Mapping from a movement action_id to the resulting agent's new facing direction.\n  # For example, taking the _UP action typically moves the agent North and makes it face North.\n  action_to_new_dir = {\n      _UP: _DIR_N,      # Moving UP makes agent face North\n      _DOWN: _DIR_S,    # Moving DOWN makes agent face South\n      _LEFT: _DIR_W,    # Moving LEFT makes agent face West\n      _RIGHT: _DIR_E,   # Moving RIGHT makes agent face East\n  }\n\n  # Mapping from an internal direction index to its corresponding (dx, dy) delta.\n  # Assuming a grid where (0,0) is top-left, positive X is right, positive Y is down.\n  dir_to_delta = {\n      _DIR_N: (0, -1),   # North: Y decreases (moves up on grid)\n      _DIR_E: (1, 0),    # East: X increases (moves right on grid)\n      _DIR_S: (0, 1),    # South: Y increases (moves down on grid)\n      _DIR_W: (-1, 0),   # West: X decreases (moves left on grid)\n  }\n\n  # Get current state information from the environment's observations.\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  # The full allocentric grid copy.\n  current_grid = features_dict['features_global'] \n  \n  # Determine grid dimensions from the current grid's shape.\n  WIDTH, HEIGHT, _ = current_grid.shape\n\n  # Denormalize current agent position from [0, 1] range to grid coordinates.\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n\n  # Convert the one-hot initial direction from features_dict to an integer index.\n  initial_dir_idx = np.argmax(features_dict['direction'])\n\n  # If the primitive is not in the list of grabbable items, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Define what constitutes an obstacle. Here, any non-grabbable item (as defined by\n  # the world's non_grabbable_indices) is considered an obstacle that blocks movement.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item that blocks movement.\"\"\"\n    # If the set of non-grabbable items is empty, no obstacles exist.\n    if not non_grabbable_items_set:\n        return False\n    # Check if the cell at (x,y) contains any entity marked as non-grabbable.\n    for k_idx in non_grabbable_items_set:\n      if grid[x, y, k_idx] == 1:\n        return True\n    return False\n\n  # Initialize Breadth-First Search (BFS) to find the shortest action sequence.\n  # The queue stores tuples: (current_x, current_y, current_direction_idx, [path_actions_to_reach_here]).\n  q = collections.deque()\n  q.append((current_px, current_py, initial_dir_idx, []))\n  \n  # The `visited` set stores unique states (position and direction) to prevent cycles\n  # and ensure the shortest path is found for each state.\n  visited = {(current_px, current_py, initial_dir_idx)}\n\n  while q:\n    cx, cy, c_dir_idx, c_path = q.popleft()\n\n    # --- Goal Check 1: Primitive is on the agent's current square ---\n    # Many grabbable items can be picked up by simply standing on their cell,\n    # regardless of the agent's facing direction.\n    if current_grid[cx, cy, primitive] == 1:\n      # If found, the sequence is the path to this cell plus the _USE action.\n      return c_path + [_USE]\n\n    # --- Goal Check 2: Primitive is in front of the agent (requires directional _USE) ---\n    # Calculate the coordinates of the cell directly in front of the agent,\n    # based on its current facing direction.\n    facing_dx, facing_dy = dir_to_delta[c_dir_idx]\n    fx, fy = cx + facing_dx, cy + facing_dy\n\n    # Check if the cell in front is within grid boundaries.\n    if (0 <= fx < WIDTH and 0 <= fy < HEIGHT):\n        # If the cell directly in front contains the primitive.\n        if current_grid[fx, fy, primitive] == 1:\n            # If found, the sequence is the path to this position and orientation,\n            # followed by the _USE action.\n            return c_path + [_USE]\n\n    # --- Explore Movement Actions (UP, DOWN, LEFT, RIGHT) ---\n    # For each possible movement action:\n    for action_id, new_dir_idx in action_to_new_dir.items():\n      # Calculate the new position after performing this action.\n      # The agent moves one step in the direction corresponding to `new_dir_idx`.\n      move_dx, move_dy = dir_to_delta[new_dir_idx]\n      nx, ny = cx + move_dx, cy + move_dy\n\n      # Perform validity checks for the new cell:\n      # 1. Is it within the grid boundaries?\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n      # 2. Does it contain an obstacle (non-grabbable item that blocks movement)?\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n      \n      # Define the new state (new position and new facing direction).\n      new_state = (nx, ny, new_dir_idx)\n      # 3. Has this exact state been visited before (to find the shortest path)?\n      if new_state not in visited:\n        # If valid and unvisited, add to the queue for further exploration.\n        new_path = c_path + [action_id]\n        q.append((nx, ny, new_dir_idx, new_path))\n        visited.add(new_state)\n  \n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # return an empty list of actions.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T03:12:37.336434", "function_name": "collect", "function_body": "  import collections\n  # numpy is implicitly available from top-level imports and used as np\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Define direction constants (assuming 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  _DIR_UP = 0\n  _DIR_RIGHT = 1\n  _DIR_DOWN = 2\n  _DIR_LEFT = 3\n\n  # Movement deltas for each direction: (dx, dy)\n  # This maps a direction integer to the change in (x, y) coordinates\n  # when moving forward in that direction.\n  _MOVE_DELTAS = {\n      _DIR_UP: (0, -1),\n      _DIR_RIGHT: (1, 0),\n      _DIR_DOWN: (0, 1),\n      _DIR_LEFT: (-1, 0),\n  }\n\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario (which has the full grid shape)\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position to get starting coordinates\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  start_pos = (current_px, current_py)\n\n  # Get current agent direction from the one-hot encoding\n  current_dir_int = np.argmax(features_dict['direction'])\n\n  # Check if the primitive is grabbable. If not, it cannot be collected via this method.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get non-grabbable items which act as obstacles (cannot be moved into)\n  # This is already a set, as defined in CraftWorld.\n  non_grabbable_items_set = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, obstacle_set):\n    \"\"\"Checks if the cell (x,y) contains any item from the obstacle_set.\"\"\"\n    # If the set of obstacles is empty, no cell can be an obstacle.\n    if not obstacle_set:\n        return False\n    # Check if the cell at (x, y) contains any kind that is considered an obstacle\n    for k_idx in obstacle_set:\n      if grid[x, y, k_idx] == 1:\n        return True\n    return False\n\n  # Breadth-First Search (BFS) for the shortest action sequence.\n  # The state in BFS is (x, y, direction_of_agent), as turns also cost actions\n  # and the 'USE' action depends on the agent's facing direction.\n  \n  # Queue stores tuples: (current_x, current_y, current_direction, [path_actions_to_reach_here])\n  q = collections.deque()\n  q.append((start_pos[0], start_pos[1], current_dir_int, []))\n  \n  # Set to store visited states to avoid cycles and re-processing longer paths.\n  # A state is defined by (x, y, direction).\n  visited = {(start_pos[0], start_pos[1], current_dir_int)}\n\n  while q:\n    cx, cy, c_dir, c_path = q.popleft()\n\n    # --- Check if the primitive can be collected from the current state (cx, cy, c_dir) ---\n    # Determine the cell the agent is currently facing\n    face_dx, face_dy = _MOVE_DELTAS[c_dir]\n    facing_x, facing_y = cx + face_dx, cy + face_dy\n\n    # Check if the faced cell is within grid bounds and contains the target primitive\n    if (0 <= facing_x < WIDTH and 0 <= facing_y < HEIGHT and\n            current_grid[facing_x, facing_y, primitive] == 1):\n        # Goal found! Return the path accumulated so far, plus the _USE action.\n        return c_path + [_USE]\n\n    # --- Explore possible next actions from the current state ---\n\n    # 1. Try to Move Forward (into the cell the agent is facing)\n    nx, ny = facing_x, facing_y # New position if moving forward\n\n    # Check validity for moving forward: within bounds and not an obstacle\n    if (0 <= nx < WIDTH and 0 <= ny < HEIGHT and\n            not is_obstacle(nx, ny, current_grid, non_grabbable_items_set)):\n        # New state is (nx, ny, c_dir) because agent's direction doesn't change when moving forward\n        if (nx, ny, c_dir) not in visited:\n            # Determine the corresponding movement action (e.g., if facing UP, action is _UP)\n            move_action = None\n            if c_dir == _DIR_UP: move_action = _UP\n            elif c_dir == _DIR_DOWN: move_action = _DOWN\n            elif c_dir == _DIR_LEFT: move_action = _LEFT\n            elif c_dir == _DIR_RIGHT: move_action = _RIGHT\n            \n            # This check is mostly for robustness, `move_action` should always be set.\n            if move_action is not None: \n                new_path = c_path + [move_action]\n                q.append((nx, ny, c_dir, new_path))\n                visited.add((nx, ny, c_dir))\n\n    # 2. Try to Turn Left (agent stays at cx, cy but changes direction)\n    next_dir_left = (c_dir - 1 + 4) % 4 # Calculate new direction after turning left\n    if (cx, cy, next_dir_left) not in visited:\n        new_path = c_path + [_LEFT]\n        q.append((cx, cy, next_dir_left, new_path))\n        visited.add((cx, cy, next_dir_left))\n\n    # 3. Try to Turn Right (agent stays at cx, cy but changes direction)\n    next_dir_right = (c_dir + 1) % 4 # Calculate new direction after turning right\n    if (cx, cy, next_dir_right) not in visited:\n        new_path = c_path + [_RIGHT]\n        q.append((cx, cy, next_dir_right, new_path))\n        visited.add((cx, cy, next_dir_right))\n  \n  # If the queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T03:12:38.315395", "function_name": "collect", "function_body": "  import collections\n  # numpy is implicitly available from top-level imports and used as np\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Define direction constants (assuming 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  _DIR_UP = 0\n  _DIR_RIGHT = 1\n  _DIR_DOWN = 2\n  _DIR_LEFT = 3\n\n  # Map for turn actions: new_dir = turn_map[old_dir]\n  _TURN_RIGHT_MAP = {_DIR_UP: _DIR_RIGHT, _DIR_RIGHT: _DIR_DOWN, _DIR_DOWN: _DIR_LEFT, _DIR_LEFT: _DIR_UP}\n  _TURN_LEFT_MAP = {_DIR_UP: _DIR_LEFT, _DIR_LEFT: _DIR_DOWN, _DIR_DOWN: _DIR_RIGHT, _DIR_RIGHT: _DIR_UP}\n\n  # Map for move actions: (action_id, dx, dy, resulting_dir_if_moved)\n  # When an agent moves, its direction immediately aligns with the movement.\n  _MOVE_DELTAS = {\n      _UP: (0, -1, _DIR_UP),\n      _DOWN: (0, 1, _DIR_DOWN),\n      _LEFT: (-1, 0, _DIR_LEFT),\n      _RIGHT: (1, 0, _DIR_RIGHT),\n  }\n\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position to get starting coordinates\n  current_pos_normalized = features_dict['pos']\n  start_x = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  start_y = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  \n  # Get current agent direction from one-hot array\n  start_dir = np.argmax(features_dict['direction'])\n\n  # Check if the primitive is grabbable. If not, it cannot be collected via this method.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Identify non-grabbable items that act as obstacles (cannot be moved into)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item that blocks movement.\"\"\"\n    if not non_grabbable_items_set:\n        return False\n    for k_idx in non_grabbable_items_set:\n      if grid[x, y, k_idx] == 1:\n        return True\n    return False\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      if current_grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  # BFS Initialization\n  # Queue stores tuples: (current_x, current_y, current_direction, [path_actions_to_reach_here])\n  q = collections.deque()\n  q.append((start_x, start_y, start_dir, []))\n  \n  # Set to store visited states to avoid cycles and re-processing longer paths.\n  # A state is defined by (x, y, direction).\n  visited = set([(start_x, start_y, start_dir)])\n\n  while q:\n    cx, cy, c_dir, c_path = q.popleft()\n\n    # Check if the current state (position and direction) allows collection of a primitive.\n    # Collection requires being adjacent to the primitive and facing it.\n    for px, py in primitive_locations:\n        # Check 4 adjacent cells to the primitive, and the required facing direction.\n        # Agent at (px-1, py) needs to face RIGHT towards (px,py)\n        if cx == px - 1 and cy == py and c_dir == _DIR_RIGHT:\n            return c_path + [_USE]\n        # Agent at (px+1, py) needs to face LEFT towards (px,py)\n        elif cx == px + 1 and cy == py and c_dir == _DIR_LEFT:\n            return c_path + [_USE]\n        # Agent at (px, py-1) needs to face DOWN towards (px,py)\n        elif cx == px and cy == py - 1 and c_dir == _DIR_DOWN:\n            return c_path + [_USE]\n        # Agent at (px, py+1) needs to face UP towards (px,py)\n        elif cx == px and cy == py + 1 and c_dir == _DIR_UP:\n            return c_path + [_USE]\n\n    # Explore possible next states (movements and turns)\n\n    # 1. Movement Actions\n    for move_action, (dx, dy, new_dir_on_move) in _MOVE_DELTAS.items():\n        nx, ny = cx + dx, cy + dy\n        \n        # Check validity:\n        # a. Within grid boundaries\n        if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n            continue\n        # b. Not an obstacle\n        if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n            continue\n        \n        # When moving, the agent's direction updates to the direction of movement.\n        n_dir = new_dir_on_move \n        \n        # c. Not already visited in this (x, y, direction) state\n        if (nx, ny, n_dir) not in visited:\n            visited.add((nx, ny, n_dir))\n            q.append((nx, ny, n_dir, c_path + [move_action]))\n\n    # 2. Turn Actions (position remains same, only direction changes)\n    # Turn Right\n    n_dir_right = _TURN_RIGHT_MAP[c_dir]\n    if (cx, cy, n_dir_right) not in visited:\n        visited.add((cx, cy, n_dir_right))\n        q.append((cx, cy, n_dir_right, c_path + [_RIGHT]))\n\n    # Turn Left\n    n_dir_left = _TURN_LEFT_MAP[c_dir]\n    if (cx, cy, n_dir_left) not in visited:\n        visited.add((cx, cy, n_dir_left))\n        q.append((cx, cy, n_dir_left, c_path + [_LEFT]))\n            \n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T03:13:53.841519", "function_name": "collect", "function_body": "", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-31T03:13:54.851476", "function_name": "collect", "function_body": "  import collections\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n  \n  # Define direction constants (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  _DIR_UP = 0\n  _DIR_RIGHT = 1\n  _DIR_DOWN = 2\n  _DIR_LEFT = 3\n  \n  # Map directions to (delta_x, delta_y) for movement\n  _DIR_TO_DELTA = {\n      _DIR_UP: (0, -1),\n      _DIR_RIGHT: (1, 0),\n      _DIR_DOWN: (0, 1),\n      _DIR_LEFT: (-1, 0),\n  }\n\n  # Map directions to the corresponding move action\n  _DIR_TO_MOVE_ACTION = {\n      _DIR_UP: _UP,\n      _DIR_RIGHT: _RIGHT,\n      _DIR_DOWN: _DOWN,\n      _DIR_LEFT: _LEFT,\n  }\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Get current agent direction (convert one-hot array to integer)\n  current_dir_int = np.argmax(features_dict['direction'])\n\n  # IMPROVEMENT V2: Check if primitive is already in inventory\n  current_inventory = features_dict['inventory']\n  if current_inventory[primitive] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Identify obstacle indices. Assuming water and stone are obstacles that block movement.\n  obstacle_indices = {env.world.water_index, env.world.stone_index}\n\n  def _is_blocked(x, y):\n      \"\"\"Checks if a given grid cell (x, y) is out of bounds or contains an obstacle.\"\"\"\n      # Check if out of bounds\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return True\n      \n      # Check if the cell contains any obstacle kind\n      for obstacle_kind in obstacle_indices:\n          if current_grid[x, y, obstacle_kind] == 1:\n              return True\n      return False\n  \n  # Find all locations where the primitive exists on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell\n      if current_grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  # Pre-compute all target interaction states (x, y, facing_direction)\n  # These are the states from which the agent can successfully _USE the primitive.\n  # It's assumed the agent must be adjacent to the primitive and facing it.\n  target_interaction_states = set()\n  for target_x, target_y in primitive_locations:\n      # Candidate 1: Agent at (target_x - 1, target_y) needs to face RIGHT (towards target_x,target_y)\n      if not _is_blocked(target_x - 1, target_y):\n          target_interaction_states.add((target_x - 1, target_y, _DIR_RIGHT))\n      \n      # Candidate 2: Agent at (target_x + 1, target_y) needs to face LEFT\n      if not _is_blocked(target_x + 1, target_y):\n          target_interaction_states.add((target_x + 1, target_y, _DIR_LEFT))\n\n      # Candidate 3: Agent at (target_x, target_y - 1) needs to face DOWN\n      if not _is_blocked(target_x, target_y - 1):\n          target_interaction_states.add((target_x, target_y - 1, _DIR_DOWN))\n      \n      # Candidate 4: Agent at (target_x, target_y + 1) needs to face UP\n      if not _is_blocked(target_x, target_y + 1):\n          target_interaction_states.add((target_x, target_y + 1, _DIR_UP))\n  \n  if not target_interaction_states:\n      # This can happen if all primitive locations are completely surrounded by obstacles\n      # and there's no valid adjacent cell to stand on.\n      return []\n\n  # BFS Initialization\n  # Queue stores (x, y, direction, path_actions_list)\n  q = collections.deque()\n  # Visited set stores (x, y, direction) tuples to avoid cycles and redundant paths\n  visited = set() \n\n  # Add the agent's current state to the queue\n  start_state = (current_px, current_py, current_dir_int)\n  q.append((current_px, current_py, current_dir_int, []))\n  visited.add(start_state)\n\n  while q:\n      px, py, pdir, path_so_far = q.popleft()\n\n      # Check if the current state (position and direction) is a target interaction point.\n      # If it is, we have found the shortest path to an interaction point.\n      if (px, py, pdir) in target_interaction_states:\n          # Append the USE action and return the path\n          return path_so_far + [_USE]\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n\n      # 1. Try to Move Forward (in current_dir_int)\n      dx, dy = _DIR_TO_DELTA[pdir]\n      nx, ny = px + dx, py + dy\n      \n      # Check if the new position is valid (within bounds and not blocked by an obstacle)\n      if not _is_blocked(nx, ny):\n          next_state_move = (nx, ny, pdir)\n          # If this new state (position and direction) hasn't been visited yet\n          if next_state_move not in visited:\n              visited.add(next_state_move)\n              q.append((nx, ny, pdir, path_so_far + [_DIR_TO_MOVE_ACTION[pdir]]))\n\n      # 2. Try to Turn Left\n      new_dir_left = (pdir - 1 + 4) % 4 # Ensure direction wraps around (0-3)\n      next_state_left = (px, py, new_dir_left)\n      # If this new state (same position, new direction) hasn't been visited yet\n      if next_state_left not in visited:\n          visited.add(next_state_left)\n          q.append((px, py, new_dir_left, path_so_far + [_LEFT]))\n\n      # 3. Try to Turn Right\n      new_dir_right = (pdir + 1) % 4 # Ensure direction wraps around (0-3)\n      next_state_right = (px, py, new_dir_right)\n      # If this new state (same position, new direction) hasn't been visited yet\n      if next_state_right not in visited:\n          visited.add(next_state_right)\n          q.append((px, py, new_dir_right, path_so_far + [_RIGHT]))\n            \n  # If the BFS queue becomes empty and no path was found to any target interaction state\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-31T03:15:01.531887", "function_name": "collect", "function_body": "  import collections # Ensure collections is available\n  # numpy is already imported at the top level\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Define internal direction mapping for consistency with (dx, dy) deltas.\n  # Assuming 0:North (UP), 1:East (RIGHT), 2:South (DOWN), 3:West (LEFT)\n  DIR_N = 0\n  DIR_E = 1\n  DIR_S = 2\n  DIR_W = 3\n\n  # Map movement actions to the direction the agent will face after the action.\n  action_to_new_dir = {\n      _UP: DIR_N,\n      _RIGHT: DIR_E,\n      _DOWN: DIR_S,\n      _LEFT: DIR_W,\n  }\n\n  # Map direction indices to their (dx, dy) deltas for the cell \"in front\" of the agent.\n  dir_to_delta = {\n      DIR_N: (0, -1),\n      DIR_E: (1, 0),\n      DIR_S: (0, 1),\n      DIR_W: (-1, 0)\n  }\n\n  # Get current state information from the environment's observations.\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid.\n  \n  # Get grid dimensions from the current grid's shape.\n  WIDTH, HEIGHT, _ = current_grid.shape\n\n  # Denormalize current agent position from [0,1] range to grid coordinates.\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  initial_pos = (current_px, current_py)\n\n  # Convert one-hot initial direction to an integer index (0-3).\n  initial_dir_idx = np.argmax(features_dict['direction'])\n\n  # Pre-check: If the primitive is not grabbable, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Improvement for v2: More precise definition of impassable obstacles for movement.\n  # Based on common CraftWorld assumptions, only 'water' is considered an impassable\n  # barrier that the agent cannot move onto. Other non-grabbable items (e.g., workshops)\n  # are assumed traversable unless explicitly stated otherwise.\n  IMPASSABLE_OBSTACLES = {env.world.water_index}\n\n  def _is_traversable(x, y, grid_data, width, height, impassable_indices_set):\n      \"\"\"\n      Checks if a cell (x,y) is within grid bounds and does not contain any\n      entity defined as an impassable obstacle.\n      \"\"\"\n      # Check bounds of the grid\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      \n      # Check if the cell contains any of the identified impassable obstacles\n      for k_idx in impassable_indices_set:\n          if grid_data[x, y, k_idx] == 1:\n              return False # Contains an impassable obstacle, thus not traversable\n      return True # Traversable (no explicitly defined impassable obstacles present)\n\n  # Use Breadth-First Search (BFS) to find the shortest path in terms of actions.\n  # The queue stores tuples: (current_x, current_y, current_direction_idx, [path_actions_to_reach_here]).\n  q = collections.deque()\n  q.append((initial_pos[0], initial_pos[1], initial_dir_idx, []))\n  \n  # Set to store visited states to avoid cycles and re-processing longer paths.\n  # A state is defined by (x, y, direction_idx) because the 'USE' action is direction-dependent.\n  visited = {(initial_pos[0], initial_pos[1], initial_dir_idx)}\n\n  while q:\n    cx, cy, c_dir_idx, c_path = q.popleft()\n\n    # 1. Check if the primitive can be collected from the current state (position + direction).\n    # The _USE action applies to the cell directly in front of the agent.\n    target_dx, target_dy = dir_to_delta[c_dir_idx]\n    tx, ty = cx + target_dx, cy + target_dy\n\n    # Check if the cell in front is within bounds and contains the primitive we want to collect.\n    # We use _is_traversable with an empty set for impassable_indices_set here\n    # because the target cell is where the USE action is directed, not necessarily where the agent moves.\n    # The critical check for collection is if the primitive is present.\n    if (_is_traversable(tx, ty, current_grid, WIDTH, HEIGHT, {}) and\n        current_grid[tx, ty, primitive] == 1):\n      # If the primitive is directly in front, we found a path to collect it!\n      return c_path + [_USE]\n\n    # 2. Explore movement actions (UP, DOWN, LEFT, RIGHT).\n    # Each movement action results in a new position and a new facing direction.\n    for action, new_dir_idx in action_to_new_dir.items():\n      # Calculate the new position after performing this movement action.\n      # The agent moves into the cell corresponding to its new facing direction.\n      move_dx, move_dy = dir_to_delta[new_dir_idx]\n      nx, ny = cx + move_dx, cy + move_dy\n\n      # Check if the new position is traversable (within bounds and no impassable obstacles).\n      # Here, we pass IMPASSABLE_OBSTACLES as we are checking for agent movement.\n      if not _is_traversable(nx, ny, current_grid, WIDTH, HEIGHT, IMPASSABLE_OBSTACLES):\n        continue\n\n      # If this new state (position and direction) has not been visited before,\n      # add it to the queue for further exploration.\n      if (nx, ny, new_dir_idx) not in visited:\n        new_path = c_path + [action]\n        q.append((nx, ny, new_dir_idx, new_path))\n        visited.add((nx, ny, new_dir_idx))\n  \n  # If the queue becomes empty and no path to collect the primitive was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T03:15:02.579671", "function_name": "collect", "function_body": "  import collections # Ensure collections is available\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Define internal direction mapping for consistency with (dx, dy) deltas.\n  # Assuming 0:North (UP), 1:East (RIGHT), 2:South (DOWN), 3:West (LEFT)\n  DIR_N = 0\n  DIR_E = 1\n  DIR_S = 2\n  DIR_W = 3\n\n  # Map movement actions to the direction the agent will face after the action.\n  action_to_new_dir = {\n      _UP: DIR_N,\n      _RIGHT: DIR_E,\n      _DOWN: DIR_S,\n      _LEFT: DIR_W,\n  }\n\n  # Map direction indices to their (dx, dy) deltas for the cell \"in front\" of the agent.\n  dir_to_delta = {\n      DIR_N: (0, -1),\n      DIR_E: (1, 0),\n      DIR_S: (0, 1),\n      DIR_W: (-1, 0)\n  }\n\n  # Get current state information from the environment's observations.\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid.\n  \n  # Get grid dimensions from the current grid's shape.\n  WIDTH, HEIGHT, N_KINDS = current_grid.shape\n\n  # Denormalize current agent position from [0,1] range to grid coordinates.\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n\n  # Convert one-hot initial direction to an integer index (0-3).\n  initial_dir_idx = np.argmax(features_dict['direction'])\n\n  # Pre-check: If the primitive is not grabbable, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # --- IMPROVEMENT FOR COLLECT_V2 ---\n  # In `collect_v1`, the `is_obstacle` function considered all `non_grabbable_indices`\n  # as impassable obstacles for agent movement. This is often incorrect, as some\n  # non-grabbable items (like workshops) are typically traversable.\n  # `collect_v2` defines obstacles more precisely, assuming only `water_index`\n  # is truly impassable unless other specific impassable entities are explicitly defined.\n  impassable_entity_indices = {env.world.water_index} \n\n  def is_obstacle(x, y, grid, impassable_items_set):\n    \"\"\"\n    Checks if the cell (x,y) is outside grid boundaries or contains any impassable item.\n    \"\"\"\n    # Check bounds of the grid first\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n        return True # Out of bounds is implicitly an obstacle\n\n    # Check if the cell contains any of the identified impassable items\n    # (e.g., water, which typically blocks movement).\n    for k_idx in impassable_items_set:\n      if grid[x, y, k_idx] == 1:\n        return True # Contains an impassable item, thus is an obstacle\n    return False # Not an obstacle (is traversable and in bounds)\n  # --- END OF IMPROVEMENT FOR COLLECT_V2 ---\n\n  # Use Breadth-First Search (BFS) to find the shortest path in terms of actions.\n  # The queue stores tuples: (current_x, current_y, current_direction_idx, [path_actions_to_reach_here]).\n  q = collections.deque()\n  q.append((current_px, current_py, initial_dir_idx, []))\n  \n  # Set to store visited states to avoid cycles and re-processing longer paths.\n  # A state is defined by (x, y, direction_idx) because the 'USE' action is direction-dependent.\n  visited = {(current_px, current_py, initial_dir_idx)}\n\n  while q:\n    cx, cy, c_dir_idx, c_path = q.popleft()\n\n    # 1. Check if the primitive can be collected from the current state (position + direction).\n    # The _USE action applies to the cell directly in front of the agent.\n    target_dx, target_dy = dir_to_delta[c_dir_idx]\n    tx, ty = cx + target_dx, cy + target_dy\n\n    # Check if the cell in front is within bounds and contains the primitive we want to collect.\n    # The primitive itself is generally not an obstacle to the agent's movement *onto its cell*,\n    # but it is the target of the `_USE` action when adjacent.\n    if (0 <= tx < WIDTH and 0 <= ty < HEIGHT and\n        current_grid[tx, ty, primitive] == 1):\n      # If the primitive is directly in front, we found a path to collect it!\n      return c_path + [_USE]\n\n    # 2. Explore movement actions (UP, DOWN, LEFT, RIGHT).\n    # Each movement action results in a new position and a new facing direction.\n    for action, new_dir_idx in action_to_new_dir.items():\n      # Calculate the new position after performing this movement action.\n      # The delta for movement is based on the direction the agent will end up facing.\n      move_dx, move_dy = dir_to_delta[new_dir_idx]\n      nx, ny = cx + move_dx, cy + move_dy\n\n      # Check if the new cell is blocked by an obstacle (e.g., water) or out of bounds.\n      if is_obstacle(nx, ny, current_grid, impassable_entity_indices):\n        continue\n\n      # If this new state (position and direction) has not been visited before,\n      # add it to the queue for further exploration.\n      if (nx, ny, new_dir_idx) not in visited:\n        new_path = c_path + [action]\n        q.append((nx, ny, new_dir_idx, new_path))\n        visited.add((nx, ny, new_dir_idx))\n  \n  # If the queue becomes empty and no path to collect the primitive was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T03:16:09.948307", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n  This version corrects the behavior by not resetting the environment,\n  allowing `collect` to be called from the current state of an ongoing episode.\n  It refines pathfinding logic for clarity and robustness, ensuring that\n  the maximum step count applies to the total actions taken, including 'USE'.\n  \"\"\"\n  import collections\n  from enum import IntEnum\n\n  # Define action constants and agent directions for clarity.\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent facing directions (consistent with CraftState.dir mapping)\n  DIR_NORTH = 0 # Agent facing UP (negative Y)\n  DIR_EAST = 1  # Agent facing RIGHT (positive X)\n  DIR_SOUTH = 2 # Agent facing DOWN (positive Y)\n  DIR_WEST = 3  # Agent facing LEFT (negative X)\n\n  # Maximum total actions allowed for collection, including movements and the final USE.\n  # This prevents excessively long searches and helps manage computational budget.\n  MAX_COLLECT_STEPS = 100\n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"Calculates the grid coordinates (y, x) of the cell directly in front of the agent.\"\"\"\n      if direction == DIR_NORTH:\n          return y - 1, x\n      elif direction == DIR_EAST:\n          return y, x + 1\n      elif direction == DIR_SOUTH:\n          return y + 1, x\n      elif direction == DIR_WEST:\n          return y, x - 1\n      return y, x # Should not happen with valid directions\n\n  actions_executed = [] # List to store actions taken during execution\n\n  # CRITICAL IMPROVEMENT FOR V2: DO NOT call env.reset().\n  # The function must operate from the *current* state of the environment,\n  # allowing it to be part of a larger sequence of actions.\n  current_state = env._current_state\n\n  # Pre-checks for early exit, optimizing performance for common scenarios.\n  # 1. Check if the primitive index is valid and known to the world.\n  if primitive not in current_state.world.cookbook.kinds:\n      return [] # Unknown primitive, cannot be collected.\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[primitive] > 0:\n      return [] # Primitive is already collected, no actions needed.\n\n  # 3. If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # Get necessary information from the current state for pathfinding.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir # Crucially, use the agent's current direction.\n\n  # Determine which entity kinds are impassable for agent movement.\n  # This set typically includes non-grabbable items that are not workshops, plus water.\n  impassable_for_movement = set(current_state.world.non_grabbable_indices)\n  impassable_for_movement.difference_update(current_state.world.workshop_indices)\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n\n  # Convert the set of impassable kinds to a list for efficient NumPy indexing\n  # during grid traversability checks within the BFS loop.\n  impassable_kinds_list = list(impassable_for_movement)\n\n  # Map movement actions to their (resulting_direction, dy, dx) changes.\n  # This is essential for BFS to track agent orientation after a move,\n  # as the 'USE' action is dependent on the agent's facing direction.\n  movement_actions_map = {\n      ACTION_UP:    (DIR_NORTH, -1, 0),\n      ACTION_RIGHT: (DIR_EAST,  0, 1),\n      ACTION_DOWN:  (DIR_SOUTH, 1, 0),\n      ACTION_LEFT:  (DIR_WEST,  0, -1)\n  }\n\n  q = collections.deque()\n  # BFS state tuple: (current_y, current_x, current_direction, list_of_actions_so_far)\n  q.append((start_y, start_x, start_dir, []))\n\n  # Visited set to prevent redundant exploration and infinite loops in cyclic maps.\n  # A state is defined by (y, x, direction) because direction impacts subsequent 'USE' actions.\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None # This will store the shortest action sequence if found.\n\n  # --- Breadth-First Search (BFS) to find the shortest path to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Pruning 1: If the current path length already equals or exceeds the maximum allowed steps,\n      # it cannot lead to a valid solution because at least one more action (USE) is required.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # Check if the target primitive is in the cell directly in front of the agent.\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Ensure the facing coordinates are within grid boundaries.\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width):\n          # Check if the facing cell contains the target primitive.\n          if full_grid[facing_y, facing_x, primitive] > 0:\n              # Found a state from which ACTION_USE can be performed.\n              candidate_path = path + [ACTION_USE]\n\n              # Ensure the complete path (including the final ACTION_USE) is within the step limit.\n              if len(candidate_path) <= MAX_COLLECT_STEPS:\n                  path_to_execute = candidate_path\n                  # Since BFS explores level by level, the first valid path found is the shortest.\n                  break # Exit the BFS loop.\n\n      # Explore all possible next states from the current state by trying movement actions.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Pruning 2: If adding this move action would result in a path that, even before\n          # the final ACTION_USE, already equals or exceeds the total step limit, prune it.\n          # This ensures that any path added to the queue always has at least one step available for ACTION_USE.\n          if len(path) + 1 >= MAX_COLLECT_STEPS: # +1 for the current move action\n              continue\n\n          # Check if the proposed next agent position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable (i.e., does not contain impassable kinds).\n          is_traversable = True\n          # Only perform NumPy check if there are actual impassable kinds defined to avoid unnecessary operations.\n          if impassable_kinds_list:\n              # np.any efficiently checks if any of the specified impassable kinds exist at the target cell.\n              if np.any(full_grid[next_y, next_x, impassable_kinds_list] > 0):\n                  is_traversable = False\n\n          if not is_traversable:\n              continue\n\n          # Check if this new (position, direction) state has already been visited.\n          # This prevents redundant exploration and infinite loops in cyclic environments.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # If all checks pass, add the new state to the queue and mark it as visited.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n\n  # --- Execute the found path in the environment (if a path was successfully found) ---\n  if path_to_execute is None:\n      return [] # No valid path to collect the primitive was found within the constraints.\n\n  for action in path_to_execute:\n      # Before executing an action, check if the episode's global step limit\n      # (managed by the CraftLab environment) has been reached. This prevents attempting\n      # actions beyond the environment's termination point.\n      if env.steps >= env.max_steps:\n          # If max_steps is hit, the episode is effectively over, and we cannot complete the task.\n          break\n\n      actions_executed.append(action) # Record the action taken.\n\n      # Perform the action in the environment.\n      reward, done, _ = env.step(action)\n      # Crucial: Update the internal `current_state` reference after each step to reflect\n      # the environment's new state (e.g., inventory changes, position updates).\n      current_state = env._current_state\n\n      # Check if the primitive has been collected after this action.\n      if current_state.inventory[primitive] > 0:\n          return actions_executed # Success! Return the sequence of actions that led to collection.\n\n      # If the environment becomes 'done' for any reason (e.g., reaching a terminal state\n      # or a specific failure condition) and the primitive hasn't been collected,\n      # then the collection attempt has failed.\n      if done:\n          return [] # Episode ended prematurely without successfully collecting the item.\n\n  # Final check: After attempting to execute all actions in `path_to_execute`,\n  # verify if the primitive was ultimately collected. This handles cases where\n  # the primitive is collected on the very last action of the sequence.\n  if current_state.inventory[primitive] > 0:\n      return actions_executed # Successfully collected.\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it indicates an issue (e.g., environment changed dynamically, or a path\n      # was found that didn't truly lead to collection).\n      return [] # Collection failed after executing the planned path.", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T03:16:11.098954", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  # Define action constants explicitly, as they are used internally and\n  # are common in CraftWorld environments.\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent facing directions (consistent with CraftState.dir mapping)\n  DIR_NORTH = 0 # Agent facing UP\n  DIR_EAST = 1  # Agent facing RIGHT\n  DIR_SOUTH = 2 # Agent facing DOWN\n  DIR_WEST = 3  # Agent facing LEFT\n\n  # Maximum total actions allowed for collection, including movements and the final USE.\n  # This can prevent excessively long searches and protect against infinite loops in complex maps.\n  MAX_COLLECT_STEPS = 100 \n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"Returns the coordinates (y, x) of the cell directly in front of the agent.\"\"\"\n      if direction == DIR_NORTH:\n          return y - 1, x\n      elif direction == DIR_EAST:\n          return y, x + 1\n      elif direction == DIR_SOUTH:\n          return y + 1, x\n      elif direction == DIR_WEST:\n          return y, x - 1\n      return y, x # Fallback, though should not be reached with valid directions\n\n  actions_taken = []\n  \n  # IMPORTANT IMPROVEMENT for v2: Do NOT call env.reset() here.\n  # The `collect` function should compute actions from the *current* state of the environment,\n  # allowing it to be chained with other actions or used as part of a larger plan.\n  # Access the internal CraftState instance directly to get the current state information.\n  current_state = env._current_state \n\n  # Pre-check: Verify the primitive index is known to the world.\n  if primitive not in current_state.world.cookbook.kinds:\n      return [] # Unknown primitive, cannot collect.\n\n  # Pre-check: If the primitive is already in the inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Get initial grid state and agent's position/direction for BFS.\n  # Use current_state.grid directly for the full world grid, which is more direct than features_dict.\n  full_grid = current_state.grid\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir \n\n  # Define which entity kinds are impassable for agent movement.\n  # Start with all non-grabbable entities.\n  impassable_for_movement = set(current_state.world.non_grabbable_indices)\n  \n  # Workshops are typically non-grabbable but traversable for movement.\n  impassable_for_movement.difference_update(current_state.world.workshop_indices)\n  \n  # Water is typically an impassable entity for movement.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n\n  # Convert the set of impassable kinds to a list for efficient NumPy indexing.\n  impassable_kinds_list = list(impassable_for_movement)\n  \n  # Map movement actions to their (resulting_direction, dy, dx) changes.\n  # This is crucial for BFS to track agent orientation after a move.\n  movement_actions_map = {\n      ACTION_UP:    (DIR_NORTH, -1, 0), # Move North (y-1), agent faces North (dir=0)\n      ACTION_RIGHT: (DIR_EAST,  0, 1),  # Move East (x+1), agent faces East (dir=1)\n      ACTION_DOWN:  (DIR_SOUTH, 1, 0),  # Move South (y+1), agent faces South (dir=2)\n      ACTION_LEFT:  (DIR_WEST,  0, -1)  # Move West (x-1), agent faces West (dir=3)\n  }\n\n  q = collections.deque()\n  # BFS state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  q.append((start_y, start_x, start_dir, []))\n  \n  # Visited set: Tracks (y, x, dir) states to prevent cycles and redundant exploration.\n  visited = {(start_y, start_x, start_dir)} \n\n  path_to_use = None # This will store the full sequence of actions (moves + final USE).\n\n  # --- Breadth-First Search to find the shortest path to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Pruning: If the current path is already too long to allow for the final ACTION_USE,\n      # or if it hits the general step limit, discard it.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # Check if the primitive is directly in front of the agent at the current (position, direction).\n      # Corrected: Pass curr_x to _get_facing_coords.\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Ensure the facing coordinates are within grid boundaries.\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width):\n          # Check if the cell directly in front contains the primitive.\n          if full_grid[facing_y, facing_x, primitive] > 0:\n              # Found a path where the agent can collect the primitive.\n              # If there's still room for the ACTION_USE within MAX_COLLECT_STEPS,\n              # this is a valid solution.\n              if len(path) < MAX_COLLECT_STEPS:\n                  path_to_use = path + [ACTION_USE]\n                  break # Shortest path found, exit BFS.\n              # Else, current path is too long to append ACTION_USE, continue search.\n      \n      # Explore neighboring cells by applying movement actions.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Check if the proposed next agent position is within grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable (does not contain impassable kinds).\n          is_traversable = True\n          # Only perform numpy check if there are actual impassable kinds defined.\n          if impassable_kinds_list: \n              if np.any(full_grid[next_y, next_x, impassable_kinds_list] > 0):\n                  is_traversable = False\n          \n          if not is_traversable:\n              continue\n          \n          # Check if this (position, direction) state has already been visited.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # Add the new state to the queue and visited set.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n  \n  # --- Execute the found path in the environment (if any) ---\n  if path_to_use is None:\n      return [] # No valid path found to collect the primitive within the constraints.\n\n  for action in path_to_use:\n      # Before executing an action, check if the environment's internal step counter\n      # has reached its maximum, which would terminate the episode.\n      # Note: env.steps is incremented *after* step, so check if current step count is already max.\n      if env.steps >= env.max_steps: \n          break # Cannot perform more actions, path terminated prematurely.\n\n      actions_taken.append(action)\n      \n      # Execute the action in the environment.\n      reward, done, _ = env.step(action) \n      current_state = env._current_state # Update internal state reference after step.\n\n      # If the primitive is now in the inventory, we have successfully collected it.\n      # Return the sequence of actions taken.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n      \n      # If the environment becomes 'done' for any reason (e.g., reaching a terminal state\n      # or a specific failure condition) and the goal isn't met, the collection failed.\n      if done: \n          return [] \n  \n  # After attempting all actions in `path_to_use`:\n  # Check if the primitive was ultimately collected.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken # Successfully collected.\n  else:\n      return [] # Collection failed (e.g., max steps hit mid-path, or USE failed).", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T03:17:11.753688", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs\n  # CraftLab.action_specs: dict mapping DOWN\u21920, UP\u21921, LEFT\u21922, RIGHT\u21923, USE\u21924\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Define internal direction constants used by CraftState.dir and for grid calculations.\n  # Based on CraftState's common direction mapping in similar environments:\n  # 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT.\n  INTERNAL_DIR_UP = 0\n  INTERNAL_DIR_RIGHT = 1\n  INTERNAL_DIR_DOWN = 2\n  INTERNAL_DIR_LEFT = 3\n\n  # Maximum number of actions allowed for a collection path to prevent excessively long searches\n  # and to reflect practical limits in an agent's planning horizon.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function: determines coordinates of the cell directly in front of the agent.\n  # This function uses the agent's internal direction representation (INTERNAL_DIR_X).\n  def _get_facing_coords(y, x, internal_direction):\n      \"\"\"Returns the coordinates (y, x) of the cell directly in front of (y,x) based on\n      the agent's facing direction.\"\"\"\n      if internal_direction == INTERNAL_DIR_UP:    return y - 1, x\n      if internal_direction == INTERNAL_DIR_RIGHT: return y, x + 1\n      if internal_direction == INTERNAL_DIR_DOWN:  return y + 1, x\n      if internal_direction == INTERNAL_DIR_LEFT:  return y, x - 1\n      return y, x # Fallback, should not be reached with valid directions.\n\n  actions_taken = [] # List to store the sequence of actions to be returned.\n  \n  # 1. Initialize environment state and perform preliminary checks.\n  # Reset the environment to ensure a fresh start. The observation is not directly used here,\n  # but resetting is crucial for consistent state.\n  _ = env.reset()\n  # Access the internal CraftState instance for detailed information about the world,\n  # agent's position, inventory, and grid.\n  current_state = env._current_state \n\n  # Verify if the requested primitive is a recognized entity kind within the world.\n  if primitive not in current_state.world.cookbook.kinds:\n      # If the primitive is unknown, it cannot be collected.\n      return []\n\n  # Check if the primitive is already present in the agent's inventory.\n  if current_state.inventory[primitive] > 0:\n      # If already collected, no actions are needed.\n      return []\n\n  # Retrieve essential grid information and agent's initial state.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos         # Agent's initial Y, X coordinates.\n  start_dir = current_state.dir               # Agent's initial facing direction.\n\n  # Apply immediate limits on path length. If MAX_COLLECT_STEPS is non-positive,\n  # no actions are allowed.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # 2. Define Impassable Regions for Agent Movement.\n  # This set identifies entities or terrain types that the agent cannot move onto.\n  impassable_for_movement = set()\n  \n  # Generally, non-grabbable items that are *not* workshops are considered blocking terrain.\n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n  \n  # Water (if explicitly defined and present in the world) is usually impassable.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  # Stone (if explicitly defined and present) might also be impassable, depending on world rules.\n  # Assuming for this version that `stone_index` is a primitive and thus grabbable/not blocking movement.\n  # If stone was meant to be a blocking terrain, it would be added here.\n\n  # 3. Define Movement Actions and Their Effects on Agent State.\n  # Maps each CraftLab action ID (e.g., ACTION_UP) to a tuple containing:\n  # (resultant_internal_direction, delta_y, delta_x) for the agent's new state.\n  movement_actions_map = {\n      ACTION_UP:    (INTERNAL_DIR_UP,    -1, 0), # Move North (decreases Y), face North.\n      ACTION_RIGHT: (INTERNAL_DIR_RIGHT,  0, 1), # Move East (increases X), face East.\n      ACTION_DOWN:  (INTERNAL_DIR_DOWN,   1, 0), # Move South (increases Y), face South.\n      ACTION_LEFT:  (INTERNAL_DIR_LEFT,   0, -1) # Move West (decreases X), face West.\n  }\n\n  # 4. Breadth-First Search (BFS) to find the shortest action sequence.\n  q = collections.deque()\n  # BFS state is represented as: (current_y, current_x, current_internal_direction, path_of_actions_so_far)\n  q.append((start_y, start_x, start_dir, []))\n\n  # `visited` set to keep track of (position, direction) states already explored.\n  # This prevents infinite loops in cyclic environments and ensures the shortest path is found.\n  # The direction is crucial because an agent at the same (y,x) but facing a different direction\n  # constitutes a different state, especially for `ACTION_USE`.\n  visited = {(start_y, start_x, start_dir)} \n\n  path_to_execute = None # This variable will store the optimal action sequence, including ACTION_USE.\n\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Prune this search branch early if the current path already exceeds the maximum allowed steps.\n      # This check helps avoid exploring paths that are too long even before adding new steps.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # A. Check if the primitive can be collected from the current (position, direction) state.\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Ensure the cell the agent is facing is within grid boundaries.\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width):\n          # If the target primitive is in the cell the agent is facing,\n          # then `ACTION_USE` can be applied.\n          if full_grid[facing_y, facing_x, primitive] > 0:\n              candidate_path = path + [ACTION_USE]\n              \n              # If this complete path (including ACTION_USE) is within the step limit,\n              # it's a valid solution. Since BFS explores layer by layer, the first path\n              # found to the goal state will be the shortest.\n              if len(candidate_path) <= MAX_COLLECT_STEPS:\n                  path_to_execute = candidate_path\n                  break # Optimal path found, terminate the BFS.\n\n      # B. Explore neighboring states by applying movement actions.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          \n          # Prune search branches if adding this next step would exceed MAX_COLLECT_STEPS.\n          if len(path) + 1 > MAX_COLLECT_STEPS:\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable (i.e., not impassable terrain).\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n          \n          # Check if this specific (position, direction) state has already been explored.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # If the state is valid and new, add it to the queue and mark as visited.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n    \n  # 5. Execute the found path in the environment.\n  if path_to_execute is None:\n      # No valid path was found within MAX_COLLECT_STEPS to collect the primitive.\n      return [] \n\n  for action in path_to_execute:\n      actions_taken.append(action)\n      \n      # Take a step in the simulated environment.\n      reward, done, _ = env.step(action)\n      # Update the reference to the current state after each step.\n      current_state = env._current_state \n\n      # If the primitive is successfully collected after this action, stop execution early\n      # and return the actions taken so far.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n      \n      # If the episode ends prematurely (e.g., due to max_steps in CraftLab) AND\n      # the goal primitive has not been collected, then this path has failed.\n      if done and current_state.inventory[primitive] <= 0:\n          return [] # Path terminated unsuccessfully.\n\n  # 6. Final verification: After executing all actions in the determined path.\n  # This handles cases where the collection might happen precisely on the very last step.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # This case indicates that the BFS found a path that *should* lead to collection,\n      # but in execution, the collection did not occur. This might suggest a mismatch\n      # between the planner's assumptions and the environment's dynamics, or a\n      # very subtle edge case. For this problem, it implies failure.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T03:17:12.734951", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs, which maps names to integers.\n  # These are the actions that can be passed to env.step().\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Define internal direction constants used by CraftState.dir attribute.\n  # This mapping is consistent with common grid-world conventions and `_get_facing_coords`.\n  # 0: Up (North), 1: Right (East), 2: Down (South), 3: Left (West).\n  INTERNAL_DIR_UP = 0\n  INTERNAL_DIR_RIGHT = 1\n  INTERNAL_DIR_DOWN = 2\n  INTERNAL_DIR_LEFT = 3\n\n  # Maximum number of actions (including the final ACTION_USE) allowed in a collection path.\n  # This limit helps prevent excessively long or infinite searches in complex or open-ended\n  # environments, ensuring the function completes within a reasonable time.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function: determines the grid coordinates of the cell directly in front of the agent.\n  # This is crucial for determining where the `ACTION_USE` would apply.\n  def _get_facing_coords(y, x, internal_direction):\n      \"\"\"\n      Calculates the (y, x) coordinates of the grid cell directly in front of the agent.\n      \n      Args:\n          y (int): Agent's current row (Y) coordinate.\n          x (int): Agent's current column (X) coordinate.\n          internal_direction (int): Agent's current facing direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT).\n          \n      Returns:\n          tuple[int, int]: The (y, x) coordinates of the cell in front of the agent.\n      \"\"\"\n      if internal_direction == INTERNAL_DIR_UP:    return y - 1, x\n      if internal_direction == INTERNAL_DIR_RIGHT: return y, x + 1\n      if internal_direction == INTERNAL_DIR_DOWN:  return y + 1, x\n      if internal_direction == INTERNAL_DIR_LEFT:  return y, x - 1\n      # This fallback should ideally not be reached if internal_direction is always valid.\n      return y, x \n\n  actions_taken = [] # List to store the sequence of actions that lead to successful collection.\n  \n  # --- 1. Environment Initialization and Pre-checks ---\n  # Reset the environment to ensure a clean and consistent starting state for pathfinding.\n  # The observation dictionary returned by reset() is not directly needed for pathfinding,\n  # as we access the internal CraftState instance.\n  _ = env.reset() \n  current_state = env._current_state # Get a direct reference to the current CraftState.\n\n  # Validate the 'primitive' index. Ensure it corresponds to a known item kind in the world.\n  if primitive not in current_state.world.cookbook.kinds:\n      # If the primitive is not recognized, it cannot be collected.\n      return [] \n\n  # Check if the primitive is already present in the agent's inventory at the start.\n  if current_state.inventory[primitive] > 0:\n      # If already collected, no actions are necessary.\n      return []\n\n  # Extract necessary grid and agent information from the initial state for BFS.\n  full_grid = current_state.features_dict()['features_global'] # Full grid, including all item kinds.\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos      # Agent's initial Y, X coordinates.\n  start_dir = current_state.dir             # Agent's initial facing direction.\n\n  # Apply an immediate constraint: if no steps are allowed, no collection is possible.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # --- 2. Define Impassable Regions for Agent Movement ---\n  # This set identifies entity indices that represent terrain or objects the agent cannot traverse.\n  # Start by assuming all non-grabbable items block movement.\n  impassable_for_movement = set(current_state.world.non_grabbable_indices)\n  \n  # Refinement: Workshops are typically non-grabbable but traversable (e.g., crafting tables).\n  # Remove workshop indices from the set of impassable entities.\n  impassable_for_movement.difference_update(current_state.world.workshop_indices)\n\n  # Explicitly add water (if it exists and is defined in the world) to the impassable set,\n  # as water is commonly a movement barrier.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  # The 'stone' entity is explicitly listed in CraftWorld, and might also be considered impassable.\n  # This is an optional addition based on common game logic, if stone implies a solid wall.\n  # For now, we rely on `non_grabbable_indices` and specific exclusions/inclusions.\n  # if current_state.world.stone_index in current_state.world.kinds:\n  #     impassable_for_movement.add(current_state.world.stone_index)\n\n  # --- 3. Define Movement Actions and Their Effects ---\n  # This dictionary maps each DMLab action ID (e.g., ACTION_UP) to a tuple representing\n  # the resulting agent state: (new_internal_direction, change_in_Y, change_in_X).\n  movement_actions_map = {\n      ACTION_UP:    (INTERNAL_DIR_UP,    -1, 0), # Move North, face North\n      ACTION_RIGHT: (INTERNAL_DIR_RIGHT, 0,  1), # Move East, face East\n      ACTION_DOWN:  (INTERNAL_DIR_DOWN,  1,  0), # Move South, face South\n      ACTION_LEFT:  (INTERNAL_DIR_LEFT,  0, -1)  # Move West, face West\n  }\n\n  # --- 4. Breadth-First Search (BFS) for the Shortest Collection Path ---\n  # The BFS queue stores tuples representing a state:\n  # (current_y, current_x, current_internal_direction, list_of_actions_to_reach_this_state).\n  q = collections.deque()\n  q.append((start_y, start_x, start_dir, []))\n\n  # The 'visited' set keeps track of (y, x, direction) states already explored.\n  # This prevents redundant searches and infinite loops in cyclic environments.\n  # Crucially, 'direction' is included because the 'ACTION_USE' outcome depends on it.\n  visited = {(start_y, start_x, start_dir)} \n\n  path_to_execute = None # This variable will store the optimal action sequence if found.\n\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # First, check if the primitive can be collected from the current (position, direction).\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Ensure the cell the agent is facing is within the grid boundaries.\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width):\n          # Check if the desired primitive exists in the cell the agent is currently facing.\n          if full_grid[facing_y, facing_x, primitive] > 0:\n              candidate_path = path + [ACTION_USE] # Append the final 'USE' action.\n              \n              # If this path length is within the maximum allowed steps, it's a valid solution.\n              # BFS guarantees that the first path found is the shortest.\n              if len(candidate_path) <= MAX_COLLECT_STEPS:\n                  path_to_execute = candidate_path\n                  break # Optimal path found, terminate the BFS loop.\n\n      # Explore neighboring states by applying all possible movement actions.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          \n          # Prune the search early if adding another step would exceed the maximum path length.\n          if len(path) + 1 > MAX_COLLECT_STEPS:\n              continue\n\n          # Check if the proposed next agent position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable (does not contain impassable entities).\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n          \n          # Check if this specific (position, direction) state has already been visited.\n          # This is essential to prevent redundant computations and avoid getting stuck in loops.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # If the state is valid and unvisited, add it to the queue and mark it as visited.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n    \n  # --- 5. Execute the Found Path in the Environment ---\n  if path_to_execute is None:\n      # If the BFS did not find any path within MAX_COLLECT_STEPS leading to the primitive,\n      # return an empty list indicating failure to collect.\n      return [] \n\n  for action in path_to_execute:\n      actions_taken.append(action) # Record the action that is being taken.\n      \n      # Step the environment with the current action. This advances the simulation.\n      reward, done, _ = env.step(action)\n      # It is critical to update the reference to the internal CraftState after each step,\n      # as the environment's state (grid, inventory, pos, dir) might have changed.\n      current_state = env._current_state \n\n      # After each action, check if the primitive has been collected (inventory count > 0).\n      if current_state.inventory[primitive] > 0:\n          # If the primitive is collected, the goal is achieved. Return the actions taken so far.\n          return actions_taken \n      \n      # If the episode terminates prematurely (e.g., internal `max_steps` reached in CraftLab)\n      # and the primitive has NOT been collected, then this path has failed.\n      if done:\n          if current_state.inventory[primitive] <= 0:\n              return [] # Goal not met upon episode termination; path considered failed.\n\n  # Final verification: After executing all actions in the `path_to_execute`, confirm collection.\n  # This handles scenarios where the collection might happen exactly on the very last action of the path.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # This case implies that the BFS identified a path that *should* lead to collection,\n      # but in practice, it didn't. This might indicate an unhandled environmental non-determinism,\n      # an issue with the assumptions about the 'USE' action, or an unexpected change in the grid\n      # state not captured by the initial `full_grid` snapshot.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T03:18:20.143582", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  # Define action constants explicitly, as they are used internally and\n  # are common in CraftWorld environments.\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent facing directions (consistent with CraftState.dir mapping)\n  DIR_NORTH = 0 # Agent facing UP\n  DIR_EAST = 1  # Agent facing RIGHT\n  DIR_SOUTH = 2 # Agent facing DOWN\n  DIR_WEST = 3  # Agent facing LEFT\n\n  # Maximum total actions allowed for collection, including movements and the final USE.\n  # This prevents excessively long search times and limits the total length\n  # of the generated action sequence.\n  MAX_COLLECT_STEPS = 100 \n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"Returns the coordinates (y, x) of the cell directly in front of the agent.\"\"\"\n      if direction == DIR_NORTH:\n          return y - 1, x\n      elif direction == DIR_EAST:\n          return y, x + 1\n      elif direction == DIR_SOUTH:\n          return y + 1, x\n      elif direction == DIR_WEST:\n          return y, x - 1\n      return y, x # Fallback, though should not be reached with valid directions\n\n  actions_taken = []\n  \n  # Access the underlying CraftState instance directly to get the current state information.\n  # This allows `collect_v2` to be called mid-episode without resetting the environment,\n  # supporting composition of actions.\n  current_state = env._current_state \n\n  # --- Initial validation and early exit conditions ---\n  \n  # 1. Check if the `primitive` ID is recognized by the world's cookbook.\n  # If the primitive is not a valid kind in the world, it cannot be collected.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # 2. Check if the `primitive` is already in the agent's inventory.\n  # If already collected, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n  \n  # 3. If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # --- Retrieve necessary environment information for pathfinding ---\n  full_grid = current_state.grid # Use the actual current grid state\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir\n\n  # Determine if the primitive is a \"grabbable\" item (picked up by moving onto its cell and using USE)\n  # or a \"non-grabbable\" item (interacted with from an adjacent cell by facing it and using USE).\n  is_primitive_grabbable = primitive in current_state.world.grabbable_indices\n\n  # Define which entity kinds are impassable for agent movement.\n  # Start with all non-grabbable entities.\n  impassable_for_movement = set(current_state.world.non_grabbable_indices)\n  \n  # Workshops are typically non-grabbable but traversable for movement.\n  impassable_for_movement.difference_update(current_state.world.workshop_indices)\n  \n  # Water is typically an impassable entity for movement.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n\n  # Convert the set of impassable kinds to a list for efficient NumPy indexing.\n  impassable_kinds_list = list(impassable_for_movement)\n  \n  # Map movement actions to their (resulting_direction, dy, dx) changes.\n  # This is crucial for BFS to track agent orientation after a move.\n  movement_actions_map = {\n      ACTION_UP:    (DIR_NORTH, -1, 0), # Move North (y-1), agent faces North (dir=0)\n      ACTION_RIGHT: (DIR_EAST,  0, 1),  # Move East (x+1), agent faces East (dir=1)\n      ACTION_DOWN:  (DIR_SOUTH, 1, 0),  # Move South (y+1), agent faces South (dir=2)\n      ACTION_LEFT:  (DIR_WEST,  0, -1)  # Move West (x-1), agent faces West (dir=3)\n  }\n\n  bfs_queue = collections.deque()\n  # BFS state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  bfs_queue.append((start_y, start_x, start_dir, []))\n  \n  # Visited set: Tracks (y, x, dir) states to prevent cycles and redundant exploration.\n  visited_states = {(start_y, start_x, start_dir)} \n\n  path_to_execute = None # This will store the full sequence of actions (moves + final USE).\n\n  # --- Breadth-First Search to find the shortest path to collect the primitive ---\n  while bfs_queue:\n      curr_y, curr_x, curr_dir, current_path_actions = bfs_queue.popleft()\n\n      # Pruning: If the current path (movement actions only) is already\n      # strictly greater than MAX_COLLECT_STEPS, it cannot lead to a valid solution.\n      if len(current_path_actions) > MAX_COLLECT_STEPS:\n          continue\n\n      # --- Goal Check: Determine if the primitive can be collected from the current state (position and direction) ---\n      can_collect_now = False\n      if is_primitive_grabbable:\n          # For grabbable items, ACTION_USE collects them from the same cell, regardless of facing direction.\n          if full_grid[curr_y, curr_x, primitive] > 0:\n              can_collect_now = True\n      else:\n          # For non-grabbable items, ACTION_USE interacts with the object in the cell directly in front.\n          facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n          # Check if the facing cell is within grid boundaries and contains the target primitive.\n          if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n              full_grid[facing_y, facing_x, primitive] > 0):\n              can_collect_now = True\n      \n      if can_collect_now:\n          candidate_path = current_path_actions + [ACTION_USE]\n          # Ensure the total path length (including the USE action) does not exceed the limit.\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              break # Found the shortest path, exit BFS.\n\n      # --- Explore neighboring cells via movement actions ---\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          \n          # Pruning: If adding this movement action would result in a path length\n          # that *already equals or exceeds* the MAX_COLLECT_STEPS, it means there's\n          # no room left for the final ACTION_USE (which would make it MAX_COLLECT_STEPS + 1).\n          # This makes the search more efficient by stopping paths earlier.\n          if len(current_path_actions) + 1 >= MAX_COLLECT_STEPS: \n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable (does not contain impassable entities).\n          # If impassable_kinds_list is empty, np.any will operate on an empty array, returning False (no impassable items found).\n          if impassable_kinds_list and np.any(full_grid[next_y, next_x, impassable_kinds_list] > 0):\n              continue\n\n          # Check if this new (position, direction) state has already been visited\n          # to prevent redundant exploration and infinite loops.\n          if (next_y, next_x, next_dir) in visited_states:\n              continue\n\n          # If all checks pass, add the new state to the queue for further exploration.\n          visited_states.add((next_y, next_x, next_dir))\n          bfs_queue.append((next_y, next_x, next_dir, current_path_actions + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      # If no valid path was found within the step limit, return an empty list.\n      return []\n\n  for action in path_to_execute:\n      # Before executing an action, check if the environment's internal step counter\n      # has reached its maximum steps, which would terminate the episode.\n      if env.steps >= env.max_steps:\n          break # Cannot perform more actions, path terminated prematurely.\n\n      actions_taken.append(action)\n      \n      # Perform the action in the environment. We only care about the resulting state.\n      _, done, _ = env.step(action)\n      \n      # Update the internal state reference to reflect the current environment after the step.\n      current_state = env._current_state\n\n      # If the primitive is successfully collected at any point (e.g., immediate pickup or during USE),\n      # we can stop early and return the actions taken so far.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n      # If the episode terminates (`done` is True) but the primitive was NOT collected,\n      # it implies failure. In this case, the current partial path is invalid.\n      if done and current_state.inventory[primitive] <= 0:\n          return []\n\n  # Final verification: After executing all actions in the `path_to_execute`,\n  # confirm that the primitive was indeed collected into the inventory.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it indicates an unhandled environmental factor (e.g., tool requirement, resource depletion).\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T03:18:21.137587", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  # Define action constants explicitly, as they are used internally and\n  # are common in CraftWorld environments.\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent facing directions (consistent with CraftState.dir mapping)\n  DIR_NORTH = 0 # Agent facing UP\n  DIR_EAST = 1  # Agent facing RIGHT\n  DIR_SOUTH = 2 # Agent facing DOWN\n  DIR_WEST = 3  # Agent facing LEFT\n\n  # Maximum total actions allowed for collection, including movements and the final USE.\n  # This prevents excessively long search times and protects against infinite loops\n  # in complex maps or during failed collection attempts.\n  MAX_COLLECT_STEPS = 100 \n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates (y, x) of the cell directly in front of the agent,\n      based on the agent's current position and facing direction.\n\n      Args:\n          y (int): Agent's current row coordinate.\n          x (int): Agent's current column coordinate.\n          direction (int): Agent's current facing direction (DIR_NORTH, DIR_EAST, etc.).\n\n      Returns:\n          tuple[int, int]: (row, column) coordinates of the cell in front.\n      \"\"\"\n      if direction == DIR_NORTH:\n          return y - 1, x\n      elif direction == DIR_EAST:\n          return y, x + 1\n      elif direction == DIR_SOUTH:\n          return y + 1, x\n      elif direction == DIR_WEST:\n          return y, x - 1\n      return y, x # Should not be reached with valid directions\n\n  actions_taken = []\n  \n  # Access the underlying CraftState instance directly to get the current state information.\n  # This allows `collect_v2` to be called mid-episode without resetting the environment,\n  # supporting composition of actions and maintaining the current episode's state.\n  current_state = env._current_state \n\n  # --- Initial validation and early exit conditions ---\n  \n  # 1. Check if the `primitive` ID is recognized by the world's cookbook.\n  # If the primitive is not a valid kind in the world, it cannot be collected.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # 2. Check if the `primitive` is already in the agent's inventory.\n  # If already collected, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n  \n  # 3. If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  # This ensures the BFS loop condition works correctly for MAX_COLLECT_STEPS = 0.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # --- Retrieve necessary environment information for pathfinding ---\n  # Use features_global from features_dict to get a copy of the full grid.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir \n\n  # Determine if the primitive is a \"grabbable\" item (picked up by moving onto its cell)\n  # or a \"non-grabbable\" item (interacted with from an adjacent cell).\n  is_primitive_grabbable = primitive in current_state.world.grabbable_indices\n\n  # Define which entity kinds are impassable for agent movement.\n  # Start with all non-grabbable entities.\n  impassable_for_movement = set(current_state.world.non_grabbable_indices)\n  \n  # Workshops are typically non-grabbable but traversable for movement.\n  impassable_for_movement.difference_update(current_state.world.workshop_indices)\n  \n  # Water is typically an impassable entity for movement.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n\n  # Convert the set of impassable kinds to a list for efficient NumPy indexing.\n  impassable_kinds_list = list(impassable_for_movement)\n  \n  # Map movement actions to their (resulting_direction, dy, dx) changes.\n  # This is crucial for BFS to track agent orientation after a move.\n  movement_actions_map = {\n      ACTION_UP:    (DIR_NORTH, -1, 0), # Move North (y-1), agent faces North (dir=0)\n      ACTION_RIGHT: (DIR_EAST,  0, 1),  # Move East (x+1), agent faces East (dir=1)\n      ACTION_DOWN:  (DIR_SOUTH, 1, 0),  # Move South (y+1), agent faces South (dir=2)\n      ACTION_LEFT:  (DIR_WEST,  0, -1)  # Move West (x-1), agent faces West (dir=3)\n  }\n\n  # Initialize Breadth-First Search (BFS) queue.\n  # Each state in the queue is a tuple: (current_y, current_x, current_direction, path_of_actions_so_far).\n  q = collections.deque()\n  q.append((start_y, start_x, start_dir, []))\n  \n  # Keep track of visited states (position + orientation) to prevent redundant exploration and infinite loops.\n  visited = {(start_y, start_x, start_dir)} \n\n  path_to_execute = None  # This variable will store the final sequence of actions if a valid path is found.\n\n  # --- BFS to find the shortest action sequence to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Pruning: If the current path of movement actions is already too long to append the final ACTION_USE,\n      # or if it hits the total step limit, discard it.\n      # `len(path)` here refers to movement actions ONLY.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # --- Goal Check: Determine if the primitive can be collected from the current state (position and direction) ---\n      can_collect_now = False\n      \n      if is_primitive_grabbable:\n          # For grabbable items, the agent collects them by being on the same cell and using USE.\n          # Agent's facing direction is irrelevant for picking up grabbables on the current tile.\n          if full_grid[curr_y, curr_x, primitive] > 0:\n              can_collect_now = True\n      else:\n          # For non-grabbable items, the agent must be adjacent to and facing the item.\n          facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n          \n          # Ensure the facing coordinates are within grid boundaries and contain the primitive.\n          if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n              full_grid[facing_y, facing_x, primitive] > 0):\n              can_collect_now = True\n      \n      if can_collect_now:\n          # If the current path (movement actions) allows for the final ACTION_USE\n          # without exceeding the total MAX_COLLECT_STEPS budget.\n          if len(path) < MAX_COLLECT_STEPS: # Ensure there's room for ACTION_USE\n              path_to_execute = path + [ACTION_USE]\n              break # Found the shortest path, exit BFS.\n\n      # --- Explore neighboring cells via movement actions ---\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Pruning: If adding this movement action would make the path already too long\n          # to even consider adding the final ACTION_USE, skip it.\n          # `len(path) + 1` is the length *after* this proposed move.\n          # If it's already equal to or greater than `MAX_COLLECT_STEPS`,\n          # then `path + [move_action] + [ACTION_USE]` would exceed `MAX_COLLECT_STEPS`.\n          if len(path) + 1 >= MAX_COLLECT_STEPS:\n              continue\n\n          # Check if the proposed next agent position is within grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable (does not contain impassable entities).\n          is_traversable = True\n          # Only perform numpy check if there are actual impassable kinds defined.\n          if impassable_kinds_list: \n              if np.any(full_grid[next_y, next_x, impassable_kinds_list] > 0):\n                  is_traversable = False\n          \n          if not is_traversable:\n              continue\n          \n          # Check if this new (position, direction) state has already been visited\n          # to prevent redundant exploration and infinite loops.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # If all checks pass, add the new state to the queue for further exploration.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n  \n  # --- Execute the found path in the environment (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      # If no valid path was found within the step limit and constraints, return an empty list.\n      return []\n\n  for action in path_to_execute:\n      # Before executing an action, check if the environment's internal step counter\n      # has reached its maximum, which would terminate the episode.\n      if env.steps >= env.max_steps: \n          break # Cannot perform more actions, path terminated prematurely.\n\n      actions_taken.append(action)\n      \n      # Execute the action in the environment.\n      _, done, _ = env.step(action) \n      current_state = env._current_state # Update internal state reference after the step.\n\n      # If the primitive is now in the inventory, we have successfully collected it.\n      # Return the sequence of actions taken so far.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n      \n      # If the environment becomes 'done' for any reason (e.g., reaching a terminal state\n      # or a specific failure condition) and the goal isn't met, the collection failed.\n      if done: \n          return [] \n  \n  # Final verification: After executing all actions in the `path_to_execute`,\n  # confirm that the primitive was indeed collected into the inventory.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken # Successfully collected.\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it indicates an unhandled environmental factor (e.g., tool requirement, resource depletion),\n      # or the final USE action failed silently.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T03:19:57.570103", "function_name": "collect", "function_body": "    actions_taken = []\n    \n    # Get initial observations and action mappings\n    obs = env.observations()\n    action_specs = env.action_specs()\n    \n    ACTION_DOWN = action_specs['DOWN']\n    ACTION_UP = action_specs['UP']\n    ACTION_LEFT = action_specs['LEFT']\n    ACTION_RIGHT = action_specs['RIGHT']\n    ACTION_USE = action_specs['USE']\n\n    # Map (dy, dx) to action, assuming grid[y, x] and pos is (x, y)\n    # If agent_pos = (ax, ay) and next_pos = (nx, ny)\n    # dx = nx - ax, dy = ny - ay\n    action_mapping_dydx = {\n        (-1, 0): ACTION_UP,    # dy=-1 (up), dx=0\n        (1, 0): ACTION_DOWN,   # dy=1 (down), dx=0\n        (0, -1): ACTION_LEFT,  # dy=0, dx=-1 (left)\n        (0, 1): ACTION_RIGHT,  # dy=0, dx=1 (right)\n    }\n\n    # Check if primitive is already collected\n    initial_inventory = obs['features_dict']['inventory']\n    if initial_inventory[primitive] > 0:\n        return actions_taken # Already collected\n\n    # Get grid information\n    grid = obs['features_dict']['features_global']\n    grid_height, grid_width, _ = grid.shape\n\n    # Find the agent's current position (converted from normalized)\n    agent_pos_norm = obs['features_dict']['pos']\n    # Rounding is important for consistency with integer grid coordinates.\n    agent_x = int(round(agent_pos_norm[0] * (grid_width - 1)))\n    agent_y = int(round(agent_pos_norm[1] * (grid_height - 1)))\n    current_agent_coords = (agent_y, agent_x) # (row, col)\n\n    # Find coordinates of the primitive on the grid\n    # np.argwhere returns (row, col) tuples\n    primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n    if len(primitive_locations) == 0:\n        # Primitive not found anywhere on the map.\n        # This implies it's not spawnable or already collected (checked above).\n        # Return empty path, indicating it cannot be collected.\n        return []\n\n    # Identify all potential \"use_from\" locations (cells adjacent to any primitive instance)\n    # and mark them as BFS targets.\n    use_from_targets = set()\n    \n    # Neighbor offsets for 4-directional movement around a point (dy, dx)\n    neighbor_offsets_4d = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n\n    for py, px in primitive_locations:\n        for dy, dx in neighbor_offsets_4d:\n            ny, nx = py + dy, px + dx\n            # Check if the potential use_from cell is within grid bounds\n            if 0 <= ny < grid_height and 0 <= nx < grid_width:\n                # Add it to the set of target cells for BFS\n                use_from_targets.add((ny, nx))\n    \n    # Check if agent is already at a valid \"use_from\" position or on the primitive itself\n    # If agent is on primitive, try USE. If it fails, treat it like it needs to move next to it.\n    is_on_primitive = False\n    for py, px in primitive_locations:\n        if current_agent_coords == (py, px):\n            is_on_primitive = True\n            break\n            \n    if is_on_primitive or current_agent_coords in use_from_targets:\n        # Agent is in position to USE (either on top or adjacent).\n        reward, done, next_obs = env.step(ACTION_USE)\n        actions_taken.append(ACTION_USE)\n        if next_obs['features_dict']['inventory'][primitive] > 0:\n            return actions_taken\n        # If USE failed while on or adjacent, it might mean the item is gone or not grabbable.\n        # For a simple collect function, we'll return actions taken so far.\n        return actions_taken \n\n    # BFS Setup for finding path to any 'use_from' target\n    queue = collections.deque([(current_agent_coords, [])]) # (current_coords (y,x), path_of_actions)\n    visited = {current_agent_coords}\n\n    path_to_use_from = None\n\n    while queue:\n        (cy, cx), current_path = queue.popleft()\n\n        # If the current cell is one of the use_from targets, we found a path\n        if (cy, cx) in use_from_targets:\n            path_to_use_from = current_path\n            break \n\n        for dy, dx in neighbor_offsets_4d:\n            ny, nx = cy + dy, cx + dx\n            \n            # Check bounds and if already visited\n            if not (0 <= ny < grid_height and 0 <= nx < grid_width) or (ny, nx) in visited:\n                continue\n            \n            # Calculate action to get from (cy, cx) to (ny, nx)\n            action_to_take = action_mapping_dydx.get((dy, dx))\n            if action_to_take is None: # This should not happen with valid offsets\n                continue\n\n            new_path = current_path + [action_to_take]\n            \n            visited.add((ny, nx))\n            queue.append(((ny, nx), new_path))\n    \n    if path_to_use_from:\n        # Execute the movement actions\n        for action in path_to_use_from:\n            reward, done, obs = env.step(action)\n            actions_taken.append(action)\n            # Re-check inventory in case it was picked up accidentally or early\n            if obs['features_dict']['inventory'][primitive] > 0:\n                return actions_taken\n\n        # After movements, agent should be at a 'use_from' position. Perform USE.\n        reward, done, obs = env.step(ACTION_USE)\n        actions_taken.append(ACTION_USE)\n        if obs['features_dict']['inventory'][primitive] > 0:\n            return actions_taken\n        else:\n            # If USE failed after path, something went wrong (e.g., item despawned).\n            # Return the actions taken anyway, as the function signature requires a list of int.\n            return actions_taken\n    else:\n        # No path found to any 'use_from' cell.\n        # This can happen if all primitive instances are unreachable (e.g., walled off).\n        return actions_taken", "island_id": 1, "scores": {"3": -1}}
