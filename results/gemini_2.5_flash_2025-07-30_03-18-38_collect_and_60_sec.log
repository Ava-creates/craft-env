{"timestamp": "2025-07-30T23:34:00.117354", "function_name": "collect", "function_body": "  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Constants for internal direction mapping (consistent with common Craft env patterns)\n  # These are based on the typical DMLab-style agent directions.\n  _DIR_UP = 0\n  _DIR_RIGHT = 1\n  _DIR_DOWN = 2\n  _DIR_LEFT = 3\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  # Check if the primitive is already in inventory. If so, nothing needs to be collected.\n  # The inventory is a numpy array of length n_kinds, where values are counts.\n  current_inventory = features_dict['inventory']\n  if current_inventory[primitive] > 0:\n    return []\n\n  # Check if the primitive is grabbable. If not, it cannot be collected using this method.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  current_grid = features_dict['features_global'] # Full allocentric grid copy\n  \n  # Get grid dimensions\n  WIDTH, HEIGHT, _ = current_grid.shape \n\n  # Denormalize current agent position from normalized [0,1] range to grid coordinates\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Get current agent direction from the underlying CraftState.\n  # This attribute is directly available in CraftState.\n  initial_dir = env._current_state.dir \n\n  # Mapping from internal direction constants to (dx, dy) deltas relative to agent's position\n  # (dx, dy) represents (change in x, change in y) when facing that direction.\n  DIR_TO_DELTA = {\n      _DIR_UP:    (0, -1),  # Facing North: x stays, y decreases\n      _DIR_RIGHT: (1, 0),   # Facing East: x increases, y stays\n      _DIR_DOWN:  (0, 1),   # Facing South: x stays, y increases\n      _DIR_LEFT:  (-1, 0)   # Facing West: x decreases, y stays\n  }\n  \n  # Mapping from action ID to ((delta_x, delta_y), new_direction_after_move) for movement actions.\n  # This assumes moving in a cardinal direction also sets the agent's facing direction.\n  ACTION_MOVE_DATA = {\n      _UP:    ((0, -1), _DIR_UP),    # Move North, face North\n      _DOWN:  ((0, 1),  _DIR_DOWN),  # Move South, face South\n      _LEFT:  ((-1, 0), _DIR_LEFT),  # Move West, face West\n      _RIGHT: ((1, 0),  _DIR_RIGHT)  # Move East, face East\n  }\n\n  # Define indices for terrain that cannot be moved through (walls, deep water, etc.)\n  # These are typically non-grabbable entities that block movement.\n  # stone_index and water_index are common impassable terrain types in CraftWorld.\n  impassable_movement_terrain_indices = {env.world.water_index, env.world.stone_index}\n\n  def is_obstacle(x, y, grid, impassable_kinds_set, width, height):\n    \"\"\"\n    Checks if the cell (x,y) is out of bounds or contains any truly impassable item for movement.\n    A cell is an obstacle if it's outside the grid boundaries, or if it contains an item\n    from the `impassable_kinds_set`.\n    \"\"\"\n    if not (0 <= x < width and 0 <= y < height):\n      return True # Out of bounds is an obstacle for movement\n    for k in impassable_kinds_set:\n      if grid[x, y, k] == 1: \n        return True # Contains an impassable kind\n    return False\n\n  # Initialize BFS Queue: (current_x, current_y, current_direction, [path_actions_to_reach_here])\n  # The state includes position and direction because the 'USE' action is directional.\n  q = collections.deque()\n  q.append((current_pos[0], current_pos[1], initial_dir, [])) \n  \n  # Set to store visited states to avoid cycles and redundant paths: {(x, y, direction)}\n  # Visiting the same (position, direction) state via a longer path is redundant.\n  visited = {(current_pos[0], current_pos[1], initial_dir)} \n\n  target_found_path = None # To store the shortest path once found\n\n  while q:\n    cx, cy, c_dir, current_path = q.popleft()\n\n    # --- Goal Check: Is the cell directly in front of the agent the primitive? ---\n    # Calculate the coordinates of the cell directly in front of the agent based on current direction\n    fdx, fdy = DIR_TO_DELTA[c_dir]\n    fx, fy = cx + fdx, cy + fdy # Coordinates of the cell in front\n\n    # Check if this front cell is within bounds and contains the target primitive.\n    # An out-of-bounds `fx, fy` cannot contain the primitive, so we combine the checks.\n    if (0 <= fx < WIDTH and 0 <= fy < HEIGHT) and current_grid[fx, fy, primitive] == 1:\n      # Found a valid position and facing direction from which to 'USE' on the primitive.\n      target_found_path = current_path + [_USE]\n      break # Exit BFS as the shortest path to the goal has been found\n\n    # Explore all possible movement actions from the current state (cx, cy, c_dir)\n    for action, ((dx, dy), new_dir) in ACTION_MOVE_DATA.items():\n      nx, ny = cx + dx, cy + dy # Calculate the new position after this movement action\n\n      # Check if moving to (nx, ny) is possible (i.e., not an obstacle or out of bounds).\n      if is_obstacle(nx, ny, current_grid, impassable_movement_terrain_indices, WIDTH, HEIGHT):\n        continue # Cannot move into an obstacle cell\n\n      # If this specific (new_position, new_direction) state has not been visited before\n      if (nx, ny, new_dir) not in visited:\n        new_path = current_path + [action] # Append the current action to the path\n        q.append((nx, ny, new_dir, new_path)) # Add the new state to the queue for exploration\n        visited.add((nx, ny, new_dir)) # Mark this state as visited\n\n  # Return the found path (which includes the final _USE action) or an empty list if no path was found.\n  if target_found_path is not None:\n    return target_found_path\n  else:\n    return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:34:01.094884", "function_name": "collect", "function_body": "  import collections # For deque for BFS\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Constants for internal direction mapping (consistent with common Craft env patterns)\n  _DIR_UP = 0\n  _DIR_RIGHT = 1\n  _DIR_DOWN = 2\n  _DIR_LEFT = 3\n\n  # Mapping from internal direction constants to (dx, dy) deltas\n  DIR_TO_DELTA = {\n      _DIR_UP:    (0, -1),\n      _DIR_RIGHT: (1, 0),\n      _DIR_DOWN:  (0, 1),\n      _DIR_LEFT:  (-1, 0)\n  }\n  \n  # Mapping from action ID to (delta_x, delta_y) for movement and the resulting new direction\n  ACTION_MOVE_DATA = {\n      _UP:    ((0, -1), _DIR_UP),\n      _DOWN:  ((0, 1),  _DIR_DOWN),\n      _LEFT:  ((-1, 0), _DIR_LEFT),\n      _RIGHT: ((1, 0),  _DIR_RIGHT)\n  }\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions\n  WIDTH, HEIGHT, N_KINDS = current_grid.shape \n\n  # Denormalize current agent position from normalized [0,1] range to grid coordinates\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Get current agent direction from the underlying CraftState\n  initial_dir = env._current_state.dir \n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Define indices for terrain that cannot be moved through.\n  # Using the world's `non_grabbable_indices` set is a robust way to define obstacles.\n  # This set typically includes things like water, stone, and workshops, which usually block movement.\n  impassable_movement_terrain_indices = set(env.world.non_grabbable_indices)\n  \n  def is_obstacle_for_movement(x, y, grid, impassable_kinds_set, width, height, n_kinds):\n    \"\"\"\n    Checks if the cell (x,y) is out of bounds or contains any item that prevents movement.\n    \"\"\"\n    if not (0 <= x < width and 0 <= y < height):\n      return True # Out of bounds is always an obstacle for movement\n\n    # Check if the cell contains any kind that is designated as impassable for movement.\n    # We iterate through all possible kinds in the grid cell.\n    for k_idx in range(n_kinds):\n        if grid[x, y, k_idx] == 1 and k_idx in impassable_kinds_set:\n            return True\n    return False\n\n  # Initialize BFS Queue: (current_x, current_y, current_direction, [path_actions_to_reach_here])\n  q = collections.deque()\n  q.append((current_pos[0], current_pos[1], initial_dir, [])) \n  \n  # Set to store visited states to avoid cycles and redundant paths: {(x, y, direction)}\n  visited = {(current_pos[0], current_pos[1], initial_dir)} \n\n  target_found_path = None\n\n  while q:\n    cx, cy, c_dir, current_path = q.popleft()\n\n    # --- Goal Check: Is the cell *in front* of the agent the primitive? ---\n    # Calculate the coordinates of the cell directly in front of the agent based on current direction\n    fdx, fdy = DIR_TO_DELTA[c_dir]\n    fx, fy = cx + fdx, cy + fdy\n\n    # Check if this front cell is within bounds and contains the primitive\n    if (0 <= fx < WIDTH and 0 <= fy < HEIGHT) and current_grid[fx, fy, primitive] == 1:\n      # Found a valid position and facing direction from which to 'USE' on the primitive\n      target_found_path = current_path + [_USE]\n      break # Exit BFS as the shortest path has been found\n\n    # Explore all possible movement actions from the current state\n    for action, ((dx, dy), new_dir) in ACTION_MOVE_DATA.items():\n      nx, ny = cx + dx, cy + dy # Calculate the new position after this action\n\n      # Check if the next cell is an obstacle or out of overall grid bounds for movement\n      if is_obstacle_for_movement(nx, ny, current_grid, impassable_movement_terrain_indices, WIDTH, HEIGHT, N_KINDS):\n        continue\n\n      # If this specific (position, direction) state has not been visited before\n      if (nx, ny, new_dir) not in visited:\n        new_path = current_path + [action] # Append the action to the path\n        q.append((nx, ny, new_dir, new_path)) # Add the new state to the queue\n        visited.add((nx, ny, new_dir)) # Mark this state as visited\n  \n  # Return the found path or an empty list if no path was found (primitive unreachable)\n  if target_found_path is not None:\n    return target_found_path\n  else:\n    return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T23:35:32.042811", "function_name": "collect", "function_body": "  # Define action constants. These are typically global or from an imported module,\n  # but are defined here to ensure the function is self-contained as per instructions.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTIONS_MOVE = [DOWN, UP, LEFT, RIGHT]\n\n  # Get the initial state from the CraftLab environment.\n  # The CraftLab instance (`env`) holds a reference to the current CraftState.\n  initial_state = env._current_state\n\n  # 1. Check if the primitive is already in the agent's inventory.\n  # If already collected, no actions are needed.\n  if initial_state.inventory[primitive] > 0:\n    return []\n\n  # 2. Check if the primitive is immediately adjacent and grabbable from the initial position.\n  # This provides an optimized path for direct collection.\n  # `env.world` is the CraftWorld instance, which contains `grabbable_indices`.\n  if initial_state.next_to(primitive) and primitive in env.world.grabbable_indices:\n    # Simulate the USE action from the current state to confirm it successfully collects the item.\n    # CraftState.step returns a tuple: (reward, new_state).\n    _, state_after_use = initial_state.step(USE)\n    if state_after_use.inventory[primitive] > 0:\n        return [USE]\n\n  # 3. Perform a Breadth-First Search (BFS) to find a sequence of actions.\n  # The queue stores tuples of (current_CraftState_object, list_of_actions_to_reach_this_state).\n  # Using a list as a queue with pop(0) is less efficient than collections.deque\n  # for large queues (O(N) for pop(0)), but avoids needing to import collections.\n  queue = [(initial_state, [])]\n  \n  # The visited set prevents revisiting states (position and direction) to avoid cycles and redundant exploration.\n  # For this specific collection task, (position, direction) is usually sufficient for visited states.\n  visited = set([(initial_state.pos, initial_state.dir)])\n\n  # BFS loop\n  while queue:\n    current_state, current_path = queue.pop(0) # Pop the first element (FIFO for BFS)\n\n    # After processing the current state (reached by `current_path`), check if the goal is met.\n    # The primitive might have been collected during a prior 'USE' action in the path,\n    # or if a movement action led to a cell where it's picked up implicitly (less common for \"collect\").\n    if current_state.inventory[primitive] > 0:\n      return current_path\n\n    # Check if the primitive is now adjacent and grabbable from the `current_state`.\n    # This check is important because a previous movement action might have brought the agent next to it.\n    if current_state.next_to(primitive) and primitive in env.world.grabbable_indices:\n        # Simulate the USE action from this `current_state`.\n        _, state_after_use = current_state.step(USE)\n        if state_after_use.inventory[primitive] > 0:\n            # If successfully collected, return the path leading to this state plus the USE action.\n            return current_path + [USE]\n\n    # Explore neighboring states by trying all possible movement actions.\n    for action in ACTIONS_MOVE:\n      # CraftState.step simulates the action and returns a *new* CraftState object.\n      # This is crucial for BFS, as it allows exploring parallel paths without modifying\n      # the state objects currently being processed in the queue.\n      _, next_state = current_state.step(action)\n      \n      # Define the state for the visited set check.\n      next_pos_dir = (next_state.pos, next_state.dir)\n\n      # If this next state (position and direction) has not been visited yet:\n      if next_pos_dir not in visited:\n        visited.add(next_pos_dir)\n        # Add the new state and its corresponding path to the queue for further exploration.\n        queue.append((next_state, current_path + [action]))\n\n  # If the BFS queue becomes empty and the primitive has not been collected,\n  # it means the primitive is unreachable or not present on the map.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:35:32.113150", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Actions from CraftLab.action_specs, defined inside the function scope\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Map movement actions to (dx, dy) coordinate changes\n    MOVE_DELTAS = {\n        UP: (0, -1),\n        DOWN: (0, 1),\n        LEFT: (-1, 0),\n        RIGHT: (1, 0),\n    }\n\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n\n    # Extract grid dimensions\n    grid_width, grid_height, _ = grid.shape\n\n    # Agent position is normalized (0.0 to 1.0), convert to integer grid coordinates (0 to W-1/H-1)\n    agent_x_norm, agent_y_norm = obs['features_dict']['pos']\n    agent_x = int(round(agent_x_norm * (grid_width - 1)))\n    agent_y = int(round(agent_y_norm * (grid_height - 1)))\n\n    # Check if the primitive is already in the inventory\n    current_inventory = obs['features_dict']['inventory']\n    if current_inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # Determine how to collect the primitive\n    is_grabbable = primitive in env.world.grabbable_indices\n    # Assume that if an item is not grabbable, and it's stone, it requires the USE action from an adjacent cell.\n    # Other non-grabbable items (like workshops or water) might be passable or collected differently,\n    # but for `collect` function, we focus on items like stone that need 'mining'.\n    requires_use_adjacent = (primitive == env.world.stone_index)\n\n    # Find all locations of the primitive on the grid\n    primitive_locations = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if grid[x, y, primitive] == 1.0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the grid\n\n    # BFS Initialization\n    # Queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n    q = collections.deque([((agent_x, agent_y), [])])\n    visited = {(agent_x, agent_y)} # Set of visited (x, y) coordinates\n\n    # Variable to store the final sequence of actions\n    found_path_actions = None\n\n    while q:\n        (curr_x, curr_y), path_so_far = q.popleft()\n\n        # Check if the current position satisfies the goal\n        if requires_use_adjacent:\n            # If the item requires 'USE' from an adjacent cell, check if any primitive location\n            # is directly adjacent (Manhattan distance 1) to the current agent position.\n            for px, py in primitive_locations:\n                if abs(curr_x - px) + abs(curr_y - py) == 1:\n                    found_path_actions = path_so_far + [USE] # Add the USE action\n                    return found_path_actions # Path found, return actions\n        else: # Grabbable item (or other items collected by moving onto their cell)\n            # If it's a grabbable item, the goal is to move onto its cell.\n            if (curr_x, curr_y) in primitive_locations:\n                found_path_actions = path_so_far\n                return found_path_actions # Path found, return actions\n\n        # Explore neighboring cells\n        for action, (dx, dy) in MOVE_DELTAS.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n\n            # Boundary check\n            if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n                continue\n\n            # Passability check for movement:\n            # Assume cells containing `stone_index` are impassable for direct movement.\n            # This covers typical CraftWorld obstacles. Workshops and water are generally assumed passable.\n            is_stone_at_next_cell = grid[next_x, next_y, env.world.stone_index] == 1.0\n            if is_stone_at_next_cell:\n                # If the next cell is stone, it's an obstacle for movement.\n                # Even if the goal is stone, we need to reach an *adjacent* cell, not move onto it.\n                continue\n\n            # If the cell has not been visited, add it to the queue\n            if (next_x, next_y) not in visited:\n                visited.add((next_x, next_y))\n                q.append(((next_x, next_y), path_so_far + [action]))\n\n    return [] # No path found to collect the primitive", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:36:40.502674", "function_name": "collect", "function_body": "  # Get current observations from the environment\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  # Extract relevant state information\n  grid = features_dict['features_global']  # Full allocentric grid (HEIGHT, WIDTH, N_KINDS)\n  current_pos = tuple(features_dict['pos'])  # Agent's current (y, x) position\n  inventory = features_dict['inventory']    # Agent's current inventory\n\n  # 1. Check if the primitive is already in the inventory\n  if inventory[primitive] > 0:\n    return []  # Already collected, no actions needed\n\n  # Get grid dimensions\n  GRID_HEIGHT, GRID_WIDTH, _ = grid.shape\n\n  # Get non-grabbable indices from the world configuration\n  # These represent obstacles that the agent cannot move onto.\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n\n  # Define movement actions and their corresponding (dy, dx) deltas\n  ACTION_UP = 1\n  ACTION_DOWN = 0\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  DELTAS = {\n      ACTION_UP: (-1, 0),    # Move North (decrease y)\n      ACTION_DOWN: (1, 0),   # Move South (increase y)\n      ACTION_LEFT: (0, -1),  # Move West (decrease x)\n      ACTION_RIGHT: (0, 1),  # Move East (increase x)\n  }\n\n  # 2. Find all locations on the grid where the primitive exists\n  primitive_locations = []\n  for y in range(GRID_HEIGHT):\n    for x in range(GRID_WIDTH):\n      if grid[y, x, primitive] > 0:\n        primitive_locations.append((y, x))\n\n  if not primitive_locations:\n    # Primitive not found anywhere on the map\n    return []\n\n  # 3. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a cell adjacent to any instance of the primitive.\n  # Queue stores tuples: (current_y, current_x, list_of_actions_to_reach_here)\n  queue = [(current_pos[0], current_pos[1], [])]\n  # Visited set stores (y, x) tuples to prevent revisiting cells\n  visited = {current_pos}\n\n  while queue:\n    y, x, path_actions = queue.pop(0)\n\n    # Check if the current cell (y, x) is adjacent to any primitive location\n    # If it is, this is a valid \"goal\" cell for movement.\n    for p_y, p_x in primitive_locations:\n      # Manhattan distance check for adjacency (up, down, left, right)\n      if abs(y - p_y) + abs(x - p_x) == 1:\n        # Found the shortest path to a cell adjacent to the primitive.\n        # Add the 'USE' action to the end of this path.\n        return path_actions + [ACTION_USE]\n\n    # Explore valid neighboring cells\n    for action, (dy, dx) in DELTAS.items():\n      next_y, next_x = y + dy, x + dx\n\n      # Check boundary conditions\n      if not (0 <= next_y < GRID_HEIGHT and 0 <= next_x < GRID_WIDTH):\n        continue\n\n      # Check if the cell has already been visited in this BFS\n      if (next_y, next_x) in visited:\n        continue\n\n      # Check for obstacles: if the cell contains any non-grabbable entity\n      is_obstacle = False\n      for kind_idx in non_grabbable_indices:\n        if grid[next_y, next_x, kind_idx] > 0:\n          is_obstacle = True\n          break\n      if is_obstacle:\n        continue\n\n      # If the cell is valid and unvisited, add it to the queue and mark as visited\n      visited.add((next_y, next_x))\n      queue.append((next_y, next_x, path_actions + [action]))\n\n  # If the BFS completes and no path is found (e.g., primitive is unreachable)\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:36:40.573446", "function_name": "collect", "function_body": "    import collections\n\n    # Action constants (assuming these are globally defined or known to the environment)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    state = env._current_state\n\n    # Check if the primitive is already in the inventory\n    if state.inventory[primitive] > 0:\n        return []\n\n    grid = state.grid\n    width, height, _ = grid.shape # grid shape is (WIDTH, HEIGHT, n_kinds)\n    agent_pos = state.pos\n    agent_dir = state.dir # 0:N, 1:E, 2:S, 3:W\n\n    # Find all locations of the primitive on the grid\n    primitive_locations = []\n    for r in range(width):\n        for c in range(height):\n            if grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the grid\n\n    # Find the closest primitive location using Manhattan distance\n    target_pos = None\n    min_dist = float('inf')\n    for loc in primitive_locations:\n        dist = abs(loc[0] - agent_pos[0]) + abs(loc[1] - agent_pos[1])\n        if dist < min_dist:\n            min_dist = dist\n            target_pos = loc\n\n    if target_pos is None: # Should not happen if primitive_locations is not empty\n        return []\n\n    # BFS to find a path to a cell adjacent to target_pos, where the agent faces target_pos\n    # Queue stores tuples: (current_position, current_direction, path_actions)\n    queue = collections.deque([(agent_pos, agent_dir, [])])\n    \n    # Visited set stores (position, direction) to avoid cycles and redundant paths\n    visited = {(agent_pos, agent_dir)}\n\n    # Possible movements: (delta_row, delta_col): (action, resulting_direction)\n    # The resulting_direction is the direction the agent faces after taking that move action.\n    moves_with_dir = {\n        (-1, 0): (UP, 0),    # Move North (row - 1): Action UP, Resulting Dir NORTH (0)\n        (1, 0): (DOWN, 2),   # Move South (row + 1): Action DOWN, Resulting Dir SOUTH (2)\n        (0, -1): (LEFT, 3),  # Move West (col - 1): Action LEFT, Resulting Dir WEST (3)\n        (0, 1): (RIGHT, 1)   # Move East (col + 1): Action RIGHT, Resulting Dir EAST (1)\n    }\n\n    found_path_actions = None\n\n    while queue:\n        current_pos, current_dir, path_actions = queue.popleft()\n\n        # Check if current_pos is adjacent to target_pos AND facing correctly\n        dr_to_target = target_pos[0] - current_pos[0]\n        dc_to_target = target_pos[1] - current_pos[1]\n\n        # Is agent adjacent to target_pos? Manhattan distance 1 means adjacent.\n        if abs(dr_to_target) + abs(dc_to_target) == 1:\n            desired_dir_to_face_target = -1\n            if dr_to_target == -1 and dc_to_target == 0: # Target is North of current_pos\n                desired_dir_to_face_target = 0 # Agent needs to face North\n            elif dr_to_target == 1 and dc_to_target == 0: # Target is South of current_pos\n                desired_dir_to_face_target = 2 # Agent needs to face South\n            elif dr_to_target == 0 and dc_to_target == 1: # Target is East of current_pos\n                desired_dir_to_face_target = 1 # Agent needs to face East\n            elif dr_to_target == 0 and dc_to_target == -1: # Target is West of current_pos\n                desired_dir_to_face_target = 3 # Agent needs to face West\n\n            if current_dir == desired_dir_to_face_target:\n                found_path_actions = path_actions\n                break # Found a path that ends at an adjacent cell, facing the primitive\n\n        # Explore neighbors\n        for (move_dr, move_dc), (action, resulting_dir) in moves_with_dir.items():\n            next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n            next_pos = (next_r, next_c)\n\n            # Check grid bounds\n            if not (0 <= next_r < width and 0 <= next_c < height):\n                continue\n\n            # Check if the next position is blocked by an ungrabbable obstacle\n            # An agent cannot move onto its target primitive to pick it up.\n            # It also cannot move onto other non-grabbable items.\n            is_obstacle = False\n            if next_pos == target_pos: # Cannot move onto the primitive itself\n                is_obstacle = True\n            else:\n                # Check for other non-grabbable items at next_pos\n                for k_idx in state.world.non_grabbable_indices:\n                    if grid[next_r, next_c, k_idx] > 0:\n                        is_obstacle = True\n                        break\n            if is_obstacle:\n                continue\n\n            next_state_tuple = (next_pos, resulting_dir)\n            if next_state_tuple not in visited:\n                visited.add(next_state_tuple)\n                queue.append((next_pos, resulting_dir, path_actions + [action]))\n\n    if found_path_actions is None:\n        return [] # No path found to be adjacent and facing correctly\n\n    # If a path is found, append the USE action\n    final_actions = list(found_path_actions)\n    final_actions.append(USE)\n    return final_actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:37:41.380819", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map movement vectors (dx, dy) to action IDs.\n  # These actions move the agent AND set its facing direction.\n  MOVE_VEC_TO_ACTION = {\n      (0, -1): UP,    # Move North, face North\n      (0, 1): DOWN,   # Move South, face South\n      (-1, 0): LEFT,  # Move West, face West\n      (1, 0): RIGHT   # Move East, face East\n  }\n\n  # Map agent's internal direction ID to its corresponding facing vector (dx, dy).\n  # 0: North (-Y)\n  # 1: East (+X)\n  # 2: South (+Y)\n  # 3: West (-X)\n  DIR_TO_VEC = {\n      0: (0, -1),  # North\n      1: (1, 0),   # East\n      2: (0, 1),   # South\n      3: (-1, 0)   # West\n  }\n\n  initial_obs = env.observations()\n  initial_grid = initial_obs['features_dict']['features_global']\n  initial_pos_tuple = tuple(initial_obs['features_dict']['pos'].astype(int))\n  # Agent's direction is a one-hot vector, convert to integer (0-3)\n  initial_dir = np.argmax(initial_obs['features_dict']['direction'])\n\n  # Grid dimensions: grid is (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = initial_grid.shape\n\n  # Get indices of non-grabbable items (obstacles) from the world\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a coordinate is within grid bounds\n  def is_valid_coord(x, y):\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  # Helper function to check if a cell is traversable.\n  # A cell is not traversable if it contains any non-grabbable entity.\n  def is_traversable(x, y, current_grid):\n      if not is_valid_coord(x, y):\n          return False\n      for idx in non_grabbable_indices:\n          if current_grid[x, y, idx] > 0:\n              return False # Contains an obstacle\n      return True # Traversable\n\n  # BFS search to find the shortest path to a position from which the primitive can be collected.\n  # The state in BFS is ((x, y), direction_int).\n  # We use parent_map to reconstruct the path later, avoiding large memory usage by not storing full paths in the queue.\n  queue = collections.deque([(initial_pos_tuple, initial_dir)])\n  # Visited set stores (position, direction) tuples to prevent cycles and redundant exploration.\n  visited = set([(initial_pos_tuple, initial_dir)])\n  # parent_map stores: (child_pos, child_dir) -> ((parent_pos, parent_dir), action_taken_to_reach_child)\n  parent_map = {}\n\n  target_reached_state = None # To store the state from which USE action can be applied\n\n  while queue:\n      (curr_x, curr_y), curr_dir_int = queue.popleft()\n      current_bfs_state = ((curr_x, curr_y), curr_dir_int)\n\n      # Check if the target primitive is directly in front of the current position and direction.\n      facing_vec = DIR_TO_VEC[curr_dir_int]\n      front_x, front_y = curr_x + facing_vec[0], curr_y + facing_vec[1]\n\n      if is_valid_coord(front_x, front_y) and initial_grid[front_x, front_y, primitive] > 0:\n          # Found the primitive in front, this is our target state.\n          target_reached_state = current_bfs_state\n          break # Found the shortest path, exit BFS\n\n      # Explore possible moves (UP, DOWN, LEFT, RIGHT).\n      # Each move action also changes the agent's direction to the direction of movement.\n      for move_vec, move_action in MOVE_VEC_TO_ACTION.items():\n          next_x, next_y = curr_x + move_vec[0], curr_y + move_vec[1]\n          next_dir_int = move_action # The new direction is set by the move action itself.\n          next_pos_tuple = (next_x, next_y)\n\n          # Check if the next cell is traversable.\n          if is_traversable(next_x, next_y, initial_grid):\n              next_bfs_state = (next_pos_tuple, next_dir_int)\n              if next_bfs_state not in visited:\n                  visited.add(next_bfs_state)\n                  # Store the parent and the action taken to reach this state\n                  parent_map[next_bfs_state] = (current_bfs_state, move_action)\n                  queue.append(next_bfs_state)\n\n  # If target_reached_state is found, reconstruct the path\n  if target_reached_state:\n      actions_path = [USE] # The last action is always USE\n      current_path_state = target_reached_state\n\n      # Backtrack from the target_reached_state to the initial_state\n      while current_path_state != (initial_pos_tuple, initial_dir):\n          # Get parent state and action from parent_map\n          parent_state, action_to_reach_curr = parent_map[current_path_state]\n          actions_path.append(action_to_reach_curr)\n          current_path_state = parent_state\n      \n      # The path was built in reverse, so reverse it back\n      return actions_path[::-1]\n\n  # If the queue becomes empty and no path was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T23:37:42.370523", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n  import heapq # For A* priority queue\n\n  # Action constants (from action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map movement vectors (dx, dy) to action IDs.\n  # These actions move the agent AND set its facing direction.\n  MOVE_VEC_TO_ACTION = {\n      (0, -1): UP,    # Move North, face North (Agent's new direction will be UP/North)\n      (0, 1): DOWN,   # Move South, face South (Agent's new direction will be DOWN/South)\n      (-1, 0): LEFT,  # Move West, face West (Agent's new direction will be LEFT/West)\n      (1, 0): RIGHT   # Move East, face East (Agent's new direction will be RIGHT/East)\n  }\n\n  # Map agent's internal direction ID to its corresponding facing vector (dx, dy).\n  # 0: North (-Y)\n  # 1: East (+X)\n  # 2: South (+Y)\n  # 3: West (-X)\n  DIR_TO_VEC = {\n      0: (0, -1),  # North\n      1: (1, 0),   # East\n      2: (0, 1),   # South\n      3: (-1, 0)   # West\n  }\n\n  initial_obs = env.observations()\n  initial_grid = initial_obs['features_dict']['features_global']\n  initial_pos_np = initial_obs['features_dict']['pos'].astype(int)\n  initial_pos = tuple(initial_pos_np)\n  # Agent's direction is a one-hot vector, convert to integer (0-3)\n  initial_dir = np.argmax(initial_obs['features_dict']['direction'])\n\n  grid_width, grid_height, _ = initial_grid.shape\n\n  # Get indices of non-grabbable items (obstacles) from the world\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a coordinate is within grid bounds\n  def is_valid_coord(x, y):\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  # Helper function to check if a cell is traversable.\n  # A cell is not traversable if it contains any non-grabbable entity.\n  def is_traversable(x, y, current_grid):\n      if not is_valid_coord(x, y):\n          return False\n      for idx in non_grabbable_indices:\n          if current_grid[x, y, idx] > 0:\n              return False # Contains an obstacle\n      return True # Traversable\n\n  # 1. Find all grid locations where the primitive item is present.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if initial_grid[x, y, primitive] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      return [] # The primitive item is not found anywhere on the map.\n\n  # 2. Determine all valid \"target agent states\" from which the primitive can be collected.\n  # A target agent state is a tuple ((agent_x, agent_y), agent_direction) such that\n  # if the agent is at (agent_x, agent_y) and facing agent_direction,\n  # the cell directly in front contains the primitive, and (agent_x, agent_y) is traversable.\n  target_agent_states = set()\n  for px, py in primitive_locations:\n      # Iterate through all possible agent directions (0=North, 1=East, 2=South, 3=West)\n      for agent_dir, (dx_facing, dy_facing) in DIR_TO_VEC.items():\n          # Calculate the required agent position (ax, ay) so that (px, py) is directly in front.\n          # (ax + dx_facing, ay + dy_facing) must equal (px, py)\n          ax, ay = px - dx_facing, py - dy_facing\n          \n          if is_valid_coord(ax, ay) and is_traversable(ax, ay, initial_grid):\n              target_agent_states.add(((ax, ay), agent_dir))\n\n  if not target_agent_states:\n      # This can happen if all primitive locations are surrounded by non-traversable cells,\n      # or if the initial_grid is somehow misconfigured.\n      return []\n\n  # Heuristic function for A* search: Manhattan distance to the closest target agent position.\n  # This is an admissible heuristic because each move action changes position by 1,\n  # and Manhattan distance is the minimum number of steps to reach a target without obstacles.\n  def heuristic(pos_x, pos_y):\n      min_dist = float('inf')\n      for (target_pos_x, target_pos_y), _ in target_agent_states:\n          min_dist = min(min_dist, abs(pos_x - target_pos_x) + abs(pos_y - target_pos_y))\n      return min_dist\n\n  # A* search algorithm to find the shortest path.\n  # State in A* is ((x, y), direction_int).\n  start_state = (initial_pos, initial_dir)\n\n  # Priority queue: (f_score, g_score, current_state, path_list)\n  # f_score = g_score + h_score (estimated total cost)\n  # g_score = actual cost from start_state to current_state\n  # path_list = list of actions taken to reach current_state\n  priority_queue = []\n  \n  # g_score_map stores the cheapest cost found so far to reach a given state.\n  g_score_map = {start_state: 0}\n  \n  # Push the initial state onto the priority queue.\n  initial_h = heuristic(initial_pos[0], initial_pos[1])\n  heapq.heappush(priority_queue, (initial_h, 0, start_state, []))\n\n  while priority_queue:\n      f_score, g_score, current_state, path_so_far = heapq.heappop(priority_queue)\n\n      current_pos, current_dir = current_state\n      curr_x, curr_y = current_pos\n\n      # If we've already found a shorter path to this state, skip it.\n      if g_score > g_score_map.get(current_state, float('inf')):\n          continue\n\n      # If the current state is one of our target agent states, we've found the shortest path.\n      # Append the USE action and return the complete sequence of actions.\n      if current_state in target_agent_states:\n          return path_so_far + [USE]\n\n      # Explore possible next states by applying movement actions.\n      for move_vec, move_action in MOVE_VEC_TO_ACTION.items():\n          next_x, next_y = curr_x + move_vec[0], curr_y + move_vec[1]\n          next_dir = move_action # The new direction is automatically set by the move action.\n\n          # Check if the next cell is traversable.\n          if is_traversable(next_x, next_y, initial_grid):\n              next_state = ((next_x, next_y), next_dir)\n              \n              # Cost for a movement action is 1.\n              new_g_score = g_score + 1 \n\n              # If this new path to next_state is shorter than any previously found path to it,\n              # update its g_score and add it to the priority queue.\n              if new_g_score < g_score_map.get(next_state, float('inf')):\n                  g_score_map[next_state] = new_g_score\n                  next_h_score = heuristic(next_x, next_y)\n                  next_f_score = new_g_score + next_h_score\n                  heapq.heappush(priority_queue, (next_f_score, new_g_score, next_state, path_so_far + [move_action]))\n\n  # If the priority queue becomes empty and no path to a target state was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:39:32.641866", "function_name": "collect", "function_body": "    actions = []\n    \n    # Use the current state of the environment's internal CraftState for simulation\n    current_state = env._current_state\n    \n    # Extract current grid, position, and inventory from the current_state object\n    grid = current_state.grid.copy() \n    pos = current_state.pos # (x, y) tuple of integers\n    direction = current_state.dir # 0=down, 1=up, 2=left, 3=right\n    inventory = current_state.inventory.copy()\n\n    # Get scenario and world from the current state (they are references)\n    scenario = current_state.scenario\n    world = current_state.world\n\n    # Define constants for actions and directions (assuming common DMLab-style mappings)\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    _DIR_DOWN = 0\n    _DIR_UP = 1\n    _DIR_LEFT = 2\n    _DIR_RIGHT = 3\n\n    # Check if we already have the primitive\n    if inventory[primitive] > 0:\n        return [] # Already collected\n\n    # --- Step 1: Find the target primitive's location ---\n    # Find all cells containing the primitive\n    primitive_locations = []\n    width, height, n_kinds = grid.shape\n    for x in range(width):\n        for y in range(height):\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return [] # No primitive found on the map\n\n    # Choose the closest primitive location using Manhattan distance\n    target_pos = None\n    min_dist = float('inf')\n    \n    for loc in primitive_locations:\n        dist = abs(loc[0] - pos[0]) + abs(loc[1] - pos[1])\n        if dist < min_dist:\n            min_dist = dist\n            target_pos = loc\n    \n    # Sanity check (should not happen if primitive_locations is not empty)\n    if target_pos is None:\n        return []\n\n    # --- Step 2: Pathfinding using BFS to reach an adjacent cell and face the target ---\n    # BFS state: (x, y, current_dir)\n    # Queue stores: ((x, y, dir), list_of_actions_to_reach_this_state)\n    q = collections.deque([((pos[0], pos[1], direction), [])])\n    visited = set([(pos[0], pos[1], direction)])\n\n    # Define possible moves (dx, dy) for each action\n    # _DOWN: move +y, _UP: move -y, _LEFT: move -x, _RIGHT: move +x\n    move_deltas = {\n        _DOWN: (0, 1),\n        _UP: (0, -1),\n        _LEFT: (-1, 0),\n        _RIGHT: (1, 0)\n    }\n    \n    # Define relative deltas for each direction for facing check\n    # Agent facing _DIR_DOWN means its \"front\" cell is at (current_x, current_y + 1)\n    dir_to_delta = {\n        _DIR_DOWN: (0, 1),\n        _DIR_UP: (0, -1),\n        _DIR_LEFT: (-1, 0),\n        _DIR_RIGHT: (1, 0)\n    }\n\n    path_found = False\n    best_path_actions = []\n\n    # Max search depth to prevent excessive computation for very large maps.\n    # A common heuristic is a multiple of the grid area.\n    MAX_SEARCH_STEPS = 2 * width * height \n    \n    while q:\n        (cx, cy, cdir), current_path_actions = q.popleft()\n\n        # Check for max path length to prevent infinite loops or very long searches\n        if len(current_path_actions) > MAX_SEARCH_STEPS:\n            continue\n\n        # Check if current position (cx, cy) with current direction (cdir) makes the agent face the target_pos\n        # The cell directly in front of the agent is (facing_x, facing_y)\n        fwd_dx, fwd_dy = dir_to_delta[cdir]\n        facing_x, facing_y = cx + fwd_dx, cy + fwd_dy\n\n        if (facing_x, facing_y) == target_pos:\n            best_path_actions = current_path_actions\n            path_found = True\n            break # Found a path that leads to facing the target\n\n        # Explore possible movement actions:\n        for action_val, (dx, dy) in move_deltas.items():\n            next_x, next_y = cx + dx, cy + dy\n            next_dir = action_val # The agent's new direction becomes the direction of the move taken\n\n            # Check boundaries: ensure the next position is within the grid\n            if not (0 <= next_x < width and 0 <= next_y < height):\n                continue\n            \n            # Cannot move into the target primitive's cell itself; we need to be adjacent to it for `USE`\n            if (next_x, next_y) == target_pos:\n                continue\n\n            # Check for obstacles at (next_x, next_y)\n            is_blocked = False\n            # Iterate through all kinds of entities that might be in the cell (next_x, next_y)\n            for k_idx in range(n_kinds):\n                # If there's an item of kind k_idx at (next_x, next_y)\n                if grid[next_x, next_y, k_idx] > 0:\n                    # And if this item is in the world's non-grabbable list (i.e., it's an impassable obstacle)\n                    # Note: primitive items themselves are grabbable, so they won't be in non_grabbable_indices.\n                    if k_idx in world.non_grabbable_indices:\n                        is_blocked = True\n                        break # Found an obstacle, this path is blocked\n            if is_blocked:\n                continue # Cannot move into this blocked cell\n\n            next_state_tuple = (next_x, next_y, next_dir)\n            if next_state_tuple not in visited:\n                visited.add(next_state_tuple)\n                q.append((next_state_tuple, current_path_actions + [action_val]))\n\n    if not path_found:\n        return [] # Cannot find a path to reach and face the primitive\n\n    # --- Step 3: Add the USE action ---\n    # If a path was found, add all movement actions, then the final USE action\n    actions.extend(best_path_actions)\n    actions.append(_USE) # Once positioned and facing, use the item\n\n    return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:39:33.662695", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action mappings - assuming these are accessible from env_factory\n  # If not directly available via 'action_mapping' dict, they might be constants\n  # in env_factory or a separate constants file.\n  # For robustness, we'll try to import and fallback to common defaults.\n  try:\n      from env_factory import action_mapping\n      DOWN = action_mapping['DOWN']\n      UP = action_mapping['UP']\n      LEFT = action_mapping['LEFT']\n      RIGHT = action_mapping['RIGHT']\n      USE = action_mapping['USE']\n  except (ImportError, KeyError):\n      # Fallback to common default values if env_factory.action_mapping is not found or structured differently\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  # Map action to (row_delta, col_delta)\n  ACTION_DELTAS = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1),\n  }\n\n  current_state = env._current_state\n\n  # Check if primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n      return []  # Already collected\n\n  grid = current_state.grid\n  current_pos = current_state.pos\n\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Find all locations on the grid where the primitive exists\n  # np.argwhere returns an array of coordinates, e.g., [[r1, c1], [r2, c2], ...]\n  primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n  if len(primitive_locations) == 0:\n      return []  # Primitive not found on the grid\n\n  # Define target interaction cells: any cell within 3x3 neighborhood of a primitive location.\n  # This assumes 'USE' works on any primitive in the 3x3 vicinity, based on the 'next_to' hint.\n  target_interact_cells = set()\n  for pr, pc in primitive_locations:\n      for dr_offset in range(-1, 2):  # -1, 0, 1 for row offset\n          for dc_offset in range(-1, 2):  # -1, 0, 1 for column offset\n              tr, tc = pr + dr_offset, pc + dc_offset\n              # Check boundary conditions for the interaction cell\n              if 0 <= tr < HEIGHT and 0 <= tc < WIDTH:\n                  target_interact_cells.add((tr, tc))\n\n  # BFS Initialization\n  queue = collections.deque()\n  # State in queue: (row, col, list_of_actions_to_reach_this_state)\n  queue.append((current_pos[0], current_pos[1], []))\n\n  visited = set()\n  visited.add(current_pos)  # Use (row, col) tuple for visited states\n\n  while queue:\n      r, c, actions = queue.popleft()\n\n      # If current position is a target interaction cell, we can use 'USE'\n      if (r, c) in target_interact_cells:\n          return actions + [USE]\n\n      # Explore possible next moves\n      for action_type, (dr, dc) in ACTION_DELTAS.items():\n          nr, nc = r + dr, c + dc\n\n          # Check boundary conditions for the next move\n          if 0 <= nr < HEIGHT and 0 <= nc < WIDTH:\n              # In CraftWorld, usually most cells are traversable.\n              # If there were \"wall\" or \"impassable\" kinds, they'd need to be checked here.\n              # For this general case, we assume all grid cells are walkable.\n              new_pos = (nr, nc)\n              if new_pos not in visited:\n                  visited.add(new_pos)\n                  queue.append((nr, nc, actions + [action_type]))\n\n  # If BFS completes without finding a path to a target cell\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:41:04.337277", "function_name": "collect", "function_body": "    import collections\n\n    # Define action constants based on CraftLab's action_specs.\n    # These would typically be global constants in a larger module.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    def _calculate_turn_actions(current_pos, current_dir, target_cell):\n        \"\"\"\n        Calculates the sequence of turn actions (LEFT/RIGHT) needed to face\n        a target adjacent cell from the current position and direction.\n        \"\"\"\n        target_relative_x = target_cell[0] - current_pos[0]\n        target_relative_y = target_cell[1] - current_pos[1]\n\n        # Determine the target direction (0:N/Up, 1:E/Right, 2:S/Down, 3:W/Left)\n        # Assuming Y increases downwards (typical for grid coordinates)\n        target_dir_val = -1\n        if target_relative_x == 1:\n            target_dir_val = 1  # Target is to the East (Right)\n        elif target_relative_x == -1:\n            target_dir_val = 3  # Target is to the West (Left)\n        elif target_relative_y == 1:\n            target_dir_val = 2  # Target is to the South (Down)\n        elif target_relative_y == -1:\n            target_dir_val = 0  # Target is to the North (Up)\n        \n        if target_dir_val == -1:\n            # This case should ideally not be reached if target_cell is truly adjacent\n            return []\n\n        turns = []\n        if current_dir == target_dir_val:\n            return []\n        else:\n            # Calculate shortest turn: (target_dir - current_dir + 4) % 4\n            # 0: no turn, 1: right, 2: 180 (right twice), 3: left\n            diff = (target_dir_val - current_dir + 4) % 4\n            if diff == 1:  # Turn Right\n                turns.append(ACTION_RIGHT)\n            elif diff == 2:  # Turn 180 degrees (Right twice)\n                turns.append(ACTION_RIGHT)\n                turns.append(ACTION_RIGHT)\n            elif diff == 3:  # Turn Left\n                turns.append(ACTION_LEFT)\n            return turns\n\n    state = env._current_state\n    \n    # If the primitive is already in inventory, no actions are needed.\n    if state.inventory[primitive] > 0:\n        return []\n\n    grid_width, grid_height = state.grid.shape[0], state.grid.shape[1]\n\n    # Find all locations where the primitive exists on the grid.\n    primitive_locations = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if state.grid[x, y, primitive] == 1:\n                primitive_locations.append((x, y))\n    \n    # If the primitive is not found anywhere on the map, it cannot be collected.\n    if not primitive_locations:\n        return []\n\n    # BFS (Breadth-First Search) for pathfinding\n    # Queue stores tuples: (current_position, current_direction, list_of_actions_taken)\n    queue = collections.deque([(state.pos, state.dir, [])])\n    \n    # Visited set to prevent cycles and redundant exploration.\n    # We only care about visited positions, not positions+directions for BFS here.\n    visited = {state.pos} \n\n    # Identify kinds that block movement (non-grabbable entities).\n    # The agent cannot move onto cells containing these items.\n    impassable_kinds = env.world.non_grabbable_indices\n\n    while queue:\n        current_pos, current_dir, path_actions = queue.popleft()\n\n        # Check if the current position is adjacent to any primitive location.\n        # If so, we have found a path to be next to the primitive.\n        target_primitive_cell = None\n        for px, py in primitive_locations:\n            # Check for adjacency using Manhattan distance (dist == 1)\n            if abs(current_pos[0] - px) + abs(current_pos[1] - py) == 1:\n                target_primitive_cell = (px, py)\n                break\n        \n        if target_primitive_cell:\n            # Found a path to an adjacent cell. Now, calculate turns to face it and USE.\n            turn_actions = _calculate_turn_actions(current_pos, current_dir, target_primitive_cell)\n            return path_actions + turn_actions + [ACTION_USE]\n\n        # Explore possible movement actions (UP, DOWN, LEFT, RIGHT)\n        for action_type in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n            next_x, next_y = current_pos[0], current_pos[1]\n            if action_type == ACTION_UP:\n                next_y -= 1\n            elif action_type == ACTION_DOWN:\n                next_y += 1\n            elif action_type == ACTION_LEFT:\n                next_x -= 1\n            elif action_type == ACTION_RIGHT:\n                next_x += 1\n            \n            next_pos = (next_x, next_y)\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n                continue\n\n            # Check if the next cell is passable (does not contain any impassable kinds)\n            is_passable = True\n            for k in impassable_kinds:\n                if state.grid[next_x, next_y, k] == 1:\n                    is_passable = False\n                    break\n            \n            if not is_passable:\n                continue\n            \n            # If the cell is passable and has not been visited, add it to the queue.\n            if next_pos not in visited:\n                visited.add(next_pos)\n                # Note: The agent's direction does not change during a movement action.\n                queue.append((next_pos, current_dir, path_actions + [action_type]))\n    \n    # If the BFS queue is exhausted and no path to an adjacent primitive was found.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:41:04.409137", "function_name": "collect", "function_body": "    actions_list = []\n    max_steps = 200  # Arbitrary limit to prevent infinite loops\n\n    # Get action mappings from the environment\n    action_map = env.action_specs()\n    UP = action_map[\"UP\"]\n    DOWN = action_map[\"DOWN\"]\n    LEFT = action_map[\"LEFT\"]\n    RIGHT = action_map[\"RIGHT\"]\n    USE = action_map[\"USE\"]\n\n    # Map movement actions to their (delta_row, delta_col)\n    move_deltas = {\n        UP: (-1, 0),\n        DOWN: (1, 0),\n        LEFT: (0, -1),\n        RIGHT: (0, 1)\n    }\n    \n    env.reset() # Start a new episode to ensure consistent state\n\n    for _ in range(max_steps):\n        current_state = env._current_state\n        inventory = current_state.inventory\n\n        # 1. Check if the primitive is already collected\n        if inventory[primitive] > 0:\n            return actions_list\n\n        # 2. Check if the primitive is next to the agent (within 3x3 neighborhood)\n        # Assuming the USE action automatically collects grabbable items in this vicinity.\n        if current_state.next_to(primitive):\n            actions_list.append(USE)\n            env.step(USE)\n            # Re-evaluate the state after attempting to use/collect\n            continue \n        \n        # 3. Primitive not collected and not next to agent, so move towards it\n        current_pos = current_state.pos\n        grid = current_state.grid\n        width, height, _ = grid.shape # grid.shape is (WIDTH, HEIGHT, n_kinds)\n\n        # Find all locations of the primitive on the grid\n        primitive_locations = []\n        for r in range(width):\n            for c in range(height):\n                if grid[r, c, primitive] > 0:\n                    primitive_locations.append((r, c))\n\n        chosen_action = None\n        if primitive_locations:\n            # Find the closest primitive instance (Manhattan distance)\n            target_pos = None\n            min_dist = float('inf')\n            for r_t, c_t in primitive_locations:\n                dist = abs(r_t - current_pos[0]) + abs(c_t - current_pos[1])\n                if dist < min_dist:\n                    min_dist = dist\n                    target_pos = (r_t, c_t)\n            \n            # Determine valid movement actions: not out of bounds and not into obstacles\n            valid_moves = [] # Stores (action_key, new_r, new_c) for valid moves\n\n            non_grabbable_indices = current_state.world.non_grabbable_indices\n\n            for action_key, (dr_move, dc_move) in move_deltas.items():\n                next_r, next_c = current_pos[0] + dr_move, current_pos[1] + dc_move\n                \n                # Check if the next position is within grid boundaries\n                if not (0 <= next_r < width and 0 <= next_c < height):\n                    continue\n\n                # Check if the next position is occupied by a non-grabbable obstacle\n                is_obstacle = False\n                for k_idx in non_grabbable_indices:\n                    if grid[next_r, next_c, k_idx] > 0:\n                        is_obstacle = True\n                        break\n                if is_obstacle:\n                    continue\n                \n                valid_moves.append((action_key, next_r, next_c))\n\n            if valid_moves:\n                # Prioritize moves that reduce the Manhattan distance to the target.\n                # If multiple actions achieve the same best distance reduction,\n                # pick one randomly among them to avoid deterministic circling.\n                \n                best_action_candidates = []\n                current_min_dist_after_move = float('inf')\n\n                for action_key, next_r, next_c in valid_moves:\n                    dist_after_move = abs(next_r - target_pos[0]) + abs(next_c - target_pos[1])\n                    if dist_after_move < current_min_dist_after_move:\n                        current_min_dist_after_move = dist_after_move\n                        best_action_candidates = [action_key]\n                    elif dist_after_move == current_min_dist_after_move:\n                        best_action_candidates.append(action_key)\n                \n                chosen_action = env.world.random.choice(best_action_candidates)\n            else:\n                # Agent is completely surrounded by obstacles and cannot move to any valid cell.\n                # As a fallback, take a random action, even if it leads to no change or attempts an invalid move.\n                chosen_action = env.world.random.choice(list(move_deltas.keys()))\n\n        else:\n            # Primitive not found anywhere on the grid. Wander randomly.\n            chosen_action = env.world.random.choice(list(move_deltas.keys()))\n\n        actions_list.append(chosen_action)\n        env.step(chosen_action)\n\n    return actions_list # Return the sequence of actions, even if the goal was not met within max_steps", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:42:14.665312", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  # Agent directions consistent with CraftWorld/DMLab: 0=East, 1=South, 2=West, 3=North.\n  class Direction(IntEnum):\n      EAST = 0\n      SOUTH = 1\n      WEST = 2\n      NORTH = 3\n\n  # Define a maximum number of steps for the BFS to find a path.\n  # This prevents excessively long search times and limits the length of the generated action sequence.\n  MAX_COLLECT_STEPS = 100\n\n  # Helper function to determine the coordinates of the cell directly in front of the agent.\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent.\n      Args:\n          y (int): Agent's current row coordinate.\n          x (int): Agent's current column coordinate.\n          direction (Direction): Agent's current facing direction (EAST, SOUTH, WEST, NORTH).\n      Returns:\n          tuple[int, int]: (row, column) coordinates of the cell in front.\n      \"\"\"\n      if direction == Direction.EAST:\n          return y, x + 1\n      if direction == Direction.SOUTH:\n          return y + 1, x\n      if direction == Direction.WEST:\n          return y, x - 1\n      if direction == Direction.NORTH:\n          return y - 1, x\n      return y, x # Should not be reached with valid directions\n\n  actions_taken = []\n\n  # Access the internal CraftState instance directly to get the current state information.\n  # This allows collect_v2 to compute actions from the *current* state of the environment,\n  # enabling chaining with other actions or use as part of a larger plan.\n  current_state = env._current_state\n\n  # Basic validation: Ensure the `primitive` is a recognized entity kind in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # Optimization: If the `primitive` is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Retrieve necessary environment information for pathfinding from the current state.\n  full_grid = current_state.grid # Use the actual current grid state\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir # Use current_state.dir, as the agent's direction can change\n\n  # Determine which entity kinds are impassable for agent movement.\n  # This set will include water (if defined) and any non-grabbable items that are NOT workshops.\n  # Workshops (e.g., workbench, furnace) are typically traversable even if they cannot be picked up.\n  impassable_for_movement = set()\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # The agent's direction automatically updates based on the movement action performed.\n  # Corrected direction mapping to be consistent with CraftWorld's internal direction (0=East, 1=South, 2=West, 3=North).\n  # Format: (Action Enum -> (resulting_Direction Enum, delta_y, delta_x))\n  movement_actions_data = {\n      Action.UP:    (Direction.NORTH, -1, 0),  # Action UP: moves North (dy=-1, dx=0), faces North (Dir 3)\n      Action.DOWN:  (Direction.SOUTH, 1, 0),   # Action DOWN: moves South (dy=1, dx=0), faces South (Dir 1)\n      Action.LEFT:  (Direction.WEST, 0, -1),   # Action LEFT: moves West (dy=0, dx=-1), faces West (Dir 2)\n      Action.RIGHT: (Direction.EAST, 0, 1)    # Action RIGHT: moves East (dy=0, dx=1), faces East (Dir 0)\n  }\n\n  q = collections.deque()\n  # BFS queue state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  # Storing the current direction is crucial because `Action.USE` is dependent on agent orientation.\n  q.append((start_y, start_x, start_dir, []))\n  \n  # Keep track of visited states to prevent redundant exploration and infinite loops in cyclic maps.\n  # A state is defined by (position_y, position_x, direction) because the same grid cell\n  # with a different orientation constitutes a distinct state for the purpose of `Action.USE`.\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None  # This variable will store the final sequence of actions if a valid path is found.\n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Optimization: If the current path length already equals or exceeds MAX_COLLECT_STEPS,\n      # this branch cannot lead to a valid solution within the specified limits,\n      # as a final Action.USE would make it exceed the total allowed steps.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # Calculate the coordinates of the grid cell that the agent is currently facing.\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Check if the facing cell is within grid boundaries and contains the target primitive.\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n          full_grid[facing_y, facing_x, primitive] > 0):\n\n          # We've found a position and orientation from which `Action.USE` can be performed successfully.\n          candidate_path = path + [Action.USE]\n\n          # Ensure the complete path (including the final `Action.USE`) is within the step limit.\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              # Since BFS guarantees finding the shortest path first, we can stop as soon as one is found.\n              break # Exit the BFS loop\n\n      # Explore all possible next states from the current state (curr_y, curr_x, curr_dir).\n      # This involves trying each possible movement action.\n      for action_move, (next_dir, dy, dx) in movement_actions_data.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Pruning: If adding this move makes the path too long for a subsequent USE action.\n          # The path length after this move would be `len(path) + 1`. If this length\n          # is already `MAX_COLLECT_STEPS`, there's no room for the final `USE` action.\n          if len(path) + 1 >= MAX_COLLECT_STEPS:\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable based on the `impassable_for_movement` set.\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # Check if this new (position, direction) state has already been visited.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # If all checks pass, add the new state to the queue for further exploration.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      # If no valid path was found within the step limit, return an empty list.\n      return []\n\n  for action in path_to_execute:\n      # This check ensures that the total number of actions executed does not exceed the limit.\n      # While path_to_execute is already constrained, this acts as a final safeguard.\n      if len(actions_taken) >= MAX_COLLECT_STEPS:\n          break \n\n      actions_taken.append(action)\n      \n      # Perform the action in the environment.\n      # env.step() updates env._current_state internally.\n      reward, done, _ = env.step(action)\n      \n      # After each step, check if the primitive has been collected.\n      # If so, we can stop executing the remaining actions in the path immediately.\n      if env._current_state.inventory[primitive] > 0:\n          return actions_taken\n\n      # If the episode ends for any reason (e.g., max_steps reached in CraftLab setup)\n      # and the goal was *not* satisfied, the collection failed.\n      if done and env._current_state.inventory[primitive] <= 0:\n          return []\n\n  # Final check after executing all actions in the `path_to_execute`.\n  # This handles cases where the primitive is collected on the very last action of the path.\n  if env._current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it implies a failure (e.g., dynamic environment change, or an edge case not covered by planning).\n      return []", "island_id": 0, "scores": {"3": 0.0}}
