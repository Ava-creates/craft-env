{"timestamp": "2025-07-30T22:33:30.802660", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Actions from CraftLab.action_specs\n    ACTIONS = { 'DOWN': 0, 'UP': 1, 'LEFT': 2, 'RIGHT': 3, 'USE': 4 }\n\n    # Relative movements for each action (row_delta, col_delta)\n    # Assuming (row, col) coordinates, with row increasing downwards and col increasing rightwards.\n    MOVE_DELTAS = {\n        ACTIONS['UP']: (-1, 0),\n        ACTIONS['DOWN']: (1, 0),\n        ACTIONS['LEFT']: (0, -1),\n        ACTIONS['RIGHT']: (0, 1),\n    }\n\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    inventory = obs['features_dict']['inventory']\n    normalized_pos = obs['features_dict']['pos']\n\n    # 1. Check if the primitive is already collected.\n    if inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions\n    HEIGHT, WIDTH, _ = grid.shape\n\n    # Convert normalized agent position to integer grid coordinates\n    # The `pos` array from `features_dict` is normalized. Assuming pos[0] is y (row) and pos[1] is x (col).\n    start_row = int(normalized_pos[0] * HEIGHT)\n    start_col = int(normalized_pos[1] * WIDTH)\n    start_pos = (start_row, start_col)\n\n    # Find all locations on the grid where the primitive exists\n    target_locations = np.argwhere(grid[:, :, primitive] == 1)\n    if len(target_locations) == 0:\n        # Primitive not found on the grid, cannot collect it using this method.\n        # This could mean it's a crafted item or not present in the current scenario.\n        return []\n    \n    # Convert target locations to a set for efficient lookup\n    target_locations_set = set(map(tuple, target_locations))\n\n    # BFS setup\n    q = collections.deque([(start_pos, [])]) # Queue stores (current_row, current_col), list of actions taken to reach it\n    visited = {start_pos} # Set of (row, col) tuples visited to prevent cycles and find shortest path\n\n    while q:\n        (r, c), path_so_far = q.popleft()\n\n        # Check if the primitive is within the 3x3 neighborhood of the current position (r,c).\n        # The `CraftState.next_to` method suggests a 3x3 neighborhood for interaction.\n        can_collect = False\n        for dr_check in [-1, 0, 1]:\n            for dc_check in [-1, 0, 1]:\n                nr_check, nc_check = r + dr_check, c + dc_check\n                # Check bounds for the neighbor cell\n                if 0 <= nr_check < HEIGHT and 0 <= nc_check < WIDTH:\n                    # Check if this neighbor cell contains the primitive\n                    if (nr_check, nc_check) in target_locations_set:\n                        can_collect = True\n                        break # Found an adjacent/same-cell target, can collect\n            if can_collect:\n                break # Break outer loop too if found\n\n        if can_collect:\n            # Found a path to a position from which the primitive can be collected using the USE action.\n            return path_so_far + [ACTIONS['USE']]\n\n        # Explore neighbors by moving\n        for action, (dr, dc) in MOVE_DELTAS.items():\n            nr, nc = r + dr, c + dc\n            new_pos = (nr, nc)\n\n            # Check boundaries for the new position\n            if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n                continue\n\n            # This implementation assumes all grid cells are traversable.\n            # In a more complex environment, you might need to check for walls or other\n            # non-traversable entities at grid[nr, nc, obstacle_kind_index] == 1.\n\n            if new_pos not in visited:\n                visited.add(new_pos)\n                q.append((new_pos, path_so_far + [action]))\n    \n    # If the BFS queue is exhausted and no path to collection was found\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:34:53.933311", "function_name": "collect", "function_body": "    # Constants for actions as defined in CraftLab.action_specs\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    actions_taken = []\n    # Maximum number of steps to attempt to collect the primitive.\n    # This prevents infinite loops in complex or impossible scenarios.\n    MAX_ATTEMPTS = 200 \n\n    # Helper function to find the closest instance of the primitive on the grid.\n    # This function is nested to keep all code within the main function as required.\n    def _find_closest_primitive_on_grid(grid, current_pos, primitive_idx):\n        # grid shape is (WIDTH, HEIGHT, n_kinds)\n        # current_pos is (col, row)\n        width, height, _ = grid.shape\n        closest_pos = None\n        min_dist = float('inf')\n\n        for c in range(width):\n            for r in range(height):\n                # Check if this cell contains the primitive kind\n                if grid[c, r, primitive_idx] == 1:\n                    # Calculate Manhattan distance from current position\n                    dist = abs(c - current_pos[0]) + abs(r - current_pos[1])\n                    if dist < min_dist:\n                        min_dist = dist\n                        closest_pos = (c, r)\n        return closest_pos\n\n    # Main loop to try and collect the primitive\n    for _ in range(MAX_ATTEMPTS):\n        # Get the current state from the CraftLab environment.\n        # CraftLab._current_state holds the CraftState instance.\n        current_state = env._current_state \n\n        # 1. Check if the primitive is already collected in the inventory.\n        if current_state.inventory[primitive] > 0:\n            return actions_taken # Goal achieved, return the sequence of actions taken\n\n        # 2. Check if the agent is next to the primitive. If so, try to USE it.\n        if current_state.next_to(primitive):\n            actions_taken.append(USE)\n            # Apply the USE action through the environment.\n            # The environment's internal state (env._current_state) will be updated.\n            # Reward, done status, and observations are not directly used for this logic.\n            _reward, _done, _obs = env.step(USE)\n            continue # Re-evaluate state (especially inventory) in the next iteration\n\n        # 3. If not collected and not next to it, find the closest instance of the primitive on the grid.\n        target_pos = _find_closest_primitive_on_grid(current_state.grid, current_state.pos, primitive)\n\n        if target_pos is None:\n            # The primitive is not found on the visible grid. \n            # This could mean it doesn't exist, was destroyed, or removed.\n            # Cannot proceed further, so return actions taken so far.\n            return actions_taken \n\n        # 4. Determine the best movement action to get closer to the target.\n        current_x, current_y = current_state.pos\n        target_x, target_y = target_pos\n\n        dx = target_x - current_x\n        dy = target_y - current_y\n\n        move_action = None\n        # Prioritize horizontal movement (LEFT/RIGHT) if needed.\n        if dx != 0:\n            if dx > 0: # Target is to the right\n                move_action = RIGHT\n            else: # Target is to the left\n                move_action = LEFT\n        # If no horizontal movement is needed, try vertical movement (UP/DOWN).\n        elif dy != 0: \n            if dy > 0: # Target is downwards (increasing row index)\n                move_action = DOWN\n            else: # Target is upwards (decreasing row index)\n                move_action = UP\n        else:\n            # Agent is at the target_pos (dx=0, dy=0), but hasn't collected it and isn't \"next_to\" it.\n            # This could imply the primitive is non-collectible, or the agent is on it but needs to\n            # move around to be \"next_to\" a collectable part (e.g., for multi-cell objects).\n            # In this simple greedy strategy, we cannot make progress by simple movement.\n            break # Exit loop, returning current actions.\n\n        if move_action is not None:\n            actions_taken.append(move_action)\n            # Apply the movement action through the environment.\n            _reward, _done, _obs = env.step(move_action)\n        else:\n            # This case should ideally not be reached if target_pos is valid and\n            # not equal to current_pos, as a movement action should have been determined.\n            # Acts as a safeguard.\n            break \n        \n    # If the loop finishes (e.g., MAX_ATTEMPTS reached) without collecting the primitive,\n    # return the actions taken up to that point.\n    return actions_taken", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:34:54.942513", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Define action values based on CraftLab.action_specs\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Map (dr, dc) to action for path reconstruction\n  # (dr, dc) represents (row_change, col_change)\n  delta_to_action = {\n      (-1, 0): UP,    # Move up (decrease row index)\n      (1, 0): DOWN,   # Move down (increase row index)\n      (0, -1): LEFT,  # Move left (decrease col index)\n      (0, 1): RIGHT,  # Move right (increase col index)\n  }\n\n  # Neighbor offsets for BFS (4-directional movement)\n  neighbors_for_bfs = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  # Get current state information from the CraftLab environment\n  # env._current_state is a CraftState instance\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos_r, start_pos_c = current_state.pos  # (row, col) as (y, x)\n  height, width, n_kinds = grid.shape  # numpy shape is (rows, cols, depth)\n\n  # --- Guard Clauses ---\n\n  # 1. If the primitive is defined as non-grabbable in the world, it cannot be collected.\n  if primitive in env.world.non_grabbable_indices:\n      return []\n\n  # 2. If the primitive is already immediately next to the agent (within 3x3 neighborhood),\n  #    a single USE action is sufficient.\n  if current_state.next_to(primitive):\n      return [USE]\n\n  # --- BFS Pathfinding to find a cell adjacent to the primitive ---\n\n  q = deque()\n  # Queue stores (current_position_tuple, list_of_actions_to_reach_here)\n  q.append(((start_pos_r, start_pos_c), []))\n  visited = set([(start_pos_r, start_pos_c)])\n\n  while q:\n      (r, c), path = q.popleft()\n\n      # Explore neighbors (potential next positions after a move action)\n      for dr, dc in neighbors_for_bfs:\n          nr, nc = r + dr, c + dc\n          next_pos = (nr, nc)\n\n          # Check bounds\n          if not (0 <= nr < height and 0 <= nc < width):\n              continue\n\n          # Check if the next position has already been visited in a shorter or equal path\n          if next_pos in visited:\n              continue\n\n          # Check if the next position is blocked by a non-grabbable item\n          is_blocked = False\n          # Iterate over all kinds present at the cell (nr, nc)\n          for k_idx in range(n_kinds):\n              if grid[nr, nc, k_idx] > 0:  # If this kind is present at (nr, nc)\n                  if k_idx in env.world.non_grabbable_indices:\n                      is_blocked = True\n                      break\n          if is_blocked:\n              continue\n\n          # If the cell is traversable and not visited, add it to the queue\n          visited.add(next_pos)\n          action_to_reach_next_pos = delta_to_action[(dr, dc)]\n          new_path = path + [action_to_reach_next_pos]\n\n          # After moving to `next_pos`, check if it's now adjacent to the desired primitive.\n          # The `CraftState.next_to()` method checks the 3x3 neighborhood.\n          found_primitive_adjacent_to_next_pos = False\n          for r_offset in [-1, 0, 1]:\n              for c_offset in [-1, 0, 1]:\n                  p_r, p_c = nr + r_offset, nc + c_offset\n                  if 0 <= p_r < height and 0 <= p_c < width:\n                      # If the primitive is present in any cell within the 3x3 neighborhood\n                      # of `next_pos` (including `next_pos` itself), then it can be collected.\n                      if grid[p_r, p_c, primitive] > 0:\n                          found_primitive_adjacent_to_next_pos = True\n                          break\n              if found_primitive_adjacent_to_next_pos:\n                  break\n\n          if found_primitive_adjacent_to_next_pos:\n              # We found the shortest path to a position from which the primitive can be collected.\n              return new_path + [USE]\n\n          # If not adjacent to the primitive, continue BFS from this position\n          q.append((next_pos, new_path))\n\n  # If the BFS completes and no path to the primitive is found on the grid\n  return []", "island_id": 3, "scores": {"3": -1}}
