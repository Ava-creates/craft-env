{"timestamp": "2025-07-30T14:45:38.524927", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # --- Constants for actions and directions ---\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Agent's internal direction mapping (as used by CraftState)\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  # Delta (dx, dy) for moving one step in each facing direction\n  DIRECTION_TO_DELTA = {\n      DIR_UP: (0, -1),   # Moving up decreases y\n      DIR_RIGHT: (1, 0),  # Moving right increases x\n      DIR_DOWN: (0, 1),   # Moving down increases y\n      DIR_LEFT: (-1, 0),  # Moving left decreases x\n  }\n\n  # Maps a movement action (e.g., UP, DOWN) to the resulting agent facing direction\n  # After moving, the agent faces the direction of movement.\n  MOVE_ACTION_TO_DIRECTION = {\n      UP: DIR_UP,\n      RIGHT: DIR_RIGHT,\n      DOWN: DIR_DOWN,\n      LEFT: DIR_LEFT,\n  }\n\n  # --- Get current environment state from observations ---\n  obs = env.observations()\n  grid = obs['features_dict']['features_global'] # Full grid occupancy (W, H, K)\n  \n  # Agent's current integer position (x, y) and initial facing direction (0-3)\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  initial_dir = np.argmax(obs['features_dict']['direction']) # Convert one-hot direction to integer index\n\n  world = env.world # Reference to the CraftWorld configuration\n  \n  # --- Pre-calculate traversable cells on the grid ---\n  # A cell is considered traversable if it does not contain any \"non-grabbable\" entity\n  # (e.g., walls, water, workshops). Primitives themselves are usually grabbable and\n  # thus, cells containing them are traversable.\n  W, H, K = grid.shape # Grid dimensions (Width, Height, Number of Kinds)\n\n  # Create a boolean mask to efficiently identify non-grabbable kinds\n  is_obstacle_kind = np.zeros(K, dtype=bool)\n  if world.non_grabbable_indices: # Ensure there are actual obstacles to consider\n      is_obstacle_kind[list(world.non_grabbable_indices)] = True\n  \n  # Determine which grid cells contain any obstacle kind\n  # `(grid[:, :, is_obstacle_kind] > 0)` selects slices for obstacle kinds and checks if their count is > 0.\n  # `.any(axis=-1)` collapses this to a (W, H) boolean map, True where any obstacle is present.\n  obstacles_present_map = (grid[:, :, is_obstacle_kind] > 0).any(axis=-1)\n  \n  # Invert the map: traversable cells are those WITHOUT obstacles\n  traversable_mask = ~obstacles_present_map\n\n  # Early exit: if the agent's starting position is not traversable, no path can be found.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return []\n\n  # --- Identify all \"primitive target states\" ---\n  # A primitive target state is an (agent_x, agent_y, agent_dir) tuple from which\n  # the 'USE' action will successfully collect the 'primitive'.\n  # This implies the agent must be adjacent to a cell containing the primitive and facing it.\n  \n  primitive_target_states = set()\n  \n  # Iterate through every cell on the grid\n  for px in range(W):\n      for py in range(H):\n          # If the current cell (px, py) contains the target primitive\n          if grid[px, py, primitive] > 0:\n              # For each possible direction the agent could be facing (ad)\n              for agent_dir, (dx, dy) in DIRECTION_TO_DELTA.items():\n                  # Calculate the agent's required position (ax, ay) such that (px, py)\n                  # is directly in front of the agent when facing 'agent_dir'.\n                  # If agent is at (ax, ay) and faces 'agent_dir', it targets (ax + dx, ay + dy).\n                  # We want (ax + dx, ay + dy) == (px, py), so ax = px - dx, ay = py - dy.\n                  ax, ay = px - dx, py - dy\n\n                  # Check if this calculated agent position (ax, ay) is valid (within bounds)\n                  # and traversable for the agent.\n                  if (0 <= ax < W and 0 <= ay < H and\n                      traversable_mask[ax, ay]):\n                      primitive_target_states.add((ax, ay, agent_dir))\n\n  # Early exit: if there are no primitives on the map or no reachable target states, return empty.\n  if not primitive_target_states:\n      return []\n\n  # --- Breadth-First Search (BFS) to find the shortest path ---\n  # The BFS queue stores tuples: ((current_x, current_y, current_direction), list_of_actions_taken)\n  q = deque([((current_pos_x, current_pos_y, initial_dir), [])])\n  # The visited set keeps track of (x, y, dir) states to avoid cycles and redundant paths.\n  visited = {(current_pos_x, current_pos_y, initial_dir)}\n\n  while q:\n      (curr_x, curr_y, curr_dir), actions_so_far = q.popleft()\n\n      # Check if the current state is one of our desired primitive target states\n      if (curr_x, curr_y, curr_dir) in primitive_target_states:\n          # If yes, we've found the shortest path. Append the 'USE' action and return.\n          return actions_so_far + [USE]\n\n      # Explore all possible movement actions (UP, DOWN, LEFT, RIGHT) from the current state\n      for action_val in [UP, DOWN, LEFT, RIGHT]:\n          # Determine the agent's new facing direction after taking this movement action\n          next_dir = MOVE_ACTION_TO_DIRECTION[action_val]\n          \n          # Calculate the agent's new position based on the movement direction.\n          # The agent moves one step into the cell it will face.\n          dx_move, dy_move = DIRECTION_TO_DELTA[next_dir]\n          next_x, next_y = curr_x + dx_move, curr_y + dy_move\n          \n          next_state = (next_x, next_y, next_dir)\n\n          # Check conditions for a valid next state:\n          # 1. Within grid boundaries (0 <= x < W, 0 <= y < H)\n          # 2. The new cell is traversable\n          # 3. This specific (x, y, dir) state has not been visited yet\n          if (0 <= next_x < W and 0 <= next_y < H and\n              traversable_mask[next_x, next_y] and\n              next_state not in visited):\n              \n              visited.add(next_state) # Mark the new state as visited\n              q.append((next_state, actions_so_far + [action_val])) # Add to queue for exploration\n\n  # If the BFS queue becomes empty and no path to a primitive target state was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:45:39.489933", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Action constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Movement deltas for actions (dx, dy)\n  # These define how the agent's position changes for each movement action.\n  MOVES_DELTA = {\n      UP: (0, -1),   # (dx, dy)\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  obs = env.observations()\n  grid = obs['features_dict']['features_global'] # Get the full grid state\n  \n  # Agent's current position (x, y) as integers\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices # Indices of entities that act as obstacles\n\n  W, H, K = grid.shape # Grid dimensions (Width, Height, Number of Kinds)\n\n  # 1. Determine traversable cells.\n  # A cell is considered traversable if it does not contain any non-grabbable item (obstacle).\n  if non_grabbable_indices:\n      # Create a boolean mask where True indicates an obstacle is present in that cell.\n      # np.any checks if any of the non-grabbable kinds have a count > 0 in a cell.\n      obstacles_present = np.any(grid[:, :, list(non_grabbable_indices)] > 0, axis=2)\n      traversable_mask = ~obstacles_present # Invert to get traversable cells\n  else:\n      # If no non-grabbable items are defined, all cells are considered traversable.\n      traversable_mask = np.ones((W, H), dtype=bool)\n\n  # If the agent starts in an untraversable cell (should not happen in valid scenarios),\n  # no movement is possible.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return [] \n\n  # 2. Identify all \"collectible positions\" for the agent.\n  # Based on the CraftState.next_to description (\"3x3 neighborhood\"),\n  # the USE action allows collection if the primitive is within a 3x3 square\n  # centered on the agent's current position (including the agent's cell itself).\n  collectible_mask = np.zeros((W, H), dtype=bool)\n  \n  # Iterate through all grid cells to find where the primitive exists.\n  for px in range(W):\n      for py in range(H):\n          if grid[px, py, primitive] > 0: # If primitive is found at (px, py)\n              # Mark all cells in the 3x3 neighborhood around (px, py) as collectible positions.\n              for dx in [-1, 0, 1]:\n                  for dy in [-1, 0, 1]:\n                      ax, ay = px + dx, py + dy # Potential agent position\n                      \n                      # Ensure the potential agent position is within grid boundaries.\n                      if 0 <= ax < W and 0 <= ay < H:\n                          collectible_mask[ax, ay] = True\n\n  # 3. Perform a Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any reachable \"collectible position\".\n  # BFS state: ((current_x, current_y), list_of_actions_taken_to_reach_here)\n  q = deque([((current_pos_x, current_pos_y), [])])\n  visited = {(current_pos_x, current_pos_y)} # Keep track of visited (x,y) positions\n\n  while q:\n      (curr_x, curr_y), actions_so_far = q.popleft()\n\n      # If the current position is marked as collectible, we have found a valid path.\n      # The position must also be traversable, which is guaranteed by the BFS only\n      # enqueuing traversable cells.\n      if collectible_mask[curr_x, curr_y]:\n          return actions_so_far + [USE] # Append USE action and return the path.\n\n      # Explore all possible next steps from the current position.\n      for action_val, (dx, dy) in MOVES_DELTA.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # Check if the next position is within bounds, traversable, and not yet visited.\n          if (0 <= next_x < W and 0 <= next_y < H and\n              traversable_mask[next_x, next_y] and\n              next_pos not in visited):\n              \n              visited.add(next_pos)\n              q.append((next_pos, actions_so_far + [action_val]))\n\n  # If the BFS completes and no path to a collectible primitive location was found,\n  # return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:46:58.537228", "function_name": "collect", "function_body": "    # Constants for actions based on CraftLab's action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Map (dr, dc) deltas to their corresponding action constants\n    DELTAS_TO_ACTIONS = {\n        (-1, 0): ACTION_UP,\n        (1, 0): ACTION_DOWN,\n        (0, -1): ACTION_LEFT,\n        (0, 1): ACTION_RIGHT,\n    }\n\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    grid = features_dict['features_global']\n    # Convert normalized float position array to integer tuple (row, col)\n    current_pos = tuple(features_dict['pos'].astype(int))\n    inventory = features_dict['inventory']\n\n    # 1. Check if the primitive is already in inventory\n    if inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions (height, width)\n    height, width, _ = grid.shape\n\n    # 2. Find all locations of the primitive on the grid\n    primitive_locations = []\n    for r in range(height):\n        for c in range(width):\n            if grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        # Primitive not found on the grid\n        return []\n\n    # 3. Find the closest primitive location using Manhattan distance\n    target_pos = None\n    min_dist = float('inf')\n    for loc in primitive_locations:\n        dist = abs(loc[0] - current_pos[0]) + abs(loc[1] - current_pos[1])\n        if dist < min_dist:\n            min_dist = dist\n            target_pos = loc\n\n    if target_pos is None: # This should theoretically not happen if primitive_locations is not empty\n        return []\n\n    # 4. Perform BFS to find the shortest path to target_pos\n    q = collections.deque()\n    q.append(current_pos)\n    \n    # visited will store (current_node: parent_node) to reconstruct the path\n    visited = {current_pos: None}\n\n    path_found = False\n    final_path_node = None\n\n    while q:\n        r, c = q.popleft()\n        current_node = (r, c)\n\n        if current_node == target_pos:\n            path_found = True\n            final_path_node = current_node\n            break\n\n        # Explore neighbors (UP, DOWN, LEFT, RIGHT movements)\n        for dr, dc in DELTAS_TO_ACTIONS.keys():\n            nr, nc = r + dr, c + dc\n            neighbor_node = (nr, nc)\n\n            # Check grid boundaries\n            if 0 <= nr < height and 0 <= nc < width:\n                if neighbor_node not in visited:\n                    visited[neighbor_node] = current_node\n                    q.append(neighbor_node)\n\n    if not path_found:\n        # No path found to the primitive (e.g., it's in an unreachable area)\n        return []\n\n    # 5. Reconstruct the path of actions\n    actions_to_take = []\n    current_reconstruct_node = final_path_node\n    \n    while current_reconstruct_node != current_pos:\n        parent_node = visited[current_reconstruct_node]\n        dr = current_reconstruct_node[0] - parent_node[0]\n        dc = current_reconstruct_node[1] - parent_node[1]\n        \n        # Determine the action based on the delta\n        action = DELTAS_TO_ACTIONS.get((dr, dc))\n        if action is None:\n            # This indicates an unexpected delta, which shouldn't happen with valid movement\n            return [] \n        \n        actions_to_take.append(action)\n        current_reconstruct_node = parent_node\n    \n    actions_to_take.reverse() # Path was built from target to start, so reverse it\n\n    # 6. After reaching the primitive's location, add the 'USE' action\n    actions_to_take.append(ACTION_USE)\n    \n    return actions_to_take", "island_id": 0, "scores": {"3": -1}}
