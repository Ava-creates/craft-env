{"timestamp": "2025-07-30T14:30:55.950728", "function_name": "collect", "function_body": "  import collections\n\n  # Retrieve action mappings dynamically from the environment.\n  # This makes the code resilient to potential changes in the environment's\n  # action mapping, as opposed to hardcoding them (which was a potential issue in v1).\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Map movement actions to their corresponding cardinal direction integers.\n  # These direction integers (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) are used internally\n  # by CraftState to represent the agent's facing direction.\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map cardinal direction integers to their (dx, dy) vector components.\n  # These vectors represent the change in position for movement actions, or\n  # the relative coordinates of the \"cell in front\" of the agent, which is\n  # where the 'USE' action is applied.\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y-coordinate\n      1: (1, 0),   # RIGHT: increases x-coordinate\n      2: (0, 1),   # DOWN: increases y-coordinate\n      3: (-1, 0)   # LEFT: decreases x-coordinate\n  }\n\n  # Pre-check: Verify if the target primitive is actually designated as \"grabbable\".\n  # Only items in `env.world.grabbable_indices` can be picked up by the agent.\n  if primitive not in env.world.grabbable_indices:\n    return []  # Cannot collect this primitive if it's not grabbable.\n\n  # Get the current state details from the environment.\n  # This includes the agent's current position, facing direction, and the full grid layout.\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Retrieve indices of entities that cannot be walked on (obstacles) from the world configuration.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Define a helper function to determine if a given grid cell is traversable by the agent.\n  # This fixes the major flaw in `collect_v1` which did not consider obstacles.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False  # Out of bounds means not walkable\n\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False  # Cell is blocked by an obstacle (e.g., water, workshop)\n    return True  # Cell is traversable\n\n  # Initialize the Breadth-First Search (BFS) algorithm.\n  # The queue will store tuples: (current_x, current_y, current_direction, list_of_actions_taken_to_reach_here).\n  # BFS guarantees finding the shortest path in terms of actions.\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # A set to keep track of visited states. A state is defined by (x, y, direction)\n  # to prevent redundant computations and infinite loops, as both position and\n  # facing direction are crucial for subsequent actions (especially 'USE').\n  visited = set([(start_x, start_y, start_dir)])\n\n  # Start the BFS traversal to find the shortest path to collect the primitive.\n  while queue:\n    # Dequeue the current state and its accumulated action path.\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the primitive can be collected from the current state.\n    # The 'USE' action targets the grid cell directly in front of the agent.\n    faced_dx, faced_dy = DIR_VEC[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # If the cell directly in front is within bounds and contains the target primitive:\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Goal reached! Return the path with the final 'USE' action appended.\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next movement actions (UP, RIGHT, DOWN, LEFT).\n    # Performing a movement action implicitly sets the agent's facing direction\n    # to the direction of movement.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new position and direction after performing this action.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action]  # Agent's new facing direction after moving\n\n      # If the calculated next cell is walkable AND this specific (position, direction) state\n      # has not been visited yet, add it to the queue for further exploration.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found,\n  # it indicates that the primitive is unreachable from the current state.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:30:56.946283", "function_name": "collect", "function_body": "  import collections\n\n  # Retrieve action mappings dynamically for robustness.\n  # This makes the code resilient to potential changes in the environment's action mapping.\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Map movement actions to their corresponding cardinal direction integers used by CraftState.\n  # CraftState directions: 0: North (UP), 1: East (RIGHT), 2: South (DOWN), 3: West (LEFT)\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,    # Agent faces North (direction 0) after moving UP\n      ACTION_RIGHT: 1, # Agent faces East (direction 1) after moving RIGHT\n      ACTION_DOWN: 2,  # Agent faces South (direction 2) after moving DOWN\n      ACTION_LEFT: 3   # Agent faces West (direction 3) after moving LEFT\n  }\n\n  # Map cardinal direction integers to their (dx, dy) vector components.\n  # These vectors represent the change in position for movement or the\n  # relative coordinates of the \"cell in front\" of the agent.\n  # Assumes (0,0) is top-left, x increases right, y increases down.\n  DIR_VEC = {\n      0: (0, -1),  # North (UP)\n      1: (1, 0),   # East (RIGHT)\n      2: (0, 1),   # South (DOWN)\n      3: (-1, 0)   # West (LEFT)\n  }\n\n  # Pre-check: Verify if the target primitive is actually designated as \"grabbable\".\n  # Only items in `env.world.grabbable_indices` can be picked up by the agent.\n  if primitive not in env.world.grabbable_indices:\n    return [] # Cannot collect this primitive\n\n  # Get the current state details of the environment.\n  # This includes the agent's position, facing direction, and the full grid layout.\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Retrieve indices of entities that cannot be walked on (obstacles) from the world configuration.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Define a helper function to determine if a given grid cell is traversable by the agent.\n  def is_walkable(x, y):\n    # First, check if the coordinates are within the valid grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds means not walkable\n\n    # Then, check if the cell is occupied by any non-grabbable item (e.g., water, workshops).\n    # If an obstacle is present (grid value is 1 for that kind), the cell is not walkable.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False # Cell is blocked by an obstacle\n    return True # Cell is traversable\n\n  # Initialize the Breadth-First Search (BFS) algorithm.\n  # The queue will store tuples: (current_x, current_y, current_direction, list_of_actions_taken_to_reach_here).\n  # `collections.deque` is used for efficient append and pop operations.\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # A set to keep track of visited states. A state is defined by (x, y, direction)\n  # because both position and facing direction are crucial for movement and the 'USE' action.\n  # This prevents redundant computations and infinite loops in cyclic paths.\n  visited = set([(start_x, start_y, start_dir)])\n\n  # Start the BFS traversal.\n  while queue:\n    # Dequeue the current state and its accumulated action path.\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the primitive can be collected from the current state.\n    # The 'USE' action targets the grid cell directly in front of the agent.\n    faced_dx, faced_dy = DIR_VEC[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # If the cell in front is within bounds and contains the target primitive:\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Goal reached! Return the path with the final 'USE' action appended.\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next movement actions (UP, RIGHT, DOWN, LEFT).\n    # Moving in a direction also implicitly sets the agent's facing direction to that direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new position and direction after performing this action.\n      next_dir = ACTION_TO_DIR[action] # Agent's new facing direction\n      move_dx, move_dy = DIR_VEC[next_dir] # Movement vector based on action's direction\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n\n      # If the calculated next cell is walkable AND this specific (position, direction) state\n      # has not been visited yet, add it to the queue for further exploration.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found,\n  # it indicates that the primitive is unreachable from the current state.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:32:00.829760", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` (which is implicitly an improvement over `collect_v0`).\n  This version enhances the pathfinding by avoiding moving into impassable terrain,\n  specifically cells containing 'water'.\n  \"\"\"\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name.\n  # The index method will add the primitive to the cookbook's index if it doesn't already exist.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable.\n  # Non-grabbable items (like water or fixed stone) cannot be \"collected\" via USE.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 4. Retrieve grid dimensions for boundary checks.\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Get the index for water, which we will treat as impassable terrain for movement.\n  # CraftWorld specifies `water_index: int index for the \u201cwater\u201d entity`.\n  water_idx = env.world.water_index\n\n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a position and orientation from which the primitive can be collected via USE.\n  # BFS state: ((current_x, current_y), current_direction, [list_of_actions_to_reach_here])\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's initial direction (0-3)\n\n  queue = [(start_pos, start_dir, [])] \n  # Set of visited ((x, y), direction) tuples to prevent cycles and redundant path exploration\n  visited = {(start_pos, start_dir)} \n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.pop(0) # Dequeue for BFS\n\n    # Calculate the coordinates of the cell directly in front of the agent,\n    # which is the target for the USE action.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # Check if the cell in front is within bounds and contains the primitive.\n    # This is the correct goal condition for collecting an item via 'USE'.\n    # Note: We do NOT check if target_x, target_y is 'water' here. The agent can often 'USE'\n    # an item that is in water (e.g., collect fish from water), as long as they are adjacent.\n    # The 'impassable' check applies only to movement *into* a cell.\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        current_state.grid[target_x, target_y, primitive_idx] > 0):\n      # Found a path where the agent can move to a position, face the primitive,\n      # and then USE to collect it. BFS guarantees this is the shortest path.\n      return path_actions + [USE_ACTION]\n    \n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # A movement action changes the agent's position and its facing direction\n    # to the direction of movement.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement\n\n      # Check if the next position is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # --- IMPROVEMENT: Check for impassable terrain ---\n      # If the cell the agent is trying to move into contains water, it's considered impassable.\n      if current_state.grid[next_x, next_y, water_idx] > 0:\n        continue # Cannot move into a water cell.\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple) # Mark the new state as visited\n        # Add the new state and its path to the queue for further exploration\n        queue.append((next_state_tuple[0], next_state_tuple[1], path_actions + [move_action]))\n\n  # If the queue becomes empty and no path was found, it means the primitive\n  # is unreachable from the current state (e.g., not on the map, or surrounded by obstacles).\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:32:01.823704", "function_name": "collect", "function_body": "  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable.\n  #    Non-grabbable items that are not workshops cannot be \"collected\" via USE if they are\n  #    intended to be static environment features, but this check ensures the item can be picked up.\n  if primitive_idx not in env.world.grabbable_indices:\n    # If the primitive is not grabbable, it might be an environmental feature\n    # like water or a large stone formation that cannot be picked up.\n    # We still allow \"USE\" on it if it's on the grid, assuming \"USE\" might\n    # yield something (e.g., USE tree -> wood).\n    # However, if it's strictly non-grabbable and doesn't yield anything via USE,\n    # this function would return an empty list if not found.\n    # The BFS below will attempt to find a path to it for a USE action.\n    pass # No explicit return [] here just for non-grabbable, let BFS try\n  \n  # 3. Check if the primitive is already in the agent's inventory.\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 4. Retrieve grid dimensions for boundary checks.\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a position and orientation from which the primitive can be collected via USE.\n  #    Improvement over collect_v0: The BFS now explicitly checks for obstacles (non-traversable\n  #    non-grabbable entities) when considering next positions.\n  \n  # BFS state: ((current_x, current_y), current_direction, [list_of_actions_to_reach_here])\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's initial direction (0-3)\n\n  queue = [(start_pos, start_dir, [])] \n  # Set of visited ((x, y), direction) tuples to prevent cycles and redundant path exploration\n  visited = {(start_pos, start_dir)} \n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.pop(0) # Dequeue for BFS\n\n    # Calculate the coordinates of the cell directly in front of the agent,\n    # which is the target for the USE action.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # Check if the cell in front is within bounds and contains the primitive.\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        current_state.grid[target_x, target_y, primitive_idx] > 0):\n      # Found a path where the agent can move to a position, face the primitive,\n      # and then USE to collect it. BFS guarantees this is the shortest path.\n      return path_actions + [USE_ACTION]\n    \n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # A movement action changes the agent's position and its facing direction\n    # to the direction of movement.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement\n\n      # 6. Improvement: Check if the next position is within bounds AND not an obstacle.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue # Out of bounds\n\n      # Check if the potential next cell contains any impassable obstacles.\n      # An obstacle is defined as a non-grabbable entity that is NOT a workshop.\n      # Workshops are typically traversable as the agent needs to move onto them to use them.\n      is_obstacle = False\n      for k_idx in range(env.world.cookbook.n_kinds):\n          if current_state.grid[next_x, next_y, k_idx] > 0: # If this kind is present in the cell\n              if k_idx in env.world.non_grabbable_indices and k_idx not in env.world.workshop_indices:\n                  is_obstacle = True\n                  break # Found an obstacle in this cell\n      \n      if is_obstacle:\n        continue # Cannot move into this cell\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple) # Mark the new state as visited\n        # Add the new state and its path to the queue for further exploration\n        queue.append((next_state_tuple[0], next_state_tuple[1], path_actions + [move_action]))\n\n  # If the queue becomes empty and no path was found, it means the primitive\n  # is unreachable from the current state (e.g., not on the map, or surrounded by obstacles).\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:34:03.688199", "function_name": "collect", "function_body": "  # 1. Get current state and relevant info\n  obs = env.observations()\n  current_pos = tuple(obs['pos']) # Convert numpy array to tuple for hashing in set\n  grid = obs['features_global']\n\n  # Get action mapping\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Grid dimensions\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n\n  # Get obstacle indices (assuming water is impassable)\n  # CraftWorld instance is accessible via env.world\n  water_idx = env.world.water_index\n  obstacle_kinds = {water_idx}\n\n  # 2. Check if primitive is already in inventory\n  if obs['inventory'][primitive] > 0:\n    return [] # Already collected\n\n  # 3. Find all locations of the primitive on the grid\n  primitive_locs = []\n  for r in range(WIDTH):\n    for c in range(HEIGHT):\n      if grid[r, c, primitive] == 1:\n        primitive_locs.append((r, c))\n\n  if not primitive_locs:\n    # Primitive not found on the map\n    return []\n\n  # 4. Perform BFS to find the shortest path to a cell adjacent to the primitive\n  # collections.deque is used for efficient popleft. It is assumed 'collections' is available.\n  import collections # Local import for deque, if not already imported globally.\n  q = collections.deque([(current_pos, [])]) # Queue stores (position, path_taken)\n  visited = {current_pos} # Set of visited positions\n\n  found_path = None\n\n  # Define possible movements and their corresponding actions\n  # (dr, dc): action_value\n  delta_to_action = {\n      (-1, 0): ACTION_UP,    # Moving North (row decreases)\n      (1, 0): ACTION_DOWN,   # Moving South (row increases)\n      (0, -1): ACTION_LEFT,  # Moving West (column decreases)\n      (0, 1): ACTION_RIGHT,  # Moving East (column increases)\n  }\n  # List of deltas for iterating over neighbors\n  adj_deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n\n  while q:\n    (r, c), path = q.popleft()\n\n    # Check if the current position is adjacent to any primitive location\n    # If yes, we can perform a USE action from here\n    for pr, pc in primitive_locs:\n      if abs(r - pr) + abs(c - pc) == 1: # Manhattan distance of 1 means adjacent\n        found_path = path + [ACTION_USE]\n        break # Found a path, exit primitive_locs loop\n    \n    if found_path is not None:\n      break # Found a path, exit BFS loop\n\n    # Explore neighbors\n    for dr, dc in adj_deltas:\n      nr, nc = r + dr, c + dc\n      next_pos = (nr, nc)\n\n      # Check boundary conditions and if already visited\n      if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT) or next_pos in visited:\n        continue\n\n      # Check for obstacles at the next position\n      is_obstacle = False\n      for k in obstacle_kinds:\n        if grid[nr, nc, k] == 1:\n          is_obstacle = True\n          break\n      if is_obstacle:\n        continue # Skip this neighbor if it's an obstacle\n\n      # Add to queue\n      visited.add(next_pos)\n      q.append((next_pos, path + [delta_to_action[(dr, dc)]]))\n\n  return found_path if found_path is not None else []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:34:03.758210", "function_name": "collect", "function_body": "    # Action constants (assuming standard CraftLab mapping)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Delta row, delta col for each movement action\n    DR = {\n        ACTION_DOWN: 1,\n        ACTION_UP: -1,\n        ACTION_LEFT: 0,\n        ACTION_RIGHT: 0,\n    }\n    DC = {\n        ACTION_DOWN: 0,\n        ACTION_UP: 0,\n        ACTION_LEFT: -1,\n        ACTION_RIGHT: 1,\n    }\n\n    # New direction after taking a movement action\n    # Assuming directions are mapped as: 0:North, 1:East, 2:South, 3:West\n    DIR_AFTER_MOVE = {\n        ACTION_UP: 0,\n        ACTION_RIGHT: 1,\n        ACTION_DOWN: 2,\n        ACTION_LEFT: 3,\n    }\n\n    actions_taken = []\n\n    # Get initial observations to plan\n    initial_obs = env.observations()\n    initial_grid = initial_obs['features_dict']['features_global']\n    initial_pos_norm = initial_obs['features_dict']['pos']\n    initial_inventory = initial_obs['features_dict']['inventory']\n\n    # Get grid dimensions from the global feature grid shape\n    grid_width = initial_grid.shape[0]\n    grid_height = initial_grid.shape[1]\n\n    # Convert normalized position (from features_dict) to integer grid coordinates\n    current_row = int(round(initial_pos_norm[0] * (grid_width - 1)))\n    current_col = int(round(initial_pos_norm[1] * (grid_height - 1)))\n    # Get initial direction from its one-hot encoding in features_dict\n    current_dir = np.argmax(initial_obs['features_dict']['direction'])\n\n    # Get initial count of the primitive to determine if collection was successful\n    initial_primitive_count = initial_inventory[primitive]\n\n    # If the primitive is already collected, no actions are needed\n    if initial_primitive_count > 0:\n        return []\n\n    # --- BFS (Breadth-First Search) to find a path to a collectable primitive ---\n    # The queue stores tuples: (row, col, direction, list_of_actions_to_reach_here)\n    q = collections.deque()\n    q.append((current_row, current_col, current_dir, []))\n\n    # Visited set to prevent revisiting states and infinite loops.\n    # A state is defined by (row, col, direction) because direction affects 'USE' action.\n    visited = set()\n    visited.add((current_row, current_col, current_dir))\n\n    target_path = None\n\n    # Set a maximum number of BFS steps to prevent excessive computation in large/complex maps.\n    # This is a heuristic based on grid size and number of possible directions.\n    max_bfs_search_states = grid_width * grid_height * len(DIR_AFTER_MOVE) * 2\n\n    bfs_steps_count = 0\n\n    while q and bfs_steps_count < max_bfs_search_states:\n        r, c, d, path = q.popleft()\n        bfs_steps_count += 1\n\n        # Check if the primitive is in the 3x3 neighborhood of the current agent position (r, c).\n        # The CraftState.next_to method indicates this region is relevant for interaction.\n        found_primitive_in_neighborhood = False\n        for dr_adj in [-1, 0, 1]:\n            for dc_adj in [-1, 0, 1]:\n                nr_adj, nc_adj = r + dr_adj, c + dc_adj\n                \n                # Ensure the adjacent cell is within grid boundaries\n                if 0 <= nr_adj < grid_width and 0 <= nc_adj < grid_height:\n                    # Check if this adjacent cell actually contains the desired primitive\n                    if initial_grid[nr_adj, nc_adj, primitive] > 0:\n                        # If found, this position (r,c) is where the agent needs to be.\n                        # The path to collect is the current path plus a 'USE' action.\n                        target_path = path + [ACTION_USE]\n                        found_primitive_in_neighborhood = True\n                        break # Found the primitive, stop checking neighbors for this (r,c)\n            if found_primitive_in_neighborhood:\n                break # Found the primitive, stop processing this (r,c) state\n        \n        if found_primitive_in_neighborhood:\n            break # Found the goal path, exit the BFS loop\n\n        # Explore possible next states by applying movement actions\n        for action in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n            nr, nc = r + DR[action], c + DC[action]\n            nd = DIR_AFTER_MOVE[action] # Agent's new direction after this cardinal movement\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= nr < grid_width and 0 <= nc < grid_height):\n                continue # Cannot move out of bounds\n\n            # Check if the next cell (nr, nc) is blocking (e.g., contains a wall or unpassable object).\n            # `env.world` is a CraftWorld instance, which contains `non_grabbable_indices` for such checks.\n            is_blocking = False\n            for k_idx in env.world.non_grabbable_indices:\n                if initial_grid[nr, nc, k_idx] > 0:\n                    is_blocking = True\n                    break\n            \n            if is_blocking:\n                continue # Cannot move into a blocking cell\n\n            # Check if this new (position, direction) state has already been visited\n            if (nr, nc, nd) not in visited:\n                visited.add((nr, nc, nd))\n                q.append((nr, nc, nd, path + [action]))\n\n    # --- Execute the planned actions on the actual environment ---\n    if target_path:\n        for action in target_path:\n            # Before each action, check if the primitive has already been collected.\n            # This handles cases where the goal might be achieved mid-plan (e.g., if multiple\n            # primitives are present and one was collected earlier by another means).\n            current_obs = env.observations()\n            current_inv = current_obs['features_dict']['inventory']\n            if current_inv[primitive] > initial_primitive_count:\n                # Goal already satisfied, no need to take further actions\n                break\n            \n            # Take the step in the actual environment\n            _, _, _ = env.step(action)\n            actions_taken.append(action)\n\n        # Final verification: Check if the primitive count increased after executing the plan\n        final_obs = env.observations()\n        final_inv = final_obs['features_dict']['inventory']\n        \n        if final_inv[primitive] > initial_primitive_count:\n            # The primitive was successfully collected\n            return actions_taken\n        else:\n            # If the primitive count did not increase, it implies the collection failed.\n            # This could be due to complex interaction rules, item depletion, or a faulty plan.\n            # In such cases, return an empty list to signify non-completion.\n            return []\n    \n    # If no path was found by the BFS (e.g., the primitive is not present on the map,\n    # or it is in an unreachable location due to obstacles)\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:34:41.430940", "function_name": "collect", "function_body": "  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name.\n  # The `index` method of the Cookbook's Index will add the primitive if it's new.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # Improvement: Ensure the requested 'primitive' name actually corresponds to a primitive resource\n  # defined in the world's cookbook. If it's a crafted item or an unknown entity,\n  # it cannot be \"collected\" as a primitive in this context.\n  if primitive_idx not in env.world.cookbook.primitives:\n    return []\n\n  # 2. Pre-checks:\n  #    a. Check if the primitive can be picked up. If not, it cannot be collected via the USE action.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  #    b. Check if the primitive is already in the agent's inventory.\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 3. Retrieve grid dimensions for boundary checks.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # 4. Perform a Breadth-First Search (BFS) to find the shortest sequence of actions\n  #    that leads to a state (position + direction) from which the primitive can be collected.\n  # The BFS queue stores tuples: ((current_x, current_y), current_direction, [list_of_actions_taken])\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's initial direction (0-3)\n\n  queue = [(start_pos, start_dir, [])] \n  # `visited` set tracks ((x, y), direction) tuples to avoid redundant exploration and cycles.\n  visited = {(start_pos, start_dir)} \n\n  while queue:\n    # Dequeue the current state: its position, facing direction, and the path to reach it.\n    (curr_x, curr_y), curr_dir, path_actions = queue.pop(0) \n\n    # Calculate the coordinates of the cell directly in front of the agent.\n    # This is the cell that the USE action would interact with.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # Check if the cell in front is within grid bounds and contains the desired primitive.\n    # If true, a valid path is found. Since this is BFS, it's the shortest path.\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      # Append the USE action to the found path and return it.\n      return path_actions + [USE_ACTION]\n    \n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # In CraftWorld, moving in a direction (e.g., UP) also sets the agent's facing direction (UP).\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT.\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # The agent's new direction becomes the direction of movement.\n\n      # Check if the potential next position is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet:\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple) # Mark the new state as visited.\n        # Enqueue the new state along with the updated path.\n        queue.append((next_state_tuple[0], next_state_tuple[1], path_actions + [move_action]))\n\n  # If the BFS queue becomes empty and no path was found, it means the primitive\n  # is currently unreachable from the agent's starting state.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:34:42.457587", "function_name": "collect", "function_body": "  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name.\n  # The `index` method of the Cookbook's Index will add the primitive if it's new,\n  # ensuring we have a valid ID.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Pre-checks:\n  #    a. Check if the primitive can be picked up. If not, it cannot be collected via USE.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  #    b. Check if the primitive is already in the agent's inventory.\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 3. Retrieve grid dimensions for boundary checks.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a position and orientation from which the primitive can be collected via USE.\n  # BFS state: ((current_x, current_y), current_direction)\n  # visited: {state_tuple: (parent_state_tuple, action_taken_to_reach_state)}\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  start_state_tuple = (start_pos, start_dir)\n\n  queue = [start_state_tuple] \n  visited = {start_state_tuple: (None, None)} # (parent_state, action_from_parent_to_current)\n\n  target_use_state = None # To store the state from which USE can be applied\n\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.pop(0) # Dequeue for BFS\n\n    # Calculate the coordinates of the cell directly in front of the agent,\n    # which is the target for the USE action.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # Check if the cell in front is within bounds and contains the primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      # Found a state where the agent can perform USE to collect the primitive.\n      target_use_state = ((curr_x, curr_y), curr_dir)\n      break # Path found, exit BFS loop\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement after moving\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet\n      if next_state_tuple not in visited:\n        visited[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action)\n        queue.append(next_state_tuple)\n\n  if target_use_state is None:\n    return [] # If the queue becomes empty and no path was found, the primitive is unreachable.\n\n  # Reconstruct the path by backtracking from the target_use_state to the start_state\n  path_actions = []\n  current_reconstruction_state = target_use_state\n  \n  # Loop until we reach the starting state, which has (None, None) as its parent\n  while visited[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = visited[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  # The path was built in reverse order, so reverse it to get the correct sequence\n  path_actions.reverse()\n  \n  # Add the final USE action to the collected path\n  return path_actions + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:36:17.010772", "function_name": "collect", "function_body": "  from collections import deque\n  import heapq\n\n  # Constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  DIRECTION_TO_DELTA = {\n      DIR_UP: (0, -1),   # (dx, dy)\n      DIR_RIGHT: (1, 0),\n      DIR_DOWN: (0, 1),\n      DIR_LEFT: (-1, 0),\n  }\n\n  MOVE_ACTION_TO_DIRECTION = {\n      UP: DIR_UP,\n      RIGHT: DIR_RIGHT,\n      DOWN: DIR_DOWN,\n      LEFT: DIR_LEFT,\n  }\n\n  # Relative offsets for 3x3 neighborhood around the agent's position\n  NEIGHBORHOOD_OFFSETS_3x3 = [\n      (dx, dy) for dx in [-1, 0, 1] for dy in [-1, 0, 1]\n  ]\n\n  # Relative offsets for adjacent cells (e.g., for harvesting actions where agent faces a block)\n  ADJACENT_OFFSETS = [\n      (-1, 0), (1, 0), (0, -1), (0, 1) # left, right, up, down relative to agent\n  ]\n\n  # Map relative delta from agent to target to the required agent direction\n  # E.g., if target is at (1,0) relative to agent, agent must face RIGHT (DIR_RIGHT)\n  DELTA_TO_DIR = {\n      (0, -1): DIR_UP,\n      (0, 1): DIR_DOWN,\n      (-1, 0): DIR_LEFT,\n      (1, 0): DIR_RIGHT,\n  }\n\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  initial_dir = np.argmax(obs['features_dict']['direction'])\n\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n\n  W, H, K = grid.shape\n\n  # Create a mask for traversable cells (cells not containing non-grabbable items)\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for idx in non_grabbable_indices:\n      traversable_mask[grid[:, :, idx] > 0] = False\n\n  # If the agent starts on an untraversable cell, no path is possible.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return []\n\n  # Define specific item indices that can be collected via USE action.\n  # This includes the primitive itself (if it's an item on the ground) and source blocks.\n  direct_pickup_indices = {primitive} # e.g., 'water' item on the ground\n  harvest_source_indices = set() # e.g., 'water_block' for 'water' item\n\n  primitive_name = world.cookbook.index.get(primitive)\n  if primitive_name == 'water':\n      harvest_source_indices.add(world.water_index)\n  elif primitive_name == 'stone':\n      harvest_source_indices.add(world.stone_index)\n  # Add more specific mappings if needed (e.g., 'wood' from a 'tree' block)\n\n  # Generate the set of valid (agent_pos_x, agent_pos_y, agent_dir) states\n  # from which the `USE` action can successfully collect the primitive.\n  primitive_target_states = set()\n\n  for ax in range(W):\n      for ay in range(H):\n          if not traversable_mask[ax, ay]:\n              continue # Agent cannot stand on this cell\n\n          # Check for direct pickup: if the primitive item (or another direct_pickup_index)\n          # is present in the 3x3 neighborhood of (ax, ay).\n          # According to CraftState.next_to, USE works on anything in the 3x3.\n          found_direct_pickup = False\n          for dx, dy in NEIGHBORHOOD_OFFSETS_3x3:\n              nx, ny = ax + dx, ay + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  for item_idx in direct_pickup_indices:\n                      if grid[nx, ny, item_idx] > 0:\n                          # If a direct pickup item is found, then (ax,ay) is a valid\n                          # collection point for any agent direction.\n                          for dir_val in [DIR_UP, DIR_RIGHT, DIR_DOWN, DIR_LEFT]:\n                              primitive_target_states.add((ax, ay, dir_val))\n                          found_direct_pickup = True\n                          break\n              if found_direct_pickup:\n                  break\n          \n          # Check for harvesting from source blocks: if a harvest_source_index\n          # is present in an adjacent cell, and the agent is facing it.\n          # This assumes harvest operations require facing the source block.\n          for dx, dy in ADJACENT_OFFSETS: # Relative position of source block to agent\n              nx, ny = ax + dx, ay + dy # Position of source block\n              if 0 <= nx < W and 0 <= ny < H:\n                  for source_idx in harvest_source_indices:\n                      if grid[nx, ny, source_idx] > 0:\n                          # Source block (nx,ny) is adjacent. Agent at (ax,ay) needs to face it.\n                          # The vector from agent to source is (nx-ax, ny-ay) = (dx, dy)\n                          required_dir = DELTA_TO_DIR.get((dx, dy))\n                          if required_dir is not None:\n                              primitive_target_states.add((ax, ay, required_dir))\n                          break # No need to check other sources for this (ax,ay)\n\n\n  # Heuristic function for A*: Manhattan distance to the closest target position.\n  # This is admissible as it never overestimates the true cost.\n  def heuristic(x, y, direction):\n      min_h = float('inf')\n      if not primitive_target_states:\n          return min_h # No target states found, return infinite cost\n\n      # Consider only the positional part of the target states for Manhattan distance\n      target_positions = {(tx, ty) for tx, ty, tdir in primitive_target_states}\n      \n      for tx, ty in target_positions:\n          h_val = abs(x - tx) + abs(y - ty)\n          min_h = min(min_h, h_val)\n      return min_h\n\n  # A* search data structures\n  # g_score: cost from start node to current node (pos_x, pos_y, dir)\n  # f_score: g_score + heuristic_cost_estimate\n  g_score = {}\n  f_score = {}\n\n  start_state = (current_pos_x, current_pos_y, initial_dir)\n  g_score[start_state] = 0\n  f_score[start_state] = heuristic(current_pos_x, current_pos_y, initial_dir)\n\n  # Priority queue: (f_score, g_score, (pos_x, pos_y, dir), actions_so_far)\n  # g_score is included for tie-breaking in heap if f_scores are equal (prefer shorter paths)\n  open_set = [(f_score[start_state], 0, start_state, [])]\n\n  while open_set:\n      # Get the state with the lowest f_score\n      current_f, current_g, (curr_x, curr_y, curr_dir), actions_so_far = heapq.heappop(open_set)\n\n      # If we've already found a shorter path to this state, skip\n      if current_g > g_score.get((curr_x, curr_y, curr_dir), float('inf')):\n          continue\n\n      # Goal check: Is the current state one from which the primitive can be collected?\n      if (curr_x, curr_y, curr_dir) in primitive_target_states:\n          return actions_so_far + [USE]\n\n      # Explore possible next states by taking movement actions\n      for action_val in [UP, DOWN, LEFT, RIGHT]:\n          # After taking a movement action, the agent's direction changes to match the movement.\n          next_dir = MOVE_ACTION_TO_DIRECTION[action_val]\n          \n          # Calculate the new position based on the new direction (move one step)\n          dx, dy = DIRECTION_TO_DELTA[next_dir]\n          next_x, next_y = curr_x + dx, curr_y + dy\n          \n          # Check if the next cell is within bounds and is traversable\n          if (0 <= next_x < W and 0 <= next_y < H and\n              traversable_mask[next_x, next_y]):\n              \n              new_g_score = current_g + 1 # Each action costs 1\n              next_state = (next_x, next_y, next_dir)\n\n              # If this path to next_state is shorter than any previously found path\n              if new_g_score < g_score.get(next_state, float('inf')):\n                  g_score[next_state] = new_g_score\n                  f_score[next_state] = new_g_score + heuristic(next_x, next_y, next_dir)\n                  heapq.heappush(open_set, (f_score[next_state], new_g_score, next_state, actions_so_far + [action_val]))\n\n  # If the open set becomes empty and no path to a primitive was found\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:36:17.081065", "function_name": "collect", "function_body": "    from collections import deque\n    import heapq\n\n    # Constants (re-defined locally for self-containment within the function context)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    DIR_UP = 0    # Facing North (typically -Y)\n    DIR_RIGHT = 1 # Facing East (typically +X)\n    DIR_DOWN = 2  # Facing South (typically +Y)\n    DIR_LEFT = 3  # Facing West (typically -X)\n\n    # (dx, dy) for moving one step in a given direction, or for determining the cell in front\n    DIRECTION_TO_DELTA = {\n        DIR_UP: (0, -1),   # (dx, dy)\n        DIR_RIGHT: (1, 0),\n        DIR_DOWN: (0, 1),\n        DIR_LEFT: (-1, 0),\n    }\n\n    # Mapping move actions to the resulting agent direction after the move\n    MOVE_ACTION_TO_DIRECTION = {\n        UP: DIR_UP,\n        RIGHT: DIR_RIGHT,\n        DOWN: DIR_DOWN,\n        LEFT: DIR_LEFT,\n    }\n\n    # Offsets for 4-directional adjacency (e.g., for an agent standing next to an item)\n    ADJACENT_OFFSETS = [\n        (0, -1),  # North\n        (1, 0),   # East\n        (0, 1),   # South\n        (-1, 0),  # West\n    ]\n\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n    initial_dir = np.argmax(obs['features_dict']['direction'])\n\n    world = env.world\n    # Indices for non-grabbable items that act as obstacles for agent movement\n    non_grabbable_indices = world.non_grabbable_indices\n\n    W, H, K = grid.shape\n\n    # 1. Determine traversable cells (where the agent can move)\n    traversable_mask = np.ones((W, H), dtype=bool)\n    for idx in non_grabbable_indices:\n        # Any cell containing a non-grabbable item is marked as non-traversable\n        traversable_mask[grid[:, :, idx] > 0] = False\n\n    # Edge case: If the agent's starting position is not traversable, no path is possible.\n    if not traversable_mask[current_pos_x, current_pos_y]:\n        return []\n\n    # 2. Identify the specific grid kind index that represents the source for the target primitive.\n    # A primitive can either be picked up directly if it's on the ground, or harvested from a source block.\n    primitive_name = world.cookbook.index.get(primitive)\n    \n    # Default source is the primitive itself (for direct pickup).\n    collectible_source_kind_index = primitive \n\n    # Override if the primitive has a dedicated harvestable source block.\n    if primitive_name == 'water':\n        collectible_source_kind_index = world.water_index\n    elif primitive_name == 'stone':\n        collectible_source_kind_index = world.stone_index\n    # Add more `elif` conditions here for other primitives that come from specific environment blocks.\n\n    # 3. Find all physical locations on the grid that contain the determined source kind.\n    # These are the (px, py) coordinates of the actual item or resource block.\n    item_source_locations = [] # List of (px, py) tuples\n    for px in range(W):\n        for py in range(H):\n            # If the cell contains the collectible source kind, it's a target for USE.\n            if grid[px, py, collectible_source_kind_index] > 0:\n                item_source_locations.append((px, py))\n    \n    # If no source for the primitive is found on the map, no collection path exists.\n    if not item_source_locations:\n        return []\n\n    # 4. Generate 'primitive_target_states' for the A* search.\n    # These are (agent_x, agent_y, agent_direction) states from which a 'USE' action\n    # would successfully collect the primitive. A 'USE' action is assumed to act\n    # on the cell directly in front of the agent.\n    primitive_target_states = set()\n    for item_px, item_py in item_source_locations:\n        # Check all 4 adjacent positions around the item for potential agent locations\n        for dx_adj, dy_adj in ADJACENT_OFFSETS:\n            ax, ay = item_px + dx_adj, item_py + dy_adj\n\n            # Check if this potential agent position is within bounds and traversable\n            if not (0 <= ax < W and 0 <= ay < H and traversable_mask[ax, ay]):\n                continue\n\n            # Determine the direction the agent must face from (ax, ay) to interact with (item_px, item_py)\n            # This is the vector from the agent's position to the item's position.\n            face_dx, face_dy = item_px - ax, item_py - ay\n            \n            required_agent_dir = -1\n            for d_val, (delta_x, delta_y) in DIRECTION_TO_DELTA.items():\n                if delta_x == face_dx and delta_y == face_dy:\n                    required_agent_dir = d_val\n                    break\n            \n            # If a valid facing direction is found, add this (position, direction) state to targets.\n            if required_agent_dir != -1:\n                primitive_target_states.add((ax, ay, required_agent_dir))\n    \n    # If no valid agent target states (position + direction) can be formed for any source.\n    if not primitive_target_states:\n        return []\n\n    # 5. A* search implementation\n    # Heuristic function: Manhattan distance from current agent position to the closest item source location.\n    # This heuristic is admissible as it never overestimates the actual cost.\n    def heuristic(x, y, current_dir): # `current_dir` is not used in this specific heuristic, which is fine.\n        min_h = float('inf')\n        for px, py in item_source_locations:\n            h_val = abs(x - px) + abs(y - py)\n            min_h = min(min_h, h_val)\n        return min_h\n\n    # g_score: actual cost from the start node to the current node (state: pos_x, pos_y, dir)\n    g_score = {}\n    # f_score: estimated total cost from start to goal via the current node (g_score + heuristic)\n    f_score = {}\n\n    start_state = (current_pos_x, current_pos_y, initial_dir)\n    g_score[start_state] = 0\n    f_score[start_state] = heuristic(current_pos_x, current_pos_y, initial_dir)\n\n    # Priority queue: (f_score, g_score, state_tuple, list_of_actions_so_far)\n    # g_score is included as a tie-breaker for states with identical f_score, preferring shorter paths.\n    open_set = [(f_score[start_state], g_score[start_state], start_state, [])]\n\n    while open_set:\n        # Retrieve the state with the lowest f_score (and then lowest g_score for tie-breaking)\n        current_f, current_g, (curr_x, curr_y, curr_dir), actions_so_far = heapq.heappop(open_set)\n\n        # If we've already found a shorter path to this state, skip processing it.\n        if current_g > g_score.get((curr_x, curr_y, curr_dir), float('inf')):\n            continue\n\n        # Goal check: If the current state is one from which the primitive can be collected.\n        if (curr_x, curr_y, curr_dir) in primitive_target_states:\n            return actions_so_far + [USE] # Append the USE action and return the path.\n\n        # Explore possible next states by taking movement actions (UP, DOWN, LEFT, RIGHT)\n        for action_val in [UP, DOWN, LEFT, RIGHT]:\n            # When a movement action is taken, the agent's direction changes to match the direction of movement.\n            next_dir = MOVE_ACTION_TO_DIRECTION[action_val]\n            \n            # Calculate the new position after moving one step in the `next_dir`.\n            dx, dy = DIRECTION_TO_DELTA[next_dir]\n            next_x, next_y = curr_x + dx, curr_y + dy\n            \n            # Check if the calculated next cell is within grid bounds and is traversable.\n            if (0 <= next_x < W and 0 <= next_y < H and\n                traversable_mask[next_x, next_y]):\n                \n                new_g_score = current_g + 1 # Each movement action costs 1 unit.\n                next_state = (next_x, next_y, next_dir)\n\n                # If this path to `next_state` is shorter than any previously found path to it.\n                if new_g_score < g_score.get(next_state, float('inf')):\n                    g_score[next_state] = new_g_score\n                    f_score[next_state] = new_g_score + heuristic(next_x, next_y, next_dir)\n                    # Add the new state to the priority queue with its estimated total cost and path.\n                    heapq.heappush(open_set, (f_score[next_state], new_g_score, next_state, actions_so_far + [action_val]))\n\n    # If the `open_set` becomes empty and no path to a `primitive_target_state` was found,\n    # it means the primitive is unreachable.\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:37:29.686939", "function_name": "collect", "function_body": "  # Access the current state from the environment\n  # Assuming `env` is a CraftLab instance and `_current_state` is accessible.\n  current_state = env._current_state\n\n  # Check if the primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n    return []  # Primitive is already collected\n\n  # Find the primitive on the grid\n  target_pos = None\n  grid_width, grid_height, _ = current_state.grid.shape\n  agent_r, agent_c = current_state.pos\n  \n  min_dist = float('inf')\n\n  # Iterate through the grid to find the closest primitive\n  for r in range(grid_width):\n    for c in range(grid_height):\n      # Check if this cell contains the primitive\n      if current_state.grid[r, c, primitive] > 0:\n        # Calculate Manhattan distance to prioritize closer items\n        dist = abs(r - agent_r) + abs(c - agent_c)\n        if dist < min_dist:\n          min_dist = dist\n          target_pos = (r, c)\n  \n  if target_pos is None:\n    # Primitive not found on the grid\n    return []\n\n  # Generate actions to move to the target position\n  actions = []\n  \n  target_r, target_c = target_pos\n\n  # Move vertically (row-wise) first\n  dr = target_r - agent_r\n  if dr > 0:  # Need to move DOWN\n    for _ in range(dr):\n      actions.append(0)  # DOWN action (0)\n  elif dr < 0:  # Need to move UP\n    for _ in range(abs(dr)):\n      actions.append(1)  # UP action (1)\n\n  # Move horizontally (column-wise) next\n  dc = target_c - agent_c\n  if dc > 0:  # Need to move RIGHT\n    for _ in range(dc):\n      actions.append(3)  # RIGHT action (3)\n  elif dc < 0:  # Need to move LEFT\n    for _ in range(abs(dc)):\n      actions.append(2)  # LEFT action (2)\n  \n  # After moving to the target position, use the item (collect it)\n  # The agent is now at (target_r, target_c), which is where the primitive is.\n  # The CraftState.next_to function (checking 3x3 neighborhood) would include the\n  # current cell, so 'USE' should be effective here.\n  actions.append(4)  # USE action (4)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:37:30.650429", "function_name": "collect", "function_body": "  import collections\n\n  # 1. Get initial state and action mappings\n  obs = env.observations()\n  initial_grid = obs['features_dict']['features_global']\n  initial_pos = obs['features_dict']['pos']\n  initial_inventory = obs['features_dict']['inventory']\n\n  # If the primitive is already collected, no actions needed\n  if initial_inventory[primitive] > 0:\n      return []\n\n  action_map = env.action_specs()\n  UP_ACTION = action_map['up']\n  DOWN_ACTION = action_map['down']\n  LEFT_ACTION = action_map['left']\n  RIGHT_ACTION = action_map['right']\n  USE_ACTION = action_map['use']\n\n  # Define movement offsets for (dx, dy)\n  # Assumes (0,0) is top-left, +x is right, +y is down\n  moves = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  grid_width, grid_height, _ = initial_grid.shape\n\n  # 2. Find all locations of the primitive\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if initial_grid[x, y, primitive] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # Primitive not found in the initial grid\n      return []\n\n  # BFS setup\n  # Queue stores (current_position_tuple, list_of_actions_to_reach_here)\n  queue = collections.deque([(initial_pos, [])])\n  # Visited set stores positions to avoid cycles and redundant paths\n  visited = {initial_pos}\n\n  # BFS to find the shortest path to *any* cell adjacent to *any* primitive\n  while queue:\n      (curr_x, curr_y), actions = queue.popleft()\n\n      # Check if current position is adjacent to any primitive location\n      for px, py in primitive_locations:\n          # Manhattan distance check for adjacency (1 unit away)\n          if abs(curr_x - px) + abs(curr_y - py) == 1:\n              # If agent is adjacent to a primitive, add the USE action and return the path\n              return actions + [USE_ACTION]\n          # Special case: If agent starts *on* the primitive, and USE works on the current square.\n          # However, CraftState.next_to excludes current cell. So this relies on `USE` having\n          # separate logic for current cell, or requires moving off then back.\n          # Sticking to adjacency based on `next_to` definition.\n          # if curr_x == px and curr_y == py and initial_grid[px, py, primitive] > 0:\n          #     return actions + [USE_ACTION]\n\n      # Explore possible moves\n      for action_id, (dx, dy) in moves.items():\n          new_x, new_y = curr_x + dx, curr_y + dy\n          new_pos = (new_x, new_y)\n\n          # Check if the new position is within grid bounds\n          if 0 <= new_x < grid_width and 0 <= new_y < grid_height:\n              # Check if the new position has been visited\n              if new_pos not in visited:\n                  visited.add(new_pos)\n                  queue.append((new_pos, actions + [action_id]))\n\n  # If no path to an adjacent primitive location is found after exploring all reachable cells\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:39:03.481246", "function_name": "collect", "function_body": "    # It is assumed that 'collections' and 'numpy' are already imported\n    # as 'collections' and 'np' respectively in the global scope.\n\n    # Define action constants inside the function for self-containment.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Direction mappings (assuming 0:N, 1:E, 2:S, 3:W)\n    # _DIR_TO_DXDY_XY[direction_index] = (dx, dy) relative to current pos.\n    # x increases right, y increases down.\n    _DIR_TO_DXDY_XY = {\n        0: (0, -1),  # UP (N)\n        1: (1, 0),   # RIGHT (E)\n        2: (0, 1),   # DOWN (S)\n        3: (-1, 0)   # LEFT (W)\n    }\n\n    # Mapping from move action to (dx, dy, new_facing_direction).\n    # A move action implicitly makes the agent face that direction.\n    _MOVE_EFFECTS = {\n        ACTION_UP:    (0, -1, 0),  # dx, dy, new_dir (0: UP)\n        ACTION_RIGHT: (1, 0, 1),   # dx, dy, new_dir (1: RIGHT)\n        ACTION_DOWN:  (0, 1, 2),   # dx, dy, new_dir (2: DOWN)\n        ACTION_LEFT:  (-1, 0, 3)   # dx, dy, new_dir (3: LEFT)\n    }\n\n    state = env._current_state\n    grid = state.grid\n    current_x, current_y = state.pos\n    initial_dir = state.dir # Agent's initial facing direction\n\n    grid_width, grid_height, _ = grid.shape\n\n    is_workshop = primitive in state.world.workshop_indices\n    is_grabbable = primitive in state.world.grabbable_indices\n\n    # BFS queue: (x_position, y_position, current_facing_direction, list_of_actions_to_reach_here)\n    q = collections.deque([(current_x, current_y, initial_dir, [])])\n    # Visited set to avoid cycles and redundant paths: (x, y, facing_direction)\n    visited = {(current_x, current_y, initial_dir)}\n\n    while q:\n        curr_x, curr_y, curr_dir, curr_actions = q.popleft()\n\n        # 1. Check for Goal at the current state (curr_x, curr_y, curr_dir)\n        if is_grabbable and grid[curr_x, curr_y, primitive] > 0:\n            # If the agent is on a grabbable item, it's collected by simply being there.\n            return curr_actions\n\n        if is_workshop:\n            # If the agent is at a position adjacent to and facing a workshop,\n            # performing a USE action will \"collect\" it.\n            face_dx, face_dy = _DIR_TO_DXDY_XY[curr_dir]\n            adj_x, adj_y = curr_x + face_dx, curr_y + face_dy\n\n            if (0 <= adj_x < grid_width and 0 <= adj_y < grid_height and\n                grid[adj_x, adj_y, primitive] > 0):\n                # Agent is adjacent to and facing the workshop. Use it.\n                return curr_actions + [ACTION_USE]\n\n        # 2. Explore Neighbors by performing move actions\n        for action, (dx, dy, new_dir) in _MOVE_EFFECTS.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_state_tuple = (next_x, next_y, new_dir)\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n                continue\n\n            # Check if this (position, direction) state has already been visited\n            if next_state_tuple in visited:\n                continue\n\n            # Check traversability:\n            # Agent cannot move onto cells occupied by non-grabbable environment items,\n            # unless the target primitive itself is a non-grabbable item (e.g., a workshop),\n            # in which case it still cannot move onto *that specific* cell.\n            is_blocked_by_obstacle = False\n            for k in state.world.non_grabbable_indices:\n                if grid[next_x, next_y, k] > 0:\n                    if k == primitive and is_workshop:\n                        # It's the target workshop, but workshops are non-grabbable.\n                        # Agent cannot move onto its cell.\n                        is_blocked_by_obstacle = True\n                        break\n                    elif k != primitive:\n                        # It's another non-grabbable obstacle (e.g., water, stone).\n                        # Agent cannot move onto this cell.\n                        is_blocked_by_obstacle = True\n                        break\n            \n            if is_blocked_by_obstacle:\n                continue\n\n            # If the path is clear, add the next state to the queue\n            visited.add(next_state_tuple)\n            q.append((next_x, next_y, new_dir, curr_actions + [action]))\n\n    # If the queue becomes empty and no path to the primitive was found, return an empty list.\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:39:04.493392", "function_name": "collect", "function_body": "  import collections\n\n  # 1. Check if primitive is already in inventory\n  initial_state = env._current_state\n  if initial_state.inventory[primitive] > 0:\n    return []\n\n  # BFS setup\n  q = collections.deque()\n\n  # Visited set: (position_tuple, direction_int, inventory_tuple, grid_tuple_flattened)\n  # The grid_tuple_flattened is crucial because picking up items changes the grid.\n  # Note: Flattening a large numpy array repeatedly can be slow for very large grids.\n  # For typical CraftWorld sizes, this should be acceptable for v2.\n  initial_grid_tuple = tuple(initial_state.grid.flatten())\n  initial_inventory_tuple = tuple(initial_state.inventory)\n\n  q.append((initial_state, []))  # (current_CraftState, path_taken_to_reach_this_state)\n  visited = set()\n  visited.add((initial_state.pos, initial_state.dir, initial_inventory_tuple, initial_grid_tuple))\n\n  # Define movement and use actions\n  movement_actions = [\n      env_factory.actions.DOWN,\n      env_factory.actions.UP,\n      env_factory.actions.LEFT,\n      env_factory.actions.RIGHT\n  ]\n  use_action = env_factory.actions.USE\n\n  # Ensure the primitive is actually grabbable. If not, it cannot be collected via USE.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  while q:\n    current_state, current_path = q.popleft()\n\n    # Check if we are adjacent to the primitive and can pick it up with USE\n    if current_state.next_to(primitive):\n      # Try the USE action\n      # Simulate the USE action from the current_state\n      _, next_state_after_use = current_state.step(use_action)\n\n      # Check if the primitive was successfully collected (inventory count increased)\n      if next_state_after_use.inventory[primitive] > current_state.inventory[primitive]:\n        # Goal achieved: primitive collected. Return the path including the USE action.\n        return current_path + [use_action]\n\n    # Explore movement actions\n    for action_val in movement_actions:\n      # Simulate the action to get the next state\n      _, next_state_move = current_state.step(action_val)\n\n      # Create a hashable representation of the next state for the visited set\n      next_grid_tuple = tuple(next_state_move.grid.flatten())\n      next_inventory_tuple = tuple(next_state_move.inventory)\n      next_state_tuple_for_visited = (\n          next_state_move.pos,\n          next_state_move.dir,\n          next_inventory_tuple,\n          next_grid_tuple\n      )\n\n      if next_state_tuple_for_visited not in visited:\n        visited.add(next_state_tuple_for_visited)\n        q.append((next_state_move, current_path + [action_val]))\n\n  # If the queue is exhausted and the primitive has not been collected, no path was found.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:40:50.703744", "function_name": "collect", "function_body": "  actions_taken = []\n  \n  # Maximum steps to try collecting (to prevent infinite loops in case of inaccessible items or complex worlds)\n  MAX_COLLECT_STEPS = 500\n\n  for step_count in range(MAX_COLLECT_STEPS):\n    current_state = env._current_state # Get the current state from the environment\n    \n    # Check if the primitive is already in the inventory\n    if current_state.inventory[primitive] > 0:\n        break # Goal achieved\n\n    # 1. Check if the primitive is in an adjacent cell (cardinal directions)\n    # If it is, try to face it and USE.\n    \n    agent_r, agent_c = current_state.pos\n    target_direction_code = -1 # 0:N, 1:E, 2:S, 3:W (for desired facing direction)\n\n    # Check North: (r-1, c)\n    if agent_r > 0 and current_state.grid[agent_r - 1, agent_c, primitive] > 0:\n        target_direction_code = 0\n    # Check East: (r, c+1)\n    elif agent_c < current_state.grid.shape[1] - 1 and current_state.grid[agent_r, agent_c + 1, primitive] > 0:\n        target_direction_code = 1\n    # Check South: (r+1, c)\n    elif agent_r < current_state.grid.shape[0] - 1 and current_state.grid[agent_r + 1, agent_c, primitive] > 0:\n        target_direction_code = 2\n    # Check West: (r, c-1)\n    elif agent_c > 0 and current_state.grid[agent_r, agent_c - 1, primitive] > 0:\n        target_direction_code = 3\n    \n    # If a collectible primitive is found in an adjacent cardinal direction\n    if target_direction_code != -1:\n        current_dir = current_state.dir\n        turns_needed = (target_direction_code - current_dir + 4) % 4\n        \n        # Perform turns to face the target\n        if turns_needed == 1: # Turn right\n            action_to_perform = env_factory.ACTION_RIGHT\n            actions_taken.append(action_to_perform)\n            env.step(action_to_perform)\n        elif turns_needed == 2: # Turn 180 degrees\n            action_to_perform = env_factory.ACTION_RIGHT # Can be LEFT too\n            actions_taken.extend([action_to_perform, action_to_perform])\n            env.step(action_to_perform)\n            env.step(action_to_perform)\n        elif turns_needed == 3: # Turn left\n            action_to_perform = env_factory.ACTION_LEFT\n            actions_taken.append(action_to_perform)\n            env.step(action_to_perform)\n        \n        # After turning (or if already facing), use the item\n        actions_taken.append(env_factory.ACTION_USE)\n        reward, done, obs = env.step(env_factory.ACTION_USE)\n        \n        # Re-check inventory as the state might have updated\n        if env._current_state.inventory[primitive] > 0:\n            break # Collected successfully\n    \n    else: # Primitive is not directly adjacent (or not found in cardinal directions)\n        # Find all locations of the primitive on the entire grid\n        primitive_locations = np.argwhere(current_state.grid[:, :, primitive] > 0)\n        \n        if len(primitive_locations) > 0:\n            # Find the closest primitive location using Manhattan distance\n            min_dist = float('inf')\n            closest_r, closest_c = -1, -1\n            \n            for r, c in primitive_locations:\n                dist = abs(r - agent_r) + abs(c - agent_c)\n                if dist < min_dist:\n                    min_dist = dist\n                    closest_r, closest_c = r, c\n            \n            # If the closest primitive is the agent's current cell, and not collected, something is wrong.\n            # Assuming for `primitive` that it's grabbable and should have been in inventory.\n            if closest_r == agent_r and closest_c == agent_c:\n                print(f\"Warning: Primitive {primitive} at agent's location but not collected (implies ungrabbable or logic error).\")\n                break # Exit to prevent infinite loop or unresolvable state\n            \n            # Determine movement direction (dr, dc) to reach the closest primitive\n            dr = closest_r - agent_r\n            dc = closest_c - agent_c\n            \n            current_dir = current_state.dir # 0:N, 1:E, 2:S, 3:W\n\n            # Determine desired cardinal direction to move (N, E, S, W)\n            # Prioritize moving along the axis with the largest difference, or vertical if equal\n            desired_dir_for_move = -1\n            if dr != 0: # Prefer vertical movement if needed\n                desired_dir_for_move = 0 if dr < 0 else 2 # North if dr<0, South if dr>0\n            elif dc != 0: # Otherwise, move horizontally if needed (if dr is 0)\n                desired_dir_for_move = 1 if dc > 0 else 3 # East if dc>0, West if dc<0\n            \n            if desired_dir_for_move != -1: # A valid direction to move was found\n                turns_to_face = (desired_dir_for_move - current_dir + 4) % 4\n                \n                actions_this_turn_and_move = []\n                if turns_to_face == 1: # Turn right\n                    actions_this_turn_and_move.append(env_factory.ACTION_RIGHT)\n                elif turns_to_face == 2: # Turn 180 degrees\n                    actions_this_turn_and_move.extend([env_factory.ACTION_RIGHT, env_factory.ACTION_RIGHT])\n                elif turns_to_face == 3: # Turn left\n                    actions_this_turn_and_move.append(env_factory.ACTION_LEFT)\n                \n                # After turning (or if already facing), always try to move forward\n                actions_this_turn_and_move.append(env_factory.ACTION_UP)\n\n                # Execute the planned turn(s) and move\n                for action in actions_this_turn_and_move:\n                    actions_taken.append(action)\n                    reward, done, obs = env.step(action)\n                    # Check inventory after each action in case a primitive is collected\n                    if env._current_state.inventory[primitive] > 0:\n                        return actions_taken # Collected during movement\n            else:\n                # This should only happen if dr=0 and dc=0, which is handled above.\n                # If it falls here, it implies a logic error or no path.\n                print(\"ERROR: No valid movement direction could be determined despite primitive being found.\")\n                break # Break to avoid infinite loop\n\n        else: # Primitive not found anywhere on the grid\n            print(f\"Primitive {primitive} not found on the grid after {step_count} steps. Aborting collection attempt.\")\n            break # Exit loop, primitive cannot be found\n\n  return actions_taken", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:40:50.772663", "function_name": "collect", "function_body": "    actions = []\n\n    # Get current observations from the environment\n    obs = env.observations()\n    current_grid = obs['features_dict']['features_global']\n    \n    # Agent's current position (row, column)\n    current_pos_r, current_pos_c = int(obs['features_dict']['pos'][0]), int(obs['features_dict']['pos'][1])\n\n    # Dimensions of the grid\n    grid_rows, grid_cols, _ = current_grid.shape\n\n    # 1. Find the closest instance of the primitive on the grid\n    min_dist = float('inf')\n    target_r, target_c = -1, -1  # Initialize with invalid coordinates\n\n    for r in range(grid_rows):\n        for c in range(grid_cols):\n            # Check if the current cell contains the primitive\n            if current_grid[r, c, primitive] == 1:\n                # Calculate Manhattan distance to this primitive instance\n                dist = abs(r - current_pos_r) + abs(c - current_pos_c)\n                if dist < min_dist:\n                    min_dist = dist\n                    target_r, target_c = r, c\n\n    # If the primitive was not found on the grid, return an empty list of actions\n    if target_r == -1:\n        return []\n\n    # 2. Generate a sequence of actions to move the agent to the target cell\n    # Simulate agent's position during path generation\n    temp_r, temp_c = current_pos_r, current_pos_c\n\n    # First, move vertically (adjust row)\n    while temp_r != target_r:\n        if temp_r < target_r:\n            actions.append(0)  # ACTION_DOWN (increase row index)\n            temp_r += 1\n        else:  # temp_r > target_r\n            actions.append(1)  # ACTION_UP (decrease row index)\n            temp_r -= 1\n\n    # Then, move horizontally (adjust column)\n    while temp_c != target_c:\n        if temp_c < target_c:\n            actions.append(3)  # ACTION_RIGHT (increase column index)\n            temp_c += 1\n        else:  # temp_c > target_c\n            actions.append(2)  # ACTION_LEFT (decrease column index)\n            temp_c -= 1\n\n    # 3. Add the 'USE' action to collect the primitive\n    # It is assumed that 'primitives' are grabbable items collected by being on their cell and using 'USE'.\n    actions.append(4) # ACTION_USE\n\n    return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:42:15.101328", "function_name": "collect", "function_body": "    import collections\n\n    # Action constants (assuming they are defined as per action_specs)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Map direction constant to (dr, dc) for agent's facing direction\n    DIR_TO_DELTA = {\n        UP: (-1, 0),\n        DOWN: (1, 0),\n        LEFT: (0, -1),\n        RIGHT: (0, 1)\n    }\n\n    current_state = env._current_state\n    grid = current_state.grid\n    pos = current_state.pos\n    direc = current_state.dir\n    inventory = current_state.inventory\n    \n    # If the primitive is already in inventory, no actions are needed\n    if inventory[primitive] > 0:\n        return []\n\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # Find all locations where the primitive exists on the grid\n    primitive_locations = []\n    for r_idx in range(WIDTH):\n        for c_idx in range(HEIGHT):\n            if grid[r_idx, c_idx, primitive] > 0:\n                primitive_locations.append((r_idx, c_idx))\n\n    # If the primitive is not found anywhere on the map, it cannot be collected\n    if not primitive_locations:\n        return []\n\n    # BFS setup\n    # Queue stores tuples: ((current_row, current_col), current_direction, list_of_actions_taken)\n    queue = collections.deque([(pos, direc, [])])\n    # Visited set stores ((row, col), direction) to avoid cycles and redundant paths\n    visited = set([(pos, direc)])\n\n    best_path = None\n\n    # BFS loop to find the shortest path\n    while queue and best_path is None:\n        (r, c), d, path = queue.popleft()\n\n        # Check if the current state allows for using the primitive:\n        # Agent must be adjacent to a primitive and facing it.\n        # Calculate the cell directly in front of the agent\n        dr_front, dc_front = DIR_TO_DELTA[d]\n        front_r, front_c = r + dr_front, c + dc_front\n\n        # Check if the cell in front is within bounds and contains the desired primitive\n        if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n                grid[front_r, front_c, primitive] > 0):\n            best_path = path + [USE] # Found a path to collect the primitive\n            break # Exit BFS, as shortest path is found\n\n        # Explore possible move actions (UP, DOWN, LEFT, RIGHT)\n        for action in [UP, DOWN, LEFT, RIGHT]:\n            dr_move, dc_move = DIR_TO_DELTA[action]\n            new_r, new_c = r + dr_move, c + dc_move\n            new_d = action # Agent's new facing direction after this move action\n\n            # Check if new position is within grid boundaries\n            if not (0 <= new_r < WIDTH and 0 <= new_c < HEIGHT):\n                continue\n\n            # Check for obstacles at the new position\n            is_obstacle = False\n            # Obstacles include non-grabbable environment entities\n            for k_idx in current_state.world.cookbook.environment:\n                if grid[new_r, new_c, k_idx] > 0:\n                    is_obstacle = True\n                    break\n            \n            # The agent cannot move onto a cell that contains the primitive itself;\n            # it must stay on a clear cell and 'use' the adjacent primitive.\n            if grid[new_r, new_c, primitive] > 0:\n                is_obstacle = True\n            \n            if is_obstacle:\n                continue # Skip this move if the destination is an obstacle\n\n            # If the new state (position and direction) has not been visited, add it to the queue\n            if ((new_r, new_c), new_d) not in visited:\n                visited.add(((new_r, new_c), new_d))\n                queue.append(((new_r, new_c), new_d, path + [action]))\n    \n    return best_path if best_path is not None else []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:42:16.108347", "function_name": "collect", "function_body": "  # Define actions mapping based on CraftLab's action_specs\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  actions_taken = []\n  MAX_STEPS = 500  # Set a maximum number of steps to prevent infinite loops\n\n  # Reset the environment to get the initial state and observations\n  obs = env.reset()\n\n  for step_num in range(MAX_STEPS):\n    # Access the current state representation from the environment\n    current_state = env._current_state\n\n    # 1. Check if the primitive is already collected (in inventory)\n    if current_state.inventory[primitive] > 0:\n      return actions_taken\n\n    # 2. Check if the agent is next to the primitive, and if so, USE it\n    if current_state.next_to(primitive):\n      action = USE\n      _, done, obs = env.step(action)\n      actions_taken.append(action)\n      if done:\n        # If the episode ends immediately after collection, return\n        if current_state.inventory[primitive] > 0:\n          return actions_taken\n        break # Episode ended for another reason\n      continue # Skip to the next iteration after taking USE action\n\n    # 3. If not collected and not next to it, find the primitive on the grid\n    #    and determine an action to move closer.\n    grid = obs['features_dict']['features_global']\n    agent_pos = current_state.pos # Agent's current (row, col)\n\n    # Find all locations where the primitive exists on the grid\n    primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n\n    chosen_action = None\n    if len(primitive_locations) > 0:\n      # Find the closest primitive location using Manhattan distance\n      min_dist = float('inf')\n      closest_primitive_pos = None\n\n      for p_loc in primitive_locations:\n        dist = abs(p_loc[0] - agent_pos[0]) + abs(p_loc[1] - agent_pos[1])\n        if dist < min_dist:\n          min_dist = dist\n          closest_primitive_pos = p_loc\n\n      if closest_primitive_pos is not None:\n        target_r, target_c = closest_primitive_pos\n        current_r, current_c = agent_pos\n\n        dr = target_r - current_r\n        dc = target_c - current_c\n\n        # Prioritize movement along the axis with the larger difference\n        if abs(dr) > abs(dc):\n          if dr > 0: chosen_action = DOWN\n          elif dr < 0: chosen_action = UP\n        else: # abs(dc) >= abs(dr)\n          if dc > 0: chosen_action = RIGHT\n          elif dc < 0: chosen_action = LEFT\n    \n    # 4. If no specific action was chosen (e.g., no primitive visible, or stuck),\n    #    then perform a simple exploratory move (cycle through directions).\n    if chosen_action is None:\n      possible_moves = [DOWN, UP, LEFT, RIGHT]\n      chosen_action = possible_moves[step_num % len(possible_moves)]\n\n    # Take the determined action\n    if chosen_action is not None:\n      _, done, obs = env.step(chosen_action)\n      actions_taken.append(chosen_action)\n      if done: # If the episode ends for any other reason\n        break\n    else:\n      # Should not be reached with current logic, but as a safeguard\n      break \n\n  # Return the list of actions taken, even if the goal was not reached\n  return actions_taken", "island_id": 0, "scores": {"3": -1}}
