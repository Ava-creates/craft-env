{"timestamp": "2025-07-30T19:01:29.881603", "function_name": "collect", "function_body": "    # Define action constants (assuming these mappings from CraftLab.action_specs)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Map (dx, dy) to action for movement\n    MOVE_ACTIONS = {\n        (0, -1): ACTION_UP,   # Move up: (x, y-1)\n        (0, 1): ACTION_DOWN,  # Move down: (x, y+1)\n        (-1, 0): ACTION_LEFT, # Move left: (x-1, y)\n        (1, 0): ACTION_RIGHT  # Move right: (x+1, y)\n    }\n\n    # Directions for neighbors (dx, dy) for BFS exploration\n    DELTAS = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Corresponding to Down, Up, Right, Left\n\n    actions = []\n    \n    # Get initial observations to check inventory and world context\n    # Resetting the environment ensures a consistent starting point for the collection task.\n    obs = env.reset() \n    \n    # Check if the primitive is already in the inventory\n    if obs['features_dict']['inventory'][primitive] > 0:\n        return [] # Primitive already collected, no actions needed\n\n    # Maximum iterations for the overall collection process to prevent infinite loops\n    MAX_OVERALL_STEPS = 500 \n\n    # Define the BFS helper function as a closure within collect_v2.\n    # It needs access to constants (ACTION_*, MOVE_ACTIONS, DELTAS),\n    # and to the CraftState class (available globally).\n    def bfs_find_path_to_use_position(start_pos, target_kind, current_grid, non_grabbable_indices, max_path_length=MAX_OVERALL_STEPS):\n        \"\"\"\n        Finds the shortest path from start_pos to any position from which the target_kind\n        can be collected (i.e., a position where CraftState.next_to(target_kind) would be true).\n        Returns a list of actions (integers) to reach that position, or None if no path is found.\n        \"\"\"\n        import collections # collections is assumed to be imported at module level\n        \n        queue = collections.deque([(start_pos, [])]) # (position, path_actions_to_this_pos)\n        visited = {start_pos} # Set of visited (x, y) coordinates\n\n        grid_height, grid_width, _ = current_grid.shape\n\n        while queue:\n            current_p, current_path = queue.popleft()\n\n            # Create a temporary CraftState instance to check if an agent at current_p\n            # would be in a valid position to 'USE' the primitive.\n            # CraftState requires scenario, grid, pos, dir, inventory.\n            # We can get scenario, dir, and inventory from the *current* env._current_state.\n            temp_state_for_check = CraftState(\n                scenario=env._current_state.scenario, \n                grid=current_grid,\n                pos=current_p,\n                dir=env._current_state.dir, \n                inventory=env._current_state.inventory \n            )\n            \n            # Check if this position `current_p` allows 'USE' for the primitive.\n            # CraftState.next_to checks the 3x3 neighborhood, including the agent's current cell.\n            if temp_state_for_check.next_to(target_kind):\n                return current_path # Found a valid path to a 'use' position!\n\n            # Limit path length to prevent excessively long searches\n            if len(current_path) >= max_path_length:\n                continue\n\n            # Explore neighbors (up, down, left, right)\n            for dx, dy in DELTAS:\n                next_x, next_y = current_p[0] + dx, current_p[1] + dy\n                next_pos = (next_x, next_y)\n\n                # Check grid boundaries\n                if not (0 <= next_x < grid_height and 0 <= next_y < grid_width):\n                    continue\n                \n                # Check traversability: A cell is considered blocked if it contains any\n                # non-grabbable item (e.g., walls, water), *unless* that item is the target_kind itself.\n                # Agents typically can move onto a primitive and then collect it.\n                is_blocked = False\n                for kind_idx in range(current_grid.shape[2]): # Iterate through all entity kinds at next_pos\n                    if current_grid[next_x, next_y, kind_idx] == 1: # If this kind is present at next_pos\n                        if kind_idx in non_grabbable_indices and kind_idx != target_kind:\n                            is_blocked = True # This cell contains a non-traversable obstacle\n                            break \n                \n                if is_blocked:\n                    continue # Skip this blocked cell\n\n                # If not visited, add to queue\n                if next_pos not in visited:\n                    visited.add(next_pos)\n                    next_actions = current_path + [MOVE_ACTIONS[(dx, dy)]]\n                    queue.append((next_pos, next_actions))\n        \n        return None # No path found to any valid 'use' position\n\n    # Main collection loop\n    for _ in range(MAX_OVERALL_STEPS):\n        current_state = env._current_state\n        current_inventory = current_state.inventory\n        current_grid = current_state.grid\n        current_pos = current_state.pos\n        \n        # Check if primitive has been collected (e.g., after a USE action in a previous iteration)\n        if current_inventory[primitive] > 0:\n            return actions # Successfully collected!\n\n        # If agent is currently in a position to 'USE' the primitive, try to do so.\n        if current_state.next_to(primitive):\n            _, done, obs = env.step(ACTION_USE)\n            actions.append(ACTION_USE)\n            \n            # Check if collection was successful after the USE action\n            if obs['features_dict']['inventory'][primitive] > 0:\n                return actions # Successfully collected!\n            \n            # If not collected but environment indicates 'done' (e.g., max steps reached, agent died)\n            if done:\n                return [] # Cannot collect\n            \n            # If not collected and not done, it means USE failed (e.g., needed multiple uses,\n            # or it wasn't pickable despite being next to it). Continue to next iteration,\n            # which might re-evaluate the path or try USE again.\n            continue \n\n        # If not in a 'use' position, find a path to one using BFS.\n        # non_grabbable_indices are part of the CraftWorld instance's cookbook.\n        non_grabbable_indices = env.world.cookbook.environment \n        path_found_actions = bfs_find_path_to_use_position(\n            current_pos,\n            primitive,\n            current_grid,\n            non_grabbable_indices\n        )\n\n        if path_found_actions is None:\n            # No path found. This means the primitive is unreachable or not present.\n            return []\n\n        # Execute the found path step by step\n        for action in path_found_actions:\n            _, done, obs = env.step(action)\n            actions.append(action)\n            \n            if done:\n                # If environment terminates during path execution, check if goal was met\n                if obs['features_dict']['inventory'][primitive] > 0:\n                    return actions\n                return [] # Game ended prematurely, goal not met\n\n            # After each step, reactively check if we are now next to the primitive.\n            # This allows short-circuiting path execution if the goal position is reached early,\n            # and then immediately attempting to USE in the next main loop iteration.\n            if env._current_state.next_to(primitive):\n                break # Break from this path execution loop to let the main loop handle ACTION_USE\n\n    # If the main loop completes (e.g., MAX_OVERALL_STEPS reached) without collecting the primitive\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:01:29.952852", "function_name": "collect", "function_body": "    import collections\n\n    # Define action constants from env_factory\n    UP = env_factory.UP\n    DOWN = env_factory.DOWN\n    LEFT = env_factory.LEFT\n    RIGHT = env_factory.RIGHT\n    USE = env_factory.USE\n\n    # Get current state information from the environment\n    current_state = env._current_state\n    grid = current_state.grid\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n    start_x, start_y = current_state.pos\n    start_dir = current_state.dir  # Agent's current facing direction (0, 1, 2, or 3)\n    \n    non_grabbable_indices = env.non_grabbable_indices\n\n    # Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Find the target primitive's location on the grid\n    target_x, target_y = None, None\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] == 1:\n                target_x, target_y = x, y\n                break\n        if target_x is not None:\n            break\n\n    # If the primitive is not found on the grid, return an empty path\n    if target_x is None:\n        return []\n\n    # Define how each movement action changes direction and position\n    # According to CraftState.step description:\n    # Action UP (env_factory.UP = 1) sets new_dir = 0, moves (0,1)\n    # Action RIGHT (env_factory.RIGHT = 3) sets new_dir = 1, moves (1,0)\n    # Action DOWN (env_factory.DOWN = 0) sets new_dir = 2, moves (0,-1)\n    # Action LEFT (env_factory.LEFT = 2) sets new_dir = 3, moves (-1,0)\n    action_to_new_dir_and_move_vec = {\n        UP: (0, (0, 1)),      # (new_direction_value, (dx, dy))\n        RIGHT: (1, (1, 0)),\n        DOWN: (2, (0, -1)),\n        LEFT: (3, (-1, 0))\n    }\n\n    # Define how direction values map to (dx, dy) vectors (useful for determining what's \"in front\")\n    dir_val_to_vec = {\n        0: (0, 1),   # UP direction (0) corresponds to vector (0,1)\n        1: (1, 0),   # RIGHT direction (1) corresponds to vector (1,0)\n        2: (0, -1),  # DOWN direction (2) corresponds to vector (0,-1)\n        3: (-1, 0)   # LEFT direction (3) corresponds to vector (-1,0)\n    }\n\n    # BFS setup: queue stores (current_x, current_y, current_direction, list_of_actions_taken)\n    queue = collections.deque([(start_x, start_y, start_dir, [])])\n    visited = set([(start_x, start_y, start_dir)]) # Set to store (x, y, dir) tuples to avoid cycles\n\n    while queue:\n        curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n        # Goal check: Is the target primitive directly in front of the agent?\n        # Calculate the coordinates of the cell directly in front of the agent\n        dx, dy = dir_val_to_vec[curr_dir]\n        facing_x, facing_y = curr_x + dx, curr_y + dy\n\n        if (facing_x, facing_y) == (target_x, target_y):\n            # Agent is in the correct position and facing the primitive,\n            # so the next action should be USE.\n            return path_actions + [USE]\n\n        # Explore possible movement actions (UP, DOWN, LEFT, RIGHT)\n        for action_val in [UP, DOWN, LEFT, RIGHT]:\n            new_dir_val, (move_dx, move_dy) = action_to_new_dir_and_move_vec[action_val]\n            next_x, next_y = curr_x + move_dx, curr_y + move_dy\n            next_dir = new_dir_val # The direction is set by the movement action\n\n            # Check boundary conditions for the next position\n            if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                continue\n\n            # Check if the next position is an obstacle (contains a non-grabbable item)\n            is_obstacle = False\n            for k in non_grabbable_indices:\n                if grid[next_x, next_y, k] == 1:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n\n            # If this state (position and direction) has not been visited, add it to the queue\n            if (next_x, next_y, next_dir) not in visited:\n                visited.add((next_x, next_y, next_dir))\n                queue.append((next_x, next_y, next_dir, path_actions + [action_val]))\n\n    # If the queue becomes empty and no path to the primitive is found\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:02:14.265176", "function_name": "collect", "function_body": "  from collections import deque\n\n  actions_taken = []\n  \n  # Get action integer IDs from the environment's action_specs\n  action_map = env.action_specs()\n  \n  # Define action IDs for better readability and direct use\n  UP, DOWN, LEFT, RIGHT, USE = (action_map['UP'], action_map['DOWN'],\n                                action_map['LEFT'], action_map['RIGHT'],\n                                action_map['USE'])\n  \n  # Mapping of (dx, dy) coordinate changes to their corresponding action IDs.\n  # CraftWorld agent position `pos` is (column, row) or (x, y).\n  # UP: decreases row (y), DOWN: increases row (y)\n  # LEFT: decreases column (x), RIGHT: increases column (x)\n  move_deltas_to_action = {\n      (0, -1): UP,    # Change in (x, y) for UP action\n      (0, 1): DOWN,   # Change in (x, y) for DOWN action\n      (-1, 0): LEFT,  # Change in (x, y) for LEFT action\n      (1, 0): RIGHT   # Change in (x, y) for RIGHT action\n  }\n  \n  world = env.world # Reference to the CraftWorld instance for environment details\n  \n  # Primitives are items that can be picked up. If the target `primitive`\n  # is not in the list of grabbable items, this function cannot collect it.\n  if primitive not in world.grabbable_indices:\n      # Return an empty list of actions, as the item is uncollectible by this method.\n      return []\n\n  MAX_COLLECT_STEPS = 200 # A safety limit to prevent infinite loops in complex or unreachable scenarios.\n\n  def find_path_to_adjacent(start_pos, target_kind_idx, current_grid, world_ref):\n      \"\"\"\n      Performs a Breadth-First Search (BFS) to find the shortest path from `start_pos`\n      to any cell that is *adjacent* to `target_kind_idx`.\n      \n      Args:\n          start_pos (tuple): The agent's current (x, y) grid coordinates.\n          target_kind_idx (int): The integer index of the item kind to find.\n          current_grid (numpy.ndarray): The current grid layout (WIDTH, HEIGHT, N_KINDS).\n          world_ref (CraftWorld): Reference to the CraftWorld instance, used to determine obstacles.\n\n      Returns:\n          list: A list of action IDs representing the shortest sequence of moves to reach\n                a cell from which the target kind can be 'USE'd (i.e., adjacent).\n                Returns None if no such path is found.\n      \"\"\"\n      grid_width, grid_height, _ = current_grid.shape\n\n      # Identify grid entities that act as obstacles and cannot be traversed.\n      # This typically includes non-grabbable environment items (e.g., water, stone)\n      # and static workshop locations (e.g., workbench, furnace).\n      obstacle_indices = world_ref.non_grabbable_indices.union(world_ref.workshop_indices)\n\n      def is_walkable(x, y):\n          \"\"\"Checks if a given grid cell (x, y) is within bounds and free of obstacles.\"\"\"\n          if not (0 <= x < grid_width and 0 <= y < grid_height):\n              return False # Coordinates are out of the grid boundaries\n          \n          # Iterate through known obstacle kinds to check if the cell is blocked.\n          for idx in obstacle_indices:\n              if current_grid[x, y, idx] == 1:\n                  return False # The cell contains an impassable obstacle\n          return True # The cell is within bounds and can be walked upon\n\n      # Initialize BFS queue with the starting position and an empty path.\n      queue = deque([(start_pos, [])])\n      # Keep track of visited positions to prevent cycles and redundant work.\n      visited = {start_pos}\n\n      while queue:\n          (curr_x, curr_y), path = queue.popleft()\n\n          # Check if the current cell (curr_x, curr_y) is adjacent to the target_kind_idx.\n          # This means, if the agent were at (curr_x, curr_y), current_state.next_to(target_kind_idx) would be True.\n          # We check the 3x3 neighborhood around (curr_x, curr_y).\n          found_adjacent_primitive = False\n          for dx_adj in [-1, 0, 1]:\n              for dy_adj in [-1, 0, 1]:\n                  adj_x, adj_y = curr_x + dx_adj, curr_y + dy_adj\n                  # Make sure the adjacent cell is within bounds and contains the primitive\n                  if (0 <= adj_x < grid_width and 0 <= adj_y < grid_height and\n                          current_grid[adj_x, adj_y, target_kind_idx] == 1):\n                      found_adjacent_primitive = True\n                      break\n              if found_adjacent_primitive:\n                  break\n          \n          if found_adjacent_primitive:\n              return path # Return the sequence of movement actions to reach this adjacent position.\n\n          # Explore all four cardinal neighbors (UP, DOWN, LEFT, RIGHT).\n          for (dx, dy), action_id in move_deltas_to_action.items():\n              next_x, next_y = curr_x + dx, curr_y + dy\n              next_pos = (next_x, next_y)\n\n              # If the neighbor is walkable and has not been visited, add it to the queue.\n              if is_walkable(next_x, next_y) and next_pos not in visited:\n                  visited.add(next_pos)\n                  queue.append((next_pos, path + [action_id]))\n      \n      return None # No path found to any cell adjacent to the primitive on the grid.\n\n  # Main loop for the collection process, executing actions step-by-step.\n  for _ in range(MAX_COLLECT_STEPS):\n      # Access the current state of the environment for real-time decision making.\n      current_state = env._current_state \n      \n      # 1. Check if the primitive is already in the agent's inventory.\n      # This is the primary success condition and exit point.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken # Goal achieved: primitive has been collected.\n\n      # 2. Check if the primitive is within the agent's 3x3 neighborhood (including its own cell).\n      # If so, the agent can attempt to pick it up using the 'USE' action.\n      # The `next_to` method conveniently checks this proximity.\n      if current_state.next_to(primitive):\n          # Perform the 'USE' action. This should pick up the primitive if successful.\n          _reward, done, _observations = env.step(USE) \n          actions_taken.append(USE)\n          if done:\n              # If the environment signals the episode is finished (e.g., max_steps reached),\n              # break the collection loop.\n              break \n          continue # After using, immediately re-check inventory in the next iteration.\n\n      current_pos = current_state.pos # Agent's current (x, y) grid position.\n      grid = current_state.grid       # The current environmental grid layout.\n      \n      # 3. If the primitive is not in inventory and not adjacent, find the shortest path\n      # to any cell adjacent to the primitive on the grid using BFS.\n      path_to_primitive_adj = find_path_to_adjacent(current_pos, primitive, grid, world)\n\n      if path_to_primitive_adj:\n          # If a path is found, take the very first step on that calculated path.\n          # This moves the agent one step closer to a position where it can 'USE' the primitive.\n          next_action = path_to_primitive_adj[0]\n          _reward, done, _observations = env.step(next_action) \n          actions_taken.append(next_action)\n          if done:\n              # If the episode ends after this movement, break the loop.\n              break\n      else:\n          # If no path could be found to any cell adjacent to the primitive, it means\n          # the primitive might be unreachable, or all instances have been collected,\n          # or it disappeared. In this case, further collection attempts are futile.\n          break \n\n  return actions_taken # Return the sequence of actions taken during the collection attempt.", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:02:15.257112", "function_name": "collect", "function_body": "  from collections import deque\n\n  actions_taken = []\n  \n  action_map = env.action_specs()\n  \n  # Get references to the CraftWorld instance for environment details\n  world = env.world \n  \n  # A safety limit to prevent infinite loops in complex or unreachable scenarios.\n  MAX_COLLECT_STEPS = 200 \n\n  # Mapping of (dx, dy) coordinate changes to their corresponding action IDs.\n  # CraftWorld agent position `pos` is (column, row) or (x, y).\n  # UP: decreases row (y), DOWN: increases row (y)\n  # LEFT: decreases column (x), RIGHT: increases column (x)\n  move_deltas = {\n      action_map['UP']: (0, -1),\n      action_map['DOWN']: (0, 1),\n      action_map['LEFT']: (-1, 0),\n      action_map['RIGHT']: (1, 0)\n  }\n  \n  # Primitives are items that can be picked up. If the target `primitive`\n  # is not in the list of grabbable items, this function cannot collect it.\n  if primitive not in world.grabbable_indices:\n      return []\n\n  def _find_path_to_pickup_spot(start_pos, target_kind_idx, current_grid, world_ref, move_deltas_map):\n      \"\"\"\n      Performs a Breadth-First Search (BFS) to find the shortest path from `start_pos`\n      to any walkable cell from which the `target_kind_idx` can be picked up (i.e., is adjacent).\n      \n      Args:\n          start_pos (tuple): The agent's current (x, y) grid coordinates.\n          target_kind_idx (int): The integer index of the item kind to find.\n          current_grid (numpy.ndarray): The current grid layout (WIDTH, HEIGHT, N_KINDS).\n          world_ref (CraftWorld): Reference to the CraftWorld instance for obstacles.\n          move_deltas_map (dict): Mapping of action IDs to (dx, dy) changes.\n\n      Returns:\n          list: A list of action IDs representing the shortest sequence of moves to reach\n                a cell adjacent to the target kind. Returns None if no path is found.\n      \"\"\"\n      grid_width, grid_height, _ = current_grid.shape\n\n      # Identify grid entities that act as obstacles and cannot be traversed.\n      # This typically includes non-grabbable environment items (e.g., water, stone)\n      # and static workshop locations (e.g., workbench, furnace).\n      obstacle_indices = world_ref.non_grabbable_indices.union(world_ref.workshop_indices)\n\n      def is_walkable(x, y):\n          \"\"\"Checks if a given grid cell (x, y) is within bounds and free of obstacles.\"\"\"\n          if not (0 <= x < grid_width and 0 <= y < grid_height):\n              return False # Coordinates are out of the grid boundaries\n          \n          # Iterate through known obstacle kinds to check if the cell is blocked.\n          # Grabbable items (like the primitive itself) are usually traversable.\n          for idx in obstacle_indices:\n              if current_grid[x, y, idx] == 1:\n                  return False # The cell contains an impassable obstacle\n          return True # The cell is within bounds and can be walked upon\n\n      queue = deque([(start_pos, [])]) # (current_position, path_taken_to_reach_current_position)\n      visited = {start_pos} # Set to keep track of visited grid positions\n\n      while queue:\n          (curr_x, curr_y), path = queue.popleft()\n\n          # Check if the current position (curr_x, curr_y) is a valid \"pickup spot\"\n          # This means if the agent were at (curr_x, curr_y), it could use the primitive.\n          # The CraftState.next_to method checks the 3x3 neighborhood around the agent's position.\n          is_adjacent_to_primitive = False\n          for dx_adj in [-1, 0, 1]:\n              for dy_adj in [-1, 0, 1]:\n                  adj_x, adj_y = curr_x + dx_adj, curr_y + dy_adj\n                  # Check if the adjacent cell is within bounds and contains the primitive\n                  if (0 <= adj_x < grid_width and 0 <= adj_y < grid_height) and \\\n                     current_grid[adj_x, adj_y, target_kind_idx] == 1:\n                      is_adjacent_to_primitive = True\n                      break\n              if is_adjacent_to_primitive:\n                  break\n          \n          if is_adjacent_to_primitive:\n              return path # Found the shortest path to a valid pickup spot\n\n          # Explore unvisited, walkable neighbors\n          for action_id, (dx, dy) in move_deltas_map.items():\n              next_x, next_y = curr_x + dx, curr_y + dy\n              next_pos = (next_x, next_y)\n\n              if is_walkable(next_x, next_y) and next_pos not in visited:\n                  visited.add(next_pos)\n                  queue.append((next_pos, path + [action_id]))\n      \n      return None # No path found to any pickup spot for the primitive.\n\n  # Main loop for the collection process, executing actions step-by-step.\n  for _ in range(MAX_COLLECT_STEPS):\n      current_state = env._current_state \n      \n      # 1. Check if the primitive is already in the agent's inventory.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken # Goal achieved: primitive has been collected.\n\n      # 2. Check if the primitive is within the agent's 3x3 neighborhood.\n      # If so, the agent can attempt to pick it up using the 'USE' action.\n      if current_state.next_to(primitive):\n          _reward, done, _observations = env.step(action_map['USE']) \n          actions_taken.append(action_map['USE'])\n          if done:\n              break # Episode finished, e.g., max_steps reached.\n          continue # After using, immediately re-check inventory in the next iteration.\n\n      current_pos = current_state.pos # Agent's current (x, y) grid position.\n      grid = current_state.grid       # The current environmental grid layout.\n      \n      # 3. If primitive is not in inventory and not adjacent, find the shortest path\n      # to a spot from where it can be picked up using BFS.\n      path_to_pickup_spot = _find_path_to_pickup_spot(\n          current_pos, primitive, grid, world, move_deltas)\n\n      if path_to_pickup_spot:\n          # If a path is found, take the very first step on that calculated path.\n          next_action = path_to_pickup_spot[0]\n          _reward, done, _observations = env.step(next_action) \n          actions_taken.append(next_action)\n          if done:\n              break # Episode finished.\n      else:\n          # If no path could be found to any primitive pickup spot, it means\n          # the primitive might be unreachable, or all instances have been collected,\n          # or it disappeared.\n          break \n\n  return actions_taken # Return the sequence of actions taken during the collection attempt.", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:04:10.708716", "function_name": "collect", "function_body": "", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:04:10.778653", "function_name": "collect", "function_body": "    import collections\n\n    # Get initial state observations\n    obs = env.observations()\n    initial_grid = obs['features_dict']['features_global']\n    initial_pos = tuple(obs['features_dict']['pos'])\n    height, width, n_kinds = initial_grid.shape\n\n    # Get action mappings from the environment\n    ACTIONS = env.action_specs()\n    MOVE_ACTIONS = {\n        (0, -1): ACTIONS['UP'],\n        (0, +1): ACTIONS['DOWN'],\n        (-1, 0): ACTIONS['LEFT'],\n        (+1, 0): ACTIONS['RIGHT']\n    }\n\n    # Find all locations on the grid where the primitive exists\n    primitive_locations = []\n    for y in range(height):\n        for x in range(width):\n            if initial_grid[y, x, primitive] > 0:\n                primitive_locations.append((y, x))\n\n    if not primitive_locations:\n        # Primitive not found anywhere on the grid\n        return []\n\n    # Determine all valid target positions from which the agent can 'USE' the primitive.\n    # This includes the primitive's cell itself and its 8 adjacent cells (3x3 neighborhood).\n    target_positions = set()\n    for py, px in primitive_locations:\n        for dy in [-1, 0, 1]:\n            for dx in [-1, 0, 1]:\n                ty, tx = py + dy, px + dx\n                # Check bounds to ensure the target position is on the grid\n                if 0 <= ty < height and 0 <= tx < width:\n                    target_positions.add((ty, tx))\n\n    # Initialize BFS\n    q = collections.deque()\n    visited = set()\n\n    # Queue stores (current_position, list_of_actions_to_reach_here)\n    q.append((initial_pos, []))\n    visited.add(initial_pos)\n\n    path_found = []\n\n    # Get indices for impassable terrain from the CraftWorld instance\n    world_instance = env.world  # env is CraftLab, which holds a CraftWorld instance\n    water_idx = world_instance.water_index\n    workshop_idxs = world_instance.workshop_indices\n\n    while q:\n        current_pos, path = q.popleft()\n\n        # If the current position is one of our target positions, we've found a path\n        if current_pos in target_positions:\n            path_found = path\n            break\n\n        y, x = current_pos\n        # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n        for dy, dx in [(0, -1), (0, 1), (-1, 0), (1, 0)]:  # Define movement deltas\n            next_y, next_x = y + dy, x + dx\n            next_pos = (next_y, next_x)\n\n            # Check boundaries and if the cell has already been visited\n            if 0 <= next_y < height and 0 <= next_x < width and next_pos not in visited:\n                # Check if the next cell is traversable (not water or a workshop)\n                is_traversable = True\n                if initial_grid[next_y, next_x, water_idx] > 0:\n                    is_traversable = False\n                else:\n                    for ws_idx in workshop_idxs:\n                        if initial_grid[next_y, next_x, ws_idx] > 0:\n                            is_traversable = False\n                            break # Found a workshop, no need to check others\n\n                if is_traversable:\n                    visited.add(next_pos)\n                    action_to_take = MOVE_ACTIONS[(dy, dx)]\n                    q.append((next_pos, path + [action_to_take]))\n\n    if not path_found:\n        # No path could be found to any target position\n        return []\n\n    # Once a path to a target position is found, append the 'USE' action\n    path_found.append(ACTIONS['USE'])\n\n    return path_found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:06:05.089765", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from problem description for CraftLab.action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  initial_craft_state = env._current_state\n  \n  # 1. Check if the primitive is already collected\n  if initial_craft_state.inventory[primitive] > 0:\n      return []\n\n  grid = initial_craft_state.grid\n  HEIGHT, WIDTH, N_KINDS = grid.shape\n\n  # 2. Find all locations of the primitive on the grid\n  # np.argwhere returns (row, col) which corresponds to (y, x)\n  primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n\n  if not primitive_locations.size:\n      return [] # Primitive not found on the grid\n\n  # 3. Find the closest primitive location (Manhattan distance)\n  # Agent's position is (px, py) where px is column, py is row\n  initial_px, initial_py = initial_craft_state.pos \n  \n  min_dist = float('inf')\n  target_px, target_py = -1, -1 # Target position (x, y)\n\n  for loc_py, loc_px in primitive_locations: # loc_py is row, loc_px is col\n      dist = abs(initial_px - loc_px) + abs(initial_py - loc_py)\n      if dist < min_dist:\n          min_dist = dist\n          target_px, target_py = loc_px, loc_py # Store as (x, y)\n\n  # 4. Perform a BFS to find the shortest sequence of actions\n  # BFS state: (current_craft_state_object, path_so_far_list)\n  queue = collections.deque([(initial_craft_state, [])])\n  \n  # Visited set to prevent cycles and redundant explorations.\n  # A state is defined by (agent_x, agent_y, agent_dir, tuple(inventory)).\n  # inventory is included because it can affect future actions/rewards,\n  # though for `collect` its only relevance is the target primitive.\n  # Converting inventory to a tuple makes it hashable.\n  visited_states = set()\n  initial_state_key = (initial_px, initial_py, initial_craft_state.dir, tuple(initial_craft_state.inventory))\n  visited_states.add(initial_state_key)\n\n  while queue:\n      current_state, path_so_far = queue.popleft()\n      current_px, current_py = current_state.pos\n      current_dir = current_state.dir\n      \n      # First, try to USE from the current state.\n      # The `step` method returns (reward, new_state). We care about new_state.\n      # This simulates the action. It doesn't modify the `current_state` object.\n      _, state_after_use = current_state.step(USE)\n      \n      # If the primitive is now in inventory, we found a solution.\n      if state_after_use.inventory[primitive] > 0:\n          return path_so_far + [USE]\n\n      # Explore possible move actions (DOWN, UP, LEFT, RIGHT)\n      for action in [DOWN, UP, LEFT, RIGHT]:\n          _, next_state = current_state.step(action)\n          \n          # `CraftState.step` might return a new state object even if the agent didn't move\n          # (e.g., collided with an impassable object).\n          # We need to check if this `next_state` is truly new in terms of its key attributes.\n          next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, tuple(next_state.inventory))\n\n          if next_state_key not in visited_states:\n              visited_states.add(next_state_key)\n              queue.append((next_state, path_so_far + [action]))\n\n  return [] # No path found to collect the primitive", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:06:06.075196", "function_name": "collect", "function_body": "  # --- Constants and Helper Functions (defined locally to fit constraint) ---\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction mappings (agent's facing direction)\n  # 0: UP, 1: DOWN, 2: LEFT, 3: RIGHT\n  DIR_DX = {0: 0, 1: 0, 2: -1, 3: 1}\n  DIR_DY = {0: -1, 1: 1, 2: 0, 3: 0}\n\n  # Mapping (delta_x, delta_y) to agent's facing direction index\n  DELTAS_TO_DIR_IDX = {(0, -1): 0, (0, 1): 1, (-1, 0): 2, (1, 0): 3}\n\n  # Turn mappings for rotating the agent\n  RIGHT_TURN_MAP = {0: 3, 3: 1, 1: 2, 2: 0} # UP -> RIGHT -> DOWN -> LEFT -> UP\n  LEFT_TURN_MAP = {0: 2, 2: 1, 1: 3, 3: 0} # UP -> LEFT -> DOWN -> RIGHT -> UP\n\n  def _get_turn_actions(current_dir, target_dir_idx):\n      \"\"\"\n      Calculates the sequence of turn actions (LEFT/RIGHT) needed to change\n      the agent's current facing direction to the target direction.\n      Prioritizes the shorter turn.\n      \"\"\"\n      turns = []\n      temp_dir = current_dir\n      if temp_dir == target_dir_idx:\n          return [] # Already facing the target direction\n\n      # Calculate turns to the right\n      turns_right_count = 0\n      test_dir_r = temp_dir\n      while test_dir_r != target_dir_idx:\n          test_dir_r = RIGHT_TURN_MAP[test_dir_r]\n          turns_right_count += 1\n\n      # Calculate turns to the left\n      turns_left_count = 0\n      test_dir_l = temp_dir\n      while test_dir_l != target_dir_idx:\n          test_dir_l = LEFT_TURN_MAP[test_dir_l]\n          turns_left_count += 1\n      \n      # Choose the shorter path\n      if turns_right_count <= turns_left_count:\n          for _ in range(turns_right_count):\n              turns.append(ACTION_RIGHT)\n      else:\n          for _ in range(turns_left_count):\n              turns.append(ACTION_LEFT)\n      \n      return turns\n  # --- End of Constants and Helper Functions ---\n\n  # Get initial state for simulation from the environment's internal state\n  # env._current_state is assumed to be accessible for internal simulation.\n  initial_state = env._current_state\n\n  # Check if primitive is already collected in the initial state\n  if initial_state.inventory[primitive] > 0:\n      return []\n\n  # Initialize BFS queue with the initial state and an empty list of actions\n  queue = collections.deque([(initial_state, [])]) # (CraftState, list of actions to reach this state)\n  \n  # Set to keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (position_x, position_y, agent_direction).\n  # Inventory is not part of the visited key as it only changes upon `USE` for a primitive.\n  visited_states = set() \n\n  # Maximum number of actions to search. Prevents infinite loops in complex or impossible scenarios.\n  max_search_depth = 200 \n\n  while queue:\n      current_state, current_actions = queue.popleft()\n\n      # Goal check: If the primitive is collected in the current simulated state, return the actions.\n      if current_state.inventory[primitive] > 0:\n          return current_actions\n\n      # Pruning: Stop exploring this path if it exceeds the maximum allowed depth.\n      if len(current_actions) >= max_search_depth:\n          continue\n\n      # Create a key for the current state to check against visited_states\n      state_key = (current_state.pos[0], current_state.pos[1], current_state.dir)\n      if state_key in visited_states:\n          continue # This state (position and direction) has been visited already via a shorter or equal path\n      visited_states.add(state_key) # Mark the current state as visited\n\n      # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n      for action in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n          # Create a deep copy of the current state for simulation.\n          # CraftState constructor: init(scenario, grid, pos, dir, inventory)\n          # Note: scenario and world references are carried over, grid and inventory are deep copied.\n          next_state_copy = initial_state.__class__(\n              current_state.scenario,\n              np.copy(current_state.grid),\n              current_state.pos, # Position is updated by step(), so pass current_state.pos\n              current_state.dir, # Direction is updated by step(), so pass current_state.dir\n              np.copy(current_state.inventory)\n          )\n          # Simulate the action: reward is ignored for pathfinding\n          _, simulated_next_state = next_state_copy.step(action)\n          new_actions = current_actions + [action] # Append the action to the path\n\n          # Add the new state to the queue if it hasn't been visited\n          next_state_key = (simulated_next_state.pos[0], simulated_next_state.pos[1], simulated_next_state.dir)\n          if next_state_key not in visited_states:\n               queue.append((simulated_next_state, new_actions))\n\n      # 2. Explore USE Action (if next to the primitive)\n      # CraftState.next_to(i_kind) checks if the primitive is in the 3x3 neighborhood around the agent.\n      if current_state.next_to(primitive):\n          grid_width, grid_height, _ = current_state.grid.shape \n          current_x, current_y = current_state.pos\n\n          # Determine the cell directly in front of the agent based on its current direction\n          front_x = current_x + DIR_DX[current_state.dir]\n          front_y = current_y + DIR_DY[current_state.dir]\n\n          is_primitive_in_front = False\n          # Check if the cell in front is within grid boundaries and contains the primitive\n          if (0 <= front_x < grid_width and 0 <= front_y < grid_height and\n              current_state.grid[front_x, front_y, primitive] == 1):\n              is_primitive_in_front = True\n\n          if is_primitive_in_front:\n              # The agent is already correctly oriented, so just perform the USE action.\n              temp_state_for_use = initial_state.__class__(\n                  current_state.scenario,\n                  np.copy(current_state.grid),\n                  current_state.pos,\n                  current_state.dir,\n                  np.copy(current_state.inventory)\n              )\n              _, state_after_use = temp_state_for_use.step(ACTION_USE)\n              new_actions_with_use = current_actions + [ACTION_USE]\n\n              # If goal achieved, return path\n              if state_after_use.inventory[primitive] > 0:\n                  return new_actions_with_use\n              \n              # Otherwise, add this new state to the queue if not visited\n              state_after_use_key = (state_after_use.pos[0], state_after_use.pos[1], state_after_use.dir)\n              if state_after_use_key not in visited_states:\n                  queue.append((state_after_use, new_actions_with_use))\n\n          else: # Primitive is adjacent but not directly in front. Agent needs to turn.\n              primitive_loc_found = None\n              # Search the 8 surrounding cells (excluding the agent's current position)\n              for dx_offset in [-1, 0, 1]:\n                  for dy_offset in [-1, 0, 1]:\n                      if dx_offset == 0 and dy_offset == 0:\n                          continue # Skip agent's current position\n\n                      nx, ny = current_x + dx_offset, current_y + dy_offset\n                      # If an adjacent cell contains the primitive\n                      if (0 <= nx < grid_width and 0 <= ny < grid_height and\n                          current_state.grid[nx, ny, primitive] == 1):\n                          primitive_loc_found = (nx, ny)\n                          break # Found the primitive, stop searching neighbors\n                  if primitive_loc_found:\n                      break\n\n              if primitive_loc_found:\n                  # Calculate the required direction to face the primitive\n                  target_dx = primitive_loc_found[0] - current_x\n                  target_dy = primitive_loc_found[1] - current_y\n\n                  # Ensure the calculated delta maps to a known direction (should be true for direct neighbours)\n                  if (target_dx, target_dy) in DELTAS_TO_DIR_IDX:\n                      target_dir_idx = DELTAS_TO_DIR_IDX[(target_dx, target_dy)]\n                      \n                      # Get the sequence of turn actions needed to face the primitive\n                      turn_actions = _get_turn_actions(current_state.dir, target_dir_idx)\n                      \n                      # Simulate the turns and then the USE action\n                      temp_state_after_turns = initial_state.__class__(\n                          current_state.scenario,\n                          np.copy(current_state.grid),\n                          current_state.pos,\n                          current_state.dir,\n                          np.copy(current_state.inventory)\n                      )\n                      temp_actions = current_actions[:] # Make a copy of the actions list to build upon\n\n                      for turn_action in turn_actions:\n                          _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n                          temp_actions.append(turn_action)\n                      \n                      # After turning, perform the USE action\n                      _, state_after_use = temp_state_after_turns.step(ACTION_USE)\n                      new_actions_with_use = temp_actions + [ACTION_USE]\n\n                      # If goal achieved, return the combined path\n                      if state_after_use.inventory[primitive] > 0:\n                          return new_actions_with_use\n                      \n                      # Otherwise, add this new state to the queue if it's unique\n                      state_after_use_key = (state_after_use.pos[0], state_after_use.pos[1], state_after_use.dir)\n                      if state_after_use_key not in visited_states:\n                          queue.append((state_after_use, new_actions_with_use))\n\n  # If the queue becomes empty and the goal was not reached within the search limits,\n  # it means no path was found.\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:07:02.216806", "function_name": "collect", "function_body": "  from collections import deque\n\n  actions_taken = []\n  \n  action_map = env.action_specs()\n  \n  # Get references to the CraftWorld instance for environment details\n  world = env.world \n  \n  # A safety limit to prevent infinite loops in complex or unreachable scenarios.\n  MAX_COLLECT_STEPS = 200 \n\n  # Mapping of (dx, dy) coordinate changes to their corresponding action IDs.\n  # CraftWorld agent position `pos` is (column, row) or (x, y).\n  # UP: decreases row (y), DOWN: increases row (y)\n  # LEFT: decreases column (x), RIGHT: increases column (x)\n  move_deltas = {\n      action_map['UP']: (0, -1),\n      action_map['DOWN']: (0, 1),\n      action_map['LEFT']: (-1, 0),\n      action_map['RIGHT']: (1, 0)\n  }\n  \n  # Primitives are items that can be picked up. If the target `primitive`\n  # is not in the list of grabbable items, this function cannot collect it.\n  if primitive not in world.grabbable_indices:\n      return []\n\n  # Identify grid entities that act as obstacles and cannot be traversed.\n  # This typically includes non-grabbable environment items (e.g., water, stone)\n  # and static workshop locations (e.g., workbench, furnace).\n  obstacle_indices = world.non_grabbable_indices.union(world.workshop_indices)\n\n  def _find_path_to_pickup_spot(start_pos, target_kind_idx, current_grid, obstacles, move_deltas_map):\n      \"\"\"\n      Performs a Breadth-First Search (BFS) to find the shortest path from `start_pos`\n      to any walkable cell from which the `target_kind_idx` can be picked up (i.e., is adjacent).\n      \n      Args:\n          start_pos (tuple): The agent's current (x, y) grid coordinates.\n          target_kind_idx (int): The integer index of the item kind to find.\n          current_grid (numpy.ndarray): The current grid layout (WIDTH, HEIGHT, N_KINDS).\n          obstacles (set): A set of integer indices for item kinds that block movement.\n          move_deltas_map (dict): Mapping of action IDs to (dx, dy) changes.\n\n      Returns:\n          list: A list of action IDs representing the shortest sequence of moves to reach\n                a cell adjacent to the target kind. Returns None if no path is found.\n      \"\"\"\n      grid_width, grid_height, _ = current_grid.shape\n\n      def is_walkable(x, y):\n          \"\"\"Checks if a given grid cell (x, y) is within bounds and free of obstacles.\"\"\"\n          if not (0 <= x < grid_width and 0 <= y < grid_height):\n              return False # Coordinates are out of the grid boundaries\n          \n          # Iterate through known obstacle kinds to check if the cell is blocked.\n          for idx in obstacles:\n              if current_grid[x, y, idx] == 1:\n                  return False # The cell contains an impassable obstacle\n          return True # The cell is within bounds and can be walked upon\n\n      queue = deque([(start_pos, [])]) # (current_position, path_taken_to_reach_current_position)\n      visited = {start_pos} # Set to keep track of visited grid positions\n\n      while queue:\n          (curr_x, curr_y), path = queue.popleft()\n\n          # Check if the current position (curr_x, curr_y) is a valid \"pickup spot\"\n          # This means if the agent were at (curr_x, curr_y), the target_kind_idx\n          # would be in its 3x3 neighborhood.\n          is_adjacent_to_primitive = False\n          for dx_adj in [-1, 0, 1]:\n              for dy_adj in [-1, 0, 1]:\n                  adj_x, adj_y = curr_x + dx_adj, curr_y + dy_adj\n                  # Check if the adjacent cell is within bounds and contains the primitive\n                  if (0 <= adj_x < grid_width and 0 <= adj_y < grid_height) and\\\n                     current_grid[adj_x, adj_y, target_kind_idx] == 1:\n                      is_adjacent_to_primitive = True\n                      break\n              if is_adjacent_to_primitive:\n                  break\n          \n          if is_adjacent_to_primitive:\n              return path # Found the shortest path to a valid pickup spot\n\n          # Explore unvisited, walkable neighbors\n          for action_id, (dx, dy) in move_deltas_map.items():\n              next_x, next_y = curr_x + dx, curr_y + dy\n              next_pos = (next_x, next_y)\n\n              if is_walkable(next_x, next_y) and next_pos not in visited:\n                  visited.add(next_pos)\n                  queue.append((next_pos, path + [action_id]))\n      \n      return None # No path found to any pickup spot for the primitive.\n\n  # Main loop for the collection process, executing actions step-by-step.\n  for _ in range(MAX_COLLECT_STEPS):\n      current_state = env._current_state \n      \n      # 1. Check if the primitive is already in the agent's inventory.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken # Goal achieved: primitive has been collected.\n\n      # 2. Check if the primitive is within the agent's 3x3 neighborhood.\n      # If so, the agent can attempt to pick it up using the 'USE' action.\n      if current_state.next_to(primitive):\n          _reward, done, _observations = env.step(action_map['USE']) \n          actions_taken.append(action_map['USE'])\n          if done:\n              break # Episode finished, e.g., max_steps reached.\n          continue # After using, immediately re-check inventory in the next iteration.\n\n      current_pos = current_state.pos # Agent's current (x, y) grid position.\n      grid = current_state.grid       # The current environmental grid layout.\n      \n      # 3. If primitive is not in inventory and not adjacent, find the shortest path\n      # to a spot from where it can be picked up using BFS.\n      path_to_pickup_spot = _find_path_to_pickup_spot(\n          current_pos, primitive, grid, obstacle_indices, move_deltas)\n\n      if path_to_pickup_spot:\n          # If a path is found, take the very first step on that calculated path.\n          next_action = path_to_pickup_spot[0]\n          _reward, done, _observations = env.step(next_action) \n          actions_taken.append(next_action)\n          if done:\n              break # Episode finished.\n      else:\n          # If no path could be found to any primitive pickup spot, it means\n          # the primitive might be unreachable, or all instances have been collected,\n          # or it disappeared.\n          break \n\n  return actions_taken # Return the sequence of actions taken during the collection attempt.", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:07:03.195729", "function_name": "collect", "function_body": "  actions_taken = []\n  \n  action_map = env.action_specs()\n  \n  # Access CraftWorld instance for environment details like grabbable items and obstacles.\n  world = env.world \n  \n  # A safety limit to prevent excessively long or infinite collection attempts.\n  MAX_COLLECT_STEPS = 200 \n\n  # Define movement actions and their corresponding (dx, dy) changes.\n  # (dx, dy) represents change in (column, row) respectively.\n  move_deltas = {\n      action_map['UP']: (0, -1),   # Decreases y (row)\n      action_map['DOWN']: (0, 1),  # Increases y (row)\n      action_map['LEFT']: (-1, 0), # Decreases x (column)\n      action_map['RIGHT']: (1, 0)  # Increases x (column)\n  }\n  \n  # Pre-check: This function is for collecting grabbable primitives from the grid.\n  if primitive not in world.grabbable_indices:\n      # If the item is not something that can be picked up directly, this function\n      # cannot collect it. A different function would be needed for crafted items.\n      return []\n\n  # Nested function for Breadth-First Search (BFS) based pathfinding.\n  # Assuming 'deque' is imported at the module level (e.g., from collections import deque).\n  def _find_path_to_pickup_spot(start_pos, target_kind_idx, current_grid, world_ref, move_deltas_map):\n      \"\"\"\n      Performs a Breadth-First Search (BFS) to find the shortest sequence of actions\n      (moves) from `start_pos` to any walkable grid cell from which the\n      `target_kind_idx` can be picked up (i.e., is present in the 3x3 neighborhood).\n      This BFS accounts for impassable obstacles defined by `world_ref`.\n      \n      Args:\n          start_pos (tuple): The agent's current (x, y) grid coordinates.\n          target_kind_idx (int): The integer index of the item kind to find on the grid.\n          current_grid (numpy.ndarray): The current grid layout (WIDTH, HEIGHT, N_KINDS).\n          world_ref (CraftWorld): Reference to the CraftWorld instance, used for obstacle definitions.\n          move_deltas_map (dict): Mapping of action IDs to (dx, dy) movement vectors.\n\n      Returns:\n          list: A list of action IDs representing the shortest path of moves.\n                Returns None if no such reachable spot is found on the current grid.\n      \"\"\"\n      grid_width, grid_height, _ = current_grid.shape\n\n      # Cells containing these kinds are considered obstacles and cannot be traversed.\n      # This typically includes non-grabbable environment items (e.g., water, stone)\n      # and static crafting stations (e.g., workbench, furnace).\n      obstacle_indices = world_ref.non_grabbable_indices.union(world_ref.workshop_indices)\n\n      def is_walkable(x, y):\n          \"\"\"Checks if a given grid cell (x, y) is within grid boundaries and free of obstacles.\"\"\"\n          if not (0 <= x < grid_width and 0 <= y < grid_height):\n              return False # Coordinates are outside the grid.\n          \n          # Check if any obstacle entity occupies this cell.\n          for idx in obstacle_indices:\n              if current_grid[x, y, idx] == 1: # If the obstacle kind is present\n                  return False # Cell is blocked.\n          return True # Cell is clear and traversable.\n\n      # BFS queue: stores (current_position (tuple), path_to_current_position (list of actions))\n      queue = deque([(start_pos, [])])\n      # Set to keep track of visited grid positions to prevent cycles and redundant exploration.\n      visited = {start_pos} \n\n      while queue:\n          (curr_x, curr_y), path = queue.popleft()\n\n          # Check if the current position `(curr_x, curr_y)` is a valid \"pickup spot\".\n          # A pickup spot is defined as any cell from which the target primitive\n          # is present in the 3x3 neighborhood (including the current cell itself).\n          # This mimics the `CraftState.next_to` logic which determines if 'USE' is possible.\n          is_adjacent_to_primitive = False\n          for dx_adj in [-1, 0, 1]:\n              for dy_adj in [-1, 0, 1]:\n                  adj_x, adj_y = curr_x + dx_adj, curr_y + dy_adj\n                  # Check if the adjacent cell is within bounds and contains the target primitive.\n                  if (0 <= adj_x < grid_width and 0 <= adj_y < grid_height) and \\\n                     current_grid[adj_x, adj_y, target_kind_idx] == 1:\n                      is_adjacent_to_primitive = True\n                      break # Found the primitive in the neighborhood, no need to check further adjacent cells.\n              if is_adjacent_to_primitive:\n                  break # Found it, no need to check further rows of neighborhood.\n          \n          if is_adjacent_to_primitive:\n              return path # Found the shortest path to a valid pickup spot.\n\n          # If not a pickup spot, explore unvisited, walkable neighbors.\n          for action_id, (dx, dy) in move_deltas_map.items():\n              next_x, next_y = curr_x + dx, curr_y + dy\n              next_pos = (next_x, next_y)\n\n              if is_walkable(next_x, next_y) and next_pos not in visited:\n                  visited.add(next_pos)\n                  queue.append((next_pos, path + [action_id]))\n      \n      return None # No path found to any reachable cell adjacent to the primitive.\n\n  # --- Main collection loop ---\n  # The agent will try to collect the primitive for a maximum number of steps.\n  for _ in range(MAX_COLLECT_STEPS):\n      current_state = env._current_state # Get the current state of the environment.\n      \n      # Step 1: Goal check: Is the primitive already in the agent's inventory?\n      if current_state.inventory[primitive] > 0:\n          return actions_taken # Success: primitive has been collected.\n\n      # Step 2: Immediate action check: Is the primitive in the agent's immediate 3x3 neighborhood?\n      # If so, the 'USE' action can be applied to pick it up.\n      if current_state.next_to(primitive):\n          _reward, done, _observations = env.step(action_map['USE']) \n          actions_taken.append(action_map['USE'])\n          if done:\n              break # Episode terminated (e.g., max_steps reached).\n          continue # After attempting 'USE', re-evaluate (check inventory again).\n\n      # Step 3: Pathfinding: If not collected and not adjacent, find a path to the primitive.\n      # This uses the BFS function to find the shortest sequence of movements.\n      current_pos = current_state.pos # Agent's current (x, y) position.\n      grid = current_state.grid       # The current state of the grid.\n      \n      path_to_pickup_spot = _find_path_to_pickup_spot(\n          current_pos, primitive, grid, world, move_deltas)\n\n      if path_to_pickup_spot:\n          # If a path is found, take the very first action suggested by the BFS path.\n          next_action = path_to_pickup_spot[0]\n          _reward, done, _observations = env.step(next_action) \n          actions_taken.append(next_action)\n          if done:\n              break # Episode terminated.\n      else:\n          # If no path could be found (e.g., primitive is unreachable, or all instances\n          # have been removed from the grid), then we cannot collect it.\n          break \n\n  return actions_taken # Return the sequence of actions executed.", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:08:49.413511", "function_name": "collect", "function_body": "  from collections import deque\n\n  actions_taken = []\n  \n  action_map = env.action_specs()\n  \n  world = env.world\n  \n  MAX_COLLECT_STEPS = 200 \n\n  # Map movement actions to (dx, dy) coordinate changes for BFS\n  # CraftWorld agent position `pos` is (column, row).\n  # UP: decreases row (y), column (x) stays same -> (0, -1)\n  # DOWN: increases row (y), column (x) stays same -> (0, 1)\n  # LEFT: decreases column (x), row (y) stays same -> (-1, 0)\n  # RIGHT: increases column (x), row (y) stays same -> (1, 0)\n  move_deltas = {\n      action_map['UP']: (0, -1),\n      action_map['DOWN']: (0, 1),\n      action_map['LEFT']: (-1, 0),\n      action_map['RIGHT']: (1, 0),\n  }\n  \n  # Define what entity types act as obstacles (cannot be walked through).\n  # This typically includes non-grabbable environment items (like water, stone)\n  # and workshop locations (like workbench, furnace).\n  obstacle_indices = world.non_grabbable_indices.union(world.workshop_indices)\n\n  # Helper to check if a position is within grid bounds\n  def _is_valid_pos(x, y, grid_shape):\n      width, height, _ = grid_shape\n      return 0 <= x < width and 0 <= y < height\n\n  # Helper to check if a position is walkable (within bounds and no obstacles)\n  def _is_walkable(x, y, current_grid, grid_shape, obstacle_ids):\n      \"\"\"Checks if a given grid cell (x, y) is within bounds and contains no obstacles.\"\"\"\n      if not _is_valid_pos(x, y, grid_shape):\n          return False # Out of bounds\n      # Check if the cell contains any obstacle kind\n      for idx in obstacle_ids:\n          if current_grid[x, y, idx] == 1: # Assuming 1 indicates presence\n              return False # Contains an obstacle\n      return True # The cell is within bounds and free of obstacles\n\n  # Cardinal neighbors relative coordinates (for checking proximity and BFS goal)\n  cardinal_neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n\n  # Check if the primitive is a known grabbable item.\n  # If it's not grabbable, this function cannot collect it.\n  if primitive not in world.grabbable_indices:\n      return []\n\n  # Path to follow, if one has been computed\n  current_path_actions = None\n\n  # Main loop for finding and collecting the primitive\n  for _ in range(MAX_COLLECT_STEPS):\n    current_state = env._current_state # Direct access to the internal CraftState\n    \n    # 1. Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n      return actions_taken # Goal achieved\n\n    # 2. Check if the agent is currently cardinally next to the primitive, and if so, orient and use it\n    primitive_location_cardinal_nearby = None\n    agent_x, agent_y = current_state.pos\n    grid = current_state.grid # Use the current grid state for checks\n    \n    # Iterate through CARDINAL neighborhood to find primitive for USE action\n    for dx_nb, dy_nb in cardinal_neighbors:\n        nx_nb, ny_nb = agent_x + dx_nb, agent_y + dy_nb\n        if _is_valid_pos(nx_nb, ny_nb, grid.shape) and grid[nx_nb, ny_nb, primitive] == 1:\n            primitive_location_cardinal_nearby = (nx_nb, ny_nb)\n            break\n            \n    if primitive_location_cardinal_nearby:\n        # Agent is cardinally next to a primitive. Now orient and USE.\n        target_x, target_y = primitive_location_cardinal_nearby\n        \n        # Calculate required direction from agent_x, agent_y to target_x, target_y\n        dx_rel = target_x - agent_x\n        dy_rel = target_y - agent_y\n\n        required_dir = -1\n        # Map (dx, dy) to a direction integer (0=N, 1=E, 2=S, 3=W) based on CraftWorld conventions\n        # 0: North (UP, dy=-1)\n        # 1: East (RIGHT, dx=1)\n        # 2: South (DOWN, dy=1)\n        # 3: West (LEFT, dx=-1)\n        if dy_rel < 0: # Target is North (UP)\n            required_dir = 0\n        elif dx_rel > 0: # Target is East (RIGHT)\n            required_dir = 1\n        elif dy_rel > 0: # Target is South (DOWN)\n            required_dir = 2\n        elif dx_rel < 0: # Target is West (LEFT)\n            required_dir = 3\n        \n        # Orient the agent if not already facing the required direction\n        current_dir = current_state.dir\n        if required_dir != -1: # Ensure a valid target direction was found\n            while current_dir != required_dir:\n                # Calculate shorter turn (right or left)\n                turn_right_steps = (required_dir - current_dir + 4) % 4\n                turn_left_steps = (current_dir - required_dir + 4) % 4\n\n                turn_action = action_map['RIGHT'] if turn_right_steps <= turn_left_steps else action_map['LEFT']\n                \n                _reward, done, _observations = env.step(turn_action)\n                actions_taken.append(turn_action)\n                current_state = env._current_state # Update state after turn\n                current_dir = current_state.dir\n                if done:\n                    return actions_taken\n\n        # Now agent is oriented (or was already), perform USE\n        _reward, done, _observations = env.step(action_map['USE'])\n        actions_taken.append(action_map['USE'])\n        # Invalidate the path because the primitive might have been collected or the grid changed\n        current_path_actions = None \n        if done:\n            return actions_taken\n        continue # Successfully used, go to next iteration to re-check inventory\n\n    # 3. Path Planning or Path Following\n    if current_path_actions is None or len(current_path_actions) == 0:\n        # If no path is currently planned or the existing path is exhausted, find a new one\n        \n        current_pos = current_state.pos\n        grid_width, grid_height, _ = grid.shape\n\n        queue = deque([(current_pos[0], current_pos[1], [])]) # (x, y, path_of_actions_to_reach_here)\n        visited = {(current_pos[0], current_pos[1])} # Keep track of visited positions to avoid cycles\n        \n        path_found_by_bfs = None \n        \n        while queue:\n            px, py, path_so_far = queue.popleft()\n\n            # Check if the current BFS position (px, py) is suitable to be adjacent to the primitive\n            # This means checking the CARDINAL neighbors of (px, py) for the primitive.\n            target_primitive_found_by_bfs = False\n            for dx_nb, dy_nb in cardinal_neighbors: # Use cardinal_neighbors here too!\n                nx_nb, ny_nb = px + dx_nb, py + dy_nb\n                if _is_valid_pos(nx_nb, ny_nb, grid.shape) and grid[nx_nb, ny_nb, primitive] == 1:\n                    target_primitive_found_by_bfs = True\n                    break\n            \n            if target_primitive_found_by_bfs:\n                path_found_by_bfs = path_so_far\n                break # Path found, exit BFS\n                \n            # Explore valid and unvisited neighboring cells for movement\n            for action_val, (dx, dy) in move_deltas.items():\n                next_x, next_y = px + dx, py + dy\n                if (next_x, next_y) not in visited and \\\n                   _is_walkable(next_x, next_y, grid, grid.shape, obstacle_indices): # Use _is_walkable to check obstacles\n                    visited.add((next_x, next_y))\n                    queue.append((next_x, next_y, path_so_far + [action_val]))\n        \n        current_path_actions = path_found_by_bfs # Store the computed path for subsequent steps\n\n    # 4. Execute the next action in the pre-computed path\n    action_to_take = None\n    if current_path_actions is not None and len(current_path_actions) > 0:\n        action_to_take = current_path_actions.pop(0) # Take the first step and remove it from the planned path\n    \n    if action_to_take is not None:\n        # Perform the step in the environment\n        _reward, done, _observations = env.step(action_to_take)\n        actions_taken.append(action_to_take)\n        \n        # If the environment indicates the episode is done (e.g., max_steps reached)\n        if done:\n          return actions_taken\n    else:\n        # If no valid action could be determined (e.g., primitive unreachable, or no path found)\n        break\n            \n  return actions_taken", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:08:50.446793", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  actions_taken = []\n  \n  action_map = env.action_specs()\n  # Map action names to their integer IDs for clarity and direct use\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n  \n  world = env.world # Reference to the CraftWorld instance for environment details\n  \n  MAX_COLLECT_STEPS = 200 # A safety limit to prevent infinite loops\n\n  # Direction constants based on CraftState.dir attribute (0=N, 1=E, 2=S, 3=W)\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Mapping of relative (dx, dy) from agent's position to the required facing direction\n  # for the 'USE' action to be effective. (dx=column change, dy=row change)\n  RELATIVE_POS_TO_DIR = {\n      (0, -1): DIR_NORTH, # Target is North (UP) of agent\n      (1, 0): DIR_EAST,   # Target is East (RIGHT) of agent\n      (0, 1): DIR_SOUTH,  # Target is South (DOWN) of agent\n      (-1, 0): DIR_WEST   # Target is West (LEFT) of agent\n  }\n\n  # Mapping of movement actions to their corresponding (dx, dy) grid changes\n  MOVE_DELTAS = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # Define what entity types act as obstacles (cannot be walked through).\n  # This typically includes non-grabbable environment items and workshop locations.\n  OBSTACLE_INDICES = world.non_grabbable_indices.union(world.workshop_indices)\n\n  def _is_valid_grid_pos(x, y, grid_shape):\n      \"\"\"Checks if a given grid cell (x, y) is within the grid bounds.\"\"\"\n      width, height, _ = grid_shape\n      return 0 <= x < width and 0 <= y < height\n\n  def _is_walkable(x, y, grid, obstacle_indices, grid_shape):\n      \"\"\"Checks if a given grid cell (x, y) is within bounds and contains no obstacles.\"\"\"\n      if not _is_valid_grid_pos(x, y, grid_shape):\n          return False # Out of bounds\n      # Check if the cell contains any obstacle kind\n      for idx in obstacle_indices:\n          if grid[x, y, idx] == 1: # If this kind of entity is present, it's an obstacle\n              return False \n      return True # The cell is within bounds and free of obstacles\n\n  def _find_path_to_cardinal_adjacent_primitive(start_pos, target_primitive_idx, current_grid):\n      \"\"\"\n      Performs a Breadth-First Search (BFS) to find the shortest path (sequence of move actions)\n      from `start_pos` to any cell (px, py) such that (px, py) is *cardinally adjacent*\n      to an instance of `target_primitive_idx`.\n      This finds a path to a spot from which the agent can `USE` the primitive after orienting.\n      \n      Args:\n          start_pos (tuple): Agent's current (x, y) position.\n          target_primitive_idx (int): The index of the primitive kind to find.\n          current_grid (numpy.ndarray): The current state of the grid.\n\n      Returns:\n          list: A list of action IDs representing the shortest path, or None if no path found.\n      \"\"\"\n      grid_shape = current_grid.shape\n      \n      # BFS queue: stores (current_coordinates_x, current_coordinates_y, path_actions_taken_to_reach_here)\n      queue = deque([(start_pos[0], start_pos[1], [])])\n      visited = {(start_pos[0], start_pos[1])} # Set to keep track of visited coordinates to avoid loops\n\n      # Cardinal directions relative to the current BFS search node, to check for primitive presence\n      CARDINAL_NEIGHBORS_FOR_PRIMITIVE_CHECK = [(0, -1), (1, 0), (0, 1), (-1, 0)] # North, East, South, West\n\n      while queue:\n          curr_x, curr_y, path_so_far = queue.popleft()\n\n          # Check if the current cell (curr_x, curr_y) is a suitable \"landing spot\"\n          # meaning, is it cardinally adjacent to the target primitive?\n          for dx_nb, dy_nb in CARDINAL_NEIGHBORS_FOR_PRIMITIVE_CHECK:\n              nx_nb, ny_nb = curr_x + dx_nb, curr_y + dy_nb\n              if _is_valid_grid_pos(nx_nb, ny_nb, grid_shape) and current_grid[nx_nb, ny_nb, target_primitive_idx] == 1:\n                  # Found a cell (curr_x, curr_y) that is cardinally adjacent to the primitive.\n                  return path_so_far # This path leads to a position where agent can collect.\n\n          # Explore all four cardinal neighbors (UP, DOWN, LEFT, RIGHT) for movement\n          for action_val, (dx, dy) in MOVE_DELTAS.items():\n              next_x, next_y = curr_x + dx, curr_y + dy\n              next_pos_tuple = (next_x, next_y)\n\n              if _is_walkable(next_x, next_y, current_grid, OBSTACLE_INDICES, grid_shape) and next_pos_tuple not in visited:\n                  visited.add(next_pos_tuple)\n                  queue.append((next_x, next_y, path_so_far + [action_val]))\n      \n      return None # No path found to any cell cardinally adjacent to the primitive on the grid\n\n  # Primitives are items that can be picked up. If the goal `primitive` is not\n  # in the list of grabbable items, this function cannot collect it.\n  if primitive not in world.grabbable_indices:\n      return []\n\n  # Main loop for the collection process: Iteratively find, move, and collect.\n  for _ in range(MAX_COLLECT_STEPS):\n      # Access the current state of the environment\n      current_state = env._current_state \n      \n      # 1. Check if the primitive is already in the agent's inventory\n      if current_state.inventory[primitive] > 0:\n          return actions_taken # Goal achieved, primitive collected\n\n      # 2. Check if the agent is currently cardinally adjacent to the primitive\n      #    and can thus orient and perform the 'USE' action.\n      primitive_relative_pos_for_use = None # To store (dx, dy) if primitive is found cardinally\n      agent_x, agent_y = current_state.pos\n      grid_shape = current_state.grid.shape\n      \n      # Check the four cardinal directions around the agent for the primitive\n      CARDINAL_DIRECTIONS = [(0, -1), (1, 0), (0, 1), (-1, 0)] # North, East, South, West relative to agent\n      \n      for dx_c, dy_c in CARDINAL_DIRECTIONS:\n          nx_c, ny_c = agent_x + dx_c, agent_y + dy_c\n          if _is_valid_grid_pos(nx_c, ny_c, grid_shape) and current_state.grid[nx_c, ny_c, primitive] == 1:\n              primitive_relative_pos_for_use = (dx_c, dy_c)\n              break # Found the primitive in a cardinal direction\n\n      if primitive_relative_pos_for_use:\n          # The primitive is cardinally adjacent. Now, orient the agent towards it.\n          required_dir = RELATIVE_POS_TO_DIR.get(primitive_relative_pos_for_use)\n\n          if required_dir is not None: # This should always be true for (dx,dy) in CARDINAL_DIRECTIONS\n              current_dir = current_state.dir\n              while current_dir != required_dir:\n                  # Calculate the shortest turn (left or right)\n                  turn_right_steps = (required_dir - current_dir + 4) % 4\n                  turn_left_steps = (current_dir - required_dir + 4) % 4\n\n                  # Use LEFT/RIGHT actions for turning. This assumes they act as turns,\n                  # consistent with collect_v1's logic for agent orientation.\n                  turn_action = RIGHT if turn_right_steps <= turn_left_steps else LEFT\n                  \n                  _reward, done, _observations = env.step(turn_action)\n                  actions_taken.append(turn_action)\n                  current_state = env._current_state # Update state (including direction) after action\n                  current_dir = current_state.dir\n                  if done: return actions_taken # Episode ended (e.g., max_steps reached) during turning\n\n              # Agent is now oriented. Perform the 'USE' action to collect the primitive.\n              _reward, done, _observations = env.step(USE)\n              actions_taken.append(USE)\n              if done: return actions_taken # Episode ended after USE action\n              continue # Successfully used, loop again to re-evaluate state (check inventory)\n\n      # 3. If not cardinally adjacent and not in inventory, plan a path to a cardinally adjacent spot.\n      current_pos = current_state.pos\n      path_to_adjacent_spot = _find_path_to_cardinal_adjacent_primitive(\n          current_pos, primitive, current_state.grid\n      )\n\n      if path_to_adjacent_spot:\n          # If a path is found, take the first action on that path.\n          next_action = path_to_adjacent_spot[0]\n          _reward, done, _observations = env.step(next_action)\n          actions_taken.append(next_action)\n          if done: return actions_taken # Episode ended during movement\n      else:\n          # No path found to any cardinally adjacent instance of the primitive on the grid.\n          # This means it might be unreachable, or all instances have been collected/are gone.\n          break # Cannot collect the primitive, terminate the loop\n\n  return actions_taken # Return the sequence of actions taken", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:09:59.977370", "function_name": "collect", "function_body": "    # Define action constants based on CraftLab's action_specs\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n    MOVEMENT_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n    # Define directional changes for row and column for each movement action\n    DR = {UP: -1, DOWN: 1, LEFT: 0, RIGHT: 0}\n    DC = {UP: 0, DOWN: 0, LEFT: -1, RIGHT: 1}\n\n    # Get the current state observations from the environment\n    obs = env.observations()\n    initial_grid = obs['features_dict']['features_global']\n    initial_pos_normalized = obs['features_dict']['pos']\n    grid_height, grid_width, _ = initial_grid.shape\n\n    # Convert normalized agent position to integer grid coordinates\n    start_r, start_c = int(initial_pos_normalized[0] * grid_height), \\\n                       int(initial_pos_normalized[1] * grid_width)\n\n    # Identify all potential goal cells for BFS.\n    # A goal cell (target_r, target_c) is any cell from which the 'primitive'\n    # is within the 3x3 neighborhood (including (target_r,target_c) itself).\n    # This aligns with how CraftState.next_to works, and implies that being\n    # at one of these cells allows a 'USE' action to collect the primitive.\n    potential_goal_cells = set()\n    for r_item in range(grid_height):\n        for c_item in range(grid_width):\n            # Check if this cell contains the primitive\n            if initial_grid[r_item, c_item, primitive] > 0:\n                # If it does, add all cells in its 3x3 neighborhood to our set of potential goals\n                for dr_n in [-1, 0, 1]:\n                    for dc_n in [-1, 0, 1]:\n                        nr, nc = r_item + dr_n, c_item + dc_n\n                        # Ensure neighbor is within grid bounds\n                        if 0 <= nr < grid_height and 0 <= nc < grid_width:\n                            potential_goal_cells.add((nr, nc))\n\n    # If the primitive is not found anywhere on the map, no actions can collect it.\n    if not potential_goal_cells:\n        return []\n\n    # BFS Setup\n    # collections.deque is used for an efficient queue\n    import collections\n    # Queue stores tuples: (current_row, current_col, list_of_actions_to_reach_here)\n    queue = collections.deque([(start_r, start_c, [])])\n    # Visited set to prevent infinite loops and redundant paths\n    visited = set([(start_r, start_c)])\n\n    # Get indices of non-grabbable items that act as impassable terrain\n    # These are typically walls, water, workshops, etc., that block movement.\n    # We assume if a cell contains *any* of these, it's impassable.\n    impassable_kinds = env.world.non_grabbable_indices\n\n    while queue:\n        r, c, path = queue.popleft()\n\n        # Check if the current cell is one of our potential goal cells\n        if (r, c) in potential_goal_cells:\n            # We found a path to a cell from which the primitive can be 'USE'd\n            return path + [USE]\n\n        # Explore all possible movement actions from the current cell\n        for action in MOVEMENT_ACTIONS:\n            nr, nc = r + DR[action], c + DC[action]\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n                continue\n\n            # Check if the new position has already been visited\n            if (nr, nc) in visited:\n                continue\n\n            # Check if the new position is traversable.\n            # A cell is considered impassable if it contains any kind listed in `impassable_kinds`.\n            is_impassable = False\n            for kind_idx in impassable_kinds:\n                if initial_grid[nr, nc, kind_idx] > 0:\n                    is_impassable = True\n                    break\n\n            if is_impassable:\n                continue # Cannot move to this cell because it's blocked\n\n            # If the cell is traversable and not visited, add it to the queue\n            visited.add((nr, nc))\n            queue.append((nr, nc, path + [action]))\n\n    # If the queue becomes empty and no path to a goal cell was found\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:10:00.947790", "function_name": "collect", "function_body": "  import numpy as np\n  import collections # for deque for BFS\n\n  # Access current state information from the CraftLab environment\n  current_state = env._current_state\n  current_grid = current_state.grid\n  current_pos = current_state.pos\n  world = env.world # CraftWorld instance\n\n  # Get grid dimensions\n  GRID_WIDTH, GRID_HEIGHT, _ = current_grid.shape\n\n  # Find all primitive locations on the grid\n  primitive_locations = []\n  for r in range(GRID_WIDTH):\n      for c in range(GRID_HEIGHT):\n          # Check if the cell contains the desired primitive\n          if current_grid[r, c, primitive] == 1:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      # Primitive not found on the map, no actions needed\n      return []\n\n  # Find the closest primitive location using Manhattan distance\n  closest_primitive_loc = None\n  min_dist = float('inf')\n  for ploc in primitive_locations:\n      dist = abs(ploc[0] - current_pos[0]) + abs(ploc[1] - current_pos[1])\n      if dist < min_dist:\n          min_dist = dist\n          closest_primitive_loc = ploc\n\n  # Define possible movements (delta_row, delta_col) and their corresponding actions\n  # (dr, dc) -> action\n  DELTAS_TO_ACTIONS = {\n      (-1, 0): env_factory.UP,    # Move North\n      (1, 0): env_factory.DOWN,   # Move South\n      (0, -1): env_factory.LEFT,  # Move West\n      (0, 1): env_factory.RIGHT   # Move East\n  }\n\n  # Helper function to check if a position is valid and traversable\n  # A position is traversable if it's within bounds and doesn't contain a blocking non-grabbable item.\n  def is_valid_and_traversable(r, c):\n      if not (0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT):\n          return False\n      # world.is_free checks if the position is not occupied by a non-grabbable item\n      return world.is_free(current_grid, (r, c))\n\n  # Determine all target cells for BFS: any cell directly adjacent (4-directional)\n  # to the closest primitive's location.\n  target_adjacent_cells = set()\n  pr, pc = closest_primitive_loc\n  for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # 4 direct neighbors\n      nr, nc = pr + dr, pc + dc\n      # We only care if the adjacent cell is valid and traversable *by the agent*\n      if is_valid_and_traversable(nr, nc):\n          target_adjacent_cells.add((nr, nc))\n\n  # If the primitive is completely surrounded by untraversable cells, there might be no valid adjacent cells\n  if not target_adjacent_cells:\n      return []\n\n  # BFS to find the shortest path from current_pos to any target_adjacent_cells\n  queue = collections.deque([(current_pos, [])]) # (current_cell, path_so_far)\n  visited = {current_pos}\n\n  path_to_primitive_adj = None\n\n  while queue:\n      (r, c), path = queue.popleft()\n\n      # If current cell is one of the target adjacent cells, we found a path\n      if (r, c) in target_adjacent_cells:\n          path_to_primitive_adj = path\n          break\n\n      # Explore neighbors\n      for dr, dc in DELTAS_TO_ACTIONS:\n          nr, nc = r + dr, c + dc\n          \n          if (nr, nc) not in visited and is_valid_and_traversable(nr, nc):\n              visited.add((nr, nc))\n              queue.append(((nr, nc), path + [DELTAS_TO_ACTIONS[(dr, dc)]]))\n\n  if path_to_primitive_adj is None:\n      # No path found to any adjacent cell, e.g., agent is trapped or primitive is unreachable\n      return []\n\n  # The final action sequence includes the movement actions and then the USE action.\n  # The USE action in CraftWorld gathers any grabbable item in a 3x3 neighborhood,\n  # so being adjacent is sufficient.\n  return path_to_primitive_adj + [env_factory.USE]", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:11:55.576983", "function_name": "collect", "function_body": "  actions_taken = []\n  \n  # Get action integer IDs from the environment's action_specs\n  action_map = env.action_specs()\n  \n  # Get references to world for item type information\n  world = env.world\n  \n  # Define a reasonable max number of steps to prevent infinite loops\n  MAX_COLLECT_STEPS = 200 \n\n  # Map movement actions to (dx, dy) coordinate changes for BFS\n  # CraftWorld agent position `pos` is (column, row).\n  # UP: decreases row (y), column (x) stays same -> (0, -1)\n  # DOWN: increases row (y), column (x) stays same -> (0, 1)\n  # LEFT: decreases column (x), row (y) stays same -> (-1, 0)\n  # RIGHT: increases column (x), row (y) stays same -> (1, 0)\n  move_deltas = {\n      action_map['UP']: (0, -1),\n      action_map['DOWN']: (0, 1),\n      action_map['LEFT']: (-1, 0),\n      action_map['RIGHT']: (1, 0),\n  }\n  \n  # Helper to check if a position is within grid bounds\n  def _is_valid_pos(x, y, grid_shape):\n      width, height, _ = grid_shape\n      return 0 <= x < width and 0 <= y < height\n\n  # Helper function to find the shortest path to a cell adjacent to the target primitive\n  def _find_path_to_adjacent(start_pos, target_kind_idx, current_grid, grid_shape):\n      \"\"\"\n      Performs a BFS to find the shortest sequence of movement actions from start_pos\n      to any cell that is adjacent (8-directional) to an instance of target_kind_idx.\n      Returns the list of actions or None if no such path exists.\n      \"\"\"\n      queue = deque([(start_pos[0], start_pos[1], [])]) # (x, y, path_of_actions_to_reach_here)\n      visited = {(start_pos[0], start_pos[1])} # Keep track of visited positions to avoid cycles\n      \n      while queue:\n          px, py, path_so_far = queue.popleft()\n\n          # Check if the current BFS position (px, py) is adjacent to the primitive\n          # This is the target condition for the BFS\n          for dx_nb in [-1, 0, 1]:\n              for dy_nb in [-1, 0, 1]:\n                  if dx_nb == 0 and dy_nb == 0: # Skip the current cell\n                      continue\n                  nx_nb, ny_nb = px + dx_nb, py + dy_nb\n                  if _is_valid_pos(nx_nb, ny_nb, grid_shape) and current_grid[nx_nb, ny_nb, target_kind_idx] == 1:\n                      # Found a cell (px, py) which is adjacent to the target primitive\n                      return path_so_far\n          \n          # Explore valid and unvisited neighboring cells for movement\n          for action_val, (dx, dy) in move_deltas.items():\n              next_x, next_y = px + dx, py + dy\n              # For CraftWorld, agents can generally move onto any empty cell or cell\n              # occupied by a grabbable object. We only prevent out-of-bounds or revisited cells.\n              if _is_valid_pos(next_x, next_y, grid_shape) and (next_x, next_y) not in visited:\n                  visited.add((next_x, next_y))\n                  queue.append((next_x, next_y, path_so_far + [action_val]))\n      \n      return None # No path found\n\n  # Helper function to orient towards and use a nearby primitive\n  def _orient_and_use(current_state, target_kind_idx, grid_shape, action_map, env, all_actions_list):\n      \"\"\"\n      Attempts to orient the agent towards the target_kind_idx and then uses it.\n      Appends actions taken to `all_actions_list`.\n      Returns True if a USE action was performed and episode did not end, False otherwise.\n      \"\"\"\n      agent_x, agent_y = current_state.pos\n      primitive_location_nearby = None\n\n      # Find the specific primitive cell in the neighborhood.\n      # This provides the exact coordinates for orientation calculation.\n      for dx_nb in [-1, 0, 1]:\n          for dy_nb in [-1, 0, 1]:\n              if dx_nb == 0 and dy_nb == 0:\n                  continue\n              nx_nb, ny_nb = agent_x + dx_nb, agent_y + dy_nb\n              # Check the current grid to ensure the primitive is still at this specific location\n              if _is_valid_pos(nx_nb, ny_nb, grid_shape) and env._current_state.grid[nx_nb, ny_nb, target_kind_idx] == 1:\n                  primitive_location_nearby = (nx_nb, ny_nb)\n                  break\n          if primitive_location_nearby:\n              break\n      \n      if primitive_location_nearby is None:\n          return False # Primitive is not nearby, or was removed\n\n      target_x, target_y = primitive_location_nearby\n      dx_rel = target_x - agent_x\n      dy_rel = target_y - agent_y\n\n      # Determine the required direction to face the primitive based on relative position\n      # CraftWorld directions: 0=N, 1=E, 2=S, 3=W (corresponding to UP, RIGHT, DOWN, LEFT)\n      required_dir = -1\n      if dy_rel < 0: # Target is North (UP)\n          required_dir = 0\n      elif dx_rel > 0: # Target is East (RIGHT)\n          required_dir = 1\n      elif dy_rel > 0: # Target is South (DOWN)\n          required_dir = 2\n      elif dx_rel < 0: # Target is West (LEFT)\n          required_dir = 3\n      \n      if required_dir == -1: # This should not happen if a valid target was found\n          return False\n\n      # Orient the agent by turning until facing the required direction\n      current_dir = env._current_state.dir # Get the most current direction\n      while current_dir != required_dir:\n          # Calculate the shortest way to turn (left or right)\n          turn_right_steps = (required_dir - current_dir + 4) % 4\n          turn_left_steps = (current_dir - required_dir + 4) % 4\n\n          turn_action = action_map['RIGHT'] if turn_right_steps <= turn_left_steps else action_map['LEFT']\n          \n          _, done, _ = env.step(turn_action)\n          all_actions_list.append(turn_action)\n          if done:\n              return False # Episode ended during turning\n          current_dir = env._current_state.dir # Update direction after turn\n\n      # Now that the agent is oriented, perform the USE action\n      _, done, _ = env.step(action_map['USE'])\n      all_actions_list.append(action_map['USE'])\n      \n      return not done # Return True if USE was performed and episode did not end\n\n  # Main loop for finding and collecting the primitive\n  # First, check if the primitive is a known grabbable item.\n  # If it's not grabbable, this function cannot collect it via the 'USE' action.\n  if primitive not in world.grabbable_indices:\n      return []\n\n  path_to_primitive_adj = None # Stores the pre-computed sequence of movement actions\n\n  for _ in range(MAX_COLLECT_STEPS):\n    current_state = env._current_state # Get the most current state of the environment\n\n    # 1. Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n      return actions_taken # Goal achieved, primitive collected\n\n    # 2. Check if the agent is currently next to the primitive\n    if current_state.next_to(primitive):\n        # If next to it, attempt to orient towards it and use it.\n        # _orient_and_use appends actions and handles episode termination during turns/use.\n        success_and_not_done = _orient_and_use(\n            current_state, primitive, current_state.grid.shape, action_map, env, actions_taken\n        )\n        \n        # After attempting USE, the grid might have changed (primitive collected/removed).\n        # Invalidate the current path to force re-planning or re-evaluation in the next step.\n        path_to_primitive_adj = None \n        \n        if not success_and_not_done:\n            # If the orientation/use process failed or the episode ended (e.g., max steps hit),\n            # then break out of the collection loop as we cannot proceed.\n            break \n        \n        # If successfully used and episode is not done, continue to the next iteration.\n        # This is crucial to immediately re-check the inventory after a USE attempt.\n        continue \n\n    # 3. Agent is not next to the primitive, so we need to plan a path or follow an existing one.\n    if path_to_primitive_adj is None or len(path_to_primitive_adj) == 0:\n        # If no path is currently planned or the existing path is exhausted, find a new one.\n        path_to_primitive_adj = _find_path_to_adjacent(\n            current_state.pos, \n            primitive, \n            current_state.grid, # Use the current grid for path planning\n            current_state.grid.shape\n        )\n        \n        if path_to_primitive_adj is None:\n            # If no path can be found to any cell adjacent to the primitive,\n            # it means the primitive is currently unreachable or does not exist.\n            break # Cannot collect\n\n    # 4. Execute the next action in the pre-computed path.\n    if path_to_primitive_adj: \n        action_to_take = path_to_primitive_adj.pop(0) # Take the first step and remove it from the path\n        _, done, _ = env.step(action_to_take)\n        actions_taken.append(action_to_take)\n        \n        # If the environment indicates the episode is done (e.g., max_steps reached during movement)\n        if done:\n          break\n            \n  return actions_taken", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:11:56.547053", "function_name": "collect", "function_body": "  from collections import deque\n\n  actions_taken = []\n  \n  # Get action integer IDs from the environment's action_specs\n  action_map = env.action_specs()\n  \n  # Get references to world for item type information and impassable objects\n  world = env.world\n  \n  # Define a reasonable max number of steps to prevent infinite loops\n  MAX_COLLECT_STEPS = 200 \n\n  # Map movement actions to (dx, dy) coordinate changes for BFS\n  # CraftWorld agent position `pos` is (column, row).\n  # UP: decreases row (y), column (x) stays same -> (0, -1)\n  # DOWN: increases row (y), column (x) stays same -> (0, 1)\n  # LEFT: decreases column (x), row (y) stays same -> (-1, 0)\n  # RIGHT: increases column (x), row (y) stays same -> (1, 0)\n  move_deltas = {\n      action_map['UP']: (0, -1),\n      action_map['DOWN']: (0, 1),\n      action_map['LEFT']: (-1, 0),\n      action_map['RIGHT']: (1, 0),\n  }\n  \n  # Helper to check if a position is within grid bounds\n  def _is_valid_pos(x, y, grid_shape):\n      width, height, _ = grid_shape\n      return 0 <= x < width and 0 <= y < height\n\n  # Pre-calculate impassable kinds based on world attributes.\n  # Assuming non_grabbable_indices are generally impassable for movement,\n  # but excluding workshop_indices if they are considered walkable interaction points.\n  # This provides a more realistic pathfinding.\n  impassable_movement_kinds = set(world.non_grabbable_indices)\n  if hasattr(world, 'workshop_indices'):\n      # Remove workshop indices if they are understood as walkable locations for interaction\n      impassable_movement_kinds.difference_update(set(world.workshop_indices))\n\n  # Helper function to find the shortest path to a cell adjacent to the target primitive\n  def _find_path_to_adjacent(start_pos, target_kind_idx, current_grid, grid_shape):\n      \"\"\"\n      Performs a BFS to find the shortest sequence of movement actions from start_pos\n      to any cell that is adjacent (8-directional) to an instance of target_kind_idx.\n      Considers cells occupied by `impassable_movement_kinds` as non-traversable for movement.\n      Returns the list of actions or None if no such path exists.\n      \"\"\"\n      queue = deque([(start_pos[0], start_pos[1], [])]) # (x, y, path_of_actions_to_reach_here)\n      visited = {(start_pos[0], start_pos[1])} # Keep track of visited positions to avoid cycles\n      \n      while queue:\n          px, py, path_so_far = queue.popleft()\n\n          # Check if the current BFS position (px, py) is adjacent to the primitive\n          is_adjacent_to_primitive = False\n          # Iterate over a 3x3 neighborhood, including diagonals, excluding the current cell\n          for dx_nb in [-1, 0, 1]:\n              for dy_nb in [-1, 0, 1]:\n                  if dx_nb == 0 and dy_nb == 0: # Skip the current cell (agent's position)\n                      continue\n                  nx_nb, ny_nb = px + dx_nb, py + dy_nb\n                  if _is_valid_pos(nx_nb, ny_nb, grid_shape) and current_grid[nx_nb, ny_nb, target_kind_idx] == 1:\n                      is_adjacent_to_primitive = True\n                      break\n              if is_adjacent_to_primitive:\n                  break\n          \n          if is_adjacent_to_primitive:\n              # This (px, py) is a target position for the agent to move to.\n              # path_so_far is the shortest sequence of actions to reach this position.\n              return path_so_far # Path found, exit BFS\n              \n          # Explore valid, unvisited, and *traversable* neighboring cells for movement\n          for action_val, (dx, dy) in move_deltas.items():\n              next_x, next_y = px + dx, py + dy\n              \n              if _is_valid_pos(next_x, next_y, grid_shape) and (next_x, next_y) not in visited:\n                  # Check if the cell at (next_x, next_y) is traversable\n                  is_traversable = True\n                  for k in impassable_movement_kinds:\n                      if current_grid[next_x, next_y, k] == 1: # If the cell contains an impassable object\n                          is_traversable = False\n                          break\n                  \n                  if is_traversable:\n                      visited.add((next_x, next_y))\n                      queue.append((next_x, next_y, path_so_far + [action_val]))\n      \n      return None # No path found to any cell adjacent to the primitive\n\n  # Check if the primitive is a known grabbable item.\n  # If it's not grabbable, this function cannot collect it.\n  if primitive not in world.grabbable_indices:\n      return []\n\n  path_to_primitive_adj = None # Stores the pre-computed sequence of movement actions\n\n  # Main loop for finding and collecting the primitive\n  for _ in range(MAX_COLLECT_STEPS):\n    current_state = env._current_state # Direct access to the internal CraftState\n    \n    # 1. Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n      return actions_taken # Goal achieved\n\n    # 2. Check if the agent is currently next to the primitive, and if so, orient and use it\n    primitive_location_nearby = None\n    agent_x, agent_y = current_state.pos\n    grid = current_state.grid # Use the current grid state for checks\n    \n    # Iterate through 3x3 neighborhood (excluding center) to find primitive\n    for dx_nb in [-1, 0, 1]:\n        for dy_nb in [-1, 0, 1]:\n            if dx_nb == 0 and dy_nb == 0: # Skip agent's own cell (agent is not 'next to' itself)\n                continue\n            \n            nx_nb, ny_nb = agent_x + dx_nb, agent_y + dy_nb\n            if _is_valid_pos(nx_nb, ny_nb, grid.shape) and grid[nx_nb, ny_nb, primitive] == 1:\n                primitive_location_nearby = (nx_nb, ny_nb)\n                break\n        if primitive_location_nearby:\n            break\n            \n    if primitive_location_nearby:\n        # Agent is next to a primitive. Now orient and USE.\n        target_x, target_y = primitive_location_nearby\n        \n        # Calculate required direction from agent_x, agent_y to target_x, target_y\n        dx_rel = target_x - agent_x\n        dy_rel = target_y - agent_y\n\n        required_dir = -1\n        # Map (dx, dy) to a direction integer (0=N, 1=E, 2=S, 3=W)\n        if dy_rel < 0: # Target is North (UP, dir 0)\n            required_dir = 0\n        elif dx_rel > 0: # Target is East (RIGHT, dir 1)\n            required_dir = 1\n        elif dy_rel > 0: # Target is South (DOWN, dir 2)\n            required_dir = 2\n        elif dx_rel < 0: # Target is West (LEFT, dir 3)\n            required_dir = 3\n        \n        # Orient the agent if not already facing the required direction\n        current_dir = current_state.dir\n        episode_done = False\n        if required_dir != -1: # Ensure a valid target direction was found\n            while current_dir != required_dir:\n                # Calculate shorter turn (right or left)\n                turn_right_steps = (required_dir - current_dir + 4) % 4\n                turn_left_steps = (current_dir - required_dir + 4) % 4\n\n                turn_action = action_map['RIGHT'] if turn_right_steps <= turn_left_steps else action_map['LEFT']\n                \n                _reward, done, _observations = env.step(turn_action)\n                actions_taken.append(turn_action)\n                current_state = env._current_state # Update state after turn\n                current_dir = current_state.dir\n                if done:\n                    episode_done = True\n                    break\n        \n        if episode_done:\n            break # Break from main loop if episode ended during turning\n\n        # Now agent is oriented (or was already), perform USE\n        _reward, done, _observations = env.step(action_map['USE'])\n        actions_taken.append(action_map['USE'])\n        # Invalidate the path after USE, as the primitive might have been collected or grid changed\n        path_to_primitive_adj = None \n        if done:\n            break # Episode finished\n        continue # Successfully used, go to next iteration to re-check inventory immediately\n\n    # 3. Path Planning or Path Following\n    if path_to_primitive_adj is None or len(path_to_primitive_adj) == 0:\n        # If no path is currently planned or the existing path is exhausted, find a new one\n        path_to_primitive_adj = _find_path_to_adjacent(\n            current_state.pos, \n            primitive, \n            current_state.grid, \n            current_state.grid.shape\n        )\n        \n        if path_to_primitive_adj is None:\n            # If no path can be found to the primitive (e.g., it's unreachable or doesn't exist),\n            # then we cannot collect it.\n            break\n\n    # 4. Execute the next action in the pre-computed path\n    if path_to_primitive_adj: # Check if path is not empty after potential replanning\n        action_to_take = path_to_primitive_adj.pop(0) # Take the first step and remove it from the planned path\n        _reward, done, _observations = env.step(action_to_take)\n        actions_taken.append(action_to_take)\n        \n        # If the environment indicates the episode is done (e.g., max_steps reached)\n        if done:\n          break\n    else:\n        # This branch should ideally not be reached if `path_to_primitive_adj` was None in the previous step,\n        # leading to a break. It handles a truly empty path_to_primitive_adj here.\n        break\n            \n  return actions_taken", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:14:21.515734", "function_name": "collect", "function_body": "  # Action mappings for CraftLab\n  # These are fixed and can be hardcoded or dynamically fetched from env.action_specs()\n  # Hardcoding for simplicity, as they are static for this environment.\n  _ACTIONS = {\n      'DOWN': 0, 'UP': 1, 'LEFT': 2, 'RIGHT': 3, 'USE': 4\n  }\n\n  # Direction deltas (dx, dy) for N, E, S, W (0, 1, 2, 3)\n  # Corresponds to UP, RIGHT, DOWN, LEFT actions if they set facing direction\n  # DMLab convention: N=0, E=1, S=2, W=3\n  _DIR_DELTAS = [\n      (0, -1), # 0: North (UP action typically moves North and sets dir to 0)\n      (1, 0),  # 1: East (RIGHT action typically moves East and sets dir to 1)\n      (0, 1),  # 2: South (DOWN action typically moves South and sets dir to 2)\n      (-1, 0)  # 3: West (LEFT action typically moves West and sets dir to 3)\n  ]\n\n  # Memoization for `_plan_collect` to avoid recomputing subgoals.\n  # Key: (item_idx, (pos_x, pos_y), dir, inventory_tuple)\n  # Value: (actions_list, resulting_state) if found, or None\n  _memo_plan = {} # This dictionary needs to be defined within the function scope.\n\n  # Get initial state and world properties from the environment\n  initial_craft_state = env._current_state\n  cookbook = env.world.cookbook\n  grabbable_indices = env.world.grabbable_indices\n  workshop_indices = env.world.workshop_indices\n  WIDTH, HEIGHT, _ = initial_craft_state.grid.shape # Get grid dimensions\n\n  def _get_path_bfs(start_state, target_predicate_state):\n      \"\"\"\n      Performs a BFS starting from `start_state` to find a `CraftState` that satisfies\n      `target_predicate_state`.\n      Returns `(list_of_actions, final_state)` or `(None, None)`.\n      The `target_predicate_state` should be a function `(CraftState) -> bool`.\n      Only considers movement actions.\n      \"\"\"\n      q = collections.deque([(start_state, [])])\n      # Visited states: (pos_x, pos_y, dir)\n      visited = {(start_state.pos, start_state.dir)}\n\n      while q:\n          current_s, current_path = q.popleft()\n\n          if target_predicate_state(current_s):\n              return current_path, current_s\n\n          # Explore movement actions (UP, DOWN, LEFT, RIGHT)\n          for action_name, action_val in _ACTIONS.items():\n              if action_name == 'USE': continue # Only movement for BFS\n\n              # Simulate the step to get the next state\n              # The CraftState.step handles movement, direction, and collision implicitly\n              _reward, next_s = current_s.step(action_val)\n              \n              # If the step results in no change (e.g., hitting a wall, or invalid move), don't re-explore\n              # This heuristic helps prune paths that hit impassable terrain or are redundant.\n              if (next_s.pos, next_s.dir) == (current_s.pos, current_s.dir) and next_s is not current_s:\n                  continue \n\n              state_signature = (next_s.pos, next_s.dir)\n              if state_signature not in visited:\n                  visited.add(state_signature)\n                  q.append((next_s, current_path + [action_val]))\n      \n      return None, None # No path found\n\n  def _plan_collect(current_state, target_item_idx):\n      \"\"\"\n      Recursively plans actions to collect `target_item_idx` starting from `current_state`.\n      Returns `(list_of_actions, final_state_after_plan)` or `(None, None)` if impossible.\n      \"\"\"\n      # Memoization check\n      # Use a tuple for inventory for hashability, as numpy arrays are not hashable.\n      state_key = (target_item_idx, current_state.pos, current_state.dir, tuple(current_state.inventory))\n      if state_key in _memo_plan:\n          return _memo_plan[state_key]\n\n      # Base case: Already have the item in inventory\n      if current_state.inventory[target_item_idx] > 0:\n          _memo_plan[state_key] = ([], current_state)\n          return [], current_state\n\n      # Case 1: Target is a grabbable item present on the grid\n      if target_item_idx in grabbable_indices:\n          # Define the predicate for the target state: agent needs to be facing the item\n          def is_grabbable_target_state(s):\n              # Calculate the coordinates of the cell directly in front of the agent\n              facing_pos_x = s.pos[0] + _DIR_DELTAS[s.dir][0]\n              facing_pos_y = s.pos[1] + _DIR_DELTAS[s.dir][1]\n              facing_pos = (facing_pos_x, facing_pos_y)\n              \n              # Check if facing position is within grid bounds\n              if not (0 <= facing_pos_x < WIDTH and 0 <= facing_pos_y < HEIGHT):\n                  return False\n              \n              # Check if the cell in front contains the target item\n              return s.grid[facing_pos_x, facing_pos_y, target_item_idx] > 0\n\n          path_to_grab_pos, state_at_grab_pos = _get_path_bfs(current_state, is_grabbable_target_state)\n\n          if path_to_grab_pos is not None:\n              # We are at the position and facing the item, now perform USE action\n              _r, next_s_after_use = state_at_grab_pos.step(_ACTIONS['USE'])\n              \n              # Check if the item was successfully collected (inventory increased)\n              # This is important as USE might fail if prerequisites are not met (e.g., item depleted)\n              if next_s_after_use.inventory[target_item_idx] > current_state.inventory[target_item_idx]:\n                  result = (path_to_grab_pos + [_ACTIONS['USE']], next_s_after_use)\n                  _memo_plan[state_key] = result\n                  return result\n          # If no path found, or collection failed, fall through to crafting logic\n\n      # Case 2: Target is a craftable item (has a recipe)\n      recipe = cookbook.recipes.get(target_item_idx)\n      if recipe:\n          current_plan_for_crafting = []\n          current_state_for_crafting = current_state\n\n          # First, plan to collect all required ingredients.\n          # Iterate through ingredients and their counts.\n          # A greedy approach: collect missing ingredients one by one.\n          ingredients_collected_successfully = True\n          # Process ingredients in a stable order (e.g., by index) for consistent planning\n          for ing_idx, needed_count in sorted(recipe.items(), key=lambda x: x[0]): \n              for _ in range(needed_count): # Collect `needed_count` times\n                  # Check if we already have enough of this ingredient after previous collections in this chain\n                  if current_state_for_crafting.inventory[ing_idx] >= needed_count:\n                      break # Enough of this ingredient, move to next item/count\n                  \n                  # Recursively plan to collect this missing ingredient\n                  ing_plan_actions, ing_final_state = _plan_collect(current_state_for_crafting, ing_idx)\n                  \n                  if ing_plan_actions is None:\n                      ingredients_collected_successfully = False\n                      break # Cannot collect this ingredient, so cannot craft target\n\n                  current_plan_for_crafting.extend(ing_plan_actions)\n                  current_state_for_crafting = ing_final_state # Update state for next planning step\n              if not ingredients_collected_successfully:\n                  break\n          \n          if ingredients_collected_successfully:\n              # All ingredients are now collected (or assumed to be via simulation).\n              # Next, move to a workshop to craft.\n              def is_workshop_target_state(s):\n                  # Agent needs to be on a workshop cell\n                  for ws_idx in workshop_indices:\n                      if s.grid[s.pos[0], s.pos[1], ws_idx] > 0:\n                          return True\n                  return False\n\n              path_to_workshop, state_at_workshop = _get_path_bfs(current_state_for_crafting, is_workshop_target_state)\n\n              if path_to_workshop is not None:\n                  # At workshop, now perform USE action to craft\n                  _r, final_crafted_state = state_at_workshop.step(_ACTIONS['USE'])\n                  \n                  # Check if crafting was successful (inventory increased)\n                  # This implies USE at a workshop consumes ingredients and produces output.\n                  if final_crafted_state.inventory[target_item_idx] > current_state.inventory[target_item_idx]:\n                      result = (current_plan_for_crafting + path_to_workshop + [_ACTIONS['USE']], final_crafted_state)\n                      _memo_plan[state_key] = result\n                      return result\n              \n      # If item is neither grabbable nor craftable, or planning failed for any reason\n      _memo_plan[state_key] = (None, None)\n      return None, None\n\n  # Start the planning process from the initial environment state.\n  # Clear memoization cache for a fresh plan if collect_v2 is called multiple times\n  # on potentially different initial states or goals.\n  _memo_plan.clear() \n\n  actions_plan, final_state_after_plan = _plan_collect(initial_craft_state, primitive)\n\n  if actions_plan is None:\n      # If planning failed to find a sequence of actions, return an empty list.\n      return []\n  else:\n      return actions_plan", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:14:22.489069", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # 1. Initialize action constants from env\n  action_map = env.action_specs()\n  A_UP = action_map['UP']\n  A_DOWN = action_map['DOWN']\n  A_LEFT = action_map['LEFT']\n  A_RIGHT = action_map['RIGHT']\n  A_USE = action_map['USE']\n\n  # Defines movement deltas and resulting directions for absolute actions\n  # Action: (dr, dc, new_dir) for agent at (r,c) moving to (r+dr, c+dc) and facing new_dir\n  # CraftState.dir: 0: UP, 1: RIGHT, 2: DOWN, 3: LEFT\n  move_deltas = {\n      A_UP:    (-1, 0, 0), # Move North, face North (dir=0)\n      A_DOWN:  (1, 0, 2),  # Move South, face South (dir=2)\n      A_LEFT:  (0, -1, 3), # Move West, face West (dir=3)\n      A_RIGHT: (0, 1, 1)   # Move East, face East (dir=1)\n  }\n\n  initial_state = env._current_state\n  \n  # 2. Check if primitive is already in inventory\n  if initial_state.inventory[primitive] > 0:\n    return []\n\n  grid = initial_state.grid\n  grid_height, grid_width, _ = grid.shape\n  \n  # Get indices for blocking entities\n  # env.non_grabbable_indices typically include walls, water, etc., that block movement\n  blocking_indices = env.non_grabbable_indices\n\n  # 3. Find all locations of the primitive on the grid\n  primitive_locations = []\n  for r in range(grid_height):\n    for c in range(grid_width):\n      if grid[r, c, primitive] == 1:\n        primitive_locations.append((r, c))\n\n  if not primitive_locations:\n    # Primitive not found on the grid, cannot collect\n    return []\n\n  # 4. BFS to find a path to a suitable position for 'USE'\n  queue = collections.deque()\n  visited = set() # Stores ((r, c), dir)\n  # path_map stores ((current_r, current_c), current_dir) -> ((prev_r, prev_c), prev_dir, action_to_get_here)\n  path_map = {} \n\n  start_pos = initial_state.pos\n  start_dir = initial_state.dir # 0: UP, 1: RIGHT, 2: DOWN, 3: LEFT\n  start_node = (start_pos, start_dir)\n\n  queue.append(start_node)\n  visited.add(start_node)\n  path_map[start_node] = (None, None, None) # No previous node or action for start\n\n  target_node_for_use = None\n\n  while queue:\n    (current_r, current_c), current_dir = queue.popleft()\n    current_pos = (current_r, current_c)\n\n    # Check if this state allows using the primitive\n    for pr, pc in primitive_locations:\n        # Calculate the cell the agent would \"USE\" on based on current_dir\n        cell_in_front = None\n        if current_dir == 0: # UP\n            cell_in_front = (current_r - 1, current_c)\n        elif current_dir == 1: # RIGHT\n            cell_in_front = (current_r, current_c + 1)\n        elif current_dir == 2: # DOWN\n            cell_in_front = (current_r + 1, current_c)\n        elif current_dir == 3: # LEFT\n            cell_in_front = (current_r, current_c - 1)\n        \n        if cell_in_front == (pr, pc):\n            target_node_for_use = (current_pos, current_dir)\n            break # Found a path to a position/direction for USE\n    \n    if target_node_for_use:\n      break # Path found, stop BFS\n\n    # Explore valid moves from current state\n    for action, (dr, dc, new_dir) in move_deltas.items():\n      new_r, new_c = current_r + dr, current_c + dc\n      new_pos = (new_r, new_c)\n\n      # Boundary check\n      if not (0 <= new_r < grid_height and 0 <= new_c < grid_width):\n        continue\n\n      # Obstacle check: Cannot move into a cell occupied by a blocking item\n      is_blocked = False\n      for idx in blocking_indices:\n          if grid[new_r, new_c, idx] == 1:\n              is_blocked = True\n              break\n      if is_blocked:\n          continue\n\n      # Cannot move onto the primitive itself, only adjacent to it to USE it\n      if grid[new_r, new_c, primitive] == 1:\n          continue\n\n      new_state_key = (new_pos, new_dir)\n      if new_state_key not in visited:\n        visited.add(new_state_key)\n        queue.append(new_state_key)\n        # Store (previous_position, previous_direction, action_taken_to_reach_new_state)\n        path_map[new_state_key] = (current_pos, current_dir, action) \n\n  # 5. Reconstruct path if target found\n  if not target_node_for_use:\n    return [] # No path found\n\n  path_actions = []\n  curr_node = target_node_for_use\n  \n  # Backtrack from target_node_for_use to start_node\n  # path_map[curr_node] = (prev_pos, prev_dir, action_to_get_to_curr)\n  while path_map[curr_node][0] is not None: # Stop when prev_pos is None (i.e., at start_node)\n    _, _, action = path_map[curr_node] # Get the action that led to curr_node\n    path_actions.append(action)\n    curr_node = (path_map[curr_node][0], path_map[curr_node][1]) # Move to the previous node\n\n  path_actions.reverse() # Path is built in reverse, so reverse it\n  path_actions.append(A_USE) # Add the final USE action\n\n  return path_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:15:50.550606", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Define a maximum number of steps for the BFS to find a path.\n  # This prevents excessively long search times and limits the length of the generated action sequence.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to calculate the grid coordinates of the cell directly in front of the agent.\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent.\n\n      Args:\n          y (int): Agent's current row coordinate.\n          x (int): Agent's current column coordinate.\n          direction (int): Agent's current facing direction (DIR_EAST, DIR_SOUTH, DIR_WEST, DIR_NORTH).\n\n      Returns:\n          tuple[int, int]: (row, column) coordinates of the cell in front.\n      \"\"\"\n      if direction == DIR_EAST:\n          return y, x + 1\n      elif direction == DIR_SOUTH:\n          return y + 1, x\n      elif direction == DIR_WEST:\n          return y, x - 1\n      elif direction == DIR_NORTH:\n          return y - 1, x\n      # This case should ideally not be reached with valid direction inputs.\n      return y, x\n\n  actions_taken = []\n\n  # Access the underlying CraftState instance directly to get the current state information.\n  # This allows `collect_v2` to be called mid-episode without resetting the environment.\n  current_state = env._current_state\n\n  # Basic validation: Ensure the `primitive` is a recognized entity kind in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # Optimization: If the `primitive` is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Retrieve necessary environment information for pathfinding.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir\n\n  # Define which entity kinds block agent movement.\n  # These are generally non-grabbable items that are not workshops (e.g., water, walls, trees).\n  impassable_for_movement = set()\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  for k_idx in current_state.world.non_grabbable_indices:\n      # Workshops (like workbench, furnace) are often non-grabbable but traversable.\n      if k_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # The agent's direction automatically updates based on the cardinal direction of its last movement.\n  # Format: {ACTION: (resulting_direction, dy, dx)}\n  movement_actions_map = {\n      ACTION_UP:    (DIR_NORTH, -1, 0),  # Action UP (1): moves North (dy=-1, dx=0), agent faces North (DIR_NORTH=3)\n      ACTION_RIGHT: (DIR_EAST, 0, 1),    # Action RIGHT (3): moves East (dy=0, dx=1), agent faces East (DIR_EAST=0)\n      ACTION_DOWN:  (DIR_SOUTH, 1, 0),   # Action DOWN (0): moves South (dy=1, dx=0), agent faces South (DIR_SOUTH=1)\n      ACTION_LEFT:  (DIR_WEST, 0, -1)    # Action LEFT (2): moves West (dy=0, dx=-1), agent faces West (DIR_WEST=2)\n  }\n\n  q = collections.deque()\n  # BFS queue state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  # Storing the current direction is crucial because `ACTION_USE` is dependent on agent orientation\n  # for non-grabbable items, and for BFS exploration, each unique (pos, dir) is a distinct state.\n\n  # If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # Initialize BFS: Start from the agent's current position and direction with an empty action path.\n  q.append((start_y, start_x, start_dir, []))\n  # Keep track of visited states (position + orientation) to prevent redundant exploration and infinite loops.\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None  # This variable will store the final sequence of actions if a valid path is found.\n\n  # Determine if the primitive is a \"grabbable\" item (picked up by moving onto its cell and using USE).\n  # Or if it's a \"non-grabbable\" item (interacted with from an adjacent cell).\n  is_primitive_grabbable = primitive in current_state.world.grabbable_indices\n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Optimization: If the current path length already exceeds MAX_COLLECT_STEPS,\n      # this branch cannot lead to a valid solution within the specified limits.\n      if len(path) >= MAX_COLLECT_STEPS: # Use >= because we still need space for ACTION_USE\n          continue\n\n      # --- Goal Check: Determine if the primitive can be collected from the current state (position and direction) ---\n\n      # Scenario 1: Primitive is \"grabbable\" and located on the agent's current cell.\n      # In this case, ACTION_USE picks it up, regardless of the agent's facing direction.\n      if is_primitive_grabbable and full_grid[curr_y, curr_x, primitive] > 0:\n          candidate_path = path + [ACTION_USE]\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              # BFS guarantees the shortest path, so we can stop once a valid one is found.\n              break \n      \n      # Scenario 2: Primitive is \"non-grabbable\" and located in the cell the agent is currently facing.\n      # In this case, ACTION_USE interacts with the object in front.\n      elif not is_primitive_grabbable: # Only consider this if it's not a grabbable item\n          facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n          # Check if the facing cell is within grid boundaries and contains the target primitive.\n          if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n              full_grid[facing_y, facing_x, primitive] > 0):\n              \n              candidate_path = path + [ACTION_USE]\n              if len(candidate_path) <= MAX_COLLECT_STEPS:\n                  path_to_execute = candidate_path\n                  break # Found the shortest path, exit BFS.\n\n      # --- Explore neighboring cells via movement actions ---\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          \n          # Pruning: If adding this move makes the path too long, skip.\n          if len(path) + 1 >= MAX_COLLECT_STEPS: # >= because we still need space for final ACTION_USE\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable.\n          # A cell is not traversable if it contains any item in the `impassable_for_movement` set.\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          # Special consideration: If the target primitive itself is non-grabbable and is in the `impassable_for_movement` set,\n          # then we cannot move onto its cell. The logic above handles this correctly because `impassable_for_movement`\n          # will contain non-grabbable non-workshop items.\n          if not is_traversable:\n              continue\n\n          # Check if this new (position, direction) state has already been visited.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # If all checks pass, add the new state to the queue for further exploration.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      # If no valid path was found within the step limit, return an empty list.\n      return []\n\n  for action in path_to_execute:\n      actions_taken.append(action)\n      # Perform the action in the environment.\n      # We ignore reward and observation for the purpose of this planning function.\n      reward, done, _ = env.step(action)\n      \n      # Update the internal state reference after each step to reflect the current environment.\n      current_state = env._current_state\n\n      # Check for early termination of the episode or if the goal was satisfied.\n      # If the episode ends (done is True) before the primitive is collected, it implies failure.\n      if done and current_state.inventory[primitive] <= 0:\n          return []\n\n      # If the primitive is successfully collected at any point, we can stop and return the path.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n  # Final check: After executing all actions in the `path_to_execute`, confirm collection.\n  # This handles cases where the primitive is collected on the very last action.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it indicates a discrepancy (e.g., dynamic environment changes, or logical error).\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:15:51.536778", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      ACTION_UP: DIR_NORTH,   # Agent moves North, faces North\n      ACTION_DOWN: DIR_SOUTH, # Agent moves South, faces South\n      ACTION_LEFT: DIR_WEST,  # Agent moves West, faces West\n      ACTION_RIGHT: DIR_EAST  # Agent moves East, faces East\n  }\n\n  # Maximum number of steps allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent,\n      based on CraftState.dir (0=East, 1=South, 2=West, 3=North).\n      \"\"\"\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return (y, x) # Fallback, should not be reached with valid directions\n\n  actions_taken = []\n\n  # Access the underlying CraftState instance to get the current state information.\n  # This function computes actions from the *current* state of the environment,\n  # allowing it to be chained with other actions or used as part of a larger plan.\n  current_state = env._current_state\n\n  # Improvement 1: Check if the primitive is actually a grabbable item.\n  # If it's not in the world's grabbable_indices, it cannot be collected by ACTION_USE.\n  if primitive not in current_state.world.grabbable_indices:\n      return []\n\n  # Basic validation: Ensure the `primitive` is a recognized entity kind in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # Optimization: If the `primitive` is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Retrieve necessary environment information for pathfinding.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir # Use current_state.dir, as env is not reset to init_dir.\n\n  # Determine which entity kinds are impassable for agent movement.\n  impassable_for_movement = set()\n  # Water is typically impassable for movement.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  # Any non-grabbable items that are NOT workshops are generally impassable.\n  # Workshops (e.g., workbench, furnace) are usually traversable, even if they can't be picked up.\n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # Format: {action: (resulting_direction_after_move, dy, dx)}\n  # The agent's direction automatically updates based on the movement action performed.\n  movement_actions_map = {\n      ACTION_UP:    (ACTION_TO_DIR[ACTION_UP], -1, 0),    # Move North (dy=-1, dx=0), new dir=DIR_NORTH\n      ACTION_DOWN:  (ACTION_TO_DIR[ACTION_DOWN], 1, 0),   # Move South (dy=1, dx=0), new dir=DIR_SOUTH\n      ACTION_LEFT:  (ACTION_TO_DIR[ACTION_LEFT], 0, -1),  # Move West (dy=0, dx=-1), new dir=DIR_WEST\n      ACTION_RIGHT: (ACTION_TO_DIR[ACTION_RIGHT], 0, 1)  # Move East (dy=0, dx=1), new dir=DIR_EAST\n  }\n\n  q = collections.deque()\n  # BFS queue state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  # Storing the current direction is crucial because `ACTION_USE` is dependent on agent orientation.\n  q.append((start_y, start_x, start_dir, []))\n  \n  # Keep track of visited states to prevent redundant exploration and infinite loops in cyclic maps.\n  # A state is defined by (position_y, position_x, direction) because the same grid cell\n  # with a different orientation constitutes a distinct state for the purpose of `ACTION_USE`.\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None  # This variable will store the final sequence of actions if a valid path is found.\n\n  # If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Optimization: If the current path length already exceeds MAX_COLLECT_STEPS,\n      # this branch cannot lead to a valid solution within the specified limits.\n      # We check `len(path) >= MAX_COLLECT_STEPS` because at least one action (ACTION_USE)\n      # will be added to the path to reach the goal.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # Calculate the coordinates of the grid cell that the agent is currently facing.\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Check if the facing cell is within grid boundaries and contains the target primitive.\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n          full_grid[facing_y, facing_x, primitive] > 0):\n\n          # We've found a position and orientation from which `ACTION_USE` can be performed successfully.\n          candidate_path = path + [ACTION_USE]\n\n          # Ensure the complete path (including the final `ACTION_USE`) is within the step limit.\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              # Since BFS guarantees finding the shortest path first, we can stop as soon as one is found.\n              break # Exit the BFS loop\n\n      # Explore all possible next states from the current state (curr_y, curr_x, curr_dir).\n      # This involves trying each possible movement action.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Pruning: If adding this move makes the path too long (considering the final USE action), skip.\n          if len(path) + 1 >= MAX_COLLECT_STEPS: # +1 for the movement itself\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable based on the `impassable_for_movement` set.\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # Check if this new (position, direction) state has already been visited.\n          # This prevents redundant work and infinite loops in cyclic environments.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # If all checks pass, add the new state to the queue for further exploration.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      # If no valid path was found within the step limit, return an empty list.\n      return []\n\n  for action in path_to_execute:\n      actions_taken.append(action)\n      # Perform the action in the environment.\n      reward, done, _ = env.step(action)\n      # Update the internal state reference after each step to reflect the current environment.\n      current_state = env._current_state\n\n      # Check for early termination of the episode without successfully collecting the primitive.\n      # This ensures robustness if the environment ends due to other reasons (e.g., `max_steps` reached\n      # by `CraftLab`) before the collection is complete.\n      if done and current_state.inventory[primitive] <= 0:\n          return []  # Episode ended, but the goal was not satisfied.\n\n      # If the primitive is collected, we can stop executing the remaining actions in the path.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n  # Final check after executing all actions in the `path_to_execute`.\n  # This handles cases where the primitive is collected on the very last action of the path.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it indicates a discrepancy (e.g., the primitive disappeared dynamically,\n      # or a tool/prerequisite was needed that the current state didn't account for),\n      # which should ideally not happen if the BFS logic is perfectly aligned with environment mechanics.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:17:10.943825", "function_name": "collect", "function_body": "    # Action constants for CraftWorld (standard DMLab-like actions)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n    ALL_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n    # Get the initial state from the environment wrapper.\n    # CraftLab stores the current CraftState in its _current_state attribute.\n    initial_craft_state = env._current_state\n\n    # Initialize the queue for Breadth-First Search (BFS).\n    # Each element in the queue is a tuple: (current_CraftState_instance, list_of_actions_taken_to_reach_this_state).\n    # Using a standard Python list as a queue with pop(0) due to potential restrictions on `collections.deque` import.\n    q = [] \n    q.append((initial_craft_state, []))\n\n    # Initialize the set of visited states to prevent cycles and redundant computations.\n    # A state is defined by (agent_position_tuple, agent_direction_int, boolean_indicating_if_primitive_is_in_inventory).\n    # This simplified state representation is sufficient for the \"collect one primitive\" goal.\n    initial_pos_tuple = initial_craft_state.pos\n    initial_dir = initial_craft_state.dir\n    initial_has_primitive = initial_craft_state.inventory[primitive] > 0\n    \n    visited = set()\n    visited.add((initial_pos_tuple, initial_dir, initial_has_primitive))\n\n    # BFS loop\n    while q:\n        # Dequeue the current state and the path leading to it.\n        # pop(0) on a list is O(N) but acceptable for typical grid sizes.\n        current_state, current_path = q.pop(0)\n\n        # Check if the goal (primitive is in inventory) is satisfied in the current state.\n        if current_state.inventory[primitive] > 0:\n            return current_path\n\n        # Explore all possible actions from the current state.\n        for action in ALL_ACTIONS:\n            # Simulate the action to get the next CraftState.\n            # CraftState.step returns (reward, new_state_instance).\n            # The reward is not needed for pathfinding in this problem.\n            _reward, next_state = current_state.step(action)\n\n            # Create a unique key for the next state for checking against the visited set.\n            next_pos_tuple = next_state.pos\n            next_dir = next_state.dir\n            next_has_primitive = next_state.inventory[primitive] > 0\n            next_state_key = (next_pos_tuple, next_dir, next_has_primitive)\n\n            # If this next state has not been visited before with the same key:\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                # Enqueue the new state and its corresponding action path.\n                q.append((next_state, current_path + [action]))\n\n    # If the queue becomes empty and the goal was not found,\n    # it means the primitive is unreachable or uncollectible from the initial state\n    # within the search space explored.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:17:11.011154", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Constants for actions, assuming env_factory is available globally\n    # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    # MOVES = [(dx, dy, action_id)] for (x_change, y_change, corresponding_action)\n    MOVES = [\n        (0, 1, env_factory.DOWN),  # Move down (increase y)\n        (0, -1, env_factory.UP),   # Move up (decrease y)\n        (-1, 0, env_factory.LEFT), # Move left (decrease x)\n        (1, 0, env_factory.RIGHT), # Move right (increase x)\n    ]\n\n    def _is_adjacent_to_kind(current_pos, grid, kind_idx, world_config):\n        \"\"\"\n        Helper: Checks if any cell in the 3x3 neighborhood (including current_pos)\n        around current_pos contains kind_idx. Mimics CraftState.next_to.\n        \"\"\"\n        width, height = grid.shape[0], grid.shape[1]\n        \n        for dx in [-1, 0, 1]:\n            for dy in [-1, 0, 1]:\n                nx, ny = current_pos[0] + dx, current_pos[1] + dy\n                \n                # Check bounds\n                if not (0 <= nx < width and 0 <= ny < height):\n                    continue\n                \n                # Check if the cell contains the target kind_idx\n                if grid[nx, ny, kind_idx] == 1:\n                    return True\n        return False\n\n\n    current_state = env._current_state\n    \n    # 1. Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    initial_pos = current_state.pos\n    grid = current_state.grid\n    width, height, _ = grid.shape\n    world_config = current_state.world # Access CraftWorld instance for non_grabbable_indices\n\n    # BFS queue: stores tuples of (current_position, list_of_actions_taken_to_reach_here)\n    q = collections.deque([(initial_pos, [])])\n    \n    # Set to keep track of visited positions to avoid cycles and redundant paths\n    visited = {initial_pos}\n\n    while q:\n        (x, y), actions_taken = q.popleft()\n\n        # If the current position is adjacent to the primitive (or on it),\n        # we can perform the USE action to collect it.\n        if _is_adjacent_to_kind((x, y), grid, primitive, world_config):\n            return actions_taken + [env_factory.USE]\n\n        # Explore all possible movements from the current position\n        for dx, dy, action_id in MOVES:\n            next_x, next_y = x + dx, y + dy\n            next_pos = (next_x, next_y)\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= next_x < width and 0 <= next_y < height):\n                continue\n\n            # Check if the next position is blocked by a non-grabbable item (obstacle)\n            is_blocked = False\n            for kind_idx in world_config.non_grabbable_indices:\n                if grid[next_x, next_y, kind_idx] == 1:\n                    is_blocked = True\n                    break\n            \n            if is_blocked:\n                continue # Cannot move to this blocked cell\n\n            # If the next position has not been visited, add it to the queue\n            if next_pos not in visited:\n                visited.add(next_pos)\n                q.append((next_pos, actions_taken + [action_id]))\n\n    # If the queue becomes empty and no path to collect the primitive was found\n    return []", "island_id": 8, "scores": {"3": -1}}
