{"timestamp": "2025-07-30T10:28:34.539758", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (numerical values from CraftLab's action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Defines movement for each action: (dx, dy, resulting_facing_direction_index)\n  # The direction indices (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) are consistent with\n  # the agent's internal direction change after movement.\n  # These are pre-calculated for convenience in determining 'collectable_states'.\n  MOVE_ACTIONS_PROPERTIES = {\n      ACTION_UP: (0, -1, 0),    # Move UP: change Y by -1, new facing_dir is 0 (UP)\n      ACTION_RIGHT: (1, 0, 1),  # Move RIGHT: change X by +1, new facing_dir is 1 (RIGHT)\n      ACTION_DOWN: (0, 1, 2),   # Move DOWN: change Y by +1, new facing_dir is 2 (DOWN)\n      ACTION_LEFT: (-1, 0, 3),  # Move LEFT: change X by -1, new facing_dir is 3 (LEFT)\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\"\n  # via the USE action as implemented in CraftState._maybe_collect.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information from the environment's internal state\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Get the set of indices for non-grabbable entities (which act as obstacles to movement).\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  # Helper function to check if a grid cell is within bounds and not occupied by an obstacle.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    \n    # Check if the cell is occupied by any non-grabbable item (which acts as an obstacle).\n    for k_idx in non_grabbable_kinds:\n      if grid[x, y, k_idx] == 1: # Assuming 1 indicates presence of the kind\n        return False\n    return True\n\n  # 2. Identify all (agent_x, agent_y, agent_direction) states from which the primitive\n  # can be collected by performing an ACTION_USE.\n  collectable_states = set()\n\n  # Find all (x, y) coordinates where the primitive kind exists on the grid.\n  # This is an optimization over iterating the entire grid if primitives are sparse.\n  primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n\n  if len(primitive_locations) == 0:\n      return [] # No primitive found on the map, so nothing to collect.\n\n  for px, py in primitive_locations:\n    # For each primitive location (px, py), calculate the required agent position (ax, ay)\n    # and facing direction (adir) to use the primitive at (px, py).\n    for action_val, (dx, dy, agent_dir) in MOVE_ACTIONS_PROPERTIES.items():\n      # If an agent at (ax, ay) moves by (dx, dy) to reach (px, py),\n      # then its current position (ax, ay) must be (px - dx, py - dy).\n      ax, ay = px - dx, py - dy\n\n      # If this potential agent position is walkable, add the full state to collectable_states.\n      if is_walkable(ax, ay):\n        collectable_states.add((ax, ay, agent_dir))\n\n  # If no valid collection points are found (e.g., primitive is in an unreachable spot),\n  # return an empty path.\n  if not collectable_states:\n      return []\n\n  # 3. Breadth-First Search (BFS) to find the shortest sequence of actions.\n  # The queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to avoid redundant exploration and cycles. A state is defined by\n  # (x, y, direction) because the agent's direction affects what it can interact with (USE action).\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the current state is one from which the primitive can be collected.\n    if (curr_x, curr_y, curr_dir) in collectable_states:\n      return path_actions + [ACTION_USE] # Found path to a collection point, append USE action.\n\n    # Explore possible next movement actions.\n    for action, (move_dx, move_dy, next_dir) in MOVE_ACTIONS_PROPERTIES.items():\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n\n      # If the next cell is walkable and this (position, direction) state hasn't been visited,\n      # add it to the queue for further exploration.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:30:11.048852", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on the problem description\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Delta (dx, dy) for movement actions.\n  # These deltas specify how the agent's (x, y) position changes\n  # when performing the corresponding cardinal movement action.\n  MOVE_DELTAS = {\n      ACTION_DOWN: (0, 1),   # (dx, dy) for moving down (increasing y)\n      ACTION_UP: (0, -1),    # (dx, dy) for moving up (decreasing y)\n      ACTION_LEFT: (-1, 0),  # (dx, dy) for moving left (decreasing x)\n      ACTION_RIGHT: (1, 0)   # (dx, dy) for moving right (increasing x)\n  }\n\n  # Delta (dx, dy) for the cell directly in front of the agent,\n  # based on the agent's current facing direction.\n  # Assuming agent's direction (dir) maps 0->DOWN, 1->UP, 2->LEFT, 3->RIGHT.\n  FACING_DELTAS = {\n      0: (0, 1),   # Facing DOWN: cell in front is (x, y+1)\n      1: (0, -1),  # Facing UP: cell in front is (x, y-1)\n      2: (-1, 0),  # Facing LEFT: cell in front is (x-1, y)\n      3: (1, 0)    # Facing RIGHT: cell in front is (x+1, y)\n  }\n\n  # First, check if the primitive is already in the agent's inventory.\n  # If so, no actions are needed to collect it.\n  current_inventory = env._current_state.inventory\n  if current_inventory[primitive] > 0:\n      return [] # Already collected\n\n  # Get the current state information from the environment.\n  grid = env._current_state.grid\n  # The grid shape is (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n  start_x, start_y = env._current_state.pos\n  start_dir = env._current_state.dir # Agent's initial facing direction\n\n  # Initialize a queue for Breadth-First Search (BFS).\n  # Each item in the queue is (x, y, direction, list_of_actions_taken_to_reach_this_state).\n  q = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Keep track of visited states to avoid cycles and redundant exploration.\n  # A state is defined by (x, y, direction) because direction affects the 'USE' action.\n  visited = set([(start_x, start_y, start_dir)])\n\n  while q:\n      curr_x, curr_y, curr_dir, path = q.popleft()\n\n      # Check if the current state allows us to collect the primitive.\n      # This means the primitive must be in the cell directly in front of the agent.\n      front_dx, front_dy = FACING_DELTAS[curr_dir]\n      front_x, front_y = curr_x + front_dx, curr_y + front_dy\n\n      # Ensure the cell in front is within the grid boundaries.\n      if 0 <= front_x < WIDTH and 0 <= front_y < HEIGHT:\n          # Check if the primitive is present in the cell in front.\n          if grid[front_x, front_y, primitive] == 1:\n              # Goal reached: append the USE action to the path and return.\n              return path + [ACTION_USE]\n\n      # Explore possible next states by trying all movement actions.\n      # Each movement action (DOWN, UP, LEFT, RIGHT) changes both position and direction.\n      for action in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n          move_dx, move_dy = MOVE_DELTAS[action]\n          next_x, next_y = curr_x + move_dx, curr_y + move_dy\n          next_dir = action # The agent's new facing direction is the direction of its movement.\n\n          # Ensure the new position is within grid boundaries.\n          if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT:\n              # Check if this new state (position, direction) has already been visited.\n              if (next_x, next_y, next_dir) not in visited:\n                  visited.add((next_x, next_y, next_dir))\n                  # Add the new state to the queue for further exploration.\n                  q.append((next_x, next_y, next_dir, path + [action]))\n\n  # If the queue becomes empty and the primitive was not found/collected,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:30:11.120473", "function_name": "collect", "function_body": "    # Direction mapping (0:N, 1:E, 2:S, 3:W)\n    # These are typically global constants in the module, but defined here\n    # to fit the \"only return code that will fit in that function\" constraint.\n    DIR_DELTAS = {\n        0: (-1, 0),  # N (row decreases, col same)\n        1: (0, 1),   # E (row same, col increases)\n        2: (1, 0),   # S (row increases, col same)\n        3: (0, -1),  # W (row same, col decreases)\n    }\n\n    # Mapping relative turns to new absolute directions\n    TURN_LEFT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # N->W, E->N, S->E, W->S\n    TURN_RIGHT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # N->E, E->S, S->W, W->N\n\n    # 1. Get action mappings from the environment's action_specs\n    action_map = env.action_specs()\n    DOWN_ACTION = action_map['DOWN']\n    UP_ACTION = action_map['UP']\n    LEFT_ACTION = action_map['LEFT']\n    RIGHT_ACTION = action_map['RIGHT']\n    USE_ACTION = action_map['USE']\n\n    # 2. Get current state information from the CraftLab's internal state\n    # Accessing _current_state is assumed to be allowed for this problem.\n    current_state = env._current_state\n    grid = current_state.grid\n    start_pos = current_state.pos\n    start_dir = current_state.dir\n    \n    # Get grid dimensions\n    WIDTH, HEIGHT = grid.shape[0], grid.shape[1] \n\n    # Helper function to check if a position is valid and traversable\n    # A cell is traversable if it's within bounds and does not contain any non-grabbable items.\n    def is_valid_and_traversable(r, c, current_grid, world_non_grabbable_indices):\n        # Check boundary conditions\n        if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n            return False \n        \n        # Check if the cell contains any non-grabbable obstacles\n        # If any non-grabbable item is present, it's considered blocked.\n        if world_non_grabbable_indices is not None and len(world_non_grabbable_indices) > 0:\n            # Create a boolean mask for non_grabbable_indices to check all at once\n            non_grabbable_mask = np.zeros(current_grid.shape[2], dtype=bool)\n            non_grabbable_mask[list(world_non_grabbable_indices)] = True\n            \n            # If any non-grabbable item count is greater than 0 at this cell, it's blocked.\n            if np.any(current_grid[r, c, non_grabbable_mask] > 0):\n                return False\n        return True\n\n    # Get non-grabbable indices from the world configuration\n    world_non_grabbable_indices = current_state.world.non_grabbable_indices\n\n    # BFS (Breadth-First Search) setup\n    # Using collections.deque for efficient popleft\n    # Assumes 'collections' is available (e.g., imported at the file level).\n    queue = collections.deque()\n    \n    # Each item in the queue is a tuple:\n    # (row, col, direction, list_of_actions_to_reach_this_state)\n    queue.append((start_pos[0], start_pos[1], start_dir, []))\n\n    # Visited set to avoid cycles and redundant computations.\n    # Stores (row, col, direction) tuples.\n    visited = set([(start_pos[0], start_pos[1], start_dir)])\n\n    while queue:\n        r, c, d, path_actions = queue.popleft()\n\n        # Goal check: Is the cell directly in front of the current agent position\n        # and direction the primitive we are looking for?\n        dr_fwd, dc_fwd = DIR_DELTAS[d]\n        target_r, target_c = r + dr_fwd, c + dc_fwd\n        \n        # Check if the target cell is valid and contains the primitive\n        if (0 <= target_r < WIDTH and 0 <= target_c < HEIGHT) and \\\n           grid[target_r, target_c, primitive] > 0:\n            # We are adjacent to the primitive and facing it.\n            # Append the USE_ACTION and return the path, as BFS guarantees the shortest path.\n            return path_actions + [USE_ACTION]\n\n        # Explore possible actions (Move forward, turn left, turn right, move backward)\n        possible_moves = []\n\n        # 1. Move Forward (UP_ACTION)\n        next_r_up, next_c_up = r + DIR_DELTAS[d][0], c + DIR_DELTAS[d][1]\n        next_d_up = d # Direction remains the same\n        if is_valid_and_traversable(next_r_up, next_c_up, grid, world_non_grabbable_indices):\n            possible_moves.append((UP_ACTION, next_r_up, next_c_up, next_d_up))\n\n        # 2. Turn Left (LEFT_ACTION)\n        next_r_left, next_c_left = r, c # Position remains the same\n        next_d_left = TURN_LEFT_MAP[d]\n        # Turning actions don't change position, so no traversability check needed\n        possible_moves.append((LEFT_ACTION, next_r_left, next_c_left, next_d_left))\n\n        # 3. Turn Right (RIGHT_ACTION)\n        next_r_right, next_c_right = r, c # Position remains the same\n        next_d_right = TURN_RIGHT_MAP[d]\n        possible_moves.append((RIGHT_ACTION, next_r_right, next_c_right, next_d_right))\n\n        # 4. Move Backward (DOWN_ACTION)\n        # Agent faces 'd', but moves in 'd+2' (opposite) direction. Direction itself does not change.\n        back_dir_idx = (d + 2) % 4\n        next_r_down, next_c_down = r + DIR_DELTAS[back_dir_idx][0], c + DIR_DELTAS[back_dir_idx][1]\n        next_d_down = d \n        if is_valid_and_traversable(next_r_down, next_c_down, grid, world_non_grabbable_indices):\n            possible_moves.append((DOWN_ACTION, next_r_down, next_c_down, next_d_down))\n        \n        # Add valid new states to the queue\n        for action, nr, nc, nd in possible_moves:\n            if (nr, nc, nd) not in visited:\n                visited.add((nr, nc, nd))\n                queue.append((nr, nc, nd, path_actions + [action]))\n\n    # If the BFS queue becomes empty and no path was found,\n    # it means the primitive is unreachable from the current state.\n    return [] ", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:31:22.225632", "function_name": "collect", "function_body": "    # Action constants, defined inside the function as per the strict prompt requirement.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    actions = []\n    \n    # Get initial observations and the current CraftState instance from the environment.\n    # We access _current_state assuming it's the internal CraftState object\n    # that CraftLab manages and updates.\n    obs = env.observations()\n    current_state = env._current_state \n    \n    # 1. Check if the primitive is already present in the agent's inventory.\n    # If so, no actions are needed.\n    inventory = obs['features_dict']['inventory']\n    if inventory[primitive] > 0:\n        return [] # Primitive already collected\n        \n    # 2. Find the location(s) of the primitive on the grid.\n    # np.argwhere returns a list of (row, column) tuples, which map to (y, x) coordinates.\n    primitive_locations = np.argwhere(current_state.grid[:, :, primitive] == 1)\n    \n    # If the primitive is not found on the map, it cannot be collected.\n    if len(primitive_locations) == 0:\n        return [] # Primitive not present on the map\n        \n    # Choose the first found instance of the primitive as the target.\n    target_y, target_x = primitive_locations[0]\n    \n    # Set a maximum number of steps to prevent infinite loops, especially in complex\n    # environments with obstacles or unreachable targets.\n    MAX_MOVES = 200 \n    \n    # Loop to plan and execute movements towards the target.\n    for _ in range(MAX_MOVES):\n        current_y, current_x = current_state.pos\n        \n        # Check if the primitive is in the agent's immediate 3x3 neighborhood.\n        # If it is, the 'USE' action can be applied.\n        if current_state.next_to(primitive):\n            actions.append(USE)\n            # Execute the 'USE' action in the environment.\n            # This updates the environment's state, including inventory.\n            _reward, _done, _obs = env.step(USE)\n            current_state = env._current_state # Update local state reference\n            \n            # After attempting to USE, check if the primitive has been collected.\n            if current_state.inventory[primitive] > 0:\n                return actions # Successfully collected, return the sequence of actions\n            else:\n                # Failed to collect despite being next to it (e.g., item not grabbable,\n                # or USE has other unhandled preconditions).\n                # In this case, we cannot proceed, so return the actions taken so far.\n                return actions \n        \n        # Calculate the differences in x and y coordinates between current position and target.\n        dx = target_x - current_x\n        dy = target_y - current_y\n        \n        action_taken = False\n        \n        # Determine the next movement action.\n        # This uses a greedy approach, prioritizing reduction of the larger Manhattan distance component.\n        # It does not account for obstacles or pathfinding.\n        if abs(dx) > 0: # If there's horizontal distance to cover\n            action = RIGHT if dx > 0 else LEFT\n            actions.append(action)\n            _reward, _done, _obs = env.step(action) # Execute the movement action\n            current_state = env._current_state # Update the local state reference\n            action_taken = True\n        elif abs(dy) > 0: # If horizontal distance is zero, or after a horizontal move, try vertical\n            action = DOWN if dy > 0 else UP\n            actions.append(action)\n            _reward, _done, _obs = env.step(action) # Execute the movement action\n            current_state = env._current_state # Update the local state reference\n            action_taken = True\n        \n        # If no action was taken (meaning dx == 0 and dy == 0), and the primitive\n        # was not picked up by 'next_to', then the agent is at the target coordinates\n        # but cannot collect the item (e.g., due to an edge case or ungrabbable item).\n        # In this scenario, we cannot make further progress with this logic.\n        if not action_taken:\n            break # Exit loop, return the actions accumulated so far\n            \n    return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:31:23.198577", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:33:27.604437", "function_name": "collect", "function_body": "  # Action constants (from CraftLab.action_specs)\n  # These are typically global, but the prompt requires them inside the function.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # 1. Get current state information from the environment\n  obs = env.observations()\n  current_state_features = obs['features_dict']\n\n  grid = current_state_features['features_global']\n  inventory = current_state_features['inventory']\n  agent_pos = current_state_features['pos'] # (row, col)\n\n  # 2. Check if the primitive is already collected\n  if inventory[primitive] > 0:\n    return []\n\n  actions = []\n\n  # 3. Find all locations of the primitive on the grid\n  # The grid has shape (WIDTH, HEIGHT, n_kinds). We slice for the primitive kind.\n  primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n  if len(primitive_locations) == 0:\n    # Primitive not found on the visible grid, so cannot collect.\n    return []\n\n  # 4. Find the closest primitive location (using Manhattan distance)\n  best_target_pos = None\n  min_dist_to_primitive = float('inf')\n\n  for target_pos_candidate in primitive_locations:\n    dist = abs(target_pos_candidate[0] - agent_pos[0]) + abs(target_pos_candidate[1] - agent_pos[1])\n    if dist < min_dist_to_primitive:\n      min_dist_to_primitive = dist\n      best_target_pos = target_pos_candidate\n\n  if best_target_pos is None:\n    # This case should logically not be reached if primitive_locations is not empty,\n    # but included for robustness.\n    return []\n\n  # 5. Determine the best adjacent cell for the agent to move to\n  # The agent needs to be at a cell (adj_row, adj_col) that is directly adjacent\n  # (North, South, East, or West) to the `best_target_pos`.\n  target_row, target_col = best_target_pos\n  grid_height, grid_width, _ = grid.shape\n\n  # Candidate adjacent cells around the target primitive\n  adj_cells_candidates = [\n      (target_row - 1, target_col), # North of target\n      (target_row + 1, target_col), # South of target\n      (target_row, target_col - 1), # West of target\n      (target_row, target_col + 1), # East of target\n  ]\n\n  # Filter for valid (in-bounds) and potentially walkable cells.\n  # For simplicity in this `v2` version, we assume any in-bounds adjacent cell is walkable.\n  # A more advanced version would check `env.world.non_grabbable_indices` to avoid obstacles.\n  reachable_adj_cells = []\n  for r, c in adj_cells_candidates:\n      if 0 <= r < grid_height and 0 <= c < grid_width:\n          reachable_adj_cells.append((r, c))\n\n  if not reachable_adj_cells:\n      # No valid adjacent cells to reach the primitive.\n      return []\n\n  # Find the reachable adjacent cell that is closest to the agent's current position.\n  best_adj_target_pos = None\n  min_dist_to_adj = float('inf')\n\n  for adj_r, adj_c in reachable_adj_cells:\n      dist = abs(adj_r - agent_pos[0]) + abs(adj_c - agent_pos[1])\n      if dist < min_dist_to_adj:\n          min_dist_to_adj = dist\n          best_adj_target_pos = (adj_r, adj_c)\n\n  if best_adj_target_pos is None:\n      # Should not happen if reachable_adj_cells is not empty, but for robustness.\n      return []\n\n  # 6. Plan movement actions to reach `best_adj_target_pos`\n  current_agent_row, current_agent_col = agent_pos\n  target_adj_row, target_adj_col = best_adj_target_pos\n\n  # Simple Manhattan path: move along rows first, then columns.\n  while current_agent_row != target_adj_row:\n      if current_agent_row < target_adj_row:\n          actions.append(DOWN)\n          current_agent_row += 1\n      else: # current_agent_row > target_adj_row\n          actions.append(UP)\n          current_agent_row -= 1\n\n  while current_agent_col != target_adj_col:\n      if current_agent_col < target_adj_col:\n          actions.append(RIGHT)\n          current_agent_col += 1\n      else: # current_agent_col > target_adj_col\n          actions.append(LEFT)\n          current_agent_col -= 1\n\n  # At this point, the agent's planned position is `best_adj_target_pos`.\n\n  # 7. Use the item.\n  # This implementation assumes the 'USE' action works successfully on any adjacent item,\n  # regardless of the agent's specific facing direction, or that the last movement action\n  # inherently aligns the agent's direction correctly for the 'USE' action.\n  actions.append(USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:33:27.673834", "function_name": "collect", "function_body": "    # Helper for parsing normalized position\n    # (normalized_row, normalized_col) -> (int_row, int_col)\n    def _unnormalize_pos(normalized_pos_array, grid_height, grid_width):\n        return (int(round(normalized_pos_array[0] * (grid_height - 1))),\n                int(round(normalized_pos_array[1] * (grid_width - 1))))\n\n    # Helper for parsing one-hot direction to an integer (0-3)\n    def _get_direction_int(one_hot_dir_array):\n        # 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT\n        return np.argmax(one_hot_dir_array)\n\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    normalized_agent_pos = obs['features_dict']['pos']\n    agent_dir_one_hot = obs['features_dict']['direction']\n    \n    # Grid shape is (height, width, n_kinds)\n    grid_height, grid_width, _ = grid.shape \n    \n    # Convert normalized agent position to integer grid coordinates (row, col)\n    agent_pos = _unnormalize_pos(normalized_agent_pos, grid_height, grid_width)\n    # Convert one-hot direction to integer\n    current_dir = _get_direction_int(agent_dir_one_hot)\n\n    # Map action integer (0-3) to (dr, dc) delta for rows and columns\n    # This also defines the direction agent faces after taking the action\n    action_deltas = {\n        0: (1, 0),  # DOWN (delta_row=1, delta_col=0)\n        1: (-1, 0), # UP (delta_row=-1, delta_col=0)\n        2: (0, -1), # LEFT (delta_row=0, delta_col=-1)\n        3: (0, 1)   # RIGHT (delta_row=0, delta_col=1)\n    }\n    \n    # Find all locations on the grid where the primitive exists\n    primitive_locations = []\n    for r in range(grid_height):\n        for c in range(grid_width):\n            if grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        return [] # Primitive not found anywhere on the grid\n\n    # Define target states for BFS: (agent_row, agent_col, agent_facing_direction)\n    # A target state is a position (ar, ac) and direction (ad) such that\n    # the cell directly in front of the agent (ar + dr[ad], ac + dc[ad]) contains the primitive.\n    target_states = set() \n    for pr, pc in primitive_locations:\n        # Iterate over all possible directions the agent could face to look at this primitive\n        for action_dir, (dr_from_agent_to_primitive, dc_from_agent_to_primitive) in action_deltas.items():\n            # Calculate the agent's required position (ar, ac) to face (pr, pc)\n            # agent_pos + delta_to_primitive = primitive_pos\n            # agent_pos = primitive_pos - delta_to_primitive\n            ar = pr - dr_from_agent_to_primitive\n            ac = pc - dc_from_agent_to_primitive\n            \n            # Check if this potential agent position is within grid boundaries\n            if 0 <= ar < grid_height and 0 <= ac < grid_width:\n                # Add this state: (agent_row, agent_col, direction_agent_faces_primitive)\n                target_states.add((ar, ac, action_dir))\n\n    if not target_states: \n        # This might happen if all primitives are located such that no valid adjacent and facing cell exists (e.g., surrounded by walls).\n        return []\n\n    # BFS to find the shortest path from the current agent state to any target state\n    # Queue stores: ((current_row, current_col, current_direction), [list_of_actions_taken_to_reach_here])\n    q = collections.deque([((agent_pos[0], agent_pos[1], current_dir), [])])\n    \n    # Visited set stores: (row, col, direction) tuples to avoid re-exploring the same state\n    visited = set()\n    visited.add((agent_pos[0], agent_pos[1], current_dir))\n    \n    # Get indices of non-grabbable items to identify obstacles\n    world_non_grabbable_indices = env.world.non_grabbable_indices\n\n    while q:\n        (r, c, d), path_actions = q.popleft()\n\n        # If the current state is one of the target states, we found a path\n        if (r, c, d) in target_states:\n            return path_actions + [4] # Append the USE action and return the full sequence\n\n        # Explore all possible next moves (actions 0-3: DOWN, UP, LEFT, RIGHT)\n        for action_idx in range(4): \n            dr, dc = action_deltas[action_idx]\n            next_r, next_c = r + dr, c + dc\n            next_d = action_idx # After moving, the agent will face the direction of movement\n\n            # Check if the next cell is within grid boundaries\n            if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n                continue\n\n            # Check if the next cell is traversable.\n            # A cell is considered non-traversable if it contains any non-grabbable item.\n            # We assume the primitive itself is grabbable and does not block movement.\n            is_traversable = True\n            for k_idx in world_non_grabbable_indices:\n                # If the cell contains a non-grabbable item (that is not the target primitive,\n                # which shouldn't be in non_grabbable_indices anyway if it's a 'primitive'),\n                # then it's an obstacle.\n                if grid[next_r, next_c, k_idx] > 0:\n                    is_traversable = False\n                    break\n            if not is_traversable:\n                continue\n\n            next_state = (next_r, next_c, next_d)\n            # If this next state has not been visited yet, add it to the queue\n            if next_state not in visited:\n                visited.add(next_state)\n                q.append((next_state, path_actions + [action_idx]))\n    \n    # If the queue becomes empty and no path to a primitive was found, return an empty list\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:34:33.288417", "function_name": "collect", "function_body": "  import collections\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  # This mapping aligns the action names with their intuitive directional outcomes.\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position)\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y\n      1: (1, 0),   # RIGHT: increases x\n      2: (0, 1),   # DOWN: increases y\n      3: (-1, 0)   # LEFT: decreases x\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  # CraftWorld's `grabbable_indices` indicates items that can be picked up with 'USE'.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information from the environment.\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Helper function to check if a grid cell is within bounds and not an obstacle.\n  # Obstacles are defined by `non_grabbable_indices` in the CraftWorld.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # Check if the cell is occupied by any non-grabbable item (which acts as an obstacle).\n    # Grabbable items (even if not the target primitive) do not block movement.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # Breadth-First Search (BFS) for the shortest sequence of actions.\n  # The queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken).\n  # `current_direction`: The direction the agent is facing *after* arriving at (current_x, current_y).\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to prevent redundant exploration and cycles.\n  # A state is defined by (x, y, direction) because both position and facing direction\n  # affect subsequent moves and the outcome of the 'USE' action.\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the current state allows for immediate collection of the primitive.\n    # The 'USE' action in CraftState collects the item *directly in front* of the agent.\n    # Calculate the coordinates of the cell directly in front of the agent.\n    front_dx, front_dy = DIR_VEC[curr_dir]\n    front_x, front_y = curr_x + front_dx, curr_y + front_dy\n\n    # If the cell in front is within bounds AND contains the target primitive,\n    # then we've found a path. Append 'ACTION_USE' and return.\n    if (0 <= front_x < grid_width and 0 <= front_y < grid_height and\n        grid[front_x, front_y, primitive] == 1):\n      return path_actions + [ACTION_USE]\n\n    # Explore possible movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Determine the new facing direction after performing this action.\n      next_dir = ACTION_TO_DIR[action]\n      # The movement itself is in the direction the agent will face after the action.\n      move_dx, move_dy = DIR_VEC[next_dir]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n\n      # If the next cell is walkable (not an obstacle) and this (position, direction)\n      # state has not been visited yet, add it to the queue for exploration.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable or does not exist.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:34:34.305563", "function_name": "collect", "function_body": "  import collections\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  # This mapping is based on how CraftState.step updates the agent's direction upon movement.\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position and what's in front)\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y\n      1: (1, 0),   # RIGHT: increases x\n      2: (0, 1),   # DOWN: increases y\n      3: (-1, 0)   # LEFT: decreases x\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Helper function to check if a grid cell is within bounds and not an obstacle.\n  # Obstacles are defined by non_grabbable_indices.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # Check if the cell is occupied by any non-grabbable item.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # Breadth-First Search (BFS) for shortest path\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n  # `current_direction`: The direction the agent is facing *after* arriving at (current_x, current_y)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to avoid redundant exploration and cycles.\n  # A state is defined by (x, y, direction) because the agent's direction matters\n  # for which cells it can move into and for the 'USE' action.\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the primitive is in the cell directly in front of the agent.\n    # The 'USE' action interacts with the cell directly in front of the agent.\n    target_dx, target_dy = DIR_VEC[curr_dir]\n    target_x, target_y = curr_x + target_dx, curr_y + target_dy\n\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive] == 1):\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next movement actions (UP, RIGHT, DOWN, LEFT)\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Determine the new position and direction after this action\n      # The movement vector is derived from the action's corresponding direction.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # Agent's new facing direction after moving\n\n      # If the next cell is walkable and this (position, direction) state hasn't been visited\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:36:17.675519", "function_name": "collect", "function_body": "  import collections\n  # numpy is already imported at the top of the file\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement deltas for (x, y) coordinates\n  # Assuming (x, y) where x is column index (horizontal) and y is row index (vertical).\n  # UP: (x, y+1)\n  # DOWN: (x, y-1)\n  # LEFT: (x-1, y)\n  # RIGHT: (x+1, y)\n  movement_deltas = {\n      ACTION_UP: (0, 1),\n      ACTION_DOWN: (0, -1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Get current observation details\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  initial_normalized_pos = obs['features_dict']['pos']\n\n  # Convert normalized position (float between 0 and 1) to grid coordinates (int)\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n  initial_pos_x = int(initial_normalized_pos[0] * WIDTH)\n  initial_pos_y = int(initial_normalized_pos[1] * HEIGHT)\n  initial_pos = (initial_pos_x, initial_pos_y)\n\n  # Get indices of non-walkable terrain (obstacles) from the CraftWorld instance\n  # The `primitive` argument is expected to be a grabbable item, and thus not in `non_grabbable_indices`.\n  non_walkable_indices = env.world.non_grabbable_indices\n\n  # Find all locations on the grid where the primitive is present\n  target_primitive_locations = []\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          if grid[x, y, primitive] == 1:\n              target_primitive_locations.append((x, y))\n\n  # If the primitive is not found on the map, it cannot be collected\n  if not target_primitive_locations:\n      return []\n\n  # BFS to find the shortest path to any primitive location\n  # Queue stores tuples of (current_position (x,y), list_of_actions_to_reach_current_position)\n  queue = collections.deque([(initial_pos, [])])\n  # Visited set keeps track of (x, y) cells to avoid redundant computations and cycles\n  visited = {initial_pos}\n\n  final_path_actions = []\n\n  while queue:\n      current_pos, path_actions = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position contains the primitive\n      if grid[cx, cy, primitive] == 1:\n          # If the agent is on the primitive, append ACTION_USE to collect it\n          final_path_actions = path_actions + [ACTION_USE]\n          break # Path found, exit BFS\n\n      # Explore neighboring cells (UP, DOWN, LEFT, RIGHT)\n      for action, (dx, dy) in movement_deltas.items():\n          nx, ny = cx + dx, cy + dy\n\n          # Check if the new position is within grid boundaries\n          if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n              new_pos = (nx, ny)\n\n              # Check if the new position has not been visited yet\n              if new_pos not in visited:\n                  # Check if the new position is an obstacle\n                  is_obstacle = False\n                  for kind_idx in non_walkable_indices:\n                      # If this cell contains any non-grabbable item, consider it an obstacle\n                      if grid[nx, ny, kind_idx] == 1:\n                          is_obstacle = True\n                          break\n                  \n                  if not is_obstacle:\n                      visited.add(new_pos)\n                      queue.append((new_pos, path_actions + [action]))\n\n  # Return the found path. If the loop completes and no path was found (e.g., primitive is unreachable),\n  # final_path_actions will remain an empty list, which is the correct behavior.\n  return final_path_actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:36:17.744509", "function_name": "collect", "function_body": "    # Constants for actions as per action_specs\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # 1. Get current state information from the environment\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    grid = features_dict['features_global']\n    \n    # Denormalize position from [0,1] range to grid coordinates.\n    # According to the class description:\n    # grid: numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds)\n    # This means grid.shape[0] corresponds to WIDTH (X-dimension/columns),\n    # and grid.shape[1] corresponds to HEIGHT (Y-dimension/rows).\n    # Therefore, grid access will be grid[x_coord, y_coord, kind_idx].\n    # pos: normalized position array of length 2 (numpy.ndarray) - typically (norm_x, norm_y)\n    \n    grid_width_dim = grid.shape[0]  # Corresponds to X-coordinates / columns\n    grid_height_dim = grid.shape[1] # Corresponds to Y-coordinates / rows\n\n    current_pos_normalized = features_dict['pos'] # This is (norm_x, norm_y)\n    \n    # Convert normalized (x,y) to integer (col, row) coordinates for grid indexing.\n    # We will store (row, col) in BFS state for consistency with (dr, dc) moves.\n    current_col = int(round(current_pos_normalized[0] * (grid_width_dim - 1)))\n    current_row = int(round(current_pos_normalized[1] * (grid_height_dim - 1)))\n    \n    # 2. Check if the primitive is already collected\n    inventory = features_dict['inventory']\n    if inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # Check if we are already next to the primitive, and if so, just use it.\n    # Access env._current_state as implied by problem description for `next_to` method.\n    if env._current_state.next_to(primitive):\n        return [USE]\n\n    # 3. Implement BFS to find the primitive\n    \n    # Define possible moves and their corresponding actions.\n    # Moves are defined as (dr, dc) -> change in (row, col) from current position.\n    # These map to the actions that cause those movements.\n    # Given (col, row) as the internal representation for grid positions:\n    # UP:   moves from (col, row) to (col, row-1). In (dr, dc) terms: dr = -1, dc = 0.\n    # DOWN: moves from (col, row) to (col, row+1). In (dr, dc) terms: dr = 1, dc = 0.\n    # LEFT: moves from (col, row) to (col-1, row). In (dr, dc) terms: dr = 0, dc = -1.\n    # RIGHT:moves from (col, row) to (col+1, row). In (dr, dc) terms: dr = 0, dc = 1.\n    \n    move_actions = {\n        (1, 0): DOWN,   # (dr, dc) for moving (row + 1, col)\n        (-1, 0): UP,    # (dr, dc) for moving (row - 1, col)\n        (0, -1): LEFT,  # (dr, dc) for moving (row, col - 1)\n        (0, 1): RIGHT,  # (dr, dc) for moving (row, col + 1)\n    }\n\n    # Queue for BFS: [(row, col, list_of_actions_to_reach_here)]\n    # A simple Python list can act as a queue by using append and pop(0).\n    queue = [(current_row, current_col, [])]\n    visited = set([(current_row, current_col)])\n\n    target_primitive_found_path = None\n\n    while queue:\n        r, c, actions_so_far = queue.pop(0)\n\n        # Check if this cell contains the primitive.\n        # Grid is (WIDTH, HEIGHT, n_kinds), so actual numpy access is grid[col_idx, row_idx, kind_idx].\n        # Here 'c' is col_idx (x-coordinate) and 'r' is row_idx (y-coordinate).\n        if grid[c, r, primitive] > 0:\n            target_primitive_found_path = actions_so_far\n            break # Found the closest primitive via BFS\n\n        # Explore neighbors\n        for (dr, dc), action in move_actions.items():\n            next_r, next_c = r + dr, c + dc\n\n            # Check bounds for the new (row, col) coordinates.\n            # next_c must be within [0, grid_width_dim-1] (X-dimension)\n            # next_r must be within [0, grid_height_dim-1] (Y-dimension)\n            if not (0 <= next_c < grid_width_dim and 0 <= next_r < grid_height_dim):\n                continue\n\n            # Check if this position has already been visited\n            if (next_r, next_c) in visited:\n                continue\n\n            # Assuming all cells are traversable unless explicitly an obstacle kind is specified.\n            # The problem description does not provide an explicit way to check for impassable cells.\n            # Therefore, we proceed with basic grid traversability.\n\n            # Add the new position to visited set and enqueue it\n            visited.add((next_r, next_c))\n            queue.append((next_r, next_c, actions_so_far + [action]))\n\n    # If a path to the primitive was found\n    if target_primitive_found_path is not None:\n        # Once the agent reaches the cell containing the primitive, perform the USE action to collect it.\n        return target_primitive_found_path + [USE]\n    else:\n        # Primitive not found on the grid, or a path to it is impossible.\n        return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:37:03.317744", "function_name": "collect", "function_body": "  from collections import deque\n\n  # --- 1. Define Action Constants and Movement Vectors ---\n  # These are standard actions within the CraftWorld environment.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Mapping of movement actions to their corresponding (dx, dy) changes.\n  MOVES = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # Offsets for checking the 3x3 neighborhood around the agent's position.\n  # This includes the agent's current cell (0,0).\n  NEIGHBORHOOD_OFFSETS = [\n      (dx, dy) for dx in [-1, 0, 1] for dy in [-1, 0, 1]\n  ]\n\n  # --- 2. Initialize State Information ---\n  # Retrieve current environment observations.\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  # Convert agent's position from numpy array to a tuple for use as dictionary keys/set elements in BFS.\n  current_agent_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  world = env.world\n  # Indices of entities that cannot be traversed (obstacles like water blocks, stone walls, workshops).\n  non_grabbable_indices = world.non_grabbable_indices\n  # Indices of entities that can be picked up directly if on the ground.\n  grabbable_indices = set(world.grabbable_indices)\n  \n  W, H, K = grid.shape # Grid dimensions (Width, Height, Number of Kinds)\n\n  # --- 3. Determine Traversable Cells (Improved from v1 using NumPy) ---\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  is_obstacle_kind = np.isin(np.arange(K), list(non_grabbable_indices))  \n  has_obstacle = (grid[:, :, is_obstacle_kind] > 0).any(axis=-1)  \n  traversable_mask = ~has_obstacle\n  \n  # If the agent starts on an untraversable cell, no path is possible.\n  if not traversable_mask[current_agent_pos[0], current_agent_pos[1]]:\n      return [] \n\n  # --- 4. Identify Target Grid Block Indices for Collection ---\n  # These are the indices of blocks/items that, if present in the 3x3 neighborhood\n  # of the agent, allow the 'USE' action to collect the 'primitive'.\n  target_collect_block_indices = set()\n\n  # The primitive itself can often be picked up if it's on the ground.\n  if primitive in grabbable_indices:\n      target_collect_block_indices.add(primitive)\n\n  # Check for specific environmental blocks that yield the primitive item when 'USE'd.\n  # This handles cases like mining stone from a 'stone block' or collecting water from a 'water block'.\n  primitive_name = world.cookbook.index.get(primitive)\n  if primitive_name == 'water' and world.water_index is not None:\n      target_collect_block_indices.add(world.water_index)\n  elif primitive_name == 'stone' and world.stone_index is not None:\n      target_collect_block_indices.add(world.stone_index)\n  # Extend with more mappings here if other primitives require specific source blocks\n  # (e.g., 'wood' from a 'tree' block, if such specific indices exist in 'world').\n\n  # If no blocks in the environment can yield the desired primitive, return an empty path.\n  if not target_collect_block_indices:\n      return []\n\n  # --- 5. Breadth-First Search (BFS) for Shortest Path ---\n  # The BFS finds the shortest path for the agent to reach any position\n  # from which it can successfully 'USE' to collect the target primitive.\n  \n  q = deque([(current_agent_pos, [])]) # Queue stores (agent_position, actions_to_reach_here)\n  visited = {current_agent_pos} # Set of agent positions already explored by BFS\n  \n  found_path_actions = None # Stores the sequence of movement actions to the target\n  \n  while q:\n      curr_agent_pos, actions_so_far = q.popleft()\n      curr_agent_x, curr_agent_y = curr_agent_pos\n\n      # Check if the current agent position is a valid collection point.\n      # This means checking if any of the `target_collect_block_indices` are present\n      # in the 3x3 neighborhood of the `curr_agent_pos`.\n      is_valid_collection_location = False\n      for target_block_idx in target_collect_block_indices:\n          for dx, dy in NEIGHBORHOOD_OFFSETS:\n              neighbor_x, neighbor_y = curr_agent_x + dx, curr_agent_y + dy\n              \n              # Check bounds for the neighboring cell before accessing grid.\n              if (0 <= neighbor_x < W and 0 <= neighbor_y < H):\n                  # If the neighboring cell contains the target block/item,\n                  # then curr_agent_pos is a valid location to 'USE' from.\n                  if grid[neighbor_x, neighbor_y, target_block_idx] > 0:\n                      is_valid_collection_location = True\n                      break # Found a suitable target block in the neighborhood\n          if is_valid_collection_location:\n              break # No need to check other target block types if one is found\n\n      if is_valid_collection_location:\n          found_path_actions = actions_so_far\n          break # Shortest path to a suitable collection location found.\n      \n      # Explore adjacent traversable cells for the agent's next move.\n      for action, (dx, dy) in MOVES.items():\n          next_agent_x, next_agent_y = curr_agent_x + dx, curr_agent_y + dy\n          next_agent_pos = (next_agent_x, next_agent_y)\n\n          # Ensure next position is within bounds, traversable, and not yet visited.\n          if (0 <= next_agent_x < W and 0 <= next_agent_y < H and\n              traversable_mask[next_agent_x, next_agent_y] and\n              next_agent_pos not in visited):\n              \n              visited.add(next_agent_pos) # Mark as visited\n              q.append((next_agent_pos, actions_so_far + [action])) # Add to queue with updated path\n  \n  # If no path to a collection point was found, return an empty list.\n  if found_path_actions is None:\n      return [] \n  \n  # --- 6. Append the 'USE' Action ---\n  # After reaching the collection point, the 'USE' action is required to acquire the primitive.\n  found_path_actions.append(USE)\n  \n  return found_path_actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:37:04.339154", "function_name": "collect", "function_body": "  actions = []\n  \n  # --- 1. Define Action Constants and Movement Vectors ---\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVES = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # Offsets for checking the 3x3 neighborhood around the agent's position for the 'USE' action.\n  NEIGHBORHOOD_OFFSETS = [\n      (dx, dy) for dx in [-1, 0, 1] for dy in [-1, 0, 1]\n  ]\n\n  # --- 2. Retrieve Current State Information ---\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  # Convert agent's position from numpy array to a tuple for use as dictionary keys/set elements in BFS.\n  current_agent_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  world = env.world\n  # Indices of entities that cannot be traversed (obstacles like water blocks, stone walls, workshops).\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape # Grid dimensions (Width, Height, Number of Kinds)\n\n  # --- 3. Determine Traversable Cells (Efficiently using NumPy) ---\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  \n  # Create a boolean mask indicating which kind indices are non-grabbable obstacles.\n  is_obstacle_kind = np.isin(np.arange(K), list(non_grabbable_indices))\n  \n  # For each cell (x, y), check if any of the non-grabbable kinds are present (> 0 count).\n  # This results in a (W, H) boolean array where True means an obstacle is present.\n  has_obstacle = (grid[:, :, is_obstacle_kind] > 0).any(axis=-1)\n  \n  # A cell is traversable if it does NOT have any obstacles.\n  traversable_mask = ~has_obstacle\n  \n  # If the agent starts on an untraversable cell, no path is possible.\n  if not traversable_mask[current_agent_pos[0], current_agent_pos[1]]:\n      return [] \n\n  # --- 4. Identify Target Grid Indices for Collection ---\n  # These are the indices of blocks/items on the grid that, if present\n  # in the 3x3 neighborhood of the agent, allow the 'USE' action to collect\n  # the 'primitive' item.\n  \n  # Always include the primitive item itself. If it's on the ground, 'USE' can pick it up.\n  target_collect_block_indices = {primitive} \n\n  # Check for specific environmental blocks that yield the primitive item.\n  primitive_name = world.cookbook.index.get(primitive)\n  if primitive_name == 'water' and world.water_index is not None:\n      target_collect_block_indices.add(world.water_index) # Add water block as a source\n  elif primitive_name == 'stone' and world.stone_index is not None:\n      target_collect_block_indices.add(world.stone_index) # Add stone block as a source\n  # Extend with more mappings here if other primitives require specific source blocks\n  # (e.g., 'wood' from a 'tree' block, 'ore' from 'ore_deposit', if such attributes exist in world).\n\n  # --- 5. Breadth-First Search (BFS) for Shortest Path ---\n  # The BFS finds the shortest path for the agent to reach any position\n  # from which it can successfully 'USE' to collect the target primitive.\n  \n  from collections import deque\n  q = deque([current_agent_pos]) \n  # `parent` dictionary stores (previous_position, action_to_reach_current_position)\n  # This also implicitly serves as the `visited` set for BFS.\n  parent = {current_agent_pos: (None, None)} \n  \n  found_target_agent_pos = None # Stores the first valid collection position found.\n\n  while q:\n      curr_agent_x, curr_agent_y = q.popleft()\n      curr_agent_pos = (curr_agent_x, curr_agent_y)\n\n      # Check if the current agent position is a valid collection point.\n      # This means checking if any of the `target_collect_block_indices` are in the 3x3 neighborhood.\n      is_valid_collection_location = False\n      for target_block_idx in target_collect_block_indices:\n          for dx, dy in NEIGHBORHOOD_OFFSETS:\n              neighbor_x, neighbor_y = curr_agent_x + dx, curr_agent_y + dy\n              \n              # Check bounds for the neighboring cell before accessing grid.\n              if (0 <= neighbor_x < W and 0 <= neighbor_y < H):\n                  # If the neighboring cell contains the target block/item,\n                  # then curr_agent_pos is a valid location to 'USE' from.\n                  if grid[neighbor_x, neighbor_y, target_block_idx] > 0:\n                      is_valid_collection_location = True\n                      break # Found a suitable target block in the neighborhood\n          if is_valid_collection_location:\n              break # No need to check other target block types if one is found\n\n      if is_valid_collection_location:\n          found_target_agent_pos = curr_agent_pos\n          break # Shortest path to a suitable collection location found.\n      \n      # Explore adjacent traversable cells for the agent's next move.\n      for action, (dx, dy) in MOVES.items():\n          next_agent_x, next_agent_y = curr_agent_x + dx, curr_agent_y + dy\n          next_agent_pos = (next_agent_x, next_agent_y)\n\n          # Ensure next position is within bounds, traversable, and not yet visited.\n          if (0 <= next_agent_x < W and 0 <= next_agent_y < H and\n              traversable_mask[next_agent_x, next_agent_y] and\n              next_agent_pos not in parent):\n              \n              parent[next_agent_pos] = (curr_agent_pos, action) # Record path\n              q.append(next_agent_pos) # Add to queue for further exploration\n  \n  # If no path to a collection point was found, return an empty list.\n  if found_target_agent_pos is None:\n      return [] \n  \n  # --- 6. Reconstruct the Path ---\n  # Traverse back from the found target position to the start position using `parent` links.\n  path_actions = []\n  node = found_target_agent_pos\n  while node != current_agent_pos:\n      # Retrieve the previous position and the action taken to reach the current `node`.\n      prev_node, action_to_reach_node = parent[node]\n      path_actions.append(action_to_reach_node)\n      node = prev_node\n  \n  path_actions.reverse() # Reverse the list to get actions in correct order (start to target).\n  \n  # --- 7. Append the 'USE' Action ---\n  # After reaching the collection point, the 'USE' action is required to acquire the primitive.\n  path_actions.append(USE)\n  \n  return path_actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:38:07.899544", "function_name": "collect", "function_body": "  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name\n  # The index method will add the primitive to the cookbook's index if it doesn't already exist.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable\n  if primitive_idx not in env.world.grabbable_indices:\n    # This primitive cannot be picked up (e.g., water, stone if not grabbable),\n    # so \"collecting\" it via USE is not possible.\n    return []\n\n  # 3. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 4. Retrieve grid dimensions for boundary checks\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a position and orientation from which the primitive can be collected via USE.\n  # BFS state: ((current_x, current_y), current_direction, [list_of_actions_to_reach_here])\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's initial direction (0-3)\n\n  queue = [(start_pos, start_dir, [])] \n  # Set of visited ((x, y), direction) tuples to prevent cycles and redundant path exploration\n  visited = {(start_pos, start_dir)} \n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.pop(0) # Dequeue for BFS\n\n    # Calculate the coordinates of the cell directly in front of the agent,\n    # which is the target for the USE action.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # Check if the cell in front is within bounds and contains the primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      # Found a path where the agent can move to a position, face the primitive,\n      # and then USE to collect it. BFS guarantees this is the shortest path.\n      return path_actions + [USE_ACTION]\n    \n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # A movement action changes the agent's position and its facing direction.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple) # Mark the new state as visited\n        # Add the new state and its path to the queue for further exploration\n        queue.append((next_state_tuple[0], next_state_tuple[1], path_actions + [move_action]))\n\n  # If the queue becomes empty and no path was found, it means the primitive\n  # is unreachable from the current state.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:38:08.886305", "function_name": "collect", "function_body": "  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name\n  # The index method will add the primitive to the cookbook's index if it doesn't already exist.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable\n  if primitive_idx not in env.world.grabbable_indices:\n    # This primitive cannot be picked up.\n    return []\n\n  # 3. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 4. Pre-find all locations on the grid where the primitive exists\n  #    This step is adopted from collect_v1 for clarity and potential minor optimization\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  target_primitive_locs = set() # Using a set for O(1) lookup\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the specific primitive layer at (x, y) has a count greater than 0\n      if grid[x, y, primitive_idx] > 0:\n        target_primitive_locs.add((x, y))\n\n  if not target_primitive_locs:\n    # The primitive is not found anywhere on the current map\n    return []\n\n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a position and orientation from which the primitive can be collected via USE.\n  #    This improves upon v1 by including direction in the BFS state,\n  #    ensuring the agent can correctly \"USE\" the item after reaching an adjacent spot.\n  # BFS state: ((current_x, current_y), current_direction, [list_of_actions_to_reach_here])\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's initial direction (0-3)\n\n  queue = [(start_pos, start_dir, [])] \n  # Set of visited ((x, y), direction) tuples to prevent cycles and redundant path exploration\n  visited = {(start_pos, start_dir)} \n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.pop(0) # Dequeue for BFS\n\n    # Calculate the coordinates of the cell directly in front of the agent,\n    # which is the target for the USE action, based on the current direction.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # Check if the cell in front is within bounds and contains the primitive.\n    # Using the pre-computed set of locations for target checking.\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        (target_x, target_y) in target_primitive_locs):\n      # Found a path where the agent can move to a position, face the primitive,\n      # and then USE to collect it.\n      return path_actions + [USE_ACTION]\n    \n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # A movement action changes the agent's position and its facing direction.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple) # Mark the new state as visited\n        # Add the new state and its path to the queue for further exploration\n        queue.append((next_state_tuple[0], next_state_tuple[1], path_actions + [move_action]))\n\n  # If the queue becomes empty and no path was found, it means the primitive\n  # is unreachable from the current state.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:39:23.482547", "function_name": "collect", "function_body": "  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index.index(primitive)\n  water_idx = env.world.water_index\n  stone_idx = env.world.stone_index\n\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  target_primitive_locs = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        target_primitive_locs.append((x, y))\n\n  if not target_primitive_locs:\n    return []\n\n  def is_cell_impassable(x, y, target_p_idx, current_grid, water_i, stone_i):\n    \"\"\"\n    Checks if a cell at (x, y) is impassable for movement.\n    A cell is considered impassable if it contains water or stone,\n    UNLESS the target primitive itself is water or stone.\n    \"\"\"\n    if target_p_idx != water_i and current_grid[x, y, water_i] > 0:\n      return True\n    if target_p_idx != stone_i and current_grid[x, y, stone_i] > 0:\n      return True\n    return False\n\n  start_pos = current_state.pos\n  \n  # Queue for BFS stores (current_x, current_y)\n  queue = [start_pos] \n  # Dictionary to store parent node and action to reach current node, for path reconstruction\n  # { (x,y) : ((parent_x,parent_y), action_from_parent_to_here) }\n  visited_parent = {start_pos: (None, None)} \n\n  target_adjacent_pos = None # Stores the (x,y) that is adjacent to the primitive and reached by BFS\n\n  while queue:\n    curr_pos = queue.pop(0) # Pop from the beginning for BFS (O(N) operation for list)\n    curr_x, curr_y = curr_pos\n\n    # Check if the current position is adjacent to any of the target primitive locations\n    for px, py in target_primitive_locs:\n      # Using Manhattan distance to check for adjacency (up, down, left, right neighbors)\n      if (abs(curr_x - px) + abs(curr_y - py) == 1):\n        target_adjacent_pos = curr_pos # Found a position adjacent to a primitive\n        break # Exit inner loop, as we found a path to *an* adjacent cell\n    \n    if target_adjacent_pos is not None:\n        break # Exit outer while loop, as we've found our shortest path\n\n    # Explore all possible movements from the current position\n    for action, (dx, dy) in _ACTION_TO_COORD_DIFF.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position contains an impassable object (e.g., water or stone)\n      if is_cell_impassable(next_x, next_y, primitive_idx, grid, water_idx, stone_idx):\n          continue\n      \n      # If this position has not been visited yet\n      if next_pos not in visited_parent: # Check if already visited\n        visited_parent[next_pos] = (curr_pos, action) # Store parent and action\n        queue.append(next_pos) # Add the new position to the queue\n\n  if target_adjacent_pos is None:\n    # If the queue becomes empty and no path was found, it means the primitive\n    # is unreachable (e.g., completely surrounded by impassable cells).\n    return []\n\n  # Reconstruct the path by backtracking from the target_adjacent_pos to the start_pos\n  path = []\n  current_node = target_adjacent_pos\n  while current_node != start_pos:\n    parent_node, action_to_reach_current = visited_parent[current_node]\n    path.append(action_to_reach_current)\n    current_node = parent_node\n  \n  # The path is currently in reverse order (from target back to start), so reverse it\n  path.reverse()\n  \n  # Once adjacent to the primitive, the final action is to USE it to collect it.\n  return path + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:39:24.451861", "function_name": "collect", "function_body": "  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index.index(primitive)\n  water_idx = env.world.water_index\n  stone_idx = env.world.stone_index\n\n  # Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Find all locations on the grid where the primitive exists\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  target_primitive_locs = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the specific primitive layer at (x, y) has a count greater than 0\n      if grid[x, y, primitive_idx] > 0:\n        target_primitive_locs.append((x, y))\n\n  if not target_primitive_locs:\n    # The primitive is not found anywhere on the current map\n    return []\n\n  # Define an inner helper function for checking impassable cells\n  def is_cell_impassable(x, y):\n    \"\"\"\n    Checks if a cell at (x, y) is impassable for movement.\n    A cell is considered impassable if it contains water or stone,\n    UNLESS the target primitive itself is water or stone.\n    \"\"\"\n    if primitive_idx != water_idx and grid[x, y, water_idx] > 0:\n      return True\n    if primitive_idx != stone_idx and grid[x, y, stone_idx] > 0:\n      return True\n    return False\n\n  # Perform a Breadth-First Search (BFS) to find the shortest path\n  # to a cell adjacent to any of the found primitive locations, avoiding obstacles.\n  start_pos = current_state.pos\n  \n  # Using collections.deque for O(1) popleft() operations, which is more efficient for BFS\n  # than list.pop(0) which is O(N).\n  # Assumes 'collections' module is imported at the top level of the script.\n  # Assumes _ACTION_TO_COORD_DIFF and USE_ACTION are defined at the module level.\n  queue = collections.deque([(start_pos, [])]) \n  # Set of visited (x, y) coordinates to prevent cycles and redundant path exploration\n  visited = {start_pos} \n\n  best_path = None # This will store the sequence of actions once a path is found\n\n  while queue:\n    (curr_x, curr_y), path_actions = queue.popleft() # Dequeue the first element for BFS\n\n    # Check if the current position is adjacent to any of the target primitive locations\n    for px, py in target_primitive_locs:\n      # Using Manhattan distance to check for adjacency (up, down, left, right neighbors)\n      if (abs(curr_x - px) + abs(curr_y - py) == 1):\n        best_path = path_actions # Path found! BFS guarantees this is the shortest path.\n        break # Exit inner loop, as we found a path to *an* adjacent cell\n    \n    if best_path is not None:\n        break # Exit outer while loop, as we've found our shortest path\n\n    # Explore all possible movements from the current position\n    for action, (dx, dy) in _ACTION_TO_COORD_DIFF.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position contains an impassable object (e.g., water or stone)\n      if is_cell_impassable(next_x, next_y):\n          continue\n      \n      # If this position has not been visited yet\n      if next_pos not in visited:\n        visited.add(next_pos) # Mark the new position as visited\n        # Add the new position and its path to the queue\n        queue.append((next_pos, path_actions + [action]))\n\n  if best_path is None:\n    # If the queue becomes empty and no path was found, it means the primitive\n    # is unreachable (e.g., completely surrounded by impassable cells).\n    return []\n\n  # Once adjacent to the primitive, the final action is to USE it to collect it.\n  return best_path + [USE_ACTION]", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:40:43.723079", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # 1. Check if primitive is already in inventory\n  obs = env.observations()\n  current_inventory = obs['features_dict']['inventory']\n  if current_inventory[primitive] > 0:\n      return [] # Already collected, no actions needed.\n\n  # Action constants (from problem description context)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction constants (matching internal representation: 0=N, 1=E, 2=S, 3=W)\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Map movement action values to (dx, dy) deltas\n  MOVEMENT_DELTAS = {\n      ACTION_UP: (0, -1),   # (dx, dy) for moving UP (North)\n      ACTION_DOWN: (0, 1),  # (dx, dy) for moving DOWN (South)\n      ACTION_LEFT: (-1, 0), # (dx, dy) for moving LEFT (West)\n      ACTION_RIGHT: (1, 0), # (dx, dy) for moving RIGHT (East)\n  }\n\n  # Map movement action values to the resulting agent direction\n  # This assumes that taking a movement action makes the agent face that direction.\n  ACTION_TO_DIRECTION = {\n      ACTION_UP: DIR_NORTH,\n      ACTION_RIGHT: DIR_EAST,\n      ACTION_DOWN: DIR_SOUTH,\n      ACTION_LEFT: DIR_WEST,\n  }\n\n  # Map (dx, dy) from agent's position to target cell to the required agent direction\n  RELATIVE_POS_TO_DIRECTION = {\n      (0, -1): DIR_NORTH, # Target is UP relative to agent -> agent must face North\n      (1, 0): DIR_EAST,   # Target is RIGHT relative to agent -> agent must face East\n      (0, 1): DIR_SOUTH,  # Target is DOWN relative to agent -> agent must face South\n      (-1, 0): DIR_WEST,  # Target is LEFT relative to agent -> agent must face West\n  }\n\n  # Get current state information from the environment\n  grid = obs['features_dict']['features_global']\n  \n  # Ensure position is int tuple. CraftState.pos is tuple(int, int)\n  # The features_dict['pos'] might be normalized or float, so convert to int tuple.\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  # Current direction is a one-hot array, convert to an integer (0=N, 1=E, 2=S, 3=W)\n  current_dir = np.argmax(obs['features_dict']['direction'])\n  \n  world = env.world\n  # non_grabbable_indices are assumed to be obstacles that cannot be traversed.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape\n\n  # 2. Determine traversable cells using NumPy for efficiency.\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  # Create a boolean array where True means the kind is non-grabbable.\n  is_obstacle_kind = np.isin(np.arange(K), list(non_grabbable_indices))\n  # Check if any non-grabbable kind has a count > 0 in any cell across the K-dimension.\n  has_obstacle = (grid[:, :, is_obstacle_kind] > 0).any(axis=-1)\n  # Invert the mask: where there's an obstacle, it's NOT traversable.\n  traversable_mask = ~has_obstacle\n  \n  # Check if the agent's start position is traversable. If not, no path possible.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return []\n\n  # 3. Determine target entity kinds that can be 'used' to obtain the 'primitive'.\n  target_kinds_for_use = {primitive} # Always include the primitive itself for direct pickup\n  \n  primitive_name = world.cookbook.index.get(primitive)\n  if primitive_name == 'water':\n      target_kinds_for_use.add(world.water_index) # Add water block index as a source\n  elif primitive_name == 'stone':\n      target_kinds_for_use.add(world.stone_index) # Add stone block index as a source\n  # Extend with more mappings if needed (e.g., 'wood' from a 'tree' block index)\n\n  # 4. Find all potential (agent_pos, agent_dir) states from which the agent can successfully USE to get the primitive.\n  # These are the \"goal states\" for our BFS.\n  target_pickup_states = set() # Stores elements as ((agent_x, agent_y), required_dir)\n  for item_x in range(W):\n      for item_y in range(H):\n          # Check if this cell contains any of our target kinds for use\n          contains_target_kind = False\n          for target_kind_idx in target_kinds_for_use:\n              if grid[item_x, item_y, target_kind_idx] > 0:\n                  contains_target_kind = True\n                  break\n          \n          if contains_target_kind:\n              # This cell (item_x, item_y) has an item/block we can use.\n              # Now, find all cardinal adjacent traversable cells from which an agent could USE it.\n              for dx_adj, dy_adj in [ (0, -1), (0, 1), (-1, 0), (1, 0) ]: # Cardinal neighbors relative to the item\n                  agent_x, agent_y = item_x + dx_adj, item_y + dy_adj\n                  \n                  if (0 <= agent_x < W and 0 <= agent_y < H and\n                      traversable_mask[agent_x, agent_y]): # Agent's potential position must be traversable\n                      \n                      # Calculate the direction the agent needs to face from (agent_x, agent_y) to (item_x, item_y)\n                      # This is (item_x - agent_x, item_y - agent_y)\n                      relative_item_pos = (item_x - agent_x, item_y - agent_y)\n                      required_dir = RELATIVE_POS_TO_DIRECTION.get(relative_item_pos)\n                      \n                      if required_dir is not None: # Should always be true for cardinal neighbors\n                          target_pickup_states.add(((agent_x, agent_y), required_dir))\n  \n  if not target_pickup_states:\n      return [] # No primitive found or no reachable pickup spots around it\n\n  # 5. Perform BFS to find the shortest sequence of actions to reach any target_pickup_state\n  # Queue stores (current_pos, current_dir, path_actions_so_far)\n  q = deque([(current_pos, current_dir, [])])\n  # Visited states are (position_tuple, direction_integer) to prevent redundant exploration\n  visited = {(current_pos, current_dir)} \n\n  while q:\n      curr_pos, curr_dir, path_so_far = q.popleft()\n\n      # Check if the current state (position, direction) is one of our goal states\n      if (curr_pos, curr_dir) in target_pickup_states:\n          return path_so_far + [ACTION_USE] # Path found, append USE action and return\n\n      # Explore possible actions: movements and turning in place\n      for action_val, (dx, dy) in MOVEMENT_DELTAS.items():\n          potential_next_pos = (curr_pos[0] + dx, curr_pos[1] + dy)\n          potential_next_dir = ACTION_TO_DIRECTION[action_val]\n\n          # Check if the next position is within grid bounds, traversable, and not yet visited.\n          if (0 <= potential_next_pos[0] < W and 0 <= potential_next_pos[1] < H and\n              traversable_mask[potential_next_pos[0], potential_next_pos[1]]):\n              # This is a valid movement to a new cell\n              next_pos_state = potential_next_pos\n              next_dir_state = potential_next_dir\n              if (next_pos_state, next_dir_state) not in visited:\n                  visited.add((next_pos_state, next_dir_state))\n                  q.append((next_pos_state, next_dir_state, path_so_far + [action_val]))\n          else:\n              # Movement is blocked (e.g., hitting a wall or non-grabbable obstacle) OR out of bounds.\n              # Agent stays at curr_pos but its direction changes to potential_next_dir.\n              next_pos_state = curr_pos\n              next_dir_state = potential_next_dir\n              # Only add if this (pos, dir) state is new\n              if (next_pos_state, next_dir_state) not in visited:\n                  visited.add((next_pos_state, next_dir_state))\n                  q.append((next_pos_state, next_dir_state, path_so_far + [action_val]))\n        \n  return [] # No path found to a pickup spot", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:40:44.688069", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  actions = []\n  \n  # Action constants (from problem description context)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction constants (matching internal representation: 0=N, 1=E, 2=S, 3=W)\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Map movement action values to (dx, dy) deltas\n  # This represents the intended movement. If blocked, the agent stays put.\n  MOVEMENT_DELTAS = {\n      ACTION_UP: (0, -1),   # (dx, dy) for moving UP (North)\n      ACTION_DOWN: (0, 1),  # (dx, dy) for moving DOWN (South)\n      ACTION_LEFT: (-1, 0), # (dx, dy) for moving LEFT (West)\n      ACTION_RIGHT: (1, 0), # (dx, dy) for moving RIGHT (East)\n  }\n\n  # Map movement action values to the resulting agent direction\n  # Taking any movement action sets the agent's direction to that cardinal direction.\n  ACTION_TO_DIRECTION = {\n      ACTION_UP: DIR_NORTH,\n      ACTION_RIGHT: DIR_EAST,\n      ACTION_DOWN: DIR_SOUTH,\n      ACTION_LEFT: DIR_WEST,\n  }\n  \n  # Map directions to (dx, dy) deltas for checking the cell in front\n  DIR_TO_DELTA = {\n      DIR_NORTH: (0, -1),\n      DIR_EAST: (1, 0),\n      DIR_SOUTH: (0, 1),\n      DIR_WEST: (-1, 0),\n  }\n\n  # Helper to get the coordinates of the cell directly in front of the agent\n  def _get_cell_in_front(pos, direction):\n      px, py = pos\n      dx, dy = DIR_TO_DELTA[direction]\n      return (px + dx, py + dy)\n\n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Current position and direction of the agent\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  current_dir = np.argmax(obs['features_dict']['direction'])\n  \n  world = env.world\n  # non_grabbable_indices are assumed to be obstacles that cannot be traversed.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  is_obstacle_kind = np.isin(np.arange(K), list(non_grabbable_indices))\n  has_obstacle = (grid[:, :, is_obstacle_kind] > 0).any(axis=-1)\n  traversable_mask = ~has_obstacle\n  \n  # Ensure the agent's start position is traversable. If not, no path possible.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return []\n\n  # 2. Determine target entity kinds that can be 'used' to obtain the 'primitive'.\n  # This includes the primitive itself (for direct pickup) and any source blocks.\n  target_grid_indices = {primitive} \n  primitive_name = world.cookbook.index.get(primitive)\n\n  # Add source blocks for specific primitives (e.g., water from water block)\n  if primitive_name == 'water':\n      target_grid_indices.add(world.water_index) \n  elif primitive_name == 'stone':\n      target_grid_indices.add(world.stone_index) \n  # Add more mappings here if other primitives come from specific blocks (e.g., 'wood' from a 'tree' block)\n\n  # 3. Perform BFS to find the shortest sequence of actions to reach a state\n  # where the agent can successfully USE to get the primitive.\n  # Queue stores (current_pos, current_dir, path_actions_so_far)\n  q = deque([(current_pos, current_dir, [])])\n  # Visited states are (position_tuple, direction_integer) to prevent redundant exploration\n  visited = {(current_pos, current_dir)} \n\n  while q:\n      curr_pos, curr_dir, path_so_far = q.popleft()\n\n      # Check if the current state (position, direction) allows for a successful USE action\n      target_cell = _get_cell_in_front(curr_pos, curr_dir)\n      tx, ty = target_cell\n\n      # Check if target_cell is within bounds\n      if 0 <= tx < W and 0 <= ty < H:\n          # Check if the cell in front contains any of the target primitive kinds\n          contains_target_kind = False\n          for target_kind_idx in target_grid_indices:\n              if grid[tx, ty, target_kind_idx] > 0:\n                  contains_target_kind = True\n                  break\n          \n          if contains_target_kind:\n              return path_so_far + [ACTION_USE] # Path found, append USE action and return\n\n      # Explore possible actions: movements and turning in place\n      for action_val, (move_dx, move_dy) in MOVEMENT_DELTAS.items():\n          potential_next_x, potential_next_y = curr_pos[0] + move_dx, curr_pos[1] + move_dy\n          next_dir = ACTION_TO_DIRECTION[action_val]\n\n          next_pos = curr_pos # Default: agent stays put (if blocked)\n          # Check if the intended movement is valid (within bounds and traversable)\n          if (0 <= potential_next_x < W and 0 <= potential_next_y < H and\n              traversable_mask[potential_next_x, potential_next_y]):\n              next_pos = (potential_next_x, potential_next_y) # Agent moves\n          # Else, agent stays at curr_pos but still changes direction to next_dir\n\n          next_state_tuple = (next_pos, next_dir)\n          if next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              q.append((next_pos, next_dir, path_so_far + [action_val]))\n        \n  return [] # No path found to a pickup spot from the current state", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:43:02.762657", "function_name": "collect", "function_body": "  import collections\n\n  # Map movement actions (0-3) to their corresponding (dr, dc) deltas\n  # Based on: DOWN=0, UP=1, LEFT=2, RIGHT=3\n  ACTION_TO_DELTA = {\n      0: (1, 0),  # DOWN (row increases)\n      1: (-1, 0), # UP (row decreases)\n      2: (0, -1), # LEFT (column decreases)\n      3: (0, 1),  # RIGHT (column increases)\n  }\n\n  # The USE action is 4, as per action_specs\n  USE_ACTION_CODE = 4\n\n  state = env._current_state\n  grid = state.grid\n  current_pos = state.pos\n  initial_dir = state.dir # The agent's initial facing direction\n\n  # Grid dimensions\n  width, height, _ = grid.shape\n\n  # Identify impassable obstacles. These are entities the agent cannot move onto.\n  # CraftWorld's non_grabbable_indices typically include walls, water, etc.\n  non_grabbable_indices = state.world.non_grabbable_indices\n\n  # BFS queue: Stores tuples of ( (row, column), list_of_actions_taken, current_facing_direction )\n  # The facing direction is critical because the 'USE' action is assumed to be directional.\n  queue = collections.deque([(current_pos, [], initial_dir)])\n\n  # Visited set: Stores tuples of (row, column, facing_direction) to prevent revisiting identical states\n  # This avoids infinite loops and redundant computation.\n  visited = set([(current_pos[0], current_pos[1], initial_dir)])\n\n  while queue:\n    (r, c), path, current_direction = queue.popleft()\n\n    # Determine the cell directly in front of the agent based on its current position and facing direction\n    front_dr, front_dc = ACTION_TO_DELTA[current_direction]\n    target_r, target_c = r + front_dr, c + front_dc\n\n    # Check if the cell in front is within grid boundaries and contains the target primitive\n    if (0 <= target_r < width and 0 <= target_c < height and\n        grid[target_r, target_c, primitive] > 0):\n      # If the primitive is found at the cell the agent is facing, append 'USE' action and return the path\n      return path + [USE_ACTION_CODE]\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state\n    for action_move_code, (dr, dc) in ACTION_TO_DELTA.items():\n      new_r, new_c = r + dr, c + dc\n\n      # Check if the new position is within the grid boundaries\n      if not (0 <= new_r < width and 0 <= new_c < height):\n        continue\n\n      # Check if the new position is blocked by an obstacle (non-grabbable entity)\n      is_obstacle = False\n      for obstacle_idx in non_grabbable_indices:\n        if grid[new_r, new_c, obstacle_idx] > 0:\n          is_obstacle = True\n          break\n      if is_obstacle:\n        continue\n\n      # The agent's new facing direction becomes the direction of the movement action\n      new_direction = action_move_code\n\n      # Create a tuple representing the new state (position and direction)\n      new_state_tuple = (new_r, new_c, new_direction)\n      \n      # If this new state has not been visited yet, add it to the queue\n      if new_state_tuple not in visited:\n        visited.add(new_state_tuple)\n        new_path = path + [action_move_code]\n        queue.append(((new_r, new_c), new_path, new_direction))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found, return an empty list\n  return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:43:02.833281", "function_name": "collect", "function_body": "    # Define action mappings and direction vectors internally for clarity and scope\n    ACTION_MAP = {'DOWN': 0, 'UP': 1, 'LEFT': 2, 'RIGHT': 3, 'USE': 4}\n    DIR_VECTORS = { # (dr, dc) when facing UP (0), RIGHT (1), DOWN (2), LEFT (3)\n        0: (-1, 0),  # UP (North)\n        1: (0, 1),   # RIGHT (East)\n        2: (1, 0),   # DOWN (South)\n        3: (0, -1)   # LEFT (West)\n    }\n\n    # Helper function for Breadth-First Search (BFS) to find a path to the target item\n    def _find_path_to_item(start_pos, start_dir, target_item_idx, current_grid, world_data, max_depth=200):\n        rows, cols, _ = current_grid.shape\n        \n        # Determine if the target item requires a 'USE' action or is simply grabbable by walking over\n        is_primitive_workshop = target_item_idx in world_data['workshop_indices']\n        is_primitive_grabbable = target_item_idx in world_data['grabbable_indices']\n        is_primitive_item = target_item_idx in world_data['primitives_indices'] or target_item_idx in world_data['workshop_indices']\n        is_primitive_use_item = is_primitive_item and not is_primitive_grabbable\n        \n        # BFS queue: stores (current_position (r,c), current_direction, list_of_actions_taken)\n        q = collections.deque([(start_pos, start_dir, [])]) \n        # Visited set to avoid cycles and redundant exploration: stores (position, direction)\n        visited = set([(start_pos, start_dir)])\n\n        # Pre-calculate all locations where the target item exists on the current grid\n        target_locations = []\n        for r in range(rows):\n            for c in range(cols):\n                if current_grid[r, c, target_item_idx] > 0:\n                    target_locations.append((r, c))\n        \n        if not target_locations:\n            return [] # Target item not found anywhere on the map\n        \n        # If the agent is already on a grabbable item's location, no path is needed.\n        # This assumes the item is picked up automatically when moving onto its cell.\n        if is_primitive_grabbable and start_pos in target_locations:\n            return [] \n\n        while q:\n            (r, c), current_dir, actions = q.popleft()\n\n            # Stop exploring this path if it exceeds max_depth\n            if len(actions) >= max_depth:\n                continue\n            \n            # Goal check for grabbable items: If current position is a target location\n            if is_primitive_grabbable and (r, c) in target_locations:\n                return actions\n            \n            # Goal check for 'use' items: If adjacent to a target location AND facing it correctly\n            if is_primitive_use_item:\n                # Check all cardinal neighbors\n                for target_relative_dir, (dr_adj, dc_adj) in DIR_VECTORS.items():\n                    nr_adj, nc_adj = r + dr_adj, c + dc_adj\n                    if (nr_adj, nc_adj) in target_locations:\n                        # If the agent is currently facing this adjacent target\n                        if current_dir == target_relative_dir:\n                            # Found a path to be adjacent and facing. Append 'USE' action.\n                            return actions + [ACTION_MAP['USE']]\n            \n            # Explore possible actions (move forward/backward, turn left/right)\n            for action_name in ['UP', 'DOWN', 'LEFT', 'RIGHT']:\n                action = ACTION_MAP[action_name]\n                \n                next_r, next_c, next_dir = r, c, current_dir\n                \n                # Calculate new position and direction based on the action\n                if action == ACTION_MAP['UP']: # Move forward\n                    dr, dc = DIR_VECTORS[current_dir]\n                    next_r, next_c = r + dr, c + dc\n                elif action == ACTION_MAP['DOWN']: # Move backward\n                    dr, dc = DIR_VECTORS[(current_dir + 2) % 4] # Opposite direction\n                    next_r, next_c = r + dr, c + dc\n                elif action == ACTION_MAP['LEFT']: # Turn left\n                    next_dir = (current_dir - 1 + 4) % 4\n                elif action == ACTION_MAP['RIGHT']: # Turn right\n                    next_dir = (current_dir + 1) % 4\n                \n                # Check if the new position is within grid boundaries\n                if not (0 <= next_r < rows and 0 <= next_c < cols):\n                    continue\n                \n                # Check for collision with non-walkable terrain (e.g., walls, other permanent obstacles).\n                # A cell is considered blocked if it contains any non-grabbable item that is NOT the target item itself.\n                is_blocked = False\n                for kind_idx in world_data['non_grabbable_indices']:\n                    if current_grid[next_r, next_c, kind_idx] > 0 and kind_idx != target_item_idx:\n                        is_blocked = True\n                        break\n                if is_blocked:\n                    continue\n\n                # Create the new state tuple\n                new_state = ((next_r, next_c), next_dir)\n                # If this state has already been visited, skip to avoid redundant paths and cycles\n                if new_state in visited:\n                    continue\n                \n                # Add the new state to the visited set and the queue for further exploration\n                visited.add(new_state)\n                q.append(((next_r, next_c), next_dir, actions + [action]))\n                \n        return [] # No path found within the max_depth limit\n\n    all_actions = []\n    \n    # Reset the environment to ensure a consistent starting state.\n    # A random seed is used to allow for different initial world configurations if the world supports it.\n    env.reset(seed=env.world.random.randint(0, 100000)) \n    current_state = env._current_state # Get the initial CraftState object\n    \n    # Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n    \n    # Gather necessary world data for pathfinding (e.g., what items are grabbable, workshops, etc.)\n    world_data = {\n        'grabbable_indices': current_state.world.grabbable_indices,\n        'workshop_indices': current_state.world.workshop_indices,\n        'non_grabbable_indices': current_state.world.non_grabbable_indices,\n        'primitives_indices': current_state.world.primitives,\n    }\n\n    # Set a maximum number of steps for the collection process to prevent infinite loops.\n    # Use `env.task.steps` if available, otherwise a default value.\n    MAX_COLLECT_STEPS = env.task.steps if env.task.steps > 0 else 500 \n    \n    steps_taken = 0\n    \n    # Main loop: Continue until the primitive is collected or max steps are reached\n    while current_state.inventory[primitive] == 0 and steps_taken < MAX_COLLECT_STEPS:\n        # Get current agent position, direction, and the full grid state\n        current_pos = current_state.pos\n        current_dir = current_state.dir\n        current_grid = current_state.grid \n        \n        # Attempt to find a path to the primitive using BFS\n        path_actions = _find_path_to_item(current_pos, current_dir, primitive, current_grid, world_data)\n        \n        if path_actions:\n            # If a path is found, execute each action in the path\n            for action in path_actions:\n                # Re-check inventory before each action in case the item was collected by a previous action in the path\n                if current_state.inventory[primitive] > 0:\n                    return all_actions # Collected, return the sequence of actions\n                \n                # Perform the action in the environment\n                _, _, _ = env.step(action) \n                all_actions.append(action) # Record the action\n                steps_taken += 1\n                \n                # Update the current state from the environment's internal state\n                current_state = env._current_state\n                \n                # Break if total steps exceed the limit\n                if steps_taken >= MAX_COLLECT_STEPS:\n                    break\n            \n            # After executing the path, check if the primitive was collected\n            if current_state.inventory[primitive] > 0:\n                return all_actions # Collected, return actions\n        else:\n            # If no path was found (e.g., item not visible, blocked, or unreachable by BFS),\n            # try a simple exploration strategy to potentially find it or move to a new area.\n            # This sequence aims to turn and move, allowing a new BFS search from a different location.\n            explore_actions_sequence = [\n                ACTION_MAP['RIGHT'], # Turn right\n                ACTION_MAP['UP'],    # Move forward\n                ACTION_MAP['UP'],    # Move forward\n                ACTION_MAP['LEFT'],  # Turn left (to potentially spiral out)\n                ACTION_MAP['UP'],    # Move forward\n                ACTION_MAP['UP']     # Move forward\n            ]\n            \n            for action in explore_actions_sequence:\n                # Re-check inventory before each exploration action\n                if current_state.inventory[primitive] > 0:\n                    return all_actions\n                \n                # Perform the exploration action\n                _, _, _ = env.step(action)\n                all_actions.append(action)\n                steps_taken += 1\n                current_state = env._current_state\n                \n                # Break if total steps exceed the limit during exploration\n                if steps_taken >= MAX_COLLECT_STEPS:\n                    break\n            \n            # If the primitive is still not collected after exploration and max steps are reached,\n            # it might be unreachable or not present.\n            if current_state.inventory[primitive] == 0 and steps_taken >= MAX_COLLECT_STEPS:\n                return all_actions # Return the actions taken so far\n\n    return all_actions # Return the list of actions taken (may be empty if already collected or not found)", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:44:07.597877", "function_name": "collect", "function_body": "  # Constants for actions based on CraftLab.action_specs\n  # These are defined here for self-containment within the function.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Get the current state from the environment\n  # The `env` object is a CraftLab instance, which holds the current CraftState.\n  state = env._current_state\n  actions = []\n\n  # 1. Check if the primitive is already in the agent's inventory\n  if state.inventory[primitive] > 0:\n      return actions # Already collected, no actions needed\n\n  # 2. Find the primitive's location on the grid\n  primitive_x, primitive_y = -1, -1\n  grid = state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Iterate through the grid to find the first occurrence of the primitive\n  for x_coord in range(WIDTH):\n      for y_coord in range(HEIGHT):\n          # Check if the current cell contains the primitive kind\n          if grid[x_coord, y_coord, primitive] > 0:\n              primitive_x, primitive_y = x_coord, y_coord\n              break # Found the primitive, exit inner loop\n      if primitive_x != -1:\n          break # Found the primitive, exit outer loop\n\n  # 3. If the primitive was not found on the grid, return an empty list of actions.\n  # This implies the target primitive is not currently present or observable in the world.\n  if primitive_x == -1:\n      return []\n\n  # 4. Get the agent's current position\n  agent_x, agent_y = state.pos\n\n  # 5. Calculate the movement needed to reach the primitive's location.\n  # This simple strategy moves horizontally first, then vertically.\n  dx = primitive_x - agent_x\n  dy = primitive_y - agent_y\n\n  # Add actions for horizontal movement\n  if dx > 0: # Agent needs to move right\n      actions.extend([RIGHT] * dx)\n  elif dx < 0: # Agent needs to move left\n      actions.extend([LEFT] * abs(dx))\n\n  # Add actions for vertical movement\n  if dy > 0: # Agent needs to move down\n      actions.extend([DOWN] * dy)\n  elif dy < 0: # Agent needs to move up\n      actions.extend([UP] * abs(dy))\n\n  # 6. After moving to the primitive's location (or being adjacent if already there),\n  #    use the item. The CraftState.step(USE) logic is designed to check the 3x3\n  #    neighborhood (including the agent's current cell) for grabbable items.\n  actions.append(USE)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:44:08.559343", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from problem description / env_factory.py)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction constants (from CraftState internal representation)\n  DIR_NORTH = 0  # Facing (0, -1)\n  DIR_EAST = 1   # Facing (1, 0)\n  DIR_SOUTH = 2  # Facing (0, 1)\n  DIR_WEST = 3   # Facing (-1, 0)\n\n  # Helper for (dx, dy) movement -> action_move\n  MOVE_ACTIONS = {\n      (0, -1): ACTION_UP,\n      (0, 1): ACTION_DOWN,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT,\n  }\n\n  # Helper for (dx, dy) between agent and target -> target_direction\n  FACE_DIRECTIONS = {\n      (0, -1): DIR_NORTH,\n      (0, 1): DIR_SOUTH,\n      (-1, 0): DIR_WEST,\n      (1, 0): DIR_EAST,\n  }\n\n  # Delta for neighbors (South, North, West, East)\n  NEIGHBOR_DELTAS = [\n      (0, 1),\n      (0, -1),\n      (-1, 0),\n      (1, 0),\n  ]\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos\n  current_dir = current_state.dir\n  world = current_state.world\n\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n  water_index = world.water_index # Assuming water is the primary un-traversable obstacle\n\n  # 1. Find all cells containing the primitive\n  # np.argwhere returns (row, col) for 2D arrays, but grid is (x,y,kind).\n  # Assuming x is first dim, y is second.\n  primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n  \n  if not primitive_locations.size > 0:\n      # No primitive found, return empty actions\n      return []\n\n  # 2. Perform BFS to find the shortest path to a cell adjacent to any primitive\n  queue = collections.deque([(current_pos, [current_pos])]) # (current_pos, path_so_far_including_current_pos)\n  visited = {current_pos}\n  \n  best_path = None\n  target_primitive_location = None # The actual primitive location we're aiming for\n\n  while queue:\n      (x, y), path = queue.popleft()\n\n      # Check if current (x, y) is adjacent to a primitive\n      for px, py in primitive_locations:\n          # Manhattan distance of 1 means direct adjacency (horizontal or vertical)\n          if abs(x - px) + abs(y - py) == 1:\n              # Found an adjacent cell! (x,y) is where the agent needs to stand.\n              best_path = path \n              target_primitive_location = (px, py)\n              break # Found the closest primitive, break inner loop\n      if best_path:\n          break # Found the closest primitive, break outer loop\n\n      # Explore neighbors\n      for dx, dy in NEIGHBOR_DELTAS:\n          nx, ny = x + dx, y + dy\n\n          # Check bounds\n          if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n              continue\n          \n          # Check if obstacle (water)\n          if grid[nx, ny, water_index] == 1:\n              continue\n\n          if (nx, ny) not in visited:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(nx, ny)]))\n\n  if not best_path:\n      # No path found to any primitive (e.g., surrounded by obstacles)\n      return []\n\n  # 3. Generate movement actions from path\n  # best_path includes the starting position. We need steps from p_i to p_{i+1}\n  for i in range(len(best_path) - 1):\n      p_curr_x, p_curr_y = best_path[i]\n      p_next_x, p_next_y = best_path[i+1]\n\n      move_dx, move_dy = p_next_x - p_curr_x, p_next_y - p_curr_y\n      actions.append(MOVE_ACTIONS[(move_dx, move_dy)])\n  \n  # 4. Orient agent and USE\n  # After movement, agent is at best_path[-1]\n  agent_final_pos = best_path[-1]\n  \n  # Calculate vector from agent's final position to the primitive\n  face_dx = target_primitive_location[0] - agent_final_pos[0]\n  face_dy = target_primitive_location[1] - agent_final_pos[1]\n  \n  # Determine the target direction the agent needs to face\n  target_face_dir = FACE_DIRECTIONS[(face_dx, face_dy)]\n\n  # Calculate turns needed based on initial direction and target direction\n  # (target_face_dir - initial_dir + 4) % 4 gives turns clockwise (0, 1, 2, 3)\n  # 0 = no turn, 1 = 90 deg right, 2 = 180 deg, 3 = 90 deg left\n  turns_needed = (target_face_dir - current_dir + 4) % 4\n  \n  if turns_needed == 1: # 90 deg clockwise (e.g., N->E)\n      actions.append(ACTION_RIGHT)\n  elif turns_needed == 2: # 180 deg (e.g., N->S)\n      actions.append(ACTION_RIGHT)\n      actions.append(ACTION_RIGHT)\n  elif turns_needed == 3: # 90 deg counter-clockwise (e.g., N->W)\n      actions.append(ACTION_LEFT)\n  # If turns_needed == 0, no turn actions are added.\n\n  # Finally, use the primitive\n  actions.append(ACTION_USE)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:45:46.861650", "function_name": "collect", "function_body": "    primitive_idx = env.world.cookbook.index.index(primitive)\n    \n    # Get current state information from the environment\n    current_state = env._current_state\n    initial_r, initial_c = current_state.pos\n    initial_dir = current_state.dir\n    inventory = current_state.inventory\n    \n    # Check if primitive is already in inventory\n    if inventory[primitive_idx] > 0:\n        return [] # Already collected\n\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n    # Define constants for actions and directions, assuming they are available globally\n    # DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n    # ACTION_MOVEMENTS = {\n    #     DOWN: (1, 0), UP: (-1, 0), LEFT: (0, -1), RIGHT: (0, 1)\n    # }\n    # ACTION_TO_DIR = {\n    #     DOWN: 1, UP: 3, LEFT: 2, RIGHT: 0\n    # }\n    # DIR_TO_VEC = {\n    #     0: (0, 1), 1: (1, 0), 2: (0, -1), 3: (-1, 0)\n    # }\n\n    # Map movement actions to (dr, dc) delta\n    ACTION_MOVEMENTS = {\n        0: (1, 0),   # DOWN (South)\n        1: (-1, 0),  # UP (North)\n        2: (0, -1),  # LEFT (West)\n        3: (0, 1)    # RIGHT (East)\n    }\n\n    # Map movement actions to the agent's new facing direction\n    # (Assuming action sets agent's direction to match movement direction)\n    ACTION_TO_DIR = {\n        0: 1, # DOWN -> Agent faces South (dir 1)\n        1: 3, # UP -> Agent faces North (dir 3)\n        2: 2, # LEFT -> Agent faces West (dir 2)\n        3: 0  # RIGHT -> Agent faces East (dir 0)\n    }\n\n    # Map agent facing direction to (dr, dc) vector for `USE` action\n    DIR_TO_VEC = {\n        0: (0, 1),  # East\n        1: (1, 0),  # South\n        2: (0, -1), # West\n        3: (-1, 0)  # North\n    }\n\n    # Obstacle indices are non-grabbable entities from the environment set.\n    # The agent cannot traverse cells containing these, unless the primitive itself is one of them,\n    # in which case it serves as the target, not a traversable spot.\n    obstacle_indices = env.world.environment\n\n    def is_walkable(r, c, grid_state, target_primitive_idx):\n        \"\"\"Checks if a cell (r, c) is traversable by the agent.\"\"\"\n        if not (0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT):\n            return False\n        \n        # Check if the cell contains any blocking obstacles\n        for kind_idx in obstacle_indices:\n            if grid_state[r, c, kind_idx] > 0:\n                # If the cell contains the primitive we are trying to collect,\n                # the agent cannot stand on it, but must interact from an adjacent cell.\n                # So it's an 'obstacle' for agent's standing position.\n                if kind_idx == target_primitive_idx:\n                    return False\n                # If it's any other non-grabbable item (like water/stone not being collected),\n                # it's an obstacle.\n                else:\n                    return False\n        return True\n\n    # BFS implementation to find shortest path to a collectable state\n    queue = collections.deque()\n    visited = set() # Stores (row, col, direction) to prevent cycles and redundant exploration\n\n    queue.append((initial_r, initial_c, initial_dir, [])) # (r, c, current_direction, actions_so_far)\n    visited.add((initial_r, initial_c, initial_dir))\n\n    while queue:\n        r, c, current_dir_val, path_actions = queue.popleft()\n\n        # Calculate the cell directly in front of the agent\n        dr_facing, dc_facing = DIR_TO_VEC[current_dir_val]\n        target_cell_r, target_cell_c = r + dr_facing, c + dc_facing\n\n        # Check if the cell in front is within bounds and contains the primitive\n        if (0 <= target_cell_r < GRID_WIDTH and 0 <= target_cell_c < GRID_HEIGHT and\n            grid[target_cell_r, target_cell_c, primitive_idx] > 0):\n            \n            # This state allows for a successful 'USE' action.\n            # We already ensure that the agent's current position (r,c) does not contain the primitive\n            # because `is_walkable(r, c, grid, primitive_idx)` would have returned False for such a spot.\n            return path_actions + [4] # 4 is the USE action\n\n        # Explore possible next states by moving\n        for action_type, (dr_move, dc_move) in ACTION_MOVEMENTS.items():\n            nr, nc = r + dr_move, c + dc_move\n            new_dir = ACTION_TO_DIR[action_type] # Agent's direction changes to match movement\n\n            # Check if the new cell is walkable\n            if not is_walkable(nr, nc, grid, primitive_idx):\n                continue\n\n            # If this new (position, direction) state has not been visited\n            if (nr, nc, new_dir) not in visited:\n                visited.add((nr, nc, new_dir))\n                queue.append((nr, nc, new_dir, path_actions + [action_type]))\n\n    return [] # No path found to collect the primitive", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:45:47.829550", "function_name": "collect", "function_body": "  import heapq # This import assumes heapq is not already imported at the module level.\n                # If it is, this line should be removed according to strict \"no imports\" rule.\n                # Given 'numpy' and 'env_factory' are often imported at the top,\n                # it's reasonable to assume heapq is too. Removing for final output based on prompt.\n\n  # Re-importing here just for self-contained testing.\n  # from __future__ import division\n  # from __future__ import print_function\n  # import numpy as np\n  # import time\n  # import env_factory # Assuming env_factory defines actions as a Struct or similar\n  # import heapq # Assume this is available globally if not added here.\n\n  # Get action mappings from env_factory, as per common usage in such environments.\n  actions = env_factory.actions \n\n  # Get current observations from the environment\n  obs = env.observations()\n  current_inventory = obs['features_dict']['inventory']\n  current_grid = obs['features_dict']['features_global'] # Full grid, shape (WIDTH, HEIGHT, n_kinds)\n\n  # Check if primitive is already collected\n  if current_inventory[primitive] > 0:\n      return [] # Already collected\n\n  # Get grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = current_grid.shape\n\n  # Extract agent's current position from normalized features and unnormalize to grid coordinates (x, y)\n  agent_x = int(obs['features_dict']['pos'][0] * (WIDTH - 1))\n  agent_y = int(obs['features_dict']['pos'][1] * (HEIGHT - 1))\n  current_pos_int = (agent_x, agent_y) # Agent's position as (x, y)\n\n  # Check if the agent is already next to (or on) the primitive\n  # Iterate through a 3x3 neighborhood around the agent's current position\n  is_next_to_primitive = False\n  for dy_check in [-1, 0, 1]:\n      for dx_check in [-1, 0, 1]:\n          nx_check, ny_check = current_pos_int[0] + dx_check, current_pos_int[1] + dy_check\n          if 0 <= nx_check < WIDTH and 0 <= ny_check < HEIGHT:\n              if current_grid[nx_check, ny_check, primitive] == 1: # grid[x, y, k]\n                  is_next_to_primitive = True\n                  break\n      if is_next_to_primitive:\n          break\n\n  if is_next_to_primitive:\n      return [actions.USE] # Agent is next to or on the primitive, just use it\n\n  # If not already next to it, find the primitive on the grid\n  # np.argwhere on current_grid[:, :, primitive] (which has shape (WIDTH, HEIGHT))\n  # returns (x_coord, y_coord) pairs where the value is 1.\n  primitive_locations = np.argwhere(current_grid[:, :, primitive] == 1)\n\n  if len(primitive_locations) == 0:\n      return [] # Primitive not found anywhere on the grid\n\n  # Find the closest primitive location (Manhattan distance)\n  closest_loc = None\n  min_dist = float('inf')\n\n  for px, py in primitive_locations: # px, py are (x, y) coordinates\n      dist = abs(px - current_pos_int[0]) + abs(py - current_pos_int[1])\n      if dist < min_dist:\n          min_dist = dist\n          closest_loc = (px, py) # Store as (x, y)\n\n  if closest_loc is None: # Should not happen if primitive_locations is not empty\n      return []\n\n  # Define movement actions and their (dx, dy) deltas\n  DELTAS = [(0, -1), (0, 1), (-1, 0), (1, 0)] # (dx, dy) for UP, DOWN, LEFT, RIGHT respectively\n  MOVE_ACTIONS = {\n      (0, -1): actions.UP,\n      (0, 1): actions.DOWN,\n      (-1, 0): actions.LEFT,\n      (1, 0): actions.RIGHT,\n  }\n\n  # Get non-grabbable indices from the world, assuming env.world is a CraftWorld instance\n  # and CraftWorld has a non_grabbable_indices attribute.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a cell is an obstacle\n  def is_obstacle(x, y):\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return True # Out of bounds is an obstacle\n      # Check all non-grabbable kinds at this cell\n      for k_idx in non_grabbable_indices:\n          if current_grid[x, y, k_idx] == 1: # grid[x, y, k]\n              return True\n      return False\n\n  # A* search algorithm to find the path to the closest primitive\n  start_node = current_pos_int # (x, y)\n  target_node = closest_loc    # (x, y)\n\n  open_set = []\n  # Priority queue stores (f_score, (x, y))\n  heapq.heappush(open_set, (0, start_node))\n\n  came_from = {} # Dictionary to reconstruct the path\n  g_score = {start_node: 0} # Cost from start to current node\n  # f_score = g_score + heuristic (Manhattan distance to target)\n  f_score = {start_node: abs(target_node[0] - start_node[0]) + abs(target_node[1] - start_node[1])}\n\n  while open_set:\n      current_f, current = heapq.heappop(open_set) # current is (cx, cy)\n\n      if current == target_node:\n          # Path found, reconstruct actions\n          path_nodes = []\n          while current in came_from:\n              path_nodes.append(current)\n              current = came_from[current]\n          path_nodes.append(start_node)\n          path_nodes.reverse() # Path from start to target\n\n          actions_list = []\n          for i in range(len(path_nodes) - 1):\n              prev_x, prev_y = path_nodes[i]\n              curr_x, curr_y = path_nodes[i+1]\n              dx = curr_x - prev_x\n              dy = curr_y - prev_y\n              actions_list.append(MOVE_ACTIONS[(dx, dy)])\n          actions_list.append(actions.USE) # Add USE action at the end to collect\n          return actions_list\n\n      # Explore neighbors\n      for dx, dy in DELTAS:\n          neighbor_x, neighbor_y = current[0] + dx, current[1] + dy\n          neighbor_node = (neighbor_x, neighbor_y)\n\n          if is_obstacle(neighbor_x, neighbor_y):\n              continue\n\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor_node not in g_score or tentative_g_score < g_score[neighbor_node]:\n              g_score[neighbor_node] = tentative_g_score\n              f_score[neighbor_node] = tentative_g_score + (abs(target_node[0] - neighbor_x) + abs(target_node[1] - neighbor_y))\n              came_from[neighbor_node] = current\n              heapq.heappush(open_set, (f_score[neighbor_node], neighbor_node))\n\n  # If no path found (target is unreachable)\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:47:03.738304", "function_name": "collect", "function_body": "    current_state = env._current_state # Access the internal CraftState object\n\n    # Define action constants (assuming these integer values are fixed for the environment)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # 1. Check if the primitive is already in the inventory\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # Get grid dimensions from the initial state's grid shape\n    # Assuming grid.shape is (WIDTH, HEIGHT, n_kinds) and pos is (x, y)\n    grid_width, grid_height, _ = current_state.grid.shape\n    \n    # Define movement directions (delta_x, delta_y) for each action\n    # (x, y) coordinates where x is column index, y is row index\n    move_directions = {\n        ACTION_UP: (0, 1),    # (x, y) -> (x, y+1)\n        ACTION_DOWN: (0, -1), # (x, y) -> (x, y-1)\n        ACTION_LEFT: (-1, 0), # (x, y) -> (x-1, y)\n        ACTION_RIGHT: (1, 0), # (x, y) -> (x+1, y)\n    }\n\n    # BFS queue: stores (current_position_tuple, path_taken_to_reach_here)\n    # current_position_tuple is (x, y)\n    q = collections.deque([(current_state.pos, [])])\n    \n    # Visited set: stores positions already visited to avoid cycles\n    visited = {current_state.pos}\n\n    # First, quickly check if any primitive of the target kind exists on the map\n    # This helps avoid unnecessary BFS if the primitive isn't spawned\n    primitive_exists_on_map = False\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if current_state.grid[x, y, primitive] == 1:\n                primitive_exists_on_map = True\n                break\n        if primitive_exists_on_map:\n            break\n    \n    if not primitive_exists_on_map:\n        # No primitive of this kind found on the map, cannot collect\n        return []\n\n    # BFS to find the shortest path to a cell *adjacent* to any primitive location\n    # We are looking for a (curr_x, curr_y) such that a primitive is in its 3x3 neighborhood.\n    while q:\n        (curr_x, curr_y), path = q.popleft()\n\n        # Check if the current position is adjacent to any primitive instance\n        is_adjacent_to_primitive = False\n        for dx_adj in [-1, 0, 1]:\n            for dy_adj in [-1, 0, 1]:\n                # Don't check the agent's current cell itself for the primitive\n                if dx_adj == 0 and dy_adj == 0:\n                    continue\n\n                adj_x, adj_y = curr_x + dx_adj, curr_y + dy_adj\n\n                # Check if the adjacent cell is within grid bounds\n                if 0 <= adj_x < grid_width and 0 <= adj_y < grid_height:\n                    # Check if the adjacent cell contains the target primitive\n                    if current_state.grid[adj_x, adj_y, primitive] == 1:\n                        is_adjacent_to_primitive = True\n                        break # Found an adjacent primitive\n            if is_adjacent_to_primitive:\n                break # Break from outer loop too\n\n        if is_adjacent_to_primitive:\n            # Found a path to a position where the agent is adjacent to the primitive.\n            # Append the ACTION_USE to the path and return it.\n            # (Assuming ACTION_USE works on any adjacent primitive based on CraftState.next_to behavior)\n            return path + [ACTION_USE]\n\n        # Explore neighbors\n        for action, (dx, dy) in move_directions.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_pos = (next_x, next_y)\n\n            # Check if the next position is within grid bounds\n            if 0 <= next_x < grid_width and 0 <= next_y < grid_height:\n                # Check if the next position has already been visited\n                if next_pos not in visited:\n                    visited.add(next_pos)\n                    q.append((next_pos, path + [action]))\n\n    # If the BFS completes and no path to an adjacent primitive is found\n    # This can happen if primitives are in unreachable areas (e.g., enclosed by walls)\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:47:04.692418", "function_name": "collect", "function_body": "  # Action constants (assuming these mappings from problem description or common practice)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction constants (matching the direction an agent faces after taking the respective action)\n  DIR_SOUTH = 0 # Agent faces South after moving DOWN\n  DIR_NORTH = 1 # Agent faces North after moving UP\n  DIR_WEST = 2  # Agent faces West after moving LEFT\n  DIR_EAST = 3  # Agent faces East after moving RIGHT\n\n  # Maps movement action to (delta_row, delta_col)\n  MOVE_DELTAS = {\n      ACTION_DOWN: (1, 0),\n      ACTION_UP: (-1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1)\n  }\n\n  # Maps direction to (delta_row, delta_col) for the cell directly in front of the agent\n  FACE_DELTAS = {\n      DIR_SOUTH: (1, 0),\n      DIR_NORTH: (-1, 0),\n      DIR_WEST: (0, -1),\n      DIR_EAST: (0, 1)\n  }\n\n  current_state = env._current_state\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  # grid shape is (WIDTH, HEIGHT, n_kinds) as per CraftState docstring\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape \n\n  # Get non-grabbable indices from the world instance linked to the current state\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n\n  # Find all locations where the primitive item exists\n  primitive_locs = []\n  for r in range(GRID_WIDTH):\n      for c in range(GRID_HEIGHT):\n          if grid[r, c, primitive] > 0:\n              primitive_locs.append((r, c))\n\n  if not primitive_locs:\n      # Primitive not found on the map\n      return []\n\n  # BFS setup\n  # Queue stores tuples: (current_row, current_col, current_direction, list_of_actions_taken)\n  q = collections.deque()\n  q.append((start_pos[0], start_pos[1], start_dir, []))\n  # Visited set stores tuples: (row, col, direction) to avoid cycles and redundant paths\n  visited = set()\n  visited.add((start_pos[0], start_pos[1], start_dir))\n\n  # BFS loop\n  while q:\n      curr_r, curr_c, curr_dir, path = q.popleft()\n\n      # Check if the agent can USE the primitive from the current position and direction\n      # This means the cell directly in front of the agent must contain the primitive.\n      face_dr, face_dc = FACE_DELTAS[curr_dir]\n      target_r, target_c = curr_r + face_dr, curr_c + face_dc\n\n      if (0 <= target_r < GRID_WIDTH and 0 <= target_c < GRID_HEIGHT and\n          grid[target_r, target_c, primitive] > 0):\n          # Found a path to be adjacent to and facing the primitive, now USE it\n          return path + [ACTION_USE]\n\n      # Explore possible next states by moving\n      for action_val in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n          dr, dc = MOVE_DELTAS[action_val]\n          new_r, new_c = curr_r + dr, curr_c + dc\n          new_dir = action_val # Agent's direction changes to match the movement direction\n\n          # Check boundary conditions\n          if not (0 <= new_r < GRID_WIDTH and 0 <= new_c < GRID_HEIGHT):\n              continue\n\n          # Check if the new cell is walkable (i.e., not a non-grabbable obstacle)\n          is_walkable = True\n          for k_idx in non_grabbable_indices:\n              if grid[new_r, new_c, k_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          if is_walkable:\n              # Check if this state has been visited to avoid redundant paths and infinite loops\n              if (new_r, new_c, new_dir) not in visited:\n                  visited.add((new_r, new_c, new_dir))\n                  q.append((new_r, new_c, new_dir, path + [action_val]))\n\n  # If the queue is empty and no path was found\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:48:49.929745", "function_name": "collect", "function_body": "    current_state = env._current_state\n    actions = env.action_specs()\n\n    # Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions and current agent position\n    grid = current_state.grid\n    # grid.shape is (WIDTH, HEIGHT, n_kinds) where WIDTH is x-dimension, HEIGHT is y-dimension\n    GRID_WIDTH, GRID_HEIGHT, N_KINDS = grid.shape\n    \n    start_x, start_y = current_state.pos # Agent's current (x_coord, y_coord)\n    start_dir = current_state.dir       # Agent's current facing direction\n\n    # Find all locations on the grid where the primitive exists\n    primitive_locations = [] # List of (x, y) tuples\n    for x in range(GRID_WIDTH):\n        for y in range(GRID_HEIGHT):\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        # If the primitive is not found anywhere on the map, it's uncollectible\n        return []\n\n    # BFS for pathfinding to find the shortest sequence of actions\n    # State in BFS: (current_x, current_y, current_dir, path_actions_so_far)\n    q = collections.deque()\n    # visited set stores (x, y, dir) tuples to prevent cycles and redundant exploration\n    visited = set() \n\n    q.append((start_x, start_y, start_dir, []))\n    visited.add((start_x, start_y, start_dir))\n\n    # Define movement actions and their effects on position (dx, dy) and resulting direction\n    # When an agent moves using UP/DOWN/LEFT/RIGHT, its facing direction (`dir`) updates\n    # to match the direction of that movement.\n    # (action_constant): (dx, dy, new_facing_dir_after_move)\n    move_action_effects = {\n        actions['UP']:    (0, -1, 0),  # Move North (decreases y), new dir is 0 (North)\n        actions['DOWN']:  (0, 1, 2),   # Move South (increases y), new dir is 2 (South)\n        actions['LEFT']:  (-1, 0, 3),  # Move West (decreases x), new dir is 3 (West)\n        actions['RIGHT']: (1, 0, 1)    # Move East (increases x), new dir is 1 (East)\n    }\n\n    # Map (dx, dy) from agent_pos to item_pos, to the required facing direction for USE\n    # For the `USE` action to be successful, the agent must be adjacent to the item\n    # AND facing it correctly. This map determines the required `dir` for a given relative position.\n    # (dx_to_item, dy_to_item): required_dir_for_use\n    relative_pos_to_facing_dir = {\n        (0, -1): 0, # Item is North (y-1) of agent, agent must face North\n        (0, 1): 2,  # Item is South (y+1) of agent, agent must face South\n        (-1, 0): 3, # Item is West (x-1) of agent, agent must face West\n        (1, 0): 1   # Item is East (x+1) of agent, agent must face East\n    }\n\n    while q:\n        curr_x, curr_y, curr_dir, path_actions = q.popleft()\n\n        # Check if the current agent position (curr_x, curr_y) is adjacent to any primitive\n        # AND if the agent's current direction (curr_dir) is correct to USE that primitive.\n        for px, py in primitive_locations:\n            dx_to_item, dy_to_item = px - curr_x, py - curr_y\n            # Check if adjacent (Manhattan distance 1)\n            if abs(dx_to_item) + abs(dy_to_item) == 1: \n                # Determine the direction the agent needs to be facing to use this specific primitive\n                required_facing_dir = relative_pos_to_facing_dir.get((dx_to_item, dy_to_item))\n                \n                # If we are adjacent and facing the item correctly\n                if required_facing_dir is not None and curr_dir == required_facing_dir:\n                    # Found a path to a position where we can USE the primitive\n                    # Since it's BFS, this is the shortest path.\n                    return path_actions + [actions['USE']]\n\n        # Explore possible next states by applying each movement action\n        for action, (dx_move, dy_move, new_dir) in move_action_effects.items():\n            next_x, next_y = curr_x + dx_move, curr_y + dy_move\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= next_x < GRID_WIDTH and 0 <= next_y < GRID_HEIGHT):\n                continue\n\n            # Check if the new cell is an obstacle. Obstacles are assumed to be\n            # non-grabbable environment entities (like water, stone if set up as such).\n            is_obstacle = False\n            for k_idx in current_state.world.environment:\n                if grid[next_x, next_y, k_idx] > 0:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n\n            # If this state (new position and new direction) has not been visited before\n            if (next_x, next_y, new_dir) not in visited:\n                visited.add((next_x, next_y, new_dir))\n                q.append((next_x, next_y, new_dir, path_actions + [action]))\n\n    # If the BFS queue becomes empty and no path to collect the primitive was found\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:48:49.999463", "function_name": "collect", "function_body": "    # Get current state from the environment\n    # CraftLab internally holds CraftState in _current_state\n    current_state = env._current_state\n    \n    # Check if primitive is already in inventory\n    # If the primitive is already collected, no actions are needed.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get grid information\n    # grid is a numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds)\n    grid = current_state.grid\n    # pos is a tuple(int, int) (x, y)\n    current_pos = current_state.pos  \n    \n    # Grid dimensions\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # Get indices of entities that cannot be traversed\n    # These are stored in the CraftWorld instance, accessible via env.world\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # Define movement actions and their effects on position (x, y)\n    # These are assumed to be absolute movements on the grid.\n    # The action constants are expected to be available (e.g., from env_factory).\n    # For clarity, assuming common integer values if not imported directly:\n    # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    move_deltas = {\n        1: (0, -1),   # UP: (x, y-1)\n        0: (0, 1),    # DOWN: (x, y+1)\n        2: (-1, 0),   # LEFT: (x-1, y)\n        3: (1, 0)     # RIGHT: (x+1, y)\n    }\n    \n    # Breadth-First Search (BFS) for shortest path\n    # Queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n    queue = collections.deque([(current_pos, [])]) \n    # Visited set to prevent cycles and redundant exploration\n    visited = {current_pos}\n\n    # Helper function to check if a cell is within bounds and traversable\n    def is_traversable(x, y):\n        # Check if coordinates are within grid boundaries\n        if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n            return False\n        # Check if the cell contains any non-grabbable entity\n        # A cell is traversable if none of the non_grabbable_indices kinds are present (>0)\n        for idx in non_grabbable_indices:\n            if grid[x, y, idx] > 0: \n                return False\n        return True\n\n    # BFS loop\n    while queue:\n        (x, y), path = queue.popleft()\n\n        # Check if the current position contains the target primitive\n        # Assumption: USE action picks up the item from the current tile if present\n        if grid[x, y, primitive] > 0:\n            # Found the shortest path to a primitive location.\n            # Append the USE action and return the full action sequence.\n            # Assuming 4 is the constant for USE (from CraftLab.action_specs)\n            return path + [4] \n\n        # Explore neighboring cells\n        for action, (dx, dy) in move_deltas.items():\n            next_x, next_y = x + dx, y + dy\n            next_pos = (next_x, next_y)\n\n            # If the next position is traversable and not yet visited\n            if is_traversable(next_x, next_y) and next_pos not in visited:\n                visited.add(next_pos)\n                queue.append((next_pos, path + [action]))\n\n    # If the queue becomes empty and no primitive location was found,\n    # it means the primitive is unreachable or not present on the map.\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:50:22.202260", "function_name": "collect", "function_body": "    import collections\n\n    # Constants mapping action values (given as int) to movement and resulting direction\n    # These map how the agent's internal 'dir' attribute changes after a move action.\n    # {action_value: (delta_row, delta_col, new_direction)}\n    # The 'dir' values are: 0: North, 1: East, 2: South, 3: West\n    # Action values are: 0: DOWN, 1: UP, 2: LEFT, 3: RIGHT, 4: USE\n    MOVE_ACTIONS_INFO = {\n        1: (-1, 0, 0),  # UP (action 1): moves (r-1, c), faces North (dir 0)\n        0: (1, 0, 2),   # DOWN (action 0): moves (r+1, c), faces South (dir 2)\n        2: (0, -1, 3),  # LEFT (action 2): moves (r, c-1), faces West (dir 3)\n        3: (0, 1, 1)    # RIGHT (action 3): moves (r, c+1), faces East (dir 1)\n    }\n\n    # Deltas for (dr, dc) based on agent's facing direction (0:N, 1:E, 2:S, 3:W)\n    # Used to find the cell immediately in front of the agent for the USE action.\n    DIR_TO_DELTAS = {\n        0: (-1, 0),  # North: (row-1, col)\n        1: (0, 1),   # East:  (row, col+1)\n        2: (1, 0),   # South: (row+1, col)\n        3: (0, -1)   # West:  (row, col-1)\n    }\n\n    current_state = env._current_state\n\n    # 1. Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n        return []  # Already collected, no actions needed\n\n    grid = current_state.grid\n    initial_agent_pos = current_state.pos  # Tuple (row, col)\n    initial_agent_dir = current_state.dir  # Integer (0-3)\n\n    # Grid dimensions (assuming grid.shape is (height, width, n_kinds))\n    HEIGHT, WIDTH = grid.shape[:2]\n\n    # 2. Find all locations of the primitive on the grid\n    primitive_locations = set()  # Using a set for efficient lookup\n    for r in range(HEIGHT):\n        for c in range(WIDTH):\n            if grid[r, c, primitive] == 1:\n                primitive_locations.add((r, c))\n\n    if not primitive_locations:\n        return []  # Primitive not found anywhere on the map\n\n    # 3. Perform a Breadth-First Search (BFS) to find the shortest sequence of actions\n    # to reach a state where the agent can collect the primitive using the USE action.\n    q = collections.deque()\n    # visited stores (row, col, direction) tuples to avoid re-exploring the same state\n    # (position + facing direction)\n    visited = set()\n\n    # Initial state for BFS: (current_position_tuple, current_direction_int, list_of_actions_taken_so_far)\n    q.append((initial_agent_pos, initial_agent_dir, []))\n    visited.add((initial_agent_pos[0], initial_agent_pos[1], initial_agent_dir))\n\n    while q:\n        (r, c), current_dir, actions_so_far = q.popleft()\n\n        # Check if the current agent state allows immediate collection (USE action)\n        # Calculate the coordinates of the cell directly in front of the agent\n        dr_front, dc_front = DIR_TO_DELTAS[current_dir]\n        fr, fc = r + dr_front, c + dc_front\n\n        # If the cell in front is within bounds and contains the primitive, we've found a solution\n        if 0 <= fr < HEIGHT and 0 <= fc < WIDTH and (fr, fc) in primitive_locations:\n            # Append the USE action (4) to the sequence of actions and return\n            return actions_so_far + [4]\n\n        # Explore possible movement actions from the current state\n        for move_action, (dr_move, dc_move, new_dir) in MOVE_ACTIONS_INFO.items():\n            nr, nc = r + dr_move, c + dc_move  # Calculate the new position after the move\n\n            # Check if the new position is within grid boundaries\n            if 0 <= nr < HEIGHT and 0 <= nc < WIDTH:\n                # Assuming all grid cells are traversable unless explicitly stated otherwise\n                # (e.g., by containing an impassable obstacle kind). For this problem,\n                # we'll assume basic movement is always possible if within bounds.\n\n                new_state_key = (nr, nc, new_dir)  # Define the new state (position + resulting direction)\n\n                # If this new state has not been visited before, add it to the queue\n                if new_state_key not in visited:\n                    visited.add(new_state_key)\n                    q.append(((nr, nc), new_dir, actions_so_far + [move_action]))\n\n    # If the BFS queue becomes empty and no path to collect the primitive was found,\n    # it means the primitive is unreachable.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:50:22.272621", "function_name": "collect", "function_body": "    import collections\n\n    # Get action mapping from the environment to ensure correct integer values\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    # Map movement deltas (dx, dy) to corresponding actions\n    # Assuming (x, y) where x is column index and y is row index.\n    # Positive y is downwards, positive x is rightwards.\n    MOVE_ACTIONS = {\n        (0, 1): ACTION_DOWN,\n        (0, -1): ACTION_UP,\n        (1, 0): ACTION_RIGHT,\n        (-1, 0): ACTION_LEFT,\n    }\n\n    # Access the current state of the environment\n    current_state = env._current_state\n    grid = current_state.grid\n    agent_pos = current_state.pos  # Agent's current (x, y) position\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n\n    # 1. Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n        return []  # Primitive already collected, no actions needed\n\n    # 2. Find all locations on the grid where the primitive exists\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        # Primitive not found anywhere on the map\n        return []\n\n    # 3. Use Breadth-First Search (BFS) to find the shortest path\n    #    to a cell from which the 'USE' action can collect the primitive.\n    #    A cell is suitable if it's at or adjacent to a primitive's location.\n    # Queue stores tuples: (current_position, list_of_actions_to_reach_current_position)\n    q = collections.deque([(agent_pos, [])])\n    \n    # Set to keep track of visited positions to avoid redundant processing and infinite loops\n    visited = {agent_pos}\n\n    while q:\n        (curr_x, curr_y), path = q.popleft()\n\n        # Check if the current position is suitable for performing the 'USE' action\n        # This means the agent is on the same cell as the primitive or adjacent to it.\n        is_suitable_for_use = False\n        for (px, py) in primitive_locations:\n            # Manhattan distance <= 1 implies on the same cell or an adjacent one\n            if abs(curr_x - px) + abs(curr_y - py) <= 1:\n                is_suitable_for_use = True\n                break\n        \n        if is_suitable_for_use:\n            # Found a suitable position, append the 'USE' action and return the full path\n            return path + [ACTION_USE]\n\n        # Explore valid neighboring cells (UP, DOWN, LEFT, RIGHT)\n        for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_pos = (next_x, next_y)\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                continue\n            \n            # If the next position has not been visited yet, add it to the queue\n            if next_pos not in visited:\n                visited.add(next_pos)\n                action_to_take = MOVE_ACTIONS[(dx, dy)]\n                q.append((next_pos, path + [action_to_take]))\n\n    # If the BFS completes and no path to a suitable position was found (e.g., primitive unreachable)\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:51:29.600018", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants (from CraftLab.action_specs)\n  # These are numerical values for actions.\n  _DOWN, _UP, _LEFT, _RIGHT, _USE = 0, 1, 2, 3, 4\n  _MOVEMENT_ACTIONS = [_DOWN, _UP, _LEFT, _RIGHT]\n\n  # Get the current state from the environment\n  # Assuming 'env' is a CraftLab instance as per the problem description context.\n  current_state = env._current_state\n  world = current_state.world\n  grid = current_state.grid\n  start_pos = current_state.pos\n  width, height, n_kinds = grid.shape\n\n  # 1. Check if the primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # 2. BFS setup for pathfinding\n  # Queue stores tuples of (position: (x, y), actions_taken_so_far: list[int])\n  queue = collections.deque([(start_pos, [])])\n  # Visited set stores positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # Define obstacle indices based on the CraftWorld description.\n  # Water and Stone are typically non-traversable in grid worlds.\n  water_idx = world.water_index\n  stone_idx = world.stone_index\n  obstacle_indices = {water_idx, stone_idx}\n\n  # 3. BFS search loop\n  while queue:\n      (curr_x, curr_y), actions_list = queue.popleft()\n\n      # Check if the primitive is in the 3x3 neighborhood of the current position\n      # This mimics the behavior of CraftState.next_to(primitive)\n      found_primitive_adjacent = False\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = curr_x + dx, curr_y + dy\n              # Ensure the neighbor cell is within grid bounds\n              if 0 <= nx < width and 0 <= ny < height:\n                  # Check if the primitive kind exists at this neighbor cell\n                  if grid[nx, ny, primitive] > 0:\n                      found_primitive_adjacent = True\n                      break\n          if found_primitive_adjacent:\n              break\n\n      # If the primitive is adjacent, we can \"use\" it from here\n      if found_primitive_adjacent:\n          return actions_list + [_USE]\n\n      # Explore valid movement neighbors\n      for action in _MOVEMENT_ACTIONS:\n          next_x, next_y = curr_x, curr_y\n          if action == _UP:\n              next_y -= 1\n          elif action == _DOWN:\n              next_y += 1\n          elif action == _LEFT:\n              next_x -= 1\n          elif action == _RIGHT:\n              next_x += 1\n\n          # Check if the next position is within grid bounds\n          if 0 <= next_x < width and 0 <= next_y < height:\n              # Check if the next cell contains an obstacle\n              is_blocked = False\n              # Iterate through known obstacle kinds and check if any are present at next_x, next_y\n              for k_idx in obstacle_indices:\n                  if grid[next_x, next_y, k_idx] > 0:\n                      is_blocked = True\n                      break\n              \n              # If the cell is not blocked and has not been visited, add it to the queue\n              if not is_blocked and (next_x, next_y) not in visited:\n                  visited.add((next_x, next_y))\n                  queue.append(((next_x, next_y), actions_list + [action]))\n\n  # If the queue becomes empty and no path is found, return an empty list\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:51:30.573680", "function_name": "collect", "function_body": "  # Action constants (from CraftLab.action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  state = env._current_state\n\n  # 1. Check if primitive is already collected\n  if state.inventory[primitive] > 0:\n    return []\n\n  width, height = state.grid.shape[:2]\n\n  # Helper function to check if a cell is walkable\n  def is_walkable(px, py):\n    # Check if coordinates are within grid bounds\n    if not (0 <= px < width and 0 <= py < height):\n      return False\n    # Check if the cell contains any non-grabbable (and assumed impassable) entities\n    # The `non_grabbable_indices` set from `CraftWorld` typically includes impassable terrain like water.\n    for k_idx in state.world.non_grabbable_indices:\n      if state.grid[px, py, k_idx] > 0:\n        return False\n    return True\n\n  # Initialize BFS\n  # Queue stores (current_position, path_of_actions_to_reach_here)\n  # current_position is a tuple (x, y)\n  # path_of_actions_to_reach_here is a list of integer actions\n  q = collections.deque([(state.pos, [])])\n  \n  # Set of visited positions to avoid cycles and redundant exploration\n  visited = {state.pos} \n\n  best_path_to_adjacent = None\n\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Check if the current position is adjacent to the target primitive\n    # An agent can 'USE' an item if it's in an adjacent cell.\n    # We iterate over the four cardinal neighbors of current_pos (where the agent currently stands)\n    for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n      nx, ny = current_pos[0] + dx, current_pos[1] + dy\n\n      # Check if neighbor is within bounds and contains the primitive\n      if 0 <= nx < width and 0 <= ny < height and state.grid[nx, ny, primitive] > 0:\n        # We found a primitive next to current_pos.\n        # This path (current_actions) leads to a position from which the primitive can be 'USE'd.\n        best_path_to_adjacent = current_actions\n        break # Found shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent is not None:\n      break # Found the shortest path to an adjacent cell, exit BFS loop\n\n    # Explore valid neighbors (cells the agent can move to)\n    for dx, dy, action in [\n        (0, 1, ACTION_DOWN),  # Move down\n        (0, -1, ACTION_UP),   # Move up\n        (1, 0, ACTION_RIGHT), # Move right\n        (-1, 0, ACTION_LEFT)  # Move left\n    ]:\n      next_pos = (current_pos[0] + dx, current_pos[1] + dy)\n\n      # Only add to queue if the cell hasn't been visited and is walkable\n      if next_pos not in visited and is_walkable(next_pos[0], next_pos[1]):\n        visited.add(next_pos)\n        q.append((next_pos, current_actions + [action]))\n\n  # If no path to a cell adjacent to the primitive was found\n  if best_path_to_adjacent is None:\n    return []\n\n  # Add the USE action as the final step after reaching the adjacent position\n  return best_path_to_adjacent + [ACTION_USE]", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:52:58.780827", "function_name": "collect", "function_body": "  global ACTIONS\n  if ACTIONS is None:\n    # Get action mappings from the environment for robustness\n    action_map = env.action_specs()\n    ACTIONS = {\n        \"DOWN\": action_map[\"DOWN\"],\n        \"UP\": action_map[\"UP\"],\n        \"LEFT\": action_map[\"LEFT\"],\n        \"RIGHT\": action_map[\"RIGHT\"],\n        \"USE\": action_map[\"USE\"],\n    }\n\n  MAX_STEPS = 200  # Limit the search to prevent infinite loops\n\n  collected_actions = []\n\n  # Reset the environment to a known initial state\n  _ = env.reset()\n  current_state = env._current_state  # Access the internal CraftState\n\n  # Check if the primitive is already collected\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  # Get information about grabbable items and workshops from the world\n  world = env.world\n  grabbable_indices = set(world.grabbable_indices)\n  workshop_indices = set(world.workshop_indices)\n\n  # Main search and collection loop\n  for step_count in range(MAX_STEPS):\n    # If the primitive is collected, we are done\n    if current_state.inventory[primitive] > 0:\n      break\n\n    # Get observations and features from the environment\n    obs = env.observations()\n    features_dict = obs[\"features_dict\"]\n    features_ego = features_dict[\"features_ego\"]  # shape (WINDOW_SIZE, WINDOW_SIZE, n_kinds)\n\n    # Determine WINDOW_SIZE and the agent's relative position in the ego view\n    window_size = features_ego.shape[0]\n    center = window_size // 2  # Agent's relative position in ego view (center, center)\n\n    action_to_take = None\n\n    # Priority 1: Check if the primitive is in the immediate vicinity and can be collected\n    if current_state.next_to(primitive):\n      if primitive in grabbable_indices or primitive in workshop_indices:\n        action_to_take = ACTIONS[\"USE\"]\n      # If it's next to but not grabbable/a workshop, we don't 'collect' it with USE.\n      # So, action_to_take remains None, and we proceed to look for it or explore.\n\n    # Priority 2: Search for the primitive in the egocentric view (beyond immediate neighbours)\n    if action_to_take is None:\n      # Find all locations where the primitive is visible in the ego view\n      # This returns (row, col) coordinates within the ego view where the primitive exists\n      primitive_locations_in_ego = np.argwhere(features_ego[:, :, primitive] == 1)\n\n      if len(primitive_locations_in_ego) > 0:\n        # Find the closest primitive location in the ego view (excluding the agent's cell itself)\n        target_r, target_c = -1, -1\n        min_dist_sq = float('inf')\n\n        for r, c in primitive_locations_in_ego:\n          # Exclude the agent's own cell if the primitive can appear there, as it's not a target to move to\n          if r == center and c == center:\n            continue\n\n          # Calculate squared Euclidean distance from the agent's center position\n          dist_sq = (r - center)**2 + (c - center)**2\n          if dist_sq < min_dist_sq:\n            min_dist_sq = dist_sq\n            target_r, target_c = r, c\n\n        if target_r != -1:  # A valid primitive location was found (not on agent's cell)\n          # Calculate relative coordinates (dr, dc) from agent to primitive in ego view\n          dr = target_r - center\n          dc = target_c - center\n\n          # Determine the action to move towards the primitive\n          # Prioritize turning (left/right) to align, then moving forward (up)\n          if dc < 0:  # Primitive is to the left\n            action_to_take = ACTIONS[\"LEFT\"]\n          elif dc > 0:  # Primitive is to the right\n            action_to_take = ACTIONS[\"RIGHT\"]\n          elif dr < 0:  # Primitive is straight ahead\n            action_to_take = ACTIONS[\"UP\"]\n          elif dr > 0:  # Primitive is straight behind (turn to face it)\n            # A single turn (e.g., LEFT) will change orientation, next step will re-evaluate\n            action_to_take = ACTIONS[\"LEFT\"]\n          # else (dr == 0 and dc == 0): This case means primitive is at agent's exact cell.\n          # It should have been handled by next_to or filtered out. If it somehow reaches here,\n          # it implies an unexpected state, so we fall back to random movement.\n        else:\n          # This branch is hit if `primitive_locations_in_ego` only contained (center, center)\n          # or if it was empty after filtering. Fallback to random exploration.\n          action_to_take = np.random.choice([ACTIONS[\"UP\"], ACTIONS[\"DOWN\"], ACTIONS[\"LEFT\"], ACTIONS[\"RIGHT\"]])\n      else:\n        # Primitive not visible in the egocentric view, explore randomly\n        action_to_take = np.random.choice([ACTIONS[\"UP\"], ACTIONS[\"DOWN\"], ACTIONS[\"LEFT\"], ACTIONS[\"RIGHT\"]])\n\n    # Execute the chosen action\n    _, _, _ = env.step(action_to_take)  # Reward, done, new obs are handled by the env\n    collected_actions.append(action_to_take)\n    current_state = env._current_state  # Update current_state for the next iteration\n\n  return collected_actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:52:58.850285", "function_name": "collect", "function_body": "    actions_list = []\n    MAX_COLLECT_ATTEMPTS = 500  # Safety break to prevent infinite loops\n\n    # Get action mappings from the environment\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    for _ in range(MAX_COLLECT_ATTEMPTS):\n        obs = env.observations()\n        current_inventory = obs['features_dict']['inventory']\n\n        # Check if the primitive is already collected\n        if current_inventory[primitive] > 0:\n            break\n\n        # Get current state details directly from the internal CraftState\n        current_state = env._current_state\n        current_grid = current_state.grid\n        current_pos = current_state.pos  # (x, y) coordinates\n        current_dir = current_state.dir  # 0:N, 1:E, 2:S, 3:W\n\n        # Find all locations of the primitive on the grid\n        target_coords = []\n        # Grid shape is (WIDTH, HEIGHT, n_kinds)\n        grid_width, grid_height, _ = current_grid.shape\n        for x in range(grid_width):\n            for y in range(grid_height):\n                if current_grid[x, y, primitive] == 1:\n                    target_coords.append((x, y))\n\n        if not target_coords:\n            # Primitive not found on the grid, cannot collect it\n            return []\n\n        # Find the closest primitive location using Manhattan distance\n        min_dist = float('inf')\n        closest_target_x, closest_target_y = -1, -1\n        for tx, ty in target_coords:\n            dist = abs(tx - current_pos[0]) + abs(ty - current_pos[1])\n            if dist < min_dist:\n                min_dist = dist\n                closest_target_x, closest_target_y = tx, ty\n\n        action_to_take = None\n\n        if min_dist == 1:\n            # Primitive is directly adjacent (Manhattan distance 1)\n            # Determine the desired direction to face the primitive\n            desired_dir = -1\n            if closest_target_y < current_pos[1]:  # Target is North (Y decreases)\n                desired_dir = 0  # North\n            elif closest_target_y > current_pos[1]:  # Target is South (Y increases)\n                desired_dir = 2  # South\n            elif closest_target_x < current_pos[0]:  # Target is West (X decreases)\n                desired_dir = 3  # West\n            elif closest_target_x > current_pos[0]:  # Target is East (X increases)\n                desired_dir = 1  # East\n\n            if current_dir == desired_dir:\n                # Already facing the primitive, use it\n                action_to_take = ACTION_USE\n            else:\n                # Need to turn. Calculate the shortest turn (left or right).\n                # Direction values: 0:N, 1:E, 2:S, 3:W\n                # Clockwise step: (current_dir + 1) % 4\n                # Counter-clockwise step: (current_dir - 1 + 4) % 4\n                turn_diff = (desired_dir - current_dir + 4) % 4\n                if turn_diff == 1:  # 90 degrees clockwise (RIGHT)\n                    action_to_take = ACTION_RIGHT\n                elif turn_diff == 3:  # 90 degrees counter-clockwise (LEFT)\n                    action_to_take = ACTION_LEFT\n                else:  # 2: 180 degree turn. Either LEFT or RIGHT is fine.\n                    action_to_take = ACTION_LEFT  # Arbitrary choice\n\n        elif min_dist > 1:\n            # Primitive is not directly adjacent, need to move towards it\n            # Prioritize moving along X-axis then Y-axis to reduce distance\n            if current_pos[0] != closest_target_x:  # Need to move horizontally\n                if current_pos[0] < closest_target_x:  # Target is to the East\n                    action_to_take = ACTION_RIGHT\n                else:  # Target is to the West\n                    action_to_take = ACTION_LEFT\n            elif current_pos[1] != closest_target_y:  # Need to move vertically\n                if current_pos[1] < closest_target_y:  # Target is to the South\n                    action_to_take = ACTION_DOWN\n                else:  # Target is to the North\n                    action_to_take = ACTION_UP\n            # If current_pos == closest_target, it means min_dist would be 0,\n            # so this else branch should not be reached under normal circumstances for min_dist > 1.\n            # If it somehow is, it means no movement can be determined.\n            else:\n                return [] # Should not happen, implies stuck or logic error.\n        \n        else: # min_dist == 0: Primitive is at the agent's current location.\n            # This is an unusual scenario for collectable items, as the agent occupies its cell.\n            # However, if it happens and inventory is 0, a USE action might be needed to pick it up.\n            action_to_take = ACTION_USE\n\n        if action_to_take is not None:\n            # Execute the determined action in the environment\n            _reward, _done, _ = env.step(action_to_take)\n            actions_list.append(action_to_take)\n            if _done:\n                # Environment terminated (e.g., max_steps reached in CraftLab)\n                # Return the actions collected so far, even if the primitive wasn't obtained.\n                return actions_list\n        else:\n            # No action could be determined. This implies the agent is stuck or the primitive is unreachable\n            # given the simple pathfinding rules (e.g., blocked by unhandled obstacles).\n            return []\n\n    # Return the list of actions. The loop might have finished because the primitive was collected\n    # or because MAX_COLLECT_ATTEMPTS was reached.\n    return actions_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:54:15.934316", "function_name": "collect", "function_body": "", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:54:16.003517", "function_name": "collect", "function_body": "    # Define action constants based on typical CraftWorld setup\n    # These are usually available as constants in the environment module.\n    # The problem description implies these integer mappings.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Get the current state from the CraftLab environment\n    current_state = env._current_state\n\n    # If the primitive is already in inventory, no actions are needed.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions and world properties for pathfinding\n    WIDTH, HEIGHT, _ = current_state.grid.shape\n    world = current_state.world\n    # Non-grabbable items are considered obstacles for movement\n    non_grabbable_indices = world.non_grabbable_indices\n\n    # Helper function to check if a position is traversable\n    # A cell is traversable if it's within bounds and contains no non-grabbable items.\n    def is_traversable(pos):\n        x, y = pos\n        # Check boundary conditions\n        if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n            return False\n        # Check if any non-grabbable item is present at this cell.\n        # If a non-grabbable item (like water, rock, etc.) is present, the cell is blocked.\n        for kind_idx in non_grabbable_indices:\n            if current_state.grid[x, y, kind_idx] > 0: # Grid value > 0 means item is present\n                return False\n        return True\n\n    # Check if the agent's starting position is traversable.\n    # This scenario should ideally not happen in valid world setups.\n    if not is_traversable(current_state.pos):\n        return []\n\n    # Initialize BFS queue with the current position and an empty list of actions\n    # (current_position, list_of_actions_to_reach_here)\n    import collections # Assuming collections is available in the environment\n    queue = collections.deque([(current_state.pos, [])])\n    visited = {current_state.pos} # Keep track of visited positions to avoid loops and redundant paths\n\n    # Map actions to their corresponding (dx, dy) changes in position\n    action_deltas = {\n        UP: (0, -1),\n        DOWN: (0, 1),\n        LEFT: (-1, 0),\n        RIGHT: (1, 0),\n    }\n\n    # Perform BFS\n    while queue:\n        current_pos, current_path_actions = queue.popleft()\n\n        # Create a temporary CraftState instance to check adjacency using `next_to` method.\n        # This is necessary because `next_to` is a method of CraftState and requires a state context.\n        temp_craft_state = CraftState(\n            scenario=current_state.scenario,\n            grid=current_state.grid, # Grid doesn't change during movement in this context\n            pos=current_pos,\n            dir=current_state.dir, # Direction doesn't directly affect next_to but is needed for constructor\n            inventory=current_state.inventory # Inventory doesn't change during movement\n        )\n\n        # Check if the current position is adjacent to the primitive\n        if temp_craft_state.next_to(primitive):\n            # If adjacent, we can now use the item. Append USE action and return the path.\n            return current_path_actions + [USE]\n\n        # Explore possible next moves (UP, DOWN, LEFT, RIGHT)\n        for action, (dx, dy) in action_deltas.items():\n            next_pos = (current_pos[0] + dx, current_pos[1] + dy)\n\n            # Check if the next position is traversable and hasn't been visited yet\n            if is_traversable(next_pos) and next_pos not in visited:\n                visited.add(next_pos)\n                queue.append((next_pos, current_path_actions + [action]))\n\n    # If the BFS completes and no path to an adjacent primitive is found,\n    # it means the primitive is unreachable from the current position.\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:55:19.393528", "function_name": "collect", "function_body": "  import collections # For deque\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Get the current state directly from the environment for planning\n  current_state = env._current_state\n\n  # Check if the primitive is already in the inventory\n  if current_state.satisfies(None, primitive):\n      return []\n\n  # Get grid dimensions and current agent position\n  grid_height, grid_width, _ = current_state.grid.shape\n  current_pos = current_state.pos\n\n  # Find all locations on the grid where the primitive exists\n  primitive_locations = np.argwhere(current_state.grid[:, :, primitive] > 0)\n\n  if not primitive_locations.size > 0:\n      # Primitive not found anywhere on the grid\n      return []\n\n  # Determine if the primitive is a grabbable item\n  world = current_state.world\n  is_grabbable = primitive in world.grabbable_indices\n\n  # Find the closest primitive location using Manhattan distance\n  min_dist_to_primitive_loc = float('inf')\n  closest_primitive_loc = None\n  for loc in primitive_locations:\n      dist = abs(loc[0] - current_pos[0]) + abs(loc[1] - current_pos[1])\n      if dist < min_dist_to_primitive_loc:\n          min_dist_to_primitive_loc = dist\n          closest_primitive_loc = tuple(loc) # Convert numpy array to tuple for hashability\n\n  if closest_primitive_loc is None:\n      return [] # Should not happen if primitive_locations was not empty\n\n  # Determine the actual target cell for pathfinding (where the agent needs to move)\n  bfs_target_cell = closest_primitive_loc\n  if not is_grabbable:\n      # For non-grabbable items (like resources to be mined), the agent needs to move\n      # to an adjacent cell, not on top of the item itself.\n      adjacent_cells = []\n      dr_adj = [-1, 1, 0, 0] # Relative rows for Up, Down, Left, Right neighbors\n      dc_adj = [0, 0, -1, 1] # Relative cols for Up, Down, Left, Right neighbors\n\n      for i in range(4):\n          nr, nc = closest_primitive_loc[0] + dr_adj[i], closest_primitive_loc[1] + dc_adj[i]\n          if 0 <= nr < grid_height and 0 <= nc < grid_width:\n              # For simplicity, assume any valid adjacent cell is traversable.\n              # In a more complex environment, we might check if 'grid[nr, nc]' is blocked.\n              adjacent_cells.append((nr, nc))\n\n      if not adjacent_cells:\n          # No traversable adjacent cell found, cannot collect\n          return []\n\n      # Choose the adjacent cell that is closest to the agent's current position\n      min_dist_to_adj_cell = float('inf')\n      closest_adj_cell = None\n      for adj_c in adjacent_cells:\n          dist = abs(adj_c[0] - current_pos[0]) + abs(adj_c[1] - current_pos[1])\n          if dist < min_dist_to_adj_cell:\n              min_dist_to_adj_cell = dist\n              closest_adj_cell = adj_c\n      \n      if closest_adj_cell:\n          bfs_target_cell = closest_adj_cell\n      else:\n          return [] # Should not happen if adjacent_cells was not empty\n\n  # Use Breadth-First Search (BFS) to find the shortest path to the target cell\n  q = collections.deque([(current_pos, [])]) # Queue stores (current_position, path_taken_so_far)\n  visited = {current_pos} # Set to keep track of visited cells to avoid cycles and redundant paths\n\n  # Mapping from movement deltas (dr, dc) to action IDs\n  delta_to_action = {\n      (-1, 0): UP,\n      (1, 0): DOWN,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  path_actions = []\n  found_path = False\n\n  while q:\n      (r, c), current_path = q.popleft()\n\n      if (r, c) == bfs_target_cell:\n          path_actions = current_path\n          found_path = True\n          break\n\n      # Explore neighbors (Up, Down, Left, Right)\n      for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nr, nc = r + dr, c + dc\n          \n          # Check if the neighbor is within grid boundaries and hasn't been visited\n          if 0 <= nr < grid_height and 0 <= nc < grid_width and (nr, nc) not in visited:\n              # Add to visited and queue\n              visited.add((nr, nc))\n              q.append(((nr, nc), current_path + [delta_to_action[(dr, dc)]]))\n  \n  if not found_path:\n      # No path found to the target cell\n      return []\n\n  # After reaching the target cell, perform the USE action to collect the primitive\n  path_actions.append(USE)\n\n  return path_actions", "island_id": 2, "scores": {"3": -1}}
