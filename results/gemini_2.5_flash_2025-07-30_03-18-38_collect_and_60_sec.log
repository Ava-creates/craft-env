{"timestamp": "2025-07-30T10:07:33.958782", "function_name": "collect", "function_body": "  import collections\n\n  # 1. Get the integer index for the given primitive name\n  # Using .index() will add the item to the cookbook's index if it's new.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # Convert grabbable_indices from a list to a set for efficient O(1) average lookups.\n  # This avoids repeated O(N) list lookups if `primitive_idx` is checked many times.\n  grabbable_indices_set = set(env.world.grabbable_indices)\n\n  # 2. Pre-checks for early exit\n  # If the primitive is not grabbable, it cannot be collected via USE.\n  if primitive_idx not in grabbable_indices_set:\n    return [] \n\n  # If the primitive is already in the agent's inventory, no actions needed.\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] \n\n  # 3. Retrieve necessary grid and world properties for pathfinding\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices # This is already a set\n\n  # 4. Initialize BFS: Queue and Path Reconstruction Dictionary\n  # BFS state: ((x, y), direction)\n  # path_trace stores: {current_state: (parent_state, action_taken_to_reach_current_state)}\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  queue = collections.deque([(start_pos, start_dir)]) \n  path_trace = {(start_pos, start_dir): (None, None)} # Parent of start state is None\n\n  target_use_state = None # To store the state from which the final USE action can be applied\n\n  # 5. BFS Loop\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.popleft() \n\n    # Calculate the coordinates of the cell directly in front of the agent,\n    # which is the target for the USE action.\n    dx_facing, dy_facing = _ACTION_TO_COORD_DIFF[curr_dir] # _ACTION_TO_COORD_DIFF is assumed global\n    target_x, target_y = curr_x + dx_facing, curr_y + dy_facing\n\n    # If the cell in front is within bounds and contains the primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      target_use_state = ((curr_x, curr_y), curr_dir)\n      break # Found a valid collection point, exit BFS.\n\n    # Explore all possible movement actions (0-3: DOWN, UP, LEFT, RIGHT)\n    for move_action in range(4): \n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action] # _ACTION_TO_COORD_DIFF is assumed global\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n\n      # Check boundary conditions for the next position\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position is impassable (contains any non-grabbable item).\n      if any(grid[next_x, next_y, k_idx] > 0 for k_idx in non_grabbable_indices):\n        continue \n      \n      # If this new state (position and direction) has not been visited yet\n      if next_state_tuple not in path_trace:\n        path_trace[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action)\n        queue.append(next_state_tuple) \n\n  # 6. Reconstruct Path\n  if target_use_state is None:\n    return [] # Primitive is unreachable\n\n  # Backtrack from the target_use_state to the start state to build the path\n  path_actions = []\n  current_reconstruction_state = target_use_state\n  \n  while path_trace[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = path_trace[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  path_actions.reverse() # Reverse to get actions in correct order (from start to target)\n\n  # Add the final USE action to collect the primitive\n  return path_actions + [USE_ACTION] # USE_ACTION is assumed global", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:09:13.617770", "function_name": "collect", "function_body": "    import collections\n\n    initial_craft_state = env._current_state\n\n    # 1. Check if the primitive is already collected\n    if initial_craft_state.inventory[primitive] > 0:\n        return []\n\n    action_map = env.action_specs()\n    # Assuming action_map provides mapping like {'DOWN': 0, 'UP': 1, 'LEFT': 2, 'RIGHT': 3, 'USE': 4}\n    MOVE_ACTIONS = [action_map['DOWN'], action_map['UP'], action_map['LEFT'], action_map['RIGHT']]\n    USE_ACTION = action_map['USE']\n\n    queue = collections.deque([(initial_craft_state, [])]) # (CraftState, list_of_actions_to_reach_this_state)\n    visited = set() # Stores (pos_x, pos_y, dir) tuples to avoid redundant exploration\n\n    grid_width, grid_height, _ = initial_craft_state.grid.shape # Get grid dimensions\n\n    while queue:\n        current_state, current_path = queue.popleft()\n        current_pos = current_state.pos # (row, col)\n        current_dir = current_state.dir # 0:N, 1:E, 2:S, 3:W\n\n        state_tuple = (current_pos[0], current_pos[1], current_dir)\n        if state_tuple in visited:\n            continue\n        visited.add(state_tuple)\n\n        # 2. Check if the primitive is adjacent to the current position in this state\n        # We need to find the specific (neighbor_row, neighbor_col) where the primitive is located\n        # and determine the direction the agent needs to face to USE it.\n        found_target_dir = -1 # Will store the required agent direction (0-3)\n\n        r, c = current_pos\n\n        # Check North (r-1, c)\n        if r > 0 and current_state.grid[r - 1, c, primitive] == 1:\n            found_target_dir = 0 # Agent needs to face North (dir 0)\n        # Check East (r, c+1)\n        elif c < grid_height - 1 and current_state.grid[r, c + 1, primitive] == 1:\n            found_target_dir = 1 # Agent needs to face East (dir 1)\n        # Check South (r+1, c)\n        elif r < grid_width - 1 and current_state.grid[r + 1, c, primitive] == 1:\n            found_target_dir = 2 # Agent needs to face South (dir 2)\n        # Check West (r, c-1)\n        elif c > 0 and current_state.grid[r, c - 1, primitive] == 1:\n            found_target_dir = 3 # Agent needs to face West (dir 3)\n        \n        # If the primitive is found adjacent:\n        if found_target_dir != -1:\n            path_to_collect = list(current_path) # Copy the path to this adjacent location\n\n            # Calculate the number of turns needed to face the primitive\n            current_agent_dir = current_state.dir\n            \n            # Turns left (counter-clockwise)\n            turn_left_count = (current_agent_dir - found_target_dir + 4) % 4\n            # Turns right (clockwise)\n            turn_right_count = (found_target_dir - current_agent_dir + 4) % 4\n            \n            # Add rotation actions to the path\n            if turn_left_count <= turn_right_count:\n                for _ in range(turn_left_count):\n                    path_to_collect.append(action_map['LEFT'])\n            else:\n                for _ in range(turn_right_count):\n                    path_to_collect.append(action_map['RIGHT'])\n            \n            # Add the USE action to collect the primitive\n            path_to_collect.append(USE_ACTION)\n            return path_to_collect\n\n        # 3. If primitive not found adjacent, explore neighboring states (movement actions)\n        for action in MOVE_ACTIONS:\n            # Simulate the action to get the next CraftState without modifying the actual env's state yet.\n            # CraftState.step() returns a new CraftState object.\n            next_state, _ = current_state.step(action) \n            \n            next_state_tuple = (next_state.pos[0], next_state.pos[1], next_state.dir)\n            if next_state_tuple not in visited:\n                queue.append((next_state, current_path + [action]))\n\n    # If the queue becomes empty and the primitive hasn't been found/collected\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:09:13.690653", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action mappings (from CraftLab docstring)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Direction deltas (dx, dy) for movement actions\n    ACTION_DELTAS = {\n        ACTION_DOWN: (0, 1),    # Move South (increase y)\n        ACTION_UP: (0, -1),     # Move North (decrease y)\n        ACTION_LEFT: (-1, 0),   # Move West (decrease x)\n        ACTION_RIGHT: (1, 0)    # Move East (increase x)\n    }\n\n    # Agent facing directions (0: North, 1: East, 2: South, 3: West)\n    DIR_NORTH = 0\n    DIR_EAST = 1\n    DIR_SOUTH = 2\n    DIR_WEST = 3\n\n    # Neighbor deltas for checking cardinal adjacency\n    NEIGHBOR_DELTAS = [\n        (0, -1), # North\n        (0, 1),  # South\n        (-1, 0), # West\n        (1, 0)   # East\n    ]\n\n    # 1. Initialize and get current state information\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    \n    current_grid = features_dict['features_global']\n    current_inventory = features_dict['inventory']\n\n    world = env.world # Access to CraftWorld instance for grid dimensions and non_grabbable_indices\n    WIDTH = world.scenario.init_grid.shape[0]\n    HEIGHT = world.scenario.init_grid.shape[1]\n\n    # Reconstruct integer position from normalized pos\n    agent_x = int(round(features_dict['pos'][0] * WIDTH))\n    agent_y = int(round(features_dict['pos'][1] * HEIGHT))\n    agent_pos = (agent_x, agent_y)\n\n    # Reconstruct direction from one-hot array\n    agent_dir = np.argmax(features_dict['direction'])\n\n    # 2. Check if the primitive is already in inventory\n    if current_inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # 3. Find all locations of the primitive on the current grid\n    primitive_locations = set()\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if current_grid[x, y, primitive] > 0:\n                primitive_locations.add((x, y))\n\n    if not primitive_locations:\n        return [] # Primitive not found in the observable world\n\n    # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n    #    to a cell adjacent to the primitive.\n    q = collections.deque()\n    # Queue stores tuples: (current_position, current_direction, path_of_actions_taken)\n    q.append((agent_pos, agent_dir, []))\n    \n    # Visited set to avoid cycles and redundant paths.\n    # State in visited: ((x, y), direction) - captures both location and orientation\n    visited = set()\n    visited.add((agent_pos, agent_dir))\n\n    while q:\n        (x, y), current_dir, actions_path = q.popleft()\n\n        # Check if the current position is adjacent to any primitive location\n        target_primitive_pos = None\n        for dx_adj, dy_adj in NEIGHBOR_DELTAS:\n            neighbor_x, neighbor_y = x + dx_adj, y + dy_adj\n            if (neighbor_x, neighbor_y) in primitive_locations:\n                target_primitive_pos = (neighbor_x, neighbor_y)\n                break\n        \n        if target_primitive_pos:\n            # Path found to an adjacent cell. Now calculate turns to face the primitive\n            # and append the USE action.\n            \n            # Calculate the required direction to face from (x, y) to target_primitive_pos\n            target_dx = target_primitive_pos[0] - x\n            target_dy = target_primitive_pos[1] - y\n\n            required_dir = -1\n            if target_dy < 0: # Target is North of current_pos\n                required_dir = DIR_NORTH\n            elif target_dx > 0: # Target is East of current_pos\n                required_dir = DIR_EAST\n            elif target_dy > 0: # Target is South of current_pos\n                required_dir = DIR_SOUTH\n            elif target_dx < 0: # Target is West of current_pos\n                required_dir = DIR_WEST\n            \n            # Calculate turns needed to face the required direction\n            turn_actions = []\n            if required_dir != -1 and required_dir != current_dir:\n                # Calculate shortest turn difference (0=no turn, 1=right, 2=180, 3=left)\n                diff = (required_dir - current_dir + 4) % 4\n                if diff == 1: # One right turn\n                    turn_actions.append(ACTION_RIGHT)\n                elif diff == 2: # Two turns (180 degrees)\n                    turn_actions.extend([ACTION_RIGHT, ACTION_RIGHT]) \n                elif diff == 3: # One left turn\n                    turn_actions.append(ACTION_LEFT)\n            \n            # Return the full sequence of actions: move path + turns + USE\n            return actions_path + turn_actions + [ACTION_USE]\n\n        # Explore possible moves from the current position\n        for action_move, (dx, dy) in ACTION_DELTAS.items():\n            new_x, new_y = x + dx, y + dy\n            new_pos = (new_x, new_y)\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= new_x < WIDTH and 0 <= new_y < HEIGHT):\n                continue\n            \n            # Check for traversability: Ensure the new cell is not blocked by non-grabbable items\n            # Assuming agent cannot move into cells occupied by non-grabbable environment items.\n            is_blocked = False\n            for kind_idx in world.non_grabbable_indices:\n                if current_grid[new_x, new_y, kind_idx] > 0:\n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue\n\n            # Movement actions do not change the agent's facing direction\n            new_dir = current_dir \n\n            # If this new state (position and direction) has not been visited, add to queue\n            if (new_pos, new_dir) not in visited:\n                visited.add((new_pos, new_dir))\n                q.append((new_pos, new_dir, actions_path + [action_move]))\n    \n    # If the BFS completes and no path to an adjacent primitive is found\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:10:25.370883", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants (based on CraftLab.action_specs)\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Get current state from the environment\n  # The CraftLab class has a _current_state attribute which is a CraftState instance.\n  # This provides direct access to grid, pos, inventory, and world configuration.\n  craft_state = env._current_state \n  grid = craft_state.grid\n  current_pos = craft_state.pos\n  inventory = craft_state.inventory\n  world = craft_state.world # This is the CraftWorld instance\n\n  # 1. Check if the primitive is already in the inventory\n  if inventory[primitive] > 0:\n    return [] # Already collected, no actions needed.\n\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n\n  # 2. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # If the cell (x, y) contains at least one instance of the primitive\n      if grid[x, y, primitive] > 0:\n        primitive_locations.append((x, y))\n\n  if not primitive_locations:\n    return [] # Primitive not found on the map, cannot collect.\n\n  # 3. BFS to find the shortest path to a cell adjacent to any primitive location\n  # Queue stores tuples: (current_position (x,y), list_of_actions_to_reach_here)\n  q = collections.deque([(current_pos, [])])\n  visited = {current_pos} # Keep track of visited (x, y) positions to avoid cycles and redundant paths\n\n  # Set of non-traversable indices from CraftWorld (e.g., water, solid walls)\n  # Assuming non_grabbable_indices implies non-traversable for agent movement.\n  non_traversable_indices = world.non_grabbable_indices\n  \n  # Helper function to check if a cell is traversable by the agent\n  def is_cell_traversable(x, y):\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False # Out of bounds\n    \n    # Check if the cell contains any non-traversable item\n    # Assuming grid stores counts, so > 0 means presence of an item.\n    for item_idx in non_traversable_indices:\n      if grid[x, y, item_idx] > 0:\n        return False # Cell is blocked by a non-traversable item\n    return True\n\n  # Define possible movements and their corresponding actions\n  # (dx, dy, action_id) for moving from (x,y) to (x+dx, y+dy)\n  moves = [\n      (-1, 0, LEFT),  # Move Left: decrease x\n      (1, 0, RIGHT), # Move Right: increase x\n      (0, -1, UP),   # Move Up: decrease y (assuming (0,0) is top-left)\n      (0, 1, DOWN)   # Move Down: increase y\n  ]\n\n  best_path_actions = None\n  min_path_length = float('inf')\n\n  while q:\n    (curr_x, curr_y), path_actions = q.popleft()\n\n    # Optimization: If the current path is already longer than the shortest path found so far,\n    # then any further paths from this point will also be longer or equal, so prune this branch.\n    if len(path_actions) >= min_path_length:\n      continue\n\n    # Check if the current position is adjacent to any of the primitive locations\n    for p_x, p_y in primitive_locations:\n      # Manhattan distance of 1 means the agent is directly adjacent (up, down, left, or right)\n      if abs(curr_x - p_x) + abs(curr_y - p_y) == 1:\n        # Found a path to a cell adjacent to a primitive.\n        # If this path is shorter than or equal to the best found so far, update.\n        if len(path_actions) < min_path_length:\n          min_path_length = len(path_actions)\n          best_path_actions = list(path_actions) # Store a copy of the action list\n\n    # Explore neighbors for further movement\n    for dx, dy, action in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Only add to queue if the cell is traversable and hasn't been visited yet\n      if is_cell_traversable(next_x, next_y) and next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path_actions + [action]))\n\n  # 4. If a path to an adjacent cell was found, append the USE action\n  if best_path_actions is None:\n    return [] # No traversable path found to any primitive\n  else:\n    return best_path_actions + [USE]", "island_id": 2, "scores": {"3": -1}}
