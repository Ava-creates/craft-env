{"timestamp": "2025-07-30T14:59:21.349979", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Direction constants (assuming 0=N, 1=E, 2=S, 3=W clockwise from North)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper functions\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"Calculates the direction the agent needs to face to look at the item.\"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 0 and dy == 0:\n      return None # Agent is on top of item, should not happen when targeting an adjacent cell\n\n    # Prioritize cardinal directions based on largest component\n    if abs(dx) > abs(dy):\n      return EAST_DIR if dx > 0 else WEST_DIR\n    elif abs(dy) > abs(dx):\n      return SOUTH_DIR if dy > 0 else NORTH_DIR\n    else: # This branch is for diagonal cases or when dx=dy (e.g., dx=1, dy=1).\n          # For adjacent cells (dx=0 or dy=0 for direct adjacency), one of the above ifs will be true.\n          # If it were a diagonal, prioritize vertical or horizontal. For simplicity, match first non-zero.\n      if dy > 0: return SOUTH_DIR\n      if dy < 0: return NORTH_DIR\n      if dx > 0: return EAST_DIR\n      if dx < 0: return WEST_DIR\n    return None\n\n  def _get_turn_actions(current_dir, target_dir):\n    \"\"\"Returns a list of actions to turn from current_dir to target_dir.\n    Assumes LEFT_ACTION and RIGHT_ACTION are turn actions in this context.\"\"\"\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    # Calculate shortest turns (clockwise vs. counter-clockwise)\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION)\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION)\n    return actions\n\n  # Get primitive's integer ID\n  primitive_id = env.world.cookbook.index.get(primitive)\n\n  if primitive_id is None:\n    return [] # Primitive not found in the cookbook index\n\n  # Get current state information\n  current_state = env._current_state\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir \n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape \n\n  # Get non-grabbable entity indices to identify obstacles\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  def is_walkable(x, y, current_grid):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-grabbable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell (y, x) contains any non-grabbable item (obstacle)\n    for kind_idx in non_grabbable_kinds:\n      if current_grid[y, x, kind_idx] > 0:\n        return False\n    return True\n\n  # BFS to find the shortest sequence of movement actions to reach *any* cell adjacent to *any* primitive\n  # State in queue: (current_x, current_y, list_of_actions_to_reach_this_state)\n  queue = collections.deque([(start_pos_x, start_pos_y, [])]) \n  # Visited set: (x, y) coordinates to prevent cycles and ensure shortest path finding\n  visited = {(start_pos_x, start_pos_y)} \n\n  movement_actions_to_primitive = None # Stores the sequence of actions if a path is found\n  final_agent_pos = None # Position agent lands on, adjacent to primitive\n  target_item_pos = None # Actual primitive's position\n\n  # Define cardinal movement deltas with corresponding actions (dx, dy)\n  # (dx for columns, dy for rows)\n  cardinal_moves = {\n      RIGHT_ACTION: (1, 0),\n      LEFT_ACTION: (-1, 0),\n      DOWN_ACTION: (0, 1), # Y increases downwards\n      UP_ACTION: (0, -1)  # Y decreases upwards\n  }\n\n  while queue:\n    curr_x, curr_y, path_actions = queue.popleft()\n\n    # Check if the current cell (curr_x, curr_y) is adjacent to the target primitive\n    # We iterate through possible adjacent cells for a primitive, not just fixed ones.\n    found_adjacent = False\n    for action_move, (dx, dy) in cardinal_moves.items():\n      adj_item_x, adj_item_y = curr_x + dx, curr_y + dy\n      \n      # Check if this adjacent cell is within bounds and contains the primitive\n      if (0 <= adj_item_x < grid_width and 0 <= adj_item_y < grid_height and\n          grid[adj_item_y, adj_item_x, primitive_id] > 0):\n        \n        movement_actions_to_primitive = path_actions\n        final_agent_pos = (curr_x, curr_y)\n        target_item_pos = (adj_item_x, adj_item_y)\n        found_adjacent = True\n        break # Found a primitive adjacent to the current position\n\n    if found_adjacent:\n      break # Exit BFS, shortest path to an adjacent cell of *any* primitive found\n\n    # Explore neighbors (movement actions)\n    for action, (dx, dy) in cardinal_moves.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      if is_walkable(next_x, next_y, grid) and (next_x, next_y) not in visited:\n        visited.add((next_x, next_y))\n        new_path_actions = list(path_actions) + [action] # Append the action to the path\n        queue.append((next_x, next_y, new_path_actions))\n  \n  if movement_actions_to_primitive is None:\n    return [] # No path found to any adjacent walkable cell to any primitive\n\n  # Construct the full sequence of actions:\n  # 1. Movement actions to reach the adjacent cell.\n  # 2. Turning actions to face the primitive.\n  # 3. The USE action.\n\n  all_actions = list(movement_actions_to_primitive) # Start with actions to move to the adjacent cell\n  \n  # Determine the direction the agent needs to face the primitive from its final position\n  # The agent's facing direction (`start_dir`) hasn't changed during movement actions.\n  agent_x_at_target, agent_y_at_target = final_agent_pos\n  target_item_x, target_item_y = target_item_pos\n\n  target_face_dir = _get_target_facing_direction(agent_x_at_target, agent_y_at_target, target_item_x, target_item_y)\n  \n  if target_face_dir is not None:\n    # Add turning actions, using the agent's initial direction (since movement doesn't change it)\n    turn_actions = _get_turn_actions(start_dir, target_face_dir)\n    all_actions.extend(turn_actions)\n  \n  # Add the USE action to collect the primitive\n  all_actions.append(USE_ACTION)\n\n  return all_actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:00:37.265465", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Define action constants based on CraftLab.action_specs\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Define movement deltas for (dx, dy) based on (x, y) grid indexing\n    # (x is column, y is row)\n    ACTION_DELTAS = {\n        DOWN: (0, 1),   # (dx, dy) for moving down (y increases)\n        UP: (0, -1),    # (dx, dy) for moving up (y decreases)\n        LEFT: (-1, 0),  # (dx, dy) for moving left (x decreases)\n        RIGHT: (1, 0)   # (dx, dy) for moving right (x increases)\n    }\n\n    # Assuming CraftState.dir attribute (agent's facing direction) uses the same\n    # integer values as the action IDs for DOWN, UP, LEFT, RIGHT.\n    # So, if dir is DOWN (0), agent faces (0,1) relative to its position.\n    DELTAS_FOR_DIRECTIONS = ACTION_DELTAS\n\n    def _is_walkable(x, y, grid, non_grabbable_indices, width, height):\n        \"\"\"\n        Checks if a cell (x, y) is within grid bounds and does not contain\n        any non-grabbable obstacles.\n        \"\"\"\n        if not (0 <= x < width and 0 <= y < height):\n            return False\n        # A cell is not walkable if it contains any non-grabbable item\n        for idx in non_grabbable_indices:\n            if grid[x, y, idx] == 1:\n                return False\n        return True\n\n    # Get the current state of the environment\n    # We are operating on the current state, not resetting the environment\n    state = env._current_state\n    \n    # If the primitive is already in the inventory, no actions are needed\n    if state.inventory[primitive] > 0:\n        return []\n\n    grid = state.grid\n    current_pos = state.pos  # (x, y)\n    current_dir = state.dir  # int (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT)\n    non_grabbable_indices = env.non_grabbable_indices\n\n    WIDTH, HEIGHT, N_KINDS = grid.shape # grid is (WIDTH, HEIGHT, n_kinds)\n\n    # Initialize BFS queue: (current_position_tuple, current_direction_int, list_of_actions_taken)\n    queue = collections.deque([(current_pos, current_dir, [])])\n    \n    # Keep track of visited states to avoid cycles and redundant exploration\n    # A state is defined by (position, direction)\n    visited = {((current_pos[0], current_pos[1]), current_dir)}\n\n    final_actions_plan = []\n\n    # BFS to find the shortest path\n    while queue:\n        (curr_x, curr_y), curr_d, path_so_far = queue.popleft()\n\n        # 1. Check if the primitive is directly in front of the current (pos, dir) state\n        if curr_d in DELTAS_FOR_DIRECTIONS:\n            dx_front, dy_front = DELTAS_FOR_DIRECTIONS[curr_d]\n            target_x_for_use, target_y_for_use = curr_x + dx_front, curr_y + dy_front\n\n            # Ensure the target cell is within bounds\n            if 0 <= target_x_for_use < WIDTH and 0 <= target_y_for_use < HEIGHT:\n                # Check if the primitive is in that cell\n                if grid[target_x_for_use, target_y_for_use, primitive] == 1:\n                    final_actions_plan = path_so_far + [USE]\n                    break # Path found, exit BFS\n\n        # 2. Explore possible next states by moving (DOWN, UP, LEFT, RIGHT)\n        for action_to_take in [DOWN, UP, LEFT, RIGHT]:\n            dx, dy = ACTION_DELTAS[action_to_take]\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_d = action_to_take # Agent's direction changes to the direction of movement\n\n            # Check if the next cell is walkable and the state hasn't been visited\n            if _is_walkable(next_x, next_y, grid, non_grabbable_indices, WIDTH, HEIGHT):\n                next_state_key = ((next_x, next_y), next_d)\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    queue.append(((next_x, next_y), next_d, path_so_far + [action_to_take]))\n    \n    return final_actions_plan", "island_id": 8, "scores": {"3": -1}}
