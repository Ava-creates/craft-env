{"timestamp": "2025-07-30T06:02:23.244397", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants (assuming these are defined as integers, common in Craft envs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  MOVE_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n  # Get the initial state from the environment.\n  # env.reset() prepares the environment, and _current_state holds the CraftState.\n  _ = env.reset()\n  initial_state = env._current_state\n\n  # If the primitive is already in the inventory at the start, no actions are needed.\n  if initial_state.inventory[primitive] > 0:\n    return []\n\n  # Queue for Breadth-First Search (BFS): stores tuples of (CraftState, list_of_actions_to_reach_this_state)\n  queue = collections.deque([(initial_state, [])])\n\n  # Set to keep track of visited states to avoid cycles and redundant work.\n  # A state is uniquely identified by its position, direction, current inventory, and grid layout.\n  # numpy arrays are not hashable by default, so we convert them to bytes for hashing.\n  visited = set()\n\n  # Helper function to create a hashable key for a CraftState\n  def get_state_key(state):\n    return (state.pos, state.dir, state.inventory.tobytes(), state.grid.tobytes())\n\n  # Add the initial state to the visited set\n  visited.add(get_state_key(initial_state))\n\n  while queue:\n    current_state, current_path = queue.popleft()\n\n    # Check if the primitive has been collected in the current state's inventory\n    if current_state.inventory[primitive] > 0:\n      return current_path\n\n    # Explore movement actions (DOWN, UP, LEFT, RIGHT)\n    for action in MOVE_ACTIONS:\n      # CraftState.step returns a *new* state, so current_state is not modified\n      _reward, next_state = current_state.step(action)\n      next_state_key = get_state_key(next_state)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        queue.append((next_state, current_path + [action]))\n\n    # If the agent is next to the primitive and it's a grabbable item, try to USE it.\n    # `CraftState.world.grabbable_indices` tells us which items can be picked up.\n    is_primitive_grabbable = primitive in current_state.world.grabbable_indices\n\n    if current_state.next_to(primitive) and is_primitive_grabbable:\n      # Attempt the USE action\n      _reward, state_after_use = current_state.step(USE)\n      state_after_use_key = get_state_key(state_after_use)\n\n      # If the USE action successfully collected the primitive, we found the path\n      if state_after_use.inventory[primitive] > 0:\n        return current_path + [USE]\n\n      # Even if the USE action didn't collect the target (e.g., it failed or\n      # picked up something else), if it results in a new, unvisited state,\n      # add it to the queue for further exploration.\n      if state_after_use_key not in visited:\n        visited.add(state_after_use_key)\n        queue.append((state_after_use, current_path + [USE]))\n\n  # If the queue becomes empty and the primitive hasn't been found, it's unreachable.\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:04:02.937626", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants based on CraftLab.action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_RIGHT = 2\n    ACTION_LEFT = 3\n    ACTION_USE = 4\n\n    # Movement deltas and their corresponding actions (dr, dc): (row_change, col_change)\n    MOVE_DELTAS_AND_ACTIONS = [\n        ((-1, 0), ACTION_UP),    # Move Up\n        ((1, 0), ACTION_DOWN),   # Move Down\n        ((0, -1), ACTION_LEFT),  # Move Left\n        ((0, 1), ACTION_RIGHT),  # Move Right\n    ]\n\n    # Access current state of the environment\n    # Note: Accessing `_current_state` is an internal detail, but necessary as\n    # `features_dict['pos']` is normalized, and `CraftState.pos` holds integer coords.\n    current_state = env._current_state\n    current_grid = current_state.grid  # (HEIGHT, WIDTH, n_kinds)\n    current_pos = current_state.pos    # (row, col)\n    inventory = current_state.inventory # (n_kinds,)\n\n    # 1. Check if primitive is already in inventory\n    if inventory[primitive] > 0:\n        return []\n\n    H, W, N_KINDS = current_grid.shape\n\n    # Get world configuration for identifying obstacles\n    world = env.world\n    # Obstacles are typically non-grabbable items (like water, workshops)\n    non_grabbable_indices = world.non_grabbable_indices\n\n    # 2. Find all locations on the grid where the primitive exists\n    primitive_locations = []\n    for r in range(H):\n        for c in range(W):\n            if current_grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        # Primitive not found on the map\n        return []\n\n    # Helper function to determine if a cell (curr_r, curr_c) is a valid position\n    # from which the USE action can collect the primitive.\n    # This means (curr_r, curr_c) is within the 3x3 neighborhood of a primitive location,\n    # consistent with CraftState.next_to definition.\n    def is_use_ready_cell(curr_r, curr_c):\n        for pr, pc in primitive_locations:\n            # Check if (curr_r, curr_c) is within 3x3 square centered at (pr, pc)\n            if (abs(curr_r - pr) <= 1 and abs(curr_c - pc) <= 1):\n                return True\n        return False\n\n    # 3. BFS to find the shortest path to a \"use-ready\" cell\n    q = collections.deque([(current_pos, [])]) # Queue stores ((row, col), list_of_actions_to_reach_here)\n    visited = {current_pos} # Set of visited (row, col) positions\n\n    # Initial check: If agent starts at a \"use-ready\" cell, just use.\n    if is_use_ready_cell(current_pos[0], current_pos[1]):\n        return [ACTION_USE]\n\n    while q:\n        (r, c), path = q.popleft()\n\n        for (dr, dc), action_to_take in MOVE_DELTAS_AND_ACTIONS:\n            nr, nc = r + dr, c + dc # Calculate new row and column\n\n            # Check if new position is within grid boundaries\n            if not (0 <= nr < H and 0 <= nc < W):\n                continue\n\n            # Check if the new position is an obstacle\n            is_obstacle = False\n            for k in non_grabbable_indices:\n                if current_grid[nr, nc, k] > 0:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n\n            # Check if the new position has already been visited\n            if (nr, nc) in visited:\n                continue\n\n            # If the neighbor cell (nr, nc) is a \"use-ready\" cell, we found our path!\n            if is_use_ready_cell(nr, nc):\n                final_actions = path + [action_to_take, ACTION_USE]\n                return final_actions # Return the first (shortest) path found\n\n            # If not yet a goal cell, add to queue for further exploration\n            visited.add((nr, nc))\n            q.append(((nr, nc), path + [action_to_take]))\n\n    # 4. If BFS completes without finding a path to a \"use-ready\" cell\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:04:03.010539", "function_name": "collect", "function_body": "    # Get action integer mappings from the environment\n    action_specs = env.action_specs()\n    ACTION_DOWN = action_specs['DOWN']\n    ACTION_UP = action_specs['UP']\n    ACTION_LEFT = action_specs['LEFT']\n    ACTION_RIGHT = action_specs['RIGHT']\n    ACTION_USE = action_specs['USE']\n\n    # Map (dr, dc) delta to a cardinal movement action\n    MOVE_ACTIONS = {\n        (-1, 0): ACTION_UP,\n        (1, 0): ACTION_DOWN,\n        (0, -1): ACTION_LEFT,\n        (0, 1): ACTION_RIGHT,\n    }\n\n    # Map integer direction to (dr, dc) delta\n    # Assuming standard directions: 0:North, 1:East, 2:South, 3:West\n    DIR_TO_DELTA = {\n        0: (-1, 0),  # North (row decreases)\n        1: (0, 1),   # East (col increases)\n        2: (1, 0),   # South (row increases)\n        3: (0, -1)   # West (col decreases)\n    }\n    # Create a reverse mapping: (dr, dc) delta to integer direction\n    DELTA_TO_DIR = {v: k for k, v in DIR_TO_DELTA.items()}\n\n    def get_turn_actions(current_dir, target_dir):\n        \"\"\"Returns a list of actions to turn from current_dir to target_dir.\"\"\"\n        actions = []\n        if current_dir == target_dir:\n            return actions\n\n        # Calculate shortest turns (clockwise or counter-clockwise)\n        # N=0, E=1, S=2, W=3\n        diff = (target_dir - current_dir + 4) % 4\n        if diff == 1:  # Current to target is 1 step clockwise (e.g., N -> E)\n            actions.append(ACTION_RIGHT)\n        elif diff == 3:  # Current to target is 1 step counter-clockwise (e.g., N -> W)\n            actions.append(ACTION_LEFT)\n        elif diff == 2:  # Current to target is 2 steps (e.g., N -> S)\n            # Two right turns is a common way to implement a 180-degree turn\n            actions.extend([ACTION_RIGHT, ACTION_RIGHT]) \n        return actions\n\n\n    initial_state = env._current_state\n    initial_pos = initial_state.pos\n    initial_dir = initial_state.dir \n    grid = initial_state.grid\n    WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n    \n    # 1. Find all primitive locations on the grid\n    primitive_locations = []\n    for r in range(WIDTH):\n        for c in range(HEIGHT):\n            if grid[r, c, primitive] > 0: # Check if the primitive exists at this (r,c) cell\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        return [] # Primitive not found in the grid\n\n    # 2. Determine all possible target states (position and direction)\n    # The agent needs to be adjacent to a primitive and facing it to USE it.\n    target_states = set() # Stores (adjacent_r, adjacent_c, direction_to_face_primitive)\n    \n    # Possible relative positions for neighbors (adjacent cells)\n    neighbor_deltas = [\n        (-1, 0),  # North neighbor\n        (1, 0),   # South neighbor\n        (0, -1),  # West neighbor\n        (0, 1)    # East neighbor\n    ]\n\n    for pr, pc in primitive_locations:\n        for dr_adj, dc_adj in neighbor_deltas:\n            ar, ac = pr + dr_adj, pc + dc_adj # Coordinates of the adjacent cell\n            \n            # Check if the adjacent cell is within grid boundaries\n            if not (0 <= ar < WIDTH and 0 <= ac < HEIGHT):\n                continue\n            \n            # Calculate the delta from the adjacent cell (ar,ac) to the primitive (pr,pc)\n            dr_face, dc_face = pr - ar, pc - ac\n            \n            # Convert this delta into an integer direction the agent must face\n            if (dr_face, dc_face) in DELTA_TO_DIR:\n                dir_to_face = DELTA_TO_DIR[(dr_face, dc_face)]\n                target_states.add((ar, ac, dir_to_face))\n    \n    if not target_states:\n        # No valid target positions found (e.g., primitive is completely surrounded)\n        return []\n\n    # 3. Use Breadth-First Search (BFS) to find the shortest action sequence\n    # BFS state: (row, col, current_direction, list_of_actions_taken)\n    queue = collections.deque([(initial_pos[0], initial_pos[1], initial_dir, [])])\n    \n    # Visited set: (row, col, current_direction) to prevent cycles and redundant paths\n    visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n    while queue:\n        r, c, current_dir, actions_so_far = queue.popleft()\n\n        # Check if the current state (r, c, current_dir) is one of our target states\n        # If it is, we are adjacent to a primitive and facing it correctly.\n        if (r, c, current_dir) in target_states:\n            return actions_so_far + [ACTION_USE]\n\n        # Explore possible next states by moving\n        for dr_move, dc_move in MOVE_ACTIONS.keys(): # Keys are (-1,0), (1,0), etc. for cardinal moves\n            nr, nc = r + dr_move, c + dc_move\n            \n            # Check if new position is within grid boundaries\n            if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n                continue \n            \n            # Cardinal movement actions (UP, DOWN, LEFT, RIGHT) do not change the agent's direction.\n            # So, current_dir remains the same.\n            new_state_key = (nr, nc, current_dir)\n            if new_state_key not in visited:\n                visited.add(new_state_key)\n                action_to_take = MOVE_ACTIONS[(dr_move, dc_move)]\n                queue.append((nr, nc, current_dir, actions_so_far + [action_to_take]))\n\n        # Explore possible next states by turning\n        for next_dir in range(4): # Iterate through all possible directions (0, 1, 2, 3)\n            if next_dir == current_dir:\n                continue # No turn needed if direction is the same\n\n            # Turning actions do not change the agent's position (r, c).\n            new_state_key = (r, c, next_dir)\n            if new_state_key not in visited:\n                visited.add(new_state_key)\n                turn_actions = get_turn_actions(current_dir, next_dir)\n                queue.append((r, c, next_dir, actions_so_far + turn_actions))\n    \n    # If the queue becomes empty and no target state was reached, it means no path was found.\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:05:44.525842", "function_name": "collect", "function_body": "  # Constants for actions (as per CraftLab's action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action IDs to (dr, dc) for movement (row_delta, col_delta)\n  ACTION_TO_DELTA = {\n      ACTION_UP: (-1, 0),\n      ACTION_DOWN: (1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1),\n  }\n\n  # Access the current state from the CraftLab environment\n  current_state = env._current_state\n\n  # 1. Check if the primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # 2. Check if we are already next to the primitive\n  #    If so, only the USE action is needed.\n  if current_state.next_to(primitive):\n      return [ACTION_USE]\n\n  # Get necessary state information for BFS\n  current_grid = current_state.grid\n  agent_pos = current_state.pos # This is already a tuple (int, int)\n  \n  HEIGHT, WIDTH, _ = current_grid.shape\n\n  # Identify obstacle indices\n  obstacle_indices = set()\n  # Add specific known unmovable obstacles from CraftWorld\n  if hasattr(env.world, 'water_index'):\n      obstacle_indices.add(env.world.water_index)\n  if hasattr(env.world, 'workshop_indices'):\n      obstacle_indices.update(env.world.workshop_indices)\n  \n  # Consider other non-grabbable items as obstacles for movement,\n  # but ensure the target primitive itself is not treated as an obstacle.\n  if hasattr(env.world, 'non_grabbable_indices'):\n      for idx in env.world.non_grabbable_indices:\n          if idx != primitive: # The primitive itself should not block movement if it's on the grid\n              obstacle_indices.add(idx)\n\n  # Find all locations of the primitive on the grid\n  primitive_locations = np.argwhere(current_grid[:, :, primitive] == 1)\n\n  if len(primitive_locations) == 0:\n      # Primitive not found on the grid. It might be gone, or not present in this scenario.\n      return []\n\n  # BFS to find the shortest path to a cell from which the primitive can be collected\n  q = collections.deque([(agent_pos, [])]) # (current_position, actions_taken_to_reach_here)\n  visited = {agent_pos}\n\n  while q:\n      (r, c), path = q.popleft()\n\n      for action_id, (dr, dc) in ACTION_TO_DELTA.items():\n          nr, nc = r + dr, c + dc\n\n          # Check bounds\n          if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n              continue\n\n          # Check if visited to avoid cycles and redundant paths\n          if (nr, nc) in visited:\n              continue\n          \n          # Check if the new cell (nr, nc) contains an obstacle\n          is_obstacle_cell = False\n          for obstacle_idx in obstacle_indices:\n              if current_grid[nr, nc, obstacle_idx] == 1:\n                  is_obstacle_cell = True\n                  break\n          \n          if is_obstacle_cell:\n              continue # Cannot move into an obstacle cell\n\n          new_path = path + [action_id]\n          visited.add((nr, nc))\n\n          # After moving to (nr, nc), check if we would be adjacent to the primitive\n          # This is done by checking if any primitive location is within the 3x3 neighborhood of (nr, nc)\n          is_adjacent = False\n          for prim_r, prim_c in primitive_locations:\n              # Check if the primitive is within the 3x3 neighborhood (Chebyshev distance <= 1)\n              if abs(nr - prim_r) <= 1 and abs(nc - prim_c) <= 1:\n                  is_adjacent = True\n                  break\n          \n          if is_adjacent:\n              # Found a path to a cell from which we can USE.\n              return new_path + [ACTION_USE]\n          \n          q.append(((nr, nc), new_path))\n  \n  # If BFS completes without finding a path to collect the primitive\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:05:44.595121", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Helper: Maps agent's direction (0:N, 1:E, 2:S, 3:W) to (delta_row, delta_col)\n    DIR_DELTAS = {\n        0: (-1, 0), # North (UP)\n        1: (0, 1),  # East (RIGHT)\n        2: (1, 0),  # South (DOWN)\n        3: (0, -1)  # West (LEFT)\n    }\n\n    # Helper: Maps movement actions to (delta_row, delta_col) for the agent's absolute movement\n    MOVE_ACTION_DELTAS = {\n        env_factory.ACTIONS.UP: (-1, 0),\n        env_factory.ACTIONS.DOWN: (1, 0),\n        env_factory.ACTIONS.LEFT: (0, -1),\n        env_factory.ACTIONS.RIGHT: (0, 1),\n    }\n\n    # Helper: Calculates the new direction after a turn action\n    def get_new_direction(current_dir, turn_action):\n        if turn_action == env_factory.ACTIONS.LEFT:\n            return (current_dir - 1 + 4) % 4\n        elif turn_action == env_factory.ACTIONS.RIGHT:\n            return (current_dir + 1) % 4\n        return current_dir # Should not be reached for proper turn actions\n\n    # Get the current state information from the environment\n    current_obs = env.observations()\n    features_dict = current_obs['features_dict']\n    initial_grid = features_dict['features_global']\n    initial_pos = tuple(features_dict['pos']) # Convert np.array to tuple for hashing\n    initial_dir = np.argmax(features_dict['direction']) # Convert one-hot to integer direction\n    initial_inventory = features_dict['inventory']\n\n    # Get grid dimensions\n    GRID_WIDTH, GRID_HEIGHT, N_KINDS = initial_grid.shape\n\n    # 1. Check if the primitive is already collected\n    if initial_inventory[primitive] > 0:\n        return []\n\n    # Get grabbable indices from the CraftWorld instance\n    # env (CraftLab) -> scenario (CraftScenario) -> world (CraftWorld)\n    grabbable_indices = env.world.grabbable_indices\n\n    # BFS setup: (row, col, direction, path_actions_to_reach_this_state)\n    queue = collections.deque([(initial_pos[0], initial_pos[1], initial_dir, [])])\n    # Visited set to avoid cycles: (row, col, direction)\n    visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n    while queue:\n        r, c, current_dir, path_actions = queue.popleft()\n\n        # Check if the primitive can be collected from the current position and direction\n        # Get the coordinates of the cell directly in front of the agent\n        dr, dc = DIR_DELTAS[current_dir]\n        front_r, front_c = r + dr, c + dc\n\n        # Check if the cell in front is within bounds and contains the primitive\n        if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT and\n            initial_grid[front_r, front_c, primitive] > 0):\n            # If the primitive is grabbable, we can collect it using the USE action\n            if primitive in grabbable_indices:\n                return path_actions + [env_factory.ACTIONS.USE] # Path found!\n\n        # Explore possible next states by applying movement and turning actions\n\n        # 1. Movement Actions (UP, DOWN, LEFT, RIGHT)\n        for action_type in [env_factory.ACTIONS.UP, env_factory.ACTIONS.DOWN,\n                            env_factory.ACTIONS.LEFT, env_factory.ACTIONS.RIGHT]:\n            delta_r, delta_c = MOVE_ACTION_DELTAS[action_type]\n            next_r, next_c = r + delta_r, c + delta_c\n            next_dir = current_dir # Agent's facing direction does not change during movement\n\n            # Check if the next position is within grid boundaries and the state has not been visited\n            if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT and\n                (next_r, next_c, next_dir) not in visited):\n                visited.add((next_r, next_c, next_dir))\n                queue.append((next_r, next_c, next_dir, path_actions + [action_type]))\n\n        # 2. Turning Actions (LEFT, RIGHT)\n        for action_type in [env_factory.ACTIONS.LEFT, env_factory.ACTIONS.RIGHT]:\n            next_r, next_c = r, c # Position does not change during turning\n            next_dir = get_new_direction(current_dir, action_type)\n\n            # Check if the new direction state has not been visited\n            if (next_r, next_c, next_dir) not in visited:\n                visited.add((next_r, next_c, next_dir))\n                queue.append((next_r, next_c, next_dir, path_actions + [action_type]))\n\n    # If the queue is exhausted and no path to collect the primitive was found\n    return []", "island_id": 7, "scores": {"3": -1}}
