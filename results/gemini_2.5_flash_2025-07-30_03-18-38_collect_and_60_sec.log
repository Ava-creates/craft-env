{"timestamp": "2025-07-30T04:28:26.916038", "function_name": "collect", "function_body": "  actions_to_take = []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Get current state from the environment\n  state = env._current_state\n  current_grid = state.grid\n  current_pos = state.pos  # (x, y)\n\n  # Get world details for obstacle checking\n  world = env.world\n  WIDTH, HEIGHT, N_KINDS = current_grid.shape\n\n  # 1. Find the target primitive on the grid\n  target_primitive_positions = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      if current_grid[x, y, primitive] == 1:\n        target_primitive_positions.append((x, y))\n\n  if not target_primitive_positions:\n    # Primitive not found on the grid, cannot collect\n    return []\n\n  # Choose the closest primitive using Manhattan distance\n  closest_primitive_pos = None\n  min_dist = float('inf')\n  for p_pos in target_primitive_positions:\n    dist = abs(current_pos[0] - p_pos[0]) + abs(current_pos[1] - p_pos[1])\n    if dist < min_dist:\n      min_dist = dist\n      closest_primitive_pos = p_pos\n\n  if closest_primitive_pos is None:  # Should not happen if target_primitive_positions is not empty\n    return []\n\n  # 2. Pathfinding to a cell adjacent to the primitive using BFS\n  q = deque([(current_pos, [])])  # (current_position, list_of_actions_to_reach_here)\n  visited = {current_pos}\n\n  # Relative movements and their corresponding actions\n  move_actions = {\n      (0, -1): ACTION_UP,\n      (0, 1): ACTION_DOWN,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT,\n  }\n\n  # Offsets for neighbors (dx, dy)\n  neighbor_offsets = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # UP, DOWN, LEFT, RIGHT\n\n  target_x, target_y = closest_primitive_pos\n\n  # Cells adjacent to the target primitive\n  adjacent_to_target_cells = set()\n  for dx, dy in neighbor_offsets:\n    nx, ny = target_x + dx, target_y + dy\n    if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n      adjacent_to_target_cells.add((nx, ny))\n\n  path_found = False\n  best_path = []\n\n  while q:\n    curr_p, path = q.popleft()\n    curr_x, curr_y = curr_p\n\n    # Check if current position is adjacent to the target primitive\n    if curr_p in adjacent_to_target_cells:\n      best_path = path\n      path_found = True\n      break  # Found shortest path\n\n    for dx, dy in neighbor_offsets:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_p = (next_x, next_y)\n\n      # Check bounds\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check if obstacle (water or non-grabbable that isn't a workshop)\n      is_obstacle = False\n      if current_grid[next_x, next_y, world.water_index] == 1:\n        is_obstacle = True\n      else:\n        # Check if there's any non-grabbable entity at next_p that isn't a workshop\n        for idx in world.non_grabbable_indices:\n          if current_grid[next_x, next_y, idx] == 1:\n            is_workshop_at_idx = False\n            # Check if this non-grabbable item is a workshop (workshops are walkable)\n            if hasattr(world, 'workshop_indices') and world.workshop_indices:\n              for workshop_idx in world.workshop_indices:\n                if idx == workshop_idx:\n                  is_workshop_at_idx = True\n                  break\n            \n            if not is_workshop_at_idx: # If it's a non-grabbable item that is NOT a workshop\n              is_obstacle = True\n              break\n      \n      if is_obstacle:\n        continue\n\n      # If not visited, add to queue\n      if next_p not in visited:\n        visited.add(next_p)\n        action_to_take = move_actions[(dx, dy)]\n        q.append((next_p, path + [action_to_take]))\n\n  if not path_found:\n    return []  # No path to an adjacent cell found\n\n  # 3. Add USE action after reaching the adjacent cell\n  actions_to_take = best_path + [ACTION_USE]\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:30:15.530998", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from CraftLab action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  start_craft_state = env._current_state\n  world = env.world\n  scenario = env.scenario  # Needed for CraftState constructor\n\n  # Goal check: already have the primitive\n  if start_craft_state.inventory[primitive] > 0:\n    return []\n\n  # BFS state: (CraftState_instance, list_of_actions_to_reach_this_state)\n  # Using collections.deque for efficient popleft\n  q = collections.deque([(start_craft_state, [])])\n\n  # Visited set: store (pos_x, pos_y, direction, tuple(inventory_flat))\n  # Inventory is included as collecting items changes the state significantly.\n  # Grid is too large to include in the visited key and is assumed to only change\n  # due to 'USE' actions or external factors (not just movement).\n  visited = set()\n  initial_key = (start_craft_state.pos, start_craft_state.dir,\n                 tuple(start_craft_state.inventory.astype(int).flatten()))\n  visited.add(initial_key)\n\n  # Maximum steps to explore in BFS to prevent excessive computation time or infinite loops\n  max_bfs_steps = 1000\n  current_step_count = 0\n\n  movement_actions = [DOWN, UP, LEFT, RIGHT]\n\n  while q and current_step_count < max_bfs_steps:\n    current_state, current_path_actions = q.popleft()\n    current_step_count += 1\n\n    # Check if the primitive is already in inventory after this path of actions\n    if current_state.inventory[primitive] > 0:\n      return current_path_actions\n\n    # Consider the USE action: if we are next to the primitive, we might need to use it.\n    # This check happens for the *current_state* before exploring further movements.\n    # We only try to `USE` if the primitive is a resource that can be picked up.\n    if current_state.next_to(primitive) and primitive in world.primitives:\n      # Simulate the USE action to see if it yields the primitive.\n      # To do this, we need to make a copy of the current state before applying USE.\n      # Assuming CraftState.__init__ copies grid/inventory and CraftState.step modifies self and returns self.\n      state_for_use = env_factory.CraftState(\n          scenario=scenario,\n          grid=np.copy(current_state.grid),  # Explicit copy for safety\n          pos=current_state.pos,\n          dir=current_state.dir,\n          inventory=np.copy(current_state.inventory)  # Explicit copy for safety\n      )\n      \n      _, state_after_use = state_for_use.step(USE) # state_after_use is now the modified state_for_use\n      \n      # If the primitive was successfully collected after this USE action\n      if state_after_use.inventory[primitive] > 0:\n        return current_path_actions + [USE]\n      # If USE didn't work (e.g., wrong facing, no item), we continue exploring movement paths.\n\n    # Explore possible next movement actions (DOWN, UP, LEFT, RIGHT)\n    for action in movement_actions:\n      # Create a new CraftState instance based on current_state to simulate the step.\n      # This is crucial for BFS to work correctly with mutable states, avoiding side effects.\n      temp_state_before_step = env_factory.CraftState(\n          scenario=scenario,\n          grid=np.copy(current_state.grid),  # Explicit copy for safety\n          pos=current_state.pos,\n          dir=current_state.dir,\n          inventory=np.copy(current_state.inventory)  # Explicit copy for safety\n      )\n\n      # Simulate the step. CraftState.step modifies temp_state_before_step in-place\n      # and returns a reference to itself.\n      _, next_state_obj = temp_state_before_step.step(action)\n\n      # Construct a unique key for the next state to check if it's already visited.\n      # The key includes position, direction, and the flattened inventory.\n      next_state_key = (next_state_obj.pos, next_state_obj.dir,\n                        tuple(next_state_obj.inventory.astype(int).flatten()))\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state_obj, current_path_actions + [action]))\n\n  # If the queue becomes empty or max_bfs_steps is reached without finding a path,\n  # return an empty list, indicating no path found or goal is unreachable.\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:30:15.602242", "function_name": "collect", "function_body": "    actions = []\n    MAX_COLLECT_STEPS = 500  # Safety limit to prevent infinite loops\n\n    # Helper function to check if a grid cell is blocked by an ungrabbable object.\n    # Defined inside to access `env` attributes without passing them explicitly.\n    def _is_blocked(x, y, grid, non_grabbable_indices, workshop_indices):\n        WIDTH, HEIGHT, _ = grid.shape\n        # Check bounds first\n        if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n            return True # Out of bounds is considered blocked\n\n        # A cell is blocked if it contains any non-grabbable item AND it's not a workshop location.\n        # Workshop locations are generally traversable.\n        for idx in non_grabbable_indices:\n            # If the cell (x, y) contains `idx` and `idx` is not a workshop, it's blocked.\n            if grid[x, y, idx] > 0 and idx not in workshop_indices:\n                return True\n        return False\n\n    # Action mappings for (delta_x, delta_y)\n    # DOWN (0): (0, 1)\n    # UP (1): (0, -1)\n    # LEFT (2): (-1, 0)\n    # RIGHT (3): (1, 0)\n    # USE (4)\n    move_deltas = {\n        0: (0, 1),  # DOWN\n        1: (0, -1), # UP\n        2: (-1, 0), # LEFT\n        3: (1, 0)   # RIGHT\n    }\n\n    for _ in range(MAX_COLLECT_STEPS):\n        current_state = env._current_state\n\n        # 1. Check if the primitive is already in the inventory\n        if current_state.inventory[primitive] > 0:\n            return actions\n\n        # 2. Check if the agent is next to the primitive (within 3x3 neighborhood)\n        if current_state.next_to(primitive):\n            # If next to it, try to USE the item to collect it\n            actions.append(4) # Action 4 is USE\n            _, done, _ = env.step(4)\n            if done:\n                # If the environment signals done after an action, stop collecting.\n                return actions\n            continue # Re-check inventory in the next iteration (in case USE didn't collect, or collected but more needed)\n\n        # 3. Primitive not in inventory and not next to agent, so we need to move\n        grid = current_state.grid\n        current_pos = current_state.pos # (px, py)\n\n        # Find all locations of the primitive on the grid\n        primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n        if len(primitive_locations) == 0:\n            # The primitive is not on the map (e.g., already collected, or not present).\n            # Cannot collect. Return the actions accumulated so far.\n            return actions\n\n        # Find the closest primitive location using Manhattan distance\n        min_dist = float('inf')\n        closest_target_loc = None\n        for target_x, target_y in primitive_locations:\n            dist = abs(target_x - current_pos[0]) + abs(target_y - current_pos[1])\n            if dist < min_dist:\n                min_dist = dist\n                closest_target_loc = (target_x, target_y)\n\n        # This should not be None if primitive_locations was not empty\n        if closest_target_loc is None:\n            return actions \n\n        target_x, target_y = closest_target_loc\n        dx = target_x - current_pos[0]\n        dy = target_y - current_pos[1]\n\n        chosen_action = -1\n        \n        # Determine preferred movement actions based on distance to target\n        # Prioritize moving along the axis with the larger absolute difference.\n        # If differences are equal, prioritize moving horizontally (x-axis) first (arbitrary tie-breaker).\n        potential_moves_preferred = []\n        if abs(dx) >= abs(dy) and dx != 0:\n            potential_moves_preferred.append(3 if dx > 0 else 2) # RIGHT (3) or LEFT (2)\n        if abs(dy) > 0:\n            # Append Y-axis move; it will be tried after X-axis move if both are preferred and present.\n            potential_moves_preferred.append(0 if dy > 0 else 1) # DOWN (0) or UP (1)\n\n        # Try preferred moves, checking for obstacles\n        for action_code in potential_moves_preferred:\n            mdx, mdy = move_deltas[action_code]\n            next_x, next_y = current_pos[0] + mdx, current_pos[1] + mdy\n            if not _is_blocked(next_x, next_y, grid, env.non_grabbable_indices, env.workshop_indices):\n                chosen_action = action_code\n                break # Found a valid, preferred move\n\n        # If no preferred move was found (e.g., all preferred paths are blocked),\n        # try any valid movement action to potentially move around obstacles.\n        # This acts as a simple recovery strategy from local minima.\n        if chosen_action == -1:\n            for action_code in range(4): # Iterate through all 4 directional moves (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT)\n                # Don't re-check actions already tried in `potential_moves_preferred` unless needed.\n                # However, for simplicity, checking all available (0-3) is fine, as _is_blocked is cheap.\n                mdx, mdy = move_deltas[action_code]\n                next_x, next_y = current_pos[0] + mdx, current_pos[1] + mdy\n                if not _is_blocked(next_x, next_y, grid, env.non_grabbable_indices, env.workshop_indices):\n                    chosen_action = action_code\n                    break # Found *any* valid move\n\n        if chosen_action == -1:\n            # All surrounding movement directions are blocked. Cannot move or reach primitive.\n            # Return actions so far.\n            return actions\n\n        # Apply the chosen action\n        actions.append(chosen_action)\n        _, done, _ = env.step(chosen_action)\n        if done:\n            # If the environment signals done, stop collecting.\n            return actions\n\n    # If MAX_COLLECT_STEPS is reached and the primitive is not collected,\n    # return the actions accumulated so far.\n    return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:31:50.953527", "function_name": "collect", "function_body": "    # Get current state from the environment\n    current_state = env._current_state\n    grid = current_state.grid\n    current_pos = current_state.pos\n    world = current_state.world # This is the CraftWorld instance\n\n    # Get action mappings (integer IDs for actions)\n    action_map = env.action_specs()\n    \n    # Define movement and use actions\n    # (dr, dc, action_id) tuples for BFS exploration\n    MOVE_ACTIONS = [\n        (-1, 0, action_map['UP']),    # Move Up\n        (1, 0, action_map['DOWN']),   # Move Down\n        (0, -1, action_map['LEFT']),  # Move Left\n        (0, 1, action_map['RIGHT'])   # Move Right\n    ]\n    USE_ACTION = action_map['USE']\n\n    # Get grid dimensions\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # Find all locations of the primitive on the grid.\n    # These are the *target* cells we need to be adjacent to for the USE action.\n    primitive_locations = []\n    for r in range(WIDTH):\n        for c in range(HEIGHT):\n            # Check if this cell contains the desired primitive\n            if grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the map, no actions possible\n\n    # BFS to find the shortest path to a cell adjacent to any primitive location\n    # Queue stores (current_position_tuple, list_of_actions_taken_to_reach_here)\n    queue = collections.deque([(current_pos, [])]) \n    visited = {current_pos} # Set of visited (r, c) positions to avoid cycles and redundant paths\n\n    while queue:\n        (r, c), path = queue.popleft()\n\n        # Check if the current cell (r, c) is adjacent to any primitive location.\n        # If it is, we've found the shortest path to a suitable position for a USE action.\n        is_adjacent_to_primitive = False\n        for pr, pc in primitive_locations:\n            # Manhattan distance of 1 implies adjacency (cardinal directions)\n            if abs(r - pr) + abs(c - pc) == 1:\n                is_adjacent_to_primitive = True\n                break\n        \n        if is_adjacent_to_primitive:\n            # We found the shortest path to an adjacent cell, append the USE action and return.\n            return path + [USE_ACTION]\n\n        # Explore neighbors (Up, Down, Left, Right)\n        for dr, dc, action_id in MOVE_ACTIONS:\n            nr, nc = r + dr, c + dc # New potential position\n\n            # 1. Check if the new position is within grid boundaries\n            if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n                continue\n\n            # 2. Check if this position has already been visited in this BFS\n            if (nr, nc) in visited:\n                continue\n\n            # 3. Check if the new position is an obstacle\n            # An obstacle is a cell that cannot be moved into.\n            # This includes:\n            #   a) Water (world.water_index)\n            #   b) The target primitive itself (as we need to be adjacent to it, not on top of it)\n            #   c) Any other non-grabbable entity (like a workshop, forge, etc. that blocks movement)\n            \n            is_obstacle = False\n            \n            # Check for water\n            if grid[nr, nc, world.water_index] > 0:\n                is_obstacle = True\n            # Check if it's the target primitive itself (we want to be adjacent, not in its cell)\n            elif grid[nr, nc, primitive] > 0:\n                is_obstacle = True\n            else:\n                # Check for other non-grabbable entities at (nr, nc)\n                for k_idx in world.non_grabbable_indices:\n                    # Skip checking water again if it's also in non_grabbable_indices,\n                    # and skip checking the primitive itself as it's handled above.\n                    if k_idx == world.water_index or k_idx == primitive:\n                        continue \n                    # If this cell contains another non-grabbable item, it's an obstacle\n                    if grid[nr, nc, k_idx] > 0:\n                        is_obstacle = True\n                        break\n            \n            if is_obstacle:\n                continue # Cannot move to this obstacle cell\n\n            # If the cell is valid, unvisited, and not an obstacle, add it to the queue\n            visited.add((nr, nc))\n            queue.append(((nr, nc), path + [action_id]))\n\n    # If the BFS completes and the queue becomes empty without finding a path to an adjacent cell,\n    # it means the primitive is unreachable from the agent's current position (e.g., disconnected map).\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:31:52.000927", "function_name": "collect", "function_body": "  # Constants for actions and movement (defined inside to comply with \"Do not imports\")\n  UP_ACTION = 0\n  DOWN_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Map action to (delta_row, delta_col)\n  MOVE_DELTAS = {\n      UP_ACTION: (-1, 0),   # North\n      DOWN_ACTION: (1, 0),    # South\n      LEFT_ACTION: (0, -1),   # West\n      RIGHT_ACTION: (0, 1),   # East\n  }\n\n  # Map action to the new direction agent faces after moving\n  # 0: North, 1: East, 2: South, 3: West (DMLab standard)\n  MOVE_NEW_DIRS = {\n      UP_ACTION: 0,\n      RIGHT_ACTION: 1,\n      DOWN_ACTION: 2,\n      LEFT_ACTION: 3,\n  }\n\n  # Map direction (int) to (delta_row, delta_col) for the cell it faces\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # North\n      1: (0, 1),   # East\n      2: (1, 0),   # South\n      3: (0, -1),  # West\n  }\n\n  # Helper function to check if coordinates are within grid bounds\n  def _is_valid_coord(r, c, grid_h, grid_w):\n    return 0 <= r < grid_h and 0 <= c < grid_w\n\n  # Helper function to check if a cell is walkable\n  def _is_walkable_cell(grid, r, c, non_walkable_indices):\n    for idx in non_walkable_indices:\n      if grid[r, c, idx] > 0:\n        return False\n    return True\n\n  # Helper function to determine the required agent direction to face a target cell\n  def _get_required_dir_to_face(r_from, c_from, r_to, c_to):\n    dr = r_to - r_from\n    dc = c_to - c_from\n    for d, (ddr, ddc) in DIR_TO_DELTA.items():\n      if dr == ddr and dc == ddc:\n        return d\n    return -1 # Should not happen for adjacent cardinal cells\n\n  # Get current state information from the environment\n  current_obs = env.observations()\n  grid = current_obs[\"features_dict\"][\"features_global\"]\n  inventory = current_obs[\"features_dict\"][\"inventory\"]\n  init_pos = current_obs[\"features_dict\"][\"pos\"]\n  init_dir_one_hot = current_obs[\"features_dict\"][\"direction\"]\n\n  # Convert initial position and direction to usable formats\n  init_r, init_c = int(init_pos[0]), int(init_pos[1])\n  init_dir_int = np.argmax(init_dir_one_hot)\n\n  # 1. Check if the primitive is already in the inventory\n  if inventory[primitive] > 0:\n    return []\n\n  # Get grid dimensions\n  grid_h, grid_w, n_kinds = grid.shape\n\n  # 2. Identify non-walkable indices (e.g., walls, water)\n  # Assuming CraftWorld and Cookbook are accessible through the environment's internal state\n  cookbook = env._current_state.world.cookbook\n  # Use .get() with a default to avoid KeyError if 'wall' or 'water' don't exist in index\n  wall_idx = cookbook.index.get(\"wall\", -1) \n  water_idx = cookbook.index.get(\"water\", -1)\n  \n  non_walkable_indices = set()\n  if wall_idx != -1: non_walkable_indices.add(wall_idx)\n  if water_idx != -1: non_walkable_indices.add(water_idx)\n\n  # 3. Find all locations of the primitive on the grid\n  target_locations = []\n  for r in range(grid_h):\n    for c in range(grid_w):\n      if grid[r, c, primitive] > 0:\n        target_locations.append((r, c))\n\n  if not target_locations:\n    # Primitive not found on the map\n    return []\n\n  # 4. Perform Breadth-First Search (BFS) to find a path\n  # Queue stores (row, col, direction, path_taken)\n  q = [(init_r, init_c, init_dir_int, [])]\n  # Visited set stores (row, col, direction) to avoid cycles and redundant paths\n  visited = set([(init_r, init_c, init_dir_int)])\n  \n  q_idx = 0 # Manual queue pointer for list-based queue (to avoid 'collections' import)\n\n  while q_idx < len(q):\n    r, c, d, path = q[q_idx]\n    q_idx += 1\n\n    # Check if the current position is adjacent to any target primitive and facing it\n    for tr, tc in target_locations:\n      dr_to_target = tr - r\n      dc_to_target = tc - c\n\n      # Check for adjacency (Manhattan distance of 1)\n      if abs(dr_to_target) + abs(dc_to_target) == 1:\n        required_dir = _get_required_dir_to_face(r, c, tr, tc)\n        if d == required_dir:\n          # Found a path to be adjacent to the primitive and facing it\n          return path + [USE_ACTION]\n\n    # Explore possible movement actions\n    for action in [UP_ACTION, DOWN_ACTION, LEFT_ACTION, RIGHT_ACTION]:\n      next_r, next_c = r + MOVE_DELTAS[action][0], c + MOVE_DELTAS[action][1]\n      next_d = MOVE_NEW_DIRS[action] # Agent's direction changes to face movement\n\n      # Check if the next state is valid, walkable, and not visited\n      if (_is_valid_coord(next_r, next_c, grid_h, grid_w) and\n          _is_walkable_cell(grid, next_r, next_c, non_walkable_indices) and\n          (next_r, next_c, next_d) not in visited):\n        \n        visited.add((next_r, next_c, next_d))\n        q.append((next_r, next_c, next_d, path + [action]))\n\n  # If the BFS completes without finding a path to the primitive\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:33:22.296921", "function_name": "collect", "function_body": "    import collections\n\n    # Action mappings and constants based on CraftLab.action_specs()\n    # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    ACTION_TO_DR_DC = {\n        0: (1, 0),  # DOWN (delta_row, delta_column)\n        1: (-1, 0), # UP\n        2: (0, -1), # LEFT\n        3: (0, 1)   # RIGHT\n    }\n    # Reverse mapping for DR_DC to action value\n    DR_DC_TO_ACTION = {v: k for k, v in ACTION_TO_DR_DC.items()}\n    USE_ACTION = 4\n\n    # Agent direction mappings from CraftState.dir (assuming 0:DOWN, 1:UP, etc.)\n    DIR_TO_DR_DC = {\n        0: (1, 0),  # DOWN\n        1: (-1, 0), # UP\n        2: (0, -1), # LEFT\n        3: (0, 1)   # RIGHT\n    }\n\n    current_state = env._current_state\n    grid = current_state.grid\n    agent_pos = current_state.pos\n    world = current_state.world\n\n    HEIGHT, WIDTH = grid.shape[:2]\n\n    # Identify non-traversable kinds (e.g., water, stone)\n    blocked_kinds = set()\n    if world.water_index is not None:\n        blocked_kinds.add(world.water_index)\n    if world.stone_index is not None:\n        blocked_kinds.add(world.stone_index)\n    \n    # Find all locations on the grid where the primitive exists\n    primitive_locations = []\n    for r in range(HEIGHT):\n        for c in range(WIDTH):\n            if grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        return [] # Primitive not found anywhere on the grid\n\n    # BFS setup to find the shortest path to a cell adjacent to the primitive\n    # Queue stores (current_position, path_actions_taken_to_reach_here)\n    queue = collections.deque([(agent_pos, [])])\n    visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n    \n    shortest_path_actions = None\n    final_agent_pos = None          # The agent's position at the end of the path\n    primitive_to_face_pos = None    # The position of the primitive to interact with\n\n    # Helper function to check if a grid cell is valid and traversable\n    def is_valid_and_traversable(r, c):\n        if not (0 <= r < HEIGHT and 0 <= c < WIDTH):\n            return False # Outside grid boundaries\n        for b_kind in blocked_kinds:\n            if grid[r, c, b_kind] > 0:\n                return False # Contains a blocked entity\n        return True\n\n    while queue:\n        (r, c), path_actions = queue.popleft()\n\n        # Check if the current position (r, c) is a valid \"target\" position for the agent\n        # A target position is one that is cardinally adjacent to any primitive location\n        cardinal_neighbors_of_curr = [(r+1, c), (r-1, c), (r, c+1), (r, c-1)]\n        \n        found_adjacent_primitive = False\n        for p_r, p_c in primitive_locations:\n            if (p_r, p_c) in cardinal_neighbors_of_curr:\n                shortest_path_actions = path_actions\n                final_agent_pos = (r, c)\n                primitive_to_face_pos = (p_r, p_c)\n                found_adjacent_primitive = True\n                break # Found a primitive that can be reached from this cell\n        \n        if found_adjacent_primitive:\n            break # Path to a suitable adjacent cell found, exit BFS\n\n        # Explore all 4-directional neighbors\n        for action_val in [0, 1, 2, 3]: # DOWN, UP, LEFT, RIGHT\n            dr, dc = ACTION_TO_DR_DC[action_val]\n            next_r, next_c = r + dr, c + dc\n\n            if is_valid_and_traversable(next_r, next_c) and (next_r, next_c) not in visited:\n                visited.add((next_r, next_c))\n                new_path_actions = path_actions + [action_val]\n                queue.append(((next_r, next_c), new_path_actions))\n\n    if shortest_path_actions is None:\n        return [] # No path could be found to any cell adjacent to a primitive\n\n    # Construct the final sequence of actions\n    actions_to_return = list(shortest_path_actions)\n\n    # Determine the required direction the agent needs to face to use the primitive\n    tr, tc = final_agent_pos\n    pr, pc = primitive_to_face_pos\n    dr_to_prim = pr - tr # Relative row difference to primitive\n    dc_to_prim = pc - tc # Relative column difference to primitive\n\n    target_face_action = DR_DC_TO_ACTION.get((dr_to_prim, dc_to_prim))\n\n    # Determine the agent's current facing direction after the movement path\n    current_final_dr_dc = None\n    if actions_to_return:\n        # If there were movements, the last move action determines the final direction\n        current_final_dr_dc = ACTION_TO_DR_DC[actions_to_return[-1]]\n    else:\n        # If no movements were needed (agent started adjacent to primitive),\n        # use the agent's initial direction\n        current_final_dr_dc = DIR_TO_DR_DC[current_state.dir]\n\n    # Add a turning action if the agent is not already facing the primitive\n    if target_face_action is not None and ACTION_TO_DR_DC[target_face_action] != current_final_dr_dc:\n        actions_to_return.append(target_face_action)\n\n    # Add the USE action to collect the primitive\n    actions_to_return.append(USE_ACTION)\n\n    return actions_to_return", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:33:23.258700", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Constants mapping action IDs to their effect on position and resulting direction.\n  # Directions are integers: NORTH=0, EAST=1, SOUTH=2, WEST=3.\n  # CraftLab actions (integers): DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4.\n  ACTION_MOVES = {\n      0: ((0, 1), 2),  # DOWN action: moves (0,1), agent faces SOUTH (2)\n      1: ((0, -1), 0), # UP action: moves (0,-1), agent faces NORTH (0)\n      2: ((-1, 0), 3), # LEFT action: moves (-1,0), agent faces WEST (3)\n      3: ((1, 0), 1)   # RIGHT action: moves (1,0), agent faces EAST (1)\n  }\n  USE = 4 # The action ID for USE\n\n  # Mapping direction IDs to (dx, dy) for checking the cell in front of the agent.\n  DIR_TO_DELT = {\n      0: (0, -1),  # NORTH: (dx, dy) to look north\n      1: (1, 0),   # EAST\n      2: (0, 1),   # SOUTH\n      3: (-1, 0)   # WEST\n  }\n\n  state = env._current_state\n  grid = state.grid\n  world = state.world\n  start_pos = state.pos\n  start_dir = state.dir\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Helper function to determine if a given position is traversable.\n  # A position is considered traversable if it's within bounds and\n  # does not contain any non-grabbable obstacle as defined by the CraftWorld.\n  def _is_traversable(pos, current_grid, craft_world):\n      x, y = pos\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return False # Out of bounds\n      \n      # Check if the cell contains any entity from the non_grabbable_indices set.\n      # These typically represent walls, workshops, or other immovable obstacles.\n      for idx in craft_world.non_grabbable_indices:\n          if current_grid[x, y, idx] > 0:\n              return False # Contains a blocking obstacle\n      return True # Otherwise, it's traversable (empty or has grabbable item)\n\n  # Initialize BFS queue with the starting state: ((position, direction), list_of_actions_taken)\n  q = deque([((start_pos, start_dir), [])])\n  # Initialize set to keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (position, direction).\n  visited = {((start_pos), start_dir)}\n\n  while q:\n      ((curr_x, curr_y), curr_dir), path_actions = q.popleft()\n\n      # Check if the primitive is directly in front of the agent at the current state.\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dx, front_dy = DIR_TO_DELT[curr_dir]\n      target_x, target_y = curr_x + front_dx, curr_y + front_dy\n\n      # Check if the cell in front is within bounds and contains the desired primitive.\n      if (0 <= target_x < WIDTH and 0 <= target_y < HEIGHT and\n          grid[target_x, target_y, primitive] > 0):\n          # If found, this path leads to a position where USE can be applied.\n          return path_actions + [USE]\n\n      # Explore possible movement actions (UP, DOWN, LEFT, RIGHT) from the current state.\n      for action_val, ((dx, dy), new_dir_after_move) in ACTION_MOVES.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # Only proceed if the next position is traversable.\n          if _is_traversable(next_pos, grid, world):\n              # Construct the next state: ((new_position, new_direction), updated_actions_list)\n              next_state = (next_pos, new_dir_after_move)\n              # If this state has not been visited, add it to the queue and visited set.\n              if next_state not in visited:\n                  visited.add(next_state)\n                  q.append((next_state, path_actions + [action_val]))\n\n  # If the BFS queue becomes empty and the primitive has not been found,\n  # it means the primitive is unreachable from the starting position.\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:34:41.769547", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Maps movement actions to (dx, dy) changes in position.\n  DIRS_VEC = {\n      ACTION_DOWN: (0, 1),  # (dx, dy)\n      ACTION_UP: (0, -1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Maps movement actions to the agent's new facing direction.\n  # (Assuming movement actions also update the agent's direction to face the direction of movement)\n  # Agent directions: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Maps agent direction (int) to (dx, dy) of the cell it faces.\n  DIR_TO_COORDS_CHANGE = {\n      0: (0, -1),  # UP (faces cell above current pos)\n      1: (1, 0),   # RIGHT (faces cell to the right)\n      2: (0, 1),   # DOWN (faces cell below)\n      3: (-1, 0)   # LEFT (faces cell to the left)\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  current_pos = env._current_state.pos\n  current_x, current_y = current_pos\n  current_dir = env._current_state.dir # Agent's current facing direction\n  grid = env.observations()['features_dict']['features_global']\n  grid_width, grid_height, _ = grid.shape\n\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a grid cell is within bounds and not an obstacle.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # Check if the cell is occupied by a non-grabbable item (which acts as an obstacle).\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # 2. Initial check: Is the agent already in a position to collect the primitive?\n  # Calculate coordinates of the cell the agent is currently facing.\n  faced_x, faced_y = current_x + DIR_TO_COORDS_CHANGE[current_dir][0], \\\n                     current_y + DIR_TO_COORDS_CHANGE[current_dir][1]\n\n  # Check if the faced cell is within bounds and contains the primitive.\n  if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n      grid[faced_x, faced_y, primitive] == 1):\n    return [ACTION_USE]\n\n  # 3. BFS for shortest path to collect the primitive.\n  # BFS state: (x, y, agent_direction)\n  # Queue item: (x, y, agent_direction, path_actions)\n  q = collections.deque()\n  visited = set()\n\n  q.append((current_x, current_y, current_dir, []))\n  visited.add((current_x, current_y, current_dir))\n\n  while q:\n    cx, cy, c_dir, c_path = q.popleft()\n\n    # Explore all possible movement actions from the current state\n    for action_name, (dx, dy) in DIRS_VEC.items():\n      nx, ny = cx + dx, cy + dy\n      n_dir = ACTION_TO_DIR[action_name] # New direction after taking this action\n\n      if is_walkable(nx, ny):\n        # Check if, after moving to (nx, ny) and facing n_dir, we can collect the primitive.\n        faced_x, faced_y = nx + DIR_TO_COORDS_CHANGE[n_dir][0], \\\n                           ny + DIR_TO_COORDS_CHANGE[n_dir][1]\n\n        if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n            grid[faced_x, faced_y, primitive] == 1):\n          # Goal reached! Return the path including the move and the USE action.\n          return c_path + [action_name, ACTION_USE]\n\n        # If not a goal state, add to queue for further exploration if not visited\n        if (nx, ny, n_dir) not in visited:\n          visited.add((nx, ny, n_dir))\n          q.append((nx, ny, n_dir, c_path + [action_name]))\n\n  # If the queue is exhausted and no path was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T04:34:42.737046", "function_name": "collect", "function_body": "  import collections\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position)\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y\n      1: (1, 0),   # RIGHT: increases x\n      2: (0, 1),   # DOWN: increases y\n      3: (-1, 0)   # LEFT: decreases x\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Helper function to check if a grid cell is within bounds and not an obstacle.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # Check if the cell is occupied by a non-grabbable item (which acts as an obstacle).\n    for k_idx in env.world.non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # 2. Breadth-First Search (BFS) for shortest path\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n  # current_direction: The direction the agent is facing *after* arriving at (current_x, current_y)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to avoid redundant exploration and cycles.\n  # A state is defined by (x, y, direction) because the agent's direction affects\n  # what it can interact with (via ACTION_USE).\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the primitive is in the cell directly in front of the agent (where USE would apply)\n    target_dx, target_dy = DIR_VEC[curr_dir]\n    target_px, target_py = curr_x + target_dx, curr_y + target_dy\n\n    if (0 <= target_px < grid_width and 0 <= target_py < grid_height and\n        grid[target_px, target_py, primitive] == 1):\n      # Found the primitive in front of the agent at (target_px, target_py)!\n      # This means we've found a path to a position/direction from which the primitive can be collected.\n      # Since BFS finds the shortest path in terms of number of steps, this is the optimal path.\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next movement actions\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Determine the new position and direction after this action\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # Agent faces the direction of its last movement\n\n      # If the next cell is walkable and this (position, direction) state hasn't been visited\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T04:35:59.551085", "function_name": "collect", "function_body": "  import collections\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position)\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y\n      1: (1, 0),   # RIGHT: increases x\n      2: (0, 1),   # DOWN: increases y\n      3: (-1, 0)   # LEFT: decreases x\n  }\n\n  # Improvement for v2: Check if the primitive is already in the inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if env._current_state.inventory[primitive] > 0:\n      return []\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Helper function to check if a grid cell is within bounds and not an obstacle.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # Check if the cell is occupied by a non-grabbable item (which acts as an obstacle).\n    for k_idx in env.world.non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # 2. Breadth-First Search (BFS) for shortest path\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n  # current_direction: The direction the agent is facing *after* arriving at (current_x, current_y)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to avoid redundant exploration and cycles.\n  # A state is defined by (x, y, direction) because the agent's direction affects\n  # what it can interact with (via ACTION_USE).\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the primitive is in the cell directly in front of the agent (where USE would apply)\n    target_dx, target_dy = DIR_VEC[curr_dir]\n    target_px, target_py = curr_x + target_dx, curr_y + target_dy\n\n    if (0 <= target_px < grid_width and 0 <= target_py < grid_height and\n        grid[target_px, target_py, primitive] == 1):\n      # Found the primitive in front of the agent at (target_px, target_py)!\n      # This means we've found a path to a position/direction from which the primitive can be collected.\n      # Since BFS finds the shortest path in terms of number of steps, this is the optimal path.\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next movement actions\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Determine the new position and direction after this action\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # Agent faces the direction of its last movement\n\n      # If the next cell is walkable and this (position, direction) state hasn't been visited\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": -1}}
