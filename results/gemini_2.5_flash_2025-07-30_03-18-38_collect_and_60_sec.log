{"timestamp": "2025-07-30T14:14:59.498818", "function_name": "collect", "function_body": "  # Helper dictionary for action deltas and specific action values\n  # These are defined inside the function to ensure they are available\n  # and scoped correctly without explicit top-level imports or global variables.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  _ACTION_DELTAS = {\n      ACTION_UP: (-1, 0),\n      ACTION_DOWN: (1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1),\n  }\n\n  def _find_primitive_on_grid(grid, primitive_idx):\n    \"\"\"\n    Finds all (row, col) coordinates where the primitive is present on the grid.\n    Assumes numpy is available in the execution environment.\n    \"\"\"\n    coords = np.argwhere(grid[:, :, primitive_idx] > 0)\n    return [tuple(coord) for coord in coords]\n\n  def _is_valid_position(r, c, grid_shape):\n    \"\"\"\n    Checks if a given (row, col) position is within the grid boundaries.\n    \"\"\"\n    rows, cols = grid_shape\n    return 0 <= r < rows and 0 <= c < cols\n\n  # Get the current state from the CraftLab environment.\n  # We access the internal _current_state attribute for direct access to grid and position.\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_shape = grid.shape[:2] # Get (WIDTH, HEIGHT) from (WIDTH, HEIGHT, n_kinds)\n\n  # Find all locations where the target primitive exists on the grid.\n  target_primitive_coords = _find_primitive_on_grid(grid, primitive)\n\n  # If the primitive is not found on the grid, there's nothing to collect.\n  if not target_primitive_coords:\n    return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path to a cell\n  # adjacent to the primitive.\n  # Queue stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  # Assumes collections.deque is available in the execution environment.\n  queue = collections.deque([(start_pos, [])])\n  \n  # Set to keep track of visited positions to avoid infinite loops and redundant work.\n  visited = {start_pos}\n\n  while queue:\n    (r, c), path_actions = queue.popleft()\n\n    # Check if the current position is adjacent (Manhattan distance 1) to any\n    # of the target primitive's locations.\n    is_adjacent_to_primitive = False\n    for tr, tc in target_primitive_coords:\n      if (abs(r - tr) + abs(c - tc) == 1):\n        is_adjacent_to_primitive = True\n        break\n    \n    # If an adjacent position is found, we have successfully navigated to a spot\n    # from which the primitive can be collected.\n    if is_adjacent_to_primitive:\n      # Append the USE action and return the complete sequence of actions.\n      return path_actions + [ACTION_USE]\n\n    # Explore valid neighboring cells for movement.\n    for action_val, (dr, dc) in _ACTION_DELTAS.items():\n      nr, nc = r + dr, c + dc # Calculate the new position\n\n      # Check if the new position is within grid boundaries and has not been visited yet.\n      # This implementation assumes all cells within bounds are traversable.\n      if _is_valid_position(nr, nc, grid_shape) and (nr, nc) not in visited:\n        # Add the new position to the visited set and the queue for further exploration.\n        visited.add((nr, nc))\n        queue.append(((nr, nc), path_actions + [action_val]))\n\n  # If the queue becomes empty and no path to an adjacent cell was found,\n  # it means the primitive is unreachable from the starting position.\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:15:00.506785", "function_name": "collect", "function_body": "  # Get action mappings from the environment's action_specs\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  actions = []\n  # Safety limit to prevent infinite loops, especially if primitive is unreachable\n  max_steps_per_primitive = 500\n\n  # Get the current state of the environment\n  state = env._current_state\n\n  step_count = 0\n  while state.inventory[primitive] == 0 and step_count < max_steps_per_primitive:\n    step_count += 1\n    current_pos = state.pos\n    current_dir = state.dir # Agent directions: 0:Right, 1:Up, 2:Left, 3:Down\n\n    action_to_take = None\n\n    # 1. Check if primitive is in the 3x3 neighborhood (including self for next_to)\n    # and use the 'USE' action to pick it up or interact.\n    if state.next_to(primitive):\n      action_to_take = ACTION_USE\n    else:\n      # 2. Primitive is not next to agent, so find its location on the global grid.\n      # state.grid has shape (WIDTH, HEIGHT, n_kinds)\n      # np.argwhere returns (row, col) which maps to (x, y) if WIDTH is along rows and HEIGHT along columns\n      primitive_coords = np.argwhere(state.grid[:, :, primitive] > 0)\n\n      if len(primitive_coords) > 0:\n        # If multiple instances, find the closest one using Manhattan distance\n        distances = np.sum(np.abs(primitive_coords - np.array(current_pos)), axis=1)\n        closest_idx = np.argmin(distances)\n        target_x, target_y = primitive_coords[closest_idx]\n\n        # Calculate relative position of the target\n        dx = target_x - current_pos[0]\n        dy = target_y - current_pos[1]\n\n        # Determine the desired cardinal direction to move\n        desired_dir = -1 # Initialize with an invalid direction\n\n        if dx != 0: # Target is horizontally offset\n          if dx > 0: desired_dir = 0 # Right\n          else: desired_dir = 2 # Left\n        elif dy != 0: # Target is vertically offset (and dx is 0)\n          if dy > 0: desired_dir = 3 # Down\n          else: desired_dir = 1 # Up\n        # If dx == 0 and dy == 0, agent is at target's position.\n        # This case implies the primitive is under the agent.\n        # As `next_to` didn't catch it, `USE` likely wouldn't work without moving.\n        # For this version, we'll simply try to move/turn to resolve.\n        else: # dx == 0 and dy == 0, agent is at target (x,y)\n            action_to_take = ACTION_RIGHT # Move to break out of this state\n            # Perform action and continue to next loop iteration\n            _, _, _ = env.step(action_to_take)\n            actions.append(action_to_take)\n            state = env._current_state\n            continue # Skip remaining logic and go to next loop iteration\n\n        # If a desired direction was successfully determined (i.e., not at target's exact spot)\n        if desired_dir != -1:\n          if current_dir == desired_dir:\n            # Agent is already facing the desired direction, so move\n            if desired_dir == 0: action_to_take = ACTION_RIGHT\n            elif desired_dir == 1: action_to_take = ACTION_UP\n            elif desired_dir == 2: action_to_take = ACTION_LEFT\n            elif desired_dir == 3: action_to_take = ACTION_DOWN\n          else:\n            # Agent is not facing the desired direction, so turn\n            # Calculate the shortest turn (clockwise or counter-clockwise)\n            # Directions: R=0, U=1, L=2, D=3\n            diff = desired_dir - current_dir\n            if diff == 1 or diff == -3: # e.g., current R (0), desired U (1) -> diff=1. Need to turn LEFT.\n                                        # e.g., current D (3), desired R (0) -> diff=-3. Need to turn LEFT.\n              action_to_take = ACTION_LEFT\n            elif diff == -1 or diff == 3: # e.g., current R (0), desired D (3) -> diff=-3. Need to turn RIGHT.\n                                          # e.g., current U (1), desired R (0) -> diff=-1. Need to turn RIGHT.\n              action_to_take = ACTION_RIGHT\n            else: # diff == 2 or -2 (180 degree turn)\n              action_to_take = ACTION_RIGHT # Arbitrarily choose RIGHT for 180 deg turn\n      else:\n        # Primitive not found on the grid at all (not spawned, or already collected somehow).\n        # Implement a simple exploration strategy: just try moving right or turning right.\n        action_to_take = ACTION_RIGHT # Default exploration action\n\n    # Fallback: if no specific action was determined (should not happen often)\n    if action_to_take is None:\n      action_to_take = ACTION_RIGHT\n\n    # Perform the chosen action and update the environment state\n    _, _, _ = env.step(action_to_take) # Reward, done, and observations are not directly used in this function\n    actions.append(action_to_take)\n    state = env._current_state # Update the state for the next iteration\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:15:49.642723", "function_name": "collect", "function_body": "  import collections\n\n  # Constants for actions\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement action to the direction it results in for the agent's facing (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  # When the agent moves, it also turns to face the direction of movement.\n  ACTION_TO_RESULTING_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map agent's direction integer to its (dx, dy) vector (change in position)\n  # This vector also identifies the cell directly in front of the agent when facing that direction.\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y-coordinate\n      1: (1, 0),   # RIGHT: increases x-coordinate\n      2: (0, 1),   # DOWN: increases y-coordinate\n      3: (-1, 0)   # LEFT: decreases x-coordinate\n  }\n\n  # Initial check: If the primitive item is not designated as \"grabbable\",\n  # then it cannot be collected by the agent. Return an empty path.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Retrieve the current state information from the environment.\n  # This includes the agent's initial position, direction, and the grid layout.\n  current_state = env._current_state\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = current_state.grid # The full allocentric grid layout\n  grid_width, grid_height, _ = grid.shape\n\n  # Get the set of indices for entities that block agent movement (e.g., walls, water, workshops).\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def _is_traversable(x: int, y: int) -> bool:\n    \"\"\"\n    Helper function to check if a given grid cell (x, y) is within bounds\n    and does not contain any non-grabbable obstacles.\n    \"\"\"\n    # First, verify if the coordinates are within the grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Next, check if the cell contains any entity that is designated as non-grabbable.\n    # If it does, the cell is blocked and cannot be traversed.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1: # If this cell contains a non-grabbable item\n        return False\n    return True # The cell is traversable\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue will store states as (current_x, current_y, current_direction).\n  queue = collections.deque([(start_x, start_y, start_dir)])\n\n  # The 'visited' set keeps track of all (x, y, direction) states already explored\n  # to prevent cycles and redundant path computations, ensuring the shortest path.\n  visited = set([(start_x, start_y, start_dir)])\n\n  # The 'parent_info' dictionary is used to reconstruct the path once the goal is found.\n  # It maps a `(child_state)` to `(parent_state, action_taken_from_parent_to_reach_child)`.\n  parent_info = {}\n\n  # This variable will store the state (x, y, dir) from which the 'USE' action can be taken\n  # to collect the primitive. It's set once the goal is found during BFS.\n  goal_state_pre_use = None\n\n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft() # Dequeue the current state to explore\n\n    # --- Goal Check ---\n    # Determine the coordinates of the cell directly in front of the agent.\n    faced_dx, faced_dy = DIR_VEC[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # If the cell in front is within grid boundaries AND contains the target primitive:\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # The primitive is reachable with a 'USE' action from the current position and direction.\n      goal_state_pre_use = (curr_x, curr_y, curr_dir)\n      break # Goal found, terminate BFS\n\n    # --- Explore Possible Movement Actions ---\n    # Iterate through all four cardinal movement actions (UP, RIGHT, DOWN, LEFT).\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new facing direction and movement vector based on the action.\n      new_facing_dir = ACTION_TO_RESULTING_DIR[action]\n      move_dx, move_dy = DIR_VEC[new_facing_dir]\n      \n      # Calculate the next position after performing this movement action.\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_state_tuple = (next_x, next_y, new_facing_dir)\n\n      # If the next cell is traversable AND this new (position, direction) state\n      # has not been visited yet:\n      if _is_traversable(next_x, next_y) and next_state_tuple not in visited:\n        visited.add(next_state_tuple) # Mark the new state as visited\n        # Store how we reached this state for path reconstruction.\n        parent_info[next_state_tuple] = ((curr_x, curr_y, curr_dir), action)\n        queue.append(next_state_tuple) # Enqueue the new state for further exploration\n\n  # If the BFS completed without finding a path to collect the primitive,\n  # 'goal_state_pre_use' will still be None. In this case, return an empty list.\n  if goal_state_pre_use is None:\n    return []\n\n  # --- Path Reconstruction ---\n  # Start reconstructing the path by adding the final 'USE' action.\n  # Use a deque for efficient prepending of actions during reconstruction.\n  actions_path = collections.deque([ACTION_USE]) \n\n  # Begin backtracking from the state identified as just before the 'USE' action.\n  current_state_in_path = goal_state_pre_use\n  start_state_tuple = (start_x, start_y, start_dir)\n\n  # Continue backtracking until the initial starting state is reached.\n  while current_state_in_path != start_state_tuple:\n    # Retrieve the parent state and the action that was taken from the parent\n    # to arrive at 'current_state_in_path'.\n    parent_state, action_from_parent = parent_info[current_state_in_path]\n    actions_path.appendleft(action_from_parent) # Prepend this action to the path\n    current_state_in_path = parent_state # Move to the parent state\n\n  # Convert the deque to a list for return type consistency.\n  return list(actions_path)", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:15:50.616718", "function_name": "collect", "function_body": "  import collections\n\n  # Define constants for actions\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Maps movement actions to the agent's resulting facing direction.\n  # When the agent moves, it automatically aligns its direction with the movement.\n  # Directions: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n  ACTION_TO_DIRECTION_MAP = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Maps agent's facing direction (0-3) to a corresponding (dx, dy) vector.\n  # This vector represents the change in coordinates when moving one step\n  # in that direction, or the coordinates of the cell directly in front.\n  DIRECTION_TO_VECTOR = {\n      0: (0, -1),  # UP (decreases y-coordinate)\n      1: (1, 0),   # RIGHT (increases x-coordinate)\n      2: (0, 1),   # DOWN (increases y-coordinate)\n      3: (-1, 0)   # LEFT (decreases x-coordinate)\n  }\n\n  # --- Pre-computation and Initial Checks ---\n  # If the primitive is not designated as \"grabbable\" (e.g., water, workshops),\n  # it means the agent cannot pick it up. In such cases, no path exists.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Retrieve the current state of the environment.\n  # This includes the grid layout, agent's position, and facing direction.\n  current_state = env._current_state\n  start_pos = current_state.pos # Tuple (x, y)\n  start_dir = current_state.dir # Integer (0, 1, 2, or 3)\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Identify entities that block agent movement (e.g., walls, water, crafting stations).\n  # These are entities the agent cannot traverse through.\n  non_traversable_kinds = env.world.non_grabbable_indices\n\n  def _is_valid_and_traversable(x: int, y: int) -> bool:\n    \"\"\"\n    Checks if a given grid cell (x, y) is within bounds and does not contain\n    any obstacles that prevent the agent from moving onto it.\n    \"\"\"\n    # 1. Check if the coordinates are within the grid's boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # 2. Check if the cell contains any non-traversable item.\n    # The grid uses a one-hot encoding for entities in each cell.\n    for kind_idx in non_traversable_kinds:\n      if grid[x, y, kind_idx] == 1: # If this cell has a non-traversable item\n        return False # The cell is blocked\n    return True # The cell is valid and traversable\n\n  # --- Breadth-First Search (BFS) Initialization ---\n  # BFS explores the shortest path on an unweighted graph.\n  # A state in our graph is defined by (agent_x, agent_y, agent_direction).\n  \n  # The queue for BFS stores states to be explored.\n  # It's a deque for efficient appending and popping from the left.\n  queue = collections.deque([(start_pos[0], start_pos[1], start_dir)])\n\n  # The 'visited' set keeps track of all states (position, direction) that\n  # have already been added to the queue or fully processed, preventing cycles\n  # and redundant work, guaranteeing the shortest path.\n  visited = set([(start_pos[0], start_pos[1], start_dir)])\n\n  # The 'path_tracker' dictionary is crucial for reconstructing the path.\n  # It maps a `(child_state)` to `(parent_state, action_taken_from_parent)`.\n  path_tracker = {}\n\n  # This variable will store the state (x, y, dir) from which the agent can\n  # successfully perform a 'USE' action to collect the target primitive.\n  final_pre_use_state = None\n\n  # --- BFS Main Loop ---\n  while queue:\n    current_x, current_y, current_dir = queue.popleft() # Get the next state to explore\n\n    # --- Goal Check: Can we collect the primitive from the current state? ---\n    # The 'USE' action targets the cell directly in front of the agent.\n    dx_facing, dy_facing = DIRECTION_TO_VECTOR[current_dir]\n    target_x, target_y = current_x + dx_facing, current_y + dy_facing\n\n    # Check if the target cell is within bounds AND contains the primitive.\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive] == 1):\n      # Goal found! Store this state as the one immediately preceding the 'USE' action.\n      final_pre_use_state = (current_x, current_y, current_dir)\n      break # Terminate BFS as the shortest path to the goal is found.\n\n    # --- Explore Movement Actions from Current State ---\n    # Consider all four cardinal movement actions.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Determine the new facing direction and the movement vector for this action.\n      # When moving, the agent's direction aligns with the movement.\n      next_dir = ACTION_TO_DIRECTION_MAP[action]\n      move_dx, move_dy = DIRECTION_TO_VECTOR[next_dir]\n      \n      # Calculate the agent's next position.\n      next_x, next_y = current_x + move_dx, current_y + move_dy\n      next_state_tuple = (next_x, next_y, next_dir)\n\n      # If the potential next cell is valid and traversable AND this new\n      # (position, direction) state has not been visited yet:\n      if _is_valid_and_traversable(next_x, next_y) and next_state_tuple not in visited:\n        visited.add(next_state_tuple) # Mark the new state as visited\n        # Record how we reached this new state (parent state and action).\n        path_tracker[next_state_tuple] = ((current_x, current_y, current_dir), action)\n        queue.append(next_state_tuple) # Add the new state to the queue for future exploration\n\n  # --- Path Reconstruction ---\n  # If `final_pre_use_state` is still None after BFS, it means no path was found.\n  if final_pre_use_state is None:\n    return []\n\n  # The path starts with the final 'USE' action.\n  actions_sequence = [ACTION_USE]\n\n  # Backtrack from the `final_pre_use_state` all the way to the `start_state`.\n  current_path_state = final_pre_use_state\n  start_state_tuple = (start_pos[0], start_pos[1], start_dir)\n\n  while current_path_state != start_state_tuple:\n    # Get the parent state and the action that led from parent to current.\n    parent_state, action_from_parent = path_tracker[current_path_state]\n    # Prepend the action to the sequence (because we're building it backwards).\n    actions_sequence.insert(0, action_from_parent)\n    # Move to the parent state for the next iteration.\n    current_path_state = parent_state\n\n  return actions_sequence", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:17:18.529476", "function_name": "collect", "function_body": "  actions = []\n\n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n\n  # Ensure position is int tuple. CraftState.pos is tuple(int, int)\n  current_pos = tuple(obs['features_dict']['pos'].astype(int))\n\n  # Current direction is a one-hot array, convert to an integer (0=N, 1=E, 2=S, 3=W)\n  current_dir_one_hot = obs['features_dict']['direction']\n  current_dir = np.argmax(current_dir_one_hot)\n\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n  grabbable_indices = world.grabbable_indices\n\n  W, H, K = grid.shape\n\n  # Action constants (assuming these are defined globally or are standard for the env)\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Map movement action values to (dx, dy) deltas\n  MOVEMENT_DELTAS = {\n      UP_ACTION: (0, -1),   # (dx, dy) for moving UP (North)\n      DOWN_ACTION: (0, 1),  # (dx, dy) for moving DOWN (South)\n      LEFT_ACTION: (-1, 0), # (dx, dy) for moving LEFT (West)\n      RIGHT_ACTION: (1, 0), # (dx, dy) for moving RIGHT (East)\n  }\n\n  # Map movement action values to the resulting agent direction (0=N, 1=E, 2=S, 3=W)\n  # This assumes that taking a movement action makes the agent face that direction.\n  ACTION_TO_DIRECTION = {\n      UP_ACTION: 0,    # UP action results in facing North\n      RIGHT_ACTION: 1, # RIGHT action results in facing East\n      DOWN_ACTION: 2,  # DOWN action results in facing South\n      LEFT_ACTION: 3,  # LEFT action results in facing West\n  }\n\n  # Map (dx, dy) from agent's position to target cell to the required agent direction\n  # This is for when the agent needs to face a specific adjacent cell to USE it.\n  RELATIVE_TARGET_POS_TO_DIRECTION = {\n      (0, -1): 0, # Target is UP relative to agent -> agent must face North\n      (1, 0): 1,  # Target is RIGHT relative to agent -> agent must face East\n      (0, 1): 2,  # Target is DOWN relative to agent -> agent must face South\n      (-1, 0): 3, # Target is LEFT relative to agent -> agent must face West\n  }\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  is_obstacle_kind = np.isin(np.arange(K), list(non_grabbable_indices))\n  # A cell has an obstacle if any of its layers correspond to an obstacle kind and have content > 0.\n  has_obstacle = (grid[:, :, is_obstacle_kind] > 0).any(axis=-1)\n  traversable_mask = ~has_obstacle\n\n  # Ensure the agent's current position is traversable.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] # Agent starts on an untraversable cell, no path possible.\n\n  # 2. Determine target collection states based on the primitive type.\n  # A target state is ((x, y), required_dir) representing the agent's position and\n  # facing direction from which it can successfully collect the primitive using USE.\n  # We also need to know the 'source_kind' (the entity on the grid) and 'interaction_type'\n  # ('on_cell' means agent stands on it, 'adjacent_facing' means agent stands next to it and faces it).\n  \n  # Set of (source_kind_idx, interaction_type) that can yield the 'primitive'\n  target_source_kinds_and_interactions = set()\n\n  # Case A: The 'primitive' itself is a grabbable item that can be found directly on the grid.\n  # If found, the agent needs to stand on the same cell and USE.\n  if primitive in grabbable_indices:\n      target_source_kinds_and_interactions.add((primitive, 'on_cell'))\n\n  # Case B: The 'primitive' is produced by a specific source block (e.g., water item from water block).\n  # The agent needs to stand adjacent to this source block and face it.\n  primitive_name = world.cookbook.index.get(primitive) # Get the string name of the primitive item\n  if primitive_name == 'water':\n      # `world.water_index` is the grid entity for a water source block\n      target_source_kinds_and_interactions.add((world.water_index, 'adjacent_facing'))\n  elif primitive_name == 'stone':\n      # `world.stone_index` is the grid entity for a stone source block\n      target_source_kinds_and_interactions.add((world.stone_index, 'adjacent_facing'))\n  # Add more such mappings if other primitives are known to come from specific blocks.\n\n  if not target_source_kinds_and_interactions:\n      return [] # No known way to collect this primitive\n\n  # 3. Perform BFS to find the shortest sequence of actions\n  from collections import deque\n  q = deque([(current_pos, current_dir, [])]) # (current_pos, current_dir, path_actions_so_far)\n  visited = {(current_pos, current_dir)} # Visited set: (pos, dir) to avoid cycles\n\n  while q:\n      curr_pos, curr_dir, path_so_far = q.popleft()\n      curr_x, curr_y = curr_pos\n\n      # Check if the current state satisfies any of our target collection conditions\n      for source_kind_idx, interaction_type in target_source_kinds_and_interactions:\n          if interaction_type == 'on_cell':\n              # Agent is at (curr_x, curr_y) and needs to pick up source_kind_idx from this cell.\n              if grid[curr_x, curr_y, source_kind_idx] > 0:\n                  return path_so_far + [USE_ACTION]\n          elif interaction_type == 'adjacent_facing':\n              # Agent is at (curr_x, curr_y) and needs to USE the cell it's facing for source_kind_idx.\n              # Calculate the coordinates of the cell directly in front of the agent.\n              # Note: DIRECTION_TO_DELTA gives (dx,dy) for the cell that would be in front based on a direction.\n              # To get the delta for the cell in front, we use the agent's current facing direction.\n              front_dx, front_dy = MOVEMENT_DELTAS[ACTION_TO_DIRECTION[curr_dir] if curr_dir in ACTION_TO_DIRECTION else 0] # Default to UP (0) if dir not in ACTION_TO_DIRECTION mapping (unlikely)\n              \n              # Re-map curr_dir (0,1,2,3) to (dx,dy) for the cell in front.\n              # This mapping is already done in `collect_v0` and is more direct.\n              # 0:N(UP)=(0,-1), 1:E(RIGHT)=(1,0), 2:S(DOWN)=(0,1), 3:W(LEFT)=(-1,0)\n              face_dx, face_dy = (0, -1) if curr_dir == 0 else \\\n                                 (1, 0) if curr_dir == 1 else \\\n                                 (0, 1) if curr_dir == 2 else \\\n                                 (-1, 0) # curr_dir == 3\n              \n              target_x, target_y = curr_x + face_dx, curr_y + face_dy\n\n              # Check if the cell in front is within bounds AND contains the source_kind_idx.\n              if (0 <= target_x < W and 0 <= target_y < H and\n                  grid[target_x, target_y, source_kind_idx] > 0):\n                  return path_so_far + [USE_ACTION]\n\n      # Explore possible next states by taking movement actions (UP, DOWN, LEFT, RIGHT).\n      for action_val, (dx, dy) in MOVEMENT_DELTAS.items():\n          potential_next_dir = ACTION_TO_DIRECTION[action_val]\n          next_x, next_y = curr_x + dx, curr_y + dy\n\n          # Case 1: Valid movement to a new traversable cell\n          if (0 <= next_x < W and 0 <= next_y < H and\n              traversable_mask[next_x, next_y]):\n              next_pos = (next_x, next_y)\n              next_dir = potential_next_dir\n              if (next_pos, next_dir) not in visited:\n                  visited.add((next_pos, next_dir))\n                  q.append((next_pos, next_dir, path_so_far + [action_val]))\n          # Case 2: Blocked movement, agent stays in place but might change direction\n          else:\n              next_pos = curr_pos # Agent does not move\n              next_dir = potential_next_dir # Agent changes direction\n              if (next_pos, next_dir) not in visited:\n                  visited.add((next_pos, next_dir))\n                  q.append((next_pos, next_dir, path_so_far + [action_val]))\n\n  return [] # No path found to a collection spot", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:17:19.527213", "function_name": "collect", "function_body": "  # Constants for actions (from problem description context)\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Map agent direction (0:North/Up, 1:East/Right, 2:South/Down, 3:West/Left) to (dx, dy) delta\n  # for the cell *in front* of the agent (where USE applies, and also the direction of movement)\n  DIRECTION_TO_DELTA = {\n      0: (0, -1),  # Facing North (Up): Cell in front is (x, y-1)\n      1: (1, 0),   # Facing East (Right): Cell in front is (x+1, y)\n      2: (0, 1),   # Facing South (Down): Cell in front is (x, y+1)\n      3: (-1, 0)   # Facing West (Left): Cell in front is (x-1, y)\n  }\n\n  # Map movement action to the direction the agent faces *after* taking that action\n  # (assuming agent faces the direction it just moved/attempted to move)\n  ACTION_TO_RESULTANT_DIRECTION = {\n      UP_ACTION: 0,    # Action UP results in facing North\n      RIGHT_ACTION: 1, # Action RIGHT results in facing East\n      DOWN_ACTION: 2,  # Action DOWN results in facing South\n      LEFT_ACTION: 3   # Action LEFT results in facing West\n  }\n\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  current_pos = (current_pos_x, current_pos_y)\n  initial_dir = np.argmax(obs['features_dict']['direction'])\n\n  world = env.world\n  \n  W, H, K = grid.shape # Grid dimensions: Width, Height, Number of kinds\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  is_obstacle_kind = np.zeros(K, dtype=bool)\n  for idx in world.non_grabbable_indices:\n      if 0 <= idx < K: # Ensure index is within grid kind bounds\n          is_obstacle_kind[idx] = True\n  \n  # has_obstacle will be True for cells containing any non-grabbable item\n  has_obstacle = (grid[:, :, is_obstacle_kind] > 0).any(axis=-1)\n  traversable_mask = ~has_obstacle\n  \n  # If agent starts on an untraversable cell, no path is possible.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return []\n\n  # 2. Determine target kinds on the grid that, when USEd while facing, yield the primitive.\n  # This includes the primitive itself (if it exists as a visible grid item) and specific source blocks.\n  use_target_kinds = set()\n  \n  # Always consider the primitive itself as a target to USE on the ground\n  use_target_kinds.add(primitive) \n\n  # Add specific source blocks if the primitive is a resource derived from them\n  primitive_name = world.cookbook.index.get(primitive)\n  if primitive_name == 'water':\n      use_target_kinds.add(world.water_index)\n  elif primitive_name == 'stone':\n      use_target_kinds.add(world.stone_index)\n  # Extend with more mappings here if other primitives have specific source blocks (e.g., 'wood' from a 'tree' block).\n\n  # Filter out any use_target_kinds that are invalid indices for the current grid\n  valid_use_target_kinds = [k for k in use_target_kinds if 0 <= k < K]\n  if not valid_use_target_kinds:\n      return [] # No valid grid item types identified for collection\n\n  # 3. Perform BFS to find the shortest path (sequence of actions)\n  # BFS state: ((pos_x, pos_y), current_facing_direction, list_of_actions_so_far)\n  q = deque([(current_pos, initial_dir, [])])\n\n  # Visited set: ((pos_x, pos_y), current_dir) to prevent revisiting states and cycles.\n  # A state is defined by both position and facing direction, as 'USE' is directional.\n  visited = {(current_pos, initial_dir)}\n\n  while q:\n      (curr_x, curr_y), curr_dir, actions_so_far = q.popleft()\n\n      # Check if the current state allows collection of the primitive via the USE action.\n      # The USE action is assumed to apply to the cell directly in front of the agent.\n      front_dx, front_dy = DIRECTION_TO_DELTA[curr_dir] \n      target_x, target_y = curr_x + front_dx, curr_y + front_dy\n\n      # Check if the cell in front is within grid bounds AND contains any of the target items/sources.\n      if (0 <= target_x < W and 0 <= target_y < H and\n          any(grid[target_x, target_y, k] > 0 for k in valid_use_target_kinds)):\n          # Goal reached: agent is positioned and facing a collectable resource.\n          # Append USE action to the path and return the sequence.\n          return actions_so_far + [USE_ACTION]\n\n      # Explore possible next states by taking movement actions (UP, DOWN, LEFT, RIGHT).\n      for action_val in [UP_ACTION, DOWN_ACTION, LEFT_ACTION, RIGHT_ACTION]:\n          # 1. Agent reorients to the direction implied by the action\n          next_dir = ACTION_TO_RESULTANT_DIRECTION[action_val]\n\n          # 2. Agent attempts to move one step in the new direction\n          move_dx, move_dy = DIRECTION_TO_DELTA[next_dir]\n          attempted_next_x, attempted_next_y = curr_x + move_dx, curr_y + move_dy\n\n          new_pos = (curr_x, curr_y) # Default: assume no movement (blocked)\n          \n          # 3. Check for collision and update position\n          if (0 <= attempted_next_x < W and 0 <= attempted_next_y < H and\n              traversable_mask[attempted_next_x, attempted_next_y]):\n              # Move successful\n              new_pos = (attempted_next_x, attempted_next_y)\n          # Else: new_pos remains (curr_x, curr_y) because movement was blocked.\n          # The agent's direction still changes to `next_dir` (as per environment behavior assumption).\n          \n          next_state_key = (new_pos, next_dir)\n\n          # If this (position, direction) state has not been visited yet, add to queue.\n          if next_state_key not in visited:\n              visited.add(next_state_key)\n              q.append((new_pos, next_dir, actions_so_far + [action_val]))\n\n  # If the queue becomes empty and no solution is found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:18:46.719523", "function_name": "collect", "function_body": "    import collections\n\n    # Action constants (from env.action_specs())\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Check if the primitive is already in the inventory\n    if env._current_state.inventory[primitive] > 0:\n        return []\n\n    start_pos = env._current_state.pos  # Agent's current position (x, y)\n    grid = env._current_state.grid      # Current grid state (HEIGHT, WIDTH, n_kinds)\n    height, width, n_kinds = grid.shape\n\n    # Get non-grabbable indices to identify obstacles in pathfinding\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # Find all locations where the primitive exists on the grid\n    # np.argwhere returns (row_index, col_index), which corresponds to (y, x)\n    primitive_locations_yx = np.argwhere(grid[:, :, primitive] > 0)\n    \n    if len(primitive_locations_yx) == 0:\n        return [] # Primitive not found on the grid\n\n    # Convert primitive locations to (x, y) tuples for consistency with agent_pos\n    primitive_locations_xy = set((loc[1], loc[0]) for loc in primitive_locations_yx)\n\n    # Define possible movement actions and their corresponding (dx, dy) deltas\n    # (dx, dy) represents change in (x, y) coordinates\n    # UP: y decreases -> (0, -1)\n    # DOWN: y increases -> (0, 1)\n    # LEFT: x decreases -> (-1, 0)\n    # RIGHT: x increases -> (1, 0)\n    action_deltas = {\n        DOWN: (0, 1),\n        UP: (0, -1),\n        LEFT: (-1, 0),\n        RIGHT: (1, 0)\n    }\n    \n    # BFS queue: stores tuples of (current_position (x,y), list_of_actions_to_reach_here)\n    queue = collections.deque([(start_pos, [])])\n    \n    # Set to keep track of visited positions to avoid cycles and redundant paths\n    visited = {start_pos}\n\n    while queue:\n        current_pos, current_path = queue.popleft()\n        cx, cy = current_pos\n\n        # Check if the current position is adjacent to or on a primitive location\n        is_target_reached = False\n        \n        for px, py in primitive_locations_xy:\n            manhattan_distance = abs(cx - px) + abs(cy - py)\n            \n            # If the agent is on the primitive's square (distance 0)\n            # or adjacent to it (distance 1), it can attempt to USE.\n            if manhattan_distance <= 1:\n                is_target_reached = True\n                break\n        \n        if is_target_reached:\n            # If the agent is next to or on the primitive, return the path plus a USE action\n            return current_path + [USE]\n\n        # Explore valid neighboring cells\n        for action_val, (dx, dy) in action_deltas.items():\n            nx, ny = cx + dx, cy + dy\n            next_pos = (nx, ny)\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= nx < width and 0 <= ny < height):\n                continue\n\n            # Check if the next position has already been visited\n            if next_pos in visited:\n                continue\n\n            # Check if the next position is blocked by a non-grabbable item\n            # The agent cannot move onto a cell containing any non-grabbable item.\n            is_blocked = False\n            for kind_idx in non_grabbable_indices:\n                # grid is indexed as [y, x, kind]\n                if grid[ny, nx, kind_idx] > 0:\n                    is_blocked = True\n                    break\n            \n            if is_blocked:\n                continue # This cell is an obstacle, cannot move here\n\n            # If the cell is valid and not blocked, add it to the queue\n            visited.add(next_pos)\n            queue.append((next_pos, current_path + [action_val]))\n\n    # If the queue becomes empty and no path to the primitive was found\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:18:47.711410", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Get necessary constants and current state\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  global_grid = features_dict['features_global'] # shape (HEIGHT, WIDTH, N_KINDS)\n\n  # Current pos is a numpy array [normalized_row, normalized_col]. Convert to tuple (int, int).\n  # Assuming features_dict['pos'] is normalized (0-1) and grid dimensions are (rows, cols).\n  HEIGHT, WIDTH, N_KINDS = global_grid.shape\n  current_pos_norm = features_dict['pos']\n  current_pos = (int(current_pos_norm[0] * HEIGHT), int(current_pos_norm[1] * WIDTH))\n\n  current_inventory = features_dict['inventory']\n\n  # Check if primitive is already collected\n  if current_inventory[primitive] > 0:\n      return []\n\n  # Get action mapping (needed for actual actions to return)\n  action_map = env.action_specs()\n  # Reverse map for convenience\n  ACTION_IDS = {v: k for k, v in action_map.items()}\n  UP, DOWN, LEFT, RIGHT, USE = ACTION_IDS['UP'], ACTION_IDS['DOWN'], ACTION_IDS['LEFT'], ACTION_IDS['RIGHT'], ACTION_IDS['USE']\n\n  # Movement deltas for grid traversal (corresponding to absolute UP/DOWN/LEFT/RIGHT actions)\n  MOVE_DELTAS = {\n      UP: (-1, 0),  # North (decreases row)\n      DOWN: (1, 0), # South (increases row)\n      LEFT: (0, -1), # West (decreases col)\n      RIGHT: (0, 1) # East (increases col)\n  }\n\n  # Obstacle indices: entities that cannot be walked through.\n  # The `CraftWorld` class provides `non_grabbable_indices`.\n  blocking_indices = env.world.non_grabbable_indices\n\n  # BFS to find the shortest path to a cell adjacent to the primitive\n  queue = collections.deque()\n  # Each item in the queue is (row, col, path_actions_list)\n  queue.append((current_pos[0], current_pos[1], []))\n  visited = set([(current_pos[0], current_pos[1])]) # Stores (row, col) of visited cells\n\n  target_adjacent_pos = None\n  path_to_adjacent = []\n\n  while queue:\n      r, c, path_so_far = queue.popleft()\n\n      # Check if the current cell (r, c) is adjacent to the primitive\n      # We iterate over possible moves FROM this cell to find if a neighbor contains the primitive.\n      for action_type, (dr, dc) in MOVE_DELTAS.items():\n          nr, nc = r + dr, c + dc\n          if 0 <= nr < HEIGHT and 0 <= nc < WIDTH:\n              # If the neighbor (nr, nc) contains the primitive\n              if global_grid[nr, nc, primitive] == 1:\n                  target_adjacent_pos = (r, c)\n                  path_to_adjacent = path_so_far\n                  break # Found a path to an adjacent cell, exit inner loop\n      if target_adjacent_pos:\n          break # Exit BFS, path found\n\n      # Explore neighbors (movement actions) if a path to target_adjacent_pos hasn't been found yet\n      for action, (dr, dc) in MOVE_DELTAS.items():\n          nr, nc = r + dr, c + dc\n\n          if 0 <= nr < HEIGHT and 0 <= nc < WIDTH and (nr, nc) not in visited:\n              # Check if the potential next cell (nr, nc) contains a blocking item\n              is_blocking = False\n              for kind_idx in blocking_indices:\n                  if global_grid[nr, nc, kind_idx] == 1:\n                      is_blocking = True\n                      break\n              if is_blocking:\n                  continue # Cannot walk through this cell, skip this path\n\n              visited.add((nr, nc))\n              queue.append((nr, nc, path_so_far + [action]))\n\n  if not target_adjacent_pos:\n      # Primitive not found on the grid or is unreachable (e.g., completely surrounded by blocking items)\n      return []\n\n  # The agent has reached `target_adjacent_pos` by following `path_to_adjacent`.\n  # According to the `CraftState.next_to` function, the `USE` action works for any item\n  # in the 3x3 neighborhood. This implies the `USE` action does not depend on the agent's facing direction.\n  # Therefore, after reaching an adjacent cell, simply append the `USE` action.\n  actions = path_to_adjacent + [USE]\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:21:01.847378", "function_name": "collect", "function_body": "  state = env._current_state\n  \n  grid = state.grid\n  current_pos = state.pos\n  current_dir = state.dir # Agent's current facing direction\n\n  # Get information from the world configuration\n  non_grabbable_indices = env.world.non_grabbable_indices\n  actions_map = _get_actions_map(env)\n  \n  # Find the shortest path to an adjacent cell of the primitive\n  path_info = _find_path_to_adjacent(grid, current_pos, primitive, non_grabbable_indices)\n  \n  if path_info is None:\n      # Primitive not found or not reachable\n      return []\n\n  path_coords, final_adjacent_pos, target_item_pos = path_info\n  \n  # Convert the path and final interaction into a sequence of actions\n  action_sequence = _convert_path_to_actions(\n      current_pos, current_dir, path_coords, target_item_pos, actions_map\n  )\n  \n  return action_sequence", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:21:01.916384", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Helper function for BFS pathfinding\n    def _bfs_pathfind(start_pos, target_pos_set, grid, non_grabbable_indices, primitive_idx, width, height):\n        q = collections.deque([(start_pos, [])])\n        visited = {start_pos}\n\n        # Define possible moves and corresponding actions\n        # (dx, dy): action_id (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n        MOVES = {\n            (0, 1): 0,  # Move Y+1 (Down)\n            (0, -1): 1, # Move Y-1 (Up)\n            (-1, 0): 2, # Move X-1 (Left)\n            (1, 0): 3,  # Move X+1 (Right)\n        }\n\n        while q:\n            current_pos, path = q.popleft()\n\n            if current_pos in target_pos_set:\n                return path\n\n            for (dx, dy), action in MOVES.items():\n                next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n                next_pos = (next_x, next_y)\n\n                # Check bounds\n                if not (0 <= next_x < width and 0 <= next_y < height):\n                    continue\n\n                # Check if visited\n                if next_pos in visited:\n                    continue\n\n                # Check for obstacles (non-grabbable items).\n                # The primitive itself is generally grabbable and not an obstacle for movement to an adjacent cell.\n                is_obstacle = False\n                for kind_idx in non_grabbable_indices:\n                    # A cell is an obstacle if it contains any non-grabbable item\n                    # (e.g., wall, water, workshop), regardless of the primitive.\n                    if grid[next_x, next_y, kind_idx] > 0:\n                        is_obstacle = True\n                        break\n                if is_obstacle:\n                    continue\n\n                visited.add(next_pos)\n                q.append((next_pos, path + [action]))\n        \n        return None # No path found\n\n    current_state = env._current_state\n    \n    grid = current_state.grid\n    current_pos = current_state.pos\n    \n    width, height, _ = grid.shape\n\n    # Find all locations of the primitive on the grid\n    primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n    if len(primitive_locations) == 0:\n        return [] # No primitive found in the current state\n\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # Collect all valid target adjacent positions across all primitive instances\n    all_valid_target_adjacent_positions = set()\n    for px, py in primitive_locations:\n        # Candidate adjacent positions (North, South, West, East)\n        candidate_adjacent_positions = [\n            (px, py - 1),  # North\n            (px, py + 1),  # South\n            (px - 1, py),  # West\n            (px + 1, py),  # East\n        ]\n        \n        for tx, ty in candidate_adjacent_positions:\n            # Check if the candidate adjacent position is within grid bounds\n            if not (0 <= tx < width and 0 <= ty < height):\n                continue\n            \n            # Check if the candidate adjacent position is blocked by an unpassable item\n            is_target_cell_blocked = False\n            for kind_idx in non_grabbable_indices:\n                if grid[tx, ty, kind_idx] > 0:\n                    is_target_cell_blocked = True\n                    break\n            if is_target_cell_blocked:\n                continue\n\n            # Ensure the target cell does not contain the primitive itself,\n            # as the agent needs to be adjacent, not on it.\n            if grid[tx, ty, primitive] > 0:\n                continue\n\n            all_valid_target_adjacent_positions.add((tx, ty))\n    \n    if not all_valid_target_adjacent_positions:\n        return [] # No valid adjacent cells found for any primitive instance\n\n    # Perform BFS to find the shortest path to *any* of the valid adjacent cells\n    path_to_adjacent_cell = _bfs_pathfind(\n        start_pos=current_pos,\n        target_pos_set=all_valid_target_adjacent_positions,\n        grid=grid,\n        non_grabbable_indices=non_grabbable_indices,\n        primitive_idx=primitive, # Passed for completeness, but typically primitives are not obstacles\n        width=width,\n        height=height\n    )\n\n    if path_to_adjacent_cell is None:\n        return [] # No path found to any valid adjacent cell\n\n    # Once at the adjacent cell, perform the USE action (action ID 4)\n    return path_to_adjacent_cell + [4]", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:22:01.317798", "function_name": "collect", "function_body": "    actions_taken = []\n    # A generous number of steps to allow exploration.\n    # If the primitive is very far or unreachable, this will eventually stop.\n    max_exploration_steps = 500\n\n    # Get the initial state (from the environment's internal state).\n    # CraftLab's `_current_state` holds the CraftState object.\n    current_state = env._current_state\n\n    # Check if the primitive is already in the inventory.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Define action constants. These align with CraftLab's action_specs.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    for _ in range(max_exploration_steps):\n        # Update current_state with the latest from the environment.\n        # This is crucial because env.step modifies env._current_state.\n        current_state = env._current_state\n\n        # 1. Check if the primitive is in the immediate vicinity (3x3 neighborhood).\n        if current_state.next_to(primitive):\n            # If yes, try to collect it using the USE action.\n            # `_` is used for unused reward/observation variables.\n            reward, done, _ = env.step(ACTION_USE)\n            actions_taken.append(ACTION_USE)\n            \n            # After trying to USE, check if it was collected.\n            current_state = env._current_state # Get updated state after the action.\n            if current_state.inventory[primitive] > 0:\n                # Successfully collected the primitive.\n                return actions_taken\n            # If not collected (e.g., it was an ungrabbable item or USE failed for some reason),\n            # the agent will continue exploration in the next iteration.\n        \n        # 2. If the primitive is not next to the agent, move to explore.\n        else:\n            # Choose a random movement action (DOWN=0, UP=1, LEFT=2, RIGHT=3).\n            # np.random.randint generates integers from `low` (inclusive) to `high` (exclusive).\n            move_action = np.random.randint(ACTION_DOWN, ACTION_USE) \n            reward, done, _ = env.step(int(move_action)) # Ensure action is an integer.\n            actions_taken.append(int(move_action))\n            # `current_state` will be updated by `env.step` and retrieved at the start of the next loop iteration.\n\n        # 3. Check if the environment signals that the episode is done\n        # (e.g., max_steps of CraftLab reached, or a goal satisfied by another means).\n        if done:\n            break\n\n    # If the loop finishes without collecting the primitive, return the actions taken so far.\n    # This implies the primitive was not found/collectable within the allowed steps or path was blocked.\n    return actions_taken", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:22:01.396368", "function_name": "collect", "function_body": "    actions = []\n    MAX_STEPS = 500  # A reasonable upper bound to prevent infinite loops\n\n    # Get action mappings from the environment's action specification\n    action_specs = env.action_specs()\n    ACTION_DOWN = action_specs[\"DOWN\"]\n    ACTION_UP = action_specs[\"UP\"]\n    ACTION_LEFT = action_specs[\"LEFT\"]\n    ACTION_RIGHT = action_specs[\"RIGHT\"]\n    ACTION_USE = action_specs[\"USE\"]\n\n    for step_count in range(MAX_STEPS):\n        obs = env.observations()\n        features_dict = obs['features_dict']\n        features_ego = features_dict['features_ego']\n        inventory = features_dict['inventory']\n\n        # 1. Check if the primitive is already collected\n        if inventory[primitive] > 0:\n            break\n\n        # 2. Check if the primitive is in the 3x3 neighborhood (including agent's cell)\n        # This mirrors CraftState.next_to(i_kind) using only observations\n        is_primitive_next_to = False\n        ego_h, ego_w, _ = features_ego.shape\n        agent_ego_r, agent_ego_c = ego_h // 2, ego_w // 2\n\n        # Iterate through the 3x3 neighborhood around the agent in egocentric view\n        for r_offset in [-1, 0, 1]:\n            for c_offset in [-1, 0, 1]:\n                check_r, check_c = agent_ego_r + r_offset, agent_ego_c + c_offset\n                # Ensure coordinates are within bounds of features_ego\n                if 0 <= check_r < ego_h and 0 <= check_c < ego_w:\n                    if features_ego[check_r, check_c, primitive] == 1:\n                        is_primitive_next_to = True\n                        break\n            if is_primitive_next_to:\n                break\n\n        if is_primitive_next_to:\n            # If the primitive is nearby, use the 'USE' action to try and collect it\n            actions.append(ACTION_USE)\n            reward, done, _ = env.step(ACTION_USE)\n            if done:\n                break\n            # After 'USE', the item might be in inventory, so the loop will re-check\n            continue\n\n        # 3. If not collected and not next to, try to find and move towards it\n        best_action = None\n        min_dist_sq = float('inf')\n        found_primitive_in_view = False\n        target_r, target_c = -1, -1\n\n        # Search for the primitive within the entire egocentric view\n        for r_idx in range(ego_h):\n            for c_idx in range(ego_w):\n                if features_ego[r_idx, c_idx, primitive] == 1:\n                    # Found the primitive. Calculate relative position.\n                    # Prioritize the closest one if multiple are in view.\n                    dr = r_idx - agent_ego_r\n                    dc = c_idx - agent_ego_c\n                    dist_sq = dr**2 + dc**2\n\n                    if dist_sq < min_dist_sq:\n                        min_dist_sq = dist_sq\n                        target_r, target_c = r_idx, c_idx\n                        found_primitive_in_view = True\n\n        if found_primitive_in_view:\n            # Determine the best action to move towards the found primitive\n            dr = target_r - agent_ego_r\n            dc = target_c - agent_ego_c\n\n            # Prioritize moving along the axis with the larger absolute difference\n            if abs(dr) > abs(dc):\n                if dr < 0:  # Primitive is \"above\" (smaller row index)\n                    best_action = ACTION_UP\n                else:  # Primitive is \"below\" (larger row index)\n                    best_action = ACTION_DOWN\n            else:\n                if dc < 0:  # Primitive is \"left\" (smaller column index)\n                    best_action = ACTION_LEFT\n                else:  # Primitive is \"right\" (larger column index)\n                    best_action = ACTION_RIGHT\n        else:\n            # If primitive not in egocentric view, perform a cyclic movement for exploration\n            movement_actions = [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]\n            best_action = movement_actions[step_count % len(movement_actions)]\n\n        # Execute the chosen movement action\n        if best_action is not None:\n            actions.append(best_action)\n            reward, done, _ = env.step(best_action)\n            if done:\n                break\n\n    return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:23:37.281476", "function_name": "collect", "function_body": "    state = env._current_state\n\n    # 1. Check if the primitive is already collected\n    if state.inventory[primitive] > 0:\n        return []\n\n    # 2. If the agent is already adjacent to the primitive, just use it.\n    # The 'next_to' method covers the 3x3 neighborhood, including the current cell.\n    # If the agent is standing ON a collectable primitive, next_to will be true.\n    if state.next_to(primitive):\n        return [4] # 4 is the USE action\n\n    grid = state.grid\n    grid_width, grid_height, _ = grid.shape\n    start_pos = state.pos\n\n    # Define possible moves: (dx, dy, action)\n    # Action mapping: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    moves = [\n        (0, 1, 0),  # DOWN\n        (0, -1, 1), # UP\n        (-1, 0, 3), # LEFT\n        (1, 0, 2)   # RIGHT\n    ]\n\n    # Helper function to check if a cell is traversable.\n    # A cell is traversable if it's within bounds and doesn't contain\n    # any non-grabbable item that blocks movement.\n    # We assume 'primitive' itself, if it happens to be non-grabbable (e.g., a workbench for crafting),\n    # does not block movement onto its square for the purpose of getting adjacent or on it.\n    # For 'collect', the primitive is typically a grabbable item that allows movement onto its square.\n    def is_traversable(x, y):\n        # Check grid boundaries\n        if not (0 <= x < grid_width and 0 <= y < grid_height):\n            return False\n        \n        # Check if this cell contains any non-grabbable item that IS NOT the primitive itself.\n        # This prevents walking through walls or solid obstacles.\n        for k_idx in env.world.non_grabbable_indices:\n            if k_idx == primitive:\n                # If the primitive itself is a non-grabbable item (like a workbench),\n                # we assume the agent can move onto or around it to 'use' it.\n                continue \n            if grid[x, y, k_idx] == 1:\n                return False # Cell contains a non-grabbable obstacle.\n        return True\n\n    # Find all locations where the primitive is present on the grid.\n    primitive_locations = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if grid[x, y, primitive] == 1:\n                primitive_locations.append((x, y))\n    \n    # If the primitive isn't anywhere on the grid, we can't collect it.\n    if not primitive_locations:\n        return []\n\n    # Determine all valid target positions for the agent:\n    # These are any traversable cells (tx, ty) from which the primitive can be reached via 'next_to'.\n    # 'next_to' uses a 3x3 neighborhood, meaning any cell within 1 unit (including diagonals)\n    # of a primitive location is a valid agent target position.\n    target_agent_positions = set()\n    for px, py in primitive_locations:\n        for dx_offset in [-1, 0, 1]:\n            for dy_offset in [-1, 0, 1]:\n                tx, ty = px + dx_offset, py + dy_offset\n                if is_traversable(tx, ty):\n                    target_agent_positions.add((tx, ty))\n    \n    # BFS Initialization\n    queue = collections.deque([(start_pos, [])]) # Queue stores (current_pos, path_to_current_pos)\n    visited = {start_pos} # Set of visited positions to prevent cycles and redundant paths\n\n    # BFS Loop\n    while queue:\n        current_pos, path_to_current_pos = queue.popleft()\n\n        # If we have reached a target position, then we can perform the USE action to collect.\n        if current_pos in target_agent_positions:\n            return path_to_current_pos + [4] # Append the USE action and return the complete sequence\n\n        cx, cy = current_pos\n        # Explore neighbors\n        for dx, dy, move_action in moves:\n            nx, ny = cx + dx, cy + dy\n            next_pos = (nx, ny)\n\n            # If the neighbor is traversable and hasn't been visited yet, add it to the queue\n            if is_traversable(nx, ny) and next_pos not in visited:\n                visited.add(next_pos)\n                queue.append((next_pos, path_to_current_pos + [move_action]))\n\n    # If the BFS loop completes without finding a path to any target position,\n    # it means the primitive is unreachable.\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:23:38.282793", "function_name": "collect", "function_body": "  import collections\n\n  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos\n  world = state.world  # CraftWorld instance\n\n  # Check if primitive is already collected\n  if state.inventory[primitive] > 0:\n    return []\n\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n\n  # Define action deltas (assuming env_factory provides these constants)\n  _ACTION_TO_DELTA = {\n      env_factory.DOWN: (0, 1),\n      env_factory.UP: (0, -1),\n      env_factory.LEFT: (-1, 0),\n      env_factory.RIGHT: (1, 0),\n  }\n\n  # Find all locations of the primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      if grid[x, y, primitive] > 0:\n        primitive_locations.append((x, y))\n\n  if not primitive_locations:\n    return []  # Primitive not found on the grid\n\n  # Helper function: Check if a given cell (x, y) is traversable for agent movement\n  def _is_traversable(pos, current_grid, world_ref):\n    x, y = pos\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False  # Out of bounds\n\n    # Check if the cell contains any non-grabbable item that acts as an obstacle.\n    # Agents cannot walk onto non-grabbable entities like water, stone resources, workshops.\n    for k_idx in range(N_KINDS):\n      if current_grid[x, y, k_idx] > 0 and k_idx in world_ref.non_grabbable_indices:\n        return False  # Contains an impassable obstacle\n    return True\n\n  # Helper function: Check if a position is a valid \"action point\" for collecting the primitive\n  # An action point is a cell from which 'USE' can be performed to collect the primitive.\n  # This means the agent's position `p_agent` must be within the 3x3 neighborhood\n  # (including self) of a cell containing the `primitive`. This matches CraftState.next_to.\n  def _is_action_point(p_agent, prim_locs_on_grid):\n    ax, ay = p_agent\n    for px, py in prim_locs_on_grid:\n      # Check if (ax, ay) is within 1 Manhattan distance of (px, py)\n      # This covers being on the same spot (Manhattan dist 0) or any of the 8 surrounding cells (Manhattan dist 1).\n      if abs(ax - px) <= 1 and abs(ay - py) <= 1:\n        return True\n    return False\n\n  # BFS to find the shortest path to an action point\n  q = collections.deque([(agent_pos, [])])  # (position, path_actions)\n  visited = {agent_pos}\n  path_to_primitive = []\n\n  while q:\n    curr_pos, curr_actions = q.popleft()\n\n    # Check if the current position is a valid action point for the primitive\n    if _is_action_point(curr_pos, primitive_locations):\n      path_to_primitive = curr_actions + [env_factory.USE]\n      break\n\n    # Explore neighbors\n    for action_val, (dx, dy) in _ACTION_TO_DELTA.items():\n      new_pos = (curr_pos[0] + dx, curr_pos[1] + dy)\n      if new_pos not in visited and _is_traversable(new_pos, grid, world):\n        visited.add(new_pos)\n        q.append((new_pos, curr_actions + [action_val]))\n\n  return path_to_primitive", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:24:53.661196", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement actions to the agent's new facing direction.\n  # Agent directions: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position).\n  # This vector describes both the movement direction and the cell the agent faces.\n  DIR_VEC = {\n      0: (0, -1),  # UP: (dx, dy) = (0, -1) -> moves up, faces up\n      1: (1, 0),   # RIGHT: (dx, dy) = (1, 0) -> moves right, faces right\n      2: (0, 1),   # DOWN: (dx, dy) = (0, 1) -> moves down, faces down\n      3: (-1, 0)   # LEFT: (dx, dy) = (-1, 0) -> moves left, faces left\n  }\n\n  current_state = env._current_state\n\n  # 1. Pre-checks:\n  # If the primitive is not a grabbable item, it cannot be \"collected\" via the USE action.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir # Agent's initial facing direction\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a grid cell is within bounds and not an obstacle.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # Check if the cell is occupied by any non-grabbable item (which acts as an obstacle).\n    # Grabbable items (even if not the target primitive) do not block movement.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # Breadth-First Search (BFS) for the shortest sequence of actions.\n  # The queue stores tuples: (current_x, current_y, current_direction).\n  # The direction is the direction the agent is facing at that position.\n  queue = collections.deque([(start_x, start_y, start_dir)])\n\n  # Visited set to prevent redundant exploration and cycles.\n  # A state is defined by (x, y, direction) because both position and facing direction\n  # affect subsequent moves and the outcome of the 'USE' action.\n  visited = set([(start_x, start_y, start_dir)])\n\n  # came_from dictionary to reconstruct the path after finding the goal.\n  # Maps (next_x, next_y, next_dir) -> (prev_x, prev_y, prev_dir, action_taken_to_reach_next_state)\n  came_from = {}\n\n  # This variable will store the final state (x, y, dir) from which USE can be performed.\n  goal_state = None\n\n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state allows for immediate collection of the primitive.\n    # The 'USE' action typically collects the item directly in front of the agent.\n    # Calculate the coordinates of the cell directly in front of the agent.\n    front_dx, front_dy = DIR_VEC[curr_dir]\n    front_x, front_y = curr_x + front_dx, curr_y + front_dy\n\n    # If the cell in front is within bounds AND contains the target primitive,\n    # then we've found a path to a collectable position.\n    if (0 <= front_x < grid_width and 0 <= front_y < grid_height and\n        grid[front_x, front_y, primitive] == 1):\n      goal_state = (curr_x, curr_y, curr_dir)\n      break # Found the shortest path to a collectable position, exit BFS.\n\n    # Explore possible movement actions (UP, DOWN, LEFT, RIGHT).\n    # In this environment, moving also sets the agent's facing direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Determine the new facing direction after performing this action.\n      next_dir = ACTION_TO_DIR[action]\n      # The movement itself is in the direction the agent will face after the action.\n      move_dx, move_dy = DIR_VEC[next_dir]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_state = (next_x, next_y, next_dir)\n\n      # If the next cell is walkable (not an obstacle) and this (position, direction)\n      # state has not been visited yet, add it to the queue for exploration.\n      if is_walkable(next_x, next_y) and next_state not in visited:\n        visited.add(next_state)\n        # Store how we reached next_state: from curr_state using 'action'.\n        came_from[next_state] = (curr_x, curr_y, curr_dir, action)\n        queue.append(next_state)\n\n  # If no goal state was found (queue exhausted without breaking), the primitive is unreachable.\n  if goal_state is None:\n    return []\n\n  # Reconstruct the path by backtracking from the goal state to the start state.\n  path_actions = []\n  temp_state = goal_state\n  # Loop until we reach the starting state, which is not in came_from as it's the origin.\n  while temp_state != (start_x, start_y, start_dir):\n    # Retrieve the previous state and the action taken to reach the current temp_state.\n    prev_x, prev_y, prev_dir, action_taken = came_from[temp_state]\n    path_actions.insert(0, action_taken) # Insert at the beginning to build path in correct order\n    temp_state = (prev_x, prev_y, prev_dir)\n\n  # Append the final 'USE' action to the path, as it is needed to collect the primitive.\n  return path_actions + [ACTION_USE]", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:24:54.635097", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n  import heapq # For A* priority queue\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Maps movement actions to (dx, dy) changes in position.\n  # These define the change in coordinates when moving in a specific direction.\n  DIRS_VEC = {\n      ACTION_UP: (0, -1),\n      ACTION_RIGHT: (1, 0),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0)\n  }\n\n  # Maps movement actions to the agent's new facing direction.\n  # Agent directions: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Maps agent direction (int) to (dx, dy) of the cell it faces.\n  # This is for determining the target cell for the USE action.\n  DIR_TO_COORDS_CHANGE = {\n      0: (0, -1),  # UP (faces cell above current pos)\n      1: (1, 0),   # RIGHT (faces cell to the right)\n      2: (0, 1),   # DOWN (faces cell below)\n      3: (-1, 0)   # LEFT (faces cell to the left)\n  }\n\n  current_state = env._current_state\n  \n  # Improvements over collect_v1:\n  # 1. Handles cases where the primitive is not grabbable or already in inventory upfront.\n  # 2. Uses A* search (instead of BFS) which is more general and efficient for larger graphs,\n  #    though for uniform costs like here, BFS also finds the shortest path.\n  #    The A* implementation is more robust in defining target states and heuristics.\n  \n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n  \n  # If the primitive is already in inventory, no actions needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid # Access grid directly for efficiency\n  grid_width, grid_height, _ = grid.shape\n\n  non_grabbable_indices = env.world.non_grabbable_indices\n  \n  # Helper function to check if a grid cell is within bounds and not an obstacle.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # Check if the cell is occupied by a non-grabbable item (which acts as an obstacle).\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # 2. Identify all target states (position, direction) from which the primitive can be collected.\n  # A target state is (agent_x, agent_y, agent_dir) such that (agent_x, agent_y) is walkable,\n  # and the cell faced by the agent (ax + dx_faced, ay + dy_faced) contains the primitive.\n  target_states = set()\n  \n  # Find all (x, y) coordinates where the primitive kind exists on the grid.\n  primitive_locations = np.argwhere(grid[:, :, primitive] == 1) \n\n  if len(primitive_locations) == 0:\n      return [] # No primitive found on the map\n\n  for px, py in primitive_locations:\n    # For each primitive location (px, py), consider all 4 adjacent cells for agent's position.\n    # An agent at (ax, ay) needs to face (px, py).\n    for agent_dir, (dx_faced, dy_faced) in DIR_TO_COORDS_CHANGE.items():\n      # Calculate the required agent position (ax, ay) to face (px, py).\n      # ax = px - dx_faced, ay = py - dy_faced\n      ax, ay = px - dx_faced, py - dy_faced\n      \n      # Check if this potential agent position is within bounds and walkable.\n      if is_walkable(ax, ay):\n        target_states.add((ax, ay, agent_dir))\n\n  # If no valid collection points are found, return an empty path.\n  if not target_states:\n    return []\n\n  # Heuristic function for A* (Manhattan distance from agent's position to closest target agent position)\n  # It's an admissible heuristic as it never overestimates the true cost.\n  def heuristic(x, y):\n      min_h = float('inf')\n      # We only consider position for heuristic, not direction, as turning is part of movement cost.\n      for tx, ty, _ in target_states:\n          min_h = min(min_h, abs(x - tx) + abs(y - ty))\n      return min_h\n\n  # 3. A* Search Algorithm\n  start_state = (start_x, start_y, start_dir)\n\n  # Priority queue (min-heap): stores tuples of (f_score, state_tuple)\n  # f_score = g_score + h_score\n  open_set = [(heuristic(start_x, start_y), start_state)]\n  \n  # g_score[state] is the cost of the cheapest path from the start_state to state currently known.\n  g_score = {start_state: 0}\n  \n  # came_from[state] is the state and action preceding this state on the cheapest path found so far.\n  # Used to reconstruct the path after finding the goal.\n  came_from = {} # Maps (x,y,dir) -> ((prev_x,prev_y,prev_dir), action_taken)\n\n  # Set of states that have been fully evaluated (their g_score is final).\n  closed_set = set() \n\n  while open_set:\n    # Get the state with the lowest f_score from the priority queue.\n    current_f_score, current_state = heapq.heappop(open_set)\n    curr_x, curr_y, curr_dir = current_state\n\n    # If this state has already been processed with a better or equal path, skip it.\n    if current_state in closed_set:\n        continue\n    closed_set.add(current_state)\n\n    # Goal Check: If the current state is one of our pre-calculated target collection states,\n    # we have found the shortest path to a collection point.\n    if current_state in target_states:\n      # Reconstruct the path by backtracking from the goal state to the start state.\n      path_actions = []\n      temp_state = current_state\n      while temp_state != start_state:\n        prev_state, action_taken = came_from[temp_state]\n        path_actions.insert(0, action_taken) # Insert at the beginning to maintain order\n        temp_state = prev_state\n      return path_actions + [ACTION_USE] # Append the USE action and return.\n\n    # Explore possible next states by applying movement actions.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new position and direction after the action.\n      move_dx, move_dy = DIRS_VEC[action]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # Agent faces the direction of movement after this action\n      next_state = (next_x, next_y, next_dir)\n\n      # Check if the new cell is within bounds and walkable (not an obstacle).\n      if not is_walkable(next_x, next_y):\n        continue\n\n      # The cost to move from current_state to next_state is 1 (one action).\n      tentative_g_score = g_score[current_state] + 1\n\n      # If this path to next_state is better than any previously found, or if next_state is new:\n      if tentative_g_score < g_score.get(next_state, float('inf')):\n        g_score[next_state] = tentative_g_score\n        f_score = tentative_g_score + heuristic(next_x, next_y)\n        came_from[next_state] = (current_state, action)\n        \n        # Add the next_state to the open set for future exploration.\n        # It's okay if a state is added multiple times with different f_scores;\n        # the closed_set check ensures we only process the best one.\n        heapq.heappush(open_set, (f_score, next_state))\n  \n  # If the open_set becomes empty and no path to any target state was found,\n  # it means the primitive is unreachable (e.g., completely surrounded by obstacles).\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:26:08.991165", "function_name": "collect", "function_body": "  # Action constants (typically defined globally or imported in a full project)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  actions_to_take = []\n  \n  # Get the current state of the environment for planning.\n  # We access the _current_state attribute of the CraftLab instance,\n  # which holds the CraftState object.\n  current_state = env._current_state \n  \n  # Set a maximum number of planning steps to prevent infinite loops\n  # in case the primitive is unreachable or the planning gets stuck.\n  max_planning_steps = 200 \n  \n  for _ in range(max_planning_steps):\n      # 1. Check if the primitive item is already in the agent's inventory.\n      if current_state.inventory[primitive] > 0:\n          break # Goal achieved, stop planning.\n\n      # 2. Check if the primitive is in the agent's immediate 3x3 neighborhood.\n      if current_state.next_to(primitive):\n          actions_to_take.append(USE) # Plan to use/collect the item.\n          # Simulate the 'USE' action to update the environment's internal state\n          # for subsequent planning steps. We discard the reward and observations.\n          _, done, _ = env.step(USE)\n          current_state = env._current_state # Update reference to the new state.\n          if done: \n              # If the environment signals the episode is done after 'USE', stop planning.\n              break\n          continue # After using, re-check inventory in the next loop iteration.\n      \n      # 3. If the primitive is not in the inventory and not adjacent, find its location\n      #    on the grid and plan a movement action towards it.\n      grid = current_state.grid\n      agent_x, agent_y = current_state.pos\n\n      # Find all locations on the grid where the primitive item kind is present.\n      # np.where returns a tuple of (row_indices, column_indices), which corresponds\n      # to (y-coordinates, x-coordinates) on the grid.\n      primitive_ys, primitive_xs = np.where(grid[:, :, primitive] > 0)\n\n      if len(primitive_ys) == 0:\n          # If the primitive is not found anywhere on the grid, it cannot be collected.\n          # This might happen if it's already collected, or not a primitive on this map.\n          # Return the actions planned so far (possibly an empty list if not found initially).\n          return actions_to_take \n\n      # Find the closest instance of the primitive using Manhattan distance.\n      min_dist = float('inf')\n      target_x, target_y = -1, -1 # Initialize with invalid coordinates.\n\n      for px, py in zip(primitive_xs, primitive_ys):\n          dist = abs(px - agent_x) + abs(py - agent_y)\n          if dist < min_dist:\n              min_dist = dist\n              target_x, target_y = px, py\n      \n      # Determine the best greedy movement action to reduce the distance to the target.\n      dx = target_x - agent_x\n      dy = target_y - agent_y\n      \n      chosen_action = -1 # Initialize the action.\n      \n      # Prioritize movement along the dimension (X or Y) with the larger absolute difference.\n      if abs(dx) > abs(dy):\n          if dx > 0: # Target is to the right (+X direction).\n              chosen_action = RIGHT\n          else: # dx < 0, Target is to the left (-X direction).\n              chosen_action = LEFT\n      else: # abs(dy) >= abs(dx) or both dx and dy are zero.\n          if dy > 0: # Target is below (+Y direction, assuming Y increases downwards).\n              chosen_action = DOWN\n          else: # dy < 0, Target is above (-Y direction).\n              chosen_action = UP\n        \n      # If chosen_action is still -1, it implies dx=0 and dy=0, meaning the agent is\n      # already at the target location. This case should typically be handled by the \n      # `current_state.next_to(primitive)` check if the primitive is actually there.\n      # If not, it means we can't make a useful move to get closer, so we stop planning.\n      if chosen_action == -1:\n          break \n      \n      actions_to_take.append(chosen_action)\n      # Simulate the chosen movement action to update the environment's state.\n      _, done, _ = env.step(chosen_action)\n      current_state = env._current_state # Update reference to the new state.\n      if done: \n          # If the environment signals the episode is done after a move, stop planning.\n          break\n            \n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:26:10.014776", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:27:09.108418", "function_name": "collect", "function_body": "  # Action constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Mappings for movement actions to coordinate changes (dx, dy) for (x, y)\n  # In CraftWorld, positive X is Right, positive Y is Down.\n  # UP: decreases Y, DOWN: increases Y, LEFT: decreases X, RIGHT: increases X.\n  MOVES = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  def _is_valid_collection_point(agent_pos_x, agent_pos_y, primitive_idx, grid_data):\n      \"\"\"\n      Checks if the agent, at (agent_pos_x, agent_pos_y), is adjacent to or on the\n      same cell as the `primitive_idx`. The USE action in CraftWorld applies to\n      the entire 3x3 neighborhood around the agent's current position.\n      \"\"\"\n      W_grid, H_grid, _ = grid_data.shape\n      \n      # Iterate through the 3x3 neighborhood (including the agent's own cell)\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              nx, ny = agent_pos_x + dx, agent_pos_y + dy\n\n              # Check if the neighbor cell is within grid bounds\n              if 0 <= nx < W_grid and 0 <= ny < H_grid:\n                  # If the primitive is found in any cell of the neighborhood\n                  if grid_data[nx, ny, primitive_idx] > 0:\n                      return True\n      return False\n\n  # Get current state observations from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global'] # Full allocentric grid view\n  \n  # Agent's current position (x, y) - ensure it's an integer tuple for hashing\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  current_pos = (current_pos_x, current_pos_y)\n  \n  world = env.world\n  # non_grabbable_indices are entities that the agent cannot pass through (e.g., walls, water).\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, _ = grid.shape # Grid dimensions: Width, Height, Number of kinds\n\n  # 1. Create a traversability mask for the grid\n  # A cell is traversable if it does not contain any non-grabbable item.\n  # Initialize all cells as traversable (True).\n  traversable_mask = np.ones((W, H), dtype=bool)\n  \n  # Mark cells as non-traversable (False) if they contain any non-grabbable entity.\n  # This uses NumPy's efficient boolean indexing.\n  for idx in non_grabbable_indices:\n      traversable_mask[grid[:, :, idx] > 0] = False\n  \n  # Edge case: If the agent's starting position is not traversable, no path is possible.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return []\n\n  # 2. Perform Breadth-First Search (BFS) to find the shortest path to a valid collection point.\n  # A collection point is any traversable cell from which the target primitive can be collected.\n  \n  # BFS queue: stores (x, y) positions to visit\n  q = deque([current_pos])\n  # Set of visited (x, y) positions to prevent cycles and redundant exploration\n  visited = {current_pos}\n  # Parent map: parent[(child_x, child_y)] = ((parent_x, parent_y), action_from_parent_to_child)\n  # This allows path reconstruction.\n  parent = {}\n  \n  found_collection_pos = None\n\n  while q:\n      curr_x, curr_y = q.popleft()\n      \n      # Check if the current position is a valid collection point for the target primitive.\n      if _is_valid_collection_point(curr_x, curr_y, primitive, grid):\n          found_collection_pos = (curr_x, curr_y)\n          break # Shortest path to a suitable collection location found\n      \n      # Explore neighboring cells reachable by a single movement action\n      for action, (dx, dy) in MOVES.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # Check if the next position is:\n          # 1. Within grid bounds\n          # 2. Traversable (not an obstacle)\n          # 3. Not yet visited in this BFS\n          if (0 <= next_x < W and 0 <= next_y < H and\n              traversable_mask[next_x, next_y] and\n              next_pos not in visited):\n              \n              visited.add(next_pos)\n              parent[next_pos] = ((curr_x, curr_y), action) # Store how next_pos was reached\n              q.append(next_pos)\n  \n  # If no collection point for the primitive was found (e.g., primitive doesn't exist\n  # on the map or is completely surrounded by untraversable cells).\n  if found_collection_pos is None:\n      return [] \n  \n  # 3. Reconstruct the path of movement actions from the start to the found_collection_pos.\n  path_actions = []\n  node = found_collection_pos\n  \n  # Trace back from the goal position to the starting position using the parent map.\n  while node != current_pos:\n      # This check ensures robustness, although for a connected graph, 'node' should always be in 'parent'.\n      if node not in parent:\n          return [] # Should not happen in a valid BFS solution, indicates an issue.\n      \n      prev_node, action_to_reach_node = parent[node]\n      path_actions.append(action_to_reach_node)\n      node = prev_node\n  \n  path_actions.reverse() # Actions were collected in reverse order, so reverse for correct sequence.\n  \n  # 4. Append the USE action after the agent has moved to the collection point.\n  actions = path_actions + [USE]\n  \n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:27:10.086799", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action constants for clarity\n  # These map to integers 0-4 as defined in CraftLab.action_specs\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map agent direction (0=North, 1=East, 2=South, 3=West) to (dx, dy) delta for the cell directly in front.\n  # This dictates where the USE action will apply.\n  DIRECTION_DELTAS = {\n      0: (0, -1),  # North: (dx=0, dy=-1)\n      1: (1, 0),   # East:  (dx=1, dy=0)\n      2: (0, 1),   # South: (dx=0, dy=1)\n      3: (-1, 0),  # West:  (dx=-1, dy=0)\n  }\n\n  # Map movement action to the resulting agent direction *after* the action.\n  # This is crucial because moving actions also change the agent's facing direction.\n  ACTION_TO_DIRECTION = {\n      ACTION_UP: 0,    # Moving UP makes agent face North\n      ACTION_RIGHT: 1, # Moving RIGHT makes agent face East\n      ACTION_DOWN: 2,  # Moving DOWN makes agent face South\n      ACTION_LEFT: 3,  # Moving LEFT makes agent face West\n  }\n\n  # Get current state observations from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Extract agent's current position (x, y) and initial facing direction\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  initial_dir = np.argmax(obs['features_dict']['direction']) # Convert one-hot direction to integer (0-3)\n\n  world = env.world\n  # Identify non-traversable (obstacle) indices from the world's configuration.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, _ = grid.shape # Get grid dimensions (Width, Height, Kinds - Kinds not directly used here)\n\n  # 1. Create a traversability mask for the grid.\n  # A cell is traversable if it does not contain any item from non_grabbable_indices.\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for idx in non_grabbable_indices:\n      # Mark cells containing non-grabbable items as non-traversable.\n      traversable_mask[grid[:, :, idx] > 0] = False\n  \n  # Ensure the agent's starting position is traversable. If not, no path is possible.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return []\n\n  # 2. Perform a Breadth-First Search (BFS) to find the shortest action sequence.\n  # BFS state: ((current_x, current_y), current_direction, actions_taken_so_far)\n  q = deque([((current_pos_x, current_pos_y), initial_dir, [])])\n  \n  # Visited set to prevent cycles and redundant exploration.\n  # Stores (position_tuple, direction_integer) pairs.\n  visited = {((current_pos_x, current_pos_y), initial_dir)}\n  \n  while q:\n      (curr_x, curr_y), curr_dir, actions_so_far = q.popleft()\n\n      # Check if the current state allows for collecting the primitive with a 'USE' action.\n      # The 'USE' action targets the cell directly in front of the agent.\n      front_dx, front_dy = DIRECTION_DELTAS[curr_dir] # Delta for the cell in front\n      target_x, target_y = curr_x + front_dx, curr_y + front_dy\n\n      # Check if the target cell is within grid bounds AND contains the desired primitive.\n      if (0 <= target_x < W and 0 <= target_y < H and\n          grid[target_x, target_y, primitive] > 0):\n          # Goal reached: the agent is positioned and facing the primitive.\n          # Append the USE action and return the full sequence.\n          return actions_so_far + [ACTION_USE]\n\n      # Explore possible next states by trying all movement actions.\n      for action_val in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n          # Determine the agent's new facing direction after attempting this movement action.\n          next_dir_after_action = ACTION_TO_DIRECTION[action_val]\n          \n          # Calculate the proposed new position if the move is successful based on the new direction.\n          move_dx, move_dy = DIRECTION_DELTAS[next_dir_after_action]\n          proposed_next_x, proposed_next_y = curr_x + move_dx, curr_y + move_dy\n          \n          actual_next_x, actual_next_y = curr_x, curr_y # Default: agent remains in current position\n\n          # Check if the proposed next cell is within grid bounds and traversable.\n          if (0 <= proposed_next_x < W and 0 <= proposed_next_y < H and\n              traversable_mask[proposed_next_x, proposed_next_y]):\n              # If traversable, the agent successfully moves to the new cell.\n              actual_next_x, actual_next_y = proposed_next_x, proposed_next_y\n          # Else: The agent is blocked and remains at `(curr_x, curr_y)`, but its direction still changes.\n\n          next_state_key = ((actual_next_x, actual_next_y), next_dir_after_action)\n          \n          # If this specific (position, direction) state has not been visited yet, add it to the queue.\n          if next_state_key not in visited:\n              visited.add(next_state_key)\n              q.append(((actual_next_x, actual_next_y), next_dir_after_action, actions_so_far + [action_val]))\n\n  # If the queue becomes empty and no primitive was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:28:28.342931", "function_name": "collect", "function_body": "  from collections import deque\n  \n  # Action mappings for agent movement and direction changes.\n  # These are constants defining the effect of movement actions on (dx, dy) coordinates.\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (agent moves down, faces down)\n      1: (0, -1), # UP: dx=0, dy=-1 (agent moves up, faces up)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (agent moves left, faces left)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (agent moves right, faces right)\n  }\n  USE_ACTION = 4 # The action ID for using an item or crafting station.\n\n  # 1. Obtain the integer index for the target primitive from the cookbook's index.\n  # The `index` method handles adding new items if they don't already exist.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Early exit: Check if the primitive can even be collected via a 'USE' action.\n  # Grabbable items are those that can be picked up. If it's not grabbable, collecting is impossible.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # 3. Early exit: Check if the primitive is already in the agent's inventory.\n  # If the agent already possesses the item, no collection actions are needed.\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 4. Initialize grid dimensions and define which entity kinds act as impassable obstacles.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # Obstacles are non-grabbable entities that are NOT workshops.\n  # Workshops are typically non-grabbable but allow agent traversal.\n  impassable_obstacle_kinds = env.world.non_grabbable_indices - set(env.world.workshop_indices)\n\n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path.\n  # The BFS state must include both agent's position and its facing direction,\n  # as the 'USE' action depends on direction, and movement actions change direction.\n  \n  # Queue stores tuples: ((current_x, current_y), current_direction, [list_of_actions_to_reach_here])\n  queue = deque([(current_state.pos, current_state.dir, [])]) \n  \n  # Visited set stores ((x, y), direction) tuples to prevent revisiting states and cycles.\n  visited = {(current_state.pos, current_state.dir)} \n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.popleft() # Dequeue the current state\n\n    # Check if the current state allows collection of the primitive.\n    # This means the primitive must be in the grid cell directly in front of the agent.\n    dx_facing, dy_facing = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_item_x, target_item_y = curr_x + dx_facing, curr_y + dy_facing\n\n    # If the cell in front is within bounds and contains the primitive, a path is found.\n    if (0 <= target_item_x < grid_width and 0 <= target_item_y < grid_height and\n        grid[target_item_x, target_item_y, primitive_idx] > 0):\n      # BFS guarantees this is the shortest path to a state where 'USE' is effective.\n      return path_actions + [USE_ACTION]\n    \n    # Explore all four possible movement actions (DOWN, UP, LEFT, RIGHT).\n    for move_action in range(4): \n      dx_attempt, dy_attempt = _ACTION_TO_COORD_DIFF[move_action]\n      attempt_next_x, attempt_next_y = curr_x + dx_attempt, curr_y + dy_attempt\n      \n      # The agent's facing direction *always* changes to the direction of the attempted movement,\n      # regardless of whether the position actually changes due to an obstacle.\n      next_dir = move_action \n\n      actual_next_x, actual_next_y = curr_x, curr_y # Assume agent stays put initially\n\n      # Check if the attempted next position is within grid boundaries.\n      is_within_bounds = (0 <= attempt_next_x < grid_width and 0 <= attempt_next_y < grid_height)\n      \n      is_blocked = False\n      if is_within_bounds:\n          # Check if the target cell for movement contains any impassable obstacle.\n          for kind_idx in impassable_obstacle_kinds:\n              if grid[attempt_next_x, attempt_next_y, kind_idx] > 0:\n                  is_blocked = True\n                  break\n      \n      # If the attempted move is valid (within bounds and not blocked), the agent moves.\n      if is_within_bounds and not is_blocked:\n          actual_next_x, actual_next_y = attempt_next_x, attempt_next_y\n      \n      # Define the next state (new position and direction).\n      next_state_key = ((actual_next_x, actual_next_y), next_dir)\n      \n      # If this new state has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key) # Mark as visited\n        queue.append((next_state_key[0], next_state_key[1], path_actions + [move_action]))\n\n  # If the BFS queue is exhausted and no path was found, the primitive is unreachable.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:28:29.313634", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:29:40.615937", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Action constants (from problem description context)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVES = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  def _is_valid_collection_point(agent_pos, target_indices_set, grid):\n      \"\"\"\n      Checks if `agent_pos` is a valid position from which to collect any of\n      the items/blocks specified by `target_indices_set`.\n      This means at least one target item/block must be present in the 3x3\n      neighborhood of `agent_pos` (including the agent's own cell).\n      \"\"\"\n      W, H, _ = grid.shape\n      ax, ay = agent_pos\n\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              nx, ny = ax + dx, ay + dy\n\n              # Check bounds for the neighboring cell\n              if 0 <= nx < W and 0 <= ny < H:\n                  # Check if any of the target indices are present in this neighbor cell\n                  for target_idx in target_indices_set:\n                      if grid[nx, ny, target_idx] > 0:\n                          return True\n      return False\n\n  actions = []\n  \n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  # obs['features_dict']['pos'] is a numpy array, convert to tuple for hashing in sets/dicts.\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  inventory = obs['features_dict']['inventory'] # Get current inventory\n  \n  world = env.world\n  # non_grabbable_indices typically include obstacles like water, stone walls, workshops.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape\n\n  # IMPROVEMENT: Check if the primitive is already in the inventory.\n  # If the agent already has at least one of the desired primitive, no actions are needed.\n  if inventory[primitive] > 0:\n      return []\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for x in range(W):\n      for y in range(H):\n          # A cell is NOT traversable if it contains any non-grabbable item.\n          if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n              traversable_mask[x, y] = False\n  \n  # Verify that the agent's current position is traversable.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      # This case should ideally not happen in a valid scenario, as the agent starts on a traversable tile.\n      return [] \n\n  # 2. Determine target kinds for collection.\n  # The 'primitive' input is the index of the *item* we want to collect (e.g., wood, water).\n  # Items can be collected in two ways:\n  #   a) Picked up directly if lying on the ground (check for `primitive` itself).\n  #   b) Harvested from a source block (e.g., water from a 'water' block, stone from a 'stone' block).\n  # The agent needs to be in a position where the item or its source block is in the 3x3 area.\n  \n  target_grid_indices = {primitive} # Always include the primitive itself for direct pickup\n\n  # Add source block indices if the primitive is derived from an environmental block\n  primitive_name = world.cookbook.index.get(primitive)\n  if primitive_name == 'water':\n      # 'water' item can be collected from a 'water' block\n      if world.water_index is not None:\n          target_grid_indices.add(world.water_index) \n  elif primitive_name == 'stone':\n      # 'stone' item can be collected from a 'stone' block\n      if world.stone_index is not None:\n          target_grid_indices.add(world.stone_index)\n  # Future extensions might add other mappings here, e.g., 'wood' from a 'tree' block.\n\n  # 3. Perform BFS to find the shortest path to any location from which the primitive can be collected.\n  q = deque([current_pos]) \n  visited = {current_pos}\n  parent = {} # parent[child_pos] = (parent_pos, action_from_parent)\n  \n  found_collection_pos = None\n\n  while q:\n      curr_pos = q.popleft()\n      \n      # Check if the current position is a valid collection point for any of the target indices\n      if _is_valid_collection_point(curr_pos, target_grid_indices, grid):\n          found_collection_pos = curr_pos\n          break # Found the shortest path to a suitable collection location\n      \n      # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n      for action, (dx, dy) in MOVES.items():\n          next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n          next_pos = (next_x, next_y)\n\n          # Check bounds, traversability, and if the cell has already been visited\n          if (0 <= next_x < W and 0 <= next_y < H and\n              traversable_mask[next_x, next_y] and\n              next_pos not in visited):\n              \n              visited.add(next_pos)\n              parent[next_pos] = (curr_pos, action) # Store how we reached next_pos\n              q.append(next_pos)\n  \n  # If no path was found (e.g., the primitive is unreachable or doesn't exist in a reachable area)\n  if found_collection_pos is None:\n      return [] \n  \n  # 4. Reconstruct the path from found_collection_pos back to current_pos\n  path_actions = []\n  node = found_collection_pos\n  # Loop until we reach the starting position\n  while node != current_pos:\n      prev_node, action_to_reach_node = parent[node]\n      path_actions.append(action_to_reach_node)\n      node = prev_node\n  \n  path_actions.reverse() # Reverse the list to get actions from start to target\n  \n  # 5. Append the USE action after the movement path.\n  actions.extend(path_actions)\n  actions.append(USE)\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
