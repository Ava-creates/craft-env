{"timestamp": "2025-07-30T18:20:06.501379", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  # Map movement actions to the new direction and (dx, dy) delta\n  ACTION_TO_EFFECT = {\n      UP: (DIR_UP, 0, -1),    # (new_direction, delta_x, delta_y)\n      DOWN: (DIR_DOWN, 0, 1),\n      LEFT: (DIR_LEFT, -1, 0),\n      RIGHT: (DIR_RIGHT, 1, 0),\n  }\n\n  # 1. Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  initial_dir = np.argmax(obs['features_dict']['direction'])\n\n  world = env.world\n  # Convert to list for robust indexing with numpy advanced indexing\n  non_grabbable_indices = list(world.non_grabbable_indices) \n\n  W, H, K = grid.shape\n\n  # 2. Determine traversable cells\n  # A cell is NOT traversable if it contains any non-grabbable item (obstacle).\n  traversable_mask = np.ones((W, H), dtype=bool)\n  if non_grabbable_indices:\n      obstacles_present = np.any(grid[:, :, non_grabbable_indices] > 0, axis=2)\n      traversable_mask = ~obstacles_present\n  \n  # Helper function to check if a coordinate is within bounds and traversable\n  def is_valid_and_traversable(x, y):\n      return 0 <= x < W and 0 <= y < H and traversable_mask[x, y]\n\n  # If the agent starts on an untraversable cell, no path possible.\n  if not is_valid_and_traversable(current_pos_x, current_pos_y):\n      return []\n\n  # 3. Identify all locations of the target primitive on the grid\n  primitive_locations = []\n  # np.where returns (row_indices, col_indices). For grid[x,y], col_idx is x, row_idx is y.\n  py_coords, px_coords = np.where(grid[:, :, primitive] > 0)\n  for px, py in zip(px_coords, py_coords):\n      primitive_locations.append((px, py))\n\n  # If the primitive doesn't exist anywhere on the map, we can't collect it.\n  if not primitive_locations:\n      return []\n\n  # 4. Identify \"primitive interaction cells\": (ax, ay) from which\n  # the USE action can successfully collect the primitive.\n  # This improved version assumes the 'USE' action can interact with the\n  # primitive if it's anywhere within the agent's 3x3 neighborhood (including\n  # the agent's own cell), regardless of the agent's facing direction.\n  # This aligns with the 'CraftState.next_to' method description.\n  primitive_interaction_cells = set()\n  for px, py in primitive_locations:\n      # Check 3x3 neighborhood around primitive (including primitive's cell)\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              ax, ay = px + dx, py + dy\n              if is_valid_and_traversable(ax, ay):\n                  primitive_interaction_cells.add((ax, ay))\n\n  # If no valid interaction cells exist (e.g., primitive is surrounded by untraversable cells),\n  # then it's uncollectable.\n  if not primitive_interaction_cells:\n      return []\n\n  # 5. Perform BFS search on state space (x, y, direction)\n  # The direction is still part of the state because movement actions change it,\n  # but it is no longer a condition for the 'USE' action itself.\n  start_state = (current_pos_x, current_pos_y, initial_dir)\n  \n  # Queue stores tuples: ((curr_x, curr_y, curr_dir), [actions_so_far])\n  q = deque([(start_state, [])]) \n  \n  # Visited set stores (x, y, dir) states to avoid cycles and redundant paths\n  visited = {start_state}\n\n  while q:\n      (curr_x, curr_y, curr_dir), actions_so_far = q.popleft()\n\n      # Check if the current position is a primitive interaction cell.\n      # The direction (curr_dir) is now irrelevant for this check.\n      if (curr_x, curr_y) in primitive_interaction_cells:\n          return actions_so_far + [USE]\n\n      # Explore possible next states by taking movement actions\n      # Movement actions change both position AND the agent's facing direction.\n      for action_val, (next_dir, dx, dy) in ACTION_TO_EFFECT.items():\n          next_x, next_y = curr_x + dx, curr_y + dy # New position\n          next_state = (next_x, next_y, next_dir)\n\n          # Check if the next cell is within bounds, traversable, and not yet visited\n          if (is_valid_and_traversable(next_x, next_y) and\n              next_state not in visited):\n              \n              visited.add(next_state)\n              q.append((next_state, actions_so_far + [action_val]))\n  \n  # If the BFS queue becomes empty and no path to an interaction cell was found\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:20:07.474027", "function_name": "collect", "function_body": "  import heapq # For priority queue\n  from collections import deque # Not strictly needed for A*, but often useful for graph algos\n\n  # Constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  # Map movement actions to the new direction and (dx, dy) delta\n  ACTION_TO_EFFECT = {\n      UP: (DIR_UP, 0, -1),\n      DOWN: (DIR_DOWN, 0, 1),\n      LEFT: (DIR_LEFT, -1, 0),\n      RIGHT: (DIR_RIGHT, 1, 0),\n  }\n\n  # Map (dx, dy) delta to the agent's direction required to face that delta\n  DELTA_TO_DIRECTION = {\n      (0, -1): DIR_UP,\n      (1, 0): DIR_RIGHT,\n      (0, 1): DIR_DOWN,\n      (-1, 0): DIR_LEFT,\n  }\n\n  # 1. Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  initial_dir = np.argmax(obs['features_dict']['direction'])\n\n  world = env.world\n  # Convert to list for robust indexing with numpy advanced indexing\n  non_grabbable_indices = list(world.non_grabbable_indices) \n\n  W, H, K = grid.shape\n\n  # 2. Determine traversable cells\n  # A cell is NOT traversable if it contains any non-grabbable item (obstacle).\n  traversable_mask = np.ones((W, H), dtype=bool)\n  if non_grabbable_indices:\n      obstacles_present = np.any(grid[:, :, non_grabbable_indices] > 0, axis=2)\n      traversable_mask = ~obstacles_present\n  \n  # Helper function to check if a coordinate is within bounds and traversable\n  def is_valid_and_traversable(x, y):\n      return 0 <= x < W and 0 <= y < H and traversable_mask[x, y]\n\n  # If the agent starts on an untraversable cell, no path possible.\n  if not is_valid_and_traversable(current_pos_x, current_pos_y):\n      return []\n\n  # 3. Identify all locations of the target primitive on the grid\n  primitive_locations = []\n  # np.where returns (row_indices, col_indices). For grid[x,y], col_idx is x, row_idx is y.\n  py_coords, px_coords = np.where(grid[:, :, primitive] > 0)\n  for px, py in zip(px_coords, py_coords):\n      primitive_locations.append((px, py))\n\n  # If the primitive doesn't exist anywhere on the map, we can't collect it.\n  if not primitive_locations:\n      return []\n\n  # 4. Identify \"primitive target states\": (agent_x, agent_y, agent_dir) from which\n  # the USE action can successfully collect the primitive.\n  # This means the agent must be adjacent to the primitive and facing it.\n  primitive_target_states = set()\n  for px, py in primitive_locations:\n      # Iterate over 4 possible relative positions (dx, dy) from agent to primitive\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: \n          # Agent's potential position (ax, ay) given primitive (px,py) and delta (dx,dy)\n          ax, ay = px - dx, py - dy \n\n          if not is_valid_and_traversable(ax, ay):\n              continue\n          \n          # The agent's required direction is the direction of the vector from (ax,ay) to (px,py),\n          # which is (dx, dy).\n          required_agent_dir = DELTA_TO_DIRECTION[(dx, dy)]\n          \n          primitive_target_states.add((ax, ay, required_agent_dir))\n\n  # If no valid target states exist (e.g., primitive is surrounded by untraversable cells),\n  # then it's uncollectable.\n  if not primitive_target_states:\n      return []\n\n  # 5. Perform A* search on state space (x, y, direction)\n  start_state = (current_pos_x, current_pos_y, initial_dir)\n  \n  # g_score: cost from start to the current state\n  # Stores the lowest cost to reach a state (x, y, direction) found so far.\n  g_score = {start_state: 0}\n  \n  # Heuristic function: minimum Manhattan distance to any target primitive's adjacency position.\n  # This is an admissible heuristic because each movement action costs 1 and reduces Manhattan distance by at most 1.\n  def heuristic(state):\n      x, y, _ = state\n      min_dist = float('inf')\n      for target_ax, target_ay, _ in primitive_target_states:\n          dist = abs(x - target_ax) + abs(y - target_ay)\n          min_dist = min(min_dist, dist)\n      return min_dist\n\n  # Open list for A*: (f_score, g_score, state, path_actions)\n  # f_score = g_score + h_score. We use g_score as a tie-breaker.\n  open_list = [(heuristic(start_state), 0, start_state, [])]\n  \n  while open_list:\n      f_current, g_current, current_state, path_actions = heapq.heappop(open_list)\n\n      # If we found a shorter path to this state already, skip this entry\n      # (due to multiple entries for the same state in the priority queue).\n      if g_current > g_score.get(current_state, float('inf')):\n          continue\n\n      # Check if the current state is a primitive target state\n      if current_state in primitive_target_states:\n          return path_actions + [USE]\n\n      # Explore possible next states by taking movement actions\n      for action_val, (next_dir, dx, dy) in ACTION_TO_EFFECT.items():\n          curr_x, curr_y, _ = current_state\n          next_x, next_y = curr_x + dx, curr_y + dy \n          next_state = (next_x, next_y, next_dir)\n\n          # Cost of a movement action is 1\n          tentative_g_score = g_current + 1 \n\n          if is_valid_and_traversable(next_x, next_y):\n              # If this path to next_state is better than any previously found path\n              if tentative_g_score < g_score.get(next_state, float('inf')):\n                  g_score[next_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(next_state)\n                  heapq.heappush(open_list, (f_score, tentative_g_score, next_state, path_actions + [action_val]))\n  \n  # If the A* search queue becomes empty and no path to a target state was found\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:22:06.277088", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 0 and dy == 0:\n      return None\n\n    # Determine primary axis movement (horizontal or vertical) for facing\n    if abs(dx) >= abs(dy): # Prioritize horizontal if magnitude is greater or equal\n      return EAST_DIR if dx > 0 else WEST_DIR\n    else: # abs(dy) > abs(dx)\n      return SOUTH_DIR if dy > 0 else NORTH_DIR\n\n  # Helper function: Returns actions to turn from current_dir to target_dir.\n  # Assumes LEFT_ACTION and RIGHT_ACTION are used for turning.\n  def _get_turn_actions(current_dir, target_dir):\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION) # Turn right\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION) # Turn left\n    return actions\n\n  primitive_id = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n\n  # Improvement 1 (from v1): Check if the primitive is grabbable.\n  if primitive_id not in env.world.grabbable_indices:\n    return [] # Cannot collect this primitive if it's not grabbable\n\n  # Improvement 2 (for v2): Check if primitive is already in inventory.\n  if current_state.inventory[primitive_id] > 0:\n      return [] # Primitive already collected, no actions needed.\n\n  agent_grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir # Agent's initial facing direction\n\n  grid_height, grid_width, _ = agent_grid.shape\n\n  # Define all indices that act as obstacles for movement.\n  # This includes non-grabbable items, workshops, and the primitive itself (cannot walk onto it).\n  movement_obstacle_indices = set()\n  movement_obstacle_indices.update(env.world.non_grabbable_indices)\n  movement_obstacle_indices.update(env.world.workshop_indices)\n  movement_obstacle_indices.add(primitive_id) # Cannot move onto the item we want to collect\n\n  def is_traversable(x, y, grid_data, obstacles_set):\n    \"\"\"Checks if a given grid cell (x, y) is within bounds and contains no obstacles.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    for kind_idx in obstacles_set:\n      if grid_data[y, x, kind_idx] == 1: # Assuming 1 means presence\n        return False\n    return True\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(agent_grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Step 1: Identify all potential collection points.\n  # These are cells from which the agent can be adjacent to *any* instance of the primitive\n  # and perform a USE action.\n  primitive_locations = set()\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n  \n  potential_collection_points = set()\n  # Define deltas for checking cardinal adjacency\n  ADJACENCY_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n\n  for px, py in primitive_locations:\n    for dx, dy in ADJACENCY_DELTAS:\n      adj_x, adj_y = px + dx, py + dy\n      # A cell is a valid collection point if it's within bounds AND it's traversable\n      # (i.e., not an obstacle for movement).\n      if is_traversable(adj_x, adj_y, agent_grid, movement_obstacle_indices):\n          potential_collection_points.add((adj_x, adj_y))\n  \n  if not potential_collection_points:\n      return [] # No valid collection points (e.g., item might be completely surrounded by obstacles)\n\n  # Step 2: BFS Pathfinding to *any* of the potential_collection_points.\n  # Using collections.deque for efficient popleft().\n  queue = collections.deque([(agent_pos_x, agent_pos_y, [])]) # (x, y, path_actions)\n  visited = set([(agent_pos_x, agent_pos_y)])\n  \n  path_to_adj_pos = []\n  chosen_adj_pos = None # The specific adjacent position the agent will move to\n  target_item_pos_for_facing = None # The specific primitive instance to face (for facing direction)\n\n  # Define movement deltas for BFS. These actions move the agent cardinally.\n  # They do NOT change the agent's facing direction.\n  ACTION_MOVES = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0),\n  }\n\n  while queue:\n    curr_x, curr_y, current_path = queue.popleft() # Efficient pop from left\n\n    # Check if the current position is one of the potential collection points\n    if (curr_x, curr_y) in potential_collection_points:\n      path_to_adj_pos = current_path\n      chosen_adj_pos = (curr_x, curr_y)\n      \n      # Now, identify *which* primitive instance this chosen_adj_pos is adjacent to.\n      # Any adjacent primitive will do for the USE action, so pick the first one found.\n      for dx, dy in ADJACENCY_DELTAS:\n          item_x, item_y = curr_x + dx, curr_y + dy\n          if 0 <= item_x < grid_width and 0 <= item_y < grid_height and \\\n             agent_grid[item_y, item_x, primitive_id] == 1: # Fixed bug: was agent_grid[y, x, primitive_id]\n              target_item_pos_for_facing = (item_x, item_y)\n              break # Found the target item for facing\n      break # Path found to a valid collection point, exit BFS\n\n    # Explore possible moves from current position\n    for action, (dx, dy) in ACTION_MOVES.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      if (next_x, next_y) not in visited: # Check visited set before traversability for slight efficiency\n        # If the cell is traversable (not an obstacle for movement)\n        if is_traversable(next_x, next_y, agent_grid, movement_obstacle_indices):\n            visited.add((next_x, next_y))\n            queue.append((next_x, next_y, current_path + [action]))\n\n  # If no path was found to any collection point (queue exhausted before finding a target)\n  if chosen_adj_pos is None:\n    return []\n\n  final_actions = list(path_to_adj_pos)\n\n  # After moving to the chosen_adj_pos, determine the direction the agent needs to face\n  # the primitive and add the necessary turning actions.\n  # The agent's `dir` (initial direction) is used as `current_dir` because the movement actions\n  # (UP, DOWN, LEFT, RIGHT) do not change the agent's facing direction.\n  if target_item_pos_for_facing is not None:\n    target_face_dir = _get_target_facing_direction(chosen_adj_pos[0], chosen_adj_pos[1], \n                                                   target_item_pos_for_facing[0], target_item_pos_for_facing[1])\n    if target_face_dir is not None:\n      # Pass the agent's *initial* direction here, as movement actions don't change it.\n      # The turn actions will then adjust from this initial direction.\n      final_actions.extend(_get_turn_actions(agent_dir, target_face_dir)) \n  \n  # Finally, add the USE action to collect the primitive\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:22:07.264875", "function_name": "collect", "function_body": "  import numpy as np\n  import collections\n\n  # Redefining constants for clarity based on the assumed DMLab-style relative movement/turning.\n  # These map directly to the integer action IDs (0, 1, 2, 3, 4) used by CraftLab.\n  MOVE_BACKWARD_ACTION = 0 # Agent moves one step backward relative to its facing direction\n  MOVE_FORWARD_ACTION = 1  # Agent moves one step forward relative to its facing direction\n  TURN_LEFT_ACTION = 2     # Agent turns 90 degrees left (counter-clockwise)\n  TURN_RIGHT_ACTION = 3    # Agent turns 90 degrees right (clockwise)\n  USE_ACTION = 4\n\n  # Agent's facing directions (integers 0-3)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Mapping directions to (dx, dy) deltas for movement\n  _DIR_TO_DELTA = {\n      NORTH_DIR: (0, -1),  # North is typically -Y\n      EAST_DIR: (1, 0),    # East is +X\n      SOUTH_DIR: (0, 1),   # South is +Y\n      WEST_DIR: (-1, 0),   # West is -X\n  }\n\n  primitive_id = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n  agent_grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir # Agent's initial facing direction\n\n  grid_height, grid_width, _ = agent_grid.shape\n\n  # Define all indices that act as obstacles for movement.\n  # This includes non-grabbable items, workshops, and the primitive itself (cannot walk onto it).\n  movement_obstacle_indices = set()\n  movement_obstacle_indices.update(env.world.non_grabbable_indices)\n  movement_obstacle_indices.update(env.world.workshop_indices)\n  movement_obstacle_indices.add(primitive_id) # Cannot move onto the item we want to collect\n\n  def is_traversable_for_movement(x, y, grid_data, obstacles_set):\n    \"\"\"Checks if a given grid cell (x, y) is within bounds and traversable.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any obstacle is present at this cell\n    for kind_idx in obstacles_set:\n      if grid_data[y, x, kind_idx] == 1: # Assuming 1 means presence\n        return False\n    return True\n\n  # Find all locations of the primitive on the grid\n  primitive_locations = set() # (x, y) coordinates of primitive instances\n  y_coords, x_coords = np.where(agent_grid[:, :, primitive_id] == 1)\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n  \n  if not primitive_locations:\n    return [] # Primitive not found on the grid\n\n  # Define the target states for BFS: (x, y, dir) where agent can perform USE\n  # A target state is an (x, y) position adjacent to a primitive, and a direction 'dir'\n  # that faces that specific primitive instance.\n  target_bfs_states = set() # Store (x, y, dir) tuples that represent a successful collection state\n\n  # Define deltas for checking cardinal adjacency\n  ADJACENCY_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n\n  for px, py in primitive_locations: # For each primitive instance on the grid\n    for dx_adj, dy_adj in ADJACENCY_DELTAS: # Check its cardinal neighbors\n      adj_x, adj_y = px + dx_adj, py + dy_adj # A potential adjacent cell from which to collect\n\n      if is_traversable_for_movement(adj_x, adj_y, agent_grid, movement_obstacle_indices):\n        # Calculate the required facing direction from (adj_x, adj_y) to (px, py)\n        # (item_x - agent_x, item_y - agent_y)\n        delta_x_to_item = px - adj_x\n        delta_y_to_item = py - adj_y\n\n        # Determine the target facing direction based on the relative position of the item\n        target_face_dir = None\n        if delta_x_to_item == 1 and delta_y_to_item == 0:  # Item is to the East\n            target_face_dir = EAST_DIR\n        elif delta_x_to_item == -1 and delta_y_to_item == 0: # Item is to the West\n            target_face_dir = WEST_DIR\n        elif delta_x_to_item == 0 and delta_y_to_item == 1:  # Item is to the South\n            target_face_dir = SOUTH_DIR\n        elif delta_x_to_item == 0 and delta_y_to_item == -1: # Item is to the North\n            target_face_dir = NORTH_DIR\n        \n        if target_face_dir is not None:\n          target_bfs_states.add((adj_x, adj_y, target_face_dir))\n\n  if not target_bfs_states:\n    return [] # No valid states to collect from (e.g., item might be completely surrounded by obstacles)\n\n  # BFS for shortest path in (x, y, direction) state space\n  # State in BFS: (current_x, current_y, current_dir)\n  # Queue element: (current_x, current_y, current_dir, path_actions_list)\n  queue = collections.deque([(agent_pos_x, agent_pos_y, agent_dir, [])])\n  # Visited set: (x, y, dir) tuples to avoid cycles and redundant exploration\n  visited = set([(agent_pos_x, agent_pos_y, agent_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, current_path = queue.popleft()\n\n    # Check if the current state (position and direction) is one of the target states\n    if (curr_x, curr_y, curr_dir) in target_bfs_states:\n      # Path found! Append the USE_ACTION to the path and return it.\n      return current_path + [USE_ACTION] \n\n    # Explore possible actions from the current state: Move Forward, Move Backward, Turn Left, Turn Right\n    \n    # 1. Try Move Forward (UP_ACTION)\n    dx_fwd, dy_fwd = _DIR_TO_DELTA[curr_dir] # Delta based on current facing direction\n    next_x_fwd, next_y_fwd = curr_x + dx_fwd, curr_y + dy_fwd\n    next_dir_fwd = curr_dir # Facing direction does not change with movement\n\n    if is_traversable_for_movement(next_x_fwd, next_y_fwd, agent_grid, movement_obstacle_indices):\n      if (next_x_fwd, next_y_fwd, next_dir_fwd) not in visited:\n        visited.add((next_x_fwd, next_y_fwd, next_dir_fwd))\n        queue.append((next_x_fwd, next_y_fwd, next_dir_fwd, current_path + [MOVE_FORWARD_ACTION]))\n\n    # 2. Try Move Backward (DOWN_ACTION)\n    dx_bwd, dy_bwd = _DIR_TO_DELTA[(curr_dir + 2) % 4] # Opposite direction delta\n    next_x_bwd, next_y_bwd = curr_x + dx_bwd, curr_y + dy_bwd\n    next_dir_bwd = curr_dir # Facing direction does not change with movement\n\n    if is_traversable_for_movement(next_x_bwd, next_y_bwd, agent_grid, movement_obstacle_indices):\n      if (next_x_bwd, next_y_bwd, next_dir_bwd) not in visited:\n        visited.add((next_x_bwd, next_y_bwd, next_dir_bwd))\n        queue.append((next_x_bwd, next_y_bwd, next_dir_bwd, current_path + [MOVE_BACKWARD_ACTION]))\n\n    # 3. Try Turn Left (TURN_LEFT_ACTION)\n    next_dir_left = (curr_dir - 1 + 4) % 4 # New direction after a 90-degree left turn\n    # Position remains unchanged during a turn\n    if (curr_x, curr_y, next_dir_left) not in visited:\n      visited.add((curr_x, curr_y, next_dir_left))\n      queue.append((curr_x, curr_y, next_dir_left, current_path + [TURN_LEFT_ACTION]))\n\n    # 4. Try Turn Right (TURN_RIGHT_ACTION)\n    next_dir_right = (curr_dir + 1) % 4 # New direction after a 90-degree right turn\n    # Position remains unchanged during a turn\n    if (curr_x, curr_y, next_dir_right) not in visited:\n      visited.add((curr_x, curr_y, next_dir_right))\n      queue.append((curr_x, curr_y, next_dir_right, current_path + [TURN_RIGHT_ACTION]))\n      \n  return [] # If the queue is exhausted and no path to a target state was found", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:23:38.956159", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants based on CraftLab.action_specs\n  ACTION_BACKWARD = 0  # Maps to DOWN\n  ACTION_FORWARD = 1   # Maps to UP\n  ACTION_TURN_LEFT = 2 # Maps to LEFT\n  ACTION_TURN_RIGHT = 3 # Maps to RIGHT\n  ACTION_USE = 4       # Maps to USE\n\n  # Direction constants for agent's facing direction (common convention)\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Relative movement deltas (dx, dy) for moving FORWARD based on current direction\n  FORWARD_DELTAS = {\n      DIR_NORTH: (0, -1),\n      DIR_EAST: (1, 0),\n      DIR_SOUTH: (0, 1),\n      DIR_WEST: (-1, 0),\n  }\n\n  # Relative movement deltas (dx, dy) for moving BACKWARD based on current direction\n  BACKWARD_DELTAS = {\n      DIR_NORTH: (0, 1),  # Backward from North is South\n      DIR_EAST: (-1, 0),  # Backward from East is West\n      DIR_SOUTH: (0, -1), # Backward from South is North\n      DIR_WEST: (1, 0),   # Backward from West is East\n  }\n\n  # Relative position of the cell directly in front of the agent for USE action\n  USE_TARGET_DELTAS = FORWARD_DELTAS # Agent uses/interacts with what's directly in front\n\n  # Get the current state from the environment\n  current_state = env._current_state\n\n  # 1. Check if primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  # Extract grid dimensions and world info for traversability\n  grid = current_state.grid\n  world = current_state.world\n  grid_width, grid_height, _ = grid.shape\n\n  # Helper function to check if a cell is traversable\n  def is_traversable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    \n    # Check if the cell contains any non-grabbable entity (obstacle)\n    for k_idx in world.non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False # This cell is an obstacle\n    \n    # Primitives themselves are assumed to be grabbable items on the ground,\n    # and thus a cell containing them is traversable (agent can walk over it).\n    return True\n\n  # Initialize BFS queue and visited set\n  # State in queue: ((current_x, current_y), current_direction), list_of_actions_taken\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  queue = collections.deque([((start_pos, start_dir), [])])\n  visited = { (start_pos, start_dir) }\n\n  found_path_actions = []\n\n  # BFS loop\n  while queue:\n    ((cx, cy), cdir), path_so_far = queue.popleft()\n\n    # Check if the primitive is directly in front of the current (pos, dir)\n    target_dx, target_dy = USE_TARGET_DELTAS[cdir]\n    px, py = cx + target_dx, cy + target_dy\n\n    # If target cell is within bounds and contains the primitive\n    if (0 <= px < grid_width and 0 <= py < grid_height) and grid[px, py, primitive] == 1:\n      found_path_actions = path_so_far + [ACTION_USE]\n      break # Found shortest path, exit BFS\n\n    # Explore next possible states by applying actions\n    # 1. Try moving FORWARD\n    fdx, fdy = FORWARD_DELTAS[cdir]\n    next_pos_f = (cx + fdx, cy + fdy)\n    if is_traversable(next_pos_f[0], next_pos_f[1]):\n      next_state_f = (next_pos_f, cdir)\n      if next_state_f not in visited:\n        visited.add(next_state_f)\n        queue.append((next_state_f, path_so_far + [ACTION_FORWARD]))\n\n    # 2. Try moving BACKWARD\n    bdx, bdy = BACKWARD_DELTAS[cdir]\n    next_pos_b = (cx + bdx, cy + bdy)\n    if is_traversable(next_pos_b[0], next_pos_b[1]):\n      next_state_b = (next_pos_b, cdir)\n      if next_state_b not in visited:\n        visited.add(next_state_b)\n        queue.append((next_state_b, path_so_far + [ACTION_BACKWARD]))\n\n    # 3. Try turning LEFT\n    next_dir_l = (cdir - 1 + 4) % 4 # Ensure direction wraps around 0-3\n    next_state_l = ((cx, cy), next_dir_l) # Position remains same for turn\n    if next_state_l not in visited:\n      visited.add(next_state_l)\n      queue.append((next_state_l, path_so_far + [ACTION_TURN_LEFT]))\n\n    # 4. Try turning RIGHT\n    next_dir_r = (cdir + 1) % 4 # Ensure direction wraps around 0-3\n    next_state_r = ((cx, cy), next_dir_r) # Position remains same for turn\n    if next_state_r not in visited:\n      visited.add(next_state_r)\n      queue.append((next_state_r, path_so_far + [ACTION_TURN_RIGHT]))\n\n  return found_path_actions", "island_id": 7, "scores": {"3": -1}}
