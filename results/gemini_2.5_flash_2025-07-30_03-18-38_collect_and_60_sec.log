{"timestamp": "2025-07-31T01:47:07.618739", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from action_specs)\n  ACTION_MOVE_SOUTH = 0\n  ACTION_MOVE_NORTH = 1\n  ACTION_MOVE_WEST = 2\n  ACTION_MOVE_EAST = 3\n  ACTION_USE = 4\n\n  # Map movement vectors (dx, dy) to corresponding action IDs.\n  # Taking these actions moves the agent in the specified direction.\n  MOVE_VECTOR_TO_ACTION_ID = {\n      (0, -1): ACTION_MOVE_NORTH, # Move North (decreases Y coordinate)\n      (0, 1): ACTION_MOVE_SOUTH,  # Move South (increases Y coordinate)\n      (-1, 0): ACTION_MOVE_WEST,  # Move West (decreases X coordinate)\n      (1, 0): ACTION_MOVE_EAST    # Move East (increases X coordinate)\n  }\n\n  # Map agent's internal direction ID (0-3) to its corresponding facing vector (dx, dy).\n  # Direction IDs: 0: North (-Y), 1: East (+X), 2: South (+Y), 3: West (-X).\n  DIRECTION_ID_TO_FACING_VECTOR = {\n      0: (0, -1),  # North: Agent is facing \"up\" on the grid\n      1: (1, 0),   # East: Agent is facing \"right\" on the grid\n      2: (0, 1),   # South: Agent is facing \"down\" on the grid\n      3: (-1, 0)   # West: Agent is facing \"left\" on the grid\n  }\n\n  # Map a movement vector (dx, dy) to the internal direction ID the agent will face\n  # after taking that move. When an agent moves, it also faces that direction.\n  MOVE_VECTOR_TO_RESULTING_DIRECTION_ID = {\n      (0, -1): 0,  # Moving North results in facing North (dir ID 0)\n      (1, 0): 1,   # Moving East results in facing East (dir ID 1)\n      (0, 1): 2,   # Moving South results in facing South (dir ID 2)\n      (-1, 0): 3   # Moving West results in facing West (dir ID 3)\n  }\n\n  # Get initial state information from the environment.\n  # The grid and agent's initial position/direction are static for pathfinding.\n  initial_obs = env.observations()\n  initial_grid = initial_obs['features_dict']['features_global']\n  initial_position = tuple(initial_obs['features_dict']['pos'].astype(int))\n  # Agent's direction is a one-hot vector, convert it to an integer ID (0-3).\n  initial_direction_id = np.argmax(initial_obs['features_dict']['direction'])\n\n  # Extract grid dimensions. The grid is structured as (WIDTH, HEIGHT, n_kinds).\n  grid_width, grid_height, _ = initial_grid.shape\n\n  # Retrieve indices of entities that block agent movement from the world configuration.\n  impassable_entity_indices = env.world.non_grabbable_indices\n\n  # --- Helper Functions for Grid and Movement Checks ---\n\n  def _is_coordinate_in_bounds(x, y):\n      \"\"\"Checks if a given (x, y) coordinate is within the grid boundaries.\"\"\"\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  def _is_cell_traversable(x, y):\n      \"\"\"Checks if the cell at (x, y) is traversable by the agent.\n      A cell is considered impassable if it's out of bounds or contains\n      any entity listed in `impassable_entity_indices`.\n      \"\"\"\n      if not _is_coordinate_in_bounds(x, y):\n          return False # Out-of-bounds cells are not traversable.\n      \n      # Iterate through all impassable entity indices to check if the cell contains any.\n      for entity_idx in impassable_entity_indices:\n          if initial_grid[x, y, entity_idx] > 0:\n              return False # Cell contains an obstacle.\n      return True # Cell is clear and traversable.\n\n  # --- Breadth-First Search (BFS) for Pathfinding ---\n\n  # The BFS queue stores states to explore. A state is represented as ((x, y), direction_id).\n  bfs_queue = collections.deque([(initial_position, initial_direction_id)])\n  \n  # The `visited_states` set keeps track of all states already explored to prevent cycles\n  # and redundant computations, ensuring the shortest path is found.\n  visited_states = set([(initial_position, initial_direction_id)])\n  \n  # The `path_reconstruction_map` is used to backtrack and build the sequence of actions\n  # after the BFS finds the target. It maps:\n  # (child_position, child_direction) -> ((parent_position, parent_direction), action_taken_to_reach_child)\n  path_reconstruction_map = {}\n\n  # This variable will store the state ((x, y), direction_id) from which the primitive\n  # can be collected using a single `ACTION_USE` action.\n  target_collection_state = None\n\n  while bfs_queue:\n      (current_x, current_y), current_direction_id = bfs_queue.popleft()\n      current_bfs_state = ((current_x, current_y), current_direction_id)\n\n      # Determine the cell directly in front of the agent based on its current position and direction.\n      facing_vector = DIRECTION_ID_TO_FACING_VECTOR[current_direction_id]\n      front_x, front_y = current_x + facing_vector[0], current_y + facing_vector[1]\n\n      # Check if the desired primitive is located in the cell directly in front of the agent.\n      if _is_coordinate_in_bounds(front_x, front_y) and initial_grid[front_x, front_y, primitive] > 0:\n          # The primitive has been found directly in front! This is a valid state to perform 'USE'.\n          target_collection_state = current_bfs_state\n          break # Exit BFS as the shortest path to a valid collection point has been found.\n\n      # Explore all possible movement actions from the current state.\n      # Each movement action also changes the agent's facing direction to the direction of movement.\n      for move_vector, action_id in MOVE_VECTOR_TO_ACTION_ID.items():\n          next_x, next_y = current_x + move_vector[0], current_y + move_vector[1]\n          next_position = (next_x, next_y)\n          # Calculate the agent's new facing direction after this movement.\n          next_direction_id = MOVE_VECTOR_TO_RESULTING_DIRECTION_ID[move_vector]\n          next_bfs_state = (next_position, next_direction_id)\n\n          # Only proceed if the next cell is traversable and this state has not been visited before.\n          if _is_cell_traversable(next_x, next_y) and next_bfs_state not in visited_states:\n              visited_states.add(next_bfs_state)\n              # Record the action taken to reach this new state from the current state.\n              path_reconstruction_map[next_bfs_state] = (current_bfs_state, action_id)\n              bfs_queue.append(next_bfs_state)\n\n  # --- Path Reconstruction ---\n\n  # If a `target_collection_state` was found during the BFS:\n  if target_collection_state:\n      # The final action in the sequence is always `ACTION_USE` to collect the primitive.\n      # The path will be built in reverse, from the target state back to the initial state.\n      actions_to_primitive = [ACTION_USE]\n      current_state_in_path = target_collection_state\n\n      # Backtrack from the `target_collection_state` to the `initial_position` and `initial_direction_id`\n      # using the `path_reconstruction_map`.\n      while current_state_in_path != (initial_position, initial_direction_id):\n          # Retrieve the parent state and the action that led to `current_state_in_path`.\n          parent_state, action_from_parent = path_reconstruction_map[current_state_in_path]\n          actions_to_primitive.append(action_from_parent)\n          current_state_in_path = parent_state\n      \n      # The actions were collected in reverse order (from goal to start), so reverse the list\n      # to get the correct sequence of actions from start to goal.\n      return actions_to_primitive[::-1]\n  else:\n      # If the BFS completed and no path to the primitive was found (queue became empty),\n      # return an empty list, indicating that the primitive is unreachable.\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T01:47:08.648412", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from env.action_specs())\n  # These constants define the agent's possible actions.\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement vectors (dx, dy) to their corresponding action ID.\n  # Taking one of these actions moves the agent and sets its facing direction\n  # to the direction of movement.\n  MOVE_VECTOR_TO_ACTION = {\n      (0, -1): ACTION_UP,    # Move North (along -Y axis)\n      (0, 1): ACTION_DOWN,   # Move South (along +Y axis)\n      (-1, 0): ACTION_LEFT,  # Move West (along -X axis)\n      (1, 0): ACTION_RIGHT   # Move East (along +X axis)\n  }\n\n  # Map movement vector to the *resulting facing direction ID* of the agent.\n  # The internal direction ID mapping is: 0: North (-Y), 1: East (+X), 2: South (+Y), 3: West (-X).\n  # This mapping specifies the new direction ID the agent will face after a move.\n  MOVE_VECTOR_TO_FACING_DIR_ID = {\n      (0, -1): 0,  # Moving North makes the agent face North (ID 0)\n      (1, 0): 1,   # Moving East makes the agent face East (ID 1)\n      (0, 1): 2,   # Moving South makes the agent face South (ID 2)\n      (-1, 0): 3   # Moving West makes the agent face West (ID 3)\n  }\n\n  # Map agent's internal direction ID to its corresponding (dx, dy) facing vector.\n  # This is used to determine the cell directly \"in front\" of the agent for the USE action.\n  FACING_DIR_ID_TO_VECTOR = {\n      0: (0, -1),  # North\n      1: (1, 0),   # East\n      2: (0, 1),   # South\n      3: (-1, 0)   # West\n  }\n\n  # Get initial state information from the environment.\n  initial_obs = env.observations()\n  # The global grid representation shows the full map of entities.\n  initial_grid = initial_obs['features_dict']['features_global']\n  # Agent's initial position as a tuple (x, y) for use as a hashable key in sets/dicts.\n  initial_pos_tuple = tuple(initial_obs['features_dict']['pos'].astype(int))\n  # Agent's initial direction, converted from one-hot vector to an integer ID (0-3).\n  initial_dir_id = np.argmax(initial_obs['features_dict']['direction'])\n\n  # Extract grid dimensions from the initial grid.\n  grid_width, grid_height, _ = initial_grid.shape\n  # Get indices of entities that are considered obstacles and cannot be traversed.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # --- Helper Functions for Grid and Movement Checks ---\n\n  def is_valid_coordinate(x, y):\n      \"\"\"Checks if a given (x, y) coordinate is within the grid boundaries.\"\"\"\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  def is_cell_traversable(x, y):\n      \"\"\"Checks if the cell at (x, y) is traversable by the agent.\"\"\"\n      if not is_valid_coordinate(x, y):\n          return False # Coordinates outside the grid are not traversable.\n      # A cell is non-traversable if it contains any of the non-grabbable entities.\n      for idx in non_grabbable_indices:\n          if initial_grid[x, y, idx] > 0:\n              return False # Cell contains an obstacle.\n      return True # Cell is clear and traversable.\n\n  # --- Breadth-First Search (BFS) for Pathfinding ---\n\n  # BFS queue: stores states to explore. A state is represented as ((x, y), direction_id).\n  bfs_queue = collections.deque([(initial_pos_tuple, initial_dir_id)])\n  # Set of visited states to prevent revisiting and cycles, ensuring the shortest path is found.\n  visited_states = set([(initial_pos_tuple, initial_dir_id)])\n  # Parent map: used to reconstruct the path after BFS.\n  # Maps child_state -> (parent_state, action_taken_to_reach_child).\n  path_reconstruction_map = {}\n\n  # This will store the state ((x, y), direction_id) from which the primitive can be collected\n  # (i.e., the state just before executing the 'USE' action).\n  target_collection_pre_use_state = None\n\n  while bfs_queue:\n      (current_x, current_y), current_dir_id = bfs_queue.popleft()\n      current_bfs_state = ((current_x, current_y), current_dir_id)\n\n      # Calculate the coordinates of the cell directly in front of the agent.\n      facing_vec = FACING_DIR_ID_TO_VECTOR[current_dir_id]\n      front_x, front_y = current_x + facing_vec[0], current_y + facing_vec[1]\n\n      # Check if the desired primitive is located in the cell directly in front.\n      if is_valid_coordinate(front_x, front_y) and initial_grid[front_x, front_y, primitive] > 0:\n          # The primitive is found! This is the goal state for our pathfinding (the state from which to USE).\n          target_collection_pre_use_state = current_bfs_state\n          break # Exit BFS, as we found the shortest path to a valid collection point.\n\n      # Explore all possible movement actions from the current state.\n      for move_vec, move_action in MOVE_VECTOR_TO_ACTION.items():\n          next_x, next_y = current_x + move_vec[0], current_y + move_vec[1]\n          next_pos_tuple = (next_x, next_y)\n          \n          # The agent's facing direction changes to the direction of movement.\n          next_dir_id = MOVE_VECTOR_TO_FACING_DIR_ID[move_vec]\n          next_bfs_state = (next_pos_tuple, next_dir_id)\n\n          # Only proceed if the next cell is traversable and this state hasn't been visited before.\n          if is_cell_traversable(next_x, next_y) and next_bfs_state not in visited_states:\n              visited_states.add(next_bfs_state)\n              # Record the action taken to reach this new state from the current state.\n              path_reconstruction_map[next_bfs_state] = (current_bfs_state, move_action)\n              bfs_queue.append(next_bfs_state)\n\n  # --- Path Reconstruction ---\n\n  # If a path to the primitive was found (i.e., target_collection_pre_use_state is not None):\n  if target_collection_pre_use_state:\n      # The final action is always 'USE' to collect the primitive.\n      actions_sequence = [ACTION_USE]\n      current_state_in_path_reconstruction = target_collection_pre_use_state\n\n      # Backtrack from the target state to the initial state using the parent map.\n      # The loop continues until we reach the original starting position and direction.\n      while current_state_in_path_reconstruction != (initial_pos_tuple, initial_dir_id):\n          # Retrieve the parent state and the action that led to the current state.\n          parent_state, action_from_parent = path_reconstruction_map[current_state_in_path_reconstruction]\n          actions_sequence.append(action_from_parent)\n          current_state_in_path_reconstruction = parent_state\n      \n      # The actions were collected in reverse order (from goal to start), so reverse the list.\n      return actions_sequence[::-1]\n  else:\n      # If the BFS completed without finding the primitive (queue became empty), return an empty list.\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T01:48:40.298353", "function_name": "collect", "function_body": "  # Retrieve action mappings from the environment's action_specs\n  action_map = env.action_specs()\n  ACTION_USE = action_map['USE']\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n\n  actions_taken = []\n  # Use the max_steps defined for the task within the CraftLab instance\n  max_steps = env.task.steps \n\n  for step_count in range(max_steps):\n    # Access the current CraftState object from the CraftLab instance\n    current_state = env._current_state \n\n    # 1. Check if the primitive is already collected (in inventory)\n    # CraftState.satisfies checks if inventory[goal_arg] > 0\n    if current_state.satisfies(None, primitive):\n      return actions_taken\n\n    # 2. Determine the next action to take\n    action = None\n    if current_state.next_to(primitive):\n      # If the primitive is in the 3x3 neighborhood (including the agent's current cell),\n      # then the agent can attempt to 'USE' it to collect.\n      action = ACTION_USE\n    else:\n      # If the primitive is not immediately next to the agent, the agent needs to move.\n      current_pos = current_state.pos  # Agent's current (x, y) grid position\n      grid = current_state.grid        # The full grid occupancy (WIDTH, HEIGHT, n_kinds)\n\n      # Find all locations on the grid where the primitive exists\n      # grid[:, :, primitive] extracts the 2D layer for the specific primitive kind\n      primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n      if len(primitive_locations) == 0:\n        # If the primitive is not found anywhere on the map, it's uncollectible.\n        # This scenario should ideally not happen if the goal is valid and reachable.\n        # Return the actions taken so far as we cannot proceed.\n        return actions_taken\n\n      # Find the closest primitive location using Manhattan distance\n      closest_location = None\n      min_dist = float('inf')\n\n      for (px, py) in primitive_locations:\n        dist = abs(px - current_pos[0]) + abs(py - current_pos[1])\n        if dist < min_dist:\n          min_dist = dist\n          closest_location = (px, py)\n\n      # Calculate the difference in coordinates (dx, dy) to reach the closest primitive\n      target_px, target_py = closest_location\n      dx = target_px - current_pos[0]\n      dy = target_py - current_pos[1]\n\n      # Choose a movement action: prioritize horizontal movement if there's an X difference,\n      # otherwise move vertically. If both are zero, the 'next_to' check should have caught it.\n      if dx != 0:\n        action = ACTION_RIGHT if dx > 0 else ACTION_LEFT\n      elif dy != 0:  # Only if dx is 0, then check dy\n        action = ACTION_DOWN if dy > 0 else ACTION_UP\n      else:\n        # This case should theoretically not be reached if `next_to` properly includes\n        # the current position and `USE` applies. If reached, it implies the agent is\n        # on the primitive's tile (dx=0, dy=0) but cannot `USE` it, or it's an uncollectible state.\n        # Break the loop as no further progress can be made.\n        break\n\n    # 3. Execute the chosen action\n    if action is not None:\n      # Perform the action and get the new state, reward, and done flag\n      reward, done, observations = env.step(action)\n      actions_taken.append(action)\n\n      # If the environment signals that the episode is done (e.g., max_steps reached), break\n      if done:\n        break\n    else:\n      # If no action could be determined (e.g., in an unresolvable state), break the loop\n      break\n\n  # Return the list of actions taken. If the loop finished without collecting,\n  # it means the goal was not achieved within max_steps or was unreachable.\n  return actions_taken", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:48:41.282328", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action mappings from CraftLab.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Map movement action to the (dr, dc) delta\n  MOVE_DELTAS = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # Map movement action to the resulting agent direction (assuming agent faces direction of movement)\n  # Directions: 0=N, 1=E, 2=S, 3=W (common DMLab convention)\n  ACTION_TO_DIR = {\n      UP: 0,    # North\n      RIGHT: 1, # East\n      DOWN: 2,  # South\n      LEFT: 3   # West\n  }\n\n  # Get the current state directly from the CraftLab environment\n  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir # This is an int 0-3\n  inventory = current_state.inventory\n\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # 1. Check if primitive is already collected\n  if inventory[primitive] > 0:\n      return []\n\n  # 2. Identify all locations of the primitive on the grid\n  primitive_locations = []\n  for r in range(HEIGHT):\n      for c in range(WIDTH):\n          if grid[r, c, primitive] > 0:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      # Primitive not found on the grid, cannot collect.\n      return []\n\n  # 3. Determine all possible target (position, direction) states for collection\n  # A target state is an (agent_pos, agent_dir) pair where agent_pos is adjacent\n  # to a primitive, and agent_dir faces that primitive.\n  target_states = set()\n  for pr, pc in primitive_locations:\n      # Iterate through 4 cardinal neighbors of the primitive\n      # (dr_p, dc_p) is the vector from the primitive's position to the agent's position\n      # 'required_dir' is the direction the agent needs to face to 'USE' the primitive\n      # Example: if agent is North of primitive (dr_p=-1, dc_p=0), primitive is South of agent,\n      # so agent needs to face South (dir 2).\n      for dr_p, dc_p, required_dir in [\n          (-1, 0, 2),  # Agent at (pr-1, pc), primitive at (pr, pc) -> agent faces South\n          (1, 0, 0),   # Agent at (pr+1, pc), primitive at (pr, pc) -> agent faces North\n          (0, -1, 1),  # Agent at (pr, pc-1), primitive at (pr, pc) -> agent faces East\n          (0, 1, 3)    # Agent at (pr, pc+1), primitive at (pr, pc) -> agent faces West\n      ]:\n          agent_r, agent_c = pr + dr_p, pc + dc_p\n          # Ensure the potential agent position is within grid boundaries\n          if 0 <= agent_r < HEIGHT and 0 <= agent_c < WIDTH:\n              target_states.add(((agent_r, agent_c), required_dir))\n\n  # 4. BFS to find the shortest path to any target state\n  # Queue stores (current_pos, path_of_actions, current_dir)\n  q = collections.deque([((initial_pos), [], initial_dir)])\n  # Visited set tracks (pos, dir) states already explored to avoid cycles\n  visited = set([(initial_pos, initial_dir)])\n\n  while q:\n      (curr_r, curr_c), actions_path, curr_dir = q.popleft()\n\n      # Check if the current state is one of the target states for collection\n      if ((curr_r, curr_c), curr_dir) in target_states:\n          return actions_path + [USE] # Path found, append USE action\n\n      # Explore possible next states via movement actions\n      for action_type, (dr, dc) in MOVE_DELTAS.items():\n          next_r, next_c = curr_r + dr, curr_c + dc\n\n          # Boundary check\n          if not (0 <= next_r < HEIGHT and 0 <= next_c < WIDTH):\n              continue\n          \n          # Obstacle check: This implementation assumes all grid cells are traversable.\n          # If certain entity kinds (e.g., in CraftWorld.environment) block movement,\n          # additional checks would be needed here. For this problem, we proceed assuming traversability.\n\n          next_dir = ACTION_TO_DIR[action_type] # Agent faces the direction of movement\n          next_state = ((next_r, next_c), next_dir)\n\n          if next_state not in visited:\n              visited.add(next_state)\n              q.append((next_state, actions_path + [action_type], next_dir))\n\n  # If BFS completes without finding a path to any collectable state\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:50:00.543780", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Define action constants based on CraftLab.action_specs\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  N_ACTIONS = 5 \n  USE_ACTION = N_ACTIONS - 1 # USE is typically the last action\n\n  # Access the current state from the environment\n  current_state = env._current_state\n  \n  # Check if the primitive is already in the inventory\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  # Get grid information and agent's current position\n  grid = current_state.grid # numpy.ndarray of shape (HEIGHT, WIDTH, n_kinds)\n  agent_pos = current_state.pos # tuple (y, x)\n  \n  # Get world information for obstacle checking and grabbable items\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n  grabbable_indices = world.grabbable_indices\n\n  # Ensure the primitive is grabbable; otherwise, it cannot be collected via 'USE' action.\n  if primitive not in grabbable_indices:\n    return [] # Cannot collect this item directly by picking it up\n\n  HEIGHT, WIDTH, _ = grid.shape # Unpack dimensions\n\n  # Find all locations on the grid where the primitive exists\n  primitive_locations = []\n  for r in range(HEIGHT):\n    for c in range(WIDTH):\n      if grid[r, c, primitive] > 0:\n        primitive_locations.append((r, c))\n\n  if not primitive_locations:\n    return [] # Primitive not found anywhere on the grid\n\n  # Identify valid target cells for BFS: any cell adjacent to a primitive location\n  # The agent needs to be adjacent to the primitive to 'USE' it.\n  target_cells = set()\n  # Relative movement deltas for checking adjacent cells (UP, DOWN, LEFT, RIGHT)\n  adj_deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n  \n  for pr, pc in primitive_locations:\n    for dy, dx in adj_deltas:\n      adj_r, adj_c = pr + dy, pc + dx\n      # Check bounds for adjacent cell\n      if 0 <= adj_r < HEIGHT and 0 <= adj_c < WIDTH:\n        target_cells.add((adj_r, adj_c))\n\n  # Prepare for BFS\n  # Queue stores (current_position, list_of_actions_to_reach_here)\n  queue = deque([(agent_pos, [])])\n  visited = {agent_pos} # Set of visited positions\n\n  # Define movement actions and their corresponding deltas\n  # (action_value, (delta_y, delta_x)) for DOWN=0, UP=1, LEFT=2, RIGHT=3\n  move_actions_map = {\n      0: (1, 0),  # DOWN\n      1: (-1, 0), # UP\n      2: (0, -1), # LEFT\n      3: (0, 1)   # RIGHT\n  }\n\n  best_path_to_adjacent = None\n\n  while queue:\n    (curr_y, curr_x), path_so_far = queue.popleft()\n\n    # If the current position is one of the target cells, we've found the shortest path\n    if (curr_y, curr_x) in target_cells:\n      best_path_to_adjacent = path_so_far\n      break # Exit BFS, as the first path found is the shortest\n\n    # Explore neighbors\n    for action_val, (dy, dx) in move_actions_map.items():\n      next_y, next_x = curr_y + dy, curr_x + dx\n\n      # Check boundary conditions\n      if not (0 <= next_y < HEIGHT and 0 <= next_x < WIDTH):\n        continue\n\n      # Check if the next cell is an obstacle (contains any non-grabbable item)\n      is_obstacle = False\n      for kind_idx in non_grabbable_indices:\n        # A cell is an obstacle if it contains any non-grabbable item.\n        if grid[next_y, next_x, kind_idx] > 0:\n          is_obstacle = True\n          break\n      if is_obstacle:\n        continue\n\n      # Check if the cell has already been visited\n      if (next_y, next_x) in visited:\n        continue\n\n      visited.add((next_y, next_x))\n      queue.append(((next_y, next_x), path_so_far + [action_val]))\n\n  if best_path_to_adjacent is None:\n    return [] # No path found to any cell adjacent to the primitive\n\n  # The path found leads to a cell from which the primitive can be 'USE'd.\n  # Append the 'USE' action\n  full_actions = best_path_to_adjacent + [USE_ACTION] \n\n  return full_actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:50:00.612890", "function_name": "collect", "function_body": "    import numpy as np\n    import collections\n\n    # Define action constants (from CraftLab.action_specs)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Define movement deltas (dr, dc) for (row, col) coordinates\n    # UP: row decreases, col same\n    # DOWN: row increases, col same\n    # LEFT: row same, col decreases\n    # RIGHT: row same, col increases\n    DELTAS = {\n        UP: (-1, 0),\n        DOWN: (1, 0),\n        LEFT: (0, -1),\n        RIGHT: (0, 1),\n    }\n\n\n    # Get current state information from the environment\n    obs = env.observations()\n    current_grid = obs['features_dict']['features_global']\n    # Ensure position is in (row, col) integer format, as it might be normalized float\n    current_pos = tuple(obs['features_dict']['pos'].astype(int))\n    current_inventory = obs['features_dict']['inventory']\n\n    # Get grid dimensions (rows, columns)\n    GRID_ROWS, GRID_COLS, _ = current_grid.shape\n\n    # 1. Check if primitive is already collected\n    if current_inventory[primitive] > 0:\n        return []\n\n    # 2. Find all locations of the primitive on the grid\n    primitive_locations = []\n    for r in range(GRID_ROWS):\n        for c in range(GRID_COLS):\n            # Check if this cell contains the primitive kind (assuming > 0 indicates presence)\n            if current_grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        # Primitive not found anywhere on the grid\n        return []\n\n    # 3. Define target cells for BFS\n    # The agent needs to move to a cell from which the primitive is in its 3x3 neighborhood\n    # (including the cell the agent is on).\n    # This means for each primitive location (pr, pc), any cell (tr, tc) such that\n    # abs(tr - pr) <= 1 and abs(tc - pc) <= 1 is a valid target cell.\n    goal_cells = set()\n    for pr, pc in primitive_locations:\n        for dr_offset in [-1, 0, 1]:\n            for dc_offset in [-1, 0, 1]:\n                tr, tc = pr + dr_offset, pc + dc_offset\n                # Check if the potential target cell is within grid boundaries\n                if 0 <= tr < GRID_ROWS and 0 <= tc < GRID_COLS:\n                    goal_cells.add((tr, tc))\n    \n    # 4. Perform Breadth-First Search (BFS) to find the shortest path to any goal_cell\n    q = collections.deque([(current_pos, [])]) # Queue stores ((row, col), [actions_taken_to_reach_here])\n    visited = {current_pos} # Set of visited (row, col) positions to prevent cycles\n\n    while q:\n        (r, c), path_actions = q.popleft()\n\n        # If the current position (r, c) is one of the goal cells, we've found a valid path\n        if (r, c) in goal_cells:\n            # Append the USE action to the path and return\n            return path_actions + [USE]\n\n        # Explore 4-directional neighbors\n        for action, (dr, dc) in DELTAS.items():\n            nr, nc = r + dr, c + dc # Calculate new row and column\n\n            # Check if the new position is within grid boundaries and has not been visited yet\n            if 0 <= nr < GRID_ROWS and 0 <= nc < GRID_COLS and (nr, nc) not in visited:\n                visited.add((nr, nc))\n                q.append(((nr, nc), path_actions + [action]))\n\n    # If the BFS completes and no path was found to any goal_cell\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:52:03.653143", "function_name": "collect", "function_body": "    # Get the current state from the CraftLab environment\n    # The `env` is a CraftLab instance. We operate from its current internal `_current_state`.\n    initial_state = env._current_state\n\n    # Check if the primitive is already collected in the initial state\n    if initial_state.satisfies(None, primitive):\n        return [] # Already collected, no actions needed\n\n    # Action constants (from CraftLab.action_specs)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n    MOVEMENT_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]\n\n    # BFS for pathfinding\n    # Queue stores tuples: (current_CraftState, list_of_actions_taken_to_reach_this_state)\n    q = collections.deque([(initial_state, [])])\n\n    # Visited set to avoid cycles and redundant computations.\n    # A state is defined by (position_x, position_y, direction, inventory_as_tuple)\n    # Using tuple(inventory.tolist()) to make the numpy array hashable.\n    # The grid state changes are implicitly handled by CraftState.step returning a new_state,\n    # and the inventory tuple includes the effect of collecting items.\n    visited = set([(initial_state.pos, initial_state.dir, tuple(initial_state.inventory.tolist()))])\n\n    # Set a maximum search depth to prevent excessively long searches or infinite loops\n    # This value can be tuned based on expected environment size/complexity.\n    # A value of 100 is often a reasonable heuristic for grid-based search where paths aren't extremely long.\n    max_search_depth = 100 \n\n    while q:\n        current_state, current_actions = q.popleft()\n\n        # Prune search if current path is too long\n        if len(current_actions) >= max_search_depth:\n            continue\n\n        # --- Try USE action if next to the primitive ---\n        if current_state.next_to(primitive):\n            # Simulate the USE action\n            # The `reward` value is not relevant for pathfinding the item.\n            _, next_state_after_use = current_state.step(ACTION_USE)\n            new_actions_after_use = current_actions + [ACTION_USE]\n\n            # If the primitive is now collected, we have found a successful path!\n            if next_state_after_use.satisfies(None, primitive):\n                return new_actions_after_use\n            \n            # If the USE action did not result in collecting the primitive,\n            # this specific `USE` sequence for this primitive is considered a dead end\n            # for this goal, so we do not add it to the queue for further exploration.\n            # This assumes that a `USE` on an adjacent primitive should collect it if possible.\n\n        # --- Try movement actions (DOWN, UP, LEFT, RIGHT) ---\n        for action in MOVEMENT_ACTIONS:\n            # Simulate the movement action\n            _, next_state = current_state.step(action)\n            new_actions = current_actions + [action]\n\n            # Represent the new state for the visited set\n            next_state_tuple = (next_state.pos, next_state.dir, tuple(next_state.inventory.tolist()))\n\n            # If this state has not been visited before, add it to the queue and visited set\n            if next_state_tuple not in visited:\n                visited.add(next_state_tuple)\n                q.append((next_state, new_actions))\n\n    # If the queue becomes empty and the primitive has not been collected,\n    # it means no path was found within the search limits.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:52:04.667764", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Constants for actions\n  UP = 1\n  DOWN = 0\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  actions_taken = []\n  current_obs = env.reset() # Get initial observation\n\n  MAX_TOTAL_ACTIONS = 500 # Safety break to prevent infinite loops and manage execution time\n\n  for _ in range(MAX_TOTAL_ACTIONS):\n    inventory = current_obs['features_dict']['inventory']\n    if inventory[primitive] > 0:\n      break # Goal achieved, primitive is in inventory\n\n    grid = current_obs['features_dict']['features_global']\n    pos = tuple(current_obs['features_dict']['pos'])\n    # Direction is one-hot; convert to int index (0:N, 1:E, 2:S, 3:W assumed for DMLab-like)\n    direction = np.argmax(current_obs['features_dict']['direction'])\n\n    # Direction vectors for (dy, dx) mapping to dir_idx\n    DIR_VECTORS = {\n        0: (-1, 0),  # North: moving up (decreasing row)\n        1: (0, 1),   # East: moving right (increasing col)\n        2: (1, 0),   # South: moving down (increasing row)\n        3: (0, -1)   # West: moving left (decreasing col)\n    }\n\n    # 1. Check if primitive is directly in front and use it\n    dr, dc = DIR_VECTORS[direction]\n    cell_in_front_r, cell_in_front_c = pos[0] + dr, pos[1] + dc\n    \n    is_primitive_in_front = False\n    if (0 <= cell_in_front_r < grid.shape[0] and\n        0 <= cell_in_front_c < grid.shape[1]):\n      if grid[cell_in_front_r, cell_in_front_c, primitive] == 1:\n        is_primitive_in_front = True\n\n    if is_primitive_in_front:\n      # Primitive is in front, USE it\n      _, _, current_obs = env.step(USE)\n      actions_taken.append(USE)\n      continue # Re-check inventory in the next iteration\n\n    # 2. Find the closest primitive on the grid using a Breadth-First Search (BFS)\n    # The BFS searches for the coordinates (r, c) of the primitive.\n    target_coords = None\n    \n    q_bfs = deque([(pos, [])]) # Queue stores (coordinate, path_from_start_to_coord)\n    v_bfs = {pos} # Visited set for coordinates to avoid cycles\n    \n    # Max search depth for BFS to limit computation per step and prevent searching entire map\n    MAX_BFS_DEPTH = 50 \n\n    path_to_target_coord_relative = None # Path of relative (dy,dx) steps to target\n\n    while q_bfs:\n      (r_bfs, c_bfs), current_path_bfs = q_bfs.popleft()\n\n      if len(current_path_bfs) > MAX_BFS_DEPTH: # Limit search depth\n        continue\n\n      # Check if this cell contains the primitive\n      if grid[r_bfs, c_bfs, primitive] == 1:\n        target_coords = (r_bfs, c_bfs)\n        path_to_target_coord_relative = current_path_bfs # This is path from (pos) to (target_coords)\n        break # Found the closest primitive\n\n      # Explore neighbors (UP, DOWN, LEFT, RIGHT in terms of absolute grid coordinates)\n      for d_r, d_c in [(-1, 0), (1, 0), (0, -1), (0, 1)]: \n        n_r, n_c = r_bfs + d_r, c_bfs + d_c\n        new_pos_bfs = (n_r, n_c)\n\n        if (0 <= n_r < grid.shape[0] and 0 <= n_c < grid.shape[1] and\n            new_pos_bfs not in v_bfs):\n          v_bfs.add(new_pos_bfs)\n          q_bfs.append((new_pos_bfs, current_path_bfs + [new_pos_bfs]))\n\n    # 3. If a target primitive was found, navigate towards it\n    if target_coords:\n      # We found the path to the primitive's location.\n      # Take the first step on this path.\n\n      if len(path_to_target_coord_relative) > 0:\n        # Get the next coordinate on the shortest path from current pos to target\n        next_pos_on_path = path_to_target_coord_relative[0] \n\n        # Calculate relative movement needed (dy, dx) from current position to next step\n        target_dy = next_pos_on_path[0] - pos[0]\n        target_dx = next_pos_on_path[1] - pos[1]\n\n        # Determine which action (turn/move) to take based on agent's current direction\n        curr_dir_vec = DIR_VECTORS[direction]\n        action_to_take = None\n\n        if (target_dy, target_dx) == curr_dir_vec:\n          # Already facing the correct direction, move forward\n          action_to_take = UP\n        else:\n          # Need to turn. Determine the required absolute direction index of the target\n          def _get_dir_idx_from_vec(dy, dx):\n            for idx, vec in DIR_VECTORS.items():\n              if vec == (dy, dx):\n                return idx\n            return -1 # Should not happen for valid single steps\n\n          target_dir_idx = _get_dir_idx_from_vec(target_dy, target_dx)\n          \n          # Calculate the relative turn needed (0: no turn, 1: right, 2: 180, 3: left)\n          relative_turn = (target_dir_idx - direction + 4) % 4\n          \n          if relative_turn == 1: # Turn right once\n            action_to_take = RIGHT\n          elif relative_turn == 3: # Turn left once\n            action_to_take = LEFT\n          elif relative_turn == 2: # 180 degree turn, take right turn twice\n            action_to_take = RIGHT # Take one right turn, will complete 180 in next step if needed\n          else: # relative_turn == 0, implies no movement or already facing, or error. Just turn right.\n            action_to_take = RIGHT\n        \n        _, _, current_obs = env.step(action_to_take)\n        actions_taken.append(action_to_take)\n\n      else: \n        # path_to_target_coord_relative is empty, meaning agent is already at `target_coords`.\n        # This implies the primitive is on the agent's current cell (pos == target_coords).\n        # Since 'USE' needs primitive in front, try turning to face an adjacent primitive.\n        \n        found_adjacent_primitive_to_face = False\n        for i in range(4): # Try all 4 absolute directions relative to current agent direction\n          # Simulate turning to face each direction and checking the cell in front\n          temp_dir = (direction + i) % 4\n          temp_dr, temp_dc = DIR_VECTORS[temp_dir]\n          adj_r, adj_c = pos[0] + temp_dr, pos[1] + temp_dc\n          \n          if (0 <= adj_r < grid.shape[0] and 0 <= adj_c < grid.shape[1] and\n              grid[adj_r, adj_c, primitive] == 1):\n            # Found an adjacent primitive in this direction. Turn to face it.\n            if i == 0: # Already facing it\n              pass \n            elif i == 1: # 90 deg right\n              _, _, current_obs = env.step(RIGHT)\n              actions_taken.append(RIGHT)\n            elif i == 2: # 180 deg\n              _, _, current_obs = env.step(RIGHT)\n              actions_taken.append(RIGHT)\n            elif i == 3: # 90 deg left\n              _, _, current_obs = env.step(LEFT)\n              actions_taken.append(LEFT)\n            \n            found_adjacent_primitive_to_face = True\n            break # Break from finding a direction\n        \n        if not found_adjacent_primitive_to_face:\n            # Primitive is at agent's location, but not in any adjacent cell.\n            # This implies it might be on the same cell layer.\n            # If 'USE' only acts on things *in front*, and it's not in front,\n            # then it cannot be collected from this specific spot.\n            # Fallback: Just try to move to explore, perhaps it needs a different angle.\n            _, _, current_obs = env.step(RIGHT)\n            actions_taken.append(RIGHT)\n            _, _, current_obs = env.step(UP)\n            actions_taken.append(UP)\n\n    else:\n      # No primitive found on the map within BFS search depth.\n      # This could mean it doesn't exist, is fully blocked, or too far.\n      # Fallback to a simple exploration strategy: turn right and move forward.\n      _, _, current_obs = env.step(RIGHT)\n      actions_taken.append(RIGHT)\n      _, _, current_obs = env.step(UP)\n      actions_taken.append(UP)\n          \n  return actions_taken", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:53:24.484574", "function_name": "collect", "function_body": "  import collections # For deque\n\n  # Get initial state and grid from the CraftLab environment\n  initial_state = env._current_state\n  initial_grid = initial_state.grid\n  WIDTH, HEIGHT, _ = initial_grid.shape # Grid shape (width, height, n_kinds)\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial direction (0=N, 1=E, 2=S, 3=W)\n\n  # Define actions and their (dx, dy) deltas.\n  # These map to the integer values returned by CraftLab.action_specs().\n  # Assuming (0,0) is top-left, x increases right, y increases down.\n  _DOWN_ACTION = 0\n  _UP_ACTION = 1\n  _LEFT_ACTION = 2\n  _RIGHT_ACTION = 3\n  _USE_ACTION = 4 # The action to 'use' an item (e.g., mine stone, chop wood)\n\n  _ACTION_DELTAS = {\n      _UP_ACTION: (0, -1),   # Move up (decrease y)\n      _DOWN_ACTION: (0, 1),    # Move down (increase y)\n      _LEFT_ACTION: (-1, 0),  # Move left (decrease x)\n      _RIGHT_ACTION: (1, 0),   # Move right (increase x)\n  }\n\n  # Mapping of movement action to the resulting facing direction of the agent.\n  # Assuming the agent faces the direction it moves into.\n  _ACTION_TO_DIR = {\n      _UP_ACTION: 0,   # North\n      _DOWN_ACTION: 2,   # South\n      _LEFT_ACTION: 3,  # West\n      _RIGHT_ACTION: 1,  # East\n  }\n\n  # Mapping of direction to delta for the cell \"in front\" of the agent.\n  # This is where the USE action would typically apply.\n  _DIR_TO_FRONT_DELTA = {\n      0: (0, -1), # North: (x, y-1)\n      1: (1, 0),  # East: (x+1, y)\n      2: (0, 1),  # South: (x, y+1)\n      3: (-1, 0), # West: (x-1, y)\n  }\n\n  # Helper function to check if a cell is blocked for movement.\n  # A cell is blocked if it's out of bounds or contains a non-grabbable item\n  # that is not a workshop and not water (as these are typically traversable).\n  def _is_blocked(x, y, grid, world):\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return True # Out of bounds is blocked\n      for k_idx in world.non_grabbable_indices:\n          if grid[x, y, k_idx] > 0:\n              if k_idx not in world.workshop_indices and k_idx != world.water_index:\n                  return True\n      return False\n\n  # Determine if the primitive is grabbable (collected by walking over)\n  # or requires the USE action (collected by standing adjacent and using).\n  if primitive in env.world.grabbable_indices:\n      # Case 1: Primitive is grabbable (e.g., resources on the ground).\n      # Collection happens by simply reaching the cell where it's located.\n      # BFS state: (current_x, current_y, path_actions_list).\n      # Agent direction does not matter for collection in this case.\n      queue = collections.deque([(start_x, start_y, [])])\n      visited = set([(start_x, start_y)]) # Visited states (x, y)\n\n      while queue:\n          curr_x, curr_y, path_actions = queue.popleft()\n\n          # If the current position contains the primitive, we've found it.\n          if initial_grid[curr_x, curr_y, primitive] > 0:\n              return path_actions\n\n          # Explore valid neighboring cells\n          for action_val, (dx, dy) in _ACTION_DELTAS.items():\n              next_x, next_y = curr_x + dx, curr_y + dy\n\n              if _is_blocked(next_x, next_y, initial_grid, env.world):\n                  continue\n\n              if (next_x, next_y) not in visited:\n                  visited.add((next_x, next_y))\n                  new_path_actions = path_actions + [action_val]\n                  queue.append((next_x, next_y, new_path_actions))\n\n      # If no path found to a grabbable item\n      return []\n\n  else:\n      # Case 2: Primitive is not grabbable (e.g., stone, tree that needs to be mined/chopped).\n      # This requires the agent to stand in an adjacent cell, face the primitive,\n      # and then perform a _USE_ACTION.\n      # BFS state: (current_x, current_y, current_direction, path_actions_list).\n      queue = collections.deque([(start_x, start_y, start_dir, [])])\n      visited = set([(start_x, start_y, start_dir)]) # Visited states (x, y, dir)\n\n      while queue:\n          curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n          # Check if the cell directly in front of the agent contains the primitive.\n          dx_front, dy_front = _DIR_TO_FRONT_DELTA[curr_dir]\n          front_x, front_y = curr_x + dx_front, curr_y + dy_front\n\n          # If the primitive is in front and within bounds, we have found a path.\n          if (0 <= front_x < WIDTH and 0 <= front_y < HEIGHT and\n              initial_grid[front_x, front_y, primitive] > 0):\n              return path_actions + [_USE_ACTION] # Add the USE action and return the complete path\n\n          # Explore movement actions. Moving also changes the agent's facing direction.\n          for move_action_val, (dx, dy) in _ACTION_DELTAS.items():\n              next_x, next_y = curr_x + dx, curr_y + dy\n              next_dir = _ACTION_TO_DIR[move_action_val] # Agent's new direction after this move\n\n              if _is_blocked(next_x, next_y, initial_grid, env.world):\n                  continue\n\n              if (next_x, next_y, next_dir) not in visited:\n                  visited.add((next_x, next_y, next_dir))\n                  new_path_actions = path_actions + [move_action_val]\n                  queue.append((next_x, next_y, next_dir, new_path_actions))\n\n      # If no path found to a non-grabbable item after exhaustive search\n      return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:53:25.450080", "function_name": "collect", "function_body": "  import collections\n\n  initial_state = env._current_state\n  initial_grid = initial_state.grid\n  WIDTH, HEIGHT, _ = initial_grid.shape # Grid shape (width, height, n_kinds)\n  start_x, start_y = initial_state.pos\n\n  # Define actions and their (dx, dy) deltas.\n  # These map to the integer values returned by CraftLab.action_specs().\n  _DOWN_ACTION = 0\n  _UP_ACTION = 1\n  _LEFT_ACTION = 2\n  _RIGHT_ACTION = 3\n  _USE_ACTION = 4 # The USE action\n\n  _ACTION_DELTAS = {\n      _UP_ACTION: (0, -1),   # Move up (decrease y)\n      _DOWN_ACTION: (0, 1),    # Move down (increase y)\n      _LEFT_ACTION: (-1, 0),  # Move left (decrease x)\n      _RIGHT_ACTION: (1, 0),   # Move right (increase x)\n  }\n\n  is_grabbable = primitive in env.world.grabbable_indices\n  is_stone = primitive == env.world.stone_index\n  is_water = primitive == env.world.water_index\n\n  # This function aims to collect a primitive.\n  # If it's not grabbable, and not a 'use'-able environmental primitive (like stone or water),\n  # then this function cannot collect it directly.\n  if not is_grabbable and not is_stone and not is_water:\n      return []\n\n  # BFS Queue: stores (current_x, current_y, path_actions_list)\n  queue = collections.deque([(start_x, start_y, [])])\n\n  # Visited set to prevent cycles and redundant explorations.\n  visited = set([(start_x, start_y)])\n\n  # BFS loop\n  while queue:\n      curr_x, curr_y, path_actions = queue.popleft()\n\n      # --- Check if the current position satisfies the collection condition ---\n      if is_grabbable:\n          # For grabbable items, the target is to be on the same cell as the item.\n          if initial_grid[curr_x, curr_y, primitive] > 0:\n              return path_actions # Path to reach and collect the grabbable item\n      elif is_stone:\n          # Stone is typically impassable. The agent must be adjacent to it to 'USE' it.\n          # Check 8 surrounding cells (excluding the agent's current cell).\n          stone_found_adjacent = False\n          for dx_adj in [-1, 0, 1]:\n              for dy_adj in [-1, 0, 1]:\n                  if dx_adj == 0 and dy_adj == 0: continue # Skip current cell for strict adjacency\n                  nx_adj, ny_adj = curr_x + dx_adj, curr_y + dy_adj\n                  if 0 <= nx_adj < WIDTH and 0 <= ny_adj < HEIGHT:\n                      if initial_grid[nx_adj, ny_adj, primitive] > 0:\n                          stone_found_adjacent = True\n                          break\n              if stone_found_adjacent: break # Found stone in neighborhood\n\n          if stone_found_adjacent:\n              return path_actions + [_USE_ACTION] # Path to position + USE action\n      elif is_water:\n          # Water is typically traversable. The agent can be on a water cell or adjacent to it to 'USE' it.\n          # Check the 3x3 neighborhood (including the agent's current cell), mimicking CraftState.next_to.\n          water_found_near = False\n          for dx_adj in [-1, 0, 1]:\n              for dy_adj in [-1, 0, 1]:\n                  nx_adj, ny_adj = curr_x + dx_adj, curr_y + dy_adj\n                  if 0 <= nx_adj < WIDTH and 0 <= ny_adj < HEIGHT:\n                      if initial_grid[nx_adj, ny_adj, primitive] > 0:\n                          water_found_near = True\n                          break\n              if water_found_near: break # Found water in neighborhood\n\n          if water_found_near:\n              return path_actions + [_USE_ACTION] # Path to position + USE action\n      # --- End of collection condition check ---\n\n      # Explore neighbors for movement\n      for action_val, (dx, dy) in _ACTION_DELTAS.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n\n          # Check boundaries: ensure the next position is within the grid.\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check if the next cell is blocked by impassable terrain.\n          # A cell is considered blocked if it contains any non-grabbable item\n          # that is not a workshop and not water (as workshops and water are typically traversable).\n          is_blocked_by_impassable = False\n          for k_idx in env.world.non_grabbable_indices:\n              if initial_grid[next_x, next_y, k_idx] > 0:\n                  if k_idx not in env.world.workshop_indices and k_idx != env.world.water_index:\n                      is_blocked_by_impassable = True\n                      break\n          if is_blocked_by_impassable:\n              continue # This cell is blocked, don't move here\n\n          # If the cell is not blocked and has not been visited, add it to the queue.\n          if (next_x, next_y) not in visited:\n              visited.add((next_x, next_y))\n              new_path_actions = path_actions + [action_val]\n              queue.append((next_x, next_y, new_path_actions))\n\n  # If no path to collect the primitive is found after exploring all reachable cells, return an empty list.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T01:55:09.420498", "function_name": "collect", "function_body": "", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:55:10.407076", "function_name": "collect", "function_body": "  # Get current state information directly from the CraftLab's internal state\n  current_state = env._current_state\n  grid = current_state.grid\n  init_pos = current_state.pos\n  fixed_agent_dir = current_state.dir # This direction is fixed throughout the episode\n\n  height, width, n_kinds = grid.shape\n\n  # Define action mappings consistent with env_factory.py and CraftState\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction vectors for (dr, dc) based on agent's internal direction / movement actions\n  # These are also used by CraftState's _use method to determine the \"cell in front\"\n  DELTAS = {\n      0: (1, 0),  # DOWN: (row + 1, col)\n      1: (-1, 0), # UP:   (row - 1, col)\n      2: (0, -1), # LEFT: (row, col - 1)\n      3: (0, 1)   # RIGHT: (row, col + 1)\n  }\n\n  # Movement actions list\n  MOVE_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]\n\n  # Determine the required relative position for the agent to use a target.\n  # If the agent's fixed direction is D (e.g., 0 for DOWN), it means it's facing\n  # (dr_D, dc_D). Thus, it can \"USE\" an item located at (current_r + dr_D, current_c + dc_D).\n  # Conversely, if a primitive is at (pr, pc), the agent must be at\n  # (pr - dr_D, pc - dc_D) to be able to use it.\n  required_delta_for_use = DELTAS[fixed_agent_dir]\n\n  # Find all \"pre-use\" positions for the primitive.\n  # These are the cells where the agent needs to stand to successfully USE the primitive.\n  target_pre_use_positions = set()\n  for r in range(height):\n    for c in range(width):\n      if grid[r, c, primitive] > 0: # Found a primitive at (r, c)\n        # Calculate the cell from which the agent can USE this primitive\n        pre_use_r = r - required_delta_for_use[0]\n        pre_use_c = c - required_delta_for_use[1]\n\n        # Check if this calculated pre-use position is within the grid boundaries\n        if 0 <= pre_use_r < height and 0 <= pre_use_c < width:\n          target_pre_use_positions.add((pre_use_r, pre_use_c))\n\n  # If no primitive is found, or no valid pre-use position exists for any found primitive,\n  # it's impossible to collect it.\n  if not target_pre_use_positions:\n    return []\n\n  # Breadth-First Search (BFS) to find the shortest path to any target_pre_use_position.\n  q = collections.deque()\n  # Each item in the queue is a tuple: (row, col, list_of_actions_taken_to_reach_here)\n  q.append((init_pos[0], init_pos[1], []))\n\n  # A set to keep track of visited (row, col) states to prevent cycles and redundant paths.\n  # The agent's direction is constant, so it's not part of the visited state for movement.\n  visited = set([(init_pos[0], init_pos[1])])\n\n  while q:\n    r, c, actions = q.popleft()\n\n    # Check if the current position (r, c) is one of our desired target pre-use positions.\n    if (r, c) in target_pre_use_positions:\n      # If so, we've found the shortest path to a spot from where we can USE the primitive.\n      # Append the USE action and return the complete sequence of actions.\n      return actions + [ACTION_USE]\n\n    # If not a goal state, explore all possible movement actions from the current position.\n    for action in MOVE_ACTIONS:\n      dr, dc = DELTAS[action] # Get the change in row and column for this movement action\n      nr, nc = r + dr, c + dc # Calculate the new row and column\n\n      # Check if the new position is within the grid boundaries.\n      if not (0 <= nr < height and 0 <= nc < width):\n        continue\n\n      # Obstacle check: This implementation assumes all cells are traversable for movement.\n      # If specific entity kinds (like 'water' or 'stone') were impassable,\n      # a check `if grid[nr, nc, kind_idx] > 0` for those kinds would be needed here.\n      # Without explicit definition of impassable terrain, we assume free movement.\n\n      # If the new position has not been visited yet, add it to the queue for exploration.\n      if (nr, nc) not in visited:\n        visited.add((nr, nc))\n        q.append((nr, nc, actions + [action]))\n\n  # If the BFS completes and the queue becomes empty without finding a path to any\n  # target pre-use position, it means the primitive is unreachable.\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:56:57.630777", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Maximum number of steps allowed for collection, including movements and the final USE.\n  # This acts as a safeguard against excessively long or infinite searches.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent.\n  # This maps an agent's position and direction to the (y, x) coordinates\n  # of the cell it is facing.\n  def _get_facing_coords(agent_y, agent_x, agent_direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent.\n      Assumes CraftState.dir: 0=East, 1=South, 2=West, 3=North.\n      \"\"\"\n      if agent_direction == DIR_EAST:\n          return (agent_y, agent_x + 1)\n      elif agent_direction == DIR_SOUTH:\n          return (agent_y + 1, agent_x)\n      elif agent_direction == DIR_WEST:\n          return (agent_y, agent_x - 1)\n      elif agent_direction == DIR_NORTH:\n          return (agent_y - 1, agent_x)\n      # Fallback for invalid direction, though typically not expected in valid CraftWorld states.\n      return (agent_y, agent_x) \n\n  # Retrieve the current state from the CraftLab environment.\n  current_state = env._current_state\n\n  # --- Input Validation and Early Exit Conditions ---\n  # Improved order: Check if primitive ID is valid before checking its properties.\n  # 1. If the primitive ID is not a recognized entity kind in this world, it's invalid.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # 2. If the primitive is not in the world's grabbable items, it cannot be collected.\n  if primitive not in current_state.world.grabbable_indices:\n      return []\n\n  # 3. If the primitive has already been collected (i.e., it's in inventory), no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # --- Initialize State Information for BFS ---\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  \n  # Agent's starting position and direction. We operate from the *current* state of the environment.\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir \n\n  # Determine which entity kinds are truly impassable for agent movement.\n  impassable_for_movement = set()\n  \n  # Water is a common movement blocker.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  # All non-grabbable items are considered impassable *unless* they are workshops.\n  for kind_idx in current_state.world.non_grabbable_indices:\n      if kind_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(kind_idx)\n\n  # Define all possible movement actions and their effects on agent state.\n  # Format: {action_id: (resulting_direction_after_move, delta_y, delta_x)}\n  movement_actions_map = {\n      ACTION_UP:    (DIR_NORTH, -1, 0),\n      ACTION_DOWN:  (DIR_SOUTH, 1, 0),\n      ACTION_LEFT:  (DIR_WEST, 0, -1),\n      ACTION_RIGHT: (DIR_EAST, 0, 1)\n  }\n\n  # --- Breadth-First Search (BFS) Initialization ---\n  # The BFS queue stores tuples of (y, x, direction, current_path_length).\n  bfs_queue = collections.deque()\n  bfs_queue.append((start_y, start_x, start_dir, 0))\n\n  # This dictionary stores the path taken to reach each state (y, x, direction).\n  # It maps `(child_y, child_x, child_dir)` to `(action_from_parent, parent_y, parent_x, parent_dir)`.\n  path_predecessor_map = {(start_y, start_x, start_dir): (None, None, None, None)}\n\n  # This variable will store the target state (y, x, dir) from which the primitive can be collected.\n  goal_collection_state = None \n\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # --- BFS Main Loop ---\n  while bfs_queue:\n      curr_y, curr_x, curr_dir, current_path_length = bfs_queue.popleft()\n\n      # Check if the current agent state (position and direction) allows for immediate collection.\n      # We check `current_path_length + 1` because the `ACTION_USE` itself consumes one step.\n      if current_path_length + 1 <= MAX_COLLECT_STEPS:\n          facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n          # If the cell in front of the agent contains the primitive, we have found a valid collection point.\n          if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n              full_grid[facing_y, facing_x, primitive] > 0):\n              \n              goal_collection_state = (curr_y, curr_x, curr_dir)\n              break # Found the shortest path to a collection state.\n\n      # Explore all possible movement actions from the current state.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          next_path_length = current_path_length + 1 # Each move adds one step.\n\n          # Pruning: If the current path plus this move, plus the final USE action,\n          # exceeds the maximum allowed steps, then this path is too long.\n          if next_path_length + 1 > MAX_COLLECT_STEPS:\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable (not blocked by impassable items).\n          is_traversable = True\n          for kind_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, kind_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # Check if this new state (position and direction) has already been visited.\n          if (next_y, next_x, next_dir) not in path_predecessor_map:\n              # Record the action taken and the parent state to reconstruct the path later.\n              path_predecessor_map[(next_y, next_x, next_dir)] = (action_move, curr_y, curr_x, curr_dir)\n              # Add the new valid state to the queue for further exploration.\n              bfs_queue.append((next_y, next_x, next_dir, next_path_length))\n\n  # --- Path Reconstruction ---\n  # If no goal collection state was found by BFS, it means the primitive is unreachable.\n  if goal_collection_state is None:\n      return []\n\n  reconstructed_path = []\n  current_node = goal_collection_state\n  # Backtrack from the goal node to the start node using the predecessor map.\n  while path_predecessor_map[current_node][0] is not None:\n      action_from_parent, parent_y, parent_x, parent_dir = path_predecessor_map[current_node]\n      reconstructed_path.append(action_from_parent)\n      current_node = (parent_y, parent_x, parent_dir)\n  \n  # The path was built in reverse order, so reverse it.\n  reconstructed_path.reverse()\n  \n  # Add the final `ACTION_USE` to collect the primitive.\n  reconstructed_path.append(ACTION_USE)\n\n  # --- Execute the Found Path and Monitor Collection Status ---\n  executed_actions = []\n  for action in reconstructed_path:\n      executed_actions.append(action)\n      # Perform the action in the environment.\n      reward, done, _ = env.step(action)\n      # Always update the `current_state` reference to reflect the environment's new state.\n      current_state = env._current_state\n\n      # Early exit: If the primitive is successfully collected, return the actions taken.\n      if current_state.inventory[primitive] > 0:\n          return executed_actions\n\n      # Early exit: If the episode ends prematurely (e.g., max_steps reached)\n      # AND the primitive has NOT been collected, then this attempt failed.\n      if done and current_state.inventory[primitive] <= 0:\n          return []\n\n  # Final check: After executing all actions, verify if the primitive was collected.\n  if current_state.inventory[primitive] > 0:\n      return executed_actions\n  else:\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T01:56:58.609226", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Maximum number of steps allowed for collection, including movements and the final USE.\n  # This acts as a safeguard against excessively long or infinite searches.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent.\n  # This maps an agent's position and direction to the (y, x) coordinates\n  # of the cell it is facing.\n  def _get_facing_coords(agent_y, agent_x, agent_direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent.\n      Assumes CraftState.dir: 0=East, 1=South, 2=West, 3=North.\n      \"\"\"\n      if agent_direction == DIR_EAST:\n          return (agent_y, agent_x + 1)\n      elif agent_direction == DIR_SOUTH:\n          return (agent_y + 1, agent_x)\n      elif agent_direction == DIR_WEST:\n          return (agent_y, agent_x - 1)\n      elif agent_direction == DIR_NORTH:\n          return (agent_y - 1, agent_x)\n      return (agent_y, agent_x) # Should not be reached with valid directions\n\n  # Retrieve the current state from the CraftLab environment.\n  # The 'env' object is an instance of CraftLab, which holds the current CraftState.\n  current_state = env._current_state\n\n  # --- Input Validation and Early Exit Conditions ---\n  # 1. If the primitive is not in the world's grabbable items, it cannot be collected.\n  if primitive not in current_state.world.grabbable_indices:\n      return []\n\n  # 2. If the primitive ID is not a recognized entity kind in this world, it's invalid.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # 3. If the primitive has already been collected (i.e., it's in inventory), no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # --- Initialize State Information for BFS ---\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  \n  # Agent's starting position and direction. We operate from the *current* state of the environment.\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir \n\n  # Determine which entity kinds are truly impassable for agent movement.\n  # This set includes non-grabbable items that are *not* workshops, and potentially water.\n  impassable_for_movement = current_state.world.non_grabbable_indices - current_state.world.workshop_indices\n  \n  # Add water to the impassable set if it exists in the world.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n\n  # Define all possible movement actions and their effects on agent state.\n  # Format: {action_id: (resulting_direction_after_move, delta_y, delta_x)}\n  movement_actions_map = {\n      ACTION_UP:    (DIR_NORTH, -1, 0),\n      ACTION_DOWN:  (DIR_SOUTH, 1, 0),\n      ACTION_LEFT:  (DIR_WEST, 0, -1),\n      ACTION_RIGHT: (DIR_EAST, 0, 1)\n  }\n\n  # --- Breadth-First Search (BFS) Initialization ---\n  # The BFS queue stores tuples of (y, x, direction, current_path_length).\n  # `current_path_length` represents number of movement steps to reach (y,x,direction).\n  bfs_queue = collections.deque()\n  bfs_queue.append((start_y, start_x, start_dir, 0))\n\n  # This dictionary stores the path taken to reach each state (y, x, direction).\n  # It maps `(child_y, child_x, child_dir)` to `(action_from_parent, parent_y, parent_x, parent_dir)`.\n  # This allows reconstruction of the shortest path once the goal is found.\n  path_predecessor_map = {(start_y, start_x, start_dir): (None, None, None, None)}\n\n  # This variable will store the target state (y, x, dir) from which the primitive can be collected.\n  # It will be populated by the BFS.\n  goal_collection_state = None \n\n  # If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # --- BFS Main Loop ---\n  while bfs_queue:\n      curr_y, curr_x, curr_dir, current_path_length = bfs_queue.popleft()\n\n      # Check if the current agent state (position and direction) allows for immediate collection.\n      # We check `current_path_length + 1` because the `ACTION_USE` itself consumes one step.\n      if current_path_length + 1 <= MAX_COLLECT_STEPS:\n          facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n          # If the cell in front of the agent contains the primitive, we have found a valid collection point.\n          if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n              full_grid[facing_y, facing_x, primitive] > 0):\n              \n              goal_collection_state = (curr_y, curr_x, curr_dir)\n              break # Found the shortest path to a collection state (due to BFS property).\n\n      # Explore all possible movement actions from the current state.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          next_path_length = current_path_length + 1 # Each move adds one step.\n\n          # Pruning: If the current path plus this move, plus the final USE action,\n          # exceeds the maximum allowed steps, then this path is too long.\n          if next_path_length + 1 > MAX_COLLECT_STEPS:\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable.\n          # Get all entity kinds present at the next cell's position.\n          present_kinds_at_next_cell = np.where(full_grid[next_y, next_x, :] > 0)[0]\n          is_traversable = True\n          for kind_idx in present_kinds_at_next_cell:\n              # If any of the present kinds are in our list of impassable items, then this cell is not traversable.\n              if kind_idx in impassable_for_movement:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # Check if this new state (position and direction) has already been visited.\n          # This prevents redundant computations and infinite loops in cyclic environments.\n          if (next_y, next_x, next_dir) not in path_predecessor_map:\n              # Record the action taken and the parent state to reconstruct the path later.\n              path_predecessor_map[(next_y, next_x, next_dir)] = (action_move, curr_y, curr_x, curr_dir)\n              # Add the new valid state to the queue for further exploration.\n              bfs_queue.append((next_y, next_x, next_dir, next_path_length))\n\n  # --- Path Reconstruction ---\n  # If no goal collection state was found by BFS, it means the primitive is unreachable.\n  if goal_collection_state is None:\n      return []\n\n  reconstructed_path = []\n  current_node = goal_collection_state\n  # Backtrack from the goal node to the start node using the predecessor map.\n  # The loop continues until the start node is reached.\n  while current_node != (start_y, start_x, start_dir):\n      action_from_parent, parent_y, parent_x, parent_dir = path_predecessor_map[current_node]\n      reconstructed_path.append(action_from_parent)\n      current_node = (parent_y, parent_x, parent_dir)\n  \n  # The path was built in reverse order (from goal back to start), so reverse it.\n  reconstructed_path.reverse()\n  \n  # Add the final `ACTION_USE` to collect the primitive.\n  reconstructed_path.append(ACTION_USE)\n\n  # --- Execute the Found Path and Monitor Collection Status ---\n  executed_actions = []\n  for action in reconstructed_path:\n      executed_actions.append(action)\n      # Perform the action in the environment. Reward is typically 0.0 for CraftState.step.\n      _, done, _ = env.step(action)\n      # Always update the `current_state` reference to reflect the environment's new state.\n      current_state = env._current_state\n\n      # Early exit: If the primitive is successfully collected, return the actions taken.\n      if current_state.inventory[primitive] > 0:\n          return executed_actions\n\n      # Early exit: If the episode ends prematurely (e.g., max_steps reached)\n      # AND the primitive has NOT been collected, then this attempt failed.\n      if done and current_state.inventory[primitive] <= 0:\n          return []\n\n  # Final check: After executing all actions, verify if the primitive was collected.\n  # This covers cases where collection happens on the very last action.\n  if current_state.inventory[primitive] > 0:\n      return executed_actions\n  else:\n      # This case should ideally not be reached if BFS and execution logic are perfectly aligned.\n      # It implies that the path was executed but the primitive wasn't collected, which might\n      # happen if the environment state changed unexpectedly or the primitive despawned.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T01:58:42.155515", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from CraftLab.action_specs)\n  _DOWN = 0\n  _UP = 1\n  _LEFT = 2\n  _RIGHT = 3\n  _USE = 4\n\n  initial_state = env._current_state\n  start_pos = initial_state.pos\n\n  grid_width, grid_height, _ = initial_state.grid.shape\n\n  # Pre-calculate all locations of the primitive on the grid\n  primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the primitive exists at this grid cell (count > 0 indicates presence)\n      if initial_state.grid[x, y, primitive] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty path\n  if not primitive_locations:\n    return []\n\n  # BFS Queue: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])])\n\n  # Visited set to prevent cycles and redundant exploration\n  visited = {start_pos}\n\n  # Define possible moves and corresponding actions (dx, dy): action\n  moves = {\n      (0, -1): _UP,    # Moving -1 in Y-direction is UP\n      (0, 1): _DOWN,   # Moving +1 in Y-direction is DOWN\n      (-1, 0): _LEFT,  # Moving -1 in X-direction is LEFT\n      (1, 0): _RIGHT   # Moving +1 in X-direction is RIGHT\n  }\n\n  # Get information about non-grabbable entities from the world\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n\n  while q:\n    current_pos, path_actions = q.popleft()\n    cx, cy = current_pos\n\n    # Check if current_pos is a valid \"collection\" spot (i.e., adjacent to a primitive)\n    # Based on CraftState.next_to: \"True if any cell in the 3x3 neighborhood around pos contains that kind\"\n    # This includes standing directly on the item.\n    found_primitive_in_neighborhood = False\n    for px, py in primitive_locations:\n      # Check if (px, py) is within the 3x3 square centered at (cx, cy)\n      if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n        found_primitive_in_neighborhood = True\n        break\n\n    if found_primitive_in_neighborhood:\n      # Path found, add USE action and return the complete path\n      return path_actions + [_USE]\n\n    # Explore neighbors\n    for (dx, dy), action in moves.items():\n      next_pos = (cx + dx, cy + dy)\n      nx, ny = next_pos\n\n      # Check bounds: ensure the next position is within the grid\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check for obstacles:\n      # A cell is considered blocked if it contains any non-grabbable item\n      # that is NOT the primitive we are trying to collect.\n      is_blocked = False\n      for k_idx in non_grabbable_indices:\n        # If the cell contains a non-grabbable item (and it's not the primitive itself)\n        if k_idx != primitive and initial_state.grid[nx, ny, k_idx] > 0:\n          is_blocked = True\n          break\n      \n      if is_blocked:\n        continue # Cannot move to this cell\n\n      # If the next position has not been visited, add it to the queue\n      if next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path_actions + [action]))\n\n  # If no path is found to any primitive after exploring all reachable cells\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:58:42.225815", "function_name": "collect", "function_body": "    actions = []\n    # Set a maximum number of steps for the agent to prevent infinite loops.\n    # If the environment has a max_steps attribute, use it; otherwise, default to 500.\n    max_episode_steps = env.max_steps if hasattr(env, 'max_steps') else 500\n\n    # Get initial observation to determine the egocentric view dimensions and current inventory.\n    obs = env.observations()\n    inventory = obs['features_dict']['inventory']\n    ego_grid = obs['features_dict']['features_ego']\n    \n    ego_h, ego_w, _ = ego_grid.shape\n    \n    # Assume the agent's fixed position within the egocentric view is at the bottom-center.\n    # This is a common convention for how egocentric views are constructed.\n    agent_y_in_ego = ego_h - 1\n    agent_x_in_ego = ego_w // 2\n    \n    # Calculate the coordinates of the cell directly in front of the agent in the egocentric view.\n    # Assuming the agent faces 'upwards' within its own view (decreasing Y).\n    front_y_in_ego = ego_h - 2\n    front_x_in_ego = ego_w // 2\n\n    # If the primitive is already in the inventory, no actions are needed.\n    if inventory[primitive] > 0:\n        return actions\n\n    # Main loop for agent actions\n    for _ in range(max_episode_steps):\n        obs = env.observations()\n        inventory = obs['features_dict']['inventory']\n        ego_grid = obs['features_dict']['features_ego']\n\n        # Check if the primitive has been collected after the last action.\n        if inventory[primitive] > 0:\n            break # Goal achieved, exit loop\n\n        action_to_take = None\n        \n        # Find all occurrences of the primitive within the egocentric view.\n        primitive_coords = np.argwhere(ego_grid[:, :, primitive] == 1)\n\n        if len(primitive_coords) > 0:\n            # Prioritize taking the 'USE' action if the primitive is directly in front.\n            is_primitive_in_front = False\n            for py, px in primitive_coords:\n                if py == front_y_in_ego and px == front_x_in_ego:\n                    is_primitive_in_front = True\n                    break\n            \n            if is_primitive_in_front:\n                action_to_take = env_factory.USE\n            else:\n                # The primitive is visible but not directly in front.\n                # Determine movement/turn action to get closer or align.\n                # For simplicity, we'll focus on the first detected primitive.\n                p_y, p_x = primitive_coords[0]\n\n                # Decide on turning or moving forward based on relative position.\n                if p_x < agent_x_in_ego:\n                    # Primitive is to the left of the agent's central column.\n                    action_to_take = env_factory.LEFT # Turn left\n                elif p_x > agent_x_in_ego:\n                    # Primitive is to the right of the agent's central column.\n                    action_to_take = env_factory.RIGHT # Turn right\n                elif p_y < front_y_in_ego:\n                    # Primitive is in the same column but further ahead.\n                    action_to_take = env_factory.UP # Move forward\n                else:\n                    # Primitive is in the same column as the agent, but not in front\n                    # (e.g., at agent's position, or behind).\n                    # A general forward movement is a reasonable default for exploration.\n                    action_to_take = env_factory.UP\n\n        # If no specific action was determined based on seeing the primitive,\n        # resort to an exploration strategy.\n        if action_to_take is None:\n            # Check if the cell directly in front is blocked by a non-grabbable entity.\n            is_blocked = False\n            if 0 <= front_y_in_ego < ego_h and 0 <= front_x_in_ego < ego_w:\n                # Iterate through the non-grabbable indices from the world configuration.\n                for kind_idx in env.world.non_grabbable_indices:\n                    if ego_grid[front_y_in_ego, front_x_in_ego, kind_idx] == 1:\n                        is_blocked = True\n                        break\n            \n            if is_blocked:\n                action_to_take = env_factory.LEFT # Turn left if blocked\n            else:\n                action_to_take = env_factory.UP # Otherwise, move straight ahead\n\n        # Execute the chosen action.\n        if action_to_take is not None:\n            reward, done, _ = env.step(action_to_take)\n            actions.append(action_to_take)\n            \n            # If the environment signals 'done' (e.g., episode max steps reached or goal achieved internally).\n            if done:\n                # Re-check inventory as the goal might have been achieved by the last step.\n                obs = env.observations()\n                inventory = obs['features_dict']['inventory']\n                if inventory[primitive] > 0:\n                    break # Goal achieved, exit loop\n                else:\n                    # Max steps reached without collecting, return current actions.\n                    return actions\n        else:\n            # Fallback for unexpected scenarios where no action was determined (should be rare).\n            # Take a random action to prevent getting stuck.\n            action_to_take = np.random.choice([env_factory.UP, env_factory.DOWN, env_factory.LEFT, env_factory.RIGHT, env_factory.USE])\n            reward, done, _ = env.step(action_to_take)\n            actions.append(action_to_take)\n            if done:\n                obs = env.observations()\n                inventory = obs['features_dict']['inventory']\n                if inventory[primitive] > 0:\n                    break\n                else:\n                    return actions\n\n    return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:00:21.485925", "function_name": "collect", "function_body": "    import collections\n\n    # Constants mapping movement actions to (dx, dy) deltas\n    _MOVE_DELTAS = {\n        env_factory.UP: (0, -1),\n        env_factory.DOWN: (0, 1),\n        env_factory.LEFT: (-1, 0),\n        env_factory.RIGHT: (1, 0),\n    }\n\n    # Constants mapping movement actions to the agent's final facing direction (0=N, 1=E, 2=S, 3=W)\n    _ACTION_TO_DIR_MAP = {\n        env_factory.UP: 0,    # North\n        env_factory.RIGHT: 1, # East\n        env_factory.DOWN: 2,  # South\n        env_factory.LEFT: 3,  # West\n    }\n\n    def _is_facing(agent_pos, agent_dir, target_pos):\n        \"\"\"\n        Checks if the agent at `agent_pos` with `agent_dir` is facing `target_pos`.\n        agent_dir mapping: 0=N, 1=E, 2=S, 3=W\n        \"\"\"\n        ax, ay = agent_pos\n        tx, ty = target_pos\n        if agent_dir == 0:  # UP (North)\n            return tx == ax and ty == ay - 1\n        if agent_dir == 1:  # RIGHT (East)\n            return tx == ax + 1 and ty == ay\n        if agent_dir == 2:  # DOWN (South)\n            return tx == ax and ty == ay + 1\n        if agent_dir == 3:  # LEFT (West)\n            return tx == ax - 1 and ty == ay\n        return False\n\n    def _is_cell_passable(grid, x, y, width, height, non_grabbable_indices, target_primitive_idx):\n        \"\"\"\n        Checks if a cell (x, y) is within bounds and passable by the agent.\n        A cell is not passable if:\n        1. It's out of bounds.\n        2. It contains the target_primitive_idx (agent cannot walk onto the item to collect it, must be next to).\n        3. It contains any item from non_grabbable_indices (considered as obstacles).\n        \"\"\"\n        if not (0 <= x < width and 0 <= y < height):\n            return False # Out of bounds\n        \n        # Agent cannot walk onto the primitive itself to collect it\n        if grid[x, y, target_primitive_idx] == 1:\n            return False\n\n        # Check if any other occupied kind makes the cell impassable.\n        # An agent can walk on empty cells or cells containing other grabbable items.\n        occupied_kinds = np.where(grid[x, y, :] == 1)[0]\n        for kind_idx in occupied_kinds:\n            if kind_idx in non_grabbable_indices:\n                return False # Contains a non-grabbable obstacle\n        return True # Cell is either empty, or contains only other grabbable items (not target_primitive_idx)\n\n    def _find_primitive_path(initial_state, primitive_idx, non_grabbable_indices):\n        \"\"\"\n        Finds the shortest sequence of actions (moves + USE) to collect the primitive.\n        Uses Breadth-First Search (BFS) to find the path, considering agent's position and direction.\n        \"\"\"\n        grid = initial_state.grid\n        start_pos = initial_state.pos\n        start_dir = initial_state.dir\n        width, height, _ = grid.shape\n\n        # Find all locations where the primitive exists on the grid\n        primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n        if len(primitive_locations) == 0:\n            return None # Primitive not found on the map\n\n        # BFS queue stores (current_x, current_y, current_direction, list_of_actions_so_far)\n        queue = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n        \n        # Visited set stores (pos_x, pos_y, current_direction) to avoid redundant exploration and cycles\n        visited = set([(start_pos[0], start_pos[1], start_dir)])\n\n        while queue:\n            cx, cy, cdir, actions_so_far = queue.popleft()\n\n            # Check if the current position and direction allow using any of the primitive instances\n            for px, py in primitive_locations:\n                if _is_facing((cx, cy), cdir, (px, py)):\n                    return actions_so_far + [env_factory.USE] # Path found, append USE action\n\n            # Explore possible next movement actions\n            for action, (dx, dy) in _MOVE_DELTAS.items():\n                nx, ny = cx + dx, cy + dy\n                new_dir = _ACTION_TO_DIR_MAP[action] # Agent's direction after this move\n\n                # Check if the new cell is within bounds and passable\n                if not _is_cell_passable(grid, nx, ny, width, height, non_grabbable_indices, primitive_idx):\n                    continue # Cannot move to this cell\n\n                # If this (position, direction) state has not been visited before\n                if (nx, ny, new_dir) not in visited:\n                    visited.add((nx, ny, new_dir))\n                    queue.append((nx, ny, new_dir, actions_so_far + [action]))\n        \n        return None # No path found to collect the primitive\n\n    # Main logic for collect_v2\n    current_state = env._current_state\n    \n    # Check if the primitive is already in the inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get the set of non-grabbable indices from the world configuration\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # Find the shortest action sequence to collect the primitive\n    actions = _find_primitive_path(current_state, primitive, non_grabbable_indices)\n    \n    if actions is None:\n        return [] # No path found to collect the primitive\n    else:\n        return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:00:22.456112", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Constants for actions. In a full module, these would typically be global.\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map cardinal movement actions to row, col deltas\n  ACTION_DELTAS = {\n      ACTION_UP: (-1, 0),\n      ACTION_DOWN: (1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1),\n  }\n\n  state = env._current_state\n  grid = state.grid\n  current_pos = state.pos  # Agent's current (row, col) position\n\n  height, width, _ = grid.shape  # Grid dimensions\n  # Get indices of entities that are considered obstacles for movement\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # If the primitive is already in inventory, no actions needed\n  if state.inventory[primitive] > 0:\n      return []\n\n  # Find all grid locations where the primitive exists\n  primitive_locations = []\n  for r in range(height):\n      for c in range(width):\n          if grid[r, c, primitive] == 1:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      return []  # Primitive not found on the map\n\n  # BFS to find the shortest path to any cell adjacent to a primitive\n  # Queue stores (current_position, list_of_actions_taken_to_reach_current_position)\n  q = deque([(current_pos, [])])\n  visited = {current_pos}  # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path = None  # Stores the shortest sequence of actions to reach an adjacent cell\n\n  while q:\n      (r, c), actions = q.popleft()\n\n      # Check if the current position is adjacent to any primitive location\n      for pr, pc in primitive_locations:\n          # Check for 4-directional adjacency (Manhattan distance of 1)\n          if (abs(r - pr) == 1 and c == pc) or (abs(c - pc) == 1 and r == pr):\n              # If found, this is the shortest path due to BFS property\n              best_path = actions\n              break  # Exit inner loop, path found\n      if best_path:\n          break  # Exit BFS main loop\n\n      # Explore neighbors (up, down, left, right)\n      for action, (dr, dc) in ACTION_DELTAS.items():\n          nr, nc = r + dr, c + dc  # New potential position\n\n          # Check grid boundaries\n          if not (0 <= nr < height and 0 <= nc < width):\n              continue\n\n          # Check if the new position has already been visited\n          if (nr, nc) in visited:\n              continue\n\n          # Determine if the new position is an obstacle\n          is_obstacle = False\n          # A cell is an obstacle if it contains any non-grabbable item\n          for idx in non_grabbable_indices:\n              if grid[nr, nc, idx] == 1:\n                  is_obstacle = True\n                  break\n          \n          # Also, prevent moving directly onto the primitive itself, as we need to be adjacent to USE\n          if (nr, nc) in primitive_locations:\n              is_obstacle = True\n\n          if not is_obstacle:\n              visited.add((nr, nc))\n              q.append(((nr, nc), actions + [action]))\n\n  if not best_path:\n      return []  # No path found to any cell adjacent to a primitive\n\n  # The 'USE' action in CraftWorld picks up items from the 3x3 neighborhood.\n  # So, once the agent is next to the primitive, a single 'USE' action suffices.\n  return best_path + [ACTION_USE]", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:01:44.129620", "function_name": "collect", "function_body": "    # Define action constants locally within the function\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Map movement actions to coordinate changes (dx, dy)\n    # Assuming (x, y) refers to (column, row) coordinates on the grid.\n    ACTION_DELTAS = {\n        UP: (0, -1),   # Move up (decrease row index)\n        DOWN: (0, 1),    # Move down (increase row index)\n        LEFT: (-1, 0),   # Move left (decrease column index)\n        RIGHT: (1, 0),   # Move right (increase column index)\n    }\n\n    # Get current observations from the environment\n    obs = env.observations()\n    grid = obs['features_global']\n    current_pos_x, current_pos_y = obs['pos']\n    inventory = obs['inventory']\n\n    # If the primitive is already in inventory, no actions are needed\n    if inventory[primitive] > 0:\n        return []\n\n    grid_width, grid_height, _ = grid.shape\n\n    # Find all locations on the grid where the target primitive exists\n    primitive_locations = []\n    for x_coord in range(grid_width):\n        for y_coord in range(grid_height):\n            if grid[x_coord, y_coord, primitive] == 1:\n                primitive_locations.append((x_coord, y_coord))\n\n    # If the primitive is not found anywhere on the grid, it cannot be collected\n    if not primitive_locations:\n        return []\n\n    # Use a Breadth-First Search (BFS) to find the shortest path from the\n    # agent's current position to any cell adjacent to a primitive location.\n    # The queue stores tuples of (current_x, current_y, list_of_actions_to_reach_here).\n    # 'collections.deque' is used for efficient queue operations; it's assumed to be available\n    # from a global import if not explicitly imported within the function.\n    queue = collections.deque([(current_pos_x, current_pos_y, [])])\n    # 'visited' set keeps track of explored positions to prevent cycles and redundant work.\n    visited = set([(current_pos_x, current_pos_y)])\n\n    target_adjacent_pos = None\n    best_path_actions = []\n\n    while queue:\n        x, y, path_actions = queue.popleft()\n\n        # Check if the current position (x, y) is adjacent to any primitive\n        is_adjacent = False\n        for px, py in primitive_locations:\n            # A position is considered \"adjacent\" if it's within the 3x3 neighborhood\n            # (including diagonals) of the primitive, but not the primitive's exact cell.\n            if abs(x - px) <= 1 and abs(y - py) <= 1:\n                if not (x == px and y == py): # Ensure agent is not on top of the primitive\n                    target_adjacent_pos = (x, y)\n                    best_path_actions = path_actions\n                    is_adjacent = True\n                    break # Found a suitable adjacent position\n        \n        if is_adjacent:\n            break # Shortest path to an adjacent cell found, exit BFS\n\n        # Explore possible next moves (UP, DOWN, LEFT, RIGHT) from the current position\n        for action_val, (dx, dy) in ACTION_DELTAS.items():\n            next_x, next_y = x + dx, y + dy\n\n            # Check if the next position is within the grid boundaries\n            if 0 <= next_x < grid_width and 0 <= next_y < grid_height:\n                # If the next position has not been visited yet\n                if (next_x, next_y) not in visited:\n                    visited.add((next_x, next_y))\n                    # Append the current action to the path and add the new state to the queue\n                    new_path_actions = path_actions + [action_val]\n                    queue.append((next_x, next_y, new_path_actions))\n\n    # If no path could be found to any cell adjacent to a primitive\n    if target_adjacent_pos is None:\n        return []\n\n    # Once an adjacent cell is reached, the 'USE' action is performed to collect the primitive.\n    return best_path_actions + [USE]", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:01:44.202380", "function_name": "collect", "function_body": "    actions_taken = []\n    \n    # Get initial observations to check current state and map layout\n    obs = env.observations()\n    \n    # 1. Check if the primitive is already in the agent's inventory\n    # Access inventory from the features_dict for convenience\n    if obs['features_dict']['inventory'][primitive] > 0:\n        return [] # Already collected, no actions needed\n    \n    # We need access to the underlying CraftState to use its `next_to` method.\n    # CraftLab is a wrapper, and _current_state holds the actual CraftState instance.\n    current_state = env._current_state \n\n    # Constants for actions (as defined or inferred from action_specs)\n    # These are standard for the provided environment\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Maximum number of steps to attempt collection to prevent infinite loops\n    MAX_COLLECT_STEPS = 200 \n\n    for step_count in range(MAX_COLLECT_STEPS):\n        # Refresh observations at each step to reflect environmental changes\n        obs = env.observations()\n        inventory = obs['features_dict']['inventory']\n        \n        # Check if the primitive has been collected after the last action\n        if inventory[primitive] > 0:\n            break # Goal achieved\n        \n        # Get the global grid and agent's position for planning\n        grid = obs['features_dict']['features_global']\n        agent_pos_norm = obs['features_dict']['pos']\n        \n        # Determine grid dimensions (WIDTH, HEIGHT, n_kinds) from the grid shape\n        # Assuming grid is (WIDTH, HEIGHT, N_KINDS) as per CraftState description\n        WIDTH, HEIGHT, _ = grid.shape \n\n        # Convert normalized agent position (x_norm, y_norm) to grid coordinates (x, y)\n        agent_x = int(round(agent_pos_norm[0] * (WIDTH - 1)))\n        agent_y = int(round(agent_pos_norm[1] * (HEIGHT - 1)))\n        current_agent_pos = (agent_x, agent_y)\n\n        # 2. Check if the primitive is in the agent's immediate 3x3 neighborhood\n        # `next_to` is a method of CraftState, accessible via `current_state`.\n        if current_state.next_to(primitive):\n            # Primitive is nearby, attempt to collect it using the USE action\n            action = USE\n            _reward, _done, _ = env.step(action)\n            actions_taken.append(action)\n            \n            # After using, immediately check if it's collected\n            if env.observations()['features_dict']['inventory'][primitive] > 0:\n                break # Collected, goal achieved\n            continue # If USE didn't pick it up (e.g., wrong type of 'use' or blocked), try next loop iteration\n        \n        # 3. Locate all instances of the primitive on the global grid\n        # np.argwhere returns (x, y) coordinates for grid[x, y, primitive] == 1\n        primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n        \n        if len(primitive_locations) == 0:\n            # Primitive is not found on the map and not in inventory.\n            # It might be impossible to collect in this scenario.\n            # Return actions taken so far and give up.\n            return actions_taken \n            \n        # Find the closest primitive among all found locations\n        min_dist = float('inf')\n        target_primitive_pos = None # Stores (x, y) of the closest primitive\n        \n        for loc_x, loc_y in primitive_locations: # loc is (x, y)\n            # Calculate Manhattan distance to the agent's current position\n            dist = abs(loc_x - agent_x) + abs(loc_y - agent_y)\n            if dist < min_dist:\n                min_dist = dist\n                target_primitive_pos = (loc_x, loc_y)\n        \n        # This case should ideally not be reached if primitive_locations was not empty,\n        # but as a safeguard.\n        if target_primitive_pos is None:\n            return actions_taken \n            \n        target_px, target_py = target_primitive_pos\n        \n        # 4. Determine the best movement action towards the closest primitive\n        dx = target_px - agent_x\n        dy = target_py - agent_y\n        \n        action = None\n        # Prioritize movement along the dimension with the larger difference\n        if abs(dx) > abs(dy):\n            if dx > 0:\n                action = RIGHT\n            elif dx < 0:\n                action = LEFT\n        else: # abs(dy) >= abs(dx)\n            if dy > 0:\n                action = DOWN\n            elif dy < 0:\n                action = UP\n                \n        # If dx and dy are both 0, the agent is already at the target location.\n        # This case should have been caught by `current_state.next_to(primitive)`\n        # if the item is grabbable at the same cell. If not, we have nowhere to move.\n        if action is None:\n            # Agent is at the target (dx=0, dy=0) but `next_to` was false.\n            # This implies the primitive cannot be collected this way (e.g., not grabbable,\n            # or requires specific facing and USE does not work generically).\n            # For this simple collector, we consider it uncollectable and stop trying to move.\n            break\n\n        # Execute the determined movement action\n        _reward, _done, _ = env.step(action)\n        actions_taken.append(action)\n        \n        # Check if the environment signals that the episode is done (e.g., max_steps reached)\n        if _done:\n            break\n\n    return actions_taken", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:03:13.779909", "function_name": "collect", "function_body": "  actions = []\n  max_collect_steps = 200 # Set a maximum number of steps to prevent infinite loops\n\n  # Access the internal CraftState for direct grid, position, and inventory access\n  # This is an \"improved\" version, so direct access is assumed for efficiency and robustness.\n  current_state = env._current_state\n\n  # Check if the primitive is already in the inventory\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  for _ in range(max_collect_steps):\n    # Re-check inventory after each step\n    if current_state.inventory[primitive] > 0:\n      break\n\n    current_r, current_c = current_state.pos\n\n    # Check if the primitive is in the 3x3 neighborhood of the agent\n    if current_state.next_to(primitive):\n      # If next to the primitive, attempt to USE it\n      action_to_take = env_factory.ACTION_USE\n      _, done, _ = env.step(action_to_take)\n      actions.append(action_to_take)\n\n      # After attempting to USE, check if the goal is satisfied\n      if current_state.inventory[primitive] > 0:\n        break\n      \n      # If not collected, continue to next iteration.\n      # The primitive might still be there, or another one moved into view,\n      # or the USE action failed for some reason (e.g., not grabbable, or wrong facing if facing matters,\n      # but problem description implies `next_to` is sufficient for `USE`).\n\n    else:\n      # If not next to the primitive, find its location on the global grid\n      # np.argwhere returns (row, col) for elements > 0\n      primitive_locations = np.argwhere(current_state.grid[:, :, primitive] > 0)\n\n      if len(primitive_locations) == 0:\n        # Primitive not found anywhere on the grid. Cannot collect.\n        break # Give up if target is unreachable or doesn't exist.\n\n      # Find the closest primitive location using Manhattan distance\n      min_dist = float('inf')\n      target_r, target_c = -1, -1\n\n      for r, c in primitive_locations:\n        dist = abs(current_r - r) + abs(current_c - c)\n        if dist < min_dist:\n          min_dist = dist\n          target_r, target_c = r, c\n\n      # Determine the best movement action towards the target\n      dr = target_r - current_r\n      dc = target_c - current_c\n\n      action_to_take = None\n      if abs(dr) > abs(dc): # Prioritize vertical movement if vertical difference is larger\n        if dr < 0:\n          action_to_take = env_factory.ACTION_UP\n        else: # dr > 0\n          action_to_take = env_factory.ACTION_DOWN\n      elif abs(dc) > 0: # Prioritize horizontal movement if horizontal difference is larger or vertical diff is zero\n        if dc < 0:\n          action_to_take = env_factory.ACTION_LEFT\n        else: # dc > 0\n          action_to_take = env_factory.ACTION_RIGHT\n      # If dr=0 and dc=0, the agent is on the target cell, which should be handled by `next_to` earlier.\n      # In this `else` block, action_to_take would remain None if dr=0 and dc=0.\n\n      if action_to_take is not None:\n        _, done, _ = env.step(action_to_take)\n        actions.append(action_to_take)\n        if done: # If environment terminates for any reason\n          break\n      else:\n        # No movement action could be determined (e.g., already at target, or stuck).\n        # This can happen if the target is on the current cell and `next_to` somehow failed,\n        # or if there's no path and the agent is stuck.\n        break\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:03:14.728042", "function_name": "collect", "function_body": "  import collections\n\n  # Define constants for actions and directions (common in CraftWorld)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Standard directions: 0=NORTH, 1=SOUTH, 2=WEST, 3=EAST\n  DIR_NORTH = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_EAST = 3\n\n  # Mapping of action to movement delta (dx, dy)\n  MOVE_DELTAS = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # Mapping of action to the resulting agent direction after the move\n  ACTION_TO_DIR = {\n      UP: DIR_NORTH,\n      DOWN: DIR_SOUTH,\n      LEFT: DIR_WEST,\n      RIGHT: DIR_EAST,\n  }\n\n  # Mapping of relative position (dx, dy) from agent to target to the required\n  # agent direction to face that target.\n  REQUIRED_DIR_TO_FACE = {\n      (0, -1): DIR_NORTH,  # Target is UP relative to agent, agent must face North\n      (0, 1): DIR_SOUTH,   # Target is DOWN relative to agent, agent must face South\n      (-1, 0): DIR_WEST,   # Target is LEFT relative to agent, agent must face West\n      (1, 0): DIR_EAST,    # Target is RIGHT relative to agent, agent must face East\n  }\n\n  obs = env.observations()\n  current_grid = obs['features_dict']['features_global']\n  grid_height, grid_width, _ = current_grid.shape\n\n  # Convert normalized position from features_dict to integer grid coordinates\n  current_pos_norm = obs['features_dict']['pos']\n  current_x = int(round(current_pos_norm[0] * (grid_width - 1)))\n  current_y = int(round(current_pos_norm[1] * (grid_height - 1)))\n  \n  # Get the agent's current direction from the one-hot encoding\n  current_dir_one_hot = obs['features_dict']['direction']\n  current_dir = np.argmax(current_dir_one_hot)\n\n  current_inventory = obs['features_dict']['inventory']\n\n  # 1. Check if the primitive is already in the inventory\n  if current_inventory[primitive] > 0:\n    return []\n\n  # 2. Find all locations of the target primitive on the grid\n  primitive_locs = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if current_grid[x, y, primitive] == 1:\n        primitive_locs.append((x, y))\n\n  if not primitive_locs:\n    # Primitive not found on the map\n    return []\n\n  # 3. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a cell adjacent to the primitive, with correct facing direction.\n  #    BFS state: ((x, y, direction), path_so_far)\n  queue = collections.deque([((current_x, current_y, current_dir), [])])\n  # Visited set to prevent cycles and redundant exploration: (x, y, direction)\n  visited = {(current_x, current_y, current_dir)}\n\n  path_found = None\n\n  while queue:\n    (cx, cy, c_dir), path = queue.popleft()\n\n    # Check if the current state (cx, cy, c_dir) is a goal state:\n    # Agent is adjacent to a primitive and facing it correctly.\n    for px, py in primitive_locs:\n      # Check the 4 direct neighbors around the agent's current position\n      # for a primitive location.\n      for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Left, Right, Up, Down relative to agent\n        if cx + dx_adj == px and cy + dy_adj == py:\n          # Agent is at (cx, cy), primitive at (px, py).\n          # Calculate relative coordinates from agent to primitive to determine\n          # the required facing direction.\n          rel_dx = px - cx\n          rel_dy = py - cy\n          \n          if (rel_dx, rel_dy) in REQUIRED_DIR_TO_FACE:\n            required_dir = REQUIRED_DIR_TO_FACE[(rel_dx, rel_dy)]\n            if c_dir == required_dir:\n              # Found a path to a location adjacent to the primitive,\n              # with the agent correctly oriented. Append USE action.\n              path_found = path + [USE]\n              queue.clear() # Clear queue to terminate BFS\n              break\n      if path_found:\n        break\n    if path_found:\n      break\n\n    # If not a goal state, explore possible next states (move actions)\n    for action in [DOWN, UP, LEFT, RIGHT]:\n      nx, ny = cx + MOVE_DELTAS[action][0], cy + MOVE_DELTAS[action][1]\n      n_dir = ACTION_TO_DIR[action] # New direction after taking this action\n\n      # Check grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # For v2, we assume all cells are traversable.\n      # In a more complex scenario (e.g., v3), we would check for obstacles\n      # (e.g., walls, water) at (nx, ny) using `current_grid`.\n\n      # If this state (new position, new direction) has not been visited yet\n      if (nx, ny, n_dir) not in visited:\n        visited.add((nx, ny, n_dir))\n        queue.append(((nx, ny, n_dir), path + [action]))\n\n  # Return the found path or an empty list if no path was found\n  return path_found if path_found is not None else []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:05:43.598860", "function_name": "collect", "function_body": "    # Helper function for Breadth-First Search (BFS) to find a path to a location\n    # from which the target kind is reachable (adjacent or on the same cell if grabbable).\n    # This nested function can access variables from the outer scope (e.g., `env.world`).\n    def _find_path_to_reach_kind_internal(start_pos, grid, target_kind_idx, grabbable_indices, actions_map):\n        width, height, _ = grid.shape\n        # Using collections.deque for efficient queue operations.\n        # This assumes 'collections' module is accessible in the execution environment.\n        q = collections.deque([(start_pos, [])])  # (position: tuple, path_taken: list of actions)\n        visited = {start_pos}\n\n        # Helper to determine if a given position allows interaction with the target kind.\n        def is_target_reachable_from_pos(check_pos, check_grid, kind_idx, is_grabbable_item):\n            cx, cy = check_pos\n            # If the item is grabbable, being on its cell is enough to \"use\" it.\n            if is_grabbable_item and check_grid[cx, cy, kind_idx] > 0:\n                return True\n            # Otherwise, check the 3x3 neighborhood (including current position) for any instance of the kind.\n            # This covers being adjacent.\n            for dx in [-1, 0, 1]:\n                for dy in [-1, 0, 1]:\n                    nx, ny = cx + dx, cy + dy\n                    if 0 <= nx < width and 0 <= ny < height:\n                        if check_grid[nx, ny, kind_idx] > 0:\n                            return True\n            return False\n\n        # Map movement actions to their corresponding coordinate deltas.\n        move_actions_delta = {\n            actions_map['UP']: (0, -1),\n            actions_map['DOWN']: (0, 1),\n            actions_map['LEFT']: (-1, 0),\n            actions_map['RIGHT']: (1, 0),\n        }\n\n        is_primitive_grabbable = (target_kind_idx in grabbable_indices)\n\n        while q:\n            curr_pos, path = q.popleft()\n\n            # If the current position is a valid spot to interact with the target kind, return the path.\n            if is_target_reachable_from_pos(curr_pos, grid, target_kind_idx, is_primitive_grabbable):\n                return path\n\n            # Explore neighboring cells\n            for action_val, (dx, dy) in move_actions_delta.items():\n                next_pos = (curr_pos[0] + dx, curr_pos[1] + dy)\n\n                # Check if the next position is within grid boundaries.\n                if not (0 <= next_pos[0] < width and 0 <= next_pos[1] < height):\n                    continue\n\n                # If the next position has not been visited yet, add it to the queue.\n                if next_pos not in visited:\n                    visited.add(next_pos)\n                    q.append((next_pos, path + [action_val]))\n\n        return None  # No path found to a reachable location for the target kind.\n\n    # --- Main logic of collect_v2 function ---\n    actions_list = []\n    actions = env.action_specs()\n    USE = actions['USE']\n\n    current_state = env._current_state\n    world = env.world  # Reference to the CraftWorld instance\n\n    # Early exit: If the primitive is already in the inventory, no actions needed.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Check if the primitive is actually a grabbable item.\n    # If not, it cannot be \"collected\" into inventory by this function.\n    grabbable_indices = world.grabbable_indices\n    if primitive not in grabbable_indices:\n        return []\n\n    max_collection_attempts = 1000  # Safety limit to prevent infinite loops in complex scenarios.\n    attempts = 0\n\n    # Loop until the primitive is collected or max attempts are reached.\n    while current_state.inventory[primitive] == 0 and attempts < max_collection_attempts:\n        attempts += 1\n        \n        # Find the shortest path to a position from which the primitive can be used/collected.\n        path_to_reach = _find_path_to_reach_kind_internal(\n            current_state.pos, \n            current_state.grid, \n            primitive, \n            grabbable_indices, \n            actions\n        )\n\n        if path_to_reach is None:\n            # No path found, meaning the primitive is unreachable or doesn't exist.\n            return [] \n        \n        if len(path_to_reach) == 0:\n            # Agent is already at a position from which the primitive can be used.\n            # Perform the USE action.\n            actions_list.append(USE)\n            env.step(USE)  # This updates env._current_state internally.\n            current_state = env._current_state  # Get the newly updated state.\n            \n            # Check if collection was successful.\n            if current_state.inventory[primitive] > 0:\n                break  # Primitive collected, exit loop.\n        else:\n            # Execute the found path to move towards the primitive.\n            for action in path_to_reach:\n                actions_list.append(action)\n                env.step(action)  # This updates env._current_state internally.\n                current_state = env._current_state  # Get the newly updated state.\n                \n                # Check if collection occurred during movement (e.g., walking over a grabbable item).\n                if current_state.inventory[primitive] > 0:\n                    break  # Primitive collected, exit path execution and main loop.\n\n    return actions_list", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:05:43.672572", "function_name": "collect", "function_body": "    \"\"\"Improved version of `collect_v1` using BFS to find optimal path.\"\"\"\n    import collections\n    import numpy as np\n\n    # Action mapping (from CraftLab.action_specs)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Delta for each movement action (dr, dc)\n    # These represent changes in (row, column) for the grid\n    ACTION_DELTAS = {\n        UP: (-1, 0),    # Moving North (row decreases)\n        DOWN: (1, 0),   # Moving South (row increases)\n        LEFT: (0, -1),  # Moving West (column decreases)\n        RIGHT: (0, 1),  # Moving East (column increases)\n    }\n\n    # Mapping from movement action to the agent's resulting internal direction (CraftState.dir)\n    # CraftState.dir: 0=N, 1=E, 2=S, 3=W\n    MOVE_ACTION_TO_RESULTING_DIR = {\n        UP: 0,     # Moving UP makes agent face North\n        RIGHT: 1,  # Moving RIGHT makes agent face East\n        DOWN: 2,   # Moving DOWN makes agent face South\n        LEFT: 3,   # Moving LEFT makes agent face West\n    }\n\n    # Mapping from target's relative position (dr, dc) to agent's required direction to face it\n    # E.g., if target is at (r-1, c) (North of agent), agent needs to face North (dir 0)\n    TARGET_DELTA_TO_REQUIRED_DIR = {\n        (-1, 0): 0,  # Target North of agent, agent needs to face North\n        (0, 1): 1,   # Target East of agent, agent needs to face East\n        (1, 0): 2,   # Target South of agent, agent needs to face South\n        (0, -1): 3,  # Target West of agent, agent needs to face West\n    }\n\n    # 1. Check initial inventory\n    # Accessing _current_state directly for efficiency and reliable state info\n    current_state = env._current_state\n    inventory = current_state.inventory\n    if inventory[primitive] > 0:\n        return []\n\n    # Get initial agent state and grid information\n    agent_r, agent_c = current_state.pos\n    initial_dir = current_state.dir # Agent's starting direction\n    grid = current_state.grid\n    height, width, _ = grid.shape\n\n    # Identify non-walkable terrain based on world configuration\n    world = env.world\n    non_grabbable_indices = world.non_grabbable_indices\n\n    def is_walkable(r, c):\n        \"\"\"Checks if a cell at (r, c) is within bounds and does not contain non-grabbable items.\"\"\"\n        if not (0 <= r < height and 0 <= c < width):\n            return False # Out of bounds\n        \n        # A cell is non-walkable if it contains any non-grabbable item\n        for k_idx in non_grabbable_indices:\n            if grid[r, c, k_idx] == 1:\n                return False\n        return True\n\n    # 2. Find all primitive locations on the grid\n    primitive_locs = []\n    for r_scan in range(height):\n        for c_scan in range(width):\n            if grid[r_scan, c_scan, primitive] == 1:\n                primitive_locs.append((r_scan, c_scan))\n\n    if not primitive_locs:\n        # Primitive not found on the map\n        return []\n\n    # 3. Define BFS target states\n    # A target state is (r, c, final_dir) where (r, c) is adjacent to a primitive\n    # and final_dir is the direction required to face that primitive for a USE action.\n    targets = set()\n    for pr, pc in primitive_locs:\n        # Check 4 adjacent cells to the primitive\n        for dr_adj, dc_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            r_adj, c_adj = pr + dr_adj, pc + dc_adj\n            \n            if is_walkable(r_adj, c_adj):\n                # Calculate the relative position of the primitive FROM the adjacent cell (agent's perspective)\n                dr_target_from_agent, dc_target_from_agent = pr - r_adj, pc - c_adj\n                \n                required_dir_to_face = TARGET_DELTA_TO_REQUIRED_DIR.get((dr_target_from_agent, dc_target_from_agent))\n                if required_dir_to_face is not None:\n                    targets.add((r_adj, c_adj, required_dir_to_face))\n                                                \n    if not targets:\n        # No walkable adjacent cells to any primitive, implying impossible to reach or collect\n        return []\n\n    # 4. BFS to find the shortest path to a target state\n    # Queue stores (r, c, current_dir, list_of_actions)\n    q = collections.deque([(agent_r, agent_c, initial_dir, [])])\n    # Visited set stores (r, c, current_dir) to prevent cycles and redundant exploration\n    visited = set([(agent_r, agent_c, initial_dir)])\n\n    while q:\n        r, c, current_dir, path_actions = q.popleft()\n\n        # Check if the current state is one of our target states\n        if (r, c, current_dir) in targets:\n            return path_actions + [USE] # Found a path, append USE action and return\n\n        # Explore possible movement actions from the current state\n        for move_action in [UP, DOWN, LEFT, RIGHT]:\n            dr, dc = ACTION_DELTAS[move_action]\n            nr, nc = r + dr, c + dc # New position\n            new_dir = MOVE_ACTION_TO_RESULTING_DIR[move_action] # New direction after this move\n\n            # Check if the new position is walkable and this state (pos+dir) hasn't been visited\n            if is_walkable(nr, nc) and (nr, nc, new_dir) not in visited:\n                visited.add((nr, nc, new_dir))\n                q.append((nr, nc, new_dir, path_actions + [move_action]))\n    \n    # If BFS completes and no path is found to any primitive\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:07:24.909620", "function_name": "collect", "function_body": "    # Define actions based on CraftLab's action_specs.\n    # These are typically constants in an enum or module.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n    ALL_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n    # Get the current state from the environment\n    initial_state = env._current_state\n\n    # Check if the primitive is already collected in the initial state\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    # BFS setup\n    # Using collections.deque for efficient queue operations.\n    # Each item in the queue is a tuple: (CraftState_object, list_of_actions_taken_to_reach_this_state)\n    queue = collections.deque() \n    queue.append((initial_state, []))\n\n    # Visited set to avoid cycles and redundant computations.\n    # Stores a hashable representation of the state: (pos_row, pos_col, direction)\n    # This assumes the grid itself does not change in a way that affects pathfinding\n    # until the primitive is collected.\n    visited = set()\n    visited.add((initial_state.pos[0], initial_state.pos[1], initial_state.dir))\n\n    # Safety limit to prevent excessively long searches, especially on large or open maps\n    # or if the goal is unreachable. This helps manage computational complexity.\n    MAX_SEARCH_NODES = 2000 \n    nodes_explored = 0\n\n    while queue and nodes_explored < MAX_SEARCH_NODES:\n        current_state, current_path = queue.popleft()\n        nodes_explored += 1\n\n        # Check if the goal (primitive in inventory) is achieved in the *current* state.\n        # If so, the current_path is the sequence of actions that led to this success.\n        if current_state.inventory[primitive] > 0:\n            return current_path\n\n        # Explore all possible actions from the current state\n        for action in ALL_ACTIONS:\n            # Simulate the action to get the next state.\n            # CraftState.step handles all environment dynamics: movement, interaction,\n            # and crucially, inventory updates if an item is collected.\n            _reward, next_state = current_state.step(action)\n\n            # Create a hashable key for the next state to check if it has been visited.\n            # Using (position_x, position_y, direction) is sufficient for most\n            # grid-based movement pathfinding.\n            next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                # Append the action taken to the current path and add the new state\n                # and its path to the queue for further exploration.\n                new_path = current_path + [action]\n                queue.append((next_state, new_path))\n    \n    # If the queue becomes empty or the maximum number of nodes is explored\n    # without finding the primitive, it means the primitive is unreachable\n    # within the search limits.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:07:24.982959", "function_name": "collect", "function_body": "    # Helper for action constants\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']  # Assuming this is 'Turn Left'\n    ACTION_RIGHT = action_map['RIGHT'] # Assuming this is 'Turn Right'\n    ACTION_USE = action_map['USE']\n\n    # Direction constants for agent's facing direction\n    # (0:North, 1:East, 2:South, 3:West) - Standard DMLab convention\n    DIR_NORTH = 0\n    DIR_EAST = 1\n    DIR_SOUTH = 2\n    DIR_WEST = 3\n\n    current_state = env._current_state\n    if current_state.inventory[primitive] > 0:\n        return [] # Primitive already collected\n\n    grid = current_state.grid\n    grid_width, grid_height, _ = grid.shape # grid.shape is (WIDTH, HEIGHT, n_kinds)\n\n    start_r, start_c = current_state.pos\n    start_dir = current_state.dir\n\n    # BFS state: (row, col, direction, path_actions)\n    # Using a deque for efficient popleft from collections module\n    q = collections.deque([(start_r, start_c, start_dir, [])])\n\n    # Visited states: (row, col, direction) to prevent cycles and redundant exploration\n    visited = set([(start_r, start_c, start_dir)])\n\n    # Mapping current_dir to (dr, dc) for the cell directly in front of the agent\n    # This is where the USE action would interact.\n    FORWARD_DELTAS = {\n        DIR_NORTH: (-1, 0),  # Agent facing North (row decreases)\n        DIR_EAST: (0, 1),    # Agent facing East (col increases)\n        DIR_SOUTH: (1, 0),   # Agent facing South (row increases)\n        DIR_WEST: (0, -1),   # Agent facing West (col decreases)\n    }\n\n    # BFS loop\n    while q:\n        r, c, current_dir, path = q.popleft()\n\n        # 1. Check if we can USE the primitive from the current state\n        # Calculate the coordinates of the cell directly in front of the agent\n        fr, fc = r + FORWARD_DELTAS[current_dir][0], c + FORWARD_DELTAS[current_dir][1]\n\n        # Check if the forward cell is within grid bounds\n        if 0 <= fr < grid_width and 0 <= fc < grid_height:\n            # Check if the primitive is present in the forward cell\n            if grid[fr, fc, primitive] == 1:\n                return path + [ACTION_USE] # Path found!\n\n        # 2. Explore possible next states by applying movement and turning actions\n\n        # A. Movement actions (UP, DOWN): Change position, retain direction\n        # Move UP (North)\n        next_r_up, next_c_up = r - 1, c\n        if 0 <= next_r_up < grid_width and 0 <= next_c_up < grid_height:\n            if (next_r_up, next_c_up, current_dir) not in visited:\n                visited.add((next_r_up, next_c_up, current_dir))\n                q.append((next_r_up, next_c_up, current_dir, path + [ACTION_UP]))\n\n        # Move DOWN (South)\n        next_r_down, next_c_down = r + 1, c\n        if 0 <= next_r_down < grid_width and 0 <= next_c_down < grid_height:\n            if (next_r_down, next_c_down, current_dir) not in visited:\n                visited.add((next_r_down, next_c_down, current_dir))\n                q.append((next_r_down, next_c_down, current_dir, path + [ACTION_DOWN]))\n\n        # B. Turning actions (LEFT, RIGHT): Change direction, retain position\n        # Turn LEFT (counter-clockwise)\n        next_dir_left = (current_dir - 1 + 4) % 4 # Ensure direction stays within 0-3\n        if (r, c, next_dir_left) not in visited:\n            visited.add((r, c, next_dir_left))\n            q.append((r, c, next_dir_left, path + [ACTION_LEFT]))\n\n        # Turn RIGHT (clockwise)\n        next_dir_right = (current_dir + 1) % 4 # Ensure direction stays within 0-3\n        if (r, c, next_dir_right) not in visited:\n            visited.add((r, c, next_dir_right))\n            q.append((r, c, next_dir_right, path + [ACTION_RIGHT]))\n\n    return [] # No path found after exploring all reachable states", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:09:39.077174", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants (from problem description)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Agent facing direction constants (standard DMLab-like convention: 0=N, 1=E, 2=S, 3=W)\n    DIR_NORTH = 0\n    DIR_EAST = 1\n    DIR_SOUTH = 2\n    DIR_WEST = 3\n\n    # Get current observations from the environment\n    obs = env.observations()\n    current_grid = obs['features_dict']['features_global']\n    current_inventory = obs['features_dict']['inventory']\n\n    # Derive actual grid position and direction from observations\n    grid_width, grid_height, n_kinds = current_grid.shape\n    normalized_pos = obs['features_dict']['pos']\n    # Round to nearest integer for grid coordinates\n    current_pos_x = int(round(normalized_pos[0] * grid_width))\n    current_pos_y = int(round(normalized_pos[1] * grid_height))\n    current_pos = (current_pos_x, current_pos_y)\n    current_dir = np.argmax(obs['features_dict']['direction'])\n\n    # 1. Check if primitive is already in inventory\n    if current_inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # Helper function to check if a cell is within grid boundaries\n    def is_valid_cell(x, y):\n        return 0 <= x < grid_width and 0 <= y < grid_height\n\n    # Helper function to check if a cell is walkable (not blocked by non-grabbable items)\n    def is_walkable(x, y, grid):\n        if not is_valid_cell(x, y):\n            return False\n        # A cell is blocked if it contains any non-grabbable item\n        for k_idx in env.world.non_grabbable_indices:\n            if grid[x, y, k_idx] > 0:\n                return False # Cell is blocked by an obstacle (e.g., wall, workshop)\n        return True # Cell is free or contains only grabbable items (which are not blocking)\n\n    # Helper function to determine the required agent direction to face a target from an adjacent cell\n    def get_required_dir_to_face_target(agent_pos, target_pos):\n        ax, ay = agent_pos\n        tx, ty = target_pos\n        if tx == ax and ty < ay: return DIR_NORTH # Target is north of agent\n        if tx > ax and ty == ay: return DIR_EAST  # Target is east of agent\n        if tx == ax and ty > ay: return DIR_SOUTH # Target is south of agent\n        if tx < ax and ty == ay: return DIR_WEST  # Target is west of agent\n        return -1 # Not an adjacent cardinal direction\n\n    # Find all locations on the grid where the primitive exists\n    primitive_locations = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if current_grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the map, cannot collect\n\n    # BFS for pathfinding\n    # BFS State: ((x, y, current_direction), list_of_actions_to_reach_this_state)\n    q = collections.deque([((current_pos[0], current_pos[1], current_dir), [])])\n    # Visited set to prevent cycles and redundant exploration. Stores (x, y, direction) tuples.\n    visited = {(current_pos[0], current_pos[1], current_dir)}\n\n    # Map (dx, dy) to (action_to_take, resulting_direction_if_moved_that_way)\n    # This assumes movement actions update the agent's direction to match the direction of movement.\n    MOVES = {\n        (0, -1): (UP, DIR_NORTH),\n        (0, 1): (DOWN, DIR_SOUTH),\n        (-1, 0): (LEFT, DIR_WEST),\n        (1, 0): (RIGHT, DIR_EAST)\n    }\n\n    final_action_sequence = None\n    \n    # Set a reasonable limit for BFS iterations to prevent excessively long searches.\n    # Max states = grid_width * grid_height * 4 directions. Multiply by a factor for robustness.\n    MAX_BFS_ITERATIONS = grid_width * grid_height * 4 * 2\n    \n    iter_count = 0\n    while q and iter_count < MAX_BFS_ITERATIONS:\n        iter_count += 1\n        (curr_x, curr_y, curr_d), path_actions = q.popleft()\n\n        # Check if the current state is a goal state:\n        # Agent is at (curr_x, curr_y), facing (curr_d), and this position allows for 'USE'\n        # on an adjacent primitive location.\n        for px, py in primitive_locations:\n            # Check if agent's current position is adjacent to a primitive\n            if abs(curr_x - px) + abs(curr_y - py) == 1: # Manhattan distance of 1\n                # Determine the direction required to face the primitive from the agent's current position\n                required_dir_to_face = get_required_dir_to_face_target((curr_x, curr_y), (px, py))\n                \n                # If the agent is already facing the primitive correctly\n                if required_dir_to_face != -1 and curr_d == required_dir_to_face:\n                    # Goal found: agent is positioned and oriented to USE the primitive\n                    final_action_sequence = path_actions + [USE]\n                    break\n        if final_action_sequence is not None:\n            break # Found a path to the goal state, exit BFS\n\n        # Explore possible moves from the current state\n        for (dx, dy), (action_move, new_dir_after_move) in MOVES.items():\n            nx, ny = curr_x + dx, curr_y + dy # Calculate new position\n            \n            # Check if new position is valid and walkable\n            if is_valid_cell(nx, ny) and is_walkable(nx, ny, current_grid):\n                new_state = (nx, ny, new_dir_after_move)\n                # Add to queue if this state hasn't been visited yet\n                if new_state not in visited:\n                    visited.add(new_state)\n                    q.append((new_state, path_actions + [action_move]))\n    \n    # If no path was found after exhausting BFS or reaching iteration limit\n    if final_action_sequence is None:\n        return []\n\n    return final_action_sequence", "island_id": 3, "scores": {"3": -1}}
