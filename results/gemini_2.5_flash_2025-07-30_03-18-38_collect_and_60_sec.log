{"timestamp": "2025-07-30T09:17:30.913212", "function_name": "collect", "function_body": "  # Define action constants (based on CraftLab.action_specs())\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  initial_state = env._current_state\n  \n  # Check if primitive is already in inventory\n  if initial_state.inventory[primitive] > 0:\n    return []\n\n  # BFS setup\n  # Using a standard list as a queue. `head` pointer mimics collections.deque.popleft().\n  queue = [(initial_state, [])] # (current_CraftState, list_of_actions_taken)\n  \n  # Visited set to avoid cycles and redundant computations.\n  # A state is defined by (agent_position, agent_direction, current_inventory_tuple).\n  # The grid implicitly changes only when an item is picked up by a USE action,\n  # which reflects in the inventory.\n  visited = set()\n  visited.add((initial_state.pos, initial_state.dir, tuple(initial_state.inventory)))\n\n  # Maximum number of steps to search, to prevent infinite loops in unreachable scenarios\n  # or excessively long paths. This value might need adjustment based on typical map size.\n  MAX_SEARCH_DEPTH = 500 \n\n  head = 0 # Pointer for the front of the queue\n  while head < len(queue):\n    current_state, actions_taken = queue[head]\n    head += 1\n\n    # If the primitive is now in the inventory, we have found a solution path\n    if current_state.inventory[primitive] > 0:\n      return actions_taken\n    \n    # Prune search if path becomes too long to avoid excessive computation\n    if len(actions_taken) >= MAX_SEARCH_DEPTH:\n      continue\n\n    # Explore possible next actions: Movement (N, S, E, W) and USE\n    possible_actions = [DOWN, UP, LEFT, RIGHT]\n    \n    # Only consider 'USE' action if the agent is next to the target primitive.\n    # This prunes invalid USE actions and makes the search more efficient.\n    if current_state.next_to(primitive):\n      possible_actions.append(USE)\n    \n    for action in possible_actions:\n      # Apply the action to get the next state.\n      # CraftState.step returns (reward, new_state). Reward is not used here.\n      _, next_state = current_state.step(action) \n\n      # Create a unique signature for the next state for the visited set\n      next_state_signature = (next_state.pos, next_state.dir, tuple(next_state.inventory))\n\n      if next_state_signature not in visited:\n        visited.add(next_state_signature)\n        new_actions = actions_taken + [action] # Create a new list for the path\n        queue.append((next_state, new_actions))\n  \n  # If the queue is exhausted and the primitive has not been collected,\n  # it means it's unreachable or a path wasn't found within the search depth.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:19:31.307399", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (based on action_specs from CraftLab)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Direction vectors for (dr, dc) based on direction index\n  # 0: North (-1, 0)\n  # 1: East (0, 1)\n  # 2: South (1, 0)\n  # 3: West (0, -1)\n  DIR_VECTORS = {\n      0: (-1, 0),  # North\n      1: (0, 1),   # East\n      2: (1, 0),   # South\n      3: (0, -1)   # West\n  }\n\n  def _get_actions_to_turn(current_dir, target_dir):\n      \"\"\"Calculates the minimal sequence of LEFT/RIGHT turns to change direction.\"\"\"\n      actions = []\n      # Calculate clockwise difference (0, 1, 2, 3 for 0, 90, 180, 270 degrees clockwise)\n      delta = (target_dir - current_dir + 4) % 4\n      if delta == 1:  # 90 degrees clockwise\n          actions.append(RIGHT)\n      elif delta == 2:  # 180 degrees\n          actions.extend([RIGHT, RIGHT]) # Two rights or two lefts\n      elif delta == 3:  # 90 degrees counter-clockwise\n          actions.append(LEFT)\n      return actions\n\n  obs = env.observations()\n  fdict = obs['features_dict']\n  grid = fdict['features_global']\n  initial_pos_normalized = fdict['pos']\n  initial_dir_onehot = fdict['direction']\n  inventory = fdict['inventory']\n\n  # Check if primitive is already collected\n  if inventory[primitive] > 0:\n      return []\n\n  grid_h, grid_w, _ = grid.shape\n  # Convert normalized position to grid coordinates\n  start_r = int(initial_pos_normalized[0] * grid_h)\n  start_c = int(initial_pos_normalized[1] * grid_w)\n  start_dir = np.argmax(initial_dir_onehot) # Convert one-hot to integer direction\n\n  # BFS Queue: (row, col, current_direction, list_of_actions_so_far)\n  q = collections.deque([(start_r, start_c, start_dir, [])]) \n  # Visited set: (row, col, direction) to avoid cycles and redundant paths\n  visited = set([(start_r, start_c, start_dir)]) \n\n  while q:\n      r, c, current_dir, actions_so_far = q.popleft()\n\n      # --- Check for Goal: Is the primitive in a cardinal neighbor cell? ---\n      # Iterate over cardinal neighbors to see if primitive is present\n      # Map (dr, dc) to the target_face_dir for the agent to USE that neighbor\n      cardinal_neighbors_and_dirs = [\n          ((-1, 0), 0), # North: (r-1, c) needs agent facing North (dir 0)\n          ((0, 1), 1),  # East: (r, c+1) needs agent facing East (dir 1)\n          ((1, 0), 2),  # South: (r+1, c) needs agent facing South (dir 2)\n          ((0, -1), 3)  # West: (r, c-1) needs agent facing West (dir 3)\n      ]\n      \n      for (dr, dc), target_face_dir_for_use in cardinal_neighbors_and_dirs:\n          nr, nc = r + dr, c + dc\n          # Check if neighbor is within grid bounds and contains the primitive\n          if 0 <= nr < grid_h and 0 <= nc < grid_w and grid[nr, nc, primitive] > 0:\n              # Found a primitive at (nr, nc). Current cell (r, c) is the target adjacent cell.\n              # Agent needs to face (nr, nc) and then USE.\n              turn_actions = _get_actions_to_turn(current_dir, target_face_dir_for_use)\n              final_actions = actions_so_far + turn_actions + [USE]\n              return final_actions\n\n      # --- Explore Movement Options (UP, DOWN, LEFT, RIGHT actions) ---\n\n      # Action UP (Move Forward)\n      move_forward_dr, move_forward_dc = DIR_VECTORS[current_dir]\n      next_r, next_c = r + move_forward_dr, c + move_forward_dc\n      if 0 <= next_r < grid_h and 0 <= next_c < grid_w:\n          new_state_key = (next_r, next_c, current_dir)\n          if new_state_key not in visited:\n              visited.add(new_state_key)\n              new_actions = actions_so_far + [UP]\n              q.append((next_r, next_c, current_dir, new_actions))\n\n      # Action DOWN (Move Backward)\n      move_backward_dr, move_backward_dc = -move_forward_dr, -move_forward_dc # Opposite of forward\n      next_r, next_c = r + move_backward_dr, c + move_backward_dc\n      if 0 <= next_r < grid_h and 0 <= next_c < grid_w:\n          new_state_key = (next_r, next_c, current_dir)\n          if new_state_key not in visited:\n              visited.add(new_state_key)\n              new_actions = actions_so_far + [DOWN]\n              q.append((next_r, next_c, current_dir, new_actions))\n\n      # Action LEFT (Turn Left)\n      next_dir_left = (current_dir - 1 + 4) % 4 # Cycle directions 0->3->2->1->0\n      new_state_key = (r, c, next_dir_left)\n      if new_state_key not in visited:\n          visited.add(new_state_key)\n          new_actions = actions_so_far + [LEFT]\n          q.append((r, c, next_dir_left, new_actions))\n\n      # Action RIGHT (Turn Right)\n      next_dir_right = (current_dir + 1) % 4 # Cycle directions 0->1->2->3->0\n      new_state_key = (r, c, next_dir_right)\n      if new_state_key not in visited:\n          visited.add(new_state_key)\n          new_actions = actions_so_far + [RIGHT]\n          q.append((r, c, next_dir_right, new_actions))\n  \n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:19:31.377061", "function_name": "collect", "function_body": "    import collections # Used for collections.deque in BFS\n\n    # Define action constants based on CraftLab.action_specs()\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Map movement actions to their corresponding (dx, dy) grid coordinate changes\n    _DELTAS = {\n        DOWN: (0, -1), # Negative Y-axis for \"down\"\n        UP: (0, 1),    # Positive Y-axis for \"up\"\n        LEFT: (-1, 0), # Negative X-axis for \"left\"\n        RIGHT: (1, 0), # Positive X-axis for \"right\"\n    }\n\n    # Maximum number of steps allowed for a single collection attempt\n    # This prevents infinite loops if the item is unreachable or an error occurs.\n    MAX_COLLECT_STEPS = 200\n\n    def _get_path_bfs(grid, start_pos, target_kind, non_grabbable_indices):\n        \"\"\"\n        Finds a path of movement actions from the agent's start_pos to a cell\n        that is \"adjacent\" to the target_kind. Adjacency is defined by the\n        CraftState.next_to method, which checks a 3x3 neighborhood (including\n        the agent's current cell).\n\n        Args:\n            grid (numpy.ndarray): The current grid state, with shape (Height, Width, Kinds).\n            start_pos (tuple[int, int]): The agent's current (x, y) position.\n            target_kind (int): The integer index of the entity kind to find.\n            non_grabbable_indices (set[int]): A set of integer indices representing\n                                               entity kinds that act as impassable obstacles.\n\n        Returns:\n            list[int]: A list of action integers (UP, DOWN, LEFT, RIGHT) that\n                       represent the shortest path to reach a position from which\n                       the target_kind is \"next to\" the agent. Returns None if no\n                       such path is found.\n        \"\"\"\n        grid_height, grid_width, _ = grid.shape\n        start_x, start_y = start_pos\n\n        # Queue for BFS: stores (current_x, current_y, list_of_actions_taken_to_reach_here)\n        q = collections.deque([(start_x, start_y, [])])\n        visited = {(start_x, start_y)} # Set of (x, y) coordinates already visited to prevent cycles\n\n        while q:\n            curr_x, curr_y, path_actions = q.popleft()\n\n            # Check if the current position (curr_x, curr_y) is adjacent to the target_kind.\n            # This logic mirrors CraftState.next_to: checking the 3x3 neighborhood.\n            found_target_adjacent = False\n            for dx_adj in [-1, 0, 1]:\n                for dy_adj in [-1, 0, 1]:\n                    adj_x, adj_y = curr_x + dx_adj, curr_y + dy_adj\n\n                    # Ensure the adjacent cell is within grid boundaries\n                    if (0 <= adj_x < grid_width and 0 <= adj_y < grid_height):\n                        # Check if the target_kind is present at this adjacent cell\n                        # Note: `grid` uses (y, x) indexing for dimensions\n                        if grid[adj_y, adj_x, target_kind] > 0:\n                            found_target_adjacent = True\n                            break # Found target in this neighborhood, stop checking adjacent cells\n                if found_target_adjacent:\n                    break # Found target in this neighborhood, stop checking dx_adj loops\n            \n            if found_target_adjacent:\n                # If the current position allows interaction with the target, return the path to get here.\n                return path_actions\n\n            # Explore all possible valid movement actions from the current position\n            for action_val, (dx, dy) in _DELTAS.items():\n                next_x, next_y = curr_x + dx, curr_y + dy\n\n                # Check if the next position is within grid boundaries and has not been visited yet\n                if (0 <= next_x < grid_width and 0 <= next_y < grid_height and\n                    (next_x, next_y) not in visited):\n\n                    # Determine if the next cell is traversable.\n                    # A cell is non-traversable if it contains any kind from `non_grabbable_indices`.\n                    is_traversable = True\n                    for kind_idx in non_grabbable_indices:\n                        if grid[next_y, next_x, kind_idx] > 0: # Check if next cell contains an obstacle\n                            is_traversable = False\n                            break\n                    \n                    if is_traversable:\n                        visited.add((next_x, next_y)) # Mark as visited\n                        # Add the action taken to the path and enqueue the new state for further exploration\n                        q.append((next_x, next_y, path_actions + [action_val]))\n\n        return None # No path found to any cell adjacent to the target_kind\n\n    # List to store the sequence of actions to be returned\n    actions_to_return = []\n    # Counter for the total number of actions executed so far\n    current_actions_executed = 0\n    \n    # Main loop to attempt collecting the primitive. It plans, executes, and retries if needed.\n    # It continues until the primitive is collected or MAX_COLLECT_STEPS is reached.\n    while current_actions_executed < MAX_COLLECT_STEPS:\n        # Get the current state information from the environment\n        obs = env.observations()\n        current_state = env._current_state # Direct access to the internal CraftState object\n\n        # 1. Check if the primitive is already in the agent's inventory\n        if current_state.inventory[primitive] > 0:\n            return actions_to_return # Goal satisfied, return the path taken\n\n        # 2. Get current grid and agent's position for pathfinding\n        grid = current_state.grid\n        current_pos = current_state.pos # Agent's (x, y) coordinates\n\n        # 3. Get indices of non-grabbable items (obstacles) from the world configuration\n        non_grabbable_indices = current_state.world.non_grabbable_indices\n\n        # 4. Find a path of movement actions to reach a position adjacent to the primitive\n        path_to_item_adjacent = _get_path_bfs(grid, current_pos, primitive, non_grabbable_indices)\n        \n        if path_to_item_adjacent is None:\n            # If no path is found, the primitive might be unreachable, not present on the grid,\n            # or the current environment configuration doesn't allow direct collection.\n            # In such cases, we cannot proceed with direct collection using this method.\n            return actions_to_return\n            \n        # 5. Execute the planned movement path\n        for action in path_to_item_adjacent:\n            # Check for max steps before executing each action in the path\n            if current_actions_executed >= MAX_COLLECT_STEPS:\n                return actions_to_return # Stop if maximum steps limit is reached during path execution\n            \n            # Take a step in the environment with the current action\n            _reward, _done, _ = env.step(action)\n            actions_to_return.append(action)\n            current_actions_executed += 1\n            \n            # After each step, re-check if the goal was achieved or the episode ended\n            if current_state.inventory[primitive] > 0:\n                 return actions_to_return # Primitive collected\n            if _done:\n                return actions_to_return # Episode finished for other reasons\n\n        # 6. After executing the path, the agent should now be in a position adjacent to the primitive.\n        # Verify this with `next_to` before attempting to USE the item.\n        current_state_after_move = env._current_state\n        if current_state_after_move.next_to(primitive):\n            # Check for max steps before the USE action\n            if current_actions_executed >= MAX_COLLECT_STEPS:\n                return actions_to_return\n\n            # Perform the USE action to try and collect the primitive\n            _reward, _done, _ = env.step(USE)\n            actions_to_return.append(USE)\n            current_actions_executed += 1\n            \n            # After USE action, check if the primitive was successfully collected\n            if current_state_after_move.inventory[primitive] > 0:\n                return actions_to_return # Primitive collected\n            if _done:\n                return actions_to_return # Episode finished\n\n        # If the primitive was not collected after the USE attempt (e.g., it wasn't interactable,\n        # or `next_to` somehow failed right before `USE`), the loop will continue to the next\n        # iteration to re-plan if `MAX_COLLECT_STEPS` hasn't been reached.\n\n    return actions_to_return # Return actions if MAX_COLLECT_STEPS is reached without collecting the item", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:20:51.302318", "function_name": "collect", "function_body": "    # Action constants\n    UP = 0\n    DOWN = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Define movement deltas for each action (dx, dy)\n    DELTAS = {\n        UP: (0, -1),   # Decreases y (moves agent \"up\" on a typical grid)\n        DOWN: (0, 1),    # Increases y (moves agent \"down\")\n        LEFT: (-1, 0),   # Decreases x (moves agent \"left\")\n        RIGHT: (1, 0),  # Increases x (moves agent \"right\")\n    }\n    ACTIONS_MOVE = [UP, DOWN, LEFT, RIGHT]\n\n    actions = []\n\n    # Get current state information from the CraftLab environment's internal state\n    state = env._current_state\n    grid = state.grid\n    current_pos = state.pos\n    inventory = state.inventory\n    world = state.world # Needed for non_grabbable_indices\n\n    WIDTH, HEIGHT, _ = grid.shape # grid is typically (WIDTH, HEIGHT, n_kinds)\n\n    # If the primitive is already in inventory, no actions are needed\n    if inventory[primitive] > 0:\n        return []\n\n    # Helper function to check if a coordinate is within grid bounds\n    def is_valid_coord(x, y):\n        return 0 <= x < WIDTH and 0 <= y < HEIGHT\n\n    # Helper function to check if a cell is walkable\n    # A cell is walkable if it's within bounds and does not contain any non-grabbable item.\n    def is_walkable(x, y):\n        if not is_valid_coord(x, y):\n            return False\n        # Check if any non-grabbable item (like water, lava, walls, workbench areas)\n        # is present at (x,y). Agent cannot walk through these.\n        for idx in world.non_grabbable_indices:\n            if grid[x, y, idx] > 0:\n                return False\n        return True\n\n    # Find all potential \"target standing positions\" for the agent.\n    # These are walkable cells that are directly adjacent to an instance of the primitive.\n    target_standing_positions = set() # Using a set to store unique (x, y) coordinates\n    \n    # Iterate through the entire grid to find all instances of the primitive\n    for x_item in range(WIDTH):\n        for y_item in range(HEIGHT):\n            if grid[x_item, y_item, primitive] > 0: # If the primitive is found at (x_item, y_item)\n                # Check all 4 neighbors of this primitive's location\n                for dx, dy in DELTAS.values():\n                    x_agent_stand, y_agent_stand = x_item + dx, y_item + dy\n                    # If this neighboring cell is walkable, it's a valid spot for the agent to stand\n                    if is_walkable(x_agent_stand, y_agent_stand):\n                        target_standing_positions.add((x_agent_stand, y_agent_stand))\n    \n    if not target_standing_positions:\n        # The primitive was not found on the grid, or no walkable spots next to it exist.\n        return []\n\n    # Use Breadth-First Search (BFS) to find the shortest path from the current agent position\n    # to any of the identified target_standing_positions.\n    # The queue stores tuples of (current_position, list_of_actions_to_reach_here)\n    import collections # collections module is assumed to be imported at top-level\n    queue = collections.deque([(current_pos, [])]) \n    visited = {current_pos} # Keep track of visited coordinates to avoid redundant exploration and cycles\n\n    best_path_to_target = None\n\n    while queue:\n        (x_curr, y_curr), path_so_far = queue.popleft()\n\n        # If the current position is one of the target standing positions, we've found a path.\n        # Since BFS explores layer by layer, the first path found to *any* target is guaranteed to be the shortest.\n        if (x_curr, y_curr) in target_standing_positions:\n            best_path_to_target = path_so_far\n            break # Found the shortest path, no need to explore further\n\n        # Explore all possible movement actions from the current position\n        for action_move in ACTIONS_MOVE:\n            dx, dy = DELTAS[action_move]\n            next_x, next_y = x_curr + dx, y_curr + dy\n\n            # If the next cell is walkable and hasn't been visited yet\n            if is_walkable(next_x, next_y) and (next_x, next_y) not in visited:\n                visited.add((next_x, next_y)) # Mark as visited\n                # Add the new state (next position and updated path) to the queue\n                queue.append(((next_x, next_y), path_so_far + [action_move]))\n\n    if best_path_to_target is None:\n        # No path could be found from the agent's current position to any cell next to the primitive.\n        return []\n    \n    # Add the movement actions required to reach the target standing position\n    actions.extend(best_path_to_target)\n    \n    # After moving to a position next to the primitive, add the USE action to collect it.\n    actions.append(USE)\n\n    return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:20:51.384970", "function_name": "collect", "function_body": "    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n    MOVEMENT_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n    actions_taken = []\n    max_steps = 200  # Maximum number of steps to attempt for collection\n\n    # visited_states_while_searching stores (x, y, dir, inventory_tuple)\n    # Only states where the primitive is NOT yet collected are added.\n    # This prevents infinite loops when exploring without progress, but allows revisiting\n    # positions if the inventory or agent's direction (and thus view/options) changes.\n    visited_states_while_searching = set()\n\n    # Get initial observations and current state\n    current_obs = env.observations()\n    current_state = env._current_state  # Access to the underlying CraftState\n\n    # Check if the primitive is already in inventory at the start\n    if current_obs['inventory'][primitive] > 0:\n        return actions_taken\n\n    for step_count in range(max_steps):\n        # Current state key for visited set\n        pos_x, pos_y = current_state.pos\n        current_dir = current_state.dir\n        inventory_tuple = tuple(current_state.inventory)\n        state_key = (pos_x, pos_y, current_dir, inventory_tuple)\n\n        # Before making any decision, check if the primitive has been collected\n        # (This check is redundant for the start of the loop but good after actions)\n        if current_obs['inventory'][primitive] > 0:\n            return actions_taken\n\n        # If we have revisited this exact state (position, direction, inventory)\n        # without having collected the primitive, we're likely in a loop or stuck.\n        if state_key in visited_states_while_searching:\n            break  # Exit the loop, return actions taken (unsuccessful)\n        \n        # Add current state to visited set\n        visited_states_while_searching.add(state_key)\n\n        # Priority 1: If the primitive is next to the agent, try to USE it\n        if current_state.next_to(primitive):\n            reward, done, next_obs = env.step(USE)\n            actions_taken.append(USE)\n            current_obs = next_obs\n            current_state = env._current_state\n            # Re-check inventory immediately after attempting USE\n            if current_obs['inventory'][primitive] > 0:\n                return actions_taken\n            if done:  # Environment signalled termination (e.g., max_steps reached)\n                return actions_taken\n            continue  # Continue to the next step to re-evaluate the new state\n\n        # Priority 2: Find the primitive on the global grid and move towards the closest one\n        best_move_action = None\n        min_dist = float('inf')\n\n        agent_x, agent_y = current_state.pos\n        grid = current_state.grid\n        grid_width, grid_height, _ = grid.shape\n\n        found_target_on_grid = False\n        for x in range(grid_width):\n            for y in range(grid_height):\n                # Check if this cell contains the primitive\n                if grid[x, y, primitive] == 1:\n                    found_target_on_grid = True\n                    # Calculate Manhattan distance to the primitive\n                    dist = abs(x - agent_x) + abs(y - agent_y)\n\n                    # Prioritize closer targets; if equally close, current choice stands\n                    if dist < min_dist:\n                        min_dist = dist\n                        \n                        # Determine movement direction towards (x, y)\n                        dx = x - agent_x\n                        dy = y - agent_y\n\n                        # Prioritize moving along the axis with larger distance\n                        if abs(dx) > abs(dy):\n                            if dx > 0:\n                                best_move_action = RIGHT\n                            else: # dx < 0\n                                best_move_action = LEFT\n                        elif abs(dy) > 0: # Only if horizontal movement is zero or smaller\n                            if dy > 0:\n                                best_move_action = DOWN\n                            else: # dy < 0\n                                best_move_action = UP\n                        # If dx=0 and dy=0, agent is on the target. This case should have been caught\n                        # by next_to() if it's grabbable, or implies it's an obstacle.\n                        # No movement action needed if already on the spot.\n\n        if found_target_on_grid and best_move_action is not None:\n            # Execute the chosen movement action\n            reward, done, next_obs = env.step(best_move_action)\n            actions_taken.append(best_move_action)\n            current_obs = next_obs\n            current_state = env._current_state\n            if current_obs['inventory'][primitive] > 0:\n                return actions_taken\n            if done:\n                return actions_taken\n            continue  # Continue to next step to re-evaluate position and proximity\n\n        # Priority 3: If no primitive found on grid or unable to move towards it, explore randomly\n        # This acts as a fallback to continue searching for the primitive, especially if it's\n        # initially out of sight or if direct pathfinding is stuck.\n        action_to_take = np.random.choice(MOVEMENT_ACTIONS)\n        reward, done, next_obs = env.step(action_to_take)\n        actions_taken.append(action_to_take)\n        current_obs = next_obs\n        current_state = env._current_state\n        if current_obs['inventory'][primitive] > 0:\n            return actions_taken\n        if done:\n            return actions_taken\n        # Continue to the next iteration of the loop\n\n    # If the loop finishes (max_steps reached) and the primitive is not collected\n    return actions_taken", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:22:43.772983", "function_name": "collect", "function_body": "    \"\"\"Improved version of `collect_v1`.\"\"\"\n\n    # --- Nested Helper Functions and Constants ---\n\n    # Constants for agent directions (standard N, E, S, W mapping)\n    NORTH = 0\n    EAST = 1\n    SOUTH = 2\n    WEST = 3\n\n    # Map (dx, dy) coordinate changes to the env_factory.actions type\n    _DELTA_TO_ACTION_TYPE = {\n        (0, -1): env_factory.actions.UP,\n        (0, 1): env_factory.actions.DOWN,\n        (-1, 0): env_factory.actions.LEFT,\n        (1, 0): env_factory.actions.RIGHT,\n    }\n\n    # Map direction index to (dx, dy) delta for current facing direction\n    _DIR_TO_DELTA = {\n        NORTH: (0, -1),  # Facing North (Up) means moving (0, -1)\n        EAST: (1, 0),    # Facing East (Right) means moving (1, 0)\n        SOUTH: (0, 1),   # Facing South (Down) means moving (0, 1)\n        WEST: (-1, 0),   # Facing West (Left) means moving (-1, 0)\n    }\n\n    # Map (dx, dy) delta to direction index\n    _DELTA_TO_DIR = {\n        (0, -1): NORTH,\n        (1, 0): EAST,\n        (0, 1): SOUTH,\n        (-1, 0): WEST,\n    }\n\n    # Relative turns needed to get from current_dir to target_dir (number of right turns)\n    # A value of -1 means one left turn.\n    _DIR_DELTA = {\n        (NORTH, NORTH): 0, (NORTH, EAST): 1, (NORTH, SOUTH): 2, (NORTH, WEST): -1,\n        (EAST, NORTH): -1, (EAST, EAST): 0, (EAST, SOUTH): 1, (EAST, WEST): 2,\n        (SOUTH, NORTH): 2, (SOUTH, EAST): -1, (SOUTH, SOUTH): 0, (SOUTH, WEST): 1,\n        (WEST, NORTH): 1, (WEST, EAST): 2, (WEST, SOUTH): -1, (WEST, WEST): 0,\n    }\n\n    # Action integer values from the environment's action specifications\n    _env_action_map = env.action_specs()\n    _ACTIONS = {\n        env_factory.actions.DOWN: _env_action_map[env_factory.actions.DOWN],\n        env_factory.actions.UP: _env_action_map[env_factory.actions.UP],\n        env_factory.actions.LEFT: _env_action_map[env_factory.actions.LEFT],\n        env_factory.actions.RIGHT: _env_action_map[env_factory.actions.RIGHT],\n        env_factory.actions.USE: _env_action_map[env_factory.actions.USE],\n    }\n\n    def _is_valid_coord(x, y, grid_shape):\n        \"\"\"Checks if (x,y) is within grid bounds.\"\"\"\n        width, height, _ = grid_shape\n        return 0 <= x < width and 0 <= y < height\n\n    def _is_traversable(x, y, grid, world_config):\n        \"\"\"Checks if a cell (x,y) is traversable.\n           Assumes only water is non-traversable for agent movement.\n        \"\"\"\n        if not _is_valid_coord(x, y, grid.shape):\n            return False\n        # Check for water, which is typically a non-traversable obstacle.\n        if grid[x, y, world_config.water_index] == 1:\n            return False\n        return True\n\n    def _find_path_to_adjacent(start_pos, grid, primitive_idx, world_config):\n        \"\"\"\n        Finds the shortest path (in terms of grid cells) from `start_pos` to any\n        cell that is immediately adjacent (4-directional) to an instance of `primitive_idx`.\n        \n        Args:\n            start_pos: Agent's current (x, y) position.\n            grid: The global grid from `features_global`.\n            primitive_idx: The integer ID of the primitive to find.\n            world_config: The `CraftWorld` instance, providing `water_index` etc.\n\n        Returns:\n            A tuple (path_coords, primitive_pos):\n            - `path_coords`: A list of (x,y) coordinates representing the path from\n              `start_pos` (exclusive) to the found adjacent cell (inclusive).\n              Empty list if `start_pos` is already adjacent.\n            - `primitive_pos`: The (x,y) coordinate of the actual primitive found.\n            Returns (None, None) if no path is found or the primitive is not present/reachable.\n        \"\"\"\n        q = collections.deque([(start_pos, [])])  # (current_pos, path_so_far)\n        visited = {start_pos}\n\n        # Possible relative neighbor coordinates for target check and path exploration\n        neighbor_deltas = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n\n        while q:\n            curr_pos, path = q.popleft()\n\n            # Check if `curr_pos` is adjacent to the primitive\n            for dx, dy in neighbor_deltas:\n                px, py = curr_pos[0] + dx, curr_pos[1] + dy\n                if _is_valid_coord(px, py, grid.shape) and grid[px, py, primitive_idx] == 1:\n                    return path, (px, py)  # Found a path to an adjacent cell and the primitive's position\n\n            # Explore traversable neighbors\n            for dx, dy in neighbor_deltas:\n                nx, ny = curr_pos[0] + dx, curr_pos[1] + dy\n                next_pos = (nx, ny)\n\n                if _is_traversable(nx, ny, grid, world_config) and next_pos not in visited:\n                    visited.add(next_pos)\n                    q.append((next_pos, path + [next_pos]))\n        return None, None  # No path found or primitive not reachable\n\n    def _get_target_face_direction(agent_pos, primitive_pos):\n        \"\"\"\n        Determines the direction the agent needs to face to look at `primitive_pos`\n        from `agent_pos`. Assumes `agent_pos` and `primitive_pos` are adjacent.\n        \"\"\"\n        dx = primitive_pos[0] - agent_pos[0]\n        dy = primitive_pos[1] - agent_pos[1]\n\n        # This should always yield a valid direction if positions are adjacent.\n        if (dx, dy) not in _DELTA_TO_DIR:\n            # Fallback for unexpected non-adjacent delta or same position, though this scenario\n            # should ideally be prevented by design of _find_path_to_adjacent.\n            return NORTH # Arbitrary default if logic fails\n        return _DELTA_TO_DIR[(dx, dy)]\n\n    # --- Main Logic for collect_v2 ---\n\n    all_actions = []\n\n    # Get current state from the environment\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    agent_pos = tuple(obs['features_dict']['pos'].astype(int))\n    agent_dir = np.argmax(obs['features_dict']['direction'])\n\n    # 1. Check if the primitive is already in inventory\n    if obs['features_dict']['inventory'][primitive] > 0:\n        return []  # Already collected, no actions needed\n\n    # 2. Find the shortest path to a cell adjacent to the primitive\n    path_to_adjacent, actual_primitive_pos = _find_path_to_adjacent(agent_pos, grid, primitive, env.world)\n\n    if actual_primitive_pos is None:\n        # Primitive not found or not reachable on the map from current position\n        return []\n\n    # 3. Simulate agent movement along the path and append corresponding actions\n    simulated_agent_pos = agent_pos\n    simulated_agent_dir = agent_dir\n\n    for next_coord in path_to_adjacent:\n        dx, dy = next_coord[0] - simulated_agent_pos[0], next_coord[1] - simulated_agent_pos[1]\n        \n        target_dir = _DELTA_TO_DIR[(dx, dy)]\n        move_action_type = _DELTA_TO_ACTION_TYPE[(dx, dy)]\n\n        # Add turn actions to face the desired movement direction\n        num_right_turns = _DIR_DELTA[(simulated_agent_dir, target_dir)]\n        if num_right_turns == -1:  # One left turn\n            all_actions.append(_ACTIONS[env_factory.actions.LEFT])\n            simulated_agent_dir = (simulated_agent_dir - 1 + 4) % 4\n        elif num_right_turns == 1:  # One right turn\n            all_actions.append(_ACTIONS[env_factory.actions.RIGHT])\n            simulated_agent_dir = (simulated_agent_dir + 1) % 4\n        elif num_right_turns == 2:  # Two right turns (180 degree turn)\n            all_actions.append(_ACTIONS[env_factory.actions.RIGHT])\n            all_actions.append(_ACTIONS[env_factory.actions.RIGHT])\n            simulated_agent_dir = (simulated_agent_dir + 2) % 4\n        \n        # Add the move action\n        all_actions.append(_ACTIONS[move_action_type])\n        \n        # Update simulated agent position after movement\n        simulated_agent_pos = next_coord\n\n    # 4. Once adjacent to the primitive, turn to face it and USE\n    \n    # Calculate the precise direction to face the actual primitive from the final adjacent position\n    target_face_dir = _get_target_face_direction(simulated_agent_pos, actual_primitive_pos)\n\n    # Add turn actions to face the primitive\n    num_right_turns = _DIR_DELTA[(simulated_agent_dir, target_face_dir)]\n    if num_right_turns == -1:  # One left turn\n        all_actions.append(_ACTIONS[env_factory.actions.LEFT])\n    elif num_right_turns == 1:  # One right turn\n        all_actions.append(_ACTIONS[env_factory.actions.RIGHT])\n    elif num_right_turns == 2:  # Two right turns (180 degree turn)\n        all_actions.append(_ACTIONS[env_factory.actions.RIGHT])\n        all_actions.append(_ACTIONS[env_factory.actions.RIGHT])\n\n    # Add the USE action to collect the primitive\n    all_actions.append(_ACTIONS[env_factory.actions.USE])\n\n    return all_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:22:43.843717", "function_name": "collect", "function_body": "    import collections\n    \n    # Action constants as defined in CraftLab.action_specs\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    actions_taken = []\n    \n    current_state = env._current_state\n\n    # If the primitive is already in the inventory, nothing needs to be collected.\n    if current_state.satisfies(None, primitive):\n        return []\n\n    grid = current_state.grid\n    start_pos = current_state.pos\n    grid_width, grid_height, _ = grid.shape # grid.shape is (WIDTH, HEIGHT, n_kinds)\n\n    # BFS state: (current_position, path_to_current_position)\n    q = collections.deque([(start_pos, [])])\n    visited = {start_pos}\n    \n    final_path_to_adj = None\n    primitive_found_adjacent = False\n\n    # Define neighbor deltas and their corresponding movement actions\n    # (delta_row, delta_col): action\n    neighbor_deltas_actions = [\n        ((1, 0), DOWN),  # Move Down (row + 1)\n        ((-1, 0), UP),   # Move Up (row - 1)\n        ((0, -1), LEFT), # Move Left (col - 1)\n        ((0, 1), RIGHT)  # Move Right (col + 1)\n    ]\n\n    while q and not primitive_found_adjacent:\n        current_pos, path = q.popleft()\n        r, c = current_pos\n\n        # Check if any cell adjacent to current_pos contains the primitive.\n        # If so, current_pos is a valid \"adjacency point\" for USE action.\n        for (dr, dc), _ in neighbor_deltas_actions: # We only care about the neighbor position here\n            nr, nc = r + dr, c + dc\n            \n            # Check bounds for the potential neighbor\n            if 0 <= nr < grid_width and 0 <= nc < grid_height:\n                # If this neighbor contains the primitive\n                if grid[nr, nc, primitive] > 0:\n                    final_path_to_adj = list(path) # Path to current_pos (the adjacency cell)\n                    primitive_found_adjacent = True\n                    break # Found a path to an adjacent cell, break inner loop\n\n        if primitive_found_adjacent:\n            break # Break outer BFS loop if a path was found\n\n        # If not yet adjacent to the primitive, continue exploring movements\n        for (dr, dc), action_to_move_to_neighbor in neighbor_deltas_actions:\n            nr, nc = r + dr, c + dc\n            \n            # Check bounds and if neighbor has been visited\n            if 0 <= nr < grid_width and 0 <= nc < grid_height and (nr, nc) not in visited:\n                # Add to visited and queue\n                visited.add((nr, nc))\n                q.append(((nr, nc), path + [action_to_move_to_neighbor]))\n    \n    # If no path to an adjacent cell was found, the primitive is unreachable or not present\n    if not primitive_found_adjacent:\n        return []\n\n    # Execute the found path movements\n    for action in final_path_to_adj:\n        actions_taken.append(action)\n        reward, done, obs = env.step(action)\n        # If the environment signals done during movement, stop and return actions taken so far\n        if done:\n            return actions_taken\n        # Update current state for any subsequent checks\n        current_state = env._current_state\n\n    # After movements, the agent is at a position adjacent to the primitive.\n    # Now, perform the USE action to collect the primitive.\n    actions_taken.append(USE)\n    reward, done, obs = env.step(USE)\n    \n    # If the environment signals done after USE action, stop and return actions\n    if done:\n        return actions_taken\n\n    # The function aims to collect the primitive. We assume one USE is sufficient\n    # if the path led to the correct adjacency.\n    # The current_state.satisfies check implicitly happens via the reward logic in CraftLab.\n    # No further checks needed here, just return the sequence of actions taken.\n\n    return actions_taken", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:24:43.652048", "function_name": "collect", "function_body": "  import numpy as np\n\n  # Actions mapping (constants)\n  ACTIONS = {\n      \"DOWN\": 0,\n      \"UP\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  # Agent's relative position in a 5x5 egocentric view (center)\n  AGENT_R, AGENT_C = 2, 2\n\n  # Relative offsets from agent's position (AGENT_R, AGENT_C) for cells directly in front\n  # based on direction. Directions: 0=N, 1=E, 2=S, 3=W (assuming DMLab-style one-hot vector)\n  DIR_OFFSETS = {\n      0: (-1, 0),  # North: row - 1, col + 0\n      1: (0, 1),   # East:  row + 0, col + 1\n      2: (1, 0),   # South: row + 1, col + 0\n      3: (0, -1)   # West:  row + 0, col - 1\n  }\n\n  actions_taken = []\n  # A reasonable limit to prevent infinite loops if primitive is uncollectible or inaccessible\n  max_attempt_steps = 1000\n\n  # Get non-grabbable indices from the CraftWorld instance within CraftLab.\n  # These are entities that block movement or cannot be picked up directly.\n  non_grabbable_indices = env.world.cookbook.environment\n\n  current_observations = env.reset()\n  steps_taken = 0\n\n  while current_observations['features_dict']['inventory'][primitive] == 0 and steps_taken < max_attempt_steps:\n      features_dict = current_observations['features_dict']\n      ego_features = features_dict['features_ego']\n      direction_one_hot = features_dict['direction']\n      \n      # Determine current direction index (0-3)\n      dir_idx = np.argmax(direction_one_hot)\n\n      # Get the coordinates of the cell directly in front of the agent\n      front_r, front_c = AGENT_R + DIR_OFFSETS[dir_idx][0], AGENT_C + DIR_OFFSETS[dir_idx][1]\n      \n      # Get the kind information for the cell in front\n      cell_in_front_kinds = ego_features[front_r, front_c, :] # A boolean array of kinds present\n\n      action_to_take = None\n\n      # 1. Check if the primitive is directly in front of the agent\n      if cell_in_front_kinds[primitive] == 1:\n          action_to_take = ACTIONS[\"USE\"]\n      # 2. Check if the path in front is blocked by a non-grabbable obstacle\n      elif any(cell_in_front_kinds[idx] == 1 for idx in non_grabbable_indices):\n          action_to_take = ACTIONS[\"RIGHT\"] # Turn right to try and find a clear path\n      # 3. If path is clear, search for the primitive in the visible egocentric view\n      else:\n          # Find all locations where the primitive is present within the ego_features (5x5 view)\n          primitive_locations = np.argwhere(ego_features[:, :, primitive] == 1)\n\n          if len(primitive_locations) > 0:\n              # Prioritize the closest primitive (Manhattan distance) for navigation\n              min_dist = float('inf')\n              closest_target_r, closest_target_c = -1, -1\n              for pr, pc in primitive_locations:\n                  # Calculate Manhattan distance from agent's center\n                  dist = abs(pr - AGENT_R) + abs(pc - AGENT_C)\n                  if dist < min_dist:\n                      min_dist = dist\n                      closest_target_r, closest_target_c = pr, pc\n              \n              # Calculate the relative position of the target from the agent's perspective\n              rel_r, rel_c = closest_target_r - AGENT_R, closest_target_c - AGENT_C\n\n              # Convert relative (row, col) to agent-centric (forward, right) distances\n              forward_dist, right_dist = 0, 0\n              if dir_idx == 0: # North\n                  forward_dist = -rel_r\n                  right_dist = rel_c\n              elif dir_idx == 1: # East\n                  forward_dist = rel_c\n                  right_dist = -rel_r\n              elif dir_idx == 2: # South\n                  forward_dist = rel_r\n                  right_dist = -rel_c\n              elif dir_idx == 3: # West\n                  forward_dist = -rel_c\n                  right_dist = rel_r\n\n              # Decide action: prioritize turning to align with the target, then moving forward\n              if right_dist > 0: # Target is to the right\n                  action_to_take = ACTIONS[\"RIGHT\"]\n              elif right_dist < 0: # Target is to the left\n                  action_to_take = ACTIONS[\"LEFT\"]\n              elif forward_dist > 0: # Target is directly ahead\n                  action_to_take = ACTIONS[\"UP\"] # Move forward\n              elif forward_dist < 0: # Target is behind\n                  action_to_take = ACTIONS[\"RIGHT\"] # Turn 90 degrees to start turning around\n              else: # forward_dist == 0 and right_dist == 0: Target is at agent's current position.\n                    # This implies the primitive is on the same tile as the agent. Assuming 'USE'\n                    # applies to adjacent tiles, this is an unexpected state for collection.\n                    # Fallback to exploration.\n                  action_to_take = ACTIONS[\"RIGHT\"] # Stuck, try turning\n          else:\n              # 4. Primitive not found in egocentric view and path is clear. Explore.\n              action_to_take = ACTIONS[\"UP\"] # Default: try moving forward\n\n      # Execute the determined action\n      reward, done, current_observations = env.step(action_to_take)\n      actions_taken.append(action_to_take)\n      steps_taken += 1\n\n      if done: # If the environment signals completion (goal reached or max_steps reached)\n          break\n\n  return actions_taken", "island_id": 4, "scores": {"3": -1}}
