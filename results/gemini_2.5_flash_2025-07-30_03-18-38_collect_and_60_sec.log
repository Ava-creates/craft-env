{"timestamp": "2025-07-30T09:31:39.830560", "function_name": "collect", "function_body": "    actions = []\n    \n    current_state = env._current_state\n    current_pos = current_state.pos\n    current_dir = current_state.dir # Agent's current direction (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT)\n    grid = current_state.grid\n    \n    action_map = env.action_specs()\n    \n    # Define movement actions based on action_map for clarity and direct use\n    MOVE_ACTIONS = {\n        \"DOWN\": action_map[\"DOWN\"],\n        \"UP\": action_map[\"UP\"],\n        \"LEFT\": action_map[\"LEFT\"],\n        \"RIGHT\": action_map[\"RIGHT\"]\n    }\n    USE_ACTION = action_map[\"USE\"]\n\n    # Helper to map direction action values to (dr, dc) coordinate changes.\n    # These are the (row_change, col_change) for taking that movement action.\n    DIR_TO_VEC = {\n        MOVE_ACTIONS[\"DOWN\"]: (1, 0),   # Row increases, Col stays same\n        MOVE_ACTIONS[\"UP\"]: (-1, 0),    # Row decreases, Col stays same\n        MOVE_ACTIONS[\"LEFT\"]: (0, -1),  # Col decreases, Row stays same\n        MOVE_ACTIONS[\"RIGHT\"]: (0, 1),  # Col increases, Row stays same\n    }\n\n    def _manhattan_distance(pos1, pos2):\n        \"\"\"Calculates the Manhattan distance between two (row, col) positions.\"\"\"\n        return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n    # 1. Find the target position of the primitive on the grid.\n    # np.argwhere returns (row, col) pairs where the condition is true.\n    target_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n    if target_locations.size == 0:\n        # Primitive not found on the grid.\n        return []\n\n    # For simplicity, pick the first found location. In a real scenario,\n    # one might pick the closest target location.\n    target_pos = tuple(target_locations[0]) # (tr, tc)\n\n    grid_height, grid_width = grid.shape[0], grid.shape[1]\n\n    # Define the four possible relative positions for the agent to be adjacent to the target,\n    # along with the required direction the agent must be facing from that adjacent spot to interact with the target.\n    # Format: (agent_rel_dr, agent_rel_dc, required_face_dir_value)\n    #   - agent_rel_dr, agent_rel_dc: Offset from target_pos to agent's desired adjacent position.\n    #   - required_face_dir_value: The direction action value (0-3) agent must be facing to hit the target.\n    AGENT_RELATIVE_POS_TO_FACE_DIR = [\n        (1, 0, MOVE_ACTIONS[\"UP\"]),    # Agent is at (tr+1, tc), needs to face UP to hit (tr, tc)\n        (-1, 0, MOVE_ACTIONS[\"DOWN\"]), # Agent is at (tr-1, tc), needs to face DOWN to hit (tr, tc)\n        (0, 1, MOVE_ACTIONS[\"LEFT\"]),  # Agent is at (tr, tc+1), needs to face LEFT to hit (tr, tc)\n        (0, -1, MOVE_ACTIONS[\"RIGHT\"]) # Agent is at (tr, tc-1), needs to face RIGHT to hit (tr, tc)\n    ]\n\n    best_full_path = []\n    min_path_len = float('inf')\n\n    # Iterate over the four possible adjacent positions for the agent to approach the target.\n    for offset_r, offset_c, required_face_dir_val in AGENT_RELATIVE_POS_TO_FACE_DIR:\n        # Calculate the target adjacent position (where the agent needs to end up).\n        target_adj_pos = (target_pos[0] + offset_r, target_pos[1] + offset_c)\n        \n        # Check if this adjacent position is within grid boundaries.\n        if not (0 <= target_adj_pos[0] < grid_height and 0 <= target_adj_pos[1] < grid_width):\n            continue\n\n        # OPTIMIZATION: If agent is already at the target_adj_pos and facing the correct direction,\n        # no movement is needed, just perform the USE action.\n        if current_pos == target_adj_pos and current_dir == required_face_dir_val:\n            return [USE_ACTION]\n\n        # Calculate the 'pre-final' position. This is the spot from which the agent makes its\n        # very last move (which is `required_face_dir_val`) to reach `target_adj_pos` and be correctly oriented.\n        last_move_dr, last_move_dc = DIR_TO_VEC[required_face_dir_val]\n        pre_final_pos = (target_adj_pos[0] - last_move_dr, target_adj_pos[1] - last_move_dc)\n\n        # Check if this pre-final position is within grid boundaries.\n        if not (0 <= pre_final_pos[0] < grid_height and 0 <= pre_final_pos[1] < grid_width):\n            continue\n            \n        # Generate the path from the current position to the pre-final position\n        # using a simple vertical-then-horizontal movement strategy.\n        path_to_pre_final = []\n        temp_r, temp_c = current_pos[0], current_pos[1]\n\n        # Move vertically to match pre_final_pos's row\n        dy = pre_final_pos[0] - temp_r\n        if dy > 0:\n            path_to_pre_final.extend([MOVE_ACTIONS[\"DOWN\"]] * dy)\n            temp_r += dy\n        elif dy < 0:\n            path_to_pre_final.extend([MOVE_ACTIONS[\"UP\"]] * abs(dy))\n            temp_r += dy\n\n        # Move horizontally to match pre_final_pos's column\n        dx = pre_final_pos[1] - temp_c\n        if dx > 0:\n            path_to_pre_final.extend([MOVE_ACTIONS[\"RIGHT\"]] * dx)\n            temp_c += dx\n        elif dx < 0:\n            path_to_pre_final.extend([MOVE_ACTIONS[\"LEFT\"]] * abs(dx))\n            \n        # The full path consists of moves to pre_final_pos, plus the final move\n        # (which also sets the required facing direction).\n        current_full_path = path_to_pre_final + [required_face_dir_val]\n\n        # Check if this path is shorter than the best one found so far.\n        current_path_len = len(current_full_path)\n        if current_path_len < min_path_len:\n            min_path_len = current_path_len\n            best_full_path = current_full_path\n\n    if not best_full_path:\n        # If no valid path was found to any adjacent cell meeting the facing criteria,\n        # return an empty list of actions.\n        return []\n\n    # After moving and facing the primitive, perform the USE action to collect it.\n    best_full_path.append(USE_ACTION)\n    \n    return best_full_path", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:33:04.385163", "function_name": "collect", "function_body": "    import collections\n\n    action_map = env.action_specs()\n    UP = action_map['UP']\n    DOWN = action_map['DOWN']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    # Helper function to check if a position is adjacent to the primitive\n    def is_adjacent_to_primitive(pos, primitive_kind_idx, current_grid):\n        r, c = pos\n        grid_height, grid_width = current_grid.shape[:2]\n        \n        # Define 4-directional adjacency deltas\n        adj_deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)] # UP, DOWN, LEFT, RIGHT\n        \n        for dr_adj, dc_adj in adj_deltas:\n            nr, nc = r + dr_adj, c + dc_adj\n            # Check boundary conditions for the adjacent cell\n            if 0 <= nr < grid_height and 0 <= nc < grid_width:\n                # Check if the adjacent cell contains the primitive\n                if current_grid[nr, nc, primitive_kind_idx] == 1:\n                    return True\n        return False\n\n    # Get initial observations and current state\n    obs = env.observations()\n    initial_inventory = obs['features_dict']['inventory']\n\n    # If the primitive is already in inventory, no actions needed\n    if initial_inventory[primitive] > 0:\n        return []\n\n    initial_pos = env._current_state.pos\n    current_grid = obs['features_dict']['features_global']\n    grid_height, grid_width = current_grid.shape[:2]\n\n    q = collections.deque()\n    q.append((initial_pos, [])) # (current_pos: (r, c), path_taken: list of actions)\n\n    visited = {initial_pos} # Set to store visited positions (r, c) to prevent cycles\n\n    # Define possible moves and their corresponding actions\n    # (dr, dc) -> action\n    move_actions = {\n        (-1, 0): UP, # Up\n        (1, 0): DOWN, # Down\n        (0, -1): LEFT, # Left\n        (0, 1): RIGHT # Right\n    }\n\n    best_path_to_adj = None\n\n    # BFS loop to find the shortest path to a position adjacent to the primitive\n    while q:\n        current_pos, path_so_far = q.popleft()\n\n        # Check if current_pos is adjacent to the primitive\n        if is_adjacent_to_primitive(current_pos, primitive, current_grid):\n            best_path_to_adj = path_so_far\n            break # Found the shortest path to an adjacent cell\n\n        # Explore neighbors\n        for dr, dc in move_actions.keys():\n            next_r, next_c = current_pos[0] + dr, current_pos[1] + dc\n            next_pos = (next_r, next_c)\n\n            # Check boundary conditions for the next cell\n            if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n                continue\n\n            # Check if position has already been visited\n            if next_pos in visited:\n                continue\n            \n            # For simplicity in v2, assume all cells within grid boundaries are traversable.\n            # A more advanced version would check for impassable terrain/objects.\n            \n            visited.add(next_pos)\n            new_path = path_so_far + [move_actions[(dr, dc)]]\n            q.append((next_pos, new_path))\n\n    # If a path to an adjacent cell was found, add the USE action and return the full path\n    if best_path_to_adj is not None:\n        return best_path_to_adj + [USE]\n    \n    # If no path was found (e.g., primitive is unreachable or not on grid), return an empty list\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:33:04.456254", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Get action mappings from the environment\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    # Define cardinal direction constants (DMLab-style for agent's `dir` attribute)\n    # 0: North (Up on grid), 1: East (Right on grid),\n    # 2: South (Down on grid), 3: West (Left on grid)\n    _DIR_NORTH = 0\n    _DIR_EAST = 1\n    _DIR_SOUTH = 2\n    _DIR_WEST = 3\n\n    # Map (dx, dy) coordinate deltas to the cardinal direction the agent needs to face\n    # to interact with an object at that relative position.\n    _TARGET_DELTA_TO_FACING_DIR = {\n        (0, -1): _DIR_NORTH,  # Target is one cell North (Up)\n        (0, 1): _DIR_SOUTH,   # Target is one cell South (Down)\n        (1, 0): _DIR_EAST,    # Target is one cell East (Right)\n        (-1, 0): _DIR_WEST,   # Target is one cell West (Left)\n    }\n\n    # Get the initial state of the environment\n    initial_state = env._current_state\n    \n    # If the primitive is already in inventory, no actions are needed to collect it.\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    # BFS setup\n    q = collections.deque()\n    # `visited` set stores (pos_x, pos_y, direction) to avoid cycles and redundant exploration.\n    # We include direction because `USE` action depends on it.\n    visited = set()\n\n    # Initial state for BFS: (CraftState object, list of actions to reach this state)\n    q.append((initial_state, []))\n    visited.add((initial_state.pos[0], initial_state.pos[1], initial_state.dir))\n\n    # Get grid dimensions for boundary checks\n    width, height, _ = initial_state.grid.shape\n\n    # Define actions that perform simple cardinal movements\n    _MOVEMENT_ACTIONS = [UP, DOWN, LEFT, RIGHT]\n\n    while q:\n        current_state, path_actions = q.popleft()\n\n        # Check if any cardinally adjacent cell contains the primitive.\n        # This is where the agent would apply the 'USE' action.\n        target_primitive_pos = None\n        for (dx, dy), required_dir_for_interact in _TARGET_DELTA_TO_FACING_DIR.items():\n            nx, ny = current_state.pos[0] + dx, current_state.pos[1] + dy\n\n            # Check bounds for the neighbor cell\n            if not (0 <= nx < width and 0 <= ny < height):\n                continue\n            \n            # Check if the primitive is at this adjacent location\n            if current_state.grid[nx, ny, primitive] > 0:\n                target_primitive_pos = (nx, ny)\n                \n                # Found an adjacent primitive! Now, construct the sequence of actions\n                # to collect it: move to `current_state`, turn to face the primitive, then USE.\n                final_actions = list(path_actions) # Start with actions to reach current_state\n\n                # Calculate turns needed to face the primitive\n                current_dir = current_state.dir\n                # `turn_diff` represents how many 90-degree right turns are needed\n                # (0: no turn, 1: 90-right, 2: 180, 3: 90-left)\n                turn_diff = (required_dir_for_interact - current_dir + 4) % 4\n\n                if turn_diff == 1: # 90 degrees right\n                    final_actions.append(RIGHT)\n                elif turn_diff == 2: # 180 degrees (two right turns)\n                    final_actions.extend([RIGHT, RIGHT])\n                elif turn_diff == 3: # 90 degrees left\n                    final_actions.append(LEFT)\n                \n                final_actions.append(USE)\n                return final_actions # Return the full sequence of actions\n        \n        # If no primitive was found adjacent, continue exploring possible movements.\n        for action in _MOVEMENT_ACTIONS:\n            # Simulate the step using CraftState's own logic to get the next state.\n            # `reward` is not relevant for pathfinding here.\n            _, next_state = current_state.step(action)\n\n            # The key for the visited set is the agent's position and direction.\n            state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n            \n            if state_key not in visited:\n                visited.add(state_key)\n                q.append((next_state, path_actions + [action]))\n\n    # If the BFS completes and no reachable primitive was found\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:34:12.695130", "function_name": "collect", "function_body": "  import collections\n\n  # Define actions from CraftLab.action_specs() locally for readability\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Mapping from action index to (dx, dy) changes in position\n  # Assuming (0,0) is top-left, x increases right, y increases down\n  ACTION_DELTAS = {\n      ACTION_DOWN: (0, 1),\n      ACTION_UP: (0, -1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0),\n  }\n\n  current_state = env._current_state\n  initial_pos = current_state.pos\n  grid = current_state.grid\n  width, height, _ = grid.shape  # Unpack width, height, and n_kinds (which we don't need directly here)\n\n  # Check if the primitive exists anywhere on the grid. If not, no path is possible.\n  primitive_exists_on_grid = False\n  for x in range(width):\n      for y in range(height):\n          if grid[x, y, primitive] > 0:\n              primitive_exists_on_grid = True\n              break\n      if primitive_exists_on_grid:\n          break\n  \n  if not primitive_exists_on_grid:\n      return [] # Primitive not found on the grid, cannot collect\n\n  # Initialize BFS queue: (current_position, list_of_actions_to_reach_here)\n  queue = collections.deque([(initial_pos, [])])\n  # Keep track of visited positions to avoid cycles and redundant checks\n  visited = {initial_pos}\n\n  while queue:\n      current_pos, path = queue.popleft()\n\n      # Create a temporary CraftState instance to test the `next_to` method\n      # without modifying the actual `env._current_state`.\n      # We only need to change the position for this check.\n      temp_state = current_state.__class__(\n          scenario=current_state.scenario,\n          grid=current_state.grid,\n          pos=current_pos,\n          dir=current_state.dir, # Direction does not affect `next_to` directly\n          inventory=current_state.inventory # Inventory does not affect `next_to`\n      )\n\n      # Check if the current_pos is an \"actionable\" position, meaning the agent can\n      # pick up the primitive from here using the USE action.\n      if temp_state.next_to(primitive):\n          # If we found a path to such a position, append the USE action and return the full path.\n          return path + [ACTION_USE]\n\n      # Explore neighboring cells\n      for action_idx, (dx, dy) in ACTION_DELTAS.items():\n          next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n          next_pos = (next_x, next_y)\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= next_x < width and 0 <= next_y < height):\n              continue\n\n          # If the next position has not been visited, add it to the queue\n          if next_pos not in visited:\n              visited.add(next_pos)\n              queue.append((next_pos, path + [action_idx]))\n\n  # If the queue becomes empty and no path to an actionable position was found,\n  # it means the primitive is unreachable or not present.\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:34:12.764278", "function_name": "collect", "function_body": "    # Get current state from the environment\n    state = env._current_state\n\n    # Get action mappings (e.g., {'UP': 1, 'DOWN': 0, ...})\n    actions = env.action_specs()\n\n    # 1. Check if the primitive is already collected in the inventory\n    if state.inventory[primitive] > 0:\n        return []  # Already collected, no actions needed\n\n    # 2. Check if the primitive is in the immediate 3x3 vicinity.\n    # If it is, the 'USE' action will collect it.\n    if state.next_to(primitive):\n        return [actions['USE']]\n\n    # 3. If not next to, try to find it in the egocentric view\n    # and determine a movement action to get closer.\n    obs = env.observations()\n    features_ego = obs['features_dict']['features_ego']\n\n    # Get dimensions of the egocentric view\n    ego_height, ego_width, _ = features_ego.shape\n    # Agent's position in the egocentric view is typically the center\n    mid_x, mid_y = ego_width // 2, ego_height // 2\n\n    target_coords = None\n    # Iterate through the egocentric view to find the primitive's location\n    # features_ego is indexed as [row, column, kind_id] or [y, x, kind_id]\n    for y in range(ego_height):\n        for x in range(ego_width):\n            # Check if the primitive kind is present at this (x, y) location\n            if features_ego[y, x, primitive] > 0:\n                target_coords = (x, y)\n                break  # Found the primitive, break inner loop\n        if target_coords:\n            break  # Found, break outer loop\n\n    if target_coords:\n        # Primitive found in egocentric view, calculate relative displacement\n        tx, ty = target_coords\n        dx, dy = tx - mid_x, ty - mid_y  # (x_diff, y_diff) from agent\n\n        # Determine the primary direction to move based on larger displacement\n        if abs(dx) > abs(dy):\n            if dx < 0:  # Primitive is to the left (negative x-difference)\n                return [actions['LEFT']]\n            else:  # Primitive is to the right (positive x-difference)\n                return [actions['RIGHT']]\n        else:\n            if dy < 0:  # Primitive is above (negative y-difference)\n                return [actions['UP']]\n            else:  # Primitive is below (positive y-difference)\n                return [actions['DOWN']]\n\n    # 4. If the primitive is not in the immediate vicinity and not in the egocentric view,\n    # perform a random exploration step to potentially discover it.\n    movement_actions = [\n        actions['UP'],\n        actions['DOWN'],\n        actions['LEFT'],\n        actions['RIGHT']\n    ]\n    return [np.random.choice(movement_actions)]", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:36:07.689643", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (assuming these are globally accessible or defined like this)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Direction deltas for movement actions (dy, dx) -> (row_change, col_change)\n  # Corresponds to moving North (-1, 0), South (1, 0), West (0, -1), East (0, 1)\n  MOVE_DELTAS = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # Relative positions for checking neighbors (3x3 grid around agent)\n  # Used to determine if a cell is adjacent to the target primitive.\n  ADJACENCY_DELTAS = [\n      (-1, 0), (1, 0), (0, -1), (0, 1),  # Cardinal directions\n      (-1, -1), (-1, 1), (1, -1), (1, 1)  # Diagonal directions\n  ]\n\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  inventory = current_state.inventory\n  \n  # Check if primitive is already in inventory\n  if inventory[primitive] > 0:\n      return [] # Already collected\n\n  grid_height, grid_width, _ = grid.shape\n  \n  # BFS to find the closest primitive and the path to an adjacent cell\n  # Queue stores (current_position, actions_path_to_current_position)\n  queue = collections.deque([(start_pos, [])])\n  visited = {start_pos}\n\n  target_primitive_location = None\n  path_to_adjacent_cell = []\n\n  while queue:\n      current_pos, current_path = queue.popleft()\n      r, c = current_pos\n\n      # Check if any adjacent cell contains the target primitive\n      for dr_adj, dc_adj in ADJACENCY_DELTAS:\n          neighbor_r, neighbor_c = r + dr_adj, c + dc_adj\n          \n          # Check bounds for neighbor\n          if 0 <= neighbor_r < grid_height and 0 <= neighbor_c < grid_width:\n              # Check if the primitive is at the neighbor location\n              if grid[neighbor_r, neighbor_c, primitive] == 1:\n                  target_primitive_location = (neighbor_r, neighbor_c)\n                  path_to_adjacent_cell = current_path # path to current_pos which is adjacent to target\n                  # Found the closest one (BFS guarantees shortest path in terms of steps)\n                  queue.clear() # Clear queue to stop BFS immediately\n                  break\n      \n      if target_primitive_location:\n          break # Exit outer while loop as well\n\n      # Explore movement neighbors\n      for action, (dr_move, dc_move) in MOVE_DELTAS.items():\n          next_r, next_c = r + dr_move, c + dc_move\n          next_pos = (next_r, next_c)\n\n          # Check bounds and if already visited\n          if (0 <= next_r < grid_height and 0 <= next_c < grid_width and\n                  next_pos not in visited):\n              \n              # Check for obstacles (non-grabbable entities that block movement)\n              is_obstacle = False\n              if hasattr(env.world, 'non_grabbable_indices'): # Robustness check\n                for kind_idx in env.world.non_grabbable_indices:\n                    if grid[next_r, next_c, kind_idx] == 1: # Assuming 1 indicates presence\n                        is_obstacle = True\n                        break\n              \n              if is_obstacle:\n                  continue # Skip this path, it leads to an obstacle\n\n              visited.add(next_pos)\n              new_path = list(current_path) + [action]\n              queue.append((next_pos, new_path))\n                  \n  if not target_primitive_location:\n      return [] # No path found to the primitive\n\n  # Add the USE action to the path\n  final_actions = list(path_to_adjacent_cell)\n  final_actions.append(USE)\n\n  return final_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:36:07.759621", "function_name": "collect", "function_body": "    import collections # Required for deque\n\n    # Action constants (defined here as per strict requirement to be *inside* the function)\n    # These map to the integer action IDs provided by CraftLab.action_specs()\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Movement deltas for (dx, dy) corresponding to each movement action.\n    # Assumes grid coordinates (x, y) where x is horizontal, y is vertical,\n    # and y increases downwards (typical for image/grid rows).\n    MOVE_DELTAS = {\n        ACTION_DOWN: (0, 1),  # Move South (+Y)\n        ACTION_UP: (0, -1),   # Move North (-Y)\n        ACTION_LEFT: (-1, 0), # Move West (-X)\n        ACTION_RIGHT: (1, 0), # Move East (+X)\n    }\n\n    # Maps a movement action to the agent's resulting facing direction.\n    # Assumes: 0=DOWN (South), 1=UP (North), 2=LEFT (West), 3=RIGHT (East).\n    # Taking a movement action is assumed to also set the agent's facing direction.\n    ACTION_TO_DIRECTION_MAP = {\n        ACTION_DOWN: 0,\n        ACTION_UP: 1,\n        ACTION_LEFT: 2,\n        ACTION_RIGHT: 3,\n    }\n\n    # Get the current state information from the CraftLab environment\n    current_state = env._current_state\n    initial_pos = current_state.pos         # Agent's initial (x, y) position\n    initial_dir = current_state.dir         # Agent's initial facing direction (int)\n    initial_inventory = current_state.inventory.copy() # Agent's initial inventory\n\n    # Get grid details and world configuration from the current state\n    grid = current_state.grid\n    world = current_state.world\n    width, height, n_kinds = grid.shape     # Grid dimensions\n\n    # Early exit if the primitive is already in the inventory\n    if initial_inventory[primitive] > 0:\n        return []\n\n    # Initialize BFS queue with the starting state:\n    # (current_x, current_y, current_direction, list_of_actions_taken_so_far)\n    queue = collections.deque([(initial_pos[0], initial_pos[1], initial_dir, [])])\n    \n    # Keep track of visited states to prevent cycles and redundant exploration.\n    # A state is defined by (x, y, direction)\n    visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n    # Helper function to determine if performing a 'USE' action from the current\n    # agent's position and direction would successfully collect the target primitive.\n    def _can_use_primitive(check_grid, cx, cy, c_dir, target_primitive, world_obj, grid_width, grid_height):\n        # Calculate the coordinates of the cell directly in front of the agent\n        fwd_dx, fwd_dy = 0, 0\n        if c_dir == 0: fwd_dx, fwd_dy = 0, 1  # Facing DOWN (South)\n        elif c_dir == 1: fwd_dx, fwd_dy = 0, -1 # Facing UP (North)\n        elif c_dir == 2: fwd_dx, fwd_dy = -1, 0 # Facing LEFT (West)\n        elif c_dir == 3: fwd_dx, fwd_dy = 1, 0  # Facing RIGHT (East)\n        \n        target_x, target_y = cx + fwd_dx, cy + fwd_dy\n\n        # Check if the cell in front is within grid boundaries\n        if not (0 <= target_x < grid_width and 0 <= target_y < grid_height):\n            return False\n\n        # Check if the cell in front contains the target primitive\n        if check_grid[target_x, target_y, target_primitive] > 0:\n            # Additionally, verify if this primitive type is indeed collectible via a 'USE' action.\n            # This covers direct pickups (grabbable_indices) and mining from resource nodes.\n            if target_primitive in world_obj.grabbable_indices or \\\n               target_primitive == world_obj.water_index or \\\n               target_primitive == world_obj.stone_index:\n                return True\n        return False\n\n    # Main BFS loop\n    while queue:\n        cx, cy, c_dir, path = queue.popleft()\n\n        # Check if the current agent state (position and direction) allows\n        # immediate collection of the primitive using the 'USE' action.\n        # We use the initial grid `grid` because the locations of static primitives\n        # don't change until they are collected.\n        if _can_use_primitive(grid, cx, cy, c_dir, primitive, world, width, height):\n            # If so, we've found the shortest path (due to BFS property).\n            # Append the 'USE' action and return the complete action sequence.\n            return path + [ACTION_USE]\n\n        # Explore possible next states by trying all movement actions\n        for action, (dx, dy) in MOVE_DELTAS.items():\n            nx, ny = cx + dx, cy + dy  # Calculate new position\n            n_dir = ACTION_TO_DIRECTION_MAP[action] # Determine new facing direction after this move\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= nx < width and 0 <= ny < height):\n                continue\n\n            # Check if this new state (position + direction) has already been visited\n            if (nx, ny, n_dir) in visited:\n                continue\n\n            # If not visited, add the new state to the queue and mark it as visited\n            new_path = list(path) + [action] # Create a new list for the path to avoid modifying shared references\n            queue.append((nx, ny, n_dir, new_path))\n            visited.add((nx, ny, n_dir))\n\n    # If the BFS completes without finding a path to collect the primitive,\n    # it means the primitive is unreachable or not present.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:37:01.178282", "function_name": "collect", "function_body": "  import collections # Using collections.deque for efficient queue operations in BFS\n  import numpy as np # Importing numpy for array operations\n\n  # Re-defining constants for clarity within the function scope\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable\n  if primitive_idx not in env.world.grabbable_indices:\n    return [] # Not grabbable, cannot collect via USE.\n\n  # 3. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 4. Retrieve grid dimensions and non-grabbable indices for boundary and impassable checks\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # Convert non_grabbable_indices set to a NumPy array once for efficient indexing\n  non_grabbable_arr = np.array(list(env.world.non_grabbable_indices))\n  \n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  \n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  # Queue for BFS: stores tuples of ((x, y), direction)\n  queue = collections.deque([(start_pos, start_dir)]) \n  \n  # Dictionary to reconstruct the path: \n  # Keys are ((x, y), direction) tuples representing a state.\n  # Values are (parent_state_tuple, action_taken_to_reach_current_state).\n  # The starting state's parent info is (None, None).\n  path_trace = {(start_pos, start_dir): (None, None)} \n\n  target_use_state = None # Will store the state from which the final USE action can be applied\n\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.popleft() # Dequeue the current state\n\n    # Check if a 'USE' action is possible from this current state.\n    # This involves looking at the cell directly in front of the agent.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # If the target cell is within bounds and contains the desired primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      # We've found a valid state from which the primitive can be collected.\n      target_use_state = ((curr_x, curr_y), curr_dir)\n      break # Path found, exit the BFS loop.\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # Moving changes both the agent's position and its facing direction.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to cardinal movements\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # The agent's new direction is the direction of movement\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position is impassable (contains any non-grabbable item).\n      # The agent cannot move into cells occupied by these items.\n      # This is the \"improved\" part, leveraging NumPy's `any` for efficiency.\n      if np.any(grid[next_x, next_y, non_grabbable_arr] > 0):\n        continue # Skip this move if the destination is impassable\n      \n      # If this new state (position and direction) has not been visited yet during the BFS\n      if next_state_tuple not in path_trace: # path_trace acts as our visited set\n        # Store how we reached this new state\n        path_trace[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action)\n        queue.append(next_state_tuple) # Add the new state to the queue for further exploration\n\n  if target_use_state is None:\n    return [] # If the queue becomes empty and no path was found, the primitive is unreachable.\n\n  # Reconstruct the sequence of actions by backtracking from the `target_use_state`\n  # back to the `start_pos`/`start_dir` using the `path_trace` dictionary.\n  path_actions = []\n  current_reconstruction_state = target_use_state\n  \n  # Backtrack until we reach the starting state, which has (None, None) as its parent info\n  while path_trace[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = path_trace[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  # The path was built in reverse order (from target to start), so reverse it\n  path_actions.reverse()\n  \n  # Add the final 'USE' action to complete the collection sequence\n  return path_actions + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
