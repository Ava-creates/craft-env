{"timestamp": "2025-07-30T16:50:20.308370", "function_name": "collect", "function_body": "    state = env._current_state\n    primitive_idx = primitive # Assuming primitive is already the integer index\n\n    actions = []\n\n    # 1. Check if primitive is already in inventory\n    if state.inventory[primitive_idx] > 0:\n        return []\n\n    # 2. Find primitive location on the grid\n    primitive_coords = np.where(state.grid[:, :, primitive_idx] > 0)\n    if len(primitive_coords[0]) == 0:\n        # Primitive not found on the current grid.\n        # In a more advanced version, this would trigger exploration (e.g., random moves).\n        return []\n    \n    # Take the first occurrence found\n    target_x, target_y = primitive_coords[0][0], primitive_coords[1][0]\n\n    # Initialize simulated agent position and direction\n    sim_x, sim_y = state.pos\n    sim_dir = state.dir # Current direction (0:N, 1:E, 2:S, 3:W)\n\n    # Determine if the primitive requires \"next-to\" interaction (e.g., water, workshops)\n    # or \"stand-on\" interaction (e.g., wood, stone).\n    # Primitives in `non_grabbable_indices` typically require \"next-to\" interaction.\n    if primitive_idx in env.world.non_grabbable_indices:\n        # Case A: Item requires \"next-to\" interaction (e.g., water)\n        # Find the closest valid adjacent cell to move to\n        adjacent_cells = [\n            (target_x - 1, target_y), (target_x + 1, target_y),\n            (target_x, target_y - 1), (target_x, target_y + 1)\n        ]\n        WIDTH, HEIGHT, _ = state.grid.shape\n        valid_adjacent_cells = [(nx, ny) for nx, ny in adjacent_cells if 0 <= nx < WIDTH and 0 <= ny < HEIGHT]\n\n        if not valid_adjacent_cells:\n            # Cannot move next to the primitive\n            return []\n\n        # Find the closest valid adjacent cell to the agent's current position\n        goal_x, goal_y = valid_adjacent_cells[0]\n        min_dist = abs(sim_x - goal_x) + abs(sim_y - goal_y)\n        for nx, ny in valid_adjacent_cells[1:]:\n            dist = abs(sim_x - nx) + abs(sim_y - ny)\n            if dist < min_dist:\n                min_dist = dist\n                goal_x, goal_y = nx, ny\n\n        # Generate movement actions to reach (goal_x, goal_y)\n        while sim_x != goal_x:\n            if sim_x < goal_x:\n                actions.append(env.action_specs()['RIGHT'])\n                sim_x += 1\n                sim_dir = 1 # Face East\n            else:\n                actions.append(env.action_specs()['LEFT'])\n                sim_x -= 1\n                sim_dir = 3 # Face West\n        while sim_y != goal_y:\n            if sim_y < goal_y:\n                actions.append(env.action_specs()['DOWN'])\n                sim_y += 1\n                sim_dir = 2 # Face South\n            else:\n                actions.append(env.action_specs()['UP'])\n                sim_y -= 1\n                sim_dir = 0 # Face North\n\n        # For \"next-to\" interaction, assume USE works on any adjacent cell regardless of facing,\n        # or that the agent's final direction from pathfinding is sufficient.\n        # A more complex agent would add explicit turning moves if the environment supports it.\n\n    else:\n        # Case B: Item can be stood on and collected (most common primitives like wood, stone)\n        # Generate movement actions to reach (target_x, target_y)\n        while sim_x != target_x:\n            if sim_x < target_x:\n                actions.append(env.action_specs()['RIGHT'])\n                sim_x += 1\n                sim_dir = 1 # Face East\n            else:\n                actions.append(env.action_specs()['LEFT'])\n                sim_x -= 1\n                sim_dir = 3 # Face West\n        while sim_y != target_y:\n            if sim_y < target_y:\n                actions.append(env.action_specs()['DOWN'])\n                sim_y += 1\n                sim_dir = 2 # Face South\n            else:\n                actions.append(env.action_specs()['UP'])\n                sim_y -= 1\n                sim_dir = 0 # Face North\n\n    # 3. Add USE action after reaching the target position (on or next to the primitive)\n    actions.append(env.action_specs()['USE'])\n\n    return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:52:02.453185", "function_name": "collect", "function_body": "    import collections\n\n    # Action constants as defined in the action_specs\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    def _find_path_actions(start_pos, target_cells, grid, non_walkable_indices):\n        \"\"\"\n        Performs a BFS to find the shortest path from start_pos to any cell in target_cells.\n        Returns a list of actions (UP, DOWN, LEFT, RIGHT) to reach the target, or None if no path.\n        \n        Args:\n            start_pos (tuple): Agent's current (x, y) position.\n            target_cells (list of tuples): List of (x, y) target positions.\n            grid (np.ndarray): The global grid (WIDTH, HEIGHT, n_kinds).\n            non_walkable_indices (set): Set of integer indices for non-grabbable items that are obstacles.\n        \n        Returns:\n            list: A list of actions representing the shortest path.\n            None: If no path is found.\n        \"\"\"\n        grid_width, grid_height, _ = grid.shape\n\n        queue = collections.deque([(start_pos, [])])  # (current_pos, path_actions)\n        visited = {start_pos}\n\n        # Map actions to (dx, dy) deltas\n        action_deltas = {\n            UP: (0, -1),\n            DOWN: (0, 1),\n            LEFT: (-1, 0),\n            RIGHT: (1, 0)\n        }\n\n        while queue:\n            (cx, cy), current_path_actions = queue.popleft()\n\n            # If current position is one of the target cells, we found the shortest path\n            if (cx, cy) in target_cells:\n                return current_path_actions\n\n            # Explore neighbors\n            for action, (dx, dy) in action_deltas.items():\n                nx, ny = cx + dx, cy + dy\n\n                # Check bounds\n                if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n                    continue\n\n                # Check if already visited\n                if (nx, ny) in visited:\n                    continue\n\n                # Check walkability: a cell is not walkable if it contains any non-grabbable item\n                is_walkable = True\n                if non_walkable_indices:\n                    for idx in non_walkable_indices:\n                        if grid[nx, ny, idx] > 0:  # If the cell contains an obstacle\n                            is_walkable = False\n                            break\n                if not is_walkable:\n                    continue\n\n                visited.add((nx, ny))\n                queue.append(((nx, ny), current_path_actions + [action]))\n\n        return None  # No path found to any target cell\n\n    all_actions = []\n    MAX_COLLECT_STEPS = 500  # Safety limit for the total number of actions\n\n    # Access the internal CraftState instance from the CraftLab environment\n    # This is a common pattern for \"expert\" or \"internal\" agent functions.\n    current_state = env.unwrapped._current_state\n\n    for _ in range(MAX_COLLECT_STEPS):\n        # Get current observations to update the agent's view of the world\n        obs = env.observations()\n        current_grid = obs['features_dict']['features_global']\n        current_inventory = obs['features_dict']['inventory']\n        \n        # Get agent's current absolute position from the internal state\n        agent_pos = current_state.pos\n\n        # Check if the primitive is already in inventory\n        if current_inventory[primitive] > 0:\n            return all_actions\n\n        # Check if the primitive is in the agent's immediate 3x3 neighborhood\n        # CraftState.next_to conveniently provides this check.\n        if current_state.next_to(primitive):\n            all_actions.append(USE)\n            reward, done, _ = env.step(USE)\n            if done:  # If the USE action completed the task (e.g., goal achieved)\n                return all_actions\n            # If not done, continue loop to re-check inventory status (could take multiple USEs for stacks)\n            continue\n\n        # If not collected and not next to, plan a path to it\n        grid_width, grid_height, _ = current_grid.shape\n\n        # Find all locations where the primitive exists on the grid\n        primitive_locations = []\n        for x in range(grid_width):\n            for y in range(grid_height):\n                if current_grid[x, y, primitive] > 0:\n                    primitive_locations.append((x, y))\n\n        if not primitive_locations:\n            # Primitive not found on the map (e.g., already collected, or not spawned)\n            return all_actions # Cannot proceed if target is not visible\n\n        # Get non-walkable indices (obstacles) from the CraftWorld configuration\n        non_walkable_indices = env.unwrapped.non_grabbable_indices\n\n        best_path_to_primitive_adj = None\n\n        # Iterate through all found primitive locations to find the closest reachable one\n        for p_x, p_y in primitive_locations:\n            # Determine 4-directional adjacent cells to the primitive\n            potential_adj_targets = [\n                (p_x + 1, p_y), (p_x - 1, p_y), (p_x, p_y + 1), (p_x, p_y - 1)\n            ]\n            \n            valid_adj_targets = []\n            for adj_x, adj_y in potential_adj_targets:\n                # Check if the adjacent cell is within grid bounds\n                if not (0 <= adj_x < grid_width and 0 <= adj_y < grid_height):\n                    continue\n                \n                # Check if the adjacent cell is walkable (does not contain any non-grabbable item)\n                is_walkable = True\n                if non_walkable_indices:\n                    for idx in non_walkable_indices:\n                        if current_grid[adj_x, adj_y, idx] > 0:\n                            is_walkable = False\n                            break\n                if is_walkable:\n                    valid_adj_targets.append((adj_x, adj_y))\n\n            if valid_adj_targets:\n                # Find the shortest path from the agent's current position to any of the valid adjacent cells\n                path_to_current_primitive_adj = _find_path_actions(\n                    agent_pos, valid_adj_targets, current_grid, non_walkable_indices\n                )\n                \n                # Update best_path_to_primitive_adj if a shorter path is found\n                if path_to_current_primitive_adj is not None:\n                    if best_path_to_primitive_adj is None or \\\n                       len(path_to_current_primitive_adj) < len(best_path_to_primitive_adj):\n                        best_path_to_primitive_adj = path_to_current_primitive_adj\n\n        if best_path_to_primitive_adj is None:\n            # No path found to any primitive instance (e.g., all unreachable or surrounded by obstacles)\n            return all_actions\n\n        # Take the first action in the calculated shortest path\n        next_action = best_path_to_primitive_adj[0]\n        all_actions.append(next_action)\n        \n        reward, done, _ = env.step(next_action)\n        if done:  # If the movement action somehow completed the task\n            return all_actions\n\n    # If MAX_COLLECT_STEPS is reached without collecting the primitive, return actions taken so far\n    return all_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:52:02.524123", "function_name": "collect", "function_body": "    actions = []\n    # Get the integer ID for the primitive item from the cookbook's index\n    primitive_idx = env.world.cookbook.index.index(primitive)\n\n    # Get action mappings once to avoid repeated calls\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    # Max steps to prevent infinite loops, especially if primitive is unreachable\n    MAX_COLLECT_ATTEMPTS = 500\n\n    for _ in range(MAX_COLLECT_ATTEMPTS):\n        obs = env.observations()\n        current_state_features = obs['features_dict']\n        current_inventory = current_state_features['inventory']\n\n        # 1. Check if the primitive is already collected\n        if current_inventory[primitive_idx] > 0:\n            return actions\n\n        # Get grid dimensions and current agent position\n        grid = current_state_features['features_global'] # Shape (WIDTH, HEIGHT, n_kinds)\n        grid_width, grid_height, _ = grid.shape # x-dimension (cols), y-dimension (rows)\n\n        # Agent position: `features_dict['pos']` is a normalized array.\n        # Assuming it's `[normalized_row, normalized_col]` for consistency with `(row, col)`\n        # If the grid is indexed `[x_idx, y_idx]`, then agent's `x` is col, `y` is row.\n        normalized_agent_pos = current_state_features['pos']\n        agent_row = int(normalized_agent_pos[0] * grid_height) # Y-coordinate\n        agent_col = int(normalized_agent_pos[1] * grid_width)  # X-coordinate\n\n        target_row, target_col = None, None\n        min_dist = float('inf')\n\n        # 2. Search for the primitive on the global grid\n        # Grid is `(WIDTH, HEIGHT, n_kinds)`, implying `grid[x_idx, y_idx, kind]`.\n        # So when iterating, `x_idx` is column, `y_idx` is row.\n        for x_idx in range(grid_width):\n            for y_idx in range(grid_height):\n                if grid[x_idx, y_idx, primitive_idx] > 0:\n                    # Found primitive at (x_idx, y_idx).\n                    # Calculate Manhattan distance from agent (agent_row, agent_col)\n                    # to primitive (y_idx, x_idx) (row, col)\n                    dist = abs(y_idx - agent_row) + abs(x_idx - agent_col)\n                    if dist < min_dist:\n                        min_dist = dist\n                        target_row, target_col = y_idx, x_idx # Store as (row, col)\n\n        if target_row is None:\n            # Primitive not found on the visible grid.\n            # Implement a simple exploration strategy (e.g., random walk)\n            # if the item is not immediately visible.\n            possible_moves = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]\n            action = np.random.choice(possible_moves)\n            actions.append(action)\n            env.step(action) # Take the action in the environment\n            continue # Re-evaluate state after moving\n\n        # 3. Determine if the primitive is grabbable\n        is_grabbable = primitive_idx in env.world.grabbable_indices\n\n        # 4. Check if adjacent to target (3x3 neighborhood, excluding self)\n        is_adjacent = (abs(target_row - agent_row) <= 1 and\n                       abs(target_col - agent_col) <= 1 and\n                       (target_row != agent_row or target_col != agent_col))\n\n        # 5. Take action: USE if adjacent and grabbable, else move towards target\n        if is_adjacent and is_grabbable:\n            action = ACTION_USE\n            actions.append(action)\n            env.step(action)\n            continue # Re-evaluate state after attempting to collect\n\n        # If agent is on the target cell, and it's grabbable, try to USE as well.\n        # (This handles cases where USE might work from the same square)\n        elif (agent_row == target_row and agent_col == target_col) and is_grabbable:\n            action = ACTION_USE\n            actions.append(action)\n            env.step(action)\n            continue\n\n        else:\n            # Move towards the target. Prioritize movement in one dimension.\n            action_to_take = None\n            if target_row > agent_row:\n                action_to_take = ACTION_DOWN\n            elif target_row < agent_row:\n                action_to_take = ACTION_UP\n            elif target_col > agent_col:\n                action_to_take = ACTION_RIGHT\n            elif target_col < agent_col:\n                action_to_take = ACTION_LEFT\n\n            if action_to_take is not None:\n                actions.append(action_to_take)\n                env.step(action_to_take)\n            else:\n                # Agent is at the target cell (agent_row == target_row and agent_col == target_col)\n                # but it's not collected, and not handled by the USE logic above.\n                # This suggests the item is not collectible by simple means (move/use)\n                # or is not a grabbable primitive in this context.\n                # For `v2`, this signifies an uncollectible state for this primitive.\n                return [] # Indicate failure to collect\n\n    return actions # Max attempts reached, primitive not collected", "island_id": 3, "scores": {"3": -1}}
