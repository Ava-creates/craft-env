{"timestamp": "2025-07-30T22:47:37.311060", "function_name": "collect", "function_body": "  import collections\n\n  # Define actions and directions\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Mapping from movement action to its (dx, dy) delta and the resulting agent direction.\n  # This assumes that performing a cardinal movement action (UP, DOWN, LEFT, RIGHT)\n  # also sets the agent's facing direction to that cardinal direction.\n  ACTION_TO_MOVE_AND_DIR = {\n      UP_ACTION: ((0, -1), NORTH_DIR),\n      DOWN_ACTION: ((0, 1), SOUTH_DIR),\n      LEFT_ACTION: ((-1, 0), WEST_DIR),\n      RIGHT_ACTION: ((1, 0), EAST_DIR),\n  }\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"Calculates the direction the agent needs to face from its (agent_x, agent_y)\n    to look directly at the item at (item_x, item_y). Assumes they are cardinally adjacent.\n    \"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dx == 0 and dy == 1: return SOUTH_DIR\n    if dx == 0 and dy == -1: return NORTH_DIR\n    return None # Should not happen for directly adjacent items\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir # Initial direction of the agent\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_walkable(x, y):\n    \"\"\"Checks if a cell is within grid bounds and traversable (does not contain non-grabbable items).\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item (obstacle) is at (x, y)\n    for k_idx in non_grabbable_indices:\n      if grid[y, x, k_idx] == 1: # Grid is typically (HEIGHT, WIDTH, KINDS)\n        return False\n    return True\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n  if len(x_coords) == 0:\n    return [] # Primitive not found anywhere on the grid\n\n  # Define BFS goal states: (agent_x, agent_y, agent_dir) from which the USE_ACTION can collect the primitive.\n  # A goal state means the agent is adjacent to the primitive and facing it.\n  bfs_goal_states = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Iterate over all 4 cardinal adjacent cells where the agent could stand\n    for dx_from_item, dy_from_item in [(-1, 0), (1, 0), (0, -1), (0, 1)]: \n      adj_x, adj_y = item_x + dx_from_item, item_y + dy_from_item\n\n      if is_walkable(adj_x, adj_y):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_goal_states.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_goal_states:\n    return [] # No traversable adjacent positions that allow facing any primitive instance\n\n  # BFS Initialization\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken_to_reach_here)\n  queue = collections.deque([(start_x, start_y, start_dir, [])]) \n  # Visited set: (x, y, dir) to avoid cycles and redundant exploration\n  visited = {(start_x, start_y, start_dir)}\n  \n  shortest_path_actions = None\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_so_far = queue.popleft()\n\n    # Check if the current state (position and direction) is one of the goal states\n    if (curr_x, curr_y, curr_dir) in bfs_goal_states:\n      shortest_path_actions = path_so_far\n      break # Found the shortest path to a suitable collection point\n\n    # Explore possible next states by applying actions:\n\n    # 1. Cardinal Movement Actions (UP, DOWN, LEFT, RIGHT)\n    # These actions move the agent to an adjacent cell and set its direction\n    # to the cardinal direction of movement.\n    for action in [UP_ACTION, DOWN_ACTION, LEFT_ACTION, RIGHT_ACTION]:\n      (dx, dy), new_dir_from_action = ACTION_TO_MOVE_AND_DIR[action]\n      \n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = new_dir_from_action \n\n      if is_walkable(next_x, next_y):\n        state_tuple = (next_x, next_y, next_dir)\n        if state_tuple not in visited:\n          visited.add(state_tuple)\n          queue.append((next_x, next_y, next_dir, path_so_far + [action]))\n\n    # 2. In-Place Turning Actions (LEFT, RIGHT)\n    # This section handles the case where LEFT_ACTION and RIGHT_ACTION can also be used\n    # to change the agent's facing direction without changing its position.\n    # This aligns with the more comprehensive action model often seen in grid worlds,\n    # and addresses a potential limitation if movement actions are the only way to turn.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]: \n      next_x, next_y = curr_x, curr_y # Position does not change for a pure turn\n      \n      # Calculate new direction based on the turn action\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4 # Turn clockwise\n      \n      state_tuple = (next_x, next_y, next_dir)\n      # No traversability check needed as position doesn't change\n      if state_tuple not in visited: \n        visited.add(state_tuple)\n        queue.append((next_x, next_y, next_dir, path_so_far + [turn_action]))\n\n  if shortest_path_actions is None:\n    return [] # No path found to any primitive's collection point\n\n  # The agent has reached a state (position and direction) from which it can use the primitive.\n  # Append the USE_ACTION as the final step.\n  final_actions = list(shortest_path_actions) # Create a mutable copy\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T22:47:38.268946", "function_name": "collect", "function_body": "  import collections\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dx == 0 and dy == 1: return SOUTH_DIR\n    if dx == 0 and dy == -1: return NORTH_DIR\n    return None # Should not happen for directly adjacent items\n\n  # Helper function: Checks if a cell is traversable (no non-grabbable items)\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item (obstacle) is at (x, y)\n    for k_idx in non_grabbable_indices:\n      if grid[y, x, k_idx] == 1: # Grid is typically (HEIGHT, WIDTH, KINDS)\n        return False\n    return True\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Optimization: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir # Initial direction of the agent\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n  if len(x_coords) == 0:\n    return [] # Primitive not found anywhere on the grid\n\n  # Define BFS goal states: (agent_x, agent_y, agent_dir) from which the USE_ACTION can collect the primitive.\n  # A goal state means the agent is adjacent to the primitive and facing it.\n  bfs_goal_states = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Iterate over all 4 cardinal adjacent cells where the agent could stand\n    # (dx_from_item, dy_from_item) represents the vector from the item's position to the agent's potential position\n    for dx_from_item, dy_from_item in [(-1, 0), (1, 0), (0, -1), (0, 1)]: \n      adj_x, adj_y = item_x + dx_from_item, item_y + dy_from_item\n\n      if is_walkable(adj_x, adj_y):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_goal_states.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_goal_states:\n    return [] # No traversable adjacent positions that allow facing any primitive instance\n\n  # BFS Initialization\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken_to_reach_here)\n  queue = collections.deque([(start_x, start_y, start_dir, [])]) \n  # Visited set: (x, y, dir) to avoid cycles and redundant exploration\n  visited = {(start_x, start_y, start_dir)}\n  \n  shortest_path_actions = None\n\n  # Define movement deltas and resulting directions for cardinal moves\n  # This map assumes moving in a direction also makes the agent face that direction.\n  CARDINAL_MOVES = {\n      UP_ACTION: ((0, -1), NORTH_DIR),\n      DOWN_ACTION: ((0, 1), SOUTH_DIR),\n      LEFT_ACTION: ((-1, 0), WEST_DIR),\n      RIGHT_ACTION: ((1, 0), EAST_DIR),\n  }\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_so_far = queue.popleft()\n\n    # Check if the current state (position and direction) is one of the goal states\n    if (curr_x, curr_y, curr_dir) in bfs_goal_states:\n      shortest_path_actions = path_so_far\n      break # Found the shortest path to a suitable collection point\n\n    # --- Explore movement actions (which also set facing direction) ---\n    for action, ((dx, dy), new_dir_from_move) in CARDINAL_MOVES.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = new_dir_from_move # Agent's direction changes to match the cardinal move\n\n      if is_walkable(next_x, next_y):\n        state_tuple = (next_x, next_y, next_dir)\n        if state_tuple not in visited:\n          visited.add(state_tuple)\n          queue.append((next_x, next_y, next_dir, path_so_far + [action]))\n          \n    # --- Explore in-place turning actions ---\n    # As per `collect_v0`'s logic, we assume LEFT_ACTION and RIGHT_ACTION can also be pure turns.\n    # This means the agent stays at (curr_x, curr_y) but changes its direction.\n    \n    # Turn Left (counter-clockwise)\n    next_turn_left_dir = (curr_dir - 1 + 4) % 4\n    state_after_left_turn = (curr_x, curr_y, next_turn_left_dir)\n    if state_after_left_turn not in visited:\n      visited.add(state_after_left_turn)\n      queue.append((curr_x, curr_y, next_turn_left_dir, path_so_far + [LEFT_ACTION])) # Using LEFT_ACTION for pure turn\n\n    # Turn Right (clockwise)\n    next_turn_right_dir = (curr_dir + 1) % 4\n    state_after_right_turn = (curr_x, curr_y, next_turn_right_dir)\n    if state_after_right_turn not in visited:\n      visited.add(state_after_right_turn)\n      queue.append((curr_x, curr_y, next_turn_right_dir, path_so_far + [RIGHT_ACTION])) # Using RIGHT_ACTION for pure turn\n\n  if shortest_path_actions is None:\n    return [] # No path found to any primitive's collection point\n\n  # The agent has reached a state (position and direction) from which it can use the primitive.\n  # Append the USE_ACTION as the final step.\n  final_actions = list(shortest_path_actions) # Create a mutable copy\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:48:52.245778", "function_name": "collect", "function_body": "    actions = []\n    max_steps_limit = 200  # Prevent excessively long action sequences\n\n    # Get action mapping from the environment\n    action_map = env.action_specs()\n    _DOWN = action_map['DOWN']\n    _UP = action_map['UP']\n    _LEFT = action_map['LEFT']\n    _RIGHT = action_map['RIGHT']\n    _USE = action_map['USE']\n\n    # Get the initial state (env.observations() implicitly updates env._current_state)\n    _ = env.observations()\n    current_state = env._current_state\n\n    # Loop until the primitive is collected or a maximum number of steps is reached\n    while current_state.inventory[primitive] == 0 and len(actions) < max_steps_limit:\n        action_to_perform = None\n\n        # Check if the agent is next to the primitive\n        if current_state.next_to(primitive):\n            # If next to, perform the USE action to collect it\n            action_to_perform = _USE\n        else:\n            # If not next to, find the closest primitive on the grid\n            primitive_locations = np.argwhere(current_state.grid[:, :, primitive] == 1)\n\n            if len(primitive_locations) == 0:\n                # Primitive not found on the grid (e.g., already collected, or not present)\n                break  # Cannot collect, exit loop\n\n            agent_x, agent_y = current_state.pos\n            closest_loc = None\n            min_dist = float('inf')\n\n            # Find the primitive location with the smallest Manhattan distance\n            for loc_x, loc_y in primitive_locations:\n                dist = abs(loc_x - agent_x) + abs(loc_y - agent_y)\n                if dist < min_dist:\n                    min_dist = dist\n                    closest_loc = (loc_x, loc_y)\n\n            if closest_loc is None:\n                # Should not happen if primitive_locations was not empty, but as a safeguard\n                break\n\n            target_x, target_y = closest_loc\n\n            # Determine the movement action to get closer to the target\n            dx = target_x - agent_x\n            dy = target_y - agent_y\n\n            # Prioritize movement along the axis with the larger difference\n            if abs(dx) > abs(dy):\n                if dx > 0:\n                    action_to_perform = _RIGHT\n                else:  # dx < 0\n                    action_to_perform = _LEFT\n            else:  # abs(dy) >= abs(dx)\n                if dy > 0:\n                    action_to_perform = _DOWN\n                else:  # dy < 0\n                    action_to_perform = _UP\n\n            # If agent is at target (dx=0, dy=0) but not 'next_to', something is wrong\n            # This implies the item might not be collectable by 'USE' when adjacent/on-cell,\n            # or 'next_to' implementation doesn't cover this. In this case, we break.\n            if action_to_perform is None and dx == 0 and dy == 0:\n                break\n\n        # If an action was determined, execute it\n        if action_to_perform is None:\n            # No action could be determined (e.g., target unreachable, or already at target and cannot collect)\n            break\n\n        actions.append(action_to_perform)\n        \n        # Step the environment with the chosen action\n        reward, done, obs = env.step(action_to_perform)\n        current_state = env._current_state  # Update the current state\n\n        # If the environment signals done (e.g., max episode steps reached, or goal completed externally)\n        if done:\n            break\n\n    return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:48:52.323402", "function_name": "collect", "function_body": "    initial_state = env._current_state\n\n    # Queue for BFS: stores (CraftState, list_of_actions_to_reach_this_state)\n    q = collections.deque([(initial_state, [])])\n\n    # Set to keep track of visited states to avoid cycles and redundant explorations.\n    # A state is defined by (agent_position, agent_direction, inventory_contents).\n    # Inventory (numpy array) must be converted to a hashable tuple.\n    visited = set([(initial_state.pos, initial_state.dir, tuple(initial_state.inventory.tolist()))])\n\n    # Maximum path length to prevent excessively long searches for unfeasible goals\n    # or in very large environments. Adjust as needed for specific problem scale.\n    MAX_PATH_LENGTH = 500 \n\n    while q:\n        current_state, current_actions = q.popleft()\n\n        # Pruning: if the path is too long, stop exploring this branch\n        if len(current_actions) >= MAX_PATH_LENGTH:\n            continue\n\n        # Check if the primitive is already in the agent's inventory\n        if current_state.inventory[primitive] > 0:\n            return current_actions\n\n        # If not yet collected, check if the primitive is next to the agent\n        # and attempt to use/collect it.\n        if current_state.next_to(primitive):\n            # Simulate the 'USE' action\n            # The .step() method returns (reward, new_CraftState)\n            _reward, next_state_after_use = current_state.step(4) # 4 is the USE action\n            next_actions_after_use = current_actions + [4] # Add USE action to the path\n\n            # After trying to USE, check if the primitive is now in inventory\n            if next_state_after_use.inventory[primitive] > 0:\n                return next_actions_after_use\n            \n            # If USE did not result in collection (e.g., it was not a grabbable primitive,\n            # which shouldn't happen for a \"primitive\" in this context),\n            # we don't queue this state for further exploration.\n            # We assume a 'primitive' is always collectable via USE if next_to.\n\n        # Explore possible movement actions (DOWN, UP, LEFT, RIGHT)\n        for action in [0, 1, 2, 3]: # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n            _reward, next_state = current_state.step(action)\n            next_actions = current_actions + [action]\n\n            # Create a hashable key for the next state to check against visited set\n            state_key = (next_state.pos, next_state.dir, tuple(next_state.inventory.tolist()))\n\n            # If this state has not been visited before, add it to the queue and visited set\n            if state_key not in visited:\n                visited.add(state_key)\n                q.append((next_state, next_actions))\n    \n    # If the queue is exhausted and no path to collect the primitive was found within the limits\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:50:30.714607", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (assuming these are defined/imported from env_factory as per problem context)\n  # DOWN = 0\n  # UP = 1\n  # LEFT = 2\n  # RIGHT = 3\n  # USE = 4\n\n  # Direction constants (assuming these are defined/imported from env_factory as per problem context)\n  # NORTH = 0\n  # EAST = 1\n  # SOUTH = 2\n  # WEST = 3\n\n  # Mapping for movement actions: (dx, dy, new_direction)\n  # dx, dy relative to agent's position in (x, y) coordinates\n  # new_direction is the cardinal direction the agent faces after the move\n  _MOVE_ACTION_DETAILS = {\n      env_factory.UP: (0, -1, env_factory.NORTH),\n      env_factory.DOWN: (0, 1, env_factory.SOUTH),\n      env_factory.LEFT: (-1, 0, env_factory.WEST),\n      env_factory.RIGHT: (1, 0, env_factory.EAST),\n  }\n\n  # Mapping relative position (dx, dy) to required cardinal direction for agent to face that cell\n  _RELATIVE_TO_DIRECTION = {\n      (0, -1): env_factory.NORTH, # Target is above\n      (0, 1): env_factory.SOUTH,  # Target is below\n      (-1, 0): env_factory.WEST,  # Target is left\n      (1, 0): env_factory.EAST,   # Target is right\n  }\n\n  initial_state = env._current_state\n  start_pos_xy = initial_state.pos  # (x, y) coordinates for agent's position\n  start_dir = initial_state.dir      # int (0=N, 1=E, 2=S, 3=W)\n  grid_data = initial_state.grid     # numpy.ndarray of shape (HEIGHT, WIDTH, n_kinds)\n\n  HEIGHT, WIDTH, _ = grid_data.shape\n\n  # Find the location of the primitive on the grid\n  # np.argwhere returns (row, col) indices where the condition is true\n  primitive_locations_yx = np.argwhere(grid_data[:, :, primitive] == 1)\n\n  if len(primitive_locations_yx) == 0:\n      return []  # Primitive not found on the grid\n\n  # We only need to collect one instance, so pick the first found primitive\n  # Convert (row, col) from np.argwhere to (x, y)\n  primitive_pos_xy = (primitive_locations_yx[0][1], primitive_locations_yx[0][0])\n\n  # Helper function to check if a position is within grid boundaries\n  def is_valid_grid_pos(pos):\n      x, y = pos\n      return 0 <= x < WIDTH and 0 <= y < HEIGHT\n\n  # BFS state: (current_x, current_y, current_direction_facing)\n  # Queue stores: ((state_tuple), [list_of_actions_taken_to_reach_this_state])\n  queue = collections.deque([((start_pos_xy[0], start_pos_xy[1], start_dir), [])])\n  \n  # Visited set to prevent cycles and redundant exploration\n  # Stores (x, y, direction) tuples\n  visited = {(start_pos_xy[0], start_pos_xy[1], start_dir)}\n\n  while queue:\n      (curr_x, curr_y, curr_dir), actions_list = queue.popleft()\n\n      # Check if the current state is a goal state:\n      # 1. Agent is adjacent to the primitive\n      # 2. Agent is facing the primitive\n      dx_to_prim = primitive_pos_xy[0] - curr_x\n      dy_to_prim = primitive_pos_xy[1] - curr_y\n\n      # Check for adjacency (Manhattan distance of 1)\n      if abs(dx_to_prim) + abs(dy_to_prim) == 1:\n          # Determine the cardinal direction required for the agent to face the primitive\n          required_dir_to_face_prim = _RELATIVE_TO_DIRECTION.get((dx_to_prim, dy_to_prim))\n          \n          # If the agent's current direction matches the required direction\n          if required_dir_to_face_prim is not None and curr_dir == required_dir_to_face_prim:\n              # Goal achieved! Append the 'USE' action and return the path.\n              return actions_list + [env_factory.USE]\n\n      # Explore possible moves from the current state\n      for action_type, (move_dx, move_dy, new_dir_after_move) in _MOVE_ACTION_DETAILS.items():\n          next_x, next_y = curr_x + move_dx, curr_y + move_dy\n          next_state_key = (next_x, next_y, new_dir_after_move)\n\n          # Check if the next position is valid and if this (pos, dir) state hasn't been visited\n          if is_valid_grid_pos((next_x, next_y)) and next_state_key not in visited:\n              visited.add(next_state_key)\n              queue.append((next_state_key, actions_list + [action_type]))\n\n  return [] # No path to the primitive was found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:50:30.783783", "function_name": "collect", "function_body": "    from collections import deque\n\n    # numpy is already imported globally as np.\n    # env_factory is assumed to be available from the global scope based on context.\n\n    actions = []\n    # Resetting the environment to a fresh state for a new collection attempt.\n    # A seed is used for determinism, which is good practice for reproducibility.\n    obs = env.reset(seed=0)\n    current_state_info = obs['features_dict']\n    \n    # Agent's current position (row, col). CraftState.pos is specified as tuple(int, int).\n    agent_row, agent_col = int(current_state_info['pos'][0]), int(current_state_info['pos'][1])\n    \n    # Global grid view (height, width, n_kinds).\n    grid = current_state_info['features_global']\n    GRID_HEIGHT, GRID_WIDTH, _ = grid.shape\n\n    # Find all occurrences of the primitive on the grid.\n    # np.argwhere returns (row, col) coordinates where the condition is true.\n    primitive_positions = np.argwhere(grid[:, :, primitive] > 0)\n    \n    if len(primitive_positions) == 0:\n        # The primitive is not found on the map, so it cannot be collected.\n        return []\n\n    # For simplicity, we target the first found primitive. In a more complex scenario,\n    # one might choose the closest primitive based on pathfinding cost.\n    target_row, target_col = primitive_positions[0]\n\n    # --- BFS Pathfinding to an Adjacent Cell ---\n    \n    # Define movement actions and their corresponding (row_delta, col_delta).\n    # These action constants are assumed to be defined within `env_factory.actions`.\n    action_to_delta = {\n        env_factory.actions.UP: (-1, 0),\n        env_factory.actions.DOWN: (1, 0),\n        env_factory.actions.LEFT: (0, -1),\n        env_factory.actions.RIGHT: (0, 1),\n    }\n\n    # Identify all valid cells directly adjacent (4-directionally) to the target primitive.\n    # The BFS will search for a path to *any* of these cells.\n    target_adjacent_cells = set()\n    for dr_adj, dc_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Check 4-directional adjacency\n        adj_r, adj_c = target_row + dr_adj, target_col + dc_adj\n        \n        # Check if the potential adjacent cell is within grid bounds.\n        if 0 <= adj_r < GRID_HEIGHT and 0 <= adj_c < GRID_WIDTH:\n            # Crucial: Ensure we don't plan to step *onto* the primitive's exact square.\n            # The goal is to be *next to* it, not occupying its space.\n            if (adj_r, adj_c) != (target_row, target_col):\n                # For this problem, we assume cells are walkable unless out of bounds.\n                # A more robust solution would check for blocking non-grabbable entities.\n                target_adjacent_cells.add((adj_r, adj_c))\n\n    # Initialize BFS queue: (current_row, current_col, list_of_actions_to_reach_here).\n    queue = deque([(agent_row, agent_col, [])])\n    # Keep track of visited cells to avoid cycles and redundant paths in the search.\n    visited = set([(agent_row, agent_col)])\n\n    path_to_primitive_adjacent = []\n    path_found = False\n\n    while queue and not path_found:\n        r, c, current_path = queue.popleft()\n\n        # Check if the current cell is one of the target adjacent cells.\n        if (r, c) in target_adjacent_cells:\n            path_to_primitive_adjacent = current_path\n            path_found = True\n            break # Path to an adjacent cell found!\n\n        # Explore neighbors (possible moves from current cell).\n        for action_val, (dr, dc) in action_to_delta.items():\n            next_r, next_c = r + dr, c + dc\n\n            # Check if the neighbor is within grid bounds and has not been visited yet.\n            if (0 <= next_r < GRID_HEIGHT and 0 <= next_c < GRID_WIDTH and\n                    (next_r, next_c) not in visited):\n                \n                # Further check: Do not plan to move onto the primitive's square itself.\n                # This reinforces that we want to stop adjacent.\n                if (next_r, next_c) == (target_row, target_col):\n                    continue \n\n                visited.add((next_r, next_c))\n                # Add the neighbor to the queue with the updated path.\n                queue.append((next_r, next_c, current_path + [action_val]))\n\n    if not path_found:\n        # If no path could be found to any cell adjacent to the primitive.\n        return []\n\n    # Add the sequence of movement actions to the overall list.\n    actions.extend(path_to_primitive_adjacent)\n\n    # After moving to an adjacent position, perform the USE action to pick up the item.\n    actions.append(env_factory.actions.USE)\n\n    return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:51:33.294021", "function_name": "collect", "function_body": "    ACTIONS = env.action_specs()\n    \n    MOVE_ACTIONS = [ACTIONS[\"DOWN\"], ACTIONS[\"UP\"], ACTIONS[\"LEFT\"], ACTIONS[\"RIGHT\"]]\n    USE_ACTION = ACTIONS[\"USE\"]\n\n    initial_state = env._current_state\n\n    # 1. Check if primitive is already collected\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    # BFS Initialization\n    # Queue stores (CraftState object, list of actions taken to reach this state)\n    q = [(initial_state, [])]\n    \n    # Visited set stores a simplified hashable representation of a state:\n    # (agent_position, agent_direction, tuple_of_inventory_counts)\n    # The grid state itself is not included in the visited key for performance\n    # and simplicity, assuming it remains static until a USE action on the target primitive.\n    visited = set()\n    visited.add((initial_state.pos, initial_state.dir, tuple(initial_state.inventory.tolist())))\n\n    max_path_length = 500 # Max number of actions to search for a path\n\n    head = 0 # Manual queue pointer for list-based queue (mimics deque.popleft())\n    while head < len(q) and len(q[head][1]) < max_path_length:\n        current_state, path_actions = q[head]\n        head += 1\n\n        # Check if we are next to the primitive\n        if current_state.next_to(primitive):\n            # Simulate the USE action\n            # CraftState.step returns a new state object, which is suitable for BFS exploration.\n            _reward, state_after_use = current_state.step(USE_ACTION)\n            \n            # If the primitive is now in the inventory, we found a successful path\n            if state_after_use.inventory[primitive] > 0:\n                return path_actions + [USE_ACTION]\n            # IMPORTANT: If USE did not yield the primitive (e.g., wrong tool, exhausted resource,\n            # or not a directly grabbable item), we do NOT add `state_after_use` to the queue\n            # for further *movement* exploration. This function assumes `USE` is the final step\n            # for direct collection. Further movement after a failed `USE` is not within scope.\n\n        # Explore possible next states via movement actions (UP, DOWN, LEFT, RIGHT)\n        for action in MOVE_ACTIONS:\n            _reward, next_state = current_state.step(action)\n            next_state_repr = (next_state.pos, next_state.dir, tuple(next_state.inventory.tolist()))\n\n            if next_state_repr not in visited:\n                visited.add(next_state_repr)\n                q.append((next_state, path_actions + [action]))\n\n    # If no path is found within the maximum search depth\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:51:33.364551", "function_name": "collect", "function_body": "    obs = env.observations()\n    current_grid = obs['features_dict']['features_global']\n    current_pos = tuple(obs['features_dict']['pos']) # Ensure it's a tuple for hashing\n\n    WIDTH, HEIGHT, N_KINDS = current_grid.shape\n\n    action_specs = env.action_specs()\n    DOWN_ACTION = action_specs['DOWN']\n    UP_ACTION = action_specs['UP']\n    LEFT_ACTION = action_specs['LEFT']\n    RIGHT_ACTION = action_specs['RIGHT']\n    USE_ACTION = action_specs['USE']\n\n    move_deltas = {\n        UP_ACTION: (0, -1),  # (dx, dy) for (x, y) coordinates\n        DOWN_ACTION: (0, 1),\n        LEFT_ACTION: (-1, 0),\n        RIGHT_ACTION: (1, 0)\n    }\n\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if current_grid[x, y, primitive] == 1:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return []\n\n    # Get non-grabbable (blocking) indices from the world's cookbook\n    blocking_kinds = env.world.cookbook.environment\n\n    queue = collections.deque([(current_pos, [])]) # (position, list_of_actions_to_reach_here)\n    visited = {current_pos}\n\n    while queue:\n        curr_pos, path = queue.popleft()\n        cx, cy = curr_pos\n\n        # Check if current position is \"adjacent enough\" to any primitive location\n        # \"Adjacent enough\" means within a 3x3 neighborhood, matching CraftState.next_to\n        is_adjacent_to_primitive = False\n        for px, py in primitive_locations:\n            if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n                is_adjacent_to_primitive = True\n                break\n        \n        if is_adjacent_to_primitive:\n            return path + [USE_ACTION] # Path found, add USE action and return\n\n        # Explore neighbors\n        for action, (dx, dy) in move_deltas.items():\n            nx, ny = cx + dx, cy + dy\n            new_pos = (nx, ny)\n\n            # Check bounds\n            if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n                continue\n\n            # Check traversability: if the new cell contains a blocking kind\n            is_blocked = False\n            for k_idx in blocking_kinds:\n                if current_grid[nx, ny, k_idx] == 1:\n                    is_blocked = True\n                    break\n            \n            if is_blocked:\n                continue\n\n            # If not visited, add to queue\n            if new_pos not in visited:\n                visited.add(new_pos)\n                queue.append((new_pos, path + [action]))\n\n    # If the queue becomes empty and no path was found\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:53:10.510316", "function_name": "collect", "function_body": "    state = env._current_state\n    grid = state.grid\n    inventory = state.inventory\n    world = state.world\n    cookbook = world.cookbook\n\n    # 1. Check if primitive already collected\n    if inventory[primitive] > 0:\n        return []\n\n    # 2. Basic check: Is this a \"primitive resource\" that can be picked up directly?\n    # If it's not in the cookbook's set of primitives, this function might not be applicable.\n    if primitive not in cookbook.primitives:\n        return [] \n\n    grid_w, grid_h, _ = grid.shape\n\n    # 3. Identify all target (agent_pos, agent_dir) states from which the primitive can be collected.\n    # A state (px, py, pd) is a target if:\n    # a) (px, py) is adjacent to a cell (tx, ty) containing the primitive.\n    # b) pd (agent's direction) is facing (tx, ty).\n    \n    collection_targets = set() # Stores (pos_x, pos_y, facing_dir)\n    primitive_locations = []\n\n    # First, find all locations on the grid where the primitive exists\n    for tx in range(grid_w):\n        for ty in range(grid_h):\n            if grid[tx, ty, primitive] == 1:\n                primitive_locations.append((tx, ty))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the grid\n\n    # Then, for each primitive location, identify adjacent collection spots and required facing directions\n    # These vectors define the 4 orthogonal neighbors (relative from agent to target primitive)\n    # They correspond to North, East, South, West directions.\n    NEIGHBOR_VECS = [(0, -1), (1, 0), (0, 1), (-1, 0)] \n    \n    for tx, ty in primitive_locations:\n        for dx_rel_to_target, dy_rel_to_target in NEIGHBOR_VECS:\n            # Calculate the agent's position (px, py) if it were adjacent to (tx, ty)\n            # px, py are the coordinates of the cell *next to* the primitive, from which the agent can pick it up.\n            px = tx - dx_rel_to_target\n            py = ty - dy_rel_to_target\n\n            # Check if this potential agent position is within grid boundaries\n            if not (0 <= px < grid_w and 0 <= py < grid_h):\n                continue\n            \n            # The vector from the agent's position (px, py) to the primitive's position (tx, ty)\n            # is (dx_rel_to_target, dy_rel_to_target). This is the direction the agent must be FACING.\n            required_face_vec = (dx_rel_to_target, dy_rel_to_target)\n            \n            # Get the integer direction ID from the vector (e.g., (0, -1) -> 0 for North)\n            # VEC_TO_DIR should contain mappings for these standard orthogonal vectors.\n            if required_face_vec in env_factory.constants.VEC_TO_DIR:\n                required_face_dir = env_factory.constants.VEC_TO_DIR[required_face_vec]\n                collection_targets.add((px, py, required_face_dir))\n\n    if not collection_targets: \n        # This can happen if primitives exist but all adjacent squares are invalid (e.g., walls).\n        return []\n\n    # 4. BFS (Breadth-First Search) to find the shortest path to any collection_target\n    q = collections.deque()\n    visited = set() # Stores (pos_x, pos_y, dir) to prevent cycles and redundant paths\n\n    # Initial state of the agent\n    start_pos_x, start_pos_y = state.pos\n    start_dir = state.dir\n    initial_path = []\n\n    q.append((start_pos_x, start_pos_y, start_dir, initial_path))\n    visited.add((start_pos_x, start_pos_y, start_dir))\n\n    while q:\n        cx, cy, cd, path = q.popleft() # Current position, current direction, path taken to reach here\n\n        # Check if the current (position, direction) state is one of our collection targets\n        if (cx, cy, cd) in collection_targets:\n            # If yes, append the USE action and return the complete path\n            return path + [env_factory.constants.ACTIONS.USE] \n\n        # Explore valid movement actions from the current state\n        for action_move in [env_factory.constants.ACTIONS.UP, \n                            env_factory.constants.ACTIONS.DOWN, \n                            env_factory.constants.ACTIONS.LEFT, \n                            env_factory.constants.ACTIONS.RIGHT]:\n            \n            # Get the change in coordinates for this movement action\n            mdx, mdy = env_factory.constants.ACTION_TO_VEC[action_move]\n            nx, ny = cx + mdx, cy + mdy # New position\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= nx < grid_w and 0 <= ny < grid_h):\n                continue\n\n            # The agent's new direction (nd) is assumed to be the direction of movement\n            nd = env_factory.constants.VEC_TO_DIR[(mdx, mdy)]\n\n            # If this new state (position, direction) has not been visited yet\n            if (nx, ny, nd) not in visited:\n                visited.add((nx, ny, nd))\n                q.append((nx, ny, nd, path + [action_move]))\n\n    return [] # If the queue becomes empty and no path to a collection state was found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:53:10.580389", "function_name": "collect", "function_body": "    # Constants for actions (from CraftLab.action_specs)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Delta for movement (dy, dx) based on action\n    # Assuming UP moves to (y-1, x), DOWN to (y+1, x), etc.\n    ACTION_TO_DELTA = {\n        UP: (-1, 0),\n        DOWN: (1, 0),\n        LEFT: (0, -1),\n        RIGHT: (0, 1),\n    }\n\n    initial_state = env._current_state # Get the current CraftState\n\n    grid = initial_state.grid\n    initial_pos = initial_state.pos\n    grid_height, grid_width, _ = grid.shape\n\n    # 1. Find all locations on the grid where the primitive exists\n    primitive_locations = []\n    for y in range(grid_height):\n        for x in range(grid_width):\n            # Check if the primitive kind exists at this cell\n            if grid[y, x, primitive] > 0:\n                primitive_locations.append((y, x))\n\n    if not primitive_locations:\n        # If the primitive is not found on the grid, no actions can be taken to collect it from there.\n        return []\n\n    # 2. Use Breadth-First Search (BFS) to find the shortest path to any primitive location\n    # BFS queue stores tuples: (current_y, current_x, list_of_actions_taken_to_reach_here)\n    # collections.deque is assumed to be available globally due to common Python environment setup.\n    q = __import__('collections').deque()\n    q.append((initial_pos[0], initial_pos[1], []))\n\n    # Keep track of visited positions to avoid cycles and redundant paths\n    visited = set()\n    visited.add((initial_pos[0], initial_pos[1]))\n\n    while q:\n        curr_y, curr_x, path = q.popleft()\n\n        # Check if the current position contains the primitive\n        # Based on CraftState.step and CraftState.next_to, USE works when agent is on or adjacent to item.\n        # If agent is on the item, it's the most direct path.\n        if (curr_y, curr_x) in primitive_locations:\n            # Found the primitive. Since it's BFS, this is the shortest path.\n            # Add the USE action to collect it and return the full action sequence.\n            return path + [USE]\n\n        # Explore possible movement actions from the current position\n        for action, (dy, dx) in ACTION_TO_DELTA.items():\n            new_y, new_x = curr_y + dy, curr_x + dx\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= new_y < grid_height and 0 <= new_x < grid_width):\n                continue\n\n            # Check if this position has already been visited\n            if (new_y, new_x) in visited:\n                continue\n\n            # Add the new position to the queue and mark as visited\n            visited.add((new_y, new_x))\n            q.append((new_y, new_x, path + [action]))\n\n    # If the BFS queue becomes empty and no primitive location was reached,\n    # it means the primitive is unreachable from the initial position.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:54:36.933298", "function_name": "collect", "function_body": "    import numpy as np\n    from collections import deque\n\n    # Get action mappings from the environment\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    # Access the current state from the environment\n    # This assumes direct access to _current_state, which is typical for helper functions\n    # operating on the internal logic of the environment.\n    current_state = env._current_state\n    \n    # 1. Check if the primitive is already in the inventory\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # Get grid dimensions and current agent position\n    WIDTH, HEIGHT, _ = current_state.grid.shape\n    agent_pos = current_state.pos # (x, y) tuple\n\n    # Get obstacle indices (water and stone are typically impassable)\n    world = env.world\n    water_idx = world.water_index\n    stone_idx = world.stone_index\n    \n    # Identify all locations of the primitive on the grid\n    # np.argwhere returns (col_idx, row_idx) for a (W, H) grid if grid[x, y] is accessed\n    # If `current_state.grid` is (WIDTH, HEIGHT, n_kinds), then indexing is grid[x, y, kind_idx].\n    # np.argwhere(current_state.grid[:, :, primitive] == 1) will correctly return (x, y) tuples.\n    primitive_locations = np.argwhere(current_state.grid[:, :, primitive] == 1)\n    \n    if len(primitive_locations) == 0:\n        return [] # Primitive not found on the map\n\n    # BFS for pathfinding\n    # Queue stores tuples: (current_position (x,y), list_of_actions_to_reach_here)\n    queue = deque([(agent_pos, [])])\n    visited = {agent_pos} # Set of visited positions to avoid cycles and redundant computations\n\n    # Possible moves: (dx, dy, action) mapping change in x, change in y, and the corresponding action\n    moves = [\n        (0, -1, UP),    # Move up (decrease y-coordinate)\n        (0, 1, DOWN),   # Move down (increase y-coordinate)\n        (-1, 0, LEFT),  # Move left (decrease x-coordinate)\n        (1, 0, RIGHT)   # Move right (increase x-coordinate)\n    ]\n\n    while queue:\n        (curr_x, curr_y), path_so_far = queue.popleft()\n\n        # Check if the current position is adjacent to (or on) any primitive location.\n        # This simulates CraftState.next_to, where USE would be effective from a 3x3 neighborhood.\n        can_use_here = False\n        for px, py in primitive_locations:\n            if abs(curr_x - px) <= 1 and abs(curr_y - py) <= 1:\n                can_use_here = True\n                break\n        \n        if can_use_here:\n            # Found a position from which the primitive can be collected\n            return path_so_far + [USE]\n\n        # Explore neighbors\n        for dx, dy, action in moves:\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_pos = (next_x, next_y)\n\n            # Check boundaries\n            if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                continue\n\n            # Check if this position has already been visited during BFS\n            if next_pos in visited:\n                continue\n\n            # Obstacle check: A cell is considered an obstacle if it contains water or stone.\n            # These entities are typically impassable for agent movement.\n            is_impassable = False\n            # Check if water or stone indices are within valid range of kinds for robustness\n            if water_idx < current_state.grid.shape[2] and current_state.grid[next_x, next_y, water_idx] == 1:\n                is_impassable = True\n            if stone_idx < current_state.grid.shape[2] and current_state.grid[next_x, next_y, stone_idx] == 1:\n                is_impassable = True\n            \n            if is_impassable:\n                continue # Cannot move into an impassable cell\n\n            # If the cell is traversable and not visited, add it to the queue\n            visited.add(next_pos)\n            queue.append((next_pos, path_so_far + [action]))\n\n    # If the queue becomes empty and no path to an actionable position was found\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:54:37.011979", "function_name": "collect", "function_body": "    # 1. Get Initial State Info\n    obs = env.observations()\n    state_features_dict = obs[\"features_dict\"]\n    \n    grid = state_features_dict[\"features_global\"]\n    # Get the agent's actual (row, col) position from the CraftState object\n    current_pos = env._current_state.pos \n    \n    inventory = state_features_dict[\"inventory\"]\n    \n    action_map = env.action_specs()\n    ACTION_UP = action_map[\"UP\"]\n    ACTION_DOWN = action_map[\"DOWN\"]\n    ACTION_LEFT = action_map[\"LEFT\"]\n    ACTION_RIGHT = action_map[\"RIGHT\"]\n    ACTION_USE = action_map[\"USE\"]\n\n    # Grid dimensions\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n\n    # 2. Check if Already Collected\n    if inventory[primitive] > 0:\n        return []\n\n    # 3. Find Primitive Locations\n    # np.argwhere returns (row, col) tuples where the primitive is present\n    target_primitive_locations = set(tuple(loc) for loc in np.argwhere(grid[:, :, primitive] == 1))\n\n    if not target_primitive_locations:\n        # Primitive not on the grid\n        return []\n\n    # Map movement actions to their corresponding (dr, dc) delta\n    # Assuming (row, col) coordinates for grid:\n    # UP: decrease row\n    # DOWN: increase row\n    # LEFT: decrease col\n    # RIGHT: increase col\n    action_deltas = {\n        ACTION_UP: (-1, 0),\n        ACTION_DOWN: (1, 0),\n        ACTION_LEFT: (0, -1),\n        ACTION_RIGHT: (0, 1),\n    }\n\n    # 4. BFS for Path to an adjacent cell (or cell containing the primitive)\n    # Using collections.deque for efficient queue operations.\n    # Note: It is assumed that 'collections' module is available in the execution environment.\n    import collections\n    queue = collections.deque([(current_pos, [])]) # (pos_tuple, list_of_actions)\n    visited = {current_pos} # Set of visited (row, col) tuples\n\n    path_to_collection_spot = None # Stores the sequence of actions to reach the collection spot\n    \n    while queue:\n        curr_pos, curr_actions = queue.popleft()\n        \n        # Check if the current position is suitable for collecting the primitive.\n        # This means either:\n        # a) The agent is standing directly on the primitive.\n        # b) The agent is adjacent (4-connected) to a primitive.\n        \n        # Case a: Agent is on the primitive\n        if curr_pos in target_primitive_locations:\n            path_to_collection_spot = curr_actions\n            break # Found the path, exit BFS\n            \n        # Case b: Check if any of the 4 direct neighbors of `curr_pos` is a primitive location\n        for dr, dc in action_deltas.values():\n            neighbor_of_curr_pos = (curr_pos[0] + dr, curr_pos[1] + dc)\n            \n            if neighbor_of_curr_pos in target_primitive_locations:\n                path_to_collection_spot = curr_actions\n                break # Found the path, exit inner loop\n        \n        if path_to_collection_spot is not None:\n            break # Exit outer BFS loop\n\n        # If not at a collection spot yet, explore neighbors\n        for action, (dr, dc) in action_deltas.items():\n            next_pos = (curr_pos[0] + dr, curr_pos[1] + dc)\n\n            # Check if next_pos is within grid bounds\n            if not (0 <= next_pos[0] < WIDTH and 0 <= next_pos[1] < HEIGHT):\n                continue\n\n            # Assume all grid cells are walkable for agent movement,\n            # unless specific obstacles are defined (not in this problem description).\n            \n            if next_pos not in visited:\n                visited.add(next_pos)\n                queue.append((next_pos, curr_actions + [action]))\n\n    # 5. Post-BFS actions\n    if path_to_collection_spot is not None:\n        # Add the USE action after reaching the collection spot\n        final_actions = path_to_collection_spot + [ACTION_USE]\n        return final_actions\n    else:\n        # No path found to any cell where the primitive can be collected\n        return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:56:26.477136", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants as defined in CraftLab.action_specs\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # 1. Check if the primitive is already in the agent's inventory\n    current_obs = env.observations()\n    inventory = current_obs['features_dict']['inventory']\n    if inventory[primitive] > 0:\n        return [] # Primitive already collected, no actions needed\n\n    # Get current state information via CraftLab's public API\n    # The grid represents the world layout\n    grid = current_obs['features_dict']['features_global']\n    # Agent's current position (x, y)\n    start_pos = tuple(current_obs['features_dict']['pos']) \n    # Reference to the CraftWorld instance for world configuration (e.g., barrier types)\n    world = env.world \n\n    # Grid dimensions (width is x-axis, height is y-axis)\n    width, height, _ = grid.shape\n\n    # BFS (Breadth-First Search) for pathfinding\n    # Queue stores (current_x, current_y, list_of_actions_to_reach_here)\n    q = collections.deque([(start_pos[0], start_pos[1], [])])\n    # Set of visited (x, y) coordinates to prevent cycles and redundant exploration\n    visited = {start_pos}\n    \n    target_path_actions = []\n    found_primitive = False\n\n    # Define possible movements: (dx, dy, action_constant)\n    # dx: change in x (column), dy: change in y (row)\n    moves = [\n        (0, -1, UP),    # Move up: y decreases\n        (0, 1, DOWN),   # Move down: y increases\n        (-1, 0, LEFT),  # Move left: x decreases\n        (1, 0, RIGHT)   # Move right: x increases\n    ]\n\n    while q:\n        cx, cy, path_actions = q.popleft()\n\n        # Check if the current cell (cx, cy) contains the target primitive\n        if grid[cx, cy, primitive] > 0:\n            target_path_actions = path_actions\n            found_primitive = True\n            break # Shortest path to an instance of the primitive found\n\n        # Explore adjacent cells (neighbors)\n        for dx, dy, action in moves:\n            nx, ny = cx + dx, cy + dy\n\n            # Check if the new position (nx, ny) is within grid bounds\n            if not (0 <= nx < width and 0 <= ny < height):\n                continue\n\n            # Check if the new position has already been visited\n            if (nx, ny) in visited:\n                continue\n\n            # Determine if the cell (nx, ny) is walkable\n            # A cell is generally unwalkable if it contains specific barrier types like water or stone.\n            # However, if the primitive itself IS water or stone, we must be able to walk on it to collect it.\n            is_walkable = True\n            for k_idx in [world.water_index, world.stone_index]:\n                # If the cell contains a barrier kind (water or stone) AND that barrier kind\n                # is not the primitive we are trying to collect, then it's unwalkable.\n                if grid[nx, ny, k_idx] > 0 and k_idx != primitive:\n                    is_walkable = False\n                    break\n            \n            if is_walkable:\n                # If walkable, add to visited set and enqueue for further exploration\n                visited.add((nx, ny))\n                q.append((nx, ny, path_actions + [action]))\n\n    if not found_primitive:\n        # If the BFS completes and the primitive was not found or is unreachable\n        return []\n\n    # After finding the path to the primitive's location,\n    # the agent needs to perform a 'USE' action to collect it.\n    target_path_actions.append(USE)\n\n    return target_path_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:56:27.458722", "function_name": "collect", "function_body": "  # Action constants from env.action_specs()\n  ACTION_MAP = env.action_specs()\n  DOWN = ACTION_MAP['DOWN']\n  UP = ACTION_MAP['UP']\n  LEFT = ACTION_MAP['LEFT']\n  RIGHT = ACTION_MAP['RIGHT']\n  USE = ACTION_MAP['USE']\n\n  actions_list = []\n  max_search_steps = 1000  # Safety limit to prevent excessively long searches\n\n  # Keep track of states (position, direction) to avoid simple cycles\n  # Stores tuples of ((x, y), direction_int)\n  visited_states = set()\n\n  for _ in range(max_search_steps):\n    obs = env.observations()\n    current_inventory = obs['features_dict']['inventory']\n\n    # 1. Check if the primitive is already collected\n    if current_inventory[primitive] > 0:\n      return actions_list\n\n    # Access the internal CraftState instance for `next_to`\n    # This assumes direct access to `_current_state` is allowed for logic.\n    current_state = env._current_state \n\n    # 2. Check if the primitive is in the agent's immediate 3x3 neighborhood\n    if current_state.next_to(primitive):\n      env.step(USE)\n      actions_list.append(USE)\n      # After using, the inventory check will happen in the next loop iteration\n      continue \n\n    moved_in_step = False\n    \n    # 3. Try to move towards the primitive if visible in the egocentric view\n    features_ego = obs['features_dict']['features_ego']\n    # Agent's current facing direction (0:North, 1:East, 2:South, 3:West)\n    current_direction = np.argmax(obs['features_dict']['direction']) \n    \n    window_size = features_ego.shape[0]\n    center_idx = window_size // 2 # Agent's position in the egocentric view (center)\n\n    target_dr, target_dc = None, None # Relative row, col difference to primitive\n\n    # Search for the primitive in the egocentric view, prioritizing closer cells\n    # Iterates through cells in order of increasing Manhattan distance from agent (0,0)\n    search_order = [(dr, dc) for dr in range(-1, 2) for dc in range(-1, 2) if not (dr == 0 and dc == 0)]\n    search_order.sort(key=lambda x: abs(x[0]) + abs(x[1]))\n\n    found_primitive_in_ego = False\n    for dr_rel, dc_rel in search_order:\n        r = center_idx + dr_rel\n        c = center_idx + dc_rel\n        if 0 <= r < window_size and 0 <= c < window_size: # Ensure coordinates are within view bounds\n            if features_ego[r, c, primitive] == 1: # Assuming one-hot encoding for kinds\n                target_dr = dr_rel\n                target_dc = dc_rel\n                found_primitive_in_ego = True\n                break # Found the primitive, stop searching\n        if found_primitive_in_ego: # Break outer loop too\n            break\n    \n    if found_primitive_in_ego:\n        action_sequence_to_target = []\n        \n        # Determine the desired absolute heading (N, E, S, W) based on the relative position\n        # Prioritize movement along the dominant axis (vertical or horizontal)\n        desired_absolute_heading = -1\n        \n        if abs(target_dr) > abs(target_dc): # Vertical movement is dominant\n            if target_dr < 0: # Primitive is North of agent\n                desired_absolute_heading = 0 # Face North\n            elif target_dr > 0: # Primitive is South of agent\n                desired_absolute_heading = 2 # Face South\n        elif abs(target_dc) > 0: # Horizontal movement is dominant or only option (if target_dr == 0)\n            if target_dc > 0: # Primitive is East of agent\n                desired_absolute_heading = 1 # Face East\n            elif target_dc < 0: # Primitive is West of agent\n                desired_absolute_heading = 3 # Face West\n        \n        if desired_absolute_heading != -1:\n            # Calculate turns needed to face the desired absolute heading\n            # `diff_heading`: 0=no turn, 1=right turn, 2=turn around, 3=left turn\n            diff_heading = (desired_absolute_heading - current_direction + 4) % 4\n            \n            if diff_heading == 1: # Turn Right\n                action_sequence_to_target.append(RIGHT)\n            elif diff_heading == 2: # Turn Right twice to turn around\n                action_sequence_to_target.append(RIGHT)\n                action_sequence_to_target.append(RIGHT)\n            elif diff_heading == 3: # Turn Left\n                action_sequence_to_target.append(LEFT)\n            \n            # After turning (or if already facing), move forward one step towards it\n            action_sequence_to_target.append(UP)\n            \n            for action in action_sequence_to_target:\n                env.step(action)\n                actions_list.append(action)\n            moved_in_step = True\n\n    # 4. If primitive not found in egocentric view or no specific action was taken, explore.\n    if not moved_in_step:\n        current_pos_array = obs['features_dict']['pos']\n        # Convert numpy array position to tuple for hashability in set\n        current_pos_tuple = (int(current_pos_array[0]), int(current_pos_array[1]))\n        current_state_key = (current_pos_tuple, current_direction)\n\n        # Simple exploration strategy:\n        # If the current state has been visited (suggesting a loop or dead end),\n        # try turning right to find a new path.\n        if current_state_key in visited_states:\n            env.step(RIGHT)\n            actions_list.append(RIGHT)\n            env.step(UP) # Try moving after turning\n            actions_list.append(UP)\n        else:\n            # Mark the current state as visited\n            visited_states.add(current_state_key)\n            \n            # Try to move forward (UP)\n            initial_pos = obs['features_dict']['pos'].copy() # Store current pos before action\n            env.step(UP)\n            actions_list.append(UP)\n            \n            new_obs = env.observations()\n            new_pos = new_obs['features_dict']['pos']\n            \n            # If the agent did not move (hit a wall), turn right and try moving again\n            if np.array_equal(initial_pos, new_pos):\n                env.step(RIGHT)\n                actions_list.append(RIGHT)\n                env.step(UP) # Try moving in the new direction\n                actions_list.append(UP)\n        \n        # After any exploration move, update the visited set for the resulting state\n        # (This avoids adding duplicate states if actions caused no change or led back)\n        new_obs = env.observations()\n        new_pos_array = new_obs['features_dict']['pos']\n        new_pos_tuple = (int(new_pos_array[0]), int(new_pos_array[1]))\n        new_dir = np.argmax(new_obs['features_dict']['direction'])\n        visited_states.add((new_pos_tuple, new_dir))\n\n  # If max_search_steps is reached and the primitive is not found,\n  # return the actions recorded so far (may be incomplete).\n  return actions_list", "island_id": 5, "scores": {"3": -1}}
