{"timestamp": "2025-07-30T10:56:44.660896", "function_name": "collect", "function_body": "  import collections\n\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4\n\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # Convert the set of non-grabbable indices to a list for efficient NumPy advanced indexing\n  non_grabbable_indices_list = list(env.world.non_grabbable_indices)\n  \n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  queue = collections.deque([(start_pos, start_dir)]) \n  path_trace = {(start_pos, start_dir): (None, None)} \n\n  target_use_state = None \n\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.popleft() \n\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # Check if the cell directly in front contains the primitive and is within bounds.\n    # This is the target for the USE action.\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      target_use_state = ((curr_x, curr_y), curr_dir)\n      break \n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT)\n    for move_action in range(4): \n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action \n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position is impassable (contains any non-grabbable item).\n      # Using NumPy's any for potentially faster check across multiple indices.\n      is_impassable = False\n      if non_grabbable_indices_list: # Ensure the list is not empty to avoid indexing errors\n          # Slice the grid at the next position for all non-grabbable kinds\n          # and check if any of their counts are greater than 0.\n          if np.any(grid[next_x, next_y, non_grabbable_indices_list] > 0):\n            is_impassable = True\n      \n      if is_impassable:\n        continue \n      \n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      if next_state_tuple not in path_trace:\n        path_trace[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action)\n        queue.append(next_state_tuple)\n\n  if target_use_state is None:\n    return []\n\n  # Reconstruct the path by backtracking from the target_use_state\n  path_actions = []\n  current_reconstruction_state = target_use_state\n  \n  while path_trace[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = path_trace[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  path_actions.reverse()\n  \n  # Add the final USE action to complete the collection\n  return path_actions + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:56:45.681672", "function_name": "collect", "function_body": "  import collections # Using collections.deque for efficient queue operations in BFS\n\n  # Re-defining constants for clarity within the function scope\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 3. Retrieve grid dimensions and non-grabbable indices for boundary and impassable checks\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n  \n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    BFS state: (current_x, current_y, current_direction)\n  \n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  # Queue for BFS: stores tuples of ((x, y), direction)\n  queue = collections.deque([(start_pos, start_dir)]) \n  \n  # Dictionary to reconstruct the path: \n  # Keys are ((x, y), direction) tuples representing a state.\n  # Values are (parent_state_tuple, action_taken_to_reach_current_state).\n  # The starting state's parent info is (None, None).\n  path_trace = {(start_pos, start_dir): (None, None)} \n\n  target_use_state = None # Will store the state from which the final USE action can be applied\n\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.popleft() # Dequeue the current state\n\n    # Check if a 'USE' action is possible from this current state.\n    # This involves looking at the cell directly in front of the agent.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # If the target cell is within bounds and contains the desired primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      # We've found a valid state from which the primitive can be collected.\n      target_use_state = ((curr_x, curr_y), curr_dir)\n      break # Path found, exit the BFS loop.\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # Moving changes both the agent's position and its facing direction.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to cardinal movements\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # The agent's new direction is the direction of movement\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position is impassable (contains any non-grabbable item).\n      # The agent cannot move into cells occupied by these items.\n      # This version uses the `any()` function for a more concise check.\n      if any(grid[next_x, next_y, k_idx] > 0 for k_idx in non_grabbable_indices):\n        continue # Skip this move if the destination is impassable\n      \n      # If this new state (position and direction) has not been visited yet during the BFS\n      if next_state_tuple not in path_trace: # path_trace acts as our visited set\n        # Store how we reached this new state\n        path_trace[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action)\n        queue.append(next_state_tuple) # Add the new state to the queue for further exploration\n\n  if target_use_state is None:\n    return [] # If the queue becomes empty and no path was found, the primitive is unreachable.\n\n  # Reconstruct the sequence of actions by backtracking from the `target_use_state`\n  # back to the `start_pos`/`start_dir` using the `path_trace` dictionary.\n  path_actions = []\n  current_reconstruction_state = target_use_state\n  \n  # Backtrack until we reach the starting state, which has (None, None) as its parent info\n  while path_trace[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = path_trace[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  # The path was built in reverse order (from target to start), so reverse it\n  path_actions.reverse()\n  \n  # Add the final 'USE' action to complete the collection sequence\n  return path_actions + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:58:42.714390", "function_name": "collect", "function_body": "  import collections\n\n  # Assuming A_UP, A_DOWN, A_LEFT, A_RIGHT, A_USE are integer constants defined globally\n  # (e.g., A_UP = 0, A_DOWN = 1, A_LEFT = 2, A_RIGHT = 3, A_USE = 4)\n  # as is common in DMLab-style environments.\n\n  # Map movement actions to (delta_row, delta_col) and the direction the agent faces after the move\n  # Format: action_constant: ((delta_row, delta_col), new_facing_direction)\n  MOVE_MAPPING = {\n      A_UP: ((-1, 0), 0),    # Move North (row -1), agent faces North (0)\n      A_RIGHT: ((0, 1), 1),  # Move East (col +1), agent faces East (1)\n      A_DOWN: ((1, 0), 2),   # Move South (row +1), agent faces South (2)\n      A_LEFT: ((0, -1), 3),  # Move West (col -1), agent faces West (3)\n  }\n\n  # Map agent's facing direction to (delta_row, delta_col) of the cell directly in front\n  # This is used to determine which cell the A_USE action would affect.\n  DIR_TO_FRONT_DELTA = {\n      0: (-1, 0),  # Facing North: cell at (r-1, c)\n      1: (0, 1),   # Facing East: cell at (r, c+1)\n      2: (1, 0),   # Facing South: cell at (r+1, c)\n      3: (0, -1),  # Facing West: cell at (r, c-1)\n  }\n\n  # Get the current state from the CraftLab environment\n  curr_state = env._current_state\n\n  # Check if the primitive is already in the agent's inventory\n  if curr_state.inventory[primitive] > 0:\n      return [] # Already collected, no actions needed\n\n  # Get grid dimensions and initial agent position/direction\n  grid = curr_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n  start_r, start_c = curr_state.pos\n  start_dir = curr_state.dir\n\n  # Define obstacle indices: entities the agent cannot move onto.\n  # These typically include non-grabbable environment items, water, and workshops.\n  obstacle_indices = set(env.world.cookbook.environment)\n  obstacle_indices.add(env.world.water_index)\n  obstacle_indices.update(env.world.workshop_indices)\n\n  # Initialize BFS queue and visited set\n  # Queue stores tuples: (row, col, current_direction, list_of_actions_taken_to_reach_this_state)\n  queue = collections.deque([(start_r, start_c, start_dir, [])])\n  # Visited set stores (row, col, direction) tuples to prevent cycles and redundant exploration\n  visited = {(start_r, start_c, start_dir)}\n\n  # BFS loop\n  while queue:\n      r, c, d, path_actions = queue.popleft()\n\n      # First, check if the primitive can be collected from the current state (r, c, d)\n      # The A_USE action affects the cell directly in front of the agent based on its current direction 'd'.\n      front_dr, front_dc = DIR_TO_FRONT_DELTA[d]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      # Check if the cell in front is within grid boundaries and contains the primitive\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n              grid[front_r, front_c, primitive] == 1):\n          # Found a path that leads to a state where A_USE can collect the primitive\n          return path_actions + [A_USE]\n\n      # If not immediately collectable, explore possible movement actions from the current state\n      for action, ((dr, dc), new_dir) in MOVE_MAPPING.items():\n          nr, nc = r + dr, c + dc # Calculate the new potential position after this action\n\n          # Check if the new position is within the grid boundaries\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n\n          # Check if the new position is an obstacle (agent cannot move onto it)\n          is_obstacle = False\n          for idx in obstacle_indices:\n              if grid[nr, nc, idx] == 1:\n                  is_obstacle = True\n                  break\n          if is_obstacle:\n              continue\n          \n          # If the new state (position and resulting direction) has not been visited yet\n          if (nr, nc, new_dir) not in visited:\n              visited.add((nr, nc, new_dir))\n              queue.append((nr, nc, new_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:58:43.685107", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:00:26.633073", "function_name": "collect", "function_body": "    collected_actions = []\n    \n    # Define a maximum number of steps to prevent infinite loops.\n    # Use a multiple of the environment's max_steps or a large fixed number.\n    # A factor of 2 is reasonable to allow for exploration and collection.\n    step_limit = env.max_steps * 2 \n    if step_limit == 0: # Fallback if env.max_steps is not set or zero\n        step_limit = 2000 # A sufficiently large fixed number for typical grids\n    \n    current_steps = 0\n\n    # Action mappings\n    # DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3, USE: 4\n\n    # Direction vectors for agent facing (dx, dy) where dx is change in column, dy is change in row.\n    # Assuming agent_dir: 0=North, 1=East, 2=South, 3=West.\n    # (col, row) coordinate system: positive col is right, positive row is down.\n    DIR_VECTORS = {\n        0: (0, -1), # North (col stays, row decreases)\n        1: (1, 0),  # East (col increases, row stays)\n        2: (0, 1),  # South (col stays, row increases)\n        3: (-1, 0)  # West (col decreases, row stays)\n    }\n\n    while current_steps < step_limit:\n        obs = env.observations()\n        # Access the current CraftState instance from CraftLab.\n        # This allows direct calls to `next_to` and direct access to grid/pos for consistency\n        # with `CraftState`'s internal representation.\n        current_state = env._current_state \n\n        # 1. Check if the primitive is already collected\n        if obs['features_dict']['inventory'][primitive] > 0:\n            return collected_actions # Goal achieved, return sequence of actions taken\n\n        # Get agent's current position (col, row), direction, and the full grid\n        agent_col, agent_row = current_state.pos \n        agent_dir = current_state.dir           \n        grid = current_state.grid               \n        WIDTH, HEIGHT, _ = grid.shape\n\n        # 2. Check if the primitive is in the immediate vicinity (3x3 neighborhood)\n        if current_state.next_to(primitive):\n            target_rel_pos_found = None # Stores (dx, dy) relative to agent's position\n\n            # Search the 3x3 neighborhood for the primitive\n            for dy_rel in [-1, 0, 1]:\n                for dx_rel in [-1, 0, 1]:\n                    if dy_rel == 0 and dx_rel == 0: continue # Skip agent's own position\n                    \n                    check_col, check_row = agent_col + dx_rel, agent_row + dy_rel\n                    \n                    # Ensure checked coordinates are within grid bounds\n                    if 0 <= check_col < WIDTH and 0 <= check_row < HEIGHT:\n                        # If the primitive is at this location\n                        if grid[check_col, check_row, primitive] == 1: \n                            target_rel_pos_found = (dx_rel, dy_rel)\n                            break # Found it, exit inner loop\n                if target_rel_pos_found: break # Found it, exit outer loop\n            \n            if target_rel_pos_found:\n                # Determine if the primitive is in a cardinal direction relative to the agent\n                is_cardinal_neighbor = False\n                required_face_dir = -1\n                for d_idx, (vec_dx, vec_dy) in DIR_VECTORS.items():\n                    if (vec_dx, vec_dy) == target_rel_pos_found:\n                        required_face_dir = d_idx\n                        is_cardinal_neighbor = True\n                        break\n                \n                if is_cardinal_neighbor:\n                    # Primitive is a cardinal neighbor. Now, turn to face it if not already.\n                    if agent_dir != required_face_dir:\n                        # Calculate minimal turns (left or right)\n                        turn_diff = (required_face_dir - agent_dir + 4) % 4\n                        action_to_take = -1\n                        if turn_diff == 1: # Target is 90 deg clockwise (agent needs to turn RIGHT)\n                            action_to_take = 3 # RIGHT\n                        elif turn_diff == 3: # Target is 90 deg counter-clockwise (agent needs to turn LEFT)\n                            action_to_take = 2 # LEFT\n                        else: # 180 deg turn (turn twice). Arbitrarily pick RIGHT.\n                            action_to_take = 3 # RIGHT\n                        \n                        collected_actions.append(action_to_take)\n                        _, _, _ = env.step(action_to_take) # Apply the turn action\n                    else:\n                        # Agent is already facing the primitive directly. USE it.\n                        action_to_take = 4 # USE\n                        collected_actions.append(action_to_take)\n                        _, _, _ = env.step(action_to_take) # Apply the USE action\n                else:\n                    # Primitive is in a diagonal position. Agent needs to move to get it into\n                    # a cardinal adjacent cell or directly in front.\n                    # Simple strategy: move along x-axis then y-axis towards it.\n                    move_action = -1\n                    if target_rel_pos_found[0] != 0: # Need to move horizontally (dx != 0)\n                        move_action = 3 if target_rel_pos_found[0] > 0 else 2 # RIGHT or LEFT\n                    elif target_rel_pos_found[1] != 0: # Need to move vertically (dy != 0)\n                        move_action = 0 if target_rel_pos_found[1] > 0 else 1 # DOWN or UP\n\n                    if move_action != -1:\n                        collected_actions.append(move_action)\n                        _, _, _ = env.step(move_action) # Apply movement action\n                    else:\n                        # This case should ideally not be reached if target_rel_pos_found is not (0,0)\n                        # and it's not a cardinal neighbor. As a fallback: random move.\n                        action_to_take = np.random.choice([0, 1, 2, 3]) # Random walk\n                        collected_actions.append(action_to_take)\n                        _, _, _ = env.step(action_to_take)\n            else:\n                # `current_state.next_to(primitive)` was true, but the primitive was not found\n                # in the 3x3 search. This might indicate an inconsistency, or a non-grabbable item.\n                # Treat this as if the primitive is not found in vicinity and proceed to global search.\n                pass \n\n        # If primitive is still not collected (or not handled by `next_to` logic above), explore globally.\n        if obs['features_dict']['inventory'][primitive] == 0: \n            # `features_global` is a copy of the full allocentric grid, with shape (WIDTH, HEIGHT, n_kinds)\n            grid_global = obs['features_dict']['features_global'] \n            \n            # Find all locations of the primitive on the global map\n            # np.argwhere returns (dim0_idx, dim1_idx, ...) which for (WIDTH, HEIGHT, KINDS) is (col_idx, row_idx, kind_idx)\n            primitive_locations = np.argwhere(grid_global[:, :, primitive] == 1)\n\n            if len(primitive_locations) > 0:\n                # Found at least one primitive. Move towards the closest one using Manhattan distance.\n                distances = [np.abs(loc[0] - agent_col) + np.abs(loc[1] - agent_row) for loc in primitive_locations]\n                closest_idx = np.argmin(distances)\n                target_col, target_row = primitive_locations[closest_idx]\n\n                # Determine movement: prioritize moving along the axis with the larger difference\n                d_col = target_col - agent_col\n                d_row = target_row - agent_row\n                \n                action_to_take = -1\n                if abs(d_col) > abs(d_row): # Prefer horizontal movement (col-wise)\n                    if d_col > 0: action_to_take = 3 # RIGHT\n                    elif d_col < 0: action_to_take = 2 # LEFT\n                elif abs(d_row) > 0: # Prefer vertical movement (row-wise), or if d_col is 0 or equal to d_row\n                    if d_row > 0: action_to_take = 0 # DOWN\n                    elif d_row < 0: action_to_take = 1 # UP\n                \n                if action_to_take != -1:\n                    collected_actions.append(action_to_take)\n                    _, _, _ = env.step(action_to_take) # Apply movement action\n                else:\n                    # Agent is exactly at the target (col, row), implying d_col=0 and d_row=0.\n                    # This happens if the target item is on the agent's current cell.\n                    # Such items are usually automatically picked up or are non-grabbable terrain features.\n                    # Since `next_to` was false (or failed its internal search), assume it's not picked up by standard USE here.\n                    # As a fallback for \"stuck\" state: perform a random movement to potentially find it or expose it.\n                    action_to_take = np.random.choice([0, 1, 2, 3]) \n                    collected_actions.append(action_to_take)\n                    _, _, _ = env.step(action_to_take)\n            else:\n                # Primitive not found anywhere on the global grid.\n                # This means it might not exist in this scenario, or it's hidden.\n                # The agent cannot collect it. Continue with random movement to explore or\n                # simply let the step_limit handle it.\n                action_to_take = np.random.choice([0, 1, 2, 3]) # Random walk to explore\n                collected_actions.append(action_to_take)\n                _, _, _ = env.step(action_to_take)\n        \n        current_steps += 1\n    \n    # Return actions collected so far, whether goal was achieved or step_limit was reached.\n    return collected_actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:00:26.712142", "function_name": "collect", "function_body": "    # Action constants as per CraftLab.action_specs\n    DOWN_ACTION = 0\n    UP_ACTION = 1\n    LEFT_ACTION = 2\n    RIGHT_ACTION = 3\n    USE_ACTION = 4\n\n    # Get current state information from the CraftLab environment\n    current_state = env._current_state\n    grid = current_state.grid\n    agent_pos_xy = current_state.pos  # Agent's position as (x, y) tuple\n    world = current_state.world\n    cookbook = world.cookbook\n    non_grabbable_indices = world.non_grabbable_indices  # Set of indices for obstacles\n\n    # Grid dimensions: grid.shape is (WIDTH, HEIGHT, n_kinds)\n    grid_width, grid_height, _ = grid.shape\n\n    # For BFS, we use (row, col) coordinates, which map to (y, x) for grid access.\n    # So, agent_pos_xy (x, y) becomes (y, x) for start_pos_rc.\n    start_pos_rc = (agent_pos_xy[1], agent_pos_xy[0])\n\n    # BFS queue: stores ( (row, col), list_of_actions_to_reach_this_pos )\n    q = collections.deque([(start_pos_rc, [])])\n    # Visited set: stores (row, col) tuples to prevent cycles and re-exploring\n    visited = {start_pos_rc}\n\n    # Define possible moves as (row_diff, col_diff) and their corresponding actions\n    # This maps movement in (r, c) to CraftLab actions.\n    # (dr, dc) = (-1, 0) means move up (decrease row)\n    # (dr, dc) = (1, 0) means move down (increase row)\n    # (dr, dc) = (0, -1) means move left (decrease col)\n    # (dr, dc) = (0, 1) means move right (increase col)\n    moves_map = {\n        (-1, 0): UP_ACTION,\n        (1, 0): DOWN_ACTION,\n        (0, -1): LEFT_ACTION,\n        (0, 1): RIGHT_ACTION,\n    }\n\n    # BFS loop to find the shortest path\n    while q:\n        (r, c), actions = q.popleft()  # Current agent position (row, col) and path to it\n\n        # First, check if any immediate neighbor of the current position (r, c)\n        # contains the target primitive.\n        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Up, Down, Left, Right neighbor differences\n            nr, nc = r + dr, c + dc  # Neighbor position (row, col)\n\n            # Check if the neighbor cell (nr, nc) is within grid boundaries.\n            # `nc` maps to x-coordinate, `nr` maps to y-coordinate.\n            if 0 <= nc < grid_width and 0 <= nr < grid_height:\n                # Check if the primitive is present in this neighbor cell.\n                # Grid access is grid[x, y, kind], so grid[nc, nr, primitive].\n                if grid[nc, nr, primitive] > 0:\n                    # Found a cell (r, c) adjacent to the primitive.\n                    # Return the actions taken to reach (r, c), followed by the USE action.\n                    return actions + [USE_ACTION]\n\n        # If no primitive found adjacent to the current position, explore valid neighbors\n        # to move the agent to.\n        for (dr, dc), action in moves_map.items():\n            nr, nc = r + dr, c + dc  # New potential agent position (row, col)\n\n            # Check if the new position (nr, nc) is within grid boundaries.\n            if 0 <= nc < grid_width and 0 <= nr < grid_height:\n                if (nr, nc) not in visited:\n                    # Check if the new cell (nc, nr) is walkable.\n                    # A cell is not walkable if it contains any item from `non_grabbable_indices`.\n                    is_walkable = True\n                    for kind_idx in non_grabbable_indices:\n                        # If an obstacle (non_grabbable_index) is present in the cell, it's not walkable.\n                        if grid[nc, nr, kind_idx] > 0:\n                            is_walkable = False\n                            break\n\n                    if is_walkable:\n                        visited.add((nr, nc))\n                        q.append(((nr, nc), actions + [action]))\n\n    # If the queue becomes empty and no path to an adjacent primitive was found,\n    # return an empty list, indicating the primitive cannot be collected.\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:01:55.530280", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs\n  # These are assumed to be consistent with the CraftLab interface.\n  _ACTIONS = {\n      \"DOWN\": 0,\n      \"UP\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4,\n  }\n\n  state = env._current_state\n\n  # 1. Check if the primitive is already in the inventory\n  if state.inventory[primitive] > 0:\n    return []\n\n  grid = state.grid\n  current_pos = state.pos\n  \n  width, height, _ = grid.shape\n\n  # 2. Find all locations of the target primitive in the grid\n  primitive_locations = []\n  for x in range(width):\n    for y in range(height):\n      if grid[x, y, primitive] > 0:\n        primitive_locations.append((x, y))\n\n  if not primitive_locations:\n    # Primitive not found anywhere in the environment\n    return [] \n\n  # 3. Find the single closest target primitive location by Euclidean distance\n  closest_primitive_pos = None\n  min_dist_sq = float('inf')\n  \n  for px, py in primitive_locations:\n    dist_sq = (px - current_pos[0])**2 + (py - current_pos[1])**2\n    if dist_sq < min_dist_sq:\n      min_dist_sq = dist_sq\n      closest_primitive_pos = (px, py)\n\n  # Cells that are blocking movement are those containing any non-grabbable entities.\n  # We assume `env.world` is accessible, which holds the CraftWorld instance.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  \n  # Helper function to check if a grid cell is traversable\n  def is_walkable(x, y):\n    # Check if within grid bounds\n    if not (0 <= x < width and 0 <= y < height):\n      return False\n    # Check if the cell contains any non-grabbable entity that blocks movement\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] > 0:\n        return False\n    return True\n\n  # 4. Pathfinding using Breadth-First Search (BFS)\n  # Queue stores tuples of (current_position, list_of_actions_to_reach_here)\n  queue = collections.deque([(current_pos, [])])\n  # Keep track of visited positions to avoid cycles and redundant paths\n  visited = {current_pos}\n  \n  final_path_actions = []\n\n  while queue:\n    (cx, cy), current_actions = queue.popleft()\n\n    # If the current position is the target primitive's location, we found a path\n    if (cx, cy) == closest_primitive_pos:\n      final_path_actions = current_actions\n      break\n\n    # Explore all four cardinal neighbors (Up, Down, Left, Right)\n    neighbors = [\n        ((cx, cy + 1), _ACTIONS[\"UP\"]),    # North\n        ((cx, cy - 1), _ACTIONS[\"DOWN\"]),  # South\n        ((cx - 1, cy), _ACTIONS[\"LEFT\"]),  # West\n        ((cx + 1, cy), _ACTIONS[\"RIGHT\"]), # East\n    ]\n\n    for (nx, ny), action in neighbors:\n      if is_walkable(nx, ny) and (nx, ny) not in visited:\n        visited.add((nx, ny))\n        queue.append(((nx, ny), current_actions + [action]))\n\n  # 5. If a path was found, append the 'USE' action\n  # Assumes that standing on a grabbable primitive and using 'USE' collects it.\n  # The problem states `collect` which implies the primitive is grabbable.\n  if final_path_actions:\n    final_path_actions.append(_ACTIONS[\"USE\"])\n  \n  return final_path_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:01:55.599961", "function_name": "collect", "function_body": "    # Constants for actions from env_factory, useful for clarity within the function\n    _UP = env_factory.actions.UP\n    _DOWN = env_factory.actions.DOWN\n    _LEFT = env_factory.actions.LEFT\n    _RIGHT = env_factory.actions.RIGHT\n    _USE = env_factory.actions.USE\n\n    actions_taken = []\n    max_collect_steps = 200  # Arbitrary limit to prevent infinite loops\n\n    for _ in range(max_collect_steps):\n        current_state = env._current_state\n\n        # 1. Check if the primitive is already collected in the inventory\n        if current_state.inventory[primitive] > 0:\n            break  # Goal achieved, stop collecting\n\n        # 2. Check if the primitive is in the immediate vicinity (3x3 neighborhood)\n        if current_state.next_to(primitive):\n            # If next to it, use the USE action to try and pick it up\n            reward, done, obs = env.step(_USE)\n            actions_taken.append(_USE)\n\n            # After attempting to USE, re-check inventory. If collected, we are done.\n            if env._current_state.inventory[primitive] > 0:\n                break\n            # If not collected (e.g., USE didn't pick up the desired item, or picked something else,\n            # or the primitive was exhausted/not grabbable this way), the loop will continue\n            # to re-evaluate the situation.\n        else:\n            # 3. If not next to it, find the closest primitive on the grid and move towards it\n            grid = current_state.grid\n            my_pos = current_state.pos\n            width, height, _ = grid.shape\n\n            closest_target_pos = None\n            min_dist = float('inf')\n\n            # Search the entire grid for any instance of the primitive\n            for x in range(width):\n                for y in range(height):\n                    if grid[x, y, primitive] > 0:\n                        # Calculate Manhattan distance to prioritize closer items\n                        dist = abs(x - my_pos[0]) + abs(y - my_pos[1])\n                        if dist < min_dist:\n                            min_dist = dist\n                            closest_target_pos = (x, y)\n\n            if closest_target_pos is None:\n                # If the primitive is not found on the grid (e.g., exhausted, not rendered, or needs crafting).\n                # For a \"collect\" primitive function, we assume it's directly available on the map.\n                # As a fallback, take a random step to explore the environment.\n                move_action = np.random.choice([_UP, _DOWN, _LEFT, _RIGHT])\n                reward, done, obs = env.step(move_action)\n                actions_taken.append(move_action)\n            else:\n                # Move towards the closest visible primitive\n                target_x, target_y = closest_target_pos\n                curr_x, curr_y = my_pos\n\n                dx = target_x - curr_x\n                dy = target_y - curr_y\n\n                move_action = None\n\n                # Prioritize movement along the dimension with the larger difference\n                # This leads to more direct movement towards the target.\n                if abs(dx) >= abs(dy):\n                    if dx > 0:\n                        move_action = _RIGHT\n                    elif dx < 0:\n                        move_action = _LEFT\n                    elif dy > 0: # dx is 0, so move along y if needed\n                        move_action = _DOWN\n                    elif dy < 0:\n                        move_action = _UP\n                else: # abs(dy) > abs(dx)\n                    if dy > 0:\n                        move_action = _DOWN\n                    elif dy < 0:\n                        move_action = _UP\n                    elif dx > 0: # dy is 0, so move along x if needed\n                        move_action = _RIGHT\n                    elif dx < 0:\n                        move_action = _LEFT\n                \n                if move_action is not None:\n                    reward, done, obs = env.step(move_action)\n                    actions_taken.append(move_action)\n                else:\n                    # This case implies the agent is at the target's coordinates but `next_to`\n                    # didn't trigger, and there's no coordinate difference to move.\n                    # This should ideally be caught by the `next_to` check if the primitive\n                    # is truly at the agent's position and grabbable. As a safety net,\n                    # take a random step to potentially resolve.\n                    move_action = np.random.choice([_UP, _DOWN, _LEFT, _RIGHT])\n                    reward, done, obs = env.step(move_action)\n                    actions_taken.append(move_action)\n\n        # Check if the episode is done (e.g., max_steps reached or goal satisfied internally by DMLab).\n        # If done, we cannot take more steps, even if the primitive is not yet collected.\n        if env._is_done():\n            break\n\n    return actions_taken", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:03:43.262618", "function_name": "collect", "function_body": "    import collections\n\n    state = env._current_state\n    grid = state.grid\n    start_pos = state.pos\n    start_dir = state.dir  # Agent's initial facing direction (0:N, 1:E, 2:S, 3:W)\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # 1. Find all locations on the grid where the primitive exists\n    primitive_locations = set()\n    for r in range(WIDTH):\n        for c in range(HEIGHT):\n            if grid[r, c, primitive] > 0:\n                primitive_locations.add((r, c))\n\n    if not primitive_locations:\n        return []  # Primitive not found anywhere on the grid\n\n    # 2. Define movement deltas and their corresponding actions\n    # (row_change, col_change) -> action\n    move_deltas = [\n        (-1, 0),  # Corresponds to env_factory.UP\n        (1, 0),   # Corresponds to env_factory.DOWN\n        (0, -1),  # Corresponds to env_factory.LEFT\n        (0, 1)    # Corresponds to env_factory.RIGHT\n    ]\n    action_map = {\n        (-1, 0): env_factory.UP,\n        (1, 0): env_factory.DOWN,\n        (0, -1): env_factory.LEFT,\n        (0, 1): env_factory.RIGHT\n    }\n\n    # 3. Define mapping from (delta_r, delta_c) to direction index for facing\n    # Direction indices: 0:N (-1,0), 1:E (0,1), 2:S (1,0), 3:W (0,-1)\n    delta_to_dir_idx = {\n        (-1, 0): 0, # North\n        (0, 1): 1,  # East\n        (1, 0): 2,  # South\n        (0, -1): 3  # West\n    }\n\n    # 4. Identify obstacle indices for traversability check\n    # These are entities the agent generally cannot step onto.\n    world = state.world\n    obstacle_indices = set(world.non_grabbable_indices)\n    \n    # Explicitly add water and stone if they are considered non-traversable\n    if world.water_index is not None:\n        obstacle_indices.add(world.water_index)\n    if world.stone_index is not None:\n        obstacle_indices.add(world.stone_index)\n\n    # 5. BFS to find the shortest path to a cell *adjacent* to any primitive location\n    q = collections.deque([(start_pos, [])])  # (current_position, path_taken_so_far)\n    visited = {start_pos}  # Set of visited (r, c) positions to avoid cycles\n\n    while q:\n        curr_pos, path = q.popleft()\n\n        # Check if any neighbor of curr_pos contains the primitive\n        for dr, dc in move_deltas:\n            neighbor_pos = (curr_pos[0] + dr, curr_pos[1] + dc)\n            \n            # Check bounds for the neighbor\n            if not (0 <= neighbor_pos[0] < WIDTH and 0 <= neighbor_pos[1] < HEIGHT):\n                continue\n\n            if neighbor_pos in primitive_locations:\n                # Found a path to a cell adjacent to the primitive!\n                final_actions = list(path)  # Copy the movement actions to reach curr_pos\n\n                # Determine the direction the agent needs to face to use the primitive\n                delta_r_to_primitive = neighbor_pos[0] - curr_pos[0]\n                delta_c_to_primitive = neighbor_pos[1] - curr_pos[1]\n                \n                target_dir_idx = delta_to_dir_idx.get((delta_r_to_primitive, delta_c_to_primitive))\n                \n                if target_dir_idx is not None:\n                    # Calculate turns needed. Agent's 'dir' attribute doesn't change during movement actions.\n                    # It only matters for the 'USE' action. So, use the initial start_dir.\n                    current_facing = start_dir \n                    \n                    # Compute shortest turns (clockwise or counter-clockwise)\n                    # (target_dir_idx - current_facing + 4) % 4 gives 0, 1, 2, or 3 for diff\n                    # 0: no turn, 1: 90 deg right, 2: 180 deg, 3: 90 deg left\n                    diff = (target_dir_idx - current_facing + 4) % 4\n                    if diff == 1: # 90 degrees clockwise\n                        final_actions.append(env_factory.RIGHT)\n                    elif diff == 2: # 180 degrees (can be two rights or two lefts)\n                        final_actions.extend([env_factory.RIGHT, env_factory.RIGHT])\n                    elif diff == 3: # 90 degrees counter-clockwise\n                        final_actions.append(env_factory.LEFT)\n                    # If diff == 0, agent is already facing the correct direction\n\n                final_actions.append(env_factory.USE) # Add the USE action\n                return final_actions\n\n        # Explore neighbors for movement (agent's next possible positions)\n        for dr, dc in move_deltas:\n            next_pos = (curr_pos[0] + dr, curr_pos[1] + dc)\n\n            # Check bounds and if the position has already been visited in this BFS\n            if not (0 <= next_pos[0] < WIDTH and 0 <= next_pos[1] < HEIGHT) or next_pos in visited:\n                continue\n            \n            # Check traversability for next_pos:\n            # - The agent should not step onto a cell that contains the primitive itself (it needs to be adjacent)\n            # - The cell should not contain any defined obstacles (water, stone, non-grabbable items)\n            is_traversable = True\n            if next_pos in primitive_locations: # Don't step on the item we want to collect\n                is_traversable = False\n            else:\n                # Check for other obstacle types\n                for idx in obstacle_indices:\n                    if grid[next_pos[0], next_pos[1], idx] > 0:\n                        is_traversable = False\n                        break\n\n            if is_traversable:\n                visited.add(next_pos)\n                action_to_take = action_map[(dr, dc)]\n                q.append((next_pos, path + [action_to_take]))\n\n    return []  # No path found to any primitive", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:03:44.262164", "function_name": "collect", "function_body": "  # Action constants derived from the problem description's action_specs\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  MAX_PLANNING_STEPS = 500  # A reasonable limit for exploration steps\n\n  actions_plan = []\n\n  # Reset the environment to a deterministic initial state for planning.\n  # This modifies the internal state of the 'env' object.\n  # The caller is assumed to handle any external state management (e.g., if a fresh env is needed later).\n  env.reset(seed=0) # Using a fixed seed for deterministic planning\n\n  # Variables for simple exploration strategy\n  turn_attempts_in_current_spot = 0\n\n  for _ in range(MAX_PLANNING_STEPS):\n      current_state = env._current_state # Get the current CraftState object from the environment\n      current_pos = current_state.pos     # Agent's current (x, y) position\n      current_dir = current_state.dir     # Agent's current facing direction (0:N, 1:E, 2:S, 3:W)\n\n      # 1. Check if the primitive is already collected in the inventory\n      if current_state.inventory[primitive] > 0:\n          return actions_plan # Goal achieved, return the sequence of actions\n\n      # 2. Check if the primitive is next to the agent and can be used\n      # We need the egocentric view to determine the exact position of the primitive relative to the agent.\n      obs_dict = env.observations()['features_dict']\n      ego_grid = obs_dict['features_ego'] # (3,3,n_kinds) grid around the agent (agent at 1,1)\n\n      found_adjacent_primitive = False\n      target_relative_dr, target_relative_dc = 0, 0 # Delta row and column from agent's (1,1) in ego_grid\n\n      # Check cardinal directions around the agent (relative to agent at (1,1) in ego_grid)\n      # NORTH: ego_grid[0,1], SOUTH: ego_grid[2,1], WEST: ego_grid[1,0], EAST: ego_grid[1,2]\n      # Corresponding (dr, dc) relative to agent: N:(-1,0), S:(1,0), W:(0,-1), E:(0,1)\n\n      # Check North\n      if ego_grid[0, 1, primitive] > 0:\n          target_relative_dr, target_relative_dc = -1, 0\n          found_adjacent_primitive = True\n      # Check South\n      elif ego_grid[2, 1, primitive] > 0:\n          target_relative_dr, target_relative_dc = 1, 0\n          found_adjacent_primitive = True\n      # Check West\n      elif ego_grid[1, 0, primitive] > 0:\n          target_relative_dr, target_relative_dc = 0, -1\n          found_adjacent_primitive = True\n      # Check East\n      elif ego_grid[1, 2, primitive] > 0:\n          target_relative_dr, target_relative_dc = 0, 1\n          found_adjacent_primitive = True\n\n      if found_adjacent_primitive:\n          # Determine the target absolute direction (0:N, 1:E, 2:S, 3:W) based on relative position\n          target_abs_dir = -1\n          if target_relative_dr == -1 and target_relative_dc == 0: # Primitive is to the North\n              target_abs_dir = 0 # North direction\n          elif target_relative_dr == 1 and target_relative_dc == 0: # Primitive is to the South\n              target_abs_dir = 2 # South direction\n          elif target_relative_dr == 0 and target_relative_dc == -1: # Primitive is to the West\n              target_abs_dir = 3 # West direction\n          elif target_relative_dr == 0 and target_relative_dc == 1: # Primitive is to the East\n              target_abs_dir = 1 # East direction\n\n          if target_abs_dir != -1: # Ensure it's a valid cardinal target\n              # Calculate the number of turns needed to face the primitive\n              num_turns_right = (target_abs_dir - current_dir + 4) % 4\n              num_turns_left = (current_dir - target_abs_dir + 4) % 4\n\n              # Execute the minimum number of turns\n              if num_turns_right <= num_turns_left:\n                  for _ in range(num_turns_right):\n                      env.step(ACTION_RIGHT)\n                      actions_plan.append(ACTION_RIGHT)\n              else:\n                  for _ in range(num_turns_left):\n                      env.step(ACTION_LEFT)\n                      actions_plan.append(ACTION_LEFT)\n\n              # Now, the agent should be facing the primitive. Use it.\n              env.step(ACTION_USE)\n              actions_plan.append(ACTION_USE)\n\n              # After attempting to use, check if the primitive has been collected.\n              if env._current_state.inventory[primitive] > 0:\n                  return actions_plan # Goal achieved\n              # If not collected, continue the loop for further exploration or interaction.\n              # For primitives, it's generally expected to be collected.\n\n      # 3. Exploration Strategy (if primitive not found adjacent or not collected after attempt)\n      # Attempt to move forward (ACTION_UP) based on current_dir.\n      env.step(ACTION_UP)\n      actions_plan.append(ACTION_UP)\n\n      # Check if the agent's position changed after the move\n      if env._current_state.pos == current_pos:\n          # If position did not change (e.g., hit a wall), the last ACTION_UP was ineffective.\n          actions_plan.pop() # Remove the ineffective ACTION_UP from the plan\n\n          # Try to turn to find a new path. Alternate between turning LEFT and RIGHT.\n          if turn_attempts_in_current_spot % 2 == 0:\n              env.step(ACTION_LEFT)\n              actions_plan.append(ACTION_LEFT)\n          else:\n              env.step(ACTION_RIGHT)\n              actions_plan.append(ACTION_RIGHT)\n          turn_attempts_in_current_spot += 1\n      else:\n          # If movement was successful, reset turn attempts as we're moving again\n          turn_attempts_in_current_spot = 0\n\n  # If the loop finishes, it means the primitive was not collected within MAX_PLANNING_STEPS.\n  # Return the actions taken so far. This might be an incomplete plan.\n  return actions_plan", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:05:18.766693", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # Map delta movements (row, col) to action values\n  DELTAS = {\n      ACTION_UP: (-1, 0),\n      ACTION_DOWN: (1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1),\n  }\n  # Invert DELTAS map to reconstruct actions from path deltas\n  DELTA_TO_ACTION = {v: k for k, v in DELTAS.items()}\n\n  # Get current state information from the environment\n  current_state = env._current_state\n\n  # Step 1: Check if the primitive is already collected or if the agent is already in a position to collect it.\n  # If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  # If the agent is already in the 3x3 neighborhood of the primitive (including on top of it),\n  # it can directly perform the USE action.\n  if current_state.next_to(primitive):\n    return [ACTION_USE]\n\n  # Step 2: If not immediately collectable, perform a Breadth-First Search (BFS)\n  # to find the shortest path to a position from which the primitive can be collected.\n  grid = current_state.grid\n  agent_r, agent_c = current_state.pos # Agent's current row and column\n  GRID_HEIGHT, GRID_WIDTH, _ = grid.shape # Dimensions of the grid\n\n  # Identify obstacle indices. These are entities that the agent cannot move through.\n  # Based on CraftWorld data attributes, 'environment' items are non-grabbable\n  # and 'workshop_indices' are specific locations that might also block movement.\n  obstacle_indices = set(env.world.cookbook.environment)\n  obstacle_indices.update(env.world.workshop_indices)\n\n  # Initialize BFS data structures\n  # Queue for BFS: stores (row, col) tuples representing grid positions to visit\n  q = collections.deque([(agent_r, agent_c)])\n  # Visited set: stores (row, col) to prevent revisiting nodes and infinite loops\n  visited = {(agent_r, agent_c)}\n  # Parent map: stores (row, col) -> (previous_row, previous_col, action_to_reach_here)\n  # Used to reconstruct the path after the target is found.\n  parent_map = {(agent_r, agent_c): None}\n\n  target_adjacent_pos = None # This will store the (r, c) we want to reach, which is adjacent to a primitive.\n\n  # BFS loop: Continues until the queue is empty or the target is found.\n  while q:\n    curr_r, curr_c = q.popleft() # Get the current position from the front of the queue\n\n    # Check if the current position (curr_r, curr_c) is a suitable \"adjacent\" target.\n    # A position is suitable if any of its cardinal neighbors contains the primitive.\n    # We prioritize cardinal moves as they are standard for grid-based movement.\n    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Cardinal neighbor deltas (Up, Down, Left, Right)\n      nr, nc = curr_r + dr, curr_c + dc # Coordinates of the neighbor cell\n\n      # Check if the neighbor cell is within grid boundaries\n      if 0 <= nr < GRID_HEIGHT and 0 <= nc < GRID_WIDTH:\n        # Check if the primitive is present at this neighbor cell\n        if grid[nr, nc, primitive] > 0:\n          target_adjacent_pos = (curr_r, curr_c) # Found our target adjacent position\n          break # Stop checking neighbors, we found the closest one for this path\n    \n    if target_adjacent_pos:\n      break # Path to an adjacent cell is found, exit the BFS loop\n\n    # Explore unvisited, traversable neighbors from the current position\n    for action_val, (dr, dc) in DELTAS.items():\n      next_r, next_c = curr_r + dr, curr_c + dc # Coordinates of the next potential agent position\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_r < GRID_HEIGHT and 0 <= next_c < GRID_WIDTH):\n        continue\n\n      # Determine if the cell (next_r, next_c) is traversable.\n      # A cell is traversable if it does not contain any item from the `obstacle_indices` set.\n      # Note: Grabbable items (like the primitive itself) are generally traversable.\n      is_traversable = True\n      # Find all kinds of entities present at the `next_r, next_c` cell\n      kinds_at_cell = np.where(grid[next_r, next_c, :] > 0)[0]\n      for kind_idx in kinds_at_cell:\n        if kind_idx in obstacle_indices:\n          is_traversable = False\n          break # Cell contains an obstacle, not traversable\n      \n      if not is_traversable:\n        continue # Skip this cell if it's an obstacle\n\n      # If the cell is traversable and has not been visited yet, add it to the queue\n      if (next_r, next_c) not in visited:\n        visited.add((next_r, next_c))\n        # Store how we reached `(next_r, next_c)` for path reconstruction\n        parent_map[(next_r, next_c)] = (curr_r, curr_c, action_val)\n        q.append((next_r, next_c)) # Add to queue for further exploration\n\n  # Step 3: Reconstruct the path if a `target_adjacent_pos` was found.\n  path_actions = []\n  if target_adjacent_pos:\n    curr = target_adjacent_pos\n    # Backtrack from the `target_adjacent_pos` to the agent's starting position\n    while curr != (agent_r, agent_c):\n      prev_r, prev_c, action = parent_map[curr]\n      path_actions.append(action)\n      curr = (prev_r, prev_c)\n    path_actions.reverse() # Reverse the list to get actions in the correct order (start to target)\n\n    # After moving to the adjacent position, perform the USE action to collect the primitive\n    path_actions.append(ACTION_USE)\n\n  return path_actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:05:18.836135", "function_name": "collect", "function_body": "    # Define action constants. These are typically global or imported,\n    # but since the request is to return only code within the function,\n    # we define them here for clarity and self-containment.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Get the initial state information from the environment.\n    # Resetting the environment ensures we start from a known configuration\n    # for planning the sequence of actions.\n    initial_obs = env.reset()\n    \n    # Extract the full grid and agent's initial position from the observations.\n    initial_grid = initial_obs['features_dict']['features_global']\n    grid_height, grid_width, _ = initial_grid.shape\n    \n    # Convert the normalized position (0-1 range) to integer grid coordinates.\n    # Assuming pos[0] is row (y-coordinate) and pos[1] is column (x-coordinate).\n    initial_r = int(np.round(initial_obs['features_dict']['pos'][0] * (grid_height - 1)))\n    initial_c = int(np.round(initial_obs['features_dict']['pos'][1] * (grid_width - 1)))\n    \n    # Obtain the set of indices for non-grabbable entities. These represent\n    # obstacles that the agent cannot pass through.\n    # The `CraftLab` instance has a `world` attribute (a `CraftWorld` instance),\n    # which in turn has `non_grabbable_indices`.\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # Initialize the Breadth-First Search (BFS) queue.\n    # Each item in the queue is a tuple: (row, column, list_of_actions_to_reach_here).\n    queue = collections.deque([(initial_r, initial_c, [])])\n    \n    # Initialize a set to keep track of visited (row, column) positions\n    # to prevent cycles and redundant exploration.\n    visited = set([(initial_r, initial_c)])\n\n    # Define the change in (row, column) for each movement action.\n    move_deltas = {\n        ACTION_UP: (-1, 0),    # Move up: decrease row\n        ACTION_DOWN: (1, 0),   # Move down: increase row\n        ACTION_LEFT: (0, -1),  # Move left: decrease column\n        ACTION_RIGHT: (0, 1),  # Move right: increase column\n    }\n\n    # Start the BFS search\n    while queue:\n        r, c, path = queue.popleft()\n\n        # Check if the desired primitive is located within the 3x3 neighborhood\n        # around the current agent position (r, c). This simulates the `CraftState.next_to` logic.\n        for dr_check in [-1, 0, 1]:\n            for dc_check in [-1, 0, 1]:\n                nr_check, nc_check = r + dr_check, c + dc_check\n\n                # Ensure the neighboring cell is within grid boundaries.\n                if 0 <= nr_check < grid_height and 0 <= nc_check < grid_width:\n                    # Check if the primitive item (identified by its index) exists\n                    # at the current neighboring cell (initial_grid[row, col, kind_index] > 0).\n                    if initial_grid[nr_check, nc_check, primitive] > 0:\n                        # If the primitive is found, we have successfully reached a position\n                        # next to it. The path is complete, and the final action is USE.\n                        return path + [ACTION_USE]\n\n        # If the primitive is not found in the current neighborhood,\n        # explore adjacent traversable cells by simulating movement actions.\n        for action, (dr, dc) in move_deltas.items():\n            new_r, new_c = r + dr, c + dc\n\n            # Check if the potential new cell is within grid boundaries.\n            if 0 <= new_r < grid_height and 0 <= new_c < grid_width:\n                # Determine if the new cell is traversable.\n                # A cell is not traversable if it contains any non-grabbable item.\n                is_traversable = True\n                for ng_idx in non_grabbable_indices:\n                    if initial_grid[new_r, new_c, ng_idx] > 0:\n                        is_traversable = False\n                        break\n                \n                # If the cell is traversable and has not been visited before,\n                # add it to the queue for further exploration.\n                if is_traversable and (new_r, new_c) not in visited:\n                    visited.add((new_r, new_c))\n                    queue.append((new_r, new_c, path + [action]))\n\n    # If the BFS queue becomes empty and the primitive has not been found,\n    # it implies that the primitive is unreachable from the initial position.\n    return [] # Return an empty list to indicate no valid path was found.", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:06:45.021205", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Action constants (from problem description context)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction constants (matching CraftWorld's internal representation: 0=N, 1=E, 2=S, 3=W)\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Mapping of movement actions to (dx, dy) deltas\n  # (dx, dy) represents change in (width, height) or (x, y) coordinates\n  # UP: -y, DOWN: +y, LEFT: -x, RIGHT: +x\n  MOVEMENT_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0),\n  }\n\n  # Mapping of movement actions to the agent's resulting facing direction\n  # Taking a movement action makes the agent face that direction.\n  ACTION_TO_DIRECTION = {\n      ACTION_UP: DIR_NORTH,\n      ACTION_RIGHT: DIR_EAST,\n      ACTION_DOWN: DIR_SOUTH,\n      ACTION_LEFT: DIR_WEST,\n  }\n\n  # Mapping from relative position of an item (dx, dy) to the direction the agent\n  # needs to be facing to USE that item.\n  # Example: if item is (0, -1) relative to agent (i.e., immediately North),\n  # agent must face North.\n  RELATIVE_ITEM_POS_TO_AGENT_DIR = {\n      (0, -1): DIR_NORTH, # Item is North of agent, agent faces North\n      (1, 0): DIR_EAST,   # Item is East of agent, agent faces East\n      (0, 1): DIR_SOUTH,  # Item is South of agent, agent faces South\n      (-1, 0): DIR_WEST,  # Item is West of agent, agent faces West\n  }\n\n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Agent's current position (x, y) - ensure it's an integer tuple for hashing\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  # Agent's current direction (0=N, 1=E, 2=S, 3=W) from one-hot encoding\n  current_dir = np.argmax(obs['features_dict']['direction'])\n  \n  world = env.world\n  # Indices of entities that block movement (e.g., walls, water blocks, workshops)\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape # Grid dimensions: Width, Height, Number of Kinds\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  # Use NumPy's efficiency to create the mask.\n  # Create a boolean array where True means the kind is a non-grabbable obstacle.\n  is_obstacle_kind = np.isin(np.arange(K), list(non_grabbable_indices))\n  # Check if any non-grabbable kind has a count > 0 in any cell across the K-dimension.\n  # This creates a (W, H) boolean array indicating cells with obstacles.\n  has_obstacle = (grid[:, :, is_obstacle_kind] > 0).any(axis=-1)\n  # Invert the mask: where there's an obstacle, it's NOT traversable.\n  traversable_mask = ~has_obstacle\n  \n  # If the agent starts on an untraversable cell (e.g., spawned in a wall), no path is possible.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return []\n\n  # 2. Identify target entities whose 'use' would yield the 'primitive'.\n  # These include the primitive item itself (for direct pickup) and any source blocks.\n  target_grid_entities_for_use = {primitive} \n  \n  primitive_name = world.cookbook.index.get(primitive)\n  if primitive_name == 'water':\n      # If the primitive is 'water' (item), it can be obtained from 'water' (block)\n      if world.water_index is not None: # Check if water block index exists\n          target_grid_entities_for_use.add(world.water_index) \n  elif primitive_name == 'stone':\n      # If the primitive is 'stone' (item), it can be obtained from 'stone' (block)\n      if world.stone_index is not None: # Check if stone block index exists\n          target_grid_entities_for_use.add(world.stone_index)\n  # Extend this mapping for other primitives as needed (e.g., 'wood' from 'tree' block)\n\n  # 3. Find all potential (agent_pos, agent_dir) states from which the agent can successfully\n  # execute a 'USE' action to obtain the 'primitive'. These are our BFS \"goal states\".\n  # A goal state is ((agent_x, agent_y), required_agent_direction).\n  target_pickup_states = set() \n\n  for item_x in range(W):\n      for item_y in range(H):\n          # Check if this cell contains any of our target entities\n          contains_target_entity = False\n          for target_kind_idx in target_grid_entities_for_use:\n              if grid[item_x, item_y, target_kind_idx] > 0:\n                  contains_target_entity = True\n                  break\n          \n          if contains_target_entity:\n              # This cell (item_x, item_y) has an entity we can USE.\n              # Now, find all *cardinal adjacent traversable cells* from which an agent could USE it.\n              # Agent must be adjacent to the item AND facing it.\n              for dx_adj, dy_adj in [ (0, -1), (0, 1), (-1, 0), (1, 0) ]: # Relative positions for cardinal neighbors\n                  agent_x, agent_y = item_x + dx_adj, item_y + dy_adj\n                  \n                  # Check if the potential agent position is within bounds and traversable\n                  if (0 <= agent_x < W and 0 <= agent_y < H and\n                      traversable_mask[agent_x, agent_y]):\n                      \n                      # Calculate the relative position of the item from the agent's perspective.\n                      # (item_x - agent_x, item_y - agent_y)\n                      relative_item_pos = (item_x - agent_x, item_y - agent_y)\n                      \n                      # Determine the direction the agent must face to 'USE' the item.\n                      required_agent_dir = RELATIVE_ITEM_POS_TO_AGENT_DIR.get(relative_item_pos)\n                      \n                      if required_agent_dir is not None:\n                          target_pickup_states.add(((agent_x, agent_y), required_agent_dir))\n  \n  if not target_pickup_states:\n      return [] # No primitive source found or no reachable pickup spots around it.\n\n  # 4. Perform BFS to find the shortest sequence of actions to reach any of the `target_pickup_states`.\n  # BFS queue stores (current_pos, current_dir, path_actions_so_far)\n  q = deque([(current_pos, current_dir, [])])\n  \n  # Visited states: (position_tuple, direction_integer) to prevent cycles and redundant exploration.\n  visited = {(current_pos, current_dir)} \n\n  while q:\n      curr_pos, curr_dir, path_so_far = q.popleft()\n\n      # Check if the current (position, direction) state is one of our goal states for 'USE'.\n      if (curr_pos, curr_dir) in target_pickup_states:\n          return path_so_far + [ACTION_USE] # Path found! Append USE action and return.\n\n      # Explore possible actions from the current state:\n      # These include actual movements (changing position AND direction)\n      # and \"turning in place\" (staying at current position but changing direction).\n      for action_val, (dx, dy) in MOVEMENT_DELTAS.items():\n          # Calculate potential next position if movement is successful\n          potential_next_pos = (curr_pos[0] + dx, curr_pos[1] + dy)\n          # Calculate the direction the agent would face after this action\n          potential_next_dir = ACTION_TO_DIRECTION[action_val]\n\n          # Case 1: Agent moves to a new cell.\n          if (0 <= potential_next_pos[0] < W and 0 <= potential_next_pos[1] < H and\n              traversable_mask[potential_next_pos[0], potential_next_pos[1]]):\n              \n              next_state_pos = potential_next_pos\n              next_state_dir = potential_next_dir\n              \n              if (next_state_pos, next_state_dir) not in visited:\n                  visited.add((next_state_pos, next_state_dir))\n                  q.append((next_state_pos, next_state_dir, path_so_far + [action_val]))\n          else:\n              # Case 2: Movement is blocked (e.g., hits a wall or obstacle).\n              # Agent stays at curr_pos but still attempts the action,\n              # meaning its direction changes to `potential_next_dir`.\n              next_state_pos = curr_pos # Position remains unchanged\n              next_state_dir = potential_next_dir # Direction changes\n              \n              if (next_state_pos, next_state_dir) not in visited:\n                  visited.add((next_state_pos, next_state_dir))\n                  q.append((next_state_pos, next_state_dir, path_so_far + [action_val]))\n        \n  return [] # If the queue becomes empty and no target state was reached, no path exists.", "island_id": 9, "scores": {"3": 0.0}}
