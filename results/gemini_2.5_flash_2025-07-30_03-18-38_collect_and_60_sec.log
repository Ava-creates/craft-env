{"timestamp": "2025-07-30T23:51:56.277071", "function_name": "collect", "function_body": "    actions_taken = []\n    max_collect_steps = 200  # A safety limit to prevent infinite loops in unreachable scenarios\n\n    # Get integer values for actions from the environment's action specifications\n    action_values = env.action_specs()\n    DOWN_ACTION = action_values['DOWN']\n    UP_ACTION = action_values['UP']\n    LEFT_ACTION = action_values['LEFT']\n    RIGHT_ACTION = action_values['RIGHT']\n    USE_ACTION = action_values['USE']\n\n    for _ in range(max_collect_steps):\n        obs = env.observations()\n        current_grid = obs['features_dict']['features_global']\n        # Extract current agent position (converting to int tuple as pos might be float array)\n        current_pos_r, current_pos_c = int(obs['features_dict']['pos'][0]), int(obs['features_dict']['pos'][1])\n        current_inventory = obs['features_dict']['inventory']\n        height, width, _ = current_grid.shape\n\n        # 1. Check if the primitive is already in the inventory\n        if current_inventory[primitive] > 0:\n            return actions_taken\n\n        # Helper function to check if a grid position (r, c) is within bounds\n        def is_valid_grid_pos(r, c):\n            return 0 <= r < height and 0 <= c < width\n\n        # Helper function to check if the agent is adjacent (4-directional) to the primitive\n        def is_adjacent_to_primitive(agent_r, agent_c, grid, primitive_idx):\n            for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:  # Right, Left, Down, Up\n                nr, nc = agent_r + dr, agent_c + dc\n                if is_valid_grid_pos(nr, nc) and grid[nr, nc, primitive_idx] == 1:\n                    return True\n            return False\n\n        # 2. If the agent is currently adjacent to the primitive, use it\n        if is_adjacent_to_primitive(current_pos_r, current_pos_c, current_grid, primitive):\n            actions_taken.append(USE_ACTION)\n            _, _, _ = env.step(USE_ACTION)  # Execute the USE action in the environment\n            continue  # Re-check inventory in the next loop iteration\n\n        # 3. Pathfinding (BFS) to find the shortest path to a cell adjacent to the primitive\n        q = collections.deque([((current_pos_r, current_pos_c), [])])  # (position_tuple, path_list_of_actions)\n        visited = {(current_pos_r, current_pos_c)}  # Set of visited (r, c) tuples\n        \n        target_path = None\n\n        while q:\n            (r, c), path = q.popleft()\n\n            # If the current cell (r, c) is adjacent to the primitive, we've found a goal for movement\n            if is_adjacent_to_primitive(r, c, current_grid, primitive):\n                target_path = path\n                break  # Shortest path to a 'collectable' position found\n\n            # Explore 4-directional neighbors\n            move_options = [\n                (UP_ACTION, (-1, 0)),\n                (DOWN_ACTION, (1, 0)),\n                (LEFT_ACTION, (0, -1)),\n                (RIGHT_ACTION, (0, 1)),\n            ]\n\n            for action, (dr, dc) in move_options:\n                nr, nc = r + dr, c + dc\n                next_pos_tuple = (nr, nc)\n\n                # Check if the next position is valid and hasn't been visited\n                if is_valid_grid_pos(nr, nc) and next_pos_tuple not in visited:\n                    # In this environment, assuming all valid grid cells are traversable for movement.\n                    # If there were explicit \"wall\" or impassable terrain types (e.g., specific non-grabbable items),\n                    # additional checks like `if current_grid[nr, nc, WALL_INDEX] == 0:` would be needed here.\n                    # Based on the problem description, such terrain is not defined, so assuming free movement.\n                    visited.add(next_pos_tuple)\n                    q.append((next_pos_tuple, path + [action]))\n        \n        if target_path:\n            # If a path was found, take the first action from that path\n            next_action = target_path[0]\n            actions_taken.append(next_action)\n            _, _, _ = env.step(next_action)  # Execute the movement action\n        else:\n            # No path found to any primitive location or its adjacent cells.\n            # This indicates the primitive might not be on the map, is unreachable, or\n            # the environment setup makes it impossible to collect.\n            return actions_taken\n\n    # If the loop finishes (max_collect_steps reached) without collecting the primitive\n    return actions_taken", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:51:57.268304", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:53:06.226119", "function_name": "collect", "function_body": "  import collections\n\n  # Action mappings for CraftWorld (assuming these are constants from env_factory)\n  # 0: 'DOWN', 1: 'UP', 2: 'LEFT', 3: 'RIGHT', 4: 'USE'\n  MOVE_DELTAS = {\n      0: (1, 0),   # DOWN (dr, dc)\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1)    # RIGHT\n  }\n  USE_ACTION = 4\n\n  def _can_grab_from_cell(grid, r, c, item_idx):\n      \"\"\"\n      Helper to check if the item_idx is in the 3x3 neighborhood of (r, c).\n      This simulates CraftState.next_to() without needing a CraftState instance.\n      \"\"\"\n      WIDTH, HEIGHT, _ = grid.shape\n      # Iterate over 3x3 neighborhood (including (r,c) itself)\n      for dr_nb in [-1, 0, 1]:\n          for dc_nb in [-1, 0, 1]:\n              nr_nb, nc_nb = r + dr_nb, c + dc_nb\n              if 0 <= nr_nb < WIDTH and 0 <= nc_nb < HEIGHT:\n                  if grid[nr_nb, nc_nb, item_idx] > 0:\n                      return True\n      return False\n\n  def _find_path_to_grabbable_item(initial_state, item_idx):\n      \"\"\"\n      Finds the shortest sequence of actions (moves + final USE) to grab an item.\n      Performs a BFS on the grid.\n      Args:\n          initial_state: A CraftState object representing the current environment.\n          item_idx: The integer index of the item to collect.\n      Returns:\n          A list of integer actions, or an empty list if no path is found.\n      \"\"\"\n      grid = initial_state.grid\n      start_r, start_c = initial_state.pos\n      WIDTH, HEIGHT = grid.shape[:2]\n\n      q = collections.deque([(start_r, start_c, [])]) # (r, c, path_actions)\n      visited = set([(start_r, start_c)])\n\n      # Check if the item can be grabbed from the initial position\n      if _can_grab_from_cell(grid, start_r, start_c, item_idx):\n          return [USE_ACTION]\n\n      while q:\n          r, c, path_actions = q.popleft()\n\n          # Explore neighbors (4 cardinal directions for movement)\n          for action_val, (dr, dc) in MOVE_DELTAS.items():\n              nr, nc = r + dr, c + dc\n\n              # Check bounds\n              if 0 <= nr < WIDTH and 0 <= nc < HEIGHT:\n                  if (nr, nc) not in visited:\n                      visited.add((nr, nc))\n                      new_path = path_actions + [action_val]\n                      \n                      # If the item can be grabbed from this new position (nr, nc)\n                      if _can_grab_from_cell(grid, nr, nc, item_idx):\n                          return new_path + [USE_ACTION]\n                      \n                      q.append((nr, nc, new_path))\n\n      return [] # No path found\n\n  current_state = env._current_state\n  \n  # 1. Check if the primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  # 2. Find path to the primitive\n  # This helper function encapsulates the BFS logic\n  # It returns the full action sequence (moves + USE)\n  actions = _find_path_to_grabbable_item(current_state, primitive)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:53:06.295733", "function_name": "collect", "function_body": "    import collections\n\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    normalized_pos = obs['features_dict']['pos']\n    inventory = obs['features_dict']['inventory']\n\n    # Get action mappings from the environment\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    # If the primitive is already in inventory, no actions are needed\n    if inventory[primitive] > 0:\n        return []\n\n    height, width, _ = grid.shape\n\n    # Convert normalized agent position to integer grid coordinates\n    start_row = int(round(normalized_pos[0] * (height - 1)))\n    start_col = int(round(normalized_pos[1] * (width - 1)))\n    start_pos = (start_row, start_col)\n\n    # Determine target cells for BFS. These are any cells that contain the primitive\n    # or are immediately adjacent to a cell containing the primitive.\n    # The CraftState's _do_use method checks a 3x3 neighborhood, so being adjacent or on top is sufficient.\n    target_cells = set()\n    for r in range(height):\n        for c in range(width):\n            if grid[r, c, primitive] > 0:\n                # Add all 4-directional neighbors and the cell itself\n                # as potential interaction points for the 'USE' action.\n                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1), (0, 0)]: # (0,0) means current cell\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < height and 0 <= nc < width:\n                        target_cells.add((nr, nc))\n\n    if not target_cells:\n        # The primitive is not found anywhere on the map\n        return []\n\n    # BFS for the shortest path to any target cell\n    q = collections.deque([(start_pos, [])]) # Queue stores (current_position, path_taken_so_far)\n    visited = {start_pos} # Set of visited positions to avoid cycles and redundant paths\n    \n    # Map movement deltas to their corresponding action values\n    DELTAS_TO_ACTIONS = {\n        (-1, 0): ACTION_UP,\n        (1, 0): ACTION_DOWN,\n        (0, -1): ACTION_LEFT,\n        (0, 1): ACTION_RIGHT,\n    }\n\n    final_path_to_target = []\n    found_target_path = False\n\n    while q:\n        current_pos, path_so_far = q.popleft()\n\n        # If the current position is one of the target cells, we found a path\n        if current_pos in target_cells:\n            final_path_to_target = path_so_far\n            found_target_path = True\n            break\n\n        # Explore neighbors\n        for delta, action_val in DELTAS_TO_ACTIONS.items():\n            dr, dc = delta\n            next_r, next_c = current_pos[0] + dr, current_pos[1] + dc\n            next_pos = (next_r, next_c)\n\n            # Check if the next position is within grid boundaries and has not been visited\n            if 0 <= next_r < height and 0 <= next_c < width and next_pos not in visited:\n                # Assuming all grid cells are traversable for movement\n                visited.add(next_pos)\n                q.append((next_pos, path_so_far + [action_val]))\n\n    if not found_target_path:\n        # No path could be found to any primitive location\n        return []\n\n    # Once the agent reaches a target position, it needs to perform the 'USE' action\n    return final_path_to_target + [ACTION_USE]", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:54:20.364782", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants derived from CraftLab.action_specs()\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Get current observation from the environment\n  obs = env.observations()\n  current_state_dict = obs['features_dict']\n  grid = current_state_dict['features_global']\n  current_pos_tuple = tuple(current_state_dict['pos'])  # Agent's current (row, col)\n\n  grid_height, grid_width, n_kinds = grid.shape\n\n  # Check if the primitive is already in the agent's inventory\n  if current_state_dict['inventory'][primitive] > 0:\n      return []  # Already collected, no actions needed\n\n  # Define movement actions and their effects on (dr, dc)\n  # This maps action integer values to changes in row and column.\n  movement_actions = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # Initialize BFS queue with (row, column, path_so_far_actions)\n  q = collections.deque([(current_pos_tuple[0], current_pos_tuple[1], [])])\n  # Keep track of visited cells to avoid cycles and redundant processing\n  visited = {(current_pos_tuple[0], current_pos_tuple[1])}\n  \n  # This will store (final_r, final_c, list_of_actions_to_reach_final_pos)\n  # once a suitable position is found.\n  target_pos_found_info = None \n\n  # BFS to find the shortest path to a cell from which the primitive can be collected\n  while q:\n      r, c, path = q.popleft()\n\n      # Check if the primitive is within the 3x3 neighborhood of the current cell (r, c).\n      # The 3x3 neighborhood includes the cell (r,c) itself.\n      can_collect_from_here = False\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = r + dr_check, c + dc_check\n\n              # Ensure the checked cell is within grid boundaries\n              if not (0 <= check_r < grid_height and 0 <= check_c < grid_width):\n                  continue\n              \n              # If the target primitive exists in this cell layer, we can collect it from (r,c)\n              if grid[check_r, check_c, primitive] > 0:\n                  can_collect_from_here = True\n                  break  # Found primitive in 3x3 neighborhood\n          if can_collect_from_here:\n              break # Exit outer loop for checking 3x3\n\n      # If a position from which to collect is found, record it and stop BFS\n      if can_collect_from_here:\n          target_pos_found_info = (r, c, path)\n          q.clear()  # Clear queue to stop BFS immediately as shortest path is found\n          break      # Exit outer while loop\n\n      # If not found yet, explore valid neighboring cells for movement\n      for action_val, (dr, dc) in movement_actions.items():\n          nr, nc = r + dr, c + dc\n\n          # Ensure the next agent position is within grid boundaries\n          if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n              continue\n          \n          # Assuming all grid cells are traversable unless out of bounds for CraftWorld v2.\n          # If there were impassable terrain (e.g., walls), additional checks would be needed here:\n          # if grid[nr, nc, wall_kind_idx] > 0: continue \n\n          # If the neighbor has not been visited, add it to the queue\n          if (nr, nc) not in visited:\n              visited.add((nr, nc))\n              new_path = path + [action_val]\n              q.append((nr, nc, new_path))\n  \n  # If a path to a collectible position was found\n  if target_pos_found_info:\n      # The actions to reach the collection point are in target_pos_found_info[2].\n      # Append the USE action to perform the collection.\n      final_actions = target_pos_found_info[2] + [USE]\n      return final_actions\n  \n  # If the primitive was not found or is unreachable\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:54:20.434717", "function_name": "collect", "function_body": "    import collections\n\n    actions_map_from_env = env.action_specs()\n    ACTION_DOWN = actions_map_from_env['DOWN']\n    ACTION_UP = actions_map_from_env['UP']\n    ACTION_LEFT = actions_map_from_env['LEFT']\n    ACTION_RIGHT = actions_map_from_env['RIGHT']\n    ACTION_USE = actions_map_from_env['USE']\n\n    action_movement_mapping = {\n        (0, -1): ACTION_UP,\n        (0, 1): ACTION_DOWN,\n        (-1, 0): ACTION_LEFT,\n        (1, 0): ACTION_RIGHT,\n    }\n\n    state = env._current_state\n    current_grid = state.grid\n    current_pos = state.pos\n    inventory = state.inventory\n    world = env.world # CraftWorld instance\n\n    # Check if primitive is already collected\n    if inventory[primitive] > 0:\n        return []\n\n    grid_width, grid_height, _ = current_grid.shape\n    \n    # Helper to check if a position is valid and traversable\n    # A cell is traversable if it does not contain any non-grabbable item.\n    # Agent can move onto cells with grabbable items or empty cells.\n    def is_traversable(x, y):\n        if not (0 <= x < grid_width and 0 <= y < grid_height):\n            return False\n        # If the cell contains any non-grabbable item, it's not traversable\n        for kind_idx in world.non_grabbable_indices:\n            if current_grid[x, y, kind_idx] > 0:\n                return False\n        return True\n\n    # Find all locations of the primitive on the grid\n    primitive_locations = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if current_grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the grid\n\n    # BFS to find the shortest path to a cell from which the primitive can be 'USE'd\n    # The BFS state is (current_position, path_taken_so_far)\n    q = collections.deque([(current_pos, [])])\n    visited = {current_pos}\n    \n    while q:\n        (cx, cy), path = q.popleft()\n\n        # Check if the current position (cx, cy) is within the 3x3 neighborhood\n        # of any primitive location. This makes it a valid spot to perform the 'USE' action.\n        is_valid_use_position = False\n        for px, py in primitive_locations:\n            if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n                is_valid_use_position = True\n                break\n        \n        if is_valid_use_position:\n            # We found the shortest path to a position from which the primitive can be used.\n            # Add the 'USE' action to the end of the path.\n            return path + [ACTION_USE]\n\n        # Explore cardinal neighbors (Up, Down, Left, Right)\n        for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n            nx, ny = cx + dx, cy + dy\n            if is_traversable(nx, ny) and (nx, ny) not in visited:\n                visited.add((nx, ny))\n                q.append(((nx, ny), path + [action_movement_mapping[(dx, dy)]]))\n\n    return [] # No path found to any usable position for the primitive", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:56:06.250342", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Define action constants based on the CraftLab action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Define direction constants (common mapping, assuming 0:N, 1:E, 2:S, 3:W)\n    # These map to the `dir` attribute of CraftState.\n    DIR_N = 0  # North (Up on grid)\n    DIR_E = 1  # East (Right on grid)\n    DIR_S = 2  # South (Down on grid)\n    DIR_W = 3  # West (Left on grid)\n\n    # Mapping directions to deltas (row_change, col_change) for calculating\n    # the position directly in front of the agent.\n    DIR_DELTAS = {\n        DIR_N: (-1, 0),  # Agent facing North, cell in front is (row-1, col)\n        DIR_E: (0, 1),   # Agent facing East, cell in front is (row, col+1)\n        DIR_S: (1, 0),   # Agent facing South, cell in front is (row+1, col)\n        DIR_W: (0, -1),  # Agent facing West, cell in front is (row, col-1)\n    }\n\n    def _is_valid_pos(pos, grid_shape):\n        \"\"\"Checks if a given (row, col) position is within the grid boundaries.\"\"\"\n        r, c = pos\n        # grid_shape is (HEIGHT, WIDTH, N_KINDS)\n        height, width, _ = grid_shape\n        return 0 <= r < height and 0 <= c < width\n\n    def _get_front_pos(agent_pos, agent_dir):\n        \"\"\"Calculates the (row, col) position directly in front of the agent,\n        based on its current position and facing direction.\"\"\"\n        r, c = agent_pos\n        # Get delta for the current direction; default to (0,0) if direction is invalid.\n        dr, dc = DIR_DELTAS.get(agent_dir, (0, 0)) \n        return (r + dr, c + dc)\n\n    # Get the initial CraftState from the CraftLab environment.\n    # CraftLab exposes the current state via its internal `_current_state` attribute.\n    initial_state = env._current_state \n    \n    # `visited` set stores unique agent states as (row, col, direction) tuples.\n    # This prevents revisiting the same configuration, which is crucial for\n    # efficient BFS and guaranteeing the shortest path in unweighted graphs.\n    # We do not include inventory in the visited key as the goal is to obtain\n    # the primitive, which fundamentally changes the inventory only at the end.\n    visited = set()\n    \n    # BFS queue: each element is (current_CraftState_object, actions_taken_so_far_list).\n    # We use a deque for efficient appends and pops from both ends.\n    queue = collections.deque()\n\n    # Add the initial state to the queue and mark it as visited.\n    # This is the starting point of our search.\n    initial_pos_dir_key = (initial_state.pos, initial_state.dir)\n    queue.append((initial_state, []))\n    visited.add(initial_pos_dir_key) # Mark as visited to prevent revisiting\n\n    # Get grid dimensions for boundary checks and access to CraftWorld for grabbable items.\n    # `grid.shape` is typically (HEIGHT, WIDTH, N_KINDS).\n    grid_shape = initial_state.grid.shape \n    world = env.world # `env` (CraftLab) holds a reference to `world` (CraftWorld)\n    grabbable_indices = world.grabbable_indices\n\n    # Pre-check: If the desired primitive is not configured as a 'grabbable' item\n    # in the CraftWorld, it cannot be collected using a simple 'USE' action.\n    # In such a case, an empty list of actions is returned, indicating it's not collectable\n    # via this method.\n    if primitive not in grabbable_indices:\n        return []\n\n    # BFS search loop: Continues as long as there are states to explore in the queue.\n    while queue:\n        current_state, path_actions = queue.popleft()\n        \n        # GOAL CHECK: If the primitive is already in the inventory of the current state,\n        # it means we have successfully found a sequence of actions that leads to its collection.\n        if current_state.inventory[primitive] > 0:\n            return path_actions\n        \n        # ATTEMPT TO COLLECT FROM CURRENT POSITION:\n        # Check if the primitive is directly in front of the agent in the current state.\n        front_pos = _get_front_pos(current_state.pos, current_state.dir)\n        \n        if _is_valid_pos(front_pos, grid_shape) and \\\n           current_state.grid[front_pos[0], front_pos[1], primitive] > 0:\n            \n            # If the primitive is in front, simulate taking the 'USE' action.\n            # `CraftState.step()` returns (reward, new_state). We only need the new state.\n            _, state_after_use = current_state.step(ACTION_USE)\n            \n            # After simulating 'USE', check if the primitive is now in the inventory.\n            # If it is, this sequence of actions (path_actions + ACTION_USE) is a solution.\n            if state_after_use.inventory[primitive] > 0:\n                return path_actions + [ACTION_USE]\n\n        # EXPLORE MOVEMENT ACTIONS:\n        # Iterate through all possible movement actions (UP, DOWN, LEFT, RIGHT).\n        for action in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n            # Simulate taking the current movement `action` from the `current_state`.\n            # `CraftState.step()` handles grid boundaries, collisions, and updates\n            # the agent's position and direction. It returns a *new* CraftState object.\n            _, next_state = current_state.step(action)\n            \n            # Create a unique key for the resulting state after the move.\n            next_state_pos_dir_key = (next_state.pos, next_state.dir)\n            \n            # If this next state has not been visited yet, add it to the queue for\n            # further exploration and mark it as visited to avoid redundant processing.\n            if next_state_pos_dir_key not in visited:\n                visited.add(next_state_pos_dir_key) # Mark as visited immediately when enqueuing\n                queue.append((next_state, path_actions + [action]))\n\n    # If the BFS queue becomes empty and the primitive hasn't been collected,\n    # it means no path was found to collect the primitive from the initial state.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:56:07.261102", "function_name": "collect", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:56:57.669959", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement vectors (dx, dy) to action IDs.\n  # These actions move the agent AND set its facing direction.\n  MOVE_VEC_TO_ACTION = {\n      (0, -1): ACTION_UP,    # Move North, face North\n      (0, 1): ACTION_DOWN,   # Move South, face South\n      (-1, 0): ACTION_LEFT,  # Move West, face West\n      (1, 0): ACTION_RIGHT   # Move East, face East\n  }\n\n  # Map agent's internal direction ID to its corresponding facing vector (dx, dy).\n  # 0: North (-Y), 1: East (+X), 2: South (+Y), 3: West (-X)\n  DIR_TO_VEC = {\n      0: (0, -1),  # North\n      1: (1, 0),   # East\n      2: (0, 1),   # South\n      3: (-1, 0)   # West\n  }\n\n  # Get initial observations and extract relevant state information\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  start_pos = tuple(obs['features_dict']['pos'].astype(int))\n  start_dir = np.argmax(obs['features_dict']['direction']) # Convert one-hot to int (0-3)\n\n  grid_width, grid_height, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a coordinate is within grid bounds\n  def is_valid_coord(x, y):\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  # Helper function to check if a cell is traversable.\n  # A cell is not traversable if it contains any non-grabbable entity.\n  def is_traversable(x, y):\n      if not is_valid_coord(x, y):\n          return False\n      for idx in non_grabbable_indices:\n          if grid[x, y, idx] > 0:\n              return False # Contains an obstacle\n      return True # Traversable\n\n  # BFS search to find the shortest path to a position from which the primitive can be collected.\n  # The state in BFS is ((x, y), direction_int).\n  # `queue` stores states to visit.\n  # `visited` stores states already processed to prevent cycles and redundant exploration.\n  # `parent_map` stores: (child_pos, child_dir) -> ((parent_pos, parent_dir), action_taken_to_reach_child)\n  \n  queue = collections.deque([(start_pos, start_dir)])\n  visited = set([(start_pos, start_dir)])\n  parent_map = {}\n\n  target_state_before_use = None # Stores the (pos, dir) state from which the USE action can be applied\n\n  while queue:\n      (curr_x, curr_y), curr_dir = queue.popleft()\n      current_bfs_state = ((curr_x, curr_y), curr_dir)\n\n      # Check if the target primitive is directly in front of the current position and direction.\n      facing_vec = DIR_TO_VEC[curr_dir]\n      front_x, front_y = curr_x + facing_vec[0], curr_y + facing_vec[1]\n\n      if is_valid_coord(front_x, front_y) and grid[front_x, front_y, primitive] > 0:\n          # Found the primitive in front, this is our target state to reconstruct the path from.\n          target_state_before_use = current_bfs_state\n          break # Found the shortest path, exit BFS\n\n      # Explore possible moves (UP, DOWN, LEFT, RIGHT).\n      # Each move action also changes the agent's direction to the direction of movement.\n      for move_vec, move_action in MOVE_VEC_TO_ACTION.items():\n          next_x, next_y = curr_x + move_vec[0], curr_y + move_vec[1]\n          next_dir = move_action # New direction is set by the move action itself.\n          next_pos = (next_x, next_y)\n\n          # Check if the next cell is traversable.\n          if is_traversable(next_x, next_y):\n              next_bfs_state = (next_pos, next_dir)\n              if next_bfs_state not in visited:\n                  visited.add(next_bfs_state)\n                  # Store the parent state and the action taken to reach this next state\n                  parent_map[next_bfs_state] = (current_bfs_state, move_action)\n                  queue.append(next_bfs_state)\n\n  # If target_state_before_use is found, reconstruct the path\n  if target_state_before_use:\n      actions_path = [ACTION_USE] # The final action is always USE\n      current_path_state = target_state_before_use\n\n      # Backtrack from the target state to the initial state using the parent_map\n      while current_path_state != (start_pos, start_dir):\n          # Retrieve the parent state and the action that led to current_path_state\n          parent_state, action_to_reach_curr = parent_map[current_path_state]\n          actions_path.append(action_to_reach_curr)\n          current_path_state = parent_state\n      \n      # The path was built in reverse, so reverse it to get the correct sequence\n      return actions_path[::-1]\n\n  # If the queue becomes empty and no path was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T23:56:58.664268", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map movement vectors (dx, dy) to action IDs.\n  # These actions move the agent AND set its facing direction.\n  MOVE_VEC_TO_ACTION = {\n      (0, -1): UP,    # Move North, face North\n      (0, 1): DOWN,   # Move South, face South\n      (-1, 0): LEFT,  # Move West, face West\n      (1, 0): RIGHT   # Move East, face East\n  }\n\n  # Map agent's internal direction ID to its corresponding facing vector (dx, dy).\n  # 0: North (-Y)\n  # 1: East (+X)\n  # 2: South (+Y)\n  # 3: West (-X)\n  DIR_TO_VEC = {\n      0: (0, -1),  # North\n      1: (1, 0),   # East\n      2: (0, 1),   # South\n      3: (-1, 0)   # West\n  }\n\n  initial_obs = env.observations()\n  initial_grid = initial_obs['features_dict']['features_global']\n  initial_pos_tuple = tuple(initial_obs['features_dict']['pos'].astype(int))\n  initial_dir = np.argmax(initial_obs['features_dict']['direction'])\n\n  grid_width, grid_height, _ = initial_grid.shape\n\n  # Get indices of non-grabbable items (obstacles) from the world\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a coordinate is within grid bounds\n  def is_valid_coord(x, y):\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  # --- Improvement for v2: Pre-compute traversability map ---\n  # This avoids re-checking all non-grabbable indices for every cell during BFS.\n  # Create a boolean grid indicating which cells are traversable.\n  traversable_map = np.full((grid_width, grid_height), True, dtype=bool)\n  for x in range(grid_width):\n      for y in range(grid_height):\n          for idx in non_grabbable_indices:\n              if initial_grid[x, y, idx] > 0:\n                  traversable_map[x, y] = False # Mark as untraversable if it contains an obstacle\n                  break # No need to check other indices for this cell\n\n  # Optimized helper function to check if a cell is traversable.\n  # Now it just checks grid bounds and the pre-computed traversable_map.\n  def is_traversable(x, y):\n      return is_valid_coord(x, y) and traversable_map[x, y]\n  # --- End of improvement ---\n\n  # BFS search to find the shortest path to a position from which the primitive can be collected.\n  # The state in BFS is ((x, y), direction_int).\n  queue = collections.deque([(initial_pos_tuple, initial_dir)])\n  # Visited set stores (position, direction) tuples to prevent cycles and redundant exploration.\n  visited = set([(initial_pos_tuple, initial_dir)])\n  # parent_map stores: (child_pos, child_dir) -> ((parent_pos, parent_dir), action_taken_to_reach_child)\n  parent_map = {}\n\n  target_reached_state = None # To store the state from which USE action can be applied\n\n  while queue:\n      (curr_x, curr_y), curr_dir_int = queue.popleft()\n      current_bfs_state = ((curr_x, curr_y), curr_dir_int)\n\n      # Check if the target primitive is directly in front of the current position and direction.\n      facing_vec = DIR_TO_VEC[curr_dir_int]\n      front_x, front_y = curr_x + facing_vec[0], curr_y + facing_vec[1]\n\n      if is_valid_coord(front_x, front_y) and initial_grid[front_x, front_y, primitive] > 0:\n          # Found the primitive in front, this is our target state.\n          target_reached_state = current_bfs_state\n          break # Found the shortest path, exit BFS\n\n      # Explore possible moves (UP, DOWN, LEFT, RIGHT).\n      # Each move action also changes the agent's direction to the direction of movement.\n      for move_vec, move_action in MOVE_VEC_TO_ACTION.items():\n          next_x, next_y = curr_x + move_vec[0], curr_y + move_vec[1]\n          next_dir_int = move_action # The new direction is set by the move action itself.\n          next_pos_tuple = (next_x, next_y)\n\n          # Check if the next cell is traversable using the optimized function.\n          if is_traversable(next_x, next_y):\n              next_bfs_state = (next_pos_tuple, next_dir_int)\n              if next_bfs_state not in visited:\n                  visited.add(next_bfs_state)\n                  # Store the parent and the action taken to reach this state\n                  parent_map[next_bfs_state] = (current_bfs_state, move_action)\n                  queue.append(next_bfs_state)\n\n  # If target_reached_state is found, reconstruct the path\n  if target_reached_state:\n      actions_path = [USE] # The last action is always USE\n      current_path_state = target_reached_state\n\n      # Backtrack from the target_reached_state to the initial_state\n      while current_path_state != (initial_pos_tuple, initial_dir):\n          # Get parent state and action from parent_map\n          parent_state, action_to_reach_curr = parent_map[current_path_state]\n          actions_path.append(action_to_reach_curr)\n          current_path_state = parent_state\n      \n      # The path was built in reverse, so reverse it back\n      return actions_path[::-1]\n\n  # If the queue becomes empty and no path was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T23:58:37.623435", "function_name": "collect", "function_body": "  # Get the initial state of the environment from CraftLab\n  initial_craft_state = env._current_state\n\n  # If the primitive is already in the inventory, no actions are needed\n  if initial_craft_state.inventory[primitive] > 0:\n    return []\n\n  # Using collections.deque for efficient popleft operations in BFS\n  import collections\n  q = collections.deque()\n  # Each element in the queue is a tuple: (CraftState_instance, list_of_actions_to_reach_this_state)\n  q.append((initial_craft_state, []))\n\n  # Use a set to keep track of visited states to avoid redundant computations and cycles.\n  # A state is defined by (agent_position, agent_direction, agent_inventory_tuple).\n  # Inventory is a numpy array, so it needs to be converted to a tuple to be hashable.\n  visited = set()\n\n  # Helper function to create a hashable representation of a CraftState\n  def _get_state_hash(state):\n    return (state.pos, state.dir, tuple(state.inventory))\n\n  # Define a maximum search depth to prevent excessively long searches,\n  # which could happen in large or complex environments.\n  # This is a heuristic and might need tuning based on specific world sizes.\n  MAX_SEARCH_DEPTH = 150 \n\n  # Action constants (assuming these are defined globally or accessible in the module scope)\n  # Based on CraftLab.action_specs()\n  # DOWN = 0\n  # UP = 1\n  # LEFT = 2\n  # RIGHT = 3\n  # USE = 4\n  # N_ACTIONS = 5 # Total number of actions (0-4)\n  # For the purpose of this completion, we assume N_ACTIONS is 5\n  N_ACTIONS = 5 # Define it locally if not globally available in the provided context\n\n  # Breadth-First Search (BFS) for shortest path in terms of actions\n  while q:\n    current_state, current_actions = q.popleft()\n\n    # If this state has already been visited, skip it\n    state_hash = _get_state_hash(current_state)\n    if state_hash in visited:\n      continue\n    visited.add(state_hash)\n\n    # If the goal (primitive in inventory) is met in the current state, return the actions\n    if current_state.inventory[primitive] > 0:\n      return current_actions\n\n    # Prune search if current action sequence is too long\n    if len(current_actions) >= MAX_SEARCH_DEPTH:\n      continue\n\n    # Explore all possible actions from the current state\n    for action in range(N_ACTIONS): # Iterate through actions 0 to N_ACTIONS-1\n      # Simulate the action to get the next state.\n      # CraftState.step returns a new CraftState instance, so no manual deepcopy is needed.\n      _reward, next_state = current_state.step(action)\n      new_actions = current_actions + [action]\n\n      # Check if the next state has already been visited\n      next_state_hash = _get_state_hash(next_state)\n      if next_state_hash not in visited:\n        # If performing this action immediately satisfied the goal, return the new actions.\n        # This is particularly relevant for the 'USE' action which changes inventory.\n        if next_state.inventory[primitive] > 0:\n          return new_actions\n        \n        # Add the next state and its action sequence to the queue for further exploration\n        q.append((next_state, new_actions))\n\n  # If the queue becomes empty and no path to the primitive was found\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T23:58:38.587829", "function_name": "collect", "function_body": "  import collections\n  \n  # Action constants defined in CraftLab.action_specs\n  # Assuming these are accessible or defined globally\n  # For completeness, defining them here based on typical DMLab Craft environments\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  world = env._current_state.world\n  start_pos = env._current_state.pos\n  grid = env._current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get the index for 'wall' to check for impassable terrain.\n  # We assume 'wall' is consistently named and exists in the index.\n  try:\n    wall_index = world.index.contents['wall']\n  except KeyError:\n    # Fallback or error handling if 'wall' index is not found\n    # For a robust solution, consider how to handle environments without 'wall'\n    # or where 'wall' is named differently. For this problem, assume it exists.\n    return []\n\n  def is_walkable(x, y):\n    \"\"\"Checks if a given grid cell (x, y) is within bounds and does not contain a 'wall'.\"\"\"\n    # A cell is walkable if it's within grid boundaries and the 'wall' layer at (x,y) is 0\n    return 0 <= x < WIDTH and 0 <= y < HEIGHT and grid[x, y, wall_index] == 0\n\n  # Determine the collection mechanism:\n  # If the primitive is grabbable (e.g., stone, water), the agent typically stands on it to collect.\n  # If it's non-grabbable (e.g., a workshop, a tree from which wood is collected),\n  # the agent typically stands adjacent to it.\n  # We use `world.grabbable_indices` from CraftWorld data attributes.\n  target_is_stand_on = (primitive in world.grabbable_indices)\n\n  q = collections.deque([(start_pos, [])]) # Queue for BFS: (current_position, list_of_actions_to_reach_here)\n  visited = {start_pos} # Set of visited positions to avoid cycles and redundant paths\n\n  final_path_actions = []\n  found_target = False\n\n  # Define movement actions and their corresponding (dx, dy) changes on the grid.\n  # Note: DMLab Craft action mappings are usually:\n  # UP (action 1) moves agent North (decreases y)\n  # DOWN (action 0) moves agent South (increases y)\n  # LEFT (action 2) moves agent West (decreases x)\n  # RIGHT (action 3) moves agent East (increases x)\n  action_move_map = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0)\n  }\n\n  while q and not found_target:\n    curr_pos, actions_so_far = q.popleft()\n\n    # Check if the current position meets the goal criteria\n    if target_is_stand_on:\n      # If the primitive is something we stand ON (like stone, water)\n      if grid[curr_pos[0], curr_pos[1], primitive] == 1:\n        final_path_actions = actions_so_far\n        found_target = True\n    else:\n      # If the primitive is something we stand ADJACENT TO (like a workshop or a tree)\n      # Check the 4-directional neighbors of the current position\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Left, Right, Up, Down relative to agent\n        nx, ny = curr_pos[0] + dx, curr_pos[1] + dy\n        # Ensure neighbor is within bounds and contains the primitive\n        if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and grid[nx, ny, primitive] == 1:\n          final_path_actions = actions_so_far\n          found_target = True\n          break # Found an adjacent primitive, no need to check other neighbors for this curr_pos\n\n    if found_target:\n      break # Exit the BFS loop once a path to the target (or adjacent cell) is found\n\n    # If target not found at current position, explore unvisited, walkable neighbors\n    for action, (dx, dy) in action_move_map.items():\n      next_pos = (curr_pos[0] + dx, curr_pos[1] + dy)\n      \n      # Ensure next_pos is walkable (not a wall) and has not been visited yet\n      if is_walkable(next_pos[0], next_pos[1]) and next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, actions_so_far + [action]))\n\n  # If no path was found to the primitive or an adjacent cell\n  if not found_target:\n    return []\n\n  # After finding the path, append the 'USE' action to collect the primitive.\n  # This assumes 'USE' is effective when the agent is correctly positioned\n  # (either on the primitive or adjacent to it), without needing specific turn actions\n  # which are not provided in the action_specs. The problem statement for CraftState.step\n  # indicates 'direction' is updated by movement, but for simplified 'collect' tasks,\n  # often only proximity is key for 'USE'.\n  all_actions = list(final_path_actions)\n  all_actions.append(USE)\n  \n  return all_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:00:11.390177", "function_name": "collect", "function_body": "  import collections\n\n  # Define actions mapping (consistent with CraftLab.action_specs)\n  _ACTIONS = {\n      \"DOWN\": 0, \"UP\": 1, \"LEFT\": 2, \"RIGHT\": 3, \"USE\": 4\n  }\n  # Define cardinal directions (0:NORTH, 1:EAST, 2:SOUTH, 3:WEST)\n  _NORTH, _EAST, _SOUTH, _WEST = 0, 1, 2, 3\n  # Define movement vectors for each direction\n  _DIR_VEC = {\n      _NORTH: (-1, 0),  # UP (row changes by -1)\n      _EAST: (0, 1),    # RIGHT (col changes by +1)\n      _SOUTH: (1, 0),   # DOWN (row changes by +1)\n      _WEST: (0, -1)    # LEFT (col changes by -1)\n  }\n  # Map movement actions to the direction the agent faces after that move\n  # (Assuming agent's facing direction aligns with its movement direction)\n  _MOVE_ACTION_TO_FACE_DIR = {\n      _ACTIONS[\"UP\"]: _NORTH,\n      _ACTIONS[\"RIGHT\"]: _EAST,\n      _ACTIONS[\"DOWN\"]: _SOUTH,\n      _ACTIONS[\"LEFT\"]: _WEST,\n  }\n\n  def is_obstacle(r, c, grid, non_grabbable_indices, width, height):\n    \"\"\"Checks if a cell (r, c) is an obstacle.\"\"\"\n    if not (0 <= r < height and 0 <= c < width):\n      return True  # Out of bounds is an obstacle\n    # Check if the cell contains any non-grabbable item\n    for k_idx in non_grabbable_indices:\n      if grid[r, c, k_idx] > 0:\n        return True\n    return False\n\n  current_state = env._current_state\n  grid = current_state.grid\n  # Grid shape is (WIDTH, HEIGHT, n_kinds) in problem description, but typically (HEIGHT, WIDTH, n_kinds) in numpy.\n  # Let's assume grid.shape[0] is height and grid.shape[1] is width based on common numpy array indexing.\n  HEIGHT, WIDTH, _ = grid.shape \n  initial_r, initial_c = current_state.pos\n  initial_dir = current_state.dir # Agent's initial facing direction\n  inventory = current_state.inventory\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n\n  # 1. Check if primitive is already collected\n  if inventory[primitive] > 0:\n    return []\n\n  # 2. Find primitive location on the grid\n  primitive_r, primitive_c = -1, -1\n  for r in range(HEIGHT):\n    for c in range(WIDTH):\n      if grid[r, c, primitive] > 0:\n        primitive_r, primitive_c = r, c\n        break\n    if primitive_r != -1:\n      break\n\n  if primitive_r == -1:\n    return []  # Primitive not found on the grid\n\n  # 3. Use BFS to find the shortest path of actions\n  # State in queue: ((row, col, direction), list_of_actions)\n  queue = collections.deque([((initial_r, initial_c, initial_dir), [])])\n  visited = {(initial_r, initial_c, initial_dir)} # To avoid cycles and redundant paths\n\n  final_actions = None\n\n  while queue:\n    (curr_r, curr_c, curr_d), actions_so_far = queue.popleft()\n\n    # Check if current position is adjacent to the primitive and facing it correctly\n    dr_to_prim = primitive_r - curr_r\n    dc_to_prim = primitive_c - curr_c\n    manhattan_dist_to_prim = abs(dr_to_prim) + abs(dc_to_prim)\n\n    if manhattan_dist_to_prim == 1:  # We are adjacent to the primitive\n      required_dir_to_face = -1\n      if dr_to_prim == -1:\n        required_dir_to_face = _NORTH\n      elif dr_to_prim == 1:\n        required_dir_to_face = _SOUTH\n      elif dc_to_prim == -1:\n        required_dir_to_face = _WEST\n      elif dc_to_prim == 1:\n        required_dir_to_face = _EAST\n\n      if curr_d == required_dir_to_face:\n        # Found the target state: adjacent and facing the primitive\n        final_actions = actions_so_far + [_ACTIONS[\"USE\"]]\n        break # Path found, exit BFS\n\n    # Explore possible next states (movements)\n    for action_name, action_val in _ACTIONS.items():\n      if action_name == \"USE\":\n        continue # USE action is only the final step\n\n      # Calculate new position and direction after the movement action\n      # Assuming movement actions (UP, DOWN, LEFT, RIGHT) make the agent face\n      # the direction of movement.\n      target_dir_for_move = _MOVE_ACTION_TO_FACE_DIR[action_val]\n      dr, dc = _DIR_VEC[target_dir_for_move]\n\n      next_r, next_c = curr_r + dr, curr_c + dc\n      next_d = target_dir_for_move # Agent's new facing direction\n\n      # Check if the new position is an obstacle\n      if is_obstacle(next_r, next_c, grid, non_grabbable_indices, WIDTH, HEIGHT):\n        continue # This movement is blocked\n\n      next_state_tuple = (next_r, next_c, next_d)\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple)\n        new_actions_list = actions_so_far + [action_val]\n        queue.append((next_state_tuple, new_actions_list))\n\n  return final_actions if final_actions is not None else []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:00:11.459646", "function_name": "collect", "function_body": "    import collections\n\n    # Get action mappings from the environment\n    action_map = env.action_specs()\n    MOVE_UP = action_map['UP']\n    MOVE_DOWN = action_map['DOWN']\n    MOVE_LEFT = action_map['LEFT']\n    MOVE_RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    current_state = env._current_state\n\n    # Check if the primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid_height, grid_width = current_state.grid.shape[:2]\n    initial_pos = current_state.pos\n    world = current_state.world\n    non_grabbable_indices = world.non_grabbable_indices\n\n    # Find all locations where the primitive exists on the grid\n    primitive_locations = []\n    for r in range(grid_height):\n        for c in range(grid_width):\n            if current_state.grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    # If the primitive is not found anywhere on the map, return empty path\n    if not primitive_locations:\n        return []\n\n    # BFS Initialization\n    # Queue stores tuples of (current_position, actions_taken_to_reach_here)\n    queue = collections.deque([(initial_pos, [])])\n    # Visited set stores (row, col) tuples to avoid redundant exploration and cycles\n    visited = {initial_pos}\n\n    # Define movement deltas for actions\n    move_deltas = {\n        MOVE_UP: (-1, 0),\n        MOVE_DOWN: (1, 0),\n        MOVE_LEFT: (0, -1),\n        MOVE_RIGHT: (0, 1)\n    }\n\n    while queue:\n        current_pos, path = queue.popleft()\n\n        # Check if the current position is within the 3x3 neighborhood of any primitive location\n        # If so, the agent can use the 'USE' action from this position.\n        # The 'next_to' description implies Chebyshev distance <= 1.\n        for p_r, p_c in primitive_locations:\n            # Important: Check if the primitive is still present at this location in the grid.\n            # This handles cases where the primitive might have been collected or removed by other means.\n            if current_state.grid[p_r, p_c, primitive] > 0:\n                dist_r = abs(current_pos[0] - p_r)\n                dist_c = abs(current_pos[1] - p_c)\n\n                if dist_r <= 1 and dist_c <= 1:\n                    # Found a position from which the primitive can be collected\n                    return path + [USE]\n\n        # Explore possible next moves\n        for action, (dr, dc) in move_deltas.items():\n            next_pos_r, next_pos_c = current_pos[0] + dr, current_pos[1] + dc\n            next_pos = (next_pos_r, next_pos_c)\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= next_pos_r < grid_height and 0 <= next_pos_c < grid_width):\n                continue\n\n            # Check walkability: agent cannot move into a cell containing a non-grabbable item\n            is_blocked = False\n            for kind_idx in non_grabbable_indices:\n                if current_state.grid[next_pos_r, next_pos_c, kind_idx] > 0:\n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue\n\n            # If the next position has not been visited, add it to the queue\n            if next_pos not in visited:\n                visited.add(next_pos)\n                queue.append((next_pos, path + [action]))\n\n    # If the queue becomes empty and no path to collect the primitive is found\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:02:18.329125", "function_name": "collect", "function_body": "    # Action mapping constants\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Direction vectors for movement actions (dx, dy)\n    # Maps action ID to the change in (x, y) coordinates\n    MOVE_DELTAS = {\n        UP: (0, -1),   # Move North (decreases y)\n        DOWN: (0, 1),    # Move South (increases y)\n        LEFT: (-1, 0),   # Move West (decreases x)\n        RIGHT: (1, 0),   # Move East (increases x)\n    }\n\n    # Agent direction mapping (from CraftState.dir attribute)\n    # Maps internal direction integer (0=N, 1=E, 2=S, 3=W) to its (dx, dy) vector\n    AGENT_DIR_VECTORS = {\n        0: (0, -1),  # North\n        1: (1, 0),   # East\n        2: (0, 1),   # South\n        3: (-1, 0),  # West\n    }\n\n    # Mapping relative position delta (from agent to object) to the agent's required facing direction (CraftState.dir integer)\n    # This determines which way the agent must be facing to use an object at a given relative position.\n    RELATIVE_POS_TO_AGENT_ACTION_DIR = {\n        (0, -1): 0,  # Object is North relative to agent, agent must face North (dir 0)\n        (1, 0): 1,   # Object is East relative to agent, agent must face East (dir 1)\n        (0, 1): 2,   # Object is South relative to agent, agent must face South (dir 2)\n        (-1, 0): 3,  # Object is West relative to agent, agent must face West (dir 3)\n    }\n\n    # Get current state from the environment's internal representation\n    state = env._current_state \n    \n    # Get grid dimensions (height, width) and agent's current position (start_x, start_y)\n    height, width, _ = state.grid.shape\n    start_x, start_y = state.pos\n    \n    # Find all locations on the grid where the target primitive is present\n    primitive_locations = []\n    for y in range(height):\n        for x in range(width):\n            if state.grid[y, x, primitive] == 1:\n                primitive_locations.append((x, y))\n    \n    # If the primitive is not found anywhere on the grid, return an empty action list\n    if not primitive_locations:\n        return []\n\n    # Use Breadth-First Search (BFS) to find the shortest path to a cell that is\n    # *cardinally adjacent* to any primitive location. This is because the 'USE'\n    # action typically applies to cells directly North, South, East, or West of the agent.\n    \n    # BFS queue: stores tuples of (current_x, current_y, list_of_actions_taken_to_reach_here)\n    # Assumes collections.deque is available (standard library import).\n    queue = __import__('collections').deque([(start_x, start_y, [])]) \n    \n    # Set to keep track of visited (x, y) coordinates to prevent loops and redundant exploration\n    visited = {(start_x, start_y)}\n    \n    # Variables to store the shortest path found and the specific primitive location it targets\n    best_path_to_cardinal_adj_cell = None\n    target_cardinal_primitive_loc = None\n\n    while queue:\n        curr_x, curr_y, path_actions = queue.popleft()\n\n        # Check if the current cell is cardinally adjacent to any primitive location\n        is_cardinal_adjacent_to_primitive = False\n        potential_target_primitive_loc = None\n        for px, py in primitive_locations:\n            # Check for cardinal adjacency (not diagonal, not on top)\n            if ((abs(curr_x - px) == 1 and curr_y == py) or \n                (abs(curr_y - py) == 1 and curr_x == px)):\n                is_cardinal_adjacent_to_primitive = True\n                potential_target_primitive_loc = (px, py)\n                break # Found a primitive, no need to check others for this cell\n            \n        if is_cardinal_adjacent_to_primitive:\n            # If the current cell is cardinally adjacent, we've found the shortest path\n            # to such a cell due to BFS property. Store it and break.\n            best_path_to_cardinal_adj_cell = path_actions\n            target_cardinal_primitive_loc = potential_target_primitive_loc\n            break \n\n        # Explore neighboring cells (UP, DOWN, LEFT, RIGHT movements)\n        for action_val, (dx, dy) in MOVE_DELTAS.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n\n            # Boundary check: ensure the next cell is within the grid limits\n            if not (0 <= next_x < width and 0 <= next_y < height):\n                continue\n            \n            # Check if this cell has already been visited in this BFS traversal\n            if (next_x, next_y) in visited:\n                continue\n\n            # Check if the next cell is walkable. A cell is walkable if it does not\n            # contain any \"non-grabbable\" items (e.g., walls, certain structures).\n            # Agent can typically walk on empty cells or cells containing \"grabbable\" items.\n            is_walkable = True\n            for k_idx in state.world.non_grabbable_indices:\n                if state.grid[next_y, next_x, k_idx] == 1:\n                    is_walkable = False\n                    break\n            \n            if is_walkable:\n                visited.add((next_x, next_y))\n                queue.append(((next_x, next_y), path_actions + [action_val]))\n\n    # If no path to a cardinally adjacent primitive was found (e.g., all are blocked)\n    if best_path_to_cardinal_adj_cell is None:\n        return [] \n\n    # At this point, `best_path_to_cardinal_adj_cell` contains the movement actions\n    # to reach a cell next to the primitive. These movements do not change the agent's\n    # facing direction (`state.dir`). We now need to add turning actions and the USE action.\n\n    # Agent's current facing direction before any new actions in this sequence\n    current_agent_dir = state.dir \n\n    # Simulate the movement path to determine the agent's final position after moving\n    final_agent_x, final_agent_y = start_x, start_y\n    for action in best_path_to_cardinal_adj_cell:\n        dx, dy = MOVE_DELTAS[action]\n        final_agent_x += dx\n        final_agent_y += dy\n    \n    # Calculate the relative position vector from the agent's final position to the target primitive\n    relative_x = target_cardinal_primitive_loc[0] - final_agent_x\n    relative_y = target_cardinal_primitive_loc[1] - final_agent_y\n    \n    # Determine the required facing direction for the agent to 'USE' the primitive\n    # This will be one of the cardinal directions (0-3) as per RELATIVE_POS_TO_AGENT_ACTION_DIR\n    target_facing_direction_index = RELATIVE_POS_TO_AGENT_ACTION_DIR.get((relative_x, relative_y))\n    \n    # This should not be None if the BFS correctly found a cardinally adjacent target.\n    # If it is, it indicates a logic error or an environment assumption violation.\n    if target_facing_direction_index is None:\n        return [] \n\n    # Calculate turn actions required to align the agent's direction with the target primitive\n    turn_actions = []\n    # Calculate difference, ensuring it's positive and within 0-3 (representing 0, 90, 180, 270 degrees clockwise)\n    dir_diff = (target_facing_direction_index - current_agent_dir + 4) % 4\n    \n    if dir_diff == 1: # 90 degrees clockwise (e.g., from North to East)\n        turn_actions.append(RIGHT)\n    elif dir_diff == 2: # 180 degrees (e.g., from North to South)\n        # For 180 degrees, two RIGHT turns or two LEFT turns are equivalent in length. We choose two RIGHTs.\n        turn_actions.extend([RIGHT, RIGHT])\n    elif dir_diff == 3: # 270 degrees clockwise / 90 degrees counter-clockwise (e.g., from North to West)\n        turn_actions.append(LEFT)\n    # If dir_diff is 0, no turns are needed\n\n    # Combine all actions: movement path + turning actions + the 'USE' action\n    return best_path_to_cardinal_adj_cell + turn_actions + [USE]", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:02:18.409476", "function_name": "collect", "function_body": "    from collections import deque\n\n    # Define action mappings based on environment's action_specs\n    action_ids = env.action_specs()\n    DOWN = action_ids[\"DOWN\"]\n    UP = action_ids[\"UP\"]\n    LEFT = action_ids[\"LEFT\"]\n    RIGHT = action_ids[\"RIGHT\"]\n    USE = action_ids[\"USE\"]\n\n    # Define movement offsets for BFS (dr, dc)\n    MOVEMENT_OFFSETS = {\n        DOWN: (1, 0),\n        UP: (-1, 0),\n        LEFT: (0, -1),\n        RIGHT: (0, 1)\n    }\n\n    # Get the initial state directly from the environment\n    initial_state = env._current_state\n\n    # 1. Check if the primitive is already in inventory\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    # 2. Check if the primitive is immediately usable (next to agent)\n    # The `next_to` method checks a 3x3 neighborhood, which implies being adjacent\n    # for collection via the 'USE' action.\n    if initial_state.next_to(primitive):\n        return [USE]\n\n    # 3. Plan a path using Breadth-First Search (BFS)\n    initial_pos = initial_state.pos\n    initial_grid = initial_state.grid\n    world = initial_state.world\n    \n    # Get indices of entities that cannot be walked upon (obstacles)\n    non_walkable_indices = world.non_grabbable_indices \n\n    grid_height, grid_width, num_kinds = initial_grid.shape\n\n    # BFS queue: stores (current_row, current_col, list_of_actions_to_reach_here)\n    q = deque([(initial_pos[0], initial_pos[1], [])])\n    # Visited set: stores (row, col) tuples to avoid cycles and redundant exploration\n    visited = {(initial_pos[0], initial_pos[1])}\n\n    path_to_primitive_adj_cell = None\n\n    while q:\n        r, c, path = q.popleft()\n\n        # Check if the current cell (r, c) is adjacent to the primitive.\n        # If it is, then we can perform the 'USE' action from this cell.\n        # We check the four cardinal neighbors.\n        for dr_adj, dc_adj in [(1, 0), (-1, 0), (0, -1), (0, 1)]:\n            nr_adj, nc_adj = r + dr_adj, c + dc_adj\n            \n            # Check bounds for the primitive's potential location\n            if 0 <= nr_adj < grid_height and 0 <= nc_adj < grid_width:\n                # If the neighbor cell contains the primitive, then (r,c) is a goal state for movement\n                if initial_grid[nr_adj, nc_adj, primitive] > 0:\n                    path_to_primitive_adj_cell = path\n                    break # Found the shortest path to an adjacent cell\n        \n        if path_to_primitive_adj_cell is not None:\n            break # Exit BFS if a path to an adjacent cell is found\n\n        # If not yet at a goal, explore possible movement actions from (r, c)\n        for action_id, (dr_move, dc_move) in MOVEMENT_OFFSETS.items():\n            nr_move, nc_move = r + dr_move, c + dc_move\n\n            # Check bounds for the new agent position\n            if not (0 <= nr_move < grid_height and 0 <= nc_move < grid_width):\n                continue\n\n            # Check if the new position (nr_move, nc_move) is walkable (not an obstacle)\n            # A cell is considered an obstacle if it contains ANY kind that is in non_walkable_indices.\n            is_walkable = True\n            for k_idx in range(num_kinds): \n                if initial_grid[nr_move, nc_move, k_idx] > 0 and k_idx in non_walkable_indices:\n                    is_walkable = False\n                    break\n            \n            if not is_walkable:\n                continue # Cannot move into an obstacle cell\n\n            new_pos_tuple = (nr_move, nc_move)\n            if new_pos_tuple not in visited:\n                visited.add(new_pos_tuple)\n                q.append((nr_move, nc_move, path + [action_id]))\n\n    if path_to_primitive_adj_cell is not None:\n        # A path was found to a cell from which the primitive can be used.\n        # Append the 'USE' action to the movement path.\n        return path_to_primitive_adj_cell + [USE]\n    else:\n        # The primitive was not found or is unreachable from the initial position.\n        return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:03:37.871567", "function_name": "collect", "function_body": "  import collections\n  # numpy is implicitly available from top-level imports and used as np\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global']\n  \n  WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape\n\n  # Extract and convert current agent state from normalized features\n  current_px = int(round(features_dict['pos'][0] * (WIDTH - 1)))\n  current_py = int(round(features_dict['pos'][1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Agent's current direction (one-hot to int: 0=N, 1=E, 2=S, 3=W)\n  # Assuming agent's direction does not change from cardinal movement actions (_UP, _DOWN, _LEFT, _RIGHT).\n  # If there are no explicit turning actions, this initial direction is the one fixed for the entire path.\n  current_dir = np.argmax(features_dict['direction']) \n\n  # Check if the primitive is grabbable. If not, it cannot be collected via this method.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Define possible cardinal movements (dx, dy) for pathfinding and their corresponding actions\n  move_deltas = [(0, -1), (0, 1), (-1, 0), (1, 0)] # North, South, West, East\n  move_actions = [_UP, _DOWN, _LEFT, _RIGHT]\n\n  # Helper function to check for obstacles\n  non_grabbable_indices = env.world.non_grabbable_indices\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle).\"\"\"\n    # Ensures pathfinding avoids non-grabbable entities\n    for k in non_grabbable_items_set:\n      if grid[x, y, k] == 1:\n        return True\n    return False\n\n  # Mapping from (dx, dy) vector (from agent's position to item's position) to cardinal direction\n  # This is used to determine which way the agent needs to face if _USE is directional.\n  direction_deltas = {\n      (0, -1): 0, # North (item is one square up)\n      (1, 0): 1,  # East (item is one square right)\n      (0, 1): 2,  # South (item is one square down)\n      (-1, 0): 3, # West (item is one square left)\n  }\n\n  # Breadth-First Search (BFS) for the shortest path\n  q = collections.deque()\n  q.append(current_pos) \n  \n  # To reconstruct the path: maps child_pos -> (parent_pos, action_taken_to_reach_child)\n  parent_map = {current_pos: (None, None)} \n  \n  # To avoid revisiting cells\n  visited = {current_pos} \n\n  # Target positions for interaction\n  final_approach_pos = None # The cell the agent will move to before performing _USE\n  item_pos_for_use = None   # The actual position of the primitive being targeted\n\n  while q:\n    cx, cy = q.popleft()\n\n    # Priority 1: Check if the primitive is at the agent's current position (for direct pickup)\n    if current_grid[cx, cy, primitive] == 1:\n      final_approach_pos = (cx, cy)\n      item_pos_for_use = (cx, cy)\n      break # Shortest path found directly to the item\n\n    # Priority 2: Check if any adjacent cell contains the primitive (for directional interaction)\n    for dx_adj, dy_adj in move_deltas: # Iterate through direct neighbors\n        nx_adj, ny_adj = cx + dx_adj, cy + dy_adj\n\n        # Check boundaries for the adjacent cell\n        if not (0 <= nx_adj < WIDTH and 0 <= ny_adj < HEIGHT):\n            continue\n        \n        # If the adjacent cell contains the primitive\n        if current_grid[nx_adj, ny_adj, primitive] == 1:\n            final_approach_pos = (cx, cy) # Agent needs to move to (cx,cy) to interact with (nx_adj,ny_adj)\n            item_pos_for_use = (nx_adj, ny_adj)\n            break # Shortest path found to an adjacent cell for interaction\n\n    if final_approach_pos is not None:\n        break # Target found, exit BFS\n\n    # Explore valid neighbors for pathfinding\n    for (dx, dy), action in zip(move_deltas, move_actions):\n      nx, ny = cx + dx, cy + dy\n\n      # Check validity: within bounds, not visited, and not an obstacle\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n      if (nx, ny) in visited:\n        continue\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n\n      # If valid, add to queue and record parent\n      q.append(((nx, ny)))\n      visited.add((nx, ny))\n      parent_map[(nx, ny)] = ((cx, cy), action)\n\n  actions_to_take = []\n  if final_approach_pos is not None:\n    # Reconstruct the path by backtracking from the final approach position\n    path_reconstruction_reversed = []\n    current = final_approach_pos\n    \n    while parent_map[current][0] is not None: # Stop when current is the start_pos (parent is None)\n      parent, action = parent_map[current]\n      path_reconstruction_reversed.append(action)\n      current = parent\n    \n    actions_to_take = path_reconstruction_reversed[::-1] # Reverse to get actions in forward order\n\n    # Determine final _USE action and required turns (if any)\n    if final_approach_pos == item_pos_for_use:\n        # Agent is on the primitive's square (direct pickup).\n        # Assuming _USE on the current square does not require specific facing.\n        actions_to_take.append(_USE)\n    else:\n        # Agent is adjacent to the primitive. It needs to face it to _USE.\n        # Calculate the vector from agent's final approach position to the item's position\n        dx_face = item_pos_for_use[0] - final_approach_pos[0]\n        dy_face = item_pos_for_use[1] - final_approach_pos[1]\n        \n        target_dir_idx = direction_deltas.get((dx_face, dy_face))\n\n        # IMPORTANT IMPROVEMENT FOR V2:\n        # Check if the agent is already facing the correct direction.\n        # If the environment does not provide explicit turning actions (like TURN_LEFT/TURN_RIGHT),\n        # the agent's direction from `current_dir` is fixed throughout the path.\n        # If the agent is not facing the right way and cannot turn, this collection is impossible.\n        if target_dir_idx is not None and current_dir == target_dir_idx:\n            # Agent is already facing the correct direction relative to the item\n            actions_to_take.append(_USE)\n        else:\n            # Agent is adjacent but not facing the correct direction, and no turn actions are available.\n            # Thus, this item cannot be collected from this position/orientation.\n            # Clear the planned actions as the task is impossible to complete this way.\n            return [] # Returning an empty list signifies uncollectable due to orientation\n\n  return actions_to_take", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:03:38.864410", "function_name": "collect", "function_body": "  import collections\n  # numpy is implicitly available from top-level imports and used as np\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Define constants for clarity\n  _MOVE_DELTAS = [(0, -1), (0, 1), (-1, 0), (1, 0)] # North, South, West, East\n  _MOVE_ACTIONS = [_UP, _DOWN, _LEFT, _RIGHT]\n\n  # Mapping from (dx, dy) to cardinal direction (int 0-3) for agent facing\n  # (dx, dy) represents the vector from agent's position to the item's position\n  _DIRECTION_DELTAS = {\n      (0, -1): 0, # North (dx=0, dy=-1)\n      (1, 0): 1,  # East (dx=1, dy=0)\n      (0, 1): 2,  # South (dx=0, dy=1)\n      (-1, 0): 3, # West (dx=-1, dy=0)\n  }\n\n  def _get_agent_and_grid_info(env):\n    \"\"\"Extracts current agent position, direction, grid, and dimensions.\"\"\"\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    \n    current_grid = features_dict['features_global']\n    WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape\n\n    current_pos_normalized = features_dict['pos']\n    current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n    current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n    current_pos = (current_px, current_py)\n\n    current_dir = np.argmax(features_dict['direction']) \n    return current_grid, current_pos, current_dir, WIDTH, HEIGHT, N_KINDS\n\n  def _is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle).\"\"\"\n    # Boundary check is usually handled by the caller (BFS loop)\n    for k in non_grabbable_items_set:\n      if grid[x, y, k] == 1:\n        return True\n    return False\n\n  def _find_path_to_primitive(start_pos, primitive_kind, grid, non_grabbable_indices, width, height, move_deltas, move_actions):\n    \"\"\"\n    Performs BFS to find the shortest path to a cell containing or adjacent to the primitive.\n    Returns (final_approach_pos, item_pos_for_use, parent_map) or (None, None, None) if not found.\n    \"\"\"\n    q = collections.deque()\n    q.append(start_pos) \n    \n    parent_map = {start_pos: (None, None)} # child_pos -> (parent_pos, action_taken_to_reach_child)\n    visited = {start_pos} \n\n    final_approach_pos = None \n    item_pos_for_use = None   \n\n    while q:\n      cx, cy = q.popleft()\n\n      # Priority 1: Agent lands directly on the primitive\n      if grid[cx, cy, primitive_kind] == 1:\n        final_approach_pos = (cx, cy)\n        item_pos_for_use = (cx, cy)\n        break \n\n      # Priority 2: Agent is adjacent to the primitive\n      for dx_adj, dy_adj in move_deltas: \n          nx_adj, ny_adj = cx + dx_adj, cy + dy_adj\n\n          if not (0 <= nx_adj < width and 0 <= ny_adj < height):\n              continue\n          \n          if grid[nx_adj, ny_adj, primitive_kind] == 1:\n              final_approach_pos = (cx, cy)\n              item_pos_for_use = (nx_adj, ny_adj)\n              break \n      \n      if final_approach_pos is not None:\n          break \n\n      # Explore neighbors\n      for (dx, dy), action in zip(move_deltas, move_actions):\n        nx, ny = cx + dx, cy + dy\n\n        if not (0 <= nx < width and 0 <= ny < height):\n          continue\n        if (nx, ny) in visited:\n          continue\n        if _is_obstacle(nx, ny, grid, non_grabbable_indices):\n          continue\n\n        q.append(((nx, ny)))\n        visited.add((nx, ny))\n        parent_map[(nx, ny)] = ((cx, cy), action)\n    \n    return final_approach_pos, item_pos_for_use, parent_map\n\n  def _get_actions_for_collection(parent_map, final_approach_pos, item_pos_for_use, initial_dir, action_map, direction_deltas):\n    \"\"\"\n    Reconstructs the path from parent_map and adds turn/USE actions.\n    \"\"\"\n    actions = []\n    if final_approach_pos is None:\n        return actions # Primitive not found or unreachable\n\n    # Reconstruct path movements\n    path_reconstruction_reversed = []\n    current = final_approach_pos\n    while parent_map[current][0] is not None:\n      parent, action = parent_map[current]\n      path_reconstruction_reversed.append(action)\n      current = parent\n    actions.extend(path_reconstruction_reversed[::-1])\n\n    # Add USE action and necessary turns\n    if final_approach_pos == item_pos_for_use:\n        # Agent is on the primitive, direct pickup\n        actions.append(action_map['USE'])\n    else:\n        # Agent is adjacent, needs to turn and use\n        dx_face = item_pos_for_use[0] - final_approach_pos[0]\n        dy_face = item_pos_for_use[1] - final_approach_pos[1]\n        \n        target_dir_idx = direction_deltas.get((dx_face, dy_face))\n\n        if target_dir_idx is not None:\n            current_dir_at_final_pos = (initial_dir + len(actions)) % 4 # Assuming each move action changes direction if it's not a direct 'move' action. THIS IS A POTENTIAL BUG. Agent direction does NOT change just by moving unless it's a specific turn action. The initial_dir should be passed to this function.\n            # FIX: The `initial_dir` passed to this function is the direction *before* any actions are taken.\n            # The agent's direction only changes if a _LEFT or _RIGHT action is executed.\n            # We need to simulate the agent's direction as it executes the path movements.\n            \n            # Recalculate current_dir_at_final_pos by simulating path actions\n            simulated_dir = initial_dir\n            for action in actions:\n                if action == action_map['LEFT']:\n                    simulated_dir = (simulated_dir - 1 + 4) % 4\n                elif action == action_map['RIGHT']:\n                    simulated_dir = (simulated_dir + 1) % 4\n            current_dir_at_final_pos = simulated_dir\n\n            diff_dir = (target_dir_idx - current_dir_at_final_pos + 4) % 4\n            \n            if diff_dir == 1: \n                actions.append(action_map['RIGHT'])\n            elif diff_dir == 2: \n                actions.extend([action_map['RIGHT'], action_map['RIGHT']])\n            elif diff_dir == 3: \n                actions.append(action_map['LEFT'])\n        \n        actions.append(action_map['USE'])\n    \n    return actions\n\n  # Main logic for collect_v2\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  current_grid, current_pos, current_dir, WIDTH, HEIGHT, N_KINDS = _get_agent_and_grid_info(env)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  final_approach_pos, item_pos_for_use, parent_map = _find_path_to_primitive(\n      current_pos, primitive, current_grid, non_grabbable_indices, \n      WIDTH, HEIGHT, _MOVE_DELTAS, _MOVE_ACTIONS\n  )\n\n  actions_to_take = _get_actions_for_collection(\n      parent_map, final_approach_pos, item_pos_for_use, current_dir, _actions_map, _DIRECTION_DELTAS\n  )\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:04:54.245279", "function_name": "collect", "function_body": "    import collections\n\n    # Define actions as constants, assuming these numerical values based on `action_specs`\n    # (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Mapping from action index to (dr, dc) deltas for grid movement\n    ACTION_DELTAS = {\n        DOWN: (1, 0),   # Row increases (move down)\n        UP: (-1, 0),    # Row decreases (move up)\n        LEFT: (0, -1),  # Column decreases (move left)\n        RIGHT: (0, 1),  # Column increases (move right)\n    }\n\n    # Get current state information from the environment\n    # env is a CraftLab instance, _current_state is a CraftState instance.\n    current_state = env._current_state\n    grid = current_state.grid\n    agent_pos_r, agent_pos_c = current_state.pos\n    inventory = current_state.inventory\n\n    # Get environment properties from CraftWorld instance\n    # env.world is a CraftWorld instance.\n    # grid.shape gives (WIDTH, HEIGHT, n_kinds)\n    width, height, _ = grid.shape\n    # env.world.environment contains indices of non-grabbable entities that act as obstacles.\n    environment_obstacle_indices = env.world.environment\n\n    # 1. Check if the primitive is already collected\n    if inventory[primitive] > 0:\n        return []  # Already have the primitive, no actions needed.\n\n    # 2. Find all locations on the grid where the primitive exists\n    primitive_locations = set()  # Use a set for efficient lookup\n    for r_idx in range(width):\n        for c_idx in range(height):\n            if grid[r_idx, c_idx, primitive] == 1.0:\n                primitive_locations.add((r_idx, c_idx))\n\n    if not primitive_locations:\n        return []  # Primitive not found on the grid, cannot collect.\n\n    # Helper function to check if a cell is walkable.\n    # Defined inside the main function to adhere to the \"only return code within the function\" rule.\n    def _is_walkable_cell(r, c):\n        # Check bounds\n        if not (0 <= r < width and 0 <= c < height):\n            return False\n        # Check if the cell contains any obstacle from environment_obstacle_indices\n        for obs_idx in environment_obstacle_indices:\n            if grid[r, c, obs_idx] == 1.0:\n                return False  # Contains an un-walkable environment obstacle\n        return True\n\n    # 3. BFS to find the shortest path to a cell *adjacent* to the primitive\n    # Queue stores tuples: (current_position_tuple (r,c), list_of_actions_to_reach_here)\n    q = collections.deque([((agent_pos_r, agent_pos_c), [])])\n    visited = {(agent_pos_r, agent_pos_c)}  # Set of visited (row, col) positions\n\n    while q:\n        (current_r, current_c), path_so_far = q.popleft() # Get current position and path\n\n        # Check if the current position is adjacent to any primitive location.\n        # If it is, this means we've found our target position just before the 'USE' action.\n        for dr, dc in ACTION_DELTAS.values(): # Iterate over all possible movement directions (deltas)\n            adj_r, adj_c = current_r + dr, current_c + dc\n            if (adj_r, adj_c) in primitive_locations:\n                # We found a path to a cell adjacent to the primitive.\n                # Append the USE action and return the complete sequence.\n                return path_so_far + [USE]\n\n        # If not adjacent to a primitive, explore walkable neighbors for further movement\n        for action_val, (dr, dc) in ACTION_DELTAS.items():\n            next_r, next_c = current_r + dr, current_c + dc\n            next_pos = (next_r, next_c)\n\n            if _is_walkable_cell(next_r, next_c) and next_pos not in visited:\n                visited.add(next_pos)\n                q.append((next_pos, path_so_far + [action_val]))\n\n    # If the BFS completes and the queue becomes empty without finding a path,\n    # it means the primitive is unreachable.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:04:54.316331", "function_name": "collect", "function_body": "    current_state = env._current_state  # Get the initial CraftState\n\n    # Check if the primitive is already collected in the inventory\n    if current_state.inventory[primitive] > 0:\n        return []  # Already collected, no actions needed\n\n    # Get grid dimensions (assuming (HEIGHT, WIDTH, KINDS) for grid.shape)\n    grid = current_state.grid\n    HEIGHT, WIDTH, _ = grid.shape\n\n    start_pos = current_state.pos  # Agent's starting position (row, col)\n\n    # BFS queue: stores tuples of (current_agent_position, actions_path_to_here)\n    # Using a list as a queue and pop(0) as `collections.deque` import is not allowed.\n    Q = [(start_pos, [])]\n    \n    # Visited set: stores (row, col) tuples to avoid re-visiting positions and prevent cycles\n    visited = {start_pos}\n\n    # Action deltas mapping action integer to (delta_row, delta_col)\n    # Based on the problem's action_specs: DOWN\u21920, UP\u21921, LEFT\u21922, RIGHT\u21923, USE\u21924\n    # (delta_row, delta_col):\n    # UP (1): row - 1, col\n    # DOWN (0): row + 1, col\n    # LEFT (2): row, col - 1\n    # RIGHT (3): row, col + 1\n    action_deltas = {\n        1: (-1, 0),  # UP\n        0: (1, 0),   # DOWN\n        2: (0, -1),  # LEFT\n        3: (0, 1)    # RIGHT\n    }\n    \n    _USE_ACTION = 4 # Explicitly define USE action value\n\n    # Perform BFS to find the shortest path\n    while Q:\n        current_agent_pos, path_to_here = Q.pop(0)  # Dequeue the oldest state\n        r, c = current_agent_pos\n\n        # Check if the current position is \"next to\" (adjacent to) the primitive.\n        # This means one of the 4 cardinal neighbors of the current position contains the primitive.\n        # Iterate through possible neighbor relative coordinates\n        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Up, Down, Left, Right neighbors\n            neighbor_r, neighbor_c = r + dr, c + dc\n            \n            # Check if the neighbor cell is within grid boundaries\n            if 0 <= neighbor_r < HEIGHT and 0 <= neighbor_c < WIDTH:\n                # Check if this neighbor cell contains the target primitive\n                if grid[neighbor_r, neighbor_c, primitive] > 0:\n                    # Found a path to a position from which the agent can USE the primitive.\n                    # The full sequence of actions is the path taken to reach this position\n                    # plus the final USE action.\n                    return path_to_here + [_USE_ACTION]\n\n        # If not adjacent to the primitive, explore possible moves from the current position\n        for action_val, (dr, dc) in action_deltas.items():\n            next_r, next_c = r + dr, c + dc\n            next_agent_pos = (next_r, next_c)\n\n            # Check if the next position is within grid boundaries\n            if 0 <= next_r < HEIGHT and 0 <= next_c < WIDTH:\n                # Ensure the next position has not been visited to avoid redundant paths and cycles\n                if next_agent_pos not in visited:\n                    visited.add(next_agent_pos)  # Mark as visited\n                    # Enqueue the new state (next position and updated path)\n                    Q.append((next_agent_pos, path_to_here + [action_val]))\n\n    # If the BFS queue becomes empty and no path to the primitive was found,\n    # it means the primitive is unreachable or not present on the grid.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:06:03.097915", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Maximum number of steps allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent,\n      based on CraftState.dir (0=East, 1=South, 2=West, 3=North).\n      \"\"\"\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return (y, x) # Fallback, should not be reached with valid directions\n\n  actions_taken = []\n\n  # Access the underlying CraftState instance to get the current state information.\n  current_state = env._current_state\n\n  # Pre-checks: If the primitive is unknown, not grabbable, or already in inventory, no action is needed.\n  if primitive not in current_state.world.cookbook.kinds:\n      return [] # The primitive ID is not recognized within the world's known kinds.\n\n  if primitive not in current_state.world.grabbable_indices:\n      # If it's not a grabbable item, it cannot be collected via ACTION_USE.\n      return []\n\n  if current_state.inventory[primitive] > 0:\n      return [] # The agent already possesses the primitive.\n\n  if MAX_COLLECT_STEPS <= 0:\n      return [] # No steps allowed for collection.\n\n  # Retrieve necessary environment information for pathfinding.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, n_kinds = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir \n\n  # Pre-calculate an impassable mask for efficient checking of traversable cells.\n  # Create a boolean mask where True indicates an impassable kind.\n  impassable_mask = np.zeros(n_kinds, dtype=bool)\n\n  # Water is typically impassable for movement.\n  if current_state.world.water_index in current_state.world.kinds and current_state.world.water_index < n_kinds:\n      impassable_mask[current_state.world.water_index] = True\n  \n  # Any non-grabbable items that are NOT workshops are generally impassable.\n  # Workshops (e.g., crafting tables) are usually traversable, even if not grabbable.\n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in current_state.world.workshop_indices:\n          if k_idx < n_kinds: # Ensure index is within bounds of the grid's kind dimension\n              impassable_mask[k_idx] = True\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # The resulting direction must match CraftState.dir's mapping (0=East, 1=South, 2=West, 3=North).\n  movement_actions_map = {\n      ACTION_UP:    (DIR_NORTH, -1, 0),   # Move North (dy=-1, dx=0), new dir=DIR_NORTH (3)\n      ACTION_DOWN:  (DIR_SOUTH, 1, 0),    # Move South (dy=1, dx=0), new dir=DIR_SOUTH (1)\n      ACTION_LEFT:  (DIR_WEST, 0, -1),    # Move West (dy=0, dx=-1), new dir=DIR_WEST (2)\n      ACTION_RIGHT: (DIR_EAST, 0, 1)      # Move East (dy=0, dx=1), new dir=DIR_EAST (0)\n  }\n\n  q = collections.deque()\n  # BFS queue state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  q.append((start_y, start_x, start_dir, []))\n  \n  # Keep track of visited states to prevent redundant exploration and infinite loops.\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None\n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Pruning: If the current path length already exceeds MAX_COLLECT_STEPS, prune this branch.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # Calculate the coordinates of the grid cell that the agent is currently facing.\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Check if the facing cell is within grid boundaries and contains the target primitive.\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n          full_grid[facing_y, facing_x, primitive] > 0):\n\n          # We've found a suitable position and orientation. Append ACTION_USE.\n          candidate_path = path + [ACTION_USE]\n\n          # Ensure the complete path (including ACTION_USE) is within the step limit.\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              break # Found the shortest path, exit BFS.\n\n      # Explore all possible next states from the current state.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Pruning: If this move makes the path too long (considering potential final USE action).\n          if len(path) + 1 >= MAX_COLLECT_STEPS: # +1 for the movement itself\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Efficiently check if the next cell is traversable using the pre-calculated mask.\n          # `np.any(full_grid[next_y, next_x, impassable_mask])` will be True if any impassable kind\n          # is present at the target cell.\n          if np.any(full_grid[next_y, next_x, impassable_mask]):\n              continue\n\n          # Check if this new (position, direction) state has already been visited.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # Add the new state to the queue for further exploration.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      return [] # No valid path was found.\n\n  for action in path_to_execute:\n      # Stop executing if the total number of steps exceeds the limit\n      if len(actions_taken) >= MAX_COLLECT_STEPS:\n          break \n      \n      # Check if the primitive is already collected (could happen if environment is dynamic\n      # or initial inventory check was not enough for multi-step tasks).\n      if current_state.inventory[primitive] > 0:\n          break\n\n      actions_taken.append(action)\n      reward, done, _ = env.step(action)\n      current_state = env._current_state # Update state after the step\n\n      # Check for early termination of the episode.\n      # If `done` is True and the primitive is still not collected, it means\n      # the goal could not be achieved within the episode limits.\n      if done and current_state.inventory[primitive] == 0:\n          return [] \n\n  # Final check after executing all actions in `path_to_execute`.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # This case should ideally not be reached if the BFS path was valid and\n      # environment mechanics are consistent and the primitive was collectable.\n      # It might indicate the environment changed unexpectedly or a deeper issue.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:06:04.132267", "function_name": "collect", "function_body": "  import collections\n\n  # --- Constants and Helper Definitions (Local to collect_v2) ---\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      ACTION_UP: DIR_NORTH,   # Agent moves North, faces North\n      ACTION_DOWN: DIR_SOUTH, # Agent moves South, faces South\n      ACTION_LEFT: DIR_WEST,  # Agent moves West, faces West\n      ACTION_RIGHT: DIR_EAST  # Agent moves East, faces East\n  }\n\n  # Maximum number of steps allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent,\n      based on CraftState.dir (0=East, 1=South, 2=West, 3=North).\n      \"\"\"\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return (y, x) # Fallback, should not be reached with valid directions\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # Format: {action: (resulting_direction_after_move, dy, dx)}\n  # This map ensures consistency between movement actions and the agent's updated facing direction.\n  movement_actions_map = {\n      ACTION_UP:    (ACTION_TO_DIR[ACTION_UP], -1, 0),    # Move North (dy=-1, dx=0), new dir=DIR_NORTH\n      ACTION_DOWN:  (ACTION_TO_DIR[ACTION_DOWN], 1, 0),   # Move South (dy=1, dx=0), new dir=DIR_SOUTH\n      ACTION_LEFT:  (ACTION_TO_DIR[ACTION_LEFT], 0, -1),  # Move West (dy=0, dx=-1), new dir=DIR_WEST\n      ACTION_RIGHT: (ACTION_TO_DIR[ACTION_RIGHT], 0, 1)  # Move East (dy=0, dx=1), new dir=DIR_EAST\n  }\n  # --- End Constants and Helper Definitions ---\n\n  actions_taken = []\n\n  # Access the underlying CraftState instance to get the current state information.\n  current_state = env._current_state\n\n  # --- Pre-checks for early exit ---\n  # 1. Primitive must be a known kind in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # 2. Primitive must be grabbable (can be collected with ACTION_USE).\n  if primitive not in current_state.world.grabbable_indices:\n      return []\n\n  # 3. If primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n  \n  # 4. If max steps is non-positive, no collection is possible.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # Retrieve necessary environment information for pathfinding.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, n_kinds = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir \n\n  # --- Impassable Mask Creation ---\n  # Create a boolean mask where True indicates an impassable kind.\n  # This makes checking traversability efficient.\n  impassable_mask = np.zeros(n_kinds, dtype=bool)\n\n  # Water is typically impassable for movement.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_mask[current_state.world.water_index] = True\n  \n  # Any non-grabbable items that are NOT workshops are generally impassable.\n  # Workshops are non-grabbable but are traversable locations.\n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in current_state.world.workshop_indices:\n          if k_idx < n_kinds: # Ensure index is within bounds of the grid's kind dimension\n              impassable_mask[k_idx] = True\n  # --- End Impassable Mask Creation ---\n\n  q = collections.deque()\n  # BFS queue state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  q.append((start_y, start_x, start_dir, []))\n  \n  # Keep track of visited states to prevent redundant exploration and infinite loops.\n  # A state is defined by agent's (position, direction).\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None # Will store the action sequence leading to successful collection.\n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # If the current path length already exceeds MAX_COLLECT_STEPS, prune this branch.\n      # This check is for the path *before* the potential final USE action.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # Calculate the coordinates of the grid cell that the agent is currently facing.\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Check if the facing cell is within grid boundaries and contains the target primitive.\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n          full_grid[facing_y, facing_x, primitive] > 0):\n\n          # We've found a suitable position and orientation to use ACTION_USE.\n          candidate_path = path + [ACTION_USE]\n\n          # Ensure the complete path (including ACTION_USE) is within the step limit.\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              break # Found the shortest path, exit BFS.\n\n      # Explore all possible next states from the current state (movement actions).\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Pruning: If adding this move makes the path too long (considering potential final USE action).\n          # A +1 is for the current `action_move`.\n          if len(path) + 1 >= MAX_COLLECT_STEPS: \n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Efficiently check if the next cell is traversable using the pre-computed mask.\n          # `np.any(full_grid[next_y, next_x, impassable_mask])` will be True if any impassable kind\n          # is present at the target cell, meaning it's blocked.\n          if np.any(full_grid[next_y, next_x, impassable_mask]):\n              continue\n\n          # Check if this new (position, direction) state has already been visited.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # If valid and unvisited, add to visited set and queue for exploration.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      return [] # No valid path was found to collect the primitive.\n\n  for action in path_to_execute:\n      # If the primitive is already collected during execution, stop early.\n      if current_state.inventory[primitive] > 0:\n          break \n      \n      actions_taken.append(action)\n      # Perform the action and update the environment's internal state.\n      reward, done, _ = env.step(action)\n      current_state = env._current_state # Update the local reference to the current state\n\n      # If the episode ends prematurely (e.g., max_steps reached in the DMLab wrapper)\n      # AND the primitive was not collected, it means the path failed.\n      if done and current_state.inventory[primitive] <= 0:\n          return [] \n\n  # Final check: After executing all actions in the found path, verify if the primitive\n  # is indeed in the agent's inventory.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If for any reason (e.g., environment changed dynamically, or max_steps hit\n      # exactly after the last action but before inventory update was checked),\n      # the primitive wasn't collected, return an empty list.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:07:49.612532", "function_name": "collect", "function_body": "    import collections\n\n    # 1. Get current state observations\n    obs = env.observations()\n    inventory = obs['features_dict']['inventory']\n\n    # Check if primitive is already collected\n    if inventory[primitive] > 0:\n        return []\n\n    grid = obs['features_dict']['features_global']\n    initial_pos = tuple(obs['features_dict']['pos']) # Ensure it's a tuple for hashing\n    \n    # Get grid dimensions (width, height, number of kinds)\n    # Assuming grid shape is (WIDTH, HEIGHT, n_kinds) as per CraftScenario/CraftState\n    width, height, n_kinds = grid.shape\n\n    # Get action mappings from the environment\n    action_specs = env.action_specs()\n    ACTIONS = {name: idx for name, idx in action_specs.items()}\n    \n    # Define movement deltas for each action type\n    # Mapping from (dx, dy) delta to the corresponding action ID\n    DELTA_TO_ACTION = {\n        (0, 1): ACTIONS['DOWN'],\n        (0, -1): ACTIONS['UP'],\n        (-1, 0): ACTIONS['LEFT'],\n        (1, 0): ACTIONS['RIGHT']\n    }\n    \n    # Determine what constitutes a blocking entity for movement.\n    # `non_grabbable_indices` typically represent unpassable terrain or fixed structures.\n    blocking_indices = env.world.non_grabbable_indices\n\n    def is_traversable(x, y):\n        \"\"\"Checks if a cell (x, y) is within grid bounds and does not contain blocking entities.\"\"\"\n        if not (0 <= x < width and 0 <= y < height):\n            return False\n        \n        # Check if the cell contains any object that is considered blocking\n        # A cell is blocking if any of its `kind` components is in `blocking_indices` and present\n        for kind_idx in blocking_indices:\n            if grid[x, y, kind_idx] > 0: # If this blocking kind is present at (x,y)\n                return False\n        return True\n\n    # BFS setup: Queue stores (current_position, list_of_actions_to_reach_current_position)\n    q = collections.deque([(initial_pos, [])])\n    visited = {initial_pos} # Set to keep track of visited (x,y) positions\n\n    while q:\n        current_pos, path_actions = q.popleft()\n        cx, cy = current_pos\n\n        # First, check if the current position is adjacent to the target primitive.\n        # This is where the agent would perform the 'USE' action.\n        # Check 4 cardinal neighbors (up, down, left, right) for the primitive.\n        for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n            nx, ny = cx + dx, cy + dy\n            # Check if neighbor is within bounds and contains the primitive\n            if 0 <= nx < width and 0 <= ny < height and grid[nx, ny, primitive] > 0:\n                # If a primitive is found in an adjacent cell, we have found a path.\n                # The path consists of movement actions to `current_pos` followed by a 'USE' action.\n                return path_actions + [ACTIONS['USE']]\n\n        # If not adjacent to the primitive yet, explore traversable neighbors for movement\n        for dx, dy in DELTA_TO_ACTION.keys(): # Iterate over possible movement deltas\n            next_pos = (cx + dx, cy + dy)\n\n            # Check if the next position is traversable and hasn't been visited yet\n            if is_traversable(next_pos[0], next_pos[1]) and next_pos not in visited:\n                visited.add(next_pos) # Mark as visited\n                \n                # Append the action required to move to `next_pos` to the path\n                new_path_actions = path_actions + [DELTA_TO_ACTION[(dx, dy)]]\n                q.append((next_pos, new_path_actions))\n    \n    # If the queue is exhausted and no path to an adjacent primitive was found,\n    # the primitive is unreachable or not present.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:07:50.583497", "function_name": "collect", "function_body": "  # Action constants (standard DMLab Craft mappings)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction deltas and mappings for agent movement and facing\n  # (row_delta, col_delta) for each cardinal direction\n  DIR_NORTH_DELTA = (-1, 0)\n  DIR_EAST_DELTA = (0, 1)\n  DIR_SOUTH_DELTA = (1, 0)\n  DIR_WEST_DELTA = (0, -1)\n\n  # Maps (delta_row, delta_col) to the action required to move in that direction\n  DELTA_TO_MOVE_ACTION = {\n      DIR_NORTH_DELTA: ACTION_UP,\n      DIR_SOUTH_DELTA: ACTION_DOWN,\n      DIR_WEST_DELTA: ACTION_LEFT,\n      DIR_EAST_DELTA: ACTION_RIGHT\n  }\n\n  # Maps (delta_row, delta_col) to the agent's facing direction index (0:N, 1:E, 2:S, 3:W)\n  DELTA_TO_FACING_DIR = {\n      DIR_NORTH_DELTA: 0, # North\n      DIR_EAST_DELTA: 1,  # East\n      DIR_SOUTH_DELTA: 2, # South\n      DIR_WEST_DELTA: 3   # West\n  }\n\n  # Get current state information from the CraftLab environment\n  obs = env.observations()\n  current_inventory = obs['features_dict']['inventory']\n\n  # If the primitive is already in inventory, no actions are needed\n  if current_inventory[primitive] > 0:\n      return []\n\n  # Access the underlying CraftState for detailed environment data\n  state = env._current_state\n  grid = state.grid\n  current_pos = state.pos  # (row, col)\n  current_dir = state.dir  # 0:N, 1:E, 2:S, 3:W\n  world = state.world      # CraftWorld instance for non_grabbable_indices\n\n  # Get grid dimensions\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Define kinds that are impassable for agent movement\n  # Agent cannot path through any non-grabbable item (e.g., water, walls, workshops)\n  # It must get adjacent to them to interact.\n  impassable_kinds = set(world.non_grabbable_indices)\n  \n  # Use collections.deque for efficient BFS queue\n  from collections import deque\n\n  # BFS state: ((row, col), current_facing_direction, list_of_actions_taken_to_reach_this_state)\n  queue = deque([(current_pos, current_dir, [])])\n  # Visited set to avoid cycles and redundant exploration: ((row, col), current_facing_direction)\n  visited = set([(current_pos, current_dir)])\n\n  actions_to_collect = None # This will store the final sequence of actions if a path is found\n\n  # BFS loop\n  while queue and actions_to_collect is None:\n      (r, c), d, path_actions = queue.popleft()\n\n      # Check if the current cell (r,c) is adjacent to the target primitive\n      # We iterate through potential neighbor cells to check for the primitive\n      for dr_adj, dc_adj in [DIR_NORTH_DELTA, DIR_EAST_DELTA, DIR_SOUTH_DELTA, DIR_WEST_DELTA]:\n          adj_r, adj_c = r + dr_adj, c + dc_adj\n          \n          # Check bounds for the adjacent cell\n          if not (0 <= adj_r < HEIGHT and 0 <= adj_c < WIDTH):\n              continue\n          \n          # If the adjacent cell contains the target primitive\n          if grid[adj_r, adj_c, primitive] == 1:\n              # Agent is at (r,c) and the primitive is at (adj_r, adj_c)\n              # Need to turn to face the primitive and then USE\n\n              # Calculate the vector from agent's current position to the primitive's position\n              target_delta_r, target_delta_c = adj_r - r, adj_c - c\n              \n              # Determine the desired direction to face based on this delta\n              desired_dir_to_face = DELTA_TO_FACING_DIR.get((target_delta_r, target_delta_c))\n              \n              if desired_dir_to_face is None:\n                  continue # Should not happen for valid adjacent cells\n\n              # Calculate turn actions needed to face the desired direction\n              turn_actions = []\n              current_d_for_turns = d # Use a temporary variable for turn calculation\n              \n              # Determine shortest turns (either clockwise or counter-clockwise)\n              turns_right = (desired_dir_to_face - current_d_for_turns + 4) % 4\n              turns_left = (current_d_for_turns - desired_dir_to_face + 4) % 4\n\n              if turns_right <= turns_left:\n                  for _ in range(turns_right):\n                      turn_actions.append(ACTION_RIGHT)\n              else:\n                  for _ in range(turns_left):\n                      turn_actions.append(ACTION_LEFT)\n\n              # Construct the full sequence of actions: path to adjacent + turns + USE\n              actions_to_collect = list(path_actions) + turn_actions + [ACTION_USE]\n              break # Found a path, exit inner loop to stop exploring neighbors\n      \n      if actions_to_collect is not None:\n          break # If a path was found in the inner loop, exit the main BFS loop\n\n      # If not adjacent to target, explore possible moves from current (r,c)\n      for dr_move, dc_move in [DIR_NORTH_DELTA, DIR_EAST_DELTA, DIR_SOUTH_DELTA, DIR_WEST_DELTA]:\n          next_r, next_c = r + dr_move, c + dc_move\n\n          # Check bounds for the next cell\n          if not (0 <= next_r < HEIGHT and 0 <= next_c < WIDTH):\n              continue\n          \n          # Check if the next cell is impassable\n          is_impassable = False\n          for k_idx in impassable_kinds:\n              if grid[next_r, next_c, k_idx] == 1: # If cell contains any impassable kind\n                  is_impassable = True\n                  break\n          \n          if is_impassable:\n              continue\n\n          # Determine the new facing direction after this move (agent faces direction of movement)\n          new_dir = DELTA_TO_FACING_DIR.get((dr_move, dc_move))\n          if new_dir is None: # Should not happen for valid moves\n              continue\n\n          # If this (next_pos, new_dir) state has not been visited\n          if ((next_r, next_c), new_dir) not in visited:\n              visited.add(((next_r, next_c), new_dir))\n              move_action = DELTA_TO_MOVE_ACTION.get((dr_move, dc_move))\n              queue.append(((next_r, next_c), new_dir, path_actions + [move_action]))\n                \n  # Return the found actions or an empty list if no path was found\n  return actions_to_collect if actions_to_collect is not None else []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:09:18.925922", "function_name": "collect", "function_body": "    actions = []\n    # Access the internal CraftState directly for decision making\n    current_state = env._current_state\n\n    # Maximum number of steps to prevent infinite loops in case of unachievable goals or bugs\n    MAX_STEPS_ALLOWED = 500\n\n    # Retrieve action constants from env_factory as specified in problem description\n    _UP = env_factory.ACTIONS.UP\n    _DOWN = env_factory.ACTIONS.DOWN\n    _LEFT = env_factory.ACTIONS.LEFT\n    _RIGHT = env_factory.ACTIONS.RIGHT\n    _USE = env_factory.ACTIONS.USE\n\n    for step_count in range(MAX_STEPS_ALLOWED):\n        # 1. Check if the primitive is already collected (goal satisfied)\n        if current_state.inventory[primitive] > 0:\n            break\n\n        # 2. Find all locations of the primitive on the grid\n        # current_state.grid[:, :, primitive] gives the 2D slice for that primitive kind.\n        # np.argwhere returns (N, 2) array where each row is (x, y) coordinate.\n        primitive_locations = np.argwhere(current_state.grid[:, :, primitive] == 1)\n\n        # If no primitive found on the map, we cannot collect it.\n        if len(primitive_locations) == 0:\n            break\n\n        # 3. Find the closest primitive location using Manhattan distance\n        current_pos = current_state.pos  # (x, y) tuple\n        min_dist = float('inf')\n        target_pos = None\n\n        for loc_array in primitive_locations:\n            # np.argwhere for a (W, H) grid returns (x, y) directly.\n            loc_x, loc_y = loc_array[0], loc_array[1]\n            dist = abs(loc_x - current_pos[0]) + abs(loc_y - current_pos[1])\n            if dist < min_dist:\n                min_dist = dist\n                target_pos = (loc_x, loc_y)\n\n        # If for some reason target_pos is still None (should not happen if primitive_locations is not empty)\n        if target_pos is None:\n            break\n\n        # 4. Determine action: USE if adjacent or on the same cell, else move towards it\n        action_to_take = None\n\n        if min_dist <= 1:  # Agent is adjacent (Manhattan distance 1) or on the same cell (dist 0)\n            action_to_take = _USE\n        else:  # Need to move towards the primitive\n            dx = target_pos[0] - current_pos[0]\n            dy = target_pos[1] - current_pos[1]\n\n            # Prioritize movement along the dimension with the larger absolute difference\n            if abs(dx) >= abs(dy):  # Prefer moving along X-axis\n                if dx > 0:\n                    action_to_take = _RIGHT\n                elif dx < 0:\n                    action_to_take = _LEFT\n                # If dx is 0, but dy is not (i.e., min_dist > 1 and dx == 0, then we must move along Y)\n                elif dy > 0:\n                    action_to_take = _UP\n                elif dy < 0:\n                    action_to_take = _DOWN\n            else:  # Prefer moving along Y-axis\n                if dy > 0:\n                    action_to_take = _UP\n                elif dy < 0:\n                    action_to_take = _DOWN\n                # If dy is 0, but dx is not\n                elif dx > 0:\n                    action_to_take = _RIGHT\n                elif dx < 0:\n                    action_to_take = _LEFT\n\n        # 5. Execute the determined action and update state\n        if action_to_take is not None:\n            actions.append(action_to_take)\n            prev_pos = current_state.pos  # Store position before step\n            _, _, _ = env.step(action_to_take)  # Reward, done, and observations are not directly used here\n            current_state = env._current_state  # Update the state reference for the next iteration\n\n            # Check if the agent is stuck (didn't move when a movement action was taken)\n            # This is a basic form of obstacle avoidance for `v2`.\n            if action_to_take != _USE and current_state.pos == prev_pos:\n                # If the agent tried to move but its position didn't change, it's likely blocked.\n                # For `collect_v2`, we'll simplify and break the loop to prevent infinite retries\n                # against an obstacle. A more advanced version would implement pathfinding.\n                break\n        else:\n            # This case indicates a logic error (e.g., target_pos is current_pos but USE failed,\n            # or no movement action could be determined despite min_dist > 1).\n            break\n\n    return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:09:18.995771", "function_name": "collect", "function_body": "    # Constants for actions (from CraftLab.action_specs)\n    # These would typically be module-level constants, but are included here\n    # to ensure the function body is self-contained as per instructions.\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    actions = []\n\n    # 1. Check if primitive is already collected\n    # env._current_state.inventory is a numpy array\n    if env._current_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # 2. Check if the primitive is actually grabbable\n    # Access env.world.grabbable_indices through the nested structure:\n    # CraftLab -> _current_state (CraftState) -> world (CraftWorld) -> grabbable_indices\n    if primitive not in env._current_state.world.grabbable_indices:\n        # Cannot collect this primitive with a simple USE action\n        return []\n\n    # 3. Get current state information\n    current_state = env._current_state\n    grid = current_state.grid\n    agent_x, agent_y = current_state.pos\n\n    # 4. Find the closest target position of the primitive on the grid\n    target_x, target_y = -1, -1  # Sentinel value indicating not found\n    min_dist = float('inf')\n\n    # grid shape is (WIDTH, HEIGHT, n_kinds)\n    width, height, _ = grid.shape\n\n    for x in range(width):\n        for y in range(height):\n            # Check if this cell contains the primitive\n            if grid[x, y, primitive] == 1:\n                # Calculate Manhattan distance (L1 distance)\n                dist = abs(x - agent_x) + abs(y - agent_y)\n                if dist < min_dist:\n                    min_dist = dist\n                    target_x, target_y = x, y\n\n    # If the primitive is not found on the visible grid,\n    # no actions can be planned to collect it.\n    if target_x == -1:\n        return []\n\n    # 5. Generate actions to move to the target position\n    # This pathfinding strategy moves horizontally first, then vertically.\n    # It assumes a clear path without obstacles, which is a common simplification\n    # for basic versions of collection tasks in grid worlds.\n\n    # Horizontal movement\n    if target_x > agent_x:\n        actions.extend([_RIGHT] * (target_x - agent_x))\n    elif target_x < agent_x:\n        actions.extend([_LEFT] * (agent_x - target_x))\n\n    # Vertical movement\n    if target_y > agent_y:\n        actions.extend([_DOWN] * (target_y - agent_y))\n    elif target_y < agent_y:\n        actions.extend([_UP] * (agent_y - target_y))\n\n    # 6. Add the USE action\n    # After the agent reaches (target_x, target_y), it will be on the same cell\n    # as the primitive. The CraftState.next_to method (which checks a 3x3\n    # neighborhood) would return True if the agent is on or adjacent to the item,\n    # allowing the _USE action to succeed for grabbable items.\n    actions.append(_USE)\n\n    return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:10:34.172668", "function_name": "collect", "function_body": "    # Check if the primitive is even grabbable.\n    # `env.world.grabbable_indices` is a list of int indices for entities that can be picked up.\n    if primitive not in env.world.grabbable_indices:\n        return [] # Cannot collect this item, so no actions are possible.\n\n    # Get the current state from the environment.\n    # Note: Accessing `_current_state` is an internal detail of `CraftLab`,\n    # but it's necessary here to simulate `CraftState` steps for planning.\n    current_state = env._current_state\n\n    # If the primitive is already in inventory at the current state, no actions are needed.\n    if current_state.satisfies('', primitive):\n        return []\n\n    # Define action constants. These are typically global, but for a function-only\n    # completion, they are defined locally if not guaranteed to be in scope.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n    ACTION_MOVE_OPTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]\n\n    # BFS Queue: stores tuples of (CraftState_instance, list_of_actions_taken_to_reach_this_state).\n    # Using a list as a queue and manually managing the head pointer to avoid `collections.deque` import.\n    q = [(current_state, [])]\n    head = 0 # Pointer to the current element being processed in the list-as-queue\n    \n    # Visited set: stores (position_tuple, direction_int) to avoid cycles and redundant exploration.\n    # `pos` is already a tuple (int, int), so it's directly hashable.\n    visited = set()\n    \n    # Maximum number of actions to search. This prevents infinite loops if the primitive\n    # is unreachable or the map is very large. A reasonable heuristic for typical CraftWorld maps.\n    max_actions_limit = 500 \n\n    while head < len(q):\n        current_s, actions_taken = q[head]\n        head += 1\n\n        # Pruning: If the current path exceeds the maximum allowed actions, stop exploring this branch.\n        if len(actions_taken) >= max_actions_limit:\n            continue\n\n        # Create a hashable key for the current state, based on position and direction.\n        # Inventory is not part of the visited key as it only changes upon successful 'USE' action,\n        # which is the goal of the search rather than an intermediate movement state.\n        state_key = (current_s.pos, current_s.dir)\n\n        # If this state (position and direction) has been visited before, skip to avoid\n        # processing redundant paths and entering cycles.\n        if state_key in visited:\n            continue\n        visited.add(state_key)\n\n        # Check if the desired primitive is in the agent's immediate vicinity (3x3 neighborhood).\n        # If it is, attempt to 'USE' it.\n        if current_s.next_to(primitive):\n            # Simulate the 'USE' action. `CraftState.step` returns (reward, new_state).\n            # We only need the `new_state` to check if the item was collected.\n            _, potential_collect_state = current_s.step(ACTION_USE)\n            \n            # If the item is now present in the inventory of the state after 'USE',\n            # then we have found a successful sequence of actions.\n            if potential_collect_state.satisfies('', primitive):\n                return actions_taken + [ACTION_USE]\n\n        # Explore all possible movement actions (UP, DOWN, LEFT, RIGHT) from the current state.\n        for action in ACTION_MOVE_OPTIONS:\n            # Simulate the movement action. `CraftState.step` returns a new `CraftState` instance,\n            # ensuring that `current_s` and the actual environment state remain unchanged.\n            _, next_s = current_s.step(action)\n            \n            # Create a hashable key for the next state.\n            next_state_key = (next_s.pos, next_s.dir)\n\n            # If this next state has not been visited yet, add it to the queue for further exploration.\n            # This check here (before appending) prevents adding redundant states to the queue.\n            if next_state_key not in visited:\n                q.append((next_s, actions_taken + [action]))\n\n    # If the BFS completes (queue is exhausted) and no path to collect the primitive was found,\n    # return an empty list, indicating that the item is unreachable within the search limits.\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:10:34.245028", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Define action constants based on CraftLab.action_specs()\n    # (Assuming these are globally available or can be defined here if not)\n    _ACTION_DOWN = 0\n    _ACTION_UP = 1\n    _ACTION_LEFT = 2\n    _ACTION_RIGHT = 3\n    _ACTION_USE = 4\n\n    # Directions (N, E, S, W) mapping to (delta_row, delta_col)\n    # DMLab-like convention: 0=North (up), 1=East (right), 2=South (down), 3=West (left)\n    _DR = [-1, 0, 1, 0]  # Delta Row for North, East, South, West moves\n    _DC = [0, 1, 0, -1]  # Delta Column for North, East, South, West moves\n\n    # Helper function to check if a position is within grid bounds and traversable\n    def _is_traversable(grid, r, c, world):\n        \"\"\"\n        Checks if a given grid cell (r, c) is within bounds and traversable by the agent.\n        Assumes water and stone are primary non-traversable blocks.\n        \"\"\"\n        WIDTH, HEIGHT = grid.shape[:2]\n        if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n            return False  # Out of bounds\n\n        # Check for blocking non-grabbable items like water and stone\n        # Note: 'in world.kinds' check is for robustness in case an index isn't defined\n        if world.water_index in world.kinds and grid[r, c, world.water_index] > 0:\n            return False\n        if world.stone_index in world.kinds and grid[r, c, world.stone_index] > 0:\n            return False\n        # Add checks for other specific non-grabbable items that block movement if necessary\n        # e.g., if trees or certain workshops are completely impassable.\n        # For this general case, we assume only water and stone are typical ground blockers.\n        return True\n\n    # 1. Check if the primitive is already in the agent's inventory\n    if env._current_state.inventory[primitive] > 0:\n        return []  # Already collected, no actions needed\n\n    # 2. Verify that the primitive is actually a grabbable item\n    # If it's not grabbable (e.g., a workshop, a fixed structure, or a crafting output),\n    # this function, designed for \"collecting\", cannot handle it.\n    if primitive not in env.world.grabbable_indices:\n        return []  # Cannot collect this item directly by picking up\n\n    # Initialize BFS (Breadth-First Search) for pathfinding\n    q = collections.deque()\n    visited = set()  # Stores (row, col, direction) tuples to avoid cycles\n\n    # Get the current state of the environment\n    current_state = env._current_state\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir\n    initial_grid = current_state.grid  # The grid used for pathfinding\n\n    # The CraftWorld instance provides definitions like water_index, stone_index, etc.\n    world = env.world\n\n    # BFS state: (current_row, current_col, current_direction, list_of_actions_so_far)\n    q.append((initial_pos[0], initial_pos[1], initial_dir, []))\n    visited.add((initial_pos[0], initial_pos[1], initial_dir))\n\n    # Start BFS\n    while q:\n        r, c, d, path = q.popleft()\n\n        # Check if the cell directly in front of the agent contains the primitive.\n        # This is the target condition for applying the USE action.\n        front_r, front_c = r + _DR[d], c + _DC[d]\n\n        # Check if the front cell is valid, contains the primitive, and we can collect it.\n        if (_is_traversable(initial_grid, front_r, front_c, world) and # ensure it's a valid cell\n                initial_grid[front_r, front_c, primitive] > 0):\n            # Found the primitive in front, add USE action and return the path\n            return path + [_ACTION_USE]\n\n        # Explore possible next actions (movement and turns)\n        # 1. Move Forward (UP action)\n        next_r_up, next_c_up = r + _DR[d], c + _DC[d]\n        if _is_traversable(initial_grid, next_r_up, next_c_up, world):\n            if (next_r_up, next_c_up, d) not in visited:\n                visited.add((next_r_up, next_c_up, d))\n                q.append((next_r_up, next_c_up, d, path + [_ACTION_UP]))\n\n        # 2. Move Backward (DOWN action)\n        next_r_down, next_c_down = r - _DR[d], c - _DC[d]\n        if _is_traversable(initial_grid, next_r_down, next_c_down, world):\n            if (next_r_down, next_c_down, d) not in visited:\n                visited.add((next_r_down, next_c_down, d))\n                q.append((next_r_down, next_c_down, d, path + [_ACTION_DOWN]))\n\n        # 3. Turn Left (LEFT action)\n        next_d_left = (d - 1 + 4) % 4  # Wrap around directions (0, 1, 2, 3)\n        if (r, c, next_d_left) not in visited:\n            visited.add((r, c, next_d_left))\n            q.append((r, c, next_d_left, path + [_ACTION_LEFT]))\n\n        # 4. Turn Right (RIGHT action)\n        next_d_right = (d + 1) % 4  # Wrap around directions (0, 1, 2, 3)\n        if (r, c, next_d_right) not in visited:\n            visited.add((r, c, next_d_right))\n            q.append((r, c, next_d_right, path + [_ACTION_RIGHT]))\n\n    # If the queue becomes empty and no path to the primitive was found\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:11:57.144933", "function_name": "collect", "function_body": "    # Retrieve action mappings from the environment for robustness\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map[\"DOWN\"]\n    ACTION_UP = action_map[\"UP\"]\n    ACTION_LEFT = action_map[\"LEFT\"]\n    ACTION_RIGHT = action_map[\"RIGHT\"]\n    ACTION_USE = action_map[\"USE\"]\n\n    # Direction constants (matching typical DMLab: NORTH=0, EAST=1, SOUTH=2, WEST=3)\n    DIR_NORTH = 0\n    DIR_EAST = 1\n    DIR_SOUTH = 2\n    DIR_WEST = 3\n\n    # (dr, dc) changes for each direction/action\n    # Index corresponds to direction: NORTH, EAST, SOUTH, WEST\n    DR = [-1, 0, 1, 0] # Change in row for N, E, S, W moves\n    DC = [0, 1, 0, -1] # Change in col for N, E, S, W moves\n\n    # Map move action to resulting direction (agent faces the direction of its last move)\n    ACTION_TO_DIR = {\n        ACTION_UP: DIR_NORTH,\n        ACTION_RIGHT: DIR_EAST,\n        ACTION_DOWN: DIR_SOUTH,\n        ACTION_LEFT: DIR_WEST,\n    }\n\n    current_state = env._current_state\n    \n    # 1. Check if the primitive is already collected\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    start_pos = current_state.pos\n    start_dir = current_state.dir\n\n    HEIGHT, WIDTH, N_KINDS = grid.shape\n\n    # BFS queue stores tuples: ((row, col, direction), list_of_actions_to_reach_this_state)\n    queue = collections.deque([((start_pos[0], start_pos[1], start_dir), [])])\n    # Visited set stores (row, col, direction) tuples to avoid cycles and redundant paths\n    visited = set([(start_pos[0], start_pos[1], start_dir)])\n\n    # Define possible move actions and their effects\n    # (action, dr_move, dc_move, new_dir)\n    move_options = [\n        (ACTION_UP, DR[DIR_NORTH], DC[DIR_NORTH], DIR_NORTH),\n        (ACTION_DOWN, DR[DIR_SOUTH], DC[DIR_SOUTH], DIR_SOUTH),\n        (ACTION_LEFT, DR[DIR_WEST], DC[DIR_WEST], DIR_WEST),\n        (ACTION_RIGHT, DR[DIR_EAST], DC[DIR_EAST], DIR_EAST),\n    ]\n\n    while queue:\n        (r, c, current_dir), actions_so_far = queue.popleft()\n\n        # --- Check for goal condition: can we collect a primitive from this (r, c, current_dir) state? ---\n        # Iterate over the four adjacent cells to see if any contain the primitive\n        for i in range(4): # 0:NORTH, 1:EAST, 2:SOUTH, 3:WEST\n            target_dr, target_dc = DR[i], DC[i]\n            target_r, target_c = r + target_dr, c + target_dc\n            target_facing_dir = i # The direction the agent needs to face to interact with this target\n\n            # Check boundary conditions for the target cell\n            if not (0 <= target_r < HEIGHT and 0 <= target_c < WIDTH):\n                continue\n\n            # Check if the target cell contains the desired primitive\n            if grid[target_r, target_c, primitive] > 0:\n                # A primitive instance is found in an adjacent cell.\n                # Check if the agent's current direction allows for immediate USE.\n                if current_dir == target_facing_dir:\n                    # If facing the primitive, we can USE it. This is a goal state.\n                    return actions_so_far + [ACTION_USE]\n\n        # --- Explore possible moves to new cells (if no immediate goal) ---\n        for move_action, dr_move, dc_move, new_dir in move_options:\n            next_r, next_c = r + dr_move, c + dc_move\n\n            # Check boundary conditions for the next cell\n            if not (0 <= next_r < HEIGHT and 0 <= next_c < WIDTH):\n                continue\n\n            # Check walkability: Agent generally cannot move onto a cell that *only* contains\n            # the primitive it wants to collect, as USE usually implies interaction from next to it.\n            # Assuming any cell containing the target primitive is not walkable.\n            if grid[next_r, next_c, primitive] > 0:\n                continue # This cell contains the target primitive, so we cannot move onto it.\n\n            # Form the new state tuple (new position and new direction)\n            next_state = (next_r, next_c, new_dir)\n\n            # If this new state has not been visited with this orientation, add it to the queue\n            if next_state not in visited:\n                visited.add(next_state)\n                queue.append((next_state, actions_so_far + [move_action]))\n\n    # If the BFS queue is exhausted and no path to collect the primitive was found\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:11:57.224401", "function_name": "collect", "function_body": "    current_state = env._current_state\n\n    # 1. Check if the primitive is already in the inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    current_pos = current_state.pos  # (row, col)\n    height, width, _ = grid.shape\n\n    # Get non-grabbable indices to treat as obstacles\n    # These are entities the agent cannot move onto.\n    non_grabbable_indices = current_state.world.non_grabbable_indices\n\n    primitive_pos = None\n    # 2. Find the primitive's location on the grid\n    # Iterate through the grid to find the first occurrence of the primitive\n    for r in range(height):\n        for c in range(width):\n            if grid[r, c, primitive] == 1:\n                primitive_pos = (r, c)\n                break\n        if primitive_pos:\n            break\n\n    if primitive_pos is None:\n        # Primitive not found on the grid, cannot collect.\n        # Returning an empty list implies 'no actions needed' or 'cannot achieve'.\n        return []\n\n    # 3. BFS to find a path to a cell adjacent to the primitive\n    q = collections.deque([(current_pos[0], current_pos[1], [])])  # (r, c, path_actions)\n    visited = {(current_pos[0], current_pos[1])}\n\n    # Define possible adjacent cells to the primitive\n    target_adj_positions = []\n    # Relative offsets for 4-directional adjacency (dr, dc)\n    adj_offsets = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n    \n    for dr_adj, dc_adj in adj_offsets:\n        adj_r, adj_c = primitive_pos[0] + dr_adj, primitive_pos[1] + dc_adj\n        \n        # Check if the potential adjacent cell is within grid bounds\n        if 0 <= adj_r < height and 0 <= adj_c < width:\n            # Check if this adjacent cell is an obstacle itself (agent must be able to stand there)\n            is_adj_obstacle = False\n            for k_obstacle in non_grabbable_indices:\n                if grid[adj_r, adj_c, k_obstacle] == 1:\n                    is_adj_obstacle = True\n                    break\n            if not is_adj_obstacle:\n                target_adj_positions.append((adj_r, adj_c))\n\n    if not target_adj_positions:\n        # No valid (walkable) adjacent positions to the primitive (e.g., surrounded by walls)\n        return []\n\n    path_to_primitive_adj = None\n\n    # Direction vectors for movement actions\n    # These constants (DOWN, UP, LEFT, RIGHT, USE) are assumed to be globally available\n    # or defined in an accessible scope (e.g., from env_factory.constants)\n    _DR = {DOWN: 1, UP: -1, LEFT: 0, RIGHT: 0}\n    _DC = {DOWN: 0, UP: 0, LEFT: -1, RIGHT: 1}\n\n    while q:\n        r, c, path = q.popleft()\n\n        # If current position is one of the target adjacent positions, we found a path\n        if (r, c) in target_adj_positions:\n            path_to_primitive_adj = path\n            break\n\n        # Explore neighbors\n        for action_idx in [DOWN, UP, LEFT, RIGHT]:\n            nr, nc = r + _DR[action_idx], c + _DC[action_idx]\n\n            # Check if neighbor is within bounds and not visited\n            if 0 <= nr < height and 0 <= nc < width and (nr, nc) not in visited:\n                # Check if the new cell is an obstacle (cannot move onto it)\n                is_obstacle = False\n                for k_obstacle in non_grabbable_indices:\n                    if grid[nr, nc, k_obstacle] == 1:\n                        is_obstacle = True\n                        break\n\n                if not is_obstacle:\n                    visited.add((nr, nc))\n                    q.append((nr, nc, path + [action_idx]))\n\n    if path_to_primitive_adj is None:\n        # No path found to any cell adjacent to the primitive\n        return []\n    \n    # 4. Return the found path followed by the USE action\n    return path_to_primitive_adj + [USE]", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:14:13.080816", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Uses BFS to find the shortest path to collect a primitive.\"\"\"\n\n  # Get the initial CraftState from the CraftLab environment.\n  # This relies on accessing the internal `_current_state` attribute, which is common\n  # for planning functions interacting with environment wrappers like CraftLab.\n  initial_craft_state = env._current_state\n\n  # 1. Check if the primitive is already in the inventory. If so, no actions are needed.\n  if initial_craft_state.inventory[primitive] > 0:\n    return []\n\n  # 2. Find the primitive's initial position on the grid.\n  primitive_pos = None\n  grid = initial_craft_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive] == 1:\n        primitive_pos = (x, y)\n        break\n    if primitive_pos:\n      break\n  \n  # If the primitive is not found on the map, it cannot be collected.\n  return [] if not primitive_pos else _collect_bfs(initial_craft_state, primitive, primitive_pos, grid_width, grid_height)", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:14:13.152201", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Define action constants locally to ensure they are available within the function scope.\n    # In a real module, these would typically be imported from a central `constants` file.\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    _ACTIONS = [_DOWN, _UP, _LEFT, _RIGHT] # Movement actions for BFS\n\n    def _get_move_delta(action):\n        \"\"\"Returns the (dr, dc) delta for a given movement action.\"\"\"\n        if action == _DOWN: return (1, 0)\n        elif action == _UP: return (-1, 0)\n        elif action == _LEFT: return (0, 1) # Note: assuming positive dc is RIGHT\n        elif action == _RIGHT: return (0, -1) # Note: assuming negative dc is LEFT\n        # Re-checking common action mappings:\n        # DOWN: +R, UP: -R, LEFT: -C, RIGHT: +C\n        # So my original _get_move_delta for LEFT/RIGHT was swapped. Correcting.\n        if action == _LEFT: return (0, -1)\n        elif action == _RIGHT: return (0, 1)\n        else: return (0, 0) # Should not be reached for valid movement actions\n\n    # Corrected _get_move_delta\n    def _get_move_delta(action):\n        \"\"\"Returns the (dr, dc) delta for a given movement action.\"\"\"\n        if action == _DOWN: return (1, 0)\n        elif action == _UP: return (-1, 0)\n        elif action == _LEFT: return (0, -1)\n        elif action == _RIGHT: return (0, 1)\n        else: return (0, 0) # Should not happen\n\n    def _is_walkable_inner(grid, pos, world_ref):\n        \"\"\"\n        Checks if a given grid position is within bounds and traversable.\n        Assumes water (world.water_index) is the primary obstacle.\n        \"\"\"\n        r, c = pos\n        width, height, _ = grid.shape\n        if not (0 <= r < width and 0 <= c < height):\n            return False # Out of bounds\n\n        # Simple obstacle check: if the cell contains 'water', it's not walkable.\n        # This is a common simplification in CraftWorld scenarios.\n        if world_ref.water_index in np.where(grid[r, c] > 0)[0]:\n            return False\n        \n        return True # Assume other cells are walkable\n\n    def _is_next_to_on_grid_inner(agent_pos, item_kind_idx, grid, n_kinds):\n        \"\"\"\n        Checks if the agent_pos is in the 3x3 neighborhood of a cell containing item_kind_idx.\n        This mirrors the `CraftState.next_to` logic.\n        \"\"\"\n        r_agent, c_agent = agent_pos\n        width, height, _ = grid.shape\n        for dr_n in [-1, 0, 1]:\n            for dc_n in [-1, 0, 1]:\n                nr, nc = r_agent + dr_n, c_agent + dc_n\n                if 0 <= nr < width and 0 <= nc < height:\n                    # Check if the target item is at this neighboring cell\n                    if grid[nr, nc, item_kind_idx] > 0:\n                        return True\n        return False\n\n    def _find_path_to_trigger_pos_inner(start_pos, target_kind_index, current_grid, world_ref):\n        \"\"\"\n        Performs a Breadth-First Search (BFS) to find a path (list of actions)\n        to a cell from which the target_kind_index can be \"used\" via the USE action.\n        For grabbable items, this means being in the 3x3 neighborhood.\n        For workshops, this means being directly on the workshop cell.\n        \n        Returns (list_of_actions, final_agent_pos) or (None, None) if no path is found.\n        \"\"\"\n        queue = collections.deque([(start_pos, [])]) # (current_position, list_of_actions_to_reach_here)\n        visited = {start_pos} # Set of visited positions\n        \n        width, height, n_kinds = current_grid.shape\n\n        is_grabbable = target_kind_index in world_ref.grabbable_indices\n        is_workshop_target = target_kind_index in world_ref.workshop_indices\n        \n        # If target is a workshop, pre-find its locations (agent must be ON the workshop)\n        target_workshop_locations = []\n        if is_workshop_target:\n            for r_w in range(width):\n                for c_w in range(height):\n                    if current_grid[r_w, c_w, target_kind_index] > 0:\n                        target_workshop_locations.append((r_w, c_w))\n            if not target_workshop_locations:\n                return None, None # Workshop not found on the grid\n\n        while queue:\n            curr_pos, curr_actions = queue.popleft()\n\n            # Check if current position allows 'using' the target\n            if is_grabbable:\n                if _is_next_to_on_grid_inner(curr_pos, target_kind_index, current_grid, n_kinds):\n                    return curr_actions, curr_pos # Found a valid position to USE the grabbable item\n            elif is_workshop_target:\n                if curr_pos in target_workshop_locations:\n                    return curr_actions, curr_pos # Found the workshop cell\n\n            # Explore neighbors\n            for action in _ACTIONS:\n                dr, dc = _get_move_delta(action)\n                next_r, next_c = curr_pos[0] + dr, curr_pos[1] + dc\n                next_pos = (next_r, next_c)\n\n                if _is_walkable_inner(current_grid, next_pos, world_ref) and next_pos not in visited:\n                    visited.add(next_pos)\n                    queue.append((next_pos, curr_actions + [action]))\n        \n        return None, None # No path found to a usable location for the target\n    # --- End of internal helper functions ---\n\n    actions_to_take = []\n    \n    current_state = env._current_state # Get the current state from the environment wrapper\n    world = env.world\n    cookbook = world.cookbook\n\n    # 1. Check if the primitive is already in the inventory (initial state)\n    if current_state.inventory[primitive] > 0:\n        return [] # Already have it, no actions needed\n\n    # 2. Determine if the primitive is a directly grabbable item or a craftable item\n    # Note: `collect_v2` is designed to generate actions for acquiring *one* unit of the primitive,\n    # or one craft. If a recipe requires multiple units of an ingredient, it will recursively\n    # call `collect_v2` for each needed unit based on the *initial* inventory.\n\n    # Case A: Primitive is a directly grabbable item (e.g., wood, stone blocks)\n    if primitive in world.grabbable_indices:\n        target_kind = primitive\n        \n        # Find a path to a position from which the item can be collected using _USE\n        path_actions_to_trigger_pos, _ = _find_path_to_trigger_pos_inner(\n            current_state.pos, target_kind, current_state.grid, world\n        )\n        \n        if path_actions_to_trigger_pos is None:\n            return [] # No path found to collect this item\n        \n        actions_to_take.extend(path_actions_to_trigger_pos)\n        actions_to_take.append(_USE) # Add the USE action to collect the item\n\n    # Case B: Primitive is a craftable item (output of a recipe)\n    elif primitive in cookbook.recipes:\n        recipe = cookbook.recipes[primitive]\n        \n        workshop_idx = None\n        ingredients = {}\n        for key, value in recipe.items():\n            if key == '_key':\n                workshop_idx = value # The '_key' holds the index of the required workshop\n            else:\n                ingredients[key] = value # Other keys are ingredient indices and counts\n\n        if workshop_idx is None:\n            return [] # Invalid recipe (missing workshop key)\n\n        # First, collect all necessary ingredients recursively\n        for ing_idx, req_count in ingredients.items():\n            has_count = current_state.inventory[ing_idx] # Inventory from the initial state\n            needed = req_count - has_count\n            \n            for _ in range(needed): # Plan actions for each unit needed\n                # Recursively call collect_v2 for each required ingredient unit.\n                # This assumes `collect_v2` is idempotent/pure for planning (does not modify `env` state).\n                ingredient_actions = collect_v2(env, ing_idx)\n                if not ingredient_actions:\n                    # If any ingredient cannot be collected, the craft cannot be completed\n                    return []\n                actions_to_take.extend(ingredient_actions)\n\n        # After planning for all ingredients, plan to move to and use the workshop\n        # (Assuming the external system executes all these actions sequentially)\n        \n        # Check if workshop index is valid\n        if cookbook.index.get(workshop_idx) == \"*invalid*\":\n            return [] # Workshop index not found in cookbook's index\n\n        # Find a path to the workshop\n        path_actions_to_workshop, _ = _find_path_to_trigger_pos_inner(\n            current_state.pos, workshop_idx, current_state.grid, world\n        )\n        \n        if path_actions_to_workshop is None:\n            return [] # No path found to the required workshop\n\n        actions_to_take.extend(path_actions_to_workshop)\n        actions_to_take.append(_USE) # Add the USE action to craft\n\n    else:\n        # The primitive is neither directly grabbable nor craftable (e.g., environmental feature)\n        return [] # Cannot collect\n\n    return actions_to_take", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:15:35.245867", "function_name": "collect", "function_body": "  import collections\n\n  # --- Constants and Helper Definitions (Local to collect_v2) ---\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      ACTION_UP: DIR_NORTH,   # Agent moves North, faces North\n      ACTION_DOWN: DIR_SOUTH, # Agent moves South, faces South\n      ACTION_LEFT: DIR_WEST,  # Agent moves West, faces West\n      ACTION_RIGHT: DIR_EAST  # Agent moves East, faces East\n  }\n\n  # Maximum number of steps allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent,\n      based on CraftState.dir (0=East, 1=South, 2=West, 3=North).\n      \"\"\"\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return (y, x) # Fallback, should not be reached with valid directions\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # Format: {action: (resulting_direction_after_move, dy, dx)}\n  # This map ensures consistency between movement actions and the agent's updated facing direction.\n  movement_actions_map = {\n      ACTION_UP:    (ACTION_TO_DIR[ACTION_UP], -1, 0),    # Move North (dy=-1, dx=0), new dir=DIR_NORTH\n      ACTION_DOWN:  (ACTION_TO_DIR[ACTION_DOWN], 1, 0),   # Move South (dy=1, dx=0), new dir=DIR_SOUTH\n      ACTION_LEFT:  (ACTION_TO_DIR[ACTION_LEFT], 0, -1),  # Move West (dy=0, dx=-1), new dir=DIR_WEST\n      ACTION_RIGHT: (ACTION_TO_DIR[ACTION_RIGHT], 0, 1)  # Move East (dy=0, dx=1), new dir=DIR_EAST\n  }\n  # --- End Constants and Helper Definitions ---\n\n  actions_taken = []\n\n  # IMPORTANT: Reset the environment to ensure a fresh start for the collection attempt.\n  # This makes the function idempotent and less dependent on the environment's prior state.\n  _ = env.reset() \n  current_state = env._current_state # Get the initial CraftState after reset\n\n  # --- Pre-checks for early exit ---\n  # 1. Primitive must be a known kind in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # 2. Primitive must be grabbable (can be collected with ACTION_USE).\n  if primitive not in current_state.world.grabbable_indices:\n      return []\n\n  # 3. If primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n  \n  # 4. If max steps is non-positive, no collection is possible.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # Retrieve necessary environment information for pathfinding.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, n_kinds = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir \n\n  # --- Impassable Mask Creation ---\n  # Create a boolean mask where True indicates an impassable kind.\n  # This makes checking traversability efficient.\n  impassable_mask = np.zeros(n_kinds, dtype=bool)\n\n  # Water is typically impassable for movement.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_mask[current_state.world.water_index] = True\n  \n  # Any non-grabbable items that are NOT workshops are generally impassable.\n  # Workshops are non-grabbable but are traversable locations.\n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in current_state.world.workshop_indices:\n          if k_idx < n_kinds: # Ensure index is within bounds of the grid's kind dimension\n              impassable_mask[k_idx] = True\n  # --- End Impassable Mask Creation ---\n\n  q = collections.deque()\n  # BFS queue state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  q.append((start_y, start_x, start_dir, []))\n  \n  # Keep track of visited states to prevent redundant exploration and infinite loops.\n  # A state is defined by agent's (position, direction).\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None # Will store the action sequence leading to successful collection.\n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # If the current path length already exceeds MAX_COLLECT_STEPS, prune this branch.\n      # This check is for the path *before* the potential final USE action.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # Calculate the coordinates of the grid cell that the agent is currently facing.\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Check if the facing cell is within grid boundaries and contains the target primitive.\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n          full_grid[facing_y, facing_x, primitive] > 0):\n\n          # We've found a suitable position and orientation to use ACTION_USE.\n          candidate_path = path + [ACTION_USE]\n\n          # Ensure the complete path (including ACTION_USE) is within the step limit.\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              break # Found the shortest path, exit BFS.\n\n      # Explore all possible next states from the current state (movement actions).\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Pruning: If adding this move makes the path too long (considering potential final USE action).\n          # A +1 is for the current `action_move`.\n          if len(path) + 1 >= MAX_COLLECT_STEPS: \n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Efficiently check if the next cell is traversable using the pre-computed mask.\n          # `np.any(full_grid[next_y, next_x, impassable_mask])` will be True if any impassable kind\n          # is present at the target cell, meaning it's blocked.\n          if np.any(full_grid[next_y, next_x, impassable_mask]):\n              continue\n\n          # Check if this new (position, direction) state has already been visited.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # If valid and unvisited, add to visited set and queue for exploration.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      return [] # No valid path was found to collect the primitive.\n\n  for action in path_to_execute:\n      # If the primitive is already collected during execution, stop early.\n      if current_state.inventory[primitive] > 0:\n          break \n      \n      actions_taken.append(action)\n      # Perform the action and update the environment's internal state.\n      reward, done, _ = env.step(action)\n      current_state = env._current_state # Update the local reference to the current state\n\n      # If the episode ends prematurely (e.g., max_steps reached in the DMLab wrapper)\n      # AND the primitive was not collected, it means the path failed.\n      if done and current_state.inventory[primitive] <= 0:\n          return [] \n\n  # Final check: After executing all actions in the found path, verify if the primitive\n  # is indeed in the agent's inventory.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If for any reason (e.g., environment changed dynamically, or max_steps hit\n      # exactly after the last action but before inventory update was checked),\n      # the primitive wasn't collected, return an empty list.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
