{"timestamp": "2025-07-30T08:11:03.683222", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants derived from CraftLab.action_specs, typically 0-4\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Get the initial state from the CraftLab environment's internal state\n  initial_state = env._current_state\n\n  # Check if the primitive is already in the inventory at the start\n  if initial_state.inventory[primitive] > 0:\n    return []  # Already collected, no actions needed\n\n  # BFS Queue: stores tuples of (current_craft_state_object, list_of_actions_to_reach_this_state)\n  # CraftState.step returns a *new* CraftState instance, which is suitable for BFS branching\n  queue = collections.deque([(initial_state, [])])\n\n  # Visited set: stores hashable representations of states to avoid redundant exploration\n  # Using the state's 'features' vector (converted to bytes) as a comprehensive state hash.\n  # This includes grid view, inventory, position, and direction.\n  visited = set()\n  \n  # Add the initial state's features hash to the visited set\n  visited.add(initial_state.features().tobytes())\n\n  # All possible actions that the agent can take\n  all_actions = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Maximum search depth to prevent excessively long searches or infinite loops\n  # Adjust this value based on the expected size and complexity of the CraftWorld scenarios\n  max_search_depth = 200 \n\n  while queue:\n    current_state, current_path = queue.popleft()\n\n    # Pruning: If the current path's length exceeds the maximum search depth,\n    # discard this path to prevent exploring too far or getting stuck in cycles\n    if len(current_path) >= max_search_depth:\n      continue\n\n    # Try all possible actions from the current state\n    for action in all_actions:\n      # Simulate the action: CraftState.step returns a new CraftState instance\n      # The reward is not needed for this pathfinding task, only the next state\n      _, next_state = current_state.step(action)\n      next_path = current_path + [action]\n\n      # Check if the target primitive is now in the inventory in the next state\n      if next_state.inventory[primitive] > 0:\n        return next_path  # Goal achieved! Return the sequence of actions\n\n      # Generate a hashable representation of the next state for the visited set\n      next_state_features_hash = next_state.features().tobytes()\n\n      # If this next state has not been visited before, add it to the queue and visited set\n      if next_state_features_hash not in visited:\n        visited.add(next_state_features_hash)\n        queue.append((next_state, next_path))\n\n  # If the queue becomes empty and the goal was not reached, it means the primitive\n  # is either unreachable or uncollectible within the defined search limits.\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:11:04.657177", "function_name": "collect", "function_body": "  # Helper directions mapping (consistent with CraftLab.action_specs)\n  # action -> (dx, dy)\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name\n  # The index method will add the primitive to the cookbook's index if it doesn't already exist.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 3. Find all locations on the grid where the primitive exists\n  grid = current_state.grid\n  grid_width, grid_height = grid.shape[0], grid.shape[1]\n  \n  target_primitive_locs = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the specific primitive layer at (x, y) has a count greater than 0\n      if grid[x, y, primitive_idx] > 0:\n        target_primitive_locs.append((x, y))\n\n  if not target_primitive_locs:\n    # The primitive is not found anywhere on the current map\n    return []\n\n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a cell adjacent to any of the found primitive locations.\n  start_pos = current_state.pos # Agent's current (x, y) position\n  \n  # Queue stores tuples of ((current_x, current_y), [list_of_actions_to_reach_here])\n  queue = [(start_pos, [])] \n  # Set of visited (x, y) coordinates to prevent cycles and redundant path exploration\n  visited = {start_pos} \n\n  best_path = None # This will store the sequence of actions once a path is found\n\n  while queue:\n    (curr_x, curr_y), path_actions = queue.pop(0) # Dequeue the first element for BFS\n\n    # Check if the current position is adjacent to any of the target primitive locations\n    for px, py in target_primitive_locs:\n      # Using Manhattan distance to check for adjacency (up, down, left, right neighbors)\n      if (abs(curr_x - px) + abs(curr_y - py) == 1):\n        best_path = path_actions # Path found! BFS guarantees this is the shortest path.\n        break # Exit inner loop, as we found a path to *an* adjacent cell\n    \n    if best_path is not None:\n        break # Exit outer while loop, as we've found our shortest path\n\n    # Explore all possible movements from the current position\n    for action, (dx, dy) in _ACTION_TO_COORD_DIFF.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      next_pos = (next_x, next_y)\n      \n      # If this position has not been visited yet\n      if next_pos not in visited:\n        # Simplification: Assume all cells are traversable for movement.\n        # In a more complex scenario, one might need to check if a cell is\n        # blocked by an impassable object (e.g., walls, water for non-swimming agent).\n        # Given the problem context, we assume basic grid traversal.\n        \n        visited.add(next_pos) # Mark the new position as visited\n        # Add the new position and its path to the queue\n        queue.append((next_pos, path_actions + [action]))\n\n  if best_path is None:\n    # If the queue becomes empty and no path was found, it means the primitive\n    # is unreachable (e.g., completely surrounded by impassable cells, if they existed).\n    return []\n\n  # 5. Once adjacent to the primitive, the final action is to USE it to collect it.\n  return best_path + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T08:13:00.029858", "function_name": "collect", "function_body": "    # Helper functions (nested to fit the \"only return code that will fit in that function\" constraint)\n    # Constants for directions (matching DMLab Craft's conventions: 0=N, 1=E, 2=S, 3=W)\n    DIR_NORTH = 0\n    DIR_EAST = 1\n    DIR_SOUTH = 2\n    DIR_WEST = 3\n\n    # Changes in (row, col) for each direction\n    DR = [-1, 0, 1, 0] # N, E, S, W (row changes)\n    DC = [0, 1, 0, -1] # N, E, S, W (column changes)\n\n    def _get_turn_actions_list(current_dir, target_dir, action_map):\n        \"\"\"\n        Calculates the sequence of turn actions (LEFT/RIGHT) to change from current_dir to target_dir.\n        Assumes directions are 0=N, 1=E, 2=S, 3=W.\n        \"\"\"\n        actions = []\n        diff = (target_dir - current_dir + 4) % 4\n        \n        if diff == 1: # 90 deg right turn (e.g., N->E)\n            actions.append(action_map['RIGHT'])\n        elif diff == 2: # 180 deg turn (e.g., N->S)\n            actions.append(action_map['RIGHT']) \n            actions.append(action_map['RIGHT']) # Can be two rights or two lefts\n        elif diff == 3: # 90 deg left turn (e.g., N->W)\n            actions.append(action_map['LEFT'])\n        return actions\n\n    def _is_valid_position(r, c, height, width):\n        \"\"\"Checks if a cell (r, c) is within grid bounds.\"\"\"\n        return 0 <= r < height and 0 <= c < width\n\n    def _is_walkable_cell(r, c, grid_data, non_walkable_kinds, height, width):\n        \"\"\"Checks if a cell (r, c) is within bounds and does not contain non-walkable items.\"\"\"\n        if not _is_valid_position(r, c, height, width):\n            return False\n        \n        # Check if any non-walkable kind is present at (r,c)\n        for kind_idx in non_walkable_kinds:\n            if grid_data[r, c, kind_idx] == 1:\n                return False\n        return True\n\n    def _get_direction_from_coords(from_r, from_c, to_r, to_c):\n        \"\"\"\n        Returns the cardinal direction an agent at (from_r, from_c) needs to face\n        to look at (to_r, to_c). Assumes they are directly adjacent.\n        \"\"\"\n        if to_r == from_r - 1 and to_c == from_c: return DIR_NORTH \n        if to_r == from_r + 1 and to_c == from_c: return DIR_SOUTH\n        if to_r == from_r and to_c == from_c + 1: return DIR_EAST  \n        if to_r == from_r and to_c == from_c - 1: return DIR_WEST  \n        return -1 # Should not happen if called correctly for adjacent cells\n\n    # End of nested helper functions\n\n    action_map = env.action_specs()\n    USE = action_map['USE']\n    # Explicitly define movement actions for clarity\n    MOVE_FORWARD = action_map['UP']\n    MOVE_BACKWARD = action_map['DOWN']\n    STRAFE_LEFT = action_map['LEFT']\n    STRAFE_RIGHT = action_map['RIGHT']\n    MOVE_ACTIONS = [MOVE_FORWARD, MOVE_BACKWARD, STRAFE_LEFT, STRAFE_RIGHT]\n\n\n    # Get current state from the environment\n    current_state = env._current_state\n    current_grid = current_state.grid\n    current_pos = current_state.pos # (r, c) tuple\n    current_dir = current_state.dir # int (0=N, 1=E, 2=S, 3=W)\n    inventory = current_state.inventory\n\n    height, width, _ = current_grid.shape # grid shape is (height, width, n_kinds)\n\n    # If the primitive is already in inventory, no actions needed\n    if inventory[primitive] > 0:\n        return []\n\n    # Identify non-walkable entities from the world definition\n    # Assuming non_grabbable_indices are obstacles for movement\n    non_walkable_kinds = set(current_state.world.non_grabbable_indices)\n    # Explicitly add water if it's considered non-walkable\n    if current_state.world.water_index is not None:\n        non_walkable_kinds.add(current_state.world.water_index)\n\n    # BFS setup\n    queue = collections.deque()\n    # path_trace: Maps (r, c, d) node to (parent_r, parent_c, parent_d, action_taken_to_reach_this_node)\n    path_trace = {} \n\n    start_node = (current_pos[0], current_pos[1], current_dir)\n    queue.append(start_node)\n    path_trace[start_node] = None # Mark start node with no parent\n\n    while queue:\n        r, c, d = queue.popleft()\n\n        # Check if any adjacent cell contains the primitive (goal condition for pathfinding)\n        for i in range(4): # Check 4 cardinal neighbors\n            nr, nc = r + DR[i], c + DC[i]\n\n            if _is_valid_position(nr, nc, height, width) and current_grid[nr, nc, primitive] == 1:\n                # Goal reached: agent is at (r, c), next to the primitive at (nr, nc)\n                \n                # Reconstruct path from the start_node to the current (r, c, d)\n                current_node = (r, c, d)\n                actions = []\n                while current_node is not None:\n                    parent_info = path_trace[current_node]\n                    if parent_info is None: # Reached the start node (no parent)\n                        break\n                    _, action_to_curr = parent_info # Get the action that led to current_node\n                    actions.append(action_to_curr)\n                    current_node = parent_info[0] # Move to the parent node for next iteration\n                actions.reverse() # Path was built backwards, so reverse it to get chronological order\n\n                # Now add actions to turn and face the primitive, then USE it\n                target_face_dir = _get_direction_from_coords(r, c, nr, nc)\n                actions.extend(_get_turn_actions_list(d, target_face_dir, action_map))\n                actions.append(USE)\n                \n                return actions # Path found and returned\n\n        # Explore possible moves from the current node\n        for action in MOVE_ACTIONS:\n            new_r, new_c, new_d = r, c, d # Agent's direction does not change for movement actions\n\n            # Calculate new position based on action and current direction\n            if action == MOVE_FORWARD: # Move one step forward in current_dir\n                new_r = r + DR[d]\n                new_c = c + DC[d]\n            elif action == MOVE_BACKWARD: # Move one step backward in current_dir\n                new_r = r - DR[d]\n                new_c = c - DC[d]\n            elif action == STRAFE_LEFT: # Strafe left relative to current_dir\n                strafe_dir = (d - 1 + 4) % 4 # Calculate the direction for left strafe\n                new_r = r + DR[strafe_dir]\n                new_c = c + DC[strafe_dir]\n            elif action == STRAFE_RIGHT: # Strafe right relative to current_dir\n                strafe_dir = (d + 1) % 4 # Calculate the direction for right strafe\n                new_r = r + DR[strafe_dir]\n                new_c = c + DC[strafe_dir]\n            \n            next_node = (new_r, new_c, new_d)\n\n            # Check if the new position is walkable and has not been visited yet\n            if _is_walkable_cell(new_r, new_c, current_grid, non_walkable_kinds, height, width) and next_node not in path_trace:\n                path_trace[next_node] = ((r, c, d), action) # Store parent node and the action taken to reach next_node\n                queue.append(next_node) # Add the new node to the queue for further exploration\n    \n    # If the BFS completes and no path to the primitive was found\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:13:00.105171", "function_name": "collect", "function_body": "    from collections import deque\n    import numpy as np\n\n    # Helper function to get turns\n    def _get_turns(current_dir, target_dir, actions_map):\n        \"\"\"Calculates minimal turns (LEFT/RIGHT) to face target_dir from current_dir.\"\"\"\n        actions = []\n        # Calculate difference in directions (0=N, 1=E, 2=S, 3=W)\n        # E.g., if current_dir is 3 (West) and target_dir is 0 (North):\n        # diff = (0 - 3 + 4) % 4 = 1. This means a single RIGHT turn.\n        # E.g., if current_dir is 1 (East) and target_dir is 3 (West):\n        # diff = (3 - 1 + 4) % 4 = 2. This means two RIGHT turns (180 deg).\n        diff = (target_dir - current_dir + 4) % 4\n        if diff == 1:  # 90 deg right turn\n            actions.append(actions_map['RIGHT'])\n        elif diff == 2:  # 180 deg turn (two right turns)\n            actions.append(actions_map['RIGHT'])\n            actions.append(actions_map['RIGHT'])\n        elif diff == 3:  # 90 deg left turn\n            actions.append(actions_map['LEFT'])\n        return actions\n\n    # Helper function to determine relative direction from pos1 to pos2\n    def _get_relative_direction(pos1, pos2):\n        \"\"\"Returns the cardinal direction from pos1 to pos2, or None if not adjacent.\n        Assumes cardinal directions 0=N, 1=E, 2=S, 3=W.\"\"\"\n        dx = pos2[0] - pos1[0]\n        dy = pos2[1] - pos1[1]\n\n        if dx == 0 and dy == -1: return 0  # NORTH\n        if dx == 1 and dy == 0:  return 1  # EAST\n        if dx == 0 and dy == 1:  return 2  # SOUTH\n        if dx == -1 and dy == 0: return 3  # WEST\n        return None # Not a cardinal neighbor or same position\n\n    state = env._current_state\n    current_pos = state.pos\n    current_dir = state.dir\n    grid = state.features_dict()['features_global']\n    WIDTH, HEIGHT, _ = grid.shape\n\n    actions_map = env.action_specs()\n    ACTION_UP = actions_map['UP']\n    ACTION_LEFT = actions_map['LEFT']\n    ACTION_RIGHT = actions_map['RIGHT']\n    ACTION_USE = actions_map['USE']\n\n    # Direction constants (assuming 0=N, 1=E, 2=S, 3=W as per convention)\n    NORTH, EAST, SOUTH, WEST = 0, 1, 2, 3\n    cardinal_neighbors_delta = [(-1, 0), (1, 0), (0, -1), (0, 1)] # dx, dy\n\n    # 0. Check if the primitive is grabbable\n    if primitive not in env.world.grabbable_indices:\n        return []\n\n    # 1. Check if agent is already on the primitive or next to it\n    # Check if agent is directly on the primitive\n    if grid[current_pos[0], current_pos[1], primitive] == 1:\n        # Agent is on the primitive, just use it.\n        return [ACTION_USE]\n\n    # Find all locations of the primitive first\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] == 1:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return [] # Primitive not found anywhere on the map\n\n    # Check if any primitive location is adjacent to the current position\n    adjacent_primitive_loc = None\n    for px, py in primitive_locations:\n        for dx, dy in cardinal_neighbors_delta:\n            if (current_pos[0] + dx, current_pos[1] + dy) == (px, py):\n                adjacent_primitive_loc = (px, py)\n                break\n        if adjacent_primitive_loc:\n            break\n    \n    if adjacent_primitive_loc:\n        # Agent is next to a primitive. Face it and use.\n        actions = []\n        target_face_dir = _get_relative_direction(current_pos, adjacent_primitive_loc)\n        if target_face_dir is not None: # Should always be true if adjacent_primitive_loc was found correctly\n            actions.extend(_get_turns(current_dir, target_face_dir, actions_map))\n            actions.append(ACTION_USE)\n            return actions\n\n    # 2. If not already at or next to primitive, perform BFS to find it.\n    # Target cells for BFS: any cell (nx, ny) that is adjacent to a primitive location (px, py)\n    # and (nx, ny) itself does not contain the primitive.\n    target_path_cells = {} # Maps (reachable_cell_pos): (corresponding_primitive_pos)\n\n    for px, py in primitive_locations:\n        for dx, dy in cardinal_neighbors_delta:\n            nx, ny = px + dx, py + dy\n            # Check bounds and ensure the cell is not the primitive itself\n            # The agent needs to path TO a cell ADJACENT to the primitive.\n            if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and grid[nx, ny, primitive] == 0:\n                target_path_cells[(nx, ny)] = (px, py)\n\n    if not target_path_cells:\n        # This can happen if all primitives are completely surrounded by other primitives\n        # or impassable terrain, making them unreachable.\n        return []\n\n    # BFS state: (current_position_tuple, list_of_actions_so_far, current_facing_direction)\n    queue = deque([(current_pos, [], current_dir)])\n    # Track (position, direction) pairs to avoid cycles and find shortest path in terms of actions\n    visited = {(current_pos, current_dir)} \n\n    final_path_actions = None\n    final_primitive_loc_to_use = None\n    final_pos_after_path = None\n    final_dir_after_path = None\n\n    while queue:\n        (cx, cy), path, cdir = queue.popleft()\n\n        # Check if we reached one of the target path cells\n        if (cx, cy) in target_path_cells:\n            final_path_actions = path\n            final_primitive_loc_to_use = target_path_cells[(cx, cy)]\n            final_pos_after_path = (cx, cy)\n            final_dir_after_path = cdir\n            break # Found shortest path in terms of actions\n\n        # Try moving forward (ACTION_UP)\n        fx, fy = cx, cy\n        if cdir == NORTH: fy -= 1\n        elif cdir == EAST: fx += 1\n        elif cdir == SOUTH: fy += 1\n        elif cdir == WEST: fx -= 1\n\n        if 0 <= fx < WIDTH and 0 <= fy < HEIGHT:\n            # Assume agent can walk on any cell not occupied by the target primitive itself.\n            if grid[fx, fy, primitive] == 0 and ((fx, fy), cdir) not in visited:\n                visited.add(((fx, fy), cdir))\n                new_path = list(path)\n                new_path.append(ACTION_UP)\n                queue.append(((fx, fy), new_path, cdir))\n\n        # Try turning LEFT or RIGHT (no movement)\n        for action_turn in [ACTION_LEFT, ACTION_RIGHT]:\n            new_dir = (cdir - 1 + 4) % 4 if action_turn == ACTION_LEFT else (cdir + 1) % 4\n            if ((cx, cy), new_dir) not in visited:\n                visited.add(((cx, cy), new_dir))\n                new_path = list(path)\n                new_path.append(action_turn)\n                queue.append(((cx, cy), new_path, new_dir))\n\n    if final_path_actions is None:\n        return [] # No path found to any primitive's adjacent cell\n\n    # 3. Construct the full action sequence: path + turn to face + USE\n    all_actions = list(final_path_actions)\n    \n    # After following the path, adjust direction to face the primitive and then USE.\n    target_face_dir = _get_relative_direction(final_pos_after_path, final_primitive_loc_to_use)\n    if target_face_dir is not None:\n        all_actions.extend(_get_turns(final_dir_after_path, target_face_dir, actions_map))\n        all_actions.append(ACTION_USE)\n    # Else: This case should ideally not happen if final_primitive_loc_to_use was correctly identified as adjacent.\n    # If it does, it implies an issue in path or target logic, and the agent won't collect.\n\n    return all_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:14:14.053572", "function_name": "collect", "function_body": "  # Constants (defined inside the function, similar to collect_v1)\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4\n\n  # Reverse mapping: given a coordinate difference (e.g., (0,1) for down),\n  # what direction (action index 0-3) should the agent be facing to USE that cell?\n  # This assumes agent's direction updates to the last movement action.\n  _COORD_DIFF_TO_FACING_DIRECTION = {v: k for k, v in _ACTION_TO_COORD_DIFF.items()}\n\n  # 1. Get the integer index for the given primitive name\n  # The cookbook's index method will add the primitive to its internal mapping\n  # if it doesn't already exist.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is a non-grabbable item.\n  # Non-grabbable items cannot be collected using the USE action.\n  if primitive_idx in env.world.non_grabbable_indices:\n      return [] # Cannot collect this item.\n\n  # 3. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Agent already possesses the primitive, no actions needed.\n\n  # 4. Find all locations on the grid where the primitive exists\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  target_primitive_locs = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the specific primitive layer at (x, y) has a count greater than 0\n      if grid[x, y, primitive_idx] > 0:\n        target_primitive_locs.append((x, y))\n\n  if not target_primitive_locs:\n    # The primitive is not found anywhere on the current map\n    return []\n\n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a cell adjacent to any of the found primitive locations,\n  #    while also ensuring the agent is facing the primitive at the end of the path.\n  \n  # BFS state includes (current_x, current_y, current_direction).\n  # The direction is crucial because the USE action depends on it.\n  # Initial state: agent's current position and direction.\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir \n  \n  # Queue stores tuples of:\n  # ((current_x, current_y, current_direction), [list_of_actions_taken_to_reach_this_state])\n  # Using collections.deque for efficient popleft() operation.\n  queue = collections.deque([((initial_pos[0], initial_pos[1], initial_dir), [])])\n  \n  # Visited set tracks (x, y, direction) tuples to avoid re-exploring states\n  # and prevent infinite loops in the presence of cycles.\n  visited = {(initial_pos[0], initial_pos[1], initial_dir)} \n\n  best_path_to_collect = None # This will store the sequence of actions once a valid path is found\n\n  while queue:\n    (curr_x, curr_y, curr_dir), path_actions = queue.popleft()\n\n    # Check if the current agent state (position and direction) allows collection.\n    # An agent can collect if it's adjacent to a primitive AND facing it.\n    for px, py in target_primitive_locs:\n      delta_x = px - curr_x\n      delta_y = py - curr_y\n\n      # Check for adjacency using Manhattan distance (up, down, left, or right neighbor)\n      if (abs(delta_x) + abs(delta_y) == 1):\n        # Determine the direction the agent *needs* to be facing to 'USE' this specific primitive.\n        required_facing_dir = _COORD_DIFF_TO_FACING_DIRECTION.get((delta_x, delta_y))\n        \n        # If the agent's current direction matches the required facing direction,\n        # then this path has brought the agent to a position where it can collect.\n        if curr_dir == required_facing_dir:\n          best_path_to_collect = path_actions # This is the shortest path found so far.\n          break # Exit inner loop, we found a path to a collectable state.\n    \n    if best_path_to_collect is not None:\n        break # Exit outer while loop, as we've found our shortest path.\n\n    # If not yet at a collectable state, explore all possible movement actions from the current state.\n    for move_action, (dx, dy) in _ACTION_TO_COORD_DIFF.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      \n      # The agent's direction updates to the direction of its last movement.\n      next_dir = move_action \n\n      # Check if the next position is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      next_state_key = (next_x, next_y, next_dir)\n      \n      # If this new state (position and direction) has not been visited yet, add it to the queue.\n      if next_state_key not in visited:\n        # Assuming all grid cells are traversable for movement (no impassable walls, water for non-swimmer etc.).\n        # If such obstacles existed, additional checks would be needed here.\n        visited.add(next_state_key)\n        queue.append((next_state_key, path_actions + [move_action]))\n\n  if best_path_to_collect is None:\n    # If the queue becomes empty and no path was found, it means the primitive\n    # is unreachable under current conditions (e.g., no path to it or cannot face it).\n    return []\n\n  # 6. Once the agent is in the correct position and facing the primitive,\n  #    the final action required is to USE it to collect.\n  return best_path_to_collect + [USE_ACTION]", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:14:15.061456", "function_name": "collect", "function_body": "  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # Get relevant indices from the world and cookbook\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index.index(primitive)\n  water_idx = env.world.water_index\n  stone_idx = env.world.stone_index\n\n  # Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # Find all locations on the grid where the primitive exists\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  target_primitive_locs = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the specific primitive layer at (x, y) has a count greater than 0\n      if grid[x, y, primitive_idx] > 0:\n        target_primitive_locs.append((x, y))\n\n  if not target_primitive_locs:\n    # The primitive is not found anywhere on the current map\n    return []\n\n  # Define an inner helper function for checking impassable cells\n  def is_cell_impassable(x, y, target_p_idx, current_grid, water_i, stone_i):\n    \"\"\"\n    Checks if a cell at (x, y) is impassable for movement.\n    A cell is considered impassable if it contains water or stone,\n    UNLESS the target primitive itself is water or stone.\n    \"\"\"\n    if target_p_idx != water_i and current_grid[x, y, water_i] > 0:\n      return True\n    if target_p_idx != stone_i and current_grid[x, y, stone_i] > 0:\n      return True\n    return False\n\n  # Perform a Breadth-First Search (BFS) to find the shortest path\n  # to a cell adjacent to any of the found primitive locations, avoiding obstacles.\n  start_pos = current_state.pos # Agent's current (x, y) position\n  \n  # Queue stores tuples of ((current_x, current_y), [list_of_actions_to_reach_here])\n  queue = [(start_pos, [])] \n  # Set of visited (x, y) coordinates to prevent cycles and redundant path exploration\n  visited = {start_pos} \n\n  best_path = None # This will store the sequence of actions once a path is found\n\n  while queue:\n    (curr_x, curr_y), path_actions = queue.pop(0) # Dequeue the first element for BFS\n\n    # Check if the current position is adjacent to any of the target primitive locations\n    for px, py in target_primitive_locs:\n      # Using Manhattan distance to check for adjacency (up, down, left, right neighbors)\n      if (abs(curr_x - px) + abs(curr_y - py) == 1):\n        best_path = path_actions # Path found! BFS guarantees this is the shortest path.\n        break # Exit inner loop, as we found a path to *an* adjacent cell\n    \n    if best_path is not None:\n        break # Exit outer while loop, as we've found our shortest path\n\n    # Explore all possible movements from the current position\n    for action, (dx, dy) in _ACTION_TO_COORD_DIFF.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position contains an impassable object (e.g., water or stone)\n      # unless the primitive itself is water or stone.\n      if is_cell_impassable(next_x, next_y, primitive_idx, grid, water_idx, stone_idx):\n          continue\n      \n      # If this position has not been visited yet\n      if next_pos not in visited:\n        visited.add(next_pos) # Mark the new position as visited\n        # Add the new position and its path to the queue\n        queue.append((next_pos, path_actions + [action]))\n\n  if best_path is None:\n    # If the queue becomes empty and no path was found, it means the primitive\n    # is unreachable (e.g., completely surrounded by impassable cells).\n    return []\n\n  # Once adjacent to the primitive, the final action is to USE it to collect it.\n  return best_path + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T08:15:28.727205", "function_name": "collect", "function_body": "  import collections # For deque for BFS\n\n  # Constants for actions (assuming standard integer mappings as per CraftLab.action_specs())\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Mapping from (dr, dc) delta to movement action\n  # Assuming (row, col) where row increases downwards, col increases rightwards.\n  # (-1, 0) means move one row up (North).\n  # (1, 0) means move one row down (South).\n  # (0, -1) means move one col left (West).\n  # (0, 1) means move one col right (East).\n  MOVE_ACTIONS_MAP = {\n      (-1, 0): ACTION_UP,\n      (1, 0): ACTION_DOWN,\n      (0, -1): ACTION_LEFT,\n      (0, 1): ACTION_RIGHT\n  }\n\n  actions = []\n\n  # 1. Get initial observation and state information\n  obs = env.observations()\n  inventory = obs['features_dict']['inventory']\n\n  # If the primitive is already in inventory, no actions needed\n  if inventory[primitive] > 0:\n    return []\n\n  # Access the CraftState for detailed grid and world info.\n  # In a production system, one might rely only on observations.\n  # For this specific DSL context, direct access to `_current_state` is common.\n  current_state = env._current_state\n  world = current_state.world\n  grid = current_state.grid\n  current_pos = current_state.pos # (row, col)\n\n  # Check if the primitive is even grabbable according to the cookbook\n  if primitive not in world.grabbable_indices:\n    return [] # Cannot collect non-grabbable items\n\n  grid_rows, grid_cols, _ = grid.shape\n\n  # 2. Find all locations of the primitive on the grid\n  primitive_locations = []\n  for r in range(grid_rows):\n    for c in range(grid_cols):\n      if grid[r, c, primitive] > 0:\n        primitive_locations.append((r, c))\n\n  if not primitive_locations:\n    return [] # No instances of the primitive found on the grid\n\n  # 3. Use Breadth-First Search (BFS) to find the shortest path\n  #    to a cell *adjacent* to any primitive location.\n  #    We are looking for a walkable cell (r_adj, c_adj) such that\n  #    Manhattan distance to a primitive (r_prim, c_prim) is 1.\n\n  q = collections.deque([(current_pos, [])]) # (position, path_of_positions_to_here)\n  visited = {current_pos}\n\n  target_adj_pos = None\n  path_to_target_adj = None\n\n  while q:\n    (r, c), path = q.popleft()\n\n    # Check if this position (r, c) is adjacent to any primitive\n    # Iterate through all primitive locations to find an adjacent one\n    for pr, pc in primitive_locations:\n      # Check for 4-directional adjacency (Manhattan distance 1)\n      if abs(r - pr) + abs(c - pc) == 1:\n        target_adj_pos = (r, c)\n        path_to_target_adj = path\n        break # Found a suitable adjacent cell, exit inner loop\n    \n    if target_adj_pos:\n      break # Found a path to a target adjacent cell, exit BFS\n\n    # Explore 4-directional neighbors\n    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # North, South, West, East\n      next_r, next_c = r + dr, c + dc\n      next_pos = (next_r, next_c)\n\n      # Check grid boundaries\n      if not (0 <= next_r < grid_rows and 0 <= next_c < grid_cols):\n        continue\n\n      # Assumption: All cells within bounds are traversable unless they are explicitly\n      # defined as impassable walls. For this problem, we assume the agent can move\n      # into empty cells or cells containing other items (which it can pick up).\n      \n      if next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path + [next_pos]))\n\n  if not target_adj_pos:\n    return [] # No path found to any cell adjacent to a primitive\n\n  # 4. Convert the found path of positions into a sequence of actions\n  # `current_agent_pos_in_path` tracks the agent's simulated position as it follows the path.\n  current_agent_pos_in_path = current_pos\n  for next_pos_in_path in path_to_target_adj:\n    dr, dc = next_pos_in_path[0] - current_agent_pos_in_path[0], next_pos_in_path[1] - current_agent_pos_in_path[1]\n    \n    action_move = MOVE_ACTIONS_MAP.get((dr, dc))\n    if action_move is not None:\n      actions.append(action_move)\n      current_agent_pos_in_path = next_pos_in_path # Update simulated position\n    else:\n      # This case should ideally not be reached if pathfinding is correct\n      # (only generates 4-directional moves).\n      return [] # Indicate an unexpected path segment\n\n  # 5. Perform the USE action to collect the primitive\n  # Based on `CraftState.next_to` checking a \"3x3 neighborhood\",\n  # the USE action is assumed to work on any adjacent grabbable item\n  # without requiring a specific facing direction.\n  actions.append(ACTION_USE)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:15:29.688590", "function_name": "collect", "function_body": "  import collections\n\n  q = collections.deque()\n  visited = set()\n\n  # Get initial state and action mappings from the environment\n  initial_state = env._current_state\n  action_map = env.action_specs()\n\n  # Extract action values for movement and use\n  ACTIONS_LIST = [\n      action_map[\"DOWN\"],\n      action_map[\"UP\"],\n      action_map[\"LEFT\"],\n      action_map[\"RIGHT\"]\n  ]\n  USE_ACTION = action_map[\"USE\"]\n\n  # Initial state for BFS: (current_craft_state, list_of_actions_to_reach_here)\n  q.append((initial_state, []))\n  visited.add((initial_state.pos, initial_state.dir))\n\n  while q:\n      current_craft_state, current_actions = q.popleft()\n\n      # Check if the primitive is next to the agent (and thus can be collected)\n      if current_craft_state.next_to(primitive):\n          # If yes, add the USE action and return the path\n          return current_actions + [USE_ACTION]\n\n      # Explore possible movements\n      for action in ACTIONS_LIST:\n          # Simulate the step to get the next state without modifying the environment\n          # reward is always 0.0 for movement steps in CraftState.step\n          _, next_craft_state = current_craft_state.step(action)\n\n          new_pos = next_craft_state.pos\n          new_dir = next_craft_state.dir\n\n          # If this state (position and direction) has not been visited,\n          # and the agent actually moved or changed direction (to avoid cycles from blocked moves)\n          # Note: The `step` method might return the same state if movement is blocked.\n          # The `visited` set naturally handles this by only adding truly new states.\n          if (new_pos, new_dir) not in visited:\n              visited.add((new_pos, new_dir))\n              new_actions = current_actions + [action]\n              q.append((next_craft_state, new_actions))\n\n  # If the queue is exhausted and the primitive was not found next to the agent\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:16:49.817115", "function_name": "collect", "function_body": "    # Action constants from CraftLab.action_specs()\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    state = env._current_state\n    \n    # 1. Check if the primitive is already collected\n    if state.inventory[primitive] > 0:\n        return []\n\n    grid = state.grid\n    # NumPy array shape is (height, width, num_kinds)\n    HEIGHT, WIDTH, _ = grid.shape\n\n    current_pos = state.pos  # (y, x)\n\n    # 2. Find all locations on the grid where the primitive exists\n    primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n\n    if len(primitive_locations) == 0:\n        # Primitive not found anywhere on the map\n        return []\n\n    # 3. Determine all potential target positions for the agent:\n    # These are cells immediately adjacent to any primitive location.\n    adj_primitive_cells = set()\n    for py, px in primitive_locations:\n        # Check the four cardinal directions around the primitive\n        for dy, dx in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (y_change, x_change)\n            target_y, target_x = py + dy, px + dx\n            # Ensure the adjacent cell is within grid boundaries\n            if 0 <= target_y < HEIGHT and 0 <= target_x < WIDTH:\n                adj_primitive_cells.add((target_y, target_x))\n    \n    if not adj_primitive_cells:\n        # No valid adjacent cells found for any primitive (e.g., primitive on edge, no free space)\n        return []\n\n    # 4. Pathfinding (BFS) to find the shortest sequence of actions\n    # from the current position to any cell in `adj_primitive_cells`.\n    queue = collections.deque([(current_pos, [])]) # (current_position_tuple, list_of_actions_taken_to_reach_here)\n    visited = {current_pos} # Set to keep track of visited (y, x) positions to avoid cycles and redundant paths\n\n    while queue:\n        (curr_y, curr_x), path_actions = queue.popleft()\n\n        # If the current position is one of our target adjacent cells, we've found a path.\n        if (curr_y, curr_x) in adj_primitive_cells:\n            # Once at the adjacent cell, the 'USE' action will collect the primitive.\n            return path_actions + [ACTION_USE]\n\n        # Explore possible next moves (Up, Down, Left, Right)\n        move_directions_actions = [\n            ((-1, 0), ACTION_UP),\n            ((1, 0), ACTION_DOWN),\n            ((0, -1), ACTION_LEFT),\n            ((0, 1), ACTION_RIGHT),\n        ]\n\n        for (dy, dx), action_to_take in move_directions_actions:\n            next_y, next_x = curr_y + dy, curr_x + dx\n            next_pos = (next_y, next_x)\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= next_y < HEIGHT and 0 <= next_x < WIDTH):\n                continue\n\n            # Check if the next position has already been visited\n            if next_pos in visited:\n                continue\n\n            # Determine if the next position is an obstacle.\n            # A cell is considered an obstacle if it contains a non-grabbable\n            # item that is NOT a workshop (as workshops are typically traversable).\n            is_obstacle = False\n            # Get all kinds of items present at the `next_pos`\n            kinds_at_next_pos = np.where(grid[next_y, next_x, :] > 0)[0]\n\n            for kind_idx in kinds_at_next_pos:\n                if kind_idx in state.world.non_grabbable_indices and \\\n                   kind_idx not in state.world.workshop_indices:\n                    is_obstacle = True\n                    break\n            \n            # If the next position is not an obstacle, add it to the queue for exploration\n            if not is_obstacle:\n                visited.add(next_pos)\n                queue.append((next_pos, path_actions + [action_to_take]))\n\n    # If the queue becomes empty and no path to an adjacent primitive cell was found,\n    # it means the primitive is unreachable.\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:16:49.887970", "function_name": "collect", "function_body": "    import collections\n\n    # 1. Get the integer index for the primitive\n    # The cookbook.index() method creates a new index if the item is not found,\n    # so primitive_idx will always be a valid int >= 1.\n    primitive_idx = env.world.cookbook.index(primitive)\n\n    # 2. Get the current state from the CraftLab environment\n    # We assume 'env' is already reset or in the desired initial state.\n    current_state = env._current_state\n\n    # 3. Check if primitive is already in inventory\n    if current_state.inventory[primitive_idx] > 0:\n        return [] # Already collected, no actions needed.\n\n    # 4. Extract necessary information for BFS\n    grid = current_state.grid\n    start_pos = current_state.pos\n    WIDTH, HEIGHT = grid.shape[:2]\n    \n    # Get indices of entities that block movement.\n    # Assuming non_grabbable_indices are obstacles for movement.\n    non_grabbables = set(env.world.non_grabbable_indices)\n\n    # 5. Find all target primitive locations on the grid\n    target_coords = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive_idx] > 0:\n                target_coords.append((x, y))\n\n    if not target_coords:\n        return [] # Primitive not found on the map in the initial state.\n\n    # 6. Define actions and their corresponding movements (dx, dy)\n    action_map = env.action_specs()\n    # Assuming (0,0) is top-left, y increases downwards (consistent with numpy array indexing).\n    # UP moves towards smaller y, DOWN towards larger y.\n    # x increases right, decreases left.\n    dxdy = {\n        action_map['UP']: (0, -1),\n        action_map['DOWN']: (0, 1),\n        action_map['LEFT']: (-1, 0),\n        action_map['RIGHT']: (1, 0)\n    }\n    USE_ACTION = action_map['USE']\n\n    # 7. BFS setup\n    # Queue stores (x, y, list_of_actions_to_reach_here)\n    q = collections.deque([(start_pos[0], start_pos[1], [])])\n    # Visited set stores (x, y) tuples to avoid redundant exploration and cycles\n    visited = set([start_pos])\n\n    # 8. Perform BFS\n    while q:\n        cx, cy, current_path_actions = q.popleft()\n\n        # Check if the current position (cx, cy) is adjacent to any target primitive (tx, ty).\n        # \"Adjacent\" means within a 3x3 neighborhood (including diagonals) but not on the same cell.\n        for tx, ty in target_coords:\n            if abs(cx - tx) <= 1 and abs(cy - ty) <= 1 and (cx, cy) != (tx, ty):\n                # Found a path to a cell adjacent to the primitive.\n                # The final action needed is 'USE'.\n                return current_path_actions + [USE_ACTION]\n\n        # Explore neighbors\n        for action, (dx, dy) in dxdy.items():\n            nx, ny = cx + dx, cy + dy\n\n            # Check if new position is within grid boundaries\n            if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n                continue\n\n            # Check if new position has been visited\n            if (nx, ny) in visited:\n                continue\n\n            # Check for obstacles at (nx, ny)\n            is_blocked = False\n            # Iterate through all kinds present in the proposed next cell (nx, ny)\n            # and check if any of them are in the set of non-grabbable (blocking) entities.\n            for k_idx in range(grid.shape[2]):\n                if grid[nx, ny, k_idx] > 0 and k_idx in non_grabbables:\n                    is_blocked = True\n                    break\n            \n            if is_blocked:\n                continue # Cannot move to this cell\n\n            # If not blocked and not visited, add to queue\n            visited.add((nx, ny))\n            q.append((nx, ny, current_path_actions + [action]))\n\n    # If the queue is empty and no path was found to an adjacent cell\n    return [] # No path to the primitive was found.", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:18:46.611683", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from env_factory.actions, assuming CraftLab maps to these)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Mapping from movement action to (row_delta, col_delta) for direct movement\n  ACTION_TO_DELTAS = {\n      ACTION_UP: (-1, 0),    # Move North (row decreases)\n      ACTION_DOWN: (1, 0),   # Move South (row increases)\n      ACTION_LEFT: (0, -1),  # Move West (col decreases)\n      ACTION_RIGHT: (0, 1)   # Move East (col increases)\n  }\n\n  # Mapping from (row_delta, col_delta) vector to agent's internal direction index\n  # Agent directions: 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT (clockwise)\n  DIR_VEC_TO_AGENT_DIR_IDX = {\n      (-1, 0): 0, # UP\n      (0, 1): 1,  # RIGHT\n      (1, 0): 2,  # DOWN\n      (0, -1): 3  # LEFT\n  }\n\n  initial_obs = env.observations()\n  grid = initial_obs['features_dict']['features_global']\n  # Convert normalized position [0,1] to grid coordinates [0, H-1], [0, W-1]\n  current_pos_normalized = initial_obs['features_dict']['pos'] # (norm_r, norm_c)\n  height, width, _ = grid.shape\n  current_pos_r = int(round(current_pos_normalized[0] * (height - 1)))\n  current_pos_c = int(round(current_pos_normalized[1] * (width - 1)))\n  current_pos = (current_pos_r, current_pos_c)\n\n  # Get initial agent facing direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  current_dir_onehot = initial_obs['features_dict']['direction']\n  initial_dir_idx = np.argmax(current_dir_onehot)\n\n  # 1. Identify all potential (primitive_r, primitive_c) positions for the primitive item.\n  #    For each, determine candidate (agent_r, agent_c) positions adjacent to it.\n  #    We store (agent_r, agent_c, primitive_r, primitive_c) to later calculate facing direction.\n  potential_use_targets = [] # List of (agent_r, agent_c, primitive_r, primitive_c)\n  for r_prim in range(height):\n      for c_prim in range(width):\n          if grid[r_prim, c_prim, primitive] > 0: # Found an instance of the primitive\n              # Check its four cardinal neighbors for valid agent positions\n              # These are (dr_adj, dc_adj) relative to the primitive's position\n              for dr_adj, dc_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # North, South, West, East of primitive\n                  r_agent, c_agent = r_prim + dr_adj, c_prim + dc_adj\n                  \n                  # Check bounds\n                  if 0 <= r_agent < height and 0 <= c_agent < width:\n                      # Check if this agent position is traversable (not an obstacle)\n                      is_obstacle = False\n                      for k_idx in env.world.non_grabbable_indices:\n                          if grid[r_agent, c_agent, k_idx] > 0: # If cell contains a non-grabbable entity\n                              is_obstacle = True\n                              break\n                      if not is_obstacle:\n                          potential_use_targets.append((r_agent, c_agent, r_prim, c_prim))\n\n  if not potential_use_targets:\n      return [] # No primitive found or all surrounding cells are obstacles\n\n  # 2. BFS to find the shortest path to any `(agent_r, agent_c)` from `potential_use_targets`.\n  # BFS state: (r, c) - agent's current grid position\n  # BFS queue stores (r, c, list_of_actions_taken_to_reach_here)\n  q = collections.deque([(current_pos[0], current_pos[1], [])])\n  visited = set([(current_pos[0], current_pos[1])]) # Keep track of visited positions to avoid cycles\n\n  path_to_agent_pos = None\n  target_primitive_pos_for_use = None # (pr, pc) of the primitive to collect\n  final_agent_pos_for_use = None # (tr, tc) where agent will stand to collect\n\n  while q:\n      r, c, actions_so_far = q.popleft()\n\n      # Check if this position is one of our desired target agent positions\n      for tr, tc, pr, pc in potential_use_targets:\n          if r == tr and c == tc:\n              path_to_agent_pos = list(actions_so_far) # Store the actions\n              final_agent_pos_for_use = (tr, tc)\n              target_primitive_pos_for_use = (pr, pc)\n              q.clear() # Found shortest path, stop BFS\n              break\n      if not q: # If queue cleared or became empty after checking\n          break\n\n      # Explore neighbors by applying movement actions\n      for action_val, (dr, dc) in ACTION_TO_DELTAS.items():\n          nr, nc = r + dr, c + dc # New potential position\n\n          # Check bounds and if already visited\n          if 0 <= nr < height and 0 <= nc < width and (nr, nc) not in visited:\n              # Check if the new position is an obstacle\n              is_obstacle = False\n              for k_idx in env.world.non_grabbable_indices:\n                  if grid[nr, nc, k_idx] > 0:\n                      is_obstacle = True\n                      break\n              if not is_obstacle:\n                  visited.add((nr, nc))\n                  new_actions = actions_so_far + [action_val]\n                  q.append((nr, nc, new_actions))\n\n  if not path_to_agent_pos:\n      return [] # No path found to any primitive's adjacent cell\n\n  # 3. Path found! Now, determine rotations and the USE action.\n  all_final_actions = list(path_to_agent_pos) # Start with actions to reach target_agent_pos\n\n  # Simulate agent's direction after executing the movement path.\n  # Assuming moving UP sets direction to UP, moving RIGHT sets direction to RIGHT, etc.\n  simulated_current_dir_idx = initial_dir_idx\n  if all_final_actions: # If movements occurred\n      # The last movement action dictates the final simulated direction\n      last_action = all_final_actions[-1]\n      if last_action == ACTION_UP:\n          simulated_current_dir_idx = 0 # UP\n      elif last_action == ACTION_RIGHT:\n          simulated_current_dir_idx = 1 # RIGHT\n      elif last_action == ACTION_DOWN:\n          simulated_current_dir_idx = 2 # DOWN\n      elif last_action == ACTION_LEFT:\n          simulated_current_dir_idx = 3 # LEFT\n  # If no movements, simulated_current_dir_idx remains initial_dir_idx\n\n  # Calculate the vector from agent's final position to the primitive's position\n  dr_to_prim = target_primitive_pos_for_use[0] - final_agent_pos_for_use[0]\n  dc_to_prim = target_primitive_pos_for_use[1] - final_agent_pos_for_use[1]\n  vec_to_prim = (dr_to_prim, dc_to_prim)\n\n  # Determine the required agent direction to face the primitive\n  required_dir_idx = DIR_VEC_TO_AGENT_DIR_IDX.get(vec_to_prim)\n\n  if required_dir_idx is None:\n      # This should ideally not happen if `vec_to_prim` is one of the 4 cardinal directions,\n      # which it must be given how `potential_use_targets` are generated.\n      return [] # Cannot properly face the primitive to use it\n\n  # Calculate the shortest rotations needed\n  # Agent directions are 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT (clockwise order)\n  rot_diff = (required_dir_idx - simulated_current_dir_idx + 4) % 4\n\n  if rot_diff == 1: # 90 degrees clockwise\n      all_final_actions.append(ACTION_RIGHT)\n  elif rot_diff == 2: # 180 degrees\n      all_final_actions.append(ACTION_RIGHT)\n      all_final_actions.append(ACTION_RIGHT)\n  elif rot_diff == 3: # 90 degrees counter-clockwise (or 270 clockwise)\n      all_final_actions.append(ACTION_LEFT)\n\n  # Finally, add the USE action\n  all_final_actions.append(ACTION_USE)\n\n  return all_final_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:18:46.681411", "function_name": "collect", "function_body": "    actions_taken = []\n    action_map = env.action_specs()\n\n    # Map the action names to their integer values for convenience\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    obs = env.reset()\n    current_inventory = obs['features_dict']['inventory']\n\n    # Helper for relative direction vectors corresponding to agent's facing direction.\n    # These are (dr, dc) = (row_change, col_change) for the cell directly in front of the agent.\n    # Agent_dir: 0=East, 1=South, 2=West, 3=North (based on DMLab conventions)\n    AGENT_DIR_VECTORS = {\n        0: (0, 1),  # East (right in grid coordinates)\n        1: (1, 0),  # South (down in grid coordinates)\n        2: (0, -1), # West (left in grid coordinates)\n        3: (-1, 0)  # North (up in grid coordinates)\n    }\n\n    MAX_COLLECT_STEPS = 200 # A safety limit for actions to prevent infinite loops\n\n    for _ in range(MAX_COLLECT_STEPS):\n        # 1. Check if primitive is already collected\n        if current_inventory[primitive] > 0:\n            return actions_taken\n\n        # Get current observations\n        obs = env.observations()\n        features_dict = obs['features_dict']\n        ego_grid = features_dict['features_ego']\n        agent_dir = np.argmax(features_dict['direction']) # Convert one-hot direction to integer\n\n        # Determine the center of the egocentric grid (agent's position within ego_grid)\n        window_h, window_w, _ = ego_grid.shape\n        mid_r, mid_c = window_h // 2, window_w // 2\n\n        action_to_take = None # Action to be decided in this step\n\n        # Find all locations of the primitive in the egocentric view\n        # This returns (row_idx, col_idx) tuples relative to the ego_grid's top-left corner\n        primitive_locations = np.argwhere(ego_grid[:, :, primitive] == 1)\n        \n        # Filter for directly adjacent cells (Manhattan distance 1 from agent) for potential USE action\n        adjacent_primitive_coords = []\n        for r_idx, c_idx in primitive_locations:\n            dr, dc = r_idx - mid_r, c_idx - mid_c # Relative position (row_change, col_change) from agent\n            if abs(dr) + abs(dc) == 1: # Manhattan distance of 1 means it's adjacent\n                adjacent_primitive_coords.append((dr, dc))\n\n        if adjacent_primitive_coords:\n            # We found at least one primitive directly next to us.\n            # Prioritize using it if we are already facing one.\n            facing_primitive = False\n            for dr, dc in adjacent_primitive_coords:\n                if AGENT_DIR_VECTORS[agent_dir] == (dr, dc):\n                    facing_primitive = True\n                    break # Found one we are directly facing\n\n            if facing_primitive:\n                action_to_take = ACTION_USE\n            else:\n                # Not facing. Pick the first adjacent one and determine action to turn towards it.\n                dr, dc = adjacent_primitive_coords[0] # Arbitrarily pick the first one found\n                target_dir = None\n                for d, vec in AGENT_DIR_VECTORS.items():\n                    if vec == (dr, dc):\n                        target_dir = d\n                        break\n                \n                if target_dir is not None:\n                    # Calculate shortest turn. Assuming ACTION_RIGHT turns clockwise.\n                    turn_diff = (target_dir - agent_dir + 4) % 4\n                    if turn_diff == 1: # Target is 1 step clockwise from current direction\n                        action_to_take = ACTION_RIGHT\n                    elif turn_diff == 3: # Target is 1 step counter-clockwise\n                        action_to_take = ACTION_LEFT\n                    else: # turn_diff == 2 (180 degree turn). Can use either, pick RIGHT.\n                        action_to_take = ACTION_RIGHT\n                else:\n                    # Fallback for unexpected cases (should ideally not happen if adjacent_primitive_coords is non-empty)\n                    action_to_take = np.random.choice([ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT])\n        \n        elif primitive_locations.size > 0: # Primitive visible but not adjacent\n            # Find the closest primitive (by Manhattan distance) to move towards\n            min_dist = float('inf')\n            closest_dr, closest_dc = None, None\n            for r_idx, c_idx in primitive_locations:\n                dr, dc = r_idx - mid_r, c_idx - mid_c\n                if dr == 0 and dc == 0: continue # Skip agent's own cell if primitive is there\n                dist = abs(dr) + abs(dc)\n                if dist < min_dist:\n                    min_dist = dist\n                    closest_dr, closest_dc = dr, dc\n            \n            if closest_dr is not None:\n                # Prioritize movement in the direction of the larger displacement component\n                if abs(closest_dr) > abs(closest_dc):\n                    action_to_take = ACTION_DOWN if closest_dr > 0 else ACTION_UP\n                elif abs(closest_dc) > 0: # Check if there's horizontal displacement if vertical is 0\n                    action_to_take = ACTION_RIGHT if closest_dc > 0 else ACTION_LEFT\n                else: # This case implies closest_dr and closest_dc are both 0 (already skipped) or extremely close but not adjacent\n                    action_to_take = np.random.choice([ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT])\n            else: # No valid primitive location found (e.g., only on agent's cell or list was effectively empty)\n                action_to_take = np.random.choice([ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT])\n\n        else: # Primitive not visible at all in the egocentric view, explore randomly\n            action_to_take = np.random.choice([ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT])\n\n        # Fallback to ensure an action is always chosen before stepping the environment\n        if action_to_take is None:\n            action_to_take = np.random.choice([ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT])\n\n        # Execute the chosen action\n        _, done, next_obs = env.step(action_to_take)\n        actions_taken.append(action_to_take)\n        current_inventory = next_obs['features_dict']['inventory']\n        \n        if done:\n            # If the environment signals 'done' (e.g., max_steps reached by the environment itself),\n            # check if we succeeded before exiting the collection loop.\n            if current_inventory[primitive] > 0:\n                return actions_taken\n            break # Exit the loop if the environment is done\n\n    # Return the list of actions taken. The primitive might or might not have been collected\n    # if MAX_COLLECT_STEPS was reached or the environment ended prematurely.\n    return actions_taken", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:20:08.588394", "function_name": "collect", "function_body": "    import collections\n\n    # Define action constants based on the prompt's action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    current_state = env._current_state\n    grid = current_state.grid\n    agent_pos = current_state.pos  # tuple (r, c)\n    height, width, _ = grid.shape  # grid shape is (rows, cols, n_kinds)\n\n    # Get non-grabbable indices from the CraftWorld configuration.\n    # These are effectively obstacles that the agent cannot walk into.\n    # env is CraftLab, env.world is CraftWorld, env.world.non_grabbable_indices is the set\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    def is_valid_coord(r, c):\n        \"\"\"Checks if a given coordinate (r, c) is within the grid boundaries.\"\"\"\n        return 0 <= r < height and 0 <= c < width\n\n    def is_walkable(r, c):\n        \"\"\"\n        Checks if a cell (r, c) is walkable.\n        A cell is walkable if it's within bounds and does not contain any non-grabbable item.\n        \"\"\"\n        if not is_valid_coord(r, c):\n            return False\n        # Iterate through known non-grabbable indices. If any are present at (r,c), it's not walkable.\n        for idx in non_grabbable_indices:\n            if grid[r, c, idx] > 0:  # Assuming > 0 means presence/count\n                return False\n        return True\n\n    # BFS will find the shortest path from the agent's current position\n    # to any cell that is directly adjacent to the target primitive.\n    # We use a tuple for position (row, col) to make it hashable for the visited set.\n    q = collections.deque([(agent_pos, [])])  # (current_position, path_taken_to_reach_here)\n    visited = {agent_pos}  # Set of visited positions to prevent cycles and redundant exploration\n\n    # Define possible moves and their corresponding actions\n    # (dr, dc) tuple represents the change in row and column\n    moves = {\n        (-1, 0): ACTION_UP,    # Up\n        (1, 0): ACTION_DOWN,   # Down\n        (0, -1): ACTION_LEFT,  # Left\n        (0, 1): ACTION_RIGHT,  # Right\n    }\n\n    while q:\n        (r, c), path_actions = q.popleft()\n\n        # Check if the current position (r, c) is adjacent to the primitive.\n        # This means the primitive is in one of the 4 cardinal directions from (r, c).\n        for dr, dc in moves.keys(): # Iterate through relative neighbor coordinates\n            pr, pc = r + dr, c + dc  # Potential primitive location\n\n            if is_valid_coord(pr, pc) and grid[pr, pc, primitive] > 0:\n                # Found a cell (r, c) that is adjacent to the primitive at (pr, pc).\n                # The path to (r, c) is stored in 'path_actions'.\n                # Now, add the USE action to collect the primitive.\n                # This assumes the USE action works for any adjacent primitive regardless of specific facing direction.\n                return path_actions + [ACTION_USE]\n\n        # If the current position (r, c) is not adjacent to the primitive,\n        # explore its walkable neighbors to continue the pathfinding.\n        for (dr, dc), action in moves.items():\n            nr, nc = r + dr, c + dc\n            next_pos = (nr, nc)\n\n            if is_walkable(nr, nc) and next_pos not in visited:\n                visited.add(next_pos)\n                q.append((next_pos, path_actions + [action]))\n\n    # If the queue is exhausted and no path to an adjacent primitive was found,\n    # it means the primitive is unreachable or not present.\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:20:08.667732", "function_name": "collect", "function_body": "    # Action constants for readability\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    initial_state = env._current_state\n    \n    # Queue for Breadth-First Search (BFS)\n    # Each element is a tuple: (current_CraftState, list_of_actions_taken_to_reach_this_state)\n    q = collections.deque([(initial_state, [])])\n    \n    # Visited set to prevent cycles and redundant exploration.\n    # A state is defined by (agent_position_tuple, agent_direction_int, inventory_tuple).\n    # Inventory must be converted to a tuple to be hashable.\n    visited = set()\n    visited.add((initial_state.pos, initial_state.dir, tuple(initial_state.inventory)))\n\n    # Get a reference to the CraftWorld instance for item properties\n    world = initial_state.world\n    \n    # Determine if the primitive requires a 'USE' action to be collected.\n    # Primitive resources are either grabbable (picked up by moving onto them)\n    # or non-grabbable (often require a 'USE' action when adjacent, e.g., water, stone).\n    # We assume any primitive that is non-grabbable requires 'USE'.\n    # We also ensure it's actually one of the primitive resources defined in the cookbook.\n    is_use_resource = (primitive in world.non_grabbable_indices and\n                       primitive in world.cookbook.primitives)\n\n    while q:\n        current_state, current_path = q.popleft()\n\n        # Goal Check 1: The primitive is already in the agent's inventory.\n        # This covers cases where the agent starts with the item, or picked it up\n        # by moving onto a grabbable item in a previous step.\n        if current_state.inventory[primitive] > 0:\n            return current_path\n\n        # Goal Check 2: If the primitive is a 'USE' resource, check if the agent\n        # is currently adjacent to it and if performing a 'USE' action would collect it.\n        if is_use_resource and current_state.next_to(primitive):\n            # Simulate the 'USE' action from the current state\n            reward_use, state_after_use = current_state.step(USE)\n            \n            # If this 'USE' action successfully collected the primitive, we found the shortest path.\n            if state_after_use.inventory[primitive] > 0:\n                return current_path + [USE]\n            \n            # Important: Even if the 'USE' action didn't directly yield *this* primitive\n            # (e.g., it failed, or yielded something else), the resulting state\n            # might still be a valid new state for further exploration in a general BFS.\n            # Add it to the queue if it's a new state to ensure shortest path.\n            state_key_after_use = (state_after_use.pos, state_after_use.dir, tuple(state_after_use.inventory))\n            if state_key_after_use not in visited:\n                visited.add(state_key_after_use)\n                q.append((state_after_use, current_path + [USE]))\n\n        # Explore movement actions (UP, DOWN, LEFT, RIGHT).\n        # These actions change the agent's position and potentially direction,\n        # leading to new areas or picking up grabbable items.\n        for action in [UP, DOWN, LEFT, RIGHT]:\n            reward, next_state = current_state.step(action)\n            \n            state_key = (next_state.pos, next_state.dir, tuple(next_state.inventory))\n            \n            # Only add the new state to the queue if it hasn't been visited before.\n            if state_key not in visited:\n                visited.add(state_key)\n                q.append((next_state, current_path + [action]))\n\n    # If the BFS queue becomes empty and the primitive has not been collected,\n    # it means the primitive is unreachable from the initial state.\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:21:55.128177", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (based on CraftLab.action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Direction constants (based on CraftState internal representation)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Movement deltas for UP/DOWN actions (dx, dy)\n  # Note: UP moves towards negative Y, DOWN towards positive Y\n  MOVE_DELTAS = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n  }\n\n  # Deltas for determining the cell in front based on agent's direction (dx, dy)\n  DIR_TO_DELTA = {\n      DIR_EAST: (1, 0),\n      DIR_SOUTH: (0, 1),\n      DIR_WEST: (-1, 0),\n      DIR_NORTH: (0, -1),\n  }\n\n  # Mapping relative position (dx, dy) to the required agent direction to face it\n  RELATIVE_POS_TO_DIR = {\n      (1, 0): DIR_EAST,   # Primitive is to the (agent's) right\n      (-1, 0): DIR_WEST,  # Primitive is to the (agent's) left\n      (0, 1): DIR_SOUTH,  # Primitive is below (agent's)\n      (0, -1): DIR_NORTH, # Primitive is above (agent's)\n  }\n\n  # Maps (current_dir, target_dir) to a list of turn actions (LEFT/RIGHT)\n  # LEFT = CCW turn, RIGHT = CW turn\n  TURN_MAP = {\n      (DIR_EAST, DIR_SOUTH): [RIGHT],\n      (DIR_EAST, DIR_WEST): [RIGHT, RIGHT],\n      (DIR_EAST, DIR_NORTH): [LEFT],\n\n      (DIR_SOUTH, DIR_WEST): [RIGHT],\n      (DIR_SOUTH, DIR_NORTH): [RIGHT, RIGHT],\n      (DIR_SOUTH, DIR_EAST): [LEFT],\n\n      (DIR_WEST, DIR_NORTH): [RIGHT],\n      (DIR_WEST, DIR_EAST): [RIGHT, RIGHT],\n      (DIR_WEST, DIR_SOUTH): [LEFT],\n\n      (DIR_NORTH, DIR_EAST): [RIGHT],\n      (DIR_NORTH, DIR_SOUTH): [RIGHT, RIGHT],\n      (DIR_NORTH, DIR_WEST): [LEFT],\n\n      # No turns needed if already facing the correct direction\n      (DIR_EAST, DIR_EAST): [],\n      (DIR_SOUTH, DIR_SOUTH): [],\n      (DIR_WEST, DIR_WEST): [],\n      (DIR_NORTH, DIR_NORTH): [],\n  }\n\n  # Get initial observations from the environment\n  obs = env.reset()\n  initial_pos = tuple(obs['features_dict']['pos'].astype(int))\n  initial_dir = np.argmax(obs['features_dict']['direction']) # Agent's initial facing direction\n  grid = obs['features_dict']['features_global']\n  # inventory = obs['features_dict']['inventory'] # Not used for pathfinding\n\n  # Extract grid dimensions\n  height, width, n_kinds = grid.shape[0], grid.shape[1], grid.shape[2] # Grid is (height, width, n_kinds)\n\n  # Get indices of non-grabbable entities which act as obstacles\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a cell (x, y) is traversable\n  def is_traversable(px, py):\n      # Check bounds\n      if not (0 <= px < width and 0 <= py < height):\n          return False\n      # Check for non-grabbable obstacles\n      for idx in non_grabbable_indices:\n          if grid[py, px, idx] > 0: # Grid is indexed [y, x, kind]\n              return False\n      return True\n\n  # 1. Locate all instances of the primitive in the grid\n  primitive_locations = []\n  for y in range(height):\n      for x in range(width):\n          if grid[y, x, primitive] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      return [] # Primitive not found in the environment\n\n  # 2. Select the closest primitive location as the target\n  target_primitive_loc = None\n  min_dist = float('inf')\n  for px, py in primitive_locations:\n      dist = abs(px - initial_pos[0]) + abs(py - initial_pos[1]) # Manhattan distance\n      if dist < min_dist:\n          min_dist = dist\n          target_primitive_loc = (px, py)\n\n  if target_primitive_loc is None:\n      return [] # Should not happen if primitive_locations is not empty\n\n\n  final_actions = []\n\n  # 3. BFS to find a path to a cell *adjacent* to the target primitive\n  # BFS state: (current_x, current_y, list_of_actions_to_reach_here)\n  q = collections.deque([(initial_pos, [])])\n  visited_bfs = {initial_pos} # Keep track of visited (x,y) positions\n\n  path_to_adj_cell = None # Will store the sequence of actions\n  target_adjacent_pos = None # Will store the (x,y) position of the cell adjacent to primitive\n\n  while q and path_to_adj_cell is None:\n      current_pos, actions_taken = q.popleft()\n      cx, cy = current_pos\n\n      # Check possible moves (UP/DOWN actions only, as LEFT/RIGHT are turns)\n      for action, (dx, dy) in MOVE_DELTAS.items():\n          next_pos = (cx + dx, cy + dy)\n          nx, ny = next_pos\n\n          if next_pos not in visited_bfs and is_traversable(nx, ny):\n              # Check if this new position is adjacent to the target primitive\n              # Adjacency means Manhattan distance of 1\n              if abs(nx - target_primitive_loc[0]) + abs(ny - target_primitive_loc[1]) == 1:\n                  target_adjacent_pos = next_pos\n                  path_to_adj_cell = actions_taken + [action]\n                  break # Path found, exit inner loop\n              \n              # If not adjacent yet, add to queue and mark as visited\n              visited_bfs.add(next_pos)\n              q.append((next_pos, actions_taken + [action]))\n      \n  if path_to_adj_cell is None:\n      return [] # No path found to any cell adjacent to the primitive\n\n  final_actions.extend(path_to_adj_cell)\n\n  # 4. Agent is now at target_adjacent_pos. Determine required turns and USE\n  # The agent's direction does not change during UP/DOWN moves. So, it's still initial_dir.\n  current_facing_dir = initial_dir\n\n  # Calculate the relative position of the primitive from the agent's current (adjacent) position\n  relative_dx = target_primitive_loc[0] - target_adjacent_pos[0]\n  relative_dy = target_primitive_loc[1] - target_adjacent_pos[1]\n  \n  # Determine the direction the agent needs to face\n  required_facing_dir = RELATIVE_POS_TO_DIR.get((relative_dx, relative_dy))\n\n  if required_facing_dir is None:\n      # This case should ideally not happen if target_adjacent_pos is truly adjacent\n      return []\n\n  # Get the sequence of turn actions to align the agent\n  turn_sequence = TURN_MAP.get((current_facing_dir, required_facing_dir))\n  \n  if turn_sequence is None:\n      # This should always find a sequence (even empty if already aligned)\n      return []\n\n  final_actions.extend(turn_sequence)\n  final_actions.append(USE)\n\n  return final_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:21:56.064317", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (defined locally as per instructions)\n  _DOWN = 0\n  _UP = 1\n  _LEFT = 2\n  _RIGHT = 3\n  _USE = 4\n\n  # Direction constants used in CraftState.dir\n  _DIR_NORTH = 0\n  _DIR_EAST = 1\n  _DIR_SOUTH = 2\n  _DIR_WEST = 3\n\n  # (dx, dy) for each move action\n  _MOVE_DELTAS = {\n      _DOWN: (0, 1),\n      _UP: (0, -1),\n      _LEFT: (-1, 0),\n      _RIGHT: (1, 0),\n  }\n\n  # The direction the agent faces after taking a move action (assuming agent turns to face direction of movement)\n  _MOVE_TO_DIR = {\n      _DOWN: _DIR_SOUTH,\n      _UP: _DIR_NORTH,\n      _LEFT: _DIR_WEST,\n      _RIGHT: _DIR_EAST,\n  }\n\n  # (dx, dy) for each facing direction (for calculating what's in front of the agent)\n  _DIR_DELTAS = {\n      _DIR_NORTH: (0, -1),\n      _DIR_EAST: (1, 0),\n      _DIR_SOUTH: (0, 1),\n      _DIR_WEST: (-1, 0),\n  }\n\n  # Maps (dx, dy) of a direction vector to its integer representation\n  _DELTA_TO_DIR = {v: k for k, v in _DIR_DELTAS.items()}\n\n  def _get_turn_actions(current_dir, target_dir):\n      \"\"\"Returns a list of actions (LEFT/RIGHT) to turn from current_dir to target_dir.\"\"\"\n      actions = []\n      if current_dir == target_dir:\n          return []\n      \n      # Calculate shortest turn. Directions are 0, 1, 2, 3 (N, E, S, W)\n      # `diff` represents the number of clockwise turns needed\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Turn right once\n          actions.append(_RIGHT)\n      elif diff == 2: # Turn 180 degrees (two rights or two lefts); prefer two rights\n          actions.extend([_RIGHT, _RIGHT])\n      elif diff == 3: # Turn left once (equivalent to three rights clockwise)\n          actions.append(_LEFT)\n      return actions\n\n  state = env._current_state\n  \n  # If the primitive is already in the inventory, no actions are needed.\n  if state.inventory[primitive] > 0:\n      return []\n\n  WIDTH, HEIGHT, N_KINDS = state.grid.shape\n  \n  # Get obstacle indices. These are entities that cannot be picked up and block movement.\n  obstacle_indices = env.world.non_grabbable_indices\n  \n  # BFS Initialization\n  # The queue stores tuples: ((current_pos_x, current_pos_y), current_dir, actions_path_list)\n  queue = collections.deque([((state.pos[0], state.pos[1]), state.dir, [])]) \n  # The visited set stores tuples: ((pos_x, pos_y), dir_int) to avoid cycles and redundant exploration\n  visited = set([((state.pos[0], state.pos[1]), state.dir)]) \n\n  # Pre-calculate all valid positions and required facing directions from which the agent can USE the primitive.\n  # This set will store: { ((adjacent_x, adjacent_y), required_facing_dir_int) }\n  target_use_config_options = set()\n\n  for x_grid in range(WIDTH):\n      for y_grid in range(HEIGHT):\n          # If this cell contains an instance of the target primitive\n          if state.grid[x_grid, y_grid, primitive] > 0:\n              # Check the 4 adjacent positions around the primitive's cell\n              for move_action_key, (dx_from_adj, dy_from_adj) in _MOVE_DELTAS.items():\n                  # An adjacent cell (adj_x, adj_y) would be such that moving from it\n                  # using (dx_from_adj, dy_from_adj) leads to (x_grid, y_grid).\n                  # So, the adjacent cell is (x_grid - dx_from_adj, y_grid - dy_from_adj).\n                  adj_x, adj_y = x_grid - dx_from_adj, y_grid - dy_from_adj \n                  \n                  if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n                      # Check if the adjacent cell itself is an obstacle (agent cannot move into it)\n                      is_obstacle_at_adj = False\n                      for idx in obstacle_indices:\n                          if state.grid[adj_x, adj_y, idx] > 0:\n                              is_obstacle_at_adj = True\n                              break\n                      if is_obstacle_at_adj:\n                          continue # Cannot move into an obstacle cell\n\n                      # Calculate the direction the agent needs to face when at (adj_x, adj_y) to USE (x_grid, y_grid)\n                      # This is the vector from (adj_x, adj_y) to (x_grid, y_grid)\n                      face_dx, face_dy = x_grid - adj_x, y_grid - adj_y\n                      \n                      required_facing_dir = _DELTA_TO_DIR.get((face_dx, face_dy))\n                      if required_facing_dir is not None:\n                          target_use_config_options.add(((adj_x, adj_y), required_facing_dir))\n\n  # BFS loop to find the shortest path to a target_use_config_option\n  while queue:\n      (curr_pos_x, curr_pos_y), curr_dir, path_actions = queue.popleft()\n\n      # Check if the current (position, direction) configuration is one of our target_use_config_options\n      if ((curr_pos_x, curr_pos_y), curr_dir) in target_use_config_options:\n          # If so, we have found a path to a valid position and facing direction.\n          # The next action should be USE.\n          return path_actions + [_USE]\n\n      # Explore possible next moves (UP, DOWN, LEFT, RIGHT)\n      for action in [_DOWN, _UP, _LEFT, _RIGHT]:\n          dx_move, dy_move = _MOVE_DELTAS[action]\n          next_pos_x, next_pos_y = curr_pos_x + dx_move, curr_pos_y + dy_move\n          \n          # Check grid boundaries for the next position\n          if not (0 <= next_pos_x < WIDTH and 0 <= next_pos_y < HEIGHT):\n              continue\n          \n          # Check if the next position is an obstacle (contains a non-grabbable item)\n          is_obstacle_at_next_pos = False\n          for idx in obstacle_indices:\n              if state.grid[next_pos_x, next_pos_y, idx] > 0:\n                  is_obstacle_at_next_pos = True\n                  break\n          if is_obstacle_at_next_pos:\n              continue \n\n          # The agent's direction updates to face the direction of the movement.\n          next_dir = _MOVE_TO_DIR[action]\n\n          # Only add to the queue if this (position, direction) state has not been visited before\n          if ((next_pos_x, next_pos_y), next_dir) not in visited:\n              visited.add(((next_pos_x, next_pos_y), next_dir))\n              queue.append(((next_pos_x, next_pos_y), next_dir, path_actions + [action]))\n      \n      # Also explore turning actions from the current position (turns do not change position)\n      for turn_action in [_LEFT, _RIGHT]:\n          # Simulate the new direction after taking a turn action\n          simulated_dir = (curr_dir + (1 if turn_action == _RIGHT else -1) + 4) % 4\n          \n          # Only add to the queue if this (position, direction) state has not been visited before\n          if ((curr_pos_x, curr_pos_y), simulated_dir) not in visited:\n              visited.add(((curr_pos_x, curr_pos_y), simulated_dir))\n              queue.append(((curr_pos_x, curr_pos_y), simulated_dir, path_actions + [turn_action]))\n\n  return [] # No path found to collect the primitive", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:23:07.270572", "function_name": "collect", "function_body": "  # Action constants based on CraftLab.action_specs: DOWN->0, UP->1, LEFT->2, RIGHT->3, USE->4\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  actions_list = []\n  # Define a reasonable safety limit for the number of actions to prevent infinite loops\n  # in case the goal is unachievable or logic gets stuck.\n  MAX_ACTIONS_LIMIT = 500 \n\n  for _ in range(MAX_ACTIONS_LIMIT):\n    obs = env.observations()\n    inventory = obs['features_dict']['inventory']\n\n    # 1. Check if the primitive is already collected (goal achieved)\n    if inventory[primitive] > 0:\n      break\n\n    current_grid = obs['features_dict']['features_global']\n    # `pos` from features_dict is described as numpy.ndarray. Convert to an integer tuple (row, col)\n    # for consistent indexing with grid coordinates.\n    current_pos = tuple(obs['features_dict']['pos'].astype(int))\n\n    action_to_take = -1 # Initialize with an invalid action to ensure it's explicitly set\n\n    # 2. Check if the agent is currently next to the primitive.\n    # CraftLab's _current_state (a CraftState instance) has a next_to method.\n    if env._current_state.next_to(primitive):\n      action_to_take = USE\n    else:\n      # 3. If not adjacent, find the closest instance of the primitive on the map.\n      # np.argwhere returns (row, col) coordinates where the primitive exists.\n      primitive_locs = np.argwhere(current_grid[:, :, primitive] > 0)\n\n      if len(primitive_locs) > 0:\n        # Calculate Manhattan distance to all primitive locations and pick the closest one.\n        min_dist = float('inf')\n        target_pos = None\n\n        for r, c in primitive_locs:\n          dist = abs(r - current_pos[0]) + abs(c - current_pos[1])\n          if dist < min_dist:\n            min_dist = dist\n            target_pos = (r, c)\n\n        # 4. Determine the best movement action towards the target.\n        # Prioritize movement along the dimension with the larger difference.\n        dr = target_pos[0] - current_pos[0]\n        dc = target_pos[1] - current_pos[1]\n\n        if abs(dr) > abs(dc): # More vertical distance, prioritize UP/DOWN\n          if dr < 0:\n            action_to_take = UP\n          else: # dr > 0\n            action_to_take = DOWN\n        else: # More horizontal distance, or distances are equal (prioritize LEFT/RIGHT)\n          if dc < 0:\n            action_to_take = LEFT\n          else: # dc > 0 or dc == 0 (if agent is at target, next_to check should have handled USE)\n            action_to_take = RIGHT\n      else:\n        # 5. Primitive not found on the current global grid.\n        # This implies it's not currently spawned, visible, or the map is unexplored.\n        # In this case, perform a simple exploration action (e.g., random movement)\n        # hoping to eventually reveal the primitive.\n        action_to_take = np.random.choice([UP, DOWN, LEFT, RIGHT])\n\n    # Fallback: if `action_to_take` somehow wasn't set (e.g., an unexpected edge case),\n    # default to a random movement to avoid errors.\n    if action_to_take == -1:\n        action_to_take = np.random.choice([UP, DOWN, LEFT, RIGHT])\n\n    actions_list.append(action_to_take)\n    # Perform the action in the environment. Reward is always 0.0 in this implementation.\n    _, done, _ = env.step(action_to_take)\n\n    # Check if the environment signaled `done` (e.g., max_steps reached, or goal satisfied externally).\n    if done:\n      # print(f\"collect_v2: Environment done status reached after {len(actions_list)} steps.\")\n      break\n\n  # If the loop completes without collecting the primitive, it means MAX_ACTIONS_LIMIT was reached.\n  # if inventory[primitive] == 0:\n  #   print(f\"Warning: collect_v2 failed to collect primitive {primitive} within {MAX_ACTIONS_LIMIT} steps.\")\n\n  return actions_list", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:23:07.339670", "function_name": "collect", "function_body": "    import collections\n\n    # Action constants as defined by CraftLab.action_specs()\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Map movement actions to (dr, dc) deltas\n    moves = {\n        UP: (-1, 0),\n        DOWN: (1, 0),\n        LEFT: (0, -1),\n        RIGHT: (0, 1)\n    }\n    move_actions = [DOWN, UP, LEFT, RIGHT]\n\n    # Get the current CraftState instance from the CraftLab environment\n    state = env._current_state\n    \n    # Check if the primitive is already in the agent's inventory\n    if state.inventory[primitive] > 0:\n        return []\n\n    # Pre-calculate all locations where the primitive item exists on the grid\n    primitive_locations = set() # Use a set for efficient O(1) lookups\n    grid_h, grid_w, _ = state.grid.shape\n    for r in range(grid_h):\n        for c in range(grid_w):\n            if state.grid[r, c, primitive] > 0:\n                primitive_locations.add((r, c))\n\n    # If the primitive is not found anywhere on the grid, it cannot be collected\n    if not primitive_locations:\n        return []\n\n    # Initialize Breadth-First Search (BFS) for pathfinding\n    queue = collections.deque()\n    visited = set()\n\n    # Start BFS from the agent's current position\n    start_pos = state.pos # (row, col) tuple\n    # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n    queue.append((start_pos, [])) \n    visited.add(start_pos)\n\n    best_collection_path = None\n\n    while queue:\n        current_pos, current_path = queue.popleft()\n        r, c = current_pos\n\n        # Check if the current position is on or adjacent to a primitive item.\n        # The 'USE' action picks up items from the current cell or adjacent cells.\n        is_adjacent_or_on_primitive = False\n        if (r, c) in primitive_locations:\n            # Agent is directly on the primitive item\n            is_adjacent_or_on_primitive = True\n        else:\n            # Check 4-directional neighbors for primitive items\n            for dr, dc in moves.values():\n                nr, nc = r + dr, c + dc\n                # Ensure neighbor is within grid bounds before checking if it contains primitive\n                if 0 <= nr < grid_h and 0 <= nc < grid_w and (nr, nc) in primitive_locations:\n                    is_adjacent_or_on_primitive = True\n                    break\n\n        if is_adjacent_or_on_primitive:\n            # Found a position from which the primitive can be collected.\n            # Append the 'USE' action to the path and we are done, as BFS finds shortest path.\n            best_collection_path = current_path + [USE]\n            break \n\n        # Explore valid movement options from the current position\n        for action in move_actions:\n            dr, dc = moves[action]\n            next_r, next_c = r + dr, c + dc\n            next_pos = (next_r, next_c)\n\n            # Check if the next position is within grid boundaries and has not been visited\n            if 0 <= next_r < grid_h and 0 <= next_c < grid_w and next_pos not in visited:\n                # Determine if the next position is an obstacle\n                # An obstacle is any cell containing a non-grabbable item.\n                is_obstacle = False\n                for k_idx in range(state.world.cookbook.n_kinds):\n                    if state.grid[next_r, next_c, k_idx] > 0: # If there's an item of this kind\n                        if k_idx in state.world.non_grabbable_indices:\n                            is_obstacle = True\n                            break\n                \n                # If the cell is not an obstacle, add it to the queue for exploration\n                if not is_obstacle:\n                    visited.add(next_pos)\n                    queue.append((next_pos, current_path + [action]))\n\n    # Return the collected path if found, otherwise an empty list\n    return best_collection_path if best_collection_path is not None else []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:24:23.456736", "function_name": "collect", "function_body": "    state = env._current_state\n\n    # 1. Check if primitive is already in inventory\n    if state.inventory[primitive] > 0:\n        return []\n\n    grid = state.grid\n    grid_height, grid_width, _ = grid.shape\n    start_pos = state.pos\n    \n    # Impassable indices are typically non-grabbable items that block movement.\n    # The agent should not pathfind through these cells.\n    impassable_indices = set(state.world.non_grabbable_indices)\n    \n    # Helper function to check if a position is valid and traversable\n    def is_traversable(r, c):\n        # Check grid bounds\n        if not (0 <= r < grid_height and 0 <= c < grid_width):\n            return False\n        \n        # Check if the cell contains any impassable obstacle\n        cell_contents = grid[r, c]\n        for idx in impassable_indices:\n            if cell_contents[idx] > 0:\n                # If an impassable item is in the cell, it's not traversable\n                return False\n        return True # Cell is traversable\n\n    # BFS setup\n    queue = collections.deque()\n    queue.append((start_pos, [])) # (current_position, path_taken)\n    \n    # Visited set to avoid cycles and redundant paths, ensuring shortest path\n    visited = {start_pos}\n\n    # BFS loop to find the shortest path to a cell adjacent to the primitive\n    while queue:\n        current_pos, path = queue.popleft()\n        r, c = current_pos\n\n        # Check if the current position is adjacent to the primitive\n        # If so, we can perform the 'USE' action\n        is_adjacent_to_primitive = False\n        for dr_adj, dc_adj in ACTION_DELTAS.values(): # Check 4-directional neighbors\n            nr_adj, nc_adj = r + dr_adj, c + dc_adj\n            # Check bounds for the neighbor cell and if it contains the primitive\n            if (0 <= nr_adj < grid_height and 0 <= nc_adj < grid_width and \n                grid[nr_adj, nc_adj, primitive] > 0):\n                is_adjacent_to_primitive = True\n                break\n        \n        if is_adjacent_to_primitive:\n            # Found a path to a cell from which the primitive can be 'USE'd\n            return path + [USE]\n\n        # Explore neighbors\n        for action, (dr, dc) in ACTION_DELTAS.items():\n            next_r, next_c = r + dr, c + dc\n            next_pos = (next_r, next_c)\n\n            if is_traversable(next_r, next_c) and next_pos not in visited:\n                visited.add(next_pos)\n                queue.append((next_pos, path + [action]))\n\n    # If the BFS completes and no path is found to the primitive\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:24:23.526767", "function_name": "collect", "function_body": "    actions_taken = []\n\n    # Define action constants based on CraftLab.action_specs\n    # DOWN\u21920, UP\u21921, LEFT\u21922, RIGHT\u21923, USE\u21924\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Reset the environment to get the initial state and access the internal CraftState instance\n    _ = env.reset()\n    current_state = env._current_state\n\n    # Loop until the primitive is collected or the episode ends\n    while True:\n        # Check if the primitive is already in the agent's inventory\n        if current_state.inventory[primitive] > 0:\n            break  # Goal achieved, exit the loop\n\n        # Check if the primitive is in the 3x3 neighborhood (including the agent's current cell)\n        if current_state.next_to(primitive):\n            # If so, attempt to use/pickup the primitive\n            action_to_take = USE\n            _, done, _ = env.step(action_to_take)\n            actions_taken.append(action_to_take)\n            current_state = env._current_state  # Update current state after action\n            if done:\n                # If the episode finished (e.g., max_steps reached), stop trying\n                break\n            continue  # Re-evaluate the state (e.g., check inventory again)\n\n        # If the primitive is not in inventory and not next to the agent,\n        # find its location on the grid and move towards it.\n        grid = current_state.grid  # Grid shape is (WIDTH, HEIGHT, n_kinds)\n        agent_pos = current_state.pos  # Agent's position (x, y) = (column, row)\n\n        # Find all (x, y) coordinates where the primitive is located on the grid.\n        # np.where(grid[:, :, primitive] == 1) returns (x_indices_array, y_indices_array)\n        primitive_x_coords, primitive_y_coords = np.where(grid[:, :, primitive] == 1)\n\n        target_pos = None\n        if primitive_x_coords.size > 0:\n            # For simplicity, we target the first found instance of the primitive.\n            # A more sophisticated version might find the closest one.\n            target_pos = (primitive_x_coords[0], primitive_y_coords[0])  # (x, y)\n\n        if target_pos is None:\n            # If the primitive is not found on the map (e.g., it was removed, or not present),\n            # and it's not in inventory, we cannot collect it. Break to avoid infinite loop.\n            break\n\n        # Calculate the difference between target and agent positions\n        dx = target_pos[0] - agent_pos[0]\n        dy = target_pos[1] - agent_pos[1]\n\n        action_to_take = None\n        # Prioritize movement along the dimension with the largest absolute difference\n        # This helps in making progress towards the target efficiently.\n        if abs(dx) > abs(dy):\n            if dx > 0:\n                action_to_take = RIGHT\n            elif dx < 0:\n                action_to_take = LEFT\n        else:  # If abs(dy) >= abs(dx), prefer vertical movement or if differences are equal\n            if dy > 0:\n                action_to_take = DOWN\n            elif dy < 0:\n                action_to_take = UP\n\n        # If dx and dy are both 0, it means the agent is at the target position.\n        # In this scenario, `current_state.next_to(primitive)` should have already been True,\n        # leading to a `USE` action. If `action_to_take` is still None here, it implies an issue\n        # (e.g., primitive is at agent's exact spot but `next_to` didn't catch it, or it's ungrabbable).\n        # In such a case, further movement won't help, so we break.\n        if action_to_take is not None:\n            _, done, _ = env.step(action_to_take)\n            actions_taken.append(action_to_take)\n            current_state = env._current_state  # Update current state after action\n            if done:\n                break\n        else:\n            # This branch should ideally not be reached if the primitive is always collectable\n            # and the agent correctly identifies it as `next_to` when at the target location.\n            # If it is reached, it indicates no valid movement action was determined,\n            # implying being stuck or target unreachable. Break to prevent infinite loop.\n            break\n\n    return actions_taken", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:25:24.936157", "function_name": "collect", "function_body": "    \"\"\"Improved version of `collect_v1`.\"\"\"\n\n    # Access the initial state to start simulation.\n    # We assume direct access to `_current_state` of CraftLab for planning.\n    current_state = env._current_state\n\n    actions_list = []\n    max_planning_steps = 200  # A safety limit to prevent infinite loops during planning\n\n    # Get action integer mappings from the environment's action_specs.\n    action_map = env.action_specs()\n    # Ensure all required actions are present\n    if not all(k in action_map for k in ['DOWN', 'UP', 'LEFT', 'RIGHT', 'USE']):\n        return [] # Unable to determine actions, return empty plan\n\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    for _ in range(max_planning_steps):\n        # 1. Check if the primitive is already collected in the inventory.\n        if current_state.inventory[primitive] > 0:\n            return actions_list  # Goal achieved!\n\n        # 2. Find the closest location of the primitive on the grid.\n        grid = current_state.grid\n        agent_x, agent_y = current_state.pos # Agent position is (x, y)\n\n        target_coords = None\n        min_distance = float('inf')\n\n        # Grid is of shape (WIDTH, HEIGHT, n_kinds). So, grid[x, y, kind].\n        grid_width, grid_height, _ = grid.shape\n\n        # Iterate through the grid to find the closest primitive.\n        for x_coord in range(grid_width):\n            for y_coord in range(grid_height):\n                # Check if the cell (x_coord, y_coord) contains the primitive.\n                # Assumes primitive_layer[x, y] > 0 indicates presence.\n                if grid[x_coord, y_coord, primitive] > 0:\n                    # Calculate Manhattan distance (sum of absolute differences in coordinates).\n                    dist = abs(x_coord - agent_x) + abs(y_coord - agent_y)\n                    if dist < min_distance:\n                        min_distance = dist\n                        target_coords = (x_coord, y_coord)\n\n        if target_coords is None:\n            # Primitive not found on the map, or all collected.\n            # If it's not in inventory and not on the map, it cannot be collected.\n            return [] \n        \n        target_x, target_y = target_coords\n\n        # 3. Determine the next action based on current state and target.\n        action_to_take = None\n\n        # If the agent is currently next to the primitive, use the 'USE' action.\n        # `current_state.next_to(primitive)` checks for presence in 3x3 neighborhood.\n        if current_state.next_to(primitive):\n            action_to_take = ACTION_USE\n        else:\n            # Agent is not adjacent, so move towards the target.\n            dx = target_x - agent_x\n            dy = target_y - agent_y\n\n            # Prioritize movement along the axis with the larger absolute distance.\n            if abs(dx) > abs(dy):\n                if dx > 0:\n                    action_to_take = ACTION_RIGHT\n                elif dx < 0:\n                    action_to_take = ACTION_LEFT\n            else: # abs(dy) >= abs(dx)\n                if dy > 0:\n                    action_to_take = ACTION_DOWN\n                elif dy < 0:\n                    action_to_take = ACTION_UP\n        \n        # If no valid action was determined (e.g., agent is at target but cannot 'USE' it,\n        # or somehow stuck and unable to move further), return an empty list.\n        if action_to_take is None:\n            return []\n\n        # 4. Simulate the determined action and update the current_state.\n        _reward, new_state = current_state.step(action_to_take)\n        actions_list.append(action_to_take)\n        current_state = new_state\n\n    # If the loop finishes without returning, it means `max_planning_steps` was reached\n    # without successfully collecting the primitive.\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:25:25.006742", "function_name": "collect", "function_body": "    actions_list = []\n\n    # Get initial state information from the environment's scenario\n    initial_grid = env.scenario.init_grid\n    initial_pos_yx = env.scenario.init_pos # (y, x)\n    \n    # Get grid dimensions\n    HEIGHT, WIDTH, _ = initial_grid.shape\n\n    # Get action mappings\n    ACTION_MAP = env.action_specs()\n    ACTION_DOWN = ACTION_MAP['DOWN']\n    ACTION_UP = ACTION_MAP['UP']\n    ACTION_LEFT = ACTION_MAP['LEFT']\n    ACTION_RIGHT = ACTION_MAP['RIGHT']\n    ACTION_USE = ACTION_MAP['USE']\n\n    # Define movement deltas and corresponding actions\n    # (dy, dx) -> action\n    MOVE_DELTAS = {\n        (-1, 0): ACTION_UP,\n        (1, 0): ACTION_DOWN,\n        (0, -1): ACTION_LEFT,\n        (0, 1): ACTION_RIGHT,\n    }\n\n    # Get impassable indices (non-grabbable entities)\n    impassable_indices = env.world.non_grabbable_indices\n\n    # Helper function to check if a cell is within bounds and passable\n    def is_passable(y, x):\n        if not (0 <= y < HEIGHT and 0 <= x < WIDTH):\n            return False # Out of bounds\n        \n        # Check if the cell contains any impassable kind\n        for kind_idx in impassable_indices:\n            if initial_grid[y, x, kind_idx] == 1:\n                return False # Impassable\n        return True\n\n    # Find target positions: cells adjacent to the primitive\n    target_adj_positions = set()\n    for y in range(HEIGHT):\n        for x in range(WIDTH):\n            if initial_grid[y, x, primitive] == 1:\n                # This cell contains the primitive. Add its adjacent passable cells as targets.\n                for dy, dx in MOVE_DELTAS.keys():\n                    ny, nx = y + dy, x + dx\n                    if is_passable(ny, nx):\n                        target_adj_positions.add((ny, nx))\n    \n    if not target_adj_positions:\n        # Primitive not found on the grid or no reachable adjacent spots\n        return []\n\n    # BFS to find the shortest path to any target_adj_position\n    queue = collections.deque([(initial_pos_yx, [])]) # (current_pos_yx, path_of_actions)\n    visited = {initial_pos_yx}\n\n    best_path_actions = None\n\n    while queue:\n        (curr_y, curr_x), path_actions = queue.popleft()\n\n        if (curr_y, curr_x) in target_adj_positions:\n            best_path_actions = path_actions\n            break # Found the shortest path\n\n        for dy, dx in MOVE_DELTAS.keys():\n            next_y, next_x = curr_y + dy, curr_x + dx\n            next_pos_yx = (next_y, next_x)\n\n            if is_passable(next_y, next_x) and next_pos_yx not in visited:\n                visited.add(next_pos_yx)\n                new_path_actions = path_actions + [MOVE_DELTAS[(dy, dx)]]\n                queue.append((next_pos_yx, new_path_actions))\n\n    if best_path_actions is not None:\n        actions_list.extend(best_path_actions)\n        actions_list.append(ACTION_USE) # After reaching the adjacent cell, use the item\n    \n    return actions_list", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:27:33.380879", "function_name": "collect", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:27:33.450870", "function_name": "collect", "function_body": "    import collections # For deque\n\n    # Constants for actions based on CraftLab.action_specs()\n    # Assuming standard mapping: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    def _get_action_from_move(dx, dy):\n        \"\"\"Converts a (dx, dy) movement to an absolute CraftLab action.\"\"\"\n        if dx == 0 and dy == 1: return ACTION_DOWN\n        if dx == 0 and dy == -1: return ACTION_UP\n        if dx == -1 and dy == 0: return ACTION_LEFT\n        if dx == 1 and dy == 0: return ACTION_RIGHT\n        return None # Should not happen for valid moves\n\n    def _bfs_path_to_adjacent(grid, start_pos, target_kind_idx, non_grabbable_indices, grabbable_indices, width, height):\n        \"\"\"\n        Finds a path from start_pos to a cell *adjacent* to (or on) target_kind_idx.\n        Returns a list of (dx, dy) steps for the path.\n        Returns None if no path.\n        \"\"\"\n        q = collections.deque([(start_pos, [])]) # (current_pos, path_to_here)\n        visited = {start_pos}\n\n        # Pre-calculate all locations of the target primitive on the grid\n        all_target_locations = []\n        for x in range(width):\n            for y in range(height):\n                if grid[x, y, target_kind_idx] == 1:\n                    all_target_locations.append((x, y))\n\n        if not all_target_locations:\n            return None # Target primitive not found on the grid\n\n        while q:\n            (curr_x, curr_y), path = q.popleft()\n\n            # Check if current position is adjacent to any target location\n            # Manhattan distance <= 1 implies adjacent (or same cell)\n            for tx, ty in all_target_locations:\n                if abs(curr_x - tx) + abs(curr_y - ty) <= 1:\n                    # Found a path to a location from which 'USE' is possible\n                    return path\n\n            # Explore neighbors (4-directional movement)\n            for dx_move, dy_move in [(0, 1), (0, -1), (1, 0), (-1, 0)]: # Down, Up, Right, Left\n                next_x, next_y = curr_x + dx_move, curr_y + dy_move\n\n                # Check bounds\n                if not (0 <= next_x < width and 0 <= next_y < height):\n                    continue\n\n                # Check if already visited\n                if (next_x, next_y) in visited:\n                    continue\n\n                # Check if the next cell is an obstacle\n                # A cell is an obstacle if it contains any kind from non_grabbable_indices\n                is_obstacle = False\n                for k_idx in non_grabbable_indices:\n                    if grid[next_x, next_y, k_idx] == 1:\n                        is_obstacle = True\n                        break\n                if is_obstacle:\n                    continue # This cell is an obstacle\n\n                # If it's not an obstacle, it's traversable (empty or contains a grabbable item)\n                visited.add((next_x, next_y))\n                q.append(((next_x, next_y), path + [(dx_move, dy_move)]))\n\n        return None # No path found to any cell adjacent to the primitive\n\n    # Main logic for collect_v2 function\n    actions_taken = []\n    MAX_COLLECT_STEPS = 500  # Maximum steps to attempt collection, to prevent infinite loops\n\n    # Get essential world configuration from the environment\n    world = env.world\n    non_grabbable_indices = world.non_grabbable_indices\n    grabbable_indices = world.grabbable_indices\n\n    obs = env.reset() # Reset the environment to its initial state\n\n    for step_count in range(MAX_COLLECT_STEPS):\n        current_inventory = obs['features_dict']['inventory']\n\n        # 1. Check if the primitive is already collected\n        if current_inventory[primitive] > 0:\n            break # Goal achieved\n\n        # 2. Extract current state information from observations\n        grid = obs['features_dict']['features_global']\n        grid_width, grid_height, _ = grid.shape\n        current_pos_normalized = obs['features_dict']['pos']\n        # Convert normalized position back to integer grid coordinates\n        current_pos_x = int(round(current_pos_normalized[0] * (grid_width - 1)))\n        current_pos_y = int(round(current_pos_normalized[1] * (grid_height - 1)))\n        current_pos = (current_pos_x, current_pos_y)\n\n        # 3. Check if the primitive is in the 3x3 neighborhood of the agent (including agent's cell)\n        is_next_to_primitive = False\n        for dx_adj in [-1, 0, 1]:\n            for dy_adj in [-1, 0, 1]:\n                check_x, check_y = current_pos_x + dx_adj, current_pos_y + dy_adj\n                if 0 <= check_x < grid_width and 0 <= check_y < grid_height:\n                    if grid[check_x, check_y, primitive] == 1:\n                        is_next_to_primitive = True\n                        break\n            if is_next_to_primitive:\n                break\n\n        if is_next_to_primitive:\n            # If next to the primitive, try to USE it (which should pick it up)\n            actions_taken.append(ACTION_USE)\n            _reward, done, obs = env.step(ACTION_USE)\n            # After 'USE' action, re-check if the primitive was collected\n            if obs['features_dict']['inventory'][primitive] > 0:\n                break # Goal achieved\n            if done: # If environment terminated for any other reason (e.g., max_steps of the environment)\n                return actions_taken # Return actions taken so far, indicating failure to collect\n            continue # If not collected, continue to the next step_count loop iteration\n\n        # 4. If not adjacent, calculate a path to a cell adjacent to the primitive using BFS\n        path_segments = _bfs_path_to_adjacent(grid, current_pos, primitive,\n                                              non_grabbable_indices, grabbable_indices,\n                                              grid_width, grid_height)\n\n        if path_segments is None:\n            # No path found to the primitive. It might be unreachable or simply not exist on the map.\n            return actions_taken # Return actions taken so far, indicating failure to collect\n        \n        # If path_segments is empty, it means current_pos is already at/adjacent to the target.\n        # This case should ideally be covered by the `is_next_to_primitive` check above.\n        # However, as a fallback (e.g., if the primitive appeared directly under the agent),\n        # try to USE here as well.\n        if not path_segments:\n            actions_taken.append(ACTION_USE)\n            _reward, done, obs = env.step(ACTION_USE)\n            if obs['features_dict']['inventory'][primitive] > 0:\n                break # Goal achieved\n            if done:\n                return actions_taken\n            continue\n\n        # 5. Take the first action along the found path\n        dx, dy = path_segments[0]\n        action_to_take = _get_action_from_move(dx, dy)\n        if action_to_take is None:\n            # This indicates an error in the pathfinding or action mapping, should not happen for valid moves.\n            return actions_taken # Return actions taken so far, indicating an issue\n\n        actions_taken.append(action_to_take)\n        _reward, done, obs = env.step(action_to_take)\n        # After a movement action, re-check if the primitive was collected\n        # (e.g., if moving onto it automatically picks it up or finishes the task)\n        if obs['features_dict']['inventory'][primitive] > 0:\n            break # Goal achieved\n        if done: # If environment terminated for any reason (e.g., max_steps of the environment)\n            return actions_taken # Return actions taken so far, indicating failure to collect\n\n    return actions_taken # Return the list of actions taken (either success or max steps reached)", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:28:25.294109", "function_name": "collect", "function_body": "  import collections\n\n  # Actions are defined globally in the scope of the problem description\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT).\n  # Moving in a direction also sets the agent's facing direction.\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position).\n  # These vectors represent movement or the \"cell in front\" relative to the agent.\n  # 0: UP (y decreases), 1: RIGHT (x increases), 2: DOWN (y increases), 3: LEFT (x decreases)\n  DIR_VEC = {\n      0: (0, -1),  # UP\n      1: (1, 0),   # RIGHT\n      2: (0, 1),   # DOWN\n      3: (-1, 0)   # LEFT\n  }\n\n  # 1. Pre-check: Verify if the target primitive can actually be collected.\n  # Only items in `grabbable_indices` can be picked up.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get initial state information: position, direction, and the full grid.\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction\n  start_state_tuple = (start_x, start_y, start_dir)\n\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Identify non-grabbable (obstacle) indices from the world configuration.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to determine if a grid cell is traversable.\n  def is_walkable(x, y):\n    # Check if the coordinates are within the grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n\n    # Check if the cell is occupied by any non-grabbable item (e.g., water, workshop).\n    # If it is, the agent cannot move onto this cell.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False # Cell is blocked by an obstacle\n    return True # Cell is traversable\n\n  # Initialize Breadth-First Search (BFS):\n  # The queue stores tuples: (current_x, current_y, current_direction).\n  # The path is reconstructed using a parent map to save memory.\n  queue = collections.deque([(start_x, start_y, start_dir)])\n\n  # A set to keep track of visited states to avoid redundant computations and infinite loops.\n  # A state is defined by (x, y, direction), as the agent's facing direction is critical for the 'USE' action.\n  visited = set([(start_x, start_y, start_dir)])\n\n  # parent_map stores (current_x, current_y, current_dir): ((prev_x, prev_y, prev_dir), action_taken_to_get_here).\n  # This allows reconstructing the path by tracing back from the goal state.\n  parent_map = {}\n  \n  goal_state_tuple = None # Will store the (x, y, dir) state from which 'USE' is possible\n\n  while queue:\n    # Dequeue the current state.\n    curr_x, curr_y, curr_dir = queue.popleft()\n    current_state_key = (curr_x, curr_y, curr_dir)\n\n    # Check if the primitive can be collected from the current state.\n    # The 'USE' action targets the cell directly in front of the agent.\n    faced_dx, faced_dy = DIR_VEC[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # If the cell in front is within bounds AND contains the target primitive:\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Goal reached! Store this state and break BFS to reconstruct the path.\n      goal_state_tuple = current_state_key\n      break \n\n    # Explore possible next movement actions (UP, RIGHT, DOWN, LEFT).\n    # Note: Performing a movement action also updates the agent's facing direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new position and direction after this action.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]] # Movement vector based on action\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # New facing direction is the direction of movement\n      next_state_key = (next_x, next_y, next_dir)\n\n      # If the next cell is walkable AND this new (position, direction) state\n      # has not been visited, add it to the queue for exploration.\n      if is_walkable(next_x, next_y) and next_state_key not in visited:\n        visited.add(next_state_key)\n        parent_map[next_state_key] = (current_state_key, action) # Store parent and action\n        queue.append(next_state_key)\n\n  # Path Reconstruction:\n  if goal_state_tuple is None:\n    return [] # No path to a collectable primitive was found.\n\n  path = [ACTION_USE] # The last action is always 'USE'\n\n  # Trace back from the goal state to the start state using the parent map.\n  current = goal_state_tuple\n  while current != start_state_tuple:\n    # Retrieve the previous state and the action taken to reach 'current'.\n    # This check (current not in parent_map) should ideally not be hit if BFS is sound,\n    # but serves as a safeguard for edge cases or unexpected states.\n    if current not in parent_map: \n        return [] # Path reconstruction failed (e.g., start state unreachable from target, which implies an issue)\n    \n    prev_state, action_to_prev = parent_map[current]\n    path.insert(0, action_to_prev) # Prepend action to the path list\n    current = prev_state # Move to the previous state\n\n  return path", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T08:28:26.267459", "function_name": "collect", "function_body": "  import collections\n\n  # Actions are defined globally in the scope of the problem description\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT).\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position).\n  DIR_VEC = {\n      0: (0, -1),  # UP\n      1: (1, 0),   # RIGHT\n      2: (0, 1),   # DOWN\n      3: (-1, 0)   # LEFT\n  }\n\n  # 1. Pre-check: Verify if the target primitive can actually be collected.\n  # Only items in `grabbable_indices` can be picked up.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  current_state = env._current_state\n\n  # 2. Optimization: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Get initial state information: position, direction, and the full grid.\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir # Agent's initial facing direction\n\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Identify non-grabbable (obstacle) indices from the world configuration.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # 3. Optimization: Pre-compute a walkable mask for the grid.\n  # This avoids repeated iteration over non_grabbable_indices in the `is_walkable` helper.\n  # Initialize all cells as walkable (True).\n  walkable_grid_mask = np.ones((grid_width, grid_height), dtype=bool)\n  # For each non-grabbable item, mark cells containing it as non-walkable (False).\n  for k_idx in non_grabbable_indices:\n      # If grid[x, y, k_idx] is 1, then (grid[x, y, k_idx] == 0) is False.\n      # Logical AND with False will set that cell in the mask to False.\n      walkable_grid_mask = walkable_grid_mask & (grid[:, :, k_idx] == 0)\n\n\n  # Helper function to determine if a grid cell is traversable using the precomputed mask.\n  def is_walkable(x, y):\n    # Check if the coordinates are within the grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # Check the precomputed mask for walkability.\n    return walkable_grid_mask[x, y]\n\n  # Initialize Breadth-First Search (BFS):\n  # The queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken_so_far).\n  # `collections.deque` is used for efficient `popleft()` operations.\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # A set to keep track of visited states to avoid redundant computations and infinite loops.\n  # A state is defined by (x, y, direction), as the agent's facing direction is critical for the 'USE' action.\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    # Dequeue the current state and its accumulated path.\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the primitive can be collected from the current state.\n    # The 'USE' action targets the cell directly in front of the agent.\n    faced_dx, faced_dy = DIR_VEC[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # If the cell in front is within bounds AND contains the target primitive:\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Goal reached! Return the path with the final 'USE' action appended.\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next movement actions (UP, RIGHT, DOWN, LEFT).\n    # Note: Performing a movement action also updates the agent's facing direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new position and direction after this action.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]] # Movement vector based on action\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # New facing direction is the direction of movement\n\n      # If the next cell is walkable AND this new (position, direction) state\n      # has not been visited, add it to the queue for exploration.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable given the current environment and rules.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T08:29:53.306888", "function_name": "collect", "function_body": "  import collections\n\n  # Assuming _ACTION_TO_COORD_DIFF and USE_ACTION are accessible from collect_v1's scope.\n  # If not, they would need to be redefined here:\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4\n\n  # Map directions (0,1,2,3) to their corresponding coordinate differences\n  # Agent's direction determines which cell 'USE' acts upon.\n  _DIR_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN (facing positive Y)\n      1: (0, -1), # UP (facing negative Y)\n      2: (-1, 0), # LEFT (facing negative X)\n      3: (1, 0)   # RIGHT (facing positive X)\n  }\n\n  def _is_traversable(grid, x, y, grid_width, grid_height, world_non_grabbable_indices, primitive_idx):\n      \"\"\"\n      Checks if a cell (x, y) is traversable.\n      A cell is considered traversable if it's within bounds and does not contain\n      any non-grabbable item that is NOT the primitive we are trying to collect.\n      \"\"\"\n      # 1. Check boundary conditions\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False\n      \n      # 2. Check for impassable obstacles\n      # Iterate through all kinds of entities that might be present at (x, y)\n      for k_idx in range(grid.shape[2]):\n          if grid[x, y, k_idx] > 0: # If this kind (k_idx) is present at (x, y)\n              # If this kind is in the set of non-grabbable items AND it's not our target primitive\n              if k_idx in world_non_grabbable_indices and k_idx != primitive_idx:\n                  return False # This cell contains an impassable obstacle\n      return True\n\n  # 1. Get the integer index for the given primitive name\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 3. Find all locations on the grid where the primitive exists\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  target_primitive_locs = set() # Use a set for faster lookup\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        target_primitive_locs.add((x, y))\n\n  if not target_primitive_locs:\n    # The primitive is not found anywhere on the current map\n    return []\n\n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    The state in BFS will now include position AND direction, as 'USE' depends on direction.\n  start_pos = current_state.pos # Agent's current (x, y) position\n  start_dir = current_state.dir # Agent's current facing direction\n\n  # Queue stores tuples of ((current_x, current_y), current_direction, [list_of_actions_to_reach_here])\n  queue = collections.deque([((start_pos[0], start_pos[1]), start_dir, [])]) \n  \n  # Visited set stores ((x, y), direction) tuples to prevent cycles and redundant path exploration\n  visited = {((start_pos[0], start_pos[1]), start_dir)} \n\n  best_path = None\n\n  world_non_grabbable_indices = env.world.non_grabbable_indices\n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.popleft() # Dequeue for BFS\n\n    # Check if the current position and direction allow using a primitive\n    front_x, front_y = curr_x + _DIR_TO_COORD_DIFF[curr_dir][0], \\\n                       curr_y + _DIR_TO_COORD_DIFF[curr_dir][1]\n    \n    if (front_x, front_y) in target_primitive_locs:\n        # We found a path to a position where, by facing 'curr_dir', we can 'USE' the primitive.\n        best_path = path_actions\n        break # Path found! BFS guarantees this is the shortest path.\n\n    # Explore all possible movements from the current state\n    for action, (dx, dy) in _ACTION_TO_COORD_DIFF.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = action # Assuming movement action sets the new facing direction\n\n      # Check if the next position is traversable and within bounds\n      if _is_traversable(grid, next_x, next_y, grid_width, grid_height, world_non_grabbable_indices, primitive_idx):\n        if ((next_x, next_y), next_dir) not in visited:\n          visited.add(((next_x, next_y), next_dir))\n          queue.append(((next_x, next_y), next_dir, path_actions + [action]))\n\n  if best_path is None:\n    # If the queue becomes empty and no path was found, the primitive is unreachable.\n    return []\n\n  # 5. Once adjacent to the primitive and facing it correctly, the final action is to USE it.\n  return best_path + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T08:29:54.299304", "function_name": "collect", "function_body": "  # Constants for actions and their coordinate differences\n  # These are inferred from CraftLab.action_specs and common grid world conventions.\n  # We assume movement actions (0-3) set the agent's direction to that action's direction.\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name\n  # The index method will add the primitive to the cookbook's index if it doesn't already exist.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable\n  if primitive_idx not in env.world.grabbable_indices:\n    # This primitive cannot be picked up (e.g., water, stone if not grabbable),\n    # so \"collecting\" it via USE is not possible.\n    return []\n\n  # 3. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 4. Retrieve grid dimensions for boundary checks\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a position and orientation from which the primitive can be collected via USE.\n  # BFS state: ((current_x, current_y), current_direction, [list_of_actions_to_reach_here])\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's initial direction (0-3)\n\n  queue = [(start_pos, start_dir, [])] \n  # Set of visited ((x, y), direction) tuples to prevent cycles and redundant path exploration\n  visited = {(start_pos, start_dir)} \n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.pop(0) # Dequeue for BFS\n\n    # Calculate the coordinates of the cell directly in front of the agent,\n    # which is the target for the USE action.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # Check if the cell in front is within bounds and contains the primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      # Found a path where the agent can move to a position, face the primitive,\n      # and then USE to collect it.\n      return path_actions + [USE_ACTION]\n    \n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # A movement action changes the agent's position and its facing direction.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple) # Mark the new state as visited\n        # Add the new state and its path to the queue for further exploration\n        queue.append((next_state_tuple[0], next_state_tuple[1], path_actions + [move_action]))\n\n  # If the queue becomes empty and no path was found, it means the primitive\n  # is unreachable from the current state.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T08:31:17.353883", "function_name": "collect", "function_body": "    actions = []\n    MAX_COLLECT_ATTEMPTS = 200 # Safety limit to prevent infinite loops\n\n    # Action mappings from CraftLab.action_specs\n    # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    for _ in range(MAX_COLLECT_ATTEMPTS):\n        # 1. Get current observations from the environment\n        obs = env.observations()\n        features_dict = obs['features_dict']\n        \n        # 2. Check if the primitive is already in the inventory\n        inventory = features_dict['inventory']\n        if inventory[primitive] > 0:\n            break  # Primitive collected, task accomplished\n\n        # 3. Get current grid state and agent's position\n        grid = features_dict['features_global']\n        agent_norm_pos = features_dict['pos']\n        \n        # Determine grid dimensions and convert normalized agent position to integer coordinates\n        # (WIDTH, HEIGHT, n_kinds)\n        WIDTH, HEIGHT, _ = grid.shape \n        agent_x = int(agent_norm_pos[0] * WIDTH)\n        agent_y = int(agent_norm_pos[1] * HEIGHT)\n\n        current_action = -1 # Placeholder for the action to be taken\n\n        # 4. Check if the primitive is in the agent's 3x3 neighborhood (including current cell)\n        is_adjacent = False\n        \n        # Iterate over the 3x3 neighborhood (dx, dy from -1 to 1)\n        for dx in [-1, 0, 1]:\n            for dy in [-1, 0, 1]:\n                nx, ny = agent_x + dx, agent_y + dy\n                # Check if the neighbor cell is within grid bounds\n                if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n                    # Check if the primitive exists at this neighbor location\n                    if grid[nx, ny, primitive] > 0:\n                        is_adjacent = True\n                        break # Found an adjacent primitive, no need to check further dy\n            if is_adjacent:\n                break # Found an adjacent primitive, no need to check further dx\n\n        if is_adjacent:\n            # If adjacent, use the USE action to pick up/interact with the primitive\n            current_action = ACTION_USE\n        else:\n            # 5. If not adjacent, find the closest primitive on the grid and plan movement\n            # Find all locations where the primitive exists on the grid\n            primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n            if len(primitive_locations) == 0:\n                # Primitive not on the grid and not in inventory.\n                # This means it cannot be collected (e.g., destroyed, exhausted, or never existed).\n                return actions # Return actions taken so far, indicating failure to collect\n\n            # Find the primitive location closest to the agent using Manhattan distance\n            min_dist = float('inf')\n            closest_primitive_pos = None\n\n            for loc in primitive_locations:\n                # loc is (row, col) i.e., (x, y)\n                dist = abs(loc[0] - agent_x) + abs(loc[1] - agent_y)\n                if dist < min_dist:\n                    min_dist = dist\n                    closest_primitive_pos = (loc[0], loc[1])\n\n            # This condition should logically not be met if len(primitive_locations) > 0\n            if closest_primitive_pos is None:\n                return actions \n\n            target_x, target_y = closest_primitive_pos\n            \n            # Calculate the difference in coordinates between agent and target\n            dx_to_target = target_x - agent_x\n            dy_to_target = target_y - agent_y\n\n            # Prioritize movement along the dimension with the larger difference\n            if abs(dx_to_target) > abs(dy_to_target):\n                if dx_to_target > 0:\n                    current_action = ACTION_RIGHT\n                else: # dx_to_target < 0\n                    current_action = ACTION_LEFT\n            else: # abs(dy_to_target) >= abs(dx_to_target)\n                if dy_to_target > 0:\n                    current_action = ACTION_DOWN\n                else: # dy_to_target < 0\n                    current_action = ACTION_UP\n            \n        # 6. Append the chosen action to the list and execute it in the environment\n        actions.append(current_action)\n        # env.step returns (reward, done, observations)\n        reward, done, _ = env.step(current_action) \n        \n        if done:\n            # If the scenario ends (e.g., max_steps reached in CraftLab), stop attempting\n            break\n\n    return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:31:17.425597", "function_name": "collect", "function_body": "    # Action constants, derived from CraftLab.action_specs()\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Helper function to check if a specific kind is next to a given position on the grid\n    def _is_next_to_kind_at_pos(grid, check_pos, kind_idx):\n        \"\"\"\n        Checks if `kind_idx` is present in the 3x3 neighborhood around `check_pos` on the `grid`.\n        Assumes `grid` is a numpy array.\n        \"\"\"\n        rows, cols, _ = grid.shape\n        r_check, c_check = check_pos\n        for dr in [-1, 0, 1]:\n            for dc in [-1, 0, 1]:\n                nr, nc = r_check + dr, c_check + dc\n                if 0 <= nr < rows and 0 <= nc < cols:\n                    # Check if the entity kind is present at this neighbor cell\n                    # Assuming grid[r, c, k] > 0 means kind k is present at (r,c)\n                    if grid[nr, nc, kind_idx] > 0:\n                        return True\n        return False\n\n    # Helper function for Breadth-First Search (BFS) to find a path to a position\n    # that is next to the target primitive.\n    def _find_path_to_primitive_neighbor(current_state, primitive_idx, max_path_length=200):\n        \"\"\"\n        Finds a sequence of actions (UP, DOWN, LEFT, RIGHT) to reach a position\n        where `primitive_idx` is in the 3x3 neighborhood.\n        Returns (path_actions, final_pos_after_path) or (None, None) if no path found.\n        Assumes `collections` and `numpy` are imported globally.\n        \"\"\"\n        start_pos = current_state.pos\n        grid = current_state.grid\n        height, width, _ = grid.shape\n\n        # Queue stores (current_pos, path_actions_to_current_pos)\n        queue = collections.deque([(start_pos, [])])\n        visited = {start_pos} # Set of visited (row, col) tuples to prevent cycles\n\n        # Map action integer to (dr, dc) delta for movement\n        move_deltas = {\n            UP: (-1, 0),\n            DOWN: (1, 0),\n            LEFT: (0, -1),\n            RIGHT: (0, 1),\n        }\n\n        while queue:\n            (r, c), path_actions = queue.popleft()\n\n            # Check if the current position in the simulation is next to the primitive\n            if _is_next_to_kind_at_pos(grid, (r, c), primitive_idx):\n                return path_actions, (r, c)\n\n            # Prune paths that are too long to prevent excessive computation\n            if len(path_actions) >= max_path_length:\n                continue\n\n            # Explore neighbors\n            for action, (dr, dc) in move_deltas.items():\n                nr, nc = r + dr, c + dc\n                next_pos = (nr, nc)\n\n                # Check boundary conditions and if the position has already been visited\n                if 0 <= nr < height and 0 <= nc < width:\n                    if next_pos not in visited:\n                        visited.add(next_pos)\n                        queue.append((next_pos, path_actions + [action]))\n        \n        return None, None # No path found within max_path_length\n\n    # Main logic for collect_v2\n    # Retrieve the current state from the environment\n    current_craft_state = env._current_state\n    \n    actions_plan = []\n    # Safety limit for the total number of simulated actions to prevent infinite loops\n    max_total_simulated_actions = 500 \n\n    # Create a deep copy of the initial state to simulate actions without modifying\n    # the actual environment's state. `CraftState` returns new instances on `step`.\n    # `grid` and `inventory` are numpy arrays and must be copied. `pos` and `dir` are immutable.\n    simulated_state = current_craft_state.__class__(\n        scenario=current_craft_state.scenario,\n        grid=np.copy(current_craft_state.grid),\n        pos=current_craft_state.pos,\n        dir=current_craft_state.dir,\n        inventory=np.copy(current_craft_state.inventory)\n    )\n    \n    steps_taken = 0\n    # Continue planning as long as the primitive is not in the inventory\n    # and we haven't exceeded the maximum simulated actions.\n    while simulated_state.inventory[primitive] == 0 and steps_taken < max_total_simulated_actions:\n        # 1. Check if the primitive is in the agent's 3x3 neighborhood in the simulated state\n        if simulated_state.next_to(primitive):\n            actions_plan.append(USE)\n            # Apply the USE action in the simulated environment and update the simulated state\n            _reward, new_state = simulated_state.step(USE)\n            simulated_state = new_state\n        else:\n            # 2. If not next to the primitive, find a path to a location next to one\n            path_to_primitive_neighbor, _ = _find_path_to_primitive_neighbor(simulated_state, primitive)\n\n            if path_to_primitive_neighbor:\n                # Take the first action in the calculated path\n                first_action = path_to_primitive_neighbor[0]\n                actions_plan.append(first_action)\n                # Apply this movement action in the simulated environment and update the simulated state\n                _reward, new_state = simulated_state.step(first_action)\n                simulated_state = new_state\n            else:\n                # No path found to any primitive within the BFS's `max_path_length`.\n                # This can occur if the primitive is unreachable, not present, or the path is too long.\n                # In such cases, stop planning and return the current (potentially incomplete) plan.\n                break \n        \n        steps_taken += 1\n\n    return actions_plan", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:32:59.036886", "function_name": "collect", "function_body": "    # 1. Check inventory\n    obs = env.observations()\n    inventory = obs['inventory']\n    if inventory[primitive] > 0:\n        return []\n\n    curr_pos = tuple(obs['pos'])\n    curr_dir = np.argmax(obs['direction']) # 0: East, 1: North, 2: West, 3: South\n    grid = obs['features_global']\n    width, height, n_kinds = grid.shape\n\n    world = env.world # Access the CraftWorld instance\n    non_grabbable_indices = world.non_grabbable_indices\n    grabbable_indices = world.grabbable_indices\n\n    # Define actions and their effects\n    # Action index -> (dx, dy) for movement\n    ACTION_TO_DELTA = {\n        0: (0, 1),  # DOWN (move South)\n        1: (0, -1), # UP (move North)\n        2: (-1, 0), # LEFT (move West)\n        3: (1, 0)   # RIGHT (move East)\n    }\n    # Action index -> new agent direction after moving\n    # Agent faces the direction it just moved\n    ACTION_TO_NEW_DIR = {\n        0: 3, # DOWN -> South (3)\n        1: 1, # UP -> North (1)\n        2: 2, # LEFT -> West (2)\n        3: 0  # RIGHT -> East (0)\n    }\n    # Agent direction -> (dx, dy) for the cell directly in front\n    DIR_TO_DELTA = {\n        0: (1, 0),  # East (+x)\n        1: (0, -1), # North (-y)\n        2: (-1, 0), # West (-x)\n        3: (0, 1)   # South (+y)\n    }\n    \n    MOVE_ACTIONS = [0, 1, 2, 3] # DOWN, UP, LEFT, RIGHT\n    USE_ACTION = 4\n\n    # Helper functions\n    def is_walkable(x, y):\n        \"\"\"Checks if a cell (x, y) is within bounds and traversable.\"\"\"\n        return (0 <= x < width and 0 <= y < height and\n                all(grid[x, y, k] == 0.0 for k in non_grabbable_indices))\n\n    def is_adjacent(p1, p2):\n        \"\"\"Checks if two positions p1 and p2 are directly adjacent (not diagonally).\"\"\"\n        return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1]) == 1\n\n    def facing_target(agent_pos, agent_dir, target_pos):\n        \"\"\"Checks if the agent at agent_pos with agent_dir is facing target_pos.\"\"\"\n        dx_f, dy_f = DIR_TO_DELTA[agent_dir]\n        front_cell = (agent_pos[0] + dx_f, agent_pos[1] + dy_f)\n        return front_cell == target_pos\n\n    # 2. Find all primitive locations on the grid\n    primitive_locs = []\n    for x in range(width):\n        for y in range(height):\n            if grid[x, y, primitive] == 1.0:\n                primitive_locs.append((x, y))\n\n    if not primitive_locs:\n        return [] # Primitive not found on the grid\n\n    # 3. BFS to find the shortest path of actions to collect the primitive\n    q = collections.deque([(curr_pos, curr_dir, [])]) # (agent_pos, agent_dir, actions_taken_so_far)\n    visited = set([(curr_pos, curr_dir)])\n\n    while q:\n        pos, agent_dir, path_so_far = q.popleft()\n\n        # Check if we are in a goal state (can USE primitive from current position and direction)\n        for px, py in primitive_locs:\n            if primitive in grabbable_indices and \\\n               is_adjacent(pos, (px, py)) and \\\n               facing_target(pos, agent_dir, (px, py)):\n                return path_so_far + [USE_ACTION] # Found a path, add USE action\n\n        # Explore movement actions\n        for action_idx in MOVE_ACTIONS:\n            dx_move, dy_move = ACTION_TO_DELTA[action_idx]\n            next_pos = (pos[0] + dx_move, pos[1] + dy_move)\n            next_agent_dir = ACTION_TO_NEW_DIR[action_idx]\n\n            if is_walkable(next_pos[0], next_pos[1]) and \\\n               (next_pos, next_agent_dir) not in visited:\n                visited.add((next_pos, next_agent_dir))\n                q.append((next_pos, next_agent_dir, path_so_far + [action_idx]))\n\n    return [] # No path found to collect the primitive within the reachable states", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:33:00.021840", "function_name": "collect", "function_body": "  actions = []\n  MAX_ACTIONS_PER_COLLECT = 200 # Safety limit to prevent infinite loops\n\n  # Helper function to copy CraftState for simulation purposes.\n  # This is crucial because `collect_v2` should plan actions without\n  # modifying the actual `env`'s state.\n  def _copy_craft_state(state_to_copy):\n      # CraftState constructor: init(scenario, grid, pos, dir, inventory)\n      return state_to_copy.__class__( # Use __class__ for robustness\n          scenario=state_to_copy.scenario,\n          grid=state_to_copy.grid.copy(), # Deep copy numpy array for grid\n          pos=state_to_copy.pos,         # Tuple is immutable\n          dir=state_to_copy.dir,         # Int is immutable\n          inventory=state_to_copy.inventory.copy() # Deep copy numpy array for inventory\n      )\n\n  # Start simulation from a copy of the initial environment state\n  sim_state = _copy_craft_state(env._current_state)\n\n  # 1. Check if the primitive is already in the inventory at the start\n  if sim_state.inventory[primitive] > 0:\n      return actions # Already collected, no actions needed\n\n  # 2. Find the primitive's location on the grid\n  # The grid is (WIDTH, HEIGHT, n_kinds)\n  grid = sim_state.grid\n  primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n\n  if len(primitive_locations) == 0:\n      # Primitive not found on the map, so it cannot be collected directly.\n      return []\n\n  # For simplicity, target the first found instance of the primitive\n  target_x, target_y = primitive_locations[0]\n\n  # Pathfinding and collection loop\n  for _ in range(MAX_ACTIONS_PER_COLLECT):\n      # Refresh agent's current position and inventory in the simulation\n      agent_x, agent_y = sim_state.pos\n      current_inventory_count = sim_state.inventory[primitive]\n\n      # Check if the primitive has been collected during this loop (e.g., after a USE action)\n      if current_inventory_count > 0:\n          return actions # Successfully collected\n\n      # Check if the agent is next to the primitive and can use it\n      if sim_state.next_to(primitive):\n          actions.append(ACTION_USE)\n          # Simulate the USE action\n          _, sim_state = sim_state.step(ACTION_USE)\n          # Continue the loop to re-evaluate the state (check inventory again)\n          continue\n\n      # If the agent is already at the target location (dx=0, dy=0)\n      # but next_to(primitive) was False, it implies the primitive might\n      # not be collectible from its own square via 'USE', or there's an issue\n      # with the environment's setup. In this case, we're stuck.\n      if agent_x == target_x and agent_y == target_y:\n          return actions # Cannot move or collect, stuck at target\n\n      # Determine movement towards the target\n      dx = target_x - agent_x\n      dy = target_y - agent_y\n\n      action_chosen = None\n      # Prioritize moving along the axis with a larger absolute distance,\n      # or horizontal if distances are equal (or horizontal is only one remaining)\n      if abs(dx) >= abs(dy) and dx != 0:\n          action_chosen = ACTION_RIGHT if dx > 0 else ACTION_LEFT\n      elif dy != 0: # If dx is 0 or abs(dy) > abs(dx)\n          action_chosen = ACTION_DOWN if dy > 0 else ACTION_UP\n\n      if action_chosen is not None:\n          # Simulate the chosen action\n          prev_sim_pos = sim_state.pos\n          _, next_sim_state = sim_state.step(action_chosen)\n\n          if next_sim_state.pos != prev_sim_pos:\n              # Move was successful\n              actions.append(action_chosen)\n              sim_state = next_sim_state\n          else:\n              # Move was blocked (e.g., hit a wall). Try an alternative move.\n              alternative_action = None\n              # If the initial move was horizontal and vertical movement is still needed\n              if action_chosen in [ACTION_LEFT, ACTION_RIGHT] and dy != 0:\n                  alternative_action = ACTION_DOWN if dy > 0 else ACTION_UP\n              # If the initial move was vertical and horizontal movement is still needed\n              elif action_chosen in [ACTION_UP, ACTION_DOWN] and dx != 0:\n                  alternative_action = ACTION_RIGHT if dx > 0 else ACTION_LEFT\n\n              if alternative_action is not None:\n                  _, next_sim_state_alt = sim_state.step(alternative_action)\n                  if next_sim_state_alt.pos != prev_sim_pos:\n                      # Alternative move was successful\n                      actions.append(alternative_action)\n                      sim_state = next_sim_state_alt\n                  else:\n                      # Both preferred and alternative moves were blocked. The agent is stuck.\n                      return actions\n              else:\n                  # No valid alternative move or already at target on one axis and blocked on other. Stuck.\n                  return actions\n      else:\n          # This case should ideally not be reached if dx or dy is non-zero,\n          # as an action should always be chosen. If reached, it means we're stuck.\n          return actions\n\n  # If the loop completes without collecting the primitive (e.g., max iterations reached)\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:34:53.148147", "function_name": "collect", "function_body": "  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable\n  if primitive_idx not in env.world.grabbable_indices:\n    # This primitive cannot be picked up (e.g., water, stone if not grabbable),\n    # so \"collecting\" it via USE is not possible.\n    return []\n\n  # 3. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 4. Retrieve grid dimensions for boundary checks\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a position and orientation from which the primitive can be collected via USE.\n  # BFS state: ((current_x, current_y), current_direction)\n  # visited: {state_tuple: (parent_state_tuple, action_taken_to_reach_state)}\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  queue = [(start_pos, start_dir)] \n  visited = {(start_pos, start_dir): (None, None)} # (parent_state, action_from_parent_to_current)\n\n  target_reached_state = None # To store the state from which USE can be applied\n\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.pop(0) # Dequeue for BFS\n\n    # Calculate the coordinates of the cell directly in front of the agent,\n    # which is the target for the USE action.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # Check if the cell in front is within bounds and contains the primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      # Found a state where the agent can perform USE to collect the primitive.\n      target_reached_state = ((curr_x, curr_y), curr_dir)\n      break # Path found, exit BFS loop\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet\n      if next_state_tuple not in visited:\n        visited[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action)\n        queue.append(next_state_tuple)\n\n  if target_reached_state is None:\n    return [] # If the queue becomes empty and no path was found, it means the primitive is unreachable.\n\n  # Reconstruct the path by backtracking from the target_reached_state to the start_state\n  path_actions = []\n  current_reconstruction_state = target_reached_state\n  \n  # Loop until we reach the starting state, which has (None, None) as its parent\n  while visited[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = visited[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  # The path was built in reverse order, so reverse it to get the correct sequence\n  path_actions.reverse()\n  \n  # Add the final USE action to the collected path\n  return path_actions + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T08:34:54.162781", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:36:18.997026", "function_name": "collect", "function_body": "    world = env.world\n    current_state = env._current_state\n    grid = current_state.grid\n    pos = current_state.pos\n    inventory = current_state.inventory\n    \n    # Get action mapping from the environment\n    action_map = env.action_specs()\n    ACTION_UP = action_map[\"UP\"]\n    ACTION_DOWN = action_map[\"DOWN\"]\n    ACTION_LEFT = action_map[\"LEFT\"]\n    ACTION_RIGHT = action_map[\"RIGHT\"]\n    ACTION_USE = action_map[\"USE\"]\n\n    # Check if primitive is already collected\n    if inventory[primitive] > 0:\n        return []\n\n    # Determine collection strategy\n    is_grabbable = primitive in world.grabbable_indices\n    is_crafting_source = (primitive in world.workshop_indices or\n                          primitive == world.water_index or\n                          primitive == world.stone_index)\n    \n    # Grid dimensions\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n\n    # Find all locations of the primitive in the current grid\n    primitive_locations = []\n    for r in range(WIDTH):\n        for c in range(HEIGHT):\n            if grid[r, c, primitive] == 1:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        return [] # Primitive not found in the current grid\n\n    def is_walkable(r, c, current_grid, world_obj):\n        \"\"\"\n        Checks if a cell (r, c) is walkable.\n        A cell is walkable if it's within bounds and does not contain any\n        non-grabbable item that acts as an obstacle.\n        \"\"\"\n        if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n            return False\n        \n        # Check if any non-grabbable item is in the cell.\n        # This implies cells containing workshops, water, stone (which are non-grabbable)\n        # are considered obstacles for direct movement onto them.\n        for k in range(N_KINDS):\n            if current_grid[r, c, k] == 1 and k in world_obj.non_grabbable_indices:\n                return False\n        return True # Cell is empty or contains only grabbable items\n\n    def bfs(start_pos, target_positions, current_grid, world_obj, require_adjacent):\n        \"\"\"\n        Performs a BFS to find the shortest path from start_pos to any target_position.\n        Returns a list of (row, col) coordinates representing the path.\n        If require_adjacent is True, path leads to a cell *adjacent* to any target.\n        Uses a list as a queue (less efficient than deque, but avoids import).\n        \"\"\"\n        queue = [(start_pos, [])] # (current_pos, path_so_far_coords)\n        visited = {start_pos}\n\n        head = 0 # Manual queue head pointer for efficient list-based queue\n        while head < len(queue):\n            (r, c), path_coords = queue[head]\n            head += 1\n\n            # Check if current position satisfies the goal\n            if require_adjacent:\n                # Goal is to be adjacent to any target_position\n                for tr, tc in target_positions:\n                    if (abs(r - tr) + abs(c - tc) == 1): # Manhattan distance 1\n                        return path_coords + [(r, c)] # Path includes the final adjacent cell\n            else:\n                # Goal is to be on a target_position itself\n                if (r, c) in target_positions:\n                    return path_coords + [(r, c)] # Path includes the final target cell\n\n            # Explore neighbors\n            # Moves: (dr, dc) for UP, DOWN, LEFT, RIGHT\n            moves = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n            for dr, dc in moves:\n                nr, nc = r + dr, c + dc\n                if is_walkable(nr, nc, current_grid, world_obj) and (nr, nc) not in visited:\n                    visited.add((nr, nc))\n                    queue.append(((nr, nc), path_coords + [(nr, nc)]))\n        return None # No path found\n\n    path_coords = None\n    if is_grabbable:\n        # Agent needs to move *onto* the primitive's cell\n        target_cells_for_bfs = set(primitive_locations)\n        path_coords = bfs(pos, target_cells_for_bfs, grid, world, require_adjacent=False)\n    elif is_crafting_source:\n        # Agent needs to move *adjacent* to the primitive's cell, then USE\n        target_cells_for_bfs = set(primitive_locations) # These are the actual resource locations\n        path_coords = bfs(pos, target_cells_for_bfs, grid, world, require_adjacent=True)\n    else:\n        # This primitive is neither grabbable nor a crafting source; cannot be collected by this logic.\n        return []\n\n    if path_coords is None:\n        return [] # No path found to the primitive\n\n    # Convert coordinate path to action sequence\n    actions = []\n    current_r, current_c = pos\n    \n    # Map (dr, dc) to actions\n    move_to_action = {\n        (-1, 0): ACTION_UP,\n        (1, 0): ACTION_DOWN,\n        (0, -1): ACTION_LEFT,\n        (0, 1): ACTION_RIGHT,\n    }\n\n    for next_r, next_c in path_coords:\n        dr, dc = next_r - current_r, next_c - current_c\n        action = move_to_action.get((dr, dc))\n        if action is not None:\n            actions.append(action)\n        else:\n            # This should ideally not happen if BFS path is valid.\n            # However, for robustness, if path implies an invalid move, return empty.\n            return [] \n\n        current_r, current_c = next_r, next_c\n\n    # If it's a crafting source, add a USE action at the end\n    # The `CraftState.step` method's `USE` action checks for proximity\n    # using `self.next_to(k_use_target_val)`, which doesn't depend on agent's\n    # facing direction. So, no need for explicit turn actions.\n    if is_crafting_source:\n        actions.append(ACTION_USE)\n\n    return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:36:19.076320", "function_name": "collect", "function_body": "    # Get action integer mappings\n    action_map = env.action_specs()\n    DOWN = action_map['down']\n    UP = action_map['up']\n    LEFT = action_map['left']\n    RIGHT = action_map['right']\n    USE = action_map['use']\n\n    # Get the integer index for the target primitive\n    try:\n        primitive_idx = env.world.cookbook.index(primitive)\n    except ValueError:\n        # Primitive name not found in cookbook, cannot collect.\n        return []\n\n    # Get current state observations\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    grid = features_dict['features_global']\n    \n    # Current agent position (normalized [0,1])\n    current_pos_normalized = features_dict['pos'] \n    # Convert to integer grid coordinates (row, col)\n    GRID_HEIGHT, GRID_WIDTH, N_KINDS = grid.shape\n    current_pos = (int(current_pos_normalized[0] * GRID_HEIGHT), int(current_pos_normalized[1] * GRID_WIDTH))\n\n    # Define possible moves (dr, dc) and corresponding actions\n    MOVES = {\n        (0, -1): LEFT,  # Move Left\n        (0, 1): RIGHT, # Move Right\n        (-1, 0): UP,    # Move Up\n        (1, 0): DOWN,   # Move Down\n    }\n\n    # Define non-walkable indices for pathfinding.\n    # These include all non-grabbable entities that are not workshops.\n    # The primitive itself is also treated as an obstacle to walk *into*,\n    # as the goal is to be *adjacent* to it and use the USE action.\n    non_walkable_indices = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n    # Check if primitive is already in inventory\n    if features_dict['inventory'][primitive_idx] > 0:\n        return [] # Already collected, no actions needed\n\n    # BFS setup\n    # Queue stores (current_position (r,c), list_of_actions_to_reach_here)\n    queue = [(current_pos, [])]\n    # Set of visited positions to avoid cycles and redundant paths\n    visited = {current_pos} \n\n    # BFS loop\n    while queue:\n        # Dequeue the next position and its path. Using list.pop(0) as deque is not available.\n        (r, c), path_actions = queue.pop(0) \n\n        # Check if the current position (r, c) is adjacent to the target primitive\n        # If yes, we have found a path to an adjacent cell, so append USE and return.\n        for (dr, dc), _ in MOVES.items(): # Iterate over possible movement directions\n            nr, nc = r + dr, c + dc\n            \n            # Check if this neighbor (nr, nc) is within grid boundaries\n            if 0 <= nr < GRID_HEIGHT and 0 <= nc < GRID_WIDTH:\n                # If the neighbor cell contains the primitive, we found our target adjacency\n                if grid[nr, nc, primitive_idx] == 1:\n                    return path_actions + [USE]\n\n        # Explore unvisited, non-obstacle adjacent positions\n        for (dr, dc), action in MOVES.items():\n            nr, nc = r + dr, c + dc\n            next_pos = (nr, nc)\n\n            # Check boundaries\n            if not (0 <= nr < GRID_HEIGHT and 0 <= nc < GRID_WIDTH):\n                continue\n\n            # Check if the next position has already been visited\n            if next_pos in visited:\n                continue\n\n            # Check for obstacles in the next cell (nr, nc)\n            is_obstacle = False\n            for k_idx in range(N_KINDS):\n                if grid[nr, nc, k_idx] == 1: # If this kind is present in the cell\n                    if k_idx == primitive_idx:\n                        # This cell contains the primitive we are looking for.\n                        # We should not walk *into* it, but *to* a cell adjacent to it.\n                        # So, for pathfinding purposes, treat it as an obstacle to walking into.\n                        is_obstacle = True\n                        break\n                    \n                    if k_idx in non_walkable_indices:\n                        # This is a non-grabbable, non-workshop entity -> obstacle\n                        is_obstacle = True\n                        break\n            \n            if is_obstacle:\n                continue\n\n            # If not an obstacle and not visited, add to queue\n            visited.add(next_pos)\n            queue.append((next_pos, path_actions + [action]))\n\n    # If the queue becomes empty and no path to an adjacent primitive was found,\n    # it means the primitive is unreachable or not present on the map.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:38:09.393719", "function_name": "collect", "function_body": "  # Action constants (assuming these are defined elsewhere or known)\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  _DOWN, _UP, _LEFT, _RIGHT, _USE = 0, 1, 2, 3, 4\n\n  # Get initial state information from the environment\n  current_state = env._current_state # Direct access to CraftState\n  grid = current_state.grid\n  agent_pos = current_state.pos\n  agent_dir = current_state.dir # 0:North, 1:East, 2:South, 3:West\n\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n\n  # 1. Find the primitive's location on the grid\n  target_primitive_pos = None\n  min_dist_to_primitive = float('inf')\n\n  # Search for the closest instance of the primitive\n  for r in range(WIDTH):\n    for c in range(HEIGHT):\n      if grid[r, c, primitive] == 1.0:\n        dist = abs(r - agent_pos[0]) + abs(c - agent_pos[1])\n        if dist < min_dist_to_primitive:\n          min_dist_to_primitive = dist\n          target_primitive_pos = (r, c)\n\n  if target_primitive_pos is None:\n    return [] # Primitive not found, cannot collect\n\n  px, py = target_primitive_pos\n\n  # 2. Define possible target states for the agent to be in *before* using the primitive.\n  #    A target state is (agent_x, agent_y, action_to_take_to_reach_this_pos, resulting_facing_direction).\n  #    The last move action must place the agent adjacent to the primitive and make it face the primitive.\n  \n  adj_target_states = [] # Stores (target_pos_tuple, last_action_to_reach, required_facing_dir_at_target)\n  \n  # Agent moves UP (_UP, value 1) to (px+1, py) -> faces North (0)\n  if px + 1 < WIDTH: # Target position is SOUTH of primitive\n    adj_target_states.append(((px + 1, py), _UP, 0)) \n\n  # Agent moves RIGHT (_RIGHT, value 3) to (px, py-1) -> faces East (1)\n  if py - 1 >= 0: # Target position is WEST of primitive\n    adj_target_states.append(((px, py - 1), _RIGHT, 1))\n      \n  # Agent moves DOWN (_DOWN, value 0) to (px-1, py) -> faces South (2)\n  if px - 1 >= 0: # Target position is NORTH of primitive\n    adj_target_states.append(((px - 1, py), _DOWN, 2))\n      \n  # Agent moves LEFT (_LEFT, value 2) to (px, py+1) -> faces West (3)\n  if py + 1 < HEIGHT: # Target position is EAST of primitive\n    adj_target_states.append(((px, py + 1), _LEFT, 3))\n  \n  if not adj_target_states:\n    return [] # No valid adjacent cells to primitive (e.g., primitive is at a corner of a tiny grid)\n\n  # 3. Use Breadth-First Search (BFS) to find the shortest path to any of the `adj_target_states`.\n  \n  # BFS queue: stores (current_pos, path_actions_so_far, last_action_executed_to_reach_curr_pos)\n  q = [(agent_pos, [], -1)] \n  \n  # Visited set: stores (position_tuple, current_facing_direction_at_pos)\n  # This prevents revisiting states that are equivalent or worse.\n  visited = {(agent_pos, agent_dir)} \n\n  # Map movement actions to their (dx, dy) effect and the resulting agent facing direction\n  # CraftState.step logic:\n  # _UP:    (-1, 0), new_dir=0 (North)\n  # _RIGHT: (0, 1),  new_dir=1 (East)\n  # _DOWN:  (1, 0),  new_dir=2 (South)\n  # _LEFT:  (0, -1), new_dir=3 (West)\n  move_action_map = {\n      _UP:    (-1, 0, 0), \n      _RIGHT: (0, 1, 1),\n      _DOWN:  (1, 0, 2),\n      _LEFT:  (0, -1, 3)\n  }\n\n  best_path_to_adjacent = None\n\n  while q:\n    (curr_x, curr_y), path_so_far, last_move_action = q.pop(0)\n\n    # Determine the current facing direction. \n    # If it's the initial state (last_move_action == -1), use the agent's initial direction.\n    # Otherwise, the direction is determined by the last move action taken.\n    current_facing_dir = agent_dir\n    if last_move_action != -1:\n      current_facing_dir = move_action_map[last_move_action][2]\n\n    # Check if the current state (position and direction) matches any of our target states for using the primitive\n    for (target_x, target_y), action_to_reach_target, required_dir in adj_target_states:\n      if (curr_x, curr_y) == (target_x, target_y) and current_facing_dir == required_dir:\n        best_path_to_adjacent = path_so_far\n        break # Found the shortest path, exit BFS\n    if best_path_to_adjacent is not None:\n      break \n\n    # Explore neighboring cells\n    for action_val, (dx, dy, new_dir_from_action) in move_action_map.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check if the next cell is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check for obstacles:\n      # 1. Cannot move directly onto the primitive's cell (must be adjacent).\n      # 2. Cannot move onto cells containing non-grabbable items (e.g., workshops, water).\n      is_blocked = False\n      if (next_x, next_y) == (px, py):\n        is_blocked = True \n      else:\n        # Iterate through all kinds at the next cell. If any is non-grabbable, it's blocked.\n        # This assumes `non_grabbable_indices` includes all impassable terrain/objects.\n        for k_idx in env.world.non_grabbable_indices:\n          if grid[next_x, next_y, k_idx] == 1.0:\n            is_blocked = True\n            break\n            \n      if is_blocked:\n        continue # Skip this path, the cell is blocked\n\n      # Add to queue if not visited\n      next_state_in_visited = ((next_x, next_y), new_dir_from_action)\n      if next_state_in_visited not in visited:\n        visited.add(next_state_in_visited)\n        q.append(((next_x, next_y), path_so_far + [action_val], action_val))\n\n  # 4. If a path was found, append the _USE action\n  if best_path_to_adjacent is not None:\n    return best_path_to_adjacent + [_USE]\n  else:\n    return [] # No path found to correctly positioned and oriented adjacent cell", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:38:09.462728", "function_name": "collect", "function_body": "    # Define actions based on CraftLab.action_specs()\n    actions_map = env.action_specs()\n    DOWN = actions_map['DOWN']\n    UP = actions_map['UP']\n    LEFT = actions_map['LEFT']\n    RIGHT = actions_map['RIGHT']\n    USE = actions_map['USE']\n\n    # Get initial observations from the current environment state\n    obs = env.observations()\n    inventory = obs['features_dict']['inventory']\n\n    # Check if the primitive is already collected in the inventory\n    if inventory[primitive] > 0:\n        return []\n\n    # Get the full grid and agent's current position\n    grid = obs['features_dict']['features_global']\n    agent_pos = tuple(obs['features_dict']['pos']) # (row, col)\n\n    grid_width, grid_height, _ = grid.shape\n\n    # Find all locations on the grid where the primitive exists\n    primitive_locations = []\n    for r in range(grid_width):\n        for c in range(grid_height):\n            # Check if the primitive kind is present at this grid cell\n            if grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    # If no instances of the primitive are found on the grid, it cannot be collected\n    if not primitive_locations:\n        return []\n\n    # Find the closest primitive location to the agent using Manhattan distance\n    def manhattan_distance(p1, p2):\n        return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n    target_primitive_pos = min(primitive_locations, key=lambda p: manhattan_distance(agent_pos, p))\n\n    # Use Breadth-First Search (BFS) to find the shortest path to the target primitive location\n    # The queue stores tuples of (current_position, path_taken_to_reach_current_position)\n    # collections.deque is assumed to be available (e.g., imported at module level)\n    q = collections.deque([(agent_pos, [])])\n    visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n    path_to_primitive = None\n\n    while q:\n        curr_pos, path = q.popleft()\n\n        # If the target position is reached, store the path and break\n        if curr_pos == target_primitive_pos:\n            path_to_primitive = path\n            break\n\n        r, c = curr_pos\n        \n        # Define possible movements and their corresponding actions\n        # The order here can affect which path is chosen if multiple shortest paths exist,\n        # but BFS guarantees a shortest path in terms of number of steps.\n        moves = [\n            ((r - 1, c), UP),    # Move Up\n            ((r + 1, c), DOWN),   # Move Down\n            ((r, c - 1), LEFT),   # Move Left\n            ((r, c + 1), RIGHT)   # Move Right\n        ]\n\n        for next_pos, action_id in moves:\n            next_r, next_c = next_pos\n            \n            # Check if the next position is within grid boundaries\n            if (0 <= next_r < grid_width and 0 <= next_c < grid_height):\n                # For this version, assume all grid cells are traversable.\n                # A more advanced version might check for impassable obstacles (e.g., walls).\n                if next_pos not in visited:\n                    visited.add(next_pos)\n                    q.append((next_pos, path + [action_id]))\n\n    # If no path was found to the primitive (e.g., it's in an unreachable area)\n    if path_to_primitive is None:\n        return []\n    \n    # After reaching the primitive's location, perform the USE action to collect it.\n    # The USE action typically picks up items on the current cell or interacts with adjacent objects.\n    return path_to_primitive + [USE]", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:39:57.922968", "function_name": "collect", "function_body": "  import collections\n\n  # Action definitions (constants)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # 1. Check if the primitive is already in inventory.\n  # If the agent already has the primitive, no actions are needed to collect it.\n  if env._current_state.inventory[primitive] > 0:\n    return []\n\n  # 2. Check if the primitive is a grabbable item. If not, it cannot be \"collected\" by walking and using.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information\n  current_pos = env._current_state.pos\n  start_x, start_y = current_pos\n  grid = env.observations()['features_dict']['features_global']\n  grid_width, grid_height, _ = grid.shape\n\n  # 3. Identify all grid cells that currently contain the primitive.\n  primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the grid, it cannot be collected.\n  if not primitive_locations:\n    return []\n\n  # 4. Determine \"effective target coordinates\": these are any cells from which\n  # the primitive can be collected using the ACTION_USE. Since ACTION_USE\n  # works on the 3x3 neighborhood, these targets include the primitive's own\n  # cell and all its 8 immediate neighbors (including diagonals).\n  effective_target_coords = set()\n  for px, py in primitive_locations:\n    # Iterate through the 3x3 neighborhood\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighbor coordinate is within grid bounds\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          effective_target_coords.add((nx, ny))\n\n  # Define possible movement actions and their corresponding (dx, dy) deltas\n  moves = {\n      ACTION_DOWN: (0, 1),   # Increase Y (move down)\n      ACTION_UP: (0, -1),    # Decrease Y (move up)\n      ACTION_LEFT: (-1, 0),  # Decrease X (move left)\n      ACTION_RIGHT: (1, 0),  # Increase X (move right)\n  }\n\n  # Determine which entities block movement.\n  # Non-grabbable items typically act as obstacles, except for workshops,\n  # which are generally considered traversable for agents.\n  blocker_indices = env.world.non_grabbable_indices - set(env.world.workshop_indices)\n\n  # Helper function to check if a given cell (x, y) is within bounds and passable.\n  def is_passable(x, y):\n    # Check grid bounds\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell contains any blocking entity\n    for blocker_idx in blocker_indices:\n      if grid[x, y, blocker_idx] == 1:\n        return False  # This cell contains an unpassable obstacle\n    return True  # Cell is passable\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path\n  # The queue stores tuples: (current_x, current_y, list_of_actions_to_reach_here).\n  queue = collections.deque([(start_x, start_y, [])])\n  # The visited set keeps track of coordinates to avoid cycles and redundant paths.\n  visited = set([(start_x, start_y)])\n\n  while queue:\n    cx, cy, current_path = queue.popleft()\n\n    # If the current position is one from which the primitive can be collected\n    # (i.e., it's in our set of effective target coordinates), we've found a path.\n    if (cx, cy) in effective_target_coords:\n      # Append the USE action as the final step to collect the primitive.\n      return current_path + [ACTION_USE]\n\n    # Explore neighboring cells\n    for action, (dx, dy) in moves.items():\n      nx, ny = cx + dx, cy + dy\n\n      # Check if the neighbor is passable and has not been visited yet.\n      if is_passable(nx, ny) and (nx, ny) not in visited:\n        visited.add((nx, ny))\n        new_path = current_path + [action]\n        queue.append((nx, ny, new_path))\n\n  # If the BFS completes and no path to any effective target location was found,\n  # it means the primitive is unreachable.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:39:58.907751", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (reinterpreted based on common DMLab/MiniGrid conventions\n  # for environments with an agent direction)\n  # Assuming these integer values correspond to the described actions:\n  ACTION_DOWN = 0   # Move Backward (relative to current direction)\n  ACTION_UP = 1     # Move Forward (relative to current direction)\n  ACTION_LEFT = 2   # Turn Left (changes agent's direction)\n  ACTION_RIGHT = 3  # Turn Right (changes agent's direction)\n  ACTION_USE = 4    # Use/interact with the cell directly in front\n\n  # Direction constants (standard for 2D grid worlds: North, East, South, West)\n  NORTH = 0\n  EAST = 1\n  SOUTH = 2\n  WEST = 3\n\n  # Delta for moving one step in each cardinal direction (relative to the grid)\n  DIR_TO_DELTA = {\n      NORTH: (0, -1),  # (dx, dy) for moving North\n      EAST: (1, 0),    # (dx, dy) for moving East\n      SOUTH: (0, 1),   # (dx, dy) for moving South\n      WEST: (-1, 0)    # (dx, dy) for moving West\n  }\n\n  # Maps for calculating new direction after a turn\n  TURN_LEFT_MAP = {\n      NORTH: WEST,\n      EAST: NORTH,\n      SOUTH: EAST,\n      WEST: SOUTH\n  }\n  TURN_RIGHT_MAP = {\n      NORTH: EAST,\n      EAST: SOUTH,\n      SOUTH: WEST,\n      WEST: NORTH\n  }\n\n  # Check if the primitive is a grabbable item. If not, it cannot be \"collected\" by walking and using.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information\n  current_pos = env._current_state.pos\n  start_x, start_y = current_pos\n  initial_dir = env._current_state.dir # Agent's initial facing direction\n\n  grid = env.observations()['features_dict']['features_global']\n  grid_width, grid_height = grid.shape[0], grid.shape[1]\n\n  # Determine which entities block movement.\n  # Non-grabbable items typically act as obstacles, except for workshops which are destinations.\n  blocker_indices = env.world.non_grabbable_indices - set(env.world.workshop_indices)\n\n  def is_passable(x, y):\n    \"\"\"Checks if a given cell (x, y) is within bounds and does not contain blocking entities.\"\"\"\n    # Check grid bounds\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell contains any blocking entity\n    for blocker_idx in blocker_indices:\n      if grid[x, y, blocker_idx] == 1:\n        return False # This cell contains an unpassable obstacle\n    return True # Cell is passable\n\n  # Perform Breadth-First Search (BFS)\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_to_reach_here)\n  queue = collections.deque([(start_x, start_y, initial_dir, [])])\n  # Set to keep track of visited states (x, y, direction) to avoid cycles and redundant paths\n  visited = set([(start_x, start_y, initial_dir)])\n\n  while queue:\n    cx, cy, c_dir, current_path = queue.popleft()\n\n    # --- Goal Check ---\n    # Calculate the coordinates of the cell directly in front of the agent.\n    # This is where the ACTION_USE would be applied.\n    f_dx, f_dy = DIR_TO_DELTA[c_dir]\n    target_x, target_y = cx + f_dx, cy + f_dy\n\n    # If the cell in front is within bounds and contains the primitive, we've found our path.\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive] == 1):\n      return current_path + [ACTION_USE] # Append USE action and return path\n\n    # --- Explore Possible Next States (Actions) ---\n\n    # 1. Try moving forward (ACTION_UP)\n    move_dx, move_dy = DIR_TO_DELTA[c_dir] # Delta based on current direction\n    nx_fwd, ny_fwd = cx + move_dx, cy + move_dy\n    next_dir_fwd = c_dir # Direction doesn't change when moving forward/backward\n\n    if is_passable(nx_fwd, ny_fwd) and (nx_fwd, ny_fwd, next_dir_fwd) not in visited:\n      visited.add((nx_fwd, ny_fwd, next_dir_fwd))\n      queue.append((nx_fwd, ny_fwd, next_dir_fwd, current_path + [ACTION_UP]))\n\n    # 2. Try moving backward (ACTION_DOWN)\n    # Moving backward is equivalent to moving forward in the opposite direction\n    # The opposite direction can be found by turning left twice or right twice.\n    opposite_dir = TURN_LEFT_MAP[TURN_LEFT_MAP[c_dir]]\n    move_dx, move_dy = DIR_TO_DELTA[opposite_dir]\n    nx_bwd, ny_bwd = cx + move_dx, cy + move_dy\n    next_dir_bwd = c_dir # Direction doesn't change when moving forward/backward\n\n    if is_passable(nx_bwd, ny_bwd) and (nx_bwd, ny_bwd, next_dir_bwd) not in visited:\n      visited.add((nx_bwd, ny_bwd, next_dir_bwd))\n      queue.append((nx_bwd, ny_bwd, next_dir_bwd, current_path + [ACTION_DOWN]))\n\n    # 3. Try turning left (ACTION_LEFT)\n    nx_turn_l, ny_turn_l = cx, cy # Position does not change on turn\n    next_dir_l = TURN_LEFT_MAP[c_dir] # New direction after turning\n\n    if (nx_turn_l, ny_turn_l, next_dir_l) not in visited:\n      visited.add((nx_turn_l, ny_turn_l, next_dir_l))\n      queue.append((nx_turn_l, ny_turn_l, next_dir_l, current_path + [ACTION_LEFT]))\n\n    # 4. Try turning right (ACTION_RIGHT)\n    nx_turn_r, ny_turn_r = cx, cy # Position does not change on turn\n    next_dir_r = TURN_RIGHT_MAP[c_dir] # New direction after turning\n\n    if (nx_turn_r, ny_turn_r, next_dir_r) not in visited:\n      visited.add((nx_turn_r, ny_turn_r, next_dir_r))\n      queue.append((nx_turn_r, ny_turn_r, next_dir_r, current_path + [ACTION_RIGHT]))\n\n  # If the BFS completes and no path to any target primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T08:42:03.972511", "function_name": "collect", "function_body": "  actions = []\n\n  # Action constants (typically defined globally or imported from a config)\n  # Defining them locally for this function as per strict completion rules.\n  # Assuming standard DMLab-like action mapping:\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # 1. Get initial state observations\n  # env.observations() returns a dict, including 'features_dict'\n  # 'features_dict' contains 'features_global', 'pos', 'direction', 'inventory'\n  obs = env.observations()\n  feat_dict = obs['features_dict']\n  \n  grid = feat_dict['features_global']  # grid is (WIDTH, HEIGHT, n_kinds)\n  # Position is a numpy array of floats, convert to tuple of ints for grid coordinates\n  current_pos = tuple(feat_dict['pos'].astype(int)) \n  \n  # Determine grid dimensions\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 2. Locate the primitive on the grid\n  # np.argwhere returns (row, col) which corresponds to (x, y) given grid's (WIDTH, HEIGHT) shape\n  primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n  if len(primitive_locations) == 0:\n      # Primitive not found on the grid, return no actions\n      return []\n\n  # Find the closest primitive location using Manhattan distance\n  closest_dist = float('inf')\n  primitive_target_pos = None # Stores the (px, py) coordinates of the closest primitive\n\n  for (px, py) in primitive_locations:\n      dist = abs(px - current_pos[0]) + abs(py - current_pos[1]) \n      if dist < closest_dist:\n          closest_dist = dist\n          primitive_target_pos = (px, py)\n  \n  # Safety check (should not be None if primitive_locations was not empty)\n  if primitive_target_pos is None:\n      return []\n\n  # 3. Determine a target adjacent position for the agent to stand\n  # The agent needs to be adjacent to the primitive to 'USE' it.\n  # We look for a cardinal (non-diagonal) neighbor of the primitive that is within grid bounds.\n  # We prioritize the one closest to the current agent position.\n  \n  px, py = primitive_target_pos\n  cardinal_neighbors = [\n      (px - 1, py), # Cell to the left of the primitive\n      (px + 1, py), # Cell to the right of the primitive\n      (px, py - 1), # Cell above the primitive\n      (px, py + 1)  # Cell below the primitive\n  ]\n\n  potential_adj_targets = []\n  for ax, ay in cardinal_neighbors:\n      if 0 <= ax < WIDTH and 0 <= ay < HEIGHT:\n          # For simplicity, we assume any in-bounds adjacent cell is traversable.\n          # A more advanced version (e.g., v3) would check if the cell is blocked by obstacles\n          # based on `CraftWorld.non_grabbable_indices` or `Cookbook.environment`.\n          distance_to_agent = abs(ax - current_pos[0]) + abs(ay - current_pos[1])\n          potential_adj_targets.append(((ax, ay), distance_to_agent))\n\n  if not potential_adj_targets:\n      # No valid adjacent position found (e.g., primitive is completely surrounded or at map edge)\n      return []\n\n  # Sort by distance to agent's current position to pick the best adjacent spot\n  potential_adj_targets.sort(key=lambda x: x[1])\n  target_adj_pos = potential_adj_targets[0][0] # The chosen (ax, ay)\n\n  # 4. Generate actions to move from current_pos to target_adj_pos\n  # We use a simple X-then-Y movement strategy. This path does not avoid obstacles.\n  sim_x, sim_y = current_pos # Simulated agent position\n\n  # Move horizontally first\n  while sim_x != target_adj_pos[0]:\n      if sim_x < target_adj_pos[0]:\n          actions.append(ACTION_RIGHT)\n          sim_x += 1\n      else: # sim_x > target_adj_pos[0]\n          actions.append(ACTION_LEFT)\n          sim_x -= 1\n          \n  # Then move vertically\n  while sim_y != target_adj_pos[1]:\n      if sim_y < target_adj_pos[1]:\n          actions.append(ACTION_DOWN)\n          sim_y += 1\n      else: # sim_y > target_adj_pos[1]\n          actions.append(ACTION_UP)\n          sim_y -= 1\n          \n  # 5. Perform the USE action\n  # Assumption: The 'USE' action works when the agent is adjacent to the item,\n  # regardless of its exact facing direction after the path is completed.\n  # If precise facing is required and no 'turn' actions exist,\n  # a more complex pathfinding algorithm or environment assumption would be needed.\n  actions.append(ACTION_USE)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:42:04.937464", "function_name": "collect", "function_body": "  from collections import deque\n\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  grid = features_dict['features_global']\n  current_pos = tuple(features_dict['pos']) # Convert numpy array to tuple for hashing\n\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Determine impassable kinds (assuming water is the primary one as per common CraftWorld setups)\n  impassable_kinds = set()\n  # Check if water_index exists and is not None before adding\n  if hasattr(env.world, 'water_index') and env.world.water_index is not None:\n      impassable_kinds.add(env.world.water_index)\n\n  # Check if the current position already allows using the primitive\n  # The agent's `dir` is fixed to 0 (North), meaning `USE` affects the cell at (r-1, c).\n  target_r_from_agent, target_c_from_agent = current_pos[0] - 1, current_pos[1]\n  if 0 <= target_r_from_agent < HEIGHT and 0 <= target_c_from_agent < WIDTH:\n      if grid[target_r_from_agent, target_c_from_agent, primitive] == 1:\n          return [env_factory.USE]\n\n  # Find all locations of the primitive on the grid\n  primitive_locations = []\n  for r in range(HEIGHT):\n      for c in range(WIDTH):\n          if grid[r, c, primitive] == 1:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      return [] # Primitive not found anywhere on the grid\n\n  # BFS to find the shortest path to a position from which the primitive can be 'used'.\n  # A position (r_agent, c_agent) allows 'using' a primitive at (r_prim, c_prim)\n  # if (r_prim, c_prim) == (r_agent - 1, c_agent) (because the agent faces North).\n\n  # Queue stores (current_position, actions_taken_so_far)\n  q = deque([(current_pos, [])])\n  visited = {current_pos} # Set of visited (r, c) positions to prevent cycles and redundant paths\n\n  # Possible moves and corresponding actions\n  # (delta_row, delta_col, action_constant)\n  moves = [\n      (1, 0, env_factory.DOWN),  # Move South (row + 1)\n      (-1, 0, env_factory.UP),   # Move North (row - 1)\n      (0, -1, env_factory.LEFT), # Move West (col - 1)\n      (0, 1, env_factory.RIGHT)  # Move East (col + 1)\n  ]\n\n  while q:\n      (r, c), actions = q.popleft()\n\n      # Check if the current position allows using any of the primitive locations\n      for pr, pc in primitive_locations:\n          # If agent at (r,c) facing North, it 'uses' (r-1, c)\n          if r - 1 == pr and c == pc:\n              # Found a path to a 'use' position for a primitive\n              return list(actions) + [env_factory.USE] # Append USE action and return the path\n\n      # Explore neighboring cells\n      for dr, dc, action_type in moves:\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= next_r < HEIGHT and 0 <= next_c < WIDTH):\n              continue\n\n          # Check if the next position has already been visited in a shorter or equal path\n          if next_pos in visited:\n              continue\n\n          # Check if the next position contains an impassable kind (e.g., water)\n          is_impassable = False\n          for k in impassable_kinds:\n              if grid[next_r, next_c, k] == 1:\n                  is_impassable = True\n                  break\n          if is_impassable:\n              continue\n          \n          # If the cell is valid and traversable, add it to the queue\n          visited.add(next_pos)\n          q.append((next_pos, actions + [action_type]))\n\n  # If the queue becomes empty and no path to a 'use' position was found\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:43:39.915389", "function_name": "collect", "function_body": "    import collections\n\n    state = env._current_state\n    actions = []\n\n    # 1. Check if the primitive is already in the inventory\n    if state.inventory[primitive] > 0:\n        return []\n\n    grid_height, grid_width, _ = state.grid.shape\n    \n    # Define movement deltas and their corresponding actions\n    # (dx, dy) for (LEFT, RIGHT, UP, DOWN)\n    move_deltas_to_action = {\n        (-1, 0): env_factory.LEFT,\n        (1, 0): env_factory.RIGHT,\n        (0, -1): env_factory.UP,\n        (0, 1): env_factory.DOWN\n    }\n    \n    # Map numerical direction (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT) to (dx, dy) vector\n    # This aligns with CraftState.dir attribute\n    DIR_TO_VECTOR = {\n        0: (0, 1),   # DOWN\n        1: (0, -1),  # UP\n        2: (-1, 0),  # LEFT\n        3: (1, 0)    # RIGHT\n    }\n    # Map (dx, dy) vector to numerical direction index\n    VECTOR_TO_DIR = {v: k for k, v in DIR_TO_VECTOR.items()}\n\n    # 2. Find all locations of the primitive on the grid\n    primitive_locations = []\n    for y in range(grid_height):\n        for x in range(grid_width):\n            if state.grid[y, x, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the grid\n\n    # 3. BFS to find the shortest path to a cell adjacent to (or on) the primitive\n    # Queue stores tuples of (current_position, list_of_coordinates_in_path)\n    q = collections.deque([(state.pos, [state.pos])])\n    visited = {state.pos} # Set of visited (x, y) positions\n\n    path_coords = None          # Stores the coordinate path found by BFS\n    target_primitive_location = None # The specific primitive instance we found a path to\n\n    while q:\n        curr_pos, curr_coord_path = q.popleft()\n        curr_x, curr_y = curr_pos\n\n        # Check if current position is adjacent to (or on) any primitive location\n        for p_x, p_y in primitive_locations:\n            # Manhattan distance <= 1 means adjacent or on the same square\n            if abs(curr_x - p_x) + abs(curr_y - p_y) <= 1:\n                path_coords = curr_coord_path\n                target_primitive_location = (p_x, p_y)\n                break\n        if path_coords:\n            break # Path found, exit BFS\n\n        # Explore neighbors (cardinal directions)\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Iterate through LEFT, RIGHT, UP, DOWN\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_pos = (next_x, next_y)\n\n            # Check grid boundaries and if the position has already been visited\n            if 0 <= next_x < grid_width and 0 <= next_y < grid_height and next_pos not in visited:\n                # Assuming all empty cells are traversable. No explicit obstacles are defined beyond grid boundaries.\n                visited.add(next_pos)\n                q.append((next_pos, curr_coord_path + [next_pos]))\n\n    if not path_coords:\n        return [] # No path found to any primitive location\n\n    # 4. Convert the coordinate path to an action sequence (movement actions)\n    # The first element in path_coords is the starting position (agent's initial pos)\n    # The last element is the agent's position from which it will perform USE.\n    for i in range(len(path_coords) - 1):\n        curr_c = path_coords[i]\n        next_c = path_coords[i+1]\n        diff_x = next_c[0] - curr_c[0]\n        diff_y = next_c[1] - curr_c[1]\n        actions.append(move_deltas_to_action[(diff_x, diff_y)])\n\n    # 5. Determine turning actions and add the USE action\n    last_agent_pos_after_moves = path_coords[-1]\n    p_x, p_y = target_primitive_location\n    agent_x, agent_y = last_agent_pos_after_moves\n\n    dx_to_primitive = p_x - agent_x\n    dy_to_primitive = p_y - agent_y\n\n    # Only turn if the agent is not already on the primitive itself (dx, dy are not 0,0)\n    if (dx_to_primitive, dy_to_primitive) != (0, 0):\n        # Determine the target direction the agent needs to face\n        target_dir_index = VECTOR_TO_DIR.get((dx_to_primitive, dy_to_primitive), -1)\n\n        # The agent's current direction (movement actions do not change agent's facing direction)\n        current_agent_dir = state.dir\n\n        # Calculate the shortest turn (difference modulo 4)\n        # 0: no turn, 1: 90 deg right, 2: 180 deg, 3: 90 deg left\n        turn_diff = (target_dir_index - current_agent_dir + 4) % 4\n\n        if turn_diff == 1: # 90 degrees clockwise (RIGHT)\n            actions.append(env_factory.RIGHT)\n        elif turn_diff == 2: # 180 degrees (two LEFTs or two RIGHTs)\n            actions.append(env_factory.LEFT) # Prefer two LEFT turns for 180 deg\n            actions.append(env_factory.LEFT)\n        elif turn_diff == 3: # 90 degrees counter-clockwise (LEFT)\n            actions.append(env_factory.LEFT)\n\n    # Finally, add the USE action to interact with the primitive\n    actions.append(env_factory.USE)\n\n    return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:43:40.883737", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants. These are typically imported from env_factory.actions,\n  # but to adhere to the \"no imports\" rule within the function, they are hardcoded\n  # with common integer values as specified in CraftLab.action_specs().\n  _ACTION_DOWN = 0\n  _ACTION_UP = 1\n  _ACTION_LEFT = 2\n  _ACTION_RIGHT = 3\n  _ACTION_USE = 4\n\n  # Define movement deltas (dx, dy) corresponding to each action.\n  # Assuming (0,0) is top-left, x increases right, y increases down.\n  _MOVE_DELTAS = {\n      _ACTION_RIGHT: (1, 0),\n      _ACTION_LEFT: (-1, 0),\n      _ACTION_DOWN: (0, 1),\n      _ACTION_UP: (0, -1),\n  }\n\n  state = env._current_state\n  world = state.world\n  grid = state.grid\n  current_pos = state.pos\n  inventory = state.inventory\n  primitive_idx = primitive\n\n  grid_width, grid_height, _ = grid.shape\n  # Entities that cannot be moved into (e.g., water, stone if they are obstacles)\n  impassable_indices = world.non_grabbable_indices \n\n  # 1. Early exit: If the primitive is already in inventory, no actions needed.\n  if inventory[primitive_idx] > 0:\n      return []\n\n  # 2. Early exit: If already next to the primitive, just use it.\n  # This covers the initial state if the agent starts adjacent to the primitive.\n  if state.next_to(primitive_idx):\n      return [_ACTION_USE]\n\n  # 3. Pre-compute all potential \"target positions\".\n  # These are walkable cells from which the agent can perform a _ACTION_USE to collect the primitive.\n  # A target position must be adjacent (4-way connected) to a primitive location.\n  target_positions = set()\n  primitive_locations_on_grid = []\n\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if grid[x, y, primitive_idx] == 1:\n              primitive_locations_on_grid.append((x, y))\n              # Check 4-directional neighbors of this primitive location\n              for dx, dy in _MOVE_DELTAS.values():\n                  nx, ny = x + dx, y + dy\n                  # Check if neighbor is within grid bounds\n                  if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                      # Check if the neighbor cell is walkable (not occupied by an impassable object)\n                      is_walkable_neighbor = True\n                      for i_kind in impassable_indices:\n                          if grid[nx, ny, i_kind] == 1:\n                              is_walkable_neighbor = False\n                              break\n                      if is_walkable_neighbor:\n                          target_positions.add((nx, ny))\n\n  # If no primitives are found on the map, or all primitives are surrounded by impassable terrain,\n  # then it's impossible to collect.\n  if not primitive_locations_on_grid or not target_positions:\n      return []\n\n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the pre-computed target_positions.\n  q = collections.deque([(current_pos, [])]) # Queue stores (position, list_of_actions_to_reach_pos)\n  visited = {current_pos} # Set to keep track of visited positions to avoid cycles and redundant paths\n\n  while q:\n      current_pos, path_actions = q.popleft()\n      px, py = current_pos\n\n      # If the current position is one of our target positions, we've found the shortest path.\n      # Append the USE action and return the full sequence.\n      if current_pos in target_positions:\n          return path_actions + [_ACTION_USE]\n\n      # Explore neighbors by trying all movement actions\n      for action, (dx, dy) in _MOVE_DELTAS.items():\n          nx, ny = px + dx, py + dy\n          next_pos = (nx, ny)\n\n          # Check if the next position is within grid boundaries and has not been visited yet\n          if 0 <= nx < grid_width and 0 <= ny < grid_height and next_pos not in visited:\n              # Check if the next position is walkable (not occupied by an impassable object)\n              is_walkable = True\n              for i_kind in impassable_indices:\n                  if grid[nx, ny, i_kind] == 1:\n                      is_walkable = False\n                      break\n\n              if is_walkable:\n                  visited.add(next_pos)\n                  # Add the next position and the updated list of actions to the queue\n                  q.append((next_pos, path_actions + [action]))\n\n  # If the queue becomes empty and no path to a target position was found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:44:56.899446", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:44:57.926440", "function_name": "collect", "function_body": "  \n  actions_taken = []\n  obs = env.reset() # Reset the environment to a new episode\n\n  # Get action mapping from the environment (e.g., {'DOWN': 0, 'UP': 1, ...})\n  action_map = env.action_specs()\n  \n  # Actions for movement, ordered for a simple systematic search pattern (e.g., turn clockwise if blocked)\n  # Based on the typical DMLab actions: DOWN:0, UP:1, LEFT:2, RIGHT:3, USE:4\n  move_actions = [action_map['RIGHT'], action_map['UP'], action_map['LEFT'], action_map['DOWN']]\n  current_move_direction_idx = 0 # Start by trying to move RIGHT\n\n  # Maximum number of steps to attempt to collect the primitive within this function.\n  # This prevents infinite loops if the primitive is unreachable or the search strategy is poor.\n  max_collect_attempts = 500 \n\n  def _is_primitive_in_neighborhood(features_ego_obs: np.ndarray, primitive_idx: int) -> bool:\n      \"\"\"\n      Checks if the primitive is present in the 3x3 neighborhood around the agent within the egocentric view.\n      Assumes features_ego_obs is centered on the agent.\n      \"\"\"\n      ego_h, ego_w, _ = features_ego_obs.shape\n      # Assuming agent is at the center of the ego view, typically (ego_h // 2, ego_w // 2)\n      agent_ego_y, agent_ego_x = ego_h // 2, ego_w // 2 \n\n      for dy in [-1, 0, 1]:\n          for dx in [-1, 0, 1]:\n              if dy == 0 and dx == 0:  # Skip the agent's own cell\n                  continue\n              ny, nx = agent_ego_y + dy, agent_ego_x + dx\n              \n              # Check bounds for the ego view\n              if 0 <= ny < ego_h and 0 <= nx < ego_w:\n                  # If the primitive kind is present in this neighbor cell, return True\n                  if features_ego_obs[ny, nx, primitive_idx] > 0:\n                      return True\n      return False\n\n  for _ in range(max_collect_attempts):\n      current_inventory = obs['features_dict']['inventory']\n\n      # 1. Check if the primitive has already been collected\n      if current_inventory[primitive] > 0:\n          break # Primitive collected, exit loop\n\n      current_features_ego = obs['features_dict']['features_ego']\n\n      # 2. Prioritize using the primitive if it's in the immediate neighborhood\n      if _is_primitive_in_neighborhood(current_features_ego, primitive):\n          reward, done, obs = env.step(action_map['USE'])\n          actions_taken.append(action_map['USE'])\n          \n          # Re-check inventory immediately after USE action, as it might have been collected\n          current_inventory = obs['features_dict']['inventory']\n          if current_inventory[primitive] > 0:\n              break # Primitive collected\n          # If USE didn't result in collection (e.g., it was a workshop, or required a tool),\n          # the loop continues to try other actions. For a primitive resource, USE should typically work.\n\n      # 3. If primitive is not in the neighborhood, try to move to explore\n      else:\n          action_to_take = move_actions[current_move_direction_idx]\n          \n          prev_pos_norm = obs['features_dict']['pos'] # Agent's normalized position before taking action\n          reward, done, obs = env.step(action_to_take)\n          actions_taken.append(action_to_take)\n          new_pos_norm = obs['features_dict']['pos'] # Agent's normalized position after taking action\n\n          # Check if the agent's position changed significantly.\n          # If not, it implies the agent hit a wall or obstacle, so try a different direction.\n          if np.linalg.norm(new_pos_norm - prev_pos_norm) < 1e-6: # Using a small epsilon for float comparison\n              current_move_direction_idx = (current_move_direction_idx + 1) % len(move_actions)\n          # If position changed, keep the same direction, encouraging straight-line exploration.\n\n      if done: # If the environment's internal max_steps is reached or another termination condition\n          break\n\n  return actions_taken", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:46:35.833491", "function_name": "collect", "function_body": "  # Action constants derived from CraftLab.action_specs()\n  # (DOWN, UP, LEFT, RIGHT, USE) map to (0, 1, 2, 3, 4)\n  _DOWN = 0\n  _UP = 1\n  _LEFT = 2\n  _RIGHT = 3\n  _USE = 4\n\n  # Map action to (delta_row, delta_col) for grid movement\n  _ACTION_DELTAS = {\n      _DOWN: (1, 0),  # Moving down increases row index\n      _UP: (-1, 0),   # Moving up decreases row index\n      _LEFT: (0, -1), # Moving left decreases column index\n      _RIGHT: (0, 1), # Moving right increases column index\n  }\n\n  # Map (delta_row, delta_col) to action for pathfinding\n  _DELTA_TO_ACTION = {\n      (1, 0): _DOWN,\n      (-1, 0): _UP,\n      (0, -1): _LEFT,\n      (0, 1): _RIGHT,\n  }\n\n  current_state = env._current_state\n  \n  # 1. Check if the primitive is already in the agent's inventory\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  # Get grid dimensions and current agent position\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n  current_pos = current_state.pos # (row, col) tuple of agent's current position\n\n  # 2. Find all occurrences of the target primitive on the grid\n  target_item_positions = []\n  for r in range(grid_height):\n    for c in range(grid_width):\n      # If the cell (r, c) contains the primitive item\n      if grid[r, c, primitive] > 0:\n        target_item_positions.append((r, c))\n\n  if not target_item_positions:\n    # The primitive item is not present anywhere on the grid\n    return []\n\n  # 3. Use Breadth-First Search (BFS) to find the shortest path\n  #    to a cell from which the primitive can be collected.\n  #    A cell (r, c) is considered a valid collection point if it's the\n  #    same location as the primitive or directly adjacent (Manhattan distance <= 1).\n  \n  # Queue stores tuples: ((current_row, current_col), list_of_actions_to_reach_here)\n  # collections.deque is assumed to be available (e.g., imported at module level)\n  queue = collections.deque([(current_pos, [])]) \n  # Set to keep track of visited positions to avoid cycles and redundant paths\n  visited = {current_pos}\n\n  while queue:\n    (r, c), path_actions = queue.popleft()\n\n    # Check if the current position is a valid collection point for any target primitive\n    for tr, tc in target_item_positions:\n        # If agent is on the same cell as the primitive (Manhattan distance 0)\n        # or directly adjacent to it (Manhattan distance 1), it can be collected.\n        if abs(r - tr) + abs(c - tc) <= 1:\n            # Found a path to a collection point. Add the USE action and return.\n            return path_actions + [_USE]\n\n    # Explore neighboring cells (UP, DOWN, LEFT, RIGHT)\n    for dr, dc in _ACTION_DELTAS.values():\n      nr, nc = r + dr, c + dc\n\n      # Check if the new position is within grid bounds\n      if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n        continue\n      \n      # Check if the new position has already been visited in this BFS traversal\n      if (nr, nc) in visited:\n        continue\n\n      # For collect_v2, we assume all cells are traversable unless explicitly blocked\n      # by the environment itself (e.g., walls). Without explicit wall indices from `world.index`,\n      # we assume direct movement is possible to any unvisited cell within bounds.\n\n      # Add the new position to visited set and queue for further exploration\n      visited.add((nr, nc))\n      next_action = _DELTA_TO_ACTION[(dr, dc)]\n      queue.append(((nr, nc), path_actions + [next_action]))\n  \n  # If the BFS completes and no path to a collection point was found,\n  # it means the primitive is unreachable (e.g., trapped, or on an unreachable island).\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:46:36.868727", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir # 0:N, 1:E, 2:S, 3:W\n  \n  # Grid dimensions\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Non-grabbable items define obstacles for movement\n  # CraftWorld.non_grabbable_indices is cookbook.environment\n  non_grabbable_indices = current_state.world.cookbook.environment\n\n  def is_valid_pos(r, c):\n    \"\"\"Checks if coordinates (r, c) are within grid boundaries.\"\"\"\n    return 0 <= r < WIDTH and 0 <= c < HEIGHT\n\n  def is_blocked_for_movement(r, c):\n    \"\"\"Checks if a cell (r, c) is blocked for agent movement by non-grabbable items.\"\"\"\n    if not is_valid_pos(r, c):\n      return True\n    # A cell is blocked if it contains any non-grabbable item.\n    # Primitives are assumed to be grabbable, so they are not in non_grabbable_indices.\n    for idx in non_grabbable_indices:\n      if grid[r, c, idx] > 0:\n        return True\n    return False\n\n  def get_front_cell(r, c, d):\n    \"\"\"Returns the coordinates of the cell directly in front of (r, c) given direction d.\"\"\"\n    if d == 0:  # North (UP)\n      return r - 1, c\n    if d == 1:  # East (RIGHT)\n      return r, c + 1\n    if d == 2:  # South (DOWN)\n      return r + 1, c\n    if d == 3:  # West (LEFT)\n      return r, c - 1\n    return None # Should not be reached with valid directions\n\n  # Using collections.deque for efficient BFS. Assumes 'collections' is available.\n  q = collections.deque([(initial_pos[0], initial_pos[1], initial_dir, [])])\n  # visited stores (row, col, direction) to prevent cycles and redundant exploration\n  visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n  # Mapping of movement actions to (dr, dc, new_direction)\n  # When agent moves, its direction aligns with the movement.\n  move_actions_map = {\n      env_factory.ACTIONS.UP:    (-1, 0, 0),  # d_row, d_col, new_dir (North: 0)\n      env_factory.ACTIONS.DOWN:  (1, 0, 2),   # d_row, d_col, new_dir (South: 2)\n      env_factory.ACTIONS.LEFT:  (0, -1, 3),  # d_row, d_col, new_dir (West: 3)\n      env_factory.ACTIONS.RIGHT: (0, 1, 1),   # d_row, d_col, new_dir (East: 1)\n  }\n\n  while q:\n    r, c, d, current_actions = q.popleft()\n\n    # Check if a 'USE' action from the current position and direction would collect the primitive.\n    # This means the cell directly in front must contain the primitive and be a valid cell.\n    target_r, target_c = get_front_cell(r, c, d)\n    if is_valid_pos(target_r, target_c) and grid[target_r, target_c, primitive] > 0:\n      # Found a path to be adjacent to the primitive and facing it.\n      return current_actions + [env_factory.ACTIONS.USE]\n\n    # Explore possible movement actions\n    for action_val, (dr, dc, new_d) in move_actions_map.items():\n      next_r, next_c = r + dr, c + dc\n      next_d = new_d # Agent's direction changes to match the movement direction\n\n      if not is_blocked_for_movement(next_r, next_c):\n        if (next_r, next_c, next_d) not in visited:\n          visited.add((next_r, next_c, next_d))\n          q.append((next_r, next_c, next_d, current_actions + [action_val]))\n\n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:48:17.432812", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Define action constants based on the problem's action_specs:\n    # DOWN\u21920, UP\u21921, LEFT\u21922, RIGHT\u21923, USE\u21924\n    _A_DOWN = 0\n    _A_UP = 1\n    _A_LEFT = 2\n    _A_RIGHT = 3\n    _A_USE = 4\n\n    # Map problem's action values to (dx, dy) movements.\n    # We assume UP moves North (N), DOWN moves South (S), LEFT moves West (W), RIGHT moves East (E).\n    # These deltas align with env_factory.constants.DIR_DELTAS for N, S, W, E.\n    _ACTION_DELTAS_BY_ACTION = {\n        _A_UP: env_factory.constants.DIR_DELTAS[env_factory.constants.DIRECTIONS['N']],\n        _A_DOWN: env_factory.constants.DIR_DELTAS[env_factory.constants.DIRECTIONS['S']],\n        _A_LEFT: env_factory.constants.DIR_DELTAS[env_factory.constants.DIRECTIONS['W']],\n        _A_RIGHT: env_factory.constants.DIR_DELTAS[env_factory.constants.DIRECTIONS['E']],\n    }\n\n    # Map problem's action values to the direction the agent faces after that action.\n    # Crucial assumption: performing a movement action makes the agent face that direction.\n    _ACTION_TO_FACING_DIR = {\n        _A_UP: env_factory.constants.DIRECTIONS['N'],\n        _A_DOWN: env_factory.constants.DIRECTIONS['S'],\n        _A_LEFT: env_factory.constants.DIRECTIONS['W'],\n        _A_RIGHT: env_factory.constants.DIRECTIONS['E'],\n    }\n\n    # Access current state from the environment.\n    # The `env` object is a CraftLab instance, and it holds the current CraftState.\n    current_state = env._current_state\n    grid = current_state.grid\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir\n\n    # Grid shape is (WIDTH, HEIGHT, n_kinds)\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # Breadth-First Search (BFS) setup\n    q = collections.deque()\n    # BFS state: (current_pos_x, current_pos_y, current_direction, list_of_actions_taken_so_far)\n    q.append((initial_pos[0], initial_pos[1], initial_dir, []))\n\n    # Visited set to avoid cycles and redundant paths.\n    # A state is defined by (position_x, position_y, current_direction).\n    visited = set()\n    visited.add((initial_pos[0], initial_pos[1], initial_dir))\n\n    while q:\n        curr_x, curr_y, curr_dir, path_actions = q.popleft()\n\n        # 1. Check if the 'USE' action can be performed from the current (pos, dir) state\n        # Calculate the coordinates of the cell directly in front of the agent\n        # using standard direction deltas from env_factory.constants.\n        front_dx, front_dy = env_factory.constants.DIR_DELTAS[curr_dir]\n        front_cell_x, front_cell_y = curr_x + front_dx, curr_y + front_dy\n\n        # Check if the front cell is within grid boundaries\n        if (0 <= front_cell_x < WIDTH and 0 <= front_cell_y < HEIGHT):\n            # Check if the front cell contains the target primitive\n            if grid[front_cell_x, front_cell_y, primitive] > 0:\n                # Found a path to a position and orientation from which 'USE' works.\n                # Return the sequence of actions leading to this state plus the 'USE' action.\n                return path_actions + [_A_USE]\n\n        # 2. Explore next possible states by taking movement actions\n        # (A_UP, A_DOWN, A_LEFT, A_RIGHT)\n        for action_type in [_A_UP, _A_DOWN, _A_LEFT, _A_RIGHT]:\n            move_dx, move_dy = _ACTION_DELTAS_BY_ACTION[action_type]\n            next_x, next_y = curr_x + move_dx, curr_y + move_dy\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                continue\n\n            # Crucial assumption: performing a movement action also changes the agent's\n            # facing direction to match the direction of movement.\n            next_dir = _ACTION_TO_FACING_DIR[action_type]\n\n            # If this new (position, direction) state has not been visited yet, add it to the queue.\n            if (next_x, next_y, next_dir) not in visited:\n                visited.add((next_x, next_y, next_dir))\n                q.append((next_x, next_y, next_dir, path_actions + [action_type]))\n\n    # If the BFS queue is exhausted and no path to collect the primitive was found,\n    # it means the primitive is unreachable from the current state.\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:48:18.411217", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from problem description)\n  _ACTION_DOWN = 0\n  _ACTION_UP = 1\n  _ACTION_LEFT = 2\n  _ACTION_RIGHT = 3\n  _ACTION_USE = 4\n\n  # Delta (dy, dx) for each action (row, col)\n  _MOVE_DELTAS = {\n      _ACTION_DOWN: (1, 0),\n      _ACTION_UP: (-1, 0),\n      _ACTION_LEFT: (0, -1),\n      _ACTION_RIGHT: (0, 1),\n  }\n\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Current agent position (normalized [norm_x, norm_y])\n  current_norm_pos = obs['features_dict']['pos']\n  \n  # Grid dimensions (HEIGHT, WIDTH, n_kinds)\n  H, W, _ = grid.shape\n  \n  # Convert normalized position to integer grid coordinates (row, col)\n  current_row = int(current_norm_pos[1] * H)\n  current_col = int(current_norm_pos[0] * W)\n  start_pos = (current_row, current_col)\n\n  # Check if primitive is already in inventory.\n  # If so, we assume no further collection is needed for this simple function.\n  inventory = obs['features_dict']['inventory']\n  if inventory[primitive] > 0:\n      return []\n\n  # Find all locations on the grid where the primitive exists\n  primitive_locations = []\n  for r in range(H):\n      for c in range(W):\n          if grid[r, c, primitive] > 0:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      # Primitive not found on the map\n      return []\n\n  # Identify impassable terrain indices (water, stone from CraftWorld)\n  impassable_indices = set()\n  if hasattr(env, 'world'):\n      if hasattr(env.world, 'water_index'):\n          impassable_indices.add(env.world.water_index)\n      if hasattr(env.world, 'stone_index'):\n          impassable_indices.add(env.world.stone_index)\n\n  # Perform Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples of ((row, col), list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])])\n  visited = {start_pos} # Keep track of visited positions to avoid cycles\n\n  while q:\n      (r, c), path = q.popleft()\n\n      # If the current position contains the primitive, we have found a target.\n      # The CraftState.next_to method checks a 3x3 neighborhood, meaning\n      # if the agent is on the same cell as the item, or one step away, USE works.\n      # Reaching the item's cell is the most direct path.\n      if (r, c) in primitive_locations:\n          return path + [_ACTION_USE]\n\n      # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n      for action, (dr, dc) in _MOVE_DELTAS.items():\n          nr, nc = r + dr, c + dc\n\n          # Check if the new position is within grid bounds\n          if 0 <= nr < H and 0 <= nc < W:\n              # Check for impassable terrain\n              is_impassable = False\n              for idx in impassable_indices:\n                  if grid[nr, nc, idx] > 0: # If the cell contains an impassable kind\n                      is_impassable = True\n                      break\n              if is_impassable:\n                  continue # Skip this cell, it's blocked\n\n              # If not visited and not impassable, add to queue\n              if (nr, nc) not in visited:\n                  visited.add((nr, nc))\n                  q.append(((nr, nc), path + [action]))\n  \n  # If BFS completes and no path to any primitive location is found\n  return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:49:41.532380", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Get action mappings from the environment\n    action_map = env.action_specs()\n    # Create a reverse mapping for convenience, e.g., 'USE' -> 4\n    ACTIONS = {name: val for name, val in action_map.items()}\n\n    A_DOWN = ACTIONS['DOWN']\n    A_UP = ACTIONS['UP']\n    A_LEFT = ACTIONS['LEFT']\n    A_RIGHT = ACTIONS['RIGHT']\n    A_USE = ACTIONS['USE']\n\n    initial_state = env._current_state\n\n    # 1. Check if primitive is already collected in the initial state\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    q = collections.deque()\n    # BFS state: (current_CraftState_instance, current_path_list)\n    q.append((initial_state, []))\n\n    # Visited set to avoid cycles and redundant exploration.\n    # A state is defined by (agent_position_tuple, inventory_count_of_primitive).\n    # This simplified visited key assumes that changes to the grid (other than the\n    # collected primitive itself) do not fundamentally alter the reachability of\n    # *other* instances of the same primitive or that the first collected instance suffices.\n    visited = set()\n    # Add initial state to visited\n    visited.add((initial_state.pos, initial_state.inventory[primitive]))\n\n    max_bfs_depth = 50 # Limit the search depth to prevent excessive computation\n\n    while q:\n        current_craft_state, path_so_far = q.popleft()\n\n        if len(path_so_far) >= max_bfs_depth:\n            continue # Prune search branches that are too deep\n\n        # 2. Check if the primitive is next to the agent and can be collected via USE action\n        if current_craft_state.next_to(primitive):\n            # Simulate the USE action to check its outcome\n            # CraftState.step returns a *new* state, which is perfect for BFS\n            reward_use, state_after_use = current_craft_state.step(A_USE)\n            \n            # If the primitive is now in inventory after USE, this path is a solution\n            if state_after_use.inventory[primitive] > 0:\n                return path_so_far + [A_USE]\n            \n            # If USE did not collect the primitive (e.g., wrong tool, or it's not a 'useable' primitive),\n            # we don't add this 'USE' action to a successful path. We continue exploring movement actions\n            # from the current_craft_state, as if the 'USE' attempt failed to achieve the goal.\n\n        # 3. Explore possible movement actions (UP, DOWN, LEFT, RIGHT)\n        for action in [A_UP, A_DOWN, A_LEFT, A_RIGHT]:\n            # Simulate the action to get the next state\n            reward_move, next_state = current_craft_state.step(action)\n\n            # Define the key for the visited set for the next state\n            next_state_key = (next_state.pos, next_state.inventory[primitive])\n\n            # If this state has not been visited before with the same relevant inventory\n            if next_state_key not in visited:\n                # Check if the primitive is collected by simply moving into its square (e.g., water)\n                if next_state.inventory[primitive] > 0:\n                    return path_so_far + [action]\n\n                # If not collected yet, add to visited set and queue for further exploration\n                visited.add(next_state_key)\n                q.append((next_state, path_so_far + [action]))\n\n    # If the queue is exhausted and no path to collect the primitive was found within the depth limit\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:49:42.521073", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:50:50.257674", "function_name": "collect", "function_body": "  # Action constants (numerical values from CraftLab's action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Defines movement for each action: (dx, dy, resulting_facing_direction_index)\n  # The direction indices (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) correspond to the agent's\n  # facing direction *after* the move.\n  MOVE_ACTIONS_PROPERTIES = {\n      ACTION_UP: (0, -1, 0),    # Move UP: change Y by -1, new facing_dir is 0 (UP)\n      ACTION_RIGHT: (1, 0, 1),  # Move RIGHT: change X by +1, new facing_dir is 1 (RIGHT)\n      ACTION_DOWN: (0, 1, 2),   # Move DOWN: change Y by +1, new facing_dir is 2 (DOWN)\n      ACTION_LEFT: (-1, 0, 3),  # Move LEFT: change X by -1, new facing_dir is 3 (LEFT)\n  }\n\n  # This table helps determine which (agent_x, agent_y) and agent_dir are needed\n  # to use an item at (item_x, item_y).\n  # Assuming ACTION_USE interacts with the cell *in front* of the agent.\n  # If agent at (ax,ay) faces dir and uses (ax+use_dx, ay+use_dy) == (item_x, item_y):\n  # Facing UP (0): (use_dx, use_dy) is (0, -1). So (ax, ay-1) == (item_x, item_y) => ax=item_x, ay=item_y+1.\n  # Facing RIGHT (1): (use_dx, use_dy) is (1, 0). So (ax+1, ay) == (item_x, item_y) => ax=item_x-1, ay=item_y.\n  # Facing DOWN (2): (use_dx, use_dy) is (0, 1). So (ax, ay+1) == (item_x, item_y) => ax=item_x, ay=item_y-1.\n  # Facing LEFT (3): (use_dx, use_dy) is (-1, 0). So (ax-1, ay) == (item_x, item_y) => ax=item_x+1, ay=item_y.\n  # This map stores (dx_from_item, dy_from_item) to get agent's position (ax, ay)\n  # when item is at (px, py) and agent faces `agent_dir`.\n  AGENT_POS_RELATIVE_TO_ITEM = {\n      0: (0, 1),   # Agent faces UP (0), agent is at (px, py+1) to USE item at (px,py)\n      1: (-1, 0),  # Agent faces RIGHT (1), agent is at (px-1, py) to USE item at (px,py)\n      2: (0, -1),  # Agent faces DOWN (2), agent is at (px, py-1) to USE item at (px,py)\n      3: (1, 0),   # Agent faces LEFT (3), agent is at (px+1, py) to USE item at (px,py)\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information from the environment's internal state\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Get the set of indices for non-grabbable entities (obstacles)\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  # Helper function to check if a grid cell is within bounds and not occupied by an obstacle.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    \n    # Check if the cell is occupied by any non-grabbable item (which acts as an obstacle).\n    # This assumes non-grabbable items always block movement.\n    for k_idx in non_grabbable_kinds:\n      if grid[x, y, k_idx] == 1: # Assuming 1 indicates presence of the kind\n        return False\n    return True\n\n  # 2. Pre-compute all (agent_x, agent_y, agent_direction) states from which the primitive\n  # can be collected by performing an ACTION_USE.\n  # These are the target states for our BFS.\n  collectable_agent_states = set()\n\n  # Iterate through all cells in the grid to find instances of the target primitive.\n  for px in range(grid_width):\n    for py in range(grid_height):\n      if grid[px, py, primitive] == 1:\n        # This cell (px, py) contains the primitive.\n        # Now, find all possible agent positions (ax, ay) and agent directions (adir)\n        # such that the agent at (ax, ay) facing adir would point to (px, py) for USE.\n        \n        # Iterate over all possible agent facing directions (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n        for agent_dir, (relative_dx_from_item, relative_dy_from_item) in AGENT_POS_RELATIVE_TO_ITEM.items():\n          # Calculate the agent's position (ax, ay) given the item's position (px, py)\n          # and the required relative position (relative_dx_from_item, relative_dy_from_item).\n          ax, ay = px + relative_dx_from_item, py + relative_dy_from_item\n\n          # If this agent position is walkable, add the full state to collectable_agent_states.\n          if is_walkable(ax, ay):\n            collectable_agent_states.add((ax, ay, agent_dir))\n\n  # If no collectable primitive instances are found on the grid, or no reachable collection points,\n  # return an empty path.\n  if not collectable_agent_states:\n      return []\n\n  # 3. Breadth-First Search (BFS) to find the shortest sequence of actions.\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to avoid redundant exploration and cycles. A state is defined by\n  # (x, y, direction) because the agent's direction affects what it can interact with (USE action).\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the current state is one from which the primitive can be collected.\n    if (curr_x, curr_y, curr_dir) in collectable_agent_states:\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next movement actions.\n    for action, (move_dx, move_dy, next_dir) in MOVE_ACTIONS_PROPERTIES.items():\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n\n      # If the next cell is walkable and this (position, direction) state hasn't been visited,\n      # add it to the queue for further exploration.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T08:50:51.236753", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants (numerical values from CraftLab's action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Defines movement for each action: (dx, dy, resulting_facing_direction_index)\n  # The direction indices (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) are assumed consistent\n  # with how the agent's internal direction changes after movement.\n  MOVE_ACTIONS_PROPERTIES = {\n      ACTION_UP: (0, -1, 0),    # Move UP: change Y by -1, new facing_dir is 0 (UP)\n      ACTION_RIGHT: (1, 0, 1),  # Move RIGHT: change X by +1, new facing_dir is 1 (RIGHT)\n      ACTION_DOWN: (0, 1, 2),   # Move DOWN: change Y by +1, new facing_dir is 2 (DOWN)\n      ACTION_LEFT: (-1, 0, 3),  # Move LEFT: change X by -1, new facing_dir is 3 (LEFT)\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information from the environment's internal state\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Get the set of indices for non-grabbable entities (obstacles)\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  # --- Improvement: Pre-compute a walkable grid for faster lookups ---\n  # Initialize all cells as walkable (True)\n  walkable_grid = np.ones((grid_width, grid_height), dtype=bool)\n  \n  # Mark cells as non-walkable (False) if they contain any non-grabbable item\n  for x in range(grid_width):\n    for y in range(grid_height):\n      for k_idx in non_grabbable_kinds:\n        if grid[x, y, k_idx] == 1: # Assuming 1 indicates presence of the kind\n          walkable_grid[x, y] = False\n          break # This cell is an obstacle, no need to check other kinds for it\n  # --- End of improvement ---\n\n  # Helper function to check if a grid cell is within bounds and walkable.\n  # This version uses the pre-computed `walkable_grid` for O(1) checks.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    return walkable_grid[x, y]\n\n  # 2. Pre-compute all (agent_x, agent_y, agent_direction) states from which the primitive\n  # can be collected by performing an ACTION_USE.\n  collectable_states = set()\n\n  # Iterate through all cells in the grid to find instances of the target primitive.\n  for px in range(grid_width):\n    for py in range(grid_height):\n      if grid[px, py, primitive] == 1:\n        # This cell (px, py) contains the primitive.\n        # Now, find all possible agent positions (ax, ay) and agent directions (adir)\n        # such that the agent at (ax, ay) facing adir would point to (px, py).\n        \n        # Iterate over all possible movement actions and their properties\n        for action_val, (dx, dy, agent_dir) in MOVE_ACTIONS_PROPERTIES.items():\n          # If an agent at (ax, ay) moves by (dx, dy) to (px, py),\n          # then its current position (ax, ay) must be (px - dx, py - dy).\n          ax, ay = px - dx, py - dy\n\n          # If this agent position is walkable, add the full state to collectable_states.\n          if is_walkable(ax, ay):\n            collectable_states.add((ax, ay, agent_dir))\n\n  # If no collectable primitive instances are found on the grid, or no reachable collection points,\n  # return an empty path.\n  if not collectable_states:\n      return []\n\n  # 3. Breadth-First Search (BFS) to find the shortest sequence of actions.\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to avoid redundant exploration and cycles. A state is defined by\n  # (x, y, direction) because the agent's direction affects what it can interact with (USE action).\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the current state is one from which the primitive can be collected.\n    if (curr_x, curr_y, curr_dir) in collectable_states:\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next movement actions.\n    for action, (move_dx, move_dy, next_dir) in MOVE_ACTIONS_PROPERTIES.items():\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n\n      # If the next cell is walkable and this (position, direction) state hasn't been visited,\n      # add it to the queue for further exploration.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T08:51:50.321126", "function_name": "collect", "function_body": "  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name\n  # The index method will add the primitive to the cookbook's index if it doesn't already exist.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable\n  if primitive_idx not in env.world.grabbable_indices:\n    # This primitive cannot be picked up (e.g., water, stone if not grabbable),\n    # so \"collecting\" it via USE is not possible.\n    return []\n\n  # 3. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 4. Retrieve grid dimensions and non-grabbable indices for boundary and impassable checks\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n  \n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a position and orientation from which the primitive can be collected via USE.\n  # BFS state: ((current_x, current_y), current_direction, [list_of_actions_to_reach_here])\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's initial direction (0-3)\n\n  # Using collections.deque for efficient queue operations in BFS\n  import collections\n  queue = collections.deque([(start_pos, start_dir, [])]) \n  \n  # Set of visited ((x, y), direction) tuples to prevent cycles and redundant path exploration\n  visited = {(start_pos, start_dir)} \n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.popleft() # Dequeue for BFS\n\n    # Calculate the coordinates of the cell directly in front of the agent,\n    # which is the target for the USE action.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # Check if the cell in front is within bounds and contains the primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      # Found a path where the agent can move to a position, face the primitive,\n      # and then USE to collect it.\n      return path_actions + [USE_ACTION]\n    \n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # A movement action changes the agent's position and its facing direction.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position is impassable (contains any non-grabbable item).\n      # Assuming the agent cannot move into cells occupied by non-grabbable items.\n      is_impassable = False\n      for k_idx in non_grabbable_indices:\n        if grid[next_x, next_y, k_idx] > 0:\n          is_impassable = True\n          break\n      if is_impassable:\n        continue\n      \n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple) # Mark the new state as visited\n        # Add the new state and its path to the queue for further exploration\n        queue.append((next_state_tuple[0], next_state_tuple[1], path_actions + [move_action]))\n\n  # If the queue becomes empty and no path was found, it means the primitive\n  # is unreachable from the current state.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T08:51:51.324353", "function_name": "collect", "function_body": "  # Define constants used for actions and coordinate differences.\n  # These are defined outside the function in the final script, but included here for completeness\n  # as if they were internal definitions for this specific function scope.\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name\n  # The index method will add the primitive to the cookbook's index if it doesn't already exist.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable\n  if primitive_idx not in env.world.grabbable_indices:\n    # This primitive cannot be picked up (e.g., water, stone if not grabbable),\n    # so \"collecting\" it via USE is not possible.\n    return []\n\n  # 3. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 4. Retrieve grid dimensions and impassable object indices\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  water_idx = env.world.water_index\n  stone_idx = env.world.stone_index\n  # Assuming non_grabbable_indices may also contain other impassable terrain types,\n  # but explicitly checking water/stone as per v0's more specific logic.\n  # For robustness, we could iterate over all non_grabbable_indices if they consistently imply impassability.\n\n  # Helper function to check if a cell is impassable for the agent to move *into*.\n  # A cell is impassable if it contains water or stone, UNLESS the primitive itself is water or stone.\n  def _is_cell_impassable(x, y, target_p_idx, current_grid, water_i, stone_i):\n    if target_p_idx != water_i and current_grid[x, y, water_i] > 0:\n      return True\n    if target_p_idx != stone_i and current_grid[x, y, stone_i] > 0:\n      return True\n    return False\n\n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a position and orientation from which the primitive can be collected via USE.\n  # BFS state: ((current_x, current_y), current_direction, [list_of_actions_to_reach_here])\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's initial direction (0-3)\n\n  queue = [(start_pos, start_dir, [])]\n  # Set of visited ((x, y), direction) tuples to prevent cycles and redundant path exploration\n  visited = {(start_pos, start_dir)}\n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.pop(0) # Dequeue for BFS\n\n    # Calculate the coordinates of the cell directly in front of the agent,\n    # which is the target for the USE action.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # Check if the cell in front is within bounds and contains the primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      # Found a path where the agent can move to a position, face the primitive,\n      # and then USE to collect it.\n      return path_actions + [USE_ACTION]\n    \n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # A movement action changes the agent's position and its facing direction.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position is impassable (contains specific obstacles)\n      if _is_cell_impassable(next_x, next_y, primitive_idx, grid, water_idx, stone_idx):\n        continue # Cannot move into this cell\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple) # Mark the new state as visited\n        # Add the new state and its path to the queue for further exploration\n        queue.append((next_state_tuple[0], next_state_tuple[1], path_actions + [move_action]))\n\n  # If the queue becomes empty and no path was found, it means the primitive\n  # is unreachable from the current state.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T08:53:50.068509", "function_name": "collect", "function_body": "    import collections\n\n    # Action definitions (using integers as specified in action_specs)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    MOVE_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]\n    MOVE_DELTAS = {\n        ACTION_DOWN: (0, 1),\n        ACTION_UP: (0, -1),\n        ACTION_LEFT: (-1, 0),\n        ACTION_RIGHT: (1, 0),\n    }\n\n    # Get the current state information from the environment's internal state\n    # This assumes the environment has been properly initialized (e.g., via a `reset` call).\n    current_state = env._current_state\n    if current_state is None:\n        # If no state is set, no actions can be planned.\n        return []\n\n    grid = current_state.grid\n    start_pos = current_state.pos\n    world = current_state.world\n\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n\n    # Step 1: Identify all locations on the grid where the primitive exists.\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] > 0:  # Check if the primitive is present at this cell\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return []  # Primitive not found anywhere on the grid\n\n    # Step 2: Define a helper function to check if a cell is walkable.\n    # Non-grabbable entities are considered obstacles.\n    non_grabbable_indices = world.non_grabbable_indices\n\n    def is_walkable(x, y):\n        \"\"\"Checks if a cell (x, y) is within grid bounds and does not contain an obstacle.\"\"\"\n        if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n            return False\n        # A cell is unwalkable if it contains any non-grabbable entity.\n        for kind_idx in non_grabbable_indices:\n            if grid[x, y, kind_idx] > 0:\n                return False\n        return True\n\n    # Step 3: Determine all possible \"target interaction cells\".\n    # These are any walkable cells within the 3x3 neighborhood of a primitive's location.\n    # The agent can use the 'USE' action from any of these cells to collect the primitive.\n    target_interaction_cells = set()\n    for px, py in primitive_locations:\n        for dx_offset in [-1, 0, 1]:\n            for dy_offset in [-1, 0, 1]:\n                ax, ay = px + dx_offset, py + dy_offset\n                if is_walkable(ax, ay):\n                    target_interaction_cells.add((ax, ay))\n\n    if not target_interaction_cells:\n        # This can happen if all cells around (and including) primitives are unwalkable.\n        return []\n\n    # Step 4: Perform a Breadth-First Search (BFS) to find the shortest path\n    # from the agent's current position to any of the target interaction cells.\n    # The queue stores tuples of (current_x, current_y, list_of_actions_taken_so_far).\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    # The visited set stores (x, y) coordinates to avoid cycles and redundant paths.\n    visited = set([(start_pos[0], start_pos[1])])\n\n    while queue:\n        curr_x, curr_y, path_so_far = queue.popleft()\n\n        # Check if the current position is one of the target interaction cells.\n        # Since BFS explores layer by layer, the first path found to a target cell\n        # is guaranteed to be the shortest path.\n        if (curr_x, curr_y) in target_interaction_cells:\n            # If so, append the 'USE' action to the path and return the complete sequence.\n            return path_so_far + [ACTION_USE]\n\n        # Explore possible next moves (UP, DOWN, LEFT, RIGHT).\n        for action in MOVE_ACTIONS:\n            dx, dy = MOVE_DELTAS[action]\n            next_x, next_y = curr_x + dx, curr_y + dy\n\n            # Check if the next cell is walkable and has not been visited yet.\n            if is_walkable(next_x, next_y) and (next_x, next_y) not in visited:\n                visited.add((next_x, next_y))\n                # Add the next state to the queue with the updated path.\n                queue.append((next_x, next_y, path_so_far + [action]))\n\n    # If the queue becomes empty and no path to a target interaction cell was found,\n    # it means the primitive is unreachable from the current position.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:53:51.037872", "function_name": "collect", "function_body": "  # 1. Check if primitive is already in inventory\n  initial_state = env._current_state\n  if initial_state.inventory[primitive] > 0:\n    return []\n\n  # Define constants for actions and directions.\n  # These would typically be defined globally or imported from env_factory,\n  # but are included here for clarity if the function is self-contained.\n\n  # (dr, dc) deltas for each move action\n  _ACTION_DELTAS = {\n      env_factory.DOWN: (1, 0),\n      env_factory.UP: (-1, 0),\n      env_factory.LEFT: (0, -1),\n      env_factory.RIGHT: (0, 1),\n  }\n\n  # Agent's facing direction after moving\n  # 0: East, 1: West, 2: South, 3: North (from CraftState description)\n  _ACTION_TO_FINAL_DIR = {\n      env_factory.DOWN: 2,  # Moved down, now facing South\n      env_factory.UP: 3,    # Moved up, now facing North\n      env_factory.LEFT: 1,  # Moved left, now facing West\n      env_factory.RIGHT: 0, # Moved right, now facing East\n  }\n\n  # (dr, dc) deltas for each direction\n  # Used to find what's directly in front of the agent based on current direction\n  _DIR_DELTAS = {\n      0: (0, 1),   # East\n      1: (0, -1),  # West\n      2: (1, 0),   # South\n      3: (-1, 0),  # North\n  }\n\n  # 2. Initialize BFS\n  # Queue stores tuples: (current_position, current_direction, list_of_actions_to_reach_here)\n  queue = collections.deque([(initial_state.pos, initial_state.dir, [])])\n  # Visited set stores (position, direction) to avoid cycles and redundant exploration\n  visited = {(initial_state.pos, initial_state.dir)}\n\n  grid = initial_state.grid\n  height, width, _ = grid.shape  # Grid is (Height, Width, Kinds)\n  water_idx = env.world.water_index\n\n  while queue:\n    curr_pos, curr_dir, path = queue.popleft()\n\n    # 3. Check if current state allows immediate collection (i.e., primitive is in front)\n    # Calculate the cell directly in front of the agent\n    front_dr, front_dc = _DIR_DELTAS[curr_dir]\n    front_r, front_c = curr_pos[0] + front_dr, curr_pos[1] + front_dc\n\n    # Check if the front cell is within bounds and contains the primitive\n    if (0 <= front_r < height and 0 <= front_c < width and\n            grid[front_r, front_c, primitive] > 0):\n      # Goal reached: agent is positioned and facing the primitive. Add USE action.\n      return path + [env_factory.USE]\n\n    # 4. Explore next states (movements and turns)\n    # A. Movement actions (change position and facing direction)\n    for action in [env_factory.DOWN, env_factory.UP, env_factory.LEFT, env_factory.RIGHT]:\n      dr, dc = _ACTION_DELTAS[action]\n      next_pos = (curr_pos[0] + dr, curr_pos[1] + dc)\n      next_dir = _ACTION_TO_FINAL_DIR[action]  # Agent faces the direction of its last movement\n\n      # Check bounds for the next position\n      if (0 <= next_pos[0] < height and 0 <= next_pos[1] < width):\n        # Check for obstacles: water is generally not traversable\n        if grid[next_pos[0], next_pos[1], water_idx] > 0:\n          continue  # Cannot move into water\n\n        # If this (position, direction) state has not been visited, add it to queue\n        if (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append((next_pos, next_dir, path + [action]))\n\n    # B. Turning actions (change facing direction, position remains same)\n    # Turning LEFT (counter-clockwise: 0->3->2->1->0)\n    next_dir_left = (curr_dir + 3) % 4\n    if (curr_pos, next_dir_left) not in visited:\n      visited.add((curr_pos, next_dir_left))\n      queue.append((curr_pos, next_dir_left, path + [env_factory.LEFT]))\n\n    # Turning RIGHT (clockwise: 0->1->2->3->0)\n    next_dir_right = (curr_dir + 1) % 4\n    if (curr_pos, next_dir_right) not in visited:\n      visited.add((curr_pos, next_dir_right))\n      queue.append((curr_pos, next_dir_right, path + [env_factory.RIGHT]))\n\n  # 5. If the queue is exhausted and no path to the primitive was found\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:55:40.690039", "function_name": "collect", "function_body": "    import collections\n\n    # Action constants, matching CraftLab.action_specs\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    # Map action to (dr, dc) delta for movement on the grid\n    # This also defines the direction the agent faces after a move action.\n    MOVE_DELTAS = {\n        DOWN: (1, 0),\n        UP: (-1, 0),\n        LEFT: (0, -1),\n        RIGHT: (0, 1)\n    }\n\n    # Get current state information from the CraftLab environment\n    current_state = env._current_state\n    current_inventory = current_state.inventory\n    current_pos = current_state.pos\n    current_dir = current_state.dir # Agent's current facing direction (int)\n    grid = current_state.grid       # The current grid layout (numpy.ndarray)\n\n    # Get world constants from the CraftWorld instance\n    WIDTH, HEIGHT, _ = grid.shape # Dimensions of the grid\n    world = current_state.world\n    non_grabbable_indices = world.non_grabbable_indices # Indices of entities that block movement\n\n    # 1. Check if the primitive is already in the inventory\n    if current_inventory[primitive] > 0:\n        return []\n\n    # 2. Perform a Breadth-First Search (BFS) to find the shortest path\n    #    to a state where the agent can successfully 'USE' the primitive.\n    # BFS state: ((row, col), direction, [actions_taken_so_far])\n    q = collections.deque([(current_pos, current_dir, [])])\n\n    # Visited set: {(row, col, direction)} to avoid redundant explorations and infinite loops\n    visited = {(current_pos[0], current_pos[1], current_dir)}\n\n    while q:\n        (r, c), d, path = q.popleft()\n\n        # Check if, from this current (position, direction) state, we can USE the primitive\n        # The cell directly in front of the agent\n        dr_face, dc_face = MOVE_DELTAS[d]\n        target_cell_r, target_cell_c = r + dr_face, c + dc_face\n\n        # Check if the target cell is within grid boundaries\n        if 0 <= target_cell_r < WIDTH and 0 <= target_cell_c < HEIGHT:\n            # Check if the primitive is located in the cell in front of the agent\n            if grid[target_cell_r, target_cell_c, primitive] > 0:\n                # We've found a path to a state where the primitive can be collected!\n                return path + [USE] # Append the USE action and return the complete action sequence\n\n        # Explore neighbors by moving to adjacent cells\n        for action, (dr_move, dc_move) in MOVE_DELTAS.items():\n            next_r, next_c = r + dr_move, c + dc_move\n            next_d = action # Agent's new direction will be the direction of the move action\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n                continue\n\n            # Check if this (position, direction) state has already been visited\n            if (next_r, next_c, next_d) in visited:\n                continue\n\n            # Check if the next position is an obstacle (not walkable)\n            # A cell is considered an obstacle if it contains any non-grabbable item.\n            is_obstacle = False\n            for kind_idx in non_grabbable_indices:\n                if grid[next_r, next_c, kind_idx] > 0:\n                    is_obstacle = True\n                    break\n            \n            # Also, ensure the agent does not try to move onto the primitive itself,\n            # as `USE` requires being adjacent, not on top.\n            if grid[next_r, next_c, primitive] > 0:\n                is_obstacle = True\n\n            if not is_obstacle:\n                visited.add((next_r, next_c, next_d))\n                q.append(((next_r, next_c), next_d, path + [action]))\n\n    # If the BFS completes and no path to collect the primitive is found\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:55:41.664307", "function_name": "collect", "function_body": "  import collections\n\n  _DOWN, _UP, _LEFT, _RIGHT, _USE = 0, 1, 2, 3, 4\n\n  state = env._current_state\n  world = state.world\n  current_pos = state.pos\n  grid = state.grid\n  grid_h, grid_w, _ = grid.shape\n\n  # 1. Check if the primitive is already in inventory\n  if state.inventory[primitive] > 0:\n    return []\n\n  # 2. Check if the primitive is already in the agent's 3x3 neighborhood\n  # If so, just use it.\n  if state.next_to(primitive):\n    return [_USE]\n\n  # 3. Find the closest instance of the primitive on the grid\n  target_primitive_loc = None\n  min_dist = float('inf')\n  for r_item in range(grid_h):\n    for c_item in range(grid_w):\n      if grid[r_item, c_item, primitive] > 0:\n        dist = abs(r_item - current_pos[0]) + abs(c_item - current_pos[1])\n        if dist < min_dist:\n          min_dist = dist\n          target_primitive_loc = (r_item, c_item)\n\n  if target_primitive_loc is None:\n    # Primitive not found on the grid, cannot collect.\n    return []\n\n  # Define a helper function to check if a cell is walkable\n  # A cell is walkable if it's within bounds and does not contain any non-grabbable item.\n  def _is_walkable_cell(r, c):\n    if not (0 <= r < grid_h and 0 <= c < grid_w):\n      return False\n    for k_idx in world.non_grabbable_indices:\n      if grid[r, c, k_idx] > 0:\n        return False # Cell contains a non-grabbable item, so agent cannot move into it.\n    return True # Cell is either empty or contains only grabbable items, so it's walkable.\n\n  # 4. Perform BFS to find the shortest path to a cell from which the primitive can be collected\n  # The goal is to reach any cell (r, c) that is within the 3x3 neighborhood of target_primitive_loc.\n  q = collections.deque([(current_pos, [])]) # Queue stores (current_position, list_of_actions_to_reach_here)\n  visited = {current_pos} # Set of visited positions\n\n  # Mapping from (dr, dc) (relative move) to action\n  MOVE_MAPPING = {\n      (-1, 0): _UP,    # Move North\n      (1, 0): _DOWN,   # Move South\n      (0, -1): _LEFT,  # Move West\n      (0, 1): _RIGHT,  # Move East\n  }\n\n  path_actions = [] # Stores the final sequence of actions\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # Check if the current position (r,c) is within the 3x3 neighborhood of the target primitive\n    if abs(r - target_primitive_loc[0]) <= 1 and abs(c - target_primitive_loc[1]) <= 1:\n      # Agent is in a position where it can interact with the primitive (within 3x3).\n      # Add the USE action as the final step and break.\n      path_actions = current_path + [_USE]\n      break\n\n    # Explore neighbors for movement\n    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # N, S, W, E relative moves\n      next_r, next_c = r + dr, c + dc\n      next_pos = (next_r, next_c)\n\n      if _is_walkable_cell(next_r, next_c) and next_pos not in visited:\n        visited.add(next_pos)\n        action_to_take = MOVE_MAPPING.get((dr, dc))\n        q.append((next_pos, current_path + [action_to_take]))\n  \n  return path_actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:56:59.993103", "function_name": "collect", "function_body": "  state = env._current_state\n  current_pos = state.pos\n  current_grid = state.grid\n  inventory = state.inventory\n  \n  # Check if primitive is already in inventory\n  if inventory[primitive] > 0:\n      return []\n\n  WIDTH, HEIGHT, _ = current_grid.shape\n  # `env.world` is a CraftWorld instance, which has `non_grabbable_indices`.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  \n  ACTION_MAP = env.action_specs()\n  \n  # Directions mapping to (dx, dy) and action\n  # Assuming (x, y) coordinates where x is horizontal, y is vertical.\n  # UP: (x, y+1)\n  # DOWN: (x, y-1)\n  # LEFT: (x-1, y)\n  # RIGHT: (x+1, y)\n  MOVES = {\n      (0, 1): ACTION_MAP['UP'],\n      (0, -1): ACTION_MAP['DOWN'],\n      (-1, 0): ACTION_MAP['LEFT'],\n      (1, 0): ACTION_MAP['RIGHT'],\n  }\n\n  # BFS for pathfinding\n  # Queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  queue = collections.deque([(current_pos, [])]) \n  # Set of visited (x, y) positions to avoid cycles and redundant paths\n  visited = {current_pos}\n\n  target_action_pos = None # The position from which to perform the USE action\n  path_to_target_action_pos = []\n\n  while queue:\n      (cx, cy), current_path = queue.popleft()\n\n      # Check if any cell in the 3x3 neighborhood around (cx,cy) contains the primitive.\n      # This simulates `state.next_to(primitive)` for position `(cx,cy)`.\n      found_primitive_nearby = False\n      for dx_check in [-1, 0, 1]:\n          for dy_check in [-1, 0, 1]:\n              px, py = cx + dx_check, cy + dy_check\n              \n              # Check bounds for the potential primitive location\n              if not (0 <= px < WIDTH and 0 <= py < HEIGHT):\n                  continue\n              \n              # If the primitive is found at (px, py) within the 3x3 neighborhood\n              if current_grid[px, py, primitive] == 1:\n                  found_primitive_nearby = True\n                  break\n          if found_primitive_nearby:\n              break\n\n      # If a primitive is found nearby, (cx,cy) is a suitable position to `USE`\n      if found_primitive_nearby:\n          target_action_pos = (cx, cy)\n          path_to_target_action_pos = current_path\n          break # Path found to a suitable action position, exit BFS\n\n      # Explore neighbors\n      for (dx, dy), action_val in MOVES.items():\n          nx, ny = cx + dx, cy + dy\n\n          # Check boundaries for the next agent position\n          if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n              continue\n\n          # Check if this position has already been visited\n          if (nx, ny) in visited:\n              continue\n\n          # Check if the next cell (nx, ny) is an obstacle (contains any non-grabbable item)\n          is_obstacle = False\n          for k_obstacle in non_grabbable_indices:\n              if current_grid[nx, ny, k_obstacle] == 1:\n                  is_obstacle = True\n                  break\n          \n          # If it's an obstacle, the agent cannot move onto this cell\n          if is_obstacle:\n              continue\n          \n          # Valid move: add to queue and mark as visited\n          visited.add((nx, ny))\n          queue.append(((nx, ny), current_path + [action_val]))\n\n  # If no path to a suitable action position was found after exhausting BFS\n  if not target_action_pos:\n      return []\n\n  # Construct the final list of actions: path to `target_action_pos` followed by `USE` action\n  final_actions = list(path_to_target_action_pos) # Create a copy of the path\n  final_actions.append(ACTION_MAP['USE']) # Append the USE action\n\n  return final_actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:57:00.979973", "function_name": "collect", "function_body": "  import collections\n\n  # Assume ACTIONS struct is available in this scope, e.g., from a shared constants module\n  # For reference, ACTIONS are: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Initial check: If the primitive is already in inventory, no actions are needed.\n  current_obs = env.observations()\n  initial_inventory = current_obs['features_dict']['inventory']\n  if initial_inventory[primitive] > 0:\n      return []\n\n  # Initialize BFS queue with the current state and an empty action path.\n  # Queue elements: (CraftState_instance, list_of_actions_taken_to_reach_this_state)\n  q = collections.deque()\n  initial_craft_state = env._current_state # Access the current internal CraftState instance\n  q.append((initial_craft_state, []))\n\n  # Visited set to prevent cycles and redundant exploration.\n  # Stores (agent_position_tuple, agent_direction_int)\n  # This assumes the primitive's location on the grid is static and unaffected by agent movement.\n  visited = set()\n  visited.add((initial_craft_state.pos, initial_craft_state.dir))\n\n  max_depth = 50 # Limit the search depth to prevent excessively long paths or infinite loops\n\n  while q:\n      current_craft_state, actions_path = q.popleft()\n\n      # Prune branches that exceed the maximum allowed depth\n      if len(actions_path) > max_depth:\n          continue\n\n      # Try applying the 'USE' action from the current state.\n      # CraftState.step returns a new state, it does not modify `current_craft_state` in place.\n      reward_use, next_state_after_use = current_craft_state.step(ACTION_USE)\n\n      # Check if the primitive was successfully collected (inventory increased)\n      if next_state_after_use.inventory[primitive] > current_craft_state.inventory[primitive]:\n          return actions_path + [ACTION_USE] # Path found!\n\n      # Explore movement actions (UP, DOWN, LEFT, RIGHT)\n      for action_val in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n          reward, next_craft_state = current_craft_state.step(action_val)\n\n          # Create a hashable key for the visited set\n          next_state_key = (next_craft_state.pos, next_craft_state.dir)\n\n          # If this state (position and direction) has not been visited before, add it to the queue\n          if next_state_key not in visited:\n              visited.add(next_state_key)\n              q.append((next_craft_state, actions_path + [action_val]))\n\n  # If the BFS completes and no path to collect the primitive is found within max_depth\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:58:19.517153", "function_name": "collect", "function_body": "    actions = []\n\n    # Constants for action mapping\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Map (dr, dc) to action IDs for movement\n    ACTION_DELTAS = {\n        ACTION_UP: (-1, 0),\n        ACTION_DOWN: (1, 0),\n        ACTION_LEFT: (0, -1),\n        ACTION_RIGHT: (0, 1),\n    }\n\n    # Helper function to check if a position is within grid boundaries\n    def is_valid_pos(r, c, grid_height, grid_width):\n        return 0 <= r < grid_height and 0 <= c < grid_width\n\n    # Helper function to check if a cell is walkable (not occupied by non-grabbable items)\n    def is_walkable(grid_cell_content, non_grabbable_indices):\n        # A cell is walkable if it doesn't contain any non-grabbable items\n        # grid_cell_content is a 1D numpy array representing counts of each kind at (r,c)\n        return not any(grid_cell_content[idx] > 0 for idx in non_grabbable_indices)\n\n    # Access the current state from the environment\n    # CraftLab._current_state provides the CraftState object\n    current_state = env._current_state\n\n    # 1. Check if the primitive is already in the inventory\n    if current_state.inventory[primitive] > 0:\n        return actions # Already collected, no actions needed\n\n    grid = current_state.grid\n    current_pos = current_state.pos # Agent's current (row, col) position\n    grid_height, grid_width, _ = grid.shape\n\n    # Get non-grabbable indices from the CraftWorld instance\n    # These indices represent items that block movement\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # 2. Find all locations of the primitive in the grid\n    # np.argwhere returns a list of (row, col) tuples where grid[:,:,primitive] is > 0\n    primitive_locations = np.argwhere(grid[:, :, primitive] > 0).tolist()\n\n    if not primitive_locations:\n        # Primitive not found anywhere in the current grid\n        return actions\n\n    # 3. Use Breadth-First Search (BFS) to find the shortest path\n    # to any cell adjacent to any instance of the primitive.\n    # Queue stores tuples: ((row, col), [list_of_actions_to_reach_this_pos])\n    q = collections.deque([(current_pos, [])])\n    # Visited set stores (row, col) tuples to avoid redundant exploration\n    visited = {current_pos}\n\n    target_adjacent_pos = None # Stores the (r,c) of the closest cell adjacent to a primitive\n    best_path_actions = [] # Stores the actions to reach target_adjacent_pos\n\n    while q:\n        (r, c), path_so_far = q.popleft()\n\n        # Check if the current position (r, c) is adjacent to any primitive location\n        for pr, pc in primitive_locations:\n            # Manhattan distance of 1 means adjacent\n            if abs(r - pr) + abs(c - pc) == 1:\n                target_adjacent_pos = (r, c)\n                best_path_actions = path_so_far\n                # Found the closest path, clear the queue to terminate BFS\n                q.clear()\n                break\n        if target_adjacent_pos:\n            break # Exit the outer while loop as well\n\n        # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n        for action_id, (dr, dc) in ACTION_DELTAS.items():\n            nr, nc = r + dr, c + dc # New potential position\n            new_pos = (nr, nc)\n\n            if is_valid_pos(nr, nc, grid_height, grid_width) and new_pos not in visited:\n                # Check if the new cell is walkable before adding to queue\n                if is_walkable(grid[nr, nc], non_grabbable_indices):\n                    visited.add(new_pos)\n                    q.append((new_pos, path_so_far + [action_id]))\n\n    if not target_adjacent_pos:\n        # No path found to any cell adjacent to the primitive\n        return actions\n\n    # 4. Add the movement actions to reach the adjacent cell\n    actions.extend(best_path_actions)\n\n    # 5. Add the USE action to pick up the primitive\n    actions.append(ACTION_USE)\n\n    return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:58:20.486524", "function_name": "collect", "function_body": "  from collections import deque\n\n  state = env._current_state\n  grid = state.grid\n  initial_pos = state.pos\n  initial_dir = state.dir\n  inventory = state.inventory\n  world = env.world\n  \n  # Action constants (assuming they are defined globally or via env_factory)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction mappings for agent's facing direction (0:N, 1:E, 2:S, 3:W)\n  # When agent moves, its direction changes to face the direction of movement.\n  ACTION_TO_FINAL_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3,\n  }\n\n  # Deltas for `USE` action based on agent's current facing direction\n  USE_DR_BY_DIR = [-1, 0, 1, 0] # N, E, S, W\n  USE_DC_BY_DIR = [0, 1, 0, -1] # N, E, S, W\n\n  # Check if primitive is already collected\n  if inventory[primitive] > 0:\n      return []\n\n  HEIGHT, WIDTH, _ = grid.shape # grid is (height, width, n_kinds)\n\n  # BFS for pathfinding\n  # State in queue: (row, col, direction, path_list)\n  queue = deque([(initial_pos[0], initial_pos[1], initial_dir, [])])\n  # Visited set: (row, col, direction) to avoid cycles\n  visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n  MAX_BFS_STEPS = 200 # Limit search depth to prevent excessive computation\n\n  while queue and len(queue[0][3]) < MAX_BFS_STEPS:\n      r, c, d, path = queue.popleft()\n\n      # 1. Check if the primitive can be collected from the current (r, c, d)\n      # The `USE` action affects the cell directly in front of the agent.\n      target_r = r + USE_DR_BY_DIR[d]\n      target_c = c + USE_DC_BY_DIR[d]\n\n      if 0 <= target_r < HEIGHT and 0 <= target_c < WIDTH:\n          # If the cell in front contains the primitive, we can try to USE it.\n          if grid[target_r, target_c, primitive] > 0:\n              # Found a path to be next to the primitive and facing it.\n              return path + [ACTION_USE]\n\n      # 2. Explore possible next states (movement actions)\n      for action in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n          # Determine new position based on action\n          dr_move, dc_move = 0, 0\n          if action == ACTION_UP:\n              dr_move = -1\n          elif action == ACTION_DOWN:\n              dr_move = 1\n          elif action == ACTION_LEFT:\n              dc_move = -1\n          elif action == ACTION_RIGHT:\n              dc_move = 1\n          \n          nr, nc = r + dr_move, c + dc_move\n          new_dir = ACTION_TO_FINAL_DIR[action] # Agent's direction changes to face movement\n\n          # Check boundaries\n          if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n              continue\n\n          # Check if the next cell is blocked by an obstacle\n          is_blocked = False\n          # If the cell is not an empty/floor cell (assuming kind 0 is floor)\n          if grid[nr, nc, 0] == 0: \n              is_blocked = True\n          else: \n              # If it's a floor cell, check for specific blocking objects\n              for kind_idx in world.non_grabbable_indices:\n                  # If the cell contains a non-grabbable item:\n                  if grid[nr, nc, kind_idx] > 0:\n                      if kind_idx == primitive:\n                          # If the cell contains the target primitive AND the primitive is non-grabbable,\n                          # then the agent cannot walk ONTO it. It's an obstacle for movement.\n                          is_blocked = True\n                          break\n                      else:\n                          # If it contains another non-grabbable item (not the primitive), it's also an obstacle.\n                          is_blocked = True\n                          break\n\n          if not is_blocked:\n              new_state_key = (nr, nc, new_dir)\n              if new_state_key not in visited:\n                  visited.add(new_state_key)\n                  queue.append((nr, nc, new_dir, path + [action]))\n\n  # If BFS completes without finding a path to collect the primitive\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T08:59:25.896047", "function_name": "collect", "function_body": "  import collections\n\n  # --- Action Constants ---\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement action to the direction the agent faces after the move.\n  # Directions are typically: 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n  ACTION_TO_FACING_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Mapping of facing direction to (dx, dy) vector for position change.\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y\n      1: (1, 0),   # RIGHT: increases x\n      2: (0, 1),   # DOWN: increases y\n      3: (-1, 0)   # LEFT: decreases x\n  }\n\n  # --- Pre-checks and Initial State Extraction ---\n  # If the primitive is not a grabbable item, it cannot be \"collected\" via ACTION_USE.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state details from the environment.\n  initial_state = env._current_state\n  start_pos_x, start_pos_y = initial_state.pos\n  start_agent_dir = initial_state.dir # Agent's initial facing direction\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n  non_grabbable_entity_indices = env.world.non_grabbable_indices\n\n  # --- Helper Functions for BFS ---\n\n  def _is_walkable(x, y):\n    \"\"\"\n    Checks if a given grid cell (x, y) is within bounds and not occupied by\n    any entity defined as a non-grabbable obstacle.\n    \"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False  # Out of bounds\n    \n    # Check if the cell contains any non-grabbable item that acts as an obstacle.\n    for k_idx in non_grabbable_entity_indices:\n      if grid[x, y, k_idx] == 1:\n        return False # Cell is blocked by an obstacle.\n    return True\n\n  def _is_primitive_adjacent(px, py, target_primitive_idx):\n    \"\"\"\n    Checks if the target primitive is present in any cell within the\n    3x3 neighborhood around position (px, py), excluding the center cell itself.\n    This aligns with the behavior of CraftState.next_to for 'USE' actions.\n    \"\"\"\n    for dx_adj in [-1, 0, 1]:\n      for dy_adj in [-1, 0, 1]:\n        # Skip the agent's own cell; collection is assumed to be from an adjacent cell.\n        if dx_adj == 0 and dy_adj == 0:\n          continue\n\n        adj_x, adj_y = px + dx_adj, py + dy_adj\n        if (0 <= adj_x < grid_width and 0 <= adj_y < grid_height and\n            grid[adj_x, adj_y, target_primitive_idx] == 1):\n          return True # Primitive found in an adjacent cell.\n    return False\n\n  # --- Breadth-First Search (BFS) for Shortest Path ---\n  # The BFS queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken).\n  # `current_direction` is essential as agent movement actions change its facing direction,\n  # which can affect subsequent actions or path validity (even if 'USE' itself is direction-agnostic).\n  bfs_queue = collections.deque([(start_pos_x, start_pos_y, start_agent_dir, [])])\n\n  # The `visited_states` set keeps track of (x, y, direction) tuples to prevent redundant\n  # exploration and infinite loops, ensuring the shortest path is found.\n  visited_states = set([(start_pos_x, start_pos_y, start_agent_dir)])\n\n  while bfs_queue:\n    curr_x, curr_y, curr_dir, path_taken = bfs_queue.popleft()\n\n    # Goal check: If the current position is adjacent to the primitive, we can collect it.\n    if _is_primitive_adjacent(curr_x, curr_y, primitive):\n      return path_taken + [ACTION_USE]\n\n    # Explore possible movement actions (UP, RIGHT, DOWN, LEFT) from the current state.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the next position and the agent's new facing direction after this action.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_FACING_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_agent_dir = ACTION_TO_FACING_DIR[action] # Agent faces the direction of its last move.\n\n      # If the next cell is walkable and this specific (position, direction) state\n      # has not been visited yet, add it to the queue for exploration.\n      if _is_walkable(next_x, next_y) and (next_x, next_y, next_agent_dir) not in visited_states:\n        visited_states.add((next_x, next_y, next_agent_dir))\n        bfs_queue.append((next_x, next_y, next_agent_dir, path_taken + [action]))\n\n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T08:59:26.880418", "function_name": "collect", "function_body": "  import collections\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  # This mapping is used to determine the agent's facing direction after a movement action.\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position)\n  # This is used to calculate the cell in front of the agent.\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y\n      1: (1, 0),   # RIGHT: increases x\n      2: (0, 1),   # DOWN: increases y\n      3: (-1, 0)   # LEFT: decreases x\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Helper function to check if a grid cell is within bounds and not an obstacle.\n  # Obstacles are defined by non_grabbable_indices.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # Check if the cell is occupied by any non-grabbable item.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # Breadth-First Search (BFS) for shortest path\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n  # `current_direction`: The direction the agent is facing *after* arriving at (current_x, current_y)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to avoid redundant exploration and cycles.\n  # A state is defined by (x, y, direction) because the agent's direction matters\n  # for movement (e.g., turning into an obstacle) and crucially, for the 'USE' action.\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the primitive is in the cell directly in front of the agent.\n    # This assumes the 'USE' action interacts with the cell the agent is facing.\n    target_dx, target_dy = DIR_VEC[curr_dir]\n    target_px, target_py = curr_x + target_dx, curr_y + target_dy\n\n    # Ensure the target cell is within grid bounds before checking its content.\n    if (0 <= target_px < grid_width and 0 <= target_py < grid_height and\n        grid[target_px, target_py, primitive] == 1):\n      # Found the primitive in front of the agent! Append ACTION_USE and return the path.\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next movement actions (UP, RIGHT, DOWN, LEFT)\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Determine the new position and direction after this action\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]] # Movement vector based on action direction\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # Agent's new facing direction after moving\n\n      # If the next cell is walkable and this (position, direction) state hasn't been visited\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T09:00:32.979085", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  # Current position might be float, convert to int tuple for grid indexing.\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  world = env.world\n  # non_grabbable_indices typically include obstacles like water, stone walls, workshops.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape\n\n  # Action constants (from problem description context)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVES = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # 3x3 neighborhood deltas including the center (0,0)\n  NEIGHBORHOOD_DELTAS = [\n      (dx, dy) for dx in [-1, 0, 1] for dy in [-1, 0, 1]\n  ]\n\n  # 1. Determine traversable cells using NumPy for efficiency.\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  is_obstacle_kind = np.isin(np.arange(K), list(non_grabbable_indices))\n  has_obstacle = (grid[:, :, is_obstacle_kind] > 0).any(axis=-1)\n  traversable_mask = ~has_obstacle\n  \n  # Ensure the agent's current position is traversable.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] # Agent starts on an untraversable cell, no path possible.\n\n  # 2. Identify all potential target positions for the agent.\n  # These are traversable cells from which the primitive can be collected via the USE action.\n  # We assume USE acts on any primitive within the agent's 3x3 neighborhood (including current cell).\n  target_agent_positions = set()\n  primitive_locations = set()\n\n  # First, find all locations on the grid where the target primitive exists.\n  # This can be more efficiently done using np.where if grid is boolean or 0/1.\n  # Given it's counts, iterating is clear.\n  for x in range(W):\n      for y in range(H):\n          if grid[x, y, primitive] > 0:\n              primitive_locations.add((x, y))\n\n  # Then, for each primitive location, find all valid traversable cells in its 3x3 neighborhood.\n  # These are the cells where the agent can stand to \"collect\" the primitive.\n  for px, py in primitive_locations:\n      for dx, dy in NEIGHBORHOOD_DELTAS:\n          nx, ny = px + dx, py + dy\n          # Check bounds and traversability for the potential agent position\n          if (0 <= nx < W and 0 <= ny < H and traversable_mask[nx, ny]):\n              target_agent_positions.add((nx, ny))\n\n  # If there are no primitive locations or no reachable positions around them, return empty.\n  if not target_agent_positions:\n      return []\n\n  # 3. Handle the case where the agent is already at a target position.\n  # If the agent is already at a suitable position to collect the primitive, just USE.\n  if current_pos in target_agent_positions:\n      return [USE]\n\n  # 4. Perform Breadth-First Search (BFS) to find the shortest path to any target_agent_position.\n  from collections import deque\n  q = deque([(current_pos, [])]) # Queue stores (current_position, list_of_actions_to_reach_here)\n  visited = {current_pos} # Set of visited positions to avoid cycles and redundant processing\n  \n  path_to_target = []\n\n  while q:\n      (curr_x, curr_y), actions_so_far = q.popleft()\n\n      # If the current position is one of our identified target positions, we've found a path.\n      if (curr_x, curr_y) in target_agent_positions:\n          path_to_target = actions_so_far\n          break # Found the shortest path, exit BFS\n\n      # Explore neighbors (4-directional movement)\n      for action, (dx, dy) in MOVES.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # Check if the next position is within grid bounds, traversable, and not yet visited.\n          if (0 <= next_x < W and 0 <= next_y < H and\n              traversable_mask[next_x, next_y] and\n              next_pos not in visited):\n              \n              visited.add(next_pos)\n              q.append((next_pos, actions_so_far + [action])) # Add to queue with updated path\n  \n  # 5. If no path was found to any target position, return an empty list.\n  if not path_to_target:\n      return [] \n  \n  # 6. Append the USE action after the movement path.\n  actions.extend(path_to_target)\n  actions.append(USE)\n  \n  return actions", "island_id": 9, "scores": {"3": 0.0}}
