{"timestamp": "2025-07-30T22:39:02.013284", "function_name": "collect", "function_body": "    # Define action constants based on CraftLab.action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Define direction constants (assuming 0:N, 1:E, 2:S, 3:W)\n    DIR_N = 0\n    DIR_E = 1\n    DIR_S = 2\n    DIR_W = 3\n\n    # Map movement actions to their (delta_row, delta_col) effect and the resulting agent facing direction\n    # e.g., ACTION_DOWN (0) moves agent one cell down (+1 row) and makes agent face South (DIR_S)\n    ACTION_TO_MOVE_EFFECT = {\n        ACTION_DOWN: (1, 0, DIR_S),   # (dr, dc, new_facing_dir)\n        ACTION_UP: (-1, 0, DIR_N),\n        ACTION_LEFT: (0, -1, DIR_W),\n        ACTION_RIGHT: (0, 1, DIR_E),\n    }\n\n    # Map (delta_row, delta_col) from agent to target item to the required facing direction\n    # e.g., if target is 1 row up (-1,0) from agent, agent must face North (DIR_N)\n    DELTA_TO_REQUIRED_DIR = {\n        (-1, 0): DIR_N,  # Target is North\n        (1, 0): DIR_S,   # Target is South\n        (0, -1): DIR_W,  # Target is West\n        (0, 1): DIR_E    # Target is East\n    }\n\n    # Get current state observations from the environment\n    obs = env.observations()\n    state_dict = obs['features_dict']\n\n    current_pos = tuple(state_dict['pos'])  # Agent's current (row, col)\n    current_grid = state_dict['features_global'] # Full grid\n    inventory = state_dict['inventory'] # Agent's inventory\n    # Agent's current direction (one-hot array [N, E, S, W] needs conversion to int)\n    current_dir_one_hot = state_dict['direction']\n    current_dir = np.argmax(current_dir_one_hot)\n\n    # If the primitive is already in the inventory, no actions needed\n    if inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions (rows, cols)\n    WIDTH, HEIGHT, _ = current_grid.shape\n\n    # Get obstacle indices from the world configuration (accessible via env.world)\n    world = env.world\n    water_idx = world.water_index\n    stone_idx = world.stone_index\n    # Assuming water and stone are the primary blocking terrains.\n    # Other non_grabbable items might or might not be obstacles. For this problem,\n    # we'll consider only water and stone as impassable.\n    \n    # Find all locations where the primitive exists on the grid\n    target_primitive_locations = []\n    for r in range(WIDTH):\n        for c in range(HEIGHT):\n            if current_grid[r, c, primitive] > 0:\n                target_primitive_locations.append((r, c))\n\n    # If the primitive is not found on the map, it's unreachable\n    if not target_primitive_locations:\n        return []\n\n    # BFS for pathfinding\n    # State in BFS: (row, col, current_facing_direction_after_last_move)\n    # Queue stores tuples of ((r, c, d), [list_of_actions_to_reach_this_state])\n    q = collections.deque([((current_pos[0], current_pos[1], current_dir), [])])\n    visited = set([(current_pos[0], current_pos[1], current_dir)])\n\n    while q:\n        (r, c, d), path_so_far = q.popleft()\n\n        # Check if the current position (r, c) is adjacent to any target primitive\n        # AND if the agent is facing that primitive correctly.\n        for tr, tc in target_primitive_locations:\n            dr_target = tr - r  # Delta row from agent to target\n            dc_target = tc - c  # Delta col from agent to target\n\n            # Check if (r, c) is directly adjacent to (tr, tc) (Manhattan distance of 1)\n            if abs(dr_target) + abs(dc_target) == 1:\n                # Determine the direction the agent needs to face to look at the target\n                required_dir = DELTA_TO_REQUIRED_DIR.get((dr_target, dc_target))\n                \n                # If required_dir is found and matches agent's current facing direction\n                if required_dir is not None and d == required_dir:\n                    # We found a path to an adjacent cell, facing the target primitive.\n                    # Append the USE action and return the complete action list.\n                    return path_so_far + [ACTION_USE]\n\n        # Explore possible next movement actions\n        for action, (dr_move, dc_move, new_facing_dir) in ACTION_TO_MOVE_EFFECT.items():\n            nr, nc = r + dr_move, c + dc_move  # Calculate new position\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n                continue\n\n            # Check if the new position is walkable (not water or stone)\n            # Assumption: Water and stone are obstacles. Other non-grabbable items are not obstacles.\n            if current_grid[nr, nc, water_idx] > 0 or current_grid[nr, nc, stone_idx] > 0:\n                continue\n            \n            next_state_tuple = (nr, nc, new_facing_dir)\n            \n            # If this state (position and direction) has not been visited yet\n            if next_state_tuple not in visited:\n                visited.add(next_state_tuple)\n                # Add the new state to the queue with the updated path\n                q.append((next_state_tuple, path_so_far + [action]))\n\n    # If the BFS completes without finding a path to collect the primitive\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T22:40:09.705925", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0  # Agent facing UP (negative Y)\n  EAST_DIR = 1   # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2  # Agent facing DOWN (positive Y)\n  WEST_DIR = 3   # Agent facing LEFT (negative X)\n\n  # Mapping from direction to the corresponding movement delta (dx, dy)\n  # and the action required to move forward in that direction.\n  DIRECTION_TO_DELTA_AND_ACTION = {\n      NORTH_DIR: {'delta': (0, -1), 'action': UP_ACTION},\n      EAST_DIR: {'delta': (1, 0), 'action': RIGHT_ACTION},\n      SOUTH_DIR: {'delta': (0, 1), 'action': DOWN_ACTION},\n      WEST_DIR: {'delta': (-1, 0), 'action': LEFT_ACTION},\n  }\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  current_state = env._current_state\n\n  # Optimization: If the primitive is already in inventory, no actions needed.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_walkable(x, y):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-grabbable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    for kind_idx in non_grabbable_indices:\n      if grid[y, x, kind_idx] > 0:\n        return False\n    return True\n\n  def get_coords_in_front(x, y, direction):\n    \"\"\"Returns the coordinates (tx, ty) of the cell directly in front of (x,y) when facing 'direction'.\"\"\"\n    delta = DIRECTION_TO_DELTA_AND_ACTION[direction]['delta']\n    return x + delta[0], y + delta[1]\n\n  # BFS setup\n  # Queue stores (x, y, dir), representing agent's position and its facing direction.\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n\n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing.\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n\n  # Parent map to reconstruct the path: {child_state: (parent_state, action_to_child)}.\n  parent_map = {}\n\n  found_goal_state = None  # Stores the (x, y, dir) of the goal state once found.\n\n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n    current_state_tuple = (curr_x, curr_y, curr_dir)\n\n    # --- Goal Check ---\n    # Check if the primitive is directly in front of the current agent state (position and direction).\n    item_x_in_front, item_y_in_front = get_coords_in_front(curr_x, curr_y, curr_dir)\n\n    # Ensure the target cell is within grid bounds before checking its contents.\n    if (0 <= item_x_in_front < grid_width and 0 <= item_y_in_front < grid_height):\n      if grid[item_y_in_front, item_x_in_front, primitive_id] == 1:\n        found_goal_state = current_state_tuple\n        break  # Found the shortest path to a state from which 'USE' can collect the primitive.\n\n    # --- Explore Neighbors ---\n\n    # 1. Movement Action (Move Forward)\n    move_dx, move_dy = DIRECTION_TO_DELTA_AND_ACTION[curr_dir]['delta']\n    move_action = DIRECTION_TO_DELTA_AND_ACTION[curr_dir]['action']\n\n    next_x_move, next_y_move = curr_x + move_dx, curr_y + move_dy\n    next_dir_move = curr_dir  # Direction remains the same after moving forward.\n    next_state_move = (next_x_move, next_y_move, next_dir_move)\n\n    if is_walkable(next_x_move, next_y_move) and next_state_move not in visited:\n      visited.add(next_state_move)\n      parent_map[next_state_move] = (current_state_tuple, move_action)\n      queue.append(next_state_move)\n\n    # 2. Turning Actions (Turn Left, Turn Right)\n    # These actions change direction but not position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      if turn_action == LEFT_ACTION:\n        next_dir_turn = (curr_dir - 1 + 4) % 4  # Turn counter-clockwise\n      else:  # RIGHT_ACTION\n        next_dir_turn = (curr_dir + 1) % 4      # Turn clockwise\n\n      next_state_turn = (curr_x, curr_y, next_dir_turn)  # Position remains the same\n\n      if next_state_turn not in visited:\n        visited.add(next_state_turn)\n        parent_map[next_state_turn] = (current_state_tuple, turn_action)\n        queue.append(next_state_turn)\n\n  if found_goal_state is None:\n    return []  # No path found to any state from which the primitive can be collected.\n\n  # Reconstruct the path by backtracking from the found goal state to the initial state.\n  actions = []\n  curr_path_state = found_goal_state\n  initial_state_tuple = (initial_agent_x, initial_agent_y, initial_agent_dir)\n\n  while curr_path_state != initial_state_tuple:\n    # Get the parent state and the action that led to curr_path_state\n    parent_state, action = parent_map[curr_path_state]\n    actions.insert(0, action)  # Prepend action to build the path in the correct chronological order.\n    curr_path_state = parent_state\n\n  # Finally, append the USE action after reaching the correct position and facing direction.\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
