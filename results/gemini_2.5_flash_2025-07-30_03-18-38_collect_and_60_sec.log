{"timestamp": "2025-07-31T02:13:10.205627", "function_name": "collect", "function_body": "    \"\"\"\n    Finds a sequence of actions to move the agent to a position from which it can\n    collect the specified primitive item.\n    Assumes the primitive is a static object in the environment grid.\n\n    This version improves readability and organization of constants compared to v1.\n\n    Args:\n        env: An instance of CraftLab, representing the current environment state.\n        primitive: The integer index (ID) of the primitive item to collect.\n\n    Returns:\n        A list of integer action IDs (0-4) representing the shortest path\n        to collect the primitive, including the final USE action.\n        Returns an empty list if the primitive is unreachable.\n    \"\"\"\n    import collections\n    import numpy as np\n\n    # Action constants, mapping action names to their integer IDs.\n    # These match the values defined in CraftLab.action_specs().\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Agent internal direction IDs.\n    # These correspond to the one-hot encoding used in `features_dict['direction']`.\n    DIR_NORTH = 0  # (0, -1)\n    DIR_EAST = 1   # (1, 0)\n    DIR_SOUTH = 2  # (0, 1)\n    DIR_WEST = 3   # (-1, 0)\n\n    # Defines all possible movement actions:\n    # Key: (dx, dy) representing the change in coordinates for a move.\n    # Value: A tuple (action_id, resulting_direction_id)\n    #   action_id: The integer ID of the action to take (e.g., ACTION_UP for (0, -1)).\n    #   resulting_direction_id: The internal direction ID the agent will face\n    #                           after completing this move.\n    MOVE_ACTION_MAP = {\n        (0, -1): (ACTION_UP, DIR_NORTH),    # Move North (y-1), face North\n        (0, 1): (ACTION_DOWN, DIR_SOUTH),   # Move South (y+1), face South\n        (-1, 0): (ACTION_LEFT, DIR_WEST),   # Move West (x-1), face West\n        (1, 0): (ACTION_RIGHT, DIR_EAST)    # Move East (x+1), face East\n    }\n\n    # Maps an agent's internal direction ID to the (dx, dy) vector of the cell\n    # directly in front of the agent. This is used to determine where the 'USE'\n    # action would apply.\n    DIRECTION_ID_TO_VECTOR = {\n        DIR_NORTH: (0, -1),\n        DIR_EAST: (1, 0),\n        DIR_SOUTH: (0, 1),\n        DIR_WEST: (-1, 0)\n    }\n\n    # Get the current state information from the environment.\n    # The grid and agent's initial position/direction are static for this pathfinding.\n    initial_observations = env.observations()\n    initial_grid = initial_observations['features_dict']['features_global']\n    initial_pos = tuple(initial_observations['features_dict']['pos'].astype(int))\n    # Convert the one-hot direction vector to an integer direction ID (0-3).\n    initial_dir = np.argmax(initial_observations['features_dict']['direction'])\n\n    # Extract grid dimensions (WIDTH, HEIGHT, n_kinds).\n    grid_width, grid_height, _ = initial_grid.shape\n    # Get the set of entity indices that the agent cannot move through.\n    impassable_entity_indices = env.world.non_grabbable_indices\n\n    # --- Helper Functions for Grid Interaction ---\n\n    def is_within_bounds(x, y):\n        \"\"\"Checks if a given (x, y) coordinate is within the grid boundaries.\"\"\"\n        return 0 <= x < grid_width and 0 <= y < grid_height\n\n    def is_traversable(x, y):\n        \"\"\"\n        Checks if the cell at (x, y) is traversable by the agent.\n        A cell is not traversable if it's out of bounds or contains an impassable entity.\n        \"\"\"\n        if not is_within_bounds(x, y):\n            return False\n        # Check if any impassable entity is present in the cell.\n        for entity_idx in impassable_entity_indices:\n            if initial_grid[x, y, entity_idx] > 0:\n                return False  # Contains an obstacle\n        return True  # Cell is clear for movement\n\n    # --- Breadth-First Search (BFS) for Pathfinding ---\n\n    # BFS state is represented as ((x, y), direction_id).\n    # We include direction because the 'USE' action depends on the agent's facing.\n    queue = collections.deque([(initial_pos, initial_dir)])\n    visited_states = set([(initial_pos, initial_dir)])  # To prevent cycles and redundant exploration.\n    # `path_reconstruction_map` stores (child_state) -> ((parent_state), action_taken_to_reach_child)\n    parent_map = {}\n\n    target_collection_state = None  # Will store the state from which 'ACTION_USE' can be performed.\n\n    while queue:\n        (current_x, current_y), current_dir = queue.popleft()\n        current_bfs_state = ((current_x, current_y), current_dir)\n\n        # First, check if the primitive can be collected from the current state.\n        # This means checking the cell directly in front of the agent.\n        facing_vector = DIRECTION_ID_TO_VECTOR[current_dir]\n        front_x, front_y = current_x + facing_vector[0], current_y + facing_vector[1]\n\n        if is_within_bounds(front_x, front_y) and initial_grid[front_x, front_y, primitive] > 0:\n            # The primitive is found in the cell in front!\n            # This `current_bfs_state` is the goal state from which to apply `ACTION_USE`.\n            target_collection_state = current_bfs_state\n            break  # Shortest path found, exit BFS.\n\n        # If not at the collection point, explore possible moves.\n        for move_vec, (action_id, next_dir) in MOVE_ACTION_MAP.items():\n            next_x, next_y = current_x + move_vec[0], current_y + move_vec[1]\n            next_pos = (next_x, next_y)\n            next_bfs_state = (next_pos, next_dir)\n\n            # Only proceed if the next cell is traversable and this state hasn't been visited.\n            if is_traversable(next_x, next_y) and next_bfs_state not in visited_states:\n                visited_states.add(next_bfs_state)\n                # Record the action taken to reach `next_bfs_state` from `current_bfs_state`.\n                parent_map[next_bfs_state] = (current_bfs_state, action_id)\n                queue.append(next_bfs_state)\n\n    # --- Path Reconstruction ---\n\n    if target_collection_state:\n        # The last action to collect the primitive is always 'ACTION_USE'.\n        actions_sequence = [ACTION_USE]\n        current_path_state = target_collection_state\n\n        # Backtrack from the `target_collection_state` to the `initial_pos`/`initial_dir`.\n        while current_path_state != (initial_pos, initial_dir):\n            # Retrieve the parent state and the action that led to `current_path_state`.\n            parent_state, action_from_parent = parent_map[current_path_state]\n            actions_sequence.append(action_from_parent)\n            current_path_state = parent_state\n        \n        # The actions were collected in reverse order (from target to start), so reverse the list.\n        return actions_sequence[::-1]\n    else:\n        # If the BFS completes and `target_collection_state` is None, the primitive is unreachable.\n        return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:13:52.154437", "function_name": "collect", "function_body": "", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:13:53.128421", "function_name": "collect", "function_body": "  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Internal constants for agent's facing direction.\n  # These correspond to the indices in the one-hot direction vector and often to how deltas are computed.\n  _DIR_NORTH = 0  # Agent facing North (often corresponds to (0, -1) in grid coordinates)\n  _DIR_EAST = 1   # Agent facing East (often corresponds to (1, 0))\n  _DIR_SOUTH = 2  # Agent facing South (often corresponds to (0, 1))\n  _DIR_WEST = 3   # Agent facing West (often corresponds to (-1, 0))\n\n  # Mapping from agent's facing direction index to (dx, dy) relative coordinates\n  # for the cell directly in front of the agent. This is where _USE applies.\n  DIR_TO_FRONT_DELTA = {\n      _DIR_NORTH: (0, -1),\n      _DIR_EAST:  (1, 0),\n      _DIR_SOUTH: (0, 1),\n      _DIR_WEST:  (-1, 0)\n  }\n\n  # Mapping from a movement action to:\n  # 1. The (dx, dy) change in the agent's position.\n  # 2. The new direction (index) the agent will be facing after the move.\n  ACTION_TO_MOVE_AND_NEW_DIR = {\n      _UP:    ((0, -1), _DIR_NORTH),\n      _DOWN:  ((0, 1),  _DIR_SOUTH),\n      _LEFT:  ((-1, 0), _DIR_WEST),\n      _RIGHT: ((1, 0),  _DIR_EAST)\n  }\n\n  # Get current state information from the environment's observations.\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  # The full allocentric grid represents the world layout.\n  current_grid = features_dict['features_global'] \n  \n  # Determine grid dimensions (Width, Height, Number of Kinds).\n  WIDTH, HEIGHT, N_KINDS = current_grid.shape \n\n  # Denormalize current agent position from [0,1] range to grid coordinates.\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  start_pos = (current_px, current_py)\n\n  # Get the initial agent direction as an integer index (0-3).\n  start_dir_idx = np.argmax(features_dict['direction']) \n\n  # Early exit: If the primitive is not designated as grabbable, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Define the set of entity indices that represent impassable obstacles for movement.\n  # In CraftWorld, `non_grabbable_indices` typically includes terrain like water, stone,\n  # and workshops that block the agent's path.\n  impassable_movement_indices = set(env.world.non_grabbable_indices)\n  \n  def is_cell_impassable(x, y, grid, impassable_kinds_set, grid_width, grid_height):\n    \"\"\"\n    Checks if a cell at (x,y) is out of bounds or contains any entity kind\n    that is considered impassable for agent movement.\n    \"\"\"\n    # Check if the cell is outside the grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return True # Out of bounds is always impassable.\n\n    # Check if the cell contains any impassable kind.\n    # The grid is one-hot encoded for kinds, so `grid[x,y,k] == 1` means kind `k` is present.\n    for k_idx in impassable_kinds_set:\n        if grid[x, y, k_idx] == 1:\n            return True # Found an impassable kind in this cell.\n    return False\n\n  # Initialize Breadth-First Search (BFS) Queue.\n  # Each element in the queue is a tuple:\n  # (current_x, current_y, current_direction_idx, [path_of_actions_to_reach_this_state])\n  q = collections.deque()\n  q.append((start_pos[0], start_pos[1], start_dir_idx, [])) \n  \n  # Initialize a set to store visited states to prevent cycles and redundant path exploration.\n  # A state is uniquely defined by (x_position, y_position, facing_direction_index).\n  visited_states = {(start_pos[0], start_pos[1], start_dir_idx)} \n\n  while q:\n    cx, cy, c_dir_idx, current_path = q.popleft()\n\n    # --- GOAL CHECK: Can we collect the primitive from the current state? ---\n    # The `_USE` action typically applies to the cell directly in front of the agent.\n    front_dx, front_dy = DIR_TO_FRONT_DELTA[c_dir_idx]\n    fx, fy = cx + front_dx, cy + front_dy\n\n    # Check if the cell in front is within grid bounds AND contains the target primitive.\n    if (0 <= fx < WIDTH and 0 <= fy < HEIGHT and\n        current_grid[fx, fy, primitive] == 1):\n      # If the primitive is found in the cell directly in front, we have a solution.\n      # Append the `_USE` action to the current path and return it.\n      return current_path + [_USE]\n\n    # --- EXPLORE MOVEMENT ACTIONS from the current state ---\n    # Iterate through all possible movement actions (UP, DOWN, LEFT, RIGHT).\n    for action, ((move_dx, move_dy), new_dir_idx) in ACTION_TO_MOVE_AND_NEW_DIR.items():\n      nx, ny = cx + move_dx, cy + move_dy # Calculate the new position after applying this action.\n\n      # Check if the calculated new position is valid (within bounds and not an obstacle).\n      if is_cell_impassable(nx, ny, current_grid, impassable_movement_indices, WIDTH, HEIGHT):\n        continue # This path is blocked; skip to the next action.\n\n      # Define the new state tuple (position and direction after the move).\n      new_state = (nx, ny, new_dir_idx)\n\n      # If this new state has not been visited before, add it to the queue for exploration.\n      if new_state not in visited_states:\n        new_path = current_path + [action] # Append the current movement action to the path.\n        q.append((nx, ny, new_dir_idx, new_path))\n        visited_states.add(new_state) # Mark the new state as visited.\n  \n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable or does not exist in the environment.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:15:02.860050", "function_name": "collect", "function_body": "  import collections\n\n  initial_state = env._current_state\n  initial_grid = initial_state.grid\n  WIDTH, HEIGHT, _ = initial_grid.shape # Grid shape (width, height, n_kinds)\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction\n\n  # Define actions and their (dx, dy) deltas.\n  # These map to the integer values returned by CraftLab.action_specs().\n  _DOWN_ACTION = 0\n  _UP_ACTION = 1\n  _LEFT_ACTION = 2\n  _RIGHT_ACTION = 3\n  _USE_ACTION = 4\n\n  _ACTION_DELTAS = {\n      _UP_ACTION: (0, -1),   # Move up (decrease y)\n      _DOWN_ACTION: (0, 1),    # Move down (increase y)\n      _LEFT_ACTION: (-1, 0),  # Move left (decrease x)\n      _RIGHT_ACTION: (1, 0),   # Move right (increase x)\n  }\n\n  # Map movement actions to the resulting facing direction\n  # Direction values: 0 (North), 1 (East), 2 (South), 3 (West)\n  _DIR_NORTH = 0\n  _DIR_EAST = 1\n  _DIR_SOUTH = 2\n  _DIR_WEST = 3\n\n  _ACTION_TO_DIR_MAP = {\n      _UP_ACTION: _DIR_NORTH,\n      _DOWN_ACTION: _DIR_SOUTH,\n      _LEFT_ACTION: _DIR_WEST,\n      _RIGHT_ACTION: _DIR_EAST,\n  }\n\n  def _get_forward_coords(x, y, direction):\n      \"\"\"Returns the (x, y) coordinates of the cell directly in front of the agent.\"\"\"\n      if direction == _DIR_NORTH:\n          return x, y - 1\n      elif direction == _DIR_EAST:\n          return x + 1, y\n      elif direction == _DIR_SOUTH:\n          return x, y + 1\n      elif direction == _DIR_WEST:\n          return x - 1, y\n      return x, y # Should not happen\n\n  is_grabbable = primitive in env.world.grabbable_indices\n  # Stone and water are typically 'used' via the USE action\n  is_use_target = (primitive == env.world.stone_index or\n                   primitive == env.world.water_index)\n\n  # If the primitive is not grabbable and not a 'use'-able target,\n  # then this function cannot collect it directly.\n  if not is_grabbable and not is_use_target:\n      return []\n\n  # BFS Queue: stores (current_x, current_y, current_direction, path_actions_list)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set: stores (x, y, direction) tuples to prevent cycles and redundant explorations\n  visited = set([(start_x, start_y, start_dir)])\n\n  # BFS loop\n  while queue:\n      curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n      # --- Check if the current state satisfies the collection condition ---\n      if is_grabbable:\n          # For grabbable items, the target is to be on the same cell as the item.\n          if initial_grid[curr_x, curr_y, primitive] > 0:\n              return path_actions # Path to reach and collect the grabbable item\n      elif is_use_target:\n          # For items requiring USE action (like stone or water), the agent must be\n          # facing the item.\n          fwd_x, fwd_y = _get_forward_coords(curr_x, curr_y, curr_dir)\n\n          # Check boundaries for the cell in front\n          if (0 <= fwd_x < WIDTH and 0 <= fwd_y < HEIGHT and\n              initial_grid[fwd_x, fwd_y, primitive] > 0):\n              return path_actions + [_USE_ACTION] # Path to position + USE action\n\n      # --- End of collection condition check ---\n\n      # Explore neighbors for movement\n      for action_val, (dx, dy) in _ACTION_DELTAS.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_dir = _ACTION_TO_DIR_MAP[action_val] # Direction changes based on the move\n\n          # Check boundaries: ensure the next position is within the grid.\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check if the next cell is blocked by impassable terrain.\n          # A cell is considered blocked if it contains any non-grabbable item\n          # that is not a workshop and not water (as workshops and water are typically traversable).\n          is_blocked_by_impassable = False\n          for k_idx in env.world.non_grabbable_indices:\n              if initial_grid[next_x, next_y, k_idx] > 0:\n                  if k_idx not in env.world.workshop_indices and k_idx != env.world.water_index:\n                      is_blocked_by_impassable = True\n                      break\n          if is_blocked_by_impassable:\n              continue # This cell is blocked, don't move here\n\n          # If the cell is not blocked and this specific (position, direction) state\n          # has not been visited, add it to the queue.\n          if (next_x, next_y, next_dir) not in visited:\n              visited.add((next_x, next_y, next_dir))\n              new_path_actions = path_actions + [action_val]\n              queue.append((next_x, next_y, next_dir, new_path_actions))\n\n  # If no path to collect the primitive is found after exploring all reachable states,\n  # return an empty list.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:15:03.828786", "function_name": "collect", "function_body": "  import collections\n\n  initial_state = env._current_state\n  initial_grid = initial_state.grid\n  WIDTH, HEIGHT, _ = initial_grid.shape # Grid shape (width, height, n_kinds)\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Get initial direction from the current state\n\n  # Define actions and their (dx, dy) deltas.\n  # These map to the integer values returned by CraftLab.action_specs().\n  _DOWN_ACTION = 0\n  _UP_ACTION = 1\n  _LEFT_ACTION = 2\n  _RIGHT_ACTION = 3\n  _USE_ACTION = 4 # The USE action\n\n  # Map movement actions to the (dx, dy) deltas for position change.\n  # This matches the definition in collect_v0.\n  _ACTION_DELTAS = {\n      _UP_ACTION: (0, -1),   # Move up (decrease y)\n      _DOWN_ACTION: (0, 1),    # Move down (increase y)\n      _LEFT_ACTION: (-1, 0),  # Move left (decrease x)\n      _RIGHT_ACTION: (1, 0),   # Move right (increase x)\n  }\n\n  # Map movement actions to the direction the agent will face after the move.\n  # CraftState directions are: 0 (North/Up), 1 (South/Down), 2 (West/Left), 3 (East/Right).\n  _ACTION_TO_NEW_DIR = {\n      _UP_ACTION: 0,   # Agent faces North (0) after moving UP\n      _DOWN_ACTION: 1,    # Agent faces South (1) after moving DOWN\n      _LEFT_ACTION: 2,  # Agent faces West (2) after moving LEFT\n      _RIGHT_ACTION: 3,   # Agent faces East (3) after moving RIGHT\n  }\n\n  # Map directions to their (dx, dy) deltas relative to the agent's current position.\n  # This defines where the agent is \"looking\" if it's facing this direction.\n  # Used for checking the cell targeted by _USE_ACTION.\n  _DIR_TO_DELTA = {\n      0: (0, -1),  # North (Up)\n      1: (0, 1),   # South (Down)\n      2: (-1, 0),  # West (Left)\n      3: (1, 0),   # East (Right)\n  }\n\n  is_grabbable = primitive in env.world.grabbable_indices\n  is_stone = primitive == env.world.stone_index\n  is_water = primitive == env.world.water_index\n\n  # This function aims to collect a primitive.\n  # If it's not grabbable, and not a 'use'-able environmental primitive (like stone or water),\n  # then this function cannot collect it directly.\n  if not is_grabbable and not is_stone and not is_water:\n      return []\n\n  # BFS Queue: stores (current_x, current_y, current_direction, path_actions_list)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to prevent cycles and redundant explorations.\n  # Now includes direction in the state to account for different paths that lead\n  # to the same (x,y) but with different orientations.\n  visited = set([(start_x, start_y, start_dir)])\n\n  # BFS loop\n  while queue:\n      curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n      # --- Check if the current state satisfies the collection condition ---\n      if is_grabbable:\n          # For grabbable items, the target is to be on the same cell as the item.\n          # Direction does not matter for grabbable items (they are picked up on entry).\n          if initial_grid[curr_x, curr_y, primitive] > 0:\n              return path_actions # Path to reach and collect the grabbable item\n      elif is_stone or is_water:\n          # For items requiring _USE_ACTION (like stone or water),\n          # the agent must be adjacent to the item AND facing it.\n          # Determine the coordinates of the cell directly in front of the agent based on curr_dir.\n          tdx, tdy = _DIR_TO_DELTA[curr_dir]\n          tx, ty = curr_x + tdx, curr_y + tdy\n\n          # Check boundary for the cell directly in front of the agent\n          if 0 <= tx < WIDTH and 0 <= ty < HEIGHT:\n              # Check if the cell directly in front contains the primitive\n              if initial_grid[tx, ty, primitive] > 0:\n                  # If it does, and the agent is facing it, we can USE it.\n                  return path_actions + [_USE_ACTION] # Path to position + USE action\n      # --- End of collection condition check ---\n\n      # Explore neighbors for movement actions (UP, DOWN, LEFT, RIGHT)\n      for action_val, (dx, dy) in _ACTION_DELTAS.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_dir = _ACTION_TO_NEW_DIR[action_val] # Agent's new direction after this move\n\n          # Check boundaries: ensure the next position is within the grid.\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check if the next cell is blocked by impassable terrain.\n          # A cell is considered blocked if it contains any non-grabbable item\n          # that is not a workshop and not water (as workshops and water are typically traversable).\n          is_blocked_by_impassable = False\n          for k_idx in env.world.non_grabbable_indices:\n              if initial_grid[next_x, next_y, k_idx] > 0:\n                  # Allow movement onto workshops and water, even if non-grabbable.\n                  if k_idx not in env.world.workshop_indices and k_idx != env.world.water_index:\n                      is_blocked_by_impassable = True\n                      break\n          if is_blocked_by_impassable:\n              continue # This cell is blocked, don't move here\n\n          # If the cell is not blocked and this specific (position, direction) state\n          # has not been visited yet, add it to the queue.\n          if (next_x, next_y, next_dir) not in visited:\n              visited.add((next_x, next_y, next_dir))\n              new_path_actions = path_actions + [action_val]\n              queue.append((next_x, next_y, next_dir, new_path_actions))\n\n  # If no path to collect the primitive is found after exploring all reachable states, return an empty list.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:16:15.102188", "function_name": "collect", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:16:16.092943", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map movement vectors (dx, dy) to action IDs.\n  # These actions move the agent AND set its facing direction.\n  MOVE_VEC_TO_ACTION = {\n      (0, -1): UP,    # Move North\n      (0, 1): DOWN,   # Move South\n      (-1, 0): LEFT,  # Move West\n      (1, 0): RIGHT   # Move East\n  }\n\n  # Map agent's internal direction ID to its corresponding facing vector (dx, dy).\n  # 0: North (-Y)\n  # 1: East (+X)\n  # 2: South (+Y)\n  # 3: West (-X)\n  DIR_TO_VEC = {\n      0: (0, -1),  # North\n      1: (1, 0),   # East\n      2: (0, 1),   # South\n      3: (-1, 0)   # West\n  }\n\n  # Map movement vector to the corresponding internal direction ID the agent will face\n  # after taking that move.\n  # If you move North (0,-1), you face North (dir ID 0).\n  # If you move East (1,0), you face East (dir ID 1).\n  # If you move South (0,1), you face South (dir ID 2).\n  # If you move West (-1,0), you face West (dir ID 3).\n  DIR_VEC_TO_DIR_ID = {\n      (0, -1): 0,\n      (1, 0): 1,\n      (0, 1): 2,\n      (-1, 0): 3\n  }\n\n  initial_obs = env.observations()\n  initial_grid = initial_obs['features_dict']['features_global']\n  initial_pos_tuple = tuple(initial_obs['features_dict']['pos'].astype(int))\n  # Agent's direction is a one-hot vector, convert to integer (0-3)\n  initial_dir = np.argmax(initial_obs['features_dict']['direction'])\n\n  # Grid dimensions: grid is (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = initial_grid.shape\n\n  # Get indices of non-grabbable items (obstacles) from the world\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a coordinate is within grid bounds\n  def is_valid_coord(x, y):\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  # Helper function to check if a cell is traversable.\n  # A cell is not traversable if it contains any non-grabbable entity.\n  def is_traversable(x, y, current_grid):\n      if not is_valid_coord(x, y):\n          return False\n      for idx in non_grabbable_indices:\n          if current_grid[x, y, idx] > 0:\n              return False # Contains an obstacle\n      return True # Traversable\n\n  # BFS search to find the shortest path to a position from which the primitive can be collected.\n  # The state in BFS is ((x, y), direction_int).\n  # We use parent_map to reconstruct the path later, avoiding large memory usage by not storing full paths in the queue.\n  queue = collections.deque([(initial_pos_tuple, initial_dir)])\n  # Visited set stores (position, direction) tuples to prevent cycles and redundant exploration.\n  visited = set([(initial_pos_tuple, initial_dir)])\n  # parent_map stores: (child_pos, child_dir) -> ((parent_pos, parent_dir), action_taken_to_reach_child)\n  parent_map = {}\n\n  target_reached_state = None # To store the state from which USE action can be applied\n\n  while queue:\n      (curr_x, curr_y), curr_dir_int = queue.popleft()\n      current_bfs_state = ((curr_x, curr_y), curr_dir_int)\n\n      # Check if the target primitive is directly in front of the current position and direction.\n      facing_vec = DIR_TO_VEC[curr_dir_int]\n      front_x, front_y = curr_x + facing_vec[0], curr_y + facing_vec[1]\n\n      if is_valid_coord(front_x, front_y) and initial_grid[front_x, front_y, primitive] > 0:\n          # Found the primitive in front, this is our target state.\n          target_reached_state = current_bfs_state\n          break # Found the shortest path, exit BFS\n\n      # Explore possible moves (UP, DOWN, LEFT, RIGHT).\n      # Each move action also changes the agent's direction to the direction of movement.\n      for move_vec, move_action in MOVE_VEC_TO_ACTION.items():\n          next_x, next_y = curr_x + move_vec[0], curr_y + move_vec[1]\n          # The new direction should be based on the direction of movement.\n          # This corrects the logic from collect_v1 where `next_dir_int = move_action`\n          # which was inconsistent with the problem's direction mapping.\n          next_dir_int = DIR_VEC_TO_DIR_ID[move_vec]\n          next_pos_tuple = (next_x, next_y)\n\n          # Check if the next cell is traversable.\n          if is_traversable(next_x, next_y, initial_grid):\n              next_bfs_state = (next_pos_tuple, next_dir_int)\n              if next_bfs_state not in visited:\n                  visited.add(next_bfs_state)\n                  # Store the parent and the action taken to reach this state\n                  parent_map[next_bfs_state] = (current_bfs_state, move_action)\n                  queue.append(next_bfs_state)\n\n  # If target_reached_state is found, reconstruct the path\n  if target_reached_state:\n      actions_path = [USE] # The last action is always USE\n      current_path_state = target_reached_state\n\n      # Backtrack from the target_reached_state to the initial_state\n      while current_path_state != (initial_pos_tuple, initial_dir):\n          # Get parent state and action from parent_map\n          parent_state, action_to_reach_curr = parent_map[current_path_state]\n          actions_path.append(action_to_reach_curr)\n          current_path_state = parent_state\n      \n      # The path was built in reverse, so reverse it back\n      return actions_path[::-1]\n\n  # If the queue becomes empty and no path was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:18:06.568065", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n  Finds the shortest sequence of actions (movements and a final USE)\n  to navigate the agent to a position adjacent to the specified primitive\n  and collect it. Uses a Breadth-First Search (BFS) to explore possible\n  states (agent position and direction).\n\n  Args:\n    env: The CraftLab environment instance.\n    primitive: An integer index representing the ID of the primitive item to collect.\n\n  Returns:\n    A list of integer action IDs representing the shortest path to collect the primitive.\n    Returns an empty list if the primitive is not found or is unreachable.\n  \"\"\"\n  import collections\n  import numpy as np\n\n  # Action constants (from env.action_specs())\n  # These map action names to their integer IDs as defined by the CraftLab environment.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map movement vectors (dx, dy) to their corresponding action IDs.\n  # Taking one of these actions moves the agent and implicitly sets its facing direction\n  # based on the direction of movement.\n  MOVE_VEC_TO_ACTION = {\n      (0, -1): UP,    # Move North (along -Y axis)\n      (0, 1): DOWN,   # Move South (along +Y axis)\n      (-1, 0): LEFT,  # Move West (along -X axis)\n      (1, 0): RIGHT   # Move East (along +X axis)\n  }\n\n  # Map agent's internal direction ID to its corresponding facing vector (dx, dy).\n  # This mapping is critical for determining what is \"in front\" of the agent.\n  # 0: North (-Y)\n  # 1: East (+X)\n  # 2: South (+Y)\n  # 3: West (-X)\n  DIR_TO_VEC = {\n      0: (0, -1),  # Facing North\n      1: (1, 0),   # Facing East\n      2: (0, 1),   # Facing South\n      3: (-1, 0)   # Facing West\n  }\n\n  # Map a movement vector to the corresponding internal direction ID the agent\n  # will face *after* taking that move. This ensures the agent's direction\n  # state is correctly updated in the BFS. For instance, moving North (vector (0,-1))\n  # results in the agent facing North (direction ID 0).\n  DIR_VEC_TO_DIR_ID = {\n      (0, -1): 0,  # North move -> North facing (ID 0)\n      (1, 0): 1,   # East move -> East facing (ID 1)\n      (0, 1): 2,   # South move -> South facing (ID 2)\n      (-1, 0): 3   # West move -> West facing (ID 3)\n  }\n\n  # --- Initialize State Information from Environment ---\n  initial_observation = env.observations()\n  # The grid layout is static for the purpose of path planning to a primitive.\n  current_grid = initial_observation['features_dict']['features_global']\n  \n  # Agent's initial position as (x, y) coordinates\n  initial_pos_x, initial_pos_y = initial_observation['features_dict']['pos'].astype(int)\n  initial_pos_tuple = (initial_pos_x, initial_pos_y)\n  \n  # Agent's initial direction (integer ID 0-3 from one-hot vector)\n  initial_direction = np.argmax(initial_observation['features_dict']['direction'])\n\n  # Grid dimensions: current_grid is expected to be of shape (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = current_grid.shape\n\n  # Retrieve indices of non-grabbable items (obstacles) from the CraftWorld configuration.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # --- Helper Functions for BFS ---\n  def _is_valid_coord(x, y):\n      \"\"\"Checks if a given coordinate (x, y) is within the grid boundaries.\"\"\"\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  def _is_traversable(x, y):\n      \"\"\"Checks if a cell at (x, y) can be entered by the agent.\n      A cell is considered non-traversable if it contains any non-grabbable entity.\n      \"\"\"\n      if not _is_valid_coord(x, y):\n          return False # Out of bounds\n      for idx in non_grabbable_indices:\n          if current_grid[x, y, idx] > 0:\n              return False # Contains an obstacle\n      return True # Cell is valid and does not contain obstacles\n\n  # --- BFS Setup ---\n  # A state in the BFS is defined by the agent's ((x, y) position, direction_ID).\n  # The queue stores states to be explored.\n  queue = collections.deque([(initial_pos_tuple, initial_direction)])\n  \n  # The visited set tracks states already explored to prevent cycles and redundant work.\n  visited = set([(initial_pos_tuple, initial_direction)])\n  \n  # The parent_map stores the predecessor state and the action taken to reach the current state.\n  # This is used to reconstruct the path once the target is found:\n  # (child_pos, child_dir) -> ((parent_pos, parent_dir), action_taken_to_reach_child)\n  parent_map = {}\n\n  target_achieved_state = None # Placeholder to store the BFS state from which the 'USE' action can be applied.\n\n  # --- BFS Loop ---\n  while queue:\n      (curr_x, curr_y), curr_dir_int = queue.popleft()\n      current_bfs_state = ((curr_x, curr_y), curr_dir_int)\n\n      # Check if the target primitive is located in the cell directly in front of the agent.\n      facing_vector = DIR_TO_VEC[curr_dir_int]\n      front_x, front_y = curr_x + facing_vector[0], curr_y + facing_vector[1]\n\n      if _is_valid_coord(front_x, front_y) and current_grid[front_x, front_y, primitive] > 0:\n          # The primitive is found in the cell the agent is currently facing.\n          # This `current_bfs_state` is the goal state from which the `USE` action can be taken.\n          target_achieved_state = current_bfs_state\n          break # Since this is a BFS, the first path found is guaranteed to be the shortest.\n\n      # Explore all possible movement actions from the current state.\n      for move_vec, move_action_id in MOVE_VEC_TO_ACTION.items():\n          next_x, next_y = curr_x + move_vec[0], curr_y + move_vec[1]\n          \n          # The agent's new facing direction is determined by the direction of the movement itself.\n          next_dir_int = DIR_VEC_TO_DIR_ID[move_vec]\n          next_pos_tuple = (next_x, next_y)\n          next_bfs_state = (next_pos_tuple, next_dir_int)\n\n          # If the next cell is traversable and this state has not been visited, add it to the queue.\n          if _is_traversable(next_x, next_y) and next_bfs_state not in visited:\n              visited.add(next_bfs_state)\n              # Store the connection: how we reached `next_bfs_state` from `current_bfs_state`.\n              parent_map[next_bfs_state] = (current_bfs_state, move_action_id)\n              queue.append(next_bfs_state)\n\n  # --- Path Reconstruction ---\n  if target_achieved_state:\n      # Start with the `USE` action, as it's the final step to collect the primitive.\n      action_sequence = [USE] \n      \n      # Backtrack from the `target_achieved_state` to the `initial_bfs_state`\n      # using the `parent_map` to reconstruct the sequence of movement actions.\n      current_backtrack_state = target_achieved_state\n      initial_bfs_state = (initial_pos_tuple, initial_direction)\n\n      while current_backtrack_state != initial_bfs_state:\n          # Retrieve the parent state and the action that led from the parent to the current state.\n          parent_state, action_to_reach_current = parent_map[current_backtrack_state]\n          action_sequence.append(action_to_reach_current)\n          current_backtrack_state = parent_state\n      \n      # The `action_sequence` was built in reverse order (from goal back to start).\n      # Reverse it to get the correct chronological order of actions.\n      return action_sequence[::-1]\n\n  # If the BFS completed without finding the primitive (queue became empty), return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:18:07.562905", "function_name": "collect", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:19:08.407846", "function_name": "collect", "function_body": "  import collections\n\n  # Constants for actions and directions (assuming CraftWorld uses these internally)\n  _DOWN_ACTION = 0\n  _UP_ACTION = 1\n  _LEFT_ACTION = 2\n  _RIGHT_ACTION = 3\n  _USE_ACTION = 4\n\n  # Map movement actions to their (dx, dy) deltas and resulting directions (DIR_DOWN=0, DIR_UP=1, DIR_LEFT=2, DIR_RIGHT=3)\n  _MOVE_ACTIONS_AND_DIRS = {\n      _DOWN_ACTION: (0, 1, 0),    # (dx, dy, new_dir) for moving DOWN\n      _UP_ACTION: (0, -1, 1),    # (dx, dy, new_dir) for moving UP\n      _LEFT_ACTION: (-1, 0, 2),  # (dx, dy, new_dir) for moving LEFT\n      _RIGHT_ACTION: (1, 0, 3),   # (dx, dy, new_dir) for moving RIGHT\n  }\n\n  # Map directions to their (dx, dy) deltas for determining the cell 'in front'\n  _DIRECTION_DELTAS = {\n      0: (0, 1),   # DIR_DOWN: (0, 1) relative to agent's pos\n      1: (0, -1),  # DIR_UP: (0, -1)\n      2: (-1, 0),  # DIR_LEFT: (-1, 0)\n      3: (1, 0),   # DIR_RIGHT: (1, 0)\n  }\n\n  initial_state = env._current_state\n  initial_grid = initial_state.grid\n  WIDTH, HEIGHT, _ = initial_grid.shape\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Get initial direction from the CraftState\n\n  is_grabbable = primitive in env.world.grabbable_indices\n  is_stone = primitive == env.world.stone_index\n  is_water = primitive == env.world.water_index\n\n  # If the primitive is not grabbable and not a specific 'use'-able environmental item (like stone or water),\n  # this function cannot collect it.\n  if not is_grabbable and not is_stone and not is_water:\n      return []\n\n  # BFS Queue: stores (current_x, current_y, current_dir, path_actions_list)\n  # The state now includes the agent's current direction.\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set: stores (x, y, dir) tuples to avoid re-exploring the same state\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n      curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n      # --- Check if the current state satisfies the collection condition ---\n      if is_grabbable:\n          # For grabbable items, the agent must be on the same cell as the item.\n          # Direction doesn't matter for picking up an item on the current cell.\n          if initial_grid[curr_x, curr_y, primitive] > 0:\n              return path_actions # Path to reach the grabbable item\n      else: # Primitive requires _USE_ACTION (e.g., stone, water)\n          # The _USE_ACTION typically interacts with the cell directly in front of the agent.\n          dx_f, dy_f = _DIRECTION_DELTAS[curr_dir]\n          front_x, front_y = curr_x + dx_f, curr_y + dy_f\n\n          # Check if the cell in front is within bounds and contains the primitive\n          if (0 <= front_x < WIDTH and 0 <= front_y < HEIGHT and\n                  initial_grid[front_x, front_y, primitive] > 0):\n              # If the primitive is in front and the agent is facing it, we can use it.\n              return path_actions + [_USE_ACTION] # Path to position + face + USE action\n\n      # --- Explore neighbors via movement actions ---\n      for action_val, (dx, dy, next_dir) in _MOVE_ACTIONS_AND_DIRS.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n\n          # Check boundaries: ensure the next position is within the grid.\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check if the next cell is blocked by impassable terrain.\n          # A cell is considered blocked if it contains any non-grabbable item\n          # that is not a workshop and not water (as workshops and water are typically traversable).\n          is_blocked_by_impassable = False\n          for k_idx in env.world.non_grabbable_indices:\n              if initial_grid[next_x, next_y, k_idx] > 0:\n                  if k_idx not in env.world.workshop_indices and k_idx != env.world.water_index:\n                      is_blocked_by_impassable = True\n                      break\n          if is_blocked_by_impassable:\n              continue # This cell is blocked, don't move here\n\n          # If the potential new state (position + direction) has not been visited, add it to the queue.\n          if (next_x, next_y, next_dir) not in visited:\n              visited.add((next_x, next_y, next_dir))\n              new_path_actions = path_actions + [action_val]\n              queue.append((next_x, next_y, next_dir, new_path_actions))\n\n  # If no path to collect the primitive is found after exploring all reachable cells/states, return an empty list.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:19:09.417577", "function_name": "collect", "function_body": "  import collections\n\n  # Constants for actions as defined by CraftLab.action_specs()\n  _DOWN_ACTION = 0\n  _UP_ACTION = 1\n  _LEFT_ACTION = 2\n  _RIGHT_ACTION = 3\n  _USE_ACTION = 4\n\n  # Direction mappings: (direction_id: (dx, dy) vector)\n  # Assuming CraftWorld's internal direction IDs map as follows:\n  # 0: North (Up, -Y)\n  # 1: East (Right, +X)\n  # 2: South (Down, +Y)\n  # 3: West (Left, -X)\n  _DIRECTION_VECTORS = {\n      0: (0, -1), # North\n      1: (1, 0),  # East\n      2: (0, 1),  # South\n      3: (-1, 0)  # West\n  }\n\n  # Mapping movement actions to their (dx, dy) effect on position\n  # and the new direction the agent will face after the action.\n  _ACTION_EFFECTS = {\n      _UP_ACTION:    {'delta': (0, -1), 'new_dir': 0}, # Move UP, face North\n      _DOWN_ACTION:  {'delta': (0, 1),  'new_dir': 2}, # Move DOWN, face South\n      _LEFT_ACTION:  {'delta': (-1, 0), 'new_dir': 3}, # Move LEFT, face West\n      _RIGHT_ACTION: {'delta': (1, 0),  'new_dir': 1}, # Move RIGHT, face East\n  }\n\n  initial_state = env._current_state\n  initial_grid = initial_state.grid\n  WIDTH, HEIGHT, _ = initial_grid.shape\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.init_dir # Agent's initial facing direction (default 0 for North)\n\n  # Determine if the primitive is grabbable or requires the USE action\n  is_grabbable = primitive in env.world.grabbable_indices\n  is_stone_or_water = (primitive == env.world.stone_index) or \\\n                      (primitive == env.world.water_index)\n\n  # If the primitive is not grabbable and not a specific 'use'-able environmental primitive\n  # (like stone or water), then this function cannot collect it directly.\n  if not is_grabbable and not is_stone_or_water:\n      return []\n\n  # BFS Queue: stores (current_x, current_y, current_direction, path_actions_list)\n  # The direction is now included in the state, crucial for correctly applying the USE action.\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set: stores (x, y, direction) tuples to prevent redundant explorations and cycles.\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n      curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n      # --- Check if the current state satisfies the collection condition ---\n      if is_grabbable:\n          # For grabbable items, the goal is to be on the same cell as the item.\n          # The agent's direction does not matter for grabbable items (they are picked up upon entry).\n          if initial_grid[curr_x, curr_y, primitive] > 0:\n              return path_actions # Path to reach the cell containing the grabbable item\n      else: # This primitive requires the USE action (stone or water)\n          # Calculate the coordinates of the cell directly in front of the agent based on curr_dir.\n          front_dx, front_dy = _DIRECTION_VECTORS[curr_dir]\n          target_use_x, target_use_y = curr_x + front_dx, curr_y + front_dy\n\n          # Check if the target cell for USE is within grid boundaries.\n          if 0 <= target_use_x < WIDTH and 0 <= target_use_y < HEIGHT:\n              # Check if the primitive is present in the cell directly in front.\n              if initial_grid[target_use_x, target_use_y, primitive] > 0:\n                  # Found the primitive in the cell the agent is facing.\n                  return path_actions + [_USE_ACTION] # Path to position and direction, then USE action\n\n      # --- Explore neighbors by applying movement actions ---\n      for action_val, effect in _ACTION_EFFECTS.items():\n          dx, dy = effect['delta']\n          new_dir = effect['new_dir'] # The direction agent will face after this move\n\n          next_x, next_y = curr_x + dx, curr_y + dy\n\n          # Check if the next position is within grid boundaries.\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check if the next cell is blocked by impassable terrain.\n          # A cell is considered blocked if it contains any non-grabbable item\n          # that is not a workshop and not water (as workshops and water are typically traversable).\n          is_blocked_by_impassable = False\n          for k_idx in env.world.non_grabbable_indices:\n              if initial_grid[next_x, next_y, k_idx] > 0:\n                  if k_idx not in env.world.workshop_indices and k_idx != env.world.water_index:\n                      is_blocked_by_impassable = True\n                      break\n          if is_blocked_by_impassable:\n              continue\n\n          # If the new state (position and direction) has not been visited, add it to the queue.\n          if (next_x, next_y, new_dir) not in visited:\n              visited.add((next_x, next_y, new_dir))\n              new_path_actions = path_actions + [action_val]\n              queue.append((next_x, next_y, new_dir, new_path_actions))\n\n  # If no path to collect the primitive is found after exploring all reachable states,\n  # return an empty list, indicating it's not currently collectible.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:20:40.146216", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Direction constants for agent's dir attribute (assumed mapping)\n  # 0: North (y-1)\n  # 1: East  (x+1)\n  # 2: South (y+1)\n  # 3: West  (x-1)\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Map (dx, dy) to movement action and target direction\n  MOVE_DELTAS = {\n      (0, -1): (UP, DIR_NORTH),\n      (0, 1): (DOWN, DIR_SOUTH),\n      (-1, 0): (LEFT, DIR_WEST),\n      (1, 0): (RIGHT, DIR_EAST),\n  }\n\n  # Map (dx, dy) from current_pos to target_pos (for facing towards an item)\n  FACING_DELTAS_TO_DIR = {\n      (0, -1): DIR_NORTH,\n      (0, 1): DIR_SOUTH,\n      (-1, 0): DIR_WEST,\n      (1, 0): DIR_EAST,\n  }\n\n  def get_actions_to_turn(current_dir, target_dir):\n      \"\"\"Calculates the minimum actions to turn from current_dir to target_dir.\"\"\"\n      actions = []\n      diff_dir = (target_dir - current_dir + 4) % 4 # Number of right turns needed\n      if diff_dir == 1: # Turn right once\n          actions.append(RIGHT)\n      elif diff_dir == 2: # Turn right twice (180 deg)\n          actions.append(RIGHT)\n          actions.append(RIGHT)\n      elif diff_dir == 3: # Turn left once (equiv to 3 right turns)\n          actions.append(LEFT)\n      return actions\n\n  actions_list = []\n  current_state = env._current_state # Direct access to the internal CraftState\n\n  # 1. Check if the primitive is already in the inventory\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # 2. Get current grid, agent's position, and direction\n  grid = current_state.grid\n  width, height, n_kinds = grid.shape\n  agent_pos = current_state.pos\n  agent_dir = current_state.dir\n\n  # 3. Find all locations of the target primitive in the grid\n  primitive_locs = []\n  for x in range(width):\n      for y in range(height):\n          if grid[x, y, primitive] == 1:\n              primitive_locs.append((x, y))\n\n  if not primitive_locs:\n      # Primitive not found anywhere in the grid\n      return []\n\n  # 4. Determine the closest primitive to the agent\n  # This serves as the primary target for collection.\n  target_primitive_pos = None\n  min_dist = float('inf')\n  for (px, py) in primitive_locs:\n      dist = abs(px - agent_pos[0]) + abs(py - agent_pos[1])\n      if dist < min_dist:\n          min_dist = dist\n          target_primitive_pos = (px, py)\n\n  tx, ty = target_primitive_pos\n\n  # 5. Find suitable adjacent cells to the target primitive\n  # The agent needs to move to an adjacent cell, then face the primitive and USE.\n  adjacent_to_primitive_candidates = []\n  for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]: # Cardinal directions\n      nx, ny = tx + dx, ty + dy\n      # Check if the potential adjacent cell is within grid bounds\n      if 0 <= nx < width and 0 <= ny < height:\n          # Store (adjacent_pos, offset_from_adjacent_to_primitive)\n          # offset_from_adjacent_to_primitive is the direction vector from (nx, ny) to (tx, ty)\n          adjacent_to_primitive_candidates.append(((nx, ny), (tx - nx, ty - ny)))\n\n  if not adjacent_to_primitive_candidates:\n      # This case should typically not happen for a valid grid\n      return []\n\n  # 6. Use BFS to find the shortest path from agent_pos to any of the\n  #    `adjacent_to_primitive_candidates`\n  q = collections.deque([(agent_pos, [])]) # (current_pos, list_of_coordinates_in_path_to_here)\n  visited = {agent_pos}\n  \n  best_path_coords = None\n  final_agent_pos_before_use = None\n  final_offset_to_primitive = None # (dx, dy) from final_agent_pos_before_use to primitive\n\n  while q:\n      (cx, cy), current_path_coords = q.popleft()\n\n      # Check if the current position is one of our target adjacent cells\n      for adj_pos, offset_to_prim in adjacent_to_primitive_candidates:\n          if (cx, cy) == adj_pos:\n              best_path_coords = current_path_coords\n              final_agent_pos_before_use = (cx, cy)\n              final_offset_to_primitive = offset_to_prim\n              break # Found the shortest path to an adjacent cell, exit BFS\n\n      if best_path_coords is not None:\n          break # Path found, stop BFS\n\n      # Explore neighbors\n      for (dx, dy) in MOVE_DELTAS: # Only care about movement deltas for pathfinding\n          nx, ny = cx + dx, cy + dy\n          if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n              # For simplicity, assume all grid cells are traversable for movement.\n              # A more complex scenario might check for obstacles (e.g., water, walls).\n              visited.add((nx, ny))\n              q.append(((nx, ny), current_path_coords + [(nx, ny)]))\n\n  if best_path_coords is None:\n      # No path found to any adjacent cell of the primitive\n      return []\n\n  # 7. Convert the coordinate path into a sequence of agent actions (movements and turns)\n  current_x, current_y = agent_pos\n  current_dir = agent_dir\n\n  for next_x, next_y in best_path_coords:\n      # Calculate the movement delta\n      dx_move, dy_move = next_x - current_x, next_y - current_y\n\n      if (dx_move, dy_move) in MOVE_DELTAS:\n          move_action, target_dir_for_move = MOVE_DELTAS[(dx_move, dy_move)]\n          \n          # Add turning actions to face the direction of movement\n          actions_list.extend(get_actions_to_turn(current_dir, target_dir_for_move))\n          \n          # Add the movement action itself\n          actions_list.append(move_action)\n          \n          # Update agent's current position and direction\n          current_x, current_y = next_x, next_y\n          current_dir = target_dir_for_move\n      # else: This case should not occur with a valid path constructed by BFS\n\n  # 8. Add the final USE action\n  # The agent is now at `final_agent_pos_before_use`, facing `current_dir`.\n  # It needs to turn to face the primitive (located at `tx, ty`) and then USE.\n  \n  primitive_dx, primitive_dy = final_offset_to_primitive\n  \n  if (primitive_dx, primitive_dy) in FACING_DELTAS_TO_DIR:\n      target_dir_for_use = FACING_DELTAS_TO_DIR[(primitive_dx, primitive_dy)]\n      \n      # Add turning actions to face the primitive\n      actions_list.extend(get_actions_to_turn(current_dir, target_dir_for_use))\n      \n      # Add the USE action\n      actions_list.append(USE)\n  # else: This case implies the offset is not a cardinal direction, which shouldn't happen.\n\n  return actions_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:20:41.144903", "function_name": "collect", "function_body": "  import numpy as np\n  import collections\n\n  # Get necessary info from the environment\n  obs = env.observations()\n  current_grid = obs['features_dict']['features_global']\n  current_pos = tuple(obs['features_dict']['pos']) # Agent's current position (x, y)\n  current_inventory = obs['features_dict']['inventory']\n\n  # Get world properties for obstacle checking\n  world = env.world # CraftWorld instance\n  non_grabbable_indices = world.non_grabbable_indices # set of int indices for non-walkable entities\n\n  actions_map = env.action_specs() # e.g., {'DOWN': 0, 'UP': 1, 'LEFT': 2, 'RIGHT': 3, 'USE': 4}\n\n  WIDTH, HEIGHT, N_KINDS = current_grid.shape\n\n  # Define movement deltas and their corresponding actions (assuming absolute directions)\n  # UP: decreases y, DOWN: increases y, LEFT: decreases x, RIGHT: increases x\n  move_deltas = {\n      (0, -1): actions_map['UP'],    # (dx, dy) for moving UP\n      (0, 1): actions_map['DOWN'],   # (dx, dy) for moving DOWN\n      (-1, 0): actions_map['LEFT'],  # (dx, dy) for moving LEFT\n      (1, 0): actions_map['RIGHT'],  # (dx, dy) for moving RIGHT\n  }\n\n  # 1. Check if the primitive is already in inventory\n  if current_inventory[primitive] > 0:\n      return [] # Already collected, no actions needed\n\n  # Helper function to check if a cell is walkable\n  def is_walkable(x, y):\n      # Check bounds\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return False \n      \n      # If no non-grabbable items are specified, all valid cells are walkable\n      if not non_grabbable_indices:\n          return True\n      \n      # Check if the cell contains any non-grabbable item\n      for kind_idx in non_grabbable_indices:\n          # Ensure kind_idx is within the bounds of N_KINDS\n          if kind_idx < N_KINDS and current_grid[x, y, kind_idx] == 1:\n              return False # Cell contains a non-grabbable item, so it's not walkable\n      return True\n\n  # 2. BFS Initialization\n  q = collections.deque()\n  visited = set()\n\n  # Each state in the queue is ((x, y), [list_of_actions_to_reach_here])\n  q.append((current_pos, []))\n  visited.add(current_pos)\n\n  # 3. BFS Loop\n  while q:\n      (cx, cy), path_actions = q.popleft()\n\n      # Check if the current position (cx, cy) allows collecting the primitive.\n      # According to CraftState.next_to, this means the primitive is in the 3x3 neighborhood,\n      # which includes the agent's current cell or any of its immediate 4-connected neighbors.\n      can_collect_now = False\n      \n      # Check the current cell itself for the primitive\n      if current_grid[cx, cy, primitive] == 1:\n          can_collect_now = True\n      else:\n          # Check immediate 4-connected adjacent cells for the primitive\n          for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              adj_x, adj_y = cx + dx_adj, cy + dy_adj\n              \n              if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n                  if current_grid[adj_x, adj_y, primitive] == 1:\n                      can_collect_now = True\n                      break # Found an adjacent primitive\n\n      if can_collect_now:\n          # If we can collect from this position, append the USE action and return the path\n          return path_actions + [actions_map['USE']]\n      \n      # If not collectable from current position, explore walkable neighbors for movement\n      for (dx_move, dy_move), action_val in move_deltas.items():\n          next_x, next_y = cx + dx_move, cy + dy_move\n          next_pos = (next_x, next_y)\n\n          # Only add to queue if within bounds, walkable, and not yet visited\n          if is_walkable(next_x, next_y) and next_pos not in visited:\n              visited.add(next_pos)\n              q.append((next_pos, path_actions + [action_val]))\n\n  # If the BFS queue becomes empty and no path to a collectable primitive was found\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:21:47.922269", "function_name": "collect", "function_body": "    import collections\n    from enum import IntEnum\n    import numpy as np\n\n    # Define actions using IntEnum for clarity and compatibility\n    class Action(IntEnum):\n        DOWN = 0\n        UP = 1\n        LEFT = 2\n        RIGHT = 3\n        USE = 4\n\n    # Agent directions (matching CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n    DIR_EAST = 0\n    DIR_SOUTH = 1\n    DIR_WEST = 2\n    DIR_NORTH = 3\n\n    # Maximum number of actions allowed for collection, including movements and the final USE.\n    # This acts as an inclusive upper bound for the total actions in the returned list.\n    MAX_COLLECT_STEPS = 100 \n\n    def _get_facing_coords(y, x, direction):\n        \"\"\"Returns the coordinates of the cell directly in front of (y,x) based on agent's direction.\"\"\"\n        if direction == DIR_EAST:\n            return y, x + 1\n        elif direction == DIR_SOUTH:\n            return y + 1, x\n        elif direction == DIR_WEST:\n            return y, x - 1\n        elif direction == DIR_NORTH:\n            return y - 1, x\n        return y, x # Fallback, should not be reached with valid directions\n\n    # Movement options: (action_id, resulting_facing_direction, dy, dx)\n    # Assumes agent faces the direction of its last movement.\n    MOVEMENT_OPTIONS = [\n        (Action.UP,    DIR_NORTH, -1, 0), # Move North (dy=-1, dx=0), agent faces North\n        (Action.DOWN,  DIR_SOUTH, 1, 0),  # Move South (dy=1, dx=0), agent faces South\n        (Action.LEFT,  DIR_WEST, 0, -1),  # Move West (dy=0, dx=-1), agent faces West\n        (Action.RIGHT, DIR_EAST, 0, 1)    # Move East (dy=0, dx=1), agent faces East\n    ]\n\n    actions_executed = [] # Stores the sequence of actions to be returned\n\n    # Reset the environment to get the initial state and access its internal CraftState.\n    # This ensures a consistent starting point for pathfinding from a fresh episode.\n    env.reset() \n    current_state = env._current_state \n\n    world = current_state.world\n    cookbook = world.cookbook\n\n    # Initial checks for early exit:\n    # 1. Is the primitive ID known to the cookbook?\n    if primitive not in cookbook.kinds:\n        return [] \n    # 2. Is the primitive already in the agent's inventory?\n    if current_state.inventory[primitive] > 0:\n        return [] \n\n    # Get the full grid from the initial state for pathfinding.\n    # This grid is assumed static for the purpose of finding a collection path.\n    full_grid = current_state.features_dict()['features_global']\n    grid_height, grid_width, _ = full_grid.shape\n    start_y, start_x = current_state.pos\n    start_dir = current_state.dir \n\n    # Determine which entity kinds are truly impassable for agent movement.\n    # Water is typically impassable. Non-grabbable items that are NOT workshops\n    # are also generally considered impassable to move INTO.\n    impassable_for_movement_indices = set()\n    if world.water_index in world.kinds: # Water is often a specific impassable type\n        impassable_for_movement_indices.add(world.water_index)\n    for k_idx in world.non_grabbable_indices:\n        # Workshops (e.g., crafting tables, furnaces) are non-grabbable but usually traversable.\n        # So, we exclude them from the impassable set for movement.\n        if k_idx not in world.workshop_indices:\n            impassable_for_movement_indices.add(k_idx)\n    \n    # Convert the set to a list for efficient NumPy indexing when checking grid cells.\n    impassable_for_movement_list = list(impassable_for_movement_indices) \n\n    # Breadth-First Search (BFS) Queue:\n    # Each state in the queue is (current_y, current_x, current_direction, path_of_movement_actions_so_far)\n    q = collections.deque()\n    q.append((start_y, start_x, start_dir, []))\n    \n    # Visited set: (y, x, dir) to avoid redundant exploration of the same agent state\n    # (position + orientation), ensuring the shortest path is found.\n    visited = {(start_y, start_x, start_dir)}\n\n    # This variable will store the complete sequence of actions (movements + final ACTION_USE)\n    # if a successful collection path is found.\n    final_collection_path = None \n\n    while q:\n        curr_y, curr_x, curr_dir, path = q.popleft()\n        \n        # Pruning check: If the current path of movement actions is already too long such that\n        # adding a final ACTION_USE would exceed MAX_COLLECT_STEPS, then this path is not viable.\n        # (len(path) is number of movement actions; +1 for the final USE action)\n        if len(path) >= MAX_COLLECT_STEPS:\n            continue\n\n        # --- Check if the current agent state allows for immediate collection of the primitive ---\n        \n        # Case 1: Agent is ON the primitive, and it's collectable by ACTION_USE from that cell.\n        # This typically applies to items like \"stone\" or \"wood\" scattered on the ground,\n        # which the agent can move onto and then collect.\n        if (primitive not in impassable_for_movement_indices and \n            full_grid[curr_y, curr_x, primitive] > 0):\n            final_collection_path = path + [Action.USE]\n            break # Path found, exit BFS\n\n        # Case 2: Primitive is cardinally adjacent to the agent, and the agent is facing it correctly.\n        # This applies to items like \"water\" or \"workbench\" that are collected/activated by\n        # using them from an adjacent tile while facing them.\n        facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n        # Check bounds for the cell directly in front of the agent.\n        if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width):\n            # Check if the cell directly in front contains the primitive.\n            if full_grid[facing_y, facing_x, primitive] > 0:\n                # Found a path that leads to a position AND ensures the agent is oriented correctly.\n                final_collection_path = path + [Action.USE]\n                break # Path found, exit BFS\n\n        # --- Explore neighboring cells for movement ---\n        # For each possible movement action (UP, DOWN, LEFT, RIGHT):\n        for action_move, new_dir_after_move, dy, dx in MOVEMENT_OPTIONS:\n            next_y, next_x = curr_y + dy, curr_x + dx\n\n            # Check bounds for the next potential movement cell.\n            if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                continue\n\n            # Check if the next cell is traversable. It must not contain any impassable kinds.\n            # Using np.any with the pre-converted list `impassable_for_movement_list` is efficient.\n            if impassable_for_movement_list and np.any(full_grid[next_y, next_x, impassable_for_movement_list] > 0):\n                continue\n            \n            # Form the new path by appending the current movement action.\n            new_path = path + [action_move]\n\n            # Before adding to the queue, ensure:\n            # 1. The new path's length (including the potential final USE action) does not exceed MAX_COLLECT_STEPS.\n            #    `len(new_path) < MAX_COLLECT_STEPS` allows for one more action (the USE action) later.\n            # 2. This specific (position, direction) state has not been visited before.\n            if len(new_path) < MAX_COLLECT_STEPS and (next_y, next_x, new_dir_after_move) not in visited:\n                visited.add((next_y, next_x, new_dir_after_move))\n                q.append((next_y, next_x, new_dir_after_move, new_path))\n    \n    # --- Execute the found path (if any) ---\n    if final_collection_path is None:\n        # If no valid path was found to reach a suitable collection state, return an empty list.\n        return [] \n\n    # Iterate through the planned actions and execute them in the environment.\n    for action in final_collection_path:\n        # Stop execution if the total number of actions already executed reaches the maximum limit.\n        # This acts as a safeguard, although the BFS pruning should ideally prevent paths that are too long.\n        if len(actions_executed) >= MAX_COLLECT_STEPS:\n            break \n\n        actions_executed.append(action)\n        # Step the environment with the current action.\n        # We ignore the reward and observation, but track the 'done' status for early termination.\n        _, done, _ = env.step(action) \n        current_state = env._current_state # Always update the internal state after a step\n\n        # Immediately check if the primitive has been successfully collected into inventory\n        # after executing the current action. This handles cases where the collection\n        # might occur mid-sequence (e.g., if the ACTION_USE was part of the optimal path).\n        if current_state.inventory[primitive] > 0:\n            return actions_executed # Primitive collected, return the actions taken.\n\n        # If the episode ends prematurely (e.g., ran out of internal steps in the DMLab wrapper)\n        # before the primitive was collected, then this path effectively failed.\n        if done:\n            return []\n    \n    # Final check: After attempting to execute all planned actions (or hitting the step limit),\n    # verify if the primitive is now in the agent's inventory.\n    if current_state.inventory[primitive] > 0:\n        return actions_executed # Primitive was collected.\n    else:\n        # If the primitive is still not in inventory after executing the path,\n        # it means collection failed (e.g., missing tool, resource depleted, path was invalid).\n        return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:21:48.899635", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n  import numpy as np\n\n  # Define actions using IntEnum for clarity and compatibility\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  # Agent directions (matching CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"Returns the coordinates of the cell directly in front of (y,x) based on agent's direction.\"\"\"\n      if direction == DIR_EAST:\n          return y, x + 1\n      elif direction == DIR_SOUTH:\n          return y + 1, x\n      elif direction == DIR_WEST:\n          return y, x - 1\n      elif direction == DIR_NORTH:\n          return y - 1, x\n      return y, x # Should not be reached with valid directions\n\n  # Mapping of movement action to (resulting_facing_direction, dy, dx)\n  # Assumes agent faces the direction of its last movement.\n  MOVEMENT_MAP = {\n      Action.UP:    (DIR_NORTH, -1, 0), # Move North (dy=-1, dx=0), agent faces North\n      Action.DOWN:  (DIR_SOUTH, 1, 0),  # Move South (dy=1, dx=0), agent faces South\n      Action.LEFT:  (DIR_WEST, 0, -1),  # Move West (dy=0, dx=-1), agent faces West\n      Action.RIGHT: (DIR_EAST, 0, 1)    # Move East (dy=0, dx=1), agent faces East\n  }\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state and access its internal CraftState,\n  # ensuring a consistent starting point for pathfinding.\n  env.reset() \n  current_state = env._current_state \n\n  world = current_state.world\n  cookbook = world.cookbook\n\n  # Initial checks for early exit\n  if primitive not in cookbook.kinds:\n      # The specified primitive ID is not a recognized kind in the world.\n      return [] \n  if current_state.inventory[primitive] > 0:\n      # The primitive has already been collected or is present in inventory.\n      return [] \n\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir # Use the agent's current direction from the reset state\n\n  # Determine truly impassable kinds for agent movement.\n  # These are entities the agent cannot move *onto*. Workshops are non-grabbable but typically traversable.\n  impassable_for_movement = set(world.non_grabbable_indices).difference(world.workshop_indices)\n  impassable_for_movement_list = list(impassable_for_movement) # Convert to list for numpy indexing\n\n  # Breadth-First Search (BFS) to find a path.\n  # BFS state: (current_y, current_x, current_direction)\n  q = collections.deque()\n  q.append((start_y, start_x, start_dir))\n  \n  # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n  visited = {(start_y, start_x, start_dir)}\n\n  # Parent map to reconstruct the path: {(y, x, dir): (parent_y, parent_x, parent_dir, action_to_reach_this_node)}\n  parent_map = {} \n  final_bfs_state = None # This will store the (y, x, dir) state where the primitive can be collected\n\n  # A counter for the number of steps in the BFS path to prune overly long searches.\n  # This is a bit of a heuristic for BFS without storing the full path in queue nodes,\n  # but it works effectively with the parent_map as well.\n  # dist is a map from (y,x,dir) to path length\n  dist = {(start_y, start_x, start_dir): 0}\n\n  while q:\n      curr_y, curr_x, curr_dir = q.popleft()\n      current_path_length = dist[(curr_y, curr_x, curr_dir)]\n      \n      # Pruning: If the current path is already too long (reserving at least 1 step for ACTION_USE), skip.\n      if current_path_length >= MAX_COLLECT_STEPS - 1: # -1 to leave space for final USE action\n          continue\n\n      # --- GOAL CHECK 1: Primitive is on the current cell and agent can pick it up directly ---\n      # This applies if the agent can move onto the primitive's cell and collect it (e.g., ground items like stone/wood).\n      # We ensure the primitive itself is not considered impassable for movement to reach this state.\n      if (primitive not in impassable_for_movement and \n          full_grid[curr_y, curr_x, primitive] > 0):\n          final_bfs_state = (curr_y, curr_x, curr_dir)\n          break # Path found, exit BFS\n\n      # --- GOAL CHECK 2: Primitive is cardinally adjacent AND agent is facing it correctly ---\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Check bounds for the cell directly in front of the agent\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width):\n          # Check if the cell directly in front contains the primitive\n          if full_grid[facing_y, facing_x, primitive] > 0:\n              # Found a path that leads to a position AND ensures the agent is oriented correctly.\n              final_bfs_state = (curr_y, curr_x, curr_dir)\n              break # Path found, exit BFS\n\n      # --- Explore neighboring cells for movement ---\n      for action_move, (new_dir_after_move, dy, dx) in MOVEMENT_MAP.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Check bounds for the next movement cell\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the next cell is traversable (i.e., does not contain any impassable kinds)\n          # Use numpy.any for efficient check against the list of impassable kinds.\n          if impassable_for_movement_list and np.any(full_grid[next_y, next_x, impassable_for_movement_list] > 0):\n              continue\n          \n          # Add to queue only if this new state (position and direction) hasn't been visited\n          if (next_y, next_x, new_dir_after_move) not in visited:\n              visited.add((next_y, next_x, new_dir_after_move))\n              q.append((next_y, next_x, new_dir_after_move))\n              parent_map[(next_y, next_x, new_dir_after_move)] = (curr_y, curr_x, curr_dir, action_move)\n              dist[(next_y, next_x, new_dir_after_move)] = current_path_length + 1\n  \n  # --- Path Reconstruction ---\n  if final_bfs_state is None:\n      # No valid path was found to reach a position/orientation suitable for collection.\n      return [] \n\n  path_to_primitive_and_use = []\n  curr = final_bfs_state\n  start_state = (start_y, start_x, start_dir)\n\n  # Reconstruct the path backwards from the final state to the start state\n  while curr != start_state:\n      if curr not in parent_map:\n          # This should ideally not happen if final_bfs_state was reached via BFS\n          # but acts as a safeguard against corrupted parent_map.\n          return [] \n      \n      parent_y, parent_x, parent_dir, action_to_reach_curr = parent_map[curr]\n      path_to_primitive_and_use.append(action_to_reach_curr)\n      curr = (parent_y, parent_x, parent_dir)\n  \n  path_to_primitive_and_use.reverse() # Path is now from start to final_bfs_state\n  path_to_primitive_and_use.append(Action.USE) # Add the final USE action\n\n  # --- Execute the found path ---\n  # Prune the path if it's too long before execution\n  if len(path_to_primitive_and_use) > MAX_COLLECT_STEPS:\n      return []\n\n  for action in path_to_primitive_and_use:\n      actions_taken.append(action)\n      # Step the environment with the current action.\n      # We ignore reward, but track the 'done' status for early termination.\n      _, done, _ = env.step(action) \n      current_state = env._current_state # Always update the internal state after a step\n\n      # Check if the primitive has been collected after this step.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken # Successfully collected!\n\n      # If the episode ends prematurely (e.g., ran out of steps internally)\n      # before collecting, then this path failed.\n      if done:\n          return []\n  \n  # If the loop completes (all planned actions executed) and the primitive is not in inventory,\n  # it means collection failed.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken # Successfully collected after last step\n  else:\n      return [] # Collection failed after executing the path.", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:23:27.013989", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants (from CraftLab.action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      ACTION_UP: DIR_NORTH,   # Moves North, faces North\n      ACTION_DOWN: DIR_SOUTH, # Moves South, faces South\n      ACTION_LEFT: DIR_WEST,  # Moves West, faces West\n      ACTION_RIGHT: DIR_EAST  # Moves East, faces East\n  }\n\n  # (dy, dx) change for each movement action\n  ACTION_TO_DELTA = {\n      ACTION_UP:    (-1, 0), # Move North (row decreases)\n      ACTION_DOWN:  (1, 0),  # Move South (row increases)\n      ACTION_LEFT:  (0, -1), # Move West (column decreases)\n      ACTION_RIGHT: (0, 1)   # Move East (column increases)\n  }\n\n  # Mapping of target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction to collect that target via ACTION_USE.\n  # This focuses on cardinal directions, as ACTION_USE typically applies to what's directly in front.\n  RELATIVE_TARGET_TO_REQUIRED_DIR = {\n      (-1, 0): DIR_NORTH, # Target is North of agent, agent must face North\n      (1, 0): DIR_SOUTH,  # Target is South of agent, agent must face South\n      (0, -1): DIR_WEST,  # Target is West of agent, agent must face West\n      (0, 1): DIR_EAST    # Target is East of agent, agent must face East\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to check if a cell is traversable for agent movement\n  def _is_cell_traversable(grid, y, x, world, impassable_kinds_for_movement):\n      grid_height, grid_width, _ = grid.shape\n      if not (0 <= y < grid_height and 0 <= x < grid_width):\n          return False # Out of bounds\n\n      for k_idx in impassable_kinds_for_movement:\n          if grid[y, x, k_idx] > 0:\n              return False # Contains an impassable object\n      return True\n\n  # Helper to get the cell directly in front of the agent (where USE applies)\n  def _get_cell_in_front(y, x, direction):\n      if direction == DIR_EAST: return y, x + 1\n      if direction == DIR_SOUTH: return y + 1, x\n      if direction == DIR_WEST: return y, x - 1\n      if direction == DIR_NORTH: return y - 1, x\n      return None # Invalid direction\n\n  # Breadth-First Search (BFS) to find a path to the primitive, ensuring the agent\n  # ends up at a position AND orientation suitable for collection.\n  def _find_path_and_collection_point(start_pos, start_dir, full_grid, primitive_id, world, max_steps):\n      grid_height, grid_width, _ = full_grid.shape\n      \n      # Determine truly impassable kinds for agent movement:\n      # These are entities the agent cannot move onto.\n      impassable_for_movement = set()\n      if world.water_index in world.kinds:\n          impassable_for_movement.add(world.water_index)\n      \n      # Other non-grabbable items are impassable, UNLESS they are workshops (which are traversable)\n      for k_idx in world.non_grabbable_indices:\n          if k_idx not in world.workshop_indices:\n              impassable_for_movement.add(k_idx)\n\n      # BFS state: (current_y, current_x, current_dir, path_of_actions)\n      q = collections.deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      while q:\n          curr_y, curr_x, curr_dir, path_actions = q.popleft()\n          \n          # Prune paths that are already too long (reserving at least 1 step for ACTION_USE)\n          if len(path_actions) >= max_steps - 1:\n              continue\n\n          # --- Goal Check 1: Primitive is on the current cell and agent can stand on it ---\n          # This assumes that if an agent is on a cell containing a collectible primitive,\n          # a USE action could collect it.\n          if (full_grid[curr_y, curr_x, primitive_id] > 0 and\n              _is_cell_traversable(full_grid, curr_y, curr_x, world, impassable_for_movement)):\n              # Found a path where agent is on the primitive cell.\n              # (0,0) indicates target is at agent's current position (relative).\n              return (path_actions, (0, 0)) \n\n          # --- Goal Check 2: Primitive is cardinally adjacent AND agent is facing it correctly ---\n          for rel_dy, rel_dx in RELATIVE_TARGET_TO_REQUIRED_DIR.keys(): \n              adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n              # Check bounds for the adjacent cell\n              if not (0 <= adj_y < grid_height and 0 <= adj_x < grid_width):\n                  continue\n\n              # Check if the adjacent cell contains the primitive\n              if full_grid[adj_y, adj_x, primitive_id] > 0:\n                  # Primitive found at (adj_y, adj_x). Now, verify agent's orientation.\n                  required_dir_for_collection = RELATIVE_TARGET_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n                  if curr_dir == required_dir_for_collection:\n                      # Found a path that leads to a position AND ensures the agent is oriented correctly.\n                      return (path_actions, (rel_dy, rel_dx))\n\n          # --- Explore neighboring cells for movement ---\n          for action_move, (dy_move, dx_move) in ACTION_TO_DELTA.items():\n              new_dir_after_move = ACTION_TO_DIR[action_move]\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n              if not _is_cell_traversable(full_grid, next_y, next_x, world, impassable_for_movement):\n                  continue\n              \n              # Add to queue only if this new state (position and direction) hasn't been visited\n              if (next_y, next_x, new_dir_after_move) not in visited:\n                  visited.add((next_y, next_x, new_dir_after_move))\n                  q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n      return (None, None) # No path found to the primitive with correct orientation\n\n\n  actions_taken = []\n  \n  # DO NOT reset the environment. Operate on the current state from the environment.\n  current_state = env._current_state \n\n  # Initial checks for early exit\n  if primitive not in current_state.world.cookbook.kinds:\n      # The specified primitive ID is not a recognized kind in the world.\n      return [] \n  if current_state.inventory[primitive] > 0:\n      # The primitive has already been collected or is present in inventory.\n      return [] \n\n  full_grid = current_state.features_dict()['features_global']\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  \n  # Find the sequence of movements and the relative target coordinates for collection.\n  path_of_moves, relative_target_coords = _find_path_and_collection_point(\n      start_pos, start_dir, full_grid, primitive, current_state.world, MAX_COLLECT_STEPS\n  )\n\n  if path_of_moves is None:\n      # No valid path was found to reach a position/orientation suitable for collection.\n      return [] \n\n  # Execute the found path of movements\n  for action in path_of_moves:\n      actions_taken.append(action)\n      # Step the environment with the current action.\n      # We ignore reward and done status for this function's goal, but update state.\n      _, done, _ = env.step(action) \n      current_state = env._current_state # Always update the internal state after a step\n\n      # If the episode ends prematurely before collecting, return empty.\n      if done and current_state.inventory[primitive] <= 0:\n          return []\n\n\n  # After executing all movement actions, the agent should be at the correct position\n  # and facing the correct direction as determined by the BFS. Now, perform the USE action.\n  \n  # Before attempting USE, verify the primitive is still at the expected location.\n  # This adds robustness against potential dynamic environment changes (though CraftWorld's\n  # grid typically remains static during these steps).\n  grid_height, grid_width, _ = full_grid.shape \n  is_primitive_reachable_by_use = False\n\n  if relative_target_coords == (0,0):\n      # Target is on the current cell (agent is standing on it)\n      if (0 <= current_state.pos[0] < grid_height and\n          0 <= current_state.pos[1] < grid_width and\n          current_state.grid[current_state.pos[0], current_state.pos[1], primitive] > 0):\n          is_primitive_reachable_by_use = True\n  else:\n      # Target is adjacent to the current cell, in the direction agent is facing.\n      # Double-check that the agent's current direction matches the required direction for this target.\n      expected_dir = RELATIVE_TARGET_TO_REQUIRED_DIR.get(relative_target_coords)\n      if expected_dir is not None and current_state.dir == expected_dir:\n          target_cell_y, target_cell_x = _get_cell_in_front(current_state.pos[0], current_state.pos[1], current_state.dir)\n          if (target_cell_y is not None and\n              0 <= target_cell_y < grid_height and 0 <= target_cell_x < grid_width and\n              current_state.grid[target_cell_y, target_cell_x, primitive] > 0):\n              is_primitive_reachable_by_use = True\n\n  if is_primitive_reachable_by_use:\n      # If the primitive is still present and reachable, append and execute the ACTION_USE.\n      if len(actions_taken) < MAX_COLLECT_STEPS: # Ensure there's still capacity for the USE action\n          actions_taken.append(ACTION_USE)\n          _, done, _ = env.step(ACTION_USE)\n          current_state = env._current_state # Update state after USE\n\n          # Final verification: Confirm the primitive was successfully collected into inventory.\n          if current_state.inventory[primitive] > 0:\n              return actions_taken # Successfully collected!\n          elif done:\n              # Episode ended right after the USE action, and primitive not collected.\n              return []\n          else:\n              # Collection failed even after reaching and attempting USE, and episode didn't end.\n              # This could happen if a tool is needed, or the resource depleted, etc.\n              return [] \n      else:\n          # Max steps reached, no space left for the final USE action.\n          return [] \n  else:\n      # Discrepancy: BFS found a path, but primitive is not in the expected location for collection\n      # after executing the path. This indicates a stale plan or dynamic environment changes not\n      # accounted for in the initial static grid planning, or BFS logic error.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:23:27.995358", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  # Define constants locally for clarity and self-containment, mimicking typical DMLab Craft actions\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      ACTION_UP: DIR_NORTH,\n      ACTION_DOWN: DIR_SOUTH,\n      ACTION_LEFT: DIR_WEST,\n      ACTION_RIGHT: DIR_EAST\n  }\n\n  # Mapping of target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction to collect that target via ACTION_USE.\n  # This focuses on cardinal directions, as ACTION_USE typically applies to what's directly in front.\n  RELATIVE_TO_REQUIRED_DIR = {\n      (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n      (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n      (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n      (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  def _get_cell_in_front(pos, direction):\n      \"\"\"Returns the coordinates (y, x) of the cell directly in front of the agent.\"\"\"\n      y, x = pos\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return None # Should not happen with valid directions\n\n  def _find_path_and_collection_strategy(start_pos, start_dir, full_grid, primitive_id, world, max_steps_budget):\n      \"\"\"\n      Finds a path of actions and the strategy (on-cell or adjacent-facing)\n      to collect the primitive.\n\n      Returns: (list_of_movement_actions, collection_strategy_tuple)\n      collection_strategy_tuple:\n          - (0,0) if primitive is on the final agent cell.\n          - (dy, dx) relative to agent if primitive is adjacent and agent needs to face it.\n          - None if no path found.\n      \"\"\"\n      grid_height, grid_width, _ = full_grid.shape\n      \n      # Determine truly impassable kinds for agent movement.\n      # Workshops are generally traversable.\n      impassable_for_movement = set()\n      for k_idx in world.non_grabbable_indices:\n          if k_idx not in world.workshop_indices: # Workshops are usually traversable\n              impassable_for_movement.add(k_idx)\n      # Water is always impassable if present\n      if world.water_index in world.kinds:\n          impassable_for_movement.add(world.water_index)\n\n      # A primitive is \"traversable\" if the agent can stand on its cell.\n      primitive_is_traversable_by_agent = primitive_id not in impassable_for_movement\n\n      # BFS state: (current_y, current_x, current_dir, path_of_actions)\n      q = collections.deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n      moves_options = [\n          (-1, 0, ACTION_UP, DIR_NORTH),\n          (1, 0, ACTION_DOWN, DIR_SOUTH),\n          (0, -1, ACTION_LEFT, DIR_WEST),\n          (0, 1, ACTION_RIGHT, DIR_EAST)\n      ]\n\n      while q:\n          curr_y, curr_x, curr_dir, path_actions = q.popleft()\n          \n          # Check path length limit for *movement actions*.\n          # We need at least one slot for the final ACTION_USE.\n          if len(path_actions) >= max_steps_budget - 1:\n              continue # This path is already too long to allow for a USE action\n\n          # --- Goal Check 1: Primitive is on the current cell and agent can pick it up directly ---\n          # This covers cases where the agent literally stands on the item to pick it up.\n          if (primitive_is_traversable_by_agent and\n              full_grid[curr_y, curr_x, primitive_id] > 0):\n              return (path_actions, (0, 0)) # Found on current cell\n\n          # --- Goal Check 2: Primitive is cardinally adjacent AND agent is facing it correctly ---\n          for rel_dy, rel_dx in RELATIVE_TO_REQUIRED_DIR.keys(): \n              adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n              if not (0 <= adj_y < grid_height and 0 <= adj_x < grid_width):\n                  continue\n\n              if full_grid[adj_y, adj_x, primitive_id] > 0:\n                  required_dir_for_collection = RELATIVE_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n                  if curr_dir == required_dir_for_collection:\n                      return (path_actions, (rel_dy, rel_dx)) # Found adjacent, facing correctly\n\n          # --- Explore neighboring cells for movement ---\n          for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if the next cell contains any impassable kinds\n              is_traversable_cell = True\n              for k_idx in impassable_for_movement:\n                  if full_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable_cell = False\n                      break\n              if not is_traversable_cell:\n                  continue\n              \n              # Add to queue only if this new state (position and direction) hasn't been visited\n              if (next_y, next_x, new_dir_after_move) not in visited:\n                  visited.add((next_y, next_x, new_dir_after_move))\n                  q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n      return (None, None) # No path found meeting the criteria\n\n  actions_taken = []\n  \n  # DO NOT reset the environment. Operate on the current state.\n  current_state = env._current_state \n\n  # Initial checks for early exit\n  if primitive not in current_state.world.cookbook.kinds:\n      # The specified primitive ID is not a recognized kind in the world.\n      return [] \n  if current_state.inventory[primitive] > 0:\n      # The primitive has already been collected or is present in inventory.\n      return [] \n\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  \n  # Find the sequence of movements and the collection strategy.\n  path_of_moves, collection_strategy = _find_path_and_collection_strategy(\n      start_pos, start_dir, full_grid, primitive, current_state.world, MAX_COLLECT_STEPS\n  )\n\n  if path_of_moves is None:\n      # No valid path was found to reach a position/orientation suitable for collection.\n      return [] \n\n  # Execute the found path of movements\n  for action in path_of_moves:\n      if len(actions_taken) >= MAX_COLLECT_STEPS: # Check before appending to prevent exceeding\n          return [] # Budget exhausted, cannot even complete movements\n\n      actions_taken.append(action)\n      # Step the environment with the current action.\n      # We ignore reward and done status for this function's goal, but update state.\n      _, done, _ = env.step(action) \n      current_state = env._current_state # Always update the internal state after a step\n\n      # If the episode ends prematurely AND primitive not collected, return empty.\n      if done and current_state.inventory[primitive] <= 0:\n          return []\n\n      # If the primitive was collected during movement (e.g., walked over it), return early.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n  # After executing all movement actions, attempt the final USE action.\n  if len(actions_taken) >= MAX_COLLECT_STEPS:\n      return [] # No budget left for the final USE action\n\n  # Before USE, re-verify the primitive's presence at the expected collection point\n  # using the *latest* grid state.\n  \n  # Determine the target cell based on the determined strategy and current state\n  target_y, target_x = -1, -1 # Invalid default\n  if collection_strategy == (0, 0): # Primitive is on the agent's current cell\n      target_y, target_x = current_state.pos\n  else: # Primitive is adjacent, agent needs to face it\n      target_y, target_x = _get_cell_in_front(current_state.pos, current_state.dir)\n  \n  # Verify target cell exists and contains the primitive\n  primitive_still_at_target = False\n  if (target_y is not None and\n      0 <= target_y < grid_height and 0 <= target_x < grid_width and\n      current_state.grid[target_y, target_x, primitive] > 0):\n      primitive_still_at_target = True\n\n  if primitive_still_at_target:\n      actions_taken.append(ACTION_USE)\n      _, done, _ = env.step(ACTION_USE)\n      current_state = env._current_state # Update state after USE\n\n      # Final verification: Confirm the primitive was successfully collected into inventory.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken # Successfully collected!\n      elif done:\n          # Episode ended right after the USE action, and primitive not collected.\n          return []\n      else:\n          # Collection failed even after reaching and attempting USE, and episode didn't end.\n          # This could happen if a tool is needed, or the resource depleted, etc.\n          return [] \n  else:\n      # Discrepancy: Path was found, but primitive is not in the expected location for collection\n      # after executing the path. This indicates a stale plan or dynamic environment changes not\n      # accounted for in the initial static grid planning.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:25:03.110683", "function_name": "collect", "function_body": "  actions_list = []\n  action_map = env.action_specs()\n\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Get the initial state from the environment\n  # The `CraftLab` instance stores the current `CraftState` in `_current_state`.\n  current_state = env._current_state\n\n  # Check if the primitive is already in inventory at the start\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  # Get grid dimensions for iterating through the grid\n  grid_width, grid_height, _ = current_state.grid.shape\n\n  MAX_COLLECT_STEPS = 200  # Safety limit to prevent infinite loops\n\n  steps_taken = 0\n  # Continue as long as the primitive is not in inventory and we haven't exceeded max steps\n  while current_state.inventory[primitive] == 0 and steps_taken < MAX_COLLECT_STEPS:\n    current_pos = current_state.pos\n    \n    # 1. Find all locations where the primitive exists on the current grid\n    primitive_locs = []\n    for x in range(grid_width):\n      for y in range(grid_height):\n        if current_state.grid[x, y, primitive] == 1:\n          primitive_locs.append((x, y))\n    \n    # If no primitive is found on the grid, it's unreachable or doesn't exist.\n    # Break the loop and return the actions collected so far.\n    if not primitive_locs:\n        break\n\n    # 2. Find the closest primitive location using Manhattan distance\n    min_dist = float('inf')\n    target_x, target_y = -1, -1\n    for loc_x, loc_y in primitive_locs:\n      dist = abs(loc_x - current_pos[0]) + abs(loc_y - current_pos[1])\n      if dist < min_dist:\n        min_dist = dist\n        target_x, target_y = loc_x, loc_y\n\n    # 3. Decide the next action: USE if adjacent/on, otherwise move towards target\n    action_to_take = None\n    \n    # CraftState.next_to checks the 3x3 neighborhood, which typically includes the agent's current cell.\n    if current_state.next_to(primitive):\n      action_to_take = ACTION_USE\n    else:\n      # If not adjacent, move towards the target\n      cx, cy = current_pos\n      dx = target_x - cx\n      dy = target_y - cy\n\n      # Prioritize horizontal movement if the horizontal difference is greater or equal\n      # and there is a horizontal difference to cover.\n      if abs(dx) >= abs(dy) and dx != 0:\n        action_to_take = ACTION_RIGHT if dx > 0 else ACTION_LEFT\n      elif dy != 0: # If dx is 0 or smaller, move vertically if there's a vertical difference\n        action_to_take = ACTION_DOWN if dy > 0 else ACTION_UP\n      # If dx and dy are both 0, it means current_pos == target_pos,\n      # which should have been handled by `current_state.next_to(primitive)`\n      # condition or implies an unmovable obstacle. In this simple greedy pathfinding,\n      # we'd break if no action can be taken.\n\n    # Execute the chosen action and simulate the state change\n    if action_to_take is not None:\n      actions_list.append(action_to_take)\n      # Simulate the step on the CraftState object to get the next state.\n      # The step method returns (reward, new_state). We only need the new_state.\n      _, current_state = current_state.step(action_to_take)\n    else:\n      # No valid action could be determined (e.g., agent is stuck or target unreachable).\n      break\n    \n    steps_taken += 1\n\n  return actions_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:25:03.180296", "function_name": "collect", "function_body": "    # Constants for actions\n    A_DOWN = 0\n    A_UP = 1\n    A_LEFT = 2\n    A_RIGHT = 3\n    A_USE = 4\n\n    # Mappings for movements and resulting directions (action: (dx, dy, new_dir_after_move))\n    # Agent's direction aligns with the cardinal direction of movement after taking a move action.\n    MOVE_ACTIONS_DATA = {\n        A_UP: (0, -1, 0),    # Move North (dx=0, dy=-1), new_dir=0 (North)\n        A_RIGHT: (1, 0, 1),  # Move East (dx=1, dy=0), new_dir=1 (East)\n        A_DOWN: (0, 1, 2),   # Move South (dx=0, dy=1), new_dir=2 (South)\n        A_LEFT: (-1, 0, 3)   # Move West (dx=-1, dy=0), new_dir=3 (West)\n    }\n\n    # Direction vectors for USE action (dir: (dx, dy) relative to agent pos)\n    # The USE action applies to the cell in the direction the agent is currently facing.\n    USE_TARGET_VECS = {\n        0: (0, -1),  # Facing North\n        1: (1, 0),   # Facing East\n        2: (0, 1),   # Facing South\n        3: (-1, 0)   # Facing West\n    }\n\n    # Helper function for Breadth-First Search (BFS) to find a path to the primitive.\n    # This function is nested to keep all completion code within `collect_v2`.\n    # It assumes `np` (numpy) and `deque` (from collections) are available in the scope.\n    def _find_path_to_collect_primitive_bfs(start_pos, start_dir, initial_grid, primitive_idx, blocking_indices_set, workshop_indices_set):\n        WIDTH, HEIGHT, N_KINDS = initial_grid.shape\n\n        q = deque([(start_pos, start_dir, [])]) # Queue: ( (curr_x, curr_y), curr_dir, path_actions_so_far )\n        visited = set([(start_pos, start_dir)]) # Set to keep track of visited states ((x,y), dir)\n\n        while q:\n            (curr_x, curr_y), curr_dir, path = q.popleft()\n\n            # Check if performing the USE action from current state would collect the primitive.\n            # Calculate the coordinates of the cell directly in front of the agent.\n            use_dx, use_dy = USE_TARGET_VECS[curr_dir]\n            target_x, target_y = curr_x + use_dx, curr_y + use_dy\n\n            # If the target cell is within bounds and contains the primitive,\n            # we've found a path to collect it.\n            if (0 <= target_x < WIDTH and 0 <= target_y < HEIGHT and\n                initial_grid[target_x, target_y, primitive_idx] > 0):\n                return path + [A_USE] # Append USE action and return the complete path\n\n            # Explore possible movement actions from the current state.\n            for action, (dx, dy, new_dir) in MOVE_ACTIONS_DATA.items():\n                next_x, next_y = curr_x + dx, curr_y + dy\n\n                # Check if the next position is within the grid boundaries.\n                if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                    continue\n\n                # Determine if the next cell is blocked (i.e., contains an impassable object).\n                is_blocked = False\n                # Iterate through all kinds of entities that might be at the next cell.\n                for k_idx in range(N_KINDS):\n                    if initial_grid[next_x, next_y, k_idx] > 0: # If this kind of entity is present\n                        if k_idx in blocking_indices_set:\n                            # If it's a non-grabbable item and NOT a workshop, it's blocked.\n                            is_blocked = True\n                            break\n                        # Agents can move onto workshop cells, even if they are non-grabbable.\n                        # So, if k_idx is in workshop_indices_set, it's not considered blocked.\n\n                if is_blocked:\n                    continue # Skip this move if the cell is blocked\n\n                # If the next state ((next_x, next_y), new_dir) has not been visited yet,\n                # add it to the queue for exploration.\n                if ((next_x, next_y), new_dir) not in visited:\n                    q.append(((next_x, next_y), new_dir, path + [action]))\n                    visited.add(((next_x, next_y), new_dir))\n        \n        return None # No path to the primitive was found after exploring all reachable states\n\n    # --- Main logic for collect_v2 function ---\n\n    # Access the current state of the environment.\n    # `env` is an instance of `CraftLab`. We access its internal `_current_state` (CraftState).\n    current_state = env._current_state \n    \n    # Check if the primitive is already in the agent's inventory.\n    # If it is, no actions are needed.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Extract relevant information from the current state for pathfinding.\n    initial_grid = current_state.grid\n    start_pos = current_state.pos\n    start_dir = current_state.dir\n    \n    # Get configuration from the CraftWorld instance linked to the environment.\n    world_config = env.world \n    \n    # Determine which entities block movement.\n    # These are non-grabbable items that are NOT workshops (as agents can typically stand on workshops).\n    blocking_indices_set = {k for k in world_config.non_grabbable_indices if k not in world_config.workshop_indices}\n    workshop_indices_set = set(world_config.workshop_indices) # Convert list to set for efficient lookups\n\n    # Call the BFS helper to find the sequence of actions.\n    actions_to_collect = _find_path_to_collect_primitive_bfs(\n        start_pos, start_dir, initial_grid, primitive, blocking_indices_set, workshop_indices_set\n    )\n\n    # Return the found actions or an empty list if no path was found.\n    if actions_to_collect is None:\n        return []\n    else:\n        return actions_to_collect", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:26:44.910059", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants based on CraftLab.action_specs\n  # These mappings are fixed as per the CraftLab interface.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Define change in (x, y) coordinates for each movement action\n  # Assumes grid indexing is (x, y) where x is horizontal (column) and y is vertical (row).\n  # The grid `current_grid` is of shape (WIDTH, HEIGHT, n_kinds), meaning `current_grid[x, y, k]`.\n  # Agent position `current_pos` is also (x, y).\n  _ACTION_DXDY = {\n      UP: (0, -1),   # UP: x remains, y decreases\n      DOWN: (0, 1),  # DOWN: x remains, y increases\n      LEFT: (-1, 0), # LEFT: x decreases, y remains\n      RIGHT: (1, 0), # RIGHT: x increases, y remains\n  }\n\n  # 1. Get current state information from the environment\n  obs = env.observations()\n  current_grid = obs['features_dict']['features_global']\n  \n  # Extract grid dimensions from the grid's shape\n  grid_width, grid_height, _ = current_grid.shape\n  \n  # Convert normalized agent position (from features_dict) to integer grid coordinates\n  # The normalized position typically ranges from 0 to 1 based on the maximum coordinate value.\n  current_pos_normalized = obs['features_dict']['pos']\n  current_pos = (int(round(current_pos_normalized[0] * (grid_width - 1))),\n                 int(round(current_pos_normalized[1] * (grid_height - 1))))\n  \n  current_inventory = obs['features_dict']['inventory']\n\n  # 2. Check if the primitive is already in the inventory\n  if current_inventory[primitive] > 0:\n      return [] # Primitive is already collected, no actions needed\n\n  # List to store the sequence of actions to be returned\n  actions = []\n  \n  # Get indices of entities that block agent movement (obstacles)\n  # `env.world` provides access to the CraftWorld instance and its configurations.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  water_index = env.world.water_index\n  \n  # Create a combined set of all indices that represent obstacles for agent movement.\n  # This set includes non-grabbable items (like water, workshops) and, importantly,\n  # the `primitive` itself, because the agent cannot move *onto* a cell containing\n  # the primitive, but rather *next to* it to `USE` it.\n  obstacle_indices = non_grabbable_indices.union({water_index, primitive})\n\n  # Breadth-First Search (BFS) for pathfinding\n  # The queue stores tuples: ((current_x, current_y), [list_of_actions_to_reach_here])\n  q = collections.deque([(current_pos, [])])\n  # Set of visited (x, y) coordinates to prevent cycles and re-exploring paths\n  visited = {current_pos} \n\n  target_found = False\n  best_path = [] # Stores the shortest path of movement actions\n\n  while q:\n      (curr_x, curr_y), path = q.popleft()\n\n      # Check if the current agent position is adjacent to the primitive\n      # The agent needs to be in a cell from which it can \"use\" the primitive.\n      # `CraftState.next_to` checks a 3x3 neighborhood centered around the agent.\n      # So, if any cell within the 3x3 square (including the current cell) contains the primitive,\n      # then `(curr_x, curr_y)` is a valid \"target\" position for the agent to `USE` from.\n      is_adjacent_to_primitive = False\n      for dx_adj in [-1, 0, 1]:\n          for dy_adj in [-1, 0, 1]:\n              adj_x, adj_y = curr_x + dx_adj, curr_y + dy_adj\n\n              # Boundary check for the adjacent cell\n              if not (0 <= adj_x < grid_width and 0 <= adj_y < grid_height):\n                  continue\n              \n              # Check if the adjacent cell contains the primitive.\n              # Note: `primitive` is treated as a *target to find* here, not an obstacle to avoid.\n              if current_grid[adj_x, adj_y, primitive] > 0:\n                  is_adjacent_to_primitive = True\n                  break # Found primitive in neighborhood\n          if is_adjacent_to_primitive:\n              break # Found primitive in neighborhood\n\n      if is_adjacent_to_primitive:\n          # A path has been found to a cell from which the agent can collect the primitive.\n          best_path = path\n          target_found = True\n          break # Shortest path found, exit BFS\n\n      # Explore neighbor cells by simulating movement actions (UP, DOWN, LEFT, RIGHT)\n      for action_type, (dx, dy) in _ACTION_DXDY.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # Boundary check for the next cell\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Check if the next cell is blocked by any obstacle kind.\n          # `obstacle_indices` correctly includes the primitive itself, preventing movement directly onto it.\n          is_blocked = False\n          for idx in obstacle_indices:\n              if current_grid[next_x, next_y, idx] > 0:\n                  is_blocked = True\n                  break\n          \n          if is_blocked:\n              continue # Cannot move onto this cell, try other directions\n\n          # If the cell is not blocked and has not been visited yet, add it to the queue\n          if next_pos not in visited:\n              visited.add(next_pos)\n              q.append((next_pos, path + [action_type]))\n\n  if target_found:\n      # If a path was successfully found, append the USE action after all movement actions.\n      actions = best_path + [USE]\n  else:\n      # If no path could be found (e.g., primitive is unreachable or not present on grid),\n      # return an empty list of actions.\n      actions = [] \n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:26:44.979272", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants from CraftLab / CraftState\n    # These correspond to the integer values expected by env.step()\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Map movement actions to (dx, dy) deltas\n    # This determines how the agent's position changes for each move action.\n    ACTION_TO_DELTA = {\n        UP: (0, -1),\n        DOWN: (0, 1),\n        LEFT: (-1, 0),\n        RIGHT: (1, 0)\n    }\n\n    # Map CraftState.dir (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT) to (dx, dy) deltas\n    # This is used to determine what direction a CraftState.dir value represents\n    # for checking if the agent is facing a target.\n    CRAFTSTATE_DIR_TO_DELTA = {\n        0: (0, 1),  # DOWN\n        1: (0, -1), # UP\n        2: (-1, 0), # LEFT\n        3: (1, 0)   # RIGHT\n    }\n\n    current_state = env._current_state # Access the internal CraftState object for detailed state\n\n    # 1. Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    grid_width, grid_height, _ = current_state.grid.shape\n    # Get the set of indices for entities that block movement (non-grabbable items)\n    # We assume any cell containing a non-grabbable item cannot be walked upon.\n    non_grabbable_indices = current_state.world.non_grabbable_indices\n\n    def is_traversable(x, y, grid, obstacles, width, height):\n        \"\"\"\n        Checks if a cell (x, y) is within bounds and free of obstacles.\n        An obstacle is any entity listed in `obstacles`.\n        \"\"\"\n        # Check bounds\n        if not (0 <= x < width and 0 <= y < height):\n            return False\n        # Check if the cell is occupied by any obstacle\n        for k_idx in obstacles:\n            if grid[x, y, k_idx] > 0:\n                return False\n        return True\n\n    # 2. Find all locations on the grid where the target primitive exists\n    target_locations = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if current_state.grid[x, y, primitive] > 0:\n                target_locations.append((x, y))\n\n    if not target_locations:\n        return [] # Primitive not found anywhere on the map\n\n    # 3. Use Breadth-First Search (BFS) to find the shortest path\n    # BFS state: ((current_x, current_y), current_direction, list_of_actions_taken)\n    q = collections.deque([((current_state.pos), current_state.dir, [])])\n    # Visited set to keep track of (position, direction) pairs to avoid cycles and redundant paths\n    visited = {((current_state.pos), current_state.dir)}\n\n    while q:\n        curr_pos, curr_dir, path_actions = q.popleft()\n        curr_x, curr_y = curr_pos\n\n        # Check if the current position is adjacent to any target primitive AND facing it correctly\n        for target_x, target_y in target_locations:\n            dx, dy = target_x - curr_x, target_y - curr_y\n\n            if abs(dx) + abs(dy) == 1: # Check if (curr_x, curr_y) is adjacent to (target_x, target_y)\n                # Check if the agent's current direction (curr_dir) is pointing towards the target\n                if CRAFTSTATE_DIR_TO_DELTA.get(curr_dir) == (dx, dy):\n                    # Path found! Add the USE action and return the full sequence.\n                    return path_actions + [USE]\n\n        # Explore possible movement actions (UP, DOWN, LEFT, RIGHT)\n        for action_val, (delta_x, delta_y) in ACTION_TO_DELTA.items():\n            next_x, next_y = curr_x + delta_x, curr_y + delta_y\n            new_pos = (next_x, next_y)\n            \n            # When the agent takes a movement action (e.g., UP), its internal direction\n            # automatically updates to match that movement direction.\n            # So, the new_dir is simply the action_val itself (for movement actions).\n            new_dir = action_val \n\n            if is_traversable(next_x, next_y, current_state.grid, non_grabbable_indices, grid_width, grid_height):\n                # If this (new_pos, new_dir) state hasn't been visited yet\n                if (new_pos, new_dir) not in visited:\n                    visited.add((new_pos, new_dir))\n                    q.append((new_pos, new_dir, path_actions + [action_val]))\n\n    # If the BFS queue is exhausted and no path to collect the primitive was found\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:27:46.919168", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # --- Action and Direction Constants ---\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Maps movement vectors (dx, dy) to the corresponding action ID.\n  # These actions move the agent and set its facing direction.\n  MOVE_VECTOR_TO_ACTION = {\n      (0, -1): ACTION_UP,    # Move North\n      (0, 1): ACTION_DOWN,   # Move South\n      (-1, 0): ACTION_LEFT,  # Move West\n      (1, 0): ACTION_RIGHT   # Move East\n  }\n\n  # Maps the agent's internal direction ID (0-3) to its facing vector (dx, dy).\n  # 0: North (-Y), 1: East (+X), 2: South (+Y), 3: West (-X)\n  DIRECTION_ID_TO_FACING_VECTOR = {\n      0: (0, -1),  # North\n      1: (1, 0),   # East\n      2: (0, 1),   # South\n      3: (-1, 0)   # West\n  }\n\n  # Maps a movement vector to the resulting internal direction ID.\n  # When the agent moves, its facing direction becomes aligned with the movement.\n  MOVE_VECTOR_TO_RESULTING_DIRECTION_ID = {\n      (0, -1): 0,  # Moving North results in facing North\n      (1, 0): 1,   # Moving East results in facing East\n      (0, 1): 2,   # Moving South results in facing South\n      (-1, 0): 3   # Moving West results in facing West\n  }\n\n  # --- Generic Breadth-First Search (BFS) Helper ---\n  def _find_path_bfs(start_state, is_goal_func, get_neighbors_func):\n      \"\"\"\n      Generic BFS implementation to find the shortest path from a start_state\n      to any state satisfying `is_goal_func`.\n\n      Args:\n          start_state: The initial state for the BFS. A state is typically a tuple\n                       representing (agent_position, agent_direction).\n          is_goal_func: A callable `is_goal_func(state)` that returns True if the\n                        given state is a goal state, False otherwise.\n          get_neighbors_func: A callable `get_neighbors_func(state)` that returns\n                              an iterable of `(neighbor_state, action_to_reach_neighbor)`\n                              tuples from the current state.\n\n      Returns:\n          A list of actions representing the path from start_state to a goal state,\n          or None if no path is found.\n      \"\"\"\n      queue = collections.deque([(start_state)])\n      visited = {start_state}\n      # path_parent_map: (child_state) -> (parent_state, action_taken_to_reach_child)\n      path_parent_map = {}\n\n      target_found_state = None\n\n      while queue:\n          current_state = queue.popleft()\n\n          if is_goal_func(current_state):\n              target_found_state = current_state\n              break  # Shortest path found to a goal state\n\n          # Explore possible next states (neighbors)\n          for next_state, action_to_reach_next in get_neighbors_func(current_state):\n              if next_state not in visited:\n                  visited.add(next_state)\n                  path_parent_map[next_state] = (current_state, action_to_reach_next)\n                  queue.append(next_state)\n\n      # If a target state was found, reconstruct the path by backtracking\n      if target_found_state:\n          actions_path = []\n          current = target_found_state\n          while current != start_state:\n              parent, action = path_parent_map[current]\n              actions_path.append(action)\n              current = parent\n          return actions_path[::-1]  # Reverse to get actions in chronological order\n      \n      return None  # No path found\n\n  # --- Initial State Extraction ---\n  obs = env.observations()\n  initial_grid = obs['features_dict']['features_global']\n  initial_position = tuple(obs['features_dict']['pos'].astype(int))\n  initial_direction_id = np.argmax(obs['features_dict']['direction'])\n  initial_inventory = obs['features_dict']['inventory']\n\n  # Early exit: If the primitive is already in the inventory, no actions are needed.\n  if initial_inventory[primitive] > 0:\n      return []\n\n  grid_width, grid_height, _ = initial_grid.shape\n  # Indices of entities that block agent movement (cannot be walked through).\n  impassable_entity_indices = env.world.non_grabbable_indices\n\n  # --- Helper Functions for Grid and State Checks ---\n\n  def _is_within_bounds(x, y):\n      \"\"\"Checks if the given (x, y) coordinates are inside the grid boundaries.\"\"\"\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  def _is_cell_traversable(x, y):\n      \"\"\"\n      Checks if the cell at (x, y) is traversable by the agent.\n      A cell is non-traversable if it's out of bounds or contains an impassable entity.\n      \"\"\"\n      if not _is_within_bounds(x, y):\n          return False\n      for entity_idx in impassable_entity_indices:\n          if initial_grid[x, y, entity_idx] > 0:\n              return False  # Cell contains an obstacle\n      return True  # Cell is clear for movement\n\n  # --- Define BFS Components for Primitive Collection ---\n\n  # The start state for the BFS is the agent's initial position and direction.\n  # State representation: ((x, y), direction_id)\n  start_bfs_state = (initial_position, initial_direction_id)\n\n  def is_goal_for_collection(state):\n      \"\"\"\n      Defines a goal state for the BFS: where the primitive is directly in front\n      of the agent, allowing it to be collected with ACTION_USE.\n      \"\"\"\n      (curr_x, curr_y), curr_dir = state\n      facing_vector = DIRECTION_ID_TO_FACING_VECTOR[curr_dir]\n      front_x, front_y = curr_x + facing_vector[0], curr_y + facing_vector[1]\n      \n      # The primitive must be in the cell directly in front and that cell must be within bounds.\n      return _is_within_bounds(front_x, front_y) and initial_grid[front_x, front_y, primitive] > 0\n\n  def get_neighbors_for_movement(current_state):\n      \"\"\"\n      Generates possible next states (agent positions and directions) by performing\n      movement actions (UP, DOWN, LEFT, RIGHT).\n      \"\"\"\n      (curr_x, curr_y), _ = current_state  # Current direction not used for generating *moves*\n      neighbors = []\n      \n      for move_vec, action_id in MOVE_VECTOR_TO_ACTION.items():\n          next_x, next_y = curr_x + move_vec[0], curr_y + move_vec[1]\n          next_pos = (next_x, next_y)\n          # The agent's direction changes to match the direction of its movement.\n          next_dir = MOVE_VECTOR_TO_RESULTING_DIRECTION_ID[move_vec]\n          next_state = (next_pos, next_dir)\n\n          if _is_cell_traversable(next_x, next_y):\n              neighbors.append((next_state, action_id))\n      return neighbors\n\n  # --- Execute BFS and Reconstruct Path ---\n\n  # Find the shortest sequence of movement actions to reach a state from which\n  # the 'USE' action can successfully collect the primitive.\n  path_to_pre_use = _find_path_bfs(\n      start_bfs_state,\n      is_goal_for_collection,\n      get_neighbors_for_movement\n  )\n\n  # If a path was found, append the final 'USE' action to the sequence.\n  if path_to_pre_use is not None:\n      return path_to_pre_use + [ACTION_USE]\n  else:\n      # If no path to the primitive was found (e.g., it's unreachable), return an empty list.\n      return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:27:47.909446", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement vectors (dx, dy) to action IDs.\n  # These actions move the agent AND set its facing direction.\n  MOVE_VECTOR_TO_ACTION = {\n      (0, -1): ACTION_UP,    # Move North, face North\n      (0, 1): ACTION_DOWN,   # Move South, face South\n      (-1, 0): ACTION_LEFT,  # Move West, face West\n      (1, 0): ACTION_RIGHT   # Move East, face East\n  }\n\n  # Map agent's internal direction ID to its corresponding facing vector (dx, dy).\n  # 0: North (-Y), 1: East (+X), 2: South (+Y), 3: West (-X)\n  DIR_ID_TO_FACING_VECTOR = {\n      0: (0, -1),  # North\n      1: (1, 0),   # East\n      2: (0, 1),   # South\n      3: (-1, 0)   # West\n  }\n\n  # Map movement vector to the resulting internal direction ID.\n  # When the agent moves, its facing direction updates to match the direction of movement.\n  MOVE_VECTOR_TO_RESULTING_DIRECTION_ID = {\n      (0, -1): 0,  # Moving North results in facing North.\n      (1, 0): 1,   # Moving East results in facing East.\n      (0, 1): 2,   # Moving South results in facing South.\n      (-1, 0): 3   # Moving West results in facing West.\n  }\n\n  def _bfs_find_path_internal(start_node, is_goal_func, get_neighbors_func):\n      \"\"\"\n      Generic BFS implementation to find the shortest path from a start_node\n      to any node that satisfies is_goal_func.\n      \n      Args:\n          start_node: The initial node for the BFS.\n          is_goal_func: A callable `is_goal_func(node)` that returns True if `node` is a goal.\n          get_neighbors_func: A callable `get_neighbors_func(node)` that returns an iterable\n                              of `(neighbor_node, action_to_reach_neighbor)`.\n                              \n      Returns:\n          A list of actions representing the path from start_node to a goal node,\n          or None if no path is found.\n      \"\"\"\n      queue = collections.deque([(start_node)])\n      visited = {start_node}\n      parent_map = {} # (child_node) -> (parent_node, action_taken_to_reach_child)\n\n      target_found_node = None\n\n      while queue:\n          current_node = queue.popleft()\n\n          if is_goal_func(current_node):\n              target_found_node = current_node\n              break\n\n          for next_node, action_to_reach_next in get_neighbors_func(current_node):\n              if next_node not in visited:\n                  visited.add(next_node)\n                  parent_map[next_node] = (current_node, action_to_reach_next)\n                  queue.append(next_node)\n      \n      if target_found_node:\n          actions_path = []\n          current = target_found_node\n          while current != start_node:\n              parent, action = parent_map[current]\n              actions_path.append(action)\n              current = parent\n          return actions_path[::-1]\n      \n      return None\n\n  # Get initial observations and extract relevant state information\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  start_pos = tuple(obs['features_dict']['pos'].astype(int))\n  start_dir = np.argmax(obs['features_dict']['direction']) # Convert one-hot direction to int (0-3)\n\n  grid_width, grid_height, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a coordinate is within grid bounds\n  def _is_within_bounds(x, y):\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  # Helper function to check if a cell is traversable.\n  # A cell is not traversable if it's out of bounds or contains any non-grabbable entity.\n  def _is_cell_traversable(x, y):\n      if not _is_within_bounds(x, y):\n          return False\n      for idx in non_grabbable_indices:\n          if grid[x, y, idx] > 0:\n              return False # Contains an obstacle\n      return True # Traversable\n\n  # --- Define BFS specific components for CraftWorld ---\n\n  # The BFS state is represented as ((x, y), direction_id)\n  start_bfs_state = (start_pos, start_dir)\n\n  # Goal function: True if the primitive is in the cell directly in front of the agent\n  def is_goal_for_primitive_collection(state):\n      (curr_x, curr_y), curr_dir = state\n      facing_vec = DIR_ID_TO_FACING_VECTOR[curr_dir]\n      front_x, front_y = curr_x + facing_vec[0], curr_y + facing_vec[1]\n      \n      return _is_within_bounds(front_x, front_y) and grid[front_x, front_y, primitive] > 0\n\n  # Neighbor generation function: possible moves from current state\n  def get_movement_neighbors(current_state):\n      (curr_x, curr_y), _ = current_state # Current direction is not needed for generating moves, only for goal check\n      neighbors = []\n      \n      for move_vec, action_id in MOVE_VECTOR_TO_ACTION.items():\n          next_x, next_y = curr_x + move_vec[0], curr_y + move_vec[1]\n          next_pos = (next_x, next_y)\n          next_dir = MOVE_VECTOR_TO_RESULTING_DIRECTION_ID[move_vec] # Direction changes with movement\n          next_state_key = (next_pos, next_dir)\n\n          if _is_cell_traversable(next_x, next_y):\n              neighbors.append((next_state_key, action_id))\n      return neighbors\n\n  # Use the generic BFS to find the path to a state from which 'ACTION_USE' can collect the primitive\n  path_to_pre_use_state = _bfs_find_path_internal(\n      start_bfs_state, \n      is_goal_for_primitive_collection, \n      get_movement_neighbors\n  )\n\n  # If a path was found, append the 'ACTION_USE' and return\n  if path_to_pre_use_state is not None:\n      return path_to_pre_use_state + [ACTION_USE]\n  else:\n      # If no path was found to any position adjacent to the primitive, return an empty list\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:29:40.977579", "function_name": "collect", "function_body": "    import collections\n    import numpy as np # Already globally imported, but good practice to show dependency if not guaranteed.\n\n    # Action constants, based on CraftLab.action_specs\n    # These integer values are standard for DMLab-style environments.\n    DOWN_ACTION = 0\n    UP_ACTION = 1\n    LEFT_ACTION = 2\n    RIGHT_ACTION = 3\n    USE_ACTION = 4\n\n    # Get the initial CraftState object from the CraftLab environment.\n    # If the environment has not been reset yet, reset it to get an initial state.\n    start_state = env._current_state\n    if start_state is None:\n        env.reset()\n        start_state = env._current_state\n\n    # Check if the primitive is already in the inventory in the initial state.\n    # If so, no actions are needed to collect it.\n    if start_state.inventory[primitive] > 0:\n        return []\n\n    # Initialize the Breadth-First Search (BFS) queue.\n    # Each element in the queue is a tuple: (CraftState object, list of actions taken to reach this state).\n    q = collections.deque([(start_state, [])])\n\n    # Initialize the set of visited states to avoid redundant exploration and cycles.\n    # A state is uniquely defined by the agent's position, direction, and its inventory.\n    # Using a tuple of the inventory makes it hashable for the set.\n    visited = set()\n    visited.add((start_state.pos, start_state.dir, tuple(start_state.inventory)))\n\n    # Define the actions that primarily move the agent.\n    move_actions = [DOWN_ACTION, UP_ACTION, LEFT_ACTION, RIGHT_ACTION]\n\n    # Set a maximum number of steps to prevent infinite loops in cases\n    # where no path exists or the state space is extremely large.\n    MAX_SEARCH_STEPS = 1000 \n\n    while q:\n        current_state, current_actions = q.popleft()\n\n        # Pruning: If the current path length exceeds the maximum allowed steps,\n        # this path is too long or indicates an unresolvable situation within limits.\n        if len(current_actions) >= MAX_SEARCH_STEPS:\n            continue\n\n        # Primary Goal Check: If the primitive is now in the current state's inventory,\n        # we have successfully found a path to collect it. Return the sequence of actions.\n        if current_state.inventory[primitive] > 0:\n            return current_actions\n\n        # --- Explore the 'USE' action ---\n        # The 'USE' action can be crucial for collecting primitives that are obtained by\n        # interacting with environment objects (e.g., chopping a tree for wood, mining for stone).\n        # Simulate the 'USE' action from the current state. `CraftState.step` returns (reward, new_state).\n        _, new_state_use = current_state.step(USE_ACTION)\n        \n        # Create a hashable key for the new state after attempting the 'USE' action.\n        new_state_key_use = (new_state_use.pos, new_state_use.dir, tuple(new_state_use.inventory))\n\n        # If this new state has not been visited before (i.e., it represents a novel outcome).\n        if new_state_key_use not in visited:\n            # Check if performing the 'USE' action resulted in collecting the primitive\n            # (i.e., its count in the inventory increased).\n            if new_state_use.inventory[primitive] > current_state.inventory[primitive]:\n                # If the goal is achieved by this 'USE' action, return the path including it.\n                return current_actions + [USE_ACTION]\n            \n            # If 'USE' didn't achieve the immediate goal (collecting the primitive) but\n            # led to a new, unexplored state (e.g., consumed ingredients, produced other items,\n            # or simply didn't do anything but we still want to record the attempt),\n            # add this new state to the queue for further exploration.\n            visited.add(new_state_key_use)\n            q.append((new_state_use, current_actions + [USE_ACTION]))\n\n        # --- Explore movement actions (DOWN, UP, LEFT, RIGHT) ---\n        for action in move_actions:\n            # Simulate each movement action.\n            _, new_state_move = current_state.step(action)\n            \n            # Create a hashable key for the new state after movement.\n            new_state_key_move = (new_state_move.pos, new_state_move.dir, tuple(new_state_move.inventory))\n\n            # If this new state has not been visited before, add it to the queue.\n            if new_state_key_move not in visited:\n                # No immediate goal check is needed here, as any new state will be\n                # checked for the primitive in inventory at the top of the next iteration's loop.\n                visited.add(new_state_key_move)\n                q.append((new_state_move, current_actions + [action]))\n\n    # If the queue becomes empty and the goal (collecting the primitive) has not been reached,\n    # it means no path was found within the exploration limits.\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:29:41.048436", "function_name": "collect", "function_body": "    import collections\n\n    # Constants for actions\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    # Mapping direction deltas (dx, dy) to actions.\n    # Based on CraftState.step logic where agent's position `pos` is `(x, y)`:\n    # UP: (x, y-1) -> delta (0, -1)\n    # DOWN: (x, y+1) -> delta (0, 1)\n    # LEFT: (x-1, y) -> delta (-1, 0)\n    # RIGHT: (x+1, y) -> delta (1, 0)\n    DELTA_TO_ACTION = {\n        (0, -1): UP,\n        (0, 1): DOWN,\n        (-1, 0): LEFT,\n        (1, 0): RIGHT\n    }\n    POSSIBLE_DELTAS = list(DELTA_TO_ACTION.keys())\n\n    # 1. Reset environment and get initial state information.\n    # Resetting the environment ensures that the planning starts from a consistent state\n    # (the initial state of the scenario). This also populates env._current_state.\n    _ = env.reset(seed=0) \n\n    current_state = env._current_state\n    grid = current_state.grid\n    initial_pos = current_state.pos\n    inventory = current_state.inventory\n    \n    # If the primitive is already in inventory, no actions are needed.\n    if inventory[primitive] > 0:\n        return []\n\n    world = env.world # Access the CraftWorld instance for configuration.\n    non_grabbable_indices = world.non_grabbable_indices # Indices of items that block movement.\n    \n    # Get grid dimensions. The grid shape is (WIDTH, HEIGHT, n_kinds).\n    GRID_WIDTH, GRID_HEIGHT, _ = grid.shape \n\n    # 2. Find all locations of the primitive on the grid.\n    primitive_locations = []\n    for x in range(GRID_WIDTH):\n        for y in range(GRID_HEIGHT):\n            if grid[x, y, primitive] > 0: # Check if primitive exists at (x,y)\n                primitive_locations.append((x, y))\n\n    # If the primitive is not found anywhere on the map, return an empty plan.\n    if not primitive_locations:\n        return []\n\n    # 3. Perform a Breadth-First Search (BFS) to find the shortest path\n    #    to a cell adjacent to any instance of the primitive.\n    # The queue stores tuples: (current_position (x,y), path_taken_to_reach_here (list of actions)).\n    q = collections.deque([(initial_pos, [])]) \n    visited = {initial_pos} # Set of visited (x,y) positions to prevent cycles and redundant exploration.\n\n    while q:\n        (curr_x, curr_y), path = q.popleft()\n\n        # Check if the current position is adjacent to any primitive location.\n        for prim_x, prim_y in primitive_locations:\n            # Manhattan distance of 1 means horizontal or vertical adjacency.\n            if abs(curr_x - prim_x) + abs(curr_y - prim_y) == 1:\n                # Found a path to an adjacent cell. Append the USE action and return the complete path.\n                return path + [USE]\n\n        # Explore valid neighboring cells.\n        for dx, dy in POSSIBLE_DELTAS:\n            next_x, next_y = curr_x + dx, curr_y + dy\n\n            # Check if the next position is within grid boundaries.\n            if not (0 <= next_x < GRID_WIDTH and 0 <= next_y < GRID_HEIGHT):\n                continue\n\n            # Check if the next position has already been visited.\n            if (next_x, next_y) in visited:\n                continue\n\n            # Check traversability: A cell is traversable if it does not contain\n            # any non-grabbable item.\n            is_traversable = True\n            for kind_idx in non_grabbable_indices:\n                if grid[next_x, next_y, kind_idx] > 0: # If this cell contains a non-grabbable item.\n                    is_traversable = False\n                    break\n            \n            # If the cell is traversable, add it to the queue for further exploration.\n            if is_traversable:\n                visited.add((next_x, next_y))\n                q.append(((next_x, next_y), path + [DELTA_TO_ACTION[(dx, dy)]]))\n    \n    # If the BFS completes and no path was found to an adjacent cell\n    # (e.g., the primitive is unreachable due to obstacles or not present),\n    # return an empty list of actions.\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:31:37.524769", "function_name": "collect", "function_body": "  # Constants for actions, as implied by the action_specs() in CraftLab\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  current_state = env._current_state\n  grid = current_state.grid\n  inventory = current_state.inventory\n  current_pos = current_state.pos # (px, py)\n  px, py = current_pos\n  WIDTH, HEIGHT, _ = grid.shape # grid.shape[2] is n_kinds\n\n  # 1. Check if the primitive is already in the inventory\n  if inventory[primitive] > 0:\n    return []\n\n  # 2. Find all locations of the primitive on the grid\n  target_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # A cell contains the primitive if its value in the primitive layer is 1\n      if grid[x, y, primitive] == 1:\n        target_locations.append((x, y))\n\n  if not target_locations:\n    # Primitive not found on grid, so it cannot be collected\n    return []\n\n  # 3. Find the closest target location on the grid to the agent's current position\n  closest_target = None\n  min_dist_to_target = float('inf')\n  for tx, ty in target_locations:\n    # Use Manhattan distance as a simple heuristic\n    dist = abs(tx - px) + abs(ty - py)\n    if dist < min_dist_to_target:\n      min_dist_to_target = dist\n      closest_target = (tx, ty)\n\n  # `closest_target` will not be None here because `target_locations` was checked\n  tx, ty = closest_target\n\n  # 4. Find the best adjacent cell for the agent to move to\n  # The `USE` action works based on `CraftState.next_to`, which checks the 3x3 neighborhood.\n  # So, the agent needs to move to any cell adjacent to (tx, ty) (including diagonally).\n  best_adjacent_agent_pos = None\n  min_dist_to_agent_pos = float('inf')\n\n  # Iterate through all cells in the 3x3 neighborhood of (tx, ty)\n  # This includes the target cell itself, as the agent might already be on it.\n  for ox in [-1, 0, 1]:\n    for oy in [-1, 0, 1]:\n      ax, ay = tx + ox, ty + oy\n\n      # Ensure the potential agent position is within grid boundaries\n      if not (0 <= ax < WIDTH and 0 <= ay < HEIGHT):\n        continue\n\n      # Calculate Manhattan distance from agent's current position to this potential adjacent cell\n      dist_to_agent_pos = abs(ax - px) + abs(ay - py)\n\n      # Prioritize closer cells. If distances are equal, the first found is fine.\n      if dist_to_agent_pos < min_dist_to_agent_pos:\n        min_dist_to_agent_pos = dist_to_agent_pos\n        best_adjacent_agent_pos = (ax, ay)\n\n  if best_adjacent_agent_pos is None:\n    # This can happen if the target is completely surrounded by non-traversable cells,\n    # or if the grid is 1x1 and the target is the only cell.\n    return []\n\n  final_agent_x, final_agent_y = best_adjacent_agent_pos\n\n  # 5. Generate movement actions to reach (final_agent_x, final_agent_y)\n  actions = []\n  current_agent_x, current_agent_y = px, py\n\n  # Simple pathfinding: move horizontally then vertically. This is a greedy approach\n  # and assumes an open grid where direct paths are possible without obstacles.\n  while current_agent_x != final_agent_x:\n    if current_agent_x < final_agent_x:\n      actions.append(ACTION_RIGHT)\n      current_agent_x += 1\n    else: # current_agent_x > final_agent_x\n      actions.append(ACTION_LEFT)\n      current_agent_x -= 1\n\n  while current_agent_y != final_agent_y:\n    if current_agent_y < final_agent_y:\n      actions.append(ACTION_DOWN) # Assuming Y-axis increases downwards (common for grid arrays)\n      current_agent_y += 1\n    else: # current_agent_y > final_agent_y\n      actions.append(ACTION_UP) # Assuming Y-axis decreases upwards\n      current_agent_y -= 1\n\n  # 6. Once the agent is at an adjacent (or same) position, perform the USE action\n  # This will cause collection if the primitive is grabbable or interaction if non-grabbable.\n  actions.append(ACTION_USE)\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:31:38.487238", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  actions = []\n\n  # Get current state\n  state = env._current_state\n  \n  # Check if primitive already in inventory\n  if state.inventory[primitive] > 0:\n      return []\n\n  grid = state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n  current_pos = state.pos\n  current_dir = state.dir # 0:N, 1:E, 2:S, 3:W (DMLab Craft conventions)\n  \n  action_map = env.action_specs() # e.g., {'DOWN':0, 'UP':1, 'LEFT':2, 'RIGHT':3, 'USE':4}\n  \n  # Define cardinal directions (DMLab Craft conventions)\n  _DIR_NORTH = 0 \n  _DIR_EAST = 1  \n  _DIR_SOUTH = 2 \n  _DIR_WEST = 3  \n\n  # Mapping from move action value to ((delta_r, delta_c), resulting_direction)\n  _MOVE_DELTAS_AND_DIRS = {\n      action_map['UP']: ((-1, 0), _DIR_NORTH),\n      action_map['DOWN']: ((1, 0), _DIR_SOUTH),\n      action_map['LEFT']: ((0, -1), _DIR_WEST),\n      action_map['RIGHT']: ((0, 1), _DIR_EAST),\n  }\n\n  # Mapping from direction to (delta_r, delta_c) for adjacent cells\n  _ADJACENT_COORDS = {\n      _DIR_NORTH: (-1, 0),\n      _DIR_EAST: (0, 1),\n      _DIR_SOUTH: (1, 0),\n      _DIR_WEST: (0, -1),\n  }\n\n  # Precompute turn actions from current_dir to target_dir using shortest path\n  _TURN_ACTIONS = {}\n  for start_dir in range(4):\n      _TURN_ACTIONS[start_dir] = {}\n      for end_dir in range(4):\n          if start_dir == end_dir:\n              _TURN_ACTIONS[start_dir][end_dir] = []\n          elif (start_dir + 1) % 4 == end_dir: # Right turn\n              _TURN_ACTIONS[start_dir][end_dir] = [action_map['RIGHT']]\n          elif (start_dir + 3) % 4 == end_dir: # Left turn\n              _TURN_ACTIONS[start_dir][end_dir] = [action_map['LEFT']]\n          else: # 180 degree turn\n              _TURN_ACTIONS[start_dir][end_dir] = [action_map['RIGHT'], action_map['RIGHT']] \n\n  # Determine if primitive is grabbable (picked up by walking over) or needs USE action\n  is_grabbable = primitive in env.world.grabbable_indices\n  \n  # BFS state: (current_r, current_c, current_dir, path_actions_to_reach_this_state)\n  queue = collections.deque([(current_pos[0], current_pos[1], current_dir, [])])\n  visited = set([(current_pos[0], current_pos[1], current_dir)])\n  \n  target_found_info = None # Stores (final_r, final_c, final_dir_at_pos, final_actions_at_target_pos)\n\n  while queue:\n      r, c, d, path_so_far = queue.popleft()\n\n      # Check if the primitive is at the current location or an adjacent one\n      if is_grabbable:\n          if grid[r, c, primitive] > 0:\n              # Primitive is grabbable and at agent's current location (r,c)\n              # Just need to walk onto it. The path_so_far already leads to (r,c).\n              target_found_info = (r, c, d, []) \n              break\n      else: # Not grabbable, needs USE action while adjacent\n          # Check all 4 adjacent cells for the primitive\n          for target_dir, (dr, dc) in _ADJACENT_COORDS.items(): \n              nr, nc = r + dr, c + dc # Location of the primitive\n              \n              if 0 <= nr < WIDTH and 0 <= nc < HEIGHT:\n                  if grid[nr, nc, primitive] > 0:\n                      # Found the primitive at (nr, nc), and agent is at (r, c)\n                      # Agent needs to face (nr, nc) from (r, c) and then USE.\n                      \n                      # Get actions to turn from current direction 'd' to face 'target_dir'\n                      turn_actions = _TURN_ACTIONS[d][target_dir]\n                      \n                      target_found_info = (r, c, target_dir, turn_actions + [action_map['USE']])\n                      break # Found the closest harvestable\n          if target_found_info:\n              break # Break outer loop if target found\n\n      # Explore neighbors by moving\n      for move_action, ((dr, dc), new_dir) in _MOVE_DELTAS_AND_DIRS.items():\n          nr, nc = r + dr, c + dc # New potential agent position\n          \n          if 0 <= nr < WIDTH and 0 <= nc < HEIGHT:\n              # Check for obstacles: cells containing non-grabbable items that are not the target primitive itself\n              is_obstacle = False\n              for k_idx in env.world.non_grabbable_indices:\n                  # If the non-grabbable item is the primitive we're looking for, it's not an obstacle\n                  # for pathfinding, as we might need to walk *onto* it if it were grabbable,\n                  # or adjacent to it if it needs USE. The BFS must traverse such cells.\n                  if k_idx == primitive: \n                      continue \n                  if grid[nr, nc, k_idx] > 0: # If cell contains other non-grabbable item (e.g., wall)\n                      is_obstacle = True\n                      break\n              \n              if not is_obstacle:\n                  if (nr, nc, new_dir) not in visited:\n                      visited.add((nr, nc, new_dir))\n                      queue.append((nr, nc, new_dir, path_so_far + [move_action]))\n\n  if not target_found_info:\n      return [] # Primitive not found or unreachable\n\n  # Unpack the found info\n  final_r, final_c, final_dir_at_pos, final_actions = target_found_info\n  \n  # The path_so_far at this point is the path to (final_r, final_c) with correct final_dir_at_pos.\n  # We just need to append the final interaction actions.\n  return path_so_far + final_actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:33:23.389935", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants (based on CraftLab.action_specs())\n  _DOWN_ACTION = 0\n  _UP_ACTION = 1\n  _LEFT_ACTION = 2\n  _RIGHT_ACTION = 3\n  _USE_ACTION = 4\n\n  # Define properties for movement actions: (dx, dy, new_facing_direction)\n  # Assuming CraftState's `dir` attribute maps: 0=North (Up), 1=East (Right), 2=South (Down), 3=West (Left)\n  # And that moving in a direction sets the agent's facing direction to that direction.\n  _ACTION_PROPERTIES = {\n      _UP_ACTION: (0, -1, 0),   # Move up (decrease y), face North (dir 0)\n      _DOWN_ACTION: (0, 1, 2),    # Move down (increase y), face South (dir 2)\n      _LEFT_ACTION: (-1, 0, 3),  # Move left (decrease x), face West (dir 3)\n      _RIGHT_ACTION: (1, 0, 1),   # Move right (increase x), face East (dir 1)\n  }\n\n  # Relative deltas for each direction: (dx, dy)\n  # Used to determine the coordinates of a cell adjacent to the agent, based on facing direction.\n  _DIR_DELTAS = {\n      0: (0, -1),  # North\n      1: (1, 0),   # East\n      2: (0, 1),   # South\n      3: (-1, 0),  # West\n  }\n\n  initial_state = env._current_state\n  initial_grid = initial_state.grid\n  WIDTH, HEIGHT, _ = initial_grid.shape\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction\n\n  # Determine the collection method (direct pickup or USE action)\n  is_direct_pickup = False\n  target_grid_kind_idx = -1 # The kind index of the object on the grid to interact with\n\n  # 1. Check if the 'primitive' (the item to be collected) is a direct grabbable item\n  if primitive in env.world.grabbable_indices:\n      is_direct_pickup = True\n      target_grid_kind_idx = primitive # We're looking for the primitive itself on the grid\n  else:\n      # 2. If not directly grabbable, check for special 'USE' cases (e.g., water, stone from sources)\n      # We need to map the 'primitive' (the collected item) to its 'source' object on the grid.\n      # This mapping assumes 'water' item comes from `env.world.water_index` source, etc.\n      source_kind_map = {}\n      # Retrieve the item IDs for 'water' and 'stone' from the world's index, if they exist.\n      water_item_id = env.world.index.contents.get('water')\n      stone_item_id = env.world.index.contents.get('stone')\n\n      if water_item_id is not None and water_item_id == primitive:\n          source_kind_map[primitive] = env.world.water_index\n      elif stone_item_id is not None and stone_item_id == primitive:\n          source_kind_map[primitive] = env.world.stone_index\n\n      if primitive in source_kind_map:\n          is_direct_pickup = False # This collection requires a USE action\n          target_grid_kind_idx = source_kind_map[primitive] # We're looking for the source on the grid\n      else:\n          # If the primitive is neither directly grabbable nor obtainable via a known USE source,\n          # this function cannot collect it.\n          return []\n\n  # BFS Queue: stores (current_x, current_y, current_dir, path_actions_list)\n  # The `current_dir` is important because the `USE` action depends on facing.\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set: stores (x, y, dir) tuples to avoid redundant exploration of states\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n      curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n      # --- Check for Success Conditions ---\n\n      # Condition A: If collection requires a 'USE' action\n      if not is_direct_pickup:\n          # Check all 4 adjacent cells for the target source kind\n          for d_dir, (dx, dy) in _DIR_DELTAS.items():\n              adj_x, adj_y = curr_x + dx, curr_y + dy\n              \n              # Check if the adjacent cell is within grid boundaries\n              if not (0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT):\n                  continue\n              \n              # If the adjacent cell contains the target source kind AND\n              # the agent is currently facing that adjacent cell (curr_dir == d_dir)\n              if initial_grid[adj_x, adj_y, target_grid_kind_idx] > 0 and curr_dir == d_dir:\n                  # Success! Agent is in position and facing correctly. Add the USE action.\n                  return path_actions + [_USE_ACTION]\n\n      # Condition B: If collection is via direct pickup (moving onto the item's cell)\n      # This check is performed after the USE check. If an item can be both picked up\n      # directly AND obtained via USE, this logic prioritizes direct pickup if the agent\n      # lands on it, but the overall BFS would find the shortest path.\n      if is_direct_pickup and initial_grid[curr_x, curr_y, target_grid_kind_idx] > 0:\n          # Success! Agent has moved onto the cell containing the grabbable item.\n          return path_actions\n\n      # --- Explore Movement Actions ---\n      for action_val, (dx, dy, new_dir) in _ACTION_PROPERTIES.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check if the next cell is blocked by impassable terrain\n          is_blocked_by_impassable = False\n          for k_idx in env.world.non_grabbable_indices:\n              if initial_grid[next_x, next_y, k_idx] > 0:\n                  # Treat workshops and water as traversable by default\n                  if k_idx not in env.world.workshop_indices and k_idx != env.world.water_index:\n                      is_blocked_by_impassable = True\n                      break\n          if is_blocked_by_impassable:\n              continue\n\n          # If the new state (position and facing direction) has not been visited, add it to the queue\n          if (next_x, next_y, new_dir) not in visited:\n              visited.add((next_x, next_y, new_dir))\n              new_path_actions = path_actions + [action_val]\n              queue.append((next_x, next_y, new_dir, new_path_actions))\n\n  # If the BFS completes and no path to collect the primitive is found, return an empty list.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:33:24.374822", "function_name": "collect", "function_body": "  import collections\n\n  # Constants for actions and directions\n  _DOWN_ACTION = 0\n  _UP_ACTION = 1\n  _LEFT_ACTION = 2\n  _RIGHT_ACTION = 3\n  _USE_ACTION = 4 # From CraftLab.action_specs, used for interacting with adjacent objects\n\n  # Directions represented as integers (standard for CraftWorld)\n  _NORTH_DIR = 0\n  _EAST_DIR = 1\n  _SOUTH_DIR = 2\n  _WEST_DIR = 3\n\n  # Mapping movement actions to their (dx, dy) deltas\n  _ACTION_DELTAS = {\n      _UP_ACTION: (0, -1),   # Move up (decrease y)\n      _DOWN_ACTION: (0, 1),    # Move down (increase y)\n      _LEFT_ACTION: (-1, 0),  # Move left (decrease x)\n      _RIGHT_ACTION: (1, 0),   # Move right (increase x)\n  }\n\n  # Mapping movement actions to the direction the agent faces after performing the action\n  _ACTION_TO_DIR = {\n      _UP_ACTION: _NORTH_DIR,\n      _DOWN_ACTION: _SOUTH_DIR,\n      _LEFT_ACTION: _WEST_DIR,\n      _RIGHT_ACTION: _EAST_DIR,\n  }\n\n  # Mapping directions to their (dx, dy) deltas for computing the cell in front of the agent\n  _DIR_TO_DELTA = {\n      _NORTH_DIR: (0, -1),\n      _EAST_DIR: (1, 0),\n      _SOUTH_DIR: (0, 1),\n      _WEST_DIR: (-1, 0),\n  }\n\n  # Helper function to get coordinates of the cell directly in front of the agent\n  def _get_facing_coords(x, y, direction):\n      dx, dy = _DIR_TO_DELTA[direction]\n      return x + dx, y + dy\n\n  # Get initial state and grid information from the CraftLab environment\n  current_state = env._current_state\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape # Grid shape (width, height, n_kinds)\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir # Agent's initial facing direction\n\n  # BFS Queue: stores (current_x, current_y, current_direction, path_actions_list)\n  # path_actions_list is the sequence of actions taken to reach (current_x, current_y)\n  # with current_direction.\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set: stores (x, y, direction) tuples to prevent cycles and redundant explorations.\n  visited = set([(start_x, start_y, start_dir)])\n\n  # BFS loop\n  while queue:\n      curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n      # --- Success Condition 1: Grabbable primitive (collected by moving onto its cell) ---\n      # If the primitive is one that can be picked up by simply occupying its square.\n      if primitive in env.world.grabbable_indices:\n          if grid[curr_x, curr_y, primitive] > 0:\n              return path_actions\n\n      # --- Success Condition 2: Primitive collected by USE action (e.g., water, stone) ---\n      # These primitives are typically non-grabbable and require interaction\n      # when the agent is adjacent and facing them.\n      elif primitive == env.world.water_index or primitive == env.world.stone_index:\n          # Determine the coordinates of the cell directly in front of the agent\n          face_x, face_y = _get_facing_coords(curr_x, curr_y, curr_dir)\n\n          # Check if the facing cell is within bounds and contains the target primitive\n          if (0 <= face_x < WIDTH and 0 <= face_y < HEIGHT and\n                  grid[face_x, face_y, primitive] > 0):\n              # If the target is found in front, add a USE action to the path\n              return path_actions + [_USE_ACTION]\n\n      # --- Explore Neighbors (Movement Actions) ---\n      # Consider all four possible movement actions (UP, DOWN, LEFT, RIGHT)\n      for action_val in [_UP_ACTION, _DOWN_ACTION, _LEFT_ACTION, _RIGHT_ACTION]:\n          dx, dy = _ACTION_DELTAS[action_val]\n          next_x, next_y = curr_x + dx, curr_y + dy\n          # When a movement action is taken, the agent's direction changes to match that movement.\n          next_dir = _ACTION_TO_DIR[action_val]\n\n          # Check for out-of-bounds movement\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check if the next cell is blocked by impassable terrain.\n          # A cell is considered blocked if it contains any non-grabbable item\n          # that is not a workshop and not water. Workshops and water are assumed\n          # traversable (you can walk on them).\n          is_blocked_by_impassable = False\n          for k_idx in env.world.non_grabbable_indices:\n              if grid[next_x, next_y, k_idx] > 0: # If this non-grabbable item is present\n                  # If the item is not a workshop and not water, it blocks movement.\n                  if k_idx not in env.world.workshop_indices and k_idx != env.world.water_index:\n                      is_blocked_by_impassable = True\n                      break # Found a blocking object, no need to check further kinds for this cell\n          if is_blocked_by_impassable:\n              continue # This cell is blocked, cannot move here\n\n          # If this new state (position and direction) has not been visited, add it to the queue\n          if (next_x, next_y, next_dir) not in visited:\n              visited.add((next_x, next_y, next_dir))\n              new_path_actions = path_actions + [action_val]\n              queue.append((next_x, next_y, next_dir, new_path_actions))\n\n  # If the BFS completes without finding a path to the primitive, return an empty list.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:35:31.170311", "function_name": "collect", "function_body": "    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Map movement actions to (dx, dy) coordinate changes\n    ACTION_TO_DELTA = {\n        ACTION_UP: (0, -1),   # Moving North (decreasing Y)\n        ACTION_DOWN: (0, 1),    # Moving South (increasing Y)\n        ACTION_LEFT: (-1, 0),   # Moving West (decreasing X)\n        ACTION_RIGHT: (1, 0),   # Moving East (increasing X)\n    }\n\n    # --- Initial State Acquisition ---\n    # Access the current state from the CraftLab environment to get grid, pos, dir\n    current_state = env._current_state\n    initial_grid = current_state.grid\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir # This is the agent's current integer direction (0=N, 1=E, 2=S, 3=W)\n\n    WIDTH, HEIGHT, N_KINDS = initial_grid.shape\n\n    # Get indices for impassable terrain. Assumed to be all non-grabbable entities\n    # like water and workshops, as you typically stand next to them, not on them.\n    impassable_indices = env.world.non_grabbable_indices\n\n    # --- Find Primitive Locations ---\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            # Check if the primitive is at this location\n            if initial_grid[x, y, primitive] == 1:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the grid\n\n    # --- Determine Target Adjacent Positions for BFS ---\n    # We need to find a path to a cell *adjacent* to any instance of the primitive.\n    # The agent will then turn to face the primitive and USE.\n    # Stores tuples of ((adjacent_x, adjacent_y), (primitive_x, primitive_y))\n    all_adj_targets_and_primitive_locs = []\n    for p_x, p_y in primitive_locations:\n        for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]: # Cardinal neighbors\n            adj_x, adj_y = p_x + dx, p_y + dy\n            \n            # Check if adjacent cell is within bounds\n            if not (0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT):\n                continue\n            \n            # Check if the adjacent cell is passable (i.e., does not contain any impassable item)\n            is_passable = True\n            for k_idx in impassable_indices:\n                if initial_grid[adj_x, adj_y, k_idx] == 1:\n                    is_passable = False\n                    break\n            \n            if is_passable:\n                all_adj_targets_and_primitive_locs.append(((adj_x, adj_y), (p_x, p_y)))\n\n    if not all_adj_targets_and_primitive_locs:\n        # No reachable adjacent spots for any primitive.\n        return []\n\n    # --- BFS to find shortest path to any adjacent target ---\n    # State in queue: ((current_x, current_y), [actions_to_reach_here])\n    # visited set: {(x, y)} to prevent cycles and redundant paths\n    queue = collections.deque([(initial_pos, [])])\n    visited = {initial_pos}\n\n    found_path_actions = []\n    final_primitive_target_loc = None # The (p_x, p_y) coordinates of the specific primitive targeted\n\n    while queue:\n        (curr_x, curr_y), actions_to_here = queue.popleft()\n\n        # Check if current cell is one of the valid adjacent targets\n        for (adj_x, adj_y), (p_x, p_y) in all_adj_targets_and_primitive_locs:\n            if (curr_x, curr_y) == (adj_x, adj_y):\n                found_path_actions = actions_to_here\n                final_primitive_target_loc = (p_x, p_y)\n                queue.clear() # Found shortest path, clear queue to stop BFS\n                break\n        if not queue: # If queue was cleared, break outer loop too\n            break\n\n        # Explore neighbors by applying movement actions\n        for action, (dx, dy) in ACTION_TO_DELTA.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_pos = (next_x, next_y)\n\n            # Check bounds\n            if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                continue\n\n            # Check if the next cell is impassable\n            is_impassable_next_cell = False\n            for k_idx in impassable_indices:\n                if initial_grid[next_x, next_y, k_idx] == 1:\n                    is_impassable_next_cell = True\n                    break\n            \n            if is_impassable_next_cell:\n                continue\n            \n            # Check if already visited\n            if next_pos in visited:\n                continue\n            \n            visited.add(next_pos)\n            queue.append((next_pos, actions_to_here + [action]))\n\n    # If final_primitive_target_loc is None, no path was found to any adjacent target.\n    if final_primitive_target_loc is None:\n        return []\n\n    # --- Finalize actions: Calculate turns and add USE ---\n    # Determine agent's final position after executing the path actions\n    agent_final_pos_x, agent_final_pos_y = initial_pos\n    for action in found_path_actions:\n        dx, dy = ACTION_TO_DELTA[action]\n        agent_final_pos_x += dx\n        agent_final_pos_y += dy\n    agent_final_pos = (agent_final_pos_x, agent_final_pos_y)\n\n    # Agent's direction remains the same as initial_dir because movement actions don't change facing direction\n    current_dir_at_final_pos = initial_dir\n\n    # Determine the desired facing direction towards the target primitive\n    target_x, target_y = final_primitive_target_loc\n\n    desired_dir = -1\n    if target_x > agent_final_pos_x:  # Target is to the East\n        desired_dir = 1  # East (1)\n    elif target_x < agent_final_pos_x:  # Target is to the West\n        desired_dir = 3  # West (3)\n    elif target_y > agent_final_pos_y:  # Target is to the South\n        desired_dir = 2  # South (2)\n    elif target_y < agent_final_pos_y:  # Target is to the North\n        desired_dir = 0  # North (0)\n    \n    # Add turns to align direction if necessary\n    if current_dir_at_final_pos != desired_dir:\n        # Calculate the difference to find shortest rotation (0-3 for N, E, S, W)\n        diff = (desired_dir - current_dir_at_final_pos + 4) % 4\n        \n        if diff == 1: # 90 degrees clockwise (right turn)\n            found_path_actions.append(ACTION_RIGHT)\n        elif diff == 3: # 90 degrees counter-clockwise (left turn)\n            found_path_actions.append(ACTION_LEFT)\n        elif diff == 2: # 180 degrees turn (e.g., from N to S). Two turns in either direction.\n            # Using two right turns for simplicity.\n            found_path_actions.append(ACTION_RIGHT)\n            found_path_actions.append(ACTION_RIGHT)\n        # If diff is 0, no turns are needed.\n\n    # Add the USE action to collect the primitive\n    found_path_actions.append(ACTION_USE)\n\n    return found_path_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:35:32.177469", "function_name": "collect", "function_body": "  # Constants for directions (0:N, 1:E, 2:S, 3:W)\n  # These map agent direction to (row_delta, col_delta)\n  DIR_DELTAS = {\n      0: (-1, 0),  # North (row-1)\n      1: (0, 1),   # East (col+1)\n      2: (1, 0),   # South (row+1)\n      3: (0, -1)   # West (col-1)\n  }\n\n  def _is_walkable(r, c, grid, non_grabbable_indices, HEIGHT, WIDTH):\n      \"\"\"Checks if a cell (r, c) is within bounds and not an obstacle.\"\"\"\n      if not (0 <= r < HEIGHT and 0 <= c < WIDTH):\n          return False\n      # Check if the cell contains any non-grabbable item\n      for k_idx in non_grabbable_indices:\n          if grid[r, c, k_idx] == 1:\n              return False\n      return True\n\n  # Get constants for actions from the environment\n  action_specs = env.action_specs()\n  UP_ACTION = action_specs['UP']\n  DOWN_ACTION = action_specs['DOWN']\n  LEFT_ACTION = action_specs['LEFT']\n  RIGHT_ACTION = action_specs['RIGHT']\n  USE_ACTION = action_specs['USE']\n\n  # Get current state information from the environment\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos\n  current_dir = current_state.dir # 0:N, 1:E, 2:S, 3:W\n  \n  HEIGHT, WIDTH, _ = grid.shape # grid is (H, W, K)\n\n  # Get non-grabbable indices from the world (via CraftLab.world -> CraftWorld.non_grabbable_indices)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find all locations of the target primitive\n  primitive_locations = []\n  for r in range(HEIGHT):\n      for c in range(WIDTH):\n          if grid[r, c, primitive] == 1:\n              primitive_locations.append((r, c))\n  \n  if not primitive_locations:\n      return [] # Primitive not found\n\n  # BFS Initialization\n  # State in BFS: ((row, col), direction)\n  # Queue stores: ( (state_row, state_col, state_dir), list_of_actions_to_reach_this_state )\n  q = collections.deque([((current_pos[0], current_pos[1], current_dir), [])])\n  visited = set([(current_pos[0], current_pos[1], current_dir)])\n\n  while q:\n      (r, c, d), path = q.popleft()\n\n      # Check if the cell directly in front of the agent contains the primitive\n      dr_front, dc_front = DIR_DELTAS[d]\n      nr_front, nc_front = r + dr_front, c + dc_front\n\n      # Check bounds for the cell in front\n      if (0 <= nr_front < HEIGHT and 0 <= nc_front < WIDTH):\n          if grid[nr_front, nc_front, primitive] == 1:\n              # Goal reached: current agent position is adjacent to primitive\n              # and agent is facing it.\n              return path + [USE_ACTION]\n\n      # Explore possible next states (move and turn actions)\n      \n      # 1. Move Forward (UP)\n      dr_move, dc_move = DIR_DELTAS[d]\n      nr_up, nc_up = r + dr_move, c + dc_move\n      if _is_walkable(nr_up, nc_up, grid, non_grabbable_indices, HEIGHT, WIDTH):\n          if ((nr_up, nc_up, d)) not in visited:\n              visited.add((nr_up, nc_up, d))\n              q.append(((nr_up, nc_up, d), path + [UP_ACTION]))\n      \n      # 2. Move Backward (DOWN)\n      dr_move_b, dc_move_b = DIR_DELTAS[(d + 2) % 4] # Opposite direction\n      nr_down, nc_down = r + dr_move_b, c + dc_move_b\n      if _is_walkable(nr_down, nc_down, grid, non_grabbable_indices, HEIGHT, WIDTH):\n          if ((nr_down, nc_down, d)) not in visited:\n              visited.add((nr_down, nc_down, d))\n              q.append(((nr_down, nc_down, d), path + [DOWN_ACTION]))\n\n      # 3. Turn Left (LEFT)\n      nd_left = (d - 1) % 4 # Python's % handles negative numbers correctly for modular arithmetic\n      if ((r, c, nd_left)) not in visited:\n          visited.add(((r, c, nd_left)))\n          q.append(((r, c, nd_left), path + [LEFT_ACTION]))\n\n      # 4. Turn Right (RIGHT)\n      nd_right = (d + 1) % 4\n      if ((r, c, nd_right)) not in visited:\n          visited.add(((r, c, nd_right)))\n          q.append(((r, c, nd_right), path + [RIGHT_ACTION]))\n          \n  # If BFS completes without finding a path (e.g., primitive is unreachable)\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:37:42.438618", "function_name": "collect", "function_body": "    import collections\n\n    # Get action mappings from the environment\n    _ACTION_DOWN = env.action_specs()['DOWN']\n    _ACTION_UP = env.action_specs()['UP']\n    _ACTION_LEFT = env.action_specs()['LEFT']\n    _ACTION_RIGHT = env.action_specs()['RIGHT']\n    _ACTION_USE = env.action_specs()['USE']\n\n    # Map direction (0:North, 1:East, 2:South, 3:West) to (dx, dy) delta for moving forward\n    _DIR_TO_DELTA = {\n        0: (0, -1),  # North: (col, row-1)\n        1: (1, 0),   # East:  (col+1, row)\n        2: (0, 1),   # South: (col, row+1)\n        3: (-1, 0)   # West:  (col-1, row)\n    }\n\n    # Helper functions for direction manipulation\n    _TURN_LEFT = lambda d: (d - 1 + 4) % 4\n    _TURN_RIGHT = lambda d: (d + 1) % 4\n    _OPPOSITE_DIR = lambda d: (d + 2) % 4\n\n    def _is_traversable(x, y, grid, non_grabbable_indices, width, height):\n        \"\"\"\n        Checks if a cell (x, y) is within bounds and traversable.\n        A cell is not traversable if it's out of bounds or contains a non-grabbable item.\n        \"\"\"\n        if not (0 <= x < width and 0 <= y < height):\n            return False\n        # Check if the cell contains any non-grabbable item (which are typically obstacles)\n        for idx in non_grabbable_indices:\n            if grid[x, y, idx] == 1:\n                return False\n        return True # It's traversable if it's not occupied by a non-grabbable item\n\n    state = env._current_state\n    grid = state.grid\n    current_pos = state.pos  # (x, y)\n    current_dir = state.dir  # 0:N, 1:E, 2:S, 3:W\n    inventory = state.inventory\n    world = state.world\n    non_grabbable_indices = world.non_grabbable_indices\n\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # 1. Check if primitive is already collected in the current state\n    if inventory[primitive] > 0:\n        return []\n\n    # 2. Find all locations of the primitive and determine potential target adjacent cells for the agent\n    # primitive_targets stores (adjacent_pos, primitive_pos) tuples, where agent should stand at adjacent_pos\n    # and face primitive_pos to use it.\n    primitive_targets = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] == 1:\n                primitive_pos = (x, y)\n                # Check all 4 neighbors of the primitive for potential agent positions\n                for dx, dy in _DIR_TO_DELTA.values(): # Iterate through deltas for N, E, S, W\n                    adj_x, adj_y = x + dx, y + dy\n                    if _is_traversable(adj_x, adj_y, grid, non_grabbable_indices, WIDTH, HEIGHT):\n                        primitive_targets.append(((adj_x, adj_y), primitive_pos))\n\n    if not primitive_targets:\n        return [] # No primitive found on the map or no accessible adjacent cells\n\n    # 3. Pathfinding (BFS on (position, direction) states)\n    # BFS state: ((current_x, current_y), current_dir, list_of_actions_taken)\n    q = collections.deque([(current_pos, current_dir, [])])\n    visited = set([(current_pos, current_dir)]) # Keep track of visited (pos, dir) states\n\n    best_actions_path = None\n    min_actions_len = float('inf')\n\n    while q:\n        (cx, cy), c_dir, c_actions = q.popleft()\n\n        # Pruning: If the current path is already longer than the best found, no need to explore further\n        if len(c_actions) >= min_actions_len:\n            continue\n\n        # Check if current state (position and direction) can achieve the goal\n        # The agent is at (cx, cy) and facing c_dir.\n        for adj_pos, prim_pos in primitive_targets:\n            if (cx, cy) == adj_pos:\n                # Calculate the required direction to face the primitive from current adjacent position\n                delta_x_to_prim = prim_pos[0] - cx\n                delta_y_to_prim = prim_pos[1] - cy\n                \n                required_dir_for_use = None\n                for d, (ddx, ddy) in _DIR_TO_DELTA.items():\n                    if ddx == delta_x_to_prim and ddy == delta_y_to_prim:\n                        required_dir_for_use = d\n                        break\n                \n                # If current direction matches the required direction, then we can USE\n                if required_dir_for_use is not None and c_dir == required_dir_for_use:\n                    full_path = c_actions + [_ACTION_USE]\n                    if len(full_path) < min_actions_len:\n                        min_actions_len = len(full_path)\n                        best_actions_path = full_path\n                        # We can stop exploring if we found the shortest possible path to any target.\n                        # For example, if we just took 1 action to reach the goal, we can't do better.\n                        if min_actions_len == 1: # Could happen if primitive is directly in front at start\n                            return best_actions_path\n\n        # Explore possible next states by taking actions\n\n        # 1. Move forward (_ACTION_UP)\n        fdx, fdy = _DIR_TO_DELTA[c_dir]\n        nfx, nfy = cx + fdx, cy + fdy\n        new_forward_pos = (nfx, nfy)\n        if _is_traversable(nfx, nfy, grid, non_grabbable_indices, WIDTH, HEIGHT) and \\\n           (new_forward_pos, c_dir) not in visited:\n            visited.add((new_forward_pos, c_dir))\n            q.append((new_forward_pos, c_dir, c_actions + [_ACTION_UP]))\n\n        # 2. Move backward (_ACTION_DOWN)\n        bdx, bdy = _DIR_TO_DELTA[_OPPOSITE_DIR(c_dir)]\n        nbx, nby = cx + bdx, cy + bdy\n        new_backward_pos = (nbx, nby)\n        if _is_traversable(nbx, nby, grid, non_grabbable_indices, WIDTH, HEIGHT) and \\\n           (new_backward_pos, c_dir) not in visited:\n            visited.add((new_backward_pos, c_dir))\n            q.append((new_backward_pos, c_dir, c_actions + [_ACTION_DOWN]))\n\n        # 3. Turn left (_ACTION_LEFT)\n        new_left_dir = _TURN_LEFT(c_dir)\n        # Position remains the same, only direction changes\n        if ((cx, cy), new_left_dir) not in visited:\n            visited.add(((cx, cy), new_left_dir))\n            q.append(((cx, cy), new_left_dir, c_actions + [_ACTION_LEFT]))\n\n        # 4. Turn right (_ACTION_RIGHT)\n        new_right_dir = _TURN_RIGHT(c_dir)\n        # Position remains the same, only direction changes\n        if ((cx, cy), new_right_dir) not in visited:\n            visited.add(((cx, cy), new_right_dir))\n            q.append(((cx, cy), new_right_dir, c_actions + [_ACTION_RIGHT]))\n    \n    # Return the best path found, or an empty list if no path was successful\n    return best_actions_path if best_actions_path is not None else []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:37:42.509932", "function_name": "collect", "function_body": "    actions = []\n    \n    # Get the current state from the CraftLab environment for planning.\n    # CraftState.step returns a new CraftState instance, allowing for safe simulation.\n    current_sim_state = env._current_state \n\n    # Limit planning iterations to prevent infinite loops for unreachable items.\n    # This also acts as a cap on the maximum length of the generated action sequence.\n    max_planning_iterations = 200 \n\n    for _ in range(max_planning_iterations):\n        # 1. Check if the primitive is already collected in the simulated inventory.\n        if current_sim_state.inventory[primitive] > 0:\n            break # Goal achieved, no more actions needed.\n\n        # 2. Check if the primitive is in the agent's 3x3 neighborhood (including the agent's current cell).\n        # If so, a 'USE' action should collect it.\n        if current_sim_state.next_to(primitive):\n            actions.append(env_factory.Actions.USE)\n            # Simulate the USE action to update the planning state.\n            _reward, new_state = current_sim_state.step(env_factory.Actions.USE)\n            current_sim_state = new_state\n            continue # Re-evaluate state (check inventory) in the next iteration.\n\n        # 3. If not collected and not in the immediate vicinity, plan a path to it using BFS.\n        start_pos = current_sim_state.pos\n        grid = current_sim_state.grid\n        width, height, _ = grid.shape # Grid shape is (WIDTH, HEIGHT, n_kinds)\n\n        # Find all locations where the primitive exists on the grid.\n        primitive_locations = []\n        for x_coord in range(width):\n            for y_coord in range(height):\n                if grid[x_coord, y_coord, primitive] > 0:\n                    primitive_locations.append((x_coord, y_coord))\n\n        if not primitive_locations:\n            # The primitive is not found anywhere on the map, so it cannot be collected.\n            return actions # Return the actions collected so far (will likely be empty).\n\n        # Initialize BFS queue: (current_position, path_taken_to_reach_here)\n        q = collections.deque([(start_pos, [])]) \n        visited = {start_pos} # Keep track of visited positions to avoid cycles.\n\n        path_to_target_adj_cell = None\n\n        while q:\n            (curr_x, curr_y), path = q.popleft()\n\n            # Check if the current position is within collecting range (3x3 neighborhood)\n            # of any primitive location.\n            for p_loc_x, p_loc_y in primitive_locations:\n                # The agent at (curr_x, curr_y) can 'USE' the primitive if it's within\n                # 1 unit Manhattan/Chebyshev distance.\n                if abs(curr_x - p_loc_x) <= 1 and abs(curr_y - p_loc_y) <= 1:\n                    path_to_target_adj_cell = path\n                    break\n            \n            if path_to_target_adj_cell:\n                break # Found a path to a suitable cell\n\n            # Explore all four cardinal neighbors (UP, DOWN, LEFT, RIGHT).\n            for action_val, (dx, dy) in [\n                (env_factory.Actions.LEFT, (-1, 0)),  # Left: x decreases\n                (env_factory.Actions.RIGHT, (1, 0)), # Right: x increases\n                (env_factory.Actions.UP, (0, -1)),   # Up: y decreases\n                (env_factory.Actions.DOWN, (0, 1))    # Down: y increases\n            ]:\n                next_x, next_y = curr_x + dx, curr_y + dy\n\n                # Check if the next position is within grid boundaries.\n                if not (0 <= next_x < width and 0 <= next_y < height):\n                    continue\n\n                next_pos = (next_x, next_y)\n                if next_pos in visited:\n                    continue\n                \n                # Check if the next cell is traversable.\n                # Assume cells containing any \"non_grabbable\" entity (like walls or fixed obstacles)\n                # are blocked. Primitives themselves are grabbable and thus not in this set.\n                is_blocked = False\n                for k_idx in current_sim_state.world.non_grabbable_indices:\n                    if grid[next_x, next_y, k_idx] > 0:\n                        is_blocked = True\n                        break\n                \n                if is_blocked:\n                    continue # Cannot move into a blocked cell.\n\n                # If traversable and not visited, add to queue.\n                visited.add(next_pos)\n                q.append((next_pos, path + [action_val]))\n        \n        if path_to_target_adj_cell:\n            # If a path was found, append these movement actions to the overall plan.\n            actions.extend(path_to_target_adj_cell)\n            # Simulate these movements to update the planning state.\n            for action_to_take in path_to_target_adj_cell:\n                _reward, new_state = current_sim_state.step(action_to_take)\n                current_sim_state = new_state\n            # The loop will then continue, and in the next iteration,\n            # `current_sim_state.next_to(primitive)` should be True, leading to a 'USE' action.\n        else:\n            # No path found to any cell from which the primitive can be collected.\n            # This happens if the primitive is unreachable (e.g., completely walled off).\n            break # Stop planning, as the item cannot be collected.\n\n    return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:39:09.366267", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos\n  agent_dir = state.dir\n  world = state.world\n\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n\n  # Define constants for actions and directions for readability\n  _NORTH = 0\n  _EAST = 1\n  _SOUTH = 2\n  _WEST = 3\n\n  _ACTION_DOWN = 0\n  _ACTION_UP = 1\n  _ACTION_LEFT = 2\n  _ACTION_RIGHT = 3\n  _ACTION_USE = 4\n\n  # Maps action (UP, DOWN, LEFT, RIGHT) to (dr, dc) delta\n  _ACTION_TO_DELT_MAP = {\n      _ACTION_UP: (-1, 0),\n      _ACTION_DOWN: (1, 0),\n      _ACTION_LEFT: (0, -1),\n      _ACTION_RIGHT: (0, 1)\n  }\n\n  # Maps direction (NORTH, EAST, SOUTH, WEST) to (dr, dc) delta\n  _DIR_TO_DELT_MAP = {\n      _NORTH: (-1, 0),\n      _EAST: (0, 1),\n      _SOUTH: (1, 0),\n      _WEST: (0, -1)\n  }\n\n  # Determine if the primitive is grabbable or a workshop\n  is_grabbable = primitive in world.grabbable_indices\n  is_workshop = primitive in world.workshop_indices\n\n  if not is_grabbable and not is_workshop:\n      # If the primitive is neither directly grabbable nor a workshop,\n      # this collection logic does not apply.\n      return []\n\n  # Find all locations of the primitive on the grid\n  target_locations = []\n  for r in range(WIDTH):\n    for c in range(HEIGHT):\n      if grid[r, c, primitive] == 1:\n        target_locations.append((r, c))\n\n  if not target_locations:\n    return [] # Primitive not found on the map\n\n  # BFS for pathfinding\n  # Queue state: (current_position (r,c), current_direction, list_of_actions_so_far)\n  queue = collections.deque([(agent_pos, agent_dir, [])])\n  # Visited states: (position (r,c), direction) to avoid cycles and redundant exploration\n  visited = set([(agent_pos, agent_dir)])\n\n  while queue:\n    current_pos, current_dir, current_path = queue.popleft()\n    r, c = current_pos\n\n    # Check if goal condition is met\n    if is_grabbable:\n        if current_pos in target_locations:\n            # Agent is on the primitive's square, meaning it's collected.\n            return current_path\n    elif is_workshop:\n        # Check if current_pos is adjacent to any workshop location\n        for tr, tc in target_locations:\n            if abs(r - tr) + abs(c - tc) == 1: # Manhattan distance 1 means adjacent\n                # Found a position adjacent to the target workshop.\n                final_actions = list(current_path)\n\n                # Determine the direction to face the workshop from current_pos\n                dr_to_target = tr - r\n                dc_to_target = tc - c\n                target_face_dir = None\n                for d, delt in _DIR_TO_DELT_MAP.items():\n                    if delt == (dr_to_target, dc_to_target):\n                        target_face_dir = d\n                        break\n                \n                if target_face_dir is not None:\n                    # Calculate and add turns to face the workshop\n                    turns = []\n                    if current_dir != target_face_dir:\n                        diff = (target_face_dir - current_dir + 4) % 4\n                        if diff == 1:  # 90 degrees clockwise\n                            turns.append(_ACTION_RIGHT)\n                        elif diff == 2:  # 180 degrees\n                            turns.extend([_ACTION_RIGHT, _ACTION_RIGHT])\n                        elif diff == 3:  # 90 degrees counter-clockwise\n                            turns.append(_ACTION_LEFT)\n                    final_actions.extend(turns)\n                    final_actions.append(_ACTION_USE) # Add the USE action\n\n                return final_actions # Path found and complete\n\n    # Explore possible next states (movement actions)\n    for action_move, (dr, dc) in _ACTION_TO_DELT_MAP.items():\n        nr, nc = r + dr, c + dc\n        new_pos = (nr, nc)\n\n        # Check grid boundaries\n        if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n            continue\n\n        # Check traversability: A cell is considered an obstacle if it contains\n        # any item from `world.non_grabbable_indices`. This includes workshops,\n        # as the agent cannot move onto a workshop, only interact from adjacent.\n        is_obstacle = False\n        for k_on_cell in range(N_KINDS):\n            if grid[nr, nc, k_on_cell] == 1 and k_on_cell in world.non_grabbable_indices:\n                is_obstacle = True\n                break\n        \n        if is_obstacle:\n            continue\n        \n        new_state_tuple = (new_pos, current_dir) # Movement actions do not change agent's orientation\n        if new_state_tuple not in visited:\n            visited.add(new_state_tuple)\n            queue.append((new_pos, current_dir, current_path + [action_move]))\n\n    # Explore possible next states (turning actions, no movement)\n    for turn_action in [_ACTION_LEFT, _ACTION_RIGHT]:\n        new_dir_val = current_dir\n        if turn_action == _ACTION_LEFT:\n            new_dir_val = (current_dir - 1 + 4) % 4\n        elif turn_action == _ACTION_RIGHT:\n            new_dir_val = (current_dir + 1) % 4\n        \n        new_state_tuple = (current_pos, new_dir_val)\n        if new_state_tuple not in visited:\n            visited.add(new_state_tuple)\n            queue.append((current_pos, new_dir_val, current_path + [turn_action]))\n\n  return [] # No path found after exploring all reachable states", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:39:09.435293", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Define actions locally for clarity and self-containment\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # 1. Check if the primitive is already in the agent's inventory\n    if env._current_state.inventory[primitive] > 0:\n        return []\n\n    current_state = env._current_state\n    grid = current_state.grid\n    grid_width, grid_height, _ = grid.shape\n    start_pos = current_state.pos\n\n    # 2. Find all locations on the grid where the primitive exists\n    primitive_locations = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        # If the primitive is not found anywhere on the map, no actions can be taken\n        return []\n\n    # 3. Determine target agent positions. An agent can 'USE' an item if it's\n    # within its 3x3 neighborhood (including the agent's current cell).\n    # So, we find all cells (agent_x, agent_y) from which any primitive location\n    # (primitive_x, primitive_y) would be in the 3x3 neighborhood.\n    target_agent_positions = set()\n    for px, py in primitive_locations:\n        for dx in [-1, 0, 1]:\n            for dy in [-1, 0, 1]:\n                nx, ny = px + dx, py + dy\n                # Ensure the potential agent position is within grid boundaries\n                if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                    target_agent_positions.add((nx, ny))\n    \n    # Optimization: If the agent is already in a position where it can 'USE' the primitive\n    if start_pos in target_agent_positions:\n        return [USE]\n\n    # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n    # from the agent's start_pos to any target_agent_position.\n    queue = collections.deque([(start_pos, [])]) # Queue stores (current_position, list_of_actions_to_reach_here)\n    visited = {start_pos} # Set of visited positions to avoid cycles and redundant paths\n\n    while queue:\n        (curr_x, curr_y), actions_taken = queue.popleft()\n\n        # Define possible movements from the current position\n        # (next_x, next_y), action_id_to_reach_next_pos\n        moves = [\n            ((curr_x, curr_y + 1), DOWN),\n            ((curr_x, curr_y - 1), UP),\n            ((curr_x - 1, curr_y), LEFT),\n            ((curr_x + 1, curr_y), RIGHT)\n        ]\n\n        for (next_x, next_y), action_to_take in moves:\n            # Check if the next position is within grid boundaries\n            if 0 <= next_x < grid_width and 0 <= next_y < grid_height:\n                # Check if this position has not been visited yet\n                if (next_x, next_y) not in visited:\n                    new_actions = actions_taken + [action_to_take]\n                    \n                    # If this new position is one of our target positions, we found a path\n                    if (next_x, next_y) in target_agent_positions:\n                        return new_actions + [USE] # Add the 'USE' action at the end\n\n                    # Mark the new position as visited and add it to the queue\n                    visited.add((next_x, next_y))\n                    queue.append(((next_x, next_y), new_actions))\n\n    # If the BFS completes and no path to a target position is found\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:39:58.620356", "function_name": "collect", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:39:59.589956", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map movement vectors (dx, dy) to action IDs.\n  # These actions move the agent AND set its facing direction.\n  MOVE_VEC_TO_ACTION = {\n      (0, -1): UP,    # Move North, face North\n      (0, 1): DOWN,   # Move South, face South\n      (-1, 0): LEFT,  # Move West, face West\n      (1, 0): RIGHT   # Move East, face East\n  }\n\n  # Map agent's internal direction ID to its corresponding facing vector (dx, dy).\n  # 0: North (-Y)\n  # 1: East (+X)\n  # 2: South (+Y)\n  # 3: West (-X)\n  DIR_TO_VEC = {\n      0: (0, -1),  # North\n      1: (1, 0),   # East\n      2: (0, 1),   # South\n      3: (-1, 0)   # West\n  }\n\n  initial_obs = env.observations()\n  initial_grid = initial_obs['features_dict']['features_global']\n  initial_pos_tuple = tuple(initial_obs['features_dict']['pos'].astype(int))\n  initial_dir = np.argmax(initial_obs['features_dict']['direction'])\n\n  grid_width, grid_height, _ = initial_grid.shape\n\n  # Get indices of non-grabbable items (obstacles) from the world\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Pre-compute traversability map (improvement from v1)\n  # This avoids re-checking all non-grabbable indices for every cell during BFS.\n  traversable_map = np.full((grid_width, grid_height), True, dtype=bool)\n  for x in range(grid_width):\n      for y in range(grid_height):\n          for idx in non_grabbable_indices:\n              if initial_grid[x, y, idx] > 0:\n                  traversable_map[x, y] = False # Mark as untraversable if it contains an obstacle\n                  break # No need to check other indices for this cell\n\n  # Helper function to check if a coordinate is within grid bounds\n  def is_valid_coord(x, y):\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  # Optimized helper function to check if a cell is traversable.\n  def is_traversable(x, y):\n      return is_valid_coord(x, y) and traversable_map[x, y]\n\n  # --- Improvement for v2: Pre-compute all potential \"collect\" goal states ---\n  # A \"collect\" goal state is an (agent_x, agent_y, agent_dir) from which the agent can apply USE\n  # to collect the target primitive. We find all such possible states on the grid.\n  collect_goal_states = set()\n  for px in range(grid_width):\n      for py in range(grid_height):\n          # Check if the current cell (px, py) contains the primitive\n          if initial_grid[px, py, primitive] > 0:\n              # For each direction, determine the agent's position that would face this primitive\n              for dir_idx, (dx, dy) in DIR_TO_VEC.items():\n                  # The agent would be at (px - dx, py - dy) and facing dir_idx\n                  agent_x, agent_y = px - dx, py - dy\n                  \n                  # Only consider this as a valid goal state if the agent's position is traversable\n                  if is_traversable(agent_x, agent_y):\n                      collect_goal_states.add(((agent_x, agent_y), dir_idx))\n    \n  # If there are no primitives of the target kind on the map, return an empty action list.\n  if not collect_goal_states:\n      return []\n\n  # BFS search to find the shortest path to any of the `collect_goal_states`.\n  # The state in BFS is ((x, y), direction_int).\n  queue = collections.deque([(initial_pos_tuple, initial_dir)])\n  # Visited set stores (position, direction) tuples to prevent cycles and redundant exploration.\n  visited = set([(initial_pos_tuple, initial_dir)])\n  # parent_map stores: (child_pos, child_dir) -> ((parent_pos, parent_dir), action_taken_to_reach_child)\n  parent_map = {}\n\n  target_reached_bfs_state = None # To store the specific goal state found by BFS\n\n  while queue:\n      (curr_x, curr_y), curr_dir_int = queue.popleft()\n      current_bfs_state = ((curr_x, curr_y), curr_dir_int)\n\n      # Check if the current BFS state is one of our pre-computed goal states\n      if current_bfs_state in collect_goal_states:\n          target_reached_bfs_state = current_bfs_state\n          break # Found the shortest path to a collecting position, exit BFS\n\n      # Explore possible moves (UP, DOWN, LEFT, RIGHT).\n      # Each move action also changes the agent's direction to the direction of movement.\n      for move_vec, move_action in MOVE_VEC_TO_ACTION.items():\n          next_x, next_y = curr_x + move_vec[0], curr_y + move_vec[1]\n          next_dir_int = move_action # The new direction is set by the move action itself.\n          next_pos_tuple = (next_x, next_y)\n\n          # Check if the next cell is traversable using the optimized function.\n          if is_traversable(next_x, next_y):\n              next_bfs_state = (next_pos_tuple, next_dir_int)\n              if next_bfs_state not in visited:\n                  visited.add(next_bfs_state)\n                  # Store the parent and the action taken to reach this state\n                  parent_map[next_bfs_state] = (current_bfs_state, move_action)\n                  queue.append(next_bfs_state)\n\n  # If target_reached_bfs_state is found, reconstruct the path\n  if target_reached_bfs_state:\n      actions_path = [USE] # The last action is always USE to collect the primitive\n      current_path_state = target_reached_bfs_state\n\n      # Backtrack from the found target state to the initial state\n      while current_path_state != (initial_pos_tuple, initial_dir):\n          # Get parent state and action from parent_map\n          parent_state, action_to_reach_curr = parent_map[current_path_state]\n          actions_path.append(action_to_reach_curr)\n          current_path_state = parent_state\n      \n      # The path was built in reverse, so reverse it back to get chronological order\n      return actions_path[::-1]\n\n  # If the queue becomes empty and no path to any goal state was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:41:41.073254", "function_name": "collect", "function_body": "    # Define action constants and deltas locally within the function for clarity.\n    # These integer values correspond to the actions defined in CraftLab.action_specs.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Map actions to their corresponding change in (row, column) coordinates.\n    ACTION_DELTAS_MAP = {\n        ACTION_UP: (-1, 0),\n        ACTION_DOWN: (1, 0),\n        ACTION_LEFT: (0, -1),\n        ACTION_RIGHT: (0, 1),\n    }\n\n    # Get the current state from the environment.\n    state = env._current_state\n    grid = state.grid\n    agent_pos = state.pos  # Agent's current position (row, col)\n    grid_height, grid_width, _ = grid.shape\n    primitive_idx = primitive  # The integer index of the primitive to collect\n\n    world = state.world\n    # Get the set of indices for entities that are considered obstacles (non-grabbable).\n    non_grabbable_indices = world.non_grabbable_indices\n\n    # Step 1: Find all locations on the grid where the target primitive exists.\n    primitive_locations = []\n    for r in range(grid_height):\n        for c in range(grid_width):\n            # Check if the primitive kind is present at this grid cell.\n            if grid[r, c, primitive_idx] == 1:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        # If the primitive is not found anywhere on the grid, return an empty list of actions.\n        return []\n\n    # Step 2: Determine all valid \"target\" cells for the agent.\n    # These are cells that are adjacent (cardinally) to any primitive location\n    # and are also traversable by the agent (not an obstacle).\n    target_adjacent_positions = set()\n    for pr, pc in primitive_locations:\n        # Check all four cardinal neighbors around the primitive location.\n        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            ar, ac = pr + dr, pc + dc  # Candidate agent adjacent position.\n            \n            # Check if the candidate position is within the grid boundaries.\n            if not (0 <= ar < grid_height and 0 <= ac < grid_width):\n                continue\n            \n            # Check if the candidate position is traversable (i.e., not an obstacle).\n            is_obstacle = False\n            # A cell is an obstacle if it contains any non-grabbable item.\n            for k_idx in non_grabbable_indices:\n                if grid[ar, ac, k_idx] == 1:\n                    is_obstacle = True\n                    break\n            \n            # Additionally, an agent should not move *onto* the primitive itself,\n            # but rather to a cell *next* to it. If the primitive itself occupies a cell,\n            # that cell should be considered an obstacle for movement.\n            if grid[ar, ac, primitive_idx] == 1:\n                is_obstacle = True \n\n            if not is_obstacle:\n                target_adjacent_positions.add((ar, ac))\n\n    if not target_adjacent_positions:\n        # If there are no reachable adjacent positions to any primitive, return empty.\n        return []\n\n    # Step 3: Perform a Breadth-First Search (BFS) to find the shortest path\n    # from the agent's current position to any of the `target_adjacent_positions`.\n    # Using a list as a queue (less efficient than collections.deque, but avoids extra import).\n    queue = [(agent_pos, [])]  # Queue stores (current_position, path_taken_so_far_actions)\n    visited = {agent_pos}  # Set to keep track of visited positions to avoid cycles\n\n    head = 0  # Pointer to the current front of the queue (simulate popleft)\n    while head < len(queue):\n        current_pos, current_actions = queue[head]\n        head += 1\n\n        # If the current position is one of our target adjacent cells, we've found the shortest path.\n        if current_pos in target_adjacent_positions:\n            # Append the USE action as the final step to collect the primitive.\n            return current_actions + [ACTION_USE]\n\n        # Explore neighbors (possible next positions)\n        for action, (dy, dx) in ACTION_DELTAS_MAP.items():\n            next_r, next_c = current_pos[0] + dy, current_pos[1] + dx\n            next_pos = (next_r, next_c)\n\n            # Check bounds for the next position.\n            if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n                continue\n\n            # Check if the next position has already been visited.\n            if next_pos in visited:\n                continue\n\n            # Check if the next position is an obstacle (same logic as used for target positions).\n            is_obstacle = False\n            for k_idx in non_grabbable_indices:\n                if grid[next_r, next_c, k_idx] == 1:\n                    is_obstacle = True\n                    break\n            \n            # Again, prevent moving onto the primitive itself.\n            if grid[next_r, next_c, primitive_idx] == 1:\n                is_obstacle = True\n\n            # If the next position is valid and not an obstacle, add it to the queue.\n            if not is_obstacle:\n                visited.add(next_pos)\n                queue.append((next_pos, current_actions + [action]))\n    \n    # If the queue is exhausted and no path was found to any primitive, return an empty list.\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:41:41.148309", "function_name": "collect", "function_body": "    # Constants for actions\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Direction mappings (agent's dir: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n    # Relative coords (dr, dc) of cell in front of agent for each direction\n    FRONT_CELL_REL = {\n        0: (-1, 0),  # UP\n        1: (0, 1),   # RIGHT\n        2: (1, 0),   # DOWN\n        3: (0, -1)   # LEFT\n    }\n\n    actions_taken = []\n    max_steps_per_episode = env.task.steps\n    current_step = 0\n\n    # Reset environment to get initial state\n    obs = env.reset() \n\n    is_primitive_grabbable = primitive in env.world.grabbable_indices\n    \n    while current_step < max_steps_per_episode:\n        current_state = env._current_state\n        current_pos = current_state.pos # (row, col)\n        current_dir = current_state.dir # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n\n        # 1. Check if primitive is already in inventory\n        if obs['inventory'][primitive] > 0:\n            return actions_taken\n\n        # Get global grid to find primitive locations\n        global_grid = obs['features_dict']['features_global']\n        \n        # Find all locations of the primitive on the grid\n        primitive_locations = np.argwhere(global_grid[:, :, primitive] == 1)\n\n        target_r, target_c = None, None\n        if primitive_locations.size > 0:\n            # Find the closest primitive location using Manhattan distance\n            min_dist = float('inf')\n            \n            for loc in primitive_locations:\n                dist = abs(loc[0] - current_pos[0]) + abs(loc[1] - current_pos[1])\n                if dist < min_dist:\n                    min_dist = dist\n                    target_r, target_c = loc\n        else:\n            # Primitive not found on the map, cannot collect it.\n            # This might mean it's a crafted item, or the map is exhausted.\n            # Return actions taken so far.\n            return actions_taken \n\n        if is_primitive_grabbable:\n            # If grabbable, agent needs to move onto the item's cell to pick it up.\n            if current_pos == (target_r, target_c):\n                # Agent is on the target cell. It should have been picked up by the last move.\n                # If we're here and it's not in inventory, it means it's not pickable this way,\n                # or a logic error. Break to avoid infinite loop.\n                break \n            \n            # Determine movement towards the target (grabbable item)\n            move_action = None\n            dr = target_r - current_pos[0]\n            dc = target_c - current_pos[1]\n\n            if abs(dr) >= abs(dc): # Prioritize vertical movement if same or more difference\n                if dr < 0:\n                    move_action = ACTION_UP\n                elif dr > 0:\n                    move_action = ACTION_DOWN\n                elif dc != 0: # Only if dr is 0 but dc is not (i.e. on same row but different col)\n                    move_action = ACTION_LEFT if dc < 0 else ACTION_RIGHT\n            else: # Prioritize horizontal movement\n                if dc < 0:\n                    move_action = ACTION_LEFT\n                elif dc > 0:\n                    move_action = ACTION_RIGHT\n                elif dr != 0: # Only if dc is 0 but dr is not (i.e. on same col but different row)\n                    move_action = ACTION_UP if dr < 0 else ACTION_DOWN\n\n            if move_action is not None:\n                reward, done, obs = env.step(move_action)\n                actions_taken.append(move_action)\n                current_step += 1\n            else:\n                # Should not happen if current_pos != (target_r, target_c)\n                # If it does, agent is at target but not picked up, handled above.\n                break\n\n        else: # Not grabbable (e.g., tree, stone) - need to move adjacent, face, and USE\n            # Determine the cell directly in front of the agent\n            dr_front, dc_front = FRONT_CELL_REL[current_dir]\n            front_r, front_c = current_pos[0] + dr_front, current_pos[1] + dc_front\n            \n            # Check if the target primitive is directly in front of the agent\n            is_target_in_front = (0 <= front_r < global_grid.shape[0] and\n                                  0 <= front_c < global_grid.shape[1] and\n                                  global_grid[front_r, front_c, primitive] == 1)\n\n            if is_target_in_front:\n                # Target is directly in front, so USE\n                reward, done, obs = env.step(ACTION_USE)\n                actions_taken.append(ACTION_USE)\n                current_step += 1\n            else:\n                # Target is not directly in front. It might be further away, diagonal, or behind.\n                # Agent needs to move or turn to get it into a position where USE is possible.\n                \n                # First, check if the target is in a cardinal direction (UP, DOWN, LEFT, RIGHT)\n                # from the agent's current position (not necessarily in front).\n                target_rel_r = target_r - current_pos[0]\n                target_rel_c = target_c - current_pos[1]\n\n                desired_cardinal_dir_to_target = -1\n                if target_rel_r == -1 and target_rel_c == 0: desired_cardinal_dir_to_target = 0 # UP\n                elif target_rel_r == 0 and target_rel_c == 1: desired_cardinal_dir_to_target = 1 # RIGHT\n                elif target_rel_r == 1 and target_rel_c == 0: desired_cardinal_dir_to_target = 2 # DOWN\n                elif target_rel_r == 0 and target_rel_c == -1: desired_cardinal_dir_to_target = 3 # LEFT\n                \n                if desired_cardinal_dir_to_target != -1: # Target is in one of the 4 cardinal adjacent cells\n                    if current_dir != desired_cardinal_dir_to_target:\n                        # Agent is adjacent to the target but not facing it. Turn.\n                        turn_action = None\n                        # Calculate shortest turn direction\n                        diff = (desired_cardinal_dir_to_target - current_dir + 4) % 4\n                        if diff == 1: # CW turn (e.g., UP->RIGHT)\n                            turn_action = ACTION_RIGHT\n                        elif diff == 3: # CCW turn (e.g., UP->LEFT)\n                            turn_action = ACTION_LEFT\n                        elif diff == 2: # 180 degree turn, prefer RIGHT twice\n                            turn_action = ACTION_RIGHT\n                            \n                        reward, done, obs = env.step(turn_action)\n                        actions_taken.append(turn_action)\n                        current_step += 1\n                        if diff == 2: # Take a second turn for 180 degrees\n                            reward, done, obs = env.step(turn_action)\n                            actions_taken.append(turn_action)\n                            current_step += 1\n                    # After turning (or if already facing), the `is_target_in_front` check will succeed next iteration.\n                    # Or, if we are here, it means we did a turn. Continue loop to re-evaluate.\n                else: # Target is not in a cardinal adjacent cell (e.g., diagonal, or further away).\n                      # Need to move towards it to get it into a cardinal adjacent position.\n                    move_action = None\n                    dr = target_r - current_pos[0]\n                    dc = target_c - current_pos[1]\n\n                    if abs(dr) >= abs(dc):\n                        if dr < 0:\n                            move_action = ACTION_UP\n                        elif dr > 0:\n                            move_action = ACTION_DOWN\n                        elif dc != 0: # Only if dr is 0 but dc is not\n                            move_action = ACTION_LEFT if dc < 0 else ACTION_RIGHT\n                    else:\n                        if dc < 0:\n                            move_action = ACTION_LEFT\n                        elif dc > 0:\n                            move_action = ACTION_RIGHT\n                        elif dr != 0: # Only if dc is 0 but dr is not\n                            move_action = ACTION_UP if dr < 0 else ACTION_DOWN\n                    \n                    if move_action is not None:\n                        reward, done, obs = env.step(move_action)\n                        actions_taken.append(move_action)\n                        current_step += 1\n                    else:\n                        # Agent is exactly at target_r, target_c, which is not grabbable,\n                        # and cannot be USE'd from this position (e.g., an uncollectable item\n                        # on the agent's square). Break.\n                        break\n\n        if done: # Environment might terminate early (e.g., max_steps reached internally)\n            break\n\n    return actions_taken # Return actions collected so far (might be incomplete if goal not met)", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:42:59.323992", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100\n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_cell_in_front(pos, direction):\n      y, x = pos\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return None # Should not happen with valid directions\n\n  # Breadth-First Search (BFS) to find a path to the primitive, ensuring the agent\n  # ends up at a position AND orientation suitable for collection (primitive in front).\n  def _find_path_for_collection(start_pos, start_dir, full_grid, primitive_id, world, max_steps):\n      grid_height, grid_width, _ = full_grid.shape\n      impassable_kinds = world.non_grabbable_indices\n\n      # BFS state: (current_y, current_x, current_dir, path_of_actions)\n      q = collections.deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n      moves_options = [\n          (-1, 0, ACTION_UP, DIR_NORTH),\n          (1, 0, ACTION_DOWN, DIR_SOUTH),\n          (0, -1, ACTION_LEFT, DIR_WEST),\n          (0, 1, ACTION_RIGHT, DIR_EAST)\n      ]\n\n      while q:\n          curr_y, curr_x, curr_dir, path_actions = q.popleft()\n          \n          # Check for path length limit (reserving at least 1 step for ACTION_USE)\n          if len(path_actions) >= max_steps - 1:\n              continue # Skip expanding paths that are already too long\n\n          # --- Goal Check: Is the primitive directly in front of the agent? ---\n          front_y, front_x = _get_cell_in_front((curr_y, curr_x), curr_dir)\n\n          # Check bounds for the cell in front\n          if (0 <= front_y < grid_height and 0 <= front_x < grid_width):\n              # Check if the cell in front contains the primitive\n              if full_grid[front_y, front_x, primitive_id] > 0:\n                  # Found a suitable state: agent is positioned and oriented\n                  # such that the primitive is directly in front.\n                  return path_actions \n\n          # --- Explore neighboring cells for movement ---\n          for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n              # Check bounds for the next movement cell\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if the next cell is traversable (i.e., does not contain any impassable kinds)\n              is_traversable_for_movement = True\n              for k_idx in impassable_kinds:\n                  if full_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable_for_movement = False\n                      break\n              if not is_traversable_for_movement:\n                  continue\n              \n              # Add to queue only if this new state (position and direction) hasn't been visited\n              if (next_y, next_x, new_dir_after_move) not in visited:\n                  visited.add((next_y, next_x, new_dir_after_move))\n                  q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n      return None # No path found\n\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state for planning.\n  # This ensures the planning starts from a consistent base.\n  current_obs = env.reset() \n  current_state = env._current_state # Access the underlying CraftState instance\n\n  # Initial checks for early exit\n  if primitive not in current_state.world.cookbook.kinds:\n      # The specified primitive ID is not a recognized kind in the world.\n      return [] \n  if current_state.inventory[primitive] > 0:\n      # The primitive has already been collected or is present in inventory.\n      return [] \n\n  full_grid = current_state.features_dict()['features_global']\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  \n  # Find the sequence of movements to position the agent for collection.\n  path_of_moves = _find_path_for_collection(\n      start_pos, start_dir, full_grid, primitive, current_state.world, MAX_COLLECT_STEPS\n  )\n\n  if path_of_moves is None:\n      # No valid path was found to reach a position/orientation suitable for collection.\n      return [] \n\n  # Execute the found path of movements\n  for action in path_of_moves:\n      actions_taken.append(action)\n      # Step the environment with the current action.\n      # We ignore reward and done status as this function's goal is just to return the action sequence.\n      _, _, _ = env.step(action) \n      current_state = env._current_state # Always update the internal state after a step\n\n  # After executing all movement actions, the agent should be at the correct position\n  # and facing the correct direction, with the primitive directly in front.\n  # Now, attempt to collect it with ACTION_USE.\n  if len(actions_taken) < MAX_COLLECT_STEPS: # Ensure there's still capacity for the USE action\n      actions_taken.append(ACTION_USE)\n      _, _, _ = env.step(ACTION_USE)\n      current_state = env._current_state # Update state after USE\n\n      # Final verification: Confirm the primitive was successfully collected into inventory.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken # Successfully collected!\n  \n  # If path was too long to include USE, or USE failed (inventory not updated)\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:43:00.332260", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      ACTION_UP: DIR_NORTH,\n      ACTION_DOWN: DIR_SOUTH,\n      ACTION_LEFT: DIR_WEST,\n      ACTION_RIGHT: DIR_EAST\n  }\n\n  # Mapping of target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction to collect that target via ACTION_USE.\n  # This focuses on cardinal directions, as ACTION_USE typically applies to what's directly in front.\n  RELATIVE_TO_REQUIRED_DIR = {\n      (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n      (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n      (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n      (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_cell_in_front(pos, direction):\n      y, x = pos\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return None # Should not happen with valid directions\n\n  # Breadth-First Search (BFS) to find a path to the primitive, ensuring the agent\n  # ends up at a position AND orientation suitable for collection.\n  def _find_path_and_orientation_for_collection(start_pos, start_dir, full_grid, primitive_id, world, max_steps):\n      grid_height, grid_width, _ = full_grid.shape\n      impassable_kinds = world.non_grabbable_indices\n      # A primitive is \"traversable\" if it's not in the set of impassable kinds.\n      # Agent can stand on a traversable primitive to collect it.\n      primitive_is_traversable = primitive_id not in impassable_kinds\n\n      # V2 Improvement 1: Immediate collection check for efficiency.\n      # If the agent starts directly on a traversable primitive, no path finding is needed.\n      if primitive_is_traversable and full_grid[start_pos[0], start_pos[1], primitive_id] > 0:\n          return ([], (0, 0)) # Agent is on the primitive, no moves needed, relative target (0,0)\n\n      # BFS state: (current_y, current_x, current_dir, path_of_actions)\n      q = collections.deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n      # These moves are cardinal and also determine the new facing direction.\n      moves_options = [\n          (-1, 0, ACTION_UP, DIR_NORTH),\n          (1, 0, ACTION_DOWN, DIR_SOUTH),\n          (0, -1, ACTION_LEFT, DIR_WEST),\n          (0, 1, ACTION_RIGHT, DIR_EAST)\n      ]\n\n      while q:\n          curr_y, curr_x, curr_dir, path_actions = q.popleft()\n          \n          # Check for path length limit (reserving at least 1 step for ACTION_USE)\n          if len(path_actions) >= max_steps - 1:\n              continue # Skip expanding paths that are already too long\n\n          # --- Goal Check 1: Primitive is on the current cell and agent can pick it up directly ---\n          # This check is still necessary within the BFS for exploring other possible direct collection points\n          # beyond the start_pos, if the initial check didn't apply.\n          if primitive_is_traversable and full_grid[curr_y, curr_x, primitive_id] > 0:\n              # If agent can move onto the primitive and it's present, this is a direct collection point.\n              # Relative coordinates (0,0) indicates target is at agent's current position.\n              return (path_actions, (0, 0)) \n\n          # --- Goal Check 2: Primitive is cardinally adjacent AND agent is facing it correctly ---\n          for rel_dy, rel_dx in RELATIVE_TO_REQUIRED_DIR.keys(): \n              adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n              # Check bounds for the adjacent cell\n              if not (0 <= adj_y < grid_height and 0 <= adj_x < grid_width):\n                  continue\n\n              # Check if the adjacent cell contains the primitive\n              if full_grid[adj_y, adj_x, primitive_id] > 0:\n                  # Primitive found at (adj_y, adj_x). Now, verify agent's orientation.\n                  required_dir_for_collection = RELATIVE_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n                  if curr_dir == required_dir_for_collection:\n                      # Found a path that leads to a position AND ensures the agent is oriented correctly.\n                      return (path_actions, (rel_dy, rel_dx))\n\n          # --- Explore neighboring cells for movement ---\n          for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n              # Check bounds for the next movement cell\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if the next cell is traversable (i.e., does not contain any impassable kinds)\n              is_traversable_for_movement = True\n              for k_idx in impassable_kinds:\n                  if full_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable_for_movement = False\n                      break\n              if not is_traversable_for_movement:\n                  continue\n              \n              # Add to queue only if this new state (position and direction) hasn't been visited\n              if (next_y, next_x, new_dir_after_move) not in visited:\n                  visited.add((next_y, next_x, new_dir_after_move))\n                  q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n      return (None, None) # No path found to the primitive with correct orientation\n\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state for planning.\n  # This ensures the planning starts from a consistent base.\n  current_obs = env.reset() \n  current_state = env._current_state # Access the underlying CraftState instance\n\n  # Initial checks for early exit\n  if primitive not in current_state.world.cookbook.kinds:\n      # The specified primitive ID is not a recognized kind in the world.\n      return [] \n  if current_state.inventory[primitive] > 0:\n      # The primitive has already been collected or is present in inventory.\n      return [] \n\n  full_grid = current_state.features_dict()['features_global']\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  \n  # Find the sequence of movements and the relative target coordinates for collection.\n  path_of_moves, relative_target_coords = _find_path_and_orientation_for_collection(\n      start_pos, start_dir, full_grid, primitive, current_state.world, MAX_COLLECT_STEPS\n  )\n\n  if path_of_moves is None:\n      # No valid path was found to reach a position/orientation suitable for collection.\n      return [] \n\n  # Execute the found path of movements\n  for action in path_of_moves:\n      actions_taken.append(action)\n      # Step the environment with the current action.\n      # We ignore reward and done status as this function's goal is just to return the action sequence.\n      _, _, _ = env.step(action) \n      current_state = env._current_state # Always update the internal state after a step\n\n  # V2 Improvement 2: Simplified final USE action logic.\n  # After executing all movement actions, the agent should be at the correct position\n  # and facing the correct direction as determined by the BFS.\n  # Since CraftWorld's grid is static (items don't move unless collected), if the BFS\n  # found the primitive, it should still be present at the target location.\n  # The critical final check is whether the ACTION_USE successfully adds to inventory.\n  if len(actions_taken) < MAX_COLLECT_STEPS: # Ensure there's still capacity for the USE action\n      actions_taken.append(ACTION_USE)\n      _, _, _ = env.step(ACTION_USE)\n      current_state = env._current_state # Update state after USE\n\n      # Final verification: Confirm the primitive was successfully collected into inventory.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken # Successfully collected!\n  \n  # If path was too long to include USE, or USE failed (inventory not updated)\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:44:50.741734", "function_name": "collect", "function_body": "    # Action constants (from action_specs from CraftLab)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Direction constants for agent's facing direction (CraftState.dir)\n    # Common convention: 0=North, 1=East, 2=South, 3=West\n    DIR_NORTH = 0\n    DIR_EAST = 1\n    DIR_SOUTH = 2\n    DIR_WEST = 3\n\n    # Mapping movement actions to (delta_row, delta_col)\n    # (row, col) coordinates: row increases downwards, col increases rightwards\n    _ACTION_TO_DELTA = {\n        ACTION_UP: (-1, 0),    # Move up (decrease row)\n        ACTION_DOWN: (1, 0),   # Move down (increase row)\n        ACTION_LEFT: (0, -1),  # Move left (decrease col)\n        ACTION_RIGHT: (0, 1)   # Move right (increase col)\n    }\n\n    # Mapping movement actions to the resulting agent's facing direction.\n    # Assumption: Moving in a cardinal direction makes the agent face that direction.\n    _ACTION_TO_DIR = {\n        ACTION_UP: DIR_NORTH,\n        ACTION_DOWN: DIR_SOUTH,\n        ACTION_LEFT: DIR_WEST,\n        ACTION_RIGHT: DIR_EAST\n    }\n\n    # Mapping agent's facing direction to (delta_row, delta_col) for the cell directly in front.\n    _DIR_TO_DELTA = {\n        DIR_NORTH: (-1, 0),\n        DIR_EAST: (0, 1),\n        DIR_SOUTH: (1, 0),\n        DIR_WEST: (0, -1)\n    }\n\n    current_state = env._current_state\n    \n    # 1. Check if the primitive is already in the inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n    \n    start_r, start_c = current_state.pos\n    start_dir = current_state.dir  # Agent's initial facing direction\n\n    # Get indices of impassable entities from the cookbook's environment set.\n    # These are assumed to be obstacles the agent cannot walk through.\n    impassable_indices = current_state.world.cookbook.environment\n\n    # BFS queue: stores (row, col, facing_direction, list_of_actions_taken)\n    q = collections.deque()\n    q.append((start_r, start_c, start_dir, []))\n\n    # Set to keep track of visited states (position and facing direction) to avoid cycles\n    visited = set()\n    visited.add((start_r, start_c, start_dir))\n\n    # Helper function to check if a cell is within bounds and walkable\n    def is_walkable(r, c):\n        # Check bounds\n        if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n            return False\n        # Check if the cell contains any impassable entity\n        for idx in impassable_indices:\n            if grid[r, c, idx] > 0:  # If quantity of impassable item is > 0\n                return False\n        return True\n\n    while q:\n        r, c, d, path = q.popleft()\n\n        # Check if the agent is currently in a position to USE the primitive\n        # This means the cell directly in front of the agent (based on 'd') contains the primitive.\n        dr_face, dc_face = _DIR_TO_DELTA[d]\n        target_r, target_c = r + dr_face, c + dc_face\n\n        # Verify the target cell is within bounds and contains the primitive\n        if (0 <= target_r < WIDTH and 0 <= target_c < HEIGHT and \n            grid[target_r, target_c, primitive] > 0):\n            # Agent is in the correct position and facing the primitive.\n            # Append the USE action and return the complete path.\n            return path + [ACTION_USE]\n\n        # Explore possible movement actions\n        for action_move, (dr, dc) in _ACTION_TO_DELTA.items():\n            nr, nc = r + dr, c + dc\n            \n            # Check if the new position is walkable\n            if not is_walkable(nr, nc):\n                continue\n            \n            # Determine the new facing direction after this movement.\n            # (Based on the assumption that movement aligns facing direction)\n            nd = _ACTION_TO_DIR[action_move]\n\n            # If this (position, direction) state has not been visited, add it to the queue\n            if (nr, nc, nd) not in visited:\n                visited.add((nr, nc, nd))\n                q.append((nr, nc, nd, path + [action_move]))\n    \n    # If the BFS completes and no path to collect the primitive is found, return an empty list.\n    return []", "island_id": 8, "scores": {"3": -1}}
