{"timestamp": "2025-07-30T16:52:49.665151", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dy == 1 and dx == 0: return SOUTH_DIR\n    if dy == -1 and dx == 0: return NORTH_DIR\n    return None # Should not happen if agent_pos and item_pos are cardinally adjacent\n\n  # Helper function: Checks if a cell is traversable (no non-grabbable items)\n  def _is_traversable(grid, x, y, non_grabbable_indices, grid_width, grid_height):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item (obstacle) is at (x, y)\n    for k_idx in non_grabbable_indices:\n      if grid[y, x, k_idx] == 1:\n        return False\n    return True\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Get non-grabbable indices for traversability check\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Prepare BFS goal states: ((agent_adj_x, agent_adj_y, agent_facing_dir), (primitive_x, primitive_y))\n  # A BFS goal state is a (position, direction) from which the primitive can be 'USE'd.\n  bfs_goal_states = []\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells for the agent to stand on\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (dx_adj, dy_adj) from item to agent\n      adj_x, adj_y = item_x + dx_adj, item_y + dy_adj\n\n      if _is_traversable(grid, adj_x, adj_y, non_grabbable_indices, grid_width, grid_height):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_goal_states.append(((adj_x, adj_y, required_dir), (item_x, item_y)))\n  \n  if not bfs_goal_states:\n    return [] # No traversable adjacent positions to any primitive instance\n\n  # BFS setup\n  # Queue stores (x, y, dir) tuples\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Parent map to reconstruct the path: {child_state: (parent_state, action_to_child)}\n  parent_map = {} \n  \n  found_goal_state = None # Stores the (x, y, dir) of the goal state once found\n\n  # Action definitions for BFS exploration:\n  movement_deltas = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n  \n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state is one of the goal states\n    for (goal_x, goal_y, goal_dir), _ in bfs_goal_states:\n      if (curr_x, curr_y, curr_dir) == (goal_x, goal_y, goal_dir):\n        found_goal_state = (curr_x, curr_y, curr_dir)\n        break # Found the shortest path to a goal\n    if found_goal_state is not None:\n      break # Exit BFS as soon as the shortest path is found\n\n    # Explore neighbors through movement actions (agent's direction doesn't change)\n    for action, (dx, dy) in movement_deltas.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = curr_dir # Direction remains the same after movement\n\n      next_state = (next_x, next_y, next_dir)\n      if _is_traversable(grid, next_x, next_y, non_grabbable_indices, grid_width, grid_height):\n        if next_state not in visited:\n          visited.add(next_state)\n          parent_map[next_state] = ((curr_x, curr_y, curr_dir), action)\n          queue.append(next_state)\n    \n    # Explore neighbors through turning actions (position doesn't change)\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      next_x, next_y = curr_x, curr_y # Position does not change for a pure turn\n      \n      # Calculate new direction based on the turn action\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4 # Turn clockwise\n      \n      next_state = (next_x, next_y, next_dir)\n      if next_state not in visited:\n        visited.add(next_state)\n        parent_map[next_state] = ((curr_x, curr_y, curr_dir), turn_action)\n        queue.append(next_state)\n\n  if found_goal_state is None:\n    return [] # No path found to any primitive's collection point\n\n  # Reconstruct the path from the goal state back to the initial state\n  actions = []\n  curr_state = found_goal_state\n  initial_state = (initial_agent_x, initial_agent_y, initial_agent_dir)\n\n  while curr_state != initial_state:\n    parent_state, action = parent_map[curr_state]\n    actions.insert(0, action) # Prepend action to build path in correct order\n    curr_state = parent_state\n  \n  # Finally, append the USE action after reaching the correct position and facing direction.\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T16:54:28.802500", "function_name": "collect", "function_body": "  actions = []\n\n  # Get current state from the environment's internal state\n  # `env` is a CraftLab instance, `_current_state` holds the CraftState\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos\n  inventory = current_state.inventory\n  \n  # Get world configuration details from the state\n  # These are needed for determining traversable cells\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n  \n  # Check if primitive is already collected in inventory\n  if inventory[primitive] > 0:\n      return []\n\n  # Define grid dimensions\n  grid_height, grid_width, _ = grid.shape\n\n  # Helper function to check if a cell is valid and traversable\n  def is_valid_and_traversable(r, c):\n      # Check bounds\n      if not (0 <= r < grid_height and 0 <= c < grid_width):\n          return False\n      # Check if the cell contains any non-traversable entity\n      # A cell is non-traversable if it contains any item from non_grabbable_indices\n      # This assumes non_grabbable_indices means \"cannot walk on/through\"\n      for kind_idx in non_grabbable_indices:\n          if grid[r, c, kind_idx] > 0:\n              return False\n      return True\n  \n  # Pre-calculate primitive locations on the grid\n  # These are the cells that contain the target primitive\n  primitive_locations = []\n  for r in range(grid_height):\n      for c in range(grid_width):\n          if grid[r, c, primitive] > 0:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      # Primitive not found anywhere on the grid\n      return []\n\n  # Action constants (from CraftLab.action_specs())\n  # Assuming these are globally defined or accessible if not defined in the function\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # BFS for shortest path to a cell adjacent to the primitive\n  # State for BFS: (row, col, list_of_actions_taken_to_reach_here)\n  q = collections.deque([(current_pos[0], current_pos[1], [])])\n  visited = set([(current_pos[0], current_pos[1])]) # Keep track of visited (r,c) cells\n\n  best_path_to_adjacent = []\n  found_path = False\n\n  while q and not found_path:\n      r, c, path_so_far = q.popleft()\n\n      # Check if any neighbor of the current cell (r,c) contains the primitive\n      # The agent needs to be adjacent to the primitive to USE it\n      # Iterate over potential neighbor deltas: (dr, dc)\n      # Assuming 4-directional adjacency for USE action\n      for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # North, South, West, East\n          nr, nc = r + dr, c + dc\n          # If the neighbor cell contains the primitive\n          if (nr, nc) in primitive_locations:\n              # We found a path to a cell (r,c) that is adjacent to the primitive\n              best_path_to_adjacent = list(path_so_far) # Copy the path\n              best_path_to_adjacent.append(USE) # Append the USE action\n              found_path = True\n              break # Stop searching from this path, we found a solution\n      \n      if found_path:\n          break # Exit the main BFS loop\n\n      # If not adjacent to primitive yet, explore traversable neighbors\n      # Map movement actions to their corresponding (dr, dc)\n      # These are cardinal movements (N, S, W, E)\n      moves = [\n          (UP, r - 1, c),    # Move North\n          (DOWN, r + 1, c),  # Move South\n          (LEFT, r, c - 1),  # Move West\n          (RIGHT, r, c + 1)  # Move East\n      ]\n\n      for action, next_r, next_c in moves:\n          # Check if the next cell is valid and traversable, and not yet visited\n          if is_valid_and_traversable(next_r, next_c) and (next_r, next_c) not in visited:\n              visited.add((next_r, next_c)) # Mark as visited\n              new_path = list(path_so_far) # Create a new path list\n              new_path.append(action)      # Add the movement action\n              q.append((next_r, next_c, new_path)) # Add to queue for further exploration\n    \n  return best_path_to_adjacent", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:54:28.913779", "function_name": "collect", "function_body": "    # 0. Early exit: If the primitive is already in inventory, no actions needed.\n    if env._current_state.inventory[primitive] > 0:\n        return []\n\n    # Get action mappings from the environment's action_specs\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    # Define movement deltas (dx, dy) corresponding to each action.\n    # Assuming (0,0) is top-left, x increases right, y increases down on the grid.\n    move_deltas = {\n        DOWN: (0, 1),\n        UP: (0, -1),\n        LEFT: (-1, 0),\n        RIGHT: (1, 0)\n    }\n\n    # Get current state information from the CraftLab environment\n    state = env._current_state\n    grid = state.grid\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n    agent_pos = state.pos\n    # `non_grabbable_indices` are entities that cannot be picked up.\n    # In this context, we assume they also represent impassable obstacles.\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # 1. Early exit: If the agent is already adjacent to (or on) the primitive,\n    # a single USE action is sufficient. `state.next_to` checks the 3x3 vicinity.\n    if state.next_to(primitive):\n        return [USE]\n\n    # 2. Find all grid locations where the primitive item exists.\n    # `np.argwhere` returns (x, y) coordinates for a (WIDTH, HEIGHT, N_KINDS) grid.\n    primitive_coords = np.argwhere(grid[:, :, primitive] > 0)\n\n    if len(primitive_coords) == 0:\n        return [] # Primitive not found anywhere on the grid.\n\n    # 3. Identify all valid and traversable grid cells that are directly adjacent (4-way)\n    # to any primitive item. These cells are our targets for movement.\n    potential_target_cells = set()\n    for px, py in primitive_coords:\n        # Check the 4 direct neighbors of the primitive's location\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = px + dx, py + dy\n            \n            # Check if the neighbor cell is within grid boundaries\n            if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n                # Check if the potential target cell is an obstacle (non-grabbable item).\n                # An obstacle is a cell containing any item from `non_grabbable_indices`.\n                is_obstacle = False\n                # Ensure `non_grabbable_indices` is not empty before attempting to slice `grid` with it.\n                if len(non_grabbable_indices) > 0:\n                    # `np.any` checks if any of the specified obstacle kinds are present at (nx, ny)\n                    if np.any(grid[nx, ny, list(non_grabbable_indices)] > 0):\n                        is_obstacle = True\n\n                if not is_obstacle:\n                    potential_target_cells.add((nx, ny))\n\n    if not potential_target_cells:\n        # No reachable adjacent cells to any primitive were found (e.g., all are obstacles).\n        return []\n\n    # 4. Perform a Breadth-First Search (BFS) to find the shortest sequence of\n    # movement actions from the agent's current position to any of the\n    # `potential_target_cells`.\n    # Using `collections.deque` for efficient popleft.\n    queue = collections.deque()\n    # Queue elements are tuples: ((current_x, current_y), [list_of_actions_to_reach_here])\n    queue.append((agent_pos, []))\n    # `visited` set tracks grid coordinates to prevent cycles and redundant paths.\n    visited = {agent_pos}\n\n    while queue:\n        (curr_x, curr_y), path_so_far = queue.popleft()\n\n        # If the current position is one of our target cells,\n        # we have found the shortest path.\n        if (curr_x, curr_y) in potential_target_cells:\n            # Append the USE action to the path and return it.\n            return path_so_far + [USE]\n\n        # Explore all valid neighboring cells\n        for action, (dx, dy) in move_deltas.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_pos = (next_x, next_y)\n\n            # Check if the next cell is within grid boundaries and has not been visited yet.\n            if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT and next_pos not in visited:\n                # Check if the next cell is an obstacle.\n                is_obstacle = False\n                if len(non_grabbable_indices) > 0:\n                    if np.any(grid[next_x, next_y, list(non_grabbable_indices)] > 0):\n                        is_obstacle = True\n\n                if not is_obstacle:\n                    # Mark as visited and add to the queue with the updated path.\n                    visited.add(next_pos)\n                    queue.append((next_pos, path_so_far + [action]))\n\n    # If the queue becomes empty and no target cell was reached, it means\n    # the primitive is unreachable from the current agent's position.\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:55:55.451705", "function_name": "collect", "function_body": "  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Define direction constants (assuming 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  _DIR_UP = 0\n  _DIR_RIGHT = 1\n  _DIR_DOWN = 2\n  _DIR_LEFT = 3\n\n  # Helper function to calculate turn actions\n  def _get_turn_actions(current_dir, target_dir):\n      turn_actions = []\n      \n      # Calculate shortest rotation\n      # (target_dir - current_dir + 4) % 4 gives 0 for no change, 1 for one right turn,\n      # 2 for two turns (180 deg), 3 for one left turn.\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # One clockwise turn needed\n          turn_actions.append(_RIGHT)\n      elif diff == 2: # Two turns needed (180 degrees)\n          turn_actions.extend([_RIGHT, _RIGHT]) # Or two LEFT, same cost\n      elif diff == 3: # One counter-clockwise turn needed\n          turn_actions.append(_LEFT)\n      \n      return turn_actions\n\n  actions_to_take = []\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Get current agent direction (convert one-hot array to integer)\n  current_dir_int = np.argmax(features_dict['direction'])\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell\n      if current_grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  min_total_path_cost = float('inf')\n  best_action_sequence = []\n\n  # Iterate through all primitive locations to find the one that is reachable with minimum cost\n  for target_x, target_y in primitive_locations:\n    # Consider 4 possible adjacent positions from which the agent can USE the item.\n    # The agent needs to be at (adj_x, adj_y) and facing 'target_face_dir' to use the item at (target_x, target_y).\n    potential_interaction_points = []\n    \n    # Candidate 1: Agent at (target_x - 1, target_y) needs to face RIGHT\n    if target_x - 1 >= 0:\n      potential_interaction_points.append((target_x - 1, target_y, _DIR_RIGHT))\n    \n    # Candidate 2: Agent at (target_x + 1, target_y) needs to face LEFT\n    if target_x + 1 < WIDTH:\n      potential_interaction_points.append((target_x + 1, target_y, _DIR_LEFT))\n\n    # Candidate 3: Agent at (target_x, target_y - 1) needs to face DOWN\n    if target_y - 1 >= 0:\n      potential_interaction_points.append((target_x, target_y - 1, _DIR_DOWN))\n    \n    # Candidate 4: Agent at (target_x, target_y + 1) needs to face UP\n    if target_y + 1 < HEIGHT:\n      potential_interaction_points.append((target_x, target_y + 1, _DIR_UP))\n    \n    # If no valid adjacent spots (e.g., target is on a 1x1 map's corner), skip this primitive\n    if not potential_interaction_points:\n        continue\n\n    # For each possible interaction point around the primitive\n    for adj_x, adj_y, target_face_dir in potential_interaction_points:\n        # Simulate agent movement and direction changes to reach this point\n        sim_px, sim_py = current_pos\n        sim_dir = current_dir_int # Agent's current direction at the start of this path simulation\n        current_path_actions = []\n\n        # Phase 1: Move to the adjacent position (adj_x, adj_y)\n        # This implements a simple Manhattan path: horizontal moves first, then vertical.\n        # Agent's direction updates based on the last movement action.\n        \n        # Horizontal movement\n        while sim_px != adj_x:\n            if sim_px < adj_x:\n                current_path_actions.append(_RIGHT)\n                sim_px += 1\n                sim_dir = _DIR_RIGHT # Agent now faces RIGHT\n            else: # sim_px > adj_x\n                current_path_actions.append(_LEFT)\n                sim_px -= 1\n                sim_dir = _DIR_LEFT # Agent now faces LEFT\n\n        # Vertical movement\n        while sim_py != adj_y:\n            if sim_py < adj_y:\n                current_path_actions.append(_DOWN)\n                sim_py += 1\n                sim_dir = _DIR_DOWN # Agent now faces DOWN\n            else: # sim_py > adj_y\n                current_path_actions.append(_UP)\n                sim_py -= 1\n                sim_dir = _DIR_UP # Agent now faces UP\n\n        # Phase 2: After reaching (adj_x, adj_y), adjust direction to face the primitive\n        turn_actions = _get_turn_actions(sim_dir, target_face_dir)\n        current_path_actions.extend(turn_actions)\n        \n        # Phase 3: Finally, USE the primitive\n        current_path_actions.append(_USE)\n\n        total_path_cost = len(current_path_actions)\n\n        # Update best path if this path is shorter\n        if total_path_cost < min_total_path_cost:\n            min_total_path_cost = total_path_cost\n            best_action_sequence = current_path_actions\n  \n  return best_action_sequence", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T16:55:56.423425", "function_name": "collect", "function_body": "  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  actions_to_take = []\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell\n      if current_grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path to any primitive location\n  # Queue stores tuples: ((current_x, current_y), [path_actions_to_reach_here])\n  q = collections.deque()\n  q.append((current_pos, [])) \n  \n  # Set to store visited positions to avoid cycles and re-processing longer paths\n  visited = {current_pos} \n\n  # Define possible movements and their corresponding actions\n  # (dx, dy): action\n  moves = {\n      (0, -1): _UP,\n      (0, 1): _DOWN,\n      (-1, 0): _LEFT,\n      (1, 0): _RIGHT\n  }\n\n  # Obstacle check function: A cell is considered an obstacle if it contains\n  # any non-grabbable item. The target primitive itself is grabbable,\n  # so it will not be in `non_grabbable_indices`.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle).\"\"\"\n    for k in non_grabbable_items_set:\n      if grid[x, y, k] == 1:\n        return True\n    return False\n\n  target_found_path = None\n\n  while q:\n    (cx, cy), current_path = q.popleft()\n\n    # If the current position contains the primitive, we found a path.\n    # Since it's BFS, this is guaranteed to be the shortest path to *a* primitive.\n    if current_grid[cx, cy, primitive] == 1:\n      target_found_path = current_path\n      break # Exit BFS as the shortest path is found\n\n    # Explore neighbors\n    for (dx, dy), action in moves.items():\n      nx, ny = cx + dx, cy + dy\n\n      # Check boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if already visited\n      if (nx, ny) in visited:\n        continue\n\n      # Check if the neighbor cell is an obstacle\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n\n      # If the neighbor is valid and not an obstacle, add it to the queue\n      new_path = current_path + [action]\n      q.append(((nx, ny), new_path))\n      visited.add((nx, ny))\n  \n  # If a path was found, append the USE action and return it\n  if target_found_path is not None:\n    actions_to_take = target_found_path + [_USE]\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T16:56:53.077978", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Direction constants (0=N, 1=E, 2=S, 3=W clockwise from North)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Map movement actions to the direction the agent faces after taking that action\n  ACTION_TO_DIR_MAP = {\n      UP_ACTION: NORTH_DIR,\n      RIGHT_ACTION: EAST_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR\n  }\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"Calculates the direction the agent needs to face to look at the item.\n    Assumes item is exactly one cardinal step away from agent.\n    \"\"\"\n    if item_x > agent_x: return EAST_DIR\n    if item_x < agent_x: return WEST_DIR\n    if item_y > agent_y: return SOUTH_DIR\n    if item_y < agent_y: return NORTH_DIR\n    return None # Should only happen if agent_x,y == item_x,y, or item is diagonal.\n\n  def _get_turn_actions(current_dir, target_dir):\n    \"\"\"Returns a list of actions to turn from current_dir to target_dir.\"\"\"\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    # Calculate shortest turns (clockwise vs. counter-clockwise)\n    # Adding 4 and modulo 4 ensures positive results for subtraction\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      # Assuming RIGHT_ACTION makes agent turn clockwise (e.g., N->E)\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION)\n    else:\n      # Assuming LEFT_ACTION makes agent turn counter-clockwise (e.g., N->W)\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION)\n    return actions\n\n  # Get primitive's integer ID\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir\n  # grid.shape is (HEIGHT, WIDTH, KINDS)\n  grid_height, grid_width, _ = grid.shape \n\n  # Impassable items are those that cannot be picked up or moved through.\n  # The `non_grabbable_indices` set from CraftWorld is a good proxy for obstacles.\n  impassable_kinds = env.world.non_grabbable_indices\n\n  def is_passable(x, y):\n    \"\"\"Checks if a cell (x, y) is within bounds and does not contain impassable objects.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    \n    # Check if the cell contains any impassable kind\n    for kind_idx in impassable_kinds:\n      if grid[y, x, kind_idx] == 1:\n        return False # Contains an impassable object\n    return True\n\n  # Find all locations of the primitive on the grid\n  # np.where returns (row_indices, col_indices) which correspond to (y_coords, x_coords)\n  primitive_locations = []\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n  for i in range(len(x_coords)):\n    primitive_locations.append((x_coords[i], y_coords[i]))\n\n  if not primitive_locations:\n    return [] # Primitive not found on the grid\n\n  # --- BFS to find the shortest path to an adjacent cell of any primitive ---\n  # Queue stores (x, y, current_direction, path_actions_taken)\n  q = collections.deque([(agent_pos_x, agent_pos_y, agent_dir, [])])\n  # Visited set stores (x, y) tuples to prevent cycles and re-exploring\n  visited = set([(agent_pos_x, agent_pos_y)])\n\n  # Movement deltas for cardinal directions\n  move_deltas = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  while q:\n    curr_x, curr_y, curr_dir, path = q.popleft()\n\n    # Check if the current position is adjacent to any primitive\n    # We prioritize this check because if we're already adjacent, we just need to turn and USE.\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Cardinal neighbors\n      check_item_x, check_item_y = curr_x + dx, curr_y + dy\n      if (check_item_x, check_item_y) in primitive_locations:\n        # Found an adjacent primitive! Calculate final actions.\n        target_face_dir = _get_target_facing_direction(curr_x, curr_y, check_item_x, check_item_y)\n        if target_face_dir is not None:\n          turn_actions = _get_turn_actions(curr_dir, target_face_dir)\n          return path + turn_actions + [USE_ACTION]\n        # else: This should not happen for valid adjacent primitive, but skip if it does.\n\n    # Explore neighbors (move actions)\n    for action, (dx, dy) in move_deltas.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = ACTION_TO_DIR_MAP[action] # Agent faces in the direction of movement\n\n      if (next_x, next_y) not in visited and is_passable(next_x, next_y):\n        visited.add((next_x, next_y))\n        q.append((next_x, next_y, next_dir, path + [action]))\n  \n  # If the queue is empty and no path was found, the primitive is unreachable.\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T16:56:54.061184", "function_name": "collect", "function_body": "  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Direction constants (assuming 0=N, 1=E, 2=S, 3=W clockwise from North)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Map movement actions to the direction the agent faces after taking that action\n  ACTION_TO_DIR_MAP = {\n      DOWN_ACTION: SOUTH_DIR,\n      UP_ACTION: NORTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  def _get_action_for_move_xy(current_x, current_y, target_x, target_y):\n    \"\"\"Returns the single action to move towards target_x, target_y from current_x, current_y.\n    Prioritizes horizontal movement if not at target_x, otherwise vertical.\n    \"\"\"\n    if target_x > current_x: return RIGHT_ACTION\n    if target_x < current_x: return LEFT_ACTION\n    if target_y > current_y: return DOWN_ACTION  # Y increases downwards (row index increases)\n    if target_y < current_y: return UP_ACTION    # Y decreases upwards (row index decreases)\n    return None # Already at target x or y\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"Calculates the direction the agent needs to face to look at the item.\n    Assumes item is adjacent (cardinally) to agent_x, agent_y.\n    \"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 0 and dy == 0:\n      return None # Agent is on top of item, or item is not truly adjacent\n\n    if abs(dx) > abs(dy):\n      return EAST_DIR if dx > 0 else WEST_DIR\n    elif abs(dy) > abs(dx):\n      return SOUTH_DIR if dy > 0 else NORTH_DIR\n    # This else branch should ideally not be hit if item is cardinal adjacent.\n    # For a purely adjacent item, one of dx or dy will be zero and the other non-zero.\n    # This handles cases where dx or dy is zero (e.g. (0,1) -> South_dir).\n    else: # Should mean dx != 0 and dy != 0 and abs(dx) == abs(dy), e.g., diagonal, or dx=0, dy=0\n        if dy > 0: return SOUTH_DIR\n        if dy < 0: return NORTH_DIR\n        if dx > 0: return EAST_DIR\n        if dx < 0: return WEST_DIR\n    return None\n\n  def _get_turn_actions(current_dir, target_dir):\n    \"\"\"Returns a list of actions to turn from current_dir to target_dir.\"\"\"\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    # Calculate shortest turns (clockwise vs. counter-clockwise)\n    # Adding 4 and modulo 4 ensures positive results for subtraction (e.g., 0 - 3 = -3, (-3+4)%4 = 1)\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION) # Assuming RIGHT_ACTION makes agent turn clockwise\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION) # Assuming LEFT_ACTION makes agent turn counter-clockwise\n    return actions\n\n  # Get primitive's integer ID\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  initial_agent_dir = current_state.dir # Store initial direction\n\n  # grid.shape is (HEIGHT, WIDTH, KINDS)\n  grid_height, grid_width, _ = grid.shape\n\n  # Find all locations of the primitive on the grid\n  # np.where returns (row_indices, col_indices) which correspond to (y_coords, x_coords)\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Find the closest primitive location to the agent's current position (Manhattan distance)\n  min_distance = float('inf')\n  closest_primitive_pos = None\n\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    distance = abs(item_x - agent_pos_x) + abs(item_y - agent_pos_y)\n    if distance < min_distance:\n      min_distance = distance\n      closest_primitive_pos = (item_x, item_y)\n\n  target_item_x, target_item_y = closest_primitive_pos\n\n  # Determine the target adjacent position for the agent to move to.\n  # We look for the adjacent cardinal cell that is closest to the agent's current position.\n  candidate_adj_positions = []\n  # Iterate over cardinal neighbors relative to the item\n  for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (left, right, up, down)\n    adj_x, adj_y = target_item_x + dx, target_item_y + dy\n    # Check if the candidate adjacent position is within grid boundaries\n    if 0 <= adj_x < grid_width and 0 <= adj_y < grid_height:\n      candidate_adj_positions.append((adj_x, adj_y))\n\n  if not candidate_adj_positions:\n    return [] # Should not happen unless the primitive is stuck in a 1x1 area with no accessible neighbors\n\n  # Select the candidate adjacent position that is closest to the agent's initial position\n  min_adj_distance = float('inf')\n  chosen_adj_pos = None\n  for adj_x, adj_y in candidate_adj_positions:\n    distance = abs(adj_x - agent_pos_x) + abs(adj_y - agent_pos_y)\n    if distance < min_adj_distance:\n      min_adj_distance = distance\n      chosen_adj_pos = (adj_x, adj_y)\n\n  if chosen_adj_pos is None:\n    return [] # No valid adjacent position found (e.g., primitive is at a corner with no space)\n\n  # Generate movement actions to reach the chosen_adj_pos,\n  # while continuously updating the conceptual agent position and direction.\n  actions = []\n  curr_x, curr_y = agent_pos_x, agent_pos_y\n  curr_dir = initial_agent_dir # Current conceptual direction of the agent\n\n  target_x, target_y = chosen_adj_pos\n\n  # Pathfinding: First move horizontally, then vertically (L-shaped path).\n  # Update conceptual position and direction after each move.\n  while curr_x != target_x:\n    move_action = _get_action_for_move_xy(curr_x, curr_y, target_x, target_y)\n    actions.append(move_action)\n    # Update conceptual position\n    if move_action == RIGHT_ACTION: curr_x += 1\n    elif move_action == LEFT_ACTION: curr_x -= 1\n    # Update conceptual direction based on the movement action\n    curr_dir = ACTION_TO_DIR_MAP[move_action]\n\n  while curr_y != target_y:\n    move_action = _get_action_for_move_xy(curr_x, curr_y, target_x, target_y)\n    actions.append(move_action)\n    # Update conceptual position\n    if move_action == DOWN_ACTION: curr_y += 1\n    elif move_action == UP_ACTION: curr_y -= 1\n    # Update conceptual direction based on the movement action\n    curr_dir = ACTION_TO_DIR_MAP[move_action]\n\n  # After movement, the agent is conceptually at `chosen_adj_pos`.\n  # `curr_dir` holds the direction the agent is facing after the last movement action (or initial if no moves).\n  # Now, determine the direction the agent needs to face to look at the primitive from this adjacent position.\n  target_face_dir = _get_target_facing_direction(curr_x, curr_y, target_item_x, target_item_y)\n\n  if target_face_dir is not None:\n    # Add turning actions to face the primitive, based on the agent's current conceptual direction\n    # and the required final facing direction.\n    actions.extend(_get_turn_actions(curr_dir, target_face_dir))\n\n  # Add the USE action to collect the primitive\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T16:58:18.700863", "function_name": "collect", "function_body": "  actions_taken = []\n  \n  # Get action integer IDs from the environment's action_specs\n  action_map = env.action_specs()\n  \n  # Get references to world and cookbook for item type information\n  world = env.world\n  cookbook = world.cookbook\n  \n  # Define a reasonable max number of steps to prevent infinite loops\n  MAX_COLLECT_STEPS = 200 \n\n  # Check if the primitive is a known grabbable item.\n  # If it's a crafted item (in recipes) or a non-grabbable environment item,\n  # this function is not designed to handle its collection.\n  # We assume 'primitive' refers to something that can be picked up from the grid.\n  if primitive not in world.grabbable_indices:\n      # If it's not grabbable, we can't collect it with this function.\n      # A more advanced version might handle crafting.\n      return []\n\n  # Main loop for finding and collecting the primitive\n  for _ in range(MAX_COLLECT_STEPS):\n    current_state = env._current_state # Direct access to the internal CraftState\n    \n    # 1. Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n      return actions_taken # Goal achieved\n\n    current_pos = current_state.pos # Agent's current (x, y) position\n    grid = current_state.grid       # The current grid layout (WIDTH, HEIGHT, n_kinds)\n    \n    target_pos = None\n    min_dist = float('inf')\n    \n    # 2. Search for the closest instance of the primitive on the grid\n    grid_width, grid_height, _ = grid.shape\n    for x, y in product(range(grid_width), range(grid_height)):\n      if grid[x, y, primitive] == 1: # If the primitive is present at (x, y)\n        # Calculate Manhattan distance\n        dist = abs(x - current_pos[0]) + abs(y - current_pos[1])\n        if dist < min_dist:\n          min_dist = dist\n          target_pos = (x, y)\n    \n    # 3. If the primitive is not found on the map, we cannot collect it.\n    if target_pos is None:\n      return actions_taken # Primitive seems to be gone or not available\n\n    # 4. Determine the next action (move or use)\n    action_to_take = None\n    \n    # If the agent is in the 3x3 neighborhood of the primitive (or on its cell)\n    if current_state.next_to(primitive):\n      action_to_take = action_map['USE'] # Use action to collect\n    else:\n      # Move towards the target position\n      tx, ty = target_pos\n      px, py = current_pos\n      \n      # Prioritize horizontal movement, then vertical\n      if px < tx:\n        action_to_take = action_map['RIGHT']\n      elif px > tx:\n        action_map['LEFT']\n      elif py < ty:\n        action_to_take = action_map['DOWN']\n      elif py > ty:\n        action_to_take = action_map['UP']\n      # If px == tx and py == ty, it means we are on the target cell,\n      # and `next_to(primitive)` should have caught it, leading to 'USE'.\n      # This 'else' branch implies we are stuck or logic error.\n\n    # 5. Execute the determined action\n    if action_to_take is not None:\n      # Perform the step in the environment\n      _reward, done, _observations = env.step(action_to_take)\n      actions_taken.append(action_to_take)\n      \n      # If the environment indicates the episode is done (e.g., max_steps reached)\n      if done:\n        break\n    else:\n      # If no valid action could be determined (e.g., agent is stuck)\n      break\n            \n  return actions_taken", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T16:58:18.773455", "function_name": "collect", "function_body": "    import collections\n\n    # Action constants (from CraftLab.action_specs)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    actions_taken = []\n    \n    # Get initial state and check initial inventory for the primitive\n    obs = env.observations()\n    initial_inventory_count = obs['features_dict']['inventory'][primitive]\n\n    # Maximum number of high-level collection loops to prevent infinite execution.\n    # Each loop can involve one movement step or one USE action.\n    MAX_COLLECT_LOOPS = 200 \n\n    for _ in range(MAX_COLLECT_LOOPS):\n        obs = env.observations()\n        current_state = env._current_state # Access the internal CraftState\n\n        # 1. Check if the primitive is already collected (inventory count increased)\n        if obs['features_dict']['inventory'][primitive] > initial_inventory_count:\n            return actions_taken\n\n        # 2. Check if the agent is currently next to the primitive\n        if current_state.next_to(primitive):\n            # If next to it, attempt to USE the item\n            _, _, _ = env.step(USE)\n            actions_taken.append(USE)\n            # After using, the loop will re-evaluate the state,\n            # checking if the item has been collected.\n            continue \n\n        # 3. If not next to and not collected, find the primitive and pathfind to it\n        current_pos = current_state.pos # Agent's (row, col) position\n        grid = current_state.grid # (HEIGHT, WIDTH, n_kinds)\n        height, width, _ = grid.shape\n        \n        # Get non-grabbable indices from the cookbook for obstacle checking\n        world_cookbook = current_state.world.cookbook\n        non_grabbable_indices = world_cookbook.environment\n\n        # Define a helper function to check if a cell is traversable (not out of bounds or an obstacle)\n        def is_traversable(r, c):\n            if not (0 <= r < height and 0 <= c < width):\n                return False # Out of bounds\n            # Check if the cell contains any non-grabbable items that act as obstacles\n            for kind_idx in non_grabbable_indices:\n                if grid[r, c, kind_idx] > 0:\n                    return False # Contains an obstacle\n            return True\n        \n        # Find all locations on the grid where the primitive exists\n        primitive_locations = []\n        r_coords, c_coords = np.where(grid[:, :, primitive] > 0)\n        for r, c in zip(r_coords, c_coords):\n            primitive_locations.append((r, c))\n        \n        if not primitive_locations:\n            # The primitive is not found anywhere on the map, so it cannot be collected\n            return actions_taken # Return current actions (no way to collect)\n\n        # --- BFS (Breadth-First Search) to find the shortest path to a cell adjacent to any primitive ---\n        queue = collections.deque([(current_pos, [])]) # Queue stores (agent_position, path_taken_to_this_position)\n        visited = {current_pos} # Set to keep track of visited agent positions\n\n        path_to_adjacent_cell = None # Will store the shortest path found\n\n        # Mapping of (dr, dc) movement deltas to corresponding actions\n        move_deltas_to_actions = {\n            (-1, 0): UP,\n            (1, 0): DOWN,\n            (0, -1): LEFT,\n            (0, 1): RIGHT,\n        }\n\n        while queue:\n            (r, c), path_so_far = queue.popleft()\n\n            # Check if the current agent position (r, c) is adjacent to *any* primitive location\n            for px, py in primitive_locations:\n                if abs(r - px) + abs(c - py) == 1: # Manhattan distance of 1 means direct adjacency\n                    path_to_adjacent_cell = path_so_far\n                    break # Found a path to an adjacent cell, this is the shortest due to BFS\n            \n            if path_to_adjacent_cell:\n                break # Exit BFS loop as we've found our target path\n\n            # Explore neighbors of the current agent position\n            for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Up, Down, Left, Right\n                nr, nc = r + dr, c + dc # Calculate the next potential agent position\n                next_agent_pos = (nr, nc)\n\n                if is_traversable(nr, nc) and next_agent_pos not in visited:\n                    visited.add(next_agent_pos)\n                    # Get the action required to move from (r, c) to (nr, nc)\n                    action_for_move = move_deltas_to_actions.get((dr, dc))\n                    if action_for_move is not None:\n                        queue.append((next_agent_pos, path_so_far + [action_for_move]))\n        \n        # --- End BFS ---\n\n        if path_to_adjacent_cell:\n            # Take the first action from the shortest path found\n            next_action = path_to_adjacent_cell[0]\n            _, _, _ = env.step(next_action)\n            actions_taken.append(next_action)\n        else:\n            # No path found to any primitive location (e.g., all are blocked by obstacles)\n            return actions_taken # Return current actions (cannot reach primitive)\n\n    # If MAX_COLLECT_LOOPS is reached without collecting the primitive\n    return actions_taken", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:59:14.644550", "function_name": "collect", "function_body": "  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  actions_to_take = []\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  # IMPROVEMENT: If the primitive is already in inventory, no actions are needed.\n  inventory = features_dict['inventory']\n  if inventory[primitive] > 0:\n    return []\n\n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell\n      if current_grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path to any primitive location\n  # Queue stores tuples: ((current_x, current_y), [path_actions_to_reach_here])\n  q = collections.deque()\n  q.append((current_pos, [])) \n  \n  # Set to store visited positions to avoid cycles and re-processing longer paths\n  visited = {current_pos} \n\n  # Define possible movements and their corresponding actions\n  # (dx, dy): action\n  moves = {\n      (0, -1): _UP,\n      (0, 1): _DOWN,\n      (-1, 0): _LEFT,\n      (1, 0): _RIGHT\n  }\n\n  # Obstacle check function: A cell is considered an obstacle if it contains\n  # any non-grabbable item. The target primitive itself is grabbable,\n  # so it will not be in `non_grabbable_indices`.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle).\"\"\"\n    for k in non_grabbable_items_set:\n      if grid[x, y, k] == 1:\n        return True\n    return False\n\n  target_found_path = None\n\n  while q:\n    (cx, cy), current_path = q.popleft()\n\n    # If the current position contains the primitive, we found a path.\n    # Since it's BFS, this is guaranteed to be the shortest path to *a* primitive.\n    if current_grid[cx, cy, primitive] == 1:\n      target_found_path = current_path\n      break # Exit BFS as the shortest path is found\n\n    # Explore neighbors\n    for (dx, dy), action in moves.items():\n      nx, ny = cx + dx, cy + dy\n\n      # Check boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if already visited\n      if (nx, ny) in visited:\n        continue\n\n      # Check if the neighbor cell is an obstacle\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n\n      # If the neighbor is valid and not an obstacle, add it to the queue\n      new_path = current_path + [action]\n      q.append(((nx, ny), new_path))\n      visited.add((nx, ny))\n  \n  # If a path was found, append the USE action and return it\n  if target_found_path is not None:\n    actions_to_take = target_found_path + [_USE]\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:59:15.650553", "function_name": "collect", "function_body": "  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  actions_to_take = []\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  # Improvement: Check if the primitive is already in inventory\n  current_inventory = features_dict['inventory']\n  # Use env.world.n_kinds to get the correct size of the inventory array\n  if 0 <= primitive < env.world.n_kinds and current_inventory[primitive] > 0:\n    return [] # Already have the primitive, no actions needed.\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell\n      if current_grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path to any primitive location\n  # Queue stores tuples: ((current_x, current_y), [path_actions_to_reach_here])\n  q = collections.deque()\n  q.append((current_pos, [])) \n  \n  # Set to store visited positions to avoid cycles and re-processing longer paths\n  visited = {current_pos} \n\n  # Define possible movements and their corresponding actions\n  # (dx, dy): action\n  moves = {\n      (0, -1): _UP,\n      (0, 1): _DOWN,\n      (-1, 0): _LEFT,\n      (1, 0): _RIGHT\n  }\n\n  # Obstacle check function: A cell is considered an obstacle if it contains\n  # any non-grabbable item.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle).\"\"\"\n    for k_idx in non_grabbable_items_set:\n      if grid[x, y, k_idx] == 1:\n        return True\n    return False\n\n  target_found_path = None\n\n  while q:\n    (cx, cy), current_path = q.popleft()\n\n    # If the current position contains the primitive, we found a path.\n    # Since it's BFS, this is guaranteed to be the shortest path to *a* primitive.\n    if current_grid[cx, cy, primitive] == 1:\n      target_found_path = current_path\n      break # Exit BFS as the shortest path is found\n\n    # Explore neighbors\n    for (dx, dy), action in moves.items():\n      nx, ny = cx + dx, cy + dy\n\n      # Check boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if already visited\n      if (nx, ny) in visited:\n        continue\n\n      # Check if the neighbor cell is an obstacle\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n\n      # If the neighbor is valid and not an obstacle, add it to the queue\n      new_path = current_path + [action]\n      q.append(((nx, ny), new_path))\n      visited.add((nx, ny))\n  \n  # If a path was found, append the USE action and return it\n  if target_found_path is not None:\n    actions_to_take = target_found_path + [_USE]\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:00:40.151675", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants (typically imported from a common module in a real project)\n  # For this exercise, defining them locally within the function for self-containment.\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction constants (assuming 0:N, 1:E, 2:S, 3:W as common for DMLab-like environments)\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Delta Row and Delta Column for each direction\n  # Maps direction index to (dr, dc) for moving forward\n  DR = [-1, 0, 1, 0] # N:(-1,0), E:(0,1), S:(1,0), W:(0,-1)\n  DC = [0, 1, 0, -1]\n\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos\n  current_dir = current_state.dir\n  inventory = current_state.inventory\n  # world = current_state.world # Not directly used in the BFS logic, but available for context\n\n  HEIGHT, WIDTH, _ = grid.shape # Get grid dimensions\n\n  # 1. Check if the primitive is already in inventory\n  if inventory[primitive] > 0:\n    return []\n\n  # BFS setup\n  # Queue stores tuples of (row, col, direction, list_of_actions_so_far)\n  queue = collections.deque()\n  # Visited set stores tuples of (row, col, direction) to avoid cycles and redundant paths\n  visited = set()\n\n  # Initial state: Agent's current position and direction, with an empty path\n  start_r, start_c = current_pos\n  start_d = current_dir\n  queue.append((start_r, start_c, start_d, []))\n  visited.add((start_r, start_c, start_d))\n\n  target_path = None # Will store the shortest sequence of actions if found\n\n  while queue:\n    r, c, d, path_so_far = queue.popleft()\n\n    # Calculate the cell directly in front of the agent (where 'USE' action would apply)\n    front_r, front_c = r + DR[d], c + DC[d]\n\n    # 2. Check if the cell in front is within bounds and contains the primitive\n    if 0 <= front_r < HEIGHT and 0 <= front_c < WIDTH and grid[front_r, front_c, primitive] == 1:\n      # Found a state where the primitive can be 'USE'd. This is the shortest path due to BFS.\n      target_path = path_so_far + [ACTION_USE]\n      break # Exit BFS, the shortest path has been found\n\n    # 3. Explore possible next states (movement and turns)\n    possible_moves = []\n\n    # Try moving Forward (ACTION_UP)\n    next_r_fwd, next_c_fwd = r + DR[d], c + DC[d]\n    if 0 <= next_r_fwd < HEIGHT and 0 <= next_c_fwd < WIDTH:\n      possible_moves.append((next_r_fwd, next_c_fwd, d, ACTION_UP))\n\n    # Try moving Backward (ACTION_DOWN)\n    next_r_back, next_c_back = r - DR[d], c - DC[d]\n    if 0 <= next_r_back < HEIGHT and 0 <= next_c_back < WIDTH:\n      possible_moves.append((next_r_back, next_c_back, d, ACTION_DOWN))\n\n    # Try turning Left (ACTION_LEFT)\n    next_d_left = (d - 1 + 4) % 4 # Ensure direction wraps around (0,1,2,3)\n    possible_moves.append((r, c, next_d_left, ACTION_LEFT))\n\n    # Try turning Right (ACTION_RIGHT)\n    next_d_right = (d + 1) % 4 # Ensure direction wraps around (0,1,2,3)\n    possible_moves.append((r, c, next_d_right, ACTION_RIGHT))\n\n    # Add valid, unvisited next states to the queue\n    for next_r, next_c, next_d, action_taken in possible_moves:\n      if (next_r, next_c, next_d) not in visited:\n        visited.add((next_r, next_c, next_d))\n        queue.append((next_r, next_c, next_d, path_so_far + [action_taken]))\n\n  # Return the found path or an empty list if no path was found (e.g., primitive is unreachable)\n  return target_path if target_path is not None else []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:00:40.220851", "function_name": "collect", "function_body": "    # Access current state from the environment\n    state = env._current_state\n    grid = state.grid\n    start_pos = state.pos\n    \n    height, width, _ = grid.shape\n\n    # Retrieve non-grabbable indices from the world configuration\n    # These are typically obstacles that the agent cannot move into.\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # Define movement actions and their corresponding (delta_row, delta_col)\n    # These integer values map to UP, DOWN, LEFT, RIGHT as per action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    DELTAS = {\n        ACTION_UP: (-1, 0),\n        ACTION_DOWN: (1, 0),\n        ACTION_LEFT: (0, -1),\n        ACTION_RIGHT: (0, 1),\n    }\n\n    # Queue for BFS: stores tuples of (current_position, path_taken_to_reach_here)\n    q = collections.deque([(start_pos, [])])\n    \n    # Set to keep track of visited positions to avoid cycles and redundant work\n    visited = {start_pos}\n\n    while q:\n        curr_pos, path_so_far = q.popleft()\n        curr_r, curr_c = curr_pos\n\n        # First, check if the current position is adjacent to the target primitive.\n        # If it is, we can perform the USE action to collect it.\n        for dr, dc in DELTAS.values(): # Iterate over possible relative directions\n            adj_r, adj_c = curr_r + dr, curr_c + dc\n            \n            # Check if the adjacent cell is within grid boundaries\n            if not (0 <= adj_r < height and 0 <= adj_c < width):\n                continue\n\n            # Check if the adjacent cell contains the primitive we're looking for\n            if grid[adj_r, adj_c, primitive] > 0:\n                # Found the primitive! The path to curr_pos is path_so_far.\n                # From curr_pos, we are adjacent to the primitive, so append USE action.\n                return path_so_far + [ACTION_USE]\n\n        # If not adjacent, explore valid neighboring cells for movement.\n        for action_move, (dr, dc) in DELTAS.items():\n            next_r, next_c = curr_r + dr, curr_c + dc\n            next_pos = (next_r, next_c)\n\n            # Check if the next cell is within grid boundaries\n            if not (0 <= next_r < height and 0 <= next_c < width):\n                continue\n\n            # Check if this cell has already been visited\n            if next_pos in visited:\n                continue\n\n            # Determine if the next cell is blocked (e.g., by a non-grabbable obstacle)\n            is_blocked = False\n            # Iterate through all non-grabbable item types\n            for kind_idx in non_grabbable_indices:\n                # If a non-grabbable item exists at next_pos\n                # AND it's not the primitive we are trying to collect (in case the primitive itself is non-grabbable but meant to be interacted with)\n                if grid[next_r, next_c, kind_idx] > 0 and kind_idx != primitive:\n                    is_blocked = True\n                    break\n            \n            # Additionally, ensure we don't try to move directly *into* the primitive itself.\n            # The goal is to be *adjacent* to it, not on top of it.\n            if grid[next_r, next_c, primitive] > 0:\n                is_blocked = True\n\n            if not is_blocked:\n                # If the cell is traversable, add it to the queue and mark as visited\n                visited.add(next_pos)\n                q.append((next_pos, path_so_far + [action_move]))\n    \n    # If the queue becomes empty and no path to an adjacent primitive was found,\n    # it means the primitive is unreachable or not present on the map.\n    return []", "island_id": 5, "scores": {"3": -1}}
