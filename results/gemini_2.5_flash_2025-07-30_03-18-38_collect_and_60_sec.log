{"timestamp": "2025-07-30T03:19:53.105728", "function_name": "collect", "function_body": "    actions = []\n    state = env._current_state \n\n    # Define action constants for readability and assuming they are\n    # accessible from the env_factory module.\n    ACTION_DOWN = env_factory.ACTION_DOWN\n    ACTION_UP = env_factory.ACTION_UP\n    ACTION_LEFT = env_factory.ACTION_LEFT\n    ACTION_RIGHT = env_factory.ACTION_RIGHT\n    ACTION_USE = env_factory.ACTION_USE\n\n    max_steps_limit = 200 # Set a reasonable limit to prevent infinite loops for simple cases\n    steps_count = 0\n\n    while True:\n        # 1. Check if the primitive is already collected in the inventory\n        if state.inventory[primitive] > 0:\n            break # Success: Goal achieved\n\n        # 2. Check if the maximum number of steps has been reached\n        if steps_count >= max_steps_limit:\n            break # Failure: Could not collect within the step limit\n\n        # 3. Check if the agent is next to the primitive (within 3x3 neighborhood, including current cell)\n        if state.next_to(primitive):\n            # If next to it, attempt to use/collect the primitive\n            actions.append(ACTION_USE)\n            _, state = state.step(ACTION_USE) # Update the state after taking the action\n            steps_count += 1\n            continue # Re-evaluate conditions for the new state (e.g., check inventory again)\n\n        # 4. If not next to it, find the closest primitive on the grid and plan a move\n        grid = state.grid\n        current_pos = state.pos\n        best_target_pos = None\n        min_dist = float('inf')\n\n        # Iterate through the grid to find all occurrences of the primitive\n        # grid shape: (WIDTH, HEIGHT, n_kinds)\n        width, height, n_kinds = grid.shape\n        \n        found_any_primitive_on_grid = False\n        for r in range(width):\n            for c in range(height):\n                if grid[r, c, primitive] > 0: # Check if this kind is present at (r, c)\n                    found_any_primitive_on_grid = True\n                    # Calculate Manhattan distance to the primitive's location\n                    dist = abs(r - current_pos[0]) + abs(c - current_pos[1]) \n                    if dist < min_dist:\n                        min_dist = dist\n                        best_target_pos = (r, c)\n        \n        # If no primitive is found on the grid, it means it's gone or was never there.\n        # In this case, the agent cannot proceed.\n        if not found_any_primitive_on_grid:\n            break \n\n        # 5. Determine the movement action towards the `best_target_pos`\n        tr, tc = best_target_pos\n        cr, cc = current_pos\n\n        action_to_take = None\n        # Simple greedy movement: prioritize vertical movement if the difference is larger,\n        # otherwise prioritize horizontal movement. This doesn't handle obstacles.\n        if abs(tr - cr) > 0: # Need to move vertically\n            if tr > cr:\n                action_to_take = ACTION_DOWN\n            else: # tr < cr\n                action_to_take = ACTION_UP\n        elif abs(tc - cc) > 0: # Need to move horizontally (only if no vertical move needed or vertical diff is zero)\n            if tc > cc:\n                action_to_take = ACTION_RIGHT\n            else: # tc < cc\n                action_to_take = ACTION_LEFT\n        \n        # If action_to_take is None, it means current_pos == best_target_pos.\n        # This scenario should ideally have been caught by `state.next_to(primitive)`\n        # at the beginning of the loop, as `next_to` checks the agent's cell too.\n        # If it wasn't caught, it indicates a situation where the agent is \"on\" the primitive\n        # but cannot collect it directly via `USE`, which is unexpected for a \"primitive\".\n        # For this `v1` implementation, it's considered a stuck state.\n        if action_to_take is not None:\n            actions.append(action_to_take)\n            _, state = state.step(action_to_take)\n            steps_count += 1\n        else:\n            # Agent is at the target cell but couldn't pick up the item.\n            # This is a failure case for this simple agent.\n            break \n    \n    return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:19:54.113366", "function_name": "collect", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:21:34.994385", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants (as defined by CraftLab.action_specs)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Map movement action to corresponding direction vector (dx, dy)\n    ACTION_TO_DIR_VEC = {\n        UP: (0, -1),\n        DOWN: (0, 1),\n        LEFT: (-1, 0),\n        RIGHT: (1, 0),\n    }\n\n    state = env._current_state\n    world = env.world\n    grid = state.grid\n    initial_pos = state.pos  # (x, y)\n    initial_dir_int = state.dir # initial direction index (0-3 for DOWN, UP, LEFT, RIGHT)\n    \n    # Assuming CraftState.dir (an int 0-3) directly maps to the movement action constants\n    # (DOWN=0, UP=1, LEFT=2, RIGHT=3) for initial facing direction.\n    initial_last_action = initial_dir_int\n\n    height, width, _ = grid.shape\n\n    # 1. Find all primitive locations on the grid\n    primitive_locations = []\n    for y in range(height):\n        for x in range(width):\n            if grid[y, x, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return [] # Primitive not found\n\n    # Sort primitive locations by Manhattan distance to initial position\n    # This prioritizes searching for paths to closer primitives first.\n    primitive_locations.sort(key=lambda p: abs(p[0] - initial_pos[0]) + abs(p[1] - initial_pos[1]))\n\n    # Define cells that are obstacles (non-grabbable entities)\n    non_grabbable_indices = world.non_grabbable_indices\n\n    # Iterate through primitive locations, trying to find a path to the closest one first.\n    # The first successful path found will be returned.\n    for target_x, target_y in primitive_locations:\n        # BFS state: ((current_pos_x, current_pos_y), last_action_taken_to_reach_here, path_actions_list)\n        # 'last_action_taken_to_reach_here' implicitly defines the current facing direction.\n        # For the initial state, it's derived from state.dir.\n        q = collections.deque([((initial_pos), initial_last_action, [])])\n        \n        # Visited set: (x, y, current_direction_as_action_constant)\n        # This prevents revisiting the same (position, direction) state, which is crucial for\n        # finding shortest paths when direction matters for actions (like USE).\n        visited = {(initial_pos[0], initial_pos[1], initial_last_action)}\n\n        while q:\n            (cx, cy), last_action, path_actions = q.popleft()\n\n            # Check if the current position and facing direction allow using the target primitive.\n            # This logic assumes the agent's facing direction is determined by the last movement action.\n            # If the agent is facing the target, we can append USE and return the path.\n            if last_action is not None and last_action in ACTION_TO_DIR_VEC:\n                dir_vec = ACTION_TO_DIR_VEC[last_action]\n                expected_target_x = cx + dir_vec[0]\n                expected_target_y = cy + dir_vec[1]\n\n                if (expected_target_x, expected_target_y) == (target_x, target_y):\n                    return path_actions + [USE]\n\n            # Explore neighbors for movement actions\n            neighbors = []\n            # (dx, dy, action_to_take) for each cardinal direction\n            neighbors.append((0, -1, UP))\n            neighbors.append((0, 1, DOWN))\n            neighbors.append((-1, 0, LEFT))\n            neighbors.append((1, 0, RIGHT))\n\n            for dx, dy, action_to_take in neighbors:\n                nx, ny = cx + dx, cy + dy\n                next_pos = (nx, ny)\n                \n                # The agent's new facing direction will be 'action_to_take' after this move.\n                next_state_key = (nx, ny, action_to_take) \n\n                # Check grid boundaries\n                if not (0 <= nx < width and 0 <= ny < height):\n                    continue\n\n                # Only proceed if this (position, direction) state has not been visited yet\n                if next_state_key not in visited:\n                    # Check if the 'next_pos' cell contains any non-grabbable items (obstacles).\n                    is_obstacle = False\n                    for idx in non_grabbable_indices:\n                        if grid[ny, nx, idx] > 0: # Check if the cell contains the non-grabbable item\n                            is_obstacle = True\n                            break\n                    \n                    if not is_obstacle:\n                        # Add the new state to visited and the queue for further exploration\n                        visited.add(next_state_key)\n                        q.append((next_pos, action_to_take, path_actions + [action_to_take]))\n    \n    # If the queue becomes empty and no path to any primitive was found,\n    # it means the primitive is unreachable from the current state.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:21:35.065241", "function_name": "collect", "function_body": "    current_state = env._current_state\n\n    # 1. Check if the primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid_height, grid_width, _ = current_state.grid.shape\n    non_grabbable_indices = current_state.world.non_grabbable_indices\n\n    # Define movement deltas for each action/direction\n    # Action/Direction mapping: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT\n    # These also represent the direction the agent faces\n    delta_coords = {\n        0: (1, 0),   # DOWN: dr=1, dc=0\n        1: (-1, 0),  # UP: dr=-1, dc=0\n        2: (0, -1),  # LEFT: dr=0, dc=-1\n        3: (0, 1)    # RIGHT: dr=0, dc=1\n    }\n    USE_ACTION = 4\n\n    # 2. Find all locations of the primitive on the grid\n    primitive_locations = []\n    for r_grid in range(grid_height):\n        for c_grid in range(grid_width):\n            if current_state.grid[r_grid, c_grid, primitive] == 1:\n                primitive_locations.append((r_grid, c_grid))\n\n    # If primitive is not found on the grid, it's unreachable (or just not there)\n    if not primitive_locations:\n        return []\n\n    # BFS setup\n    # Queue stores (row, col, direction, list_of_actions_taken_to_reach_here)\n    queue = collections.deque()\n    # Visited set stores (row, col, direction) to avoid redundant exploration\n    visited = set()\n\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir # Agent's starting direction\n\n    queue.append((initial_pos[0], initial_pos[1], initial_dir, []))\n    visited.add((initial_pos[0], initial_pos[1], initial_dir))\n\n    while queue:\n        r, c, d, actions_list = queue.popleft()\n\n        # Check for Goal: Is the agent currently adjacent to a primitive and facing it?\n        for px, py in primitive_locations:\n            dr_to_p = px - r\n            dc_to_p = py - c\n\n            # Check if (r,c) is directly adjacent to (px,py)\n            if abs(dr_to_p) + abs(dc_to_p) == 1:\n                # Check if the agent's current direction 'd' is facing (px,py)\n                facing_dr, facing_dc = delta_coords[d]\n                if facing_dr == dr_to_p and facing_dc == dc_to_p:\n                    return actions_list + [USE_ACTION]\n\n        # Explore all possible movement actions (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT)\n        for action_move in [0, 1, 2, 3]:\n            move_dr, move_dc = delta_coords[action_move]\n            next_r, next_c = r + move_dr, c + move_dc\n            next_d = action_move # Agent's direction changes to the direction of movement\n\n            # Check boundaries\n            if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n                continue\n\n            # Check if the next cell is an obstacle (non-grabbable)\n            is_obstacle = False\n            for idx in non_grabbable_indices:\n                if current_state.grid[next_r, next_c, idx] == 1:\n                    is_obstacle = True\n                    break\n            \n            # The agent can move into a cell containing a grabbable item or an empty cell.\n            # Only non-grabbable items should block movement.\n\n            if not is_obstacle and (next_r, next_c, next_d) not in visited:\n                visited.add((next_r, next_c, next_d))\n                queue.append((next_r, next_c, next_d, actions_list + [action_move]))\n    \n    # If the queue is empty and the primitive hasn't been found, it's unreachable.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:23:16.228479", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Check if primitive is already in inventory\n  current_state = env._current_state\n  world = env.world  # Reference to the CraftWorld instance\n\n  if current_state.inventory[primitive] > 0:\n    return []  # Primitive already collected, no actions needed\n\n  # Get current state details\n  current_pos = current_state.pos\n  grid = current_state.grid\n  grid_rows, grid_cols, _ = grid.shape # grid is (rows, cols, n_kinds)\n\n  # Define traversability check function\n  # A cell is traversable if it's within bounds and does not contain any non-grabbable entity.\n  def is_traversable(r, c):\n    if not (0 <= r < grid_rows and 0 <= c < grid_cols):\n      return False  # Out of bounds\n    \n    # Check if any non-grabbable item occupies this cell\n    for idx in world.non_grabbable_indices:\n      if grid[r, c, idx] > 0:\n        return False  # Cell contains a non-grabbable obstacle\n    return True # Cell is traversable\n\n  # BFS to find the shortest path to a cell containing the primitive\n  q = deque([(current_pos, [])])  # Queue: (current_position, list_of_actions_to_reach_here)\n  visited = {current_pos}         # Set of visited positions\n  \n  path_to_primitive = []          # Stores the actions to reach the primitive\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # Check if the current cell contains the primitive\n    if grid[r, c, primitive] > 0:\n      path_to_primitive = current_path\n      break  # Found the path to a primitive location\n\n    # Explore 4-directional neighbors (UP, DOWN, LEFT, RIGHT)\n    # Mapping (delta_row, delta_col) to action\n    neighbors = [\n        ((r - 1, c), env_factory.UP),    # Move Up\n        ((r + 1, c), env_factory.DOWN),  # Move Down\n        ((r, c - 1), env_factory.LEFT),  # Move Left\n        ((r, c + 1), env_factory.RIGHT)  # Move Right\n    ]\n\n    for (next_r, next_c), action in neighbors:\n      if (next_r, next_c) not in visited and is_traversable(next_r, next_c):\n        visited.add((next_r, next_c))\n        q.append(((next_r, next_c), current_path + [action]))\n\n  # If no path was found (primitive not on grid or unreachable)\n  # Also check if the primitive isn't at the agent's current position to avoid redundant return\n  if not path_to_primitive and grid[current_pos[0], current_pos[1], primitive] == 0:\n    return []  # Primitive not found or unreachable\n\n  # Once the agent reaches the primitive's location, use the item\n  actions = path_to_primitive + [env_factory.USE]\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:23:17.234021", "function_name": "collect", "function_body": "  from collections import deque # This import statement will be placed by the system if not already global\n\n  # Constants for actions as defined in the problem description for CraftLab\n  # These are already available in the scope where this function is inserted.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Get initial state information from the CraftLab environment\n  # We access the internal CraftState object directly for grid, pos, inventory.\n  current_state = env._current_state\n  current_grid = current_state.grid\n  current_pos = current_state.pos\n  current_inventory = current_state.inventory\n\n  # 1. Check if the primitive is already collected\n  if current_inventory[primitive] > 0:\n      return []\n\n  # Determine if the primitive is grabbable (picked up by walking onto)\n  # or non-grabbable (requires 'USE' from an adjacent square).\n  # `env.world.non_grabbable_indices` holds indices of entities that cannot be picked up.\n  is_primitive_non_grabbable = primitive in env.world.non_grabbable_indices\n\n  # Get grid dimensions\n  grid_height, grid_width, _ = current_grid.shape\n\n  # Identify locations of the primitive on the grid\n  primitive_locations = set()\n  for r in range(grid_height):\n      for c in range(grid_width):\n          if current_grid[r, c, primitive] == 1:\n              primitive_locations.add((r, c))\n\n  # If the primitive is not found on the grid, we cannot collect it directly.\n  # (Crafting is not handled by this function).\n  if not primitive_locations:\n      return []\n\n  # Define blocking entities. Assume anything in non_grabbable_indices blocks movement.\n  blocking_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a cell is traversable\n  def is_traversable(r, c):\n      # Check bounds\n      if not (0 <= r < grid_height and 0 <= c < grid_width):\n          return False\n      # Check for blocking entities\n      for kind_idx in blocking_indices:\n          if current_grid[r, c, kind_idx] == 1:\n              return False\n      return True\n\n  # BFS for shortest path to collect the primitive\n  # Queue stores (current_position_tuple, path_actions_list)\n  q = deque([(current_pos, [])])\n  visited = {current_pos} # Set of (row, col) tuples that have been visited\n\n  # Cardinal movements: (delta_row, delta_col), action_value\n  moves = [\n      ((-1, 0), UP),    # Move North\n      ((1, 0), DOWN),   # Move South\n      ((0, -1), LEFT),  # Move West\n      ((0, 1), RIGHT)   # Move East\n  ]\n\n  # Directions for checking 8-way adjacency for non-grabbable primitives\n  adj_deltas_8way = [\n      (-1, 0), (1, 0), (0, -1), (0, 1),  # Cardinal\n      (-1, -1), (-1, 1), (1, -1), (1, 1) # Diagonal\n  ]\n\n  while q:\n      (r, c), path = q.popleft()\n\n      # Goal check: Have we reached a state where the primitive can be collected?\n      if is_primitive_non_grabbable:\n          # If non-grabbable, we need to be adjacent and 'USE'\n          for dr_adj, dc_adj in adj_deltas_8way:\n              adj_r, adj_c = r + dr_adj, c + dc_adj\n              if (adj_r, adj_c) in primitive_locations:\n                  # Found a path to an adjacent traversable square.\n                  # Add the USE action and return the path.\n                  return path + [USE]\n      else:\n          # If grabbable, we need to be on the same square as the primitive.\n          if (r, c) in primitive_locations:\n              # Found a path directly to the primitive's location.\n              # It's collected by moving onto it, so no 'USE' action is needed.\n              return path\n\n      # Explore neighbors\n      for (dr, dc), action in moves:\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # Only proceed if the next cell is traversable and not yet visited\n          if is_traversable(next_r, next_c) and next_pos not in visited:\n              visited.add(next_pos)\n              q.append((next_pos, path + [action]))\n\n  # If no path is found after exploring all reachable cells\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:24:32.953854", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants from the environment's action_specs\n  _ACTIONS = env.action_specs()\n  DOWN = _ACTIONS['DOWN']\n  UP = _ACTIONS['UP']\n  LEFT = _ACTIONS['LEFT']\n  RIGHT = _ACTIONS['RIGHT']\n  USE = _ACTIONS['USE']\n\n  # Mapping of movement actions to their corresponding (dx, dy) coordinate changes\n  # (dx, dy) means change in (column, row) or (x, y)\n  DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0)\n  }\n\n  # Get initial state information from the environment\n  # We access the internal _current_state for direct grid coordinates and inventory\n  # This is usually acceptable in a specific framework context like this.\n  initial_state = env._current_state\n  current_pos = initial_state.pos  # (x, y) tuple\n  current_grid = initial_state.grid  # numpy array (height, width, n_kinds)\n  initial_inventory = initial_state.inventory\n  world = env.world  # Reference to the CraftWorld instance for non_grabbable_indices etc.\n\n  # 1. Check if the primitive is already collected\n  if initial_inventory[primitive] > 0:\n    return []  # Already have it, no actions needed\n\n  # 2. Setup BFS for pathfinding\n  grid_height, grid_width, _ = current_grid.shape\n\n  # Queue for BFS: stores (current_position_tuple, list_of_actions_to_reach_here)\n  q = collections.deque([(current_pos, [])])\n  # Set to keep track of visited positions to avoid cycles and redundant checks\n  visited = {current_pos}\n\n  # Possible directions for checking adjacent cells (for both movement and for checking primitive proximity)\n  # (dx, dy) where dx is change in x (column), dy is change in y (row)\n  adj_deltas = [(0, 1), (0, -1), (1, 0), (-1, 0)] # DOWN, UP, RIGHT, LEFT relative\n\n  # BFS loop\n  while q:\n    curr_pos, path_so_far = q.popleft()\n    cx, cy = curr_pos\n\n    # 3. Check if current position is adjacent to the primitive\n    # We want to find a path that ends one step away from the primitive, then USE.\n    for dx_adj, dy_adj in adj_deltas:\n      # Candidate cell for the primitive\n      px, py = cx + dx_adj, cy + dy_adj\n\n      # Check bounds for the primitive's potential cell\n      if 0 <= px < grid_width and 0 <= py < grid_height:\n        # If the primitive is at (px, py), then curr_pos is adjacent to it\n        # Note: grid is indexed as [row, column], i.e., [y, x]\n        if current_grid[py, px, primitive] == 1:\n          return path_so_far + [USE] # Path to position adjacent to primitive + USE action\n\n    # 4. Explore movable neighbors from the current position\n    for action_move, (dx, dy) in DELTAS.items():\n      nx, ny = cx + dx, cy + dy\n      next_pos = (nx, ny)\n\n      # Check bounds for the next position\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check traversability: Agent cannot move into certain non-grabbable items\n      # Workshops are non-grabbable but are usually traversable (agent can stand on them).\n      # Other non_grabbable_indices like water, stone are typically blocking.\n      is_blocked = False\n      for k in world.non_grabbable_indices:\n        # If the cell contains this non-grabbable kind...\n        if current_grid[ny, nx, k] == 1:\n          # And it's not a workshop (which are generally traversable)...\n          if k not in world.workshop_indices:\n            is_blocked = True\n            break\n      if is_blocked:\n        continue # This cell is blocked, cannot move here\n\n      # If the next position has not been visited, add it to the queue\n      if next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path_so_far + [action_move]))\n\n  # If the queue becomes empty and no path was found, the primitive is unreachable\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:24:33.023085", "function_name": "collect", "function_body": "    state = env._current_state\n    grid = state.grid\n    current_pos = state.pos\n    inventory = state.inventory\n    world = state.world\n\n    # 1. Check if primitive is already collected\n    if inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions (assuming grid is (H, W, K))\n    HEIGHT, WIDTH, N_KINDS = grid.shape\n\n    # Get indices of entities that block movement (e.g., walls, water, etc.)\n    # These are entities that are part of the 'environment' set in Cookbook,\n    # accessible via world.non_grabbable_indices on CraftWorld.\n    obstacle_indices = world.non_grabbable_indices\n\n    # Define possible moves and their corresponding actions\n    # (dr, dc): action mapping. Assumes UP, DOWN, LEFT, RIGHT, USE are defined globally.\n    # From problem description: DOWN->0, UP->1, LEFT->2, RIGHT->3, USE->4\n    move_deltas = {\n        (-1, 0): UP,    # Move Up (row decreases)\n        (1, 0): DOWN,   # Move Down (row increases)\n        (0, -1): LEFT,  # Move Left (col decreases)\n        (0, 1): RIGHT,  # Move Right (col increases)\n    }\n\n    # BFS Initialization\n    # Queue stores ( (row, col), list_of_actions_to_reach_here )\n    queue = collections.deque([(current_pos, [])])\n    # Set of (row, col) tuples already visited to prevent cycles and redundant exploration\n    visited = {current_pos}\n\n    while queue:\n        (r, c), path_actions = queue.popleft()\n\n        # Check if the current position (r, c) is adjacent to a cell containing the primitive\n        # Iterate through possible relative neighbor positions\n        for dr, dc in move_deltas:\n            nr, nc = r + dr, c + dc # Calculate neighbor coordinates\n\n            # Check if neighbor (nr, nc) is within bounds\n            if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n                continue\n\n            # Check if the neighbor cell (nr, nc) contains the primitive\n            if grid[nr, nc, primitive] > 0:\n                # Found a path to a position (r, c) from which the primitive at (nr, nc) can be USE'd.\n                # Return the sequence of movement actions followed by the USE action.\n                return path_actions + [USE]\n\n        # Explore direct neighbors for agent movement\n        for (dr, dc), action in move_deltas.items():\n            nr, nc = r + dr, c + dc # New potential agent position\n            new_pos = (nr, nc)\n\n            # Check bounds for the new agent position\n            if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n                continue\n\n            # Check if the new position is an obstacle (cannot move onto it)\n            is_new_pos_obstacle = False\n            for k_idx in obstacle_indices:\n                if grid[nr, nc, k_idx] > 0: # If the cell contains an entity that is an obstacle\n                    is_new_pos_obstacle = True\n                    break\n            if is_new_pos_obstacle:\n                continue\n\n            # If not visited and not an obstacle, add to queue\n            if new_pos not in visited:\n                visited.add(new_pos)\n                queue.append((new_pos, path_actions + [action]))\n\n    # If the BFS completes and no path to an adjacent primitive was found\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:25:54.974983", "function_name": "collect", "function_body": "  import collections\n\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos\n  inventory = current_state.inventory\n  world = env.world  # CraftWorld instance\n\n  # Get action mappings from the environment\n  ACTION_MAP = env.action_specs()\n  UP_ACTION = ACTION_MAP[\"UP\"]\n  DOWN_ACTION = ACTION_MAP[\"DOWN\"]\n  LEFT_ACTION = ACTION_MAP[\"LEFT\"]\n  RIGHT_ACTION = ACTION_MAP[\"RIGHT\"]\n  USE_ACTION = ACTION_MAP[\"USE\"]\n\n  # Define movement deltas based on actions\n  ACTION_TO_DELTAS = {\n      UP_ACTION: (-1, 0),\n      DOWN_ACTION: (1, 0),\n      LEFT_ACTION: (0, -1),\n      RIGHT_ACTION: (0, 1),\n  }\n\n  # 1. Check if primitive is already collected\n  if inventory[primitive] > 0:\n    return []\n\n  # 2. Check if already next to primitive and can USE\n  # This check is crucial for efficiency if the agent is already in position.\n  if current_state.next_to(primitive):\n    return [USE_ACTION]\n\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n  n_kinds = grid.shape[2] # Total number of kinds\n\n  # BFS to find path to a cell adjacent to 'primitive'\n  # Queue stores (position, path_actions_to_get_here)\n  queue = collections.deque([(current_pos, [])])\n  visited = {current_pos}  # Set of visited (r, c) tuples\n\n  # Find all locations of the primitive on the grid\n  primitive_locations = []\n  for r_scan in range(WIDTH):\n    for c_scan in range(HEIGHT):\n      if grid[r_scan, c_scan, primitive] > 0:\n        primitive_locations.append((r_scan, c_scan))\n\n  # If primitive isn't on the map, no path exists.\n  if not primitive_locations:\n    return []\n\n  while queue:\n    (r, c), path_actions = queue.popleft()\n\n    # Check if current position (r, c) is adjacent to any primitive location\n    # If yes, we found our target position to move to. Add USE action and return.\n    is_adjacent_to_primitive = False\n    for prim_r, prim_c in primitive_locations:\n      # Manhattan distance 1 means direct adjacency (up, down, left, right)\n      if abs(r - prim_r) + abs(c - prim_c) == 1:\n        is_adjacent_to_primitive = True\n        break\n\n    if is_adjacent_to_primitive:\n      return path_actions + [USE_ACTION]\n\n    # Explore neighbors\n    for action, (dr, dc) in ACTION_TO_DELTAS.items():\n      nr, nc = r + dr, c + dc\n      next_pos = (nr, nc)\n\n      # Check boundaries\n      if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n        continue\n\n      # Check if next_pos is blocked by unpassable terrain (water or stone)\n      # Assuming water and stone are the primary obstacles.\n      is_blocked = False\n      if world.water_index != -1 and world.water_index < n_kinds and grid[nr, nc, world.water_index] > 0:\n        is_blocked = True\n      if world.stone_index != -1 and world.stone_index < n_kinds and grid[nr, nc, world.stone_index] > 0:\n        is_blocked = True\n\n      if is_blocked:\n        continue\n\n      # Check if already visited\n      if next_pos in visited:\n        continue\n\n      visited.add(next_pos)\n      new_path_actions = path_actions + [action]\n      queue.append((next_pos, new_path_actions))\n\n  # If the queue becomes empty and no path to an adjacent cell was found\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:25:55.927101", "function_name": "collect", "function_body": "  prim_idx = env.world.cookbook.index(primitive)\n  actions_map = env.action_specs()\n\n  collected_actions = []\n  \n  # Get initial state\n  state = env._current_state\n\n  # Check if primitive is already collected\n  if state.inventory[prim_idx] > 0:\n    return []\n\n  # Find primitive's location on the grid\n  # np.argwhere returns (rows, cols) where rows are Y, cols are X in grid\n  # CraftWorld uses (WIDTH, HEIGHT) for grid. The grid is accessed as grid[x, y, k].\n  # np.argwhere(grid_slice > 0) will return coordinates in (x, y) order matching grid indexing.\n  \n  prim_locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n  \n  if len(prim_locations) == 0:\n    # Primitive not found on the map\n    return []\n  \n  # Pick the first location of the primitive\n  target_prim_pos = tuple(prim_locations[0]) # (px, py)\n\n  # Map for directions: N=0, E=1, S=2, W=3\n  # Agent's dir: 0:N, 1:E, 2:S, 3:W\n  # (dx, dy) mapping to target direction (relative to agent, for turning logic)\n  # (0, -1) -> UP/N (dir 0)\n  # (1, 0)  -> RIGHT/E (dir 1)\n  # (0, 1)  -> DOWN/S (dir 2)\n  # (-1, 0) -> LEFT/W (dir 3)\n  relative_pos_to_target_dir = {\n      (0, -1): 0, # North (UP)\n      (1, 0): 1,  # East (RIGHT)\n      (0, 1): 2,  # South (DOWN)\n      (-1, 0): 3  # West (LEFT)\n  }\n  \n  # Store the current action map values for easier use\n  ACTION_UP = actions_map['UP']\n  ACTION_DOWN = actions_map['DOWN']\n  ACTION_LEFT = actions_map['LEFT']\n  ACTION_RIGHT = actions_map['RIGHT']\n  ACTION_USE = actions_map['USE']\n\n  # Main loop for collecting the primitive\n  while state.inventory[prim_idx] == 0:\n    ax, ay = state.pos\n    \n    # Check if we are adjacent to the primitive by checking its cardinal neighbors\n    relative_prim_pos = None # Stores (dx, dy) of primitive relative to agent if adjacent\n    \n    # Iterate over 4 cardinal neighbors to see if any matches target_prim_pos\n    # (dx, dy) for relative moves: RIGHT, LEFT, DOWN, UP\n    cardinal_move_deltas = [\n        (1, 0), (-1, 0), (0, 1), (0, -1)\n    ]\n    \n    is_adjacent = False\n    for dx, dy in cardinal_move_deltas:\n        nx, ny = ax + dx, ay + dy\n        if (nx, ny) == target_prim_pos:\n            is_adjacent = True\n            relative_prim_pos = (dx, dy)\n            break\n\n    if is_adjacent:\n      # We are adjacent to the primitive. Now turn to face it and USE.\n      # The target_face_dir is the actual direction (0-3) agent needs to face.\n      target_face_dir = relative_pos_to_target_dir[relative_prim_pos]\n      \n      while state.dir != target_face_dir:\n        # Determine shortest turn (clockwise or counter-clockwise)\n        diff = (target_face_dir - state.dir + 4) % 4\n        if diff == 1: # Need to turn RIGHT (clockwise)\n          action = ACTION_RIGHT\n        else: # diff == 2 (180 deg) or diff == 3 (270 deg / 90 deg counter-clockwise)\n              # Prefer LEFT for 270 deg turn, or either for 180.\n          action = ACTION_LEFT \n        \n        _, _, _ = env.step(action)\n        collected_actions.append(action)\n        state = env._current_state # Update state after turn\n\n      # Now agent is facing the primitive, USE it.\n      _, _, _ = env.step(ACTION_USE)\n      collected_actions.append(ACTION_USE)\n      state = env._current_state # Update state after use.\n      \n      # Primitive should be collected now, loop condition will terminate.\n      break \n\n    else:\n      # Not adjacent, need to move towards the primitive\n      dx_diff = target_prim_pos[0] - ax\n      dy_diff = target_prim_pos[1] - ay\n\n      action_to_take = None\n      if abs(dx_diff) > abs(dy_diff):\n        # Prioritize horizontal movement if difference is greater\n        if dx_diff > 0:\n          action_to_take = ACTION_RIGHT\n        else:\n          action_to_take = ACTION_LEFT\n      else:\n        # Prioritize vertical movement (or if differences are equal)\n        if dy_diff > 0:\n          action_to_take = ACTION_DOWN\n        else:\n          action_to_take = ACTION_UP\n      \n      # Execute the chosen movement action\n      old_pos = state.pos\n      \n      # Define a list of actions to try if the preferred one is blocked.\n      # Start with the preferred action, then try perpendicular moves.\n      potential_moves_if_stuck = [action_to_take]\n      if action_to_take == ACTION_RIGHT or action_to_take == ACTION_LEFT:\n          # If horizontal move preferred, try vertical alternatives\n          potential_moves_if_stuck.extend([ACTION_UP, ACTION_DOWN])\n      else: # action_to_take == ACTION_UP or action_to_take == ACTION_DOWN\n          # If vertical move preferred, try horizontal alternatives\n          potential_moves_if_stuck.extend([ACTION_LEFT, ACTION_RIGHT])\n      \n      moved_successfully = False\n      for current_move_action in potential_moves_if_stuck:\n          _, _, _ = env.step(current_move_action)\n          collected_actions.append(current_move_action)\n          state = env._current_state\n          \n          if state.pos != old_pos:\n              # Moved successfully\n              moved_successfully = True\n              break # Exit loop of potential moves, proceed with main loop\n          # else: still stuck with this action, try next in potential_moves_if_stuck\n\n      if not moved_successfully:\n          # Agent is completely stuck, cannot move to target.\n          # This can happen if surrounded by obstacles or target is unreachable.\n          # For this problem, simply return the actions taken so far.\n          break\n\n  return collected_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:27:41.844851", "function_name": "collect", "function_body": "    world = env.world\n    initial_state = env._current_state # Get the current (initial for planning) state\n\n    # Action constants\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # 1. Check if the primitive is already collected in the initial state\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    HEIGHT, WIDTH, _ = initial_state.grid.shape\n\n    def is_valid_coord(x, y):\n        return 0 <= x < WIDTH and 0 <= y < HEIGHT\n\n    def is_passable(x, y, grid_ref, world_ref):\n        # Check if the cell is within bounds and doesn't contain water or stone.\n        if not is_valid_coord(x, y):\n            return False\n        # If the cell contains water or stone, it's impassable.\n        if grid_ref[y, x, world_ref.water_index] > 0 or \\\n           grid_ref[y, x, world_ref.stone_index] > 0:\n            return False\n        return True\n\n    # BFS to find the shortest path to a cell containing the primitive\n    q = collections.deque()\n    # Queue stores tuples: (current_pos_x, current_pos_y, path_to_this_pos_actions)\n    q.append((initial_state.pos[0], initial_state.pos[1], []))\n    visited = {(initial_state.pos[0], initial_state.pos[1])}\n\n    found_path_actions = None\n    target_primitive_cell = None\n    \n    # Mapping (dx, dy) to action_id for movement\n    move_actions_map = {\n        (0, -1): ACTION_UP,    # Move North (decrease Y)\n        (0, 1): ACTION_DOWN,   # Move South (increase Y)\n        (-1, 0): ACTION_LEFT,  # Move West (decrease X)\n        (1, 0): ACTION_RIGHT,  # Move East (increase X)\n    }\n\n    while q:\n        cx, cy, path = q.popleft()\n\n        # Check if the current cell (cx, cy) contains the primitive\n        if initial_state.grid[cy, cx, primitive] > 0:\n            found_path_actions = path\n            target_primitive_cell = (cx, cy)\n            break # Path to the primitive's location found\n\n        # Explore neighbors\n        for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]: # All 4 cardinal directions\n            nx, ny = cx + dx, cy + dy\n            \n            if (nx, ny) not in visited:\n                if is_passable(nx, ny, initial_state.grid, world):\n                    visited.add((nx, ny))\n                    next_action = move_actions_map[(dx, dy)]\n                    q.append((nx, ny, path + [next_action]))\n    \n    # If a path to the primitive's cell was found\n    if found_path_actions is not None:\n        # After the agent moves to the cell containing the primitive,\n        # it will be in the 3x3 neighborhood (specifically, at the center).\n        # The 'USE' action is then typically required to collect the primitive.\n        return found_path_actions + [ACTION_USE]\n    else:\n        # No path found to the primitive on the initial grid (e.g., unreachable, or not present)\n        return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:27:42.864230", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:29:15.454956", "function_name": "collect", "function_body": "    initial_state = env._current_state\n\n    # If the primitive is already in the inventory, we don't need to collect more.\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    # Define action mappings (assuming standard values based on common DMLab patterns)\n    ACTION_MAP = {\n        \"DOWN\": 0, \"UP\": 1, \"LEFT\": 2, \"RIGHT\": 3, \"USE\": 4\n    }\n\n    # Define movement deltas for grid coordinates (dy, dx) for each action\n    # (dy, dx) where dy is row change, dx is column change\n    MOVE_DELTAS_ACTIONS = {\n        ACTION_MAP[\"UP\"]: (-1, 0),    # Moves agent up (decreases row index)\n        ACTION_MAP[\"DOWN\"]: (1, 0),   # Moves agent down (increases row index)\n        ACTION_MAP[\"LEFT\"]: (0, -1),  # Moves agent left (decreases column index)\n        ACTION_MAP[\"RIGHT\"]: (0, 1),  # Moves agent right (increases column index)\n    }\n\n    # Define agent's internal direction mapping to (dy, dx) for the cell in front\n    # CraftState.dir: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n    DIR_TO_DELTA = {\n        0: (-1, 0),  # UP (dy, dx)\n        1: (0, 1),   # RIGHT\n        2: (1, 0),   # DOWN\n        3: (0, -1)   # LEFT\n    }\n    \n    # Get grid dimensions: grid is (WIDTH, HEIGHT, n_kinds)\n    # So, grid.shape[0] is width, grid.shape[1] is height\n    grid_w, grid_h, _ = initial_state.grid.shape\n    \n    # Cache non-grabbable indices for efficient obstacle checking\n    non_grabbable_indices = initial_state.world.non_grabbable_indices\n\n    # BFS queue: stores (current_pos_tuple, current_dir_int, path_list_of_actions)\n    # current_pos is (col, row)\n    queue = collections.deque([(initial_state.pos, initial_state.dir, [])])\n    \n    # Visited set: stores ((col, row), direction_int) to avoid redundant exploration\n    visited = set([(initial_state.pos, initial_state.dir)])\n\n    while queue:\n        current_pos, current_dir, path_so_far = queue.popleft()\n        \n        # Check if current state allows 'USE' to collect the primitive\n        # Calculate coordinates of the cell directly in front of the agent\n        face_dy, face_dx = DIR_TO_DELTA[current_dir]\n        target_cell_col, target_cell_row = current_pos[0] + face_dx, current_pos[1] + face_dy\n        \n        # Check if the cell in front is within grid boundaries\n        if 0 <= target_cell_col < grid_w and 0 <= target_cell_row < grid_h:\n            # Check if the cell in front contains the primitive\n            # Note: grid indexing is (row, col, kind)\n            if initial_state.grid[target_cell_row, target_cell_col, primitive] > 0:\n                # If it does, we've found a path to collect it. Add 'USE' and return.\n                return path_so_far + [ACTION_MAP[\"USE\"]]\n\n        # Explore possible movement actions from the current state\n        for action_name, action_val in ACTION_MAP.items():\n            if action_name == \"USE\":\n                continue # 'USE' is a terminal action for this BFS, not a movement.\n\n            # Calculate the next position based on the movement action\n            move_dy, move_dx = MOVE_DELTAS_ACTIONS[action_val]\n            next_pos = (current_pos[0] + move_dx, current_pos[1] + move_dy) # (col, row)\n            \n            # Check if the next position is within grid boundaries\n            if not (0 <= next_pos[0] < grid_w and 0 <= next_pos[1] < grid_h):\n                continue\n\n            # Check for obstacles at the next position\n            is_obstacle = False\n            # Iterate through all non-grabbable kinds to see if any are present at next_pos\n            # grid indexing is (row, col, kind)\n            for kind_idx in non_grabbable_indices:\n                if initial_state.grid[next_pos[1], next_pos[0], kind_idx] > 0:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n\n            # After a movement action, the agent's direction updates to the direction of that movement.\n            # Map the movement action value to the corresponding agent direction index.\n            next_dir = -1\n            if action_val == ACTION_MAP[\"UP\"]: next_dir = 0\n            elif action_val == ACTION_MAP[\"RIGHT\"]: next_dir = 1\n            elif action_val == ACTION_MAP[\"DOWN\"]: next_dir = 2\n            elif action_val == ACTION_MAP[\"LEFT\"]: next_dir = 3\n            \n            # If this (position, direction) state has not been visited, add it to the queue\n            if (next_pos, next_dir) not in visited:\n                visited.add((next_pos, next_dir))\n                queue.append((next_pos, next_dir, path_so_far + [action_val]))\n\n    # If the BFS completes without finding a path to collect the primitive, return an empty list.\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:29:15.533816", "function_name": "collect", "function_body": "    from collections import deque\n\n    # Helper function to convert numpy array to hashable tuple\n    def _array_to_tuple(arr):\n        return tuple(arr.flatten().tolist())\n\n    # Helper function to hash a numpy grid for the visited set.\n    # Using .data.tobytes() provides a byte representation of the array's data,\n    # which can then be hashed. This is important because the grid can change\n    # due to 'USE' actions, and we need to differentiate between states with\n    # identical positions, directions, and inventories but different grid layouts.\n    def _hash_grid(grid_array):\n        return hash(grid_array.data.tobytes())\n\n    # Define actions using the constants specified by CraftLab's action_specs.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Maximum depth for the BFS. This acts as a safeguard against overly long searches\n    # in complex environments or if a goal is unreachable, preventing infinite loops.\n    # The value is a heuristic; adjust based on expected map sizes and complexity.\n    MAX_BFS_DEPTH = 500\n\n    # Get the initial state from the CraftLab environment.\n    # env._current_state holds the current CraftState object of the simulation.\n    initial_craft_state = env._current_state\n\n    # Check if the primitive is already collected in the initial state.\n    # If so, no actions are needed.\n    if initial_craft_state.satisfies(None, primitive):\n        return []\n\n    # Initialize the BFS queue. Each element is a tuple:\n    # (current_CraftState_object, list_of_actions_taken_to_reach_this_state)\n    queue = deque([(initial_craft_state, [])])\n\n    # Initialize the set of visited states.\n    # A state is defined by (agent_position, agent_direction, inventory_contents, grid_hash).\n    # This comprehensive state representation is crucial because actions can change\n    # position, direction, inventory, AND the grid itself (e.g., collecting an item\n    # might remove it from the grid).\n    visited = set()\n\n    # Add the initial state to the visited set.\n    initial_pos_tuple = initial_craft_state.pos\n    initial_inventory_tuple = _array_to_tuple(initial_craft_state.inventory)\n    initial_grid_hash = _hash_grid(initial_craft_state.grid)\n    visited.add((initial_pos_tuple, initial_craft_state.dir, initial_inventory_tuple, initial_grid_hash))\n\n    # List of all possible actions to try at each step.\n    possible_actions = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n    # BFS loop\n    while queue:\n        current_state, current_path = queue.popleft()\n\n        # Check if the current state satisfies the goal (primitive collected).\n        if current_state.satisfies(None, primitive):\n            return current_path\n\n        # Pruning: If the current path length exceeds the maximum allowed depth,\n        # stop exploring this branch to prevent excessive computation.\n        if len(current_path) >= MAX_BFS_DEPTH:\n            continue\n\n        # Explore all possible next actions from the current state.\n        for action in possible_actions:\n            # Simulate the action using the CraftState's step method.\n            # CraftState.step returns a *new* CraftState object, which is ideal\n            # for BFS as it avoids modifying the original state or requiring deep copies.\n            # The reward is ignored as we are looking for the shortest path, not reward optimization.\n            _, next_state = current_state.step(action)\n            new_path = current_path + [action]\n\n            # Create a hashable representation of the next state for the visited set.\n            next_pos_tuple = next_state.pos\n            next_inventory_tuple = _array_to_tuple(next_state.inventory)\n            next_grid_hash = _hash_grid(next_state.grid)\n            next_state_hashable = (next_pos_tuple, next_state.dir, next_inventory_tuple, next_grid_hash)\n\n            # If this next state has not been visited before, add it to the queue and visited set.\n            if next_state_hashable not in visited:\n                visited.add(next_state_hashable)\n                queue.append((next_state, new_path))\n\n    # If the queue becomes empty and the goal was not reached, it means no path\n    # was found within the exploration limits.\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:31:13.515625", "function_name": "collect", "function_body": "  obs = env.observations()\n  state_dict = obs['features_dict']\n  grid = state_dict['features_global']\n  current_pos = tuple(state_dict['pos'])\n  \n  # Convert one-hot direction to integer direction (0=N, 1=E, 2=S, 3=W)\n  current_dir_one_hot = state_dict['direction']\n  current_dir = np.argmax(current_dir_one_hot) \n  \n  inventory = state_dict['inventory']\n\n  # If the primitive is already in inventory, no actions needed.\n  if inventory[primitive] > 0:\n      return []\n\n  WIDTH, HEIGHT, n_kinds = grid.shape\n  \n  # Define what constitutes an impassable cell for movement.\n  # This includes entities that cannot be walked through.\n  # CraftWorld attributes: non_grabbable_indices, water_index, stone_index.\n  # `non_grabbable_indices` seems to be the comprehensive set from `cookbook.environment`.\n  impassable_movement_kinds = env.world.non_grabbable_indices.copy()\n  # Add specific environmental features if they are not already covered by non_grabbable_indices\n  impassable_movement_kinds.add(env.world.water_index) \n  impassable_movement_kinds.add(env.world.stone_index)\n\n  def _is_passable_for_movement(r, c):\n      \"\"\"Checks if a grid cell (r, c) is within bounds and does not contain impassable objects.\"\"\"\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      # A cell is not passable if it contains any kind listed in impassable_movement_kinds\n      for kind_idx in impassable_movement_kinds:\n          if grid[r, c, kind_idx] == 1:\n              return False\n      return True\n\n  # Find all locations where the primitive item exists on the grid\n  primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n  if len(primitive_locations) == 0:\n      return [] # Primitive not found anywhere on the map\n\n  # BFS to find the shortest action sequence to reach an adjacent cell to the primitive\n  # from which it can be collected using the 'USE' action.\n  # BFS state: ((row, col, direction), list_of_actions_to_reach_this_state)\n  queue = collections.deque([((current_pos[0], current_pos[1], current_dir), [])])\n  visited = set([(current_pos[0], current_pos[1], current_dir)])\n\n  best_path_actions = []\n  found_path_to_target = False\n\n  while queue:\n      (r, c, d), path_actions = queue.popleft()\n\n      # Check if the current position (r, c) is adjacent to any primitive location\n      # AND if the agent is facing that primitive location correctly.\n      for pr, pc in primitive_locations:\n          # Check 4-directional adjacency\n          if (abs(r - pr) == 1 and c == pc) or (abs(c - pc) == 1 and r == pr):\n              # Calculate the desired direction for the agent to face the primitive\n              desired_dir_to_face_primitive = _get_target_facing_direction((r, c), (pr, pc))\n              \n              if desired_dir_to_face_primitive == d:\n                  # Found a path: agent is at (r,c), facing d, and (pr,pc) is the primitive.\n                  # This means we can issue a USE action.\n                  best_path_actions = path_actions + [env_factory.USE]\n                  found_path_to_target = True\n                  break # Exit inner loop (found primitive) and outer loop (BFS complete)\n      if found_path_to_target:\n          break\n\n      # Explore possible next states by applying valid actions:\n      \n      # 1. Move Forward (UP action)\n      dr_f, dc_f = _DIRECTIONS[d]\n      nr_f, nc_f = r + dr_f, c + dc_f\n      if _is_passable_for_movement(nr_f, nc_f) and (nr_f, nc_f, d) not in visited:\n          visited.add((nr_f, nc_f, d))\n          queue.append(((nr_f, nc_f, d), path_actions + [env_factory.UP]))\n\n      # 2. Move Backward (DOWN action)\n      # Calculate direction 180 degrees opposite to current facing direction\n      dr_b, dc_b = _DIRECTIONS[(d + 2) % 4] \n      nr_b, nc_b = r + dr_b, c + dc_b\n      if _is_passable_for_movement(nr_b, nc_b) and (nr_b, nc_b, d) not in visited:\n          visited.add((nr_b, nc_b, d))\n          queue.append(((nr_b, nc_b, d), path_actions + [env_factory.DOWN]))\n\n      # 3. Rotate Left (LEFT action)\n      nd_l = (d - 1 + 4) % 4 # Rotate 90 degrees counter-clockwise\n      if (r, c, nd_l) not in visited:\n          visited.add((r, c, nd_l))\n          queue.append(((r, c, nd_l), path_actions + [env_factory.LEFT]))\n\n      # 4. Rotate Right (RIGHT action)\n      nd_r = (d + 1) % 4 # Rotate 90 degrees clockwise\n      if (r, c, nd_r) not in visited:\n          visited.add((r, c, nd_r))\n          queue.append(((r, c, nd_r), path_actions + [env_factory.RIGHT]))\n            \n  return best_path_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:31:14.624144", "function_name": "collect", "function_body": "  # Define constants for actions within the function\n  ACTIONS = {\n      \"DOWN\": 0,\n      \"UP\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4,\n  }\n\n  # Mapping agent's direction (0-3) to (dr, dc) tuple changes relative to current position.\n  # This is used for calculating the cell the agent is currently facing for the \"USE\" action.\n  # Assuming 0=North, 1=East, 2=South, 3=West (Up, Right, Down, Left on a typical grid display,\n  # where row 0 is top and increases downwards, col 0 is left and increases rightwards).\n  DIR_VECTORS = {\n      0: (-1, 0),  # North (Up) - decreases row index\n      1: (0, 1),   # East (Right) - increases col index\n      2: (1, 0),   # South (Down) - increases row index\n      3: (0, -1)   # West (Left) - decreases col index\n  }\n\n  def is_valid_grid_pos(r, c, grid_shape):\n      \"\"\"Checks if a given (r, c) position is within the grid boundaries.\"\"\"\n      return 0 <= r < grid_shape[0] and 0 <= c < grid_shape[1]\n\n  # Import deque locally if it's not available globally as per strict instructions.\n  # If standard library imports are globally available, this line is redundant.\n  from collections import deque\n\n  # Get the initial state from the environment's internal state.\n  # We assume `env._current_state` provides the CraftState instance representing\n  # the current state of the world from which we need to find a path.\n  initial_state = env._current_state\n\n  # Initialize BFS queue with the initial state and an empty list of actions.\n  # Each element in the queue is a tuple: (CraftState_instance, list_of_actions_taken_to_reach_this_state).\n  q = deque([(initial_state, [])])\n\n  # Initialize a set to keep track of visited states to avoid redundant exploration and cycles.\n  # A state is defined by a tuple of (row, column, direction, tuple(inventory)).\n  # Inventory is a numpy array, so convert it to a tuple for hashability.\n  visited = set([(initial_state.pos[0], initial_state.pos[1], initial_state.dir, tuple(initial_state.inventory))])\n\n  # Set a maximum path length to prevent excessively long searches,\n  # which can occur in large or complex environments. This is an arbitrary limit.\n  MAX_BFS_PATH_LENGTH = 200\n\n  while q:\n    current_state, path = q.popleft()\n\n    # Pruning: If the current path exceeds the maximum allowed length,\n    # we stop exploring this branch as it's unlikely to be an optimal or feasible solution.\n    if len(path) >= MAX_BFS_PATH_LENGTH:\n        continue\n\n    # 1. Check if the target primitive has been collected in the current state.\n    # If the quantity of the primitive in inventory is greater than 0, we've succeeded.\n    if current_state.inventory[primitive] > 0:\n      return path  # Goal reached, return the sequence of actions that led to this state.\n\n    # 2. Try the \"USE\" action if the primitive is directly in front of the agent.\n    r, c = current_state.pos\n    dr, dc = DIR_VECTORS[current_state.dir]\n    facing_r, facing_c = r + dr, c + dc\n\n    grid_shape = current_state.grid.shape\n    if is_valid_grid_pos(facing_r, facing_c, grid_shape):\n        # Check if the cell directly in front of the agent contains the target primitive.\n        if current_state.grid[facing_r, facing_c, primitive] > 0:\n            # Simulate the \"USE\" action from the current state to see its effect.\n            # CraftState.step returns a tuple: (reward, new_state_after_action).\n            _reward, next_state_after_use = current_state.step(ACTIONS[\"USE\"])\n\n            # If performing \"USE\" successfully increased the count of the primitive in inventory,\n            # it means we collected it.\n            if next_state_after_use.inventory[primitive] > current_state.inventory[primitive]:\n                return path + [ACTIONS[\"USE\"]]  # Goal reached by using this action!\n\n            # Note: If \"USE\" did not directly result in collecting the primitive (e.g., it was used\n            # on a different item, or for crafting that didn't yield the primitive directly),\n            # this specific `next_state_after_use` is typically not added to the queue for\n            # simple 'collect' tasks, as it doesn't directly advance the goal. For more\n            # complex crafting scenarios, this logic might need expansion.\n\n    # 3. Explore movement actions (UP, DOWN, LEFT, RIGHT).\n    # Iterate through all possible movement actions.\n    for action_name, action_val in ACTIONS.items():\n        if action_name == \"USE\":\n            continue  # Skip \"USE\" as it's handled separately above or is not a movement action.\n\n        # Simulate the movement action from the current state.\n        _reward, next_state = current_state.step(action_val)\n\n        # Create a hashable key for the visited set to represent the resulting state.\n        # This key includes position, direction, and the full inventory state.\n        next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, tuple(next_state.inventory))\n\n        # Check if this resulting state (after the movement action) has not been visited yet.\n        # This implicitly handles cases where actions are blocked (e.g., hitting a wall),\n        # because in such cases, `next_state` would be identical to `current_state`,\n        # and `next_state_key` would already be in the `visited` set.\n        if next_state_key not in visited:\n            q.append((next_state, path + [action_val]))  # Add the new state and its path to the queue.\n            visited.add(next_state_key)  # Mark the new state as visited.\n\n  # If the BFS queue becomes empty and the primitive has not been collected,\n  # it means no path was found within the defined search limits.\n  return []  # Return an empty list to indicate that no path was found.", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:32:43.406926", "function_name": "collect", "function_body": "  # Constants for actions based on CraftLab.action_specs()\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Maximum number of logical steps to attempt collection to prevent infinite loops\n  MAX_COLLECT_STEPS = 200\n\n  actions_taken = []\n  \n  for _ in range(MAX_COLLECT_STEPS):\n    obs = env.observations()\n    \n    # 1. Check if the primitive is already in inventory\n    if obs['features_dict']['inventory'][primitive] > 0:\n      return actions_taken\n          \n    ego_grid = obs['features_dict']['features_ego']\n    # Determine the center of the egocentric view\n    ego_center_y, ego_center_x = ego_grid.shape[0] // 2, ego_grid.shape[1] // 2\n\n    best_target_dy, best_target_dx = None, None\n    min_dist = float('inf')\n\n    # 2. Find the closest primitive in the egocentric view\n    # Iterate through the grid to find cells containing the primitive\n    for r in range(ego_grid.shape[0]):\n      for c in range(ego_grid.shape[1]):\n        # Check if the current cell contains the primitive kind\n        if ego_grid[r, c, primitive] > 0:\n          dy, dx = r - ego_center_y, c - ego_center_x\n          \n          # Exclude the agent's own position (0,0) if it were to contain the primitive,\n          # as collecting usually implies an item on the ground or in front.\n          if dy == 0 and dx == 0:\n            continue \n\n          dist = abs(dy) + abs(dx) # Manhattan distance\n          if dist < min_dist:\n            min_dist = dist\n            best_target_dy, best_target_dx = dy, dx\n\n    # 3. Determine the next action sequence based on found primitive or exploration\n    next_action_sequence = []\n\n    if best_target_dy is not None: # Primitive found in view\n      # Case 1: Primitive is adjacent (Manhattan distance 1)\n      if min_dist == 1:\n        if best_target_dy == -1 and best_target_dx == 0: # Directly in front\n          next_action_sequence.append(ACTION_USE)\n        elif best_target_dy == 0 and best_target_dx == 1: # To the right\n          next_action_sequence.append(ACTION_RIGHT)\n          next_action_sequence.append(ACTION_USE)\n        elif best_target_dy == 0 and best_target_dx == -1: # To the left\n          next_action_sequence.append(ACTION_LEFT)\n          next_action_sequence.append(ACTION_USE)\n        elif best_target_dy == 1 and best_target_dx == 0: # Directly behind\n          # Turn 180 degrees (two LEFTs) then USE\n          next_action_sequence.append(ACTION_LEFT)\n          next_action_sequence.append(ACTION_LEFT)\n          next_action_sequence.append(ACTION_USE)\n      # Case 2: Primitive is visible but further away (min_dist > 1)\n      else:\n        # Prioritize aligning horizontally (turning) if needed\n        if best_target_dx > 0:\n          next_action_sequence.append(ACTION_RIGHT)\n        elif best_target_dx < 0:\n          next_action_sequence.append(ACTION_LEFT)\n        # If horizontally aligned (dx is 0) or no horizontal movement needed, move vertically\n        elif best_target_dy < 0: # Primitive is ahead\n          next_action_sequence.append(ACTION_UP)\n        elif best_target_dy > 0: # Primitive is behind but further away, turn around and move forward\n          next_action_sequence.append(ACTION_LEFT)\n          next_action_sequence.append(ACTION_LEFT)\n          next_action_sequence.append(ACTION_UP)\n        else: # Should not be reached if min_dist > 1\n          next_action_sequence.append(ACTION_UP) # Fallback to move forward\n    else: # No primitive found in view, explore\n      # Simple exploration strategy: continuously turn right to scan the environment\n      next_action_sequence.append(ACTION_RIGHT)\n\n    # 4. Execute the determined sequence of actions\n    if not next_action_sequence: # Should not happen with the current logic, but as a safeguard\n        next_action_sequence.append(ACTION_UP) # Default action to move forward if nothing else specified\n\n    for action in next_action_sequence:\n      reward, done, _ = env.step(action)\n      actions_taken.append(action)\n      \n      # After each action, re-check if the goal has been achieved\n      # This is crucial, especially after a USE action or moving onto an item.\n      current_obs = env.observations() # Get fresh observations\n      if current_obs['features_dict']['inventory'][primitive] > 0:\n        return actions_taken\n      \n      if done: # If the environment signals the episode is done (e.g., max_steps reached)\n        return actions_taken\n\n  # If the loop finishes without collecting the primitive (MAX_COLLECT_STEPS reached)\n  return actions_taken", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:32:43.476170", "function_name": "collect", "function_body": "    import collections # For using deque\n\n    # Constants for actions as per action_specs: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    \n    # Grid shape is (WIDTH, HEIGHT, n_kinds)\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n    \n    # Agent position from normalized coordinates to integer grid coordinates (x, y)\n    norm_pos = obs['features_dict']['pos']\n    agent_x = int(round(norm_pos[0] * (WIDTH - 1)))\n    agent_y = int(round(norm_pos[1] * (HEIGHT - 1)))\n    start_pos = (agent_x, agent_y)\n\n    # Non-grabbable items act as obstacles for movement\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    def is_obstacle(x, y):\n        \"\"\"Checks if a grid cell (x, y) is out of bounds or contains a non-grabbable item.\"\"\"\n        if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n            return True # Out of bounds is an obstacle\n        \n        # Check if any non-grabbable item is present at (x, y)\n        # grid values are counts, so > 0 indicates presence\n        for idx in non_grabbable_indices:\n            if grid[x, y, idx] > 0:\n                return True\n        return False\n\n    # Define possible movements as (dx, dy) and their corresponding action integers\n    movements = {\n        (0, -1): UP,    # Move North (decrease y)\n        (0, 1): DOWN,   # Move South (increase y)\n        (-1, 0): LEFT,  # Move West (decrease x)\n        (1, 0): RIGHT   # Move East (increase x)\n    }\n    \n    # BFS (Breadth-First Search) to find the shortest path to a primitive\n    # Queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n    q = collections.deque([(start_pos, [])]) \n    visited = {start_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n    while q:\n        (curr_x, curr_y), path = q.popleft()\n\n        # Check if any adjacent cell (neighbor) contains the target primitive.\n        # If so, the agent is in a position to 'USE' the primitive.\n        for (dx, dy), _ in movements.items(): # We only need dx, dy here to find the neighbor\n            neighbor_x, neighbor_y = curr_x + dx, curr_y + dy\n            \n            # Check if the neighbor is within bounds and contains the primitive\n            if (0 <= neighbor_x < WIDTH and 0 <= neighbor_y < HEIGHT and\n                grid[neighbor_x, neighbor_y, primitive] > 0):\n                \n                # Found the closest primitive! The path 'path' leads to 'curr_x, curr_y',\n                # from where the 'USE' action can be executed.\n                final_path = path + [USE]\n                return final_path\n\n        # If no primitive is immediately adjacent, explore traversable neighbors for further movement\n        for (dx, dy), action_to_move in movements.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_pos = (next_x, next_y)\n\n            # Only add to queue if not visited and not an obstacle\n            if next_pos not in visited and not is_obstacle(next_x, next_y):\n                visited.add(next_pos)\n                q.append((next_pos, path + [action_to_move]))\n\n    # If the BFS queue becomes empty and no primitive was found or reachable\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T03:34:35.322340", "function_name": "collect", "function_body": "    from collections import deque\n    import numpy as np\n\n    # Action constants (from action_specs)\n    _A_DOWN = 0\n    _A_UP = 1\n    _A_LEFT = 2\n    _A_RIGHT = 3\n    _A_USE = 4\n\n    # Direction constants for agent's facing (N=0, E=1, S=2, W=3)\n    _D_NORTH = 0\n    _D_EAST = 1\n    _D_SOUTH = 2\n    _D_WEST = 3\n\n    # Map movement actions to (dy, dx) deltas on the grid\n    # Assuming (0,0) is top-left, y increases downwards, x increases rightwards.\n    # UP: moves to y-1; DOWN: moves to y+1; LEFT: moves to x-1; RIGHT: moves to x+1.\n    _ACTION_DELTAS = {\n        _A_UP: (-1, 0),    # Change in (y, x) when moving UP\n        _A_DOWN: (1, 0),   # Change in (y, x) when moving DOWN\n        _A_LEFT: (0, -1),  # Change in (y, x) when moving LEFT\n        _A_RIGHT: (0, 1),  # Change in (y, x) when moving RIGHT\n    }\n\n    # Map (dy, dx) delta to the corresponding agent facing direction\n    # This assumes that after a movement action (UP, DOWN, LEFT, RIGHT),\n    # the agent's facing direction (`state.dir`) updates to the direction of movement.\n    _DIR_FROM_DELTA = {\n        (-1, 0): _D_NORTH,\n        (0, 1): _D_EAST,\n        (1, 0): _D_SOUTH,\n        (0, -1): _D_WEST,\n    }\n\n    def _get_turn_actions(current_dir, target_dir):\n        \"\"\"\n        Returns a list of actions (LEFT/RIGHT) to turn the agent from current_dir\n        to target_dir. Prefers RIGHT turns for 180-degree rotations.\n        \"\"\"\n        actions = []\n        # Calculate the rotational difference (modulo 4 for cyclic directions)\n        diff = (target_dir - current_dir + 4) % 4\n        if diff == 1:  # 90 degrees clockwise (e.g., N to E)\n            actions.append(_A_RIGHT)\n        elif diff == 2:  # 180 degrees (e.g., N to S)\n            actions.extend([_A_RIGHT, _A_RIGHT]) # Two right turns\n        elif diff == 3:  # 90 degrees counter-clockwise (e.g., N to W)\n            actions.append(_A_LEFT)\n        return actions\n\n    # Get the current state from the CraftLab environment\n    current_craft_state = env._current_state\n    \n    # 1. Goal Check: If the primitive is already in the inventory, no actions needed.\n    if current_craft_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_craft_state.grid\n    HEIGHT, WIDTH, N_KINDS = grid.shape\n\n    # 2. Find all locations on the grid where the primitive exists.\n    primitive_locations = []\n    for y in range(HEIGHT):\n        for x in range(WIDTH):\n            if grid[y, x, primitive] > 0:\n                primitive_locations.append((y, x))\n\n    if not primitive_locations:\n        return [] # No primitive found on the grid, so it cannot be collected.\n\n    # 3. BFS to find the shortest path to a position from which the primitive can be collected.\n    # A state in BFS is defined by (current_y, current_x, current_dir, actions_path_so_far).\n    # `current_dir` is the agent's facing direction.\n    q = deque([(current_craft_state.pos[0], current_craft_state.pos[1], current_craft_state.dir, [])])\n    \n    # Visited set to prevent cycles and redundant exploration: (y, x, dir)\n    visited = set([(current_craft_state.pos[0], current_craft_state.pos[1], current_craft_state.dir)])\n\n    best_full_path = None\n    min_path_len = float('inf')\n\n    while q:\n        curr_y, curr_x, curr_dir, path_actions = q.popleft()\n\n        # Optimization: If the current path is already longer or equal to the best found, prune it.\n        if len(path_actions) >= min_path_len:\n            continue\n        \n        # --- Check for immediate collection opportunity (on current square or adjacent) ---\n\n        # Case 1: Agent is currently standing on the primitive's square.\n        if (curr_y, curr_x) in primitive_locations:\n            # If the agent is on the primitive, it simply needs to USE it.\n            # No specific facing direction is required if on the cell itself for USE.\n            candidate_full_path = path_actions + [_A_USE]\n            if len(candidate_full_path) < min_path_len:\n                min_path_len = len(candidate_full_path)\n                best_full_path = candidate_full_path\n            # Note: We continue exploring, as there might be a shorter path to another primitive\n            # that involves moving, or this path might not actually pick up if the game logic is complex.\n\n        # Case 2: Agent is adjacent to a primitive and can USE it.\n        # Check 4 cardinal neighbors (N, S, W, E) for a primitive.\n        for dy_target, dx_target in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            target_y, target_x = curr_y + dy_target, curr_x + dx_target\n\n            # Check if the target neighbor is within grid bounds\n            if not (0 <= target_y < HEIGHT and 0 <= target_x < WIDTH):\n                continue\n            \n            # If the neighbor cell contains the primitive\n            if (target_y, target_x) in primitive_locations:\n                # The agent is next to a primitive. It needs to turn to face it and then USE.\n                # `_DIR_FROM_DELTA` gives the direction from `(curr_y, curr_x)` to `(target_y, target_x)`.\n                target_facing_dir = _DIR_FROM_DELTA.get((dy_target, dx_target))\n                \n                if target_facing_dir is not None: # Should always be true for cardinal directions\n                    turn_actions = _get_turn_actions(curr_dir, target_facing_dir)\n                    # The full path includes movements to `curr_y, curr_x`, then turns, then USE.\n                    candidate_full_path = path_actions + turn_actions + [_A_USE]\n\n                    if len(candidate_full_path) < min_path_len:\n                        min_path_len = len(candidate_full_path)\n                        best_full_path = candidate_full_path\n\n        # --- Expand with movement actions (UP, DOWN, LEFT, RIGHT) ---\n        for action in [_A_UP, _A_DOWN, _A_LEFT, _A_RIGHT]:\n            dy_move, dx_move = _ACTION_DELTAS[action]\n            next_y, next_x = curr_y + dy_move, curr_x + dx_move\n            \n            # Check if the next position is within grid bounds\n            if not (0 <= next_y < HEIGHT and 0 <= next_x < WIDTH):\n                continue\n\n            # Check for obstacles: cells containing non-grabbable items that block movement.\n            is_blocked = False\n            for kind_idx in env.world.non_grabbable_indices:\n                if grid[next_y, next_x, kind_idx] > 0:\n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue # Cannot move into a blocked cell.\n\n            # Determine the agent's facing direction after this movement.\n            # We assume that after taking a move action (UP, DOWN, LEFT, RIGHT),\n            # the agent's facing direction `dir` updates to the direction of movement.\n            next_dir = _DIR_FROM_DELTA.get((dy_move, dx_move))\n            if next_dir is None: # Should not happen for valid _ACTION_DELTAS.\n                continue\n\n            # Check if this (position, direction) state has already been visited\n            if (next_y, next_x, next_dir) not in visited:\n                visited.add((next_y, next_x, next_dir))\n                q.append((next_y, next_x, next_dir, path_actions + [action]))\n\n    # Return the shortest path found to collect the primitive, or an empty list if unreachable.\n    if best_full_path is not None:\n        return best_full_path\n    else:\n        return []", "island_id": 6, "scores": {"3": -1}}
