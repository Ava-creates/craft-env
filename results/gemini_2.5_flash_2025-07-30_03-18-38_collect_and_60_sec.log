{"timestamp": "2025-07-31T01:21:09.932110", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from action_specs)\n  # These constants define the agent's possible actions.\n  ACTION_MOVE_SOUTH = 0 # Corresponds to DOWN\n  ACTION_MOVE_NORTH = 1 # Corresponds to UP\n  ACTION_MOVE_WEST = 2  # Corresponds to LEFT\n  ACTION_MOVE_EAST = 3  # Corresponds to RIGHT\n  ACTION_USE = 4\n\n  # Map movement vectors (dx, dy) to the corresponding action ID and the resulting facing direction.\n  # The direction ID mapping is: 0: North (-Y), 1: East (+X), 2: South (+Y), 3: West (-X).\n  # Moving in a direction also sets the agent's facing direction to that same direction.\n  MOVE_ACTIONS_AND_DIRECTIONS = {\n      (0, -1): (ACTION_MOVE_NORTH, 0), # Move North, face North\n      (1, 0): (ACTION_MOVE_EAST, 1),   # Move East, face East\n      (0, 1): (ACTION_MOVE_SOUTH, 2),  # Move South, face South\n      (-1, 0): (ACTION_MOVE_WEST, 3)   # Move West, face West\n  }\n\n  # Map agent's internal direction ID to its corresponding (dx, dy) facing vector.\n  # This is used to determine what cell is directly \"in front\" of the agent for the USE action.\n  DIRECTION_TO_VECTOR = {\n      0: (0, -1),  # North (up)\n      1: (1, 0),   # East (right)\n      2: (0, 1),   # South (down)\n      3: (-1, 0)   # West (left)\n  }\n\n  # Improvement for V2: First, check if the primitive can actually be picked up.\n  # CraftWorld defines 'non_grabbable_indices' as entities that cannot be picked up.\n  if primitive in env.world.non_grabbable_indices:\n      # If the primitive is non-grabbable, it's impossible to collect it, so return an empty path.\n      return []\n\n  # Get the current state information from the environment.\n  current_obs = env.observations()\n  # The global grid representation is needed to check cell contents (primitive, obstacles).\n  current_grid = current_obs['features_dict']['features_global']\n  # Agent's starting position (x, y) as a tuple of integers.\n  start_position = tuple(current_obs['features_dict']['pos'].astype(int))\n  # Agent's starting direction, converted from one-hot vector to an integer (0-3).\n  start_direction = np.argmax(current_obs['features_dict']['direction'])\n\n  # Extract grid dimensions.\n  grid_width, grid_height, _ = current_grid.shape\n  # Get indices of entities that block movement (e.g., water, stone if not breakable).\n  # Assuming entities in `non_grabbable_indices` are also impassable for movement.\n  impassable_entity_indices = env.world.non_grabbable_indices\n\n  # --- Helper Functions for Grid and Movement Checks ---\n\n  def is_coordinate_valid(x, y):\n      \"\"\"Checks if a given (x, y) coordinate is within the grid boundaries.\"\"\"\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  def is_cell_passable(x, y):\n      \"\"\"Checks if the cell at (x, y) is traversable by the agent.\"\"\"\n      if not is_coordinate_valid(x, y):\n          return False # Outside grid is not passable.\n      # A cell is impassable if it contains any of the non-grabbable entities.\n      for entity_idx in impassable_entity_indices:\n          if current_grid[x, y, entity_idx] > 0:\n              return False # Cell contains an obstacle.\n      return True # Cell is clear and traversable.\n\n  # --- Breadth-First Search (BFS) for Pathfinding ---\n\n  # BFS queue: stores states to explore. A state is ((x, y), direction_id).\n  bfs_queue = collections.deque([(start_position, start_direction)])\n  # Set of visited states to prevent revisiting and cycles, ensuring shortest path.\n  visited_states = set([(start_position, start_direction)])\n  # Parent map: used to reconstruct the path after BFS.\n  # Maps child_state -> (parent_state, action_taken_to_reach_child).\n  path_reconstruction_map = {}\n\n  # This will store the state ((x, y), direction_id) from which the primitive can be collected.\n  target_collection_state = None\n\n  while bfs_queue:\n      (current_x, current_y), current_dir = bfs_queue.popleft()\n      current_bfs_state = ((current_x, current_y), current_dir)\n\n      # Check if the desired primitive is located in the cell directly in front of the agent.\n      dir_vector = DIRECTION_TO_VECTOR[current_dir]\n      front_x, front_y = current_x + dir_vector[0], current_y + dir_vector[1]\n\n      if is_coordinate_valid(front_x, front_y) and current_grid[front_x, front_y, primitive] > 0:\n          # The primitive is found! This is the goal state for our pathfinding.\n          # We've already confirmed 'primitive' is grabbable at the start of the function.\n          target_collection_state = current_bfs_state\n          break # Exit BFS, as we found the shortest path to a valid collection point.\n\n      # Explore all possible movement actions from the current state.\n      for (dx, dy), (action_id, new_dir) in MOVE_ACTIONS_AND_DIRECTIONS.items():\n          next_x, next_y = current_x + dx, current_y + dy\n          next_position = (next_x, next_y)\n          next_bfs_state = (next_position, new_dir)\n\n          # Only proceed if the next cell is passable and the state hasn't been visited before.\n          if is_cell_passable(next_x, next_y) and next_bfs_state not in visited_states:\n              visited_states.add(next_bfs_state)\n              # Record the action taken to reach this new state from the current state.\n              path_reconstruction_map[next_bfs_state] = (current_bfs_state, action_id)\n              bfs_queue.append(next_bfs_state)\n\n  # --- Path Reconstruction ---\n\n  # If a path to the primitive was found:\n  if target_collection_state:\n      # The final action is always 'USE' to collect the primitive.\n      actions_to_primitive = [ACTION_USE]\n      current_state_in_path = target_collection_state\n\n      # Backtrack from the target state to the initial state using the parent map.\n      # The loop continues until we reach the original starting position and direction.\n      while current_state_in_path != (start_position, start_direction):\n          # Get the parent state and the action that led to current_state_in_path.\n          parent_state, action_from_parent = path_reconstruction_map[current_state_in_path]\n          actions_to_primitive.append(action_from_parent)\n          current_state_in_path = parent_state\n      \n      # The actions were collected in reverse order (from goal to start), so reverse the list.\n      return actions_to_primitive[::-1]\n  else:\n      # If the BFS completed without finding the primitive (queue became empty), return an empty list.\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T01:21:10.928352", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from action_specs)\n  # These constants define the agent's possible actions.\n  ACTION_MOVE_SOUTH = 0 # Corresponds to DOWN\n  ACTION_MOVE_NORTH = 1 # Corresponds to UP\n  ACTION_MOVE_WEST = 2  # Corresponds to LEFT\n  ACTION_MOVE_EAST = 3  # Corresponds to RIGHT\n  ACTION_USE = 4\n\n  # Map movement vectors (dx, dy) to the corresponding action ID and the resulting facing direction.\n  # The direction ID mapping is: 0: North (-Y), 1: East (+X), 2: South (+Y), 3: West (-X).\n  # Moving in a direction also sets the agent's facing direction to that same direction.\n  MOVE_ACTIONS_AND_DIRECTIONS = {\n      (0, -1): (ACTION_MOVE_NORTH, 0), # Move North, face North\n      (1, 0): (ACTION_MOVE_EAST, 1),   # Move East, face East\n      (0, 1): (ACTION_MOVE_SOUTH, 2),  # Move South, face South\n      (-1, 0): (ACTION_MOVE_WEST, 3)   # Move West, face West\n  }\n\n  # Map agent's internal direction ID to its corresponding (dx, dy) facing vector.\n  # This is used to determine what cell is directly \"in front\" of the agent for the USE action.\n  DIRECTION_TO_VECTOR = {\n      0: (0, -1),  # North (up)\n      1: (1, 0),   # East (right)\n      2: (0, 1),   # South (down)\n      3: (-1, 0)   # West (left)\n  }\n\n  # --- Improvement for collect_v2: Check if primitive is grabbable upfront ---\n  # If the primitive is a non-grabbable entity (like water or stone, if not breakable),\n  # it's impossible to collect it using the 'USE' action.\n  if primitive in env.world.non_grabbable_indices:\n      return [] # Return an empty list of actions as it cannot be collected.\n\n  # Get the current state information from the environment.\n  current_obs = env.observations()\n  # The global grid representation is needed to check cell contents (primitive, obstacles).\n  current_grid = current_obs['features_dict']['features_global']\n  # Agent's starting position (x, y) as a tuple of integers.\n  start_position = tuple(current_obs['features_dict']['pos'].astype(int))\n  # Agent's starting direction, converted from one-hot vector to an integer (0-3).\n  start_direction = np.argmax(current_obs['features_dict']['direction'])\n\n  # Extract grid dimensions.\n  grid_width, grid_height, _ = current_grid.shape\n  # Get indices of entities that block movement (e.g., water, stone if not breakable).\n  impassable_entity_indices = env.world.non_grabbable_indices\n\n  # --- Helper Functions for Grid and Movement Checks ---\n\n  def is_coordinate_valid(x, y):\n      \"\"\"Checks if a given (x, y) coordinate is within the grid boundaries.\"\"\"\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  def is_cell_passable(x, y):\n      \"\"\"Checks if the cell at (x, y) is traversable by the agent.\"\"\"\n      if not is_coordinate_valid(x, y):\n          return False # Outside grid is not passable.\n      # A cell is impassable if it contains any of the non-grabbable entities.\n      for entity_idx in impassable_entity_indices:\n          if current_grid[x, y, entity_idx] > 0:\n              return False # Cell contains an obstacle.\n      return True # Cell is clear and traversable.\n\n  # --- Breadth-First Search (BFS) for Pathfinding ---\n\n  # BFS queue: stores states to explore. A state is ((x, y), direction_id).\n  bfs_queue = collections.deque([(start_position, start_direction)])\n  # Set of visited states to prevent revisiting and cycles, ensuring shortest path.\n  visited_states = set([(start_position, start_direction)])\n  # Parent map: used to reconstruct the path after BFS.\n  # Maps child_state -> (parent_state, action_taken_to_reach_child).\n  path_reconstruction_map = {}\n\n  # This will store the state ((x, y), direction_id) from which the primitive can be collected.\n  target_collection_state = None\n\n  while bfs_queue:\n      (current_x, current_y), current_dir = bfs_queue.popleft()\n      current_bfs_state = ((current_x, current_y), current_dir)\n\n      # Check if the desired primitive is located in the cell directly in front of the agent.\n      dir_vector = DIRECTION_TO_VECTOR[current_dir]\n      front_x, front_y = current_x + dir_vector[0], current_y + dir_vector[1]\n\n      if is_coordinate_valid(front_x, front_y) and current_grid[front_x, front_y, primitive] > 0:\n          # The primitive is found! This is the goal state for our pathfinding.\n          target_collection_state = current_bfs_state\n          break # Exit BFS, as we found the shortest path to a valid collection point.\n\n      # Explore all possible movement actions from the current state.\n      for (dx, dy), (action_id, new_dir) in MOVE_ACTIONS_AND_DIRECTIONS.items():\n          next_x, next_y = current_x + dx, current_y + dy\n          next_position = (next_x, next_y)\n          next_bfs_state = (next_position, new_dir)\n\n          # Only proceed if the next cell is passable and the state hasn't been visited before.\n          if is_cell_passable(next_x, next_y) and next_bfs_state not in visited_states:\n              visited_states.add(next_bfs_state)\n              # Record the action taken to reach this new state from the current state.\n              path_reconstruction_map[next_bfs_state] = (current_bfs_state, action_id)\n              bfs_queue.append(next_bfs_state)\n\n  # --- Path Reconstruction ---\n\n  # If a path to the primitive was found:\n  if target_collection_state:\n      # The final action is always 'USE' to collect the primitive.\n      actions_to_primitive = [ACTION_USE]\n      current_state_in_path = target_collection_state\n\n      # Backtrack from the target state to the initial state using the parent map.\n      # The loop continues until we reach the original starting position and direction.\n      while current_state_in_path != (start_position, start_direction):\n          # Get the parent state and the action that led to current_state_in_path.\n          parent_state, action_from_parent = path_reconstruction_map[current_state_in_path]\n          actions_to_primitive.append(action_from_parent)\n          current_state_in_path = parent_state\n      \n      # The actions were collected in reverse order (from goal to start), so reverse the list.\n      return actions_to_primitive[::-1]\n  else:\n      # If the BFS completed without finding the primitive (queue became empty), return an empty list.\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T01:22:35.770730", "function_name": "collect", "function_body": "  from collections import deque # Import deque here to comply with \"only return code that will fit in that function\"\n\n  # Helper function for BFS pathfinding to an adjacent cell of the target item.\n  # This function is nested to ensure all code is within collect_v2.\n  def find_path_to_adjacent(start_pos, target_item_pos, grid, obstacles, grid_width, grid_height):\n      # Maps movement actions to (dx, dy) changes. These are constant for the environment.\n      _ACTIONS_MAP = {\n          env_factory.DOWN: (0, 1),\n          env_factory.UP: (0, -1),\n          env_factory.LEFT: (-1, 0),\n          env_factory.RIGHT: (1, 0),\n      }\n\n      q = deque([(start_pos, [])]) # Queue: (current_position, list_of_actions_to_reach_here)\n      visited = {start_pos} # Set to keep track of visited positions to avoid cycles and redundant checks\n\n      # Calculate all possible adjacent cells to the target item.\n      # The agent needs to move to one of these cells before using the 'USE' action.\n      target_adj_cells = set()\n      tx, ty = target_item_pos\n      for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]: # Check 4 cardinal directions\n          adj_x, adj_y = tx + dx, ty + dy\n          \n          # Check if the potential adjacent cell is within the grid boundaries.\n          if not (0 <= adj_x < grid_width and 0 <= adj_y < grid_height):\n              continue\n\n          # Check if the potential adjacent cell is occupied by an obstacle.\n          # The agent cannot move into an obstacle cell.\n          is_obstacle = False\n          for kind_idx in obstacles:\n              # If the cell (adj_x, adj_y) contains any obstacle kind (value > 0 means present).\n              if grid[adj_x, adj_y, kind_idx] > 0:\n                  is_obstacle = True\n                  break\n          if not is_obstacle: # Only add to target_adj_cells if it's a traversable cell.\n              target_adj_cells.add((adj_x, adj_y))\n\n      # If no traversable adjacent cells are found (e.g., target is completely walled in),\n      # then it's impossible to reach it, so return None.\n      if not target_adj_cells:\n          return None\n\n      # Perform Breadth-First Search (BFS)\n      while q:\n          curr_pos, path_actions = q.popleft()\n\n          # If the current position is one of the target's adjacent cells, we have found the shortest path.\n          if curr_pos in target_adj_cells:\n              return path_actions\n\n          # Explore neighbors (possible next moves).\n          for action, (dx, dy) in _ACTIONS_MAP.items(): # Iterate through possible movement actions.\n              nx, ny = curr_pos[0] + dx, curr_pos[1] + dy\n              new_pos = (nx, ny)\n\n              # Check if the new position is within grid boundaries.\n              if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n                  continue\n\n              # Check if the new position is an obstacle.\n              is_obstacle = False\n              for kind_idx in obstacles:\n                  if grid[nx, ny, kind_idx] > 0:\n                      is_obstacle = True\n                      break\n              if is_obstacle:\n                  continue\n\n              # If the new position has not been visited, add it to the queue.\n              if new_pos not in visited:\n                  visited.add(new_pos)\n                  q.append((new_pos, path_actions + [action]))\n      \n      return None # No path found to any adjacent cell after exhausting all possibilities.\n\n  # --- Main logic for collect_v2 function ---\n\n  # Get the current state information from the environment.\n  current_state = env._current_state\n  grid = current_state.grid\n  agent_pos = current_state.pos\n  primitive_kind_idx = primitive # The input 'primitive' is assumed to be the integer index of the item.\n\n  # Get grid dimensions (width, height, number of kinds).\n  grid_width, grid_height, _ = grid.shape\n\n  # Find the target primitive's exact position on the grid.\n  target_pos = None\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # Check if the primitive kind is present at this grid cell (value > 0 indicates presence).\n          if grid[x, y, primitive_kind_idx] > 0:\n              target_pos = (x, y)\n              break # Found the primitive, exit inner loop.\n      if target_pos:\n          break # Found the primitive, exit outer loop.\n\n  # If the primitive is not found on the grid, return an empty list of actions.\n  if target_pos is None:\n      return []\n\n  # Define obstacles for pathfinding: entities the agent cannot pass through.\n  # This includes non-grabbable environment entities and generally un-pickupable items.\n  obstacles = env.world.environment.union(env.world.non_grabbable_indices)\n\n  # Find the shortest path from the agent's current position to a cell adjacent to the primitive.\n  path_to_adj = find_path_to_adjacent(agent_pos, target_pos, grid, obstacles, grid_width, grid_height)\n\n  # If no path is found to an adjacent cell (e.g., primitive is unreachable or walled off),\n  # return an empty list of actions.\n  if path_to_adj is None:\n      return []\n\n  # If a path is found, the agent moves to the adjacent cell, then performs the 'USE' action.\n  # It is assumed that 'USE' acts on any grabbable item directly adjacent to the agent,\n  # without requiring specific agent orientation (as there are no explicit rotation actions).\n  return path_to_adj + [env_factory.USE]", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:22:37.341987", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:24:24.086042", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      ACTION_UP: DIR_NORTH,   # Agent moves North, faces North\n      ACTION_DOWN: DIR_SOUTH, # Agent moves South, faces South\n      ACTION_LEFT: DIR_WEST,  # Agent moves West, faces West\n      ACTION_RIGHT: DIR_EAST  # Agent moves East, faces East\n  }\n\n  # Maximum number of steps allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent,\n      based on CraftState.dir (0=East, 1=South, 2=West, 3=North).\n      \"\"\"\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return (y, x) # Fallback, should not be reached with valid directions\n\n  # Access the underlying CraftState instance to get the current state information.\n  current_state = env._current_state\n\n  # Improvement: More robust input validation and early exits.\n  # If the `primitive` is not in the world's grabbable_indices, it cannot be collected by ACTION_USE.\n  if primitive not in current_state.world.grabbable_indices:\n      return []\n\n  # Ensure the `primitive` is a recognized entity kind in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # Optimization: If the `primitive` is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Retrieve necessary environment information for pathfinding.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir # Use current_state.dir, as env is not reset to init_dir.\n\n  # Determine which entity kinds are impassable for agent movement.\n  impassable_for_movement = set()\n  # Water is typically impassable for movement.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  # Any non-grabbable items that are NOT workshops are generally impassable.\n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # Format: {action: (resulting_direction_after_move, dy, dx)}\n  movement_actions_map = {\n      ACTION_UP:    (ACTION_TO_DIR[ACTION_UP], -1, 0),\n      ACTION_DOWN:  (ACTION_TO_DIR[ACTION_DOWN], 1, 0),\n      ACTION_LEFT:  (ACTION_TO_DIR[ACTION_LEFT], 0, -1),\n      ACTION_RIGHT: (ACTION_TO_DIR[ACTION_RIGHT], 0, 1)\n  }\n\n  # BFS setup for pathfinding\n  q = collections.deque()\n  # Queue stores: (current_y, current_x, current_direction, path_length_so_far)\n  # Storing path_length here simplifies checking against MAX_COLLECT_STEPS during BFS.\n  q.append((start_y, start_x, start_dir, 0))\n\n  # Visited dictionary for efficient path reconstruction (stores parent info):\n  # {(y, x, dir): (action_that_led_here, parent_y, parent_x, parent_dir)}\n  # Initialize start state with None for parent and action, indicating it's the origin.\n  visited_path_info = {(start_y, start_x, start_dir): (None, None, None, None)}\n\n  goal_reached_coords_and_dir = None # This will store the (y, x, dir) state from which ACTION_USE is valid.\n\n  # If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence ---\n  while q:\n      curr_y, curr_x, curr_dir, current_path_length = q.popleft()\n\n      # Check if the current state allows immediate collection (i.e., primitive is in front).\n      # The `+1` is for the final ACTION_USE, ensuring the total path length remains within limits.\n      if current_path_length + 1 <= MAX_COLLECT_STEPS:\n          facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n          # If the cell in front contains the primitive, we've found a path to a collectable state.\n          if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n              full_grid[facing_y, facing_x, primitive] > 0):\n              \n              goal_reached_coords_and_dir = (curr_y, curr_x, curr_dir)\n              break # Since it's BFS, this is the shortest path to a collectable state.\n\n      # Explore all possible movement actions from the current state.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          next_path_length = current_path_length + 1 # One more step for this movement action.\n\n          # Pruning: If adding this move makes the path too long (considering the final USE action), skip.\n          if next_path_length + 1 > MAX_COLLECT_STEPS: # '+1' is for the eventual ACTION_USE.\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable.\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # Check if this new (position, direction) state has already been visited.\n          # This prevents redundant work and infinite loops in cyclic environments.\n          if (next_y, next_x, next_dir) not in visited_path_info:\n              # Store the action that led to this state and the parent state.\n              visited_path_info[(next_y, next_x, next_dir)] = (action_move, curr_y, curr_x, curr_dir)\n              # Add the new state to the queue for further exploration.\n              q.append((next_y, next_x, next_dir, next_path_length))\n\n  # --- Path Reconstruction ---\n  final_actions = []\n  if goal_reached_coords_and_dir is not None:\n      current_node = goal_reached_coords_and_dir\n      # Backtrack from the goal node to the start node using the `visited_path_info`.\n      while visited_path_info[current_node][0] is not None: # Loop until the start node (which has None as its leading action)\n          action_from_parent, py, px, pd = visited_path_info[current_node]\n          final_actions.append(action_from_parent)\n          current_node = (py, px, pd)\n      \n      # The path was built in reverse order (from goal to start), so reverse it.\n      final_actions.reverse()\n      # Add the final ACTION_USE to collect the primitive.\n      final_actions.append(ACTION_USE)\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  actions_taken = []\n  if not final_actions: # If no path was found or reconstructed (e.g., target unreachable)\n      return []\n\n  for action in final_actions:\n      actions_taken.append(action)\n      reward, done, _ = env.step(action)\n      # Crucial: Always update the `current_state` reference after each step to reflect the new environment.\n      current_state = env._current_state\n\n      # Early exit: If the episode ends prematurely AND the primitive hasn't been collected,\n      # then this path was unsuccessful.\n      if done and current_state.inventory[primitive] <= 0:\n          return []\n\n      # Early exit: If the primitive is collected, we're done. Return the actions taken so far.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n  # Final check after executing all actions in `final_actions`.\n  # This covers cases where the primitive is collected on the very last action of the path.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # This scenario should ideally not happen if the BFS logic is perfectly aligned with environment mechanics\n      # and the environment doesn't change unexpectedly (e.g., primitive disappears).\n      # If the full path was executed but the primitive was not collected, return empty.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T01:24:25.059104", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      ACTION_UP: DIR_NORTH,   # Agent moves North, faces North\n      ACTION_DOWN: DIR_SOUTH, # Agent moves South, faces South\n      ACTION_LEFT: DIR_WEST,  # Agent moves West, faces West\n      ACTION_RIGHT: DIR_EAST  # Agent moves East, faces East\n  }\n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent,\n      based on CraftState.dir (0=East, 1=South, 2=West, 3=North).\n      \"\"\"\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return (y, x) # Fallback, should not be reached with valid directions\n\n  actions_taken = []\n\n  # Access the underlying CraftState instance to get the current state information.\n  # This function computes actions from the *current* state of the environment,\n  # allowing it to be chained with other actions or used as part of a larger plan.\n  current_state = env._current_state\n\n  # Check if the primitive is actually a grabbable item.\n  # If it's not in the world's grabbable_indices, it cannot be collected by ACTION_USE.\n  if primitive not in current_state.world.grabbable_indices:\n      return []\n\n  # Basic validation: Ensure the `primitive` is a recognized entity kind in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # Optimization: If the `primitive` is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Retrieve necessary environment information for pathfinding.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir # Use current_state.dir, as env is not reset to init_dir.\n\n  # Improvement for collect_v2: Dynamically set MAX_COLLECT_STEPS.\n  # This provides a more robust upper bound for path length, allowing for larger maps.\n  # The maximum number of distinct (position, direction) states is grid_height * grid_width * 4.\n  # Add 1 for the final ACTION_USE.\n  MAX_COLLECT_STEPS = grid_height * grid_width * len(ACTION_TO_DIR) + 1\n  \n  # Determine which entity kinds are impassable for agent movement.\n  impassable_for_movement = set()\n  # Water is typically impassable for movement.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  # Any non-grabbable items that are NOT workshops are generally impassable.\n  # Workshops (e.g., workbench, furnace) are usually traversable, even if they can't be picked up.\n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # Format: {action: (resulting_direction_after_move, dy, dx)}\n  # The agent's direction automatically updates based on the movement action performed.\n  movement_actions_map = {\n      ACTION_UP:    (ACTION_TO_DIR[ACTION_UP], -1, 0),    # Move North (dy=-1, dx=0), new dir=DIR_NORTH\n      ACTION_DOWN:  (ACTION_TO_DIR[ACTION_DOWN], 1, 0),   # Move South (dy=1, dx=0), new dir=DIR_SOUTH\n      ACTION_LEFT:  (ACTION_TO_DIR[ACTION_LEFT], 0, -1),  # Move West (dy=0, dx=-1), new dir=DIR_WEST\n      ACTION_RIGHT: (ACTION_TO_DIR[ACTION_RIGHT], 0, 1)  # Move East (dy=0, dx=1), new dir=DIR_EAST\n  }\n\n  q = collections.deque()\n  # BFS queue state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  # Storing the current direction is crucial because `ACTION_USE` is dependent on agent orientation.\n  q.append((start_y, start_x, start_dir, []))\n  \n  # Keep track of visited states to prevent redundant exploration and infinite loops in cyclic maps.\n  # A state is defined by (position_y, position_x, direction) because the same grid cell\n  # with a different orientation constitutes a distinct state for the purpose of `ACTION_USE`.\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None  # This variable will store the final sequence of actions if a valid path is found.\n\n  # If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Optimization: If the current path length already equals or exceeds MAX_COLLECT_STEPS,\n      # this branch cannot lead to a valid solution within the specified limits.\n      # We check `len(path) >= MAX_COLLECT_STEPS` because at least one action (ACTION_USE)\n      # will be added to the path to reach the goal, making it `len(path) + 1`.\n      # If `len(path)` is already `MAX_COLLECT_STEPS - 1`, the next path `path + [ACTION_USE]`\n      # will be `MAX_COLLECT_STEPS` long, which is acceptable.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # Calculate the coordinates of the grid cell that the agent is currently facing.\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Check if the facing cell is within grid boundaries and contains the target primitive.\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n          full_grid[facing_y, facing_x, primitive] > 0):\n\n          # We've found a position and orientation from which `ACTION_USE` can be performed successfully.\n          candidate_path = path + [ACTION_USE]\n\n          # Ensure the complete path (including the final `ACTION_USE`) is within the step limit.\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              # Since BFS guarantees finding the shortest path first, we can stop as soon as one is found.\n              break # Exit the BFS loop\n\n      # Explore all possible next states from the current state (curr_y, curr_x, curr_dir).\n      # This involves trying each possible movement action.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Pruning: If adding this move makes the path too long such that it cannot\n          # accommodate the final ACTION_USE while staying within MAX_COLLECT_STEPS.\n          # The resulting path length after this move would be `len(path) + 1`.\n          # The full path including ACTION_USE would be `len(path) + 2`.\n          # So we need `len(path) + 2 <= MAX_COLLECT_STEPS`.\n          # This means `len(path) < MAX_COLLECT_STEPS - 1`.\n          if len(path) >= MAX_COLLECT_STEPS - 1:\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable based on the `impassable_for_movement` set.\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # Check if this new (position, direction) state has already been visited.\n          # This prevents redundant work and infinite loops in cyclic environments.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # If all checks pass, add the new state to the queue for further exploration.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      # If no valid path was found within the step limit, return an empty list.\n      return []\n\n  for action in path_to_execute:\n      actions_taken.append(action)\n      # Perform the action in the environment.\n      reward, done, _ = env.step(action)\n      # Update the internal state reference after each step to reflect the current environment.\n      current_state = env._current_state\n\n      # Check for early termination of the episode without successfully collecting the primitive.\n      # This ensures robustness if the environment ends due to other reasons (e.g., `max_steps` reached\n      # by `CraftLab`) before the collection is complete.\n      if done and current_state.inventory[primitive] <= 0:\n          return []  # Episode ended, but the goal was not satisfied.\n\n      # If the primitive is collected, we can stop executing the remaining actions in the path.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n  # Final check after executing all actions in the `path_to_execute`.\n  # This handles cases where the primitive is collected on the very last action of the path.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it indicates a discrepancy (e.g., the primitive disappeared dynamically,\n      # or a tool/prerequisite was needed that the current state didn't account for),\n      # which should ideally not happen if the BFS logic is perfectly aligned with environment mechanics.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T01:25:46.341495", "function_name": "collect", "function_body": "    actions_list = []\n    MAX_COLLECT_STEPS = 200  # Arbitrary limit to prevent infinite loops\n\n    # Get action mappings from the environment\n    # env.action_specs() returns a dict like {\"DOWN\": 0, \"UP\": 1, ...}\n    ACTIONS = env.action_specs()\n\n    # Access the CraftWorld instance from the CraftLab environment\n    world = env.world  # CraftWorld instance\n\n    # Define movement deltas for BFS pathfinding\n    # Map action names to (dr, dc) tuples\n    movement_name_to_delta = {\n        \"UP\": (-1, 0),\n        \"DOWN\": (1, 0),\n        \"LEFT\": (0, -1),\n        \"RIGHT\": (0, 1),\n    }\n\n    def _find_path_bfs(start_pos, target_kind_idx, grid, non_passable_indices, actions_map):\n        \"\"\"\n        Finds the shortest path from start_pos to a cell adjacent to target_kind_idx.\n        Returns a list of action integers or None if no path found.\n        actions_map: dict mapping string action names to their integer values.\n        \"\"\"\n        WIDTH, HEIGHT, _ = grid.shape  # Assuming grid is (WIDTH, HEIGHT, n_kinds)\n        \n        # BFS queue stores (current_position_tuple, list_of_action_integers_taken_so_far)\n        queue = deque([(start_pos, [])]) \n        visited = {start_pos} # Set of visited (row, col) tuples\n\n        def is_passable_cell(r, c):\n            \"\"\"Checks if a cell (r, c) is a valid and passable location for agent movement.\"\"\"\n            if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n                return False  # Out of bounds\n            \n            cell_contents = np.where(grid[r, c] == 1)[0] # Get indices of items in this cell\n            \n            if not cell_contents.size: # Empty cell is always passable\n                return True\n            \n            # If the cell contains any item that is defined as non-grabbable (an obstacle),\n            # then the cell is not passable for movement.\n            for item_idx in cell_contents:\n                if item_idx in non_passable_indices:\n                    # An item in non_passable_indices (like water, stone) is an obstacle to movement.\n                    # We need to be *next* to such items to USE them, not walk on them.\n                    return False \n            \n            # If the cell contains only grabbable items (not in non_passable_indices),\n            # assume it's passable for movement.\n            return True\n        \n        # Find ALL locations of the target_kind_idx on the grid.\n        target_locations = []\n        for r in range(WIDTH):\n            for c in range(HEIGHT):\n                if grid[r, c, target_kind_idx] == 1:\n                    target_locations.append((r, c))\n        \n        if not target_locations:\n            return None # Target not found on the map\n\n        # BFS loop\n        while queue:\n            current_pos, path = queue.popleft()\n            \n            # Check if the current position is adjacent to any of the target locations.\n            # If it is, then 'path' leads to a cell from which 'USE' can be applied.\n            for tr, tc in target_locations:\n                # Manhattan distance of 1 means adjacent (not including diagonals)\n                if (abs(current_pos[0] - tr) + abs(current_pos[1] - tc)) == 1:\n                    return path # Found a path to an adjacent cell\n\n            # Explore neighbors\n            for action_name_str, delta in movement_name_to_delta.items():\n                dr, dc = delta\n                next_r, next_c = current_pos[0] + dr, current_pos[1] + dc\n                next_pos = (next_r, next_c)\n\n                if next_pos not in visited and is_passable_cell(next_r, next_c):\n                    visited.add(next_pos)\n                    # Add the integer action value to the path\n                    queue.append((next_pos, path + [actions_map[action_name_str]]))\n\n        return None # No path found to an adjacent cell\n\n    # --- Main collection logic ---\n    steps_taken = 0\n    while env._current_state.inventory[primitive] == 0 and steps_taken < MAX_COLLECT_STEPS:\n        \n        current_state = env._current_state # Get the current CraftState\n        current_pos = current_state.pos    # Agent's current (row, col) integer position\n        current_grid = current_state.grid  # Current grid layout\n\n        # 1. Check if the primitive is already next to the agent\n        if current_state.next_to(primitive):\n            # If so, use it\n            actions_list.append(ACTIONS[\"USE\"])\n            _reward, done, _observations = env.step(ACTIONS[\"USE\"])\n            steps_taken += 1\n            if done: # If environment signals done after an action, break\n                break\n            continue # Go to next loop iteration to re-check inventory\n\n        # 2. If not next to the agent, find a path to a cell adjacent to the primitive\n        path_to_primitive_adj = _find_path_bfs(\n            current_pos, \n            primitive, \n            current_grid, \n            world.non_grabbable_indices, # Obstacles from the world config\n            ACTIONS\n        )\n\n        if path_to_primitive_adj:\n            # Take the first action on the path\n            next_action_int = path_to_primitive_adj[0]\n            actions_list.append(next_action_int)\n            _reward, done, _observations = env.step(next_action_int)\n            steps_taken += 1\n            if done: # If environment signals done after an action, break\n                break\n        else:\n            # No path found to the primitive. This means it's either not on the map,\n            # unreachable, or all instances have been collected.\n            # In this case, we cannot collect it, so break the loop.\n            break \n            \n    return actions_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:25:47.358617", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants based on CraftLab.action_specs()\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  MOVEMENT_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n  # Reset the environment to get the initial state.\n  # Calling reset() ensures a consistent starting point for the search.\n  _ = env.reset() # The return value is an observation dict, we need the internal state.\n  initial_craft_state = env._current_state\n\n  # If the primitive is already in the inventory at the start, no actions are needed.\n  if initial_craft_state.inventory[primitive] > 0:\n    return []\n\n  # Queue for BFS: stores tuples of (CraftState object, list of actions to reach this state)\n  q = collections.deque([(initial_craft_state, [])])\n\n  # Set to store visited states to prevent infinite loops and redundant computation.\n  # A state is defined by (agent_position, agent_direction, current_inventory_as_tuple).\n  # Inventory is included because collecting other items might change available paths\n  # or future actions, and it differentiates states properly.\n  visited = set()\n  # Add the initial state to the visited set.\n  initial_state_tuple = (initial_craft_state.pos, initial_craft_state.dir, tuple(initial_craft_state.inventory))\n  visited.add(initial_state_tuple)\n\n  # A safeguard to prevent excessively long searches for unreachable goals or large maps.\n  # This limit can be adjusted based on expected map sizes and complexity.\n  MAX_SEARCH_STEPS = 50000 \n  \n  steps_searched = 0\n\n  while q and steps_searched < MAX_SEARCH_STEPS:\n    current_state, actions_taken = q.popleft()\n    steps_searched += 1\n\n    # Check if the primitive is already in the inventory (could have been collected\n    # in a previous step on this path, or was initially present).\n    if current_state.inventory[primitive] > 0:\n        return actions_taken\n\n    # If not yet collected, check if the primitive is in the agent's immediate vicinity.\n    if current_state.next_to(primitive):\n      # If next to the primitive, try to use (collect) it.\n      # CraftState.step(USE) returns a new state after the action.\n      _, state_after_use = current_state.step(USE)\n      \n      # If the USE action successfully collected the primitive, we found a solution.\n      if state_after_use.inventory[primitive] > 0:\n        return actions_taken + [USE]\n      \n      # If USE did not collect the primitive (e.g., it was not a directly grabbable primitive\n      # or required a tool), this path branch is not immediately successful for collection.\n      # The search continues for other paths if this USE action didn't yield the goal.\n\n    # Explore all possible movement actions from the current state.\n    for action in MOVEMENT_ACTIONS:\n      # Simulate the action: CraftState.step returns a new CraftState object.\n      _, new_state = current_state.step(action)\n      \n      # Define the new state for visited set lookup.\n      new_state_tuple = (new_state.pos, new_state.dir, tuple(new_state.inventory))\n\n      if new_state_tuple not in visited:\n        visited.add(new_state_tuple)\n        q.append((new_state, actions_taken + [action]))\n\n  # If the queue becomes empty or MAX_SEARCH_STEPS is reached without finding the primitive,\n  # it means the primitive is unreachable or no solution exists within the search limits.\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:26:43.131552", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Maximum number of steps allowed for collection, including movements and the final USE.\n  # This acts as a safeguard against excessively long or infinite searches.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent.\n  # This maps an agent's position and direction to the (y, x) coordinates\n  # of the cell it is facing.\n  def _get_facing_coords(agent_y, agent_x, agent_direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent.\n      Assumes CraftState.dir: 0=East, 1=South, 2=West, 3=North.\n      \"\"\"\n      if agent_direction == DIR_EAST:\n          return (agent_y, agent_x + 1)\n      elif agent_direction == DIR_SOUTH:\n          return (agent_y + 1, agent_x)\n      elif agent_direction == DIR_WEST:\n          return (agent_y, agent_x - 1)\n      elif agent_direction == DIR_NORTH:\n          return (agent_y - 1, agent_x)\n      return (agent_y, agent_x) # Should not be reached with valid directions\n\n  # Retrieve the current state from the CraftLab environment.\n  # The 'env' object is an instance of CraftLab, which holds the current CraftState.\n  current_state = env._current_state\n\n  # --- Input Validation and Early Exit Conditions ---\n  # 1. If the primitive is not in the world's grabbable items, it cannot be collected.\n  if primitive not in current_state.world.grabbable_indices:\n      return []\n\n  # 2. If the primitive ID is not a recognized entity kind in this world, it's invalid.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # 3. If the primitive has already been collected (i.e., it's in inventory), no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # --- Initialize State Information for BFS ---\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  \n  # Agent's starting position and direction. We operate from the *current* state of the environment.\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir \n\n  # Determine which entity kinds are truly impassable for agent movement.\n  # This set is used to determine valid cells for the agent to move into.\n  impassable_for_movement = set()\n  \n  # Water is a common movement blocker.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  # All non-grabbable items are considered impassable *unless* they are workshops.\n  # Workshops are typically non-grabbable but traversable (e.g., crafting tables).\n  for kind_idx in current_state.world.non_grabbable_indices:\n      if kind_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(kind_idx)\n\n  # Define all possible movement actions and their effects on agent state.\n  # Format: {action_id: (resulting_direction_after_move, delta_y, delta_x)}\n  movement_actions_map = {\n      ACTION_UP:    (DIR_NORTH, -1, 0),\n      ACTION_DOWN:  (DIR_SOUTH, 1, 0),\n      ACTION_LEFT:  (DIR_WEST, 0, -1),\n      ACTION_RIGHT: (DIR_EAST, 0, 1)\n  }\n\n  # --- Breadth-First Search (BFS) Initialization ---\n  # The BFS queue stores tuples of (y, x, direction, current_path_length).\n  bfs_queue = collections.deque()\n  bfs_queue.append((start_y, start_x, start_dir, 0))\n\n  # This dictionary stores the path taken to reach each state (y, x, direction).\n  # It maps `(child_y, child_x, child_dir)` to `(action_from_parent, parent_y, parent_x, parent_dir)`.\n  # This allows reconstruction of the shortest path once the goal is found.\n  path_predecessor_map = {(start_y, start_x, start_dir): (None, None, None, None)}\n\n  # This variable will store the target state (y, x, dir) from which the primitive can be collected.\n  # It will be populated by the BFS.\n  goal_collection_state = None \n\n  # If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # --- BFS Main Loop ---\n  while bfs_queue:\n      curr_y, curr_x, curr_dir, current_path_length = bfs_queue.popleft()\n\n      # Check if the current agent state (position and direction) allows for immediate collection.\n      # We check `current_path_length + 1` because the `ACTION_USE` itself consumes one step.\n      if current_path_length + 1 <= MAX_COLLECT_STEPS:\n          facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n          # If the cell in front of the agent contains the primitive, we have found a valid collection point.\n          if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n              full_grid[facing_y, facing_x, primitive] > 0):\n              \n              goal_collection_state = (curr_y, curr_x, curr_dir)\n              break # Found the shortest path to a collection state (due to BFS property).\n\n      # Explore all possible movement actions from the current state.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          next_path_length = current_path_length + 1 # Each move adds one step.\n\n          # Pruning: If the current path plus this move, plus the final USE action,\n          # exceeds the maximum allowed steps, then this path is too long.\n          if next_path_length + 1 > MAX_COLLECT_STEPS:\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable (not blocked by impassable items).\n          is_traversable = True\n          for kind_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, kind_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # Check if this new state (position and direction) has already been visited.\n          # This prevents redundant computations and infinite loops in cyclic environments.\n          if (next_y, next_x, next_dir) not in path_predecessor_map:\n              # Record the action taken and the parent state to reconstruct the path later.\n              path_predecessor_map[(next_y, next_x, next_dir)] = (action_move, curr_y, curr_x, curr_dir)\n              # Add the new valid state to the queue for further exploration.\n              bfs_queue.append((next_y, next_x, next_dir, next_path_length))\n\n  # --- Path Reconstruction ---\n  # If no goal collection state was found by BFS, it means the primitive is unreachable.\n  if goal_collection_state is None:\n      return []\n\n  reconstructed_path = []\n  current_node = goal_collection_state\n  # Backtrack from the goal node to the start node using the predecessor map.\n  # The loop continues until the start node is reached (which has `None` as its leading action).\n  while path_predecessor_map[current_node][0] is not None:\n      action_from_parent, parent_y, parent_x, parent_dir = path_predecessor_map[current_node]\n      reconstructed_path.append(action_from_parent)\n      current_node = (parent_y, parent_x, parent_dir)\n  \n  # The path was built in reverse order (from goal back to start), so reverse it.\n  reconstructed_path.reverse()\n  \n  # Add the final `ACTION_USE` to collect the primitive.\n  reconstructed_path.append(ACTION_USE)\n\n  # --- Execute the Found Path and Monitor Collection Status ---\n  executed_actions = []\n  for action in reconstructed_path:\n      executed_actions.append(action)\n      # Perform the action in the environment.\n      reward, done, _ = env.step(action)\n      # Always update the `current_state` reference to reflect the environment's new state.\n      current_state = env._current_state\n\n      # Early exit: If the primitive is successfully collected, return the actions taken.\n      if current_state.inventory[primitive] > 0:\n          return executed_actions\n\n      # Early exit: If the episode ends prematurely (e.g., max_steps reached)\n      # AND the primitive has NOT been collected, then this attempt failed.\n      if done and current_state.inventory[primitive] <= 0:\n          return []\n\n  # Final check: After executing all actions, verify if the primitive was collected.\n  # This covers cases where collection happens on the very last action.\n  if current_state.inventory[primitive] > 0:\n      return executed_actions\n  else:\n      # This case should ideally not be reached if BFS and execution logic are perfectly aligned.\n      # It implies that the path was executed but the primitive wasn't collected, which might\n      # happen if the environment state changed unexpectedly or the primitive despawned.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T01:26:44.128500", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Maximum number of steps allowed for collection, including movements and the final USE.\n  # This acts as a safeguard against excessively long or infinite searches.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent,\n      based on CraftState.dir (0=East, 1=South, 2=West, 3=North).\n      \"\"\"\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return (y, x) # Should not be reached with valid directions\n\n  # --- Initialize Environment and State ---\n  # Reset the environment to its initial state before starting the search.\n  # This ensures the collection process always begins from a consistent, known state\n  # configured by the scenario, rather than the environment's current arbitrary state.\n  _ = env.reset() \n  current_state = env._current_state # Access the underlying CraftState instance\n\n  # --- Input Validation and Early Exits ---\n  # Check if the primitive is a valid kind in the world.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # Check if the primitive is even a grabbable item. Non-grabbable items cannot be 'collected' by USE.\n  if primitive not in current_state.world.grabbable_indices:\n      return []\n\n  # If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # --- Gather Environment Data for BFS ---\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir # Agent's starting direction after reset\n\n  # Determine which entity kinds are truly impassable for agent movement.\n  # An agent cannot move into a cell occupied by these kinds.\n  impassable_for_movement = set()\n  \n  # Water is a common impassable element in CraftWorld.\n  if current_state.world.water_index is not None and current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  # Generally, non-grabbable items are impassable, with exceptions like workshops.\n  for k_idx in current_state.world.non_grabbable_indices:\n      # Workshops are non-grabbable but are typically traversable (e.g., you can stand on them).\n      if k_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n\n  # Define movement actions and their effects on position and agent direction.\n  # Format: {action: (resulting_direction_after_move, dy, dx)}\n  movement_actions_map = {\n      Action.UP:    (DIR_NORTH, -1, 0),\n      Action.DOWN:  (DIR_SOUTH, 1, 0),\n      Action.LEFT:  (DIR_WEST,  0, -1),\n      Action.RIGHT: (DIR_EAST,  0, 1)\n  }\n\n  # --- Breadth-First Search (BFS) Initialization ---\n  q = collections.deque()\n  # BFS queue stores: (current_y, current_x, current_direction, path_length_so_far)\n  q.append((start_y, start_x, start_dir, 0))\n\n  # `visited_path_info` dictionary for path reconstruction.\n  # Stores: {(y, x, dir): (action_that_led_here, parent_y, parent_x, parent_dir)}\n  # Initialize the start state with None for parent info.\n  visited_path_info = {(start_y, start_x, start_dir): (None, None, None, None)}\n\n  goal_reached_coords_and_dir = None # Stores the (y, x, dir) state from which ACTION_USE is valid.\n\n  # --- BFS Traversal ---\n  while q:\n      curr_y, curr_x, curr_dir, current_path_length = q.popleft()\n\n      # Check if the current state allows immediate collection (primitive is in front).\n      # The `+1` is for the final ACTION_USE, ensuring the total path length remains within limits.\n      if current_path_length + 1 <= MAX_COLLECT_STEPS:\n          facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n          # If the cell in front is within bounds and contains the primitive,\n          # we've found a valid state to collect from.\n          if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n              full_grid[facing_y, facing_x, primitive] > 0):\n              \n              goal_reached_coords_and_dir = (curr_y, curr_x, curr_dir)\n              break # BFS guarantees the first path found is the shortest.\n\n      # Explore all possible movement actions from the current state.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          next_path_length = current_path_length + 1 # This movement takes one step.\n\n          # Pruning: If adding this move makes the total path too long (including final USE).\n          if next_path_length + 1 > MAX_COLLECT_STEPS:\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable (not occupied by an impassable object).\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # Add to queue only if this new state (position + direction) hasn't been visited yet.\n          if (next_y, next_x, next_dir) not in visited_path_info:\n              visited_path_info[(next_y, next_x, next_dir)] = (action_move, curr_y, curr_x, curr_dir)\n              q.append((next_y, next_x, next_dir, next_path_length))\n\n  # --- Path Reconstruction ---\n  final_actions = []\n  if goal_reached_coords_and_dir is not None:\n      current_node = goal_reached_coords_and_dir\n      # Backtrack from the goal state to the start state using the parent pointers.\n      while visited_path_info[current_node][0] is not None: # Loop until the start node (parent action is None)\n          action_from_parent, py, px, pd = visited_path_info[current_node]\n          final_actions.append(action_from_parent)\n          current_node = (py, px, pd)\n      \n      # The path was built in reverse, so reverse it to get the correct sequence.\n      final_actions.reverse()\n      # Append the final USE action to collect the primitive.\n      final_actions.append(Action.USE)\n\n  # --- Execute the Found Path and Monitor Collection Status ---\n  actions_executed = []\n  if not final_actions: # If no path was found (e.g., primitive unreachable)\n      return []\n\n  for action in final_actions:\n      actions_executed.append(action)\n      # Step the environment with the current action.\n      reward, done, _ = env.step(action)\n      # Crucial: Update our reference to the environment's current state after each step.\n      current_state = env._current_state\n\n      # Early exit 1: If the primitive is successfully collected, return the actions taken.\n      if current_state.inventory[primitive] > 0:\n          return actions_executed\n\n      # Early exit 2: If the episode ends prematurely (e.g., max_steps reached)\n      # AND the primitive has NOT been collected, the path failed.\n      if done:\n          return []\n\n  # Final check: After executing all actions, verify if the primitive was collected.\n  # This covers cases where the collection happens on the very last ACTION_USE.\n  if current_state.inventory[primitive] > 0:\n      return actions_executed\n  else:\n      # If the entire path was executed but the primitive was not collected,\n      # something went wrong or the path was invalid.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T01:28:00.139969", "function_name": "collect", "function_body": "  obs = env.observations()\n  current_grid = obs['features_dict']['features_global']\n  \n  # Denormalize position from (0,1) range to grid coordinates\n  grid_width, grid_height, _ = current_grid.shape\n  current_pos_normalized = obs['features_dict']['pos']\n  current_pos = (int(round(current_pos_normalized[0] * (grid_width - 1))),\n                 int(round(current_pos_normalized[1] * (grid_height - 1))))\n  current_inventory = obs['features_dict']['inventory']\n\n  # If the primitive is already in inventory, no actions are needed.\n  if current_inventory[primitive] > 0:\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define possible movements and their corresponding actions\n  MOVES = [\n      ((0, 1), DOWN),   # (dx, dy), action for moving\n      ((0, -1), UP),\n      ((-1, 0), LEFT),\n      ((1, 0), RIGHT),\n  ]\n\n  # Determine if the primitive is grabbable (picked up by moving onto its cell)\n  # or requires the USE action (e.g., a tree, a workshop).\n  is_grabbable = primitive in env.world.grabbable_indices\n\n  # Helper function to check if a primitive is in the 3x3 neighborhood around a given cell.\n  # This corresponds to CraftState's next_to logic.\n  def is_next_to_primitive_in_grid(x, y, target_primitive_idx, grid):\n    grid_w, grid_h, _ = grid.shape\n    for dx_n in [-1, 0, 1]:\n      for dy_n in [-1, 0, 1]:\n        nx, ny = x + dx_n, y + dy_n\n        if 0 <= nx < grid_w and 0 <= ny < grid_h:\n          if grid[nx, ny, target_primitive_idx] > 0:\n            return True\n    return False\n\n  # Initialize Breadth-First Search (BFS)\n  queue = deque([(current_pos[0], current_pos[1], [])])  # (x, y, list_of_actions_taken_to_reach_here)\n  visited = {(current_pos[0], current_pos[1])}\n\n  while queue:\n    cx, cy, current_actions = queue.popleft()\n\n    # Check if the goal condition is met for the current position (cx, cy)\n    if is_grabbable:\n      # If grabbable, goal is to be on the cell containing the primitive\n      if current_grid[cx, cy, primitive] > 0:\n        return current_actions\n    else:\n      # If not grabbable, goal is to be next to the primitive to USE it\n      if is_next_to_primitive_in_grid(cx, cy, primitive, current_grid):\n        return current_actions + [USE]\n\n    # Explore valid neighbors\n    for (dx, dy), action in MOVES:\n      nx, ny = cx + dx, cy + dy\n\n      # Check boundary conditions\n      if 0 <= nx < grid_width and 0 <= ny < grid_height:\n        # Check if this cell has already been visited\n        if (nx, ny) not in visited:\n          visited.add((nx, ny))\n          queue.append((nx, ny, current_actions + [action]))\n\n  # If the primitive is not found or is unreachable, return an empty list of actions.\n  return []", "island_id": 3, "scores": {"3": -1}}
