{"timestamp": "2025-07-30T19:34:06.224122", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # 1. Get action IDs\n    action_specs = env.action_specs()\n    DOWN = action_specs['DOWN']['id']\n    UP = action_specs['UP']['id']\n    LEFT = action_specs['LEFT']['id']\n    RIGHT = action_specs['RIGHT']['id']\n    USE = action_specs['USE']['id']\n\n    # 2. Get current state from the environment\n    # Accessing private attribute _current_state is common in these competitive programming contexts.\n    current_state = env._current_state\n    grid = current_state.grid\n    pos = current_state.pos\n    inventory = current_state.inventory\n    world = current_state.world # CraftWorld instance\n\n    WIDTH, HEIGHT, _ = grid.shape\n    \n    # 3. Check if primitive is already in inventory\n    if inventory[primitive] > 0:\n        return [] # Already collected\n\n    # Get non-grabbable indices which represent obstacles (e.g., walls, water, etc.)\n    # Items in world.cookbook.environment are typically non-traversable/non-grabbable\n    obstacles_indices = world.cookbook.environment \n    \n    # Check if the primitive itself is grabbable (can be picked up with USE)\n    # If it's not in world.grabbable_indices, it means it cannot be collected\n    # by a simple USE action.\n    if primitive not in world.grabbable_indices:\n        return [] # This primitive cannot be collected directly\n\n    # Pre-calculate all locations where the primitive exists on the grid\n    # np.argwhere returns (x, y) coordinates for a (WIDTH, HEIGHT, KINDS) grid\n    all_primitive_locations = set(tuple(p) for p in np.argwhere(grid[:, :, primitive] > 0))\n\n    # If no primitive found on the grid, there's nothing to collect\n    if not all_primitive_locations:\n        return []\n\n    # BFS for shortest path to a collectable position\n    queue = collections.deque([(pos, [])]) # Queue stores (current_position, path_actions_taken)\n    visited = set([pos]) # Set of visited positions to avoid cycles and redundant paths\n\n    # Movement deltas for UP, DOWN, LEFT, RIGHT actions\n    # (dx, dy) where dx is change in x, dy is change in y\n    # Assuming (0,0) is top-left, x increases right, y increases down\n    move_deltas = {\n        UP: (0, -1),    # Move North\n        DOWN: (0, 1),   # Move South\n        LEFT: (-1, 0),  # Move West\n        RIGHT: (1, 0)   # Move East\n    }\n    \n    while queue:\n        (curr_x, curr_y), path_actions = queue.popleft()\n\n        # Check if the current position allows collecting the primitive:\n        # Option 1: Agent is standing directly on the primitive\n        if (curr_x, curr_y) in all_primitive_locations:\n            # If agent is on the primitive and it's grabbable, then USE will collect it.\n            return path_actions + [USE]\n\n        # Option 2: Agent is 4-adjacent to a primitive location\n        # Iterate through adjacent cells to see if any contain the primitive\n        for dx, dy in move_deltas.values(): \n            adj_x, adj_y = curr_x + dx, curr_y + dy\n            if (adj_x, adj_y) in all_primitive_locations:\n                # Found a path to a cell adjacent to the primitive\n                # Append USE action and return the path\n                return path_actions + [USE]\n\n        # Explore possible moves from the current position\n        for action, (dx, dy) in move_deltas.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_pos = (next_x, next_y)\n\n            # Check boundary conditions: ensure new position is within grid limits\n            if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                continue\n\n            # Check if the next cell is an obstacle (cannot move onto it)\n            is_obstacle = False\n            for obstacle_idx in obstacles_indices:\n                if grid[next_x, next_y, obstacle_idx] > 0:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue # Cannot move to an obstacle cell\n            \n            # Check if this position has already been visited to avoid redundant paths\n            if next_pos in visited:\n                continue\n\n            # Add new position to visited set and queue for further exploration\n            visited.add(next_pos)\n            queue.append((next_pos, path_actions + [action]))\n            \n    # If the queue becomes empty and no path to a collectable position was found\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:35:32.663546", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Define direction constants for agent's orientation (internal representation)\n  _DIR_UP = 0\n  _DIR_RIGHT = 1\n  _DIR_DOWN = 2\n  _DIR_LEFT = 3\n\n  # Get action mappings from the environment\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario (assuming they are consistent)\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position (features_dict['pos'] is normalized 0-1)\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  \n  # Get current agent direction (convert one-hot array to integer 0-3)\n  current_dir_int = np.argmax(features_dict['direction'])\n\n  # Early exit if the primitive is not grabbable\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Find all grid locations where the primitive exists\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell (assuming 1 for presence)\n      if current_grid[x, y, primitive] == 1: \n        primitive_locations.append((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  # --- IMPROVEMENT for collect_v2: More comprehensive impassable terrain definition ---\n  # In collect_v1, only 'water_index' was considered impassable.\n  # Here, we generalize to consider all non-grabbable entities as impassable,\n  # with the exception of 'workshop_indices' which are often non-grabbable but traversable.\n  impassable_movement_terrain_indices = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  def is_obstacle(x, y, grid, impassable_kinds_set):\n    \"\"\"\n    Checks if the cell (x,y) contains any truly impassable item for agent movement.\n    Assumes (x,y) is already validated to be within grid bounds.\n    \"\"\"\n    for k in impassable_kinds_set:\n      if grid[x, y, k] == 1: \n        return True\n    return False\n\n  # --- BFS for shortest path to an *interaction point* ---\n  # BFS queue stores tuples: ((current_x, current_y, current_direction), [path_actions_taken])\n  q = collections.deque()\n  start_state = (current_px, current_py, current_dir_int)\n  q.append((start_state, [])) \n  \n  # Set to store visited states (position + direction) to avoid cycles and redundant paths\n  visited = {start_state} \n\n  # Define possible movement actions, their resulting new position, and the agent's direction after the move\n  # Format: (dx, dy, environment_action_id, new_agent_direction_constant)\n  move_actions_info = [\n      (0, -1, _UP, _DIR_UP),    # Move up, agent faces up\n      (0, 1, _DOWN, _DIR_DOWN),  # Move down, agent faces down\n      (-1, 0, _LEFT, _DIR_LEFT), # Move left, agent faces left\n      (1, 0, _RIGHT, _DIR_RIGHT) # Move right, agent faces right\n  ]\n\n  # Define turning actions (in-place rotation)\n  # Format: (environment_action_id, direction_offset)\n  # offset -1 for left turn (counter-clockwise), +1 for right turn (clockwise)\n  turn_actions_info = [\n      (_LEFT, -1), \n      (_RIGHT, 1)  \n  ]\n\n  # Pre-calculate all target interaction states for all primitive locations.\n  # A target interaction state is (adjacent_x, adjacent_y, required_facing_direction)\n  # from which the agent can successfully _USE_ the primitive.\n  target_interaction_states = set()\n  for Px, Py in primitive_locations:\n      # If agent is at (Px-1, Py), it needs to face RIGHT (_DIR_RIGHT) to use (Px, Py)\n      if Px - 1 >= 0:  target_interaction_states.add((Px - 1, Py, _DIR_RIGHT))\n      # If agent is at (Px+1, Py), it needs to face LEFT (_DIR_LEFT) to use (Px, Py)\n      if Px + 1 < WIDTH: target_interaction_states.add((Px + 1, Py, _DIR_LEFT))\n      # If agent is at (Px, Py-1), it needs to face DOWN (_DIR_DOWN) to use (Px, Py)\n      if Py - 1 >= 0:  target_interaction_states.add((Px, Py - 1, _DIR_DOWN))\n      # If agent is at (Px, Py+1), it needs to face UP (_DIR_UP) to use (Px, Py)\n      if Py + 1 < HEIGHT: target_interaction_states.add((Px, Py + 1, _DIR_UP))\n    \n  # Main BFS loop\n  while q:\n    (cx, cy, c_dir), current_path = q.popleft()\n\n    # Check if the current state is one of the goal interaction states\n    if (cx, cy, c_dir) in target_interaction_states:\n        # Goal reached: agent is at a valid adjacent position, facing the primitive.\n        # Append the _USE action as the final step and return the path.\n        # BFS guarantees this is the shortest path.\n        return current_path + [_USE]\n\n    # Explore movement actions\n    for dx, dy, move_action_id, n_dir_after_move in move_actions_info:\n      nx, ny = cx + dx, cy + dy\n\n      # Check for valid grid bounds and if the new cell is an obstacle\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue # Out of bounds\n      if is_obstacle(nx, ny, current_grid, impassable_movement_terrain_indices):\n        continue # Obstacle present\n\n      new_state = (nx, ny, n_dir_after_move) \n      if new_state not in visited:\n        visited.add(new_state)\n        q.append((new_state, current_path + [move_action_id]))\n\n    # Explore turning actions (agent stays in the same cell but changes direction)\n    for turn_action_id, dir_offset in turn_actions_info:\n        n_dir_after_turn = (c_dir + dir_offset + 4) % 4 # Ensure direction wraps correctly (0-3)\n        new_state = (cx, cy, n_dir_after_turn)\n        if new_state not in visited:\n            visited.add(new_state)\n            q.append((new_state, current_path + [turn_action_id]))\n\n  # If BFS finishes and no path was found (e.g., primitive is entirely unreachable)\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:35:33.673248", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Define direction constants for agent's orientation (internal representation)\n  _DIR_UP = 0\n  _DIR_RIGHT = 1\n  _DIR_DOWN = 2\n  _DIR_LEFT = 3\n\n  # Get action mappings from the environment\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  # IMPROVEMENT 1: Check if the primitive is already in the agent's inventory.\n  # If so, no actions are needed to collect it.\n  current_inventory = features_dict['inventory']\n  if current_inventory[primitive] > 0:\n      return []\n\n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario (assuming they are consistent)\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position (features_dict['pos'] is normalized 0-1)\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  \n  # Get current agent direction (convert one-hot array to integer 0-3)\n  current_dir_int = np.argmax(features_dict['direction'])\n\n  # Early exit if the primitive is not grabbable (cannot be collected)\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Find all grid locations where the primitive exists\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell (assuming 1 for presence)\n      if current_grid[x, y, primitive] == 1: \n        primitive_locations.append((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  # IMPROVEMENT 2: Define truly impassable terrain indices more comprehensively.\n  # In addition to water, consider stone as an impassable obstacle for movement.\n  impassable_movement_terrain_indices = {env.world.water_index, env.world.stone_index} \n\n  def is_obstacle(x, y, grid, impassable_kinds_set):\n    \"\"\"\n    Checks if the cell (x,y) contains any truly impassable item for agent movement.\n    Assumes (x,y) is already validated to be within grid bounds.\n    \"\"\"\n    # A cell is an obstacle if it contains any kind listed in `impassable_kinds_set`\n    for k in impassable_kinds_set:\n      if grid[x, y, k] == 1: \n        return True\n    return False\n\n  # --- BFS for shortest path to an *interaction point* ---\n  # BFS queue stores tuples: ((current_x, current_y, current_direction), [path_actions_taken])\n  q = collections.deque()\n  start_state = (current_px, current_py, current_dir_int)\n  q.append((start_state, [])) \n  \n  # Set to store visited states (position + direction) to avoid cycles and redundant paths\n  visited = {start_state} \n\n  # Define possible movement actions, their resulting new position, and the agent's direction after the move\n  # Format: (dx, dy, environment_action_id, new_agent_direction_constant)\n  move_actions_info = [\n      (0, -1, _UP, _DIR_UP),    # Move up, agent faces up\n      (0, 1, _DOWN, _DIR_DOWN),  # Move down, agent faces down\n      (-1, 0, _LEFT, _DIR_LEFT), # Move left, agent faces left\n      (1, 0, _RIGHT, _DIR_RIGHT) # Move right, agent faces right\n  ]\n\n  # Define turning actions (in-place rotation)\n  # Format: (environment_action_id, direction_offset)\n  # offset -1 for left turn (counter-clockwise), +1 for right turn (clockwise)\n  turn_actions_info = [\n      (_LEFT, -1), \n      (_RIGHT, 1)  \n  ]\n\n  # Pre-calculate all target interaction states for all primitive locations.\n  # A target interaction state is (adjacent_x, adjacent_y, required_facing_direction)\n  # from which the agent can successfully _USE_ the primitive.\n  target_interaction_states = set()\n  for Px, Py in primitive_locations:\n      # If agent is at (Px-1, Py), it needs to face RIGHT (_DIR_RIGHT) to use (Px, Py)\n      if Px - 1 >= 0:  target_interaction_states.add((Px - 1, Py, _DIR_RIGHT))\n      # If agent is at (Px+1, Py), it needs to face LEFT (_DIR_LEFT) to use (Px, Py)\n      if Px + 1 < WIDTH: target_interaction_states.add((Px + 1, Py, _DIR_LEFT))\n      # If agent is at (Px, Py-1), it needs to face DOWN (_DIR_DOWN) to use (Px, Py)\n      if Py - 1 >= 0:  target_interaction_states.add((Px, Py - 1, _DIR_DOWN))\n      # If agent is at (Px, Py+1), it needs to face UP (_DIR_UP) to use (Px, Py)\n      if Py + 1 < HEIGHT: target_interaction_states.add((Px, Py + 1, _DIR_UP))\n    \n  # Main BFS loop\n  while q:\n    (cx, cy, c_dir), current_path = q.popleft()\n\n    # Check if the current state is one of the goal interaction states\n    if (cx, cy, c_dir) in target_interaction_states:\n        # Goal reached: agent is at a valid adjacent position, facing the primitive.\n        # Append the _USE action as the final step and return the path.\n        # BFS guarantees this is the shortest path.\n        return current_path + [_USE]\n\n    # Explore movement actions\n    for dx, dy, move_action_id, n_dir_after_move in move_actions_info:\n      nx, ny = cx + dx, cy + dy\n\n      # Check for valid grid bounds and if the new cell is an obstacle\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue # Out of bounds\n      if is_obstacle(nx, ny, current_grid, impassable_movement_terrain_indices):\n        continue # Obstacle present\n\n      new_state = (nx, ny, n_dir_after_move) \n      if new_state not in visited:\n        visited.add(new_state)\n        q.append((new_state, current_path + [move_action_id]))\n\n    # Explore turning actions (agent stays in the same cell but changes direction)\n    for turn_action_id, dir_offset in turn_actions_info:\n        n_dir_after_turn = (c_dir + dir_offset + 4) % 4 # Ensure direction wraps correctly (0-3)\n        new_state = (cx, cy, n_dir_after_turn)\n        if new_state not in visited:\n            visited.add(new_state)\n            q.append((new_state, current_path + [turn_action_id]))\n\n  # If BFS finishes and no path was found (e.g., primitive is entirely unreachable)\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:37:56.609447", "function_name": "collect", "function_body": "    initial_craft_state = env._current_state\n    \n    # Check if primitive is already collected\n    if initial_craft_state.satisfies(None, primitive):\n        return []\n\n    # Action constants, derived from env.action_specs()\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Queue stores (current_craft_state, list_of_actions_to_reach_this_state)\n    q = collections.deque()\n    q.append((initial_craft_state, []))\n\n    # Visited set stores (pos_tuple_ (r,c), dir_int).\n    # This is a common simplification for pathfinding in grid worlds where\n    # inventory changes are primarily for the goal state, not intermediate path steps.\n    # It assumes that movement actions don't significantly alter the grid state\n    # in a way that affects pathfinding to the primitive's location.\n    visited = set()\n    \n    # Helper function to generate a unique key for the visited set\n    def get_state_key(state_obj):\n        return (state_obj.pos, state_obj.dir)\n\n    # Add initial state to visited\n    visited.add(get_state_key(initial_craft_state))\n\n    # Get grabbable indices from the world configuration.\n    # Only grabbable items can be directly collected using the USE action.\n    world = env.world\n    grabbable_indices = world.grabbable_indices\n\n    # Set a maximum path length to prevent excessively long searches or infinite loops\n    MAX_PATH_LENGTH = 100 \n\n    while q:\n        current_state, current_path = q.popleft()\n\n        # Prune paths that are too long to limit search space\n        if len(current_path) >= MAX_PATH_LENGTH:\n            continue\n        \n        # Check if the primitive is already collected in the current state.\n        # This can happen if a previous action (e.g., USE) completed the goal.\n        if current_state.satisfies(None, primitive):\n            return current_path\n        \n        # --- Pre-goal check: Try USE action if agent is in a position to collect ---\n        # If the current_state indicates that the agent is next to the primitive\n        # (meaning the primitive is in the 3x3 neighborhood, including the agent's cell)\n        # AND the primitive is a grabbable item, then attempting the USE action is viable.\n        if current_state.next_to(primitive) and primitive in grabbable_indices:\n            # Simulate the USE action from the current state.\n            # _reward is ignored as per the problem's step function description.\n            _reward, state_after_use = current_state.step(ACTION_USE)\n            \n            # If the primitive is now in the inventory after the USE action,\n            # this means we've successfully collected it. Return the path.\n            if state_after_use.satisfies(None, primitive):\n                return current_path + [ACTION_USE]\n            # If USE did not lead to the goal, we do not add state_after_use to the queue\n            # with this simple visited key, as its (pos, dir) is the same as current_state.\n            # This is correct if USE is solely for collection, not for intermediate path changes.\n\n        # --- Explore movement actions (UP, DOWN, LEFT, RIGHT) ---\n        # For each possible movement action, simulate the next state and check if it's new.\n        for action_move in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n            new_path = current_path + [action_move]\n            \n            # Simulate taking the movement action to get the next state.\n            # CraftState.step() handles grid boundaries and collisions (e.g., moving into walls).\n            _reward, next_state_after_move = current_state.step(action_move)\n            \n            next_state_key = get_state_key(next_state_after_move)\n            \n            # Only add the new state to the queue if it has not been visited before.\n            # This prevents cycles and ensures the shortest path is found first.\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((next_state_after_move, new_path))\n                        \n    # If the queue becomes empty and the primitive has not been collected,\n    # it means no path was found within the search limits.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:37:57.589119", "function_name": "collect", "function_body": "  # Constants for actions\n  ACTIONS = {\n      \"DOWN\": 0, \"UP\": 1, \"LEFT\": 2, \"RIGHT\": 3, \"USE\": 4\n  }\n\n  # (dx, dy) for moving in a direction and the action corresponding to that move.\n  # Assumes that taking a movement action also sets the agent's facing direction.\n  # E.g., moving UP makes the agent face North (dir 0).\n  # Dir map from CraftState: 0-North, 1-East, 2-South, 3-West\n  # (dir_idx): (dx_for_move, dy_for_move, action_id_for_move)\n  MOVE_DIRECTIONS = {\n      0: (0, -1, ACTIONS[\"UP\"]),    # North: (dx, dy) = (0, -1), action UP\n      1: (1, 0, ACTIONS[\"RIGHT\"]),  # East:  (dx, dy) = (1, 0), action RIGHT\n      2: (0, 1, ACTIONS[\"DOWN\"]),   # South: (dx, dy) = (0, 1), action DOWN\n      3: (-1, 0, ACTIONS[\"LEFT\"])   # West:  (dx, dy) = (-1, 0), action LEFT\n  }\n\n  final_actions = []\n\n  # 1. Get initial state information\n  # Accessing _current_state directly for initial pos\n  initial_state = env._current_state\n  current_x, current_y = initial_state.pos # (x, y) coordinates\n\n  # Get the global grid from observations\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  # grid shape is (WIDTH, HEIGHT, n_kinds) where WIDTH is X-dimension, HEIGHT is Y-dimension\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 2. Find the target primitive location on the grid\n  # np.where returns (rows, cols) which correspond to (y_coords, x_coords)\n  primitive_y_coords, primitive_x_coords = np.where(grid[:, :, primitive] > 0)\n\n  if primitive_x_coords.size == 0:\n      return [] # Primitive not found on the grid\n\n  # Find the closest primitive (Manhattan distance)\n  target_x, target_y = -1, -1\n  min_dist = float('inf')\n\n  for i in range(primitive_x_coords.size):\n      px, py = primitive_x_coords[i], primitive_y_coords[i]\n      dist = abs(px - current_x) + abs(py - current_y)\n      if dist < min_dist:\n          min_dist = dist\n          target_x, target_y = px, py\n\n  # 3. Pathfinding (BFS) to a \"staging\" cell\n  # A staging cell is a cell (sx, sy) from which, after taking a movement action\n  # to reach it, the agent would be facing the target item (target_x, target_y).\n  # And then a single USE action would collect the item.\n\n  # BFS state: ((x, y), path_list_of_actions)\n  # (x, y) is the agent's current position\n  # path_list_of_actions is the sequence of moves taken to reach (x,y)\n  queue = collections.deque([((current_x, current_y), [])])\n  \n  # Visited set: (x, y) to avoid cycles and redundant exploration\n  visited = set([(current_x, current_y)])\n\n  while queue:\n      (x, y), path = queue.popleft()\n\n      # Iterate through all possible movement actions from (x,y)\n      # Each move takes the agent to a 'next_pos' and sets its facing direction.\n      for move_dir_idx, (dx_move, dy_move, move_action_id) in MOVE_DIRECTIONS.items():\n          # Calculate the position after taking this move action from (x,y)\n          next_x, next_y = x + dx_move, y + dy_move\n\n          # Check grid boundaries for the potential 'next_pos'\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # After moving to (next_x, next_y) with move_action_id,\n          # the agent's facing direction would be `move_dir_idx`.\n          # We need to check if (target_x, target_y) is exactly one step\n          # ahead of (next_x, next_y) in this direction.\n          \n          # Calculate the cell that would be in front of the agent at (next_x, next_y)\n          # if it is facing `move_dir_idx`.\n          cell_in_front_x = next_x + MOVE_DIRECTIONS[move_dir_idx][0]\n          cell_in_front_y = next_y + MOVE_DIRECTIONS[move_dir_idx][1]\n\n          if (cell_in_front_x, cell_in_front_y) == (target_x, target_y):\n              # Found a valid sequence of moves.\n              # `path + [move_action_id]` leads to `(next_x, next_y)`\n              # and the agent is facing `move_dir_idx`, which points directly to `target_pos`.\n              final_actions = path + [move_action_id, ACTIONS[\"USE\"]]\n              return final_actions # Return the first (shortest) path found by BFS\n\n          # If this 'next_pos' is not a staging position, continue exploring from it.\n          new_pos = (next_x, next_y)\n          if new_pos not in visited:\n              visited.add(new_pos)\n              queue.append((new_pos, path + [move_action_id]))\n\n  return [] # No path found to any staging position that allows collection", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:38:36.673074", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Mapping from movement action to the direction the agent would face after taking it\n  # When moving, the agent's direction automatically aligns with the movement.\n  ACTION_TO_DIRECTION = {\n      UP_ACTION: NORTH_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  # Mapping from movement action to (dx, dy) delta\n  ACTION_TO_MOVE_DELTA = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  # Mapping from agent's direction to the (dx, dy) delta of the cell directly in front\n  DIRECTION_TO_FRONT_DELTA = {\n      NORTH_DIR: (0, -1),\n      EAST_DIR: (1, 0),\n      SOUTH_DIR: (0, 1),\n      WEST_DIR: (-1, 0)\n  }\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  def is_walkable(x, y, current_grid):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-grabbable items.\"\"\"\n    # Check bounds\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item is present at (y, x) that would block movement\n    for kind_idx in non_grabbable_kinds:\n      if current_grid[y, x, kind_idx] > 0:\n        return False\n    return True\n\n  # Initialize BFS queue: (current_x, current_y, current_direction, path_actions_list)\n  # The path_actions_list stores the sequence of actions taken to reach this state.\n  queue = collections.deque([(start_pos_x, start_pos_y, start_dir, [])])\n  \n  # Initialize visited set to avoid cycles and redundant paths.\n  # A state is defined by (x, y, direction) as the agent's direction matters for valid actions.\n  visited = {(start_pos_x, start_pos_y, start_dir)}\n\n  # Run Breadth-First Search\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # --- Goal Check: Can we use the primitive from the current state? ---\n    # Determine the coordinates of the cell directly in front of the agent\n    front_dx, front_dy = DIRECTION_TO_FRONT_DELTA[curr_dir]\n    front_x, front_y = curr_x + front_dx, curr_y + front_dy\n\n    # Check if the cell in front is within bounds and contains the target primitive\n    if (0 <= front_x < grid_width and 0 <= front_y < grid_height and\n        grid[front_y, front_x, primitive_id] > 0):\n      # Goal reached: The agent is next to the primitive and facing it.\n      # Return the path taken plus the USE action.\n      return path_actions + [USE_ACTION]\n\n    # --- Expand possible next states from the current state ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for move_action, (dx, dy) in ACTION_TO_MOVE_DELTA.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      # When a movement action is taken, the agent's direction automatically updates\n      # to face the direction of movement.\n      next_dir_after_move = ACTION_TO_DIRECTION[move_action]\n\n      # Check if the next cell is walkable and this state (position + direction) hasn't been visited\n      if is_walkable(next_x, next_y, grid) and \\\n         (next_x, next_y, next_dir_after_move) not in visited:\n        visited.add((next_x, next_y, next_dir_after_move))\n        queue.append((next_x, next_y, next_dir_after_move, path_actions + [move_action]))\n\n    # B. Turning Actions (LEFT, RIGHT)\n    # These actions change only the agent's direction, not its position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      if turn_action == LEFT_ACTION:\n        # Turn counter-clockwise (0->3, 1->0, 2->1, 3->2)\n        next_dir = (curr_dir - 1 + 4) % 4\n      else: # RIGHT_ACTION\n        # Turn clockwise (0->1, 1->2, 2->3, 3->0)\n        next_dir = (curr_dir + 1) % 4\n\n      # Position remains the same (curr_x, curr_y)\n      if (curr_x, curr_y, next_dir) not in visited:\n        visited.add((curr_x, curr_y, next_dir))\n        queue.append((curr_x, curr_y, next_dir, path_actions + [turn_action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:38:37.705502", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Mapping from movement action to the direction the agent would face after taking it\n  ACTION_TO_DIRECTION = {\n      UP_ACTION: NORTH_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  # Mapping from movement action to (dx, dy) delta\n  ACTION_TO_MOVE_DELTA = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  # Mapping from agent's direction to the (dx, dy) delta of the cell directly in front\n  DIRECTION_TO_FRONT_DELTA = {\n      NORTH_DIR: (0, -1),\n      EAST_DIR: (1, 0),\n      SOUTH_DIR: (0, 1),\n      WEST_DIR: (-1, 0)\n  }\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Check if the primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  def is_walkable(x, y, current_grid):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-grabbable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item is present at (y, x)\n    for kind_idx in non_grabbable_kinds:\n      if current_grid[y, x, kind_idx] > 0:\n        return False\n    return True\n\n  # Initialize BFS queue: (current_x, current_y, current_direction, path_actions_list)\n  queue = collections.deque([(start_pos_x, start_pos_y, start_dir, [])])\n  # Initialize visited set to avoid cycles and redundant paths: (x, y, direction)\n  visited = {(start_pos_x, start_pos_y, start_dir)}\n\n  # Run BFS\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # --- Goal Check: Can we use the primitive from the current state? ---\n    # Determine the cell directly in front of the agent\n    front_dx, front_dy = DIRECTION_TO_FRONT_DELTA[curr_dir]\n    front_x, front_y = curr_x + front_dx, curr_y + front_dy\n\n    # Check if the cell in front is within bounds and contains the primitive\n    if (0 <= front_x < grid_width and 0 <= front_y < grid_height and\n        grid[front_y, front_x, primitive_id] > 0):\n      return path_actions + [USE_ACTION] # Goal reached: return path plus USE action\n\n    # --- Expand possible next states ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for move_action, (dx, dy) in ACTION_TO_MOVE_DELTA.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      # After a movement action, the agent's direction automatically aligns with the movement.\n      next_dir_after_move = ACTION_TO_DIRECTION[move_action]\n\n      if is_walkable(next_x, next_y, grid) and\\\n         (next_x, next_y, next_dir_after_move) not in visited:\n        visited.add((next_x, next_y, next_dir_after_move))\n        queue.append((next_x, next_y, next_dir_after_move, path_actions + [move_action]))\n\n    # B. Turning Actions (LEFT, RIGHT)\n    # These actions change direction but not position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n\n      # Position remains the same\n      if (curr_x, curr_y, next_dir) not in visited:\n        visited.add((curr_x, curr_y, next_dir))\n        queue.append((curr_x, curr_y, next_dir, path_actions + [turn_action]))\n\n  # If the queue becomes empty and no path to a primitive was found\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:40:28.097733", "function_name": "collect", "function_body": "    actions_taken = []\n    \n    # Get action integer IDs from the environment's action specifications\n    action_ids = env.action_specs()\n    ACTION_DOWN = action_ids['DOWN']\n    ACTION_UP = action_ids['UP']\n    ACTION_LEFT = action_ids['LEFT']\n    ACTION_RIGHT = action_ids['RIGHT']\n    ACTION_USE = action_ids['USE']\n\n    # Maximum number of steps to attempt collection to prevent infinite loops\n    MAX_TOTAL_STEPS = 500 \n\n    # Get the set of indices for grabbable items from the world configuration\n    grabbable_indices = env.world.grabbable_indices\n\n    for step_count in range(MAX_TOTAL_STEPS):\n        current_state = env._current_state # Access the current CraftState object\n        current_pos = current_state.pos      # Agent's (x, y) position\n        current_dir = current_state.dir      # Agent's facing direction (0:N, 1:E, 2:S, 3:W)\n        grid = current_state.grid            # Current grid occupancy (WIDTH, HEIGHT, n_kinds)\n\n        # 1. Check if the primitive is already in the inventory\n        if current_state.inventory[primitive] > 0:\n            return actions_taken\n\n        # 2. Check if the primitive is at the agent's current location (underfoot)\n        # and it is a grabbable item.\n        if grid[current_pos[0], current_pos[1], primitive] > 0 and primitive in grabbable_indices:\n            # If found underfoot and grabbable, attempt to USE it directly.\n            _, _, _ = env.step(ACTION_USE)\n            actions_taken.append(ACTION_USE)\n            if env._current_state.inventory[primitive] > 0:\n                return actions_taken\n            # If not collected, continue to the next loop iteration (e.g., maybe USE failed or it's not truly grabbable).\n\n        # 3. Check if the primitive is in the 3x3 neighborhood (including diagonals)\n        # and it is a grabbable item.\n        if primitive in grabbable_indices and current_state.next_to(primitive):\n            primitive_pos_in_view = None\n            # Find the exact coordinates of the primitive in the neighborhood\n            for dx_offset in [-1, 0, 1]:\n                for dy_offset in [-1, 0, 1]:\n                    # Skip the agent's own cell as 'next_to' implies not current cell\n                    if dx_offset == 0 and dy_offset == 0:\n                        continue\n                    \n                    check_x, check_y = current_pos[0] + dx_offset, current_pos[1] + dy_offset\n                    \n                    # Ensure coordinates are within grid boundaries\n                    if 0 <= check_x < grid.shape[0] and 0 <= check_y < grid.shape[1]:\n                        if grid[check_x, check_y, primitive] > 0:\n                            primitive_pos_in_view = (check_x, check_y)\n                            break\n                if primitive_pos_in_view:\n                    break\n\n            if primitive_pos_in_view:\n                # Calculate relative direction (dx, dy) to the primitive\n                rel_dx = primitive_pos_in_view[0] - current_pos[0]\n                rel_dy = primitive_pos_in_view[1] - current_pos[1]\n\n                # Determine the target cardinal direction to face (0:N, 1:E, 2:S, 3:W)\n                target_dir = -1\n                if rel_dy == -1 and rel_dx == 0: target_dir = 0 # North (UP)\n                elif rel_dx == 1 and rel_dy == 0: target_dir = 1 # East (RIGHT)\n                elif rel_dy == 1 and rel_dx == 0: target_dir = 2 # South (DOWN)\n                elif rel_dx == -1 and rel_dy == 0: target_dir = 3 # West (LEFT)\n                \n                # If the primitive is at a cardinal direction from the agent, turn to face it\n                if target_dir != -1 and current_dir != target_dir:\n                    # Calculate the shortest turn (right or left)\n                    diff = (target_dir - current_dir + 4) % 4\n                    action_to_turn = None\n                    if diff == 1: # Target is one step right\n                        action_to_turn = ACTION_RIGHT\n                    elif diff == 2: # Target is two steps (e.g., behind), choose right\n                        action_to_turn = ACTION_RIGHT\n                    elif diff == 3: # Target is one step left\n                        action_to_turn = ACTION_LEFT\n                    \n                    if action_to_turn is not None:\n                        _, _, _ = env.step(action_to_turn)\n                        actions_taken.append(action_to_turn)\n                        # After turning, re-evaluate the state in the next loop iteration\n                        continue # Skip to the next iteration to re-check\n                \n                # If agent is now facing the primitive (or was already facing it), USE it.\n                # This also covers the case where the primitive was in a diagonal cell.\n                # The agent should have moved closer in step 4 and then will be caught by this logic.\n                if target_dir != -1 and current_dir == target_dir: # Only USE if facing a cardinal primitive\n                    _, _, _ = env.step(ACTION_USE)\n                    actions_taken.append(ACTION_USE)\n                    if env._current_state.inventory[primitive] > 0:\n                        return actions_taken\n            \n        # 4. If primitive is not directly collectable from current position,\n        # find its closest instance on the grid and move towards it.\n        primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n        \n        if len(primitive_locations) == 0:\n            # Primitive not found anywhere on the grid. Cannot collect.\n            return actions_taken\n\n        # Find the closest primitive location using Manhattan distance\n        min_dist = float('inf')\n        target_coords = None\n        for px, py in primitive_locations:\n            dist = abs(px - current_pos[0]) + abs(py - current_pos[1])\n            if dist < min_dist:\n                min_dist = dist\n                target_coords = (px, py)\n        \n        # If for some reason no target_coords were found (should not happen if locations exist)\n        if not target_coords:\n            break \n\n        # Determine the next movement action to reduce distance to target_coords\n        move_action = None\n        dx = target_coords[0] - current_pos[0]\n        dy = target_coords[1] - current_pos[1]\n\n        # Prioritize movement along the dimension with the larger difference\n        if dx != 0:\n            move_action = ACTION_RIGHT if dx > 0 else ACTION_LEFT\n        elif dy != 0: # Only if dx is 0, then move in y direction\n            move_action = ACTION_DOWN if dy > 0 else ACTION_UP\n        \n        # If dx=0 and dy=0, agent is at the target_coords. This scenario should have been\n        # handled by step 2 (primitive underfoot) or step 3 (primitive adjacent/collectable).\n        # If we reach here with no determined move_action, it means we are stuck or cannot progress.\n        if move_action is None: \n            break # Exit loop, indicating failure to collect\n\n        # Take the determined movement action\n        _, _, _ = env.step(move_action)\n        actions_taken.append(move_action)\n        # The loop will re-evaluate the new state in the next iteration\n\n    # If the loop completes (e.g., MAX_TOTAL_STEPS reached) without collecting the primitive,\n    # return the actions taken so far, indicating failure to collect within limits.\n    return actions_taken", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:40:29.061504", "function_name": "collect", "function_body": "  ACTIONS = env.action_specs()\n  UP = ACTIONS['UP']\n  DOWN = ACTIONS['DOWN']\n  LEFT = ACTIONS['LEFT']\n  RIGHT = ACTIONS['RIGHT']\n  USE = ACTIONS['USE']\n\n  initial_state = env._current_state\n  initial_pos = initial_state.pos\n  grid = initial_state.grid\n  height, width, _ = grid.shape\n\n  # Map movement deltas to actions\n  move_actions = {\n      (-1, 0): UP,    # North\n      (1, 0): DOWN,   # South\n      (0, -1): LEFT,  # West\n      (0, 1): RIGHT,  # East\n  }\n  \n  # Find all locations of the primitive on the grid\n  primitive_locations = []\n  for r_grid in range(height):\n    for c_grid in range(width):\n      if grid[r_grid, c_grid, primitive] == 1:\n        primitive_locations.append((r_grid, c_grid))\n\n  if not primitive_locations:\n    # Primitive not found on the grid\n    return []\n\n  # BFS to find the shortest path to an adjacent traversable cell\n  q = [(initial_pos, [])]  # (current_position, path_taken_as_positions)\n  visited = {initial_pos}\n\n  best_path_to_adjacent = None\n  \n  while q:\n    curr_pos, path_pos = q.pop(0)\n\n    # Check if current position is adjacent to any primitive location\n    for target_r, target_c in primitive_locations:\n      if abs(curr_pos[0] - target_r) + abs(curr_pos[1] - target_c) == 1:\n        # Found a path to an adjacent cell!\n        best_path_to_adjacent = path_pos\n        break  # Exit inner loop for primitive_locations\n    if best_path_to_adjacent:\n      break  # Exit outer loop for BFS\n\n    # Explore neighbors\n    for dr, dc in move_actions.keys():\n      next_pos = (curr_pos[0] + dr, curr_pos[1] + dc)\n\n      # Check bounds\n      if not (0 <= next_pos[0] < height and 0 <= next_pos[1] < width):\n        continue\n\n      if next_pos in visited:\n        continue\n\n      # Check traversability: A cell is an obstacle if it contains any non-grabbable item.\n      # Primitive sources (like 'stone' or 'wood') are typically non-grabbable and act as obstacles\n      # for movement (you need to be adjacent to \"use\" them).\n      is_obstacle = False\n      for k_idx in range(grid.shape[2]): # Iterate through all kinds in the cell\n          if grid[next_pos[0], next_pos[1], k_idx] == 1:\n              if k_idx in env.world.non_grabbable_indices:\n                  is_obstacle = True\n                  break\n      \n      if is_obstacle:\n        continue # Cannot move into an obstacle cell\n\n      visited.add(next_pos)\n      q.append((next_pos, path_pos + [next_pos]))\n\n  if not best_path_to_adjacent:\n    # No path found to any cell adjacent to the primitive\n    return []\n\n  # Convert the position path into a sequence of actions\n  actions_to_take = []\n  current_sim_pos = initial_pos\n\n  for next_pos_in_path in best_path_to_adjacent:\n    dr = next_pos_in_path[0] - current_sim_pos[0]\n    dc = next_pos_in_path[1] - current_sim_pos[1]\n\n    action_val = move_actions.get((dr, dc))\n    if action_val is None:\n      # This should not happen if BFS generated a valid cardinal path\n      return [] \n\n    actions_to_take.append(action_val)\n    current_sim_pos = next_pos_in_path\n\n  # After moving to an adjacent cell, perform the USE action to collect the primitive.\n  # Assuming USE works on any adjacent primitive regardless of facing direction,\n  # or that the agent's direction is implicitly aligned by the last movement action\n  # for the purpose of interaction.\n  actions_to_take.append(USE)\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:42:02.378722", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Action constants (assuming these are defined globally or accessible)\n  # DOWN = 0\n  # UP = 1\n  # LEFT = 2\n  # RIGHT = 3\n  # USE = 4\n\n  # (dr, dc) for (DOWN, UP, LEFT, RIGHT)\n  _ACTION_DELTAS = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1)    # RIGHT\n  }\n\n  actions = []\n  current_state = env._current_state\n\n  # 1. Check if the primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n  start_pos = current_state.pos\n  non_grabbable_indices_set = current_state.world.non_grabbable_indices\n\n  # 2. Find all locations of the primitive on the grid\n  primitive_locations = []\n  for r in range(WIDTH):\n    for c in range(HEIGHT):\n      if grid[r, c, primitive] > 0:\n        primitive_locations.append((r, c))\n\n  if not primitive_locations:\n    # Primitive not found on the grid, cannot collect\n    return []\n\n  # 3. Pathfinding (BFS) to the closest primitive location\n  # BFS state: (current_position_tuple, path_taken_so_far_list)\n  q = deque([(start_pos, [])])\n  visited = {start_pos}\n\n  target_path = None\n\n  while q:\n    (r, c), path = q.popleft()\n\n    # If current position contains the primitive, we found a path to it.\n    if (r, c) in primitive_locations:\n      target_path = path\n      break\n\n    # Explore neighbors\n    for action_val, (dr, dc) in _ACTION_DELTAS.items():\n      nr, nc = r + dr, c + dc\n\n      # Check boundaries\n      if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n        continue\n\n      # Check if the cell is traversable\n      # A cell is traversable if it does not contain any non-grabbable item.\n      # We assume that the `primitive` itself is always grabbable and thus not\n      # in `non_grabbable_indices_set`.\n      is_traversable = True\n      for kind_idx in non_grabbable_indices_set:\n        if grid[nr, nc, kind_idx] > 0: # If this kind_idx is present in the cell\n          is_traversable = False\n          break\n      \n      if not is_traversable:\n        continue # Skip this neighbor, it's blocked\n\n      if (nr, nc) not in visited:\n        visited.add((nr, nc))\n        q.append(((nr, nc), path + [action_val]))\n\n  if target_path is None:\n    # No path found to any primitive location\n    return []\n\n  # Add movement actions\n  actions.extend(target_path)\n  # Add USE action after reaching the primitive's location.\n  # Assuming USE (which is 4) is a globally defined constant.\n  actions.append(4) # Assuming USE action is 4\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:42:03.336530", "function_name": "collect", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:43:56.849327", "function_name": "collect", "function_body": "  import collections\n\n  # Get action mappings from the environment's action_specs\n  ACTION_DOWN = env.action_specs()['DOWN']\n  ACTION_UP = env.action_specs()['UP']\n  ACTION_LEFT = env.action_specs()['LEFT']\n  ACTION_RIGHT = env.action_specs()['RIGHT']\n  ACTION_USE = env.action_specs()['USE']\n\n  # Store action mappings in a dictionary for easier lookup in BFS\n  action_map = {\n      'DOWN': ACTION_DOWN, 'UP': ACTION_UP,\n      'LEFT': ACTION_LEFT, 'RIGHT': ACTION_RIGHT, 'USE': ACTION_USE\n  }\n\n  # Get initial state information\n  initial_state = env._current_state\n  initial_x, initial_y = initial_state.pos\n  initial_dir = initial_state.init_dir  # Agent's facing direction at start\n\n  # Check if the primitive is even collectable\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get grid dimensions and find all locations of the primitive\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n  primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  if not primitive_locations:\n    return []  # Primitive not found on the initial grid\n\n  # --- BFS to find the shortest sequence of actions ---\n  # State in BFS: (current_x, current_y, current_direction_int)\n  # Queue item: (current_x, current_y, current_dir, list_of_actions_taken)\n  q = collections.deque([(initial_x, initial_y, initial_dir, [])])\n  # Visited set: (x, y, dir) to avoid redundant exploration and loops\n  visited = set([(initial_x, initial_y, initial_dir)])\n\n  # Internal direction constants (match CraftState.dir: 0:N, 1:E, 2:S, 3:W)\n  NORTH, EAST, SOUTH, WEST = 0, 1, 2, 3\n\n  # Define movement actions and their effects on (x,y)\n  # Agent's direction (cdir) does NOT change on movement actions in CraftState\n  movement_actions = [\n      (0, -1, ACTION_UP),    # North: (dx, dy, action)\n      (0, 1, ACTION_DOWN),   # South\n      (-1, 0, ACTION_LEFT),  # West\n      (1, 0, ACTION_RIGHT)   # East\n  ]\n\n  # Define rotation actions and their effects on direction\n  # CraftState.step logic: LEFT (action_map['LEFT']) = (dir + 3) % 4 (anticlockwise)\n  #                      RIGHT (action_map['RIGHT']) = (dir + 1) % 4 (clockwise)\n  rotation_actions = [\n      (action_map['LEFT'], (lambda d: (d + 3) % 4)),  # (action, dir_transform_func)\n      (action_map['RIGHT'], (lambda d: (d + 1) % 4))\n  ]\n\n  # Maximum number of steps to search to prevent extremely long paths or infinite loops\n  MAX_SEARCH_STEPS = 500\n\n  while q and len(q[0][3]) < MAX_SEARCH_STEPS:\n    cx, cy, cdir, path_so_far = q.popleft()\n\n    # --- Check if current state is a goal state (adjacent and facing primitive) ---\n    is_adjacent_and_facing = False\n    target_primitive_x, target_primitive_y = -1, -1\n\n    for px, py in primitive_locations:\n      # Check if (cx,cy) is adjacent to (px,py)\n      if abs(cx - px) + abs(cy - py) == 1:\n        # Determine the required direction to face (px,py) from (cx,cy)\n        dx_to_prim = px - cx\n        dy_to_prim = py - cy\n\n        required_dir = -1\n        if dx_to_prim == 1 and dy_to_prim == 0:  # Primitive is East of agent\n          required_dir = EAST\n        elif dx_to_prim == -1 and dy_to_prim == 0:  # Primitive is West of agent\n          required_dir = WEST\n        elif dx_to_prim == 0 and dy_to_prim == 1:  # Primitive is South of agent\n          required_dir = SOUTH\n        elif dx_to_prim == 0 and dy_to_prim == -1:  # Primitive is North of agent\n          required_dir = NORTH\n\n        if required_dir == cdir:\n          # Found a state where agent is adjacent and correctly facing a primitive\n          is_adjacent_and_facing = True\n          target_primitive_x, target_primitive_y = px, py\n          break\n    \n    if is_adjacent_and_facing:\n      # If we are in a goal state, add the USE action and return the full path\n      return path_so_far + [ACTION_USE]\n\n    # --- Explore neighbors (Movement Actions) ---\n    for dx, dy, action_val in movement_actions:\n      nx, ny = cx + dx, cy + dy\n      n_dir = cdir  # Direction does not change with movement actions\n\n      # Check bounds\n      if 0 <= nx < grid_width and 0 <= ny < grid_height:\n        # For v2, we assume all cells are traversable unless they are the primitive itself or explicit obstacles.\n        # Since we're trying to move *to* an adjacent cell, we don't want to step *on* the primitive.\n        # But for pathfinding to *any* cell, we consider it traversable.\n        # This simplification assumes no impassable terrain other than grid boundaries.\n        if (nx, ny, n_dir) not in visited:\n          visited.add((nx, ny, n_dir))\n          q.append((nx, ny, n_dir, path_so_far + [action_val]))\n\n    # --- Explore neighbors (Rotation Actions) ---\n    for rot_action_val, dir_transform_func in rotation_actions:\n      n_dir = dir_transform_func(cdir)\n      # Position (cx, cy) remains unchanged for rotation actions\n      if (cx, cy, n_dir) not in visited:\n        visited.add((cx, cy, n_dir))\n        q.append((cx, cy, n_dir, path_so_far + [rot_action_val]))\n\n  # If the queue is exhausted or max search steps reached without finding a path\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:43:56.918893", "function_name": "collect", "function_body": "# Assume collections and numpy are available in the environment scope.\n# E.g., `import collections` and `import numpy as np` are assumed to be\n# present in the overall script, not required within this function body.\n\n    action_map = env.action_specs()\n    UP, DOWN, LEFT, RIGHT, USE = (\n        action_map['UP'],\n        action_map['DOWN'],\n        action_map['LEFT'],\n        action_map['RIGHT'],\n        action_map['USE']\n    )\n\n    # Define movement deltas for each action\n    MOVE_DELTAS = {\n        UP: (0, -1),\n        DOWN: (0, 1),\n        LEFT: (-1, 0),\n        RIGHT: (1, 0)\n    }\n    ALL_MOVE_ACTIONS = [UP, DOWN, LEFT, RIGHT]\n\n    # Get initial state information\n    initial_obs = env.reset()\n    initial_grid = initial_obs['features_dict']['features_global'].copy()\n    initial_pos = tuple(initial_obs['features_dict']['pos'])\n    initial_dir = np.argmax(initial_obs['features_dict']['direction'])\n    initial_inventory = initial_obs['features_dict']['inventory']\n\n    # If the primitive is already in inventory, no actions are needed\n    if initial_inventory[primitive] > 0:\n        return []\n\n    # Get world properties for obstacle checking\n    non_grabbable_indices = env.world.non_grabbable_indices\n    grid_height, grid_width, _ = initial_grid.shape\n\n    # BFS setup\n    queue = collections.deque()\n    visited = set()\n\n    # Queue stores: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_this_state)\n    queue.append(((initial_pos, initial_dir), []))\n    visited.add((initial_pos, initial_dir))\n\n    while queue:\n        (current_pos, current_dir), path_so_far = queue.popleft()\n        px, py = current_pos\n\n        # Check if the primitive is in the 3x3 neighborhood (including current cell)\n        found_adjacent_primitive = False\n        for r in range(max(0, py - 1), min(grid_height, py + 2)):\n            for c in range(max(0, px - 1), min(grid_width, px + 2)):\n                if initial_grid[r, c, primitive] == 1:\n                    found_adjacent_primitive = True\n                    break\n            if found_adjacent_primitive:\n                break\n\n        # If primitive is adjacent, we can use it and return the path\n        if found_adjacent_primitive:\n            path_so_far.append(USE)\n            return path_so_far\n\n        # Explore possible movements\n        for action in ALL_MOVE_ACTIONS:\n            dx, dy = MOVE_DELTAS[action]\n            new_px, new_py = px + dx, py + dy\n            new_pos = (new_px, new_py)\n            new_dir = current_dir # Movement actions don't change facing direction\n\n            # Check boundaries\n            if not (0 <= new_px < grid_width and 0 <= new_py < grid_height):\n                continue\n\n            # Check for obstacles (non-grabbable items)\n            is_obstacle = False\n            for kind_idx in non_grabbable_indices:\n                if initial_grid[new_py, new_px, kind_idx] == 1:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n\n            new_state_tuple = (new_pos, new_dir)\n            if new_state_tuple not in visited:\n                visited.add(new_state_tuple)\n                queue.append((new_state_tuple, path_so_far + [action]))\n\n    # If no path is found\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:45:15.405672", "function_name": "collect", "function_body": "    actions = []\n    \n    # Access the current state of the environment\n    # CraftLab internally holds a CraftState instance\n    current_state = env._current_state\n\n    # Get the grid and the agent's current position\n    grid = current_state.grid\n    agent_pos = current_state.pos\n\n    # Find all locations on the grid where the primitive exists\n    # np.where returns a tuple of arrays (row_indices, col_indices)\n    primitive_locations = np.where(grid[:, :, primitive] > 0)\n\n    # If the primitive is not found anywhere on the grid, return an empty list\n    if len(primitive_locations[0]) == 0:\n        return []\n\n    # Choose the first instance of the primitive found (e.g., top-leftmost)\n    target_r, target_c = primitive_locations[0][0], primitive_locations[1][0]\n\n    # Calculate the difference in row and column coordinates\n    dr = target_r - agent_pos[0]\n    dc = target_c - agent_pos[1]\n\n    # Generate actions for vertical movement\n    # Assuming UP, DOWN, LEFT, RIGHT, USE are accessible from env_factory\n    # DOWN maps to 0, UP to 1, LEFT to 2, RIGHT to 3, USE to 4 as per action_specs\n    for _ in range(abs(dr)):\n        if dr > 0: # Target is below current position\n            actions.append(env_factory.DOWN)\n        else: # Target is above current position\n            actions.append(env_factory.UP)\n    \n    # Generate actions for horizontal movement\n    for _ in range(abs(dc)):\n        if dc > 0: # Target is to the right of current position\n            actions.append(env_factory.RIGHT)\n        else: # Target is to the left of current position\n            actions.append(env_factory.LEFT)\n            \n    # Once the agent has moved to the primitive's location (or next to it),\n    # use the 'USE' action to collect it.\n    actions.append(env_factory.USE)\n    \n    return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:45:16.352391", "function_name": "collect", "function_body": "  total_actions = []\n  max_total_steps = 500  # Safety limit to prevent infinite loops\n\n  # Get relevant info from the environment's world configuration\n  world = env.world\n  cookbook = world.cookbook\n  \n  # Determine if the primitive is a 'grabbable' item (walk over to pick up)\n  # or a 'use' item (interact from an adjacent square, e.g., stone, water).\n  is_grabbable_target = primitive in world.grabbable_indices\n  is_water = primitive == world.water_index\n  is_stone = primitive == world.stone_index\n  # A primitive requires 'USE' action if it's in the cookbook's primitives set\n  # AND it's not considered grabbable by just walking over it.\n  is_use_target = (primitive in cookbook.primitives and not is_grabbable_target) or is_water or is_stone\n\n  # Helper function to determine if a cell is an obstacle for movement\n  def is_obstacle(grid, x, y):\n      width, height, _ = grid.shape\n      \n      # Out of bounds is always an obstacle\n      if not (0 <= x < width and 0 <= y < height):\n          return True\n\n      # A cell is an obstacle if it contains any non-grabbable item.\n      # This means agent cannot move onto this cell.\n      for k_idx in world.non_grabbable_indices:\n          if grid[x, y, k_idx] > 0:\n              return True # This cell contains a non-traversable item.\n      return False\n\n  # BFS to find the shortest path to the target primitive or an adjacent cell.\n  def find_path_bfs(initial_obs, target_kind, is_grabbable, is_use):\n      current_grid = initial_obs['features_global']\n      start_pos = tuple(initial_obs['pos'])\n      \n      q = collections.deque([(start_pos, [])]) # (current_position, path_actions_to_reach_here)\n      visited = {start_pos}\n\n      grid_width, grid_height, _ = current_grid.shape\n\n      while q:\n          (cx, cy), path = q.popleft()\n\n          # Check if current position satisfies the goal condition\n          if is_grabbable and current_grid[cx, cy, target_kind] > 0:\n              # For grabbable items, reaching their cell means the goal is met.\n              return path \n          \n          if is_use:\n              # For 'USE' items, we need to be adjacent to the target.\n              # Check the 4 direct neighbors of the current cell (cx, cy).\n              for dx_adj, dy_adj in ACTION_TO_DELT.values():\n                  nx_adj, ny_adj = cx + dx_adj, cy + dy_adj\n                  if 0 <= nx_adj < grid_width and 0 <= ny_adj < grid_height:\n                      if current_grid[nx_adj, ny_adj, target_kind] > 0:\n                          # Found a 'USE' target adjacent to (cx,cy). The path to (cx,cy) is sufficient.\n                          return path \n          \n          # Explore traversable neighbors for further movement\n          for action_move_idx in MOVE_ACTIONS:\n              dx_move, dy_move = ACTION_TO_DELT[action_move_idx]\n              nx_move, ny_move = cx + dx_move, cy + dy_move\n              n_pos = (nx_move, ny_move)\n\n              if (0 <= nx_move < grid_width and 0 <= ny_move < grid_height and\n                  n_pos not in visited and not is_obstacle(current_grid, nx_move, ny_move)):\n                  \n                  visited.add(n_pos)\n                  q.append((n_pos, path + [action_move_idx]))\n      \n      return None # No path found to the target or an adjacent cell\n\n  # Initialize environment and get initial observations\n  obs = env.reset() \n  steps_taken = 0\n  \n  while steps_taken < max_total_steps:\n      # 1. Check if the primitive is already in inventory\n      if obs['inventory'][primitive] > 0:\n          return total_actions\n\n      # 2. Find a path to the primitive (or an adjacent cell if it's a 'USE' target)\n      path_to_primitive = find_path_bfs(obs, primitive, is_grabbable_target, is_use_target)\n\n      if path_to_primitive is None:\n          # If no path is found, it means the primitive is unreachable or not present.\n          # Return the actions taken so far.\n          return total_actions\n\n      # 3. Execute the found path\n      for action_move in path_to_primitive:\n          if steps_taken >= max_total_steps:\n              break # Stop if max steps reached during path execution\n          \n          _, _, obs = env.step(action_move)\n          total_actions.append(action_move)\n          steps_taken += 1\n          \n          # Check inventory after each move, in case a grabbable item was picked up by walking over it.\n          if obs['inventory'][primitive] > 0:\n              return total_actions\n\n      # 4. If target requires 'USE' action, perform it after reaching the target vicinity\n      if is_use_target:\n          if steps_taken < max_total_steps:\n              _, _, obs = env.step(ACTION_USE)\n              total_actions.append(ACTION_USE)\n              steps_taken += 1\n              if obs['inventory'][primitive] > 0:\n                  return total_actions\n      \n      # If we reach here, a path was executed and possibly USE was attempted,\n      # but the item wasn't collected. The loop will continue to try and find it again,\n      # which is useful if the environment changes or if the previous attempt failed.\n  \n  # If max_total_steps is reached and the primitive is not collected\n  return total_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:46:32.506872", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      ACTION_UP: DIR_NORTH,\n      ACTION_DOWN: DIR_SOUTH,\n      ACTION_LEFT: DIR_WEST,\n      ACTION_RIGHT: DIR_EAST\n  }\n\n  # Mapping of target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction to collect that target via ACTION_USE.\n  # This focuses on cardinal directions, as ACTION_USE typically applies to what's directly in front.\n  RELATIVE_TO_REQUIRED_DIR = {\n      (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n      (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n      (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n      (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_cell_in_front(pos, direction):\n      y, x = pos\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return None # Should not happen with valid directions\n\n  # Breadth-First Search (BFS) to find a path to the primitive, ensuring the agent\n  # ends up at a position AND orientation suitable for collection.\n  # `initial_grid` is used to represent the static map layout for traversability during pathfinding.\n  def _find_path_and_orientation_for_collection(start_pos, start_dir, initial_grid, primitive_id, world):\n      grid_height, grid_width, _ = initial_grid.shape\n      impassable_kinds = world.non_grabbable_indices\n\n      # BFS state: (current_y, current_x, current_dir, path_of_actions)\n      q = collections.deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n      moves_options = [\n          (-1, 0, ACTION_UP, DIR_NORTH),\n          (1, 0, ACTION_DOWN, DIR_SOUTH),\n          (0, -1, ACTION_LEFT, DIR_WEST),\n          (0, 1, ACTION_RIGHT, DIR_EAST)\n      ]\n\n      while q:\n          curr_y, curr_x, curr_dir, path_actions = q.popleft()\n          \n          # Pruning: If path is already too long, skip this branch.\n          # This saves computation by not exploring paths that can't lead to a solution within MAX_COLLECT_STEPS.\n          # We reserve at least one step for the final ACTION_USE.\n          if len(path_actions) >= MAX_COLLECT_STEPS - 1:\n              continue\n\n          # Check if the primitive is cardinally adjacent to the current cell AND agent is facing it\n          for rel_dy, rel_dx in RELATIVE_TO_REQUIRED_DIR.keys(): # Iterate through cardinal relative positions\n              adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n              # Check bounds and if the adjacent cell contains the primitive based on the initial_grid\n              if (0 <= adj_y < grid_height and 0 <= adj_x < grid_width and\n                      initial_grid[adj_y, adj_x, primitive_id] > 0):\n                  \n                  # Primitive found at (adj_y, adj_x).\n                  # Now, check if the agent's current direction matches the direction required to collect it.\n                  required_dir_for_collection = RELATIVE_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n                  if curr_dir == required_dir_for_collection:\n                      # Found a path that leads to a position AND ensures the agent is oriented correctly.\n                      return (path_actions, (rel_dy, rel_dx))\n\n          # Explore neighboring cells\n          for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n              # Check bounds\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if the next cell is traversable for movement (i.e., does not contain any impassable kinds).\n              # This check uses the initial_grid, assuming static obstacles.\n              is_traversable_for_movement = True\n              for k_idx in impassable_kinds:\n                  if initial_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable_for_movement = False\n                      break\n              if not is_traversable_for_movement:\n                  continue\n              \n              # Add to queue only if this new state (position and direction) hasn't been visited\n              if (next_y, next_x, new_dir_after_move) not in visited:\n                  visited.add((next_y, next_x, new_dir_after_move))\n                  q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n      return (None, None) # No path found to the primitive with correct orientation\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state\n  current_obs = env.reset() \n  current_state = env._current_state # Access the underlying CraftState instance\n\n  # Initial checks\n  if primitive not in current_state.world.cookbook.kinds:\n      return [] # The specified primitive ID is not recognized\n  if current_state.inventory[primitive] > 0:\n      return [] # The primitive has already been collected\n\n  # Get the initial grid for pathfinding (assuming static obstacles during movement)\n  initial_grid = current_state.features_dict()['features_global'] \n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  # Find the sequence of movements that leads to the agent being correctly positioned and oriented\n  path_of_moves, relative_target_coords = _find_path_and_orientation_for_collection(\n      start_pos, start_dir, initial_grid, primitive, current_state.world\n  )\n\n  if path_of_moves is None:\n      return [] # No path found that leads to the primitive with correct orientation\n\n  # Execute the found path of movements\n  for action in path_of_moves:\n      # This check ensures we don't exceed MAX_COLLECT_STEPS even if BFS returned a valid but long path.\n      # (Though the BFS pruning above should ideally prevent this if MAX_COLLECT_STEPS is honored).\n      if len(actions_taken) + 1 >= MAX_COLLECT_STEPS: \n          return [] # Prevent excessively long action sequences\n      actions_taken.append(action)\n      _, _, _ = env.step(action) # Take the step, update state (reward, done, obs are ignored for this func)\n      current_state = env._current_state # Always update the internal state after a step\n\n  # After executing all movement actions, the agent should be at the correct position\n  # and facing the correct direction as determined by the BFS. Now, perform the USE action.\n  \n  # V2 Improvement: Re-query the current grid from the updated state before checking reachability.\n  # This makes the check robust to any (unlikely for primitives) changes on the map during movement.\n  current_grid_after_moves = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = current_grid_after_moves.shape # Get grid dimensions from current grid for bounds\n\n  is_primitive_reachable_by_use = False\n  target_cell_y, target_cell_x = _get_cell_in_front(current_state.pos, current_state.dir)\n  \n  # Check if the cell directly in front contains the primitive, using the CURRENT grid state\n  if target_cell_y is not None and\\\n     0 <= target_cell_y < grid_height and 0 <= target_cell_x < grid_width: # Check bounds\n      if current_grid_after_moves[target_cell_y, target_cell_x, primitive] > 0:\n          is_primitive_reachable_by_use = True\n\n  if is_primitive_reachable_by_use:\n      # If the primitive is reachable, append and execute the ACTION_USE\n      if len(actions_taken) < MAX_COLLECT_STEPS: # Ensure there's still capacity for the USE action\n          actions_taken.append(ACTION_USE)\n          _, _, _ = env.step(ACTION_USE)\n          current_state = env._current_state # Update state after USE\n\n          # Final check: Confirm the primitive was successfully collected into inventory\n          if current_state.inventory[primitive] > 0:\n              return actions_taken # Successfully collected!\n          else:\n              # Collection failed even after reaching and attempting USE (e.g., requires specific tool,\n              # resource depleted, environmental constraint not modeled by simple traversability, etc.)\n              return [] \n      else:\n          # Max steps reached, no space left for the final USE action\n          return [] \n  else:\n      # This case indicates a discrepancy: BFS found a path, but the primitive is not\n      # in the expected location (directly in front) after executing the path. This could happen\n      # if the environment state is not static or if there's a logic mismatch.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:46:33.483451", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      ACTION_UP: DIR_NORTH,\n      ACTION_DOWN: DIR_SOUTH,\n      ACTION_LEFT: DIR_WEST,\n      ACTION_RIGHT: DIR_EAST\n  }\n\n  # Mapping of a target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction to collect that target via ACTION_USE.\n  # For example, if target is (0, 1) (East), agent must face DIR_EAST.\n  RELATIVE_TARGET_TO_REQUIRED_DIR = {\n      (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n      (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n      (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n      (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state\n  current_obs = env.reset() \n  current_state = env._current_state # Access the underlying CraftState instance\n\n  # Initial checks\n  if primitive not in current_state.world.cookbook.kinds:\n      return [] # The specified primitive ID is not recognized\n  if current_state.inventory[primitive] > 0:\n      return [] # The primitive has already been collected\n\n  full_grid = current_state.features_dict()['features_global']\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  grid_height, grid_width, _ = full_grid.shape # Get grid dimensions for validation\n\n  # --- Pre-compute all potential target (agent_y, agent_x, agent_dir) states ---\n  # These are the (agent_y, agent_x, agent_dir) states from which an agent\n  # can perform ACTION_USE to collect the primitive located adjacent to it.\n  collectable_target_states = set()\n  \n  # Iterate over the grid to find all instances of the primitive\n  for py in range(grid_height):\n      for px in range(grid_width):\n          if full_grid[py, px, primitive] > 0:\n              # For each primitive found at (py, px), determine the 4 possible\n              # adjacent agent positions and the required agent direction to collect it.\n              for rel_dy, rel_dx in RELATIVE_TARGET_TO_REQUIRED_DIR.keys():\n                  # Calculate potential agent position (agent_y, agent_x)\n                  # If primitive is at (py, px) and its relative pos to agent is (rel_dy, rel_dx),\n                  # then agent's absolute pos (ay, ax) is (py - rel_dy, px - rel_dx).\n                  agent_y, agent_x = py - rel_dy, px - rel_dx\n                  required_agent_dir = RELATIVE_TARGET_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n                  # Check if this potential agent position is within grid bounds\n                  if 0 <= agent_y < grid_height and 0 <= agent_x < grid_width:\n                      # Add this valid target state (agent_pos, agent_dir) to our set\n                      collectable_target_states.add((agent_y, agent_x, required_agent_dir))\n  \n  if not collectable_target_states:\n      # No instances of the primitive found on the grid, or no valid collection points.\n      return [] \n\n  # --- Breadth-First Search (BFS) to find the shortest path to any target state ---\n  q = collections.deque()\n  # BFS state: (current_y, current_x, current_dir, path_of_actions)\n  q.append((start_pos[0], start_pos[1], start_dir, []))\n  \n  # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n  moves_options = [\n      (-1, 0, ACTION_UP, DIR_NORTH),\n      (1, 0, ACTION_DOWN, DIR_SOUTH),\n      (0, -1, ACTION_LEFT, DIR_WEST),\n      (0, 1, ACTION_RIGHT, DIR_EAST)\n  ]\n\n  path_to_primitive_collection = None\n\n  while q:\n      curr_y, curr_x, curr_dir, path_actions = q.popleft()\n      \n      # Check if current state (position and orientation) is one of our\n      # pre-computed collectable target states.\n      if (curr_y, curr_x, curr_dir) in collectable_target_states:\n          path_to_primitive_collection = path_actions\n          break # Found the shortest path to a valid collection point, exit BFS\n\n      # Explore neighboring cells\n      for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n          next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n          # Check bounds for the next cell\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the next cell is traversable for movement.\n          # Impassable kinds are defined in the world's non_grabbable_indices.\n          is_traversable_for_movement = True\n          impassable_kinds = current_state.world.non_grabbable_indices\n          for k_idx in impassable_kinds:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable_for_movement = False\n                  break\n          if not is_traversable_for_movement:\n              continue\n          \n          # Add to queue only if this new state (position and direction) hasn't been visited\n          if (next_y, next_x, new_dir_after_move) not in visited:\n              visited.add((next_y, next_x, new_dir_after_move))\n              q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n  \n  if path_to_primitive_collection is None:\n      return [] # No path found to any collectable primitive target state\n\n  # --- Execute the found path and perform the collection ---\n  \n  # Ensure the total number of actions (path + final USE) does not exceed MAX_COLLECT_STEPS\n  if len(path_to_primitive_collection) + 1 > MAX_COLLECT_STEPS:\n      return [] # Path is too long\n\n  # Execute the movements found by BFS\n  for action in path_to_primitive_collection:\n      actions_taken.append(action)\n      _, _, _ = env.step(action) # Take the step, update env's internal state\n      current_state = env._current_state # Update our reference to the current CraftState\n\n  # After executing all movement actions, the agent should be at the correct position\n  # and facing the correct direction as determined by the BFS. Now, perform the USE action.\n  actions_taken.append(ACTION_USE)\n  _, _, _ = env.step(ACTION_USE)\n  current_state = env._current_state # Update state after the USE action\n\n  # Final check: Confirm the primitive was successfully collected into inventory\n  if current_state.inventory[primitive] > 0:\n      return actions_taken # Successfully collected!\n  else:\n      # Collection failed even after reaching the correct position/orientation and attempting USE.\n      # This could happen if the primitive requires a tool, is depleted, or other unseen game mechanics.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:47:55.239865", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      ACTION_UP: DIR_NORTH,\n      ACTION_DOWN: DIR_SOUTH,\n      ACTION_LEFT: DIR_WEST,\n      ACTION_RIGHT: DIR_EAST\n  }\n\n  # Mapping of target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction to collect that target via ACTION_USE.\n  # This focuses on cardinal directions, as ACTION_USE typically applies to what's directly in front.\n  RELATIVE_TO_REQUIRED_DIR = {\n      (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n      (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n      (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n      (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_cell_in_front(pos, direction):\n      y, x = pos\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return None # Should not happen with valid directions\n\n  # Breadth-First Search (BFS) to find a path to the primitive, ensuring the agent\n  # ends up at a position AND orientation suitable for collection.\n  def _find_path_and_orientation_for_collection(start_pos, start_dir, full_grid, primitive_id, world, max_steps):\n      grid_height, grid_width, _ = full_grid.shape\n      impassable_kinds = world.non_grabbable_indices\n      # A primitive is \"traversable\" if it's not in the set of impassable kinds.\n      # Agent can stand on a traversable primitive to collect it.\n      primitive_is_traversable = primitive_id not in impassable_kinds\n\n      # V2 Improvement 1: Immediate collection check for efficiency.\n      # If the agent starts directly on a traversable primitive, no path finding is needed.\n      if primitive_is_traversable and full_grid[start_pos[0], start_pos[1], primitive_id] > 0:\n          return ([], (0, 0)) # Agent is on the primitive, no moves needed, relative target (0,0)\n\n      # BFS state: (current_y, current_x, current_dir, path_of_actions)\n      q = collections.deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n      # These moves are cardinal and also determine the new facing direction.\n      moves_options = [\n          (-1, 0, ACTION_UP, DIR_NORTH),\n          (1, 0, ACTION_DOWN, DIR_SOUTH),\n          (0, -1, ACTION_LEFT, DIR_WEST),\n          (0, 1, ACTION_RIGHT, DIR_EAST)\n      ]\n\n      while q:\n          curr_y, curr_x, curr_dir, path_actions = q.popleft()\n          \n          # Check for path length limit (reserving at least 1 step for ACTION_USE)\n          if len(path_actions) >= max_steps - 1:\n              continue # Skip expanding paths that are already too long\n\n          # --- Goal Check 1: Primitive is on the current cell and agent can pick it up directly ---\n          # This check is still necessary within the BFS for exploring other possible direct collection points\n          # beyond the start_pos, if the initial check didn't apply.\n          if primitive_is_traversable and full_grid[curr_y, curr_x, primitive_id] > 0:\n              # If agent can move onto the primitive and it's present, this is a direct collection point.\n              # Relative coordinates (0,0) indicates target is at agent's current position.\n              return (path_actions, (0, 0)) \n\n          # --- Goal Check 2: Primitive is cardinally adjacent AND agent is facing it correctly ---\n          for rel_dy, rel_dx in RELATIVE_TO_REQUIRED_DIR.keys(): \n              adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n              # Check bounds for the adjacent cell\n              if not (0 <= adj_y < grid_height and 0 <= adj_x < grid_width):\n                  continue\n\n              # Check if the adjacent cell contains the primitive\n              if full_grid[adj_y, adj_x, primitive_id] > 0:\n                  # Primitive found at (adj_y, adj_x). Now, verify agent's orientation.\n                  required_dir_for_collection = RELATIVE_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n                  if curr_dir == required_dir_for_collection:\n                      # Found a path that leads to a position AND ensures the agent is oriented correctly.\n                      return (path_actions, (rel_dy, rel_dx))\n\n          # --- Explore neighboring cells for movement ---\n          for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n              # Check bounds for the next movement cell\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if the next cell is traversable (i.e., does not contain any impassable kinds)\n              is_traversable_for_movement = True\n              for k_idx in impassable_kinds:\n                  if full_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable_for_movement = False\n                      break\n              if not is_traversable_for_movement:\n                  continue\n              \n              # Add to queue only if this new state (position and direction) hasn't been visited\n              if (next_y, next_x, new_dir_after_move) not in visited:\n                  visited.add((next_y, next_x, new_dir_after_move))\n                  q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n      return (None, None) # No path found to the primitive with correct orientation\n\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state for planning.\n  # This ensures the planning starts from a consistent base.\n  current_obs = env.reset() \n  current_state = env._current_state # Access the underlying CraftState instance\n\n  # Initial checks for early exit\n  if primitive not in current_state.world.cookbook.kinds:\n      # The specified primitive ID is not a recognized kind in the world.\n      return [] \n  if current_state.inventory[primitive] > 0:\n      # The primitive has already been collected or is present in inventory.\n      return [] \n\n  full_grid = current_state.features_dict()['features_global']\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  \n  # Find the sequence of movements and the relative target coordinates for collection.\n  path_of_moves, relative_target_coords = _find_path_and_orientation_for_collection(\n      start_pos, start_dir, full_grid, primitive, current_state.world, MAX_COLLECT_STEPS\n  )\n\n  if path_of_moves is None:\n      # No valid path was found to reach a position/orientation suitable for collection.\n      return [] \n\n  # Execute the found path of movements\n  for action in path_of_moves:\n      actions_taken.append(action)\n      # Step the environment with the current action.\n      # We ignore reward and done status as this function's goal is just to return the action sequence.\n      _, _, _ = env.step(action) \n      current_state = env._current_state # Always update the internal state after a step\n\n  # V2 Improvement 2: Simplified final USE action logic.\n  # After executing all movement actions, the agent should be at the correct position\n  # and facing the correct direction as determined by the BFS.\n  # Since CraftWorld's grid is static (items don't move unless collected), if the BFS\n  # found the primitive, it should still be present at the target location.\n  # The critical final check is whether the ACTION_USE successfully adds to inventory.\n  if len(actions_taken) < MAX_COLLECT_STEPS: # Ensure there's still capacity for the USE action\n      actions_taken.append(ACTION_USE)\n      _, _, _ = env.step(ACTION_USE)\n      current_state = env._current_state # Update state after USE\n\n      # Final verification: Confirm the primitive was successfully collected into inventory.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken # Successfully collected!\n  \n  # If path was too long to include USE, or USE failed (inventory not updated)\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:47:56.224405", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      ACTION_UP: DIR_NORTH,\n      ACTION_DOWN: DIR_SOUTH,\n      ACTION_LEFT: DIR_WEST,\n      ACTION_RIGHT: DIR_EAST\n  }\n\n  # Mapping of target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction to collect that target via ACTION_USE.\n  # This focuses on cardinal directions, as ACTION_USE typically applies to what's directly in front.\n  RELATIVE_TO_REQUIRED_DIR = {\n      (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n      (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n      (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n      (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_cell_in_front(pos, direction):\n      y, x = pos\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return None # Should not happen with valid directions\n\n  # Breadth-First Search (BFS) to find a path to the primitive, ensuring the agent\n  # ends up at a position AND orientation suitable for collection.\n  def _find_path_and_orientation_for_collection(start_pos, start_dir, initial_full_grid, primitive_id, world, max_steps):\n      # Renamed 'full_grid' to 'initial_full_grid' to clarify it's a snapshot for planning.\n      grid_height, grid_width, _ = initial_full_grid.shape\n      impassable_kinds = world.non_grabbable_indices\n      # A primitive is \"traversable\" if it's not in the set of impassable kinds.\n      # Agent can stand on a traversable primitive to collect it.\n      primitive_is_traversable = primitive_id not in impassable_kinds\n\n      # BFS state: (current_y, current_x, current_dir, path_of_actions)\n      q = collections.deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n      # These moves are cardinal and also determine the new facing direction.\n      moves_options = [\n          (-1, 0, ACTION_UP, DIR_NORTH),\n          (1, 0, ACTION_DOWN, DIR_SOUTH),\n          (0, -1, ACTION_LEFT, DIR_WEST),\n          (0, 1, ACTION_RIGHT, DIR_EAST)\n      ]\n\n      while q:\n          curr_y, curr_x, curr_dir, path_actions = q.popleft()\n          \n          # Check for path length limit (reserving at least 1 step for ACTION_USE)\n          if len(path_actions) >= max_steps - 1:\n              continue # Skip expanding paths that are already too long\n\n          # --- Goal Check 1: Primitive is on the current cell and agent can pick it up directly ---\n          if primitive_is_traversable and initial_full_grid[curr_y, curr_x, primitive_id] > 0:\n              # If agent can move onto the primitive and it's present, this is a direct collection point.\n              # Relative coordinates (0,0) indicates target is at agent's current position.\n              return (path_actions, (0, 0)) \n\n          # --- Goal Check 2: Primitive is cardinally adjacent AND agent is facing it correctly ---\n          for rel_dy, rel_dx in RELATIVE_TO_REQUIRED_DIR.keys(): \n              adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n              # Check bounds for the adjacent cell\n              if not (0 <= adj_y < grid_height and 0 <= adj_x < grid_width):\n                  continue\n\n              # Check if the adjacent cell contains the primitive using the initial grid for planning\n              if initial_full_grid[adj_y, adj_x, primitive_id] > 0:\n                  # Primitive found at (adj_y, adj_x). Now, verify agent's orientation.\n                  required_dir_for_collection = RELATIVE_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n                  if curr_dir == required_dir_for_collection:\n                      # Found a path that leads to a position AND ensures the agent is oriented correctly.\n                      return (path_actions, (rel_dy, rel_dx))\n\n          # --- Explore neighboring cells for movement ---\n          for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n              # Check bounds for the next movement cell\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if the next cell is traversable (i.e., does not contain any impassable kinds)\n              # This check also uses the initial grid for planning.\n              is_traversable_for_movement = True\n              for k_idx in impassable_kinds:\n                  if initial_full_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable_for_movement = False\n                      break\n              if not is_traversable_for_movement:\n                  continue\n              \n              # Add to queue only if this new state (position and direction) hasn't been visited\n              if (next_y, next_x, new_dir_after_move) not in visited:\n                  visited.add((next_y, next_x, new_dir_after_move))\n                  q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n      return (None, None) # No path found to the primitive with correct orientation\n\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state for planning.\n  # This ensures the planning starts from a consistent base.\n  current_obs = env.reset() \n  current_state = env._current_state # Access the underlying CraftState instance\n\n  # Initial checks for early exit\n  if primitive not in current_state.world.cookbook.kinds:\n      # The specified primitive ID is not a recognized kind in the world.\n      return [] \n  if current_state.inventory[primitive] > 0:\n      # The primitive has already been collected or is present in inventory.\n      return [] \n\n  # Capture the initial grid for path planning. This snapshot is used for BFS.\n  initial_full_grid = current_state.features_dict()['features_global']\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  \n  # Find the sequence of movements and the relative target coordinates for collection.\n  path_of_moves, relative_target_coords = _find_path_and_orientation_for_collection(\n      start_pos, start_dir, initial_full_grid, primitive, current_state.world, MAX_COLLECT_STEPS\n  )\n\n  if path_of_moves is None:\n      # No valid path was found to reach a position/orientation suitable for collection.\n      return [] \n\n  # Execute the found path of movements\n  for action in path_of_moves:\n      actions_taken.append(action)\n      # Step the environment with the current action.\n      # We ignore reward and done status as this function's goal is just to return the action sequence.\n      _, _, _ = env.step(action) \n      current_state = env._current_state # Always update the internal state after a step\n\n  # --- Start of Improvement for v2 ---\n  # After executing all movement actions, the agent should be at the correct position\n  # and facing the correct direction as determined by the BFS. Now, perform the USE action.\n  \n  # Before attempting USE, verify the primitive is still at the expected location using the\n  # *current* grid state, not the initial one. This makes it more robust to dynamic environments\n  # (e.g., if the item was consumed or moved by another agent, though less common for CraftWorld primitives).\n  current_grid = current_state.features_dict()['features_global'] # Get the actual current grid\n  grid_height, grid_width, _ = current_grid.shape # Use current_grid dimensions\n\n  is_primitive_reachable_by_use = False\n\n  if relative_target_coords == (0,0):\n      # Target is on the current cell (agent is standing on it)\n      if (0 <= current_state.pos[0] < grid_height and\n          0 <= current_state.pos[1] < grid_width and\n          current_grid[current_state.pos[0], current_state.pos[1], primitive] > 0): # Check CURRENT grid\n          is_primitive_reachable_by_use = True\n  else:\n      # Target is adjacent to the current cell, in the direction agent is facing.\n      target_cell_y, target_cell_x = _get_cell_in_front(current_state.pos, current_state.dir)\n      if (target_cell_y is not None and\n          0 <= target_cell_y < grid_height and 0 <= target_cell_x < grid_width and\n          current_grid[target_cell_y, target_cell_x, primitive] > 0): # Check CURRENT grid\n          is_primitive_reachable_by_use = True\n  # --- End of Improvement for v2 ---\n\n  if is_primitive_reachable_by_use:\n      # If the primitive is still present and reachable, append and execute the ACTION_USE.\n      if len(actions_taken) < MAX_COLLECT_STEPS: # Ensure there's still capacity for the USE action\n          actions_taken.append(ACTION_USE)\n          _, _, _ = env.step(ACTION_USE)\n          current_state = env._current_state # Update state after USE\n\n          # Final verification: Confirm the primitive was successfully collected into inventory.\n          if current_state.inventory[primitive] > 0:\n              return actions_taken # Successfully collected!\n          else:\n              # Collection failed even after reaching and attempting USE.\n              # This might happen if specific tools are needed, or the resource depleted, etc.\n              return [] \n      else:\n          # Max steps reached, no space left for the final USE action.\n          return [] \n  else:\n      # Discrepancy: BFS found a path, but primitive is not in the expected location for collection\n      # after executing the path (according to the current grid). This indicates a stale plan or\n      # dynamic environment changes not accounted for in the initial static grid planning.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:49:21.766506", "function_name": "collect", "function_body": "  import collections\n  \n  # Define constants locally for this function for clarity and self-containment.\n  # These map action integers to their conceptual meaning.\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n  \n  # Maximum number of actions to attempt collection. This prevents infinite loops\n  # in very large or complex scenarios where a path might not be found or is too long.\n  MAX_COLLECT_STEPS = 100 \n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"Returns the coordinates of the cell directly in front of (y,x) based on direction.\n      Direction mapping: 0=Up, 1=Right, 2=Down, 3=Left.\n      \"\"\"\n      if direction == 0: return y - 1, x # UP\n      if direction == 1: return y, x + 1 # RIGHT\n      if direction == 2: return y + 1, x # DOWN\n      if direction == 3: return y, x - 1 # LEFT\n      return y, x # Should not be reached for valid movement directions\n\n  # Assume the environment is already reset and in a valid state by the caller.\n  # This function operates on the current state of the environment.\n  current_state = env._current_state \n\n  # Pre-checks: If the primitive is unknown or already in inventory, no action is needed.\n  if primitive not in current_state.world.cookbook.kinds:\n      # The primitive ID is not recognized within the world's known kinds.\n      return [] \n\n  if current_state.inventory[primitive] > 0:\n      # The agent already possesses the primitive, so no collection is needed.\n      return []\n\n  # Extract necessary information from the current state for pathfinding.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir \n\n  # Identify entity kinds that block movement (impassable terrain/objects).\n  impassable_kinds = current_state.world.non_grabbable_indices\n\n  # Define valid movement actions and their effects on position and direction.\n  # Format: (action_constant: (resulting_direction, dy, dx))\n  movement_actions_map = {\n      ACTION_UP:    (0, -1, 0), # Move North, face North\n      ACTION_RIGHT: (1, 0, 1),  # Move East, face East\n      ACTION_DOWN:  (2, 1, 0),  # Move South, face South\n      ACTION_LEFT:  (3, 0, -1)  # Move West, face West\n  }\n\n  q = collections.deque()\n  # BFS queue elements: (current_y, current_x, current_direction, path_of_actions_so_far)\n  q.append((start_y, start_x, start_dir, []))\n  \n  # visited set: Stores (y, x, direction) tuples to avoid re-exploring states\n  # and prevent infinite loops in pathfinding.\n  visited = {(start_y, start_x, start_dir)} \n\n  path_to_use = None # Will store the final sequence of actions, including ACTION_USE.\n\n  # --- BFS to find the shortest path to a position where the primitive can be collected ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Optimization: If the current path is already too long, prune this branch.\n      # This respects the MAX_COLLECT_STEPS limit during path search itself.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # Determine the coordinates of the cell the agent is currently facing.\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Check if the facing coordinates are within grid boundaries.\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width):\n          # If the cell in front contains the primitive, we've found a target state.\n          if full_grid[facing_y, facing_x, primitive] > 0:\n              path_to_use = path + [ACTION_USE] # Append the final 'USE' action.\n              break # Path found, exit the BFS loop.\n\n      # Explore all possible next states by applying movement actions.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Check if the next agent position is within the grid.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the next cell is traversable (does not contain impassable objects).\n          is_traversable = True\n          for k_idx in impassable_kinds:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n          \n          # Check if this new (position, direction) state has already been visited.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # If valid and unvisited, add to visited set and queue for exploration.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n  \n  # --- Execute the found path (if any) and monitor collection status ---\n  actions_executed = [] # Stores the actual actions performed by the agent.\n  if path_to_use is None:\n      return [] # No path was found to collect the primitive.\n\n  for action in path_to_use:\n      # Stop executing if the total number of steps exceeds the limit,\n      # or if the agent already collected the primitive (redundant but safe).\n      if len(actions_executed) >= MAX_COLLECT_STEPS:\n          break \n      if current_state.inventory[primitive] > 0: # Check after each step\n          break\n\n      actions_executed.append(action)\n      # Apply the action to the environment. We are interested in the resulting state.\n      _, _, _ = env.step(action) \n      # Update the reference to the environment's current state.\n      current_state = env._current_state \n\n  # Final check: If the primitive is now in the inventory, return the executed actions.\n  if current_state.inventory[primitive] > 0:\n      return actions_executed\n  else:\n      # If collection was not successful after executing the path (e.g., hit step limit\n      # or an unexpected environmental change), return an empty list.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:49:22.754927", "function_name": "collect", "function_body": "  import collections\n  \n  # Assuming these constants are globally defined or imported from `env_factory`\n  # For completeness and local testing, they might look like this:\n  # ACTION_DOWN = 0\n  # ACTION_UP = 1\n  # ACTION_LEFT = 2\n  # ACTION_RIGHT = 3\n  # ACTION_USE = 4\n  # MAX_COLLECT_STEPS = 100 # A reasonable default if not provided\n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"Returns the coordinates of the cell directly in front of (y,x) based on direction.\"\"\"\n      if direction == 0: return y - 1, x # UP\n      if direction == 1: return y, x + 1 # RIGHT\n      if direction == 2: return y + 1, x # DOWN\n      if direction == 3: return y, x - 1 # LEFT\n      return y, x # Should not be reached for valid movement directions\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state and access its internal CraftState.\n  # This ensures we start from a clean, known state for pathfinding.\n  env.reset() \n  current_state = env._current_state \n\n  # Ensure the primitive is a valid kind known to the world\n  if primitive not in current_state.world.cookbook.kinds:\n      return [] \n\n  # Check if the primitive is already in the inventory. If so, no actions needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir # Use the agent's current direction from the reset state\n\n  # Convert set to list once for efficient numpy indexing, checking for emptiness\n  impassable_kinds_list = list(current_state.world.non_grabbable_indices)\n\n  # Define movement actions and their resulting directions and (dy, dx) changes.\n  # Direction mapping: 0=Up, 1=Right, 2=Down, 3=Left\n  movement_actions_map = {\n      ACTION_UP:    (0, -1, 0), # (resulting_direction, dy, dx)\n      ACTION_RIGHT: (1, 0, 1),\n      ACTION_DOWN:  (2, 1, 0),\n      ACTION_LEFT:  (3, 0, -1)\n  }\n\n  q = collections.deque()\n  # BFS state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  q.append((start_y, start_x, start_dir, []))\n  # Visited set tracks (position, direction) to avoid redundant exploration and loops.\n  visited = {(start_y, start_x, start_dir)} \n\n  path_to_use = None # Will store the sequence of actions including the final USE action\n\n  # --- BFS to find a path to a position and orientation suitable for collection ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Optimization: Prune paths that are already too long before even exploring further.\n      # This helps to keep the search efficient within the MAX_COLLECT_STEPS budget.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # Check if the primitive is directly in front of the agent at current (y,x,dir)\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Ensure facing coordinates are within bounds\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width):\n          # Check if the cell directly in front contains the primitive\n          if full_grid[facing_y, facing_x, primitive] > 0:\n              # We found a path to a position and orientation where ACTION_USE should work.\n              path_to_use = path + [ACTION_USE]\n              break # Path found, exit BFS\n\n      # Explore neighbors by applying movement actions\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Check bounds for the next agent position\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the next cell is traversable (does not contain any impassable kind)\n          # IMPROVEMENT: Use numpy.any for potentially faster check if impassable_kinds is large.\n          # Ensure impassable_kinds_list is not empty to avoid errors with empty indexing.\n          if impassable_kinds_list and np.any(full_grid[next_y, next_x, impassable_kinds_list] > 0):\n              continue\n          \n          # Check if this (position, direction) state has been visited\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n  \n  # --- Execute the found path (if any) ---\n  if path_to_use is None:\n      return [] # No path found to directly collect the primitive\n\n  # Execute actions step by step, respecting MAX_COLLECT_STEPS\n  for action in path_to_use:\n      if len(actions_taken) >= MAX_COLLECT_STEPS:\n          # Stop if the total number of actions taken reaches the limit\n          break \n\n      actions_taken.append(action)\n      # Step the environment and update the internal state\n      _, _, _ = env.step(action) # Reward and done status are not used for pathfinding logic here\n      current_state = env._current_state # Update state after the step\n\n      # If the primitive is now in the inventory, we have successfully collected it.\n      # Return the sequence of actions taken so far.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n  \n  # If the loop completes without collecting the primitive (e.g., MAX_COLLECT_STEPS was hit\n  # or the path ultimately failed for other reasons), return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T19:50:53.301785", "function_name": "collect", "function_body": "    # Action constants (assuming these are standard and available/defined within scope)\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    # Mapping from action ID to (delta_row, delta_col) for movement actions\n    _ACTION_TO_DRDC = {\n        _UP: (-1, 0),\n        _DOWN: (1, 0),\n        _LEFT: (0, -1),\n        _RIGHT: (0, 1),\n    }\n\n    # Get current observations from the environment\n    obs = env.observations()\n    current_inventory = obs['features_dict']['inventory']\n\n    # 1. Check if the primitive is already collected in the inventory\n    if current_inventory[primitive] > 0:\n        return []  # Already collected, no actions needed\n\n    # Get the global grid state and dimensions\n    grid = obs['features_dict']['features_global']\n    height, width, _ = grid.shape\n\n    # Get the agent's current position.\n    # The 'pos' in features_dict is normalized (row_norm, col_norm).\n    # We round to the nearest integer and cast to int to get grid coordinates.\n    current_r = int(round(obs['features_dict']['pos'][0] * height))\n    current_c = int(round(obs['features_dict']['pos'][1] * width))\n    start_pos = (current_r, current_c)\n\n    # Use a Breadth-First Search (BFS) to find the shortest path to the primitive.\n    # The queue stores tuples: (current_position_tuple, list_of_actions_taken_to_reach_here)\n    q = collections.deque([(start_pos, [])])\n    # The 'visited' set keeps track of positions already explored to avoid cycles and redundant paths\n    visited = {start_pos}\n\n    while q:\n        (r, c), path = q.popleft()\n\n        # Check if the current cell (r, c) contains the desired primitive\n        if grid[r, c, primitive] == 1:\n            # If the agent is on the primitive's location, the next action is to USE it.\n            # This assumes that 'USE' on a primitive's square collects it.\n            return path + [_USE]\n\n        # Explore all four cardinal neighbors (UP, DOWN, LEFT, RIGHT)\n        for action_id, (dr, dc) in _ACTION_TO_DRDC.items():\n            nr, nc = r + dr, c + dc  # Calculate new row and column\n\n            # Check for boundary conditions: ensure the new position is within grid limits\n            if not (0 <= nr < height and 0 <= nc < width):\n                continue  # Skip if out of bounds\n\n            # Check if this neighbor position has already been visited\n            if (nr, nc) in visited:\n                continue  # Skip if already visited\n\n            # Mark the new position as visited and add it to the queue with the updated path\n            visited.add((nr, nc))\n            q.append(((nr, nc), path + [action_id]))\n\n    # If the BFS completes and the primitive is not found or is unreachable,\n    # return an empty list of actions.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T19:50:53.372369", "function_name": "collect", "function_body": "    # Action constants\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Movement deltas (dx, dy) for each action\n    # These assume actions move in cardinal directions relative to the grid.\n    MOVE_DELTAS = {\n        ACTION_DOWN: (0, 1),  # Move down (increase Y)\n        ACTION_UP: (0, -1),  # Move up (decrease Y)\n        ACTION_LEFT: (-1, 0), # Move left (decrease X)\n        ACTION_RIGHT: (1, 0)  # Move right (increase X)\n    }\n\n    # Get the current state of the environment from the CraftLab instance.\n    # `env` is a CraftLab instance, and `_current_state` holds the CraftState.\n    current_state = env._current_state\n\n    # Extract initial grid, agent's position, and grid dimensions.\n    grid = current_state.grid\n    start_pos = current_state.pos\n    grid_width, grid_height, _ = grid.shape\n\n    # 1. Check if the primitive is already in the agent's inventory.\n    # If it is, no actions are needed.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # 2. Locate all positions on the grid where the primitive exists.\n    primitive_locations = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            # If the cell (x, y) contains the specified primitive.\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    # If the primitive is not found anywhere on the grid, it cannot be collected.\n    if not primitive_locations:\n        return []\n\n    # 3. Perform a Breadth-First Search (BFS) to find the shortest path\n    #    from the agent's starting position to any cell containing the primitive.\n\n    # BFS queue: stores tuples of (current_position, list_of_actions_taken_to_reach_here)\n    # `collections.deque` is used for efficient queue operations. Assumes `collections` is available.\n    q = collections.deque([(start_pos, [])])\n\n    # Visited set: stores positions (x, y) to avoid cycles and re-exploring paths.\n    visited = {start_pos}\n\n    path_to_primitive_cell = None\n\n    while q:\n        (cx, cy), actions_so_far = q.popleft()\n\n        # If the current position is one of the primitive locations, we've found a path.\n        if (cx, cy) in primitive_locations:\n            path_to_primitive_cell = actions_so_far\n            break # Exit BFS as the shortest path is found\n\n        # Explore possible moves (UP, DOWN, LEFT, RIGHT) from the current position.\n        for action, (dx, dy) in MOVE_DELTAS.items():\n            nx, ny = cx + dx, cy + dy\n            new_pos = (nx, ny)\n\n            # Check if the new position is within the grid boundaries.\n            if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n                continue\n\n            # Check if the new position has already been visited in this search.\n            if new_pos in visited:\n                continue\n\n            # Check if the new position contains an obstacle (non-grabbable item).\n            # We assume non-grabbable items (like water, stone if configured as such)\n            # are also untraversable.\n            is_obstacle = False\n            # `env.world` is the CraftWorld instance, which has `non_grabbable_indices`.\n            for obstacle_idx in env.world.non_grabbable_indices:\n                if grid[nx, ny, obstacle_idx] > 0: # If the cell contains an obstacle\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue # Cannot move to an obstacle cell\n\n            # If the new position is valid and traversable, add it to the queue.\n            visited.add(new_pos)\n            q.append((new_pos, actions_so_far + [action]))\n\n    # If the BFS completed without finding a path to any primitive location.\n    if path_to_primitive_cell is None:\n        return []\n\n    # 4. Once a path to a primitive cell is found, append the USE action.\n    # The `USE` action is described as operating on the 3x3 neighborhood around the agent.\n    # If the agent is standing on the primitive, the primitive is within this 3x3 area,\n    # so `USE` should successfully collect it.\n    final_actions = list(path_to_primitive_cell) # Create a copy of the path\n    final_actions.append(ACTION_USE)\n\n    return final_actions", "island_id": 8, "scores": {"3": -1}}
