{"timestamp": "2025-07-30T17:02:13.486881", "function_name": "collect", "function_body": "  import collections # Required for deque\n\n  # Define action constants (internal to the function scope)\n  # These map to the integer actions expected by CraftLab.step\n  UP = 0\n  RIGHT = 1\n  DOWN = 2\n  LEFT = 3\n  USE = 4\n\n  # Map directions (0:N, 1:E, 2:S, 3:W) to (dx, dy) deltas\n  # (dx, dy) means (change in x, change in y)\n  DIR_DELTAS = {\n      0: (0, -1),  # North (y decreases)\n      1: (1, 0),   # East (x increases)\n      2: (0, 1),   # South (y increases)\n      3: (-1, 0)   # West (x decreases)\n  }\n\n  # Map movement actions to their (dx, dy) effect and the new direction the agent faces\n  ACTION_EFFECTS = {\n      UP:    ((0, -1), 0),  # Move Up, face North\n      RIGHT: ((1,  0), 1),  # Move Right, face East\n      DOWN:  ((0,  1), 2),  # Move Down, face South\n      LEFT:  ((-1, 0), 3),  # Move Left, face West\n  }\n\n  current_state = env._current_state\n  current_grid = current_state.grid\n  current_pos = current_state.pos # (x, y) tuple\n  current_dir = current_state.dir # integer (0,1,2,3)\n  inventory = current_state.inventory\n  width, height, n_kinds = current_grid.shape\n\n  # 1. Check if primitive is already collected\n  if inventory[primitive] > 0:\n      return []\n\n  # Helper function to check if a position is valid and within bounds\n  def is_valid_pos(x, y):\n      return 0 <= x < width and 0 <= y < height\n\n  # 2. BFS to find path to a position where primitive can be USED\n  # A state in BFS is (x, y, direction)\n  # The queue stores (current_x, current_y, current_dir, list_of_actions_taken_to_reach_this_state)\n  queue = collections.deque([(current_pos[0], current_pos[1], current_dir, [])])\n  # Visited set to avoid cycles: (x, y, dir)\n  visited = set([(current_pos[0], current_pos[1], current_dir)])\n\n  # Get non-grabbable indices for pathing obstacles from the CraftWorld instance\n  # The `env` (CraftLab) holds a `world` attribute, which is a `CraftWorld` instance.\n  obstacles_indices = env.world.non_grabbable_indices\n\n  while queue:\n      cx, cy, c_dir, path_actions = queue.popleft()\n\n      # Check if we are currently at a state where we can USE the primitive\n      # Determine the cell directly in front of the agent based on current_dir\n      front_dx, front_dy = DIR_DELTAS[c_dir]\n      target_x, target_y = cx + front_dx, cy + front_dy\n\n      if is_valid_pos(target_x, target_y) and current_grid[target_x, target_y, primitive] > 0:\n          # We are at (cx, cy), facing (target_x, target_y) which contains the primitive.\n          # We can USE it now.\n          return path_actions + [USE]\n\n      # Explore possible next states (move actions)\n      # Iterate through UP, RIGHT, DOWN, LEFT actions\n      for action_val in [UP, RIGHT, DOWN, LEFT]:\n          move_delta, new_dir_after_move = ACTION_EFFECTS[action_val]\n          next_x, next_y = cx + move_delta[0], cy + move_delta[1]\n\n          if is_valid_pos(next_x, next_y):\n              # Check if the cell (next_x, next_y) is traversable.\n              # It's traversable if it's not occupied by a non-grabbable item\n              # AND it's not the primitive itself (as we need to be adjacent, not on it).\n              blocked = False\n              # Check for general obstacles (non-grabbable items)\n              for kind_idx in obstacles_indices:\n                  if current_grid[next_x, next_y, kind_idx] > 0:\n                      blocked = True\n                      break\n              # An agent cannot move onto a cell containing the primitive it wants to collect.\n              # It must be adjacent to it and use it.\n              if current_grid[next_x, next_y, primitive] > 0:\n                  blocked = True\n\n              if not blocked:\n                  if (next_x, next_y, new_dir_after_move) not in visited:\n                      visited.add((next_x, next_y, new_dir_after_move))\n                      queue.append((next_x, next_y, new_dir_after_move, path_actions + [action_val]))\n\n  # If BFS completes without finding a path to USE the primitive\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:03:36.785403", "function_name": "collect", "function_body": "  actions = []\n  MAX_STEPS = 250  # Increased max steps for a more thorough search\n\n  # Get action mappings once to avoid repeated lookups\n  action_map = env.action_specs()\n  A_DOWN = action_map['DOWN']\n  A_UP = action_map['UP']\n  A_LEFT = action_map['LEFT']\n  A_RIGHT = action_map['RIGHT']\n  A_USE = action_map['USE']\n\n  # Define a sequence of movement directions to cycle through for systematic exploration\n  cardinal_moves = [A_UP, A_RIGHT, A_DOWN, A_LEFT]\n  current_cardinal_idx = 0\n\n  # Initialize the environment and get initial observations\n  obs = env.reset()\n  prev_pos = obs['features_dict']['pos']  # Agent's previous position to detect if a move was blocked\n\n  # State for directional movement strategy\n  steps_in_current_direction = 0\n  max_straight_steps = 15  # Max steps to move in one direction before considering a turn\n\n  for _ in range(MAX_STEPS):\n    # Check current inventory for the primitive\n    inventory = obs['features_dict']['inventory']\n    if inventory[primitive] > 0:\n      return actions  # Goal achieved: primitive collected\n\n    current_state = env._current_state  # Access the underlying CraftState for spatial checks\n\n    # Strategy 1: If the primitive is in the agent's 3x3 neighborhood (including current cell)\n    if current_state.next_to(primitive):\n      # Try to USE. If it doesn't work directly, try turning and USE, up to 4 times (a full circle).\n      # This ensures the agent tries to face the primitive if it's adjacent.\n      use_attempts = 0\n      while use_attempts < 4:\n        r, done, obs = env.step(A_USE)\n        actions.append(A_USE)\n\n        # Re-check inventory immediately after attempting USE\n        inventory = obs['features_dict']['inventory']\n        if inventory[primitive] > 0:\n          return actions  # Goal achieved\n\n        # If USE didn't work, turn clockwise (A_RIGHT) to try facing a different adjacent cell\n        r, done, obs = env.step(A_RIGHT)\n        actions.append(A_RIGHT)\n        use_attempts += 1\n\n        if done:  # If the environment indicates the episode is done (e.g., max_steps reached by CraftLab)\n          return actions\n\n    # Strategy 2: If primitive is not adjacent or USE attempts failed, explore the environment\n    else:\n      # Get the current proposed movement action from the cardinal sequence\n      move_action = cardinal_moves[current_cardinal_idx]\n\n      # Execute the move action\n      r, done, obs = env.step(move_action)\n      actions.append(move_action)\n\n      new_pos = obs['features_dict']['pos']\n\n      if done:  # If the environment indicates the episode is done\n        return actions\n\n      # Check if the agent hit a wall or didn't move (position remains same)\n      if np.array_equal(new_pos, prev_pos):\n        # Agent is blocked, change direction for the next movement attempt\n        current_cardinal_idx = (current_cardinal_idx + 1) % 4\n        steps_in_current_direction = 0  # Reset counter as we're changing direction\n      else:\n        # Agent moved successfully\n        prev_pos = new_pos  # Update previous position\n        steps_in_current_direction += 1\n\n        # If agent has moved straight for a set number of steps, turn to cover new areas\n        if steps_in_current_direction >= max_straight_steps:\n          current_cardinal_idx = (current_cardinal_idx + 1) % 4\n          steps_in_current_direction = 0  # Reset counter\n\n  # If loop finishes without collecting the primitive (max_steps reached in this function)\n  return actions", "island_id": 7, "scores": {"3": -1}}
