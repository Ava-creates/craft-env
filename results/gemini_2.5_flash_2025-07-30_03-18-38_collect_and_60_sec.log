{"timestamp": "2025-07-30T19:19:18.706643", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  actions_map = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = actions_map['DOWN'], actions_map['UP'], actions_map['LEFT'], actions_map['RIGHT'], actions_map['USE']\n\n  current_state = env._current_state\n  \n  # 1. Check if the primitive is already in the inventory\n  if current_state.inventory[primitive] > 0:\n    return [] # Already collected\n\n  # 2. Check if the primitive is a grabbable item\n  # This version of collect only handles direct collection of items that can be picked up.\n  # Crafting or interacting with non-grabbable environment items (like workshops or water) is beyond its scope.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # 3. Locate all instances of the primitive on the grid\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive] > 0:\n        primitive_locations.append((x, y))\n\n  if not primitive_locations:\n    return [] # Primitive not found anywhere on the grid\n\n  start_pos = current_state.pos\n\n  # BFS to find the shortest path to any cell containing the primitive\n  q = collections.deque([(start_pos, [])]) # (current_position, list_of_actions_to_reach_here)\n  visited = {start_pos} # Set of visited (x, y) coordinates\n\n  # Define possible movements and their corresponding actions\n  # (dx, dy) -> action_id\n  # Assuming (0,0) is top-left, X increases right, Y increases down\n  moves_dir_map = {\n      (0, -1): UP,    # Move North (upwards on the grid)\n      (0, 1): DOWN,   # Move South (downwards on the grid)\n      (-1, 0): LEFT,  # Move West\n      (1, 0): RIGHT   # Move East\n  }\n  \n  # Helper function to determine if a cell is an obstacle\n  def is_obstacle(x, y):\n    # Check if out of bounds\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return True\n    \n    # Check for specific non-grabbable environment entities that block movement\n    # Water is typically an impassable terrain feature\n    if grid[x, y, env.world.water_index] > 0:\n      return True\n    \n    # Workshops are generally not traversable (cannot move onto them)\n    for workshop_idx in env.world.workshop_indices:\n      if grid[x, y, workshop_idx] > 0:\n        return True\n    \n    # Check for any other non-grabbable entities that might be obstacles.\n    # The target primitive itself is grabbable and thus not an obstacle.\n    for non_grabbable_idx in env.world.non_grabbable_indices:\n      # Skip water and workshops as they are already checked explicitly for clarity\n      if non_grabbable_idx == env.world.water_index or non_grabbable_idx in env.world.workshop_indices:\n        continue\n      \n      if grid[x, y, non_grabbable_idx] > 0:\n        return True # Contains another non-grabbable item, so it's an obstacle\n        \n    return False # The cell is not an obstacle\n\n  best_collection_path = [] # Stores the actions for the shortest path\n\n  while q:\n    (cx, cy), current_actions = q.popleft()\n\n    # If the current position is one of the primitive's locations\n    if (cx, cy) in primitive_locations:\n      # Found the shortest path to stand on a primitive instance\n      best_collection_path = current_actions + [USE] # Add USE action to pick it up\n      break # Stop BFS, as shortest path is found\n\n    # Explore valid neighbors\n    for (dx, dy), action in moves_dir_map.items():\n      nx, ny = cx + dx, cy + dy\n\n      # If the neighbor is a primitive location, it is passable for the agent to move onto.\n      # Otherwise, check if it's an obstacle.\n      is_target_primitive_cell = (nx, ny) in primitive_locations\n      \n      if not is_target_primitive_cell and is_obstacle(nx, ny):\n        continue # Cannot move to an obstacle cell\n\n      if (nx, ny) not in visited:\n        visited.add((nx, ny))\n        q.append(((nx, ny), current_actions + [action]))\n  \n  return best_collection_path", "island_id": 2, "scores": {"3": -1}}
