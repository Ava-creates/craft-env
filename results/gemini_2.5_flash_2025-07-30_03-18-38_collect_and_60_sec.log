{"timestamp": "2025-07-30T13:29:05.978869", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants as defined by CraftLab.action_specs()\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    current_state = env._current_state\n    \n    # 1. Check if the primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    world = current_state.world\n    HEIGHT, WIDTH, _ = grid.shape # Grid shape is (rows, columns, n_kinds)\n\n    # Get non-grabbable indices to identify obstacles\n    non_grabbable_indices = world.non_grabbable_indices\n\n    # BFS state: (current_position_tuple, list_of_actions_to_reach_here)\n    queue = collections.deque([(current_state.pos, [])])\n    \n    # Visited set: (row, col) to avoid cycles and redundant exploration\n    visited = set([current_state.pos])\n\n    while queue:\n        (r, c), path = queue.popleft()\n\n        # Check if the primitive is in the 3x3 neighborhood around the current position (r, c)\n        # This includes the cell (r,c) itself, and its 8 immediate neighbors.\n        # This aligns with the behavior of CraftState.next_to and general collection mechanics.\n        for dr_check in [-1, 0, 1]:\n            for dc_check in [-1, 0, 1]:\n                nr_check, nc_check = r + dr_check, c + dc_check\n                \n                # Ensure the checked cell is within grid boundaries\n                if 0 <= nr_check < HEIGHT and 0 <= nc_check < WIDTH:\n                    # Check if the primitive is present at this location\n                    if grid[nr_check, nc_check, primitive] == 1:\n                        # Found the primitive in an adjacent (or current) cell,\n                        # so return the path to get here followed by a USE action.\n                        return path + [USE]\n        \n        # If the primitive is not in the immediate vicinity, explore possible moves\n        # Define action deltas for UP, DOWN, LEFT, RIGHT\n        action_deltas = {\n            UP: (-1, 0),\n            DOWN: (1, 0),\n            LEFT: (0, -1),\n            RIGHT: (0, 1),\n        }\n\n        for action, (dr, dc) in action_deltas.items():\n            nr, nc = r + dr, c + dc\n            new_pos = (nr, nc)\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n                continue\n\n            # Check if the new position is an obstacle (contains a non-grabbable item)\n            is_obstacle = False\n            # Iterate through all possible item kinds at the new position\n            for kind_idx in range(world.n_kinds):\n                if grid[nr, nc, kind_idx] == 1 and kind_idx in non_grabbable_indices:\n                    is_obstacle = True\n                    break # Found an obstacle, cannot move here\n            if is_obstacle:\n                continue\n\n            # If the new position is valid and not visited, add it to the queue\n            if new_pos not in visited:\n                visited.add(new_pos)\n                queue.append((new_pos, path + [action]))\n    \n    # If the BFS queue is exhausted and no path to the primitive was found,\n    # it means the primitive is unreachable or not present.\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:29:57.722965", "function_name": "collect", "function_body": "  import collections\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  # When the agent moves, its direction is set to the direction of movement.\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position).\n  # These define the change in coordinates when moving in a specific direction,\n  # and also represent the cell \"in front\" of the agent when facing that direction.\n  DIR_VEC = {\n      0: (0, -1), # UP: (dx, dy) = (0, -1)\n      1: (1, 0),  # RIGHT: (dx, dy) = (1, 0)\n      2: (0, 1),  # DOWN: (dx, dy) = (0, 1)\n      3: (-1, 0)  # LEFT: (dx, dy) = (-1, 0)\n  }\n\n  # Pre-check: If the primitive is not a grabbable item, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information directly from the environment's internal state.\n  # This provides the raw grid, agent's position, and direction.\n  current_state = env._current_state\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir # Agent's initial facing direction\n  grid = current_state.grid # The full allocentric grid layout\n  grid_width, grid_height, _ = grid.shape\n\n  # Retrieve indices for entities that block movement.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to determine if a given grid cell is within bounds and free of obstacles.\n  def is_walkable(x, y):\n    # Check grid boundaries\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell contains any non-grabbable obstacle that prevents movement.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1: # If this cell contains an obstacle\n        return False\n    return True\n\n  # Use Breadth-First Search (BFS) to find the shortest sequence of actions.\n  # A state in the BFS queue is defined by (x, y, direction, list_of_actions_taken).\n  # The agent's direction is crucial because the 'USE' action depends on what the agent is facing.\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Keep track of visited (x, y, direction) states to avoid redundant explorations and cycles.\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Goal Check: Can the primitive be collected from the current state?\n    # The 'USE' action applies to the cell directly in front of the agent.\n    faced_dx, faced_dy = DIR_VEC[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # If the cell in front is within bounds and contains the target primitive,\n    # we've found a path to collect it.\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Append the 'USE' action to the path and return the complete sequence.\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next states by trying all movement actions.\n    # Movement actions (UP, DOWN, LEFT, RIGHT) also set the agent's facing direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Determine the new position and direction after taking this action.\n      # The new direction is the direction of the movement itself.\n      move_dir = ACTION_TO_DIR[action]\n      move_dx, move_dy = DIR_VEC[move_dir]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = move_dir # Agent faces the direction it just moved.\n\n      # If the next cell is walkable and this new (position, direction) state\n      # has not been visited, add it to the queue for further exploration.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable (e.g., blocked by obstacles, or not on the map).\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T13:29:58.679247", "function_name": "collect", "function_body": "  import collections\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position).\n  # These define the change in coordinates when moving in a specific direction,\n  # and also represent the cell \"in front\" of the agent when facing that direction.\n  # dir 0: UP (decreases y)\n  # dir 1: RIGHT (increases x)\n  # dir 2: DOWN (increases y)\n  # dir 3: LEFT (decreases x)\n  DIR_VEC = {\n      0: (0, -1),\n      1: (1, 0),\n      2: (0, 1),\n      3: (-1, 0)\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information from the environment.\n  # We access `_current_state` directly for raw grid, position, and direction.\n  current_state = env._current_state\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = current_state.grid # The full allocentric grid layout\n  grid_width, grid_height, _ = grid.shape\n\n  # Helper function to check if a grid cell is within bounds and walkable.\n  # A cell is considered walkable if it's within the grid boundaries\n  # and does not contain any non-grabbable obstacle (e.g., walls, water).\n  non_grabbable_indices = env.world.non_grabbable_indices\n  def is_walkable(x, y):\n    # Check bounds\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check for obstacles (non-grabbable items that block movement)\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1: # If this cell contains an obstacle\n        return False\n    return True\n\n  # 2. Find all locations where the primitive exists on the grid. (Improved from collect_v1)\n  primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  if not primitive_locations:\n    # The primitive is not found anywhere on the grid\n    return []\n\n  # 3. Determine the closest primitive instance to the agent's current position.\n  # We use Manhattan distance as it's suitable for grid movement costs.\n  closest_primitive_pos = None\n  min_manhattan_dist = float('inf')\n\n  for px, py in primitive_locations:\n    dist = abs(px - start_x) + abs(py - start_y)\n    if dist < min_manhattan_dist:\n      min_manhattan_dist = dist\n      closest_primitive_pos = (px, py)\n  \n  # If closest_primitive_pos is still None, it implies primitive_locations was empty,\n  # which is already handled above.\n  target_px, target_py = closest_primitive_pos\n\n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path to a state\n  # where the agent is adjacent to the *closest* primitive and facing it,\n  # allowing for the 'USE' action.\n  # The state in our BFS queue is defined by (x, y, direction, actions_taken).\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # A set to keep track of visited states to prevent cycles and redundant explorations.\n  # A state is (x, y, direction).\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Goal Check: Is the agent in a position and facing a direction such that\n    # the target primitive is directly in front of it?\n    faced_x, faced_y = curr_x + DIR_VEC[curr_dir][0], curr_y + DIR_VEC[curr_dir][1]\n\n    if (faced_x, faced_y) == (target_px, target_py):\n      # We've found the shortest path to a position where 'USE' can collect the target.\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next states by applying movement actions.\n    # Movement actions (UP, DOWN, LEFT, RIGHT) also set the agent's facing direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new position and direction after taking this action.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # The agent faces the direction of movement after the move.\n\n      # If the next cell is walkable and this specific (position, direction) state\n      # has not been visited yet, add it to the queue for further exploration.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it means the closest primitive is unreachable (e.g., blocked by obstacles, or inaccessible).\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T13:30:49.869431", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Action constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map agent direction (0=N, 1=E, 2=S, 3=W) to (dx, dy) delta for the cell in front\n  DIRECTION_TO_DELTA = {\n      0: (0, -1),  # North (UP)\n      1: (1, 0),   # East (RIGHT)\n      2: (0, 1),   # South (DOWN)\n      3: (-1, 0),  # West (LEFT)\n  }\n\n  # Map movement action to the resulting agent direction\n  # This defines the direction the agent faces *after* attempting the move action.\n  MOVE_ACTION_TO_DIRECTION = {\n      UP: 0,    # UP action results in facing North\n      RIGHT: 1, # RIGHT action results in facing East\n      DOWN: 2,  # DOWN action results in facing South\n      LEFT: 3,  # LEFT action results in facing West\n  }\n\n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Get initial agent position (x, y) and direction (0=N, 1=E, 2=S, 3=W)\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  initial_dir = np.argmax(obs['features_dict']['direction']) # Convert one-hot to integer direction\n\n  world = env.world\n  # non_grabbable_indices are assumed to be obstacles that cannot be traversed.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape # Grid dimensions: Width, Height, Number of kinds\n\n  # 1. Create a traversability mask for the grid\n  # A cell is traversable if it does not contain any non-grabbable item.\n  # Optimized creation using NumPy vectorization (improvement over v1's nested loops)\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for idx in non_grabbable_indices:\n      # Cells containing any non-grabbable item are marked as non-traversable\n      traversable_mask[grid[:, :, idx] > 0] = False\n  \n  # The agent's starting position must be traversable for a valid path to exist.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return []\n\n  # BFS state: ((x, y), current_facing_direction, list_of_actions_so_far)\n  # The queue stores tuples: ((pos_x, pos_y), current_dir, actions_taken)\n  q = deque([((current_pos_x, current_pos_y), initial_dir, [])])\n  \n  # Visited set: ((pos_x, pos_y), current_dir) to prevent revisiting states and cycles\n  visited = {((current_pos_x, current_pos_y), initial_dir)}\n  \n  while q:\n      (curr_x, curr_y), curr_dir, actions_so_far = q.popleft()\n\n      # Check if the current state allows collection of the primitive (via USE action)\n      # The USE action applies to the cell directly in front of the agent.\n      front_dx, front_dy = DIRECTION_TO_DELTA[curr_dir] # Delta for the cell in front\n      target_x, target_y = curr_x + front_dx, curr_y + front_dy\n\n      # Check if the target cell is within grid bounds AND contains the primitive\n      if (0 <= target_x < W and 0 <= target_y < H and\n          grid[target_x, target_y, primitive] > 0):\n          # Goal reached: agent is positioned and facing a primitive resource.\n          # Append USE action to the path and return the sequence.\n          return actions_so_far + [USE]\n\n      # Explore possible next states by taking movement actions (UP, DOWN, LEFT, RIGHT)\n      for action_val in [UP, DOWN, LEFT, RIGHT]:\n          # Determine the direction the agent will face after this action\n          next_dir_after_action = MOVE_ACTION_TO_DIRECTION[action_val]\n          \n          # Calculate the potential new position if the move is successful\n          move_dx, move_dy = DIRECTION_TO_DELTA[next_dir_after_action]\n          proposed_next_x, proposed_next_y = curr_x + move_dx, curr_y + move_dy\n          \n          actual_next_x, actual_next_y = curr_x, curr_y # Default: stay in place\n\n          # Check if the proposed next cell is within bounds and traversable\n          if (0 <= proposed_next_x < W and 0 <= proposed_next_y < H and\n              traversable_mask[proposed_next_x, proposed_next_y]):\n              # If traversable, the agent actually moves\n              actual_next_x, actual_next_y = proposed_next_x, proposed_next_y\n          # Else: The agent stays at curr_pos, but its direction still changes.\n\n          next_state_key = ((actual_next_x, actual_next_y), next_dir_after_action)\n          \n          # If this (position, direction) state has not been visited yet, add to queue\n          if next_state_key not in visited:\n              visited.add(next_state_key)\n              q.append(((actual_next_x, actual_next_y), next_dir_after_action, actions_so_far + [action_val]))\n\n  return [] # No path found to a pickup spot for the primitive", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T13:30:50.862268", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np # Ensure numpy is available within the function if not imported globally\n\n  # Action constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map agent direction (0=N, 1=E, 2=S, 3=W) to (dx, dy) delta for the cell in front\n  DIRECTION_TO_DELTA = {\n      0: (0, -1),  # North (UP)\n      1: (1, 0),   # East (RIGHT)\n      2: (0, 1),   # South (DOWN)\n      3: (-1, 0),  # West (LEFT)\n  }\n\n  # Map movement action to the resulting agent direction\n  # This defines the direction the agent faces *after* attempting the move action.\n  MOVE_ACTION_TO_DIRECTION = {\n      UP: 0,    # UP action results in facing North\n      RIGHT: 1, # RIGHT action results in facing East\n      DOWN: 2,  # DOWN action results in facing South\n      LEFT: 3,  # LEFT action results in facing West\n  }\n\n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Get initial agent position (x, y) and direction (0=N, 1=E, 2=S, 3=W)\n  # Assuming 'pos' from features_dict provides integer (x,y) coordinates directly.\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  initial_dir = np.argmax(obs['features_dict']['direction']) # Convert one-hot to integer direction\n\n  world = env.world\n  # non_grabbable_indices are assumed to be obstacles that cannot be traversed.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape # Grid dimensions: Width, Height, Number of kinds\n\n  # 1. Create a traversability mask for the grid\n  # A cell is traversable if it does not contain any non-grabbable item.\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for idx in non_grabbable_indices:\n      # Mark cells as non-traversable if they contain any non-grabbable item\n      # This is a vectorized approach, setting all cells containing `idx` to False.\n      traversable_mask[grid[:, :, idx] > 0] = False\n  \n  # The agent's starting position must be traversable for a valid path to exist.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return []\n\n  # 2. Pre-calculate all possible \"target\" states ((agent_x, agent_y), agent_dir)\n  # from which the primitive can be collected using the USE action.\n  primitive_target_states = set()\n  \n  # Find all locations of the target primitive on the grid\n  # np.where returns (row_indices, col_indices), so (y_coords, x_coords) for grid[x, y]\n  primitive_y_coords, primitive_x_coords = np.where(grid[:, :, primitive] > 0)\n  \n  for px, py in zip(primitive_x_coords, primitive_y_coords):\n      # For each primitive location (px, py), determine all 4 possible adjacent\n      # agent positions (ax, ay) and the direction (ad) the agent must face\n      # to successfully collect the primitive.\n      for ad, (delta_x_facing, delta_y_facing) in DIRECTION_TO_DELTA.items():\n          # If agent at (ax, ay) faces direction `ad`, the cell in front is (ax + delta_x_facing, ay + delta_y_facing).\n          # We want this cell to be (px, py).\n          # So, ax + delta_x_facing = px  =>  ax = px - delta_x_facing\n          # And, ay + delta_y_facing = py  =>  ay = py - delta_y_facing\n          ax, ay = px - delta_x_facing, py - delta_y_facing\n          \n          # Check if this potential agent position is within bounds and traversable\n          if 0 <= ax < W and 0 <= ay < H and traversable_mask[ax, ay]:\n              # If valid, this (position, direction) is a target state for collection.\n              primitive_target_states.add(((ax, ay), ad)) # Store as ((pos_x, pos_y), agent_dir)\n\n  # BFS setup\n  # Queue stores tuples: ((current_pos_x, current_pos_y), current_direction, list_of_actions_taken)\n  q = deque([((current_pos_x, current_pos_y), initial_dir, [])])\n  \n  # Visited set: (current_pos_x, current_pos_y, current_direction) to prevent revisiting states and cycles\n  # Using tuples for positions to make them hashable for the set.\n  visited = {((current_pos_x, current_pos_y), initial_dir)}\n  \n  while q:\n      (curr_x, curr_y), curr_dir, actions_so_far = q.popleft()\n\n      # Goal check: Is the current (position, direction) state one from which the primitive can be collected?\n      if ((curr_x, curr_y), curr_dir) in primitive_target_states:\n          # Goal reached: agent is positioned and facing a primitive resource.\n          # Append the USE action to the path and return the sequence.\n          return actions_so_far + [USE]\n\n      # Explore possible next states by taking movement actions (UP, DOWN, LEFT, RIGHT)\n      for action_val in [UP, DOWN, LEFT, RIGHT]:\n          # Determine the direction the agent will face after attempting this action.\n          # The agent's direction changes to match the movement action, regardless of whether a move occurs.\n          next_dir_after_action = MOVE_ACTION_TO_DIRECTION[action_val]\n          \n          # Calculate the proposed new position if the move is successful.\n          move_dx, move_dy = DIRECTION_TO_DELTA[next_dir_after_action]\n          proposed_next_x, proposed_next_y = curr_x + move_dx, curr_y + move_dy\n          \n          # Initialize actual next position to current position (agent stays if blocked).\n          actual_next_x, actual_next_y = curr_x, curr_y \n\n          # Check if the proposed next cell is within grid bounds and is traversable.\n          if (0 <= proposed_next_x < W and 0 <= proposed_next_y < H and\n              traversable_mask[proposed_next_x, proposed_next_y]):\n              # If traversable, the agent successfully moves to the proposed cell.\n              actual_next_x, actual_next_y = proposed_next_x, proposed_next_y\n          # Else: The agent cannot move to the proposed cell (it's blocked or out of bounds),\n          # so it stays at its current (curr_x, curr_y) position, but still changes its direction.\n          \n          # Form the key for the next state (position, direction)\n          next_state_key = ((actual_next_x, actual_next_y), next_dir_after_action)\n          \n          # If this new (position, direction) state has not been visited yet, add it to the queue.\n          if next_state_key not in visited:\n              visited.add(next_state_key)\n              q.append(((actual_next_x, actual_next_y), next_dir_after_action, actions_so_far + [action_val]))\n\n  return [] # If the queue becomes empty and no path to a collection spot was found, return an empty list.", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T13:31:53.182165", "function_name": "collect", "function_body": "  import collections\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Defines movement for each action: (dx, dy, resulting_facing_direction_index)\n  # The direction indices (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) correspond to the agent's\n  # facing direction *after* the move.\n  MOVE_ACTIONS_PROPERTIES = {\n      ACTION_UP: (0, -1, 0),    # Move UP: change Y by -1, new facing_dir is 0 (UP)\n      ACTION_RIGHT: (1, 0, 1),  # Move RIGHT: change X by +1, new facing_dir is 1 (RIGHT)\n      ACTION_DOWN: (0, 1, 2),   # Move DOWN: change Y by +1, new facing_dir is 2 (DOWN)\n      ACTION_LEFT: (-1, 0, 3),  # Move LEFT: change X by -1, new facing_dir is 3 (LEFT)\n  }\n\n  # This table helps determine which (agent_x, agent_y) and agent_dir are needed\n  # to use an item at (item_x, item_y).\n  # If agent at (ax,ay) faces dir and uses (ax+use_dx, ay+use_dy) == (item_x, item_y):\n  # This map stores (dx_from_item, dy_from_item) to get agent's position (ax, ay)\n  # when item is at (px, py) and agent faces `agent_dir`.\n  AGENT_POS_RELATIVE_TO_ITEM = {\n      0: (0, 1),   # Agent faces UP (0), agent is at (px, py+1) to USE item at (px,py)\n      1: (-1, 0),  # Agent faces RIGHT (1), agent is at (px-1, py) to USE item at (px,py)\n      2: (0, -1),  # Agent faces DOWN (2), agent is at (px, py-1) to USE item at (px,py)\n      3: (1, 0),   # Agent faces LEFT (3), agent is at (px+1, py) to USE item at (px,py)\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information from the environment's internal state\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Get the set of indices for non-grabbable entities (obstacles)\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  # Helper function to check if a grid cell is within bounds and not occupied by an obstacle.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    \n    # Check if the cell is occupied by any non-grabbable item (which acts as an obstacle).\n    for k_idx in non_grabbable_kinds:\n      if grid[x, y, k_idx] == 1: # Assuming 1 indicates presence of the kind\n        return False\n    return True\n\n  # 2. Pre-compute all (agent_x, agent_y, agent_direction) states from which the primitive\n  # can be collected by performing an ACTION_USE. These are the target states for our BFS.\n  collectable_agent_states = set()\n\n  # Iterate through all cells in the grid to find instances of the target primitive.\n  for px in range(grid_width):\n    for py in range(grid_height):\n      if grid[px, py, primitive] == 1:\n        # This cell (px, py) contains the primitive.\n        # Now, find all possible agent positions (ax, ay) and agent directions (adir)\n        # such that the agent at (ax, ay) facing adir would point to (px, py) for USE.\n        \n        # Iterate over all possible agent facing directions\n        for agent_dir, (relative_dx_from_item, relative_dy_from_item) in AGENT_POS_RELATIVE_TO_ITEM.items():\n          # Calculate the agent's position (ax, ay) given the item's position (px, py)\n          ax, ay = px + relative_dx_from_item, py + relative_dy_from_item\n\n          # If this agent position is walkable, add the full state to collectable_agent_states.\n          if is_walkable(ax, ay):\n            collectable_agent_states.add((ax, ay, agent_dir))\n\n  # If no collectable primitive instances are found on the grid, or no reachable collection points,\n  # return an empty path.\n  if not collectable_agent_states:\n      return []\n\n  # 3. Breadth-First Search (BFS) to find the shortest sequence of actions.\n  # Queue stores tuples: (current_x, current_y, current_direction)\n  queue = collections.deque([(start_x, start_y, start_dir)])\n\n  # Visited set to avoid redundant exploration and cycles. A state is defined by\n  # (x, y, direction) because the agent's direction affects what it can interact with (USE action).\n  visited = set([(start_x, start_y, start_dir)])\n  \n  # parent_map: maps (state) -> (parent_state, action_from_parent_to_state)\n  # This allows reconstructing the path without storing full paths in the queue.\n  parent_map = {} \n  \n  target_state_found = None # Will store the (x, y, dir) of the first found target state\n\n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state is one from which the primitive can be collected.\n    if (curr_x, curr_y, curr_dir) in collectable_agent_states:\n      target_state_found = (curr_x, curr_y, curr_dir)\n      break # Found the shortest path to a collectable state\n\n    # Explore possible next movement actions.\n    for action, (move_dx, move_dy, next_dir) in MOVE_ACTIONS_PROPERTIES.items():\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n\n      # If the next cell is walkable and this (position, direction) state hasn't been visited,\n      # add it to the queue for further exploration.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        # Store how we reached this 'next_state' from 'curr_state' via 'action'\n        parent_map[(next_x, next_y, next_dir)] = ((curr_x, curr_y, curr_dir), action)\n        queue.append((next_x, next_y, next_dir))\n\n  # If no path was found to any collectable state\n  if not target_state_found:\n    return []\n\n  # 4. Reconstruct the path by backtracking from the found target state to the start state.\n  path_actions = []\n  current = target_state_found\n  \n  # Backtrack using the parent_map until we reach the starting state.\n  while current != (start_x, start_y, start_dir):\n    # Retrieve the parent state and the action that led from the parent to 'current'\n    previous_state, action_to_current = parent_map[current]\n    path_actions.append(action_to_current)\n    current = previous_state # Move to the parent state\n\n  # The path is constructed in reverse order (from target back to start), so reverse it.\n  path_actions.reverse()\n  \n  # Add the final USE action required to collect the primitive.\n  return path_actions + [ACTION_USE]", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T13:31:53.251842", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Defines movement for each action: (dx, dy, resulting_facing_direction_index)\n    # The direction indices (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) correspond to the agent's\n    # facing direction *after* the move.\n    MOVE_ACTIONS_PROPERTIES = {\n        ACTION_UP: (0, -1, 0),    # Move UP: change Y by -1, new facing_dir is 0 (UP)\n        ACTION_RIGHT: (1, 0, 1),  # Move RIGHT: change X by +1, new facing_dir is 1 (RIGHT)\n        ACTION_DOWN: (0, 1, 2),   # Move DOWN: change Y by +1, new facing_dir is 2 (DOWN)\n        ACTION_LEFT: (-1, 0, 3),  # Move LEFT: change X by -1, new facing_dir is 3 (LEFT)\n    }\n\n    # This table helps determine which (agent_x, agent_y) and agent_dir are needed\n    # to use an item at (item_x, item_y).\n    # If agent at (ax,ay) faces 'dir' and uses (ax+use_dx, ay+use_dy) == (item_x, item_y):\n    # This map stores (dx_from_item, dy_from_item) to get agent's position (ax, ay)\n    # when item is at (px, py) and agent faces `agent_dir`.\n    AGENT_POS_RELATIVE_TO_ITEM = {\n        0: (0, 1),   # Agent faces UP (0), agent is at (px, py+1) to USE item at (px,py)\n        1: (-1, 0),  # Agent faces RIGHT (1), agent is at (px-1, py) to USE item at (px,py)\n        2: (0, -1),  # Agent faces DOWN (2), agent is at (px, py-1) to USE item at (px,py)\n        3: (1, 0),   # Agent faces LEFT (3), agent is at (px+1, py) to USE item at (px,py)\n    }\n\n    # 1. Initial Check: If the primitive is already in the inventory, no actions are needed.\n    initial_state = env._current_state\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    # 2. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n    if primitive not in env.world.grabbable_indices:\n        return []\n\n    # Get current state information from the environment's internal state\n    start_x, start_y = initial_state.pos\n    start_dir = initial_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n    grid = initial_state.grid\n    grid_width, grid_height, _ = grid.shape\n\n    # Get the set of indices for non-grabbable entities (obstacles)\n    non_grabbable_kinds = env.world.non_grabbable_indices\n    # Convert the set of non-grabbable kinds to a NumPy array once for efficient indexing\n    non_grabbable_array = np.array(list(non_grabbable_kinds))\n\n\n    # Helper function to check if a grid cell is within bounds and not occupied by an obstacle.\n    def is_walkable(x, y):\n        if not (0 <= x < grid_width and 0 <= y < grid_height):\n            return False # Out of bounds\n        \n        # Optimized check: Use numpy.any to quickly determine if any non-grabbable\n        # item is present at the given grid cell.\n        # np.any will return False if non_grabbable_array is empty (no obstacles).\n        if non_grabbable_array.size > 0 and np.any(grid[x, y, non_grabbable_array]):\n            return False\n        return True\n\n    # 3. Pre-compute all (agent_x, agent_y, agent_direction) states from which the primitive\n    # can be collected by performing an ACTION_USE. These are the target states for our BFS.\n    collectable_agent_states = set()\n\n    # Iterate through all cells in the grid to find instances of the target primitive.\n    for px in range(grid_width):\n        for py in range(grid_height):\n            if grid[px, py, primitive] == 1:\n                # This cell (px, py) contains the primitive.\n                # Now, find all possible agent positions (ax, ay) and agent directions (adir)\n                # such that the agent at (ax, ay) facing adir would point to (px, py) for USE.\n                \n                # Iterate over all possible agent facing directions\n                for agent_dir, (relative_dx_from_item, relative_dy_from_item) in AGENT_POS_RELATIVE_TO_ITEM.items():\n                    # Calculate the agent's position (ax, ay)\n                    ax, ay = px + relative_dx_from_item, py + relative_dy_from_item\n\n                    # If this agent position is walkable, add the full state to collectable_agent_states.\n                    if is_walkable(ax, ay):\n                        collectable_agent_states.add((ax, ay, agent_dir))\n\n    # If no collectable primitive instances are found on the grid, or no reachable collection points,\n    # return an empty path.\n    if not collectable_agent_states:\n        return []\n\n    # 4. Breadth-First Search (BFS) to find the shortest sequence of actions.\n    # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n    queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n    # Visited set to avoid redundant exploration and cycles. A state is defined by\n    # (x, y, direction) because the agent's direction affects what it can interact with (USE action).\n    visited = set([(start_x, start_y, start_dir)])\n\n    while queue:\n        curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n        # Check if the current state is one from which the primitive can be collected.\n        if (curr_x, curr_y, curr_dir) in collectable_agent_states:\n            return path_actions + [ACTION_USE]\n\n        # Explore possible next movement actions.\n        for action, (move_dx, move_dy, next_dir) in MOVE_ACTIONS_PROPERTIES.items():\n            next_x, next_y = curr_x + move_dx, curr_y + move_dy\n\n            # If the next cell is walkable and this (position, direction) state hasn't been visited,\n            # add it to the queue for further exploration.\n            if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n                visited.add((next_x, next_y, next_dir))\n                queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n    # If the queue becomes empty and no path to collect the primitive was found.\n    return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:33:52.326270", "function_name": "collect", "function_body": "    import numpy as np\n    import collections\n\n    # Define action constants, assuming they map to integers as per action_specs()\n    # In a real environment, these would typically be imported from env_factory.actions\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    # Define relative movements for each action\n    _ACTION_TO_DELTAS = {\n        _UP: (0, -1),\n        _RIGHT: (1, 0),\n        _DOWN: (0, 1),\n        _LEFT: (-1, 0),\n    }\n\n    # Safety limit to prevent extremely long or infinite loops\n    max_actions_limit = 500\n\n    # List to store the sequence of actions taken\n    actions_taken = []\n\n    # Loop to continuously plan and execute actions until the primitive is collected\n    # or the action limit is reached.\n    for _ in range(max_actions_limit):\n        obs = env.observations()\n        current_grid = obs['features_dict']['features_global']\n        current_pos = tuple(obs['features_dict']['pos'].astype(int)) # Convert numpy array to tuple for hashing\n        current_inventory = obs['features_dict']['inventory']\n\n        # 1. Check if the primitive is already in inventory\n        if current_inventory[primitive] > 0:\n            return actions_taken # Goal achieved\n\n        world = env.world # Access the CraftWorld instance for configuration\n        grid_width, grid_height, _ = current_grid.shape\n        # Get indices of entities that block movement (non-grabbable items)\n        non_traversable_kinds = world.non_grabbable_indices\n\n        # Helper function to determine if a cell is traversable\n        def is_traversable(x, y):\n            # Check bounds\n            if not (0 <= x < grid_width and 0 <= y < grid_height):\n                return False\n\n            # The agent's current position is always traversable\n            if (x, y) == current_pos:\n                return True\n\n            # A cell is blocked if it contains any non-traversable kind\n            for kind_idx in non_traversable_kinds:\n                if current_grid[x, y, kind_idx] > 0:\n                    return False\n            return True\n\n        # 2. Find all locations where the primitive exists on the grid\n        primitive_locations = np.argwhere(current_grid[:, :, primitive] > 0)\n\n        if len(primitive_locations) == 0:\n            # Primitive not found on the map, no further actions can be taken\n            return actions_taken\n\n        # 3. Determine potential target cells for BFS: any traversable cell adjacent to a primitive\n        target_adjacent_cells = set()\n        for px, py in primitive_locations:\n            for dx, dy in _ACTION_TO_DELTAS.values(): # Iterate over possible deltas (neighbor directions)\n                nx, ny = px + dx, py + dy\n                if is_traversable(nx, ny):\n                    target_adjacent_cells.add((nx, ny))\n        \n        if not target_adjacent_cells:\n            # No reachable adjacent cells to any primitive instance\n            return actions_taken\n\n        # 4. Perform Breadth-First Search (BFS) to find the shortest path\n        # from the current position to any of the target adjacent cells.\n        queue = collections.deque([(current_pos, [])]) # (current_xy_tuple, list_of_actions_to_get_here)\n        visited = {current_pos}\n        path_to_adjacent_cell = None\n\n        while queue:\n            (cx, cy), current_path_actions = queue.popleft()\n\n            if (cx, cy) in target_adjacent_cells:\n                path_to_adjacent_cell = current_path_actions\n                break # Found the shortest path to an adjacent cell\n\n            # Explore neighbors\n            for action_val, (dx, dy) in _ACTION_TO_DELTAS.items():\n                nx, ny = cx + dx, cy + dy\n                next_pos = (nx, ny)\n\n                if is_traversable(nx, ny) and next_pos not in visited:\n                    visited.add(next_pos)\n                    queue.append((next_pos, current_path_actions + [action_val]))\n\n        if path_to_adjacent_cell is None:\n            # No path found to any adjacent cell of the primitive\n            return actions_taken\n\n        # 5. Execute the found path actions\n        for action in path_to_adjacent_cell:\n            _, _, new_obs = env.step(action)\n            actions_taken.append(action)\n\n            # After each step, re-check if the primitive has been collected.\n            # This handles cases where primitive is collected by moving over it (less common)\n            # or if the environment is dynamic.\n            if new_obs['features_dict']['inventory'][primitive] > 0:\n                return actions_taken\n\n            # If the actions limit is reached during path execution, return early\n            if len(actions_taken) >= max_actions_limit:\n                return actions_taken\n\n        # 6. After reaching an adjacent cell, perform the USE action\n        _, _, new_obs = env.step(_USE)\n        actions_taken.append(_USE)\n\n        # After using, the loop will continue to the next iteration\n        # and check the inventory at the very beginning. This handles\n        # scenarios where USE might not immediately yield the item.\n\n    # If the max_actions_limit is reached without collecting the primitive,\n    # return the actions taken so far.\n    return actions_taken", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:33:53.299305", "function_name": "collect", "function_body": "  path = []\n  visited_positions = set()\n  MAX_STEPS = 1000  # Max steps to prevent infinite loops\n\n  # Attempt to get WIDTH and HEIGHT from env_factory.\n  # These are crucial for tracking visited positions accurately on the grid.\n  # If env_factory is not accessible or doesn't define them, position tracking\n  # will be disabled, which might make exploration less efficient.\n  _world_width = None\n  _world_height = None\n  try:\n      from env_factory import WIDTH, HEIGHT\n      _world_width = WIDTH\n      _world_height = HEIGHT\n  except ImportError:\n      # This handles the case where env_factory might not be directly importable\n      # or does not define WIDTH/HEIGHT.\n      # In a real system, these would likely be passed or more reliably accessed.\n      pass\n  except AttributeError:\n      # Handles cases where env_factory exists but WIDTH/HEIGHT attributes are missing\n      pass\n      \n  # Initial observation\n  obs = env.observations()\n\n  # Get view dimensions for ego features\n  # features_ego shape is typically (ego_h, ego_w, n_kinds)\n  ego_features_shape = obs['features_dict']['features_ego'].shape\n  ego_h, ego_w, n_kinds = ego_features_shape\n\n  # Agent's position in the egocentric view (usually the center)\n  agent_ego_r, agent_ego_c = ego_h // 2, ego_w // 2\n\n  # Define a sequence of movement actions to try for exploration\n  # This order can be adjusted for different exploration patterns (e.g., turn based on current direction)\n  movement_actions = [ACTION_RIGHT, ACTION_UP, ACTION_LEFT, ACTION_DOWN]\n  # Index to cycle through movement_actions when exploring\n  # Initialize with a common default, or consider agent's initial direction.\n  # For simplicity, start with 0 and cycle.\n  current_movement_idx = 0 \n\n  for step_count in range(MAX_STEPS):\n      current_obs_dict = obs['features_dict']\n\n      # 1. Check if the primitive is already collected\n      current_inventory = current_obs_dict['inventory']\n      if current_inventory[primitive_idx] > 0:\n          return path\n\n      # Get current grid position to track visited cells if dimensions are available\n      current_grid_pos = None\n      if _world_width is not None and _world_height is not None:\n          current_pos_normalized = current_obs_dict['pos']\n          current_grid_pos = (int(round(current_pos_normalized[0] * (_world_width - 1))),\n                              int(round(current_pos_normalized[1] * (_world_height - 1))))\n          visited_positions.add(current_grid_pos)\n\n\n      # 2. Check if primitive is next to agent using features_ego (3x3 neighborhood)\n      found_next_to_primitive = False\n      for dr in [-1, 0, 1]:\n          for dc in [-1, 0, 1]:\n              if dr == 0 and dc == 0: # Skip agent's own cell\n                  continue\n              r, c = agent_ego_r + dr, agent_ego_c + dc\n              if 0 <= r < ego_h and 0 <= c < ego_w: # Check if cell is within ego view bounds\n                  # Check if the primitive_idx's one-hot bit is set in this cell\n                  if current_obs_dict['features_ego'][r, c, primitive_idx] == 1:\n                      found_next_to_primitive = True\n                      break\n          if found_next_to_primitive:\n              break\n\n      if found_next_to_primitive:\n          # If next to the primitive, attempt to USE it\n          reward, done, obs = env.step(ACTION_USE)\n          path.append(ACTION_USE)\n          \n          # Re-check inventory immediately after attempting USE\n          current_inventory = obs['features_dict']['inventory']\n          if current_inventory[primitive_idx] > 0:\n              return path\n          # If USE didn't work (e.g., it was not grabbable, or needed a tool not present),\n          # the loop will continue to the next step_count, possibly trying to move.\n          continue # Go to the next iteration of the main loop\n\n      # 3. If primitive not found next to agent and not collected, attempt to move\n      moved_in_this_step = False\n      for _ in range(len(movement_actions)): # Try each movement direction at most once\n          action_to_take = movement_actions[current_movement_idx]\n          \n          # Store previous position to detect if a move actually occurred\n          prev_pos_normalized = obs['features_dict']['pos'] if 'pos' in obs['features_dict'] else None\n\n          reward, done, obs = env.step(action_to_take)\n          path.append(action_to_take)\n          \n          # Check if the agent's position changed after the action\n          if prev_pos_normalized is not None:\n              new_pos_normalized = obs['features_dict']['pos']\n              if not np.array_equal(prev_pos_normalized, new_pos_normalized):\n                  # Position changed, means successful movement\n                  moved_in_this_step = True\n                  # It's an \"improvement\" to prioritize this direction if it led to movement.\n                  # So, `current_movement_idx` remains unchanged for the next main loop iteration.\n                  break # Break out of inner movement-attempt loop, proceed to next step_count\n              else:\n                  # Position did NOT change (e.g., hit a wall).\n                  # This action was effectively a no-op for movement. Remove it from path.\n                  path.pop() \n          else: # If position tracking is disabled, assume any movement action contributes\n              moved_in_this_step = True\n              break # Just take the first movement action that doesn't error out\n\n          # Rotate to the next movement action in the sequence for the next attempt within this step_count\n          current_movement_idx = (current_movement_idx + 1) % len(movement_actions)\n\n      if not moved_in_this_step:\n          # If, after trying all movement actions, the agent's position did not change,\n          # it means the agent is likely stuck or surrounded by unpassable terrain.\n          # In this case, return the current path, as no further progress can be made.\n          return path\n\n  # If MAX_STEPS are reached and the primitive has not been collected\n  return path", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:35:22.075267", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action constants (from problem description context)\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Map movement action values to (dx, dy) deltas\n  # (dx, dy) represents how the agent's position changes\n  MOVEMENT_DELTAS = {\n      UP_ACTION: (0, -1),   # Moving North\n      DOWN_ACTION: (0, 1),  # Moving South\n      LEFT_ACTION: (-1, 0), # Moving West\n      RIGHT_ACTION: (1, 0), # Moving East\n  }\n\n  # Map movement action values to the resulting agent direction (0=N, 1=E, 2=S, 3=W)\n  # Taking a movement action makes the agent face that direction.\n  ACTION_TO_NEW_DIRECTION = {\n      UP_ACTION: 0,    # UP action results in facing North (direction 0)\n      RIGHT_ACTION: 1, # RIGHT action results in facing East (direction 1)\n      DOWN_ACTION: 2,  # DOWN action results in facing South (direction 2)\n      LEFT_ACTION: 3,  # LEFT action results in facing West (direction 3)\n  }\n  \n  # Map agent direction to (dx, dy) for the cell directly in front of the agent\n  # This is crucial for determining where the USE action would apply.\n  DIRECTION_TO_FACING_DELTA = {\n      0: (0, -1),  # North (agent faces up)\n      1: (1, 0),   # East (agent faces right)\n      2: (0, 1),   # South (agent faces down)\n      3: (-1, 0),  # West (agent faces left)\n  }\n\n  def _get_primitive_source_indices(primitive_item_idx: int, world) -> set[int]:\n    \"\"\"\n    Returns a set of grid indices that, when present in the cell directly in front\n    of the agent, allow the collection of `primitive_item_idx` via the USE action.\n    This includes the item itself (for direct pickup if it's an item on the ground)\n    and specific blocks (for harvesting, e.g., 'water' from 'water_block').\n    \"\"\"\n    source_indices = set()\n    \n    # Always include the primitive itself if it can be directly picked up (e.g., items on ground)\n    if primitive_item_idx in world.grabbable_indices:\n        source_indices.add(primitive_item_idx)\n\n    item_name = world.cookbook.index.get(primitive_item_idx)\n    if item_name == 'water':\n        # Check if water_index exists on world object, as it might not always be defined.\n        if hasattr(world, 'water_index'): \n            source_indices.add(world.water_index) # Add water block index for harvesting water\n    elif item_name == 'stone':\n        if hasattr(world, 'stone_index'):\n            source_indices.add(world.stone_index) # Add stone block index for harvesting stone\n    # Extend this logic for other harvestable primitives if needed, e.g., 'wood' from 'tree'\n    # if item_name == 'wood':\n    #     if hasattr(world, 'tree_index'):\n    #         source_indices.add(world.tree_index)\n            \n    return source_indices\n\n  # --- Start of main collect_v2 logic ---\n  \n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Convert position numpy array to tuple for hashing in sets/dictionaries.\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  # Current direction is a one-hot array, convert to an integer (0=N, 1=E, 2=S, 3=W)\n  current_dir = np.argmax(obs['features_dict']['direction'])\n  \n  world = env.world\n  # non_grabbable_indices are assumed to be obstacles that cannot be traversed by the agent.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape # Grid dimensions\n\n  # 1. Determine traversable cells (vectorized for performance)\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  # Create a boolean mask indicating if each kind is a non-grabbable obstacle.\n  is_obstacle_kind = np.isin(np.arange(K), non_grabbable_indices)\n  \n  # Check if any non-grabbable item is present in each grid cell.\n  # Use .any(axis=-1) to check if any obstacle kind is present in the last dimension.\n  has_obstacle = (grid[:, :, is_obstacle_kind] > 0).any(axis=-1)\n  \n  # Traversable cells are those that do NOT have an obstacle.\n  traversable_mask = ~has_obstacle\n  \n  # If the agent starts on an untraversable cell, no path is possible.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] \n\n  # 2. Identify all (agent_pos, agent_dir) states from which the USE action is possible.\n  # These are the states where the cell directly in front of the agent contains a source of the primitive.\n  target_pickup_states = set() # Stores elements as ((agent_x, agent_y), agent_direction)\n\n  primitive_source_indices = _get_primitive_source_indices(primitive, world)\n\n  # If no known source indices for the primitive, it's uncollectable.\n  if not primitive_source_indices:\n      return []\n\n  # Iterate through every possible agent position on the grid\n  for x in range(W):\n      for y in range(H):\n          if not traversable_mask[x, y]: # Agent must be on a traversable cell to potentially USE an item\n              continue\n          \n          # For each traversable agent position, iterate through all 4 possible facing directions\n          for agent_dir in range(4): \n              dx_fwd, dy_fwd = DIRECTION_TO_FACING_DELTA[agent_dir] # Delta for the cell in front\n              faced_x, faced_y = x + dx_fwd, y + dy_fwd\n\n              # Check if the cell being faced is within grid bounds\n              if not (0 <= faced_x < W and 0 <= faced_y < H):\n                  continue\n              \n              # Check if the faced cell contains any of the identified primitive source kinds\n              # Use np.any() with boolean indexing for efficiency.\n              if np.any(grid[faced_x, faced_y, list(primitive_source_indices)] > 0):\n                  target_pickup_states.add(((x, y), agent_dir))\n  \n  # If no valid pickup states are found anywhere on the map, the primitive is unreachable.\n  if not target_pickup_states:\n      return [] \n\n  # 3. Perform a Breadth-First Search (BFS) to find the shortest sequence of actions\n  #    to reach any of the `target_pickup_states`.\n  \n  # Queue stores (current_position_tuple, current_direction_int)\n  q = deque([(current_pos, current_dir)])\n  \n  # Visited states store (position_tuple, direction_integer) and their parent information\n  # {(pos, dir): (parent_pos, parent_dir, action_from_parent_to_here)}\n  parent_map = {}\n  parent_map[(current_pos, current_dir)] = None # Mark the starting node with None parent\n\n  final_state = None # Will store the (pos, dir) of the first target state found\n\n  while q:\n      curr_pos, curr_dir = q.popleft()\n\n      # If the current agent state (position and direction) is one of our target pickup states,\n      # we have found the shortest path. Store it and break to reconstruct.\n      if (curr_pos, curr_dir) in target_pickup_states:\n          final_state = (curr_pos, curr_dir)\n          break\n\n      # Explore possible actions (movement, which also implicitly handles turning)\n      for action_val, (dx, dy) in MOVEMENT_DELTAS.items():\n          next_pos_x, next_pos_y = curr_pos[0] + dx, curr_pos[1] + dy\n          # The agent's direction changes to match the direction of the movement action.\n          next_dir = ACTION_TO_NEW_DIRECTION[action_val] \n\n          next_pos = (next_pos_x, next_pos_y)\n\n          # Determine the new state based on whether the movement is blocked or successful.\n          # CraftWorld rule: If a movement action is blocked, agent stays at current pos\n          # but still changes its facing direction.\n          if (0 <= next_pos_x < W and 0 <= next_pos_y < H and\n              traversable_mask[next_pos_x, next_pos_y]):\n              # Successful move to a new traversable cell\n              state_after_action = (next_pos, next_dir)\n              \n          else: \n              # Blocked move: agent stays at curr_pos but changes direction\n              state_after_action = (curr_pos, next_dir)\n\n          # Add the new state to the queue if it hasn't been visited before\n          if state_after_action not in parent_map: # Check parent_map for visited status\n              parent_map[state_after_action] = (curr_pos, curr_dir, action_val)\n              q.append(state_after_action)\n\n  # If final_state is still None, it means the queue was exhausted and no target state was reached.\n  if final_state is None:\n      return []\n\n  # Reconstruct the path backwards from the final state using the parent_map\n  path = [USE_ACTION] # The last action is always USE\n  node = final_state\n  while parent_map[node] is not None:\n      parent_pos, parent_dir, action = parent_map[node]\n      path.append(action)\n      node = (parent_pos, parent_dir)\n\n  return path[::-1] # Reverse the path to get actions in chronological order", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:35:23.054030", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Get current observations once at the beginning\n  obs = env.observations()\n\n  # 0. Check if the primitive is already in the inventory\n  # If the agent already possesses the primitive, no actions are needed to collect it.\n  if obs['features_dict']['inventory'][primitive] > 0:\n      return [] # Primitive already collected, return an empty action list.\n\n  # Action constants (from problem description context)\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Map movement action values to (dx, dy) deltas\n  # (dx, dy) represents how the agent's position changes\n  MOVEMENT_DELTAS = {\n      UP_ACTION: (0, -1),   # Moving North\n      DOWN_ACTION: (0, 1),  # Moving South\n      LEFT_ACTION: (-1, 0), # Moving West\n      RIGHT_ACTION: (1, 0), # Moving East\n  }\n\n  # Map movement action values to the resulting agent direction (0=N, 1=E, 2=S, 3=W)\n  # Taking a movement action makes the agent face that direction.\n  ACTION_TO_NEW_DIRECTION = {\n      UP_ACTION: 0,    # UP action results in facing North (direction 0)\n      RIGHT_ACTION: 1, # RIGHT action results in facing East (direction 1)\n      DOWN_ACTION: 2,  # DOWN action results in facing South (direction 2)\n      LEFT_ACTION: 3,  # LEFT action results in facing West (direction 3)\n  }\n  \n  # Map agent direction to (dx, dy) for the cell directly in front of the agent\n  # This is crucial for determining where the USE action would apply.\n  DIRECTION_TO_FACING_DELTA = {\n      0: (0, -1),  # North (agent faces up)\n      1: (1, 0),   # East (agent faces right)\n      2: (0, 1),   # South (agent faces down)\n      3: (-1, 0),  # West (agent faces left)\n  }\n\n  def _get_primitive_source_indices(primitive_item_idx: int, world) -> set[int]:\n    \"\"\"\n    Returns a set of grid indices that, when present in the cell directly in front\n    of the agent, allow the collection of `primitive_item_idx` via the USE action.\n    This includes the item itself (for direct pickup if it's an item on the ground)\n    and specific blocks (for harvesting, e.g., 'water' from 'water_block').\n    \"\"\"\n    source_indices = set()\n    \n    # Always include the primitive itself if it can be directly picked up (e.g., items on ground)\n    if primitive_item_idx in world.grabbable_indices:\n        source_indices.add(primitive_item_idx)\n\n    item_name = world.cookbook.index.get(primitive_item_idx)\n    if item_name == 'water':\n        # Check if water_index exists on world object, as it might not always be defined.\n        if hasattr(world, 'water_index'): \n            source_indices.add(world.water_index) # Add water block index for harvesting water\n    elif item_name == 'stone':\n        if hasattr(world, 'stone_index'):\n            source_indices.add(world.stone_index) # Add stone block index for harvesting stone\n    # Extend this logic for other harvestable primitives if needed, e.g., 'wood' from 'tree'\n    # if item_name == 'wood':\n    #     if hasattr(world, 'tree_index'):\n    #         source_indices.add(world.tree_index)\n            \n    return source_indices\n\n  # --- Start of main collect_v2 logic ---\n  \n  # Extract relevant current state information from observations\n  grid = obs['features_dict']['features_global']\n  \n  # Convert position numpy array to tuple for hashing in sets/dictionaries.\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  # Current direction is a one-hot array, convert to an integer (0=N, 1=E, 2=S, 3=W)\n  current_dir = np.argmax(obs['features_dict']['direction'])\n  \n  world = env.world\n  # non_grabbable_indices are assumed to be obstacles that cannot be traversed by the agent.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape # Grid dimensions\n\n  # 1. Determine traversable cells (vectorized for performance)\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  # Create a boolean mask indicating if each kind is a non-grabbable obstacle.\n  is_obstacle_kind = np.isin(np.arange(K), list(non_grabbable_indices))\n  \n  # Check if any non-grabbable item is present in each grid cell.\n  # Use .any(axis=-1) to check if any obstacle kind is present in the last dimension.\n  has_obstacle = (grid[:, :, is_obstacle_kind] > 0).any(axis=-1)\n  \n  # Traversable cells are those that do NOT have an obstacle.\n  traversable_mask = ~has_obstacle\n  \n  # If the agent starts on an untraversable cell (e.g., stuck in an obstacle), no path is possible.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] \n\n  # 2. Identify all (agent_pos, agent_dir) states from which the USE action is possible.\n  # These are the states where the cell directly in front of the agent contains a source of the primitive.\n  target_pickup_states = set() # Stores elements as ((agent_x, agent_y), agent_direction)\n\n  primitive_source_indices = _get_primitive_source_indices(primitive, world)\n\n  # If no known source indices for the primitive are defined, it's uncollectable by this method.\n  if not primitive_source_indices:\n      return []\n\n  # Iterate through every possible agent position on the grid\n  for x in range(W):\n      for y in range(H):\n          # Agent must be on a traversable cell to potentially USE an item\n          if not traversable_mask[x, y]: \n              continue\n          \n          # For each traversable agent position, iterate through all 4 possible facing directions\n          for agent_dir in range(4): \n              dx_fwd, dy_fwd = DIRECTION_TO_FACING_DELTA[agent_dir] # Delta for the cell in front\n              faced_x, faced_y = x + dx_fwd, y + dy_fwd\n\n              # Check if the cell being faced is within grid bounds\n              if not (0 <= faced_x < W and 0 <= faced_y < H):\n                  continue\n              \n              # Check if the faced cell contains any of the identified primitive source kinds\n              # Use np.any() with boolean indexing for efficiency.\n              if np.any(grid[faced_x, faced_y, list(primitive_source_indices)] > 0):\n                  target_pickup_states.add(((x, y), agent_dir))\n  \n  # If no valid pickup states are found anywhere on the map, the primitive is unreachable.\n  if not target_pickup_states:\n      return [] \n\n  # 3. Perform a Breadth-First Search (BFS) to find the shortest sequence of actions\n  #    to reach any of the `target_pickup_states`.\n  # Queue stores (current_position_tuple, current_direction_int, list_of_actions_so_far)\n  q = deque([(current_pos, current_dir, [])])\n  \n  # Visited states are (position_tuple, direction_integer) to prevent redundant exploration and cycles.\n  visited = {(current_pos, current_dir)} \n\n  while q:\n      curr_pos, curr_dir, path_so_far = q.popleft()\n\n      # If the current agent state (position and direction) is one of our target pickup states,\n      # we have found the shortest path.\n      if (curr_pos, curr_dir) in target_pickup_states:\n          return path_so_far + [USE_ACTION] # Append the USE action and return the full path\n\n      # Explore possible actions (movement, which also implicitly handles turning)\n      for action_val, (dx, dy) in MOVEMENT_DELTAS.items():\n          next_pos_x, next_pos_y = curr_pos[0] + dx, curr_pos[1] + dy\n          # The agent's direction changes to match the direction of the movement action.\n          next_dir = ACTION_TO_NEW_DIRECTION[action_val] \n\n          next_pos = (next_pos_x, next_pos_y)\n\n          # Determine the new state based on whether the movement is blocked or successful.\n          # CraftWorld rule: If a movement action is blocked, agent stays at current pos\n          # but still changes its facing direction.\n          if (0 <= next_pos_x < W and 0 <= next_pos_y < H and\n              traversable_mask[next_pos_x, next_pos_y]):\n              # Successful move to a new traversable cell\n              state_after_action = (next_pos, next_dir)\n              \n          else: \n              # Blocked move: agent stays at curr_pos but changes direction\n              state_after_action = (curr_pos, next_dir)\n\n          # Add the new state to the queue if it hasn't been visited before\n          if state_after_action not in visited:\n              visited.add(state_after_action)\n              q.append((state_after_action[0], state_after_action[1], path_so_far + [action_val]))\n\n  return [] # If the queue becomes empty and no target state was reached, the primitive is unreachable.", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:36:58.961730", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Define action constants based on CraftLab's action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Define direction constants for the agent's facing direction\n    # Common convention: 0: NORTH, 1: EAST, 2: SOUTH, 3: WEST\n    DIR_NORTH = 0\n    DIR_EAST = 1\n    DIR_SOUTH = 2\n    DIR_WEST = 3\n\n    # Mapping of movement actions to (dy, dx, new_direction)\n    # (dy, dx) represents the change in (row, column) coordinates\n    MOVE_ACTION_MAP = {\n        ACTION_UP:    (-1, 0, DIR_NORTH),\n        ACTION_DOWN:  (1, 0, DIR_SOUTH),\n        ACTION_LEFT:  (0, -1, DIR_WEST),\n        ACTION_RIGHT: (0, 1, DIR_EAST),\n    }\n\n    # Mapping of (dy, dx) differences to the required facing direction\n    # Used to determine which way the agent needs to face to interact with an adjacent cell\n    DELTA_TO_DIR = {\n        (-1, 0): DIR_NORTH,  # Target is to the North (up)\n        (1, 0): DIR_SOUTH,   # Target is to the South (down)\n        (0, -1): DIR_WEST,   # Target is to the West (left)\n        (0, 1): DIR_EAST,    # Target is to the East (right)\n    }\n\n    # Helper function to check if a grid cell is considered an obstacle\n    def _is_obstacle(grid, y, x, non_grabbable_indices):\n        \"\"\"\n        Checks if a cell at (y, x) is an obstacle.\n        Obstacles are defined as cells containing any item whose index\n        is present in the `non_grabbable_indices` set.\n        \"\"\"\n        for idx in non_grabbable_indices:\n            if grid[y, x, idx] > 0:\n                return True  # This cell contains a non-grabbable item, so it's an obstacle.\n        return False  # Cell is not an obstacle (either empty or contains grabbable items)\n\n\n    # Retrieve the current state from the CraftLab environment's internal CraftState instance\n    current_state = env._current_state\n    \n    current_grid = current_state.grid\n    current_pos = current_state.pos  # Agent's current (row, column) position\n    current_dir = current_state.dir  # Agent's current facing direction (int)\n    current_inventory = current_state.inventory\n\n    # Access world configuration details from the CraftWorld instance\n    world = env.world\n    # Indices of items that cannot be picked up or walked through\n    non_grabbable_indices = world.non_grabbable_indices\n\n    # Early exit: If the primitive is already in the inventory, no actions are needed\n    if current_inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions\n    height, width, _ = current_grid.shape\n\n    # Initialize BFS queue and visited set\n    # Queue stores tuples: (current_row, current_col, agent_direction, list_of_actions_taken)\n    queue = collections.deque()\n    queue.append((current_pos[0], current_pos[1], current_dir, []))\n    \n    # Visited set stores (row, col, direction) to prevent revisiting states and infinite loops\n    visited = set()\n    visited.add((current_pos[0], current_pos[1], current_dir))\n\n    # BFS loop\n    while queue:\n        y, x, agent_dir, actions_path = queue.popleft()\n\n        # Check the four adjacent cells (North, South, East, West) for the primitive\n        for dy_adj, dx_adj in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n            ny_adj, nx_adj = y + dy_adj, x + dx_adj\n\n            # Ensure the adjacent cell is within grid boundaries\n            if not (0 <= ny_adj < height and 0 <= nx_adj < width):\n                continue\n\n            # If the adjacent cell contains the target primitive\n            if current_grid[ny_adj, nx_adj, primitive] > 0:\n                # Determine the direction the agent needs to face to interact with this cell\n                required_facing_dir = DELTA_TO_DIR.get((dy_adj, dx_adj))\n\n                # If the agent is currently facing the required direction, it can USE\n                if required_facing_dir is not None and agent_dir == required_facing_dir:\n                    # Append the USE action and return the complete path\n                    return actions_path + [ACTION_USE]\n\n        # Explore possible movement actions from the current state\n        for action, (dy_move, dx_move, new_dir) in MOVE_ACTION_MAP.items():\n            ny, nx = y + dy_move, x + dx_move\n\n            # Ensure the new position is within grid boundaries\n            if not (0 <= ny < height and 0 <= nx < width):\n                continue\n\n            # Check if the new position is an obstacle (cannot move into it)\n            if _is_obstacle(current_grid, ny, nx, non_grabbable_indices):\n                continue\n            \n            # Create a tuple representing the new state (position and direction)\n            new_state_tuple = (ny, nx, new_dir)\n            \n            # If this state has already been visited, skip to avoid redundant paths\n            if new_state_tuple in visited:\n                continue\n\n            # Add the new state to the queue and mark it as visited\n            visited.add(new_state_tuple)\n            queue.append((ny, nx, new_dir, actions_path + [action]))\n\n    # If the BFS queue becomes empty and the primitive has not been found or collected,\n    # it means it is unreachable from the current position.\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:36:59.032941", "function_name": "collect", "function_body": "    state = env._current_state\n\n    # 1. Check if the primitive is already in the inventory\n    if state.inventory[primitive] > 0:\n        return []\n\n    grid = state.grid\n    grid_width, grid_height, _ = grid.shape\n    agent_pos = state.pos\n\n    # Define possible movement actions and their effects (dx, dy)\n    MOVES = {\n        env_factory.CraftAction.DOWN: (0, 1),\n        env_factory.CraftAction.UP: (0, -1),\n        env_factory.CraftAction.LEFT: (-1, 0),\n        env_factory.CraftAction.RIGHT: (1, 0)\n    }\n\n    # 2. Find all locations of the primitive on the grid\n    primitive_locations = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        # Primitive not found anywhere on the grid\n        return []\n\n    # 3. Determine all potential \"target agent positions\"\n    # These are cells from which the agent can use (collect) the primitive.\n    # An agent can use a primitive if it's in the 3x3 neighborhood around the agent's position.\n    target_agent_positions = set()\n    for px, py in primitive_locations:\n        for dx_adj in [-1, 0, 1]:\n            for dy_adj in [-1, 0, 1]:\n                if dx_adj == 0 and dy_adj == 0:\n                    continue # The agent needs to be *adjacent* to, not on top of, the primitive\n\n                tx, ty = px + dx_adj, py + dy_adj\n\n                # Check boundaries for the potential target cell\n                if not (0 <= tx < grid_width and 0 <= ty < grid_height):\n                    continue\n\n                # Check if the target cell is traversable.\n                # A cell is considered traversable if it is not occupied by any non-grabbable item.\n                is_blocked = False\n                for kind_idx in state.world.non_grabbable_indices:\n                    if grid[tx, ty, kind_idx] > 0:\n                        is_blocked = True\n                        break\n                \n                if not is_blocked:\n                    target_agent_positions.add((tx, ty))\n\n    if not target_agent_positions:\n        # No traversable adjacent positions found for any primitive.\n        # This implies all adjacent cells are blocked or the primitive is in an inaccessible spot.\n        return []\n\n    # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n    #    from the agent's current position to any of the target_agent_positions.\n    queue = collections.deque([(agent_pos, [])]) # (current_position, list_of_actions_to_reach_here)\n    visited = {agent_pos} # Set to keep track of visited (x, y) positions to avoid loops\n\n    while queue:\n        curr_pos, curr_path = queue.popleft()\n\n        # If the current position is one of our target agent positions, we found a path.\n        if curr_pos in target_agent_positions:\n            return curr_path + [env_factory.CraftAction.USE] # Add the USE action at the end\n\n        # Explore neighbors\n        for action, (dx, dy) in MOVES.items():\n            next_pos = (curr_pos[0] + dx, curr_pos[1] + dy)\n\n            # Check boundaries for the next position\n            if not (0 <= next_pos[0] < grid_width and 0 <= next_pos[1] < grid_height):\n                continue\n\n            # Check if the next position has already been visited\n            if next_pos in visited:\n                continue\n\n            # Check traversability for the next position.\n            # Similar to target_agent_positions, ensure agent can move onto this cell.\n            is_blocked = False\n            for kind_idx in state.world.non_grabbable_indices:\n                if grid[next_pos[0], next_pos[1], kind_idx] > 0:\n                    is_blocked = True\n                    break\n            \n            if is_blocked:\n                continue # Cannot move to this cell, it's blocked\n\n            # If the cell is traversable and not visited, add it to the queue\n            visited.add(next_pos)\n            queue.append((next_pos, curr_path + [action]))\n\n    # If the BFS completes and no path was found (queue is empty),\n    # it means the primitive is unreachable from the current position.\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:38:14.104052", "function_name": "collect", "function_body": "  actions_taken = []\n  step_count = 0\n\n  # Assume action constants are available from env_factory\n  # e.g., env_factory.DOWN, env_factory.UP, env_factory.LEFT, env_factory.RIGHT, env_factory.USE\n  \n  # A safety check for maximum steps to prevent infinite loops\n  MAX_COLLECT_STEPS = 500 \n\n  while True:\n    # Get current observations from the environment\n    obs = env.observations()\n\n    # Extract inventory and the global grid from observations\n    inventory = obs['features_dict']['inventory']\n    # The grid shape is (WIDTH, HEIGHT, n_kinds)\n    grid = obs['features_dict']['features_global'] \n\n    # Check if the primitive is already in the inventory\n    if inventory[primitive] > 0:\n      break # Goal achieved\n\n    # Check if the primitive is in the agent's 3x3 neighborhood using CraftState's next_to method\n    # CraftLab's _current_state attribute is a CraftState instance\n    if env._current_state.next_to(primitive):\n      actions_taken.append(env_factory.USE)\n      # Perform the USE action\n      _reward, _done, _obs = env.step(env_factory.USE)\n      # After USE, re-check inventory immediately to see if collected\n      if _obs['features_dict']['inventory'][primitive] > 0:\n        break # Successfully collected\n      # If not collected (e.g., obstacle, non-grabbable), continue to re-evaluate state\n      continue \n\n    # Primitive is not adjacent, so the agent needs to move.\n    # Get the agent's current position (x, y) from the CraftState\n    current_pos = env._current_state.pos \n    agent_x, agent_y = current_pos\n\n    # Find the closest instance of the primitive on the grid\n    target_x, target_y = -1, -1\n    min_dist_sq = float('inf')\n\n    # Get grid dimensions: grid.shape is (WIDTH, HEIGHT, n_kinds)\n    grid_width, grid_height, _ = grid.shape\n\n    for x in range(grid_width):\n      for y in range(grid_height):\n        # Check if the primitive entity is at the current grid cell (x, y)\n        if grid[x, y, primitive] == 1:\n          dist_sq = (x - agent_x)**2 + (y - agent_y)**2\n          if dist_sq < min_dist_sq:\n            min_dist_sq = dist_sq\n            target_x, target_y = x, y\n\n    # If the primitive was not found anywhere on the grid, it's unreachable\n    if target_x == -1:\n      # Return an empty list to indicate failure to collect\n      return [] \n\n    # Calculate the difference between target and agent positions\n    delta_x = target_x - agent_x\n    delta_y = target_y - agent_y\n\n    action_to_take = None\n\n    # Determine the movement action based on the largest absolute difference\n    # This implements a simple greedy pathfinding (Manhattan distance)\n    if abs(delta_x) > abs(delta_y):\n      if delta_x > 0:\n        action_to_take = env_factory.RIGHT\n      else: # delta_x < 0\n        action_to_take = env_factory.LEFT\n    elif abs(delta_y) > 0: # This covers cases where |delta_y| > |delta_x| or |delta_y| == |delta_x| (and delta_y != 0)\n      if delta_y > 0:\n        action_to_take = env_factory.DOWN # Positive Y is typically \"down\" in grid coordinates\n      else: # delta_y < 0\n        action_to_take = env_factory.UP # Negative Y is typically \"up\"\n    else:\n      # This case means delta_x == 0 and delta_y == 0.\n      # The agent is at the target coordinates.\n      # This should ideally have been caught by the `env._current_state.next_to(primitive)` check.\n      # If we reach here, it implies an issue (e.g., primitive is at agent's exact spot but not grabbable).\n      # Break to prevent an infinite loop.\n      break\n\n    # Execute the determined movement action\n    if action_to_take is not None:\n      actions_taken.append(action_to_take)\n      _reward, _done, _ = env.step(action_to_take)\n    else:\n      # Should not be reached if the logic is sound and the primitive exists\n      break\n\n    step_count += 1\n    # Check if the maximum number of steps has been exceeded\n    if step_count >= MAX_COLLECT_STEPS:\n      break # Exit loop if max steps reached\n\n  return actions_taken", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:38:14.173736", "function_name": "collect", "function_body": "    actions = []\n    # Access the current CraftState object from the CraftLab environment\n    state = env._current_state\n\n    # 1. Check if the primitive is already in the inventory\n    if state.inventory[primitive] > 0:\n        return []\n\n    grid = state.grid\n    start_pos = state.pos\n    grid_width, grid_height, _ = grid.shape\n\n    # 2. BFS to find the shortest path to the primitive\n    # BFS queue stores (current_position_tuple, path_of_coordinate_tuples)\n    # The path_of_coordinate_tuples records all intermediate positions *excluding* the start_pos\n    queue = collections.deque([(start_pos, [])])\n    visited_coords = {start_pos}\n\n    target_path_coords = None\n\n    while queue:\n        (curr_x, curr_y), path_coords = queue.popleft()\n\n        # If the current cell contains the primitive, we found our target\n        if grid[curr_x, curr_y, primitive] > 0:\n            target_path_coords = path_coords\n            break\n\n        # Define 4-directional neighbors (dx, dy)\n        # For simplicity, using values directly for UP/DOWN/LEFT/RIGHT movements\n        for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]: # (North, South, West, East)\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_pos = (next_x, next_y)\n\n            # Check bounds and if already visited\n            if 0 <= next_x < grid_width and 0 <= next_y < grid_height and next_pos not in visited_coords:\n                visited_coords.add(next_pos)\n                # Add the next position to the path\n                new_path = path_coords + [next_pos]\n                queue.append((next_pos, new_path))\n    \n    # If no path to the primitive was found\n    if target_path_coords is None:\n        return []\n\n    # 3. Convert the coordinate path into agent actions (turns and moves)\n    current_agent_pos = start_pos\n    current_agent_dir = state.dir # Initial direction of the agent (0:N, 1:E, 2:S, 3:W)\n\n    # Mapping of (dx, dy) to the target direction the agent needs to face to move there\n    # Agent direction: 0: North (Y-), 1: East (X+), 2: South (Y+), 3: West (X-)\n    MOVE_TO_TARGET_DIR = {\n        (0, -1): 0,  # Moving North requires facing North (0)\n        (0, 1): 2,   # Moving South requires facing South (2)\n        (-1, 0): 3,  # Moving West requires facing West (3)\n        (1, 0): 1    # Moving East requires facing East (1)\n    }\n    # Map agent's facing direction to the action that moves it forward\n    DIR_TO_MOVE_ACTION = {\n        0: UP,    # Facing North, UP moves North\n        1: RIGHT, # Facing East, RIGHT moves East\n        2: DOWN,  # Facing South, DOWN moves South\n        3: LEFT   # Facing West, LEFT moves West\n    }\n\n    for next_coord in target_path_coords:\n        nx, ny = next_coord\n        cx, cy = current_agent_pos\n\n        # Calculate relative movement (dx, dy) for this step\n        dx, dy = nx - cx, ny - cy\n\n        # Determine the direction the agent needs to face for this move\n        target_dir = MOVE_TO_TARGET_DIR.get((dx, dy))\n        if target_dir is None:\n            # This should ideally not happen if pathfinding is correct (only orthogonal moves)\n            return [] \n\n        # Turn the agent until it faces the target direction\n        while current_agent_dir != target_dir:\n            # Calculate difference to determine shortest turn (clockwise or counter-clockwise)\n            diff = (target_dir - current_agent_dir + 4) % 4\n            if diff == 1: # Target is clockwise (e.g., N->E, current 0, target 1, diff 1)\n                actions.append(RIGHT)\n                current_agent_dir = (current_agent_dir + 1) % 4\n            elif diff == 3: # Target is counter-clockwise (e.g., N->W, current 0, target 3, diff 3)\n                actions.append(LEFT)\n                current_agent_dir = (current_agent_dir - 1 + 4) % 4\n            else: # diff == 2 (180 degree turn, e.g., N->S). Prefer turning RIGHT twice.\n                actions.append(RIGHT)\n                current_agent_dir = (current_agent_dir + 1) % 4\n        \n        # Once facing the correct direction, move forward\n        actions.append(DIR_TO_MOVE_ACTION[current_agent_dir])\n        current_agent_pos = next_coord # Update agent's conceptual position\n\n    # 4. After reaching the target cell, attempt to 'USE' the item if it's grabbable\n    # The world object is available via state.world\n    if primitive in state.world.grabbable_indices:\n        actions.append(USE)\n    \n    return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:40:11.430329", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants (assuming values from env_factory.ACTIONS)\n    # These map to the integer actions expected by CraftLab.step\n    DOWN_ACTION = 0\n    UP_ACTION = 1\n    LEFT_ACTION = 2\n    RIGHT_ACTION = 3\n    USE_ACTION = 4\n\n    # Direction to (dx, dy) mapping for movement.\n    # CraftState.dir attribute uses these integer values for direction:\n    # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n    DIR_TO_DELTA = {\n        0: (0, 1),   # DOWN (change in x, change in y)\n        1: (0, -1),  # UP\n        2: (-1, 0),  # LEFT\n        3: (1, 0)    # RIGHT\n    }\n    # (dx, dy) to direction mapping for convenience\n    DELTA_TO_DIR = {v: k for k, v in DIR_TO_DELTA.items()}\n\n    # Mapping direction index (CraftState.dir) to the action that moves\n    # the agent forward in that direction\n    DIR_TO_MOVE_ACTION = {\n        0: DOWN_ACTION,\n        1: UP_ACTION,\n        2: LEFT_ACTION,\n        3: RIGHT_ACTION\n    }\n\n    def _find_path_to_adjacent(start_pos, start_grid, target_kind_idx, world):\n        \"\"\"\n        Finds the shortest path from start_pos to a cell adjacent to target_kind_idx.\n        Returns a list of (x, y) positions, including start_pos and the adjacent cell,\n        or None if no path.\n        \"\"\"\n        q = collections.deque([(start_pos, [])]) # Queue stores (current_pos, path_so_far)\n        visited = {start_pos} # Set of visited positions to avoid cycles and redundant checks\n\n        grid_width, grid_height, _ = start_grid.shape\n\n        # Helper to check if a cell is traversable\n        def is_traversable(x, y):\n            # Check bounds\n            if not (0 <= x < grid_width and 0 <= y < grid_height):\n                return False\n            # A cell is considered blocked if it contains water or stone\n            # Indices for water and stone are retrieved from the world object\n            if start_grid[x, y, world.water_index] > 0 or \\\n               start_grid[x, y, world.stone_index] > 0:\n                return False\n            return True\n\n        while q:\n            curr_pos, path_so_far = q.popleft()\n\n            # Check if the current position is adjacent to the target primitive\n            # If so, this path leads to a position from which the agent can USE the item.\n            for dx, dy in DIR_TO_DELTA.values(): # Iterate over possible neighbor offsets\n                adj_x, adj_y = curr_pos[0] + dx, curr_pos[1] + dy\n                # Check bounds for the adjacent cell\n                if 0 <= adj_x < grid_width and 0 <= adj_y < grid_height:\n                    # If the adjacent cell contains the target primitive\n                    if start_grid[adj_x, adj_y, target_kind_idx] > 0:\n                        # Path found: it includes the current position which is adjacent to the target\n                        return path_so_far + [curr_pos]\n\n            # Explore traversable neighbors of the current position\n            for dx, dy in DIR_TO_DELTA.values():\n                next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n                next_pos = (next_x, next_y)\n\n                if is_traversable(next_x, next_y) and next_pos not in visited:\n                    visited.add(next_pos)\n                    q.append((next_pos, path_so_far + [curr_pos]))\n\n        return None # No path found to any cell adjacent to the target primitive\n\n    def _path_to_actions(path, start_dir):\n        \"\"\"\n        Converts a sequence of (x, y) positions (a path) into a list of CraftLab\n        movement actions (UP, DOWN, LEFT, RIGHT, and turns).\n        Returns a tuple: (list_of_actions, final_position_reached, final_direction_after_moves).\n        \"\"\"\n        actions = []\n        current_dir = start_dir # Agent's starting direction\n\n        if not path:\n            return [], None, None # Should not happen if a path was found\n\n        current_pos = path[0] # Agent's starting position\n\n        # Iterate through the path, generating actions for each segment\n        for next_pos in path[1:]: # Path[0] is start_pos, path[1:] are subsequent steps\n            dx = next_pos[0] - current_pos[0]\n            dy = next_pos[1] - current_pos[1]\n\n            # Determine the required direction to move to the next position\n            target_dir_to_move = DELTA_TO_DIR.get((dx, dy))\n            if target_dir_to_move is None:\n                # This indicates an invalid path segment (e.g., diagonal move)\n                return [], None, None # Or raise an error, depending on desired robustness\n            \n            # Calculate the angular difference to determine turning actions\n            # (current_dir + delta_dir) % 4 == target_dir_to_move\n            delta_dir = (target_dir_to_move - current_dir + 4) % 4\n            \n            if delta_dir == 1: # 90 degrees clockwise turn (e.g., from UP to RIGHT)\n                actions.append(RIGHT_ACTION)\n            elif delta_dir == 2: # 180 degrees turn (e.g., from UP to DOWN)\n                actions.extend([RIGHT_ACTION, RIGHT_ACTION]) # Two right turns\n            elif delta_dir == 3: # 90 degrees counter-clockwise turn (e.g., from UP to LEFT)\n                actions.append(LEFT_ACTION)\n            \n            # Agent is now facing the correct direction\n            current_dir = target_dir_to_move\n\n            # Add the movement action corresponding to the current direction\n            actions.append(DIR_TO_MOVE_ACTION[current_dir])\n            current_pos = next_pos # Update current position\n\n        return actions, current_pos, current_dir\n\n    # --- Main collect_v2 function logic ---\n\n    state = env._current_state\n    world = env.world\n    \n    # 1. Check if the primitive is already in the agent's inventory\n    if state.inventory[primitive] > 0:\n        return [] # No actions needed if already collected\n\n    # 2. Find the shortest path from the agent's current position to any cell\n    #    that is adjacent to the target primitive.\n    path_to_adj = _find_path_to_adjacent(state.pos, state.grid, primitive, world)\n\n    if path_to_adj is None:\n        return [] # If no path is found, the primitive is unreachable\n\n    # 3. Convert the found path into a sequence of movement actions.\n    #    This also returns the agent's final position and direction after these moves.\n    movement_actions, final_pos, final_dir = _path_to_actions(path_to_adj, state.dir)\n    \n    # Initialize the list of all actions to perform\n    all_actions = list(movement_actions)\n\n    # 4. After reaching the adjacent cell (final_pos), determine how to face the primitive\n    #    and then use the USE action to collect it.\n    \n    # First, find the exact position of the primitive relative to the final_pos\n    primitive_pos = None\n    for dx, dy in DIR_TO_DELTA.values():\n        adj_x, adj_y = final_pos[0] + dx, final_pos[1] + dy\n        # Check bounds for the neighbor cell\n        if 0 <= adj_x < state.grid.shape[0] and 0 <= adj_y < state.grid.shape[1]:\n            # If this neighbor cell contains the primitive\n            if state.grid[adj_x, adj_y, primitive] > 0:\n                primitive_pos = (adj_x, adj_y)\n                break # Found the primitive's location\n\n    # This should ideally always be found if _find_path_to_adjacent worked correctly\n    if primitive_pos is None:\n        return [] # Fallback for unexpected scenario\n\n    # Calculate the vector from agent's final_pos to the primitive's position\n    dx_to_primitive = primitive_pos[0] - final_pos[0]\n    dy_to_primitive = primitive_pos[1] - final_pos[1]\n    \n    # Determine the target direction the agent needs to face to look at the primitive\n    target_dir_for_use = DELTA_TO_DIR.get((dx_to_primitive, dy_to_primitive))\n    \n    if target_dir_for_use is None:\n        # Should not happen as primitive_pos is an immediate orthogonal neighbor\n        return []\n\n    # Calculate the turns needed to face the primitive\n    delta_dir_for_use = (target_dir_for_use - final_dir + 4) % 4\n    if delta_dir_for_use == 1:\n        all_actions.append(RIGHT_ACTION)\n    elif delta_dir_for_use == 2:\n        all_actions.extend([RIGHT_ACTION, RIGHT_ACTION])\n    elif delta_dir_for_use == 3:\n        all_actions.append(LEFT_ACTION)\n    \n    # Finally, add the USE action to collect the primitive\n    all_actions.append(USE_ACTION)\n\n    return all_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:40:11.504484", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n    import env_factory # Assuming env_factory is available in the execution environment\n\n    # Constants for actions from env_factory.actions\n    # Assuming DMLab-style directions: 0=N, 1=E, 2=S, 3=W (clockwise)\n\n    # Map from agent's direction (0=N, 1=E, 2=S, 3=W) to (dx, dy) of cell in front\n    _DIR_TO_FRONT_DELTA = {\n        0: (0, -1),  # North: y decreases\n        1: (1, 0),   # East: x increases\n        2: (0, 1),   # South: y increases\n        3: (-1, 0)   # West: x decreases\n    }\n\n    # Map from (dx, dy) relative vector to a cardinal direction (0-3) for facing\n    _DELTA_TO_DIR = {v: k for k, v in _DIR_TO_FRONT_DELTA.items()}\n\n    # Map from (dx, dy) to action for moving to a next cell\n    _MOVE_DELTAS_TO_ACTION = {\n        (0, -1): env_factory.actions.UP,\n        (0, 1): env_factory.actions.DOWN,\n        (-1, 0): env_factory.actions.LEFT,\n        (1, 0): env_factory.actions.RIGHT,\n    }\n\n\n    def _get_turn_actions(current_dir, target_dir):\n        \"\"\"\n        Returns a list of actions (LEFT/RIGHT) to turn from current_dir to target_dir.\n        Assumes 0=N, 1=E, 2=S, 3=W (clockwise).\n        \"\"\"\n        actions = []\n        diff = (target_dir - current_dir + 4) % 4\n        if diff == 1: # Current direction is 1 step CCW from target (needs RIGHT)\n            actions.append(env_factory.actions.RIGHT)\n        elif diff == 2: # Current direction is opposite (needs two RIGHTs or two LEFTs)\n            actions.append(env_factory.actions.RIGHT)\n            actions.append(env_factory.actions.RIGHT)\n        elif diff == 3: # Current direction is 1 step CW from target (needs LEFT)\n            actions.append(env_factory.actions.LEFT)\n        return actions\n\n\n    def _is_passable_for_agent(x, y, grid, world_obj, agent_index_id):\n        \"\"\"\n        Checks if a cell (x, y) is passable for the agent to move into.\n        A cell is passable if it's within bounds and does not contain blocking entities.\n        \"\"\"\n        HEIGHT, WIDTH, N_KINDS = grid.shape\n        if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n            return False  # Out of bounds\n\n        # Check if the cell contains any blocking item\n        for k in range(N_KINDS):\n            if grid[y, x, k] > 0:  # Something is present at this layer\n                if k == agent_index_id:\n                    # The agent itself is at this position, it's always passable for the agent\n                    continue\n                if k in world_obj.non_grabbable_indices:\n                    return False  # Walls, water, etc., are blocking\n                if k in world_obj.primitives:\n                    return False  # Other primitive items are blocking movement\n                # Workshop indices are typically traversable; skip checking them as blockers\n                if k in world_obj.workshop_indices:\n                    continue\n                # If it's any other kind of object and it's not a workshop or agent, it's blocking\n                return False\n        return True  # Cell is empty or contains only traversable items (workshops)\n\n\n    current_state = env._current_state\n    grid = current_state.grid\n    start_pos = current_state.pos  # (x, y)\n    start_dir = current_state.dir\n    world = current_state.world\n    primitive_idx = primitive\n\n    # 1. Check if primitive is already in inventory\n    if current_state.inventory[primitive_idx] > 0:\n        return []\n\n    HEIGHT, WIDTH, _ = grid.shape\n    agent_index_id = world.index.index(\"agent\") # Get index for agent entity\n\n    # 2. Find all locations of the target primitive on the grid\n    # np.argwhere returns (row, col) which is (y, x)\n    primitive_locations_yx = np.argwhere(grid[:, :, primitive_idx] > 0)\n    if len(primitive_locations_yx) == 0:\n        return [] # No primitive found on the map\n\n    # 3. BFS setup for pathfinding\n    # Queue stores (x, y, current_facing_direction, list_of_actions_taken)\n    queue = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n    # Visited set stores (x, y, direction) to avoid cycles and redundant paths\n    visited = set([(start_pos[0], start_pos[1], start_dir)])\n\n    best_path = None\n    min_path_len = float('inf')\n\n    # 4. BFS loop\n    while queue:\n        curr_x, curr_y, curr_dir, path = queue.popleft()\n\n        # Check if the current position (curr_x, curr_y) is adjacent to any primitive\n        for p_loc_y, p_loc_x in primitive_locations_yx:\n            # Iterate through 4 neighbors of the primitive to find an adjacent cell\n            for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (L, R, U, D) deltas\n                adj_x, adj_y = p_loc_x + dx_adj, p_loc_y + dy_adj\n                \n                if curr_x == adj_x and curr_y == adj_y:\n                    # Agent is currently at a cell adjacent to the primitive at (p_loc_x, p_loc_y)\n                    # Calculate direction the agent needs to face to look at the primitive\n                    delta_to_primitive_x = p_loc_x - curr_x\n                    delta_to_primitive_y = p_loc_y - curr_y\n                    \n                    target_face_dir = _DELTA_TO_DIR.get((delta_to_primitive_x, delta_to_primitive_y))\n                    \n                    if target_face_dir is not None:\n                        turn_actions = _get_turn_actions(curr_dir, target_face_dir)\n                        final_path = path + turn_actions + [env_factory.actions.USE]\n                        \n                        # Update best path if this one is shorter\n                        if len(final_path) < min_path_len:\n                            min_path_len = len(final_path)\n                            best_path = final_path\n                            # Since BFS guarantees shortest path to a state, and we are looking for the shortest\n                            # path to *any* (adjacent_cell, correct_facing_dir, USE) combination,\n                            # we continue until the queue is exhausted to ensure global optimality.\n\n        # Explore possible next states (move or turn actions)\n        # 1. Movement actions (UP, DOWN, LEFT, RIGHT)\n        for move_action, (dx, dy) in _MOVE_DELTAS_TO_ACTION.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_dir = curr_dir  # Direction does not change on simple movement\n\n            if _is_passable_for_agent(next_x, next_y, grid, world, agent_index_id) and \\\n               (next_x, next_y, next_dir) not in visited:\n                \n                visited.add((next_x, next_y, next_dir))\n                queue.append((next_x, next_y, next_dir, path + [move_action]))\n\n        # 2. Turn actions (LEFT, RIGHT)\n        for turn_action in [env_factory.actions.LEFT, env_factory.actions.RIGHT]:\n            next_x, next_y = curr_x, curr_y  # Position remains same on turn\n            \n            if turn_action == env_factory.actions.LEFT:\n                next_dir = (curr_dir - 1 + 4) % 4\n            else:  # env_factory.actions.RIGHT\n                next_dir = (curr_dir + 1) % 4\n\n            if (next_x, next_y, next_dir) not in visited:\n                visited.add((next_x, next_y, next_dir))\n                queue.append((next_x, next_y, next_dir, path + [turn_action]))\n\n    return best_path if best_path is not None else []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:41:41.428850", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants as defined by CraftLab action_specs\n    ACTION_DOWN = 0  # Move backward relative to current direction\n    ACTION_UP = 1    # Move forward relative to current direction\n    ACTION_LEFT = 2  # Turn left (counter-clockwise)\n    ACTION_RIGHT = 3 # Turn right (clockwise)\n    ACTION_USE = 4   # Use item in front of agent\n\n    # Direction mappings (dx, dy) for East, South, West, North (0, 1, 2, 3)\n    # dx, dy represent change in (x, y) when facing that direction and moving forward.\n    # Corresponds to CraftState.dir attribute values.\n    DIRECTIONS_DELTAS = {\n        0: (1, 0),   # East (x+1, y)\n        1: (0, 1),   # South (x, y+1)\n        2: (-1, 0),  # West (x-1, y)\n        3: (0, -1)   # North (x, y-1)\n    }\n\n    current_state = env._current_state\n    \n    # Get the integer index for the desired primitive\n    primitive_idx = env.world.cookbook.index(primitive)\n\n    # 1. Check if the primitive is already in the inventory\n    if current_state.inventory[primitive_idx] > 0:\n        return []\n\n    # 2. BFS setup\n    start_pos = current_state.pos\n    start_dir = current_state.dir\n    grid = current_state.grid\n    WIDTH, HEIGHT, _ = grid.shape\n    \n    # Get indices of non-grabbable items that act as obstacles\n    non_grabbable_obstacles = env.world.non_grabbable_indices\n\n    # Queue stores tuples of ((current_x, current_y), current_dir), list_of_actions\n    # The state in the queue includes position and direction, as both affect possible future actions.\n    queue = collections.deque([((start_pos, start_dir), [])])\n    \n    # Visited set stores ((x, y), dir) tuples to avoid re-exploring states\n    visited = set([(start_pos, start_dir)])\n\n    while queue:\n        ((current_x, current_y), current_dir), current_path = queue.popleft()\n\n        # Check if we can USE the primitive from the current state (position and direction)\n        # Calculate the cell directly in front of the agent\n        facing_dx, facing_dy = DIRECTIONS_DELTAS[current_dir]\n        target_x, target_y = current_x + facing_dx, current_y + facing_dy\n\n        # Check bounds for the target cell\n        if 0 <= target_x < WIDTH and 0 <= target_y < HEIGHT:\n            # Check if the target cell contains the primitive\n            # Note: grid indexing is (row, column), so (y, x)\n            if grid[target_y, target_x, primitive_idx] > 0:\n                # Agent is in a position and facing the primitive. Add USE action and return path.\n                return current_path + [ACTION_USE]\n\n        # Explore possible next states by applying valid actions:\n\n        # 1. Action: MOVE_UP (Move Forward)\n        next_x_fwd, next_y_fwd = current_x + facing_dx, current_y + facing_dy\n        next_pos_fwd = (next_x_fwd, next_y_fwd)\n        next_dir_fwd = current_dir # Direction does not change on movement\n        \n        if 0 <= next_x_fwd < WIDTH and 0 <= next_y_fwd < HEIGHT and (next_pos_fwd, next_dir_fwd) not in visited:\n            # Check if the next cell is blocked by any non-grabbable obstacles\n            is_blocked = False\n            for obstacle_idx in non_grabbable_obstacles:\n                if grid[next_y_fwd, next_x_fwd, obstacle_idx] > 0:\n                    is_blocked = True\n                    break\n            if not is_blocked:\n                visited.add((next_pos_fwd, next_dir_fwd))\n                queue.append(((next_pos_fwd, next_dir_fwd), current_path + [ACTION_UP]))\n\n        # 2. Action: MOVE_DOWN (Move Backward)\n        next_x_bwd, next_y_bwd = current_x - facing_dx, current_y - facing_dy\n        next_pos_bwd = (next_x_bwd, next_y_bwd)\n        next_dir_bwd = current_dir\n        \n        if 0 <= next_x_bwd < WIDTH and 0 <= next_y_bwd < HEIGHT and (next_pos_bwd, next_dir_bwd) not in visited:\n            is_blocked = False\n            for obstacle_idx in non_grabbable_obstacles:\n                if grid[next_y_bwd, next_x_bwd, obstacle_idx] > 0:\n                    is_blocked = True\n                    break\n            if not is_blocked:\n                visited.add((next_pos_bwd, next_dir_bwd))\n                queue.append(((next_pos_bwd, next_dir_bwd), current_path + [ACTION_DOWN]))\n\n        # 3. Action: TURN_LEFT (Turn Counter-Clockwise)\n        # Position remains the same, only direction changes\n        next_dir_left = (current_dir - 1 + 4) % 4 # Ensure direction stays within 0-3\n        if ((current_x, current_y), next_dir_left) not in visited:\n            visited.add(((current_x, current_y), next_dir_left))\n            queue.append((((current_x, current_y), next_dir_left), current_path + [ACTION_LEFT]))\n\n        # 4. Action: TURN_RIGHT (Turn Clockwise)\n        # Position remains the same, only direction changes\n        next_dir_right = (current_dir + 1) % 4\n        if ((current_x, current_y), next_dir_right) not in visited:\n            visited.add(((current_x, current_y), next_dir_right))\n            queue.append((((current_x, current_y), next_dir_right), current_path + [ACTION_RIGHT]))\n\n    # If the queue becomes empty and no path to collect the primitive is found,\n    # return an empty list of actions.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:41:41.499011", "function_name": "collect", "function_body": "    actions = []\n\n    # Get action mappings from the environment\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    # Get the current state for planning purposes.\n    # We access the internal _current_state of CraftLab for planning,\n    # as we need to simulate moves without altering the actual environment state yet.\n    current_sim_state = env._current_state\n\n    # If the primitive is already in inventory, no actions are needed.\n    if current_sim_state.inventory[primitive] > 0:\n        return []\n\n    # Maximum steps for planning to prevent infinite loops in case of unreachable items.\n    max_planning_steps = 256 # A reasonable limit for grid pathfinding\n    steps_taken_in_plan = 0\n\n    # Continue moving until the agent is next to the primitive or planning steps are exhausted.\n    while not current_sim_state.next_to(primitive) and steps_taken_in_plan < max_planning_steps:\n        steps_taken_in_plan += 1\n\n        # Find the primitive's current position on the simulated grid.\n        # This needs to be done in each iteration because the primitive's position\n        # might change relative to the agent as the agent moves, or if the primitive\n        # itself can be moved (though unlikely for a \"primitive\").\n        primitive_found_on_grid = False\n        px, py = -1, -1\n        \n        # Grid shape is (WIDTH, HEIGHT, n_kinds) as per the class definition.\n        grid_width, grid_height, _ = current_sim_state.grid.shape\n\n        for x in range(grid_width):\n            for y in range(grid_height):\n                # Check if the current cell contains the primitive kind\n                if current_sim_state.grid[x, y, primitive] > 0:\n                    px, py = x, y\n                    primitive_found_on_grid = True\n                    break\n            if primitive_found_on_grid:\n                break\n\n        # If the primitive is not found on the grid, it's unreachable for this function.\n        if not primitive_found_on_grid:\n            return [] # Cannot collect if not on the map\n\n        # Agent's current position (ax, ay)\n        ax, ay = current_sim_state.pos\n\n        # Calculate differences in coordinates\n        dist_x = px - ax\n        dist_y = py - ay\n\n        best_action_for_move = -1\n\n        # Simple greedy pathfinding: prioritize moving along the dimension with the larger absolute difference.\n        # This can be suboptimal (e.g., in mazes) but works for open grids.\n        if abs(dist_x) > abs(dist_y):\n            # Move horizontally\n            if dist_x > 0:\n                best_action_for_move = RIGHT\n            else: # dist_x < 0\n                best_action_for_move = LEFT\n        else: # abs(dist_y) >= abs(dist_x)\n            # Move vertically (or if distances are equal)\n            if dist_y > 0:\n                best_action_for_move = DOWN\n            else: # dist_y < 0\n                best_action_for_move = UP\n        \n        # Add the chosen movement action to the list\n        if best_action_for_move != -1:\n            actions.append(best_action_for_move)\n            \n            # Simulate the step using the CraftState's step method.\n            # This updates the `current_sim_state` to the next state,\n            # allowing the pathfinding logic to continue from the new position.\n            # CraftState.step returns (reward, new_state). We only need new_state here.\n            _, current_sim_state = current_sim_state.step(best_action_for_move)\n        else:\n            # This case should ideally not be reached with the current greedy logic unless\n            # the agent is already at the primitive's location and no movement is necessary.\n            # But the 'while' loop condition `not next_to` handles that.\n            # If for some reason a move cannot be determined, break to prevent infinite loop.\n            break\n\n    # After the loop, check if the agent is indeed next to the primitive.\n    # If it is, append the 'USE' action.\n    if current_sim_state.next_to(primitive):\n        actions.append(USE)\n    else:\n        # If max_planning_steps were reached and we are not next to the primitive,\n        # it means the primitive is unreachable within the allowed planning steps.\n        return []\n\n    return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:43:05.825586", "function_name": "collect", "function_body": "", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:43:05.894743", "function_name": "collect", "function_body": "    current_state = env._current_state\n    grid = current_state.grid\n    start_pos = current_state.pos\n    world = env.world # Reference to the CraftWorld instance for configuration\n\n    grid_width, grid_height, _ = grid.shape\n\n    # Get action mappings from the environment's action specifications\n    action_map_names = env.action_specs()\n    ACTION_DOWN = action_map_names['DOWN']\n    ACTION_UP = action_map_names['UP']\n    ACTION_LEFT = action_map_names['LEFT']\n    ACTION_RIGHT = action_map_names['RIGHT']\n    ACTION_USE = action_map_names['USE']\n\n    # Define movement deltas for each directional action (dx, dy)\n    # dx: change in x (column), dy: change in y (row)\n    MOVE_DELTAS = {\n        ACTION_DOWN: (0, 1),\n        ACTION_UP: (0, -1),\n        ACTION_LEFT: (-1, 0),\n        ACTION_RIGHT: (1, 0),\n    }\n\n    # Identify all (x, y) coordinates where the primitive is located on the grid\n    primitive_positions = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if grid[x, y, primitive] == 1.0:\n                primitive_positions.append((x, y))\n\n    # If the primitive is not found anywhere on the map, no actions can collect it\n    if not primitive_positions:\n        return []\n\n    # Determine all possible target positions: empty cells directly adjacent (4-directional)\n    # to any instance of the primitive. The agent needs to reach one of these cells\n    # before performing the USE action.\n    target_adjacent_positions = set()\n    for px, py in primitive_positions:\n        # Check 4-directional neighbors: (dx, dy) = (-1,0), (1,0), (0,-1), (0,1)\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = px + dx, py + dy\n\n            # Check if the neighbor cell is within grid boundaries\n            if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                # A valid target adjacent cell must *not* contain the primitive itself\n                # and must be traversable (e.g., not an obstacle like water).\n                # We assume a cell is traversable if it's not water.\n                # The condition `grid[nx, ny, primitive] == 0.0` ensures we target an empty spot next to it, not on it.\n                if grid[nx, ny, primitive] == 0.0:\n                    target_adjacent_positions.add((nx, ny))\n    \n    # If no valid adjacent positions can be found (e.g., primitive is surrounded by unmovable objects\n    # or other primitives), return an empty list of actions.\n    if not target_adjacent_positions:\n        return []\n\n    # Perform a Breadth-First Search (BFS) to find the shortest path from the agent's\n    # starting position to any of the target_adjacent_positions.\n    queue = collections.deque([(start_pos, [])]) # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n    visited = {start_pos} # Set of visited positions to avoid cycles and redundant paths\n\n    water_index = world.water_index # Get the index for \"water\" which is assumed to be an impassable obstacle\n\n    while queue:\n        current_pos, path = queue.popleft()\n\n        # If the current position is one of our target adjacent positions,\n        # we have found the shortest path. Append the 'USE' action and return.\n        if current_pos in target_adjacent_positions:\n            return path + [ACTION_USE]\n\n        # Explore all possible next moves (UP, DOWN, LEFT, RIGHT)\n        for action, (dx, dy) in MOVE_DELTAS.items():\n            next_pos = (current_pos[0] + dx, current_pos[1] + dy)\n\n            # Check if the next position is within grid bounds\n            if 0 <= next_pos[0] < grid_width and 0 <= next_pos[1] < grid_height:\n                # Check if the next position has not been visited yet\n                if next_pos not in visited:\n                    # Check traversability: The cell must not contain water\n                    if grid[next_pos[0], next_pos[1], water_index] == 0.0:\n                        visited.add(next_pos)\n                        queue.append((next_pos, path + [action]))\n\n    # If the BFS queue becomes empty and no path to a target_adjacent_position was found,\n    # it means the primitive is unreachable.\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:44:27.885660", "function_name": "collect", "function_body": "    obs = env.observations()\n    features_dict = obs['features_dict']\n    # 'features_global' is the full grid, shape (height, width, n_kinds)\n    grid = features_dict['features_global']\n    # 'pos' is (x, y) coordinates of the agent (column, row)\n    current_x, current_y = features_dict['pos']\n    # Convert agent's (x, y) to grid's (row, col) for indexing\n    current_pos_grid_coords = (int(current_y), int(current_x))\n    inventory = features_dict['inventory']\n\n    # Check if the primitive is already in inventory\n    if inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    grid_height, grid_width, _ = grid.shape\n\n    # 1. Find all locations (row, col) of the primitive on the grid\n    primitive_locations_grid_coords = [] # List of (row, col) tuples\n    for r in range(grid_height):\n        for c in range(grid_width):\n            if grid[r, c, primitive] > 0:\n                primitive_locations_grid_coords.append((r, c))\n\n    if not primitive_locations_grid_coords:\n        return [] # Primitive not found anywhere on the grid\n\n    # 2. Determine target reachable positions (row, col) for the agent\n    # The `CraftState.next_to` function checks a 3x3 neighborhood around the agent's position.\n    # So, the agent needs to move to any cell (target_r, target_c) such that there's a primitive\n    # at (primitive_r, primitive_c) where |target_r - primitive_r| <= 1 and |target_c - primitive_c| <= 1.\n    target_agent_positions_grid_coords = set() # Set of (row, col) tuples\n    for prim_r, prim_c in primitive_locations_grid_coords:\n        for dr in [-1, 0, 1]:\n            for dc in [-1, 0, 1]:\n                target_r, target_c = prim_r + dr, prim_c + dc\n                if 0 <= target_r < grid_height and 0 <= target_c < grid_width:\n                    target_agent_positions_grid_coords.add((target_r, target_c))\n    \n    # 3. Breadth-First Search (BFS) to find the shortest path\n    # Queue stores: ((current_row, current_col), list_of_actions_to_reach_here)\n    q = [(current_pos_grid_coords, [])]\n    visited = {current_pos_grid_coords}\n    \n    # Define movement offsets (dy, dx) and their corresponding action integers\n    # UP: (y-1, x) -> (-1, 0)\n    # DOWN: (y+1, x) -> (1, 0)\n    # LEFT: (y, x-1) -> (0, -1)\n    # RIGHT: (y, x+1) -> (0, 1)\n    # Actions: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    movement_offsets = {\n        (-1, 0): 1,    # UP\n        (1, 0): 0,     # DOWN\n        (0, -1): 2,    # LEFT\n        (0, 1): 3,     # RIGHT\n    }\n\n    best_path_actions = None\n    USE_ACTION = 4 # The action for 'USE'\n\n    while q:\n        (current_r, current_c), path_actions = q.pop(0)\n\n        # If the current position is one of the target reachable positions\n        if (current_r, current_c) in target_agent_positions_grid_coords:\n            # We found a path to a position from which we can collect the primitive.\n            # Append the USE action and break, as BFS guarantees the shortest path.\n            best_path_actions = path_actions + [USE_ACTION]\n            break\n\n        # Explore neighbors\n        for (dr, dc), action in movement_offsets.items():\n            next_r, next_c = current_r + dr, current_c + dc\n            \n            # Check boundaries and if the cell has already been visited\n            if 0 <= next_r < grid_height and 0 <= next_c < grid_width and (next_r, next_c) not in visited:\n                visited.add((next_r, next_c))\n                q.append(((next_r, next_c), path_actions + [action]))\n\n    return best_path_actions if best_path_actions is not None else []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:44:28.903785", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:45:55.033856", "function_name": "collect", "function_body": "    # Retrieve current state information from the CraftLab environment\n    state = env._current_state\n    inventory = state.inventory\n    current_pos = state.pos\n    grid = state.grid\n    width, height, n_kinds = grid.shape\n    non_grabbable_indices = state.world.non_grabbable_indices\n\n    # Define action mappings (assuming these are standard for CraftWorld)\n    ACTIONS = {\n        \"DOWN\": 0, \"UP\": 1, \"LEFT\": 2, \"RIGHT\": 3, \"USE\": 4,\n    }\n    ACTIONS_MOVE = [ACTIONS[\"DOWN\"], ACTIONS[\"UP\"], ACTIONS[\"LEFT\"], ACTIONS[\"RIGHT\"]]\n    DELTAS = {\n        ACTIONS[\"DOWN\"]: (0, 1),  # (dx, dy) for movement\n        ACTIONS[\"UP\"]: (0, -1),\n        ACTIONS[\"LEFT\"]: (-1, 0),\n        ACTIONS[\"RIGHT\"]: (1, 0)\n    }\n\n    # 1. Initial check: If the primitive is already in the inventory, we're done.\n    if inventory[primitive] > 0:\n        return []\n\n    # 2. Pathfinding using Breadth-First Search (BFS) to find the shortest sequence of actions.\n    #    Queue stores tuples: (list_of_actions_taken, current_x, current_y)\n    #    Using a list as a queue (pop(0) for FIFO) to avoid external imports.\n    queue = [([], current_pos[0], current_pos[1])]\n    \n    # Set to keep track of visited (x, y) coordinates to avoid cycles and redundant paths.\n    visited = {(current_pos[0], current_pos[1])}\n\n    while queue:\n        path, x, y = queue.pop(0)  # Dequeue the oldest item\n\n        # 3. Check if the current simulated agent position (x, y) is adjacent to the primitive.\n        #    This mimics the `CraftState.next_to(primitive)` logic.\n        is_adjacent_to_primitive = False\n        for dx_adj in [-1, 0, 1]:\n            for dy_adj in [-1, 0, 1]:\n                check_px, check_py = x + dx_adj, y + dy_adj\n                # Check grid bounds for the adjacent cell\n                if 0 <= check_px < width and 0 <= check_py < height:\n                    # If the primitive is found in the 3x3 neighborhood\n                    if grid[check_px, check_py, primitive] == 1:\n                        is_adjacent_to_primitive = True\n                        break\n            if is_adjacent_to_primitive:\n                break\n        \n        # If adjacent, we've found a path to be able to use the item.\n        # Append the USE action and return the full path.\n        if is_adjacent_to_primitive:\n            return path + [ACTIONS[\"USE\"]]\n\n        # 4. Explore valid neighboring cells\n        for action in ACTIONS_MOVE:\n            dx, dy = DELTAS[action]\n            next_x, next_y = x + dx, y + dy\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= next_x < width and 0 <= next_y < height):\n                continue\n\n            # Check if the next position is blocked by non-grabbable entities\n            is_blocked = False\n            for k_idx in non_grabbable_indices:\n                if grid[next_x, next_y, k_idx] == 1:\n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue\n\n            # Check if this position has already been visited (or enqueued)\n            if (next_x, next_y) not in visited:\n                visited.add((next_x, next_y))\n                # Enqueue the new path and position\n                queue.append((path + [action], next_x, next_y))\n\n    # 5. If the BFS completes and no path to the primitive was found, return an empty list.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:45:55.104873", "function_name": "collect", "function_body": "    # Define action constants based on CraftLab.action_specs()\n    # Assume these map to 0, 1, 2, 3, 4 respectively\n    DOWN_ACTION = 0\n    UP_ACTION = 1\n    LEFT_ACTION = 2\n    RIGHT_ACTION = 3\n    USE_ACTION = 4\n\n    # Define direction constants based on an arbitrary mapping (e.g., 0=UP, 1=DOWN, 2=LEFT, 3=RIGHT)\n    # This mapping needs to be consistent with how CraftState.dir is interpreted for 'USE'\n    # CraftState.init_dir default is 0, implying 0 is a default direction (e.g., UP).\n    DIR_UP = 0\n    DIR_DOWN = 1\n    DIR_LEFT = 2\n    DIR_RIGHT = 3\n\n    # Map movement actions to (dx, dy, new_direction_value)\n    # (dx, dy) are changes to (x, y) coordinates where x is column, y is row.\n    # UP: y decreases, DOWN: y increases, LEFT: x decreases, RIGHT: x increases\n    # We assume movement actions also set the agent's facing direction to that movement direction.\n    ACTION_TO_DELTADIR = {\n        DOWN_ACTION: (0, 1, DIR_DOWN),\n        UP_ACTION: (0, -1, DIR_UP),\n        LEFT_ACTION: (-1, 0, DIR_LEFT),\n        RIGHT_ACTION: (1, 0, DIR_RIGHT)\n    }\n\n    # Map direction values to their (dx, dy) vector for the 'USE' action\n    # This defines which cell the agent interacts with when 'USE' is pressed.\n    DIR_VECTORS_BY_DIR_VALUE = {\n        DIR_UP: (0, -1),\n        DIR_DOWN: (0, 1),\n        DIR_LEFT: (-1, 0),\n        DIR_RIGHT: (1, 0)\n    }\n\n    # Get current state from the environment\n    current_state = env._current_state\n\n    # 1. Check if the primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # Initialize BFS\n    q = collections.deque()\n    visited = set()\n\n    start_pos = current_state.pos\n    start_dir = current_state.dir # Use current_state.dir as agent might have moved or turned\n\n    # BFS state: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n    q.append(((start_pos, start_dir), []))\n    visited.add((start_pos, start_dir))\n\n    width, height = current_state.grid.shape[:2]\n    world = current_state.world\n    non_grabbable_indices = world.non_grabbable_indices\n\n    while q:\n        (curr_pos, curr_dir), path_so_far = q.popleft()\n        curr_x, curr_y = curr_pos\n\n        # A. Consider applying USE action from current position and direction\n        # The USE action interacts with the cell the agent is currently facing.\n        use_target_dx, use_target_dy = DIR_VECTORS_BY_DIR_VALUE[curr_dir]\n        target_x, target_y = curr_x + use_target_dx, curr_y + use_target_dy\n\n        if 0 <= target_x < width and 0 <= target_y < height:\n            # Check if the primitive is in the cell the agent is facing\n            if current_state.grid[target_x, target_y, primitive] == 1:\n                # Found a path where the primitive can be collected\n                return path_so_far + [USE_ACTION]\n\n        # B. Explore possible movement actions (UP, DOWN, LEFT, RIGHT)\n        for action, (dx, dy, new_dir) in ACTION_TO_DELTADIR.items():\n            new_x, new_y = curr_x + dx, curr_y + dy\n            new_pos = (new_x, new_y)\n            new_state_tuple = (new_pos, new_dir) # State for visited set\n\n            # Check if new position is within bounds\n            if not (0 <= new_x < width and 0 <= new_y < height):\n                continue\n\n            # Check if new position is traversable (not blocked by non-grabbable items)\n            is_blocked = False\n            # Get all kinds present at the new position\n            kinds_at_new_pos = np.where(current_state.grid[new_x, new_y] == 1)[0]\n            \n            for k_idx in kinds_at_new_pos:\n                if k_idx in non_grabbable_indices:\n                    # If any non-grabbable item (like water, workshop, etc.) is\n                    # present at the target cell, the cell is considered blocked for movement.\n                    # Primitives are grabbable, so they wouldn't block movement to their cell.\n                    is_blocked = True\n                    break\n            \n            if is_blocked:\n                continue\n\n            # Add to queue if this (position, direction) state has not been visited\n            if new_state_tuple not in visited:\n                visited.add(new_state_tuple)\n                q.append((new_state_tuple, path_so_far + [action]))\n\n    # If BFS completes and no path was found to collect the primitive\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:47:10.612700", "function_name": "collect", "function_body": "  # Define constants for clarity and reuse within this function's scope.\n  _DIRECTIONS = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  _USE_ACTION = 4\n\n  # 1. Get the integer index for the given primitive name\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 3. Cache frequently accessed world and grid attributes for efficiency\n  world = env.world\n  grid = current_state.grid\n  grid_width, grid_height, n_kinds = grid.shape\n  # Convert non_grabbable_indices to a frozenset for efficient lookups within _is_traversable.\n  # A frozenset is immutable and hashable, making lookups faster than with a regular set.\n  world_non_grabbable_indices_fs = frozenset(world.non_grabbable_indices)\n\n  def _is_traversable(x, y):\n      \"\"\"\n      Checks if a cell (x, y) is traversable.\n      A cell is traversable if it's within bounds and does not contain\n      any non-grabbable item that is NOT the primitive we are trying to collect.\n      \"\"\"\n      # Check boundary conditions first\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False\n      \n      # Iterate through all possible entity kinds that might be present at (x,y).\n      # If any of these kinds are non-grabbable and *not* the target primitive,\n      # then the cell is considered an impassable obstacle.\n      for k_idx in range(n_kinds):\n          if grid[x, y, k_idx] > 0: # Check if this kind (k_idx) is present at (x, y)\n              if k_idx in world_non_grabbable_indices_fs and k_idx != primitive_idx:\n                  return False # Found an impassable obstacle\n      return True # Cell is traversable\n\n  # 4. Pre-compute all grid locations where the target primitive exists.\n  #    This set allows for quick lookups when determining if a 'USE' action\n  #    would be effective from an adjacent cell.\n  target_primitive_locs = set()\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        target_primitive_locs.add((x, y))\n\n  if not target_primitive_locs:\n    # If the primitive is not found anywhere on the map, it's unreachable.\n    return []\n\n  # 5. Perform a Breadth-First Search (BFS) to find the shortest action sequence.\n  #    The BFS state considers both the agent's (x, y) position and its facing direction,\n  #    as the 'USE' action's effect depends on the agent's orientation.\n  start_pos = current_state.pos # Agent's current (x, y) position\n  start_dir = current_state.dir # Agent's current facing direction\n\n  # The queue stores tuples: ((current_x, current_y), current_direction, [list_of_actions_to_reach_here])\n  queue = collections.deque([((start_pos[0], start_pos[1]), start_dir, [])]) \n  \n  # The visited set stores ((x, y), direction) tuples to avoid re-exploring states\n  # and to prevent infinite loops in cycles.\n  visited = {((start_pos[0], start_pos[1]), start_dir)} \n\n  best_path = None # This will store the shortest action sequence found\n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.popleft() # Dequeue the current state for exploration\n\n    # Check if a 'USE' action can be performed from the current state.\n    # The 'USE' action targets the cell directly in front of the agent.\n    dx_facing, dy_facing = _DIRECTIONS[curr_dir]\n    target_x, target_y = curr_x + dx_facing, curr_y + dy_facing\n    \n    # If the cell directly in front contains the desired primitive, a path has been found.\n    # Since BFS explores layer by layer, this path is guaranteed to be the shortest.\n    if (target_x, target_y) in target_primitive_locs:\n        best_path = path_actions\n        break # Exit BFS, as the shortest path is found.\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # Each movement action updates the agent's position and sets its new facing direction.\n    for action, (dx_move, dy_move) in _DIRECTIONS.items():\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = action # Agent's new direction is the direction of its movement\n\n      # Check if the potential next position is traversable and within grid boundaries.\n      if _is_traversable(next_x, next_y):\n        next_state_key = ((next_x, next_y), next_dir)\n        # If this new state (position and direction) has not been visited yet,\n        # add it to the queue for future exploration.\n        if next_state_key not in visited:\n          visited.add(next_state_key) # Mark as visited\n          # Enqueue the new state along with the accumulated path of actions\n          queue.append((next_state_key[0], next_state_key[1], path_actions + [action]))\n\n  if best_path is None:\n    # If the queue becomes empty and no path was found, the primitive is unreachable.\n    return []\n\n  # 6. Append the final 'USE' action to the shortest movement path.\n  #    This completes the sequence to collect the primitive.\n  return best_path + [_USE_ACTION]", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:47:11.623048", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Define constants for actions and their coordinate effects\n  # Actions 0-3 correspond to cardinal movements and also determine facing direction.\n  _ACTION_MAP = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4\n\n  def _is_traversable(grid, x, y, grid_width, grid_height, world_non_grabbable_indices):\n      \"\"\"\n      Checks if a cell (x, y) is traversable.\n      A cell is traversable if it's within bounds and does not contain any\n      non-grabbable item.\n      \n      Assumes that the 'primitive_idx' we are searching for is a grabbable item\n      (checked in the main function), so the agent can move onto a cell\n      containing the primitive itself without it being an obstacle.\n      \"\"\"\n      # 1. Check boundary conditions\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False\n      \n      # 2. Check for impassable obstacles\n      # Iterate only through the known non-grabbable indices for efficiency.\n      for k_idx in world_non_grabbable_indices:\n          if grid[x, y, k_idx] > 0:\n              return False # This cell contains a non-grabbable obstacle\n      return True\n\n  # 1. Get the integer index for the given primitive name\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable. If not, it cannot be collected via USE action.\n  if primitive_idx not in env.world.grabbable_indices:\n    return [] \n\n  # 3. Check if the primitive is already in the agent's inventory.\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 4. Find all grid locations where the primitive exists.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  target_primitive_locs = set() # Store (x, y) coordinates of primitive instances\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        target_primitive_locs.add((x, y))\n\n  if not target_primitive_locs:\n    return [] # Primitive not found anywhere on the map.\n\n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path.\n  # The state in our BFS includes position and direction, as 'USE' is direction-dependent.\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  # Queue for BFS: stores tuples of ((current_x, current_y), current_direction, [list_of_actions_taken_to_reach_here])\n  queue = collections.deque([((start_pos[0], start_pos[1]), start_dir, [])]) \n  \n  # Visited set: stores ((x, y), direction) tuples to avoid redundant exploration and cycles.\n  visited = {((start_pos[0], start_pos[1]), start_dir)} \n\n  best_path = None # This will store the shortest action sequence found.\n\n  # Pre-fetch the set of non-grabbable indices for efficiency in _is_traversable.\n  world_non_grabbable_indices = env.world.non_grabbable_indices \n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.popleft() \n\n    # Check if a 'USE' action can be applied from the current state.\n    # The 'USE' action targets the cell directly in front of the agent.\n    dx_face, dy_face = _ACTION_MAP[curr_dir] # Use _ACTION_MAP as it defines directions\n    front_x, front_y = curr_x + dx_face, curr_y + dy_face\n    \n    if (front_x, front_y) in target_primitive_locs:\n        # We found a path to a state from which the primitive can be collected.\n        # BFS guarantees this is the shortest path to such a state.\n        best_path = path_actions\n        break \n\n    # Explore all possible movement actions (0, 1, 2, 3) from the current state.\n    # Moving an agent also sets its facing direction to the direction of movement.\n    for move_action, (dx_move, dy_move) in _ACTION_MAP.items():\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # The agent's new direction is the direction of movement.\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n\n      # Check if the next position is traversable and if this state (pos+dir) has not been visited yet.\n      if _is_traversable(grid, next_x, next_y, grid_width, grid_height, world_non_grabbable_indices):\n        if next_state_tuple not in visited:\n          visited.add(next_state_tuple)\n          # Add the new state to the queue with its accumulated path.\n          queue.append((next_state_tuple[0], next_state_tuple[1], path_actions + [move_action]))\n\n  if best_path is None:\n    return [] # If the BFS queue is exhausted and no path was found, the primitive is unreachable.\n\n  # Append the final 'USE' action to the sequence of movement actions.\n  return best_path + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T13:48:49.572833", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    obs = env.observations()\n    current_state = env._current_state # Direct access to CraftState for position, direction\n    current_r, current_c = current_state.pos\n    current_d = current_state.dir\n    inventory = obs['features_dict']['inventory']\n\n    world = env.world\n    primitive_idx = world.index.index(primitive) # Get integer ID for the primitive\n\n    # Check if primitive is already in inventory\n    if inventory[primitive_idx] > 0:\n        return []\n\n    grid_data = obs['features_dict']['features_global']\n    GRID_ROWS, GRID_COLS, N_KINDS = grid_data.shape # Grid shape is (rows, columns, kinds)\n\n    # Get action integer IDs from the environment's action_specs\n    ACTION_UP = env.action_specs()['UP']\n    ACTION_LEFT = env.action_specs()['LEFT']\n    ACTION_RIGHT = env.action_specs()['RIGHT']\n    ACTION_DOWN = env.action_specs()['DOWN'] # This action means turn 180 degrees and move forward\n    ACTION_USE = env.action_specs()['USE']\n\n    # Direction to (dr, dc) mapping for (row, col) coordinates\n    # 0: North (row-1, col)\n    # 1: East  (row, col+1)\n    # 2: South (row+1, col)\n    # 3: West  (row, col-1)\n    DIR_DELTAS = {\n        0: (-1, 0), # North\n        1: (0, 1),  # East\n        2: (1, 0),  # South\n        3: (0, -1)  # West\n    }\n\n    # Find all locations of the target primitive on the grid\n    primitive_locs = []\n    for r in range(GRID_ROWS):\n        for c in range(GRID_COLS):\n            if grid_data[r, c, primitive_idx] == 1.0:\n                primitive_locs.append((r, c))\n\n    if not primitive_locs:\n        # Primitive not found in the world\n        return []\n\n    q = collections.deque()\n    visited = set()\n\n    # Queue stores tuples: (row, col, direction, path_list)\n    q.append((current_r, current_c, current_d, []))\n    visited.add((current_r, current_c, current_d))\n\n    # Helper function to check if a cell is traversable\n    def is_traversable(r, c):\n        if not (0 <= r < GRID_ROWS and 0 <= c < GRID_COLS):\n            return False # Out of bounds\n        \n        # Check if the cell contains any non-grabbable/blocking item\n        # A cell is blocked if it contains any item from world.non_grabbable_indices\n        cell_contents = grid_data[r, c, :]\n        for idx in world.non_grabbable_indices:\n            if cell_contents[idx] == 1.0: # If this kind of item is present in the cell\n                return False # Cell contains a blocking item\n        return True\n\n    # BFS loop\n    while q:\n        curr_r, curr_c, curr_d, path = q.popleft()\n\n        # Check if we can collect the primitive from the current state\n        # The agent must be adjacent to the primitive and facing it.\n        forward_dr, forward_dc = DIR_DELTAS[curr_d]\n        facing_r, facing_c = curr_r + forward_dr, curr_c + forward_dc\n\n        if (facing_r, facing_c) in primitive_locs:\n            # Found a path to be adjacent to and facing the primitive. Append USE action.\n            return path + [ACTION_USE]\n\n        # Explore possible actions from the current state:\n        # 1. Move Forward (UP action)\n        next_r_up, next_c_up = curr_r + DIR_DELTAS[curr_d][0], curr_c + DIR_DELTAS[curr_d][1]\n        next_d_up = curr_d # Direction remains the same\n        if is_traversable(next_r_up, next_c_up) and \\\n           (next_r_up, next_c_up, next_d_up) not in visited:\n            q.append((next_r_up, next_c_up, next_d_up, path + [ACTION_UP]))\n            visited.add((next_r_up, next_c_up, next_d_up))\n\n        # 2. Turn Left (LEFT action)\n        next_d_left = (curr_d - 1 + 4) % 4 # Ensure positive result for modulo\n        if (curr_r, curr_c, next_d_left) not in visited:\n            q.append((curr_r, curr_c, next_d_left, path + [ACTION_LEFT]))\n            visited.add((curr_r, curr_c, next_d_left))\n\n        # 3. Turn Right (RIGHT action)\n        next_d_right = (curr_d + 1) % 4\n        if (curr_r, curr_c, next_d_right) not in visited:\n            q.append((curr_r, curr_c, next_d_right, path + [ACTION_RIGHT]))\n            visited.add((curr_r, curr_c, next_d_right))\n\n        # 4. Turn Around and Move Forward (DOWN action)\n        # This action effectively turns 180 degrees and then moves one step forward.\n        next_d_down = (curr_d + 2) % 4 # Turn 180 degrees\n        next_r_down, next_c_down = curr_r + DIR_DELTAS[next_d_down][0], curr_c + DIR_DELTAS[next_d_down][1]\n        if is_traversable(next_r_down, next_c_down) and \\\n           (next_r_down, next_c_down, next_d_down) not in visited:\n            q.append((next_r_down, next_c_down, next_d_down, path + [ACTION_DOWN]))\n            visited.add((next_r_down, next_c_down, next_d_down))\n\n    # If the BFS completes without finding a path to any primitive location\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:48:50.549238", "function_name": "collect", "function_body": "  import collections\n\n  # Constants for actions based on action_specs: DOWN\u21920, UP\u21921, LEFT\u21922, RIGHT\u21923, USE\u21924\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Get current state information from the environment\n  # We access the internal _current_state of CraftLab to get precise integer positions.\n  current_state = env.unwrapped._current_state\n  agent_pos = current_state.pos  # (x, y) tuple of integers\n  grid = current_state.grid  # numpy.ndarray (WIDTH, HEIGHT, n_kinds)\n  inventory = current_state.inventory  # numpy.ndarray (n_kinds,)\n  world = current_state.world  # CraftWorld instance\n  \n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Check if the primitive is already in the inventory\n  if inventory[primitive] > 0:\n    return []\n\n  # Define which entity kinds are considered impassable for movement.\n  # Assuming water and stone are primary impassable terrain from CraftWorld attributes.\n  # It's possible other non_grabbable_indices are also impassable, but without specific\n  # definition, water and stone are the most common examples for blocking movement.\n  impassable_for_movement = set()\n  if hasattr(world, 'water_index'):\n      impassable_for_movement.add(world.water_index)\n  if hasattr(world, 'stone_index'):\n      impassable_for_movement.add(world.stone_index)\n\n  def is_traversable(x, y):\n    \"\"\"\n    Checks if a given grid cell (x, y) is within bounds and traversable.\n    A cell is traversable if it does not contain any known impassable entity.\n    \"\"\"\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False\n    # Check if the cell contains any impassable item\n    for k_idx in impassable_for_movement:\n      if grid[x, y, k_idx] > 0:\n        return False\n    return True\n\n  # Find all locations on the grid where the primitive exists\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      if grid[x, y, primitive] > 0:\n        primitive_locations.append((x, y))\n\n  if not primitive_locations:\n    # The primitive is not on the grid, so it cannot be collected directly\n    return []\n\n  # Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  queue = collections.deque([(agent_pos, [])])\n  # Visited set stores (x, y) tuples to prevent revisiting the same cell\n  visited = {agent_pos}\n\n  # Define possible moves and their corresponding (dx, dy) changes\n  # This mapping is used to explore neighbors and reconstruct actions\n  moves = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0)\n  }\n\n  while queue:\n    current_pos, actions_path = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if the current position is adjacent to any primitive location\n    # The 'USE' action typically operates on an adjacent cell (Manhattan distance 1).\n    for px, py in primitive_locations:\n      if abs(cx - px) + abs(cy - py) == 1:\n        # Found the shortest path to a cell adjacent to the primitive.\n        # Append the USE action and return the full action sequence.\n        return actions_path + [USE]\n\n    # Explore valid neighbors\n    for action, (dx, dy) in moves.items():\n      next_x, next_y = cx + dx, cy + dy\n      next_pos = (next_x, next_y)\n\n      if is_traversable(next_x, next_y) and next_pos not in visited:\n        visited.add(next_pos)\n        new_actions_path = actions_path + [action]\n        queue.append((next_pos, new_actions_path))\n\n  # If the queue becomes empty and no path was found, the primitive is unreachable\n  return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:50:05.849060", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:50:05.918742", "function_name": "collect", "function_body": "    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    actions_taken = []\n    MAX_ATTEMPTS = 1000  # Set a reasonable limit to prevent infinite loops\n\n    for _ in range(MAX_ATTEMPTS):\n        # Access the current state directly from the environment\n        current_state = env._current_state\n\n        # Check if the primitive is already in inventory\n        if current_state.inventory[primitive] > 0:\n            return actions_taken\n\n        # Get agent's current position and the full grid\n        agent_row, agent_col = current_state.pos\n        current_grid = current_state.grid\n\n        # Find all locations of the primitive on the grid\n        # np.argwhere returns (row, col) coordinates where the condition is true\n        primitive_locations = np.argwhere(current_grid[:, :, primitive] == 1)\n\n        chosen_action = None\n\n        if primitive_locations.size > 0:  # If the primitive is found anywhere on the grid\n            # Find the closest primitive location using Manhattan distance\n            agent_pos_np = np.array([agent_row, agent_col])\n            distances = np.sum(np.abs(primitive_locations - agent_pos_np), axis=1)\n            closest_loc_idx = np.argmin(distances)\n            closest_loc = primitive_locations[closest_loc_idx]  # (target_row, target_col)\n\n            # Check if agent is next to the primitive (within a 3x3 neighborhood)\n            if current_state.next_to(primitive):\n                chosen_action = ACTION_USE\n            else:\n                # Move closer to the closest primitive\n                target_row, target_col = closest_loc\n\n                # Prioritize vertical movement first, then horizontal\n                if target_row > agent_row:\n                    chosen_action = ACTION_DOWN\n                elif target_row < agent_row:\n                    chosen_action = ACTION_UP\n                elif target_col > agent_col:\n                    chosen_action = ACTION_RIGHT\n                elif target_col < agent_col:\n                    chosen_action = ACTION_LEFT\n                else:\n                    # Agent is at the same location as target, but not \"next to\" it.\n                    # This case implies the primitive is part of the terrain or\n                    # is otherwise not directly interactable via `next_to`/`USE` from this cell.\n                    # Or it's blocked. For simplicity, if we reach this unexpected state,\n                    # try a random move to break potential deadlocks.\n                    chosen_action = np.random.choice(\n                        [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]\n                    )\n        else:\n            # Primitive not found anywhere on the grid (implies it's not spawned or visible).\n            # In such a case, it's impossible to collect it.\n            # For this 'v2' and assuming the item is generally available,\n            # we'll make the agent explore randomly. A more robust solution might\n            # signal failure or attempt a more systematic exploration.\n            chosen_action = np.random.choice(\n                [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]\n            )\n\n        # Execute the chosen action\n        actions_taken.append(chosen_action)\n        reward, done, _ = env.step(chosen_action)\n\n        # If the environment signals \"done\" (e.g., max_steps reached)\n        # and we still haven't collected the primitive, then we've failed.\n        if done and current_state.inventory[primitive] == 0:\n            return actions_taken\n\n    # If MAX_ATTEMPTS are exhausted and the primitive is not collected,\n    # return the actions taken so far (indicating failure to collect within limit).\n    return actions_taken", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:51:46.253428", "function_name": "collect", "function_body": "    actions_sequence = []\n\n    # Action constants based on action_specs() mapping:\n    # DOWN->0, UP->1, LEFT->2, RIGHT->3, USE->4\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # List of movement actions for random exploration\n    MOVEMENT_ACTIONS = [UP, DOWN, LEFT, RIGHT]\n\n    # Maximum number of steps to attempt to collect the primitive\n    MAX_ATTEMPTS = 500\n\n    for _ in range(MAX_ATTEMPTS):\n        current_state = env._current_state\n\n        # 1. Check if the primitive is already in the inventory\n        if current_state.inventory[primitive] > 0:\n            return actions_sequence\n\n        # 2. Check if the primitive is in the immediate vicinity (3x3 neighborhood)\n        if current_state.next_to(primitive):\n            # If it's nearby, attempt to USE it.\n            # The \"USE\" action \"interacts with the cell in front of the agent\".\n            # For `_v2`, we assume that if `next_to` is True, a simple `USE` action\n            # is sufficient to attempt collection. A more complex solution might involve\n            # trying to align the agent's direction, but that's not straightforward\n            # with the given simple action set (no explicit turn actions).\n            action_to_perform = USE\n            actions_sequence.append(action_to_perform)\n            _reward, _done, _obs = env.step(action_to_perform)\n            \n            # After attempting USE, immediately re-check inventory\n            if env._current_state.inventory[primitive] > 0:\n                return actions_sequence\n            \n            # If USE did not collect it (e.g., wrong direction, or another item was used),\n            # the loop will continue to try exploration or another USE attempt.\n        else:\n            # 3. Primitive is not in the immediate vicinity, so explore the environment.\n            # This version uses a simple random walk for exploration.\n            # More advanced exploration (e.g., using A* or features_ego to pathfind)\n            # would be for later versions.\n            action_to_perform = random.choice(MOVEMENT_ACTIONS)\n            actions_sequence.append(action_to_perform)\n            _reward, _done, _obs = env.step(action_to_perform)\n\n        # Check if the environment signals that the episode is done\n        # This can happen if the internal max_steps of the environment is reached.\n        if _done:\n            # If the episode is done, re-check inventory one last time.\n            # If the primitive is now collected, it means the goal was satisfied.\n            if env._current_state.inventory[primitive] > 0:\n                return actions_sequence\n            else:\n                # Goal not satisfied and episode is over. Return empty list (failure to collect).\n                return []\n\n    # If the loop completes without collecting the primitive within MAX_ATTEMPTS,\n    # it implies failure to collect within the given attempt limit.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:51:47.240425", "function_name": "collect", "function_body": "  actions = []\n  current_state = env._current_state\n  current_pos = current_state.pos\n  grid = current_state.grid\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n  # Define action constants and movement vectors based on CraftLab's action_specs.\n  # These are defined inside the function to adhere to the \"only return code inside the function\" rule.\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  MOVES = {\n      ACTION_UP: (0, -1),   # (dr, dc) for (row, col)\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Identify blocking indices for pathfinding.\n  # Based on CraftWorld data attributes, water and stone are common non-traversable elements.\n  world = env.world\n  blocking_indices = set()\n  if hasattr(world, 'water_index'):\n      blocking_indices.add(world.water_index)\n  if hasattr(world, 'stone_index'):\n      blocking_indices.add(world.stone_index)\n\n  # 1. Find the closest cell containing the primitive on the grid.\n  min_dist = float('inf')\n  target_primitive_cell = None\n\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # Check if the cell contains the desired primitive\n          if grid[r, c, primitive] > 0:\n              # Calculate Manhattan distance for grid-based movement\n              dist = abs(r - current_pos[0]) + abs(c - current_pos[1])\n              if dist < min_dist:\n                  min_dist = dist\n                  target_primitive_cell = (r, c)\n\n  if target_primitive_cell is None:\n      # Primitive not found anywhere on the map\n      return []\n\n  # 2. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    from the agent's current position to the target primitive cell.\n  #    The BFS state includes (current_position, list_of_actions_taken_to_reach_here).\n  queue = collections.deque([(current_pos, [])])  # Queue: (position, path_actions)\n  visited = {current_pos}  # Set to keep track of visited positions\n\n  path_to_primitive = None\n\n  while queue:\n      (r, c), path = queue.popleft()\n\n      # If we reached the target primitive cell, we found the shortest path\n      if (r, c) == target_primitive_cell:\n          path_to_primitive = path\n          break\n\n      # Explore neighboring cells\n      for action, (dr, dc) in MOVES.items():\n          nr, nc = r + dr, c + dc  # New row and column\n\n          # Check boundaries\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n\n          new_pos = (nr, nc)\n\n          # Check if the new cell is blocked by any identified blocking kind\n          is_blocked = False\n          for block_idx in blocking_indices:\n              if grid[nr, nc, block_idx] > 0: # If there's content of a blocking kind\n                  is_blocked = True\n                  break\n          if is_blocked:\n              continue\n\n          # If the new position hasn't been visited, add it to the queue\n          if new_pos not in visited:\n              visited.add(new_pos)\n              queue.append((new_pos, path + [action]))\n\n  if path_to_primitive is None:\n      # No path found to the primitive cell (e.g., it's surrounded by obstacles)\n      return []\n\n  # 3. Once the agent reaches the primitive's cell, perform the USE action to collect it.\n  actions = path_to_primitive + [ACTION_USE]\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:52:46.268908", "function_name": "collect", "function_body": "  from collections import deque # Ensure deque is available\n\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name\n  # Using .index() ensures the item is known to the cookbook, adding it if new.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Pre-checks for early exit\n  # If the primitive is not grabbable, it cannot be collected via USE.\n  if primitive_idx not in env.world.grabbable_indices:\n    return [] \n\n  # If the primitive is already in the agent's inventory, no actions needed.\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] \n\n  # 3. Retrieve necessary grid and world properties for pathfinding\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # Define what constitutes an impassable object on the grid.\n  # Includes non-grabbable environment entities and workshop locations.\n  impassable_kinds = env.world.non_grabbable_indices.union(set(env.world.workshop_indices))\n\n  # Helper function to check if a cell is walkable\n  # This version captures 'grid_width', 'grid_height', 'grid', and 'impassable_kinds'\n  # from the outer scope, simplifying its arguments. It also uses `any` for conciseness.\n  def is_cell_walkable(x, y):\n      # First, check if the cell is within grid boundaries\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False \n      \n      # Then, check if the cell (x,y) contains any object that is considered impassable\n      return not any(grid[x, y, k_idx] > 0 for k_idx in impassable_kinds)\n\n  # 4. Initialize BFS: Queue and Path Reconstruction Dictionary\n  # BFS state: ((x, y), direction)\n  # visited: {state_tuple: (parent_state_tuple, action_taken_to_reach_state)}\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  queue = deque([(start_pos, start_dir)]) \n  visited = {(start_pos, start_dir): (None, None)} # (parent_state, action_from_parent_to_current)\n\n  target_reached_state = None # To store the state from which USE can be applied\n\n  # 5. BFS Loop\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.popleft() # Dequeue for BFS\n\n    # Check if the current state allows for immediate USE action on the primitive.\n    # Calculate the coordinates of the cell directly in front of the agent.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # If the cell in front is within bounds and contains the primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      # Found a state where the agent can perform USE to collect the primitive.\n      target_reached_state = ((curr_x, curr_y), curr_dir)\n      break # Path found, exit BFS loop\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement\n\n      # Check if the next position is within the grid boundaries AND is walkable.\n      if not is_cell_walkable(next_x, next_y):\n        continue # Cannot move to this cell (obstacle or out of bounds)\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet\n      if next_state_tuple not in visited:\n        visited[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action)\n        queue.append(next_state_tuple)\n\n  # 6. Reconstruct Path\n  if target_reached_state is None:\n    return [] # If the queue becomes empty and no path was found, it means the primitive is unreachable.\n\n  path_actions = []\n  current_reconstruction_state = target_reached_state\n  \n  # Loop until we reach the starting state, which has (None, None) as its parent\n  while visited[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = visited[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  # The path was built in reverse order, so reverse it to get the correct sequence\n  path_actions.reverse()\n  \n  # Add the final USE action to the collected path\n  return path_actions + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T13:52:47.264016", "function_name": "collect", "function_body": "  from collections import deque\n\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4\n\n  # 1. Get the integer index for the given primitive name\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # 3. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 4. Retrieve grid dimensions and define impassable kinds\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # Define what constitutes an impassable object on the grid.\n  # Union of non-grabbable entities and workshop locations.\n  impassable_kinds = env.world.non_grabbable_indices.union(set(env.world.workshop_indices))\n\n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a position and orientation from which the primitive can be collected via USE.\n  # BFS state: ((current_x, current_y), current_direction)\n  # visited: {state_tuple: (parent_state_tuple, action_taken_to_reach_state)}\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  queue = deque([(start_pos, start_dir)]) \n  visited = {(start_pos, start_dir): (None, None)}\n\n  target_reached_state = None\n\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.popleft()\n\n    # Check if the current state allows for immediate USE action on the primitive.\n    # Calculate the coordinates of the cell directly in front of the agent.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # If the cell in front is within bounds and contains the primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      target_reached_state = ((curr_x, curr_y), curr_dir)\n      break\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement\n\n      # Check if the next position is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position contains any object that is considered impassable.\n      # This logic replaces the separate `is_cell_walkable` helper function from `v1`.\n      if any(grid[next_x, next_y, k_idx] > 0 for k_idx in impassable_kinds):\n        continue\n      \n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet\n      if next_state_tuple not in visited:\n        visited[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action)\n        queue.append(next_state_tuple)\n\n  if target_reached_state is None:\n    return []\n\n  # Reconstruct the path by backtracking from the target_reached_state to the start_state\n  path_actions = []\n  current_reconstruction_state = target_reached_state\n  \n  while visited[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = visited[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  path_actions.reverse()\n  \n  # Add the final USE action\n  return path_actions + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T13:54:02.067441", "function_name": "collect", "function_body": "  from collections import deque\n\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4\n\n  # 1. Get the integer index for the given primitive name from the cookbook's index.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is designated as grabbable by the world configuration.\n  # If not grabbable, it cannot be collected using the 'USE' action.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # 3. Check if the primitive is already present in the agent's current inventory.\n  # If already collected, no further actions are needed.\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 4. Extract current grid information and define what kinds of entities are impassable.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # Impassable entities include all non-grabbable items and workshop locations,\n  # as these typically cannot be moved onto.\n  impassable_kinds = env.world.non_grabbable_indices.union(set(env.world.workshop_indices))\n\n  # Initialize Breadth-First Search (BFS) for shortest pathfinding.\n  # A state in the BFS is defined by ((x, y), direction), as both position and orientation matter\n  # for the 'USE' action.\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  # The queue stores states to visit: (current_position, current_direction).\n  queue = deque([(start_pos, start_dir)]) \n  \n  # The 'visited' dictionary stores the path: {current_state: (parent_state, action_from_parent)}.\n  # This allows reconstructing the sequence of actions later.\n  visited = {(start_pos, start_dir): (None, None)}\n\n  # This variable will store the state where the primitive can be collected.\n  target_reached_state = None\n\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.popleft()\n\n    # Check if the current position and direction allows collecting the primitive immediately.\n    # The 'USE' action applies to the cell directly in front of the agent.\n    dx_facing, dy_facing = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_facing, curr_y + dy_facing\n\n    # If the cell in front is within grid boundaries and contains the primitive,\n    # we have found a path to a collection point.\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      target_reached_state = ((curr_x, curr_y), curr_dir)\n      break # Shortest path found due to BFS property.\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT).\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to movement directions\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # The agent's new direction is set by the movement action.\n\n      # Check if the new position is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the new position contains any impassable objects.\n      # If so, this cell cannot be traversed.\n      if any(grid[next_x, next_y, k_idx] > 0 for k_idx in impassable_kinds):\n        continue\n      \n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this state (position and direction) has not been visited yet, add it to the queue.\n      if next_state_tuple not in visited:\n        visited[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action)\n        queue.append(next_state_tuple)\n\n  # If no path to a collectable primitive was found, return an empty list of actions.\n  if target_reached_state is None:\n    return []\n\n  # Reconstruct the sequence of actions by backtracking from the target state to the start state.\n  path_actions = []\n  current_reconstruction_state = target_reached_state\n  \n  # Backtrack until the parent of the start state (None) is reached.\n  while visited[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = visited[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  path_actions.reverse() # Reverse the list to get actions in chronological order.\n  \n  # The final action is to 'USE' the primitive once in position and facing correctly.\n  return path_actions + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T13:54:03.044832", "function_name": "collect", "function_body": "  from collections import deque\n\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4\n\n  # 1. Get the integer index for the given primitive name\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # 3. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 4. Retrieve grid dimensions and define impassable kinds\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # Define what constitutes an impassable object on the grid for movement.\n  # This includes non-grabbable entities and workshop locations.\n  # The primitive itself, if grabbable, is not considered impassable for walking on.\n  impassable_kinds = env.world.non_grabbable_indices.union(set(env.world.workshop_indices))\n\n  def _is_cell_traversable(x, y):\n      \"\"\"Checks if a cell (x, y) is within bounds and does not contain impassable objects.\"\"\"\n      # Check boundary conditions\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False\n      \n      # Check for impassable obstacles at the cell\n      for k_idx in impassable_kinds:\n          if grid[x, y, k_idx] > 0:\n              return False # This cell contains an obstacle\n      return True\n\n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a position and orientation from which the primitive can be collected via USE.\n  # BFS state: ((current_x, current_y), current_direction)\n  # visited: {state_tuple: (parent_state_tuple, action_taken_to_reach_state)}\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  queue = deque([(start_pos, start_dir)]) \n  visited = {(start_pos, start_dir): (None, None)}\n\n  target_reached_state = None\n\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.popleft()\n\n    # Check if the current state allows for immediate USE action on the primitive.\n    # Calculate the coordinates of the cell directly in front of the agent.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # If the cell in front is within bounds and contains the primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      target_reached_state = ((curr_x, curr_y), curr_dir)\n      break # Found the shortest path to a collectable state\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement\n\n      # Check if the next position is traversable (within bounds and no impassable obstacles).\n      if not _is_cell_traversable(next_x, next_y):\n        continue\n      \n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet\n      if next_state_tuple not in visited:\n        visited[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action)\n        queue.append(next_state_tuple)\n\n  if target_reached_state is None:\n    return [] # Primitive is unreachable from the current state\n\n  # Reconstruct the path by backtracking from the target_reached_state to the start_state\n  path_actions = []\n  current_reconstruction_state = target_reached_state\n  \n  while visited[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = visited[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  path_actions.reverse() # Reverse to get actions from start to target\n  \n  # Add the final USE action\n  return path_actions + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
