{"timestamp": "2025-07-30T04:01:23.030043", "function_name": "collect", "function_body": "  actions = []\n  max_steps_limit = 200 # A reasonable limit to avoid infinite loops in simple navigation\n\n  # Get grid dimensions once from the initial observation\n  obs = env.observations()\n  grid_shape = obs['features_dict']['features_global'].shape\n  WIDTH, HEIGHT, _ = grid_shape # N_KINDS is not directly used here\n\n  # Determine if the primitive needs a 'USE' action or is automatically picked up\n  # based on CraftWorld's definition of grabbable/non-grabbable items.\n  is_primitive_non_grabbable = primitive in env.world.non_grabbable_indices\n\n  for _ in range(max_steps_limit):\n      current_obs = env.observations()\n      grid = current_obs['features_dict']['features_global']\n      agent_pos_tuple = tuple(current_obs['features_dict']['pos']) # (x, y)\n      current_inventory = current_obs['features_dict']['inventory']\n\n      # Check if the primitive has already been collected\n      if current_inventory[primitive] > 0:\n          return actions # Goal achieved, return the sequence of actions\n\n      # Find the closest instance of the primitive on the grid\n      target_pos_on_grid = None\n      min_dist_sq = float('inf') # Squared Euclidean distance for comparison\n\n      for y in range(HEIGHT):\n          for x in range(WIDTH):\n              # Check if this cell contains the primitive\n              if grid[x, y, primitive] > 0:\n                  dist_sq = (x - agent_pos_tuple[0])**2 + (y - agent_pos_tuple[1])**2\n                  if dist_sq < min_dist_sq:\n                      min_dist_sq = dist_sq\n                      target_pos_on_grid = (x, y)\n\n      if target_pos_on_grid is None:\n          # Primitive not found on the map, cannot collect it.\n          break\n\n      next_action_to_take = None\n      current_pos = agent_pos_tuple\n\n      if is_primitive_non_grabbable:\n          # For non-grabbable items, agent needs to move to an adjacent cell\n          # and then use the 'USE' action.\n\n          # Identify candidate adjacent cells to the primitive\n          tx, ty = target_pos_on_grid\n          possible_adj_cells = []\n          # Check all 4 cardinal neighbors\n          if tx + 1 < WIDTH: possible_adj_cells.append((tx + 1, ty))\n          if tx - 1 >= 0: possible_adj_cells.append((tx - 1, ty))\n          if ty + 1 < HEIGHT: possible_adj_cells.append((tx, ty + 1))\n          if ty - 1 >= 0: possible_adj_cells.append((tx, ty - 1))\n\n          best_adj_pos = None\n          min_adj_dist_sq = float('inf')\n\n          # Find the closest valid adjacent cell to the agent's current position\n          for adj_x, adj_y in possible_adj_cells:\n              dist_sq = (adj_x - current_pos[0])**2 + (adj_y - current_pos[1])**2\n              if dist_sq < min_adj_dist_sq:\n                  min_adj_dist_sq = dist_sq\n                  best_adj_pos = (adj_x, adj_y)\n\n          if best_adj_pos is None:\n              # No reachable adjacent cell found (e.g., primitive surrounded or at map edge)\n              break\n\n          if current_pos == best_adj_pos:\n              # Agent is already at the correct adjacent position.\n              # Attempt to USE the primitive. Assuming USE works if adjacent.\n              next_action_to_take = env_factory.Action.USE\n          else:\n              # Agent is not at the adjacent position, move towards it.\n              dx_move = best_adj_pos[0] - current_pos[0]\n              dy_move = best_adj_pos[1] - current_pos[1]\n\n              # Greedy movement: prioritize moving along the larger difference (Manhattan distance heuristic)\n              if abs(dx_move) > abs(dy_move):\n                  if dx_move > 0: next_action_to_take = env_factory.Action.RIGHT\n                  else: next_action_to_take = env_factory.Action.LEFT\n              else:\n                  if dy_move > 0: next_action_to_take = env_factory.Action.DOWN\n                  else: next_action_to_take = env_factory.Action.UP\n      else: # Primitive is grabbable (picked up by simply moving onto its cell)\n          if current_pos == target_pos_on_grid:\n              # Agent is on the target cell. It should have been collected automatically by the environment.\n              # If not, this logic assumes it's uncollectable by simple movement, or is already collected.\n              return actions # Assume success or inability to collect via this method (and already gave up)\n          else:\n              # Move towards the grabbable primitive's cell\n              dx_move = target_pos_on_grid[0] - current_pos[0]\n              dy_move = target_pos_on_grid[1] - current_pos[1]\n\n              if abs(dx_move) > abs(dy_move):\n                  if dx_move > 0: next_action_to_take = env_factory.Action.RIGHT\n                  else: next_action_to_take = env_factory.Action.LEFT\n              else:\n                  if dy_move > 0: next_action_to_take = env_factory.Action.DOWN\n                  else: next_action_to_take = env_factory.Action.UP\n\n      # Execute the chosen action in the environment\n      if next_action_to_take is not None:\n          actions.append(next_action_to_take)\n          _, done, _ = env.step(next_action_to_take)\n          if done:\n              break # Environment signaled episode end\n      else:\n          # Could not determine a valid next action (e.g., stuck, no path, or logic error)\n          break\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:02:39.886098", "function_name": "collect", "function_body": "    \"\"\"Improved version of `collect_v1` using BFS to find the primitive.\"\"\"\n\n    # Action constants (assuming these are globally defined elsewhere or are implicitly known)\n    # If not, these values are commonly used in similar environments.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Directional movements (dr, dc) for (DOWN, UP, LEFT, RIGHT) actions\n    # Assuming (0,0) is top-left, row increases downwards, col increases rightwards\n    ACTION_DELTAS = {\n        DOWN: (1, 0),\n        UP: (-1, 0),\n        LEFT: (0, -1),\n        RIGHT: (0, 1),\n    }\n\n    # 3x3 neighborhood relative coordinates (including self) for checking \"next_to\" condition\n    NEIGHBORHOOD_DELTAS_3x3 = [\n        (-1, -1), (-1, 0), (-1, 1),\n        (0, -1), (0, 0), (0, 1),\n        (1, -1), (1, 0), (1, 1),\n    ]\n\n    state = env._current_state\n    grid = state.grid\n    initial_pos_r, initial_pos_c = state.pos\n    world = state.world\n\n    # Get primitive index from the cookbook's index\n    try:\n        primitive_idx = world.cookbook.index[primitive]\n    except KeyError:\n        # If the primitive name is not known to the cookbook, it cannot be collected.\n        return []\n\n    # Grid dimensions (rows, columns, kinds)\n    GRID_ROWS, GRID_COLS, N_KINDS = grid.shape\n    \n    # Identify impassable entities based on CraftWorld's non_grabbable_indices\n    impassable_indices = world.non_grabbable_indices\n    \n    def is_traversable(r, c):\n        \"\"\"Checks if a cell (r, c) is within bounds and does not contain an impassable object.\"\"\"\n        if not (0 <= r < GRID_ROWS and 0 <= c < GRID_COLS):\n            return False # Out of bounds\n        \n        # Check if any impassable kind is present at (r, c)\n        # A cell is impassable if it contains any entity from the non_grabbable_indices set.\n        # The grid stores one-hot encoding for kinds, so grid[r, c, k_idx] == 1 means k_idx is present.\n        for k_idx in impassable_indices:\n            if grid[r, c, k_idx] == 1:\n                return False # Contains an impassable object (e.g., water, stone if non-grabbable)\n        return True\n\n    def is_target_found(r, c):\n        \"\"\"Checks if the primitive is in the 3x3 neighborhood of (r, c).\"\"\"\n        # This simulates the condition for CraftState.next_to(primitive_idx)\n        for dr, dc in NEIGHBORHOOD_DELTAS_3x3:\n            nr, nc = r + dr, c + dc\n            # Check bounds for the neighbor cell itself, as grid access would fail otherwise\n            if 0 <= nr < GRID_ROWS and 0 <= nc < GRID_COLS:\n                if grid[nr, nc, primitive_idx] == 1:\n                    return True # Primitive found in the neighborhood\n        return False\n\n    # BFS initialization\n    # Using collections.deque for efficient popleft, assuming 'collections' is available.\n    queue = collections.deque()\n    # Queue stores (row, col, list_of_actions_to_reach_this_cell)\n    queue.append((initial_pos_r, initial_pos_c, []))\n\n    visited = set()\n    visited.add((initial_pos_r, initial_pos_c)) # Keep track of visited (row, col) pairs\n\n    while queue:\n        r, c, path = queue.popleft()\n\n        # If the current cell (r, c) allows the agent to be \"next to\" the primitive,\n        # then we can perform the USE action here.\n        if is_target_found(r, c):\n            return path + [USE] # Add USE action and return the complete path\n\n        # Explore valid neighbors (up, down, left, right)\n        for action, (dr, dc) in ACTION_DELTAS.items():\n            nr, nc = r + dr, c + dc # New potential position\n\n            if is_traversable(nr, nc) and (nr, nc) not in visited:\n                visited.add((nr, nc)) # Mark as visited\n                queue.append((nr, nc, path + [action])) # Add to queue with updated path\n\n    # If the queue becomes empty and the target was not found, the primitive is unreachable.\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:02:40.896046", "function_name": "collect", "function_body": "  import collections\n\n  # Get initial state information from the environment\n  initial_obs = env.reset(seed=0)  # Using a fixed seed for determinism in planning\n  initial_grid = initial_obs['features_dict']['features_global']\n  initial_pos_norm = initial_obs['features_dict']['pos']\n  \n  # Extract grid dimensions\n  HEIGHT, WIDTH, N_KINDS = initial_grid.shape\n\n  # Denormalize initial agent position\n  # pos_norm[0] is y, pos_norm[1] is x\n  initial_pos_y = int(initial_pos_norm[0] * (HEIGHT - 1))\n  initial_pos_x = int(initial_pos_norm[1] * (WIDTH - 1))\n  initial_pos = (initial_pos_y, initial_pos_x)\n\n  # Define movement deltas for actions (row_delta, col_delta)\n  # Based on action_specs: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DELTAS = {\n      env_factory.DOWN: (1, 0),\n      env_factory.UP: (-1, 0),\n      env_factory.LEFT: (0, -1),\n      env_factory.RIGHT: (0, 1),\n  }\n\n  # Identify unwalkable terrain kinds\n  # Assuming non_grabbable_indices and workshop_indices are generally solid/unpassable\n  # A more sophisticated model might distinguish between solid obstacles and special terrain (e.g., water)\n  unwalkable_kinds = env.world.non_grabbable_indices.union(env.world.workshop_indices)\n\n  # Find all locations of the target primitive on the grid\n  target_locations = []\n  for r in range(HEIGHT):\n    for c in range(WIDTH):\n      if initial_grid[r, c, primitive] > 0:\n        target_locations.append((r, c))\n\n  # If the primitive is not found anywhere, it's uncollectable\n  if not target_locations:\n    return []\n\n  # BFS setup\n  queue = collections.deque()\n  visited = set()  # Stores (y, x) tuples of visited grid cells\n\n  # Initial state: (current_pos, list_of_actions_to_reach_here)\n  queue.append((initial_pos, []))\n  visited.add(initial_pos)\n\n  # While there are states to explore\n  while queue:\n    current_pos, path_to_here = queue.popleft()\n    current_y, current_x = current_pos\n\n    # Check if we are at a target location\n    # If the agent is on the same cell as the primitive, 'USE' will collect it.\n    # If the primitive is adjacent, 'USE' will also collect it.\n    # For simplicity, we find the path to the primitive's cell, then add USE.\n    # The `CraftState.next_to` implies a 3x3 search for USE.\n    # We prioritize reaching the exact spot for a more direct plan.\n    if current_pos in target_locations:\n      # Found a path to a primitive location. Add the USE action.\n      # The primitive will be in the 3x3 neighborhood of current_pos (specifically, at current_pos).\n      return path_to_here + [env_factory.USE]\n\n    # Explore possible next actions (movements)\n    for action, (dr, dc) in ACTION_DELTAS.items():\n      new_y, new_x = current_y + dr, current_x + dc\n      new_pos = (new_y, new_x)\n\n      # Check if the new position is valid and not an obstacle\n      is_in_bounds = 0 <= new_y < HEIGHT and 0 <= new_x < WIDTH\n      if not is_in_bounds:\n        continue\n\n      is_visited = new_pos in visited\n      if is_visited:\n        continue\n\n      # Check if the new cell contains any unwalkable kinds\n      is_blocked = False\n      for kind_idx in unwalkable_kinds:\n        if initial_grid[new_y, new_x, kind_idx] > 0:\n          is_blocked = True\n          break\n      if is_blocked:\n        continue\n\n      # If the new position is valid, add it to the queue\n      visited.add(new_pos)\n      queue.append((new_pos, path_to_here + [action]))\n\n  # If the queue becomes empty and no path to a primitive was found\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:03:53.037749", "function_name": "collect", "function_body": "    # Constants for actions\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    actions_taken = []\n    MAX_STEPS = 500  # A reasonable limit to prevent infinite loops\n\n    for _ in range(MAX_STEPS):\n        state = env._current_state\n        current_pos = state.pos\n        current_inventory = state.inventory\n\n        # 1. Check if the primitive is already collected\n        if current_inventory[primitive] > 0:\n            return actions_taken\n\n        # 2. Check if the agent is currently next to (or on) the primitive\n        # If so, the USE action should collect it.\n        if state.next_to(primitive):\n            action = USE\n        else:\n            # 3. Find all locations of the primitive on the grid\n            # np.argwhere returns a list of [x, y] coordinates\n            primitive_locations = np.argwhere(state.grid[:, :, primitive] > 0)\n\n            if len(primitive_locations) == 0:\n                # Primitive is no longer on the map or was never present.\n                # Cannot collect. Return actions taken so far.\n                return actions_taken\n\n            # 4. Find the closest primitive location using Manhattan distance\n            min_dist = float('inf')\n            target_pos = None  # Will store (x, y) tuple of the closest primitive\n            for p_loc in primitive_locations:\n                # p_loc is a numpy array [x, y]\n                # current_pos is a tuple (x, y)\n                dist = abs(p_loc[0] - current_pos[0]) + abs(p_loc[1] - current_pos[1])\n                if dist < min_dist:\n                    min_dist = dist\n                    target_pos = tuple(p_loc) # Convert numpy array to tuple for consistency\n\n            # 5. Determine the next movement action towards the target\n            delta_x = target_pos[0] - current_pos[0]\n            delta_y = target_pos[1] - current_pos[1]\n\n            action = None\n            if delta_x != 0:\n                # Prioritize horizontal movement\n                action = RIGHT if delta_x > 0 else LEFT\n            elif delta_y != 0:\n                # Then vertical movement\n                action = DOWN if delta_y > 0 else UP\n            else:\n                # This case implies current_pos == target_pos,\n                # but `state.next_to(primitive)` was False.\n                # This should ideally not happen if `next_to` correctly covers current cell.\n                # It might indicate the primitive at `target_pos` has been removed\n                # or is an uncollectable type, or we are stuck.\n                # Break to prevent an infinite loop.\n                break\n\n        # 6. Perform the determined action in the environment\n        # We discard the reward and done status as we only care about the action sequence.\n        _, _, _ = env.step(action)\n        actions_taken.append(action)\n\n    # If MAX_STEPS is reached, the primitive was not collected.\n    # Return the actions taken so far.\n    return actions_taken", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:03:53.116278", "function_name": "collect", "function_body": "    actions = []\n    \n    # Get action mappings from the environment\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    current_state = env._current_state # Get the current state from the CraftLab instance\n\n    max_attempt_moves = 1000 # Safety limit to prevent infinite loops within this function\n    steps_taken_in_func = 0\n\n    while True:\n        # 1. Check if the primitive is already in inventory (goal achieved)\n        if current_state.inventory[primitive] > 0:\n            break # Goal achieved, exit loop\n\n        # 2. Check for maximum attempts within this function to prevent infinite loops\n        if steps_taken_in_func >= max_attempt_moves:\n            # print(f\"Warning: collect_v2 exceeded max_attempt_moves ({max_attempt_moves}) without collecting primitive.\")\n            break # Give up after too many attempts\n\n        # 3. Prioritize 'USE' action if the primitive is next to the agent\n        if current_state.next_to(primitive):\n            action = USE\n            reward, done, obs = env.step(action) # Apply action to environment\n            actions.append(action)\n            current_state = env._current_state # Update current_state from the environment\n            steps_taken_in_func += 1\n            if done: # If environment indicates done (e.g., max_steps reached)\n                break\n            continue # Continue loop to re-check inventory/next_to status after USE action\n\n        # 4. If not next to primitive, find primitive on the grid and move towards it\n        grid = current_state.grid\n        current_pos = current_state.pos # Agent's current (x, y) position\n\n        # Find all locations where the primitive exists on the grid\n        primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n        action_to_take = -1 # Initialize with an invalid action\n\n        if len(primitive_locations) > 0:\n            # Find the closest primitive location using Manhattan distance\n            min_dist = float('inf')\n            closest_target_pos = None\n\n            for p_loc in primitive_locations:\n                dist = abs(p_loc[0] - current_pos[0]) + abs(p_loc[1] - current_pos[1])\n                if dist < min_dist:\n                    min_dist = dist\n                    closest_target_pos = p_loc\n\n            # Decide next movement action based on the direction towards the closest target\n            # This is a greedy approach that prioritizes movement along the X-axis, then Y-axis.\n            # The environment's step function will handle collisions and grid boundaries.\n            dx = closest_target_pos[0] - current_pos[0]\n            dy = closest_target_pos[1] - current_pos[1]\n\n            if dx > 0: # Target is to the right\n                action_to_take = RIGHT\n            elif dx < 0: # Target is to the left\n                action_to_take = LEFT\n            elif dy > 0: # Target is down\n                action_to_take = DOWN\n            elif dy < 0: # Target is up\n                action_to_take = UP\n            else:\n                # Agent is on the target cell (dx=0, dy=0), but 'next_to' did not trigger 'USE'.\n                # This might happen if the primitive cannot be picked up directly from this spot\n                # or if it's not a grabbable item in the traditional sense.\n                # As a fallback, try a random movement to potentially reach a 'next_to' position or explore.\n                possible_moves = [UP, DOWN, LEFT, RIGHT]\n                action_to_take = np.random.choice(possible_moves)\n\n        else:\n            # The primitive is not found anywhere on the visible grid.\n            # This could mean it's truly not present for this scenario, or\n            # the task is impossible as configured. For collect_v2, a simple\n            # random exploration is a fallback.\n            possible_moves = [UP, DOWN, LEFT, RIGHT]\n            action_to_take = np.random.choice(possible_moves)\n\n        # 5. Execute the chosen movement action\n        if action_to_take != -1: # Ensure a valid action was chosen\n            reward, done, obs = env.step(action_to_take)\n            actions.append(action_to_take)\n            current_state = env._current_state # Update current_state after taking action\n            steps_taken_in_func += 1\n            if done: # If the environment signals completion (e.g., max_steps reached)\n                break\n        else:\n            # This case should ideally not be reached if the logic above is sound,\n            # but acts as a safeguard to prevent infinite loops if no action is chosen.\n            # print(\"Warning: No movement action chosen, breaking loop.\")\n            break\n            \n    return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:05:16.897636", "function_name": "collect", "function_body": "    current_state = env._current_state  # Access to the internal CraftState object\n    world = env.world\n\n    # Define action constants based on CraftLab.action_specs()\n    # These are typically imported from a constants file or defined globally.\n    # For this function, we define them locally for clarity.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Direction vectors for agent's facing direction (0:East, 1:North, 2:West, 3:South)\n    # DR[dir], DC[dir] give the relative coordinate of the cell directly in front\n    DR = [0, -1, 0, 1]  # Change in row for facing E, N, W, S\n    DC = [1, 0, -1, 0]  # Change in col for facing E, N, W, S\n\n    # 1. Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # 2. Check if the primitive can be collected/used\n    is_grabbable = primitive in world.grabbable_indices\n    is_workshop = primitive in world.workshop_indices\n    if not (is_grabbable or is_workshop):\n        # This primitive cannot be collected or used as per definitions\n        return []\n\n    # Get grid dimensions once for boundary checks\n    grid_width, grid_height, _ = current_state.grid.shape\n    \n    # 3. Check if primitive is at agent's current position and can be used immediately\n    agent_r, agent_c = current_state.pos\n    if current_state.grid[agent_r, agent_c, primitive] > 0:\n        # Primitive is on the same square as the agent. Assume 'USE' can interact with it.\n        return [ACTION_USE]\n\n    # BFS for pathfinding to reach a state where the primitive is directly in front\n    q = collections.deque()\n    # visited set stores (pos_tuple, dir_int) to prevent redundant explorations\n    visited = set()\n\n    # Initial state and path\n    initial_pos_tuple = current_state.pos\n    initial_dir_int = current_state.dir\n    initial_state_tuple_for_visited = (initial_pos_tuple, initial_dir_int)\n\n    q.append((current_state, []))  # (CraftState instance, list of actions to reach this state)\n    visited.add(initial_state_tuple_for_visited)\n\n    max_search_states = 5000  # Limit total number of unique states visited\n    max_path_length = 100    # Limit the length of any path explored\n\n    while q and len(visited) < max_search_states:\n        state, actions_taken = q.popleft()\n\n        # Check if the current state is a goal state: primitive is directly in front\n        curr_r, curr_c = state.pos\n        curr_dir = state.dir\n        facing_r, facing_c = curr_r + DR[curr_dir], curr_c + DC[curr_dir]\n\n        # Check bounds for the cell directly in front\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n            state.grid[facing_r, facing_c, primitive] > 0):\n            # Primitive is directly in front, return the path followed by a USE action\n            return actions_taken + [ACTION_USE]\n\n        # Heuristic to prevent excessively long paths for a single primitive collection.\n        # This helps prune the search space for unreachable or very distant items.\n        if len(actions_taken) >= max_path_length:\n            continue\n\n        # Explore neighbors (move forward, move backward, turn left, turn right)\n        possible_actions = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n        for action_id in possible_actions:\n            # Simulate the action to get the next state.\n            # CraftState.step creates a new CraftState instance, which is crucial for BFS.\n            _reward, next_state = state.step(action_id) \n            \n            next_pos_tuple = next_state.pos\n            next_dir_int = next_state.dir\n            next_state_tuple_for_visited = (next_pos_tuple, next_dir_int)\n\n            if next_state_tuple_for_visited not in visited:\n                visited.add(next_state_tuple_for_visited)\n                q.append((next_state, actions_taken + [action_id]))\n\n    # If the queue is exhausted or max search states reached without finding the primitive\n    return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:05:17.968953", "function_name": "collect", "function_body": "  # Constants for actions based on CraftLab.action_specs\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Check if the primitive is a grabbable item. If not, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get the current state from the environment\n  # We access `_current_state.pos` because `features_dict['pos']` is normalized.\n  current_pos = env._current_state.pos\n  current_x, current_y = current_pos\n  \n  # Get the global grid view to locate the primitive\n  grid = env.observations()['features_dict']['features_global']\n\n  target_coords = []\n  # Iterate through the grid to find all locations where the primitive exists\n  # Grid shape is (WIDTH, HEIGHT, n_kinds), so (x, y, kind) indexing.\n  for x in range(grid.shape[0]):\n    for y in range(grid.shape[1]):\n      if grid[x, y, primitive] == 1:\n        target_coords.append((x, y))\n\n  if not target_coords:\n    # The primitive is not found anywhere on the grid\n    return []\n\n  # Find the closest instance of the primitive using Manhattan distance\n  closest_target = None\n  min_dist = float('inf')\n\n  for tx, ty in target_coords:\n    dist = abs(tx - current_x) + abs(ty - current_y)\n    if dist < min_dist:\n      min_dist = dist\n      closest_target = (tx, ty)\n\n  if closest_target is None:\n    # This case should ideally not be reached if target_coords is not empty\n    return []\n\n  # Generate a sequence of actions to move to the closest target\n  actions = []\n  target_x, target_y = closest_target\n\n  # Move horizontally (X-axis) first\n  while current_x != target_x:\n    if current_x < target_x:\n      actions.append(ACTION_RIGHT)\n      current_x += 1\n    else: # current_x > target_x\n      actions.append(ACTION_LEFT)\n      current_x -= 1\n\n  # Then move vertically (Y-axis)\n  # Assuming UP decreases Y (moves towards top of array) and DOWN increases Y (moves towards bottom)\n  while current_y != target_y:\n    if current_y < target_y:\n      actions.append(ACTION_DOWN) \n      current_y += 1\n    else: # current_y > target_y\n      actions.append(ACTION_UP)\n      current_y -= 1\n\n  # Once at the target location, use the \"USE\" action to collect it.\n  # The `CraftState.next_to` method checks a 3x3 neighborhood, so being on the same cell\n  # as the item allows for the \"USE\" action.\n  actions.append(ACTION_USE)\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T04:06:48.400887", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  # 'features_global' provides the full grid (allocentric view)\n  current_grid = features_dict['features_global'] \n  current_pos = tuple(features_dict['pos']) # Agent's current (row, col) as a tuple\n  current_inventory = features_dict['inventory']\n\n  # Get world configuration for non-grabbable indices.\n  # The `env` (CraftLab) holds a reference to `world` (CraftWorld).\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n\n  # Check if the primitive is already in the inventory\n  if current_inventory[primitive] > 0:\n      return []\n\n  WIDTH, HEIGHT, n_kinds = current_grid.shape\n\n  # BFS queue: stores (position (tuple), list_of_actions_to_reach_here)\n  q = deque([(current_pos, [])]) \n  # Visited set: stores positions to avoid re-exploring paths\n  visited = {current_pos} \n\n  # Possible movements (action_constant, row_change, col_change)\n  # Based on DMLab-style actions: UP (decreasing row), DOWN (increasing row), etc.\n  move_actions = [\n      (env_factory.UP, -1, 0),    # Move Up\n      (env_factory.DOWN, 1, 0),   # Move Down\n      (env_factory.LEFT, 0, -1),  # Move Left\n      (env_factory.RIGHT, 0, 1),  # Move Right\n  ]\n\n  while q:\n      curr_pos, actions = q.popleft()\n      curr_r, curr_c = curr_pos\n\n      # Check if the current position is adjacent to (or on) the primitive\n      # This is based on CraftState.next_to's 3x3 neighborhood logic.\n      for dr_adj in [-1, 0, 1]:\n          for dc_adj in [-1, 0, 1]:\n              check_r, check_c = curr_r + dr_adj, curr_c + dc_adj\n              \n              # Ensure the checked cell is within grid boundaries\n              if 0 <= check_r < WIDTH and 0 <= check_c < HEIGHT:\n                  # Check if the primitive is present at this neighboring cell\n                  if current_grid[check_r, check_c, primitive] > 0:\n                      # Found the primitive in the neighborhood!\n                      # Add the USE action to the path and return it.\n                      return actions + [env_factory.USE]\n\n      # If the primitive is not in the current position's neighborhood, explore further\n      for action_val, dr_move, dc_move in move_actions:\n          next_r, next_c = curr_r + dr_move, curr_c + dc_move\n          next_pos = (next_r, next_c)\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n              continue # Skip if out of bounds\n\n          # Check if the next cell is blocked by a non-grabbable item\n          blocked = False\n          # Iterate through all kinds present at the next cell\n          for kind_idx_on_cell in range(n_kinds):\n              if current_grid[next_r, next_c, kind_idx_on_cell] > 0 and \\\n                 kind_idx_on_cell in non_grabbable_indices:\n                  blocked = True\n                  break # This cell is blocked, no need to check other kinds\n\n          # If the cell is not blocked and has not been visited, add to queue\n          if not blocked and next_pos not in visited:\n              visited.add(next_pos)\n              q.append((next_pos, actions + [action_val]))\n\n  # If the BFS queue becomes empty and no path is found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:06:48.477395", "function_name": "collect", "function_body": "    # Constants for actions and directions\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    DIR_N = 0\n    DIR_E = 1\n    DIR_S = 2\n    DIR_W = 3\n\n    DIR_VECTORS = {\n        DIR_N: (-1, 0),  # North: (row-1, col)\n        DIR_E: (0, 1),   # East: (row, col+1)\n        DIR_S: (1, 0),   # South: (row+1, col)\n        DIR_W: (0, -1)   # West: (row, col-1)\n    }\n\n    TURN_LEFT_MAP = {\n        DIR_N: DIR_W,\n        DIR_E: DIR_N,\n        DIR_S: DIR_E,\n        DIR_W: DIR_S\n    }\n\n    TURN_RIGHT_MAP = {\n        DIR_N: DIR_E,\n        DIR_E: DIR_S,\n        DIR_S: DIR_W,\n        DIR_W: DIR_N\n    }\n\n    # Helper functions (inlined to ensure self-containment per prompt)\n    def _normalize_pos_to_grid(normalized_pos, grid_shape):\n        rows, cols, _ = grid_shape\n        # normalized_pos is [y_norm, x_norm]\n        r = int(normalized_pos[0] * rows)\n        c = int(normalized_pos[1] * cols)\n        return r, c\n\n    def _one_hot_dir_to_int(one_hot_dir):\n        return np.argmax(one_hot_dir)\n\n    # Get initial observations from the environment\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    initial_grid = features_dict['features_global']\n    initial_pos_norm = features_dict['pos']\n    initial_dir_one_hot = features_dict['direction']\n    initial_inventory = features_dict['inventory']\n\n    # Convert initial position and direction to our internal (r, c) and int representation\n    grid_rows, grid_cols, _ = initial_grid.shape\n    initial_pos = _normalize_pos_to_grid(initial_pos_norm, initial_grid.shape)\n    initial_dir = _one_hot_dir_to_int(initial_dir_one_hot)\n\n    # Check if the primitive is already in inventory\n    if initial_inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # Get the index for 'wall' to use for obstacle avoidance in BFS\n    # Assuming 'wall' is a known entity in the cookbook's index\n    wall_index = env.world.cookbook.index.index('wall')\n\n    # BFS Queue: (current_pos, current_dir, actions_taken_so_far)\n    queue = collections.deque([(initial_pos, initial_dir, [])])\n\n    # Visited Set: (pos, dir) to avoid revisiting the same state\n    visited = set([(initial_pos, initial_dir)])\n\n    # Maximum steps for BFS to prevent infinite loops or excessively long searches\n    # Set to a reasonable upper bound based on grid size * directions states\n    MAX_BFS_STATES = grid_rows * grid_cols * 4 * 2 # Multiply by 2 for some buffer\n\n    while queue:\n        current_pos, current_dir, current_actions = queue.popleft()\n        r, c = current_pos\n\n        # Safety check to prevent extremely long searches if path is complex/impossible\n        if len(visited) > MAX_BFS_STATES:\n            break\n\n        # Check if we are adjacent to the primitive and can USE it\n        # Iterate through possible neighbor cells (N, E, S, W relative to current_pos)\n        for d_idx, (dr_n, dc_n) in DIR_VECTORS.items():\n            nr, nc = r + dr_n, c + dc_n\n\n            # Check bounds for the neighbor cell\n            if not (0 <= nr < grid_rows and 0 <= nc < grid_cols):\n                continue\n\n            # If the primitive is present in this adjacent cell\n            if initial_grid[nr, nc, primitive] > 0:\n                # We found a primitive. Calculate the required direction to face it.\n                # (dr_to_target, dc_to_target) is vector from agent's current_pos to primitive's pos\n                dr_to_target = nr - r\n                dc_to_target = nc - c\n\n                target_dir = -1\n                for d_val, (dr_v, dc_v) in DIR_VECTORS.items():\n                    if dr_v == dr_to_target and dc_v == dc_to_target:\n                        target_dir = d_val\n                        break\n                \n                if target_dir == -1: # Should not happen if neighbor cell is valid\n                    continue\n\n                # Generate actions to turn towards the target_dir\n                turn_actions = []\n                temp_dir = current_dir\n                # Find the shortest sequence of turns (max 2 turns)\n                # Check turn left first\n                if TURN_LEFT_MAP[temp_dir] == target_dir:\n                    turn_actions.append(ACTION_LEFT)\n                    temp_dir = TURN_LEFT_MAP[temp_dir]\n                elif TURN_RIGHT_MAP[temp_dir] == target_dir:\n                    turn_actions.append(ACTION_RIGHT)\n                    temp_dir = TURN_RIGHT_MAP[temp_dir]\n                elif TURN_LEFT_MAP[TURN_LEFT_MAP[temp_dir]] == target_dir:\n                    turn_actions.append(ACTION_LEFT)\n                    turn_actions.append(ACTION_LEFT)\n                    temp_dir = TURN_LEFT_MAP[TURN_LEFT_MAP[temp_dir]]\n                elif TURN_RIGHT_MAP[TURN_RIGHT_MAP[temp_dir]] == target_dir:\n                    turn_actions.append(ACTION_RIGHT)\n                    turn_actions.append(ACTION_RIGHT)\n                    temp_dir = TURN_RIGHT_MAP[TURN_RIGHT_MAP[temp_dir]]\n                \n                # If we are now facing the target, add USE and return the full action sequence\n                if temp_dir == target_dir:\n                    return current_actions + turn_actions + [ACTION_USE]\n\n        # Explore next possible states by applying movement and turn actions\n        \n        # 1. Try to Move Forward (ACTION_UP)\n        dr, dc = DIR_VECTORS[current_dir]\n        next_r_fwd, next_c_fwd = r + dr, c + dc\n        if 0 <= next_r_fwd < grid_rows and 0 <= next_c_fwd < grid_cols:\n            # Check if the next cell is not a wall\n            if initial_grid[next_r_fwd, next_c_fwd, wall_index] == 0:\n                next_pos_fwd = (next_r_fwd, next_c_fwd)\n                if (next_pos_fwd, current_dir) not in visited:\n                    visited.add((next_pos_fwd, current_dir))\n                    queue.append((next_pos_fwd, current_dir, current_actions + [ACTION_UP]))\n\n        # 2. Try to Move Backward (ACTION_DOWN)\n        dr_back, dc_back = -DIR_VECTORS[current_dir][0], -DIR_VECTORS[current_dir][1]\n        next_r_back, next_c_back = r + dr_back, c + dc_back\n        if 0 <= next_r_back < grid_rows and 0 <= next_c_back < grid_cols:\n            # Check if the next cell is not a wall\n            if initial_grid[next_r_back, next_c_back, wall_index] == 0:\n                next_pos_back = (next_r_back, next_c_back)\n                if (next_pos_back, current_dir) not in visited:\n                    visited.add((next_pos_back, current_dir))\n                    queue.append((next_pos_back, current_dir, current_actions + [ACTION_DOWN]))\n\n        # 3. Try to Turn Left (ACTION_LEFT)\n        next_dir_left = TURN_LEFT_MAP[current_dir]\n        if (current_pos, next_dir_left) not in visited:\n            visited.add((current_pos, next_dir_left))\n            queue.append((current_pos, next_dir_left, current_actions + [ACTION_LEFT]))\n\n        # 4. Try to Turn Right (ACTION_RIGHT)\n        next_dir_right = TURN_RIGHT_MAP[current_dir]\n        if (current_pos, next_dir_right) not in visited:\n            visited.add((current_pos, next_dir_right))\n            queue.append((current_pos, next_dir_right, current_actions + [ACTION_RIGHT]))\n\n    # If the queue becomes empty and the goal was not reached, return an empty list\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:09:09.926520", "function_name": "collect", "function_body": "    import collections\n\n    # Constants for actions (from CraftLab action_specs)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Map from (dr, dc) to action\n    DELTAS_TO_ACTION = {\n        (-1, 0): UP,\n        (1, 0): DOWN,\n        (0, -1): LEFT,\n        (0, 1): RIGHT,\n    }\n\n    # Offsets for neighbors (dr, dc) for movement\n    MOVEMENT_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # UP, DOWN, LEFT, RIGHT\n\n    def find_path_to_adjacent(grid, start_pos, target_kind, world):\n        \"\"\"\n        Finds the shortest path from start_pos to a cell adjacent to target_kind.\n        \n        Args:\n            grid (numpy.ndarray): The game grid (HEIGHT, WIDTH, n_kinds).\n            start_pos (tuple): Agent's starting (r, c) position.\n            target_kind (int): The index of the primitive to find.\n            world (CraftWorld): Reference to the CraftWorld instance for obstacle info.\n            \n        Returns:\n            tuple: (final_agent_pos, primitive_actual_pos, parent_map) if path found,\n                   else (None, None, None).\n            \n            final_agent_pos: The (r, c) cell where the agent should end up (adjacent to primitive).\n            primitive_actual_pos: The (r, c) cell where the primitive is located.\n            parent_map: A dict (child_pos -> (parent_pos, action_to_reach_child)).\n        \"\"\"\n        HEIGHT, WIDTH, _ = grid.shape\n        \n        # Define non-traversable kinds. Assume water and stone are always obstacles.\n        non_traversable_kinds = set()\n        if world.water_index is not None:\n            non_traversable_kinds.add(world.water_index)\n        if world.stone_index is not None:\n            non_traversable_kinds.add(world.stone_index)\n        \n        queue = collections.deque([(start_pos)]) # Queue stores (r, c)\n        visited = {start_pos}\n        \n        # To reconstruct path: (child_pos) -> (parent_pos, action_to_reach_child)\n        parent_map = {start_pos: (None, None)} \n\n        while queue:\n            r, c = queue.popleft()\n\n            # Check if the current cell (r,c) is adjacent to the target_kind\n            for dr_adj, dc_adj in MOVEMENT_DELTAS:\n                nr_adj, nc_adj = r + dr_adj, c + dc_adj\n                if 0 <= nr_adj < HEIGHT and 0 <= nc_adj < WIDTH:\n                    # Check if the adjacent cell contains the target_kind\n                    if grid[nr_adj, nc_adj, target_kind] > 0:\n                        # Found a path to (r,c) which is adjacent to the primitive at (nr_adj, nc_adj)!\n                        return (r, c), (nr_adj, nc_adj), parent_map\n\n            # Explore direct neighbors for movement\n            for dr_move, dc_move in MOVEMENT_DELTAS:\n                nr_move, nc_move = r + dr_move, c + dc_move\n                next_pos = (nr_move, nc_move)\n\n                if 0 <= nr_move < HEIGHT and 0 <= nc_move < WIDTH and next_pos not in visited:\n                    # Check traversability of next_pos\n                    is_traversable = True\n                    \n                    # Check for explicit obstacles (water, stone)\n                    for obstacle_idx in non_traversable_kinds:\n                        if grid[nr_move, nc_move, obstacle_idx] > 0:\n                            is_traversable = False\n                            break\n                    \n                    if is_traversable:\n                        visited.add(next_pos)\n                        parent_map[next_pos] = ((r, c), DELTAS_TO_ACTION[(dr_move, dc_move)])\n                        queue.append(next_pos)\n        \n        return None, None, None # No path found\n\n    def reconstruct_actions(start_pos, target_agent_pos, parent_map):\n        \"\"\"\n        Reconstructs the list of actions from the parent_map.\n        \"\"\"\n        actions = []\n        curr = target_agent_pos\n        \n        # Path reconstruction from target_agent_pos back to start_pos\n        # The loop condition curr != start_pos ensures we don't add the \"action\"\n        # that took us from start_pos to its first child (since start_pos's parent is None).\n        while parent_map[curr][0] is not None: \n            _, action = parent_map[curr]\n            actions.append(action)\n            curr = parent_map[curr][0]\n        \n        actions.reverse() # Actions are currently from target to start, reverse to be start to target\n        return actions\n\n\n    current_state = env._current_state\n\n    grid = current_state.grid\n    current_pos = current_state.pos\n\n    # Find the path to a cell adjacent to the primitive\n    final_agent_pos, primitive_pos, parent_map = find_path_to_adjacent(grid, current_pos, primitive, env.world)\n\n    if final_agent_pos is None:\n        # No path found to any cell adjacent to the primitive\n        return []\n\n    # Reconstruct the sequence of movement actions\n    actions = reconstruct_actions(current_pos, final_agent_pos, parent_map)\n\n    # After these actions, the agent will be at `final_agent_pos`.\n    # The last movement action taken will set the agent's internal direction\n    # to face the direction of that movement. If the agent moved towards the\n    # primitive (e.g., moved DOWN to be above a primitive), its direction\n    # will be correct for `USE`.\n    # If `actions` is empty, it means the agent is already at `final_agent_pos`.\n    # In this case, `USE` is appended directly, assuming the agent's current\n    # direction is appropriate for interacting with the adjacent primitive.\n\n    actions.append(USE)\n    \n    return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:09:10.955123", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  current_obs = env.observations()\n  current_state = env._current_state\n  \n  # 1. Check if primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  grid = current_obs['features_dict']['features_global']\n  agent_pos = current_obs['features_dict']['pos'] # (x, y)\n  initial_dir = current_state.dir # The current facing direction of the agent (e.g., UP, DOWN, LEFT, RIGHT action value)\n\n  # Get grid dimensions. Grid shape is (WIDTH, HEIGHT, n_kinds).\n  grid_width, grid_height, _ = grid.shape \n\n  # Find all locations of the primitive on the grid\n  # np.where returns (x_coords, y_coords) for a grid of shape (WIDTH, HEIGHT)\n  primitive_x_coords, primitive_y_coords = np.where(grid[:, :, primitive] == 1)\n\n  if len(primitive_x_coords) == 0:\n      # Primitive not found on the grid\n      return []\n\n  # Define constants for movement actions and their corresponding (dx, dy) vectors.\n  # The agent's direction after a move action becomes that action's value.\n  # The 'USE' action interacts with the cell the agent is facing.\n  MOVE_ACTIONS = [\n      (0, 1, env_factory.ACTIONS['DOWN']),  # (dx, dy, action_value)\n      (0, -1, env_factory.ACTIONS['UP']),\n      (-1, 0, env_factory.ACTIONS['LEFT']),\n      (1, 0, env_factory.ACTIONS['RIGHT']),\n  ]\n\n  # Map of (dx, dy) vector from agent to target, to the action an agent needs to have taken\n  # to face that target. For example, if target is at (x+1, y) relative to agent, agent must\n  # have moved 'RIGHT' to get into position to face it.\n  _RELATIVE_VEC_TO_FACING_ACTION = {\n      (1, 0): env_factory.ACTIONS['RIGHT'], # Target is to the right\n      (-1, 0): env_factory.ACTIONS['LEFT'], # Target is to the left\n      (0, 1): env_factory.ACTIONS['DOWN'],  # Target is below\n      (0, -1): env_factory.ACTIONS['UP'],   # Target is above\n  }\n\n  # Calculate all possible goal states: ((adjacent_x, adjacent_y), action_to_face_primitive)\n  # A goal state is a position and a direction from which the agent can successfully USE the primitive.\n  all_goal_states = set()\n  for i in range(len(primitive_x_coords)):\n      px, py = primitive_x_coords[i], primitive_y_coords[i]\n      \n      # Consider all 4 adjacent cells to the primitive (px, py)\n      # For each adjacent cell, determine what action the agent must have taken to arrive there\n      # and consequently be facing the primitive.\n      \n      # Adjacent cell: (px - 1, py) - if agent is here, it needs to face RIGHT (towards px,py)\n      all_goal_states.add(((px - 1, py), env_factory.ACTIONS['RIGHT']))\n      # Adjacent cell: (px + 1, py) - if agent is here, it needs to face LEFT (towards px,py)\n      all_goal_states.add(((px + 1, py), env_factory.ACTIONS['LEFT']))\n      # Adjacent cell: (px, py - 1) - if agent is here, it needs to face DOWN (towards px,py)\n      all_goal_states.add(((px, py - 1), env_factory.ACTIONS['DOWN']))\n      # Adjacent cell: (px, py + 1) - if agent is here, it needs to face UP (towards px,py)\n      all_goal_states.add(((px, py + 1), env_factory.ACTIONS['UP']))\n\n  q = collections.deque()\n  # Visited set stores (position_tuple, direction_value) to avoid cycles and redundant paths\n  visited = set()\n\n  start_pos_tuple = tuple(agent_pos) # Convert numpy array to tuple for hashing\n  \n  q.append((start_pos_tuple, initial_dir, [])) # (current_pos, current_direction, path_taken_so_far)\n  visited.add((start_pos_tuple, initial_dir))\n\n  # Get indices of blocking elements from the world\n  # Assuming stone_index and water_index are non-traversable if present.\n  world = current_state.world\n  blocking_indices = set()\n  if world.stone_index is not None:\n      blocking_indices.add(world.stone_index)\n  if world.water_index is not None: # Water might be a block in some configurations\n      blocking_indices.add(world.water_index)\n\n  while q:\n      curr_pos, curr_dir, curr_path = q.popleft()\n      cx, cy = curr_pos\n\n      # Check if the current state (position, direction) is one of our goal states.\n      # This means we are adjacent to the primitive and correctly oriented to USE it.\n      if (curr_pos, curr_dir) in all_goal_states:\n          return curr_path + [env_factory.ACTIONS['USE']]\n\n      # Explore possible moves\n      for dx, dy, action in MOVE_ACTIONS:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n          next_dir = action # Agent's direction after executing 'action' and moving to 'next_pos'\n\n          # Check bounds\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Check traversability: Is the next cell blocked by an untraversable object?\n          is_blocked = False\n          for block_idx in blocking_indices:\n              # Check if the next cell contains a blocking item\n              if grid[next_x, next_y, block_idx] == 1:\n                  is_blocked = True\n                  break\n          \n          if is_blocked:\n              continue\n\n          # If this state (position and direction) has not been visited, add it to queue\n          if (next_pos, next_dir) not in visited:\n              q.append((next_pos, next_dir, curr_path + [action]))\n              visited.add((next_pos, next_dir))\n\n  # If the queue is empty and no path to collect the primitive was found\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:10:47.770199", "function_name": "collect", "function_body": "    # Action constants as defined by CraftLab.action_specs\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    current_state = env._current_state\n\n    # If the primitive is already in the inventory, no actions are needed.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Initialize a deque for BFS, storing tuples of (CraftState, list_of_actions_taken_to_reach_this_state).\n    # We use __import__('collections').deque to adhere to the \"no imports\" constraint within the function body.\n    queue = __import__('collections').deque([(current_state, [])])\n\n    # A set to keep track of visited states to prevent infinite loops and redundant computation.\n    # A state for pathfinding is uniquely identified by its position and direction.\n    # The grid and inventory are assumed to be static during movement phase.\n    visited = set()\n    visited.add((current_state.pos, current_state.dir))\n\n    # Define possible movement actions.\n    movement_actions = [_DOWN, _UP, _LEFT, _RIGHT]\n\n    while queue:\n        state, actions_path = queue.popleft()\n\n        # Check if the current state is adjacent to the primitive.\n        # If so, we can perform the USE action to collect it.\n        if state.next_to(primitive):\n            return actions_path + [_USE]\n\n        # Explore all possible next states by performing each movement action.\n        for action in movement_actions:\n            # Simulate the step using CraftState.step. This returns a tuple (reward, new_state).\n            # The reward is not relevant for pathfinding, so we only care about the new_state.\n            _, next_state = state.step(action)\n\n            # Create a hashable representation of the next state (position and direction).\n            next_state_hash = (next_state.pos, next_state.dir)\n\n            # If this state has not been visited before, add it to the queue and visited set.\n            if next_state_hash not in visited:\n                visited.add(next_state_hash)\n                queue.append((next_state, actions_path + [action]))\n\n    # If the queue becomes empty and no path to the primitive was found, it's unreachable.\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:10:47.842309", "function_name": "collect", "function_body": "    # Start with the current state of the environment\n    initial_state = env._current_state\n    \n    # If the primitive is already in inventory, no actions needed\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions and obstacle indices\n    grid = initial_state.grid\n    H, W, _ = grid.shape\n    non_grabbable_indices = initial_state.world.non_grabbable_indices\n    \n    # Define action constants (standard for CraftWorld)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Direction to (dr, dc) offset mapping\n    # Assuming 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT for agent's facing direction\n    DIR_TO_OFFSET = {\n        0: (-1, 0),  # UP (North)\n        1: (0, 1),   # RIGHT (East)\n        2: (1, 0),   # DOWN (South)\n        3: (0, -1),  # LEFT (West)\n    }\n\n    # Find all locations of the primitive on the grid\n    primitive_locations = []\n    for r in range(H):\n        for c in range(W):\n            if grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        # Primitive not found on the map, cannot collect\n        return []\n\n    # BFS state: (row, col, direction, path_actions_list)\n    # The BFS explores possible (position, direction) states and the actions to reach them.\n    queue = collections.deque([(initial_state.pos[0], initial_state.pos[1], initial_state.dir, [])])\n    \n    # Visited states: (row, col, direction) to avoid cycles and re-exploring\n    visited = set([(initial_state.pos[0], initial_state.pos[1], initial_state.dir)])\n\n    # Cap the BFS search depth to prevent excessive computation for very large or complex maps\n    # and to avoid infinite loops if the primitive is unreachable.\n    max_search_states = 5000 \n    num_search_states = 0\n\n    while queue and num_search_states < max_search_states:\n        r, c, d, path_actions = queue.popleft()\n        num_search_states += 1\n\n        # Check if the current state allows for collecting the primitive with USE action\n        # The agent must be facing an adjacent cell that contains the primitive.\n        target_r, target_c = r + DIR_TO_OFFSET[d][0], c + DIR_TO_OFFSET[d][1]\n        if (target_r, target_c) in primitive_locations:\n            # We found a path to a state from which we can successfully USE the primitive.\n            return path_actions + [USE]\n\n        # Explore possible next states by trying all movement actions (DOWN, UP, LEFT, RIGHT)\n        for action in [DOWN, UP, LEFT, RIGHT]:\n            # Simulate the effect of the action on the agent's position and direction.\n            # This logic mimics CraftState.step for movement.\n            \n            next_r, next_c = r, c # Default if collision occurs\n            next_d = d           # Default if no collision occurs\n\n            move_dr, move_dc = 0, 0\n            if action == UP: move_dr = -1\n            elif action == DOWN: move_dr = 1\n            elif action == LEFT: move_dc = -1\n            elif action == RIGHT: move_dc = 1\n\n            attempt_nr, attempt_nc = r + move_dr, c + move_dc\n\n            is_blocked = False\n            # Check grid boundaries\n            if not (0 <= attempt_nr < H and 0 <= attempt_nc < W):\n                is_blocked = True\n            else:\n                # Check for non-grabbable obstacles at the attempted destination\n                # A cell is considered blocked if it contains any non-grabbable item.\n                for idx in non_grabbable_indices:\n                    if grid[attempt_nr, attempt_nc, idx] > 0:\n                        is_blocked = True\n                        break\n            \n            if is_blocked:\n                # As per CraftWorld rules: if an attempted move collides with a wall\n                # (non-grabbable entity or grid boundary), the agent stays in place\n                # but its direction rotates 90 degrees clockwise.\n                next_pos = (r, c)\n                next_d = (d + 1) % 4 # Clockwise rotation\n            else:\n                # Agent moves successfully, direction remains the same.\n                next_pos = (attempt_nr, attempt_nc)\n                next_d = d\n            \n            # Form the key for the next state and check if visited\n            next_state_key = (next_pos[0], next_pos[1], next_d)\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                queue.append((next_pos[0], next_pos[1], next_d, path_actions + [action]))\n\n    # If the BFS completes (either queue is empty or max_search_states reached)\n    # without finding a path to collect the primitive, return an empty list.\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:11:49.165672", "function_name": "collect", "function_body": "  actions_taken = []\n  MAX_COLLECT_STEPS = 200 # A reasonable limit to prevent infinite loops\n\n  # Action constants (standard for CraftWorld DMLab environment)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  for _ in range(MAX_COLLECT_STEPS):\n    # Get the current state from the environment\n    # env._current_state is a CraftState instance\n    current_state = env._current_state\n\n    # Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n      break # Goal achieved\n\n    # Check if the agent is next to the primitive\n    if current_state.next_to(primitive):\n      # If next to it, perform the USE action\n      _, _, _ = env.step(USE)\n      actions_taken.append(USE)\n      # After USE, re-check inventory in the next iteration.\n      # This handles cases where USE might not immediately collect (e.g., if it's a crafting station).\n      # If it's a grabbable primitive, it should be collected.\n      continue # Re-evaluate state in the next loop iteration\n\n    # If not next to the primitive, find its closest location on the grid\n    grid = current_state.grid\n    current_pos = current_state.pos # Agent's current (x, y) position\n\n    # Grid dimensions: (HEIGHT, WIDTH, N_KINDS)\n    grid_height, grid_width, _ = grid.shape\n\n    closest_primitive_pos = None\n    min_distance = float('inf')\n\n    # Iterate through the grid to find the closest instance of the primitive\n    for y in range(grid_height):\n      for x in range(grid_width):\n        if grid[y, x, primitive] > 0: # Check if this cell contains the primitive\n          # Calculate Manhattan distance\n          dist = abs(x - current_pos[0]) + abs(y - current_pos[1])\n          if dist < min_distance:\n            min_distance = dist\n            closest_primitive_pos = (x, y)\n\n    if closest_primitive_pos is None:\n      # The primitive is not found anywhere on the map.\n      # This scenario might be unachievable or indicate a problem.\n      # Stop trying to collect it.\n      break\n\n    # Determine the best movement action to move towards the closest primitive\n    target_x, target_y = closest_primitive_pos\n    current_x, current_y = current_pos\n\n    action_to_take = -1 # Initialize with an invalid action\n\n    # Prioritize moving in the dimension with the larger difference to close distance faster\n    if abs(target_x - current_x) >= abs(target_y - current_y):\n      # Move horizontally\n      if target_x > current_x:\n        action_to_take = RIGHT\n      elif target_x < current_x:\n        action_to_take = LEFT\n      # If x-coordinates are the same, try moving vertically\n      elif target_y > current_y:\n        action_to_take = DOWN\n      elif target_y < current_y:\n        action_to_take = UP\n    else:\n      # Move vertically\n      if target_y > current_y:\n        action_to_take = DOWN\n      elif target_y < current_y:\n        action_to_take = UP\n      # If y-coordinates are the same, try moving horizontally\n      elif target_x > current_x:\n        action_to_take = RIGHT\n      elif target_x < current_x:\n        action_to_take = LEFT\n    \n    # If no movement action was chosen (e.g., agent is at target_pos but next_to didn't trigger USE,\n    # or the item isn't grabbable/collectible this way), break to prevent infinite loop.\n    if action_to_take == -1:\n        break\n\n    # Apply the chosen movement action\n    _, _, _ = env.step(action_to_take)\n    actions_taken.append(action_to_take)\n\n  return actions_taken", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:11:49.234078", "function_name": "collect", "function_body": "    from collections import deque\n\n    # Define actions locally as per action_specs for clarity and self-containment\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    initial_state = env._current_state # Get the current state of the environment from the CraftLab environment\n\n    q = deque()\n    # The queue stores tuples: (current_craft_state_object, list_of_actions_taken_to_reach_this_state)\n    q.append((initial_state, []))\n\n    # Visited set to store unique hashable representations of states.\n    # A state is defined by (agent_position_tuple, agent_direction_int, has_primitive_in_inventory_bool).\n    # This simplifies the state space by only tracking the essential inventory change (presence of the target primitive).\n    visited_states = set()\n\n    # Add the initial state to the visited set\n    initial_has_primitive = initial_state.inventory[primitive] > 0\n    initial_visited_key = (initial_state.pos, initial_state.dir, initial_has_primitive)\n    visited_states.add(initial_visited_key)\n\n    # A heuristic limit to prevent excessively long searches on complex or unreachable maps.\n    # Adjust this value based on the expected maximum path length.\n    max_iterations = 5000 \n    current_iter = 0\n\n    while q and current_iter < max_iterations:\n        current_iter += 1\n        current_craft_state, actions_taken = q.popleft()\n\n        # Check if the primitive is collected (goal reached)\n        if current_craft_state.inventory[primitive] > 0:\n            return actions_taken\n\n        # Explore all possible next actions (Movement: DOWN, UP, LEFT, RIGHT; Interaction: USE)\n        for action in [_DOWN, _UP, _LEFT, _RIGHT, _USE]:\n            # Simulate the action to get the next state.\n            # CraftState.step returns (reward, new_state).\n            # The reward is always 0.0 for movement/use actions in this implementation.\n            _, next_craft_state = current_craft_state.step(action)\n\n            # Determine the visited key for the next state\n            next_has_primitive = next_craft_state.inventory[primitive] > 0\n            next_visited_key = (next_craft_state.pos, next_craft_state.dir, next_has_primitive)\n\n            # If this state has not been visited before (with the same primitive collection status),\n            # add it to the queue for further exploration.\n            if next_visited_key not in visited_states:\n                visited_states.add(next_visited_key)\n                new_actions_list = actions_taken + [action]\n                q.append((next_craft_state, new_actions_list))\n\n    # If the queue is exhausted and the primitive has not been collected,\n    # or the maximum iteration limit has been reached, it means the primitive is\n    # unreachable or the path is too long given the current search constraints.\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:14:14.877248", "function_name": "collect", "function_body": "    actions_list = []\n    MAX_COLLECT_STEPS = 2000\n\n    # Get action mappings from the environment\n    action_map = env.action_specs()\n    UP = action_map['UP']\n    DOWN = action_map['DOWN']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    # Map cardinal directions (0:N, 1:E, 2:S, 3:W) to (dr, dc) deltas\n    DIR_TO_DELTAS = {\n        0: (-1, 0),  # North (UP)\n        1: (0, 1),   # East (RIGHT)\n        2: (1, 0),   # South (DOWN)\n        3: (0, -1)   # West (LEFT)\n    }\n\n    # Map (dr, dc) deltas to cardinal directions\n    DELTAS_TO_DIR = {v: k for k, v in DIR_TO_DELTAS.items()}\n\n    for _ in range(MAX_COLLECT_STEPS):\n        current_state = env._current_state\n\n        # 1. Check if the primitive is already in inventory\n        if current_state.inventory[primitive] > 0:\n            break  # Goal achieved, exit loop\n\n        pos_r, pos_c = current_state.pos\n        grid = current_state.grid\n        GRID_HEIGHT, GRID_WIDTH, _ = grid.shape # Get grid dimensions\n\n        # 2. Find the closest location of the primitive in the grid\n        primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n        if len(primitive_locations) == 0:\n            # Primitive not found in the world (or already collected/destroyed)\n            return actions_list  # Cannot collect\n\n        # Find the closest primitive target cell (Manhattan distance)\n        min_dist_to_prim = float('inf')\n        closest_prim_r, closest_prim_c = -1, -1\n        for r, c in primitive_locations:\n            dist = abs(r - pos_r) + abs(c - pos_c)\n            if dist < min_dist_to_prim:\n                min_dist_to_prim = dist\n                closest_prim_r, closest_prim_c = r, c\n\n        # 3. Determine if the agent is adjacent to the primitive and needs to USE\n        dr_to_prim = closest_prim_r - pos_r\n        dc_to_prim = closest_prim_c - pos_c\n        \n        # If the agent is currently a cardinal neighbor to the primitive (Manhattan distance 1)\n        if abs(dr_to_prim) + abs(dc_to_prim) == 1:\n            # Determine the cardinal direction from agent to primitive (e.g., if primitive is North, (-1, 0) -> 0)\n            target_prim_direction = DELTAS_TO_DIR.get((dr_to_prim, dc_to_prim))\n            \n            if target_prim_direction is not None:\n                if current_state.dir == target_prim_direction:\n                    # Agent is facing the primitive, USE it!\n                    action_to_take = USE\n                    _, _, _ = env.step(action_to_take)\n                    actions_list.append(action_to_take)\n                    continue  # Re-evaluate state immediately (check inventory)\n                else:\n                    # Agent is adjacent but not facing. Need to 'turn' by performing a movement action\n                    # that sets the agent's facing direction. This will move the agent onto the primitive's cell.\n                    action_to_take = None\n                    if target_prim_direction == 0: action_to_take = UP\n                    elif target_prim_direction == 1: action_to_take = RIGHT\n                    elif target_prim_direction == 2: action_to_take = DOWN\n                    elif target_prim_direction == 3: action_to_take = LEFT\n                    \n                    if action_to_take is not None:\n                        _, _, _ = env.step(action_to_take)\n                        actions_list.append(action_to_take)\n                        continue # Re-evaluate state (agent is now on primitive, facing correct direction)\n            # If target_prim_direction is None, it means the primitive is not a cardinal neighbor,\n            # which contradicts min_dist_to_prim == 1. This path should ideally not be hit.\n            # If it is, consider it an uncollectible state for this function.\n\n        # 4. If not adjacent to the primitive (or not yet ready to USE), pathfind to an adjacent empty cell.\n        \n        # Find the best empty adjacent cell to the closest primitive, which is itself closest to the agent\n        best_target_adj_pos = None\n        min_dist_to_adj_from_agent = float('inf')\n        \n        # Possible relative moves (N, S, W, E) from a primitive to an adjacent cell\n        cardinal_offsets = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n        \n        for r_off, c_off in cardinal_offsets:\n            adj_r, adj_c = closest_prim_r + r_off, closest_prim_c + c_off\n            \n            # Check bounds\n            if not (0 <= adj_r < GRID_HEIGHT and 0 <= adj_c < GRID_WIDTH):\n                continue\n\n            # Check if cell is \"empty\" (contains no items, so it's walkable)\n            # Assuming an empty cell has all its feature channels summing to 0\n            is_empty_cell = (np.sum(grid[adj_r, adj_c, :]) == 0)\n            \n            if is_empty_cell:\n                # Calculate Manhattan distance from agent's current position to this potential staging cell\n                dist_to_staging_cell = abs(adj_r - pos_r) + abs(adj_c - pos_c)\n                if dist_to_staging_cell < min_dist_to_adj_from_agent:\n                    min_dist_to_adj_from_agent = dist_to_staging_cell\n                    best_target_adj_pos = (adj_r, adj_c)\n\n        if best_target_adj_pos is None:\n            # No walkable adjacent cell to the primitive, or primitive is isolated/blocked.\n            return actions_list # Cannot reach\n\n        # Pathfind towards best_target_adj_pos (greedy Manhattan distance reduction)\n        path_dr = best_target_adj_pos[0] - pos_r\n        path_dc = best_target_adj_pos[1] - pos_c\n\n        action_to_take = None\n        if path_dr != 0: # Prioritize vertical movement if needed\n            action_to_take = UP if path_dr < 0 else DOWN\n        elif path_dc != 0: # Otherwise, horizontal movement\n            action_to_take = LEFT if path_dc < 0 else RIGHT\n        # else: If action_to_take is None here, it means (pos_r, pos_c) == best_target_adj_pos.\n        # This implies the agent is already at the optimal staging cell next to the primitive.\n        # The loop will naturally re-enter the top `if abs(dr_to_prim) + abs(dc_to_prim) == 1:` block\n        # in the next iteration to handle facing and using.\n\n        if action_to_take is not None:\n            _, _, _ = env.step(action_to_take)\n            actions_list.append(action_to_take)\n        # If no action was taken, the loop proceeds to the next iteration to re-evaluate the state.\n\n    return actions_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:14:14.948825", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Actions (as defined in CraftLab.action_specs)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Direction deltas (N, E, S, W)\n    _DIR_DELTAS = {\n        0: (-1, 0),  # North (row-1, col)\n        1: (0, 1),   # East (row, col+1)\n        2: (1, 0),   # South (row+1, col)\n        3: (0, -1),  # West (row, col-1)\n    }\n\n    def _get_next_pos_dir(r, c, d, action, grid_shape):\n        \"\"\"Simulates agent movement in the grid and returns the next (row, col, dir).\n        Returns None if the move is invalid (e.g., out of bounds).\n        \"\"\"\n        next_r, next_c, next_d = r, c, d\n        moved = False\n\n        if action == UP:\n            dr, dc = _DIR_DELTAS[d]\n            next_r, next_c = r + dr, c + dc\n            moved = True\n        elif action == DOWN:\n            # Move backward relative to current direction\n            dr, dc = _DIR_DELTAS[d]\n            next_r, next_c = r - dr, c - dc\n            moved = True\n        elif action == LEFT:\n            next_d = (d - 1) % 4\n        elif action == RIGHT:\n            next_d = (d + 1) % 4\n        # The USE action does not change the agent's position or direction,\n        # so no explicit logic is needed here for pathfinding.\n\n        # Check boundaries if the agent moved\n        if moved:\n            max_r, max_c = grid_shape\n            if not (0 <= next_r < max_r and 0 <= next_c < max_c):\n                return None # Invalid move, agent would go out of bounds\n\n        return (next_r, next_c, next_d)\n\n    # Get the current state information from the CraftLab environment\n    current_state = env._current_state\n    initial_grid = current_state.grid\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir # Agent's initial direction (0:N, 1:E, 2:S, 3:W)\n    world = env.world # CraftWorld instance, contains info about grabbable items\n\n    grid_shape = initial_grid.shape[:2] # (WIDTH, HEIGHT) for grid boundaries\n    max_r, max_c = grid_shape\n\n    # Determine if the target primitive is grabbable (can be picked up by moving onto its cell)\n    # Non-grabbable items typically require a 'USE' action when adjacent and facing them.\n    is_grabbable = primitive in world.grabbable_indices\n\n    # Initialize Breadth-First Search (BFS) for pathfinding\n    queue = collections.deque()\n    # Each item in the queue is a tuple: ((row, col, direction), [list_of_actions_taken])\n    queue.append(((initial_pos[0], initial_pos[1], initial_dir), []))\n\n    # Keep track of visited states to avoid cycles and redundant exploration\n    visited = set()\n    visited.add((initial_pos[0], initial_pos[1], initial_dir))\n\n    best_path = [] # This will store the sequence of actions to return\n\n    while queue:\n        (r, c, d), path = queue.popleft()\n\n        # Check if the current state satisfies the goal condition\n        if is_grabbable:\n            # If the primitive is grabbable, the goal is to be on its cell.\n            if initial_grid[r, c, primitive] > 0:\n                best_path = path\n                break # Goal found, shortest path guaranteed by BFS\n        else:\n            # If the primitive is non-grabbable, the goal is to be adjacent\n            # to it and facing it, then use the 'USE' action.\n            dr_front, dc_front = _DIR_DELTAS[d] # Coordinates of the cell directly in front\n            front_r, front_c = r + dr_front, c + dc_front\n\n            # Ensure the cell in front is within grid boundaries before checking its content\n            if 0 <= front_r < max_r and 0 <= front_c < max_c:\n                if initial_grid[front_r, front_c, primitive] > 0:\n                    best_path = path + [USE] # Append USE action\n                    break # Goal found\n\n        # Explore possible next actions (movement and rotation)\n        for action in [UP, DOWN, LEFT, RIGHT]:\n            next_state = _get_next_pos_dir(r, c, d, action, grid_shape)\n\n            if next_state is None: # Skip if the move is invalid (e.g., hits a boundary)\n                continue\n\n            # For this problem, we assume all valid grid cells are traversable.\n            # If there were explicit \"wall\" or \"impassable\" kinds in the grid,\n            # additional checks would be needed here.\n\n            if next_state not in visited:\n                visited.add(next_state)\n                queue.append((next_state, path + [action]))\n\n    return best_path", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:15:27.438762", "function_name": "collect", "function_body": "", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:15:28.415979", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction vectors for actions (dx, dy)\n  # Maps action to the (dx, dy) change in position it causes.\n  # UP: (0, -1) - moves along y-axis, decreasing y\n  # RIGHT: (1, 0) - moves along x-axis, increasing x\n  # DOWN: (0, 1) - moves along y-axis, increasing y\n  # LEFT: (-1, 0) - moves along x-axis, decreasing x\n  DIRS_VEC = {\n      ACTION_UP: (0, -1),\n      ACTION_RIGHT: (1, 0),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0)\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  current_pos = env._current_state.pos\n  current_x, current_y = current_pos\n  grid = env.observations()['features_dict']['features_global']\n  grid_width, grid_height, _ = grid.shape\n\n  # Helper function to check if a grid cell is within bounds and not an obstacle.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # Check if the cell is occupied by a non-grabbable item (which acts as an obstacle).\n    for k_idx in env.world.non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # 2. Locate Primitive and Identify Candidate Agent Positions + Final Actions.\n  # The agent needs to move to a 'pre-final' position, then take a final step\n  # that places it in an 'adjacent' cell to the primitive and also makes it\n  # face the primitive. Then the 'USE' action can be performed.\n  #\n  # Structure: (pre_final_x, pre_final_y, final_action_to_take, manhattan_dist_from_current_pos)\n  candidate_approaches = []\n\n  # Iterate through the grid to find all locations where the primitive exists.\n  for px in range(grid_width):\n    for py in range(grid_height):\n      if grid[px, py, primitive] == 1: # Found a primitive at (px, py)\n        # Consider all 4 directions from which the agent can approach and 'USE' the item.\n        # For each such approach, we determine:\n        # 1. (ax, ay): The cell the agent will occupy right before using (adjacent to primitive).\n        # 2. final_action: The action the agent takes to reach (ax, ay) while facing (px, py).\n        # 3. (pf_ax, pf_ay): The 'pre-final' position from which the agent will take 'final_action'.\n\n        # Option 1: Agent faces UP (ACTION_UP)\n        # Agent position: (px, py+1), pre-final position: (px, py+2)\n        potential_approaches = [\n            (px, py + 2, ACTION_UP),    # Agent moves UP from (px, py+2) to (px, py+1), facing UP\n            (px - 2, py, ACTION_RIGHT), # Agent moves RIGHT from (px-2, py) to (px-1, py), facing RIGHT\n            (px, py - 2, ACTION_DOWN),  # Agent moves DOWN from (px, py-2) to (px, py-1), facing DOWN\n            (px + 2, py, ACTION_LEFT)   # Agent moves LEFT from (px+2, py) to (px+1, py), facing LEFT\n        ]\n\n        for pf_ax, pf_ay, final_action in potential_approaches:\n          # Check if the 'pre-final' position (pf_ax, pf_ay) is a walkable cell.\n          if is_walkable(pf_ax, pf_ay):\n            # Calculate the cell (ax, ay) that the agent will occupy AFTER taking the 'final_action'.\n            # This is the cell adjacent to the primitive where the agent will stand to 'USE' it.\n            target_ax = pf_ax + DIRS_VEC[final_action][0]\n            target_ay = pf_ay + DIRS_VEC[final_action][1]\n\n            # Ensure this 'target' agent cell is walkable AND does not contain the primitive itself\n            # (as we are picking up an item adjacent to us, not on our cell).\n            if is_walkable(target_ax, target_ay) and grid[target_ax, target_ay, primitive] == 0:\n              dist = abs(pf_ax - current_x) + abs(pf_ay - current_y)\n              candidate_approaches.append((pf_ax, pf_ay, final_action, dist))\n\n  if not candidate_approaches:\n    return [] # No reachable primitive instance found.\n\n  # 3. Find the best approach: the candidate with the shortest Manhattan distance\n  # from the current agent position to the 'pre-final' position.\n  candidate_approaches.sort(key=lambda x: x[3])\n  best_pf_ax, best_pf_ay, best_final_action, _ = candidate_approaches[0]\n\n  # 4. Generate a sequence of actions to reach the best 'pre-final' position.\n  actions = []\n  temp_x, temp_y = current_x, current_y\n\n  # Move horizontally (X-axis) first.\n  while temp_x != best_pf_ax:\n    if temp_x < best_pf_ax:\n      actions.append(ACTION_RIGHT)\n      temp_x += 1\n    else: # temp_x > best_pf_ax\n      actions.append(ACTION_LEFT)\n      temp_x -= 1\n\n  # Then move vertically (Y-axis).\n  while temp_y != best_pf_ay:\n    if temp_y < best_pf_ay:\n      actions.append(ACTION_DOWN)\n      temp_y += 1\n    else: # temp_y > best_pf_ay\n      actions.append(ACTION_UP)\n      temp_y -= 1\n\n  # 5. Append the 'final_action' (to move to the adjacent cell and face the primitive)\n  # and then the 'USE' action to collect the primitive.\n  actions.append(best_final_action)\n  actions.append(ACTION_USE)\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T04:16:59.664776", "function_name": "collect", "function_body": "  actions = []\n  MAX_COLLECT_STEPS = 200  # Safety limit to prevent infinite loops\n\n  for _ in range(MAX_COLLECT_STEPS):\n    current_state = env._current_state\n\n    # 1. Check if the primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n      break  # Goal achieved, stop collecting\n\n    chosen_action = None\n\n    # 2. Check if the primitive is in the agent's 3x3 neighborhood\n    if current_state.next_to(primitive):\n      # If next to the primitive, assume 'USE' action will collect it\n      # This simplifies the logic by assuming USE acts on any adjacent primitive,\n      # or that the agent's direction is automatically aligned by prior movement.\n      # For v2, we prioritize direct interaction once adjacent.\n      chosen_action = 4  # USE action\n    else:\n      # 3. If not next to, find the closest primitive and move towards it\n      grid = current_state.grid\n      agent_x, agent_y = current_state.pos\n\n      # Find all locations of the primitive on the grid\n      primitive_locs = np.argwhere(grid[:, :, primitive] == 1)\n\n      if len(primitive_locs) == 0:\n        # Primitive not found anywhere on the grid, cannot collect\n        break\n\n      # Find the closest primitive location using Manhattan distance\n      closest_loc = None\n      min_dist = float('inf')\n      for py, px in primitive_locs:\n        dist = abs(px - agent_x) + abs(py - agent_y)\n        if dist < min_dist:\n          min_dist = dist\n          closest_loc = (px, py)  # Store as (x, y) for consistency\n\n      target_x, target_y = closest_loc\n\n      # Calculate relative position to the target\n      dx = target_x - agent_x\n      dy = target_y - agent_y\n\n      # Determine the movement action (prioritize larger dimension for movement)\n      if abs(dx) > abs(dy):\n        # Move horizontally\n        if dx > 0:\n          chosen_action = 3  # RIGHT\n        else:\n          chosen_action = 2  # LEFT\n      else:\n        # Move vertically (or equally horizontally/vertically, default to vertical)\n        if dy > 0:\n          chosen_action = 0  # DOWN\n        else:\n          chosen_action = 1  # UP\n\n    if chosen_action is not None:\n      # Execute the chosen action and record it\n      env.step(chosen_action)\n      actions.append(chosen_action)\n    else:\n      # No action could be determined (e.g., no primitive found or already on it)\n      break\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:17:00.665098", "function_name": "collect", "function_body": "  # Action constants (from CraftLab.action_specs)\n  # These are defined locally within the function to adhere to the prompt's\n  # requirement of returning \"only the code that will be inside the function\".\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Movement deltas corresponding to actions (row_change, col_change)\n  # Used for navigating the agent within the grid.\n  ACTION_DELTAS = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1),\n  }\n\n  # 3x3 neighborhood offsets (including the center (0,0) itself)\n  # Used to check if the agent is \"next to\" an item for the USE action,\n  # as per the CraftState.next_to description.\n  NEIGHBOR_OFFSETS = [\n      (-1, -1), (-1, 0), (-1, 1),\n      (0, -1), (0, 0), (0, 1),\n      (1, -1), (1, 0), (1, 1),\n  ]\n\n  # 1. Get initial observations from the environment\n  obs = env.observations()\n  \n  # Extract the global grid representation.\n  # Assuming `grid` is a NumPy array with shape (HEIGHT, WIDTH, N_KINDS).\n  grid = obs['features_dict']['features_global']\n  \n  # Extract the agent's normalized position (x_norm, y_norm).\n  # `features_dict['pos']` is a NumPy array of length 2.\n  agent_pos_norm = obs['features_dict']['pos']\n  \n  # Get grid dimensions (height, width) from the grid shape.\n  HEIGHT, WIDTH, _ = grid.shape\n  \n  # Convert normalized agent position back to integer grid coordinates (col, row).\n  # The agent's position is typically given as (x, y) where x is column and y is row.\n  # Then convert to (row, col) for indexing into the `grid` array.\n  agent_x_grid = round(agent_pos_norm[0] * (WIDTH - 1))\n  agent_y_grid = round(agent_pos_norm[1] * (HEIGHT - 1))\n  agent_start_pos = (agent_y_grid, agent_x_grid) # (row, col)\n  \n  # 2. Perform Breadth-First Search (BFS) to find the shortest path\n  # The queue stores tuples: (current_row, current_col, list_of_actions_to_reach_this_state).\n  # `collections.deque` is used for efficient popleft operations.\n  queue = collections.deque([(agent_start_pos[0], agent_start_pos[1], [])])\n  \n  # A set to keep track of visited grid cells (row, col) to avoid cycles and redundant paths.\n  visited = {agent_start_pos}\n  \n  while queue:\n      curr_r, curr_c, actions_so_far = queue.popleft()\n      \n      # Check if the current position is adjacent to (or on) the primitive.\n      # This is the \"goal check\" for the BFS. If true, we've found a reachable\n      # spot from which the `USE` action can be performed.\n      is_next_to_primitive = False\n      for dr_neigh, dc_neigh in NEIGHBOR_OFFSETS:\n          neigh_r, neigh_c = curr_r + dr_neigh, curr_c + dc_neigh\n          \n          # Ensure neighbor coordinates are within the grid boundaries.\n          if 0 <= neigh_r < HEIGHT and 0 <= neigh_c < WIDTH:\n              # Check if the primitive is present at this neighbor location.\n              if grid[neigh_r, neigh_c, primitive] == 1:\n                  is_next_to_primitive = True\n                  break # Found a primitive in the neighborhood, no need to check other neighbors.\n      \n      if is_next_to_primitive:\n          # If we are next to the primitive (or on it), append the USE action\n          # to the path and return it. BFS guarantees that the first path found\n          # to a target state is the shortest one.\n          return actions_so_far + [USE]\n      \n      # If not next to the primitive, explore possible movement actions (UP, DOWN, LEFT, RIGHT).\n      for action_type, (dr, dc) in ACTION_DELTAS.items():\n          next_r, next_c = curr_r + dr, curr_c + dc\n          \n          # Check if the next position is within grid boundaries.\n          if 0 <= next_r < HEIGHT and 0 <= next_c < WIDTH:\n              # Assuming all grid cells are traversable by movement actions unless specified otherwise.\n              # In CraftWorld, movement generally does not have obstacles that block movement.\n              \n              # Check if this cell has been visited already to prevent infinite loops and redundant paths.\n              if (next_r, next_c) not in visited:\n                  visited.add((next_r, next_c))\n                  # Add the new state to the queue with the extended action list.\n                  queue.append((next_r, next_c, actions_so_far + [action_type]))\n                  \n  # If the queue becomes empty and no primitive was found or reached,\n  # it means the primitive is unreachable from the starting position\n  # given the current grid configuration.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:18:12.258931", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants (from action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  current_obs = env.observations()\n  inventory = current_obs['features_dict']['inventory']\n\n  # 1. Check if the primitive is already collected\n  if inventory[primitive] > 0:\n    return []\n\n  grid_data = current_obs['features_dict']['features_global']\n  # Convert agent_pos from potentially float array to integer tuple (x, y)\n  agent_pos_arr = current_obs['features_dict']['pos']\n  agent_pos = (int(agent_pos_arr[0]), int(agent_pos_arr[1]))\n\n  grid_width, grid_height, _ = grid_data.shape\n  \n  # Get non-grabbable indices from the world configuration\n  # These are entities the agent cannot walk over.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_walkable(x, y):\n    \"\"\"Checks if a given grid cell (x, y) is within bounds and not an obstacle.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # A cell is considered an obstacle if it contains any non-grabbable item\n    for idx in non_grabbable_indices:\n      if grid_data[x, y, idx] == 1.0:\n        return False\n    return True\n\n  # BFS initialization: queue stores (current_position, path_taken_so_far)\n  queue = collections.deque([(agent_pos, [])])\n  # visited set stores positions already explored to avoid cycles and redundant paths\n  visited = {agent_pos}\n\n  while queue:\n    (curr_x, curr_y), path = queue.popleft()\n\n    # 2. Check if the primitive can be 'USE'd from the current position\n    # This aligns with CraftState.next_to, checking the 3x3 neighborhood.\n    can_use_here = False\n    for dx_n in [-1, 0, 1]:\n      for dy_n in [-1, 0, 1]:\n        nx_n, ny_n = curr_x + dx_n, curr_y + dy_n\n        if 0 <= nx_n < grid_width and 0 <= ny_n < grid_height:\n          if grid_data[nx_n, ny_n, primitive] == 1.0:\n            can_use_here = True\n            break\n      if can_use_here:\n        break\n    \n    if can_use_here:\n      # If the primitive is in the 3x3 neighborhood, we can use it from here.\n      return path + [USE]\n\n    # 3. Explore neighboring cells for movement\n    # Define possible movements and their corresponding actions\n    # (dx, dy, action_id)\n    move_actions = [\n        (0, 1, DOWN),    # Move Down (+Y)\n        (0, -1, UP),     # Move Up (-Y)\n        (-1, 0, LEFT),   # Move Left (-X)\n        (1, 0, RIGHT)    # Move Right (+X)\n    ]\n\n    for dx, dy, action in move_actions:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is walkable and has not been visited yet\n      if is_walkable(next_x, next_y) and next_pos not in visited:\n        visited.add(next_pos)\n        queue.append((next_pos, path + [action]))\n\n  # 4. If the BFS completes and no path to the primitive is found, return an empty list.\n  return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:18:12.328073", "function_name": "collect", "function_body": "    current_state = env._current_state\n    \n    # Define action constants based on the problem description\n    # dict mapping DOWN\u21920, UP\u21921, LEFT\u21922, RIGHT\u21923, USE\u21924\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    # Define movement effects and resulting agent directions\n    # (dr, dc, new_direction_id) for each action\n    # Assuming actions like UP, DOWN, LEFT, RIGHT also update the agent's facing direction\n    # (0:NORTH, 1:EAST, 2:SOUTH, 3:WEST)\n    _MOVE_EFFECTS = {\n        _UP: (-1, 0, 0),   # Move North (up), face North\n        _DOWN: (1, 0, 2),  # Move South (down), face South\n        _LEFT: (0, -1, 3), # Move West (left), face West\n        _RIGHT: (0, 1, 1)  # Move East (right), face East\n    }\n\n    # Define direction vectors for checking the cell in front of the agent\n    # (dr, dc) for NORTH (0), EAST (1), SOUTH (2), WEST (3)\n    _DIR_TO_VEC = {\n        0: (-1, 0),  # NORTH (up)\n        1: (0, 1),   # EAST (right)\n        2: (1, 0),   # SOUTH (down)\n        3: (0, -1)   # WEST (left)\n    }\n\n    # 1. Initial check: If the primitive is already in inventory, no actions are needed.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid_h, grid_w, _ = current_state.grid.shape\n\n    # BFS setup\n    queue = collections.deque()\n    # visited set stores (row, col, direction) to avoid cycles and redundant exploration\n    visited = set()\n\n    # Initial agent state: (row, col, direction, path_actions_taken_to_reach_this_state)\n    start_r, start_c = current_state.pos\n    start_dir = current_state.dir\n    \n    # Add initial state to the queue\n    queue.append((start_r, start_c, start_dir, []))\n    visited.add((start_r, start_c, start_dir))\n\n    # BFS loop\n    while queue:\n        r, c, d, path_actions = queue.popleft()\n\n        # Check if the primitive is in the cell directly in front of the agent\n        dr_front, dc_front = _DIR_TO_VEC[d]\n        front_r, front_c = r + dr_front, c + dc_front\n\n        # Ensure the cell in front is within grid boundaries\n        if 0 <= front_r < grid_h and 0 <= front_c < grid_w:\n            # If the primitive is found in the cell directly in front, we've reached our goal\n            if current_state.grid[front_r, front_c, primitive] > 0:\n                # Append the USE action to the path and return\n                return path_actions + [_USE]\n\n        # Explore possible next states by taking movement actions\n        for action, (dr_move, dc_move, new_d) in _MOVE_EFFECTS.items():\n            nr, nc = r + dr_move, c + dc_move\n\n            # Ensure the new position is within grid boundaries\n            if 0 <= nr < grid_h and 0 <= nc < grid_w:\n                # Check if this new state (position and direction) has not been visited yet\n                next_state_key = (nr, nc, new_d)\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    # Add the new state to the queue with the updated path\n                    queue.append((nr, nc, new_d, path_actions + [action]))\n\n    # If the BFS completes and the primitive cannot be found or reached, return an empty list\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:19:34.100792", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Actions map: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_MOVE_DOWN = 0\n  ACTION_MOVE_UP = 1\n  ACTION_MOVE_LEFT = 2\n  ACTION_MOVE_RIGHT = 3\n  ACTION_USE = 4\n\n  # Directions: 0:N, 1:E, 2:S, 3:W (consistent with CraftState.init_dir default 0)\n  # N=Up, E=Right, S=Down, W=Left on a grid where (0,0) is top-left, (row, col)\n  DIR_VECTORS = {\n      0: (0, -1), # North (Up in grid coords: decreases row)\n      1: (1, 0),  # East (Right in grid coords: increases col)\n      2: (0, 1),  # South (Down in grid coords: increases row)\n      3: (-1, 0)  # West (Left in grid coords: decreases col)\n  }\n  # Reverse mapping: (dr, dc) to direction index\n  DIR_VEC_TO_IDX = {v: k for k, v in DIR_VECTORS.items()}\n\n  # Maps a relative movement delta (dr, dc) to the action that performs it, assuming agent is facing that way\n  MOVE_ACTION_FROM_DELTA = {\n      (0, -1): ACTION_MOVE_UP,\n      (0, 1): ACTION_MOVE_DOWN,\n      (-1, 0): ACTION_MOVE_LEFT,\n      (1, 0): ACTION_MOVE_RIGHT\n  }\n\n  def get_turn_actions(current_dir_idx, target_dir_idx):\n      \"\"\"Calculates the sequence of turn actions to change from current_dir_idx to target_dir_idx.\"\"\"\n      actions = []\n      # Calculate difference in direction indices, ensuring positive result for modulo\n      diff = (target_dir_idx - current_dir_idx + 4) % 4\n      if diff == 1:  # 90 deg clockwise (e.g., N->E)\n          actions.append(ACTION_MOVE_RIGHT)\n      elif diff == 2: # 180 deg (e.g., N->S)\n          actions.extend([ACTION_MOVE_RIGHT, ACTION_MOVE_RIGHT])\n      elif diff == 3: # 270 deg clockwise / -90 deg clockwise (e.g., N->W)\n          actions.append(ACTION_MOVE_LEFT)\n      return actions\n\n  def is_cardinal_adjacent(pos1, pos2):\n      \"\"\"Checks if two (r,c) positions are cardinally adjacent (not diagonal).\"\"\"\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1]) == 1\n\n\n  # 1. Get initial state info from the environment\n  obs = env.observations()\n  # Convert numpy array position to tuple of ints for hashing\n  current_pos = tuple(int(x) for x in obs['features_dict']['pos'])\n  current_dir_onehot = obs['features_dict']['direction']\n  # Find the index of the '1' in the one-hot array to get current direction\n  initial_dir_idx = np.where(current_dir_onehot == 1)[0][0]\n\n  # Check if primitive is already in inventory\n  if obs['features_dict']['inventory'][primitive] > 0:\n      return []\n\n  grid = obs['features_dict']['features_global']\n  grid_h, grid_w, _ = grid.shape\n\n  # 2. Find all primitive locations on the grid\n  primitive_locations = []\n  for r in range(grid_h):\n      for c in range(grid_w):\n          if grid[r, c, primitive] > 0:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      return [] # Primitive not found in the world\n\n  # BFS for shortest path to a cell adjacent to any primitive_location\n  # Queue stores (current_pos, current_dir_idx, actions_taken_so_far)\n  q = collections.deque([(current_pos, initial_dir_idx, [])])\n  # Visited set stores (pos, dir_idx) tuples to avoid redundant exploration and cycles\n  visited = set([(current_pos, initial_dir_idx)])\n\n  # Defines possible movement deltas (dr, dc) and the new direction index (0-3) agent faces after that move\n  # e.g., (0, -1, 0) means moving North (row-1), and ending up facing North (dir_idx 0)\n  MOVE_DELTAS_AND_NEW_DIRS = [\n      (0, -1, 0), # Move North (UP)\n      (1, 0, 1),  # Move East (RIGHT)\n      (0, 1, 2),  # Move South (DOWN)\n      (-1, 0, 3)  # Move West (LEFT)\n  ]\n\n  while q:\n      p, d_idx, actions = q.popleft()\n\n      # Check if current position 'p' is adjacent to any primitive location\n      # This means we are in the cell *before* using the item.\n      for target_primitive_loc in primitive_locations:\n          if is_cardinal_adjacent(p, target_primitive_loc):\n              # Found a path to an adjacent cell. Now, calculate actions to turn and USE.\n              \n              # Calculate required direction delta from current pos 'p' to target_primitive_loc\n              dr_face = target_primitive_loc[0] - p[0]\n              dc_face = target_primitive_loc[1] - p[1]\n              \n              # Get the absolute direction index (0-3) the agent needs to face\n              target_face_dir_idx = DIR_VEC_TO_IDX.get((dr_face, dc_face))\n              if target_face_dir_idx is None:\n                  # This case should ideally not be reached if is_cardinal_adjacent is true\n                  continue\n\n              # Generate turn actions to face the primitive\n              turn_actions = get_turn_actions(d_idx, target_face_dir_idx)\n              # Combine with existing actions and add the USE action\n              final_actions = actions + turn_actions + [ACTION_USE]\n\n              # Since this is BFS, the first path found is guaranteed to be the shortest.\n              return final_actions\n\n      # Explore neighbors (possible movement actions)\n      for dr_move, dc_move, new_dir_idx_after_move in MOVE_DELTAS_AND_NEW_DIRS:\n          next_p = (p[0] + dr_move, p[1] + dc_move)\n\n          # Check grid bounds for the next position\n          if not (0 <= next_p[0] < grid_h and 0 <= next_p[1] < grid_w):\n              continue\n\n          # TODO: Obstacle check. In a more complex CraftWorld, certain entity kinds (e.g., walls)\n          # might block movement. Without explicit info on which 'kind' indices are traversable,\n          # we assume all in-bounds cells are traversable for movement.\n          # If a cell contains a non-traversable obstacle (e.g., a \"wall\" kind),\n          # `grid[next_p[0], next_p[1], wall_kind_index] > 0` would be true.\n          # This implementation assumes no such blocking entities for now.\n\n          # Calculate actions to reach next_p from current 'p'\n          # First, turn to face the direction of the move\n          turn_actions_to_move = get_turn_actions(d_idx, new_dir_idx_after_move)\n          \n          # Then, perform the move action itself\n          move_action = MOVE_ACTION_FROM_DELTA.get((dr_move, dc_move))\n          if move_action is None:\n              # This should not happen if MOVE_DELTAS_AND_NEW_DIRS is correctly defined\n              continue\n\n          # Create the new sequence of actions\n          new_actions = actions + turn_actions_to_move + [move_action]\n\n          # Add to queue if this state (position and direction) hasn't been visited yet\n          if (next_p, new_dir_idx_after_move) not in visited:\n              visited.add((next_p, new_dir_idx_after_move))\n              q.append((next_p, new_dir_idx_after_move, new_actions))\n\n  # If BFS completes and no path to an adjacent primitive location is found\n  return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:19:35.107457", "function_name": "collect", "function_body": "  # Define action constants for clarity and readability\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Import collections for deque, used in BFS\n  import collections\n\n  # Get the current state from the environment\n  state = env._current_state\n  current_pos = state.pos\n  grid = state.grid\n  world = state.world  # Access to CraftWorld instance for specific indices like water/stone\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Find all locations on the grid where the target primitive exists\n  primitive_locations = []\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          # Check if the cell (x, y) contains the specified primitive\n          # `grid[x, y, kind_index] > 0` indicates presence\n          if grid[x, y, primitive] > 0:\n              primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it's unreachable\n  if not primitive_locations:\n      return []\n\n  # Define the coordinate changes for each movement action\n  move_deltas = {\n      UP: (0, -1),   # (dx, dy) for moving UP\n      DOWN: (0, 1),   # (dx, dy) for moving DOWN\n      LEFT: (-1, 0),  # (dx, dy) for moving LEFT\n      RIGHT: (1, 0)   # (dx, dy) for moving RIGHT\n  }\n\n  # Helper function to determine if a given grid position is traversable by the agent\n  def is_traversable(px, py):\n      # Check if the coordinates are within the grid boundaries\n      if not (0 <= px < WIDTH and 0 <= py < HEIGHT):\n          return False  # Position is out of bounds\n\n      # Check for impassable terrain at the given cell.\n      # Based on CraftWorld data attributes, water and stone are typically obstacles.\n      if grid[px, py, world.water_index] > 0 or \\\n         grid[px, py, world.stone_index] > 0:\n          return False  # Cell contains impassable terrain\n      return True  # Position is traversable\n\n  # Implement Breadth-First Search (BFS) to find the shortest path\n  # The queue stores tuples: (current_position_tuple, list_of_actions_taken_to_reach_here)\n  queue = collections.deque([(current_pos, [])])\n  # Keep track of visited positions to prevent cycles and redundant exploration\n  visited = {current_pos}\n\n  while queue:\n      (x, y), path_actions = queue.popleft()\n\n      # Check if the current position is adjacent to any of the primitive's locations\n      # This is our goal condition: the agent is one step away from the item it wants to USE.\n      for p_loc_x, p_loc_y in primitive_locations:\n          # Manhattan distance of 1 means direct adjacency (up, down, left, or right)\n          if abs(x - p_loc_x) + abs(y - p_loc_y) == 1:\n              # A path to an adjacent cell has been found.\n              # Append the USE action to the sequence and return the complete path.\n              return path_actions + [USE]\n\n      # Explore all possible movement actions from the current position\n      for action_move, (dx, dy) in move_deltas.items():\n          next_x, next_y = x + dx, y + dy\n          next_pos = (next_x, next_y)\n\n          # If the next position is valid, traversable, and has not been visited yet\n          if is_traversable(next_x, next_y) and next_pos not in visited:\n              visited.add(next_pos)  # Mark the new position as visited\n              # Add the new state (position and path) to the queue for further exploration\n              queue.append((next_pos, path_actions + [action_move]))\n\n  # If the BFS queue becomes empty and no path to an adjacent primitive was found,\n  # it means the primitive is unreachable from the agent's current position.\n  return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:20:36.605753", "function_name": "collect", "function_body": "    # Constants for actions\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    # Get current state from the environment\n    state = env._current_state\n    grid = state.grid\n    agent_pos = state.pos  # (ax, ay)\n    inventory = state.inventory # Agent's current inventory\n\n    WIDTH, HEIGHT, n_kinds = grid.shape\n\n    # Initialize the list of actions\n    actions = []\n\n    # 0. Check if the primitive is already in inventory\n    # If the primitive is already collected, no actions are needed.\n    if inventory[primitive] > 0:\n        return []\n\n    # 1. Check if the agent is already adjacent to the primitive (or on the same cell)\n    # The `CraftState.next_to` method checks the 3x3 neighborhood.\n    if state.next_to(primitive):\n        actions.append(_USE)\n        return actions\n\n    # 2. If not already next to it, find the primitive's position on the grid\n    primitive_pos = None\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            # Check if the primitive exists at this location on the grid\n            # `grid[x, y, primitive] > 0` indicates the presence of the item.\n            if grid[x, y, primitive] > 0:\n                primitive_pos = (x, y)\n                break\n        if primitive_pos:\n            break\n\n    if primitive_pos is None:\n        # Primitive not found on the grid and not already next to it, so it cannot be collected.\n        return []\n\n    # 3. Determine the optimal target position for the agent: an adjacent cell to the primitive\n    # The agent needs to move to a cell adjacent to the primitive before using the USE action.\n    target_adj_pos = None\n    min_dist = float('inf')\n\n    px, py = primitive_pos # Primitive's coordinates\n\n    # Possible adjacent cells around the primitive\n    possible_adj_cells = [\n        (px - 1, py), (px + 1, py), (px, py - 1), (px, py + 1)\n    ]\n\n    # Filter out cells that are out of bounds and find the closest valid one\n    for tx, ty in possible_adj_cells:\n        if 0 <= tx < WIDTH and 0 <= ty < HEIGHT:\n            # Calculate Manhattan distance from the agent's current position to this adjacent cell\n            dist = abs(agent_pos[0] - tx) + abs(agent_pos[1] - ty)\n            if dist < min_dist:\n                min_dist = dist\n                target_adj_pos = (tx, ty)\n\n    if target_adj_pos is None:\n        # This case should be rare, typically only if the grid is too small\n        # or somehow no valid adjacent cells exist. If reached here, it implies\n        # the primitive is found but unreachable by simple adjacency.\n        return []\n\n    # 4. Plan the path to the `target_adj_pos` using Manhattan movements\n    ax, ay = agent_pos # Agent's current coordinates\n    tx, ty = target_adj_pos # Target adjacent coordinates\n\n    # Prioritize horizontal movement\n    if tx > ax:\n        for _ in range(tx - ax):\n            actions.append(_RIGHT)\n    elif tx < ax:\n        for _ in range(ax - tx):\n            actions.append(_LEFT)\n\n    # Then vertical movement (assuming Y increases downwards as in typical screen coordinates)\n    if ty > ay:\n        for _ in range(ty - ay):\n            actions.append(_DOWN)\n    elif ty < ay:\n        for _ in range(ay - ty):\n            actions.append(_UP)\n\n    # 5. Add the USE action after reaching the adjacent position\n    actions.append(_USE)\n\n    return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:20:36.675331", "function_name": "collect", "function_body": "    import collections\n\n    # Define actions based on problem description\n    DOWN_ACTION = 0\n    UP_ACTION = 1\n    LEFT_ACTION = 2\n    RIGHT_ACTION = 3\n    USE_ACTION = 4\n    ALL_MOVE_ACTIONS = [DOWN_ACTION, UP_ACTION, LEFT_ACTION, RIGHT_ACTION]\n\n    # Max search depth to prevent infinite loops or excessively long searches\n    MAX_ACTIONS_PER_PATH = 200 \n\n    # Reset the environment to a known initial state and get the CraftState instance\n    # The `env` is a CraftLab instance. Its `_current_state` holds the CraftState.\n    _ = env.reset() \n    initial_state = env._current_state\n\n    # Check if the primitive is already in the inventory at the start\n    if initial_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # BFS setup\n    # Queue stores tuples of (CraftState object, list of actions to reach this state)\n    queue = collections.deque([(initial_state, [])]) \n    \n    # Visited set stores (position, direction) tuples to avoid re-exploring the same agent configurations\n    # This ensures we find the shortest path by not reprocessing states reached via longer paths.\n    visited = set() \n    visited.add((initial_state.pos, initial_state.dir))\n\n    while queue:\n        current_state, path = queue.popleft()\n\n        # Check if we are next to the primitive and can use it\n        # This check is before exploring further moves, prioritizing collection.\n        if current_state.next_to(primitive):\n            # Simulate the USE action to see if it collects the primitive\n            # CraftState.step returns a *new* CraftState object, preserving current_state\n            state_after_use, _ = current_state.step(USE_ACTION)\n            if state_after_use.inventory[primitive] > 0:\n                return path + [USE_ACTION] # Primitive collected, return the path including USE\n\n        # Pruning: If the current path exceeds the maximum allowed length, stop exploring this branch\n        if len(path) >= MAX_ACTIONS_PER_PATH:\n            continue\n\n        # Explore possible next states by taking movement actions\n        for action in ALL_MOVE_ACTIONS:\n            # Simulate the action to get the next state\n            next_state, _ = current_state.step(action)\n            next_pos_dir = (next_state.pos, next_state.dir)\n\n            # If this (position, direction) configuration has not been visited yet\n            if next_pos_dir not in visited:\n                visited.add(next_pos_dir) # Mark as visited\n                queue.append((next_state, path + [action])) # Add to queue for exploration\n\n    return [] # No path found to collect the primitive within the given limits", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:22:04.023795", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:22:04.093501", "function_name": "collect", "function_body": "    actions_list = []\n\n    # Get action constants from the environment's action_specs\n    action_map = env.action_specs()\n    UP, DOWN, LEFT, RIGHT, USE = (\n        action_map['UP'], action_map['DOWN'],\n        action_map['LEFT'], action_map['RIGHT'],\n        action_map['USE']\n    )\n\n    # Access current state (CraftState instance)\n    state = env._current_state\n    \n    # 1. Check Inventory: If the primitive is already collected, return an empty list\n    if state.inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions and current agent position\n    grid = state.grid\n    WIDTH, HEIGHT, _ = grid.shape # N_KINDS is not strictly needed here\n    agent_x, agent_y = state.pos\n\n    # Get indices for entities that block movement\n    # We assume non_grabbable_indices are blocking, and the primitive itself blocks agent movement onto its cell.\n    blocking_indices = set(env.world.non_grabbable_indices)\n    \n    # Helper function to check if a cell is traversable\n    def is_traversable(x, y):\n        # Check if coordinates are within grid bounds\n        if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n            return False \n        \n        # Check if the cell contains any blocking non-grabbable entities\n        for k_idx in blocking_indices:\n            if grid[x, y, k_idx] == 1:\n                return False\n        \n        # Also, the agent generally cannot occupy the same cell as the item it wants to pick up\n        # (assuming interaction happens from an adjacent cell)\n        if grid[x, y, primitive] == 1:\n            return False \n            \n        return True\n\n    # 2. Find all locations of the target primitive on the grid\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] == 1:\n                primitive_locations.append((x, y))\n\n    # If the primitive is not found on the map, return an empty list\n    if not primitive_locations:\n        return []\n\n    # 3. Find the closest primitive location to the agent\n    closest_primitive_pos = None\n    min_dist_to_primitive = float('inf')\n    for px, py in primitive_locations:\n        dist = abs(px - agent_x) + abs(py - agent_y)\n        if dist < min_dist_to_primitive:\n            min_dist_to_primitive = dist\n            closest_primitive_pos = (px, py)\n\n    # This should always be found if primitive_locations is not empty\n    if closest_primitive_pos is None: \n        return []\n\n    # 4. Find the best traversable adjacent cell for the agent to move to\n    target_px, target_py = closest_primitive_pos\n    \n    # Candidate adjacent positions (cardinal directions)\n    candidate_adjacent_poses = [\n        (target_px - 1, target_py),\n        (target_px + 1, target_py),\n        (target_px, target_py - 1),\n        (target_px, target_py + 1)\n    ]\n\n    best_adjacent_agent_pos = None\n    min_dist_to_adjacent = float('inf')\n\n    # Iterate through candidate positions to find the closest traversable one\n    for nx, ny in candidate_adjacent_poses:\n        if is_traversable(nx, ny):\n            dist = abs(nx - agent_x) + abs(ny - agent_y)\n            if dist < min_dist_to_adjacent:\n                min_dist_to_adjacent = dist\n                best_adjacent_agent_pos = (nx, ny)\n\n    # If no traversable adjacent spot is found, return an empty list (cannot reach it)\n    if best_adjacent_agent_pos is None:\n        return []\n    \n    # 5. Generate movement actions to reach the best_adjacent_agent_pos\n    current_ax, current_ay = agent_x, agent_y\n    target_ax, target_ay = best_adjacent_agent_pos\n\n    # Generate a simple Manhattan path (first X then Y movements)\n    while current_ax != target_ax:\n        if current_ax < target_ax:\n            actions_list.append(RIGHT)\n            current_ax += 1\n        else: # current_ax > target_ax\n            actions_list.append(LEFT)\n            current_ax -= 1\n\n    while current_ay != target_ay:\n        if current_ay < target_ay:\n            actions_list.append(DOWN)\n            current_ay += 1\n        else: # current_ay > target_ay\n            actions_list.append(UP)\n            current_ay -= 1\n            \n    # 6. After reaching the adjacent position, add the USE action to collect the primitive\n    actions_list.append(USE)\n    \n    return actions_list", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:24:10.593522", "function_name": "collect", "function_body": "    # Nested helper functions for local scope and clarity\n    # --------------------------------------------------------------------------\n    \n    # Action constants (dynamically obtained from the environment)\n    action_map = env.action_specs()\n    A_DOWN = action_map['DOWN']\n    A_UP = action_map['UP']\n    A_LEFT = action_map['LEFT']\n    A_RIGHT = action_map['RIGHT']\n    A_USE = action_map['USE']\n\n    # Direction vectors for agent's facing direction (0=North, 1=East, 2=South, 3=West)\n    # (dx, dy) where dx is change in x-coordinate, dy is change in y-coordinate.\n    # CraftState.pos is (x, y) where x is column, y is row.\n    DIR_VECTORS = {\n        0: (0, -1), # North (typically UP on a grid display, Y decreases)\n        1: (1, 0),  # East (RIGHT, X increases)\n        2: (0, 1),  # South (DOWN, Y increases)\n        3: (-1, 0)  # West (LEFT, X decreases)\n    }\n\n    def _get_front_coords(pos, direction):\n        \"\"\"Returns the coordinates (x, y) of the cell directly in front of the agent.\"\"\"\n        dx, dy = DIR_VECTORS[direction]\n        return (pos[0] + dx, pos[1] + dy)\n\n    def _manhattan_distance(pos1, pos2):\n        \"\"\"Calculates the Manhattan distance between two (x, y) coordinates.\"\"\"\n        return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n    def _is_valid_coord(x, y, grid_shape):\n        \"\"\"Checks if a given (x, y) coordinate is within the grid boundaries.\"\"\"\n        return 0 <= x < grid_shape[0] and 0 <= y < grid_shape[1]\n\n    def _bfs_shortest_path(start_pos, goal_cells, grid_shape, obstacles):\n        \"\"\"\n        Finds the shortest path from start_pos to any cell in goal_cells, avoiding obstacles.\n        Returns a list of (x, y) coordinates representing the path from start_pos (exclusive)\n        to the chosen goal cell (inclusive). Returns an empty list if no path is found.\n\n        Args:\n            start_pos (tuple): (x, y) starting coordinates.\n            goal_cells (set): A set of (x, y) coordinates representing possible goal destinations.\n            grid_shape (tuple): (width, height) of the grid.\n            obstacles (set): A set of (x, y) coordinates that cannot be traversed.\n        \"\"\"\n        queue = collections.deque([(start_pos, [])]) # (current_pos, path_taken_so_far)\n        visited = {start_pos}\n\n        while queue:\n            (curr_x, curr_y), path_so_far = queue.popleft()\n\n            # Explore neighbors (North, South, East, West)\n            for dx, dy in [(0, -1), (0, 1), (1, 0), (-1, 0)]: \n                next_x, next_y = curr_x + dx, curr_y + dy\n                next_pos = (next_x, next_y)\n\n                if _is_valid_coord(next_x, next_y, grid_shape) and \\\n                   next_pos not in visited and \\\n                   next_pos not in obstacles:\n                    \n                    if next_pos in goal_cells:\n                        return path_so_far + [next_pos] # Path found! Return it including the goal cell\n                    \n                    visited.add(next_pos)\n                    queue.append((next_pos, path_so_far + [next_pos]))\n        return [] # No path found after exploring all reachable cells\n\n    # --------------------------------------------------------------------------\n\n    MAX_COLLECT_ATTEMPTS = 500 # A safety limit to prevent infinite loops during collection\n\n    actions_taken = []\n    \n    # Identify obstacle kinds from the CraftWorld configuration.\n    # These are entities that are generally impassable or not meant to be walked on.\n    # We exclude the 'primitive' itself from being an obstacle, as we want to approach it.\n    obstacle_kind_indices = set(env.world.non_grabbable_indices)\n    obstacle_kind_indices.discard(primitive) \n\n    for _ in range(MAX_COLLECT_ATTEMPTS):\n        obs = env.observations()\n        features_dict = obs['features_dict']\n        current_inventory = features_dict['inventory']\n        current_pos = tuple(features_dict['pos']) # Agent's current (x, y) grid coordinates\n        current_dir = features_dict['direction'] # Agent's current facing direction (0-3)\n        grid = features_dict['features_global'] # The full grid as a NumPy array (WIDTH, HEIGHT, n_kinds)\n        grid_width, grid_height, num_kinds = grid.shape\n\n        if current_inventory[primitive] > 0:\n            # Goal achieved: the primitive has been collected.\n            return actions_taken \n\n        # Locate all instances of the target primitive on the grid\n        primitive_locations = []\n        for x in range(grid_width):\n            for y in range(grid_height):\n                if grid[x, y, primitive] > 0: \n                    primitive_locations.append((x, y))\n\n        if not primitive_locations:\n            # The primitive is not found on the map. It might have been collected already\n            # or simply not present. In this case, we cannot collect it.\n            return actions_taken \n\n        # Find the single closest primitive location to the agent\n        closest_primitive_pos = None\n        min_dist = float('inf')\n        for p_pos in primitive_locations:\n            dist = _manhattan_distance(current_pos, p_pos)\n            if dist < min_dist:\n                min_dist = dist\n                closest_primitive_pos = p_pos\n\n        # Determine the set of coordinates that act as obstacles for pathfinding.\n        # These are cells that contain any of the identified obstacle_kind_indices.\n        bfs_obstacles_coords = set()\n        for x in range(grid_width):\n            for y in range(grid_height):\n                is_obstacle_cell = False\n                for kind_idx in obstacle_kind_indices:\n                    if grid[x, y, kind_idx] > 0: \n                        is_obstacle_cell = True\n                        break\n                if is_obstacle_cell:\n                    bfs_obstacles_coords.add((x, y))\n\n        action_to_take = None\n\n        # Calculate the coordinates of the cell directly in front of the agent\n        front_x, front_y = _get_front_coords(current_pos, current_dir)\n        front_pos = (front_x, front_y)\n\n        # Strategy for determining the next action:\n        # 1. If primitive is directly in front, USE.\n        # 2. If primitive is adjacent but not in front, TURN to face it.\n        # 3. Otherwise (primitive is not adjacent), MOVE towards it using BFS.\n\n        if front_pos == closest_primitive_pos:\n            # Case 1: Primitive is directly in front, so interact with it.\n            action_to_take = A_USE\n        elif _manhattan_distance(current_pos, closest_primitive_pos) == 1:\n            # Case 2: Primitive is adjacent but not directly in front, agent needs to turn.\n            # Determine the desired direction (0-3) to face the primitive.\n            target_dx = closest_primitive_pos[0] - current_pos[0]\n            target_dy = closest_primitive_pos[1] - current_pos[1]\n            \n            desired_dir = None\n            for d, (vdx, vdy) in DIR_VECTORS.items():\n                if vdx == target_dx and vdy == target_dy:\n                    desired_dir = d\n                    break\n            \n            if desired_dir is not None and current_dir != desired_dir:\n                # Calculate the shortest turn needed (1=right, 3=left, 2=180 deg)\n                turn_diff = (desired_dir - current_dir + 4) % 4\n                if turn_diff == 1: # Turn Right\n                    action_to_take = A_RIGHT\n                elif turn_diff == 3: # Turn Left\n                    action_to_take = A_LEFT\n                elif turn_diff == 2: # 180 degree turn, can pick either Left or Right\n                    action_to_take = A_LEFT \n            else:\n                # This should only be reached if already facing the primitive,\n                # which would be covered by the first 'if' (front_pos == closest_primitive_pos).\n                # As a fallback, assume USE if logic leads here.\n                action_to_take = A_USE\n\n        else:\n            # Case 3: Primitive is not adjacent, agent needs to move.\n            # Use BFS to find a path to any walkable cell adjacent to the closest primitive.\n            target_adj_cells = set()\n            for dx_adj, dy_adj in [(0, -1), (0, 1), (1, 0), (-1, 0)]: # All 4 cardinal neighbors\n                adj_x, adj_y = closest_primitive_pos[0] + dx_adj, closest_primitive_pos[1] + dy_adj\n                if _is_valid_coord(adj_x, adj_y, (grid_width, grid_height)) and \\\n                   (adj_x, adj_y) not in bfs_obstacles_coords:\n                    target_adj_cells.add((adj_x, adj_y))\n            \n            # Ensure the agent's current position is not considered a goal for pathfinding\n            target_adj_cells.discard(current_pos)\n\n            if not target_adj_cells:\n                # No valid, walkable cells adjacent to the primitive are found (e.g., it's walled off).\n                return actions_taken\n\n            # Find the shortest path to any of the valid adjacent cells.\n            path = _bfs_shortest_path(current_pos, target_adj_cells, \n                                     (grid_width, grid_height), bfs_obstacles_coords)\n\n            if path:\n                next_step_pos = path[0] # Take the first step on the shortest path\n                \n                # Determine the move action (UP/DOWN/LEFT/RIGHT) for this first step\n                move_dx = next_step_pos[0] - current_pos[0]\n                move_dy = next_step_pos[1] - current_pos[1]\n\n                current_move_action = None\n                if move_dy == -1: current_move_action = A_UP\n                elif move_dy == 1: current_move_action = A_DOWN\n                elif move_dx == -1: current_move_action = A_LEFT\n                elif move_dx == 1: current_move_action = A_RIGHT\n                \n                # Before moving, check if the agent needs to turn to face the direction of movement.\n                desired_move_dir = None\n                for d, (vdx, vdy) in DIR_VECTORS.items():\n                    if vdx == move_dx and vdy == move_dy:\n                        desired_move_dir = d\n                        break\n\n                if desired_move_dir is not None and current_dir != desired_move_dir:\n                    # Turn towards the desired move direction\n                    turn_diff = (desired_move_dir - current_dir + 4) % 4\n                    if turn_diff == 1: \n                        action_to_take = A_RIGHT\n                    elif turn_diff == 3: \n                        action_to_take = A_LEFT\n                    elif turn_diff == 2: # 180 deg turn, pick one.\n                        action_to_take = A_LEFT \n                else: \n                    # Agent is already facing the right direction or cannot determine, so just move.\n                    action_to_take = current_move_action\n            else:\n                # No path found to primitive's adjacent cell. It's considered unreachable.\n                return actions_taken\n        \n        # If, for some reason, no action was determined (should ideally not happen with complete logic)\n        if action_to_take is None:\n            return actions_taken # Give up\n\n        # Execute the chosen action in the environment.\n        _, done, _ = env.step(action_to_take)\n        actions_taken.append(action_to_take)\n        \n        # If the environment signals that the episode is 'done' (e.g., max steps reached),\n        # re-check inventory to see if the goal was achieved by the last action.\n        if done: \n            obs = env.observations()\n            current_inventory = obs['features_dict']['inventory']\n            if current_inventory[primitive] > 0:\n                return actions_taken # Goal was met right at the end.\n            else:\n                return actions_taken # Episode done, but primitive not collected.\n\n    # If MAX_COLLECT_ATTEMPTS is reached and the primitive is still not collected, return actions taken.\n    return actions_taken", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:24:11.591747", "function_name": "collect", "function_body": "  import collections\n\n  # Get action mappings from the environment from the CraftLab instance.\n  # These values are constants for all calls.\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Adjacency deltas for movement actions (dx, dy) and their corresponding actions.\n  # (0, -1) means change in y is -1 (move up), change in x is 0.\n  DELTAS = [\n      (0, -1),  # UP\n      (0, 1),   # DOWN\n      (-1, 0),  # LEFT\n      (1, 0)    # RIGHT\n  ]\n\n  ACTION_FOR_DELTA = {\n      (0, -1): UP,\n      (0, 1): DOWN,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT\n  }\n\n  # Access the current state from the CraftLab environment.\n  # We use the private attribute _current_state as described in the problem's data attributes.\n  state = env._current_state\n  grid = state.grid\n  agent_x, agent_y = state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # 1. Find all locations on the grid where the target primitive exists.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if grid[x, y, primitive] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If the primitive is not found on the grid, there are no actions to collect it.\n      return []\n\n  # 2. Precompute all grid positions from which the primitive can be collected.\n  # According to CraftState's `next_to` and `step` (USE action) logic,\n  # the USE action is effective if the agent is within a 3x3 neighborhood of the item.\n  collectable_positions = set()\n  for px, py in primitive_locations:\n      for dx in range(-1, 2):  # Iterate x-offset from -1 to 1 (inclusive)\n          for dy in range(-1, 2):  # Iterate y-offset from -1 to 1 (inclusive)\n              nx, ny = px + dx, py + dy\n              # Ensure the potential collection position is within grid boundaries.\n              if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                  collectable_positions.add((nx, ny))\n\n  # 3. Check if the agent is already at a position from which the primitive can be collected.\n  if (agent_x, agent_y) in collectable_positions:\n      # If so, only the USE action is needed.\n      return [USE]\n\n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    from the agent's current position to any position in `collectable_positions`.\n  # Each node in the BFS queue stores:\n  #   ((current_x, current_y), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((agent_x, agent_y), [])])\n  # Keep track of visited positions to avoid cycles and redundant paths, ensuring shortest path.\n  visited = set([(agent_x, agent_y)])\n\n  path_to_collect_position = None\n\n  while queue:\n      (curr_x, curr_y), current_actions = queue.popleft()\n\n      # Explore all valid neighbors from the current position.\n      for dx, dy in DELTAS:\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # Check if the next position is within the grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # If this position has not been visited yet, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Append the action taken to reach this neighbor to the current path.\n              new_actions = current_actions + [ACTION_FOR_DELTA[(dx, dy)]]\n\n              # If this new position is one from which the primitive can be collected,\n              # we have found the shortest path.\n              if next_pos in collectable_positions:\n                  path_to_collect_position = new_actions\n                  # Clear the queue and break to terminate BFS as the shortest path is found.\n                  queue.clear()\n                  break\n              else:\n                  # If not a collectable position, add to queue for further exploration.\n                  queue.append((next_pos, new_actions))\n\n  if path_to_collect_position is None:\n      # If the BFS completes and no path was found to any collectable position.\n      return []\n\n  # 5. Once the agent reaches a `collectable_position`, the final action is to USE.\n  all_actions = path_to_collect_position + [USE]\n\n  return all_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:25:45.717547", "function_name": "collect", "function_body": "    actions_taken = []\n\n    # Get initial state and environment details\n    obs = env.reset()\n    obs_dict = env.observations()['features_dict']\n    grid = obs_dict['features_global']\n    # Convert numpy array position to tuple for hashing in visited set\n    curr_pos = tuple(obs_dict['pos'].astype(int)) \n    curr_dir_one_hot = obs_dict['direction']\n    curr_dir_int = np.argmax(curr_dir_one_hot)\n    curr_inventory = obs_dict['inventory']\n\n    # Check if primitive is already collected\n    if curr_inventory[primitive] > 0:\n        return actions_taken\n\n    # Get action mappings from the environment\n    action_specs = env.action_specs()\n    A_DOWN = action_specs['DOWN']\n    A_UP = action_specs['UP']\n    A_LEFT = action_specs['LEFT']\n    A_RIGHT = action_specs['RIGHT']\n    A_USE = action_specs['USE']\n\n    # Grid dimensions\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # Find all locations of the primitive on the grid\n    primitive_coords = np.argwhere(grid[:, :, primitive] > 0)\n\n    if primitive_coords.size == 0:\n        # Primitive not found on the map\n        return actions_taken\n\n    # Define movement deltas and resulting direction for each action\n    # (row_delta, col_delta, new_direction_index)\n    move_action_map = {\n        A_UP: (0, -1, 0),    # UP action moves up, results in facing dir 0 (UP)\n        A_DOWN: (0, 1, 2),   # DOWN action moves down, results in facing dir 2 (DOWN)\n        A_LEFT: (-1, 0, 3),  # LEFT action moves left, results in facing dir 3 (LEFT)\n        A_RIGHT: (1, 0, 1)   # RIGHT action moves right, results in facing dir 1 (RIGHT)\n    }\n\n    # Define facing deltas for each direction index\n    # (dx_facing, dy_facing) where x is column, y is row\n    # In numpy grid, (col, row) for (x, y)\n    dir_to_facing_delta = {\n        0: (0, -1),  # UP (col_delta, row_delta)\n        1: (1, 0),   # RIGHT\n        2: (0, 1),   # DOWN\n        3: (-1, 0)   # LEFT\n    }\n\n    # Get non-grabbable obstacle indices from the world configuration\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # BFS Initialization\n    # Queue stores (current_row, current_col, current_direction_index, list_of_actions_taken)\n    q = collections.deque([(curr_pos[0], curr_pos[1], curr_dir_int, [])]) \n    # Visited set stores (row, col, direction_index) to avoid cycles and redundant paths\n    visited = set([(curr_pos[0], curr_pos[1], curr_dir_int)]) \n\n    # BFS Loop\n    while q:\n        r, c, d_idx, path_actions = q.popleft()\n\n        # Check if the primitive is directly in front of the current agent state\n        # The goal is to reach a state from which we can successfully USE the primitive.\n        facing_dr, facing_dc = dir_to_facing_delta[d_idx]\n        target_r, target_c = r + facing_dr, c + facing_dc\n\n        # Check if the cell directly in front contains the primitive\n        is_target_in_front = False\n        if 0 <= target_r < WIDTH and 0 <= target_c < HEIGHT:\n            if grid[target_r, target_c, primitive] > 0:\n                is_target_in_front = True\n\n        if is_target_in_front:\n            # Found a path to a state where the USE action can collect the primitive\n            return path_actions + [A_USE]\n\n        # Explore possible next moves (UP, DOWN, LEFT, RIGHT)\n        for action, (dr, dc, new_d_idx) in move_action_map.items():\n            nr, nc = r + dr, c + dc # Calculate new row and col after movement\n\n            # Check boundary conditions\n            if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n                continue\n\n            # Check for obstacles (non-grabbable entities) at the new position\n            is_obstacle = False\n            for obstacle_idx in non_grabbable_indices:\n                if grid[nr, nc, obstacle_idx] > 0:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n\n            # If the new state (position + direction) has not been visited, add it to the queue\n            if (nr, nc, new_d_idx) not in visited:\n                visited.add((nr, nc, new_d_idx))\n                q.append((nr, nc, new_d_idx, path_actions + [action]))\n\n    # If BFS completes and no path is found to collect the primitive\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T04:25:45.788441", "function_name": "collect", "function_body": "    # Action mappings (standard for this environment)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    current_state = env._current_state\n    grid = current_state.grid\n    start_pos = current_state.pos\n\n    # Check if the primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected\n\n    height, width, _ = grid.shape\n    \n    # BFS for pathfinding to the target item's location\n    # Using a list as a basic queue for maximum compatibility (no external imports like collections.deque)\n    q = [(start_pos[0], start_pos[1], [])] # (current_y, current_x, list_of_actions_to_reach_here)\n    visited = {start_pos} # Stores (y, x) coordinates\n\n    target_item_pos = None\n    actions_to_reach_item = []\n\n    head = 0 # Manual queue management for list\n    while head < len(q):\n        curr_y, curr_x, path = q[head]\n        head += 1\n\n        # Check if the current cell contains the primitive\n        if grid[curr_y, curr_x, primitive] == 1:\n            target_item_pos = (curr_y, curr_x)\n            actions_to_reach_item = path\n            break\n\n        # Explore neighbors (N, E, S, W)\n        # (dy, dx, action_needed_to_move_to_next_cell)\n        neighbors_info = [\n            (-1, 0, UP),    # North (move UP action)\n            (0, 1, RIGHT),  # East (move RIGHT action)\n            (1, 0, DOWN),   # South (move DOWN action)\n            (0, -1, LEFT)   # West (move LEFT action)\n        ]\n\n        for dy, dx, action_to_move in neighbors_info:\n            next_y, next_x = curr_y + dy, curr_x + dx\n\n            # Check bounds and if already visited\n            if 0 <= next_y < height and 0 <= next_x < width and (next_y, next_x) not in visited:\n                visited.add((next_y, next_x))\n                q.append((next_y, next_x, path + [action_to_move]))\n\n    if target_item_pos is None:\n        # Primitive not found on the grid\n        return []\n\n    # Assume `USE` action works when standing on a grabbable primitive.\n    # The agent executes the movements and then attempts to USE the item at the final position.\n    final_actions = actions_to_reach_item + [USE]\n    return final_actions", "island_id": 0, "scores": {"3": -1}}
