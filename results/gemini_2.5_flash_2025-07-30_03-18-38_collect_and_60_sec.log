{"timestamp": "2025-07-30T17:17:22.842996", "function_name": "collect", "function_body": "  # Constants for actions and directions\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Map movement actions to the direction the agent faces after taking that action\n  ACTION_TO_DIR_MAP = {\n      UP_ACTION: NORTH_DIR,\n      RIGHT_ACTION: EAST_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR\n  }\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"Calculates the direction the agent needs to face to look at the item.\n    Assumes item is exactly one cardinal step away from agent.\n    \"\"\"\n    if item_x > agent_x: return EAST_DIR\n    if item_x < agent_x: return WEST_DIR\n    if item_y > agent_y: return SOUTH_DIR\n    if item_y < agent_y: return NORTH_DIR\n    return None # Should only happen if agent_x,y == item_x,y, or item is diagonal.\n\n  def _get_turn_actions(current_dir, target_dir):\n    \"\"\"Returns a list of actions to turn from current_dir to target_dir.\"\"\"\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    # Calculate shortest turns (clockwise vs. counter-clockwise)\n    # Adding 4 and modulo 4 ensures positive results for subtraction\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      # Assuming RIGHT_ACTION makes agent turn clockwise (e.g., N->E)\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION)\n    else:\n      # Assuming LEFT_ACTION makes agent turn counter-clockwise (e.g., N->W)\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION)\n    return actions\n\n  # 1. Get primitive's integer ID\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # 2. Initial Inventory Check: If the primitive is already in inventory, no actions are needed.\n  current_state = env._current_state\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  # 3. Get current state information and grid details\n  grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir\n  # grid.shape is (HEIGHT, WIDTH, KINDS)\n  grid_height, grid_width, _ = grid.shape \n\n  # 4. Define impassable items and `is_passable` check\n  # Impassable items are those that cannot be picked up or moved through.\n  impassable_kinds = env.world.non_grabbable_indices\n\n  def is_passable(x, y):\n    \"\"\"Checks if a cell (x, y) is within bounds and does not contain impassable objects.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    \n    # Check if the cell contains any impassable kind\n    for kind_idx in impassable_kinds:\n      if grid[y, x, kind_idx] == 1:\n        return False # Contains an impassable object\n    return True\n\n  # 5. Find all locations of the primitive on the grid\n  # np.where returns (row_indices, col_indices) which correspond to (y_coords, x_coords)\n  primitive_locations = set() # Use a set for faster lookup\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n\n  if not primitive_locations:\n    return [] # Primitive not found on the grid\n\n  # 6. BFS Setup for shortest movement path to an adjacent cell\n  # Queue stores (x, y, current_direction)\n  q = collections.deque()\n  # Visited set stores (x, y, current_direction) to avoid cycles and redundant exploration\n  visited = set()\n  # parent_map stores (child_node): (parent_node, action_from_parent_to_child) for path reconstruction\n  parent_map = {} \n\n  start_node = (agent_pos_x, agent_pos_y, agent_dir)\n  q.append(start_node)\n  visited.add(start_node)\n\n  found_target_info = None # Stores (final_x, final_y, final_dir, target_primitive_x, target_primitive_y)\n\n  # Movement deltas for cardinal directions\n  move_deltas = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  while q:\n    curr_x, curr_y, curr_dir = q.popleft()\n\n    # Check if the current position is adjacent to any primitive\n    # Iterate over cardinal neighbors of the current agent position\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # These are relative to agent's position\n      check_item_x, check_item_y = curr_x + dx, curr_y + dy\n      \n      if (check_item_x, check_item_y) in primitive_locations:\n        # Found an adjacent primitive! This is the shortest path in terms of movement steps.\n        # Store information needed for path reconstruction and final turn.\n        found_target_info = (curr_x, curr_y, curr_dir, check_item_x, check_item_y)\n        q.clear() # Clear queue to stop BFS and exit loop\n        break\n    \n    if found_target_info: # If target found in the inner loop, break outer loop too\n      break\n\n    # Explore neighbors (move actions)\n    for action, (dx, dy) in move_deltas.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = ACTION_TO_DIR_MAP[action] # Agent faces in the direction of movement after this action\n      next_node = (next_x, next_y, next_dir)\n\n      if is_passable(next_x, next_y) and next_node not in visited:\n        visited.add(next_node)\n        parent_map[next_node] = (curr_x, curr_y, curr_dir, action) # Store parent node and action\n        q.append(next_node)\n  \n  # 7. Path Reconstruction and Final Actions\n  if found_target_info is None:\n    return [] # Primitive is unreachable (no path to an adjacent cell)\n\n  final_agent_x, final_agent_y, final_agent_dir, target_primitive_x, target_primitive_y = found_target_info\n  \n  # Reconstruct movement path from start_node to (final_agent_x, final_agent_y, final_agent_dir)\n  path_actions = []\n  current_path_node = (final_agent_x, final_agent_y, final_agent_dir)\n\n  # Backtrack from the target node to the start node using the parent_map\n  while current_path_node != start_node:\n    parent_node, action_taken_to_get_here = parent_map[current_path_node]\n    path_actions.append(action_taken_to_get_here)\n    current_path_node = parent_node\n  \n  path_actions.reverse() # Path was built in reverse order, so reverse to get chronological order\n\n  # Calculate final turn actions to face the primitive\n  target_face_dir = _get_target_facing_direction(final_agent_x, final_agent_y, \n                                                 target_primitive_x, target_primitive_y)\n  \n  all_actions = list(path_actions) # Start with movement actions\n  if target_face_dir is not None:\n    turn_actions = _get_turn_actions(final_agent_dir, target_face_dir)\n    all_actions.extend(turn_actions)\n  \n  all_actions.append(USE_ACTION) # Finally, use the primitive\n\n  return all_actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:17:23.819482", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Direction constants (0=N, 1=E, 2=S, 3=W clockwise from North)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Map movement actions to the direction the agent faces after taking that action\n  ACTION_TO_DIR_MAP = {\n      UP_ACTION: NORTH_DIR,\n      RIGHT_ACTION: EAST_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR\n  }\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"Calculates the direction the agent needs to face to look at the item.\n    Assumes item is exactly one cardinal step away from agent.\n    \"\"\"\n    if item_x > agent_x: return EAST_DIR\n    if item_x < agent_x: return WEST_DIR\n    if item_y > agent_y: return SOUTH_DIR\n    if item_y < agent_y: return NORTH_DIR\n    return None # Should only happen if agent_x,y == item_x,y, or item is diagonal.\n\n  def _get_turn_actions(current_dir, target_dir):\n    \"\"\"Returns a list of actions to turn from current_dir to target_dir.\"\"\"\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    # Calculate shortest turns (clockwise vs. counter-clockwise)\n    # Adding 4 and modulo 4 ensures positive results for subtraction\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      # Assuming RIGHT_ACTION makes agent turn clockwise (e.g., N->E)\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION)\n    else:\n      # Assuming LEFT_ACTION makes agent turn counter-clockwise (e.g., N->W)\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION)\n    return actions\n\n  # Get primitive's integer ID\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir\n  # grid.shape is (HEIGHT, WIDTH, KINDS)\n  grid_height, grid_width, _ = grid.shape \n\n  # Impassable items are those that cannot be picked up or moved through.\n  impassable_kinds = env.world.non_grabbable_indices\n\n  def is_passable(x, y):\n    \"\"\"Checks if a cell (x, y) is within bounds and does not contain impassable objects.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    \n    # Check if the cell contains any impassable kind\n    for kind_idx in impassable_kinds:\n      if grid[y, x, kind_idx] == 1:\n        return False # Contains an impassable object\n    return True\n\n  # Find all locations of the primitive on the grid\n  # np.where returns (row_indices, col_indices) which correspond to (y_coords, x_coords)\n  primitive_locations_set = set() # Use a set for O(1) lookup\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n  for i in range(len(x_coords)):\n    primitive_locations_set.add((x_coords[i], y_coords[i]))\n\n  if not primitive_locations_set:\n    return [] # Primitive not found on the grid\n\n  # Check if the primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  # --- BFS to find the shortest path to an adjacent cell of any primitive ---\n  # Queue stores (x, y, current_direction, path_actions_taken)\n  queue = collections.deque([(agent_pos_x, agent_pos_y, agent_dir, [])])\n  # Visited set stores (x, y) tuples to prevent cycles and re-exploring the same cell,\n  # as moves and turns are assumed to have equal cost in CraftWorld.\n  visited_positions = set([(agent_pos_x, agent_pos_y)])\n\n  # Movement deltas for cardinal directions\n  MOVE_DELTAS = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  # Cardinal neighbor deltas for checking adjacency\n  CARDINAL_NEIGHBOR_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # dx, dy\n\n  while queue:\n    curr_x, curr_y, curr_dir, path = queue.popleft()\n\n    # Check if the current position is adjacent to any primitive\n    # We prioritize this check because if we're already adjacent, we just need to turn and USE.\n    for dx, dy in CARDINAL_NEIGHBOR_DELTAS:\n      check_item_x, check_item_y = curr_x + dx, curr_y + dy\n      if (check_item_x, check_item_y) in primitive_locations_set:\n        # Found an adjacent primitive! Calculate final actions.\n        target_face_dir = _get_target_facing_direction(curr_x, curr_y, check_item_x, check_item_y)\n        # _get_target_facing_direction will never return None for a valid adjacent cell\n        turn_actions = _get_turn_actions(curr_dir, target_face_dir)\n        return path + turn_actions + [USE_ACTION]\n\n    # Explore neighbors (move actions)\n    for action, (dx, dy) in MOVE_DELTAS.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = ACTION_TO_DIR_MAP[action] # Agent faces in the direction of movement\n\n      if (next_x, next_y) not in visited_positions and is_passable(next_x, next_y):\n        visited_positions.add((next_x, next_y))\n        queue.append((next_x, next_y, next_dir, path + [action]))\n  \n  # If the queue becomes empty and no path was found, the primitive is unreachable.\n  return []", "island_id": 4, "scores": {"3": 0.0}}
