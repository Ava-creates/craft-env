{"timestamp": "2025-07-30T06:10:06.224953", "function_name": "collect", "function_body": "  # 1. Check current inventory\n  obs = env.observations()\n  inventory = obs['features_dict']['inventory']\n  if inventory[primitive] > 0:\n    return [] # Already collected\n\n  # Get initial state information\n  current_pos = tuple(obs['features_dict']['pos']) # (x, y)\n  grid = obs['features_dict']['features_global'] # (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n\n  # Define possible movements and corresponding actions (dx, dy): action\n  # Assuming these constants are defined globally or imported in the surrounding context.\n  # ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT, ACTION_USE\n  MOVES = {\n      (0, -1): ACTION_UP,\n      (0, 1): ACTION_DOWN,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT,\n  }\n\n  # Get blocking entities from CraftWorld (assuming CraftLab.world is CraftWorld instance)\n  # Entities in non_grabbable_indices cannot be moved onto for collection via USE.\n  # The primitive itself also cannot be moved onto for USE collection.\n  blocking_indices = set(env.world.non_grabbable_indices)\n\n  # 2. Find all locations of the primitive\n  primitive_positions = []\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          if grid[x, y, primitive] == 1:\n              primitive_positions.append((x, y))\n\n  # If the primitive doesn't exist on the map, it's unreachable\n  if not primitive_positions:\n      return []\n\n  # BFS setup\n  # Using collections.deque for efficient popping from the left.\n  # Assuming collections is imported in the surrounding context.\n  q = collections.deque([(current_pos, [])]) # (current_pos, path_actions_to_reach_current_pos)\n  visited = {current_pos}\n\n  # BFS loop\n  while q:\n    (cx, cy), path_actions = q.popleft()\n\n    # Check if current position is adjacent to the target primitive\n    # This checks the 3x3 neighborhood around (cx, cy) for the primitive.\n    found_adjacent_primitive_in_grid = False\n    for dx_nb in [-1, 0, 1]:\n        for dy_nb in [-1, 0, 1]:\n            if dx_nb == 0 and dy_nb == 0: # Skip self\n                continue\n            nb_x, nb_y = cx + dx_nb, cy + dy_nb\n            if 0 <= nb_x < WIDTH and 0 <= nb_y < HEIGHT and grid[nb_x, nb_y, primitive] == 1:\n                found_adjacent_primitive_in_grid = True\n                break\n        if found_adjacent_primitive_in_grid:\n            break\n\n    if found_adjacent_primitive_in_grid:\n        # If we are next to the primitive, add the USE action and return the path\n        return path_actions + [ACTION_USE]\n\n    # Explore neighbors\n    for (dx, dy), action in MOVES.items():\n        next_x, next_y = cx + dx, cy + dy\n        next_pos = (next_x, next_y)\n\n        # Check bounds\n        if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n            continue\n\n        # Check if already visited\n        if next_pos in visited:\n            continue\n\n        # Check traversability:\n        # A cell is blocked if it contains the primitive we are trying to collect\n        # (as we want to move next to it, not onto it for USE collection)\n        # or if it contains any entity from the `non_grabbable_indices` set,\n        # which are typically impassable.\n        is_blocked = False\n        if grid[next_x, next_y, primitive] == 1: # Cannot walk onto the primitive itself\n            is_blocked = True\n        else:\n            for k_idx in blocking_indices:\n                if grid[next_x, next_y, k_idx] == 1:\n                    is_blocked = True\n                    break\n        \n        if is_blocked:\n            continue\n\n        # If not blocked and not visited, add to queue\n        visited.add(next_pos)\n        q.append((next_pos, path_actions + [action]))\n\n  # If BFS completes and no path is found to an adjacent primitive\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:10:06.294518", "function_name": "collect", "function_body": "    # Action constants as defined in CraftLab.action_specs()\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Map movement action to (delta_row, delta_col)\n    ACTION_TO_DELTAS = {\n        UP: (-1, 0),\n        DOWN: (1, 0),\n        LEFT: (0, -1),\n        RIGHT: (0, 1),\n    }\n\n    # Map movement action to the resulting agent direction\n    # When moving UP, the agent's new direction becomes UP (index 1)\n    ACTION_TO_DIRECTION = {\n        DOWN: 0,\n        UP: 1,\n        LEFT: 2,\n        RIGHT: 3,\n    }\n\n    # Map direction to (delta_row, delta_col) for the cell *in front* of the agent\n    # If agent faces DOWN (dir 0), the cell in front is (r+1, c)\n    DIR_TO_DELTAS = {\n        0: (1, 0),  # DOWN\n        1: (-1, 0), # UP\n        2: (0, -1), # LEFT\n        3: (0, 1),  # RIGHT\n    }\n\n    current_obs = env.observations()\n    current_inventory = current_obs['features_dict']['inventory']\n\n    # If the primitive is already in inventory, no actions needed\n    if current_inventory[primitive] > 0:\n        return []\n\n    grid = current_obs['features_dict']['features_global']\n    start_r, start_c = current_obs['features_dict']['pos']\n    start_dir = np.argmax(current_obs['features_dict']['direction'])\n\n    grid_height, grid_width, _ = grid.shape\n\n    # BFS state: (row, col, direction, path_actions)\n    q = collections.deque([(start_r, start_c, start_dir, [])])\n    # Visited state: (row, col, direction) to avoid cycles and redundant paths\n    visited = set([(start_r, start_c, start_dir)])\n\n    while q:\n        r, c, d, path = q.popleft()\n\n        # Check if we can collect the primitive from the current position and direction\n        # Calculate the cell directly in front of the agent\n        target_r_front, target_c_front = r + DIR_TO_DELTAS[d][0], c + DIR_TO_DELTAS[d][1]\n\n        # Ensure the cell in front is within grid boundaries\n        if (0 <= target_r_front < grid_height and\n                0 <= target_c_front < grid_width):\n            # If the primitive is present in the cell in front, we can USE it\n            if grid[target_r_front, target_c_front, primitive] > 0:\n                return path + [USE]\n\n        # Explore possible movement actions (UP, DOWN, LEFT, RIGHT)\n        for action in [UP, DOWN, LEFT, RIGHT]:\n            dr, dc = ACTION_TO_DELTAS[action]\n            next_r, next_c = r + dr, c + dc\n            next_d = ACTION_TO_DIRECTION[action] # Agent's new direction after this move\n\n            # Check if the next position is within grid boundaries\n            if (0 <= next_r < grid_height and\n                    0 <= next_c < grid_width):\n                # For simplicity, assuming all grid cells within bounds are traversable.\n                # In a more complex scenario, one might check `env.world.non_grabbable_indices`\n                # to avoid moving into blocking entities like water or stone.\n                # However, this info isn't directly exposed via `env` (CraftLab)\n                # in a way that allows a generic check here without further assumptions.\n\n                next_state = (next_r, next_c, next_d)\n                if next_state not in visited:\n                    visited.add(next_state)\n                    q.append((next_r, next_c, next_d, path + [action]))\n\n    # If the BFS queue is exhausted and the primitive was not collected, it means\n    # the primitive is unreachable from the current state.\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:11:22.468760", "function_name": "collect", "function_body": "    # Get the initial state of the CraftWorld environment\n    current_state = env.scenario.init()\n\n    # Retrieve action integer mappings from the environment's action specifications\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    # Get the integer index for the target primitive using the cookbook's index\n    try:\n        # Assuming `env.world.cookbook.index` supports dictionary-like access\n        primitive_idx = env.world.cookbook.index[primitive]\n    except KeyError:\n        # If the primitive name is not recognized, it cannot be collected.\n        return []\n\n    actions_plan = []\n    # Set an arbitrary maximum number of planning steps to prevent infinite loops\n    MAX_PLAN_STEPS = 200\n\n    # Get indices of non-grabbable items which act as obstacles in pathfinding\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # Define a mapping from relative movement (dr, dc) to action integers for pathfinding\n    movement_action_map = {\n        (0, 1): ACTION_RIGHT,  # Move right\n        (0, -1): ACTION_LEFT,   # Move left\n        (1, 0): ACTION_DOWN,    # Move down\n        (-1, 0): ACTION_UP,     # Move up\n    }\n\n    # Simulation loop to plan actions until the primitive is collected or limits are reached\n    for _ in range(MAX_PLAN_STEPS):\n        # Check if the primitive is already in the inventory (goal achieved)\n        if current_state.inventory[primitive_idx] > 0:\n            break  # Exit the planning loop\n\n        # Check if the agent is currently next to the primitive, meaning it can be collected\n        if current_state.next_to(primitive_idx):\n            actions_plan.append(ACTION_USE)\n            # Simulate the USE action and update the current state\n            _reward, current_state = current_state.step(ACTION_USE)\n            # After trying to USE, re-check if the item was successfully collected.\n            # This handles cases where multiple uses are needed or the item is depleted.\n            if current_state.inventory[primitive_idx] > 0:\n                break  # Goal achieved\n            continue  # Continue planning, perhaps another USE is needed or target moved\n\n        # If not next to the primitive, find a path to become adjacent to it.\n        # This assumes `_bfs_path_to_adjacent` is an external helper function\n        # available in the current scope.\n        path_segment = _bfs_path_to_adjacent(\n            current_state.pos,\n            primitive_idx,\n            current_state.grid,\n            non_grabbable_indices,\n            movement_action_map\n        )\n\n        if path_segment is None:\n            # If no path is found, the primitive is either not on the grid or is unreachable.\n            return []  # Indicate failure to collect\n\n        if not path_segment:\n            # If BFS returns an empty path, it implies the agent is already at an adjacent\n            # position, but `current_state.next_to` was false. This indicates a potential\n            # discrepancy or an unresolvable state. In this case, we cannot move further\n            # and cannot use, so collection is not possible.\n            return []\n\n        # Take the next movement action from the computed path\n        next_movement_action = path_segment[0]\n        actions_plan.append(next_movement_action)\n        # Simulate the movement action and update the current state\n        _reward, current_state = current_state.step(next_movement_action)\n\n    # After the loop, check if the primitive was collected. If not, it means\n    # the maximum planning steps were reached without achieving the goal.\n    if current_state.inventory[primitive_idx] == 0:\n        return []  # Indicate failure to collect within the allowed steps\n\n    return actions_plan", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:11:22.538318", "function_name": "collect", "function_body": "    import collections # Assuming collections is available in the execution environment\n    import numpy as np # Assuming numpy is available in the execution environment\n\n    # Get the current state of the environment.\n    # We retrieve the internal CraftState object from the CraftLab instance.\n    initial_state = env._current_state\n    \n    # If the primitive is already in the agent's inventory, no actions are needed.\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    # Define action constants based on CraftLab.action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n    MOVEMENT_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]\n\n    # Initialize a Breadth-First Search (BFS) queue.\n    # Each element in the queue is a tuple: (current_CraftState_object, list_of_actions_to_reach_this_state).\n    # CraftState.step creates a new CraftState object, which is suitable for BFS simulation.\n    q = collections.deque([(initial_state, [])])\n\n    # Initialize a set to keep track of visited states to prevent cycles and redundant exploration.\n    # A state is defined by the agent's position, direction, and current inventory.\n    # The grid state is implicitly handled by the CraftState object's internal representation\n    # and its behavior on `step` (which returns a new state).\n    visited = set()\n    visited.add((initial_state.pos, initial_state.dir, tuple(initial_state.inventory)))\n\n    # Set a maximum number of exploration steps to prevent infinite loops in case the goal\n    # is unreachable or the environment is very large.\n    max_exploration_steps = 5000 \n    current_exploration_steps = 0\n\n    while q and current_exploration_steps < max_exploration_steps:\n        current_state, current_path = q.popleft()\n        current_exploration_steps += 1\n\n        # Check if the primitive is in the agent's immediate 3x3 neighborhood.\n        if current_state.next_to(primitive):\n            # If it is, the next logical action is to USE.\n            # Simulate the USE action to check if it successfully collects the primitive.\n            # The reward is not relevant for path planning.\n            _reward, state_after_use = current_state.step(ACTION_USE)\n            \n            # If the primitive is now in the inventory, we have successfully collected it.\n            # Return the path that led to this collection.\n            if state_after_use.inventory[primitive] > 0:\n                return current_path + [ACTION_USE]\n        \n        # Explore possible movement actions from the current state.\n        for action in MOVEMENT_ACTIONS:\n            # Simulate the action to get the next CraftState object.\n            # CraftState.step returns a new state, preserving the current_state.\n            _reward, next_state = current_state.step(action)\n            \n            # Create a hashable representation of the next state for the 'visited' set.\n            next_state_representation = (next_state.pos, next_state.dir, tuple(next_state.inventory))\n\n            # If this state has not been visited before, add it to the queue for further exploration.\n            if next_state_representation not in visited:\n                visited.add(next_state_representation)\n                q.append((next_state, current_path + [action]))\n\n    # If the queue becomes empty or the maximum exploration steps are reached,\n    # it means the primitive could not be collected from the current state within the given limits.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:13:17.818953", "function_name": "collect", "function_body": "  import collections # For deque\n\n  # Constants for actions based on CraftLab's action_specs\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  # This mapping is crucial as movement actions determine the agent's new facing direction.\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,    # Moving UP makes agent face UP\n      ACTION_RIGHT: 1, # Moving RIGHT makes agent face RIGHT\n      ACTION_DOWN: 2,  # Moving DOWN makes agent face DOWN\n      ACTION_LEFT: 3   # Moving LEFT makes agent face LEFT\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position)\n  DIR_VEC = {\n      0: (0, -1),  # UP: dy decreases\n      1: (1, 0),   # RIGHT: dx increases\n      2: (0, 1),   # DOWN: dy increases\n      3: (-1, 0)   # LEFT: dx decreases\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information directly from the environment's internal state\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction\n  grid = initial_state.grid # Use the current grid state for pathfinding\n  grid_width, grid_height, _ = grid.shape\n\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a grid cell is within bounds and not an obstacle.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # A cell is not walkable if it contains any non-grabbable item (e.g., walls, water).\n    # Grabbable items (like other primitives) do not block movement.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # 2. Pre-compute all (agent_x, agent_y, agent_direction) target states.\n  # These are the states from which the agent can successfully perform ACTION_USE\n  # to collect the desired 'primitive'.\n  target_states = set()\n\n  # Iterate through every cell on the grid to find instances of the 'primitive'\n  for primitive_x in range(grid_width):\n    for primitive_y in range(grid_height):\n      if grid[primitive_x, primitive_y, primitive] == 1:\n        # Found an instance of the primitive at (primitive_x, primitive_y).\n        # Now, determine all possible agent positions (ax, ay) and directions (adir)\n        # from which this primitive can be targeted for 'USE'.\n\n        # The agent can face any of the four cardinal directions.\n        for agent_dir, (dx, dy) in DIR_VEC.items():\n          # If the agent is at (ax, ay) facing `agent_dir`, it points to (ax+dx, ay+dy).\n          # We want (ax+dx, ay+dy) to be (primitive_x, primitive_y).\n          # So, the agent's required position (ax, ay) is (primitive_x - dx, primitive_y - dy).\n          agent_x = primitive_x - dx\n          agent_y = primitive_y - dy\n\n          # Validate this potential target agent state:\n          # a) The agent's position (agent_x, agent_y) must be walkable.\n          # b) The agent must NOT be standing directly on the primitive it intends to pick up.\n          #    (It picks up adjacent items).\n          if is_walkable(agent_x, agent_y) and grid[agent_x, agent_y, primitive] == 0:\n            target_states.add((agent_x, agent_y, agent_dir))\n\n  # If no primitive instances are found on the grid, or if none are reachable/collectable,\n  # there's no path to find.\n  if not target_states:\n      return []\n\n  # 3. Breadth-First Search (BFS) to find the shortest path.\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken).\n  # The 'current_direction' represents the direction the agent is facing *after* arriving\n  # at (current_x, current_y).\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set tracks (x, y, direction) states to prevent cycles and redundant exploration.\n  # This is crucial because different directions at the same (x,y) location are distinct states\n  # due to the 'USE' action's dependency on direction.\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the current state is one of our predefined target states.\n    # If so, we've found the shortest path.\n    if (curr_x, curr_y, curr_dir) in target_states:\n      return path_actions + [ACTION_USE] # Append the final 'USE' action.\n\n    # Explore possible next movement actions (UP, RIGHT, DOWN, LEFT).\n    # In this environment, movement actions implicitly set the agent's new facing direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Determine the new facing direction based on the movement action taken.\n      next_dir = ACTION_TO_DIR[action]\n      # Calculate the change in position based on this new direction.\n      move_dx, move_dy = DIR_VEC[next_dir]\n      \n      # Calculate the next agent position.\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      \n      # If the next cell is walkable and this specific (position, direction) state\n      # has not been visited yet, add it to the queue.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the BFS queue becomes empty and no path to a target state was found,\n  # it means the primitive is unreachable or uncollectable from the current state.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T06:13:18.804283", "function_name": "collect", "function_body": "  import collections # For deque\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  # This mapping aligns with the directions used in DIR_VEC.\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map direction integer to its (dx, dy) vector (change in position)\n  DIR_VEC = {\n      0: (0, -1),  # UP: (dx, dy) - decreasing y\n      1: (1, 0),   # RIGHT: increasing x\n      2: (0, 1),   # DOWN: increasing y\n      3: (-1, 0)   # LEFT: decreasing x\n  }\n\n  # List of actions that cause movement and change facing direction\n  MOVE_ACTIONS = [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information directly from the environment's internal state\n  current_state = env._current_state\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = current_state.grid # The current grid layout\n  grid_width, grid_height, _ = grid.shape\n\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a grid cell is within bounds and not an obstacle.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # Check if the cell is occupied by any non-grabbable item (which acts as an obstacle).\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # 2. Immediate collection check: Is the agent already positioned and facing the primitive\n  #    such that it can be collected with a single ACTION_USE?\n  current_dx, current_dy = DIR_VEC[start_dir]\n  facing_x, facing_y = start_x + current_dx, start_y + current_dy\n\n  if (0 <= facing_x < grid_width and 0 <= facing_y < grid_height) and \\\n     grid[facing_x, facing_y, primitive] == 1:\n    return [ACTION_USE]\n\n  # 3. Pre-compute all (x, y, direction) states from which the primitive can be collected.\n  # A state (ax, ay, adir) is \"collectable\" if:\n  #   - The agent at (ax, ay) is on a walkable cell.\n  #   - The agent, when facing `adir`, is pointing to a cell (px, py) that contains the primitive.\n  collectable_states = set()\n\n  # Iterate through all cells in the grid to find instances of the primitive\n  for px in range(grid_width):\n    for py in range(grid_height):\n      if grid[px, py, primitive] == 1:\n        # This cell (px, py) contains the primitive.\n        # Now, find all *agent positions* (ax, ay) and *agent directions* (adir)\n        # such that the agent at (ax, ay) facing adir would point to (px, py).\n\n        # Iterate over all possible agent directions (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n        for adir, (dx, dy) in DIR_VEC.items():\n          # If agent is at (ax, ay) and faces (dx, dy), then (ax+dx, ay+dy) is (px, py)\n          # So, the agent's required position (ax, ay) must be (px-dx, py-dy)\n          ax, ay = px - dx, py - dy\n\n          if is_walkable(ax, ay):\n            collectable_states.add((ax, ay, adir))\n\n  # If, after checking for immediate collection, there are no other collectable instances\n  # or no valid approach points on the grid, return an empty path.\n  if not collectable_states:\n      return []\n\n  # 4. Breadth-First Search (BFS) to find the shortest path to a collectable state.\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n  # `current_direction` is the direction the agent is facing *after* arriving at (current_x, current_y).\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to avoid redundant exploration and cycles.\n  # A state is defined by (x, y, direction) because the agent's direction matters\n  # for the ACTION_USE interaction.\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Explore possible next movement actions (UP, RIGHT, DOWN, LEFT)\n    for action in MOVE_ACTIONS:\n      # Determine the new position and direction after taking this action.\n      # The movement vector (dx, dy) corresponds to the direction integer of the action.\n      move_dir_int = ACTION_TO_DIR[action] # Get the direction integer (0-3) for this action\n      move_dx, move_dy = DIR_VEC[move_dir_int]\n      \n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = move_dir_int # Agent faces the direction of its last movement (the action taken)\n\n      # If the next cell is walkable and this (position, direction) state hasn't been visited\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        # If this new state is a collectable one, we found the shortest path.\n        if (next_x, next_y, next_dir) in collectable_states:\n          return path_actions + [action, ACTION_USE]\n        \n        # Otherwise, add it to the queue for further exploration.\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T06:15:08.666302", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Action constants (from problem description context)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVES = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # Offsets for 3x3 neighborhood, including the agent's own position (0,0)\n  # Used for checking CraftState.next_to logic, as the USE action requires\n  # the target item/block to be within this 3x3 area.\n  NEIGHBORHOOD_OFFSETS = [\n      (dx, dy) for dx in [-1, 0, 1] for dy in [-1, 0, 1]\n  ]\n\n  actions = []\n  \n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  # Ensure position is int tuple. CraftState.pos is tuple(int, int)\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  world = env.world\n  # non_grabbable_indices typically include obstacles like water, stone walls, workshops.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for x in range(W):\n      for y in range(H):\n          # A cell is NOT traversable if it contains any non-grabbable item.\n          if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n              traversable_mask[x, y] = False\n  \n  # Ensure the agent's current position is marked as traversable.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] # Agent starts on an untraversable cell, no path possible.\n\n  # 2. Determine target kinds for collection.\n  # The 'primitive' input is the index of the *item* we want to collect (e.g., wood, water).\n  # Items can be collected in two ways:\n  #   a) Picked up directly if lying on the ground (check for `primitive` itself).\n  #   b) Harvested from a source block (e.g., water from a 'water' block, stone from a 'stone' block).\n  # The agent needs to be in a position where CraftState.next_to(target_kind) is True.\n  \n  target_grid_indices = {primitive} # Always include the primitive itself for direct pickup\n\n  primitive_name = world.cookbook.index.get(primitive)\n  if primitive_name == 'water':\n      target_grid_indices.add(world.water_index) # Add water block index as a source\n  elif primitive_name == 'stone':\n      target_grid_indices.add(world.stone_index) # Add stone block index as a source\n  # Extend with more mappings if needed (e.g., 'wood' from a 'tree' block)\n\n  # 3. Perform BFS to find the shortest path to any location from which the primitive can be collected.\n  q = deque([current_pos]) \n  visited = {current_pos}\n  parent = {} # parent[child_pos] = (parent_pos, action_from_parent)\n  \n  found_target_pos = None\n\n  while q:\n      curr_pos = q.popleft()\n      curr_x, curr_y = curr_pos\n\n      # Check if the current position is a valid collection target\n      # A position is a target if, from this position, 'next_to' any of the\n      # target_grid_indices (primitive item or its source block) would be true.\n      is_valid_target_location = False\n      for target_idx in target_grid_indices:\n          for dx, dy in NEIGHBORHOOD_OFFSETS:\n              nx, ny = curr_x + dx, curr_y + dy\n              # Check bounds for the neighboring cell that might contain the target_idx\n              if 0 <= nx < W and 0 <= ny < H:\n                  # If a neighbor cell contains the target_idx, then curr_pos is a valid target location\n                  if grid[nx, ny, target_idx] > 0:\n                      is_valid_target_location = True\n                      break # Found a reason curr_pos is a target\n          if is_valid_target_location:\n              break # No need to check other target_grid_indices if one is found\n\n      if is_valid_target_location:\n          found_target_pos = curr_pos\n          break # Found the shortest path to a valid collection location\n\n      # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n      for action, (dx, dy) in MOVES.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # Check bounds, traversability, and if already visited\n          if (0 <= next_x < W and 0 <= next_y < H and\n              traversable_mask[next_x, next_y] and # Agent cannot move onto non-grabbable obstacles\n              next_pos not in visited):\n              \n              visited.add(next_pos)\n              parent[next_pos] = (curr_pos, action) # Store how we got to next_pos\n              q.append(next_pos)\n  \n  # If no path was found (e.g., primitive is unreachable or doesn't exist)\n  if found_target_pos is None:\n      return [] \n  \n  # 4. Reconstruct the path from found_target_pos back to current_pos\n  path_actions = []\n  node = found_target_pos\n  while node != current_pos:\n      prev_node, action_to_reach_node = parent[node]\n      path_actions.append(action_to_reach_node)\n      node = prev_node\n  \n  path_actions.reverse() # Reverse to get actions from start to target\n  \n  # 5. Append the USE action after the movement path.\n  actions.extend(path_actions)\n  actions.append(USE)\n  \n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T06:15:09.670509", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  actions = []\n  \n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Ensure position is int tuple. CraftState.pos is tuple(int, int)\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  # Current direction is a one-hot array, convert to an integer (0=N, 1=E, 2=S, 3=W)\n  current_dir_one_hot = obs['features_dict']['direction']\n  current_dir = np.argmax(current_dir_one_hot)\n  \n  world = env.world\n  # non_grabbable_indices are assumed to be obstacles that cannot be traversed.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape\n\n  # Action constants (from problem description context)\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Map movement action values to (dx, dy) deltas\n  MOVEMENT_DELTAS = {\n      UP_ACTION: (0, -1),   # (dx, dy) for moving UP (North)\n      DOWN_ACTION: (0, 1),  # (dx, dy) for moving DOWN (South)\n      LEFT_ACTION: (-1, 0), # (dx, dy) for moving LEFT (West)\n      RIGHT_ACTION: (1, 0), # (dx, dy) for moving RIGHT (East)\n  }\n\n  # Map movement action values to the resulting agent direction (0=N, 1=E, 2=S, 3=W)\n  # This assumes that taking a movement action makes the agent face that direction.\n  ACTION_TO_DIRECTION = {\n      UP_ACTION: 0,    # UP action (value 1) results in facing North (direction 0)\n      RIGHT_ACTION: 1, # RIGHT action (value 3) results in facing East (direction 1)\n      DOWN_ACTION: 2,  # DOWN action (value 0) results in facing South (direction 2)\n      LEFT_ACTION: 3,  # LEFT action (value 2) results in facing West (direction 3)\n  }\n\n  # Map (dx, dy) from adjacent cell to target cell to the required agent direction\n  # e.g., if the item is (0,1) relative to the agent's position, the agent must face DOWN (2)\n  RELATIVE_POS_TO_DIRECTION = {\n      (0, -1): 0, # Item is UP relative to agent -> agent must face North\n      (1, 0): 1,  # Item is RIGHT relative to agent -> agent must face East\n      (0, 1): 2,  # Item is DOWN relative to agent -> agent must face South\n      (-1, 0): 3, # Item is LEFT relative to agent -> agent must face West\n  }\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for x in range(W):\n      for y in range(H):\n          if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n              traversable_mask[x, y] = False\n  \n  # Ensure the agent's current position is marked as traversable.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] # Agent starts on an untraversable cell, no path possible.\n\n  # 2. Find all potential (adjacent_pos, required_direction) states\n  # These are the states from which the agent can successfully USE the primitive.\n  target_pickup_states = set() # Stores elements as ((adj_x, adj_y), required_dir)\n  for x in range(W):\n      for y in range(H):\n          if grid[x, y, primitive] > 0: # Found the primitive at (x,y)\n              # Check its 4 cardinal neighbors as potential pickup spots\n              for dx_adj, dy_adj in [ (0, -1), (0, 1), (-1, 0), (1, 0) ]: # Relative positions of neighbors to the item\n                  adj_x, adj_y = x + dx_adj, y + dy_adj\n                  \n                  if (0 <= adj_x < W and 0 <= adj_y < H and\n                      traversable_mask[adj_x, adj_y]): # Neighbor must be within bounds and traversable\n                      \n                      # Calculate the direction the agent needs to face from (adj_x, adj_y) to (x,y)\n                      # (dx_item_rel_agent, dy_item_rel_agent)\n                      required_dir = RELATIVE_POS_TO_DIRECTION.get((x - adj_x, y - adj_y))\n                      if required_dir is not None:\n                          target_pickup_states.add(((adj_x, adj_y), required_dir))\n  \n  if not target_pickup_states:\n      return [] # No primitive found or no reachable pickup spots around it\n\n  # 3. Perform BFS to find the shortest sequence of actions to reach any target_pickup_state\n  # Queue stores (current_pos, current_dir, path_actions_so_far)\n  q = deque([(current_pos, current_dir, [])])\n  # Visited states are (position_tuple, direction_integer) to prevent redundant exploration\n  visited = {(current_pos, current_dir)} \n\n  while q:\n      curr_pos, curr_dir, path_so_far = q.popleft()\n\n      # Check if the current state satisfies any of our target pickup states\n      if (curr_pos, curr_dir) in target_pickup_states:\n          return path_so_far + [USE_ACTION] # Path found, append USE and return\n\n      # Explore movement actions (and potential \"turn in place\" actions if move is blocked)\n      for action_val, (dx, dy) in MOVEMENT_DELTAS.items():\n          target_x, target_y = curr_pos[0] + dx, curr_pos[1] + dy\n          potential_next_dir = ACTION_TO_DIRECTION[action_val]\n\n          if (0 <= target_x < W and 0 <= target_y < H and\n              traversable_mask[target_x, target_y]):\n              # This is a valid movement: agent moves to next_pos\n              next_pos = (target_x, target_y)\n              next_dir = potential_next_dir\n              if (next_pos, next_dir) not in visited:\n                  visited.add((next_pos, next_dir))\n                  q.append((next_pos, next_dir, path_so_far + [action_val]))\n          else:\n              # This is a blocked movement: agent stays at curr_pos but its direction might still change.\n              # This allows for \"turning in place\" by attempting a blocked move.\n              next_pos = curr_pos\n              next_dir = potential_next_dir\n              # Only add to queue if the direction actually changes or it's a new (pos, dir) state\n              if (next_pos, next_dir) not in visited:\n                  visited.add((next_pos, next_dir))\n                  q.append((next_pos, next_dir, path_so_far + [action_val]))\n\n  return [] # No path found to a pickup spot", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T06:16:47.797498", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:16:47.866449", "function_name": "collect", "function_body": "    # Get action mappings from the environment\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    total_actions = []\n\n    # Get initial state. Access the internal CraftState object, which is the current state.\n    current_state = env._current_state\n\n    # Check if the primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Inner BFS helper function. This function finds a sequence of actions\n    # to move the agent to a position adjacent to the target_kind_index.\n    def _find_path_to_adjacent(start_state, target_kind_index, action_map_local):\n        # Grid dimensions from the start_state's grid\n        WIDTH, HEIGHT = start_state.grid.shape[0], start_state.grid.shape[1]\n\n        # Queue stores (current_CraftState, list_of_actions_to_reach_this_state)\n        queue = collections.deque([(start_state, [])])\n        # Visited set stores (pos_x, pos_y, dir) to prevent redundant explorations and cycles.\n        # Agent's direction matters as it changes with movement and can affect future 'USE' actions.\n        visited = set([(start_state.pos[0], start_state.pos[1], start_state.dir)])\n\n        # Max steps to prevent extremely long searches in large or complex maps\n        max_bfs_steps = 2000\n\n        current_bfs_steps = 0\n        while queue and current_bfs_steps < max_bfs_steps:\n            current_bfs_steps += 1\n            current_s, current_path_actions = queue.popleft()\n\n            # Check if the agent is now adjacent to the target primitive\n            if current_s.next_to(target_kind_index):\n                return current_path_actions # Path found\n\n            # Explore possible movement actions (UP, DOWN, LEFT, RIGHT)\n            for action_name in ['UP', 'DOWN', 'LEFT', 'RIGHT']:\n                action = action_map_local[action_name]\n\n                # Simulate the step using the CraftState's own step method.\n                # This does not affect the actual `env`'s state.\n                _, next_s = current_s.step(action)\n\n                new_pos_x, new_pos_y = next_s.pos\n                new_dir = next_s.dir\n\n                # Check if this new state (position and direction) has already been visited\n                if (new_pos_x, new_pos_y, new_dir) not in visited:\n                    visited.add((new_pos_x, new_pos_y, new_dir))\n                    queue.append((next_s, current_path_actions + [action]))\n\n        return None # No path found within the max_bfs_steps limit\n\n    # Loop to attempt collecting the primitive.\n    # This outer loop allows for re-planning if, for example,\n    # the USE action didn't yield the item (e.g., trying to use an already depleted resource).\n    max_collection_attempts = 5 # Safety break for the outer loop\n    collection_attempts = 0\n\n    while current_state.inventory[primitive] == 0 and collection_attempts < max_collection_attempts:\n        collection_attempts += 1\n\n        # Find a path to a location adjacent to the primitive\n        path_to_adjacent = _find_path_to_adjacent(current_state, primitive, action_map)\n\n        if path_to_adjacent is None:\n            # If no path is found, it means the primitive is currently unreachable\n            # or no instances are visible/available on the grid.\n            break\n\n        # Execute the movement actions found by BFS\n        for action in path_to_adjacent:\n            _, done, _ = env.step(action)\n            total_actions.append(action)\n            current_state = env._current_state # Update the internal state reference\n\n            if done:\n                # If the episode terminates during movement, stop and return actions\n                return total_actions\n\n        # After movements, the agent should be adjacent to the primitive.\n        # Now, perform the 'USE' action to attempt collection.\n        _, done, _ = env.step(USE)\n        total_actions.append(USE)\n        current_state = env._current_state # Update state after USE\n\n        if current_state.inventory[primitive] > 0:\n            # Successfully collected the primitive!\n            break\n\n        if done:\n            # If the episode terminates after the USE action (e.g., max_steps reached)\n            break\n\n    return total_actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:19:02.571341", "function_name": "collect", "function_body": "    # Action constants based on CraftLab.action_specs\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Helper function for calculating the position of the cell directly in front of the agent.\n    # This simulates CraftState._get_facing_position.\n    def _get_facing_position(pos, direction, width, height):\n        px, py = pos\n        fx, fy = px, py\n        if direction == 0:  # North (Agent facing UP)\n            fy -= 1\n        elif direction == 1:  # East (Agent facing RIGHT)\n            fx += 1\n        elif direction == 2:  # South (Agent facing DOWN)\n            fy += 1\n        elif direction == 3:  # West (Agent facing LEFT)\n            fx -= 1\n        # Clip coordinates to grid boundaries, similar to how the environment handles it\n        fx = max(0, min(fx, width - 1))\n        fy = max(0, min(fy, height - 1))\n        return (fx, fy)\n\n    # Dictionary to map action constants for movement (UP, RIGHT, DOWN, LEFT)\n    # to their corresponding CraftState.dir integer values (0:N, 1:E, 2:S, 3:W).\n    _MOVE_ACTION_TO_TARGET_DIR = {\n        UP: 0,    # Action UP (1) corresponds to direction North (0)\n        RIGHT: 1, # Action RIGHT (3) corresponds to direction East (1)\n        DOWN: 2,  # Action DOWN (0) corresponds to direction South (2)\n        LEFT: 3   # Action LEFT (2) corresponds to direction West (3)\n    }\n\n    # Retrieve the initial CraftState object from the CraftLab environment.\n    # This allows us to simulate steps and plan actions without modifying the\n    # actual environment state immediately. This involves accessing a private attribute.\n    current_state = env._current_state \n    actions_list = [] # List to store the generated sequence of actions\n\n    # Safety limit to prevent infinite planning loops in case of unachievable goals\n    MAX_PLANNING_STEPS = 200 \n\n    for _ in range(MAX_PLANNING_STEPS):\n        # 1. Check if the primitive item is already in the agent's inventory.\n        # If collected, the task is complete, and we break the planning loop.\n        if current_state.inventory[primitive] > 0:\n            break\n\n        # Get current state details for planning\n        grid = current_state.grid\n        current_pos = current_state.pos\n        current_dir = current_state.dir\n        WIDTH, HEIGHT, _ = grid.shape\n\n        # 2. Locate all instances of the target primitive on the grid.\n        # np.argwhere returns coordinates as (row, col). For a grid indexed as grid[x, y, kind],\n        # this directly corresponds to (x_idx, y_idx).\n        primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n        if len(primitive_locations) == 0:\n            # If the primitive is not found on the map, it cannot be collected.\n            # This might happen if it was already picked up by another agent (not applicable here)\n            # or if it's not spawned. Return the actions planned so far.\n            return actions_list \n\n        # Find the closest instance of the primitive to the agent's current position.\n        closest_primitive_pos = None\n        min_dist_sq = float('inf') # Squared Euclidean distance for efficiency\n        for loc_x, loc_y in primitive_locations:\n            dist_sq = (loc_x - current_pos[0])**2 + (loc_y - current_pos[1])**2\n            if dist_sq < min_dist_sq:\n                min_dist_sq = dist_sq\n                closest_primitive_pos = (loc_x, loc_y)\n        \n        # This check is mostly for robustness, as primitive_locations should not be empty at this point.\n        if closest_primitive_pos is None:\n            return actions_list \n\n        # 3. Check if the agent is positioned directly adjacent to and facing the primitive.\n        facing_pos = _get_facing_position(current_pos, current_dir, WIDTH, HEIGHT)\n        is_facing_primitive = (facing_pos == closest_primitive_pos) and \\\n                              (grid[facing_pos[0], facing_pos[1], primitive] > 0)\n        \n        if is_facing_primitive:\n            # If agent is correctly positioned and facing, append USE action and simulate.\n            actions_list.append(USE)\n            # Simulate the action: CraftState.step returns (reward, new_state)\n            _reward, current_state = current_state.step(USE) \n            # Continue the loop to re-check inventory in the next iteration.\n            continue \n\n        # 4. Plan movement if the primitive is not yet collected and not currently facing.\n        tx, ty = closest_primitive_pos # Target X, Y (primitive's location)\n        px, py = current_pos           # Agent's current X, Y\n\n        move_action = None\n        target_dir_for_move = None\n\n        # Handle the edge case where the agent is already on the same square as the primitive.\n        # Since 'USE' requires facing a different cell, the agent needs to move off\n        # the primitive's square first, then turn, and then use.\n        if px == tx and py == ty:\n            # Simple heuristic: move 'UP' (North) to get off the square.\n            # This might not be optimal or always safe (e.g., if a wall is there),\n            # but it provides a basic strategy for v2.\n            actions_list.append(UP)\n            _reward, current_state = current_state.step(UP)\n            continue # Re-plan from the new position.\n\n        # Prioritize movement along the axis with the larger absolute difference\n        # to encourage more direct pathing (e.g., move all X then all Y, or vice-versa).\n        elif abs(tx - px) > abs(ty - py): # Prioritize X-axis movement\n            if tx != px: # If not already aligned on X-axis\n                move_action = RIGHT if tx > px else LEFT\n                target_dir_for_move = _MOVE_ACTION_TO_TARGET_DIR[move_action]\n        else: # Prioritize Y-axis movement (or if X is already aligned)\n            if ty != py: # If not already aligned on Y-axis\n                move_action = DOWN if ty > py else UP\n                target_dir_for_move = _MOVE_ACTION_TO_TARGET_DIR[move_action]\n        \n        # If no movement is planned, it indicates the agent is stuck or the goal\n        # is unachievable with this simple planner.\n        if move_action is None:\n            return actions_list \n\n        # 5. Plan and execute turns to face the desired movement direction.\n        current_dir_val = current_state.dir\n        # Calculate the shortest turn needed (0=no turn, 1=right, 2=180, 3=left)\n        diff_dir = (target_dir_for_move - current_dir_val + 4) % 4\n\n        # Add turn actions to the list and simulate their effects.\n        if diff_dir == 1:  # Turn 90 degrees Right\n            actions_list.append(RIGHT)\n            _reward, current_state = current_state.step(RIGHT)\n        elif diff_dir == 2:  # Turn 180 degrees (two Right turns)\n            actions_list.append(RIGHT)\n            actions_list.append(RIGHT)\n            _reward, current_state = current_state.step(RIGHT) # Simulate first turn\n            _reward, current_state = current_state.step(RIGHT) # Simulate second turn\n        elif diff_dir == 3:  # Turn 90 degrees Left\n            actions_list.append(LEFT)\n            _reward, current_state = current_state.step(LEFT)\n\n        # 6. Execute the planned movement action.\n        actions_list.append(move_action)\n        _reward, current_state = current_state.step(move_action)\n\n    return actions_list", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:19:02.645081", "function_name": "collect", "function_body": "    # Constants for actions as defined in CraftLab.action_specs\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Maximum number of steps to attempt collection, to prevent infinite loops\n    MAX_COLLECT_STEPS = 500\n\n    # Helper function to check if a specific kind is in the 8-cell neighborhood\n    # around the agent's position in the egocentric grid view.\n    def _is_next_to_kind_in_ego(ego_grid, kind_idx, agent_ego_y, agent_ego_x):\n        \"\"\"\n        Checks if `kind_idx` is present in the 8 adjacent cells (including diagonals)\n        around `(agent_ego_y, agent_ego_x)` in the `ego_grid`.\n        \"\"\"\n        H, W, _ = ego_grid.shape\n        for dy in [-1, 0, 1]:\n            for dx in [-1, 0, 1]:\n                if dy == 0 and dx == 0:  # Skip the agent's own cell\n                    continue\n                ny, nx = agent_ego_y + dy, agent_ego_x + dx\n                if 0 <= ny < H and 0 <= nx < W:\n                    if ego_grid[ny, nx, kind_idx] > 0:\n                        return True\n        return False\n\n    # Helper function to find the relative position of the closest visible kind\n    # in the egocentric grid view.\n    def _find_closest_visible_kind_relative_pos(ego_grid, kind_idx, agent_ego_y, agent_ego_x):\n        \"\"\"\n        Finds the relative (dy, dx) from the agent's position to the closest\n        occurrence of `kind_idx` in `ego_grid`. Prioritizes by Euclidean distance.\n        \"\"\"\n        H, W, _ = ego_grid.shape\n        closest_dist_sq = float('inf')\n        closest_rel_pos = None\n\n        for y in range(H):\n            for x in range(W):\n                if ego_grid[y, x, kind_idx] > 0:\n                    rel_y, rel_x = y - agent_ego_y, x - agent_ego_x\n                    # Skip if the primitive is at the agent's exact location in the ego view\n                    if rel_y == 0 and rel_x == 0:\n                        continue\n                    current_dist_sq = rel_y**2 + rel_x**2\n                    if current_dist_sq < closest_dist_sq:\n                        closest_dist_sq = current_dist_sq\n                        closest_rel_pos = (rel_y, rel_x)\n        return closest_rel_pos\n\n    # Helper function to determine the target absolute cardinal direction\n    # based on a relative position (dy, dx).\n    # Agent directions: 0=N, 1=E, 2=S, 3=W\n    def _get_target_absolute_direction(rel_y, rel_x):\n        \"\"\"\n        Determines the absolute cardinal direction (0=N, 1=E, 2=S, 3=W)\n        to face based on a relative position (dy, dx). Prioritizes dominant axis.\n        \"\"\"\n        # Handle exact cardinal directions first\n        if rel_y < 0 and rel_x == 0: return 0  # North\n        if rel_y == 0 and rel_x > 0: return 1  # East\n        if rel_y > 0 and rel_x == 0: return 2  # South\n        if rel_y == 0 and rel_x < 0: return 3  # West\n\n        # For diagonal or other directions, pick the dominant cardinal axis\n        if abs(rel_y) > abs(rel_x):  # Vertical movement is dominant\n            return 0 if rel_y < 0 else 2  # North or South\n        elif abs(rel_x) > abs(rel_y):  # Horizontal movement is dominant\n            return 1 if rel_x > 0 else 3  # East or West\n        else:  # Exactly diagonal (e.g., (1,1) or (-1,-1)), pick a consistent priority\n            if rel_y < 0: return 0 # North-ish\n            elif rel_y > 0: return 2 # South-ish\n            elif rel_x > 0: return 1 # East-ish\n            else: return 3 # West-ish\n        return None # Should not be reached for non-zero rel_y, rel_x\n\n    actions = []\n    num_steps = 0\n\n    while num_steps < MAX_COLLECT_STEPS:\n        obs = env.observations()\n        inventory = obs['features_dict']['inventory']\n\n        # 1. Check if the primitive is already in the inventory\n        if inventory[primitive] > 0:\n            break  # Goal achieved, exit loop\n\n        ego_grid = obs['features_dict']['features_ego']\n        # Assume the agent is positioned at the center of the egocentric view\n        agent_ego_y, agent_ego_x = ego_grid.shape[0] // 2, ego_grid.shape[1] // 2\n        \n        # Get the agent's current facing direction (0=N, 1=E, 2=S, 3=W)\n        current_dir_one_hot = obs['features_dict']['direction']\n        current_dir = np.argmax(current_dir_one_hot)\n\n        # 2. Check if the primitive is immediately adjacent to the agent\n        if _is_next_to_kind_in_ego(ego_grid, primitive, agent_ego_y, agent_ego_x):\n            action_to_take = USE\n            actions.append(action_to_take)\n            _, done, _ = env.step(action_to_take) # Execute the USE action\n\n            # After trying to USE, re-check inventory to confirm collection\n            if env.observations()['features_dict']['inventory'][primitive] > 0:\n                break # Collected successfully\n            # If not collected, the loop will continue and re-evaluate\n        else: # Primitive is not next to agent, need to move\n            rel_pos = _find_closest_visible_kind_relative_pos(ego_grid, primitive, agent_ego_y, agent_ego_x)\n\n            if rel_pos is not None: # Primitive is visible in the egocentric view\n                rel_y, rel_x = rel_pos\n                target_abs_dir = _get_target_absolute_direction(rel_y, rel_x)\n\n                # Determine the shortest turn to face the target\n                turn_diff = (target_abs_dir - current_dir + 4) % 4\n                \n                if turn_diff == 0:  # Already facing the target direction\n                    action_to_take = UP  # Move forward\n                elif turn_diff == 1:  # Target is 90 degrees to the right\n                    action_to_take = RIGHT\n                elif turn_diff == 3:  # Target is 90 degrees to the left\n                    action_to_take = LEFT\n                else:  # turn_diff == 2 (180 degrees), prefer turning left\n                    action_to_take = LEFT\n                \n                actions.append(action_to_take)\n                _, done, _ = env.step(action_to_take) # Execute movement/turn\n\n            else: # Primitive is not visible in the egocentric view (blind search)\n                # A simple blind search strategy: turn right, then try to move forward.\n                # This causes the agent to sweep the area.\n                action_to_take = RIGHT # First, try turning right\n                actions.append(action_to_take)\n                _, done, _ = env.step(action_to_take)\n\n                # The loop will re-evaluate visibility in the next iteration.\n                # Do not immediately add a UP action here, as turning might reveal the item.\n\n        num_steps += 1\n        # Also check if the environment signals it's done for any reason\n        if done:\n            break\n\n    return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:21:06.616877", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action mappings\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  actions = []\n  obs = env.observations()\n\n  # 1. Check if primitive is already in inventory\n  if obs['features_dict']['inventory'][primitive] > 0:\n      return []\n\n  grid = obs['features_dict']['features_global']\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n\n  agent_x_norm, agent_y_norm = obs['features_dict']['pos']\n  # Rounding is important for converting normalized float position to integer grid coordinates\n  agent_x = int(round(agent_x_norm * (WIDTH - 1)))\n  agent_y = int(round(agent_y_norm * (HEIGHT - 1)))\n  \n  # Determine the nature of the primitive: is it a directly grabbable item or a workshop?\n  is_grabbable_resource = primitive in env.cookbook.primitives\n  is_workshop = primitive in env.workshop_indices\n\n  # Find all locations of the primitive on the grid\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive] > 0)\n  \n  if len(primitive_locations_on_grid) == 0:\n      # Primitive not found on the current grid. Cannot collect this way.\n      return []\n\n  # Define obstacle check function for pathfinding\n  def is_cell_obstacle(x, y):\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return True # Out of bounds is an obstacle\n      \n      # Check if the cell (x,y) contains any item that blocks movement.\n      # An item blocks movement if it is in `env.non_grabbable_indices`\n      # AND it's not the specific target workshop (if `primitive` is a workshop).\n      \n      cell_contents = grid[x, y, :]\n      \n      for k_idx in env.non_grabbable_indices:\n          if cell_contents[k_idx] > 0: # If cell contains this non-grabbable item\n              if is_workshop and k_idx == primitive:\n                  # If the non-grabbable item is the workshop we are targeting,\n                  # it's NOT an obstacle because we want to move onto it.\n                  continue\n              else:\n                  # This non-grabbable item (k_idx) is not the target workshop,\n                  # so it blocks movement for pathfinding.\n                  return True\n      return False\n\n  # Determine the actual target cells for BFS pathfinding\n  # If `primitive` is a grabbable resource, we need to move adjacent to it.\n  # If `primitive` is a workshop, we need to move onto it.\n  final_destinations = set()\n  for tx, ty in primitive_locations_on_grid:\n      if is_grabbable_resource:\n          # Target is any cell adjacent to the resource\n          for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]: # Neighbors: DOWN, UP, LEFT, RIGHT\n              adj_x, adj_y = tx + dx, ty + dy\n              if not is_cell_obstacle(adj_x, adj_y):\n                  final_destinations.add((adj_x, adj_y))\n      elif is_workshop:\n          # Target is the workshop cell itself\n          if not is_cell_obstacle(tx, ty):\n              final_destinations.add((tx, ty))\n      \n  if not final_destinations:\n      return [] # No reachable target cells determined\n\n  # BFS to find the shortest path\n  # Queue stores tuples: (current_x, current_y, list_of_actions_to_reach_here)\n  q = collections.deque([(agent_x, agent_y, [])])\n  # Visited set stores (x, y) coordinates to avoid cycles and redundant paths\n  visited = set([(agent_x, agent_y)])\n\n  best_path_to_target = None\n  min_path_len = float('inf')\n\n  # Check if agent is already at a final destination (e.g., standing on a workshop, or adjacent to a grabbable)\n  if (agent_x, agent_y) in final_destinations:\n      # If already at a target cell, just add the USE action\n      return [USE]\n\n  while q:\n      curr_x, curr_y, path_so_far = q.popleft()\n\n      # Explore neighbors\n      for dx, dy, action_val in [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]:\n          next_x, next_y = curr_x + dx, curr_y + dy\n\n          # Check if the next cell is valid, not an obstacle, and not yet visited\n          if not is_cell_obstacle(next_x, next_y) and (next_x, next_y) not in visited:\n              new_path = path_so_far + [action_val]\n              \n              # If this new position is one of our final destinations\n              if (next_x, next_y) in final_destinations:\n                  current_full_path = new_path + [USE] # Add USE action at the end\n                  if len(current_full_path) < min_path_len:\n                      min_path_len = len(current_full_path)\n                      best_path_to_target = current_full_path\n                  # Continue BFS to find potentially even shorter paths to other target destinations\n              \n              # Add to queue for further exploration if this path isn't too long already\n              # (Optimization: Prune branches longer than current best known path)\n              if len(new_path) < min_path_len - 1: # -1 because we will add USE action\n                  visited.add((next_x, next_y))\n                  q.append((next_x, next_y, new_path))\n      \n  return best_path_to_target if best_path_to_target else []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:21:07.655024", "function_name": "collect", "function_body": "  # Constants for actions as per CraftLab.action_specs\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  actions = []\n  \n  # The env._current_state holds the current CraftState.\n  # We will simulate actions on this state object to collect the sequence of actions.\n  # This assumes 'env' is a CraftLab instance and '_current_state' is accessible.\n  current_state = env._current_state \n  \n  # Set a reasonable maximum number of simulation steps to prevent infinite loops\n  # in cases where the primitive is unreachable or the path is very long.\n  MAX_SIM_STEPS = 500 \n\n  for _ in range(MAX_SIM_STEPS):\n    # 1. Check if the primitive is already in the inventory.\n    if current_state.inventory[primitive] > 0:\n      return actions # Goal achieved, return the collected sequence of actions.\n\n    # 2. Check if the agent is \"next to\" the primitive (within a 3x3 neighborhood).\n    # If so, apply the USE action to collect it.\n    if current_state.next_to(primitive):\n      action = USE\n      actions.append(action)\n      # Simulate the action's effect on the state.\n      # The reward (first return value) is not needed for path planning.\n      _, current_state = current_state.step(action)\n      continue # Re-evaluate the new state immediately (e.g., to check inventory again).\n\n    # 3. If not adjacent, find the nearest primitive on the grid to move towards it.\n    # np.argwhere returns (row, col) indices where the condition is true.\n    # We assume current_state.grid has a shape like (rows, cols, kinds) and \n    # current_state.pos is a tuple (row, col).\n    primitive_locations = np.argwhere(current_state.grid[:, :, primitive] > 0)\n\n    if len(primitive_locations) == 0:\n      # If the primitive is no longer on the grid and not in inventory,\n      # it implies it's uncollectable from the current environment state (e.g., already collected,\n      # or outside current observable area, or goal is inherently unachievable).\n      return actions # Cannot collect, return currently accumulated actions.\n\n    agent_y, agent_x = current_state.pos\n    \n    # Find the closest primitive location using Manhattan distance heuristic.\n    min_dist = float('inf')\n    target_y, target_x = -1, -1 # Initialize with invalid coordinates.\n\n    for py, px in primitive_locations:\n      dist = abs(py - agent_y) + abs(px - agent_x)\n      if dist < min_dist:\n        min_dist = dist\n        target_y, target_x = py, px\n\n    # Determine the best movement action towards the target.\n    dy = target_y - agent_y # Vertical difference.\n    dx = target_x - agent_x # Horizontal difference.\n\n    action = -1 # Placeholder for the chosen action.\n    \n    # Prioritize movement along the axis with the larger absolute difference.\n    # This simple greedy strategy moves the agent closer to the target one step at a time.\n    if abs(dy) >= abs(dx):\n      # Move vertically.\n      if dy < 0: # Target is above the agent (smaller row index).\n        action = UP\n      else: # Target is below the agent (larger row index).\n        action = DOWN\n    else:\n      # Move horizontally.\n      if dx < 0: # Target is to the left of the agent (smaller column index).\n        action = LEFT\n      else: # Target is to the right of the agent (larger column index).\n        action = RIGHT\n    \n    actions.append(action)\n    # Simulate the action's effect on the state.\n    _, current_state = current_state.step(action)\n\n  # If MAX_SIM_STEPS is reached without collecting the primitive,\n  # return the actions accumulated so far. This acts as a safeguard against infinite loops\n  # or unachievable goals in complex environments.\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:22:33.999916", "function_name": "collect", "function_body": "  import collections # Used for collections.deque\n\n  # Helper function defined inside collect_v2 to keep all code within the function.\n  def _find_path_and_use_bfs(grid, start_pos, target_kind_idx, action_values):\n      \"\"\"\n      Finds a path of actions (including a final USE action) to collect a target primitive.\n      Performs BFS on the grid to find the shortest path to a cell adjacent to the target,\n      then appends a USE action.\n      \"\"\"\n      WIDTH, HEIGHT, N_KINDS = grid.shape\n      sx, sy = int(start_pos[0]), int(start_pos[1])\n\n      # Extract actual action values from the passed dictionary\n      ACT_DOWN = action_values['DOWN']\n      ACT_UP = action_values['UP']\n      ACT_LEFT = action_values['LEFT']\n      ACT_RIGHT = action_values['RIGHT']\n      ACT_USE = action_values['USE']\n\n      # Possible moves and their corresponding actions (dx, dy) -> action\n      moves = {\n          (0, 1): ACT_DOWN,\n          (0, -1): ACT_UP,\n          (-1, 0): ACT_LEFT,\n          (1, 0): ACT_RIGHT\n      }\n\n      # Find all cells containing the target primitive\n      target_cells = set(tuple(c) for c in np.argwhere(grid[:, :, target_kind_idx] == 1))\n      if not target_cells:\n          return None # Primitive not on map\n\n      q = collections.deque([((sx, sy), [])]) # (current_position, path_actions)\n      visited = {((sx, sy))} # To keep track of visited positions\n\n      # Safety limit for BFS depth to prevent infinite loops in complex grids\n      MAX_BFS_DEPTH = WIDTH * HEIGHT * 2 \n\n      while q:\n          (curr_x, curr_y), path = q.popleft()\n\n          if len(path) > MAX_BFS_DEPTH:\n              continue\n\n          # Check if the current position is adjacent to any target cell (including being on it)\n          # The `CraftState.next_to` method checks a 3x3 neighborhood.\n          is_adjacent = False\n          for tx, ty in target_cells:\n              if abs(curr_x - tx) <= 1 and abs(curr_y - ty) <= 1:\n                  is_adjacent = True\n                  break\n\n          if is_adjacent:\n              # We found a path to be adjacent. Append the USE action and return the complete path.\n              return path + [ACT_USE]\n\n          # Explore neighboring cells\n          for (dx, dy), action in moves.items():\n              next_x, next_y = curr_x + dx, curr_y + dy\n\n              # Boundary check: ensure the next position is within grid limits\n              if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                  continue\n\n              # Check if the next position has already been visited in this BFS search\n              if (next_x, next_y) not in visited:\n                  visited.add((next_x, next_y))\n                  q.append(((next_x, next_y), path + [action]))\n\n      return None # No path found to be adjacent to the primitive\n\n  # --- End of helper function definition ---\n\n  collected_actions = []\n  MAX_STEPS_ALLOWED = env.max_steps # Use the environment's configured max steps\n\n  # Get action mappings from the environment's action_specs\n  action_specs = env.action_specs()\n  \n  # Store action values in a dictionary for easy passing to the helper function\n  # Includes a basic error check for expected actions.\n  try:\n      action_values = {\n          'DOWN': action_specs['DOWN'],\n          'UP': action_specs['UP'],\n          'LEFT': action_specs['LEFT'],\n          'RIGHT': action_specs['RIGHT'],\n          'USE': action_specs['USE']\n      }\n  except KeyError as e:\n      raise ValueError(f\"Missing expected action in env.action_specs(): {e}. \"\n                       \"Ensure DOWN, UP, LEFT, RIGHT, USE actions are defined.\")\n\n  # Main loop: continue until the primitive is collected or max steps are exhausted\n  while env.steps < MAX_STEPS_ALLOWED:\n      obs = env.observations()\n      current_inventory = obs['features_dict']['inventory']\n\n      # Check if the primitive is already in the agent's inventory\n      if current_inventory[primitive] > 0:\n          return collected_actions # Successfully collected\n\n      current_grid = obs['features_dict']['features_global']\n      current_pos_normalized = obs['features_dict']['pos']\n      \n      WIDTH, HEIGHT, _ = current_grid.shape\n      \n      # Convert normalized position (e.g., [0.0, 1.0]) to integer grid coordinates [0, DIM-1]\n      # `round()` is used to handle potential floating point inaccuracies and map to the nearest cell.\n      current_pos_int = (\n          int(round(current_pos_normalized[0] * (WIDTH - 1))),\n          int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n      )\n\n      # Use the BFS helper to find a path to the primitive (including the USE action)\n      path_actions = _find_path_and_use_bfs(current_grid, current_pos_int, primitive, action_values)\n\n      # If no path is found (None or empty list), the primitive might be unreachable,\n      # already collected, or not on the map.\n      if path_actions is None or not path_actions:\n          return collected_actions # Failed to find/collect the primitive\n\n      # Execute the determined path actions one by one\n      for action in path_actions:\n          # Check if max steps are reached before taking the next action\n          if env.steps >= MAX_STEPS_ALLOWED:\n              return collected_actions # Ran out of steps\n\n          _reward, _done, _ = env.step(action) # Perform the action in the environment\n          collected_actions.append(action) # Record the action\n\n          # After each step (especially after a USE action), re-check the inventory\n          # to see if the primitive has been collected.\n          obs_after_step = env.observations()\n          if obs_after_step['features_dict']['inventory'][primitive] > 0:\n              return collected_actions # Successfully collected\n\n  # If the loop completes, it means MAX_STEPS_ALLOWED was reached without collecting the primitive.\n  return collected_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:22:34.069470", "function_name": "collect", "function_body": "    # Get the initial CraftState from the CraftLab environment\n    # env.reset() returns observations, but we need the internal CraftState for simulation\n    # Call reset to ensure the environment is in a known initial state\n    _ = env.reset()\n    initial_craft_state = env._current_state\n\n    primitive_idx = primitive\n\n    # Check if the primitive is already in inventory at the start\n    if initial_craft_state.inventory[primitive_idx] > 0:\n        return [] # Already collected, no actions needed\n\n    # Define actions using the constants provided in CraftLab's action_specs\n    # Assuming these correspond to: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    MOVE_ACTIONS = [0, 1, 2, 3]\n    USE_ACTION = 4\n\n    # BFS queue: stores (CraftState object, list of actions taken to reach this state)\n    q = collections.deque([(initial_craft_state, [])])\n\n    # Visited set: stores hashable representation of state (pos, dir, tuple(inventory))\n    # This prevents revisiting identical states and avoids infinite loops.\n    visited = set()\n    initial_state_tuple = (initial_craft_state.pos, initial_craft_state.dir, tuple(initial_craft_state.inventory))\n    visited.add(initial_state_tuple)\n\n    # A safety limit to prevent excessively long planning times in complex or unreachable scenarios.\n    # This is a heuristic and can be tuned based on typical map sizes.\n    max_planning_depth = 200\n\n    while q:\n        current_state, path_actions = q.popleft()\n\n        # Stop exploring paths that exceed the maximum planning depth\n        if len(path_actions) >= max_planning_depth:\n            continue\n\n        # Check if the primitive is in inventory in the current state (e.g., after a previous USE action)\n        if current_state.inventory[primitive_idx] > 0:\n            return path_actions\n\n        # If the agent is next to the primitive, try to USE it\n        if current_state.next_to(primitive_idx):\n            # Simulate the USE action\n            # CraftState.step returns (reward, new_state)\n            _, state_after_use = current_state.step(USE_ACTION)\n\n            # Create a hashable representation of the state after USE\n            next_state_tuple = (state_after_use.pos, state_after_use.dir, tuple(state_after_use.inventory))\n\n            # If using the item successfully collected the primitive\n            if state_after_use.inventory[primitive_idx] > 0:\n                return path_actions + [USE_ACTION]\n            # If USE did not collect it (e.g., wrong item, or workshop use), but led to a new state\n            # that hasn't been visited, add it to the queue for further exploration.\n            elif next_state_tuple not in visited:\n                visited.add(next_state_tuple)\n                q.append((state_after_use, path_actions + [USE_ACTION]))\n\n        # Explore movement actions (DOWN, UP, LEFT, RIGHT)\n        for action in MOVE_ACTIONS:\n            # Simulate the movement action\n            _, next_state = current_state.step(action)\n\n            # Create a hashable representation of the next state\n            next_state_tuple = (next_state.pos, next_state.dir, tuple(next_state.inventory))\n\n            # If this state has not been visited, add it to the queue\n            if next_state_tuple not in visited:\n                visited.add(next_state_tuple)\n                q.append((next_state, path_actions + [action]))\n\n    # If the BFS queue is exhausted and the primitive was not found or collected\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:24:03.689466", "function_name": "collect", "function_body": "    # 1. Get action mappings from the environment\n    actions_map = env.action_specs()\n    DOWN_ACTION = actions_map[\"DOWN\"]\n    UP_ACTION = actions_map[\"UP\"]\n    LEFT_ACTION = actions_map[\"LEFT\"]\n    RIGHT_ACTION = actions_map[\"RIGHT\"]\n    USE_ACTION = actions_map[\"USE\"]\n\n    # Define the effects of movement actions on position (dr, dc) and new agent direction.\n    # CraftState.dir: 0=NORTH (UP), 1=EAST (RIGHT), 2=SOUTH (DOWN), 3=WEST (LEFT)\n    _MOVE_EFFECTS = {\n        UP_ACTION: (-1, 0, 0),    # Moving UP: dr=-1, dc=0, new_dir=0 (UP)\n        DOWN_ACTION: (1, 0, 2),   # Moving DOWN: dr=1, dc=0, new_dir=2 (DOWN)\n        LEFT_ACTION: (0, -1, 3),  # Moving LEFT: dr=0, dc=-1, new_dir=3 (LEFT)\n        RIGHT_ACTION: (0, 1, 1),  # Moving RIGHT: dr=0, dc=1, new_dir=1 (RIGHT)\n    }\n    all_move_actions = [DOWN_ACTION, UP_ACTION, LEFT_ACTION, RIGHT_ACTION]\n\n    # Get current state information\n    current_state = env._current_state\n    grid = current_state.grid\n    start_pos = current_state.pos\n    start_dir = current_state.dir\n\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n\n    # 2. Find all locations of the target primitive on the grid\n    primitive_locations = []\n    for r in range(WIDTH):\n        for c in range(HEIGHT):\n            if grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        return []  # The primitive is not found anywhere on the grid\n\n    # 3. Pathfinding using Breadth-First Search (BFS)\n    # The state in the BFS queue and visited set is (row, col, current_direction)\n    # This is important because the 'USE' action requires correct agent orientation.\n    # Each element in the queue is ((r, c, current_dir), list_of_actions_taken_so_far)\n    \n    q = collections.deque([((start_pos[0], start_pos[1], start_dir), [])])\n    visited = {(start_pos[0], start_pos[1], start_dir)}\n    \n    found_path = None\n    \n    while q:\n        (r, c, current_dir), path_so_far = q.popleft()\n\n        # Check if the current agent position (r, c) is adjacent to any primitive\n        # and if the agent is facing that primitive.\n        for pr, pc in primitive_locations:\n            dr_to_primitive = pr - r\n            dc_to_primitive = pc - c\n\n            # Check if agent is adjacent to the primitive (Manhattan distance of 1)\n            if abs(dr_to_primitive) + abs(dc_to_primitive) == 1:\n                # Determine the direction the agent needs to face to interact with this primitive\n                required_dir_to_face_primitive = -1\n                if dr_to_primitive == -1: # Primitive is UP from agent\n                    required_dir_to_face_primitive = 0 # Agent needs to face UP (dir 0)\n                elif dr_to_primitive == 1: # Primitive is DOWN from agent\n                    required_dir_to_face_primitive = 2 # Agent needs to face DOWN (dir 2)\n                elif dc_to_primitive == -1: # Primitive is LEFT from agent\n                    required_dir_to_face_primitive = 3 # Agent needs to face LEFT (dir 3)\n                elif dc_to_primitive == 1: # Primitive is RIGHT from agent\n                    required_dir_to_face_primitive = 1 # Agent needs to face RIGHT (dir 1)\n\n                if current_dir == required_dir_to_face_primitive:\n                    # Found a valid end state: agent is adjacent to a primitive and facing it correctly\n                    found_path = path_so_far\n                    break # Break from inner loop (found a primitive to target)\n            \n        if found_path:\n            break # Break from outer BFS loop (path found)\n\n        # Explore possible next states by trying all movement actions\n        for action_val in all_move_actions:\n            dr, dc, new_dir = _MOVE_EFFECTS[action_val]\n            nr, nc = r + dr, c + dc\n\n            # Check for grid boundaries and if this new state (position + direction) has already been visited\n            if 0 <= nr < WIDTH and 0 <= nc < HEIGHT and (nr, nc, new_dir) not in visited:\n                # Assuming all grid cells are traversable.\n                # In a more complex environment, additional checks for obstacles might be needed.\n                visited.add((nr, nc, new_dir))\n                q.append(((nr, nc, new_dir), path_so_far + [action_val]))\n\n    if not found_path:\n        return []  # No path was found to reach a primitive and face it correctly\n\n    # 4. If a path is found, append the 'USE' action to the sequence\n    return found_path + [USE_ACTION]", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:24:04.693127", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (assuming these are fixed, as in many DMLab-like environments)\n  _DOWN = 0\n  _UP = 1\n  _LEFT = 2\n  _RIGHT = 3\n  _USE = 4\n\n  _MOVE_DELTAS = {\n      _UP: (0, -1),\n      _DOWN: (0, 1),\n      _LEFT: (-1, 0),\n      _RIGHT: (1, 0)\n  }\n\n  current_state = env._current_state\n  grid = current_state.grid\n  initial_x, initial_y = current_state.pos\n  \n  # If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  H, W, N_KINDS = grid.shape\n\n  primitive_locations = []\n  for y in range(H):\n      for x in range(W):\n          # Check if this cell contains the primitive\n          if grid[y, x, primitive] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # Primitive not found on the grid.\n      return []\n\n  # BFS setup\n  q = collections.deque([((initial_x, initial_y), [])]) # (current_pos, path_actions)\n  visited = {(initial_x, initial_y)} # Keep track of visited (x, y) positions\n\n  water_index = env.world.water_index # Get water index for blocking check\n\n  while q:\n      (curr_x, curr_y), path_actions = q.popleft()\n\n      # Check if the current position is adjacent to any primitive location.\n      # If so, we've found the shortest path to an adjacent cell.\n      # Add the USE action and return the complete path.\n      for px, py in primitive_locations:\n          # Manhattan distance of 1 means direct adjacency (not diagonal)\n          if abs(curr_x - px) + abs(curr_y - py) == 1: \n              return path_actions + [_USE]\n\n      # Explore possible moves to neighboring cells\n      for action, (dx, dy) in _MOVE_DELTAS.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # Check boundary conditions\n          if not (0 <= next_x < W and 0 <= next_y < H):\n              continue\n\n          # Check if the next cell is blocked\n          is_blocked = False\n          \n          # 1. Blocked by water (assuming water is impassable)\n          if grid[next_y, next_x, water_index] > 0:\n              is_blocked = True\n          \n          # 2. Blocked by the primitive itself (assuming primitives like stone/wood are solid objects \n          #    you stand next to, rather than on, to collect)\n          if (next_x, next_y) in primitive_locations:\n              is_blocked = True\n\n          if is_blocked:\n              continue\n\n          # If the cell is not blocked and hasn't been visited yet, add it to the queue\n          if next_pos not in visited:\n              visited.add(next_pos)\n              q.append((next_pos, path_actions + [action]))\n\n  # If the queue becomes empty and no path to an adjacent primitive was found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:25:50.981397", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Define actions as constants\n  class Actions:\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n  initial_state = env._current_state\n\n  # Check if primitive is already collected in the initial state\n  if initial_state.inventory[primitive] > 0:\n    return []\n\n  # Queue for BFS: stores (CraftState instance, list of actions to reach this state)\n  q = collections.deque([(initial_state, [])])\n\n  # Visited set: stores (position_tuple, direction_int) to avoid redundant computation\n  # for movement. We only care about unique (pos, dir) states for pathfinding.\n  # The inventory change is checked at the goal condition, after a potential 'USE' action.\n  visited_pos_dir = set()\n  \n  # Movement actions\n  movement_actions = [Actions.DOWN, Actions.UP, Actions.LEFT, Actions.RIGHT]\n\n  # Get the CraftWorld instance from the current state for checking grabbability\n  world = initial_state.world\n\n  while q:\n    current_state, actions_path = q.popleft()\n\n    current_pos_dir = (current_state.pos, current_state.dir)\n\n    # If this (pos, dir) state has been visited already through a shorter path, skip.\n    # This also implicitly handles cases where a `step` action resulted in no change in pos/dir (e.g., hitting a wall).\n    if current_pos_dir in visited_pos_dir:\n      continue\n    \n    # Mark the current (pos, dir) state as visited\n    visited_pos_dir.add(current_pos_dir)\n\n    # --- Goal Check ---\n    # If the agent is next to the primitive AND the primitive is a grabbable item,\n    # attempt to collect it using the 'USE' action.\n    if current_state.next_to(primitive) and primitive in world.grabbable_indices:\n      # Simulate the 'USE' action from the current state.\n      # `step` returns a new state with updated inventory/grid if 'USE' is successful.\n      _reward_use, state_after_use = current_state.step(Actions.USE)\n      \n      # Check if the primitive is now in the inventory of the state *after* 'USE'.\n      if state_after_use.inventory[primitive] > 0:\n        return actions_path + [Actions.USE]\n      # If 'USE' didn't result in collection (e.g., resource might be depleted,\n      # or other internal logic prevented collection), then this specific next_to spot\n      # wasn't viable for collection. Continue exploring other movement paths.\n\n    # --- Explore Neighbors (Movement Actions) ---\n    for action in movement_actions:\n      # Apply the movement action to get the next state\n      _reward, next_state = current_state.step(action)\n      next_pos_dir = (next_state.pos, next_state.dir)\n\n      # Only enqueue if this (pos, dir) state has not been visited before.\n      # This ensures we explore unique (pos, dir) states and find the shortest path to them.\n      if next_pos_dir not in visited_pos_dir:\n          q.append((next_state, actions_path + [action]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # return an empty list of actions.\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:25:51.973417", "function_name": "collect", "function_body": "  # Action constants (from CraftLab/CraftState)\n  MOVE_DOWN = 0\n  MOVE_UP = 1\n  TURN_LEFT = 2\n  TURN_RIGHT = 3\n  USE_ACTION = 4\n\n  # Direction to delta mapping for agent's facing direction\n  # 0: North (Up, (0,-1)), 1: East (Right, (1,0)), 2: South (Down, (0,1)), 3: West (Left, (-1,0))\n  DIR_TO_DELTA = {\n      0: (0, -1),  # North\n      1: (1, 0),   # East\n      2: (0, 1),   # South\n      3: (-1, 0)   # West\n  }\n  ALL_DELTAS = [(0, -1), (1, 0), (0, 1), (-1, 0)] # Cardinal neighbors (dx, dy)\n\n  def get_actions_and_new_dir_for_move(current_pos, current_dir, next_pos):\n    \"\"\"\n    Calculates the sequence of actions (turns and move) to go from current_pos\n    to next_pos, and the agent's new direction. Assumes next_pos is adjacent\n    to current_pos.\n    \"\"\"\n    cx, cy = current_pos\n    nx, ny = next_pos\n    target_dx, target_dy = nx - cx, ny - cy\n\n    actions = []\n    new_dir = current_dir\n\n    # Check if target is directly in front (MOVE_UP) or behind (MOVE_DOWN)\n    if (target_dx, target_dy) == DIR_TO_DELTA[current_dir]:\n      actions.append(MOVE_UP)\n    elif (target_dx, target_dy) == DIR_TO_DELTA[(current_dir + 2) % 4]: # Behind\n      actions.append(MOVE_DOWN)\n    else: # Need to turn\n      # Determine the target direction the agent needs to face to move to next_pos\n      target_facing_dir = -1\n      for d, delta_val in DIR_TO_DELTA.items():\n        if delta_val == (target_dx, target_dy):\n          target_facing_dir = d\n          break\n      \n      # Calculate turns needed\n      turns_needed = (target_facing_dir - current_dir + 4) % 4\n      if turns_needed == 1:\n        actions.append(TURN_RIGHT)\n        new_dir = (current_dir + 1) % 4\n      elif turns_needed == 2:\n        actions.extend([TURN_RIGHT, TURN_RIGHT])\n        new_dir = (current_dir + 2) % 4\n      elif turns_needed == 3:\n        actions.append(TURN_LEFT)\n        new_dir = (current_dir - 1 + 4) % 4\n\n      actions.append(MOVE_UP) # After turning, move forward\n\n    return actions, new_dir\n\n  # Get initial state from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  start_pos = tuple(map(int, obs['features_dict']['pos']))\n  start_dir = np.argmax(obs['features_dict']['direction'])\n\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n\n  # Find all locations of the primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      if grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  if not primitive_locations:\n    return [] # Primitive not found on the grid\n\n  # BFS to find the shortest path to a cell adjacent to the primitive\n  # State in queue: ((current_pos, current_dir), actions_taken_so_far)\n  queue = collections.deque([((start_pos, start_dir), [])])\n  visited = set([(start_pos, start_dir)]) # Store (pos, dir) to avoid cycles and redundant paths\n\n  while queue:\n    current_state, actions_path = queue.popleft()\n    current_pos, current_dir = current_state\n    cx, cy = current_pos\n\n    # Check if current_pos is adjacent to any primitive location\n    for px, py in primitive_locations:\n      if abs(cx - px) + abs(cy - py) == 1: # Manhattan distance 1 means adjacent\n        # Reached a spot next to the primitive. Now, orient towards it and USE.\n        final_actions = list(actions_path) # Make a copy to add final steps\n\n        # Calculate turns needed to face the primitive\n        target_dx, target_dy = px - cx, py - cy\n        target_facing_dir = -1\n        for d, delta_val in DIR_TO_DELTA.items():\n          if delta_val == (target_dx, target_dy):\n            target_facing_dir = d\n            break\n\n        turns_needed = (target_facing_dir - current_dir + 4) % 4\n        if turns_needed == 1:\n          final_actions.append(TURN_RIGHT)\n        elif turns_needed == 2:\n          final_actions.extend([TURN_RIGHT, TURN_RIGHT])\n        elif turns_needed == 3:\n          final_actions.append(TURN_LEFT)\n        \n        final_actions.append(USE_ACTION)\n        return final_actions # Found shortest sequence of actions\n\n    # Explore valid neighboring cells\n    for dx, dy in ALL_DELTAS:\n      nx, ny = cx + dx, cy + dy\n\n      # Check grid boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n      \n      # Check if the next cell is an obstacle (e.g., water)\n      # A cell is considered an obstacle if it contains a non-grabbable item\n      # that is not the primitive we are looking for.\n      is_obstacle = False\n      # Iterate through all kinds present at (nx, ny)\n      for k in range(N_KINDS):\n          if grid[nx, ny, k] == 1:\n              # If it's a non-grabbable item (and not the primitive itself if it happens to be walkable, though primitives are usually grabbable)\n              if k in env.world.non_grabbable_indices and k != primitive:\n                  is_obstacle = True\n                  break\n      \n      if is_obstacle:\n        continue\n\n      # Get the actions and new direction for moving to this neighbor\n      move_actions, new_dir_after_move = get_actions_and_new_dir_for_move(current_pos, current_dir, (nx, ny))\n      next_state = ((nx, ny), new_dir_after_move)\n\n      if next_state not in visited:\n        visited.add(next_state)\n        queue.append((next_state, actions_path + move_actions))\n\n  return [] # No path found to any primitive location", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:27:14.983827", "function_name": "collect", "function_body": "    current_state = env._current_state\n    \n    # 1. Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions\n    grid_height, grid_width, _ = current_state.grid.shape\n\n    # BFS for pathfinding\n    queue = collections.deque()\n    # State: (row, col, direction, actions_taken)\n    queue.append((current_state.pos[0], current_state.pos[1], current_state.dir, []))\n\n    visited = set()\n    visited.add((current_state.pos[0], current_state.pos[1], current_state.dir))\n\n    # Get non-grabbable (obstacle) indices\n    obstacle_kinds = env.non_grabbable_indices \n    \n    # Define action constants based on CraftLab's action_specs and common interpretation\n    # UP (1) implies move forward relative to current direction\n    # DOWN (0) implies move backward relative to current direction\n    # LEFT (2) implies turn left\n    # RIGHT (3) implies turn right\n    # USE (4) implies interact with the cell in front\n    ACTION_MOVE_BACKWARD = 0 \n    ACTION_MOVE_FORWARD = 1  \n    ACTION_TURN_LEFT = 2     \n    ACTION_TURN_RIGHT = 3    \n    ACTION_USE = 4\n\n    # Direction deltas for agent facing North=0, East=1, South=2, West=3\n    # DR[dir] = delta row, DC[dir] = delta col\n    DR = [-1, 0, 1, 0] # North, East, South, West\n    DC = [0, 1, 0, -1] # North, East, South, West\n\n    while queue:\n        r, c, d, actions_taken = queue.popleft()\n\n        # Check if the cell directly in front of the agent contains the primitive.\n        # If so, we are in a position to use the primitive.\n        front_r, front_c = r + DR[d], c + DC[d]\n        if (0 <= front_r < grid_height and 0 <= front_c < grid_width and\n            current_state.grid[front_r, front_c, primitive] > 0):\n            return actions_taken + [ACTION_USE]\n\n        # Consider possible actions: Move Forward, Move Backward, Turn Left, Turn Right\n        \n        # 1. Try to Move Forward\n        next_r_f, next_c_f = r + DR[d], c + DC[d]\n        if (0 <= next_r_f < grid_height and 0 <= next_c_f < grid_width and\n            (next_r_f, next_c_f, d) not in visited):\n            # Check for obstacles at next_r_f, next_c_f\n            is_obstacle = False\n            for kind_idx in obstacle_kinds:\n                if current_state.grid[next_r_f, next_c_f, kind_idx] > 0:\n                    is_obstacle = True\n                    break\n            if not is_obstacle:\n                visited.add((next_r_f, next_c_f, d))\n                queue.append((next_r_f, next_c_f, d, actions_taken + [ACTION_MOVE_FORWARD]))\n\n        # 2. Try to Move Backward\n        next_r_b, next_c_b = r - DR[d], c - DC[d]\n        if (0 <= next_r_b < grid_height and 0 <= next_c_b < grid_width and\n            (next_r_b, next_c_b, d) not in visited):\n            # Check for obstacles\n            is_obstacle = False\n            for kind_idx in obstacle_kinds:\n                if current_state.grid[next_r_b, next_c_b, kind_idx] > 0:\n                    is_obstacle = True\n                    break\n            if not is_obstacle:\n                visited.add((next_r_b, next_c_b, d))\n                queue.append((next_r_b, next_c_b, d, actions_taken + [ACTION_MOVE_BACKWARD]))\n\n        # 3. Try to Turn Left\n        next_d_left = (d - 1 + 4) % 4\n        if (r, c, next_d_left) not in visited:\n            visited.add((r, c, next_d_left))\n            queue.append((r, c, next_d_left, actions_taken + [ACTION_TURN_LEFT]))\n\n        # 4. Try to Turn Right\n        next_d_right = (d + 1) % 4\n        if (r, c, next_d_right) not in visited:\n            visited.add((r, c, next_d_right))\n            queue.append((r, c, next_d_right, actions_taken + [ACTION_TURN_RIGHT]))\n\n    # If no path found after exploring all reachable states\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:27:15.063982", "function_name": "collect", "function_body": "    import collections # Need deque\n\n    state = env._current_state\n    grid = state.grid\n    current_pos = state.pos # (x, y)\n    world = env.world\n\n    WIDTH, HEIGHT, _ = grid.shape # grid is (WIDTH, HEIGHT, N_KINDS)\n\n    # Check if the primitive is already in inventory\n    if state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # Define what constitutes an obstacle\n    # These are non-grabbable items on the grid that block movement\n    non_grabbable_indices = world.non_grabbable_indices\n    \n    def is_blocked(x, y):\n        \"\"\"Checks if the cell (x, y) is blocked by non-grabbable items or is out of bounds.\"\"\"\n        # Check bounds first\n        if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n            return True # Out of bounds is blocked\n        \n        # Check if any non-grabbable item exists at this cell\n        # grid[x, y, k] > 0 indicates presence of item k at (x,y)\n        for k in non_grabbable_indices:\n            if grid[x, y, k] > 0:\n                return True\n        return False\n\n    # Define target positions where the agent can stand to USE the primitive.\n    # These are all cells (tx, ty) such that (tx, ty) is in the 3x3 neighborhood\n    # of any cell (px, py) containing the primitive, and (tx, ty) is a walkable cell.\n    target_use_positions_set = set()\n    for px in range(WIDTH):\n        for py in range(HEIGHT):\n            if grid[px, py, primitive] > 0:\n                # This cell (px, py) contains the primitive.\n                # Now find all walkable cells in its 3x3 neighborhood (including itself).\n                for dx in [-1, 0, 1]:\n                    for dy in [-1, 0, 1]:\n                        tx, ty = px + dx, py + dy\n                        if not is_blocked(tx, ty): # Agent must be able to stand on (tx, ty)\n                            target_use_positions_set.add((tx, ty))\n\n    # If no valid target positions exist (e.g., primitive is surrounded by walls, or doesn't exist),\n    # then it's unreachable.\n    if not target_use_positions_set:\n        return []\n\n    # BFS Setup\n    q = collections.deque()\n    visited = set() # Store (x, y) tuples to avoid redundant exploration\n\n    # Initial state: (position, path_to_reach_this_pos)\n    q.append((current_pos, []))\n    visited.add(current_pos)\n\n    # Action mapping to (dx, dy) changes for movement actions.\n    # These are assumed global directions based on CraftLab.action_specs.\n    # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    # (dx, dy) for (column_change, row_change)\n    MOVE_DELTAS = {\n        1: (0, -1),   # UP\n        0: (0, 1),    # DOWN\n        2: (-1, 0),   # LEFT\n        3: (1, 0),    # RIGHT\n    }\n    USE_ACTION = 4\n    \n    while q:\n        (x, y), path = q.popleft()\n\n        # Check if current position is one of the target use positions\n        if (x, y) in target_use_positions_set:\n            # If so, we've found the shortest path to a spot where we can USE the item.\n            return path + [USE_ACTION]\n\n        # Explore movement actions from the current position\n        for action, (dx, dy) in MOVE_DELTAS.items():\n            next_x, next_y = x + dx, y + dy\n            next_pos = (next_x, next_y)\n\n            # Only move to valid, unblocked, and unvisited cells\n            if not is_blocked(next_x, next_y) and next_pos not in visited:\n                visited.add(next_pos)\n                q.append((next_pos, path + [action]))\n    \n    # If BFS completes without finding a path to any target_use_position,\n    # it means the primitive is unreachable.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:28:05.248167", "function_name": "collect", "function_body": "  # Constants (moved inside as per instructions)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  DIR_VEC = {\n      0: (0, -1),  # UP (decreases y)\n      1: (1, 0),   # RIGHT (increases x)\n      2: (0, 1),   # DOWN (increases y)\n      3: (-1, 0)   # LEFT (decreases x)\n  }\n\n  # Pre-check: If the primitive is not a grabbable item, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get the initial state details for the BFS starting point\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir  # Agent's initial facing direction\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Identify indices of entities that block movement (non-grabbable items like water, workshops etc.)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to determine if a cell is traversable.\n  def is_walkable(x, y):\n    # Check if the coordinates are within grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell contains any non-grabbable item that acts as an obstacle.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False  # Cell is blocked by an obstacle\n    return True\n\n  # Initialize Breadth-First Search (BFS)\n  # Queue stores tuples: (current_x, current_y, current_direction)\n  # Using a list and an index to efficiently simulate a queue.\n  queue = [(start_x, start_y, start_dir)]\n  queue_idx = 0\n\n  # Parent map: {(x, y, dir): ((parent_x, parent_y, parent_dir), action_to_reach_this_state)}\n  # This map stores the immediate parent state and the action taken from that parent\n  # to reach the current state, enabling path reconstruction.\n  parent_map = {}\n\n  # Set to keep track of visited states (position and direction) to avoid cycles and redundant paths.\n  visited = set([(start_x, start_y, start_dir)])\n\n  # Variable to store the state from which the 'USE' action can be taken\n  goal_reached_state = None\n\n  while queue_idx < len(queue):\n    curr_x, curr_y, curr_dir = queue[queue_idx]\n    queue_idx += 1  # Dequeue the current state\n\n    # Check if the primitive can be collected from the current state.\n    # The 'USE' action affects the cell directly in front of the agent.\n    faced_dx, faced_dy = DIR_VEC[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # If the cell in front is within bounds and contains the target primitive:\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Goal reached! Store this state and break BFS.\n      goal_reached_state = (curr_x, curr_y, curr_dir)\n      break\n\n    # Explore all possible movement actions from the current state.\n    # Each movement action also sets the agent's new facing direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new position after performing this action.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action]  # The agent's new facing direction\n\n      # If the next cell is walkable and this new (position, direction) state has not been visited yet:\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir))\n        # Store how we reached this new state for path reconstruction.\n        parent_map[(next_x, next_y, next_dir)] = ((curr_x, curr_y, curr_dir), action)\n\n  # If the BFS completes and no path to collect the primitive is found, return an empty list.\n  if goal_reached_state is None:\n    return []\n\n  # Path Reconstruction:\n  # Start with the final 'USE' action.\n  path = [ACTION_USE]\n  # Backtrack from the state from which the 'USE' action was performed.\n  current_path_state = goal_reached_state\n\n  # Reconstruct the path by traversing back through the parent_map until the start state is reached.\n  while current_path_state != (start_x, start_y, start_dir):\n    # Retrieve the parent state and the action taken from that parent to reach current_path_state.\n    parent_state, action_from_parent = parent_map[current_path_state]\n\n    # Prepend the action to the path list (since we are building it backwards).\n    path.insert(0, action_from_parent)\n\n    # Move to the parent state for the next iteration of backtracking.\n    current_path_state = parent_state\n\n  return path", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T06:28:06.218639", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  # When an agent performs a movement action, it also faces that direction.\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map agent's direction integer to its (dx, dy) vector (change in position)\n  # This vector indicates the cell directly in front of the agent.\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y-coordinate\n      1: (1, 0),   # RIGHT: increases x-coordinate\n      2: (0, 1),   # DOWN: increases y-coordinate\n      3: (-1, 0)   # LEFT: decreases x-coordinate\n  }\n\n  # Pre-check: If the primitive is not a grabbable item, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get the initial state details for the BFS starting point\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Identify indices of entities that block movement (non-grabbable items like water, workshops etc.)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to determine if a cell is traversable.\n  def is_walkable(x, y):\n    # Check if the coordinates are within grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell contains any non-grabbable item that acts as an obstacle.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False # Cell is blocked by an obstacle\n    return True\n\n  # Initialize Breadth-First Search (BFS)\n  # Queue stores tuples: (current_x, current_y, current_direction)\n  # Using a list and an index to efficiently simulate a queue (avoiding `collections.deque`\n  # as it's not a standard built-in and might require an import).\n  queue = [(start_x, start_y, start_dir)]\n  queue_idx = 0\n\n  # Set to keep track of visited states (position and direction) to avoid cycles and redundant paths.\n  visited = set([(start_x, start_y, start_dir)])\n\n  # Dictionary to reconstruct the path: maps (current_state) -> (parent_state, action_from_parent)\n  parent_info = {}\n\n  goal_state_pre_use = None # Stores the state right before the final 'USE' action\n\n  while queue_idx < len(queue):\n    curr_x, curr_y, curr_dir = queue[queue_idx]\n    queue_idx += 1 # Dequeue the current state\n\n    # Check if the primitive can be collected from the current state.\n    # The 'USE' action affects the cell directly in front of the agent.\n    faced_dx, faced_dy = DIR_VEC[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # If the cell in front is within bounds and contains the target primitive:\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Goal reached! Store this state and break BFS.\n      goal_state_pre_use = (curr_x, curr_y, curr_dir)\n      break\n\n    # Explore all possible movement actions from the current state.\n    # Each movement action also sets the agent's new facing direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new position after performing this action.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # The agent's new facing direction\n      next_state_tuple = (next_x, next_y, next_dir)\n\n      # If the next cell is walkable and this new (position, direction) state has not been visited yet:\n      if is_walkable(next_x, next_y) and next_state_tuple not in visited:\n        visited.add(next_state_tuple)\n        # Store parent information for path reconstruction.\n        parent_info[next_state_tuple] = ((curr_x, curr_y, curr_dir), action)\n        queue.append(next_state_tuple)\n\n  # If no path was found (goal_state_pre_use remains None), return an empty list.\n  if goal_state_pre_use is None:\n    return []\n\n  # Reconstruct the path by backtracking from the goal state.\n  actions = [ACTION_USE] # The final action is always 'USE'\n\n  current_state = goal_state_pre_use\n  start_state_tuple = (start_x, start_y, start_dir)\n\n  # Backtrack until we reach the starting state\n  while current_state != start_state_tuple:\n    # Get the parent state and the action taken to reach current_state from parent.\n    parent_state, action_from_parent = parent_info[current_state]\n    actions.append(action_from_parent)\n    current_state = parent_state\n\n  # The path was built in reverse order, so reverse it to get the correct sequence.\n  return actions[::-1]", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T06:29:04.880405", "function_name": "collect", "function_body": "    import collections # Required for deque\n    \n    # Action constants (from CraftLab action_specs)\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    state = env._current_state\n    \n    # Check if primitive is already in inventory\n    if state.inventory[primitive] > 0:\n        return []\n\n    start_pos = state.pos\n    grid = state.grid\n    world = state.world \n    \n    WIDTH, HEIGHT, _ = grid.shape\n    \n    queue = collections.deque([(start_pos, [])]) # (position, path_actions)\n    visited = {start_pos} # Set of visited (r, c) tuples\n\n    # Define possible moves and their corresponding actions\n    # (dr, dc) : action\n    moves = {\n        (-1, 0): UP,    # Move North\n        (1, 0): DOWN,   # Move South\n        (0, -1): LEFT,  # Move West\n        (0, 1): RIGHT,  # Move East\n    }\n\n    # Helper to check if a position is valid and traversable\n    def is_traversable(r, c):\n        # Check bounds\n        if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n            return False\n        \n        # Check if the cell contains any non-grabbable item, which acts as an obstacle\n        for k_idx in world.non_grabbable_indices:\n            if grid[r, c, k_idx] > 0:\n                return False \n        return True\n\n    # Find all locations of the primitive on the grid\n    primitive_locations = []\n    for r_grid in range(WIDTH):\n        for c_grid in range(HEIGHT):\n            if grid[r_grid, c_grid, primitive] > 0:\n                primitive_locations.append((r_grid, c_grid))\n\n    if not primitive_locations:\n        # Primitive not found anywhere on the map\n        return [] \n\n    # BFS to find the shortest path to a cell adjacent to the primitive\n    while queue:\n        current_pos, path_actions = queue.popleft()\n        r, c = current_pos\n\n        # Check if any primitive is in the 3x3 neighborhood of current_pos\n        # This logic mimics CraftState.next_to(primitive) and identifies a valid \"collection spot\".\n        found_adjacent_primitive = False\n        for pr, pc in primitive_locations:\n            if abs(r - pr) <= 1 and abs(c - pc) <= 1: # Checks 3x3 neighborhood including current cell\n                found_adjacent_primitive = True\n                break\n        \n        if found_adjacent_primitive:\n            # We found a path to a position where the primitive is adjacent.\n            # The next action from this position should be USE.\n            return path_actions + [USE]\n\n        # Explore neighbors\n        for (dr, dc), action in moves.items():\n            next_r, next_c = r + dr, c + dc\n            next_pos = (next_r, next_c)\n\n            if is_traversable(next_r, next_c) and next_pos not in visited:\n                visited.add(next_pos)\n                queue.append((next_pos, path_actions + [action]))\n\n    # No path found to a primitive\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T06:29:04.952961", "function_name": "collect", "function_body": "    action_map = env.action_specs()\n    # Invert the map to get action ID from action name (e.g., 'USE' -> 4)\n    action_ids = {name: id for name, id in action_map.items()}\n\n    USE_ACTION = action_ids['USE']\n    DOWN_ACTION = action_ids['DOWN']\n    UP_ACTION = action_ids['UP']\n    LEFT_ACTION = action_ids['LEFT']\n    RIGHT_ACTION = action_ids['RIGHT']\n\n    # Get initial state information from the environment's current observation\n    obs = env.observations()\n    initial_grid = obs['features_dict']['features_global']\n    # Agent's position is typically (row, col) or (y, x)\n    initial_pos = tuple(obs['features_dict']['pos'].astype(int))\n\n    # Get world configuration to identify non-grabbable (unwalkable) entities\n    world = env.scenario.world\n    non_grabbable_indices = world.non_grabbable_indices\n\n    grid_height, grid_width, n_kinds = initial_grid.shape\n\n    # Define movement deltas for (dy, dx) corresponding to actions\n    # Assuming (0,0) is top-left, y increases downwards, x increases rightwards.\n    move_deltas = {\n        DOWN_ACTION: (1, 0),\n        UP_ACTION: (-1, 0),\n        LEFT_ACTION: (0, -1),\n        RIGHT_ACTION: (0, 1),\n    }\n\n    # Queue for BFS: stores (current_position, path_to_current_position)\n    q = collections.deque([(initial_pos, [])])\n    # Set of visited positions to prevent cycles and redundant exploration\n    visited = {initial_pos}\n\n    # BFS to find the shortest path to a cell adjacent to the primitive\n    while q:\n        current_pos, current_path = q.popleft()\n        cy, cx = current_pos\n\n        # Check if the current position is adjacent to the target primitive\n        # We check the 3x3 neighborhood around the agent's current position\n        for dy_adj in [-1, 0, 1]:\n            for dx_adj in [-1, 0, 1]:\n                ny_adj, nx_adj = cy + dy_adj, cx + dx_adj\n\n                # Check if the adjacent cell is within grid bounds\n                if 0 <= ny_adj < grid_height and 0 <= nx_adj < grid_width:\n                    # If the adjacent cell contains the primitive\n                    if initial_grid[ny_adj, nx_adj, primitive] > 0:\n                        # Found a path to a cell adjacent to the primitive.\n                        # Add the USE action to the path and return it.\n                        return current_path + [USE_ACTION]\n\n        # Explore possible movement actions from the current position\n        for action, (dy, dx) in move_deltas.items():\n            next_y, next_x = cy + dy, cx + dx\n            next_pos = (next_y, next_x)\n\n            # Check if the next position is within grid bounds\n            if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                continue\n\n            # Check if the next position is walkable\n            # A cell is considered walkable if it does not contain any non-grabbable item.\n            # Agent can typically walk over empty cells or cells containing grabbable items.\n            is_walkable = True\n            for k_idx in non_grabbable_indices:\n                if initial_grid[next_y, next_x, k_idx] > 0:\n                    is_walkable = False\n                    break\n            if not is_walkable:\n                continue\n\n            # If the next position has not been visited, add it to the queue\n            if next_pos not in visited:\n                visited.add(next_pos)\n                q.append((next_pos, current_path + [action]))\n\n    # If the BFS completes and no path to an adjacent primitive is found, return an empty list.\n    return []", "island_id": 7, "scores": {"3": -1}}
