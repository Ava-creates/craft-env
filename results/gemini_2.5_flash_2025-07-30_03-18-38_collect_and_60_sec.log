{"timestamp": "2025-07-30T09:08:50.156025", "function_name": "collect", "function_body": "  import collections\n\n  # --- Action Constants (assuming these are globally defined or available in scope) ---\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement action to the direction the agent faces after the move.\n  # Directions are typically: 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n  ACTION_TO_FACING_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Mapping of facing direction to (dx, dy) vector for position change.\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y\n      1: (1, 0),   # RIGHT: increases x\n      2: (0, 1),   # DOWN: increases y\n      3: (-1, 0)   # LEFT: decreases x\n  }\n\n  # List of actions that cause movement.\n  MOVE_ACTIONS = [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]\n\n  # --- Pre-checks ---\n  # If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # --- Initial State Extraction ---\n  current_state = env._current_state\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = current_state.grid # The current grid layout\n  grid_width, grid_height, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # --- Helper Function for BFS ---\n  def is_walkable(x, y):\n    \"\"\"\n    Checks if a given grid cell (x, y) is within bounds and not occupied by\n    any entity defined as a non-grabbable obstacle.\n    \"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    \n    # Check if the cell contains any non-grabbable item (which acts as an obstacle).\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False # Cell is blocked by an obstacle.\n    return True\n\n  # --- 1. Pre-compute all (agent_x, agent_y, agent_direction) states from which\n  #        the primitive can be collected with a single ACTION_USE.\n  #    A state (ax, ay, adir) is \"collectable\" if:\n  #       - The agent at (ax, ay) is on a walkable cell.\n  #       - The agent, when facing `adir`, is pointing directly to a cell (px, py)\n  #         that contains the primitive. (This is how CraftState's ACTION_USE works).\n  collectable_states = set()\n\n  # Iterate through all cells in the grid to find instances of the primitive\n  for px in range(grid_width):\n    for py in range(grid_height):\n      if grid[px, py, primitive] == 1: # Found an instance of the primitive at (px, py)\n        # Now, find all *agent positions* (ax, ay) and *agent directions* (adir)\n        # such that the agent at (ax, ay) facing `adir` would point to (px, py).\n        \n        # Iterate over all possible agent facing directions (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n        for adir, (dx, dy) in DIR_VEC.items():\n          # If agent is at (ax, ay) and faces (dx, dy), then (ax+dx, ay+dy) is (px, py).\n          # So, the agent's required position (ax, ay) must be (px-dx, py-dy).\n          ax, ay = px - dx, py - dy\n\n          # If the agent's required position is walkable, then this (ax, ay, adir)\n          # is a valid \"collectable state\" for the agent.\n          if is_walkable(ax, ay):\n            collectable_states.add((ax, ay, adir))\n  \n  # If, after pre-computation, no valid collectable states are found (e.g., primitive doesn't exist\n  # or is in an unreachable/unfaceable spot), return an empty path.\n  if not collectable_states:\n      return []\n\n  # --- 2. Breadth-First Search (BFS) to find the shortest path to a collectable state.\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n  # `current_direction` is the direction the agent is facing *after* arriving at (current_x, current_y).\n  bfs_queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to avoid redundant exploration and cycles.\n  # A state is defined by (x, y, direction) because the agent's direction matters\n  # for the ACTION_USE interaction.\n  visited_states = set([(start_x, start_y, start_dir)])\n\n  while bfs_queue:\n    curr_x, curr_y, curr_dir, path_actions = bfs_queue.popleft()\n\n    # Goal check: If the current (position, direction) state is one from which\n    # the primitive can be directly collected, we've found the shortest path.\n    if (curr_x, curr_y, curr_dir) in collectable_states:\n      return path_actions + [ACTION_USE]\n    \n    # Explore possible next movement actions (UP, RIGHT, DOWN, LEFT)\n    for action in MOVE_ACTIONS:\n      # Determine the new position and direction after taking this action.\n      # The movement vector (dx, dy) corresponds to the direction integer of the action.\n      next_dir = ACTION_TO_FACING_DIR[action] # Agent faces the direction of its last movement\n      move_dx, move_dy = DIR_VEC[next_dir]\n      \n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n\n      # If the next cell is walkable and this (position, direction) state hasn't been visited\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited_states:\n        visited_states.add((next_x, next_y, next_dir))\n        bfs_queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T09:10:06.749235", "function_name": "collect", "function_body": "    import collections\n    \n    # Action mappings for CraftLab as specified in the problem description\n    ACTION_MAP = {'DOWN': 0, 'UP': 1, 'LEFT': 2, 'RIGHT': 3, 'USE': 4}\n\n    # Movement deltas for (dx, dy) corresponding to absolute grid movements.\n    # Assuming (0,0) is top-left, x increases right, y increases down.\n    MOVE_DELTAS = {\n        ACTION_MAP['UP']: (0, -1),   # Move up (decrease Y)\n        ACTION_MAP['DOWN']: (0, 1),  # Move down (increase Y)\n        ACTION_MAP['LEFT']: (-1, 0), # Move left (decrease X)\n        ACTION_MAP['RIGHT']: (1, 0), # Move right (increase X)\n    }\n\n    # Get current state information from the environment's internal state.\n    # CraftLab exposes _current_state which is a CraftState instance.\n    current_state = env._current_state \n    \n    grid = current_state.grid\n    inventory = current_state.inventory\n    pos = current_state.pos # Agent's current (x, y) position\n    world = current_state.world # This is a CraftWorld instance\n\n    # 1. Check if the primitive is already collected.\n    # If the primitive is already in the inventory, no actions are needed.\n    if inventory[primitive] > 0:\n        return []\n\n    WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n    n_kinds = grid.shape[2] # Total number of entity kinds\n\n    # 2. Identify obstacles for movement.\n    # Obstacles are entities that cannot be walked upon.\n    # CraftWorld.non_grabbable_indices holds indices of such entities.\n    # We assume that the `primitive` itself (the item to be collected) is grabbable,\n    # and therefore a cell containing *only* the primitive is traversable.\n    # If a cell contains any `non_grabbable_indices` item, it's considered an obstacle,\n    # regardless of whether it also contains the primitive.\n    obstacle_kinds_for_movement = world.non_grabbable_indices\n\n    # 3. Find all locations of the primitive on the grid.\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            # Check if the primitive is present at this grid cell.\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return [] # Primitive not found anywhere on the grid.\n\n    # 4. Find the shortest path to any primitive location using Breadth-First Search (BFS).\n    # BFS is used to find the shortest path in an unweighted graph (grid).\n    q = collections.deque([(pos, [])]) # Queue stores (current_pos: (x,y), path_actions_so_far: list[int])\n    visited = {pos} # Set of (x,y) tuples to keep track of visited cells.\n\n    best_path_actions = None # To store the shortest sequence of actions found.\n    \n    # Convert list of primitive locations to a set for faster lookup during BFS.\n    primitive_locations_set = set(primitive_locations)\n\n    while q:\n        (cx, cy), current_actions = q.popleft()\n\n        # Check if the current position is one of the target primitive locations.\n        if (cx, cy) in primitive_locations_set:\n            best_path_actions = current_actions # Found the shortest path to *a* primitive.\n            break # Stop BFS as we found the shortest path.\n\n        # Explore neighboring cells.\n        for action, (dx, dy) in MOVE_DELTAS.items():\n            nx, ny = cx + dx, cy + dy\n\n            # Check if the new position is within grid boundaries.\n            if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n                continue\n\n            # Check if the new position has already been visited.\n            if (nx, ny) in visited:\n                continue\n\n            # Check if the new cell is an obstacle (contains any non-grabbable item).\n            is_obstacle = False\n            for k_idx in obstacle_kinds_for_movement:\n                if grid[nx, ny, k_idx] > 0: # If this obstacle kind is present in the cell.\n                    is_obstacle = True\n                    break\n            \n            # If the cell is not an obstacle, add it to the queue.\n            if not is_obstacle:\n                visited.add((nx, ny))\n                q.append(((nx, ny), current_actions + [action]))\n    \n    # 5. If a path was found, append the 'USE' action to collect the primitive.\n    if best_path_actions is not None:\n        # The 'USE' action is assumed to be taken once the agent is on the same cell as the primitive.\n        # This is consistent with `CraftState.next_to` including the agent's current cell in the 3x3 neighborhood.\n        return best_path_actions + [ACTION_MAP['USE']]\n    else:\n        # No path found to any primitive location (e.g., all paths are blocked).\n        return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:10:07.752565", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants as defined in CraftLab's action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Ensure the environment is in a known initial state\n  # Calling reset() also initializes env._current_state\n  env.reset()\n  initial_state = env._current_state\n\n  # 1. Check if the primitive is already in the inventory\n  if initial_state.inventory[primitive] > 0:\n    return []  # Already collected, no actions needed\n\n  # BFS data structures\n  # Queue stores tuples of (current_CraftState_instance, list_of_actions_to_reach_this_state)\n  queue = collections.deque([(initial_state, [])])\n\n  # Visited set stores tuples of (pos_x, pos_y, dir).\n  # We only care about position and direction for visited states during movement,\n  # as inventory changes only upon successful collection of the target primitive.\n  visited = set([(initial_state.pos[0], initial_state.pos[1], initial_state.dir)])\n\n  while queue:\n    current_state, current_path = queue.popleft()\n\n    # Check if the primitive is in the agent's 3x3 neighborhood.\n    # If it is, attempt to use the USE action to collect it.\n    if current_state.next_to(primitive):\n      # Simulate the USE action. CraftState.step returns reward and a new state.\n      _reward, state_after_use = current_state.step(USE)\n      \n      # If the USE action successfully collected the primitive (its count > 0 in inventory)\n      if state_after_use.inventory[primitive] > 0:\n        return current_path + [USE]\n\n    # Explore possible movement actions (DOWN, UP, LEFT, RIGHT)\n    # The USE action is handled separately above, as it's a goal-specific action.\n    for action in [DOWN, UP, LEFT, RIGHT]:\n      # Simulate the action to get the next state without modifying current_state.\n      # CraftState.step returns a *new* CraftState instance.\n      _reward, next_state = current_state.step(action)\n\n      next_pos_x, next_pos_y = next_state.pos\n      next_dir = next_state.dir\n      next_key = (next_pos_x, next_pos_y, next_dir)\n\n      # Only add to queue if this state (position and direction) hasn't been visited\n      if next_key not in visited:\n        visited.add(next_key)\n        queue.append((next_state, current_path + [action]))\n\n  # If the queue is empty and the primitive has not been collected,\n  # it means it's unreachable or uncollectable in the current scenario.\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:11:33.188834", "function_name": "collect", "function_body": "  # Action constants (from problem description context)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVES = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # Helper to check if a position is a valid collection point for the primitive\n  def _is_valid_collection_point(agent_pos, primitive_idx, grid):\n      \"\"\"\n      Checks if `agent_pos` is a valid position to interact with `primitive_idx`.\n      This means `primitive_idx` must be present in the 3x3 neighborhood of `agent_pos`.\n      \"\"\"\n      W, H, _ = grid.shape\n      ax, ay = agent_pos\n\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              # Iterate through the 3x3 neighborhood (including the agent's own cell)\n              nx, ny = ax + dx, ay + dy\n\n              # Check bounds\n              if 0 <= nx < W and 0 <= ny < H:\n                  # If the primitive is found in any cell of the neighborhood\n                  if grid[nx, ny, primitive_idx] > 0:\n                      return True\n      return False\n\n  actions = []\n  \n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  # Ensure position is int tuple. CraftState.pos is tuple(int, int)\n  # obs['features_dict']['pos'] is a numpy array, convert to tuple for hashing in sets/dicts.\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  world = env.world\n  # non_grabbable_indices typically include obstacles like water, stone walls, workshops.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  # The agent cannot step onto cells that contain items from non_grabbable_indices.\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for x in range(W):\n      for y in range(H):\n          # A cell is NOT traversable if it contains any non-grabbable item.\n          if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n              traversable_mask[x, y] = False\n  \n  # Verify that the agent's current position is traversable.\n  # This should typically be true in a valid CraftWorld scenario.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] \n\n  # 2. Perform BFS to find the shortest path to any *collection point* for the primitive.\n  # A collection point is a traversable cell from which the primitive can be collected\n  # (i.e., the primitive is in its 3x3 neighborhood, including the agent's current cell).\n  \n  q = deque([current_pos]) # Queue for BFS, stores (x, y) positions\n  visited = {current_pos} # Set of visited positions to prevent cycles and redundant work\n  parent = {} # Dictionary to reconstruct path: parent[child_pos] = (parent_pos, action_from_parent_to_child)\n  \n  found_collection_pos = None\n\n  while q:\n      curr_pos = q.popleft()\n      \n      # Check if the current position is a valid collection point for the target primitive.\n      if _is_valid_collection_point(curr_pos, primitive, grid):\n          found_collection_pos = curr_pos\n          break # Found the shortest path to a suitable collection location\n      \n      # Explore neighbors\n      for action, (dx, dy) in MOVES.items():\n          next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n          next_pos = (next_x, next_y)\n\n          # Check bounds, traversability, and if the cell has already been visited\n          if (0 <= next_x < W and 0 <= next_y < H and\n              traversable_mask[next_x, next_y] and\n              next_pos not in visited):\n              \n              visited.add(next_pos)\n              parent[next_pos] = (curr_pos, action) # Store how we reached next_pos\n              q.append(next_pos)\n  \n  # If no path was found (e.g., the primitive is unreachable or doesn't exist in a reachable area)\n  if found_collection_pos is None:\n      return [] \n  \n  # 3. Reconstruct the path from found_collection_pos back to current_pos\n  path_actions = []\n  node = found_collection_pos\n  # Loop until we reach the starting position\n  while node != current_pos:\n      prev_node, action_to_reach_node = parent[node]\n      path_actions.append(action_to_reach_node)\n      node = prev_node\n  \n  path_actions.reverse() # Reverse the list to get actions from start to target\n  \n  # 4. Append the USE action after the movement path.\n  actions.extend(path_actions)\n  actions.append(USE)\n  \n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T09:11:34.162899", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Constants for actions and directions (assuming they are globally defined or accessible)\n  # DOWN = 0\n  # UP = 1\n  # LEFT = 2\n  # RIGHT = 3\n  # USE = 4\n\n  # Map agent direction (0:EAST, 1:SOUTH, 2:WEST, 3:NORTH) to (dx, dy)\n  # This represents the (dx, dy) of the cell *in front* of the agent.\n  DIR_TO_DELTA = {\n      0: (1, 0),   # EAST: (dx=1, dy=0)\n      1: (0, 1),   # SOUTH: (dx=0, dy=1)\n      2: (-1, 0),  # WEST: (dx=-1, dy=0)\n      3: (0, -1)   # NORTH: (dx=0, dy=-1)\n  }\n\n  # Map movement actions to their (dx, dy) effect on agent position\n  MOVE_ACTION_TO_DELTA = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  current_pos_raw = obs['features_dict']['pos']\n  current_pos = (int(current_pos_raw[0]), int(current_pos_raw[1]))\n  current_dir_onehot = obs['features_dict']['direction']\n  # Convert one-hot direction [0,0,1,0] -> 2 (WEST)\n  current_dir = np.where(current_dir_onehot == 1)[0][0] \n\n  world = env.world\n  # non_grabbable_indices typically include obstacles like water, stone walls, workshops.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape # Grid dimensions\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for x in range(W):\n      for y in range(H):\n          # A cell is NOT traversable if it contains any non-grabbable item (obstacle).\n          if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n              traversable_mask[x, y] = False\n  \n  # Check if agent's initial position is traversable.\n  # This should always be true for valid states.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] # Agent starts on an untraversable cell, no path possible.\n\n  # BFS Initialization\n  # Queue stores tuples: (x_position, y_position, current_direction, list_of_actions_taken_to_reach_this_state)\n  q = deque([(current_pos[0], current_pos[1], current_dir, [])]) \n  \n  # Visited set stores (x, y, direction) tuples to avoid re-exploring states and infinite loops.\n  visited = {(current_pos[0], current_pos[1], current_dir)}\n  \n  while q:\n      curr_x, curr_y, curr_dir, current_path = q.popleft()\n\n      # Check if the current (x, y, dir) state is a goal state\n      # A goal state means the agent is at (curr_x, curr_y) facing curr_dir,\n      # and the cell directly in front of it contains the target primitive.\n      \n      # Calculate coordinates of the cell directly in front of the agent\n      fx, fy = curr_x + DIR_TO_DELTA[curr_dir][0], curr_y + DIR_TO_DELTA[curr_dir][1]\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive\n      if (0 <= fx < W and 0 <= fy < H and grid[fx, fy, primitive] > 0):\n          # If true, we have found the shortest path to a state from which we can USE the primitive.\n          return current_path + [USE] # Append the USE action and return the complete sequence.\n\n      # Explore neighbors by performing movement actions\n      for action_move, (dx, dy) in MOVE_ACTION_TO_DELTA.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          \n          # Check bounds and traversability for the potential next position\n          if (0 <= next_x < W and 0 <= next_y < H and traversable_mask[next_x, next_y]):\n              # The agent's direction does not change when it moves.\n              next_state_key = (next_x, next_y, curr_dir) \n              if next_state_key not in visited:\n                  visited.add(next_state_key)\n                  q.append((next_x, next_y, curr_dir, current_path + [action_move]))\n\n      # Explore neighbors by performing rotation actions (LEFT, RIGHT)\n      # These actions change the agent's direction but not its position.\n      \n      # Action LEFT (rotates counter-clockwise: 0->3, 1->0, 2->1, 3->2)\n      next_dir_left = (curr_dir - 1 + 4) % 4\n      next_state_key_left = (curr_x, curr_y, next_dir_left)\n      if next_state_key_left not in visited:\n          visited.add(next_state_key_left)\n          q.append((curr_x, curr_y, next_dir_left, current_path + [LEFT]))\n\n      # Action RIGHT (rotates clockwise: 0->1, 1->2, 2->3, 3->0)\n      next_dir_right = (curr_dir + 1) % 4\n      next_state_key_right = (curr_x, curr_y, next_dir_right)\n      if next_state_key_right not in visited:\n          visited.add(next_state_key_right)\n          q.append((curr_x, curr_y, next_dir_right, current_path + [RIGHT]))\n\n  # If the queue becomes empty and no path to a primitive was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:12:34.875355", "function_name": "collect", "function_body": "  import collections # Using collections.deque for efficient queue operations in BFS\n\n  # Re-defining constants for clarity within the function scope\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable\n  if primitive_idx not in env.world.grabbable_indices:\n    return [] # Not grabbable, cannot collect via USE.\n\n  # 3. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 4. Retrieve grid dimensions and non-grabbable indices for boundary and impassable checks\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n  \n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    BFS state: (current_x, current_y, current_direction)\n  #    To improve memory efficiency over v1, we store path information in a separate dictionary\n  #    instead of copying action lists for each node in the queue.\n  \n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  # Queue for BFS: stores tuples of ((x, y), direction)\n  queue = collections.deque([(start_pos, start_dir)]) \n  \n  # Dictionary to reconstruct the path: \n  # Keys are ((x, y), direction) tuples representing a state.\n  # Values are (parent_state_tuple, action_taken_to_reach_current_state).\n  # The starting state's parent info is (None, None).\n  path_trace = {(start_pos, start_dir): (None, None)} \n\n  target_use_state = None # Will store the state from which the final USE action can be applied\n\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.popleft() # Dequeue the current state\n\n    # Check if a 'USE' action is possible from this current state.\n    # This involves looking at the cell directly in front of the agent.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # If the target cell is within bounds and contains the desired primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      # We've found a valid state from which the primitive can be collected.\n      target_use_state = ((curr_x, curr_y), curr_dir)\n      break # Path found, exit the BFS loop.\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # Moving changes both the agent's position and its facing direction.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to cardinal movements\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # The agent's new direction is the direction of movement\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position is impassable (contains any non-grabbable item).\n      # The agent cannot move into cells occupied by these items.\n      is_impassable = False\n      for k_idx in non_grabbable_indices:\n        if grid[next_x, next_y, k_idx] > 0: # If any non-grabbable item is present\n          is_impassable = True\n          break\n      if is_impassable:\n        continue # Skip this move if the destination is impassable\n      \n      # If this new state (position and direction) has not been visited yet during the BFS\n      if next_state_tuple not in path_trace: # path_trace acts as our visited set\n        # Store how we reached this new state\n        path_trace[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action)\n        queue.append(next_state_tuple) # Add the new state to the queue for further exploration\n\n  if target_use_state is None:\n    return [] # If the queue becomes empty and no path was found, the primitive is unreachable.\n\n  # Reconstruct the sequence of actions by backtracking from the `target_use_state`\n  # back to the `start_pos`/`start_dir` using the `path_trace` dictionary.\n  path_actions = []\n  current_reconstruction_state = target_use_state\n  \n  # Backtrack until we reach the starting state, which has (None, None) as its parent info\n  while path_trace[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = path_trace[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  # The path was built in reverse order (from target to start), so reverse it\n  path_actions.reverse()\n  \n  # Add the final 'USE' action to complete the collection sequence\n  return path_actions + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T09:12:35.860984", "function_name": "collect", "function_body": "  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name\n  # The index method will add the primitive to the cookbook's index if it doesn't already exist.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable\n  if primitive_idx not in env.world.grabbable_indices:\n    # This primitive cannot be picked up (e.g., water, stone if not grabbable),\n    # so \"collecting\" it via USE is not possible.\n    return []\n\n  # 3. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 4. Retrieve grid dimensions and non-grabbable indices for boundary and impassable checks\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n  \n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a position and orientation from which the primitive can be collected via USE.\n  # BFS state: ((current_x, current_y), current_direction)\n  # Using collections.deque for efficient queue operations in BFS\n  import collections\n  queue = collections.deque() \n  \n  # visited: {state_tuple: (parent_state_tuple, action_taken_to_reach_state)}\n  # Stores parent info for memory-efficient path reconstruction (improvement over v1).\n  visited = {} \n\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's initial direction (0-3)\n  \n  start_state_tuple = (start_pos, start_dir)\n  queue.append(start_state_tuple)\n  visited[start_state_tuple] = (None, None) # (parent_state, action_from_parent_to_current)\n\n  target_reached_state = None # To store the state from which USE can be applied\n\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.popleft() # Dequeue for BFS\n\n    # Calculate the coordinates of the cell directly in front of the agent,\n    # which is the target for the USE action.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # Check if the cell in front is within bounds and contains the primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      # Found a state where the agent can perform USE to collect the primitive.\n      target_reached_state = ((curr_x, curr_y), curr_dir)\n      break # Path found, exit BFS loop\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # A movement action changes the agent's position and its facing direction.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position is impassable (contains any non-grabbable item).\n      # Agent cannot move into cells occupied by non-grabbable items.\n      is_impassable = False\n      for k_idx in non_grabbable_indices:\n        if grid[next_x, next_y, k_idx] > 0:\n          is_impassable = True\n          break\n      if is_impassable:\n        continue\n      \n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet\n      if next_state_tuple not in visited:\n        visited[next_state_tuple] = (start_state_tuple, move_action) if current_reconstruction_state is None else (current_reconstruction_state, move_action)\n        visited[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action) # Store parent and action\n        queue.append(next_state_tuple)\n\n  if target_reached_state is None:\n    return [] # If the queue becomes empty and no path was found, it means the primitive is unreachable.\n\n  # Reconstruct the path by backtracking from the target_reached_state to the start_state\n  path_actions = []\n  current_reconstruction_state = target_reached_state\n  \n  # Loop until we reach the starting state, which has (None, None) as its parent info\n  while visited[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = visited[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  # The path was built in reverse order, so reverse it to get the correct sequence\n  path_actions.reverse()\n  \n  # Add the final USE action to the collected path\n  return path_actions + [USE_ACTION]", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:14:29.312533", "function_name": "collect", "function_body": "  import collections\n\n  # Define action IDs based on CraftLab's action_specs\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  obs = env.observations()\n  current_state_dict = obs['features_dict']\n  \n  grid = current_state_dict['features_global'] # (WIDTH, HEIGHT, n_kinds)\n  \n  # `pos` is normalized, convert to integer grid coordinates\n  normalized_pos = current_state_dict['pos'] \n  current_dir = np.argmax(current_state_dict['direction']) # 0=N, 1=E, 2=S, 3=W\n  \n  WIDTH, HEIGHT, _ = grid.shape\n  \n  # Denormalize position from [0, 1] range to [0, WIDTH-1] / [0, HEIGHT-1]\n  agent_x = int(round(normalized_pos[0] * (WIDTH - 1)))\n  agent_y = int(round(normalized_pos[1] * (HEIGHT - 1)))\n  \n  # Find the primitive's location on the grid\n  # np.where returns (row_indices, col_indices) if the array is 2D,\n  # but `grid` is (WIDTH, HEIGHT, n_kinds) where WIDTH is x-dim (cols), HEIGHT is y-dim (rows).\n  # So, `grid[x, y, k]` means `primitive_locations[0]` are x-coordinates and `primitive_locations[1]` are y-coordinates.\n  primitive_locations = np.where(grid[:, :, primitive] == 1)\n  \n  if len(primitive_locations[0]) == 0:\n    # Primitive not found anywhere on the grid\n    return []\n\n  # For simplicity, target the first instance found\n  target_x, target_y = primitive_locations[0][0], primitive_locations[1][0]\n\n  # Get obstacle indices from the environment's world/cookbook.\n  # These are entities that cannot be moved into (e.g., walls, water, workshops if not target).\n  obstacle_indices = env.world.cookbook.environment # set of int indices for non-grabbable entities\n\n  # BFS for pathfinding\n  q = collections.deque()\n  # State for BFS: (x_coordinate, y_coordinate, agent_direction, list_of_actions_taken)\n  start_node = (agent_x, agent_y, current_dir, [])\n  q.append(start_node)\n\n  # Visited set: (x, y, direction) to prevent cycles and redundant exploration\n  visited = set()\n  visited.add((agent_x, agent_y, current_dir))\n\n  # Define all possible \"goal\" states for BFS to enable a `USE` action\n  # To `USE` an item at (TX, TY), the agent must be adjacent to it and facing it.\n  # The four possible adjacent squares and the required facing direction:\n  # (TX, TY-1) facing South (dir 2)\n  # (TX, TY+1) facing North (dir 0)\n  # (TX-1, TY) facing East (dir 1)\n  # (TX+1, TY) facing West (dir 3)\n  goal_states_for_use = set()\n  goal_states_for_use.add((target_x, target_y - 1, 2)) \n  goal_states_for_use.add((target_x, target_y + 1, 0)) \n  goal_states_for_use.add((target_x - 1, target_y, 1)) \n  goal_states_for_use.add((target_x + 1, target_y, 3)) \n\n  # Define effects of movement actions on (dx, dy) and new_dir\n  # Assumed: Moving into a cardinal direction changes agent's facing direction to that cardinal direction.\n  action_effects = {\n      UP:   (0, -1, 0),  # Move North (decrease Y), face North (dir 0)\n      DOWN: (0, 1, 2),   # Move South (increase Y), face South (dir 2)\n      LEFT: (-1, 0, 3),  # Move West (decrease X), face West (dir 3)\n      RIGHT: (1, 0, 1)   # Move East (increase X), face East (dir 1)\n  }\n\n  MAX_BFS_NODES = 2000 # Safety limit to prevent excessively long searches\n\n  nodes_explored = 0\n  while q and nodes_explored < MAX_BFS_NODES:\n      curr_x, curr_y, curr_dir, path = q.popleft()\n      nodes_explored += 1\n\n      # Check if the current state satisfies any of the goal states for `USE`\n      if (curr_x, curr_y, curr_dir) in goal_states_for_use:\n          return path + [USE]\n\n      # Explore neighbor states by applying movement actions\n      for action, (dx_move, dy_move, new_dir_after_move) in action_effects.items():\n          new_x, new_y = curr_x + dx_move, curr_y + dy_move\n\n          # Check boundaries\n          if not (0 <= new_x < WIDTH and 0 <= new_y < HEIGHT):\n              continue\n\n          # Check if the new cell is blocked by an obstacle\n          is_blocked = False\n          for obstacle_idx in obstacle_indices:\n              if grid[new_x, new_y, obstacle_idx] == 1:\n                  is_blocked = True\n                  break\n          \n          # If the primitive itself is a non-grabbable entity (like a workshop),\n          # we cannot move onto it. This is handled by `obstacle_indices`.\n          # If the target is at (new_x, new_y) and it's an obstacle, we skip moving onto it.\n          # The BFS is looking for an adjacent path to USE it.\n          if is_blocked:\n              continue\n\n          next_state = (new_x, new_y, new_dir_after_move)\n          if next_state not in visited:\n              visited.add(next_state)\n              q.append((new_x, new_y, new_dir_after_move, path + [action]))\n  \n  # If BFS completes without finding a path to the primitive\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:14:29.381642", "function_name": "collect", "function_body": "    import collections\n\n    # Define action constants based on CraftLab.action_specs()\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Get the current state information from the environment.\n    # We access the internal `_current_state` attribute of CraftLab for efficiency\n    # and direct access to grid, position, direction, and inventory.\n    current_state = env._current_state\n    current_grid = current_state.grid\n    current_pos = current_state.pos  # tuple (row, col)\n    current_dir = current_state.dir  # int (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT)\n    current_inventory = current_state.inventory\n\n    # 1. Check if the primitive is already in the inventory\n    if current_inventory[primitive] > 0:\n        return []\n\n    H, W, K = current_grid.shape\n\n    # BFS queue: stores tuples of (row, col, facing_direction, list_of_actions_taken)\n    q = collections.deque()\n    q.append((current_pos[0], current_pos[1], current_dir, []))\n\n    # Visited set: stores (row, col, facing_direction) to avoid redundant computations and cycles\n    visited = set()\n    visited.add((current_pos[0], current_pos[1], current_dir))\n\n    # Mapping of movement actions to their (row_delta, col_delta) and the resulting facing direction.\n    # We assume that taking a movement action also makes the agent face that direction.\n    # Direction mapping: 0:DOWN (South), 1:UP (North), 2:LEFT (West), 3:RIGHT (East)\n    move_action_map = {\n        ACTION_UP: ((-1, 0), 1),    # Move North, face North\n        ACTION_DOWN: ((1, 0), 0),   # Move South, face South\n        ACTION_LEFT: ((0, -1), 2),  # Move West, face West\n        ACTION_RIGHT: ((0, 1), 3),  # Move East, face East\n    }\n\n    # Mapping of facing direction to the (row_delta, col_delta) of the cell *in front* of the agent.\n    # This is used to determine which cell the USE_ACTION would apply to.\n    facing_delta_map = {\n        0: (1, 0),   # Facing DOWN (South), target is (r+1, c)\n        1: (-1, 0),  # Facing UP (North), target is (r-1, c)\n        2: (0, -1),  # Facing LEFT (West), target is (r, c-1)\n        3: (0, 1),   # Facing RIGHT (East), target is (r, c+1)\n    }\n\n    # Get non-grabbable item indices from the world's cookbook to identify impassable cells.\n    non_grabbable_indices = env.world.cookbook.non_grabbable_indices\n\n    while q:\n        r, c, d, path = q.popleft()\n\n        # 2. Check if the primitive is in the cell currently in front of the agent.\n        # If so, we can perform the ACTION_USE.\n        dr_face, dc_face = facing_delta_map[d]\n        target_r, target_c = r + dr_face, c + dc_face\n\n        # Ensure target cell is within grid boundaries\n        if 0 <= target_r < H and 0 <= target_c < W:\n            # Check if the target cell contains the desired primitive\n            if current_grid[target_r, target_c, primitive] > 0:\n                # Found the primitive! Return the path taken plus the USE action.\n                return path + [ACTION_USE]\n\n        # 3. Explore all possible movement actions from the current state (r, c, d).\n        for action, ((dr_move, dc_move), new_dir) in move_action_map.items():\n            next_r, next_c = r + dr_move, c + dc_move\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= next_r < H and 0 <= next_c < W):\n                continue\n\n            # Check if the new position is blocked by any non-grabbable item\n            is_blocked = False\n            for k_idx in non_grabbable_indices:\n                if current_grid[next_r, next_c, k_idx] > 0:\n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue\n\n            # If the new state (position and direction) has not been visited, add it to the queue\n            if (next_r, next_c, new_dir) not in visited:\n                visited.add((next_r, next_c, new_dir))\n                q.append((next_r, next_c, new_dir, path + [action]))\n\n    # If the BFS completes and the primitive was not found/reachable, return an empty list.\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:16:12.550551", "function_name": "collect", "function_body": "    # Constants for CraftLab actions (often defined in env_factory)\n    CRAFT_ACTION_DOWN = 0\n    CRAFT_ACTION_UP = 1\n    CRAFT_ACTION_LEFT = 2\n    CRAFT_ACTION_RIGHT = 3\n    CRAFT_ACTION_USE = 4\n\n    # Direction mappings (agent facing North=0, East=1, South=2, West=3)\n    # Delta (dx, dy) for moving using each action\n    ACTION_TO_DELTAS = {\n        CRAFT_ACTION_UP: (0, -1),\n        CRAFT_ACTION_DOWN: (0, 1),\n        CRAFT_ACTION_LEFT: (-1, 0),\n        CRAFT_ACTION_RIGHT: (1, 0),\n    }\n\n    # New direction agent faces after taking a movement action\n    # (Assuming moving in a direction makes the agent face that direction)\n    ACTION_TO_NEW_DIR = {\n        CRAFT_ACTION_UP: 0,    # North (0, -1)\n        CRAFT_ACTION_RIGHT: 1, # East (1, 0)\n        CRAFT_ACTION_DOWN: 2,  # South (0, 1)\n        CRAFT_ACTION_LEFT: 3,  # West (-1, 0)\n    }\n\n    # Relative position (dx, dy) of target to agent -> required direction agent must face\n    RELATIVE_POS_TO_DIRECTION = {\n        (0, -1): 0,  # North\n        (1, 0): 1,   # East\n        (0, 1): 2,   # South\n        (-1, 0): 3,  # West\n    }\n\n    # Get initial observations from the environment\n    obs = env.observations()\n\n    # Extract current agent state\n    initial_grid = obs['features_dict']['features_global']\n    initial_pos = tuple(obs['features_dict']['pos'])\n    initial_dir = np.argmax(obs['features_dict']['direction']) # Initial facing direction\n    initial_inventory = obs['features_dict']['inventory']\n\n    # If the primitive is already in inventory, no actions needed\n    if initial_inventory[primitive] > 0:\n        return []\n\n    # Environment parameters\n    grid_width, grid_height, num_kinds = initial_grid.shape\n    # Get indices of entities that are considered non-passable (e.g., walls, water)\n    non_passable_kinds = env.world.cookbook.environment \n\n    # Find all coordinates where the primitive exists on the grid\n    target_coords = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if initial_grid[x, y, primitive] > 0:\n                target_coords.append((x, y))\n\n    # If the primitive is not found anywhere on the map, return empty list\n    if not target_coords:\n        return []\n\n    # Convert target coordinates to a set for faster lookup\n    target_cells_set = set(target_coords)\n\n    def is_passable(x, y, grid, non_passable_kinds_set, width, height):\n        \"\"\"Checks if a cell is within grid bounds and does not contain non-passable kinds.\"\"\"\n        if not (0 <= x < width and 0 <= y < height):\n            return False\n        # A cell is passable if it does not contain any of the non_passable_kinds\n        for k in non_passable_kinds_set:\n            if grid[x, y, k] > 0:\n                return False\n        return True\n\n    # BFS Initialization\n    # Queue stores tuples: (current_x, current_y, current_direction, path_actions)\n    # current_direction is the direction the agent faces *after* arriving at (current_x, current_y)\n    queue = collections.deque([(initial_pos[0], initial_pos[1], initial_dir, [])])\n    \n    # Visited set stores (x, y) coordinates to avoid revisiting positions and ensure shortest path.\n    # Direction is not needed in visited set because we assume movement dictates facing (Hypothesis 1),\n    # so reaching (x,y) from any direction ultimately leads to the same facing upon arrival.\n    visited = set([(initial_pos[0], initial_pos[1])])\n\n    while queue:\n        cx, cy, c_dir, c_path = queue.popleft()\n\n        # Check if the current position (cx, cy) is adjacent to any target primitive\n        # and if the agent is facing it correctly to use.\n        for dx_adj, dy_adj in [(0, -1), (0, 1), (-1, 0), (1, 0)]: # Check N, S, W, E neighbors\n            tx, ty = cx + dx_adj, cy + dy_adj # Coordinates of the potential target cell\n\n            if (tx, ty) in target_cells_set:\n                # Calculate the direction the agent needs to face to use this target\n                # dx_rel, dy_rel is the vector from agent's current position to target\n                dx_rel, dy_rel = dx_adj, dy_adj\n                required_dir_to_face_target = RELATIVE_POS_TO_DIRECTION[(dx_rel, dy_rel)]\n\n                if c_dir == required_dir_to_face_target:\n                    # Agent is at (cx, cy) and already facing the target (tx, ty)\n                    final_actions = list(c_path) # Make a copy of the path\n                    final_actions.append(CRAFT_ACTION_USE) # Add the USE action\n                    return final_actions\n\n        # Explore next possible moves (movement actions)\n        for action, (dx_move, dy_move) in ACTION_TO_DELTAS.items():\n            nx, ny = cx + dx_move, cy + dy_move # New coordinates after movement\n            next_dir = ACTION_TO_NEW_DIR[action] # New direction after taking this move action\n\n            # Check if the next cell is passable and has not been visited yet\n            if is_passable(nx, ny, initial_grid, non_passable_kinds, grid_width, grid_height) and \\\n               (nx, ny) not in visited:\n                visited.add((nx, ny))\n                # Add the new state to the queue with the updated path and direction\n                queue.append((nx, ny, next_dir, c_path + [action]))\n\n    # If the BFS completes without finding a path to collect the primitive,\n    # it means the primitive is unreachable or not present.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T09:16:12.621180", "function_name": "collect", "function_body": "    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Access current state via the CraftLab instance's _current_state attribute\n    current_state = env._current_state\n    current_pos = current_state.pos # Agent's current (x, y) position\n    grid = current_state.grid       # The current grid, shape (WIDTH, HEIGHT, n_kinds)\n    \n    WIDTH, HEIGHT, _ = grid.shape # Unpack grid dimensions\n\n    # Get indices of non-grabbable (impassable) entities from the world configuration\n    non_grabbable_kinds = env.world.non_grabbable_indices\n\n    # BFS setup\n    # The queue stores tuples of ((x, y), list_of_actions_to_reach_here)\n    # Using a list as a queue (pop(0) for deque-like behavior, less efficient for large queues but fine for typical grid sizes)\n    queue = [(current_pos, [])]\n    # The visited set stores (x, y) tuples to prevent revisiting cells and cycles\n    visited = {current_pos}\n\n    # Define movement deltas (dx, dy) for (x, y) coordinates and their corresponding actions\n    # (dx, dy) -> action\n    # Assuming (x, y) where x is the column index (horizontal) and y is the row index (vertical)\n    DELTAS = {\n        (0, 1): ACTION_DOWN,   # x stays, y increases (move down)\n        (0, -1): ACTION_UP,    # x stays, y decreases (move up)\n        (-1, 0): ACTION_LEFT,  # x decreases, y stays (move left)\n        (1, 0): ACTION_RIGHT,  # x increases, y stays (move right)\n    }\n\n    final_actions = []\n\n    # BFS loop to find the shortest path to a position from which the primitive can be collected\n    while queue:\n        (x, y), path = queue.pop(0) # Get current position and the path taken to reach it\n\n        # Check if the primitive is directly at the current position (x, y)\n        if grid[x, y, primitive] == 1:\n            final_actions = path + [ACTION_USE]\n            break # Path to primitive found, exit BFS\n\n        # Check if any cell in the 3x3 neighborhood around (x, y) contains the primitive.\n        # This assumes that a 'USE' action can collect items in the immediate vicinity\n        # (current cell or adjacent cells), which is common in grid worlds without explicit\n        # \"turn\" actions to face a specific direction.\n        found_adjacent_primitive = False\n        for dx_adj in [-1, 0, 1]:\n            for dy_adj in [-1, 0, 1]:\n                # Skip the current cell itself, as it was checked explicitly above\n                if dx_adj == 0 and dy_adj == 0:\n                    continue \n\n                nx_adj, ny_adj = x + dx_adj, y + dy_adj\n\n                # Check bounds for the neighboring cell\n                if 0 <= nx_adj < WIDTH and 0 <= ny_adj < HEIGHT:\n                    if grid[nx_adj, ny_adj, primitive] == 1:\n                        final_actions = path + [ACTION_USE]\n                        found_adjacent_primitive = True\n                        break # Primitive found in adjacent cell\n            if found_adjacent_primitive:\n                break\n        if found_adjacent_primitive:\n            break # Exit BFS if an adjacent primitive was found\n\n        # Explore valid neighboring cells for movement\n        for (dx, dy), action in DELTAS.items():\n            nx, ny = x + dx, y + dy # Calculate new position\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n                continue\n\n            # Check if the new position has already been visited\n            if (nx, ny) in visited:\n                continue\n\n            # Check if the new position is blocked by impassable terrain\n            is_blocked = False\n            for kind_idx in non_grabbable_kinds:\n                if grid[nx, ny, kind_idx] == 1: # If this kind exists at (nx, ny), it's blocked\n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue\n\n            # If the new position is valid, unvisited, and not blocked, add it to the queue\n            # and mark it as visited for future checks\n            visited.add((nx, ny))\n            queue.append(((nx, ny), path + [action]))\n            \n    return final_actions", "island_id": 8, "scores": {"3": -1}}
