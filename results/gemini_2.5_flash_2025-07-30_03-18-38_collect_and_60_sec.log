{"timestamp": "2025-07-30T05:05:37.451635", "function_name": "collect", "function_body": "    current_state = env._current_state\n\n    # 1. Check if the primitive is already in the inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    start_pos = current_state.pos\n    height, width, n_kinds = grid.shape\n\n    # Get action mappings from the environment's action_specs\n    action_map = env.action_specs()\n    USE_ACTION = action_map['USE']\n\n    # Define movement deltas for BFS exploration based on action values\n    movement_actions_deltas = {}\n    for action_name, action_val in action_map.items():\n        if action_name == 'UP':\n            movement_actions_deltas[action_val] = (-1, 0)\n        elif action_name == 'DOWN':\n            movement_actions_deltas[action_val] = (1, 0)\n        elif action_name == 'LEFT':\n            movement_actions_deltas[action_val] = (0, -1)\n        elif action_name == 'RIGHT':\n            movement_actions_deltas[action_val] = (0, 1)\n\n    # Identify impassable elements using indices from CraftWorld\n    # These are typically 'water' and 'stone'\n    impassable_indices = {env.world.water_index, env.world.stone_index}\n\n    # Initialize BFS queue: stores tuples of (row, col, actions_list_to_reach_this_state)\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    # Initialize set of visited positions to avoid redundant exploration and cycles\n    visited = set([(start_pos[0], start_pos[1])])\n\n    # A reasonable maximum path length to prevent excessively long searches\n    # for very large maps or unreachable items, acting as a safeguard.\n    MAX_PATH_LENGTH = 200\n\n    while queue:\n        r, c, path = queue.popleft()\n\n        # Check if the current position (r, c) is adjacent to the primitive.\n        # This simulates CraftState.next_to(primitive) by checking the 3x3 neighborhood.\n        is_adjacent_to_primitive = False\n        for dr_adj in [-1, 0, 1]:\n            for dc_adj in [-1, 0, 1]:\n                nr_adj, nc_adj = r + dr_adj, c + dc_adj\n                # Ensure the neighborhood cell is within grid bounds\n                if 0 <= nr_adj < height and 0 <= nc_adj < width:\n                    # If the primitive kind exists at this neighborhood cell (count > 0)\n                    if grid[nr_adj, nc_adj, primitive] > 0:\n                        is_adjacent_to_primitive = True\n                        break\n            if is_adjacent_to_primitive:\n                break\n\n        if is_adjacent_to_primitive:\n            # If we've reached a position from which the primitive can be collected,\n            # append the USE action and return the complete path.\n            return path + [USE_ACTION]\n\n        # Prune paths that exceed the maximum allowed length to control search complexity\n        if len(path) >= MAX_PATH_LENGTH:\n            continue # Do not explore further from this path\n\n        # Explore possible next states by applying movement actions\n        for action_val, (dr, dc) in movement_actions_deltas.items():\n            nr, nc = r + dr, c + dc # Calculate the new position\n\n            # Check if the new position is within the grid boundaries\n            if not (0 <= nr < height and 0 <= nc < width):\n                continue\n\n            # Check traversability: The new cell must not contain impassable objects\n            is_impassable = False\n            for k_idx in impassable_indices:\n                if grid[nr, nc, k_idx] > 0: # If an impassable item exists at this cell\n                    is_impassable = True\n                    break\n            if is_impassable:\n                continue\n\n            # If the new position has not been visited, add it to the queue\n            if (nr, nc) not in visited:\n                visited.add((nr, nc))\n                queue.append((nr, nc, path + [action_val]))\n\n    # If the BFS completes and no path to the primitive is found (e.g., unreachable or not on map)\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:07:04.101538", "function_name": "collect", "function_body": "    # Get current state information from the environment\n    obs = env.observations()\n    \n    # 0. Early Exit: If primitive already collected, no actions needed.\n    # Access inventory from observations dict as per CraftLab.observations()\n    if obs['inventory'][primitive] > 0:\n        return []\n\n    grid = obs['features_dict']['features_global']\n    current_pos = tuple(obs['features_dict']['pos'].astype(int))\n    direction_one_hot = obs['features_dict']['direction']\n    initial_dir_id = np.argmax(direction_one_hot)\n\n    world = env.world\n    # non_grabbable_indices typically include obstacles like water, stone walls, workshops.\n    non_grabbable_indices = world.non_grabbable_indices\n    \n    W, H, K = grid.shape\n\n    # Action constants (from problem description context: DOWN\u21920, UP\u21921, LEFT\u21922, RIGHT\u21923, USE\u21924)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Define mappings for direction-aware BFS.\n    # We assume a standard direction mapping for the agent's 'dir' attribute (0=North, 1=East, 2=South, 3=West).\n    # The agent's direction updates to face the direction of its last movement.\n    DIR_ID_TO_VEC = {\n        0: (0, -1),  # North (corresponds to moving UP)\n        1: (1, 0),   # East (corresponds to moving RIGHT)\n        2: (0, 1),   # South (corresponds to moving DOWN)\n        3: (-1, 0),  # West (corresponds to moving LEFT)\n    }\n\n    ACTION_TO_NEW_DIR_ID = {\n        UP: 0,     # Moving UP makes agent face North (dir_id 0)\n        RIGHT: 1,  # Moving RIGHT makes agent face East (dir_id 1)\n        DOWN: 2,   # Moving DOWN makes agent face South (dir_id 2)\n        LEFT: 3,   # Moving LEFT makes agent face West (dir_id 3)\n    }\n\n    # Movement deltas directly correspond to the direction the action causes the agent to face.\n    ACTION_TO_DELTAS = {\n        UP: DIR_ID_TO_VEC[ACTION_TO_NEW_DIR_ID[UP]],\n        DOWN: DIR_ID_TO_VEC[ACTION_TO_NEW_DIR_ID[DOWN]],\n        LEFT: DIR_ID_TO_VEC[ACTION_TO_NEW_DIR_ID[LEFT]],\n        RIGHT: DIR_ID_TO_VEC[ACTION_TO_NEW_DIR_ID[RIGHT]],\n    }\n    \n    # 1. Determine traversable cells (cells without non-grabbable obstacles)\n    traversable_mask = np.ones((W, H), dtype=bool)\n    for x in range(W):\n        for y in range(H):\n            if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n                traversable_mask[x, y] = False\n    \n    # Ensure the agent's current position is marked as traversable.\n    # This should always be true for valid states.\n    if not traversable_mask[current_pos[0], current_pos[1]]:\n        return [] # Agent starts on an untraversable cell, no path possible.\n\n    # 2. Perform BFS to find the shortest path to a position/direction state\n    #    from which the primitive can be collected with a USE action.\n    # BFS state: (x, y, current_direction_id, path_actions_list)\n    # Using collections.deque for efficient popleft (assuming it's available or globally imported).\n    from collections import deque \n    q = deque([(current_pos[0], current_pos[1], initial_dir_id, [])])\n    \n    # Visited set stores (x, y, direction_id) tuples to avoid cycles and redundant exploration.\n    visited = {(current_pos[0], current_pos[1], initial_dir_id)}\n    \n    best_path_actions = []\n\n    while q:\n        curr_x, curr_y, curr_dir_id, actions_so_far = q.popleft()\n\n        # Check if the current (position, direction) state allows collecting the primitive.\n        # The USE action typically applies to the cell directly in front of the agent.\n        target_dx, target_dy = DIR_ID_TO_VEC[curr_dir_id]\n        target_x, target_y = curr_x + target_dx, curr_y + target_dy\n\n        # Check if the target cell (in front of agent) is within bounds and contains the primitive.\n        if (0 <= target_x < W and 0 <= target_y < H and\n            grid[target_x, target_y, primitive] > 0):\n            \n            best_path_actions = actions_so_far + [USE]\n            break # Found the shortest path to collect the primitive.\n\n        # Explore neighbors by applying movement actions (UP, DOWN, LEFT, RIGHT).\n        # Each movement action changes the agent's position and facing direction.\n        for action_type in [UP, DOWN, LEFT, RIGHT]:\n            dx, dy = ACTION_TO_DELTAS[action_type]\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_dir_id = ACTION_TO_NEW_DIR_ID[action_type]\n            next_state_tuple = (next_x, next_y, next_dir_id)\n\n            # Check if the next position is within grid bounds, is traversable, and the state (pos+dir) has not been visited.\n            if (0 <= next_x < W and 0 <= next_y < H and\n                traversable_mask[next_x, next_y] and\n                next_state_tuple not in visited):\n                \n                visited.add(next_state_tuple)\n                q.append((next_x, next_y, next_dir_id, actions_so_far + [action_type]))\n    \n    return best_path_actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:07:05.096164", "function_name": "collect", "function_body": "  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Get initial agent position (x, y) and direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  initial_dir = np.argmax(obs['features_dict']['direction']) # Convert one-hot to integer direction\n\n  world = env.world\n  # Non-grabbable items define obstacles (e.g., walls, water, workshops).\n  # Assuming these are typically untraversable.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape # Grid dimensions: Width, Height, Number of kinds\n\n  # 1. Create a traversability mask for the grid\n  # A cell is traversable if it does not contain any non-grabbable item.\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for x in range(W):\n      for y in range(H):\n          if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n              traversable_mask[x, y] = False\n  \n  # The agent's starting position must be traversable for a valid path to exist.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return []\n\n  # BFS state: ((x, y), current_facing_direction, list_of_actions_so_far)\n  # The queue stores tuples: ((pos_x, pos_y), current_dir, actions_taken)\n  q = deque([((current_pos_x, current_pos_y), initial_dir, [])])\n  \n  # Visited set: ((pos_x, pos_y), current_dir) to prevent revisiting states and cycles\n  visited = {((current_pos_x, current_pos_y), initial_dir)}\n  \n  while q:\n      (curr_x, curr_y), curr_dir, actions_so_far = q.popleft()\n\n      # Check if the current state allows collection of the primitive (via USE action)\n      # The USE action applies to the cell directly in front of the agent.\n      front_dx, front_dy = DIRECTION_TO_DELTA[curr_dir] # Delta for the cell in front\n      target_x, target_y = curr_x + front_dx, curr_y + front_dy\n\n      # Check if the target cell is within grid bounds AND contains the primitive\n      if (0 <= target_x < W and 0 <= target_y < H and\n          grid[target_x, target_y, primitive] > 0):\n          # Goal reached: agent is positioned and facing a primitive resource.\n          # Append USE action to the path and return the sequence.\n          return actions_so_far + [USE]\n\n      # Explore possible next states by taking movement actions (UP, DOWN, LEFT, RIGHT)\n      for action_val in [UP, DOWN, LEFT, RIGHT]:\n          # After taking a movement action, the agent's direction changes to match the movement.\n          next_dir = MOVE_ACTION_TO_DIRECTION[action_val]\n          \n          # Calculate the new position based on the new direction\n          # The agent moves one step in the direction it will be facing.\n          dx, dy = DIRECTION_TO_DELTA[next_dir]\n          next_x, next_y = curr_x + dx, curr_y + dy\n          \n          # Check if the next cell is within bounds and is traversable\n          if (0 <= next_x < W and 0 <= next_y < H and\n              traversable_mask[next_x, next_y]):\n              \n              next_state_key = ((next_x, next_y), next_dir)\n              \n              # If this (position, direction) state has not been visited yet, add to queue\n              if next_state_key not in visited:\n                  visited.add(next_state_key)", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T05:08:33.001007", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants (matching CraftLab action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Delta row, delta column for each direction\n  # dir: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT\n  DELTAS = {\n      ACTION_DOWN: (1, 0),\n      ACTION_UP: (-1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1),\n  }\n\n  # Access the current state from the CraftLab environment's internal state\n  current_state = env._current_state\n  current_pos_r, current_pos_c = current_state.pos\n  current_dir = current_state.dir # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  grid = current_state.grid # (HEIGHT, WIDTH, n_kinds)\n  inventory = current_state.inventory # (n_kinds,)\n\n  # If the primitive is already in inventory, no actions needed\n  if inventory[primitive] > 0:\n    return []\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Identify impassable terrain (e.g., water)\n  impassable_kinds = set()\n  # Check if the world has a water_index and add it to impassable_kinds\n  if hasattr(env.world, 'water_index'):\n      impassable_kinds.add(env.world.water_index)\n  # Other potentially impassable items could be added here if defined in CraftWorld\n  # e.g., if 'stone_index' represented a solid block, it would be added too.\n\n  # BFS setup\n  # Queue stores tuples: (row, col, direction, list_of_actions_to_reach_this_state)\n  queue = collections.deque([(current_pos_r, current_pos_c, current_dir, [])])\n  # Visited set stores tuples: (row, col, direction) to avoid redundant explorations\n  visited = set([(current_pos_r, current_pos_c, current_dir)])\n\n  while queue:\n    r, c, d, path_actions = queue.popleft()\n\n    # Check if we can USE the primitive from the current position and direction\n    # The cell immediately \"in front\" of the agent, based on its current direction 'd'\n    dr_facing, dc_facing = DELTAS[d]\n    front_r, front_c = r + dr_facing, c + dc_facing\n\n    # Check if the cell in front is within grid bounds and contains the desired primitive\n    if (0 <= front_r < grid_height and 0 <= front_c < grid_width and\n        grid[front_r, front_c, primitive] == 1):\n      # Found the primitive and are in the correct position and facing to USE it\n      return path_actions + [ACTION_USE]\n\n    # Explore neighbor states by moving in each of the four cardinal directions\n    for action in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n      move_dr, move_dc = DELTAS[action]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_d = action # When moving, the agent's direction updates to the direction of movement\n\n      # Check if the new position is within grid boundaries\n      if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n        continue # Skip if out of bounds\n\n      # Check if the new position is traversable (i.e., not an impassable kind like water)\n      is_impassable = False\n      for impassable_kind in impassable_kinds:\n        if grid[next_r, next_c, impassable_kind] == 1: # If the cell contains an impassable kind\n          is_impassable = True\n          break\n      if is_impassable:\n        continue # Skip if the cell is impassable\n\n      # If this new state (position and direction) has not been visited before, add it to the queue\n      if (next_r, next_c, next_d) not in visited:\n        visited.add((next_r, next_c, next_d))\n        queue.append((next_r, next_c, next_d, path_actions + [action]))\n\n  # If the BFS completes and the queue is exhausted without finding a path to collect the primitive\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:08:33.968890", "function_name": "collect", "function_body": "  # Action constants (from CraftLab.action_specs: DOWN\u21920, UP\u21921, LEFT\u21922, RIGHT\u21923, USE\u21924)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Get initial state information from the CraftLab environment\n  # _current_state is accessed as per typical problem context for DMLab-style wrappers\n  current_state = env._current_state\n  \n  # If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  grid = current_state.grid\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  # Get grid dimensions (WIDTH, HEIGHT) from the grid's shape\n  # grid.shape is (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Define movement deltas for each of the four cardinal directions/actions (DOWN, UP, LEFT, RIGHT)\n  # This dictionary maps an action integer to its corresponding (delta_row, delta_col)\n  move_deltas = {\n      DOWN: (1, 0),   # Moving down increases row index\n      UP: (-1, 0),    # Moving up decreases row index\n      LEFT: (0, -1),  # Moving left decreases column index\n      RIGHT: (0, 1)   # Moving right increases column index\n  }\n\n  # Initialize a deque for Breadth-First Search (BFS)\n  # Each element in the queue is a tuple:\n  # ( (current_row, current_col), current_direction, list_of_actions_taken_to_reach_this_state )\n  queue = collections.deque([(start_pos, start_dir, [])])\n  \n  # Initialize a set to keep track of visited states.\n  # A state is defined by (row, col, direction) to handle different orientations at the same location.\n  # This prevents infinite loops and ensures the shortest path is found.\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  # Start the BFS traversal\n  while queue:\n    (r, c), current_dir, path_actions = queue.popleft()\n\n    # --- Goal Check ---\n    # Check if the agent, in its current (position, direction) state, is ready to USE the primitive.\n    # The USE action typically affects the cell directly in front of the agent.\n    \n    # Calculate the coordinates of the cell that is directly in front of the agent\n    dr_face, dc_face = move_deltas[current_dir]\n    faced_r, faced_c = r + dr_face, c + dc_face\n\n    # Ensure the faced cell is within the grid boundaries\n    if 0 <= faced_r < WIDTH and 0 <= faced_c < HEIGHT:\n      # Check if the faced cell contains the target primitive\n      if grid[faced_r, faced_c, primitive] == 1:\n        # If the primitive is found and is directly in front, the goal is reached.\n        # Append the USE action to the current sequence of actions and return the complete path.\n        return path_actions + [USE]\n\n    # --- Explore Next States (Movement Actions) ---\n    # For the current state (r, c, current_dir), explore all possible next movement actions.\n    for action in [DOWN, UP, LEFT, RIGHT]:\n      dr, dc = move_deltas[action] # Get the change in row and column for this specific action\n      \n      next_r, next_c = r + dr, c + dc # Calculate the agent's new position\n      next_pos = (next_r, next_c)\n      \n      # When the agent performs a movement action (DOWN, UP, LEFT, RIGHT),\n      # its facing direction is updated to match the direction of that movement.\n      next_dir = action \n\n      # Check if the new calculated position is within the grid boundaries\n      if 0 <= next_r < WIDTH and 0 <= next_c < HEIGHT:\n        # Create a tuple representing the new state (position and direction)\n        next_state_tuple = (next_r, next_c, next_dir)\n        \n        # Check if this new state has already been visited to avoid redundant work and cycles\n        if next_state_tuple not in visited:\n          visited.add(next_state_tuple) # Mark the new state as visited\n          # Add the new state to the queue, appending the current action to the path\n          queue.append((next_pos, next_dir, path_actions + [action]))\n\n  # If the BFS queue becomes empty and the goal (collecting the primitive) has not been reached,\n  # it means the primitive is unreachable from the current starting state under these rules.\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:09:49.670736", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants based on CraftLab.action_specs()\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  initial_state = env._current_state\n\n  # 1. Check if primitive is already in inventory\n  if initial_state.inventory[primitive] > 0:\n    return []\n\n  # BFS setup\n  # Queue stores tuples: (current_CraftState_object, list_of_actions_to_reach_this_state)\n  q = collections.deque([(initial_state, [])])\n\n  # Visited set to avoid redundant exploration and cycles.\n  # A state is defined by (agent_x, agent_y, agent_direction).\n  # We assume the grid state for non-agent entities is static during pathfinding.\n  visited = set()\n  visited.add((initial_state.pos[0], initial_state.pos[1], initial_state.dir))\n\n  # The actions to explore during BFS are movement and turning.\n  # ACTION_USE is a special action that is only performed when next to the target.\n  movement_actions = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  while q:\n    current_state, current_actions = q.popleft()\n\n    # Check if the current state is adjacent to the primitive\n    if current_state.next_to(primitive):\n      # If next to it, simulate the USE action\n      # CraftState.step returns a new state after applying the action.\n      _, state_after_use = current_state.step(ACTION_USE)\n\n      # If the primitive is now in the inventory, we found a solution.\n      if state_after_use.inventory[primitive] > 0:\n        return current_actions + [ACTION_USE]\n      # If not, this path does not lead to collection via USE right now.\n      # Continue exploring other paths.\n\n    # Explore possible next states by applying movement and turning actions\n    for action in movement_actions:\n      # Simulate the action to get the next state object\n      # (reward is always 0.0, so we ignore it)\n      _, next_state = current_state.step(action)\n\n      # Create a hashable key for the visited set\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n      # If this state hasn't been visited yet, add it to the queue\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, current_actions + [action]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:09:50.714649", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:11:34.657302", "function_name": "collect", "function_body": "    # Action mapping (as defined in CraftLab.action_specs)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    ACTIONS_MAP = {\n        (0, 1): DOWN,\n        (0, -1): UP,\n        (-1, 0): LEFT,\n        (1, 0): RIGHT,\n    }\n\n    actions = []\n    current_state = env._current_state\n    \n    # 1. Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    current_pos = current_state.pos\n    width, height, _ = grid.shape\n\n    # Identify potential obstacles (water and stone are typical non-traversable blocks).\n    # This is an assumption based on common CraftWorld implementations.\n    # More complex traversability rules would require deeper integration with CraftState.step logic.\n    water_idx = env.world.water_index\n    stone_idx = env.world.stone_index\n\n    # Helper function to check if a cell is within grid bounds and not an obvious obstacle\n    def is_traversable(x, y):\n        if not (0 <= x < width and 0 <= y < height):\n            return False\n        # Agent cannot move into cells occupied by water or stone (common assumption)\n        if grid[x, y, water_idx] == 1 or grid[x, y, stone_idx] == 1:\n            return False\n        return True\n\n    # 2. Find all potential target cells: these are traversable cells\n    #    that are 4-way adjacent to a cell containing the primitive.\n    potential_targets = set()\n    for x_grid in range(width):\n        for y_grid in range(height):\n            if grid[x_grid, y_grid, primitive] == 1: # This cell (x_grid, y_grid) contains the primitive\n                # Check its 4-way neighbors\n                for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                    nx, ny = x_grid + dx, y_grid + dy\n                    if is_traversable(nx, ny):\n                        potential_targets.add((nx, ny))\n    \n    if not potential_targets:\n        # Primitive not found anywhere or all its adjacent cells are blocked\n        return []\n\n    # If the agent is already at a potential target location, we just need to USE.\n    # This covers cases where the agent spawns next to or even on top of a collectable item\n    # (assuming being on top implies being \"next to\" for `USE`).\n    if current_pos in potential_targets:\n        # Primitives are defined as resources, which are generally grabbable.\n        # So, if at the target, we perform USE.\n        if primitive in env.world.grabbable_indices:\n            actions.append(USE)\n        return actions\n\n    # 3. Perform BFS to find the shortest path from current_pos to any potential_target\n    q = collections.deque([(current_pos[0], current_pos[1])])\n    visited = {current_pos}\n    parent_map = {} # (x, y) -> (prev_x, prev_y) to reconstruct the path\n\n    found_target_adj_pos = None\n\n    while q:\n        cx, cy = q.popleft()\n\n        if (cx, cy) in potential_targets:\n            found_target_adj_pos = (cx, cy)\n            break # Found the nearest target cell\n\n        # Explore 4-way neighbors\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = cx + dx, cy + dy\n            if is_traversable(nx, ny) and (nx, ny) not in visited:\n                visited.add((nx, ny))\n                parent_map[(nx, ny)] = (cx, cy)\n                q.append((nx, ny))\n    \n    if not found_target_adj_pos:\n        # No path found to any primitive-adjacent traversable cell\n        return []\n\n    # 4. Reconstruct the path from found_target_adj_pos back to current_pos\n    path_coords = []\n    curr = found_target_adj_pos\n    while curr != current_pos:\n        path_coords.append(curr)\n        curr = parent_map[curr]\n    path_coords.append(current_pos) # Add the starting position to complete the path\n    path_coords.reverse() # Reverse to get path from start to target\n\n    # 5. Convert path coordinates into a sequence of actions\n    for i in range(len(path_coords) - 1):\n        x1, y1 = path_coords[i]\n        x2, y2 = path_coords[i+1]\n        \n        dx, dy = x2 - x1, y2 - y1\n        if (dx, dy) in ACTIONS_MAP:\n            actions.append(ACTIONS_MAP[(dx, dy)])\n        else:\n            # This case indicates an invalid path segment, which should not happen\n            # if BFS and path reconstruction are correct.\n            return [] # Error or unhandled movement\n\n    # 6. Add the USE action if the primitive is a grabbable item.\n    #   Given the function name \"collect\", it implies the primitive is a resource\n    #   that needs to be picked up using USE.\n    if primitive in env.world.grabbable_indices:\n        actions.append(USE)\n    \n    return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:11:34.729480", "function_name": "collect", "function_body": "    state = env._current_state\n    current_pos = state.pos\n    current_dir = state.dir\n    grid = state.grid\n    world = state.world\n    # Assuming WIDTH, HEIGHT are the first two dimensions of the grid\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # Action mappings from env_factory.action_map\n    # Assuming DMLab-style relative movement and turning actions:\n    # UP: move forward, DOWN: move backward, LEFT: turn left, RIGHT: turn right, USE: interact\n    ACTION_MAP = env_factory.action_map\n    FORWARD_ACTION = ACTION_MAP['UP']\n    BACKWARD_ACTION = ACTION_MAP['DOWN']\n    TURN_LEFT_ACTION = ACTION_MAP['LEFT']\n    TURN_RIGHT_ACTION = ACTION_MAP['RIGHT']\n    USE_ACTION = ACTION_MAP['USE']\n\n    # Direction deltas (dr, dc) for 0:North, 1:East, 2:South, 3:West\n    # These match the agent's internal 'dir' mapping\n    # North (0): (row-1, col)\n    # East (1): (row, col+1)\n    # South (2): (row+1, col)\n    # West (3): (row, col-1)\n    DIR_TO_DELTA = {0: (-1, 0), 1: (0, 1), 2: (1, 0), 3: (0, -1)}\n\n    # Get non-grabbable indices for obstacle checking.\n    # These are entities that cannot be picked up and are assumed to block movement.\n    non_grabbable_indices = world.non_grabbable_indices\n\n    # 1. Check if the primitive is already in the agent's inventory\n    if state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # 2. Find all locations on the grid where the primitive exists\n    primitive_locations = set() # Use a set for faster lookup\n    for r in range(WIDTH):\n        for c in range(HEIGHT):\n            # Check if this grid cell contains the target primitive\n            if grid[r, c, primitive] > 0:\n                primitive_locations.add((r, c))\n\n    if not primitive_locations:\n        return [] # Primitive not found anywhere on the map\n\n    # 3. Use Breadth-First Search (BFS) to find the shortest sequence of actions\n    # BFS state: ((current_row, current_col), current_direction, list_of_actions_taken)\n    queue = collections.deque([((current_pos[0], current_pos[1]), current_dir, [])])\n    visited = set() # To store (row, col, direction) tuples to avoid cycles and redundant paths\n\n    while queue:\n        ((r, c), d, path_actions) = queue.popleft()\n\n        # If this state has been visited before, skip\n        if ((r, c), d) in visited:\n            continue\n        visited.add(((r, c), d))\n\n        # Check if the primitive is directly in front of the agent (ready for USE action)\n        target_r, target_c = r + DIR_TO_DELTA[d][0], c + DIR_TO_DELTA[d][1]\n        \n        # Ensure target cell is within bounds and contains the primitive\n        if 0 <= target_r < WIDTH and 0 <= target_c < HEIGHT and \\\n           (target_r, target_c) in primitive_locations:\n            # Found a path to a position where USE is effective\n            return path_actions + [USE_ACTION]\n\n        # Explore possible next actions:\n        # (a) Move Forward\n        next_r_f, next_c_f = r + DIR_TO_DELTA[d][0], c + DIR_TO_DELTA[d][1]\n        if 0 <= next_r_f < WIDTH and 0 <= next_c_f < HEIGHT:\n            # Check if the next cell is traversable (not an obstacle)\n            is_obstacle = False\n            for obj_idx in non_grabbable_indices:\n                if grid[next_r_f, next_c_f, obj_idx] > 0:\n                    is_obstacle = True\n                    break\n            if not is_obstacle:\n                # Add the new state to the queue if not visited\n                if ((next_r_f, next_c_f), d) not in visited:\n                    queue.append(((next_r_f, next_c_f), d, path_actions + [FORWARD_ACTION]))\n\n        # (b) Move Backward\n        next_r_b, next_c_b = r - DIR_TO_DELTA[d][0], c - DIR_TO_DELTA[d][1] # Move in opposite direction of current facing\n        if 0 <= next_r_b < WIDTH and 0 <= next_c_b < HEIGHT:\n            is_obstacle = False\n            for obj_idx in non_grabbable_indices:\n                if grid[next_r_b, next_c_b, obj_idx] > 0:\n                    is_obstacle = True\n                    break\n            if not is_obstacle:\n                if ((next_r_b, next_c_b), d) not in visited:\n                    queue.append(((next_r_b, next_c_b), d, path_actions + [BACKWARD_ACTION]))\n\n        # (c) Turn Left\n        new_d_l = (d - 1 + 4) % 4 # Cycle directions: 0 -> 3 -> 2 -> 1 -> 0\n        if ((r, c), new_d_l) not in visited:\n            queue.append(((r, c), new_d_l, path_actions + [TURN_LEFT_ACTION]))\n\n        # (d) Turn Right\n        new_d_r = (d + 1) % 4 # Cycle directions: 0 -> 1 -> 2 -> 3 -> 0\n        if ((r, c), new_d_r) not in visited:\n            queue.append(((r, c), new_d_r, path_actions + [TURN_RIGHT_ACTION]))\n\n    # If the queue becomes empty and no path was found, the primitive is unreachable\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:13:28.390315", "function_name": "collect", "function_body": "    import collections\n\n    # Action constants as defined in CraftLab\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Helper function for BFS-based search to find the sequence of actions\n    # to collect the target primitive.\n    def _bfs_collect_path(initial_state, primitive_idx, max_search_steps=5000):\n        \"\"\"\n        Performs a Breadth-First Search on the state space to find the shortest\n        sequence of actions to collect a given primitive.\n\n        Args:\n            initial_state: The starting CraftState instance.\n            primitive_idx: The integer ID of the primitive to collect.\n            max_search_steps: Maximum number of BFS steps to explore to prevent infinite loops.\n\n        Returns:\n            A list of action integers if a path is found, otherwise None.\n        \"\"\"\n        # Queue stores tuples of (current_CraftState, list_of_actions_taken_to_reach_this_state)\n        q = collections.deque([(initial_state, [])])\n        \n        # visited_configs stores hashable representations of states to avoid revisiting.\n        # A state is defined by (agent_position, agent_direction, inventory_tuple).\n        # inventory (numpy.ndarray) must be converted to a tuple to be hashable.\n        visited_configs = set()\n        \n        # Add the initial state to the visited set\n        visited_configs.add((initial_state.pos, initial_state.dir, tuple(initial_state.inventory)))\n\n        # List of all possible actions for movement and use\n        all_actions = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n        current_bfs_step = 0\n\n        while q and current_bfs_step < max_search_steps:\n            current_state, path_actions = q.popleft()\n            current_bfs_step += 1\n\n            # Check if the primitive is already collected in the current state's inventory\n            if current_state.inventory[primitive_idx] > 0:\n                return path_actions # Goal achieved, return the path\n\n            # Explore all possible actions from the current state\n            for action_id in all_actions:\n                # Simulate the action using CraftState's step method.\n                # This method handles all game logic (movement, collisions, inventory updates etc.).\n                _reward, next_state = current_state.step(action_id)\n                \n                # Create a hashable configuration for the next state\n                next_config = (next_state.pos, next_state.dir, tuple(next_state.inventory))\n\n                # If this state configuration has not been visited, add it to the queue\n                # and mark it as visited.\n                if next_config not in visited_configs:\n                    visited_configs.add(next_config)\n                    q.append((next_state, path_actions + [action_id]))\n        \n        # If the queue becomes empty or max_search_steps is reached, no path was found\n        return None \n\n    # --- Main collect_v2 function body ---\n\n    # Reset the environment to ensure a consistent starting point for planning.\n    # `env.reset()` returns an observation dictionary. The actual CraftState\n    # object is accessible via `env._current_state`.\n    _ = env.reset() \n    initial_state_for_planning = env._current_state\n\n    # First, check if the primitive is already in the inventory at the start.\n    if initial_state_for_planning.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed.\n\n    # Find the sequence of actions using the BFS search helper function.\n    actions_to_collect = _bfs_collect_path(initial_state_for_planning, primitive)\n\n    if actions_to_collect is None:\n        # If BFS returns None, it means no path was found within the defined search limits\n        # or the primitive is genuinely unreachable in the current scenario.\n        # Return an empty list to indicate that no plan could be generated.\n        return []\n    else:\n        # A plan (list of actions) was found.\n        return actions_to_collect", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:13:28.462600", "function_name": "collect", "function_body": "    # Action constants (assuming these are consistent with env_factory.action_map)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Map movement actions to their corresponding grid coordinate deltas\n    MOVE_DELTAS = {\n        ACTION_UP: (-1, 0),\n        ACTION_DOWN: (1, 0),\n        ACTION_LEFT: (0, -1),\n        ACTION_RIGHT: (0, 1)\n    }\n\n    # Map movement actions to the direction they result in (0=N, 1=E, 2=S, 3=W)\n    # This assumes the agent's direction updates to match the movement direction\n    DIR_MAP = {\n        ACTION_UP: 0,    # North\n        ACTION_RIGHT: 1, # East\n        ACTION_DOWN: 2,  # South\n        ACTION_LEFT: 3   # West\n    }\n\n    def _get_grid_cell_in_front_coords(r, c, d):\n      \"\"\"Helper to get coordinates of the cell in front of (r,c) facing direction d.\"\"\"\n      # d: 0=N, 1=E, 2=S, 3=W\n      if d == 0: return r - 1, c  # North\n      if d == 1: return r, c + 1  # East\n      if d == 2: return r + 1, c  # South\n      if d == 3: return r, c - 1  # West\n      return r, c # Should not happen\n\n    # Get current state from the environment\n    current_state = env._current_state\n    grid = current_state.grid\n    current_pos = current_state.pos\n    current_dir = current_state.dir\n    inventory = current_state.inventory\n    world = current_state.world\n\n    H, W, _ = grid.shape\n\n    # 1. Check if primitive is already collected\n    if inventory[primitive] > 0:\n      return []\n\n    # 2. Identify blocking entities (assuming 'wall' is the primary blocker)\n    blocking_indices = set()\n    wall_idx = world.index.contents.get('wall')\n    if wall_idx is not None:\n        blocking_indices.add(wall_idx)\n    # Additional logic could be added here to consider other non-traversable\n    # entities if needed, for instance, `plant` if it's a fixed obstacle.\n    # For now, we assume only 'wall' explicitly blocks movement.\n\n    # 3. Find all locations of the primitive on the grid\n    primitive_locations = []\n    for r in range(H):\n      for c in range(W):\n        if grid[r, c, primitive] == 1:\n          primitive_locations.append((r, c))\n\n    if not primitive_locations:\n      # Primitive not found on the grid\n      return []\n\n    # 4. BFS to find the shortest path to an adjacent cell of a primitive,\n    #    with the correct facing direction.\n    # State in BFS queue: ((row, col, direction), list_of_actions_so_far)\n    q = collections.deque()\n    q.append(((current_pos[0], current_pos[1], current_dir), []))\n    \n    # Visited set to avoid cycles: (row, col, direction)\n    visited = {(current_pos[0], current_pos[1], current_dir)}\n\n    while q:\n      (r, c, d), path_so_far = q.popleft()\n\n      # Check if we can USE from the current state (r, c, d)\n      target_r, target_c = _get_grid_cell_in_front_coords(r, c, d)\n      if (0 <= target_r < H and 0 <= target_c < W and\n          (target_r, target_c) in primitive_locations):\n        # Found a path to be adjacent to the primitive and facing it\n        return path_so_far + [ACTION_USE]\n\n      # Explore movement actions (UP, DOWN, LEFT, RIGHT)\n      for move_action in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n        dr, dc = MOVE_DELTAS[move_action]\n        new_r, new_c = r + dr, c + dc\n        new_d = DIR_MAP[move_action] # Direction updates to match the movement action\n\n        # Check if the new position is within grid boundaries\n        if not (0 <= new_r < H and 0 <= new_c < W):\n          continue\n\n        # Check if the new position is blocked by an obstacle\n        is_blocked = False\n        for blocking_idx in blocking_indices:\n          if grid[new_r, new_c, blocking_idx] == 1:\n            is_blocked = True\n            break\n        if is_blocked:\n          continue\n\n        # If the new state (position and direction) has not been visited, add it to the queue\n        if (new_r, new_c, new_d) not in visited:\n          visited.add((new_r, new_c, new_d))\n          q.append(((new_r, new_c, new_d), path_so_far + [move_action]))\n\n    # If the BFS completes and no path to the primitive is found\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:14:46.609985", "function_name": "collect", "function_body": "    import collections\n\n    # Constants for actions based on CraftLab.action_specs() description\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Map movement actions to (dx, dy) changes in coordinates (x,y)\n    # Assuming grid[y, x, ...] for (x, y) coordinates, where (x, y) is agent's pos.\n    MOVES = {\n        ACTION_UP: (0, -1),\n        ACTION_DOWN: (0, 1),\n        ACTION_LEFT: (-1, 0),\n        ACTION_RIGHT: (1, 0)\n    }\n\n    current_state = env._current_state # Access the internal CraftState object\n\n    # 1. Check if the primitive is already collected\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    start_pos = current_state.pos # (x, y) tuple\n    non_grabbable = current_state.world.non_grabbable_indices\n\n    # Grid dimensions: (HEIGHT, WIDTH, n_kinds)\n    height, width, _ = grid.shape \n\n    queue = collections.deque([(start_pos, [])]) # (current_pos (x,y), path_actions)\n    visited = {start_pos}\n\n    while queue:\n        current_pos, path_actions = queue.popleft()\n        cx, cy = current_pos\n\n        # Check if the primitive is in the 3x3 neighborhood (including current cell) of current_pos.\n        # The agent can pick it up with ACTION_USE if it's within this range.\n        found_primitive_nearby = False\n        for dy_offset in [-1, 0, 1]:\n            for dx_offset in [-1, 0, 1]:\n                target_px, target_py = cx + dx_offset, cy + dy_offset\n                \n                # Check bounds for the potential primitive location\n                if 0 <= target_px < width and 0 <= target_py < height:\n                    # Check if the primitive is present at this location\n                    if grid[target_py, target_px, primitive] > 0:\n                        found_primitive_nearby = True\n                        break # Primitive found in neighborhood\n            if found_primitive_nearby:\n                break\n\n        if found_primitive_nearby:\n            # If we found a primitive in the neighborhood, this path (to current_pos)\n            # is the shortest one to reach a point from which the primitive can be collected.\n            # BFS guarantees that the first path found to a state is the shortest path.\n            return path_actions + [ACTION_USE]\n\n        # Explore neighbors (move actions)\n        for action, (dx, dy) in MOVES.items():\n            next_x, next_y = cx + dx, cy + dy\n            next_pos = (next_x, next_y)\n\n            # Check bounds and if the next position has already been visited\n            if 0 <= next_x < width and 0 <= next_y < height and next_pos not in visited:\n                # Check if the next cell is traversable (not blocked by non-grabbable items)\n                is_blocked = False\n                for kind_idx in non_grabbable:\n                    if grid[next_y, next_x, kind_idx] > 0:\n                        is_blocked = True\n                        break # Cell is blocked by a non-grabbable item\n                \n                if not is_blocked:\n                    visited.add(next_pos)\n                    queue.append((next_pos, path_actions + [action]))\n\n    # If the queue is exhausted and no path to collect the primitive was found\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:14:46.687682", "function_name": "collect", "function_body": "    current_state = env._current_state\n    grid = current_state.grid\n    initial_pos = current_state.pos\n    r_dim, c_dim, _ = grid.shape  # r_dim is HEIGHT, c_dim is WIDTH\n    primitive_idx = primitive\n\n    # Get obstacle kinds from the world configuration.\n    # Non-grabbable items (like water, stone) are assumed to block movement.\n    # Workshop locations are typically traversable.\n    world = current_state.world\n    obstacle_kinds = set(world.non_grabbable_indices)\n\n    # Action deltas for (dr, dc) mapping: action ID to (delta_row, delta_col)\n    ACTION_DELTAS = {\n        env_factory.ACTIONS.DOWN: (1, 0),\n        env_factory.ACTIONS.UP: (-1, 0),\n        env_factory.ACTIONS.LEFT: (0, -1),\n        env_factory.ACTIONS.RIGHT: (0, 1),\n    }\n\n    # BFS queue: stores (current_position, path_taken_actions)\n    # path_taken_actions is a list of action IDs to reach current_position\n    queue = collections.deque([(initial_pos, [])])\n\n    # Visited set: stores positions (tuples) to avoid revisiting and cycles\n    visited = {initial_pos}\n\n    while queue:\n        curr_pos, curr_path = queue.popleft()\n        curr_r, curr_c = curr_pos\n\n        # Check if the current position is adjacent (4-directional) to the primitive.\n        # If so, we can use the 'USE' action from here to collect it.\n        can_use_here = False\n        for dr_adj, dc_adj in ACTION_DELTAS.values():\n            adj_r, adj_c = curr_r + dr_adj, curr_c + dc_adj\n\n            # Check if adjacent cell is within bounds\n            if 0 <= adj_r < r_dim and 0 <= adj_c < c_dim:\n                # Check if the adjacent cell contains the primitive\n                if grid[adj_r, adj_c, primitive_idx] > 0:\n                    can_use_here = True\n                    break\n\n        if can_use_here:\n            # Found the shortest path to a position from which the primitive can be used\n            return curr_path + [env_factory.ACTIONS.USE]\n\n        # Explore traversable neighbors from the current position\n        for action, (dr, dc) in ACTION_DELTAS.items():\n            new_r, new_c = curr_r + dr, curr_c + dc\n            new_pos = (new_r, new_c)\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= new_r < r_dim and 0 <= new_c < c_dim):\n                continue\n\n            # Check if the new position is an obstacle.\n            # A cell is an obstacle if it contains any item from obstacle_kinds.\n            is_obstacle = False\n            for k_idx in obstacle_kinds:\n                if grid[new_r, new_c, k_idx] > 0:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue  # Cannot move onto an obstacle cell\n\n            # Check if the new position has already been visited\n            if new_pos not in visited:\n                visited.add(new_pos)\n                queue.append((new_pos, curr_path + [action]))\n\n    # If the queue is empty and no path was found, the primitive is unreachable\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:16:02.065311", "function_name": "collect", "function_body": "    # Actions mapping (from CraftLab.action_specs)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n    MOVEMENT_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n    # Reset the environment to get the initial state for simulation\n    _ = env.reset()\n    initial_state = env._current_state\n\n    # Check if primitive is already in inventory\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    # BFS setup\n    queue = collections.deque()\n    # visited set stores (pos_x, pos_y, dir) tuples for simpler state tracking during movement.\n    # This assumes the grid and inventory relevant to pathfinding (before USE)\n    # don't critically change, and that the 'primitive' is a simple grabbable item.\n    visited = set()\n\n    # Add initial state to queue: (current_CraftState_instance, list_of_actions_to_reach_this_state)\n    queue.append((initial_state, []))\n    visited.add((initial_state.pos[0], initial_state.pos[1], initial_state.dir))\n\n    # Heuristic to prevent excessively long searches or infinite loops\n    max_path_length = 150 \n\n    while queue:\n        current_sim_state, actions_path = queue.popleft()\n\n        # Check if we are next to the primitive\n        if current_sim_state.next_to(primitive):\n            # If next to it, simulate the USE action to confirm collection\n            # CraftState.step returns (reward, new_state)\n            _, state_after_use = current_sim_state.step(USE)\n            if state_after_use.inventory[primitive] > 0:\n                # If USE successfully collected the primitive, this is our path\n                return actions_path + [USE]\n            # If USE did not collect it (e.g., it was an ungrabbable object),\n            # then this path doesn't lead to collection. Continue searching.\n\n        # If current path is too long, skip further exploration from this path\n        if len(actions_path) >= max_path_length:\n            continue\n\n        # Explore possible next movement actions\n        for action in MOVEMENT_ACTIONS:\n            # Simulate the action to get the next_state\n            # CraftState.step returns (reward, new_state)\n            _, next_sim_state = current_sim_state.step(action)\n\n            next_state_key = (next_sim_state.pos[0], next_sim_state.pos[1], next_sim_state.dir)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                queue.append((next_sim_state, actions_path + [action]))\n\n    # If no path is found within max_path_length or no accessible primitive\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T05:16:03.034344", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Action constants (from CraftLab.action_specs())\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos # (row, col)\n  inventory = current_state.inventory\n\n  # 1. Check if primitive is already collected\n  if inventory[primitive] > 0:\n    return []\n\n  width, height, n_kinds = grid.shape\n\n  # 2. Find all locations of the primitive on the grid\n  primitive_locations = []\n  for r in range(width):\n    for c in range(height):\n      if grid[r, c, primitive] > 0:\n        primitive_locations.append((r, c))\n\n  if not primitive_locations:\n    # Primitive not found anywhere on the map\n    return []\n\n  # Determine collection condition based on primitive type\n  is_grabbable = primitive in env.world.grabbable_indices\n\n  # BFS for pathfinding\n  # State in queue: ((current_r, current_c), [actions_list_to_reach_here])\n  queue = deque([(pos, [])])\n  visited = {pos} # Stores (r, c) tuples to avoid cycles and redundant paths\n\n  best_path = None\n\n  while queue:\n    (r, c), path_actions = queue.popleft()\n\n    # Check if the current position (r, c) satisfies the collection condition\n    is_goal_state = False\n    for tr, tc in primitive_locations:\n      if is_grabbable:\n        # For grabbable items, agent must be exactly on the item's square to pick it up.\n        if (r, c) == (tr, tc):\n          is_goal_state = True\n          break\n      else: # Not grabbable (e.g., water, stone, workshops)\n        # Agent needs to be in the 3x3 neighborhood of the primitive (including on it).\n        # This matches CraftState.next_to logic: max(abs(r-tr), abs(c-tc)) <= 1.\n        if abs(r - tr) <= 1 and abs(c - tc) <= 1:\n          is_goal_state = True\n          break\n\n    if is_goal_state:\n      best_path = path_actions + [USE]\n      break # Found a path to collect; BFS guarantees it's the shortest\n\n    # Explore neighbors (move actions)\n    move_deltas = {\n        DOWN: (1, 0),\n        UP: (-1, 0),\n        LEFT: (0, -1),\n        RIGHT: (0, 1)\n    }\n\n    for action_idx, (dr, dc) in move_deltas.items():\n      nr, nc = r + dr, c + dc\n\n      # Check boundaries\n      if not (0 <= nr < width and 0 <= nc < height):\n        continue\n\n      # Check if already visited\n      if (nr, nc) in visited:\n        continue\n\n      # Traversability: For collect_v2, we assume all cells are traversable.\n      # A more advanced version might check for impassable obstacles (e.g., walls).\n\n      visited.add((nr, nc))\n      queue.append(((nr, nc), path_actions + [action_idx]))\n\n  return best_path if best_path is not None else []", "island_id": 4, "scores": {"3": -1}}
