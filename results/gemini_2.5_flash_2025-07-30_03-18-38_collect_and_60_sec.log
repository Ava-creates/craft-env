{"timestamp": "2025-07-30T12:30:32.768625", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Action constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVES = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  def _is_valid_collection_point(agent_pos, target_indices_set, grid):\n      \"\"\"\n      Checks if `agent_pos` is a valid position from which to collect any of\n      the items/blocks specified by `target_indices_set`.\n      This means at least one target item/block must be present in the 3x3\n      neighborhood of `agent_pos` (including the agent's own cell).\n      \"\"\"\n      W, H, _ = grid.shape\n      ax, ay = agent_pos\n\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              nx, ny = ax + dx, ay + dy\n\n              # Check bounds for the neighboring cell\n              if 0 <= nx < W and 0 <= ny < H:\n                  # Check if any of the target indices are present in this neighbor cell\n                  for target_idx in target_indices_set:\n                      if grid[nx, ny, target_idx] > 0:\n                          return True\n      return False\n\n  actions = []\n  \n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  # Ensure position is int tuple. CraftState.pos is tuple(int, int)\n  # obs['features_dict']['pos'] is a numpy array, convert to tuple for hashing in sets/dicts.\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices # Set of int indices\n  \n  W, H, K = grid.shape\n\n  # 1. Determine traversable cells (Improved: Use numpy.any for efficiency)\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  traversable_mask = np.ones((W, H), dtype=bool)\n  if non_grabbable_indices: # Only apply filter if there are non-grabbable items to filter by\n      non_grabbable_indices_list = list(non_grabbable_indices) \n      # Select all layers for non-grabbable indices and check if any are present in each cell\n      obstacles_present = np.any(grid[:, :, non_grabbable_indices_list] > 0, axis=2)\n      traversable_mask = ~obstacles_present\n  \n  # Crucial: The agent's starting position must be traversable. If not, no path is possible.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] \n\n  # 2. Determine target kinds for collection.\n  # The 'primitive' input is the index of the *item* we want to collect (e.g., wood, water).\n  # Items can be collected in two ways:\n  #   a) Picked up directly if lying on the ground (check for `primitive` itself).\n  #   b) Harvested from a source block (e.g., water from a 'water' block, stone from a 'stone' block).\n  # The agent needs to be in a position where the item or its source block is in the 3x3 area.\n  \n  target_grid_indices = {primitive} # Always include the primitive itself for direct pickup\n\n  # Add source block indices if the primitive is derived from an environmental block\n  primitive_name = world.cookbook.index.get(primitive)\n  if primitive_name == 'water':\n      # 'water' item can be collected from a 'water' block\n      if world.water_index is not None:\n          target_grid_indices.add(world.water_index) \n  elif primitive_name == 'stone':\n      # 'stone' item can be collected from a 'stone' block\n      if world.stone_index is not None:\n          target_grid_indices.add(world.stone_index)\n  # Extend with more mappings if other primitives have specific source blocks\n\n  # 3. Perform BFS to find the shortest path to any location from which the primitive can be collected.\n  q = deque([current_pos]) \n  # Use `parent` dict keys directly as the visited set (Improved: Removed separate `visited` set)\n  parent = {current_pos: (None, None)} # parent[child_pos] = (parent_pos, action_from_parent)\n  \n  found_collection_pos = None\n\n  while q:\n      curr_pos = q.popleft()\n      \n      # Check if the current position is a valid collection point for any of the target indices\n      if _is_valid_collection_point(curr_pos, target_grid_indices, grid):\n          found_collection_pos = curr_pos\n          break # Found the shortest path to a suitable collection location\n      \n      # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n      for action, (dx, dy) in MOVES.items():\n          next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n          next_pos = (next_x, next_y)\n\n          # Check bounds, traversability, and if the cell has already been visited (i.e., in `parent` keys)\n          if (0 <= next_x < W and 0 <= next_y < H and\n              traversable_mask[next_x, next_y] and\n              next_pos not in parent): # `parent` dict also serves as the visited set\n              \n              parent[next_pos] = (curr_pos, action) # Store how we reached next_pos\n              q.append(next_pos)\n  \n  # If BFS finished without finding a reachable collection point, return empty list.\n  if found_collection_pos is None:\n      return [] \n  \n  # 4. Reconstruct the path from `found_collection_pos` back to `current_pos`.\n  path_actions = []\n  node = found_collection_pos\n  # Backtrack from the target node until we reach the starting node (whose parent is None).\n  while node != current_pos:\n      prev_node, action_to_reach_node = parent[node]\n      path_actions.append(action_to_reach_node)\n      node = prev_node\n  \n  path_actions.reverse() # Actions were collected in reverse order, so reverse them.\n  \n  # 5. Append the USE action after the movement path.\n  actions.extend(path_actions)\n  actions.append(USE)\n  \n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:31:49.302606", "function_name": "collect", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:31:50.316078", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action constants (from problem description context)\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Map movement action values to (dx, dy) deltas\n  # (dx, dy) represents how the agent's position changes\n  MOVEMENT_DELTAS = {\n      UP_ACTION: (0, -1),   # Moving North\n      DOWN_ACTION: (0, 1),  # Moving South\n      LEFT_ACTION: (-1, 0), # Moving West\n      RIGHT_ACTION: (1, 0), # Moving East\n  }\n\n  # Map movement action values to the resulting agent direction (0=N, 1=E, 2=S, 3=W)\n  # Taking a movement action makes the agent face that direction.\n  ACTION_TO_NEW_DIRECTION = {\n      UP_ACTION: 0,    # UP action results in facing North (direction 0)\n      RIGHT_ACTION: 1, # RIGHT action results in facing East (direction 1)\n      DOWN_ACTION: 2,  # DOWN action results in facing South (direction 2)\n      LEFT_ACTION: 3,  # LEFT action results in facing West (direction 3)\n  }\n  \n  # Map agent direction to (dx, dy) for the cell directly in front of the agent\n  # This is crucial for determining where the USE action would apply.\n  DIRECTION_TO_FACING_DELTA = {\n      0: (0, -1),  # North (agent faces up)\n      1: (1, 0),   # East (agent faces right)\n      2: (0, 1),   # South (agent faces down)\n      3: (-1, 0),  # West (agent faces left)\n  }\n\n  def _get_primitive_source_indices(primitive_item_idx: int, world) -> set[int]:\n    \"\"\"\n    Returns a set of grid indices that, when present in the cell directly in front\n    of the agent, allow the collection of `primitive_item_idx` via the USE action.\n    This includes the item itself (for direct pickup if it's an item on the ground)\n    and specific blocks (for harvesting, e.g., 'water' from 'water_block').\n    This improved version attempts to cover a wider range of common primitives\n    by checking for corresponding indices on the `world` object.\n    \"\"\"\n    source_indices = {primitive_item_idx} # Always include the item's own index for direct pickup\n\n    item_name = world.cookbook.index.get(primitive_item_idx)\n    \n    # Mappings for harvesting from non-grabbable environment entities.\n    # We use getattr with a default of None to safely check for the existence\n    # of these specific block indices on the `world` object, as not all worlds\n    # might define all possible primitive sources.\n    if item_name == 'water':\n        water_block_idx = getattr(world, 'water_index', None)\n        if water_block_idx is not None:\n            source_indices.add(water_block_idx)\n    elif item_name == 'stone':\n        stone_block_idx = getattr(world, 'stone_index', None)\n        if stone_block_idx is not None:\n            source_indices.add(stone_block_idx)\n    elif item_name == 'wood':\n        tree_block_idx = getattr(world, 'tree_index', None) # Common source for 'wood'\n        if tree_block_idx is not None:\n            source_indices.add(tree_block_idx)\n    elif item_name == 'iron_ore':\n        iron_ore_block_idx = getattr(world, 'iron_ore_index', None) # Common source for 'iron_ore'\n        if iron_ore_block_idx is not None:\n            source_indices.add(iron_ore_block_idx)\n    elif item_name == 'gold_ore':\n        gold_ore_block_idx = getattr(world, 'gold_ore_index', None) # Common source for 'gold_ore'\n        if gold_ore_block_idx is not None:\n            source_indices.add(gold_ore_block_idx)\n    # Add more such mappings here if other common primitives and their source blocks are known.\n            \n    return source_indices\n\n  # --- Start of main collect_v2 logic ---\n  \n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Convert position numpy array to tuple for hashing in sets/dictionaries.\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  # Current direction is a one-hot array, convert to an integer (0=N, 1=E, 2=S, 3=W)\n  current_dir = np.argmax(obs['features_dict']['direction'])\n  \n  world = env.world\n  # non_grabbable_indices are assumed to be obstacles that cannot be traversed by the agent.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape # Grid dimensions\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for x in range(W):\n      for y in range(H):\n          if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n              traversable_mask[x, y] = False\n  \n  # If the agent starts on an untraversable cell, no path is possible.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] \n\n  # 2. Identify all (agent_pos, agent_dir) states from which the USE action is possible.\n  # These are the states where the cell directly in front of the agent contains a source of the primitive.\n  target_pickup_states = set() # Stores elements as ((agent_x, agent_y), agent_direction)\n\n  primitive_source_indices = _get_primitive_source_indices(primitive, world)\n\n  # Iterate through every possible agent position on the grid\n  for x in range(W):\n      for y in range(H):\n          if not traversable_mask[x, y]: # Agent must be on a traversable cell to potentially USE an item\n              continue\n          \n          # For each traversable agent position, iterate through all 4 possible facing directions\n          for agent_dir in range(4): \n              dx_fwd, dy_fwd = DIRECTION_TO_FACING_DELTA[agent_dir] # Delta for the cell in front\n              faced_x, faced_y = x + dx_fwd, y + dy_fwd\n\n              # Check if the cell being faced is within grid bounds\n              if not (0 <= faced_x < W and 0 <= faced_y < H):\n                  continue\n              \n              # Check if the faced cell contains any of the identified primitive source kinds\n              if any(grid[faced_x, faced_y, source_idx] > 0 for source_idx in primitive_source_indices):\n                  target_pickup_states.add(((x, y), agent_dir))\n  \n  # If no valid pickup states are found anywhere on the map, the primitive is unreachable.\n  if not target_pickup_states:\n      return [] \n\n  # 3. Perform a Breadth-First Search (BFS) to find the shortest sequence of actions\n  #    to reach any of the `target_pickup_states`.\n  # Queue stores (current_position_tuple, current_direction_int, list_of_actions_so_far)\n  q = deque([(current_pos, current_dir, [])])\n  \n  # Visited states are (position_tuple, direction_integer) to prevent redundant exploration and cycles.\n  visited = {(current_pos, current_dir)} \n\n  while q:\n      curr_pos, curr_dir, path_so_far = q.popleft()\n\n      # If the current agent state (position and direction) is one of our target pickup states,\n      # we have found the shortest path.\n      if (curr_pos, curr_dir) in target_pickup_states:\n          return path_so_far + [USE_ACTION] # Append the USE action and return the full path\n\n      # Explore possible actions (movement, which also implicitly handles turning)\n      for action_val, (dx, dy) in MOVEMENT_DELTAS.items():\n          next_pos_x, next_pos_y = curr_pos[0] + dx, curr_pos[1] + dy\n          # The agent's direction changes to match the direction of the movement action.\n          next_dir = ACTION_TO_NEW_DIRECTION[action_val] \n\n          next_pos = (next_pos_x, next_pos_y)\n\n          # Case 1: The agent attempts to move to a new, traversable cell.\n          if (0 <= next_pos_x < W and 0 <= next_pos_y < H and\n              traversable_mask[next_pos_x, next_pos_y]):\n              \n              if (next_pos, next_dir) not in visited:\n                  visited.add((next_pos, next_dir))\n                  q.append((next_pos, next_dir, path_so_far + [action_val]))\n          \n          # Case 2: The agent attempts to move into a blocked (non-traversable) cell.\n          # In CraftWorld, if a movement action is blocked, the agent stays in its current\n          # position but still changes its facing direction. This effectively acts as a\n          # \"turn in place\" action, which is important for reaching desired facing directions.\n          else: \n              # The agent stays at curr_pos but its direction becomes next_dir.\n              # Only add this new state if it hasn't been visited before.\n              if (curr_pos, next_dir) not in visited:\n                  visited.add((curr_pos, next_dir))\n                  q.append((curr_pos, next_dir, path_so_far + [action_val]))\n\n  return [] # If the queue becomes empty and no target state was reached, the primitive is unreachable.", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:33:11.836254", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  _DOWN = action_map['DOWN']\n  _UP = action_map['UP']\n  _LEFT = action_map['LEFT']\n  _RIGHT = action_map['RIGHT']\n  _USE = action_map['USE']\n\n  # Get current state information directly from the CraftLab's internal state\n  current_state = env._current_state\n  start_pos = current_state.pos\n  initial_grid = current_state.grid\n  current_inventory = current_state.inventory\n  height, width, _ = initial_grid.shape\n\n  # Check if primitive is already collected\n  if current_inventory[primitive] > 0:\n      return []\n\n  # Identify non-grabbable obstacles and grabbable items\n  non_grabbable_indices = env.world.non_grabbable_indices\n  grabbable_indices = env.world.grabbable_indices\n\n  # Define possible movement actions and their deltas (dy, dx)\n  move_deltas = {\n      _DOWN: (1, 0),\n      _UP: (-1, 0),\n      _LEFT: (0, -1),\n      _RIGHT: (0, 1)\n  }\n\n  # Step 1: Find all potential target locations for collection\n  # A target location (y, x) means that once the agent reaches this (y, x)\n  # it can collect the primitive.\n  # The value associated with (y, x) in collect_targets indicates if a _USE\n  # action is required after reaching that cell.\n  \n  collect_targets = {} # {(y, x): requires_use_bool}\n\n  for py in range(height):\n      for px in range(width):\n          # If the primitive is present in this cell\n          if initial_grid[py, px, primitive] > 0:\n              if primitive in grabbable_indices:\n                  # If the primitive is grabbable, walking onto its cell (py, px)\n                  # should collect it. No _USE action needed explicitly by us.\n                  collect_targets[(py, px)] = False\n              elif primitive in non_grabbable_indices:\n                  # If the primitive is non-grabbable (e.g., a tree, a rock outcrop),\n                  # we need to be adjacent to it and use the _USE action.\n                  # So, we add all valid adjacent cells as targets.\n                  for dy, dx in move_deltas.values(): # Iterate over (dy, dx) tuples\n                      adj_y, adj_x = py + dy, px + dx\n                      # Check boundary for adjacent cell\n                      if 0 <= adj_y < height and 0 <= adj_x < width:\n                          collect_targets[(adj_y, adj_x)] = True # True indicates _USE is required\n\n  # If no primitive instances are found on the map, return an empty list\n  if not collect_targets:\n      return []\n\n  # Step 2: Perform BFS (Breadth-First Search) to find the shortest path\n  # from the agent's start_pos to any of the collect_targets.\n  \n  # Queue stores tuples of ((current_y, current_x), [list_of_actions_to_reach_here])\n  q = collections.deque([(start_pos, [])])\n  # Visited set to prevent cycles and redundant exploration\n  visited = {start_pos}\n\n  while q:\n      (cy, cx), current_path = q.popleft()\n\n      # Check if the current position is one of our target locations\n      if (cy, cx) in collect_targets:\n          requires_use = collect_targets[(cy, cx)]\n          final_actions = list(current_path) # Create a copy of the path\n          if requires_use:\n              final_actions.append(_USE) # Add _USE action if required for collection\n          return final_actions # Path found, return actions\n\n      # Explore neighbors by trying each movement action\n      for action, (dy, dx) in move_deltas.items():\n          ny, nx = cy + dy, cx + dx\n\n          # Check if the new position is within grid boundaries\n          if not (0 <= ny < height and 0 <= nx < width):\n              continue\n\n          # Check if the new position has already been visited\n          if (ny, nx) in visited:\n              continue\n\n          # Obstacle check: A cell is considered an obstacle if it contains\n          # any item designated as non-grabbable. The agent cannot move onto such cells.\n          is_obstacle = False\n          for k_idx in non_grabbable_indices:\n              if initial_grid[ny, nx, k_idx] > 0:\n                  is_obstacle = True\n                  break\n          \n          if is_obstacle:\n              continue # Cannot move to an obstacle cell\n\n          # If valid and not an obstacle, add to visited and queue\n          visited.add((ny, nx))\n          q.append(((ny, nx), current_path + [action]))\n\n  # If the queue becomes empty and no path to any primitive was found\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:33:11.905064", "function_name": "collect", "function_body": "    import collections # This import is needed for deque\n\n    # Action constants, as defined in CraftLab's action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Movement deltas for (row, col) corresponding to actions\n    MOVE_DELTAS = {\n        ACTION_DOWN: (1, 0),  # Move down (increase row)\n        ACTION_UP: (-1, 0),   # Move up (decrease row)\n        ACTION_LEFT: (0, -1), # Move left (decrease column)\n        ACTION_RIGHT: (0, 1)  # Move right (increase column)\n    }\n\n    # Get the current state from the CraftLab environment\n    current_state = env._current_state\n    \n    # 1. Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    grid = current_state.grid\n    start_pos = current_state.pos\n    grid_height, grid_width, _ = grid.shape\n\n    # BFS setup: (position, actions_to_reach_position)\n    queue = collections.deque([(start_pos, [])]) \n    visited = {start_pos} # Set of visited (row, col) tuples to avoid cycles and redundant paths\n\n    while queue:\n        (r, c), path_actions = queue.popleft()\n\n        # Check if the current position (r, c) is \"next to\" the primitive.\n        # This mirrors CraftState.next_to(primitive) logic, which checks the 3x3 neighborhood.\n        is_next_to_primitive = False\n        for dr_check in [-1, 0, 1]:\n            for dc_check in [-1, 0, 1]:\n                check_r, check_c = r + dr_check, c + dc_check\n                # Ensure the checked cell is within grid bounds\n                if 0 <= check_r < grid_height and 0 <= check_c < grid_width:\n                    # Check if the target primitive kind exists at this neighboring cell\n                    if grid[check_r, check_c, primitive] > 0:\n                        is_next_to_primitive = True\n                        break # Found primitive in neighborhood\n            if is_next_to_primitive:\n                break # Break outer loop too\n\n        if is_next_to_primitive:\n            # If the agent is at a position where it can \"USE\" to collect the primitive,\n            # return the path to this position followed by the USE action.\n            return path_actions + [ACTION_USE]\n\n        # Explore valid neighboring cells (move actions)\n        for action, (dr, dc) in MOVE_DELTAS.items():\n            new_r, new_c = r + dr, c + dc\n            new_pos = (new_r, new_c)\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= new_r < grid_height and 0 <= new_c < grid_width):\n                continue\n\n            # Check if this position has already been visited\n            if new_pos in visited:\n                continue\n\n            # Assuming all valid grid cells are traversable for movement,\n            # as items in CraftWorld typically don't block agent movement.\n            \n            # Add the new position to the queue and mark as visited\n            visited.add(new_pos)\n            queue.append((new_pos, path_actions + [action]))\n\n    # If the queue becomes empty and no path to the primitive (or a cell next to it) was found,\n    # it means the primitive is either not in the current grid or is unreachable.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:34:04.679975", "function_name": "collect", "function_body": "  # Action constants (standard in CraftWorld)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Mapping of movement actions to their corresponding (dx, dy) changes.\n  MOVEMENT_DELTAS = {\n      UP: (0, -1),   # Move North (decreases Y)\n      DOWN: (0, 1),  # Move South (increases Y)\n      LEFT: (-1, 0), # Move West (decreases X)\n      RIGHT: (1, 0), # Move East (increases X)\n  }\n\n  # Mapping of movement actions to the agent's new facing direction.\n  # (0=N, 1=E, 2=S, 3=W)\n  ACTION_TO_NEW_DIRECTION = {\n      UP: 0,\n      RIGHT: 1,\n      DOWN: 2,\n      LEFT: 3,\n  }\n  \n  # Mapping of agent's current direction to the (dx, dy) offset of the cell\n  # directly in front of the agent. This is where the 'USE' action applies.\n  DIRECTION_TO_FACING_DELTA = {\n      0: (0, -1),  # Facing North: cell directly 'up'\n      1: (1, 0),   # Facing East: cell directly 'right'\n      2: (0, 1),   # Facing South: cell directly 'down'\n      3: (-1, 0),  # Facing West: cell directly 'left'\n  }\n\n  def _get_primitive_source_indices(primitive_idx: int, world_obj) -> set[int]:\n    \"\"\"\n    Returns a set of grid indices that, if present in the cell directly in front\n    of the agent, allow the collection of `primitive_idx` via the USE action.\n    This includes the item's own index (for direct pickup if it's on the ground)\n    and specific environmental blocks (e.g., 'water_block' for 'water').\n    \"\"\"\n    # Initialize with the primitive's own index, as it can often be picked up directly.\n    source_indices = {primitive_idx} \n\n    item_name = world_obj.cookbook.index.get(primitive_idx)\n\n    # Add specific environmental blocks that yield the primitive when 'USE'd.\n    if item_name == 'water':\n        if hasattr(world_obj, 'water_index') and world_obj.water_index is not None:\n            source_indices.add(world_obj.water_index)\n    elif item_name == 'stone':\n        if hasattr(world_obj, 'stone_index') and world_obj.stone_index is not None:\n            source_indices.add(world_obj.stone_index)\n    # Extend this logic for other harvestable primitives if needed.\n    # Example:\n    # elif item_name == 'wood':\n    #     if hasattr(world_obj, 'tree_index') and world_obj.tree_index is not None:\n    #         source_indices.add(world_obj.tree_index)\n            \n    return source_indices\n\n  # --- Get current state information from the environment ---\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Agent's current position (x, y) as a tuple for hashing in sets/dictionaries.\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  # Agent's current facing direction (0=N, 1=E, 2=S, 3=W) from one-hot encoding.\n  current_dir = np.argmax(obs['features_dict']['direction'])\n  \n  world = env.world\n  # Indices of entities that cannot be traversed (obstacles like walls, water blocks).\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape # Grid dimensions (Width, Height, Number of Kinds)\n\n  # --- Determine traversable cells using NumPy for efficiency ---\n  # A cell is traversable if it does not contain any non-grabbable item.\n  \n  # Convert non_grabbable_indices to a list for advanced NumPy indexing.\n  non_grabbable_list = list(non_grabbable_indices)\n  \n  # `grid[:, :, non_grabbable_list]` selects only the channels corresponding to\n  # non-grabbable items for the entire grid.\n  # `> 0` creates a boolean array indicating presence of these items.\n  # `.any(axis=-1)` checks if *any* non-grabbable item is present in a cell's stack.\n  has_obstacle = (grid[:, :, non_grabbable_list] > 0).any(axis=-1)  \n  traversable_mask = ~has_obstacle # Invert to get a mask of traversable cells.\n\n  # If the agent starts on an untraversable cell (e.g., inside a wall), no path is possible.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] \n\n  # --- Identify all (agent_pos, agent_dir) states from which 'USE' is possible ---\n  # These are the states where the cell directly in front of the agent contains a source\n  # of the desired primitive.\n  \n  target_collection_states = set() # Stores elements as ((agent_x, agent_y), agent_direction)\n  \n  # Get all possible grid indices that can yield the desired primitive.\n  collectable_source_indices = _get_primitive_source_indices(primitive, world)\n\n  # Iterate through every possible agent position and facing direction on the grid.\n  for x in range(W):\n      for y in range(H):\n          # Agent must be on a traversable cell to initiate a 'USE' action.\n          if not traversable_mask[x, y]: \n              continue\n          \n          for agent_dir in range(4): # Iterate all 4 possible agent orientations.\n              # Calculate the coordinates of the cell directly in front of the agent.\n              dx_fwd, dy_fwd = DIRECTION_TO_FACING_DELTA[agent_dir]\n              faced_x, faced_y = x + dx_fwd, y + dy_fwd\n\n              # Check if the faced cell is within the grid boundaries.\n              if not (0 <= faced_x < W and 0 <= faced_y < H):\n                  continue\n              \n              # Check if the faced cell contains any of the identified primitive source kinds.\n              if any(grid[faced_x, faced_y, source_idx] > 0 for source_idx in collectable_source_indices):\n                  target_collection_states.add(((x, y), agent_dir))\n  \n  # If no valid collection states are found anywhere on the map, the primitive is unreachable.\n  if not target_collection_states:\n      return [] \n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence ---\n  # The BFS explores states as (agent_position, agent_direction) to find the shortest\n  # path to any of the `target_collection_states`.\n  \n  # Queue stores (current_position_tuple, current_direction_int, list_of_actions_taken_so_far)\n  q = deque([(current_pos, current_dir, [])])\n  \n  # Set of visited states to avoid cycles and redundant exploration.\n  # A state is defined by (agent_position_tuple, agent_direction_integer).\n  visited = {(current_pos, current_dir)} \n\n  while q:\n      curr_pos, curr_dir, path_so_far = q.popleft()\n\n      # If the current state is one of our target collection states, we've found the shortest path.\n      if (curr_pos, curr_dir) in target_collection_states:\n          return path_so_far + [USE] # Append the 'USE' action and return the complete path.\n\n      # Explore all possible movement actions from the current state.\n      for action_val, (dx, dy) in MOVEMENT_DELTAS.items():\n          next_pos_x, next_pos_y = curr_pos[0] + dx, curr_pos[1] + dy\n          next_pos = (next_pos_x, next_pos_y)\n          \n          # The agent's direction changes to align with the movement action's direction,\n          # regardless of whether the move itself is successful (e.g., if blocked).\n          next_dir = ACTION_TO_NEW_DIRECTION[action_val] \n\n          # Check if the intended next position is within bounds and traversable.\n          if (0 <= next_pos_x < W and 0 <= next_pos_y < H and\n              traversable_mask[next_pos_x, next_pos_y]):\n              \n              # If the move is successful (agent changes position).\n              if (next_pos, next_dir) not in visited:\n                  visited.add((next_pos, next_dir))\n                  q.append((next_pos, next_dir, path_so_far + [action_val]))\n          \n          else: \n              # If the move is blocked (e.g., agent tries to move into a wall/obstacle).\n              # In CraftWorld, the agent stays at its current position but still changes\n              # its facing direction. This effectively acts as a \"turn in place\" action.\n              if (curr_pos, next_dir) not in visited:\n                  visited.add((curr_pos, next_dir))\n                  q.append((curr_pos, next_dir, path_so_far + [action_val]))\n\n  return [] # If the BFS queue becomes empty and no target state was reached, the primitive is unreachable.", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:34:05.657139", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action constants (from problem description context)\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Map movement action values to (dx, dy) deltas\n  # (dx, dy) represents how the agent's position changes\n  MOVEMENT_DELTAS = {\n      UP_ACTION: (0, -1),   # Moving North\n      DOWN_ACTION: (0, 1),  # Moving South\n      LEFT_ACTION: (-1, 0), # Moving West\n      RIGHT_ACTION: (1, 0), # Moving East\n  }\n\n  # Map movement action values to the resulting agent direction (0=N, 1=E, 2=S, 3=W)\n  # Taking a movement action makes the agent face that direction.\n  ACTION_TO_NEW_DIRECTION = {\n      UP_ACTION: 0,    # UP action results in facing North (direction 0)\n      RIGHT_ACTION: 1, # RIGHT action results in facing East (direction 1)\n      DOWN_ACTION: 2,  # DOWN action results in facing South (direction 2)\n      LEFT_ACTION: 3,  # LEFT action results in facing West (direction 3)\n  }\n  \n  # Map agent direction to (dx, dy) for the cell directly in front of the agent\n  # This is crucial for determining where the USE action would apply.\n  DIRECTION_TO_FACING_DELTA = {\n      0: (0, -1),  # North (agent faces up)\n      1: (1, 0),   # East (agent faces right)\n      2: (0, 1),   # South (agent faces down)\n      3: (-1, 0),  # West (agent faces left)\n  }\n\n  def _get_primitive_source_indices(primitive_item_idx: int, world) -> set[int]:\n    \"\"\"\n    Returns a set of grid indices that, when present in the cell directly in front\n    of the agent, allow the collection of `primitive_item_idx` via the USE action.\n    This includes the item itself (for direct pickup if it's an item on the ground)\n    and specific blocks (for harvesting, e.g., 'water' from 'water_block').\n    \"\"\"\n    source_indices = set()\n    \n    # Always include the primitive itself if it can be directly picked up (e.g., items on ground)\n    if primitive_item_idx in world.grabbable_indices:\n        source_indices.add(primitive_item_idx)\n\n    item_name = world.cookbook.index.get(primitive_item_idx)\n    if item_name == 'water':\n        # Check if water_index exists on world object, as it might not always be defined.\n        if hasattr(world, 'water_index'): \n            source_indices.add(world.water_index) # Add water block index for harvesting water\n    elif item_name == 'stone':\n        if hasattr(world, 'stone_index'):\n            source_indices.add(world.stone_index) # Add stone block index for harvesting stone\n    # Extend this logic for other harvestable primitives if needed, e.g., 'wood' from 'tree'\n    # if item_name == 'wood':\n    #     if hasattr(world, 'tree_index'):\n    #         source_indices.add(world.tree_index)\n            \n    return source_indices\n\n  # --- Start of main collect_v2 logic ---\n  \n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Convert position numpy array to tuple for hashing in sets/dictionaries.\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  # Current direction is a one-hot array, convert to an integer (0=N, 1=E, 2=S, 3=W)\n  current_dir = np.argmax(obs['features_dict']['direction'])\n  \n  world = env.world\n  # non_grabbable_indices are assumed to be obstacles that cannot be traversed by the agent.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape # Grid dimensions\n\n  # 1. Determine traversable cells (vectorized for performance)\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  # Create a boolean mask indicating if each kind is a non-grabbable obstacle.\n  is_obstacle_kind = np.isin(np.arange(K), list(non_grabbable_indices))\n  \n  # Check if any non-grabbable item is present in each grid cell.\n  # Summing (grid > 0) checks presence; sum > 0 means at least one obstacle.\n  # Use .any(axis=-1) to check if any obstacle kind is present in the last dimension.\n  has_obstacle = (grid[:, :, is_obstacle_kind] > 0).any(axis=-1)\n  \n  # Traversable cells are those that do NOT have an obstacle.\n  traversable_mask = ~has_obstacle\n  \n  # If the agent starts on an untraversable cell, no path is possible.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] \n\n  # 2. Identify all (agent_pos, agent_dir) states from which the USE action is possible.\n  # These are the states where the cell directly in front of the agent contains a source of the primitive.\n  target_pickup_states = set() # Stores elements as ((agent_x, agent_y), agent_direction)\n\n  primitive_source_indices = _get_primitive_source_indices(primitive, world)\n\n  # If no known source indices for the primitive, it's uncollectable.\n  if not primitive_source_indices:\n      return []\n\n  # Iterate through every possible agent position on the grid\n  for x in range(W):\n      for y in range(H):\n          if not traversable_mask[x, y]: # Agent must be on a traversable cell to potentially USE an item\n              continue\n          \n          # For each traversable agent position, iterate through all 4 possible facing directions\n          for agent_dir in range(4): \n              dx_fwd, dy_fwd = DIRECTION_TO_FACING_DELTA[agent_dir] # Delta for the cell in front\n              faced_x, faced_y = x + dx_fwd, y + dy_fwd\n\n              # Check if the cell being faced is within grid bounds\n              if not (0 <= faced_x < W and 0 <= faced_y < H):\n                  continue\n              \n              # Check if the faced cell contains any of the identified primitive source kinds\n              # Use np.any() with boolean indexing for efficiency.\n              if np.any(grid[faced_x, faced_y, list(primitive_source_indices)] > 0):\n                  target_pickup_states.add(((x, y), agent_dir))\n  \n  # If no valid pickup states are found anywhere on the map, the primitive is unreachable.\n  if not target_pickup_states:\n      return [] \n\n  # 3. Perform a Breadth-First Search (BFS) to find the shortest sequence of actions\n  #    to reach any of the `target_pickup_states`.\n  # Queue stores (current_position_tuple, current_direction_int, list_of_actions_so_far)\n  q = deque([(current_pos, current_dir, [])])\n  \n  # Visited states are (position_tuple, direction_integer) to prevent redundant exploration and cycles.\n  visited = {(current_pos, current_dir)} \n\n  while q:\n      curr_pos, curr_dir, path_so_far = q.popleft()\n\n      # If the current agent state (position and direction) is one of our target pickup states,\n      # we have found the shortest path.\n      if (curr_pos, curr_dir) in target_pickup_states:\n          return path_so_far + [USE_ACTION] # Append the USE action and return the full path\n\n      # Explore possible actions (movement, which also implicitly handles turning)\n      for action_val, (dx, dy) in MOVEMENT_DELTAS.items():\n          next_pos_x, next_pos_y = curr_pos[0] + dx, curr_pos[1] + dy\n          # The agent's direction changes to match the direction of the movement action.\n          next_dir = ACTION_TO_NEW_DIRECTION[action_val] \n\n          next_pos = (next_pos_x, next_pos_y)\n\n          # Determine the new state based on whether the movement is blocked or successful.\n          # CraftWorld rule: If a movement action is blocked, agent stays at current pos\n          # but still changes its facing direction.\n          if (0 <= next_pos_x < W and 0 <= next_pos_y < H and\n              traversable_mask[next_pos_x, next_pos_y]):\n              # Successful move to a new traversable cell\n              state_after_action = (next_pos, next_dir)\n              \n          else: \n              # Blocked move: agent stays at curr_pos but changes direction\n              state_after_action = (curr_pos, next_dir)\n\n          # Add the new state to the queue if it hasn't been visited before\n          if state_after_action not in visited:\n              visited.add(state_after_action)\n              q.append((state_after_action[0], state_after_action[1], path_so_far + [action_val]))\n\n  return [] # If the queue becomes empty and no target state was reached, the primitive is unreachable.", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:35:30.384895", "function_name": "collect", "function_body": "    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    current_pos = tuple(obs['features_dict']['pos'].astype(int))\n    inventory = obs['features_dict']['inventory']\n\n    # If the primitive is already in the inventory, no actions are needed.\n    if inventory[primitive] > 0:\n        return []\n\n    # Constants for actions (assuming these are globally defined or accessible)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Map (dr, dc) to action (assuming these are globally defined or accessible)\n    MOVE_DELTAS = [\n        (1, 0),  # DOWN\n        (-1, 0), # UP\n        (0, -1), # LEFT\n        (0, 1),  # RIGHT\n    ]\n    ACTION_MAP = {\n        (1, 0): ACTION_DOWN,\n        (-1, 0): ACTION_UP,\n        (0, -1): ACTION_LEFT,\n        (0, 1): ACTION_RIGHT,\n    }\n\n    # Helper function to check if a cell is traversable\n    # Assumes non_grabbable_indices is available from env.world.non_grabbable_indices\n    def _is_traversable(r, c):\n        if not (0 <= r < grid.shape[0] and 0 <= c < grid.shape[1]):\n            return False  # Out of bounds\n        # A cell is not traversable if it contains any non-grabbable entity\n        # non_grabbable_indices is part of CraftWorld data attributes\n        non_grabbable_indices = env.world.non_grabbable_indices\n        for k_idx in non_grabbable_indices:\n            if grid[r, c, k_idx] == 1:\n                return False\n        return True\n\n    # Helper function to identify target cells\n    # Target cells are any cells within a 3x3 neighborhood of a primitive,\n    # as the 'USE' action operates on nearby entities (CraftState.next_to logic).\n    def _get_target_cells_for_primitive(primitive_idx):\n        target_locations = set()\n        grid_height, grid_width, _ = grid.shape\n\n        # Find all cells containing the primitive\n        primitive_coords = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n        # For each primitive location, add its 3x3 neighborhood to potential agent standing locations\n        for pr, pc in primitive_coords:\n            for dr_neigh in [-1, 0, 1]:\n                for dc_neigh in [-1, 0, 1]:\n                    nr, nc = pr + dr_neigh, pc + dc_neigh\n                    # Only consider traversable locations for the agent to stand on\n                    if _is_traversable(nr, nc):\n                        target_locations.add((nr, nc))\n        return target_locations\n\n    target_cells = _get_target_cells_for_primitive(primitive)\n\n    # If no primitive is found on the grid or no traversable target cells, return an empty path\n    if not target_cells:\n        return []\n\n    # BFS for shortest path\n    q = collections.deque([(current_pos[0], current_pos[1], [])])  # (r, c, path_actions)\n    visited = {current_pos}\n\n    while q:\n        r, c, path = q.popleft()\n\n        # If the current cell is one of the target cells, we have found a valid position\n        # from which to use the primitive.\n        if (r, c) in target_cells:\n            return path + [ACTION_USE]\n\n        # Explore neighbors\n        for dr, dc in MOVE_DELTAS:\n            nr, nc = r + dr, c + dc\n            if _is_traversable(nr, nc) and (nr, nc) not in visited:\n                visited.add((nr, nc))\n                q.append((nr, nc, path + [ACTION_MAP[(dr, dc)]]))\n\n    # If the queue becomes empty and no path to a target cell was found\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:35:31.391908", "function_name": "collect", "function_body": "  import collections\n\n  # Actions constants as per problem description\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Get initial state information from the environment\n  obs = env.observations()\n  current_state_dict = obs['features_dict']\n  grid = current_state_dict['features_global']\n  initial_pos = tuple(current_state_dict['pos'])  # Agent's initial (row, col)\n  # Agent's initial direction: 0=N, 1=E, 2=S, 3=W\n  initial_dir = np.argmax(current_state_dict['direction'])\n  inventory = current_state_dict['inventory']\n\n  # Grid dimensions (WIDTH, HEIGHT) correspond to (rows, cols) of the grid array\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # 1. Check if the primitive is already collected\n  if inventory[primitive] > 0:\n    return []\n\n  # Helper: Map direction (0-3) to (delta_row, delta_col) for moving 'UP' (forward)\n  # N (0): row decreases, col same\n  # E (1): row same, col increases\n  # S (2): row increases, col same\n  # W (3): row same, col decreases\n  dir_to_delta = {\n      0: (-1, 0),\n      1: (0, 1),\n      2: (1, 0),\n      3: (0, -1)\n  }\n\n  # BFS setup\n  # Queue stores tuples: ((row, col), current_direction, list_of_actions_taken)\n  q = collections.deque([(initial_pos, initial_dir, [])])\n  # Visited set stores tuples: ((row, col), current_direction) to avoid cycles and redundant paths\n  visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n  while q:\n    (r, c), current_dir, path_actions = q.popleft()\n\n    # 2. Check if the current state is a goal state (i.e., primitive is in front)\n    # Calculate the cell in front of the agent\n    fwd_dr, fwd_dc = dir_to_delta[current_dir]\n    fwd_r, fwd_c = r + fwd_dr, c + fwd_dc\n\n    # Ensure the forward cell is within grid boundaries\n    if 0 <= fwd_r < GRID_ROWS and 0 <= fwd_c < GRID_COLS:\n      # Check if the primitive is located in the cell directly in front\n      if grid[fwd_r, fwd_c, primitive] > 0:\n        # Goal reached: primitive is in front. Append USE action and return the path.\n        final_actions = list(path_actions) + [USE]\n        return final_actions\n\n    # 3. Explore possible next states (actions: UP, LEFT, RIGHT)\n    # The 'DOWN' action is usually for moving backward or crouching, not typically used for collection.\n\n    # Try moving UP (forward)\n    next_r_up, next_c_up = r + fwd_dr, c + fwd_dc\n    if 0 <= next_r_up < GRID_ROWS and 0 <= next_c_up < GRID_COLS:\n      if (next_r_up, next_c_up, current_dir) not in visited:\n        visited.add((next_r_up, next_c_up, current_dir))\n        q.append(((next_r_up, next_c_up), current_dir, path_actions + [UP]))\n\n    # Try turning LEFT\n    next_dir_left = (current_dir + 3) % 4  # (current_dir - 1 + 4) % 4\n    if (r, c, next_dir_left) not in visited:\n      visited.add((r, c, next_dir_left))\n      q.append(((r, c), next_dir_left, path_actions + [LEFT]))\n\n    # Try turning RIGHT\n    next_dir_right = (current_dir + 1) % 4\n    if (r, c, next_dir_right) not in visited:\n      visited.add((r, c, next_dir_right))\n      q.append(((r, c), next_dir_right, path_actions + [RIGHT]))\n\n  # If the BFS completes and no path to collect the primitive is found\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:36:33.658235", "function_name": "collect", "function_body": "  # Constants for actions\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVES = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # Offsets for checking the 3x3 neighborhood around the agent's position for the 'USE' action.\n  # This includes (0,0) for the agent's current cell itself.\n  NEIGHBORHOOD_OFFSETS = [\n      (dx, dy) for dx in [-1, 0, 1] for dy in [-1, 0, 1]\n  ]\n\n  # Retrieve current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  # Convert agent's position from numpy array to a tuple for use as dictionary keys/set elements in BFS.\n  current_agent_pos_tuple = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  world = env.world\n  cookbook_index = world.cookbook.index\n  # Indices of entities that cannot be traversed (obstacles like water blocks, stone walls, workshops).\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape # Grid dimensions (Width, Height, Number of Kinds)\n\n  # --- Determine Traversable Cells ---\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  # `is_obstacle_kind` is a boolean mask indicating which kind indices correspond to obstacles.\n  is_obstacle_kind = np.isin(np.arange(K), list(non_grabbable_indices))\n  \n  # `has_obstacle[x, y]` is True if grid cell (x, y) contains any obstacle kind.\n  has_obstacle = (grid[:, :, is_obstacle_kind] > 0).any(axis=-1)\n  \n  # `traversable_mask[x, y]` is True if grid cell (x, y) can be moved into by the agent.\n  traversable_mask = ~has_obstacle\n  \n  # If the agent starts on an untraversable cell, no path is possible.\n  if not traversable_mask[current_agent_pos_tuple[0], current_agent_pos_tuple[1]]:\n      return [] \n\n  # --- Identify Target Grid Kinds for Collection ---\n  # These are the indices of blocks/items on the grid that, if present\n  # in the 3x3 neighborhood of the agent, allow the 'USE' action to collect\n  # the 'primitive' item.\n  \n  # Always include the primitive item itself. If it's on the ground, 'USE' can pick it up.\n  target_collectible_grid_kinds = {primitive} \n\n  # Check for specific environmental blocks that yield the primitive item when 'USE'd.\n  primitive_name = cookbook_index.get(primitive)\n  if primitive_name == 'water' and world.water_index is not None:\n      target_collectible_grid_kinds.add(world.water_index) # Add water block as a source\n  elif primitive_name == 'stone' and world.stone_index is not None:\n      target_collectible_grid_kinds.add(world.stone_index) # Add stone block as a source\n  # Extend with more mappings here if other primitives require specific source blocks\n  # (e.g., 'wood' from a 'tree' block, if such an index exists in the world configuration).\n\n  # --- Breadth-First Search (BFS) for Shortest Path ---\n  # The BFS finds the shortest path for the agent to reach any position\n  # from which it can successfully 'USE' to collect the target primitive.\n  \n  from collections import deque\n  q = deque([current_agent_pos_tuple]) \n  # `parent` dictionary stores (previous_position, action_to_reach_current_position).\n  # This dictionary also implicitly serves as the `visited` set for BFS.\n  parent = {current_agent_pos_tuple: (None, None)} \n  \n  found_target_agent_pos = None # Stores the first valid collection position found by BFS.\n\n  while q:\n      curr_agent_x, curr_agent_y = q.popleft()\n      curr_agent_pos = (curr_agent_x, curr_agent_y)\n\n      # Check if the current agent position allows for collection.\n      # This means checking if any of the `target_collectible_grid_kinds` are present\n      # in the 3x3 neighborhood of the agent's `curr_agent_pos`.\n      can_collect_from_here = False\n      for target_kind_idx in target_collectible_grid_kinds:\n          for dx, dy in NEIGHBORHOOD_OFFSETS:\n              neighbor_x, neighbor_y = curr_agent_x + dx, curr_agent_y + dy\n              \n              # Check bounds for the neighboring cell before accessing the grid.\n              if (0 <= neighbor_x < W and 0 <= neighbor_y < H):\n                  # If the neighboring cell contains the target kind, this is a valid collection point.\n                  if grid[neighbor_x, neighbor_y, target_kind_idx] > 0:\n                      can_collect_from_here = True\n                      break # Found a suitable target kind in the neighborhood, no need to check further offsets.\n          if can_collect_from_here:\n              break # No need to check other target kinds if one is found.\n\n      if can_collect_from_here:\n          found_target_agent_pos = curr_agent_pos\n          break # Shortest path to a suitable collection location found, terminate BFS.\n      \n      # Explore adjacent traversable cells for the agent's next move.\n      for action, (dx, dy) in MOVES.items():\n          next_agent_x, next_agent_y = curr_agent_x + dx, curr_agent_y + dy\n          next_agent_pos = (next_agent_x, next_agent_y)\n\n          # Ensure next position is within bounds, traversable, and not yet visited.\n          if (0 <= next_agent_x < W and 0 <= next_agent_y < H and\n              traversable_mask[next_agent_x, next_agent_y] and\n              next_agent_pos not in parent):\n              \n              parent[next_agent_pos] = (curr_agent_pos, action) # Record path\n              q.append(next_agent_pos) # Add to queue for further exploration\n  \n  # If no path to a collection point was found, return an empty list of actions.\n  if found_target_agent_pos is None:\n      return [] \n  \n  # --- Reconstruct the Path ---\n  # Traverse backward from the `found_target_agent_pos` to the `current_agent_pos_tuple`\n  # using the `parent` links to build the movement path.\n  path_actions = []\n  node = found_target_agent_pos\n  while node != current_agent_pos_tuple:\n      # Retrieve the previous position and the action taken to reach the current `node`.\n      prev_node, action_to_reach_node = parent[node]\n      path_actions.append(action_to_reach_node)\n      node = prev_node\n  \n  path_actions.reverse() # Reverse the list to get actions in correct chronological order.\n  \n  # --- Append the 'USE' Action ---\n  # Once the agent has moved to the `found_target_agent_pos`,\n  # the 'USE' action is required to acquire the primitive item.\n  path_actions.append(USE)\n  \n  return path_actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:36:34.659859", "function_name": "collect", "function_body": "  # --- 1. Define Action Constants and Movement Vectors ---\n  # These constants map action names to their integer representations.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Maps movement actions to their corresponding (dx, dy) changes on the grid.\n  MOVES = {\n      UP: (0, -1),   # Moving UP decreases Y-coordinate\n      DOWN: (0, 1),  # Moving DOWN increases Y-coordinate\n      LEFT: (-1, 0), # Moving LEFT decreases X-coordinate\n      RIGHT: (1, 0), # Moving RIGHT increases X-coordinate\n  }\n\n  # Offsets for checking the 3x3 neighborhood around the agent's position.\n  # The 'USE' action can interact with any block within this area, including the agent's own cell.\n  NEIGHBORHOOD_OFFSETS = [\n      (dx, dy) for dx in [-1, 0, 1] for dy in [-1, 0, 1]\n  ]\n\n  # --- 2. Retrieve Current State Information from the Environment ---\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Convert the agent's current position to a tuple of integers.\n  # The 'pos' from 'features_dict' might be a normalized float array.\n  current_agent_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  world = env.world # Reference to the CraftWorld instance for world configuration.\n  \n  # Indices of entities that cannot be traversed by the agent (e.g., water blocks, stone walls, workshops).\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape # Grid dimensions: Width, Height, Number of Kinds (items/blocks).\n\n  # --- 3. Determine Traversable Cells on the Grid ---\n  # A cell is traversable if it does not contain any obstacles (non-grabbable items).\n  \n  # Create a boolean mask where True indicates that a kind index corresponds to an obstacle.\n  is_obstacle_kind_mask = np.isin(np.arange(K), list(non_grabbable_indices))\n  \n  # For each cell (x, y), check if any obstacle kind is present (count > 0).\n  # `grid[:, :, is_obstacle_kind_mask]` selects slices for obstacle kinds.\n  # `.any(axis=-1)` checks if any of these obstacle kinds have a count > 0 in that cell.\n  has_obstacle_in_cell = (grid[:, :, is_obstacle_kind_mask] > 0).any(axis=-1)\n  \n  # The traversable mask is the inverse: cells without obstacles are traversable.\n  traversable_mask = ~has_obstacle_in_cell\n  \n  # Check if the agent's starting position is traversable. If not, no path is possible.\n  if not traversable_mask[current_agent_pos[0], current_agent_pos[1]]:\n      return [] \n\n  # --- 4. Identify Target Grid Indices for Collection ---\n  # These are the integer IDs of the items or source blocks on the grid that,\n  # if found in the agent's 3x3 neighborhood, allow the 'USE' action to collect the 'primitive'.\n  \n  # Always include the primitive item itself. If it's lying on the ground, 'USE' picks it up.\n  target_collect_block_indices = {primitive} \n\n  # Add specific source blocks for certain primitives (e.g., water from a water block).\n  primitive_name = world.cookbook.index.get(primitive)\n  \n  # Check for explicit water block index, ensuring it exists in the world configuration.\n  if primitive_name == 'water' and hasattr(world, 'water_index') and world.water_index is not None:\n      target_collect_block_indices.add(world.water_index) \n      \n  # Check for explicit stone block index, ensuring it exists in the world configuration.\n  if primitive_name == 'stone' and hasattr(world, 'stone_index') and world.stone_index is not None:\n      target_collect_block_indices.add(world.stone_index) \n      \n  # Add more such mappings here if other primitives require specific source blocks.\n  # Example: if 'wood' is collected from a 'tree_block_index', you'd add:\n  # if primitive_name == 'wood' and hasattr(world, 'tree_block_index') and world.tree_block_index is not None:\n  #     target_collect_block_indices.add(world.tree_block_index)\n\n  # --- 5. Breadth-First Search (BFS) for Shortest Path to a Collection Point ---\n  # The BFS aims to find the shortest sequence of movement actions for the agent\n  # to reach any position from which it can successfully 'USE' to collect the target primitive.\n  \n  from collections import deque # Ensure deque is imported\n  q = deque([current_agent_pos]) \n  # The `parent` dictionary stores (previous_position, action_taken_to_reach_current_position).\n  # It also implicitly serves as the `visited` set for BFS, preventing cycles and redundant exploration.\n  parent = {current_agent_pos: (None, None)} \n  \n  found_target_agent_pos = None # This will store the first valid collection agent position found by BFS.\n\n  while q:\n      curr_agent_x, curr_agent_y = q.popleft()\n      curr_agent_pos = (curr_agent_x, curr_agent_y)\n\n      # Check if the current agent position allows collection of the primitive.\n      # This means checking if any of the `target_collect_block_indices` are present\n      # in the 3x3 neighborhood around `curr_agent_pos`.\n      is_valid_collection_location = False\n      for target_block_idx in target_collect_block_indices:\n          for dx, dy in NEIGHBORHOOD_OFFSETS:\n              neighbor_x, neighbor_y = curr_agent_x + dx, curr_agent_y + dy\n              \n              # Check if the neighboring cell is within grid boundaries.\n              if (0 <= neighbor_x < W and 0 <= neighbor_y < H):\n                  # If the neighboring cell contains the target block/item,\n                  # then `curr_agent_pos` is a valid location from which to 'USE'.\n                  if grid[neighbor_x, neighbor_y, target_block_idx] > 0:\n                      is_valid_collection_location = True\n                      break # Found a suitable target block in the neighborhood, no need to check more offsets\n          if is_valid_collection_location:\n              break # Found a reason `curr_agent_pos` is a target, no need to check other `target_block_indices`\n\n      if is_valid_collection_location:\n          found_target_agent_pos = curr_agent_pos\n          break # Shortest path to a suitable collection location found, terminate BFS.\n      \n      # Explore adjacent traversable cells for the agent's next move.\n      for action, (dx, dy) in MOVES.items():\n          next_agent_x, next_agent_y = curr_agent_x + dx, curr_agent_y + dy\n          next_agent_pos = (next_agent_x, next_agent_y)\n\n          # Ensure the next position is within grid bounds, is traversable, and has not been visited yet.\n          if (0 <= next_agent_x < W and 0 <= next_agent_y < H and\n              traversable_mask[next_agent_x, next_agent_y] and\n              next_agent_pos not in parent):\n              \n              parent[next_agent_pos] = (curr_agent_pos, action) # Record the path taken to reach `next_agent_pos`.\n              q.append(next_agent_pos) # Add the new position to the queue for further exploration.\n  \n  # If `found_target_agent_pos` is still None after BFS, it means no path to a collection point was found.\n  if found_target_agent_pos is None:\n      return [] \n  \n  # --- 6. Reconstruct the Path from Target to Start ---\n  # Trace back from the `found_target_agent_pos` to the `current_agent_pos` using the `parent` dictionary.\n  path_movement_actions = []\n  node = found_target_agent_pos\n  while node != current_agent_pos:\n      # Retrieve the previous position and the action that was taken to reach the current `node`.\n      prev_node, action_to_reach_node = parent[node]\n      path_movement_actions.append(action_to_reach_node)\n      node = prev_node\n  \n  # Reverse the list of actions to get them in chronological order (from start to target).\n  path_movement_actions.reverse() \n  \n  # --- 7. Append the 'USE' Action ---\n  # After all movement actions are performed to reach the collection point,\n  # the 'USE' action is necessary to acquire the primitive.\n  path_movement_actions.append(USE)\n  \n  return path_movement_actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:37:53.361453", "function_name": "collect", "function_body": "  import collections\n  # numpy is already imported globally as np, so no need to import it inside again.\n\n  # Action constants (reinterpreted based on common DMLab/MiniGrid conventions\n  # for environments with an agent direction)\n  # Assuming these integer values correspond to the described actions:\n  ACTION_DOWN = 0   # Move Backward (relative to current direction)\n  ACTION_UP = 1     # Move Forward (relative to current direction)\n  ACTION_LEFT = 2   # Turn Left (changes agent's direction)\n  ACTION_RIGHT = 3  # Turn Right (changes agent's direction)\n  ACTION_USE = 4    # Use/interact with the cell directly in front\n\n  # Direction constants (standard for 2D grid worlds: North, East, South, West)\n  NORTH = 0\n  EAST = 1\n  SOUTH = 2\n  WEST = 3\n\n  # Delta for moving one step in each cardinal direction (relative to the grid)\n  DIR_TO_DELTA = {\n      NORTH: (0, -1),  # (dx, dy) for moving North\n      EAST: (1, 0),    # (dx, dy) for moving East\n      SOUTH: (0, 1),   # (dx, dy) for moving South\n      WEST: (-1, 0)    # (dx, dy) for moving West\n  }\n\n  # Maps for calculating new direction after a turn\n  TURN_LEFT_MAP = {\n      NORTH: WEST,\n      EAST: NORTH,\n      SOUTH: EAST,\n      WEST: SOUTH\n  }\n  TURN_RIGHT_MAP = {\n      NORTH: EAST,\n      EAST: SOUTH,\n      SOUTH: WEST,\n      WEST: NORTH\n  }\n\n  # Improvement: Check if the primitive is already in inventory.\n  # If so, no actions are needed to collect it.\n  if env._current_state.inventory[primitive] > 0:\n    return []\n\n  # Check if the primitive is a grabbable item. If not, it cannot be \"collected\" by walking and using.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information\n  current_pos = env._current_state.pos\n  start_x, start_y = current_pos\n  initial_dir = env._current_state.dir # Agent's initial facing direction\n\n  # Get the global grid from current observations.\n  # This ensures we use the most up-to-date state of the world.\n  observations = env.observations()\n  grid = observations['features_dict']['features_global']\n  grid_width, grid_height = grid.shape[0], grid.shape[1]\n\n  # Determine which entities block movement.\n  # Non-grabbable items typically act as obstacles, except for workshops which are destinations.\n  blocker_indices = env.world.non_grabbable_indices - set(env.world.workshop_indices)\n\n  def is_passable(x, y):\n    \"\"\"Checks if a given cell (x, y) is within bounds and does not contain blocking entities.\"\"\"\n    # Check grid bounds\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell contains any blocking entity\n    for blocker_idx in blocker_indices:\n      if grid[x, y, blocker_idx] == 1:\n        return False # This cell contains an unpassable obstacle\n    return True # Cell is passable\n\n  # Perform Breadth-First Search (BFS)\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_to_reach_here)\n  queue = collections.deque([(start_x, start_y, initial_dir, [])])\n  # Set to keep track of visited states (x, y, direction) to avoid cycles and redundant paths\n  visited = set([(start_x, start_y, initial_dir)])\n\n  while queue:\n    cx, cy, c_dir, current_path = queue.popleft()\n\n    # --- Goal Check ---\n    # Calculate the coordinates of the cell directly in front of the agent.\n    # This is where the ACTION_USE would be applied.\n    f_dx, f_dy = DIR_TO_DELTA[c_dir]\n    target_x, target_y = cx + f_dx, cy + f_dy\n\n    # If the cell in front is within bounds and contains the primitive, we've found our path.\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive] == 1):\n      return current_path + [ACTION_USE] # Append USE action and return path\n\n    # --- Explore Possible Next States (Actions) ---\n\n    # 1. Try moving forward (ACTION_UP)\n    move_dx, move_dy = DIR_TO_DELTA[c_dir]\n    nx_fwd, ny_fwd = cx + move_dx, cy + move_dy\n    next_dir_fwd = c_dir\n\n    if is_passable(nx_fwd, ny_fwd) and (nx_fwd, ny_fwd, next_dir_fwd) not in visited:\n      visited.add((nx_fwd, ny_fwd, next_dir_fwd))\n      queue.append((nx_fwd, ny_fwd, next_dir_fwd, current_path + [ACTION_UP]))\n\n    # 2. Try moving backward (ACTION_DOWN)\n    # The opposite direction can be found by (current_direction + 2) % 4 for standard N,E,S,W = 0,1,2,3.\n    opposite_dir = (c_dir + 2) % 4\n    move_dx, move_dy = DIR_TO_DELTA[opposite_dir]\n    nx_bwd, ny_bwd = cx + move_dx, cy + move_dy\n    next_dir_bwd = c_dir # Direction doesn't change on backward move\n\n    if is_passable(nx_bwd, ny_bwd) and (nx_bwd, ny_bwd, next_dir_bwd) not in visited:\n      visited.add((nx_bwd, ny_bwd, next_dir_bwd))\n      queue.append((nx_bwd, ny_bwd, next_dir_bwd, current_path + [ACTION_DOWN]))\n\n    # 3. Try turning left (ACTION_LEFT)\n    nx_turn_l, ny_turn_l = cx, cy\n    next_dir_l = TURN_LEFT_MAP[c_dir]\n\n    if (nx_turn_l, ny_turn_l, next_dir_l) not in visited:\n      visited.add((nx_turn_l, ny_turn_l, next_dir_l))\n      queue.append((nx_turn_l, ny_turn_l, next_dir_l, current_path + [ACTION_LEFT]))\n\n    # 4. Try turning right (ACTION_RIGHT)\n    nx_turn_r, ny_turn_r = cx, cy\n    next_dir_r = TURN_RIGHT_MAP[c_dir]\n\n    if (nx_turn_r, ny_turn_r, next_dir_r) not in visited:\n      visited.add((nx_turn_r, ny_turn_r, next_dir_r))\n      queue.append((nx_turn_r, ny_turn_r, next_dir_r, current_path + [ACTION_RIGHT]))\n\n  # If the BFS completes and no path to any target primitive was found\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:37:54.362441", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (reinterpreted based on common DMLab/MiniGrid conventions\n  # for environments with an agent direction)\n  # Assuming these integer values correspond to the described actions:\n  ACTION_DOWN = 0   # Move Backward (relative to current direction)\n  ACTION_UP = 1     # Move Forward (relative to current direction)\n  ACTION_LEFT = 2   # Turn Left (changes agent's direction)\n  ACTION_RIGHT = 3  # Turn Right (changes agent's direction)\n  ACTION_USE = 4    # Use/interact with the cell directly in front\n\n  # Direction constants (standard for 2D grid worlds: North, East, South, West)\n  NORTH = 0\n  EAST = 1\n  SOUTH = 2\n  WEST = 3\n\n  # Delta for moving one step in each cardinal direction (relative to the grid)\n  DIR_TO_DELTA = {\n      NORTH: (0, -1),  # (dx, dy) for moving North (y-axis typically inverted in grid)\n      EAST: (1, 0),    # (dx, dy) for moving East\n      SOUTH: (0, 1),   # (dx, dy) for moving South\n      WEST: (-1, 0)    # (dx, dy) for moving West\n  }\n\n  # Maps for calculating new direction after a turn\n  TURN_LEFT_MAP = {\n      NORTH: WEST,\n      EAST: NORTH,\n      SOUTH: EAST,\n      WEST: SOUTH\n  }\n  TURN_RIGHT_MAP = {\n      NORTH: EAST,\n      EAST: SOUTH,\n      SOUTH: WEST,\n      WEST: NORTH\n  }\n\n  # The main improvement in v2 is to allow 'collection' (i.e., reaching and\n  # using ACTION_USE) of any entity type, not just grabbable primitives.\n  # This means removing the check that `primitive` must be in `grabbable_indices`.\n  # For example, this would allow collecting from water, stone, or interacting\n  # with a workbench, by reaching it and using ACTION_USE.\n  # Therefore, the following check from v1 is removed:\n  # if primitive not in env.world.grabbable_indices:\n  #   return []\n\n  # Get current state information\n  current_pos = env._current_state.pos\n  start_x, start_y = current_pos\n  initial_dir = env._current_state.dir # Agent's initial facing direction\n\n  grid = env.observations()['features_dict']['features_global']\n  grid_width, grid_height = grid.shape[0], grid.shape[1]\n\n  # Determine which entities block movement.\n  # Non-grabbable items typically act as obstacles, except for workshops which are destinations.\n  # This logic remains valid: you can walk *to* a workbench, but not through solid stone/environment items.\n  blocker_indices = env.world.non_grabbable_indices - set(env.world.workshop_indices)\n\n  def is_passable(x, y):\n    \"\"\"Checks if a given cell (x, y) is within bounds and does not contain blocking entities.\"\"\"\n    # Check grid bounds\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell contains any blocking entity\n    for blocker_idx in blocker_indices:\n      if grid[x, y, blocker_idx] == 1:\n        return False # This cell contains an unpassable obstacle\n    return True # Cell is passable\n\n  # Perform Breadth-First Search (BFS)\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_to_reach_here)\n  queue = collections.deque([(start_x, start_y, initial_dir, [])])\n  # Set to keep track of visited states (x, y, direction) to avoid cycles and redundant paths\n  visited = set([(start_x, start_y, initial_dir)])\n\n  while queue:\n    cx, cy, c_dir, current_path = queue.popleft()\n\n    # --- Goal Check ---\n    # Calculate the coordinates of the cell directly in front of the agent.\n    # This is where the ACTION_USE would be applied.\n    f_dx, f_dy = DIR_TO_DELTA[c_dir]\n    target_x, target_y = cx + f_dx, cy + f_dy\n\n    # If the cell in front is within bounds and contains the desired primitive, we've found our path.\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive] == 1):\n      return current_path + [ACTION_USE] # Append USE action and return path\n\n    # --- Explore Possible Next States (Actions) ---\n\n    # 1. Try moving forward (ACTION_UP)\n    move_dx, move_dy = DIR_TO_DELTA[c_dir] # Delta based on current direction\n    nx_fwd, ny_fwd = cx + move_dx, cy + move_dy\n    next_dir_fwd = c_dir # Direction doesn't change when moving forward/backward\n\n    if is_passable(nx_fwd, ny_fwd) and (nx_fwd, ny_fwd, next_dir_fwd) not in visited:\n      visited.add((nx_fwd, ny_fwd, next_dir_fwd))\n      queue.append((nx_fwd, ny_fwd, next_dir_fwd, current_path + [ACTION_UP]))\n\n    # 2. Try moving backward (ACTION_DOWN)\n    # Moving backward is equivalent to moving forward in the opposite direction\n    # The opposite direction can be found by turning left twice or right twice.\n    # This also means the agent's internal direction state (c_dir) remains the same after moving backward.\n    opposite_dir_temp = TURN_LEFT_MAP[TURN_LEFT_MAP[c_dir]] # Temporary to calculate movement delta\n    move_dx_bwd, move_dy_bwd = DIR_TO_DELTA[opposite_dir_temp]\n    nx_bwd, ny_bwd = cx + move_dx_bwd, cy + move_dy_bwd\n    next_dir_bwd = c_dir # Agent's internal direction doesn't change when moving backward\n\n    if is_passable(nx_bwd, ny_bwd) and (nx_bwd, ny_bwd, next_dir_bwd) not in visited:\n      visited.add((nx_bwd, ny_bwd, next_dir_bwd))\n      queue.append((nx_bwd, ny_bwd, next_dir_bwd, current_path + [ACTION_DOWN]))\n\n    # 3. Try turning left (ACTION_LEFT)\n    nx_turn_l, ny_turn_l = cx, cy # Position does not change on turn\n    next_dir_l = TURN_LEFT_MAP[c_dir] # New direction after turning\n\n    if (nx_turn_l, ny_turn_l, next_dir_l) not in visited:\n      visited.add((nx_turn_l, ny_turn_l, next_dir_l))\n      queue.append((nx_turn_l, ny_turn_l, next_dir_l, current_path + [ACTION_LEFT]))\n\n    # 4. Try turning right (ACTION_RIGHT)\n    nx_turn_r, ny_turn_r = cx, cy # Position does not change on turn\n    next_dir_r = TURN_RIGHT_MAP[c_dir] # New direction after turning\n\n    if (nx_turn_r, ny_turn_r, next_dir_r) not in visited:\n      visited.add((nx_turn_r, ny_turn_r, next_dir_r))\n      queue.append((nx_turn_r, ny_turn_r, next_dir_r, current_path + [ACTION_RIGHT]))\n\n  # If the BFS completes and no path to any target primitive was found\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:40:27.526142", "function_name": "collect", "function_body": "  actions = []\n  # A safety limit for the number of steps this collection function will attempt.\n  # This prevents infinite loops if the primitive is unreachable or the logic gets stuck.\n  max_collect_steps = 500\n\n  # Check if the primitive is grabbable (picked up by simply moving onto its tile).\n  # This information is available from the CraftWorld instance within the CraftLab.\n  is_grabbable = False\n  if hasattr(env, 'world') and hasattr(env.world, 'grabbable_indices'):\n      is_grabbable = primitive in env.world.grabbable_indices\n\n  step_count = 0\n  # Keep track of visited states (position and direction) to detect and try to escape cycles.\n  visited_states = set() # Stores (x, y, dir) tuples\n\n  while True:\n      current_state = env._current_state\n      current_pos = current_state.pos\n      current_dir = current_state.dir # 0:N, 1:E, 2:S, 3:W (clockwise from North)\n\n      # Break if the environment is already \"done\" or if we've exceeded our internal step limit.\n      if env.steps >= env.max_steps or step_count >= max_collect_steps:\n          break\n\n      # Cycle detection: If we revisit a (pos, dir) state, try a corrective action or break.\n      current_state_tuple = (current_pos[0], current_pos[1], current_dir)\n      if current_state_tuple in visited_states and step_count > 0:\n          # If a cycle is detected, try to break it by turning right.\n          # This is a simple heuristic; more complex mazes might require a full pathfinder.\n          action_to_take = env_factory.RIGHT\n          _, done, _ = env.step(action_to_take)\n          actions.append(action_to_take)\n          step_count += 1\n          if done or step_count >= max_collect_steps:\n              break\n          continue # Re-evaluate state after the corrective action\n      visited_states.add(current_state_tuple)\n\n      # 1. Check if the primitive is already in the inventory.\n      if current_state.inventory[primitive] > 0:\n          break # Goal achieved, exit loop.\n\n      # 2. Handle non-grabbable primitives: If it's not grabbable, it might require a 'USE' action.\n      # This is applicable if the primitive is a resource like \"stone\", \"water\", or a \"workbench\".\n      moved_this_step = False\n      if not is_grabbable:\n          if current_state.next_to(primitive):\n              # Find the exact cardinal direction of the primitive in the neighborhood.\n              # 'USE' typically applies to adjacent cells (North, East, South, West).\n              \n              # Map (dx, dy) to cardinal directions (0:N, 1:E, 2:S, 3:W)\n              cardinal_neighbors = {\n                  (0, -1): 0, # North\n                  (1, 0): 1,  # East\n                  (0, 1): 2,  # South\n                  (-1, 0): 3  # West\n              }\n\n              target_dir_to_face = -1\n              grid_x_dim, grid_y_dim, _ = current_state.grid.shape\n              \n              for dx, dy in cardinal_neighbors.keys():\n                  nx, ny = current_pos[0] + dx, current_pos[1] + dy\n                  if 0 <= nx < grid_x_dim and 0 <= ny < grid_y_dim:\n                      if current_state.grid[nx, ny, primitive] > 0:\n                          target_dir_to_face = cardinal_neighbors[(dx, dy)]\n                          break\n              \n              if target_dir_to_face != -1: # Primitive is in a cardinal direction\n                  # Calculate turns needed to face the primitive.\n                  diff_dir = (target_dir_to_face - current_dir + 4) % 4\n                  \n                  action_to_take = None\n                  if diff_dir == 0: # Already facing the primitive\n                      action_to_take = env_factory.USE\n                  elif diff_dir == 1: # Target is to the right\n                      action_to_take = env_factory.RIGHT\n                  elif diff_dir == 3: # Target is to the left\n                      action_to_take = env_factory.LEFT\n                  elif diff_dir == 2: # Target is directly behind, turn 180 (two right turns)\n                      action_to_take = env_factory.RIGHT # Take first turn\n                      # Take the action immediately to update state, then continue loop.\n                      _, done, _ = env.step(action_to_take)\n                      actions.append(action_to_take)\n                      step_count += 1\n                      moved_this_step = True\n                      if done or step_count >= max_collect_steps:\n                          break\n                      continue # Loop again to take the second turn (if needed) or USE.\n                  \n                  if action_to_take is not None:\n                      _, done, _ = env.step(action_to_take)\n                      actions.append(action_to_take)\n                      step_count += 1\n                      moved_this_step = True\n                      if done or step_count >= max_collect_steps:\n                          break\n                      continue # Re-evaluate state after taking this action.\n\n      # 3. Find the primitive on the global grid (for general pathfinding).\n      primitive_pos_global = None\n      grid_x_dim, grid_y_dim, _ = current_state.grid.shape\n      for x in range(grid_x_dim):\n          for y in range(grid_y_dim):\n              if current_state.grid[x, y, primitive] > 0:\n                  primitive_pos_global = (x, y)\n                  break\n          if primitive_pos_global:\n              break\n      \n      # If a target primitive is found on the map and we haven't already taken a USE action.\n      if not moved_this_step and primitive_pos_global:\n          target_x, target_y = primitive_pos_global\n          agent_x, agent_y = current_pos\n\n          # If the agent is on the same cell as the primitive.\n          # If it's grabbable, it should already be in inventory (goal achieved).\n          # If it's not grabbable, the 'next_to' logic above should have triggered a 'USE' action.\n          # So, if we reach this block and agent is at target, it implies a condition not handled,\n          # or the primitive requires specific interaction beyond a simple 'USE' (unlikely for \"primitive\").\n          # In such a case, fallback to general exploration.\n          if agent_x == target_x and agent_y == target_y:\n              # Fall through to general exploration.\n              pass\n          else:\n              # Move greedily towards the primitive.\n              dx_to_target = target_x - agent_x\n              dy_to_target = target_y - agent_y\n\n              action_choice = None\n              target_abs_dir = -1 # Desired absolute cardinal direction to move towards\n\n              # Prioritize moving along the axis with the largest difference.\n              if abs(dx_to_target) >= abs(dy_to_target) and dx_to_target != 0:\n                  target_abs_dir = 1 if dx_to_target > 0 else 3 # East or West\n              elif dy_to_target != 0: # Only if dx is zero or smaller\n                  target_abs_dir = 2 if dy_to_target > 0 else 0 # South or North\n              \n              if target_abs_dir != -1:\n                  # Calculate turns needed to align agent's direction with desired target direction.\n                  turns_needed = (target_abs_dir - current_dir + 4) % 4\n                  \n                  if turns_needed == 0: # Already facing the desired direction\n                      action_choice = env_factory.UP # Move forward\n                  elif turns_needed == 1: # Target is to the right\n                      action_choice = env_factory.RIGHT # Turn right\n                  elif turns_needed == 3: # Target is to the left\n                      action_choice = env_factory.LEFT # Turn left\n                  elif turns_needed == 2: # Target is behind, turn 180 (two right turns)\n                      action_choice = env_factory.RIGHT # Take first turn\n                      # Take the action immediately to update state, then continue loop.\n                      _, done, _ = env.step(action_choice)\n                      actions.append(action_choice)\n                      step_count += 1\n                      moved_this_step = True\n                      if done or step_count >= max_collect_steps:\n                          break\n                      continue # Loop again to take the second turn (if needed) or move forward.\n                  \n                  if action_choice is not None:\n                      _, done, _ = env.step(action_choice)\n                      actions.append(action_choice)\n                      step_count += 1\n                      moved_this_step = True\n                      if done or step_count >= max_collect_steps:\n                          break\n                      continue # Re-evaluate state after taking this action.\n\n      # 4. General exploration strategy: If no specific target movement was made, explore.\n      # This happens if the primitive is not found on the map, or if agent is stuck, or at target but not collected.\n      if not moved_this_step:\n          # Simple \"lawnmower\" search heuristic: try moving forward.\n          # If it doesn't result in a position change (e.g., hit a wall) or after a few steps, turn right.\n          prev_pos = current_pos\n          action_to_take = env_factory.UP\n          \n          _, done, _ = env.step(action_to_take)\n          actions.append(action_to_take)\n          step_count += 1\n          \n          # Check if the agent hit a wall (position didn't change) or if it's time to turn for exploration.\n          # The modulo check encourages turning periodically even if not blocked, to explore.\n          if (env._current_state.pos == prev_pos) or (step_count % 10 == 0 and step_count > 0):\n              action_to_take = env_factory.RIGHT\n              _, done, _ = env.step(action_to_take)\n              actions.append(action_to_take)\n              step_count += 1\n          \n          if done or step_count >= max_collect_steps:\n              break\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:40:28.489307", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  pos_xy = current_state.pos # Agent's position as (x, y)\n  current_dir = current_state.dir # Agent's current facing direction (0,1,2,3 for DOWN,UP,LEFT,RIGHT)\n  inventory = current_state.inventory\n  world = env.world # CraftWorld instance\n\n  # Action constants as defined by CraftLab.action_specs\n  # (assuming these are consistent with CraftState.dir attribute values)\n  _DOWN = 0\n  _UP = 1\n  _LEFT = 2\n  _RIGHT = 3\n  _USE = 4\n\n  _MOVE_ACTIONS = [_DOWN, _UP, _LEFT, _RIGHT]\n\n  # Deltas for (row, col) corresponding to each move action / direction\n  # Assuming (row, col) corresponds to (y, x) and (0,0) is top-left\n  _MOVE_DELTAS = {\n      _UP: (-1, 0),   # Moving UP decreases row index\n      _DOWN: (1, 0),  # Moving DOWN increases row index\n      _LEFT: (0, -1), # Moving LEFT decreases col index\n      _RIGHT: (0, 1), # Moving RIGHT increases col index\n  }\n\n  # The agent's `dir` attribute is assumed to map to the same (dr, dc) deltas\n  # as the move actions that set them.\n  _DIR_TO_DELTA = _MOVE_DELTAS\n\n  # 1. Check if primitive is already in inventory\n  if inventory[primitive] > 0:\n      return []\n\n  # 2. Check if the primitive is grabbable at all\n  # world.grabbable_indices is a list, check membership\n  if primitive not in world.grabbable_indices:\n      return []\n\n  # Grid dimensions: (WIDTH, HEIGHT, N_KINDS)\n  # Where WIDTH is X_DIM (columns), HEIGHT is Y_DIM (rows)\n  grid_X_DIM = grid.shape[0]\n  grid_Y_DIM = grid.shape[1]\n  \n  # Convert agent's position from (x, y) to (row, col) for internal BFS use\n  # (x, y) maps to (col, row) in a typical 2D array, so (pos_xy[0], pos_xy[1])\n  # but since we are using (row, col) internally where row is y and col is x,\n  # agent_row = pos_xy[1] (y-coordinate)\n  # agent_col = pos_xy[0] (x-coordinate)\n  agent_row, agent_col = pos_xy[1], pos_xy[0]\n\n  # 3. Find all locations of the grabbable primitive on the grid\n  primitive_locations = set() # Use a set for faster lookup\n  for x_coord in range(grid_X_DIM): # Iterate through columns (x-coordinates)\n      for y_coord in range(grid_Y_DIM): # Iterate through rows (y-coordinates)\n          if grid[x_coord, y_coord, primitive] == 1:\n              # Store as (row, col) which is (y, x)\n              primitive_locations.add((y_coord, x_coord)) \n\n  if not primitive_locations:\n      return [] # Primitive not found on grid\n\n  # BFS state: (row, col, facing_dir_value, path_so_far)\n  # path_so_far stores the list of actions taken to reach this state\n  queue = collections.deque([(agent_row, agent_col, current_dir, [])])\n  # Visited set: (row, col, facing_dir_value) to avoid cycles and redundant paths\n  visited = {(agent_row, agent_col, current_dir)}\n\n  while queue:\n      r, c, current_face_dir, path_actions = queue.popleft()\n\n      # Check if current position and direction allow using the primitive\n      dr_face, dc_face = _DIR_TO_DELTA[current_face_dir]\n      target_r, target_c = r + dr_face, c + dc_face\n\n      # Check if the target cell (where agent would USE) is within grid bounds\n      if 0 <= target_r < grid_Y_DIM and 0 <= target_c < grid_X_DIM:\n          # If the target cell contains the primitive, we found a solution\n          if (target_r, target_c) in primitive_locations:\n              return path_actions + [_USE]\n\n      # Explore possible moves from current state\n      for move_action in _MOVE_ACTIONS:\n          dr_move, dc_move = _MOVE_DELTAS[move_action]\n          \n          next_r, next_c = r + dr_move, c + dc_move\n          next_face_dir = move_action # Agent's facing direction becomes the direction of the last move\n\n          # Check if the next position is within grid bounds\n          if not (0 <= next_r < grid_Y_DIM and 0 <= next_c < grid_X_DIM):\n              continue\n\n          # Check if this (position, direction) state has been visited\n          if (next_r, next_c, next_face_dir) in visited:\n              continue\n\n          # Check for impassable cells (environment objects)\n          # Note: grid access is (x, y, kind) which is (col, row, kind)\n          is_impassable = False\n          for kind_idx in world.environment:\n              if grid[next_c, next_r, kind_idx] == 1:\n                  is_impassable = True\n                  break\n          if is_impassable:\n              continue\n          \n          # Prevent moving directly onto a grabbable primitive.\n          # We need to be adjacent to it, not occupy its space.\n          if (next_r, next_c) in primitive_locations:\n              continue\n\n          # Add the new state to the queue and mark as visited\n          visited.add((next_r, next_c, next_face_dir))\n          queue.append((next_r, next_c, next_face_dir, path_actions + [move_action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:41:18.008512", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants for readability, consistent with CraftLab.action_specs\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement actions to (dx, dy) coordinate changes\n  _MOVE_ACTION_TO_COORD_DIFF = {\n      ACTION_DOWN: (0, 1),  # Y increases (down)\n      ACTION_UP: (0, -1), # Y decreases (up)\n      ACTION_LEFT: (-1, 0), # X decreases (left)\n      ACTION_RIGHT: (1, 0)  # X increases (right)\n  }\n\n  # 1. Get the integer index for the given primitive name from the cookbook's index.\n  # The .index() method handles adding the primitive if it's new.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Perform essential pre-checks to determine if collection is even possible or necessary.\n  current_state = env._current_state\n  \n  # If the primitive is not designated as \"grabbable\", it cannot be collected using the USE action.\n  if primitive_idx not in env.world.grabbable_indices:\n    return [] \n\n  # If the agent already possesses at least one unit of the primitive, no actions are needed.\n  if current_state.inventory[primitive_idx] > 0:\n    return [] \n\n  # 3. Retrieve necessary grid dimensions and non-grabbable items for pathfinding.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices # A set for efficient lookup\n\n  # Helper function to determine if a given grid cell (x, y) is traversable.\n  # A cell is not traversable if it's out of bounds or contains any non-grabbable item.\n  def _is_traversable(x, y):\n    # Check if coordinates are within grid boundaries\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell contains any item that acts as an obstacle (e.g., a wall, a crafting table)\n    # This assumes items in non_grabbable_indices block movement.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] > 0: # If this kind of item exists at (x, y)\n        return False # The cell is blocked\n    return True # The cell is traversable\n\n  # 4. Initialize Breadth-First Search (BFS) for shortest pathfinding.\n  # The BFS state is represented as ((x, y), direction) to account for agent orientation.\n  # `path_trace` stores the parent state and the action taken to reach the current state,\n  # allowing for path reconstruction once the target is found.\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  queue = collections.deque([(start_pos, start_dir)]) \n  path_trace = {(start_pos, start_dir): (None, None)} # Parent of the start state is None\n\n  target_collect_state = None # Placeholder for the state from which the primitive can be collected\n\n  # 5. BFS Loop: Explore states layer by layer to find the shortest path.\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.popleft() \n\n    # First, check if the primitive is directly in front of the agent in the current state,\n    # meaning it can be collected by executing the USE action.\n    dx_facing, dy_facing = _MOVE_ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_facing, curr_y + dy_facing\n\n    # If the cell in front exists within the grid and contains the primitive:\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      target_collect_state = ((curr_x, curr_y), curr_dir)\n      break # Target found, exit BFS as we've found the shortest path.\n\n    # If not at the target, explore all possible movement actions from the current state.\n    for move_action in range(4): # Iterates through ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT\n      dx_move, dy_move = _MOVE_ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # The agent's direction changes to the direction of movement\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n\n      # Check if the next position is traversable and has not been visited yet with this direction.\n      if _is_traversable(next_x, next_y) and next_state_tuple not in path_trace:\n        # Record how we reached this new state for path reconstruction.\n        path_trace[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action)\n        queue.append(next_state_tuple) # Add the new state to the queue for exploration.\n\n  # 6. Reconstruct the path of actions if a target state was found.\n  if target_collect_state is None:\n    return [] # No path found to collect the primitive.\n\n  path_actions = []\n  current_reconstruction_state = target_collect_state\n  \n  # Backtrack from the `target_collect_state` to the `start_pos` using the `path_trace` dictionary.\n  while path_trace[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = path_trace[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  path_actions.reverse() # Reverse the list to get actions in the correct chronological order.\n\n  # Append the final USE action to the path to collect the primitive.\n  return path_actions + [ACTION_USE]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:41:18.986537", "function_name": "collect", "function_body": "  import collections\n\n  # Re-defining constants for clarity within the function scope\n  # These map action indices (0-3) to (dx, dy) coordinate changes.\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # The action index for using an item\n\n  # 1. Get the integer index for the given primitive name\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Pre-checks for early exit\n  if primitive_idx not in env.world.grabbable_indices:\n    return [] \n\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] \n\n  # 3. Retrieve necessary grid and world properties for pathfinding\n  grid = current_state.grid\n  grid_width, grid_height, n_kinds = grid.shape\n  \n  # Improvement: Precompute a boolean mask for efficient checking of impassable cells.\n  # This mask will be True for indices corresponding to non-grabbable entities,\n  # allowing for a vectorized NumPy sum check instead of iterating a Python set.\n  non_grabbable_mask = np.zeros(n_kinds, dtype=bool)\n  for k_idx in env.world.non_grabbable_indices:\n      # Ensure the index is valid for the grid's third dimension\n      if 0 <= k_idx < n_kinds: \n          non_grabbable_mask[k_idx] = True\n  \n  # 4. Initialize BFS: Queue and Path Reconstruction Dictionary\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  queue = collections.deque([(start_pos, start_dir)]) \n  # path_trace stores: {current_state: (parent_state, action_taken_to_reach_current_state)}\n  path_trace = {(start_pos, start_dir): (None, None)} \n\n  target_use_state = None # To store the state from which the final USE action can be applied\n\n  # 5. BFS Loop\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.popleft() \n\n    # Check if the desired primitive is directly in front of the agent (i.e., can USE it from here).\n    dx_facing, dy_facing = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_facing, curr_y + dy_facing\n\n    # If the cell in front is within bounds and contains the primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      target_use_state = ((curr_x, curr_y), curr_dir)\n      break # Found a valid collection point, exit BFS.\n\n    # Explore all possible movement actions (0-3: DOWN, UP, LEFT, RIGHT)\n    for move_action in range(4): \n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n\n      # Check boundary conditions for the next position\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Improved impassable check:\n      # Check if the sum of all non-grabbable items in the cell is greater than 0.\n      # This means the cell contains an impassable object.\n      if np.sum(grid[next_x, next_y, non_grabbable_mask]) > 0:\n        continue \n      \n      # If this new state has not been visited yet\n      if next_state_tuple not in path_trace:\n        path_trace[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action)\n        queue.append(next_state_tuple) \n\n  # 6. Reconstruct Path\n  if target_use_state is None:\n    return [] # Primitive is unreachable\n\n  # Backtrack from the target_use_state to the start state\n  path_actions = []\n  current_reconstruction_state = target_use_state\n  \n  while path_trace[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = path_trace[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  path_actions.reverse() # Reverse to get actions in correct order\n\n  # Add the final USE action\n  return path_actions + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:42:47.303087", "function_name": "collect", "function_body": "  import collections # Using collections.deque for efficient queue operations in BFS\n\n  # Re-defining constants for clarity within the function scope, mirroring collect_v1\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 3. Retrieve grid dimensions and non-grabbable indices for boundary and impassable checks\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n  \n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    BFS state: (current_x, current_y, current_direction)\n  \n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  # Queue for BFS: stores tuples of ((x, y), direction)\n  queue = collections.deque([(start_pos, start_dir)]) \n  \n  # Dictionary to reconstruct the path: \n  # Keys are ((x, y), direction) tuples representing a state.\n  # Values are (parent_state_tuple, action_taken_to_reach_current_state).\n  # The starting state's parent info is (None, None).\n  path_trace = {(start_pos, start_dir): (None, None)} \n\n  target_use_state = None # Will store the state from which the final USE action can be applied\n\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.popleft() # Dequeue the current state\n\n    # Check if a 'USE' action is possible from this current state.\n    # This involves looking at the cell directly in front of the agent.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x_for_use, target_y_for_use = curr_x + dx_dir, curr_y + dy_dir\n\n    # If the target cell for USE is within bounds and contains the desired primitive\n    if (0 <= target_x_for_use < grid_width and 0 <= target_y_for_use < grid_height and\n        grid[target_x_for_use, target_y_for_use, primitive_idx] > 0):\n      # We've found a valid state from which the primitive can be collected.\n      target_use_state = ((curr_x, curr_y), curr_dir)\n      break # Path found, exit the BFS loop.\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # Moving changes both the agent's position and its facing direction.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to cardinal movements\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # The agent's new direction is the direction of movement\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # V2 IMPROVEMENT: A key improvement over collect_v1.\n      # In v1, the agent could path *onto* the primitive's cell if it was grabbable.\n      # However, to `USE` a primitive, the agent must be *adjacent* and *facing* it,\n      # not on the same cell. This check prevents paths that move directly onto the primitive,\n      # ensuring the agent finds a path to an adjacent 'pre-use' position.\n      is_impassable_terrain = any(grid[next_x, next_y, k_idx] > 0 for k_idx in non_grabbable_indices)\n      is_target_primitive_location = grid[next_x, next_y, primitive_idx] > 0\n\n      if is_impassable_terrain or is_target_primitive_location:\n        continue # Skip this move if the destination is impassable or contains the item we want to collect.\n      \n      # If this new state (position and direction) has not been visited yet during the BFS\n      if next_state_tuple not in path_trace: # path_trace acts as our visited set\n        # Store how we reached this new state\n        path_trace[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action)\n        queue.append(next_state_tuple) # Add the new state to the queue for further exploration\n\n  if target_use_state is None:\n    return [] # If the queue becomes empty and no path was found, the primitive is unreachable.\n\n  # Reconstruct the sequence of actions by backtracking from the `target_use_state`\n  # back to the `start_pos`/`start_dir` using the `path_trace` dictionary.\n  path_actions = []\n  current_reconstruction_state = target_use_state\n  \n  # Backtrack until we reach the starting state, which has (None, None) as its parent info\n  while path_trace[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = path_trace[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  # The path was built in reverse order (from target to start), so reverse it\n  path_actions.reverse()\n  \n  # Add the final 'USE' action to complete the collection sequence\n  return path_actions + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:42:48.305532", "function_name": "collect", "function_body": "  import collections\n\n  # Re-defining constants for clarity within the function scope\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4\n\n  # 1. Get the integer index for the given primitive name\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # V2 Improvement: Validate if the primitive is actually grabbable/collectible.\n  # If it's not in the world's grabbable indices and it's not the special 'water' item,\n  # then it cannot be collected by the standard 'USE' action.\n  grabbable_set = set(env.world.grabbable_indices)\n  \n  # Check for water_index specifically as it might be collectible but not in general grabbables.\n  # Use hasattr for robustness in case water_index is not always present.\n  water_index = env.world.water_index if hasattr(env.world, 'water_index') else -1 \n\n  if primitive_idx not in grabbable_set and primitive_idx != water_index:\n    # This item is not designated as grabbable or special collectible, so it's unreachable for 'collect'.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Retrieve grid dimensions and non-grabbable indices for boundary and impassable checks\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n  \n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  # Queue for BFS: stores tuples of ((x, y), direction)\n  queue = collections.deque([(start_pos, start_dir)]) \n  \n  # Dictionary to reconstruct the path: \n  # Keys are ((x, y), direction) tuples representing a state.\n  # Values are (parent_state_tuple, action_taken_to_reach_current_state).\n  path_trace = {(start_pos, start_dir): (None, None)} \n\n  target_use_state = None # Will store the state from which the final USE action can be applied\n\n  while queue:\n    (curr_x, curr_y), curr_dir = queue.popleft() \n\n    # Check if a 'USE' action is possible from this current state.\n    # This involves looking at the cell directly in front of the agent.\n    dx_dir, dy_dir = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_x, target_y = curr_x + dx_dir, curr_y + dy_dir\n\n    # If the target cell is within bounds and contains the desired primitive\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      # We've found a valid state from which the primitive can be collected.\n      target_use_state = ((curr_x, curr_y), curr_dir)\n      break # Path found, exit the BFS loop.\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    for move_action in range(4):\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # The agent's new direction is the direction of movement\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n\n      # Check if the next position is within the grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position is impassable (contains any non-grabbable item).\n      if any(grid[next_x, next_y, k_idx] > 0 for k_idx in non_grabbable_indices):\n        continue \n      \n      # If this new state has not been visited yet\n      if next_state_tuple not in path_trace:\n        path_trace[next_state_tuple] = (((curr_x, curr_y), curr_dir), move_action)\n        queue.append(next_state_tuple)\n\n  if target_use_state is None:\n    return [] # If no path was found, the primitive is unreachable.\n\n  # Reconstruct the sequence of actions by backtracking\n  path_actions = []\n  current_reconstruction_state = target_use_state\n  \n  while path_trace[current_reconstruction_state][0] is not None:\n    parent_state, action_from_parent = path_trace[current_reconstruction_state]\n    path_actions.append(action_from_parent)\n    current_reconstruction_state = parent_state\n  \n  path_actions.reverse()\n  \n  # Add the final 'USE' action\n  return path_actions + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:43:52.677534", "function_name": "collect", "function_body": "    state = env._current_state\n    primitive_idx = primitive\n\n    # 1. Check if the primitive is already in inventory\n    if state.satisfies(goal_name=\"\", goal_arg=primitive_idx):\n        return []\n\n    # 2. Find the closest instance of the primitive on the grid\n    grid = state.grid\n    current_pos = state.pos\n    target_coords = None\n    min_dist = float('inf')\n\n    # Iterate through the grid to find the primitive\n    for r in range(grid.shape[0]):\n        for c in range(grid.shape[1]):\n            # Check if the primitive kind exists at (r, c)\n            if grid[r, c, primitive_idx] == 1:\n                # Calculate Manhattan distance\n                dist = abs(r - current_pos[0]) + abs(c - current_pos[1])\n                if dist < min_dist:\n                    min_dist = dist\n                    target_coords = (r, c)\n\n    # 3. If the primitive is not found on the grid, return empty list\n    if target_coords is None:\n        return []\n\n    # 4. Generate actions to move to the target location\n    actions = []\n    tr, tc = target_coords  # Target row, target column\n    r_agent, c_agent = current_pos  # Agent's current row, current column\n\n    # Move vertically first\n    while r_agent > tr:\n        actions.append(env_factory.Action.UP)\n        r_agent -= 1\n    while r_agent < tr:\n        actions.append(env_factory.Action.DOWN)\n        r_agent += 1\n\n    # Then move horizontally\n    while c_agent > tc:\n        actions.append(env_factory.Action.LEFT)\n        c_agent -= 1\n    while c_agent < tc:\n        actions.append(env_factory.Action.RIGHT)\n        c_agent += 1\n\n    # 5. After reaching the target cell, perform the USE action to collect the item\n    actions.append(env_factory.Action.USE)\n\n    return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:43:52.748073", "function_name": "collect", "function_body": "    # Action constants\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Map (dr, dc) delta for movement actions\n    # These represent the change in (row, col) when taking a specific action\n    MOVE_DELTAS = {\n        UP: (-1, 0),\n        DOWN: (1, 0),\n        LEFT: (0, -1),\n        RIGHT: (0, 1),\n    }\n\n    # Map movement action to the resulting agent direction (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT)\n    ACTION_TO_DIR = {\n        DOWN: 0,\n        UP: 1,\n        LEFT: 2,\n        RIGHT: 3,\n    }\n\n    # Map agent direction to (dr, dc) offset for the USE action\n    # This determines which cell is \"in front\" of the agent\n    DIR_TO_USE_OFFSET = {\n        0: (1, 0),   # DOWN\n        1: (-1, 0),  # UP\n        2: (0, -1),  # LEFT\n        3: (0, 1),   # RIGHT\n    }\n\n    # Get the current state from the environment\n    initial_state = env._current_state\n    initial_pos = initial_state.pos\n    initial_dir = initial_state.dir\n    grid = initial_state.grid\n    \n    # Get grid dimensions (assuming grid is (rows, columns, kinds))\n    grid_rows, grid_cols, _ = grid.shape\n\n    # BFS Queue: stores (current_pos_tuple, current_dir, actions_path_list)\n    # Using tuple for position to make it hashable for the visited set\n    queue = collections.deque([((initial_pos[0], initial_pos[1]), initial_dir, [])])\n\n    # Visited set: stores (row, col, direction) tuples to avoid redundant exploration and cycles\n    visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n    # Helper function to check if a position is within grid boundaries\n    def is_valid_pos(r, c):\n        return 0 <= r < grid_rows and 0 <= c < grid_cols\n\n    # Start BFS to find the path\n    while queue:\n        (r, c), current_dir, path = queue.popleft()\n\n        # Check if the primitive can be collected from the current (r, c) and current_dir\n        # Calculate the cell that would be affected by a USE action\n        dr_use, dc_use = DIR_TO_USE_OFFSET[current_dir]\n        target_r, target_c = r + dr_use, c + dc_use\n\n        if is_valid_pos(target_r, target_c) and grid[target_r, target_c, primitive] > 0:\n            # Found a path where `USE` action would collect the primitive\n            # Return the path including the final USE action\n            return path + [USE]\n\n        # Explore possible next movement actions (UP, DOWN, LEFT, RIGHT)\n        for action, (dr_move, dc_move) in MOVE_DELTAS.items():\n            next_r, next_c = r + dr_move, c + dc_move\n            next_dir = ACTION_TO_DIR[action] # Agent's direction after this move\n\n            # Check if the next position is valid and has not been visited with this direction\n            if is_valid_pos(next_r, next_c) and (next_r, next_c, next_dir) not in visited:\n                # Add to visited set and queue\n                visited.add((next_r, next_c, next_dir))\n                queue.append(((next_r, next_c), next_dir, path + [action]))\n\n    # If the queue is empty and no path to the primitive was found, return an empty list\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:45:39.887623", "function_name": "collect", "function_body": "  actions_list = []\n  \n  state = env._current_state\n  \n  # Action constants (from action_specs): DOWN:0, UP:1, LEFT:2, RIGHT:3, USE:4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction constants (from CraftState.dir): 0:North, 1:East, 2:South, 3:West\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # 1. Check if already collected\n  if state.inventory[primitive] > 0:\n    return []\n\n  # 2. Locate the primitive on the grid\n  grid = state.grid\n  agent_pos = state.pos\n  \n  # Grid dimensions are (WIDTH, HEIGHT, n_kinds) based on CraftState description\n  # numpy array shape is (dim0, dim1, dim2)\n  WIDTH, HEIGHT, _ = grid.shape \n\n  min_dist = float('inf')\n  target_pos = None\n\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      if grid[x, y, primitive] == 1:\n        # Calculate Manhattan distance to find the closest primitive instance\n        dist = abs(x - agent_pos[0]) + abs(y - agent_pos[1])\n        if dist < min_dist:\n          min_dist = dist\n          target_pos = (x, y)\n\n  if target_pos is None:\n    # Primitive not found on the map\n    return []\n\n  # 3. Path to target and collect\n  # A generous max_steps to prevent infinite loops, roughly 2 * perimeter + turns\n  MAX_COLLECTION_STEPS = 2 * (WIDTH + HEIGHT) + 10 \n\n  for _ in range(MAX_COLLECTION_STEPS):\n    state = env._current_state\n    agent_pos = state.pos\n    agent_dir = state.dir\n    current_inventory = state.inventory\n\n    # Check for success after each step\n    if current_inventory[primitive] > 0:\n      break # Primitive collected\n\n    # Check if primitive is cardinally adjacent and grabbable, and attempt USE\n    found_adjacent_primitive_to_use = False\n    target_face_dir = -1 # The direction agent should face to USE the primitive\n\n    # (delta_x, delta_y) relative to agent_pos for cardinal neighbors\n    # This maps relative coordinates to the required facing direction\n    cardinal_neighbors_deltas = {\n        (0, -1): DIR_NORTH, # North: (agent_x, agent_y-1)\n        (1, 0): DIR_EAST,   # East: (agent_x+1, agent_y)\n        (0, 1): DIR_SOUTH,  # South: (agent_x, agent_y+1)\n        (-1, 0): DIR_WEST   # West: (agent_x-1, agent_y)\n    }\n    \n    for (ndx, ndy), required_dir in cardinal_neighbors_deltas.items():\n      nx, ny = agent_pos[0] + ndx, agent_pos[1] + ndy\n      \n      # Check bounds for the neighbor cell\n      if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n        if grid[nx, ny, primitive] == 1:\n          # Found the primitive at a cardinal neighbor\n          # Check if it's grabbable via USE action (as per problem description \"collect\")\n          if primitive in env.world.grabbable_indices: \n            found_adjacent_primitive_to_use = True\n            target_face_dir = required_dir\n            break # Found a suitable primitive, prioritize processing it\n    \n    if found_adjacent_primitive_to_use:\n      if agent_dir != target_face_dir:\n        # Agent needs to turn to face the primitive\n        # Calculate the shortest turn direction\n        diff = (target_face_dir - agent_dir + 4) % 4\n        action = None\n        if diff == 1: # Turn 90 deg clockwise (e.g., N->E)\n          action = ACTION_RIGHT\n        elif diff == 3: # Turn 90 deg counter-clockwise (e.g., N->W)\n          action = ACTION_LEFT\n        elif diff == 2: # Turn 180 deg (either left or right twice, pick one)\n          action = ACTION_RIGHT # Arbitrarily pick right for 180-degree turn\n        \n        if action is not None:\n          env.step(action)\n          actions_list.append(action)\n          continue # Re-evaluate position/direction in next iteration after turning\n      else: # Agent is already facing the primitive\n        action = ACTION_USE\n        env.step(action)\n        actions_list.append(action)\n        continue # Re-evaluate inventory in next iteration (should be collected)\n\n    # If not collected yet, and not adjacent/facing a grabbable primitive, move towards target_pos\n    dx = target_pos[0] - agent_pos[0]\n    dy = target_pos[1] - agent_pos[1]\n\n    action_to_take = None\n\n    if dx == 0 and dy == 0:\n        # Agent is on the same cell as target_pos.\n        # This implies either the primitive is collected by stepping on it (not USE),\n        # or it's an ungrabbable target, or there's an environment/logic issue.\n        # For 'collect_primitive', if it's grabbable, it should have been collected by now or via USE when adjacent.\n        # If we reach here, and not collected, it implies we cannot collect it with current logic.\n        return [] # Cannot collect if already on it and not picked up/used\n\n    # Greedy movement: prioritize movement along the axis with the larger difference\n    if abs(dx) > abs(dy): \n      if dx > 0: # Target is to the right\n        action_to_take = ACTION_RIGHT\n      else: # Target is to the left\n        action_to_take = ACTION_LEFT\n    else: # If abs(dy) is greater or equal to abs(dx), prioritize Y-axis\n      if dy > 0: # Target is below\n        action_to_take = ACTION_DOWN\n      else: # Target is above\n        action_to_take = ACTION_UP\n\n    if action_to_take is not None:\n      env.step(action_to_take)\n      actions_list.append(action_to_take)\n    else:\n      # This case should logically not be hit if dx or dy is non-zero,\n      # as a move action would always be determined.\n      # If it is hit, it signifies a problem (e.g., target_pos became current_pos without collection).\n      return [] # Unable to make progress\n\n  # After loop, final check if collected\n  if env._current_state.inventory[primitive] > 0:\n    return actions_list\n  else:\n    # Failed to collect after max steps or due to some unhandled scenario\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:45:40.861735", "function_name": "collect", "function_body": "  import collections\n\n  # Action mappings from env.action_specs()\n  _ACTIONS = env.action_specs()\n  DOWN_A = _ACTIONS[\"DOWN\"]\n  UP_A = _ACTIONS[\"UP\"]\n  LEFT_A = _ACTIONS[\"LEFT\"]\n  RIGHT_A = _ACTIONS[\"RIGHT\"]\n  USE_A = _ACTIONS[\"USE\"]\n\n  # Deltas for (row, col) corresponding to each movement action\n  _ACTION_DELTAS = {\n      UP_A: (-1, 0),\n      DOWN_A: (1, 0),\n      LEFT_A: (0, -1),\n      RIGHT_A: (0, 1)\n  }\n\n  # Mapping from delta (movement direction) to agent's facing direction\n  # (0:N, 1:E, 2:S, 3:W)\n  _DELTA_TO_FACING_DIR = {\n      (-1, 0): 0,  # North (Up)\n      (0, 1): 1,   # East (Right)\n      (1, 0): 2,   # South (Down)\n      (0, -1): 3   # West (Left)\n  }\n\n  state = env._current_state\n  grid = state.grid\n  start_pos = state.pos\n  start_dir = state.dir\n  rows, cols, _ = grid.shape\n  non_grabbable_indices = state.world.non_grabbable_indices\n\n  primitive_pos = None\n  for r in range(rows):\n    for c in range(cols):\n      if grid[r, c, primitive] == 1:\n        primitive_pos = (r, c)\n        break\n    if primitive_pos:\n      break\n\n  if primitive_pos is None:\n    return []  # Primitive not found on the grid\n\n  # BFS state: (current_row, current_col, current_facing_direction, list_of_actions_taken)\n  q = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n  visited = set([(start_pos[0], start_pos[1], start_dir)])\n\n  while q:\n    current_r, current_c, current_dir, actions_taken = q.popleft()\n\n    # Check if we are adjacent to the primitive and facing it\n    # Delta for the cell in front of the agent based on current_dir\n    # (0:N (-1,0), 1:E (0,1), 2:S (1,0), 3:W (0,-1))\n    dr_facing, dc_facing = {\n        0: (-1, 0),  # North\n        1: (0, 1),   # East\n        2: (1, 0),   # South\n        3: (0, -1)   # West\n    }[current_dir]\n\n    cell_in_front_r, cell_in_front_c = current_r + dr_facing, current_c + dc_facing\n\n    if (cell_in_front_r, cell_in_front_c) == primitive_pos:\n      # Found a path to be in front of the primitive, now use it\n      return actions_taken + [USE_A]\n\n    # Explore movement actions (UP, DOWN, LEFT, RIGHT)\n    for action, (dr, dc) in _ACTION_DELTAS.items():\n      next_r, next_c = current_r + dr, current_c + dc\n      next_pos = (next_r, next_c)\n      next_dir = _DELTA_TO_FACING_DIR[(dr, dc)] # Agent faces the direction of movement\n\n      # Boundary check\n      if not (0 <= next_r < rows and 0 <= next_c < cols):\n        continue\n\n      # Obstacle check: cannot move onto non-grabbable items\n      is_blocked = False\n      for k_idx in non_grabbable_indices:\n        if grid[next_r, next_c, k_idx] == 1:\n          is_blocked = True\n          break\n      if is_blocked:\n        continue\n\n      # If this state (position, direction) has not been visited\n      if (next_r, next_c, next_dir) not in visited:\n        visited.add((next_r, next_c, next_dir))\n        q.append((next_r, next_c, next_dir, actions_taken + [action]))\n\n  return []  # No path found to collect the primitive", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:47:37.809725", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:47:37.879529", "function_name": "collect", "function_body": "    import collections\n\n    # Action constants and deltas (defined locally as per strict instructions)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    ACTION_DELTAS = {\n        DOWN: (0, 1),   # (dx, dy) for moving from (x, y) to (x+dx, y+dy)\n        UP: (0, -1),\n        LEFT: (-1, 0),\n        RIGHT: (1, 0)\n    }\n\n    state = env._current_state\n    grid = state.grid\n    start_x, start_y = state.pos\n    grid_width, grid_height, _ = grid.shape\n\n    # 1. Initial check: If the primitive is already at the agent's current\n    #    position or in its immediate 3x3 neighborhood (which includes the current cell),\n    #    a single USE action is sufficient.\n    if state.next_to(primitive):\n        return [USE]\n\n    # 2. Perform a Breadth-First Search (BFS) to find the shortest path\n    #    to a cell from which the primitive can be collected (i.e., an adjacent cell).\n    q = collections.deque()\n    # Each element in the queue is (current_x, current_y, list_of_actions_to_reach_here)\n    q.append((start_x, start_y, []))\n\n    visited = set()\n    visited.add((start_x, start_y))\n\n    while q:\n        curr_x, curr_y, path_actions = q.popleft()\n\n        # Iterate over possible movement actions to find next reachable cells\n        for action_type, (dx, dy) in ACTION_DELTAS.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n\n            # Check if the next cell is within grid boundaries\n            if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n                continue\n\n            # Check if the next cell has already been visited in a shorter or equal path\n            if (next_x, next_y) in visited:\n                continue\n\n            # Mark the cell as visited\n            visited.add((next_x, next_y))\n            \n            # Check if the primitive is in the 3x3 neighborhood of the *next* cell (including itself)\n            # This replicates the logic of CraftState.next_to for a hypothetical position.\n            found_primitive_adjacent = False\n            for nx_offset in [-1, 0, 1]:\n                for ny_offset in [-1, 0, 1]:\n                    check_x, check_y = next_x + nx_offset, next_y + ny_offset\n                    # Ensure check_x, check_y are within grid boundaries\n                    if 0 <= check_x < grid_width and 0 <= check_y < grid_height:\n                        if grid[check_x, check_y, primitive] > 0:\n                            found_primitive_adjacent = True\n                            break\n                if found_primitive_adjacent:\n                    break\n            \n            if found_primitive_adjacent:\n                # We found a path to a cell (next_x, next_y) from which the primitive is collectable.\n                # The full sequence of actions is the path to next_x, next_y, followed by a USE action.\n                return path_actions + [action_type, USE]\n            \n            # If primitive not found, continue BFS from next_x, next_y\n            q.append((next_x, next_y, path_actions + [action_type]))\n    \n    # If the BFS completes and no path to an adjacent primitive is found\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:48:29.930294", "function_name": "collect", "function_body": "  import collections\n  \n  # Action constants (numerical values from CraftLab's action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Defines movement for each action: (dx, dy, resulting_facing_direction_index)\n  # The direction indices (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) are assumed consistent\n  # with how the agent's internal direction changes after movement.\n  MOVE_ACTIONS_PROPERTIES = {\n      ACTION_UP: (0, -1, 0),    # Move UP: change Y by -1, new facing_dir is 0 (UP)\n      ACTION_RIGHT: (1, 0, 1),  # Move RIGHT: change X by +1, new facing_dir is 1 (RIGHT)\n      ACTION_DOWN: (0, 1, 2),   # Move DOWN: change Y by +1, new facing_dir is 2 (DOWN)\n      ACTION_LEFT: (-1, 0, 3),  # Move LEFT: change X by -1, new facing_dir is 3 (LEFT)\n  }\n\n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information from the environment's internal state\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction (0, 1, 2, or 3)\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Get the set of indices for non-grabbable entities (obstacles).\n  # Convert to a list for efficient NumPy array indexing.\n  non_grabbable_kinds = list(env.world.non_grabbable_indices)\n\n  # Helper function to check if a grid cell is within bounds and not occupied by an obstacle.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    \n    # Improved check: Use NumPy's sum to quickly determine if any non-grabbable kind\n    # is present at the cell (x, y). If sum > 0, it means the cell contains an obstacle.\n    if grid[x, y, non_grabbable_kinds].sum() > 0:\n      return False # Cell is blocked by an obstacle\n    return True\n\n  # 2. Pre-compute all (agent_x, agent_y, agent_direction) states from which the primitive\n  # can be collected by performing an ACTION_USE.\n  collectable_states = set()\n\n  # Iterate through all cells in the grid to find instances of the target primitive.\n  for px in range(grid_width):\n    for py in range(grid_height):\n      # If the cell (px, py) contains the primitive:\n      if grid[px, py, primitive] == 1:\n        # Find all agent positions (ax, ay) and directions (adir) that would face (px, py)\n        # after a movement action.\n        for action_val, (dx, dy, agent_dir) in MOVE_ACTIONS_PROPERTIES.items():\n          # If an agent at (ax, ay) moves by (dx, dy) to (px, py),\n          # then its current position (ax, ay) must be (px - dx, py - dy).\n          ax, ay = px - dx, py - dy\n\n          # If this agent position is walkable, add the state to collectable_states.\n          if is_walkable(ax, ay):\n            collectable_states.add((ax, ay, agent_dir))\n\n  # If no collectable primitive instances are found on the grid, or no reachable collection points,\n  # return an empty path.\n  if not collectable_states:\n      return []\n\n  # 3. Breadth-First Search (BFS) to find the shortest sequence of actions.\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to avoid redundant exploration and cycles. A state is defined by\n  # (x, y, direction) because the agent's direction affects what it can interact with (USE action).\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the current state is one from which the primitive can be collected.\n    if (curr_x, curr_y, curr_dir) in collectable_states:\n      return path_actions + [ACTION_USE]\n\n    # Explore possible next movement actions.\n    for action, (move_dx, move_dy, next_dir) in MOVE_ACTIONS_PROPERTIES.items():\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n\n      # If the next cell is walkable and this (position, direction) state hasn't been visited,\n      # add it to the queue for further exploration.\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:48:30.876213", "function_name": "collect", "function_body": "", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:49:50.525671", "function_name": "collect", "function_body": "    # Constants for actions and directions. These are derived from the CraftLab/CraftState class descriptions.\n    # The action_map is expected to be available from the env_factory module.\n    # Agent directions: 0=N, 1=E, 2=S, 3=W\n    \n    # Map movement actions to their corresponding position delta (dr, dc) and the new agent direction.\n    # Moving changes both position and facing direction in CraftWorld.\n    ACTION_TO_DELTA_AND_DIR = {\n        env_factory.action_map['UP']:    ((-1, 0), 0), # (dr, dc) for UP, new_dir is 0 (North)\n        env_factory.action_map['DOWN']:  ((1, 0), 2), # (dr, dc) for DOWN, new_dir is 2 (South)\n        env_factory.action_map['LEFT']:  ((0, -1), 3), # (dr, dc) for LEFT, new_dir is 3 (West)\n        env_factory.action_map['RIGHT']: ((0, 1), 1), # (dr, dc) for RIGHT, new_dir is 1 (East)\n    }\n\n    # Helper function to check if a position is within grid boundaries.\n    def _is_valid_pos(r, c, width, height):\n      return 0 <= r < width and 0 <= c < height\n\n    # Helper function to simulate CraftState.next_to logic.\n    # This checks if an item of 'target_kind_idx' is in the 3x3 neighborhood around (r, c).\n    def _simulate_next_to(r, c, grid, target_kind_idx, width, height):\n      for dr_adj in [-1, 0, 1]:\n        for dc_adj in [-1, 0, 1]:\n          if dr_adj == 0 and dc_adj == 0: # Skip the current cell itself\n            continue\n          \n          nr, nc = r + dr_adj, c + dc_adj\n          if _is_valid_pos(nr, nc, width, height) and grid[nr, nc, target_kind_idx] > 0:\n            return True\n      return False\n\n    # Helper function to find all locations of a specific item kind on the grid.\n    def _get_target_locations(grid, target_kind_idx):\n        locations = []\n        width, height, _ = grid.shape\n        for r in range(width):\n            for c in range(height):\n                if grid[r, c, target_kind_idx] > 0:\n                    locations.append((r, c))\n        return locations\n\n    # Helper function to determine if the collection condition is met at the current position.\n    # This differs based on whether the item is grabbable (agent must be on the cell) or non-grabbable (agent must be next to it).\n    def _is_collection_condition_met(current_pos, target_kind_idx, grid, width, height, is_grabbable, target_locations_set):\n        if is_grabbable:\n            return current_pos in target_locations_set\n        else: # Non-grabbable items (like a resource to be \"mined\" or \"chopped\")\n            return _simulate_next_to(current_pos[0], current_pos[1], grid, target_kind_idx, width, height)\n\n    # Get current state information from the environment.\n    state = env._current_state\n    grid = state.grid\n    current_pos = state.pos\n    start_dir = state.dir\n    target_kind_idx = primitive\n\n    width, height, _ = grid.shape # Grid dimensions\n\n    # Determine if the target item is grabbable or non-grabbable.\n    # This information is stored in the CraftWorld instance accessible via env.world.\n    is_grabbable = target_kind_idx in env.world.grabbable_indices\n\n    # Find all locations of the target primitive on the grid.\n    target_locations = _get_target_locations(grid, target_kind_idx)\n    target_locations_set = set(target_locations) # Use a set for efficient lookup during BFS.\n\n    if not target_locations:\n        # The primitive is not found on the map, so no actions can collect it.\n        return []\n\n    # Initialize a Breadth-First Search (BFS) queue and a set for visited states.\n    # A state in BFS is defined by (row, col, direction, path_taken_actions).\n    # 'collections.deque' is used for efficient queue operations.\n    queue = collections.deque([(current_pos[0], current_pos[1], start_dir, [])])\n    visited = {(current_pos[0], current_pos[1], start_dir)}\n\n    # Start the BFS.\n    while queue:\n        r, c, d, path = queue.popleft() # Pop the earliest state from the queue.\n        \n        # Check if the current position satisfies the condition to collect the item.\n        if _is_collection_condition_met((r, c), target_kind_idx, grid, width, height, is_grabbable, target_locations_set):\n            # If the condition is met, we have found the shortest path to a valid collection point.\n            # Append the 'USE' action and return the complete action list.\n            return path + [env_factory.action_map['USE']]\n\n        # Explore possible next states by trying all movement actions.\n        for action in [env_factory.action_map['UP'], env_factory.action_map['DOWN'], \n                       env_factory.action_map['LEFT'], env_factory.action_map['RIGHT']]:\n            \n            # Calculate the new position and direction after taking this action.\n            (dr, dc), new_d = ACTION_TO_DELTA_AND_DIR[action]\n            new_r, new_c = r + dr, c + dc\n\n            # Check if the new position is valid (within grid boundaries).\n            if _is_valid_pos(new_r, new_c, width, height):\n                next_state_tuple = (new_r, new_c, new_d)\n                \n                # If this state (position and direction) has not been visited yet via a shorter path, add it to the queue.\n                if next_state_tuple not in visited:\n                    visited.add(next_state_tuple)\n                    queue.append((new_r, new_c, new_d, path + [action]))\n\n    # If the queue becomes empty and no path to collect the primitive was found, return an empty list.\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:49:50.594808", "function_name": "collect", "function_body": "    import collections\n\n    # Action constants, as defined in CraftLab.action_specs\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Initial state of the environment\n    initial_state = env._current_state\n\n    # Queue for Breadth-First Search (BFS)\n    # Each element is a tuple: (CraftState, list_of_actions_to_reach_this_state)\n    queue = collections.deque([(initial_state, [])])\n\n    # Set to keep track of visited states to prevent cycles and redundant exploration.\n    # A state is defined by its grid, agent's position, direction, and inventory.\n    # Numpy arrays (grid, inventory) are converted to bytes for hashing.\n    visited = set()\n    visited.add((initial_state.grid.tobytes(), initial_state.pos,\n                 initial_state.dir, initial_state.inventory.tobytes()))\n\n    # Perform BFS\n    while queue:\n        current_state, current_path = queue.popleft()\n\n        # Check if the primitive is in the agent's immediate vicinity (3x3 neighborhood)\n        if current_state.next_to(primitive):\n            # If so, the next action should be USE to collect it.\n            return current_path + [USE]\n\n        # Explore all possible movement actions (UP, DOWN, LEFT, RIGHT)\n        for action in [DOWN, UP, LEFT, RIGHT]:\n            # Simulate the step to get the next state without modifying the actual environment.\n            # CraftState.step returns (reward, new_state). We only need new_state.\n            _, next_state = current_state.step(action)\n\n            # Create a hashable key for the next state\n            next_state_key = (next_state.grid.tobytes(), next_state.pos,\n                              next_state.dir, next_state.inventory.tobytes())\n\n            # If this state has not been visited before, add it to the queue and visited set\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                queue.append((next_state, current_path + [action]))\n\n    # If the queue becomes empty and no path to collect the primitive is found,\n    # return an empty list indicating failure.\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:51:50.107623", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:51:50.176954", "function_name": "collect", "function_body": "    # Action constants (from action_specs)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    actions_taken = []\n    # Set a reasonable maximum number of iterations to prevent infinite loops.\n    # The `env.step` will also return `done=True` if `max_steps` is reached in CraftLab.\n    max_loop_iterations = 1000 \n\n    for _ in range(max_loop_iterations):\n        obs = env.observations()\n        current_inventory = obs['features_dict']['inventory']\n\n        # 1. Check if the primitive is already collected\n        if current_inventory[primitive] > 0:\n            return actions_taken\n\n        current_grid = obs['features_dict']['features_global']\n        normalized_pos = obs['features_dict']['pos'] # (x, y) normalized coordinates\n\n        grid_width, grid_height, _ = current_grid.shape\n        \n        # Convert normalized position to integer grid coordinates\n        # Assumes normalized_pos[0] is x-axis (width), normalized_pos[1] is y-axis (height)\n        current_x = int(normalized_pos[0] * grid_width)\n        current_y = int(normalized_pos[1] * grid_height)\n\n        # 2. Find the closest instance of the primitive on the grid\n        target_pos = None\n        min_dist = float('inf')\n\n        # Iterate through the grid to find all occurrences of the primitive\n        # and select the closest one using Manhattan distance\n        for x in range(grid_width):\n            for y in range(grid_height):\n                # Check if the primitive is present at (x, y)\n                # `current_grid[x, y, primitive]` could be a count, so check > 0\n                if current_grid[x, y, primitive] > 0:\n                    dist = abs(x - current_x) + abs(y - current_y)\n                    if dist < min_dist:\n                        min_dist = dist\n                        target_pos = (x, y)\n\n        if target_pos is None:\n            # Primitive not found on the grid. Cannot collect.\n            # This might happen if all instances are collected/gone or not spawned.\n            # Return actions taken so far (likely an empty list if called first).\n            return actions_taken\n\n        target_x, target_y = target_pos\n\n        action_to_take = -1 # Initialize with an invalid action\n\n        # 3. Determine the next action: USE if adjacent/on top, else move\n        \n        # Calculate relative position of target to agent\n        dx = target_x - current_x\n        dy = target_y - current_y\n\n        # Case A: Primitive is at the agent's current location or in the 3x3 neighborhood\n        # (This covers direct neighbors and diagonals, as CraftState.next_to implies)\n        if (target_x, target_y) == (current_x, current_y) or (abs(dx) <= 1 and abs(dy) <= 1):\n            action_to_take = USE\n        else:\n            # Case B: Primitive is further away, need to move\n            # Prioritize movement along the axis with the greater distance\n            # This leads to \"Manhattan-like\" pathfinding (L-shaped paths)\n            if abs(dx) >= abs(dy): \n                if dx > 0:\n                    action_to_take = RIGHT\n                else: # dx < 0\n                    action_to_take = LEFT\n            else: # abs(dy) > abs(dx)\n                if dy > 0:\n                    action_to_take = DOWN\n                else: # dy < 0\n                    action_to_take = UP\n\n        # If for some reason an action was not determined (should not happen with current logic)\n        if action_to_take == -1:\n            break\n\n        # 4. Execute the chosen action and record it\n        _, done, _ = env.step(action_to_take)\n        actions_taken.append(action_to_take)\n\n        # 5. Check if the episode is done (e.g., max_steps reached in CraftLab)\n        if done:\n            break\n\n    # Return actions taken if loop finishes without collecting the primitive\n    # (e.g., max_loop_iterations reached or environment became done for other reasons)\n    return actions_taken", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:53:26.789660", "function_name": "collect", "function_body": "        # Get action mappings\n        action_map = env.action_specs()\n        UP = action_map['UP']\n        DOWN = action_map['DOWN']\n        LEFT = action_map['LEFT']\n        RIGHT = action_map['RIGHT']\n        USE = action_map['USE']\n\n        actions = []\n        obs = env.reset(seed=0)  # Reset the environment for a consistent starting point\n        \n        # Max steps to prevent infinite loops, use env.max_steps if available, else a reasonable default\n        # The CraftLab constructor sets max_steps, so it should be available.\n        max_loop_steps = env.max_steps \n\n        for _ in range(max_loop_steps):\n            inventory = obs['features_dict']['inventory']\n\n            # 1. Check if primitive is already collected\n            if inventory[primitive] > 0:\n                break # Goal achieved\n\n            ego_grid = obs['features_dict']['features_ego']\n            # Agent's position is typically at the center of the egocentric view\n            # The egocentric view is (window_height, window_width, n_kinds)\n            agent_r, agent_c = ego_grid.shape[0] // 2, ego_grid.shape[1] // 2\n\n            # Find all locations of the primitive in the egocentric view\n            primitive_locations_in_ego = np.argwhere(ego_grid[:, :, primitive] > 0)\n\n            action_to_take = None\n\n            if primitive_locations_in_ego.size > 0:\n                # Calculate Manhattan distance to find the closest primitive\n                min_dist = float('inf')\n                closest_target_r, closest_target_c = None, None\n\n                for tr, tc in primitive_locations_in_ego:\n                    # Ignore if the primitive is at the agent's exact location, as it should be in inventory\n                    if tr == agent_r and tc == agent_c:\n                        continue\n                    \n                    dist = abs(tr - agent_r) + abs(tc - agent_c)\n                    if dist < min_dist:\n                        min_dist = dist\n                        closest_target_r, closest_target_c = tr, tc\n                \n                if closest_target_r is not None: # A collectible primitive was found in view\n                    dr = closest_target_r - agent_r # Row difference in ego view (negative = forward)\n                    dc = closest_target_c - agent_c # Col difference in ego view (negative = left)\n\n                    # 2. If the primitive is immediately adjacent (within 3x3 and not agent's cell), USE it\n                    # CraftState.next_to (used by USE action) checks the 3x3 neighborhood.\n                    # Manhattan distance <= 2 covers cardinal and diagonal neighbors.\n                    if min_dist <= 2: \n                        action_to_take = USE\n                    else:\n                        # 3. Move towards the closest visible primitive\n                        # Prioritize moving forward/backward (row changes in egocentric view)\n                        if dr < 0:  # Primitive is 'forward' in the ego view\n                            action_to_take = UP\n                        elif dr > 0:  # Primitive is 'backward' in the ego view\n                            action_to_take = DOWN\n                        else:  # dr == 0, primitive is on the same row, need to turn left/right\n                            if dc < 0:  # Primitive is 'left' in the ego view\n                                action_to_take = LEFT\n                            elif dc > 0:  # Primitive is 'right' in the ego view\n                                action_to_take = RIGHT\n                            # If dr=0 and dc=0, it means min_dist was 0 (primitive at agent's exact spot),\n                            # which should be handled by the 'continue' above.\n                            # So this else branch (dr=0, dc=0, but no action_to_take yet) should not be reached\n                            # for a valid closest_target_r.\n                \n            # If no specific action decided (e.g., no primitive visible, or closest_target_r was None)\n            if action_to_take is None:\n                # 4. Explore randomly\n                action_to_take = np.random.choice([UP, DOWN, LEFT, RIGHT])\n\n            actions.append(action_to_take)\n            reward, done, obs = env.step(action_to_take)\n\n            if done:\n                break # Episode ended (e.g., max steps reached or goal collected implicitly via reward)\n\n        return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:53:27.762360", "function_name": "collect", "function_body": "  current_obs = env.observations()\n  grid = current_obs['features_dict']['features_global']\n  norm_pos = current_obs['features_dict']['pos']\n  inventory = current_obs['features_dict']['inventory']\n\n  # Check if primitive is already collected\n  if inventory[primitive] > 0:\n      return []\n\n  grid_height, grid_width, n_kinds = grid.shape\n\n  # Convert normalized position to grid coordinates\n  # The `pos` in CraftState is `tuple(int, int)`, but in features_dict it's normalized.\n  # Assuming normalized position is `(row_normalized, col_normalized)`\n  # And 0.0 maps to 0, 1.0 maps to max_dim - 1\n  agent_r = int(round(norm_pos[0] * (grid_height - 1)))\n  agent_c = int(round(norm_pos[1] * (grid_width - 1)))\n  agent_pos = (agent_r, agent_c)\n\n  # Determine what constitutes an obstacle for movement\n  world = env.world # CraftLab instance has a world attribute of type CraftWorld\n  obstacle_kinds = set(world.non_grabbable_indices) | set(world.workshop_indices)\n  \n  # If the primitive itself is grabbable, it's not an obstacle to move onto.\n  # We remove it from `obstacle_kinds` to allow pathfinding to its location.\n  if primitive in world.grabbable_indices:\n      obstacle_kinds = obstacle_kinds - {primitive}\n\n  # Helper function to check if a cell is an obstacle for movement\n  def is_obstacle(r, c):\n      if not (0 <= r < grid_height and 0 <= c < grid_width):\n          return True # Out of bounds is an obstacle\n      \n      # Check if any obstacle_kind is present at (r,c)\n      for k_idx in obstacle_kinds:\n          if grid[r, c, k_idx] == 1: # If an obstacle kind is present, it's an obstacle\n              return True\n      return False\n\n  # Find all locations of the primitive on the grid\n  primitive_locs = np.argwhere(grid[:, :, primitive] == 1)\n  \n  if len(primitive_locs) == 0:\n      # Primitive not found on the map\n      return []\n\n  # BFS to find the shortest path to a primitive or its adjacent cell\n  # collections.deque is assumed to be available (common standard library type)\n  q = collections.deque() \n  visited = set()\n\n  # Queue stores (row, col, list_of_actions_to_reach_here)\n  q.append((agent_r, agent_c, []))\n  visited.add((agent_r, agent_c))\n\n  # Directions for BFS and corresponding CraftLab actions\n  # These are absolute movements (e.g., ACTION_UP always moves towards row 0)\n  moves = {\n      (0, -1): env_factory.ACTION_LEFT,  # delta_r, delta_c -> action\n      (0, 1): env_factory.ACTION_RIGHT,\n      (-1, 0): env_factory.ACTION_UP,\n      (1, 0): env_factory.ACTION_DOWN\n  }\n\n  best_path_actions = []\n  \n  # Determine if we should path to a cell *adjacent* to the primitive or *onto* the primitive's cell\n  # If the primitive is a non-grabbable item (e.g., water, stone, workshop), agent needs to be *adjacent* to it.\n  # Otherwise (e.g., a dropped item that is grabbable), agent can move *onto* it.\n  # The `non_grabbable_indices` set in `world` contains such entities.\n  target_adjacent = (primitive in world.non_grabbable_indices or primitive in world.workshop_indices)\n\n  target_cells = set()\n  if target_adjacent:\n      # If targeting adjacent, find all valid and walkable cells next to any primitive location\n      for pr, pc in primitive_locs:\n          for dr, dc in moves.keys(): # Iterate through relative move directions\n              nr, nc = pr + dr, pc + dc\n              # Add only valid and non-obstacle neighbor cells to target_cells\n              if 0 <= nr < grid_height and 0 <= nc < grid_width and not is_obstacle(nr, nc):\n                  target_cells.add((nr, nc))\n      if not target_cells: # No valid adjacent cells to path to\n          return []\n  else:\n      # If not targeting adjacent, directly target the primitive's cell\n      # Cells containing the primitive are treated as traversable during pathfinding\n      # (due to `primitive` being removed from `obstacle_kinds` if it's grabbable).\n      target_cells = set(tuple(loc) for loc in primitive_locs)\n      # No special handling needed if agent_pos is a target primitive, BFS will start there\n\n  path_found = False\n  \n  while q:\n      r, c, path = q.popleft()\n\n      # If current cell is one of the target cells\n      if (r, c) in target_cells:\n          best_path_actions = path\n          path_found = True\n          break\n\n      for (dr, dc), action in moves.items():\n          nr, nc = r + dr, c + dc\n\n          # Only add to queue if cell is within bounds, not an obstacle, and not yet visited\n          if not is_obstacle(nr, nc) and (nr, nc) not in visited:\n              visited.add((nr, nc))\n              q.append((nr, nc, path + [action]))\n  \n  if not path_found:\n      return [] # No path found to any target cell\n\n  final_actions = list(best_path_actions) # Make a copy\n\n  # After reaching the target cell (either on the primitive or adjacent to it),\n  # the `ACTION_USE` is typically required to collect/interact with the item.\n  final_actions.append(env_factory.ACTION_USE)\n\n  return final_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:54:34.120778", "function_name": "collect", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:54:35.102773", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Define action constants for clarity and consistency with CraftLab.action_specs\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement actions to their corresponding (dx, dy) grid delta and the resulting agent direction.\n  # CraftWorld agent changes direction to match the movement action.\n  # Directions: 0=North (Up), 1=East (Right), 2=South (Down), 3=West (Left)\n  MOVEMENT_INFO = {\n      ACTION_UP:    ((0, -1), 0), # ((dx, dy), new_direction)\n      ACTION_RIGHT: ((1, 0),  1),\n      ACTION_DOWN:  ((0, 1),  2),\n      ACTION_LEFT:  ((-1, 0), 3),\n  }\n  \n  # Map agent's facing direction to the (dx, dy) delta for the cell directly in front of the agent.\n  # This is used to determine which cell the USE action targets.\n  DIRECTION_TO_FACING_DELTA = {\n      0: (0, -1),  # North: agent faces up, USE affects cell at Y-1\n      1: (1, 0),   # East: agent faces right, USE affects cell at X+1\n      2: (0, 1),   # South: agent faces down, USE affects cell at Y+1\n      3: (-1, 0),  # West: agent faces left, USE affects cell at X-1\n  }\n\n  def _get_primitive_collection_sources(primitive_idx: int, world) -> set[int]:\n    \"\"\"\n    Identifies all entity kinds (indices) that, when located in the cell\n    directly in front of the agent, allow `primitive_idx` to be collected\n    via the USE action. This includes the primitive item itself (if on ground)\n    and specific harvestable resource blocks (e.g., 'water' from 'water_block').\n    \"\"\"\n    sources = {primitive_idx} # Always include the primitive's own index for direct pickup\n\n    primitive_name = world.cookbook.index.get(primitive_idx)\n    if primitive_name is None:\n        # If the primitive index is not recognized by the cookbook, we cannot identify\n        # specific block sources for it.\n        return sources \n\n    # Add specific block indices from which the primitive can be harvested\n    if primitive_name == 'water':\n        if hasattr(world, 'water_index'): # Ensure the index exists in the world config\n            sources.add(world.water_index) \n    elif primitive_name == 'stone':\n        if hasattr(world, 'stone_index'):\n            sources.add(world.stone_index)\n    # Extend this logic for other harvestable primitives if applicable (e.g., 'wood' from 'tree_block')\n        \n    return sources\n\n  # --- Retrieve current environment state information ---\n  current_observations = env.observations()\n  current_grid = current_observations['features_dict']['features_global']\n  \n  # Agent's current position (x, y) as a tuple, suitable for hashing in sets/dictionaries.\n  agent_start_pos = tuple(current_observations['features_dict']['pos'].astype(int))\n  \n  # Agent's current facing direction (0=N, 1=E, 2=S, 3=W) derived from one-hot encoding.\n  agent_start_dir = np.argmax(current_observations['features_dict']['direction'])\n  \n  # Access the CraftWorld instance for environment configuration (e.g., non-grabbable items)\n  world = env.world\n  \n  # These are entities the agent cannot move through, acting as obstacles.\n  non_traversable_indices = world.non_grabbable_indices\n  \n  grid_width, grid_height, _ = current_grid.shape\n\n  # 1. Pre-compute a traversability map for all grid cells.\n  # A cell is traversable if it does not contain any non-traversable entity.\n  traversable_map = np.ones((grid_width, grid_height), dtype=bool)\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if any(current_grid[x, y, idx] > 0 for idx in non_traversable_indices):\n              traversable_map[x, y] = False\n  \n  # If the agent's starting position is an obstacle, no path can exist.\n  if not traversable_map[agent_start_pos[0], agent_start_pos[1]]:\n      return []\n\n  # 2. Identify all target states ((agent_x, agent_y), agent_direction) from which\n  #    the primitive can be successfully collected using the USE action.\n  \n  # Get the set of entity indices that represent sources for the desired primitive.\n  primitive_source_kinds = _get_primitive_collection_sources(primitive, world)\n  \n  target_collection_states = set() # Stores ((pos_x, pos_y), direction_int) tuples\n  \n  # Iterate through every possible agent position on the grid\n  for agent_x in range(grid_width):\n      for agent_y in range(grid_height):\n          if not traversable_map[agent_x, agent_y]: \n              continue # Agent must be on traversable ground to interact\n\n          # For each traversable agent position, check all 4 possible facing directions\n          for facing_direction in range(4): \n              # Calculate the coordinates of the cell directly in front of the agent\n              dx_facing, dy_facing = DIRECTION_TO_FACING_DELTA[facing_direction]\n              faced_cell_x, faced_cell_y = agent_x + dx_facing, agent_y + dy_facing\n\n              # Check if the faced cell is within grid boundaries\n              if not (0 <= faced_cell_x < grid_width and 0 <= faced_cell_y < grid_height):\n                  continue\n              \n              # If the faced cell contains any of the required primitive source kinds,\n              # this (position, direction) is a valid target state for collection.\n              if any(current_grid[faced_cell_x, faced_cell_y, source_idx] > 0 \n                     for source_idx in primitive_source_kinds):\n                  target_collection_states.add(((agent_x, agent_y), facing_direction))\n  \n  # If no possible collection states are found anywhere on the map, the primitive is unreachable.\n  if not target_collection_states:\n      return []\n\n  # 3. Perform a Breadth-First Search (BFS) to find the shortest action sequence\n  #    from the initial state to any of the `target_collection_states`.\n  \n  # BFS queue stores (current_position_tuple, current_direction_int, list_of_actions_taken_so_far)\n  q = deque([(agent_start_pos, agent_start_dir, [])])\n  \n  # Visited states are tracked as ((pos_x, pos_y), direction_int) tuples to prevent cycles\n  # and redundant exploration in the state-space (position + direction).\n  visited_states = {(agent_start_pos, agent_start_dir)} \n\n  while q:\n      curr_pos, curr_dir, actions_path = q.popleft()\n\n      # If the current agent state matches one of our target collection states, we've found\n      # the shortest path to a location from which the primitive can be collected.\n      if (curr_pos, curr_dir) in target_collection_states:\n          # Append the final USE action and return the complete sequence of actions.\n          return actions_path + [ACTION_USE]\n\n      # Explore all possible next states by trying each movement action (UP, DOWN, LEFT, RIGHT)\n      for action_val, (move_delta, new_dir_after_action) in MOVEMENT_INFO.items():\n          potential_next_pos_x, potential_next_pos_y = curr_pos[0] + move_delta[0], curr_pos[1] + move_delta[1]\n          potential_next_pos = (potential_next_pos_x, potential_next_pos_y)\n          \n          # Scenario A: Agent attempts to move into a traversable cell.\n          if (0 <= potential_next_pos_x < grid_width and 0 <= potential_next_pos_y < grid_height and\n              traversable_map[potential_next_pos_x, potential_next_pos_y]):\n              \n              # The agent successfully moves to the new position and changes direction.\n              next_state_key = (potential_next_pos, new_dir_after_action)\n              if next_state_key not in visited_states:\n                  visited_states.add(next_state_key)\n                  q.append((potential_next_pos, new_dir_after_action, actions_path + [action_val]))\n          \n          # Scenario B: Agent attempts to move into a blocked (non-traversable) cell.\n          else:\n              # In CraftWorld, if movement is blocked, the agent stays in its current position\n              # but still changes its facing direction to align with the attempted movement.\n              # This allows \"turning in place\" by trying to walk into an obstacle.\n              next_state_key = (curr_pos, new_dir_after_action) # Position remains the same\n              if next_state_key not in visited_states:\n                  visited_states.add(next_state_key)\n                  q.append((curr_pos, new_dir_after_action, actions_path + [action_val]))\n\n  # If the BFS queue becomes empty and no target collection state was reached,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:56:16.569278", "function_name": "collect", "function_body": "    obs = env.observations()\n    features = obs['features_dict']\n    grid = features['features_global']\n    \n    WIDTH, HEIGHT, N_KINDS = grid.shape\n    \n    # Constants for actions (defined within the function for clarity and self-containment)\n    MOVE_DOWN = 0\n    MOVE_UP = 1\n    MOVE_LEFT = 2\n    MOVE_RIGHT = 3\n    USE = 4\n\n    # Map action ID to (dx, dy) relative movement\n    ACTION_TO_DELTAS = {\n        MOVE_DOWN: (0, 1),\n        MOVE_UP: (0, -1),\n        MOVE_LEFT: (-1, 0),\n        MOVE_RIGHT: (1, 0)\n    }\n\n    # Get initial position and direction from the current observation\n    initial_pos_normalized = features['pos']\n    init_x = int(round(initial_pos_normalized[0] * WIDTH))\n    init_y = int(round(initial_pos_normalized[1] * HEIGHT))\n    \n    # Initial direction (0: DOWN, 1: UP, 2: LEFT, 3: RIGHT)\n    init_dir_idx = np.argmax(features['direction'])\n\n    # Get the index for water, which acts as an obstacle\n    water_index = env.world.water_index\n\n    def is_walkable(x, y):\n        \"\"\"Checks if a cell (x, y) is within grid bounds and is not a water obstacle.\"\"\"\n        return 0 <= x < WIDTH and 0 <= y < HEIGHT and grid[x, y, water_index] == 0\n\n    # Find all locations of the target primitive on the grid\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            # Check if the primitive is present at this cell\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        # If the primitive is not found anywhere on the grid, return an empty action list.\n        return []\n\n    # BFS state: (current_x, current_y, current_direction_idx)\n    # Queue stores: ((x, y, dir_idx), [list_of_actions_taken_so_far])\n    queue = collections.deque([ ( (init_x, init_y, init_dir_idx), [] ) ])\n    \n    # Visited set to keep track of explored states (position + direction)\n    visited = set([(init_x, init_y, init_dir_idx)])\n\n    while queue:\n        (curr_x, curr_y, curr_dir_idx), actions_so_far = queue.popleft()\n\n        # 1. Try to USE from the current position\n        # Check all 4 cardinal neighbors (relative positions for the primitive)\n        for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]: # (dx, dy) for DOWN, UP, LEFT, RIGHT\n            nx, ny = curr_x + dx, curr_y + dy\n            \n            # If an adjacent cell contains the primitive\n            if (nx, ny) in primitive_locations:\n                # Check if the agent's current facing direction (curr_dir_idx)\n                # is aligned with the direction to the primitive (dx, dy)\n                if ACTION_TO_DELTAS[curr_dir_idx] == (dx, dy):\n                    # If aligned, we can use the primitive. This path is a solution.\n                    return actions_so_far + [USE]\n\n        # 2. Explore movement actions (UP, DOWN, LEFT, RIGHT)\n        for move_action in [MOVE_DOWN, MOVE_UP, MOVE_LEFT, MOVE_RIGHT]:\n            mdx, mdy = ACTION_TO_DELTAS[move_action] # Movement delta for the action\n            next_x, next_y = curr_x + mdx, curr_y + mdy\n            \n            # The agent's direction is assumed to change to the direction of the last movement action.\n            next_dir_idx = move_action \n\n            # If the next cell is walkable and this state hasn't been visited yet\n            if is_walkable(next_x, next_y):\n                if (next_x, next_y, next_dir_idx) not in visited:\n                    visited.add((next_x, next_y, next_dir_idx))\n                    queue.append(((next_x, next_y, next_dir_idx), actions_so_far + [move_action]))\n\n    # If the BFS queue becomes empty and no path to collect the primitive was found,\n    # it means the primitive is unreachable from the starting position.\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:56:16.640290", "function_name": "collect", "function_body": "    # Action constants\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    # Mapping from action to (delta_row, delta_col)\n    _ACTION_DELTAS = {\n        _UP: (-1, 0),\n        _DOWN: (1, 0),\n        _LEFT: (0, -1),\n        _RIGHT: (0, 1),\n    }\n\n    current_state = env._current_state\n    actions_sequence = []\n\n    # 1. Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []  # Already collected\n\n    # 2. Locate the primitive on the grid\n    target_pos = None\n    rows, cols, _ = current_state.grid.shape\n    grabbable_indices = env.world.grabbable_indices\n\n    # Ensure the primitive is actually grabbable\n    if primitive not in grabbable_indices:\n        return []  # Cannot collect this item (e.g., it's a non-grabbable item or a crafted item)\n\n    for r in range(rows):\n        for c in range(cols):\n            if current_state.grid[r, c, primitive] > 0:\n                target_pos = (r, c)\n                break\n        if target_pos:\n            break\n\n    if not target_pos:\n        return []  # Primitive not found on the grid\n\n    # 3. Pathfinding to an adjacent cell using BFS\n    start_pos = current_state.pos\n    # Use collections.deque for efficient queue operations\n    import collections\n    queue = collections.deque([(start_pos, [])])  # (current_coordinates, path_actions_list_so_far)\n    visited = {start_pos}\n\n    # Define obstacles: assuming non_grabbable_indices define impassable terrain\n    non_grabbable_indices = env.world.non_grabbable_indices\n    # Workshop indices are grabbable but might also block movement if present on a cell\n    # Assuming only strictly non-grabbable items are obstacles for simplicity\n    obstacle_indices = non_grabbable_indices \n\n    def is_traversable(r, c):\n        # Check bounds\n        if not (0 <= r < rows and 0 <= c < cols):\n            return False\n        # Check for obstacles (cells containing items from obstacle_indices)\n        for idx in obstacle_indices:\n            if current_state.grid[r, c, idx] > 0:\n                return False\n        return True\n\n    final_path_actions = []\n    found_adjacent_path = False\n\n    while queue:\n        (curr_r, curr_c), path_so_far = queue.popleft()\n\n        # Check if current position is adjacent to the target primitive\n        # A cell (r, c) is adjacent to (tr, tc) if Manhattan distance is 1\n        tr, tc = target_pos\n        if abs(curr_r - tr) + abs(curr_c - tc) == 1:\n            final_path_actions = path_so_far\n            found_adjacent_path = True\n            break\n\n        # Explore neighbors\n        for action, (dr, dc) in _ACTION_DELTAS.items():\n            next_r, next_c = curr_r + dr, curr_c + dc\n            next_pos = (next_r, next_c)\n\n            if next_pos not in visited and is_traversable(next_r, next_c):\n                visited.add(next_pos)\n                queue.append((next_pos, path_so_far + [action]))\n\n    if not found_adjacent_path:\n        return []  # Cannot reach the primitive\n\n    # 4. Execute path and then Use action\n    actions_sequence.extend(final_path_actions)\n    actions_sequence.append(_USE)\n\n    return actions_sequence", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:57:12.398006", "function_name": "collect", "function_body": "  import collections\n\n  # Constants for actions and direction mappings\n  # These map action integers (0-3) to coordinate differences (dx, dy)\n  # and represent the agent's new facing direction after that movement.\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4\n\n  cookbook = env.world.cookbook\n  # Get or assign the integer index for the given primitive name\n  primitive_idx = cookbook.index.index(primitive) \n\n  # Get the current state from the environment\n  current_state = env._current_state\n\n  # Pre-check 1: If the primitive is already in the agent's inventory\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # Pre-check 2: Determine if this primitive type can even be collected with 'USE'\n  # Grabbable items are typically primitives that can be picked up from the grid.\n  # \"Water\" is a special case often not in 'grabbable_indices' but can be collected via 'USE'.\n  grabbable_set = set(env.world.grabbable_indices)\n  water_index = env.world.water_index if hasattr(env.world, 'water_index') else -1\n\n  # If the primitive is neither generally grabbable nor the special 'water' item,\n  # it's likely not collectible via a simple 'USE' action on the grid (e.g., a workbench, bridge).\n  if primitive_idx not in grabbable_set and primitive_idx != water_index:\n    return [] # This item is not designated as collectible by 'USE' in this context.\n\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # Find all locations where the primitive is present on the grid.\n  target_primitive_locs = set() # Stores (x, y) coordinates of the primitive\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        target_primitive_locs.add((x, y))\n\n  # If the primitive is not found anywhere on the map, it cannot be collected.\n  if not target_primitive_locs:\n    return []\n\n  # Get non-grabbable indices from the world for traversability checks\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def _is_traversable(x, y):\n    \"\"\"\n    Checks if a cell (x, y) is traversable.\n    A cell is traversable if it's within bounds and does not contain\n    any non-grabbable item that is NOT the primitive we are trying to collect.\n    This allows agents to move onto cells containing the target primitive,\n    even if that primitive itself is usually considered \"non-grabbable\" (e.g., water).\n    \"\"\"\n    # 1. Check boundary conditions\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # 2. Check for impassable obstacles at (x, y)\n    for k_idx in range(grid.shape[2]): # Iterate through all possible item kinds\n      if grid[x, y, k_idx] > 0: # If this kind (k_idx) is present at (x, y)\n        # If this kind is in the set of non-grabbable items AND it's not our target primitive itself,\n        # then it's an impassable obstacle (e.g., a solid wall that cannot be walked through).\n        if k_idx in non_grabbable_indices and k_idx != primitive_idx:\n          return False # This cell contains an impassable obstacle\n    return True\n\n  # BFS Initialization\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Initial direction from CraftState\n\n  # Queue for BFS: stores tuples of ((current_x, current_y), current_direction, [list_of_actions_to_reach_this_state])\n  queue = collections.deque([((start_pos[0], start_pos[1]), start_dir, [])])\n  \n  # Visited set: stores ((x, y), direction) tuples to prevent cycles and redundant path exploration\n  visited = {((start_pos[0], start_pos[1]), start_dir)}\n\n  best_path_actions = None # Will store the shortest sequence of actions\n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.popleft()\n\n    # Determine the cell directly in front of the agent (where a 'USE' action would apply)\n    face_dx, face_dy = _ACTION_TO_COORD_DIFF[curr_dir] \n    face_x, face_y = curr_x + face_dx, curr_y + face_dy\n\n    # Check if the cell in front is within bounds and contains the target primitive\n    if (0 <= face_x < grid_width and 0 <= face_y < grid_height and\n        (face_x, face_y) in target_primitive_locs):\n      # We've found a state from which the primitive can be collected.\n      best_path_actions = path_actions + [USE_ACTION]\n      break # Found the shortest path, exit BFS.\n\n    # Explore possible movement actions (0-3: DOWN, UP, LEFT, RIGHT)\n    for action in range(4): # Loop through movement actions\n      dx, dy = _ACTION_TO_COORD_DIFF[action]\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = action # Agent's new direction is the direction of movement\n\n      # Check if the next position is traversable and if this new state has not been visited yet\n      if _is_traversable(next_x, next_y):\n        next_state_tuple = ((next_x, next_y), next_dir)\n        if next_state_tuple not in visited:\n          visited.add(next_state_tuple)\n          queue.append((next_state_tuple[0], next_state_tuple[1], path_actions + [action]))\n        \n  return best_path_actions if best_path_actions is not None else []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:57:13.386061", "function_name": "collect", "function_body": "  import collections\n\n  # Constants for actions and direction mappings\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4\n\n  # Agent's direction determines which cell 'USE' acts upon.\n  _DIR_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN (facing positive Y)\n      1: (0, -1), # UP (facing negative Y)\n      2: (-1, 0), # LEFT (facing negative X)\n      3: (1, 0)   # RIGHT (facing positive X)\n  }\n\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index.index(primitive)\n  \n  # 1. Check if the primitive is actually collectible based on world configuration.\n  # This filters out attempts to \"collect\" things like workbenches, unless explicitly grabbable or water.\n  grabbable_set = set(env.world.grabbable_indices)\n  water_index = env.world.water_index if hasattr(env.world, 'water_index') else -1 \n\n  if primitive_idx not in grabbable_set and primitive_idx != water_index:\n    # This item is not designated as grabbable or a special collectible (like water).\n    # Therefore, it cannot be collected by this 'collect' function.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # 3. Pre-compute locations of the target primitive on the grid\n  target_primitive_locs = set() # Stores (x, y) coordinates of the primitive\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        target_primitive_locs.add((x, y))\n\n  if not target_primitive_locs:\n    return [] # Primitive not found on the map\n\n  # 4. Define traversability: A cell is traversable if it's within bounds and\n  # does NOT contain *any* item from the non_grabbable_indices set.\n  # This implies non_grabbable items are impassable obstacles.\n  non_grabbable_items_set = set(env.world.non_grabbable_indices)\n\n  def _is_traversable(x, y):\n    \"\"\"\n    Checks if a cell (x, y) is traversable for agent movement.\n    A cell is traversable if it's within bounds and does not contain any\n    item from the world's non_grabbable_indices.\n    \"\"\"\n    # 1. Check boundary conditions\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # 2. Check for impassable obstacles\n    # Iterate through all kinds of entities that might be present at (x, y)\n    # If any kind present at (x, y) is in the non_grabbable_items_set, it's impassable.\n    for k_idx in range(grid.shape[2]): # Iterate through all possible item kinds\n      if grid[x, y, k_idx] > 0 and k_idx in non_grabbable_items_set:\n        return False # This cell contains an impassable obstacle\n    return True\n\n  # 5. BFS Initialization\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Initial direction from CraftState\n\n  # Queue stores tuples of ((current_x, current_y), current_direction, [list_of_actions_to_reach_this_state])\n  queue = collections.deque([((start_pos[0], start_pos[1]), start_dir, [])])\n  \n  # Visited set stores ((x, y), direction) tuples to prevent cycles and redundant path exploration\n  visited = {((start_pos[0], start_pos[1]), start_dir)}\n\n  best_path = None # To store the shortest path found\n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.popleft()\n\n    # Check if we can collect the primitive from the current state (position and direction)\n    # The 'USE' action operates on the cell directly in front of the agent.\n    face_x, face_y = curr_x + _DIR_TO_COORD_DIFF[curr_dir][0],\\\n                     curr_y + _DIR_TO_COORD_DIFF[curr_dir][1]\n\n    if (face_x, face_y) in target_primitive_locs:\n      # Found a state from which the primitive can be collected.\n      # Since BFS explores layer by layer, the first valid path found is the shortest.\n      best_path = path_actions + [USE_ACTION]\n      break # Path found, exit the BFS loop.\n\n    # Explore possible movements (DOWN, UP, LEFT, RIGHT)\n    for action, (dx, dy) in _ACTION_TO_COORD_DIFF.items(): # action 0-3\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = action # Agent faces the direction it moved\n\n      # Check if the next position is traversable and has not been visited with this orientation\n      if _is_traversable(next_x, next_y) and ((next_x, next_y), next_dir) not in visited:\n        visited.add(((next_x, next_y), next_dir))\n        queue.append(((next_x, next_y), next_dir, path_actions + [action]))\n        \n  return best_path if best_path is not None else []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T12:58:32.018121", "function_name": "collect", "function_body": "    # Action constants (hardcoded as per DMLab style)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Action deltas for grid movement (row, col) for (DOWN, UP, LEFT, RIGHT)\n    ACTION_DELTAS = {\n        ACTION_DOWN: (1, 0),\n        ACTION_UP: (-1, 0),\n        ACTION_LEFT: (0, -1),\n        ACTION_RIGHT: (0, 1)\n    }\n\n    state = env._current_state\n    world = state.world\n\n    # Check if the primitive is already in the inventory\n    if state.inventory[primitive] > 0:\n        return []\n\n    HEIGHT, WIDTH = state.grid.shape[:2]\n\n    # Determine if the primitive is grabbable (needs agent to be on the cell)\n    # or non-grabbable/workshop/water (needs agent to be adjacent to the cell)\n    is_grabbable = primitive in world.grabbable_indices\n\n    # Find all cells where the primitive is located on the grid\n    primitive_locations = []\n    for r in range(HEIGHT):\n        for c in range(WIDTH):\n            if state.grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    # If the primitive is not found on the map, no actions can be taken\n    if not primitive_locations:\n        return []\n\n    # Calculate target agent positions for the BFS.\n    # These are the cells the agent needs to be on to successfully\n    # perform the USE action for the primitive.\n    target_agent_positions = set()\n\n    if is_grabbable:\n        # For grabbable items, the agent must be on the same cell as the item.\n        for loc in primitive_locations:\n            target_agent_positions.add(loc)\n    else:\n        # For non-grabbable items (workshops, water, etc.), the agent needs\n        # to be in the 3x3 neighborhood of the item to be able to USE it.\n        # This aligns with the `CraftState.next_to` method's logic.\n        for tr, tc in primitive_locations:\n            for dr in [-1, 0, 1]: # Iterate over 3x3 neighborhood deltas\n                for dc in [-1, 0, 1]:\n                    adj_r, adj_c = tr + dr, tc + dc\n                    # Ensure the adjacent cell is within grid boundaries\n                    if 0 <= adj_r < HEIGHT and 0 <= adj_c < WIDTH:\n                        target_agent_positions.add((adj_r, adj_c))\n\n    # BFS Initialization\n    # Queue stores tuples of (current_position (r,c), list_of_actions_taken)\n    q = collections.deque([(state.pos, [])])\n    # Visited set keeps track of positions already explored to prevent cycles and redundant paths\n    visited = {state.pos}\n\n    # BFS Loop\n    while q:\n        curr_pos, path = q.popleft()\n        r, c = curr_pos\n\n        # Check if the current position is one of the calculated target positions\n        if curr_pos in target_agent_positions:\n            # If so, we found a path. Append the USE action and return.\n            return path + [ACTION_USE]\n\n        # Explore neighboring cells\n        for action_val, (dr, dc) in ACTION_DELTAS.items():\n            nr, nc = r + dr, c + dc # Calculate new position\n            new_pos = (nr, nc)\n\n            # Check if the new position is within grid boundaries and has not been visited\n            if 0 <= nr < HEIGHT and 0 <= nc < WIDTH and new_pos not in visited:\n                visited.add(new_pos) # Mark as visited\n                # Add the new state (position and updated path) to the queue\n                q.append((new_pos, path + [action_val]))\n\n    # If the BFS completes and no path to the primitive is found, return an empty list\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:58:33.019048", "function_name": "collect", "function_body": "  def _find_closest_primitive_coords(grid, current_pos_rc, primitive_idx):\n    \"\"\"\n    Finds the coordinates (row, col) of the closest instance of a primitive in the grid\n    relative to the current position (row, col).\n    Returns (row, col) or None if not found.\n    \"\"\"\n    min_dist = float('inf')\n    closest_coords = None\n    # grid shape is (HEIGHT, WIDTH, N_KINDS)\n    grid_height, grid_width, _ = grid.shape\n\n    for r in range(grid_height):\n        for c in range(grid_width):\n            if grid[r, c, primitive_idx] == 1:\n                # Calculate Manhattan distance\n                dist = abs(r - current_pos_rc[0]) + abs(c - current_pos_rc[1])\n                if dist < min_dist:\n                    min_dist = dist\n                    closest_coords = (r, c)\n    return closest_coords\n\n  actions_taken = []\n  max_collection_attempts = 100 # Safety limit to prevent infinite loops\n\n  # Get initial state by accessing the internal CraftState from CraftLab\n  current_state = env._current_state\n\n  for _ in range(max_collection_attempts):\n      # 1. Check if the primitive is already collected\n      if current_state.inventory[primitive] > 0:\n          break # Goal achieved\n\n      # 2. Check if the agent is next to the primitive\n      # CraftState.next_to(i_kind) checks a 3x3 neighborhood around the agent's position.\n      if current_state.next_to(primitive):\n          action_to_take = env_factory.ACTIONS.USE\n          # Take the USE action and update the environment\n          reward, done, _ = env.step(action_to_take)\n          actions_taken.append(action_to_take)\n          # Update the current_state reference after the action\n          current_state = env._current_state\n          # Re-check inventory immediately after USE, as it might have collected the item\n          if current_state.inventory[primitive] > 0:\n              break # Goal achieved\n\n      else: # 3. Not next to the primitive, need to move\n          # Get the global grid view from observations\n          # env.observations() will return the current observation dict\n          obs_dict = env.observations()\n          grid = obs_dict['features_dict']['features_global']\n          current_pos_rc = current_state.pos # Agent's current (row, col) position\n\n          # Find the closest instance of the primitive on the grid\n          target_coords = _find_closest_primitive_coords(grid, current_pos_rc, primitive)\n\n          if target_coords is None:\n              # Primitive not found on the visible map.\n              # For this version, we stop if we can't see the primitive.\n              break # Cannot find the primitive, give up\n\n          target_r, target_c = target_coords\n          action_to_take = -1 # Default to an invalid action\n\n          # Determine the next movement action based on the target position.\n          # Prioritize moving vertically (rows) first, then horizontally (columns).\n          # This is a greedy approach and does not account for obstacles or full pathfinding.\n          if target_r > current_pos_rc[0]:\n              action_to_take = env_factory.ACTIONS.DOWN\n          elif target_r < current_pos_rc[0]:\n              action_to_take = env_factory.ACTIONS.UP\n          elif target_c > current_pos_rc[1]:\n              action_to_take = env_factory.ACTIONS.RIGHT\n          elif target_c < current_pos_rc[1]:\n              action_to_take = env_factory.ACTIONS.LEFT\n          else:\n              # This 'else' block implies current_pos_rc == target_coords.\n              # If the agent is at the target coordinates, and next_to(primitive) was False,\n              # it indicates a logical inconsistency (e.g., primitive is at agent's spot but not interactable\n              # via next_to, or a definition mismatch). In this case, we cannot move further towards it.\n              break # Cannot move, or already at target but cannot interact\n\n          if action_to_take != -1:\n              # Take the determined movement action\n              reward, done, _ = env.step(action_to_take)\n              actions_taken.append(action_to_take)\n              # Update the current_state reference after the action\n              current_state = env._current_state\n              # The loop will re-evaluate the state (new position, new inventory) in the next iteration.\n          else:\n              # This branch is taken if action_to_take remains -1,\n              # which happens if the agent is at the target_coords but cannot proceed.\n              break\n\n  return actions_taken", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:59:21.936607", "function_name": "collect", "function_body": "", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:59:22.898228", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to its corresponding direction integer (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map agent's direction integer to its (dx, dy) vector (change in position)\n  DIR_VEC = {\n      0: (0, -1),  # UP: decreases y-coordinate\n      1: (1, 0),   # RIGHT: increases x-coordinate\n      2: (0, 1),   # DOWN: increases y-coordinate\n      3: (-1, 0)   # LEFT: decreases y-coordinate\n  }\n\n  # Get the initial state details for the BFS starting point\n  initial_state = env._current_state\n\n  # Improvement: Check if the primitive is already in the inventory.\n  # If it is, no actions are needed to collect it.\n  if initial_state.inventory[primitive] > 0:\n      return []\n\n  # Pre-check: If the primitive is not a grabbable item, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Identify indices of entities that block movement (non-grabbable items like water, workshops etc.)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to determine if a cell is traversable.\n  def is_walkable(x, y):\n    # Check if the coordinates are within grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell contains any non-grabbable item that acts as an obstacle.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False # Cell is blocked by an obstacle\n    return True\n\n  # Initialize Breadth-First Search (BFS)\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n  # Using a list and an index to efficiently simulate a queue.\n  queue = [(start_x, start_y, start_dir, [])]\n  queue_idx = 0\n\n  # Set to keep track of visited states (position and direction) to avoid cycles and redundant paths.\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue_idx < len(queue):\n    curr_x, curr_y, curr_dir, path_actions = queue[queue_idx]\n    queue_idx += 1 # Dequeue the current state\n\n    # Check if the primitive can be collected from the current state.\n    # The 'USE' action affects the cell directly in front of the agent.\n    faced_dx, faced_dy = DIR_VEC[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # If the cell in front is within bounds and contains the target primitive:\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Goal reached! Return the accumulated path actions plus the final 'USE' action.\n      return path_actions + [ACTION_USE]\n\n    # Explore all possible movement actions from the current state.\n    # Each movement action also sets the agent's new facing direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new position after performing this action.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # The agent's new facing direction\n\n      # If the next cell is walkable and this new (position, direction) state has not been visited yet:\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        # Enqueue the new state with its path.\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the BFS completes and no path to collect the primitive is found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:01:17.473414", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:01:17.543635", "function_name": "collect", "function_body": "    # Action constants (from CraftLab.action_specs())\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Direction constants for CraftState.dir (assuming DMLab convention: 0:N, 1:E, 2:S, 3:W)\n    DIR_UP = 0\n    DIR_RIGHT = 1\n    DIR_DOWN = 2\n    DIR_LEFT = 3\n\n    action_list = []\n    \n    # Reset environment to get initial state\n    _ = env.reset()\n    current_state = env._current_state\n\n    # Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    MAX_ITERATIONS = 500 # Safety limit to prevent excessively long action sequences\n\n    for _ in range(MAX_ITERATIONS):\n        if current_state.inventory[primitive] > 0:\n            break # Primitive collected, exit loop\n\n        agent_x, agent_y = current_state.pos\n        # Note: numpy arrays are typically (rows, cols), so grid.shape is (height, width, kinds)\n        grid_height, grid_width, _ = current_state.grid.shape \n\n        target_primitive_pos = None\n        min_dist = float('inf')\n\n        # Find the closest primitive location on the grid\n        for py in range(grid_height):\n            for px in range(grid_width):\n                if current_state.grid[py, px, primitive] > 0:\n                    # Manhattan distance\n                    dist = abs(px - agent_x) + abs(py - agent_y)\n                    if dist < min_dist:\n                        min_dist = dist\n                        target_primitive_pos = (px, py)\n        \n        # If primitive is not found on the grid (e.g., already picked up, or world changed unexpectedly)\n        if target_primitive_pos is None:\n            break # Cannot find the primitive, stop trying\n\n        target_x, target_y = target_primitive_pos\n        dx_to_target = target_x - agent_x\n        dy_to_target = target_y - agent_y\n\n        # Determine if we are on the primitive or next to it (min_dist <= 1)\n        if min_dist <= 1: \n            # Identify the specific cell containing the primitive (could be current_pos or a neighbor)\n            primitive_cell_x, primitive_cell_y = -1, -1\n            if min_dist == 0: # Agent is on the primitive\n                primitive_cell_x, primitive_cell_y = agent_x, agent_y\n            else: # min_dist == 1, find which neighbor has it\n                # Check 4 direct neighbors (dx, dy)\n                neighbor_deltas = [(1, 0), (-1, 0), (0, 1), (0, -1)] \n                for dx_n, dy_n in neighbor_deltas:\n                    nx, ny = agent_x + dx_n, agent_y + dy_n\n                    if 0 <= ny < grid_height and 0 <= nx < grid_width and \\\n                       current_state.grid[ny, nx, primitive] > 0:\n                        primitive_cell_x, primitive_cell_y = nx, ny\n                        break\n            \n            if primitive_cell_x == -1: # Safety check, should not happen if min_dist was correctly identified\n                break \n            \n            # Determine desired facing direction towards the primitive cell\n            desired_facing_dir = current_state.dir # Default: if on cell, current dir is fine\n            if primitive_cell_x > agent_x: # Primitive is to the right\n                desired_facing_dir = DIR_RIGHT\n            elif primitive_cell_x < agent_x: # Primitive is to the left\n                desired_facing_dir = DIR_LEFT\n            elif primitive_cell_y > agent_y: # Primitive is below\n                desired_facing_dir = DIR_DOWN\n            elif primitive_cell_y < agent_y: # Primitive is above\n                desired_facing_dir = DIR_UP\n            \n            # Turn to face the primitive\n            while current_state.dir != desired_facing_dir:\n                action_to_turn = ACTION_RIGHT # Always turn right until aligned\n                action_list.append(action_to_turn)\n                _reward, current_state = current_state.step(action_to_turn)\n                if current_state.inventory[primitive] > 0: # Check if collected mid-turn\n                    break \n            \n            if current_state.inventory[primitive] > 0: # Break from outer loop if collected\n                break\n\n            # Use (pick up) the primitive\n            action_list.append(ACTION_USE)\n            _reward, current_state = current_state.step(ACTION_USE)\n            # Loop will re-check inventory in the next iteration.\n            \n        else: # min_dist > 1, need to move towards the target\n            action_to_move = -1\n\n            # Prioritize moving along the axis with the larger absolute distance\n            if abs(dx_to_target) >= abs(dy_to_target):\n                if dx_to_target > 0:\n                    action_to_move = ACTION_RIGHT\n                elif dx_to_target < 0:\n                    action_to_move = ACTION_LEFT\n                # If dx_to_target == 0, then dy_to_target must be non-zero (since min_dist > 1)\n                elif dy_to_target > 0:\n                    action_to_move = ACTION_DOWN\n                elif dy_to_target < 0:\n                    action_to_move = ACTION_UP\n            else: # abs(dy_to_target) > abs(dx_to_target)\n                if dy_to_target > 0:\n                    action_to_move = ACTION_DOWN\n                elif dy_to_target < 0:\n                    action_to_move = ACTION_UP\n                # If dy_to_target == 0, then dx_to_target must be non-zero (since min_dist > 1)\n                elif dx_to_target > 0:\n                    action_to_move = ACTION_RIGHT\n                elif dx_to_target < 0:\n                    action_to_move = ACTION_LEFT\n\n            if action_to_move != -1:\n                action_list.append(action_to_move)\n                _reward, current_state = current_state.step(action_to_move)\n            else:\n                # This case implies dx_to_target == 0 and dy_to_target == 0,\n                # which means min_dist == 0 and should have been handled by the 'min_dist <= 1' block.\n                # If we reach here, it implies no valid move action was chosen, indicating being stuck\n                # or a logical error. Break to prevent an infinite loop.\n                break \n    \n    return action_list", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:02:45.101431", "function_name": "collect", "function_body": "    initial_state = env._current_state\n\n    # 1. Check if the primitive is already in the inventory\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    q = deque()\n    # Queue stores (current_CraftState_object, list_of_actions_to_reach_this_state)\n    q.append((initial_state, []))\n\n    # Visited set stores (pos_tuple, dir_int, inventory_tuple) to avoid cycles and redundant exploration.\n    # Inventory is crucial as collecting items changes the state and potentially reachable paths.\n    visited = set()\n    visited.add((initial_state.pos, initial_state.dir, tuple(initial_state.inventory)))\n\n    # Mapping of agent's internal direction (dir attribute) to (dx, dy) for the cell *in front* of the agent.\n    # Assumes agent's internal directions are ordered: 0 (North/Up, -Y), 1 (East/Right, +X),\n    # 2 (South/Down, +Y), 3 (West/Left, -X). This convention is common in grid worlds.\n    dir_to_facing_delta = {\n        0: (0, -1),  # Facing North (Up)\n        1: (1, 0),   # Facing East (Right)\n        2: (0, 1),   # Facing South (Down)\n        3: (-1, 0)   # Facing West (Left)\n    }\n\n    # A reasonable limit to prevent excessively long or infinite searches\n    MAX_PATH_LENGTH = 500\n\n    while q:\n        current_state, current_path = q.popleft()\n\n        # Check path length limit to prevent exploring paths that are too long\n        if len(current_path) >= MAX_PATH_LENGTH:\n            continue\n\n        # 2. Check if the goal primitive is now in inventory. This might have happened\n        # if a 'USE' action in a previous step led to collection.\n        if current_state.inventory[primitive] > 0:\n            return current_path\n\n        # 3. Consider performing 'USE' action if conditions are met.\n        # This function primarily handles collecting \"primitive resources,\" which are grabbable.\n        if primitive in env.world.grabbable_indices:\n            # Determine the cell the agent is currently facing\n            facing_dx, facing_dy = dir_to_facing_delta[current_state.dir]\n            facing_x, facing_y = current_state.pos[0] + facing_dx, current_state.pos[1] + facing_dy\n\n            grid_width, grid_height, _ = current_state.grid.shape\n\n            # Check if the facing cell is within grid boundaries\n            if 0 <= facing_x < grid_width and 0 <= facing_y < grid_height:\n                # Check if the facing cell contains the target primitive\n                if current_state.grid[facing_x, facing_y, primitive] > 0:\n                    # Agent is facing the primitive. Simulate the 'USE' action.\n                    # The reward is not used for pathfinding, so we ignore it.\n                    _, state_after_use = current_state.step(env_factory.ACTIONS['USE'])\n\n                    # If successful, the primitive count in inventory will increase.\n                    if state_after_use.inventory[primitive] > 0:\n                        return current_path + [env_factory.ACTIONS['USE']]\n                    \n                    # Even if 'USE' didn't yield the primitive (e.g., it was already collected\n                    # by a shorter path, or it was not truly grabbable despite being present),\n                    # the state might have changed (e.g., time step consumed).\n                    # Add this new state to the queue if it hasn't been visited before.\n                    state_key_after_use = (state_after_use.pos, state_after_use.dir, tuple(state_after_use.inventory))\n                    if state_key_after_use not in visited:\n                        visited.add(state_key_after_use)\n                        q.append((state_after_use, current_path + [env_factory.ACTIONS['USE']]))\n\n        # 4. Explore all possible next movement actions (DOWN, UP, LEFT, RIGHT).\n        # These actions move the agent and implicitly update its facing direction.\n        # We prioritize movement actions to explore the grid for primitive locations.\n        for action_name in ['DOWN', 'UP', 'LEFT', 'RIGHT']:\n            action_idx = env_factory.ACTIONS[action_name]\n\n            # Simulate the action to get the next state without modifying the actual environment state.\n            _, next_state = current_state.step(action_idx)\n            \n            # Create a unique key for the visited set based on position, direction, and inventory.\n            state_key = (next_state.pos, next_state.dir, tuple(next_state.inventory))\n\n            if state_key not in visited:\n                visited.add(state_key)\n                q.append((next_state, current_path + [action_idx]))\n\n    # If the queue becomes empty and the primitive has not been collected,\n    # it means no path was found within the search limits.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:02:45.171286", "function_name": "collect", "function_body": "    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    initial_state = env._current_state\n    primitive_idx = primitive  # primitive is already an int index\n\n    # 1. Check if primitive is already in the agent's inventory\n    if initial_state.inventory[primitive_idx] > 0:\n        return []\n\n    # BFS setup\n    # Queue stores tuples of (current_CraftState, list_of_actions_to_reach_this_state)\n    queue = collections.deque([(initial_state, [])])\n\n    # Visited set stores (row, col, direction) tuples to avoid redundant exploration\n    visited = set()\n\n    # Define a reasonable maximum search depth to prevent excessive computation\n    # for unachievable goals or very large grids.\n    # A heuristic: grid size * number of directions.\n    grid_width, grid_height, _ = initial_state.grid.shape\n    max_search_depth = grid_width * grid_height * 4  # Max unique (pos,dir) states\n\n    while queue:\n        current_state, current_path = queue.popleft()\n\n        # Create a unique key for the current state (position and direction)\n        state_key = (current_state.pos[0], current_state.pos[1], current_state.dir)\n\n        # If this state has already been visited, skip it to prevent cycles and redundant work\n        if state_key in visited:\n            continue\n\n        # Mark the current state as visited\n        visited.add(state_key)\n\n        # Check if current path length exceeds max_search_depth\n        if len(current_path) > max_search_depth:\n            continue\n\n        # --- Goal Check: Is the primitive reachable from the current position? ---\n        # Check if the primitive is in the immediate vicinity (3x3 neighborhood)\n        if current_state.next_to(primitive_idx):\n            # If so, attempt the USE action.\n            # CraftState.step returns a new state without modifying the current one.\n            _, state_after_use = current_state.step(ACTION_USE)\n\n            # Check if the USE action successfully collected the primitive\n            if state_after_use.inventory[primitive_idx] > 0:\n                return current_path + [ACTION_USE]\n            # If USE didn't work (e.g., wrong item, obstacle, or not grabbable),\n            # we continue exploring movement paths from current_state.\n\n        # --- Explore Movement Actions ---\n        # Try all four movement directions\n        for action in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n            # Simulate the action to get the next state\n            # reward is always 0.0 for CraftState.step based on docs\n            _, next_state = current_state.step(action)\n\n            # Create a key for the next state\n            next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n            # If the next state has not been visited, add it to the queue\n            if next_state_key not in visited:\n                queue.append((next_state, current_path + [action]))\n\n    # If the queue is exhausted and no path was found leading to collection, return an empty list\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:03:57.247519", "function_name": "collect", "function_body": "  import collections # Need to import this for deque\n  import numpy as np # Used for grid operations and np.where\n\n  # Define action constants for clarity\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Directional deltas for (dx, dy) mapping actions/directions to coordinate changes\n  _DIRECTION_DELTAS = {\n      DOWN: (0, 1),   # Moving/facing DOWN means +1 in Y (assuming Y increases downwards)\n      UP: (0, -1),    # Moving/facing UP means -1 in Y\n      LEFT: (-1, 0),  # Moving/facing LEFT means -1 in X\n      RIGHT: (1, 0)   # Moving/facing RIGHT means +1 in X\n  }\n\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index.index(primitive) # Get the integer ID for the given primitive\n\n  current_state = env._current_state\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # 1. Early exit: If the primitive is already in the agent's inventory\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # No actions needed if already collected\n\n  # 2. Early exit: Check if the primitive is actually collectible based on world configuration.\n  #    It must either be in the `grabbable_indices` set, or be the special `water_index`.\n  grabbable_set = set(env.world.grabbable_indices)\n  \n  is_water_primitive = False\n  if hasattr(env.world, 'water_index') and primitive_idx == env.world.water_index:\n      is_water_primitive = True\n\n  if primitive_idx not in grabbable_set and not is_water_primitive:\n    # This item cannot be picked up or collected by the USE action, so return empty path.\n    return []\n\n  # 3. Pre-compute all grid locations where the target primitive exists.\n  target_primitive_locs = set() # Stores (x, y) coordinates of cells containing the primitive\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        target_primitive_locs.add((x, y))\n\n  if not target_primitive_locs:\n    return [] # Primitive not found anywhere on the map, so it's unreachable.\n\n  # 4. Define traversability: A cell is traversable if it's within grid boundaries and\n  #    does NOT contain any item from the `non_grabbable_indices` set (which act as obstacles).\n  impassable_kinds = set(env.world.non_grabbable_indices)\n\n  def _is_traversable(x, y):\n    \"\"\"\n    Checks if a cell (x, y) is traversable for agent movement.\n    A cell is traversable if it's within bounds and does not contain any\n    object classified as an impassable kind.\n    \"\"\"\n    # First, check boundary conditions\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Get the indices of all kinds present at cell (x,y)\n    present_kinds_at_cell = np.where(grid[x, y, :] > 0)[0]\n    \n    # Check if any of the present kinds are considered impassable\n    for k_val in present_kinds_at_cell:\n      if k_val in impassable_kinds:\n        return False # This cell contains an impassable obstacle\n    return True\n\n  # 5. Breadth-First Search (BFS) to find the shortest path to a collectible primitive.\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Initial direction from the CraftState\n\n  # The queue stores tuples: ((current_x, current_y), current_direction, [list_of_actions_to_reach_this_state])\n  queue = collections.deque([((start_pos[0], start_pos[1]), start_dir, [])])\n  \n  # The `visited` set stores ((x, y), direction) tuples to avoid cycles and redundant state exploration.\n  # The agent's direction matters because it affects the outcome of the 'USE' action.\n  visited = {((start_pos[0], start_pos[1]), start_dir)}\n\n  shortest_path = None # This will store the first (and thus shortest) path found\n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.popleft()\n\n    # Check if the primitive can be collected from the current state.\n    # The 'USE' action targets the cell directly in front of the agent.\n    face_dx, face_dy = _DIRECTION_DELTAS[curr_dir]\n    face_x, face_y = curr_x + face_dx, curr_y + face_dy\n\n    # If the cell in front is within bounds and contains the target primitive\n    if (0 <= face_x < grid_width and 0 <= face_y < grid_height and\n        (face_x, face_y) in target_primitive_locs):\n      # Found a state from which the primitive can be collected.\n      # Since BFS explores layer by layer, the first valid path found is guaranteed to be the shortest.\n      shortest_path = path_actions + [USE] # Add the final USE action\n      break # Path found, exit the BFS loop.\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    for action_idx in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      move_dx, move_dy = _DIRECTION_DELTAS[action_idx]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = action_idx # When moving, the agent's direction changes to the direction of movement.\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n      \n      # Check if the next position is traversable AND this specific (position, direction) state\n      # has not been visited yet to avoid redundant work and loops.\n      if _is_traversable(next_x, next_y) and next_state_tuple not in visited:\n        visited.add(next_state_tuple)\n        # Add the new state to the queue along with the accumulated path\n        queue.append((next_state_tuple[0], next_state_tuple[1], path_actions + [action_idx]))\n        \n  return shortest_path if shortest_path is not None else []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T13:03:58.211446", "function_name": "collect", "function_body": "  # Constants for actions and direction mappings\n  ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4\n\n  # Get references to key components for convenience\n  world = env.world\n  cookbook = world.cookbook\n  current_state = env._current_state\n\n  # 1. Determine the integer index for the target primitive\n  primitive_idx = cookbook.index.index(primitive)\n  \n  # 2. Early exit if primitive is already in inventory\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Early exit if the primitive is not collectible via 'USE' action.\n  # Convert grabbable_indices to a frozenset for efficient lookups.\n  grabbable_set = frozenset(world.grabbable_indices)\n  water_idx = world.water_index if hasattr(world, 'water_index') else -1\n  \n  if primitive_idx not in grabbable_set and primitive_idx != water_idx:\n    return [] # Cannot collect this primitive with a USE action\n\n  # 4. Grid dimensions and pre-computation of target primitive locations\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  target_primitive_locs = set()\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        target_primitive_locs.add((x, y))\n\n  if not target_primitive_locs:\n    return [] # Primitive not found on the map\n\n  # 5. Define traversability: a cell is traversable if it's within bounds\n  # and does not contain any entity from the world's non_grabbable_indices.\n  # Convert non_grabbable_indices to a frozenset for efficient lookups.\n  impassable_kinds = frozenset(world.non_grabbable_indices)\n\n  def is_traversable(x, y):\n    \"\"\"\n    Checks if a cell (x, y) is traversable for agent movement.\n    It must be within grid bounds and not contain any impassable obstacle.\n    \"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Get all item kinds present at (x, y) by finding non-zero entries in the grid layer.\n    present_kinds_at_cell_indices = np.where(grid[x, y] > 0)[0]\n    \n    # Check if any of these present kinds are also in the set of impassable kinds.\n    # If the intersection is not empty, it means the cell contains an obstacle.\n    # Using frozenset for the present kinds and checking isdisjoint is efficient.\n    if not frozenset(present_kinds_at_cell_indices).isdisjoint(impassable_kinds):\n        return False # Contains an impassable obstacle\n    return True\n\n  # 6. Breadth-First Search (BFS) for the shortest path\n  # BFS state: ((current_x, current_y), current_direction)\n  # Queue stores: (current_pos_tuple, current_dir_int, list_of_actions_taken_to_reach_this_state)\n  queue = collections.deque()\n  visited = set() # Stores ((x, y), direction) tuples to prevent cycles and redundant exploration\n\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  \n  queue.append((start_pos, start_dir, []))\n  visited.add((start_pos, start_dir))\n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.popleft()\n\n    # Check if a 'USE' action can be performed from the current state\n    # The 'USE' action targets the cell directly in front of the agent.\n    dx_face, dy_face = ACTION_TO_COORD_DIFF[curr_dir]\n    face_x, face_y = curr_x + dx_face, curr_y + dy_face\n\n    if (face_x, face_y) in target_primitive_locs:\n      # Found the shortest path to a state where USE can collect the primitive.\n      return path_actions + [USE_ACTION]\n\n    # Explore valid neighbor states via movement actions (0-3)\n    for action in range(4): # Iterate through DOWN, UP, LEFT, RIGHT actions\n      dx_move, dy_move = ACTION_TO_COORD_DIFF[action]\n      next_x, next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = action # Agent's direction changes to the direction of movement\n\n      next_state_tuple = ((next_x, next_y), next_dir)\n\n      # Check if the next position is traversable and this (position, direction) state\n      # has not been visited yet to avoid redundant paths and cycles.\n      if is_traversable(next_x, next_y) and next_state_tuple not in visited:\n        visited.add(next_state_tuple)\n        queue.append(((next_x, next_y), next_dir, path_actions + [action]))\n        \n  return [] # If the queue becomes empty and no path was found, the primitive is unreachable.", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:05:10.349443", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n  import heapq # For A* priority queue\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Maps movement actions to (dx, dy) changes in position.\n  # These define the change in coordinates when moving in a specific direction.\n  DIRS_VEC = {\n      ACTION_UP: (0, -1),\n      ACTION_RIGHT: (1, 0),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0)\n  }\n\n  # Maps movement actions to the agent's new facing direction.\n  # Agent directions: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Maps agent direction (int) to (dx, dy) of the cell it faces.\n  # This is for determining the target cell for the USE action.\n  DIR_TO_COORDS_CHANGE = {\n      0: (0, -1),  # UP (faces cell above current pos)\n      1: (1, 0),   # RIGHT (faces cell to the right)\n      2: (0, 1),   # DOWN (faces cell below)\n      3: (-1, 0)   # LEFT (faces cell to the left)\n  }\n\n  current_state = env._current_state\n  \n  # 1. Pre-checks: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n  \n  # If the primitive is already in inventory, no actions needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid # Access grid directly for efficiency\n  grid_width, grid_height, _ = grid.shape\n\n  non_grabbable_indices = env.world.non_grabbable_indices\n  \n  # Helper function to check if a grid cell is within bounds and not an obstacle.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    # Check if the cell is occupied by a non-grabbable item (which acts as an obstacle).\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # 2. Identify all target states (position, direction) from which the primitive can be collected.\n  # A target state is (agent_x, agent_y, agent_dir) such that (agent_x, agent_y) is walkable,\n  # and the cell faced by the agent (ax + dx_faced, ay + dy_faced) contains the primitive.\n  target_states = set()\n  \n  # Find all (x, y) coordinates where the primitive kind exists on the grid.\n  primitive_locations = np.argwhere(grid[:, :, primitive] == 1) \n\n  if len(primitive_locations) == 0:\n      return [] # No primitive found on the map\n\n  for px, py in primitive_locations:\n    # For each primitive location (px, py), consider all 4 adjacent cells for agent's position.\n    # An agent at (ax, ay) needs to face (px, py).\n    for agent_dir, (dx_faced, dy_faced) in DIR_TO_COORDS_CHANGE.items():\n      # Calculate the required agent position (ax, ay) to face (px, py).\n      # ax = px - dx_faced, ay = py - dy_faced\n      ax, ay = px - dx_faced, py - dy_faced\n      \n      # Check if this potential agent position is within bounds and walkable.\n      if is_walkable(ax, ay):\n        target_states.add((ax, ay, agent_dir))\n\n  # If no valid collection points are found, return an empty path.\n  if not target_states:\n    return []\n\n  # Heuristic function for A* (Manhattan distance from agent's position to closest target agent position)\n  # It's an admissible heuristic as it never overestimates the true cost.\n  def heuristic(x, y):\n      min_h = float('inf')\n      # We only consider position for heuristic, not direction, as turning is part of movement cost.\n      for tx, ty, _ in target_states:\n          min_h = min(min_h, abs(x - tx) + abs(y - ty))\n      return min_h\n\n  # 3. A* Search Algorithm\n  start_state = (start_x, start_y, start_dir)\n\n  # Priority queue (min-heap): stores tuples of (f_score, state_tuple)\n  # f_score = g_score + h_score\n  open_set = [(heuristic(start_x, start_y), start_state)]\n  \n  # g_score[state] is the cost of the cheapest path from the start_state to state currently known.\n  g_score = {start_state: 0}\n  \n  # came_from[state] is the state and action preceding this state on the cheapest path found so far.\n  # Used to reconstruct the path after finding the goal.\n  came_from = {} # Maps (x,y,dir) -> ((prev_x,prev_y,prev_dir), action_taken)\n\n  # Set of states that have been fully evaluated (their g_score is final).\n  closed_set = set() \n\n  while open_set:\n    # Get the state with the lowest f_score from the priority queue.\n    current_f_score, current_state = heapq.heappop(open_set)\n    curr_x, curr_y, curr_dir = current_state\n\n    # If this state has already been processed with a better or equal path, skip it.\n    if current_state in closed_set:\n        continue\n    closed_set.add(current_state)\n\n    # Goal Check: If the current state is one of our pre-calculated target collection states,\n    # we have found the shortest path to a collection point.\n    if current_state in target_states:\n      # Reconstruct the path by backtracking from the goal state to the start state.\n      path_actions = []\n      temp_state = current_state\n      while temp_state != start_state:\n        prev_state, action_taken = came_from[temp_state]\n        path_actions.insert(0, action_taken) # Insert at the beginning to maintain order\n        temp_state = prev_state\n      return path_actions + [ACTION_USE] # Append the USE action and return.\n\n    # Explore possible next states by applying movement actions.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new position and direction after the action.\n      move_dx, move_dy = DIRS_VEC[action]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # Agent faces the direction of movement after this action\n      next_state = (next_x, next_y, next_dir)\n\n      # Check if the new cell is within bounds and walkable (not an obstacle).\n      if not is_walkable(next_x, next_y):\n        continue\n\n      # The cost to move from current_state to next_state is 1 (one action).\n      tentative_g_score = g_score[current_state] + 1\n\n      # If this path to next_state is better than any previously found, or if next_state is new:\n      if tentative_g_score < g_score.get(next_state, float('inf')):\n        g_score[next_state] = tentative_g_score\n        f_score = tentative_g_score + heuristic(next_x, next_y)\n        came_from[next_state] = (current_state, action)\n        \n        # Add the next_state to the open set for future exploration.\n        # It's okay if a state is added multiple times with different f_scores;\n        # the closed_set check ensures we only process the best one.\n        heapq.heappush(open_set, (f_score, next_state))\n  \n  # If the open_set becomes empty and no path to any target state was found,\n  # it means the primitive is unreachable (e.g., completely surrounded by obstacles).\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T13:05:11.317717", "function_name": "collect", "function_body": "  # Action constants (from CraftLab.action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement actions to the agent's new facing direction (CraftState.dir: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # When the agent takes a movement action, it also turns to face that direction.\n  MOVE_ACTION_TO_NEW_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  # Map agent direction (int) to (dx, dy) of the cell it faces.\n  # This defines the relative coordinates of the cell the agent is looking at.\n  DIR_TO_FACED_CELL_DELTA = {\n      0: (0, -1),  # UP (faces cell above current pos)\n      1: (1, 0),   # RIGHT (faces cell to the right)\n      2: (0, 1),   # DOWN (faces cell below)\n      3: (-1, 0)   # LEFT (faces cell to the left)\n  }\n\n  # Map movement actions to their (dx, dy) effect on the agent's position.\n  MOVE_ACTION_TO_POS_DELTA = {\n      ACTION_DOWN: (0, 1),\n      ACTION_UP: (0, -1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # 1. Pre-checks for collectability and immediate goal satisfaction:\n  #    a. If the primitive itself is not a grabbable item according to the world rules,\n  #       it cannot be \"collected\" by the agent.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  #    b. If the primitive is already present in the agent's inventory,\n  #       no further actions are needed to collect it. This is a key improvement\n  #       to avoid unnecessary pathfinding when the goal is already met.\n  if env._current_state.inventory[primitive] > 0:\n    return []\n\n  # Get current state information for pathfinding\n  current_x, current_y = env._current_state.pos\n  current_dir = env._current_state.dir\n  # Access the global grid view from the current observation\n  grid = env.observations()['features_dict']['features_global']\n  grid_width, grid_height, _ = grid.shape\n\n  # Get indices of entities that block movement\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to determine if a grid cell is traversable.\n  def is_walkable(x, y):\n    # Check if the coordinates are within the grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell contains any non-grabbable item, which acts as an obstacle.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False\n    return True\n\n  # 2. Initial check: Can the primitive be collected from the agent's current position?\n  #    Calculate the coordinates of the cell the agent is currently facing.\n  faced_cell_dx, faced_cell_dy = DIR_TO_FACED_CELL_DELTA[current_dir]\n  faced_x, faced_y = current_x + faced_cell_dx, current_y + faced_cell_dy\n\n  # If the faced cell is valid and contains the primitive, a single USE action is sufficient.\n  if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n      grid[faced_x, faced_y, primitive] == 1):\n    return [ACTION_USE]\n\n  # 3. Breadth-First Search (BFS) to find the shortest path to a collection point.\n  #    A state in our BFS is defined by (agent_x, agent_y, agent_direction).\n  #    The queue will store tuples of (agent_x, agent_y, agent_direction, list_of_actions_to_reach_here).\n  q = collections.deque()\n  visited = set() # Stores (x, y, dir) tuples to prevent revisiting states and cycles.\n\n  # Start the BFS from the agent's current state.\n  q.append((current_x, current_y, current_dir, []))\n  visited.add((current_x, current_y, current_dir))\n\n  while q:\n    cx, cy, c_dir, c_path = q.popleft() # Dequeue the current state and its path.\n\n    # Explore all possible movement actions from the current state.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new agent's position after taking this movement action.\n      move_dx, move_dy = MOVE_ACTION_TO_POS_DELTA[action]\n      nx, ny = cx + move_dx, cy + move_dy\n\n      # Calculate the new agent's facing direction after taking this movement action.\n      n_dir = MOVE_ACTION_TO_NEW_DIR[action]\n\n      # Check if the potential new agent position is walkable.\n      if is_walkable(nx, ny):\n        # Now, check if from this new position (nx, ny) and facing n_dir,\n        # the agent can successfully collect the primitive using ACTION_USE.\n        faced_cell_dx, faced_cell_dy = DIR_TO_FACED_CELL_DELTA[n_dir]\n        target_collect_x, target_collect_y = nx + faced_cell_dx, ny + faced_cell_dy\n\n        # Check if the cell that would be \"used\" is within bounds and contains the primitive.\n        if (0 <= target_collect_x < grid_width and 0 <= target_collect_y < grid_height and\n            grid[target_collect_x, target_collect_y, primitive] == 1):\n          # Goal found! Return the sequence of actions that led to this state,\n          # followed by the movement action that got the agent to the collection spot,\n          # and finally the ACTION_USE.\n          return c_path + [action, ACTION_USE]\n\n        # If this isn't a goal state, add it to the queue for further exploration\n        # if this specific (position, direction) state hasn't been visited before.\n        next_state_tuple = (nx, ny, n_dir)\n        if next_state_tuple not in visited:\n          visited.add(next_state_tuple)\n          q.append((nx, ny, n_dir, c_path + [action]))\n\n  # If the BFS completes and no path to collect the primitive was found,\n  # it means the primitive is unreachable (e.g., completely surrounded by obstacles, or not on map).\n  return []", "island_id": 6, "scores": {"3": 0.0}}
