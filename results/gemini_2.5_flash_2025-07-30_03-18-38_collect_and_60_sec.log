{"timestamp": "2025-07-30T17:05:25.991569", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (as defined in the problem description)\n  _DOWN = 0\n  _UP = 1\n  _LEFT = 2\n  _RIGHT = 3\n  _USE = 4\n\n  # Check if the primitive is already in the inventory\n  if env._current_state.inventory[primitive] > 0:\n    return []\n\n  initial_state = env._current_state\n\n  # Find the coordinates of the primitive on the grid\n  grid = initial_state.grid\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n  primitive_layer = grid[..., primitive]\n  primitive_coords = np.argwhere(primitive_layer > 0)\n\n  if len(primitive_coords) == 0:\n    # Primitive not found on the grid\n    return []\n\n  # For simplicity, pick the first occurrence found\n  target_px, target_py = primitive_coords[0]\n\n  # BFS queue: stores tuples of (CraftState, list_of_actions_to_reach_this_state)\n  q = collections.deque([(initial_state, [])])\n\n  # Visited set: stores (position_tuple, direction_int) to avoid cycles and redundant exploration\n  visited = set([(initial_state.pos, initial_state.dir)])\n\n  # Mapping of movement actions to their effects on (dx, dy) and resulting agent direction\n  # Agent directions: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT (inferred from common CraftWorld implementations)\n  _move_definitions = {\n      _DOWN: (0, 1, 2),  # (dx, dy, new_direction)\n      _UP: (0, -1, 0),\n      _LEFT: (-1, 0, 3),\n      _RIGHT: (1, 0, 1)\n  }\n  _move_actions = [_DOWN, _UP, _LEFT, _RIGHT]\n\n  best_plan = None\n\n  # BFS loop\n  while q:\n    current_s, current_plan = q.popleft()\n\n    # Check if the current state allows the USE action to collect the primitive\n    agent_x, agent_y = current_s.pos\n    agent_dir = current_s.dir\n\n    # Calculate the cell directly in front of the agent based on its current direction\n    front_x, front_y = agent_x, agent_y\n    if agent_dir == 0:  # UP\n      front_y -= 1\n    elif agent_dir == 1:  # RIGHT\n      front_x += 1\n    elif agent_dir == 2:  # DOWN\n      front_y += 1\n    elif agent_dir == 3:  # LEFT\n      front_x -= 1\n\n    # If the cell in front of the agent is the primitive's location (and in bounds),\n    # then we can perform the USE action. This is the goal state for our BFS.\n    if (0 <= front_x < WIDTH and 0 <= front_y < HEIGHT) and \\\n       (front_x, front_y) == (target_px, target_py):\n      best_plan = current_plan + [_USE]\n      break  # Found the shortest path, exit BFS\n\n    # Explore possible next steps (movement actions)\n    for action_move in _move_actions:\n      # Calculate the potential next position if this action is taken\n      dx, dy, _ = _move_definitions[action_move]\n      potential_next_x, potential_next_y = agent_x + dx, agent_y + dy\n\n      # Check if the potential next position is within grid boundaries\n      if not (0 <= potential_next_x < WIDTH and 0 <= potential_next_y < HEIGHT):\n        continue  # Cannot move out of bounds\n\n      # Check if the potential next position is blocked by a non-grabbable entity\n      # We check the initial_state's grid, assuming non-grabbable items don't move or disappear\n      is_blocked_destination = False\n      for k_idx in initial_state.world.non_grabbable_indices:\n        if grid[potential_next_x, potential_next_y, k_idx] > 0:\n          is_blocked_destination = True\n          break\n      if is_blocked_destination:\n        continue  # Cannot move into a blocked cell\n\n      # Simulate the step using the CraftState's step method.\n      # This method updates grid, position, direction, and inventory according to game rules.\n      reward, next_s = current_s.step(action_move)\n\n      # Check if the agent actually moved (i.e., not blocked by internal game logic)\n      # and if this specific (position, direction) state has not been visited yet.\n      if (next_s.pos, next_s.dir) not in visited:\n        visited.add((next_s.pos, next_s.dir))\n        q.append((next_s, current_plan + [action_move]))\n\n  if best_plan is None:\n    return []  # No path found to collect the primitive\n\n  return best_plan", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:05:26.993544", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  def state_to_hashable(state):\n    \"\"\"Converts a CraftState instance into a hashable tuple for use in a set.\n\n    Args:\n      state: A CraftState instance.\n\n    Returns:\n      A hashable tuple representing the state's grid, position, direction, and inventory.\n    \"\"\"\n    # Use tobytes() for the grid for efficiency and hashability.\n    grid_bytes = state.grid.tobytes()\n    # Convert numpy inventory array to a tuple for hashability.\n    inventory_tuple = tuple(state.inventory.tolist())\n    # The agent's position (tuple) and direction (int) are already hashable.\n    return (grid_bytes, state.pos, state.dir, inventory_tuple)\n\n  # Reset the environment to a known initial state.\n  # This will internally update `env._current_state` to the scenario's initial state.\n  _ = env.reset()\n  initial_craft_state = env._current_state\n\n  # Check if the primitive is already in the inventory at the start.\n  if initial_craft_state.inventory[primitive] > 0:\n    return []\n\n  # Get action mappings from the environment's action specifications.\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Determine if the primitive typically requires a 'USE' action to be collected.\n  # This is true for non-grabbable primitive resources like water or stone.\n  # We check if it's explicitly listed as a primitive in the cookbook AND it's\n  # in the world's non-grabbable indices.\n  requires_use = (\n      primitive in env.world.cookbook.primitives and\n      primitive in env.world.non_grabbable_indices\n  )\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element in the queue is a tuple: (current_CraftState_instance, list_of_actions_to_reach_this_state).\n  q = deque()\n  q.append((initial_craft_state, []))\n\n  # Initialize the set of visited states to avoid redundant exploration and cycles.\n  visited = set()\n  visited.add(state_to_hashable(initial_craft_state))\n\n  # Set a maximum search depth to prevent infinite loops or excessively long computations.\n  # This is a heuristic to manage computational complexity.\n  MAX_SEARCH_DEPTH = 100\n\n  while q:\n    current_state, current_path = q.popleft()\n\n    # Goal check: If the primitive is now in the inventory, we found a path.\n    if current_state.inventory[primitive] > 0:\n      return current_path\n\n    # Prune search if the current path length exceeds the maximum allowed depth.\n    if len(current_path) >= MAX_SEARCH_DEPTH:\n      continue\n\n    # --- Explore 'USE' action if applicable ---\n    # The 'USE' action is considered if the primitive requires it and the agent\n    # is currently adjacent to (or on top of) the primitive's location.\n    if requires_use and current_state.next_to(primitive):\n      # Simulate the 'USE' action on a copy of the current state.\n      # `current_state.step()` returns a new CraftState instance.\n      _reward, next_state_use = current_state.step(ACTION_USE)\n      new_path_use = current_path + [ACTION_USE]\n\n      # If 'USE' successfully collected the primitive, return this path immediately.\n      if next_state_use.inventory[primitive] > 0:\n        return new_path_use\n\n      # Add the resulting state to the queue if it hasn't been visited yet.\n      hashable_next_state_use = state_to_hashable(next_state_use)\n      if hashable_next_state_use not in visited:\n        visited.add(hashable_next_state_use)\n        q.append((next_state_use, new_path_use))\n\n    # --- Explore movement actions (DOWN, UP, LEFT, RIGHT) ---\n    movement_actions = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]\n    for action_code in movement_actions:\n      # Simulate each possible movement action.\n      _reward, next_state_move = current_state.step(action_code)\n      new_path_move = current_path + [action_code]\n\n      # Check if the movement itself collected the item. This is common for grabbable items\n      # that are picked up simply by stepping onto their tile.\n      if next_state_move.inventory[primitive] > 0:\n        return new_path_move\n\n      # Add the resulting state to the queue if it hasn't been visited yet.\n      hashable_next_state_move = state_to_hashable(next_state_move)\n      if hashable_next_state_move not in visited:\n        visited.add(hashable_next_state_move)\n        q.append((next_state_move, new_path_move))\n\n  # If the queue becomes empty and the primitive has not been collected,\n  # it means no valid path was found within the search limits.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:06:34.440072", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Direction constants (0=N, 1=E, 2=S, 3=W clockwise from North)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Get primitive's integer ID\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir # Agent's current facing direction\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Impassable items are those that cannot be picked up or moved through.\n  # The `non_grabbable_indices` set from CraftWorld is used for obstacles.\n  impassable_kinds = env.world.non_grabbable_indices\n\n  def is_passable(x, y):\n    \"\"\"Checks if a cell (x, y) is within bounds and does not contain impassable objects.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    \n    # Check if the cell contains any impassable kind\n    for kind_idx in impassable_kinds:\n      if grid[y, x, kind_idx] == 1:\n        return False # Contains an impassable object\n    return True\n\n  # Find all locations of the primitive on the grid\n  # np.where returns (row_indices, col_indices) which correspond to (y_coords, x_coords)\n  primitive_locations = set() # Store as a set for faster lookup\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n\n  if not primitive_locations:\n    return [] # Primitive not found on the grid\n\n  # --- BFS to find the shortest path to a state from which the primitive can be 'USE'd ---\n  # BFS state: (x, y, dir) - position and facing direction\n  # Queue stores (current_x, current_y, current_dir, path_actions_taken)\n  q = collections.deque([(agent_pos_x, agent_pos_y, agent_dir, [])])\n  # Visited set stores (x, y, dir) tuples to prevent cycles and redundant exploration\n  visited = set([(agent_pos_x, agent_pos_y, agent_dir)])\n\n  # Defines the effects of movement actions: (dx, dy) change and resulting agent direction\n  # This matches how CraftState.step updates agent state after a move action.\n  move_action_effects = {\n      UP_ACTION: ((0, -1), NORTH_DIR),    # Move up: (x, y-1), face North\n      DOWN_ACTION: ((0, 1), SOUTH_DIR),   # Move down: (x, y+1), face South\n      LEFT_ACTION: ((-1, 0), WEST_DIR),   # Move left: (x-1, y), face West\n      RIGHT_ACTION: ((1, 0), EAST_DIR)    # Move right: (x+1, y), face East\n  }\n\n  while q:\n    curr_x, curr_y, curr_dir, path = q.popleft()\n\n    # --- Check if the current state allows for immediate 'USE' of the primitive ---\n    # Calculate the cell directly in front of the agent based on its current direction\n    item_x_in_front, item_y_in_front = curr_x, curr_y\n    if curr_dir == NORTH_DIR:\n        item_y_in_front -= 1\n    elif curr_dir == EAST_DIR:\n        item_x_in_front += 1\n    elif curr_dir == SOUTH_DIR:\n        item_y_in_front += 1\n    elif curr_dir == WEST_DIR:\n        item_x_in_front -= 1\n    \n    # If the cell in front is within bounds and contains the target primitive\n    if (0 <= item_x_in_front < grid_width and \n        0 <= item_y_in_front < grid_height and\n        (item_x_in_front, item_y_in_front) in primitive_locations):\n      # We have found a path to a state from which USE is possible.\n      return path + [USE_ACTION]\n\n    # --- Explore next states from the current state ---\n\n    # 1. Explore movement actions (change position and facing direction)\n    for action, ((dx, dy), resulting_dir) in move_action_effects.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = resulting_dir # Agent's direction changes to face the direction of movement\n\n      if is_passable(next_x, next_y):\n        next_state = (next_x, next_y, next_dir)\n        if next_state not in visited:\n          visited.add(next_state)\n          q.append((next_x, next_y, next_dir, path + [action]))\n\n    # 2. Explore turning actions (change facing direction only, position remains the same)\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      next_x, next_y = curr_x, curr_y # Position does not change for a pure turn\n      \n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4 # Turn clockwise\n      \n      next_state = (next_x, next_y, next_dir)\n      if next_state not in visited:\n        visited.add(next_state)\n        q.append((next_x, next_y, next_dir, path + [turn_action]))\n  \n  # If the queue becomes empty and no path was found to any primitive\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:06:35.411321", "function_name": "collect", "function_body": "  import collections\n\n  # Helper function: Maps movement actions to the direction the agent faces after taking that action\n  ACTION_TO_FACING_DIR = {\n      UP_ACTION: NORTH_DIR,\n      RIGHT_ACTION: EAST_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR\n  }\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"Calculates the direction the agent needs to face to look at the item.\n    Assumes item is exactly one cardinal step away from agent.\n    \"\"\"\n    if item_x > agent_x: return EAST_DIR  # Item is to the right\n    if item_x < agent_x: return WEST_DIR  # Item is to the left\n    if item_y > agent_y: return SOUTH_DIR # Item is below\n    if item_y < agent_y: return NORTH_DIR # Item is above\n    return None # Should not happen for valid cardinal adjacency (agent and item at same spot, or diagonal)\n\n  # Get primitive's integer ID\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir\n  \n  # grid.shape is (HEIGHT, WIDTH, KINDS)\n  grid_height, grid_width, _ = grid.shape \n\n  # Impassable items are those that cannot be picked up or moved through.\n  # The `non_grabbable_indices` set from CraftWorld is used for this.\n  impassable_kinds = env.world.non_grabbable_indices\n\n  def is_passable(x, y):\n    \"\"\"Checks if a cell (x, y) is within bounds and does not contain impassable objects.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    \n    # Check if the cell contains any impassable kind\n    for kind_idx in impassable_kinds:\n      if grid[y, x, kind_idx] == 1:\n        return False # Contains an impassable object\n    return True\n\n  # Find all locations of the primitive on the grid\n  # np.where returns (row_indices, col_indices) which correspond to (y_coords, x_coords)\n  primitive_locations = set() # Use a set for efficient lookups\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n\n  if not primitive_locations:\n    return [] # Primitive not found on the grid\n\n  # --- BFS to find the shortest path (actions) to a state from which 'USE' can be called ---\n  # Queue stores (x, y, current_direction, path_actions_taken)\n  q = collections.deque([(agent_pos_x, agent_pos_y, agent_dir, [])])\n  # Visited set stores (x, y, dir) tuples to prevent cycles and re-exploring same state\n  visited = set([(agent_pos_x, agent_pos_y, agent_dir)])\n\n  # Movement deltas for cardinal directions (dx, dy)\n  move_deltas = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  while q:\n    curr_x, curr_y, curr_dir, path = q.popleft()\n\n    # --- Check if current state is a goal state (can use the primitive) ---\n    # Agent is at (curr_x, curr_y) facing curr_dir.\n    # Check all 4 cardinal neighbors to see if any contain the primitive.\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (dx_adj, dy_adj) from agent to potential item\n      item_x, item_y = curr_x + dx_adj, curr_y + dy_adj\n\n      if (item_x, item_y) in primitive_locations:\n        # Agent is adjacent to a primitive. Check if facing correctly.\n        target_face_dir = _get_target_facing_direction(curr_x, curr_y, item_x, item_y)\n        if target_face_dir == curr_dir:\n          # Found a state where agent is at (curr_x, curr_y), facing curr_dir,\n          # and a primitive is at (item_x, item_y) which is adjacent and in front.\n          return path + [USE_ACTION] # This is the shortest path due to BFS\n\n    # --- Explore neighbors: Movement actions ---\n    # Agent moves, position changes, and new direction is fixed by the movement.\n    for action, (dx, dy) in move_deltas.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = ACTION_TO_FACING_DIR[action] # Agent faces direction of movement\n\n      next_state_tuple = (next_x, next_y, next_dir)\n      if next_state_tuple not in visited and is_passable(next_x, next_y):\n        visited.add(next_state_tuple)\n        q.append((next_x, next_y, next_dir, path + [action]))\n    \n    # --- Explore neighbors: Turning actions ---\n    # Agent's position (curr_x, curr_y) remains the same, only direction changes.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      next_x, next_y = curr_x, curr_y # Position does not change for a pure turn\n      \n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise (e.g., N(0)->W(3))\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4 # Turn clockwise (e.g., N(0)->E(1))\n      \n      next_state_tuple = (next_x, next_y, next_dir)\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple)\n        q.append((next_x, next_y, next_dir, path + [turn_action]))\n\n  # If the queue is empty and no path was found, the primitive is unreachable.\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:07:32.329218", "function_name": "collect", "function_body": "  import collections # Required for deque\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Access the current state directly from the CraftLab environment's internal state\n  current_state = env._current_state\n  current_grid = current_state.grid\n  current_pos = current_state.pos # This is already an (int, int) tuple\n\n  WIDTH, HEIGHT, N_KINDS = current_grid.shape\n\n  # If the primitive is not grabbable, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Define potential target positions for the agent.\n  # The agent needs to be in the 3x3 neighborhood of a primitive to `_USE` it.\n  # These are the cells that, if the agent moves to them, would allow `_USE`.\n  target_use_positions = set()\n  \n  # Pre-fetch non-grabbable indices for efficient obstacle checking\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle).\"\"\"\n    for k in non_grabbable_indices:\n      if current_grid[x, y, k] == 1:\n        return True\n    return False\n\n  # Identify all primitive locations and their 3x3 neighborhoods to find valid 'use' spots\n  for px in range(WIDTH):\n    for py in range(HEIGHT):\n      # If this cell contains the primitive\n      if current_grid[px, py, primitive] == 1:\n        # Add all cells in its 3x3 neighborhood as potential target_use_positions\n        for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n            nx, ny = px + dx, py + dy\n            \n            # Check boundaries\n            if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n              # An agent cannot move onto an obstacle. Only add reachable positions.\n              if not is_obstacle(nx, ny):\n                target_use_positions.add((nx, ny))\n\n  # If there are no reachable positions from which to use the primitive, return empty.\n  if not target_use_positions:\n    return []\n\n  # Breadth-First Search (BFS) to find the shortest path to any `target_use_position`\n  q = collections.deque()\n  q.append((current_pos, [])) # Queue stores ((x, y), [actions_to_reach_here])\n  \n  visited = {current_pos} # Set to store visited positions\n\n  # Define possible movements and their corresponding actions\n  moves = {\n      (0, -1): _UP,\n      (0, 1): _DOWN,\n      (-1, 0): _LEFT,\n      (1, 0): _RIGHT\n  }\n\n  best_path = None\n\n  while q:\n    (cx, cy), current_path = q.popleft()\n\n    # If the current position is one of our valid target_use_positions, we found the shortest path\n    if (cx, cy) in target_use_positions:\n      best_path = current_path\n      break # Exit BFS as the shortest path is found\n\n    # Explore neighbors\n    for (dx, dy), action in moves.items():\n      nx, ny = cx + dx, cy + dy\n\n      # Check boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n      \n      # Check if already visited\n      if (nx, ny) in visited:\n        continue\n\n      # Check if the neighbor cell is an obstacle (agent cannot move onto it)\n      if is_obstacle(nx, ny):\n        continue\n\n      # If the neighbor is valid and not an obstacle, add it to the queue\n      new_path = current_path + [action]\n      q.append(((nx, ny), new_path))\n      visited.add((nx, ny))\n  \n  # If a path was found, append the USE action and return it\n  if best_path is not None:\n    return best_path + [_USE]\n  else:\n    return [] # No path found to any usable primitive location", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:07:33.312017", "function_name": "collect", "function_body": "  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  actions_to_take = []\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # IMPROVEMENT: If the agent is already on the primitive, just use it.\n  if current_grid[current_px, current_py, primitive] == 1:\n      return [_USE]\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell\n      if current_grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  # (This check is done after the initial agent position check)\n  if not primitive_locations:\n    return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path to any primitive location\n  # Queue stores tuples: ((current_x, current_y), [path_actions_to_reach_here])\n  q = collections.deque() # collections import is assumed to be available at module level\n  q.append((current_pos, [])) \n  \n  # Set to store visited positions to avoid cycles and re-processing longer paths\n  visited = {current_pos} \n\n  # Define possible movements and their corresponding actions\n  # (dx, dy): action\n  moves = {\n      (0, -1): _UP,\n      (0, 1): _DOWN,\n      (-1, 0): _LEFT,\n      (1, 0): _RIGHT\n  }\n\n  # Obstacle check function: A cell is considered an obstacle if it contains\n  # any non-grabbable item. The target primitive itself is grabbable,\n  # so it will not be in `non_grabbable_indices`.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle).\"\"\"\n    for k in non_grabbable_items_set:\n      if grid[x, y, k] == 1:\n        return True\n    return False\n\n  target_found_path = None\n\n  while q:\n    (cx, cy), current_path = q.popleft()\n\n    # If the current position contains the primitive, we found a path.\n    # Since it's BFS, this is guaranteed to be the shortest path to *a* primitive.\n    if current_grid[cx, cy, primitive] == 1:\n      target_found_path = current_path\n      break # Exit BFS as the shortest path is found\n\n    # Explore neighbors\n    for (dx, dy), action in moves.items():\n      nx, ny = cx + dx, cy + dy\n\n      # Check boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if already visited\n      if (nx, ny) in visited:\n        continue\n\n      # Check if the neighbor cell is an obstacle\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n\n      # If the neighbor is valid and not an obstacle, add it to the queue\n      new_path = current_path + [action]\n      q.append(((nx, ny), new_path))\n      visited.add((nx, ny))\n  \n  # If a path was found, append the USE action and return it\n  if target_found_path is not None:\n    actions_to_take = target_found_path + [_USE]\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:08:41.980521", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dy == 1 and dx == 0: return SOUTH_DIR\n    if dy == -1 and dx == 0: return NORTH_DIR # Corrected from v0: dy=-1, dx=0 for NORTH\n    return None # Should not happen if agent_pos and item_pos are cardinally adjacent\n\n  # Helper function: Checks if a cell is traversable (no non-grabbable items)\n  def _is_traversable(grid, x, y, non_grabbable_indices, grid_width, grid_height):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item (obstacle) is at (x, y)\n    for k_idx in non_grabbable_indices:\n      if grid[y, x, k_idx] == 1:\n        return False\n    return True\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Optimization from v1: Check if the primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Get non-grabbable indices for traversability check\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Prepare BFS goal states: (agent_x, agent_y, agent_facing_dir)\n  # These are the states from which the 'USE' action can be performed to collect the primitive.\n  bfs_target_agent_states = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells for the agent to stand on\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (dx_adj, dy_adj) from item to agent\n      adj_x, adj_y = item_x + dx_adj, item_y + dy_adj\n\n      if _is_traversable(grid, adj_x, adj_y, non_grabbable_indices, grid_width, grid_height):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_target_agent_states.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_target_agent_states:\n    return [] # No traversable adjacent positions from which to collect the primitive\n\n  # BFS setup\n  # Queue stores (x, y, dir) tuples\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Parent map to reconstruct the path: {child_state: (parent_state, action_to_child)}\n  parent_map = {} \n  \n  found_goal_state = None # Stores the (x, y, dir) of the goal state once found\n\n  # Action definitions for BFS exploration:\n  # Movement actions and their corresponding (dx, dy)\n  movement_deltas = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n  \n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state is one of the goal states\n    if (curr_x, curr_y, curr_dir) in bfs_target_agent_states:\n      found_goal_state = (curr_x, curr_y, curr_dir)\n      break # Found the shortest path to a goal\n    \n    # Explore neighbors through movement actions (agent's direction doesn't change relative to its current facing)\n    # The agent faces the direction it moves.\n    # This simplification from v0's description might be misleading. In typical grid worlds, movement changes position,\n    # and turns change direction. Let's stick to the common interpretation for these actions:\n    # DOWN/UP/LEFT/RIGHT change position and implicitly change facing direction to the direction of movement.\n    # So, the next_dir should be updated based on the movement action.\n    \n    # Explore movement actions\n    for action, (dx, dy) in movement_deltas.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      \n      # Determine the new direction after taking a movement action\n      if action == UP_ACTION: next_dir = NORTH_DIR\n      elif action == DOWN_ACTION: next_dir = SOUTH_DIR\n      elif action == LEFT_ACTION: next_dir = WEST_DIR\n      elif action == RIGHT_ACTION: next_dir = EAST_DIR\n      else: next_dir = curr_dir # Should not happen for movement actions\n\n      next_state = (next_x, next_y, next_dir)\n      if _is_traversable(grid, next_x, next_y, non_grabbable_indices, grid_width, grid_height):\n        if next_state not in visited:\n          visited.add(next_state)\n          parent_map[next_state] = ((curr_x, curr_y, curr_dir), action)\n          queue.append(next_state)\n    \n    # Explore turning actions (position doesn't change)\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]: # Reusing action constants for turns\n      next_x, next_y = curr_x, curr_y # Position does not change for a pure turn\n      \n      # Calculate new direction based on the turn action\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4 # Turn clockwise\n      \n      next_state = (next_x, next_y, next_dir)\n      if next_state not in visited:\n        visited.add(next_state)\n        parent_map[next_state] = ((curr_x, curr_y, curr_dir), turn_action)\n        queue.append(next_state)\n\n  if found_goal_state is None:\n    return [] # No path found to any primitive's collection point\n\n  # Reconstruct the path from the goal state back to the initial state\n  actions = []\n  curr_state = found_goal_state\n  initial_state = (initial_agent_x, initial_agent_y, initial_agent_dir)\n\n  while curr_state != initial_state:\n    parent_state, action = parent_map[curr_state]\n    actions.insert(0, action) # Prepend action to build path in correct order\n    curr_state = parent_state\n  \n  # Finally, append the USE action after reaching the correct position and facing direction.\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:08:42.963652", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dy == 1 and dx == 0: return SOUTH_DIR\n    if dy == -1 and dx == 0: return NORTH_DIR # Corrected: dy == -1 and dx == 0\n    return None # Should not happen if agent_pos and item_pos are cardinally adjacent\n\n  # Helper function: Checks if a cell is traversable (no non-grabbable items)\n  def _is_traversable(grid, x, y, non_grabbable_indices, grid_width, grid_height):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item (obstacle) is at (x, y)\n    for k_idx in non_grabbable_indices:\n      if grid[y, x, k_idx] == 1:\n        return False\n    return True\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # IMPROVEMENT from collect_v1: Check if primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Get non-grabbable indices for traversability check\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Prepare BFS goal states: ((agent_adj_x, agent_adj_y, agent_facing_dir), (primitive_x, primitive_y))\n  # A BFS goal state is a (position, direction) from which the primitive can be 'USE'd.\n  bfs_goal_states = []\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells for the agent to stand on\n    # (dx_adj_from_item, dy_adj_from_item) is the vector from the item to the agent's adjacent position\n    for dx_adj_from_item, dy_adj_from_item in [(-1, 0), (1, 0), (0, -1), (0, 1)]: \n      adj_x, adj_y = item_x + dx_adj_from_item, item_y + dy_adj_from_item\n\n      if _is_traversable(grid, adj_x, adj_y, non_grabbable_indices, grid_width, grid_height):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_goal_states.append(((adj_x, adj_y, required_dir), (item_x, item_y)))\n  \n  if not bfs_goal_states:\n    return [] # No traversable adjacent positions to any primitive instance\n\n  # BFS setup\n  # Queue stores (x, y, dir) tuples representing agent state\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Parent map to reconstruct the path: {child_state: (parent_state, action_to_child)}\n  parent_map = {} \n  \n  found_goal_state_config = None # Stores the (x, y, dir) of the goal state once found\n\n  # Action definitions for BFS exploration (based on collect_v0's interpretation of actions):\n  # Movement actions (change position, agent direction does NOT change)\n  movement_deltas = {\n      UP_ACTION: (0, -1),   # Move North (dy=-1)\n      DOWN_ACTION: (0, 1)    # Move South (dy=1)\n  }\n  \n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state is one of the goal states\n    for (goal_x, goal_y, goal_dir), _ in bfs_goal_states:\n      if (curr_x, curr_y, curr_dir) == (goal_x, goal_y, goal_dir):\n        found_goal_state_config = (curr_x, curr_y, curr_dir)\n        break # Found the shortest path to a goal\n    if found_goal_state_config is not None:\n      break # Exit BFS as soon as the shortest path is found\n\n    # Explore neighbors through MOVEMENT actions\n    for action, (dx, dy) in movement_deltas.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = curr_dir # Direction remains the same after movement (as per collect_v0)\n\n      next_state = (next_x, next_y, next_dir)\n      if _is_traversable(grid, next_x, next_y, non_grabbable_indices, grid_width, grid_height):\n        if next_state not in visited:\n          visited.add(next_state)\n          parent_map[next_state] = ((curr_x, curr_y, curr_dir), action)\n          queue.append(next_state)\n    \n    # Explore neighbors through TURNING actions\n    # NOTE: Assumes LEFT_ACTION (2) and RIGHT_ACTION (3) are turn actions, not movement actions,\n    # consistent with the implementation logic of collect_v0.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]: \n      next_x, next_y = curr_x, curr_y # Position does not change for a pure turn\n      \n      # Calculate new direction based on the turn action\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4 # Turn clockwise\n      \n      next_state = (next_x, next_y, next_dir)\n      if next_state not in visited:\n        visited.add(next_state)\n        parent_map[next_state] = ((curr_x, curr_y, curr_dir), turn_action)\n        queue.append(next_state)\n\n  if found_goal_state_config is None:\n    return [] # No path found to any primitive's collection point\n\n  # Reconstruct the path from the goal state back to the initial state\n  actions = []\n  curr_state = found_goal_state_config\n  initial_state = (initial_agent_x, initial_agent_y, initial_agent_dir)\n\n  while curr_state != initial_state:\n    parent_state, action = parent_map[curr_state]\n    actions.insert(0, action) # Prepend action to build path in correct order\n    curr_state = parent_state\n  \n  # Finally, append the USE action after reaching the correct position and facing direction.\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:10:00.986937", "function_name": "collect", "function_body": "  import heapq # Assuming heapq is imported globally or available in the environment\n\n  # Helper for heuristic (Manhattan distance to closest primitive location)\n  def _heuristic(state, primitive_locs):\n      s_x, s_y, _ = state\n      if not primitive_locs:\n          return 0\n      min_dist = float('inf')\n      for p_x, p_y in primitive_locs:\n          min_dist = min(min_dist, abs(s_x - p_x) + abs(s_y - p_y))\n      return min_dist\n\n  # 1. Get current state information from the environment.\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Extract current agent position (x, y) and direction.\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  current_dir = np.argmax(obs['features_dict']['direction'])\n\n  # Get world configuration, specifically non-grabbable entities that act as obstacles.\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n\n  grid_width, grid_height, _ = grid.shape\n\n  # 2. Determine traversable cells on the grid.\n  # A cell is considered NOT traversable if it contains any non-grabbable item.\n  traversable_mask = np.ones((grid_width, grid_height), dtype=bool)\n  if non_grabbable_indices:\n      # Create a boolean mask where True indicates an obstacle of any non-grabbable kind.\n      cells_with_obstacles = np.any(grid[:, :, list(non_grabbable_indices)] > 0, axis=2)\n      traversable_mask[cells_with_obstacles] = False\n  \n  # The agent's starting position must be traversable to begin the search.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return [] # Cannot move from an untraversable starting point.\n\n  # 3. Identify all locations on the grid where the target primitive exists.\n  primitive_locations_on_grid = []\n  y_coords_of_primitive, x_coords_of_primitive = np.where(grid[:, :, primitive] > 0)\n  for x, y in zip(x_coords_of_primitive, y_coords_of_primitive):\n      primitive_locations_on_grid.append((x, y))\n\n  if not primitive_locations_on_grid:\n      return [] # The primitive is not present anywhere on the map.\n\n  # 4. Identify \"collectable target states\" for the agent.\n  # A target state is (agent_x, agent_y, agent_direction) from which the ACTION_USE\n  # can successfully collect the primitive. This requires the agent to be adjacent\n  # to the primitive and facing it.\n  collectable_target_states = set()\n  for p_x, p_y in primitive_locations_on_grid:\n      # Iterate over the four cells adjacent to the primitive.\n      for delta_x_from_primitive, delta_y_from_primitive in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          # Calculate the agent's potential position (a_x, a_y).\n          a_x, a_y = p_x + delta_x_from_primitive, p_y + delta_y_from_primitive\n\n          # Check if this potential agent position is within grid boundaries and is traversable.\n          if not (0 <= a_x < grid_width and 0 <= a_y < grid_height and traversable_mask[a_x, a_y]):\n              continue\n          \n          # Determine the required direction the agent must face from (a_x, a_y) to collect (p_x, p_y).\n          vector_to_primitive_x, vector_to_primitive_y = p_x - a_x, p_y - a_y\n\n          required_agent_dir = -1\n          # Find which direction delta matches the vector from agent to primitive.\n          for d_val, (dx, dy) in DIR_DELTAS.items(): # DIR_DELTAS is assumed to be globally defined\n              if dx == vector_to_primitive_x and dy == vector_to_primitive_y:\n                  required_agent_dir = d_val\n                  break\n          \n          if required_agent_dir != -1:\n              collectable_target_states.add((a_x, a_y, required_agent_dir))\n\n  if not collectable_target_states:\n      return [] # No valid states exist from which the primitive can be collected.\n\n  # 5. Perform A* Search on the state space.\n  # A state is defined by (agent_x, agent_y, agent_direction).\n  start_state = (current_pos_x, current_pos_y, current_dir)\n  \n  # g_score: actual cost from start_state to current state\n  # Initialized with infinity for all states except start_state\n  g_score = {start_state: 0}\n  \n  # priority_queue: stores (f_score, state_tuple)\n  # f_score = g_score + h_score (heuristic estimate from state to goal)\n  # The first element in the tuple determines priority (min-heap)\n  priority_queue = [(0 + _heuristic(start_state, primitive_locations_on_grid), start_state)]\n  \n  # came_from: maps a state to the (previous_state, action_taken_to_reach_current_state)\n  # Used to reconstruct the path after finding the goal.\n  came_from = {}\n\n  while priority_queue:\n      # Get the state with the lowest f_score from the priority queue.\n      current_f_score, current_state = heapq.heappop(priority_queue)\n      curr_x, curr_y, curr_dir = current_state\n\n      # If we extracted a state with a higher f_score than what's currently recorded\n      # in g_score (meaning a shorter path to this state has already been found and processed),\n      # then skip this outdated entry.\n      if current_f_score > g_score.get(current_state, float('inf')) + _heuristic(current_state, primitive_locations_on_grid):\n           continue\n        \n      # Check if the current state is one of our desired collectable target states.\n      if current_state in collectable_target_states:\n          # If it is, we've found the shortest path. Reconstruct and return.\n          path = []\n          temp_state = current_state\n          while temp_state != start_state:\n              prev_state, action = came_from[temp_state]\n              path.append(action)\n              temp_state = prev_state\n          \n          # The path is built in reverse, so reverse it and append the ACTION_USE.\n          return path[::-1] + [ACTION_USE] # ACTION_USE is assumed to be globally defined\n\n      # Explore all possible next states by applying movement actions.\n      for action_taken in MOVEMENT_ACTIONS: # MOVEMENT_ACTIONS is assumed to be globally defined\n          # Determine the agent's new direction and position after taking this action.\n          next_dir = ACTION_TO_RESULTING_DIR[action_taken] # ACTION_TO_RESULTING_DIR is assumed to be globally defined\n          dx_move, dy_move = DIR_DELTAS[next_dir]\n          \n          next_x, next_y = curr_x + dx_move, curr_y + dy_move\n          next_state = (next_x, next_y, next_dir)\n\n          # Check if the next cell is within grid boundaries and is traversable.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height and traversable_mask[next_x, next_y]):\n              continue\n          \n          # Calculate the cost to reach this next_state from the start state via the current_state.\n          # Each movement action costs 1.\n          tentative_g_score = g_score[current_state] + 1 \n\n          # If this new path to next_state is shorter than any previously found path,\n          # or if next_state hasn't been reached yet, update its score and add to queue.\n          if tentative_g_score < g_score.get(next_state, float('inf')):\n              came_from[next_state] = (current_state, action_taken)\n              g_score[next_state] = tentative_g_score\n              \n              # Calculate the f_score for the next_state and push to the priority queue.\n              f_score_next = tentative_g_score + _heuristic(next_state, primitive_locations_on_grid)\n              heapq.heappush(priority_queue, (f_score_next, next_state))\n  \n  # If the priority queue becomes empty and no path to a target state was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:10:01.942432", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Action and Direction Constants\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  DIR_DELTAS = {\n      DIR_UP: (0, -1),\n      DIR_RIGHT: (1, 0),\n      DIR_DOWN: (0, 1),\n      DIR_LEFT: (-1, 0),\n  }\n\n  ACTION_TO_RESULTING_DIR = {\n      ACTION_UP: DIR_UP,\n      ACTION_RIGHT: DIR_RIGHT,\n      ACTION_DOWN: DIR_DOWN,\n      ACTION_LEFT: DIR_LEFT,\n  }\n\n  MOVEMENT_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # 1. Get current state information from the environment.\n  obs = env.observations()\n  \n  # Improvement: Check if the primitive is already in inventory.\n  inventory = obs['features_dict']['inventory']\n  if inventory[primitive] > 0:\n      return [] # Primitive already collected, no actions needed.\n\n  grid = obs['features_dict']['features_global']\n  \n  # Extract current agent position (x, y) and direction.\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  current_dir = np.argmax(obs['features_dict']['direction'])\n\n  # Get world configuration, specifically non-grabbable entities that act as obstacles.\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n\n  grid_width, grid_height, _ = grid.shape\n\n  # 2. Determine traversable cells on the grid.\n  traversable_mask = np.ones((grid_width, grid_height), dtype=bool)\n  if non_grabbable_indices:\n      cells_with_obstacles = np.any(grid[:, :, list(non_grabbable_indices)] > 0, axis=2)\n      traversable_mask[cells_with_obstacles] = False\n  \n  # The agent's starting position must be traversable to begin the search.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return [] # Cannot move from an untraversable starting point.\n\n  # 3. Identify all locations on the grid where the target primitive exists.\n  primitive_locations_on_grid = []\n  y_coords_of_primitive, x_coords_of_primitive = np.where(grid[:, :, primitive] > 0)\n  for x, y in zip(x_coords_of_primitive, y_coords_of_primitive):\n      primitive_locations_on_grid.append((x, y))\n\n  if not primitive_locations_on_grid:\n      return [] # The primitive is not present anywhere on the map.\n\n  # 4. Identify \"collectable target states\" for the agent.\n  collectable_target_states = set()\n  for p_x, p_y in primitive_locations_on_grid:\n      for delta_x_from_primitive, delta_y_from_primitive in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          a_x, a_y = p_x + delta_x_from_primitive, p_y + delta_y_from_primitive\n\n          if not (0 <= a_x < grid_width and 0 <= a_y < grid_height and traversable_mask[a_x, a_y]):\n              continue\n          \n          vector_to_primitive_x, vector_to_primitive_y = p_x - a_x, p_y - a_y\n\n          required_agent_dir = -1\n          for d_val, (dx, dy) in DIR_DELTAS.items():\n              if dx == vector_to_primitive_x and dy == vector_to_primitive_y:\n                  required_agent_dir = d_val\n                  break\n          \n          if required_agent_dir != -1:\n              collectable_target_states.add((a_x, a_y, required_agent_dir))\n\n  if not collectable_target_states:\n      return [] # No valid states exist from which the primitive can be collected.\n\n  # 5. Perform a Breadth-First Search (BFS) on the state space.\n  start_state = (current_pos_x, current_pos_y, current_dir)\n  \n  q = deque([(start_state, [])]) \n  visited_states = {start_state}\n\n  while q:\n      (curr_x, curr_y, curr_dir), path_actions = q.popleft()\n\n      if (curr_x, curr_y, curr_dir) in collectable_target_states:\n          return path_actions + [ACTION_USE]\n\n      for action_taken in MOVEMENT_ACTIONS:\n          next_dir = ACTION_TO_RESULTING_DIR[action_taken]\n          dx_move, dy_move = DIR_DELTAS[next_dir]\n          \n          next_x, next_y = curr_x + dx_move, curr_y + dy_move\n\n          next_state = (next_x, next_y, next_dir)\n\n          if (0 <= next_x < grid_width and 0 <= next_y < grid_height and\n              traversable_mask[next_x, next_y] and\n              next_state not in visited_states):\n              \n              visited_states.add(next_state)\n              q.append((next_state, path_actions + [action_taken]))\n  \n  # If the BFS queue becomes empty and no path to a target state was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:11:36.301583", "function_name": "collect", "function_body": "  import collections\n  \n  # Access environment details\n  state = env._current_state\n  world = env.world  # This is the CraftWorld instance\n  grid = state.grid\n  HEIGHT, WIDTH, _ = grid.shape # N_KINDS is not directly used for grid shape here\n\n  # Get action mapping from the environment\n  ACTION_MAP = env.action_specs()\n\n  # Define movement deltas for actions (DOWN, UP, LEFT, RIGHT)\n  # Based on ACTION_MAP: DOWN=0, UP=1, LEFT=2, RIGHT=3\n  DR = {ACTION_MAP['DOWN']: 1, ACTION_MAP['UP']: -1, ACTION_MAP['LEFT']: 0, ACTION_MAP['RIGHT']: 0}\n  DC = {ACTION_MAP['DOWN']: 0, ACTION_MAP['UP']: 0, ACTION_MAP['LEFT']: -1, ACTION_MAP['RIGHT']: 1}\n  MOVE_ACTIONS = [ACTION_MAP['DOWN'], ACTION_MAP['UP'], ACTION_MAP['LEFT'], ACTION_MAP['RIGHT']]\n  USE_ACTION = ACTION_MAP['USE']\n\n  # 1. Check if primitive is already in inventory\n  if state.inventory[primitive] > 0:\n    return []\n\n  # 2. Find all locations of the primitive on the grid\n  primitive_locs = []\n  for r in range(HEIGHT):\n    for c in range(WIDTH):\n      if grid[r, c, primitive] == 1:\n        primitive_locs.append((r, c))\n\n  if not primitive_locs:\n    # Primitive not found on the map\n    return []\n\n  # 3. BFS to find a path to a cell adjacent to the primitive\n  q = collections.deque()\n  visited = set()\n\n  start_r, start_c = state.pos\n  q.append((start_r, start_c, [])) # (row, col, list_of_actions)\n  visited.add((start_r, start_c))\n\n  while q:\n    curr_r, curr_c, path = q.popleft()\n\n    # Check if current position is adjacent to any primitive location\n    # A 3x3 neighborhood check\n    is_adjacent_to_primitive = False\n    for pr, pc in primitive_locs:\n      if abs(curr_r - pr) <= 1 and abs(curr_c - pc) <= 1:\n        is_adjacent_to_primitive = True\n        break\n    \n    if is_adjacent_to_primitive:\n      # Found a position from which the primitive can be 'used'\n      return path + [USE_ACTION]\n\n    # Explore neighboring cells\n    for action_idx in MOVE_ACTIONS:\n      next_r = curr_r + DR[action_idx]\n      next_c = curr_c + DC[action_idx]\n\n      # Boundary check\n      if not (0 <= next_r < HEIGHT and 0 <= next_c < WIDTH):\n        continue\n\n      # Obstacle check: Cannot move into cells with non-grabbable items\n      # Non-grabbable items are considered obstacles for movement.\n      is_obstacle = False\n      for k_idx in world.non_grabbable_indices:\n        if grid[next_r, next_c, k_idx] == 1:\n            is_obstacle = True\n            break\n      if is_obstacle:\n        continue\n\n      # Visited check\n      if (next_r, next_c) not in visited:\n        visited.add((next_r, next_c))\n        q.append((next_r, next_c, path + [action_idx]))\n\n  # If BFS completes and no path is found\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:11:37.287162", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants based on CraftLab.action_specs\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Define direction vectors for NORTH, EAST, SOUTH, WEST (0, 1, 2, 3 respectively)\n  # (dx, dy) for moving one step in that direction\n  DIR_VECTORS = {\n      0: (0, -1),  # NORTH (decrease y)\n      1: (1, 0),   # EAST (increase x)\n      2: (0, 1),   # SOUTH (increase y)\n      3: (-1, 0),  # WEST (decrease x)\n  }\n\n  # Get initial state information from the environment\n  current_state = env._current_state\n  current_pos = current_state.pos  # (agent_x, agent_y)\n  current_dir = current_state.dir  # 0:N, 1:E, 2:S, 3:W\n  grid = current_state.grid        # (WIDTH, HEIGHT, n_kinds)\n\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          if grid[x, y, primitive] > 0:  # Check if the primitive kind is present at (x, y)\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      return []  # Primitive not found on the grid\n\n  # Choose the closest primitive location as the target using Manhattan distance\n  target_x, target_y = min(primitive_locations, key=lambda loc: abs(loc[0] - current_pos[0]) + abs(loc[1] - current_pos[1]))\n\n  # BFS to find the shortest sequence of actions (moves and turns)\n  # to get to a position where the agent is facing the target primitive.\n  # State in BFS queue: (agent_x, agent_y, agent_direction, path_actions)\n  q = collections.deque([(current_pos[0], current_pos[1], current_dir, [])])\n  \n  # Visited set to avoid cycles and redundant paths: (agent_x, agent_y, agent_direction)\n  visited = set([(current_pos[0], current_pos[1], current_dir)])\n\n  while q:\n      cx, cy, cdir, path = q.popleft()\n\n      # Check if the agent is currently positioned and facing the target primitive\n      # Calculate the coordinates of the cell directly in front of the agent\n      fx, fy = cx + DIR_VECTORS[cdir][0], cy + DIR_VECTORS[cdir][1]\n      \n      # If the cell in front is the target primitive, we have found a valid path\n      if fx == target_x and fy == target_y:\n          return path + [ACTION_USE]  # Append USE action and return the complete path\n\n      # Explore possible next states by applying actions:\n\n      # 1. Movement actions (UP: move forward, DOWN: move backward)\n      \n      # Move Forward (ACTION_UP)\n      npx_up, npy_up = cx + DIR_VECTORS[cdir][0], cy + DIR_VECTORS[cdir][1]\n      # Check bounds and ensure we don't try to move onto the primitive's exact square\n      # (assuming primitives are items to be interacted with, not stood upon)\n      if (0 <= npx_up < WIDTH and 0 <= npy_up < HEIGHT and \n              (npx_up, npy_up) != (target_x, target_y)):\n          if (npx_up, npy_up, cdir) not in visited:\n              visited.add((npx_up, npy_up, cdir))\n              q.append((npx_up, npy_up, cdir, path + [ACTION_UP]))\n\n      # Move Backward (ACTION_DOWN)\n      npx_down, npy_down = cx - DIR_VECTORS[cdir][0], cy - DIR_VECTORS[cdir][1]\n      if (0 <= npx_down < WIDTH and 0 <= npy_down < HEIGHT and \n              (npx_down, npy_down) != (target_x, target_y)):\n          if (npx_down, npy_down, cdir) not in visited:\n              visited.add((npx_down, npy_down, cdir))\n              q.append((npx_down, npy_down, cdir, path + [ACTION_DOWN]))\n\n      # 2. Turn actions (LEFT: turn left, RIGHT: turn right)\n      \n      # Turn Left (ACTION_LEFT)\n      ndir_left = (cdir - 1 + 4) % 4  # Wrap around for directions (0-3)\n      # Position does not change when turning\n      if (cx, cy, ndir_left) not in visited:\n          visited.add((cx, cy, ndir_left))\n          q.append((cx, cy, ndir_left, path + [ACTION_LEFT]))\n\n      # Turn Right (ACTION_RIGHT)\n      ndir_right = (cdir + 1) % 4  # Wrap around for directions (0-3)\n      if (cx, cy, ndir_right) not in visited:\n          visited.add((cx, cy, ndir_right))\n          q.append((cx, cy, ndir_right, path + [ACTION_RIGHT]))\n\n  return []  # No path found (this should ideally not be reached if the primitive is reachable)", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:12:31.282575", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Action and Direction Constants\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  DIR_DELTAS = {\n      DIR_UP: (0, -1),   # Moving up: x constant, y decreases\n      DIR_RIGHT: (1, 0),  # Moving right: x increases, y constant\n      DIR_DOWN: (0, 1),   # Moving down: x constant, y increases\n      DIR_LEFT: (-1, 0),  # Moving left: x decreases, y constant\n  }\n\n  # Pre-compute a reverse mapping for faster lookup of required agent direction.\n  VECTOR_TO_DIR = {v: k for k, v in DIR_DELTAS.items()}\n\n  ACTION_TO_RESULTING_DIR = {\n      ACTION_UP: DIR_UP,\n      ACTION_RIGHT: DIR_RIGHT,\n      ACTION_DOWN: DIR_DOWN,\n      ACTION_LEFT: DIR_LEFT,\n  }\n\n  MOVEMENT_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # 1. Get current state information from the environment.\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  current_dir = np.argmax(obs['features_dict']['direction'])\n\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n\n  grid_width, grid_height, _ = grid.shape\n\n  # 2. Determine traversable cells on the grid.\n  traversable_mask = np.ones((grid_width, grid_height), dtype=bool)\n  if non_grabbable_indices:\n      cells_with_obstacles = np.any(grid[:, :, list(non_grabbable_indices)] > 0, axis=2)\n      traversable_mask[cells_with_obstacles] = False\n  \n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return []\n\n  # 3. Identify all locations on the grid where the target primitive exists.\n  primitive_locations_on_grid = []\n  y_coords_of_primitive, x_coords_of_primitive = np.where(grid[:, :, primitive] > 0)\n  for x, y in zip(x_coords_of_primitive, y_coords_of_primitive):\n      primitive_locations_on_grid.append((x, y))\n\n  if not primitive_locations_on_grid:\n      return []\n\n  # 4. Identify \"collectable target states\" for the agent.\n  collectable_target_states = set()\n  for p_x, p_y in primitive_locations_on_grid:\n      for delta_x_from_primitive, delta_y_from_primitive in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          a_x, a_y = p_x + delta_x_from_primitive, p_y + delta_y_from_primitive\n\n          if not (0 <= a_x < grid_width and 0 <= a_y < grid_height and traversable_mask[a_x, a_y]):\n              continue\n          \n          vector_to_primitive_x, vector_to_primitive_y = p_x - a_x, p_y - a_y\n\n          # Use the pre-computed VECTOR_TO_DIR map for a more direct lookup.\n          required_agent_dir = VECTOR_TO_DIR.get((vector_to_primitive_x, vector_to_primitive_y), -1)\n          \n          if required_agent_dir != -1:\n              collectable_target_states.add((a_x, a_y, required_agent_dir))\n\n  if not collectable_target_states:\n      return []\n\n  # 5. Perform a Breadth-First Search (BFS) on the state space.\n  start_state = (current_pos_x, current_pos_y, current_dir)\n  \n  q = deque([(start_state, [])]) \n  visited_states = {start_state}\n\n  while q:\n      (curr_x, curr_y, curr_dir), path_actions = q.popleft()\n\n      if (curr_x, curr_y, curr_dir) in collectable_target_states:\n          return path_actions + [ACTION_USE]\n\n      for action_taken in MOVEMENT_ACTIONS:\n          next_dir = ACTION_TO_RESULTING_DIR[action_taken]\n          dx_move, dy_move = DIR_DELTAS[next_dir]\n          \n          next_x, next_y = curr_x + dx_move, curr_y + dy_move\n\n          next_state = (next_x, next_y, next_dir)\n\n          if (0 <= next_x < grid_width and 0 <= next_y < grid_height and\n              traversable_mask[next_x, next_y] and\n              next_state not in visited_states):\n              \n              visited_states.add(next_state)\n              q.append((next_state, path_actions + [action_taken]))\n  \n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:12:32.245436", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Action and Direction Constants\n  # These are numerical values for actions that can be passed to env.step().\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # These are numerical values representing the agent's facing direction.\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  # Map agent's facing direction to (dx, dy) delta for moving \"forward\" in that direction.\n  # (dx, dy) represents the change in (x, y) coordinates.\n  # Assuming (x,y) corresponds to (column, row) in the grid, where +x is right, +y is down.\n  DIR_DELTAS = {\n      DIR_UP: (0, -1),   # Moving up: x constant, y decreases\n      DIR_RIGHT: (1, 0),  # Moving right: x increases, y constant\n      DIR_DOWN: (0, 1),   # Moving down: x constant, y increases\n      DIR_LEFT: (-1, 0),  # Moving left: x decreases, y constant\n  }\n\n  # Pre-compute a reverse mapping from (dx, dy) vector to the corresponding DIR_ constant.\n  # This optimizes the lookup when determining the required agent direction to face a primitive.\n  REV_DIR_DELTAS = {v: k for k, v in DIR_DELTAS.items()}\n\n  # Map a movement action to the agent's resulting facing direction.\n  # In CraftWorld, movement actions also orient the agent in the direction of movement.\n  ACTION_TO_RESULTING_DIR = {\n      ACTION_UP: DIR_UP,\n      ACTION_RIGHT: DIR_RIGHT,\n      ACTION_DOWN: DIR_DOWN,\n      ACTION_LEFT: DIR_LEFT,\n  }\n\n  # List of all movement actions (excluding USE).\n  MOVEMENT_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # 1. Get current state information from the environment.\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Extract current agent position (x, y) and direction.\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  current_dir = np.argmax(obs['features_dict']['direction'])\n\n  # Get world configuration, specifically non-grabbable entities that act as obstacles.\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n\n  grid_width, grid_height, _ = grid.shape\n\n  # 2. Determine traversable cells on the grid.\n  # A cell is considered NOT traversable if it contains any non-grabbable item.\n  traversable_mask = np.ones((grid_width, grid_height), dtype=bool)\n  if non_grabbable_indices:\n      # Create a boolean mask where True indicates an obstacle of any non-grabbable kind.\n      cells_with_obstacles = np.any(grid[:, :, list(non_grabbable_indices)] > 0, axis=2)\n      traversable_mask[cells_with_obstacles] = False\n  \n  # The agent's starting position must be traversable to begin the search.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return [] # Cannot move from an untraversable starting point.\n\n  # 3. Identify all locations on the grid where the target primitive exists.\n  primitive_locations_on_grid = []\n  # `np.where` returns (row_indices, col_indices) for elements matching the condition.\n  # Since grid is `(WIDTH, HEIGHT, K)`, row_indices are y-coordinates and col_indices are x-coordinates.\n  y_coords_of_primitive, x_coords_of_primitive = np.where(grid[:, :, primitive] > 0)\n  for x, y in zip(x_coords_of_primitive, y_coords_of_primitive):\n      primitive_locations_on_grid.append((x, y))\n\n  if not primitive_locations_on_grid:\n      return [] # The primitive is not present anywhere on the map.\n\n  # 4. Identify \"collectable target states\" for the agent.\n  # A target state is (agent_x, agent_y, agent_direction) from which the ACTION_USE\n  # can successfully collect the primitive. This requires the agent to be adjacent\n  # to the primitive and facing it.\n  collectable_target_states = set()\n  for p_x, p_y in primitive_locations_on_grid:\n      # Iterate over the four cells adjacent to the primitive.\n      # `delta_x_from_primitive, delta_y_from_primitive` define the relative position of the agent\n      # if the agent were to be at one of the four cardinal neighbors of the primitive.\n      for delta_x_from_primitive, delta_y_from_primitive in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          # Calculate the agent's potential position (a_x, a_y).\n          a_x, a_y = p_x + delta_x_from_primitive, p_y + delta_y_from_primitive\n\n          # Check if this potential agent position is within grid boundaries and is traversable.\n          if not (0 <= a_x < grid_width and 0 <= a_y < grid_height and traversable_mask[a_x, a_y]):\n              continue\n          \n          # Determine the required direction the agent must face from (a_x, a_y) to collect (p_x, p_y).\n          # This is the vector from the agent's position to the primitive's position.\n          vector_to_primitive = (p_x - a_x, p_y - a_y)\n\n          # Use the pre-computed REV_DIR_DELTAS for a direct and efficient lookup.\n          required_agent_dir = REV_DIR_DELTAS.get(vector_to_primitive, -1)\n          \n          if required_agent_dir != -1:\n              collectable_target_states.add((a_x, a_y, required_agent_dir))\n\n  if not collectable_target_states:\n      return [] # No valid states exist from which the primitive can be collected.\n\n  # 5. Perform a Breadth-First Search (BFS) on the state space.\n  # A state is defined by (agent_x, agent_y, agent_direction).\n  start_state = (current_pos_x, current_pos_y, current_dir)\n  \n  # The queue stores tuples: ((current_x, current_y, current_dir), [list_of_actions_taken_to_reach_this_state]).\n  q = deque([(start_state, [])]) \n  \n  # The `visited_states` set keeps track of states already explored to prevent cycles and redundant paths.\n  visited_states = {start_state}\n\n  while q:\n      (curr_x, curr_y, curr_dir), path_actions = q.popleft()\n\n      # Check if the current state is one of our desired collectable target states.\n      if (curr_x, curr_y, curr_dir) in collectable_target_states:\n          # If it is, we've found the shortest path. Append the USE action and return.\n          return path_actions + [ACTION_USE]\n\n      # Explore all possible next states by applying movement actions.\n      for action_taken in MOVEMENT_ACTIONS:\n          # Determine the agent's new direction and position after taking this action.\n          next_dir = ACTION_TO_RESULTING_DIR[action_taken]\n          dx_move, dy_move = DIR_DELTAS[next_dir]\n          \n          next_x, next_y = curr_x + dx_move, curr_y + dy_move\n\n          next_state = (next_x, next_y, next_dir)\n\n          # Check if the next cell is within grid boundaries, is traversable,\n          # and this specific (position, direction) state has not been visited yet.\n          if (0 <= next_x < grid_width and 0 <= next_y < grid_height and\n              traversable_mask[next_x, next_y] and\n              next_state not in visited_states):\n              \n              # Mark the new state as visited and add it to the queue for further exploration.\n              visited_states.add(next_state)\n              q.append((next_state, path_actions + [action_taken]))\n  \n  # If the BFS queue becomes empty and no path to a target state was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:14:03.027613", "function_name": "collect", "function_body": "  # Constants for actions (from CraftLab's action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Mapping from relative position (dr, dc) to desired facing direction\n  # Agent directions: 0=N (Up), 1=E (Right), 2=S (Down), 3=W (Left)\n  # (delta_row, delta_col)\n  RELATIVE_TO_DIR = {\n      (-1, 0): 0,  # Primitive is above (North), face North\n      (0, 1): 1,   # Primitive is right (East), face East\n      (1, 0): 2,   # Primitive is below (South), face South\n      (0, -1): 3   # Primitive is left (West), face West\n  }\n\n  actions = []\n  MAX_ATTEMPTS = 500 # Maximum number of steps to try collecting to prevent infinite loops\n\n  # Check if the primitive is even grabbable. If not, we can't collect it.\n  if primitive in env.world.non_grabbable_indices:\n      # print(f\"Warning: Primitive {env.world.cookbook.index.get(primitive)} (ID: {primitive}) is non-grabbable.\")\n      return []\n\n  for _ in range(MAX_ATTEMPTS):\n      obs = env.observations()\n      current_state = env._current_state # Access internal state for convenience\n\n      # 1. Check if primitive is already in inventory\n      if current_state.inventory[primitive] > 0:\n          return actions # Success!\n\n      # 2. Check if primitive is next to agent (within 3x3 neighborhood)\n      if current_state.next_to(primitive):\n          agent_r, agent_c = current_state.pos\n          grid = current_state.grid # Use the state's grid for precise location\n\n          # Find the exact coordinates of the primitive in the 3x3 neighborhood\n          primitive_pos_in_neighborhood = None\n          for r_offset in [-1, 0, 1]:\n              for c_offset in [-1, 0, 1]:\n                  if r_offset == 0 and c_offset == 0: # Skip agent's own cell\n                      continue\n                  \n                  check_r, check_c = agent_r + r_offset, agent_c + c_offset\n                  \n                  # Check bounds\n                  if not (0 <= check_r < grid.shape[0] and 0 <= check_c < grid.shape[1]):\n                      continue\n                  \n                  # Check if this cell contains the primitive\n                  if grid[check_r, check_c, primitive] > 0:\n                      primitive_pos_in_neighborhood = (check_r, check_c)\n                      break\n              if primitive_pos_in_neighborhood:\n                  break\n\n          if primitive_pos_in_neighborhood:\n              pr_r, pr_c = primitive_pos_in_neighborhood\n              dr_rel = pr_r - agent_r\n              dc_rel = pr_c - agent_c\n\n              # Check if orthogonally adjacent (for direct USE)\n              if (dr_rel == 0 and abs(dc_rel) == 1) or (dc_rel == 0 and abs(dr_rel) == 1):\n                  # It's orthogonally adjacent. Now orient and USE.\n                  desired_dir = RELATIVE_TO_DIR[(dr_rel, dc_rel)]\n                  \n                  # Rotate until facing the desired direction\n                  current_dir = current_state.dir\n                  while current_dir != desired_dir:\n                      env.step(ACTION_RIGHT) # Try turning right\n                      actions.append(ACTION_RIGHT)\n                      # Update current_state and current_dir after the step\n                      # This ensures the `while` condition uses the new state.\n                      _ = env.observations() # Re-fetch observations to update internal state\n                      current_state = env._current_state \n                      current_dir = current_state.dir \n                  \n                  # Use the item\n                  env.step(ACTION_USE)\n                  actions.append(ACTION_USE)\n                  continue # Go to next iteration to re-check inventory\n\n              else: # It's diagonally adjacent or some other non-cardinal position.\n                    # Need to move to make it orthogonally adjacent.\n                    # Prioritize moving along the axis with the larger delta, or row first.\n                  action_to_take = -1\n                  if abs(dr_rel) > abs(dc_rel): # Prioritize vertical movement\n                      action_to_take = ACTION_UP if dr_rel < 0 else ACTION_DOWN\n                  elif abs(dc_rel) > 0: # If vertical delta is smaller or zero, go horizontal\n                      action_to_take = ACTION_LEFT if dc_rel < 0 else ACTION_RIGHT\n                  elif abs(dr_rel) > 0: # If only vertical delta remaining (and not covered by first `if`)\n                      action_to_take = ACTION_UP if dr_rel < 0 else ACTION_DOWN\n\n                  if action_to_take != -1:\n                      env.step(action_to_take)\n                      actions.append(action_to_take)\n                      continue # Go to next iteration\n          # If primitive_pos_in_neighborhood is None, `next_to` was possibly true due to \n          # an indirect reason or it was collected. Fall through to pathfinding.\n\n      # 3. Primitive not next to agent, pathfind on the global grid\n      grid = obs['features_dict']['features_global']\n      \n      # Find all locations of the primitive on the grid\n      primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n      if len(primitive_locations) == 0:\n          # Primitive not found on the map. This might mean it was already collected\n          # (but not in inventory, implies issue) or it's not present.\n          # print(f\"Warning: Primitive {env.world.cookbook.index.get(primitive)} (ID: {primitive}) not found on grid and not in inventory.\")\n          return [] # Cannot find it\n\n      # Find the closest primitive location (using Manhattan distance for simplicity)\n      agent_r, agent_c = current_state.pos\n      \n      closest_dist = float('inf')\n      target_r, target_c = -1, -1\n\n      for r, c in primitive_locations:\n          dist = abs(r - agent_r) + abs(c - agent_c)\n          if dist < closest_dist:\n              closest_dist = dist\n              target_r, target_c = r, c\n\n      # Decide next movement action\n      dr = target_r - agent_r\n      dc = target_c - agent_c\n\n      action_to_take = -1 \n\n      # Prioritize movement along the axis with the larger absolute difference\n      if abs(dr) > abs(dc):\n          if dr > 0:\n              action_to_take = ACTION_DOWN\n          else: # dr < 0\n              action_to_take = ACTION_UP\n      elif abs(dc) > 0: # If row difference is zero or smaller than col difference\n          if dc > 0:\n              action_to_take = ACTION_RIGHT\n          else: # dc < 0\n              action_to_take = ACTION_LEFT\n      else: # dr == 0 and dc == 0. Agent is on top of primitive.\n            # This case should ideally be caught by `next_to` or `inventory` check.\n            # If we reach here, it implies the primitive is in the same cell as the agent\n            # but hasn't been picked up, which might happen for non-grabbable items\n            # or if `USE` is needed even if on the same spot. But CraftWorld usually\n            # requires being *next to* for USE. So, consider this an uncollectable item.\n          # print(f\"Warning: Agent at primitive {env.world.cookbook.index.get(primitive)} (ID: {primitive}) location, but not in inventory and not picked up.\")\n          return actions # Indicate inability to collect\n\n      # Perform the determined action\n      if action_to_take != -1:\n          env.step(action_to_take)\n          actions.append(action_to_take)\n      else:\n          # This should only happen if dr=0 and dc=0 and no action was selected.\n          # print(f\"Warning: No valid movement action determined for primitive {env.world.cookbook.index.get(primitive)} (ID: {primitive}).\")\n          return actions # Stuck\n\n  # If MAX_ATTEMPTS reached and primitive not collected\n  # print(f\"Warning: collect_v2 reached MAX_ATTEMPTS ({MAX_ATTEMPTS}) without collecting primitive {env.world.cookbook.index.get(primitive)} (ID: {primitive}).\")\n  return actions # Return actions taken, indicating potential timeout/failure", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:14:03.990170", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Assuming env_factory defines UP, DOWN, LEFT, RIGHT, USE actions as integers.\n  # These are typically numerical IDs for actions.\n\n  # Map movement actions to their (dx, dy) effects on the agent's position.\n  # The direction of the agent (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) is assumed to match\n  # the direction of the respective movement action.\n  _ACTION_TO_DELTA = {\n      env_factory.UP: (0, -1),\n      env_factory.RIGHT: (1, 0),\n      env_factory.DOWN: (0, 1),\n      env_factory.LEFT: (-1, 0)\n  }\n\n  # This maps a movement action to the canonical direction (0-3) the agent will\n  # be facing after the move. Agent faces the direction it moves.\n  _MOVE_ACTION_TO_FINAL_DIR = {\n      env_factory.UP: 0,    # UP\n      env_factory.RIGHT: 1, # RIGHT\n      env_factory.DOWN: 2,  # DOWN\n      env_factory.LEFT: 3   # LEFT\n  }\n\n  # This maps a relative (dx, dy) from the agent's position to an object's position\n  # to the direction the agent needs to face to use the object. Only cardinal directions.\n  _DELTA_TO_FACE_DIR = {\n      (0, -1): 0,   # Object is UP from agent, agent needs to face UP\n      (1, 0): 1,    # Object is RIGHT from agent, agent needs to face RIGHT\n      (0, 1): 2,    # Object is DOWN from agent, agent needs to face DOWN\n      (-1, 0): 3    # Object is LEFT from agent, agent needs to face LEFT\n  }\n\n  def _get_cardinal_primitive_location_if_adjacent(grid, agent_pos, primitive_idx, width, height):\n      \"\"\"\n      Checks the 3x3 neighborhood around agent_pos for the primitive, but only returns\n      the location if it's in a cardinal direction (required for USE action).\n      Returns (px, py) of the primitive if found cardinally, otherwise None.\n      \"\"\"\n      ax, ay = agent_pos\n      \n      for dx, dy in _DELTA_TO_FACE_DIR.keys(): # Iterate only over cardinal direction deltas\n          px, py = ax + dx, ay + dy\n          \n          # Check bounds\n          if 0 <= px < width and 0 <= py < height:\n              # Check if this cell contains the primitive\n              if grid[px, py, primitive_idx] == 1.0:\n                  return (px, py)\n      return None\n\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (int, int)\n  initial_dir = current_state.dir # int (0-3)\n\n  width, height, n_kinds = initial_grid.shape\n\n  # Get the integer index for the primitive from the cookbook's index\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  # BFS setup:\n  # State in queue: (current_pos_x, current_pos_y, current_direction, path_actions_list)\n  queue = collections.deque([(initial_pos[0], initial_pos[1], initial_dir, [])])\n\n  # Visited set to prevent cycles and redundant explorations.\n  # A state is defined by (position_x, position_y, direction), as changing direction\n  # can lead to a different future path (e.g., for turning to USE).\n  visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n  while queue:\n    cx, cy, c_dir, c_path_actions = queue.popleft()\n\n    # Check if the primitive is in a cardinal adjacent cell from the current position.\n    primitive_location = _get_cardinal_primitive_location_if_adjacent(\n        initial_grid, (cx, cy), primitive_idx, width, height\n    )\n\n    if primitive_location:\n        # Primitive found adjacent; calculate actions to collect it.\n        px, py = primitive_location\n        \n        # Calculate the required direction to face the primitive.\n        dx, dy = px - cx, py - cy\n        \n        # Get the target facing direction based on relative position.\n        target_face_dir = _DELTA_TO_FACE_DIR[(dx, dy)]\n        \n        turn_actions = []\n        # Calculate turns needed to align agent's direction with target_face_dir.\n        # d_dir represents the number of 90-degree right turns needed (0, 1, 2, 3).\n        d_dir = (target_face_dir - c_dir + 4) % 4\n        \n        if d_dir == 1: # 90 deg right\n            turn_actions.append(env_factory.RIGHT)\n        elif d_dir == 2: # 180 deg\n            turn_actions.extend([env_factory.RIGHT, env_factory.RIGHT]) # Two right turns\n        elif d_dir == 3: # 90 deg left (3 right turns is equivalent to 1 left turn)\n            turn_actions.append(env_factory.LEFT)\n        \n        # The complete action sequence: path to adjacent cell + turns + USE.\n        final_actions = c_path_actions + turn_actions + [env_factory.USE]\n        return final_actions\n\n    # Explore valid movement actions from the current state.\n    for move_action in [env_factory.UP, env_factory.RIGHT, env_factory.DOWN, env_factory.LEFT]:\n        mdx, mdy = _ACTION_TO_DELTA[move_action] # Get delta for this move action\n        \n        nx, ny = cx + mdx, cy + mdy\n        n_dir = _MOVE_ACTION_TO_FINAL_DIR[move_action] # Agent faces the direction it moved\n\n        # Check grid boundaries for the new position.\n        if 0 <= nx < width and 0 <= ny < height:\n            # Check if this new state (position and direction) has already been visited.\n            if (nx, ny, n_dir) not in visited:\n                visited.add((nx, ny, n_dir))\n                # Add to queue with updated position, direction, and path.\n                queue.append((nx, ny, n_dir, c_path_actions + [move_action]))\n  \n  # If the queue becomes empty and no path to the primitive was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:15:06.732585", "function_name": "collect", "function_body": "    actions = []\n\n    # Get action integer mappings from the environment's action_specs\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    # Reset the environment to get the initial state.\n    # This also sets env._current_state to the initial CraftState instance.\n    _ = env.reset()\n    current_state = env._current_state\n\n    # If the primitive is already in the agent's inventory, no actions are needed.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get the global grid and current agent position from the state's features.\n    features_dict = current_state.features_dict()\n    global_grid = features_dict['features_global']\n    current_pos = current_state.pos\n\n    # Find all locations on the grid where the primitive exists.\n    # np.argwhere returns (row, col) coordinates.\n    target_locations = np.argwhere(global_grid[:, :, primitive] > 0)\n\n    # If the primitive is not found anywhere on the grid, it cannot be collected.\n    if len(target_locations) == 0:\n        return []\n\n    # Define a helper function for Manhattan distance to choose the closest target.\n    def manhattan_distance(p1, p2):\n        return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n    # Select the target location closest to the agent's current position.\n    target_r, target_c = min(target_locations, key=lambda loc: manhattan_distance(current_pos, loc))\n\n    # Simulate pathfinding to the target location.\n    # Create a mutable copy of the current position for simulation.\n    simulated_pos = list(current_pos)\n\n    # Simple greedy pathfinding: prioritize vertical movement, then horizontal.\n    # Continue moving until the simulated position matches the target position.\n    while True:\n        if simulated_pos[0] == target_r and simulated_pos[1] == target_c:\n            # Agent has reached the target cell.\n            break\n\n        moved_this_step = False\n        if simulated_pos[0] < target_r:\n            actions.append(DOWN)\n            simulated_pos[0] += 1\n            moved_this_step = True\n        elif simulated_pos[0] > target_r:\n            actions.append(UP)\n            simulated_pos[0] -= 1\n            moved_this_step = True\n        elif simulated_pos[1] < target_c:\n            actions.append(RIGHT)\n            simulated_pos[1] += 1\n            moved_this_step = True\n        elif simulated_pos[1] > target_c:\n            actions.append(LEFT)\n            simulated_pos[1] -= 1\n            moved_this_step = True\n        \n        # This check is a safeguard; ideally, a path should always be found if target is reachable.\n        if not moved_this_step:\n            # If no move was made but not at target, something unexpected happened (e.g., stuck).\n            break\n\n    # Once at the target location, use the item to collect it.\n    actions.append(USE)\n\n    return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:15:06.805341", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants as per action_specs\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Direction deltas (dr, dc) for East, South, West, North (0, 1, 2, 3)\n    # Assuming 0: East, 1: South, 2: West, 3: North based on common DMLab conventions\n    DIR_DELTAS = {\n        0: (0, 1),   # East: row stays, col increases\n        1: (1, 0),   # South: row increases, col stays\n        2: (0, -1),  # West: row stays, col decreases\n        3: (-1, 0)   # North: row decreases, col stays\n    }\n\n    obs = env.observations()\n    features_dict = obs['features_dict']\n\n    current_inventory = features_dict['inventory']\n    if current_inventory[primitive] > 0:\n        return []  # Primitive already collected, no actions needed\n\n    initial_pos = tuple(features_dict['pos'])\n    # Convert one-hot direction array to integer (e.g., [0,1,0,0] -> 1)\n    initial_dir = np.where(features_dict['direction'])[0][0]\n    \n    grid = features_dict['features_global']\n    HEIGHT, WIDTH, _ = grid.shape\n\n    world = env.world\n    # Non-grabbable items (e.g., walls, water) are considered obstacles.\n    non_grabbable_indices = world.non_grabbable_indices\n\n    def is_valid_and_passable(r, c):\n        \"\"\"Checks if cell (r, c) is within grid bounds and does not contain non-grabbable obstacles.\"\"\"\n        if not (0 <= r < HEIGHT and 0 <= c < WIDTH):\n            return False\n        # Check if the cell contains any non-grabbable item (obstacle)\n        for kind_idx in non_grabbable_indices:\n            if grid[r, c, kind_idx] > 0:\n                return False\n        return True\n\n    # BFS state: (row, col, direction, actions_taken)\n    # actions_taken is a list of actions (integers)\n    queue = collections.deque([(initial_pos[0], initial_pos[1], initial_dir, [])])\n    # visited set to prevent cycles and redundant exploration: (row, col, direction)\n    visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n    while queue:\n        r, c, d, actions = queue.popleft()\n\n        # Check if the cell *immediately in front* of the agent contains the primitive.\n        # If so, the agent is in a state where it can perform the USE action.\n        fr, fc = r + DIR_DELTAS[d][0], c + DIR_DELTAS[d][1]\n\n        if 0 <= fr < HEIGHT and 0 <= fc < WIDTH and grid[fr, fc, primitive] > 0:\n            return actions + [USE] # Found a path to collect the primitive\n\n        # Explore possible next states by applying valid actions:\n\n        # 1. Move Forward (UP)\n        nr_up, nc_up = r + DIR_DELTAS[d][0], c + DIR_DELTAS[d][1]\n        if is_valid_and_passable(nr_up, nc_up) and (nr_up, nc_up, d) not in visited:\n            visited.add((nr_up, nc_up, d))\n            queue.append((nr_up, nc_up, d, actions + [UP]))\n\n        # 2. Turn Left (LEFT)\n        nd_left = (d - 1 + 4) % 4 # Ensure direction stays within [0, 3]\n        if (r, c, nd_left) not in visited:\n            visited.add((r, c, nd_left))\n            queue.append((r, c, nd_left, actions + [LEFT]))\n\n        # 3. Turn Right (RIGHT)\n        nd_right = (d + 1) % 4 # Ensure direction stays within [0, 3]\n        if (r, c, nd_right) not in visited:\n            visited.add((r, c, nd_right))\n            queue.append((r, c, nd_right, actions + [RIGHT]))\n\n        # 4. Move Backward (DOWN) - Optional, but can be useful in tight spaces.\n        # This moves the agent in the opposite direction of its current facing.\n        nr_down, nc_down = r + DIR_DELTAS[(d + 2) % 4][0], c + DIR_DELTAS[(d + 2) % 4][1]\n        if is_valid_and_passable(nr_down, nc_down) and (nr_down, nc_down, d) not in visited:\n            visited.add((nr_down, nc_down, d))\n            queue.append((nr_down, nc_down, d, actions + [DOWN]))\n\n    # If the BFS queue is exhausted and no path to the primitive was found,\n    # it means the primitive is unreachable from the current state.\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:16:14.664620", "function_name": "collect", "function_body": "    action_map = env.action_specs()\n    UP = action_map['UP']\n    DOWN = action_map['DOWN']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    current_state = env._current_state \n    \n    # 1. Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    current_pos = current_state.pos\n    grid_width, grid_height, _ = grid.shape \n    \n    non_grabbable_indices = current_state.world.non_grabbable_indices\n\n    # Define possible cardinal movements (dx, dy, action)\n    # Assuming (0,0) is top-left, x increases right, y increases down\n    cardinal_moves = {\n        UP: (0, -1),\n        DOWN: (0, 1),\n        LEFT: (-1, 0),\n        RIGHT: (1, 0)\n    }\n\n    # BFS to find the path to a cell adjacent to (or containing) the primitive\n    # Using collections.deque for efficient popleft\n    queue = collections.deque([(current_pos, [])]) # (position, path_to_here)\n    visited = {current_pos}\n    \n    target_path = None\n\n    while queue:\n        (x, y), path = queue.popleft()\n\n        # Check if primitive is in the current cell or any adjacent cell (3x3 neighborhood)\n        # This aligns with the `next_to` logic for the USE action\n        is_adjacent_to_primitive = False\n        for dx_check in [-1, 0, 1]:\n            for dy_check in [-1, 0, 1]:\n                check_x, check_y = x + dx_check, y + dy_check\n                if 0 <= check_x < grid_width and 0 <= check_y < grid_height:\n                    if grid[check_x, check_y, primitive] == 1:\n                        is_adjacent_to_primitive = True\n                        break\n            if is_adjacent_to_primitive:\n                break\n        \n        if is_adjacent_to_primitive:\n            target_path = path\n            break # Found the closest reachable position from which primitive can be collected\n        \n        # Explore neighbors\n        for action, (dx, dy) in cardinal_moves.items():\n            next_x, next_y = x + dx, y + dy\n            next_pos = (next_x, next_y)\n\n            # Check bounds\n            if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n                continue\n\n            # Check if position is traversable (not a non-grabbable obstacle)\n            is_blocked = False\n            # Iterate through all non-grabbable indices to see if any are present at next_pos\n            for k_idx in non_grabbable_indices:\n                if grid[next_x, next_y, k_idx] == 1:\n                    is_blocked = True\n                    break\n            \n            if is_blocked:\n                continue\n\n            if next_pos not in visited:\n                visited.add(next_pos)\n                queue.append((next_pos, path + [action]))\n\n    if target_path is None:\n        # Primitive not found or unreachable on the grid\n        return []\n    else:\n        # Path found, add USE action at the end to collect the item\n        return target_path + [USE]", "island_id": 7, "scores": {"3": -1}}
