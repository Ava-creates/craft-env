{"timestamp": "2025-07-30T03:53:14.665365", "function_name": "collect", "function_body": "    # Fetch action mappings from the environment for robustness\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    # Map action integer to (dx, dy) coordinate changes\n    # Assuming (0,0) is top-left, x increases right, y increases down\n    # This dictionary will be used for movement during BFS.\n    action_deltas = {\n        ACTION_DOWN: (0, 1),\n        ACTION_UP: (0, -1),\n        ACTION_LEFT: (-1, 0),\n        ACTION_RIGHT: (1, 0),\n    }\n\n    # 1. Reset environment to get initial state\n    obs = env.reset()\n    start_pos = tuple(obs['features_dict']['pos'])\n    grid = obs['features_dict']['features_global']\n    \n    WIDTH, HEIGHT, N_KINDS = grid.shape\n\n    # Get non-grabbable indices from the CraftWorld instance via CraftLab\n    # This is crucial for identifying obstacles during pathfinding.\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # 2. Find all locations of the primitive on the grid\n    primitive_locs = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] == 1:\n                primitive_locs.append((x, y))\n\n    if not primitive_locs:\n        # Primitive not found on the map\n        return []\n\n    # 3. BFS setup\n    # Queue stores tuples of (current_coordinates, path_so_far_as_list_of_actions)\n    queue = collections.deque([(start_pos, [])])\n    visited = {start_pos} # Set of visited coordinates to prevent loops and redundant work\n\n    # 4. BFS loop\n    while queue:\n        curr_pos, curr_path = queue.popleft()\n        px, py = curr_pos\n\n        # Check if current position is adjacent to any primitive location\n        # This means we are in a position from which the 'USE' action can be successful\n        # according to CraftState.next_to's 3x3 neighborhood logic.\n        for target_loc in primitive_locs:\n            tx, ty = target_loc\n            # Check 3x3 neighborhood (including diagonals relative to current position)\n            if abs(px - tx) <= 1 and abs(py - ty) <= 1:\n                # Found a path to a cell adjacent to the primitive.\n                # Append the 'USE' action and return the complete action sequence.\n                return curr_path + [ACTION_USE]\n\n        # Explore valid neighboring cells\n        for action, (dx, dy) in action_deltas.items():\n            next_pos = (px + dx, py + dy)\n            nx, ny = next_pos\n\n            # Validity checks for next_pos:\n            # 1. Bounds check: Ensure the next position is within the grid boundaries.\n            if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n                continue\n            \n            # 2. Visited check: Avoid revisiting cells to prevent cycles and find shortest path.\n            if next_pos in visited:\n                continue\n            \n            # 3. Obstacle check: Determine if the cell is traversable.\n            # A cell is considered an obstacle if it contains a non-grabbable item\n            # that is NOT the primitive we are trying to collect.\n            is_obstacle = False\n            # Iterate through known non-grabbable types.\n            for k_idx in non_grabbable_indices:\n                # If this non-grabbable item is present in the next cell AND\n                # it's not the primitive we are trying to collect/interact with,\n                # then it's an obstacle.\n                if grid[nx, ny, k_idx] == 1 and k_idx != primitive:\n                    is_obstacle = True\n                    break\n            \n            if is_obstacle:\n                continue # Skip this neighbor if it's an obstacle\n            \n            # If all checks pass, add the next position to the queue and mark as visited.\n            visited.add(next_pos)\n            queue.append((next_pos, curr_path + [action]))\n\n    # If the BFS queue is exhausted and no path to the primitive (or an adjacent cell) was found,\n    # it means the primitive is unreachable on the current grid.\n    return []", "island_id": 7, "scores": {"3": -1}}
