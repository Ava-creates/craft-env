{"timestamp": "2025-07-30T17:35:24.136236", "function_name": "collect", "function_body": "    primitive_idx = env.world.cookbook.index.index(primitive)\n    actions = []\n    max_attempts_per_move = 4  # To try different moves if the primary choice is blocked\n    max_total_steps = 200      # Global step limit for the collection attempt\n\n    current_state = env._current_state\n\n    # 0. Check if the primitive is already in inventory\n    if current_state.inventory[primitive_idx] > 0:\n        return []\n\n    for _ in range(max_total_steps):\n        current_state = env._current_state  # Ensure we have the latest state\n\n        # 1. Check if next to primitive and can 'use' it\n        # `next_to` checks 3x3 neighborhood, including agent's cell.\n        # If the primitive is grabbable and next to the agent, `USE` action should collect it.\n        if current_state.next_to(primitive_idx):\n            actions.append(env_factory.ACTIONS.USE)\n            reward, done, obs = env.step(env_factory.ACTIONS.USE)\n            if env._current_state.inventory[primitive_idx] > 0:\n                return actions\n            # If USE didn't result in collection, it might be a crafting station, tool,\n            # or requires a specific recipe not just a pickup. Continue searching.\n\n        # 2. Find primitive location on the global grid\n        # We assume primitives are represented on the grid.\n        # If the primitive is not on the grid at all (e.g., already collected, or requires crafting),\n        # then this method cannot \"collect\" it from the environment.\n        primitive_locations = np.argwhere(current_state.grid[:, :, primitive_idx] == 1)\n\n        chosen_action = None\n        if primitive_locations.size > 0:  # If primitive is found on the grid\n            agent_pos = current_state.pos  # (row, col)\n\n            # Find the closest primitive location (Manhattan distance)\n            target_pos = None\n            min_dist = float('inf')\n            for p_loc in primitive_locations:\n                dist = abs(p_loc[0] - agent_pos[0]) + abs(p_loc[1] - agent_pos[1])\n                if dist < min_dist:\n                    min_dist = dist\n                    target_pos = p_loc\n\n            if target_pos is not None:\n                dy = target_pos[0] - agent_pos[0]\n                dx = target_pos[1] - agent_pos[1]\n\n                # Determine the preferred cardinal movement to reduce distance\n                if abs(dy) > abs(dx):  # Prioritize vertical movement if larger delta\n                    chosen_action = env_factory.ACTIONS.UP if dy < 0 else env_factory.ACTIONS.DOWN\n                elif abs(dx) > abs(dy):  # Prioritize horizontal movement if larger delta\n                    chosen_action = env_factory.ACTIONS.LEFT if dx < 0 else env_factory.ACTIONS.RIGHT\n                else:  # abs(dy) == abs(dx) or dy=dx=0\n                    # If dy=dx=0, agent is on target, but `USE` above didn't collect.\n                    # Fall through to random exploration, as it can't be collected here this way.\n                    if dy != 0: # If non-zero, try vertical\n                        chosen_action = env_factory.ACTIONS.UP if dy < 0 else env_factory.ACTIONS.DOWN\n                    elif dx != 0: # If non-zero, try horizontal\n                        chosen_action = env_factory.ACTIONS.LEFT if dx < 0 else env_factory.ACTIONS.RIGHT\n                    # else (dy=dx=0 and still no chosen_action), it remains None, triggers random move below.\n\n        # 3. Execute movement\n        if chosen_action is not None:\n            initial_pos = current_state.pos\n            actions.append(chosen_action)\n            reward, done, obs = env.step(chosen_action)\n            \n            # If the agent didn't move (likely blocked by an obstacle), try random moves\n            if env._current_state.pos == initial_pos:\n                actions.pop() # Remove the blocked greedy action\n                \n                # Attempt random movements until one works or attempts exhausted\n                moved_successfully = False\n                for _attempt in range(max_attempts_per_move):\n                    random_action = np.random.choice([env_factory.ACTIONS.UP, env_factory.ACTIONS.DOWN,\n                                                      env_factory.ACTIONS.LEFT, env_factory.ACTIONS.RIGHT])\n                    temp_initial_pos = env._current_state.pos\n                    actions.append(random_action)\n                    reward, done, obs = env.step(random_action)\n                    if env._current_state.pos != temp_initial_pos:\n                        moved_successfully = True\n                        break # Successfully moved with a random action\n                    else:\n                        actions.pop() # Remove the blocked random action\n                \n                if not moved_successfully:\n                    # If still stuck after multiple attempts, we might be truly trapped\n                    # or the path to the primitive is impossible with simple moves.\n                    return [] # Indicate failure to collect\n        else:\n            # This branch is taken if:\n            # a) primitive_locations is empty (primitive not on grid)\n            # b) agent is on the target (dy=dx=0) but `USE` didn't work, and no other move was chosen\n            # In these cases, fall back to general exploration (random movement).\n            actions.append(np.random.choice([env_factory.ACTIONS.UP, env_factory.ACTIONS.DOWN,\n                                              env_factory.ACTIONS.LEFT, env_factory.ACTIONS.RIGHT]))\n            reward, done, obs = env.step(actions[-1])\n\n        # If the environment signals done (e.g., max_steps for the DMLab wrapper reached),\n        # or the goal is satisfied (checked at start of loop), stop.\n        if done:\n            break\n\n    # If the loop finishes, it means the primitive was not collected within max_total_steps\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:35:24.206596", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Access the current state from the environment\n    # This assumes direct access to _current_state is allowed for planning.\n    # If not, a different approach (e.g., a simplified state representation) would be needed.\n    initial_state = env._current_state\n\n    # 1. Check if primitive is already collected\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    # 2. Find all locations of the primitive on the grid\n    # This is not strictly necessary for BFS, as next_to() will find them.\n    # However, it could be used for initial checks or for more complex heuristics in future versions.\n    # For now, it serves as a check if the primitive is even present on the grid.\n    primitive_found_on_grid = False\n    width, height, n_kinds = initial_state.grid.shape\n    for x in range(width):\n        for y in range(height):\n            if initial_state.grid[x, y, primitive] > 0:\n                primitive_found_on_grid = True\n                break\n        if primitive_found_on_grid:\n            break\n\n    if not primitive_found_on_grid:\n        # Primitive not found anywhere on the grid\n        return []\n\n    # BFS Setup\n    queue = collections.deque([(initial_state, [])])  # (current_state, actions_taken_so_far)\n\n    # Visited states: (grid_bytes, pos_tuple, dir_int, inventory_bytes)\n    # Using tobytes() for numpy arrays to make them hashable.\n    visited = set()\n    \n    # Add initial state to visited right away\n    initial_state_hash = (initial_state.grid.tobytes(), initial_state.pos, initial_state.dir, initial_state.inventory.tobytes())\n    visited.add(initial_state_hash)\n\n    # Max search depth to prevent infinite loops or excessively long plans\n    MAX_SEARCH_DEPTH = 500  # Heuristic value, can be tuned based on expected map sizes\n\n    # Action constants (assuming these are available from env_factory as per imports)\n    UP = env_factory.UP\n    DOWN = env_factory.DOWN\n    LEFT = env_factory.LEFT\n    RIGHT = env_factory.RIGHT\n    USE = env_factory.USE\n\n    while queue:\n        current_state, current_actions = queue.popleft()\n\n        # Check for max depth to avoid too long computations\n        if len(current_actions) >= MAX_SEARCH_DEPTH:\n            continue\n        \n        # Check if the primitive is in inventory (could have been collected by a previous USE action in BFS)\n        if current_state.inventory[primitive] > 0:\n            return current_actions\n\n        # If agent is next to the primitive, simulate the USE action\n        # If the USE action successfully collects the primitive, this path is a solution.\n        if current_state.next_to(primitive):\n            _, state_after_use = current_state.step(USE)\n            if state_after_use.inventory[primitive] > 0:\n                return current_actions + [USE]\n\n        # Explore possible next states by taking movement actions\n        for action in [UP, DOWN, LEFT, RIGHT]:\n            # Simulate the action to get the next state\n            _, new_state = current_state.step(action)\n\n            # Check if this new state has been visited\n            new_state_hash = (new_state.grid.tobytes(), new_state.pos, new_state.dir, new_state.inventory.tobytes())\n            if new_state_hash not in visited:\n                visited.add(new_state_hash)  # Mark as visited when adding to queue\n                queue.append((new_state, current_actions + [action]))\n\n    # If the queue becomes empty and the primitive hasn't been collected, it's unreachable.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:36:06.448205", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants for clarity (local to this function)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  ACTION_DR_DC = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  all_actions = []\n  max_total_steps = 500  # Max steps to prevent infinite loops\n\n  # Helper function to check if a cell contains an impassable object\n  def _is_cell_impassable(current_grid, non_grabbable_indices, r, c):\n      \"\"\"Checks if a cell is impassable based on its contents (non-grabbable items).\"\"\"\n      # A cell is impassable if it contains any non-grabbable item\n      for k_idx in non_grabbable_indices:\n          if current_grid[r, c, k_idx] == 1:\n              return True\n      return False\n\n  # Initial observations after environment reset\n  obs = env.reset()\n\n  # Helper to perform a step and update the actions list, returning only the done status\n  # and updating the 'obs' variable from the outer scope.\n  def _perform_action_and_update_state(action):\n      nonlocal obs  # Declare obs as nonlocal to allow modification of the outer 'obs'\n      reward, done, new_obs = env.step(action)\n      all_actions.append(action)\n      obs = new_obs  # Update the obs variable in the outer scope\n      return done\n\n  # Check if the primitive is grabbable. If not, it cannot be 'collected' directly.\n  if primitive not in env.world.grabbable_indices:\n      return []\n\n  for step_count in range(max_total_steps):\n      # 1. Check if the primitive is already collected\n      inventory = obs['features_dict']['inventory']\n      if inventory[primitive] > 0:\n          break  # Goal achieved, break loop\n\n      # 2. Get current state information\n      grid = obs['features_dict']['features_global']\n      H, W, _ = grid.shape  # H = rows, W = columns\n      \n      # Current agent position (row, col) from normalized coordinates\n      current_pos_normalized = obs['features_dict']['pos']\n      current_pos = (int(current_pos_normalized[0] * H), int(current_pos_normalized[1] * W))\n\n      # 3. Locate all instances of the primitive on the grid\n      primitive_locations = []\n      for r in range(H):\n          for c in range(W):\n              if grid[r, c, primitive] == 1:\n                  primitive_locations.append((r, c))\n\n      if not primitive_locations:\n          # Primitive not found on the grid and not in inventory. Cannot collect.\n          break \n\n      # 4. Determine valid target cells for the 'USE' action.\n      # An agent can 'USE' an object if it's in its 3x3 neighborhood (including self).\n      target_cells_for_use = set()\n      for pr, pc in primitive_locations:\n          for dr_offset in [-1, 0, 1]:\n              for dc_offset in [-1, 0, 1]:\n                  nr, nc = pr + dr_offset, pc + dc_offset\n                  if 0 <= nr < H and 0 <= nc < W:\n                      target_cells_for_use.add((nr, nc))\n      \n      # 5. Check if agent is already in a position to USE the primitive.\n      if current_pos in target_cells_for_use:\n          path_to_target_cell = []  # No movement needed\n      else:\n          # 6. Pathfinding (BFS) to reach any of the target cells, avoiding impassable cells.\n          queue = collections.deque([(current_pos, [])])  # (position: (r, c), path_actions: list)\n          visited = {current_pos}\n          path_to_target_cell = None\n\n          while queue:\n              (r, c), path_actions = queue.popleft()\n\n              # If current position is one of the target cells, we found a path\n              if (r, c) in target_cells_for_use:\n                  path_to_target_cell = path_actions\n                  break\n\n              # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n              for action_val, (dr, dc) in ACTION_DR_DC.items():\n                  nr, nc = r + dr, c + dc\n\n                  # Check bounds, if already visited, and if the cell is impassable\n                  if (0 <= nr < H and 0 <= nc < W and\n                      (nr, nc) not in visited and\n                      not _is_cell_impassable(grid, env.world.non_grabbable_indices, nr, nc)):\n                      visited.add((nr, nc))\n                      queue.append(((nr, nc), path_actions + [action_val]))\n\n          if path_to_target_cell is None:\n              # Cannot reach any USE-able cell for the primitive.\n              break  # Exit loop, cannot collect\n\n      # 7. Execute movement actions found by BFS\n      for action in path_to_target_cell:\n          done = _perform_action_and_update_state(action)\n          if done:\n              return all_actions # Episode ended\n\n          # Check if collected *during* movement (unlikely for discrete items, but safe)\n          inventory = obs['features_dict']['inventory']\n          if inventory[primitive] > 0:\n              return all_actions # Collected already\n\n      # 8. Execute USE action after reaching a target cell's vicinity\n      done = _perform_action_and_update_state(USE)\n      if done:\n          return all_actions # Episode ended\n\n      # Re-check inventory after USE action\n      inventory = obs['features_dict']['inventory']\n      if inventory[primitive] > 0:\n          break  # Primitive collected, break outer loop\n\n  return all_actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:36:07.411487", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:37:11.850322", "function_name": "collect", "function_body": "  from itertools import product\n  from collections import deque\n\n  actions_taken = []\n\n  # Get action integer IDs from the environment's action_specs\n  action_map = env.action_specs()\n\n  # Define a reasonable max number of steps to prevent infinite loops\n  MAX_COLLECT_STEPS = 200\n\n  # Directions for BFS: (dx, dy, action_id)\n  # Corresponds to DOWN, UP, RIGHT, LEFT based on action_map\n  # Assuming standard CraftWorld actions: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE\n  # Let's map these to actual action_map values for robustness\n  MOVE_ACTIONS = [\n      (0, 1, action_map['DOWN']),   # Move Down (increase y)\n      (0, -1, action_map['UP']),    # Move Up (decrease y)\n      (1, 0, action_map['RIGHT']),  # Move Right (increase x)\n      (-1, 0, action_map['LEFT'])   # Move Left (decrease x)\n  ]\n  USE_ACTION = action_map['USE']\n\n  # Helper function for BFS pathfinding\n  def _find_path_to_primitive_cell(start_pos, grid, primitive_idx):\n    \"\"\"\n    Finds the shortest path (list of actions) from start_pos to any cell\n    containing the primitive_idx using BFS.\n    Returns the path or None if no path is found.\n    \"\"\"\n    grid_width, grid_height, _ = grid.shape\n    q = deque([(start_pos, [])]) # (current_position, path_taken_to_reach_here)\n    visited = {start_pos}\n\n    while q:\n      curr_pos, path = q.popleft()\n      curr_x, curr_y = curr_pos\n\n      # Check if the current cell contains the primitive\n      if grid[curr_x, curr_y, primitive_idx] == 1:\n        return path # Path found to the cell with the primitive\n\n      # Explore neighbors\n      for dx, dy, action in MOVE_ACTIONS:\n        next_x, next_y = curr_x + dx, curr_y + dy\n        next_pos = (next_x, next_y)\n\n        # Check bounds and if already visited\n        if (0 <= next_x < grid_width and\n            0 <= next_y < grid_height and\n            next_pos not in visited):\n          \n          # Assuming all cells are traversable unless out of bounds.\n          # In CraftWorld, agents usually walk over items/workshops, etc.\n          # Impassable obstacles are rare unless explicitly defined (e.g., dedicated wall entity).\n          \n          visited.add(next_pos)\n          q.append((next_pos, path + [action]))\n    \n    return None # No path found\n\n  # Main loop for finding and collecting the primitive\n  for _ in range(MAX_COLLECT_STEPS):\n    # Access current state properties directly for grid, position, inventory\n    # as features() or observations() might provide transformed/normalized versions\n    # and we need raw state for pathfinding on the grid.\n    current_state = env._current_state\n    \n    # 1. Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n      return actions_taken # Goal achieved\n\n    current_pos = current_state.pos\n    grid = current_state.grid\n    \n    action_to_take = None\n    \n    # 2. If the agent is next to the primitive (or on it), use the 'USE' action\n    if current_state.next_to(primitive):\n      action_to_take = USE_ACTION\n    else:\n      # 3. Otherwise, pathfind to the closest instance of the primitive on the grid\n      path_to_primitive_cell = _find_path_to_primitive_cell(current_pos, grid, primitive)\n      \n      if path_to_primitive_cell is not None and len(path_to_primitive_cell) > 0:\n        # Take the first step of the calculated path\n        action_to_take = path_to_primitive_cell[0]\n      else:\n        # If no path found (e.g., primitive not on map, or unreachable)\n        # or path is empty (agent is already on the target cell but next_to didn't trigger,\n        # which means primitive might not be grabbable, or it's gone)\n        # In this case, we break as we cannot proceed.\n        break\n\n    # 4. Execute the determined action\n    if action_to_take is not None:\n      _reward, done, _observations = env.step(action_to_take)\n      actions_taken.append(action_to_take)\n      \n      # If the environment indicates the episode is done (e.g., max_steps reached)\n      if done:\n        break\n    else:\n      # Should ideally not happen if logic is sound, but a safeguard.\n      break\n            \n  return actions_taken", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:37:12.831390", "function_name": "collect", "function_body": "  from collections import deque\n\n  actions_taken = []\n  \n  # Get action integer IDs from the environment's action_specs\n  action_map = env.action_specs()\n  \n  # Get references to world for item type information\n  world = env.world\n  \n  # Define a reasonable max number of steps to prevent infinite loops\n  MAX_COLLECT_STEPS = 200 \n\n  # Map movement actions to (dx, dy) coordinate changes for BFS\n  # CraftWorld agent position `pos` is (column, row).\n  # UP: decreases row (y), column (x) stays same -> (0, -1)\n  # DOWN: increases row (y), column (x) stays same -> (0, 1)\n  # LEFT: decreases column (x), row (y) stays same -> (-1, 0)\n  # RIGHT: increases column (x), row (y) stays same -> (1, 0)\n  move_deltas = {\n      action_map['UP']: (0, -1),\n      action_map['DOWN']: (0, 1),\n      action_map['LEFT']: (-1, 0),\n      action_map['RIGHT']: (1, 0),\n  }\n  \n  # Helper to check if a position is within grid bounds\n  def _is_valid_pos(x, y, grid_shape):\n      width, height, _ = grid_shape\n      return 0 <= x < width and 0 <= y < height\n\n  # Check if the primitive is a known grabbable item.\n  # If it's not grabbable, this function cannot collect it.\n  if primitive not in world.grabbable_indices:\n      return []\n\n  # Main loop for finding and collecting the primitive\n  for _ in range(MAX_COLLECT_STEPS):\n    current_state = env._current_state # Direct access to the internal CraftState\n    \n    # 1. Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n      return actions_taken # Goal achieved\n\n    # 2. If the agent is currently next to the primitive, use it\n    if current_state.next_to(primitive):\n      _reward, done, _observations = env.step(action_map['USE'])\n      actions_taken.append(action_map['USE'])\n      if done:\n        break # Episode finished\n      continue # Go to next iteration to re-check inventory immediately\n\n    current_pos = current_state.pos # Agent's current (x, y) position\n    grid = current_state.grid       # The current grid layout (WIDTH, HEIGHT, n_kinds)\n    grid_width, grid_height, _ = grid.shape\n\n    # 3. Find the shortest path (in terms of moves) to a position from which \n    # the primitive can be 'USE'd (i.e., a position adjacent to the primitive).\n    queue = deque([(current_pos[0], current_pos[1], [])]) # (x, y, path_of_actions_to_reach_here)\n    visited = {(current_pos[0], current_pos[1])} # Keep track of visited positions to avoid cycles\n    \n    path_to_target_adj = None # Stores the action sequence from BFS\n    \n    while queue:\n        px, py, path_so_far = queue.popleft()\n\n        # Check if the current BFS position (px, py) is adjacent to the primitive\n        # (meaning if the agent were here, current_state.next_to(primitive) would be true)\n        is_adjacent_to_primitive = False\n        for dx_nb in [-1, 0, 1]:\n            for dy_nb in [-1, 0, 1]:\n                nx_nb, ny_nb = px + dx_nb, py + dy_nb\n                if _is_valid_pos(nx_nb, ny_nb, grid.shape) and grid[nx_nb, ny_nb, primitive] == 1:\n                    is_adjacent_to_primitive = True\n                    break\n            if is_adjacent_to_primitive:\n                break\n        \n        if is_adjacent_to_primitive:\n            # This (px, py) is a target position for the agent to move to.\n            # path_so_far is the shortest sequence of actions to reach this position.\n            path_to_target_adj = path_so_far\n            break # Path found, exit BFS\n            \n        # Explore valid and unvisited neighboring cells\n        for action_val, (dx, dy) in move_deltas.items():\n            next_x, next_y = px + dx, py + dy\n            if _is_valid_pos(next_x, next_y, grid.shape) and (next_x, next_y) not in visited:\n                # Assuming all empty cells are traversable. CraftWorld typically doesn't have explicit obstacles.\n                visited.add((next_x, next_y))\n                queue.append((next_x, next_y, path_so_far + [action_val]))\n    \n    # 4. Execute the first action from the determined path\n    action_to_take = None\n    if path_to_target_adj is not None and len(path_to_target_adj) > 0:\n        action_to_take = path_to_target_adj[0] # Take the first step found by BFS\n    # If path_to_target_adj is None, it means no path was found to the primitive.\n    # If path_to_target_adj is empty, it means agent is already at a suitable position,\n    # but this case should have been handled by the `next_to(primitive)` check earlier.\n    \n    if action_to_take is not None:\n        # Perform the step in the environment\n        _reward, done, _observations = env.step(action_to_take)\n        actions_taken.append(action_to_take)\n        \n        # If the environment indicates the episode is done (e.g., max_steps reached)\n        if done:\n          break\n    else:\n        # If no valid action could be determined (e.g., primitive unreachable, or gone)\n        break\n            \n  return actions_taken", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:38:08.080564", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs\n  # DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3, USE: 4\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  all_actions = []\n  max_total_steps = 500  # Max steps to prevent infinite loops\n\n  # Initial observations after environment reset (done once per function call)\n  obs = env.reset()\n\n  # Define action mapping for BFS\n  ACTION_DR_DC = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # Check if the primitive is grabbable. If not, this function cannot collect it.\n  if primitive not in env.world.grabbable_indices:\n      return []\n\n  # Get obstacle indices for pathfinding\n  # Assuming env.world.water_index and env.world.stone_index refer to impassable terrain.\n  # These attributes are listed in CraftWorld: water_index: int, stone_index: int\n  water_idx = env.world.water_index\n  stone_idx = env.world.stone_index\n\n  for step_count in range(max_total_steps):\n      # 1. Check if the primitive is already collected\n      inventory = obs['features_dict']['inventory']\n      if inventory[primitive] > 0:\n          break  # Goal achieved, break loop\n\n      # 2. Get current state information\n      grid = obs['features_dict']['features_global']\n      H, W, _ = grid.shape\n      \n      # Current agent position (row, col) from normalized coordinates\n      current_pos_normalized = obs['features_dict']['pos']\n      current_pos = (int(current_pos_normalized[0] * H), int(current_pos_normalized[1] * W))\n\n      # 3. Locate all instances of the primitive on the grid\n      primitive_locations = []\n      for r in range(H):\n          for c in range(W):\n              if grid[r, c, primitive] == 1:\n                  primitive_locations.append((r, c))\n\n      if not primitive_locations:\n          # Primitive not found on the grid and not in inventory. Cannot collect.\n          break\n\n      # 4. Find the closest primitive location using Manhattan distance\n      def manhattan_distance(p1, p2):\n          return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n      target_primitive_loc = min(primitive_locations, key=lambda p: manhattan_distance(current_pos, p))\n\n      # 5. Pathfinding (BFS) to reach the target primitive's cell.\n      # The `USE` action works if agent is in 3x3 neighborhood. Reaching the cell is guaranteed to be in range.\n      \n      queue = collections.deque([(current_pos, [])])  # (position: (r, c), path_actions: list)\n      visited = {current_pos}\n      path_to_target = None\n\n      while queue:\n          (r, c), path_actions = queue.popleft()\n\n          if (r, c) == target_primitive_loc:\n              path_to_target = path_actions\n              break\n\n          for action_val, (dr, dc) in ACTION_DR_DC.items():\n              nr, nc = r + dr, c + dc\n\n              # Check bounds, if already visited, and if the cell is an obstacle (water/stone)\n              if (0 <= nr < H and 0 <= nc < W and\n                  (nr, nc) not in visited and\n                  grid[nr, nc, water_idx] == 0 and # Check if the cell at (nr, nc) is NOT water\n                  grid[nr, nc, stone_idx] == 0):   # Check if the cell at (nr, nc) is NOT stone\n                  \n                  visited.add((nr, nc))\n                  queue.append(((nr, nc), path_actions + [action_val]))\n\n      if path_to_target is None:\n          # Cannot reach the primitive (e.g., blocked by terrain or unreachable path)\n          break\n\n      # 6. Execute movement actions found by BFS\n      for action in path_to_target:\n          reward, done, obs = env.step(action)\n          all_actions.append(action)\n          if done:\n              return all_actions\n\n          # Check if collected during movement (e.g., if multiple items, or immediate pickup on step)\n          inventory = obs['features_dict']['inventory']\n          if inventory[primitive] > 0:\n              return all_actions\n\n      # 7. Execute USE action after reaching the primitive's vicinity\n      reward, done, obs = env.step(USE)\n      all_actions.append(USE)\n      if done:\n          return all_actions\n\n      # Re-check inventory after USE action\n      inventory = obs['features_dict']['inventory']\n      if inventory[primitive] > 0:\n          break  # Primitive collected, break outer loop\n\n  return all_actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:38:08.151021", "function_name": "collect", "function_body": "    import collections\n\n    all_actions = []\n    max_total_steps = 500  # Max steps to prevent infinite loops\n\n    # Define action constants for clarity\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4 # Based on CraftLab.action_specs()\n\n    # Initial observations after environment reset\n    obs = env.reset()\n\n    # Check if the primitive is grabbable. If not, it cannot be 'collected' directly.\n    if primitive not in env.world.grabbable_indices:\n        return []\n\n    for step_count in range(max_total_steps):\n        # 1. Check if the primitive is already collected\n        inventory = obs['features_dict']['inventory']\n        if inventory[primitive] > 0:\n            break  # Goal achieved, break loop\n\n        # 2. Get current state information\n        grid = obs['features_dict']['features_global']\n        H, W, _ = grid.shape\n        \n        # Current agent position (row, col) from normalized coordinates\n        current_pos_normalized = obs['features_dict']['pos']\n        current_pos = (int(current_pos_normalized[0] * H), int(current_pos_normalized[1] * W))\n\n        # 3. Locate all instances of the primitive on the grid\n        primitive_locations = []\n        for r in range(H):\n            for c in range(W):\n                if grid[r, c, primitive] == 1:\n                    primitive_locations.append((r, c))\n\n        if not primitive_locations:\n            # Primitive not found on the grid and not in inventory. Cannot collect.\n            break # Exit loop, returning collected actions so far (likely empty)\n\n        # 4. Find the closest primitive location using Manhattan distance\n        def manhattan_distance(p1, p2):\n            return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n        target_primitive_loc = min(primitive_locations, key=lambda p: manhattan_distance(current_pos, p))\n\n        # 5. Determine valid target cells for BFS (3x3 neighborhood around the target primitive)\n        # Agent needs to be in one of these cells to successfully USE the primitive.\n        target_cells_for_use = set()\n        r_prim, c_prim = target_primitive_loc\n        for dr_adj in [-1, 0, 1]:\n            for dc_adj in [-1, 0, 1]:\n                nr_adj, nc_adj = r_prim + dr_adj, c_prim + dc_adj\n                if 0 <= nr_adj < H and 0 <= nc_adj < W:\n                    target_cells_for_use.add((nr_adj, nc_adj))\n\n        # 6. Pathfinding (BFS) to reach one of the target_cells_for_use.\n        queue = collections.deque([(current_pos, [])])  # (position: (r, c), path_actions: list)\n        visited = {current_pos}\n        path_to_target = None\n\n        # Define non-grabbable (obstacle) indices for movement.\n        # Agent can move onto a cell containing the primitive it wants to collect,\n        # so exclude the primitive itself from obstacles.\n        obstacle_kinds_for_movement = {k for k in env.world.non_grabbable_indices if k != primitive}\n        \n        ACTION_DR_DC = {\n            _DOWN: (1, 0),\n            _UP: (-1, 0),\n            _LEFT: (0, -1),\n            _RIGHT: (0, 1)\n        }\n\n        while queue:\n            (r, c), path_actions = queue.popleft()\n\n            # If current position is one of the target cells, we found a path\n            if (r, c) in target_cells_for_use:\n                path_to_target = path_actions\n                break\n\n            # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n            for action_val, (dr, dc) in ACTION_DR_DC.items():\n                nr, nc = r + dr, c + dc\n\n                # Check bounds and if already visited\n                if 0 <= nr < H and 0 <= nc < W and (nr, nc) not in visited:\n                    # Check if the next cell (nr, nc) is traversable.\n                    # A cell is traversable if it does not contain any obstacle kind.\n                    is_traversable = True\n                    for k_obstacle in obstacle_kinds_for_movement:\n                        if grid[nr, nc, k_obstacle] == 1:\n                            is_traversable = False\n                            break\n                    \n                    if is_traversable:\n                        visited.add((nr, nc))\n                        queue.append(((nr, nc), path_actions + [action_val]))\n\n        if path_to_target is None:\n            # Cannot reach any cell within the primitive's 3x3 neighborhood\n            break\n\n        # 7. Execute movement actions found by BFS\n        for action in path_to_target:\n            reward, done, obs = env.step(action)\n            all_actions.append(action)\n            if done:\n                return all_actions # Episode ended\n\n            # Check if collected *during* movement (unlikely for discrete items, but safe)\n            inventory = obs['features_dict']['inventory']\n            if inventory[primitive] > 0:\n                return all_actions\n\n        # 8. Execute USE action after reaching the primitive's vicinity\n        reward, done, obs = env.step(_USE)\n        all_actions.append(_USE)\n        if done:\n            return all_actions\n\n        # Re-check inventory after USE action\n        inventory = obs['features_dict']['inventory']\n        if inventory[primitive] > 0:\n            break  # Primitive collected, break outer loop\n\n    return all_actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:40:14.110404", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  import collections\n  import env_factory \n  \n  # Retrieve constants from env_factory module\n  ACTION_UP = env_factory.ACTION_UP\n  ACTION_RIGHT = env_factory.ACTION_RIGHT\n  ACTION_DOWN = env_factory.ACTION_DOWN\n  ACTION_LEFT = env_factory.ACTION_LEFT\n  ACTION_USE = env_factory.ACTION_USE\n  MAX_COLLECT_STEPS = env_factory.MAX_COLLECT_STEPS\n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"Returns the coordinates of the cell directly in front of (y,x) based on direction.\"\"\"\n      if direction == 0: return y - 1, x # UP\n      if direction == 1: return y, x + 1 # RIGHT\n      if direction == 2: return y + 1, x # DOWN\n      if direction == 3: return y, x - 1 # LEFT\n      return y, x\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state\n  current_obs = env.reset() \n  # Access the internal CraftState instance for detailed information\n  current_state = env._current_state \n\n  # Ensure the primitive is a valid kind known to the world\n  if primitive not in current_state.world.cookbook.kinds:\n      return [] \n  \n  # V1 Improvement: Ensure the primitive is actually grabbable.\n  # If it's not grabbable, it cannot be put into inventory.\n  if primitive not in current_state.world.grabbable_indices:\n      return []\n\n  # Check if the primitive is already in the inventory\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.init_dir \n\n  impassable_kinds = current_state.world.non_grabbable_indices\n\n  # Define movement actions and their resulting directions and (dy, dx) changes.\n  # Direction mapping: 0=Up, 1=Right, 2=Down, 3=Left\n  movement_actions_map = {\n      ACTION_UP:    (0, -1, 0), # (resulting_direction, dy, dx)\n      ACTION_RIGHT: (1, 0, 1),\n      ACTION_DOWN:  (2, 1, 0),\n      ACTION_LEFT:  (3, 0, -1)\n  }\n\n  # If MAX_COLLECT_STEPS is 0 or negative, no actions are allowed.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  q = collections.deque()\n  # BFS state in queue: (current_y, current_x, current_direction, steps_taken_so_far)\n  q.append((start_y, start_x, start_dir, 0))\n\n  # V2 Improvement: Use parent pointers for path reconstruction to save memory and potentially time\n  # visited maps (y, x, dir) -> (parent_y, parent_x, parent_dir, action_to_reach_this_state)\n  visited = {(start_y, start_x, start_dir): (None, None, None, None)}\n  \n  goal_state_reached_bfs = None # Will store the (y, x, dir) state from which ACTION_USE should be performed\n\n  # --- BFS to find a path to a position and orientation suitable for collection ---\n  while q:\n      curr_y, curr_x, curr_dir, steps = q.popleft()\n\n      # Check if the primitive is directly in front of the agent at current (y,x,dir)\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Ensure facing coordinates are within bounds and check if the cell contains the primitive\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n          full_grid[facing_y, facing_x, primitive] > 0):\n          \n          # We found a path to a position and orientation where ACTION_USE should work.\n          # The path to curr_y, curr_x, curr_dir has `steps` actions.\n          # Adding ACTION_USE will make the total path `steps + 1`.\n          if steps + 1 <= MAX_COLLECT_STEPS:\n              goal_state_reached_bfs = (curr_y, curr_x, curr_dir)\n              break # Path found and within limits, exit BFS\n\n      # Explore neighbors (movement actions)\n      # Prune BFS branches early if adding another step (movement) exceeds MAX_COLLECT_STEPS.\n      if steps + 1 > MAX_COLLECT_STEPS: \n          continue\n\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          \n          # Check bounds for the next agent position\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the next cell is traversable (does not contain any impassable kind)\n          is_traversable = True\n          for k_idx in impassable_kinds:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n          \n          # Check if this (position, direction) state has been visited\n          if (next_y, next_x, next_dir) not in visited:\n              visited[(next_y, next_x, next_dir)] = (curr_y, curr_x, curr_dir, action_move)\n              q.append((next_y, next_x, next_dir, steps + 1))\n  \n  # --- Path Reconstruction (V2 Improvement) ---\n  if goal_state_reached_bfs is None:\n      return [] # No path found within MAX_COLLECT_STEPS to collect the primitive\n\n  reconstructed_path = []\n  current_node = goal_state_reached_bfs\n  \n  while True:\n      # Retrieve parent state and the action taken to reach current_node from parent\n      parent_y, parent_x, parent_dir, action_to_current = visited[current_node]\n      if action_to_current is None: # We've reached the start node (its parent is None)\n          break\n      reconstructed_path.append(action_to_current)\n      current_node = (parent_y, parent_x, parent_dir)\n  \n  reconstructed_path.reverse() # Path was built from goal to start, so reverse it\n  reconstructed_path.append(ACTION_USE) # Add the final ACTION_USE to collect the primitive\n\n  # --- Execute the found path ---\n  for action in reconstructed_path:\n      actions_taken.append(action)\n      \n      reward, done, _ = env.step(action) # Execute the action in the environment\n      current_state = env._current_state # Update state after the step\n\n      # If the goal is satisfied (primitive collected), we can stop early\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n  \n  # Final check: if the primitive was collected after executing the full path.\n  # This covers cases where the collection might happen on the very last step.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If we reached here, the full path was executed, but collection failed.\n      # This implies an issue with the environment or assumptions, as the BFS found a path.\n      return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:40:15.087594", "function_name": "collect", "function_body": "  import collections\n\n  # Helper function (defined within collect_v2 as per \"only return code that will fit in that function\" rule)\n  def _get_facing_coords(y, x, direction):\n      \"\"\"Returns the coordinates of the cell directly in front of (y,x) based on direction.\"\"\"\n      if direction == 0: return y - 1, x # UP\n      if direction == 1: return y, x + 1 # RIGHT\n      if direction == 2: return y + 1, x # DOWN\n      if direction == 3: return y, x - 1 # LEFT\n      return y, x # Should not be reached for valid movement directions\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state\n  current_obs = env.reset() \n  # Access the internal CraftState instance for detailed information\n  current_state = env._current_state \n\n  # Ensure the primitive is a valid kind known to the world\n  if primitive not in current_state.world.cookbook.kinds:\n      return [] \n\n  # Check if the primitive is already in the inventory\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.init_dir # Agent's initial facing direction\n\n  # IMPROVEMENT for v2: Refine impassable_kinds for movement\n  # This is based on a common heuristic: workshops are often traversable even if non-grabbable.\n  # Water/lava (if present) are typically movement blockers.\n  # Assuming 'water_index' specifically refers to a blocking entity.\n  impassable_for_movement = set()\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  # Any non_grabbable_indices that are NOT workshop_indices are assumed to be true blockers.\n  # This refines the v0/v1 assumption that ALL non_grabbable are blockers by allowing movement\n  # onto non-grabbable but typically traversable structures like workshops.\n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n\n  # Define movement actions and their resulting directions and (dy, dx) changes.\n  # Direction mapping: 0=Up, 1=Right, 2=Down, 3=Left\n  movement_actions_map = {\n      ACTION_UP:    (0, -1, 0), # (resulting_direction, dy, dx)\n      ACTION_RIGHT: (1, 0, 1),\n      ACTION_DOWN:  (2, 1, 0),\n      ACTION_LEFT:  (3, 0, -1)\n  }\n\n  q = collections.deque()\n  # BFS state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  \n  # If MAX_COLLECT_STEPS is 0 or negative, no actions are allowed.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # Initialize BFS queue with the starting state\n  q.append((start_y, start_x, start_dir, []))\n  # Visited set now tracks (position, direction) to allow for pathing through the same cell\n  # but facing a different direction, which is crucial for `ACTION_USE` success.\n  visited = {(start_y, start_x, start_dir)} \n\n  path_to_execute = None # Will store the sequence of actions including the final ACTION_USE\n\n  # --- BFS to find a path to a position and orientation suitable for collection ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Check if the primitive is directly in front of the agent at current (y,x,dir)\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Ensure facing coordinates are within bounds and check if the cell contains the primitive\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n          full_grid[facing_y, facing_x, primitive] > 0):\n          \n          # We found a path to a position and orientation where ACTION_USE should work.\n          candidate_path = path + [ACTION_USE]\n          \n          # Only accept paths that are within MAX_COLLECT_STEPS.\n          # Since BFS finds shortest paths first, the first valid path found will be the shortest.\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              break # Path found and within limits, exit BFS\n\n      # Explore neighbors (movement actions)\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          \n          # Prune BFS branches early if adding another step exceeds MAX_COLLECT_STEPS.\n          if len(path) + 1 > MAX_COLLECT_STEPS:\n              continue\n\n          # Check bounds for the next agent position\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the next cell is traversable using the refined impassable set\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n          \n          # Check if this (position, direction) state has been visited\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n  \n  # --- Execute the found path (if any) ---\n  if path_to_execute is None:\n      return [] # No path found within MAX_COLLECT_STEPS to collect the primitive\n\n  for action in path_to_execute:\n      actions_taken.append(action)\n      # No need to check MAX_COLLECT_STEPS here, as path_to_execute is guaranteed to be within limits\n      reward, done, _ = env.step(action)\n      current_state = env._current_state # Update state after the step\n\n      # Check for episode termination without goal satisfaction (IMPROVEMENT from v1)\n      if done and current_state.inventory[primitive] <= 0:\n          return [] # Episode ended prematurely, collection failed\n\n      # If the goal is satisfied (primitive collected), we can stop early\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n  \n  # Final check: if the primitive was collected after executing the full path.\n  # This covers cases where the collection might happen on the very last step.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If we reached here, the full path was executed, but collection failed.\n      # This implies an issue with the environment or assumptions, as the BFS found a path.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:41:33.023437", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Mapping from movement action to the direction the agent would face after taking it\n  action_to_direction = {\n      UP_ACTION: NORTH_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  # Mapping from movement action to (dx, dy) delta\n  action_to_move_delta = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  # Adjacent deltas for finding neighbors (for items collected from adjacent cells)\n  ADJACENCY_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"\n    Calculates the direction the agent needs to face to look at the item.\n    Assumes item is directly adjacent (cardinally) to the agent.\n    \"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dx == 0 and dy == 1: return SOUTH_DIR\n    if dx == 0 and dy == -1: return NORTH_DIR\n    return None # Item is not cardinally adjacent, or agent is on item\n\n  # Get target item's integer ID\n  target_id = env.world.cookbook.index[primitive]\n\n  # Determine if the target is a primitive resource or a workshop\n  is_primitive_resource = target_id in env.world.cookbook.primitives\n  is_workshop = target_id in env.world.workshop_indices\n\n  current_state = env._current_state\n  # Early exit: If we're collecting a primitive resource and already have it, no actions needed.\n  if is_primitive_resource and current_state.inventory[target_id] > 0:\n    return []\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  non_grabbable_kinds = env.world.non_grabbable_indices\n  \n  def is_traversable(x, y, current_grid, target_kind_id, is_target_primitive_resource, is_target_workshop):\n    \"\"\"\n    Checks if a given grid cell (x, y) is traversable for the agent.\n    - Within bounds.\n    - Not occupied by any non-grabbable item (unless it's the target workshop, which can be stepped onto).\n    - Not occupied by the target primitive resource (if the goal is to collect it from an adjacent cell).\n    \"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check for general non-grabbable obstacles (like water, stone)\n    for kind_idx in non_grabbable_kinds:\n      if current_grid[y, x, kind_idx] > 0:\n        # If the cell is occupied by a non-grabbable item, it's usually not traversable.\n        # EXCEPTION: If the non-grabbable item IS the target workshop, and we are allowed to step onto workshops.\n        if is_target_workshop and kind_idx == target_kind_id:\n            continue # This specific non-grabbable is our target workshop, we can step on it.\n        else:\n            return False # It's a general obstacle, cannot traverse.\n\n    # If the target is a primitive resource, the agent cannot walk onto the cell it occupies.\n    # Agent must interact with primitives from an adjacent cell.\n    if is_target_primitive_resource and current_grid[y, x, target_kind_id] > 0:\n        return False\n        \n    return True\n\n  # 1. Find all locations of the target item on the grid\n  item_y_coords, item_x_coords = np.where(grid[:, :, target_id] == 1)\n\n  if len(item_x_coords) == 0:\n    return [] # Target item not found on the grid\n\n  # 2. Identify all target interaction points for BFS goal states.\n  # A target interaction point is (adjacent_x, adjacent_y, required_facing_direction_to_item).\n  # For workshops, the agent needs to move *onto* the workshop.\n  # For primitive resources, the agent needs to be *adjacent* to it.\n  target_interaction_points = set()\n  \n  if is_workshop:\n      for i in range(len(item_x_coords)):\n          workshop_x, workshop_y = item_x_coords[i], item_y_coords[i]\n          # For a workshop, the agent must be *on* the workshop cell.\n          # We consider reaching the workshop in any of the four cardinal directions as a valid goal state.\n          # The USE action itself on a workshop typically doesn't depend on facing a particular sub-part.\n          for d in [NORTH_DIR, EAST_DIR, SOUTH_DIR, WEST_DIR]:\n              if is_traversable(workshop_x, workshop_y, grid, target_id, is_primitive_resource, is_workshop):\n                  target_interaction_points.add((workshop_x, workshop_y, d))\n  else: # Target is a primitive resource or other item collected from an adjacent cell\n      for i in range(len(item_x_coords)):\n          item_x, item_y = item_x_coords[i], item_y_coords[i]\n          # Check all 4 cardinal neighbors of the item to find valid adjacent positions\n          for dx, dy in ADJACENCY_DELTAS:\n              adj_x, adj_y = item_x + dx, item_y + dy\n              # Check if this adjacent cell is traversable.\n              if is_traversable(adj_x, adj_y, grid, target_id, is_primitive_resource, is_workshop):\n                  # Determine the direction the agent needs to face the item from this adjacent cell\n                  required_facing_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n                  if required_facing_dir is not None:\n                      target_interaction_points.add((adj_x, adj_y, required_facing_dir))\n\n  if not target_interaction_points:\n    return [] # No reachable interaction points (adjacent for primitives, on-cell for workshops)\n\n  # 3. Initialize BFS queue: (current_x, current_y, current_direction, path_actions_list)\n  queue = collections.deque([(start_pos_x, start_pos_y, start_dir, [])])\n  # 4. Initialize visited set to avoid cycles and redundant paths: (x, y, direction)\n  visited = {(start_pos_x, start_pos_y, start_dir)}\n\n  # 5. Run BFS\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the current state is a goal state (can immediately interact with the item)\n    if (curr_x, curr_y, curr_dir) in target_interaction_points:\n      if is_primitive_resource:\n        # If collecting a primitive resource, we need to path to an adjacent cell and then USE it.\n        return path_actions + [USE_ACTION]\n      elif is_workshop:\n        # If the target is a workshop, just reaching it (stepping onto its cell) is sufficient.\n        # The 'collect' function here means reaching the interaction point, not necessarily using it.\n        return path_actions\n      else:\n        # Fallback for unknown item types: path to its adjacency/on-cell,\n        # if it's a primitive resource, add USE, otherwise just path.\n        # (This else branch should ideally not be hit if primitives and workshops cover all cases)\n        return path_actions + ([USE_ACTION] if is_primitive_resource else []) \n\n    # --- Expand possible next states ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for move_action, (dx, dy) in action_to_move_delta.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      # After a movement action, the agent's direction automatically aligns with the movement direction.\n      next_dir_after_move = action_to_direction[move_action]\n\n      if is_traversable(next_x, next_y, grid, target_id, is_primitive_resource, is_workshop) and \\\n         (next_x, next_y, next_dir_after_move) not in visited:\n        visited.add((next_x, next_y, next_dir_after_move))\n        queue.append((next_x, next_y, next_dir_after_move, path_actions + [move_action]))\n\n    # B. Turning Actions (LEFT, RIGHT)\n    # These actions change direction but not position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n\n      # Position remains the same.\n      if (curr_x, curr_y, next_dir) not in visited:\n        visited.add((curr_x, curr_y, next_dir))\n        queue.append((curr_x, curr_y, next_dir, path_actions + [turn_action]))\n\n  # If the queue becomes empty and no path to the target was found.\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:41:33.996484", "function_name": "collect", "function_body": "  import collections\n\n  # Define constants for actions and directions\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0  # Agent facing UP (negative Y)\n  EAST_DIR = 1   # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2  # Agent facing DOWN (positive Y)\n  WEST_DIR = 3   # Agent facing LEFT (negative X)\n\n  # Mapping from movement action to (dx, dy) delta and resulting facing direction\n  ACTION_MOVE_INFO = {\n      UP_ACTION: (0, -1, NORTH_DIR),\n      DOWN_ACTION: (0, 1, SOUTH_DIR),\n      LEFT_ACTION: (-1, 0, WEST_DIR),\n      RIGHT_ACTION: (1, 0, EAST_DIR),\n  }\n\n  # Cardinal deltas for checking adjacent cells\n  ADJACENCY_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"\n    Calculates the direction the agent needs to face to look at an item.\n    Assumes the item is directly cardinally adjacent to the agent.\n    \"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dx == 0 and dy == 1: return SOUTH_DIR\n    if dx == 0 and dy == -1: return NORTH_DIR\n    return None # Item is not cardinally adjacent, or agent is on item\n\n  # Get target item's integer ID from the cookbook index\n  target_id = env.world.cookbook.index[primitive]\n\n  current_state = env._current_state\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  def _is_cell_obstacle(x, y, current_grid, non_grabbable_indices, workshop_indices, target_item_id):\n    \"\"\"\n    Checks if a grid cell (x, y) is an obstacle for agent movement.\n    A cell is considered an obstacle if:\n    1. It is out of grid bounds.\n    2. It contains any non-grabbable item (e.g., water, stone).\n    3. It contains a workshop (as workshops are typically not traversable).\n    4. It contains the `target_item_id` itself (as the agent needs to be adjacent, not on it, to collect/use).\n    \"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return True # Out of bounds is an obstacle\n\n    # Check for general non-grabbable items (e.g., water, stone)\n    for kind_idx in non_grabbable_indices:\n      if current_grid[y, x, kind_idx] > 0:\n        return True\n    \n    # Check for workshop locations, which are also typically non-traversable\n    for kind_idx in workshop_indices:\n      if current_grid[y, x, kind_idx] > 0:\n        return True\n\n    # If the cell contains the specific target item we are trying to interact with,\n    # it's considered an obstacle for movement, as interaction happens from an adjacent cell.\n    if current_grid[y, x, target_item_id] > 0:\n      return True\n\n    return False\n\n  # 1. Find all locations of the target item on the grid\n  item_y_coords, item_x_coords = np.where(grid[:, :, target_id] == 1)\n\n  if len(item_x_coords) == 0:\n    return [] # Target item not found on the grid\n\n  # 2. Identify all target interaction points for BFS goal states.\n  # A target interaction point is (adjacent_x, adjacent_y, required_facing_direction_to_item).\n  # These are the states (position and direction) from which the agent can perform a USE action.\n  target_interaction_points = set()\n  for i in range(len(item_x_coords)):\n    item_x, item_y = item_x_coords[i], item_y_coords[i]\n    # Check all 4 cardinal neighbors of the item\n    for dx, dy in ADJACENCY_DELTAS:\n      adj_x, adj_y = item_x + dx, item_y + dy\n      \n      # A cell is a valid adjacent interaction point if it's not an obstacle for movement\n      if not _is_cell_obstacle(adj_x, adj_y, grid, \n                               env.world.non_grabbable_indices, \n                               env.world.workshop_indices, \n                               target_id):\n        \n        # Determine the direction the agent needs to face to use the item from this adjacent cell\n        required_facing_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_facing_dir is not None:\n          target_interaction_points.add((adj_x, adj_y, required_facing_dir))\n\n  if not target_interaction_points:\n    return [] # No reachable adjacent cells to any target item\n\n  # 3. Initialize BFS queue: stores (current_x, current_y, current_direction)\n  queue = collections.deque([(start_pos_x, start_pos_y, start_dir)])\n  \n  # 4. Initialize `parent_map` for path reconstruction:\n  # Maps (next_x, next_y, next_dir) to (curr_x, curr_y, curr_dir, action_taken_to_reach_next_state)\n  parent_map = {} \n  parent_map[(start_pos_x, start_pos_y, start_dir)] = None # The start state has no parent\n\n  # 5. Run BFS\n  goal_state_reached = None # Will store the (x, y, dir) of the goal state if found\n\n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state is a goal state (i.e., we are at a valid interaction point)\n    if (curr_x, curr_y, curr_dir) in target_interaction_points:\n      goal_state_reached = (curr_x, curr_y, curr_dir)\n      break # Path found, exit BFS\n\n    # --- Explore possible next states from current state ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for move_action, (dx, dy, new_dir_after_move) in ACTION_MOVE_INFO.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      \n      # Check if the next cell is traversable/walkable (not an obstacle)\n      if not _is_cell_obstacle(next_x, next_y, grid, \n                               env.world.non_grabbable_indices, \n                               env.world.workshop_indices, \n                               target_id):\n        \n        next_state = (next_x, next_y, new_dir_after_move)\n        # If this state has not been visited yet\n        if next_state not in parent_map: \n          parent_map[next_state] = (curr_x, curr_y, curr_dir, move_action)\n          queue.append(next_state)\n\n    # B. Turning Actions (LEFT, RIGHT)\n    # These actions change direction but not position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n\n      next_state = (curr_x, curr_y, next_dir)\n      # If this state has not been visited yet\n      if next_state not in parent_map: \n        parent_map[next_state] = (curr_x, curr_y, curr_dir, turn_action)\n        queue.append(next_state)\n\n  # 6. Reconstruct the path if a goal state was reached\n  if goal_state_reached is None:\n    return [] # No path found to any valid interaction point\n\n  path_actions = []\n  current = goal_state_reached\n  # Backtrack from the goal state to the start state using the parent_map\n  while parent_map[current] is not None: \n    parent_x, parent_y, parent_dir, action_to_get_here = parent_map[current]\n    path_actions.append(action_to_get_here)\n    current = (parent_x, parent_y, parent_dir)\n  \n  path_actions.reverse() # Actions were collected in reverse order, so reverse them\n\n  # Add the final USE action to interact with the target item\n  path_actions.append(USE_ACTION)\n\n  return path_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:42:39.440737", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  # Map movement actions to the new direction and (dx, dy) delta\n  # This combines ACTION_TO_DIRECTION and DIRECTION_TO_DELTA for efficiency\n  ACTION_TO_EFFECT = {\n      UP: (DIR_UP, 0, -1),    # (new_direction, delta_x, delta_y)\n      DOWN: (DIR_DOWN, 0, 1),\n      LEFT: (DIR_LEFT, -1, 0),\n      RIGHT: (DIR_RIGHT, 1, 0),\n  }\n\n  # Map (dx, dy) delta to the agent's direction required to face that delta\n  DELTA_TO_DIRECTION = {\n      (0, -1): DIR_UP,\n      (1, 0): DIR_RIGHT,\n      (0, 1): DIR_DOWN,\n      (-1, 0): DIR_LEFT,\n  }\n\n  # 1. Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  initial_dir = np.argmax(obs['features_dict']['direction'])\n\n  world = env.world\n  # Convert to list for robust indexing with numpy advanced indexing\n  non_grabbable_indices = list(world.non_grabbable_indices) \n\n  W, H, K = grid.shape\n\n  # 2. Determine traversable cells\n  # A cell is NOT traversable if it contains any non-grabbable item (obstacle).\n  traversable_mask = np.ones((W, H), dtype=bool)\n  if non_grabbable_indices:\n      obstacles_present = np.any(grid[:, :, non_grabbable_indices] > 0, axis=2)\n      traversable_mask = ~obstacles_present\n  \n  # Helper function to check if a coordinate is within bounds and traversable\n  def is_valid_and_traversable(x, y):\n      return 0 <= x < W and 0 <= y < H and traversable_mask[x, y]\n\n  # If the agent starts on an untraversable cell, no path possible.\n  if not is_valid_and_traversable(current_pos_x, current_pos_y):\n      return []\n\n  # 3. Identify all locations of the target primitive on the grid\n  primitive_locations = []\n  # np.where returns (row_indices, col_indices). For grid[x,y], col_idx is x, row_idx is y.\n  py_coords, px_coords = np.where(grid[:, :, primitive] > 0)\n  for px, py in zip(px_coords, py_coords):\n      primitive_locations.append((px, py))\n\n  # If the primitive doesn't exist anywhere on the map, we can't collect it.\n  if not primitive_locations:\n      return []\n\n  # 4. Identify \"primitive target states\": (agent_x, agent_y, agent_dir) from which\n  # the USE action can successfully collect the primitive.\n  # This means the agent must be adjacent to the primitive and facing it.\n  primitive_target_states = set()\n  for px, py in primitive_locations:\n      # Iterate over 4 possible relative positions (dx, dy) from agent to primitive\n      # e.g., if (dx,dy) is (0,1), primitive is below agent.\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: \n          # Agent's potential position (ax, ay) given primitive (px,py) and delta (dx,dy)\n          ax, ay = px - dx, py - dy \n\n          if not is_valid_and_traversable(ax, ay):\n              continue\n          \n          # The agent's required direction is the direction of the vector from (ax,ay) to (px,py),\n          # which is (dx, dy).\n          required_agent_dir = DELTA_TO_DIRECTION[(dx, dy)]\n          \n          primitive_target_states.add((ax, ay, required_agent_dir))\n\n  # If no valid target states exist (e.g., primitive is surrounded by untraversable cells),\n  # then it's uncollectable.\n  if not primitive_target_states:\n      return []\n\n  # 5. Perform BFS search on state space (x, y, direction)\n  start_state = (current_pos_x, current_pos_y, initial_dir)\n  \n  # Queue stores tuples: ((curr_x, curr_y, curr_dir), [actions_so_far])\n  q = deque([(start_state, [])]) \n  \n  # Visited set stores (x, y, dir) states to avoid cycles and redundant paths\n  visited = {start_state}\n\n  while q:\n      (curr_x, curr_y, curr_dir), actions_so_far = q.popleft()\n\n      # Check if the current state is a primitive target state\n      if (curr_x, curr_y, curr_dir) in primitive_target_states:\n          return actions_so_far + [USE]\n\n      # Explore possible next states by taking movement actions\n      # Movement actions change both position AND the agent's facing direction.\n      for action_val, (next_dir, dx, dy) in ACTION_TO_EFFECT.items():\n          next_x, next_y = curr_x + dx, curr_y + dy # New position\n          next_state = (next_x, next_y, next_dir)\n\n          # Check if the next cell is within bounds, traversable, and not yet visited\n          if (is_valid_and_traversable(next_x, next_y) and\n              next_state not in visited):\n              \n              visited.add(next_state)\n              q.append((next_state, actions_so_far + [action_val]))\n  \n  # If the BFS queue becomes empty and no path to a target state was found\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:42:40.399051", "function_name": "collect", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:43:41.218763", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Action and Direction Constants\n  # These are numerical values for actions that can be passed to env.step().\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # These are numerical values representing the agent's facing direction.\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  # Map agent's facing direction to (dx, dy) delta for moving \"forward\" in that direction.\n  # (dx, dy) represents the change in (x, y) coordinates.\n  # Assuming (x,y) corresponds to (column, row) in the grid, where +x is right, +y is down.\n  DIR_DELTAS = {\n      DIR_UP: (0, -1),   # Moving up: x constant, y decreases\n      DIR_RIGHT: (1, 0),  # Moving right: x increases, y constant\n      DIR_DOWN: (0, 1),   # Moving down: x constant, y increases\n      DIR_LEFT: (-1, 0),  # Moving left: x decreases, y constant\n  }\n\n  # Pre-compute a reverse mapping from (dx, dy) vector to the corresponding DIR_ constant.\n  # This optimizes the lookup when determining the required agent direction to face a primitive.\n  VECTOR_TO_DIR = {v: k for k, v in DIR_DELTAS.items()}\n\n  # Map a movement action to the agent's resulting facing direction.\n  # In CraftWorld, movement actions also orient the agent in the direction of movement.\n  ACTION_TO_RESULTING_DIR = {\n      ACTION_UP: DIR_UP,\n      ACTION_RIGHT: DIR_RIGHT,\n      ACTION_DOWN: DIR_DOWN,\n      ACTION_LEFT: DIR_LEFT,\n  }\n\n  # List of all movement actions (excluding USE).\n  MOVEMENT_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # 1. Get current state information from the environment.\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Extract current agent position (x, y) and direction.\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  current_dir = np.argmax(obs['features_dict']['direction'])\n\n  # Get world configuration, specifically non-grabbable entities that act as obstacles.\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n\n  grid_width, grid_height, _ = grid.shape\n\n  # 2. Determine traversable cells on the grid.\n  # An improved approach to create the traversable mask.\n  # This single line correctly handles both cases: `non_grabbable_indices` being empty or not.\n  # If `non_grabbable_indices` is empty, `grid[:, :, []]` will result in a (W, H, 0) shaped array.\n  # `np.any` on such an array along axis 2 will return an array of `False` (no obstacles).\n  # `~False` then correctly produces a mask of all `True` (all cells traversable).\n  traversable_mask = ~np.any(grid[:, :, list(non_grabbable_indices)] > 0, axis=2)\n  \n  # If the agent's starting position is not traversable, it cannot move.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return []\n\n  # 3. Identify all locations on the grid where the target primitive exists.\n  primitive_locations_on_grid = []\n  # `np.where` returns (row_indices, col_indices) for elements matching the condition.\n  # Since grid is `(WIDTH, HEIGHT, K)`, row_indices are y-coordinates and col_indices are x-coordinates.\n  y_coords_of_primitive, x_coords_of_primitive = np.where(grid[:, :, primitive] > 0)\n  for x, y in zip(x_coords_of_primitive, y_coords_of_primitive):\n      primitive_locations_on_grid.append((x, y))\n\n  if not primitive_locations_on_grid:\n      return [] # The primitive is not present anywhere on the map.\n\n  # 4. Identify \"collectable target states\" for the agent.\n  # A target state is (agent_x, agent_y, agent_direction) from which the ACTION_USE\n  # can successfully collect the primitive. This requires the agent to be adjacent\n  # to the primitive and facing it.\n  collectable_target_states = set()\n  \n  # Define relative positions for the four cardinal neighbors of a primitive.\n  adjacent_deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Corresponding to Left, Right, Up, Down agent positions relative to the primitive\n  \n  for p_x, p_y in primitive_locations_on_grid:\n      for dx_adj, dy_adj in adjacent_deltas:\n          # Calculate the agent's potential position (a_x, a_y) if it were next to the primitive.\n          a_x, a_y = p_x + dx_adj, p_y + dy_adj\n\n          # Check if this potential agent position is within grid boundaries and is traversable.\n          if not (0 <= a_x < grid_width and 0 <= a_y < grid_height and traversable_mask[a_x, a_y]):\n              continue\n          \n          # Determine the vector from the agent's position to the primitive's position.\n          # The agent must be facing this direction.\n          vector_to_primitive = (p_x - a_x, p_y - a_y)\n\n          # Use the pre-computed VECTOR_TO_DIR for a direct and efficient lookup.\n          # `get()` is used for robustness, returning `None` if the vector is not a cardinal direction.\n          required_agent_dir = VECTOR_TO_DIR.get(vector_to_primitive)\n          \n          # Only add to target states if a valid cardinal direction is found.\n          if required_agent_dir is not None:\n              collectable_target_states.add((a_x, a_y, required_agent_dir))\n\n  if not collectable_target_states:\n      return [] # No valid states exist from which the primitive can be collected.\n\n  # 5. Perform a Breadth-First Search (BFS) on the state space.\n  # A state is defined by (agent_x, agent_y, agent_direction).\n  start_state = (current_pos_x, current_pos_y, current_dir)\n  \n  # The queue stores tuples: ((current_x, current_y, current_dir), [list_of_actions_taken_to_reach_this_state]).\n  q = deque([(start_state, [])]) \n  \n  # The `visited_states` set keeps track of states already explored to prevent cycles and redundant paths.\n  visited_states = {start_state}\n\n  while q:\n      (curr_x, curr_y, curr_dir), path_actions = q.popleft()\n\n      # Check if the current state is one of our desired collectable target states.\n      if (curr_x, curr_y, curr_dir) in collectable_target_states:\n          # If it is, we've found the shortest path. Append the USE action and return.\n          return path_actions + [ACTION_USE]\n\n      # Explore all possible next states by applying movement actions.\n      for action_taken in MOVEMENT_ACTIONS:\n          # Determine the agent's new direction and position after taking this action.\n          next_dir = ACTION_TO_RESULTING_DIR[action_taken]\n          dx_move, dy_move = DIR_DELTAS[next_dir]\n          \n          next_x, next_y = curr_x + dx_move, curr_y + dy_move\n\n          next_state = (next_x, next_y, next_dir)\n\n          # Check if the next cell is within grid boundaries, is traversable,\n          # and this specific (position, direction) state has not been visited yet.\n          if (0 <= next_x < grid_width and 0 <= next_y < grid_height and\n              traversable_mask[next_x, next_y] and\n              next_state not in visited_states):\n              \n              # Mark the new state as visited and add it to the queue for further exploration.\n              visited_states.add(next_state)\n              q.append((next_state, path_actions + [action_taken]))\n  \n  # If the BFS queue becomes empty and no path to a target state was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:43:41.288517", "function_name": "collect", "function_body": "    # --- Constants ---\n    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n    DIR_UP, DIR_RIGHT, DIR_DOWN, DIR_LEFT = 0, 1, 2, 3\n\n    # Map agent's facing direction to (dx, dy) delta for moving \"forward\".\n    # (dx, dy) represents change in (x, y) coordinates.\n    DIR_DELTAS = {\n        DIR_UP: (0, -1),   # Moving up: x constant, y decreases\n        DIR_RIGHT: (1, 0),  # Moving right: x increases, y constant\n        DIR_DOWN: (0, 1),   # Moving down: x constant, y increases\n        DIR_LEFT: (-1, 0),  # Moving left: x decreases, y constant\n    }\n\n    # Inverse mapping: from (dx, dy) vector to the corresponding DIR_ constant.\n    # Used to determine the required agent direction to face a primitive.\n    VECTOR_TO_DIR = {v: k for k, v in DIR_DELTAS.items()}\n\n    # Map a movement action to the agent's resulting facing direction.\n    # In CraftWorld, movement actions also orient the agent.\n    ACTION_TO_RESULTING_DIR = {\n        ACTION_UP: DIR_UP,\n        ACTION_RIGHT: DIR_RIGHT,\n        ACTION_DOWN: DIR_DOWN,\n        ACTION_LEFT: DIR_LEFT,\n    }\n\n    MOVEMENT_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n    # --- 1. Get current state information from the environment. ---\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    \n    # Extract current agent position (x, y) and direction.\n    current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n    current_dir = np.argmax(obs['features_dict']['direction'])\n\n    # Get world configuration, specifically non-grabbable entities that act as obstacles.\n    world = env.world\n    non_grabbable_indices = world.non_grabbable_indices\n\n    grid_width, grid_height, _ = grid.shape\n\n    # --- 2. Determine traversable cells on the grid. ---\n    # A cell is NOT traversable if it contains any non-grabbable item.\n    traversable_mask = np.ones((grid_width, grid_height), dtype=bool)\n    if non_grabbable_indices:\n        # Create a boolean mask where True indicates an obstacle of any non-grabbable kind.\n        cells_with_obstacles = np.any(grid[:, :, list(non_grabbable_indices)] > 0, axis=2)\n        traversable_mask[cells_with_obstacles] = False\n    \n    # The agent's starting position must be traversable to begin the search.\n    if not traversable_mask[current_pos_x, current_pos_y]:\n        return [] # Cannot move from an untraversable starting point.\n\n    # --- 3. Identify all locations on the grid where the target primitive exists. ---\n    primitive_locations = []\n    # `np.where` returns (row_indices, col_indices) for elements matching the condition.\n    # Since grid is `(WIDTH, HEIGHT, K)`, row_indices are y-coordinates and col_indices are x-coordinates.\n    y_coords, x_coords = np.where(grid[:, :, primitive] > 0)\n    for x, y in zip(x_coords, y_coords):\n        primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return [] # The primitive is not present anywhere on the map.\n\n    # --- 4. Identify \"collectable target states\" for the agent. ---\n    # A target state is (agent_x, agent_y, agent_direction) from which the ACTION_USE\n    # can successfully collect the primitive. This requires the agent to be adjacent\n    # to the primitive and facing it.\n    collectable_target_states = set()\n    for p_x, p_y in primitive_locations:\n        # Iterate over the four cells adjacent to the primitive.\n        # `dx_agent, dy_agent` define the relative position of the agent\n        # if the agent were to be at one of the four cardinal neighbors of the primitive.\n        for dx_agent, dy_agent in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Deltas from primitive to agent\n            # Calculate the agent's potential position (a_x, a_y).\n            a_x, a_y = p_x + dx_agent, p_y + dy_agent\n\n            # Check if this potential agent position is within grid boundaries and is traversable.\n            if not (0 <= a_x < grid_width and 0 <= a_y < grid_height and traversable_mask[a_x, a_y]):\n                continue\n            \n            # Determine the required direction the agent must face from (a_x, a_y) to collect (p_x, p_y).\n            # This is the vector from the agent's position to the primitive's position.\n            vec_to_prim_x, vec_to_prim_y = p_x - a_x, p_y - a_y\n\n            # Use the pre-computed VECTOR_TO_DIR for a direct and efficient lookup.\n            required_dir = VECTOR_TO_DIR.get((vec_to_prim_x, vec_to_prim_y))\n            \n            if required_dir is not None: # Ensure it's a valid cardinal direction\n                collectable_target_states.add((a_x, a_y, required_dir))\n\n    if not collectable_target_states:\n        return [] # No valid states exist from which the primitive can be collected.\n\n    # --- 5. Perform a Breadth-First Search (BFS) on the state space. ---\n    # A state is defined by (agent_x, agent_y, agent_direction).\n    start_state = (current_pos_x, current_pos_y, current_dir)\n    \n    # The queue stores tuples: ((current_x, current_y, current_dir), [list_of_actions_taken_to_reach_this_state]).\n    q = deque([(start_state, [])]) \n    \n    # The `visited_states` set keeps track of states already explored to prevent cycles and redundant paths.\n    visited_states = {start_state}\n\n    while q:\n        (curr_x, curr_y, curr_dir), path_actions = q.popleft()\n\n        # Check if the current state is one of our desired collectable target states.\n        if (curr_x, curr_y, curr_dir) in collectable_target_states:\n            # If it is, we've found the shortest path. Append the USE action and return.\n            return path_actions + [ACTION_USE]\n\n        # Explore all possible next states by applying movement actions.\n        for action in MOVEMENT_ACTIONS:\n            # Determine the agent's new direction and position after taking this action.\n            next_dir = ACTION_TO_RESULTING_DIR[action]\n            dx_move, dy_move = DIR_DELTAS[next_dir]\n            \n            next_x, next_y = curr_x + dx_move, curr_y + dy_move\n\n            next_state = (next_x, next_y, next_dir)\n\n            # Check if the next cell is within grid boundaries, is traversable,\n            # and this specific (position, direction) state has not been visited yet.\n            if (0 <= next_x < grid_width and 0 <= next_y < grid_height and\n                traversable_mask[next_x, next_y] and\n                next_state not in visited_states):\n                \n                # Mark the new state as visited and add it to the queue for further exploration.\n                visited_states.add(next_state)\n                q.append((next_state, path_actions + [action]))\n  \n    # If the BFS queue becomes empty and no path to a target state was found, return an empty list.\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:44:37.141332", "function_name": "collect", "function_body": "  # 1. Get current state\n  state = env._current_state\n\n  # 2. Check inventory: If the primitive is already collected, return an empty action list.\n  if state.inventory[primitive] > 0:\n    return []\n\n  # 3. Check if adjacent: If the primitive is next to the agent, the next action is USE.\n  if state.next_to(primitive):\n    return [env_factory.action_mapping.USE]\n\n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path to the primitive.\n  # The goal is to reach a state where the primitive is adjacent or collected.\n  q = collections.deque()\n  visited = set()  # Stores (position_tuple, direction_int) to avoid revisiting states\n\n  # Initial state and path\n  q.append((state, []))\n  visited.add((state.pos, state.dir))\n\n  # Define all possible movement actions\n  movement_actions = [\n      env_factory.action_mapping.DOWN,\n      env_factory.action_mapping.UP,\n      env_factory.action_mapping.LEFT,\n      env_factory.action_mapping.RIGHT,\n  ]\n\n  while q:\n    current_state, current_path = q.popleft()\n\n    # Check if the primitive is collected in the current state (might have happened via a path)\n    if current_state.inventory[primitive] > 0:\n      return current_path\n\n    # Check if the primitive is adjacent in the current state\n    if current_state.next_to(primitive):\n      # If adjacent, the next action should be USE\n      return current_path + [env_factory.action_mapping.USE]\n\n    # Explore all possible movement actions from the current state\n    for action in movement_actions:\n      # Simulate the step to get the new state.\n      # We don't care about the reward here, only the state transition.\n      _, next_state = current_state.step(action)\n\n      # Check if this new state (position and direction) has been visited\n      if (next_state.pos, next_state.dir) not in visited:\n        visited.add((next_state.pos, next_state.dir))\n        q.append((next_state, current_path + [action]))\n\n  # If the BFS completes and no path to the primitive (or an adjacent cell) is found,\n  # it means the primitive is unreachable or doesn't exist.\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:44:37.211417", "function_name": "collect", "function_body": "    actions = []\n    obs = env.observations()\n    current_grid = obs['features_dict']['features_global']\n    \n    # Grid dimensions based on the description: (WIDTH, HEIGHT, n_kinds)\n    WIDTH_DIM = current_grid.shape[0]\n    HEIGHT_DIM = current_grid.shape[1]\n    \n    # Get agent's current position (pos_norm is (x_norm, y_norm))\n    pos_norm = obs['features_dict']['pos']\n    agent_x = int(round(pos_norm[0] * (WIDTH_DIM - 1)))\n    agent_y = int(round(pos_norm[1] * (HEIGHT_DIM - 1)))\n    current_agent_pos = (agent_x, agent_y) # Store as (x, y) coordinates\n\n    # Agent's current inventory\n    current_inventory = obs['features_dict']['inventory']\n    if current_inventory[primitive] > 0:\n        # Already have the primitive, no actions needed\n        return []\n\n    # Map actions to their corresponding (dx, dy) movements\n    # Based on CraftLab.action_specs(): DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    action_deltas = {\n        0: (0, 1),  # DOWN: y increases\n        1: (0, -1), # UP: y decreases\n        2: (-1, 0), # LEFT: x decreases\n        3: (1, 0)   # RIGHT: x increases\n    }\n    \n    # Find all locations of the primitive on the grid\n    primitive_locations = []\n    # Iterate using x, y coordinates as per grid shape (WIDTH, HEIGHT, n_kinds)\n    for x in range(WIDTH_DIM):\n        for y in range(HEIGHT_DIM):\n            if current_grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        # Primitive not found on the map\n        return []\n\n    # Use collections.deque for BFS queue (assuming 'collections' is available)\n    import collections \n\n    # BFS to find the shortest path to a cell from which the primitive is \"next to\"\n    # BFS state: ((current_x, current_y), list_of_actions_to_reach_here)\n    q = collections.deque([(current_agent_pos, [])]) \n    visited = {current_agent_pos} # Set of (x, y) tuples to avoid revisiting states\n\n    while q:\n        (cx, cy), path = q.popleft()\n\n        # Check if current position (cx, cy) is \"next to\" any primitive location\n        # A cell (px, py) is \"next to\" (cx, cy) if abs(cx - px) <= 1 and abs(cy - py) <= 1\n        is_next_to_primitive = False\n        for px, py in primitive_locations:\n            if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n                is_next_to_primitive = True\n                break\n        \n        if is_next_to_primitive:\n            # Found a path to a suitable position, add USE action and return\n            return path + [4] # 4 is the USE action (from CraftLab.action_specs)\n\n        # Explore neighboring cells\n        for action_id, (dx, dy) in action_deltas.items():\n            nx, ny = cx + dx, cy + dy\n\n            # Check if new position is within grid bounds\n            if not (0 <= nx < WIDTH_DIM and 0 <= ny < HEIGHT_DIM):\n                continue\n\n            # If not visited, add to queue\n            if (nx, ny) not in visited:\n                visited.add((nx, ny))\n                new_path = path + [action_id]\n                q.append(((nx, ny), new_path))\n    \n    # If BFS completes and no path was found to any \"next to\" location\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:46:00.905420", "function_name": "collect", "function_body": "    actions = []\n    \n    # Action constants (from CraftLab.action_specs, assuming standard values)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Max steps to prevent infinite loops during collection attempt\n    MAX_COLLECT_STEPS = 200 # A reasonable arbitrary limit\n\n    # Reset the environment to get an initial state and ensure a clean start.\n    # The returned observation dict is discarded as we directly access env._current_state.\n    _ = env.reset() \n    current_state = env._current_state \n    \n    # Early exit: Check if the primitive is already in the inventory.\n    if current_state.satisfies(None, primitive):\n        return actions # Already collected, no actions needed\n\n    for _ in range(MAX_COLLECT_STEPS):\n        # Always update the current_state reference, as it changes after each env.step().\n        current_state = env._current_state \n\n        # 1. Check if the primitive is in the agent's 3x3 neighborhood.\n        if current_state.next_to(primitive):\n            actions.append(ACTION_USE)\n            env.step(ACTION_USE) # Execute the USE action\n            \n            # Check if collected after attempting USE\n            current_state = env._current_state # Update state after action\n            if current_state.satisfies(None, primitive):\n                return actions # Successfully collected\n\n            # If USE didn't result in collection, the primitive might be ungrabbable\n            # or requires a tool not present. We continue the loop to re-evaluate,\n            # which might lead to searching for another instance or eventually timing out.\n            continue # Re-evaluate grid and possibly find another instance or give up\n\n        # 2. Find the nearest primitive on the grid to move towards.\n        # np.argwhere returns a 2D array of (row, col) coordinates where the value is 1.\n        primitive_locations = np.argwhere(current_state.grid[:, :, primitive] == 1)\n        \n        if len(primitive_locations) == 0:\n            # No primitive of the desired type found on the grid.\n            # This implies the goal is unreachable or all instances are collected/gone.\n            return actions # Primitive not found, cannot proceed\n\n        agent_pos_y, agent_pos_x = current_state.pos # CraftState.pos is (row, col) = (y, x)\n\n        min_dist = float('inf')\n        closest_primitive_pos = None\n\n        # Iterate through all found primitive locations to find the closest one using Manhattan distance.\n        for target_pos_y, target_pos_x in primitive_locations:\n            dist = abs(agent_pos_y - target_pos_y) + abs(agent_pos_x - target_pos_x)\n            if dist < min_dist:\n                min_dist = dist\n                closest_primitive_pos = (target_pos_y, target_pos_x)\n\n        if closest_primitive_pos is None:\n            # This case should ideally not be reached if primitive_locations is not empty,\n            # but included for robustness.\n            break # Unexpected state, exit loop\n\n        target_pos_y, target_pos_x = closest_primitive_pos\n\n        # Determine the best movement action to reduce Manhattan distance to the target.\n        action_to_take = -1\n        \n        dy = target_pos_y - agent_pos_y\n        dx = target_pos_x - agent_pos_x\n\n        # Prioritize movement along the axis with the larger absolute difference.\n        # This strategy aims to efficiently close the distance.\n        if abs(dy) >= abs(dx) and dy != 0:\n            action_to_take = ACTION_DOWN if dy > 0 else ACTION_UP\n        elif dx != 0: # If dy is 0 or abs(dy) < abs(dx), try dx\n            action_to_take = ACTION_RIGHT if dx > 0 else ACTION_LEFT\n        # If both dx and dy are 0, it means the agent is already at the target's exact coordinates.\n        # This situation should have been handled by the `next_to` check and `ACTION_USE` earlier in the loop.\n        # If `action_to_take` is still -1 here, it implies a logical inconsistency or uncollectible item.\n\n        if action_to_take != -1:\n            old_pos = current_state.pos # Store position before attempting the move\n            actions.append(action_to_take)\n            env.step(action_to_take) # Execute the movement action\n            current_state = env._current_state # Update state after action\n\n            # Check if collected during the movement (less common for primitives, but possible).\n            if current_state.satisfies(None, primitive):\n                return actions\n            \n            # Check if movement was blocked (e.g., hit a wall).\n            if current_state.pos == old_pos:\n                # If the agent's position did not change, the path is blocked.\n                # With this simple greedy strategy, we cannot find a detour.\n                # Therefore, we break, signaling failure to reach this primitive.\n                break # Path blocked, cannot reach this primitive.\n        else:\n            # No movement action could be determined (dx=0, dy=0), implying agent is on target spot.\n            # This branch should ideally not be reached if the `next_to` check is working correctly.\n            # If it is reached, it indicates an uncollectible primitive at the agent's location\n            # or a logical error, so we break to prevent an infinite loop.\n            break\n\n    # If the loop finishes (e.g., MAX_COLLECT_STEPS reached or a break condition met)\n    # without successfully collecting the primitive, return the actions taken so far.\n    return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:46:00.976209", "function_name": "collect", "function_body": "    actions_taken = []\n\n    # Map action names to their integer IDs for robustness\n    action_map = env.action_specs()\n    DOWN_ACTION = action_map['DOWN']\n    UP_ACTION = action_map['UP']\n    LEFT_ACTION = action_map['LEFT']\n    RIGHT_ACTION = action_map['RIGHT']\n    USE_ACTION = action_map['USE']\n\n    # Reset the environment to a known initial state.\n    # This assumes collect_v2 is expected to operate from a fresh scenario.\n    _ = env.reset(seed=0)\n\n    # A safety limit to prevent infinite loops. Using a multiple of the\n    # scenario's max_steps as a heuristic.\n    max_steps_limit = env.max_steps * 2\n    steps_count = 0\n\n    while True:\n        state = env._current_state # Direct access to the internal CraftState object\n        grid = state.grid\n        current_pos = state.pos # (row, col) tuple\n        inventory = state.inventory\n\n        # 1. Check if the primitive is already in the inventory\n        if inventory[primitive] > 0:\n            break # Goal achieved\n\n        # 2. Check for step limit to prevent infinite loops\n        if steps_count >= max_steps_limit:\n            # Primitive not collected within limits.\n            # (Could indicate unreachability or a logic flaw)\n            # print(f\"Warning: Primitive {env.world.cookbook.index.get(primitive)} not collected within {max_steps_limit} steps.\")\n            break\n\n        # 3. Check if primitive is in an adjacent cell (including the agent's current cell)\n        if state.next_to(primitive):\n            action_to_take = USE_ACTION\n            # Execute the action\n            _, _, _ = env.step(action_to_take)\n            actions_taken.append(action_to_take)\n            steps_count += 1\n            # Re-evaluate state (inventory) in the next iteration as collection might have occurred\n            continue\n\n        # 4. Locate all instances of the primitive on the global grid\n        # np.argwhere returns (row, col) coordinates for non-zero elements\n        primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n        if len(primitive_locations) == 0:\n            # Primitive not found anywhere on the map.\n            # (Could mean it's already collected or not present in this scenario)\n            # print(f\"Warning: Primitive {env.world.cookbook.index.get(primitive)} (ID: {primitive}) not found on grid. Giving up.\")\n            break\n\n        # 5. Find the closest primitive location using Manhattan distance\n        min_dist = float('inf')\n        closest_primitive_pos = None\n        for r, c in primitive_locations:\n            dist = abs(r - current_pos[0]) + abs(c - current_pos[1])\n            if dist < min_dist:\n                min_dist = dist\n                closest_primitive_pos = (r, c)\n        \n        target_r, target_c = closest_primitive_pos\n\n        # 6. Determine the next movement action towards the closest primitive\n        delta_r = target_r - current_pos[0]\n        delta_c = target_c - current_pos[1]\n\n        action_to_take = None\n        # Prioritize movement along the dimension with the larger difference\n        if abs(delta_r) > abs(delta_c):\n            if delta_r > 0:\n                action_to_take = DOWN_ACTION\n            else: # delta_r < 0\n                action_to_take = UP_ACTION\n        elif abs(delta_c) > 0: # Only move horizontally if vertical delta is smaller or zero\n            if delta_c > 0:\n                action_to_take = RIGHT_ACTION\n            else: # delta_c < 0\n                action_to_take = LEFT_ACTION\n        else:\n            # This case means delta_r and delta_c are both zero,\n            # implying the agent is already at target_pos.\n            # This should have been handled by state.next_to(primitive) earlier.\n            # If reached, it suggests an unexpected state, so we break to avoid an infinite loop.\n            # print(f\"Warning: Agent at {current_pos} is already at target {closest_primitive_pos}, but next_to() was false. Breaking.\")\n            break\n\n        # Execute the determined action\n        if action_to_take is not None:\n            _, _, _ = env.step(action_to_take)\n            actions_taken.append(action_to_take)\n            steps_count += 1\n        else:\n            # This indicates an issue in action determination logic\n            # print(\"Error: No valid movement action determined. Breaking.\")\n            break\n\n    return actions_taken", "island_id": 8, "scores": {"3": -1}}
