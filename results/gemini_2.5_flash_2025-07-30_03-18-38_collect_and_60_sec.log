{"timestamp": "2025-07-30T07:21:50.592475", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  current_state = env._current_state\n  grid = current_state.grid\n  start_x, start_y = current_state.pos\n  inventory = current_state.inventory\n  world = env.world\n\n  # Check if the primitive is already in the inventory. If so, no actions are needed.\n  if inventory[primitive] > 0:\n    return []\n\n  # Get grid dimensions (assuming grid shape is (WIDTH, HEIGHT, n_kinds))\n  grid_width, grid_height, _ = grid.shape\n\n  # Get indices of entities that are considered obstacles (non-grabbable)\n  non_grabbable_indices = world.non_grabbable_indices\n\n  # Define action constants based on CraftLab's action_specs\n  # (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)\n  # These are hardcoded as per the problem description's action_specs output.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Mappings for movements and their corresponding action IDs\n  # (dx, dy): action_id for moving from (x, y) to (x+dx, y+dy)\n  # Assuming x is horizontal (width) and y is vertical (height)\n  MOVE_MAPPING = {\n      (0, -1): UP,    # Move North (decrease y)\n      (0, 1): DOWN,   # Move South (increase y)\n      (-1, 0): LEFT,  # Move West (decrease x)\n      (1, 0): RIGHT   # Move East (increase x)\n  }\n\n  # Offsets for checking the 3x3 neighborhood around a cell (including the center itself)\n  NEIGHBORHOOD_OFFSETS = [\n      (-1, -1), (0, -1), (1, -1),  # Top row\n      (-1, 0),  (0, 0),  (1, 0),   # Middle row\n      (-1, 1),  (0, 1),  (1, 1)    # Bottom row\n  ]\n\n  def is_valid_pos(x, y):\n    \"\"\"Checks if a given (x, y) coordinate is within the grid boundaries.\"\"\"\n    return 0 <= x < grid_width and 0 <= y < grid_height\n\n  def is_walkable(x, y):\n    \"\"\"\n    Checks if a given cell (x, y) is traversable.\n    A cell is not walkable if it contains any non-grabbable entity (obstacle).\n    \"\"\"\n    if not is_valid_pos(x, y):\n      return False\n    # Iterate through all non-grabbable indices to check if any exist at (x, y)\n    for idx in non_grabbable_indices:\n      if grid[x, y, idx] > 0:\n        return False  # Obstacle found, not walkable\n    return True # No obstacles, walkable\n\n  def is_primitive_in_neighborhood(center_x, center_y, target_primitive_idx):\n    \"\"\"\n    Checks if the target primitive is present in the 3x3 neighborhood of the given\n    (center_x, center_y) position. This aligns with CraftState's `next_to` behavior\n    and allows the `USE` action to pick up nearby items.\n    \"\"\"\n    for dx, dy in NEIGHBORHOOD_OFFSETS:\n      nx, ny = center_x + dx, center_y + dy\n      if is_valid_pos(nx, ny) and grid[nx, ny, target_primitive_idx] > 0:\n        return True  # Primitive found in the neighborhood\n    return False\n\n  # BFS initialization\n  # Queue stores tuples: (current_x, current_y, list_of_actions_to_reach_here)\n  q = collections.deque([(start_x, start_y, [])])\n  # Visited set stores (x, y) tuples to prevent cycles and redundant exploration\n  visited = set([(start_x, start_y)])\n\n  while q:\n    curr_x, curr_y, path_actions = q.popleft()\n\n    # Check if the primitive is in the 3x3 neighborhood of the current position.\n    # If it is, we've found a path to a collectible location.\n    # The final action needed is 'USE'.\n    if is_primitive_in_neighborhood(curr_x, curr_y, primitive):\n      return path_actions + [USE]\n\n    # Explore all 4 cardinal neighbors (UP, DOWN, LEFT, RIGHT)\n    for (dx, dy), action_id in MOVE_MAPPING.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check if the next position is valid, walkable, and not yet visited\n      if is_walkable(next_x, next_y) and (next_x, next_y) not in visited:\n        visited.add((next_x, next_y))\n        q.append((next_x, next_y, path_actions + [action_id]))\n\n  # If the BFS queue becomes empty and the primitive has not been found or collected,\n  # it means the primitive is unreachable or does not exist.\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T07:23:07.712511", "function_name": "collect", "function_body": "    import collections\n\n    current_state = env._current_state\n    \n    # 1. Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get action mappings from the environment\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    # Define movement deltas for (x, y) coordinates\n    # Assuming pos is (x, y) and grid is indexed as grid[x, y, kind_idx]\n    grid_width, grid_height, _ = current_state.grid.shape\n    \n    MOVE_DELTAS = {\n        ACTION_DOWN: (0, 1),    # (dx, dy) for moving down (y increases)\n        ACTION_UP: (0, -1),     # (dx, dy) for moving up (y decreases)\n        ACTION_LEFT: (-1, 0),   # (dx, dy) for moving left (x decreases)\n        ACTION_RIGHT: (1, 0)    # (dx, dy) for moving right (x increases)\n    }\n\n    start_pos = current_state.pos # (x, y)\n    \n    # BFS queue: stores (current_position, list_of_actions_to_reach_here)\n    q = collections.deque([(start_pos, [])]) \n    visited = {start_pos} # Set of visited positions\n\n    while q:\n        (curr_x, curr_y), path = q.popleft()\n\n        # Check if the primitive is in the 3x3 neighborhood of the current position\n        # From which it can be 'USE'd.\n        for dx in [-1, 0, 1]:\n            for dy in [-1, 0, 1]:\n                target_nx, target_ny = curr_x + dx, curr_y + dy\n\n                # Check bounds for the potential target cell\n                if not (0 <= target_nx < grid_width and 0 <= target_ny < grid_height):\n                    continue\n\n                # If the primitive is present at this neighbor cell\n                if current_state.grid[target_nx, target_ny, primitive] > 0:\n                    # Found the primitive in the neighborhood, can 'USE' it from curr_x, curr_y\n                    return path + [ACTION_USE]\n\n        # Explore possible moves to neighboring cells\n        for action_move, (dx, dy) in MOVE_DELTAS.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_pos = (next_x, next_y)\n\n            # Check bounds for the next position\n            if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n                continue\n            \n            # Check if this position has been visited to avoid cycles and redundant paths\n            if next_pos in visited:\n                continue\n            \n            # Assuming all cells are traversable unless specified otherwise.\n            # (No explicit obstacle logic is provided in the problem description)\n            \n            visited.add(next_pos)\n            q.append((next_pos, path + [action_move]))\n\n    # If the BFS completes without finding the primitive, it means it's unreachable\n    # or not present on the map.\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T07:23:07.784321", "function_name": "collect", "function_body": "    # Constants for actions based on CraftLab.action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Directions (dx, dy) mapping from agent's `dir` to coordinate changes\n    # Assuming dir=0: North (decrease y), dir=1: East (increase x),\n    # dir=2: South (increase y), dir=3: West (decrease x)\n    DIRECTIONS_VECTORS = {\n        0: (0, -1), # North\n        1: (1, 0),  # East\n        2: (0, 1),  # South\n        3: (-1, 0)  # West\n    }\n\n    # Mapping from relative (dx, dy) to the direction index an agent needs to face\n    # E.g., if target is at (dx=0, dy=-1) relative to agent, agent needs to face North (dir 0)\n    FACING_DIRECTION_MAP = {\n        (0, -1): 0,  # Target is North relative to agent -> Face North (dir 0)\n        (1, 0): 1,   # Target is East relative to agent -> Face East (dir 1)\n        (0, 1): 2,   # Target is South relative to agent -> Face South (dir 2)\n        (-1, 0): 3   # Target is West relative to agent -> Face West (dir 3)\n    }\n\n    actions_log = []\n    # A safety limit to prevent infinite loops in exploration, assuming a finite world.\n    max_exploration_steps = 500\n\n    current_state = env._current_state\n    if current_state.inventory[primitive] > 0:\n        return [] # Primitive is already in inventory\n\n    steps_taken = 0\n    # Keep track of visited positions to encourage exploration and avoid getting stuck\n    visited_positions = set()\n    # Add initial position to visited set\n    visited_positions.add(current_state.pos)\n\n    while current_state.inventory[primitive] == 0 and steps_taken < max_exploration_steps:\n        # Always use the most current state for decision making\n        current_state = env._current_state\n        px, py = current_state.pos\n        grid = current_state.grid\n        width, height, _ = grid.shape # n_kinds is not needed for dimensions\n\n        # 1. Check immediate 3x3 surroundings for the primitive\n        primitive_found_adjacent = False\n        target_relative_pos = None\n\n        # Iterate over 3x3 neighborhood (relative coordinates dx_adj, dy_adj)\n        for dx_adj in [-1, 0, 1]:\n            for dy_adj in [-1, 0, 1]:\n                if dx_adj == 0 and dy_adj == 0:\n                    continue # Skip the agent's current position\n\n                nx_adj, ny_adj = px + dx_adj, py + dy_adj\n\n                # Check if the adjacent cell is within grid boundaries\n                if 0 <= nx_adj < width and 0 <= ny_adj < height:\n                    # Check if the primitive is present at this adjacent cell\n                    if grid[nx_adj, ny_adj, primitive] > 0:\n                        primitive_found_adjacent = True\n                        target_relative_pos = (dx_adj, dy_adj)\n                        break # Found, exit inner loop\n            if primitive_found_adjacent:\n                break # Found, exit outer loop\n\n        if primitive_found_adjacent and target_relative_pos:\n            # Primitive found in an adjacent cell. Now, orient the agent to face it and use.\n            target_dir = FACING_DIRECTION_MAP.get(target_relative_pos)\n\n            if target_dir is not None:\n                current_dir = current_state.dir\n                # Calculate turns needed (shortest path, clockwise or counter-clockwise)\n                # (target_dir - current_dir + 4) % 4 ensures result is 0, 1, 2, or 3\n                turns_needed = (target_dir - current_dir + 4) % 4 \n\n                # Perform necessary turns\n                if turns_needed == 1: # 90 degrees right\n                    actions_log.append(ACTION_RIGHT)\n                    env.step(ACTION_RIGHT)\n                elif turns_needed == 2: # 180 degrees (two rights or two lefts, two rights is simpler)\n                    actions_log.extend([ACTION_RIGHT, ACTION_RIGHT])\n                    env.step(ACTION_RIGHT)\n                    env.step(ACTION_RIGHT)\n                elif turns_needed == 3: # 90 degrees left\n                    actions_log.append(ACTION_LEFT)\n                    env.step(ACTION_LEFT)\n                # If turns_needed == 0, agent is already facing the target\n\n                # After orienting, attempt to use/collect the primitive\n                actions_log.append(ACTION_USE)\n                env.step(ACTION_USE)\n                \n                # Update state to reflect the use action and check if goal is met\n                current_state = env._current_state \n                if current_state.inventory[primitive] > 0:\n                    return actions_log # Primitive successfully collected, return the action sequence\n\n        # If primitive was not found adjacent, or if collecting it didn't satisfy the goal (e.g.,\n        # for a non-primitive item, or if the item wasn't actually there), proceed with exploration.\n        \n        # Simple exploration strategy: Try to move forward. If blocked or moving to an\n        # already visited spot, turn right and try moving forward again in the next iteration.\n        \n        original_pos = current_state.pos\n        \n        # Attempt to move forward (ACTION_UP)\n        actions_log.append(ACTION_UP)\n        env.step(ACTION_UP)\n        current_state = env._current_state # Update state after attempted move\n\n        # Check if the agent moved to a new and unvisited cell\n        if current_state.pos != original_pos and current_state.pos not in visited_positions:\n            visited_positions.add(current_state.pos)\n        else:\n            # Agent either stayed in place (blocked) or moved to an already visited cell.\n            # In either case, turning right helps in systematic exploration or escaping traps.\n            actions_log.append(ACTION_RIGHT)\n            env.step(ACTION_RIGHT)\n            current_state = env._current_state # Update state after turn\n\n        steps_taken += 1\n\n    # If the loop finishes (e.g., max_exploration_steps reached) and the primitive\n    # is still not collected, return the sequence of actions taken so far.\n    return actions_log", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T07:24:51.515777", "function_name": "collect", "function_body": "  import collections # Required for deque\n\n  # Constants for actions, as defined in env.action_specs()\n  # Defined within the function to be self-contained as per instructions.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Delta changes for (row, col) for movement actions\n  MOVE_DELTAS = {\n      UP: (-1, 0),    # UP: move one row up\n      DOWN: (1, 0),   # DOWN: move one row down\n      LEFT: (0, -1),  # LEFT: move one col left\n      RIGHT: (0, 1),  # RIGHT: move one col right\n  }\n\n  actions_list = []\n  primitive_id = primitive # `primitive` is already the integer ID for the item to collect\n\n  # A safety limit to prevent infinite loops in cases where the primitive is unreachable\n  MAX_COLLECT_ITERATIONS = 500 \n\n  for _ in range(MAX_COLLECT_ITERATIONS):\n      current_state = env._current_state\n      \n      # 1. Check if the primitive is already in the inventory\n      if current_state.inventory[primitive_id] > 0:\n          return actions_list\n\n      # 2. Check if the agent is next to (or on the same cell as) the primitive\n      # If so, perform the 'USE' action to collect it.\n      if current_state.next_to(primitive_id):\n          actions_list.append(USE)\n          reward, done, _ = env.step(USE)\n          # After attempting to use, if the environment signals done,\n          # it might imply success (primitive collected) or failure.\n          if done:\n              # Re-check inventory as a final confirmation of collection success\n              if env._current_state.inventory[primitive_id] > 0:\n                  return actions_list\n              else: # Done, but primitive not collected: indicates failure\n                  return [] \n          # Continue the loop to re-evaluate the state (inventory check in next iteration)\n          continue \n\n      # 3. If not collected and not next to, find a path to the primitive using BFS\n      start_pos = current_state.pos\n      grid_height, grid_width = current_state.grid.shape[0], current_state.grid.shape[1]\n\n      q = collections.deque([(start_pos, [])]) # Queue stores (position_tuple, path_actions_list)\n      visited = {start_pos} # Set of visited positions to avoid cycles and redundant checks\n\n      path_to_primitive_cell = None\n\n      while q:\n          (r, c), path = q.popleft()\n\n          # Check if the current cell (r, c) contains the primitive\n          if current_state.grid[r, c, primitive_id] == 1:\n              path_to_primitive_cell = path # This is the shortest path to the primitive's location\n              break # Found the target, stop BFS\n\n          # Explore valid neighboring cells for movement\n          for action_id in [UP, DOWN, LEFT, RIGHT]:\n              dr, dc = MOVE_DELTAS[action_id]\n              nr, nc = r + dr, c + dc\n\n              # Check bounds and if the cell has not been visited yet\n              if 0 <= nr < grid_height and 0 <= nc < grid_width and (nr, nc) not in visited:\n                  # Assuming all grid cells are traversable unless the environment's step function\n                  # implicitly handles collisions (which it does in CraftState.step).\n                  visited.add((nr, nc))\n                  q.append(((nr, nc), path + [action_id]))\n      \n      # If a path to the primitive was found by BFS\n      if path_to_primitive_cell:\n          first_action = path_to_primitive_cell[0] # Take the first action from the shortest path\n          actions_list.append(first_action)\n          \n          # Execute the action in the actual environment\n          reward, done, _ = env.step(first_action)\n          \n          # If the environment signals done after a movement action, it means the task\n          # ended prematurely (e.g., max_steps in the Lab wrapper reached)\n          if done: \n              return [] # Indicate collection failure in this scenario\n          \n          # Continue the loop to re-evaluate the new state and find next steps\n      else:\n          # No path found to any cell containing the primitive.\n          # This implies the primitive is not present on the current grid or is unreachable.\n          return [] # Cannot collect, indicate failure\n\n  # If MAX_COLLECT_ITERATIONS is reached and the primitive has not been collected\n  # This typically means an issue (e.g., primitive unreachable, infinite loop, or too long path)\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T07:24:51.585691", "function_name": "collect", "function_body": "    actions_plan = []\n\n    # Cache action constants from the environment's action_specs\n    # This prevents re-deriving them on every call if the function is used repeatedly.\n    # These global variables are defined outside this function in the snippet provided by the user.\n    global _ACTIONS, _ACTION_MAPPING\n    if _ACTIONS is None:\n        _ACTION_MAPPING = env.action_specs()\n        _ACTIONS = {\n            \"DOWN\": _ACTION_MAPPING[\"DOWN\"],\n            \"UP\": _ACTION_MAPPING[\"UP\"],\n            \"LEFT\": _ACTION_MAPPING[\"LEFT\"],\n            \"RIGHT\": _ACTION_MAPPING[\"RIGHT\"],\n            \"USE\": _ACTION_MAPPING[\"USE\"],\n        }\n    ACTIONS = _ACTIONS\n\n    # Get the current observations from the environment\n    obs = env.observations()\n    initial_grid = obs['features_dict']['features_global']\n    grid_width, grid_height, _ = initial_grid.shape\n\n    # Convert normalized position (from features_dict) back to integer grid coordinates\n    initial_pos_normalized = obs['features_dict']['pos']\n    initial_pos = (\n        int(round(initial_pos_normalized[0] * (grid_width - 1))),\n        int(round(initial_pos_normalized[1] * (grid_height - 1)))\n    )\n\n    # Check if the primitive is already in the agent's inventory\n    if obs['features_dict']['inventory'][primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # Check if the agent is currently standing on a cell containing the primitive\n    if initial_grid[initial_pos[0], initial_pos[1], primitive] == 1:\n        # Agent is on the primitive, apply USE action to collect it\n        return [ACTIONS[\"USE\"]]\n\n    # Get indices of entities that block movement (non-grabbable items like walls, water)\n    blocking_indices = env.world.non_grabbable_indices # This is a set of integer IDs\n\n    # Define possible movement directions and their corresponding actions\n    # This list maps (dx, dy) deltas to the action constant that causes that movement.\n    move_deltas_actions = [\n        (0, -1, ACTIONS[\"DOWN\"]),\n        (0, 1, ACTIONS[\"UP\"]),\n        (-1, 0, ACTIONS[\"LEFT\"]),\n        (1, 0, ACTIONS[\"RIGHT\"]),\n    ]\n\n    # Use a Breadth-First Search (BFS) to find the shortest path to any cell\n    # that contains the desired primitive.\n    # The queue stores tuples of (current_coordinate, list_of_actions_taken_to_reach_here)\n    # Note: 'collections.deque' is assumed to be imported in the context where this function runs.\n    queue = collections.deque([(initial_pos, [])])\n    visited = {initial_pos} # Set to keep track of visited grid coordinates to prevent cycles\n\n    target_path_to_primitive_cell = None # Will store the action sequence to reach the primitive\n\n    while queue:\n        (curr_x, curr_y), path = queue.popleft()\n\n        # Explore all four possible movement directions\n        for dx, dy, action_val in move_deltas_actions:\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_coord = (next_x, next_y)\n\n            # 1. Check if the next coordinate is within the grid boundaries\n            if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n                continue\n\n            # 2. Check if the next coordinate has already been visited\n            if next_coord in visited:\n                continue\n\n            # 3. Check if the next coordinate is blocked by any non-grabbable entity\n            is_blocked = False\n            for kind_idx in blocking_indices:\n                if initial_grid[next_x, next_y, kind_idx] == 1: # Check if the cell contains a blocking item\n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue\n\n            # If the cell is valid and traversable, mark it as visited\n            visited.add(next_coord)\n            new_path = path + [action_val] # Extend the path with the current action\n\n            # 4. Check if this new coordinate contains the desired primitive\n            if initial_grid[next_x, next_y, primitive] == 1:\n                target_path_to_primitive_cell = new_path\n                # Found the shortest path to a primitive cell. Stop BFS.\n                queue.clear() # Clear the queue to terminate the outer while loop\n                break\n            else:\n                # If it's not the primitive, add it to the queue for further exploration\n                queue.append((next_coord, new_path))\n        \n        if target_path_to_primitive_cell: # If a path was found in the inner loop, break the outer loop too\n            break\n\n    # If a path to a primitive cell was found\n    if target_path_to_primitive_cell:\n        # The agent will move to the primitive's cell, then apply the USE action to collect it.\n        # The CraftState.step(USE) action functions on a 3x3 neighborhood, including the agent's current cell.\n        actions_plan = target_path_to_primitive_cell + [ACTIONS[\"USE\"]]\n\n    return actions_plan", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T07:26:30.341629", "function_name": "collect", "function_body": "    \"\"\"Improved version of `collect_v0`.\"\"\"\n    # Get current state information from the CraftLab environment\n    current_state = env._current_state\n    current_pos = current_state.pos\n    current_dir = current_state.dir\n    grid = current_state.grid\n    inventory = current_state.inventory\n    world = env.world # CraftWorld instance\n\n    # 1. Check if the primitive is already in the inventory\n    if inventory[primitive] > 0:\n        return []\n\n    # 2. Get action details from the environment's action specs\n    action_specs = env.action_specs()\n    # Mapping from action index to ((dr, dc), new_dir) for movement actions\n    action_move_deltas_and_dirs = {\n        action_specs['DOWN']: ((0, 1), 0),   # (dr, dc) for (row, col) change, new_dir (SOUTH)\n        action_specs['UP']: ((0, -1), 1),    # (dr, dc) for (row, col) change, new_dir (NORTH)\n        action_specs['LEFT']: ((-1, 0), 2),  # (dr, dc) for (row, col) change, new_dir (WEST)\n        action_specs['RIGHT']: ((1, 0), 3),  # (dr, dc) for (row, col) change, new_dir (EAST)\n    }\n    # Mapping from direction index to (dr, dc) for \"USE\" action\n    dir_to_delta = {\n        0: (0, 1),   # SOUTH\n        1: (0, -1),  # NORTH\n        2: (-1, 0),  # WEST\n        3: (1, 0),   # EAST\n    }\n    use_action_idx = action_specs['USE']\n\n    action_details = (action_move_deltas_and_dirs, dir_to_delta, use_action_idx)\n\n    # 3. Use BFS to find a path to the primitive\n    # The BFS searches for a state (r, c, dir) where the primitive is directly in front.\n    path_to_item = _find_path_to_item_for_use(\n        start_pos=current_pos,\n        start_dir=current_dir,\n        target_item_idx=primitive,\n        grid=grid,\n        world=world,\n        action_details=action_details\n    )\n\n    return path_to_item", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T07:26:30.412917", "function_name": "collect", "function_body": "    # Initialize an empty list to store the sequence of actions.\n    actions = []\n\n    # Create a deep copy of the current state from the environment\n    # to simulate actions without modifying the actual environment state.\n    # We access the private attribute _current_state of CraftLab for this purpose,\n    # as it represents the current simulation state.\n    # CraftState's constructor takes scenario, grid, pos, dir, inventory.\n    # We need to explicitly copy mutable components like grid and inventory.\n    initial_state = env._current_state\n    current_state_sim = CraftState(\n        scenario=initial_state.scenario,\n        grid=initial_state.grid.copy(),\n        pos=initial_state.pos,\n        dir=initial_state.dir,\n        inventory=initial_state.inventory.copy()\n    )\n\n    # Define action constants based on the problem description for CraftLab.action_specs\n    # DOWN->0, UP->1, LEFT->2, RIGHT->3, USE->4\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Set a maximum number of simulation steps to prevent infinite loops\n    # in case a path is impossible or the strategy gets stuck.\n    max_sim_steps = 200\n\n    # If the primitive is already in the inventory, no actions are needed.\n    if current_state_sim.inventory[primitive] > 0:\n        return []\n\n    # Main loop for simulation to find a path and collect the primitive.\n    for _ in range(max_sim_steps):\n        # Check if the primitive has been collected in the simulated state.\n        if current_state_sim.inventory[primitive] > 0:\n            break  # Goal achieved, exit loop\n\n        # Find all locations where the primitive is present on the grid.\n        primitive_coords = []\n        grid = current_state_sim.grid\n        WIDTH, HEIGHT, _ = grid.shape  # Get grid dimensions\n\n        for x in range(WIDTH):\n            for y in range(HEIGHT):\n                if grid[x, y, primitive] > 0:\n                    primitive_coords.append((x, y))\n\n        # If the primitive is not found on the map, it cannot be collected.\n        # This can happen if it's already in inventory (handled above)\n        # or if the scenario doesn't place it on the grid.\n        if not primitive_coords:\n            break  # Cannot complete the task, no primitive found\n\n        # Determine the agent's current position.\n        current_x, current_y = current_state_sim.pos\n\n        # Find the closest primitive location using Manhattan distance.\n        closest_primitive_coord = None\n        min_dist = float('inf')\n\n        for px, py in primitive_coords:\n            dist = abs(px - current_x) + abs(py - current_y)\n            if dist < min_dist:\n                min_dist = dist\n                closest_primitive_coord = (px, py)\n        \n        # This will be the target for movement.\n        target_x, target_y = closest_primitive_coord\n\n        action_taken_this_step = False\n\n        # Check if the agent is already adjacent to (or on the same cell as) the primitive.\n        # The `next_to` method checks the 3x3 neighborhood.\n        if current_state_sim.next_to(primitive):\n            # If adjacent, attempt to use (collect) the primitive.\n            actions.append(ACTION_USE)\n            # Update the simulated state by applying the USE action.\n            # CraftState.step returns (reward, new_state). We take new_state.\n            current_state_sim = current_state_sim.step(ACTION_USE)[1]\n            action_taken_this_step = True\n        else:\n            # If not adjacent, calculate the movement needed.\n            dx = target_x - current_x\n            dy = target_y - current_y\n\n            move_action = -1 # Initialize with an invalid action\n\n            # Prioritize moving along the axis with the larger distance (greedy approach).\n            if abs(dx) > abs(dy):\n                if dx > 0:\n                    move_action = ACTION_RIGHT\n                else:\n                    move_action = ACTION_LEFT\n            else: # dy is larger or equal, prioritize vertical movement\n                if dy > 0:\n                    move_action = ACTION_DOWN\n                else:\n                    move_action = ACTION_UP\n            \n            # Simulate the proposed move.\n            prev_pos = current_state_sim.pos\n            new_state_sim = current_state_sim.step(move_action)[1]\n            \n            # Check if the agent successfully moved. If not, it means an obstacle was hit.\n            if new_state_sim.pos == prev_pos:\n                # If stuck, try moving in the perpendicular direction.\n                if move_action == ACTION_RIGHT or move_action == ACTION_LEFT: # Was horizontal\n                    if dy > 0:\n                        move_action = ACTION_DOWN\n                    else:\n                        move_action = ACTION_UP\n                else: # Was vertical (ACTION_DOWN or ACTION_UP)\n                    if dx > 0:\n                        move_action = ACTION_RIGHT\n                    else:\n                        move_action = ACTION_LEFT\n                \n                # Try the perpendicular move.\n                new_state_sim = current_state_sim.step(move_action)[1]\n                \n                if new_state_sim.pos == prev_pos:\n                    # If still stuck after trying perpendicular move, the greedy strategy failed.\n                    # Break the loop as a path cannot be found with this simple strategy.\n                    break\n                else:\n                    # Successful perpendicular move.\n                    actions.append(move_action)\n                    current_state_sim = new_state_sim\n                    action_taken_this_step = True\n            else:\n                # Successful direct move.\n                actions.append(move_action)\n                current_state_sim = new_state_sim\n                action_taken_this_step = True\n        \n        # If for any reason no action was successfully taken in this step,\n        # break to prevent potential infinite loops.\n        if not action_taken_this_step:\n            break\n\n    return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T07:28:10.043756", "function_name": "collect", "function_body": "    from collections import deque\n\n    # Define action constants for clarity\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    # Define direction constants (assuming 0:N, 1:E, 2:S, 3:W for CraftState.dir)\n    DIR_NORTH, DIR_EAST, DIR_SOUTH, DIR_WEST = 0, 1, 2, 3\n\n    # (dx, dy) for movement actions relative to current position\n    ACTION_DELTAS = {\n        UP: (0, -1),   # Moving North (decreases y-coordinate)\n        DOWN: (0, 1),    # Moving South (increases y-coordinate)\n        LEFT: (-1, 0),   # Moving West (decreases x-coordinate)\n        RIGHT: (1, 0)    # Moving East (increases x-coordinate)\n    }\n\n    # Map a movement action to the direction the agent will face after taking that action\n    ACTION_TO_AGENT_DIR = {\n        UP: DIR_NORTH,\n        RIGHT: DIR_EAST,\n        DOWN: DIR_SOUTH,\n        LEFT: DIR_WEST\n    }\n\n    # Map of (relative_dx, relative_dy) from agent's position to primitive's position\n    # to the required direction the agent must be facing to USE the primitive.\n    REQUIRED_DIR_TO_FACE_PRIMITIVE = {\n        (1, 0): DIR_EAST,   # Primitive is to the East -> Agent must face East\n        (-1, 0): DIR_WEST,  # Primitive is to the West -> Agent must face West\n        (0, 1): DIR_SOUTH,  # Primitive is to the South -> Agent must face South\n        (0, -1): DIR_NORTH  # Primitive is to the North -> Agent must face North\n    }\n\n    current_state = env._current_state\n    start_pos = current_state.pos\n    start_dir = current_state.dir\n    grid = current_state.grid\n    width, height, _ = grid.shape # grid is (WIDTH, HEIGHT, n_kinds)\n\n    # Identify impassable terrain kinds\n    cookbook = env.world.cookbook\n    impassable_kinds = {env.world.water_index, env.world.stone_index}\n    # All environment items (non-grabbable) are generally impassable\n    impassable_kinds.update(cookbook.environment)\n\n    # Find all locations of the target primitive on the grid\n    primitive_locs = []\n    for x in range(width):\n        for y in range(height):\n            if grid[x, y, primitive] == 1:\n                primitive_locs.append((x, y))\n\n    if not primitive_locs:\n        return [] # Primitive not found in the grid\n\n    # BFS Queue: stores (position, direction, actions_taken_so_far)\n    q = deque([(start_pos, start_dir, [])])\n    \n    # Visited set: stores (position, direction) to avoid cycles and redundant paths.\n    # A state is defined by both the agent's position and its facing direction.\n    visited = set([(start_pos, start_dir)])\n\n    while q:\n        (cx, cy), current_agent_dir, actions_so_far = q.popleft()\n\n        # Check if the current position is adjacent to a primitive\n        # and if the agent is facing it correctly to USE it.\n        # This check is performed for every state popped from the queue,\n        # including the initial state.\n        for px, py in primitive_locs:\n            if abs(cx - px) + abs(cy - py) == 1: # Manhattan distance 1 means adjacent (4-directional)\n                rel_dx, rel_dy = px - cx, py - cy\n                required_facing_dir = REQUIRED_DIR_TO_FACE_PRIMITIVE.get((rel_dx, rel_dy))\n                \n                if required_facing_dir is not None and current_agent_dir == required_facing_dir:\n                    # Goal achieved: agent is at an adjacent cell and facing the primitive.\n                    # Return the path including the final USE action.\n                    return actions_so_far + [USE]\n\n        # Explore possible movement actions (UP, DOWN, LEFT, RIGHT) from the current state\n        for action, (dx, dy) in ACTION_DELTAS.items():\n            nx, ny = cx + dx, cy + dy\n\n            # Check grid bounds for the new position\n            if not (0 <= nx < width and 0 <= ny < height):\n                continue\n\n            # Check if the new position contains impassable terrain\n            is_impassable = False\n            for k_idx in impassable_kinds:\n                if grid[nx, ny, k_idx] == 1:\n                    is_impassable = True\n                    break\n            if is_impassable:\n                continue\n            \n            # Determine the new direction the agent will face after taking this movement action.\n            # (Assuming movement actions directly update the agent's facing direction.)\n            new_agent_dir = ACTION_TO_AGENT_DIR[action]\n            \n            # Check if this (position, direction) state has been visited before\n            if ((nx, ny), new_agent_dir) in visited:\n                continue\n            \n            # If valid and unvisited, add the new state to the queue and visited set\n            new_actions_list = actions_so_far + [action]\n            q.append(((nx, ny), new_agent_dir, new_actions_list))\n            visited.add(((nx, ny), new_agent_dir))\n\n    return [] # No path found to collect the primitive", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T07:28:10.115530", "function_name": "collect", "function_body": "    # Constants for actions (defined locally to meet \"only return code that will fit in that function\" constraint)\n    # In a real module, these would likely be global or imported from a common constants file.\n    _ACTIONS = {\n        \"DOWN\": 0,\n        \"UP\": 1,\n        \"LEFT\": 2,\n        \"RIGHT\": 3,\n        \"USE\": 4,\n    }\n\n    # (dr, dc) for movement actions relative to grid coordinates\n    _MOVE_DELTAS = {\n        _ACTIONS[\"UP\"]: (-1, 0),  # Decreases row (moves north)\n        _ACTIONS[\"DOWN\"]: (1, 0),   # Increases row (moves south)\n        _ACTIONS[\"LEFT\"]: (0, -1),  # Decreases column (moves west)\n        _ACTIONS[\"RIGHT\"]: (0, 1),  # Increases column (moves east)\n    }\n\n    # Access current state information from the CraftLab environment\n    state = env._current_state\n    grid = state.grid\n    current_pos = state.pos\n    world = state.world  # Reference to the CraftWorld instance\n    non_grabbable_indices = world.non_grabbable_indices\n\n    grid_height, grid_width, _ = grid.shape\n\n    # 1. Find all locations on the grid where the primitive exists.\n    primitive_locations = []\n    for r in range(grid_height):\n        for c in range(grid_width):\n            if grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        return []  # Primitive not found on the map\n\n    # 2. Precompute all \"valid approach cells\".\n    # An agent can \"USE\" a primitive if the primitive is in its 3x3 neighborhood (including its own cell).\n    # So, we mark any cell (r, c) as a valid approach cell if it is within 1 unit (horizontally, vertically, or diagonally)\n    # of any primitive_location.\n    is_valid_approach_cell = np.zeros((grid_height, grid_width), dtype=bool)\n    for pr, pc in primitive_locations:\n        for dr_adj in [-1, 0, 1]:\n            for dc_adj in [-1, 0, 1]:\n                adj_r, adj_c = pr + dr_adj, pc + dc_adj\n                if 0 <= adj_r < grid_height and 0 <= adj_c < grid_width:\n                    is_valid_approach_cell[adj_r, adj_c] = True\n\n    # 3. Perform a Breadth-First Search (BFS) to find the shortest path.\n    # BFS queue stores tuples of ((row, col), [actions_path_so_far])\n    from collections import deque\n    queue = deque([(current_pos, [])])\n    visited = {current_pos}  # Set to keep track of visited (row, col) positions\n\n    target_path = None  # To store the final sequence of actions\n\n    while queue:\n        (r, c), path = queue.popleft()\n\n        # Check if the current position is a valid approach cell for the primitive.\n        if is_valid_approach_cell[r, c]:\n            # If so, we've found the shortest path to a cell from which we can USE.\n            target_path = path + [_ACTIONS[\"USE\"]]\n            break  # Exit BFS, as the shortest path is found\n\n        # Explore neighboring cells\n        for action, (dr, dc) in _MOVE_DELTAS.items():\n            nr, nc = r + dr, c + dc\n\n            # Check boundary conditions\n            if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n                continue\n\n            # Check if the cell has already been visited in a shorter or equal path\n            if (nr, nc) in visited:\n                continue\n\n            # Check traversability: A cell is considered blocked if it contains any non-grabbable item.\n            # This is an assumption based on common grid world mechanics, where certain items\n            # like \"water\" or \"stone\" (often in non_grabbable_indices) might represent impassable terrain.\n            is_blocked = False\n            for kind_idx in non_grabbable_indices:\n                if grid[nr, nc, kind_idx] > 0:\n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue  # Cannot move to this cell\n\n            # If traversable and not visited, add to queue\n            visited.add((nr, nc))\n            queue.append(((nr, nc), path + [action]))\n\n    return target_path if target_path is not None else []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T07:29:33.707913", "function_name": "collect", "function_body": "  # Get current state from the environment\n  current_state = env._current_state\n  \n  # Check if the primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  grid = current_state.grid\n  # numpy.ndarray.shape typically returns (rows, columns, depth)\n  # For a grid, this means (HEIGHT, WIDTH, n_kinds)\n  grid_height, grid_width, _ = grid.shape \n\n  start_pos_r, start_pos_c = current_state.pos # (row, col)\n  \n  # Define action constants based on the problem description\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Check if the primitive is at the agent's current position on the grid\n  if grid[start_pos_r, start_pos_c, primitive] > 0:\n      # Agent is on the primitive, just use the item\n      return [ACTION_USE]\n\n  # BFS queue: (row, col, path_to_reach_here)\n  queue = collections.deque([(start_pos_r, start_pos_c, [])])\n  \n  # Visited set: (row, col) tuples to prevent cycles and re-exploring\n  visited = set([(start_pos_r, start_pos_c)])\n\n  # Define movements (dr, dc) and their corresponding actions\n  # (dr, dc) mapping to action\n  movements = {\n      (1, 0): ACTION_DOWN,   # Move down (increase row index)\n      (-1, 0): ACTION_UP,    # Move up (decrease row index)\n      (0, -1): ACTION_LEFT,  # Move left (decrease col index)\n      (0, 1): ACTION_RIGHT   # Move right (increase col index)\n  }\n\n  # Get indices for known impassable terrain from CraftWorld\n  # These are attributes of the world object, which is part of the state\n  world = current_state.world\n  water_idx = world.water_index\n  stone_idx = world.stone_index\n\n  def is_cell_impassable(r, c):\n      \"\"\"Checks if a cell at (r, c) contains an impassable object.\"\"\"\n      # Assuming water and stone are the primary blocking elements\n      if grid[r, c, water_idx] > 0:\n          return True\n      if grid[r, c, stone_idx] > 0:\n          return True\n      # Add other specific impassable entities if needed for further versions\n      return False\n  \n  while queue:\n    r, c, path = queue.popleft()\n\n    # Explore neighbors\n    for (dr, dc), action_to_move in movements.items():\n      nr, nc = r + dr, c + dc\n\n      # Check grid bounds\n      if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n        continue\n\n      # Check if the neighboring cell contains the primitive\n      # The agent can move INTO a cell with a primitive if it's traversable.\n      # The primitive itself is generally not considered an impassable object.\n      if grid[nr, nc, primitive] > 0:\n        # Found the primitive! Construct the final path.\n        # Path is: path_to_current_cell + [action_to_move_to_primitive] + [USE_action]\n        return path + [action_to_move, ACTION_USE]\n\n      # If the cell does not contain the primitive, check if it's a traversable path\n      # and if we haven't visited it yet during this BFS.\n      if (nr, nc) not in visited and not is_cell_impassable(nr, nc):\n        visited.add((nr, nc))\n        queue.append((nr, nc, path + [action_to_move]))\n  \n  # If the queue becomes empty and no primitive was found, it's unreachable\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T07:29:33.777574", "function_name": "collect", "function_body": "    import collections\n\n    # Action mappings (from CraftLab.action_specs)\n    # Using internal names to avoid potential conflicts with global scope if any\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    # Direction deltas for movement actions (row_delta, col_delta)\n    _ACTION_TO_DELTA = {\n        _UP: (-1, 0),\n        _DOWN: (1, 0),\n        _LEFT: (0, -1),\n        _RIGHT: (0, 1),\n    }\n\n    # Helper function to check if a position is valid and walkable\n    def _is_walkable_internal(r, c, grid_shape, grid, non_grabbable_indices):\n        rows, cols = grid_shape\n        # Check if the position is within grid boundaries\n        if not (0 <= r < rows and 0 <= c < cols):\n            return False\n\n        # Check if the cell contains any non-grabbable items (obstacles)\n        # An agent cannot walk into a cell that contains a non-grabbable item.\n        for kind_idx in non_grabbable_indices:\n            if grid[r, c, kind_idx] > 0:\n                return False  # Contains an obstacle\n        return True\n\n    current_state = env._current_state\n    grid = current_state.grid\n    start_pos = current_state.pos  # (row, col)\n    non_grabbable_indices = current_state.world.non_grabbable_indices\n\n    grid_rows, grid_cols = grid.shape[:2]\n\n    # 1. Find all locations where the primitive exists on the grid.\n    target_locations = []\n    # np.where returns tuples of (row_indices, col_indices, kind_indices) for non-zero entries.\n    # We are interested in locations where `primitive` is present.\n    primitive_cells_rows, primitive_cells_cols = np.where(grid[:, :, primitive] > 0)\n    for r, c in zip(primitive_cells_rows, primitive_cells_cols):\n        target_locations.append((r, c))\n\n    if not target_locations:\n        return []  # Primitive not found on the grid\n\n    # Initialize BFS queue with the starting position and an empty path\n    q = collections.deque([(start_pos, [])])  # (current_pos, path_actions)\n    visited = {start_pos}\n\n    # BFS to find the shortest path to a position from where the primitive can be grabbed.\n    # A primitive can be grabbed if it's within the agent's 3x3 neighborhood (including the agent's current cell).\n    while q:\n        (r, c), path_actions = q.popleft()\n\n        # Check if the current position (r, c) allows the agent to grab the primitive.\n        # This means checking if any target_location is within the 3x3 neighborhood of (r,c).\n        can_grab_from_here = False\n        for tr, tc in target_locations:\n            # Check if (tr, tc) is within the 3x3 square centered at (r, c)\n            if max(abs(r - tr), abs(c - tc)) <= 1:\n                can_grab_from_here = True\n                break\n\n        if can_grab_from_here:\n            # Found a path to a position from which the primitive can be grabbed.\n            # Append the USE action and return the complete action sequence.\n            return path_actions + [_USE]\n\n        # If not ready to grab, explore neighboring cells\n        for action, (dr, dc) in _ACTION_TO_DELTA.items():\n            new_r, new_c = r + dr, c + dc\n            new_pos = (new_r, new_c)\n\n            if new_pos not in visited and \\\n               _is_walkable_internal(new_r, new_c, (grid_rows, grid_cols), grid, non_grabbable_indices):\n                \n                visited.add(new_pos)\n                q.append((new_pos, path_actions + [action]))\n\n    # If the BFS completes without finding a path to a grabbable position,\n    # it means the primitive is unreachable.\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T07:31:20.565777", "function_name": "collect", "function_body": "    # Action constants from the environment's action specs\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    # Get current state information\n    current_state = env._current_state\n    current_pos = current_state.pos\n    grid = current_state.grid\n    world = env.world # CraftLab has a world attribute\n\n    WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n    # Check if the primitive is already in inventory\n    initial_inventory = current_state.inventory\n    if initial_inventory[primitive] > 0:\n        return [] # Already collected\n\n    # Helper function to check if a cell is walkable\n    # A cell is walkable if it's within bounds and does not contain any non-grabbable item.\n    # Grabbable items (like the primitive itself) do not block movement.\n    def is_walkable(x, y):\n        # Check bounds\n        if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n            return False\n        # Check for non-grabbable (solid) items that block movement\n        for idx in world.non_grabbable_indices:\n            if grid[x, y, idx] == 1:\n                return False\n        return True\n\n    # BFS to find the shortest path to a cell containing the primitive\n    from collections import deque\n    q = deque([(current_pos, [])]) # (position_tuple, list_of_actions_to_reach_here)\n    visited = {current_pos}\n\n    # Possible moves (dx, dy, action)\n    moves = [\n        (0, 1, DOWN),  # Move South (y+1)\n        (0, -1, UP),   # Move North (y-1)\n        (-1, 0, LEFT), # Move West (x-1)\n        (1, 0, RIGHT)  # Move East (x+1)\n    ]\n\n    while q:\n        (cx, cy), c_path = q.popleft()\n\n        # Check if the current position already contains the primitive\n        # This handles the case where the agent starts on the primitive's cell\n        if grid[cx, cy, primitive] == 1:\n            # If we are on the primitive's cell, we can USE it directly\n            return c_path + [USE]\n\n        # Explore neighbors\n        for dx, dy, action in moves:\n            nx, ny = cx + dx, cy + dy\n            n_pos = (nx, ny)\n\n            if n_pos not in visited and is_walkable(nx, ny):\n                # Check if this neighbor cell contains the primitive\n                if grid[nx, ny, primitive] == 1:\n                    # Found a path to a primitive's cell.\n                    # Add the move to this cell, and then the USE action.\n                    return c_path + [action] + [USE]\n                \n                # If the neighbor does not contain the primitive,\n                # it's just a walkable step to explore further.\n                visited.add(n_pos)\n                q.append((n_pos, c_path + [action]))\n\n    # If no path is found to any cell containing the primitive after exploring all reachable cells\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T07:31:21.566843", "function_name": "collect", "function_body": "  # Get initial observations to determine current state\n  obs = env.observations()\n  current_grid = obs['features_dict']['features_global']\n  # CraftState's pos is a tuple(int, int), and features_dict['pos'] is np.ndarray float32.\n  # Assuming it's already integer coordinates, convert to tuple for consistency.\n  current_pos = tuple(obs['features_dict']['pos']) \n\n  # Check if the primitive is already in inventory.\n  # If yes, no actions needed to \"collect\" it.\n  if obs['features_dict']['inventory'][primitive] > 0:\n      return []\n\n  # Constants for CraftLab actions (assumed to be defined globally as per problem context)\n  # DOWN = 0, UP = 1, LEFT = 2, RIGHT = 3, USE = 4\n  # Movement deltas for (dr, dc) corresponding to UP, DOWN, LEFT, RIGHT actions\n  # MOVE_DELTAS = {UP: (-1, 0), DOWN: (1, 0), LEFT: (0, -1), RIGHT: (0, 1)}\n\n  def _find_path_to_primitive(grid, start_pos, primitive_idx):\n      \"\"\"\n      Uses BFS to find the shortest path of movement actions from start_pos\n      to a cell from which the primitive can be collected (i.e., adjacent to or on the primitive).\n      \n      Args:\n          grid (np.ndarray): The current grid state (H, W, N_KINDS).\n          start_pos (tuple): Agent's current position (row, col).\n          primitive_idx (int): The integer ID of the primitive to collect.\n\n      Returns:\n          list: A list of integer actions (0-3 for movement) representing the path,\n                or None if no path is found.\n      \"\"\"\n      height, width, _ = grid.shape\n      \n      # Use collections.deque for efficient queue operations (assumed to be imported globally)\n      queue = collections.deque([(start_pos, [])])  # (current_pos, path_actions)\n      visited = {start_pos}\n\n      # Find all cells containing the primitive\n      primitive_cells = set()\n      for r in range(height):\n          for c in range(width):\n              if grid[r, c, primitive_idx] == 1.0:\n                  primitive_cells.add((r, c))\n      \n      if not primitive_cells:\n          return None  # Primitive not found anywhere on the map\n\n      # Determine all valid 'pickup' locations: cells that are on or adjacent to a primitive cell.\n      # A cell is a pickup location if it itself contains the primitive OR\n      # if it's adjacent (4-way) to a cell that contains the primitive.\n      pickup_locations = set(primitive_cells) # Start with cells that contain the primitive\n\n      # Add adjacent cells to pickup_locations\n      for r_prim, c_prim in primitive_cells:\n          for dr_adj, dc_adj in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n              r_adj, c_adj = r_prim + dr_adj, c_prim + dc_adj\n              if 0 <= r_adj < height and 0 <= c_adj < width:\n                  pickup_locations.add((r_adj, c_adj))\n\n      # BFS to find the shortest path to any pickup_location\n      while queue:\n          current_pos, path = queue.popleft()\n\n          # If the current position is a pickup location, we found a path!\n          if current_pos in pickup_locations:\n              return path\n\n          # Explore neighbors (using global MOVE_DELTAS)\n          # Make sure these action constants are accessible from outside\n          # DOWN = 0, UP = 1, LEFT = 2, RIGHT = 3\n          # Re-defining them locally to ensure they are available within this nested function's scope\n          # or assume they are global to the module and accessible. For completion, assuming global context.\n          \n          # Defining them here for robustness if not truly global to the module,\n          # but typically they would be module-level constants.\n          _UP, _DOWN, _LEFT, _RIGHT = 1, 0, 2, 3\n          _MOVE_DELTAS = {\n              _UP: (-1, 0),\n              _DOWN: (1, 0),\n              _LEFT: (0, -1),\n              _RIGHT: (0, 1),\n          }\n\n          for action_val, (dr, dc) in _MOVE_DELTAS.items():\n              new_r, new_c = current_pos[0] + dr, current_pos[1] + dc\n              new_pos = (new_r, new_c)\n\n              # Check bounds and if already visited\n              if (0 <= new_r < height and 0 <= new_c < width) and new_pos not in visited:\n                  visited.add(new_pos)\n                  queue.append((new_pos, path + [action_val]))\n      \n      return None # No path found to any pickup location\n\n  # Find the path to the primitive\n  path_actions = _find_path_to_primitive(current_grid, current_pos, primitive)\n\n  if path_actions is None:\n      # Primitive not found or unreachable\n      return []\n\n  # The full sequence of actions: movement path + USE action\n  # USE action constant (4) assumed to be globally defined\n  _USE = 4 # Re-defining locally for robustness\n  full_actions = path_actions + [_USE]\n  \n  return full_actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T07:32:38.024268", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants (from CraftLab.action_specs, assuming standard mapping)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Movement deltas for (dy, dx) for each action\n  # (dy, dx) for DOWN, UP, LEFT, RIGHT\n  MOVE_DELTAS = {\n      ACTION_DOWN: (1, 0),\n      ACTION_UP: (-1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1)\n  }\n\n  # Mapping from (relative_dy, relative_dx) to required facing direction for USE action\n  # (target_y - agent_y, target_x - agent_x) -> CraftState.dir integer\n  # 0: DOWN, 1: UP, 2: LEFT, 3: RIGHT\n  RELATIVE_DIR_MAP = {\n      (-1, 0): 1,  # Primitive is above agent, agent needs to face UP\n      (1, 0): 0,   # Primitive is below agent, agent needs to face DOWN\n      (0, -1): 2,  # Primitive is left of agent, agent needs to face LEFT\n      (0, 1): 3    # Primitive is right of agent, agent needs to face RIGHT\n  }\n\n\n  def _get_turn_actions(current_dir: int, target_dir: int) -> list[int]:\n      \"\"\"\n      Calculates minimal turn actions (LEFT/RIGHT) to change from current_dir to target_dir.\n      Assumes CraftState direction mappings: 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT.\n      \"\"\"\n      actions = []\n      if current_dir == target_dir:\n          return []\n\n      # Determine turn actions based on current and target directions\n      if current_dir == 0:  # DOWN\n          if target_dir == 1:  # To UP (180 deg turn)\n              actions.extend([ACTION_LEFT, ACTION_LEFT])\n          elif target_dir == 2:  # To LEFT (90 deg left turn)\n              actions.append(ACTION_LEFT)\n          elif target_dir == 3:  # To RIGHT (90 deg right turn)\n              actions.append(ACTION_RIGHT)\n      elif current_dir == 1:  # UP\n          if target_dir == 0:  # To DOWN (180 deg turn)\n              actions.extend([ACTION_LEFT, ACTION_LEFT])\n          elif target_dir == 2:  # To LEFT (90 deg right turn)\n              actions.append(ACTION_RIGHT)\n          elif target_dir == 3:  # To RIGHT (90 deg left turn)\n              actions.append(ACTION_LEFT)\n      elif current_dir == 2:  # LEFT\n          if target_dir == 0:  # To DOWN (90 deg right turn)\n              actions.append(ACTION_RIGHT)\n          elif target_dir == 1:  # To UP (90 deg left turn)\n              actions.append(ACTION_LEFT)\n          elif target_dir == 3:  # To RIGHT (180 deg turn)\n              actions.extend([ACTION_LEFT, ACTION_LEFT])\n      elif current_dir == 3:  # RIGHT\n          if target_dir == 0:  # To DOWN (90 deg left turn)\n              actions.append(ACTION_LEFT)\n          elif target_dir == 1:  # To UP (90 deg right turn)\n              actions.append(ACTION_RIGHT)\n          elif target_dir == 2:  # To LEFT (180 deg turn)\n              actions.extend([ACTION_LEFT, ACTION_LEFT])\n\n      return actions\n\n\n  all_actions = []\n\n  # Access the current CraftState from the CraftLab environment\n  # This assumes _current_state is accessible for planning purposes.\n  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # 1. Find all locations of the primitive on the grid\n  primitive_locations = []\n  for r in range(grid_height):\n      for c in range(grid_width):\n          if grid[r, c, primitive] == 1:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      return []  # Primitive not found anywhere on the grid\n\n  # 2. Perform a BFS to find the shortest path to a cell adjacent to any primitive\n  # BFS state: (row, col, list_of_actions_taken_to_reach_this_cell, current_direction_at_this_cell)\n  # current_direction_at_this_cell is needed because it affects which turn actions are taken.\n  queue = collections.deque([(initial_pos[0], initial_pos[1], [], initial_dir)])\n  # Visited set tracks (row, col, direction) to avoid cycles and redundant exploration\n  visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n  target_path_info = None  # Stores (r, c, full_actions_list_including_use, final_dir_at_primitive_location, primitive_location_coords)\n\n  while queue:\n      r, c, path_actions, current_dir = queue.popleft()\n\n      # Check if current (r, c) is adjacent to a primitive location\n      for pr, pc in primitive_locations:\n          if abs(r - pr) + abs(c - pc) == 1:  # Manhattan distance of 1\n              # Found an adjacent cell! Calculate required facing direction\n              relative_dy = pr - r\n              relative_dx = pc - c\n              required_face_dir = RELATIVE_DIR_MAP.get((relative_dy, relative_dx))\n\n              if required_face_dir is not None:\n                  # We found a path. Since this is BFS, it's the shortest in terms of movement steps.\n                  # Now add turning actions and the USE action.\n                  turn_actions = _get_turn_actions(current_dir, required_face_dir)\n                  \n                  # Store the complete sequence of actions\n                  target_path_info = (r, c, path_actions + turn_actions + [ACTION_USE], required_face_dir, (pr, pc))\n                  break # Found a path, break from inner loop\n      \n      if target_path_info:\n          break # Found the shortest path, break from BFS loop\n\n      # Explore neighbors by moving\n      for action, (dr, dc) in MOVE_DELTAS.items():\n          nr, nc = r + dr, c + dc\n\n          # Check boundaries\n          if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n              continue\n\n          # Check if the cell is occupied by a non-grabbable entity (obstacle)\n          is_occupied = False\n          # Iterate over all kinds at the potential new cell (nr, nc)\n          for k_idx in range(grid.shape[2]):\n              if grid[nr, nc, k_idx] == 1: # If something is at this cell\n                  # Check if this item is considered part of the 'environment' (non-grabbable obstacles)\n                  if k_idx in env.world.cookbook.environment:\n                      is_occupied = True\n                      break\n          if is_occupied:\n              continue\n\n          # The agent's facing direction does not change from a movement action itself.\n          # It only changes with explicit turn actions (LEFT/RIGHT).\n          new_dir_after_move = current_dir\n\n          # Only add to queue if this state (position + direction) hasn't been visited\n          if (nr, nc, new_dir_after_move) not in visited:\n              visited.add((nr, nc, new_dir_after_move))\n              queue.append((nr, nc, path_actions + [action], new_dir_after_move))\n\n  if target_path_info:\n      all_actions = target_path_info[2]\n  else:\n      # No path found to any primitive's adjacent cell\n      return []\n\n  return all_actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T07:32:38.092959", "function_name": "collect", "function_body": "    actions = []\n\n    # Get the current state from the environment\n    current_state = env._current_state\n    world = current_state.world\n\n    # 1. Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # 2. Find the primitive's location on the grid\n    grid = current_state.grid\n    width, height, _ = grid.shape\n    \n    target_x, target_y = -1, -1\n\n    # Iterate through the grid to find the first occurrence of the primitive\n    # Assuming the primitive is directly represented on the grid\n    for x in range(width):\n        for y in range(height):\n            if grid[x, y, primitive] > 0:\n                target_x, target_y = x, y\n                break # Found, break inner loop\n        if target_x != -1:\n            break # Found, break outer loop\n    \n    # If primitive not found on the grid, it cannot be collected this way\n    # (e.g., it's a crafted item, or not present in the world)\n    if target_x == -1:\n        return [] \n    \n    # 3. Generate movement actions to reach the target location\n    current_x, current_y = current_state.pos\n\n    # Move along X-axis first\n    while current_x != target_x:\n        if target_x > current_x:\n            actions.append(env_factory.RIGHT)\n            current_x += 1\n        else:\n            actions.append(env_factory.LEFT)\n            current_x -= 1\n\n    # Move along Y-axis next\n    while current_y != target_y:\n        if target_y > current_y:\n            actions.append(env_factory.DOWN)\n            current_y += 1\n        else:\n            actions.append(env_factory.UP)\n            current_y -= 1\n\n    # 4. Add USE action conditionally\n    # If the primitive is a non-grabbable entity (like a tree or rock that needs to be \"used\" to extract resources),\n    # it requires a 'USE' action. Grabbable items are collected just by moving onto their cell.\n    if primitive in world.non_grabbable_indices:\n        actions.append(env_factory.USE)\n    \n    return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T07:34:17.635685", "function_name": "collect", "function_body": "  # Define constants for actions based on CraftLab's action_specs.\n  # These are hardcoded as per the problem description \"action_specs(self) -> dict mapping DOWN\u21920, UP\u21921, LEFT\u21922, RIGHT\u21923, USE\u21924\".\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Define movement deltas for BFS pathfinding.\n  # Maps action code to (dx, dy) for grid movement.\n  MOVE_DELTAS = {\n      UP: (0, -1),   # Moving UP decreases the y-coordinate (North)\n      DOWN: (0, 1),    # Moving DOWN increases the y-coordinate (South)\n      LEFT: (-1, 0),   # Moving LEFT decreases the x-coordinate (West)\n      RIGHT: (1, 0)   # Moving RIGHT increases the x-coordinate (East)\n  }\n\n  def _bfs_pathfinding(start_pos, target_pos, grid, non_grabbable_indices):\n      \"\"\"\n      Helper function: Finds the shortest path from start_pos to target_pos using BFS.\n      It avoids cells that contain any \"non-grabbable\" entities, assuming these are\n      impassable terrain features (e.g., walls, deep water).\n\n      Args:\n          start_pos (tuple): Agent's starting (x, y) coordinates.\n          target_pos (tuple): Target (x, y) coordinates to reach.\n          grid (numpy.ndarray): The current grid state (WIDTH, HEIGHT, n_kinds).\n          non_grabbable_indices (set): Set of integer indices for non-traversable entity kinds.\n\n      Returns:\n          list: A list of action codes (UP, DOWN, LEFT, RIGHT) representing the path,\n                or None if no path exists.\n      \"\"\"\n      q = [(start_pos, [])] # Queue stores (current_position, path_taken_so_far)\n      visited = {start_pos} # Set to store visited positions to avoid cycles\n\n      grid_width, grid_height, _ = grid.shape\n\n      while q:\n          (cx, cy), path = q.pop(0) # Get current position and path\n\n          if (cx, cy) == target_pos:\n              return path # Found the target, return the path\n\n          # Explore all possible adjacent moves\n          for action_code, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = cx + dx, cy + dy\n              next_pos = (nx, ny)\n\n              # Check if the next position is within grid boundaries and not yet visited\n              if 0 <= nx < grid_width and 0 <= ny < grid_height and next_pos not in visited:\n                  is_blocked = False\n                  # Check if the next cell contains any non-grabbable (and thus assumed blocked) item\n                  for kind_idx in non_grabbable_indices:\n                      # If the grid cell at (nx, ny) contains this non-grabbable kind\n                      if grid[nx, ny, kind_idx] == 1:\n                          is_blocked = True\n                          break\n                  \n                  # If the cell is not blocked, add it to the queue and visited set\n                  if not is_blocked:\n                      visited.add(next_pos)\n                      q.append((next_pos, path + [action_code]))\n      return None # No path found to the target\n\n  # --- Main logic for collect_v1 function starts here ---\n  all_actions_taken = []\n  max_total_actions = 200 # A reasonable limit to prevent very long or infinite loops\n\n  # Get the initial state of the environment.\n  # env._current_state gives access to the underlying CraftState instance.\n  current_state = env._current_state \n\n  # Initial check: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Main loop: Continues until the primitive is collected or maximum actions are taken.\n  while len(all_actions_taken) < max_total_actions:\n      # Always get the most current state before deciding next actions.\n      current_state = env._current_state\n      \n      # Check if the primitive has been collected in the current state.\n      if current_state.inventory[primitive] > 0:\n          break # Goal achieved, exit the loop\n\n      # --- Search for the primitive on the grid ---\n      target_x, target_y = -1, -1\n      grid_width, grid_height, _ = current_state.grid.shape\n      \n      primitive_found_on_grid = False\n      for x in range(grid_width):\n          for y in range(grid_height):\n              # If the primitive kind is present at grid[x, y]\n              if current_state.grid[x, y, primitive] == 1:\n                  target_x, target_y = x, y\n                  primitive_found_on_grid = True\n                  break # Found the first instance, break inner loop\n          if primitive_found_on_grid:\n              break # Break outer loop too\n\n      actions_to_execute = [] # List to store actions for the current decision cycle\n\n      if primitive_found_on_grid:\n          # If the primitive is visible on the grid, pathfind to its location.\n          # We assume 'USE' action picks up items from the cell the agent is currently on.\n          path_actions = _bfs_pathfinding(\n              current_state.pos,\n              (target_x, target_y),\n              current_state.grid,\n              current_state.world.non_grabbable_indices # Use non-grabbable indices for impassable cells\n          )\n\n          if path_actions is None:\n              # If no path is found (e.g., primitive is blocked), give up for this attempt.\n              break \n          \n          actions_to_execute.extend(path_actions)\n          \n          # After moving to the target cell, perform the 'USE' action to collect the primitive.\n          actions_to_execute.append(USE)\n\n      else:\n          # If the primitive is not found on the visible grid.\n          # This implies it might be out of sight or not spawned yet.\n          # Implement a simple exploration strategy: take a random movement action.\n          # This helps in revealing new areas of the map.\n          random_move_action = np.random.choice([UP, DOWN, LEFT, RIGHT])\n          actions_to_execute.append(random_move_action)\n\n      # --- Execute the determined actions step by step ---\n      for action in actions_to_execute:\n          # Check if adding this action would exceed the maximum allowed actions.\n          if len(all_actions_taken) >= max_total_actions:\n              break # Stop executing more actions if limit reached\n          \n          all_actions_taken.append(action) # Record the action\n          reward, done, observations = env.step(action) # Take the action in the environment\n          \n          # After each step, update the current state and check for goal or termination.\n          current_state = env._current_state\n          if current_state.inventory[primitive] > 0:\n              break # Goal achieved, exit inner loop\n          if done:\n              break # Environment terminated, exit inner loop\n      \n      # If the primitive was collected or the environment terminated during the inner loop,\n      # exit the main while loop as well.\n      if current_state.inventory[primitive] > 0 or done:\n          break\n\n  # Return the sequence of all actions taken to either collect the primitive or\n  # until the maximum action limit was reached or no path was found.\n  return all_actions_taken", "island_id": 8, "scores": {"3": -1}}
