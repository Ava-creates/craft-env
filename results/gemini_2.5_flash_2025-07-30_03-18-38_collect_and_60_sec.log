{"timestamp": "2025-07-30T11:08:17.607010", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants, derived from CraftLab.action_specs\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Maximum number of steps to search, to prevent infinite loops or excessive computation.\n  # This acts as a practical limit for path length in BFS.\n  MAX_SEARCH_STEPS = 500\n\n  initial_state = env._current_state\n\n  # 1. Check if the primitive is already in inventory at the start\n  if initial_state.inventory[primitive] > 0:\n    return [] # Primitive is already collected, no actions needed\n\n  # Queue for BFS: stores (current_craft_state, list_of_actions_to_reach_this_state)\n  # `current_craft_state` is a `CraftState` object that correctly reflects its\n  # grid, inventory, position, and direction at that point in the simulated path.\n  queue = collections.deque()\n\n  # Visited set: stores a hashable representation of state to avoid cycles and redundant work.\n  # For this problem, we're planning movement to get *next to* a primitive and then *USE* it.\n  # The grid configuration (obstacles, primitive locations) is assumed static during movement planning.\n  # Only position and direction are tracked for visited states. Inventory changes are only\n  # considered at the final 'USE' action.\n  visited = set()\n\n  # Add initial state to queue\n  queue.append((initial_state, [])) # (CraftState object, list_of_actions)\n  visited.add((initial_state.pos, initial_state.dir)) # Only track pos and dir for visited states\n\n  # Define all possible movement actions\n  movement_actions = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  while queue:\n    current_craft_state, actions_taken = queue.popleft()\n\n    # Pruning: If current path is too long, stop exploring this branch\n    if len(actions_taken) >= MAX_SEARCH_STEPS:\n      continue\n\n    # Check if a 'USE' action from the current position would collect the primitive.\n    # This involves checking if the agent is next to the primitive and if 'USE'\n    # would actually increase the primitive's count in the inventory.\n    if current_craft_state.next_to(primitive):\n      # Simulate the 'USE' action from the current_craft_state.\n      # `CraftState.step()` returns a new CraftState object, so it's safe for simulation.\n      _, state_after_use = current_craft_state.step(ACTION_USE)\n\n      # If the primitive's count increased in the inventory after the 'USE' action,\n      # it means we successfully collected it. This is our goal state.\n      if state_after_use.inventory[primitive] > initial_state.inventory[primitive]:\n        # Since this is BFS, the first path found is guaranteed to be the shortest.\n        return actions_taken + [ACTION_USE]\n\n    # Explore all possible movement actions from the current state\n    for action in movement_actions:\n      # Simulate the action: `current_craft_state.step(action)` returns a NEW CraftState object\n      _, next_craft_state = current_craft_state.step(action)\n\n      # Form a hashable signature for the next state (position and direction)\n      next_pos_dir_sig = (next_craft_state.pos, next_craft_state.dir)\n\n      # Only add to the queue if this exact position and direction combination\n      # hasn't been visited before. This prevents cycles and redundant exploration.\n      # This also handles cases where moving into an obstacle results in no change in pos/dir.\n      if next_pos_dir_sig not in visited:\n        visited.add(next_pos_dir_sig)\n        # Add the new state and the path to reach it to the queue\n        queue.append((next_craft_state, actions_taken + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found, return an empty list.\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:08:17.675997", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Define action constants (assuming these are the integer values for actions)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n    ACTIONS = [UP, DOWN, LEFT, RIGHT, USE]\n\n    # Maximum number of steps to explore in the BFS. This limits the search depth\n    # and prevents excessively long computations or out-of-memory errors for very\n    # large or complex environments. Adjust as needed based on expected map sizes.\n    MAX_SEARCH_DEPTH = 300 \n\n    # Ensure the environment is reset to its initial state for a fresh search.\n    # env.reset() returns observation, but we need the internal CraftState object.\n    _ = env.reset() \n    initial_craft_state = env._current_state \n\n    # Queue for Breadth-First Search (BFS). Each item is a tuple:\n    # (current_CraftState_instance, list_of_actions_taken_to_reach_this_state)\n    q = collections.deque([(initial_craft_state, [])])\n\n    # Visited set to keep track of states already explored.\n    # This prevents infinite loops and redundant computation.\n    # A state is defined by (agent_row, agent_col, agent_direction, has_primitive_in_inventory_status).\n    # We use 'int(inventory[primitive] > 0)' to represent whether the target primitive has been collected.\n    # This simplified state key assumes that grid changes (e.g., by using USE on other objects)\n    # do not significantly alter paths to the primitive in a way that requires re-exploring\n    # states with the same (pos, dir, primitive_collected_status).\n    visited = set()\n\n    while q:\n        current_state, current_path = q.popleft()\n\n        # Pruning: If the current path is too long, skip this branch to limit search time.\n        if len(current_path) >= MAX_SEARCH_DEPTH:\n            continue\n\n        # Goal Check: If the primitive is in the current inventory, we found a path.\n        # Since this is BFS, the first path found is guaranteed to be one of the shortest\n        # under the given state representation.\n        if current_state.inventory[primitive] > 0:\n            return current_path \n\n        # Create a unique key for the current state to add to the visited set.\n        # Using a tuple of hashable immutable types (pos_tuple, dir_int, status_int).\n        state_key = (current_state.pos, current_state.dir, int(current_state.inventory[primitive] > 0))\n\n        # If this state has already been visited, skip it.\n        if state_key in visited:\n            continue\n        \n        # Mark the current state as visited.\n        visited.add(state_key)\n\n        # Explore all possible actions from the current state.\n        for action in ACTIONS:\n            # Simulate the action to get the next state.\n            # CraftState.step returns a *new* CraftState instance, which is crucial for BFS\n            # as it allows exploring different paths without modifying the current_state.\n            _reward, next_state = current_state.step(action)\n            \n            # Create a key for the next state to check against the visited set.\n            next_state_key = (next_state.pos, next_state.dir, int(next_state.inventory[primitive] > 0))\n\n            # Only add the next state to the queue if it hasn't been visited before.\n            if next_state_key not in visited:\n                q.append((next_state, current_path + [action]))\n\n    # If the queue becomes empty and no path was found to collect the primitive,\n    # return an empty list, indicating the primitive is unreachable within the search limits.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:10:12.460905", "function_name": "collect", "function_body": "    current_state = env._current_state\n    grid = current_state.grid\n    start_pos = current_state.pos\n    inventory = current_state.inventory\n    \n    # If primitive is already collected, no actions needed\n    if inventory[primitive] > 0:\n        return []\n\n    # Action constants (assuming these are globally defined or accessible)\n    # DOWN = 0, UP = 1, LEFT = 2, RIGHT = 3, USE = 4\n    # Defined here for self-containment of the function logic if needed,\n    # but typically these would be module-level constants.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Relative coordinates for neighbors (dr, dc)\n    NEIGHBORS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # North, South, West, East\n\n    # Mapping (dr, dc) to action constants for grid movement\n    ACTION_MAPPING = {\n        (-1, 0): UP,\n        (1, 0): DOWN,\n        (0, -1): LEFT,\n        (0, 1): RIGHT,\n    }\n\n    # Check if the primitive is on the agent's current cell (pos)\n    # Assuming USE action can pick up items from the current cell if present\n    start_r, start_c = start_pos\n    if grid[start_r, start_c, primitive] == 1:\n        return [USE]\n\n    HEIGHT, WIDTH, _ = grid.shape\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # BFS setup\n    q = collections.deque([(start_pos, [])]) # (current_pos, current_path_actions)\n    visited = {start_pos}\n    target_info = None # Stores (primitive_pos, adjacent_agent_pos, path_actions_to_adj_pos)\n\n    while q and target_info is None:\n        curr_pos, path_actions = q.popleft()\n        curr_r, curr_c = curr_pos\n\n        # Check if current position is adjacent to the primitive\n        for dr_adj, dc_adj in NEIGHBORS:\n            adj_r, adj_c = curr_r + dr_adj, curr_c + dc_adj\n            \n            # Check bounds and if the adjacent cell contains the primitive\n            if (0 <= adj_r < HEIGHT and 0 <= adj_c < WIDTH) and grid[adj_r, adj_c, primitive] == 1:\n                # Found a primitive adjacent to current position\n                target_info = ((adj_r, adj_c), curr_pos, path_actions)\n                break \n        \n        if target_info is not None:\n            break\n\n        # Explore neighbors for movement\n        for dr_move, dc_move in NEIGHBORS:\n            next_pos = (curr_r + dr_move, curr_c + dc_move)\n            next_r, next_c = next_pos\n\n            # Check if next_pos is within bounds and not visited\n            if (0 <= next_r < HEIGHT and 0 <= next_c < WIDTH) and next_pos not in visited:\n                # Check if next_pos is traversable (not an obstacle)\n                is_traversable = True\n                for idx in non_grabbable_indices:\n                    # If this cell contains a non-grabbable item, it's an obstacle\n                    if grid[next_r, next_c, idx] == 1:\n                        is_traversable = False\n                        break\n                \n                if not is_traversable:\n                    continue # Skip this path\n\n                visited.add(next_pos)\n                action_to_take = ACTION_MAPPING[(dr_move, dc_move)]\n                q.append((next_pos, path_actions + [action_to_take]))\n\n    if target_info is None:\n        return [] # Primitive not found or unreachable\n\n    final_actions = target_info[2] # These are the moves to reach the cell adjacent to the primitive\n    final_actions.append(USE)\n    \n    return final_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:10:13.463746", "function_name": "collect", "function_body": "  # Action mappings from CraftLab.action_specs\n  # These are fixed constants in the CraftWorld environment\n  ACTION_MAP = {\n      \"DOWN\": 0,\n      \"UP\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4,\n  }\n\n  # Direction vectors for movement actions (dr, dc)\n  # Corresponds to action indices: 0: DOWN, 1: UP, 2: LEFT, 3: RIGHT\n  DIR_VECTORS = {\n      0: (1, 0),   # DOWN (dr, dc)\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1),   # RIGHT\n  }\n\n  # Maximum number of steps to plan to prevent excessive computation or infinite loops.\n  MAX_PLANNING_STEPS = 100\n\n  # Access the current internal state of the environment for planning.\n  # This assumes _current_state is accessible for simulation/planning purposes,\n  # as reconstructing the full state from observations for complex planning is\n  # often impractical without explicit state copying mechanisms.\n  current_state = env._current_state\n\n  # 1. Check if the primitive is already in the inventory\n  if current_state.inventory[primitive] > 0:\n      return [] # Already collected\n\n  # 2. Check if the primitive is a grabbable item\n  # We need access to the CraftWorld instance from the CraftLab environment\n  if primitive not in env.world.grabbable_indices:\n      # This primitive cannot be collected by the 'USE' action.\n      # It might be an environment feature, a non-grabbable item, or a craftable item.\n      return []\n\n  grid = current_state.grid\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's current facing direction\n\n  # BFS Queue: (current_r, current_c, current_dir, path_so_far)\n  # path_so_far is a list of actions (integers)\n  q = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n  \n  # Visited set: (r, c, d) to avoid cycles and redundant exploration\n  visited = set([(start_pos[0], start_pos[1], start_dir)])\n\n  while q:\n      r, c, d, path = q.popleft()\n\n      # Prune paths that are too long\n      if len(path) > MAX_PLANNING_STEPS:\n          continue\n\n      # Check if the current state (r, c, d) allows for collection of the primitive\n      # The agent can 'USE' to collect the item in the cell directly in front of it.\n      dr_front, dc_front = DIR_VECTORS[d]\n      target_r, target_c = r + dr_front, c + dc_front\n\n      # Check if the cell in front is within bounds and contains the primitive\n      if (0 <= target_r < WIDTH and 0 <= target_c < HEIGHT and\n          grid[target_r, target_c, primitive] > 0):\n          \n          # Found a primitive that can be collected! Add the USE action to the path.\n          return path + [ACTION_MAP[\"USE\"]]\n\n      # Explore possible next states by taking movement actions\n      # Note: In this environment, movement actions (DOWN, UP, LEFT, RIGHT)\n      # also implicitly set the agent's new facing direction.\n      for action_idx in range(4): # Iterate through DOWN, UP, LEFT, RIGHT actions (0, 1, 2, 3)\n          dr_move, dc_move = DIR_VECTORS[action_idx] # Movement vector for this action\n          \n          new_r, new_c = r + dr_move, c + dc_move\n          new_d = action_idx # Agent's new direction is set to the direction of movement\n\n          # Check if the new position is valid (within grid bounds)\n          if 0 <= new_r < WIDTH and 0 <= new_c < HEIGHT:\n              new_state_tuple = (new_r, new_c, new_d)\n              if new_state_tuple not in visited:\n                  visited.add(new_state_tuple)\n                  q.append((new_r, new_c, new_d, path + [action_idx]))\n    \n  # If no path is found within the maximum planning steps or if no primitive is reachable\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:11:30.083004", "function_name": "collect", "function_body": "  # Imports necessary for the function\n  from collections import deque\n  import heapq # For A* search\n\n  # Constants (defined inside function scope as per the example of collect_v0)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  DIRECTION_TO_DELTA = {\n      DIR_UP: (0, -1),   # (dx, dy)\n      DIR_RIGHT: (1, 0),\n      DIR_DOWN: (0, 1),\n      DIR_LEFT: (-1, 0),\n  }\n\n  MOVE_ACTION_TO_DIRECTION = {\n      UP: DIR_UP,\n      RIGHT: DIR_RIGHT,\n      DOWN: DIR_DOWN,\n      LEFT: DIR_LEFT,\n  }\n\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n\n  # Ensure current_pos is an integer tuple for indexing\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  # Agent's initial direction (one-hot encoded)\n  current_dir = np.argmax(obs['features_dict']['direction'])\n\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n\n  W, H, K = grid.shape # Grid dimensions (Width, Height, Kinds)\n\n  # Efficiently compute traversable_mask using NumPy, similar to collect_v1\n  if non_grabbable_indices:\n      # A cell is non-traversable if ANY non-grabbable item is present in it.\n      # `grid[:, :, list(non_grabbable_indices)]` selects the relevant channels.\n      # `np.any(..., axis=2)` checks if any of these channels have a value > 0 at that (x,y) location.\n      obstacles_present = np.any(grid[:, :, list(non_grabbable_indices)] > 0, axis=2)\n      traversable_mask = ~obstacles_present # Invert to get traversable cells (True = traversable)\n  else:\n      # If there are no non-grabbable items defined, all cells are traversable.\n      traversable_mask = np.ones((W, H), dtype=bool)\n\n  # Validate starting position traversability\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      # Agent starts on an untraversable cell, no path possible.\n      # This should ideally not happen if the environment is initialized correctly.\n      return []\n\n  # 1. Identify all \"target\" agent states (pos_x, pos_y, dir) from which a primitive\n  #    can be collected using the USE action.\n  #    The USE action applies to the cell *in front* of the agent.\n  primitive_target_states = set() # Stores (agent_x, agent_y, agent_dir) tuples\n  primitive_locations = []       # Stores (primitive_x, primitive_y) tuples for heuristic\n\n  for px in range(W):\n      for py in range(H):\n          if grid[px, py, primitive] > 0: # Check if this cell contains the target primitive\n              primitive_locations.append((px, py))\n              \n              # Consider all 4 directions an agent could face to collect this primitive\n              # For each potential facing direction (target_dx, target_dy), calculate\n              # the agent's position (ax, ay) from which it would be facing (px, py).\n              for target_dir, (target_dx, target_dy) in DIRECTION_TO_DELTA.items():\n                  # If agent is at (ax, ay) and faces target_dir, the cell in front is (ax+target_dx, ay+target_dy).\n                  # We want this cell to be (px, py).\n                  # So, ax = px - target_dx, ay = py - target_dy.\n                  ax, ay = px - target_dx, py - target_dy\n\n                  # Check if the calculated agent position is within bounds and traversable\n                  if (0 <= ax < W and 0 <= ay < H and traversable_mask[ax, ay]):\n                      primitive_target_states.add((ax, ay, target_dir))\n\n  # If no primitive is found in the grid or no valid collection states exist, return empty path.\n  if not primitive_target_states:\n      return []\n\n  # 2. A* Search Algorithm\n  # The state in our A* search is (agent_x, agent_y, agent_direction).\n  \n  # Heuristic function: Manhattan distance from current agent position to the closest\n  # *primitive location*. This is admissible and consistent, as moving one step changes\n  # Manhattan distance by at most 1, and the true cost to reach a primitive location\n  # will be at least the Manhattan distance.\n  def heuristic(x, y, current_agent_dir): # current_agent_dir is not used in this heuristic calculation\n      if not primitive_locations:\n          return float('inf')\n\n      min_dist = float('inf')\n      for px, py in primitive_locations:\n          # Manhattan distance to primitive location\n          dist = abs(x - px) + abs(y - py)\n          min_dist = min(min_dist, dist)\n      return min_dist\n\n  # g_score[state]: actual cost from start_state to state\n  g_score = { (current_pos_x, current_pos_y, current_dir): 0 }\n\n  # f_score[state]: estimated total cost from start_state through state to goal\n  f_score = { (current_pos_x, current_pos_y, current_dir): heuristic(current_pos_x, current_pos_y, current_dir) }\n\n  # open_set: Priority queue of (f_score, g_score, state, path_taken_so_far)\n  # g_score is included as a tie-breaker in case of equal f_scores, preferring shorter paths.\n  open_set = [ (f_score[(current_pos_x, current_pos_y, current_dir)], \n                0, \n                (current_pos_x, current_pos_y, current_dir), \n                []) ]\n\n  while open_set:\n      # Pop the state with the lowest f_score (and then lowest g_score)\n      current_f, current_g, (curr_x, curr_y, curr_dir), actions_so_far = heapq.heappop(open_set)\n\n      # If we've already found a shorter path to this state, skip processing this one\n      if current_g > g_score.get((curr_x, curr_y, curr_dir), float('inf')):\n          continue\n\n      # Check if the current state is a goal state (one from which we can collect the primitive)\n      if (curr_x, curr_y, curr_dir) in primitive_target_states:\n          return actions_so_far + [USE] # Append USE action and return the complete path\n\n      # Explore neighbor states by applying movement actions\n      for action_val in [UP, DOWN, LEFT, RIGHT]:\n          # When a movement action is taken, the agent's direction changes to match the movement.\n          next_dir = MOVE_ACTION_TO_DIRECTION[action_val]\n          \n          # Calculate the new position based on the new direction\n          dx, dy = DIRECTION_TO_DELTA[next_dir]\n          next_x, next_y = curr_x + dx, curr_y + dy\n          \n          # Check if the next position is within grid boundaries and is traversable\n          if (0 <= next_x < W and 0 <= next_y < H and traversable_mask[next_x, next_y]):\n              \n              new_g_score = current_g + 1 # Each movement action costs 1 unit\n              next_state = (next_x, next_y, next_dir)\n\n              # If this path to next_state is shorter than any previously found path to next_state\n              if new_g_score < g_score.get(next_state, float('inf')):\n                  g_score[next_state] = new_g_score\n                  f_score[next_state] = new_g_score + heuristic(next_x, next_y, next_dir)\n                  # Add the new state to the priority queue with its path\n                  heapq.heappush(open_set, (f_score[next_state], new_g_score, next_state, actions_so_far + [action_val]))\n\n  # If the open_set becomes empty and no goal state was reached, it means the primitive\n  # is unreachable.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T11:11:31.147142", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Action constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Direction constants for the agent's internal facing direction (e.g., UP=0, RIGHT=1, DOWN=2, LEFT=3)\n  # These are derived from the DMLab environment's internal representation.\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  # Mapping from direction constant to (dx, dy) tuple for movement\n  DIRECTION_TO_DELTA = {\n      DIR_UP: (0, -1),   # (dx, dy)\n      DIR_RIGHT: (1, 0),\n      DIR_DOWN: (0, 1),\n      DIR_LEFT: (-1, 0),\n  }\n\n  # Mapping from movement action to the resulting agent direction after taking that action\n  MOVE_ACTION_TO_DIRECTION = {\n      UP: DIR_UP,\n      RIGHT: DIR_RIGHT,\n      DOWN: DIR_DOWN,\n      LEFT: DIR_LEFT,\n  }\n\n  obs = env.observations()\n  grid = obs['features_dict']['features_global'] # Full grid\n  \n  # Agent's current position (x, y) and initial facing direction\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  initial_dir = np.argmax(obs['features_dict']['direction'])\n\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices # Indices of obstacles\n\n  W, H, K = grid.shape # Grid dimensions\n\n  # Create a boolean mask indicating traversable cells\n  # A cell is non-traversable if it contains any non-grabbable item (obstacle)\n  if non_grabbable_indices:\n      # Select slices for non-grabbable kinds, check for presence (>0),\n      # and then check if ANY are present along the kind axis (axis=2).\n      obstacles_present = np.any(grid[:, :, list(non_grabbable_indices)] > 0, axis=2)\n      traversable_mask = ~obstacles_present # Invert: obstacles are NOT traversable\n  else:\n      traversable_mask = np.ones((W, H), dtype=bool) # All cells are traversable\n\n  # Check if the agent's starting position is traversable.\n  # This should generally be true for a valid scenario, but good for robustness.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return [] # Agent starts in an invalid/blocked position, cannot move.\n\n  # Identify all possible \"primitive target states\": (ax, ay, ad)\n  # where an agent at (ax, ay) facing 'ad' can successfully 'USE' to collect 'primitive'.\n  # This means (ax, ay) is adjacent to a primitive, and 'ad' points towards it.\n  primitive_target_states = set()\n  \n  for px in range(W):\n      for py in range(H):\n          if grid[px, py, primitive] > 0: # If this cell contains the primitive\n              # Iterate over all possible directions the agent could face\n              for agent_dir in [DIR_UP, DIR_RIGHT, DIR_DOWN, DIR_LEFT]:\n                  # Calculate the agent's position (ax, ay) if it were to face (px, py) from agent_dir\n                  # If agent is at (ax, ay) facing agent_dir, the cell in front is (ax + dx, ay + dy).\n                  # We want this front cell to be (px, py).\n                  # So, ax = px - dx and ay = py - dy.\n                  dx, dy = DIRECTION_TO_DELTA[agent_dir]\n                  ax, ay = px - dx, py - dy\n\n                  # Check if this potential agent position is within bounds and traversable\n                  if (0 <= ax < W and 0 <= ay < H and\n                      traversable_mask[ax, ay]):\n                      primitive_target_states.add((ax, ay, agent_dir))\n\n  # BFS search to find the shortest path to any primitive_target_state\n  # State in BFS queue: ((x, y, direction), list_of_actions_to_reach_here)\n  q = deque([((current_pos_x, current_pos_y, initial_dir), [])])\n  visited = {(current_pos_x, current_pos_y, initial_dir)} # Set of (x, y, dir) tuples\n\n  while q:\n      (curr_x, curr_y, curr_dir), actions_so_far = q.popleft()\n\n      # Check if the current state is one from which the primitive can be collected\n      if (curr_x, curr_y, curr_dir) in primitive_target_states:\n          return actions_so_far + [USE] # Goal reached: return path plus USE action\n\n      # Explore possible next states by taking movement actions (UP, DOWN, LEFT, RIGHT)\n      for action_val in [UP, DOWN, LEFT, RIGHT]:\n          next_dir = MOVE_ACTION_TO_DIRECTION[action_val] # Agent's new facing direction\n          \n          # Calculate the new position based on the new direction (move one step)\n          dx, dy = DIRECTION_TO_DELTA[next_dir]\n          next_x, next_y = curr_x + dx, curr_y + dy\n          \n          next_state = (next_x, next_y, next_dir)\n\n          # Check if the next cell is within bounds, traversable, and has not been visited\n          if (0 <= next_x < W and 0 <= next_y < H and\n              traversable_mask[next_x, next_y] and\n              next_state not in visited):\n              \n              visited.add(next_state)\n              q.append((next_state, actions_so_far + [action_val]))\n\n  # If the queue becomes empty and no path to a primitive was found\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T11:13:16.939112", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on the problem description (action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action IDs to (dr, dc) for movement (change in row, change in column)\n  # and assume that movement actions also set the agent's facing direction.\n  # Assuming 0=UP, 1=DOWN, 2=LEFT, 3=RIGHT directions for both movement and facing\n  # and (row, col) grid coordinates.\n  MOVEMENT_DIRS = {\n      ACTION_UP: (-1, 0),    # Moves up (row-1)\n      ACTION_DOWN: (1, 0),   # Moves down (row+1)\n      ACTION_LEFT: (0, -1),  # Moves left (col-1)\n      ACTION_RIGHT: (0, 1)   # Moves right (col+1)\n  }\n  # Map (dr, dc) back to the action ID that leads to facing that direction.\n  REV_MOVEMENT_DIRS = {v: k for k, v in MOVEMENT_DIRS.items()}\n\n  # Access the current state directly from the CraftLab instance for accurate position and grid\n  # CraftLab has a _current_state attribute which is a CraftState instance\n  # This avoids potential rounding issues with normalized positions from observations()\n  current_state = env._current_state\n  current_grid = current_state.grid\n  grid_h, grid_w, _ = current_grid.shape\n\n  # Agent's initial position (row, col) and direction\n  current_pos = current_state.pos\n  current_dir_idx = current_state.dir\n\n  # Identify grabbable primitives\n  grabbable_indices = env.world.grabbable_indices\n  if primitive not in grabbable_indices:\n      # The item is not grabbable, so it cannot be collected\n      return []\n\n  # Find all locations of the primitive in the current grid\n  primitive_locations = []\n  for r in range(grid_h):\n      for c in range(grid_w):\n          if current_grid[r, c, primitive] > 0:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      # Primitive not found in the world\n      return []\n\n  # BFS Initialization\n  # State in BFS queue: ((row, col), current_facing_direction), list_of_actions_taken\n  q = collections.deque([((current_pos[0], current_pos[1]), current_dir_idx, [])])\n  # Visited set: ( (row, col), current_facing_direction ) to avoid cycles\n  visited = set([((current_pos[0], current_pos[1]), current_dir_idx)])\n\n  while q:\n      (r, c), d, path = q.popleft()\n\n      # Check if current position (r, c) is adjacent to a primitive\n      # and if the agent is facing it correctly to use the ACTION_USE\n      for pr, pc in primitive_locations:\n          dr_to_prim, dc_to_prim = pr - r, pc - c\n          # Check if (r, c) is directly adjacent (Manhattan distance of 1) to (pr, pc)\n          if abs(dr_to_prim) + abs(dc_to_prim) == 1:\n              # Determine the direction the agent needs to face to interact with (pr, pc)\n              required_facing_dir = REV_MOVEMENT_DIRS.get((dr_to_prim, dc_to_prim))\n\n              if required_facing_dir is not None:\n                  # If the agent is already facing the primitive, we can USE\n                  if d == required_facing_dir:\n                      # Found a path to an adjacent cell, correctly oriented to collect\n                      final_actions = list(path) # Copy the path\n                      final_actions.append(ACTION_USE)\n                      return final_actions # Return the first (shortest) path found\n\n      # Explore possible movement actions from the current state\n      for action_id in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n          dr, dc = MOVEMENT_DIRS[action_id]\n          nr, nc = r + dr, c + dc # New row, new column\n          nd = action_id           # New facing direction (agent faces where it moves)\n\n          # Check if the new position is within grid boundaries\n          if not (0 <= nr < grid_h and 0 <= nc < grid_w):\n              continue\n\n          # Check if the new position is blocked by any non-grabbable entities\n          is_blocked = False\n          for k_idx in env.world.non_grabbable_indices:\n              if current_grid[nr, nc, k_idx] > 0:\n                  is_blocked = True\n                  break\n          if is_blocked:\n              continue # Cannot walk onto this cell\n\n          # If the new state (position and direction) has not been visited, add it to the queue\n          if ((nr, nc), nd) not in visited:\n              visited.add(((nr, nc), nd))\n              q.append(((nr, nc), nd, path + [action_id]))\n\n  # If the BFS completes and no path to collect the primitive is found\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T11:13:17.917614", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings and movement vectors locally as per the prompt's scope restrictions.\n  _ACTION_MAP = {\n      \"DOWN\": 0,\n      \"UP\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4,\n  }\n  _MOVES = {\n      _ACTION_MAP[\"DOWN\"]: (0, 1), # (dx, dy) for moving from (x,y)\n      _ACTION_MAP[\"UP\"]: (0, -1),\n      _ACTION_MAP[\"LEFT\"]: (-1, 0),\n      _ACTION_MAP[\"RIGHT\"]: (1, 0),\n  }\n\n  obs = env.observations()\n  # The full grid is available in features_global\n  current_grid = obs[\"features_dict\"][\"features_global\"]\n  # Agent's current position (x, y), convert numpy array to tuple for hashing in visited set\n  current_pos = tuple(obs[\"features_dict\"][\"pos\"])\n  \n  WIDTH, HEIGHT, N_KINDS = current_grid.shape\n\n  # Get non-grabbable indices from the CraftWorld instance (accessed via env.world).\n  # These are considered obstacles for movement.\n  world = env.world\n  obstacle_indices = set(world.non_grabbable_indices) \n\n  # Find all grid cells where the primitive item is located.\n  primitive_locations = []\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          if current_grid[x, y, primitive] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # The primitive is not found anywhere on the current grid.\n      return []\n\n  # Identify all traversable cells that are directly adjacent (4-directionally)\n  # to any primitive location. These are the target cells for the agent.\n  target_cells_for_agent = set()\n  for px, py in primitive_locations:\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Check 4 neighbors\n          nx, ny = px + dx, py + dy\n          \n          # Check if the neighbor cell is within grid bounds\n          if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n              continue\n\n          # Determine if the neighbor cell (nx, ny) is traversable by the agent.\n          # A cell is traversable if it does not contain any known obstacle\n          # and does not contain the primitive itself (agent needs to be adjacent to 'USE').\n          is_traversable = True\n          \n          # Check for generic obstacles (e.g., water, stone if not the primitive)\n          for k in obstacle_indices:\n              if current_grid[nx, ny, k] > 0:\n                  is_traversable = False\n                  break\n          \n          # Agent cannot move onto the primitive's cell itself, must be adjacent.\n          if is_traversable and current_grid[nx, ny, primitive] > 0:\n              is_traversable = False\n\n          if is_traversable:\n              target_cells_for_agent.add((nx, ny))\n  \n  if not target_cells_for_agent:\n      # No traversable cells found adjacent to any primitive location.\n      # This could happen if the primitive is entirely surrounded by obstacles or is an obstacle itself.\n      return []\n\n  # Perform a Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the target cells.\n  # Queue stores (current_position_tuple, list_of_actions_taken_to_reach_here)\n  queue = deque([(current_pos, [])])\n  visited = {current_pos} # Set to keep track of visited grid cells (x, y) to avoid cycles and redundant paths\n\n  best_path_actions = None # To store the shortest sequence of actions\n\n  while queue:\n      (x, y), path_actions = queue.popleft()\n\n      if (x, y) in target_cells_for_agent:\n          # Found the shortest path to a cell adjacent to the primitive.\n          best_path_actions = path_actions\n          break \n\n      # Explore all possible 4-directional moves from the current cell.\n      for action, (dx, dy) in _MOVES.items():\n          nx, ny = x + dx, y + dy\n          \n          # Check if the next cell (nx, ny) is within grid bounds and hasn't been visited yet.\n          if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT) or (nx, ny) in visited:\n              continue\n\n          # Check traversability for the potential next cell, similar to how target cells were determined.\n          is_traversable = True\n          for k in obstacle_indices:\n              if current_grid[nx, ny, k] > 0:\n                  is_traversable = False\n                  break\n          if is_traversable and current_grid[nx, ny, primitive] > 0:\n              is_traversable = False\n\n          if is_traversable:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path_actions + [action]))\n\n  if best_path_actions is not None:\n      # A path was found. Append the 'USE' action to collect the primitive.\n      return best_path_actions + [_ACTION_MAP[\"USE\"]]\n  else:\n      # No path found to any cell adjacent to the primitive.\n      return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:15:21.520551", "function_name": "collect", "function_body": "    # Define action constants (assuming standard CraftWorld mapping)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Direction deltas for movement (r_change, c_change)\n    # Maps action to (dr, dc) for moving in that direction.\n    MOVE_DELTAS = {\n        UP: (-1, 0),\n        DOWN: (1, 0),\n        LEFT: (0, -1),\n        RIGHT: (0, 1),\n    }\n\n    # Get the initial state information from the provided CraftLab environment.\n    # We access `_current_state` as it holds the grid, inventory, pos, etc.\n    # This function calculates a plan of actions, so it does not interactively\n    # step the environment. The `env` object is used for introspection only.\n    initial_state = env._current_state\n    \n    # Grid dimensions and number of kinds (features)\n    WIDTH, HEIGHT, N_KINDS = initial_state.grid.shape\n\n    # Get non-grabbable indices for impassable terrain.\n    # These are typically defined in the CraftWorld instance, accessible via scenario.world.\n    impassable_kinds = env.world.non_grabbable_indices\n\n    actions_plan = []\n\n    # 1. Check if the primitive is already in the agent's inventory.\n    if initial_state.inventory[primitive] > 0:\n        return actions_plan # Already collected, no actions needed.\n\n    # 2. Check if the agent is already adjacent to the primitive.\n    # We assume 'USE' action will collect the primitive if it's within the 3x3 neighborhood.\n    # This aligns with the 'CraftState.next_to' method description.\n    if initial_state.next_to(primitive):\n        actions_plan.append(USE)\n        return actions_plan\n\n    # 3. If not already collected or adjacent, perform BFS to find a path to a cell\n    #    adjacent to the primitive, avoiding impassable terrain.\n    start_pos = initial_state.pos\n    \n    # BFS queue: stores tuples of (current_position (r, c), list_of_actions_to_reach_current_position)\n    queue = collections.deque([(start_pos, [])])\n    visited = {start_pos} # Set of visited positions to prevent cycles and redundant exploration\n    \n    # Variables to store the found path to an adjacent cell\n    path_to_target_adj_pos = None\n\n    while queue:\n        (r, c), current_path = queue.popleft()\n\n        # Check if the current cell (r, c) is adjacent to the primitive.\n        # We check the 4 cardinal neighbors of (r, c) to see if they contain the primitive.\n        for dr, dc in MOVE_DELTAS.values(): \n            neighbor_r, neighbor_c = r + dr, c + dc\n            \n            # Check bounds for the neighbor cell\n            if not (0 <= neighbor_r < WIDTH and 0 <= neighbor_c < HEIGHT):\n                continue\n\n            # Check if the neighbor cell contains the primitive.\n            # If it does, (r, c) is a suitable cell for the agent to move to\n            # before using the 'USE' action.\n            if initial_state.grid[neighbor_r, neighbor_c, primitive] == 1:\n                path_to_target_adj_pos = current_path # This is the path from start_pos to (r, c)\n                queue.clear() # Found target, stop BFS immediately.\n                break\n        \n        if path_to_target_adj_pos is not None:\n            break # Break outer BFS loop as well if target path found.\n\n        # If target not found yet, explore valid neighbors from (r, c).\n        for action, (dr, dc) in MOVE_DELTAS.items():\n            nr, nc = r + dr, c + dc # New potential position for the agent\n\n            # Check bounds for the new position\n            if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n                continue\n            \n            # Check if the new position has already been visited\n            if (nr, nc) in visited:\n                continue\n\n            # Check if the cell (nr, nc) is passable.\n            # A cell is considered impassable if it contains any kind from the `impassable_kinds` set.\n            # `initial_state.grid[nr, nc]` is a one-hot vector for present kinds.\n            cell_kinds_at_pos = np.where(initial_state.grid[nr, nc] == 1)[0]\n            is_passable = True\n            for k_idx in cell_kinds_at_pos:\n                if k_idx in impassable_kinds:\n                    is_passable = False\n                    break\n            \n            if is_passable:\n                visited.add((nr, nc))\n                # Add the new position to the queue with the updated path.\n                queue.append(((nr, nc), current_path + [action]))\n    \n    # 4. If a path to an adjacent cell was found, extend the actions plan.\n    if path_to_target_adj_pos is not None:\n        actions_plan.extend(path_to_target_adj_pos)\n        actions_plan.append(USE) # Add the 'USE' action after reaching the adjacent cell.\n    \n    return actions_plan", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:15:22.522903", "function_name": "collect", "function_body": "  # Helper function for BFS pathfinding\n  def _find_path_to_collect_position(start_pos, target_kind_locs_set, grid_shape, action_map):\n      \"\"\"\n      Finds a path of movement actions to a position from which the agent can\n      immediately USE to collect a primitive.\n      Returns (list of actions, target_primitive_location_tuple).\n      \"\"\"\n      width, height, _ = grid_shape\n      \n      ACTION_UP = action_map['UP']\n      ACTION_DOWN = action_map['DOWN']\n      ACTION_LEFT = action_map['LEFT']\n      ACTION_RIGHT = action_map['RIGHT']\n\n      MOVES = {\n          ACTION_UP: (0, -1),\n          ACTION_DOWN: (0, 1),\n          ACTION_LEFT: (-1, 0),\n          ACTION_RIGHT: (1, 0),\n      }\n      \n      # Using collections.deque for efficient queue operations in BFS\n      # (assuming collections module is available in the environment scope)\n      queue = collections.deque([(start_pos, [])]) # (current_pos, path_actions_to_current_pos)\n      visited = {start_pos}\n\n      while queue:\n          (cx, cy), current_path = queue.popleft()\n\n          # For each possible next move from (cx,cy)\n          for action, (dx, dy) in MOVES.items():\n              # Calculate the position the agent would move into after taking 'action'\n              next_agent_x, next_agent_y = cx + dx, cy + dy\n\n              # Check bounds for the new agent position (nx, ny)\n              if not (0 <= next_agent_x < width and 0 <= next_agent_y < height):\n                  continue\n              \n              # If this position has already been visited by a shorter path\n              if (next_agent_x, next_agent_y) in visited:\n                  continue\n\n              # Calculate the position the agent would USE (this is the cell directly in front of next_agent_pos,\n              # assuming the agent's direction is set by the last movement action)\n              target_use_x, target_use_y = next_agent_x + dx, next_agent_y + dy \n\n              # Check bounds for the USE target position\n              if not (0 <= target_use_x < width and 0 <= target_use_y < height):\n                  continue\n\n              # If the cell at (target_use_x, target_use_y) contains one of the target primitives\n              if (target_use_x, target_use_y) in target_kind_locs_set:\n                  # Found a path that leads to (next_agent_x, next_agent_y),\n                  # and from there, the agent can USE in direction (dx, dy) to hit (target_use_x, target_use_y).\n                  return current_path + [action], (target_use_x, target_use_y)\n\n              # Mark (next_agent_x, next_agent_y) as visited and add to queue for further exploration\n              visited.add((next_agent_x, next_agent_y))\n              queue.append(((next_agent_x, next_agent_y), current_path + [action]))\n              \n      return None, None # No path found\n\n  # Main logic for collect_v2\n  actions_sequence = []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_USE = action_map['USE']\n\n  # Get the current state from the environment\n  current_state = env._current_state\n  \n  # 1. Check if the primitive is already in the agent's inventory\n  if current_state.inventory[primitive] > 0:\n      return [] # Already collected, no actions needed\n\n  # 2. Locate all occurrences of the primitive on the grid\n  grid = current_state.grid\n  width, height, n_kinds = grid.shape\n\n  target_primitive_locs = []\n  for y in range(height):\n      for x in range(width):\n          # Assuming `grid[x, y, kind_index]` gives count or presence\n          if grid[x, y, primitive] > 0:\n              target_primitive_locs.append((x, y))\n\n  if not target_primitive_locs:\n      # The primitive is not found anywhere on the map\n      return []\n\n  # Convert the list of target locations to a set for efficient lookup in BFS\n  target_primitive_locs_set = set(target_primitive_locs)\n  \n  # 3. Use BFS to find the shortest path to a position from which the primitive can be collected\n  movement_path, _ = _find_path_to_collect_position(\n      current_state.pos, target_primitive_locs_set, grid.shape, action_map\n  )\n\n  if movement_path is None:\n      # No reachable path found to any primitive\n      return []\n  \n  # If a path is found, append the movement actions\n  actions_sequence.extend(movement_path)\n  \n  # After moving to the correct position and facing the primitive, perform the USE action\n  actions_sequence.append(ACTION_USE)\n\n  return actions_sequence", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:16:52.701796", "function_name": "collect", "function_body": "    world = env.world\n    initial_state = env._current_state\n    \n    # Determine the primitive's integer index\n    # Assuming 'primitive' can be either a string name or an integer index\n    if isinstance(primitive, str):\n        # Use env.world.cookbook.index to get the integer ID for the primitive name\n        primitive_idx = world.cookbook.index.index(primitive)\n    else: # Assume it's already an integer index\n        primitive_idx = primitive\n\n    # 1. Check if the primitive is already collected in the initial state\n    if initial_state.inventory[primitive_idx] > 0:\n        return [] # Already have it, no actions needed\n\n    # BFS Initialization\n    # Queue stores tuples of (current_CraftState, list_of_actions_taken_to_reach_this_state)\n    q = collections.deque([(initial_state, [])])\n    \n    # Visited set stores a unique key for each state to prevent cycles and redundant exploration.\n    # A state is defined by (position_tuple, direction_int, inventory_tuple).\n    # Inventory is crucial because collecting an item changes the state, making it unique.\n    visited = set([(initial_state.pos, initial_state.dir, tuple(initial_state.inventory))])\n\n    # Maximum depth to prevent infinite loops or excessively long searches in complex scenarios.\n    # This value can be tuned; a grid of WIDTH x HEIGHT has (WIDTH*HEIGHT*4) possible (pos, dir) states,\n    # plus inventory permutations. 500 is a reasonable heuristic for path length.\n    max_search_depth = 500 \n\n    # Action constants as defined in CraftLab.action_specs()\n    # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    # The total number of actions is 5.\n    N_ACTIONS = 5 \n\n    while q:\n        current_state, path_so_far = q.popleft()\n\n        # Pruning: If the current path is too long, don't explore further from this node\n        if len(path_so_far) >= max_search_depth:\n            continue\n\n        # Explore all possible actions from the current state\n        for action in range(N_ACTIONS):\n            # Simulate the action to get the next state.\n            # CraftState.step handles all logic: movement, interaction, inventory updates.\n            # The reward is always 0.0 in this specific implementation.\n            _, next_state = current_state.step(action) \n\n            # Create a unique key for the next state to check if it has been visited.\n            # This ensures we don't revisit the exact same state (pos, dir, inventory).\n            next_state_key = (next_state.pos, next_state.dir, tuple(next_state.inventory))\n\n            # If this state has already been visited, skip it to avoid redundant work and cycles.\n            if next_state_key in visited:\n                continue\n\n            # Add the new state to the visited set\n            visited.add(next_state_key)\n            \n            # Append the current action to the path\n            new_path = path_so_far + [action]\n\n            # Check if the primitive was collected after performing this action\n            if next_state.inventory[primitive_idx] > 0:\n                return new_path # Goal achieved, return the sequence of actions\n\n            # If the goal is not yet achieved, add the next_state and its path to the queue\n            # for further exploration in a breadth-first manner.\n            q.append((next_state, new_path))\n\n    # If the queue becomes empty and the goal was not reached, it means the primitive is\n    # unreachable within the search depth or by the available actions in the current environment.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:16:53.678255", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:18:30.897465", "function_name": "collect", "function_body": "    # 1. Check if the primitive is already in inventory\n    if env._current_state.inventory[primitive] > 0:\n        return [] # Already collected\n\n    # 2. Get current state details\n    current_state = env._current_state\n    grid = current_state.grid\n    agent_pos = current_state.pos\n    world = current_state.world # Access CraftWorld details like WIDTH, HEIGHT\n\n    # 3. If agent is already next to the primitive, just use it\n    # This handles cases where the primitive is adjacent (within 3x3) but not on the same square,\n    # or if the agent is already on the same square as the primitive.\n    if current_state.next_to(primitive):\n        # Assumes the `USE` action will collect the item if adjacent/on-top.\n        return [env_factory.ACTIONS.USE]\n\n    # 4. Find the primitive's location on the grid\n    primitive_pos = None\n    # Iterate through the grid to find the first occurrence of the primitive\n    # Assuming `grid[r, c, primitive]` will be > 0 if present, 0 otherwise\n    for r in range(world.HEIGHT):\n        for c in range(world.WIDTH):\n            if grid[r, c, primitive] > 0:\n                primitive_pos = (r, c)\n                break\n        if primitive_pos:\n            break\n\n    if not primitive_pos:\n        # Primitive not found anywhere on the map, cannot collect\n        return []\n\n    # 5. Plan actions to move from agent_pos to primitive_pos\n    actions = []\n    target_r, target_c = primitive_pos\n    curr_r, curr_c = agent_pos\n\n    # Greedy movement: prioritize vertical then horizontal\n    # This is a simple pathfinding. It does not account for obstacles that\n    # would require detours. It assumes the environment's step function\n    # will handle collisions gracefully (e.g., agent stays put if blocked).\n    # For a `v2` building on empty `v0`/`v1`, this is a reasonable starting point.\n\n    # Move vertically\n    while curr_r != target_r:\n        if target_r > curr_r:\n            actions.append(env_factory.ACTIONS.DOWN)\n            curr_r += 1 # Simulate internal position update for planning\n        else: # target_r < curr_r\n            actions.append(env_factory.ACTIONS.UP)\n            curr_r -= 1 # Simulate internal position update for planning\n\n    # Move horizontally\n    while curr_c != target_c:\n        if target_c > curr_c:\n            actions.append(env_factory.ACTIONS.RIGHT)\n            curr_c += 1 # Simulate internal position update for planning\n        else: # target_c < curr_c\n            actions.append(env_factory.ACTIONS.LEFT)\n            curr_c -= 1 # Simulate internal position update for planning\n\n    # After moving to the target primitive's location, use it to collect.\n    # This assumes that `USE` is the final step for collection once positioned\n    # at or adjacent to the primitive.\n    actions.append(env_factory.ACTIONS.USE)\n\n    return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:18:30.969855", "function_name": "collect", "function_body": "    # Action mappings for CraftLab, based on common DMLab patterns and context.\n    # These values are often defined as constants in the environment module.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Map movement actions to (delta_row, delta_col) for position update.\n    # Assuming (row, col) coordinates where row increases downwards/east, col increases rightwards/south.\n    # And assuming DMLab standard cardinal directions:\n    # 0: South (+col, (0,1))\n    # 1: North (-col, (0,-1))\n    # 2: East (+row, (1,0))\n    # 3: West (-row, (-1,0))\n    ACTION_MOVE_DELTAS = {\n        ACTION_DOWN: (0, 1),   # Move South (increase col)\n        ACTION_UP: (0, -1),    # Move North (decrease col)\n        ACTION_LEFT: (-1, 0),  # Move West (decrease row)\n        ACTION_RIGHT: (1, 0)   # Move East (increase row)\n    }\n\n    # Map movement actions to the new direction the agent faces after the move.\n    # This assumes that taking a movement action also sets the agent's facing direction to that cardinal direction.\n    ACTION_TO_NEW_DIR = {\n        ACTION_DOWN: 0,   # Agent faces South\n        ACTION_UP: 1,     # Agent faces North\n        ACTION_LEFT: 3,   # Agent faces West\n        ACTION_RIGHT: 2   # Agent faces East\n    }\n\n    # Map current facing direction to (delta_row, delta_col) for the cell \"in front\" of the agent.\n    # This delta is used to determine the target cell for the ACTION_USE.\n    DIR_TO_FRONT_DELTA = {\n        0: (0, 1),   # South: target at (r, c+1)\n        1: (0, -1),  # North: target at (r, c-1)\n        2: (1, 0),   # East: target at (r+1, c)\n        3: (-1, 0)   # West: target at (r-1, c)\n    }\n\n\n    # Access the current state of the environment\n    current_state = env._current_state\n    grid = current_state.grid\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir\n    inventory = current_state.inventory\n    world = current_state.world\n\n    # If the primitive is already in the inventory, no actions are needed\n    if inventory[primitive] > 0:\n        return []\n\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n    # Get the indices of non-grabbable items (obstacles) from the world configuration\n    non_grabbable_indices = world.non_grabbable_indices\n\n    def is_valid_coord(r, c):\n        \"\"\"Checks if a given (row, col) coordinate is within the grid boundaries.\"\"\"\n        return 0 <= r < WIDTH and 0 <= c < HEIGHT\n\n    def is_walkable(r, c):\n        \"\"\"\n        Checks if a given cell (r, c) is walkable.\n        A cell is not walkable if it contains any non-grabbable item (obstacle).\n        \"\"\"\n        if not is_valid_coord(r, c):\n            return False\n        # Check if the cell contains any non-grabbable obstacle\n        # grid[r, c, k] == 1 means item k is present at (r, c)\n        for k_idx in non_grabbable_indices:\n            if grid[r, c, k_idx] == 1:\n                return False\n        return True\n\n    # BFS Initialization\n    # The state in the queue is (row, col, current_direction, list_of_actions_to_reach_this_state)\n    queue = collections.deque([(initial_pos[0], initial_pos[1], initial_dir, [])])\n    # Visited set stores (row, col, current_direction) tuples to prevent cycles and re-exploring states\n    visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n    best_path = None\n    min_actions = float('inf') # Tracks the length of the shortest path found so far\n\n    while queue:\n        r, c, current_dir, actions = queue.popleft()\n\n        # If the current path is already longer than or equal to the best path found,\n        # there's no need to explore further from this state as it won't be shorter.\n        if len(actions) >= min_actions:\n            continue\n\n        # --- Check for \"USE\" possibility from current state ---\n        # Determine the cell directly in front of the agent based on its current direction\n        dr_front, dc_front = DIR_TO_FRONT_DELTA[current_dir]\n        target_r, target_c = r + dr_front, c + dc_front\n\n        # If the cell in front is valid and contains the primitive, we found a potential solution\n        if is_valid_coord(target_r, target_c) and grid[target_r, target_c, primitive] == 1:\n            final_actions = actions + [ACTION_USE]\n            if len(final_actions) < min_actions:\n                min_actions = len(final_actions)\n                best_path = final_actions\n            # Continue BFS: We might find another path (possibly via a different sequence of moves)\n            # that leads to an equally short or shorter solution. However, once a primitive is found\n            # and collected, the task is often complete. For finding *the* shortest, we continue\n            # exploring until the queue is exhausted or we find paths exceeding our best.\n            continue # Do not explore movement from this state if a solution is found here, as further moves would make the path longer than needed for this collection.\n\n        # --- Explore possible movement actions ---\n        for action_move in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n            dr_move, dc_move = ACTION_MOVE_DELTAS[action_move]\n            new_r, new_c = r + dr_move, c + dc_move\n            new_dir = ACTION_TO_NEW_DIR[action_move] # New direction after taking this move action\n\n            # If the new cell is walkable and this (position, direction) state hasn't been visited\n            if is_walkable(new_r, new_c) and (new_r, new_c, new_dir) not in visited:\n                visited.add((new_r, new_c, new_dir))\n                queue.append((new_r, new_c, new_dir, actions + [action_move]))\n\n    # After BFS completes, return the shortest path found or an empty list if no path exists\n    if best_path:\n        return best_path\n    else:\n        return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:19:37.667301", "function_name": "collect", "function_body": "  import collections\n\n  # Constants for actions\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4\n\n  # Agent's direction determines which cell 'USE' acts upon.\n  _DIR_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN (facing positive Y)\n      1: (0, -1), # UP (facing negative Y)\n      2: (-1, 0), # LEFT (facing negative X)\n      3: (1, 0)   # RIGHT (facing positive X)\n  }\n\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index.index(primitive)\n  \n  # Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  target_primitive_locs = set() # Store (x, y) coordinates of the primitive\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        target_primitive_locs.add((x, y))\n\n  if not target_primitive_locs:\n    return [] # Primitive not found on the map\n\n  # Data from env.world to determine traversability\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def _is_traversable(x, y, current_grid, target_primitive_idx, non_grabbable_items):\n    \"\"\"\n    Checks if a cell (x, y) is traversable.\n    A cell is considered traversable if it's within bounds and does not contain\n    any non-grabbable item that is NOT the primitive we are trying to collect.\n    \"\"\"\n    # 1. Check boundary conditions\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # 2. Check for impassable obstacles\n    # Iterate through all kinds of entities that might be present at (x, y)\n    for k_idx in range(current_grid.shape[2]): # Iterate through all possible item kinds\n      if current_grid[x, y, k_idx] > 0: # If this kind (k_idx) is present at (x, y)\n        # If this kind is in the set of non-grabbable items AND it's not our target primitive\n        if k_idx in non_grabbable_items and k_idx != target_primitive_idx:\n          return False # This cell contains an impassable obstacle\n    return True\n\n  # BFS Initialization\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Initial direction from CraftState\n\n  # Queue stores tuples of ((current_x, current_y), current_direction, [list_of_actions])\n  queue = collections.deque([((start_pos[0], start_pos[1]), start_dir, [])])\n  \n  # Visited set stores ((x, y), direction) tuples to prevent cycles and redundant path exploration\n  visited = {((start_pos[0], start_pos[1]), start_dir)}\n\n  best_path = None\n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.popleft()\n\n    # Check if we can collect the primitive from the current state (position and direction)\n    # The 'USE' action operates on the cell directly in front of the agent.\n    face_x, face_y = curr_x + _DIR_TO_COORD_DIFF[curr_dir][0],\\\n                     curr_y + _DIR_TO_COORD_DIFF[curr_dir][1]\n\n    if (face_x, face_y) in target_primitive_locs:\n      # If the cell in front is the target primitive, we can collect it.\n      best_path = path_actions + [USE_ACTION]\n      break # Found the shortest path to collect it\n\n    # Explore possible movements\n    for action, (dx, dy) in _ACTION_TO_COORD_DIFF.items(): # action 0-3 correspond to (DOWN, UP, LEFT, RIGHT)\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = action # Moving in a direction also means facing that direction\n\n      if _is_traversable(next_x, next_y, grid, primitive_idx, non_grabbable_indices):\n        if ((next_x, next_y), next_dir) not in visited:\n          visited.add(((next_x, next_y), next_dir))\n          queue.append(((next_x, next_y), next_dir, path_actions + [action]))\n        \n  return best_path if best_path is not None else []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T11:19:38.671754", "function_name": "collect", "function_body": "  import collections\n\n  # Action definitions\n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4\n\n  # Agent's direction after a move action corresponds to that action's coordinate difference.\n  # So, _DIR_TO_COORD_DIFF is effectively the same as _ACTION_TO_COORD_DIFF for indexing.\n  _DIR_TO_COORD_DIFF = _ACTION_TO_COORD_DIFF \n\n  # Get necessary indices and world data\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index.index(primitive)\n  current_state = env._current_state\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  world_non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Check if the primitive is already in the agent's inventory\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # Function to check if a cell is traversable\n  def _is_traversable(x, y):\n      \"\"\"\n      Checks if a cell (x, y) is traversable.\n      A cell is considered traversable if it's within bounds and does not contain\n      any non-grabbable item that is NOT the primitive we are trying to collect.\n      \"\"\"\n      # 1. Check boundary conditions\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False\n      \n      # 2. Check for impassable obstacles\n      # Iterate through all kinds of entities that might be present at (x, y)\n      for k_idx in range(grid.shape[2]):\n          if grid[x, y, k_idx] > 0: # If this kind (k_idx) is present at (x, y)\n              # If this kind is in the set of non-grabbable items AND it's not our target primitive\n              if k_idx in world_non_grabbable_indices and k_idx != primitive_idx:\n                  return False # This cell contains an impassable obstacle\n      return True\n\n  # Find all locations on the grid where the primitive exists\n  target_primitive_locs = set() # Using a set for O(1) average lookup\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        target_primitive_locs.add((x, y))\n\n  if not target_primitive_locs:\n    # The primitive is not found anywhere on the current map\n    return []\n\n  # BFS setup\n  start_pos = current_state.pos # Agent's current (x, y) position\n  start_dir = current_state.dir # Agent's current facing direction\n\n  # Queue stores tuples of ((current_x, current_y), current_direction, [list_of_actions_to_reach_here])\n  queue = collections.deque([((start_pos[0], start_pos[1]), start_dir, [])]) \n  \n  # Visited set stores ((x, y), direction) tuples to prevent cycles and redundant path exploration\n  visited = {((start_pos[0], start_pos[1]), start_dir)} \n\n  best_path = None\n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.popleft() # Dequeue for BFS\n\n    # Check if the current position and direction allow using a primitive\n    # The cell that USE_ACTION will target\n    target_cell_dx, target_cell_dy = _DIR_TO_COORD_DIFF[curr_dir]\n    target_cell_x, target_cell_y = curr_x + target_cell_dx, curr_y + target_cell_dy\n    \n    # Is the targeted cell within bounds AND does it contain our primitive?\n    if (0 <= target_cell_x < grid_width and 0 <= target_cell_y < grid_height) and \\\n       (target_cell_x, target_cell_y) in target_primitive_locs:\n        # We found a path to a state where, by facing 'curr_dir', we can 'USE' the primitive.\n        best_path = path_actions\n        break # Path found! BFS guarantees this is the shortest path in terms of actions.\n\n    # Explore all possible movements from the current state\n    for action, (dx, dy) in _ACTION_TO_COORD_DIFF.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = action # The new direction is the action itself\n\n      # Check if the next position is traversable and within bounds\n      if _is_traversable(next_x, next_y): \n        if ((next_x, next_y), next_dir) not in visited:\n          visited.add(((next_x, next_y), next_dir))\n          queue.append(((next_x, next_y), next_dir, path_actions + [action]))\n\n  if best_path is None:\n    # If the queue becomes empty and no path was found, the primitive is unreachable.\n    return []\n\n  # Once adjacent to the primitive and facing it correctly, the final action is to USE it.\n  return best_path + [USE_ACTION]", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T11:21:07.811110", "function_name": "collect", "function_body": "  actions_taken = []\n  \n  action_map = env.action_specs()\n  DOWN_ACTION = action_map['DOWN']\n  UP_ACTION = action_map['UP']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Reset the environment to get the initial state\n  _ = env.reset(seed=0) # Using a fixed seed for consistency\n  current_state = env._current_state\n\n  max_total_steps = env.max_steps\n  current_step_count = 0\n\n  # Cache grid dimensions and non-grabbable indices for pathfinding\n  grid_height, grid_width, _ = current_state.grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n  \n  # Define movement deltas (dr, dc) for rows and columns, and their corresponding actions\n  move_deltas = [\n      (-1, 0), # UP (row decreases)\n      (1, 0),  # DOWN (row increases)\n      (0, -1), # LEFT (column decreases)\n      (0, 1)   # RIGHT (column increases)\n  ]\n  move_action_map = {\n      (-1, 0): UP_ACTION,\n      (1, 0): DOWN_ACTION,\n      (0, -1): LEFT_ACTION,\n      (0, 1): RIGHT_ACTION\n  }\n\n  # Main loop to find and collect the primitive\n  while True:\n      # 1. Check if the primitive is already in the inventory\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n      # 2. Check for maximum steps reached\n      if current_step_count >= max_total_steps:\n          # If max steps reached and primitive not collected, return partial path\n          return actions_taken\n\n      # 3. Check if the primitive is in the agent's 3x3 neighborhood\n      if current_state.next_to(primitive):\n          actions_taken.append(USE_ACTION)\n          _, done, _ = env.step(USE_ACTION)\n          current_state = env._current_state\n          current_step_count += 1\n          if done: # If collecting the primitive satisfied the task goal\n              return actions_taken\n          continue # Re-evaluate state (e.g., check inventory, or if multiple items need collecting)\n\n      # 4. If primitive is not next to agent, find a path to a location from where it can be collected\n      # Use Breadth-First Search (BFS) to find the shortest path to a cell\n      # from which the primitive is reachable (i.e., in the 3x3 neighborhood)\n\n      q = collections.deque([(current_state.pos, [])]) # (current_position (r,c), list_of_actions_to_reach_here)\n      visited = {current_state.pos} # Set of visited (row, col) tuples for BFS\n\n      path_to_primitive_adj = None\n\n      while q:\n          (r, c), path_segment = q.popleft()\n\n          # Explore neighbors (4-directional movement)\n          for dr, dc in move_deltas:\n              next_r, next_c = r + dr, c + dc\n              next_pos = (next_r, next_c)\n\n              # Check grid boundaries\n              if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n                  continue\n              \n              # Check if this cell has already been visited in BFS\n              if next_pos in visited:\n                  continue\n\n              # Check if the next cell is blocked by a non-grabbable item\n              is_blocked = False\n              for kind_idx in non_grabbable_indices:\n                  if current_state.grid[next_r, next_c, kind_idx] > 0:\n                      is_blocked = True\n                      break\n              if is_blocked:\n                  continue\n              \n              # This cell (next_r, next_c) is a valid, unvisited, and unblocked move.\n              # Add it to the queue and mark as visited.\n              new_path_segment = path_segment + [move_action_map[(dr, dc)]]\n              q.append((next_pos, new_path_segment))\n              visited.add(next_pos)\n\n              # Check if this new position `next_pos` is adjacent to the `primitive`\n              # (i.e., if `primitive` is in the 3x3 neighborhood of `next_pos`)\n              found_adj_primitive_in_bfs = False\n              for nbr_dr in [-1, 0, 1]:\n                  for nbr_dc in [-1, 0, 1]:\n                      check_r, check_c = next_r + nbr_dr, next_c + nbr_dc\n                      if 0 <= check_r < grid_height and 0 <= check_c < grid_width:\n                          # Check if the primitive itself is at this neighbor location on the grid\n                          if current_state.grid[check_r, check_c, primitive] > 0:\n                              found_adj_primitive_in_bfs = True\n                              break\n                  if found_adj_primitive_in_bfs:\n                      break\n              \n              if found_adj_primitive_in_bfs:\n                  path_to_primitive_adj = new_path_segment\n                  break # Found the shortest path, exit inner loop (neighbor exploration)\n          \n          if path_to_primitive_adj is not None:\n              break # Exit BFS queue loop as path is found\n      \n      # 5. Execute the found path or handle the scenario where no path is found\n      if path_to_primitive_adj:\n          for action in path_to_primitive_adj:\n              actions_taken.append(action)\n              _, done, _ = env.step(action)\n              current_state = env._current_state\n              current_step_count += 1\n              if done: # If task goal is satisfied or max_steps reached during movement\n                  return actions_taken\n          # After executing the path, the loop will continue to re-evaluate the state,\n          # which should now lead to `current_state.next_to(primitive)` being true.\n      else:\n          # No path found to any cell adjacent to the primitive.\n          # This implies the primitive is unreachable, not present on the grid,\n          # or completely surrounded by non-grabbable obstacles.\n          return actions_taken # Return the current list of actions (failure to collect)", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:21:07.880846", "function_name": "collect", "function_body": "    # Get action mappings dynamically from the environment.\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n    \n    # Define all possible actions for movement and interaction.\n    ALL_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n    # Initialize BFS queue with the initial state and an empty path.\n    # The initial state is taken from the current state of the provided env.\n    initial_craft_state = env._current_state \n\n    q = collections.deque([(initial_craft_state, [])])\n\n    # Define a function to generate a hashable representation of a CraftState.\n    # This is crucial for the `visited` set to track explored states efficiently.\n    # The hash includes agent position, direction, inventory contents, and grid state.\n    # `state.grid.tobytes()` is used to get a hashable representation of the NumPy grid array.\n    def get_state_hash(state: 'CraftState'):\n        return (state.pos, state.dir, tuple(state.inventory), state.grid.tobytes())\n\n    # Set to store hashable representations of visited states to avoid redundant exploration\n    # and guarantee the shortest path (as it's a BFS).\n    visited = set()\n\n    # Maximum number of states to explore. This acts as a safeguard against\n    # excessively long searches in complex or unsolvable scenarios.\n    MAX_NODES_TO_EXPLORE = 200000 \n    nodes_explored = 0\n\n    # Start the Breadth-First Search.\n    while q and nodes_explored < MAX_NODES_TO_EXPLORE:\n        current_craft_state, current_path = q.popleft()\n        nodes_explored += 1\n\n        state_hash = get_state_hash(current_craft_state)\n        \n        # If this state has already been visited, skip it as we've already found\n        # an equal or shorter path to it.\n        if state_hash in visited:\n            continue\n        # Mark the current state as visited.\n        visited.add(state_hash)\n\n        # Check for the goal: If the current inventory contains the desired primitive,\n        # we have found a path. Return the sequence of actions.\n        if current_craft_state.inventory[primitive] > 0:\n            return current_path\n\n        # Explore all possible next states by trying each action.\n        for action in ALL_ACTIONS:\n            # Simulate the step using CraftState.step. This method returns a\n            # new CraftState object, leaving the `current_craft_state` unchanged.\n            # We are interested in the new state, not the reward for planning here.\n            _, new_craft_state = current_craft_state.step(action)\n            # Append the current action to the path leading to the new state.\n            new_path = current_path + [action]\n\n            # Add the new state and its path to the queue for further exploration.\n            # The 'visited' set (checked at the top of the loop) will prevent\n            # reprocessing if this new state has already been found via a shorter path.\n            q.append((new_craft_state, new_path))\n            \n    # If the queue becomes empty (no more reachable states) or the maximum\n    # number of nodes is explored without the goal being satisfied,\n    # return an empty list, indicating that no path was found within limits.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:22:20.256973", "function_name": "collect", "function_body": "        # Initialize an empty list to store the sequence of actions.\n        actions = []\n        \n        # Get the initial state of the environment from the CraftLab instance.\n        # The CraftLab class holds the current CraftState in its _current_state attribute.\n        current_state = env._current_state\n        \n        # Define a maximum number of steps for exploration. This prevents infinite loops\n        # in cases where the primitive might be unreachable or the agent gets stuck.\n        MAX_EXPLORATION_STEPS = 500 \n        \n        # Check if the primitive is already present in the agent's inventory at the start.\n        # If so, no actions are needed, and we can return an empty list immediately.\n        if current_state.inventory[primitive] > 0:\n            return actions\n\n        # Iterate for a predefined maximum number of exploration steps.\n        for _ in range(MAX_EXPLORATION_STEPS):\n            # After each action or set of actions, re-check if the primitive has been collected.\n            if current_state.inventory[primitive] > 0:\n                return actions # Primitive successfully collected, return the actions taken.\n\n            # Use the `next_to` method of CraftState to check if the desired primitive\n            # is within the agent's immediate 3x3 vicinity.\n            if current_state.next_to(primitive):\n                # If the primitive is nearby, the agent needs to orient itself and use the 'USE' action.\n                # Since `next_to` only indicates proximity, not precise direction,\n                # we try 'USE' action and then turn 'RIGHT' to attempt facing the item from all 4 directions.\n                for _ in range(4): # Loop to try all four cardinal directions.\n                    # Attempt to 'USE' (action 4) to pick up or interact with the nearby item.\n                    actions.append(4) # Add 'USE' to the action list.\n                    # Apply the action to the environment and get the new state.\n                    _, new_state = env.step(4)\n                    current_state = new_state # Update the agent's current state.\n\n                    # Check if the primitive was collected after the 'USE' action.\n                    if current_state.inventory[primitive] > 0:\n                        return actions # Successfully collected, return actions.\n                    \n                    # If not collected, turn 'RIGHT' (action 3) to change orientation\n                    # and try 'USE' again in the next iteration of this inner loop.\n                    actions.append(3) # Add 'RIGHT' to the action list.\n                    _, new_state = env.step(3)\n                    current_state = new_state # Update the agent's current state.\n                \n                # If after trying all directions and 'USE' actions, the item is still not collected,\n                # it might not be directly grabbable by 'USE' from the current position,\n                # or requires a different interaction. In this case, we fall back to exploration.\n            \n            # If the primitive is not nearby, or if previous attempts to pick it up failed,\n            # the agent needs to explore the environment.\n            \n            # Store the agent's current position before attempting a move.\n            old_pos = current_state.pos\n            \n            # Attempt to move 'UP' (action 1), which typically corresponds to moving forward\n            # relative to the agent's current facing direction.\n            actions.append(1) # Add 'UP' to the action list.\n            _, new_state = env.step(1)\n            current_state = new_state # Update the agent's current state.\n            \n            # Check if the agent's position changed after attempting to move.\n            # If the position is the same, it means the agent likely hit a wall or obstacle.\n            if current_state.pos == old_pos:\n                # If blocked, turn 'RIGHT' (action 3) to try a different direction in the next step.\n                actions.append(3) # Add 'RIGHT' to the action list.\n                _, new_state = env.step(3)\n                current_state = new_state # Update the agent's current state.\n                \n        # If the loop completes without the primitive being collected, it means it was either\n        # unreachable, not found, or not collectible within the defined `MAX_EXPLORATION_STEPS`.\n        # In this scenario, return an empty list to indicate failure.\n        return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:22:20.327377", "function_name": "collect", "function_body": "    # Using hardcoded action values as per the problem description (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)\n    _ACTIONS_DOWN = 0\n    _ACTIONS_UP = 1\n    _ACTIONS_LEFT = 2\n    _ACTIONS_RIGHT = 3\n    _ACTIONS_USE = 4\n\n    current_state = env._current_state  # Get the current CraftState instance\n    world = current_state.world\n\n    # 1. Check if the primitive is already in the inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # 2. Get grid details and agent's current position\n    grid = current_state.grid\n    start_pos = current_state.pos\n    grid_height, grid_width, _ = grid.shape\n\n    # Define movement deltas for BFS and their corresponding actions\n    # (dr, dc) represents (change_in_row, change_in_column)\n    move_actions_deltas = {\n        _ACTIONS_DOWN: (1, 0),\n        _ACTIONS_UP: (-1, 0),\n        _ACTIONS_LEFT: (0, -1),\n        _ACTIONS_RIGHT: (0, 1)\n    }\n\n    # Identify obstacle kinds: Assume any kind listed in world.non_grabbable_indices acts as an obstacle.\n    # This includes 'water' and 'stone' indices, which are specifically mentioned in CraftWorld.\n    obstacle_kinds = world.non_grabbable_indices\n\n    # 3. Use Breadth-First Search (BFS) to find the shortest path to a cell\n    #    that is adjacent to the primitive.\n    # Queue stores tuples of ((row, col), [list_of_actions_to_reach_here])\n    # collections.deque is used for efficient popleft()\n    queue = collections.deque([(start_pos, [])])\n    visited = {start_pos}  # Keep track of visited positions to avoid cycles and redundant paths\n\n    while queue:\n        (r, c), path_actions = queue.popleft()\n\n        # Check if the current position (r, c) is adjacent to the primitive\n        # (including if the primitive is at (r, c) itself, as `next_to` covers 3x3)\n        # This mirrors the logic of CraftState.next_to(i_kind)\n        found_primitive_adjacent = False\n        for dr_n in [-1, 0, 1]:\n            for dc_n in [-1, 0, 1]:\n                nr_n, nc_n = r + dr_n, c + dc_n\n                # Check boundary conditions for the neighbor\n                if 0 <= nr_n < grid_height and 0 <= nc_n < grid_width:\n                    # If the primitive is found at this neighbor location\n                    if grid[nr_n, nc_n, primitive] > 0:\n                        found_primitive_adjacent = True\n                        break\n            if found_primitive_adjacent:\n                break\n\n        if found_primitive_adjacent:\n            # We are now adjacent to the primitive, so the next action should be USE.\n            return path_actions + [_ACTIONS_USE]\n\n        # Explore possible movement actions from the current position\n        for action, (dr, dc) in move_actions_deltas.items():\n            nr, nc = r + dr, c + dc\n            next_pos = (nr, nc)\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n                continue\n\n            # Check if the next position is an obstacle\n            is_obstacle = False\n            for k_idx in obstacle_kinds:\n                if grid[nr, nc, k_idx] > 0:  # If an obstacle kind occupies this cell\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n\n            # Check if this position has already been visited (to find shortest path)\n            if next_pos in visited:\n                continue\n\n            # If valid and unvisited, add to visited set and queue\n            visited.add(next_pos)\n            queue.append((next_pos, path_actions + [action]))\n\n    # If the BFS completes and no path to the primitive (or adjacent to it) is found\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:23:25.567300", "function_name": "collect", "function_body": "  # Get current state information from the CraftLab environment's internal CraftState\n  current_state = env._current_state\n  current_grid = current_state.grid\n  current_pos = current_state.pos  # This is a tuple (x, y)\n  current_inventory = current_state.inventory\n\n  # Get action mappings\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  actions = []\n\n  # 1. Check if the primitive is already collected\n  if current_inventory[primitive] > 0:\n    return []\n\n  # 2. Find the primitive's location on the grid\n  target_x, target_y = -1, -1\n  grid_width, grid_height, n_kinds = current_grid.shape\n\n  # Iterate through the grid to find the first occurrence of the primitive\n  for y in range(grid_height):\n    for x in range(grid_width):\n      if current_grid[x, y, primitive] > 0:  # Check if this cell contains the primitive\n        target_x, target_y = x, y\n        break  # Found the first instance, break inner loop\n    if target_x != -1:\n      break  # Found, break outer loop\n\n  # If the primitive was not found on the grid, it's not collectable in this scenario\n  if target_x == -1:\n    return []\n\n  # 3. Calculate path to the primitive\n  current_x, current_y = current_pos\n\n  # Generate horizontal movement actions\n  if target_x > current_x:\n    actions.extend([RIGHT] * (target_x - current_x))\n  elif target_x < current_x:\n    actions.extend([LEFT] * (current_x - target_x))\n\n  # Generate vertical movement actions\n  if target_y > current_y:\n    actions.extend([DOWN] * (target_y - current_y))\n  elif target_y < current_y:\n    actions.extend([UP] * (current_y - target_y))\n\n  # 4. Add USE action to collect the primitive once next to (or on) it\n  actions.append(USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:23:26.539425", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  current_state = env._current_state\n\n  # Defensive check: ensure _current_state is available\n  if current_state is None:\n    return [] # Cannot operate without a valid state\n\n  # Check if the primitive is already collected\n  if current_state.inventory[primitive] > 0:\n    return [] # Already collected, no actions needed\n\n  # Get action mappings dynamically from the environment\n  # action_specs() returns a dict mapping action names to integer IDs (e.g., 'down': 0)\n  action_map = env.action_specs()\n  DOWN = action_map['down']\n  UP = action_map['up']\n  LEFT = action_map['left']\n  RIGHT = action_map['right']\n  USE = action_map['use']\n\n  # Mapping from action to (dr, dc) delta for grid movement\n  _MOVE_DELTAS = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1),\n  }\n\n  grid = current_state.grid\n  start_r, start_c = current_state.pos\n  grid_height, grid_width, _ = grid.shape\n\n  # Identify impassable terrain indices from the world configuration\n  impassable_indices = set()\n  world = current_state.world\n  if hasattr(world, 'water_index'):\n    impassable_indices.add(world.water_index)\n  if hasattr(world, 'stone_index'):\n    impassable_indices.add(world.stone_index)\n  # Add other indices that might block movement if specified in CraftWorld (e.g., specific non-grabbable items).\n  # For this implementation, we assume water and stone are the primary obstacles.\n\n  # Initialize BFS queue with (row, col, list_of_actions_to_reach_here)\n  queue = collections.deque([(start_r, start_c, [])])\n  # Keep track of visited positions to avoid cycles and redundant work\n  visited = {(start_r, start_c)}\n\n  target_primitive_kind = primitive\n\n  while queue:\n    r, c, path_actions = queue.popleft()\n\n    # Check if the current position (r,c) is a valid \"pickup\" spot for the primitive.\n    # A pickup spot is any cell from which the primitive is in the 3x3 neighborhood.\n    # This simulates the CraftState.next_to() logic.\n    for dr_adj in [-1, 0, 1]:\n      for dc_adj in [-1, 0, 1]:\n        adj_r, adj_c = r + dr_adj, c + dc_adj\n        # Ensure the adjacent cell is within grid bounds\n        if 0 <= adj_r < grid_height and 0 <= adj_c < grid_width:\n          # Check if the primitive item exists at this adjacent location\n          if grid[adj_r, adj_c, target_primitive_kind] > 0:\n            # Found a position (r,c) from which we can pick up the primitive.\n            # The path to get to (r,c) is path_actions.\n            # Once at (r,c), we perform the USE action to collect the item.\n            return path_actions + [USE]\n\n    # Explore valid neighboring cells for movement\n    for action, (dr, dc) in _MOVE_DELTAS.items():\n      nr, nc = r + dr, c + dc\n\n      # Check if the new position is within grid boundaries\n      if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n        continue\n\n      # Check if the new cell is an impassable obstacle\n      is_impassable = False\n      for idx in impassable_indices:\n        if grid[nr, nc, idx] > 0: # If the cell contains an impassable object\n          is_impassable = True\n          break\n      if is_impassable:\n        continue\n\n      # Check if the new position has already been visited\n      if (nr, nc) in visited:\n        continue\n\n      # Add the new position to the queue and mark as visited\n      visited.add((nr, nc))\n      queue.append((nr, nc, path_actions + [action]))\n\n  # If the queue is exhausted and no path to a pickup spot was found\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:24:41.129490", "function_name": "collect", "function_body": "  import collections # Required for deque\n\n  # Define action constants based on CraftLab action_specs\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  initial_state = env._current_state\n  initial_pos = initial_state.pos\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Check if the primitive is already in the inventory\n  if initial_state.inventory[primitive] > 0:\n    return []\n\n  # BFS setup\n  # Queue stores tuples of (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(initial_pos, [])])\n  # Set of visited positions to avoid cycles and redundant checks\n  visited = {initial_pos}\n\n  # Relative moves for (dx, dy) and their corresponding actions\n  # Assuming (x, y) corresponds to (column, row)\n  neighbor_moves = {\n      (0, 1): DOWN,    # Move down (increase row)\n      (0, -1): UP,     # Move up (decrease row)\n      (1, 0): RIGHT,   # Move right (increase column)\n      (-1, 0): LEFT    # Move left (decrease column)\n  }\n\n  # BFS to find a path to a cell from which the primitive can be \"used\" (collected)\n  while q:\n    current_pos, current_path = q.popleft()\n    cx, cy = current_pos\n\n    # Check if any adjacent cell contains the primitive from the current position.\n    # If so, current_pos is a valid \"use\" location.\n    for dx, dy in neighbor_moves:\n      adj_x, adj_y = cx + dx, cy + dy\n\n      # Check if the adjacent cell is within grid boundaries\n      if 0 <= adj_x < grid_width and 0 <= adj_y < grid_height:\n        # Check if the primitive is present in the adjacent cell\n        if grid[adj_x, adj_y, primitive] > 0:\n          # Found a primitive, and current_pos allows using it.\n          # Append the USE action to the current path and return.\n          return current_path + [USE]\n\n    # If no primitive found adjacently from current_pos, explore neighbors\n    for (dx, dy), action in neighbor_moves.items():\n      next_x, next_y = cx + dx, cy + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries and has not been visited\n      if (0 <= next_x < grid_width and\n          0 <= next_y < grid_height and\n          next_pos not in visited):\n        \n        # Add the next position to visited and the queue with the updated path\n        visited.add(next_pos)\n        q.append((next_pos, current_path + [action]))\n\n  # If the queue becomes empty and no path to an adjacent primitive was found,\n  # it means the primitive is unreachable or not present on the grid.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:24:42.146339", "function_name": "collect", "function_body": "", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:26:07.781607", "function_name": "collect", "function_body": "    # Action constants (from CraftLab.action_specs)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Agent direction constants (assuming 0=N, 1=E, 2=S, 3=W common in grid worlds)\n    DIR_NORTH = 0\n    DIR_EAST = 1\n    DIR_SOUTH = 2\n    DIR_WEST = 3\n\n    actions = []\n    MAX_COLLECTION_STEPS = 200 # A safety limit to prevent infinite loops\n\n    for _ in range(MAX_COLLECTION_STEPS):\n        state = env._current_state\n        \n        # 1. Check if the primitive is already in inventory\n        if state.inventory[primitive] > 0:\n            return actions # Goal achieved: primitive collected\n\n        # 2. Check if the primitive is next to the agent (within 3x3 neighborhood)\n        if state.next_to(primitive):\n            actions.append(ACTION_USE)\n            reward, done, _ = env.step(ACTION_USE)\n            # After using, the state might change (e.g., primitive collected)\n            # We continue to the next loop iteration to re-evaluate the new state\n            continue\n\n        # 3. Primitive not next to agent, need to navigate\n        # Find all locations of the primitive on the grid\n        # np.argwhere returns (row_indices, col_indices) where condition is true\n        primitive_locations = np.argwhere(state.grid[:, :, primitive] == 1)\n\n        if len(primitive_locations) == 0:\n            # Primitive not found on the grid. It might be exhausted,\n            # or not present in this scenario, or not a \"grabbable\" item\n            # that appears on the grid. In this context, it means it's uncollectable.\n            return [] \n        \n        # Pick the first location of the primitive as the target.\n        # This is a heuristic; a more advanced agent might pick the closest.\n        target_pos_y, target_pos_x = primitive_locations[0]\n        \n        agent_pos_y, agent_pos_x = state.pos\n        agent_dir = state.dir # Agent's current facing direction (0:N, 1:E, 2:S, 3:W)\n\n        # Calculate difference in coordinates\n        dy = target_pos_y - agent_pos_y\n        dx = target_pos_x - agent_pos_x\n\n        # If agent is on the same cell as the primitive (dx=0, dy=0) but `next_to` was False,\n        # it implies the primitive cannot be collected by `USE` from the same cell,\n        # or it's a static element.\n        if dx == 0 and dy == 0:\n            return [] # Cannot collect from this position/type\n\n        action_to_take = -1\n        target_dir_needed = -1\n\n        # Determine the primary direction of movement based on the largest absolute difference\n        if abs(dx) > abs(dy): # Prioritize horizontal movement\n            if dx > 0: # Target is to the Right\n                target_dir_needed = DIR_EAST\n            else: # Target is to the Left\n                target_dir_needed = DIR_WEST\n        else: # Prioritize vertical movement (or if dx == 0, then only dy matters)\n            if dy > 0: # Target is Down\n                target_dir_needed = DIR_SOUTH\n            else: # Target is Up\n                target_dir_needed = DIR_NORTH\n        \n        # Check if agent is already facing the target direction\n        if agent_dir == target_dir_needed:\n            # Agent is facing the correct direction, move forward\n            if target_dir_needed == DIR_NORTH:\n                action_to_take = ACTION_UP\n            elif target_dir_needed == DIR_EAST:\n                action_to_take = ACTION_RIGHT\n            elif target_dir_needed == DIR_SOUTH:\n                action_to_take = ACTION_DOWN\n            elif target_dir_needed == DIR_WEST:\n                action_to_take = ACTION_LEFT\n        else:\n            # Need to turn to face the target direction\n            # Calculate rotational difference: (target_dir - current_dir + 4) % 4\n            # A difference of 1 means turn right, 3 means turn left.\n            # If difference is 2 (180 degrees), either turn (left or right) works; here we default to left.\n            diff = (target_dir_needed - agent_dir + 4) % 4\n            if diff == 1: # Turn right\n                action_to_take = ACTION_RIGHT\n            else: # Turn left (diff is 2 or 3)\n                action_to_take = ACTION_LEFT\n        \n        # Execute the determined action\n        actions.append(action_to_take)\n        reward, done, _ = env.step(action_to_take)\n\n        # If the environment signals `done` (e.g., max_steps of the environment reached)\n        # but the primitive has not been collected, then the task failed for this call.\n        if done and state.inventory[primitive] == 0:\n            return [] # Failed to collect within environment limits\n\n    # If the loop finishes without collecting the primitive, it means\n    # MAX_COLLECTION_STEPS was reached without success.\n    return [] # Failed to collect within this function's step limit", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:26:07.866639", "function_name": "collect", "function_body": "    actions = []\n    \n    # Access the current state of the environment.\n    # env.step() updates env._current_state internally, so this will always get the latest.\n    current_state = env._current_state \n\n    # Check if the primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return actions\n\n    # Action constants (standard DMLab mappings)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    max_exploration_steps = 500  # Safety limit to prevent very long or infinite loops\n\n    # Get grid dimensions\n    grid_height, grid_width, _ = current_state.grid.shape\n\n    # Sweep pattern variables\n    # horizontal_dir: 1 for moving right, -1 for moving left\n    horizontal_dir = 1 \n    \n    # Loop for exploration and collection\n    for _ in range(max_exploration_steps):\n        # Update current_state reference inside the loop to reflect changes from env.step()\n        current_state = env._current_state \n\n        # Check if the primitive is in the 3x3 neighborhood around the agent's position\n        if current_state.next_to(primitive):\n            actions.append(USE)\n            env.step(USE) # Perform the USE action\n            \n            # After trying to USE, check if the item was collected\n            if env._current_state.inventory[primitive] > 0:\n                return actions # Successfully collected\n\n            # If USE did not collect (e.g., wrong facing direction, or not collectable this way),\n            # continue exploration; the next iteration will determine movement.\n\n        # Get current agent position for movement logic\n        current_y, current_x = current_state.pos\n\n        # Determine the next movement action based on the sweep pattern\n        next_action = -1\n        if horizontal_dir == 1: # Agent is trying to move RIGHT\n            if current_x < grid_width - 1: # Can move right within bounds\n                next_action = RIGHT\n            else: # Hit right edge, need to move down and change horizontal direction\n                next_action = DOWN\n                horizontal_dir = -1 # Next horizontal sweep will be LEFT\n        else: # horizontal_dir == -1, Agent is trying to move LEFT\n            if current_x > 0: # Can move left within bounds\n                next_action = LEFT\n            else: # Hit left edge, need to move down and change horizontal direction\n                next_action = DOWN\n                horizontal_dir = 1 # Next horizontal sweep will be RIGHT\n\n        # If determined to move DOWN, check if at the bottom of the grid\n        if next_action == DOWN and current_y >= grid_height - 1:\n            # Cannot move down further, implies entire navigable map has been swept.\n            break\n        \n        # Execute the determined action\n        if next_action != -1:\n            actions.append(next_action)\n            env.step(next_action) # Perform the movement action\n            # The env._current_state is updated internally by env.step()\n            \n            # Immediately check inventory after any move, in case it was picked up implicitly\n            if env._current_state.inventory[primitive] > 0:\n                return actions\n        else:\n            # This case indicates a logic error in the sweep pattern or an unmovable state.\n            # Should not be reached if the map is fully traversable by these moves and within bounds.\n            break\n\n    return [] # Primitive not collected after exhausting exploration steps", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:27:29.388904", "function_name": "collect", "function_body": "    import collections\n\n    # Define constants for actions and directions\n    # These map to CraftState._DIRS and CraftLab actions\n    _DIRS = [(0, -1), (1, 0), (0, 1), (-1, 0)]  # N, E, S, W (dir 0, 1, 2, 3)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Get initial state information from the environment\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    current_pos = tuple(obs['features_dict']['pos'])  # Convert to tuple for hashing in set\n    current_dir = env._current_state.dir  # Get agent's current direction (0-3)\n\n    width, height, n_kinds = grid.shape\n\n    # Get non-grabbable indices to identify obstacles\n    # These are entities the agent cannot walk into\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    def is_blocked(x, y):\n        \"\"\"Checks if a cell (x, y) is blocked (out of bounds or contains non-grabbable item).\"\"\"\n        if not (0 <= x < width and 0 <= y < height):\n            return True  # Out of bounds\n\n        # Check if any non-grabbable item exists at (x, y)\n        for idx in non_grabbable_indices:\n            if grid[x, y, idx] == 1:\n                return True\n        return False\n\n    # BFS setup\n    # Queue stores (position_tuple, direction_int, path_list_of_actions)\n    queue = collections.deque([(current_pos, current_dir, [])])\n    # Visited set stores (position_tuple, direction_int) to avoid redundant explorations\n    visited = set([(current_pos, current_dir)])\n\n    while queue:\n        pos, d, path = queue.popleft()\n\n        # Check if the cell directly in front contains the primitive\n        # This is the target for the USE action\n        face_x = pos[0] + _DIRS[d][0]\n        face_y = pos[1] + _DIRS[d][1]\n\n        # If the cell in front is within bounds and contains the primitive\n        if (0 <= face_x < width and 0 <= face_y < height and\n                grid[face_x, face_y, primitive] == 1):\n            # Found the primitive and are facing it, append USE action and return path\n            return path + [ACTION_USE]\n\n        # Explore possible next states (move or turn actions)\n\n        # Action UP (move forward)\n        next_pos_up = (pos[0] + _DIRS[d][0], pos[1] + _DIRS[d][1])\n        if not is_blocked(next_pos_up[0], next_pos_up[1]):\n            if (next_pos_up, d) not in visited:\n                visited.add((next_pos_up, d))\n                queue.append((next_pos_up, d, path + [ACTION_UP]))\n\n        # Action DOWN (move backward)\n        next_pos_down = (pos[0] - _DIRS[d][0], pos[1] - _DIRS[d][1])\n        if not is_blocked(next_pos_down[0], next_pos_down[1]):\n            if (next_pos_down, d) not in visited:\n                visited.add((next_pos_down, d))\n                queue.append((next_pos_down, d, path + [ACTION_DOWN]))\n\n        # Action LEFT (turn left)\n        next_dir_left = (d - 1 + 4) % 4\n        if (pos, next_dir_left) not in visited:\n            visited.add((pos, next_dir_left))\n            queue.append((pos, next_dir_left, path + [ACTION_LEFT]))\n\n        # Action RIGHT (turn right)\n        next_dir_right = (d + 1) % 4\n        if (pos, next_dir_right) not in visited:\n            visited.add((pos, next_dir_right))\n            queue.append((pos, next_dir_right, path + [ACTION_RIGHT]))\n\n    # If the queue is exhausted and no path to collect was found, return empty list\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:27:29.458338", "function_name": "collect", "function_body": "    # Action constants as defined by CraftLab's action_specs (integers 0-4)\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n    _ALL_ACTIONS = [_DOWN, _UP, _LEFT, _RIGHT, _USE]\n\n    # Access the current internal state of the CraftLab environment\n    initial_craft_state = env._current_state\n\n    # 1. Check if the primitive is already collected in the initial state\n    if initial_craft_state.inventory[primitive] > 0:\n        return []\n\n    # Determine the maximum search depth for the Breadth-First Search (BFS)\n    # A reasonable default is used if the task's max_steps is not available.\n    _DEFAULT_MAX_SEARCH_DEPTH = 100\n    max_search_depth = _DEFAULT_MAX_SEARCH_DEPTH\n    if hasattr(env, 'task') and hasattr(env.task, 'steps'):\n        # Use a multiple of the task's max steps to allow for more extensive planning\n        max_search_depth = env.task.steps * 2 \n\n    # BFS setup\n    # The queue stores tuples of (current_simulated_state, path_to_this_state)\n    q = collections.deque()\n    q.append((initial_craft_state, []))\n\n    # The visited set stores hashable representations of states to avoid cycles\n    # A state is represented by (position_tuple, direction_integer, inventory_tuple)\n    # Inventory is converted to a tuple to make it hashable.\n    visited = set()\n    visited.add((initial_craft_state.pos, initial_craft_state.dir, tuple(initial_craft_state.inventory)))\n\n    while q:\n        current_sim_state, path_so_far = q.popleft()\n\n        # If the current path length exceeds the maximum allowed search depth,\n        # prune this branch to prevent overly long computations.\n        if len(path_so_far) >= max_search_depth:\n            continue\n\n        # Check if the primitive is collected in the current simulated state\n        if current_sim_state.inventory[primitive] > 0:\n            return path_so_far\n\n        # Explore all possible actions from the current state\n        for action in _ALL_ACTIONS:\n            # Simulate the action to get the next state.\n            # CraftState.step returns a new CraftState object, which is ideal for BFS.\n            _reward, next_sim_state = current_sim_state.step(action)\n\n            # Create a hashable representation of the next state\n            next_state_tuple = (next_sim_state.pos, next_sim_state.dir, tuple(next_sim_state.inventory))\n\n            # If this next state has not been visited before, add it to the queue\n            if next_state_tuple not in visited:\n                visited.add(next_state_tuple)\n                new_path = path_so_far + [action]\n                q.append((next_sim_state, new_path))\n\n    # If the BFS completes without finding a path to collect the primitive\n    # within the defined search limits, return an empty list.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:29:02.605559", "function_name": "collect", "function_body": "    state = env._current_state\n    \n    # Check if the primitive is already in inventory\n    if state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    grid = state.grid\n    width, height, n_kinds = grid.shape\n    current_pos = state.pos\n    current_dir = state.dir\n\n    # Find all locations on the grid where the primitive exists\n    primitive_item_locations = []\n    for r in range(width):\n        for c in range(height):\n            if grid[r, c, primitive] > 0:\n                primitive_item_locations.append((r, c))\n\n    if not primitive_item_locations:\n        # Primitive is not on the map, cannot be collected directly\n        return []\n\n    # Precompute all valid (agent_pos, agent_dir) states from which 'USE' would collect the primitive.\n    # A state (pos, dir) is a terminal state if calling USE from (pos, dir)\n    # would target a cell (r,c) where grid[r,c,primitive] > 0.\n    valid_terminal_states = set()\n    for target_r, target_c in primitive_item_locations:\n        for dir_val, (dr_face, dc_face) in DIR_TO_DELTA.items():\n            # Calculate agent's position if facing 'dir_val' to target_r, target_c\n            agent_r = target_r - dr_face\n            agent_c = target_c - dc_face\n            \n            # Check if this agent position is within grid boundaries\n            if 0 <= agent_r < width and 0 <= agent_c < height:\n                valid_terminal_states.add(((agent_r, agent_c), dir_val))\n\n    # BFS setup\n    # Queue stores tuples: (current_position_tuple, current_direction_int, list_of_actions_taken_to_reach_here)\n    q = collections.deque([(current_pos, current_dir, [])])\n    \n    # Visited set stores (position_tuple, direction_int) to avoid redundant exploration\n    visited = set([(current_pos, current_dir)])\n\n    # BFS loop\n    while q:\n        curr_pos, curr_dir, curr_path = q.popleft()\n        \n        # Check if the current state (position and direction) allows for a successful USE\n        if (curr_pos, curr_dir) in valid_terminal_states:\n            return curr_path + [USE]\n\n        # Explore movement actions\n        for action_val in MOVEMENT_ACTIONS:\n            # Determine new direction based on the movement action\n            new_dir = ACTION_TO_DIR_MAP[action_val]\n            \n            # Calculate new position based on the new direction (which is the direction of movement)\n            dr_move, dc_move = DIR_TO_DELTA[new_dir]\n            curr_r, curr_c = curr_pos\n            new_r, new_c = curr_r + dr_move, curr_c + dc_move\n            new_pos = (new_r, new_c)\n\n            # Check grid boundaries for the new position.\n            # Assuming all valid grid cells are traversable for movement.\n            if not (0 <= new_r < width and 0 <= new_c < height):\n                continue\n            \n            # Create a key for the new state (position and direction)\n            new_state_key = (new_pos, new_dir)\n\n            if new_state_key not in visited:\n                visited.add(new_state_key)\n                q.append((new_pos, new_dir, curr_path + [action_val]))\n\n    # If the queue becomes empty and no path to collect the primitive was found\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:29:02.677219", "function_name": "collect", "function_body": "    # Access current state of the CraftLab environment\n    # env._current_state is a CraftState object, which holds the current grid, position, etc.\n    current_state = env._current_state\n    grid = current_state.grid.copy()  # Get a copy of the grid for planning\n    initial_pos = current_state.pos  # Agent's starting position (row, col)\n    world = current_state.world      # Reference to the CraftWorld instance for environment properties\n\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # Get indices of impassable entities from the world's cookbook environment set.\n    # These are entities the agent cannot move into (e.g., water, boundaries).\n    impassable_indices = world.cookbook.environment\n\n    # 1. Find all occurrences of the target primitive on the grid\n    # np.argwhere returns a list of (row, col) coordinates where grid[r, c, primitive] is 1\n    primitive_coords = np.argwhere(grid[:, :, primitive] == 1)\n\n    if len(primitive_coords) == 0:\n        # The primitive is not found anywhere on the map\n        return []\n\n    # Find the closest primitive instance using Manhattan distance\n    def manhattan_distance(p1, p2):\n        return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n    target_pos = None\n    min_dist = float('inf')\n    for p_coord in primitive_coords:\n        dist = manhattan_distance(initial_pos, p_coord)\n        if dist < min_dist:\n            min_dist = dist\n            target_pos = tuple(p_coord)  # Convert to tuple for consistency\n\n    if target_pos is None:\n        # This case should theoretically not be reached if primitive_coords is not empty\n        return []\n\n    # Define movement actions and their corresponding (delta_row, delta_col)\n    # These actions also set the agent's facing direction.\n    # ACT_DOWN (0): moves (1,0), faces South (dir=2)\n    # ACT_UP (1): moves (-1,0), faces North (dir=0)\n    # ACT_LEFT (2): moves (0,-1), faces West (dir=3)\n    # ACT_RIGHT (3): moves (0,1), faces East (dir=1)\n    MOVE_ACTIONS = {\n        env_factory.ACT_DOWN: (1, 0),\n        env_factory.ACT_UP: (-1, 0),\n        env_factory.ACT_LEFT: (0, -1),\n        env_factory.ACT_RIGHT: (0, 1),\n    }\n\n    # 2. Pathfinding using Breadth-First Search (BFS)\n    # Queue stores (row, col, list_of_actions_to_reach_this_state)\n    q = collections.deque([(initial_pos[0], initial_pos[1], [])])\n    visited = set([(initial_pos[0], initial_pos[1])]) # Store (row, col) of visited cells\n\n    while q:\n        r, c, path = q.popleft()\n\n        # Check if the current position (r, c) is adjacent to the target_pos\n        # An agent can \"USE\" an item if it's in an adjacent cell and facing it.\n        # The game mechanics ensure that the last movement action sets the agent's\n        # direction correctly to face the cell it just moved *from* or *towards*.\n        # Specifically, moving to (r,c) sets the agent's direction in the direction of the move.\n        # If (r,c) is adjacent to target_pos, the agent's direction due to the last\n        # move action will naturally face the target_pos.\n        if manhattan_distance((r, c), target_pos) == 1:\n            # We have found a path to an adjacent cell.\n            # Append the USE action and return the full sequence.\n            return path + [env_factory.ACT_USE]\n\n        # Explore neighboring cells\n        for action, (dr, dc) in MOVE_ACTIONS.items():\n            nr, nc = r + dr, c + dc\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n                continue\n\n            # Check if the new position has already been visited\n            if (nr, nc) in visited:\n                continue\n\n            # Check if the new position is impassable (e.g., water, boundary)\n            is_impassable = False\n            for k in impassable_indices:\n                if grid[nr, nc, k] == 1: # If this cell contains an impassable entity\n                    is_impassable = True\n                    break\n            if is_impassable:\n                continue\n\n            # If the cell is valid and traversable, add it to the queue and mark as visited\n            visited.add((nr, nc))\n            q.append((nr, nc, path + [action]))\n\n    # If the BFS completes without finding a path to an adjacent primitive\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:30:45.049943", "function_name": "collect", "function_body": "    actions = []\n\n    # Action constants\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    MOVES = {\n        UP: (0, -1),\n        DOWN: (0, 1),\n        LEFT: (-1, 0),\n        RIGHT: (1, 0),\n    }\n\n    # Get current state information from the environment\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    # Ensure position is int tuple. CraftState.pos is tuple(int, int)\n    # The features_dict['pos'] might be normalized or float, so convert to int tuple.\n    current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n    \n    world = env.world\n    non_grabbable_indices = world.non_grabbable_indices\n    grabbable_indices = world.grabbable_indices\n    \n    W, H, K = grid.shape\n\n    # Determine if the primitive is grabbable or non-grabbable\n    is_grabbable = primitive in grabbable_indices\n    is_non_grabbable = primitive in non_grabbable_indices\n\n    # If the primitive is neither a grabbable item nor a non-grabbable entity,\n    # it's not something we can collect or interact with via 'USE' in this context.\n    if not is_grabbable and not is_non_grabbable:\n        return []\n\n    # 1. Determine traversable cells\n    # A cell is NOT traversable if it contains any non-grabbable item (obstacle).\n    traversable_mask = np.ones((W, H), dtype=bool)\n    if non_grabbable_indices: # Check if the set of non-grabbable indices is not empty\n        non_grabbable_list = list(non_grabbable_indices)\n        # Select slices for non-grabbable kinds, check for presence (>0), and then check if ANY are present along the kind axis (axis=2)\n        obstacles_present = np.any(grid[:, :, non_grabbable_list] > 0, axis=2)\n        # Invert the mask: where obstacles are present is not traversable, where not present is traversable\n        traversable_mask = ~obstacles_present\n    \n    # Ensure the agent's current position is marked as traversable.\n    # This should always be true for valid states.\n    if not traversable_mask[current_pos[0], current_pos[1]]:\n        return [] # Agent starts on an untraversable cell, no path possible.\n\n    # 2. Identify target cells for BFS based on primitive type\n    # For grabbable items, the agent needs to move onto the item's square.\n    # For non-grabbable items (like workshops), the agent needs to move to an adjacent traversable square.\n    bfs_target_cells = set()\n    primitive_locations = []\n\n    # First, find all locations where the primitive exists on the grid\n    for x in range(W):\n        for y in range(H):\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n    \n    if not primitive_locations:\n        return [] # Primitive not found anywhere on the grid\n\n    # Now, determine the actual BFS target cells based on item type\n    for px, py in primitive_locations:\n        if is_grabbable:\n            # If the primitive is grabbable, the agent needs to path directly to its location.\n            # Only add if the location itself is traversable (e.g., not water or stone).\n            if traversable_mask[px, py]:\n                bfs_target_cells.add((px, py))\n        elif is_non_grabbable:\n            # If the primitive is non-grabbable (e.g., a workshop), the agent must path to\n            # a traversable square adjacent to it.\n            for _, (dx, dy) in MOVES.items(): # Iterate through neighbor offsets\n                nx, ny = px + dx, py + dy\n                if (0 <= nx < W and 0 <= ny < H and\n                    traversable_mask[nx, ny]):\n                    bfs_target_cells.add((nx, ny))\n    \n    if not bfs_target_cells:\n        return [] # No reachable target cells (e.g., primitive is completely surrounded by obstacles)\n\n    # 3. Perform BFS to find the shortest path to any of the identified target cells\n    from collections import deque # Assuming deque is available in the execution environment as per collect_v0\n    q = deque([(current_pos, [])]) # (current_pos, path_so_far_actions)\n    visited = {current_pos}\n    \n    path_to_primitive_area = []\n\n    while q:\n        (curr_x, curr_y), actions_so_far = q.popleft()\n\n        # Check if the current position is one of our target cells\n        if (curr_x, curr_y) in bfs_target_cells:\n            path_to_primitive_area = actions_so_far\n            break # Found the shortest path to a primitive-related location\n\n        # Explore neighbors\n        for action, (dx, dy) in MOVES.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_pos = (next_x, next_y)\n\n            # Check bounds, traversability, and if already visited\n            if (0 <= next_x < W and 0 <= next_y < H and\n                traversable_mask[next_x, next_y] and\n                next_pos not in visited):\n                \n                visited.add(next_pos)\n                q.append((next_pos, actions_so_far + [action]))\n    \n    # If no path was found to any target cell, and the agent is not already on one, return empty list.\n    if not path_to_primitive_area and current_pos not in bfs_target_cells:\n        return [] \n    \n    # 4. Append the USE action after the movement path.\n    # If path_to_primitive_area is empty, it means the agent is already on a target square.\n    actions.extend(path_to_primitive_area)\n    actions.append(USE)\n    \n    return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:30:46.044114", "function_name": "collect", "function_body": "  import numpy as np\n  # Assuming collections.deque is imported at a higher level, consistent with collect_v0's usage.\n  from collections import deque # Re-adding this import as it's a critical dependency not shown in collect_v0's snippet\n\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  current_pos = tuple(obs['features_dict']['pos'].astype(int))\n  inventory = obs['features_dict']['inventory']\n  # Get initial direction of the agent (one-hot to int)\n  current_dir = np.argmax(obs['features_dict']['direction'])\n\n  # Improvement inherited from v1: If the primitive is already in inventory, no action needed.\n  if inventory[primitive] > 0:\n      return []\n\n  world = env.world\n  # non_grabbable_indices typically include obstacles like water, stone walls, workshops.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape\n\n  # Determine traversable cells more efficiently using NumPy operations.\n  # A cell is NOT traversable if it contains any non-grabbable item (obstacle).\n  if non_grabbable_indices: # Check if the set of non-grabbable indices is not empty\n      non_grabbable_list = list(non_grabbable_indices)\n      # Select slices for non-grabbable kinds, check for presence (>0), and then check if ANY are present along the kind axis (axis=2)\n      obstacles_present = np.any(grid[:, :, non_grabbable_list] > 0, axis=2)\n      # Invert the mask: where obstacles are present is not traversable, where not present is traversable\n      traversable_mask = ~obstacles_present\n  else:\n      # If there are no non-grabbable indices, all cells are traversable.\n      traversable_mask = np.ones((W, H), dtype=bool)\n  \n  # Ensure the agent's current position is marked as traversable.\n  # This should always be true for valid states.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] # Agent starts on an untraversable cell, no path possible.\n\n  # Action constants (from problem description context)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map action to (dx, dy) for movement\n  MOVES = {\n      UP: (0, -1),   # North\n      DOWN: (0, 1),  # South\n      LEFT: (-1, 0), # West\n      RIGHT: (1, 0), # East\n  }\n\n  # Map agent's direction (int 0-3) to (dx, dy) for the cell directly in front\n  # Assuming directions: 0=North, 1=East, 2=South, 3=West\n  DIR_OFFSETS = {\n      0: (0, -1), # North (UP)\n      1: (1, 0),  # East (RIGHT)\n      2: (0, 1),  # South (DOWN)\n      3: (-1, 0), # West (LEFT)\n  }\n\n  # BFS state: ((current_x, current_y), current_direction, path_so_far_actions)\n  q = deque([(current_pos, current_dir, [])])\n  # Visited set tracks (position, direction) pairs to avoid redundant exploration\n  visited = {(current_pos, current_dir)}\n  \n  while q:\n      (curr_x, curr_y), curr_d, actions_so_far = q.popleft()\n\n      # Check if we can USE the primitive from the current state (position + direction)\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dx, front_dy = DIR_OFFSETS[curr_d]\n      target_x, target_y = curr_x + front_dx, curr_y + front_dy\n\n      # Check if the cell in front is within bounds and contains the primitive\n      if (0 <= target_x < W and 0 <= target_y < H and\n          grid[target_x, target_y, primitive] > 0):\n          \n          # Found a valid state to USE the primitive\n          return actions_so_far + [USE] # Return the shortest path immediately\n\n      # Explore neighbors by performing movement actions\n      for action_move, (dx, dy) in MOVES.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_d = action_move # Moving in a direction typically sets the agent's facing direction to that direction\n\n          next_state = ((next_x, next_y), next_d)\n\n          # Check bounds, traversability of the new position, and if this specific (pos, dir) state has been visited\n          if (0 <= next_x < W and 0 <= next_y < H and\n              traversable_mask[next_x, next_y] and\n              next_state not in visited):\n              \n              visited.add(next_state)\n              q.append(((next_x, next_y), next_d, actions_so_far + [action_move]))\n  \n  # If BFS completes and no path was found (e.g., primitive is unreachable or doesn't exist), return empty list\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:32:19.110438", "function_name": "collect", "function_body": "    import collections\n\n    # Assuming constants for directions as defined in CraftWorld context\n    # N=0 (Up), E=1 (Right), S=2 (Down), W=3 (Left)\n    # These correspond to row/column changes and the new direction after the move.\n    # DR[direction] gives row change, DC[direction] gives col change\n    # Example: DR[0] = -1 (move up/North), DC[0] = 0\n    DR = [-1, 0, 1, 0] # Delta Row for N, E, S, W\n    DC = [0, 1, 0, -1] # Delta Col for N, E, S, W\n\n    current_state = env._current_state\n    grid = current_state.grid\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir\n    inventory = current_state.inventory\n    world = current_state.world # This is the CraftWorld instance\n\n    # 1. Check if the primitive is already collected\n    if inventory[primitive] > 0:\n        return []\n\n    # Get action mappings from the environment\n    actions = env.action_specs()\n    ACTION_MAP = {\n        actions[\"UP\"]:    (DR[0], DC[0], 0), # Move North (row-), agent faces North (dir=0)\n        actions[\"RIGHT\"]: (DR[1], DC[1], 1), # Move East (col+), agent faces East (dir=1)\n        actions[\"DOWN\"]:  (DR[2], DC[2], 2), # Move South (row+), agent faces South (dir=2)\n        actions[\"LEFT\"]:  (DR[3], DC[3], 3), # Move West (col-), agent faces West (dir=3)\n    }\n    USE_ACTION = actions[\"USE\"]\n\n    # Grid dimensions: grid.shape is (rows, columns, n_kinds)\n    HEIGHT, WIDTH, _ = grid.shape\n\n    # Helper function to check if a cell is traversable\n    # Assumes cells containing non-grabbable items are blocked.\n    def is_walkable(r, c):\n        if not (0 <= r < HEIGHT and 0 <= c < WIDTH):\n            return False # Out of bounds\n        # Check if the cell contains any non-grabbable entity.\n        # If so, it's considered not walkable.\n        for k_idx in world.non_grabbable_indices:\n            if grid[r, c, k_idx] > 0:\n                return False\n        return True\n\n    # BFS to find the shortest sequence of actions to collect the primitive.\n    # State in queue: (current_row, current_col, current_direction, list_of_actions_so_far)\n    # Visited set: (row, col, direction) to prevent cycles and redundant exploration\n    q = collections.deque([(initial_pos[0], initial_pos[1], initial_dir, [])])\n    visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n    final_path = None\n\n    while q:\n        r, c, d, path = q.popleft()\n\n        # Check if the current state allows using the primitive:\n        # The agent is at (r, c) facing direction 'd'.\n        # The 'USE' action targets the cell directly in front of the agent.\n        target_item_r, target_item_c = r + DR[d], c + DC[d]\n\n        # Ensure the target cell is within grid bounds\n        if 0 <= target_item_r < HEIGHT and 0 <= target_item_c < WIDTH:\n            # Check if the desired primitive is present in the target cell\n            if grid[target_item_r, target_item_c, primitive] > 0:\n                final_path = path + [USE_ACTION]\n                break # Path found, exit BFS\n\n        # Explore possible movement actions\n        for action, (dr_move, dc_move, new_d) in ACTION_MAP.items():\n            next_r, next_c = r + dr_move, c + dc_move\n\n            # Only add to queue if the next cell is walkable and this specific\n            # (position, direction) state has not been visited before.\n            if is_walkable(next_r, next_c) and (next_r, next_c, new_d) not in visited:\n                q.append((next_r, next_c, new_d, path + [action]))\n                visited.add((next_r, next_c, new_d))\n\n    if final_path:\n        return final_path\n    else:\n        # Primitive was not found or is unreachable based on current grid and rules.\n        return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:32:19.188836", "function_name": "collect", "function_body": "    _DOWN, _UP, _LEFT, _RIGHT, _USE = 0, 1, 2, 3, 4 # Actions from CraftWorld/CraftLab\n\n    actions = []\n\n    # Get initial observation\n    obs = env.observations()\n    inventory = obs['features_dict']['inventory']\n\n    # 1. Check if primitive is already in inventory\n    if inventory[primitive] > 0:\n        return actions # Already collected\n\n    grid = obs['features_dict']['features_global']\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n\n    # 2. Find the target primitive's location on the grid\n    target_coords = None\n    # Iterate grid to find any instance of the primitive.\n    # Prioritize the first one found (e.g., top-leftmost).\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] == 1:\n                target_coords = (x, y)\n                break\n        if target_coords:\n            break\n\n    if target_coords is None:\n        # Primitive not found on the map, no actions can be taken to collect it.\n        return []\n\n    # Pathfinding and collection loop\n    # A generous upper bound for simple traversal to prevent infinite loops\n    # in case of unreachable target or getting stuck.\n    max_movement_steps = 2 * (WIDTH + HEIGHT) \n    steps_taken = 0\n\n    while steps_taken < max_movement_steps:\n        # Get current state observations (grid, position, inventory, ego view)\n        obs = env.observations()\n        current_inventory = obs['features_dict']['inventory']\n\n        # Check if the primitive has been collected during a previous step of this loop\n        if current_inventory[primitive] > 0:\n            return actions\n\n        # Convert normalized agent position to grid coordinates (0 to WIDTH-1, 0 to HEIGHT-1)\n        agent_pos_norm = obs['features_dict']['pos']\n        cx = int(round(agent_pos_norm[0] * (WIDTH - 1)))\n        cy = int(round(agent_pos_norm[1] * (HEIGHT - 1)))\n\n        tx, ty = target_coords\n\n        # Check if next to the primitive (including on the same cell),\n        # based on `CraftState.next_to` documentation \"any cell in the 3x3 neighborhood\".\n        features_ego = obs['features_dict']['features_ego']\n        is_next_to_primitive = np.any(features_ego[:, :, primitive] == 1)\n\n        if is_next_to_primitive:\n            # Agent is adjacent to or on the primitive, attempt to use (collect) it.\n            _, _, new_obs = env.step(_USE)\n            actions.append(_USE)\n            \n            # Check if collection was successful after the USE action.\n            if new_obs['features_dict']['inventory'][primitive] > 0:\n                return actions # Successfully collected!\n            else:\n                # If USE action did not result in collection (e.g., primitive is ungrabbable\n                # or requires multiple uses, or specific facing direction).\n                # For `collect_v2`, we consider this a best effort and return the actions taken so far.\n                return actions\n\n        # If not next to the primitive, move towards it using a simple greedy strategy (X then Y).\n        action_performed_in_step = False\n        if cx < tx:\n            _, _, _ = env.step(_RIGHT)\n            actions.append(_RIGHT)\n            action_performed_in_step = True\n        elif cx > tx:\n            _, _, _ = env.step(_LEFT)\n            actions.append(_LEFT)\n            action_performed_in_step = True\n        elif cy < ty: # Only move Y if X is aligned or after X movement\n            _, _, _ = env.step(_DOWN)\n            actions.append(_DOWN)\n            action_performed_in_step = True\n        elif cy > ty: # Only move Y if X is aligned or after X movement\n            _, _, _ = env.step(_UP)\n            actions.append(_UP)\n            action_performed_in_step = True\n\n        if not action_performed_in_step:\n            # If the agent is at the target coordinates (cx == tx and cy == ty)\n            # but couldn't collect (e.g., USE failed above, or primitive is an obstacle,\n            # and thus not considered \"next to\" in a way that allows collection).\n            # This indicates no further progress can be made by moving or using at this spot.\n            # Break the loop to avoid an infinite loop.\n            break\n\n        steps_taken += 1\n\n    # Return the sequence of actions taken, even if the collection was not successful\n    # (e.g., max_steps reached, or primitive uncollectable).\n    return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:33:47.370323", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action constants (from problem description context)\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Map movement action values to (dx, dy) deltas\n  # (dx, dy) represents how the agent's position changes\n  MOVEMENT_DELTAS = {\n      UP_ACTION: (0, -1),   # Moving North\n      DOWN_ACTION: (0, 1),  # Moving South\n      LEFT_ACTION: (-1, 0), # Moving West\n      RIGHT_ACTION: (1, 0), # Moving East\n  }\n\n  # Map movement action values to the resulting agent direction (0=N, 1=E, 2=S, 3=W)\n  # Taking a movement action makes the agent face that direction.\n  ACTION_TO_NEW_DIRECTION = {\n      UP_ACTION: 0,    # UP action results in facing North (direction 0)\n      RIGHT_ACTION: 1, # RIGHT action results in facing East (direction 1)\n      DOWN_ACTION: 2,  # DOWN action results in facing South (direction 2)\n      LEFT_ACTION: 3,  # LEFT action results in facing West (direction 3)\n  }\n  \n  # Map agent direction to (dx, dy) for the cell directly in front of the agent\n  # This is crucial for determining where the USE action would apply.\n  DIRECTION_TO_FACING_DELTA = {\n      0: (0, -1),  # North (agent faces up)\n      1: (1, 0),   # East (agent faces right)\n      2: (0, 1),   # South (agent faces down)\n      3: (-1, 0),  # West (agent faces left)\n  }\n\n  def _get_primitive_source_indices(primitive_item_idx: int, world) -> set[int]:\n    \"\"\"\n    Returns a set of grid indices that, when present in the cell directly in front\n    of the agent, allow the collection of `primitive_item_idx` via the USE action.\n    This includes the item itself (for direct pickup if it's an item on the ground)\n    and specific blocks (for harvesting, e.g., 'water' from 'water_block').\n    \"\"\"\n    source_indices = {primitive_item_idx} # Always include the item's own index for direct pickup\n\n    item_name = world.cookbook.index.get(primitive_item_idx)\n    if item_name == 'water':\n        # Check if water_index exists on world object, as it might not always be defined.\n        if hasattr(world, 'water_index'): \n            source_indices.add(world.water_index) # Add water block index for harvesting water\n    elif item_name == 'stone':\n        if hasattr(world, 'stone_index'):\n            source_indices.add(world.stone_index) # Add stone block index for harvesting stone\n    # Extend this logic for other harvestable primitives if needed, e.g., 'wood' from 'tree'\n    # if item_name == 'wood':\n    #     if hasattr(world, 'tree_index'):\n    #         source_indices.add(world.tree_index)\n            \n    return source_indices\n\n  # --- Start of main collect_v2 logic ---\n  \n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Convert position numpy array to tuple for hashing in sets/dictionaries.\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  # Current direction is a one-hot array, convert to an integer (0=N, 1=E, 2=S, 3=W)\n  current_dir = np.argmax(obs['features_dict']['direction'])\n  \n  world = env.world\n  # non_grabbable_indices are assumed to be obstacles that cannot be traversed by the agent.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape # Grid dimensions\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for x in range(W):\n      for y in range(H):\n          if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n              traversable_mask[x, y] = False\n  \n  # If the agent starts on an untraversable cell, no path is possible.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return [] \n\n  # 2. Identify all (agent_pos, agent_dir) states from which the USE action is possible.\n  # These are the states where the cell directly in front of the agent contains a source of the primitive.\n  target_pickup_states = set() # Stores elements as ((agent_x, agent_y), agent_direction)\n\n  primitive_source_indices = _get_primitive_source_indices(primitive, world)\n\n  # Iterate through every possible agent position on the grid\n  for x in range(W):\n      for y in range(H):\n          if not traversable_mask[x, y]: # Agent must be on a traversable cell to potentially USE an item\n              continue\n          \n          # For each traversable agent position, iterate through all 4 possible facing directions\n          for agent_dir in range(4): \n              dx_fwd, dy_fwd = DIRECTION_TO_FACING_DELTA[agent_dir] # Delta for the cell in front\n              faced_x, faced_y = x + dx_fwd, y + dy_fwd\n\n              # Check if the cell being faced is within grid bounds\n              if not (0 <= faced_x < W and 0 <= faced_y < H):\n                  continue\n              \n              # Check if the faced cell contains any of the identified primitive source kinds\n              if any(grid[faced_x, faced_y, source_idx] > 0 for source_idx in primitive_source_indices):\n                  target_pickup_states.add(((x, y), agent_dir))\n  \n  # If no valid pickup states are found anywhere on the map, the primitive is unreachable.\n  if not target_pickup_states:\n      return [] \n\n  # 3. Perform a Breadth-First Search (BFS) to find the shortest sequence of actions\n  #    to reach any of the `target_pickup_states`.\n  # Queue stores (current_position_tuple, current_direction_int, list_of_actions_so_far)\n  q = deque([(current_pos, current_dir, [])])\n  \n  # Visited states are (position_tuple, direction_integer) to prevent redundant exploration and cycles.\n  visited = {(current_pos, current_dir)} \n\n  while q:\n      curr_pos, curr_dir, path_so_far = q.popleft()\n\n      # If the current agent state (position and direction) is one of our target pickup states,\n      # we have found the shortest path.\n      if (curr_pos, curr_dir) in target_pickup_states:\n          return path_so_far + [USE_ACTION] # Append the USE action and return the full path\n\n      # Explore possible actions (movement, which also implicitly handles turning)\n      for action_val, (dx, dy) in MOVEMENT_DELTAS.items():\n          next_pos_x, next_pos_y = curr_pos[0] + dx, curr_pos[1] + dy\n          # The agent's direction changes to match the direction of the movement action.\n          next_dir = ACTION_TO_NEW_DIRECTION[action_val] \n\n          next_pos = (next_pos_x, next_pos_y)\n\n          # Case 1: The agent attempts to move to a new, traversable cell.\n          if (0 <= next_pos_x < W and 0 <= next_pos_y < H and\n              traversable_mask[next_pos_x, next_pos_y]):\n              \n              if (next_pos, next_dir) not in visited:\n                  visited.add((next_pos, next_dir))\n                  q.append((next_pos, next_dir, path_so_far + [action_val]))\n          \n          # Case 2: The agent attempts to move into a blocked (non-traversable) cell.\n          # In CraftWorld, if a movement action is blocked, the agent stays in its current\n          # position but still changes its facing direction. This effectively acts as a\n          # \"turn in place\" action, which is important for reaching desired facing directions.\n          else: \n              # The agent stays at curr_pos but its direction becomes next_dir.\n              # Only add this new state if it hasn't been visited before.\n              if (curr_pos, next_dir) not in visited:\n                  visited.add((curr_pos, next_dir))\n                  q.append((curr_pos, next_dir, path_so_far + [action_val]))\n\n  return [] # If the queue becomes empty and no target state was reached, the primitive is unreachable.", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T11:33:47.440287", "function_name": "collect", "function_body": "    from collections import deque\n    import numpy as np\n\n    # --- Constants and Mappings ---\n    DOWN_ACTION = 0\n    UP_ACTION = 1\n    LEFT_ACTION = 2\n    RIGHT_ACTION = 3\n    USE_ACTION = 4\n\n    # (dx, dy) for moving relative to agent's current position\n    # Assumes (0,-1) is North/Up, (0,1) is South/Down, etc.\n    MOVEMENT_DELTAS = {\n        UP_ACTION: (0, -1),\n        DOWN_ACTION: (0, 1),\n        LEFT_ACTION: (-1, 0),\n        RIGHT_ACTION: (1, 0),\n    }\n\n    # Map movement action to the direction the agent will face after the action\n    # Assuming directions are 0:N, 1:E, 2:S, 3:W\n    ACTION_TO_DIRECTION = {\n        UP_ACTION: 0,\n        RIGHT_ACTION: 1,\n        DOWN_ACTION: 2,\n        LEFT_ACTION: 3,\n    }\n\n    # Map (dx, dy) from agent to target cell to the required agent direction\n    # e.g., if item is at (agent_x, agent_y+1), agent needs to face SOUTH (2)\n    RELATIVE_POS_TO_DIRECTION = {\n        (0, -1): 0, # Target is North of agent -> agent faces North (0)\n        (1, 0): 1,  # Target is East of agent -> agent faces East (1)\n        (0, 1): 2,  # Target is South of agent -> agent faces South (2)\n        (-1, 0): 3, # Target is West of agent -> agent faces West (3)\n    }\n\n    # --- Helper Functions ---\n    def _get_primitive_source_indices(primitive_item_idx: int, world) -> set[int]:\n        \"\"\"\n        Returns a set of grid indices that, when present in a cell,\n        indicate that the cell can be 'used' to obtain `primitive_item_idx`.\n        This includes the primitive item's own index (for direct pickup) and\n        specific block indices (for harvesting, e.g., water block for water).\n        \"\"\"\n        source_indices = {primitive_item_idx} # Always include the item's own index for direct pickup\n\n        item_name = world.cookbook.index.get(primitive_item_idx)\n        if item_name == 'water' and hasattr(world, 'water_index'):\n            source_indices.add(world.water_index)\n        elif item_name == 'stone' and hasattr(world, 'stone_index'):\n            source_indices.add(world.stone_index)\n        # Extend this logic for other primitive sources if needed (e.g., 'wood' from 'tree' blocks)\n        return source_indices\n\n    # --- Initialize State and Environment Information ---\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    # Ensure position is an int tuple for hashing\n    current_pos = tuple(obs['features_dict']['pos'].astype(int))\n    # Current direction is a one-hot array, convert to an integer\n    current_dir = np.argmax(obs['features_dict']['direction'])\n\n    world = env.world\n    # non_grabbable_indices are assumed to be obstacles that cannot be traversed.\n    non_grabbable_indices = world.non_grabbable_indices\n\n    W, H, _ = grid.shape # Grid dimensions\n\n    # --- 1. Determine Traversable Cells ---\n    # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n    traversable_mask = np.ones((W, H), dtype=bool)\n    for x in range(W):\n        for y in range(H):\n            if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n                traversable_mask[x, y] = False\n\n    # Agent must start on a traversable cell.\n    if not traversable_mask[current_pos[0], current_pos[1]]:\n        return [] # Cannot start from an untraversable position\n\n    # --- 2. Identify all grid cells that are a source of the primitive ---\n    # These are the (x, y) coordinates of the target items or source blocks to be 'USE'd.\n    primitive_source_indices = _get_primitive_source_indices(primitive, world)\n    target_primitive_locations = set() # Stores (x, y) coordinates of source cells\n\n    for x in range(W):\n        for y in range(H):\n            # Check if any of the primitive's source kinds are present in this cell\n            if any(grid[x, y, idx] > 0 for idx in primitive_source_indices):\n                target_primitive_locations.add((x, y))\n\n    if not target_primitive_locations:\n        return [] # No target item or source block found anywhere on the grid\n\n    # --- 3. Determine all (agent_pos, agent_dir) states from which USE is possible ---\n    # These are the goal states for our BFS.\n    target_pickup_states = set() # Stores ((agent_x, agent_y), required_agent_dir)\n\n    for target_x, target_y in target_primitive_locations:\n        # Check the 4 cardinal neighbors around the target cell as potential agent positions\n        # (dx_agent_rel_target, dy_agent_rel_target) represents the agent's position\n        # relative to the target item/block.\n        for dx_agent_rel_target, dy_agent_rel_target in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            # Calculate the agent's potential position\n            agent_x, agent_y = target_x + dx_agent_rel_target, target_y + dy_agent_rel_target\n            agent_pos = (agent_x, agent_y)\n\n            # Ensure agent's potential position is in bounds and traversable\n            if (0 <= agent_x < W and 0 <= agent_y < H and\n                traversable_mask[agent_x, agent_y]):\n\n                # Calculate the direction the agent needs to face from `agent_pos` to `target_pos`\n                # The item/block's relative position from the agent is (target_x - agent_x, target_y - agent_y).\n                relative_vector_from_agent_to_target = (target_x - agent_x, target_y - agent_y)\n                required_dir = RELATIVE_POS_TO_DIRECTION.get(relative_vector_from_agent_to_target)\n\n                if required_dir is not None:\n                    target_pickup_states.add((agent_pos, required_dir))\n\n    if not target_pickup_states:\n        return [] # No reachable (agent_pos, agent_dir) states from which to USE the item/block\n\n    # --- 4. Perform BFS to find the shortest sequence of actions ---\n    # BFS State: (current_x, current_y, current_direction)\n    # Queue stores: (curr_x, curr_y, curr_dir, path_actions_so_far)\n    q = deque([(current_pos[0], current_pos[1], current_dir, [])])\n    # Visited states: (position_x, position_y, direction_integer) to prevent redundant exploration\n    visited = {(current_pos[0], current_pos[1], current_dir)}\n\n    while q:\n        curr_x, curr_y, curr_dir, path_so_far = q.popleft()\n        curr_pos_tuple = (curr_x, curr_y)\n\n        # Check if the current (position, direction) state allows for collection (i.e., is a target state)\n        if (curr_pos_tuple, curr_dir) in target_pickup_states:\n            return path_so_far + [USE_ACTION] # Path found, append USE action and return\n\n        # Explore all possible movement actions (which also implicitly change direction)\n        for action_val, (dx, dy) in MOVEMENT_DELTAS.items():\n            potential_next_x, potential_next_y = curr_x + dx, curr_y + dy\n            next_dir = ACTION_TO_DIRECTION[action_val] # Agent will face this direction after the action\n\n            next_pos_tuple = curr_pos_tuple # Default: agent stays in place if move is blocked\n\n            # Check if the intended move is within grid bounds and to a traversable cell\n            if (0 <= potential_next_x < W and 0 <= potential_next_y < H and\n                traversable_mask[potential_next_x, potential_next_y]):\n                next_pos_tuple = (potential_next_x, potential_next_y) # Agent successfully moves\n\n            next_state_tuple = (next_pos_tuple[0], next_pos_tuple[1], next_dir)\n\n            if next_state_tuple not in visited:\n                visited.add(next_state_tuple)\n                q.append((next_state_tuple[0], next_state_tuple[1], next_state_tuple[2], path_so_far + [action_val]))\n\n    return [] # No path found to a pickup spot", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T11:34:44.543371", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  DIR_VEC = {\n      0: (0, -1),  # UP (dx, dy)\n      1: (1, 0),   # RIGHT\n      2: (0, 1),   # DOWN\n      3: (-1, 0)   # LEFT\n  }\n\n  # Pre-check: If the primitive is not a grabbable item, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get the initial state details for the BFS starting point\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Identify indices of entities that block movement (obstacles).\n  # This includes non-grabbable items and typically workshops.\n  all_blocking_indices = set(env.world.non_grabbable_indices)\n  if hasattr(env.world, 'workshop_indices'):\n      all_blocking_indices.update(env.world.workshop_indices)\n\n  # Helper function to determine if a cell is traversable.\n  def is_walkable(x, y):\n    # Check if the coordinates are within grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell contains any blocking item.\n    for k_idx in all_blocking_indices:\n      if grid[x, y, k_idx] == 1:\n        return False # Cell is blocked by an obstacle\n    return True\n\n  # Initialize Breadth-First Search (BFS)\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n  # Using collections.deque for efficient queue operations (popleft).\n  import collections # This import must be here as per instructions\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Set to keep track of visited states (position and direction) to avoid cycles and redundant paths.\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft() # Dequeue the current state\n\n    # Check if the primitive can be collected from the current state.\n    # The 'USE' action affects the cell directly in front of the agent.\n    faced_dx, faced_dy = DIR_VEC[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # If the cell in front is within bounds and contains the target primitive:\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Goal reached! Return the accumulated path actions plus the final 'USE' action.\n      return path_actions + [ACTION_USE]\n\n    # Explore all possible movement actions from the current state.\n    # Each movement action also sets the agent's new facing direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new position after performing this action.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # The agent's new facing direction\n\n      # If the next cell is walkable and this new (position, direction) state has not been visited yet:\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        # Enqueue the new state with its path.\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the BFS completes and no path to collect the primitive is found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T11:34:45.536231", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Define properties for movement actions: (dx, dy, new_facing_direction)\n  # When an agent moves, its facing direction also updates to the direction of movement.\n  MOVE_ACTIONS_PROPERTIES = {\n      ACTION_UP: (0, -1, 0),    # Move UP (new dir 0:UP)\n      ACTION_RIGHT: (1, 0, 1),  # Move RIGHT (new dir 1:RIGHT)\n      ACTION_DOWN: (0, 1, 2),   # Move DOWN (new dir 2:DOWN)\n      ACTION_LEFT: (-1, 0, 3),  # Move LEFT (new dir 3:LEFT)\n  }\n\n  # Define the (dx, dy) vector for each facing direction. This vector indicates\n  # the cell directly in front of the agent, which is targeted by ACTION_USE.\n  DIR_TO_FACED_CELL_OFFSET = {\n      0: (0, -1),  # Facing UP, cell in front is (x, y-1)\n      1: (1, 0),   # Facing RIGHT, cell in front is (x+1, y)\n      2: (0, 1),   # Facing DOWN, cell in front is (x, y+1)\n      3: (-1, 0)   # Facing LEFT, cell in front is (x-1, y)\n  }\n\n  # Pre-check: If the primitive is not a grabbable item, it cannot be \"collected\".\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get initial state details from the environment's internal state\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Get the set of indices for non-grabbable entities (obstacles that block movement)\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  # Helper function to check if a grid cell is within bounds and not occupied by an obstacle.\n  def is_walkable(x, y):\n    # Check if the coordinates are within grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    \n    # Check if the cell contains any non-grabbable item that acts as an obstacle.\n    for k_idx in non_grabbable_kinds:\n      if grid[x, y, k_idx] == 1: # Assuming 1 indicates presence of the kind\n        return False # Cell is blocked by an obstacle\n    return True\n\n  # Initialize Breadth-First Search (BFS) using collections.deque for efficient operations.\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_taken)\n  queue = collections.deque([(start_x, start_y, start_dir, [])])\n\n  # Visited set to avoid redundant exploration and cycles.\n  # A state is uniquely identified by (x, y, direction) because direction influences the 'USE' action.\n  visited = set([(start_x, start_y, start_dir)])\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft() # Dequeue the current state\n\n    # Check if the primitive can be collected from the current state.\n    # This means the primitive must be in the cell directly in front of the agent.\n    faced_dx, faced_dy = DIR_TO_FACED_CELL_OFFSET[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # If the cell in front is within grid bounds and contains the target primitive:\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Goal reached! Return the accumulated path actions plus the final 'USE' action.\n      return path_actions + [ACTION_USE]\n\n    # Explore all possible movement actions from the current state.\n    # Each movement action results in a new position and an updated facing direction.\n    for action, (move_dx, move_dy, next_dir) in MOVE_ACTIONS_PROPERTIES.items():\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n\n      # If the next cell is walkable and this new (position, direction) state has not been visited yet:\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        # Enqueue the new state with its accumulated path.\n        queue.append((next_x, next_y, next_dir, path_actions + [action]))\n\n  # If the BFS completes and no path to collect the primitive is found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T11:36:14.821589", "function_name": "collect", "function_body": "    collected_actions = []\n    max_steps = 200 # Arbitrary maximum steps to prevent infinite loops\n\n    # Reset the environment to get the initial observation.\n    # We ignore the initial observation as we'll query state via _current_state.\n    env.reset()\n\n    for step_count in range(max_steps):\n        # Access the current CraftState instance from the CraftLab environment\n        # This gives us direct access to grid, pos, inventory, and next_to method.\n        craft_state = env._current_state\n\n        # Check if the primitive is already in inventory\n        if craft_state.inventory[primitive] > 0:\n            return collected_actions # Goal achieved\n\n        # Check if the primitive is in the agent's immediate 3x3 neighborhood.\n        # This typically includes cells adjacent and potentially the cell the agent is on.\n        if craft_state.next_to(primitive):\n            # If next to it, use the 'USE' action to collect it\n            action = env_factory.USE\n            reward, done, _ = env.step(action)\n            collected_actions.append(action)\n            # After using, check again if collected. If not, maybe it needs multiple uses or is an obstacle.\n            if craft_state.inventory[primitive] > 0:\n                return collected_actions\n            if done:\n                # Episode ended for some reason (e.g., max_steps of scenario reached)\n                return collected_actions\n            continue # Try another action in the next step (could be another USE or move if it didn't work)\n\n        # If not next to the primitive, find its location on the global grid\n        current_pos = craft_state.pos # Agent's current (row, col)\n        global_grid = craft_state.grid # Full grid (height, width, n_kinds)\n\n        # Find all cells that contain the target primitive\n        # np.where returns (array_of_rows, array_of_cols)\n        primitive_y_coords, primitive_x_coords = np.where(global_grid[:, :, primitive] > 0)\n        \n        target_primitive_locations = []\n        for i in range(len(primitive_y_coords)):\n            target_primitive_locations.append((primitive_y_coords[i], primitive_x_coords[i]))\n\n        if not target_primitive_locations:\n            # Primitive not found on the map or all instances have been collected.\n            # In this case, we can't collect it. Return current actions, or try a random walk\n            # as a last resort exploration.\n            action = np.random.choice([env_factory.UP, env_factory.DOWN, env_factory.LEFT, env_factory.RIGHT])\n            reward, done, _ = env.step(action)\n            collected_actions.append(action)\n            if done:\n                return collected_actions\n            continue\n\n        # Find the closest primitive location using Manhattan distance\n        min_dist = float('inf')\n        closest_primitive_loc = None\n        for p_loc in target_primitive_locations:\n            dist = abs(p_loc[0] - current_pos[0]) + abs(p_loc[1] - current_pos[1])\n            if dist < min_dist:\n                min_dist = dist\n                closest_primitive_loc = p_loc\n\n        # Determine the next action to move towards the closest primitive\n        target_y, target_x = closest_primitive_loc\n        current_y, current_x = current_pos\n\n        action_to_take = None\n        # Prioritize movement along the larger difference (either vertical or horizontal)\n        if abs(target_y - current_y) > abs(target_x - current_x):\n            if target_y > current_y:\n                action_to_take = env_factory.DOWN\n            elif target_y < current_y:\n                action_to_take = env_factory.UP\n        else: # abs(target_x - current_x) >= abs(target_y - current_y)\n            if target_x > current_x:\n                action_to_take = env_factory.RIGHT\n            elif target_x < current_x:\n                action_to_take = env_factory.LEFT\n        \n        # If action_to_take is still None, it means current_pos == closest_primitive_loc.\n        # This implies the agent is on the target cell. If 'next_to' didn't trigger 'USE'\n        # in the earlier block, it means either the primitive cannot be 'USE'd from here\n        # (e.g., it's a non-grabbable entity, or the agent is stuck).\n        # In such a case, take a random exploratory step.\n        if action_to_take is None:\n            action_to_take = np.random.choice([env_factory.UP, env_factory.DOWN, env_factory.LEFT, env_factory.RIGHT])\n\n\n        # Perform the chosen movement action\n        reward, done, _ = env.step(action_to_take)\n        collected_actions.append(action_to_take)\n\n        if done: # If the episode is over (e.g., max_steps of scenario reached)\n            return collected_actions\n\n    # If max_steps of this collection function is reached and the primitive is still not collected\n    return collected_actions", "island_id": 3, "scores": {"3": -1}}
