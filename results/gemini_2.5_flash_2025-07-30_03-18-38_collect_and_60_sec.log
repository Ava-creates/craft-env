{"timestamp": "2025-07-30T20:53:27.809465", "function_name": "collect", "function_body": "    actions = []\n    \n    # Reset environment to get initial observations and state\n    obs = env.reset()\n    \n    # Max steps to prevent infinite loop, adjust as needed for typical map sizes\n    max_steps_per_attempt = 200 \n    \n    # Get current inventory from initial observations\n    current_inventory = obs['features_dict']['inventory']\n    \n    # Early exit if primitive is already collected\n    if current_inventory[primitive] > 0:\n        return actions\n\n    # Check if the primitive is grabbable. If not, it cannot be collected using the 'USE' action.\n    # env.world.grabbable_indices stores the indices of items that can be picked up.\n    if primitive not in env.world.grabbable_indices:\n        # If the primitive is not grabbable, this function cannot fulfill its purpose.\n        return actions \n\n    for _ in range(max_steps_per_attempt):\n        # Update observations after each step taken in the loop\n        obs = env.observations()\n        current_grid = obs['features_dict']['features_global']\n        current_pos_np = obs['features_dict']['pos'] # Agent's position as a numpy array [x, y]\n        current_pos = (int(current_pos_np[0]), int(current_pos_np[1])) # Convert to tuple (x, y)\n        current_inventory = obs['features_dict']['inventory']\n\n        # Check if primitive is collected after the last action\n        if current_inventory[primitive] > 0:\n            return actions\n\n        agent_x, agent_y = current_pos\n        grid_width, grid_height, _ = current_grid.shape\n\n        # 1. Check if the primitive is in the 3x3 neighborhood (adjacent)\n        is_adjacent = False\n        \n        # Iterate over 3x3 neighborhood (dx, dy from -1 to 1, excluding agent's own cell at 0,0)\n        for dx in [-1, 0, 1]:\n            for dy in [-1, 0, 1]:\n                if dx == 0 and dy == 0:\n                    continue # Skip agent's current position, as 'USE' typically acts on adjacent cells\n\n                nx, ny = agent_x + dx, agent_y + dy\n                \n                # Check if the neighbor cell is within grid boundaries\n                if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                    # Check if the primitive exists at this neighbor cell's layer\n                    if current_grid[nx, ny, primitive] > 0:\n                        is_adjacent = True\n                        break # Found an adjacent primitive, no need to check further neighbors\n            if is_adjacent:\n                break # Break outer loop too if an adjacent primitive is found\n\n        if is_adjacent:\n            # If a primitive is adjacent and grabbable (checked earlier), perform the USE action.\n            # The action value for 'USE' is 4, as per CraftLab.action_specs().\n            _, _, _ = env.step(4) # Perform USE action\n            actions.append(4) # Record the action\n            # The loop will re-check inventory on the next iteration to confirm collection.\n        else:\n            # 2. Primitive is not immediately adjacent. Search the global map and move towards it.\n            # np.argwhere returns an array of (x, y) coordinates where current_grid[x, y, primitive] is > 0.\n            primitive_locations = np.argwhere(current_grid[:, :, primitive] > 0)\n            \n            if len(primitive_locations) > 0:\n                # If there are multiple instances of the primitive, move towards the closest one\n                # using Manhattan distance (abs(dx) + abs(dy)).\n                closest_target_pos = None\n                min_dist = float('inf')\n\n                for p_loc in primitive_locations:\n                    px, py = p_loc[0], p_loc[1] # p_loc is (x, y)\n                    dist = abs(px - agent_x) + abs(py - agent_y)\n                    if dist < min_dist:\n                        min_dist = dist\n                        closest_target_pos = (px, py)\n                \n                if closest_target_pos:\n                    tx, ty = closest_target_pos\n                    \n                    action_to_take = -1 # Sentinel for no action determined yet\n                    \n                    # Calculate differences in coordinates\n                    dx = tx - agent_x\n                    dy = ty - agent_y\n\n                    # If the agent is not already at the target cell (distance > 0)\n                    if dx != 0 or dy != 0:\n                        # Prioritize movement along the axis with the larger distance to cover.\n                        # This strategy helps in taking more direct L-shaped paths.\n                        if abs(dx) >= abs(dy): # Prefer horizontal movement (RIGHT/LEFT)\n                            if dx > 0:\n                                action_to_take = 3 # RIGHT action (from action_specs)\n                            else:\n                                action_to_take = 2 # LEFT action (from action_specs)\n                        else: # Prefer vertical movement (DOWN/UP)\n                            if dy > 0:\n                                action_to_take = 0 # DOWN action (from action_specs)\n                            else:\n                                action_to_take = 1 # UP action (from action_specs)\n                    else:\n                        # This case means the agent is on the same cell as the primitive.\n                        # As `is_adjacent` checks cells *around* the agent (excluding self),\n                        # an item on the same cell cannot be picked up with the 'USE' action.\n                        # If a primitive is only collectible when adjacent, and the agent is on it,\n                        # it implies it's currently uncollectible by this mechanism.\n                        break # Break loop, as further movement won't help for this item\n\n                    if action_to_take != -1:\n                        _, _, _ = env.step(action_to_take) # Perform the determined movement action\n                        actions.append(action_to_take) # Record the action\n                    else:\n                        # Should only be reached if dx=0 and dy=0 and the break condition above is met.\n                        break # No action was taken, indicating a state where progress is stalled.\n                else:\n                    # This branch should logically not be reached if primitive_locations is not empty.\n                    # It would indicate an issue with finding the closest target.\n                    break \n            else:\n                # Primitive not found anywhere on the current_grid (all values are zero for that primitive's layer).\n                # This indicates that the primitive is not present in the environment for collection.\n                return actions # Return current actions (likely empty), as primitive cannot be found.\n\n    return actions # Max steps reached, primitive not collected within the allowed attempts.", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:53:28.842162", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get current state and world information\n  current_state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  # primitive_name = cookbook.index.get(primitive) # For debugging purposes\n\n  # 2. Check if the primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  # 3. Define a helper for turning\n  # This helper simulates the agent's direction change and returns\n  # a list of actions (LEFT/RIGHT) and the new simulated direction.\n  # Directions: 0=North, 1=East, 2=South, 3=West (clockwise)\n  def _turn_to_face(sim_dir, target_global_dir):\n    turn_actions = []\n    # Calculate the difference in direction, normalized to 0, 1, 2, 3\n    # 0: no turn, 1: turn right, 2: turn 180, 3: turn left\n    diff = (target_global_dir - sim_dir + 4) % 4\n    \n    if diff == 1:  # Need to turn right\n      turn_actions.append(env_factory.RIGHT)\n      new_dir = (sim_dir + 1) % 4\n    elif diff == 2:  # Need to turn 180 degrees (two rights or two lefts)\n      turn_actions.extend([env_factory.RIGHT, env_factory.RIGHT])\n      new_dir = (sim_dir + 2) % 4\n    elif diff == 3:  # Need to turn left\n      turn_actions.append(env_factory.LEFT)\n      new_dir = (sim_dir - 1 + 4) % 4\n    else:  # diff == 0, already facing target_global_dir\n      new_dir = sim_dir\n    return new_dir, turn_actions\n\n  # 4. Get initial agent position and direction\n  sim_ar, sim_ac = current_state.pos\n  sim_dir = current_state.dir\n\n  # 5. Find all primitive locations on the global grid\n  # The grid is (WIDTH, HEIGHT, n_kinds)\n  grid = current_state.grid\n  primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n\n  if len(primitive_locations) == 0:\n    # Primitive not found in the environment (or was already collected)\n    return []\n\n  # 6. Choose the closest primitive instance\n  target_pos = None\n  min_dist_sq = float('inf') # Use squared Euclidean distance for efficiency\n  for p_loc in primitive_locations:\n    dist_sq = (sim_ar - p_loc[0])**2 + (sim_ac - p_loc[1])**2\n    if dist_sq < min_dist_sq:\n      min_dist_sq = dist_sq\n      target_pos = p_loc\n  \n  target_row, target_col = target_pos\n\n  # 7. Generate actions to move to target_pos using an L-shaped path\n  # This path moves the agent first to the target row, then to the target column.\n  \n  # Calculate initial row and column differences\n  dr = target_row - sim_ar\n  dc = target_col - sim_ac\n\n  # Phase 1: Align row (move North or South)\n  if dr != 0:\n    # Determine the global direction to face (0=North, 2=South)\n    target_global_dir_r = 0 if dr < 0 else 2 \n    \n    # Turn the agent to face the target row direction\n    sim_dir, turn_acts = _turn_to_face(sim_dir, target_global_dir_r)\n    actions.extend(turn_acts)\n    \n    # Move the required number of steps\n    for _ in range(abs(dr)):\n      actions.append(env_factory.UP)\n    # Simulate the agent's new row position (for subsequent calculations)\n    sim_ar = target_row \n\n  # Phase 2: Align column (move West or East)\n  # Recalculate dc as sim_ac might have been implicitly aligned with target_col\n  # if sim_ar == target_row initially (dr=0) and only dc was non-zero.\n  dc = target_col - sim_ac \n  if dc != 0:\n    # Determine the global direction to face (3=West, 1=East)\n    target_global_dir_c = 3 if dc < 0 else 1 \n    \n    # Turn the agent to face the target column direction\n    sim_dir, turn_acts = _turn_to_face(sim_dir, target_global_dir_c)\n    actions.extend(turn_acts)\n    \n    # Move the required number of steps\n    for _ in range(abs(dc)):\n      actions.append(env_factory.UP)\n    # Simulate the agent's new column position\n    sim_ac = target_col \n\n  # At this point, the simulated agent is at (target_row, target_col), \n  # which is the primitive's location.\n  # The 'USE' action will pick up an item if the agent is on its square.\n  \n  # 8. Add the USE action as the final step\n  actions.append(env_factory.USE)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:55:06.553825", "function_name": "collect", "function_body": "    import collections # For deque\n\n    # Define action constants\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Helper function to check if a primitive is in the 3x3 neighborhood of a given position\n    def is_adjacent_to_primitive(grid_data, agent_pos, primitive_kind_idx):\n        # grid_data: numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds)\n        # agent_pos: tuple (x, y)\n        W, H, _ = grid_data.shape\n        px, py = agent_pos\n        \n        # Check 3x3 neighborhood (including the current cell, though typically a primitive is adjacent)\n        for dx in [-1, 0, 1]:\n            for dy in [-1, 0, 1]:\n                nx, ny = px + dx, py + dy\n                # Check bounds\n                if 0 <= nx < W and 0 <= ny < H:\n                    # Check if the primitive exists at this neighbor location (count > 0)\n                    if grid_data[nx, ny, primitive_kind_idx] > 0:\n                        return True\n        return False\n\n    # Get current state information from the CraftLab environment\n    # We access the internal _current_state of CraftLab to get the grid and agent position\n    state = env._current_state\n    grid = state.grid\n    start_pos = state.pos\n    \n    # Grid dimensions\n    W, H, _ = grid.shape\n\n    # BFS (Breadth-First Search) setup\n    # queue stores tuples: (current_position: (x,y), list_of_actions_to_reach_here)\n    queue = collections.deque([(start_pos, [])]) \n    \n    # visited set to keep track of explored (x, y) positions to avoid cycles and redundant paths\n    visited = {start_pos} \n\n    # Define possible moves and their corresponding action IDs\n    # These map (dx, dy) changes to the CraftLab action constants\n    moves = [\n        (0, 1, DOWN),    # Move Down (increase y-coordinate)\n        (0, -1, UP),     # Move Up (decrease y-coordinate)\n        (-1, 0, LEFT),   # Move Left (decrease x-coordinate)\n        (1, 0, RIGHT)    # Move Right (increase x-coordinate)\n    ]\n\n    while queue:\n        curr_pos, path_so_far = queue.popleft()\n        \n        # If the primitive is adjacent to the current position, we have found a path\n        # to a location from which we can 'USE' it.\n        if is_adjacent_to_primitive(grid, curr_pos, primitive):\n            # Append the USE action to the path and return it\n            return path_so_far + [USE]\n\n        # Explore valid neighboring positions\n        for dx, dy, action in moves:\n            next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n            next_pos = (next_x, next_y)\n\n            # Check if the next position is within grid boundaries and has not been visited yet\n            if 0 <= next_x < W and 0 <= next_y < H and next_pos not in visited:\n                visited.add(next_pos)\n                queue.append((next_pos, path_so_far + [action]))\n                \n    # If the BFS completes and no path to an adjacent primitive is found,\n    # it means the primitive is either unreachable from the start_pos or does not exist in the grid.\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:55:07.548298", "function_name": "collect", "function_body": "  import numpy as np\n  import collections\n\n  # Constants for actions (defined based on the problem description)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction vectors for movement actions\n  MOVE_DELTAS = {\n      ACTION_UP: (-1, 0),\n      ACTION_DOWN: (1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1)\n  }\n\n  # Helper functions (nested to fit within the single function return requirement)\n  def _get_adjacent_pos(pos, action):\n      \"\"\"Calculates the position after applying a movement action.\"\"\"\n      r, c = pos\n      dr, dc = MOVE_DELTAS.get(action, (0, 0))\n      return (r + dr, c + dc)\n\n  def _is_valid_pos(pos, grid_shape):\n      \"\"\"Checks if a position is within grid boundaries.\"\"\"\n      r, c, _ = grid_shape # grid_shape is (HEIGHT, WIDTH, N_KINDS)\n      return 0 <= pos[0] < r and 0 <= pos[1] < c\n\n  def _is_passable(pos):\n      \"\"\"Checks if a cell at `pos` is passable for the agent.\n      Uses `env` and `current_state` from the outer scope.\n      Assumes `water_index` is the primary impassable terrain.\n      \"\"\"\n      r, c = pos\n      grid = current_state.grid\n      \n      # Though BFS will manage this, an explicit check here can prevent issues\n      if not _is_valid_pos(pos, grid.shape):\n          return False\n\n      water_index = env.world.water_index\n\n      # Check if the cell contains any impassable item\n      for kind_idx in range(grid.shape[2]):\n          if grid[r, c, kind_idx] > 0: # If this kind of item exists at this cell\n              if kind_idx == water_index:\n                  return False\n      return True # By default, cells are passable unless explicitly blocked\n\n  actions_taken = []\n  MAX_ACTIONS_LIMIT = 200 # Safety limit to prevent infinite loops in pathfinding/execution\n\n  while True:\n      current_state = env._current_state # Access the internal CraftState instance\n\n      # 1. Check if the primitive is already collected\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n      grid = current_state.grid\n      grid_shape = grid.shape\n      agent_pos = current_state.pos\n\n      # 2. Find all locations of the primitive on the grid\n      primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n      if len(primitive_locations) == 0:\n          # Primitive not found on the map. This implies it's either collected,\n          # or the map doesn't contain it. For a \"collect\" function,\n          # it implies it should be findable if not already collected.\n          return [] # Cannot find the primitive on the map.\n\n      # 3. Find target positions: cells adjacent to any primitive instance\n      potential_targets = set()\n      for p_r, p_c in primitive_locations:\n          # Consider all 4 cardinal directions around the primitive\n          for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              adj_r, adj_c = p_r + dr, p_c + dc\n              adj_pos = (adj_r, adj_c)\n              \n              # Check if the adjacent position is valid and passable\n              if _is_valid_pos(adj_pos, grid_shape) and _is_passable(adj_pos):\n                  # Store only the adjacent position, not the primitive's actual pos\n                  potential_targets.add(adj_pos) \n      \n      if not potential_targets:\n          # No reachable cells adjacent to any primitive.\n          return []\n\n      # 4. Use BFS to find the shortest path from agent_pos to any `potential_target`\n      q = collections.deque([(agent_pos, [])]) # (current_pos, path_actions_to_reach_current_pos)\n      visited = {agent_pos}\n\n      best_path_to_adjacent = None # Stores the action sequence\n\n      while q:\n          current_bfs_pos, path_actions_so_far = q.popleft()\n\n          # Check if current_bfs_pos is one of the target_adjacent_pos\n          if current_bfs_pos in potential_targets:\n              # Found a path to a cell adjacent to the primitive!\n              # Now, append the `ACTION_USE`.\n              # Assumption: `ACTION_USE` works on any adjacent item, or facing is handled implicitly.\n              best_path_to_adjacent = path_actions_so_far + [ACTION_USE]\n              break # Found the first shortest path, no need to explore further\n\n          # Explore valid and passable neighbors\n          for action in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n              next_bfs_pos = _get_adjacent_pos(current_bfs_pos, action)\n              if _is_valid_pos(next_bfs_pos, grid_shape) and next_bfs_pos not in visited:\n                  if _is_passable(next_bfs_pos):\n                      visited.add(next_bfs_pos)\n                      q.append((next_bfs_pos, path_actions_so_far + [action]))\n\n      if not best_path_to_adjacent:\n          # Could not find a path to any cell adjacent to the primitive.\n          # This might happen if the primitive is unreachable (e.g., completely surrounded by water).\n          return []\n\n      # 5. Execute the found path\n      for action in best_path_to_adjacent:\n          # Perform the action in the environment. Reward and observations are not directly used here\n          # for collection logic, but `done` is important.\n          _, done, _ = env.step(action)\n          actions_taken.append(action)\n          \n          # Re-check inventory after each step, especially after an `ACTION_USE`.\n          current_state = env._current_state\n          if current_state.inventory[primitive] > 0:\n              return actions_taken\n          \n          # Safety break for very long paths or if episode ends prematurely\n          if len(actions_taken) >= MAX_ACTIONS_LIMIT:\n              return actions_taken \n          \n          if done:\n              # The episode ended before collection (e.g., max_steps reached, or goal met by other means).\n              return actions_taken # Return actions taken so far, indicating collection failed or stopped.\n\n  # This part should ideally not be reached if MAX_ACTIONS_LIMIT is hit\n  # or the item is collected within the loop.\n  return actions_taken", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:56:50.969310", "function_name": "collect", "function_body": "    import collections # Must be inside function per strict instructions, otherwise usually global\n\n    initial_state = env._current_state\n\n    # 1. Check if the primitive is already collected\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    # Define action mappings for clarity (matching CraftLab.action_specs)\n    ACTIONS = {\n        'DOWN': 0,\n        'UP': 1,\n        'LEFT': 2,\n        'RIGHT': 3,\n        'USE': 4,\n    }\n\n    # Define direction deltas for (row_change, col_change) corresponding to directions 0-3\n    # Assuming 0: North (-1,0), 1: East (0,1), 2: South (1,0), 3: West (0,-1)\n    DELTAS = {\n        0: (-1, 0),  # North\n        1: (0, 1),   # East\n        2: (1, 0),   # South\n        3: (0, -1),  # West\n    }\n\n    # 2. Setup BFS\n    # Queue stores tuples: (current_CraftState_instance, list_of_actions_taken_to_reach_this_state)\n    queue = collections.deque([(initial_state, [])])\n\n    # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths.\n    # We don't need to track the full grid state in 'visited' because the grid content\n    # (specifically, the location of the primitive) only changes upon a 'USE' action,\n    # and we are planning to the first successful 'USE'.\n    visited = set([(initial_state.pos, initial_state.dir)])\n\n    # Get grid dimensions (height, width) for boundary checks\n    grid_height, grid_width, _ = initial_state.grid.shape\n\n    # BFS loop\n    while queue:\n        current_sim_state, actions_so_far = queue.popleft()\n        r, c = current_sim_state.pos\n        current_dir = current_sim_state.dir\n\n        # 3. Check if the primitive is in the cell directly in front of the agent\n        # and if it can be collected from this position.\n        dr, dc = DELTAS[current_dir]\n        target_r, target_c = r + dr, c + dc\n\n        if (0 <= target_r < grid_height and 0 <= target_c < grid_width and\n                current_sim_state.grid[target_r, target_c, primitive] > 0):\n            # The primitive is in front and available. Add 'USE' action and return the path.\n            return actions_so_far + [ACTIONS['USE']]\n\n        # 4. Explore possible next states by movement actions\n        # For each possible movement action (UP, DOWN, LEFT, RIGHT):\n        for action_name, action_val in ACTIONS.items():\n            if action_val == ACTIONS['USE']:\n                continue # 'USE' is a terminal action for this specific goal, handled above.\n\n            # Simulate the action: current_sim_state.step returns (reward, new_CraftState)\n            _reward, next_sim_state = current_sim_state.step(action_val)\n\n            next_pos = next_sim_state.pos\n            next_dir = next_sim_state.dir\n\n            # Check if this new state (position and direction) has already been visited\n            if (next_pos, next_dir) not in visited:\n                visited.add((next_pos, next_dir))\n                # Add the new state and its path to the queue for further exploration\n                queue.append((next_sim_state, actions_so_far + [action_val]))\n\n    # If the queue becomes empty and no path to collect the primitive was found\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:56:51.970157", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # 1. Get current state information from the environment\n  obs = env.observations()\n  current_grid = obs['features_dict']['features_global']\n  current_pos_abs = tuple(obs['features_dict']['pos_abs']) # Agent's current absolute (x,y) position\n  current_dir = np.argmax(obs['features_dict']['direction']) # Agent's current facing direction (0:N, 1:E, 2:S, 3:W)\n  \n  # Grid dimensions: (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, N_KINDS = current_grid.shape \n  \n  # Get world constants from the CraftLab instance\n  world = env.world\n  water_index = world.water_index\n\n  # 2. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          if current_grid[x, y, primitive] > 0: # If primitive exists at (x,y)\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # Primitive not found on the map, cannot collect\n      return []\n\n  # 3. BFS to find the shortest path (in moves) to a cell adjacent to *any* primitive\n  # BFS state: (current_position_tuple, list_of_actions_taken_to_reach_this_position)\n  queue = collections.deque([(current_pos_abs, [])])\n  visited = {current_pos_abs} # Set of visited (x,y) positions to prevent loops\n\n  # Mapping of move actions to (dx, dy) changes in grid coordinates\n  # (dx, dy) for UP (North), RIGHT (East), DOWN (South), LEFT (West)\n  MOVE_DELTAS_XY = {\n      UP: (0, -1),   # (dx, dy) for moving North (y decreases)\n      RIGHT: (1, 0), # (dx, dy) for moving East (x increases)\n      DOWN: (0, 1),  # (dx, dy) for moving South (y increases)\n      LEFT: (-1, 0), # (dx, dy) for moving West (x decreases)\n  }\n\n  path_to_adjacent_cell = []\n  target_primitive_location = None # The actual (px,py) of the primitive we'll target for USE\n\n  while queue:\n      (curr_x, curr_y), path = queue.popleft()\n\n      # Check if the current position is adjacent to any of the primitive locations\n      for p_loc in primitive_locations:\n          px, py = p_loc\n          # Check if Manhattan distance is 1 (adjacent)\n          if abs(curr_x - px) + abs(curr_y - py) == 1:\n              # Found the shortest path to an adjacent cell\n              path_to_adjacent_cell = path\n              target_primitive_location = p_loc\n              queue.clear() # Clear queue to break outer loop efficiently\n              break\n      \n      if not queue: # If queue was cleared (i.e., target found)\n          break\n\n      # Explore neighbors (applying move actions)\n      for action_move, (dx, dy) in MOVE_DELTAS_XY.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # Check boundaries\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Obstacle check:\n          # - If the cell contains water, it's blocked.\n          # - If the cell contains the target primitive itself, we can't step *onto* it to pick it up, only next to it.\n          is_water = current_grid[next_x, next_y, water_index] > 0\n          is_primitive_itself = next_pos in primitive_locations\n\n          if is_water or is_primitive_itself:\n              continue # This cell is blocked or not a valid path cell\n\n          if next_pos not in visited:\n              visited.add(next_pos)\n              queue.append((next_pos, path + [action_move]))\n\n  if not target_primitive_location:\n      # No reachable primitive found\n      return []\n\n  # `path_to_adjacent_cell` now contains the moves to get the agent adjacent to `target_primitive_location`.\n  all_actions = list(path_to_adjacent_cell) # Copy the list to build upon\n\n  # Determine the agent's position and direction after executing path_to_adjacent_cell\n  # We simulate the agent's position and direction for accurate turning calculation.\n  simulated_agent_pos = list(current_pos_abs) # Mutable copy for simulation\n  simulated_agent_dir = current_dir # Start with initial direction\n\n  for action in path_to_adjacent_cell:\n      dx, dy = MOVE_DELTAS_XY[action]\n      simulated_agent_pos[0] += dx\n      simulated_agent_pos[1] += dy\n      # Update simulated_agent_dir based on the move action\n      if action == UP: simulated_agent_dir = 0 # North\n      elif action == RIGHT: simulated_agent_dir = 1 # East\n      elif action == DOWN: simulated_agent_dir = 2 # South\n      elif action == LEFT: simulated_agent_dir = 3 # West\n\n  # Now, the agent is at `simulated_agent_pos`, which is adjacent to `target_primitive_location`.\n  # Calculate the direction the agent needs to face to look at the primitive.\n  px, py = target_primitive_location\n  delta_x, delta_y = px - simulated_agent_pos[0], py - simulated_agent_pos[1]\n\n  target_face_direction = -1\n  if delta_x == 0 and delta_y == -1: target_face_direction = 0 # North (primitive is above)\n  elif delta_x == 1 and delta_y == 0: target_face_direction = 1 # East (primitive is right)\n  elif delta_x == 0 and delta_y == 1: target_face_direction = 2 # South (primitive is below)\n  elif delta_x == -1 and delta_y == 0: target_face_direction = 3 # West (primitive is left)\n\n  if target_face_direction == -1:\n      # This case implies the primitive is not directly adjacent (e.g., diagonal or BFS error)\n      return []\n\n  # Calculate turns needed\n  # Agent dir (0:N, 1:E, 2:S, 3:W)\n  # Difference: (target_face_direction - simulated_agent_dir + 4) % 4\n  # 0: no turn, 1: 90deg Right, 2: 180deg (Right,Right), 3: 90deg Left\n  diff = (target_face_direction - simulated_agent_dir + 4) % 4\n  \n  if diff == 1: # 90 degrees clockwise\n      all_actions.append(RIGHT)\n  elif diff == 2: # 180 degrees\n      all_actions.append(RIGHT)\n      all_actions.append(RIGHT)\n  elif diff == 3: # 90 degrees counter-clockwise\n      all_actions.append(LEFT)\n\n  # Finally, add the USE action to pick up the primitive\n  all_actions.append(USE)\n\n  return all_actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:57:57.658769", "function_name": "collect", "function_body": "  import collections # Ensure collections is available\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Define internal direction indices based on the order in features_dict['direction']\n  # and action_specs: [DOWN, UP, LEFT, RIGHT]\n  _DIR_DOWN = 0\n  _DIR_UP = 1\n  _DIR_LEFT = 2\n  _DIR_RIGHT = 3\n\n  # Mapping from a movement action_id to the resulting agent facing direction.\n  # Taking action _UP makes the agent face _DIR_UP.\n  action_to_new_dir = {\n      _UP: _DIR_UP,\n      _DOWN: _DIR_DOWN,\n      _LEFT: _DIR_LEFT,\n      _RIGHT: _DIR_RIGHT,\n  }\n\n  # Mapping from internal direction integer to (dx, dy) for the cell *in front* of the agent.\n  # (0,0) is top-left. positive X is right, positive Y is down.\n  dir_to_delta = {\n      _DIR_DOWN: (0, 1),   # Facing Down (positive Y): cell in front is (x, y+1)\n      _DIR_UP: (0, -1),    # Facing Up (negative Y): cell in front is (x, y-1)\n      _DIR_LEFT: (-1, 0),  # Facing Left (negative X): cell in front is (x-1, y)\n      _DIR_RIGHT: (1, 0),  # Facing Right (positive X): cell in front is (x+1, y)\n  }\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario (or current grid shape)\n  WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n\n  # Convert one-hot initial direction from features_dict to an integer index\n  initial_dir_idx = np.argmax(features_dict['direction'])\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Identify non-grabbable items that act as obstacles (cannot be moved into)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle) that blocks movement.\"\"\"\n    if not non_grabbable_items_set: # Optimization: if set is empty, no obstacles can exist.\n        return False\n    for k_idx in non_grabbable_items_set:\n      if grid[x, y, k_idx] == 1:\n        return True\n    return False\n\n  # Use Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples: (current_x, current_y, current_direction_idx, [path_actions_to_reach_here])\n  q = collections.deque()\n  q.append((current_px, current_py, initial_dir_idx, []))\n  \n  # Set to store visited states to avoid cycles and re-processing longer paths.\n  # A state is defined by (x, y, direction_idx).\n  visited = {(current_px, current_py, initial_dir_idx)}\n\n  while q:\n    cx, cy, c_dir_idx, c_path = q.popleft()\n\n    # 1. Check if the primitive can be collected from the current state (position + direction)\n    # The _USE action typically applies to the cell directly in front of the agent.\n    target_dx, target_dy = dir_to_delta[c_dir_idx]\n    tx, ty = cx + target_dx, cy + target_dy\n\n    # Check if the cell in front is within bounds and contains the primitive\n    if (0 <= tx < WIDTH and 0 <= ty < HEIGHT and\n        current_grid[tx, ty, primitive] == 1):\n      # If the primitive is in front, we found a solution!\n      return c_path + [_USE]\n\n    # 2. Explore movement actions (UP, DOWN, LEFT, RIGHT)\n    # Each movement action updates both position and facing direction.\n    for action_id, new_dir_idx in action_to_new_dir.items():\n      # Calculate new position: the agent moves one step in the direction it *will face* after the action.\n      move_dx, move_dy = dir_to_delta[new_dir_idx]\n      nx, ny = cx + move_dx, cy + move_dy\n\n      # Check boundaries for the new position\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if the new cell is an obstacle\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n\n      # If this new state (position and direction) has not been visited\n      if (nx, ny, new_dir_idx) not in visited:\n        new_path = c_path + [action_id]\n        q.append((nx, ny, new_dir_idx, new_path))\n        visited.add((nx, ny, new_dir_idx))\n  \n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T20:57:58.624233", "function_name": "collect", "function_body": "  # Action constants (from env.action_specs())\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']   # Typically 0\n  _UP = _actions_map['UP']       # Typically 1\n  _LEFT = _actions_map['LEFT']   # Typically 2\n  _RIGHT = _actions_map['RIGHT'] # Typically 3\n  _USE = _actions_map['USE']     # Typically 4\n\n  # Direction constants: These are defined to directly match the action IDs for\n  # movement. This also aligns with how `features_dict['direction']` one-hot\n  # encoding works (e.g., index 0 for DOWN, 1 for UP, etc.).\n  DIR_DOWN = _DOWN\n  DIR_UP = _UP\n  DIR_LEFT = _LEFT\n  DIR_RIGHT = _RIGHT\n\n  # Delta for position change when moving/facing in a certain direction.\n  # If agent faces DIR_UP, the cell directly in front is (0, -1) relative to\n  # the agent's current position (assuming (0,0) is top-left, y increases downwards).\n  # If agent takes an _UP action, it moves to (x, y-1) and faces DIR_UP.\n  DIR_DELTAS = {\n      DIR_UP: (0, -1),   # (dx, dy) for moving/facing North (Up on grid)\n      DIR_DOWN: (0, 1),  # (dx, dy) for moving/facing South (Down on grid)\n      DIR_LEFT: (-1, 0), # (dx, dy) for moving/facing West (Left on grid)\n      DIR_RIGHT: (1, 0), # (dx, dy) for moving/facing East (Right on grid)\n  }\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the current grid shape\n  WIDTH, HEIGHT, _ = current_grid.shape # N_KINDS is not directly needed for movement\n\n  # Denormalize current agent position (features_dict['pos'] is normalized 0-1)\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n\n  # Initial agent direction (integer index, from one-hot encoding)\n  initial_dir_idx = np.argmax(features_dict['direction'])\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Identify non-grabbable items that act as obstacles (already a set)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def _is_blocked_cell(x, y, grid_data, non_grabbable_kinds_set, width, height):\n    \"\"\"Checks if the cell (x,y) is out of bounds or contains any non-grabbable item.\"\"\"\n    if not (0 <= x < width and 0 <= y < height):\n      return True # Cell is out of bounds\n    for k_idx in non_grabbable_kinds_set:\n      if grid_data[x, y, k_idx] == 1:\n        return True # Cell contains an obstacle\n    return False\n\n  # Use Breadth-First Search (BFS) to find the shortest path.\n  # Queue stores tuples: (current_x, current_y, current_facing_direction_idx, [path_actions_to_reach_here])\n  # 'collections' module is assumed to be imported externally (e.g., at the top of the file).\n  q = collections.deque() \n  q.append((current_px, current_py, initial_dir_idx, []))\n  \n  # Set to store visited states to avoid cycles and re-processing longer paths.\n  # A state is defined by (x, y, facing_direction_idx).\n  visited = {(current_px, current_py, initial_dir_idx)}\n\n  # List of all possible movement actions\n  movement_actions_list = [_UP, _DOWN, _LEFT, _RIGHT]\n\n  while q:\n    cx, cy, c_dir_idx, c_path = q.popleft()\n\n    # 1. Goal Check: Can we collect the primitive from *this* state?\n    # The _USE action typically applies to the cell directly in front of the agent.\n    front_dx, front_dy = DIR_DELTAS[c_dir_idx]\n    tx, ty = cx + front_dx, cy + front_dy\n\n    # Check if the cell directly in front is within grid bounds AND contains the primitive\n    if (0 <= tx < WIDTH and 0 <= ty < HEIGHT and\n        current_grid[tx, ty, primitive] == 1):\n      # Found the shortest path to a state from which the item can be used.\n      return c_path + [_USE]\n\n    # 2. Explore Neighbors (movement actions)\n    for action in movement_actions_list:\n      # When taking a movement action (e.g., _UP), the agent moves to a new cell\n      # AND its facing direction changes to match the direction of movement.\n      n_dir_idx = action # The action itself defines the new facing direction (e.g., _UP action makes agent face DIR_UP)\n      move_dx, move_dy = DIR_DELTAS[n_dir_idx] # The (dx, dy) for moving in this new direction\n      nx, ny = cx + move_dx, cy + move_dy # Calculate the new position\n\n      # Check validity of the new state (position and direction)\n      if _is_blocked_cell(nx, ny, current_grid, non_grabbable_indices, WIDTH, HEIGHT):\n        continue # Cannot move into an obstacle cell or out of bounds\n\n      # If this new (position, direction) state has already been visited (with an equal or shorter path)\n      if (nx, ny, n_dir_idx) in visited:\n        continue\n\n      # If the new state is valid and unvisited, add it to the queue\n      new_path = c_path + [action]\n      q.append((nx, ny, n_dir_idx, new_path))\n      visited.add((nx, ny, n_dir_idx))\n  \n  # If the BFS queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T20:59:43.790573", "function_name": "collect", "function_body": "  all_actions = [] # List to store all actions taken\n\n  action_map = env.action_specs()\n  # Define movement deltas for BFS\n  # (dx, dy) mappings for actions. x increases right, y increases down.\n  move_deltas = {\n      action_map[\"UP\"]: (0, -1),\n      action_map[\"DOWN\"]: (0, 1),\n      action_map[\"LEFT\"]: (-1, 0),\n      action_map[\"RIGHT\"]: (1, 0),\n  }\n\n  # Determine grid dimensions for pathfinding and iteration limit\n  current_state = env._current_state\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum iterations to prevent infinite loops if goal is unreachable\n  # A generous heuristic for steps is twice the grid size, allowing for some back-and-forth.\n  max_collection_attempts = grid_width * grid_height * 2 \n\n  for _ in range(max_collection_attempts):\n      current_state = env._current_state\n\n      # 1. Check if primitive is already collected\n      if current_state.inventory[primitive] > 0:\n          return all_actions\n\n      # 2. Check if agent is adjacent to the primitive and needs to USE an action\n      # 'next_to' checks the 3x3 neighborhood, which includes the agent's current cell.\n      if current_state.next_to(primitive):\n          # If so, perform the USE action\n          all_actions.append(action_map[\"USE\"])\n          env.step(action_map[\"USE\"]) # Apply the action to the environment\n          continue # Go to the next iteration to re-check inventory\n\n      # 3. If not collected and not next to, find a path to the primitive using BFS\n      start_pos = current_state.pos\n\n      # BFS Queue: stores (current_position_tuple, path_taken_so_far_as_actions_list)\n      # Using collections.deque for efficient appends/pops from both ends\n      q = collections.deque([(start_pos, [])])\n      visited = {start_pos} # Set to keep track of visited positions\n\n      found_path_to_primitive = None\n\n      while q:\n          curr_pos, path = q.popleft()\n\n          # If the current position contains the primitive, this is our target.\n          # We're looking for any cell on the grid that holds the primitive.\n          # The agent might need to step onto it, or be adjacent and USE.\n          # 'next_to' will handle the interaction after reaching the cell.\n          if current_state.grid[curr_pos[0], curr_pos[1], primitive] > 0:\n              found_path_to_primitive = path\n              break # Found the shortest path to a primitive cell\n\n          # Explore valid neighbors\n          for action_val, (dx, dy) in move_deltas.items():\n              next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n              next_pos = (next_x, next_y)\n\n              # Check grid boundaries\n              if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n                  continue\n\n              # Check if position has already been visited in this BFS\n              if next_pos in visited:\n                  continue\n\n              # Add to visited and queue for further exploration\n              visited.add(next_pos)\n              q.append((next_pos, path + [action_val]))\n\n      if found_path_to_primitive is not None:\n          if found_path_to_primitive: # If path is not empty, take the first step\n              next_action = found_path_to_primitive[0]\n              all_actions.append(next_action)\n              env.step(next_action) # Apply the movement action\n          else: # Path is empty, meaning agent is already ON the primitive location.\n                # No movement action needed. The next iteration will re-evaluate inventory/next_to.\n                pass # Continue to the outer loop's next iteration\n      else:\n          # No path found to the primitive on the grid after BFS.\n          # This implies it's either not present, or currently unreachable.\n          # Since it's not in inventory and not next to, and no path was found, we cannot collect it.\n          return all_actions # Return the actions collected so far (failure to complete goal)\n\n  # If the maximum number of collection attempts is reached without collecting the primitive,\n  # return the actions taken so far. This implies failure or unreachability within the given limits.\n  return all_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:59:43.860028", "function_name": "collect", "function_body": "    actions = []\n\n    # 1. Get current state observations\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    current_pos = list(obs['features_dict']['pos']) # Agent's current (x, y) position\n    \n    # Grid shape is (HEIGHT, WIDTH, n_kinds)\n    HEIGHT, WIDTH, _ = grid.shape\n\n    # 2. Find primitive location (primitive_x, primitive_y)\n    primitive_idx = primitive\n    primitive_x, primitive_y = -1, -1\n    \n    item_found = False\n    for y in range(HEIGHT):\n        for x in range(WIDTH):\n            if grid[y, x, primitive_idx] > 0: # Assuming 1 for presence of the item\n                primitive_x, primitive_y = x, y\n                item_found = True\n                break\n        if item_found:\n            break\n\n    if not item_found:\n        # Primitive not found on the map, return empty list of actions\n        return []\n\n    # 3. Determine the best target adjacent cell (target_adj_x, target_adj_y)\n    # and the required facing direction (target_face_dir) for the agent\n    # to be able to pick up the primitive.\n    # The agent needs to move to an adjacent cell AND face the primitive to USE it.\n    \n    # Candidate adjacent positions relative to the primitive (primitive_x, primitive_y)\n    # Each entry is: ((target_adj_x, target_adj_y), required_facing_direction_from_there)\n    candidate_adj = [\n        ((primitive_x, primitive_y - 1), env_factory.DOWN),  # Agent above primitive, needs to face DOWN\n        ((primitive_x, primitive_y + 1), env_factory.UP),    # Agent below primitive, needs to face UP\n        ((primitive_x - 1, primitive_y), env_factory.RIGHT), # Agent left of primitive, needs to face RIGHT\n        ((primitive_x + 1, primitive_y), env_factory.LEFT)   # Agent right of primitive, needs to face LEFT\n    ]\n    \n    best_target_info = None # Stores (target_adj_x, target_adj_y, target_face_dir)\n    min_dist = float('inf')\n    \n    for (tx, ty), tdir in candidate_adj:\n        # Check if the potential target adjacent cell is within grid bounds\n        if 0 <= tx < WIDTH and 0 <= ty < HEIGHT:\n            # Calculate Manhattan distance from agent's current position to this potential target cell\n            dist = abs(current_pos[0] - tx) + abs(current_pos[1] - ty)\n            \n            # Prioritize cells with shorter distance. If distances are equal, pick the first one found\n            if dist < min_dist:\n                min_dist = dist\n                best_target_info = (tx, ty, tdir)\n    \n    if best_target_info is None:\n        # No valid adjacent cell found (e.g., primitive is at an unapproachable edge, or map is too small)\n        return []\n\n    target_adj_x, target_adj_y, target_face_dir = best_target_info\n\n    # 4. Generate movement actions to reach (target_adj_x, target_adj_y)\n    # while ensuring the agent ends up with the `target_face_dir`.\n    # This is achieved by moving to a \"pre-target\" position, and then making the final move\n    # which will set the agent's direction.\n    \n    # Calculate the \"pre-target\" position from which the final directional move will be made.\n    pre_target_x, pre_target_y = target_adj_x, target_adj_y\n\n    if target_face_dir == env_factory.DOWN:\n        pre_target_y -= 1 # Agent needs to come from above\n    elif target_face_dir == env_factory.UP:\n        pre_target_y += 1 # Agent needs to come from below\n    elif target_face_dir == env_factory.RIGHT:\n        pre_target_x -= 1 # Agent needs to come from the left\n    elif target_face_dir == env_factory.LEFT:\n        pre_target_x += 1 # Agent needs to come from the right\n    \n    # Current pathfinding position, starting from agent's actual current position\n    current_path_x, current_path_y = current_pos[0], current_pos[1]\n\n    # Move horizontally towards the pre_target_x\n    while current_path_x != pre_target_x:\n        if current_path_x < pre_target_x:\n            actions.append(env_factory.RIGHT)\n            current_path_x += 1\n        else: # current_path_x > pre_target_x\n            actions.append(env_factory.LEFT)\n            current_path_x -= 1\n    \n    # Move vertically towards the pre_target_y\n    while current_path_y != pre_target_y:\n        if current_path_y < pre_target_y:\n            actions.append(env_factory.DOWN)\n            current_path_y += 1\n        else: # current_path_y > pre_target_y\n            actions.append(env_factory.UP)\n            current_path_y -= 1\n            \n    # After reaching the `pre_target` position, add the final movement action.\n    # This action places the agent at `target_adj_x, target_adj_y` and correctly\n    # sets its facing direction to `target_face_dir`.\n    actions.append(target_face_dir)\n\n    # 5. Add the USE action to collect the primitive\n    actions.append(env_factory.USE)\n\n    return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:01:14.296898", "function_name": "collect", "function_body": "    import collections\n\n    # Assuming env_factory constants like DOWN, UP, LEFT, RIGHT, USE, WIDTH, HEIGHT are available.\n    # These are usually implicitly provided or imported in the context of such problems.\n    ACTION_DOWN = env_factory.DOWN\n    ACTION_UP = env_factory.UP\n    ACTION_LEFT = env_factory.LEFT\n    ACTION_RIGHT = env_factory.RIGHT\n    ACTION_USE = env_factory.USE\n    WORLD_WIDTH = env_factory.WIDTH\n    WORLD_HEIGHT = env_factory.HEIGHT\n\n    primitive_id = primitive\n\n    # DMLab-style direction mappings and their corresponding (dx, dy) deltas\n    # 0: North (UP), 1: East (RIGHT), 2: South (DOWN), 3: West (LEFT)\n    # This also maps to the direction agent needs to face to USE an adjacent item.\n    DELTA_TO_DIR = {\n        (0, -1): 0,  # North (change in y is -1 for moving North)\n        (1, 0): 1,   # East (change in x is +1 for moving East)\n        (0, 1): 2,   # South (change in y is +1 for moving South)\n        (-1, 0): 3   # West (change in x is -1 for moving West)\n    }\n\n    # Start the search from the current state of the environment.\n    # Accessing _current_state is necessary as CraftLab does not expose CraftState publicly.\n    initial_state = env._current_state\n    \n    # Queue for Breadth-First Search (BFS).\n    # Each item is a tuple: (CraftState instance, list of actions to reach this state).\n    q = collections.deque([(initial_state, [])])\n    \n    # Set to keep track of visited states to prevent redundant exploration and infinite loops.\n    # A state is uniquely defined by its (position, facing direction, and inventory contents).\n    visited_states = set()\n\n    # Maximum path length to limit the search depth and prevent excessive computation time.\n    max_path_length = 500 \n\n    while q:\n        current_state, path = q.popleft()\n\n        # Create a hashable key for the current state to check against visited_states.\n        state_key = (current_state.pos, current_state.dir, tuple(current_state.inventory))\n\n        if state_key in visited_states:\n            continue\n        visited_states.add(state_key)\n\n        # Check if the primitive is already in the inventory. If yes, we're done.\n        if current_state.inventory[primitive_id] > 0:\n            return path\n\n        # Check if the primitive is in the immediate 3x3 neighborhood and can be USEd.\n        if current_state.next_to(primitive_id):\n            x_agent, y_agent = current_state.pos\n            \n            # Search for the primitive's exact coordinates in the surrounding cells.\n            found_primitive_delta = None # Stores (dx, dy) relative to agent\n            for dx in [-1, 0, 1]:\n                for dy in [-1, 0, 1]:\n                    # Exclude the agent's own position (0,0) and diagonal cells,\n                    # as USE typically only works for cardinal neighbors.\n                    if (dx == 0 and dy == 0) or (dx != 0 and dy != 0):\n                        continue\n                    \n                    nx, ny = x_agent + dx, y_agent + dy\n                    \n                    # Ensure coordinates are within grid boundaries\n                    if 0 <= nx < WORLD_WIDTH and 0 <= ny < WORLD_HEIGHT:\n                        # Check if the primitive entity is present at (nx, ny)\n                        if current_state.grid[nx, ny, primitive_id] > 0:\n                            found_primitive_delta = (dx, dy)\n                            break\n                if found_primitive_delta:\n                    break\n            \n            if found_primitive_delta:\n                # Determine the target facing direction based on the primitive's relative position.\n                target_facing_dir = DELTA_TO_DIR.get(found_primitive_delta)\n                \n                if target_facing_dir is not None:\n                    current_facing_dir = current_state.dir\n                    temp_path = list(path) # Create a temporary path to simulate USE actions\n                    \n                    # Simulate rotations to face the target.\n                    # Calculate angular difference: (target - current + 4) % 4\n                    # 0: Already facing, 1: Turn RIGHT, 2: Turn RIGHT twice, 3: Turn LEFT\n                    diff = (target_facing_dir - current_facing_dir + 4) % 4\n                    \n                    simulated_state_after_rot = current_state # Use this copy to apply rotations\n                    \n                    if diff == 1: # Turn 90 degrees clockwise (e.g., North to East)\n                        temp_path.append(ACTION_RIGHT)\n                        _reward, simulated_state_after_rot = simulated_state_after_rot.step(ACTION_RIGHT)\n                    elif diff == 3: # Turn 90 degrees counter-clockwise (e.g., North to West)\n                        temp_path.append(ACTION_LEFT)\n                        _reward, simulated_state_after_rot = simulated_state_after_rot.step(ACTION_LEFT)\n                    elif diff == 2: # Turn 180 degrees (e.g., North to South)\n                        temp_path.append(ACTION_RIGHT)\n                        _reward, simulated_state_after_rot = simulated_state_after_rot.step(ACTION_RIGHT)\n                        temp_path.append(ACTION_RIGHT)\n                        _reward, simulated_state_after_rot = simulated_state_after_rot.step(ACTION_RIGHT)\n                    # If diff is 0, the agent is already facing the correct direction.\n\n                    # After rotating (if necessary), attempt to USE the item.\n                    temp_path.append(ACTION_USE)\n                    _reward, state_after_use = simulated_state_after_rot.step(ACTION_USE)\n                    \n                    # If the USE action was successful (primitive is now in inventory), return this path.\n                    if state_after_use.inventory[primitive_id] > 0:\n                        return temp_path\n                    # If USE failed or did not yield the primitive, the BFS continues exploring other options.\n\n        # If not collected and not ready to USE, explore neighboring states by moving.\n        # Ensure the path length does not exceed the maximum allowed.\n        if len(path) < max_path_length:\n            # Consider all four cardinal movement actions.\n            for action in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n                # Simulate the action to get the next state.\n                # The reward for moving is typically 0.0, so it's ignored.\n                _reward, next_state = current_state.step(action)\n                \n                # Create a key for the prospective next state.\n                next_state_key = (next_state.pos, next_state.dir, tuple(next_state.inventory))\n\n                # If this next state has not been visited, add it to the queue for exploration.\n                if next_state_key not in visited_states:\n                    q.append((next_state, path + [action]))\n\n    # If the BFS queue becomes empty and the primitive has not been collected,\n    # it means the primitive is unreachable within the defined search limits.\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:01:14.367115", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    state = env._current_state\n    world = env.world\n    \n    # 1. Check if primitive is already collected\n    if state.inventory[primitive] > 0:\n        return []\n\n    # Get action mappings from the environment for robustness\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    # Direction offsets and corresponding actions for movement\n    MOVE_OFFSETS_TO_ACTION = {\n        (-1, 0): ACTION_UP,    # dx, dy for moving UP\n        (1, 0): ACTION_DOWN,   # dx, dy for moving DOWN\n        (0, -1): ACTION_LEFT,  # dx, dy for moving LEFT\n        (0, 1): ACTION_RIGHT   # dx, dy for moving RIGHT\n    }\n\n    # Adjacency offsets (relative coordinates for N, S, W, E neighbors)\n    ADJACENCY_OFFSETS = [\n        (-1, 0), (1, 0), (0, -1), (0, 1)\n    ]\n\n    grid_width, grid_height, _ = state.grid.shape\n    \n    # BFS Initialization\n    # queue stores (current_position, path_actions_to_reach_current_position)\n    queue = collections.deque([(state.pos, [])])\n    # visited stores positions that have been added to the queue to avoid cycles and redundant processing\n    visited = {state.pos}\n\n    # BFS Loop\n    while queue:\n        curr_pos, curr_actions = queue.popleft()\n        \n        # Check if the agent's current position is adjacent to the target primitive.\n        # This is the \"goal state\" for our pathfinding: being in a position\n        # from which the primitive can be 'USE'd.\n        found_adjacent_primitive = False\n        for dx, dy in ADJACENCY_OFFSETS:\n            adj_x, adj_y = curr_pos[0] + dx, curr_pos[1] + dy\n            \n            # Check bounds for the cell adjacent to the agent's current position\n            if 0 <= adj_x < grid_width and 0 <= adj_y < grid_height:\n                # Check if this adjacent cell contains the primitive we are looking for\n                if state.grid[adj_x, adj_y, primitive] > 0:\n                    found_adjacent_primitive = True\n                    break # Found an adjacent primitive, no need to check other neighbors from this curr_pos\n\n        if found_adjacent_primitive:\n            # If we are adjacent to the primitive, add the USE action and return the complete sequence\n            return curr_actions + [ACTION_USE]\n\n        # If not yet adjacent, explore neighboring cells to move towards the primitive\n        for move_dx, move_dy in ADJACENCY_OFFSETS:\n            next_x, next_y = curr_pos[0] + move_dx, curr_pos[1] + move_dy\n            next_pos = (next_x, next_y)\n\n            # Check if the next position is within grid boundaries\n            if 0 <= next_x < grid_width and 0 <= next_y < grid_height:\n                # Check if this next position has already been visited\n                if next_pos not in visited:\n                    # Traversal Rule: Assume the agent cannot move onto a cell that\n                    # *contains* the specific primitive it is trying to collect/interact with\n                    # from an adjacent cell (e.g., water, stone, a tree). This is a common\n                    # assumption for 'USE' action interaction from proximity.\n                    # This means we only allow movement into cells that are \"empty\" of the target primitive.\n                    if state.grid[next_x, next_y, primitive] == 0: \n                        visited.add(next_pos)\n                        action_to_take = MOVE_OFFSETS_TO_ACTION[(move_dx, move_dy)]\n                        queue.append((next_pos, curr_actions + [action_to_take]))\n    \n    # If the BFS completes and no path to an adjacent primitive (and thus no collection) is found,\n    # it means the primitive is unreachable or not on the map.\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:02:47.420773", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from CraftLab.action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Helper for 4-directional movement (relative coordinates)\n  _DELTAS = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  def _is_valid_coord(x, y, WIDTH, HEIGHT):\n      \"\"\"Checks if a given (x, y) coordinate is within the grid boundaries.\"\"\"\n      return 0 <= x < WIDTH and 0 <= y < HEIGHT\n\n  def _is_navigable(x, y, current_grid, non_grabbable_indices, WIDTH, HEIGHT):\n      \"\"\"\n      Checks if a cell at (x, y) is navigable (i.e., within bounds and not occupied\n      by a non-grabbable item).\n      \"\"\"\n      # Check if cell is within grid boundaries\n      if not _is_valid_coord(x, y, WIDTH, HEIGHT):\n          return False\n      # Check if the cell (x, y) contains any non-grabbable item (obstacle)\n      for k_idx in non_grabbable_indices:\n          if current_grid[x, y, k_idx] > 0: # If there's an obstacle of kind k_idx at (x,y)\n              return False # Cell is blocked\n      return True\n\n  def _is_adjacent_to_primitive(x, y, primitive_kind, current_grid, WIDTH, HEIGHT):\n      \"\"\"\n      Checks if the cell at (x, y) is adjacent (8-neighborhood) to the specified primitive_kind.\n      \"\"\"\n      # Checks the 8-neighborhood around (x, y) for the presence of the primitive\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              if dx == 0 and dy == 0: continue # Skip checking the current cell itself\n              nx, ny = x + dx, y + dy\n              # If neighbor is valid and contains the primitive\n              if _is_valid_coord(nx, ny, WIDTH, HEIGHT) and current_grid[nx, ny, primitive_kind] > 0:\n                  return True # Primitive found in neighborhood\n      return False\n\n  def _find_path_and_actions_to_collect(start_pos, target_primitive_idx, current_grid, world):\n      \"\"\"\n      Finds the shortest sequence of actions to move to a cell adjacent to the target primitive\n      and then use it.\n      Returns a list of action integers, or None if no path exists.\n      \"\"\"\n      WIDTH, HEIGHT, _ = current_grid.shape\n      non_grabbable_indices = world.non_grabbable_indices\n\n      # 1. Early exit: Check if the primitive is even on the grid\n      # np.any checks if any element in the slice for target_primitive_idx is greater than 0\n      if not np.any(current_grid[:, :, target_primitive_idx] > 0):\n          return None # Primitive not found anywhere on the grid\n\n      # 2. Early exit: Check if agent is already adjacent to the primitive\n      if _is_adjacent_to_primitive(start_pos[0], start_pos[1], target_primitive_idx, current_grid, WIDTH, HEIGHT):\n          return [USE] # Already next to it, just use\n\n      # 3. BFS setup: Queue for (current_position, actions_to_reach_here)\n      #    Visited set to keep track of explored positions and avoid cycles/longer paths\n      queue = collections.deque([(start_pos, [])])\n      visited = {start_pos} # Stores (x, y) tuples\n\n      while queue:\n          (x, y), actions_so_far = queue.popleft()\n\n          # Explore 4-directional neighbors (UP, DOWN, LEFT, RIGHT movements)\n          for action_val, (dx, dy) in _DELTAS.items():\n              nx, ny = x + dx, y + dy\n              next_pos = (nx, ny)\n\n              # Check if the next position is valid and not blocked by obstacles\n              if not _is_navigable(nx, ny, current_grid, non_grabbable_indices, WIDTH, HEIGHT):\n                  continue # Cannot move here\n\n              # Check if this position has already been visited by a shorter or equal path\n              if next_pos in visited:\n                  continue # Already processed this position, no need to revisit\n\n              # Mark as visited and extend the path\n              visited.add(next_pos)\n              new_actions = actions_so_far + [action_val]\n\n              # If the new position is adjacent to the target primitive, we've found our goal\n              if _is_adjacent_to_primitive(nx, ny, target_primitive_idx, current_grid, WIDTH, HEIGHT):\n                  return new_actions + [USE] # Path found! Add the USE action at the end\n\n              # If not yet at the target, add the new position to the queue for further exploration\n              queue.append((next_pos, new_actions))\n\n      # If the queue becomes empty and no path was found\n      return None # No path exists to reach a cell adjacent to the primitive\n\n  # Main logic for collect_v2\n  # Access current state information from the CraftLab environment\n  # The CraftLab instance (`env`) holds a reference to the current CraftState\n  # and the CraftWorld configuration.\n  current_state = env._current_state\n  current_inventory = current_state.inventory\n  current_pos = current_state.pos\n  current_grid = current_state.grid\n  world = env.world # The CraftWorld instance which contains non_grabbable_indices\n\n  # 1. Check if the primitive is already in the inventory\n  # If the agent already has the primitive, no actions are needed.\n  if current_inventory[primitive] > 0:\n      return [] # Already collected\n\n  # 2. Find the path and actions required to move to the primitive and collect it.\n  # This uses the BFS helper function defined above.\n  actions_to_collect = _find_path_and_actions_to_collect(current_pos, primitive, current_grid, world)\n\n  # 3. Return the sequence of actions\n  if actions_to_collect is None:\n      # If _find_path_and_actions_to_collect returns None, it means the primitive\n      # is either not on the grid or is unreachable. In this case, no actions can be taken.\n      return []\n  else:\n      # If a path is found, return the list of actions.\n      return actions_to_collect", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:02:47.489842", "function_name": "collect", "function_body": "    state = env._current_state\n    world = state.world\n\n    # Check if primitive is already in inventory\n    if state.inventory[primitive] > 0:\n        return []\n\n    # Get action mappings from the environment\n    actions_map = env.action_specs()\n    UP_ACT = actions_map['UP']\n    DOWN_ACT = actions_map['DOWN']\n    LEFT_ACT = actions_map['LEFT']\n    RIGHT_ACT = actions_map['RIGHT']\n    USE_ACT = actions_map['USE']\n\n    MOVE_ACTIONS = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n    # Define direction indices based on typical CraftWorld mappings\n    # _DIRS = [(0, -1), (1, 0), (0, 1), (-1, 0)]  # UP, RIGHT, DOWN, LEFT\n    UP_DIR = 0\n    RIGHT_DIR = 1\n    DOWN_DIR = 2\n    LEFT_DIR = 3\n\n    # Map move action to (dr, dc) delta for grid coordinate changes\n    ACTION_DELTAS = {\n        UP_ACT: (0, -1),\n        DOWN_ACT: (0, 1),\n        LEFT_ACT: (-1, 0),\n        RIGHT_ACT: (1, 0),\n    }\n\n    # Map move action to the resulting agent direction index\n    ACTION_TO_DIR_IDX = {\n        UP_ACT: UP_DIR,\n        DOWN_ACT: DOWN_DIR,\n        LEFT_ACT: LEFT_DIR,\n        RIGHT_ACT: RIGHT_DIR,\n    }\n    \n    # Map direction index to (dr, dc) delta for determining the cell in front of the agent\n    DIR_IDX_TO_DELTA = {\n        UP_DIR: (0, -1),\n        RIGHT_DIR: (1, 0),\n        DOWN_DIR: (0, 1),\n        LEFT_DIR: (-1, 0),\n    }\n\n    grid = state.grid\n    HEIGHT, WIDTH, _ = grid.shape\n\n    # Find all locations where the primitive exists on the grid\n    target_locations = []\n    for r in range(HEIGHT):\n        for c in range(WIDTH):\n            if grid[r, c, primitive] > 0:\n                target_locations.append((r, c))\n\n    if not target_locations:\n        return [] # Primitive not found on the grid\n\n    # Use Breadth-First Search (BFS) to find the shortest path of actions\n    # The state in BFS will be (current_row, current_col, current_direction_idx, list_of_actions_taken)\n    initial_r, initial_c = state.pos\n    initial_dir = state.dir\n\n    q = collections.deque([(initial_r, initial_c, initial_dir, [])])\n    visited = set([(initial_r, initial_c, initial_dir)])\n\n    while q:\n        curr_r, curr_c, curr_dir, path = q.popleft()\n\n        # Check if the agent is currently positioned and oriented to use the primitive\n        # Calculate the coordinates of the cell directly in front of the agent\n        dr_facing, dc_facing = DIR_IDX_TO_DELTA[curr_dir]\n        facing_r, facing_c = curr_r + dr_facing, curr_c + dc_facing\n\n        if (facing_r, facing_c) in target_locations:\n            # If the cell in front contains the primitive, we can perform the USE action\n            return path + [USE_ACT]\n\n        # Explore all possible move actions from the current state\n        for action in MOVE_ACTIONS:\n            move_dr, move_dc = ACTION_DELTAS[action]\n            next_r, next_c = curr_r + move_dr, curr_c + move_dc\n            next_dir = ACTION_TO_DIR_IDX[action] # Agent's direction updates to the direction of movement\n\n            # Check if the next position is within the grid boundaries\n            if not (0 <= next_r < HEIGHT and 0 <= next_c < WIDTH):\n                continue\n\n            # If this specific state (position and direction) has not been visited, add it to the queue\n            if (next_r, next_c, next_dir) not in visited:\n                visited.add((next_r, next_c, next_dir))\n                q.append((next_r, next_c, next_dir, path + [action]))\n    \n    # If the BFS completes and no path to collect the primitive is found\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:04:43.370931", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Define a maximum number of steps for the BFS to find a path.\n  # This prevents excessively long search times and limits the length of the generated action sequence.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to calculate the grid coordinates of the cell directly in front of the agent.\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent.\n\n      Args:\n          y (int): Agent's current row coordinate.\n          x (int): Agent's current column coordinate.\n          direction (int): Agent's current facing direction (DIR_EAST, DIR_SOUTH, DIR_WEST, DIR_NORTH).\n\n      Returns:\n          tuple[int, int]: (row, column) coordinates of the cell in front.\n      \"\"\"\n      if direction == DIR_EAST:\n          return y, x + 1\n      elif direction == DIR_SOUTH:\n          return y + 1, x\n      elif direction == DIR_WEST:\n          return y, x - 1\n      elif direction == DIR_NORTH:\n          return y - 1, x\n      # This case should ideally not be reached with valid direction inputs.\n      return y, x\n\n  actions_taken = []\n\n  # Access the underlying CraftState instance directly to get the current state information.\n  # This allows `collect_v2` to be called mid-episode without resetting the environment.\n  current_state = env._current_state\n\n  # Basic validation: Ensure the `primitive` is a recognized entity kind in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # Optimization: If the `primitive` is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Retrieve necessary environment information for pathfinding.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir\n\n  # Define which entity kinds block agent movement.\n  # IMPROVEMENT: Use a set comprehension for a more concise and readable definition.\n  # This set includes all non-grabbable items that are NOT classified as workshops,\n  # as workshops are typically traversable even if non-grabbable.\n  impassable_for_movement = {\n      k_idx for k_idx in current_state.world.non_grabbable_indices\n      if k_idx not in current_state.world.workshop_indices\n  }\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # The agent's direction automatically updates based on the cardinal direction of its last movement.\n  # Format: {ACTION: (resulting_direction, dy, dx)}\n  movement_actions_map = {\n      ACTION_UP:    (DIR_NORTH, -1, 0),\n      ACTION_RIGHT: (DIR_EAST, 0, 1),\n      ACTION_DOWN:  (DIR_SOUTH, 1, 0),\n      ACTION_LEFT:  (DIR_WEST, 0, -1)\n  }\n\n  q = collections.deque()\n  \n  # If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # Initialize BFS: Start from the agent's current position and direction with an empty action path.\n  q.append((start_y, start_x, start_dir, []))\n  # Keep track of visited states (position + orientation) to prevent redundant exploration and infinite loops.\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None  # This variable will store the final sequence of actions if a valid path is found.\n\n  # Determine if the primitive is a \"grabbable\" item (picked up by moving onto its cell and using USE).\n  # Or if it's a \"non-grabbable\" item (interacted with from an adjacent cell).\n  is_primitive_grabbable = primitive in current_state.world.grabbable_indices\n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Optimization: If the current path length already exceeds MAX_COLLECT_STEPS,\n      # this branch cannot lead to a valid solution within the specified limits.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # --- Goal Check: Determine if the primitive can be collected from the current state (position and direction) ---\n\n      # Scenario 1: Primitive is \"grabbable\" and located on the agent's current cell.\n      # In this case, ACTION_USE picks it up, regardless of the agent's facing direction.\n      if is_primitive_grabbable and full_grid[curr_y, curr_x, primitive] > 0:\n          candidate_path = path + [ACTION_USE]\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              # BFS guarantees the shortest path, so we can stop once a valid one is found.\n              break \n      \n      # Scenario 2: Primitive is \"non-grabbable\" and located in the cell the agent is currently facing.\n      # In this case, ACTION_USE interacts with the object in front.\n      elif not is_primitive_grabbable: # Only consider this if it's not a grabbable item\n          facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n          # Check if the facing cell is within grid boundaries and contains the target primitive.\n          if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n              full_grid[facing_y, facing_x, primitive] > 0):\n              \n              candidate_path = path + [ACTION_USE]\n              if len(candidate_path) <= MAX_COLLECT_STEPS:\n                  path_to_execute = candidate_path\n                  break # Found the shortest path, exit BFS.\n\n      # --- Explore neighboring cells via movement actions ---\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          \n          # Pruning: If adding this move makes the path too long, skip.\n          if len(path) + 1 >= MAX_COLLECT_STEPS:\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable.\n          # A cell is not traversable if it contains any item in the `impassable_for_movement` set.\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # Check if this new (position, direction) state has already been visited.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # If all checks pass, add the new state to the queue for further exploration.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      # If no valid path was found within the step limit, return an empty list.\n      return []\n\n  for action in path_to_execute:\n      actions_taken.append(action)\n      # Perform the action in the environment.\n      # We ignore reward and observation for the purpose of this planning function.\n      reward, done, _ = env.step(action)\n      \n      # Update the internal state reference after each step to reflect the current environment.\n      current_state = env._current_state\n\n      # Check for early termination of the episode or if the goal was satisfied.\n      # If the episode ends (done is True) before the primitive is collected, it implies failure.\n      if done and current_state.inventory[primitive] <= 0:\n          return []\n\n      # If the primitive is successfully collected at any point, we can stop and return the path.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n  # Final check: After executing all actions in the `path_to_execute`, confirm collection.\n  # This handles cases where the primitive is collected on the very last action.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it indicates a discrepancy (e.g., dynamic environment changes, or logical error).\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:04:44.386088", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Define a maximum number of steps for the BFS to find a path.\n  # This prevents excessively long search times and limits the length of the generated action sequence.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to calculate the grid coordinates of the cell directly in front of the agent.\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent.\n\n      Args:\n          y (int): Agent's current row coordinate.\n          x (int): Agent's current column coordinate.\n          direction (int): Agent's current facing direction (DIR_EAST, DIR_SOUTH, DIR_WEST, DIR_NORTH).\n\n      Returns:\n          tuple[int, int]: (row, column) coordinates of the cell in front.\n      \"\"\"\n      if direction == DIR_EAST:\n          return y, x + 1\n      elif direction == DIR_SOUTH:\n          return y + 1, x\n      elif direction == DIR_WEST:\n          return y, x - 1\n      elif direction == DIR_NORTH:\n          return y - 1, x\n      # This case should ideally not be reached with valid direction inputs.\n      return y, x\n\n  actions_taken = []\n\n  # Access the underlying CraftState instance directly to get the current state information.\n  # This allows `collect_v2` to be called mid-episode without resetting the environment.\n  current_state = env._current_state\n\n  # Basic validation: Ensure the `primitive` is a recognized entity kind in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # Optimization: If the `primitive` is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Retrieve necessary environment information for pathfinding.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir\n\n  # Define which entity kinds block agent movement.\n  # These are generally non-grabbable items that are not workshops (e.g., water, walls, trees).\n  # This set includes all grid entities that the agent cannot traverse through.\n  impassable_for_movement = set()\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  for k_idx in current_state.world.non_grabbable_indices:\n      # Workshops (like workbench, furnace) are often non-grabbable but traversable.\n      if k_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # The agent's direction automatically updates based on the cardinal direction of its last movement.\n  # Format: {ACTION: (resulting_direction, dy, dx)}\n  movement_actions_map = {\n      ACTION_UP:    (DIR_NORTH, -1, 0),  # Action UP (1): moves North (dy=-1, dx=0), agent faces North (DIR_NORTH=3)\n      ACTION_RIGHT: (DIR_EAST, 0, 1),    # Action RIGHT (3): moves East (dy=0, dx=1), agent faces East (DIR_EAST=0)\n      ACTION_DOWN:  (DIR_SOUTH, 1, 0),   # Action DOWN (0): moves South (dy=1, dx=0), agent faces South (DIR_SOUTH=1)\n      ACTION_LEFT:  (DIR_WEST, 0, -1)    # Action LEFT (2): moves West (dy=0, dx=-1), agent faces West (DIR_WEST=2)\n  }\n\n  q = collections.deque()\n  # BFS queue state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  # Storing the current direction is crucial because `ACTION_USE` is dependent on agent orientation\n  # for non-grabbable items, and for BFS exploration, each unique (pos, dir) is a distinct state.\n\n  # If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # Initialize BFS: Start from the agent's current position and direction with an empty action path.\n  q.append((start_y, start_x, start_dir, []))\n  # Keep track of visited states (position + orientation) to prevent redundant exploration and infinite loops.\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None  # This variable will store the final sequence of actions if a valid path is found.\n\n  # Determine if the primitive is a \"grabbable\" item (picked up by moving onto its cell and using USE).\n  # Or if it's a \"non-grabbable\" item (interacted with from an adjacent cell).\n  is_primitive_grabbable = primitive in current_state.world.grabbable_indices\n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Optimization: If the current path length already exceeds MAX_COLLECT_STEPS,\n      # this branch cannot lead to a valid solution within the specified limits.\n      if len(path) >= MAX_COLLECT_STEPS: # Use >= because we still need space for ACTION_USE\n          continue\n\n      # --- Goal Check: Determine if the primitive can be collected from the current state (position and direction) ---\n\n      # Scenario 1: Primitive is \"grabbable\" and located on the agent's current cell.\n      # In this case, ACTION_USE picks it up, regardless of the agent's facing direction.\n      if is_primitive_grabbable and full_grid[curr_y, curr_x, primitive] > 0:\n          candidate_path = path + [ACTION_USE]\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              # BFS guarantees the shortest path, so we can stop once a valid one is found.\n              break \n      \n      # Scenario 2: Primitive is \"non-grabbable\" and located in the cell the agent is currently facing.\n      # In this case, ACTION_USE interacts with the object in front.\n      elif not is_primitive_grabbable: # Only consider this if it's not a grabbable item\n          facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n          # Check if the facing cell is within grid boundaries and contains the target primitive.\n          if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n              full_grid[facing_y, facing_x, primitive] > 0):\n              \n              candidate_path = path + [ACTION_USE]\n              if len(candidate_path) <= MAX_COLLECT_STEPS:\n                  path_to_execute = candidate_path\n                  break # Found the shortest path, exit BFS.\n\n      # --- Explore neighboring cells via movement actions ---\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          \n          # Pruning: If adding this move makes the path too long, skip.\n          if len(path) + 1 >= MAX_COLLECT_STEPS: # >= because we still need space for final ACTION_USE\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable.\n          # A cell is not traversable if it contains any item in the `impassable_for_movement` set.\n          if any(full_grid[next_y, next_x, k_idx] > 0 for k_idx in impassable_for_movement):\n              continue\n\n          # Check if this new (position, direction) state has already been visited.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # If all checks pass, add the new state to the queue for further exploration.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      # If no valid path was found within the step limit, return an empty list.\n      return []\n\n  for action in path_to_execute:\n      actions_taken.append(action)\n      # Perform the action in the environment.\n      # We ignore reward and observation for the purpose of this planning function.\n      reward, done, _ = env.step(action)\n      \n      # Update the internal state reference after each step to reflect the current environment.\n      current_state = env._current_state\n\n      # Check for early termination of the episode or if the goal was satisfied.\n      # If the episode ends (done is True) before the primitive is collected, it implies failure.\n      if done and current_state.inventory[primitive] <= 0:\n          return []\n\n      # If the primitive is successfully collected at any point, we can stop and return the path.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n  # Final check: After executing all actions in the `path_to_execute`, confirm collection.\n  # This handles cases where the primitive is collected on the very last action.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it indicates a discrepancy (e.g., dynamic environment changes, or logical error).\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:06:00.428715", "function_name": "collect", "function_body": "    actions = []\n    \n    max_steps_to_find = 200 # A safety limit to prevent infinite loops\n\n    # Get action mappings for clarity\n    # CraftLab's action_specs dict maps strings to integer actions\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    steps_taken = 0\n\n    while True:\n        # Access the current CraftState instance from the CraftLab environment\n        # This allows using CraftState's helper methods like .inventory, .pos, .grid, .next_to\n        current_state = env._current_state \n        \n        # 1. Check if the primitive is already in inventory\n        if current_state.inventory[primitive] > 0:\n            break # Primitive collected, success!\n\n        # Safety break to prevent infinite loops if primitive is unreachable or non-existent\n        if steps_taken >= max_steps_to_find:\n            break \n        \n        steps_taken += 1\n\n        # 2. Check if the primitive is adjacent (or on the same cell) and can be used\n        if current_state.next_to(primitive):\n            actions.append(ACTION_USE)\n            _reward, _done, _obs = env.step(ACTION_USE)\n            # After using, re-check inventory in the next loop iteration\n            continue \n\n        # 3. If not adjacent, find the primitive on the grid and move towards it\n        agent_pos = current_state.pos\n        grid = current_state.grid\n        \n        # Find all cells containing the primitive item\n        # np.argwhere returns (row, col) tuples where grid[row, col, primitive] > 0\n        primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n        if len(primitive_locations) == 0:\n            # Primitive not found on the visible grid and not in inventory.\n            # This could happen if it was already collected or is unreachable/non-existent.\n            break \n\n        # Find the closest primitive location using Manhattan distance\n        closest_primitive_pos = None\n        min_dist = float('inf')\n\n        for px, py in primitive_locations:\n            dist = abs(agent_pos[0] - px) + abs(agent_pos[1] - py)\n            if dist < min_dist:\n                min_dist = dist\n                closest_primitive_pos = (px, py)\n        \n        # This check is mostly for safety; closest_primitive_pos should not be None here\n        if closest_primitive_pos is None: \n            break\n\n        target_x, target_y = closest_primitive_pos\n        current_x, current_y = agent_pos\n\n        # Determine the best movement action (greedy approach)\n        dx = target_x - current_x\n        dy = target_y - current_y\n\n        action_to_take = -1 # Default to an invalid action\n\n        # Prioritize movement along the dimension with the largest difference\n        if abs(dx) > abs(dy):\n            if dx > 0:\n                action_to_take = ACTION_RIGHT\n            elif dx < 0:\n                action_to_take = ACTION_LEFT\n        else: # abs(dy) >= abs(dx) or dx == 0\n            if dy > 0:\n                action_to_take = ACTION_DOWN\n            elif dy < 0:\n                action_to_take = ACTION_UP\n            # If both dx and dy are 0, the agent is already at the target cell.\n            # In this case, next_to() should have caught it and performed USE.\n            # If action_to_take is still -1, it implies no valid movement\n            # and USE was not applicable (e.g., target is not a collectible resource).\n            if action_to_take == -1: \n                break \n\n        # Perform the chosen movement action\n        actions.append(action_to_take)\n        _reward, _done, _obs = env.step(action_to_take)\n        # Continue to the next loop iteration to re-evaluate the state\n\n    return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:06:01.402395", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Assuming env_factory.ACTIONS provides the numerical values for actions\n  # from env_factory import ACTIONS\n\n  # Direction mappings (assuming 0:N, 1:E, 2:S, 3:W based on typical DMLab/CraftWorld conventions)\n  # These map agent's current direction to a (dx, dy) vector if moving forward.\n  # This part is not strictly used by the current BFS logic but defines the relationship.\n  # DIR_VECTORS = {\n  #     0: (0, 1),   # North (dy=1 means increasing Y)\n  #     1: (1, 0),   # East\n  #     2: (0, -1),  # South\n  #     3: (-1, 0)   # West\n  # }\n\n  # Given a (dx, dy) relative position of a target, what direction should the agent face\n  POS_DELTA_TO_DIR = {\n      (0, 1): 0,   # North\n      (1, 0): 1,   # East\n      (0, -1): 2,  # South\n      (-1, 0): 3   # West\n  }\n\n  def get_target_dir_from_delta(dx, dy):\n      \"\"\"Calculates the target direction (0-3) for agent to face a neighbor at (dx, dy) relative position.\"\"\"\n      return POS_DELTA_TO_DIR.get((dx, dy), -1)\n\n  def get_turn_actions(current_dir, target_dir):\n      \"\"\"Returns a list of actions (LEFT/RIGHT) to change current_dir to target_dir.\"\"\"\n      actions = []\n      if current_dir == target_dir:\n          return actions\n\n      # Calculate clockwise distance (e.g., 0->1->2->3->0)\n      cw_dist = (target_dir - current_dir + 4) % 4\n      # Calculate counter-clockwise distance (e.g., 0->3->2->1->0)\n      ccw_dist = (current_dir - target_dir + 4) % 4\n\n      if cw_dist <= ccw_dist: # Prefer turning right or equal distance\n          for _ in range(cw_dist):\n              actions.append(env_factory.ACTIONS.RIGHT)\n      else: # Turn left\n          for _ in range(ccw_dist):\n              actions.append(env_factory.ACTIONS.LEFT)\n      return actions\n\n  def get_neighbor_coords(pos):\n      \"\"\"Returns a list of (nx, ny, dx, dy) for 3x3 neighborhood around pos.\"\"\"\n      px, py = pos\n      neighbors = []\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              if dx == 0 and dy == 0: # Skip the agent's own position\n                  continue\n              neighbors.append((px + dx, py + dy, dx, dy))\n      return neighbors\n\n  q = collections.deque()\n  # Visited set stores (agent_position, agent_direction) to avoid redundant explorations\n  visited = set()\n\n  # Reset the environment to a clean start state for the collection task.\n  # This also updates `env._current_state` internally.\n  env.reset(seed=0)\n  start_craft_state = env._current_state\n\n  # Add the initial state to the queue: (CraftState object, list of actions taken to reach this state)\n  q.append((start_craft_state, []))\n  visited.add((start_craft_state.pos, start_craft_state.dir))\n\n  # Pre-calculate which resources can be \"USE\"d to produce the 'primitive'\n  # This avoids repeated lookups inside the BFS loop.\n  use_recipes_for_primitive = []\n  for output_idx, recipe_details in env.world.cookbook.recipes.items():\n      if output_idx == primitive and recipe_details.get('_action') == 'use':\n          resource_idx = recipe_details.get('_resource')\n          if resource_idx is not None:\n              use_recipes_for_primitive.append(resource_idx)\n\n  # Define all possible movement actions\n  movement_actions = [\n      env_factory.ACTIONS.DOWN,\n      env_factory.ACTIONS.UP,\n      env_factory.ACTIONS.LEFT,\n      env_factory.ACTIONS.RIGHT\n  ]\n\n  # BFS loop\n  while q:\n      current_state, current_path_actions = q.popleft()\n\n      # 1. Check if the goal (primitive in inventory) is already satisfied\n      # This covers cases where the item is already collected, or if it's a grabbable item\n      # that was automatically picked up by moving onto its cell.\n      if current_state.inventory[primitive] > 0:\n          return current_path_actions\n\n      # 2. Check for 'USE' opportunities if adjacent to a required resource\n      for required_resource_idx in use_recipes_for_primitive:\n          # Check the 3x3 neighborhood around the agent's current position\n          for nx, ny, dx, dy in get_neighbor_coords(current_state.pos):\n              # Ensure the neighbor coordinates are within the grid bounds\n              grid_width, grid_height, _ = current_state.grid.shape\n              if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n                  continue\n\n              # If the required resource is found at the neighbor cell\n              if current_state.grid[nx, ny, required_resource_idx] > 0:\n                  # Found the required resource, now determine actions to USE it\n                  target_dir = get_target_dir_from_delta(dx, dy)\n                  \n                  if target_dir != -1: # Ensure a valid direction could be determined\n                      # Calculate the turning actions needed\n                      turn_actions = get_turn_actions(current_state.dir, target_dir)\n                      \n                      # Simulate applying the turning actions to get an intermediate state\n                      temp_state_after_turns = current_state\n                      for turn_action in turn_actions:\n                          _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                      # Simulate applying the USE action from the facing direction\n                      _, state_after_use = temp_state_after_turns.step(env_factory.ACTIONS.USE)\n\n                      # If the primitive is successfully collected after USE, we found a solution\n                      if state_after_use.inventory[primitive] > 0:\n                          return current_path_actions + turn_actions + [env_factory.ACTIONS.USE]\n\n      # 3. Explore movement actions\n      for action in movement_actions:\n          # Simulate the movement action\n          _, next_state = current_state.step(action)\n          next_state_key = (next_state.pos, next_state.dir) # Key for visited set\n\n          # If this new state hasn't been visited yet (to avoid cycles and redundant work)\n          if next_state_key not in visited:\n              visited.add(next_state_key)\n              q.append((next_state, current_path_actions + [action]))\n\n  # If the queue becomes empty and the goal hasn't been reached, no path was found\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:07:45.870415", "function_name": "collect", "function_body": "  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  current_inventory = features_dict['inventory'] # Get current inventory\n\n  # IMPROVEMENT: If the primitive is already in inventory, no actions are needed.\n  if current_inventory[primitive] > 0:\n    return []\n\n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # If the agent is already on the primitive, just use it.\n  # This check still makes sense even with the inventory check, as it handles the immediate next step\n  # if the item is present at the current location and not yet in inventory.\n  if current_grid[current_px, current_py, primitive] == 1:\n      return [_USE]\n\n  # Check if the primitive exists anywhere on the grid.\n  # This avoids running BFS if the item is not present.\n  primitive_exists_on_grid = False\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      if current_grid[x, y, primitive] == 1:\n        primitive_exists_on_grid = True\n        break\n    if primitive_exists_on_grid:\n        break\n\n  if not primitive_exists_on_grid:\n    return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path to any primitive location\n  # Queue stores tuples: (current_x, current_y)\n  # Assuming 'collections' is imported at a higher level, like 'numpy'.\n  q = collections.deque() \n  q.append(current_pos) \n  \n  # Dictionary to reconstruct path: maps child_pos -> (parent_pos, action_taken_to_reach_child)\n  # This avoids costly list concatenations during BFS by reconstructing the path at the end.\n  parent_map = {current_pos: (None, None)} # Sentinel for the starting node\n  \n  # Set to store visited positions to avoid cycles and re-processing longer paths\n  visited = {current_pos} \n\n  # Define possible movements and their corresponding actions\n  # (dx, dy): action\n  moves = {\n      (0, -1): _UP,    # North\n      (0, 1): _DOWN,   # South\n      (-1, 0): _LEFT,  # West\n      (1, 0): _RIGHT  # East\n  }\n\n  # Obstacle check function: A cell is considered an obstacle if it contains\n  # any non-grabbable item.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle).\"\"\"\n    for k in non_grabbable_items_set:\n      if grid[x, y, k] == 1:\n        return True\n    return False\n\n  target_found_pos = None\n\n  while q:\n    cx, cy = q.popleft()\n\n    # If the current position contains the primitive, we found a path.\n    # Since it's BFS, this is guaranteed to be the shortest path to *a* primitive.\n    if current_grid[cx, cy, primitive] == 1:\n      target_found_pos = (cx, cy)\n      break # Exit BFS as the shortest path is found\n\n    # Explore neighbors\n    for (dx, dy), action in moves.items():\n      nx, ny = cx + dx, cy + dy\n\n      # Check boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if already visited\n      if (nx, ny) in visited:\n        continue\n\n      # Check if the neighbor cell is an obstacle\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n\n      # If the neighbor is valid and not an obstacle, add it to the queue and parent map\n      q.append(((nx, ny)))\n      visited.add((nx, ny))\n      parent_map[(nx, ny)] = ((cx, cy), action)\n  \n  actions_to_take = []\n  if target_found_pos is not None:\n    # Reconstruct the path by backtracking from the target\n    path_reconstruction_reversed = []\n    current = target_found_pos\n    \n    # Backtrack until we reach the start position (where parent is None)\n    while parent_map[current][0] is not None:\n      parent, action = parent_map[current]\n      path_reconstruction_reversed.append(action)\n      current = parent\n    \n    # The path is built in reverse, so reverse it to get actions from start to target\n    actions_to_take = path_reconstruction_reversed[::-1] + [_USE] # Reverses list and adds USE\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:07:46.904445", "function_name": "collect", "function_body": "  import collections\n  # numpy is implicitly available from top-level imports and used as np\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global']\n  \n  WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape\n\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Agent's current direction (one-hot to int: 0=N, 1=E, 2=S, 3=W)\n  current_dir = np.argmax(features_dict['direction']) \n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Define possible movements (dx, dy) for pathfinding and their corresponding actions\n  move_deltas = [(0, -1), (0, 1), (-1, 0), (1, 0)] # North, South, West, East\n  move_actions = [_UP, _DOWN, _LEFT, _RIGHT]\n\n  # Obstacle check function: A cell is considered an obstacle if it contains\n  # any non-grabbable item.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle).\"\"\"\n    for k in non_grabbable_items_set:\n      if grid[x, y, k] == 1:\n        return True\n    return False\n\n  # Mapping from (dx, dy) to cardinal direction (int 0-3) for agent facing\n  # (dx, dy) represents the vector from agent's position to the item's position\n  direction_deltas = {\n      (0, -1): 0, # North (dx=0, dy=-1)\n      (1, 0): 1,  # East (dx=1, dy=0)\n      (0, 1): 2,  # South (dx=0, dy=1)\n      (-1, 0): 3, # West (dx=-1, dy=0)\n  }\n\n  # Use Breadth-First Search (BFS) to find the shortest path to either:\n  # 1. The primitive cell itself (for direct pickup if _USE works on the current square)\n  # 2. A cell adjacent to the primitive (for directional interaction if _USE needs facing)\n  q = collections.deque()\n  q.append(current_pos) \n  \n  # Dictionary to reconstruct path: maps child_pos -> (parent_pos, action_taken_to_reach_child)\n  parent_map = {current_pos: (None, None)} \n  \n  # Set to store visited positions to avoid cycles\n  visited = {current_pos} \n\n  # `final_approach_pos`: The cell the agent will move to *before* performing _USE.\n  # `item_pos_for_use`: The actual position of the primitive being targeted for _USE.\n  # If agent moves onto item, these will be the same. If agent is adjacent, they will differ.\n  final_approach_pos = None \n  item_pos_for_use = None   \n\n  while q:\n    cx, cy = q.popleft()\n\n    # --- Priority 1: Check if the current position itself contains the primitive. ---\n    # This is typical for \"grabbable\" items that are picked up by standing on them.\n    if current_grid[cx, cy, primitive] == 1:\n      final_approach_pos = (cx, cy)\n      item_pos_for_use = (cx, cy)\n      break # Shortest path found directly to the item\n\n    # --- Priority 2: Check if any adjacent cell contains the primitive. ---\n    # This is for interactions where the agent needs to be next to an item and face it.\n    for dx_adj, dy_adj in move_deltas: # Iterate through neighbors of the current cell\n        nx_adj, ny_adj = cx + dx_adj, cy + dy_adj\n\n        # Check boundaries for the adjacent cell (where the primitive might be)\n        if not (0 <= nx_adj < WIDTH and 0 <= ny_adj < HEIGHT):\n            continue\n        \n        # If the adjacent cell `(nx_adj, ny_adj)` contains the primitive\n        if current_grid[nx_adj, ny_adj, primitive] == 1:\n            # We found a primitive at (nx_adj, ny_adj), and (cx, cy) is adjacent to it.\n            # This (cx, cy) is a valid `final_approach_pos`.\n            final_approach_pos = (cx, cy)\n            item_pos_for_use = (nx_adj, ny_adj)\n            break # Shortest path found to an adjacent cell from which to interact.\n\n    if final_approach_pos is not None:\n        break # Exit BFS as a target (either on-top or adjacent) has been found\n\n    # --- Explore neighbors for pathfinding (standard BFS expansion) ---\n    for (dx, dy), action in zip(move_deltas, move_actions):\n      nx, ny = cx + dx, cy + dy\n\n      # Check boundaries for neighbor cell\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n      # Check if already visited\n      if (nx, ny) in visited:\n        continue\n      # Check if the neighbor cell is an obstacle\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n\n      # If valid, add to queue and record parent\n      q.append(((nx, ny)))\n      visited.add((nx, ny))\n      parent_map[(nx, ny)] = ((cx, cy), action)\n\n  actions_to_take = []\n  if final_approach_pos is not None:\n    # Reconstruct the path by backtracking from the `final_approach_pos`\n    path_reconstruction_reversed = []\n    current = final_approach_pos\n    \n    # Backtrack until we reach the start position (where parent is None)\n    while parent_map[current][0] is not None:\n      parent, action = parent_map[current]\n      path_reconstruction_reversed.append(action)\n      current = parent\n    \n    # The path is built in reverse, so reverse it to get actions from start to `final_approach_pos`\n    actions_to_take = path_reconstruction_reversed[::-1]\n\n    # Now, add the final `_USE` action, possibly with turns if needed\n    if final_approach_pos == item_pos_for_use:\n        # Agent has moved onto the primitive's square (direct pickup)\n        actions_to_take.append(_USE)\n    else:\n        # Agent is adjacent to the primitive. It needs to turn to face it and then use.\n        # Calculate the vector from agent's final approach position to the item's position\n        dx_face = item_pos_for_use[0] - final_approach_pos[0]\n        dy_face = item_pos_for_use[1] - final_approach_pos[1]\n        \n        target_dir_idx = direction_deltas.get((dx_face, dy_face))\n\n        if target_dir_idx is not None:\n            # Calculate how many turns (clockwise/counter-clockwise) are needed\n            # (current_dir + X) % 4 == target_dir_idx\n            # diff_dir = (target_dir_idx - current_dir + 4) % 4\n            diff_dir = (target_dir_idx - current_dir + 4) % 4\n            \n            if diff_dir == 1: # One Right turn\n                actions_to_take.append(_RIGHT)\n            elif diff_dir == 2: # Two turns (180 degrees)\n                actions_to_take.extend([_RIGHT, _RIGHT]) # Could also be [_LEFT, _LEFT]\n            elif diff_dir == 3: # One Left turn\n                actions_to_take.append(_LEFT)\n            # If diff_dir == 0, agent is already facing the correct direction, no turn needed.\n        \n        actions_to_take.append(_USE) # Perform the use action after turning\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:09:00.196825", "function_name": "collect", "function_body": "  import collections # Ensure collections is available\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Define internal direction mapping for consistency with (dx, dy) deltas.\n  # Assuming 0:North (UP), 1:East (RIGHT), 2:South (DOWN), 3:West (LEFT)\n  DIR_N = 0\n  DIR_E = 1\n  DIR_S = 2\n  DIR_W = 3\n\n  # Map movement actions to the direction the agent will face after the action.\n  # E.g., moving UP (_UP) makes the agent face North (DIR_N).\n  action_to_new_dir = {\n      _UP: DIR_N,\n      _RIGHT: DIR_E,\n      _DOWN: DIR_S,\n      _LEFT: DIR_W,\n  }\n\n  # Map direction indices to their (dx, dy) deltas for the cell \"in front\" of the agent.\n  # (dx, dy) where dx is change in x-coordinate, dy is change in y-coordinate.\n  # (0,-1) for North (Up), (1,0) for East (Right), (0,1) for South (Down), (-1,0) for West (Left).\n  dir_to_delta = {\n      DIR_N: (0, -1),\n      DIR_E: (1, 0),\n      DIR_S: (0, 1),\n      DIR_W: (-1, 0)\n  }\n\n  # Get current state information from the environment's observations.\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid.\n  \n  # Get grid dimensions from the current grid's shape.\n  WIDTH, HEIGHT, N_KINDS = current_grid.shape\n\n  # Denormalize current agent position from [0,1] range to grid coordinates.\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  # current_pos = (current_px, current_py) # Not directly used but useful for understanding.\n\n  # Convert one-hot initial direction to an integer index (0-3).\n  initial_dir_idx = np.argmax(features_dict['direction'])\n\n  # Pre-check: If the primitive is not grabbable, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Identify non-grabbable items that act as obstacles for agent movement.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item that blocks movement.\"\"\"\n    # A cell is an obstacle if it contains any non-grabbable item.\n    for k in non_grabbable_items_set:\n      if grid[x, y, k] == 1:\n        return True\n    return False\n\n  # Use Breadth-First Search (BFS) to find the shortest path in terms of actions.\n  # The queue stores tuples: (current_x, current_y, current_direction_idx, [path_actions_to_reach_here]).\n  q = collections.deque()\n  q.append((current_px, current_py, initial_dir_idx, []))\n  \n  # Set to store visited states to avoid cycles and re-processing longer paths.\n  # A state is defined by (x, y, direction_idx) because the 'USE' action is direction-dependent.\n  visited = {(current_px, current_py, initial_dir_idx)}\n\n  while q:\n    cx, cy, c_dir_idx, c_path = q.popleft()\n\n    # 1. Check if the primitive can be collected from the current state (position + direction).\n    # The _USE action applies to the cell directly in front of the agent.\n    target_dx, target_dy = dir_to_delta[c_dir_idx]\n    tx, ty = cx + target_dx, cy + target_dy\n\n    # Check if the cell in front is within bounds and contains the primitive we want to collect.\n    if (0 <= tx < WIDTH and 0 <= ty < HEIGHT and\n        current_grid[tx, ty, primitive] == 1):\n      # If the primitive is directly in front, we found a path to collect it!\n      return c_path + [_USE]\n\n    # 2. Explore movement actions (UP, DOWN, LEFT, RIGHT).\n    # Each movement action results in a new position and a new facing direction.\n    for action, new_dir_idx in action_to_new_dir.items():\n      # Calculate the new position after performing this movement action.\n      # The delta for movement is based on the direction the agent will end up facing.\n      move_dx, move_dy = dir_to_delta[new_dir_idx]\n      nx, ny = cx + move_dx, cy + move_dy\n\n      # Check if the new position is within the grid boundaries.\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if the new cell is blocked by an obstacle.\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n\n      # If this new state (position and direction) has not been visited before,\n      # add it to the queue for further exploration.\n      if (nx, ny, new_dir_idx) not in visited:\n        new_path = c_path + [action]\n        q.append((nx, ny, new_dir_idx, new_path))\n        visited.add((nx, ny, new_dir_idx))\n  \n  # If the queue becomes empty and no path to collect the primitive was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:09:00.267039", "function_name": "collect", "function_body": "    _actions_map = env.action_specs()\n    _DOWN = _actions_map['DOWN']\n    _UP = _actions_map['UP']\n    _LEFT = _actions_map['LEFT']\n    _RIGHT = _actions_map['RIGHT']\n    _USE = _actions_map['USE']\n\n    # Define internal direction mapping for consistency with (dx, dy) deltas\n    # Assuming 0:North (UP), 1:East (RIGHT), 2:South (DOWN), 3:West (LEFT)\n    DIR_N = 0\n    DIR_E = 1\n    DIR_S = 2\n    DIR_W = 3\n\n    # Map movement actions to the direction the agent will face after the action\n    action_to_new_dir = {\n        _UP: DIR_N,\n        _RIGHT: DIR_E,\n        _DOWN: DIR_S,\n        _LEFT: DIR_W,\n    }\n\n    # Map direction indices to their (dx, dy) deltas for the cell \"in front\"\n    dir_to_delta = {\n        DIR_N: (0, -1),\n        DIR_E: (1, 0),\n        DIR_S: (0, 1),\n        DIR_W: (-1, 0)\n    }\n\n    # Get current state information from the environment's observations\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    \n    current_grid = features_dict['features_global'] # Full allocentric grid\n    \n    # Get grid dimensions\n    WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape\n\n    # Denormalize current agent position\n    current_pos_normalized = features_dict['pos']\n    current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n    current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n    current_pos = (current_px, current_py)\n\n    # Convert one-hot initial direction to an integer index\n    initial_dir_idx = np.argmax(features_dict['direction'])\n\n    # Check if the primitive is grabbable. If not, it cannot be collected.\n    if primitive not in env.world.grabbable_indices:\n        return []\n\n    # Identify non-grabbable items that act as obstacles\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    def is_obstacle(x, y, grid, non_grabbable_items_set):\n        \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle) or is out of bounds.\"\"\"\n        if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n            return True # Out of bounds is an obstacle\n        for k in non_grabbable_items_set:\n            if grid[x, y, k] == 1:\n                return True\n        return False\n\n    # Pre-compute all locations of the primitive for heuristic calculation\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if current_grid[x, y, primitive] == 1:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations: # No primitive of the desired kind found on the map\n        return []\n\n    # Heuristic function (Manhattan distance to closest primitive location)\n    def heuristic(pos):\n        min_dist = float('inf')\n        px, py = pos\n        for target_px, target_py in primitive_locations:\n            dist = abs(px - target_px) + abs(py - target_py)\n            min_dist = min(min_dist, dist)\n        return min_dist\n\n    # A* specific data structures\n    # open_set: Priority queue of (f_score, g_score, state_tuple)\n    # state_tuple = (x, y, direction_idx)\n    open_set = [] \n    \n    # visited_g_scores: Dictionary mapping state_tuple to the lowest g_score (cost from start) found so far.\n    # This acts as both the g_score map and the implicit closed set.\n    visited_g_scores = {}\n    \n    # came_from: Dictionary mapping state_tuple to (previous_state_tuple, action_taken_to_reach_current)\n    came_from = {}\n\n    start_state = (current_px, current_py, initial_dir_idx)\n    visited_g_scores[start_state] = 0\n    # Push (f_score, g_score, state) to the priority queue\n    heapq.heappush(open_set, (heuristic(current_pos), 0, start_state)) \n\n    while open_set:\n        # Pop the state with the lowest f_score (estimated total cost)\n        current_f, current_g, (cx, cy, c_dir_idx) = heapq.heappop(open_set)\n\n        # If we have found a path to this state that is worse than one already processed, skip\n        if current_g > visited_g_scores.get((cx, cy, c_dir_idx), float('inf')):\n            continue\n\n        # Check if the current state can achieve the goal (by using the primitive)\n        # The agent is at (cx, cy) facing c_dir_idx\n        target_dx, target_dy = dir_to_delta[c_dir_idx]\n        tx, ty = cx + target_dx, cy + target_dy\n\n        # Check if the cell in front is within bounds and contains the primitive\n        if (0 <= tx < WIDTH and 0 <= ty < HEIGHT and\n            current_grid[tx, ty, primitive] == 1):\n            # Goal reached! Reconstruct path by backtracking from the current state\n            path = []\n            current = (cx, cy, c_dir_idx)\n            while current in came_from:\n                prev_state, action = came_from[current]\n                path.append(action)\n                current = prev_state\n            path.reverse() # Path is built in reverse, so reverse it\n            return path + [_USE] # Append the final USE action\n\n        # Explore possible movement actions from the current state\n        for action, new_dir_idx in action_to_new_dir.items():\n            # Calculate new position based on the action's implicit direction\n            move_dx, move_dy = dir_to_delta[new_dir_idx]\n            nx, ny = cx + move_dx, cy + move_dy\n            next_state = (nx, ny, new_dir_idx)\n\n            # Cost to move is 1 for each action\n            tentative_g_score = current_g + 1\n\n            # Check if the new cell is an obstacle or out of bounds\n            if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n                continue\n\n            # If a shorter path to next_state is found (or it's a new state)\n            if tentative_g_score < visited_g_scores.get(next_state, float('inf')):\n                visited_g_scores[next_state] = tentative_g_score\n                h_score = heuristic((nx, ny))\n                f_score = tentative_g_score + h_score\n                heapq.heappush(open_set, (f_score, tentative_g_score, next_state))\n                came_from[next_state] = ((cx, cy, c_dir_idx), action)\n    \n    # If the open set becomes empty and no path to collect the primitive was found\n    return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:10:37.077113", "function_name": "collect", "function_body": "    actions_taken = []\n    \n    # Constants for actions as defined by CraftLab's action_specs.\n    # These are fixed integer values: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Maximum steps to attempt collection, to prevent infinite loops in unreachable scenarios.\n    MAX_COLLECTION_ATTEMPTS = 1000 \n\n    for _ in range(MAX_COLLECTION_ATTEMPTS):\n        current_state = env._current_state\n        \n        # 1. Check if the primitive is already in the agent's inventory.\n        if current_state.inventory[primitive] > 0:\n            return actions_taken\n\n        # 2. Check if the primitive is in the 3x3 neighborhood of the agent.\n        if current_state.next_to(primitive):\n            # If next to, attempt to USE (collect) it.\n            actions_taken.append(ACTION_USE)\n            reward, done, observations = env.step(ACTION_USE)\n            \n            if done: # If the environment signaled termination (e.g., max_steps reached).\n                return actions_taken\n            \n            # After trying to USE, re-check inventory. If collected, we are done.\n            if env._current_state.inventory[primitive] > 0:\n                return actions_taken\n            \n            # If USE didn't result in collection, it might mean the item is not directly grabbable\n            # or requires specific conditions (e.g., a workbench). We continue the loop,\n            # allowing the agent to potentially move away and search for another instance.\n\n        # 3. Find the closest instance of the primitive on the grid and move towards it.\n        observations = env.observations()\n        # 'features_global' provides the full allocentric (world-view) grid.\n        grid = observations['features_dict']['features_global']\n        agent_pos = current_state.pos # Agent's current position (row, col)\n\n        # Find all locations where the primitive exists on the grid.\n        primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n\n        if len(primitive_locations) == 0:\n            # Primitive not found anywhere on the map. This implies it's unreachable or doesn't exist.\n            return actions_taken # Cannot collect, so return current actions (failed to complete task).\n\n        # Find the primitive location with the minimum Manhattan distance to the agent.\n        min_dist = float('inf')\n        target_loc = None\n\n        for loc_r, loc_c in primitive_locations:\n            dist = abs(loc_r - agent_pos[0]) + abs(loc_c - agent_pos[1])\n            if dist < min_dist:\n                min_dist = dist\n                target_loc = (loc_r, loc_c)\n        \n        # This check is a safeguard; target_loc should not be None if primitive_locations was not empty.\n        if target_loc is None:\n            return actions_taken \n\n        # Calculate the differences in row and column coordinates to the target.\n        dr = target_loc[0] - agent_pos[0]\n        dc = target_loc[1] - agent_pos[1]\n\n        # If already at the target location (min_dist == 0), but not yet collected (checked by steps 1 & 2).\n        # This implies the agent is on the same square as the primitive, but it couldn't be collected.\n        # This usually means it's an uncollectable entity or requires a crafting step.\n        if dr == 0 and dc == 0:\n            return actions_taken \n\n        # Determine the primary movement direction (vertical or horizontal) based on the larger distance.\n        # This aims for efficient pathfinding.\n        move_attempted = False\n        \n        # Prioritize vertical movement if the vertical difference is greater or equal.\n        if abs(dr) >= abs(dc) and dr != 0: \n            action_to_try = ACTION_DOWN if dr > 0 else ACTION_UP\n            \n            # Attempt the primary movement.\n            actions_taken.append(action_to_try)\n            prev_pos = env._current_state.pos # Store position before step to detect collisions.\n            reward, done, observations = env.step(action_to_try)\n            \n            if done: return actions_taken\n            \n            if env._current_state.pos != prev_pos: # Successfully moved.\n                move_attempted = True\n            else: # Hit a wall trying the primary (vertical) move.\n                # Fallback to secondary (horizontal) move if available.\n                if dc != 0:\n                    action_to_try = ACTION_RIGHT if dc > 0 else ACTION_LEFT\n                    actions_taken.append(action_to_try)\n                    prev_pos = env._current_state.pos # Update prev_pos for second attempt.\n                    reward, done, observations = env.step(action_to_try)\n                    if done: return actions_taken\n                    if env._current_state.pos != prev_pos: # Successfully moved with secondary.\n                        move_attempted = True\n        \n        # If horizontal movement is prioritized (abs(dc) > abs(dr)).\n        elif abs(dc) > abs(dr) and dc != 0: \n            action_to_try = ACTION_RIGHT if dc > 0 else ACTION_LEFT\n            \n            actions_taken.append(action_to_try)\n            prev_pos = env._current_state.pos\n            reward, done, observations = env.step(action_to_try)\n            \n            if done: return actions_taken\n            \n            if env._current_state.pos != prev_pos: # Successfully moved.\n                move_attempted = True\n            else: # Hit a wall trying the primary (horizontal) move.\n                # Fallback to secondary (vertical) move if available.\n                if dr != 0:\n                    action_to_try = ACTION_DOWN if dr > 0 else ACTION_UP\n                    actions_taken.append(action_to_try)\n                    prev_pos = env._current_state.pos # Update prev_pos for second attempt.\n                    reward, done, observations = env.step(action_to_try)\n                    if done: return actions_taken\n                    if env._current_state.pos != prev_pos: # Successfully moved with secondary.\n                        move_attempted = True\n                            \n        # Fallback: If no targeted movement strategy worked (e.g., completely stuck, or target unapproachable).\n        # Perform a random exploratory move to try and get unstuck or reveal new paths.\n        if not move_attempted:\n            random_action = np.random.choice([ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT])\n            actions_taken.append(random_action)\n            reward, done, observations = env.step(random_action)\n            if done: return actions_taken\n\n    # If MAX_COLLECTION_ATTEMPTS is reached without successfully collecting the primitive,\n    # or if the environment signaled 'done' during exploration.\n    return actions_taken # Indicate failure to collect within the given attempts.", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:10:38.049487", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants (assuming these are defined globally or accessible from CraftWorld/CraftLab)\n  # For the purpose of this function, we'll define them locally.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Check if the primitive is already in the agent's inventory\n  if env._current_state.inventory[primitive] > 0:\n      return [] # Already collected, no actions needed\n\n  initial_state = env._current_state\n  grid = initial_state.grid\n  start_pos = initial_state.pos\n  width, height, _ = grid.shape\n\n  # 1. Identify all locations of the target primitive on the grid and determine\n  #    all valid adjacent positions from which the primitive can be 'USE'd.\n  target_adjacent_cells = set()\n  primitive_found_on_grid = False\n\n  # Relative offsets for checking 4 neighbors (adj_x, adj_y)\n  # An agent at (ax, ay) can USE an item at (px, py) if (ax, ay) is adjacent to (px, py).\n  neighbor_offsets = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Left, Right, Up, Down\n\n  for x in range(width):\n      for y in range(height):\n          # If the current cell contains the primitive\n          if grid[x, y, primitive] == 1:\n              primitive_found_on_grid = True\n              # Add all valid neighboring cells to the set of target_adjacent_cells\n              for dx, dy in neighbor_offsets:\n                  adj_x, adj_y = x + dx, y + dy\n                  # Check if the adjacent cell is within grid boundaries\n                  if 0 <= adj_x < width and 0 <= adj_y < height:\n                      # We assume all valid grid cells are traversable unless they contain the target primitive itself.\n                      # The agent needs to be *next* to the item to USE it, not on top of it.\n                      # So, (x, y) (the primitive's location) itself is not a target_adjacent_cell.\n                      target_adjacent_cells.add((adj_x, adj_y))\n  \n  # If the primitive is not on the grid at all, no actions can collect it.\n  if not primitive_found_on_grid:\n      return []\n\n  # If the agent is already in a position adjacent to the primitive, just USE.\n  # This uses the `next_to` helper from CraftState.\n  if initial_state.next_to(primitive):\n      return [USE]\n\n  # 2. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    from the agent's current position to any of the target_adjacent_cells.\n  queue = collections.deque([(start_pos, [])]) # (current_position, path_taken_to_reach_here)\n  visited = {start_pos} # Set of visited positions to avoid cycles and redundant exploration\n\n  # Map actions to their (dx, dy) movements\n  action_moves = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0)\n  }\n\n  best_path = None\n\n  while queue:\n      current_pos, path = queue.popleft()\n\n      # If the current position is one of our target_adjacent_cells, we found the shortest path.\n      if current_pos in target_adjacent_cells:\n          best_path = path\n          break # Stop BFS as we found the shortest path\n\n      # Explore neighboring cells\n      for action, (dx, dy) in action_moves.items():\n          next_pos = (current_pos[0] + dx, current_pos[1] + dy)\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= next_pos[0] < width and 0 <= next_pos[1] < height):\n              continue\n\n          # Check if the next position has already been visited\n          if next_pos in visited:\n              continue\n\n          # Add the next position to the queue for exploration\n          visited.add(next_pos)\n          queue.append((next_pos, path + [action]))\n\n  # If a path was found, append the USE action at the end\n  if best_path is not None:\n      return best_path + [USE]\n  else:\n      # No path found to any cell adjacent to the primitive\n      return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:11:48.505936", "function_name": "collect", "function_body": "    actions_taken = []\n    MAX_COLLECTION_STEPS = 200 # A reasonable limit to prevent infinite loops\n\n    # Get initial inventory to check for collection success\n    obs = env.observations()\n    initial_inventory = obs[\"features_dict\"][\"inventory\"].copy()\n\n    for step_count in range(MAX_COLLECTION_STEPS):\n        # Get fresh observations and current state\n        obs = env.observations()\n        current_inventory = obs[\"features_dict\"][\"inventory\"]\n        # Access the underlying CraftState for the next_to check\n        current_state = env._current_state \n\n        # Check if the primitive has been collected\n        if current_inventory[primitive] > initial_inventory[primitive]:\n            break # Goal achieved\n\n        action = None\n        # First, check if the primitive is in the immediate vicinity (3x3 neighborhood)\n        if current_state.next_to(primitive):\n            action = env.action_specs()[\"USE\"]\n        else:\n            # If not immediately next to it, try to find it in the egocentric view\n            ego_features = obs[\"features_dict\"][\"features_ego\"]\n            \n            # features_ego shape is (height, width, n_kinds)\n            window_height, window_width, _n_kinds = ego_features.shape\n            # Agent's position in ego view (center_y for row, center_x for col)\n            center_y, center_x = window_height // 2, window_width // 2 \n\n            # Find all coordinates (row, col) where the primitive is present\n            primitive_rows, primitive_cols = np.where(ego_features[:, :, primitive] > 0)\n\n            if len(primitive_rows) > 0:\n                # If primitive is visible, find the closest one (Manhattan distance)\n                min_dist = float('inf')\n                closest_target_col, closest_target_row = -1, -1\n\n                for i in range(len(primitive_rows)):\n                    p_row, p_col = primitive_rows[i], primitive_cols[i]\n                    # Calculate Manhattan distance from agent's center to primitive\n                    current_dist = abs(p_col - center_x) + abs(p_row - center_y)\n                    if current_dist < min_dist:\n                        min_dist = current_dist\n                        closest_target_col, closest_target_row = p_col, p_row\n\n                # Determine movement action based on relative position of the closest primitive\n                # dx: horizontal displacement (positive means target is right)\n                # dy: vertical displacement (positive means target is down)\n                dx = closest_target_col - center_x\n                dy = closest_target_row - center_y\n\n                # Prioritize horizontal movement if target is further horizontally,\n                # otherwise vertical. This creates L-shaped paths.\n                if abs(dx) > abs(dy):\n                    if dx < 0:\n                        action = env.action_specs()[\"LEFT\"]\n                    elif dx > 0:\n                        action = env.action_specs()[\"RIGHT\"]\n                elif abs(dy) > 0: # If horizontal distance is not greater, or dx is 0\n                    if dy < 0:\n                        action = env.action_specs()[\"UP\"]\n                    elif dy > 0:\n                        action = env.action_specs()[\"DOWN\"]\n            \n            if action is None:\n                # If primitive is not visible in egocentric view or no clear movement,\n                # explore randomly.\n                move_actions = [env.action_specs()[\"DOWN\"], env.action_specs()[\"UP\"],\n                                env.action_specs()[\"LEFT\"], env.action_specs()[\"RIGHT\"]]\n                action = np.random.choice(move_actions)\n        \n        # Execute the chosen action\n        _reward, done, _ = env.step(action)\n        actions_taken.append(action)\n\n        # If the environment signals \"done\" before collection, something went wrong\n        if done and current_inventory[primitive] <= initial_inventory[primitive]:\n            break # Stop trying if the episode ended prematurely\n\n    return actions_taken", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:11:49.515343", "function_name": "collect", "function_body": "  import collections\n\n  # Define actions mapping (consistent with CraftLab action_specs)\n  ACTIONS = {\n      \"DOWN\": 0,\n      \"UP\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4,\n  }\n\n  initial_state = env._current_state  # Access the current CraftState from CraftLab\n\n  # Max search depth to prevent excessive computation for complex environments\n  # This limits the scope of the BFS. Adjust as needed for specific environments.\n  MAX_SEARCH_DEPTH = 50 \n\n  # Queue for BFS: stores tuples of (current_state_object, list_of_actions_to_reach_this_state)\n  q = collections.deque([(initial_state, [])]) \n  \n  # Set to keep track of visited states to avoid cycles and redundant exploration.\n  # A state is uniquely identified by (agent_position, agent_direction, current_inventory_tuple).\n  # Inventory (numpy array) is converted to a tuple to make it hashable for the set.\n  visited_states = {(initial_state.pos, initial_state.dir, tuple(initial_state.inventory))}\n\n  while q:\n      current_state, current_path = q.popleft()\n\n      # Pruning: If the current path length exceeds MAX_SEARCH_DEPTH, stop exploring this branch.\n      if len(current_path) >= MAX_SEARCH_DEPTH:\n          continue\n\n      # Check if the primitive is already in the agent's inventory.\n      if current_state.inventory[primitive] > 0:\n          return current_path\n\n      # Check if the agent is currently next to the primitive.\n      # If so, adding the 'USE' action should collect it.\n      if current_state.next_to(primitive):\n          return current_path + [ACTIONS[\"USE\"]]\n\n      # Explore possible movement actions (DOWN, UP, LEFT, RIGHT).\n      # The 'USE' action is only considered when the agent is adjacent to the primitive.\n      movement_actions = [ACTIONS[\"DOWN\"], ACTIONS[\"UP\"], ACTIONS[\"LEFT\"], ACTIONS[\"RIGHT\"]]\n\n      for action in movement_actions:\n          # Simulate the step using the CraftState's `step` method.\n          # This method returns a new CraftState object representing the state after the action.\n          # The reward is not relevant for pathfinding here, so it's ignored (`_reward`).\n          _reward, next_state = current_state.step(action)\n\n          # Create a hashable key for the next state to check against visited states.\n          next_state_key = (next_state.pos, next_state.dir, tuple(next_state.inventory))\n\n          # If this next state has not been visited yet, add it to the queue and the visited set.\n          if next_state_key not in visited_states:\n              visited_states.add(next_state_key)\n              q.append((next_state, current_path + [action]))\n\n  # If the BFS completes without finding a path to collect the primitive\n  # within the specified MAX_SEARCH_DEPTH, return an empty list.\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:13:16.229182", "function_name": "collect", "function_body": "    # Get action mappings from the environment\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    actions = []\n    \n    # Get the initial state from the environment\n    state = env._current_state\n\n    # Set a maximum number of attempts to prevent infinite loops,\n    # especially if the primitive is unreachable or logic is flawed.\n    # A generous upper bound based on grid size (e.g., 2 * width * height)\n    grid_width = state.grid.shape[0]\n    grid_height = state.grid.shape[1]\n    max_attempts = 2 * grid_width * grid_height + 10 \n\n    for _ in range(max_attempts):\n        # 1. Check if the primitive is already collected\n        if state.inventory[primitive] > 0:\n            return actions\n\n        # 2. Find the closest instance of the primitive on the grid\n        min_dist = float('inf')\n        target_pos = None\n        \n        for x in range(grid_width):\n            for y in range(grid_height):\n                # Check if this cell contains the desired primitive\n                if state.grid[x, y, primitive] > 0:\n                    # Calculate Manhattan distance from current position\n                    dist = abs(x - state.pos[0]) + abs(y - state.pos[1])\n                    if dist < min_dist:\n                        min_dist = dist\n                        target_pos = (x, y)\n\n        # If the primitive is not found anywhere on the grid, it's unreachable\n        if target_pos is None:\n            return [] # Cannot collect\n\n        # 3. If agent is next to the primitive, use it\n        if state.next_to(primitive):\n            actions.append(USE)\n            # Apply the USE action to the environment\n            _, _, _ = env.step(USE) \n            state = env._current_state # Update to the new state\n            # Continue the loop to re-check inventory in the next iteration\n            continue\n\n        # 4. If not next to the primitive, move towards it\n        current_x, current_y = state.pos\n        target_x, target_y = target_pos\n\n        move = None\n        \n        # Determine the best move by prioritizing the larger dimension difference\n        # This is a greedy move and does not account for obstacles (walls, etc.)\n        if abs(target_x - current_x) >= abs(target_y - current_y):\n            if target_x > current_x:\n                move = RIGHT\n            elif target_x < current_x:\n                move = LEFT\n            else: # target_x == current_x, so move along y-axis\n                if target_y > current_y:\n                    move = DOWN\n                elif target_y < current_y:\n                    move = UP\n        else: # abs(target_y - current_y) > abs(target_x - current_x)\n            if target_y > current_y:\n                move = DOWN\n            elif target_y < current_y:\n                move = UP\n            else: # target_y == current_y, so move along x-axis\n                if target_x > current_x:\n                    move = RIGHT\n                elif target_x < current_x:\n                    move = LEFT\n        \n        # Execute the determined move\n        if move is not None:\n            actions.append(move)\n            # Apply the movement action to the environment\n            _, _, _ = env.step(move)\n            state = env._current_state # Update to the new state\n        else:\n            # This condition implies current_pos == target_pos,\n            # but next_to(primitive) was False. This should not happen\n            # if target_pos actually contains the primitive and next_to checks\n            # the 3x3 neighborhood (including the current cell).\n            # If it occurs, it means we are stuck or the primitive is unreachable\n            # through standard movement/collection.\n            return [] # Cannot make progress\n\n    # If the loop completes, it means max_attempts was reached without\n    # successfully collecting the primitive.\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:13:16.301327", "function_name": "collect", "function_body": "    # Action integer IDs are fixed for CraftLab environment\n    action_map = env.action_specs()\n    ACT_UP = action_map['UP']\n    ACT_DOWN = action_map['DOWN']\n    ACT_LEFT = action_map['LEFT']\n    ACT_RIGHT = action_map['RIGHT']\n    ACT_USE = action_map['USE']\n\n    # Direction vectors: (dr, dc) for (UP, RIGHT, DOWN, LEFT)\n    # These correspond to the integer representations of agent's facing direction.\n    # 0: Up/North (row decreases)\n    # 1: Right/East (col increases)\n    # 2: Down/South (row increases)\n    # 3: Left/West (col decreases)\n    DR = [-1, 0, 1, 0]\n    DC = [0, 1, 0, -1]\n\n    # Get current observations and state details\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    current_pos_rc = tuple(obs['features_dict']['pos']) # Agent's (row, col)\n    current_inventory = obs['features_dict']['inventory']\n    \n    # Get agent's current direction from the internal state.\n    # The agent's `dir` attribute is crucial for the `USE` action,\n    # and it updates based on movement actions (e.g., moving UP sets dir to 0).\n    initial_dir = env._current_state.dir\n\n    # Grid dimensions for boundary checks\n    R_MAX, C_MAX, _ = grid.shape\n    R_MAX -= 1 # Convert to 0-indexed max row\n    C_MAX -= 1 # Convert to 0-indexed max col\n\n    # 1. Check if the primitive is already in the inventory\n    if current_inventory[primitive] > 0:\n        return [] # Primitive already collected, no actions needed\n\n    # 2. Perform a Breadth-First Search (BFS) to find the shortest path to collect the primitive.\n    #    The BFS state tracks (row, column, current_direction).\n    #    Each movement action (UP, DOWN, LEFT, RIGHT) updates both position and direction.\n    #    The goal is to reach a state where the agent is facing a cell that contains the primitive.\n\n    # Queue for BFS: stores (row, col, current_direction, list_of_actions_taken_so_far)\n    q = collections.deque()\n    # Set to keep track of visited states (r, c, dir) to prevent cycles and redundant exploration\n    visited = set() \n\n    # Add the initial state to the queue\n    q.append((current_pos_rc[0], current_pos_rc[1], initial_dir, []))\n    visited.add((current_pos_rc[0], current_pos_rc[1], initial_dir))\n\n    while q:\n        r, c, current_dir, actions_so_far = q.popleft()\n\n        # Check if the cell directly in front of the agent (based on current_dir) contains the primitive\n        front_r, front_c = r + DR[current_dir], c + DC[current_dir]\n        \n        # Check if the target cell is within grid bounds\n        if 0 <= front_r <= R_MAX and 0 <= front_c <= C_MAX:\n            # Check if the target cell contains the primitive\n            if grid[front_r, front_c, primitive] > 0:\n                # Agent is in a position (r, c) and facing `current_dir` towards a primitive.\n                # This is a goal state, so add the USE action and return the path found.\n                # Since BFS explores layer by layer, the first path found is guaranteed to be the shortest.\n                return actions_so_far + [ACT_USE]\n\n        # Explore possible next states by applying movement actions\n        # For each movement action (UP, RIGHT, DOWN, LEFT):\n        # 1. Calculate the new position (nr, nc)\n        # 2. Determine the new direction (new_dir) based on the action (e.g., UP -> dir 0)\n        # 3. If the new state (nr, nc, new_dir) has not been visited and is valid, add to queue.\n\n        # UP action: moves North, sets direction to 0 (Up)\n        next_r_up, next_c_up = r + DR[0], c + DC[0]\n        new_dir_up = 0\n        if 0 <= next_r_up <= R_MAX and 0 <= next_c_up <= C_MAX and \\\n           (next_r_up, next_c_up, new_dir_up) not in visited:\n            # Assuming all cells within bounds are traversable.\n            # The problem description does not specify impassable terrain types for movement.\n            visited.add((next_r_up, next_c_up, new_dir_up))\n            q.append((next_r_up, next_c_up, new_dir_up, actions_so_far + [ACT_UP]))\n\n        # RIGHT action: moves East, sets direction to 1 (Right)\n        next_r_right, next_c_right = r + DR[1], c + DC[1]\n        new_dir_right = 1\n        if 0 <= next_r_right <= R_MAX and 0 <= next_c_right <= C_MAX and \\\n           (next_r_right, next_c_right, new_dir_right) not in visited:\n            visited.add((next_r_right, next_c_right, new_dir_right))\n            q.append((next_r_right, next_c_right, new_dir_right, actions_so_far + [ACT_RIGHT]))\n        \n        # DOWN action: moves South, sets direction to 2 (Down)\n        next_r_down, next_c_down = r + DR[2], c + DC[2]\n        new_dir_down = 2\n        if 0 <= next_r_down <= R_MAX and 0 <= next_c_down <= C_MAX and \\\n           (next_r_down, next_c_down, new_dir_down) not in visited:\n            visited.add((next_r_down, next_c_down, new_dir_down))\n            q.append((next_r_down, next_c_down, new_dir_down, actions_so_far + [ACT_DOWN]))\n\n        # LEFT action: moves West, sets direction to 3 (Left)\n        next_r_left, next_c_left = r + DR[3], c + DC[3]\n        new_dir_left = 3\n        if 0 <= next_r_left <= R_MAX and 0 <= next_c_left <= C_MAX and \\\n           (next_r_left, next_c_left, new_dir_left) not in visited:\n            visited.add((next_r_left, next_c_left, new_dir_left))\n            q.append((next_r_left, next_c_left, new_dir_left, actions_so_far + [ACT_LEFT]))\n\n    # If the queue is exhausted and no path to collect the primitive was found\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:14:05.341475", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dy == 1 and dx == 0: return SOUTH_DIR\n    if dy == -1 and dy == 0: return NORTH_DIR\n    return None # Should not happen if agent_pos and item_pos are cardinally adjacent\n\n  # Helper function: Checks if a cell is traversable (no non-grabbable items)\n  def _is_traversable(grid, x, y, non_grabbable_indices, grid_width, grid_height):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item (obstacle) is at (x, y)\n    for k_idx in non_grabbable_indices:\n      if grid[y, x, k_idx] == 1:\n        return False\n    return True\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Check if the primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Get non-grabbable indices for traversability check\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Prepare BFS goal states: (agent_x, agent_y, agent_facing_dir)\n  # These are the states from which the 'USE' action can be performed to collect the primitive.\n  bfs_target_agent_states = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells for the agent to stand on\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (dx_adj, dy_adj) from item to agent\n      adj_x, adj_y = item_x + dx_adj, item_y + dy_adj\n\n      if _is_traversable(grid, adj_x, adj_y, non_grabbable_indices, grid_width, grid_height):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_target_agent_states.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_target_agent_states:\n    return [] # No traversable adjacent positions from which to collect the primitive\n\n  # BFS setup\n  # Queue stores (x, y, dir) tuples representing agent's state\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Parent map to reconstruct the path: {child_state: (parent_state, action_to_child)}\n  parent_map = {} \n  \n  found_goal_state = None # Stores the (x, y, dir) of the goal state once found\n\n  # Movement actions and their effects: (dx, dy, resulting_direction)\n  # When agent performs UP_ACTION, it moves UP (dy=-1) and faces NORTH (dir=0)\n  movement_actions_map = {\n      UP_ACTION: (0, -1, NORTH_DIR),\n      DOWN_ACTION: (0, 1, SOUTH_DIR),\n      LEFT_ACTION: (-1, 0, WEST_DIR),\n      RIGHT_ACTION: (1, 0, EAST_DIR)\n  }\n  \n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state is one of the goal states\n    if (curr_x, curr_y, curr_dir) in bfs_target_agent_states:\n      found_goal_state = (curr_x, curr_y, curr_dir)\n      break # Found the shortest path to a goal\n    \n    # Explore movement actions: agent moves and its direction is set by the movement\n    for action, (dx, dy, resulting_dir) in movement_actions_map.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = resulting_dir\n\n      next_state = (next_x, next_y, next_dir)\n      if _is_traversable(grid, next_x, next_y, non_grabbable_indices, grid_width, grid_height):\n        if next_state not in visited:\n          visited.add(next_state)\n          parent_map[next_state] = ((curr_x, curr_y, curr_dir), action)\n          queue.append(next_state)\n    \n    # Explore turning actions: agent changes direction without changing position.\n    # It's assumed that LEFT_ACTION and RIGHT_ACTION can also function as in-place turns\n    # in this environment context, besides their movement function.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]: \n      next_x, next_y = curr_x, curr_y # Position does not change for a pure turn\n      \n      # Calculate new direction based on the turn action\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4 # Turn clockwise\n      \n      next_state = (next_x, next_y, next_dir)\n      if next_state not in visited: # No traversability check needed as position doesn't change\n        visited.add(next_state)\n        parent_map[next_state] = ((curr_x, curr_y, curr_dir), turn_action)\n        queue.append(next_state)\n\n  if found_goal_state is None:\n    return [] # No path found to any primitive's collection point\n\n  # Reconstruct the path from the goal state back to the initial state\n  actions = []\n  curr_state = found_goal_state\n  initial_state = (initial_agent_x, initial_agent_y, initial_agent_dir)\n\n  while curr_state != initial_state:\n    parent_state, action = parent_map[curr_state]\n    actions.insert(0, action) # Prepend action to build path in correct order\n    curr_state = parent_state\n  \n  # Finally, append the USE action after reaching the correct position and facing direction.\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:14:06.305350", "function_name": "collect", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:15:37.061308", "function_name": "collect", "function_body": "    actions_list = []\n    max_total_steps = 1000  # Safety limit to prevent infinite loops\n\n    action_map = env.action_specs()\n\n    # Get the CraftWorld instance from CraftLab to access non_grabbable_indices\n    world = env.world\n    non_grabbable_indices = world.non_grabbable_indices\n\n    for step_count in range(max_total_steps):\n        obs = env.observations()\n        inventory = obs['features_dict']['inventory']\n\n        # 1. Check if goal is already satisfied (primitive collected)\n        if inventory[primitive] > 0:\n            return actions_list\n\n        current_pos = obs['features_dict']['pos']  # (col, row)\n        grid = obs['features_dict']['features_global']  # (WIDTH, HEIGHT, n_kinds)\n\n        grid_width, grid_height, _ = grid.shape\n\n        current_agent_col, current_agent_row = int(current_pos[0]), int(current_pos[1])\n\n        # 2. Find the target primitive's location on the global grid\n        target_pos = None  # (col, row)\n        for col in range(grid_width):\n            for row in range(grid_height):\n                if grid[col, row, primitive] == 1:\n                    target_pos = (col, row)\n                    break\n            if target_pos:\n                break\n\n        action_to_take = None\n\n        # Helper function to check if a proposed cell is blocked by an obstacle\n        def is_blocked(check_col, check_row):\n            # Check if out of bounds\n            if not (0 <= check_col < grid_width and 0 <= check_row < grid_height):\n                return True\n            # Check if the cell contains a non-grabbable item\n            # Get all kinds present at the cell (col, row)\n            kinds_at_cell = np.where(grid[check_col, check_row, :] == 1)[0]\n            for kind_idx in kinds_at_cell:\n                if kind_idx in non_grabbable_indices:\n                    return True\n            return False\n\n        if target_pos is None:\n            # Primitive not found on the map. This implies the agent needs to explore.\n            # For this simple collect function, we'll implement a basic random walk\n            # as a fallback if the target is not visible on the global grid.\n            possible_moves = [action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT']]\n            \n            # Shuffle to introduce some exploration variability\n            np.random.shuffle(possible_moves)\n            for move_action in possible_moves:\n                temp_row, temp_col = current_agent_row, current_agent_col\n                if move_action == action_map['UP']: temp_row += 1\n                elif move_action == action_map['DOWN']: temp_row -= 1\n                elif move_action == action_map['RIGHT']: temp_col += 1\n                elif move_action == action_map['LEFT']: temp_col -= 1\n                \n                if not is_blocked(temp_col, temp_row): # is_blocked expects (col, row)\n                    action_to_take = move_action\n                    break\n            \n            if action_to_take is None:\n                # Agent is fully surrounded or cannot find a free spot to move.\n                # No more progress can be made, so return collected actions.\n                return actions_list\n\n        else: # target_pos is found\n            target_col, target_row = target_pos\n\n            # 3. If at target, use; otherwise, move towards it\n            if current_agent_col == target_col and current_agent_row == target_row:\n                action_to_take = action_map['USE']\n            else:\n                # Calculate difference in coordinates\n                dx = target_col - current_agent_col\n                dy = target_row - current_agent_row\n\n                # Prioritize movement along the axis with the larger absolute difference\n                preferred_move_axis = 'horizontal' if abs(dx) >= abs(dy) else 'vertical'\n                \n                # Attempt preferred axis move first\n                if preferred_move_axis == 'horizontal' and dx != 0:\n                    intended_col = current_agent_col + (1 if dx > 0 else -1)\n                    if not is_blocked(intended_col, current_agent_row):\n                        action_to_take = action_map['RIGHT'] if dx > 0 else action_map['LEFT']\n                elif preferred_move_axis == 'vertical' and dy != 0:\n                    intended_row = current_agent_row + (1 if dy > 0 else -1)\n                    if not is_blocked(current_agent_col, intended_row):\n                        action_to_take = action_map['UP'] if dy > 0 else action_map['DOWN']\n                \n                # If preferred move was not chosen or was blocked, try the other axis\n                if action_to_take is None:\n                    if preferred_move_axis == 'horizontal' and dy != 0: # Try vertical\n                        intended_row = current_agent_row + (1 if dy > 0 else -1)\n                        if not is_blocked(current_agent_col, intended_row):\n                            action_to_take = action_map['UP'] if dy > 0 else action_map['DOWN']\n                    elif preferred_move_axis == 'vertical' and dx != 0: # Try horizontal\n                        intended_col = current_agent_col + (1 if dx > 0 else -1)\n                        if not is_blocked(intended_col, current_agent_row):\n                            action_to_take = action_map['RIGHT'] if dx > 0 else action_map['LEFT']\n                \n                # If still no action (both direct axial moves blocked or target is diagonally aligned\n                # and no direct path exists), try any non-blocked move towards target\n                if action_to_take is None:\n                    potential_moves_towards_target = []\n                    if dx > 0: potential_moves_towards_target.append(action_map['RIGHT'])\n                    if dx < 0: potential_moves_towards_target.append(action_map['LEFT'])\n                    if dy > 0: potential_moves_towards_target.append(action_map['UP'])\n                    if dy < 0: potential_moves_towards_target.append(action_map['DOWN'])\n\n                    np.random.shuffle(potential_moves_towards_target) # Shuffle to add robustness\n                    for move_action in potential_moves_towards_target:\n                        temp_row, temp_col = current_agent_row, current_agent_col\n                        if move_action == action_map['UP']: temp_row += 1\n                        elif move_action == action_map['DOWN']: temp_row -= 1\n                        elif move_action == action_map['RIGHT']: temp_col += 1\n                        elif move_action == action_map['LEFT']: temp_col -= 1\n                        \n                        if not is_blocked(temp_col, temp_row): # is_blocked expects (col, row)\n                            action_to_take = move_action\n                            break\n                    \n                    # If still no action, it means the agent is completely surrounded\n                    # by obstacles or cannot find a path to the target.\n                    if action_to_take is None:\n                        # Return current actions, as no more progress can be made.\n                        return actions_list\n        \n        # Execute the chosen action\n        if action_to_take is not None:\n            _, done, _ = env.step(action_to_take)\n            actions_list.append(action_to_take)\n            if done:\n                # CraftLab's step returns done if goal is satisfied OR max_steps reached.\n                # If goal is satisfied, the next loop iteration will catch it.\n                # If max_steps reached, we should terminate.\n                break\n        else:\n            # This case should ideally not be reached if the logic above is sound,\n            # but as a safeguard, if no action was decided, break to prevent infinite loop.\n            break\n\n    return actions_list", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:15:38.030740", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Constants for actions (defined in CraftLab's action_specs)\n  DOWN = 0  # Move forward\n  UP = 1    # Move backward\n  LEFT = 2  # Turn left\n  RIGHT = 3 # Turn right\n  USE = 4\n\n  # Direction vectors (dx, dy) for agent's current direction\n  # Assumes: 0: Up (decreasing Y), 1: Right (increasing X), 2: Down (increasing Y), 3: Left (decreasing X)\n  # This aligns with common (row, col) grid indexing where Y is row, X is col.\n  DIRS_XY = [(0, -1), (1, 0), (0, 1), (-1, 0)] # (dx, dy) for dir 0, 1, 2, 3\n\n  # Offsets for 8-way neighbors to check for 'USE' action around the agent's current position (px, py)\n  # This represents the 3x3 square around the agent, excluding the agent's own cell.\n  NEIGHBOR_OFFSETS = [\n      (-1, -1), (0, -1), (1, -1), # Top row\n      (-1, 0),           (1, 0),  # Middle row (excluding center)\n      (-1, 1), (0, 1), (1, 1)     # Bottom row\n  ]\n\n  # Get initial state information from the environment's internal CraftState\n  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n  inventory = current_state.inventory\n  WIDTH, HEIGHT, n_kinds = grid.shape\n\n  # Check if the primitive is already collected in the initial state\n  if inventory[primitive] > 0:\n    return []\n\n  # BFS Queue: stores tuples of (pos_x, pos_y, current_direction, list_of_actions_to_reach_this_state)\n  queue = collections.deque([(initial_pos[0], initial_pos[1], initial_dir, [])])\n\n  # Visited set: stores (pos_x, pos_y, direction) tuples to avoid revisiting states and infinite loops\n  visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n  while queue:\n    px, py, d, path = queue.popleft()\n\n    # --- Check if the primitive can be collected from the current (px, py) position ---\n    # The agent is at (px, py). Check its 3x3 neighborhood for the primitive.\n    for dx_n, dy_n in NEIGHBOR_OFFSETS:\n      nx, ny = px + dx_n, py + dy_n\n      # Ensure neighbor coordinates are within grid boundaries\n      if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n        # If the primitive is present at a neighbor location, we can use the 'USE' action\n        if grid[nx, ny, primitive] > 0:\n          # A path to collect the primitive has been found\n          return path + [USE]\n\n    # --- Explore possible next actions (movements and turns) ---\n\n    # 1. Move Forward (DOWN action)\n    move_dx, move_dy = DIRS_XY[d]\n    npx_forward, npy_forward = px + move_dx, py + move_dy\n    # Check if the new position is within grid boundaries\n    if 0 <= npx_forward < WIDTH and 0 <= npy_forward < HEIGHT:\n      # In CraftWorld, most cells are traversable unless they are explicitly obstacles.\n      # For simplicity, we assume all in-bounds cells are walkable for this BFS.\n      if (npx_forward, npy_forward, d) not in visited:\n        visited.add((npx_forward, npy_forward, d))\n        queue.append((npx_forward, npy_forward, d, path + [DOWN]))\n\n    # 2. Turn Left (LEFT action)\n    nd_left = (d - 1 + 4) % 4 # Ensure direction wraps around (0, 1, 2, 3)\n    if (px, py, nd_left) not in visited:\n      visited.add((px, py, nd_left))\n      queue.append((px, py, nd_left, path + [LEFT]))\n\n    # 3. Turn Right (RIGHT action)\n    nd_right = (d + 1) % 4 # Ensure direction wraps around\n    if (px, py, nd_right) not in visited:\n      visited.add((px, py, nd_right))\n      queue.append((px, py, nd_right, path + [RIGHT]))\n\n    # Note: 'UP' action (move backward) is generally not needed for shortest path finding\n    # in an unblocked grid to a target, as moving forward and turning covers all reachable cells.\n    # It might be useful in very specific maze configurations or if \"forward\" movement is blocked.\n\n  # If the BFS completes without finding a path to collect the primitive\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:16:56.708997", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:16:57.686248", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=Up (North), 1=Right (East), 2=Down (South), 3=Left (West))\n  # These are the integer values that `CraftState.dir` will hold to indicate the agent's facing direction.\n  DIR_UP = 0      # Agent facing North (decreases Y coordinate)\n  DIR_RIGHT = 1   # Agent facing East (increases X coordinate)\n  DIR_DOWN = 2    # Agent facing South (increases Y coordinate)\n  DIR_LEFT = 3    # Agent facing West (decreases X coordinate)\n\n  # Define a maximum number of steps for the BFS to find a path.\n  # This prevents excessively long search times and limits the total length\n  # of the generated action sequence, including the final ACTION_USE.\n  MAX_COLLECT_STEPS = 100 \n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent,\n      based on the agent's current position (y, x) and facing direction.\n\n      Args:\n          y (int): Agent's current row coordinate.\n          x (int): Agent's current column coordinate.\n          direction (int): Agent's current facing direction (DIR_UP, DIR_RIGHT, DIR_DOWN, DIR_LEFT).\n\n      Returns:\n          tuple[int, int]: (row, column) coordinates of the cell in front.\n      \"\"\"\n      if direction == DIR_UP:\n          return y - 1, x\n      elif direction == DIR_RIGHT:\n          return y, x + 1\n      elif direction == DIR_DOWN:\n          return y + 1, x\n      elif direction == DIR_LEFT:\n          return y, x - 1\n      # This case should ideally not be reached with valid direction inputs.\n      return y, x\n\n  actions_taken = []\n\n  # Access the underlying CraftState instance directly to get the current state information.\n  # This allows `collect_v2` to be called mid-episode without resetting the environment,\n  # supporting composition of actions.\n  current_state = env._current_state\n\n  # --- Initial validation and early exit conditions ---\n  \n  # 1. Check if the `primitive` ID is recognized by the world's cookbook.\n  # If the primitive is not a valid kind in the world, it cannot be collected.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # 2. Check if the `primitive` is already in the agent's inventory.\n  # If already collected, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n  \n  # 3. If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # --- Retrieve necessary environment information for pathfinding ---\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir\n\n  # Determine which entity kinds block agent movement (i.e., cells agents cannot traverse).\n  # Workshops are typically traversable, even if non-grabbable, to allow crafting.\n  impassable_for_movement = set()\n  \n  # Add water if it exists and is defined as a kind, as it's usually impassable.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  # Add other non-grabbable items that are not workshops to the impassable set.\n  # Convert workshop_indices to a set for faster lookup during traversal checks.\n  workshop_indices_set = set(current_state.world.workshop_indices) \n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in workshop_indices_set:\n          impassable_for_movement.add(k_idx)\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # The agent's direction is assumed to update to face the cardinal direction of its last movement.\n  # Format: {ACTION_CONSTANT: (resulting_direction_constant, dy, dx)}\n  # This mapping ensures consistency with CraftState.dir values (0=Up, 1=Right, etc.).\n  movement_actions_map = {\n      ACTION_UP:    (DIR_UP, -1, 0),    # Move North (dy=-1, dx=0), agent faces Up (North)\n      ACTION_RIGHT: (DIR_RIGHT, 0, 1),  # Move East (dy=0, dx=1), agent faces Right (East)\n      ACTION_DOWN:  (DIR_DOWN, 1, 0),   # Move South (dy=1, dx=0), agent faces Down (South)\n      ACTION_LEFT:  (DIR_LEFT, 0, -1)   # Move West (dy=0, dx=-1), agent faces Left (West)\n  }\n\n  # Initialize Breadth-First Search (BFS) queue.\n  # Each state in the queue is a tuple: (current_y, current_x, current_direction, path_of_actions_so_far).\n  # Storing the current direction is crucial because ACTION_USE depends on agent orientation for non-grabbables.\n  bfs_queue = collections.deque()\n  bfs_queue.append((start_y, start_x, start_dir, []))\n  \n  # Keep track of visited states (position + orientation) to prevent redundant exploration and infinite loops.\n  visited_states = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None  # This variable will store the final sequence of actions if a valid path is found.\n\n  # Determine if the primitive is a \"grabbable\" item (picked up by moving onto its cell and using USE)\n  # or a \"non-grabbable\" item (interacted with from an adjacent cell by facing it and using USE).\n  is_primitive_grabbable = primitive in current_state.world.grabbable_indices\n\n  # --- BFS to find the shortest action sequence to collect the primitive ---\n  while bfs_queue:\n      curr_y, curr_x, curr_dir, current_path_actions = bfs_queue.popleft()\n\n      # Pruning: If the current path length (movement actions only) is already at or beyond\n      # MAX_COLLECT_STEPS (total actions including final USE), then this path cannot be\n      # extended to a valid solution because adding the final ACTION_USE would exceed the limit.\n      # `MAX_COLLECT_STEPS - 1` is the max allowed movements before the final USE.\n      if len(current_path_actions) >= MAX_COLLECT_STEPS:\n          continue\n\n      # --- Goal Check: Determine if the primitive can be collected from the current state (position and direction) ---\n\n      # Scenario 1: Primitive is \"grabbable\" and located on the agent's current cell.\n      # For grabbable items, ACTION_USE collects them from the same cell, regardless of facing direction.\n      if is_primitive_grabbable and full_grid[curr_y, curr_x, primitive] > 0:\n          candidate_path = current_path_actions + [ACTION_USE]\n          # Ensure the total path length (including the USE action) does not exceed the limit.\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              break # Found the shortest path, exit BFS.\n          # Else, this specific path would exceed the total step limit, continue BFS\n          # to find other potential paths that might be shorter.\n          \n      # Scenario 2: Primitive is \"non-grabbable\" and located in the cell the agent is currently facing.\n      # For non-grabbable items, ACTION_USE interacts with the object in the cell directly in front.\n      elif not is_primitive_grabbable:\n          facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n          # Check if the facing cell is within grid boundaries and contains the target primitive.\n          if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n              full_grid[facing_y, facing_x, primitive] > 0):\n              \n              candidate_path = current_path_actions + [ACTION_USE]\n              # Ensure the total path length (including the USE action) does not exceed the limit.\n              if len(candidate_path) <= MAX_COLLECT_STEPS:\n                  path_to_execute = candidate_path\n                  break # Found the shortest path, exit BFS.\n              # Else, continue BFS.\n\n      # --- Explore neighboring cells via movement actions ---\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          \n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable (does not contain impassable entities).\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # Pruning: Check if adding this movement action would leave enough room for a final ACTION_USE.\n          # The new path length (after this move) would be `len(current_path_actions) + 1`.\n          # If this new path length plus the final `ACTION_USE` (which is 1 step)\n          # exceeds `MAX_COLLECT_STEPS`, then this branch should not be explored.\n          # This translates to: `(len(current_path_actions) + 1) + 1 > MAX_COLLECT_STEPS`.\n          # Simplified: `len(current_path_actions) + 2 > MAX_COLLECT_STEPS`.\n          # Or, equivalently, if the number of *movement* steps would become `MAX_COLLECT_STEPS - 1` or more,\n          # it implies no room for the final `ACTION_USE`.\n          if len(current_path_actions) + 1 >= MAX_COLLECT_STEPS:\n              continue\n          \n          # Check if this new (position, direction) state has already been visited\n          # to prevent redundant exploration and infinite loops.\n          if (next_y, next_x, next_dir) in visited_states:\n              continue\n\n          # If all checks pass, add the new state to the queue for further exploration.\n          visited_states.add((next_y, next_x, next_dir))\n          bfs_queue.append((next_y, next_x, next_dir, current_path_actions + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      # If no valid path was found within the step limit, return an empty list.\n      return []\n\n  for action in path_to_execute:\n      actions_taken.append(action)\n      # Perform the action in the environment. We only care about the resulting state.\n      _, done, _ = env.step(action)\n      \n      # Update the internal state reference to reflect the current environment after the step.\n      current_state = env._current_state\n\n      # If the primitive is successfully collected at any point (e.g., immediate pickup or during USE),\n      # we can stop early and return the actions taken so far.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n      # If the episode terminates (`done` is True) but the primitive was NOT collected,\n      # it implies failure. In this case, the current partial path is invalid.\n      if done and current_state.inventory[primitive] <= 0:\n          return []\n\n  # Final verification: After executing all actions in the `path_to_execute`,\n  # confirm that the primitive was indeed collected into the inventory.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it indicates an unhandled environmental factor (e.g., tool requirement, resource depletion).\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:18:17.321791", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      Action.UP: DIR_NORTH,\n      Action.DOWN: DIR_SOUTH,\n      Action.LEFT: DIR_WEST,\n      Action.RIGHT: DIR_EAST\n  }\n\n  # Mapping of target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction to collect that target via ACTION_USE.\n  RELATIVE_TO_REQUIRED_DIR = {\n      (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n      (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n      (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n      (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_cell_in_front(pos, direction):\n      y, x = pos\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return None # Should not happen with valid directions\n\n  # Breadth-First Search (BFS) to find a path to the primitive, ensuring the agent\n  # ends up at a position AND orientation suitable for collection.\n  def _find_path_and_orientation_for_collection(start_pos, start_dir, initial_full_grid, primitive_id, world, max_steps):\n      grid_height, grid_width, _ = initial_full_grid.shape\n      impassable_kinds = world.non_grabbable_indices\n      primitive_is_traversable = primitive_id not in impassable_kinds # Can agent stand on it?\n\n      # BFS state: (current_y, current_x, current_dir, path_of_actions)\n      q = collections.deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n      moves_options = [\n          (-1, 0, Action.UP, DIR_NORTH),\n          (1, 0, Action.DOWN, DIR_SOUTH),\n          (0, -1, Action.LEFT, DIR_WEST),\n          (0, 1, Action.RIGHT, DIR_EAST)\n      ]\n\n      while q:\n          curr_y, curr_x, curr_dir, path_actions = q.popleft()\n          \n          # Check for path length limit (reserving at least 1 step for Action.USE)\n          if len(path_actions) >= max_steps - 1:\n              continue\n\n          # Goal Check 1: Primitive is on the current cell and agent can pick it up directly (if traversable)\n          if primitive_is_traversable and initial_full_grid[curr_y, curr_x, primitive_id] > 0:\n              return (path_actions, (0, 0)) # Indicates target is at agent's position\n\n          # Goal Check 2: Primitive is cardinally adjacent AND agent is facing it correctly\n          for rel_dy, rel_dx in RELATIVE_TO_REQUIRED_DIR.keys(): \n              adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n              # Check bounds for the adjacent cell\n              if not (0 <= adj_y < grid_height and 0 <= adj_x < grid_width):\n                  continue\n\n              # Check if the adjacent cell contains the primitive using the initial grid for planning\n              if initial_full_grid[adj_y, adj_x, primitive_id] > 0:\n                  # Primitive found at (adj_y, adj_x). Now, verify agent's orientation.\n                  required_dir_for_collection = RELATIVE_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n                  if curr_dir == required_dir_for_collection:\n                      # Found a path that leads to a position AND ensures the agent is oriented correctly.\n                      return (path_actions, (rel_dy, rel_dx))\n\n          # Explore neighboring cells for movement\n          for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n              # Check bounds for the next movement cell\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if the next cell is traversable (i.e., does not contain any impassable kinds)\n              is_traversable_for_movement = True\n              for k_idx in impassable_kinds:\n                  if initial_full_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable_for_movement = False\n                      break\n              if not is_traversable_for_movement:\n                  continue\n              \n              # Add to queue only if this new state (position and direction) hasn't been visited\n              if (next_y, next_x, new_dir_after_move) not in visited:\n                  visited.add((next_y, next_x, new_dir_after_move))\n                  q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n      return (None, None) # No path found to the primitive with correct orientation\n\n\n  actions_taken = []\n  \n  # IMPROVEMENT for v2: Do NOT call env.reset(). Operate from the current state of the environment.\n  # This makes 'collect' a more versatile skill that can be chained with other actions.\n  current_state = env._current_state \n\n  # Initial checks for early exit\n  if primitive not in current_state.world.cookbook.kinds:\n      # The specified primitive ID is not a recognized kind in the world.\n      return [] \n  if current_state.inventory[primitive] > 0:\n      # The primitive has already been collected or is present in inventory.\n      return [] \n\n  # Capture the initial grid, position, and direction for path planning.\n  # This snapshot is used for BFS, which assumes a static environment for planning.\n  initial_full_grid = current_state.features_dict()['features_global']\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  \n  # Find the sequence of movements and the relative target coordinates for collection.\n  path_of_moves, relative_target_coords = _find_path_and_orientation_for_collection(\n      start_pos, start_dir, initial_full_grid, primitive, current_state.world, MAX_COLLECT_STEPS\n  )\n\n  if path_of_moves is None:\n      # No valid path was found to reach a position/orientation suitable for collection.\n      return [] \n\n  # Execute the found path of movements\n  for action in path_of_moves:\n      actions_taken.append(action)\n      # Step the environment with the current action.\n      # We ignore reward and done status as this function's goal is just to return the action sequence.\n      _, _, _ = env.step(action) \n      current_state = env._current_state # Always update the internal state after a step\n\n      # Early exit if the primitive was somehow collected during movement (e.g., if standing on it)\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n  # After executing all movement actions, the agent should be at the correct position\n  # and facing the correct direction as determined by the BFS. Now, prepare to perform the USE action.\n  \n  # Verify the primitive is still at the expected location using the *current* grid state.\n  # This makes it more robust to dynamic environments (though less common for CraftWorld primitives).\n  current_grid = current_state.features_dict()['features_global'] \n  grid_height, grid_width, _ = current_grid.shape \n\n  is_primitive_reachable_by_use = False\n\n  if relative_target_coords == (0,0):\n      # Target is on the current cell (agent is standing on it)\n      if (0 <= current_state.pos[0] < grid_height and\n          0 <= current_state.pos[1] < grid_width and\n          current_grid[current_state.pos[0], current_state.pos[1], primitive] > 0):\n          is_primitive_reachable_by_use = True\n  else:\n      # Target is adjacent to the current cell, in the direction agent is facing.\n      target_cell_y, target_cell_x = _get_cell_in_front(current_state.pos, current_state.dir)\n      if (target_cell_y is not None and\n          0 <= target_cell_y < grid_height and 0 <= target_cell_x < grid_width and\n          current_grid[target_cell_y, target_cell_x, primitive] > 0):\n          is_primitive_reachable_by_use = True\n\n  if is_primitive_reachable_by_use:\n      # If the primitive is still present and reachable, append and execute the Action.USE.\n      if len(actions_taken) < MAX_COLLECT_STEPS: # Ensure there's still capacity for the USE action\n          actions_taken.append(Action.USE)\n          _, _, _ = env.step(Action.USE)\n          current_state = env._current_state # Update state after USE\n\n          # Final verification: Confirm the primitive was successfully collected into inventory.\n          if current_state.inventory[primitive] > 0:\n              return actions_taken # Successfully collected!\n          else:\n              # Collection failed even after reaching and attempting USE.\n              # This might happen if specific tools are needed, or the resource depleted, etc.\n              return [] \n      else:\n          # Max steps reached, no space left for the final USE action.\n          return [] \n  else:\n      # Discrepancy: BFS found a path, but primitive is not in the expected location for collection\n      # after executing the path (according to the current grid). This indicates a stale plan or\n      # dynamic environment changes not accounted for in the initial static grid planning.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:18:18.366532", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      Action.UP: DIR_NORTH,\n      Action.DOWN: DIR_SOUTH,\n      Action.LEFT: DIR_WEST,\n      Action.RIGHT: DIR_EAST\n  }\n\n  # Mapping of target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction to collect that target via ACTION_USE.\n  # This focuses on cardinal directions, as ACTION_USE typically applies to what's directly in front.\n  RELATIVE_TO_REQUIRED_DIR = {\n      (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n      (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n      (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n      (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_cell_in_front(pos, direction):\n      y, x = pos\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return None # Should not happen with valid directions\n\n  # Breadth-First Search (BFS) to find a path to the primitive, ensuring the agent\n  # ends up at a position AND orientation suitable for collection.\n  def _find_path_and_orientation_for_collection(start_pos, start_dir, initial_full_grid, primitive_id, world, max_steps):\n      grid_height, grid_width, _ = initial_full_grid.shape\n      impassable_kinds = world.non_grabbable_indices\n      # A primitive is \"traversable\" if it's not in the set of impassable kinds.\n      # Agent can stand on a traversable primitive to collect it.\n      primitive_is_traversable = primitive_id not in impassable_kinds\n\n      # BFS state: (current_y, current_x, current_dir, path_of_actions)\n      q = collections.deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n      # These moves are cardinal and also determine the new facing direction.\n      moves_options = [\n          (-1, 0, Action.UP, DIR_NORTH),\n          (1, 0, Action.DOWN, DIR_SOUTH),\n          (0, -1, Action.LEFT, DIR_WEST),\n          (0, 1, Action.RIGHT, DIR_EAST)\n      ]\n\n      while q:\n          curr_y, curr_x, curr_dir, path_actions = q.popleft()\n          \n          # Check for path length limit (reserving at least 1 step for ACTION_USE)\n          if len(path_actions) >= max_steps - 1:\n              continue # Skip expanding paths that are already too long\n\n          # --- Goal Check 1: Primitive is on the current cell and agent can pick it up directly ---\n          if primitive_is_traversable and initial_full_grid[curr_y, curr_x, primitive_id] > 0:\n              # If agent can move onto the primitive and it's present, this is a direct collection point.\n              # Relative coordinates (0,0) indicates target is at agent's current position.\n              return (path_actions, (0, 0)) \n\n          # --- Goal Check 2: Primitive is cardinally adjacent AND agent is facing it correctly ---\n          for rel_dy, rel_dx in RELATIVE_TO_REQUIRED_DIR.keys(): \n              adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n              # Check bounds for the adjacent cell\n              if not (0 <= adj_y < grid_height and 0 <= adj_x < grid_width):\n                  continue\n\n              # Check if the adjacent cell contains the primitive using the initial grid for planning\n              if initial_full_grid[adj_y, adj_x, primitive_id] > 0:\n                  # Primitive found at (adj_y, adj_x). Now, verify agent's orientation.\n                  required_dir_for_collection = RELATIVE_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n                  if curr_dir == required_dir_for_collection:\n                      # Found a path that leads to a position AND ensures the agent is oriented correctly.\n                      return (path_actions, (rel_dy, rel_dx))\n\n          # --- Explore neighboring cells for movement ---\n          for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n              # Check bounds for the next movement cell\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if the next cell is traversable (i.e., does not contain any impassable kinds)\n              # This check also uses the initial grid for planning.\n              is_traversable_for_movement = True\n              for k_idx in impassable_kinds:\n                  if initial_full_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable_for_movement = False\n                      break\n              if not is_traversable_for_movement:\n                  continue\n              \n              # Add to queue only if this new state (position and direction) hasn't been visited\n              if (next_y, next_x, new_dir_after_move) not in visited:\n                  visited.add((next_y, next_x, new_dir_after_move))\n                  q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n      return (None, None) # No path found to the primitive with correct orientation\n\n  actions_taken = []\n  \n  # Get the current state from the environment without resetting.\n  current_state = env._current_state \n\n  # Initial checks for early exit\n  if primitive not in current_state.world.cookbook.kinds:\n      # The specified primitive ID is not a recognized kind in the world.\n      return [] \n  if current_state.inventory[primitive] > 0:\n      # The primitive has already been collected or is present in inventory.\n      return [] \n\n  # Capture the current grid for path planning. This snapshot is used for BFS.\n  initial_full_grid = current_state.features_dict()['features_global']\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  \n  # Find the sequence of movements and the relative target coordinates for collection.\n  path_of_moves, relative_target_coords = _find_path_and_orientation_for_collection(\n      start_pos, start_dir, initial_full_grid, primitive, current_state.world, MAX_COLLECT_STEPS\n  )\n\n  if path_of_moves is None:\n      # No valid path was found to reach a position/orientation suitable for collection.\n      return [] \n\n  # Execute the found path of movements\n  for action in path_of_moves:\n      # Check if the primitive was somehow obtained *during* the execution of a prior step.\n      # This makes it robust to unexpected inventory changes or if the goal was satisfied.\n      if current_state.inventory[primitive] > 0:\n          break # Primitive collected, stop executing movements and proceed to final check.\n\n      # Ensure we don't exceed the max steps. Reserve one step for the final ACTION_USE.\n      if len(actions_taken) >= MAX_COLLECT_STEPS - 1: \n          # Path is too long, or would exceed max steps before final USE.\n          return [] # Abort, no path found within limits.\n\n      actions_taken.append(action)\n      # Apply the action to the environment and update the state reference.\n      _, _, _ = env.step(action) \n      current_state = env._current_state \n  \n  # After executing all movement actions (or if break occurred),\n  # perform final checks for the ACTION_USE.\n  if current_state.inventory[primitive] > 0:\n      # If the primitive is already in inventory (either was there initially,\n      # or collected during path execution), we are done.\n      return actions_taken\n\n  # If not in inventory, check if it's now reachable for a 'USE' action.\n  # Re-evaluate the primitive's presence using the *current* grid state.\n  current_grid = current_state.features_dict()['features_global'] \n  grid_height, grid_width, _ = current_grid.shape \n\n  is_primitive_reachable_by_use = False\n\n  if relative_target_coords == (0,0):\n      # Target is on the current cell (agent is standing on it)\n      if (0 <= current_state.pos[0] < grid_height and\n          0 <= current_state.pos[1] < grid_width and\n          current_grid[current_state.pos[0], current_state.pos[1], primitive] > 0):\n          is_primitive_reachable_by_use = True\n  else:\n      # Target is adjacent to the current cell, in the direction agent is facing.\n      target_cell_y, target_cell_x = _get_cell_in_front(current_state.pos, current_state.dir)\n      if (target_cell_y is not None and\n          0 <= target_cell_y < grid_height and 0 <= target_cell_x < grid_width and\n          current_grid[target_cell_y, target_cell_x, primitive] > 0):\n          is_primitive_reachable_by_use = True\n\n  if is_primitive_reachable_by_use:\n      # If reachable and there's still capacity for one more action (ACTION_USE).\n      if len(actions_taken) < MAX_COLLECT_STEPS: \n          actions_taken.append(Action.USE)\n          _, _, _ = env.step(Action.USE)\n          current_state = env._current_state # Update state after USE\n\n          # Final verification: Confirm the primitive was successfully collected into inventory.\n          if current_state.inventory[primitive] > 0:\n              return actions_taken # Successfully collected!\n          else:\n              # Collection failed even after reaching and attempting USE.\n              # This might happen if specific tools are needed, or the resource depleted, etc.\n              return [] \n      else:\n          # Max steps reached, no space left for the final USE action.\n          return [] \n  else:\n      # Discrepancy: BFS found a path, but primitive is not in the expected location for collection\n      # after executing the path (according to the current grid). This indicates a stale plan or\n      # dynamic environment changes not accounted for in the initial static grid planning.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:19:16.043239", "function_name": "collect", "function_body": "  import collections\n\n  # Actions\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Directions (matching CraftState's internal representation)\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Mapping from movement action to the resulting direction of the agent\n  ACTION_TO_DIRECTION = {\n      UP_ACTION: NORTH_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  # Mapping from movement action to (dx, dy) delta\n  ACTION_TO_MOVE_DELTA = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  # Mapping from agent's direction to the (dx, dy) delta of the cell directly in front\n  DIRECTION_TO_FRONT_DELTA = {\n      NORTH_DIR: (0, -1),\n      EAST_DIR: (1, 0),\n      SOUTH_DIR: (0, 1),\n      WEST_DIR: (-1, 0)\n  }\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  current_state = env._current_state\n  \n  # If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Define all indices that represent un-traversable (obstacle) grid cells.\n  # This includes non-grabbable items, workshops, and the primitive itself\n  # (as agent needs to be adjacent to collect, not on top of it).\n  obstacle_indices = set()\n  obstacle_indices.update(env.world.non_grabbable_indices)\n  obstacle_indices.update(env.world.workshop_indices)\n  obstacle_indices.add(primitive_id) # Cannot walk onto the primitive itself\n\n  def is_walkable(x, y):\n    \"\"\"\n    Checks if a given grid cell (x, y) is within bounds and does not contain\n    any obstacle entities.\n    \"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check if the cell contains any obstacle\n    for obs_idx in obstacle_indices:\n      if grid[y, x, obs_idx] > 0: # grid is indexed as (height, width, kinds)\n        return False\n    return True\n\n  # Initialize BFS queue: (current_x, current_y, current_direction, path_actions_list)\n  queue = collections.deque([(start_pos_x, start_pos_y, start_dir, [])])\n  # Initialize visited set to avoid cycles and redundant paths: (x, y, direction)\n  visited = {(start_pos_x, start_pos_y, start_dir)}\n\n  # Run BFS\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # --- Goal Check: Can we collect the primitive from the current state? ---\n    # Determine the cell directly in front of the agent based on its current direction.\n    front_dx, front_dy = DIRECTION_TO_FRONT_DELTA[curr_dir]\n    front_x, front_y = curr_x + front_dx, curr_y + front_dy\n\n    # Check if the cell in front is within bounds and contains the primitive.\n    if (0 <= front_x < grid_width and 0 <= front_y < grid_height and\n        grid[front_y, front_x, primitive_id] > 0):\n      # Goal reached: primitive is in front, so add USE_ACTION and return the path.\n      return path_actions + [USE_ACTION]\n\n    # --- Explore possible next states ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for move_action, (dx, dy) in ACTION_TO_MOVE_DELTA.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      # After a movement action, the agent's direction automatically aligns with the movement direction.\n      next_dir_after_move = ACTION_TO_DIRECTION[move_action]\n\n      # Check if the next cell is walkable and if this state (position + direction) has not been visited.\n      if is_walkable(next_x, next_y) and\\\n         (next_x, next_y, next_dir_after_move) not in visited:\n        visited.add((next_x, next_y, next_dir_after_move))\n        queue.append((next_x, next_y, next_dir_after_move, path_actions + [move_action]))\n\n    # B. Turning Actions (LEFT, RIGHT)\n    # These actions change the agent's direction but not its position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n\n      # Position remains the same after turning.\n      if (curr_x, curr_y, next_dir) not in visited:\n        visited.add((curr_x, curr_y, next_dir))\n        queue.append((curr_x, curr_y, next_dir, path_actions + [turn_action]))\n  \n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:19:17.124221", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Actions\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Directions (matching CraftState's internal representation)\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Mapping from movement action to the resulting direction of the agent\n  ACTION_TO_DIRECTION = {\n      UP_ACTION: NORTH_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  # Mapping from movement action to (dx, dy) delta\n  ACTION_TO_MOVE_DELTA = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  # Mapping from agent's direction to the (dx, dy) delta of the cell directly in front\n  DIRECTION_TO_FRONT_DELTA = {\n      NORTH_DIR: (0, -1),\n      EAST_DIR: (1, 0),\n      SOUTH_DIR: (0, 1),\n      WEST_DIR: (-1, 0)\n  }\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  current_state = env._current_state\n  \n  # If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Find all locations of the primitive on the grid\n  primitive_y_coords, primitive_x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(primitive_x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Find the closest primitive location to the agent's current position (Manhattan distance)\n  min_distance_to_primitive = float('inf')\n  closest_primitive_pos = None # (x, y) of the closest primitive\n\n  for i in range(len(primitive_x_coords)):\n    item_x, item_y = primitive_x_coords[i], primitive_y_coords[i]\n    distance = abs(item_x - start_pos_x) + abs(item_y - start_pos_y)\n    if distance < min_distance_to_primitive:\n      min_distance_to_primitive = distance\n      closest_primitive_pos = (item_x, item_y)\n  \n  # target_primitive_x, target_primitive_y are the coordinates of the specific primitive we want to collect.\n  target_primitive_x, target_primitive_y = closest_primitive_pos\n\n  # Define all indices that represent un-traversable (obstacle) grid cells.\n  # This includes non-grabbable items, workshops, and the primitive itself\n  # (as agent needs to be adjacent to collect, not on top of it).\n  obstacle_indices = set()\n  obstacle_indices.update(env.world.non_grabbable_indices)\n  obstacle_indices.update(env.world.workshop_indices)\n  obstacle_indices.add(primitive_id) # Cannot walk onto *any* cell containing the target primitive.\n\n  def is_walkable(x, y):\n    \"\"\"\n    Checks if a given grid cell (x, y) is within bounds and does not contain\n    any obstacle entities.\n    \"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check if the cell contains any obstacle defined in obstacle_indices\n    # This means the agent cannot move onto a cell if any of these items are there.\n    for obs_idx in obstacle_indices:\n      if grid[y, x, obs_idx] > 0: # grid is indexed as (height, width, kinds)\n        return False\n    return True\n\n  # Initialize BFS queue: (current_x, current_y, current_direction, path_actions_list)\n  queue = collections.deque([(start_pos_x, start_pos_y, start_dir, [])])\n  # Initialize visited set to avoid cycles and redundant paths: (x, y, direction)\n  visited = {(start_pos_x, start_pos_y, start_dir)}\n\n  # Run BFS\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # --- Goal Check: Can we collect the target primitive from the current state? ---\n    # Determine the cell directly in front of the agent based on its current direction.\n    front_dx, front_dy = DIRECTION_TO_FRONT_DELTA[curr_dir]\n    front_x, front_y = curr_x + front_dx, curr_y + front_dy\n\n    # Check if the cell in front is within bounds and contains the *specific target* primitive.\n    if (0 <= front_x < grid_width and 0 <= front_y < grid_height and\n        front_x == target_primitive_x and front_y == target_primitive_y and\n        grid[front_y, front_x, primitive_id] > 0): # Ensure it still exists at that location\n      # Goal reached: target primitive is in front, so add USE_ACTION and return the path.\n      return path_actions + [USE_ACTION]\n\n    # --- Explore possible next states ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for move_action, (dx, dy) in ACTION_TO_MOVE_DELTA.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      # After a movement action, the agent's direction automatically aligns with the movement direction.\n      next_dir_after_move = ACTION_TO_DIRECTION[move_action]\n\n      # Check if the next cell is walkable and if this state (position + direction) has not been visited.\n      if is_walkable(next_x, next_y) and\\\n         (next_x, next_y, next_dir_after_move) not in visited:\n        visited.add((next_x, next_y, next_dir_after_move))\n        queue.append((next_x, next_y, next_dir_after_move, path_actions + [move_action]))\n\n    # B. Turning Actions (LEFT, RIGHT)\n    # These actions change the agent's direction but not its position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n\n      # Position remains the same after turning.\n      if (curr_x, curr_y, next_dir) not in visited:\n        visited.add((curr_x, curr_y, next_dir))\n        queue.append((curr_x, curr_y, next_dir, path_actions + [turn_action]))\n  \n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:20:56.505971", "function_name": "collect", "function_body": "    import collections # Used for deque, which is not imported globally in the provided context\n\n    # Action constants as defined by CraftLab.action_specs()\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Map delta coordinates to corresponding action integers for movement\n    MOVES = {\n        (0, -1): UP,    # Move North (typically decreases Y-coordinate in a grid)\n        (0, 1): DOWN,   # Move South (typically increases Y-coordinate)\n        (-1, 0): LEFT,  # Move West (typically decreases X-coordinate)\n        (1, 0): RIGHT   # Move East (typically increases X-coordinate)\n    }\n    DELTAS = list(MOVES.keys()) # List of (dx, dy) tuples for cardinal directions\n\n    # Get current state information from the environment\n    observations = env.observations()\n    current_pos = observations['pos'] # Agent's current (x, y) coordinates\n    inventory = observations['inventory'] # Agent's current inventory counts (numpy array)\n    grid = observations['features_global'] # Global view of the grid (WIDTH, HEIGHT, N_KINDS)\n\n    # Extract grid dimensions for boundary checks\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n\n    # Get sets of non-grabbable and grabbable indices for efficient lookup\n    # Non-grabbable items are typically obstacles that cannot be traversed.\n    non_grabbable_set = set(env.world.non_grabbable_indices)\n    grabbable_set = set(env.world.grabbable_indices)\n\n    # 1. Check if the primitive is already in the agent's inventory\n    if inventory[primitive] > 0:\n        return [] # Primitive is already collected, no actions needed\n\n    # 2. Locate all instances of the desired primitive on the grid\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] == 1: # Check if the primitive is at (x, y)\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        # If the primitive is not found anywhere on the map, it's unreachable\n        return []\n\n    # 3. Pathfinding using Breadth-First Search (BFS)\n    # The goal of BFS is to find the shortest sequence of movement actions to reach a cell\n    # from which the 'USE' action can successfully collect the primitive.\n    # This \"use-able\" cell is either:\n    #   a) The cell directly containing the primitive itself (if it's a grabbable item).\n    #   b) A cell directly adjacent (Manhattan distance 1) to the primitive.\n\n    # BFS queue stores tuples: (current_x, current_y, list_of_actions_to_reach_here)\n    queue = collections.deque([(current_pos[0], current_pos[1], [])])\n    # Visited set to prevent cycles and redundant exploration, storing (x, y) tuples\n    visited = {(current_pos[0], current_pos[1])}\n\n    while queue:\n        cx, cy, current_path = queue.popleft()\n\n        # Check if the current position (cx, cy) is a valid \"use-able\" location\n        # where the 'USE' action would collect the primitive.\n        can_use_here = False\n        \n        # Condition b: Agent is standing on a grabbable primitive\n        if grid[cx, cy, primitive] == 1 and primitive in grabbable_set:\n            can_use_here = True\n        else:\n            # Condition a: Agent is adjacent to any primitive location\n            for px, py in primitive_locations:\n                # Check for Manhattan distance of 1 (directly adjacent)\n                if abs(cx - px) + abs(cy - py) == 1: \n                    can_use_here = True\n                    break\n\n        if can_use_here:\n            # If we can use the primitive from the current position,\n            # this path is the shortest to such a \"use-able\" spot.\n            # Append the 'USE' action to the path and return the full sequence.\n            return current_path + [USE]\n\n        # Explore all four cardinal neighbors (UP, DOWN, LEFT, RIGHT)\n        for dx, dy in DELTAS:\n            nx, ny = cx + dx, cy + dy # Calculate the new potential position\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n                continue # Out of bounds, cannot move here\n\n            # Check if the new position (nx, ny) is an obstacle.\n            # We assume non-grabbable items define impassable terrain.\n            is_obstacle = False\n            for kind_idx in non_grabbable_set:\n                if grid[nx, ny, kind_idx] == 1:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue # Cannot move into an obstacle\n\n            # Check if this new position has already been visited.\n            # This ensures we find the shortest path and avoid infinite loops.\n            if (nx, ny) in visited:\n                continue # Already visited, no need to explore again from here\n\n            # If the new position is valid and unvisited, add it to the queue\n            # and mark it as visited.\n            visited.add((nx, ny))\n            action_to_reach_nx_ny = MOVES[(dx, dy)]\n            queue.append((nx, ny, current_path + [action_to_reach_nx_ny]))\n\n    # If the BFS completes without finding any path to a \"use-able\" location,\n    # it means the primitive is unreachable from the current state (e.g., trapped, or no clear path).\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:20:57.471490", "function_name": "collect", "function_body": "  state = env._current_state\n  actions = []\n\n  # If the primitive is already in the inventory, no actions are needed.\n  if state.inventory[primitive] > 0:\n    return actions\n\n  # Get grid dimensions (CraftState.grid is typically (WIDTH, HEIGHT, n_kinds))\n  grid_width, grid_height, _ = state.grid.shape\n\n  # Define helper function to check if a position is within grid boundaries\n  def is_valid_pos(x, y, width, height):\n    return 0 <= x < width and 0 <= y < height\n\n  # Define helper function to check if an agent position allows using (collecting) the primitive.\n  # This matches the 3x3 neighborhood logic of CraftState.next_to.\n  def can_use_primitive_from_pos(agent_x, agent_y, primitive_kind, grid, width, height):\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = agent_x + dx, agent_y + dy\n        if is_valid_pos(nx, ny, width, height) and grid[nx, ny, primitive_kind] > 0:\n          return True\n    return False\n\n  # Define helper function to find the shortest path (in terms of actions)\n  # to a position from which the primitive can be collected.\n  # Uses Breadth-First Search (BFS).\n  def get_path_to_usable_pos(start_pos, primitive_kind, grid, width, height):\n    # Use collections.deque for efficient queue operations in BFS\n    import collections\n    \n    q = collections.deque([(start_pos, [])]) # (current_pos: (x,y), path_actions: list of actions)\n    visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n    # Map position deltas to corresponding actions\n    action_map = {\n        (0, 1): env_factory.DOWN,  # (x, y+1)\n        (0, -1): env_factory.UP,   # (x, y-1)\n        (1, 0): env_factory.RIGHT, # (x+1, y)\n        (-1, 0): env_factory.LEFT  # (x-1, y)\n    }\n\n    while q:\n      (cx, cy), current_actions = q.popleft()\n\n      # If the current position allows using the primitive, we found a path\n      if can_use_primitive_from_pos(cx, cy, primitive_kind, grid, width, height):\n        return current_actions\n\n      # Explore 4-directional neighbors\n      for dx, dy in action_map.keys():\n        nx, ny = cx + dx, cy + dy\n        next_pos = (nx, ny)\n\n        # Check if the next position is valid and not yet visited\n        if is_valid_pos(nx, ny, width, height) and next_pos not in visited:\n          # Assuming all valid cells are traversable for movement.\n          # If there were unpassable obstacles, they would be checked here.\n          new_actions = current_actions + [action_map[(dx, dy)]]\n          visited.add(next_pos)\n          q.append((next_pos, new_actions))\n\n    return [] # No path found to any usable position\n\n  # Find the path to a position where the primitive can be collected\n  # This list will be empty if the agent is already in such a position.\n  path_to_use_pos = get_path_to_usable_pos(state.pos, primitive, state.grid, grid_width, grid_height)\n\n  # If no path was found, and the agent is NOT currently in a usable position,\n  # it means the primitive is unreachable or not present on the map.\n  if not path_to_use_pos and not can_use_primitive_from_pos(state.pos[0], state.pos[1], primitive, state.grid, grid_width, grid_height):\n    return [] # Cannot collect, so return no actions\n\n  # Add the movement actions to reach the usable position\n  actions.extend(path_to_use_pos)\n\n  # Once in a usable position, perform the USE action to collect the primitive.\n  actions.append(env_factory.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:22:44.607137", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Mapping move actions to (dx, dy) changes in position\n  # These deltas define how the agent's (x, y) position changes for each move action.\n  MOVE_DELTAS = {\n      ACTION_DOWN: (0, 1),\n      ACTION_UP: (0, -1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0),\n  }\n\n  # Mapping move actions to the resulting agent direction value (CraftState.dir)\n  # Assuming CraftState.dir maps: 0=UP, 1=DOWN, 2=LEFT, 3=RIGHT.\n  # When an agent moves, its internal direction is assumed to align with the direction of movement.\n  ACTION_TO_DIR_VALUE = {\n      ACTION_UP: 0,\n      ACTION_DOWN: 1,\n      ACTION_LEFT: 2,\n      ACTION_RIGHT: 3,\n  }\n\n  # Mapping agent direction value to (dx, dy) for the \"front\" cell.\n  # This determines where the USE action lands.\n  DIR_VALUE_TO_DELTA = {\n      0: (0, -1),  # UP (dir 0)\n      1: (0, 1),   # DOWN (dir 1)\n      2: (-1, 0),  # LEFT (dir 2)\n      3: (1, 0),   # RIGHT (dir 3)\n  }\n\n  # Get the current state from the environment\n  state = env._current_state\n\n  # Extract relevant information from the state\n  start_pos = state.pos\n  start_dir = state.dir  # Agent's initial facing direction\n  grid = state.grid\n  width, height, _ = grid.shape  # Grid dimensions (x, y, kinds)\n  primitive_idx = primitive  # The integer ID of the primitive to collect\n\n  # Initialize BFS queue and visited set\n  # Queue stores tuples: (current_position, current_direction, list_of_actions_taken_to_reach_here)\n  q = collections.deque([(start_pos, start_dir, [])])\n  # Visited set stores (position, direction) tuples to avoid redundant exploration and cycles\n  visited = {(start_pos, start_dir)}\n\n  while q:\n      curr_pos, curr_dir, path = q.popleft()\n\n      # Check if the primitive is in the cell directly in front of the agent\n      # Calculate the coordinates of the cell in front\n      front_dx, front_dy = DIR_VALUE_TO_DELTA[curr_dir]\n      front_x, front_y = curr_pos[0] + front_dx, curr_pos[1] + front_dy\n\n      # Check if the front cell is within grid boundaries\n      if 0 <= front_x < width and 0 <= front_y < height:\n          # Check if the primitive exists at the front cell\n          if grid[front_x, front_y, primitive_idx] > 0:\n              # If yes, we can use the primitive. Append USE action and return the path.\n              return path + [ACTION_USE]\n\n      # Explore possible movement actions\n      for move_action, (mdx, mdy) in MOVE_DELTAS.items():\n          next_pos_x, next_pos_y = curr_pos[0] + mdx, curr_pos[1] + mdy\n          next_pos = (next_pos_x, next_pos_y)\n\n          # If the agent performs a move action, its internal direction is assumed to\n          # change to align with the direction of that movement.\n          next_dir = ACTION_TO_DIR_VALUE[move_action]\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= next_pos_x < width and 0 <= next_pos_y < height):\n              continue\n\n          # Check if this (position, direction) state has already been visited\n          if (next_pos, next_dir) in visited:\n              continue\n\n          # If not visited, add to the queue and mark as visited\n          visited.add((next_pos, next_dir))\n          q.append((next_pos, next_dir, path + [move_action]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive is found\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:22:44.676047", "function_name": "collect", "function_body": "    import collections\n    import copy\n    import numpy as np\n\n    # Helper function for BFS pathfinding, nested to fit the strict output requirement.\n    def _find_path_to_adjacent_bfs(start_state_copy, primitive_idx, world_ref, N_MOVE_ACTIONS):\n        \"\"\"\n        Performs a Breadth-First Search to find the shortest sequence of movement actions\n        that leads the agent to a state where it is adjacent to the specified primitive.\n        \"\"\"\n        q = collections.deque([(start_state_copy, [])]) # Queue stores (state, path_actions_to_reach_this_state)\n        # Visited set to prevent cycles and redundant explorations: (row, col, direction)\n        visited = set([(start_state_copy.pos[0], start_state_copy.pos[1], start_state_copy.dir)])\n\n        # Max steps for the BFS to prevent excessively long searches in case of very large maps\n        # or complex unreachability. This limit might need tuning.\n        MAX_BFS_STEPS_INTERNAL = 10000 \n        bfs_steps_taken = 0\n\n        while q and bfs_steps_taken < MAX_BFS_STEPS_INTERNAL:\n            current_s, current_path = q.popleft()\n\n            # If the current state is already adjacent to the primitive, no more moves needed to get adjacent.\n            # This handles the case where the agent starts next to the primitive.\n            if current_s.next_to(primitive_idx):\n                return current_path\n\n            # Explore movement actions (DOWN, UP, LEFT, RIGHT)\n            for action in range(N_MOVE_ACTIONS):\n                # Apply the action to a *copy* of the current simulation state\n                # to get the next state in the BFS search. Reward is always 0.0.\n                next_s, _ = current_s.step(action) \n\n                next_pos_dir = (next_s.pos[0], next_s.pos[1], next_s.dir)\n\n                if next_pos_dir not in visited:\n                    visited.add(next_pos_dir)\n                    new_path = current_path + [action]\n                    \n                    # Check if the *next* state becomes adjacent after this move\n                    if next_s.next_to(primitive_idx):\n                        return new_path # Found shortest path to a state adjacent to primitive\n                    \n                    q.append((next_s, new_path))\n                    bfs_steps_taken += 1\n\n        return None # No path found within BFS limit, or no primitive reachable\n\n\n    actions_to_take = []\n\n    # Get the initial state from the environment.\n    # CraftLab internally holds _current_state, which is a CraftState object.\n    # We must deepcopy it to simulate actions without altering the actual environment state.\n    current_sim_state = copy.deepcopy(env._current_state)\n\n    # Action constants from CraftLab action_specs: DOWN\u21920, UP\u21921, LEFT\u21922, RIGHT\u21923, USE\u21924\n    USE_ACTION = 4\n    N_MOVE_ACTIONS = 4 # Number of movement actions (0, 1, 2, 3)\n\n    # Safety break to prevent infinite loops in case of uncollectable items or unreachable states.\n    max_total_sim_actions = 2000 # Max total actions to generate in the plan\n    sim_actions_count = 0\n\n    # Loop until the primitive is collected (i.e., appears in inventory)\n    while current_sim_state.inventory[primitive] == 0:\n        # Check if we've exceeded the maximum allowed simulated actions to prevent infinite loops\n        if sim_actions_count >= max_total_sim_actions:\n            break \n\n        # Check if the primitive is next to the agent in the current simulated state\n        if current_sim_state.next_to(primitive):\n            # If next to it, use the 'USE' action to collect it\n            actions_to_take.append(USE_ACTION)\n            _, current_sim_state = current_sim_state.step(USE_ACTION)\n            sim_actions_count += 1\n        else:\n            # If not next to it, plan a path using BFS to get adjacent\n            # The CraftState's `world` attribute points to the CraftWorld instance,\n            # which is necessary for `CraftState.step` to determine valid moves.\n            path_actions = _find_path_to_adjacent_bfs(current_sim_state, primitive, current_sim_state.world, N_MOVE_ACTIONS)\n\n            if path_actions is not None:\n                actions_to_take.extend(path_actions)\n                # Apply the planned path actions to the simulated state\n                for action in path_actions:\n                    _, current_sim_state = current_sim_state.step(action)\n                    sim_actions_count += 1\n            else:\n                # No path found to any primitive on the map within the BFS limit.\n                # This could happen if it's blocked, not present, or the path is too long.\n                # In such a case, we cannot proceed, so we break and return the actions generated so far.\n                break \n\n    return actions_to_take", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:23:43.065135", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Define a maximum number of steps for the BFS to find a path.\n  # This prevents excessively long search times and limits the length of the generated action sequence.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function defined inside to adhere to the \"only return code that will fit in that function\" rule.\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent.\n\n      Args:\n          y (int): Agent's current row coordinate.\n          x (int): Agent's current column coordinate.\n          direction (int): Agent's current facing direction (0=Up, 1=Right, 2=Down, 3=Left).\n\n      Returns:\n          tuple[int, int]: (row, column) coordinates of the cell in front.\n      \"\"\"\n      if direction == 0:  # UP\n          return y - 1, x\n      if direction == 1:  # RIGHT\n          return y, x + 1\n      if direction == 2:  # DOWN\n          return y + 1, x\n      if direction == 3:  # LEFT\n          return y, x - 1\n      # Fallback for unexpected direction value, though typically not reached during valid gameplay.\n      return y, x\n\n  actions_taken = []\n\n  # IMPORTANT IMPROVEMENT for v2: Do NOT call env.reset() here.\n  # The `collect` function should compute actions from the *current* state of the environment,\n  # allowing it to be chained with other actions or used as part of a larger plan.\n  # Access the internal CraftState instance directly to get the current state information.\n  current_state = env._current_state\n\n  # Basic validation: Ensure the `primitive` is a recognized entity kind in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # Optimization: If the `primitive` is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Retrieve necessary environment information for pathfinding.\n  # Use current_state.grid directly for the full world grid.\n  full_grid = current_state.grid\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir # Use current_state.dir, as env is not reset to init_dir.\n\n  # Determine which entity kinds are impassable for agent movement.\n  # This set will include water (if defined) and any non-grabbable items that are not workshops.\n  impassable_for_movement = set()\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  # Iterate through all non-grabbable indices.\n  # Assume that non-grabbable items that are *not* workshops are actual blockers for movement.\n  # Workshops (e.g., workbench, furnace) are typically traversable even if they cannot be picked up.\n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # The agent's direction automatically updates based on the movement action performed.\n  movement_actions_map = {\n      ACTION_UP:    (0, -1, 0),  # Action UP: results in direction 0 (UP), moves North\n      ACTION_RIGHT: (1, 0, 1),   # Action RIGHT: results in direction 1 (RIGHT), moves East\n      ACTION_DOWN:  (2, 1, 0),   # Action DOWN: results in direction 2 (DOWN), moves South\n      ACTION_LEFT:  (3, 0, -1)   # Action LEFT: results in direction 3 (LEFT), moves West\n  }\n\n  q = collections.deque()\n  # BFS queue state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  # Storing the current direction is crucial because `ACTION_USE` is dependent on agent orientation.\n\n  # If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # Initialize BFS: Start from the agent's current position and direction with an empty action path.\n  q.append((start_y, start_x, start_dir, []))\n  # Keep track of visited states to prevent redundant exploration and infinite loops in cyclic maps.\n  # A state is defined by (position_y, position_x, direction) because the same grid cell\n  # with a different orientation constitutes a distinct state for the purpose of `ACTION_USE`.\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None  # This variable will store the final sequence of actions if a valid path is found.\n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Optimization: If the current path length already exceeds MAX_COLLECT_STEPS,\n      # this branch cannot lead to a valid solution within the specified limits.\n      if len(path) > MAX_COLLECT_STEPS:\n          continue\n\n      # Calculate the coordinates of the grid cell that the agent is currently facing.\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Check if the facing cell is within grid boundaries and contains the target primitive.\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n          full_grid[facing_y, facing_x, primitive] > 0):\n\n          # We've found a position and orientation from which `ACTION_USE` can be performed successfully.\n          candidate_path = path + [ACTION_USE]\n\n          # Ensure the complete path (including the final `ACTION_USE`) is within the step limit.\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              # Since BFS guarantees finding the shortest path first, we can stop as soon as one is found.\n              break # Exit the BFS loop\n\n      # Explore all possible next states from the current state (curr_y, curr_x, curr_dir).\n      # This involves trying each possible movement action.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Pruning: If adding this move makes the path too long, skip this potential step.\n          if len(path) + 1 > MAX_COLLECT_STEPS:\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable based on the `impassable_for_movement` set.\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0: # If the cell contains an impassable object\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # Check if this new (position, direction) state has already been visited.\n          # This prevents redundant work and infinite loops in cyclic environments.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # If all checks pass, add the new state to the queue for further exploration.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      # If no valid path was found within the step limit, return an empty list.\n      return []\n\n  for action in path_to_execute:\n      actions_taken.append(action)\n      # Perform the action in the environment.\n      reward, done, _ = env.step(action)\n      # Update the internal state reference after each step to reflect the current environment.\n      current_state = env._current_state\n\n      # Check for early termination of the episode without successfully collecting the primitive.\n      # This ensures robustness if the environment ends due to other reasons (e.g., `max_steps` reached\n      # by `CraftLab`) before the collection is complete.\n      if done and current_state.inventory[primitive] <= 0:\n          return []  # Episode ended, but the goal was not satisfied.\n\n      # If the primitive is collected, we can stop executing the remaining actions in the path.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n  # Final check after executing all actions in the `path_to_execute`.\n  # This handles cases where the primitive is collected on the very last action of the path.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it indicates a discrepancy (e.g., the primitive disappeared dynamically),\n      # which should ideally not happen if the BFS correctly found a path.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:23:44.128022", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Define a maximum number of steps for the BFS to find a path.\n  # This prevents excessively long search times and limits the length of the generated action sequence.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the coordinates of the cell directly in front of the agent.\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent.\n      Args:\n          y (int): Agent's current row coordinate.\n          x (int): Agent's current column coordinate.\n          direction (int): Agent's current facing direction (0=Up, 1=Right, 2=Down, 3=Left).\n      Returns:\n          tuple[int, int]: (row, column) coordinates of the cell in front.\n      \"\"\"\n      if direction == 0:  # UP\n          return y - 1, x\n      if direction == 1:  # RIGHT\n          return y, x + 1\n      if direction == 2:  # DOWN\n          return y + 1, x\n      if direction == 3:  # LEFT\n          return y, x - 1\n      return y, x # Should not be reached with valid directions\n\n  actions_taken = []\n\n  # IMPROVEMENT for v2: Do NOT call env.reset().\n  # This function computes actions from the *current* state of the environment,\n  # allowing it to be chained with other actions or used as part of a larger plan.\n  # Access the internal CraftState instance directly to get the current state information.\n  current_state = env._current_state\n\n  # Basic validation: Ensure the `primitive` is a recognized entity kind in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # Optimization: If the `primitive` is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Retrieve necessary environment information for pathfinding from the current state.\n  full_grid = current_state.grid # Use the actual current grid state\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir # Use current_state.dir, as the agent's direction can change\n\n  # Determine which entity kinds are impassable for agent movement.\n  # This set will include water (if defined) and any non-grabbable items that are NOT workshops.\n  # Workshops (e.g., workbench, furnace) are typically traversable even if they cannot be picked up.\n  impassable_for_movement = set()\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # The agent's direction automatically updates based on the movement action performed.\n  # Direction mapping: 0=Up, 1=Right, 2=Down, 3=Left\n  movement_actions_map = {\n      ACTION_UP:    (0, -1, 0),  # Action UP: results in direction 0 (UP), moves North (dy=-1, dx=0)\n      ACTION_RIGHT: (1, 0, 1),   # Action RIGHT: results in direction 1 (RIGHT), moves East (dy=0, dx=1)\n      ACTION_DOWN:  (2, 1, 0),   # Action DOWN: results in direction 2 (DOWN), moves South (dy=1, dx=0)\n      ACTION_LEFT:  (3, 0, -1)   # Action LEFT: results in direction 3 (LEFT), moves West (dy=0, dx=-1)\n  }\n\n  q = collections.deque()\n  # BFS queue state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  # Storing the current direction is crucial because `ACTION_USE` is dependent on agent orientation.\n  q.append((start_y, start_x, start_dir, []))\n  \n  # Keep track of visited states to prevent redundant exploration and infinite loops in cyclic maps.\n  # A state is defined by (position_y, position_x, direction) because the same grid cell\n  # with a different orientation constitutes a distinct state for the purpose of `ACTION_USE`.\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None  # This variable will store the final sequence of actions if a valid path is found.\n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Optimization: If the current path length already exceeds MAX_COLLECT_STEPS,\n      # this branch cannot lead to a valid solution within the specified limits.\n      if len(path) > MAX_COLLECT_STEPS:\n          continue\n\n      # Calculate the coordinates of the grid cell that the agent is currently facing.\n      facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n      # Check if the facing cell is within grid boundaries and contains the target primitive.\n      if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n          full_grid[facing_y, facing_x, primitive] > 0):\n\n          # We've found a position and orientation from which `ACTION_USE` can be performed successfully.\n          candidate_path = path + [ACTION_USE]\n\n          # Ensure the complete path (including the final `ACTION_USE`) is within the step limit.\n          if len(candidate_path) <= MAX_COLLECT_STEPS:\n              path_to_execute = candidate_path\n              # Since BFS guarantees finding the shortest path first, we can stop as soon as one is found.\n              break # Exit the BFS loop\n\n      # Explore all possible next states from the current state (curr_y, curr_x, curr_dir).\n      # This involves trying each possible movement action.\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Pruning: If adding this move makes the path too long, skip this potential step.\n          if len(path) + 1 > MAX_COLLECT_STEPS:\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable based on the `impassable_for_movement` set.\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # Check if this new (position, direction) state has already been visited.\n          if (next_y, next_x, next_dir) in visited:\n              continue\n\n          # If all checks pass, add the new state to the queue for further exploration.\n          visited.add((next_y, next_x, next_dir))\n          q.append((next_y, next_x, next_dir, path + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      # If no valid path was found within the step limit, return an empty list.\n      return []\n\n  for action in path_to_execute:\n      # This check prevents executing actions beyond the global MAX_COLLECT_STEPS limit,\n      # even if the BFS found a longer path before the limit was applied (due to len(path) + 1)\n      if len(actions_taken) >= MAX_COLLECT_STEPS:\n          break \n\n      actions_taken.append(action)\n      \n      # Perform the action in the environment.\n      # env.step() updates env._current_state internally.\n      reward, done, _ = env.step(action)\n      \n      # After each step, check if the primitive has been collected.\n      # If so, we can stop executing the remaining actions in the path.\n      if env._current_state.inventory[primitive] > 0:\n          return actions_taken\n\n      # If the episode ends for any reason (e.g., max_steps reached in CraftLab setup)\n      # and the goal was *not* satisfied, the collection failed.\n      if done and env._current_state.inventory[primitive] <= 0:\n          return []  # Episode ended, but the goal was not satisfied.\n\n  # Final check after executing all actions in the `path_to_execute`.\n  # This handles cases where the primitive is collected on the very last action of the path.\n  if env._current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it implies a failure (e.g., dynamic environment change, or an edge case).\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:24:47.997475", "function_name": "collect", "function_body": "  import heapq # A* search requires a priority queue\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Mapping from movement action to the direction the agent would face after taking it\n  ACTION_TO_DIRECTION = {\n      UP_ACTION: NORTH_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  # Mapping from movement action to (dx, dy) delta\n  ACTION_TO_MOVE_DELTA = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  # Mapping from agent's direction to the (dx, dy) delta of the cell directly in front\n  DIRECTION_TO_FRONT_DELTA = {\n      NORTH_DIR: (0, -1),\n      EAST_DIR: (1, 0),\n      SOUTH_DIR: (0, 1),\n      WEST_DIR: (-1, 0)\n  }\n\n  def _manhattan_distance(p1, p2):\n    \"\"\"Calculates the Manhattan distance between two points (x1, y1) and (x2, y2).\"\"\"\n    return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  def _get_primitive_locations(grid_data, primitive_idx):\n    \"\"\"Finds all (x, y) coordinates where the primitive is located on the grid.\"\"\"\n    y_coords, x_coords = np.where(grid_data[:, :, primitive_idx] == 1)\n    return [(x, y) for x, y in zip(x_coords, y_coords)]\n\n  def _heuristic(current_pos, all_primitive_locations):\n    \"\"\"Calculates the Manhattan distance from current_pos to the nearest primitive.\"\"\"\n    if not all_primitive_locations:\n      return float('inf') # No primitives on the map\n    min_dist = float('inf')\n    for p_loc in all_primitive_locations:\n      min_dist = min(min_dist, _manhattan_distance(current_pos, p_loc))\n    return min_dist\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Check if the primitive is already in inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  non_grabbable_kinds = env.world.non_grabbable_indices\n  \n  # Pre-calculate all primitive locations for the heuristic\n  all_primitive_locations = _get_primitive_locations(grid, primitive_id)\n  if not all_primitive_locations:\n    return [] # Primitive not on the grid\n\n  def is_walkable(x, y):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-grabbable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item is present at (y, x)\n    # Using np.any() for efficiency if non_grabbable_kinds is a list/set of indices\n    for kind_idx in non_grabbable_kinds:\n      if grid[y, x, kind_idx] > 0:\n        return False\n    return True\n\n  # A* search initialization\n  # Priority queue stores tuples: (f_score, g_score, x, y, direction, path_actions)\n  # f_score = g_score + h_score\n  priority_queue = []\n  \n  # g_scores stores the cost from start to a state (x, y, dir)\n  g_scores = {} \n\n  # Initial state\n  initial_g_score = 0\n  initial_h_score = _heuristic((start_pos_x, start_pos_y), all_primitive_locations)\n  initial_f_score = initial_g_score + initial_h_score\n\n  heapq.heappush(priority_queue, (initial_f_score, initial_g_score, start_pos_x, start_pos_y, start_dir, []))\n  g_scores[(start_pos_x, start_pos_y, start_dir)] = initial_g_score\n\n  while priority_queue:\n    f_score, g_score, curr_x, curr_y, curr_dir, path_actions = heapq.heappop(priority_queue)\n\n    # If we found a shorter path to this state already, skip\n    if g_score > g_scores.get((curr_x, curr_y, curr_dir), float('inf')):\n      continue\n\n    # --- Goal Check: Can we use the primitive from the current state? ---\n    # Determine the cell directly in front of the agent\n    front_dx, front_dy = DIRECTION_TO_FRONT_DELTA[curr_dir]\n    front_x, front_y = curr_x + front_dx, curr_y + front_dy\n\n    # Check if the cell in front is within bounds and contains the primitive\n    if (0 <= front_x < grid_width and 0 <= front_y < grid_height and\n        grid[front_y, front_x, primitive_id] > 0):\n      return path_actions + [USE_ACTION] # Goal reached: return path plus USE action\n\n    # --- Expand possible next states ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for move_action, (dx, dy) in ACTION_TO_MOVE_DELTA.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir_after_move = ACTION_TO_DIRECTION[move_action] # Agent's direction changes to match movement\n      new_g_score = g_score + 1 # Cost of one action\n\n      if is_walkable(next_x, next_y):\n        if new_g_score < g_scores.get((next_x, next_y, next_dir_after_move), float('inf')):\n          g_scores[(next_x, next_y, next_dir_after_move)] = new_g_score\n          new_h_score = _heuristic((next_x, next_y), all_primitive_locations)\n          new_f_score = new_g_score + new_h_score\n          heapq.heappush(priority_queue, (new_f_score, new_g_score, next_x, next_y, next_dir_after_move, path_actions + [move_action]))\n\n    # B. Turning Actions (LEFT, RIGHT)\n    # These actions change direction but not position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n      \n      new_g_score = g_score + 1 # Cost of one action\n\n      # Position remains the same (curr_x, curr_y)\n      if new_g_score < g_scores.get((curr_x, curr_y, next_dir), float('inf')):\n        g_scores[(curr_x, curr_y, next_dir)] = new_g_score\n        # Heuristic remains the same as position hasn't changed\n        new_h_score = _heuristic((curr_x, curr_y), all_primitive_locations)\n        new_f_score = new_g_score + new_h_score\n        heapq.heappush(priority_queue, (new_f_score, new_g_score, curr_x, curr_y, next_dir, path_actions + [turn_action]))\n\n  # If the queue becomes empty and no path to a primitive was found\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:24:48.985948", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Mapping from movement action to the direction the agent would face after taking it\n  ACTION_TO_DIRECTION = {\n      UP_ACTION: NORTH_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  # Mapping from movement action to (dx, dy) delta\n  ACTION_TO_MOVE_DELTA = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  # Mapping from agent's direction to the (dx, dy) delta of the cell directly in front\n  DIRECTION_TO_FRONT_DELTA = {\n      NORTH_DIR: (0, -1),\n      EAST_DIR: (1, 0),\n      SOUTH_DIR: (0, 1),\n      WEST_DIR: (-1, 0)\n  }\n\n  # Get primitive's integer ID\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Validate that the primitive is indeed a grabbable item.\n  # Only items in world.grabbable_indices can be \"collected\" via USE_ACTION when next to them.\n  if primitive_id not in env.world.grabbable_indices:\n    # If it's not grabbable, it cannot be collected using the 'USE' action in this context.\n    # Return empty list as it's not a collectable primitive.\n    return []\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Check if the primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # These are entities the agent cannot walk *onto*, typically defined by non_grabbable_indices.\n  non_walkable_kinds = env.world.non_grabbable_indices\n\n  def is_walkable(x, y, current_grid):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-walkable items.\n    Non-grabbable entities typically represent impassable terrain in CraftWorld.\n    \"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable (and thus non-walkable) item is present at (y, x)\n    for kind_idx in non_walkable_kinds:\n      if current_grid[y, x, kind_idx] > 0:\n        return False\n    return True\n\n  # Initialize BFS queue: (current_x, current_y, current_direction, path_actions_list)\n  # The path_actions_list stores the sequence of actions taken to reach this state.\n  queue = collections.deque([(start_pos_x, start_pos_y, start_dir, [])])\n  # Initialize visited set to avoid cycles and redundant paths: (x, y, direction)\n  visited = {(start_pos_x, start_pos_y, start_dir)}\n\n  # Run BFS\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # --- Goal Check: Can we use the primitive from the current state? ---\n    # Determine the cell directly in front of the agent based on current position and direction\n    front_dx, front_dy = DIRECTION_TO_FRONT_DELTA[curr_dir]\n    front_x, front_y = curr_x + front_dx, curr_y + front_dy\n\n    # Check if the cell in front is within bounds AND contains the target primitive\n    if (0 <= front_x < grid_width and 0 <= front_y < grid_height and\n        grid[front_y, front_x, primitive_id] > 0):\n      # Goal reached: agent is positioned and facing the primitive.\n      # Return the path found by BFS, followed by the USE action.\n      return path_actions + [USE_ACTION]\n\n    # --- Expand possible next states from current state ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for move_action, (dx, dy) in ACTION_TO_MOVE_DELTA.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      # After a movement action, the agent's direction automatically aligns with the direction of movement.\n      next_dir_after_move = ACTION_TO_DIRECTION[move_action]\n\n      # If the next cell is walkable and this (position, direction) state hasn't been visited:\n      if is_walkable(next_x, next_y, grid) and\\\n         (next_x, next_y, next_dir_after_move) not in visited:\n        # Mark as visited and add to queue for further exploration.\n        visited.add((next_x, next_y, next_dir_after_move))\n        queue.append((next_x, next_y, next_dir_after_move, path_actions + [move_action]))\n\n    # B. Turning Actions (LEFT, RIGHT)\n    # These actions change only direction, not position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise (handling negative result for modulo)\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n\n      # If the new (position, direction) state hasn't been visited (position is same):\n      if (curr_x, curr_y, next_dir) not in visited:\n        # Mark as visited and add to queue.\n        visited.add((curr_x, curr_y, next_dir))\n        queue.append((curr_x, curr_y, next_dir, path_actions + [turn_action]))\n\n  # If the queue becomes empty and no path to a collectable primitive was found,\n  # it means the primitive is unreachable or not present.\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:26:46.926842", "function_name": "collect", "function_body": "  # Action mappings (from CraftLab.action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Direction vectors for grid movement (dx, dy)\n  # Assuming grid is indexed as (x, y) where x is column, y is row,\n  # and grid.shape is (WIDTH, HEIGHT, n_kinds)\n  MOVE_DELTAS = {\n      UP: (0, -1),   # (dx, dy) = (0, -1) for moving north (decreases y)\n      DOWN: (0, 1),    # (dx, dy) = (0, 1) for moving south (increases y)\n      LEFT: (-1, 0),   # (dx, dy) = (-1, 0) for moving west (decreases x)\n      RIGHT: (1, 0),   # (dx, dy) = (1, 0) for moving east (increases x)\n  }\n\n  # Inverse mapping for converting delta to action\n  DELTA_TO_ACTION = {\n      (0, -1): UP,\n      (0, 1): DOWN,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT,\n  }\n\n  def _find_item_on_grid(grid, item_kind_idx):\n      \"\"\"Finds the first occurrence of item_kind_idx on the grid.\n      Grid shape is (WIDTH, HEIGHT, n_kinds). Returns (x, y) coordinates.\"\"\"\n      W, H, _ = grid.shape\n      for x in range(W):\n          for y in range(H):\n              if grid[x, y, item_kind_idx] > 0: # Check if the kind is present\n                  return (x, y)\n      return None\n\n  def _is_traversable(grid, pos, water_index, stone_index):\n      \"\"\"Checks if a grid cell is traversable (not water or stone).\n      pos is (x, y).\"\"\"\n      x, y = pos\n      W, H, _ = grid.shape\n      if not (0 <= x < W and 0 <= y < H):\n          return False # Out of bounds\n      # A cell is blocked if it contains water or stone\n      if grid[x, y, water_index] > 0 or grid[x, y, stone_index] > 0:\n          return False # Obstacle\n      return True\n\n  def _bfs_path_to_adjacent(start_pos, target_pos, grid, water_index, stone_index):\n      \"\"\"\n      Finds a path from start_pos to any cell adjacent to target_pos using BFS.\n      Returns a list of positions (x, y) that form the path, excluding start_pos,\n      or None if no path is found.\n      \"\"\"\n      queue = collections.deque([(start_pos, [])]) # (current_pos, path_so_far)\n      visited = {start_pos}\n\n      while queue:\n          (curr_x, curr_y), path = queue.popleft()\n\n          # Check if current position is adjacent to target_pos\n          # Manhattan distance == 1 means adjacent\n          if abs(curr_x - target_pos[0]) + abs(curr_y - target_pos[1]) == 1:\n              return path # Path to an adjacent cell\n\n          # Explore neighbors\n          for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]: # Cardinal directions (dx, dy)\n              next_x, next_y = curr_x + dx, curr_y + dy\n              next_pos = (next_x, next_y)\n\n              if _is_traversable(grid, next_pos, water_index, stone_index) and next_pos not in visited:\n                  visited.add(next_pos)\n                  queue.append((next_pos, path + [next_pos]))\n\n      return None # No path found\n\n  def _pos_path_to_actions(start_pos, path_of_positions):\n      \"\"\"Converts a path of positions (x, y) to a list of actions.\"\"\"\n      actions = []\n      current_pos = start_pos\n      for next_pos in path_of_positions:\n          dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n          action = DELTA_TO_ACTION.get((dx, dy))\n          if action is not None:\n              actions.append(action)\n              current_pos = next_pos\n          # If action is None, it means the path contains non-cardinal moves or\n          # is ill-formed for this movement system. In this context, it should not happen.\n      return actions\n\n  all_actions = [] # List to store all actions taken\n\n  # --- Setup: Get environment specific indices for obstacles ---\n  # Access CraftWorld via CraftLab's world attribute\n  world = env.world\n  water_index = world.water_index\n  stone_index = world.stone_index\n\n  # --- Main Loop: Try to collect the primitive ---\n  # Max steps to prevent infinite loops, e.g., if item is unreachable\n  MAX_COLLECT_STEPS = 200 \n  current_step_count = 0\n\n  # Reset environment to get initial state\n  _ = env.reset() # Discard initial observations, get state via _current_state\n\n  while current_step_count < MAX_COLLECT_STEPS:\n      current_state = env._current_state # Access the internal CraftState instance\n      current_pos_agent = current_state.pos # (x, y) tuple\n      current_inventory = current_state.inventory\n      current_grid = current_state.grid # (WIDTH, HEIGHT, n_kinds) numpy array\n\n      # 1. Check if primitive is already collected\n      if current_inventory[primitive] > 0:\n          break # Goal achieved\n\n      # 2. Find the primitive on the grid\n      target_item_pos = _find_item_on_grid(current_grid, primitive)\n\n      if target_item_pos is None:\n          # Primitive not found on the map. This might happen if it's a transient item\n          # or if the task requires crafting it. For a 'collect' function, we assume\n          # it's directly visible. If not found, can't collect it.\n          # Break and return current actions.\n          break\n\n      # 3. Plan path to an adjacent cell\n      # This BFS finds a path of positions to a cell from which 'USE' can be applied.\n      path_to_adj = _bfs_path_to_adjacent(\n          current_pos_agent, target_item_pos, current_grid, water_index, stone_index\n      )\n\n      if path_to_adj is None:\n          # No path found by BFS. This could mean:\n          # a) The agent is already adjacent to the target.\n          # b) The target is completely surrounded by obstacles and unreachable.\n\n          # Check if already adjacent and can try to USE.\n          if abs(current_pos_agent[0] - target_item_pos[0]) + \\\n             abs(current_pos_agent[1] - target_item_pos[1]) == 1:\n              # Agent is already next to the primitive, so try to USE\n              action_to_take = USE\n              all_actions.append(action_to_take)\n              _, _, _ = env.step(action_to_take) # Perform the USE action\n              current_step_count += 1\n              # After USE, the inventory will be checked in the next loop iteration\n              continue # Continue to re-evaluate state\n          else:\n              # Cannot reach the item (it's on map, but blocked/unreachable).\n              # Break to avoid infinite loop.\n              break\n\n      # 4. Execute path and then USE\n      # Convert the path of positions into a sequence of movement actions\n      actions_for_path = _pos_path_to_actions(current_pos_agent, path_to_adj)\n\n      # Execute movement actions one by one\n      for action in actions_for_path:\n          all_actions.append(action)\n          _, _, _ = env.step(action) # Perform the movement action\n          current_step_count += 1\n          if current_step_count >= MAX_COLLECT_STEPS:\n              # If we hit max steps during path execution, break out\n              break \n      \n      if current_step_count >= MAX_COLLECT_STEPS:\n          break # Ensure we exit the main loop if step limit is reached\n\n      # After moving, the agent should now be adjacent to the primitive.\n      # Take the USE action to collect it.\n      action_to_take = USE\n      all_actions.append(action_to_take)\n      _, _, _ = env.step(action_to_take) # Perform the USE action\n      current_step_count += 1\n\n  return all_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:26:47.937886", "function_name": "collect", "function_body": "  # Action constants - usually global, but placed here to fit \"inside the function\"\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _get_path_bfs_to_multiple_targets(grid, start_pos, target_positions, non_grabbable_indices):\n      \"\"\"\n      Performs a BFS on the grid to find a path from start_pos to any of target_positions.\n      Args:\n          grid (np.ndarray): The global grid (WIDTH, HEIGHT, n_kinds).\n          start_pos (tuple): (x, y) current agent position.\n          target_positions (list): List of (x, y) tuples for potential target item positions.\n          non_grabbable_indices (set): Indices of entity kinds that act as obstacles.\n      Returns:\n          list: A list of (x, y) coordinates representing the path from start to *one* of the targets (inclusive),\n                or None if no path found.\n      \"\"\"\n      WIDTH, HEIGHT, _ = grid.shape # Unpack dimensions based on (WIDTH, HEIGHT, n_kinds)\n      queue = deque([(start_pos, [])]) # (current_x, current_y), path_so_far\n      visited = {start_pos}\n      target_set = set(target_positions)\n\n      obstacles = set()\n      for x in range(WIDTH):\n          for y in range(HEIGHT):\n              for kind_idx in non_grabbable_indices:\n                  if grid[x, y, kind_idx] > 0: # Access grid[x, y, kind]\n                      obstacles.add((x, y))\n                      break\n      # Agent can start on a cell that might otherwise be an obstacle (e.g., water).\n      # If start_pos is in obstacles, agent can still move *from* it, but not into other obstacle cells.\n      # It's important that start_pos itself is considered traversable for the agent.\n      obstacles.discard(start_pos)\n\n      # Define possible moves (dx, dy)\n      possible_moves = [(0, 1), (0, -1), (1, 0), (-1, 0)] # (dx, dy) for (y+1, y-1, x+1, x-1) respectively.\n\n      while queue:\n          (curr_x, curr_y), path = queue.popleft()\n\n          if (curr_x, curr_y) in target_set:\n              return path + [(curr_x, curr_y)] # Return full path including the target reached\n\n          for dx, dy in possible_moves:\n              next_x, next_y = curr_x + dx, curr_y + dy\n\n              if (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT and # Check bounds\n                  (next_x, next_y) not in visited and\n                  (next_x, next_y) not in obstacles):\n\n                  visited.add((next_x, next_y))\n                  queue.append(((next_x, next_y), path + [(curr_x, curr_y)]))\n\n      return None # No path found\n\n  def _path_to_actions(path):\n      \"\"\"\n      Converts a path of (x, y) coordinates into a list of movement actions.\n      Assumes standard DMLab action mapping: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT.\n      Path is (x1,y1) -> (x2,y2) -> ...\n      \"\"\"\n      actions = []\n      if not path or len(path) < 2:\n          return actions\n\n      for i in range(len(path) - 1):\n          x1, y1 = path[i]\n          x2, y2 = path[i+1]\n\n          # Determine action based on (dx, dy) from (x1, y1) to (x2, y2)\n          if y2 == y1 + 1: # Moved from y to y+1\n              actions.append(DOWN)\n          elif y2 == y1 - 1: # Moved from y to y-1\n              actions.append(UP)\n          elif x2 == x1 - 1: # Moved from x to x-1\n              actions.append(LEFT)\n          elif x2 == x1 + 1: # Moved from x to x+1\n              actions.append(RIGHT)\n          # Assuming only cardinal moves\n      return actions\n\n  # --- Main logic for collect_v2 starts here ---\n\n  # Get initial observations to setup the pathfinding\n  _ = env.reset() # Reset environment to get initial state\n  obs = env.observations()\n\n  # Extract relevant info from observations\n  current_grid = obs['features_dict']['features_global']\n  current_pos = obs['features_dict']['pos'] # (x, y) tuple, consistent with grid shape (WIDTH, HEIGHT)\n  WIDTH, HEIGHT, N_KINDS = current_grid.shape\n\n  # Get non-grabbable indices from the world object.\n  # The `CraftLab` instance has a `world` attribute which is a `CraftWorld` instance.\n  # `CraftWorld` has `non_grabbable_indices`.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find the target primitive's location\n  # np.where returns (x_indices, y_indices) assuming (X, Y, Z) array indexing for grid[X, Y, Z]\n  primitive_x_coords, primitive_y_coords = np.where(current_grid[:, :, primitive] > 0)\n\n  if len(primitive_x_coords) == 0:\n      # Primitive not found in the initial grid\n      return []\n\n  # Choose the first occurrence of the primitive as its exact location\n  primitive_exact_pos = (primitive_x_coords[0], primitive_y_coords[0])\n\n  # Determine possible \"use\" positions: cells adjacent to the primitive_exact_pos\n  # From which the agent can perform a USE action.\n  possible_use_positions = []\n  px, py = primitive_exact_pos\n  # Relative coordinates for adjacent cells (dx, dy)\n  candidate_agent_relative_coords = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n\n  # Compute obstacles once to pass to the BFS helper\n  obstacles_for_bfs = set()\n  for x_iter in range(WIDTH):\n      for y_iter in range(HEIGHT):\n          for kind_idx in non_grabbable_indices:\n              if current_grid[x_iter, y_iter, kind_idx] > 0:\n                  obstacles_for_bfs.add((x_iter, y_iter))\n                  break\n  # Agent can stand on a cell that might otherwise be an obstacle, so remove current_pos if present.\n  obstacles_for_bfs.discard(current_pos)\n\n\n  for dx, dy in candidate_agent_relative_coords:\n      adj_x, adj_y = px + dx, py + dy\n      if (0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT and\n          # Check if the adjacent cell is NOT an obstacle for the *agent to move into*\n          (adj_x, adj_y) not in obstacles_for_bfs):\n          possible_use_positions.append((adj_x, adj_y))\n\n  if not possible_use_positions:\n      # Primitive is completely surrounded by obstacles or at the map edge such that no adjacent cell is traversable\n      return []\n\n  # Find the shortest path from current_pos to any of the possible_use_positions\n  path_coords = _get_path_bfs_to_multiple_targets(current_grid, current_pos, possible_use_positions, non_grabbable_indices)\n\n  if path_coords is None:\n      # No path found to any adjacent cell where USE action can be performed\n      return []\n\n  # Convert the path of coordinates to movement actions\n  actions_to_reach_primitive = _path_to_actions(path_coords)\n\n  # After reaching the adjacent position, perform the USE action\n  actions_to_reach_primitive.append(USE)\n\n  return actions_to_reach_primitive", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:28:42.619053", "function_name": "collect", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:28:43.582884", "function_name": "collect", "function_body": "  all_actions = []\n  MAX_COLLECT_STEPS = 200  # Max total actions to try collecting\n\n  # Helper for pathfinding (BFS) to find a path to a cell adjacent to the target item.\n  def _find_path_to_adjacent_cell(current_grid, start_pos, target_kind_idx, world_ref):\n      grid_height, grid_width, _ = current_grid.shape\n      \n      # Action mappings for BFS (absolute directions corresponding to CraftLab actions)\n      # 0: DOWN, 1: UP, 2: LEFT, 3: RIGHT\n      action_deltas = {\n          0: (1, 0),  # DOWN (row + 1)\n          1: (-1, 0), # UP (row - 1)\n          2: (0, -1), # LEFT (col - 1)\n          3: (0, 1)   # RIGHT (col + 1)\n      }\n\n      # Find all cells that contain the target primitive\n      target_item_locations = np.argwhere(current_grid[:, :, target_kind_idx] == 1)\n      if len(target_item_locations) == 0:\n          return None # Target not present on the map\n\n      # Determine all target \"goal\" positions for BFS: cells adjacent to any target item.\n      goal_positions = set()\n      # Get the index for 'wall' to identify impassable terrain\n      wall_idx = world_ref.cookbook.index.contents.get('wall')\n      \n      for r_t, c_t in target_item_locations:\n          # Check all 4 direct neighbors\n          for dr, dc in [(0,1), (0,-1), (1,0), (-1,0)]:\n              r_adj, c_adj = r_t + dr, c_t + dc\n              \n              # Ensure adjacent cell is within grid bounds\n              if 0 <= r_adj < grid_height and 0 <= c_adj < grid_width:\n                  # Check if this adjacent cell is walkable (not a wall)\n                  if wall_idx is not None and current_grid[r_adj, c_adj, wall_idx] == 1:\n                      continue # Skip if adjacent cell is a wall (impassable)\n                  \n                  goal_positions.add((r_adj, c_adj))\n\n      if not goal_positions:\n          return None # No reachable adjacent cells\n\n      q = deque([(start_pos, [])]) # Queue stores (current_position, path_actions_taken)\n      visited = {start_pos} # Set of visited positions to prevent cycles\n\n      while q:\n          (r, c), path = q.popleft()\n\n          if (r, c) in goal_positions:\n              return path # Found a path to an adjacent cell\n\n          # Limit the BFS search depth to prevent excessively long paths\n          if len(path) >= MAX_COLLECT_STEPS:\n              continue\n\n          for action_val, (dr, dc) in action_deltas.items():\n              nr, nc = r + dr, c + dc # New potential position\n\n              if 0 <= nr < grid_height and 0 <= nc < grid_width and (nr, nc) not in visited:\n                  # Check if the new cell (nr, nc) is impassable (e.g., a wall)\n                  is_impassable = False\n                  if wall_idx is not None and current_grid[nr, nc, wall_idx] == 1:\n                      is_impassable = True\n                  \n                  # Note: This logic assumes only 'wall' is strictly impassable.\n                  # Other non-grabbable items might be walkable (e.g., 'water', 'stone' if not pickable).\n                  # More complex environments might require a detailed walkability map.\n                  \n                  if not is_impassable:\n                      visited.add((nr, nc))\n                      q.append(((nr, nc), path + [action_val]))\n      \n      return None # No path found to any adjacent cell within the search limits\n\n\n  # Main collect_v2 logic loop\n  for _ in range(MAX_COLLECT_STEPS):\n      # Access the current state of the environment directly from CraftLab's internal state\n      current_state = env._current_state \n      \n      # 1. Check if the primitive is already in the agent's inventory\n      if current_state.inventory[primitive] > 0:\n          break # Goal achieved, stop collecting\n\n      # 2. Check if the agent is next to the primitive and it is grabbable, then attempt to USE it\n      if current_state.next_to(primitive):\n          # Ensure the primitive is an item that can be picked up\n          if primitive in current_state.world.grabbable_indices:\n              all_actions.append(4) # Action 4 is 'USE'\n              _, done, _ = env.step(4) # Execute the USE action\n              \n              # After attempting to USE, immediately check if the primitive was collected\n              if env._current_state.inventory[primitive] > 0:\n                  break # Collected successfully!\n              elif done: # Check if environment terminated (e.g., max_steps reached, item depleted)\n                  break \n          # Else: The primitive is next to the agent but not grabbable with USE (e.g., water, non-pickable stone).\n          # For `collect_v2`, if it's not grabbable, direct collection by USE is not possible.\n          # Continue searching, as there might be other instances or recipes.\n          pass \n\n      # 3. If the primitive is not collected and not next to the agent, find a path to it\n      path_to_adjacent_cell = _find_path_to_adjacent_cell(\n          current_grid=current_state.grid,\n          start_pos=current_state.pos,\n          target_kind_idx=primitive,\n          world_ref=current_state.world # Pass the world configuration\n      )\n\n      if path_to_adjacent_cell:\n          # If a path is found, take the first step on that path\n          next_action_move = path_to_adjacent_cell[0]\n          all_actions.append(next_action_move)\n          _, done, _ = env.step(next_action_move) # Execute the movement\n          if done:\n              break\n      else:\n          # If no path is found (e.g., primitive is unreachable or not on map),\n          # perform a random movement action to explore or try to uncover new areas.\n          random_action_move = env.random.choice([0, 1, 2, 3]) # Random move (DOWN, UP, LEFT, RIGHT)\n          all_actions.append(random_action_move)\n          _, done, _ = env.step(random_action_move)\n          if done:\n              break\n            \n  return all_actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:29:53.468851", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Action constants (typically defined globally or imported from an actions module)\n  # For this specific completion, defining them locally for self-containment.\n  _DOWN = 0\n  _UP = 1\n  _LEFT = 2\n  _RIGHT = 3\n  _USE = 4\n\n  current_state = env._current_state\n\n  # 1. Check if primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # BFS setup\n  queue = deque()\n  # visited set stores (pos_tuple, dir_int) to avoid cycles and redundant explorations\n  visited = set()\n\n  # Initial state for BFS: (CraftState object, list of actions to reach this state)\n  # We start with the current state of the environment.\n  queue.append((current_state, []))\n  visited.add((current_state.pos, current_state.dir))\n\n  # Set a reasonable maximum number of iterations to prevent infinite loops\n  # in case the primitive is unreachable or the map is very large.\n  # A typical grid might be 10x10. Agent can be in 100 positions * 4 directions = 400 states.\n  # So, 2000 is a safe upper bound for a simple grid search.\n  max_search_iterations = 2000 \n\n  iterations = 0\n  while queue and iterations < max_search_iterations:\n      iterations += 1\n      state_node, actions_so_far = queue.popleft()\n\n      # 2. Check if primitive is adjacent to the current state's position\n      if state_node.next_to(primitive):\n          # Simulate the USE action from this state.\n          # The step method returns (reward, new_state). We care about new_state.\n          # This simulation does not affect the actual 'env' or 'current_state'.\n          _, post_use_state = state_node.step(_USE)\n          \n          # If, after simulating USE, the primitive is now in the inventory,\n          # then we've found a sequence of actions to collect it.\n          if post_use_state.inventory[primitive] > 0:\n              return actions_so_far + [_USE]\n          # If USE didn't result in collecting the item, this path is not successful\n          # for collecting *this specific primitive*. We don't add this 'USE' path\n          # back to the queue because it wasn't the desired outcome.\n\n      # 3. Explore movement actions (UP, DOWN, LEFT, RIGHT)\n      for action in [_DOWN, _UP, _LEFT, _RIGHT]:\n          # Simulate the movement action from the current state_node.\n          # This gives us a potential next state based on the current state_node's grid, pos, dir.\n          # Note: The reward is always 0.0 for movement in this implementation of CraftState.step.\n          _, next_state_candidate = state_node.step(action)\n\n          # Check if this new (position, direction) configuration has been visited.\n          # We use (pos, dir) as the key for visited states to represent agent's configuration.\n          # The grid content is assumed static for the purpose of finding the item's location.\n          if (next_state_candidate.pos, next_state_candidate.dir) not in visited:\n              visited.add((next_state_candidate.pos, next_state_candidate.dir))\n              # Add the new state and the accumulated actions to the queue for further exploration.\n              queue.append((next_state_candidate, actions_so_far + [action]))\n\n  # If the queue is exhausted (no more reachable states) or max iterations are reached\n  # and the primitive hasn't been collected, it means it's unreachable with this strategy.\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:29:54.430697", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  \n  # Define movement deltas for each action\n  action_deltas = {\n      action_map['DOWN']: (1, 0),\n      action_map['UP']: (-1, 0),\n      action_map['LEFT']: (0, -1),\n      action_map['RIGHT']: (0, 1),\n      action_map['USE']: (0, 0) # USE action does not change position\n  }\n\n  # Helper function to check if a move to (y, x) is valid\n  def is_valid_move(grid, y, x, non_grabbable_indices):\n      height, width, _ = grid.shape\n      # Check bounds\n      if not (0 <= y < height and 0 <= x < width):\n          return False\n      # Check if the target cell contains any non-grabbable entity (obstacle)\n      for obs_idx in non_grabbable_indices:\n          if grid[y, x, obs_idx] > 0:\n              return False # This cell is an obstacle\n      return True\n\n  primitive_idx = env.world.cookbook.index[primitive]\n  non_grabbable_indices = env.world.non_grabbable_indices\n  \n  actions_sequence = []\n  max_collection_steps = 200 # Safety limit to prevent infinite loops\n\n  for _ in range(max_collection_steps):\n      obs_dict = env.observations()\n      current_grid = obs_dict['features_dict']['features_global']\n      current_pos = obs_dict['pos'] # (y, x)\n      current_inventory = obs_dict['features_dict']['inventory']\n\n      # 1. Check if the primitive is already collected\n      if current_inventory[primitive_idx] > 0:\n          return actions_sequence # Success!\n\n      # 2. Check if agent is next to the primitive and can USE\n      # Using the internal _current_state to leverage CraftState's next_to method\n      if env._current_state.next_to(primitive_idx):\n          action_to_take = action_map['USE']\n          actions_sequence.append(action_to_take)\n          env.step(action_to_take) # Apply the action to update the environment state\n          continue # Re-check inventory in the next iteration\n\n      # 3. Find the closest primitive location to move towards\n      primitive_locations = np.argwhere(current_grid[:, :, primitive_idx] > 0)\n      if len(primitive_locations) == 0:\n          # Primitive not found on the grid, cannot collect\n          # This could happen if it's already collected or not present in the scenario\n          return [] \n\n      closest_primitive_loc = None\n      min_dist = float('inf')\n      for loc in primitive_locations:\n          dist = abs(current_pos[0] - loc[0]) + abs(current_pos[1] - loc[1])\n          if dist < min_dist:\n              min_dist = dist\n              closest_primitive_loc = loc\n\n      target_y, target_x = closest_primitive_loc\n      current_y, current_x = current_pos\n\n      # 4. Determine the best movement action, avoiding obstacles\n      action_to_take = None\n      \n      # Calculate differences in coordinates\n      dy = target_y - current_y\n      dx = target_x - current_x\n\n      # Prioritize moving along the dimension with the larger distance\n      # (greedy approach, not a full pathfinding algorithm like A* or BFS)\n      possible_moves = []\n      if dy != 0:\n          possible_moves.append(action_map['DOWN'] if dy > 0 else action_map['UP'])\n      if dx != 0:\n          possible_moves.append(action_map['RIGHT'] if dx > 0 else action_map['LEFT'])\n      \n      # If agent is currently on the same cell as the primitive, it needs to move off\n      # to be \"next to\" it for the USE action.\n      if current_y == target_y and current_x == target_x:\n          # Try moving in any cardinal direction to get off the primitive cell\n          for move_action in [action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT']]:\n              next_y, next_x = current_y + action_deltas[move_action][0], current_x + action_deltas[move_action][1]\n              if is_valid_move(current_grid, next_y, next_x, non_grabbable_indices):\n                  action_to_take = move_action\n                  break\n      \n      # If not on the primitive's cell, try the greedy moves\n      if action_to_take is None:\n          # Prioritize the movement that reduces the largest coordinate difference\n          if abs(dy) >= abs(dx) and dy != 0:\n              potential_action = action_map['DOWN'] if dy > 0 else action_map['UP']\n              next_y, next_x = current_y + action_deltas[potential_action][0], current_x + action_deltas[potential_action][1]\n              if is_valid_move(current_grid, next_y, next_x, non_grabbable_indices):\n                  action_to_take = potential_action\n          \n          if action_to_take is None and dx != 0: # If vertical didn't work or wasn't primary, try horizontal\n              potential_action = action_map['RIGHT'] if dx > 0 else action_map['LEFT']\n              next_y, next_x = current_y + action_deltas[potential_action][0], current_x + action_deltas[potential_action][1]\n              if is_valid_move(current_grid, next_y, next_x, non_grabbable_indices):\n                  action_to_take = potential_action\n          \n          # Fallback: if primary moves are blocked, try the other dimension if possible\n          if action_to_take is None:\n              if abs(dx) > abs(dy) and dx != 0: # If horizontal was dominant initially but failed/not chosen\n                  potential_action = action_map['RIGHT'] if dx > 0 else action_map['LEFT']\n                  next_y, next_x = current_y + action_deltas[potential_action][0], current_x + action_deltas[potential_action][1]\n                  if is_valid_move(current_grid, next_y, next_x, non_grabbable_indices):\n                      action_to_take = potential_action\n              if action_to_take is None and dy != 0: # If vertical was dominant initially but failed/not chosen\n                  potential_action = action_map['DOWN'] if dy > 0 else action_map['UP']\n                  next_y, next_x = current_y + action_deltas[potential_action][0], current_x + action_deltas[potential_action][1]\n                  if is_valid_move(current_grid, next_y, next_x, non_grabbable_indices):\n                      action_to_take = potential_action\n\n      # If still no valid action (e.g., completely surrounded by obstacles, or no path exists)\n      if action_to_take is None:\n          # This indicates the agent is stuck or there's no path to the primitive\n          return []\n\n      actions_sequence.append(action_to_take)\n      env.step(action_to_take) # Apply the action to update the environment state\n\n  # If max_collection_steps reached without collecting the primitive\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:30:59.257790", "function_name": "collect", "function_body": "  import collections\n\n  # Actions\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Directions (matching CraftState's internal representation)\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dy == 1 and dx == 0: return SOUTH_DIR\n    if dy == -1 and dy == 0: return NORTH_DIR\n    return None # Should not happen if agent_pos and item_pos are cardinally adjacent\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information from the environment\n  current_state = env._current_state\n  \n  # If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  # Extract grid and agent's initial position and direction\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Define all indices that represent un-traversable (obstacle) grid cells for movement.\n  # This includes non-grabbable items, workshops, and the primitive itself\n  # (as agent typically cannot walk onto the resource it needs to 'USE').\n  movement_obstacle_indices = set()\n  movement_obstacle_indices.update(env.world.non_grabbable_indices)\n  movement_obstacle_indices.update(env.world.workshop_indices)\n  movement_obstacle_indices.add(primitive_id) # Agent cannot walk onto the primitive itself\n\n\n  # Helper function: Checks if a given grid cell (x, y) is within bounds and does not contain\n  # any defined movement obstacle entities.\n  def _is_traversable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check if the cell contains any obstacle that blocks movement\n    for obs_idx in movement_obstacle_indices:\n      if grid[y, x, obs_idx] > 0: # grid is indexed as (height, width, kinds)\n        return False\n    return True\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid, so it's unreachable.\n\n  # Prepare BFS goal states: (agent_x, agent_y, agent_facing_dir)\n  # These are the specific agent states (position and direction) from which\n  # the 'USE' action can be successfully performed to collect the primitive.\n  bfs_target_agent_states = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells where the agent could stand\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Deltas from item_pos to agent_pos\n      adj_x, adj_y = item_x + dx_adj, item_y + dy_adj\n\n      # Check if this adjacent cell is traversable for the agent\n      if _is_traversable(adj_x, adj_y):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_target_agent_states.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_target_agent_states:\n    return [] # No traversable adjacent positions from which to collect the primitive\n\n  # BFS setup\n  # Queue stores (x, y, dir) tuples representing agent's state\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Parent map to reconstruct the path: {child_state: (parent_state, action_to_child)}\n  parent_map = {} \n  \n  found_goal_state = None # Stores the (x, y, dir) of the goal state once found by BFS\n\n  # Define movement actions and their effects: (dx, dy, resulting_direction)\n  # When agent performs UP_ACTION, it moves UP (dy=-1) and its facing direction becomes NORTH.\n  movement_actions_map = {\n      UP_ACTION: (0, -1, NORTH_DIR),\n      DOWN_ACTION: (0, 1, SOUTH_DIR),\n      LEFT_ACTION: (-1, 0, WEST_DIR),\n      RIGHT_ACTION: (1, 0, EAST_DIR)\n  }\n  \n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state is one of the desired goal states\n    if (curr_x, curr_y, curr_dir) in bfs_target_agent_states:\n      found_goal_state = (curr_x, curr_y, curr_dir)\n      break # Found the shortest path to a goal\n\n    # Explore movement actions: agent moves and its direction automatically aligns with the movement.\n    for action, (dx, dy, resulting_dir) in movement_actions_map.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = resulting_dir # Direction is determined by the movement action\n\n      next_state = (next_x, next_y, next_dir)\n      \n      # Only add to queue if the next cell is traversable and state hasn't been visited\n      if _is_traversable(next_x, next_y) and next_state not in visited:\n        visited.add(next_state)\n        parent_map[next_state] = ((curr_x, curr_y, curr_dir), action)\n        queue.append(next_state)\n    \n    # Explore turning actions: agent changes direction without changing position.\n    # These actions are independent of movement and allow the agent to face a different direction\n    # while staying in the same spot.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]: \n      next_x, next_y = curr_x, curr_y # Position remains unchanged for a pure turn\n      \n      # Calculate new direction based on the turn action\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise (NORTH=0, WEST=3, SOUTH=2, EAST=1)\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n      \n      next_state = (next_x, next_y, next_dir)\n      \n      # No traversability check needed as position doesn't change for a turn.\n      # Only add to queue if this (pos, dir) state hasn't been visited.\n      if next_state not in visited:\n        visited.add(next_state)\n        parent_map[next_state] = ((curr_x, curr_y, curr_dir), turn_action)\n        queue.append(next_state)\n\n  if found_goal_state is None:\n    return [] # No path found to any primitive's collection point\n\n  # Reconstruct the path of actions from the found_goal_state back to the initial_state\n  actions = []\n  curr_state = found_goal_state\n  initial_state = (initial_agent_x, initial_agent_y, initial_agent_dir)\n\n  while curr_state != initial_state:\n    # Get the parent state and the action that led from parent to curr_state\n    parent_state, action = parent_map[curr_state]\n    actions.insert(0, action) # Prepend action to build the path in the correct chronological order\n    curr_state = parent_state\n  \n  # Once the agent reaches the correct position and is facing the primitive,\n  # the final action is to USE the primitive.\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:31:00.277558", "function_name": "collect", "function_body": "  import collections\n\n  # Actions\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Directions (matching CraftState's internal representation)\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dy == 1 and dx == 0: return SOUTH_DIR\n    if dy == -1 and dy == 0: return NORTH_DIR\n    return None # Should not happen if agent_pos and item_pos are cardinally adjacent\n\n  # Helper function: Checks if a given grid cell (x, y) is traversable.\n  # A cell is traversable if it's within bounds and does not contain any obstacle entities.\n  def _is_traversable(grid, x, y, obstacle_kind_indices, grid_width, grid_height):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check if the cell contains any obstacle kind\n    for k_idx in obstacle_kind_indices:\n      if grid[y, x, k_idx] > 0: # grid is indexed as (height, width, kinds)\n        return False\n    return True\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  current_state = env._current_state\n  \n  # If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Define all indices that represent un-traversable (obstacle) grid cells for pathfinding.\n  # This includes non-grabbable items, workshops, and the primitive itself\n  # (as agent needs to be adjacent to collect, not on top of it).\n  obstacle_kind_indices = set()\n  obstacle_kind_indices.update(env.world.non_grabbable_indices)\n  obstacle_kind_indices.update(env.world.workshop_indices)\n  obstacle_kind_indices.add(primitive_id) # Agent cannot walk onto the primitive itself to collect it.\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Prepare BFS goal states: (agent_x, agent_y, agent_facing_dir)\n  # These are the states from which the 'USE' action can be performed to collect the primitive.\n  bfs_target_agent_states = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells for the agent to stand on\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (dx_adj, dy_adj) from item to agent\n      adj_x, adj_y = item_x + dx_adj, item_y + dy_adj\n\n      # Check if the adjacent cell is traversable for the agent to stand on.\n      if _is_traversable(grid, adj_x, adj_y, obstacle_kind_indices, grid_width, grid_height):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_target_agent_states.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_target_agent_states:\n    return [] # No traversable adjacent positions from which to collect the primitive\n\n  # BFS setup\n  # Queue stores (x, y, dir) tuples representing agent's state\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Parent map to reconstruct the path: {child_state: (parent_state, action_to_child)}\n  parent_map = {} \n  \n  found_goal_state = None # Stores the (x, y, dir) of the goal state once found\n\n  # Movement actions and their effects: (dx, dy, resulting_direction)\n  # When agent performs UP_ACTION, it moves UP (dy=-1) and faces NORTH (dir=0)\n  movement_actions_map = {\n      UP_ACTION: (0, -1, NORTH_DIR),\n      DOWN_ACTION: (0, 1, SOUTH_DIR),\n      LEFT_ACTION: (-1, 0, WEST_DIR),\n      RIGHT_ACTION: (1, 0, EAST_DIR)\n  }\n  \n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state is one of the goal states\n    if (curr_x, curr_y, curr_dir) in bfs_target_agent_states:\n      found_goal_state = (curr_x, curr_y, curr_dir)\n      break # Found the shortest path to a goal\n    \n    # Explore movement actions: agent moves and its direction is set by the movement\n    for action, (dx, dy, resulting_dir) in movement_actions_map.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = resulting_dir\n\n      next_state = (next_x, next_y, next_dir)\n      # Use the improved _is_traversable check\n      if _is_traversable(grid, next_x, next_y, obstacle_kind_indices, grid_width, grid_height):\n        if next_state not in visited:\n          visited.add(next_state)\n          parent_map[next_state] = ((curr_x, curr_y, curr_dir), action)\n          queue.append(next_state)\n    \n    # Explore turning actions: agent changes direction without changing position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]: \n      next_x, next_y = curr_x, curr_y # Position does not change for a pure turn\n      \n      # Calculate new direction based on the turn action\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n      \n      next_state = (next_x, next_y, next_dir)\n      if next_state not in visited: # No traversability check needed as position doesn't change for a turn\n        visited.add(next_state)\n        parent_map[next_state] = ((curr_x, curr_y, curr_dir), turn_action)\n        queue.append(next_state)\n\n  if found_goal_state is None:\n    return [] # No path found to any primitive's collection point\n\n  # Reconstruct the path from the goal state back to the initial state\n  actions = []\n  curr_state = found_goal_state\n  initial_state = (initial_agent_x, initial_agent_y, initial_agent_dir)\n\n  while curr_state != initial_state:\n    parent_state, action = parent_map[curr_state]\n    actions.insert(0, action) # Prepend action to build path in correct order\n    curr_state = parent_state\n  \n  # Finally, append the USE action after reaching the correct position and facing direction.\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T21:32:33.550189", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # 1. Get current state observations\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  current_pos = tuple(obs['features_dict']['pos'])  # Convert numpy array to tuple for hashing\n  inventory = obs['features_dict']['inventory']\n\n  # 2. Check if the primitive is already in inventory\n  if inventory[primitive] > 0:\n    return []  # Already collected\n\n  # Define grid dimensions\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get non-grabbable indices from the world for walkability checks\n  # env.world is a CraftWorld instance\n  # env.world.non_grabbable_indices is a set of integer indices\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a cell is within bounds and walkable\n  def is_walkable(px, py, current_grid):\n    \"\"\"Checks if a cell (px, py) is within grid bounds and does not contain any non-grabbable items.\"\"\"\n    if not (0 <= px < WIDTH and 0 <= py < HEIGHT):\n      return False  # Out of bounds\n\n    # A cell is walkable if it does not contain any non-grabbable items\n    for kind_idx in non_grabbable_indices:\n      if current_grid[px, py, kind_idx] > 0:\n        return False  # Contains a non-grabbable item, thus not walkable\n    return True\n\n  # Helper function to check if a cell (px, py) is adjacent to the primitive\n  # (i.e., the primitive is in its 3x3 neighborhood, including the cell itself)\n  def is_adjacent_to_primitive(px, py, current_grid, primitive_id):\n    \"\"\"Checks if the primitive is in the 3x3 neighborhood of (px, py).\"\"\"\n    for dx_adj in [-1, 0, 1]:\n      for dy_adj in [-1, 0, 1]:\n        nx_adj, ny_adj = px + dx_adj, py + dy_adj\n        # Check bounds for the adjacent cell\n        if 0 <= nx_adj < WIDTH and 0 <= ny_adj < HEIGHT:\n          if current_grid[nx_adj, ny_adj, primitive_id] > 0:\n            return True\n    return False\n\n  # Define movement deltas and their corresponding actions.\n  # Assuming env_factory provides these constants (e.g., env_factory.DOWN)\n  # based on the problem description's action_specs.\n  ADJ_DELTAS = [\n      (0, 1),   # Corresponds to DOWN\n      (0, -1),  # Corresponds to UP\n      (1, 0),   # Corresponds to RIGHT\n      (-1, 0)   # Corresponds to LEFT\n  ]\n  # Map (dx, dy) deltas to their integer action values.\n  # The problem states: DOWN\u21920, UP\u21921, LEFT\u21922, RIGHT\u21923, USE\u21924\n  ACTION_MAP = {\n      (0, 1): env_factory.DOWN,\n      (0, -1): env_factory.UP,\n      (1, 0): env_factory.RIGHT,\n      (-1, 0): env_factory.LEFT\n  }\n\n  # 3. Pathfinding using Breadth-First Search (BFS)\n  # Queue stores tuples of (position, path_actions_to_reach_position)\n  q = collections.deque([(current_pos, [])])\n  # Set of visited positions to avoid cycles and redundant exploration\n  visited = {current_pos}\n\n  final_path_actions = []\n  target_found = False\n\n  while q:\n    curr_p, path = q.popleft()\n\n    # Check if the current position is adjacent to the primitive\n    # If it is, we can perform the USE action from here.\n    if is_adjacent_to_primitive(curr_p[0], curr_p[1], grid, primitive):\n      final_path_actions = path + [env_factory.USE]\n      target_found = True\n      break  # Found the path and the action, stop BFS\n\n    # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n    for dx, dy in ADJ_DELTAS:\n      next_p = (curr_p[0] + dx, curr_p[1] + dy)\n\n      # Check if the next position is valid, not visited, and walkable\n      if next_p not in visited and is_walkable(next_p[0], next_p[1], grid):\n        visited.add(next_p)\n        action_to_take = ACTION_MAP[(dx, dy)]\n        q.append((next_p, path + [action_to_take]))\n\n  return final_path_actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:32:34.549030", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:34:01.691783", "function_name": "collect", "function_body": "  import collections\n\n  # Get the current state from the environment.\n  # env is an instance of CraftLab, which holds the current CraftState.\n  state = env._current_state\n  grid = state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n  start_pos = state.pos\n\n  # Define action constants used by CraftLab.\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement actions to their corresponding (dx, dy) deltas on the grid.\n  MOVEMENT_DELTAS = {\n      ACTION_DOWN: (0, 1),\n      ACTION_UP: (0, -1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0),\n  }\n\n  # 1. Check if the primitive is already in the inventory.\n  # If so, no actions are needed.\n  if state.inventory[primitive] > 0:\n      return []\n\n  # 2. Perform a Breadth-First Search (BFS) to find the closest primitive on the grid.\n  # The queue stores tuples of (current_position, list_of_actions_to_reach_here).\n  queue = collections.deque([(start_pos, [])])\n  # A set to keep track of visited positions to avoid redundant paths and cycles.\n  visited = {start_pos}\n\n  path_to_primitive_cell = []\n  found_primitive_cell = None\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current cell contains the desired primitive.\n      if grid[cx, cy, primitive] > 0:\n          found_primitive_cell = current_pos\n          path_to_primitive_cell = path\n          break  # Found the closest primitive, stop BFS.\n\n      # Explore neighboring cells using only movement actions.\n      for action, delta in MOVEMENT_DELTAS.items():\n          dx, dy = delta\n          new_x, new_y = cx + dx, cy + dy\n\n          # Check if the new position is within grid boundaries.\n          if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n              new_pos = (new_x, new_y)\n              # Check if the new position has not been visited yet.\n              if new_pos not in visited:\n                  visited.add(new_pos)\n                  queue.append((new_pos, path + [action]))\n\n  # If the primitive was not found on the grid or is unreachable, return an empty list.\n  if found_primitive_cell is None:\n      return []\n\n  # 3. Check if the found primitive can be \"grabbed\" (collected) using the USE action.\n  # The `CraftWorld` instance (env.world) holds `grabbable_indices`.\n  is_grabbable = primitive in env.world.grabbable_indices\n\n  if is_grabbable:\n      # If the primitive is grabbable, append the USE action after the path to its cell.\n      # It's assumed that the USE action works when standing on the item's cell.\n      actions = path_to_primitive_cell + [ACTION_USE]\n      return actions\n  else:\n      # If the primitive is not directly grabbable (e.g., a workshop, water, or stone that\n      # requires a tool/crafting), this function cannot collect it via direct USE.\n      # Return an empty list as it's not collectible by this method.\n      return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:34:02.664245", "function_name": "collect", "function_body": "  # Imports needed within the function scope based on the strict instruction.\n  import collections\n  import numpy as np\n\n  # Action constants as defined by the problem description in `CraftLab.action_specs`\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Define movement deltas (dx, dy) for each absolute cardinal action.\n  # This maps the action constant to the change in (x, y) coordinates on the grid.\n  # Assuming typical grid where (0,0) is top-left, x increases right, y increases down.\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),    # Move North (decrease y)\n      ACTION_DOWN: (0, 1),   # Move South (increase y)\n      ACTION_LEFT: (-1, 0),  # Move West (decrease x)\n      ACTION_RIGHT: (1, 0),  # Move East (increase x)\n  }\n\n  # Define how the agent's facing direction (`dir`) changes after a movement action.\n  # This maps a movement delta (dx, dy) to the resulting direction value (0=N, 1=E, 2=S, 3=W).\n  # This is a crucial assumption for the `USE` action to be directional.\n  DIR_FROM_MOVE_DELTA = {\n      (0, -1): 0,   # Moving UP leads to facing North\n      (1, 0): 1,    # Moving RIGHT leads to facing East\n      (0, 1): 2,    # Moving DOWN leads to facing South\n      (-1, 0): 3,   # Moving LEFT leads to facing West\n  }\n\n  # Define the (dx, dy) offset from the agent's position that `USE` acts upon,\n  # based on the agent's current facing direction.\n  DIR_TO_TARGET_DELTA = {\n      0: (0, -1),   # Facing North: target is (x, y-1)\n      1: (1, 0),    # Facing East: target is (x+1, y)\n      2: (0, 1),    # Facing South: target is (x, y+1)\n      3: (-1, 0),   # Facing West: target is (x-1, y)\n  }\n\n  current_craft_state = env._current_state\n\n  # If the primitive is already in inventory, no actions needed.\n  if current_craft_state.satisfies(None, primitive):\n      return []\n\n  grid = current_craft_state.grid\n  initial_pos = current_craft_state.pos\n  initial_dir = current_craft_state.dir # Agent's current facing direction\n  width, height, _ = grid.shape # Extract grid dimensions (number of kinds is not directly used here)\n\n  # A primitive must be grabbable to be collected using a simple 'USE' action.\n  if primitive not in env.world.grabbable_indices:\n      # If it's not a grabbable item, this function cannot collect it.\n      # It might require a recipe or other complex interaction not covered by 'collect'.\n      return []\n\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # BFS setup: Each state in the queue is (current_position, current_direction, list_of_actions_to_reach_here)\n  queue = collections.deque([(initial_pos, initial_dir, [])]) \n  # Visited set stores (position, direction) tuples to avoid redundant exploration and cycles.\n  # We need to track direction as part of the visited state because the outcome of 'USE' depends on it.\n  visited = {(initial_pos, initial_dir)} \n\n  while queue:\n      current_pos, current_dir, path = queue.popleft()\n      cx, cy = current_pos\n\n      # --- Check if the primitive can be collected from the current state (position and direction) ---\n      # Calculate the coordinates of the cell directly in front of the agent based on its current direction\n      target_dx, target_dy = DIR_TO_TARGET_DELTA[current_dir]\n      target_x, target_y = cx + target_dx, cy + target_dy\n\n      # Check if the potential target cell is within grid bounds\n      if 0 <= target_x < width and 0 <= target_y < height:\n          # Check if the target cell contains the desired primitive\n          if grid[target_x, target_y, primitive] > 0:\n              # If the primitive is in the cell the agent is facing, use ACTION_USE to collect it\n              return path + [ACTION_USE]\n\n      # --- Explore possible moves if primitive not yet collected ---\n      # Iterate over all possible movement actions (UP, DOWN, LEFT, RIGHT)\n      for action, (dx, dy) in MOVE_DELTAS.items():\n          next_pos = (cx + dx, cy + dy)\n          nx, ny = next_pos\n\n          # Check if the next position is within grid bounds\n          if not (0 <= nx < width and 0 <= ny < height):\n              continue\n\n          # Check traversability: Ensure the next cell does not contain non-grabbable entities (obstacles)\n          is_obstacle = False\n          for obstacle_kind_idx in non_grabbable_indices:\n              if grid[nx, ny, obstacle_kind_idx] > 0:\n                  is_obstacle = True\n                  break\n          \n          if is_obstacle:\n              continue # Cannot move into an obstacle cell\n\n          # Determine the agent's new direction after moving to next_pos.\n          # We assume the agent will face the direction corresponding to its last movement.\n          next_dir = DIR_FROM_MOVE_DELTA[(dx, dy)] \n\n          # If this (position, direction) state has not been visited before, add it to the queue\n          if (next_pos, next_dir) not in visited:\n              visited.add((next_pos, next_dir))\n              queue.append((next_pos, next_dir, path + [action]))\n  \n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:35:40.596821", "function_name": "collect", "function_body": "    from collections import deque\n\n    # Constants for actions\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Map movement actions to (dx, dy) deltas and their resulting agent direction\n    # Directions (0=N, 1=E, 2=S, 3=W) are standard DMLab convention.\n    # UP (Y-1) maps to North (0)\n    # RIGHT (X+1) maps to East (1)\n    # DOWN (Y+1) maps to South (2)\n    # LEFT (X-1) maps to West (3)\n    ACTION_TO_DELTA_AND_DIR = {\n        DOWN: ((0, 1), 2),   # (dx, dy), resulting_dir\n        UP: ((0, -1), 0),    # (dx, dy), resulting_dir\n        LEFT: ((-1, 0), 3),  # (dx, dy), resulting_dir\n        RIGHT: ((1, 0), 1)   # (dx, dy), resulting_dir\n    }\n\n    # Map DMLab directions (0:N, 1:E, 2:S, 3:W) to (dx, dy) deltas\n    # This is used to calculate the cell \"in front\" of the agent.\n    DIR_TO_DELTA = {\n        0: (0, -1),  # North (UP)\n        1: (1, 0),   # East (RIGHT)\n        2: (0, 1),   # South (DOWN)\n        3: (-1, 0)   # West (LEFT)\n    }\n\n    def _bfs_find_path_to_use_primitive(state, target_kind_idx):\n        \"\"\"\n        Internal helper function: Finds a sequence of actions (movement + USE)\n        to get the agent into a position and facing a primitive, then USE it.\n        Returns a list of actions (integers) or None if no such path is found.\n        \"\"\"\n        grid = state.grid\n        current_pos = state.pos\n        current_dir = state.dir  # Agent's current facing direction\n        width, height, _ = grid.shape\n\n        # BFS queue stores: ((x, y), agent_direction, list_of_actions_to_reach_here)\n        q = deque([(current_pos, current_dir, [])])\n        # Visited set stores (x, y, agent_direction) to prevent cycles\n        visited = {(current_pos[0], current_pos[1], current_dir)}\n\n        non_grabbable_indices = state.world.non_grabbable_indices\n\n        def is_valid_and_traversable(x, y):\n            \"\"\"Checks if a cell (x, y) is within bounds and not an obstacle.\"\"\"\n            if not (0 <= x < width and 0 <= y < height):\n                return False  # Out of bounds\n\n            # Check for non-grabbable obstacles (cannot walk through them)\n            for k_idx in non_grabbable_indices:\n                if grid[x, y, k_idx] == 1:\n                    return False\n            # Also, don't walk onto the primitive itself, only next to it\n            if grid[x, y, target_kind_idx] == 1:\n                return False\n            return True\n\n        while q:\n            (cx, cy), cdir, path_actions = q.popleft()\n\n            # Check if the current state (position and direction) allows using the primitive\n            # Calculate the cell directly in front of the agent\n            fx, fy = cx + DIR_TO_DELTA[cdir][0], cy + DIR_TO_DELTA[cdir][1]\n\n            # If the cell in front contains the target primitive and is within bounds\n            if (0 <= fx < width and 0 <= fy < height and\n                    grid[fx, fy, target_kind_idx] == 1):\n                # Found a path that leads to a position from which the primitive can be USED\n                return path_actions + [USE]\n\n            # Explore possible next states by performing movement actions\n            for action_move, ((dx, dy), new_dir) in ACTION_TO_DELTA_AND_DIR.items():\n                nx, ny = cx + dx, cy + dy  # New position\n                next_pos = (nx, ny)\n\n                if is_valid_and_traversable(nx, ny) and (nx, ny, new_dir) not in visited:\n                    visited.add((nx, ny, new_dir))\n                    q.append((next_pos, new_dir, path_actions + [action_move]))\n\n        return None  # No path found to collect the primitive\n\n    all_actions = []\n    # A safety limit to prevent infinite loops if the primitive is unreachable\n    # or the environment state somehow becomes inconsistent.\n    max_total_actions = 500\n\n    for _ in range(max_total_actions):\n        current_state = env._current_state  # Access the current CraftState directly\n\n        # 1. Check if the primitive is already collected\n        if current_state.inventory[primitive] > 0:\n            return all_actions  # Goal achieved, return the sequence of actions\n\n        # 2. Find a sequence of actions (movement + USE) to collect the primitive\n        path_to_collect = _bfs_find_path_to_use_primitive(current_state, primitive)\n\n        if path_to_collect is None:\n            # If no path is found, the primitive might be unreachable, or not present.\n            # In this case, we cannot collect it with the current logic.\n            return all_actions  # Return actions taken so far (likely empty or partial)\n\n        # 3. Execute the found sequence of actions in the environment\n        for action in path_to_collect:\n            all_actions.append(action)\n            _, _, _ = env.step(action)  # Perform the action, updating the environment state\n\n            # After each step, immediately re-check if the goal is met.\n            # This is crucial if the `USE` action was just performed.\n            if env._current_state.inventory[primitive] > 0:\n                return all_actions  # Goal achieved during path execution\n\n    # If the loop finishes without collecting the primitive (e.g., max_total_actions reached)\n    return all_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:35:41.561879", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Action deltas for grid movement (row_delta, col_delta)\n  ACTION_DELTAS = {\n      DOWN: (1, 0),   # Move down (increase row index)\n      UP: (-1, 0),    # Move up (decrease row index)\n      LEFT: (0, -1),  # Move left (decrease col index)\n      RIGHT: (0, 1),  # Move right (increase col index)\n  }\n\n  # Get current environment observations\n  obs = env.observations()\n  current_pos = obs['features_dict']['pos']\n  inventory = obs['features_dict']['inventory']\n  grid = obs['features_dict']['features_global']\n  height, width, _ = grid.shape # We only need height and width\n\n  # Check if the primitive is already in the inventory\n  if inventory[primitive] > 0:\n    return [] # Already collected, no actions needed\n\n  # Find all grid locations where the primitive exists\n  target_cells = []\n  for r in range(height):\n    for c in range(width):\n      if grid[r, c, primitive] > 0:\n        target_cells.append((r, c))\n\n  if not target_cells:\n    return [] # Primitive not found on the map\n\n  # Identify obstacle indices. Obstacles are typically non-grabbable items\n  # that the agent cannot walk through. Workshops might be non-grabbable\n  # but allow agent movement or interaction when adjacent.\n  world = env.world # Access the CraftWorld instance from CraftLab\n  obstacle_indices = set()\n  for idx in world.non_grabbable_indices:\n    # Assume workshops are not obstacles for movement, but you interact with them.\n    # Other non-grabbable items (like walls, certain types of stone/water) are obstacles.\n    if idx not in world.workshop_indices:\n      obstacle_indices.add(idx)\n\n  # Initialize BFS queue and visited set\n  # Queue stores (row, col, list_of_actions_taken_to_reach_here)\n  q = collections.deque()\n  q.append((current_pos[0], current_pos[1], []))\n  \n  # Visited set stores (row, col) to prevent cycles and redundant exploration\n  visited = set()\n  visited.add((current_pos[0], current_pos[1]))\n\n  while q:\n    r, c, path_actions = q.popleft()\n\n    # Check if the current position is adjacent to any of the target primitive cells.\n    # If it is, we are in a position to 'USE' the primitive.\n    for tr, tc in target_cells:\n      if abs(r - tr) + abs(c - tc) == 1: # Manhattan distance of 1 means adjacent\n        return path_actions + [USE] # Return path to adjacency + USE action\n\n    # Explore neighboring cells\n    for action_val, (dr, dc) in ACTION_DELTAS.items():\n      nr, nc = r + dr, c + dc # New row and column\n\n      # Check grid boundaries\n      if not (0 <= nr < height and 0 <= nc < width):\n        continue\n\n      # Check if the new cell is an obstacle\n      is_obstacle = False\n      for obs_idx in obstacle_indices:\n        if grid[nr, nc, obs_idx] > 0: # If an obstacle kind is present at (nr, nc)\n          is_obstacle = True\n          break\n      \n      if is_obstacle:\n        continue # Cannot move into an obstacle cell\n\n      # Check if the new cell has already been visited\n      if (nr, nc) in visited:\n        continue\n\n      # Add new cell to visited set and queue\n      visited.add((nr, nc))\n      q.append((nr, nc, path_actions + [action_val]))\n\n  # If the BFS completes and no path to an adjacent primitive cell is found\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:36:59.014270", "function_name": "collect", "function_body": "    import collections\n\n    actions = []\n    \n    current_state = env._current_state\n    grid = current_state.grid\n    start_pos = current_state.pos\n    world = current_state.world # CraftWorld instance\n\n    # Grid dimensions\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # Identify obstacle kinds from the environment set (non-grabbable, usually unwalkable)\n    # Assuming anything in world.environment is an obstacle that cannot be walked through.\n    # The 'primitive' itself is assumed to not be in world.environment.\n    obstacle_kinds = world.environment \n\n    # Helper function to check if a position is valid and walkable\n    def is_valid_walkable(x, y):\n        # Check bounds\n        if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n            return False\n        \n        # Check if cell contains any obstacle kind\n        for k_idx in obstacle_kinds:\n            if grid[x, y, k_idx] == 1:\n                return False # Contains an obstacle\n        return True\n\n    # BFS Initialization\n    # Queue stores tuples of (current_position, path_of_positions_taken_to_reach_here)\n    q = collections.deque([(start_pos, [])]) \n    visited = {start_pos} # Keep track of visited positions to avoid cycles and redundant work\n    \n    target_path = None # Stores the sequence of positions leading to the primitive\n\n    # Define movement deltas for actions: DOWN, UP, LEFT, RIGHT\n    # These correspond to the action constants defined in env_factory\n    # Assuming (x, y) where x is horizontal (width) and y is vertical (height)\n    move_deltas = {\n        env_factory.DOWN: (0, 1),  # (dx, dy)\n        env_factory.UP: (0, -1),\n        env_factory.LEFT: (-1, 0),\n        env_factory.RIGHT: (1, 0),\n    }\n\n    # BFS to find the shortest path to any cell containing the primitive\n    while q:\n        (cx, cy), current_path_positions = q.popleft()\n\n        # Check if the current position contains the primitive\n        if grid[cx, cy, primitive] == 1:\n            # If the primitive is at the current position, this is our goal.\n            # Append the current position to the path to make it complete.\n            target_path = current_path_positions + [(cx, cy)]\n            break # Path found, exit BFS\n\n        # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n        for action_val, (dx, dy) in move_deltas.items():\n            nx, ny = cx + dx, cy + dy # Calculate neighbor position\n            n_pos = (nx, ny)\n\n            # Check if neighbor is valid (within bounds and walkable) and not yet visited\n            if is_valid_walkable(nx, ny) and n_pos not in visited:\n                visited.add(n_pos)\n                # Add neighbor to queue with its path (current path + current position)\n                # The path stored with n_pos is the sequence of cells *up to* current_pos.\n                # So, current_path_positions refers to the path *before* (cx, cy).\n                # We want the path *from start_pos up to and including (cx, cy)*.\n                # Thus, for the next step, the path should be current_path_positions + [(cx, cy)]\n                q.append((n_pos, current_path_positions + [(cx, cy)]))\n\n    if target_path:\n        # If a path was found, convert the sequence of positions into a sequence of actions\n        for i in range(len(target_path) - 1):\n            px, py = target_path[i]     # Previous position in the path\n            nx, ny = target_path[i+1]   # Next position in the path\n\n            # Determine the action needed to move from (px, py) to (nx, ny)\n            if nx > px: \n                actions.append(env_factory.RIGHT)\n            elif nx < px: \n                actions.append(env_factory.LEFT)\n            elif ny > py: \n                actions.append(env_factory.DOWN)\n            elif ny < py: \n                actions.append(env_factory.UP)\n            # No 'else' needed as valid path steps imply movement in one cardinal direction\n\n        # After all movement actions, append the USE action\n        # The agent should now be at the target_path's last position, which contains the primitive.\n        # The `CraftState.next_to` method confirms that being on the same cell as an item\n        # counts as being \"next to\" it (as it's in the 3x3 neighborhood).\n        actions.append(env_factory.USE)\n    \n    return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:37:00.088628", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n  from env_factory import Action # Assuming Action enum is available here\n\n  \"\"\"Improved version of `collect_v1`.\n  \n  This function uses a Breadth-First Search (BFS) algorithm to find the shortest\n  sequence of actions required to collect the specified primitive. It considers\n  the agent's position, direction, and inventory as part of the state\n  representation to ensure correctness and avoid redundant exploration.\n  \n  Args:\n      env: An instance of CraftLab, from which the current CraftState is extracted.\n      primitive: The integer index of the primitive item to collect.\n      \n  Returns:\n      A list of integer actions (from Action enum) representing the shortest path\n      to collect the primitive. Returns an empty list if the primitive is already\n      collected or no path is found within a practical exploration limit.\n  \"\"\"\n\n  initial_craft_state = env._current_state\n  \n  # Check if the primitive is already collected in the initial state\n  if initial_craft_state.inventory[primitive] > 0:\n      return []\n\n  # Queue for BFS: stores (current_CraftState, list_of_actions_taken_to_reach_this_state)\n  queue = deque([(initial_craft_state, [])])\n  \n  # Visited set: stores hashable representation of states to avoid re-exploring.\n  # A state is defined by (agent_position, agent_direction, tuple_of_inventory_counts).\n  # Converting the numpy array inventory to a tuple makes it hashable for set storage.\n  visited = set([(initial_craft_state.pos, initial_craft_state.dir, tuple(initial_craft_state.inventory))])\n\n  # Define possible actions for movement\n  move_actions = [Action.DOWN, Action.UP, Action.LEFT, Action.RIGHT]\n  \n  # A practical limit to prevent excessively long searches, especially in very large\n  # or complex environments, or if the goal is unachievable. BFS itself guarantees\n  # finding the shortest path if one exists and terminates for finite state spaces.\n  max_exploration_steps = 2000\n  steps_count = 0\n\n  while queue:\n      current_state, actions_path = queue.popleft()\n      \n      # Increment exploration step counter and check limit\n      steps_count += 1\n      if steps_count > max_exploration_steps:\n          return [] # No path found within the practical limit\n\n      # If the primitive is collected in the current state, we've found a path\n      if current_state.inventory[primitive] > 0:\n          return actions_path\n\n      # --- Attempt the USE action if next to the primitive ---\n      # The USE action is typically how primitives are collected.\n      # We prioritize trying USE when adjacent to the target primitive.\n      if current_state.next_to(primitive):\n          # Simulate taking the USE action\n          _, state_after_use = current_state.step(Action.USE)\n          \n          # Check if the USE action successfully collected the primitive\n          if state_after_use.inventory[primitive] > current_state.inventory[primitive]:\n              return actions_path + [Action.USE]\n          \n          # If USE didn't directly collect the primitive but changed the state\n          # (e.g., used a workbench, turned but didn't pick up, etc.),\n          # add this new state to the queue for further exploration if not visited.\n          state_after_use_key = (state_after_use.pos, state_after_use.dir, tuple(state_after_use.inventory))\n          if state_after_use_key not in visited:\n              visited.add(state_after_use_key)\n              queue.append((state_after_use, actions_path + [Action.USE]))\n\n      # --- Explore movement actions ---\n      for action in move_actions:\n          # Simulate taking the movement action\n          _, next_state = current_state.step(action)\n          \n          # Create hashable key for the next state\n          next_state_key = (next_state.pos, next_state.dir, tuple(next_state.inventory))\n\n          # If this state has not been visited before, add it to the queue\n          if next_state_key not in visited:\n              visited.add(next_state_key)\n              queue.append((next_state, actions_path + [action]))\n            \n  return [] # If the queue becomes empty and the primitive hasn't been collected, no path was found", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:38:40.548427", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Actions and their corresponding (dr, dc) deltas\n    # Assuming env_factory defines the action constants like UP, DOWN, LEFT, RIGHT, USE\n    MOVE_DELTAS = {\n        env_factory.UP: (-1, 0),\n        env_factory.DOWN: (1, 0),\n        env_factory.LEFT: (0, -1),\n        env_factory.RIGHT: (0, 1)\n    }\n\n    state = env._current_state\n    grid = state.grid\n    R, C, K = grid.shape # R=HEIGHT, C=WIDTH, K=n_kinds (standard numpy indexing)\n    start_pos = state.pos # (row, col)\n    primitive_kind_idx = primitive\n\n    # 1. Check if the primitive is already in inventory\n    if state.inventory[primitive_kind_idx] > 0:\n        return []\n\n    # 2. BFS setup\n    q = collections.deque([(start_pos[0], start_pos[1], [])]) # (row, col, path_actions_to_reach_this_cell)\n    visited = {(start_pos[0], start_pos[1])}\n    \n    # Store the path to the closest \"useable\" spot\n    path_to_use_spot = None\n\n    # Get impassable indices from the world\n    world = state.world\n    impassable_indices = set()\n    if world.water_index is not None:\n        impassable_indices.add(world.water_index)\n    # Workshop locations are typically impassable for movement\n    impassable_indices.update(world.workshop_indices) \n    \n    while q:\n        r, c, current_path = q.popleft()\n\n        # Check if the current position (r, c) is a valid spot to \"USE\" and collect the primitive.\n        # This means the primitive must be in the 3x3 neighborhood (including (r,c) itself).\n        is_use_spot = False\n        for dr_check in [-1, 0, 1]:\n            for dc_check in [-1, 0, 1]:\n                check_r, check_c = r + dr_check, c + dc_check\n                # Ensure check_r, check_c are within grid boundaries\n                if 0 <= check_r < R and 0 <= check_c < C:\n                    # Check if the primitive is present at this neighboring cell\n                    if grid[check_r, check_c, primitive_kind_idx] == 1:\n                        is_use_spot = True\n                        break\n            if is_use_spot:\n                break\n        \n        if is_use_spot:\n            # Found a path to a spot where 'USE' action can collect the primitive\n            path_to_use_spot = current_path + [env_factory.USE]\n            break # Exit BFS, shortest path found\n\n        # Explore neighbors\n        for move_action, (dr, dc) in MOVE_DELTAS.items():\n            nr, nc = r + dr, c + dc\n\n            # Check boundaries\n            if not (0 <= nr < R and 0 <= nc < C):\n                continue\n\n            # Check if already visited\n            if (nr, nc) in visited:\n                continue\n\n            # Check if the next cell is impassable\n            # A cell is impassable if any of its components correspond to an impassable kind.\n            cell_is_impassable = False\n            for k_idx in impassable_indices:\n                if grid[nr, nc, k_idx] == 1: # If the impassable kind is present at (nr, nc)\n                    cell_is_impassable = True\n                    break\n            \n            if cell_is_impassable:\n                continue # Cannot move to this cell\n\n            # If reachable and not visited, add to queue\n            visited.add((nr, nc))\n            q.append((nr, nc, current_path + [move_action]))\n\n    return path_to_use_spot if path_to_use_spot else []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:38:41.595674", "function_name": "collect", "function_body": "  import collections # For deque\n\n  # Directions and their corresponding CraftLab actions\n  # (row_change, col_change) -> action value (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT)\n  ACTION_TO_DELTADRC = {\n      0: (1, 0),  # DOWN (row + 1, col)\n      1: (-1, 0), # UP (row - 1, col)\n      2: (0, -1), # LEFT (row, col - 1)\n      3: (0, 1)   # RIGHT (row, col + 1)\n  }\n  DELTADRC_TO_ACTION = {v: k for k, v in ACTION_TO_DELTADRC.items()}\n\n  # Agent's direction mapping (typical DMLab convention for 0=N, 1=E, 2=S, 3=W)\n  # dir_int: (dr, dc) for the direction the agent is facing\n  DIR_TO_DELTADRC = {\n      0: (-1, 0),  # North (UP)\n      1: (0, 1),   # East (RIGHT)\n      2: (1, 0),   # South (DOWN)\n      3: (0, -1)   # West (LEFT)\n  }\n  # Helper to get the integer direction from a delta (used for required facing direction)\n  DELTADRC_TO_DIR = {v: k for k, v in DIR_TO_DELTADRC.items()}\n\n  def calculate_turns(current_dir, target_dir):\n      \"\"\"Calculates actions to turn from current_dir to target_dir.\n      \n      Args:\n          current_dir (int): Agent's current direction (0=N, 1=E, 2=S, 3=W).\n          target_dir (int): Desired direction (0=N, 1=E, 2=S, 3=W).\n          \n      Returns:\n          list[int]: List of turn actions (2=LEFT, 3=RIGHT).\n      \"\"\"\n      turns = []\n      # DMLab directions: 0=N, 1=E, 2=S, 3=W (clockwise)\n      # Actions: LEFT=2, RIGHT=3\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # Turn 90 degrees clockwise (e.g., N to E)\n          turns.append(3) # RIGHT\n      elif diff == 2: # Turn 180 degrees (e.g., N to S)\n          turns.append(3) # RIGHT\n          turns.append(3) # RIGHT\n      elif diff == 3: # Turn 90 degrees counter-clockwise (e.g., N to W)\n          turns.append(2) # LEFT\n      return turns\n\n  current_state = env._current_state\n  world = current_state.world\n  \n  # 1. Check if primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  # 2. Locate the primitive on the grid\n  target_pos = None\n  grid_rows, grid_cols, _ = current_state.grid.shape\n  \n  for r in range(grid_rows):\n    for c in range(grid_cols):\n      if current_state.grid[r, c, primitive] > 0:\n        target_pos = (r, c)\n        break\n    if target_pos:\n      break\n  \n  if not target_pos:\n    # Primitive not found on the grid, cannot collect directly\n    return []\n\n  # 3. Pathfinding to a cell adjacent to the primitive\n  # Using BFS to find the shortest path in terms of grid steps.\n  # Queue stores (current_position, path_of_positions_taken)\n  q = collections.deque([(current_state.pos, [current_state.pos])])\n  visited = {current_state.pos}\n  final_pos_path = None\n\n  while q:\n    (r, c), path_of_positions = q.popleft()\n\n    # Check if the current position is adjacent to the target primitive\n    # Manhattan distance == 1 means adjacent\n    if abs(r - target_pos[0]) + abs(c - target_pos[1]) == 1:\n      final_pos_path = path_of_positions\n      break\n\n    for action, (dr, dc) in ACTION_TO_DELTADRC.items():\n      if action == 4: continue # Skip USE action for movement logic\n      \n      new_r, new_c = r + dr, c + dc\n      new_pos = (new_r, new_c)\n\n      # Boundary check\n      if not (0 <= new_r < grid_rows and 0 <= new_c < grid_cols):\n        continue\n\n      # Do not move into the cell occupied by the primitive itself (assume interaction from adjacent)\n      if new_pos == target_pos:\n        continue\n\n      # Check if the cell is blocked by non-walkable terrain (e.g., stone, or water if target is not water)\n      is_blocked = False\n      if current_state.grid[new_r, new_c, world.stone_index] > 0:\n        is_blocked = True\n      \n      # If the primitive itself is not water, and the new cell IS water, consider it blocked for general movement.\n      if primitive != world.water_index and current_state.grid[new_r, new_c, world.water_index] > 0:\n        is_blocked = True\n      \n      # Additional checks for other non-grabbable items that might block movement could be added here.\n      # For v2, we primarily consider stone and water as immediate blockers.\n\n      if new_pos not in visited and not is_blocked:\n        visited.add(new_pos)\n        q.append((new_pos, path_of_positions + [new_pos]))\n\n  if not final_pos_path:\n    return [] # No path found to an adjacent cell\n\n  # 4. Convert position path to action path (moves + turns)\n  actions_to_take = []\n  current_r, current_c = current_state.pos\n  current_dir = current_state.dir # Agent's initial direction (0=N, 1=E, 2=S, 3=W)\n\n  for next_r, next_c in final_pos_path[1:]: # Skip initial position as it's current\n    dr = next_r - current_r\n    dc = next_c - current_c\n    \n    move_action_val = DELTADRC_TO_ACTION.get((dr, dc))\n    # This should always be found for valid cardinal moves.\n    \n    # Determine the required direction for the movement\n    required_move_dir = DELTADRC_TO_DIR.get((dr, dc))\n    # This should always be found for valid cardinal moves.\n\n    # Add turns to face the correct direction before moving\n    actions_to_take.extend(calculate_turns(current_dir, required_move_dir))\n    current_dir = required_move_dir # Agent's direction updates after turning\n    \n    # Add the movement action\n    actions_to_take.append(move_action_val)\n    \n    current_r, current_c = next_r, next_c # Update current position\n\n  # 5. After reaching the adjacent cell, face the primitive and USE\n  # current_r, current_c is now the final position before USE.\n  # target_pos is (target_r, target_c).\n  \n  face_dr = target_pos[0] - current_r\n  face_dc = target_pos[1] - current_c\n\n  required_use_dir = DELTADRC_TO_DIR.get((face_dr, face_dc))\n  \n  if required_use_dir is not None: # Should always be found if target_pos is truly adjacent\n      actions_to_take.extend(calculate_turns(current_dir, required_use_dir))\n  \n  actions_to_take.append(4) # Add the USE action (CraftLab.USE is 4)\n\n  return actions_to_take", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T21:40:07.773722", "function_name": "collect", "function_body": "  # Retrieve current state observations from the environment\n  obs = env.observations()\n  current_grid = obs['features_dict']['features_global']\n  current_pos = tuple(obs['features_dict']['pos'])  # (x, y)\n  # The direction is a one-hot array; np.argmax gives the integer index (0-3)\n  current_dir_int = np.argmax(obs['features_dict']['direction'])\n  inventory = obs['features_dict']['inventory']\n\n  actions = []\n\n  # 1. Check if the primitive is already collected\n  if inventory[primitive] > 0:\n    return actions\n\n  # 2. Find all locations of the primitive on the grid\n  WIDTH, HEIGHT, N_KINDS = current_grid.shape\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      if current_grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  if not primitive_locations:\n    # Primitive not found on the map\n    return actions\n\n  # Helper function for Manhattan distance\n  def manhattan_dist(p1, p2):\n    return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  # 3. Select the closest primitive location from the agent's current position\n  target_primitive_pos = min(primitive_locations, key=lambda p: manhattan_dist(p, current_pos))\n  tx, ty = target_primitive_pos\n\n  # 4. Find the optimal adjacent cell for the agent to move to\n  # This cell must be within bounds and be one of the 4 neighbors of target_primitive_pos\n  adj_candidates = []\n  # (dx, dy) tuples for neighbors: (right, left, up, down)\n  neighbors_offsets = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n\n  for ox, oy in neighbors_offsets:\n    adj_x, adj_y = tx + ox, ty + oy\n    # Check if the candidate adjacent cell is within grid boundaries\n    if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n      adj_candidates.append((adj_x, adj_y))\n\n  if not adj_candidates:\n    # No valid adjacent cell (e.g., target is in a corner with no space to approach)\n    return actions\n\n  # Select the closest valid adjacent cell to the agent's current position\n  target_adj_pos = min(adj_candidates, key=lambda p: manhattan_dist(p, current_pos))\n\n  # 5. Simulate agent movement (dry run) to target_adj_pos\n  px_sim, py_sim = current_pos\n  dir_sim = current_dir_int  # Agent's current facing direction (int 0-3)\n\n  MAX_PLAN_STEPS = 100  # Safety limit to prevent extremely long paths or infinite loops\n\n  # Map actions to their (dx, dy) effects and resulting direction for simulation\n  # These constants are assumed to be defined in env_factory\n  action_sim_effects = {\n      env_factory.DOWN: (0, -1, env_factory.DOWN),\n      env_factory.UP: (0, 1, env_factory.UP),\n      env_factory.LEFT: (-1, 0, env_factory.LEFT),\n      env_factory.RIGHT: (1, 0, env_factory.RIGHT)\n  }\n\n  steps_count = 0\n  while (px_sim, py_sim) != target_adj_pos and steps_count < MAX_PLAN_STEPS:\n    next_move_action = -1\n    dx_to_target_adj = target_adj_pos[0] - px_sim\n    dy_to_target_adj = target_adj_pos[1] - py_sim\n\n    # Prioritize moving along the axis with the larger distance, or X if distances are equal\n    if abs(dx_to_target_adj) >= abs(dy_to_target_adj):\n      if dx_to_target_adj > 0:\n        next_move_action = env_factory.RIGHT\n      elif dx_to_target_adj < 0:\n        next_move_action = env_factory.LEFT\n      # If dx_to_target_adj is 0, move along Y-axis if needed\n      elif dy_to_target_adj > 0:\n        next_move_action = env_factory.UP\n      elif dy_to_target_adj < 0:\n        next_move_action = env_factory.DOWN\n    else:  # Prioritize Y-axis movement\n      if dy_to_target_adj > 0:\n        next_move_action = env_factory.UP\n      elif dy_to_target_adj < 0:\n        next_move_action = env_factory.DOWN\n      # If dy_to_target_adj is 0, move along X-axis if needed\n      elif dx_to_target_adj > 0:\n        next_move_action = env_factory.RIGHT\n      elif dx_to_target_adj < 0:\n        next_move_action = env_factory.LEFT\n\n    if next_move_action != -1:\n      actions.append(next_move_action)\n      # Update simulated position and direction\n      move_dx, move_dy, new_dir = action_sim_effects[next_move_action]\n      px_sim += move_dx\n      py_sim += move_dy\n      dir_sim = new_dir\n      steps_count += 1\n    else:\n      # This case should ideally not be reached if target_adj_pos is reachable\n      # and MAX_PLAN_STEPS is sufficient, but acts as a safeguard.\n      break\n\n  # 6. After reaching target_adj_pos, ensure agent is facing the primitive\n  # Calculate relative position from the simulated agent's final position (target_adj_pos)\n  # to the actual primitive's position (tx, ty).\n  final_dx_to_primitive = tx - px_sim\n  final_dy_to_primitive = ty - py_sim\n\n  desired_dir_for_use = -1\n  if final_dx_to_primitive == 1 and final_dy_to_primitive == 0:  # Primitive is to the RIGHT\n    desired_dir_for_use = env_factory.RIGHT\n  elif final_dx_to_primitive == -1 and final_dy_to_primitive == 0:  # Primitive is to the LEFT\n    desired_dir_for_use = env_factory.LEFT\n  elif final_dx_to_primitive == 0 and final_dy_to_primitive == 1:  # Primitive is UP\n    desired_dir_for_use = env_factory.UP\n  elif final_dx_to_primitive == 0 and final_dy_to_primitive == -1:  # Primitive is DOWN\n    desired_dir_for_use = env_factory.DOWN\n  else:\n    # Primitive is not directly adjacent to the target_adj_pos after pathfinding\n    # (indicates a logical error or an unreachable setup for direct collection)\n    return []  # Cannot determine facing direction for collection\n\n  # If the simulated agent's current direction is not the desired direction, add a turn action.\n  # This assumes that a movement action can be used to simply change direction\n  # even if it means moving into a wall (which might not change position).\n  if dir_sim != desired_dir_for_use:\n    actions.append(desired_dir_for_use)\n\n  # 7. Finally, add the USE action to collect the primitive\n  actions.append(env_factory.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
