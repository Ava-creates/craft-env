{"timestamp": "2025-07-30T15:41:54.253309", "function_name": "collect", "function_body": "    # Action constants (assuming these are standard integer values accessible via env_factory)\n    DOWN = env_factory.actions.DOWN\n    UP = env_factory.actions.UP\n    LEFT = env_factory.actions.LEFT\n    RIGHT = env_factory.actions.RIGHT\n    USE = env_factory.actions.USE\n\n    # Define movement deltas for actions (row_change, col_change)\n    # Assuming (row, col) where row increases downwards, col increases rightwards.\n    ACTION_DELTAS = {\n        UP: (-1, 0),    # Move up: decreases row index\n        DOWN: (1, 0),   # Move down: increases row index\n        LEFT: (0, -1),  # Move left: decreases col index\n        RIGHT: (0, 1)   # Move right: increases col index\n    }\n\n    # Get the current state information from the environment\n    state = env._current_state\n    grid = state.grid\n    current_pos = state.pos\n    inventory = state.inventory\n    world = state.world\n\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n    goal_idx = primitive\n\n    # 1. Check if the primitive is already in the agent's inventory\n    if inventory[goal_idx] > 0:\n        return []  # Already collected, no actions needed\n\n    # 2. Perform a Breadth-First Search (BFS) to find a path to a cell\n    #    adjacent to (or on) the primitive.\n    #    The BFS state is (row, col, list_of_actions_taken).\n    #    We assume the 'USE' action picks up items in the 3x3 neighborhood,\n    #    so agent direction is not critical for 'USE'.\n\n    queue = collections.deque([(current_pos[0], current_pos[1], [])])\n    # Visited set to prevent cycles and redundant computations\n    visited = set([(current_pos[0], current_pos[1])])\n\n    while queue:\n        r, c, path = queue.popleft()\n\n        # Check if the current position (r, c) is adjacent to (or on) the primitive\n        # We check the 3x3 neighborhood around (r, c), including (r, c) itself.\n        for dr_check in [-1, 0, 1]:\n            for dc_check in [-1, 0, 1]:\n                check_r, check_c = r + dr_check, c + dc_check\n\n                # Ensure the checked cell is within grid bounds\n                if 0 <= check_r < WIDTH and 0 <= check_c < HEIGHT:\n                    # If the primitive is found at (check_r, check_c)\n                    if grid[check_r, check_c, goal_idx] == 1:\n                        # We found a path to a position from which the primitive can be collected.\n                        # Add the 'USE' action to the path and return.\n                        return path + [USE]\n\n        # Explore possible movement actions (UP, DOWN, LEFT, RIGHT)\n        for action in [UP, DOWN, LEFT, RIGHT]:\n            dr, dc = ACTION_DELTAS[action]\n            new_r, new_c = r + dr, c + dc\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= new_r < WIDTH and 0 <= new_c < HEIGHT):\n                continue\n\n            # Check if the new position is an obstacle (contains a non-grabbable item)\n            is_obstacle = False\n            for obstacle_idx in world.non_grabbable_indices:\n                if grid[new_r, new_c, obstacle_idx] == 1:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n\n            new_state = (new_r, new_c)\n            # If this state has not been visited, add it to the queue\n            if new_state not in visited:\n                visited.add(new_state)\n                queue.append((new_r, new_c, path + [action]))\n\n    # If the BFS completes and no path to the primitive was found\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:43:33.357352", "function_name": "collect", "function_body": "    state = env._current_state\n\n    # 1. Check if the primitive is already collected in the inventory\n    if state.inventory[primitive] > 0:\n        return []\n\n    grid = state.grid\n    grid_height, grid_width, _ = grid.shape\n    current_col, current_row = state.pos  # state.pos is (col, row)\n\n    target_locations = []\n    # 2. Locate all instances of the primitive on the grid\n    for r in range(grid_height):\n        for c in range(grid_width):\n            if grid[r, c, primitive] == 1:\n                target_locations.append((r, c))\n\n    if not target_locations:\n        # Primitive not found on the grid\n        return []\n\n    # BFS for pathfinding to find the shortest sequence of actions\n    # Queue stores (row, col, path_so_far)\n    q = collections.deque([(current_row, current_col, [])])\n    visited = set([(current_row, current_col)])\n\n    # Define movement actions and their corresponding (row_change, col_change) deltas\n    moves = {\n        env_factory.UP: (-1, 0),\n        env_factory.DOWN: (1, 0),\n        env_factory.LEFT: (0, -1),\n        env_factory.RIGHT: (0, 1)\n    }\n\n    # Obstacle indices are entities that cannot be moved into (e.g., water, stone, workshops)\n    obstacle_indices = env.world.non_grabbable_indices\n\n    while q:\n        r, c, path = q.popleft()\n\n        # 3. Check for goal: Is the current cell (r, c) adjacent to any target primitive?\n        # The agent needs to move to a cell *adjacent* to the primitive, then USE it.\n        for target_r, target_c in target_locations:\n            # Manhattan distance of 1 means adjacent (horizontally or vertically)\n            if abs(r - target_r) + abs(c - target_c) == 1:\n                # Found a path to a cell adjacent to the primitive, now add the USE action\n                return path + [env_factory.USE]\n\n        # 4. Explore neighbors for movement\n        for action, (dr, dc) in moves.items():\n            nr, nc = r + dr, c + dc  # New row, new col\n\n            # Check if the new coordinates are within grid bounds\n            if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n                continue\n\n            # Check if the new cell has already been visited in a shorter or equal path\n            if (nr, nc) in visited:\n                continue\n\n            # Check for obstacles: a cell is an obstacle if it contains any non-grabbable item\n            is_obstacle = False\n            for kind_idx in obstacle_indices:\n                if grid[nr, nc, kind_idx] == 1:\n                    is_obstacle = True\n                    break\n            \n            if not is_obstacle:\n                # If the cell is traversable, add it to the queue and visited set\n                visited.add((nr, nc))\n                q.append((nr, nc, path + [action]))\n\n    # If the queue becomes empty and no path was found to an adjacent cell of a primitive\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:43:33.431718", "function_name": "collect", "function_body": "    import numpy as np\n    import collections\n\n    # Helper function to convert (dx, dy) movement delta to an action integer\n    def _get_action_from_delta(dx, dy, action_map):\n        if dx == 1 and dy == 0: return action_map[\"RIGHT\"]\n        elif dx == -1 and dy == 0: return action_map[\"LEFT\"]\n        elif dx == 0 and dy == 1: return action_map[\"DOWN\"]\n        elif dx == 0 and dy == -1: return action_map[\"UP\"]\n        return None # Should not happen with valid deltas\n\n    # Helper function to check if a grid position is walkable\n    def _is_walkable(pos, grid_shape, world, grid):\n        x, y = pos\n        # Check bounds\n        if not (0 <= x < grid_shape[0] and 0 <= y < grid_shape[1]):\n            return False\n\n        # Check for obstacles (e.g., water)\n        # Assuming `world.water_index` is the primary non-walkable obstacle\n        if grid[x, y, world.water_index] > 0:\n            return False\n        \n        # Add checks for other non-walkable `non_grabbable_indices` if needed,\n        # distinguishing from workshops (which are often walkable).\n        # For simplicity, assuming only water is a hard obstacle for movement.\n        return True\n\n    # Helper function for BFS pathfinding\n    def _find_path_actions_bfs(start_pos, target_destination, grid, world, action_map):\n        \"\"\"\n        Finds a path of actions from start_pos to target_destination using BFS.\n        target_destination should be a walkable cell adjacent to the item to be collected.\n        Returns a list of actions (integers) or None if no path.\n        \"\"\"\n        grid_shape = grid.shape\n        \n        # Queue stores (current_pos, list_of_actions_to_reach_current_pos)\n        q = collections.deque([(start_pos, [])])\n        visited = {start_pos}\n\n        # Possible moves (dx, dy) for 4-directional movement\n        # (x, y) coordinates where x is column, y is row\n        moves = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Corresponds to DOWN, UP, RIGHT, LEFT\n        \n        # Mapping from (dx, dy) to action index for clarity in BFS\n        delta_to_action = {\n            (0, 1): action_map[\"DOWN\"],\n            (0, -1): action_map[\"UP\"],\n            (1, 0): action_map[\"RIGHT\"],\n            (-1, 0): action_map[\"LEFT\"],\n        }\n\n        while q:\n            (curr_x, curr_y), path_actions = q.popleft()\n\n            if (curr_x, curr_y) == target_destination:\n                return path_actions\n\n            for dx, dy in moves:\n                next_x, next_y = curr_x + dx, curr_y + dy\n                next_pos = (next_x, next_y)\n\n                if next_pos not in visited and \\\n                   _is_walkable(next_pos, grid_shape, world, grid):\n                    visited.add(next_pos)\n                    next_action = delta_to_action[(dx, dy)]\n                    q.append((next_pos, path_actions + [next_action]))\n\n        return None # No path found\n\n    # Start of collect_v2 function logic\n    actions_taken = [] # Accumulate actions taken\n    world = env.world\n    action_map = env.action_specs()\n    \n    ACTION_USE = action_map[\"USE\"]\n\n    # Max number of attempts to find and collect the primitive.\n    # This prevents infinite loops if the primitive is unreachable or logic fails.\n    # A heuristic: 2 * (grid width * grid height) should be enough for two full map traversals.\n    max_attempts = 2 * world.grid.shape[0] * world.grid.shape[1] \n\n    for _ in range(max_attempts): # Loop to attempt collection\n        obs = env.observations()\n        state_dict = obs['features_dict']\n        grid = state_dict['features_global']\n        current_pos = tuple(state_dict['pos'].astype(int))\n        inventory = state_dict['inventory']\n\n        # 1. Check if primitive is already collected\n        if inventory[primitive] > 0:\n            return actions_taken\n\n        # 2. Check for primitive in 3x3 neighborhood for immediate 'USE' action\n        # This covers direct collection without needing to move.\n        found_adjacent_primitive = False\n        for dx in [-1, 0, 1]:\n            for dy in [-1, 0, 1]:\n                # Skip agent's own cell if not explicitly allowed to 'USE' from current spot\n                # Primitives usually require being adjacent or on the spot.\n                # Assuming 3x3 general neighborhood check as per CraftState.next_to\n                if dx == 0 and dy == 0:\n                    continue \n                \n                check_x, check_y = current_pos[0] + dx, current_pos[1] + dy\n                \n                # Check bounds and if the cell contains the primitive\n                if (0 <= check_x < grid.shape[0] and 0 <= check_y < grid.shape[1] and\n                    grid[check_x, check_y, primitive] > 0):\n                    found_adjacent_primitive = True\n                    break\n            if found_adjacent_primitive:\n                break\n        \n        if found_adjacent_primitive:\n            actions_taken.append(ACTION_USE)\n            reward, done, new_obs = env.step(ACTION_USE) # Capture new observations\n            # After 'USE', check inventory in the new state. If collected, return.\n            if new_obs['features_dict']['inventory'][primitive] > 0:\n                 return actions_taken # Collected!\n            # If not collected (e.g., 'USE' failed or target was wrong), continue loop\n            continue \n\n        # 3. Find path to the primitive if not immediately collectible\n        primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n        \n        if len(primitive_locations) == 0:\n            # Primitive not found on the map. Cannot collect.\n            # Return actions taken so far, indicating failure to collect.\n            return actions_taken \n\n        # Find the shortest path to *any* walkable cell adjacent to *any* instance of the primitive\n        best_path_actions = None\n        min_path_len = float('inf')\n\n        for target_item_x, target_item_y in primitive_locations:\n            target_item_pos = (target_item_x, target_item_y)\n            \n            # Consider 4-directional neighbors for pathfinding to an adjacent cell\n            # Agent needs to reach one of these cells to use 'USE' on the primitive\n            for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # LEFT, RIGHT, UP, DOWN relative to target item\n                adj_x, adj_y = target_item_pos[0] + dx_adj, target_item_pos[1] + dy_adj\n                adj_pos = (adj_x, adj_y)\n                \n                # Check if this adjacent position is a valid, walkable target for the agent\n                if _is_walkable(adj_pos, grid.shape, world, grid):\n                    path_actions = _find_path_actions_bfs(current_pos, adj_pos, grid, world, action_map)\n                    \n                    if path_actions is not None:\n                        if len(path_actions) < min_path_len:\n                            min_path_len = len(path_actions)\n                            best_path_actions = path_actions\n        \n        if best_path_actions is None:\n            # No reachable primitive found (all existing primitives are unreachable)\n            return actions_taken\n\n        # Take the first action on the best path found\n        next_action = best_path_actions[0]\n        actions_taken.append(next_action)\n        reward, done, new_obs = env.step(next_action) # Capture new observations\n\n        # If the environment signals done, and we haven't collected, then something went wrong\n        # (e.g., max_steps of the episode reached, or other termination condition)\n        if done and new_obs['features_dict']['inventory'][primitive] == 0:\n            return actions_taken\n            \n    # If the loop finishes (max_attempts reached) without collecting the primitive\n    return actions_taken", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:44:31.369174", "function_name": "collect", "function_body": "  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dx == 0 and dy == 1: return SOUTH_DIR\n    if dx == 0 and dy == -1: return NORTH_DIR\n    return None # Should not happen if agent_pos and item_pos are cardinally adjacent\n\n  # Helper function: Checks if a cell is traversable (no non-grabbable items)\n  def _is_traversable(grid, x, y, non_grabbable_indices, grid_width, grid_height):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item (obstacle) is at (x, y)\n    for k_idx in non_grabbable_indices:\n      if grid[y, x, k_idx] == 1: # Grid is (height, width, kinds), so (y, x, k_idx)\n        return False\n    return True\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  initial_grid = current_state.grid # Use initial grid for traversability checks\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = initial_grid.shape\n\n  # Get non-grabbable indices for traversability check\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find all locations of the primitive on the grid\n  # np.where returns (row_indices, col_indices) which correspond to (y_coords, x_coords)\n  y_coords, x_coords = np.where(initial_grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Prepare BFS goal states: set of (agent_adj_x, agent_adj_y, agent_facing_dir)\n  # A BFS goal state is a (position, direction) from which the primitive can be 'USE'd.\n  # We'll store (agent_adj_x, agent_adj_y, agent_facing_dir) tuples\n  bfs_goal_state_configs = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells for the agent to stand on\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # dx_adj, dy_adj from item to agent\n      adj_x, adj_y = item_x + dx_adj, item_y + dy_adj\n\n      if _is_traversable(initial_grid, adj_x, adj_y, non_grabbable_indices, grid_width, grid_height):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_goal_state_configs.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_goal_state_configs:\n    return [] # No traversable adjacent positions to any primitive instance\n\n  # BFS: (current_x, current_y, current_dir, list_of_actions_to_reach_here)\n  # Using a list as queue (pop(0) for BFS) - Note: Using collections.deque would be more efficient,\n  # but sticking to list.pop(0) as per typical constraints for this kind of problem.\n  queue = [(initial_agent_x, initial_agent_y, initial_agent_dir, [])]\n  # Visited set: (x, y, dir) to avoid cycles and redundant exploration\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Define possible actions and their effects on (x, y, dir)\n  # Movement actions change (x,y) but not dir\n  movement_deltas = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n  # Turn actions change dir but not (x,y)\n  turn_actions = [LEFT_ACTION, RIGHT_ACTION]\n  \n  found_path_actions = None # Will store the shortest sequence of actions\n\n  while queue:\n    curr_x, curr_y, curr_dir, path_so_far = queue.pop(0)\n\n    # Check if the current state is one of the goal configurations\n    if (curr_x, curr_y, curr_dir) in bfs_goal_state_configs:\n      found_path_actions = path_so_far\n      break # Found the shortest path to a goal\n\n    # Explore neighbors through movement actions\n    for action, (dx, dy) in movement_deltas.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = curr_dir # Direction remains the same after movement\n\n      if _is_traversable(initial_grid, next_x, next_y, non_grabbable_indices, grid_width, grid_height):\n        if (next_x, next_y, next_dir) not in visited:\n          visited.add((next_x, next_y, next_dir))\n          queue.append((next_x, next_y, next_dir, path_so_far + [action]))\n    \n    # Explore neighbors through turning actions\n    for turn_action in turn_actions:\n      next_x, next_y = curr_x, curr_y # Position does not change for a pure turn\n      \n      # Calculate new direction based on the turn action\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise (0=N, 1=E, 2=S, 3=W)\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4 # Turn clockwise\n      \n      if (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir, path_so_far + [turn_action]))\n\n  if found_path_actions is None:\n    return [] # No path found to any primitive's collection point\n\n  # Final step: append the USE action after reaching the correct position and facing direction.\n  final_actions = list(found_path_actions) # Make a copy\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T15:44:32.369806", "function_name": "collect", "function_body": "  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dx == 0 and dy == 1: return SOUTH_DIR\n    if dx == 0 and dy == -1: return NORTH_DIR\n    return None # Should not happen if agent_pos and item_pos are cardinally adjacent\n\n  # Helper function: Checks if a cell is traversable (no non-grabbable items)\n  def _is_traversable(grid, x, y, non_grabbable_indices, grid_width, grid_height):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item (obstacle) is at (x, y)\n    for k_idx in non_grabbable_indices:\n      if grid[y, x, k_idx] == 1: # Grid is (HEIGHT, WIDTH, KINDS) so (y, x)\n        return False\n    return True\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n  grid = current_state.grid\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Get non-grabbable indices for traversability check\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Prepare BFS goal states:\n  # A BFS goal state is a tuple (agent_x, agent_y, agent_dir) from which the primitive can be 'USE'd.\n  bfs_goal_states = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells for the agent to stand on\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (dx_adj, dy_adj) from item to agent\n      adj_x, adj_y = item_x + dx_adj, item_y + dy_adj\n\n      if _is_traversable(grid, adj_x, adj_y, non_grabbable_indices, grid_width, grid_height):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_goal_states.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_goal_states:\n    return [] # No traversable adjacent positions to any primitive instance\n\n  # BFS: (current_x, current_y, current_dir, list_of_actions_to_reach_here)\n  # Using a list as queue (pop(0) for BFS)\n  queue = [(initial_agent_x, initial_agent_y, initial_agent_dir, [])]\n  # Visited set: (x, y, dir) to avoid cycles and redundant exploration\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  shortest_path_actions = None \n\n  while queue:\n    curr_x, curr_y, curr_dir, path_so_far = queue.pop(0)\n\n    # Check if the current state is one of the goal states\n    if (curr_x, curr_y, curr_dir) in bfs_goal_states:\n        shortest_path_actions = path_so_far\n        break # Found the shortest path to a goal\n\n    # Explore neighbors through movement actions (agent's direction doesn't change)\n    # Mapping for movement actions (dx, dy)\n    move_deltas = {\n        UP_ACTION: (0, -1),\n        DOWN_ACTION: (0, 1),\n        LEFT_ACTION: (-1, 0),\n        RIGHT_ACTION: (1, 0)\n    }\n    \n    for action, (dx, dy) in move_deltas.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = curr_dir # Direction remains the same after movement\n\n      if _is_traversable(grid, next_x, next_y, non_grabbable_indices, grid_width, grid_height):\n        state = (next_x, next_y, next_dir)\n        if state not in visited:\n          visited.add(state)\n          queue.append((next_x, next_y, next_dir, path_so_far + [action]))\n    \n    # Explore neighbors through turning actions (position doesn't change)\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      next_x, next_y = curr_x, curr_y # Position does not change for a pure turn\n      \n      # Calculate new direction based on the turn action\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4 # Turn clockwise\n      \n      state = (next_x, next_y, next_dir)\n      if state not in visited:\n        visited.add(state)\n        queue.append((next_x, next_y, next_dir, path_so_far + [turn_action]))\n\n  if shortest_path_actions is None:\n    return [] # No path found to any primitive's collection point\n\n  # Final step: append the USE action after reaching the correct position and facing direction.\n  final_actions = list(shortest_path_actions) # Make a copy\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T15:45:50.337716", "function_name": "collect", "function_body": "  from collections import deque\n\n  actions_list = []\n\n  # 1. Get necessary information from the current environment state\n  world = env.world\n  cookbook = world.cookbook\n  \n  # Get the integer ID for the primitive from its string name\n  primitive_idx = cookbook.index(primitive) \n  \n  # Get observations (grid, agent position)\n  obs = env.observations()\n  grid = obs['features_dict']['features_global'] # Full allocentric grid view\n  agent_x, agent_y = int(obs['features_dict']['pos'][0]), int(obs['features_dict']['pos'][1])\n\n  # 2. Locate all instances of the primitive on the grid\n  # np.argwhere returns (row, col) which corresponds to (y, x) coordinates\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1) \n  \n  if len(primitive_locations) == 0:\n      return [] # No primitive found in the environment\n\n  # 3. Find the closest primitive target using Manhattan distance\n  min_dist = float('inf')\n  closest_primitive_pos = None # Will store (target_y, target_x)\n\n  for py, px in primitive_locations:\n      dist = abs(px - agent_x) + abs(py - agent_y)\n      if dist < min_dist:\n          min_dist = dist\n          closest_primitive_pos = (py, px)\n\n  target_y, target_x = closest_primitive_pos\n\n  # 4. BFS to find the shortest path to a cell *adjacent* to the target primitive\n  # and not occupied by an obstacle.\n\n  q = deque([((agent_y, agent_x), [])]) # Queue stores ( (current_y, current_x), path_actions_so_far )\n  visited = set([(agent_y, agent_x)]) # Keep track of visited cells to avoid cycles and redundant paths\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Define possible movements and their corresponding actions based on action_specs\n  # (dy, dx) tuple maps to the action constant\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  DELTAS_TO_ACTION = {\n      (-1, 0): ACTION_UP,\n      (1, 0): ACTION_DOWN,\n      (0, -1): ACTION_LEFT,\n      (0, 1): ACTION_RIGHT\n  }\n\n  # Identify non-grabbable items that act as obstacles (e.g., environment entities)\n  non_grabbable_indices = world.non_grabbable_indices \n\n  path_to_adjacent_cell = []\n  found_path = False\n\n  while q:\n      (curr_y, curr_x), path_so_far = q.popleft()\n\n      # Check if current cell is already adjacent to the target primitive\n      # or if the agent is on the primitive (distance 0). In both cases, we are ready to USE.\n      if abs(curr_x - target_x) + abs(curr_y - target_y) <= 1:\n          path_to_adjacent_cell = path_so_far\n          found_path = True\n          break # Path found!\n\n      # Explore neighbors\n      for dy, dx in DELTAS_TO_ACTION.keys():\n          next_y, next_x = curr_y + dy, curr_x + dx\n\n          # Check bounds\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Check if already visited\n          if (next_y, next_x) in visited:\n              continue\n\n          # Check for obstacles:\n          # A cell is an obstacle if it contains a non-grabbable item,\n          # or if it's the primitive itself (we want to be adjacent to it, not on it,\n          # unless we start on it, which is handled by the initial check).\n          is_obstacle = False\n          if (next_y, next_x) == (target_y, target_x):\n              is_obstacle = True # Don't move onto the primitive itself\n          else:\n              # Check for other non-grabbable items in the target cell\n              for kind_idx in non_grabbable_indices:\n                  if grid[next_y, next_x, kind_idx] == 1:\n                      is_obstacle = True\n                      break\n          \n          if is_obstacle:\n              continue # Skip this cell, it's an obstacle\n          \n          # If not an obstacle and not visited, add to queue\n          visited.add((next_y, next_x))\n          q.append(((next_y, next_x), path_so_far + [DELTAS_TO_ACTION[(dy, dx)]]))\n  \n  if not found_path:\n      return [] # No path to an adjacent cell (or the primitive itself) found\n\n  # 5. Append the movement actions and the final USE action\n  actions_list.extend(path_to_adjacent_cell)\n  actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:45:50.407418", "function_name": "collect", "function_body": "    import collections\n\n    # Action constants (implied by CraftLab.action_specs())\n    # 0: DOWN, 1: UP, 2: LEFT, 3: RIGHT, 4: USE\n    MOVE_ACTIONS = [0, 1, 2, 3]  # DOWN, UP, LEFT, RIGHT\n    OFFSETS = {\n        0: (0, 1),  # DOWN (dx, dy)\n        1: (0, -1), # UP\n        2: (-1, 0), # LEFT\n        3: (1, 0)   # RIGHT\n    }\n    USE_ACTION = 4\n\n    # Get current state information from the environment\n    current_state = env._current_state  # Access CraftState instance\n\n    start_pos = current_state.pos\n    grid = current_state.grid\n    \n    # Get grid dimensions (grid is WIDTH x HEIGHT x n_kinds)\n    width = grid.shape[0]\n    height = grid.shape[1]\n\n    # Get non-grabbable indices from world for collision detection\n    # These are indices of entities that block movement\n    non_grabbable_indices = env.world.non_grabbable_indices\n    \n    # Initialize BFS queue and visited set\n    # Queue stores tuples of ((x, y), list_of_actions_to_reach_here)\n    q = collections.deque([(start_pos, [])])\n    # Visited set stores (x, y) tuples to avoid re-exploring cells\n    visited = set([start_pos])\n\n    while q:\n        (cx, cy), path_actions = q.popleft()\n\n        # Check if the primitive is in the 3x3 neighborhood (can be collected)\n        # Iterate over 3x3 neighborhood including the current cell\n        for dx_neighbor in [-1, 0, 1]:\n            for dy_neighbor in [-1, 0, 1]:\n                nx_neighbor, ny_neighbor = cx + dx_neighbor, cy + dy_neighbor\n\n                # Check bounds for the neighbor cell\n                if 0 <= nx_neighbor < width and 0 <= ny_neighbor < height:\n                    # If the primitive resource is present in this neighbor cell\n                    if grid[nx_neighbor, ny_neighbor, primitive] > 0:\n                        # Goal achieved: Return path + USE action\n                        return path_actions + [USE_ACTION]\n\n        # Explore possible next moves (UP, DOWN, LEFT, RIGHT)\n        for action in MOVE_ACTIONS:\n            dx, dy = OFFSETS[action]\n            nx, ny = cx + dx, cy + dy\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= nx < width and 0 <= ny < height):\n                continue\n\n            # Check if the new position has already been visited\n            if (nx, ny) in visited:\n                continue\n\n            # Check for blockages: if the cell contains any non-grabbable entity\n            is_blocked = False\n            for kind_idx in non_grabbable_indices:\n                # If there's any non-grabbable item present with a count > 0\n                if grid[nx, ny, kind_idx] > 0: \n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue # Cannot move into a blocked cell\n\n            # If the cell is valid and unvisited, add it to the queue\n            visited.add((nx, ny))\n            q.append(((nx, ny), path_actions + [action]))\n\n    # If the queue becomes empty and no path to the primitive was found\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:47:23.385673", "function_name": "collect", "function_body": "    actions_taken = []\n    \n    # Reset environment to a known initial state to ensure consistent behavior\n    # when determining the action sequence for collection from a fresh start.\n    _ = env.reset(seed=0) \n    current_state = env._current_state # Get the initial CraftState instance\n\n    # Safety break to prevent infinite loops if the primitive is unreachable or logic gets stuck.\n    # The actual max_steps for the episode are handled by env.step returning done=True.\n    max_simulated_steps = 1000 \n\n    for _ in range(max_simulated_steps):\n        # 1. Check if the primitive is already in inventory\n        if current_state.inventory[primitive] > 0:\n            break # Goal achieved! Stop collecting.\n\n        # 2. Check if the primitive is in the agent's immediate 3x3 neighborhood, including its own cell.\n        if current_state.next_to(primitive):\n            # If so, the action to take is USE.\n            actions_taken.append(env_factory.USE)\n            \n            # Simulate the step to update the internal state for subsequent decisions.\n            # `env_factory` is assumed to be imported at the module level and contains action constants.\n            reward, done, obs = env.step(env_factory.USE)\n            current_state = env._current_state # Update current_state for the next iteration\n            \n            if done: # If the environment signals the episode is over (e.g., max_steps reached, or goal satisfied by env's internal logic)\n                break\n            continue # After using, re-evaluate: might have collected, or need another USE, or need to move away for another primitive.\n\n        # 3. If not next to, find the primitive's location on the global grid and move towards it.\n        # `current_state.grid` has shape (WIDTH, HEIGHT, n_kinds)\n        # `np.argwhere` returns (row, col) for each match.\n        primitive_locations = np.argwhere(current_state.grid[:, :, primitive] > 0)\n\n        if len(primitive_locations) == 0:\n            # The primitive is not found anywhere on the map in the current grid.\n            # This could happen if all instances have been collected, or if it was never there.\n            break # Cannot collect what isn't there.\n\n        agent_pos = np.array(current_state.pos) # Agent's (y, x) position (numpy array for vectorized ops)\n\n        # Find the primitive location closest to the agent using Manhattan distance.\n        # Manhattan distance (L1 norm) is more appropriate for grid-based movements.\n        distances = np.sum(np.abs(primitive_locations - agent_pos), axis=1)\n        closest_primitive_pos = primitive_locations[np.argmin(distances)] # (py, px) of the closest one\n\n        # Calculate the delta (change in y, change in x) needed to reach the closest primitive.\n        dy, dx = closest_primitive_pos - agent_pos\n\n        next_move_action = None\n        # Prioritize movement along the dimension that has a larger distance to cover.\n        # This simple greedy strategy attempts to reduce the largest coordinate difference first.\n        if abs(dx) > abs(dy):\n            if dx > 0:\n                next_move_action = env_factory.RIGHT\n            else: # dx < 0\n                next_move_action = env_factory.LEFT\n        elif abs(dy) > 0: # Only consider dy if it's non-zero and potentially larger or equal to dx\n            if dy > 0:\n                next_move_action = env_factory.DOWN\n            else: # dy < 0\n                next_move_action = env_factory.UP\n        else:\n            # This case means dx == 0 and dy == 0.\n            # The agent is at the exact same coordinates as a primitive.\n            # This should have been caught by the `current_state.next_to(primitive)` check above.\n            # If we reach here, it implies a logical inconsistency or an uncollectible primitive\n            # at the agent's location (e.g., background element, or `next_to` definition issue).\n            # Breaking out prevents an infinite loop.\n            break \n\n        if next_move_action is not None:\n            actions_taken.append(next_move_action)\n            # Simulate the movement step.\n            reward, done, obs = env.step(next_move_action)\n            current_state = env._current_state # Update current_state\n            \n            if done: # If the environment indicates the episode is done (e.g., max_steps)\n                break\n        else:\n            # If no valid movement action could be determined (e.g., stuck).\n            break # Stop trying to collect.\n\n    return actions_taken", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:47:24.352125", "function_name": "collect", "function_body": "  # Action constants as per CraftLab.action_specs()\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  actions_taken = []\n  MAX_COLLECT_STEPS = 500  # Max steps to attempt collection\n\n  # Reset environment to get initial state\n  _ = env.reset()\n  state = env._current_state # Access the internal CraftState object\n\n  for step_count in range(MAX_COLLECT_STEPS):\n      # 1. Check if the primitive is already collected\n      if state.inventory[primitive] > 0:\n          return actions_taken\n\n      current_pos = np.array(state.pos)\n      current_grid = state.grid\n\n      # 2. Find the primitive on the grid\n      # np.argwhere returns (row, col) for non-zero elements\n      primitive_locations = np.argwhere(current_grid[:, :, primitive] > 0)\n\n      if len(primitive_locations) == 0:\n          # Primitive not found on the grid, cannot collect (at least not directly)\n          # This could happen if it's already collected, or if it needs crafting,\n          # or simply isn't spawned. For a collect function, this means failure.\n          return [] # No actions possible to collect\n\n      # 3. Determine the closest primitive location\n      # Calculate Manhattan distance to each primitive location\n      distances = np.sum(np.abs(primitive_locations - current_pos), axis=1)\n      closest_target_idx = np.argmin(distances)\n      closest_target = primitive_locations[closest_target_idx]\n\n      action_to_take = None\n\n      # 4. Check if we are adjacent to the primitive and can USE it\n      # CraftState.next_to checks 3x3 neighborhood. If true, we should try to USE.\n      # This assumes USE interacts with *any* adjacent primitive in the 3x3 radius,\n      # or at least the closest one.\n      if state.next_to(primitive):\n          action_to_take = ACTION_USE\n      else:\n          # 5. If not adjacent, move towards the closest primitive\n          dr = closest_target[0] - current_pos[0]\n          dc = closest_target[1] - current_pos[1]\n\n          # Prioritize moving in the dimension with larger difference\n          if abs(dr) > abs(dc):\n              if dr < 0:\n                  action_to_take = ACTION_UP\n              else: # dr > 0\n                  action_to_take = ACTION_DOWN\n          else: # abs(dc) >= abs(dr)\n              if dc < 0:\n                  action_to_take = ACTION_LEFT\n              else: # dc > 0\n                  action_to_take = ACTION_RIGHT\n      \n      if action_to_take is not None:\n          actions_taken.append(action_to_take)\n          # Perform the action\n          reward, done, observations = env.step(action_to_take)\n          state = env._current_state # Update the state reference for next iteration\n\n          # If the goal is satisfied after this step, we're done\n          if state.inventory[primitive] > 0:\n              return actions_taken\n      else:\n          # This branch should ideally not be reached if primitive_locations is not empty\n          # and a move action or USE action is always selected.\n          return [] # Indicate inability to plan further or error\n\n  # If max steps reached without collecting the primitive\n  return [] # Return empty list, indicating failure to collect within limit", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:48:56.806257", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants based on CraftLab.action_specs()\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Mapping from (dy, dx) movement vector to integer direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  # This assumes moving in a direction sets the agent's facing direction to that same direction.\n  INV_DIR_VECTORS = {\n      (-1, 0): 0,   # UP\n      (0, 1): 1,    # RIGHT\n      (1, 0): 2,    # DOWN\n      (0, -1): 3    # LEFT\n  }\n\n  def get_action_for_move_vector(dr_move, dc_move):\n      \"\"\"Helper to get the action constant for a given move vector.\"\"\"\n      if dr_move == -1 and dc_move == 0:\n          return UP\n      elif dr_move == 1 and dc_move == 0:\n          return DOWN\n      elif dr_move == 0 and dc_move == -1:\n          return LEFT\n      elif dr_move == 0 and dc_move == 1:\n          return RIGHT\n      return None # Should not happen for valid 4-directional moves\n\n  state = env._current_state\n  grid = state.grid\n  current_pos = state.pos\n  current_dir = state.dir # Initial agent direction\n  \n  actions_to_return = []\n\n  # Check if primitive is already in inventory\n  if state.inventory[primitive] > 0:\n      return actions_to_return # Already collected\n\n  # Find all locations of the primitive on the grid\n  primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n\n  if len(primitive_locations) == 0:\n      # Primitive not found on the grid, cannot collect\n      return []\n\n  # --- Pathfinding (BFS) to find the closest primitive and an adjacent cell,\n  #     where the agent will be facing the primitive upon arrival. ---\n  \n  # The queue will store (current_cell_pos (y, x), path_list, current_facing_dir)\n  q = collections.deque([(current_pos, [], current_dir)])\n  \n  # Visited set to avoid redundant exploration and cycles.\n  # Stores (y, x, facing_direction) tuples.\n  visited = {(current_pos[0], current_pos[1], current_dir)}\n  \n  grid_height, grid_width, _ = grid.shape\n\n  found_path = False\n  best_path = [] # Stores sequence of action constants\n  \n  # Define possible moves and their resulting directions\n  # (dy, dx, new_facing_direction) for each action\n  move_vectors_and_new_dirs = {\n      UP: (-1, 0, INV_DIR_VECTORS[(-1, 0)]),\n      RIGHT: (0, 1, INV_DIR_VECTORS[(0, 1)]),\n      DOWN: (1, 0, INV_DIR_VECTORS[(1, 0)]),\n      LEFT: (0, -1, INV_DIR_VECTORS[(0, -1)])\n  }\n\n  while q:\n      (r, c), path_so_far, agent_dir_at_rc = q.popleft()\n\n      # Check if this cell (r, c) is adjacent to any primitive\n      for pr, pc in primitive_locations:\n          dr_target = pr - r\n          dc_target = pc - c\n\n          # Check if (r, c) is adjacent (Manhattan distance 1)\n          if abs(dr_target) + abs(dc_target) == 1:\n              # Determine the direction required to face the primitive from (r, c)\n              required_facing_dir = INV_DIR_VECTORS.get((dr_target, dc_target))\n\n              # If current agent direction matches the required direction\n              if required_facing_dir is not None and agent_dir_at_rc == required_facing_dir:\n                  best_path = path_so_far\n                  found_path = True\n                  break # Found a valid path and orientation\n      if found_path:\n          break\n\n      # Explore neighbors\n      for action, (dr_move, dc_move, new_facing_dir) in move_vectors_and_new_dirs.items():\n          nr, nc = r + dr_move, c + dc_move\n\n          # Check bounds\n          if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n              continue\n\n          # Check if this (pos, dir) combination has already been visited\n          if (nr, nc, new_facing_dir) in visited:\n              continue\n\n          # Check if the target cell is occupied by the primitive itself (cannot step on it)\n          is_occupied_by_target_primitive = grid[nr, nc, primitive] == 1\n          if is_occupied_by_target_primitive:\n              continue\n\n          # Check if the target cell is occupied by any non-grabbable obstacle\n          is_occupied_by_nongrabbable = False\n          for idx in state.world.non_grabbable_indices:\n              if grid[nr, nc, idx] == 1:\n                  is_occupied_by_nongrabbable = True\n                  break\n          if is_occupied_by_nongrabbable:\n              continue\n\n          # If the cell is walkable, add it to the queue\n          visited.add((nr, nc, new_facing_dir))\n          q.append(((nr, nc), path_so_far + [action], new_facing_dir))\n\n  if not found_path:\n      # No path found to any primitive where agent can face it correctly\n      return []\n\n  # Add the found movement actions\n  actions_to_return.extend(best_path)\n  \n  # After reaching the adjacent cell and facing the primitive, perform USE action\n  actions_to_return.append(USE)\n  \n  return actions_to_return", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:48:56.875201", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants mapping symbolic names to integer values as per CraftLab.action_specs()\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Maps movement actions to (delta_row, delta_col) changes on the grid.\n    # Assuming UP is moving towards lower row index (North), DOWN towards higher (South),\n    # LEFT towards lower column index (West), and RIGHT towards higher (East).\n    ACTION_TO_DELTA = {\n        ACTION_UP: (-1, 0),\n        ACTION_DOWN: (1, 0),\n        ACTION_LEFT: (0, -1),\n        ACTION_RIGHT: (0, 1),\n    }\n\n    # Reset the environment to a fresh state for the collection task.\n    # This ensures a consistent starting point for finding the primitive.\n    initial_obs = env.reset()\n\n    # Extract relevant information from the initial observation.\n    # Agent's position is given as a tuple (row, col).\n    current_pos = tuple(map(int, initial_obs['features_dict']['pos']))\n\n    # The full grid layout, typically of shape (Height, Width, n_kinds).\n    grid = initial_obs['features_dict']['features_global']\n\n    # Agent's current inventory, a numpy array where indices correspond to item kinds.\n    inventory = initial_obs['features_dict']['inventory']\n\n    # 1. Check if the primitive is already present in the agent's inventory.\n    if inventory[primitive] > 0:\n        return []  # Already collected, no actions needed.\n\n    # Get the dimensions of the grid for boundary checks.\n    grid_height, grid_width, _ = grid.shape\n\n    # Identify obstacle kinds. These are non-grabbable entities defined in the cookbook's\n    # 'environment' set, which the agent cannot move through.\n    obstacle_kinds = env.world.cookbook.environment\n\n    # Initialize Breadth-First Search (BFS).\n    # The queue stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n    q = collections.deque([(current_pos, [])])\n\n    # A set to keep track of visited positions to prevent cycles and redundant exploration.\n    visited = {current_pos}\n\n    # Start the BFS loop.\n    while q:\n        (r, c), path_actions = q.popleft()\n\n        # Check if the current cell (r, c) contains the desired primitive.\n        # If grid[r, c, primitive] > 0, it means the primitive is at this location.\n        if grid[r, c, primitive] > 0:\n            # We have reached the cell containing the primitive.\n            # In this environment model, a movement action (like UP, DOWN, LEFT, RIGHT)\n            # moves the agent to the new cell AND sets its facing direction to match that movement.\n            # Therefore, by reaching (r, c) with the last action in `path_actions`, the agent\n            # is now facing the primitive at (r, c). We simply need to perform the USE action.\n            return path_actions + [ACTION_USE]\n\n        # Explore all possible next moves from the current position.\n        for action, (dr, dc) in ACTION_TO_DELTA.items():\n            next_r, next_c = r + dr, c + dc\n            next_pos = (next_r, next_c)\n\n            # Check if the calculated next position is within the grid boundaries.\n            if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n                continue\n\n            # Check if this next position has already been visited during the search.\n            if next_pos in visited:\n                continue\n\n            # Check if the next position contains any obstacle.\n            is_obstacle = False\n            for kind_idx in obstacle_kinds:\n                if grid[next_r, next_c, kind_idx] > 0:\n                    is_obstacle = True\n                    break # Found an obstacle, this path is blocked.\n\n            # If the next position is not an obstacle and has not been visited,\n            # add it to the queue for further exploration and mark it as visited.\n            if not is_obstacle:\n                visited.add(next_pos)\n                q.append((next_pos, path_actions + [action]))\n\n    # If the BFS queue becomes empty and the primitive was not found (i.e., it's unreachable\n    # or does not exist in the current grid), return an empty list of actions.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:50:06.139399", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Mapping from movement action to the direction the agent would face after taking it\n  action_to_direction = {\n      UP_ACTION: NORTH_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  # Mapping from movement action to (dx, dy) delta\n  action_to_move_delta = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"\n    Calculates the direction the agent needs to face to look at the item.\n    Assumes item is directly adjacent (cardinally) to the agent.\n    \"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dx == 0 and dy == 1: return SOUTH_DIR\n    if dx == 0 and dy == -1: return NORTH_DIR\n    return None # Item is not cardinally adjacent, or agent is on item\n\n  # Get primitive's integer ID\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Check if the primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  def is_walkable(x, y, current_grid):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-grabbable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item is present at (y, x)\n    # The agent cannot move onto water or workshops if they are defined as non-grabbable\n    for kind_idx in non_grabbable_kinds:\n      if current_grid[y, x, kind_idx] > 0:\n        return False\n    return True\n\n  # 1. Find all locations of the primitive on the grid\n  primitive_y_coords, primitive_x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(primitive_x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # 2. Identify all target interaction points for BFS goal states.\n  # A target interaction point is (adjacent_x, adjacent_y, required_facing_direction_to_item).\n  target_interaction_points = set()\n  for i in range(len(primitive_x_coords)):\n    item_x, item_y = primitive_x_coords[i], primitive_y_coords[i]\n    # Check all 4 cardinal neighbors of the item\n    for action_val, (dx, dy) in action_to_move_delta.items():\n      adj_x, adj_y = item_x + dx, item_y + dy\n      if is_walkable(adj_x, adj_y, grid):\n        # Determine the direction the agent needs to face to use the item from this adjacent cell\n        required_facing_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_facing_dir is not None:\n          target_interaction_points.add((adj_x, adj_y, required_facing_dir))\n\n  if not target_interaction_points:\n    return [] # No reachable adjacent cells to any primitive item\n\n  # 3. Initialize BFS queue: (current_x, current_y, current_direction, path_actions_list)\n  queue = collections.deque([(start_pos_x, start_pos_y, start_dir, [])])\n  # 4. Initialize visited set to avoid cycles and redundant paths: (x, y, direction)\n  visited = {(start_pos_x, start_pos_y, start_dir)}\n\n  # 5. Run BFS\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the current state is a goal state (can immediately use the primitive)\n    if (curr_x, curr_y, curr_dir) in target_interaction_points:\n      return path_actions + [USE_ACTION]\n\n    # --- Expand possible next states ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for move_action, (dx, dy) in action_to_move_delta.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      # After a movement action, the agent's direction automatically aligns with the movement.\n      next_dir_after_move = action_to_direction[move_action]\n\n      if is_walkable(next_x, next_y, grid) and \\\n         (next_x, next_y, next_dir_after_move) not in visited:\n        visited.add((next_x, next_y, next_dir_after_move))\n        queue.append((next_x, next_y, next_dir_after_move, path_actions + [move_action]))\n\n    # B. Turning Actions (LEFT, RIGHT)\n    # These actions change direction but not position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n\n      # Position remains the same\n      if (curr_x, curr_y, next_dir) not in visited:\n        visited.add((curr_x, curr_y, next_dir))\n        queue.append((curr_x, curr_y, next_dir, path_actions + [turn_action]))\n\n  # If the queue becomes empty and no path to a primitive was found\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T15:50:07.131903", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Mapping from movement action to the direction the agent would face after taking it\n  action_to_direction = {\n      DOWN_ACTION: SOUTH_DIR,\n      UP_ACTION: NORTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  # Helper for cardinal moves\n  cardinal_moves = {\n      RIGHT_ACTION: (1, 0),\n      LEFT_ACTION: (-1, 0),\n      DOWN_ACTION: (0, 1),\n      UP_ACTION: (0, -1)\n  }\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"Calculates the direction the agent needs to face to look at the item.\n    Assumes item is directly adjacent to agent.\"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 0 and dy == 0:\n      return None # Agent is on top of item, should not happen when targeting an adjacent cell\n\n    # Simplified logic for directly adjacent cells\n    if dy < 0: return NORTH_DIR\n    if dy > 0: return SOUTH_DIR\n    if dx > 0: return EAST_DIR\n    if dx < 0: return WEST_DIR\n    return None # Should not be reached for valid adjacent targets\n\n  def _get_turn_actions(current_dir, target_dir):\n    \"\"\"Returns a list of actions to turn from current_dir to target_dir.\"\"\"\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    # Calculate shortest turns (clockwise vs. counter-clockwise)\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION)\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION)\n    return actions\n\n  # Get primitive's integer ID\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Check if the primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  def is_walkable(x, y):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-grabbable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item is present at (y, x)\n    for kind_idx in non_grabbable_kinds:\n      if grid[y, x, kind_idx] > 0:\n        return False\n    return True\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Collect all target cells that are adjacent to ANY primitive instance\n  # We also store which primitive position this adjacent cell corresponds to,\n  # so we know what to face once we reach an adjacent cell.\n  all_target_adjacent_cells = {} # {(adj_x, adj_y): (primitive_x, primitive_y)}\n\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    for action_type_val, (dx, dy) in cardinal_moves.items():\n      adj_x, adj_y = item_x + dx, item_y + dy\n      if is_walkable(adj_x, adj_y):\n        # If multiple primitives share an adjacent cell, any corresponding primitive position is fine.\n        if (adj_x, adj_y) not in all_target_adjacent_cells:\n            all_target_adjacent_cells[(adj_x, adj_y)] = (item_x, item_y)\n\n  if not all_target_adjacent_cells:\n    return [] # No walkable adjacent cells found for any primitive instance\n\n  # BFS to find the shortest sequence of movement actions to reach *any* target adjacent cell\n  queue = collections.deque([(start_pos_x, start_pos_y, [])])\n  visited = {(start_pos_x, start_pos_y)}\n\n  movement_actions_to_primitive = None\n  reached_adjacent_pos = None # The specific adjacent cell (x, y) we reached\n\n  while queue:\n    curr_x, curr_y, path_actions = queue.popleft()\n\n    if (curr_x, curr_y) in all_target_adjacent_cells:\n      movement_actions_to_primitive = path_actions\n      reached_adjacent_pos = (curr_x, curr_y)\n      break\n\n    for action_type, (dx, dy) in cardinal_moves.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      if is_walkable(next_x, next_y) and (next_x, next_y) not in visited:\n        visited.add((next_x, next_y))\n        new_path_actions = list(path_actions) + [action_type]\n        queue.append((next_x, next_y, new_path_actions))\n\n  if movement_actions_to_primitive is None:\n    return [] # No path found to any reachable adjacent cell to any primitive\n\n  # Get the position of the primitive associated with the reached adjacent cell\n  target_item_x, target_item_y = all_target_adjacent_cells[reached_adjacent_pos]\n\n  # Simulate the agent's final position AND direction after executing the movement actions\n  final_agent_pos_x, final_agent_pos_y = start_pos_x, start_pos_y\n  final_agent_dir = start_dir # Initialize with starting direction\n\n  for action in movement_actions_to_primitive:\n      dx, dy = cardinal_moves[action]\n      final_agent_pos_x += dx\n      final_agent_pos_y += dy\n      # Update agent's facing direction based on the last movement action\n      if action in action_to_direction: # This will always be true for movement actions from cardinal_moves\n          final_agent_dir = action_to_direction[action]\n\n  # Determine the direction the agent needs to face the primitive from its final position\n  target_face_dir = _get_target_facing_direction(final_agent_pos_x, final_agent_pos_y, target_item_x, target_item_y)\n\n  all_actions = list(movement_actions_to_primitive)\n\n  if target_face_dir is not None:\n    # Use the final_agent_dir (after movements) for calculating turn actions\n    turn_actions = _get_turn_actions(final_agent_dir, target_face_dir)\n    all_actions.extend(turn_actions)\n\n  all_actions.append(USE_ACTION)\n\n  return all_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T15:51:25.718041", "function_name": "collect", "function_body": "    actions_taken = []\n    max_exploration_steps = 100  # Maximum steps to attempt collecting the item\n\n    # Constants for actions, derived from CraftLab.action_specs\n    _ACTION_DOWN = 0\n    _ACTION_UP = 1\n    _ACTION_LEFT = 2\n    _ACTION_RIGHT = 3\n    _ACTION_USE = 4\n\n    # Check if the primitive is already in the inventory at the start\n    current_obs = env.observations()\n    if current_obs['features_dict']['inventory'][primitive] > 0:\n        return actions_taken  # Already collected, no actions needed\n\n    for _ in range(max_exploration_steps):\n        # Access the underlying CraftState instance for more detailed checks\n        # like `next_to`. This is typically used for agent logic within the environment.\n        current_craft_state = env._current_state\n\n        if current_craft_state.next_to(primitive):\n            # If the primitive is adjacent, perform the 'USE' action to collect it.\n            actions_taken.append(_ACTION_USE)\n            reward, done, next_obs = env.step(_ACTION_USE)\n            \n            # After attempting to use/collect, check if the item is now in inventory.\n            if next_obs['features_dict']['inventory'][primitive] > 0:\n                return actions_taken\n        else:\n            # If the primitive is not adjacent, move randomly to explore the environment.\n            movement_actions = [_ACTION_DOWN, _ACTION_UP, _ACTION_LEFT, _ACTION_RIGHT]\n            action_to_take = np.random.choice(movement_actions)\n            \n            actions_taken.append(action_to_take)\n            reward, done, next_obs = env.step(action_to_take)\n\n        # Check if the environment signals that the episode is done (e.g., max_steps reached\n        # or goal achieved by the environment's internal logic).\n        if done:\n            break\n\n        # A final check after any action, in case a movement implicitly leads to collection\n        # or to ensure the most up-to-date inventory status.\n        if next_obs['features_dict']['inventory'][primitive] > 0:\n            return actions_taken\n\n    # If the loop completes without collecting the primitive (e.g., max_exploration_steps reached),\n    # return the sequence of actions taken so far.\n    return actions_taken", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:51:25.788704", "function_name": "collect", "function_body": "    # Define actions using env.action_specs() for clarity and robustness\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    # Define possible moves for BFS and their corresponding actions\n    # (dr, dc): (change in row, change in column)\n    move_deltas = {\n        (-1, 0): UP,    # Move up: (row - 1)\n        (1, 0): DOWN,   # Move down: (row + 1)\n        (0, -1): LEFT,  # Move left: (col - 1)\n        (0, 1): RIGHT   # Move right: (col + 1)\n    }\n\n    # Get current observations from the environment\n    obs = env.observations()\n\n    # Extract grid dimensions from the world object\n    world = env.world\n    GRID_HEIGHT = world.HEIGHT\n    GRID_WIDTH = world.WIDTH\n\n    # Extract current agent position from observations (denormalized)\n    # Assuming features_dict['pos'] is [normalized_x, normalized_y] where x is column, y is row\n    # And CraftState.pos is (row, col)\n    current_pos_normalized = obs['features_dict']['pos']\n    current_col = int(round(current_pos_normalized[0] * (GRID_WIDTH - 1)))\n    current_row = int(round(current_pos_normalized[1] * (GRID_HEIGHT - 1)))\n    current_pos = (current_row, current_col) # Agent's current (row, col)\n\n    # Get the current grid state (full allocentric view)\n    grid = obs['features_dict']['features_global']\n\n    # Check if the primitive is already in the agent's inventory\n    current_inventory = obs['features_dict']['inventory']\n    if current_inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # Find all locations on the grid where the target primitive exists\n    primitive_locations = []\n    for r in range(GRID_HEIGHT):\n        for c in range(GRID_WIDTH):\n            if grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    # If the primitive is not found anywhere on the grid, return a simple exploratory sequence\n    # This prevents the function from getting stuck if the item is not spawned or is unreachable.\n    if not primitive_locations:\n        # A simple fixed sequence to explore a small area\n        return [RIGHT, DOWN, LEFT, UP] \n\n    # --- Breadth-First Search (BFS) to find the shortest path to any primitive location ---\n    # The queue stores tuples of (current_position, list_of_actions_to_reach_here)\n    queue = collections.deque([(current_pos, [])])\n    visited = {current_pos} # Keep track of visited positions to avoid cycles and redundant paths\n    \n    target_path_actions = None\n\n    while queue:\n        (r, c), path_so_far = queue.popleft()\n\n        # Check if the current cell contains the primitive\n        if (r, c) in primitive_locations:\n            target_path_actions = path_so_far\n            break # Found the shortest path to a primitive\n\n        # Explore neighboring cells\n        for (dr, dc), action in move_deltas.items():\n            nr, nc = r + dr, c + dc # Calculate new row and column\n\n            # Check if the neighbor is within grid boundaries\n            if not (0 <= nr < GRID_HEIGHT and 0 <= nc < GRID_WIDTH):\n                continue\n            \n            # Check if the neighbor has already been visited during this BFS\n            if (nr, nc) in visited:\n                continue\n            \n            # Assuming all grid cells are traversable for movement.\n            # The problem description does not specify non-traversable terrain beyond boundaries.\n\n            visited.add((nr, nc)) # Mark as visited\n            queue.append(((nr, nc), path_so_far + [action])) # Add to queue with updated path\n    \n    if target_path_actions is not None:\n        # If a path was found, append the USE action to the end of the path.\n        # This assumes the USE action works when standing on the primitive's cell\n        # or that the agent automatically reorients for collection.\n        return target_path_actions + [USE]\n    else:\n        # If no path could be found (e.g., all primitives are genuinely unreachable \n        # due to complex map layouts or obstructions not accounted for by simple BFS),\n        # return a simple exploratory sequence as a fallback.\n        return [RIGHT, DOWN, LEFT, UP]", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:52:31.224931", "function_name": "collect", "function_body": "    # We need to access the CraftState from the CraftLab environment.\n    # The `env` passed here is a CraftLab instance.\n    # The actual state object for planning is `env._current_state`.\n    initial_craft_state = env._current_state\n\n    # Check if we already have the primitive in inventory at the start\n    if initial_craft_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # BFS setup\n    # Queue stores (CraftState, list_of_actions_taken_to_reach_this_state)\n    # Using a list as a queue and pop(0) for FIFO, as `collections.deque`\n    # might not be available due to the \"Do not imports\" constraint.\n    queue = [(initial_craft_state, [])] \n    \n    # Visited set to prevent cycles and redundant exploration.\n    # A state is uniquely defined by (agent_position, agent_direction, has_primitive_flag).\n    # `has_primitive_flag` is true if the primitive is in inventory, false otherwise.\n    # This helps distinguish states where the agent is at the same pos/dir but now\n    # possesses the primitive (a new, potentially goal-reaching state).\n    visited = set([(initial_craft_state.pos, initial_craft_state.dir, initial_craft_state.inventory[primitive] > 0)])\n\n    # Define the possible actions: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    ACTIONS = [0, 1, 2, 3, 4]\n\n    # Perform Breadth-First Search\n    while queue:\n        # Dequeue the current state and its path\n        current_state, path_actions = queue.pop(0) # Use pop(0) for list-as-queue behavior\n\n        # Goal check: If the primitive is now in the inventory, we found a path\n        if current_state.inventory[primitive] > 0:\n            return path_actions\n\n        # Explore all possible next actions from the current state\n        for action in ACTIONS:\n            # Optimization: The 'USE' action is only effective if the agent is\n            # next to an object. For collecting a primitive, it means being next to it.\n            # This prunes the search space by not trying 'USE' randomly.\n            if action == 4 and not current_state.next_to(primitive):\n                continue # Skip 'USE' if not next to the primitive\n\n            # Simulate the action: Get the new state after performing 'action'.\n            # CraftState.step returns (reward, new_state). We only need `new_state`.\n            _reward, next_state = current_state.step(action)\n\n            # Construct a unique key for the next state to check against the visited set.\n            # This key is crucial for BFS correctness, ensuring we don't re-explore\n            # states already processed or in the queue.\n            next_state_key = (next_state.pos, next_state.dir, next_state.inventory[primitive] > 0)\n\n            # If this next_state has not been visited yet:\n            if next_state_key not in visited:\n                visited.add(next_state_key) # Mark as visited\n                # Enqueue the new state along with the path taken to reach it\n                queue.append((next_state, path_actions + [action]))\n    \n    # If the queue becomes empty and the goal (collecting the primitive)\n    # has not been achieved, it means the primitive is unreachable\n    # from the initial state under the current environment rules.\n    return [] # Primitive not found or unreachable", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:52:32.193085", "function_name": "collect", "function_body": "  import collections\n\n  # Actions (from CraftLab.action_specs)\n  # These are defined as constants to improve readability and maintainability.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map (dx, dy) coordinate changes to corresponding action integers.\n  # This helps in translating BFS movements to agent actions.\n  actions_map = {\n      (0, -1): DOWN,  # Moving one step down (decreasing Y-coordinate)\n      (0, 1): UP,     # Moving one step up (increasing Y-coordinate)\n      (-1, 0): LEFT,  # Moving one step left (decreasing X-coordinate)\n      (1, 0): RIGHT,  # Moving one step right (increasing X-coordinate)\n  }\n\n  # Get the current state of the CraftWorld from the environment.\n  # The `_current_state` attribute of CraftLab holds a CraftState object.\n  state = env._current_state\n\n  # Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed, so return an empty list.\n  if state.inventory[primitive] > 0:\n      return []\n\n  # Get the dimensions of the grid from the current state.\n  # grid.shape returns (WIDTH, HEIGHT, n_kinds).\n  grid_width, grid_height, _ = state.grid.shape\n\n  # Get the agent's current starting position.\n  start_pos = state.pos\n\n  # Initialize a deque for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_position, path_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])])\n\n  # Initialize a set to keep track of visited positions during BFS.\n  # This prevents infinite loops and ensures the shortest path is found.\n  visited = {start_pos}\n\n  # Perform BFS to find the shortest path to a position from which the\n  # primitive can be collected (i.e., a position adjacent to it).\n  while q:\n      current_pos, path_actions = q.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is adjacent to (or contains) the primitive.\n      # The `state.next_to(primitive)` method checks the 3x3 neighborhood.\n      # If true, the agent can perform the USE action from this spot.\n      if state.next_to(primitive):\n          # Since BFS explores layer by layer, the first time we find such a\n          # position, the `path_actions` will be the shortest sequence of moves.\n          # Append the USE action to collect the primitive and return the complete action list.\n          return path_actions + [USE]\n\n      # Explore all four possible neighboring cells (Up, Down, Left, Right).\n      for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n          nx, ny = cx + dx, cy + dy\n          next_pos = (nx, ny)\n\n          # Check if the new position is within the grid boundaries.\n          if 0 <= nx < grid_width and 0 <= ny < grid_height:\n              # Check if this position has not been visited yet.\n              if next_pos not in visited:\n                  visited.add(next_pos)  # Mark as visited\n                  # Determine the action required to move to `next_pos`.\n                  action_to_reach = actions_map[(dx, dy)]\n                  # Add the new state to the queue: (new position, updated path of actions).\n                  q.append((next_pos, path_actions + [action_to_reach]))\n\n  # If the BFS queue becomes empty and no path to the primitive (or an adjacent cell)\n  # was found, it means the primitive is unreachable. Return an empty list.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:53:44.617589", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    try:\n        current_state = env._current_state\n    except AttributeError:\n        # If env is not a CraftLab instance or _current_state is not exposed,\n        # this function cannot simulate steps effectively.\n        return []\n\n    # Check if the primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # BFS setup\n    queue = collections.deque()\n    # Queue stores (current_CraftState, list_of_actions_to_reach_this_state)\n    queue.append((current_state, []))\n\n    # Visited set to prevent cycles and re-exploring states.\n    # A state is defined by (position_x, position_y, direction).\n    visited = set()\n    # Add initial state to visited set\n    visited.add((current_state.pos[0], current_state.pos[1], current_state.dir))\n\n    # A safety limit for search depth to prevent excessive computation\n    # or infinite loops in large/complex worlds.\n    max_search_depth = 250\n\n    while queue:\n        state, actions_path = queue.popleft()\n\n        # Prune paths that exceed the maximum search depth\n        if len(actions_path) >= max_search_depth:\n            continue\n\n        # Check if the primitive is next to the agent's current position\n        # If so, simulate the 'USE' action and check if the primitive is collected.\n        if state.next_to(primitive):\n            # Simulate the 'USE' action (action 4)\n            _, state_after_use = state.step(4) # 4 corresponds to ACTION_USE\n            # If the primitive is now in the inventory, this path is successful\n            if state_after_use.inventory[primitive] > 0:\n                return actions_path + [4] # Return the sequence of actions including 'USE'\n\n        # Explore possible next states by trying all movement actions\n        # Actions: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT\n        # Prioritize UP (1) for typical forward movement, then others.\n        for action in [1, 0, 2, 3]:\n            # Simulate the action to get the next state\n            _, next_state = state.step(action)\n\n            # Create a hashable representation of the next state for the visited set\n            next_state_tuple = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n            # If this state has not been visited before, add it to the queue\n            if next_state_tuple not in visited:\n                visited.add(next_state_tuple)\n                queue.append((next_state, actions_path + [action]))\n\n    # If the BFS completes and the goal is not found, it means the primitive\n    # is unreachable within the defined search depth.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:53:45.590692", "function_name": "collect", "function_body": "  import collections\n\n  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos\n  agent_dir = state.dir\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n  primitive_locations = []\n  for r_idx in range(WIDTH):\n    for c_idx in range(HEIGHT):\n      # Find all cells containing the target primitive\n      if grid[r_idx, c_idx, primitive] > 0:\n        primitive_locations.append((r_idx, c_idx))\n\n  if not primitive_locations:\n    # Primitive not found on the map\n    return []\n\n  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  CARDINAL_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n  # Mapping from action index to (dr, dc) vector for movement/facing\n  ACTION_VECTORS = {\n      DOWN: (1, 0),    # +row, 0 col (down)\n      UP: (-1, 0),     # -row, 0 col (up)\n      LEFT: (0, -1),   # 0 row, -col (left)\n      RIGHT: (0, 1)    # 0 row, +col (right)\n  }\n\n  # Define obstacles for movement.\n  # These include non-grabbable items and workshops, as per problem description.\n  # The target `primitive` itself is also treated as an obstacle for movement,\n  # as the agent needs to be *adjacent* to it to `USE` it, not on top of it.\n  obstacle_indices = env.world.non_grabbable_indices.union(set(env.world.workshop_indices))\n\n  def is_passable(r, c):\n    \"\"\"Checks if a cell (r, c) is traversable for the agent.\"\"\"\n    # 1. Check bounds\n    if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n      return False\n\n    # 2. Check if the cell is the target primitive's location.\n    # We want to be adjacent to the primitive, not on it.\n    if (r, c) in primitive_locations:\n      return False\n\n    # 3. Check if the cell contains any known obstacle.\n    # An agent cannot step onto a cell if it contains an entity from `obstacle_indices`.\n    for k_idx in obstacle_indices:\n      if grid[r, c, k_idx] > 0:\n        return False # Contains an obstacle\n\n    return True # Cell is traversable\n\n  # BFS initialization: queue stores ((r, c), current_dir, path_actions_so_far)\n  q = collections.deque([((agent_pos[0], agent_pos[1]), agent_dir, [])])\n  # Visited set to avoid cycles: stores ((r, c), current_dir) tuples\n  visited = set([((agent_pos[0], agent_pos[1]), agent_dir)])\n\n  while q:\n    (r, c), current_dir, path = q.popleft()\n\n    # Check if the current position is adjacent to and facing a primitive\n    for pr, pc in primitive_locations:\n      dr, dc = pr - r, pc - c # Vector from current pos to primitive pos\n\n      # If current position (r,c) is adjacent to primitive (pr,pc)\n      if abs(dr) + abs(dc) == 1:\n        needed_dir_vector = (dr, dc)\n        # Check if the agent's current facing direction matches the direction to the primitive\n        if ACTION_VECTORS[current_dir] == needed_dir_vector:\n          # Agent is adjacent and facing the primitive, so we can USE it.\n          return path + [USE]\n\n    # Explore possible movement actions\n    for action_move in CARDINAL_ACTIONS:\n      dr_move, dc_move = ACTION_VECTORS[action_move]\n      new_r, new_c = r + dr_move, c + dc_move\n      new_dir = action_move # Agent's direction changes to the direction of movement\n\n      if is_passable(new_r, new_c):\n        if (((new_r, new_c), new_dir) not in visited):\n          visited.add(((new_r, new_c), new_dir))\n          q.append(((new_r, new_c), new_dir, path + [action_move]))\n\n  # If the queue is exhausted and no path to collect the primitive is found\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:55:02.541629", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Assuming action mappings from CraftLab.action_specs() based on common patterns:\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Define movement deltas for (dx, dy) corresponding to absolute actions\n    # (dx: change in x (width), dy: change in y (height))\n    # Assuming x increases to the right, y increases downwards.\n    MOVE_DELTAS = {\n        ACTION_DOWN: (0, 1),   # Move South (y+1)\n        ACTION_UP: (0, -1),    # Move North (y-1)\n        ACTION_LEFT: (-1, 0),  # Move West (x-1)\n        ACTION_RIGHT: (1, 0)   # Move East (x+1)\n    }\n\n    # Define facing deltas for (dx, dy) based on agent's direction (dir: 0=N, 1=E, 2=S, 3=W)\n    # This is used to determine the cell targeted by the USE action.\n    FACING_DELTAS = {\n        0: (0, -1), # North\n        1: (1, 0),  # East\n        2: (0, 1),  # South\n        3: (-1, 0)  # West\n    }\n\n    # Map movement action to the resulting agent facing direction\n    # This assumes that after moving, the agent's facing direction aligns with the direction of movement.\n    ACTION_TO_DIR_MAPPING = {\n        ACTION_UP: 0,    # Moving North sets facing direction to North (0)\n        ACTION_RIGHT: 1, # Moving East sets facing direction to East (1)\n        ACTION_DOWN: 2,  # Moving South sets facing direction to South (2)\n        ACTION_LEFT: 3   # Moving West sets facing direction to West (3)\n    }\n\n    current_state = env._current_state\n    \n    # 1. Check if the primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions and current agent position/direction\n    WIDTH, HEIGHT, N_KINDS = current_state.grid.shape\n    start_x, start_y = current_state.pos\n    start_dir = current_state.dir\n\n    # 2. Find all locations on the grid where the primitive exists\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            # Check if this cell contains the desired primitive\n            if current_state.grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return [] # Primitive not found anywhere on the grid\n\n    # 3. BFS to find the shortest path to a location from which the primitive can be collected\n    # BFS state: (current_x, current_y, current_facing_dir, path_taken)\n    q = collections.deque()\n    visited = set() # To store (x, y, facing_dir) to avoid cycles and redundant paths\n\n    # Initial state\n    q.append((start_x, start_y, start_dir, []))\n    visited.add((start_x, start_y, start_dir))\n\n    while q:\n        x, y, current_facing_dir, path = q.popleft()\n\n        # Try to use (collect) from the current position\n        # Calculate the target cell if USE action is taken from current (x, y) and facing direction\n        target_dx, target_dy = FACING_DELTAS[current_facing_dir]\n        target_x, target_y = x + target_dx, y + target_dy\n\n        # Check if the target cell is within grid bounds\n        if 0 <= target_x < WIDTH and 0 <= target_y < HEIGHT:\n            # Check if the target cell contains the primitive\n            if current_state.grid[target_x, target_y, primitive] > 0:\n                # Found a path to collect the primitive!\n                return path + [ACTION_USE]\n\n        # Explore possible movement actions (UP, DOWN, LEFT, RIGHT)\n        for action_move in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n            dx, dy = MOVE_DELTAS[action_move]\n            new_x, new_y = x + dx, y + dy\n\n            # Check if new position is within grid bounds\n            if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n                # For simplicity, we assume movement is generally possible to any empty cell.\n                # In a more complex scenario, one might check for impassable terrain.\n                # The `CraftState.step` method would internally handle collisions.\n\n                new_facing_dir = ACTION_TO_DIR_MAPPING[action_move]\n\n                # If this (position, direction) state has not been visited before\n                if (new_x, new_y, new_facing_dir) not in visited:\n                    visited.add((new_x, new_y, new_facing_dir))\n                    q.append((new_x, new_y, new_facing_dir, path + [action_move]))\n    \n    # If the queue becomes empty and no path to collect the primitive was found\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:55:03.494086", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  # Assign integer values to action names for clarity\n  ACTIONS = {\n      'UP': action_map['UP'],\n      'DOWN': action_map['DOWN'],\n      'LEFT': action_map['LEFT'],\n      'RIGHT': action_map['RIGHT'],\n      'USE': action_map['USE'],\n  }\n  # Define movement deltas for BFS corresponding to each action\n  MOVE_DELTAS = {\n      ACTIONS['UP']: (-1, 0),\n      ACTIONS['DOWN']: (1, 0),\n      ACTIONS['LEFT']: (0, -1),\n      ACTIONS['RIGHT']: (0, 1),\n  }\n\n  # Access the current state from the CraftLab environment\n  # CraftLab holds an internal CraftState instance as _current_state\n  current_state = env._current_state\n  grid = current_state.grid\n  agent_pos = current_state.pos  # Agent's current (row, col) position\n  inventory = current_state.inventory\n  height, width, _ = grid.shape\n\n  # 1. Check if the primitive is already in the inventory\n  if inventory[primitive] > 0:\n    return []  # Already collected, no actions needed\n\n  # 2. Find all locations on the grid where the primitive exists\n  primitive_locations = []\n  for r in range(height):\n    for c in range(width):\n      if grid[r, c, primitive] == 1:\n        primitive_locations.append((r, c))\n\n  if not primitive_locations:\n    return []  # Primitive not found on the grid\n\n  # 3. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any primitive location.\n  #    The BFS queue stores tuples of (current_position, path_taken_so_far)\n  queue = collections.deque([(agent_pos, [])])\n  #    The visited set stores (row, col) tuples to avoid cycles and redundant paths\n  visited = {agent_pos}\n\n  target_path = None  # To store the shortest path once found\n\n  # Get indices of non-grabbable/impassable entities from the CraftWorld\n  # Agent usually cannot move into these cells unless it's the target itself.\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n\n  while queue:\n    (r, c), path = queue.popleft()\n\n    # If the current position is one of the primitive locations,\n    # we've found a shortest path.\n    if (r, c) in primitive_locations:\n      target_path = path\n      break  # Exit BFS, as we found the shortest path\n\n    # Explore all possible adjacent moves (UP, DOWN, LEFT, RIGHT)\n    for action_val, (dr, dc) in MOVE_DELTAS.items():\n      nr, nc = r + dr, c + dc  # Calculate new row and column\n\n      # Check if the new position is within grid boundaries\n      if 0 <= nr < height and 0 <= nc < width:\n        # Check if the new cell is traversable (not an obstacle)\n        is_obstacle = False\n        # Get all item kinds present at the potential new cell (nr, nc)\n        kinds_at_cell = np.where(grid[nr, nc] == 1)[0]\n        for k_idx in kinds_at_cell:\n          # If a kind at the cell is non-grabbable and it's NOT the primitive itself,\n          # then it's an obstacle. We assume the agent can move onto the primitive cell\n          # to collect it.\n          if k_idx in non_grabbable_indices and k_idx != primitive:\n            is_obstacle = True\n            break\n\n        # If it's not an obstacle and hasn't been visited yet, add to queue\n        if not is_obstacle and (nr, nc) not in visited:\n          visited.add((nr, nc))\n          queue.append(((nr, nc), path + [action_val]))\n\n  # If no path was found (e.g., primitive is in an enclosed area)\n  if target_path is None:\n    return []\n\n  # Once at the primitive's location, use the 'USE' action to collect it.\n  # This assumes 'USE' interacts with the cell the agent is currently on.\n  return target_path + [ACTIONS['USE']]", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:57:01.361755", "function_name": "collect", "function_body": "    # Agent actions\n    ACTIONS = {'DOWN': 0, 'UP': 1, 'LEFT': 2, 'RIGHT': 3, 'USE': 4}\n\n    # Agent directions (from CraftState.dir)\n    # These are typically: 0: NORTH, 1: EAST, 2: SOUTH, 3: WEST\n    # Map agent_dir to (dx, dy) for moving forward\n    DIR_VECTORS = {\n        0: (0, -1), # NORTH: (x, y-1)\n        1: (1, 0),  # EAST:  (x+1, y)\n        2: (0, 1),  # SOUTH: (x, y+1)\n        3: (-1, 0), # WEST:  (x-1, y)\n    }\n\n    # Map (dx, dy) to agent_dir for facing a target\n    INV_DIR_VECTORS = {\n        (0, -1): 0, # NORTH\n        (1, 0): 1,  # EAST\n        (0, 1): 2,  # SOUTH\n        (-1, 0): 3, # WEST\n    }\n\n    def get_turn_actions(current_dir, target_dir):\n        \"\"\"Calculates actions to turn from current_dir to target_dir.\"\"\"\n        actions = []\n        # Difference modulo 4: (target - current + 4) % 4\n        # 0: no turn\n        # 1: right turn\n        # 2: 180 turn (two rights or two lefts)\n        # 3: left turn\n\n        diff = (target_dir - current_dir + 4) % 4\n        if diff == 1: # Turn Right\n            actions.append(ACTIONS['RIGHT'])\n        elif diff == 3: # Turn Left\n            actions.append(ACTIONS['LEFT'])\n        elif diff == 2: # 180 degree turn, take two rights\n            actions.append(ACTIONS['RIGHT'])\n            actions.append(ACTIONS['RIGHT'])\n        return actions\n\n    # Get initial state directly from the CraftState instance within env\n    current_state = env._current_state \n\n    # 1. Check if primitive is already collected\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n    \n    # Get agent's current position and direction\n    agent_x, agent_y = current_state.pos\n    agent_dir = current_state.dir # 0:N, 1:E, 2:S, 3:W\n\n    # Get non-grabbable indices to identify obstacles (e.g., water, workshop)\n    non_grabbable_indices = env.world.non_grabbable_indices \n\n    # 2. Find primitive locations on the grid\n    # np.argwhere returns (row, col) indices where condition is true.\n    primitive_locations_rc = np.argwhere(grid[:, :, primitive] == 1)\n\n    if len(primitive_locations_rc) == 0:\n        # Primitive not found on the map\n        return []\n\n    # Convert (row, col) to (x, y) (col, row) for consistency with CraftState.pos\n    primitive_target_coords = []\n    for r, c in primitive_locations_rc:\n        primitive_target_coords.append((c, r))\n\n    # Find the closest target primitive location using Manhattan distance\n    min_dist = float('inf')\n    target_primitive_pos = None\n    for tx, ty in primitive_target_coords:\n        dist = abs(agent_x - tx) + abs(agent_y - ty)\n        if dist < min_dist:\n            min_dist = dist\n            target_primitive_pos = (tx, ty)\n\n    if target_primitive_pos is None: # Should not happen if primitive_locations_rc is not empty\n        return [] \n\n    # 3. BFS to find path to an adjacent cell of the primitive\n    q = collections.deque()\n    # Queue stores: (current_x, current_y, list_of_coordinates_in_path)\n    q.append((agent_x, agent_y, []))\n    \n    # Visited set: (x, y) to avoid loops in pathfinding\n    visited = set()\n    visited.add((agent_x, agent_y))\n\n    path_to_adj_coords = []\n    target_adj_x, target_adj_y = None, None\n\n    # Possible cardinal moves (dx, dy)\n    move_deltas = [(0, -1), (0, 1), (-1, 0), (1, 0)] # North, South, West, East (relative to grid)\n\n    while q:\n        curr_x, curr_y, current_coord_path = q.popleft()\n\n        # Check if current cell is adjacent to the target primitive\n        if abs(curr_x - target_primitive_pos[0]) + abs(curr_y - target_primitive_pos[1]) == 1:\n            path_to_adj_coords = current_coord_path # This path leads to an adjacent cell\n            target_adj_x, target_adj_y = curr_x, curr_y\n            break\n\n        for dx, dy in move_deltas:\n            next_x, next_y = curr_x + dx, curr_y + dy\n\n            # Check bounds\n            if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                continue\n            \n            # Check if visited\n            if (next_x, next_y) in visited:\n                continue\n\n            # Check for obstacles (any non-grabbable entity, but the primitive itself is not an obstacle)\n            is_obstacle = False\n            for kind_idx in non_grabbable_indices:\n                if kind_idx == primitive: # The primitive itself at next_x,next_y is not an obstacle to moving onto it if it's the target\n                    continue\n                if grid[next_x, next_y, kind_idx] == 1: # Is there a non-grabbable item (that isn't our primitive) here?\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n            \n            # If valid and not visited, add to queue\n            visited.add((next_x, next_y))\n            q.append((next_x, next_y, current_coord_path + [(next_x, next_y)]))\n\n    if not path_to_adj_coords:\n        return [] # No path found to an adjacent cell\n\n    # 4. Convert path of coordinates to actions (movement and turns)\n    final_actions = []\n    current_x, current_y = agent_x, agent_y\n    current_dir = agent_dir\n\n    # Prepend the agent's start position to the coordinate path for easier iteration\n    full_coord_path = [(agent_x, agent_y)] + path_to_adj_coords\n\n    for i in range(len(full_coord_path) - 1):\n        p_curr_x, p_curr_y = full_coord_path[i]\n        p_next_x, p_next_y = full_coord_path[i+1]\n\n        # Determine target direction to face the next position\n        dx, dy = p_next_x - p_curr_x, p_next_y - p_curr_y\n        \n        target_dir_for_move = INV_DIR_VECTORS.get((dx, dy))\n        if target_dir_for_move is None:\n            # This should not happen for a valid orthogonal path\n            continue \n\n        # Add turn actions if necessary\n        final_actions.extend(get_turn_actions(current_dir, target_dir_for_move))\n        current_dir = target_dir_for_move # Update current direction after turns\n\n        # Add forward movement action (UP)\n        final_actions.append(ACTIONS['UP'])\n        current_x, current_y = p_next_x, p_next_y # Update current position\n\n    # 5. Face the primitive and USE it\n    # We are now at (target_adj_x, target_adj_y), which is adjacent to target_primitive_pos\n    # Determine the direction to face the primitive from this adjacent cell\n    dx_final = target_primitive_pos[0] - target_adj_x\n    dy_final = target_primitive_pos[1] - target_adj_y\n    \n    target_dir_for_use = INV_DIR_VECTORS.get((dx_final, dy_final))\n    if target_dir_for_use is not None:\n        final_actions.extend(get_turn_actions(current_dir, target_dir_for_use))\n        # No need to update current_dir, we are done with movement\n    \n    final_actions.append(ACTIONS['USE'])\n\n    return final_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:57:02.331670", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  grid_height, grid_width = grid.shape[:2]\n  # Indices of entities that cannot be walked through (obstacles for BFS)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Actions (using constants from env_factory)\n  UP_ACTION = env_factory.UP\n  DOWN_ACTION = env_factory.DOWN\n  LEFT_ACTION = env_factory.LEFT\n  RIGHT_ACTION = env_factory.RIGHT\n  USE_ACTION = env_factory.USE\n\n  # Directions (using constants from env_factory for agent's internal state)\n  NORTH_DIR = env_factory.NORTH\n  EAST_DIR = env_factory.EAST\n  SOUTH_DIR = env_factory.SOUTH\n  WEST_DIR = env_factory.WEST\n\n  # Mapping from movement action to (delta_row, delta_col) and resulting agent direction\n  # When an agent executes a movement action, its internal direction is updated to reflect the direction of movement.\n  MOVE_ACTION_TO_DATA = {\n      UP_ACTION: ((-1, 0), NORTH_DIR),\n      DOWN_ACTION: ((1, 0), SOUTH_DIR),\n      LEFT_ACTION: ((0, -1), WEST_DIR),\n      RIGHT_ACTION: ((0, 1), EAST_DIR),\n  }\n\n  def _is_obstacle(r, c, grid_data, non_grabbable_idx, h, w):\n      \"\"\"\n      Checks if a cell (r, c) is considered an obstacle for movement.\n      An obstacle is defined as being out of bounds or containing any non-grabbable entity.\n      \"\"\"\n      if not (0 <= r < h and 0 <= c < w):\n          return True  # Out of bounds\n      \n      # Check if the cell contains any entity marked as non-grabbable\n      for k_idx in non_grabbable_idx:\n          if grid_data[r, c, k_idx] > 0:\n              return True  # Contains a non-grabbable entity (e.g., water, tall stone)\n      return False\n\n\n  def _get_target_facing_direction(agent_pos, target_pos):\n      \"\"\"\n      Calculates the direction an agent at `agent_pos` needs to face to look directly at `target_pos`.\n      Returns the corresponding direction constant (e.g., NORTH_DIR) or -1 if not directly adjacent.\n      \"\"\"\n      ar, ac = agent_pos\n      tr, tc = target_pos\n\n      dr, dc = tr - ar, tc - ac\n\n      if dr == -1 and dc == 0:  # Target is North of agent\n          return NORTH_DIR\n      if dr == 1 and dc == 0:   # Target is South of agent\n          return SOUTH_DIR\n      if dr == 0 and dc == 1:   # Target is East of agent\n          return EAST_DIR\n      if dr == 0 and dc == -1:  # Target is West of agent\n          return WEST_DIR\n      return -1  # Not directly adjacent or an invalid relative position\n\n\n  # This function assumes 'primitive' is the integer index of a resource node\n  # (e.g., 'tree', 'stone', 'water') that needs to be 'USE'd to collect items.\n\n  # 1. Find all locations of the target primitive resource node on the grid\n  primitive_locations = []\n  for r in range(grid_height):\n      for c in range(grid_width):\n          # Check if the cell contains the specified primitive kind (resource node)\n          if grid[r, c, primitive] > 0:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      # If the primitive resource node is not found on the map, no actions can be planned.\n      return []\n\n  # 2. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    The BFS state includes: (current_position_tuple, current_direction_int, list_of_actions_taken)\n  q = deque([(current_state.pos, current_state.dir, [])])\n  # Visited set tracks (position_tuple, direction_int) to prevent cycles and redundant paths\n  visited = {(current_state.pos, current_state.dir)}\n\n  while q:\n      curr_pos, curr_dir, path = q.popleft()\n      curr_r, curr_c = curr_pos\n\n      # Check if the current state (position and direction) allows for collection\n      # This means being adjacent to a primitive_location and facing it correctly.\n      for target_r, target_c in primitive_locations:\n          # Determine the direction the agent needs to face from its current position\n          # to target the primitive node.\n          required_facing_dir = _get_target_facing_direction(curr_pos, (target_r, target_c))\n\n          # If the agent is directly adjacent to a target node AND is facing it,\n          # then we can perform the USE action.\n          if required_facing_dir != -1 and curr_dir == required_facing_dir:\n              # Found a path to a usable primitive node. Append the USE action and return.\n              return path + [USE_ACTION]\n\n      # If not at a \"use\"able state, explore possible next moves (UP, DOWN, LEFT, RIGHT)\n      for action in [UP_ACTION, DOWN_ACTION, LEFT_ACTION, RIGHT_ACTION]:\n          (dr, dc), new_dir = MOVE_ACTION_TO_DATA[action]\n          next_r, next_c = curr_r + dr, curr_c + dc\n          next_pos = (next_r, next_c)\n\n          # Check if the next cell is an obstacle or out of bounds\n          if _is_obstacle(next_r, next_c, grid, non_grabbable_indices, grid_height, grid_width):\n              continue  # Cannot move into this cell\n\n          # If this (position, direction) state has not been visited, add it to the queue\n          if (next_pos, new_dir) not in visited:\n              visited.add((next_pos, new_dir))\n              new_path = path + [action]\n              q.append((next_pos, new_dir, new_path))\n\n  # If the queue becomes empty and no path to a usable primitive was found, return an empty list.\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:58:31.489049", "function_name": "collect", "function_body": "    import collections\n\n    # Constants for actions, mapping to integers as per CraftLab.action_specs\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    ACTION_TO_DELTAS = {\n        DOWN: (1, 0),  # (delta_row, delta_col)\n        UP: (-1, 0),\n        LEFT: (0, -1),\n        RIGHT: (0, 1)\n    }\n\n    DELTAS_TO_DIR = {\n        (1, 0): DOWN,\n        (-1, 0): UP,\n        (0, -1): LEFT,\n        (0, 1): RIGHT\n    }\n\n    # 1. Get current state information from the CraftLab environment\n    current_state = env._current_state # Access the current CraftState instance\n\n    # Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    grid = current_state.grid\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir # Agent's starting facing direction\n    \n    WIDTH, HEIGHT, n_kinds = grid.shape\n\n    # Identify blocking items from world configuration\n    # These are entities that the agent cannot move through.\n    world = env.world\n    blocking_indices = set()\n    blocking_indices.update(world.non_grabbable_indices)\n    blocking_indices.update(world.workshop_indices)\n    if world.water_index is not None:\n        blocking_indices.add(world.water_index)\n\n    # 2. Find all locations of the `primitive` on the grid\n    primitive_locations = []\n    for r in range(WIDTH):\n        for c in range(HEIGHT):\n            # Check if the cell contains the target primitive\n            if grid[r, c, primitive] == 1:\n                # Ensure the primitive itself isn't in blocking_indices by accident,\n                # though for 'primitives' this should typically be false as they are grabbable.\n                if primitive not in blocking_indices: \n                    primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the map or is treated as blocking\n\n    # 3. Pathfinding using Breadth-First Search (BFS)\n    # BFS state: ((row, col), agent_direction)\n    # The agent's direction is crucial for the 'USE' action.\n    # We assume that moving (UP, DOWN, LEFT, RIGHT) sets the agent's facing direction\n    # to the direction of that movement.\n\n    queue = collections.deque([((initial_pos[0], initial_pos[1]), initial_dir, [])]) # (current_pos, current_dir, path_actions_so_far)\n    visited = set() # Stores ((row, col), agent_direction) tuples to avoid redundant exploration\n    visited.add(((initial_pos[0], initial_pos[1]), initial_dir))\n\n    while queue:\n        (curr_r, curr_c), curr_dir, path_actions = queue.popleft()\n\n        # Check if the current position is adjacent to a primitive and the agent is facing it correctly\n        for pr, pc in primitive_locations:\n            dr, dc = pr - curr_r, pc - curr_c\n            \n            # Check if (pr, pc) is an immediate cardinal neighbor (Manhattan distance of 1)\n            if abs(dr) + abs(dc) == 1: \n                required_dir_to_face = DELTAS_TO_DIR.get((dr, dc))\n                \n                # If it's a valid cardinal direction and the agent is facing it\n                if required_dir_to_face is not None and curr_dir == required_dir_to_face:\n                    # Found a path to an adjacent cell, facing the primitive.\n                    # Add the 'USE' action and return the complete sequence of actions.\n                    return path_actions + [USE]\n\n        # Explore possible move actions (DOWN, UP, LEFT, RIGHT)\n        for action_move, (dr_move, dc_move) in ACTION_TO_DELTAS.items():\n            next_r, next_c = curr_r + dr_move, curr_c + dc_move\n            next_dir = action_move # Moving sets the agent's new facing direction\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n                continue\n\n            # Check if the next cell contains any blocking item\n            is_blocking = False\n            for k in range(n_kinds):\n                if grid[next_r, next_c, k] == 1 and k in blocking_indices:\n                    is_blocking = True\n                    break\n            \n            # Also, ensure the agent does not try to move onto the primitive itself,\n            # as the goal is to interact with it from an adjacent cell.\n            if (next_r, next_c) in primitive_locations:\n                is_blocking = True # Treat primitive location as blocked for movement purposes\n\n            if is_blocking:\n                continue # Skip this move if the next cell is blocked\n\n            # Check if this (position, direction) state has already been visited\n            next_state = ((next_r, next_c), next_dir)\n            if next_state not in visited:\n                visited.add(next_state)\n                queue.append((next_state, path_actions + [action_move]))\n\n    # If the BFS completes without finding a path to collect the primitive, return an empty list.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:58:31.559415", "function_name": "collect", "function_body": "    import collections\n\n    # Get current state from the environment\n    # The CraftLab wrapper holds the current state in _current_state\n    # Accessing _current_state directly as it's an internal helper attribute.\n    current_state = env._current_state\n    \n    current_pos = current_state.pos\n    grid = current_state.grid\n    grid_width, grid_height, _ = grid.shape\n    \n    # Check if agent is already in a position to pick up the primitive\n    if current_state.next_to(primitive):\n        return [env_factory.ACTIONS.USE]\n\n    # Find all potential target positions for the agent.\n    # These are positions (ax, ay) from which the agent can be \"next_to\" the primitive.\n    target_agent_positions = set()\n    \n    # Identify all grid cells containing the primitive\n    primitive_locations = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if grid[x, y, primitive] == 1:\n                primitive_locations.append((x, y))\n\n    # For each location of the primitive, add its 3x3 neighborhood cells to target_agent_positions\n    # These are valid places for the agent to stand to be \"next_to\" the primitive\n    for item_x, item_y in primitive_locations:\n        for dx in [-1, 0, 1]:\n            for dy in [-1, 0, 1]:\n                ax, ay = item_x + dx, item_y + dy\n                # Ensure the potential agent position is within grid boundaries\n                if 0 <= ax < grid_width and 0 <= ay < grid_height:\n                    target_agent_positions.add((ax, ay))\n    \n    # If no primitive is found on the map, return an empty path\n    if not target_agent_positions:\n        return []\n\n    # Define movement actions and their corresponding (dx, dy) offsets for BFS\n    # (dx, dy) where dx changes column (x-coordinate) and dy changes row (y-coordinate)\n    # Assumes agent's pos is (x, y) where x is horizontal, y is vertical\n    DELTA_POS = {\n        env_factory.ACTIONS.DOWN: (0, 1),   # Move down: y + 1\n        env_factory.ACTIONS.UP: (0, -1),    # Move up: y - 1\n        env_factory.ACTIONS.LEFT: (-1, 0),  # Move left: x - 1\n        env_factory.ACTIONS.RIGHT: (1, 0)   # Move right: x + 1\n    }\n\n    # BFS for finding the shortest path to any target_agent_position\n    # Queue stores tuples: ((current_x, current_y), [list_of_actions_to_reach_here])\n    q = collections.deque([(current_pos, [])]) \n    \n    # Keep track of visited positions to prevent cycles and redundant exploration\n    visited = {current_pos}\n\n    while q:\n        (x, y), path_so_far = q.popleft()\n\n        # If the current position is one of the desired target positions, we've found a path\n        if (x, y) in target_agent_positions:\n            # Append the USE action as the final step to collect the primitive\n            return path_so_far + [env_factory.ACTIONS.USE]\n\n        # Explore all possible movement actions from the current position\n        for action, (dx, dy) in DELTA_POS.items():\n            next_x, next_y = x + dx, y + dy\n            next_pos = (next_x, next_y)\n\n            # Check if the next position is within grid boundaries and hasn't been visited\n            # Assuming all grid cells are traversable unless specified otherwise for movement.\n            if (0 <= next_x < grid_width and\n                0 <= next_y < grid_height and\n                next_pos not in visited):\n                \n                visited.add(next_pos)\n                q.append((next_pos, path_so_far + [action]))\n    \n    # If the BFS completes and no path to any target_agent_position is found,\n    # it means the primitive is unreachable (e.g., trapped behind non-traversable blocks,\n    # or the map is disconnected, or no primitive exists).\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:00:27.401231", "function_name": "collect", "function_body": "    # Constants for actions (local to the function as per constraints)\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    # Map (dx, dy) to cardinal direction action\n    # This maps the relative position of a target cell to the action that moves the agent\n    # into that cell and makes the agent face that direction.\n    _DELTA_TO_CARDINAL_ACTION = {\n        (0, 1): _DOWN,\n        (0, -1): _UP,\n        (-1, 0): _LEFT,\n        (1, 0): _RIGHT\n    }\n\n    # Map direction index to (dx, dy)\n    # This maps an action (which sets facing direction) to its corresponding (dx, dy) vector.\n    _DIR_TO_DELTA = {\n        _DOWN: (0, 1),\n        _UP: (0, -1),\n        _LEFT: (-1, 0),\n        _RIGHT: (1, 0)\n    }\n\n    def _manhattan_distance(pos1, pos2):\n        \"\"\"Calculates the Manhattan distance between two (x, y) positions.\"\"\"\n        return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n    actions_taken = []\n    max_steps = 200 # A safety limit to prevent infinite loops in complex scenarios\n\n    for step_count in range(max_steps):\n        # Get current observations from the environment\n        obs = env.observations()\n        current_inventory = obs['features_dict']['inventory']\n\n        # Check if the primitive is already collected\n        if current_inventory[primitive] > 0:\n            break # Goal achieved, exit loop\n\n        current_pos = tuple(obs['features_dict']['pos']) # Agent's current (x, y) position\n        current_grid = obs['features_dict']['features_global'] # Full grid state\n        grid_width, grid_height, _ = current_grid.shape\n\n        action_to_perform = None\n\n        # --- Phase 1: Check for primitive in cardinal neighborhood and attempt to USE ---\n        cardinal_primitive_pos = None\n        target_action_to_face = None\n\n        # Iterate over possible cardinal directions relative to the agent's position\n        for rel_delta, action_val in _DELTA_TO_CARDINAL_ACTION.items():\n            nx, ny = current_pos[0] + rel_delta[0], current_pos[1] + rel_delta[1]\n            \n            # Check if the neighbor cell is within grid boundaries\n            if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                # Check if the primitive is in this neighbor cell\n                if current_grid[nx, ny, primitive] == 1:\n                    cardinal_primitive_pos = (nx, ny)\n                    # This action moves the agent to nx, ny AND sets its direction\n                    # towards that cell (making it face the primitive if it's still there).\n                    target_action_to_face = action_val \n                    break # Found a primitive in a cardinal direction\n\n        if cardinal_primitive_pos:\n            # Step 1: Move towards the primitive. This also sets the agent's facing direction.\n            _, _, new_obs = env.step(target_action_to_face)\n            actions_taken.append(target_action_to_face)\n\n            # Step 2: Use the item. This action should pick up the primitive from the cell\n            # the agent just moved into (or is now facing).\n            reward, done, final_obs = env.step(_USE)\n            actions_taken.append(_USE)\n            \n            # Re-check inventory immediately after attempting to USE\n            if final_obs['features_dict']['inventory'][primitive] > 0:\n                break # Primitive collected, exit loop\n            else:\n                # If USE failed (e.g., item was removed, not grabbable, etc.),\n                # continue to the next iteration to find another or retry.\n                continue\n\n        # --- Phase 2: If primitive not collected and not in cardinal neighborhood, move towards it ---\n        \n        # Find all locations of the primitive on the entire grid\n        primitive_locations = []\n        for x in range(grid_width):\n            for y in range(grid_height):\n                if current_grid[x, y, primitive] == 1:\n                    primitive_locations.append((x, y))\n\n        if not primitive_locations:\n            # No primitive found anywhere on the grid, cannot collect.\n            # This implies an unachievable goal or a scenario without the item.\n            break # Exit loop, returning the incomplete action sequence\n\n        # Find the closest primitive location using Manhattan distance\n        closest_primitive_pos = None\n        min_dist = float('inf')\n        for p_pos in primitive_locations:\n            dist = _manhattan_distance(current_pos, p_pos)\n            if dist < min_dist:\n                min_dist = dist\n                closest_primitive_pos = p_pos\n\n        # Determine the next movement step towards the closest primitive using a greedy approach\n        dx = closest_primitive_pos[0] - current_pos[0]\n        dy = closest_primitive_pos[1] - current_pos[1]\n        \n        chosen_move_action = None\n\n        # Prioritize movement along the dimension with the larger absolute difference.\n        # If that path is blocked, try the other dimension.\n        if abs(dx) >= abs(dy): # Prioritize X-axis movement\n            if dx > 0: chosen_move_action = _RIGHT\n            elif dx < 0: chosen_move_action = _LEFT\n            \n            # Check if the chosen move is valid (within bounds and not into an obstacle like water)\n            if chosen_move_action is not None:\n                target_x, target_y = current_pos[0] + _DIR_TO_DELTA[chosen_move_action][0], current_pos[1] + _DIR_TO_DELTA[chosen_move_action][1]\n                if not (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n                        (env.world.water_index is None or current_grid[target_x, target_y, env.world.water_index] == 0)):\n                    # If primary move (X-axis) is blocked, try Y-axis\n                    if dy > 0: chosen_move_action = _DOWN\n                    elif dy < 0: chosen_move_action = _UP\n                    else: chosen_move_action = None # No secondary move if dy is 0\n                    \n                    if chosen_move_action is not None: # Check secondary move validity\n                        target_x, target_y = current_pos[0] + _DIR_TO_DELTA[chosen_move_action][0], current_pos[1] + _DIR_TO_DELTA[chosen_move_action][1]\n                        if not (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n                                (env.world.water_index is None or current_grid[target_x, target_y, env.world.water_index] == 0)):\n                            chosen_move_action = None # Both primary and secondary moves blocked\n        else: # Prioritize Y-axis movement (or if abs(dy) == abs(dx))\n            if dy > 0: chosen_move_action = _DOWN\n            elif dy < 0: chosen_move_action = _UP\n            \n            # Check if the chosen move is valid\n            if chosen_move_action is not None:\n                target_x, target_y = current_pos[0] + _DIR_TO_DELTA[chosen_move_action][0], current_pos[1] + _DIR_TO_DELTA[chosen_move_action][1]\n                if not (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n                        (env.world.water_index is None or current_grid[target_x, target_y, env.world.water_index] == 0)):\n                    # If primary move (Y-axis) is blocked, try X-axis\n                    if dx > 0: chosen_move_action = _RIGHT\n                    elif dx < 0: chosen_move_action = _LEFT\n                    else: chosen_move_action = None # No secondary move if dx is 0\n\n                    if chosen_move_action is not None: # Check secondary move validity\n                        target_x, target_y = current_pos[0] + _DIR_TO_DELTA[chosen_move_action][0], current_pos[1] + _DIR_TO_DELTA[chosen_move_action][1]\n                        if not (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n                                (env.world.water_index is None or current_grid[target_x, target_y, env.world.water_index] == 0)):\n                            chosen_move_action = None # Both primary and secondary moves blocked\n\n        # Perform the chosen move action\n        if chosen_move_action is not None:\n            _, _, _ = env.step(chosen_move_action)\n            actions_taken.append(chosen_move_action)\n        else:\n            # Agent is stuck or cannot reach the primitive with simple greedy moves.\n            break # Exit loop\n\n    return actions_taken", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:00:27.479852", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants based on CraftLab.action_specs()\n    _ACTION_DOWN = 0\n    _ACTION_UP = 1\n    _ACTION_LEFT = 2\n    _ACTION_RIGHT = 3\n    _ACTION_USE = 4\n\n    # Mapping agent's internal `dir` (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT) to (dx, dy) for _ACTION_USE target\n    # These arrays assume the internal `dir` integer directly corresponds to (DOWN, UP, LEFT, RIGHT)\n    # where:\n    # 0 (DOWN) means facing positive Y (downwards on a typical grid)\n    # 1 (UP) means facing negative Y (upwards)\n    # 2 (LEFT) means facing negative X (leftwards)\n    # 3 (RIGHT) means facing positive X (rightwards)\n    _FACING_DX = [0, 0, -1, 1]  # dx for dir indices [0, 1, 2, 3]\n    _FACING_DY = [1, -1, 0, 0]  # dy for dir indices [0, 1, 2, 3]\n\n    initial_state = env._current_state # Access CraftState directly for planning\n\n    # Queue for BFS: stores tuples of (current_state, path_to_reach_current_state)\n    queue = collections.deque([(initial_state, [])])\n    \n    # Visited set: stores tuples of (position_tuple, direction_int, inventory_tuple)\n    # Inventory is a 1D numpy array, so convert to tuple for hashing.\n    visited = set([(initial_state.pos, initial_state.dir, tuple(initial_state.inventory))])\n\n    max_path_length = 200 # A heuristic limit to prevent excessively long searches\n\n    # Get grid dimensions for boundary checks (grid is of shape (WIDTH, HEIGHT, n_kinds))\n    grid_width, grid_height, _ = initial_state.grid.shape\n\n    while queue:\n        current_state, path_so_far = queue.popleft()\n\n        # Check if the primitive has been collected in the current state's inventory\n        if current_state.inventory[primitive] > 0:\n            return path_so_far\n\n        # Prune paths that are too long to avoid excessive computation\n        if len(path_so_far) >= max_path_length:\n            continue\n\n        # Explore movement actions (DOWN, UP, LEFT, RIGHT)\n        for action in [_ACTION_DOWN, _ACTION_UP, _ACTION_LEFT, _ACTION_RIGHT]:\n            # Simulate the step to get the next state\n            # CraftState.step returns a new state object, which is ideal for BFS\n            _reward, next_state = current_state.step(action)\n            \n            # Create a hashable representation of the next state\n            state_hash = (next_state.pos, next_state.dir, tuple(next_state.inventory))\n\n            # If this state has not been visited, add it to the queue\n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((next_state, path_so_far + [action]))\n\n        # Explore the USE action\n        # Determine the cell directly in front of the agent based on its current facing direction\n        agent_x, agent_y = current_state.pos\n        facing_dir_idx = current_state.dir # The agent's internal direction (0, 1, 2, 3)\n\n        target_x = agent_x + _FACING_DX[facing_dir_idx]\n        target_y = agent_y + _FACING_DY[facing_dir_idx]\n\n        # Check if the target cell is within grid bounds\n        if 0 <= target_x < grid_width and 0 <= target_y < grid_height:\n            # Check if the desired primitive is present in the cell the agent is facing\n            if current_state.grid[target_x, target_y, primitive] == 1:\n                # Simulate the USE action\n                _reward, next_state = current_state.step(_ACTION_USE)\n                \n                # If using the item successfully collected the primitive, this path is complete\n                if next_state.inventory[primitive] > 0:\n                    return path_so_far + [_ACTION_USE]\n                \n                # Even if not immediately collected (e.g., requires multiple uses, or is a crafting station),\n                # if it's a new state, add it to the queue for further exploration.\n                state_hash = (next_state.pos, next_state.dir, tuple(next_state.inventory))\n                if state_hash not in visited:\n                    visited.add(state_hash)\n                    queue.append((next_state, path_so_far + [_ACTION_USE]))\n\n    # If the queue is exhausted and the primitive was not found or collected\n    # (e.g., it's unreachable or doesn't exist)\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:01:59.148741", "function_name": "collect", "function_body": "    current_state = env._current_state\n\n    # 1. Check if the primitive is already collected\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid_width, grid_height, _ = current_state.grid.shape\n    \n    # Identify non-traversable entities for pathfinding\n    obstacles_indices = set()\n    if hasattr(env, 'world'):\n        if hasattr(env.world, 'non_grabbable_indices'):\n            obstacles_indices.update(env.world.non_grabbable_indices)\n        # Add water and stone indices to obstacles if they exist, as they are typically impassable.\n        if hasattr(env.world, 'water_index'):\n            obstacles_indices.add(env.world.water_index)\n        if hasattr(env.world, 'stone_index'):\n            obstacles_indices.add(env.world.stone_index)\n\n    def is_traversable(x, y):\n        # Check bounds\n        if not (0 <= x < grid_width and 0 <= y < grid_height):\n            return False\n        # Check if cell contains any obstacle\n        # Iterate over all kinds at (x,y) to see if it's an obstacle\n        for k_idx in obstacles_indices:\n            if current_state.grid[x, y, k_idx] == 1:\n                return False # Cell (x,y) contains an obstacle item\n        return True # Traversable\n\n    # 2. Find all locations of the primitive on the grid\n    primitive_locations = [] # List of (px, py) tuples where the primitive is located\n    for px in range(grid_width):\n        for py in range(grid_height):\n            if current_state.grid[px, py, primitive] == 1:\n                primitive_locations.append((px, py))\n\n    if not primitive_locations:\n        return [] # Primitive not found on the grid\n\n    # 3. BFS to find the shortest path to a traversable cell adjacent to a primitive\n    \n    # Action constants for readability within the function\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Directions for movement (col_delta, row_delta)\n    DELTAS = {\n        UP: (0, -1),\n        DOWN: (0, 1),\n        LEFT: (-1, 0),\n        RIGHT: (1, 0),\n    }\n\n    queue = collections.deque([(current_state.pos, [])])  # (current_coordinates, list_of_actions_to_reach_here)\n    visited = {current_state.pos}\n    \n    best_path_to_adjacent = None\n    \n    while queue:\n        (x, y), actions = queue.popleft()\n\n        # Check if current cell (x,y) is already cardinally adjacent to any primitive\n        for px, py in primitive_locations:\n            # A cell (x,y) is cardinally adjacent to (px,py) if one coordinate is the same and\n            # the other differs by exactly 1.\n            if (abs(x - px) == 1 and y == py) or (abs(y - py) == 1 and x == px):\n                # Found a path (could be empty if starting position is already adjacent)\n                best_path_to_adjacent = actions\n                break\n        if best_path_to_adjacent is not None:\n            break # Path found, exit BFS as it's the shortest\n\n        # Explore neighbors\n        for action, (dx, dy) in DELTAS.items():\n            nx, ny = x + dx, y + dy\n            \n            if is_traversable(nx, ny) and (nx, ny) not in visited:\n                visited.add((nx, ny))\n                queue.append(((nx, ny), actions + [action]))\n    \n    if best_path_to_adjacent is None:\n        return [] # No path found to any traversable square adjacent to a primitive\n\n    # 4. Add the USE action to the found path\n    # This assumes the USE action works when the agent is adjacent to the item,\n    # and the agent's facing direction is either automatically adjusted or irrelevant for USE.\n    return best_path_to_adjacent + [USE]", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:01:59.219182", "function_name": "collect", "function_body": "    current_state = env._current_state\n    \n    # 1. Check if primitive is already collected\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    width, height, _ = grid.shape\n    start_pos = current_state.pos\n\n    # Define action deltas for movement\n    # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    ACTION_DELTAS = {\n        0: (0, 1),   # DOWN (dy=1)\n        1: (0, -1),  # UP (dy=-1)\n        2: (-1, 0),  # LEFT (dx=-1)\n        3: (1, 0),   # RIGHT (dx=1)\n    }\n    \n    # Identify obstacles for pathfinding. Agent cannot walk into cells\n    # containing non-grabbable items unless that item *is* the primitive itself\n    # (in which case the agent walks *next* to it, not onto it).\n    # If the primitive is a non-grabbable type, the cell it occupies is an obstacle.\n    obstacle_kinds = set(current_state.world.non_grabbable_indices)\n    \n    def is_walkable(x, y):\n        # Check bounds\n        if not (0 <= x < width and 0 <= y < height):\n            return False \n        \n        # Check if this cell contains any non-grabbable item that is not the target primitive.\n        # If it does, it's an obstacle.\n        for k in obstacle_kinds:\n            if k == primitive:\n                # If the primitive itself is a non-grabbable item, we don't walk onto its cell.\n                # So, if grid[x,y,primitive] is 1 AND primitive is an obstacle_kind, this cell is not walkable.\n                continue\n            if grid[x, y, k] == 1:\n                return False # Cell contains an obstacle (non-grabbable item, not our primitive)\n        \n        # Additionally, if the cell contains the primitive AND the primitive is non-grabbable,\n        # then the agent cannot walk ONTO this cell. It needs to stand next to it.\n        if grid[x, y, primitive] == 1 and primitive in obstacle_kinds:\n             return False\n\n        return True # Default: walkable\n    \n    # BFS to find the shortest path to a position from which the primitive can be 'USE'd.\n    q = collections.deque([(start_pos, [])]) # Queue stores (position, list_of_actions_to_reach_position)\n    visited = {start_pos} # Set of visited (x, y) positions to avoid loops\n\n    while q:\n        curr_pos, path_so_far = q.popleft()\n        cx, cy = curr_pos\n\n        # Check if the primitive is in the 3x3 neighborhood of the current position.\n        # This simulates the CraftState.next_to() condition, which determines if USE is effective.\n        # The 3x3 neighborhood includes the current cell (dx_n=0, dy_n=0).\n        for dx_n in [-1, 0, 1]:\n            for dy_n in [-1, 0, 1]:\n                nx, ny = cx + dx_n, cy + dy_n\n                if 0 <= nx < width and 0 <= ny < height:\n                    if grid[nx, ny, primitive] == 1:\n                        # Found a position from which the primitive can be 'USE'd.\n                        # Append the USE action and return the full path.\n                        return path_so_far + [4] # 4 is the USE action\n\n        # Explore possible moves (DOWN, UP, LEFT, RIGHT)\n        for action in [0, 1, 2, 3]: # DOWN, UP, LEFT, RIGHT\n            dx, dy = ACTION_DELTAS[action]\n            next_x, next_y = cx + dx, cy + dy\n            next_pos = (next_x, next_y)\n\n            # If the next position is within bounds, walkable, and not yet visited, add it to queue\n            if is_walkable(next_x, next_y) and next_pos not in visited:\n                visited.add(next_pos)\n                q.append((next_pos, path_so_far + [action]))\n\n    # If the BFS completes and no path to collect the primitive is found\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:03:43.940770", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants, mapping action names to integer values as specified by CraftLab.action_specs.\n    ACTIONS = {\n        \"DOWN\": 0,\n        \"UP\": 1,\n        \"LEFT\": 2,\n        \"RIGHT\": 3,\n        \"USE\": 4,\n    }\n\n    # Mapping of movement action to (dx, dy) relative change in position.\n    # This also defines the agent's new facing direction after the move.\n    # Assuming standard grid coordinates: +y is DOWN, +x is RIGHT.\n    # Agent directions (inferred from common conventions and CraftWorld context):\n    # 0 = North (UP), 1 = East (RIGHT), 2 = South (DOWN), 3 = West (LEFT).\n    ACTION_DELTAS = {\n        ACTIONS[\"UP\"]: (0, -1),   # Move North (decreases y)\n        ACTIONS[\"DOWN\"]: (0, 1),  # Move South (increases y)\n        ACTIONS[\"LEFT\"]: (-1, 0), # Move West (decreases x)\n        ACTIONS[\"RIGHT\"]: (1, 0), # Move East (increases x)\n    }\n\n    # Mapping relative position of an object from the agent's current position (dx, dy)\n    # to the facing direction (0-3) the agent needs to adopt to interact with that object.\n    RELATIVE_TO_FACING_DIRECTION = {\n        (0, -1): 0, # Object is North (up), face North (0)\n        (0, 1): 2,  # Object is South (down), face South (2)\n        (-1, 0): 3, # Object is West (left), face West (3)\n        (1, 0): 1,  # Object is East (right), face East (1)\n    }\n\n    def _turn_to_face(current_dir, target_dir):\n        \"\"\"\n        Calculates a list of actions (LEFT/RIGHT) to change the agent's facing direction.\n        Assumes directions are integer values: 0=N, 1=E, 2=S, 3=W.\n\n        Args:\n            current_dir (int): The agent's current facing direction.\n            target_dir (int): The desired facing direction.\n\n        Returns:\n            list[int]: A list of turn actions (ACTIONS[\"LEFT\"] or ACTIONS[\"RIGHT\"]).\n        \"\"\"\n        actions = []\n        # Calculate the difference in directions (clockwise turns) modulo 4.\n        # Adding 4 and then taking modulo 4 handles negative results correctly.\n        diff = (target_dir - current_dir + 4) % 4\n        \n        if diff == 0:  # Already facing the target direction\n            pass\n        elif diff == 1:  # 90 degrees clockwise turn\n            actions.append(ACTIONS[\"RIGHT\"])\n        elif diff == 2:  # 180 degrees turn (can be two rights or two lefts, two rights is chosen)\n            actions.append(ACTIONS[\"RIGHT\"])\n            actions.append(ACTIONS[\"RIGHT\"])\n        elif diff == 3:  # 90 degrees counter-clockwise turn\n            actions.append(ACTIONS[\"LEFT\"])\n        return actions\n\n    def _find_path_and_collect_actions(start_pos, start_dir, target_kind_idx, grid):\n        \"\"\"\n        Performs a Breadth-First Search (BFS) to find the shortest sequence of actions\n        to move the agent to a cell from which it can collect the specified primitive.\n        This includes pathfinding to an adjacent cell, turning to face the primitive,\n        and then performing the 'USE' action.\n\n        Args:\n            start_pos (tuple): Agent's starting (x, y) position.\n            start_dir (int): Agent's starting facing direction.\n            target_kind_idx (int): The integer index of the primitive (item kind) to collect.\n            grid (np.ndarray): The current grid state, with shape (WIDTH, HEIGHT, n_kinds).\n\n        Returns:\n            list[int] or None: A list of action integers (UP, DOWN, LEFT, RIGHT, USE),\n                               or None if no path to the primitive is found.\n        \"\"\"\n        WIDTH, HEIGHT, _ = grid.shape\n        \n        # Queue for BFS: (current_pos (tuple), current_dir (int), actions_list_so_far (list))\n        q = collections.deque([(start_pos, start_dir, [])])\n        \n        # Visited set to avoid redundant exploration and cycles in the state space.\n        # A state is defined by (position, facing_direction).\n        visited = {(start_pos, start_dir)}\n\n        # Find all positions on the grid where the target primitive exists.\n        primitive_positions = []\n        for x in range(WIDTH):\n            for y in range(HEIGHT):\n                # If this cell contains the primitive kind (count > 0)\n                if grid[x, y, target_kind_idx] > 0:\n                    primitive_positions.append((x, y))\n\n        if not primitive_positions:\n            return None # If the primitive is not found anywhere on the grid, no actions possible.\n\n        while q:\n            (cx, cy), c_dir, path = q.popleft()\n\n            # --- Check for success conditions: Agent is ready to collect the primitive ---\n\n            # Case 1: Agent is directly on the primitive and can collect it from there.\n            # CraftState.next_to uses a 3x3 neighborhood which includes (0,0) relative.\n            # So, if agent is on primitive, next_to is true, and USE should work.\n            if grid[cx, cy, target_kind_idx] > 0:\n                # If collecting while standing on it is allowed (which it usually is),\n                # no turning is explicitly needed for USE if already on the spot.\n                return path + [ACTIONS[\"USE\"]]\n\n            # Case 2: Agent is adjacent to a primitive and needs to turn and then USE.\n            for px, py in primitive_positions:\n                # Check the 4 direct neighbors (N, S, W, E) of the current agent position (cx, cy)\n                # to see if any of them is a primitive.\n                for dx_adj, dy_adj in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n                    # Calculate the potential primitive location relative to agent's current position\n                    potential_primitive_x, potential_primitive_y = cx + dx_adj, cy + dy_adj\n                    \n                    if (potential_primitive_x, potential_primitive_y) == (px, py):\n                        # We are at (cx, cy) which is directly adjacent to (px, py) (a primitive).\n                        # Now, determine the direction the agent needs to face to interact with (px, py).\n                        # (dx_adj, dy_adj) represents the relative position of the primitive from the agent.\n                        target_face_dir = RELATIVE_TO_FACING_DIRECTION[(dx_adj, dy_adj)]\n                        \n                        # Generate the necessary turn actions to face the primitive.\n                        turn_actions = _turn_to_face(c_dir, target_face_dir)\n                        \n                        # Return the full sequence: path to the adjacent cell, turn actions, then the USE action.\n                        return path + turn_actions + [ACTIONS[\"USE\"]]\n\n            # --- Explore possible next states by moving ---\n            # Iterate through all possible movement actions (UP, DOWN, LEFT, RIGHT).\n            for action_move, (mdx, mdy) in ACTION_DELTAS.items():\n                nx, ny = cx + mdx, cy + mdy # Calculate new position after movement.\n                \n                # After moving, the agent's new facing direction automatically updates to the\n                # direction of movement.\n                n_dir = RELATIVE_TO_FACING_DIRECTION[(mdx, mdy)]\n\n                # Check if the new position (nx, ny) is within grid boundaries\n                # and if this new state ((nx, ny), n_dir) has not been visited yet.\n                if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and ((nx, ny), n_dir) not in visited:\n                    # Assuming all grid cells are traversable. No explicit obstacles (like water or walls)\n                    # are mentioned as impassable for movement in the problem description.\n                    visited.add(((nx, ny), n_dir))\n                    q.append(((nx, ny), n_dir, path + [action_move]))\n                    \n        return None # If the queue becomes empty and no path was found, return None.\n\n    # --- Main logic for collect_v2 function ---\n\n    # Get the current observations from the CraftLab environment.\n    obs = env.observations()\n    \n    # Extract the full grid state from the observations.\n    current_grid = obs[\"features_dict\"][\"features_global\"]\n    \n    # Get the agent's current exact position (x, y tuple) and facing direction (int).\n    # These are directly available from the internal CraftState of the environment.\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    # Call the helper function to find the sequence of actions required to collect the primitive.\n    actions_to_collect = _find_path_and_collect_actions(current_pos, current_dir, primitive, current_grid)\n\n    # Return the list of actions. If no path was found, return an empty list as per typical convention.\n    return actions_to_collect if actions_to_collect is not None else []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:03:44.012535", "function_name": "collect", "function_body": "    # Constants for actions dynamically retrieved from the environment\n    action_map = env.action_specs()\n    DOWN = action_map[\"DOWN\"]\n    UP = action_map[\"UP\"]\n    LEFT = action_map[\"LEFT\"]\n    RIGHT = action_map[\"RIGHT\"]\n    USE = action_map[\"USE\"]\n\n    MAX_COLLECT_STEPS = 1000 # Safety limit to prevent infinite loops\n\n    actions = []\n    current_state = env._current_state # Get the initial state from the environment\n\n    for _ in range(MAX_COLLECT_STEPS):\n        # 1. Check if the primitive is already in the inventory\n        if current_state.inventory[primitive] > 0:\n            return actions\n\n        # 2. Check if the primitive is in the 3x3 neighborhood, indicating it can be used/collected\n        # This covers cases where the agent is on the same square or adjacent.\n        if current_state.next_to(primitive):\n            actions.append(USE)\n            # Perform the USE action. We don't care about reward/done/obs for this function,\n            # only that the state is updated.\n            _, _, _ = env.step(USE)\n            current_state = env._current_state # Update the current state after the action\n            continue # Re-evaluate state (inventory, next_to) in the next iteration\n\n        # 3. If not next to and not in inventory, find the closest primitive on the grid\n        agent_x, agent_y = current_state.pos\n        target_x, target_y = -1, -1\n        min_dist = float('inf')\n\n        # Get grid dimensions. current_state.grid is a numpy array (width, height, kinds).\n        grid_width, grid_height, _ = current_state.grid.shape\n\n        # Iterate through the entire grid to find the closest instance of the primitive\n        for x in range(grid_width):\n            for y in range(grid_height):\n                # Check if this cell contains the primitive\n                if current_state.grid[x, y, primitive] == 1:\n                    # Calculate Manhattan distance to prioritize closer items\n                    dist = abs(x - agent_x) + abs(y - agent_y)\n                    if dist < min_dist:\n                        min_dist = dist\n                        target_x, target_y = x, y\n\n        # 4. Determine the next movement action\n        action_to_take = None\n        if target_x != -1: # A primitive was found on the visible grid\n            dx = target_x - agent_x\n            dy = target_y - agent_y\n\n            # Prioritize movement along one axis (e.g., horizontal then vertical).\n            # This is a simple greedy movement. It does not handle obstacles or complex paths.\n            if dx != 0:\n                action_to_take = RIGHT if dx > 0 else LEFT\n            elif dy != 0: # Only move vertically if horizontally aligned (dx is 0)\n                # Assuming (0,0) is top-left, Y increases downwards, so positive dy means DOWN\n                action_to_take = DOWN if dy > 0 else UP\n            else:\n                # Agent is exactly on the target square (dx=0, dy=0) but next_to() was False.\n                # This could happen if the item is at the agent's current position but not\n                # considered \"usable\" by `next_to` (e.g., it's terrain).\n                # In such a case, we resort to exploration.\n                action_to_take = RIGHT # Default exploration if on target but not 'next_to'\n        else: # Primitive not found on the visible grid\n            # If the primitive isn't visible, perform a simple exploration action.\n            # A more sophisticated 'v2' could implement a systematic search pattern (e.g., spiral, wall-following).\n            action_to_take = RIGHT # Simple fixed exploration direction\n\n        # Perform the determined action\n        if action_to_take is not None:\n            actions.append(action_to_take)\n            _, _, _ = env.step(action_to_take) # Step the environment\n            current_state = env._current_state # Update the current state after the step\n        else:\n            # This block should ideally not be reached if the logic above always determines an action.\n            # It serves as a safeguard against infinite loops if no action is determined for some reason.\n            actions.append(RIGHT)\n            _, _, _ = env.step(RIGHT)\n            current_state = env._current_state\n\n    # If the loop finishes, it means MAX_COLLECT_STEPS were reached without collecting the primitive.\n    # Return the actions taken so far, indicating a potential failure or a very long path.\n    return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:04:57.021789", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Mapping from movement action to the direction the agent would face after taking it\n  action_to_direction = {\n      UP_ACTION: NORTH_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  # Mapping from movement action to (dx, dy) delta\n  action_to_move_delta = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"\n    Calculates the direction the agent needs to face to look at the item.\n    Assumes item is directly adjacent (cardinally) to the agent.\n    \"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dx == 0 and dy == 1: return SOUTH_DIR\n    if dx == 0 and dy == -1: return NORTH_DIR\n    return None # Item is not cardinally adjacent, or agent is on item\n\n  # Get target item's integer ID\n  target_id = env.world.cookbook.index[primitive]\n\n  # Determine if the target is a primitive resource or a workshop\n  is_primitive_resource = target_id in env.world.cookbook.primitives\n  is_workshop = target_id in env.world.workshop_indices\n\n  # If the goal is to collect a primitive resource and we already have it\n  current_state = env._current_state\n  if is_primitive_resource and current_state.inventory[target_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  def is_walkable(x, y, current_grid):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-grabbable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item is present at (y, x)\n    for kind_idx in non_grabbable_kinds:\n      if current_grid[y, x, kind_idx] > 0:\n        return False\n    return True\n\n  # 1. Find all locations of the target item on the grid\n  item_y_coords, item_x_coords = np.where(grid[:, :, target_id] == 1)\n\n  if len(item_x_coords) == 0:\n    return [] # Target item not found on the grid\n\n  # 2. Identify all target interaction points for BFS goal states.\n  # A target interaction point is (adjacent_x, adjacent_y, required_facing_direction_to_item).\n  target_interaction_points = set()\n  for i in range(len(item_x_coords)):\n    item_x, item_y = item_x_coords[i], item_y_coords[i]\n    # Check all 4 cardinal neighbors of the item\n    for action_val, (dx, dy) in action_to_move_delta.items():\n      adj_x, adj_y = item_x + dx, item_y + dy\n      if is_walkable(adj_x, adj_y, grid):\n        # Determine the direction the agent needs to face to use the item from this adjacent cell\n        required_facing_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_facing_dir is not None:\n          target_interaction_points.add((adj_x, adj_y, required_facing_dir))\n\n  if not target_interaction_points:\n    return [] # No reachable adjacent cells to any target item\n\n  # 3. Initialize BFS queue: (current_x, current_y, current_direction, path_actions_list)\n  queue = collections.deque([(start_pos_x, start_pos_y, start_dir, [])])\n  # 4. Initialize visited set to avoid cycles and redundant paths: (x, y, direction)\n  visited = {(start_pos_x, start_pos_y, start_dir)}\n\n  # 5. Run BFS\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # Check if the current state is a goal state (can immediately interact with the item)\n    if (curr_x, curr_y, curr_dir) in target_interaction_points:\n      if is_primitive_resource:\n        # If collecting a primitive resource, we need to USE it\n        return path_actions + [USE_ACTION]\n      elif is_workshop:\n        # If the target is a workshop, just reaching it and facing it is enough\n        return path_actions\n      else:\n        # Fallback for unknown item types: just reach and face it.\n        return path_actions\n\n    # --- Expand possible next states ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for move_action, (dx, dy) in action_to_move_delta.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      # After a movement action, the agent's direction automatically aligns with the movement.\n      next_dir_after_move = action_to_direction[move_action]\n\n      if is_walkable(next_x, next_y, grid) and\\\n         (next_x, next_y, next_dir_after_move) not in visited:\n        visited.add((next_x, next_y, next_dir_after_move))\n        queue.append((next_x, next_y, next_dir_after_move, path_actions + [move_action]))\n\n    # B. Turning Actions (LEFT, RIGHT)\n    # These actions change direction but not position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n\n      # Position remains the same\n      if (curr_x, curr_y, next_dir) not in visited:\n        visited.add((curr_x, curr_y, next_dir))\n        queue.append((curr_x, curr_y, next_dir, path_actions + [turn_action]))\n\n  # If the queue becomes empty and no path to the target was found\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T16:04:57.993143", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Mapping from movement action to the direction the agent would face after taking it\n  ACTION_TO_DIRECTION = {\n      UP_ACTION: NORTH_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  # Mapping from movement action to (dx, dy) delta\n  ACTION_TO_MOVE_DELTA = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  # Mapping from agent's direction to the (dx, dy) delta of the cell directly in front\n  DIRECTION_TO_FRONT_DELTA = {\n      NORTH_DIR: (0, -1),\n      EAST_DIR: (1, 0),\n      SOUTH_DIR: (0, 1),\n      WEST_DIR: (-1, 0)\n  }\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Check if the primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  def is_walkable(x, y, current_grid):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-grabbable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item is present at (y, x)\n    for kind_idx in non_grabbable_kinds:\n      if current_grid[y, x, kind_idx] > 0:\n        return False\n    return True\n\n  # Initialize BFS queue: (current_x, current_y, current_direction, path_actions_list)\n  queue = collections.deque([(start_pos_x, start_pos_y, start_dir, [])])\n  # Initialize visited set to avoid cycles and redundant paths: (x, y, direction)\n  visited = {(start_pos_x, start_pos_y, start_dir)}\n\n  # Run BFS\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # --- Goal Check: Can we use the primitive from the current state? ---\n    # Determine the cell directly in front of the agent\n    front_dx, front_dy = DIRECTION_TO_FRONT_DELTA[curr_dir]\n    front_x, front_y = curr_x + front_dx, curr_y + front_dy\n\n    # Check if the cell in front is within bounds and contains the primitive\n    if (0 <= front_x < grid_width and 0 <= front_y < grid_height and\n        grid[front_y, front_x, primitive_id] > 0):\n      return path_actions + [USE_ACTION] # Goal reached: return path plus USE action\n\n    # --- Expand possible next states ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for move_action, (dx, dy) in ACTION_TO_MOVE_DELTA.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      # After a movement action, the agent's direction automatically aligns with the movement.\n      next_dir_after_move = ACTION_TO_DIRECTION[move_action]\n\n      if is_walkable(next_x, next_y, grid) and\\\n         (next_x, next_y, next_dir_after_move) not in visited:\n        visited.add((next_x, next_y, next_dir_after_move))\n        queue.append((next_x, next_y, next_dir_after_move, path_actions + [move_action]))\n\n    # B. Turning Actions (LEFT, RIGHT)\n    # These actions change direction but not position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n\n      # Position remains the same\n      if (curr_x, curr_y, next_dir) not in visited:\n        visited.add((curr_x, curr_y, next_dir))\n        queue.append((curr_x, curr_y, next_dir, path_actions + [turn_action]))\n\n  # If the queue becomes empty and no path to a primitive was found\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T16:06:26.464223", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  world = current_state.world\n\n  WIDTH, HEIGHT, _ = grid.shape\n  non_grabbable_indices = world.non_grabbable_indices\n\n  def is_traversable(x, y):\n    \"\"\"Checks if a cell (x, y) is within bounds and traversable.\"\"\"\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False\n    # Check if the cell contains any non-grabbable item (obstacle)\n    for idx in non_grabbable_indices:\n      if grid[x, y, idx] == 1:\n        return False\n    return True\n\n  # 1. Find all locations of the primitive on the grid\n  primitive_locs = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      if grid[x, y, primitive] == 1:\n        primitive_locs.append((x, y))\n\n  if not primitive_locs:\n    return [] # Primitive not found anywhere on the grid\n\n  # 2. Determine all reachable cells from which the primitive can be collected (3x3 neighborhood)\n  # These are the target positions for our BFS pathfinding.\n  target_reach_positions = set()\n  for px, py in primitive_locs:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        tx, ty = px + dx, py + dy\n        # Only add traversable cells as potential targets for movement\n        if is_traversable(tx, ty):\n          target_reach_positions.add((tx, ty))\n\n  # If there are no traversable spots around any primitive, it's unreachable\n  if not target_reach_positions:\n      return []\n\n  # Define movement actions and their corresponding (dx, dy) deltas\n  # Assuming env_factory.ACTIONS and env_factory.MOVE_DELTAS are available\n  action_to_delta = {\n      env_factory.ACTIONS['DOWN']: (0, 1),\n      env_factory.ACTIONS['UP']: (0, -1),\n      env_factory.ACTIONS['LEFT']: (-1, 0),\n      env_factory.ACTIONS['RIGHT']: (1, 0),\n  }\n\n  # BFS setup\n  q = collections.deque()\n  q.append((start_pos, [])) # (current_position, path_actions_list)\n  visited = {start_pos}\n\n  while q:\n    current_pos, path_actions = q.popleft()\n    cx, cy = current_pos\n\n    # If the current position is one from which we can collect a primitive, we're done\n    if current_pos in target_reach_positions:\n        return path_actions + [env_factory.ACTIONS['USE']]\n\n    # Explore neighbors (4-directional movement)\n    for action_val, (dx, dy) in action_to_delta.items():\n      nx, ny = cx + dx, cy + dy\n      npos = (nx, ny)\n\n      if npos not in visited and is_traversable(nx, ny):\n        visited.add(npos)\n        q.append((npos, path_actions + [action_val]))\n\n  return [] # No path found to any target reach position", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:06:26.533496", "function_name": "collect", "function_body": "    # Define ACTION_DELTAS inside the function to adhere to \"only return code that will fit in that function\"\n    # Assuming standard grid coordinates: x increases right, y increases down.\n    # These correspond to CraftLab.action_specs() values:\n    # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    ACTION_DELTAS = {\n        0: (0, 1),   # DOWN (dx, dy)\n        1: (0, -1),  # UP\n        2: (-1, 0),  # LEFT\n        3: (1, 0),   # RIGHT\n    }\n\n    # 1. Check if primitive is already in inventory\n    obs = env.observations()\n    inventory = obs['features_dict']['inventory']\n    if inventory[primitive] > 0:\n        return []\n\n    # Get initial state information\n    # Accessing _current_state directly for position and grid as features_dict['pos'] is normalized.\n    current_state = env._current_state\n    current_x, current_y = current_state.pos\n    grid = current_state.grid  # grid: numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds)\n    grid_width, grid_height, _ = grid.shape\n\n    # Get non-grabbable indices from the world to identify obstacles for movement\n    non_grabbable_indices = env.world.non_grabbable_indices\n    # Check if the primitive itself is considered grabbable by the cookbook\n    is_primitive_grabbable = primitive in env.world.cookbook.primitives\n\n    # Helper function to check if a cell (gx, gy) is an obstacle for movement\n    def is_obstacle(gx, gy):\n        # Check boundary\n        if not (0 <= gx < grid_width and 0 <= gy < grid_height):\n            return True\n        # Check if cell contains any non-grabbable item that blocks movement\n        for kind_idx in non_grabbable_indices:\n            if grid[gx, gy, kind_idx] == 1:\n                return True\n        return False\n\n    # Helper function to check if a primitive is in the 3x3 neighborhood of (ax, ay) (including self)\n    def check_for_primitive_in_neighborhood(ax, ay, target_kind):\n        # Check the agent's current square\n        if grid[ax, ay, target_kind] == 1:\n            return True\n        # Check the 8 surrounding squares\n        for dx_adj in [-1, 0, 1]:\n            for dy_adj in [-1, 0, 1]:\n                if dx_adj == 0 and dy_adj == 0:  # Skip agent's own square, already checked\n                    continue\n                nx_adj, ny_adj = ax + dx_adj, ay + dy_adj\n                if 0 <= nx_adj < grid_width and 0 <= ny_adj < grid_height:\n                    if grid[nx_adj, ny_adj, target_kind] == 1:\n                        return True\n        return False\n\n    # 2. BFS to find the shortest path to a position from which the primitive can be collected\n    q = deque([(current_x, current_y, [])])  # (x, y, path_taken)\n    visited = {(current_x, current_y)}\n\n    best_path_to_collect = []\n    found_path = False\n\n    while q:\n        px, py, path = q.popleft()\n\n        # Check if the current position (px, py) allows for collection of the primitive\n        if is_primitive_grabbable and check_for_primitive_in_neighborhood(px, py, primitive):\n            best_path_to_collect = path + [4]  # Add USE action (4)\n            found_path = True\n            break  # Found the shortest path due to BFS\n\n        # Explore neighbors\n        for action_val, (dx, dy) in ACTION_DELTAS.items():\n            nx, ny = px + dx, py + dy\n\n            if (nx, ny) in visited:\n                continue\n\n            if is_obstacle(nx, ny):\n                continue\n\n            visited.add((nx, ny))\n            q.append((nx, ny, path + [action_val]))\n\n    return best_path_to_collect if found_path else []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:08:04.778087", "function_name": "collect", "function_body": "    # Direction to delta mapping for (dx, dy) when facing that direction\n    # 0: South (DOWN), 1: North (UP), 2: West (LEFT), 3: East (RIGHT)\n    _DIR_DELTAS = {\n        0: (0, 1),   # South: (dx, dy) = (0, 1)\n        1: (0, -1),  # North: (dx, dy) = (0, -1)\n        2: (-1, 0),  # West: (dx, dy) = (-1, 0)\n        3: (1, 0)    # East: (dx, dy) = (1, 0)\n    }\n\n    current_state = env._current_state\n    world = current_state.world\n    grid = current_state.grid\n    init_pos = current_state.pos\n    init_dir = current_state.dir\n    inventory = current_state.inventory\n\n    # 1. Check if the primitive is already in inventory\n    if inventory[primitive] > 0:\n        return []\n\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    # (action, new_dir) mapping for movement actions.\n    # Performing these actions also sets the agent's direction.\n    ACTIONS_MOVE_AND_TURN = [\n        (DOWN, 0), # Action DOWN moves or attempts to move South, sets direction to South (0)\n        (UP, 1),   # Action UP moves or attempts to move North, sets direction to North (1)\n        (LEFT, 2), # Action LEFT moves or attempts to move West, sets direction to West (2)\n        (RIGHT, 3) # Action RIGHT moves or attempts to move East, sets direction to East (3)\n    ]\n\n    grid_width, grid_height, _ = grid.shape\n\n    # Identify non-traversable cells (e.g., water, stone)\n    water_idx = world.water_index\n    stone_idx = world.stone_index\n\n    # Check if the primitive actually exists anywhere on the grid.\n    primitive_exists_on_grid = False\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if grid[x, y, primitive] > 0:\n                primitive_exists_on_grid = True\n                break\n        if primitive_exists_on_grid:\n            break\n\n    if not primitive_exists_on_grid:\n        # Primitive not found anywhere on the map, so it cannot be collected.\n        return []\n\n    q = collections.deque()\n    visited = set()\n\n    # Initial state for BFS: (x, y, dir, path_actions)\n    q.append((init_pos[0], init_pos[1], init_dir, []))\n    visited.add((init_pos[0], init_pos[1], init_dir))\n\n    while q:\n        curr_x, curr_y, curr_dir, path = q.popleft()\n\n        # Check if the current state allows using the primitive (i.e., agent is adjacent and facing it)\n        # Calculate the cell in front of the agent\n        target_adj_x = curr_x + _DIR_DELTAS[curr_dir][0]\n        target_adj_y = curr_y + _DIR_DELTAS[curr_dir][1]\n\n        # Check if the cell in front is within bounds and contains the primitive\n        if (0 <= target_adj_x < grid_width and 0 <= target_adj_y < grid_height and\n                grid[target_adj_x, target_adj_y, primitive] > 0):\n            # If the cell in front has the primitive, we can use it.\n            return path + [USE]\n\n        # Explore possible next states by trying movement actions\n        for action, target_dir in ACTIONS_MOVE_AND_TURN:\n            potential_next_x, potential_next_y = curr_x, curr_y\n\n            # Determine the cell the agent *attempts* to move into based on the action\n            if action == DOWN:\n                potential_next_y += 1\n            elif action == UP:\n                potential_next_y -= 1\n            elif action == LEFT:\n                potential_next_x -= 1\n            elif action == RIGHT:\n                potential_next_x += 1\n\n            # Default: agent stays in current position if movement is blocked\n            final_next_x, final_next_y = curr_x, curr_y \n\n            # Check if the potential new position is valid and traversable (not water or stone)\n            can_move_to_potential = False\n            if (0 <= potential_next_x < grid_width and 0 <= potential_next_y < grid_height):\n                if (grid[potential_next_x, potential_next_y, water_idx] == 0 and\n                    grid[potential_next_x, potential_next_y, stone_idx] == 0):   \n                    can_move_to_potential = True\n            \n            # If movement is possible, update final position; otherwise, agent stays put\n            if can_move_to_potential:\n                final_next_x, final_next_y = potential_next_x, potential_next_y\n            \n            # The new state is defined by the final position and the new direction set by the action\n            new_state_tuple = (final_next_x, final_next_y, target_dir)\n\n            # If this new state has not been visited, add it to the queue\n            if new_state_tuple not in visited:\n                visited.add(new_state_tuple)\n                q.append((final_next_x, final_next_y, target_dir, path + [action]))\n\n    # If the queue becomes empty and no path was found, return an empty list\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:08:05.743807", "function_name": "collect", "function_body": "  # Retrieve action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_USE = action_map['USE']\n\n  # Get current state information from the CraftLab environment's internal state\n  current_state = env._current_state\n  current_pos = current_state.pos\n  grid = current_state.grid\n  world = current_state.world # This is the CraftWorld instance\n\n  # 1. Check if the primitive is already collected\n  if current_state.inventory[primitive] > 0:\n    return [] # Already have the primitive, no actions needed\n\n  # 2. Find all grid locations where the primitive exists\n  primitive_locations = []\n  width, height, n_kinds = grid.shape\n  for r in range(width):\n    for c in range(height):\n      # Check if the primitive exists at this cell\n      # Assuming a value > 0 in the primitive's channel indicates its presence\n      if grid[r, c, primitive] > 0:\n        primitive_locations.append((r, c))\n\n  if not primitive_locations:\n    return [] # Primitive not found anywhere in the grid\n\n  # 3. Determine the set of target cells for BFS.\n  # The agent needs to be in a cell from which it can \"USE\" the primitive.\n  # CraftState.next_to checks the 3x3 neighborhood around the agent's position.\n  # So, any cell within Manhattan distance 1 of a primitive, or the primitive's cell itself,\n  # can be a valid target for the BFS.\n  # Let's consider all cells in the 3x3 neighborhood around each primitive location.\n  target_cells_for_bfs = set()\n  for pr, pc in primitive_locations:\n    # Iterate through all 9 cells in the 3x3 square centered at (pr, pc)\n    for dr_sq in [-1, 0, 1]:\n      for dc_sq in [-1, 0, 1]:\n        adj_r, adj_c = pr + dr_sq, pc + dc_sq\n        # Ensure the adjacent cell is within grid boundaries\n        if 0 <= adj_r < width and 0 <= adj_c < height:\n          target_cells_for_bfs.add((adj_r, adj_c))\n\n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n  # to any cell in target_cells_for_bfs.\n  # The queue stores tuples of (current_position, list_of_actions_to_reach_here)\n  queue = collections.deque([(current_pos, [])])\n  visited = {current_pos} # Set of visited (row, col) tuples to prevent cycles\n\n  # Define movement deltas and their corresponding actions\n  # Assuming (row, col) coordinates, where row decreases for UP, row increases for DOWN\n  delta_to_action = {\n      (-1, 0): action_map['UP'],    # Move North (row - 1)\n      (1, 0): action_map['DOWN'],   # Move South (row + 1)\n      (0, -1): action_map['LEFT'],  # Move West (col - 1)\n      (0, 1): action_map['RIGHT']   # Move East (col + 1)\n  }\n\n  path_to_target = []\n\n  while queue:\n    current_path_pos, current_path_actions = queue.popleft()\n\n    # If the current position is one of our target cells, we found the path\n    if current_path_pos in target_cells_for_bfs:\n      # Append the USE action as the final step to collect the primitive\n      path_to_target = current_path_actions + [ACTION_USE]\n      break # Path found, exit BFS\n\n    r_curr, c_curr = current_path_pos\n\n    # Explore all 4 possible neighboring cells\n    for dr, dc in delta_to_action.keys():\n      r_next, c_next = r_curr + dr, c_curr + dc\n      next_pos = (r_next, c_next)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= r_next < width and 0 <= c_next < height):\n        continue\n\n      # Check if this position has already been visited in the BFS\n      if next_pos in visited:\n        continue\n\n      # Check if the next position is an obstacle.\n      # A cell is considered an obstacle if it contains any item from `world.non_grabbable_indices`\n      # that is NOT the primitive we are trying to collect.\n      # We assume the agent can traverse the primitive's cell even if it's \"non-grabbable\"\n      # (e.g., walking onto a water tile to scoop water).\n      is_obstacle = False\n      for k_idx in range(n_kinds):\n        if grid[r_next, c_next, k_idx] > 0: # If some item exists at this cell\n          if k_idx in world.non_grabbable_indices: # And it's classified as non-grabbable\n            if k_idx != primitive: # And it's not the primitive we're looking for\n              is_obstacle = True\n              break\n      if is_obstacle:\n        continue # Skip this cell, it's an impassable obstacle\n\n      # If the cell is reachable and not an obstacle, add it to the queue\n      visited.add(next_pos)\n      queue.append((next_pos, current_path_actions + [delta_to_action[(dr, dc)]]))\n\n  return path_to_target # Returns the list of actions, or an empty list if no path was found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:09:38.680185", "function_name": "collect", "function_body": "  import collections\n\n  # Constants for actions based on CraftLab.action_specs()\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction vectors for agent's facing direction (0:North, 1:East, 2:South, 3:West)\n  # (dr, dc) offset for the cell directly in front of the agent\n  DIR_VECTORS = {\n      0: (-1, 0),  # North (UP)\n      1: (0, 1),   # East (RIGHT)\n      2: (1, 0),   # South (DOWN)\n      3: (0, -1),  # West (LEFT)\n  }\n\n  # Helper function to get the position of the cell in front of the agent\n  def _get_neighbor_pos(r, c, direction):\n      dr, dc = DIR_VECTORS[direction]\n      return (r + dr, c + dc)\n\n  # Get initial state from the CraftLab environment\n  initial_state = env._current_state\n  grid = initial_state.grid\n  initial_pos = initial_state.pos\n  initial_dir = initial_state.dir # Agent's initial facing direction\n\n  grid_height, grid_width, n_kinds = grid.shape\n  non_grabbable_indices = initial_state.world.non_grabbable_indices\n\n  # Helper function to check if a position is blocked by non-grabbable items\n  def _is_blocked(r, c):\n      for k_idx in non_grabbable_indices:\n          if grid[r, c, k_idx] > 0:\n              return True\n      return False\n\n  # BFS queue: stores (current_row, current_col, current_facing_direction, path_actions)\n  q = collections.deque()\n  q.append((initial_pos[0], initial_pos[1], initial_dir, []))\n\n  # Visited set: stores (row, col, facing_direction) to avoid cycles\n  visited = set()\n  visited.add((initial_pos[0], initial_pos[1], initial_dir))\n\n  # Possible movement actions and their effects on position and agent's direction\n  # (action, dr, dc, new_dir_after_move)\n  # The agent's direction is set to the direction of the last movement action.\n  moves = [\n      (ACTION_UP,    -1, 0, 0),  # Move North (UP), new_dir becomes North (0)\n      (ACTION_DOWN,   1, 0, 2),  # Move South (DOWN), new_dir becomes South (2)\n      (ACTION_LEFT,   0, -1, 3), # Move West (LEFT), new_dir becomes West (3)\n      (ACTION_RIGHT,  0, 1, 1),  # Move East (RIGHT), new_dir becomes East (1)\n  ]\n\n  while q:\n      r, c, current_dir, path_actions = q.popleft()\n\n      # Check if the current state (position and direction) allows using the primitive\n      # `(nr, nc)` is the cell directly in front of the agent\n      nr, nc = _get_neighbor_pos(r, c, current_dir)\n\n      # Check if the neighbor cell is valid and contains the primitive\n      if 0 <= nr < grid_height and 0 <= nc < grid_width:\n          if grid[nr, nc, primitive] > 0:\n              # Found the primitive in front of the agent!\n              # Append the USE action and return the complete path.\n              return path_actions + [ACTION_USE]\n\n      # Explore possible movement actions from the current state\n      for action, dr, dc, new_dir_after_move in moves:\n          next_r, next_c = r + dr, c + dc\n\n          # Check if the next position is within grid boundaries and is not blocked\n          if (0 <= next_r < grid_height and 0 <= next_c < grid_width and\n                  not _is_blocked(next_r, next_c)):\n              \n              # If this new state (position and resulting direction) has not been visited\n              if (next_r, next_c, new_dir_after_move) not in visited:\n                  visited.add((next_r, next_c, new_dir_after_move))\n                  new_path_actions = path_actions + [action]\n                  q.append((next_r, next_c, new_dir_after_move, new_path_actions))\n\n  # If the primitive is not reachable, return an empty list of actions.\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:09:38.749900", "function_name": "collect", "function_body": "    # Constants - defined locally as per instructions to only return code within the function\n    # These map the action names to their integer values.\n    # From CraftLab.action_specs(): dict mapping DOWN\u21920, UP\u21921, LEFT\u21922, RIGHT\u21923, USE\u21924\n    _ACTIONS = {\n        \"DOWN\": 0,\n        \"UP\": 1,\n        \"LEFT\": 2,\n        \"RIGHT\": 3,\n        \"USE\": 4,\n    }\n\n    # Maps a movement action's integer value to the direction (0:N, 1:E, 2:S, 3:W)\n    # the agent will face AFTER performing that action.\n    # This assumes movement actions also orient the agent.\n    _ACTION_TO_DIR = {\n        _ACTIONS[\"UP\"]: 0,    # Moving UP makes agent face North (dir 0)\n        _ACTIONS[\"RIGHT\"]: 1, # Moving RIGHT makes agent face East (dir 1)\n        _ACTIONS[\"DOWN\"]: 2,  # Moving DOWN makes agent face South (dir 2)\n        _ACTIONS[\"LEFT\"]: 3,  # Moving LEFT makes agent face West (dir 3)\n    }\n\n    # Maps an agent's facing direction (0:N, 1:E, 2:S, 3:W) to the (dx, dy)\n    # delta representing a step in that direction on the grid.\n    # Assuming (0,0) is top-left, x increases right, y increases down.\n    _DIR_TO_DELTA = {\n        0: (0, -1),  # North (UP: dy=-1)\n        1: (1, 0),   # East (RIGHT: dx=1)\n        2: (0, 1),   # South (DOWN: dy=1)\n        3: (-1, 0),  # West (LEFT: dx=-1)\n    }\n\n    # Get current state from the environment\n    current_state = env._current_state\n    grid = current_state.grid\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir # Agent's initial facing direction\n    inventory = current_state.inventory\n    world = current_state.world # Reference to CraftWorld for obstacle info\n\n    # Check if primitive is already in inventory\n    if inventory[primitive] > 0:\n        return []\n\n    grid_width, grid_height, _ = grid.shape\n\n    # Identify all locations where the primitive item exists\n    primitive_locations = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return [] # Primitive not found anywhere on the map\n\n    # Define obstacles from CraftWorld's non_grabbable_indices\n    # These are indices of item kinds that cannot be walked on.\n    obstacles = world.non_grabbable_indices if hasattr(world, 'non_grabbable_indices') else set()\n\n    def _is_walkable(x, y):\n        \"\"\"Checks if a cell (x, y) is within grid bounds and does not contain an obstacle.\"\"\"\n        if not (0 <= x < grid_width and 0 <= y < grid_height):\n            return False\n        for obstacle_kind_idx in obstacles:\n            if grid[x, y, obstacle_kind_idx] > 0:\n                return False\n        return True\n\n    # BFS to find the shortest sequence of actions\n    # State in queue: ((current_x, current_y), current_direction, list_of_actions_taken_to_reach_here)\n    queue = collections.deque([((initial_pos[0], initial_pos[1]), initial_dir, [])])\n    # Visited set: ((x, y), dir) to prevent cycles and redundant exploration\n    visited = {((initial_pos[0], initial_pos[1]), initial_dir)}\n\n    while queue:\n        (curr_x, curr_y), curr_dir, path_actions = queue.popleft()\n\n        # Check if current position is adjacent to any primitive and agent faces it correctly\n        for p_x, p_y in primitive_locations:\n            # Calculate delta from agent to primitive\n            dx_to_primitive = p_x - curr_x\n            dy_to_primitive = p_y - curr_y\n\n            # Check if primitive is directly adjacent (Manhattan distance of 1)\n            if abs(dx_to_primitive) + abs(dy_to_primitive) == 1:\n                # Determine the direction required for the agent to face the primitive\n                target_dir_for_pickup = None\n                if dx_to_primitive == 0 and dy_to_primitive == -1: target_dir_for_pickup = 0  # Primitive is North\n                elif dx_to_primitive == 1 and dy_to_primitive == 0: target_dir_for_pickup = 1  # Primitive is East\n                elif dx_to_primitive == 0 and dy_to_primitive == 1: target_dir_for_pickup = 2  # Primitive is South\n                elif dx_to_primitive == -1 and dy_to_primitive == 0: target_dir_for_pickup = 3  # Primitive is West\n\n                # If the agent is facing the primitive, we can pick it up\n                if target_dir_for_pickup is not None and curr_dir == target_dir_for_pickup:\n                    # Found a path to collect the primitive\n                    return path_actions + [_ACTIONS[\"USE\"]]\n\n        # Explore possible movement actions (UP, DOWN, LEFT, RIGHT)\n        for action_val in [_ACTIONS[\"UP\"], _ACTIONS[\"DOWN\"], _ACTIONS[\"LEFT\"], _ACTIONS[\"RIGHT\"]]:\n            # The new direction the agent will face after performing this movement action\n            new_dir = _ACTION_TO_DIR[action_val] \n\n            # Calculate the new position based on the direction of movement\n            delta_x, delta_y = _DIR_TO_DELTA[new_dir]\n            next_x, next_y = curr_x + delta_x, curr_y + delta_y\n\n            # Check if the next cell is walkable and the new state (position, direction) has not been visited\n            if _is_walkable(next_x, next_y):\n                next_state_key = ((next_x, next_y), new_dir)\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    new_path_actions = path_actions + [action_val]\n                    queue.append(((next_x, next_y), new_dir, new_path_actions))\n\n    # If the BFS queue is exhausted and no path to collect the primitive was found\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:10:41.453546", "function_name": "collect", "function_body": "  # Get action mappings\n  action_specs = env.action_specs()\n  ACTION_DOWN = action_specs[\"DOWN\"]\n  ACTION_UP = action_specs[\"UP\"]\n  ACTION_LEFT = action_specs[\"LEFT\"]\n  ACTION_RIGHT = action_specs[\"RIGHT\"]\n  ACTION_USE = action_specs[\"USE\"]\n\n  # Get initial observations\n  obs = env.observations()\n  # Use features_global for the full grid view for pathfinding\n  current_grid = obs[\"features_dict\"][\"features_global\"] \n  # Agent's current position (row, col)\n  current_pos = tuple(obs[\"features_dict\"][\"pos\"]) \n  # Agent's current direction, convert one-hot to int (0:N, 1:E, 2:S, 3:W)\n  current_dir = np.argmax(obs[\"features_dict\"][\"direction\"]) \n\n  # If the primitive is already in inventory, no actions needed to collect it\n  if obs[\"features_dict\"][\"inventory\"][primitive] > 0:\n    return []\n\n  grid_height, grid_width, _ = current_grid.shape\n  # Get indices of entities that cannot be picked up or moved through\n  non_grabbable_indices = env.world.non_grabbable_indices \n\n  # Find all cells on the grid that contain the primitive\n  item_positions = np.argwhere(current_grid[:, :, primitive] == 1)\n\n  # If the primitive is not found on the grid, it cannot be collected this way\n  if len(item_positions) == 0:\n    return []\n\n  # BFS setup\n  queue = collections.deque()\n  # State for BFS: (row, col, direction), representing agent's position and facing direction\n  start_state = (current_pos[0], current_pos[1], current_dir)\n  # Queue stores (current_state, path_to_current_state)\n  queue.append((start_state, [])) \n  \n  # Set to keep track of visited states to prevent cycles and redundant paths\n  visited = set()\n  visited.add(start_state)\n\n  goal_path = None # To store the found sequence of actions\n\n  # Define possible movement actions and their resulting agent direction\n  # (dr, dc, action_id, resulting_agent_direction)\n  # Directions: 0=North, 1=East, 2=South, 3=West\n  # Action IDs based on action_specs(): DOWN=0, UP=1, LEFT=2, RIGHT=3\n  moves = [\n      (-1, 0, ACTION_UP, 0),    # Move North (decreases row), agent faces North (0)\n      (1, 0, ACTION_DOWN, 2),   # Move South (increases row), agent faces South (2)\n      (0, -1, ACTION_LEFT, 3),  # Move West (decreases col), agent faces West (3)\n      (0, 1, ACTION_RIGHT, 1)   # Move East (increases col), agent faces East (1)\n  ]\n\n  # Perform BFS\n  while queue:\n    (r, c, d), path = queue.popleft()\n\n    # Check if the current state (agent's pos and dir) allows for collecting the primitive\n    for tr_item, tc_item in item_positions:\n      # Check if the agent is adjacent (Manhattan distance of 1) to the item\n      if abs(r - tr_item) + abs(c - tc_item) == 1:\n        # Determine the required direction the agent must face to \"USE\" the item\n        required_dir_to_face_item = -1\n        if tr_item < r: # Item is North of agent\n          required_dir_to_face_item = 0 # Agent must face North\n        elif tr_item > r: # Item is South of agent\n          required_dir_to_face_item = 2 # Agent must face South\n        elif tc_item < c: # Item is West of agent\n          required_dir_to_face_item = 3 # Agent must face West\n        elif tc_item > c: # Item is East of agent\n          required_dir_to_face_item = 1 # Agent must face East\n        \n        # If the agent is currently facing the required direction, a USE action can be performed\n        if d == required_dir_to_face_item:\n          goal_path = path + [ACTION_USE]\n          break # Found the shortest path to collect the item\n    \n    if goal_path:\n      break # Exit BFS, as a path has been found\n\n    # Explore neighboring states by applying movement actions\n    for dr, dc, action_val, new_d in moves:\n      nr, nc = r + dr, c + dc # New potential position\n\n      # Check boundary conditions of the grid\n      if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n        continue\n\n      # Check if the new cell is blocked by an impassable object\n      blocked = False\n      for i_kind in non_grabbable_indices:\n        # If any impassable kind is present at the new cell, it's blocked\n        if current_grid[nr, nc, i_kind] == 1:\n          blocked = True\n          break\n      if blocked:\n        continue\n\n      # Create the new state after movement\n      new_state = (nr, nc, new_d)\n      # If this state has not been visited, add it to the queue\n      if new_state not in visited:\n        visited.add(new_state)\n        queue.append((new_state, path + [action_val]))\n\n  # Return the found path or an empty list if no path was found\n  return goal_path if goal_path else []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:10:41.521989", "function_name": "collect", "function_body": "    action_mapping = env.action_specs()\n    MOVE_DOWN = action_mapping['DOWN']\n    MOVE_UP = action_mapping['UP']\n    MOVE_LEFT = action_mapping['LEFT']\n    MOVE_RIGHT = action_mapping['RIGHT']\n    USE = action_mapping['USE']\n\n    initial_state = env._current_state\n\n    # Check if the primitive is already in inventory\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    # BFS setup\n    queue = collections.deque()\n    # visited set stores (pos_x, pos_y, dir_int) to avoid redundant states\n    visited = set()\n\n    # Initial state for BFS: (current_craft_state, actions_taken_so_far)\n    queue.append((initial_state, []))\n    visited.add((initial_state.pos, initial_state.dir))\n\n    # All possible movement actions\n    movement_actions = [MOVE_DOWN, MOVE_UP, MOVE_LEFT, MOVE_RIGHT]\n\n    while queue:\n        current_state, path = queue.popleft()\n\n        # Prioritize the USE action if we are next to the primitive\n        if current_state.next_to(primitive):\n            # Simulate the USE action to see if it collects the primitive\n            _reward_use, state_after_use = current_state.step(USE)\n            \n            # If the inventory count of the primitive increased, we succeeded\n            if state_after_use.inventory[primitive] > current_state.inventory[primitive]:\n                return path + [USE]\n            # If USE did not collect it (e.g., it's not grabbable, or blocked),\n            # we don't treat this as a successful collection, and the agent\n            # might need to move. So, we continue to explore movement actions.\n\n        # Explore movement actions from the current state\n        for action in movement_actions:\n            # Simulate the action to get the next state\n            # The reward is not relevant for pathfinding here\n            _reward_move, new_state = current_state.step(action)\n\n            # A tuple (pos, dir) uniquely identifies a distinct agent state for pathfinding\n            new_state_key = (new_state.pos, new_state.dir)\n\n            # Check if this new state has been visited\n            if new_state_key not in visited:\n                visited.add(new_state_key)\n                queue.append((new_state, path + [action]))\n\n    # If the queue is empty and we haven't found/collected the primitive, it's unreachable\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:12:00.480152", "function_name": "collect", "function_body": "  import collections # Imported inside function as per constraint\n  \n  # --- Constants and Helper Functions (reused/adapted from collect_v0) ---\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  ACTION_TO_DIR_MAP = {\n      DOWN_ACTION: SOUTH_DIR,\n      UP_ACTION: NORTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"Calculates the direction the agent needs to face to look at the item.\n    Assumes item is adjacent to agent_x, agent_y.\n    \"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx > 0: return EAST_DIR\n    if dx < 0: return WEST_DIR\n    if dy > 0: return SOUTH_DIR\n    if dy < 0: return NORTH_DIR\n    return None # Should not be reached if item is adjacent and not on top of agent\n\n  def _get_turn_actions(current_dir, target_dir):\n    \"\"\"Returns a list of actions to turn from current_dir to target_dir.\"\"\"\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION)\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION)\n    return actions\n  # --- End Helper Functions ---\n\n  # --- Setup ---\n  primitive_id = env.world.cookbook.index[primitive]\n\n  current_state = env._current_state\n  grid = current_state.grid\n  agent_start_x, agent_start_y = current_state.pos\n  agent_start_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # --- Find Primitive Locations ---\n  primitive_y_coords, primitive_x_coords = np.where(grid[:, :, primitive_id] == 1)\n  primitive_locations = [(x, y) for x, y in zip(primitive_x_coords, primitive_y_coords)]\n\n  if not primitive_locations:\n    return [] # Primitive not found on the grid\n\n  # --- Identify Obstacles (Walkability Check) ---\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_walkable(x, y):\n    \"\"\"Checks if a cell at (x, y) is within bounds and does not contain non-grabbable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell contains any non-grabbable item (obstacle)\n    for obs_idx in non_grabbable_indices:\n      if grid[y, x, obs_idx] == 1:\n        return False\n    return True\n\n  # --- BFS for Shortest Path to an Adjacent Cell ---\n  # Queue stores tuples: ((pos_x, pos_y), current_direction, path_actions_so_far)\n  queue = collections.deque([\n      ((agent_start_x, agent_start_y), agent_start_dir, [])\n  ]) \n  \n  # Visited set stores tuples: ((pos_x, pos_y), current_direction) to prevent revisiting states\n  visited = set([\n      ((agent_start_x, agent_start_y), agent_start_dir)\n  ]) \n\n  # Movement options: (dy, dx, action_to_take) for exploring neighbors\n  # dy, dx are relative changes from current (y, x) to next (y, x)\n  move_options = [\n      (-1, 0, UP_ACTION),    # Move North (y-1)\n      (1, 0, DOWN_ACTION),   # Move South (y+1)\n      (0, -1, LEFT_ACTION),  # Move West (x-1)\n      (0, 1, RIGHT_ACTION)   # Move East (x+1)\n  ]\n\n  final_path_actions = None\n  final_agent_pos_after_move = None\n  final_agent_dir_after_move = None\n  target_primitive_pos_for_use = None\n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_so_far = queue.popleft()\n\n    # Check if current position is adjacent to any primitive location\n    for p_x, p_y in primitive_locations:\n      # Manhattan distance of 1 means adjacent (cardinal directions only)\n      if abs(curr_x - p_x) + abs(curr_y - p_y) == 1:\n        # Found a path to an adjacent cell. Store it and break BFS.\n        final_path_actions = path_so_far\n        final_agent_pos_after_move = (curr_x, curr_y)\n        final_agent_dir_after_move = curr_dir\n        target_primitive_pos_for_use = (p_x, p_y)\n        break # Break from inner loop (found adjacent primitive)\n    \n    if final_path_actions is not None:\n      break # Break from outer BFS loop (found shortest path)\n\n    # Explore neighbors\n    for dy, dx, action_to_take in move_options:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n      next_dir = ACTION_TO_DIR_MAP[action_to_take] # Direction agent will face after this move\n\n      # If cell is walkable and this specific (position, direction) state hasn't been visited\n      if is_walkable(next_x, next_y) and ((next_pos, next_dir) not in visited):\n        visited.add((next_pos, next_dir))\n        new_path_actions = path_so_far + [action_to_take]\n        queue.append((next_pos, next_dir, new_path_actions))\n\n  # --- Finalize Path (Add Turns and USE action) ---\n  if final_path_actions is None:\n    return [] # No path found to any primitive\n\n  # Agent is at final_agent_pos_after_move facing final_agent_dir_after_move.\n  # Now, determine turns to face the primitive and add the USE action.\n  \n  # This check should ideally always pass if final_path_actions is not None\n  if target_primitive_pos_for_use is None:\n      return [] \n\n  target_face_dir = _get_target_facing_direction(\n      final_agent_pos_after_move[0], final_agent_pos_after_move[1],\n      target_primitive_pos_for_use[0], target_primitive_pos_for_use[1]\n  )\n\n  # This check handles edge cases where an adjacent cell might not allow a direct facing direction\n  # (e.g., if item is not directly cardinal, though current logic only finds cardinal adjacency)\n  if target_face_dir is None:\n      return [] \n\n  turn_actions = _get_turn_actions(final_agent_dir_after_move, target_face_dir)\n  \n  full_action_sequence = final_path_actions + turn_actions + [USE_ACTION]\n\n  return full_action_sequence", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T16:12:01.483400", "function_name": "collect", "function_body": "  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Direction constants (assuming 0=N, 1=E, 2=S, 3=W clockwise from North)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Map movement actions to the direction the agent faces after taking that action\n  ACTION_TO_DIR_MAP = {\n      DOWN_ACTION: SOUTH_DIR,\n      UP_ACTION: NORTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  def _get_action_for_move_xy(current_x, current_y, target_x, target_y):\n    \"\"\"Returns the single action to move towards target_x, target_y from current_x, current_y.\n    Prioritizes horizontal movement if not at target_x, otherwise vertical.\n    \"\"\"\n    if target_x > current_x: return RIGHT_ACTION\n    if target_x < current_x: return LEFT_ACTION\n    if target_y > current_y: return DOWN_ACTION\n    if target_y < current_y: return UP_ACTION\n    return None # Already at target x or y\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"Calculates the direction the agent needs to face to look at the item.\n    Assumes item is adjacent to agent_x, agent_y.\n    \"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx > 0: return EAST_DIR\n    if dx < 0: return WEST_DIR\n    if dy > 0: return SOUTH_DIR\n    if dy < 0: return NORTH_DIR\n    return None # Should not be reached if item is adjacent and not on top of agent\n\n  def _get_turn_actions(current_dir, target_dir):\n    \"\"\"Returns a list of actions to turn from current_dir to target_dir.\"\"\"\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    # Calculate shortest turns (clockwise vs. counter-clockwise)\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION)\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION)\n    return actions\n\n  # Get primitive's integer ID\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir\n  # grid.shape is (HEIGHT, WIDTH, KINDS)\n  grid_height, grid_width, _ = grid.shape\n\n  # Find all locations of the primitive on the grid\n  # np.where returns (row_indices, col_indices) which correspond to (y_coords, x_coords)\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Find the closest primitive location to the agent's current position (Manhattan distance)\n  min_distance = float('inf')\n  closest_primitive_pos = None\n\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i][i] # Corrected from y_coords[i], x_coords[i] for tuple iteration\n    distance = abs(item_x - agent_pos_x) + abs(item_y - agent_pos_y)\n    if distance < min_distance:\n      min_distance = distance\n      closest_primitive_pos = (item_x, item_y)\n\n  target_item_x, target_item_y = closest_primitive_pos\n\n  # Determine the target adjacent position for the agent to move to.\n  # We look for the adjacent cell that is closest to the agent's current position.\n  candidate_adj_positions = []\n  # Iterate over cardinal neighbors relative to the item\n  for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (left, right, up, down)\n    adj_x, adj_y = target_item_x + dx, target_item_y + dy\n    # Check if the candidate adjacent position is within grid boundaries\n    if 0 <= adj_x < grid_width and 0 <= adj_y < grid_height:\n      candidate_adj_positions.append((adj_x, adj_y))\n\n  if not candidate_adj_positions:\n    return [] # Should not happen unless the primitive is stuck in a 1x1 area with no accessible neighbors\n\n  # Select the candidate adjacent position that is closest to the agent's initial position\n  min_adj_distance = float('inf')\n  chosen_adj_pos = None\n  for adj_x, adj_y in candidate_adj_positions:\n    distance = abs(adj_x - agent_pos_x) + abs(adj_y - agent_pos_y)\n    if distance < min_adj_distance:\n      min_adj_distance = distance\n      chosen_adj_pos = (adj_x, adj_y)\n\n  if chosen_adj_pos is None:\n    return [] # No valid adjacent position found (e.g., primitive is at a corner with no space)\n\n  # Generate movement actions to reach the chosen_adj_pos,\n  # while continuously updating the conceptual agent position and direction.\n  actions = []\n  curr_x, curr_y = agent_pos_x, agent_pos_y\n  curr_dir = agent_dir # Current conceptual direction of the agent\n  target_agent_x, target_agent_y = chosen_adj_pos\n\n  # Pathfinding: Move step by step until the agent reaches the target adjacent position.\n  # Use a single loop that continuously tries to move towards the target.\n  while curr_x != target_agent_x or curr_y != target_agent_y:\n    move_action = _get_action_for_move_xy(curr_x, curr_y, target_agent_x, target_agent_y)\n    if move_action is None:\n      # This implies the agent is already at the target, but the loop condition says otherwise.\n      # This case should ideally not be reached if chosen_adj_pos is different from curr_x,curr_y.\n      break # Avoid infinite loops in case of logic error\n\n    actions.append(move_action)\n\n    # Update conceptual position based on the chosen move_action\n    if move_action == RIGHT_ACTION:\n      curr_x += 1\n    elif move_action == LEFT_ACTION:\n      curr_x -= 1\n    elif move_action == DOWN_ACTION:\n      curr_y += 1\n    elif move_action == UP_ACTION:\n      curr_y -= 1\n\n    # Update conceptual direction based on the movement action\n    curr_dir = ACTION_TO_DIR_MAP[move_action]\n\n  # After movement, the agent is conceptually at `chosen_adj_pos`.\n  # `curr_dir` holds the direction the agent is facing after the last movement action.\n  # Now, determine the direction the agent needs to face to look at the primitive from this adjacent position.\n  target_face_dir = _get_target_facing_direction(curr_x, curr_y, target_item_x, target_item_y)\n\n  if target_face_dir is not None:\n    # Add turning actions to face the primitive, based on the agent's current conceptual direction\n    # and the required final facing direction.\n    actions.extend(_get_turn_actions(curr_dir, target_face_dir))\n\n  # Add the USE action to collect the primitive\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:12:54.627418", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Action and Direction Constants\n  # These are numerical values for actions that can be passed to env.step().\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # These are numerical values representing the agent's facing direction.\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  # Map agent's facing direction to (dx, dy) delta for moving \"forward\" in that direction.\n  # (dx, dy) represents the change in (x, y) coordinates.\n  # Assuming (x,y) corresponds to (column, row) in the grid, where +x is right, +y is down.\n  DIR_DELTAS = {\n      DIR_UP: (0, -1),   # Moving up: x constant, y decreases\n      DIR_RIGHT: (1, 0),  # Moving right: x increases, y constant\n      DIR_DOWN: (0, 1),   # Moving down: x constant, y increases\n      DIR_LEFT: (-1, 0),  # Moving left: x decreases, y constant\n  }\n\n  # Map a movement action to the agent's resulting facing direction.\n  # In CraftWorld, movement actions also orient the agent in the direction of movement.\n  ACTION_TO_RESULTING_DIR = {\n      ACTION_UP: DIR_UP,\n      ACTION_RIGHT: DIR_RIGHT,\n      ACTION_DOWN: DIR_DOWN,\n      ACTION_LEFT: DIR_LEFT,\n  }\n\n  # List of all movement actions (excluding USE).\n  MOVEMENT_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # --- Improvement for v2: Check if primitive is already in inventory ---\n  # Get current observations to access the inventory\n  current_obs = env.observations()\n  current_inventory = current_obs['features_dict']['inventory']\n  \n  # If the primitive is already in the inventory, we don't need to collect it.\n  if current_inventory[primitive] > 0:\n      return []\n  # --- End of improvement ---\n\n  # 1. Get current state information from the environment.\n  # Use the already fetched current_obs\n  grid = current_obs['features_dict']['features_global']\n  \n  # Extract current agent position (x, y) and direction.\n  current_pos_x, current_pos_y = current_obs['features_dict']['pos'].astype(int)\n  current_dir = np.argmax(current_obs['features_dict']['direction'])\n\n  # Get world configuration, specifically non-grabbable entities that act as obstacles.\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n\n  grid_width, grid_height, _ = grid.shape\n\n  # 2. Determine traversable cells on the grid.\n  # A cell is considered NOT traversable if it contains any non-grabbable item.\n  traversable_mask = np.ones((grid_width, grid_height), dtype=bool)\n  if non_grabbable_indices:\n      # Create a boolean mask where True indicates an obstacle of any non-grabbable kind.\n      # `grid[:, :, list(non_grabbable_indices)]` selects all cells for these specific kinds.\n      # `np.any(..., axis=2)` checks if any of these non-grabbable kinds are present in a cell.\n      cells_with_obstacles = np.any(grid[:, :, list(non_grabbable_indices)] > 0, axis=2)\n      traversable_mask[cells_with_obstacles] = False\n  \n  # The agent's starting position must be traversable to begin the search.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return [] # Cannot move from an untraversable starting point.\n\n  # 3. Identify all locations on the grid where the target primitive exists.\n  primitive_locations_on_grid = []\n  # `np.where` returns (row_indices, col_indices) for elements matching the condition.\n  # Since grid is `(WIDTH, HEIGHT, K)`, row_indices are y-coordinates and col_indices are x-coordinates.\n  y_coords_of_primitive, x_coords_of_primitive = np.where(grid[:, :, primitive] > 0)\n  for x, y in zip(x_coords_of_primitive, y_coords_of_primitive):\n      primitive_locations_on_grid.append((x, y))\n\n  if not primitive_locations_on_grid:\n      return [] # The primitive is not present anywhere on the map.\n\n  # 4. Identify \"collectable target states\" for the agent.\n  # A target state is (agent_x, agent_y, agent_direction) from which the ACTION_USE\n  # can successfully collect the primitive. This requires the agent to be adjacent\n  # to the primitive and facing it.\n  collectable_target_states = set()\n  for p_x, p_y in primitive_locations_on_grid:\n      # Iterate over the four cells adjacent to the primitive.\n      # `delta_x_from_primitive, delta_y_from_primitive` define the relative position of the agent\n      # if the agent were to be at one of the four cardinal neighbors of the primitive.\n      for delta_x_from_primitive, delta_y_from_primitive in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          # Calculate the agent's potential position (a_x, a_y).\n          a_x, a_y = p_x + delta_x_from_primitive, p_y + delta_y_from_primitive\n\n          # Check if this potential agent position is within grid boundaries and is traversable.\n          if not (0 <= a_x < grid_width and 0 <= a_y < grid_height and traversable_mask[a_x, a_y]):\n              continue\n          \n          # Determine the required direction the agent must face from (a_x, a_y) to collect (p_x, p_y).\n          # This is the vector from the agent's position to the primitive's position.\n          vector_to_primitive_x, vector_to_primitive_y = p_x - a_x, p_y - a_y\n\n          required_agent_dir = -1\n          # Find which direction delta matches the vector from agent to primitive.\n          for d_val, (dx, dy) in DIR_DELTAS.items():\n              if dx == vector_to_primitive_x and dy == vector_to_primitive_y:\n                  required_agent_dir = d_val\n                  break\n          \n          if required_agent_dir != -1:\n              collectable_target_states.add((a_x, a_y, required_agent_dir))\n\n  if not collectable_target_states:\n      return [] # No valid states exist from which the primitive can be collected.\n\n  # 5. Perform a Breadth-First Search (BFS) on the state space.\n  # A state is defined by (agent_x, agent_y, agent_direction).\n  start_state = (current_pos_x, current_pos_y, current_dir)\n  \n  # The queue stores tuples: ((current_x, current_y, current_dir), [list_of_actions_taken_to_reach_this_state]).\n  q = deque([(start_state, [])]) \n  \n  # The `visited_states` set keeps track of states already explored to prevent cycles and redundant paths.\n  visited_states = {start_state}\n\n  while q:\n      (curr_x, curr_y, curr_dir), path_actions = q.popleft()\n\n      # Check if the current state is one of our desired collectable target states.\n      if (curr_x, curr_y, curr_dir) in collectable_target_states:\n          # If it is, we've found the shortest path. Append the USE action and return.\n          return path_actions + [ACTION_USE]\n\n      # Explore all possible next states by applying movement actions.\n      for action_taken in MOVEMENT_ACTIONS:\n          # Determine the agent's new direction and position after taking this action.\n          next_dir = ACTION_TO_RESULTING_DIR[action_taken]\n          dx_move, dy_move = DIR_DELTAS[next_dir]\n          \n          next_x, next_y = curr_x + dx_move, curr_y + dy_move\n\n          next_state = (next_x, next_y, next_dir)\n\n          # Check if the next cell is within grid boundaries, is traversable,\n          # and this specific (position, direction) state has not been visited yet.\n          if (0 <= next_x < grid_width and 0 <= next_y < grid_height and\n              traversable_mask[next_x, next_y] and\n              next_state not in visited_states):\n              \n              # Mark the new state as visited and add it to the queue for further exploration.\n              visited_states.add(next_state)\n              q.append((next_state, path_actions + [action_taken]))\n  \n  # If the BFS queue becomes empty and no path to a target state was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:12:54.696952", "function_name": "collect", "function_body": "    from collections import deque\n    import numpy as np\n\n    # Action and Direction Constants\n    # These are numerical values for actions that can be passed to env.step().\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # These are numerical values representing the agent's facing direction.\n    DIR_UP = 0\n    DIR_RIGHT = 1\n    DIR_DOWN = 2\n    DIR_LEFT = 3\n\n    # Map agent's facing direction to (dx, dy) delta for moving \"forward\" in that direction.\n    DIR_DELTAS = {\n        DIR_UP: (0, -1),\n        DIR_RIGHT: (1, 0),\n        DIR_DOWN: (0, 1),\n        DIR_LEFT: (-1, 0),\n    }\n\n    # Map a movement action to the agent's resulting facing direction.\n    ACTION_TO_RESULTING_DIR = {\n        ACTION_UP: DIR_UP,\n        ACTION_RIGHT: DIR_RIGHT,\n        ACTION_DOWN: DIR_DOWN,\n        ACTION_LEFT: DIR_LEFT,\n    }\n\n    # List of all movement actions (excluding USE).\n    MOVEMENT_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n    # Improvement 1: Check if the primitive is already in the agent's inventory.\n    # If the goal is to simply ensure the agent has the primitive, and it already does,\n    # then no actions are needed.\n    obs = env.observations()\n    if obs['features_dict']['inventory'][primitive] > 0:\n        return []\n\n    # Get current state information from the environment.\n    grid = obs['features_dict']['features_global']\n    current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n    current_dir = np.argmax(obs['features_dict']['direction'])\n\n    # Get world configuration, specifically non-grabbable entities that act as obstacles.\n    world = env.world\n    non_grabbable_indices = world.non_grabbable_indices\n\n    grid_width, grid_height, _ = grid.shape\n\n    # Determine traversable cells on the grid.\n    traversable_mask = np.ones((grid_width, grid_height), dtype=bool)\n    if non_grabbable_indices:\n        cells_with_obstacles = np.any(grid[:, :, list(non_grabbable_indices)] > 0, axis=2)\n        traversable_mask[cells_with_obstacles] = False\n    \n    # The agent's starting position must be traversable to begin the search.\n    if not traversable_mask[current_pos_x, current_pos_y]:\n        # This case is rare if the environment is well-formed, but handles agents\n        # potentially spawned on an obstacle.\n        return [] \n\n    # Identify all locations on the grid where the target primitive exists.\n    primitive_locations_on_grid = []\n    y_coords_of_primitive, x_coords_of_primitive = np.where(grid[:, :, primitive] > 0)\n    for x, y in zip(x_coords_of_primitive, y_coords_of_primitive):\n        primitive_locations_on_grid.append((x, y))\n\n    if not primitive_locations_on_grid:\n        return [] # The primitive is not present anywhere on the map.\n\n    # Identify \"collectable target states\" for the agent.\n    # A target state is (agent_x, agent_y, agent_direction) from which the ACTION_USE\n    # can successfully collect the primitive. This requires the agent to be adjacent\n    # to the primitive and facing it.\n    collectable_target_states = set()\n    for p_x, p_y in primitive_locations_on_grid:\n        # Iterate over the four cells adjacent to the primitive.\n        for delta_x_from_primitive, delta_y_from_primitive in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            # Calculate the agent's potential position (a_x, a_y).\n            a_x, a_y = p_x + delta_x_from_primitive, p_y + delta_y_from_primitive\n\n            # Check if this potential agent position is within grid boundaries and is traversable.\n            if not (0 <= a_x < grid_width and 0 <= a_y < grid_height and traversable_mask[a_x, a_y]):\n                continue\n            \n            # Determine the required direction the agent must face from (a_x, a_y) to collect (p_x, p_y).\n            vector_to_primitive_x, vector_to_primitive_y = p_x - a_x, p_y - a_y\n\n            required_agent_dir = -1\n            for d_val, (dx, dy) in DIR_DELTAS.items():\n                if dx == vector_to_primitive_x and dy == vector_to_primitive_y:\n                    required_agent_dir = d_val\n                    break\n            \n            if required_agent_dir != -1:\n                collectable_target_states.add((a_x, a_y, required_agent_dir))\n\n    if not collectable_target_states:\n        return [] # No valid states exist from which the primitive can be collected.\n\n    # Perform a Breadth-First Search (BFS) on the state space.\n    # A state is defined by (agent_x, agent_y, agent_direction).\n    start_state = (current_pos_x, current_pos_y, current_dir)\n    \n    # The queue stores tuples: ((current_x, current_y, current_dir), [list_of_actions_taken_to_reach_this_state]).\n    q = deque([(start_state, [])]) \n    \n    # The `visited_states` set keeps track of states already explored to prevent cycles and redundant paths.\n    visited_states = {start_state}\n\n    while q:\n        (curr_x, curr_y, curr_dir), path_actions = q.popleft()\n\n        # Check if the current state is one of our desired collectable target states.\n        if (curr_x, curr_y, curr_dir) in collectable_target_states:\n            # If it is, we've found the shortest path. Append the USE action and return.\n            return path_actions + [ACTION_USE]\n\n        # Explore all possible next states by applying movement actions.\n        for action_taken in MOVEMENT_ACTIONS:\n            # Determine the agent's new direction and position after taking this action.\n            next_dir = ACTION_TO_RESULTING_DIR[action_taken]\n            dx_move, dy_move = DIR_DELTAS[next_dir]\n            \n            next_x, next_y = curr_x + dx_move, curr_y + dy_move\n            next_state = (next_x, next_y, next_dir)\n\n            # Check if the next cell is within grid boundaries, is traversable,\n            # and this specific (position, direction) state has not been visited yet.\n            if (0 <= next_x < grid_width and 0 <= next_y < grid_height and\n                traversable_mask[next_x, next_y] and\n                next_state not in visited_states):\n                \n                # Mark the new state as visited and add it to the queue for further exploration.\n                visited_states.add(next_state)\n                q.append((next_state, path_actions + [action_taken]))\n  \n    # If the BFS queue becomes empty and no path to a target state was found, return an empty list.\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:14:38.922697", "function_name": "collect", "function_body": "  # Imports must be inside the function body as per instructions.\n  import numpy as np\n  from collections import deque\n\n  # Constants for actions based on CraftLab.action_specs()\n  _DOWN = 0\n  _UP = 1\n  _LEFT = 2\n  _RIGHT = 3\n  _USE = 4\n\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos\n  width, height, n_kinds = grid.shape\n\n  # Get the index for 'empty' tiles from the world's cookbook index.\n  # This is crucial for determining traversable cells.\n  try:\n    empty_index = env.world.cookbook.index['empty']\n  except KeyError:\n    # If 'empty' is not defined in the world's index, this pathfinding strategy\n    # cannot determine traversable cells correctly. Return an empty list.\n    return []\n\n  actions = []\n\n  # 1. Find all locations on the grid where the target primitive exists.\n  primitive_locations = []\n  for x in range(width):\n    for y in range(height):\n      if grid[x, y, primitive] > 0:  # Check if the primitive kind exists at this cell\n        primitive_locations.append((x, y))\n\n  if not primitive_locations:\n    return []  # Primitive not found anywhere on the grid\n\n  # 2. Choose the closest primitive location from the agent's current position,\n  #    using Manhattan distance for simplicity.\n  def manhattan_distance(p1, p2):\n    return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  closest_primitive_pos = None\n  min_dist = float('inf')\n  for p_pos in primitive_locations:\n    dist = manhattan_distance(current_pos, p_pos)\n    if dist < min_dist:\n      min_dist = dist\n      closest_primitive_pos = p_pos\n\n  if closest_primitive_pos is None:\n    # This case should ideally not be reached if primitive_locations was not empty,\n    # but included for robustness.\n    return []\n\n  # 3. Define potential target cells for the agent to move to.\n  #    The agent needs to be in a position from which it can \"USE\" the primitive.\n  #    This typically means cells in the 3x3 neighborhood around the primitive's\n  #    position that are also traversable by the agent (i.e., contain the 'empty' kind).\n  target_px, target_py = closest_primitive_pos\n  \n  potential_agent_target_cells = []\n  # Iterate through the 3x3 neighborhood around the primitive's position\n  for dx in [-1, 0, 1]:\n    for dy in [-1, 0, 1]:\n      nx, ny = target_px + dx, target_py + dy\n      # Check boundary conditions\n      if 0 <= nx < width and 0 <= ny < height:\n        # Check if the cell is traversable (i.e., contains the 'empty' kind).\n        # We assume the agent can only move to and occupy 'empty' cells.\n        if grid[nx, ny, empty_index] > 0:\n          potential_agent_target_cells.append((nx, ny))\n  \n  if not potential_agent_target_cells:\n    # No empty, traversable cell found around the primitive.\n    # This implies the primitive might be unreachable or completely surrounded by\n    # non-traversable terrain. In such a scenario, the agent cannot perform USE.\n    return []\n\n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    from the agent's current position to any of the `potential_agent_target_cells`.\n  \n  queue = deque([(current_pos, [])])  # (position, list_of_actions_taken_to_reach_here)\n  visited = {current_pos}  # Keep track of visited cells to avoid cycles and redundant paths\n\n  path_to_target_cell = []\n  \n  # Map (dx, dy) movement deltas to corresponding action constants\n  action_deltas = {\n      (0, 1): _DOWN,   # Moving one step in positive Y direction (down)\n      (0, -1): _UP,    # Moving one step in negative Y direction (up)\n      (-1, 0): _LEFT,  # Moving one step in negative X direction (left)\n      (1, 0): _RIGHT   # Moving one step in positive X direction (right)\n  }\n\n  while queue:\n    (cx, cy), current_path = queue.popleft()\n\n    # If the current cell is one of our potential target cells, we've found\n    # the shortest path to a suitable position for using the primitive.\n    if (cx, cy) in potential_agent_target_cells:\n      path_to_target_cell = current_path\n      break\n\n    # Explore valid neighboring cells (4-directional: up, down, left, right)\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Iterate through possible moves\n      nx, ny = cx + dx, cy + dy\n\n      # Check if the neighbor is within grid bounds and has not been visited yet\n      if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n        # Check if the neighboring cell is traversable (contains 'empty' kind).\n        if grid[nx, ny, empty_index] > 0:\n          visited.add((nx, ny))\n          new_path = current_path + [action_deltas[(dx, dy)]]\n          queue.append(((nx, ny), new_path))\n  \n  if not path_to_target_cell:\n    # If no path was found to any empty cell around the primitive.\n    # This could happen if the agent is trapped or the target is completely isolated.\n    return []\n\n  # 5. Add the found path (sequence of movement actions) to the overall actions list.\n  actions.extend(path_to_target_cell)\n\n  # 6. After moving to the target cell, perform the USE action to attempt to collect the primitive.\n  actions.append(_USE)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:14:38.992400", "function_name": "collect", "function_body": "    from collections import deque\n\n    # Helper function to get delta (dx, dy) from a movement action\n    ACTION_DELTAS = {\n        env_factory.UP: (0, -1),\n        env_factory.DOWN: (0, 1),\n        env_factory.LEFT: (-1, 0),\n        env_factory.RIGHT: (1, 0),\n    }\n\n    def _get_required_dir_to_face(agent_pos, target_pos):\n        \"\"\"\n        Determines the direction an agent at agent_pos needs to face to USE\n        an object at target_pos. Assumes agent_pos and target_pos are adjacent.\n        \"\"\"\n        ax, ay = agent_pos\n        tx, ty = target_pos\n\n        if tx > ax:\n            return env_factory.RIGHT\n        if tx < ax:\n            return env_factory.LEFT\n        if ty > ay:\n            return env_factory.DOWN\n        if ty < ay:\n            return env_factory.UP\n        return None # Should not happen if positions are adjacent\n\n    # Get current state information\n    current_state = env._current_state\n    grid = current_state.grid\n    start_pos = current_state.pos\n    start_dir = current_state.dir\n    grid_width, grid_height, _ = grid.shape\n\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # Find all target primitive locations\n    target_object_coords = []\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if grid[x, y, primitive] == 1:\n                target_object_coords.append((x, y))\n\n    if not target_object_coords:\n        return [] # No primitive found on the map\n\n    # BFS Initialization\n    # Queue stores tuples: (current_position_tuple, current_direction_int, path_list_so_far)\n    queue = deque([(start_pos, start_dir, [])]) \n    \n    # Visited set stores tuples: (position_tuple, direction_int) to avoid cycles and redundant paths\n    visited = set([(start_pos, start_dir)])\n\n    best_path = None\n\n    while queue:\n        current_pos, current_dir, path_so_far = queue.popleft()\n        cx, cy = current_pos\n\n        # Optimization: If current path length already equals or exceeds the best path found so far,\n        # there's no need to continue down this branch as it won't be shorter.\n        if best_path is not None and len(path_so_far) >= len(best_path):\n            continue\n\n        # Check if we can collect a primitive from this position and direction\n        for tx, ty in target_object_coords:\n            # Check if current_pos is adjacent to (tx, ty)\n            if abs(cx - tx) + abs(cy - ty) == 1: # Manhattan distance 1 means adjacent\n                required_dir = _get_required_dir_to_face((cx, cy), (tx, ty))\n                if current_dir == required_dir:\n                    # Found a valid collection point: agent is adjacent and facing the primitive\n                    current_total_path = path_so_far + [env_factory.USE]\n                    if best_path is None or len(current_total_path) < len(best_path):\n                        best_path = current_total_path\n                    # Do not break here; continue BFS to find potentially shorter paths to other primitives or the same one.\n\n        # Explore possible movement actions\n        for action_move, (dx, dy) in ACTION_DELTAS.items():\n            next_cx, next_cy = cx + dx, cy + dy\n            next_pos = (next_cx, next_cy)\n            next_dir = action_move # Agent's direction changes to the direction of the movement action\n\n            # Check bounds\n            if not (0 <= next_cx < grid_width and 0 <= next_cy < grid_height):\n                continue\n\n            # Check if this (position, direction) state has been visited\n            if (next_pos, next_dir) in visited:\n                continue\n\n            # Check for obstacles: cells occupied by non-grabbable items or the primitive itself\n            is_obstacle = False\n            for k_idx in non_grabbable_indices:\n                if grid[next_cx, next_cy, k_idx] == 1:\n                    is_obstacle = True\n                    break\n            \n            # Agent cannot move into the cell occupied by the primitive it wants to collect\n            if grid[next_cx, next_cy, primitive] == 1:\n                is_obstacle = True\n            \n            if is_obstacle:\n                continue\n\n            # Add the new state to the queue and visited set\n            visited.add((next_pos, next_dir))\n            queue.append((next_pos, next_dir, path_so_far + [action_move]))\n\n    return best_path if best_path is not None else []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:15:49.142081", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants based on CraftLab.action_specs()\n  # These are fixed numerical values for the CraftLab interface.\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # 1. Get the current state observations from the environment\n  obs = env.observations()\n  current_inventory = obs['inventory']\n\n  # 2. Check if the primitive is already in the agent's inventory\n  if current_inventory[primitive] > 0:\n      return [] # Primitive is already collected, no actions needed\n\n  # Extract the current grid and the agent's position\n  grid = obs['features_global']\n  current_pos_x, current_pos_y = int(obs['pos'][0]), int(obs['pos'][1])\n  \n  # Get grid dimensions (width, height, number of kinds)\n  grid_width, grid_height, _ = grid.shape\n\n  # 3. Find all cells on the grid that contain the target primitive\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if grid[x, y, primitive] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # The primitive is not present anywhere on the grid\n      return []\n\n  # Helper function to determine if a given cell (cx, cy) is \"interaction-reachable\".\n  # This means the agent, if standing at (cx, cy), can use the 'USE' action to collect the primitive.\n  # Based on CraftState.next_to, this implies being on the primitive's cell or in its 3x3 neighborhood.\n  def is_interaction_reachable(cx, cy):\n      for px, py in primitive_locations:\n          # Check if (cx, cy) is within the 3x3 square centered at (px, py)\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              return True\n      return False\n\n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to any cell from which the primitive can be collected.\n  queue = collections.deque()\n  visited = set() # Stores (x, y) coordinates to avoid cycles and redundant path explorations\n\n  # BFS state: (current_x, current_y, list_of_actions_taken_to_reach_here)\n  queue.append((current_pos_x, current_pos_y, []))\n  visited.add((current_pos_x, current_pos_y))\n\n  # Define possible moves and their corresponding action constants\n  # Maps (delta_x, delta_y) to the action ID\n  moves = {\n      (0, 1): ACTION_DOWN,  # Moving down increases Y-coordinate\n      (0, -1): ACTION_UP,   # Moving up decreases Y-coordinate\n      (-1, 0): ACTION_LEFT, # Moving left decreases X-coordinate\n      (1, 0): ACTION_RIGHT  # Moving right increases X-coordinate\n  }\n\n  while queue:\n      curr_x, curr_y, path_actions = queue.popleft()\n\n      # If the current cell is interaction-reachable, we've found our target\n      if is_interaction_reachable(curr_x, curr_y):\n          # Append the 'USE' action to the path and return the complete sequence\n          return path_actions + [ACTION_USE]\n\n      # Explore all valid neighboring cells (up, down, left, right)\n      for (dx, dy), action in moves.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n\n          # Check if the next position is within the grid boundaries\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Check if this cell has already been visited to ensure the shortest path\n          if (next_x, next_y) in visited:\n              continue\n\n          # Mark the cell as visited and add it to the queue with the updated path\n          visited.add((next_x, next_y))\n          queue.append((next_x, next_y, path_actions + [action]))\n\n  # If the BFS completes and no path to an interaction-reachable primitive location was found\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:15:50.139671", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:17:01.485724", "function_name": "collect", "function_body": "    actions = []\n    current_state = env._current_state\n\n    # Check if the primitive is already collected\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Maximum number of steps to attempt to collect the primitive.\n    # This acts as a planning horizon to prevent infinite loops if the primitive is unreachable.\n    max_planning_steps = 200\n\n    for _ in range(max_planning_steps):\n        # Update the current state from the environment after each simulated step\n        current_state = env._current_state\n\n        # Check if the primitive has been collected in the current state\n        if current_state.inventory[primitive] > 0:\n            break  # Goal achieved, exit loop\n\n        found_primitive_pos = None\n        grid_width, grid_height, _ = current_state.grid.shape\n\n        # Search for the primitive's location on the grid\n        for x in range(grid_width):\n            for y in range(grid_height):\n                if current_state.grid[x, y, primitive] > 0:\n                    found_primitive_pos = (x, y)\n                    break\n            if found_primitive_pos:\n                break\n\n        # If the primitive is no longer found on the grid, it might be unreachable\n        # or has been consumed/collected by some other means (unlikely in simple CraftWorld).\n        # Return the actions collected so far.\n        if not found_primitive_pos:\n            return actions\n\n        agent_x, agent_y = current_state.pos\n        target_x, target_y = found_primitive_pos\n\n        if (agent_x, agent_y) == (target_x, target_y):\n            # Agent is currently on the same cell as the primitive.\n            # Attempt to use (collect) the primitive.\n            actions.append(env_factory.ACTIONS.USE)\n            _, _, _ = env.step(env_factory.ACTIONS.USE)  # Apply action to update env's internal state\n        else:\n            # Agent is not on the primitive's cell; plan a movement towards it.\n            dx = target_x - agent_x\n            dy = target_y - agent_y\n\n            action_to_take = None\n\n            # Prioritize movement along the axis with the larger difference\n            # to reduce the Manhattan distance faster.\n            if abs(dx) > abs(dy):\n                if dx > 0:\n                    action_to_take = env_factory.ACTIONS.RIGHT\n                else:  # dx < 0\n                    action_to_take = env_factory.ACTIONS.LEFT\n            else:  # abs(dy) >= abs(dx)\n                if dy > 0:\n                    action_to_take = env_factory.ACTIONS.DOWN\n                else:  # dy < 0\n                    action_to_take = env_factory.ACTIONS.UP\n\n            if action_to_take is not None:\n                actions.append(action_to_take)\n                _, _, _ = env.step(action_to_take)  # Apply action to update env's internal state\n            else:\n                # This condition should ideally not be met if (agent_x, agent_y) != (target_x, target_y).\n                # It would imply dx=0 and dy=0, which is covered by the first 'if' block.\n                # If it's reached, it means no valid movement could be planned (e.g., target is blocked).\n                break # Give up planning if no progress can be made\n\n    return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:17:02.471054", "function_name": "collect", "function_body": "  obs = env.observations()\n  features_dict = obs['features_dict']\n\n  inventory = features_dict['inventory']\n  current_grid = features_dict['features_global']\n  \n  # Grid dimensions (Width, Height, Number of Kinds)\n  grid_width, grid_height, _ = current_grid.shape\n  \n  # Convert normalized position to integer grid coordinates\n  current_pos_normalized = features_dict['pos']\n  current_x = int(round(current_pos_normalized[0] * (grid_width - 1)))\n  current_y = int(round(current_pos_normalized[1] * (grid_height - 1)))\n  current_pos = (current_x, current_y)\n\n  # 1. Check if primitive is already in inventory (amount > 0)\n  if inventory[primitive] > 0:\n      return []\n\n  # 2. Check if primitive is in the 3x3 neighborhood (including current cell)\n  # This replicates `CraftState.next_to` logic\n  is_next_to = False\n  # Iterate over 3x3 neighborhood (dx, dy from -1 to 1)\n  for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n          nx, ny = current_x + dx, current_y + dy\n          # Check bounds\n          if 0 <= nx < grid_width and 0 <= ny < grid_height:\n              # Check if the primitive exists at this neighboring cell\n              if current_grid[nx, ny, primitive] > 0:\n                  is_next_to = True\n                  break\n      if is_next_to:\n          break\n\n  if is_next_to:\n      # If next to the primitive, use it to collect (USE action is 4)\n      return [4] # USE\n\n  # 3. Find the primitive on the global grid and plan a move\n  # Find all cells where the primitive is present\n  primitive_locations = np.argwhere(current_grid[:, :, primitive] > 0)\n\n  if len(primitive_locations) == 0:\n      # Primitive not found anywhere on the visible grid\n      return []\n\n  # Find the closest primitive location using Manhattan distance\n  min_dist = float('inf')\n  target_pos = None\n\n  for loc in primitive_locations:\n      # loc is (x, y)\n      dist = abs(loc[0] - current_x) + abs(loc[1] - current_y)\n      if dist < min_dist:\n          min_dist = dist\n          target_pos = loc\n\n  if target_pos is None:\n      # This case should ideally not be reached if primitive_locations is not empty\n      return []\n\n  target_x, target_y = target_pos[0], target_pos[1]\n\n  # Determine the next action to move towards the target\n  # Prioritize moving along the axis with the larger difference\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # A simple greedy movement strategy\n  if abs(dx) > abs(dy):\n      if dx > 0:\n          return [3] # RIGHT\n      else: # dx < 0\n          return [2] # LEFT\n  elif abs(dy) > 0: # If dy is non-zero (and abs(dy) >= abs(dx))\n      if dy > 0:\n          return [0] # DOWN\n      else: # dy < 0\n          return [1] # UP\n  \n  # If dx and dy are both 0, means current_pos == target_pos.\n  # This case should theoretically be covered by the `is_next_to` check\n  # if the primitive is collectible at the current location.\n  return [] # No action needed or path found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:18:21.845946", "function_name": "collect", "function_body": "    current_state = env._current_state\n    world = env.world\n    grid = current_state.grid\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir\n    inventory = current_state.inventory\n    width, height, _ = grid.shape\n\n    primitive_idx = primitive\n\n    # Action mappings (assuming these are globally defined or accessible)\n    # DOWN = 0, UP = 1, LEFT = 2, RIGHT = 3, USE = 4\n    # Direction mappings (assuming 0=N, 1=E, 2=S, 3=W for agent's dir)\n    NORTH = 0\n    EAST = 1\n    SOUTH = 2\n    WEST = 3\n\n    _DX = [0, 1, 0, -1]  # Delta X for N, E, S, W\n    _DY = [-1, 0, 1, 0]  # Delta Y for N, E, S, W\n\n    # 1. Check if primitive is already in inventory\n    if inventory[primitive_idx] > 0:\n        return []\n\n    # 2. Find all locations of the primitive on the grid\n    # (Not strictly needed for BFS pathfinding, but useful for debugging or alternative strategies)\n    # The BFS will implicitly find a path to _any_ instance of the primitive.\n\n    # 3. BFS to find the shortest path to a state where the primitive can be collected\n    # A state in BFS is (x, y, direction, list_of_actions)\n    queue = collections.deque([(initial_pos[0], initial_pos[1], initial_dir, [])])\n    visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n    found_path = None\n\n    while queue:\n        cx, cy, cdir, c_actions = queue.popleft()\n\n        # Check if the current position and direction allow for collecting the primitive\n        # Calculate the cell the agent would interact with if USE is pressed\n        target_x = cx + _DX[cdir]\n        target_y = cy + _DY[cdir]\n\n        # Check if this target cell is within bounds and contains the primitive\n        if 0 <= target_x < width and 0 <= target_y < height:\n            if grid[target_x, target_y, primitive_idx] > 0:\n                # Agent is in a position (cx, cy) and facing direction (cdir)\n                # where the USE action would successfully collect the primitive.\n                found_path = c_actions + [USE]\n                break  # Found the shortest path, exit BFS\n\n        # Explore neighbors by applying movement/turn actions\n        # UP (move forward)\n        nx_up = cx + _DX[cdir]\n        ny_up = cy + _DY[cdir]\n        if 0 <= nx_up < width and 0 <= ny_up < height and (nx_up, ny_up, cdir) not in visited:\n            visited.add((nx_up, ny_up, cdir))\n            queue.append((nx_up, ny_up, cdir, c_actions + [UP]))\n\n        # DOWN (move backward)\n        back_dir = (cdir + 2) % 4  # Opposite direction\n        nx_down = cx + _DX[back_dir]\n        ny_down = cy + _DY[back_dir]\n        if 0 <= nx_down < width and 0 <= ny_down < height and (nx_down, ny_down, cdir) not in visited:\n            visited.add((nx_down, ny_down, cdir))\n            queue.append((nx_down, ny_down, cdir, c_actions + [DOWN]))\n\n        # LEFT (turn left)\n        new_dir_left = (cdir - 1 + 4) % 4\n        if (cx, cy, new_dir_left) not in visited:\n            visited.add((cx, cy, new_dir_left))\n            queue.append((cx, cy, new_dir_left, c_actions + [LEFT]))\n\n        # RIGHT (turn right)\n        new_dir_right = (cdir + 1) % 4\n        if (cx, cy, new_dir_right) not in visited:\n            visited.add((cx, cy, new_dir_right))\n            queue.append((cx, cy, new_dir_right, c_actions + [RIGHT]))\n            \n    return found_path if found_path is not None else []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:18:21.916069", "function_name": "collect", "function_body": "    actions_taken = []\n    \n    # Reset environment to get initial state\n    _ = env.reset() # We don't need the initial observation dict here, as we'll query _current_state\n    \n    # Define a maximum number of steps to prevent infinite loops (arbitrary but reasonable limit)\n    max_steps_for_collection = 500 \n\n    for step_count in range(max_steps_for_collection):\n        current_state = env._current_state\n        \n        # Check if the primitive is already in the agent's inventory\n        if current_state.inventory[primitive] > 0:\n            break # Goal achieved, stop collecting\n        \n        action_to_take = -1 # Initialize with an invalid action code\n        \n        # Check if the primitive is in the 3x3 neighborhood around the agent's position\n        if current_state.next_to(primitive):\n            action_to_take = env_factory.ACTION_USE # If so, use the USE action\n        else:\n            # If not next to the agent, find the primitive on the map and move towards it\n            grid = current_state.grid\n            agent_x, agent_y = current_state.pos\n            \n            # Find all locations in the grid where the primitive exists\n            # np.argwhere returns (row_index, col_index) for non-zero elements.\n            # Assuming grid[x, y, kind] indexing, this maps directly to (x, y) coordinates.\n            primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n            \n            if len(primitive_locations) == 0:\n                # The primitive is not found on the map. This might mean it's exhausted,\n                # or the scenario doesn't contain it. For this simple collection,\n                # we resort to a random exploration move. In a more complex system,\n                # this might trigger an \"unreachable\" state or a different strategy.\n                action_to_take = np.random.choice([env_factory.ACTION_UP, env_factory.ACTION_DOWN, \n                                                   env_factory.ACTION_LEFT, env_factory.ACTION_RIGHT])\n            else:\n                # Find the closest primitive location using Manhattan distance\n                min_dist = float('inf')\n                target_x, target_y = -1, -1\n                \n                for loc_x, loc_y in primitive_locations:\n                    dist = abs(loc_x - agent_x) + abs(loc_y - agent_y)\n                    if dist < min_dist:\n                        min_dist = dist\n                        target_x, target_y = loc_x, loc_y\n                        \n                # Determine the best movement action towards the target\n                # Prioritize horizontal movement if there's a horizontal distance to cover\n                if target_x != agent_x:\n                    if target_x > agent_x:\n                        action_to_take = env_factory.ACTION_RIGHT\n                    else: # target_x < agent_x\n                        action_to_take = env_factory.ACTION_LEFT\n                elif target_y != agent_y: # If no horizontal distance, move vertically\n                    if target_y > agent_y:\n                        action_to_take = env_factory.ACTION_DOWN\n                    else: # target_y < agent_y\n                        action_to_take = env_factory.ACTION_UP\n                else:\n                    # Agent is exactly on the target_x, target_y cell,\n                    # but `current_state.next_to(primitive)` was False.\n                    # This scenario implies the item is at agent's position but not 'next to'\n                    # or collectable directly from it via `USE`.\n                    # As a fallback, try a random movement to re-evaluate or shift position.\n                    action_to_take = np.random.choice([env_factory.ACTION_UP, env_factory.ACTION_DOWN, \n                                                       env_factory.ACTION_LEFT, env_factory.ACTION_RIGHT])\n\n        # If for any reason no action was explicitly chosen (should not happen with current logic),\n        # default to a random movement action to prevent loops or errors.\n        if action_to_take == -1:\n            action_to_take = np.random.choice([env_factory.ACTION_UP, env_factory.ACTION_DOWN, \n                                               env_factory.ACTION_LEFT, env_factory.ACTION_RIGHT])\n            \n        # Execute the chosen action in the environment\n        # The return values (reward, done, observations) are not directly used here,\n        # as the state is queried via `env._current_state` in the next iteration.\n        _, _, _ = env.step(action_to_take)\n        actions_taken.append(action_to_take)\n        \n    return actions_taken", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:19:49.200454", "function_name": "collect", "function_body": "    from collections import deque\n    import numpy as np\n    # Assume CraftState is available in the scope or from an import\n    # Assume env_factory.ACTIONS is available or action_specs() is used\n\n    # Get action mappings from the environment's action_specs\n    # These are typically integers (0, 1, 2, 3, 4)\n    craft_lab_actions = env.action_specs()\n\n    # Get the current state from the CraftLab environment\n    # We access the internal _current_state attribute for simplicity in this context.\n    # In a real API, one might use env.reset() or parse observations.\n    current_craft_state = env._current_state\n\n    # Check if the primitive is already in the inventory\n    if current_craft_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # Define movement deltas for BFS. Map action ID to (delta_x, delta_y).\n    # Assuming (0,0) is top-left, x increases right, y increases down.\n    move_deltas = {\n        craft_lab_actions['UP']: (0, -1),\n        craft_lab_actions['DOWN']: (0, 1),\n        craft_lab_actions['LEFT']: (-1, 0),\n        craft_lab_actions['RIGHT']: (1, 0),\n    }\n\n    # BFS Queue: stores (current_position, list_of_actions_to_reach_this_position)\n    queue = deque()\n    queue.append((current_craft_state.pos, []))\n\n    # Visited set: stores positions that have been added to the queue to avoid cycles\n    visited = {current_craft_state.pos}\n\n    # Get grid dimensions for boundary checks\n    grid_width, grid_height, _ = current_craft_state.grid.shape\n\n    # BFS loop to find the shortest path\n    while queue:\n        current_pos, path_so_far = queue.popleft()\n\n        # Create a temporary CraftState instance to leverage its `next_to` method.\n        # This state uses the original grid for pathfinding and the current_pos for its location.\n        # Scenario, world, dir, and inventory are passed by reference or copied as needed by CraftState.\n        temp_check_state = CraftState(\n            scenario=current_craft_state.scenario,\n            grid=current_craft_state.grid, # Use the initial grid for pathfinding\n            pos=current_pos,\n            dir=current_craft_state.dir, # Direction doesn't impact next_to logic\n            inventory=current_craft_state.inventory # Inventory doesn't impact next_to logic\n        )\n\n        # Check if the primitive is in the 3x3 neighborhood of the current position\n        if temp_check_state.next_to(primitive):\n            # Path found! Append the 'USE' action and return the complete plan.\n            return path_so_far + [craft_lab_actions['USE']]\n\n        # Explore possible next moves\n        for action_name, action_id in craft_lab_actions.items():\n            if action_id == craft_lab_actions['USE']:\n                continue # 'USE' is the final action, not a movement action in BFS\n\n            delta_x, delta_y = move_deltas[action_id]\n            next_x, next_y = current_pos[0] + delta_x, current_pos[1] + delta_y\n            next_pos = (next_x, next_y)\n\n            # Check grid boundaries\n            if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n                continue\n\n            # Check if this position has been visited before\n            if next_pos not in visited:\n                # To determine if a move is traversable, we simulate it using a dummy CraftState.\n                # This ensures we respect the environment's internal collision/traversability rules.\n                dummy_sim_state = CraftState(\n                    scenario=current_craft_state.scenario,\n                    grid=current_craft_state.grid, # Use the initial grid\n                    pos=current_pos,\n                    dir=current_craft_state.dir,\n                    inventory=current_craft_state.inventory\n                )\n                # Calling step on a dummy state returns a new state and a reward.\n                # We only care if the position actually changed.\n                _, new_dummy_state = dummy_sim_state.step(action_id)\n\n                # If the position changed, the move was valid and traversable\n                if new_dummy_state.pos == next_pos:\n                    visited.add(next_pos)\n                    queue.append((next_pos, path_so_far + [action_id]))\n\n    # If the queue becomes empty and no path to the primitive was found\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:19:50.214063", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Constants for actions (as specified in CraftLab.action_specs)\n  # DOWN = 0, UP = 1, LEFT = 2, RIGHT = 3, USE = 4\n  _ACTION_DELTAS = {\n      1: (0, -1),  # UP: (dx, dy) where dy = -1 (move up in y-coord)\n      0: (0, 1),   # DOWN: (dx, dy) where dy = 1 (move down in y-coord)\n      2: (-1, 0),  # LEFT: (dx, dy) where dx = -1 (move left in x-coord)\n      3: (1, 0)    # RIGHT: (dx, dy) where dx = 1 (move right in x-coord)\n  }\n  USE = 4\n\n  current_state = env._current_state\n  \n  # 1. Check if the primitive is already in the agent's inventory\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  grid = current_state.grid\n  start_pos = current_state.pos\n  width, height, _ = grid.shape # grid shape is (WIDTH, HEIGHT, n_kinds)\n\n  q = deque()\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q.append((start_pos, []))\n\n  visited = {start_pos} # Set of visited (x, y) tuples to avoid cycles\n\n  target_primitive_pos = None\n  path_to_primitive_pos = []\n\n  # 2. Perform a Breadth-First Search (BFS) to find the primitive's location\n  while q:\n    curr_pos, actions_path = q.popleft()\n    cx, cy = curr_pos\n\n    # Check if this cell contains the desired primitive\n    if grid[cx, cy, primitive] > 0:\n      target_primitive_pos = curr_pos\n      path_to_primitive_pos = actions_path\n      break # Primitive found, stop BFS\n\n    # Explore valid neighboring cells\n    for action, (dx, dy) in _ACTION_DELTAS.items():\n      next_x, next_y = cx + dx, cy + dy\n      next_pos = (next_x, next_y)\n\n      # Check boundary conditions\n      if not (0 <= next_x < width and 0 <= next_y < height):\n        continue\n\n      # Check if the cell has already been visited\n      if next_pos in visited:\n        continue\n\n      visited.add(next_pos)\n      q.append((next_pos, actions_path + [action]))\n\n  # 3. If the primitive was not found within reachable cells\n  if target_primitive_pos is None:\n    return [] # Return an empty list if primitive is not reachable\n\n  # 4. Construct the final sequence of actions\n  # First, move to the primitive's location\n  final_actions = list(path_to_primitive_pos)\n\n  # Then, use the primitive to collect it.\n  # For primitive resources (like wood, stone), the 'USE' action is typically required\n  # after reaching their location or an adjacent cell. CraftState.next_to checks 3x3\n  # neighborhood, so being on the same cell as the primitive allows 'USE'.\n  final_actions.append(USE)\n\n  return final_actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:20:58.707933", "function_name": "collect", "function_body": "  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 0 and dy == 0:\n      return None\n\n    # Determine primary axis movement (horizontal or vertical) for facing\n    if abs(dx) >= abs(dy): # Prioritize horizontal if magnitude is greater or equal\n      return EAST_DIR if dx > 0 else WEST_DIR\n    else: # abs(dy) > abs(dx)\n      return SOUTH_DIR if dy > 0 else NORTH_DIR\n\n  # Helper function: Returns actions to turn from current_dir to target_dir.\n  # Assumes LEFT_ACTION and RIGHT_ACTION are used for turning.\n  def _get_turn_actions(current_dir, target_dir):\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION) # Turn right\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION) # Turn left\n    return actions\n\n  primitive_id = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n  agent_grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir # Agent's initial facing direction\n\n  grid_height, grid_width, _ = agent_grid.shape\n\n  # Identify indices of entities that are considered obstacles (non-traversable)\n  # This includes the target primitive itself (cannot move onto it),\n  # non-grabbable items (like water, stone), and workshops.\n  obstacle_indices = set()\n  # Add all non-grabbable items as obstacles\n  obstacle_indices.update(env.world.non_grabbable_indices)\n  # Add workshop locations as obstacles\n  obstacle_indices.update(env.world.workshop_indices)\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(agent_grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Step 1: Identify all potential collection points.\n  # These are cells from which the agent can be adjacent to *any* instance of the primitive\n  # and perform a USE action.\n  primitive_locations = set()\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n  \n  potential_collection_points = set()\n  # Define deltas for checking cardinal adjacency\n  ADJACENCY_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n\n  for px, py in primitive_locations:\n    for dx, dy in ADJACENCY_DELTAS:\n      adj_x, adj_y = px + dx, py + dy\n      if 0 <= adj_x < grid_width and 0 <= adj_y < grid_height:\n        # Check if the adjacent cell is traversable:\n        # 1. Not occupied by the primitive itself (agent cannot move onto the item it wants to collect).\n        is_primitive_target_occupied = (agent_grid[adj_y, adj_x, primitive_id] == 1)\n        \n        # 2. Not occupied by any other general obstacle (water, stone, workshop etc.)\n        is_other_obstacle_occupied = False\n        for obs_idx in obstacle_indices:\n            if agent_grid[adj_y, adj_x, obs_idx] == 1:\n                is_other_obstacle_occupied = True\n                break\n        \n        # A cell is a valid collection point if it's within bounds AND it's traversable.\n        if not is_primitive_target_occupied and not is_other_obstacle_occupied:\n            potential_collection_points.add((adj_x, adj_y))\n  \n  if not potential_collection_points:\n      return [] # No valid collection points (e.g., item might be completely surrounded by obstacles)\n\n  # Step 2: BFS Pathfinding to *any* of the potential_collection_points.\n  # The BFS finds the shortest path.\n  queue = [(agent_pos_x, agent_pos_y, [])] # (x, y, path_actions)\n  visited = set([(agent_pos_x, agent_pos_y)])\n  \n  path_to_adj_pos = []\n  chosen_adj_pos = None # The specific adjacent position the agent will move to\n  target_item_pos_for_facing = None # The specific primitive instance to face (for facing direction)\n\n  # Define movement deltas for BFS. These actions move the agent cardinally.\n  # They do NOT change the agent's facing direction.\n  ACTION_MOVES = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0),\n  }\n\n  while queue:\n    curr_x, curr_y, current_path = queue.pop(0)\n\n    # Check if the current position is one of the potential collection points\n    if (curr_x, curr_y) in potential_collection_points:\n      path_to_adj_pos = current_path\n      chosen_adj_pos = (curr_x, curr_y)\n      \n      # Now, identify *which* primitive instance this chosen_adj_pos is adjacent to.\n      # Any adjacent primitive will do for the USE action, so pick the first one found.\n      for dx, dy in ADJACENCY_DELTAS:\n          item_x, item_y = curr_x + dx, curr_y + dy\n          if 0 <= item_x < grid_width and 0 <= item_y < grid_height and\\\n             agent_grid[item_y, item_x, primitive_id] == 1:\n              target_item_pos_for_facing = (item_x, item_y)\n              break # Found the target item for facing\n      break # Path found to a valid collection point, exit BFS\n\n    # Explore possible moves from current position\n    for action, (dx, dy) in ACTION_MOVES.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check boundary conditions and if the cell has not been visited yet\n      if 0 <= next_x < grid_width and 0 <= next_y < grid_height and\\\n         (next_x, next_y) not in visited:\n        \n        # Traversability check for the `next` cell:\n        # 1. Not occupied by the target primitive itself.\n        is_primitive_target_occupied = (agent_grid[next_y, next_x, primitive_id] == 1)\n        \n        # 2. Not occupied by any other general obstacle.\n        is_other_obstacle_occupied = False\n        for obs_idx in obstacle_indices:\n            if agent_grid[next_y, next_x, obs_idx] == 1:\n                is_other_obstacle_occupied = True\n                break\n\n        # If the cell is traversable (not occupied by primitive and not an obstacle)\n        if not is_primitive_target_occupied and not is_other_obstacle_occupied:\n            visited.add((next_x, next_y))\n            queue.append((next_x, next_y, current_path + [action]))\n\n  # If no path was found to any collection point (queue exhausted before finding a target)\n  if chosen_adj_pos is None:\n    return []\n\n  final_actions = list(path_to_adj_pos)\n\n  # After moving to the chosen_adj_pos, determine the direction the agent needs to face\n  # the primitive and add the necessary turning actions.\n  # The agent's `dir` (initial direction) is used as `current_dir` because the movement actions\n  # (UP, DOWN, LEFT, RIGHT) do not change the agent's facing direction.\n  if target_item_pos_for_facing is not None:\n    target_face_dir = _get_target_facing_direction(chosen_adj_pos[0], chosen_adj_pos[1], \n                                                   target_item_pos_for_facing[0], target_item_pos_for_facing[1])\n    if target_face_dir is not None:\n      final_actions.extend(_get_turn_actions(agent_dir, target_face_dir))\n  \n  # Finally, add the USE action to collect the primitive\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T16:20:59.712724", "function_name": "collect", "function_body": "  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 0 and dy == 0:\n      return None # Agent is on top of item, or item is on agent, which shouldn't happen for collection target.\n\n    # Determine primary axis movement (horizontal or vertical) for facing\n    # Prioritize horizontal if magnitude is greater or equal, otherwise vertical\n    if abs(dx) >= abs(dy):\n      return EAST_DIR if dx > 0 else WEST_DIR\n    else: # abs(dy) > abs(dx)\n      return SOUTH_DIR if dy > 0 else NORTH_DIR\n\n  # Helper function: Returns actions to turn from current_dir to target_dir.\n  def _get_turn_actions(current_dir, target_dir):\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION) # Turn right\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION) # Turn left\n    return actions\n\n  primitive_id = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n  agent_grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir # Agent's initial facing direction\n\n  grid_height, grid_width, _ = agent_grid.shape\n\n  # Find all locations of the primitive on the grid\n  # np.where returns (row_indices, col_indices) which correspond to (y_coords, x_coords)\n  y_coords, x_coords = np.where(agent_grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Step 1: Identify all potential collection points.\n  # These are cells from which the agent can be adjacent to *any* instance of the primitive\n  # and perform a USE action.\n  primitive_locations = set()\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i])) # Store as (x, y)\n  \n  # A set of tuples: ((adj_x, adj_y), (item_x, item_y))\n  # where (adj_x, adj_y) is a traversable cell adjacent to (item_x, item_y)\n  potential_collection_points = set() \n  ADJACENCY_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # deltas for cardinal neighbors (dx, dy)\n\n  for px, py in primitive_locations:\n    for dx, dy in ADJACENCY_DELTAS:\n      adj_x, adj_y = px + dx, py + dy\n      if 0 <= adj_x < grid_width and 0 <= adj_y < grid_height:\n        # A cell is a potential collection point if it's within bounds AND it's traversable.\n        # A cell is NOT traversable if it contains the primitive itself,\n        # or if it contains any non-grabbable item (like water, workshop parts).\n        \n        is_traversable_for_collection_spot = True\n        \n        # Cannot move onto the primitive itself\n        if agent_grid[adj_y, adj_x, primitive_id] == 1:\n            is_traversable_for_collection_spot = False\n        \n        # Cannot move onto any non-grabbable obstacle\n        if is_traversable_for_collection_spot: # Only check if not already ruled out by being the primitive itself\n            for non_grabbable_idx in env.world.non_grabbable_indices:\n                if agent_grid[adj_y, adj_x, non_grabbable_idx] == 1:\n                    is_traversable_for_collection_spot = False\n                    break\n        \n        if is_traversable_for_collection_spot:\n            potential_collection_points.add(((adj_x, adj_y), (px, py)))\n\n  if not potential_collection_points:\n      return [] # No valid collection points (e.g., item might be completely surrounded by obstacles)\n\n  # Step 2: BFS Pathfinding to *any* of the potential_collection_points.\n  # The BFS finds the shortest path in terms of movement actions.\n  \n  # Queue stores (current_x, current_y, list_of_actions_to_reach_here)\n  queue = [(agent_pos_x, agent_pos_y, [])]\n  visited = set([(agent_pos_x, agent_pos_y)]) # Stores (x, y) of visited cells to prevent loops\n\n  path_to_adj_pos = []\n  chosen_adj_pos = None # The specific adjacent position the agent will move to\n  target_item_pos_for_facing = None # The specific primitive instance to face from chosen_adj_pos\n\n  # Define movement deltas for BFS. These actions move the agent cardinally.\n  # They do NOT change the agent's facing direction.\n  ACTION_MOVES = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0),\n  }\n\n  found_path = False\n  while queue and not found_path:\n    curr_x, curr_y, current_path = queue.pop(0)\n\n    # Check if the current position is one of the potential collection points\n    # We iterate through potential_collection_points because it stores which item position\n    # each adjacent point corresponds to, which is needed for facing.\n    for (adj_p, item_p) in potential_collection_points:\n        if (curr_x, curr_y) == adj_p:\n            path_to_adj_pos = current_path\n            chosen_adj_pos = adj_p\n            target_item_pos_for_facing = item_p\n            found_path = True\n            break # Path found, exit the inner loop\n    \n    if found_path:\n        break # Path found, exit the BFS loop\n\n    # Explore possible moves from current position\n    for action, (dx, dy) in ACTION_MOVES.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check boundary conditions and if the cell has not been visited yet\n      if (0 <= next_x < grid_width and 0 <= next_y < grid_height and\n          (next_x, next_y) not in visited):\n        \n        # Check traversability for movement to (next_x, next_y).\n        # Same traversability rules as for collection spots.\n        is_traversable_for_move = True\n        \n        if agent_grid[next_y, next_x, primitive_id] == 1:\n            is_traversable_for_move = False\n        \n        if is_traversable_for_move:\n            for non_grabbable_idx in env.world.non_grabbable_indices:\n                if agent_grid[next_y, next_x, non_grabbable_idx] == 1:\n                    is_traversable_for_move = False\n                    break\n        \n        if is_traversable_for_move:\n            visited.add((next_x, next_y))\n            queue.append((next_x, next_y, current_path + [action]))\n\n  # If no path was found to any collection point (queue exhausted before finding a target)\n  if chosen_adj_pos is None:\n    return []\n\n  final_actions = list(path_to_adj_pos)\n\n  # After moving to the chosen_adj_pos, determine the direction the agent needs to face\n  # the primitive and add the necessary turning actions.\n  # The agent's `dir` (initial direction) is used as `current_dir` because the movement actions\n  # (UP, DOWN, LEFT, RIGHT) do not change the agent's facing direction.\n  if target_item_pos_for_facing is not None:\n    target_face_dir = _get_target_facing_direction(chosen_adj_pos[0], chosen_adj_pos[1], \n                                                   target_item_pos_for_facing[0], target_item_pos_for_facing[1])\n    if target_face_dir is not None:\n      final_actions.extend(_get_turn_actions(agent_dir, target_face_dir))\n  \n  # Finally, add the USE action to collect the primitive\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T16:22:39.814111", "function_name": "collect", "function_body": "    def _is_next_to(current_x, current_y, target_x, target_y):\n        \"\"\"Checks if target (x,y) is within 3x3 neighborhood of current (x,y).\n        This includes the current cell itself, as per CraftState.next_to definition.\n        \"\"\"\n        return abs(target_x - current_x) <= 1 and abs(target_y - current_y) <= 1\n\n    actions = []\n    state = env._current_state\n\n    # 1. Check if primitive is already collected or is a non-grabbable item\n    if state.inventory[primitive] > 0 or primitive in env.world.non_grabbable_indices:\n        return []\n\n    current_x, current_y = state.pos\n    grid_width, grid_height, _ = state.grid.shape\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # Helper to check if a cell is traversable (within bounds and not containing non-grabbable items)\n    def _is_traversable(x, y):\n        if not (0 <= x < grid_width and 0 <= y < grid_height):\n            return False\n        # Check if the cell contains any non-grabbable item that blocks movement\n        for k in non_grabbable_indices:\n            if state.grid[x, y, k] == 1.0: # Assuming 1.0 indicates presence\n                return False\n        return True\n\n    # 2. Find the primitive's location on the initial grid\n    target_pos = None\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if state.grid[x, y, primitive] == 1.0: # Assuming 1.0 indicates primitive's presence\n                target_pos = (x, y)\n                break\n        if target_pos:\n            break\n\n    if target_pos is None:\n        return [] # Primitive not found on the grid, so cannot collect\n\n    target_x, target_y = target_pos\n\n    # 3. Simulate greedy movement towards the primitive until adjacent\n    # Use a generous upper bound for path length to prevent infinite loops in complex scenarios\n    max_path_len = grid_width * grid_height * 2 \n    path_found = False\n\n    for _ in range(max_path_len):\n        if _is_next_to(current_x, current_y, target_x, target_y):\n            path_found = True\n            break\n\n        moved_this_step = False\n        \n        # Prioritize horizontal movement to align X coordinate\n        if target_x > current_x and _is_traversable(current_x + 1, current_y):\n            actions.append(env_factory.RIGHT)\n            current_x += 1\n            moved_this_step = True\n        elif target_x < current_x and _is_traversable(current_x - 1, current_y):\n            actions.append(env_factory.LEFT)\n            current_x -= 1\n            moved_this_step = True\n        # If X is aligned or blocked, try vertical movement to align Y coordinate\n        elif target_y > current_y and _is_traversable(current_x, current_y + 1):\n            actions.append(env_factory.DOWN) # Assuming positive Y is down in grid indexing\n            current_y += 1\n            moved_this_step = True\n        elif target_y < current_y and _is_traversable(current_x, current_y - 1):\n            actions.append(env_factory.UP) # Assuming negative Y is up\n            current_y -= 1\n            moved_this_step = True\n\n        if not moved_this_step:\n            # Agent is stuck or cannot move closer (e.g., surrounded by obstacles),\n            # or target is unreachable with this greedy strategy.\n            return [] # No path found or cannot reach vicinity\n\n    if not path_found:\n        return [] # Failed to reach the primitive's vicinity within max_path_len\n\n    # 4. Agent is now next to (or on) the primitive, add the USE action to collect it.\n    actions.append(env_factory.USE)\n\n    return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:22:39.887184", "function_name": "collect", "function_body": "    import collections\n\n    # Define action constants based on the problem description\n    DOWN_ACTION = 0\n    UP_ACTION = 1\n    LEFT_ACTION = 2\n    RIGHT_ACTION = 3\n    USE_ACTION = 4\n\n    # Map agent direction index to (dx, dy) vector of what it is facing\n    # Based on action_specs: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT\n    _DIR_VECTORS = {\n        0: (0, 1),   # DOWN (positive Y)\n        1: (0, -1),  # UP (negative Y)\n        2: (-1, 0),  # LEFT (negative X)\n        3: (1, 0)    # RIGHT (positive X)\n    }\n\n    # Map movement action to (dx, dy) vector for the agent's position change\n    _ACTION_MOVES = {\n        DOWN_ACTION: (0, 1),\n        UP_ACTION: (0, -1),\n        LEFT_ACTION: (-1, 0),\n        RIGHT_ACTION: (1, 0)\n    }\n\n    # Map a movement action to the resulting agent direction index\n    # (i.e., performing UP_ACTION makes the agent face UP)\n    _ACTION_TO_DIR_INDEX = {\n        DOWN_ACTION: 0,\n        UP_ACTION: 1,\n        LEFT_ACTION: 2,\n        RIGHT_ACTION: 3\n    }\n\n    def _get_turn_actions(current_dir_idx, target_dir_idx):\n        \"\"\"\n        Calculates the shortest sequence of actions (LEFT_ACTION/RIGHT_ACTION)\n        to turn from current_dir_idx to target_dir_idx.\n        \"\"\"\n        _RIGHT_TURN_MAP = {0: 3, 1: 2, 2: 0, 3: 1} # (DOWN->RIGHT, UP->LEFT, LEFT->DOWN, RIGHT->UP)\n        _LEFT_TURN_MAP = {0: 2, 1: 3, 2: 1, 3: 0}   # (DOWN->LEFT, UP->RIGHT, LEFT->UP, RIGHT->DOWN)\n\n        if current_dir_idx == target_dir_idx:\n            return []\n\n        # Find path by turning right\n        path_right = []\n        temp_dir = current_dir_idx\n        while temp_dir != target_dir_idx:\n            temp_dir = _RIGHT_TURN_MAP[temp_dir]\n            path_right.append(RIGHT_ACTION)\n\n        # Find path by turning left\n        path_left = []\n        temp_dir = current_dir_idx\n        while temp_dir != target_dir_idx:\n            temp_dir = _LEFT_TURN_MAP[temp_dir]\n            path_left.append(LEFT_ACTION)\n\n        if len(path_right) <= len(path_left):\n            return path_right\n        else:\n            return path_left\n\n    def _is_adjacent(pos1, pos2):\n        \"\"\"Checks if two positions are adjacent (Manhattan distance 1).\"\"\"\n        return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1]) == 1\n\n    current_state = env._current_state\n    grid = current_state.grid\n    agent_pos = current_state.pos\n    agent_dir = current_state.dir # Initial direction index (0-3)\n    inventory = current_state.inventory\n\n    # If the primitive is already in inventory, no actions are needed.\n    if inventory[primitive] > 0:\n        return []\n\n    WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n    # 1. Find all locations of the primitive on the grid\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] == 1:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        # Primitive not found on the map\n        return []\n\n    # 2. Use BFS to find the shortest path of movement actions to a cell\n    #    adjacent to any instance of the primitive.\n    # BFS queue stores (current_position_tuple, path_of_actions_to_reach_here)\n    queue = collections.deque([(agent_pos, [])])\n    # visited set stores positions (x, y) to avoid cycles and redundant explorations\n    visited = {agent_pos}\n\n    goal_adjacent_pos = None\n    goal_primitive_pos = None\n    final_path_actions = []\n\n    while queue:\n        current_pos, current_path = queue.popleft()\n\n        # Check if current position is adjacent to any primitive location\n        for px, py in primitive_locations:\n            if _is_adjacent(current_pos, (px, py)):\n                goal_adjacent_pos = current_pos\n                goal_primitive_pos = (px, py)\n                final_path_actions = current_path # This is the sequence of moves\n                break # Found the shortest path to an adjacent cell\n        \n        if goal_adjacent_pos is not None:\n            break # Exit BFS once a path is found\n\n        # Explore neighbors by performing movement actions\n        for action, (dx, dy) in _ACTION_MOVES.items():\n            nx, ny = current_pos[0] + dx, current_pos[1] + dy\n            next_pos = (nx, ny)\n\n            # Check boundaries\n            if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n                continue\n\n            # Assuming all cells are traversable for movement unless explicitly defined as obstacles.\n            # (No explicit unwalkable check for CraftWorld in problem description)\n\n            if next_pos not in visited:\n                visited.add(next_pos)\n                new_path = current_path + [action]\n                queue.append((next_pos, new_path))\n    \n    # If BFS completes and no path to an adjacent cell was found\n    if goal_adjacent_pos is None:\n        return []\n\n    # 3. Calculate turns and add USE action at the end of the path\n    \n    # Determine the agent's direction after executing the movement path\n    final_agent_dir = agent_dir # Default to initial dir if no moves were made\n    if final_path_actions:\n        last_move_action = final_path_actions[-1]\n        final_agent_dir = _ACTION_TO_DIR_INDEX[last_move_action]\n\n    # Determine the direction the agent needs to face to USE the primitive\n    target_dir_vector = (goal_primitive_pos[0] - goal_adjacent_pos[0],\n                         goal_primitive_pos[1] - goal_adjacent_pos[1])\n    \n    target_dir_idx = -1\n    for d_idx, vec in _DIR_VECTORS.items():\n        if vec == target_dir_vector:\n            target_dir_idx = d_idx\n            break\n    \n    if target_dir_idx == -1:\n        # This case should ideally not happen if _is_adjacent is true and _DIR_VECTORS is complete.\n        # It means the primitive is adjacent but the facing direction vector doesn't map to a known cardinal direction.\n        return []\n\n    turn_actions = _get_turn_actions(final_agent_dir, target_dir_idx)\n    \n    # Combine movement, turns, and the USE action\n    return final_path_actions + turn_actions + [USE_ACTION]", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:24:14.391203", "function_name": "collect", "function_body": "  import collections\n\n  # Check if the primitive is already in inventory\n  # inventory is a numpy array, primitive is an int index\n  if env._current_state.inventory[primitive] > 0:\n    return []\n\n  # Access action constants from env_factory\n  # These are typically integers (e.g., 0 for DOWN, 1 for UP, etc.)\n  DOWN = env_factory.actions.DOWN\n  UP = env_factory.actions.UP\n  LEFT = env_factory.actions.LEFT\n  RIGHT = env_factory.actions.RIGHT\n  USE = env_factory.actions.USE\n\n  current_state = env._current_state\n  initial_pos = current_state.pos\n  grid = current_state.grid # grid has shape (WIDTH, HEIGHT, n_kinds)\n\n  WIDTH, HEIGHT, _ = grid.shape # Extract dimensions\n\n  # Optimization: If agent is already next to the primitive, just perform USE\n  if current_state.next_to(primitive):\n    return [USE]\n\n  # BFS setup for pathfinding\n  # Queue stores tuples of (current_agent_position, list_of_actions_to_reach_here)\n  q = collections.deque([(initial_pos, [])])\n  # Visited set stores positions to avoid cycles and redundant paths\n  visited = {initial_pos}\n\n  # Define possible moves relative to the current position (dr, dc)\n  # and their corresponding actions\n  MOVES = {\n      (0, 1): RIGHT, # Move right (+dc)\n      (0, -1): LEFT,  # Move left (-dc)\n      (1, 0): DOWN,   # Move down (+dr)\n      (-1, 0): UP,    # Move up (-dr)\n  }\n\n  while q:\n    (r, c), path = q.popleft()\n\n    # Check if the current position (r, c) is adjacent to the target primitive.\n    # This simulates CraftState.next_to(primitive) if the agent were at (r, c).\n    found_adjacent_primitive_in_grid = False\n    for dr_check in [-1, 0, 1]:\n      for dc_check in [-1, 0, 1]:\n        # Skip the agent's own square (0,0 relative to agent's position)\n        if dr_check == 0 and dc_check == 0:\n          continue\n        \n        check_r, check_c = r + dr_check, c + dc_check\n        \n        # Check if the neighbor is within grid bounds\n        if 0 <= check_r < WIDTH and 0 <= check_c < HEIGHT:\n          # Check if the primitive is located at this neighbor cell\n          if grid[check_r, check_c, primitive] == 1:\n            found_adjacent_primitive_in_grid = True\n            break # Found primitive in neighborhood, no need to check other neighbors for this (r,c)\n      if found_adjacent_primitive_in_grid:\n        break\n\n    # If a primitive is found in the neighborhood of the current agent position,\n    # then we can perform the USE action. This path is the shortest to such a position.\n    if found_adjacent_primitive_in_grid:\n      return path + [USE] # Return the path taken to get here, plus the final USE action\n\n    # Explore valid neighboring cells for movement\n    for (dr_move, dc_move), action in MOVES.items():\n      next_r, next_c = r + dr_move, c + dc_move\n\n      # 1. Check if the next position is within grid boundaries\n      if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n        continue\n\n      # 2. Check if the next position has already been visited in this BFS\n      if (next_r, next_c) in visited:\n        continue\n      \n      # 3. V2 Improvement: Ensure the agent does not move directly *onto* the primitive it wants to collect.\n      # The `USE` action typically implies interacting with an adjacent block, not the one the agent is standing on.\n      # If `grid[next_r, next_c, primitive] == 1`, it means the primitive is currently at that cell.\n      # Moving there would replace it with the agent or cause it to be picked up implicitly,\n      # which might bypass or conflict with the explicit `USE` action mechanism.\n      # This filter ensures the path leads to a cell from which the primitive can be interacted with via adjacency.\n      if grid[next_r, next_c, primitive] == 1:\n          continue # Cannot path onto the primitive itself for collection.\n\n      # If all checks pass, add the new position to the queue for further exploration\n      visited.add((next_r, next_c))\n      q.append(((next_r, next_c), path + [action]))\n\n  # If the queue is exhausted and no path to a position adjacent to the primitive was found\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:24:15.363540", "function_name": "collect", "function_body": "  # Get initial observations and current state from the environment\n  initial_obs = env.observations()\n  initial_state = env._current_state # Direct access to CraftState for position\n\n  # Check if the primitive is already in the agent's inventory\n  if initial_obs['features_dict']['inventory'][primitive] > 0:\n    return [] # Already collected\n\n  # Extract grid information\n  grid = initial_obs['features_dict']['features_global']\n  grid_height, grid_width, _ = grid.shape\n  agent_y, agent_x = initial_state.pos # Agent's current (y, x) position on the grid\n\n  # 1. Locate all instances of the primitive on the grid\n  primitive_locations = []\n  for r in range(grid_height):\n    for c in range(grid_width):\n      if grid[r, c, primitive] > 0:\n        primitive_locations.append((r, c))\n\n  if not primitive_locations:\n    return [] # Primitive not found anywhere on the map\n\n  # Define action IDs and their corresponding (dy, dx) movements\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  action_move_map = {\n      DOWN: (1, 0),    # Move south (increase y)\n      UP: (-1, 0),     # Move north (decrease y)\n      LEFT: (0, -1),   # Move west (decrease x)\n      RIGHT: (0, 1),   # Move east (increase x)\n  }\n\n  # Helper function to check if a cell is traversable\n  # A cell is traversable if it's within bounds and does not contain any\n  # blocking non-grabbable items (except possibly the target primitive itself,\n  # which we assume can be moved onto if it's grabbable).\n  def is_traversable(y, x, current_grid, world):\n    if not (0 <= y < grid_height and 0 <= x < grid_width):\n      return False\n    # Check if any blocking non-grabbable item is present at (y,x)\n    for k_idx in world.non_grabbable_indices:\n      # If the cell contains a non-grabbable item AND it's not the primitive we're looking for, it's blocking.\n      if current_grid[y, x, k_idx] > 0 and k_idx != primitive:\n        return False\n    return True\n\n  # 2. Use BFS to find the shortest path to a collection-ready cell\n  # A \"collection-ready\" cell is:\n  # - The primitive's own cell, if the primitive is 'grabbable' (collected by walking onto).\n  # - A cell adjacent to the primitive's cell, if the primitive requires 'USE' (e.g., chopping, mining).\n  queue = [( (agent_y, agent_x), [] )] # (current_pos: (y,x), path_actions_to_here: list)\n  visited = set([(agent_y, agent_x)])\n\n  path_to_primitive_collection_point = None\n\n  while queue:\n    (cy, cx), current_actions = queue.pop(0)\n\n    # Check if the current cell is a \"goal cell\" for collection\n    is_goal_cell = False\n    for target_y, target_x in primitive_locations:\n      if primitive in env.world.grabbable_indices:\n        # If grabbable, the goal is to be ON the item\n        if (cy, cx) == (target_y, target_x):\n          is_goal_cell = True\n          break\n      else:\n        # If not grabbable, the goal is to be ADJACENT to the item for a 'USE' action\n        for dy, dx in [(0,1), (0,-1), (1,0), (-1,0)]: # Check 4 neighbors\n          if (cy + dy, cx + dx) == (target_y, target_x):\n            is_goal_cell = True\n            break\n      if is_goal_cell:\n        break # Found a suitable collection point\n\n    if is_goal_cell:\n      path_to_primitive_collection_point = current_actions\n      break # Path found, exit BFS\n\n    # Explore neighbors\n    for action, (dy, dx) in action_move_map.items():\n      ny, nx = cy + dy, cx + dx\n      if (ny, nx) not in visited and is_traversable(ny, nx, grid, env.world):\n        visited.add((ny, nx))\n        queue.append(((ny, nx), current_actions + [action]))\n\n  if path_to_primitive_collection_point is None:\n    return [] # No path found to any primitive instance\n\n  final_actions = list(path_to_primitive_collection_point) # Copy the found path\n\n  # 3. Determine if a 'USE' action is needed after reaching the collection point\n  # Simulate the agent's final position after executing the path\n  sim_y, sim_x = agent_y, agent_x\n  for action_taken in final_actions:\n    dy, dx = action_move_map[action_taken]\n    sim_y, sim_x = sim_y + dy, sim_x + dx\n\n  # If the primitive is NOT grabbable, it implies that a 'USE' action is required\n  # once the agent is adjacent to it.\n  if primitive not in env.world.grabbable_indices:\n    # Double-check that the simulated final position is indeed adjacent to the primitive\n    is_adjacent_to_any_primitive = False\n    for target_y, target_x in primitive_locations:\n      for dy, dx in [(0,1), (0,-1), (1,0), (-1,0)]:\n        if (sim_y + dy, sim_x + dx) == (target_y, target_x):\n          is_adjacent_to_any_primitive = True\n          break\n      if is_adjacent_to_any_primitive:\n        break\n\n    if is_adjacent_to_any_primitive:\n      final_actions.append(USE)\n\n  return final_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:25:46.950967", "function_name": "collect", "function_body": "  # Action constants (assuming these are universally defined or implied by the problem context)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map actions to (dx, dy) for movement\n  MOVE_DELTAS = {\n      ACTION_DOWN: (0, 1),\n      ACTION_UP: (0, -1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0),\n  }\n\n  initial_state = env._current_state\n  world = initial_state.world\n  \n  # 1. Check if primitive is already collected\n  if initial_state.inventory[primitive] > 0:\n      return []\n\n  WIDTH, HEIGHT, _ = initial_state.grid.shape\n  \n  # Define obstacle indices: any non-grabbable item that is NOT a workshop is considered an obstacle.\n  # Agent can move onto workshop locations.\n  obstacle_kinds = set()\n  for idx in world.non_grabbable_indices:\n      if idx not in world.workshop_indices:\n          obstacle_kinds.add(idx)\n\n  # Helper to check if a cell (x, y) is traversable.\n  # This function is nested to comply with \"only return code that will fit in that function\".\n  def is_traversable(x, y, current_grid):\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return False # Out of bounds\n      \n      # Check if any obstacle_kind is present at this cell\n      for k_idx in obstacle_kinds:\n          if current_grid[x, y, k_idx] > 0:\n              return False # Obstacle present\n      return True\n\n  # 2. Find all locations of the primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          if initial_state.grid[x, y, primitive] > 0:\n              primitive_locations.append((x, y))\n  \n  if not primitive_locations:\n      return [] # Primitive not found anywhere on the map\n\n  # 3. BFS to find the shortest path from the agent's current position to a cell \n  #    that is adjacent to any primitive location and is traversable.\n  \n  # Use collections.deque for efficient queue operations (assuming collections is imported globally)\n  import collections \n  queue = collections.deque([(initial_state.pos, [])]) # (current_pos, path_to_current_pos)\n  visited = {initial_state.pos}\n\n  best_path = [] # Will store the path to the adjacent square\n\n  while queue:\n      current_pos, current_path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is adjacent to any primitive location\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          # Check for direct (up, down, left, right) adjacency\n          if (abs(cx - px) == 1 and cy == py) or (abs(cy - py) == 1 and cx == px):\n              is_adjacent_to_primitive = True\n              break\n      \n      if is_adjacent_to_primitive:\n          # Found a path to a cell adjacent to a primitive.\n          # Since this is BFS, this is the shortest path.\n          best_path = current_path\n          break # Exit BFS loop\n\n      # Explore neighbors\n      for action, (dx, dy) in MOVE_DELTAS.items():\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          if next_pos not in visited and is_traversable(next_x, next_y, initial_state.grid):\n              visited.add(next_pos)\n              queue.append((next_pos, current_path + [action]))\n  \n  if best_path:\n      # Path to an adjacent cell found, now add the USE action to collect the primitive\n      return best_path + [ACTION_USE]\n  else:\n      # No path found to any cell adjacent to a primitive\n      return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:25:47.020763", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Define common actions, mirroring CraftLab.action_specs()\n    # These are specific to the CraftWorld environment.\n    class ACTIONS:\n        DOWN = 0\n        UP = 1\n        LEFT = 2\n        RIGHT = 3\n        USE = 4\n\n    # Deltas for (dx, dy) based on movement actions\n    # (Assuming x is horizontal, y is vertical, top-left is (0,0))\n    ACTION_DELTAS = {\n        ACTIONS.UP: (0, -1),\n        ACTIONS.DOWN: (0, 1),\n        ACTIONS.LEFT: (-1, 0),\n        ACTIONS.RIGHT: (1, 0),\n    }\n\n    def _is_valid_pos_for_agent(pos_x, pos_y, grid, non_traversable_kinds):\n        \"\"\"\n        Checks if a given grid position (pos_x, pos_y) is within bounds and\n        is not occupied by any non-traversable kind.\n        \"\"\"\n        grid_width, grid_height, _ = grid.shape\n        \n        # Check if the position is within the grid boundaries\n        if not (0 <= pos_x < grid_width and 0 <= pos_y < grid_height):\n            return False # Out of bounds\n\n        # Check if the cell is occupied by any non-traversable kind\n        # Primitive resources are assumed to be grabbable/traversable,\n        # so they should not be in non_traversable_kinds.\n        for k_idx in non_traversable_kinds:\n            if grid[pos_x, pos_y, k_idx] > 0:\n                return False # Occupied by an obstacle (e.g., solid wall, deep water)\n\n        return True\n\n    def _get_primitive_locations(grid, primitive_id):\n        \"\"\"\n        Scans the grid for all locations where the given primitive_id is present.\n        Returns a set of (x, y) tuples.\n        \"\"\"\n        locations = set()\n        grid_width, grid_height, _ = grid.shape\n        for x in range(grid_width):\n            for y in range(grid_height):\n                if grid[x, y, primitive_id] > 0:\n                    locations.add((x, y))\n        return locations\n\n    def _is_adjacent_or_on(pos1, pos2):\n        \"\"\"\n        Checks if pos1 is adjacent to or on pos2 (within an 8-directional neighborhood or same cell).\n        This corresponds to the 3x3 neighborhood used by CraftState.next_to.\n        \"\"\"\n        x1, y1 = pos1\n        x2, y2 = pos2\n        \n        # Calculate Manhattan distance (max of dx, dy) to check 3x3 neighborhood\n        return abs(x1 - x2) <= 1 and abs(y1 - y2) <= 1\n\n    # Get initial state information from the CraftLab environment\n    initial_state = env._current_state\n    start_pos = initial_state.pos\n    initial_grid = initial_state.grid\n    # Indices for items that cannot be traversed (e.g., walls, deep water)\n    non_traversable_kinds = initial_state.world.non_grabbable_indices\n\n    # Find all current locations of the target primitive on the grid\n    primitive_locations = _get_primitive_locations(initial_grid, primitive)\n\n    # If the primitive does not exist in the environment, it cannot be collected.\n    if not primitive_locations:\n        return []\n\n    # BFS Initialization:\n    # Queue stores tuples of ((current_x, current_y), [list_of_actions_taken_to_reach_here])\n    queue = collections.deque([(start_pos, [])])\n    # Visited set stores (x, y) tuples to prevent cycles and redundant exploration\n    visited = set([start_pos])\n\n    # Breadth-First Search loop\n    while queue:\n        current_pos, path_actions = queue.popleft()\n\n        # Check if the current position is a goal state for collection.\n        # A goal state means the agent is adjacent to or on top of the primitive.\n        is_goal_achieved = False\n        for p_loc in primitive_locations:\n            if _is_adjacent_or_on(current_pos, p_loc):\n                is_goal_achieved = True\n                break\n        \n        if is_goal_achieved:\n            # If a goal position is reached, append the USE action and return the path.\n            return path_actions + [ACTIONS.USE]\n\n        # Explore possible moves (UP, DOWN, LEFT, RIGHT) from the current position\n        for action in [ACTIONS.UP, ACTIONS.DOWN, ACTIONS.LEFT, ACTIONS.RIGHT]:\n            dx, dy = ACTION_DELTAS[action]\n            next_pos = (current_pos[0] + dx, current_pos[1] + dy)\n\n            # Check if the next position is valid (within bounds, traversable) and not yet visited\n            if _is_valid_pos_for_agent(next_pos[0], next_pos[1], initial_grid, non_traversable_kinds) and \\\n               next_pos not in visited:\n                \n                visited.add(next_pos)\n                # Add the new state and its path to the queue for further exploration\n                queue.append((next_pos, path_actions + [action]))\n\n    # If the BFS completes and no path to the primitive was found, return an empty list.\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:26:34.525455", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Define action constants based on the CraftLab action_specs\n    # These map to integers used by env.step and CraftState.step\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n    N_MOVEMENT_ACTIONS = 4 # DOWN, UP, LEFT, RIGHT\n\n    initial_craft_state = env._current_state # Access the underlying CraftState for detailed state info\n    world = initial_craft_state.world\n    cookbook = world.cookbook\n\n    # Ensure the primitive is actually a grabbable item\n    if primitive not in cookbook.primitives:\n        # This item cannot be collected by simple 'USE' action\n        return []\n\n    # BFS Initialization\n    # Queue stores tuples of (current_CraftState_object, list_of_actions_to_reach_this_state)\n    queue = collections.deque([(initial_craft_state, [])])\n\n    # Visited set to prevent cycles and redundant exploration.\n    # A state is defined by (agent_position_tuple, agent_direction_integer).\n    # For pathfinding to an item, inventory typically doesn't change until the 'USE' action,\n    # so it's often not included in the visited key for simple collection tasks.\n    visited = set([(initial_craft_state.pos, initial_craft_state.dir)])\n\n    # BFS Loop\n    while queue:\n        current_state, path_actions = queue.popleft()\n\n        # Check if the agent is next to the target primitive\n        if current_state.next_to(primitive):\n            # If so, the final action needed is 'USE'\n            return path_actions + [USE]\n\n        # Explore all possible movement actions from the current state\n        for action in range(N_MOVEMENT_ACTIONS): # Iterate over DOWN, UP, LEFT, RIGHT\n            # Simulate the action to get the resulting new state without modifying the actual env\n            # CraftState.step returns (reward, new_CraftState)\n            _, new_state = current_state.step(action)\n\n            # Define the key for the new state to check if it has been visited\n            new_state_key = (new_state.pos, new_state.dir)\n\n            # If this new state has not been visited, add it to the queue\n            if new_state_key not in visited:\n                visited.add(new_state_key)\n                queue.append((new_state, path_actions + [action]))\n\n    # If the queue is exhausted and no path to the primitive was found\n    return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:26:35.490034", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Define action constants based on CraftLab.action_specs()\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  initial_state = env._current_state # Access the underlying CraftState for simulation\n\n  # BFS Queue: stores (current_CraftState_object, list_of_actions_to_reach_this_state)\n  queue = deque([(initial_state, [])])\n\n  # Visited set: stores (position_tuple, direction_int) to avoid cycles.\n  # For pathfinding to an item, only the agent's position and direction matter,\n  # as inventory does not change until the 'USE' action.\n  visited = set([(initial_state.pos, initial_state.dir)])\n\n  # Main BFS loop\n  while queue:\n    current_state, path_so_far = queue.popleft()\n\n    # Check if the current state allows collection of the primitive\n    # (i.e., the agent is next to the primitive)\n    if current_state.next_to(primitive):\n      # If the agent is next to the primitive, the next action should be 'USE'.\n      # Simulate the 'USE' action on a copy of the current state to verify\n      # that it successfully collects the primitive.\n      _, state_after_use = current_state.step(ACTION_USE)\n\n      # Check if the primitive's count in the inventory increased.\n      # This confirms that the 'USE' action was successful in collecting it.\n      if state_after_use.inventory[primitive] > current_state.inventory[primitive]:\n        return path_so_far + [ACTION_USE]\n      # If 'USE' didn't result in collection (e.g., it was an ungrabbable item,\n      # or a crafting action that requires other ingredients not in inventory),\n      # this path is not a valid collection path, so we continue searching.\n\n    # Explore possible next states by taking movement actions.\n    # We do not explore ACTION_USE here, as it is the final action for collection,\n    # and is handled by the goal check above.\n    for action in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n      # Simulate the action. CraftState.step returns a reward (ignored here)\n      # and a new CraftState instance representing the state after the action.\n      _, new_state = current_state.step(action)\n\n      # Check if this new state (defined by position and direction) has been visited before.\n      new_pos_dir = (new_state.pos, new_state.dir)\n      if new_pos_dir not in visited:\n        visited.add(new_pos_dir)\n        queue.append((new_state, path_so_far + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found,\n  # return an empty list indicating that the primitive cannot be collected.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:27:56.227656", "function_name": "collect", "function_body": "  # Constants for actions\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  actions_to_take = []\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario (which has the initial grid shape)\n  # CraftWorld does not directly have width/height, but CraftScenario does.\n  # The CraftLab environment holds a reference to the scenario.\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell\n      if current_grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  # Find the closest primitive location using Manhattan distance\n  closest_target = None\n  min_distance = float('inf')\n\n  for target_x, target_y in primitive_locations:\n    dist = abs(target_x - current_pos[0]) + abs(target_y - current_pos[1])\n    if dist < min_distance:\n      min_distance = dist\n      closest_target = (target_x, target_y)\n\n  # This should not happen if primitive_locations is not empty, but for safety\n  if closest_target is None:\n    return []\n\n  target_x, target_y = closest_target\n\n  # Simulate agent movement to generate path actions\n  sim_px, sim_py = current_pos\n\n  # Move horizontally first\n  while sim_px != target_x:\n    if sim_px < target_x:\n      actions_to_take.append(_RIGHT)\n      sim_px += 1\n    else: # sim_px > target_x\n      actions_to_take.append(_LEFT)\n      sim_px -= 1\n\n  # Then move vertically\n  while sim_py != target_y:\n    if sim_py < target_y:\n      actions_to_take.append(_DOWN)\n      sim_py += 1\n    else: # sim_py > target_y\n      actions_to_take.append(_UP)\n      sim_py -= 1\n\n  # Once the agent is on the target cell, use the item\n  actions_to_take.append(_USE)\n\n  return actions_to_take", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T16:27:56.297428", "function_name": "collect", "function_body": "    current_state = env._current_state\n    \n    # 1. Check if the primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected\n\n    # Get grid dimensions\n    grid_rows, grid_cols = current_state.grid.shape[0], current_state.grid.shape[1]\n\n    # Initialize BFS queue: (row, col, direction, actions_taken_so_far)\n    # Direction: 0 (N), 1 (E), 2 (S), 3 (W)\n    start_r, start_c = current_state.pos\n    start_dir = current_state.dir\n    \n    # Using a global-like mapping for actions as per action_specs\n    # These values are determined by CraftLab.action_specs()\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    queue = collections.deque([(start_r, start_c, start_dir, [])])\n    \n    # Visited set: (row, col, direction) to avoid cycles\n    visited = set([(start_r, start_c, start_dir)])\n\n    # Direction vectors for cardinal directions (N, E, S, W respectively)\n    DR = [-1, 0, 1, 0] # Change in row\n    DC = [0, 1, 0, -1] # Change in col\n\n    while queue:\n        curr_r, curr_c, curr_dir, path = queue.popleft()\n\n        # Check adjacent cells for the primitive.\n        # This assumes 'USE' acts on a directly cardinal-adjacent cell.\n        for dr_adj, dc_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # N, S, W, E relative to agent\n            check_r, check_c = curr_r + dr_adj, curr_c + dc_adj\n            \n            # Ensure the check position is within grid bounds\n            if 0 <= check_r < grid_rows and 0 <= check_c < grid_cols:\n                if current_state.grid[check_r, check_c, primitive] > 0:\n                    # Found primitive next to current agent position (curr_r, curr_c)!\n                    \n                    final_actions = list(path) # Copy the path to reach (curr_r, curr_c)\n                    \n                    # Determine the required facing direction to USE the primitive at (check_r, check_c)\n                    target_face_dir = -1\n                    if dr_adj == -1 and dc_adj == 0: # Primitive is North of agent\n                        target_face_dir = 0 # Agent must face North\n                    elif dr_adj == 1 and dc_adj == 0: # Primitive is South of agent\n                        target_face_dir = 2 # Agent must face South\n                    elif dr_adj == 0 and dc_adj == -1: # Primitive is West of agent\n                        target_face_dir = 3 # Agent must face West\n                    elif dr_adj == 0 and dc_adj == 1: # Primitive is East of agent\n                        target_face_dir = 1 # Agent must face East\n\n                    # Calculate turns needed to face the target_face_dir\n                    # curr_dir (0:N, 1:E, 2:S, 3:W)\n                    # target_face_dir (0:N, 1:E, 2:S, 3:W)\n                    \n                    turns_needed = (target_face_dir - curr_dir + 4) % 4\n                    \n                    if turns_needed == 1: # 90 degrees clockwise\n                        final_actions.append(ACTION_RIGHT)\n                    elif turns_needed == 2: # 180 degrees\n                        final_actions.extend([ACTION_RIGHT, ACTION_RIGHT])\n                    elif turns_needed == 3: # 90 degrees counter-clockwise\n                        final_actions.append(ACTION_LEFT)\n                    \n                    final_actions.append(ACTION_USE) # Finally, USE the item\n                    return final_actions\n\n        # If primitive not found in neighborhood, explore next states (move and turn actions)\n\n        # Action: UP (Move Forward)\n        next_r_up = curr_r + DR[curr_dir]\n        next_c_up = curr_c + DC[curr_dir]\n        if 0 <= next_r_up < grid_rows and 0 <= next_c_up < grid_cols:\n            if (next_r_up, next_c_up, curr_dir) not in visited:\n                visited.add((next_r_up, next_c_up, curr_dir))\n                queue.append((next_r_up, next_c_up, curr_dir, path + [ACTION_UP]))\n\n        # Action: DOWN (Move Backward)\n        backward_dir_idx = (curr_dir + 2) % 4 # Opposite cardinal direction for movement\n        next_r_down = curr_r + DR[backward_dir_idx]\n        next_c_down = curr_c + DC[backward_dir_idx]\n        if 0 <= next_r_down < grid_rows and 0 <= next_c_down < grid_cols:\n            # When moving backward, the agent's internal direction usually doesn't change\n            if (next_r_down, next_c_down, curr_dir) not in visited: \n                visited.add((next_r_down, next_c_down, curr_dir))\n                queue.append((next_r_down, next_c_down, curr_dir, path + [ACTION_DOWN]))\n\n        # Action: LEFT (Turn Left)\n        next_dir_left = (curr_dir - 1 + 4) % 4\n        if (curr_r, curr_c, next_dir_left) not in visited:\n            visited.add((curr_r, curr_c, next_dir_left))\n            queue.append((curr_r, curr_c, next_dir_left, path + [ACTION_LEFT]))\n\n        # Action: RIGHT (Turn Right)\n        next_dir_right = (curr_dir + 1) % 4\n        if (curr_r, curr_c, next_dir_right) not in visited:\n            visited.add((curr_r, curr_c, next_dir_right))\n            queue.append((curr_r, curr_c, next_dir_right, path + [ACTION_RIGHT]))\n\n    # If the queue becomes empty and no path to the primitive was found\n    return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:29:37.601436", "function_name": "collect", "function_body": "    import collections # For deque\n\n    # Action constants for CraftLab\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    # Get the current state of the CraftLab environment\n    current_state = env._current_state\n    \n    # 1. Check if the primitive is already present in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n        return [] # Primitive is already collected, no actions needed\n\n    # 2. Check if the primitive is immediately usable (i.e., within the agent's 3x3 neighborhood)\n    # If it is, a single USE action might be sufficient to collect it.\n    if current_state.next_to(primitive):\n        return [_USE]\n\n    # 3. If the primitive is not immediately collectable, perform a Breadth-First Search (BFS)\n    # to find the shortest path to a cell from which the primitive can be collected.\n    \n    # Get grid dimensions and the agent's current position\n    grid = current_state.grid\n    WIDTH, HEIGHT, _ = grid.shape\n    start_pos = current_state.pos # (x, y) tuple\n\n    # Find all locations on the grid where the target primitive is present\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            # Check if the primitive's kind index has a count greater than 0 at this grid cell\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n\n    # If the primitive is not found anywhere on the grid, it cannot be collected\n    if not primitive_locations:\n        return []\n    \n    # Determine all potential \"target cells\" for the agent.\n    # A target cell (ax, ay) is any cell from which the agent, if positioned there,\n    # would have the primitive (px, py) within its 3x3 neighborhood.\n    target_cells_for_agent = set()\n    for px, py in primitive_locations:\n        # Iterate through the 3x3 neighborhood around each primitive location (px, py)\n        for dx in [-1, 0, 1]:\n            for dy in [-1, 0, 1]:\n                ax, ay = px + dx, py + dy\n                # Ensure the adjacent cell (ax, ay) is within the grid boundaries\n                if 0 <= ax < WIDTH and 0 <= ay < HEIGHT:\n                    target_cells_for_agent.add((ax, ay))\n    \n    # Initialize BFS: queue stores (current_position, path_of_actions_to_reach_here)\n    q = collections.deque([(start_pos, [])])\n    visited = {start_pos} # Keep track of visited positions to avoid cycles and redundant checks\n    \n    # Set a maximum path length to prevent excessively long searches, especially in large or complex grids.\n    # A heuristic could be proportional to the grid's area.\n    max_path_length = WIDTH * HEIGHT * 2 \n\n    while q:\n        (curr_x, curr_y), path = q.popleft()\n\n        # Prune branches that exceed the maximum allowed path length\n        if len(path) >= max_path_length:\n            continue\n\n        # If the current position is one of our target cells (from which the primitive can be used)\n        if (curr_x, curr_y) in target_cells_for_agent:\n            # We found a valid path to a position to use the primitive.\n            # Append a _USE action to the path and return it.\n            return path + [_USE]\n\n        # Define possible movement directions and their corresponding actions\n        # The (dx, dy) values represent the change in (x, y) coordinates.\n        # x-axis is horizontal (columns), y-axis is vertical (rows).\n        # +x is right, -x is left. +y is down, -y is up.\n        moves = [\n            ((0, 1), _DOWN),  # Move down (y increases)\n            ((0, -1), _UP),   # Move up (y decreases)\n            ((1, 0), _RIGHT), # Move right (x increases)\n            ((-1, 0), _LEFT)  # Move left (x decreases)\n        ]\n\n        for (dx, dy), action in moves:\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_pos = (next_x, next_y)\n\n            # Check if the next position is within grid boundaries and has not been visited yet\n            if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT and next_pos not in visited:\n                # Obstacle checking:\n                # Water (identified by current_state.world.water_index) is typically an impassable obstacle.\n                # We assume the agent cannot move into water, unless the primitive itself *is* water\n                # (in which case, moving onto it might be part of the collection mechanism).\n                is_water_at_next_pos = grid[next_x, next_y, current_state.world.water_index] > 0\n                \n                # If the cell contains water and the primitive to collect is not water itself,\n                # then this path is blocked.\n                if is_water_at_next_pos and primitive != current_state.world.water_index:\n                    continue # Skip this blocked path\n\n                # Other types of \"non_grabbable_indices\" (e.g., workshops) are generally interactive\n                # locations rather than impassable obstacles. Without more specific rules about what\n                # constitutes an impassable wall, we allow movement onto other non-grabbable cells.\n\n                # If the next position is valid and traversable, add it to the queue\n                visited.add(next_pos)\n                q.append((next_pos, path + [action]))\n    \n    # If the BFS completes and no path to a collectable primitive is found within the set limits,\n    # return an empty list of actions, indicating failure to find/collect.\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:29:38.577867", "function_name": "collect", "function_body": "  import collections # Required for deque\n\n  # Assuming constants for actions based on typical Craft/DMLab setups\n  # In a real scenario, these would ideally come from env.action_specs() or env_factory constants.\n  ACTION_UP = 0\n  ACTION_RIGHT = 1\n  ACTION_DOWN = 2\n  ACTION_LEFT = 3\n  ACTION_USE = 4\n\n  # Directions as offsets (dr, dc) for North, East, South, West corresponding to 0, 1, 2, 3\n  # N (0): (-1, 0) - moving UP means row decreases\n  # E (1): (0, 1)  - moving RIGHT means column increases\n  # S (2): (1, 0)  - moving DOWN means row increases\n  # W (3): (0, -1) - moving LEFT means column decreases\n  DIR_OFFSETS = {\n      0: (-1, 0),  # North\n      1: (0, 1),   # East\n      2: (1, 0),   # South\n      3: (0, -1),  # West\n  }\n\n  def find_path_to_primitive(start_craft_state, target_primitive_id):\n      \"\"\"\n      Performs a Breadth-First Search (BFS) to find a sequence of actions\n      (movement + turn) to reach a position adjacent to the target_primitive_id\n      and facing it, ready for a USE action.\n      Returns the list of actions or None if no path is found.\n      \"\"\"\n      q = collections.deque()\n      visited = set() # Stores (row, col, direction) tuples to avoid cycles and redundant exploration\n      # Maps (current_r, current_c, current_d) -> (parent_r, parent_c, parent_d, action_taken_to_reach_here)\n      parent_map = {} \n\n      # Initial state for BFS: agent's current position and direction\n      start_r, start_c = start_craft_state.pos\n      start_d = start_craft_state.dir \n\n      q.append((start_r, start_c, start_d))\n      visited.add((start_r, start_c, start_d))\n\n      # Get grid dimensions for boundary checks\n      grid_width, grid_height, _ = start_craft_state.grid.shape\n\n      while q:\n          r, c, d = q.popleft() # Current agent row, column, and direction\n\n          # --- Check if current state (r, c, d) is a target state ---\n          # A target state is one where the agent is adjacent to the primitive\n          # and facing it, allowing for an immediate USE action.\n          \n          # Calculate coordinates of the cell directly in front of the agent\n          front_r, front_c = r + DIR_OFFSETS[d][0], c + DIR_OFFSETS[d][1]\n\n          # Check if the cell in front is within bounds and contains the target primitive\n          if (0 <= front_r < grid_width and 0 <= front_c < grid_height and\n              start_craft_state.grid[front_r, front_c, target_primitive_id] > 0):\n              \n              # Found a suitable state: agent is positioned to USE the primitive\n              \n              # Reconstruct the path from the starting state to the current (r, c, d) state\n              path_actions_segment = []\n              curr_r, curr_c, curr_d = r, c, d\n              while (curr_r, curr_c, curr_d) != (start_r, start_c, start_d):\n                  prev_r, prev_c, prev_d, action_taken = parent_map[(curr_r, curr_c, curr_d)]\n                  path_actions_segment.append(action_taken)\n                  curr_r, curr_c, curr_d = prev_r, prev_c, prev_d\n              path_actions_segment.reverse() # Reverse to get actions in correct order\n              \n              # Add the final USE action to the path\n              path_actions_segment.append(ACTION_USE)\n              return path_actions_segment\n\n          # --- Explore possible next states (actions) ---\n          \n          # 1. Move Forward (ACTION_UP)\n          next_r_fwd, next_c_fwd = r + DIR_OFFSETS[d][0], c + DIR_OFFSETS[d][1]\n          if (0 <= next_r_fwd < grid_width and 0 <= next_c_fwd < grid_height and\n              (next_r_fwd, next_c_fwd, d) not in visited):\n              # Assume all cells are traversable unless explicitly stated as obstacles\n              q.append((next_r_fwd, next_c_fwd, d))\n              visited.add((next_r_fwd, next_c_fwd, d))\n              parent_map[(next_r_fwd, next_c_fwd, d)] = (r, c, d, ACTION_UP)\n\n          # 2. Turn Left (ACTION_LEFT)\n          next_d_left = (d + 3) % 4 # (d - 1 + 4) % 4\n          if (r, c, next_d_left) not in visited:\n              q.append((r, c, next_d_left))\n              visited.add((r, c, next_d_left))\n              parent_map[(r, c, next_d_left)] = (r, c, d, ACTION_LEFT)\n\n          # 3. Turn Right (ACTION_RIGHT)\n          next_d_right = (d + 1) % 4\n          if (r, c, next_d_right) not in visited:\n              q.append((r, c, next_d_right))\n              visited.add((r, c, next_d_right))\n              parent_map[(r, c, next_d_right)] = (r, c, d, ACTION_RIGHT)\n\n          # 4. Move Backward (ACTION_DOWN)\n          # Calculate coordinates for moving in the opposite direction\n          next_r_bwd, next_c_bwd = r + DIR_OFFSETS[(d + 2) % 4][0], c + DIR_OFFSETS[(d + 2) % 4][1]\n          if (0 <= next_r_bwd < grid_width and 0 <= next_c_bwd < grid_height and\n              (next_r_bwd, next_c_bwd, d) not in visited):\n              q.append((next_r_bwd, next_c_bwd, d))\n              visited.add((next_r_bwd, next_c_bwd, d))\n              parent_map[(next_r_bwd, next_c_bwd, d)] = (r, c, d, ACTION_DOWN)\n\n      return None # No path found to any primitive instance on the grid\n\n  all_actions_taken = []\n  \n  # A safety break to prevent infinite loops in case of dynamic environments or unreachable goals.\n  MAX_COLLECTION_ATTEMPTS = 100 \n\n  for _ in range(MAX_COLLECTION_ATTEMPTS):\n      # Get the current CraftState from the CraftLab environment\n      current_craft_state = env._current_state\n\n      # Check if the primitive is already in the agent's inventory\n      if current_craft_state.inventory[primitive] > 0:\n          return all_actions_taken # Primitive collected, return the sequence of actions\n\n      # Find a path to the primitive from the current state\n      path_segment_actions = find_path_to_primitive(current_craft_state, primitive)\n\n      if path_segment_actions is None:\n          # If no path is found, the primitive might be unreachable or not on the map.\n          # Return the actions taken so far.\n          return all_actions_taken \n\n      # Execute the found path segment step by step\n      for action in path_segment_actions:\n          _, done, _ = env.step(action) # Apply action to the environment\n          all_actions_taken.append(action) # Record the action\n\n          # After each step, re-check if the primitive is collected or if the environment is done\n          if env._current_state.inventory[primitive] > 0:\n              return all_actions_taken # Primitive collected during path execution\n          \n          if done:\n              # Environment terminated (e.g., max_steps reached)\n              return all_actions_taken \n\n  return all_actions_taken # Return actions if max attempts reached without collecting", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:31:10.638456", "function_name": "collect", "function_body": "    # Constants for actions (defined in CraftLab)\n    _ACTIONS = {\n        \"DOWN\": 0,\n        \"UP\": 1,\n        \"LEFT\": 2,\n        \"RIGHT\": 3,\n        \"USE\": 4,\n    }\n\n    # Mapping relative (dx, dy) from agent's position to the direction to face it\n    # This is for cardinal directions only (N, E, S, W)\n    _RELATIVE_POS_TO_DIR = {\n        (0, -1): 0,  # North: item is at (x, y-1)\n        (1, 0): 1,   # East: item is at (x+1, y)\n        (0, 1): 2,   # South: item is at (x, y+1)\n        (-1, 0): 3   # West: item is at (x-1, y)\n    }\n\n    actions = []\n    # Start simulation from a copy of the current environment state\n    current_state = env._current_state\n\n    # Check if the primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    max_simulation_steps = 500  # Maximum actions to attempt to find and collect\n\n    # Parameters for the spiral search pattern\n    moves_in_current_direction = 0\n    steps_to_move_straight = 1  # Number of steps to take before turning\n    turns_made_in_segment = 0   # Counts turns within a segment (0 or 1 for current length, 2 to increment length)\n\n    for _ in range(max_simulation_steps):\n        # 1. Check if the primitive is in the 3x3 neighborhood (excluding current cell)\n        target_coords = None\n        px, py = current_state.pos\n        \n        # Iterate over the 3x3 neighborhood\n        for dx in [-1, 0, 1]:\n            for dy in [-1, 0, 1]:\n                nx, ny = px + dx, py + dy\n                \n                # Skip the agent's current position and out-of-bounds cells\n                if (dx == 0 and dy == 0) or \\\n                   not (0 <= nx < current_state.grid.shape[0] and 0 <= ny < current_state.grid.shape[1]):\n                    continue\n                \n                # If the cell contains the primitive\n                if current_state.grid[nx, ny, primitive] > 0:\n                    target_coords = (nx, ny)\n                    break\n            if target_coords:\n                break\n        \n        if target_coords:\n            # Primitive found in the neighborhood\n            rel_x, rel_y = target_coords[0] - px, target_coords[1] - py\n\n            # If the primitive is directly adjacent (not diagonal)\n            if abs(rel_x) + abs(rel_y) == 1:\n                # Determine the desired direction for the agent to face the target\n                desired_dir = _RELATIVE_POS_TO_DIR[(rel_x, rel_y)]\n                \n                # Calculate the number of RIGHT turns needed to face the desired direction\n                current_dir = current_state.dir\n                num_turns_right = (desired_dir - current_dir + 4) % 4\n\n                # Perform the necessary turns\n                for _ in range(num_turns_right):\n                    actions.append(_ACTIONS[\"RIGHT\"])\n                    current_state = current_state.step(_ACTIONS[\"RIGHT\"])[1] # Simulate the turn\n\n                # Agent is now facing the primitive, so USE it\n                actions.append(_ACTIONS[\"USE\"])\n                current_state = current_state.step(_ACTIONS[\"USE\"])[1] # Simulate the USE action\n\n                # Check if the primitive has been successfully collected into inventory\n                if current_state.inventory[primitive] > 0:\n                    return actions # Success! Return the sequence of actions\n\n            # If the target is diagonal, or otherwise not directly grabbable by just turning and USE,\n            # this implementation will just continue with exploration, hoping to get adjacent later.\n            # A more advanced version would implement micro-pathfinding in the 3x3.\n\n        # 2. If primitive not found, not directly grabbable, or not yet collected after an attempt, explore.\n        # This uses a systematic spiral search pattern to cover the map.\n        \n        moved_forward = False\n        if moves_in_current_direction < steps_to_move_straight:\n            # Try to move UP (forward relative to current direction)\n            _, next_state_after_move = current_state.step(_ACTIONS[\"UP\"])\n            \n            # Check if the move was successful (agent's position changed)\n            if next_state_after_move.pos != current_state.pos:\n                actions.append(_ACTIONS[\"UP\"])\n                current_state = next_state_after_move\n                moves_in_current_direction += 1\n                moved_forward = True\n            # Else (move was blocked), fall through to turning logic below\n\n        # If the agent didn't move forward (either due to reaching straight limit or being blocked)\n        if not moved_forward:\n            # Turn RIGHT to continue the spiral search pattern\n            actions.append(_ACTIONS[\"RIGHT\"])\n            current_state = current_state.step(_ACTIONS[\"RIGHT\"])[1]\n            \n            # Reset the count for moves in the new straight direction\n            moves_in_current_direction = 0\n            \n            # Increment turn counter for the segment. After two turns, increase straight segment length.\n            turns_made_in_segment = (turns_made_in_segment + 1) % 2\n            if turns_made_in_segment == 0: # This means two turns completed (e.g., after 1x1, 1x1, then 2x2, 2x2)\n                steps_to_move_straight += 1\n\n    # If the maximum simulation steps are reached without collecting the primitive\n    return [] # Failed to collect within the given limits", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:31:10.708349", "function_name": "collect", "function_body": "    actions = []\n    # Get initial state; assuming env.reset() returns an observation dictionary,\n    # and env._current_state is the CraftState instance for direct access to grid, pos, etc.\n    env.reset()\n    state = env._current_state\n\n    # Define action constants as per typical DMLab-style environments.\n    # The problem description implies these fixed integer values.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Loop until the primitive is found in the agent's inventory.\n    # The loop also implicitly handles cases where the primitive might disappear from the grid\n    # after being collected (e.g., from 'USE' action).\n    while state.inventory[primitive] == 0:\n        # 1. Find all locations of the primitive on the grid.\n        # The grid shape is (WIDTH, HEIGHT, n_kinds).\n        # np.argwhere returns (x_coord, y_coord) tuples for non-zero elements.\n        primitive_locations_on_grid = np.argwhere(state.grid[:, :, primitive] > 0)\n\n        if len(primitive_locations_on_grid) == 0:\n            # The primitive is no longer visible on the grid.\n            # This could mean it has been collected, or it's simply not present anymore.\n            # Since the inventory check failed, it implies it's neither collected nor visible.\n            # In such a case, we break as there's nothing left to collect from the grid.\n            break\n\n        # 2. Find the closest primitive location to the agent.\n        agent_pos_np = np.array(state.pos)  # Agent's current (x, y) position\n        # Calculate Manhattan distances to all primitive instances.\n        distances = np.sum(np.abs(primitive_locations_on_grid - agent_pos_np), axis=1)\n        closest_idx = np.argmin(distances)\n        target_primitive_pos = primitive_locations_on_grid[closest_idx]  # Closest primitive's (px, py)\n\n        ax, ay = state.pos\n        px, py = target_primitive_pos\n\n        # Calculate relative position of the primitive from the agent.\n        rx = px - ax\n        ry = py - ay\n\n        performed_action = None\n\n        # Check if the agent is adjacent to the target (Manhattan distance of 1).\n        is_adjacent = (abs(rx) + abs(ry) == 1)\n\n        if is_adjacent:\n            # Agent is adjacent. Now, determine if it's facing the primitive.\n            # CraftState.dir mapping: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT.\n            # Corresponding (dx, dy) vectors: UP(0,-1), RIGHT(1,0), DOWN(0,1), LEFT(-1,0).\n            facing_correctly = False\n            if state.dir == 0 and rx == 0 and ry == -1:  # Facing UP\n                facing_correctly = True\n            elif state.dir == 1 and rx == 1 and ry == 0:  # Facing RIGHT\n                facing_correctly = True\n            elif state.dir == 2 and rx == 0 and ry == 1:  # Facing DOWN\n                facing_correctly = True\n            elif state.dir == 3 and rx == -1 and ry == 0:  # Facing LEFT\n                facing_correctly = True\n\n            if facing_correctly:\n                performed_action = USE\n            else:\n                # Not facing correctly, need to turn.\n                # Determine the required target direction based on the relative position.\n                target_dir = -1\n                if rx == 0 and ry == -1:\n                    target_dir = 0  # UP\n                elif rx == 1 and ry == 0:\n                    target_dir = 1  # RIGHT\n                elif rx == 0 and ry == 1:\n                    target_dir = 2  # DOWN\n                elif rx == -1 and ry == 0:\n                    target_dir = 3  # LEFT\n\n                if target_dir != -1:  # This should always be true if is_adjacent is true.\n                    current_dir = state.dir\n                    # Calculate the smallest number of turns (clockwise or counter-clockwise).\n                    diff = (target_dir - current_dir + 4) % 4\n                    if diff == 1:  # Turn Right (e.g., from UP(0) to RIGHT(1))\n                        performed_action = RIGHT\n                    elif diff == 3:  # Turn Left (e.g., from UP(0) to LEFT(3))\n                        performed_action = LEFT\n                    elif diff == 2:  # Turn 180 degrees (either LEFT or RIGHT will achieve this)\n                        performed_action = RIGHT  # Arbitrarily pick RIGHT\n        else:\n            # Agent is not adjacent, so move towards the primitive.\n            # Prioritize movement along the axis with the larger distance.\n            if abs(rx) > abs(ry):\n                performed_action = RIGHT if rx > 0 else LEFT\n            else:\n                performed_action = DOWN if ry > 0 else UP\n\n        # If for any reason no action was determined (e.g., unexpected state or logic failure),\n        # break to prevent an infinite loop.\n        if performed_action is None:\n            break\n\n        # Execute the chosen action and update the environment state.\n        _reward, _done, _ = env.step(performed_action)\n        actions.append(performed_action)\n        state = env._current_state  # Get the new state for the next iteration.\n\n        # Safety break to prevent extremely long action sequences or infinite loops\n        # in case of complex map layouts or unresolvable situations.\n        if len(actions) > 1000:\n            break\n\n    return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:32:24.491355", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:32:25.460057", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (assuming these are globally accessible or derived from problem spec)\n  # Based on CraftLab.action_specs: DOWN->0, UP->1, LEFT->2, RIGHT->3, USE->4\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  current_state = env._current_state\n  initial_pos = current_state.pos\n\n  target_agent_positions = set()\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Identify all possible agent positions from which the primitive can be collected.\n  # A position (r_agent, c_agent) is a target if any cell in its 3x3 neighborhood\n  # (including itself) contains the primitive.\n  for r_agent in range(HEIGHT):\n      for c_agent in range(WIDTH):\n          temp_agent_pos = (c_agent, r_agent) # Agent's position (x, y) = (column, row)\n          \n          found_primitive_nearby = False\n          # Check the 3x3 neighborhood around temp_agent_pos\n          for dr in [-1, 0, 1]:\n              for dc in [-1, 0, 1]:\n                  # Neighbor cell coordinates\n                  nc, nr = c_agent + dc, r_agent + dr\n                  \n                  # Check if neighbor cell is within grid boundaries\n                  if 0 <= nc < WIDTH and 0 <= nr < HEIGHT:\n                      # Check if the primitive is present at this neighbor cell\n                      if grid[nc, nr, primitive] > 0:\n                          found_primitive_nearby = True\n                          break\n              if found_primitive_nearby:\n                  break\n          \n          if found_primitive_nearby:\n              target_agent_positions.add(temp_agent_pos)\n\n  if not target_agent_positions:\n      # The primitive is not present in the environment or not reachable\n      return []\n\n  # Breadth-First Search (BFS) to find the shortest path to any target position.\n  # Queue stores tuples of (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(initial_pos, [])]) \n  visited = {initial_pos} # Set to keep track of visited (x, y) positions\n\n  # Define movement action deltas for (column, row) coordinates\n  action_deltas = {\n      DOWN: (0, 1),  # Move (col, row+1)\n      UP: (0, -1),   # Move (col, row-1)\n      LEFT: (-1, 0), # Move (col-1, row)\n      RIGHT: (1, 0)  # Move (col+1, row)\n  }\n\n  movement_actions = [DOWN, UP, LEFT, RIGHT]\n\n  while q:\n      current_pos, path_actions = q.popleft()\n\n      # If the current position is one of the target positions, we've found a path\n      if current_pos in target_agent_positions:\n          # Append the USE action to the path and return it\n          return path_actions + [USE]\n\n      # Explore all possible movement actions from the current position\n      for action_id in movement_actions:\n          dx, dy = action_deltas[action_id]\n          next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n          next_pos = (next_x, next_y)\n\n          # Check if the next position is within the grid boundaries\n          if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT:\n              # If this position has not been visited yet\n              if next_pos not in visited:\n                  visited.add(next_pos)\n                  new_path = path_actions + [action_id]\n                  q.append((next_pos, new_path))\n  \n  # If the queue becomes empty and no path to a target position was found\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T16:33:36.914940", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants as defined in CraftLab.action_specs()\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  _ACTION_VECTORS = {\n      0: (1, 0),   # DOWN: (dr, dc)\n      1: (-1, 0),  # UP: (dr, dc)\n      2: (0, -1),  # LEFT: (dr, dc)\n      3: (0, 1)    # RIGHT: (dr, dc)\n  }\n  _USE_ACTION = 4\n\n  # Get the current state from the environment\n  # The problem implies we are planning from the current state of `env`.\n  current_state = env._current_state \n\n  # If the primitive is already in the inventory, nothing to collect.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Get grid dimensions and world properties from the state\n  grid = current_state.grid\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n  world = current_state.world\n  \n  # Identify impassable entities. These block movement.\n  # CraftWorld.non_grabbable_indices are good candidates for blocking movement.\n  # (e.g., water, stone if not part of resources to be picked up).\n  impassable_indices = world.non_grabbable_indices\n\n  # Helper function to check if a cell is within bounds and does not contain impassable items.\n  def is_valid_and_passable(r, c):\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      # Check if the cell contains any impassable item\n      for idx in impassable_indices:\n          if grid[r, c, idx] > 0: # If this kind is present at the cell (e.g., a wall)\n              return False\n      return True\n\n  # Helper function to check if a cell (r, c) is adjacent to (or on) the primitive item.\n  # This simulates CraftState.next_to semantics which checks a 3x3 neighborhood around the agent.\n  def is_adjacent_to_primitive(r, c):\n      for dr_adj in [-1, 0, 1]:\n          for dc_adj in [-1, 0, 1]:\n              nr_adj, nc_adj = r + dr_adj, c + dc_adj\n              if 0 <= nr_adj < WIDTH and 0 <= nc_adj < HEIGHT:\n                  if grid[nr_adj, nc_adj, primitive] > 0: # If primitive is found in 3x3 area\n                      return True\n      return False\n\n  # BFS initialization\n  q = collections.deque()\n  # Queue stores tuples: (row, col, list_of_actions_taken_to_reach_here)\n  q.append((current_state.pos[0], current_state.pos[1], [])) \n\n  visited = set()\n  visited.add(current_state.pos) # Add agent's initial position (tuple) to visited\n\n  final_action_path = []\n\n  # BFS loop\n  while q:\n      r, c, path_so_far = q.popleft()\n\n      # Check if the current position allows for 'USE' action on the primitive\n      # If so, we've found the shortest path to a valid 'use' location.\n      if is_adjacent_to_primitive(r, c):\n          final_action_path = path_so_far + [_USE_ACTION]\n          break # Found the shortest path, terminate BFS\n\n      # Explore neighbors (movement actions)\n      for action_idx, (dr, dc) in _ACTION_VECTORS.items():\n          nr, nc = r + dr, c + dc # New row, new column after attempting this action\n          \n          # Check if the new cell is valid, passable, and not yet visited\n          if is_valid_and_passable(nr, nc):\n              if (nr, nc) not in visited:\n                  visited.add((nr, nc))\n                  q.append((nr, nc, path_so_far + [action_idx]))\n\n  return final_action_path", "island_id": 5, "scores": {"3": -1}}
