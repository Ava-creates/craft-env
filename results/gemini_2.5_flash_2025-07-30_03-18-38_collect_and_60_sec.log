{"timestamp": "2025-07-31T02:10:27.620957", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # --- Constants for actions and directions ---\n  # Action IDs (from env.action_specs, ordered for clarity)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement vectors (dx, dy) to their corresponding action ID.\n  # These actions cause the agent to move and inherently face in that direction.\n  MOVEMENT_VECTORS_TO_ACTIONS = {\n      (0, 1): ACTION_DOWN,   # Move South (increasing Y coordinate)\n      (0, -1): ACTION_UP,    # Move North (decreasing Y coordinate)\n      (-1, 0): ACTION_LEFT,  # Move West (decreasing X coordinate)\n      (1, 0): ACTION_RIGHT   # Move East (increasing X coordinate)\n  }\n\n  # Map agent's internal direction ID (0-3) to its corresponding facing vector (dx, dy).\n  # Direction IDs: 0: North (-Y), 1: East (+X), 2: South (+Y), 3: West (-X).\n  DIRECTION_ID_TO_FACING_VECTOR = {\n      0: (0, -1),  # North: Agent is facing \"up\" on the grid\n      1: (1, 0),   # East: Agent is facing \"right\" on the grid\n      2: (0, 1),   # South: Agent is facing \"down\" on the grid\n      3: (-1, 0)   # West: Agent is facing \"left\" on the grid\n  }\n\n  # Map a movement action ID to the agent's resulting internal direction ID.\n  # When the agent takes a movement action (UP, DOWN, LEFT, RIGHT), it faces that direction.\n  ACTION_TO_RESULTING_DIRECTION_ID = {\n      ACTION_UP: 0,     # UP (1) -> North (0)\n      ACTION_RIGHT: 1,  # RIGHT (3) -> East (1)\n      ACTION_DOWN: 2,   # DOWN (0) -> South (2)\n      ACTION_LEFT: 3    # LEFT (2) -> West (3)\n  }\n\n  # --- Extract Initial State Information ---\n  # Get the current observations from the environment to determine the starting state.\n  current_obs = env.observations()\n  # The global grid representation is static for pathfinding obstacles and primitive locations.\n  initial_grid = current_obs['features_dict']['features_global']\n  # Agent's starting position (x, y) as a tuple of integers for consistent hashing.\n  initial_position = tuple(current_obs['features_dict']['pos'].astype(int))\n  # Agent's starting direction, converted from one-hot vector to an integer ID (0-3).\n  initial_direction_id = np.argmax(current_obs['features_dict']['direction'])\n\n  # Determine grid dimensions (grid is typically WIDTH x HEIGHT x N_KINDS).\n  grid_width, grid_height, _ = initial_grid.shape\n  # Retrieve indices of entities that block agent movement from the world configuration.\n  impassable_entity_indices = env.world.non_grabbable_indices\n\n  # --- Helper Functions for Grid and Movement Checks ---\n\n  def _is_coordinate_in_bounds(x, y):\n      \"\"\"Checks if a given (x, y) coordinate is within the grid boundaries.\"\"\"\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  def _is_cell_traversable(x, y):\n      \"\"\"Checks if the cell at (x, y) is traversable by the agent.\n      A cell is considered impassable if it's out of bounds or contains\n      any entity listed in `impassable_entity_indices`.\n      \"\"\"\n      if not _is_coordinate_in_bounds(x, y):\n          return False  # Out-of-bounds cells are not traversable.\n      \n      # Iterate through all impassable entity indices to check if the cell contains any.\n      for entity_idx in impassable_entity_indices:\n          if initial_grid[x, y, entity_idx] > 0:\n              return False  # Cell contains an obstacle.\n      return True  # Cell is clear and traversable.\n\n  # --- Breadth-First Search (BFS) for Pathfinding ---\n\n  # The BFS queue stores states to explore. A state is represented as ((x, y), direction_id).\n  bfs_queue = collections.deque([(initial_position, initial_direction_id)])\n  \n  # The `visited_states` set keeps track of all states already explored to prevent cycles\n  # and redundant computations, ensuring the shortest path is found.\n  visited_states = set([(initial_position, initial_direction_id)])\n  \n  # The `path_reconstruction_map` is used to backtrack and build the sequence of actions\n  # after the BFS finds the target. It maps:\n  # (child_position, child_direction) -> ((parent_position, parent_direction), action_taken_to_reach_child)\n  path_reconstruction_map = {}\n\n  # This variable will store the state ((x, y), direction_id) from which the primitive\n  # can be collected using a single `ACTION_USE` action.\n  target_collection_state = None\n\n  while bfs_queue:\n      (current_x, current_y), current_dir = bfs_queue.popleft()\n      current_bfs_state = ((current_x, current_y), current_dir)\n\n      # Determine the cell directly in front of the agent based on its current position and direction.\n      facing_vector = DIRECTION_ID_TO_FACING_VECTOR[current_dir]\n      front_x, front_y = current_x + facing_vector[0], current_y + facing_vector[1]\n\n      # Check if the desired primitive is located in the cell directly in front of the agent.\n      if _is_coordinate_in_bounds(front_x, front_y) and initial_grid[front_x, front_y, primitive] > 0:\n          # The primitive has been found directly in front! This is a valid state to perform 'USE'.\n          target_collection_state = current_bfs_state\n          break  # Exit BFS as the shortest path to a valid collection point has been found.\n\n      # Explore all possible movement actions from the current state.\n      for move_vector, action_id in MOVEMENT_VECTORS_TO_ACTIONS.items():\n          next_x, next_y = current_x + move_vector[0], current_y + move_vector[1]\n          next_position = (next_x, next_y)\n          # Calculate the agent's new facing direction after this movement.\n          next_direction_id = ACTION_TO_RESULTING_DIRECTION_ID[action_id]\n          next_bfs_state = (next_position, next_direction_id)\n\n          # Only proceed if the next cell is traversable and this state has not been visited before.\n          if _is_cell_traversable(next_x, next_y) and next_bfs_state not in visited_states:\n              visited_states.add(next_bfs_state)\n              # Record the action taken to reach this new state from the current state.\n              path_reconstruction_map[next_bfs_state] = (current_bfs_state, action_id)\n              bfs_queue.append(next_bfs_state)\n\n  # --- Path Reconstruction ---\n\n  # If a `target_collection_state` was found during the BFS:\n  if target_collection_state:\n      # The final action in the sequence is always `ACTION_USE` to collect the primitive.\n      # The path will be built in reverse, from the target state back to the initial state.\n      actions_to_primitive = [ACTION_USE]\n      current_state_in_path = target_collection_state\n\n      # Backtrack from the `target_collection_state` to the `initial_position` and `initial_direction_id`\n      # using the `path_reconstruction_map`.\n      while current_state_in_path != (initial_position, initial_direction_id):\n          # Retrieve the parent state and the action that led to `current_state_in_path`.\n          parent_state, action_from_parent = path_reconstruction_map[current_state_in_path]\n          actions_to_primitive.append(action_from_parent)\n          current_state_in_path = parent_state\n      \n      # The actions were collected in reverse order (from goal to start), so reverse the list\n      # to get the correct sequence of actions from start to goal.\n      return actions_to_primitive[::-1]\n  else:\n      # If the BFS completed and no path to the primitive was found (queue became empty),\n      # return an empty list, indicating that the primitive is unreachable.\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:10:28.593263", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # --- Action and Direction Constants ---\n  # These constants define the integer IDs for actions and map them to\n  # corresponding movement vectors and resulting agent orientations.\n  \n  # Action IDs as defined by the DMLab-style interface.\n  ACTION_DOWN = 0   # Move South (+Y)\n  ACTION_UP = 1     # Move North (-Y)\n  ACTION_LEFT = 2   # Move West (-X)\n  ACTION_RIGHT = 3  # Move East (+X)\n  ACTION_USE = 4    # Interact with object in front\n\n  # Mapping from a (dx, dy) movement vector to the action ID that causes it.\n  # This helps in converting desired movement to environment actions.\n  MOVE_VECTOR_TO_ACTION = {\n      (0, -1): ACTION_UP,    # Move North\n      (0, 1): ACTION_DOWN,   # Move South\n      (-1, 0): ACTION_LEFT,  # Move West\n      (1, 0): ACTION_RIGHT   # Move East\n  }\n\n  # Mapping from the agent's internal direction ID (0-3) to its (dx, dy) facing vector.\n  # Direction IDs: 0 (North), 1 (East), 2 (South), 3 (West).\n  DIRECTION_ID_TO_FACING_VECTOR = {\n      0: (0, -1),  # North: Agent faces towards decreasing Y-coordinate.\n      1: (1, 0),   # East: Agent faces towards increasing X-coordinate.\n      2: (0, 1),   # South: Agent faces towards increasing Y-coordinate.\n      3: (-1, 0)   # West: Agent faces towards decreasing X-coordinate.\n  }\n\n  # Mapping from a (dx, dy) movement vector to the resulting internal direction ID.\n  # When the agent moves, its facing direction updates to match the direction of movement.\n  MOVE_VECTOR_TO_RESULTING_DIRECTION_ID = {\n      (0, -1): 0,  # Moving North results in facing North.\n      (1, 0): 1,   # Moving East results in facing East.\n      (0, 1): 2,   # Moving South results in facing South.\n      (-1, 0): 3   # Moving West results in facing West.\n  }\n\n  # --- Initial State Extraction ---\n  # Get the current observations from the environment to understand the initial state.\n  current_obs = env.observations()\n  \n  # The global grid provides the layout of entities in the world.\n  initial_grid = current_obs['features_dict']['features_global']\n  \n  # The agent's starting position (x, y) is converted to an integer tuple for use as a dict key.\n  initial_position = tuple(current_obs['features_dict']['pos'].astype(int))\n  \n  # The agent's starting direction is given as a one-hot vector; convert it to an integer ID.\n  initial_direction_id = np.argmax(current_obs['features_dict']['direction'])\n\n  # Extract grid dimensions for boundary checks.\n  grid_width, grid_height, _ = initial_grid.shape\n  \n  # Identify entities that block agent movement. These are the \"non-grabbable\" items.\n  impassable_entity_indices = env.world.non_grabbable_indices\n\n  # --- Helper Functions for Grid Navigation ---\n\n  def _is_within_bounds(x, y):\n      \"\"\"Checks if the given (x, y) coordinates are inside the grid boundaries.\"\"\"\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  def _is_cell_traversable(x, y, grid_data):\n      \"\"\"\n      Checks if the cell at (x, y) is traversable by the agent.\n      A cell is non-traversable if it's out of bounds or contains an impassable entity.\n      \"\"\"\n      if not _is_within_bounds(x, y):\n          return False # Outside grid boundaries.\n      \n      # Check if any impassable entity is present in this cell.\n      for entity_idx in impassable_entity_indices:\n          if grid_data[x, y, entity_idx] > 0:\n              return False # Cell contains an obstacle.\n      return True # Cell is clear for movement.\n\n  # --- Breadth-First Search (BFS) for Pathfinding ---\n\n  # The BFS queue stores states to explore. A state is represented as:\n  # ((current_x, current_y), current_direction_id)\n  bfs_queue = collections.deque([(initial_position, initial_direction_id)])\n  \n  # The set of visited states prevents cycles and ensures the shortest path.\n  visited_states = set([(initial_position, initial_direction_id)])\n  \n  # The path_parent_map reconstructs the path. It maps:\n  # `child_state` -> (`parent_state`, `action_taken_to_reach_child`)\n  path_parent_map = {}\n\n  # This variable will store the final state (position, direction) from which\n  # the primitive can be collected by performing an `ACTION_USE`.\n  target_collection_ready_state = None\n\n  while bfs_queue:\n      current_pos, current_dir = bfs_queue.popleft()\n      current_state_key = (current_pos, current_dir)\n\n      # 1. Check if the primitive is directly in front of the agent in the current state.\n      # Calculate the coordinates of the cell directly in front based on current direction.\n      facing_vector = DIRECTION_ID_TO_FACING_VECTOR[current_dir]\n      front_x, front_y = current_pos[0] + facing_vector[0], current_pos[1] + facing_vector[1]\n\n      if _is_within_bounds(front_x, front_y) and initial_grid[front_x, front_y, primitive] > 0:\n          # Primitive found directly in front! This is a valid state to perform 'USE'.\n          target_collection_ready_state = current_state_key\n          break # Exit BFS, as we've found the shortest path to a collection point.\n\n      # 2. Explore possible movement actions from the current state.\n      for move_vec, action_id in MOVE_VECTOR_TO_ACTION.items():\n          next_x, next_y = current_pos[0] + move_vec[0], current_pos[1] + move_vec[1]\n          next_pos = (next_x, next_y)\n          # The agent's direction changes to match the direction of its movement.\n          next_dir = MOVE_VECTOR_TO_RESULTING_DIRECTION_ID[move_vec]\n          next_state_key = (next_pos, next_dir)\n\n          # Only proceed if the next cell is traversable and this state hasn't been visited.\n          if _is_cell_traversable(next_x, next_y, initial_grid) and next_state_key not in visited_states:\n              visited_states.add(next_state_key)\n              # Record how we reached this new state from the current state.\n              path_parent_map[next_state_key] = (current_state_key, action_id)\n              bfs_queue.append(next_state_key)\n\n  # --- Path Reconstruction ---\n\n  # If a valid state from which to collect the primitive was found by BFS:\n  if target_collection_ready_state:\n      # The very last action will always be ACTION_USE to collect the primitive.\n      actions_sequence = [ACTION_USE]\n      \n      # Start backtracking from the `target_collection_ready_state`.\n      current_backtrack_state = target_collection_ready_state\n\n      # Reconstruct the path by moving backward from the target state to the initial state.\n      # The loop continues until we reach the starting position and direction.\n      while current_backtrack_state != (initial_position, initial_direction_id):\n          # Get the parent state and the action that led to the current_backtrack_state.\n          parent_state, action_from_parent = path_parent_map[current_backtrack_state]\n          actions_sequence.append(action_from_parent)\n          current_backtrack_state = parent_state\n      \n      # The actions were collected in reverse order (from goal to start),\n      # so reverse the list to get the correct chronological sequence of actions.\n      return actions_sequence[::-1]\n  else:\n      # If the BFS completed and no path to the primitive was found (e.g., unreachable),\n      # return an empty list of actions.\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T02:12:15.241786", "function_name": "collect", "function_body": "    # Get action mappings (defined inside function for robustness)\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    # Get current state information from the CraftLab environment's internal state\n    # This provides integer coordinates and the actual grid representation.\n    current_state = env._current_state\n    grid = current_state.grid  # numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds)\n                               # Assuming (rows, columns, n_kinds) i.e. (Y_dim, X_dim, n_kinds)\n    pos = current_state.pos    # tuple(int, int) (agent's current x, y position)\n    inventory = current_state.inventory # numpy.ndarray of length n_kinds\n\n    # 1. Check if primitive is already in inventory\n    if inventory[primitive] > 0:\n        return [] # Already collected, no actions needed.\n\n    # Get grid dimensions (rows, columns)\n    HEIGHT, WIDTH, _ = grid.shape # Unpack shape as (rows, columns, depth)\n\n    # Get unwalkable indices from the CraftWorld instance\n    # CraftLab -> CraftScenario -> CraftWorld\n    world = env.scenario.world\n    # Assuming water and stone are the primary unwalkable terrain types\n    unwalkable_indices = {world.water_index, world.stone_index}\n\n    # 2. Find all locations of the primitive on the grid\n    # np.argwhere returns (row_index, col_index) which corresponds to (y_coord, x_coord)\n    # Convert them to (x_coord, y_coord) for consistency with 'pos'\n    primitive_locs_yx = np.argwhere(grid[:, :, primitive] == 1)\n    primitive_loc_set = {(p[1], p[0]) for p in primitive_locs_yx} # Store as (x, y) tuples\n\n    if not primitive_loc_set:\n        return [] # Primitive not found on the grid, cannot collect.\n\n    # 3. Check if the agent is currently on a primitive location\n    # If agent is exactly on the item, just pick it up.\n    if pos in primitive_loc_set:\n        return [USE]\n\n    # 4. BFS to find a path to an adjacent cell of the primitive\n    # Queue stores (current_position_tuple, path_list_of_actions_so_far)\n    q = deque([(pos, [])])\n    visited = {pos} # Stores visited (x, y) tuples to prevent cycles\n\n    # Define movement actions and their corresponding (dx, dy) changes\n    # dx: change in x (column), dy: change in y (row)\n    # Mapping based on common grid conventions: positive x right, positive y down.\n    MOVE_ACTIONS = {\n        DOWN: (0, 1),   # (dx, dy)\n        UP: (0, -1),\n        LEFT: (-1, 0),\n        RIGHT: (1, 0)\n    }\n\n    while q:\n        curr_pos, path = q.popleft() # curr_pos is (x, y) tuple\n\n        # Check if current position is adjacent to any primitive location\n        for p_x, p_y in primitive_loc_set:\n            # Manhattan distance of 1 means adjacent (not diagonal)\n            if abs(curr_pos[0] - p_x) + abs(curr_pos[1] - p_y) == 1:\n                return path + [USE] # Found an adjacent cell, append USE action and return the plan.\n\n        # Explore neighbors\n        for action_val, (dx, dy) in MOVE_ACTIONS.items():\n            next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n            next_pos = (next_x, next_y)\n\n            # Check bounds: (0 <= x < WIDTH, 0 <= y < HEIGHT)\n            if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                continue\n\n            # Check if already visited\n            if next_pos in visited:\n                continue\n\n            # Check if the next cell is unwalkable (contains water or stone)\n            is_unwalkable = False\n            # Grid indexing is (y, x, kind_id) based on (rows, columns, n_kinds) shape\n            for kind_idx in unwalkable_indices:\n                if grid[next_y, next_x, kind_idx] == 1: # Check if the cell contains an unwalkable kind\n                    is_unwalkable = True\n                    break\n            if is_unwalkable:\n                continue\n            \n            # If the cell is traversable, not visited, and within bounds, add to queue\n            visited.add(next_pos)\n            q.append((next_pos, path + [action_val]))\n\n    # If BFS completes and no path is found (e.g., primitive is unreachable)\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T02:12:15.313207", "function_name": "collect", "function_body": "    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Map movement actions to (delta_row, delta_col, new_direction_facing)\n    # Assuming agent turns to face the cardinal direction of movement.\n    # Directions: 0: North, 1: East, 2: South, 3: West\n    MOVE_ACTIONS = {\n        ACTION_UP: (-1, 0, 0),    # Move North (row decreases), face North\n        ACTION_DOWN: (1, 0, 2),   # Move South (row increases), face South\n        ACTION_LEFT: (0, -1, 3),  # Move West (col decreases), face West\n        ACTION_RIGHT: (0, 1, 1),  # Move East (col increases), face East\n    }\n\n    # Get current state information from the CraftLab environment.\n    # The `env` object is a CraftLab instance.\n    current_state = env._current_state\n    initial_grid = current_state.grid\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir # Agent's current facing direction\n    world = current_state.world\n    \n    # Extract grid dimensions\n    HEIGHT, WIDTH, _ = initial_grid.shape\n    \n    # Get indices of items that block agent movement (non-grabbable obstacles)\n    non_grabbable_indices = world.non_grabbable_indices\n    \n    # Get the set of primitive resource indices from the cookbook.\n    # This ensures that the 'primitive' argument is actually a directly collectable item.\n    primitives_set = world.cookbook.primitives \n\n    # If the requested primitive is not in the known set of grabbable primitives,\n    # it implies it cannot be collected directly by this function.\n    if primitive not in primitives_set:\n        return []\n\n    # Define a helper function to check if a cell is traversable.\n    # A cell is traversable if it's within grid bounds and does not contain\n    # any non-grabbable entities.\n    def is_traversable(r, c):\n        if not (0 <= r < HEIGHT and 0 <= c < WIDTH):\n            return False # Out of bounds\n        \n        # Iterate through known non-grabbable kinds. If the cell (r,c) has any count\n        # for a non-grabbable kind, it's considered blocked.\n        for kind_idx in non_grabbable_indices:\n            if initial_grid[r, c, kind_idx] > 0:\n                return False # Contains a non-grabbable obstacle\n        return True\n\n    # Initialize BFS queue and visited set.\n    # The queue stores tuples: (current_row, current_col, current_direction, list_of_actions_taken_so_far).\n    queue = []\n    # The visited set stores tuples: (row, col, direction) to avoid redundant exploration\n    # and infinite loops in cyclic paths.\n    visited = set()\n\n    # Add the initial state to the queue.\n    start_node = (initial_pos[0], initial_pos[1], initial_dir, [])\n    queue.append(start_node)\n    visited.add((initial_pos[0], initial_pos[1], initial_dir))\n\n    # BFS Loop: continues as long as there are states to explore in the queue.\n    while queue:\n        r, c, d, path = queue.pop(0) # Pop from the front of the list (BFS explores shortest paths first)\n\n        # Check if the current agent position (r,c) and direction (d) allow\n        # collecting the primitive using the USE action.\n        # The USE action applies to the cell directly in front of the agent.\n        \n        # Define relative coordinates for cells in front of agent for each direction:\n        # 0:N (-1,0), 1:E (0,1), 2:S (1,0), 3:W (0,-1)\n        facing_dr = [-1, 0, 1, 0] # delta_row for North, East, South, West\n        facing_dc = [0, 1, 0, -1] # delta_col for North, East, South, West\n\n        # Calculate the coordinates of the cell directly in front of the agent\n        # based on its current direction 'd'.\n        item_r, item_c = r + facing_dr[d], c + facing_dc[d]\n        \n        # Check if the cell in front is within bounds and contains the desired primitive.\n        if (0 <= item_r < HEIGHT and 0 <= item_c < WIDTH and \n            initial_grid[item_r, item_c, primitive] > 0):\n            \n            # If the primitive is directly in front and grabbable,\n            # we can perform the USE action.\n            # Append USE action to the current path and return it.\n            return path + [ACTION_USE]\n\n        # If the goal is not met, explore possible movement actions from the current state.\n        for action, (dr_move, dc_move, new_d) in MOVE_ACTIONS.items():\n            next_r, next_c = r + dr_move, c + dc_move\n            next_state_tuple = (next_r, next_c, new_d)\n\n            # Only add to the queue if the next cell is traversable and\n            # this (position, direction) state has not been visited before.\n            if is_traversable(next_r, next_c) and next_state_tuple not in visited:\n                visited.add(next_state_tuple)\n                queue.append((next_r, next_c, new_d, path + [action]))\n\n    # If the queue becomes empty and no path to collect the primitive was found,\n    # return an empty list of actions.\n    return []", "island_id": 1, "scores": {"3": -1}}
