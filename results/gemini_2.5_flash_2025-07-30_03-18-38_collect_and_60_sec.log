{"timestamp": "2025-07-30T06:07:02.465518", "function_name": "collect", "function_body": "    import collections # Must be inside the function as per constraints\n\n    # Define action constants based on CraftLab.action_specs\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Get initial state/observations.\n    # The `env` object is a CraftLab instance. Its `reset()` method updates its internal state.\n    obs = env.reset() \n    # Access the underlying CraftState instance from CraftLab to get grid, inventory, pos.\n    current_state = env._current_state \n\n    # Check if the primitive is already in the inventory. If so, no actions are needed.\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions and agent's starting position\n    grid = current_state.grid\n    grid_width, grid_height, _ = grid.shape\n    start_pos = current_state.pos # (row, col)\n\n    # Get non-grabbable indices from the world. These entities act as obstacles for movement.\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # Define movement deltas for BFS (row, col)\n    # Maps action constant to its corresponding (dr, dc) delta\n    DELTAS = {\n        UP: (-1, 0),\n        DOWN: (1, 0),\n        LEFT: (0, -1),\n        RIGHT: (0, 1)\n    }\n    \n    # BFS (Breadth-First Search) for shortest pathfinding\n    # The queue stores tuples: (current_row, current_col, list_of_actions_taken_to_reach_this_cell)\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    \n    # The visited set stores (row, col) tuples to prevent revisiting cells and loops,\n    # ensuring the shortest path is found.\n    visited = {(start_pos[0], start_pos[1])}\n\n    while queue:\n        curr_r, curr_c, path = queue.popleft()\n\n        # First, check if the current cell is adjacent to the primitive.\n        # If it is, we can perform the USE action from this cell.\n        # We iterate through the 4 cardinal directions to check adjacent cells.\n        for action_to_adj_cell, (dr_adj, dc_adj) in DELTAS.items():\n            adj_r, adj_c = curr_r + dr_adj, curr_c + dc_adj\n            \n            # Check if the adjacent cell is within grid boundaries\n            if not (0 <= adj_r < grid_width and 0 <= adj_c < grid_height):\n                continue\n\n            # Check if this adjacent cell contains the target primitive.\n            # The grid uses one-hot encoding, so grid[r, c, k] == 1 means kind 'k' is at (r, c).\n            if grid[adj_r, adj_c, primitive] == 1:\n                # Found a path to a cell from which the primitive can be used.\n                # The total path is the sequence of movements to 'curr_c' plus the 'USE' action.\n                return path + [USE]\n\n        # If not adjacent to the primitive, explore valid neighboring cells for movement.\n        # This expands the BFS outwards from the current cell.\n        for action_type, (dr_move, dc_move) in DELTAS.items():\n            next_r, next_c = curr_r + dr_move, curr_c + dc_move\n\n            # Check if the next cell is within grid boundaries\n            if not (0 <= next_r < grid_width and 0 <= next_c < grid_height):\n                continue\n\n            # Determine if the next cell is traversable.\n            # A cell is considered non-traversable if it contains any non-grabbable item.\n            # The agent cannot move into cells occupied by such obstacles.\n            is_traversable = True\n            for k_idx in non_grabbable_indices:\n                if grid[next_r, next_c, k_idx] == 1:\n                    is_traversable = False\n                    break\n            \n            # If the cell is traversable and has not been visited yet, add it to the queue.\n            if is_traversable and (next_r, next_c) not in visited:\n                visited.add((next_r, next_c))\n                queue.append((next_r, next_c, path + [action_type]))\n\n    # If the BFS queue becomes empty and no path to the primitive was found,\n    # it implies the primitive is either not present on the grid or is unreachable from the start position.\n    return []", "island_id": 7, "scores": {"3": -1}}
