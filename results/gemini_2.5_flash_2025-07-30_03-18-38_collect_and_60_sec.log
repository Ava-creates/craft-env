{"timestamp": "2025-07-30T20:23:17.201596", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Get current state and relevant info from the environment\n    obs = env.observations()\n    state = env._current_state\n    inventory = state.inventory\n    grid = state.grid\n    current_pos = state.pos # Agent's current (x, y) position\n    world = state.world # CraftWorld instance, provides info about the world\n\n    # Check if the primitive is already in the agent's inventory\n    if inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # Get grid dimensions (WIDTH, HEIGHT, n_kinds)\n    grid_width, grid_height, _ = grid.shape\n\n    # Get action mappings from the environment (e.g., {'DOWN':0, 'UP':1, ...})\n    # This avoids hardcoding action values and external imports.\n    action_map = env.action_specs()\n    \n    # Define movement deltas and their corresponding action names\n    # These map (dx, dy) to the string name of the action\n    move_deltas = [\n        ((0, 1), 'DOWN'),  # Move one step in +Y direction (down)\n        ((0, -1), 'UP'),   # Move one step in -Y direction (up)\n        ((-1, 0), 'LEFT'), # Move one step in -X direction (left)\n        ((1, 0), 'RIGHT'), # Move one step in +X direction (right)\n    ]\n    \n    # Identify impassable tiles.\n    # Assuming 'water_index' is the only type of terrain that the agent cannot walk through.\n    # This index is obtained from the CraftWorld instance.\n    impassable_kind = world.water_index \n    \n    # Initialize Breadth-First Search (BFS)\n    # The queue stores tuples: (current_position, list_of_actions_to_reach_this_position)\n    q = collections.deque([(current_pos, [])]) \n    \n    # Keep track of visited positions to prevent infinite loops and find shortest path\n    visited = {current_pos} \n\n    # BFS search loop\n    while q:\n        (x, y), path_actions = q.popleft()\n\n        # Check if the current cell (x, y) contains the primitive we are looking for\n        # grid[x, y, primitive] == 1 means the primitive item is present at this location\n        if grid[x, y, primitive] == 1:\n            # If found, the `path_actions` contains the sequence of movements to reach the primitive.\n            # After reaching it, the agent needs to perform a 'USE' action to collect it.\n            return path_actions + [action_map['USE']]\n\n        # Explore all possible neighboring cells\n        for (dx, dy), action_name in move_deltas:\n            next_x, next_y = x + dx, y + dy\n            next_pos = (next_x, next_y)\n\n            # Check if the next_pos is within the grid boundaries\n            if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n                continue # Out of bounds, skip\n\n            # Check if the next_pos contains an impassable kind (e.g., water)\n            if grid[next_x, next_y, impassable_kind] == 1:\n                continue # Impassable terrain, skip\n\n            # Check if this position has already been visited during the BFS\n            if next_pos in visited:\n                continue # Already processed, skip to avoid redundant paths\n\n            # If the next_pos is valid and unvisited, mark it as visited and add to the queue\n            visited.add(next_pos)\n            q.append((next_pos, path_actions + [action_map[action_name]]))\n    \n    # If the BFS queue becomes empty and the primitive was not found on the grid or is unreachable,\n    # return an empty list of actions, indicating it cannot be collected.\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:23:17.270421", "function_name": "collect", "function_body": "    initial_state = env._current_state\n    \n    # If the primitive is already in the inventory, no actions needed.\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    # Queue for BFS: stores tuples of (CraftState, list_of_actions_to_reach_this_state)\n    q = collections.deque([(initial_state, [])])\n    \n    # Set to store visited states to avoid cycles and redundant computations.\n    # A state is uniquely identified by its (position, direction).\n    visited = set()\n    visited.add((initial_state.pos, initial_state.dir))\n\n    # Maximum path length to prevent excessively long searches for unreachable items\n    # or in very large maps. A path can't be longer than the number of states (W*H*4).\n    # This value is a practical upper bound for typical grid sizes.\n    MAX_PATH_LENGTH = 1000 \n\n    while q:\n        current_state, current_actions = q.popleft()\n\n        # If we are next to the primitive, we can perform the USE action.\n        if current_state.next_to(primitive):\n            # 4 corresponds to the USE action (as per action_specs: USE->4)\n            return current_actions + [4] \n\n        # Prune paths that are too long to avoid excessive computation\n        if len(current_actions) >= MAX_PATH_LENGTH:\n            continue\n\n        # Explore possible next states by trying all movement actions\n        # 0: DOWN, 1: UP, 2: LEFT, 3: RIGHT (as per action_specs)\n        for action in [0, 1, 2, 3]: \n            # Simulate the action on the current state to get the next state.\n            # CraftState.step returns (reward, new_state), reward is always 0.0.\n            _, next_state = current_state.step(action)\n            \n            # Create a unique key for the next state to check if it has been visited\n            state_key = (next_state.pos, next_state.dir)\n\n            if state_key not in visited:\n                visited.add(state_key)\n                q.append((next_state, current_actions + [action]))\n\n    # If the queue becomes empty and the primitive was not collected,\n    # it means the item is unreachable or the search limit was hit.\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:24:58.303057", "function_name": "collect", "function_body": "  import collections\n\n  # Get action mappings\n  _action_map = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = _action_map[\"DOWN\"], _action_map[\"UP\"], _action_map[\"LEFT\"], _action_map[\"RIGHT\"], _action_map[\"USE\"]\n\n  # Map (dr, dc) to action index for movement\n  # (dr, dc) represents (delta_row, delta_col)\n  _delta_to_action = {\n      (-1, 0): UP,    # Row decreases (move up)\n      (1, 0): DOWN,   # Row increases (move down)\n      (0, -1): LEFT,  # Col decreases (move left)\n      (0, 1): RIGHT,  # Col increases (move right)\n  }\n\n  obs = env.observations()\n  features_dict = obs[\"features_dict\"]\n  grid = features_dict[\"features_global\"]\n\n  # Grid shape is (HEIGHT, WIDTH, n_kinds) based on typical numpy indexing (row, col)\n  num_rows, num_cols, _ = grid.shape\n\n  # Convert normalized position back to integer coordinates\n  # Assuming features_dict[\"pos\"] is a numpy array of (normalized_row, normalized_col)\n  current_pos_norm = features_dict[\"pos\"]\n  # Apply round() for robustness with floating point precision, then convert to int\n  # (dim - 1) is used because normalized values are typically in [0, 1] for indices 0 to dim-1.\n  current_pos_int = (int(round(current_pos_norm[0] * (num_rows - 1))),\n                     int(round(current_pos_norm[1] * (num_cols - 1))))\n\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n\n  # Define a helper function to check if a cell is walkable\n  def is_walkable(r, c):\n      # Check grid boundaries\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      # Cannot walk into the target primitive itself\n      if grid[r, c, primitive] > 0:\n          return False\n      # Cannot walk into non-grabbable entities (obstacles)\n      for idx in non_grabbable_indices:\n          if grid[r, c, idx] > 0:\n              return False\n      return True\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = set()\n  for r in range(num_rows):\n      for c in range(num_cols):\n          if grid[r, c, primitive] > 0:\n              primitive_locations.add((r, c))\n\n  if not primitive_locations:\n      return [] # Primitive not found on the grid, cannot collect\n\n  # BFS setup to find the shortest path to a cell adjacent to the primitive\n  queue = collections.deque([(current_pos_int[0], current_pos_int[1], [])]) # (row, col, list_of_actions)\n  visited = set([(current_pos_int[0], current_pos_int[1])])\n\n  while queue:\n      r, c, path = queue.popleft()\n\n      # Check if the current position (r, c) is adjacent to any primitive location\n      # If so, this is a valid position from which to perform the USE action\n      for dr_adj, dc_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # 4-directional neighbors\n          nr_adj, nc_adj = r + dr_adj, c + dc_adj\n          if (nr_adj, nc_adj) in primitive_locations:\n              # Found a path to a cell adjacent to the primitive\n              # The agent can now use the 'USE' action\n              return path + [USE]\n      \n      # Explore walkable neighbors\n      for delta_pos, action_idx in _delta_to_action.items():\n          dr, dc = delta_pos\n          nr, nc = r + dr, c + dc\n\n          if is_walkable(nr, nc) and (nr, nc) not in visited:\n              visited.add((nr, nc))\n              new_path = path + [action_idx]\n              queue.append((nr, nc, new_path))\n\n  # If the BFS completes and no path to an adjacent primitive is found\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:24:58.372433", "function_name": "collect", "function_body": "    import collections\n\n    # Constants for actions and directions\n    # These are defined inside the function body as per the strict prompt requirements.\n    _ACTIONS = {\n        \"DOWN\": 0, \"UP\": 1, \"LEFT\": 2, \"RIGHT\": 3, \"USE\": 4\n    }\n    # Directions corresponding to (dr, dc) for movement actions.\n    # Agent's direction (d) also maps to these values:\n    # 0: south (DOWN), 1: north (UP), 2: west (LEFT), 3: east (RIGHT)\n    _DIRECTIONS_MAP = {\n        _ACTIONS[\"DOWN\"]: (1, 0),\n        _ACTIONS[\"UP\"]: (-1, 0),\n        _ACTIONS[\"LEFT\"]: (0, -1),\n        _ACTIONS[\"RIGHT\"]: (0, 1)\n    }\n\n    # Get current state from the environment\n    current_state = env._current_state\n    grid = current_state.grid\n    init_pos = current_state.pos\n    init_dir = current_state.dir\n    world = current_state.world\n\n    # Get grid dimensions (HEIGHT, WIDTH, N_KINDS)\n    # numpy shape is (rows, columns) which corresponds to (y, x) or (height, width)\n    HEIGHT, WIDTH, _ = grid.shape\n\n    # Identify obstacle kinds. Assume these are impassable for pathfinding.\n    # `world.cookbook.environment` typically contains indices of non-grabbable entities\n    # that are static parts of the environment (e.g., walls, water).\n    obstacle_kinds = world.cookbook.environment\n    \n    # Find all locations where the primitive is present on the grid.\n    # `np.argwhere` returns an array of (row, col) coordinates.\n    primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n    if len(primitive_locations) == 0:\n        return [] # Primitive not found on the grid, so no actions to collect it.\n\n    # BFS for pathfinding.\n    # The queue stores tuples: ((current_row, current_col, current_direction), list_of_actions_to_reach_here)\n    queue = collections.deque()\n    queue.append(((init_pos[0], init_pos[1], init_dir), []))\n\n    # Visited set to avoid redundant exploration and cycles.\n    # Stores (row, col, direction) tuples, as the path depends on both position and facing direction.\n    visited = set()\n    visited.add((init_pos[0], init_pos[1], init_dir))\n    \n    while queue:\n        (r, c, d), path = queue.popleft()\n\n        # Check if the current position (r,c) is adjacent to any primitive location\n        # and if the agent is facing it correctly to use the 'USE' action.\n        for pr, pc in primitive_locations:\n            dr_adj, dc_adj = pr - r, pc - c\n            \n            # Check for adjacency: Manhattan distance of 1 indicates immediate neighbor.\n            if abs(dr_adj) + abs(dc_adj) == 1:\n                # Determine the direction the agent needs to face from (r,c) to (pr,pc).\n                # This corresponds to the `_ACTIONS` value that would lead to that direction.\n                target_dir = -1\n                if dr_adj == 1 and dc_adj == 0:  # Primitive is South of agent\n                    target_dir = _ACTIONS[\"DOWN\"]\n                elif dr_adj == -1 and dc_adj == 0: # Primitive is North of agent\n                    target_dir = _ACTIONS[\"UP\"]\n                elif dr_adj == 0 and dc_adj == 1:  # Primitive is East of agent\n                    target_dir = _ACTIONS[\"RIGHT\"]\n                elif dr_adj == 0 and dc_adj == -1: # Primitive is West of agent\n                    target_dir = _ACTIONS[\"LEFT\"]\n                \n                # If a valid target direction is determined and matches the agent's current direction,\n                # then the agent is in a position to collect the primitive.\n                if target_dir != -1 and d == target_dir:\n                    # Found a path to an adjacent cell, with the agent facing the primitive.\n                    # Append the 'USE' action and return the complete action list.\n                    return path + [_ACTIONS[\"USE\"]]\n\n        # Explore neighboring cells.\n        for action_val, (dr, dc) in _DIRECTIONS_MAP.items():\n            nr, nc = r + dr, c + dc\n            nd = action_val # The agent's new direction will be that of the movement action just taken.\n\n            # Check if the new position (nr, nc) is within the grid boundaries.\n            if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n                continue\n\n            # Check if the new cell (nr, nc) contains an obstacle.\n            is_obstacle = False\n            for obstacle_kind in obstacle_kinds:\n                if grid[nr, nc, obstacle_kind] > 0: # If this specific obstacle kind is present.\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n            \n            # If this new state (position and direction) has not been visited before, add it to the queue.\n            if (nr, nc, nd) not in visited:\n                visited.add((nr, nc, nd))\n                queue.append(((nr, nc, nd), path + [action_val]))\n\n    # If the queue becomes empty and no path to collect the primitive was found, return an empty list.\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:25:42.527068", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Mapping from movement action to the direction the agent would face after taking it\n  ACTION_TO_DIRECTION = {\n      UP_ACTION: NORTH_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  # Mapping from movement action to (dx, dy) delta\n  ACTION_TO_MOVE_DELTA = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  # Mapping from agent's direction to the (dx, dy) delta of the cell directly in front\n  DIRECTION_TO_FRONT_DELTA = {\n      NORTH_DIR: (0, -1),\n      EAST_DIR: (1, 0),\n      SOUTH_DIR: (0, 1),\n      WEST_DIR: (-1, 0)\n  }\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Check if the primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Retrieve global obstacle definitions from the world.\n  # These are entities the agent cannot walk *onto*.\n  non_walkable_indices = set(env.world.non_grabbable_indices)\n  non_walkable_indices.update(env.world.workshop_indices) # Workshops are also not traversable\n\n  def is_traversable(x, y, current_grid, target_primitive_id):\n    \"\"\"Checks if a given grid cell is within bounds and is traversable.\n    A cell is not traversable if it contains:\n    1. The target primitive itself (agent cannot walk onto the item it wants to collect).\n    2. Any other non-walkable item (e.g., water, stone, workshop).\n    \"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check if the cell contains the target primitive itself.\n    # An agent cannot move onto a grabbable primitive to collect it.\n    if current_grid[y, x, target_primitive_id] > 0:\n      return False\n    \n    # Check for other generally non-walkable items.\n    for kind_idx in non_walkable_indices:\n      if current_grid[y, x, kind_idx] > 0:\n        return False\n        \n    return True\n\n  # Initialize BFS queue: (current_x, current_y, current_direction, path_actions_list)\n  queue = collections.deque([(start_pos_x, start_pos_y, start_dir, [])])\n  # Initialize visited set to avoid cycles and redundant paths: (x, y, direction)\n  visited = {(start_pos_x, start_pos_y, start_dir)}\n\n  # Run BFS\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # --- Goal Check: Can we use the primitive from the current state? ---\n    # Determine the cell directly in front of the agent\n    front_dx, front_dy = DIRECTION_TO_FRONT_DELTA[curr_dir]\n    front_x, front_y = curr_x + front_dx, curr_y + front_dy\n\n    # Check if the cell in front is within bounds and contains the primitive.\n    # This is the condition for being able to perform a USE action.\n    if (0 <= front_x < grid_width and 0 <= front_y < grid_height and\n        grid[front_y, front_x, primitive_id] > 0):\n      return path_actions + [USE_ACTION] # Goal reached: return path plus USE action\n\n    # --- Expand possible next states ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for move_action, (dx, dy) in ACTION_TO_MOVE_DELTA.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      # After a movement action, the agent's direction automatically aligns with the movement.\n      next_dir_after_move = ACTION_TO_DIRECTION[move_action]\n\n      if is_traversable(next_x, next_y, grid, primitive_id) and\\\n         (next_x, next_y, next_dir_after_move) not in visited:\n        visited.add((next_x, next_y, next_dir_after_move))\n        queue.append((next_x, next_y, next_dir_after_move, path_actions + [move_action]))\n\n    # B. Turning Actions (LEFT, RIGHT)\n    # These actions change direction but not position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n\n      # Position remains the same. Check if this (pos, new_dir) state has been visited.\n      if (curr_x, curr_y, next_dir) not in visited:\n        visited.add((curr_x, curr_y, next_dir))\n        queue.append((curr_x, curr_y, next_dir, path_actions + [turn_action]))\n\n  # If the queue becomes empty and no path to a primitive was found\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T20:25:43.500992", "function_name": "collect", "function_body": "  import collections\n\n  # Actions\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Directions (matching CraftState's internal representation)\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Mapping from movement action to the resulting direction of the agent\n  ACTION_TO_DIRECTION = {\n      UP_ACTION: NORTH_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  # Mapping from movement action to (dx, dy) delta\n  ACTION_TO_MOVE_DELTA = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  # Mapping from agent's direction to the (dx, dy) delta of the cell directly in front\n  DIRECTION_TO_FRONT_DELTA = {\n      NORTH_DIR: (0, -1),\n      EAST_DIR: (1, 0),\n      SOUTH_DIR: (0, 1),\n      WEST_DIR: (-1, 0)\n  }\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  current_state = env._current_state\n  \n  # If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Define all indices that represent un-traversable (obstacle) grid cells.\n  # This includes non-grabbable items, workshops, and the primitive itself\n  # (as agent needs to be adjacent to collect, not on top of it).\n  obstacle_indices = set()\n  obstacle_indices.update(env.world.non_grabbable_indices)\n  obstacle_indices.update(env.world.workshop_indices)\n  obstacle_indices.add(primitive_id) # Cannot walk onto the primitive itself\n\n  def is_walkable(x, y):\n    \"\"\"\n    Checks if a given grid cell (x, y) is within bounds and does not contain\n    any obstacle entities.\n    \"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check if the cell contains any obstacle\n    for obs_idx in obstacle_indices:\n      if grid[y, x, obs_idx] > 0: # grid is indexed as (height, width, kinds)\n        return False\n    return True\n\n  # Initialize BFS queue: (current_x, current_y, current_direction, path_actions_list)\n  queue = collections.deque([(start_pos_x, start_pos_y, start_dir, [])])\n  # Initialize visited set to avoid cycles and redundant paths: (x, y, direction)\n  visited = {(start_pos_x, start_pos_y, start_dir)}\n\n  # Run BFS\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # --- Goal Check: Can we collect the primitive from the current state? ---\n    # Determine the cell directly in front of the agent based on its current direction.\n    front_dx, front_dy = DIRECTION_TO_FRONT_DELTA[curr_dir]\n    front_x, front_y = curr_x + front_dx, curr_y + front_dy\n\n    # Check if the cell in front is within bounds and contains the primitive.\n    if (0 <= front_x < grid_width and 0 <= front_y < grid_height and\n        grid[front_y, front_x, primitive_id] > 0):\n      # Goal reached: primitive is in front, so add USE_ACTION and return the path.\n      return path_actions + [USE_ACTION]\n\n    # --- Explore possible next states ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for move_action, (dx, dy) in ACTION_TO_MOVE_DELTA.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      # After a movement action, the agent's direction automatically aligns with the movement direction.\n      next_dir_after_move = ACTION_TO_DIRECTION[move_action]\n\n      # Check if the next cell is walkable and if this state (position + direction) has not been visited.\n      if is_walkable(next_x, next_y) and \\\n         (next_x, next_y, next_dir_after_move) not in visited:\n        visited.add((next_x, next_y, next_dir_after_move))\n        queue.append((next_x, next_y, next_dir_after_move, path_actions + [move_action]))\n\n    # B. Turning Actions (LEFT, RIGHT)\n    # These actions change the agent's direction but not its position.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n\n      # Position remains the same after turning.\n      if (curr_x, curr_y, next_dir) not in visited:\n        visited.add((curr_x, curr_y, next_dir))\n        queue.append((curr_x, curr_y, next_dir, path_actions + [turn_action]))\n  \n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T20:27:07.460671", "function_name": "collect", "function_body": "    state = env._current_state\n    world = state.world\n\n    # Access actions from the world object as they are defined there\n    ACTIONS = world.ACTIONS\n\n    # Get grid dimensions and current agent state\n    HEIGHT, WIDTH, N_KINDS = state.grid.shape\n    start_pos = state.pos\n    current_inventory = state.inventory\n\n    # Non-grabbable items that act as obstacles\n    NON_GRABBABLE = world.non_grabbable_indices\n\n    # 1. Check if the primitive is already in inventory\n    if current_inventory[primitive] > 0:\n        return []\n\n    # 2. BFS to find the shortest path to a cell from which the primitive can be collected.\n    # The `USE` action works on any item in the agent's 3x3 neighborhood (including the cell the agent is on).\n    # Queue stores (current_position, list_of_actions_to_reach_here)\n    # Using collections.deque for efficient appends and pops from both ends\n    queue = collections.deque([(start_pos, [])])\n    visited = {start_pos} # Set of visited positions to avoid cycles and redundant paths\n\n    best_path_actions = None\n\n    while queue:\n        current_pos, actions_so_far = queue.popleft()\n        r, c = current_pos\n\n        # Check if the current_pos is adjacent to (or on) the primitive.\n        # This simulates the CraftState.next_to method and the range of the USE action.\n        # Define 3x3 neighborhood offsets including the center (0,0)\n        neighborhood_offsets = [\n            (-1, -1), (-1, 0), (-1, 1),\n            (0, -1), (0, 0), (0, 1),\n            (1, -1), (1, 0), (1, 1)\n        ]\n\n        found_primitive_nearby = False\n        for dr, dc in neighborhood_offsets:\n            nr, nc = r + dr, c + dc\n            # Ensure the neighbor cell is within grid boundaries\n            if 0 <= nr < HEIGHT and 0 <= nc < WIDTH:\n                # Check if the primitive exists in this neighbor cell\n                if state.grid[nr, nc, primitive] > 0:\n                    best_path_actions = actions_so_far\n                    found_primitive_nearby = True\n                    break # Found a position from which the primitive can be collected\n        \n        if found_primitive_nearby:\n            break # Exit the BFS as a shortest path has been found\n\n        # Explore valid neighboring cells for movement\n        # Movement actions (UP, DOWN, LEFT, RIGHT) cause absolute changes in (row, col)\n        move_actions_map = {\n            ACTIONS.UP: (-1, 0),    # Moves up (decreases row index)\n            ACTIONS.DOWN: (1, 0),   # Moves down (increases row index)\n            ACTIONS.LEFT: (0, -1),  # Moves left (decreases col index)\n            ACTIONS.RIGHT: (0, 1)   # Moves right (increases col index)\n        }\n\n        for action, (dr, dc) in move_actions_map.items():\n            next_r, next_c = r + dr, c + dc\n            next_pos = (next_r, next_c)\n\n            # Check if the next position is within grid boundaries and has not been visited yet\n            if 0 <= next_r < HEIGHT and 0 <= next_c < WIDTH and next_pos not in visited:\n                # Check if the next position is an obstacle.\n                # An obstacle is a cell containing any non-grabbable item that blocks movement.\n                is_obstacle = False\n                for k_idx in NON_GRABBABLE:\n                    if state.grid[next_r, next_c, k_idx] > 0:\n                        is_obstacle = True\n                        break # This cell contains an obstacle, cannot move here\n                \n                if not is_obstacle:\n                    # If not an obstacle, add to visited and queue for further exploration\n                    visited.add(next_pos)\n                    queue.append((next_pos, actions_so_far + [action]))\n\n    # 3. If no path was found to any cell from which a primitive can be collected, return an empty list\n    if best_path_actions is None:\n        return []\n\n    # 4. A path was found. Append the USE action to the sequence of movement actions.\n    # The agent will move to the final position found by BFS, then USE to collect the primitive.\n    final_actions = list(best_path_actions)\n    final_actions.append(ACTIONS.USE)\n\n    return final_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:27:08.463652", "function_name": "collect", "function_body": "  # Define action constants based on CraftLab.action_specs()\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  actions = []\n\n  # Get the current state observation from the environment\n  obs = env.observations()\n  state_dict = obs['features_dict']\n\n  current_grid = state_dict['features_global']\n  current_pos_normalized = state_dict['pos']\n  # Convert normalized float position to integer grid coordinates\n  current_pos = (int(current_pos_normalized[0]), int(current_pos_normalized[1]))\n\n  # Convert one-hot direction vector to an integer (0-3)\n  current_dir_one_hot = state_dict['direction']\n  current_dir = np.argmax(current_dir_one_hot)\n\n  grid_width, grid_height, _ = current_grid.shape\n\n  primitive_locations = []\n  # Iterate through the grid to find all locations of the target primitive\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if current_grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  if not primitive_locations:\n    # If the primitive is not found on the grid, return an empty list of actions\n    return []\n\n  best_primitive_pos = None\n  best_target_pos = None  # The position the agent needs to move to, adjacent to the primitive\n  min_dist = float('inf')\n\n  # Find the closest primitive instance and the optimal adjacent cell to approach it\n  for px, py in primitive_locations:\n    # Consider the four cells adjacent to the primitive: (left, right, up, down)\n    # (dx, dy) relative to the primitive's position (px, py)\n    # Assuming (x, y) corresponds to (column, row) where x increases right, y increases down\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      adj_x, adj_y = px + dx, py + dy\n\n      # Check if the adjacent cell is within the grid boundaries\n      if 0 <= adj_x < grid_width and 0 <= adj_y < grid_height:\n        # Calculate Manhattan distance from the agent's current position to this adjacent cell\n        dist = abs(current_pos[0] - adj_x) + abs(current_pos[1] - adj_y)\n\n        if dist < min_dist:\n          min_dist = dist\n          best_primitive_pos = (px, py)\n          best_target_pos = (adj_x, adj_y)\n\n  if best_target_pos is None:\n    # This might happen if a primitive is completely surrounded by walls or other non-passable items,\n    # or if no valid adjacent position could be found (e.g., at the very edge of the map).\n    return []\n\n  # Unpack the chosen primitive's actual position and the target adjacent position\n  target_primitive_x, target_primitive_y = best_primitive_pos\n  target_agent_x, target_agent_y = best_target_pos\n\n  # Simulate the agent's current position and direction to plan movements\n  sim_x, sim_y = current_pos\n  sim_dir = current_dir\n\n  # Generate actions to move horizontally first, then vertically, to reach target_agent_x, target_agent_y\n  while sim_x != target_agent_x:\n    if sim_x < target_agent_x:\n      actions.append(RIGHT)\n      sim_x += 1\n    else:  # sim_x > target_agent_x\n      actions.append(LEFT)\n      sim_x -= 1\n\n  while sim_y != target_agent_y:\n    if sim_y < target_agent_y:\n      actions.append(DOWN)\n      sim_y += 1\n    else:  # sim_y > target_agent_y\n      actions.append(UP)\n      sim_y -= 1\n\n  # Now the agent is at the `best_target_pos` (sim_x, sim_y).\n  # Next, determine the required direction to face the primitive itself.\n  dx = target_primitive_x - sim_x\n  dy = target_primitive_y - sim_y\n\n  required_dir = -1  # Default invalid direction\n  if dx == 1:  # Primitive is to the right of the agent\n    required_dir = 1  # East\n  elif dx == -1:  # Primitive is to the left of the agent\n    required_dir = 3  # West\n  elif dy == 1:  # Primitive is below the agent\n    required_dir = 2  # South\n  elif dy == -1:  # Primitive is above the agent\n    required_dir = 0  # North\n\n  # Add turning actions if the agent is not already facing the correct direction\n  if required_dir != -1 and sim_dir != required_dir:\n    # Calculate the shortest number of turns (clockwise or counter-clockwise)\n    turn_diff = (required_dir - sim_dir + 4) % 4\n    if turn_diff == 1:  # Needs one 90-degree right turn\n      actions.append(RIGHT)\n    elif turn_diff == 2:  # Needs two 90-degree turns (180 degrees)\n      actions.append(RIGHT)  # Can use two RIGHTs or two LEFTs\n      actions.append(RIGHT)\n    elif turn_diff == 3:  # Needs one 90-degree left turn\n      actions.append(LEFT)\n    \n    # Update the simulated direction after turning\n    sim_dir = required_dir\n\n  # Finally, add the USE action if the primitive is a grabbable item\n  # `env.world` is the `CraftWorld` instance, which contains `grabbable_indices`.\n  if primitive in env.world.grabbable_indices:\n    actions.append(USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:29:24.269688", "function_name": "collect", "function_body": "    # Define action constants and movement deltas internally\n    # These map action values (0-3) to (dr, dc) movement vectors,\n    # based on CraftLab action_specs and CraftState.DIR_DELTAS:\n    # DOWN (0) action sets agent's direction to 0, which corresponds to (0, -1) (North).\n    # UP (1) action sets agent's direction to 1, which corresponds to (1, 0)  (East).\n    # LEFT (2) action sets agent's direction to 2, which corresponds to (0, 1)  (South).\n    # RIGHT (3) action sets agent's direction to 3, which corresponds to (-1, 0) (West).\n    MOVE_DELTAS = {\n        0: (0, -1),  # Action 0 (DOWN) makes agent face North (dir 0) and move (0,-1)\n        1: (1, 0),   # Action 1 (UP) makes agent face East (dir 1) and move (1,0)\n        2: (0, 1),   # Action 2 (LEFT) makes agent face South (dir 2) and move (0,1)\n        3: (-1, 0)   # Action 3 (RIGHT) makes agent face West (dir 3) and move (-1,0)\n    }\n    USE_ACTION = 4\n\n    # Helper function for BFS pathfinding\n    def _bfs_find_path(start_pos, start_dir, target_kind_index, grid, world, is_target_an_item_to_pickup):\n        \"\"\"\n        Performs a BFS to find the shortest path of actions (movements) to an interactable location.\n        The path must end with the agent correctly positioned and oriented to perform a USE action.\n        \n        Args:\n            start_pos: Agent's starting (row, col) tuple.\n            start_dir: Agent's starting direction (int 0-3).\n            target_kind_index: The index of the item/workshop we are looking for.\n            grid: The current numpy grid.\n            world: The CraftWorld instance.\n            is_target_an_item_to_pickup: True if target is a grabbable item, False if it's a workshop.\n        \n        Returns:\n            A tuple: (list_of_actions, final_agent_pos, final_agent_dir, target_object_pos)\n            Returns (None, None, None, None) if no path is found.\n        \"\"\"\n        WIDTH, HEIGHT, _ = grid.shape\n        \n        # Determine kinds of entities that block movement\n        non_movable_kinds = set(world.non_grabbable_indices)\n        non_movable_kinds.update(world.workshop_indices) # Workshops are typically fixed objects that block movement\n\n        # Find all cells containing the target kind\n        target_object_cells = []\n        for r in range(WIDTH):\n            for c in range(HEIGHT):\n                if grid[r, c, target_kind_index] > 0:\n                    target_object_cells.append((r, c))\n\n        if not target_object_cells:\n            return None, None, None, None # Target not present on grid\n\n        # BFS Queue: stores ( (current_row, current_col, current_direction), [list_of_actions_to_reach_here] )\n        q = [((start_pos[0], start_pos[1], start_dir), [])]\n        # Visited set: stores (row, col, direction) to avoid cycles and redundant exploration\n        visited = set([(start_pos[0], start_pos[1], start_dir)])\n\n        best_actions = None\n        min_actions_len = float('inf')\n        found_final_agent_pos_dir = None\n        found_target_object_pos = None\n\n        head_idx = 0 # Manual index for list-based queue to simulate deque.popleft()\n        while head_idx < len(q):\n            (r, c, current_d), actions_so_far = q[head_idx]\n            head_idx += 1\n\n            # Check if current agent position (r,c) is a valid interaction point for any target object\n            for tr, tc in target_object_cells:\n                # Agent must be adjacent to the target object (Manhattan distance of 1)\n                dist = abs(r - tr) + abs(c - tc)\n                if dist == 1:\n                    # Calculate the direction the agent needs to face to interact with (tr, tc)\n                    relative_dr, relative_dc = tr - r, tc - c\n                    required_face_action = None\n                    for action_val, (dx, dy) in MOVE_DELTAS.items():\n                        if dx == relative_dr and dy == relative_dc:\n                            required_face_action = action_val\n                            break\n                    \n                    # If agent is currently facing the correct direction to interact\n                    if required_face_action is not None and current_d == required_face_action:\n                        # This path leads to a valid interaction state\n                        if len(actions_so_far) < min_actions_len:\n                            min_actions_len = len(actions_so_far)\n                            best_actions = list(actions_so_far) # Store a copy of actions\n                            found_final_agent_pos_dir = (r, c, current_d)\n                            found_target_object_pos = (tr, tc)\n                            # Do not return immediately; BFS might find other paths of same length\n                            # that could be preferred by other criteria (e.g., specific target instance),\n                            # but for \"shortest path\", the first one is fine. We collect all to ensure shortest overall.\n\n            # Explore neighbors by trying all movement actions (0, 1, 2, 3)\n            for action in range(4):\n                next_r, next_c = r + MOVE_DELTAS[action][0], c + MOVE_DELTAS[action][1]\n                next_d = action # This action makes the agent face `next_d` and move to `(next_r, next_c)`\n\n                # Check bounds\n                if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n                    continue\n\n                # Check if the next cell is blocked\n                is_cell_blocked = False\n                for kind_idx in non_movable_kinds:\n                    if grid[next_r, next_c, kind_idx] > 0:\n                        is_cell_blocked = True\n                        break\n                # If target is a grabbable item, the agent cannot move *into* the cell it occupies\n                if is_target_an_item_to_pickup and (next_r, next_c) in target_object_cells:\n                    is_cell_blocked = True\n\n                # If not blocked and not visited, add to queue\n                if not is_cell_blocked and (next_r, next_c, next_d) not in visited:\n                    visited.add((next_r, next_c, next_d))\n                    q.append(((next_r, next_c, next_d), actions_so_far + [action]))\n        \n        # Return the best path found\n        if best_actions is not None:\n            return best_actions, found_final_agent_pos_dir[0:2], found_final_agent_pos_dir[2], found_target_object_pos\n        else:\n            return None, None, None, None\n\n\n    # Main logic of collect_v2\n    actions = []\n    current_state = env._current_state\n    world = env.world\n    \n    # 1. Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    is_grabbable_primitive = primitive in world.grabbable_indices\n    is_craftable_item = primitive in world.cookbook.recipes\n\n    if is_grabbable_primitive:\n        # Case 1: Primitive is a grabbable item (e.g., 'wood', 'stone', 'water')\n        # Find path to a cell adjacent to the primitive, facing it correctly.\n        path_actions, _, _, _ = _bfs_find_path(\n            current_state.pos, current_state.dir, primitive, current_state.grid, world,\n            is_target_an_item_to_pickup=True\n        )\n        \n        if path_actions is not None:\n            actions.extend(path_actions)\n            actions.append(USE_ACTION) # Add USE action to pick up the item\n        else:\n            # Cannot find or reach the primitive on the map\n            return []\n        \n    elif is_craftable_item:\n        # Case 2: Primitive is a craftable item (e.g., 'plank', 'axe', 'gold').\n        # This implementation assumes ingredients for crafting are already in the inventory.\n        # The goal is to navigate to a suitable workshop and use it.\n        \n        recipe = world.cookbook.recipes[primitive]\n        required_workshop_idx = None\n        \n        # Check if the recipe specifies a particular workshop (e.g., \"_key\": \"tool_bench\")\n        if \"_key\" in recipe:\n            workshop_name = recipe[\"_key\"]\n            if workshop_name in world.cookbook.index.contents:\n                 required_workshop_idx = world.cookbook.index[workshop_name]\n        \n        # If no specific workshop is required, or the specified one isn't recognized/found,\n        # try to find any general workshop available in the world's workshop_indices.\n        if required_workshop_idx is None:\n            for workshop_idx in world.workshop_indices:\n                # Check if this workshop kind actually exists on the current grid\n                for r_w in range(current_state.grid.shape[0]):\n                    for c_w in range(current_state.grid.shape[1]):\n                        if current_state.grid[r_w, c_w, workshop_idx] > 0:\n                            required_workshop_idx = workshop_idx\n                            break\n                    if required_workshop_idx is not None:\n                        break\n                if required_workshop_idx is not None:\n                    break\n            \n        if required_workshop_idx is None:\n            # No suitable workshop found on the map for crafting\n            return []\n\n        # Find path to a cell adjacent to the workshop, facing it correctly.\n        path_actions, _, _, _ = _bfs_find_path(\n            current_state.pos, current_state.dir, required_workshop_idx, current_state.grid, world,\n            is_target_an_item_to_pickup=False # It's a workshop, not an item to pick up.\n        )\n        \n        if path_actions is not None:\n            actions.extend(path_actions)\n            actions.append(USE_ACTION) # Add USE action to trigger crafting at the workshop\n        else:\n            # Cannot find or reach a workshop on the map\n            return []\n    else:\n        # Primitive is neither a grabbable item nor a craftable item (e.g., an environment feature\n        # that cannot be collected, or an unrecognized item).\n        return []\n\n    return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:29:25.258524", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Define action mappings based on CraftLab.action_specs\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Define movement deltas for (row, col) based on actions\n  # (dr, dc) where dr is change in row, dc is change in column\n  MOVE_DELTAS = {\n      ACTION_DOWN: (1, 0),    # Moving down increases row index\n      ACTION_UP: (-1, 0),     # Moving up decreases row index\n      ACTION_LEFT: (0, -1),   # Moving left decreases column index\n      ACTION_RIGHT: (0, 1)    # Moving right increases column index\n  }\n\n  def _find_path_to_item(current_grid, start_pos, target_kind_idx, width, height):\n      \"\"\"\n      Finds the shortest path of movement actions from start_pos to any cell\n      containing the target_kind_idx in the current_grid using BFS.\n      Returns a list of actions (integers) or None if no path is found.\n      \"\"\"\n      q = deque([(start_pos, [])]) # Queue stores (position (r, c), path_so_far)\n      visited = {start_pos} # Set of visited positions to prevent cycles and redundant exploration\n\n      # Find all locations of the target item on the grid\n      target_locations = []\n      # The current_grid is expected to be of shape (height, width, n_kinds)\n      for r in range(height):\n          for c in range(width):\n              # Check if this cell contains the primitive resource (value > 0)\n              if current_grid[r, c, target_kind_idx] > 0:\n                  target_locations.append((r, c))\n\n      if not target_locations:\n          return None # The primitive item is not found on the grid\n\n      # Perform BFS to find the shortest path to *any* of the target locations\n      while q:\n          (r, c), path = q.popleft()\n\n          # If the current position is one of the target item locations,\n          # we have found the shortest path to it.\n          if (r, c) in target_locations:\n              return path\n\n          # Explore valid neighboring cells\n          for action, (dr, dc) in MOVE_DELTAS.items():\n              nr, nc = r + dr, c + dc # Calculate new row and column\n\n              # Check if the new position is within grid boundaries\n              if 0 <= nr < height and 0 <= nc < width:\n                  # Check if the new position has not been visited yet\n                  if (nr, nc) not in visited:\n                      visited.add((nr, nc)) # Mark as visited\n                      # Add the new state (position and updated path) to the queue\n                      q.append(((nr, nc), path + [action]))\n      \n      return None # No path found to any target location\n\n  # Get the current observations from the environment\n  obs = env.observations()\n  current_inventory = obs['features_dict']['inventory']\n\n  # 1. Check if the primitive is already in the agent's inventory.\n  # If so, no actions are needed.\n  if current_inventory[primitive] > 0:\n      return []\n\n  # Extract the global grid view and current agent position from observations\n  current_grid = obs['features_dict']['features_global']\n  # Agent position is a numpy array [row, col], convert to a tuple of integers\n  current_pos = (int(obs['features_dict']['pos'][0]), int(obs['features_dict']['pos'][1]))\n  \n  # Get the dimensions of the grid\n  height, width, _ = current_grid.shape\n\n  # 2. Check if the agent is already standing on the primitive item.\n  # If so, the only action needed is to \"USE\" it to collect.\n  if current_grid[current_pos[0], current_pos[1], primitive] > 0:\n      return [ACTION_USE]\n\n  # 3. If the primitive is not in inventory and not under the agent,\n  # find the shortest path of movement actions to a cell containing the primitive.\n  path_actions = _find_path_to_item(current_grid, current_pos, primitive, width, height)\n\n  if path_actions is None:\n      # If no path is found (e.g., primitive is unreachable or doesn't exist on grid),\n      # return an empty list of actions.\n      return [] \n  \n  # 4. If a path is found, append the \"USE\" action at the end.\n  # This assumes that the primitive is collected by using an action once reached.\n  return path_actions + [ACTION_USE]", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:31:40.228691", "function_name": "collect", "function_body": "  # Helper for `collect_v2`\n  def _get_action_deltas(action_specs):\n      # Mapping action values to (dx, dy)\n      # Standard grid (0,0) is top-left. X increases right, Y increases down.\n      # UP: (0, -1) (decreases Y)\n      # DOWN: (0, 1) (increases Y)\n      # LEFT: (-1, 0) (decreases X)\n      # RIGHT: (1, 0) (increases X)\n      return {\n          action_specs['UP']: (0, -1),\n          action_specs['DOWN']: (0, 1),\n          action_specs['LEFT']: (-1, 0),\n          action_specs['RIGHT']: (1, 0)\n      }\n\n  # Helper for `collect_v2`\n  def _manhattan_distance(p1, p2):\n      return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  # Helper for `collect_v2` (BFS implementation)\n  def _find_path_bfs(start_pos, target_item_coords, is_target_grabbable, current_grid, world_env_indices, action_deltas):\n      # Dimensions\n      WIDTH, HEIGHT, _ = current_grid.shape\n\n      q = collections.deque([(start_pos, [])]) # (current_pos, path_actions)\n      visited = {start_pos}\n\n      def is_passable(x, y):\n          if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n              return False # Out of bounds\n          \n          # Check if cell contains any impassable environment item\n          cell_contents = current_grid[x, y, :]\n          for env_idx in world_env_indices:\n              if cell_contents[env_idx] > 0:\n                  # If this cell contains an environment (impassable) entity:\n                  # It's an obstacle. This holds even if the `target_item_coords` itself contains an env_idx,\n                  # because we never move INTO environment items, only adjacent to them to `USE`.\n                  return False \n          \n          # If the cell is the `target_item_coords` and the target is not grabbable (needs USE),\n          # then this cell is also impassable for *movement*. We should only move adjacent.\n          if (x, y) == target_item_coords and not is_target_grabbable:\n              return False # Cannot move into a non-grabbable target that needs USE (e.g., water, stone)\n              \n          return True # Passable (empty or contains other grabbable items)\n\n      while q:\n          (cx, cy), path = q.popleft() # Use popleft for BFS\n\n          # Goal check:\n          if is_target_grabbable:\n              # For grabbable items, goal is to move onto the target cell\n              if (cx, cy) == target_item_coords:\n                  return path\n          else:\n              # For non-grabbable items (that need USE), goal is to be adjacent to it\n              if _manhattan_distance((cx, cy), target_item_coords) == 1:\n                  return path # Path to an adjacent cell\n\n          for action_val, (dx, dy) in action_deltas.items():\n              nx, ny = cx + dx, cy + dy\n\n              if is_passable(nx, ny) and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [action_val]))\n      \n      return None # No path found\n\n  actions = []\n  \n  # Get action mappings\n  action_specs = env.action_specs()\n  USE_ACTION = action_specs['USE']\n\n  # Pre-calculate action deltas for BFS\n  ACTION_DELTAS = _get_action_deltas(action_specs)\n\n  # Determine if the primitive is grabbable (collected by moving onto)\n  # or needs USE (collected by moving adjacent and then using).\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  # `env.world.environment` contains indices of non-grabbable (impassable) entities.\n\n  MAX_ITERATIONS = 200 # Safeguard against excessively long runs\n\n  for _ in range(MAX_ITERATIONS):\n      obs = env.observations()\n      current_grid = obs['features_dict']['features_global']\n      current_pos = tuple(obs['features_dict']['pos_abs'])\n      current_inventory = obs['features_dict']['inventory']\n\n      # 1. Check if primitive is already collected\n      if current_inventory[primitive_idx] > 0:\n          break\n\n      # 2. Find the closest target primitive instance on the grid\n      target_item_coords = None\n      min_dist_to_item = float('inf')\n      \n      WIDTH, HEIGHT, _ = current_grid.shape\n      \n      # Iterate over the grid to find all occurrences of the primitive\n      # and select the closest one.\n      for x in range(WIDTH):\n          for y in range(HEIGHT):\n              # Check if this cell contains the primitive_idx item\n              if current_grid[x, y, primitive_idx] > 0:\n                  dist = _manhattan_distance(current_pos, (x, y))\n                  if dist < min_dist_to_item:\n                      min_dist_to_item = dist\n                      target_item_coords = (x, y)\n      \n      if target_item_coords is None:\n          # Primitive not found on the grid anymore. If it's not in inventory either, it's uncollectible.\n          return actions # No more progress possible.\n\n      # 3. Pathfind using BFS\n      path_segment = _find_path_bfs(\n          current_pos,\n          target_item_coords,\n          is_grabbable,\n          current_grid,\n          env.world.environment,\n          ACTION_DELTAS\n      )\n      \n      if path_segment is None:\n          # No path found to the primitive or an adjacent cell.\n          return actions # Cannot reach, return current actions.\n\n      if len(path_segment) > 0:\n          # If path exists, take the first step.\n          next_action = path_segment[0]\n          _, _, _ = env.step(next_action)\n          actions.append(next_action)\n      else:\n          # `path_segment` is empty, meaning `current_pos` is already the BFS target.\n          # This implies that:\n          #   - `is_grabbable` is True and `current_pos == target_item_coords`.\n          #   - `is_grabbable` is False and `_manhattan_distance(current_pos, target_item_coords) == 1`.\n\n          # In both cases, if the primitive is not yet collected, the necessary action is `USE`.\n          next_action = USE_ACTION\n          _, _, _ = env.step(next_action)\n          actions.append(next_action)\n          \n          # The loop will re-evaluate the state in the next iteration and break if collected.\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:31:41.231563", "function_name": "collect", "function_body": "  import collections # Assuming collections is available in the execution environment\n  \n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  world = env.world  # CraftWorld instance\n  \n  WIDTH, HEIGHT, N_KINDS = grid.shape\n  \n  # Get obstacle indices from the world configuration\n  obstacle_indices = world.non_grabbable_indices \n\n  # Define action mappings to changes in (row, col) coordinates\n  # These action constants are assumed to be available from `env_factory`.\n  # DOWN (env_factory.DOWN): +1 row (south)\n  # UP (env_factory.UP): -1 row (north)\n  # LEFT (env_factory.LEFT): -1 col (west)\n  # RIGHT (env_factory.RIGHT): +1 col (east)\n  action_deltas = {\n      env_factory.DOWN: (1, 0),\n      env_factory.UP: (-1, 0),\n      env_factory.LEFT: (0, -1),\n      env_factory.RIGHT: (0, 1),\n  }\n  \n  # Find all locations on the grid where the primitive exists\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          if grid[r, c, primitive] > 0:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      # If the primitive is not in the current grid, return an empty action list.\n      return []\n\n  # Calculate target cells for BFS: any cell adjacent to a primitive location.\n  # The agent needs to reach one of these cells to perform the USE action.\n  target_adjacent_cells = set()\n  for pr, pc in primitive_locations:\n      # Check 4 direct neighbors (Up, Down, Left, Right)\n      for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n          nr, nc = pr + dr, pc + dc\n          # Ensure neighbor is within grid bounds\n          if 0 <= nr < WIDTH and 0 <= nc < HEIGHT:\n              target_adjacent_cells.add((nr, nc))\n\n  # Initialize BFS queue: (current_position, path_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])])\n  # Keep track of visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # Perform Breadth-First Search\n  while q:\n      (r, c), path = q.popleft()\n\n      # Check if the current position is one of the target adjacent cells\n      if (r, c) in target_adjacent_cells:\n          # We found the shortest path to a cell from which the agent can USE the primitive.\n          return path + [env_factory.USE]\n\n      # Explore neighbors by trying all possible movement actions\n      for action_val, (dr, dc) in action_deltas.items():\n          next_r, next_c = r + dr, dc + c\n          next_pos = (next_r, next_c)\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n              continue\n\n          # Check if the next position has already been visited\n          if next_pos in visited:\n              continue\n\n          # Check if the next position is an obstacle\n          is_obstacle = False\n          for kind_idx in range(N_KINDS):\n              if grid[next_r, next_c, kind_idx] > 0 and kind_idx in obstacle_indices:\n                  is_obstacle = True\n                  break\n          \n          if is_obstacle:\n              continue\n\n          # If the next position is valid and not visited, add it to the queue\n          visited.add(next_pos)\n          q.append((next_pos, path + [action_val]))\n\n  # If the BFS queue becomes empty and no path to an adjacent cell was found,\n  # it means the primitive is unreachable in the current grid configuration.\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:33:32.046088", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants (standard for CraftLab)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Mapping of agent direction (int) to (dr, dc) for \"forward\" cell (row, col delta)\n    # CraftState.dir: 0=North, 1=East, 2=South, 3=West\n    # (dr, dc) means (delta_row, delta_col)\n    DIR_DELTAS = {\n        0: (-1, 0),  # NORTH (row decreases)\n        1: (0, 1),   # EAST (col increases)\n        2: (1, 0),   # SOUTH (row increases)\n        3: (0, -1)   # WEST (col decreases)\n    }\n\n    # Mapping of absolute movement actions to their effect on (dr, dc)\n    # and the new facing direction they set\n    # (action_value): ((delta_row, delta_col), new_direction_int)\n    ACTION_EFFECTS = {\n        ACTION_UP:    ((-1, 0), 0), # UP action moves North, sets dir to North (0)\n        ACTION_DOWN:  ((1, 0),  2), # DOWN action moves South, sets dir to South (2)\n        ACTION_LEFT:  ((0, -1), 3), # LEFT action moves West, sets dir to West (3)\n        ACTION_RIGHT: ((0, 1),  1)  # RIGHT action moves East, sets dir to East (1)\n    }\n    \n    actions_taken = []\n    # Arbitrary safety limit for total simulation steps for this collection attempt\n    # The DMLab environment itself also has a `max_steps` which is returned via the `done` flag.\n    MAX_SIM_STEPS = 2000 \n\n    # Get grid dimensions from the scenario (env.scenario is a CraftScenario instance)\n    # CraftScenario.init_grid: numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds)\n    # Assuming standard numpy convention: shape[0] is rows (HEIGHT), shape[1] is cols (WIDTH)\n    GRID_HEIGHT, GRID_WIDTH, _ = env.scenario.init_grid.shape\n\n    # Get non-grabbable and workshop indices from the world (env.world is a CraftWorld instance)\n    non_grabbable_indices = env.world.non_grabbable_indices\n    workshop_indices = env.world.workshop_indices\n\n    # Main loop: keep trying to collect until primitive is in inventory or MAX_SIM_STEPS reached\n    for _ in range(MAX_SIM_STEPS):\n        obs = env.observations()\n        current_state_dict = obs['features_dict']\n        \n        current_inventory = current_state_dict['inventory']\n        if current_inventory[primitive] > 0:\n            return actions_taken # Goal achieved: primitive is now in inventory\n\n        current_grid = current_state_dict['features_global']\n        \n        # Denormalize agent's position from `features_dict['pos']` (normalized_r, normalized_c)\n        # Assuming normalization is `val / (DIM - 1)` for 0-indexed coordinates\n        current_r = int(round(current_state_dict['pos'][0] * (GRID_HEIGHT - 1)))\n        current_c = int(round(current_state_dict['pos'][1] * (GRID_WIDTH - 1)))\n        \n        # Convert one-hot direction array to an integer direction (0, 1, 2, or 3)\n        current_dir = np.argmax(current_state_dict['direction'])\n\n        # --- BFS to find the shortest sequence of actions to reach and use the primitive ---\n        q = collections.deque()\n        # Queue stores: ((row, col, direction), path_actions_list)\n        # The path_actions_list accumulates actions from the start_state to the current_state in BFS\n        q.append(((current_r, current_c, current_dir), []))\n\n        visited = set()\n        visited.add((current_r, current_c, current_dir))\n\n        path_to_take_in_sim = None # This will store the next chunk of actions to execute from current state\n\n        # BFS inner loop to explore the current grid state\n        while q:\n            (r, c, d), path_so_far = q.popleft()\n\n            # 1. Check if the primitive can be 'USE'd from the current (r, c, d) state\n            dr_use, dc_use = DIR_DELTAS[d] # Delta for the cell directly in front of the agent\n            target_r, target_c = r + dr_use, c + dc_use\n\n            if 0 <= target_r < GRID_HEIGHT and 0 <= target_c < GRID_WIDTH:\n                # If the cell in front contains the primitive\n                if current_grid[target_r, target_c, primitive] > 0:\n                    # Found a state from which the 'USE' action can be performed to collect the primitive!\n                    path_to_take_in_sim = path_so_far + [ACTION_USE]\n                    break # Break from BFS inner loop, as a path to the goal (USE action) has been found\n\n            # 2. Explore possible next states by performing movement actions (UP, DOWN, LEFT, RIGHT)\n            for action_val, ((dr_move, dc_move), new_d) in ACTION_EFFECTS.items():\n                new_r, new_c = r + dr_move, c + dc_move\n\n                if 0 <= new_r < GRID_HEIGHT and 0 <= new_c < GRID_WIDTH:\n                    # Check if the new cell is traversable\n                    # A cell is considered impassable if it contains any non-grabbable item\n                    # that is NOT a workshop (workshops are typically traversable)\n                    is_impassable = False\n                    for k_idx in non_grabbable_indices:\n                        if k_idx not in workshop_indices: # Workshops are exceptions, agent can walk on them\n                            if current_grid[new_r, new_c, k_idx] > 0:\n                                is_impassable = True\n                                break # Found an impassable item in this cell, no need to check further kinds\n                    \n                    if not is_impassable:\n                        next_state = (new_r, new_c, new_d)\n                        if next_state not in visited:\n                            visited.add(next_state)\n                            q.append((next_state, path_so_far + [action_val]))\n            \n            # If a path to the goal was found in this iteration of the BFS (or an earlier one),\n            # break from the BFS outer loop as well.\n            if path_to_take_in_sim:\n                break \n\n        # --- End of BFS ---\n\n        if path_to_take_in_sim is None:\n            # If BFS completed without finding any path to the primitive in the current grid configuration.\n            # This implies the primitive is currently unreachable, or no instances remain on the map.\n            # Return the actions taken so far, signaling inability to collect.\n            return actions_taken \n            \n        # Execute the first action from the shortest path found by BFS\n        next_action_to_perform = path_to_take_in_sim[0]\n        _, done, _ = env.step(next_action_to_perform)\n        actions_taken.append(next_action_to_perform)\n\n        if done: # Check if episode termination condition was met (e.g., env's max_steps reached)\n            break\n            \n    # If the main loop finishes (e.g., MAX_SIM_STEPS for this collection attempt reached)\n    # without successfully collecting the primitive, return the actions taken.\n    return actions_taken", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:33:33.084926", "function_name": "collect", "function_body": "  # Get the current state from the environment\n  current_state = env._current_state\n\n  # Check if primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  # BFS to find a path to a location adjacent to the primitive\n  q = collections.deque()\n  visited = set()\n\n  # Agent's current position (x, y) = (column, row)\n  start_pos = current_state.pos \n  q.append((start_pos, []))  # (position_tuple, path_actions_list)\n  visited.add(start_pos)\n\n  # Grid dimensions: (WIDTH, HEIGHT, n_kinds)\n  width, height, _ = current_state.grid.shape\n  grid = current_state.grid\n  world = current_state.world\n  \n  # Define what constitutes an obstacle for movement\n  # Agent cannot move into cells that contain non-grabbable items.\n  # world.water_index is also typically an obstacle.\n  obstacle_kinds = set(world.non_grabbable_indices)\n  if world.water_index >= 0: # Ensure water_index is a valid index before adding\n      obstacle_kinds.add(world.water_index)\n  \n  # Helper function to check if a cell (x, y) is traversable\n  def is_traversable(x, y):\n    # Check bounds\n    if not (0 <= x < width and 0 <= y < height):\n      return False\n    \n    # Check if the cell contains any obstacle kind\n    # grid[x, y, k_idx] > 0 means kind k_idx is present at (x,y)\n    for k_idx in obstacle_kinds:\n      if grid[x, y, k_idx] > 0:\n        return False # Contains an obstacle\n    return True\n\n  # Helper function to check if a position (x, y) is adjacent to the primitive\n  # \"Adjacent\" means within the 3x3 neighborhood around (x, y), including (x, y) itself.\n  # This corresponds to CraftState.next_to(i_kind)\n  def is_adjacent_to_primitive(x, y):\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = x + dx, y + dy\n        # Check bounds for neighbor\n        if 0 <= nx < width and 0 <= ny < height:\n          # Check if the neighbor cell contains the primitive\n          if grid[nx, ny, primitive] > 0:\n            return True\n    return False\n\n  # BFS loop\n  while q:\n    (curr_x, curr_y), path = q.popleft()\n\n    # If the current position is adjacent to the primitive, we have found our target\n    if is_adjacent_to_primitive(curr_x, curr_y):\n        # Add the USE action to the path and return\n        return path + [4] # 4 is the USE action (from action_specs)\n\n    # Explore valid neighbors (movements)\n    # Actions: DOWN=0, UP=1, LEFT=2, RIGHT=3\n    # Mappings from action to (dx, dy) where dx=change_in_col, dy=change_in_row\n    action_deltas = {\n        0: (0, 1),   # DOWN\n        1: (0, -1),  # UP\n        2: (-1, 0),  # LEFT\n        3: (1, 0)    # RIGHT\n    }\n\n    for action_val, (dx, dy) in action_deltas.items():\n      # Calculate next position\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is traversable and not already visited\n      if is_traversable(next_x, next_y) and next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path + [action_val]))\n\n  # If no path is found after exploring all reachable cells\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:34:51.749432", "function_name": "collect", "function_body": "    import collections\n    # Assuming these action constants based on typical DMLab-like environments\n    # In a real system, these would be imported or retrieved from env.action_specs()\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Get initial state from the CraftLab environment\n    # Accessing _current_state directly for the purpose of this problem,\n    # as CraftLab wraps CraftState.\n    current_state = env._current_state \n    \n    # Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get grid dimensions and agent's initial position and direction\n    WIDTH, HEIGHT, N_KINDS = current_state.grid.shape\n    start_pos = current_state.pos\n    start_dir = current_state.dir\n    \n    # Find all locations of the primitive on the grid\n    primitive_locations = set() # Use a set for faster lookup\n    for y in range(HEIGHT):\n        for x in range(WIDTH):\n            if current_state.grid[x, y, primitive] > 0: # Check if the primitive exists at this cell\n                primitive_locations.add((x, y))\n\n    if not primitive_locations:\n        # Primitive not found on the map, cannot collect\n        return []\n\n    # Define action effects on position and direction\n    # (dx, dy, new_dir) for (x,y) change and resulting direction\n    action_effects = {\n        ACTION_DOWN: (0, 1, 2),  # Move South (dy=+1), Face South (dir=2)\n        ACTION_UP: (0, -1, 0),   # Move North (dy=-1), Face North (dir=0)\n        ACTION_LEFT: (-1, 0, 3), # Move West (dx=-1), Face West (dir=3)\n        ACTION_RIGHT: (1, 0, 1), # Move East (dx=+1), Face East (dir=1)\n    }\n\n    # BFS state: ((x, y), dir, path_actions)\n    # Queue stores tuples: (current_position_tuple, current_direction_int, list_of_actions_to_reach_this_state)\n    bfs_queue = collections.deque([((start_pos), start_dir, [])])\n    \n    # Set to keep track of visited states to avoid cycles and redundant paths\n    # A state is defined by (position_tuple, direction_int)\n    bfs_visited_states = {((start_pos), start_dir)} \n\n    final_path = []\n    found_target = False\n\n    while bfs_queue and not found_target:\n        (cx, cy), current_dir, current_path = bfs_queue.popleft()\n\n        # Determine the cell immediately in front of the agent given its current position and direction\n        fx, fy = cx, cy \n        if current_dir == 0: fy -= 1 # Facing North (dir 0)\n        elif current_dir == 1: fx += 1 # Facing East (dir 1)\n        elif current_dir == 2: fy += 1 # Facing South (dir 2)\n        elif current_dir == 3: fx -= 1 # Facing West (dir 3)\n        \n        # Check if the cell in front contains the target primitive\n        if (fx, fy) in primitive_locations:\n            # We are in a state where we can USE the primitive\n            final_path = current_path + [ACTION_USE]\n            found_target = True\n            break # Exit BFS, shortest path found\n\n        # Explore possible movement actions from the current state\n        for action_val, (dx, dy, new_dir) in action_effects.items():\n            nx, ny = cx + dx, cy + dy\n            \n            # Check bounds and if the new cell is not water (obstacle avoidance)\n            # Assuming water (current_state.world.water_index) is an impassable obstacle\n            if (0 <= nx < WIDTH and 0 <= ny < HEIGHT and \n                current_state.grid[nx, ny, current_state.world.water_index] == 0):\n                \n                new_state = ((nx, ny), new_dir)\n                if new_state not in bfs_visited_states:\n                    new_path = current_path + [action_val]\n                    bfs_queue.append((new_state[0], new_state[1], new_path))\n                    bfs_visited_states.add(new_state)\n    \n    return final_path if found_target else []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:34:51.820263", "function_name": "collect", "function_body": "    # Ensure necessary modules are imported (assuming these are available globally as per typical Python module structure)\n    # import numpy as np\n    # import collections\n\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    \n    current_grid = features_dict['features_global']\n    width, height, n_kinds = current_grid.shape\n    \n    pos_norm = features_dict['pos']\n    # Convert normalized position to integer grid coordinates\n    current_pos_int = (int(round(pos_norm[0] * (width - 1))), \n                       int(round(pos_norm[1] * (height - 1))))\n    \n    current_inventory = features_dict['inventory']\n\n    # If the primitive is already collected, no actions are needed.\n    if current_inventory[primitive] > 0:\n        return [] \n\n    # BFS Setup for pathfinding\n    # The queue stores tuples of (current_position, list_of_actions_to_reach_here)\n    queue = collections.deque([(current_pos_int, [])]) \n    # The visited set stores positions to avoid redundant checks and cycles\n    visited = {current_pos_int} \n\n    # Mapping of (dx, dy) to the corresponding action constant from env_factory\n    # Assuming (0,0) is top-left, x increases to the right, y increases downwards.\n    directions = {\n        (0, -1): env_factory.UP,\n        (0, 1): env_factory.DOWN,\n        (-1, 0): env_factory.LEFT,\n        (1, 0): env_factory.RIGHT,\n    }\n\n    # Get indices of impassable entities from the CraftWorld instance\n    # The agent cannot move onto cells occupied by these entities.\n    impassable_indices = env.world.non_grabbable_indices\n\n    # BFS Traversal\n    while queue:\n        (x, y), path_actions = queue.popleft()\n\n        # Check if the current position (x, y) is adjacent to the primitive\n        # A 3x3 neighborhood around (x, y) includes (x, y) itself.\n        is_adjacent = False\n        for dx in [-1, 0, 1]:\n            for dy in [-1, 0, 1]:\n                nx, ny = x + dx, y + dy\n                # Check bounds to ensure the neighbor is within the grid\n                if 0 <= nx < width and 0 <= ny < height:\n                    # Check if the primitive exists at this neighboring cell\n                    if current_grid[nx, ny, primitive] == 1.0:\n                        is_adjacent = True\n                        break # Found an adjacent primitive, no need to check further neighbors for this position\n            if is_adjacent:\n                break # Break from outer loop too\n\n        if is_adjacent:\n            # If the current position is adjacent to the primitive,\n            # we can perform the USE action to collect it.\n            return path_actions + [env_factory.USE]\n\n        # If not adjacent, explore valid neighbors\n        for (dx, dy), action in directions.items():\n            next_x, next_y = x + dx, y + dy\n            next_pos = (next_x, next_y)\n\n            # Check if the next position is within the grid boundaries\n            if not (0 <= next_x < width and 0 <= next_y < height):\n                continue \n\n            # Check if the next position has already been visited\n            if next_pos in visited:\n                continue\n\n            # Check if the next position is traversable (not blocked by an impassable object)\n            is_traversable = True\n            for impassable_idx in impassable_indices:\n                if current_grid[next_x, next_y, impassable_idx] == 1.0:\n                    is_traversable = False\n                    break # Position is blocked, cannot move here\n            \n            if not is_traversable:\n                continue \n\n            # If the position is traversable and not visited, add it to the queue\n            # and mark it as visited.\n            visited.add(next_pos)\n            queue.append((next_pos, path_actions + [action]))\n\n    # If the queue becomes empty and the primitive hasn't been found or collected,\n    # it means it's unreachable or doesn't exist in the current environment.\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:35:42.582815", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Direction constants (0=N, 1=E, 2=S, 3=W clockwise from North)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Defines the effects of movement actions: (dx, dy) change and resulting agent direction\n  # This matches how CraftState.step updates agent state after a move action.\n  move_action_effects = {\n      UP_ACTION: ((0, -1), NORTH_DIR),    # Move up: (x, y-1), face North\n      DOWN_ACTION: ((0, 1), SOUTH_DIR),   # Move down: (x, y+1), face South\n      LEFT_ACTION: ((-1, 0), WEST_DIR),   # Move left: (x-1, y), face West\n      RIGHT_ACTION: ((1, 0), EAST_DIR)    # Move right: (x+1, y), face East\n  }\n\n  # Get primitive's integer ID\n  primitive_id = env.world.cookbook.index[primitive]\n  \n  # Determine if the target is a \"primitive resource\" that needs to be collected via USE.\n  # This influences whether the agent can walk on its cell.\n  is_primitive_resource = primitive_id in env.world.cookbook.primitives\n\n  current_state = env._current_state\n  # Early exit: If we're collecting a primitive resource and already have it, no actions needed.\n  if is_primitive_resource and current_state.inventory[primitive_id] > 0:\n    return []\n\n  # Get current state information\n  grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir # Agent's current facing direction\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Impassable items are those that cannot be picked up or moved through.\n  # The `non_grabbable_indices` set from CraftWorld is used for general obstacles.\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  def is_passable(x, y):\n    \"\"\"\n    Checks if a cell (x, y) is within bounds and does not contain impassable objects.\n    Crucially, for primitive resources, it also prevents walking onto the primitive itself.\n    \"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    \n    # Check if the cell contains any general non-grabbable obstacle\n    for kind_idx in non_grabbable_kinds:\n      if grid[y, x, kind_idx] == 1:\n        return False # Contains an impassable object (e.g., water, stone)\n    \n    # NEW IMPROVEMENT (from v0): Prevent walking onto the primitive itself if it's a resource.\n    # Primitive resources are typically collected from an adjacent cell, not by stepping on them.\n    if is_primitive_resource and grid[y, x, primitive_id] == 1:\n        return False # Cannot walk onto the primitive resource itself\n        \n    return True\n\n  # Find all locations of the primitive on the grid\n  # np.where returns (row_indices, col_indices) which correspond to (y_coords, x_coords)\n  primitive_locations = set() # Store as a set of (x, y) tuples for faster lookup\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n\n  if not primitive_locations:\n    return [] # Primitive not found on the grid\n\n  # --- BFS to find the shortest path to a state from which the primitive can be 'USE'd ---\n  # BFS state: (x, y, dir) - agent's position and facing direction\n  # Queue stores (current_x, current_y, current_dir, path_actions_taken_list)\n  q = collections.deque([(agent_pos_x, agent_pos_y, agent_dir, [])])\n  # Visited set stores (x, y, dir) tuples to prevent cycles and redundant exploration\n  visited = set([(agent_pos_x, agent_pos_y, agent_dir)])\n\n  while q:\n    curr_x, curr_y, curr_dir, path = q.popleft()\n\n    # --- Check if the current state allows for immediate 'USE' of the primitive ---\n    # Calculate the cell directly in front of the agent based on its current direction\n    item_x_in_front, item_y_in_front = curr_x, curr_y\n    if curr_dir == NORTH_DIR:\n        item_y_in_front -= 1\n    elif curr_dir == EAST_DIR:\n        item_x_in_front += 1\n    elif curr_dir == SOUTH_DIR:\n        item_y_in_front += 1\n    elif curr_dir == WEST_DIR:\n        item_x_in_front -= 1\n    \n    # If the cell in front is within bounds and contains the target primitive\n    if (0 <= item_x_in_front < grid_width and \n        0 <= item_y_in_front < grid_height and\n        (item_x_in_front, item_y_in_front) in primitive_locations):\n      # We have found a path to a state from which USE is possible.\n      return path + [USE_ACTION]\n\n    # --- Explore next states from the current state ---\n\n    # 1. Explore movement actions (change position and facing direction)\n    for action, ((dx, dy), resulting_dir) in move_action_effects.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = resulting_dir # Agent's direction changes to face the direction of movement\n\n      if is_passable(next_x, next_y): # Use the improved is_passable check\n        next_state = (next_x, next_y, next_dir)\n        if next_state not in visited:\n          visited.add(next_state)\n          q.append((next_x, next_y, next_dir, path + [action]))\n\n    # 2. Explore turning actions (change facing direction only, position remains the same)\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      next_x, next_y = curr_x, curr_y # Position does not change for a pure turn\n      \n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise (e.g., 0->3, 1->0)\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise (e.g., 0->1, 3->0)\n      \n      next_state = (next_x, next_y, next_dir)\n      if next_state not in visited:\n        visited.add(next_state)\n        q.append((curr_x, curr_y, next_dir, path + [turn_action]))\n  \n  # If the queue becomes empty and no path was found to any primitive\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T20:35:43.614345", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Direction constants (0=N, 1=E, 2=S, 3=W clockwise from North)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Get primitive's integer ID\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Improvement: Early exit if the primitive is already in inventory.\n  # If the agent already possesses the primitive, the \"collect\" task is effectively complete.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir # Agent's current facing direction\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Impassable items are those that cannot be picked up or moved through.\n  # The `non_grabbable_indices` set from CraftWorld defines obstacles.\n  impassable_kinds = env.world.non_grabbable_indices\n\n  def is_passable(x, y):\n    \"\"\"Checks if a cell (x, y) is within bounds and does not contain impassable objects.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    \n    # Check if the cell contains any impassable kind\n    for kind_idx in impassable_kinds:\n      if grid[y, x, kind_idx] == 1:\n        return False # Contains an impassable object\n    return True\n\n  # Find all locations of the primitive on the grid\n  # np.where returns (row_indices, col_indices) which correspond to (y_coords, x_coords)\n  primitive_locations = set() # Store as a set for faster lookup\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n\n  if not primitive_locations:\n    return [] # Target primitive not found on the grid\n\n  # --- BFS to find the shortest path to a state from which the primitive can be 'USE'd ---\n  # BFS state: (x, y, dir) - position and facing direction\n  # Queue stores (current_x, current_y, current_dir, path_actions_taken)\n  q = collections.deque([(agent_pos_x, agent_pos_y, agent_dir, [])])\n  # Visited set stores (x, y, dir) tuples to prevent cycles and redundant exploration\n  visited = set([(agent_pos_x, agent_pos_y, agent_dir)])\n\n  # Defines the effects of movement actions: (dx, dy) change and resulting agent direction\n  # This matches how CraftState.step updates agent state after a move action.\n  move_action_effects = {\n      UP_ACTION: ((0, -1), NORTH_DIR),    # Move up: (x, y-1), face North\n      DOWN_ACTION: ((0, 1), SOUTH_DIR),   # Move down: (x, y+1), face South\n      LEFT_ACTION: ((-1, 0), WEST_DIR),   # Move left: (x-1, y), face West\n      RIGHT_ACTION: ((1, 0), EAST_DIR)    # Move right: (x+1, y), face East\n  }\n\n  while q:\n    curr_x, curr_y, curr_dir, path = q.popleft()\n\n    # --- Check if the current state allows for immediate 'USE' of the primitive ---\n    # Calculate the cell directly in front of the agent based on its current direction\n    item_x_in_front, item_y_in_front = curr_x, curr_y\n    if curr_dir == NORTH_DIR:\n        item_y_in_front -= 1\n    elif curr_dir == EAST_DIR:\n        item_x_in_front += 1\n    elif curr_dir == SOUTH_DIR:\n        item_y_in_front += 1\n    elif curr_dir == WEST_DIR:\n        item_x_in_front -= 1\n    \n    # If the cell in front is within bounds and contains the target primitive\n    if (0 <= item_x_in_front < grid_width and \n        0 <= item_y_in_front < grid_height and\n        (item_x_in_front, item_y_in_front) in primitive_locations):\n      # We have found a path to a state from which USE is possible.\n      return path + [USE_ACTION]\n\n    # --- Explore next states from the current state ---\n\n    # 1. Explore movement actions (change position and facing direction)\n    for action, ((dx, dy), resulting_dir) in move_action_effects.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = resulting_dir # Agent's direction changes to face the direction of movement\n\n      if is_passable(next_x, next_y):\n        next_state = (next_x, next_y, next_dir)\n        if next_state not in visited:\n          visited.add(next_state)\n          q.append((next_x, next_y, next_dir, path + [action]))\n\n    # 2. Explore turning actions (change facing direction only, position remains the same)\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      next_x, next_y = curr_x, curr_y # Position does not change for a pure turn\n      \n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4     # Turn clockwise\n      \n      next_state = (next_x, next_y, next_dir)\n      if next_state not in visited:\n        visited.add(next_state)\n        q.append((next_x, next_y, next_dir, path + [turn_action]))\n  \n  # If the queue becomes empty and no path was found to any primitive\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T20:36:44.445919", "function_name": "collect", "function_body": "  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2 # Turn left\n  RIGHT_ACTION = 3 # Turn right\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Define movement vectors based on direction\n  DIR_VECTORS = {\n      NORTH_DIR: (0, -1), # (dx, dy)\n      EAST_DIR: (1, 0),\n      SOUTH_DIR: (0, 1),\n      WEST_DIR: (-1, 0),\n  }\n  # For moving backward (DOWN_ACTION) relative to current direction\n  OPPOSITE_DIR_VECTORS = {\n      NORTH_DIR: (0, 1),\n      EAST_DIR: (-1, 0),\n      SOUTH_DIR: (0, -1),\n      WEST_DIR: (1, 0),\n  }\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 0 and dy == 0:\n      return None\n\n    # Prioritize horizontal movement for facing direction if magnitude is greater or equal\n    # Otherwise, vertical movement\n    if abs(dx) >= abs(dy):\n      return EAST_DIR if dx > 0 else WEST_DIR\n    else: # abs(dy) > abs(dx)\n      return SOUTH_DIR if dy > 0 else NORTH_DIR\n\n  # Helper function: Returns actions to turn from current_dir to target_dir.\n  # Assumes LEFT_ACTION and RIGHT_ACTION are pure turning actions that change orientation.\n  def _get_turn_actions(current_dir, target_dir):\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    # Calculate clockwise and counter-clockwise turns needed\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    # Choose the shorter path\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION) # Turn right (clockwise)\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION) # Turn left (counter-clockwise)\n    return actions\n\n  # Get primitive's integer ID from the cookbook\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information from the environment\n  current_state = env._current_state\n  grid = current_state.grid\n  agent_start_x, agent_start_y = current_state.pos\n  agent_start_dir = current_state.dir # Agent's initial facing direction\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Define impassable indices for traversability checks.\n  # These are entities the agent cannot move onto.\n  impassable_indices = set()\n  impassable_indices.update(env.world.non_grabbable_indices)\n  impassable_indices.update(env.world.workshop_indices)\n  impassable_indices.add(primitive_id) # Agent cannot move onto the primitive it's collecting\n\n  # Helper function to check if a grid cell is traversable.\n  def is_traversable(x, y):\n    # Check bounds first\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell is occupied by any impassable item\n    # Iterate through all channels for the given cell (y, x)\n    # If any impassable item is present (value is 1), the cell is not traversable.\n    for idx in impassable_indices:\n        if grid[y, x, idx] == 1:\n            return False\n    return True # Cell is traversable\n\n  # Step 1: Find all actual locations of the primitive on the grid.\n  # np.where returns (row_indices, col_indices), which correspond to (y_coords, x_coords)\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n  primitive_locations = set()\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n  \n  if not primitive_locations:\n    return [] # Primitive not found on the grid, no actions possible\n\n  # Step 2: Identify all potential collection points.\n  # These are traversable cells from which the agent can be adjacent to *any* instance of the primitive.\n  potential_collection_points = set()\n  ADJACENCY_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Cardinals: West, East, North, South\n  \n  for px, py in primitive_locations:\n    for dx, dy in ADJACENCY_DELTAS:\n      adj_x, adj_y = px + dx, py + dy\n      if is_traversable(adj_x, adj_y): # Only add if the adjacent cell is traversable\n        potential_collection_points.add((adj_x, adj_y))\n  \n  if not potential_collection_points:\n      return [] # No valid traversable adjacent positions exist for any primitive instance\n\n  # Step 3: BFS Pathfinding to *any* of the potential_collection_points.\n  # The state in the queue now includes current position (x, y), current direction, and path actions.\n  # Queue stores: (current_x, current_y, current_dir, list_of_actions_to_reach_here)\n  queue = [(agent_start_x, agent_start_y, agent_start_dir, [])]\n  # Visited set stores: (x, y, dir) to avoid revisiting the same state (position + orientation)\n  visited = set([(agent_start_x, agent_start_y, agent_start_dir)])\n  \n  path_to_adj_pos = []\n  final_agent_dir_at_target = -1 # Stores the agent's direction upon reaching chosen_adj_pos\n  chosen_adj_pos = None # The specific adjacent position the agent will move to\n  target_item_pos_for_facing = None # The specific primitive instance to face\n\n  while queue:\n    curr_x, curr_y, curr_dir, current_path = queue.pop(0)\n\n    # If the current position is one of the target collection points, we've found a path.\n    if (curr_x, curr_y) in potential_collection_points:\n      path_to_adj_pos = current_path\n      final_agent_dir_at_target = curr_dir\n      chosen_adj_pos = (curr_x, curr_y)\n      \n      # Now, identify *which* primitive instance this chosen_adj_pos is adjacent to.\n      # Any adjacent primitive instance will do for determining the final facing direction.\n      for dx, dy in ADJACENCY_DELTAS:\n          item_x, item_y = curr_x + dx, curr_y + dy\n          if 0 <= item_x < grid_width and 0 <= item_y < grid_height and\\\n             grid[item_y, item_x, primitive_id] == 1:\n              target_item_pos_for_facing = (item_x, item_y)\n              break # Found an adjacent primitive instance\n      break # Path found to a valid collection point, exit BFS\n\n    # Explore possible actions from the current state: Movement and Turning\n\n    # 1. Try moving forward (UP_ACTION)\n    move_dx, move_dy = DIR_VECTORS[curr_dir]\n    next_x, next_y = curr_x + move_dx, curr_y + move_dy\n    next_dir = curr_dir # Direction does not change when moving forward/backward\n    \n    if is_traversable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n      visited.add((next_x, next_y, next_dir))\n      queue.append((next_x, next_y, next_dir, current_path + [UP_ACTION]))\n\n    # 2. Try moving backward (DOWN_ACTION)\n    move_dx_back, move_dy_back = OPPOSITE_DIR_VECTORS[curr_dir]\n    next_x_back, next_y_back = curr_x + move_dx_back, curr_y + move_dy_back\n    next_dir_back = curr_dir # Direction does not change when moving forward/backward\n    \n    if is_traversable(next_x_back, next_y_back) and (next_x_back, next_y_back, next_dir_back) not in visited:\n      visited.add((next_x_back, next_y_back, next_dir_back))\n      queue.append((next_x_back, next_y_back, next_dir_back, current_path + [DOWN_ACTION]))\n\n    # 3. Try turning left (LEFT_ACTION)\n    next_dir_left = (curr_dir - 1 + 4) % 4 # Counter-clockwise turn\n    if (curr_x, curr_y, next_dir_left) not in visited: # Position does not change, only direction\n      visited.add((curr_x, curr_y, next_dir_left))\n      queue.append((curr_x, curr_y, next_dir_left, current_path + [LEFT_ACTION]))\n\n    # 4. Try turning right (RIGHT_ACTION)\n    next_dir_right = (curr_dir + 1) % 4 # Clockwise turn\n    if (curr_x, curr_y, next_dir_right) not in visited: # Position does not change, only direction\n      visited.add((curr_x, curr_y, next_dir_right))\n      queue.append((curr_x, curr_y, next_dir_right, current_path + [RIGHT_ACTION]))\n\n  # If no path was found to any collection point after exhausting the queue\n  if chosen_adj_pos is None:\n    return []\n\n  final_actions = list(path_to_adj_pos)\n\n  # After moving to the chosen_adj_pos, the agent must turn to face the primitive.\n  # Calculate the required facing direction from the chosen adjacent position to the target item.\n  if target_item_pos_for_facing is not None:\n    target_face_dir = _get_target_facing_direction(chosen_adj_pos[0], chosen_adj_pos[1], \n                                                   target_item_pos_for_facing[0], target_item_pos_for_facing[1])\n    if target_face_dir is not None:\n      # Add turning actions from the agent's direction upon arriving at the chosen_adj_pos\n      final_actions.extend(_get_turn_actions(final_agent_dir_at_target, target_face_dir))\n  \n  # Finally, perform the USE action to collect the primitive\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T20:36:45.430164", "function_name": "collect", "function_body": "  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 0 and dy == 0:\n      return None # Agent is on top of the item, or item is at agent's exact spot - should not happen for collection\n\n    # Determine primary axis movement (horizontal or vertical) for facing\n    # Prioritize horizontal if dx magnitude is greater or equal, otherwise vertical\n    if abs(dx) >= abs(dy):\n      return EAST_DIR if dx > 0 else WEST_DIR\n    else: # abs(dy) > abs(dx)\n      return SOUTH_DIR if dy > 0 else NORTH_DIR\n\n  # Helper function: Returns actions to turn from current_dir to target_dir.\n  def _get_turn_actions(current_dir, target_dir):\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION) # Turn right\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION) # Turn left\n    return actions\n\n  primitive_id = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n  agent_grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir # Agent's initial facing direction\n\n  grid_height, grid_width, _ = agent_grid.shape\n\n  # Define a unified set of indices for entities that cannot be traversed by the agent.\n  # This includes non-grabbable items, workshop locations, and the primitive itself\n  # (as the agent cannot move *onto* the item it intends to collect).\n  impassable_indices = set()\n  impassable_indices.update(env.world.non_grabbable_indices)\n  impassable_indices.update(env.world.workshop_indices)\n  impassable_indices.add(primitive_id) \n\n  # Helper function to check if a grid cell is traversable.\n  def is_traversable(x, y):\n    # Check bounds first\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False \n    \n    # Check if the cell is occupied by any impassable item\n    # A cell is traversable only if *no* impassable item is present.\n    for idx in impassable_indices:\n        if agent_grid[y, x, idx] == 1:\n            return False \n    return True # Cell is traversable\n\n  # Find all actual locations of the primitive on the grid.\n  y_coords, x_coords = np.where(agent_grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Step 1: Identify all potential collection points.\n  # These are traversable cells from which the agent can be adjacent to *any* instance of the primitive.\n  primitive_locations = set()\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n  \n  potential_collection_points = set()\n  # Define deltas for checking cardinal adjacency (N, S, E, W)\n  ADJACENCY_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n\n  for px, py in primitive_locations:\n    for dx, dy in ADJACENCY_DELTAS:\n      adj_x, adj_y = px + dx, py + dy\n      if is_traversable(adj_x, adj_y): # Use the refined traversability check\n        potential_collection_points.add((adj_x, adj_y))\n  \n  if not potential_collection_points:\n      return [] # No valid collection points exist (e.g., item might be completely surrounded by obstacles)\n\n  # Step 2: BFS Pathfinding to *any* of the potential_collection_points.\n  # The BFS aims to find the shortest sequence of movement actions.\n  queue = [(agent_pos_x, agent_pos_y, [])] # (x, y, path_actions)\n  visited = set([(agent_pos_x, agent_pos_y)])\n  \n  path_to_adj_pos = []\n  chosen_adj_pos = None # The specific adjacent position the agent will move to\n  target_item_pos_for_facing = None # The specific primitive instance to face (for the USE action)\n\n  # Define movement deltas for BFS. These actions move the agent cardinally but\n  # do NOT change the agent's facing direction.\n  ACTION_MOVES = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0),\n  }\n\n  while queue:\n    curr_x, curr_y, current_path = queue.pop(0)\n\n    # If the current position is one of the target collection points, we've found a path.\n    if (curr_x, curr_y) in potential_collection_points:\n      path_to_adj_pos = current_path\n      chosen_adj_pos = (curr_x, curr_y)\n      \n      # Now, identify *which* primitive instance this chosen_adj_pos is adjacent to.\n      # Any adjacent primitive instance will do for determining facing direction.\n      for dx, dy in ADJACENCY_DELTAS:\n          item_x, item_y = curr_x + dx, curr_y + dy\n          if 0 <= item_x < grid_width and 0 <= item_y < grid_height and\\\n             agent_grid[item_y, item_x, primitive_id] == 1:\n              target_item_pos_for_facing = (item_x, item_y)\n              break # Found an adjacent primitive instance\n      break # Path found to a valid collection point, exit BFS\n\n    # Explore possible moves from the current position\n    for action, (dx, dy) in ACTION_MOVES.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # If the next cell is traversable and hasn't been visited yet, add it to the queue.\n      if is_traversable(next_x, next_y) and (next_x, next_y) not in visited:\n        visited.add((next_x, next_y))\n        queue.append((next_x, next_y, current_path + [action]))\n\n  # If no path was found to any collection point after exhausting the queue\n  if chosen_adj_pos is None:\n    return []\n\n  final_actions = list(path_to_adj_pos)\n\n  # After moving to the chosen_adj_pos, the agent's facing direction is still `agent_dir`\n  # (its initial direction, as movement actions don't change facing).\n  # We need to add turning actions to face the primitive from the new position.\n  # The turning actions are applied relative to the agent's direction *before* any turns.\n  # So, if the agent moved, its *effective* direction is still the initial `agent_dir`.\n  if target_item_pos_for_facing is not None:\n    target_face_dir = _get_target_facing_direction(chosen_adj_pos[0], chosen_adj_pos[1], \n                                                   target_item_pos_for_facing[0], target_item_pos_for_facing[1])\n    if target_face_dir is not None:\n      # Turn from the agent's initial direction to the required target direction\n      final_actions.extend(_get_turn_actions(agent_dir, target_face_dir))\n  \n  # Finally, perform the USE action to collect the primitive\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T20:37:42.438315", "function_name": "collect", "function_body": "  import collections # This import is available because collect_v0 already uses it.\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Mapping from movement action to the direction the agent would face after taking it\n  ACTION_TO_DIRECTION = {\n      UP_ACTION: NORTH_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  # Mapping from movement action to (dx, dy) delta\n  ACTION_TO_MOVE_DELTA = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  # Mapping from agent's direction to the (dx, dy) delta of the cell directly in front\n  DIRECTION_TO_FRONT_DELTA = {\n      NORTH_DIR: (0, -1),\n      EAST_DIR: (1, 0),\n      SOUTH_DIR: (0, 1),\n      WEST_DIR: (-1, 0)\n  }\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Check if the primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Retrieve global obstacle definitions from the world.\n  # These are entities the agent cannot walk *onto*.\n  non_walkable_indices = set(env.world.non_grabbable_indices)\n  non_walkable_indices.update(env.world.workshop_indices) # Workshops are also not traversable\n\n  def is_traversable(x, y, current_grid, target_primitive_id):\n    \"\"\"Checks if a given grid cell is within bounds and is traversable.\n    A cell is not traversable if it contains:\n    1. The target primitive itself (agent cannot walk onto the item it wants to collect).\n    2. Any other non-walkable item (e.g., water, stone, workshop).\n    \"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check if the cell contains the target primitive itself.\n    # An agent cannot move onto a grabbable primitive to collect it.\n    if current_grid[y, x, target_primitive_id] > 0:\n      return False\n    \n    # Check for other generally non-walkable items.\n    for kind_idx in non_walkable_indices:\n      if current_grid[y, x, kind_idx] > 0:\n        return False\n        \n    return True\n\n  # Initialize BFS queue: (current_x, current_y, current_direction, path_actions_list)\n  queue = collections.deque([(start_pos_x, start_pos_y, start_dir, [])])\n  # Initialize visited set to avoid cycles and redundant paths: (x, y, direction)\n  visited = {(start_pos_x, start_pos_y, start_dir)}\n\n  # Run BFS\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # --- Goal Check: Can we use the primitive from the current state? ---\n    # Determine the cell directly in front of the agent\n    front_dx, front_dy = DIRECTION_TO_FRONT_DELTA[curr_dir]\n    front_x, front_y = curr_x + front_dx, curr_y + front_dy\n\n    # Check if the cell in front is within bounds and contains the primitive.\n    # This is the condition for being able to perform a USE action.\n    if (0 <= front_x < grid_width and 0 <= front_y < grid_height and\n        grid[front_y, front_x, primitive_id] > 0):\n      return path_actions + [USE_ACTION] # Goal reached: return path plus USE action\n\n    # --- Expand possible next states ---\n\n    # A. Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for move_action, (dx, dy) in ACTION_TO_MOVE_DELTA.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      # After a movement action, the agent's direction automatically aligns with the movement.\n      next_dir_after_move = ACTION_TO_DIRECTION[move_action]\n\n      if is_traversable(next_x, next_y, grid, primitive_id) and\\\n         (next_x, next_y, next_dir_after_move) not in visited:\n        visited.add((next_x, next_y, next_dir_after_move))\n        queue.append((next_x, next_y, next_dir_after_move, path_actions + [move_action]))\n\n    # B. Turning Actions (LEFT, RIGHT)\n    # These actions change direction but not position.\n    # We use LEFT_ACTION and RIGHT_ACTION constants for clarity,\n    # even though they are also associated with movement.\n\n    # Turn Left (counter-clockwise)\n    next_dir_left = (curr_dir - 1 + 4) % 4\n    if (curr_x, curr_y, next_dir_left) not in visited:\n        visited.add((curr_x, curr_y, next_dir_left))\n        queue.append((curr_x, curr_y, next_dir_left, path_actions + [LEFT_ACTION]))\n\n    # Turn Right (clockwise)\n    next_dir_right = (curr_dir + 1) % 4\n    if (curr_x, curr_y, next_dir_right) not in visited:\n        visited.add((curr_x, curr_y, next_dir_right))\n        queue.append((curr_x, curr_y, next_dir_right, path_actions + [RIGHT_ACTION]))\n\n  # If the queue becomes empty and no path to a primitive was found\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T20:37:43.387909", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0 # Agent facing UP (negative Y)\n  EAST_DIR = 1  # Agent facing RIGHT (positive X)\n  SOUTH_DIR = 2 # Agent facing DOWN (positive Y)\n  WEST_DIR = 3  # Agent facing LEFT (negative X)\n\n  # Mapping from movement action to the direction the agent would face after taking it\n  ACTION_TO_DIRECTION = {\n      UP_ACTION: NORTH_DIR,\n      DOWN_ACTION: SOUTH_DIR,\n      LEFT_ACTION: WEST_DIR,\n      RIGHT_ACTION: EAST_DIR\n  }\n\n  # Mapping from movement action to (dx, dy) delta\n  ACTION_TO_MOVE_DELTA = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n\n  # Mapping from agent's direction to the (dx, dy) delta of the cell directly in front\n  DIRECTION_TO_FRONT_DELTA = {\n      NORTH_DIR: (0, -1),\n      EAST_DIR: (1, 0),\n      SOUTH_DIR: (0, 1),\n      WEST_DIR: (-1, 0)\n  }\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Check if the primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Retrieve global obstacle definitions from the world.\n  # These are entities the agent cannot walk *onto*.\n  non_walkable_indices = set(env.world.non_grabbable_indices)\n  non_walkable_indices.update(env.world.workshop_indices) # Workshops are also not traversable\n\n  def is_traversable_for_move(target_x, target_y, current_grid, target_primitive_id, non_walkable_indices_set):\n    \"\"\"Checks if a given grid cell can be *moved into*.\n    A cell is not traversable if it's out of bounds, contains the target primitive,\n    or contains any other specified non-walkable item.\n    \"\"\"\n    if not (0 <= target_x < grid_width and 0 <= target_y < grid_height):\n      return False\n    \n    # Agent cannot walk *onto* the primitive it intends to collect.\n    if current_grid[target_y, target_x, target_primitive_id] > 0:\n      return False\n    \n    # Check for other generally non-walkable items (e.g., water, stone, workshop).\n    for kind_idx in non_walkable_indices_set:\n      if current_grid[target_y, target_x, kind_idx] > 0:\n        return False\n        \n    return True\n\n  # Initialize BFS queue: (current_x, current_y, current_direction, path_actions_list)\n  queue = collections.deque([(start_pos_x, start_pos_y, start_dir, [])])\n  # Initialize visited set to avoid cycles and redundant paths: (x, y, direction)\n  visited = {(start_pos_x, start_pos_y, start_dir)}\n\n  # Run BFS\n  while queue:\n    curr_x, curr_y, curr_dir, path_actions = queue.popleft()\n\n    # --- Goal Check: Can we use the primitive from the current state? ---\n    # Determine the cell directly in front of the agent\n    front_dx, front_dy = DIRECTION_TO_FRONT_DELTA[curr_dir]\n    front_x, front_y = curr_x + front_dx, curr_y + front_dy\n\n    # Check if the cell in front is within bounds and contains the primitive.\n    # This is the condition for being able to perform a USE action.\n    if (0 <= front_x < grid_width and 0 <= front_y < grid_height and\n        grid[front_y, front_x, primitive_id] > 0):\n      return path_actions + [USE_ACTION] # Goal reached: return path plus USE action\n\n    # --- Expand possible next states by applying movement actions ---\n    # All movement actions (UP, DOWN, LEFT, RIGHT) attempt to move AND change direction.\n    # If the target cell is blocked, the agent stays in place but still changes direction.\n    for action, (dx, dy) in ACTION_TO_MOVE_DELTA.items():\n      attempted_next_x, attempted_next_y = curr_x + dx, curr_y + dy\n      next_dir = ACTION_TO_DIRECTION[action] # Direction always changes to align with the attempted move\n\n      final_x, final_y = curr_x, curr_y # Default: agent stays put if move is blocked\n      \n      # Check if the attempted move is traversable\n      if is_traversable_for_move(attempted_next_x, attempted_next_y, grid, primitive_id, non_walkable_indices):\n        final_x, final_y = attempted_next_x, attempted_next_y # Agent moves to new position\n\n      # Check if this new state (position, direction) has already been visited\n      if (final_x, final_y, next_dir) not in visited:\n        visited.add((final_x, final_y, next_dir))\n        queue.append((final_x, final_y, next_dir, path_actions + [action]))\n\n  # If the queue becomes empty and no path to a primitive was found\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T20:39:48.879025", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:39:49.914179", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  current_state = env._current_state\n  primitive_idx = primitive\n\n  # 1. Check if the primitive is already collected\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # Define direction vectors for agent facing (dx, dy)\n  # dir 0: North/Up (-1, 0)\n  # dir 1: East/Right (0, 1)\n  # dir 2: South/Down (1, 0)\n  # dir 3: West/Left (0, -1)\n  DR = [-1, 0, 1, 0]\n  DC = [0, 1, 0, -1]\n\n  # Queue for BFS: (CraftState object, list of actions to reach this state)\n  q = collections.deque()\n  # Set to store visited states to prevent cycles and redundant exploration.\n  # A state is defined by (agent_pos_tuple, agent_dir_int, inventory_tuple).\n  # Inventory is included because collecting other items might unlock new paths\n  # or change interaction behavior, though for simple collection it's mostly for correctness.\n  visited = set()\n\n  # Initialize BFS with the current environment state\n  initial_state_tuple = (current_state.pos, current_state.dir, tuple(current_state.inventory))\n  q.append((current_state, []))\n  visited.add(initial_state_tuple)\n\n  # Set a maximum search depth to prevent infinite loops in complex scenarios or\n  # for unachievable goals, and to limit computation.\n  max_search_depth = 100 # This value can be tuned based on expected grid sizes.\n\n  # BFS loop\n  while q:\n    state_node, path_to_node = q.popleft()\n\n    # If the current path exceeds the maximum allowed search depth, prune this branch.\n    if len(path_to_node) >= max_search_depth:\n      continue\n\n    # Get current agent position and direction\n    agent_r, agent_c = state_node.pos\n    agent_dir = state_node.dir\n\n    # Calculate the coordinates of the cell directly in front of the agent\n    target_r, target_c = agent_r + DR[agent_dir], agent_c + DC[agent_dir]\n\n    # Get grid dimensions for boundary checks\n    grid_h, grid_w, _ = state_node.grid.shape\n\n    # Check if the cell in front is within grid boundaries\n    if 0 <= target_r < grid_h and 0 <= target_c < grid_w:\n      # Check if the primitive is in the cell directly in front of the agent\n      if state_node.grid[target_r, target_c, primitive_idx] > 0:\n        # If the primitive is in front, try to use it.\n        # Simulate the 'USE' action and check if the primitive was collected.\n        # CraftState.step returns (reward, new_state)\n        _, state_after_use = state_node.step(ACTION_USE)\n\n        # If the inventory count of the primitive increased, it means it was successfully collected.\n        if state_after_use.inventory[primitive_idx] > state_node.inventory[primitive_idx]:\n          return path_to_node + [ACTION_USE]\n\n    # Explore next possible states by moving (UP, RIGHT, DOWN, LEFT)\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Simulate the chosen movement action to get the resulting state.\n      # CraftState.step implicitly updates position, direction (if movement sets it), and inventory.\n      _, next_state = state_node.step(action)\n\n      # Create a hashable representation of the next state for the 'visited' set.\n      next_state_tuple = (next_state.pos, next_state.dir, tuple(next_state.inventory))\n\n      # If this state has not been visited before, add it to the queue and mark as visited.\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple)\n        q.append((next_state, path_to_node + [action]))\n\n  # If the BFS completes and no path to collect the primitive is found within the search limits,\n  # return an empty list indicating the primitive cannot be collected.\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:41:57.513603", "function_name": "collect", "function_body": "    import collections\n\n    # Action constants\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Direction constants (matching CraftState internal dir)\n    # 0: Down (+Y)\n    # 1: Up (-Y)\n    # 2: Left (-X)\n    # 3: Right (+X)\n\n    def _bfs_path_to_exact_target(grid, start_pos, target_pos, block_movement_kinds):\n        \"\"\"\n        Finds a path from start_pos to target_pos.\n        Returns the path (list of (x,y) tuples, including start_pos and target_pos)\n        or None if no path found.\n        \"\"\"\n        width, height, _ = grid.shape\n        start_pos_tuple = tuple(start_pos)\n        target_pos_tuple = tuple(target_pos)\n\n        queue = collections.deque([(start_pos_tuple, [start_pos_tuple])])\n        visited = {start_pos_tuple}\n\n        # dx, dy for cardinal directions (Down, Up, Left, Right)\n        dxys = [(0, 1), (0, -1), (-1, 0), (1, 0)] \n\n        while queue:\n            curr_coord, path = queue.popleft()\n\n            if curr_coord == target_pos_tuple:\n                return path # Path found to the exact target\n\n            for dx, dy in dxys:\n                next_x, next_y = curr_coord[0] + dx, curr_coord[1] + dy\n                next_coord = (next_x, next_y)\n\n                # Check bounds\n                if not (0 <= next_x < width and 0 <= next_y < height):\n                    continue\n\n                if next_coord not in visited:\n                    # Check walkability of next_coord\n                    is_walkable = True\n                    # A cell is considered blocked if it contains any item from block_movement_kinds,\n                    # UNLESS that cell *is* the target_pos_tuple (e.g., collecting water by walking into it).\n                    if next_coord != target_pos_tuple: # Only check blocking if not the target cell itself\n                        for k_idx in block_movement_kinds:\n                            if grid[next_x, next_y, k_idx] == 1:\n                                is_walkable = False\n                                break\n                    \n                    if is_walkable:\n                        visited.add(next_coord)\n                        queue.append((next_coord, path + [next_coord]))\n        return None\n\n    def _path_to_actions(path, current_dir_val):\n        \"\"\"\n        Converts a path of (x,y) coordinates into a list of movement actions.\n        Also returns the final direction after movements.\n        current_dir_val: int (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT) of agent's current direction.\n        \"\"\"\n        actions = []\n        if not path or len(path) < 2:\n            return actions, current_dir_val\n\n        for i in range(len(path) - 1):\n            curr_x, curr_y = path[i]\n            next_x, next_y = path[i+1]\n\n            if next_x > curr_x:\n                actions.append(RIGHT)\n                current_dir_val = 3 # Right\n            elif next_x < curr_x:\n                actions.append(LEFT)\n                current_dir_val = 2 # Left\n            elif next_y > curr_y:\n                actions.append(DOWN)\n                current_dir_val = 0 # Down\n            elif next_y < curr_y:\n                actions.append(UP)\n                current_dir_val = 1 # Up\n        return actions, current_dir_val\n\n    def _face_target_and_use(agent_pos, agent_dir, target_item_pos):\n        \"\"\"\n        Generates actions to turn the agent to face the target item and then USE.\n        agent_pos: (x, y) tuple of agent's current position.\n        agent_dir: int (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT) of agent's current direction.\n        target_item_pos: (x, y) tuple of the item's position (not agent's target stand pos).\n        \"\"\"\n        actions = []\n        ax, ay = agent_pos\n        tx, ty = target_item_pos\n\n        # Determine target direction based on relative position\n        target_dir = -1\n        if tx > ax: # Target is to the right\n            target_dir = RIGHT\n        elif tx < ax: # Target is to the left\n            target_dir = LEFT\n        elif ty > ay: # Target is below\n            target_dir = DOWN\n        elif ty < ay: # Target is above\n            target_dir = UP\n\n        # If agent is already on the target (e.g., collecting water), just USE\n        if target_dir == -1 or agent_pos == target_item_pos:\n            actions.append(USE)\n            return actions\n\n        # Turn until facing the target\n        while agent_dir != target_dir:\n            # Calculate clockwise and counter-clockwise distances\n            cw_dist = (target_dir - agent_dir + 4) % 4\n            ccw_dist = (agent_dir - target_dir + 4) % 4\n\n            if cw_dist <= ccw_dist: # Prefer clockwise or equal\n                actions.append(RIGHT)\n                agent_dir = (agent_dir + 1) % 4\n            else:\n                actions.append(LEFT)\n                agent_dir = (agent_dir - 1 + 4) % 4\n        \n        actions.append(USE)\n        return actions\n\n\n    # Main logic for collect_v2\n    actions = []\n\n    # Get current state information\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    current_pos = tuple(obs['features_dict']['pos']) # (x, y)\n    current_dir = obs['features_dict']['direction'].argmax() # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n    inventory = obs['features_dict']['inventory']\n\n    # Check if primitive is already in inventory\n    if inventory[primitive] > 0:\n        return []\n\n    cookbook = env.world.cookbook\n    index = cookbook.index\n\n    # Identify blocking movement kinds (e.g., water, lava).\n    # These are elements the agent generally cannot walk *through* or *onto*,\n    # unless the target itself is one of these (e.g., collecting water).\n    block_movement_kinds = set()\n    try:\n        water_idx = index.index('water')\n        block_movement_kinds.add(water_idx)\n    except ValueError:\n        pass # 'water' might not exist in this specific world\n    try:\n        lava_idx = index.index('lava')\n        block_movement_kinds.add(lava_idx)\n    except ValueError:\n        pass # 'lava' might not exist\n\n    # Determine if the primitive itself is a \"liquid\" that can be walked onto\n    is_liquid_primitive = primitive in block_movement_kinds\n\n    # Find all locations of the primitive on the grid\n    primitive_locations = []\n    width, height, _ = grid.shape\n    for x in range(width):\n        for y in range(height):\n            if grid[x, y, primitive] == 1:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        # Primitive not found anywhere on the map\n        return []\n\n    best_path = None\n    target_item_pos_for_path = None # The actual (x,y) of the item we will target with USE\n    best_path_len = float('inf')\n\n    # Iterate through all instances of the primitive on the map to find the shortest path\n    for item_pos in primitive_locations:\n        path_to_action_spot = None\n        action_spot = None\n\n        if is_liquid_primitive:\n            # For liquids, the agent walks directly onto the item's cell to collect it\n            action_spot = item_pos\n            path_to_action_spot = _bfs_path_to_exact_target(grid, current_pos, action_spot, block_movement_kinds)\n        else:\n            # For solids, the agent must move to an adjacent walkable cell to use the item\n            # Find all possible adjacent cells where the agent could stand\n            candidate_action_spots = []\n            for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n                sx, sy = item_pos[0] + dx, item_pos[1] + dy\n                if 0 <= sx < width and 0 <= sy < height:\n                    is_spot_walkable = True\n                    # Check if the candidate spot itself is a blocking kind\n                    for k_idx in block_movement_kinds:\n                        if grid[sx, sy, k_idx] == 1:\n                            is_spot_walkable = False\n                            break\n                    \n                    if is_spot_walkable:\n                        candidate_action_spots.append((sx, sy))\n            \n            # From these candidate spots, find the one with the shortest path\n            current_shortest_path_to_spot = None\n            current_shortest_path_to_spot_len = float('inf')\n\n            for spot in candidate_action_spots:\n                path = _bfs_path_to_exact_target(grid, current_pos, spot, block_movement_kinds)\n                if path:\n                    if len(path) < current_shortest_path_to_spot_len:\n                        current_shortest_path_to_spot_len = len(path)\n                        current_shortest_path_to_spot = path\n                        action_spot = spot # This is the best spot to stand on for this specific item_pos\n\n            path_to_action_spot = current_shortest_path_to_spot\n\n        if path_to_action_spot:\n            # If a valid path to an action spot for this item_pos is found,\n            # check if it's better than the overall best path found so far.\n            if len(path_to_action_spot) < best_path_len:\n                best_path_len = len(path_to_action_spot)\n                best_path = path_to_action_spot\n                target_item_pos_for_path = item_pos # This is the actual item we'll USE on\n\n    if not best_path:\n        # No path found to any primitive location that allows collection\n        return []\n\n    # Convert path of (x,y) coordinates into movement actions\n    move_actions, final_dir_after_move = _path_to_actions(best_path, current_dir)\n    actions.extend(move_actions)\n\n    # After moving, the agent's final position is the last coordinate in the path\n    final_agent_pos = best_path[-1]\n    \n    # Now, face the target item (target_item_pos_for_path) and perform the USE action\n    use_actions = _face_target_and_use(final_agent_pos, final_dir_after_move, target_item_pos_for_path)\n    actions.extend(use_actions)\n\n    return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:41:57.592873", "function_name": "collect", "function_body": "    actions_taken = []\n    max_steps = 200  # A reasonable limit to prevent infinite loops\n\n    # Get action mappings from the environment's action_specs\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    # Get initial inventory count of the primitive.\n    # We collect until this count increases.\n    initial_obs = env.observations()\n    initial_inventory_count = initial_obs['features_dict']['inventory'][primitive]\n\n    # Variables for stuck detection\n    # stuck_history stores True if agent's position didn't change in the last step, False otherwise.\n    stuck_history = []\n    stuck_threshold = 5  # Number of consecutive steps without position change to be considered stuck\n    last_agent_pos_tuple = None  # Stores (x, y) tuple of the agent's last known position\n\n    for step_count in range(max_steps):\n        current_obs = env.observations()\n        current_features_dict = current_obs['features_dict']\n        current_inventory = current_features_dict['inventory']\n\n        # 1. Check if the primitive is already collected (inventory count increased)\n        if current_inventory[primitive] > initial_inventory_count:\n            return actions_taken\n\n        # 2. Get current agent position and the global grid\n        current_pos_normalized = current_features_dict['pos']\n        global_grid = current_features_dict['features_global']\n        WIDTH, HEIGHT, _ = global_grid.shape\n\n        # Convert normalized position to integer grid coordinates\n        current_agent_x = int(current_pos_normalized[0] * WIDTH)\n        current_agent_y = int(current_pos_normalized[1] * HEIGHT)\n        current_agent_pos_tuple = (current_agent_x, current_agent_y)\n\n        # Update stuck history for current step\n        if last_agent_pos_tuple is not None:\n            stuck_history.append(current_agent_pos_tuple == last_agent_pos_tuple)\n            # Keep history size limited to stuck_threshold\n            if len(stuck_history) > stuck_threshold:\n                stuck_history.pop(0)\n        last_agent_pos_tuple = current_agent_pos_tuple\n\n        # Determine if the agent is stuck\n        is_stuck = False\n        if len(stuck_history) == stuck_threshold and all(stuck_history):\n            is_stuck = True\n\n        action_to_take = None\n\n        if is_stuck:\n            # If stuck, take a random movement action to try and escape\n            move_actions = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]\n            action_to_take = np.random.choice(move_actions)\n            # Clear history after a random move to allow the agent to unstuck\n            stuck_history.clear()\n        else:\n            # 3. Check if the agent is next to the primitive\n            # Access the internal CraftState object for `next_to` method\n            if env._current_state.next_to(primitive):\n                action_to_take = ACTION_USE\n            else:\n                # 4. Find the closest instance of the primitive on the grid\n                primitive_locations = np.argwhere(global_grid[:, :, primitive] > 0)\n\n                if len(primitive_locations) == 0:\n                    # Primitive not found on the grid, cannot collect\n                    return actions_taken\n\n                closest_primitive_pos = None\n                min_dist = float('inf')\n\n                for (px, py) in primitive_locations:\n                    # Calculate Manhattan distance\n                    dist = abs(px - current_agent_x) + abs(py - current_agent_y)\n                    if dist < min_dist:\n                        min_dist = dist\n                        closest_primitive_pos = (px, py)\n\n                if closest_primitive_pos is None:\n                    # Should not happen if primitive_locations was not empty\n                    return actions_taken\n\n                target_x, target_y = closest_primitive_pos\n\n                # 5. Determine the best movement action to get closer to the primitive\n                dx = target_x - current_agent_x\n                dy = target_y - current_agent_y\n\n                # Prioritize movement along the axis with the larger difference\n                if abs(dx) > abs(dy):\n                    action_to_take = ACTION_RIGHT if dx > 0 else ACTION_LEFT\n                elif abs(dy) > abs(dx):\n                    action_to_take = ACTION_DOWN if dy > 0 else ACTION_UP\n                elif dx != 0:  # If differences are equal or dy is zero, prefer horizontal\n                    action_to_take = ACTION_RIGHT if dx > 0 else ACTION_LEFT\n                elif dy != 0:  # If dx is zero, move vertically\n                    action_to_take = ACTION_DOWN if dy > 0 else ACTION_UP\n                else:\n                    # Agent is on the target cell, but `next_to` was False, which is\n                    # contradictory given `next_to` definition. This implies an uncollectable state.\n                    return actions_taken\n\n        # 6. Execute the chosen action\n        if action_to_take is not None:\n            _, _, _ = env.step(action_to_take)\n            actions_taken.append(action_to_take)\n        else:\n            # If no action was determined for some reason, exit\n            return actions_taken\n\n    # Return actions taken so far if max_steps reached without success\n    return actions_taken", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:44:00.633502", "function_name": "collect", "function_body": "  # Action constants (from CraftLab.action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Define movement deltas and their corresponding actions\n  # (dr, dc): action_id mapping row/col change to action\n  # Assuming (row, col) coordinates where row increases downwards.\n  MOVE_DELTAS = [\n      (1, 0),   # DOWN (row increases, col stays same)\n      (-1, 0),  # UP (row decreases, col stays same)\n      (0, -1),  # LEFT (row stays same, col decreases)\n      (0, 1)    # RIGHT (row stays same, col increases)\n  ]\n\n  # Map from delta to action_id for path reconstruction\n  DELTA_TO_ACTION = {\n      (1, 0): ACTION_DOWN,\n      (-1, 0): ACTION_UP,\n      (0, -1): ACTION_LEFT,\n      (0, 1): ACTION_RIGHT,\n  }\n\n  total_actions_taken = [] # Accumulates all actions taken to achieve the goal\n\n  while True:\n      # Get current state information from the environment.\n      # Accessing _current_state for direct access to CraftState attributes.\n      current_state = env._current_state\n      inventory = current_state.inventory\n\n      # 1. Check if the primitive is already collected.\n      if inventory[primitive] > 0:\n          break # Goal achieved, exit the loop.\n\n      current_pos = current_state.pos # Agent's current (row, col) position.\n      grid = current_state.grid       # Current grid occupancy (Height, Width, Kinds).\n      grid_height, grid_width, _ = grid.shape # Get grid dimensions from numpy array shape.\n\n      # 2. Check if the agent is next to the primitive and can use it.\n      # CraftState.next_to checks the 3x3 neighborhood including the agent's current cell.\n      if current_state.next_to(primitive):\n          # Agent is positioned correctly (at or adjacent) to attempt collection.\n          env.step(ACTION_USE)\n          total_actions_taken.append(ACTION_USE)\n          # Continue to the next iteration to re-check inventory after the USE action.\n          continue\n\n      # 3. If not next to it, find a path to a cell containing the primitive using Breadth-First Search (BFS).\n      # Using a list as a basic queue for BFS to avoid importing `collections.deque`.\n      q = [(current_pos, [])] # Queue: stores (position, list_of_actions_to_reach_this_position).\n      head = 0 # Pointer to the current element being processed in the list-based queue.\n      visited = {current_pos} # Set of visited positions to avoid cycles and redundant processing.\n      path_to_target_cell = None # Stores the shortest path to a cell that contains the primitive.\n\n      while head < len(q):\n          (r, c), path_so_far = q[head]\n          head += 1\n\n          # Check if the current cell (r, c) contains the primitive.\n          # This cell is a potential target for the agent to move to.\n          if grid[r, c, primitive] == 1.0:\n              path_to_target_cell = path_so_far\n              break # Found the shortest path to a cell containing the primitive.\n\n          # Explore valid neighbors (UP, DOWN, LEFT, RIGHT).\n          for dr, dc in MOVE_DELTAS:\n              nr, nc = r + dr, c + dc # Calculate new row and column for the neighbor.\n\n              # Check boundary conditions: ensure the neighbor is within the grid.\n              if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n                  continue # Out of bounds.\n\n              # Obstacle check: water and stone cells are generally obstacles.\n              # However, if the 'primitive' itself is water or stone, then those cells are considered targets, not obstacles.\n              is_water_cell = (current_state.world.water_index is not None and grid[nr, nc, current_state.world.water_index] == 1.0)\n              is_stone_cell = (current_state.world.stone_index is not None and grid[nr, nc, current_state.world.stone_index] == 1.0)\n\n              # If the new cell (nr, nc) is an obstacle (water/stone)\n              # AND it's not the specific primitive we are trying to collect, then skip it.\n              if (is_water_cell and primitive != current_state.world.water_index) or \\\n                 (is_stone_cell and primitive != current_state.world.stone_index):\n                  continue # Cannot move into this obstacle cell.\n\n              # If the neighbor has not been visited, add it to the queue.\n              if (nr, nc) not in visited:\n                  visited.add((nr, nc))\n                  action_to_reach_nr_nc = DELTA_TO_ACTION[(dr, dc)]\n                  q.append(((nr, nc), path_so_far + [action_to_reach_nr_nc]))\n\n      # 4. Take an action based on the pathfinding result.\n      if path_to_target_cell:\n          # If a path was found, take the first step towards the target cell.\n          next_action_to_take = path_to_target_cell[0]\n          env.step(next_action_to_take)\n          total_actions_taken.append(next_action_to_take)\n      else:\n          # No path found to the primitive on the current grid.\n          # This implies the primitive is unreachable or doesn't exist anymore.\n          # Since the goal is to \"collect\", if it can't be found, it can't be collected.\n          # Return the actions taken so far (which might be empty if nothing was found initially).\n          return total_actions_taken\n\n  return total_actions_taken", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:44:00.702786", "function_name": "collect", "function_body": "    actions_taken = []\n    \n    # Get action mappings dynamically from the environment\n    action_map = env.action_specs()\n    _UP = action_map['UP']\n    _DOWN = action_map['DOWN']\n    _LEFT = action_map['LEFT']\n    _RIGHT = action_map['RIGHT']\n    _USE = action_map['USE']\n\n    MAX_COLLECT_STEPS = 200 # A reasonable upper bound to prevent infinite loops\n\n    for step_count in range(MAX_COLLECT_STEPS):\n        # Access the internal CraftState for detailed information\n        current_state = env._current_state \n\n        # 1. Check if the primitive is already in inventory\n        # The 'satisfies' method checks if inventory[goal_arg] > 0\n        if current_state.satisfies(None, primitive): \n            return actions_taken\n\n        # 2. Check if the primitive is in the 3x3 neighborhood (including the agent's current position)\n        # If it is, attempt to use/collect it.\n        # Assuming the USE action will pick up an item if it's grabbable and nearby.\n        if current_state.next_to(primitive):\n            # Perform the USE action\n            env.step(_USE)\n            actions_taken.append(_USE)\n            \n            # After USE, immediately re-check if it was collected.\n            if env._current_state.satisfies(None, primitive):\n                return actions_taken\n            \n            # If not collected (e.g., USE failed or wasn't applicable for this item),\n            # continue to the next loop iteration to re-evaluate the state.\n            continue \n\n        # 3. Primitive is not in inventory and not adjacent (or on current cell).\n        # We need to move towards it.\n        grid = current_state.grid\n        current_pos = current_state.pos # tuple (row, col)\n\n        # Find all locations where the primitive exists on the grid\n        # np.argwhere returns an array of (row, col) coordinates for each instance\n        primitive_locations = np.argwhere(grid[:, :, primitive] > 0)\n\n        if len(primitive_locations) == 0:\n            # Primitive not found anywhere on the current grid.\n            # Cannot collect it. Return actions taken so far.\n            return actions_taken\n\n        # Convert current_pos to a NumPy array for vectorized distance calculation\n        current_pos_array = np.array(current_pos)\n\n        # Calculate Manhattan distances to all primitive locations\n        # np.sum(np.abs(A - B), axis=1) calculates the Manhattan distance for each target\n        distances = np.sum(np.abs(primitive_locations - current_pos_array), axis=1)\n        \n        # Find the index of the closest primitive location\n        closest_primitive_idx = np.argmin(distances)\n        target_pos = primitive_locations[closest_primitive_idx] # (target_row, target_col)\n\n        # Determine the direction to move: Calculate row and column differences\n        dr = target_pos[0] - current_pos[0]\n        dc = target_pos[1] - current_pos[1]\n\n        chosen_action = None\n\n        # Prioritize movement along the axis with the larger difference to greedy approach the target.\n        # If differences are equal, or only one axis needs movement, handle those cases.\n        if abs(dr) >= abs(dc):\n            if dr < 0:\n                chosen_action = _UP # Target is North (row decreases)\n            elif dr > 0:\n                chosen_action = _DOWN # Target is South (row increases)\n            # If dr is 0, it means we are already on the correct row. Try to move horizontally.\n            elif dc < 0:\n                chosen_action = _LEFT\n            elif dc > 0:\n                chosen_action = _RIGHT\n        else: # Prioritize horizontal movement if horizontal difference is larger\n            if dc < 0:\n                chosen_action = _LEFT # Target is West (column decreases)\n            elif dc > 0:\n                chosen_action = _RIGHT # Target is East (column increases)\n            # If dc is 0, it means we are already on the correct column. Try to move vertically.\n            elif dr < 0:\n                chosen_action = _UP\n            elif dr > 0:\n                chosen_action = _DOWN\n            \n        # Take the chosen movement action\n        if chosen_action is not None:\n            env.step(chosen_action)\n            actions_taken.append(chosen_action)\n        # Note: If chosen_action is None here, it implies current_pos == target_pos.\n        # This case should ideally be caught by the `current_state.next_to(primitive)` check above,\n        # leading to a `_USE` action. If not, the agent is likely stuck or the primitive is unreachable.\n\n    # If the loop completes without collecting the primitive (max steps reached)\n    return actions_taken", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:45:38.154325", "function_name": "collect", "function_body": "    import collections\n    # numpy is assumed to be imported at the top level (`import numpy as np`)\n    # and thus available globally.\n\n    # Helper function for BFS pathfinding - defined inside to fit the constraint.\n    # This design choice (inner function) is made to strictly adhere to the prompt's\n    # \"Return only the code that will be inside the function\" instruction,\n    # even though it's less efficient than a module-level helper.\n    def _bfs_path(grid, start_pos, target_kind_idx, action_map):\n        \"\"\"\n        Finds a path from start_pos to a cell adjacent to target_kind_idx.\n        Args:\n            grid (np.ndarray): The current grid state (WIDTH, HEIGHT, n_kinds).\n            start_pos (tuple): (x, y) agent's current position.\n            target_kind_idx (int): The index of the primitive to find.\n            action_map (dict): Dictionary mapping action names to integer values (e.g., {'UP': 1}).\n        Returns:\n            list[int] or None: List of actions to take, or None if no path found.\n        \"\"\"\n        # Grid dimensions\n        width, height, _ = grid.shape\n\n        # Movement actions and their deltas for (x, y) coordinate system\n        # Assuming grid[x, y, :] indexing for consistency with pos = (x, y)\n        DELTAS = {\n            action_map['UP']: (0, -1),\n            action_map['DOWN']: (0, 1),\n            action_map['LEFT']: (-1, 0),\n            action_map['RIGHT']: (1, 0)\n        }\n        MOVE_ACTIONS = list(DELTAS.keys())\n\n        start_x, start_y = start_pos\n        queue = collections.deque([(start_x, start_y, [])]) # (x, y, path_so_far_actions)\n        visited = {(start_x, start_y)}\n        \n        # Find all locations of the target primitive on the grid\n        primitive_locations = np.argwhere(grid[:, :, target_kind_idx] == 1)\n        if len(primitive_locations) == 0:\n            return None # Primitive not found on the grid\n\n        # Convert primitive locations to a set for faster lookup\n        primitive_loc_set = set(tuple(loc) for loc in primitive_locations)\n\n        while queue:\n            cx, cy, current_path = queue.popleft()\n\n            # Check if the current cell is adjacent to any primitive location\n            is_adjacent_to_primitive = False\n            for action_delta_name in MOVE_ACTIONS: # Iterate through movement actions\n                dx, dy = DELTAS[action_delta_name]\n                nx_adj, ny_adj = cx + dx, cy + dy\n                if (nx_adj, ny_adj) in primitive_loc_set:\n                    is_adjacent_to_primitive = True\n                    break\n            \n            if is_adjacent_to_primitive:\n                 return current_path # This path gets us adjacent to a primitive\n\n            # Explore neighbors\n            for action in MOVE_ACTIONS:\n                dx, dy = DELTAS[action]\n                nx, ny = cx + dx, cy + dy\n\n                # Check bounds\n                if not (0 <= nx < width and 0 <= ny < height):\n                    continue\n\n                # Check if already visited\n                if (nx, ny) in visited:\n                    continue\n                \n                # IMPORTANT: This BFS assumes all valid grid cells are traversable for movement.\n                # If specific entity kinds (e.g., walls, certain environment features) are non-traversable,\n                # additional checks `if grid[nx, ny, obstacle_kind_idx] == 1: continue` would be needed here.\n                # Based on the problem description, such explicit obstacles are not detailed for traversal.\n\n                visited.add((nx, ny))\n                queue.append((nx, ny, current_path + [action]))\n\n        return None # No path found to any cell adjacent to a primitive\n\n    actions_to_take = []\n    # Maximum number of steps allowed for collecting one primitive.\n    # This prevents infinite loops if the primitive becomes unreachable or due to agent getting stuck.\n    MAX_COLLECT_STEPS = 500 \n\n    # Retrieve the action mapping from the environment's action_specs.\n    action_map = env.action_specs()\n    ACTION_USE = action_map['USE']\n\n    for _ in range(MAX_COLLECT_STEPS):\n        current_state = env._current_state\n\n        # 1. Check if the primitive is already in the agent's inventory.\n        if current_state.inventory[primitive] > 0:\n            break # Goal achieved, stop.\n\n        # 2. Check if the agent is currently adjacent to the primitive.\n        # If so, perform the 'USE' action to try and collect it.\n        if current_state.next_to(primitive):\n            actions_to_take.append(ACTION_USE)\n            reward, done, observations = env.step(ACTION_USE)\n            \n            # After trying to USE, check inventory again to confirm collection.\n            if env._current_state.inventory[primitive] > 0:\n                break # Primitive collected, stop.\n            \n            # If `USE` didn't collect it (e.g., wrong item, or multiple uses needed, or non-grabbable),\n            # continue to the next iteration to re-evaluate the situation.\n            continue \n\n        # 3. If not adjacent to the primitive, find the shortest path to get adjacent.\n        current_pos = current_state.pos # Agent's current (x, y) position\n        grid = current_state.grid       # The current state of the grid\n\n        # Use BFS to find a sequence of movement actions.\n        path_segment = _bfs_path(grid, current_pos, primitive, action_map)\n\n        # If no path can be found (e.g., primitive is unreachable or no longer on grid),\n        # or the path is empty (should ideally not happen if `next_to` was false),\n        # then stop trying to collect it.\n        if path_segment is None or not path_segment:\n            break \n        \n        # Take the first action from the calculated path.\n        next_action = path_segment[0]\n        actions_to_take.append(next_action)\n        reward, done, observations = env.step(next_action)\n\n        # If the environment signals that the episode is done (e.g., time limit reached),\n        # then stop trying to collect.\n        if done:\n            break\n\n    return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:45:39.153664", "function_name": "collect", "function_body": "  import collections\n\n  # Action constants (assuming these are globally defined or accessible)\n  # If not, define them explicitly for clarity:\n  # DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  # ACTIONS = {\"DOWN\": DOWN, \"UP\": UP, \"LEFT\": LEFT, \"RIGHT\": RIGHT, \"USE\": USE}\n  # ACTION_VECTORS = {\n  #     DOWN: (0, 1),  # (dx, dy) for movement\n  #     UP: (0, -1),\n  #     LEFT: (-1, 0),\n  #     RIGHT: (1, 0)\n  # }\n  # Since the problem statement only provides a function to complete,\n  # I will assume `ACTIONS` and `ACTION_VECTORS` are somehow available\n  # in the context where `collect_v2` is called or they are imported globally.\n  # However, to make the code self-contained and runnable, I will define them here\n  # as per the spirit of a code completion model providing *all* necessary code for the function.\n  # (Upon reviewing the problem setup, the action mappings are described for CraftLab,\n  # so I will use integer literals directly.)\n  \n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTIONS = {\"DOWN\": DOWN, \"UP\": UP, \"LEFT\": LEFT, \"RIGHT\": RIGHT, \"USE\": USE}\n  ACTION_VECTORS = {\n      DOWN: (0, 1),  # (dx, dy)\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0)\n  }\n\n  # 1. Check if the primitive is already in the inventory\n  obs = env.observations()\n  inventory = obs['inventory']\n  if inventory[primitive] > 0:\n      return [] # Primitive already collected\n\n  current_pos_x, current_pos_y = obs['pos'].astype(int)\n  grid_data = obs['features_global'] # shape (WIDTH, HEIGHT, n_kinds)\n  width, height, n_kinds = grid_data.shape\n\n  # 2. Find the target primitive's location(s) on the grid\n  # np.argwhere returns (x_coord, y_coord) for a grid shaped (WIDTH, HEIGHT)\n  primitive_locations = np.argwhere(grid_data[:, :, primitive] > 0)\n  if len(primitive_locations) == 0:\n      return [] # Primitive not found on the grid\n\n  # 3. Find the closest primitive instance to the agent\n  min_dist = float('inf')\n  target_primitive_pos = None # (x, y) coordinates of the closest primitive\n  for loc_x, loc_y in primitive_locations:\n      dist = abs(loc_x - current_pos_x) + abs(loc_y - current_pos_y)\n      if dist < min_dist:\n          min_dist = dist\n          target_primitive_pos = (loc_x, loc_y)\n\n  if target_primitive_pos is None: # Should not happen if primitive_locations is not empty\n      return []\n\n  # 4. Determine obstacle indices\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n  workshop_indices = world.workshop_indices\n  # Treat all non-grabbable items and workshops as obstacles for movement\n  obstacle_indices = non_grabbable_indices.union(workshop_indices)\n\n  # 5. Define target squares for the agent\n  # The agent needs to reach a cell from which `CraftState.next_to(primitive)` would be true.\n  # This means the agent's position (ax, ay) must be within the 3x3 neighborhood of the\n  # target primitive's position (px, py).\n  target_agent_squares = set()\n  px, py = target_primitive_pos\n  for dx_area in [-1, 0, 1]:\n      for dy_area in [-1, 0, 1]:\n          ax, ay = px + dx_area, py + dy_area\n          # Ensure target agent square is within grid boundaries\n          if 0 <= ax < width and 0 <= ay < height:\n              target_agent_squares.add((ax, ay))\n  \n  # 6. Perform a Breadth-First Search (BFS) to find the shortest path\n  # Queue stores (current_position (x,y), list_of_actions_to_reach_here)\n  q = collections.deque([((current_pos_x, current_pos_y), [])])\n  visited = {(current_pos_x, current_pos_y)} # Set of visited (x,y) positions\n\n  # Max path length to prevent infinite loops in complex or impossible scenarios\n  # A reasonable heuristic is proportional to grid size\n  max_bfs_steps = width * height * 2 \n\n  while q:\n      (cx, cy), path = q.popleft()\n\n      # If path is too long, discard it to manage computation\n      if len(path) > max_bfs_steps:\n          continue\n\n      # Check if the current agent position is one of the target squares\n      if (cx, cy) in target_agent_squares:\n          return path + [ACTIONS[\"USE\"]] # Path to position, then USE action\n\n      # Explore valid neighbors (movements)\n      for action_val in [DOWN, UP, LEFT, RIGHT]: # Only consider movement actions\n          dx, dy = ACTION_VECTORS[action_val]\n          nx, ny = cx + dx, cy + dy\n\n          # Check if new position is within grid boundaries\n          if not (0 <= nx < width and 0 <= ny < height):\n              continue\n\n          # Check if new position has already been visited\n          if (nx, ny) in visited:\n              continue\n\n          # Check for obstacles at the new position (nx, ny)\n          is_obstacle = False\n          for idx in obstacle_indices:\n              if grid_data[nx, ny, idx] > 0: # Grid data is grid[x, y, kind]\n                  is_obstacle = True\n                  break\n          if is_obstacle:\n              continue\n\n          # Add valid and unvisited neighbor to queue\n          visited.add((nx, ny))\n          q.append(((nx, ny), path + [action_val]))\n\n  # 7. If no path is found (queue exhausted), return an empty list\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:46:58.814581", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent directions (matches CraftState.dir attribute, typically 0:Up, 1:Right, 2:Down, 3:Left)\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  # Mapping of a target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction to collect that target via ACTION_USE.\n  # For example, if target is at (y-1, x) relative to agent, agent must face DIR_UP.\n  RELATIVE_TARGET_TO_REQUIRED_DIR = {\n      (-1, 0): DIR_UP,     # Target is directly North (Up) of agent\n      (0, 1): DIR_RIGHT,   # Target is directly East (Right) of agent\n      (1, 0): DIR_DOWN,    # Target is directly South (Down) of agent\n      (0, -1): DIR_LEFT    # Target is directly West (Left) of agent\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 200 # A configurable limit to prevent excessively long paths\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state\n  # This ensures we start from a defined state, though it might reset any progress.\n  # For planning a path, this is usually desired.\n  _ = env.reset() \n  current_state = env._current_state # Access the underlying CraftState instance\n\n  # Initial checks for early exit\n  if primitive not in current_state.world.cookbook.kinds:\n      # The specified primitive ID is not a recognized kind in the world\n      return [] \n  if current_state.inventory[primitive] > 0:\n      # The primitive has already been collected and is in inventory\n      return []\n\n  # Get initial grid and agent's position/direction\n  full_grid = current_state.features_dict()['features_global']\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Current agent facing direction\n  grid_height, grid_width, _ = full_grid.shape \n\n  # --- Define impassable cells for agent movement ---\n  # These are entity kinds that the agent cannot walk ONTO.\n  impassable_for_movement = set()\n  \n  # Water is typically an absolute movement blocker.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  # Stone is often traversable, but sometimes represents walls.\n  # We assume it's impassable if it's non-grabbable and not a workshop (which are traversable).\n  if current_state.world.stone_index in current_state.world.kinds:\n      if (current_state.world.stone_index in current_state.world.non_grabbable_indices and\n          current_state.world.stone_index not in current_state.world.workshop_indices):\n          impassable_for_movement.add(current_state.world.stone_index)\n\n  # All other non-grabbable entities that are not workshops are considered impassable.\n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in current_state.world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n    \n  # --- Pre-compute all potential target (agent_y, agent_x, agent_dir) states ---\n  # These are the (agent_y, agent_x, agent_dir) states from which an agent\n  # can successfully perform ACTION_USE to collect the primitive located adjacently.\n  collectable_target_states = set()\n  \n  # Iterate over the entire grid to find all locations where the primitive exists\n  for py in range(grid_height):\n      for px in range(grid_width):\n          if full_grid[py, px, primitive] > 0: # If primitive is found at (py, px)\n              # For each primitive location, determine the 4 adjacent squares\n              # where the agent could stand, and the required direction to face.\n              for rel_dy, rel_dx in RELATIVE_TARGET_TO_REQUIRED_DIR.keys():\n                  # Calculate the potential agent position (agent_y, agent_x)\n                  # If the primitive is at (py, px) and its relative position from agent is (rel_dy, rel_dx),\n                  # then agent's absolute position (ay, ax) is (py - rel_dy, px - rel_dx).\n                  agent_y, agent_x = py - rel_dy, px - rel_dx\n                  required_agent_dir = RELATIVE_TARGET_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n                  # Check if this potential agent position is within grid bounds\n                  if 0 <= agent_y < grid_height and 0 <= agent_x < grid_width:\n                      # Crucially, ensure the cell where the agent needs to stand is traversable\n                      is_agent_square_traversable = True\n                      for k_idx in impassable_for_movement:\n                          if full_grid[agent_y, agent_x, k_idx] > 0:\n                              is_agent_square_traversable = False\n                              break\n                      \n                      if is_agent_square_traversable:\n                          # Add this valid agent state (position and required direction) to our set\n                          collectable_target_states.add((agent_y, agent_x, required_agent_dir))\n  \n  if not collectable_target_states:\n      # No instances of the primitive found on the grid, or no valid collection points accessible\n      return [] \n\n  # --- Breadth-First Search (BFS) to find the shortest path to any target state ---\n  q = collections.deque()\n  # BFS state tuple: (current_y, current_x, current_direction, list_of_actions_taken_to_reach_here)\n  q.append((start_pos[0], start_pos[1], start_dir, []))\n  \n  # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  # Define movement actions and their effects on position and agent direction\n  # (delta_y, delta_x, action_id, resulting_agent_direction_after_move)\n  moves_options = [\n      (-1, 0, ACTION_UP, DIR_UP),     # Move North, face North\n      (1, 0, ACTION_DOWN, DIR_DOWN),   # Move South, face South\n      (0, -1, ACTION_LEFT, DIR_LEFT),  # Move West, face West\n      (0, 1, ACTION_RIGHT, DIR_RIGHT)  # Move East, face East\n  ]\n\n  path_to_primitive_collection = None # Will store the sequence of actions if a path is found\n\n  while q:\n      curr_y, curr_x, curr_dir, path_actions = q.popleft()\n      \n      # Check if the current agent state (position and orientation) is one of our\n      # pre-computed collectable target states. If so, we found a path.\n      if (curr_y, curr_x, curr_dir) in collectable_target_states:\n          path_to_primitive_collection = path_actions\n          break # Found the shortest path to a valid collection point, exit BFS\n\n      # Explore neighboring cells reachable by movement actions\n      for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n          next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n          # Prune BFS branch if adding this move would exceed the maximum allowed steps.\n          # We add 1 for the current move being considered, and 1 for the final USE action.\n          if len(path_actions) + 2 > MAX_COLLECT_STEPS:\n              continue\n\n          # Check if the next cell is within grid bounds\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the next cell is traversable for movement (not an impassable entity)\n          is_traversable_for_movement_to_next_cell = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable_for_movement_to_next_cell = False\n                  break\n          if not is_traversable_for_movement_to_next_cell:\n              continue\n          \n          # Check if this new state (position + direction) has already been visited\n          if (next_y, next_x, new_dir_after_move) not in visited:\n              visited.add((next_y, next_x, new_dir_after_move))\n              q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n    \n  if path_to_primitive_collection is None:\n      # No path found to any collectable primitive target state within MAX_COLLECT_STEPS\n      return [] \n\n  # --- Execute the found path and perform the collection ---\n  \n  # Final check: Ensure the total number of actions (path movements + final USE)\n  # does not exceed MAX_COLLECT_STEPS. This is a safeguard, as BFS pruning should\n  # mostly handle it, but it catches edge cases where the path length equals MAX_COLLECT_STEPS\n  # and the final USE pushes it over, or if MAX_COLLECT_STEPS was very small.\n  if len(path_to_primitive_collection) + 1 > MAX_COLLECT_STEPS:\n      return [] \n\n  # Execute the movement actions determined by the BFS\n  for action in path_to_primitive_collection:\n      actions_taken.append(action)\n      # Perform the action in the environment\n      reward, done, _ = env.step(action) \n      current_state = env._current_state # Update our reference to the current CraftState\n\n      # Check for episode termination (from CraftLab's internal logic)\n      # If the episode ends prematurely and our primitive has not been collected, then the path failed.\n      if done and current_state.inventory[primitive] <= 0:\n          return []\n      \n      # If the primitive was somehow collected during movement (e.g., walking over it), stop early.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n  # After executing all movement actions, the agent should be at the correct position\n  # and facing the correct direction to collect the primitive. Now, perform the USE action.\n  actions_taken.append(ACTION_USE)\n  reward, done, _ = env.step(ACTION_USE)\n  current_state = env._current_state # Update state after the USE action\n\n  # Final confirmation: Check if the primitive was successfully collected into inventory\n  if current_state.inventory[primitive] > 0:\n      return actions_taken # Successfully collected the primitive!\n  else:\n      # Collection failed even after reaching the correct position/orientation and attempting USE.\n      # This could indicate the primitive requires a tool, is depleted, or other game mechanics not modeled here.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T20:46:59.794123", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      ACTION_UP: DIR_NORTH,\n      ACTION_DOWN: DIR_SOUTH,\n      ACTION_LEFT: DIR_WEST,\n      ACTION_RIGHT: DIR_EAST\n  }\n\n  # Mapping of a target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction to collect that target via ACTION_USE.\n  # For example, if target is (0, 1) (East), agent must face DIR_EAST.\n  RELATIVE_TARGET_TO_REQUIRED_DIR = {\n      (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n      (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n      (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n      (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  # This is a hardcoded limit to prevent extremely long searches or paths.\n  MAX_COLLECT_STEPS = 100 \n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state\n  # This ensures we start from a consistent known state for pathfinding.\n  current_obs = env.reset() \n  current_state = env._current_state # Access the underlying CraftState instance\n\n  # Initial checks\n  if primitive not in current_state.world.cookbook.kinds:\n      # The specified primitive ID is not a recognized entity kind in this world.\n      return [] \n  if current_state.inventory[primitive] > 0:\n      # The primitive has already been collected, no actions needed.\n      return []\n\n  full_grid = current_state.features_dict()['features_global']\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  grid_height, grid_width, _ = full_grid.shape # Get grid dimensions for validation\n\n  # --- Determine truly impassable kinds for agent movement ---\n  # Improvement over v1: Refine `impassable_kinds` to distinguish between\n  # non-grabbable but traversable (e.g., workshops) and truly blocking entities (e.g., water, walls).\n  impassable_for_movement = set()\n\n  # By default, all non-grabbable items are considered potentially impassable.\n  impassable_for_movement.update(current_state.world.non_grabbable_indices)\n\n  # However, workshops are typically traversable even if non-grabbable.\n  # Remove them from the impassable set if they were included.\n  for workshop_idx in current_state.world.workshop_indices:\n      if workshop_idx in impassable_for_movement:\n          impassable_for_movement.remove(workshop_idx)\n\n  # Explicitly add water (if it exists in this world configuration) as it's a common movement blocker.\n  if current_state.world.water_index is not None and current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n\n  # --- Pre-compute all potential target (agent_y, agent_x, agent_dir) states ---\n  # These are the (agent_y, agent_x, agent_dir) states from which an agent\n  # can successfully perform ACTION_USE to collect the primitive located adjacent to it.\n  collectable_target_states = set()\n  \n  # Iterate over the entire grid to find all instances of the primitive\n  for py in range(grid_height):\n      for px in range(grid_width):\n          if full_grid[py, px, primitive] > 0:\n              # For each primitive found at (py, px), determine the 4 possible\n              # adjacent agent positions and the required agent direction to collect it.\n              for rel_dy, rel_dx in RELATIVE_TARGET_TO_REQUIRED_DIR.keys():\n                  # Calculate potential agent position (agent_y, agent_x)\n                  # If primitive is at (py, px) and its relative pos to agent is (rel_dy, rel_dx),\n                  # then agent's absolute pos (ay, ax) is (py - rel_dy, px - rel_dx).\n                  agent_y, agent_x = py - rel_dy, px - rel_dx\n                  required_agent_dir = RELATIVE_TARGET_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n                  # Check if this potential agent position is within grid bounds\n                  if 0 <= agent_y < grid_height and 0 <= agent_x < grid_width:\n                      # IMPORTANT IMPROVEMENT: Ensure the potential agent position itself is traversable.\n                      # An agent cannot stand *inside* an impassable object (like a wall or water)\n                      # to collect an item next to it.\n                      is_agent_pos_traversable = True\n                      for k_idx in impassable_for_movement:\n                          if full_grid[agent_y, agent_x, k_idx] > 0:\n                              is_agent_pos_traversable = False\n                              break\n                      \n                      if is_agent_pos_traversable:\n                          collectable_target_states.add((agent_y, agent_x, required_agent_dir))\n  \n  if not collectable_target_states:\n      # No instances of the primitive found on the grid, or no valid collection points accessible.\n      return [] \n\n  # --- Breadth-First Search (BFS) to find the shortest path to any target state ---\n  q = collections.deque()\n  # BFS state: (current_y, current_x, current_dir, path_of_actions_so_far)\n  q.append((start_pos[0], start_pos[1], start_dir, []))\n  \n  # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n  moves_options = [\n      (-1, 0, ACTION_UP, DIR_NORTH),\n      (1, 0, ACTION_DOWN, DIR_SOUTH),\n      (0, -1, ACTION_LEFT, DIR_WEST),\n      (0, 1, ACTION_RIGHT, DIR_EAST)\n  ]\n\n  path_to_primitive_collection = None # Will store the sequence of movement actions\n\n  while q:\n      curr_y, curr_x, curr_dir, path_actions = q.popleft()\n      \n      # Check if current state (position and orientation) is one of our\n      # pre-computed collectable target states.\n      if (curr_y, curr_x, curr_dir) in collectable_target_states:\n          path_to_primitive_collection = path_actions\n          # Since BFS explores layer by layer, the first path found will be the shortest.\n          break \n\n      # Pruning: If adding one more step (a movement action) would exceed MAX_COLLECT_STEPS,\n      # then this path cannot lead to a valid collection within the limit (since collection\n      # itself takes one ACTION_USE step).\n      if len(path_actions) + 1 > MAX_COLLECT_STEPS:\n          continue \n\n      # Explore neighboring cells\n      for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n          next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n          # Check bounds for the next cell\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the next cell is traversable for movement using the refined `impassable_for_movement` set.\n          is_traversable_for_movement = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable_for_movement = False\n                  break\n          if not is_traversable_for_movement:\n              continue\n          \n          # Add to queue only if this new state (position and direction) hasn't been visited\n          if (next_y, next_x, new_dir_after_move) not in visited:\n              visited.add((next_y, next_x, new_dir_after_move))\n              q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n  \n  if path_to_primitive_collection is None:\n      return [] # No path found to any collectable primitive target state within MAX_COLLECT_STEPS\n\n  # --- Execute the found path and perform the collection ---\n  \n  # The BFS pruning `len(path_actions) + 1 > MAX_COLLECT_STEPS` already ensures this.\n  # This final check is mostly for clarity or if `MAX_COLLECT_STEPS` logic were to change.\n  if len(path_to_primitive_collection) + 1 > MAX_COLLECT_STEPS:\n      return [] \n\n  # Execute the movements found by BFS\n  for action in path_to_primitive_collection:\n      actions_taken.append(action)\n      reward, done, _ = env.step(action) # Take the step, update env's internal state\n      current_state = env._current_state # Update our reference to the current CraftState\n      \n      # If the episode ends prematurely (e.g., max_steps reached) before collection.\n      if done:\n          return [] \n\n  # After executing all movement actions, the agent should be at the correct position\n  # and facing the correct direction as determined by the BFS. Now, perform the USE action.\n  actions_taken.append(ACTION_USE)\n  reward, done, _ = env.step(ACTION_USE)\n  current_state = env._current_state # Update state after the USE action\n\n  # Final check: Confirm the primitive was successfully collected into inventory.\n  # If done became True on the last step (ACTION_USE) and primitive was not collected,\n  # it indicates failure.\n  if current_state.inventory[primitive] > 0 and not done:\n      return actions_taken # Successfully collected!\n  else:\n      # Collection failed, either primitive not in inventory or episode ended.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T20:48:38.503150", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:48:39.508535", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs() mapping:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Define a maximum number of steps for the BFS to find a path.\n  # This prevents excessively long search times and limits the total length\n  # of the generated action sequence, including the final ACTION_USE.\n  MAX_COLLECT_STEPS = 100 \n\n  def _get_facing_coords(y, x, direction):\n      \"\"\"\n      Calculates the grid coordinates of the cell directly in front of the agent.\n\n      Args:\n          y (int): Agent's current row coordinate.\n          x (int): Agent's current column coordinate.\n          direction (int): Agent's current facing direction (DIR_EAST, DIR_SOUTH, DIR_WEST, DIR_NORTH).\n\n      Returns:\n          tuple[int, int]: (row, column) coordinates of the cell in front.\n      \"\"\"\n      if direction == DIR_EAST:\n          return y, x + 1\n      elif direction == DIR_SOUTH:\n          return y + 1, x\n      elif direction == DIR_WEST:\n          return y, x - 1\n      elif direction == DIR_NORTH:\n          return y - 1, x\n      return y, x # Should not happen with valid directions, but a safe default.\n\n  actions_taken = []\n\n  # Access the underlying CraftState instance directly to get the current state information.\n  # This allows `collect_v2` to be called mid-episode without resetting the environment,\n  # supporting composition of actions.\n  current_state = env._current_state\n\n  # --- Initial validation and early exit conditions ---\n  \n  # 1. Check if the `primitive` ID is recognized by the world's cookbook.\n  # If the primitive is not a valid kind in the world, it cannot be collected.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # 2. Check if the `primitive` is already in the agent's inventory.\n  # If already collected, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n  \n  # 3. If the maximum allowed steps for pathfinding is non-positive, no path can be found.\n  if MAX_COLLECT_STEPS <= 0:\n      return []\n\n  # --- Retrieve necessary environment information for pathfinding ---\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir\n\n  # Determine which entity kinds block agent movement (i.e., cells agents cannot traverse).\n  # Workshops are typically traversable, even if non-grabbable, to allow crafting.\n  impassable_for_movement = set()\n  # Add water if it exists and is defined as a kind, as it's usually impassable.\n  if current_state.world.water_index in current_state.world.kinds:\n      impassable_for_movement.add(current_state.world.water_index)\n  \n  # Add other non-grabbable items that are not workshops to the impassable set.\n  # Convert workshop_indices to a set for faster lookup during traversal checks.\n  workshop_indices_set = set(current_state.world.workshop_indices) \n  for k_idx in current_state.world.non_grabbable_indices:\n      if k_idx not in workshop_indices_set:\n          impassable_for_movement.add(k_idx)\n\n  # Define movement actions, their resulting agent direction, and the (dy, dx) grid changes.\n  # The agent's direction is assumed to update to face the cardinal direction of its last movement.\n  # Format: {ACTION_CONSTANT: (resulting_direction_constant, dy, dx)}\n  movement_actions_map = {\n      ACTION_UP:    (DIR_NORTH, -1, 0),  # Move North (dy=-1, dx=0), agent faces North (DIR_NORTH=3)\n      ACTION_RIGHT: (DIR_EAST, 0, 1),    # Move East (dy=0, dx=1), agent faces East (DIR_EAST=0)\n      ACTION_DOWN:  (DIR_SOUTH, 1, 0),   # Move South (dy=1, dx=0), agent faces South (DIR_SOUTH=1)\n      ACTION_LEFT:  (DIR_WEST, 0, -1)    # Move West (dy=0, dx=-1), agent faces West (DIR_WEST=2)\n  }\n\n  # Initialize Breadth-First Search (BFS) queue.\n  # Each state in the queue is a tuple: (current_y, current_x, current_direction, path_of_actions_so_far).\n  # Storing the current direction is crucial because ACTION_USE depends on agent orientation for non-grabbables.\n  bfs_queue = collections.deque()\n  bfs_queue.append((start_y, start_x, start_dir, []))\n  \n  # Keep track of visited states (position + orientation) to prevent redundant exploration and infinite loops.\n  visited_states = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None  # This variable will store the final sequence of actions if a valid path is found.\n\n  # Determine if the primitive is a \"grabbable\" item (picked up by moving onto its cell and using USE)\n  # or a \"non-grabbable\" item (interacted with from an adjacent cell by facing it and using USE).\n  is_primitive_grabbable = primitive in current_state.world.grabbable_indices\n\n  # --- BFS to find the shortest action sequence to collect the primitive ---\n  while bfs_queue:\n      curr_y, curr_x, curr_dir, current_path_actions = bfs_queue.popleft()\n\n      # Pruning: If the current path length already equals or exceeds MAX_COLLECT_STEPS,\n      # this path cannot lead to a valid solution because adding the final ACTION_USE\n      # would make the total path length exceed the limit.\n      if len(current_path_actions) >= MAX_COLLECT_STEPS:\n          continue\n\n      # --- Goal Check: Determine if the primitive can be collected from the current state (position and direction) ---\n\n      # Scenario 1: Primitive is \"grabbable\" and located on the agent's current cell.\n      # For grabbable items, ACTION_USE collects them from the same cell, regardless of facing direction.\n      if is_primitive_grabbable and full_grid[curr_y, curr_x, primitive] > 0:\n          candidate_path = current_path_actions + [ACTION_USE]\n          # Since BFS finds the shortest path, the first valid path found is the optimal one.\n          path_to_execute = candidate_path\n          break \n      \n      # Scenario 2: Primitive is \"non-grabbable\" and located in the cell the agent is currently facing.\n      # For non-grabbable items, ACTION_USE interacts with the object in the cell directly in front.\n      elif not is_primitive_grabbable:\n          facing_y, facing_x = _get_facing_coords(curr_y, curr_x, curr_dir)\n\n          # Check if the facing cell is within grid boundaries and contains the target primitive.\n          if (0 <= facing_y < grid_height and 0 <= facing_x < grid_width and\n              full_grid[facing_y, facing_x, primitive] > 0):\n              \n              candidate_path = current_path_actions + [ACTION_USE]\n              path_to_execute = candidate_path\n              break # Found the shortest path, exit BFS.\n\n      # --- Explore neighboring cells via movement actions ---\n      for action_move, (next_dir, dy, dx) in movement_actions_map.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          \n          # Pruning: Check if adding this movement action would leave enough room for a final ACTION_USE.\n          # If `len(current_path_actions) + 1` (the path length after this move) is already\n          # `MAX_COLLECT_STEPS` or more, there's no space for the final `ACTION_USE`.\n          if len(current_path_actions) + 1 >= MAX_COLLECT_STEPS:\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable (does not contain impassable entities).\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # Check if this new (position, direction) state has already been visited\n          # to prevent redundant exploration and infinite loops.\n          if (next_y, next_x, next_dir) in visited_states:\n              continue\n\n          # If all checks pass, add the new state to the queue for further exploration.\n          visited_states.add((next_y, next_x, next_dir))\n          bfs_queue.append((next_y, next_x, next_dir, current_path_actions + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      # If no valid path was found within the step limit, return an empty list.\n      return []\n\n  for action in path_to_execute:\n      actions_taken.append(action)\n      # Perform the action in the environment. We only care about the resulting state.\n      _, done, _ = env.step(action)\n      \n      # Update the internal state reference to reflect the current environment after the step.\n      current_state = env._current_state\n\n      # If the primitive is successfully collected at any point (e.g., immediate pickup),\n      # we can stop early and return the actions taken so far.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n      # If the episode terminates (`done` is True) but the primitive was NOT collected,\n      # it implies failure. In this case, the current partial path is invalid.\n      if done and current_state.inventory[primitive] <= 0:\n          return []\n\n  # Final verification: After executing all actions in the `path_to_execute`,\n  # confirm that the primitive was indeed collected into the inventory.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it indicates an unhandled environmental factor (e.g., tool requirement, resource depletion).\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T20:50:03.917848", "function_name": "collect", "function_body": "  # Assumes `collections` module is imported at the top-level of the file (e.g., `import collections`).\n  # Assumes `env_factory.ACTION_NAMES` are available (e.g., `env_factory.ACTION_NAMES.USE`).\n\n  # Define action-to-delta mapping for convenience in BFS.\n  # These map an action index to the (dx, dy) change it causes.\n  ACTION_TO_DELTAS = {\n      env_factory.ACTION_NAMES.UP: (0, -1),\n      env_factory.ACTION_NAMES.DOWN: (0, 1),\n      env_factory.ACTION_NAMES.LEFT: (-1, 0),\n      env_factory.ACTION_NAMES.RIGHT: (1, 0),\n  }\n\n  current_state = env._current_state\n  grid = current_state.grid\n  width, height, n_kinds = grid.shape\n  start_x, start_y = current_state.pos\n\n  # Identify cell types that block movement.\n  # The agent cannot move onto cells containing non-grabbable items or workshops.\n  world = current_state.world\n  blocked_kinds = set(world.non_grabbable_indices)\n  blocked_kinds.update(world.workshop_indices)\n\n  # Helper function to check if a grid cell is traversable.\n  # A cell is traversable if it's within bounds and does not contain any blocked item.\n  def is_traversable(x, y):\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      # Check if the cell contains any item from the blocked_kinds set.\n      for kind_idx in blocked_kinds:\n          if grid[x, y, kind_idx] > 0:\n              return False\n      return True\n\n  # Initialize a queue for Breadth-First Search (BFS).\n  # Each element in the queue is (x, y, list_of_actions_to_reach_here).\n  q = collections.deque([(start_x, start_y, [])])\n  # Initialize a set to keep track of visited (x, y) coordinates to avoid cycles.\n  visited = set([(start_x, start_y)])\n\n  final_actions = [] # This will store the sequence of actions if a path is found.\n\n  # Perform BFS\n  while q:\n      cx, cy, current_path = q.popleft()\n\n      # Check if the current cell contains the primitive we are looking for.\n      if grid[cx, cy, primitive] > 0:\n          # If found, add the 'USE' action and this is our shortest path.\n          final_actions = current_path + [env_factory.ACTION_NAMES.USE]\n          break # Path found, exit BFS.\n\n      # Explore neighboring cells\n      for action_key, (dx, dy) in ACTION_TO_DELTAS.items():\n          nx, ny = cx + dx, cy + dy # Calculate neighbor's coordinates\n\n          # If the neighbor has not been visited yet:\n          if (nx, ny) not in visited:\n              # Determine if the target neighbor cell (nx, ny) is the primitive itself,\n              # which is always traversable for collection.\n              is_target_primitive_cell = (0 <= nx < width and 0 <= ny < height and grid[nx, ny, primitive] > 0)\n              \n              # Add to queue if it's the primitive cell, or a generally traversable cell.\n              if is_target_primitive_cell or is_traversable(nx, ny):\n                  visited.add((nx, ny)) # Mark as visited\n                  # Add the neighbor to the queue with its path\n                  q.append((nx, ny, current_path + [action_key]))\n\n  return final_actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:50:03.987977", "function_name": "collect", "function_body": "    actions = []\n\n    # Mapping from dir to (dr, dc) for grid coordinates (r is row, c is col)\n    # 0: North (row decreases), 1: East (col increases), 2: South (row increases), 3: West (col decreases)\n    _DIR_VECS = {\n        0: (-1, 0),\n        1: (0, 1),\n        2: (1, 0),\n        3: (0, -1)\n    }\n\n    def _find_path_to_primitive(grid, start_pos, primitive_idx, non_grabbable_indices):\n        \"\"\"\n        Performs BFS to find the closest cell that either contains the primitive\n        or is adjacent to the primitive.\n        Returns (target_pos, path_to_target) or (None, None) if not found.\n        Path is a list of (r, c) tuples from start_pos to target_pos (exclusive of start_pos).\n        \"\"\"\n        HEIGHT, WIDTH, _ = grid.shape\n        q = collections.deque([(start_pos, [])]) # (current_pos, path_from_start_to_current)\n        visited = {start_pos}\n\n        # All 4 cardinal directions for neighbors\n        neighbor_deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)] # N, S, W, E\n\n        while q:\n            (r, c), path = q.popleft()\n\n            # Check if the current cell contains the primitive\n            if grid[r, c, primitive_idx] == 1:\n                return (r, c), path\n\n            # Check if any neighbor of the current cell contains the primitive\n            # If so, this current cell (r,c) is a valid \"approach\" cell for USE action\n            for dr, dc in neighbor_deltas:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < HEIGHT and 0 <= nc < WIDTH:\n                    if grid[nr, nc, primitive_idx] == 1:\n                        return (r, c), path # Return current cell as the target to move to\n            \n            # Explore valid neighbors\n            for dr, dc in neighbor_deltas:\n                nr, nc = r + dr, c + dc\n                if (0 <= nr < HEIGHT and 0 <= nc < WIDTH and\n                    (nr, nc) not in visited):\n                    \n                    # Check if the neighbor cell is an obstacle (non-grabbable)\n                    is_obstacle = False\n                    for k in non_grabbable_indices:\n                        if grid[nr, nc, k] == 1:\n                            is_obstacle = True\n                            break\n                    \n                    if not is_obstacle:\n                        visited.add((nr, nc))\n                        q.append(((nr, nc), path + [(nr, nc)]))\n\n        return None, None # Primitive not found\n\n    def _get_actions_from_path(start_pos, start_dir, target_path, action_map):\n        \"\"\"\n        Converts a path of (r, c) tuples into a list of actions.\n        start_pos: (r, c) tuple\n        start_dir: int (0=N, 1=E, 2=S, 3=W)\n        target_path: list of (r, c) tuples, excluding start_pos, leading to the target.\n        action_map: dict of action names to int codes.\n        Returns a list of integer actions.\n        \"\"\"\n        generated_actions = []\n        current_pos = start_pos\n        current_dir = start_dir\n\n        for next_pos in target_path:\n            # Calculate desired direction to move to next_pos\n            dr_needed = next_pos[0] - current_pos[0]\n            dc_needed = next_pos[1] - current_pos[1]\n\n            # Determine the desired direction integer\n            desired_dir = -1\n            for d, (dr, dc) in _DIR_VECS.items():\n                if dr == dr_needed and dc == dc_needed:\n                    desired_dir = d\n                    break\n            \n            if desired_dir == -1: # Should not happen if path is valid\n                # This indicates a non-cardinal move or pathfinding error. Stop generating actions.\n                break \n\n            # Calculate rotations needed to face desired_dir from current_dir\n            # (desired_dir - current_dir + 4) % 4:\n            #   0: no turn\n            #   1: right turn\n            #   2: two turns (e.g., right-right or left-left, prefer two rights)\n            #   3: left turn\n            \n            diff_dir = (desired_dir - current_dir + 4) % 4\n\n            if diff_dir == 1: # Turn Right\n                generated_actions.append(action_map['RIGHT'])\n            elif diff_dir == 2: # Turn Right, Right\n                generated_actions.append(action_map['RIGHT'])\n                generated_actions.append(action_map['RIGHT'])\n            elif diff_dir == 3: # Turn Left\n                generated_actions.append(action_map['LEFT'])\n            \n            # After turning, always move forward (UP)\n            generated_actions.append(action_map['UP'])\n            \n            # Update current state for next iteration\n            current_pos = next_pos\n            current_dir = desired_dir\n        \n        return generated_actions\n\n    # Get action mappings\n    action_map = env.action_specs()\n\n    # Get initial state info from the current CraftState instance held by CraftLab\n    current_state = env._current_state\n    \n    # If primitive is already in inventory, no actions needed\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get current grid, agent position, and direction\n    grid = current_state.grid\n    agent_pos = current_state.pos\n    agent_dir = current_state.dir\n\n    # Get non-grabbable indices to treat as obstacles in pathfinding\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # Find the path to the primitive or a cell adjacent to it\n    target_cell_for_use, path_to_target = _find_path_to_primitive(grid, agent_pos, primitive, non_grabbable_indices)\n\n    if target_cell_for_use is None:\n        # Primitive not found or not reachable on the current map\n        return [] \n    \n    # Generate actions to move to the target cell\n    movement_actions = _get_actions_from_path(agent_pos, agent_dir, path_to_target, action_map)\n    actions.extend(movement_actions)\n\n    # After moving to the target cell, the agent should be able to \"USE\" the primitive.\n    # The _find_path_to_primitive ensures that target_cell_for_use is either the primitive's\n    # location itself, or a cell adjacent to it.\n    actions.append(action_map['USE'])\n\n    return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:51:16.514198", "function_name": "collect", "function_body": "    # Action constants for CraftLab\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    actions_taken = []\n    max_collection_attempts = 500  # Limit to prevent infinite loops\n\n    for _ in range(max_collection_attempts):\n        current_state = env._current_state  # Access the CraftState instance\n\n        # 1. Check if the primitive is already in the inventory\n        if current_state.inventory[primitive] > 0:\n            return actions_taken\n\n        # 2. Check if the primitive is in the agent's 3x3 neighborhood\n        # (This includes the agent's current cell, implying it can be used/picked up)\n        if current_state.next_to(primitive):\n            # If adjacent, attempt to use/pick up the item\n            actions_taken.append(USE)\n            reward, done, _ = env.step(USE)\n            # After trying to USE, re-check inventory immediately\n            if current_state.inventory[primitive] > 0:\n                return actions_taken\n            # If not collected after USE, it might be an ungrabbable item (unlikely for a primitive),\n            # or some other condition. Let the loop continue to potentially move or retry.\n\n        # 3. If not in inventory and not adjacent, find the primitive on the grid and move towards it\n        primitive_grid_pos = None\n        grid_width, grid_height, _ = current_state.grid.shape\n        agent_x, agent_y = current_state.pos\n\n        # Search the entire grid for the primitive\n        for x in range(grid_width):\n            for y in range(grid_height):\n                # Check if the primitive kind exists at this grid cell\n                if current_state.grid[x, y, primitive] > 0:\n                    primitive_grid_pos = (x, y)\n                    break\n            if primitive_grid_pos:\n                break\n\n        if primitive_grid_pos is None:\n            # Primitive not found on the grid. It might have been collected by another agent,\n            # destroyed, or never existed in the first place.\n            # Since the goal is to collect it, if it's not present, we cannot.\n            return actions_taken  # Indicate failure to collect by returning actions taken so far.\n\n        target_x, target_y = primitive_grid_pos\n\n        # Determine the best movement action to reduce Manhattan distance\n        # Prioritize movement along the dimension with the larger distance\n        dx = target_x - agent_x\n        dy = target_y - agent_y\n\n        action_to_take = -1\n\n        if dx != 0 or dy != 0:  # Only move if not already at the target cell\n            if abs(dx) >= abs(dy):  # Prioritize horizontal movement if dx is greater or equal\n                if dx > 0:\n                    action_to_take = RIGHT\n                elif dx < 0:\n                    action_to_take = LEFT\n                else:  # dx is 0, so dy must be non-zero\n                    if dy > 0:\n                        action_to_take = DOWN\n                    elif dy < 0:\n                        action_to_take = UP\n            else:  # abs(dy) > abs(dx), prioritize vertical movement\n                if dy > 0:\n                    action_to_take = DOWN\n                elif dy < 0:\n                    action_to_take = UP\n                else:  # dy is 0, so dx must be non-zero\n                    if dx > 0:\n                        action_to_take = RIGHT\n                    elif dx < 0:\n                        action_to_take = LEFT\n\n            if action_to_take != -1:\n                actions_taken.append(action_to_take)\n                reward, done, _ = env.step(action_to_take)\n            else:\n                # Should not happen if dx or dy is non-zero, implies a logical error\n                # or agent is stuck and cannot move towards the target.\n                break  # Exit loop, cannot proceed.\n        else:\n            # Agent is on the same cell as the primitive. This case should ideally\n            # be caught by the `current_state.next_to(primitive)` check and trigger a USE.\n            # If we reach here and it's not collected, it implies the item cannot be\n            # collected from this cell or `next_to` definition doesn't fit `USE`.\n            break  # Exit loop, cannot proceed.\n\n    # If the loop finishes without collecting, it means max_collection_attempts was reached.\n    return actions_taken", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T20:51:17.481389", "function_name": "collect", "function_body": "  # Constants from env_factory.ACTIONS for clarity\n  _UP = env_factory.ACTIONS['up']\n  _DOWN = env_factory.ACTIONS['down']\n  _LEFT = env_factory.ACTIONS['left']\n  _RIGHT = env_factory.ACTIONS['right']\n  _USE = env_factory.ACTIONS['use']\n\n  # Mapping from action to ((delta_row, delta_col), new_direction_index)\n  # This assumes a movement action also sets the agent's facing direction to\n  # the cardinal direction of that movement.\n  # CraftState.dir indices: 0 (N), 1 (E), 2 (S), 3 (W)\n  ACTION_TO_MOVE_AND_NEW_DIR = {\n      _UP: ((0, -1), 0),   # Move North (dr=0, dc=-1), face North (dir=0)\n      _RIGHT: ((1, 0), 1), # Move East (dr=1, dc=0), face East (dir=1)\n      _DOWN: ((0, 1), 2),  # Move South (dr=0, dc=1), face South (dir=2)\n      _LEFT: ((-1, 0), 3)  # Move West (dr=-1, dc=0), face West (dir=3)\n  }\n\n  # Mapping from relative position of an object to the required facing direction\n  # for the agent to USE that object.\n  # Example: if an object is at (r, c-1) relative to agent, agent must face North (dir 0)\n  RELATIVE_POS_TO_FACING_DIR = {\n      (0, -1): 0, # Object is North, agent needs to face North\n      (1, 0): 1,  # Object is East, agent needs to face East\n      (0, 1): 2,  # Object is South, agent needs to face South\n      (-1, 0): 3  # Object is West, agent needs to face West\n  }\n\n  # Get initial state information\n  initial_state = env._current_state\n  current_inventory = initial_state.inventory\n\n  # 1. Check if the primitive is grabbable at all\n  if primitive in env.world.non_grabbable_indices:\n    return [] # Cannot collect non-grabbable items\n\n  # 2. Check if the primitive is already in the inventory\n  if current_inventory[primitive] > 0:\n    return [] # Primitive already collected\n\n  grid = initial_state.grid\n  start_pos = initial_state.pos\n  start_dir = initial_state.dir # Agent's initial facing direction\n  height, width, _ = grid.shape # n_kinds is not needed for bounds checking\n\n  # BFS setup\n  q = collections.deque()\n  visited = set() # Stores (row, col, direction) to avoid cycles\n\n  # BFS state: (row, col, direction, list_of_actions_taken)\n  q.append((start_pos[0], start_pos[1], start_dir, []))\n  visited.add((start_pos[0], start_pos[1], start_dir))\n\n  while q:\n    r, c, d, actions = q.popleft()\n\n    # Check if a primitive can be collected from the current position (r, c)\n    # by looking at adjacent cells and verifying facing direction.\n    for (dr_adj, dc_adj), required_facing_dir in RELATIVE_POS_TO_FACING_DIR.items():\n      pr_adj, pc_adj = r + dr_adj, c + dc_adj # Potential primitive location\n\n      # Check bounds for the adjacent cell\n      if not (0 <= pr_adj < height and 0 <= pc_adj < width):\n        continue\n\n      # If the primitive is in the adjacent cell AND the agent is currently facing it\n      if grid[pr_adj, pc_adj, primitive] == 1 and d == required_facing_dir:\n        return actions + [_USE] # Path found, return actions including USE\n\n    # Explore neighbors by performing movement actions\n    for action_type, ((dr_move, dc_move), new_d) in ACTION_TO_MOVE_AND_NEW_DIR.items():\n      nr, nc = r + dr_move, c + dc_move # New position after move\n\n      # Check bounds for the new position\n      if not (0 <= nr < height and 0 <= nc < width):\n        continue\n\n      # Check if this new state (position + direction) has already been visited\n      if (nr, nc, new_d) not in visited:\n        visited.add((nr, nc, new_d))\n        q.append((nr, nc, new_d, actions + [action_type]))\n\n  # If the BFS completes without finding a path to collect the primitive\n  return []", "island_id": 9, "scores": {"3": -1}}
