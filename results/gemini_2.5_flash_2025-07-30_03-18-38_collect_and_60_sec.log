{"timestamp": "2025-07-30T12:13:46.661753", "function_name": "collect", "function_body": "  import collections\n\n  # Define action constants based on CraftLab.action_specs\n  # These are fixed integer values as per the problem description.\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Define movement deltas for (delta_row, delta_col) corresponding to actions\n  # Agent position is stored as (row, col)\n  MOVE_DELTAS = {\n      ACTION_UP: (-1, 0),    # Move up: row decreases\n      ACTION_DOWN: (1, 0),   # Move down: row increases\n      ACTION_LEFT: (0, -1),  # Move left: col decreases\n      ACTION_RIGHT: (0, 1)   # Move right: col increases\n  }\n\n  # Get current state from the environment\n  current_state = env._current_state\n\n  # Check if primitive is already collected\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  # Get relevant information from the state\n  grid = current_state.grid\n  start_row, start_col = current_state.pos # Agent's current (row, col) position\n\n  # Grid shape is (WIDTH, HEIGHT, n_kinds) according to the problem description.\n  # This implies grid is indexed as grid[col_idx, row_idx, kind_idx].\n  # For boundary checks, we need max row and max col values.\n  # grid.shape[0] is WIDTH (number of columns)\n  # grid.shape[1] is HEIGHT (number of rows)\n  max_col_idx = grid.shape[0] - 1\n  max_row_idx = grid.shape[1] - 1\n\n  # BFS Initialization\n  queue = collections.deque()\n  # Queue stores tuples: ((current_row, current_col), list_of_actions_taken)\n  queue.append(((start_row, start_col), []))\n\n  # Visited set to prevent cycles and re-exploring. Stores (row, col) tuples.\n  visited = set()\n  visited.add((start_row, start_col))\n\n  # Helper for 8-directional neighbors (for checking 3x3 vicinity for USE action)\n  # These deltas are for (delta_row, delta_col)\n  NEIGHBOR_DELTAS_8 = [\n      (-1, 0), (1, 0), (0, -1), (0, 1),      # Cardinal neighbors\n      (-1, -1), (-1, 1), (1, -1), (1, 1)     # Diagonal neighbors\n  ]\n\n  # BFS Loop\n  while queue:\n    (current_row, current_col), path = queue.popleft()\n\n    # Check if the current position is adjacent to the primitive\n    # The 'USE' action typically interacts with items in the 3x3 neighborhood.\n    for dr, dc in NEIGHBOR_DELTAS_8:\n      neighbor_row, neighbor_col = current_row + dr, current_col + dc\n\n      # Check bounds for the neighbor cell\n      if 0 <= neighbor_row <= max_row_idx and \\\n         0 <= neighbor_col <= max_col_idx:\n        # If the neighbor cell contains the primitive\n        # Access grid using grid[col_idx, row_idx, kind_idx]\n        if grid[neighbor_col, neighbor_row, primitive] > 0:\n          # We are in a position to USE to collect the primitive\n          return path + [ACTION_USE]\n\n    # Explore neighbors (move actions)\n    for action, (dr, dc) in MOVE_DELTAS.items():\n      next_row, next_col = current_row + dr, current_col + dc\n\n      # Check bounds for the next agent position\n      if 0 <= next_row <= max_row_idx and \\\n         0 <= next_col <= max_col_idx:\n        next_pos = (next_row, next_col)\n\n        # Check for obstacles (e.g., water)\n        is_obstacle = False\n        world_obj = env.world # Reference to CraftWorld instance\n\n        # Assuming water is impassable. Check grid[col_idx, row_idx, water_kind_idx]\n        if hasattr(world_obj, 'water_index') and \\\n           grid[next_col, next_row, world_obj.water_index] > 0:\n          is_obstacle = True\n        # Additional checks for other impassable entities could be added here\n        # (e.g., if non_grabbable_indices implies impassable terrain).\n        # For 'collect_v2', water is the most explicitly stated general obstacle.\n\n        # If not an obstacle and not visited, add to queue\n        if not is_obstacle and next_pos not in visited:\n          visited.add(next_pos)\n          queue.append((next_pos, path + [action]))\n\n  # If the BFS completes and no path is found, return an empty list\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:13:47.676034", "function_name": "collect", "function_body": "  # Get the current state from the environment\n  # The problem description mentions env._current_state for CraftLab\n  current_state = env._current_state\n\n  # Get agent's current position (x, y)\n  current_x, current_y = current_state.pos\n\n  # Get the grid\n  grid = current_state.grid\n\n  # Find all locations (y, x) of the primitive on the grid\n  # np.argwhere returns (row_index, col_index) which corresponds to (y, x)\n  primitive_locations_yx = np.argwhere(grid[:, :, primitive] == 1)\n\n  # If no primitive is found, return an empty list of actions\n  if not primitive_locations_yx.size:\n    return []\n\n  # Find the closest primitive location using Manhattan distance\n  min_dist = float('inf')\n  target_x, target_y = -1, -1  # Initialize with invalid coordinates\n\n  for py, px in primitive_locations_yx:\n    # px is column (x-coordinate), py is row (y-coordinate)\n    dist = abs(current_x - px) + abs(current_y - py)\n    if dist < min_dist:\n      min_dist = dist\n      target_x, target_y = px, py\n\n  # Generate the sequence of actions to move to the target location\n  actions = []\n  \n  # Temporary variables to simulate agent's movement during path generation\n  current_x_sim, current_y_sim = current_x, current_y\n\n  # Move horizontally (X-axis)\n  while current_x_sim != target_x:\n    if current_x_sim < target_x:\n      actions.append(env_factory.RIGHT)\n      current_x_sim += 1\n    else: # current_x_sim > target_x\n      actions.append(env_factory.LEFT)\n      current_x_sim -= 1\n\n  # Move vertically (Y-axis)\n  # Assuming Y increases downwards (higher row index), so DOWN means increasing Y\n  while current_y_sim != target_y:\n    if current_y_sim < target_y:\n      actions.append(env_factory.DOWN)\n      current_y_sim += 1\n    else: # current_y_sim > target_y\n      actions.append(env_factory.UP)\n      current_y_sim -= 1\n\n  # After reaching the primitive's cell, use the USE action to collect it\n  actions.append(env_factory.USE)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:15:01.232483", "function_name": "collect", "function_body": "  # Get action mappings from the environment\n  action_map = env.action_specs()\n\n  # 1. Get current state and check if the primitive is already in inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive] > 0:\n    return []  # Already collected, no actions needed\n\n  # 2. Check if the agent is already adjacent to the primitive\n  if current_state.next_to(primitive):\n    return [action_map['USE']]  # Use the primitive immediately\n\n  # 3. Pathfinding (BFS) to find the shortest sequence of actions to reach a position\n  #    from which the primitive can be used.\n  grid = current_state.grid\n  start_pos = current_state.pos\n  width, height, _ = grid.shape  # Grid dimensions (WIDTH, HEIGHT)\n\n  # Pre-calculate all possible \"agent target positions\".\n  # An agent can use a primitive if it's in its 3x3 neighborhood.\n  # So, we find all cells (r_item, c_item) that contain the primitive,\n  # then collect all cells (r_agent, c_agent) that are in the 3x3 neighborhood\n  # of any (r_item, c_item). These are the valid positions for the agent to move to.\n  target_agent_positions = set()\n  for r_item in range(width):\n    for c_item in range(height):\n      if grid[r_item, c_item, primitive] > 0:\n        # (r_item, c_item) contains the primitive.\n        # Add all cells in its 3x3 neighborhood as potential agent target positions.\n        for dr in [-1, 0, 1]:\n          for dc in [-1, 0, 1]:\n            r_agent = r_item + dr\n            c_agent = c_item + dc\n            # Ensure the target position is within grid boundaries\n            if 0 <= r_agent < width and 0 <= c_agent < height:\n              target_agent_positions.add((r_agent, c_agent))\n\n  # Initialize BFS queue and visited set\n  # Each element in the queue is a tuple: (current_position, path_taken_to_reach_here)\n  q = collections.deque([(start_pos, [])])\n  visited = {start_pos}\n\n  # Define possible movement directions and their corresponding actions\n  moves_and_actions = [\n      ((-1, 0), action_map['UP']),    # Move Up\n      ((1, 0), action_map['DOWN']),   # Move Down\n      ((0, -1), action_map['LEFT']),  # Move Left\n      ((0, 1), action_map['RIGHT'])   # Move Right\n  ]\n\n  # Perform BFS\n  while q:\n    curr_pos, path = q.popleft()\n\n    # If the current position is one of the calculated target positions,\n    # we have found the shortest path. Append the 'USE' action and return.\n    if curr_pos in target_agent_positions:\n      return path + [action_map['USE']]\n\n    # Explore valid neighbors\n    for (dr, dc), action_val in moves_and_actions:\n      next_r, next_c = curr_pos[0] + dr, curr_pos[1] + dc\n      next_pos = (next_r, next_c)\n\n      # Check if the next position is within bounds and has not been visited\n      if (0 <= next_r < width and 0 <= next_c < height and next_pos not in visited):\n        visited.add(next_pos)\n        q.append((next_pos, path + [action_val]))\n\n  # If the BFS completes and no path is found (e.g., primitive is not on the map\n  # or is entirely unreachable), return an empty list of actions.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:15:01.301972", "function_name": "collect", "function_body": "    current_state = env._current_state  # Get the initial CraftState from the CraftLab environment\n    actions_taken = []\n    max_sim_steps = 200  # A reasonable cap on simulated steps to prevent infinite loops\n\n    # Action constants (assuming these are globally accessible or defined in a base file)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Direction vectors for absolute moves (dy, dx)\n    # Maps action ID to (delta_y, delta_x)\n    MOVE_DELTAS = {\n        ACTION_UP: (-1, 0),\n        ACTION_DOWN: (1, 0),\n        ACTION_LEFT: (0, -1),\n        ACTION_RIGHT: (0, 1),\n    }\n\n    for _ in range(max_sim_steps):\n        # 1. Check if the primitive is already collected in the current simulated inventory\n        if current_state.inventory[primitive] > 0:\n            return actions_taken\n\n        # 2. Check if the agent is next to the primitive (or on top of it)\n        # and attempt to collect it using the USE action.\n        if current_state.next_to(primitive):\n            actions_taken.append(ACTION_USE)\n            _reward, new_state = current_state.step(ACTION_USE)\n            current_state = new_state\n            # After trying to use, re-check inventory in the next iteration of the loop.\n            continue\n\n        # 3. If not collected and not next to it, find the closest primitive and pathfind.\n        grid = current_state.grid\n        current_pos = current_state.pos  # (y, x)\n        grid_height, grid_width, n_kinds = grid.shape\n\n        # Find all locations of the target primitive on the grid\n        primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n\n        if len(primitive_locations) == 0:\n            # The primitive is no longer on the map, and it's not in inventory.\n            # This implies it's uncollectable from this state.\n            return [] \n\n        # Find the closest primitive location to the agent using Manhattan distance\n        closest_primitive_pos = None\n        min_dist = float('inf')\n\n        for p_loc_y, p_loc_x in primitive_locations:\n            dist = abs(p_loc_y - current_pos[0]) + abs(p_loc_x - current_pos[1])\n            if dist < min_dist:\n                min_dist = dist\n                closest_primitive_pos = (p_loc_y, p_loc_x)\n\n        if closest_primitive_pos is None:\n            # This case should theoretically not be reached if primitive_locations is not empty.\n            return []\n\n        # Determine valid target cells for pathfinding: cells adjacent to the closest primitive.\n        # These are the cells from which the agent can perform the USE action to collect the primitive.\n        target_adj_cells = set()\n        py, px = closest_primitive_pos\n        \n        # Check all four direct neighbors (UP, DOWN, LEFT, RIGHT relative to the primitive)\n        for dy, dx in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            ny, nx = py + dy, px + dx\n            # Ensure the neighbor cell is within grid bounds\n            if 0 <= ny < grid_height and 0 <= nx < grid_width:\n                # Check if the neighbor cell is not an obstacle (non-grabbable entity)\n                is_obstacle = False\n                for k_idx in range(n_kinds):\n                    if grid[ny, nx, k_idx] == 1 and k_idx in current_state.world.non_grabbable_indices:\n                        is_obstacle = True\n                        break # Found an obstacle at this spot, so this cell is blocked\n                \n                if not is_obstacle:\n                    target_adj_cells.add((ny, nx))\n        \n        if not target_adj_cells:\n            # No reachable adjacent cells to the primitive (e.g., surrounded by walls/obstacles)\n            return []\n\n        # Perform BFS to find the shortest path from agent's current_pos to any target_adj_cell\n        q = collections.deque()\n        q.append((current_pos, [])) # Queue stores (current_position (y, x), list_of_actions_to_reach_here)\n        visited = {current_pos}     # Set of visited positions to avoid cycles\n\n        path_to_target_adj = None\n\n        while q:\n            (cy, cx), path = q.popleft()\n\n            # If the current position is one of our target adjacent cells, we found a path\n            if (cy, cx) in target_adj_cells:\n                path_to_target_adj = path\n                break\n\n            # Explore all possible movement actions from the current position\n            for action_type, (dy, dx) in MOVE_DELTAS.items():\n                ny, nx = cy + dy, cx + dx\n\n                # Check bounds and if already visited\n                if 0 <= ny < grid_height and 0 <= nx < grid_width and (ny, nx) not in visited:\n                    # Check if the next cell is an obstacle (non-grabbable)\n                    is_obstacle = False\n                    for k_idx in range(n_kinds):\n                        if grid[ny, nx, k_idx] == 1 and k_idx in current_state.world.non_grabbable_indices:\n                            is_obstacle = True\n                            break\n                    \n                    if not is_obstacle:\n                        visited.add((ny, nx))\n                        q.append(((ny, nx), path + [action_type]))\n        \n        if path_to_target_adj:\n            # If a path was found, take the first action from it\n            next_action = path_to_target_adj[0]\n            actions_taken.append(next_action)\n            _reward, new_state = current_state.step(next_action)\n            current_state = new_state\n        else:\n            # No path found to any adjacent cell of the primitive.\n            # The primitive might be isolated or surrounded by unpassable terrain.\n            return []\n\n    # If the loop completes without collecting the primitive (max_sim_steps reached),\n    # return the actions taken so far. This indicates the primitive was not collected within the limit.\n    return actions_taken", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:16:12.421688", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants (as defined in CraftLab/CraftWorld context)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Deltas for movement actions (row, col)\n    MOVE_DELTAS = {\n        ACTION_UP: (-1, 0),\n        ACTION_DOWN: (1, 0),\n        ACTION_LEFT: (0, -1),\n        ACTION_RIGHT: (0, 1),\n    }\n\n    current_state = env._current_state\n    current_pos = current_state.pos\n    grid = current_state.grid\n    inventory = current_state.inventory\n    \n    # Grid dimensions\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # 1. Check if the primitive is already in the inventory\n    if inventory[primitive] > 0:\n        return []\n\n    # 2. Find all grid locations where the primitive exists\n    primitive_locations = []\n    for r in range(WIDTH):\n        for c in range(HEIGHT):\n            # Check if the specified primitive kind is present at this grid cell\n            if grid[r, c, primitive] > 0:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        # Primitive not found anywhere on the grid\n        return []\n\n    # 3. Determine all \"target adjacent positions\"\n    # These are positions from which the agent can perform an ACTION_USE\n    # to collect the primitive (i.e., any cell within a 3x3 neighborhood of a primitive).\n    target_adjacent_positions = set()\n    for r_p, c_p in primitive_locations:\n        # Iterate through the 3x3 neighborhood around the primitive location (including itself)\n        for dr in [-1, 0, 1]:\n            for dc in [-1, 0, 1]:\n                r_adj, c_adj = r_p + dr, c_p + dc\n                # Check if the adjacent position is within grid boundaries\n                if 0 <= r_adj < WIDTH and 0 <= c_adj < HEIGHT:\n                    target_adjacent_positions.add((r_adj, c_adj))\n    \n    # Small optimization: If the agent is already at a position where it can use\n    if current_pos in target_adjacent_positions:\n        return [ACTION_USE]\n\n    # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n    # from the current position to any target adjacent position.\n    \n    # Queue stores (position, list_of_actions_to_reach_position)\n    q = collections.deque([(current_pos, [])])  \n    # Set of visited positions to prevent cycles and find shortest path\n    visited = {current_pos}  \n\n    while q:\n        (r, c), path = q.popleft()\n\n        # Explore possible movement actions (UP, DOWN, LEFT, RIGHT)\n        for action, (dr, dc) in MOVE_DELTAS.items():\n            new_r, new_c = r + dr, c + dc\n            new_pos = (new_r, new_c)\n\n            # Check if the new position is within grid bounds and has not been visited\n            if 0 <= new_r < WIDTH and 0 <= new_c < HEIGHT and new_pos not in visited:\n                new_path = path + [action]\n                \n                # If this new position is one of our targets, we found the path!\n                # The agent can move to new_pos and then perform ACTION_USE.\n                if new_pos in target_adjacent_positions:\n                    return new_path + [ACTION_USE] # Append USE action and return\n\n                visited.add(new_pos)\n                q.append((new_pos, new_path))\n\n    # If the queue becomes empty and no path to any target_adjacent_position was found\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:16:12.491130", "function_name": "collect", "function_body": "    # 1. Check if primitive is already collected in the initial state\n    initial_state = env._current_state\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    # BFS Setup for pathfinding\n    # The queue stores tuples of (CraftState_instance, list_of_actions_to_reach_this_state)\n    queue = collections.deque([(initial_state, [])])\n\n    # Visited set to prevent infinite loops and redundant exploration.\n    # A state is defined by its position (x, y) and facing direction.\n    # Inventory is not part of the key as we assume non-target item collection doesn't\n    # significantly change traversability or goal achievement state for this simple task.\n    visited = set([(initial_state.pos[0], initial_state.pos[1], initial_state.dir)])\n\n    # Action mappings (constants from CraftLab.action_specs)\n    # DOWN = 0, UP = 1, LEFT = 2, RIGHT = 3, USE = 4\n    move_actions = [0, 1, 2, 3] # Actions for movement\n    use_action = 4 # Action for using/collecting\n\n    # Maximum number of steps to search. Prevents excessively long paths or infinite loops.\n    # This value might need tuning based on expected grid sizes.\n    max_path_length = 150\n\n    while queue:\n        current_state, path_so_far = queue.popleft()\n\n        # Prune paths that exceed the maximum length to prevent very long searches\n        if len(path_so_far) >= max_path_length:\n            continue\n\n        # First, try to collect the primitive using the 'USE' action if currently next to it.\n        # CraftState.next_to(primitive) checks if the primitive is in the 3x3 neighborhood.\n        if current_state.next_to(primitive):\n            # Simulate the 'USE' action on a copy of the current state.\n            # The reward is typically 0.0 for steps in this environment.\n            _, state_after_use = current_state.step(use_action)\n\n            # Check if the primitive was successfully collected after the 'USE' action.\n            if state_after_use.inventory[primitive] > 0:\n                # If collected, this path is the solution.\n                return path_so_far + [use_action]\n\n        # Next, explore possible movement actions from the current state.\n        for action in move_actions:\n            # Simulate the movement action, which returns a new CraftState instance.\n            _, next_state = current_state.step(action)\n\n            # Check if the primitive was collected by simply performing the move action.\n            # This handles cases where items are picked up by walking over them (if implemented this way).\n            if next_state.inventory[primitive] > 0:\n                return path_so_far + [action] # Path found by moving directly onto/over it\n\n            # Check if the agent actually moved or turned. If not, the path is blocked\n            # or the action had no effect (e.g., trying to move into a wall).\n            if next_state.pos == current_state.pos and next_state.dir == current_state.dir:\n                continue # Agent did not move/turn, so this move is not useful for exploration.\n\n            # Create a unique key for the next state to check against the visited set.\n            next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n            # If this state (position and direction) has not been visited before, add it to the queue.\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                queue.append((next_state, path_so_far + [action]))\n\n    # If the queue becomes empty and no path to collect the primitive was found, return an empty list.\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:17:41.522921", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action index to (dx, dy) for movement actions\n  actions_movement_map = {\n      0: (0, 1),  # DOWN (Y increases)\n      1: (0, -1), # UP (Y decreases)\n      2: (-1, 0), # LEFT (X decreases)\n      3: (1, 0)   # RIGHT (X increases)\n  }\n\n  # Agent's internal direction mapping (0:N, 1:E, 2:S, 3:W) to (dx, dy) offset\n  # This tells us where the agent *looks* relative to its position\n  direction_offsets = {\n      0: (0, -1), # North: (x, y-1)\n      1: (1, 0),  # East:  (x+1, y)\n      2: (0, 1),  # South: (x, y+1)\n      3: (-1, 0)  # West:  (x-1, y)\n  }\n\n  # Mapping from a movement action index to the resulting agent direction\n  # Moving UP makes agent face North, etc.\n  move_action_to_dir = {\n      1: 0, # UP -> North (dir 0)\n      3: 1, # RIGHT -> East (dir 1)\n      0: 2, # DOWN -> South (dir 2)\n      2: 3  # LEFT -> West (dir 3)\n  }\n\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  current_pos_x, current_pos_y = obs['features_dict']['pos']\n  current_dir = env._current_state.dir # Agent's initial facing direction\n\n  # Grid dimensions\n  WIDTH, HEIGHT = grid.shape[1], grid.shape[0]\n\n  # Get non-grabbable indices from the CraftWorld instance via CraftLab env\n  # These are entities that block movement (e.g., workshops, water, stone unless scooping/mining)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find all grid locations where the primitive exists\n  primitive_locations = []\n  for y in range(HEIGHT):\n      for x in range(WIDTH):\n          if grid[y, x, primitive] == 1:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      return [] # Primitive not found on the grid, cannot collect\n\n  # BFS state: (current_x, current_y, list_of_actions_taken, current_agent_direction)\n  # current_agent_direction is the direction *after* the last action in list_of_actions_taken\n  queue = collections.deque([(current_pos_x, current_pos_y, [], current_dir)])\n  \n  # Visited set for BFS: ((x, y), dir) to avoid revisiting a state (position + orientation)\n  visited = set([(current_pos_x, current_pos_y, current_dir)]) \n\n  while queue:\n      cx, cy, path_actions, current_agent_dir = queue.popleft()\n\n      # After reaching (cx, cy) with current_agent_dir, check if we can USE the primitive\n      # The USE action interacts with the cell *in front* of the agent\n      face_dx, face_dy = direction_offsets[current_agent_dir]\n      target_check_x, target_check_y = cx + face_dx, cy + face_dy\n\n      # Check if the cell in front contains the primitive\n      if (0 <= target_check_x < WIDTH and 0 <= target_check_y < HEIGHT and\n          (target_check_x, target_check_y) in primitive_locations):\n          \n          final_collection_path = list(path_actions) + [4] # Add USE action\n          return final_collection_path # Found shortest path to collect\n\n      # Explore possible next moves (UP, DOWN, LEFT, RIGHT)\n      for action_idx, (dx, dy) in actions_movement_map.items():\n          nx, ny = cx + dx, cy + dy # New position after this move\n\n          # Check if the new position is within grid boundaries\n          is_valid_pos = 0 <= nx < WIDTH and 0 <= ny < HEIGHT\n          \n          if is_valid_pos:\n              # Check if the new cell (nx, ny) is blocked by any non-grabbable items\n              is_blocked = False\n              for kind_idx in non_grabbable_indices:\n                  if grid[ny, nx, kind_idx] > 0:\n                      is_blocked = True\n                      break\n              \n              if not is_blocked:\n                  # If agent moves, it faces the direction of movement\n                  new_agent_dir = move_action_to_dir[action_idx]\n                  \n                  # Check if this new state (position + direction) has been visited\n                  if (nx, ny, new_agent_dir) not in visited:\n                      new_path_actions = list(path_actions) + [action_idx]\n                      visited.add((nx, ny, new_agent_dir))\n                      queue.append((nx, ny, new_path_actions, new_agent_dir))\n  \n  return [] # No path found to collect the primitive", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T12:17:42.606778", "function_name": "collect", "function_body": "  import collections\n\n  action_map = env.action_specs()\n  actions_to_return = []\n\n  # Get the current state directly from the environment's internal state\n  current_state = env._current_state\n\n  # 1. Check if primitive is already in inventory\n  if current_state.inventory[primitive] > 0:\n    return [] # Already collected, no actions needed\n\n  # 2. Check if agent is already next to the primitive\n  # If so, just perform the USE action\n  if current_state.next_to(primitive):\n    return [action_map['USE']]\n\n  # Get relevant data from the current state\n  grid = current_state.grid\n  current_pos = current_state.pos\n  width, height, n_kinds = grid.shape\n\n  # Define possible moves for BFS. The actions correspond to relative (dx, dy) movements.\n  move_deltas = {\n      action_map['UP']:    (0, -1),\n      action_map['DOWN']:  (0, 1),\n      action_map['LEFT']:  (-1, 0),\n      action_map['RIGHT']: (1, 0),\n  }\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = []\n  for x_grid in range(width):\n    for y_grid in range(height):\n      if grid[x_grid, y_grid, primitive] == 1:\n        primitive_locations.append((x_grid, y_grid))\n\n  if not primitive_locations:\n    # Primitive not found on the grid, cannot collect\n    return []\n\n  # Helper function to check if a cell is adjacent to any primitive location\n  def is_adjacent_to_any_primitive(cell_x, cell_y, prim_locs):\n    for px, py in prim_locs:\n      if abs(cell_x - px) + abs(cell_y - py) == 1: # Manhattan distance of 1 means adjacent\n        return True\n    return False\n\n  # 3. BFS to find the shortest path to a cell adjacent to any primitive instance\n  q = collections.deque([(current_pos, [])]) # Queue stores (current_coords, path_actions_list)\n  visited = {current_pos} # Set of visited (x, y) coordinates\n\n  final_path_actions = None\n\n  while q:\n    (x, y), path_actions = q.popleft()\n\n    # If the current cell (x, y) is adjacent to any primitive, we've found our target\n    if is_adjacent_to_any_primitive(x, y, primitive_locations):\n      final_path_actions = path_actions\n      break # BFS guarantees the first path found is the shortest\n\n    # Explore neighbors\n    for action, (dx, dy) in move_deltas.items():\n      nx, ny = x + dx, y + dy\n\n      # Check boundary conditions\n      if not (0 <= nx < width and 0 <= ny < height):\n        continue\n\n      # Prevent moving onto a cell that *is* the primitive itself.\n      # The goal is to be *adjacent* to the primitive to USE it.\n      if (nx, ny) in primitive_locations:\n        continue\n\n      # If the neighbor has not been visited, add it to the queue\n      if (nx, ny) not in visited:\n        visited.add((nx, ny))\n        new_path_actions = path_actions + [action]\n        q.append(((nx, ny), new_path_actions))\n\n  if final_path_actions is None:\n    # No path found to any cell adjacent to a primitive\n    return []\n\n  # 4. Append the USE action after the movement path\n  actions_to_return.extend(final_path_actions)\n  actions_to_return.append(action_map['USE'])\n\n  return actions_to_return", "island_id": 4, "scores": {"3": -1}}
