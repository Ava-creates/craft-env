{"timestamp": "2025-07-30T18:24:34.225287", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Action and Direction Constants\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  # Map agent's facing direction to (dx, dy) delta for moving \"forward\" in that direction.\n  # (dx, dy) represents the change in (x, y) coordinates.\n  DIR_DELTAS = {\n      DIR_UP: (0, -1),   # Moving up: x constant, y decreases\n      DIR_RIGHT: (1, 0),  # Moving right: x increases, y constant\n      DIR_DOWN: (0, 1),   # Moving down: x constant, y increases\n      DIR_LEFT: (-1, 0),  # Moving left: x decreases, y constant\n  }\n\n  # Pre-compute a reverse mapping from (dx, dy) vector to the corresponding DIR_ constant.\n  VECTOR_TO_DIR = {v: k for k, v in DIR_DELTAS.items()}\n\n  # Map a movement action to the agent's resulting facing direction.\n  ACTION_TO_RESULTING_DIR = {\n      ACTION_UP: DIR_UP,\n      ACTION_RIGHT: DIR_RIGHT,\n      ACTION_DOWN: DIR_DOWN,\n      ACTION_LEFT: DIR_LEFT,\n  }\n\n  MOVEMENT_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # 1. Get current state information from the environment.\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Extract current agent position (x, y) and direction.\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  current_dir = np.argmax(obs['features_dict']['direction'])\n\n  # Get world configuration, specifically non-grabbable entities that act as obstacles.\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n\n  grid_width, grid_height, _ = grid.shape\n\n  # 2. Determine traversable cells on the grid.\n  # If non_grabbable_indices is empty, np.any on an empty slice returns False for all cells,\n  # resulting in a traversable_mask of all True, which is correct (all cells are traversable).\n  traversable_mask = ~np.any(grid[:, :, list(non_grabbable_indices)] > 0, axis=2)\n  \n  # If the agent's starting position is not traversable, it cannot move.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return []\n\n  # 3. Identify all locations on the grid where the target primitive exists.\n  # np.argwhere returns (row, col) coordinates, which correspond to (y, x) in a grid.\n  # We convert them to (x, y) for consistency with current_pos_x, current_pos_y.\n  primitive_locations_on_grid = [(x, y) for y, x in np.argwhere(grid[:, :, primitive] > 0)]\n\n  if not primitive_locations_on_grid:\n      return [] # The primitive is not present anywhere on the map.\n\n  # 4. Identify \"collectable target states\" for the agent.\n  # A target state is (agent_x, agent_y, agent_direction) from which the ACTION_USE\n  # can successfully collect the primitive. This requires the agent to be adjacent\n  # to the primitive and facing it.\n  collectable_target_states = set()\n  \n  for p_x, p_y in primitive_locations_on_grid:\n      # Iterate through each cardinal direction the agent could face towards the primitive.\n      # (dx, dy) here represents the vector from the agent to the primitive.\n      for required_agent_dir, (dx, dy) in DIR_DELTAS.items():\n          # Calculate the agent's potential position (a_x, a_y) given the primitive at (p_x, p_y)\n          # and the required facing direction (dx, dy).\n          # If agent is at (a_x, a_y) and faces (dx, dy), the primitive must be at (a_x + dx, a_y + dy).\n          # So, a_x = p_x - dx, a_y = p_y - dy.\n          a_x, a_y = p_x - dx, p_y - dy\n\n          # Check if this potential agent position is within grid boundaries and is traversable.\n          if (0 <= a_x < grid_width and 0 <= a_y < grid_height and traversable_mask[a_x, a_y]):\n              collectable_target_states.add((a_x, a_y, required_agent_dir))\n\n  if not collectable_target_states:\n      return [] # No valid states exist from which the primitive can be collected.\n\n  # 5. Perform a Breadth-First Search (BFS) on the state space.\n  # A state is defined by (agent_x, agent_y, agent_direction).\n  start_state = (current_pos_x, current_pos_y, current_dir)\n  \n  # The queue stores tuples: ((current_x, current_y, current_dir), [list_of_actions_taken_to_reach_this_state]).\n  q = deque([(start_state, [])]) \n  \n  # The `visited_states` set keeps track of states already explored to prevent cycles and redundant paths.\n  visited_states = {start_state}\n\n  while q:\n      (curr_x, curr_y, curr_dir), path_actions = q.popleft()\n\n      # Check if the current state is one of our desired collectable target states.\n      if (curr_x, curr_y, curr_dir) in collectable_target_states:\n          # If it is, we've found the shortest path. Append the USE action and return.\n          return path_actions + [ACTION_USE]\n\n      # Explore all possible next states by applying movement actions.\n      for action_taken in MOVEMENT_ACTIONS:\n          # Determine the agent's new direction and position after taking this action.\n          next_dir = ACTION_TO_RESULTING_DIR[action_taken]\n          dx_move, dy_move = DIR_DELTAS[next_dir]\n          \n          next_x, next_y = curr_x + dx_move, curr_y + dy_move\n\n          next_state = (next_x, next_y, next_dir)\n\n          # Check if the next cell is within grid boundaries, is traversable,\n          # and this specific (position, direction) state has not been visited yet.\n          if (0 <= next_x < grid_width and 0 <= next_y < grid_height and\n              traversable_mask[next_x, next_y] and\n              next_state not in visited_states):\n              \n              # Mark the new state as visited and add it to the queue for further exploration.\n              visited_states.add(next_state)\n              q.append((next_state, path_actions + [action_taken]))\n  \n  # If the BFS queue becomes empty and no path to a target state was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:24:35.203402", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Action constants (for env.step)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Agent direction constants\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  # Mapping from agent direction to (dx, dy) movement delta\n  # (dx, dy) is the change in (x, y) coordinates when moving in that direction.\n  DIR_DELTAS = {\n      DIR_UP: (0, -1),\n      DIR_RIGHT: (1, 0),\n      DIR_DOWN: (0, 1),\n      DIR_LEFT: (-1, 0),\n  }\n\n  # Reverse mapping: from (dx, dy) vector to the corresponding DIR_ constant.\n  # Used to find the required agent direction to face a specific adjacent cell.\n  VECTOR_TO_DIR = {v: k for k, v in DIR_DELTAS.items()}\n\n  # Mapping from movement action to the agent's resulting facing direction.\n  # In CraftWorld, moving also sets the agent's facing direction.\n  ACTION_TO_RESULTING_DIR = {\n      ACTION_UP: DIR_UP,\n      ACTION_RIGHT: DIR_RIGHT,\n      ACTION_DOWN: DIR_DOWN,\n      ACTION_LEFT: DIR_LEFT,\n  }\n\n  # List of all actions that involve movement.\n  MOVEMENT_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # 1. Get current state information from the environment.\n  obs = env.observations()\n  grid = obs['features_dict']['features_global'] # Full grid layout\n  \n  # Agent's current position (x, y) and facing direction.\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  current_dir = np.argmax(obs['features_dict']['direction'])\n\n  # Get world configuration, specifically indices of entities that block movement.\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n\n  grid_width, grid_height, _ = grid.shape\n\n  # 2. Determine traversable cells on the grid.\n  # A cell is traversable if it does not contain any non-grabbable (obstacle) entities.\n  # `grid[:, :, list(non_grabbable_indices)]` selects all layers corresponding to obstacles.\n  # `np.any(..., axis=2)` checks if any obstacle is present in a cell.\n  # The `~` operator inverts the boolean mask: True for traversable, False for obstacle.\n  traversable_mask = ~np.any(grid[:, :, list(non_grabbable_indices)] > 0, axis=2)\n  \n  # If the agent starts in an untraversable cell (e.g., inside a wall), no path is possible.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return []\n\n  # 3. Identify all grid locations where the target primitive exists.\n  primitive_locations_on_grid = []\n  # np.where returns (row_indices, col_indices) for elements matching the condition.\n  # Since grid is `(WIDTH, HEIGHT, K)`, row_indices are y-coordinates and col_indices are x-coordinates.\n  y_coords_of_primitive, x_coords_of_primitive = np.where(grid[:, :, primitive] > 0)\n  for x, y in zip(x_coords_of_primitive, y_coords_of_primitive):\n      primitive_locations_on_grid.append((x, y))\n\n  if not primitive_locations_on_grid:\n      return [] # Primitive not found anywhere on the map.\n\n  # 4. Identify \"collectable target states\" (agent_x, agent_y, agent_direction)\n  # A state from which ACTION_USE can successfully collect the primitive.\n  # This requires the agent to be adjacent to the primitive and facing it.\n  collectable_target_states = set()\n  \n  # Define relative positions (deltas from primitive to agent) for all four adjacent cells.\n  # E.g., (-1, 0) means the agent is one unit left of the primitive.\n  adjacent_agent_positions_relative_to_primitive = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n  \n  for p_x, p_y in primitive_locations_on_grid:\n      for dx_from_p, dy_from_p in adjacent_agent_positions_relative_to_primitive:\n          # Calculate the potential agent's position (a_x, a_y).\n          a_x, a_y = p_x + dx_from_p, p_y + dy_from_p\n\n          # Check boundary conditions and traversability for the agent's potential position.\n          if not (0 <= a_x < grid_width and 0 <= a_y < grid_height and traversable_mask[a_x, a_y]):\n              continue\n          \n          # Determine the vector from the agent's position to the primitive's position.\n          # The agent must be facing in this direction to interact.\n          vector_agent_to_primitive = (p_x - a_x, p_y - a_y)\n\n          # Look up the required agent direction for this vector using pre-computed map.\n          required_agent_dir = VECTOR_TO_DIR.get(vector_agent_to_primitive)\n          \n          # If a valid cardinal direction is found, add this (position, direction) state to targets.\n          if required_agent_dir is not None:\n              collectable_target_states.add((a_x, a_y, required_agent_dir))\n\n  if not collectable_target_states:\n      return [] # No valid states from which the primitive can be collected.\n\n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path to a target state.\n  # A state in BFS is defined by (agent_x, agent_y, agent_direction).\n  start_state = (current_pos_x, current_pos_y, current_dir)\n  \n  # Queue stores tuples: (current_state, list_of_actions_to_reach_current_state).\n  q = deque([(start_state, [])]) \n  \n  # Set to keep track of visited states to prevent cycles and redundant paths.\n  visited_states = {start_state}\n\n  while q:\n      (curr_x, curr_y, curr_dir), path_actions = q.popleft()\n\n      # If the current state is one of our target states, we've found the shortest path.\n      if (curr_x, curr_y, curr_dir) in collectable_target_states:\n          # Append the ACTION_USE to collect the primitive and return the full path.\n          return path_actions + [ACTION_USE]\n\n      # Explore all possible next states by applying movement actions.\n      for action_taken in MOVEMENT_ACTIONS:\n          # Determine the agent's new direction and position after taking this action.\n          next_dir = ACTION_TO_RESULTING_DIR[action_taken]\n          dx_move, dy_move = DIR_DELTAS[next_dir] # Delta based on the new direction\n          \n          next_x, next_y = curr_x + dx_move, curr_y + dy_move\n\n          next_state = (next_x, next_y, next_dir)\n\n          # Check if the next cell is within grid boundaries, is traversable,\n          # and this specific (position, direction) state has not been visited yet.\n          if (0 <= next_x < grid_width and 0 <= next_y < grid_height and\n              traversable_mask[next_x, next_y] and\n              next_state not in visited_states):\n              \n              # Mark the new state as visited and add it to the queue for further exploration.\n              visited_states.add(next_state)\n              q.append((next_state, path_actions + [action_taken]))\n  \n  # If the queue is exhausted and no path to a target state was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:26:05.723283", "function_name": "collect", "function_body": "  # Get the initial state from the CraftLab environment.\n  # CraftLab stores the current state in `_current_state`.\n  initial_craft_state = env._current_state\n\n  # 1. Check if the primitive is already in inventory.\n  # If the agent already has the primitive, no actions are needed.\n  if initial_craft_state.inventory[primitive] > 0:\n    return []\n\n  # BFS (Breadth-First Search) setup for pathfinding to the primitive.\n  # A state in our BFS queue will be a tuple:\n  # (current_position: tuple(int, int),\n  #  current_direction: int,\n  #  actions_taken_so_far: list[int])\n  queue = collections.deque([(initial_craft_state.pos, initial_craft_state.dir, [])])\n\n  # Keep track of visited states (position, direction) to avoid cycles and redundant computations.\n  # The grid content is assumed static for pathfinding purposes (i.e., before collecting the item).\n  visited = set([(initial_craft_state.pos, initial_craft_state.dir)])\n\n  # References to scenario and world are needed to construct temporary CraftState objects\n  # within the BFS for simulation.\n  scenario_ref = initial_craft_state.scenario\n  world_ref = initial_craft_state.world\n\n  # Define the possible movement actions.\n  movement_actions = [env_factory.Actions.DOWN, env_factory.Actions.UP,\n                      env_factory.Actions.LEFT, env_factory.Actions.RIGHT]\n\n  # The initial grid and inventory state are used as the basis for all simulated states\n  # during pathfinding. We make deep copies to ensure that the original state is not\n  # modified by the simulation, and each simulated state has its own mutable grid/inventory\n  # if CraftState.step were to modify them in place (though CraftState.step returns new objects).\n  initial_grid_copy = copy.deepcopy(initial_craft_state.grid)\n  initial_inventory_copy = copy.deepcopy(initial_craft_state.inventory)\n\n  while queue:\n    current_pos, current_dir, actions_so_far = queue.popleft()\n\n    # Create a temporary CraftState object to simulate the state at the current BFS node.\n    # This state allows us to use CraftState methods like `next_to` and `step` for simulation.\n    simulated_craft_state_at_node = env_factory.CraftState(\n        scenario=scenario_ref,\n        grid=initial_grid_copy,  # Use the original grid state for pathfinding\n        pos=current_pos,\n        dir=current_dir,\n        inventory=initial_inventory_copy  # Use original inventory state\n    )\n\n    # Check if the agent is currently adjacent to the primitive.\n    # If so, we've found a path to an adjacent location. The final action will be USE.\n    if simulated_craft_state_at_node.next_to(primitive):\n      # Return the sequence of actions to get adjacent, plus the USE action.\n      return actions_so_far + [env_factory.Actions.USE]\n\n    # Explore all possible movement actions from the current simulated state.\n    for action in movement_actions:\n      # Simulate applying the action. `step` returns a new CraftState object,\n      # representing the state after the action. The reward is not relevant for pathfinding.\n      _, next_simulated_craft_state = simulated_craft_state_at_node.step(action)\n\n      next_pos = next_simulated_craft_state.pos\n      next_dir = next_simulated_craft_state.dir\n\n      # If this new state (position and direction) has not been visited yet,\n      # add it to the queue for further exploration.\n      if (next_pos, next_dir) not in visited:\n        visited.add((next_pos, next_dir))\n        queue.append((next_pos, next_dir, actions_so_far + [action]))\n\n  # If the BFS queue becomes empty and no path to the primitive (or an adjacent cell) was found,\n  # it means the primitive is unreachable from the current position.\n  # In this case, return an empty list of actions.\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:26:06.706191", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = current_state.world\n  grid = current_state.grid\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  action_map = env.action_specs()\n\n  # Direction constants used internally by CraftState and for agent's facing direction:\n  # 0: North (UP)\n  # 1: East (RIGHT)\n  # 2: South (DOWN)\n  # 3: West (LEFT)\n\n  # Helper functions (nested to avoid polluting global namespace if not desired,\n  # or can be defined outside if they are general utilities)\n\n  def _get_grid_dims(grid):\n    return grid.shape\n\n  def _is_valid_coord(r, c, grid_shape):\n    rows, cols, _ = grid_shape\n    return 0 <= r < rows and 0 <= c < cols\n\n  def _is_walkable(grid, r, c, world):\n    if not _is_valid_coord(r, c, grid.shape):\n      return False\n    # Check if the cell contains an ungrabbable item that blocks movement.\n    # Assuming anything in world.non_grabbable_indices blocks movement.\n    for k in world.non_grabbable_indices:\n      if grid[r, c, k] > 0: # If the cell contains a non-grabbable entity\n        return False\n    return True # All other cells are walkable (e.g., empty, primitives, grabbable env items)\n\n  def _find_item_locations(grid, item_idx):\n    locations = []\n    rows, cols, _ = grid.shape\n    for r in range(rows):\n      for c in range(cols):\n        if grid[r, c, item_idx] > 0: # Check if the item is present in this cell\n          locations.append((r, c))\n    return locations\n\n  def _get_neighbors_coords(pos):\n    r, c = pos\n    # Returns coordinates for cells directly North, South, West, East\n    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]\n\n  def _get_move_action_and_new_dir(current_pos, next_pos, action_map):\n    curr_r, curr_c = current_pos\n    next_r, next_c = next_pos\n\n    if next_r < curr_r: # Move North\n      return action_map[\"UP\"], 0\n    elif next_r > curr_r: # Move South\n      return action_map[\"DOWN\"], 2\n    elif next_c < curr_c: # Move West\n      return action_map[\"LEFT\"], 3\n    elif next_c > curr_c: # Move East\n      return action_map[\"RIGHT\"], 1\n    return None, None # Should not happen for valid adjacent moves\n\n  def _get_direction_to_face(agent_pos, target_pos):\n    \"\"\"\n    Determines the direction an agent at agent_pos should face to look at target_pos.\n    Returns 0=N, 1=E, 2=S, 3=W.\n    \"\"\"\n    r_c, c_c = agent_pos\n    r_t, c_t = target_pos\n\n    if r_t < r_c: return 0 # Target is North\n    elif r_t > r_c: return 2 # Target is South\n    elif c_t < c_c: return 3 # Target is West\n    elif c_t > c_c: return 1 # Target is East\n    return -1 # Should ideally not be called if target is same cell\n\n  def _get_turn_actions_and_new_dir(current_dir, target_dir, action_map):\n    \"\"\"\n    Calculates the minimum turn actions to change from current_dir to target_dir.\n    Assumes directions are N=0, E=1, S=2, W=3.\n    \"\"\"\n    if current_dir == target_dir:\n      return [], current_dir\n\n    turns = []\n    # Calculate shortest rotation (clockwise or counter-clockwise)\n    # diff is number of right turns needed to reach target_dir from current_dir\n    diff = (target_dir - current_dir + 4) % 4\n\n    if diff == 1: # 90 deg clockwise (e.g., N->E)\n      turns.append(action_map[\"RIGHT\"])\n    elif diff == 2: # 180 deg (e.g., N->S) - can be two rights or two lefts, pick two rights\n      turns.append(action_map[\"RIGHT\"])\n      turns.append(action_map[\"RIGHT\"])\n    elif diff == 3: # 90 deg counter-clockwise (e.g., N->W)\n      turns.append(action_map[\"LEFT\"])\n    \n    return turns, target_dir\n\n  # --- Main logic for collect_v2 ---\n\n  # 1. Check if primitive is already collected\n  if current_state.inventory[primitive] > 0:\n      return [] # Already have it\n\n  # 2. Find all locations of the primitive on the grid\n  primitive_locations = _find_item_locations(grid, primitive)\n  if not primitive_locations:\n      return [] # Primitive not on the map\n\n  # 3. Identify all valid target agent positions (walkable cells adjacent to a primitive)\n  # A target state for the agent is defined by (agent_target_pos, primitive_location_to_face)\n  target_states = set() # Stores (agent_target_r, agent_target_c, primitive_r_to_face, primitive_c_to_face)\n  grid_shape = _get_grid_dims(grid)\n\n  for p_r, p_c in primitive_locations:\n      for n_r, n_c in _get_neighbors_coords((p_r, p_c)):\n          if _is_valid_coord(n_r, n_c, grid_shape) and _is_walkable(grid, n_r, n_c, world):\n              target_states.add((n_r, n_c, p_r, p_c))\n  \n  if not target_states:\n      return [] # No reachable positions next to primitive\n\n  # 4. BFS to find the shortest path to any target_agent_position\n  # Queue stores (current_agent_pos, current_simulated_dir, actions_taken_so_far)\n  q = collections.deque([(start_pos, start_dir, [])])\n  # Visited set stores (agent_pos, agent_dir) to avoid re-exploring the same agent state\n  visited = {(start_pos, start_dir)}\n  \n  while q:\n      curr_pos, curr_sim_dir, actions_taken = q.popleft()\n\n      # Check if this current position is one of our target agent positions\n      # We iterate through all potential targets to find the one matching curr_pos.\n      # Because BFS explores shortest paths first, the first one found is optimal.\n      for target_agent_r, target_agent_c, target_prim_r, target_prim_c in target_states:\n          if curr_pos == (target_agent_r, target_agent_c):\n              target_prim_loc = (target_prim_r, target_prim_c)\n              \n              # Calculate actions to face the primitive\n              target_facing_dir = _get_direction_to_face(curr_pos, target_prim_loc)\n              turn_actions, final_sim_dir = _get_turn_actions_and_new_dir(curr_sim_dir, target_facing_dir, action_map)\n              \n              # Combine movement, turn, and USE actions\n              full_path_actions = actions_taken + turn_actions + [action_map[\"USE\"]]\n              return full_path_actions # Found the shortest path, return immediately\n\n      # Explore neighbors: Try moving in all four cardinal directions\n      r, c = curr_pos\n      for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # North, South, West, East\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          if (_is_valid_coord(next_r, next_c, grid_shape) and\n              _is_walkable(grid, next_r, next_c, world)):\n              \n              # Determine the action to move to next_pos and the resulting simulated direction\n              move_action, next_sim_dir = _get_move_action_and_new_dir(curr_pos, next_pos, action_map)\n              \n              # Add to queue if this state (position + direction) has not been visited\n              if (next_pos, next_sim_dir) not in visited:\n                  visited.add((next_pos, next_sim_dir))\n                  q.append((next_pos, next_sim_dir, actions_taken + [move_action]))\n    \n  return [] # No path found to any primitive", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:27:13.338081", "function_name": "collect", "function_body": "  import collections\n  # Constants for actions as per CraftLab.action_specs\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n  CraftState = type(current_state) # Get the CraftState class dynamically\n\n  # (delta_row, delta_col, action_id)\n  movements = [\n      (-1, 0, UP),    # Move Up\n      (1, 0, DOWN),   # Move Down\n      (0, -1, LEFT),  # Move Left\n      (0, 1, RIGHT)   # Move Right\n  ]\n\n  queue = collections.deque([(start_pos, [])]) # (position, path_to_position)\n  visited = {start_pos}\n\n  while queue:\n    current_pos, current_path = queue.popleft()\n\n    # Create a dummy CraftState instance to check `next_to` for the current_pos\n    # We pass the original grid, direction, and inventory, only modifying the position for the check.\n    dummy_state = CraftState(\n        scenario=current_state.scenario,\n        grid=current_state.grid,\n        pos=current_pos,\n        dir=current_state.dir,\n        inventory=current_state.inventory\n    )\n\n    if dummy_state.next_to(primitive):\n      # Found a position adjacent to the primitive! Append USE action and return the path.\n      return current_path + [USE]\n\n    # Explore neighbors\n    for dr, dc, action in movements:\n      new_r, new_c = current_pos[0] + dr, current_pos[1] + dc\n      new_pos = (new_r, new_c)\n\n      # Check grid boundaries\n      if not (0 <= new_r < grid_height and 0 <= new_c < grid_width):\n        continue\n\n      # Check if already visited\n      if new_pos in visited:\n        continue\n\n      visited.add(new_pos)\n      new_path = current_path + [action]\n      queue.append((new_pos, new_path))\n\n  # If the queue is empty and no path was found (primitive is unreachable or doesn't exist)\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:27:14.302769", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (assuming standard DMLab Craft actions)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Direction vectors corresponding to CraftWorld's N, E, S, W (0, 1, 2, 3)\n  _DIRECTIONS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # (dr, dc) for N, E, S, W\n\n  # Mapping from (dr, dc) movement vector to CraftWorld direction index\n  _DRDC_TO_DIR_IDX = {\n      (-1, 0): 0,  # North (UP)\n      (0, 1): 1,   # East (RIGHT)\n      (1, 0): 2,   # South (DOWN)\n      (0, -1): 3   # West (LEFT)\n  }\n\n  # Mapping from (dr, dc) movement vector to CraftWorld action\n  _DRDC_TO_ACTION = {\n      (-1, 0): UP,\n      (1, 0): DOWN,\n      (0, -1): LEFT,\n      (0, 1): RIGHT\n  }\n\n  def _get_turns(current_dir, target_dir):\n      \"\"\"Returns a list of actions (LEFT/RIGHT) to turn from current_dir to target_dir.\"\"\"\n      if current_dir == target_dir:\n          return []\n\n      turns = []\n      # Calculate difference, normalized to [0, 3] to handle wraps around\n      # e.g., N(0) to W(3) is -1 or +3\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1:  # 90 deg clockwise (e.g., N->E)\n          turns.append(RIGHT)\n      elif diff == 2:  # 180 deg (e.g., N->S). Can be two rights or two lefts.\n          turns.append(RIGHT)\n          turns.append(RIGHT)\n      elif diff == 3:  # 90 deg counter-clockwise (e.g., N->W)\n          turns.append(LEFT)\n      return turns\n\n  # 1. Check if primitive is already collected\n  current_state = env._current_state\n  if current_state.satisfies(None, primitive):\n      return []  # Already have it, no actions needed\n\n  # 2. Get current grid, agent position, and direction\n  grid = current_state.grid\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  grid_h, grid_w, n_kinds = grid.shape\n\n  # 3. Find all locations of the primitive on the grid\n  primitive_locations = []\n  for r in range(grid_h):\n      for c in range(grid_w):\n          if grid[r, c, primitive] > 0:  # Assuming > 0 means present\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      return []  # Primitive not found on the map\n\n  # 4. BFS to find the shortest path from agent's start_pos to a cell adjacent to the primitive\n  # Queue stores (current_pos, path_to_current_pos)\n  queue = collections.deque([(start_pos, [])])\n  # Visited set to prevent cycles and re-processing\n  visited = {start_pos}\n\n  # Variables to store the found path and target primitive location\n  goal_adjacent_pos = None\n  path_to_goal_adjacent = None\n  target_primitive_location = None\n\n  while queue:\n      (r, c), path_so_far = queue.popleft()\n\n      # Check if current (r, c) is adjacent to any primitive location\n      # This is the goal condition for our BFS: find a cell from which we can USE the primitive.\n      for pr, pc in primitive_locations:\n          if abs(r - pr) + abs(c - pc) == 1:  # Manhattan distance of 1 means adjacent\n              goal_adjacent_pos = (r, c)\n              path_to_goal_adjacent = path_so_far[:]  # Copy the path\n              path_to_goal_adjacent.append((r, c))  # Add the current adjacent position\n              target_primitive_location = (pr, pc)\n              break\n      if goal_adjacent_pos:\n          break  # Found a path to an adjacent cell, exit BFS\n\n      # Explore valid neighbors\n      for dr, dc in _DIRECTIONS:  # Iterate N, E, S, W moves\n          nr, nc = r + dr, c + dc\n\n          # Check grid bounds and if cell has been visited\n          if 0 <= nr < grid_h and 0 <= nc < grid_w and (nr, nc) not in visited:\n              # In CraftWorld, agents can generally move through most items unless they are\n              # specific \"wall\" entities. Assuming all cells are traversable for movement.\n              visited.add((nr, nc))\n              new_path = path_so_far[:]\n              new_path.append((r, c)) # Add the current position to the path leading to neighbor\n              queue.append(((nr, nc), new_path))\n\n  if not goal_adjacent_pos:\n      return []  # No path found to any cell adjacent to the primitive\n\n  # 5. Convert the path of positions into a sequence of agent actions\n  actions = []\n  current_pos = start_pos\n  current_dir = start_dir\n\n  # path_to_goal_adjacent contains [start_pos, pos1, pos2, ..., goal_adjacent_pos]\n  # We start from the first step after start_pos.\n  for next_pos in path_to_goal_adjacent[1:]:\n      dr, dc = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n\n      # Determine the direction the agent needs to face to make this move\n      required_move_dir = _DRDC_TO_DIR_IDX.get((dr, dc))\n      if required_move_dir is None:\n          # This indicates an invalid path segment (e.g., diagonal move not supported)\n          # Should not happen with _DIRECTIONS and BFS, but good for robustness.\n          return [] \n\n      # Add turn actions if current direction does not match required move direction\n      actions.extend(_get_turns(current_dir, required_move_dir))\n      \n      # Add the movement action\n      move_action = _DRDC_TO_ACTION.get((dr, dc))\n      if move_action is None:\n          # Should not happen\n          return []\n\n      actions.append(move_action)\n      \n      # Update current position and direction for the next step\n      current_pos = next_pos\n      current_dir = required_move_dir\n\n  # 6. After reaching goal_adjacent_pos, add turn and USE action\n  # current_pos is now goal_adjacent_pos, and current_dir is the last facing direction.\n\n  # Calculate the vector from agent's current_pos to the target primitive\n  dr_use, dc_use = target_primitive_location[0] - current_pos[0], target_primitive_location[1] - current_pos[1]\n  \n  # Determine the direction the agent needs to face to USE the primitive\n  required_use_dir = _DRDC_TO_DIR_IDX.get((dr_use, dc_use))\n  if required_use_dir is None:\n      # This implies the target_primitive_location is not directly adjacent,\n      # which contradicts how goal_adjacent_pos was found.\n      return []\n\n  # Add turns to face the primitive\n  actions.extend(_get_turns(current_dir, required_use_dir))\n  \n  # Finally, add the USE action\n  actions.append(USE)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:28:16.226831", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:28:17.207896", "function_name": "collect", "function_body": "  from collections import deque\n\n  actions_taken = []\n  \n  # Get action integer IDs from the environment's action_specs\n  action_map = env.action_specs()\n  \n  # Get references to world for item type information\n  world = env.world\n  \n  # Define a reasonable max number of steps to prevent infinite loops\n  MAX_COLLECT_STEPS = 200 \n\n  # Map movement actions to (dx, dy) coordinate changes for BFS\n  # CraftWorld agent position `pos` is (column, row).\n  # UP: decreases row (y), column (x) stays same -> (0, -1)\n  # DOWN: increases row (y), column (x) stays same -> (0, 1)\n  # LEFT: decreases column (x), row (y) stays same -> (-1, 0)\n  # RIGHT: increases column (x), row (y) stays same -> (1, 0)\n  move_deltas = {\n      action_map['UP']: (0, -1),\n      action_map['DOWN']: (0, 1),\n      action_map['LEFT']: (-1, 0),\n      action_map['RIGHT']: (1, 0),\n  }\n  \n  # Helper to check if a position is within grid bounds\n  def _is_valid_pos(x, y, grid_shape):\n      width, height, _ = grid_shape\n      return 0 <= x < width and 0 <= y < height\n\n  # Helper function to find the shortest path to a cell adjacent to the target primitive\n  def _find_path_to_adjacent(start_pos, target_kind_idx, current_grid, grid_shape):\n      \"\"\"\n      Performs a BFS to find the shortest sequence of movement actions from start_pos\n      to any cell that is adjacent (8-directional) to an instance of target_kind_idx.\n      Returns the list of actions or None if no such path exists.\n      \"\"\"\n      queue = deque([(start_pos[0], start_pos[1], [])]) # (x, y, path_of_actions_to_reach_here)\n      visited = {(start_pos[0], start_pos[1])} # Keep track of visited positions to avoid cycles\n      \n      while queue:\n          px, py, path_so_far = queue.popleft()\n\n          # Check if the current BFS position (px, py) is adjacent to the primitive\n          is_adjacent_to_primitive = False\n          # Iterate over a 3x3 neighborhood, excluding the current cell (px, py) itself\n          for dx_nb in [-1, 0, 1]:\n              for dy_nb in [-1, 0, 1]:\n                  if dx_nb == 0 and dy_nb == 0: # Skip the current cell\n                      continue\n                  nx_nb, ny_nb = px + dx_nb, py + dy_nb\n                  if _is_valid_pos(nx_nb, ny_nb, grid_shape) and current_grid[nx_nb, ny_nb, target_kind_idx] == 1:\n                      is_adjacent_to_primitive = True\n                      break\n              if is_adjacent_to_primitive:\n                  break\n          \n          if is_adjacent_to_primitive:\n              # This (px, py) is a target position for the agent to move to.\n              # path_so_far is the shortest sequence of actions to reach this position.\n              return path_so_far # Path found, exit BFS\n              \n          # Explore valid and unvisited neighboring cells for movement\n          for action_val, (dx, dy) in move_deltas.items():\n              next_x, next_y = px + dx, py + dy\n              if _is_valid_pos(next_x, next_y, grid_shape) and (next_x, next_y) not in visited:\n                  visited.add((next_x, next_y))\n                  queue.append((next_x, next_y, path_so_far + [action_val]))\n      \n      return None # No path found to any cell adjacent to the primitive\n\n  # Check if the primitive is a known grabbable item.\n  # If it's not grabbable, this function cannot collect it.\n  if primitive not in world.grabbable_indices:\n      return []\n\n  path_to_primitive_adj = None # Stores the pre-computed sequence of movement actions\n\n  # Main loop for finding and collecting the primitive\n  for _ in range(MAX_COLLECT_STEPS):\n    current_state = env._current_state # Direct access to the internal CraftState\n    \n    # 1. Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n      return actions_taken # Goal achieved\n\n    # 2. Check if the agent is currently next to the primitive, and if so, orient and use it\n    primitive_location_nearby = None\n    agent_x, agent_y = current_state.pos\n    grid = current_state.grid # Use the current grid state for checks\n    \n    # Iterate through 3x3 neighborhood (excluding center) to find primitive\n    for dx_nb in [-1, 0, 1]:\n        for dy_nb in [-1, 0, 1]:\n            if dx_nb == 0 and dy_nb == 0: # Skip agent's own cell (agent is not 'next to' itself)\n                continue\n            \n            nx_nb, ny_nb = agent_x + dx_nb, agent_y + dy_nb\n            if _is_valid_pos(nx_nb, ny_nb, grid.shape) and grid[nx_nb, ny_nb, primitive] == 1:\n                primitive_location_nearby = (nx_nb, ny_nb)\n                break\n        if primitive_location_nearby:\n            break\n            \n    if primitive_location_nearby:\n        # Agent is next to a primitive. Now orient and USE.\n        target_x, target_y = primitive_location_nearby\n        \n        # Calculate required direction from agent_x, agent_y to target_x, target_y\n        dx_rel = target_x - agent_x\n        dy_rel = target_y - agent_y\n\n        required_dir = -1\n        # Map (dx, dy) to a direction integer (0=N, 1=E, 2=S, 3=W)\n        if dy_rel < 0: # Target is North (UP)\n            required_dir = 0\n        elif dx_rel > 0: # Target is East (RIGHT)\n            required_dir = 1\n        elif dy_rel > 0: # Target is South (DOWN)\n            required_dir = 2\n        elif dx_rel < 0: # Target is West (LEFT)\n            required_dir = 3\n        \n        # Orient the agent if not already facing the required direction\n        current_dir = current_state.dir\n        episode_done = False\n        if required_dir != -1: # Ensure a valid target direction was found\n            while current_dir != required_dir:\n                # Calculate shorter turn (right or left)\n                turn_right_steps = (required_dir - current_dir + 4) % 4\n                turn_left_steps = (current_dir - required_dir + 4) % 4\n\n                turn_action = action_map['RIGHT'] if turn_right_steps <= turn_left_steps else action_map['LEFT']\n                \n                _reward, done, _observations = env.step(turn_action)\n                actions_taken.append(turn_action)\n                current_state = env._current_state # Update state after turn\n                current_dir = current_state.dir\n                if done:\n                    episode_done = True\n                    break\n        \n        if episode_done:\n            break # Break from main loop if episode ended during turning\n\n        # Now agent is oriented (or was already), perform USE\n        _reward, done, _observations = env.step(action_map['USE'])\n        actions_taken.append(action_map['USE'])\n        path_to_primitive_adj = None # Invalidate the path, as the primitive might have been collected or grid changed\n        if done:\n            break # Episode finished\n        continue # Successfully used, go to next iteration to re-check inventory immediately\n\n    # 3. Path Planning or Path Following\n    if path_to_primitive_adj is None or len(path_to_primitive_adj) == 0:\n        # If no path is currently planned or the existing path is exhausted, find a new one\n        path_to_primitive_adj = _find_path_to_adjacent(\n            current_state.pos, \n            primitive, \n            current_state.grid, \n            current_state.grid.shape\n        )\n        \n        if path_to_primitive_adj is None:\n            # If no path can be found to the primitive, it's unreachable or doesn't exist.\n            break # Cannot collect\n\n    # 4. Execute the next action in the pre-computed path\n    if path_to_primitive_adj: # Check if path is not empty after potential replanning\n        action_to_take = path_to_primitive_adj.pop(0) # Take the first step and remove it from the planned path\n        _reward, done, _observations = env.step(action_to_take)\n        actions_taken.append(action_to_take)\n        \n        # If the environment indicates the episode is done (e.g., max_steps reached)\n        if done:\n          break\n    else:\n        # This branch should ideally not be reached if the logic for `path_to_primitive_adj is None or len(...) == 0`\n        # and the subsequent `_find_path_to_adjacent` call are working correctly.\n        break\n            \n  return actions_taken", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:30:03.662863", "function_name": "collect", "function_body": "  import collections\n\n  # Constants for actions (as per CraftLab action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Directional vectors for actions (dx, dy) on a grid where x is column, y is row.\n  # (0,0) is typically top-left. UP decreases y, DOWN increases y.\n  # LEFT decreases x, RIGHT increases x.\n  DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Mapping from action to the direction the agent faces after the move.\n  # Standard DMLab directions: 0: North, 1: East, 2: South, 3: West.\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,    # Moving UP (North) sets direction to North\n      ACTION_RIGHT: 1, # Moving RIGHT (East) sets direction to East\n      ACTION_DOWN: 2,  # Moving DOWN (South) sets direction to South\n      ACTION_LEFT: 3   # Moving LEFT (West) sets direction to West\n  }\n\n  # Mapping from direction to its corresponding delta vector (dx, dy).\n  # Used to determine (px, py) relative to (ax, ay) given face_dir.\n  DIR_TO_DELTA = {\n      0: (0, -1), # North\n      1: (1, 0),  # East\n      2: (0, 1),  # South\n      3: (-1, 0)  # West\n  }\n\n  # Get current state information from the environment\n  obs = env.observations()\n  current_grid = obs['features_dict']['features_global'] # Grid: (WIDTH, HEIGHT, n_kinds)\n  \n  # Extract grid dimensions\n  grid_width, grid_height, _ = current_grid.shape\n  \n  # Convert normalized agent position to integer grid coordinates\n  start_x_norm, start_y_norm = obs['features_dict']['pos']\n  start_x = int(round(start_x_norm * grid_width))\n  start_y = int(round(start_y_norm * grid_height))\n  \n  # Get current agent direction (one-hot vector converted to integer)\n  current_dir = np.argmax(obs['features_dict']['direction'])\n\n  world = env.world\n  # Get indices of non-grabbable entities (obstacles)\n  non_grabbables = world.non_grabbable_indices\n\n  # Helper function to check if a cell is an obstacle (out of bounds or contains non-grabbable)\n  def is_obstacle(x, y):\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return True # Out of bounds\n      # Check if the cell contains any non-grabbable obstacle\n      for ng_idx in non_grabbables:\n          if current_grid[x, y, ng_idx] > 0:\n              return True # Contains non-grabbable\n      return False\n\n  # Find all locations on the grid where the target primitive exists\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if current_grid[x, y, primitive] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # Primitive not found anywhere on the map\n      return []\n\n  # Define target states for the BFS. A target state is (ax, ay, required_dir),\n  # meaning the agent needs to reach position (ax, ay) and be facing `required_dir`\n  # to be able to successfully USE the primitive.\n  target_bfs_states = set()\n  for px, py in primitive_locations:\n      # For each primitive (px, py), consider the four adjacent cells (ax, ay)\n      # from which the agent can \"USE\" it.\n      for face_dir, (dx, dy) in DIR_TO_DELTA.items():\n          # (ax, ay) is the cell the agent needs to be at, such that (px, py) is in direction (dx, dy)\n          ax, ay = px - dx, py - dy\n          \n          # Only add if the approach cell (ax, ay) is not an obstacle\n          if not is_obstacle(ax, ay):\n              target_bfs_states.add((ax, ay, face_dir))\n\n  if not target_bfs_states:\n      # No reachable positions from which the primitive can be collected\n      return []\n\n  # Initialize BFS queue: (current_x, current_y, current_direction, list_of_actions_taken)\n  queue = collections.deque([(start_x, start_y, current_dir, [])])\n  # Initialize set to keep track of visited states to prevent cycles and redundant paths\n  # A state is defined by (x, y, direction)\n  visited = set([(start_x, start_y, current_dir)])\n  \n  found_path_actions = []\n\n  # Perform BFS\n  while queue:\n      cx, cy, c_dir, c_actions = queue.popleft()\n\n      # Check if the current state is one of our target states\n      if (cx, cy, c_dir) in target_bfs_states:\n          # Path found! Add the final USE action\n          found_path_actions = c_actions + [ACTION_USE]\n          break # Exit BFS as soon as the first (shortest) path is found\n\n      # Explore possible next states by taking each movement action\n      for action in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n          dx, dy = DELTAS[action]\n          nx, ny = cx + dx, cy + dy # New position after action\n          new_dir = ACTION_TO_DIR[action] # New direction after this action\n\n          # Check if the new position is valid (not an obstacle)\n          if not is_obstacle(nx, ny):\n              # Check if this state has already been visited with this direction\n              if (nx, ny, new_dir) not in visited:\n                  visited.add((nx, ny, new_dir))\n                  queue.append((nx, ny, new_dir, c_actions + [action]))\n  \n  return found_path_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:30:03.732788", "function_name": "collect", "function_body": "    # 1. Get initial state information\n    obs = env.observations()\n    grid = obs['features_dict']['features_global']\n    pos_norm = obs['features_dict']['pos']\n    inventory = obs['features_dict']['inventory']\n\n    # Check if primitive is already collected\n    if inventory[primitive] > 0:\n        return []\n\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n    \n    # Convert normalized position to integer grid coordinates\n    current_x = int(pos_norm[0] * WIDTH)\n    current_y = int(pos_norm[1] * HEIGHT)\n    start_pos = (current_x, current_y)\n\n    # Get non-grabbable indices from the world configuration to identify obstacles\n    # CraftLab has a 'world' attribute, which is a CraftWorld instance.\n    # CraftWorld has 'non_grabbable_indices' which represents impassable terrain/items.\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # Define movement deltas for cardinal directions\n    # These correspond to the spatial changes for UP, DOWN, LEFT, RIGHT actions\n    move_deltas = [\n        (0, -1), # UP: (x, y-1)\n        (0, 1),  # DOWN: (x, y+1)\n        (-1, 0), # LEFT: (x-1, y)\n        (1, 0)   # RIGHT: (x+1, y)\n    ]\n    \n    # Map deltas back to actions for path reconstruction\n    action_map = {\n        (0, -1): UP,\n        (0, 1): DOWN,\n        (-1, 0): LEFT,\n        (1, 0): RIGHT\n    }\n\n    # Collect all cells containing the primitive\n    primitive_cells = set()\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] > 0:\n                primitive_cells.add((x, y))\n\n    if not primitive_cells:\n        # Primitive not found in the grid, cannot collect\n        return []\n\n    # Calculate all valid 'interaction' cells. These are cells from which the agent\n    # can 'USE' to collect the primitive. This includes cells directly containing\n    # the primitive (if traversable) or cells adjacent to the primitive.\n    target_interaction_cells = set()\n\n    for px, py in primitive_cells:\n        # First, consider if the agent can stand *on* the primitive cell itself\n        is_primitive_cell_blocked = False\n        for kind_idx in non_grabbable_indices:\n            # If the cell contains any non-grabbable item (like water or a wall),\n            # it's blocked, unless that item *is* the primitive itself and it's collectible by standing on it.\n            # Assuming 'primitive' is always a grabbable resource and not in non_grabbable_indices.\n            if grid[px, py, kind_idx] > 0:\n                is_primitive_cell_blocked = True\n                break\n        \n        if not is_primitive_cell_blocked:\n            target_interaction_cells.add((px, py))\n\n        # Second, consider cells adjacent to the primitive (for interacting with items like trees)\n        for dx, dy in move_deltas:\n            ax, ay = px + dx, py + dy # Adjacent cell coordinates\n            \n            # Check if adjacent cell is within grid bounds\n            if 0 <= ax < WIDTH and 0 <= ay < HEIGHT:\n                # Check if the adjacent cell is traversable (not blocked by a non-grabbable item)\n                is_adj_cell_blocked = False\n                for kind_idx in non_grabbable_indices:\n                    if grid[ax, ay, kind_idx] > 0:\n                        is_adj_cell_blocked = True\n                        break\n                \n                if not is_adj_cell_blocked:\n                    target_interaction_cells.add((ax, ay))\n    \n    if not target_interaction_cells:\n        # No reachable interaction cells for the primitive (e.g., primitive is surrounded by obstacles)\n        return []\n\n    # 3. Perform a Breadth-First Search (BFS) to find the shortest path\n    # from the agent's start_pos to any of the target_interaction_cells.\n    q = collections.deque()\n    q.append((start_pos, [])) # Queue stores: ((current_x, current_y), list_of_actions_to_reach_here)\n    \n    visited = {start_pos} # Keep track of visited (x,y) positions to avoid cycles and redundant paths\n\n    found_path_actions = None # Store the path once a target is reached\n\n    while q:\n        (cx, cy), current_path = q.popleft()\n\n        # If current position is one of the target interaction cells, we found the shortest path\n        if (cx, cy) in target_interaction_cells:\n            found_path_actions = current_path\n            break\n            \n        # Explore neighbors\n        for dx, dy in move_deltas:\n            nx, ny = cx + dx, cy + dy # New cell coordinates\n\n            # Check if new cell is within bounds and has not been visited yet\n            if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT) or (nx, ny) in visited:\n                continue\n\n            # Check if the new cell `(nx, ny)` is blocked by a non-grabbable item\n            is_blocked = False\n            for kind_idx in non_grabbable_indices:\n                if grid[nx, ny, kind_idx] > 0:\n                    is_blocked = True\n                    break\n            \n            if not is_blocked:\n                # If traversable, add to queue and mark as visited\n                action_to_take = action_map[(dx, dy)]\n                q.append(((nx, ny), current_path + [action_to_take]))\n                visited.add((nx, ny))\n\n    if found_path_actions is not None:\n        # If a path was found, append the 'USE' action to perform the collection\n        return found_path_actions + [USE]\n    \n    # No path found to any interaction cell (e.g., primitive is in an unreachable area)\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:31:21.645338", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Direction constants (assuming 0=N, 1=E, 2=S, 3=W clockwise from North)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"Calculates the direction the agent needs to face to look at the item.\"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dy == 1 and dx == 0: return SOUTH_DIR\n    if dy == -1 and dx == 0: return NORTH_DIR\n    return None # Should not happen if agent_pos and item_pos are cardinally adjacent\n\n  # Helper function: Checks if a cell is traversable (no non-grabbable items)\n  def _is_traversable(grid, x, y, non_grabbable_indices, grid_width, grid_height):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-grabbable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item (obstacle) is at (y, x)\n    for k_idx in non_grabbable_indices:\n      if grid[y, x, k_idx] == 1:\n        return False\n    return True\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Check if the primitive is already in inventory.\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Get non-grabbable indices for traversability check\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Prepare BFS goal states: (agent_x, agent_y, agent_facing_dir)\n  # These are the states from which the 'USE' action can be performed to collect the primitive.\n  bfs_target_agent_states = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells for the agent to stand on\n    # (dx_adj, dy_adj) represents the relative position of the agent to the item.\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Left, Right, Up, Down relative to item\n      adj_x, adj_y = item_x + dx_adj, item_y + dy_adj\n\n      if _is_traversable(grid, adj_x, adj_y, non_grabbable_indices, grid_width, grid_height):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_target_agent_states.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_target_agent_states:\n    return [] # No traversable adjacent positions from which to collect the primitive\n\n  # BFS setup\n  # Queue stores (x, y, dir) tuples representing agent's state\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Parent map to reconstruct the path: {child_state: (parent_state, action_to_child)}\n  parent_map = {} \n  \n  found_goal_state = None # Stores the (x, y, dir) of the goal state once found\n\n  # Movement actions and their effects: (dx, dy, resulting_direction)\n  # Based on `CraftLab.action_specs` and `CraftState.step` implying `direction` updates,\n  # we assume movement actions also implicitly set the agent's facing direction to match the movement.\n  movement_actions_effect = {\n      UP_ACTION: (0, -1, NORTH_DIR),    # Move North (dy=-1), face North\n      DOWN_ACTION: (0, 1, SOUTH_DIR),   # Move South (dy=1), face South\n      LEFT_ACTION: (-1, 0, WEST_DIR),   # Move West (dx=-1), face West\n      RIGHT_ACTION: (1, 0, EAST_DIR)    # Move East (dx=1), face East\n  }\n  \n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state is one of the goal states\n    if (curr_x, curr_y, curr_dir) in bfs_target_agent_states:\n      found_goal_state = (curr_x, curr_y, curr_dir)\n      break # Found the shortest path to a goal\n\n    # Explore all possible movement actions from the current state\n    for action, (dx, dy, next_dir_from_move) in movement_actions_effect.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = next_dir_from_move # Direction is directly determined by the movement action\n\n      next_state = (next_x, next_y, next_dir)\n      \n      # Check if the next cell is traversable and the state hasn't been visited\n      if _is_traversable(grid, next_x, next_y, non_grabbable_indices, grid_width, grid_height):\n        if next_state not in visited:\n          visited.add(next_state)\n          parent_map[next_state] = ((curr_x, curr_y, curr_dir), action)\n          queue.append(next_state)\n    \n    # In this model, there are no separate \"turn-in-place\" actions.\n    # All turning is implicitly handled by the movement actions themselves,\n    # as they also set the agent's direction.\n\n  if found_goal_state is None:\n    return [] # No path found to any primitive's collection point\n\n  # Reconstruct the path from the goal state back to the initial state\n  actions = []\n  curr_state = found_goal_state\n  initial_state = (initial_agent_x, initial_agent_y, initial_agent_dir)\n\n  while curr_state != initial_state:\n    parent_state, action = parent_map[curr_state]\n    actions.insert(0, action) # Prepend action to build path in correct order\n    curr_state = parent_state\n  \n  # Finally, append the USE action after reaching the correct position and facing direction.\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:31:22.589062", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Direction constants (assuming 0=N, 1=E, 2=S, 3=W clockwise from North)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dy == 1 and dx == 0: return SOUTH_DIR\n    if dy == -1 and dx == 0: return NORTH_DIR\n    return None # Should not happen if agent_pos and item_pos are cardinally adjacent\n\n  # Helper function: Checks if a cell is traversable (no non-grabbable items)\n  def _is_traversable(grid, x, y, non_grabbable_indices, grid_width, grid_height):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item (obstacle) is at (x, y)\n    for k_idx in non_grabbable_indices:\n      if grid[y, x, k_idx] == 1:\n        return False\n    return True\n\n  # Get primitive's integer ID. Improvement: Handle cases where primitive name is not found.\n  primitive_id = env.world.cookbook.index.get(primitive)\n  if primitive_id is None:\n    # The primitive name is not recognized by the cookbook.\n    return []\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Check if the primitive is already in inventory.\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Get non-grabbable indices for traversability check\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Prepare BFS goal states: (agent_x, agent_y, agent_facing_dir)\n  # These are the states from which the 'USE' action can be performed to collect the primitive.\n  bfs_target_agent_states = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells for the agent to stand on\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (dx_adj, dy_adj) from item to agent\n      adj_x, adj_y = item_x + dx_adj, item_y + dy_adj\n\n      if _is_traversable(grid, adj_x, adj_y, non_grabbable_indices, grid_width, grid_height):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_target_agent_states.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_target_agent_states:\n    return [] # No traversable adjacent positions from which to collect the primitive\n\n  # BFS setup\n  # Queue stores (x, y, dir) tuples representing agent's state\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Parent map to reconstruct the path: {child_state: (parent_state, action_to_child)}\n  parent_map = {} \n  \n  found_goal_state = None # Stores the (x, y, dir) of the goal state once found\n\n  # Movement actions and their effects: (dx, dy, resulting_direction)\n  # This assumes movement actions directly set the agent's facing direction.\n  movement_actions_map = {\n      UP_ACTION: (0, -1, NORTH_DIR),\n      DOWN_ACTION: (0, 1, SOUTH_DIR),\n      LEFT_ACTION: (-1, 0, WEST_DIR),\n      RIGHT_ACTION: (1, 0, EAST_DIR)\n  }\n  \n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state is one of the goal states\n    if (curr_x, curr_y, curr_dir) in bfs_target_agent_states:\n      found_goal_state = (curr_x, curr_y, curr_dir)\n      break # Found the shortest path to a goal\n    \n    # Explore movement actions: agent moves and its direction is set by the movement\n    for action, (dx, dy, resulting_dir) in movement_actions_map.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = resulting_dir # Direction is fixed by the move action type\n\n      next_state = (next_x, next_y, next_dir)\n      if _is_traversable(grid, next_x, next_y, non_grabbable_indices, grid_width, grid_height):\n        if next_state not in visited:\n          visited.add(next_state)\n          parent_map[next_state] = ((curr_x, curr_y, curr_dir), action)\n          queue.append(next_state)\n    \n    # Explore turning actions: agent changes direction without changing position\n    # The actions LEFT_ACTION and RIGHT_ACTION can be used for pure turns.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]: \n      next_x, next_y = curr_x, curr_y # Position does not change for a pure turn\n      \n      # Calculate new direction based on the turn action\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4 # Turn clockwise\n      \n      next_state = (next_x, next_y, next_dir)\n      if next_state not in visited: # No traversability check needed as position doesn't change\n        visited.add(next_state)\n        parent_map[next_state] = ((curr_x, curr_y, curr_dir), turn_action)\n        queue.append(next_state)\n\n  if found_goal_state is None:\n    return [] # No path found to any primitive's collection point\n\n  # Reconstruct the path from the goal state back to the initial state\n  actions = []\n  curr_state = found_goal_state\n  initial_state = (initial_agent_x, initial_agent_y, initial_agent_dir)\n\n  while curr_state != initial_state:\n    parent_state, action = parent_map[curr_state]\n    actions.insert(0, action) # Prepend action to build path in correct order\n    curr_state = parent_state\n  \n  # Finally, append the USE action after reaching the correct position and facing direction.\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:32:37.633650", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from CraftLab.action_specs)\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Direction constants (assuming 0=N, 1=E, 2=S, 3=W clockwise from North)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"Calculates the direction the agent needs to face from (agent_x, agent_y)\n    to look at (item_x, item_y).\n    \"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR # Item is to the right of agent\n    if dx == -1 and dy == 0: return WEST_DIR # Item is to the left of agent\n    if dy == 1 and dx == 0: return SOUTH_DIR # Item is below agent\n    if dy == -1 and dx == 0: return NORTH_DIR # Item is above agent\n    return None # Should not happen if agent_pos and item_pos are cardinally adjacent\n\n  # Helper function: Checks if a cell is traversable (no non-grabbable items)\n  def _is_traversable(grid, x, y, non_grabbable_indices, grid_width, grid_height):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain non-grabbable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item (obstacle) is at (y, x)\n    # Grid indexing is typically (row, col) which corresponds to (y, x)\n    for k_idx in non_grabbable_indices:\n      if grid[y, x, k_idx] == 1:\n        return False\n    return True\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Optimization: Check if the primitive is already in inventory.\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Get non-grabbable indices for traversability check\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Prepare BFS goal states: (agent_x, agent_y, agent_facing_dir)\n  # These are the states from which the 'USE' action can be performed to collect the primitive.\n  bfs_target_agent_states = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells for the agent to stand on.\n    # (dx_adj, dy_adj) represents the relative position of the agent to the item.\n    # For example, (-1, 0) means agent is one step left of the item.\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: \n      adj_x, adj_y = item_x + dx_adj, item_y + dy_adj\n\n      if _is_traversable(grid, adj_x, adj_y, non_grabbable_indices, grid_width, grid_height):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_target_agent_states.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_target_agent_states:\n    return [] # No traversable adjacent positions from which to collect the primitive\n\n  # BFS setup\n  # Queue stores (x, y, dir) tuples representing agent's state\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Parent map to reconstruct the path: {child_state: (parent_state, action_to_child)}\n  parent_map = {} \n  \n  found_goal_state = None # Stores the (x, y, dir) of the goal state once found\n\n  # Movement actions and their effects: (dx, dy, resulting_direction)\n  # This mapping defines how each cardinal movement action changes position and orientation.\n  # Based on common interpretations of CraftLab's action_specs, LEFT/RIGHT are assumed to be\n  # cardinal moves that also set the agent's facing direction. There are no separate \"turn in place\" actions.\n  movement_actions_effect = {\n      UP_ACTION: (0, -1, NORTH_DIR),    # Move North (dy=-1), face North\n      DOWN_ACTION: (0, 1, SOUTH_DIR),   # Move South (dy=1), face South\n      LEFT_ACTION: (-1, 0, WEST_DIR),   # Move West (dx=-1), face West\n      RIGHT_ACTION: (1, 0, EAST_DIR)    # Move East (dx=1), face East\n  }\n  \n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state is one of the goal states\n    if (curr_x, curr_y, curr_dir) in bfs_target_agent_states:\n      found_goal_state = (curr_x, curr_y, curr_dir)\n      break # Found the shortest path to a goal\n\n    # Explore all possible movement actions from the current state\n    for action, (dx, dy, next_dir_from_move) in movement_actions_effect.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = next_dir_from_move # Direction is directly determined by the movement action\n\n      next_state = (next_x, next_y, next_dir)\n      \n      # Check if the next cell is traversable and the state hasn't been visited\n      if _is_traversable(grid, next_x, next_y, non_grabbable_indices, grid_width, grid_height):\n        if next_state not in visited:\n          visited.add(next_state)\n          parent_map[next_state] = ((curr_x, curr_y, curr_dir), action)\n          queue.append(next_state)\n    \n  if found_goal_state is None:\n    return [] # No path found to any primitive's collection point\n\n  # Reconstruct the path from the goal state back to the initial state\n  actions = []\n  curr_state = found_goal_state\n  initial_state = (initial_agent_x, initial_agent_y, initial_agent_dir)\n\n  # Path reconstruction loop\n  # It will run as long as curr_state is not the initial_state, effectively building\n  # the path backwards from the goal to the start.\n  while curr_state != initial_state:\n    parent_state, action = parent_map[curr_state]\n    actions.insert(0, action) # Prepend action to build path in correct order\n    curr_state = parent_state\n  \n  # Finally, append the USE action after reaching the correct position and facing direction.\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
