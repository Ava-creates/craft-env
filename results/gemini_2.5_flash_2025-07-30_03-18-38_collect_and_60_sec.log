{"timestamp": "2025-07-30T10:11:46.281867", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  actions = []\n  \n  # Action constants (from problem description context)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction constants (matching internal representation: 0=N, 1=E, 2=S, 3=W)\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Map movement action values to (dx, dy) deltas\n  MOVEMENT_DELTAS = {\n      ACTION_UP: (0, -1),   # (dx, dy) for moving UP (North)\n      ACTION_DOWN: (0, 1),  # (dx, dy) for moving DOWN (South)\n      ACTION_LEFT: (-1, 0), # (dx, dy) for moving LEFT (West)\n      ACTION_RIGHT: (1, 0), # (dx, dy) for moving RIGHT (East)\n  }\n\n  # Map movement action values to the resulting agent direction\n  # This assumes that taking a movement action makes the agent face that direction.\n  ACTION_TO_DIRECTION = {\n      ACTION_UP: DIR_NORTH,\n      ACTION_RIGHT: DIR_EAST,\n      ACTION_DOWN: DIR_SOUTH,\n      ACTION_LEFT: DIR_WEST,\n  }\n\n  # Map (dx, dy) from agent's position to target cell to the required agent direction\n  RELATIVE_POS_TO_DIRECTION = {\n      (0, -1): DIR_NORTH, # Target is UP relative to agent -> agent must face North\n      (1, 0): DIR_EAST,   # Target is RIGHT relative to agent -> agent must face East\n      (0, 1): DIR_SOUTH,  # Target is DOWN relative to agent -> agent must face South\n      (-1, 0): DIR_WEST,  # Target is LEFT relative to agent -> agent must face West\n  }\n\n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Ensure position is int tuple. CraftState.pos is tuple(int, int)\n  # The features_dict['pos'] might be normalized or float, so convert to int tuple.\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  # Current direction is a one-hot array, convert to an integer (0=N, 1=E, 2=S, 3=W)\n  current_dir_one_hot = obs['features_dict']['direction']\n  current_dir = np.argmax(current_dir_one_hot)\n  \n  world = env.world\n  # non_grabbable_indices are assumed to be obstacles that cannot be traversed.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape\n\n  # 1. Determine traversable cells using NumPy for efficiency.\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  # Create a boolean array where True means the kind is non-grabbable.\n  is_obstacle_kind = np.isin(np.arange(K), list(non_grabbable_indices))\n  # Check if any non-grabbable kind has a count > 0 in any cell across the K-dimension.\n  has_obstacle = (grid[:, :, is_obstacle_kind] > 0).any(axis=-1)\n  # Invert the mask: where there's an obstacle, it's NOT traversable.\n  traversable_mask = ~has_obstacle\n  \n  # Check if the agent's start position is traversable. If not, no path possible.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return []\n\n  # 2. Determine target entity kinds that can be 'used' to obtain the 'primitive'.\n  target_kinds_for_use = {primitive} # Always include the primitive itself for direct pickup\n  \n  primitive_name = world.cookbook.index.get(primitive)\n  if primitive_name == 'water':\n      target_kinds_for_use.add(world.water_index) # Add water block index as a source\n  elif primitive_name == 'stone':\n      target_kinds_for_use.add(world.stone_index) # Add stone block index as a source\n  # Extend with more mappings if needed (e.g., 'wood' from a 'tree' block index)\n\n  # 3. Find all potential (agent_pos, agent_dir) states from which the agent can successfully USE to get the primitive.\n  # These are the \"goal states\" for our BFS.\n  target_pickup_states = set() # Stores elements as ((agent_x, agent_y), required_dir)\n  for item_x in range(W):\n      for item_y in range(H):\n          # Check if this cell contains any of our target kinds for use\n          contains_target_kind = False\n          for target_kind_idx in target_kinds_for_use:\n              if grid[item_x, item_y, target_kind_idx] > 0:\n                  contains_target_kind = True\n                  break\n          \n          if contains_target_kind:\n              # This cell (item_x, item_y) has an item/block we can use.\n              # Now, find all cardinal adjacent traversable cells from which an agent could USE it.\n              for dx_adj, dy_adj in [ (0, -1), (0, 1), (-1, 0), (1, 0) ]: # Cardinal neighbors relative to the item\n                  agent_x, agent_y = item_x + dx_adj, item_y + dy_adj\n                  \n                  if (0 <= agent_x < W and 0 <= agent_y < H and\n                      traversable_mask[agent_x, agent_y]): # Agent's potential position must be traversable\n                      \n                      # Calculate the direction the agent needs to face from (agent_x, agent_y) to (item_x, item_y)\n                      # This is (item_x - agent_x, item_y - agent_y)\n                      relative_item_pos = (item_x - agent_x, item_y - agent_y)\n                      required_dir = RELATIVE_POS_TO_DIRECTION.get(relative_item_pos)\n                      \n                      if required_dir is not None: # Should always be true for cardinal neighbors\n                          target_pickup_states.add(((agent_x, agent_y), required_dir))\n  \n  if not target_pickup_states:\n      return [] # No primitive found or no reachable pickup spots around it\n\n  # 4. Perform BFS to find the shortest sequence of actions to reach any target_pickup_state\n  # Queue stores (current_pos, current_dir, path_actions_so_far)\n  q = deque([(current_pos, current_dir, [])])\n  # Visited states are (position_tuple, direction_integer) to prevent redundant exploration\n  visited = {(current_pos, current_dir)} \n\n  while q:\n      curr_pos, curr_dir, path_so_far = q.popleft()\n\n      # Check if the current state (position, direction) is one of our goal states\n      if (curr_pos, curr_dir) in target_pickup_states:\n          return path_so_far + [ACTION_USE] # Path found, append USE action and return\n\n      # Explore possible actions: movements and turning in place\n      for action_val, (dx, dy) in MOVEMENT_DELTAS.items():\n          potential_next_pos = (curr_pos[0] + dx, curr_pos[1] + dy)\n          potential_next_dir = ACTION_TO_DIRECTION[action_val]\n\n          # Check if the next position is within grid bounds, traversable, and not yet visited.\n          if (0 <= potential_next_pos[0] < W and 0 <= potential_next_pos[1] < H and\n              traversable_mask[potential_next_pos[0], potential_next_pos[1]]):\n              # This is a valid movement to a new cell\n              next_pos_state = potential_next_pos\n              next_dir_state = potential_next_dir\n              if (next_pos_state, next_dir_state) not in visited:\n                  visited.add((next_pos_state, next_dir_state))\n                  q.append((next_pos_state, next_dir_state, path_so_far + [action_val]))\n          else:\n              # Movement is blocked (e.g., hitting a wall or non-grabbable obstacle) OR out of bounds.\n              # Agent stays at curr_pos but its direction changes to potential_next_dir.\n              next_pos_state = curr_pos\n              next_dir_state = potential_next_dir\n              # Only add if this (pos, dir) state is new\n              if (next_pos_state, next_dir_state) not in visited:\n                  visited.add((next_pos_state, next_dir_state))\n                  q.append((next_pos_state, next_dir_state, path_so_far + [action_val]))\n        \n  return [] # No path found to a pickup spot", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:11:47.261925", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Ensure position is int tuple. CraftState.pos is tuple(int, int)\n  # The features_dict['pos'] might be normalized or float, so convert to int tuple.\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  # Current direction is a one-hot array, convert to an integer (0=N, 1=E, 2=S, 3=W)\n  current_dir_one_hot = obs['features_dict']['direction']\n  current_dir = np.argmax(current_dir_one_hot)\n  \n  world = env.world\n  # non_grabbable_indices are assumed to be obstacles that cannot be traversed.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape\n\n  # Action constants (from problem description context)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction constants (matching internal representation: 0=N, 1=E, 2=S, 3=W)\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Map movement action values to (dx, dy) deltas\n  MOVEMENT_DELTAS = {\n      ACTION_UP: (0, -1),   # (dx, dy) for moving UP (North)\n      ACTION_DOWN: (0, 1),  # (dx, dy) for moving DOWN (South)\n      ACTION_LEFT: (-1, 0), # (dx, dy) for moving LEFT (West)\n      ACTION_RIGHT: (1, 0), # (dx, dy) for moving RIGHT (East)\n  }\n\n  # Map movement action values to the resulting agent direction\n  # This assumes that taking a movement action makes the agent face that direction.\n  ACTION_TO_DIRECTION = {\n      ACTION_UP: DIR_NORTH,\n      ACTION_RIGHT: DIR_EAST,\n      ACTION_DOWN: DIR_SOUTH,\n      ACTION_LEFT: DIR_WEST,\n  }\n\n  # Map (dx, dy) from agent's position to target cell to the required agent direction\n  # e.g., if the item is (0,1) relative to the agent's position, agent must face DOWN (South)\n  # This mapping is for cardinal neighbors only.\n  RELATIVE_POS_TO_DIRECTION = {\n      (0, -1): DIR_NORTH, # Target is UP relative to agent -> agent must face North\n      (1, 0): DIR_EAST,   # Target is RIGHT relative to agent -> agent must face East\n      (0, 1): DIR_SOUTH,  # Target is DOWN relative to agent -> agent must face South\n      (-1, 0): DIR_WEST,  # Target is LEFT relative to agent -> agent must face West\n  }\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  # Using NumPy's array operations for efficiency.\n  is_obstacle_kind = np.isin(np.arange(K), list(non_grabbable_indices))\n  # has_obstacle is a boolean (W, H) array where True means there's an obstacle\n  has_obstacle = (grid[:, :, is_obstacle_kind] > 0).any(axis=-1)\n  traversable_mask = ~has_obstacle\n  \n  # Check if the agent's start position is traversable. If not, no path possible.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return []\n\n  # 2. Determine target entity kinds that can be 'used' to obtain the 'primitive'.\n  # This includes the primitive itself (if found lying on the ground) and any source blocks\n  # from which the primitive can be harvested (e.g., water item from water block).\n  target_kinds_for_use = {primitive} # Always include the primitive itself for direct pickup\n  \n  # Check if the primitive is a resource that can be harvested from a specific block type\n  primitive_name = world.cookbook.index.get(primitive)\n  if primitive_name == 'water':\n      target_kinds_for_use.add(world.water_index) # Add water block index as a source\n  elif primitive_name == 'stone':\n      target_kinds_for_use.add(world.stone_index) # Add stone block index as a source\n  # Extend with more mappings here if other primitives have specific source blocks (e.g., 'wood' from 'tree')\n\n  # 3. Find all potential (agent_pos, agent_dir) states from which the agent can successfully USE to get the primitive.\n  # These are the \"goal states\" for our BFS.\n  target_pickup_states = set() # Stores elements as ((agent_x, agent_y), required_dir)\n  for item_x in range(W):\n      for item_y in range(H):\n          # Check if this cell contains any of our target kinds for use\n          contains_target_kind = False\n          for target_kind_idx in target_kinds_for_use:\n              if grid[item_x, item_y, target_kind_idx] > 0:\n                  contains_target_kind = True\n                  break\n          \n          if contains_target_kind:\n              # This cell (item_x, item_y) has an item/block we can use.\n              # Now, find all adjacent traversable cells from which an agent could USE it.\n              # Assuming 'USE' acts on a cardinal neighbor, requiring the agent to face it.\n              for dx_adj, dy_adj in [ (0, -1), (0, 1), (-1, 0), (1, 0) ]: # Cardinal neighbors relative to the item\n                  agent_x, agent_y = item_x + dx_adj, item_y + dy_adj\n                  \n                  # Check bounds and traversability for the potential agent position\n                  if (0 <= agent_x < W and 0 <= agent_y < H and\n                      traversable_mask[agent_x, agent_y]): \n                      \n                      # Calculate the direction the agent needs to face from (agent_x, agent_y) to (item_x, item_y)\n                      # This is (item_x - agent_x, item_y - agent_y)\n                      relative_item_pos = (item_x - agent_x, item_y - agent_y)\n                      required_dir = RELATIVE_POS_TO_DIRECTION.get(relative_item_pos)\n                      \n                      if required_dir is not None: \n                          target_pickup_states.add(((agent_x, agent_y), required_dir))\n  \n  if not target_pickup_states:\n      return [] # No primitive found or no reachable pickup spots around it\n\n  # 4. Perform BFS to find the shortest sequence of actions to reach any target_pickup_state\n  # Queue stores (current_pos, current_dir, path_actions_so_far)\n  q = deque([(current_pos, current_dir, [])])\n  # Visited states are (position_tuple, direction_integer) to prevent redundant exploration\n  visited = {(current_pos, current_dir)} \n\n  while q:\n      curr_pos, curr_dir, path_so_far = q.popleft()\n\n      # Check if the current state (position, direction) is one of our goal states\n      if (curr_pos, curr_dir) in target_pickup_states:\n          return path_so_far + [ACTION_USE] # Path found, append USE action and return\n\n      # Explore possible actions: movements and turning in place\n      for action_val, (dx, dy) in MOVEMENT_DELTAS.items():\n          potential_next_pos_x, potential_next_pos_y = curr_pos[0] + dx, curr_pos[1] + dy\n          potential_next_pos = (potential_next_pos_x, potential_next_pos_y)\n          potential_next_dir = ACTION_TO_DIRECTION[action_val]\n\n          # Check if the potential movement leads to a valid, traversable cell\n          if (0 <= potential_next_pos_x < W and 0 <= potential_next_pos_y < H and\n              traversable_mask[potential_next_pos_x, potential_next_pos_y]):\n              # This is a valid movement to a new cell\n              next_pos_state = potential_next_pos\n              next_dir_state = potential_next_dir\n              if (next_pos_state, next_dir_state) not in visited:\n                  visited.add((next_pos_state, next_dir_state))\n                  q.append((next_pos_state, next_dir_state, path_so_far + [action_val]))\n          else:\n              # Movement is blocked (e.g., hitting a wall or non-grabbable obstacle).\n              # Agent stays at curr_pos but its direction changes to potential_next_dir\n              # (assuming attempting a blocked move still changes facing direction based on CraftLab logic).\n              next_pos_state = curr_pos\n              next_dir_state = potential_next_dir\n              # Only add if this (pos, dir) state is new\n              if (next_pos_state, next_dir_state) not in visited:\n                  visited.add((next_pos_state, next_dir_state))\n                  q.append((next_pos_state, next_dir_state, path_so_far + [action_val]))\n        \n  return [] # No path found to a pickup spot", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:13:34.954402", "function_name": "collect", "function_body": "    actions = []\n    max_steps = 200  # A safety limit to prevent infinite loops\n\n    # Access the initial CraftState instance from the CraftLab environment\n    current_state = env._current_state\n\n    # Get grid dimensions from the initial state's grid. These are constant for a scenario.\n    WIDTH, HEIGHT, _ = current_state.grid.shape\n\n    # Initial check: Is the primitive already collected?\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    steps_taken = 0\n    while current_state.inventory[primitive] == 0 and steps_taken < max_steps:\n        # Check if the agent is already next to the primitive\n        if current_state.next_to(primitive):\n            # If next to it, attempt to use/collect it\n            _, new_state = env.step(ACTION_USE)\n            actions.append(ACTION_USE)\n            current_state = new_state\n            steps_taken += 1\n\n            # After trying to collect, immediately check inventory.\n            # If collected, we are done.\n            if current_state.inventory[primitive] > 0:\n                return actions\n            else:\n                # If the USE action didn't result in collection, it implies the primitive\n                # might not be grabbable, or requires a tool, or is not collected by simple USE.\n                # To prevent an infinite loop, break if USE fails despite being next to it.\n                break\n\n        # If not next to the primitive, find its location on the grid and plan movement\n        agent_x, agent_y = current_state.pos\n        grid = current_state.grid  # Use the latest grid state for finding the primitive\n\n        min_dist = float('inf')\n        best_primitive_loc = None\n\n        # Iterate over the grid to find the closest instance of the primitive\n        primitive_found_on_grid = False\n        for x in range(WIDTH):\n            for y in range(HEIGHT):\n                # Check if the cell contains the primitive\n                if grid[x, y, primitive] > 0:\n                    # Calculate Manhattan distance (L1 norm) for grid movement\n                    dist = abs(x - agent_x) + abs(y - agent_y)\n                    if dist < min_dist:\n                        min_dist = dist\n                        best_primitive_loc = (x, y)\n                        primitive_found_on_grid = True\n        \n        if not primitive_found_on_grid:\n            # If the primitive is no longer found on the grid, it's unreachable\n            # or has already been removed by other means (unlikely for a simple primitive task).\n            break \n\n        target_x, target_y = best_primitive_loc\n\n        # Determine the best movement action (greedy approach)\n        dx = target_x - agent_x\n        dy = target_y - agent_y\n\n        action_to_take = -1\n\n        # Only attempt to move if not already at the target exact cell\n        if dx != 0 or dy != 0:\n            # Prefer moving along the axis with the larger absolute distance.\n            # This helps in making more direct progress towards the target.\n            if abs(dx) >= abs(dy):\n                if dx > 0:\n                    action_to_take = ACTION_RIGHT\n                elif dx < 0:\n                    action_to_take = ACTION_LEFT\n            else:  # abs(dy) > abs(dx)\n                if dy > 0:\n                    action_to_take = ACTION_DOWN\n                elif dy < 0:\n                    action_to_take = ACTION_UP\n        \n        # If action_to_take is still -1, it means dx=0 and dy=0.\n        # This implies the agent is at the exact target cell.\n        # However, the `current_state.next_to(primitive)` check (before this block)\n        # returned False, which is contradictory if the primitive is collectable\n        # from its own cell or an adjacent one. This might indicate an uncollectable\n        # item or a specific game mechanic not covered by `next_to`.\n        if action_to_take == -1:\n            break\n\n        # Execute the chosen movement action\n        _, new_state = env.step(action_to_take)\n        actions.append(action_to_take)\n        current_state = new_state\n        steps_taken += 1\n\n    # Return the sequence of actions. If the goal wasn't met (e.g., max_steps reached,\n    # or primitive deemed uncollectable), it returns a partial list.\n    return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:13:35.972895", "function_name": "collect", "function_body": "  import collections\n\n  # _DELTAS maps (dx, dy) to action for an agent at (x,y)\n  # (dx, dy) where x is WIDTH dimension, y is HEIGHT dimension\n  _DELTAS = {\n      (0, -1): env_factory.UP,    # Moves from (x, y) to (x, y-1)\n      (0, 1): env_factory.DOWN,   # Moves from (x, y) to (x, y+1)\n      (-1, 0): env_factory.LEFT,  # Moves from (x, y) to (x-1, y)\n      (1, 0): env_factory.RIGHT,  # Moves from (x, y) to (x+1, y)\n  }\n\n  # Tuple for iterating over possible moves\n  _MOVE_DELTAS = [\n      (0, -1), # UP\n      (0, 1),  # DOWN\n      (-1, 0), # LEFT\n      (1, 0),  # RIGHT\n  ]\n\n  def _is_traversable(grid, check_pos, non_grabbable_indices):\n      \"\"\"\n      Checks if a given position on the grid is traversable by the agent.\n      A position is traversable if it's within bounds and does not contain\n      any non-grabbable entities.\n      \"\"\"\n      x, y = check_pos\n      # grid shape is (WIDTH, HEIGHT, n_kinds)\n      grid_width, grid_height, _ = grid.shape\n\n      # Check bounds:\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False\n\n      # Check for obstacles (non-grabbable items)\n      for k_idx in non_grabbable_indices:\n          if grid[x, y, k_idx] == 1:\n              return False\n      return True\n\n  def _bfs_find_path(start_pos, target_pos, grid, non_grabbable_indices):\n      \"\"\"\n      Finds the shortest path of movement actions from start_pos to target_pos\n      using Breadth-First Search (BFS).\n      Returns a list of actions (UP, DOWN, LEFT, RIGHT) or None if no path exists.\n      \"\"\"\n      q = collections.deque([(start_pos, [])]) # (current_pos, path_actions)\n      visited = {start_pos} # Set of visited positions to avoid cycles\n\n      while q:\n          current_pos, path_actions = q.popleft()\n\n          if current_pos == target_pos:\n              return path_actions\n\n          x, y = current_pos\n          # Explore 4-directional neighbors\n          for dx, dy in _MOVE_DELTAS:\n              next_pos = (x + dx, y + dy)\n              action_for_move = _DELTAS.get((dx, dy))\n\n              # Ensure a valid action mapping exists and the next position is traversable\n              if action_for_move is None:\n                  continue\n\n              if next_pos not in visited and _is_traversable(grid, next_pos, non_grabbable_indices):\n                  visited.add(next_pos)\n                  q.append((next_pos, path_actions + [action_for_move]))\n      return None # No path found\n\n  # 1. Get current state information from the environment\n  # Accessing internal _current_state of CraftLab for detailed state info\n  current_state = env._current_state\n  inventory = current_state.inventory\n  grid = current_state.grid # numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds)\n  agent_pos = current_state.pos # tuple (x, y)\n  world = current_state.world # Reference to CraftWorld instance\n  non_grabbable_indices = world.non_grabbable_indices # Set of indices for obstacles\n\n  # 2. Check if the primitive is already in inventory\n  if inventory[primitive] > 0:\n    return [] # Already collected, no actions needed\n\n  # 3. Find all locations of the primitive on the grid\n  primitive_locations = []\n  grid_width, grid_height, _ = grid.shape\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive] == 1: # Check if primitive is present at (x,y)\n        primitive_locations.append((x, y))\n\n  # 4. If no primitive found on the grid, return empty list\n  if not primitive_locations:\n    return []\n\n  # 5. Find the shortest path to an *adjacent* traversable cell of any primitive\n  # The agent needs to move next to the primitive, then USE.\n  best_path_actions = None\n  min_path_len = float('inf')\n\n  for prim_x, prim_y in primitive_locations:\n    # Consider 4 adjacent cells for each primitive location.\n    # These are potential target positions for the agent's movement.\n    for dx, dy in _MOVE_DELTAS: # Iterate over (dx, dy) for relative moves\n      target_adjacent_pos = (prim_x + dx, prim_y + dy)\n\n      if _is_traversable(grid, target_adjacent_pos, non_grabbable_indices):\n        # Find path from current agent_pos to this adjacent cell\n        path_to_adjacent = _bfs_find_path(agent_pos, target_adjacent_pos, grid, non_grabbable_indices)\n\n        if path_to_adjacent is not None:\n          # If a shorter path is found, update the best path\n          if len(path_to_adjacent) < min_path_len:\n            min_path_len = len(path_to_adjacent)\n            best_path_actions = path_to_adjacent\n\n  # 6. If no reachable primitive (i.e., no path found to any adjacent cell), return empty list\n  if best_path_actions is None:\n    return []\n\n  # 7. Construct the final sequence of actions\n  # First, execute the movement actions to reach the adjacent cell\n  result_actions = list(best_path_actions)\n  # Then, use the item. CraftState.next_to indicates USE works within a 3x3 neighborhood.\n  result_actions.append(env_factory.USE)\n\n  return result_actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:14:46.027196", "function_name": "collect", "function_body": "  from collections import deque\n\n  # --- 1. Define Action Constants and Movement Vectors ---\n  # These are standard actions within the CraftWorld environment.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Mapping of movement actions to their corresponding (dx, dy) changes.\n  MOVES = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # Offsets for checking the 3x3 neighborhood around the agent's position.\n  # This is crucial for the 'USE' action, which interacts with items/blocks\n  # in this vicinity, including the cell the agent is currently on (0,0).\n  NEIGHBORHOOD_OFFSETS = [\n      (dx, dy) for dx in [-1, 0, 1] for dy in [-1, 0, 1]\n  ]\n\n  # --- 2. Initialize State Information ---\n  # Retrieve current environment observations.\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  # Convert agent's position from numpy array to a tuple for use as dictionary keys/set elements in BFS.\n  current_agent_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  world = env.world\n  # Indices of entities that cannot be traversed (obstacles like water blocks, stone walls, workshops).\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, _ = grid.shape # Grid dimensions (Width, Height, Number of Kinds)\n\n  # --- 3. Determine Traversable Cells ---\n  # A cell is considered traversable if it does not contain any non-grabbable item.\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for x in range(W):\n      for y in range(H):\n          if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n              traversable_mask[x, y] = False\n  \n  # If the agent starts on an untraversable cell, no path is possible.\n  if not traversable_mask[current_agent_pos[0], current_agent_pos[1]]:\n      return [] \n\n  # --- 4. Identify Target Grid Indices for Collection ---\n  # These are the indices of blocks/items on the grid that, if present\n  # in the 3x3 neighborhood of the agent, allow the 'USE' action to collect\n  # the 'primitive' item.\n  \n  # Always include the primitive item itself. If it's on the ground, 'USE' can pick it up.\n  target_collect_block_indices = {primitive} \n\n  # Check for specific environmental blocks that yield the primitive item.\n  primitive_name = world.cookbook.index.get(primitive)\n  if primitive_name == 'water' and world.water_index is not None:\n      target_collect_block_indices.add(world.water_index) # Add water block as a source\n  elif primitive_name == 'stone' and world.stone_index is not None:\n      target_collect_block_indices.add(world.stone_index) # Add stone block as a source\n  # Extend with more mappings here if other primitives require specific source blocks\n  # (e.g., 'wood' from a 'tree' block, 'ore' from 'ore_deposit', if such attributes exist in world).\n\n  # --- 5. Breadth-First Search (BFS) for Shortest Path ---\n  # The BFS finds the shortest path for the agent to reach any position\n  # from which it can successfully 'USE' to collect the target primitive.\n  \n  q = deque([current_agent_pos]) \n  # `parent` dictionary stores (previous_position, action_to_reach_current_position)\n  # This also implicitly serves as the `visited` set for BFS.\n  parent = {current_agent_pos: (None, None)} \n  \n  found_target_agent_pos = None # Stores the first valid collection position found.\n\n  while q:\n      curr_agent_x, curr_agent_y = q.popleft()\n      curr_agent_pos = (curr_agent_x, curr_agent_y)\n\n      # Check if the current agent position is a valid collection point.\n      # This means checking if any of the `target_collect_block_indices` are in the 3x3 neighborhood.\n      is_valid_collection_location = False\n      for target_block_idx in target_collect_block_indices:\n          for dx, dy in NEIGHBORHOOD_OFFSETS:\n              neighbor_x, neighbor_y = curr_agent_x + dx, curr_agent_y + dy\n              \n              # Check bounds for the neighboring cell before accessing grid.\n              if (0 <= neighbor_x < W and 0 <= neighbor_y < H):\n                  # If the neighboring cell contains the target block/item,\n                  # then curr_agent_pos is a valid location to 'USE' from.\n                  if grid[neighbor_x, neighbor_y, target_block_idx] > 0:\n                      is_valid_collection_location = True\n                      break # Found a suitable target block in the neighborhood\n          if is_valid_collection_location:\n              break # No need to check other target block types if one is found\n\n      if is_valid_collection_location:\n          found_target_agent_pos = curr_agent_pos\n          break # Shortest path to a suitable collection location found.\n      \n      # Explore adjacent traversable cells for the agent's next move.\n      for action, (dx, dy) in MOVES.items():\n          next_agent_x, next_agent_y = curr_agent_x + dx, curr_agent_y + dy\n          next_agent_pos = (next_agent_x, next_agent_y)\n\n          # Ensure next position is within bounds, traversable, and not yet visited.\n          if (0 <= next_agent_x < W and 0 <= next_agent_y < H and\n              traversable_mask[next_agent_x, next_agent_y] and\n              next_agent_pos not in parent):\n              \n              parent[next_agent_pos] = (curr_agent_pos, action) # Record path\n              q.append(next_agent_pos) # Add to queue for further exploration\n  \n  # If no path to a collection point was found, return an empty list.\n  if found_target_agent_pos is None:\n      return [] \n  \n  # --- 6. Reconstruct the Path ---\n  # Traverse back from the found target position to the start position using `parent` links.\n  path_actions = []\n  node = found_target_agent_pos\n  while node != current_agent_pos:\n      # Retrieve the previous position and the action taken to reach the current `node`.\n      prev_node, action_to_reach_node = parent[node]\n      path_actions.append(action_to_reach_node)\n      node = prev_node\n  \n  path_actions.reverse() # Reverse the list to get actions in correct order (start to target).\n  \n  # --- 7. Append the 'USE' Action ---\n  # After reaching the collection point, the 'USE' action is required to acquire the primitive.\n  path_actions.append(USE)\n  \n  return path_actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:14:47.002035", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Action constants (from problem description context)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVES = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # Offsets for 3x3 neighborhood, including the agent's own position (0,0)\n  # Used for checking CraftState.next_to logic, as the USE action requires\n  # the target item/block to be within this 3x3 area.\n  NEIGHBORHOOD_OFFSETS = [\n      (dx, dy) for dx in [-1, 0, 1] for dy in [-1, 0, 1]\n  ]\n\n  actions = []\n  \n  # Get current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  # Ensure position is int tuple. CraftState.pos is tuple(int, int)\n  # obs['features_dict']['pos'] is a numpy array, convert to tuple for hashing in sets/dicts.\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  world = env.world\n  # non_grabbable_indices typically include obstacles like water, stone walls, workshops.\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  W, H, K = grid.shape\n\n  # 1. Determine traversable cells\n  # A cell is traversable if it does not contain any non-grabbable item (obstacle).\n  # This uses a simple check: if ANY non_grabbable_index is > 0 in a cell, it's non-traversable.\n  traversable_mask = np.ones((W, H), dtype=bool)\n  for x in range(W):\n      for y in range(H):\n          if any(grid[x, y, idx] > 0 for idx in non_grabbable_indices):\n              traversable_mask[x, y] = False\n  \n  # Crucial: The agent's starting position must be traversable. If not, no path is possible.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return []\n\n  # 2. Determine target kinds for collection.\n  # These are the indices of items/blocks that, if found in the 3x3 neighborhood of the agent,\n  # allow the 'USE' action to collect the desired 'primitive'.\n  \n  target_collect_indices = {primitive} # The primitive item itself can be picked up if on the ground\n\n  primitive_name = world.cookbook.index.get(primitive)\n  # Add source blocks from which the primitive can be harvested using USE.\n  # The problem description specifically mentions water and stone.\n  if primitive_name == 'water':\n      if world.water_index is not None:\n          target_collect_indices.add(world.water_index) \n  elif primitive_name == 'stone':\n      if world.stone_index is not None:\n          target_collect_indices.add(world.stone_index)\n  # Extend with more mappings if other primitives have specific source blocks (e.g., 'wood' from a 'tree' block if applicable)\n\n  # 3. Perform BFS to find the shortest path to a valid collection point.\n  q = deque([current_pos]) \n  parent = {current_pos: (None, None)} # parent[child_pos] = (parent_pos, action_from_parent)\n  \n  found_target_agent_pos = None # This will store the first valid collection position found by BFS\n\n  while q:\n      curr_agent_x, curr_agent_y = q.popleft()\n      curr_agent_pos = (curr_agent_x, curr_agent_y)\n\n      # Check if the current agent position `curr_agent_pos` is a valid collection target.\n      # A position is a target if, from this position, the agent can `USE` to collect the primitive.\n      # This means at least one `target_collect_index` must be present in the 3x3 neighborhood.\n      is_valid_collection_location = False\n      for target_idx in target_collect_indices:\n          for dx, dy in NEIGHBORHOOD_OFFSETS:\n              # Calculate coordinates of the cell in the neighborhood of `curr_agent_pos`\n              # where a target item/block might be.\n              neighbor_x, neighbor_y = curr_agent_x + dx, curr_agent_y + dy\n              \n              # Check if the neighbor cell is within grid bounds.\n              if (0 <= neighbor_x < W and 0 <= neighbor_y < H):\n                  # If this neighboring cell contains the `target_idx`, then `curr_agent_pos`\n                  # is a valid location from which to perform the `USE` action.\n                  if grid[neighbor_x, neighbor_y, target_idx] > 0:\n                      is_valid_collection_location = True\n                      break # Found a reason curr_agent_pos is a target, no need to check other offsets\n          if is_valid_collection_location:\n              break # No need to check other target_collect_indices if one is found\n      \n      if is_valid_collection_location:\n          found_target_agent_pos = curr_agent_pos\n          break # Found the shortest path to a suitable collection location for the agent\n\n      # Explore neighbors for the agent's next movement.\n      for action, (dx, dy) in MOVES.items():\n          next_agent_x, next_agent_y = curr_agent_x + dx, curr_agent_y + dy\n          next_agent_pos = (next_agent_x, next_agent_y)\n\n          # Check:\n          # 1. Bounds: Is the next position within the grid?\n          # 2. Traversability: Can the agent move to this position? (Avoids obstacles)\n          # 3. Visited: Has this position already been visited in the BFS? (Avoids cycles and re-exploring)\n          if (0 <= next_agent_x < W and 0 <= next_agent_y < H and\n              traversable_mask[next_agent_x, next_agent_y] and\n              next_agent_pos not in parent): # `parent` dict also serves as the visited set\n              \n              parent[next_agent_pos] = (curr_agent_pos, action) # Store how we reached next_agent_pos\n              q.append(next_agent_pos)\n  \n  # If BFS finished without finding a reachable collection point, return empty list.\n  if found_target_agent_pos is None:\n      return [] \n  \n  # 4. Reconstruct the path from `found_target_agent_pos` back to `current_pos`.\n  path_actions = []\n  node = found_target_agent_pos\n  # Backtrack from the target node until we reach the starting node (whose parent is None).\n  while node != current_pos:\n      prev_node, action_to_reach_node = parent[node]\n      path_actions.append(action_to_reach_node)\n      node = prev_node\n  \n  path_actions.reverse() # Actions were collected in reverse order, so reverse them.\n  \n  # 5. Append the USE action after the movement path.\n  actions.extend(path_actions)\n  actions.append(USE)\n  \n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:15:26.302578", "function_name": "collect", "function_body": "  from collections import deque\n  \n  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name\n  # The index method will add the primitive to the cookbook's index if it doesn't already exist.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable\n  if primitive_idx not in env.world.grabbable_indices:\n    # This primitive cannot be picked up (e.g., water, stone if not grabbable),\n    # so \"collecting\" it via USE is not possible.\n    return []\n\n  # 3. Check if the primitive is already in the agent's inventory\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 4. Retrieve grid dimensions and identify obstacle kinds.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # Define obstacle kinds: these are non-grabbable entities that are NOT workshops.\n  # The agent cannot move into cells containing these kinds.\n  # Workshops are typically non-grabbable but traversable.\n  obstacle_kinds = env.world.non_grabbable_indices - set(env.world.workshop_indices)\n\n  # 5. Perform a Breadth-First Search (BFS) to find the shortest sequence of actions.\n  #    The BFS state includes (agent_position_x, agent_position_y, agent_direction).\n  #    We want to find a state from which the 'USE' action will collect the primitive.\n  \n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's initial direction (0-3)\n\n  # queue stores (pos_tuple, direction_int, list_of_actions_to_reach_here)\n  queue = deque([(start_pos, start_dir, [])]) \n  # visited stores ((pos_x, pos_y), direction) tuples to prevent cycles and redundant path exploration\n  visited = {(start_pos, start_dir)} \n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.popleft() # Dequeue for BFS\n\n    # Check if the current state allows the 'USE' action to collect the primitive.\n    # This means the primitive must be in the cell directly in front of the agent.\n    dx_facing, dy_facing = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_item_x, target_item_y = curr_x + dx_facing, curr_y + dy_facing\n\n    # If the cell directly in front is within bounds and contains the primitive,\n    # we've found our target state to apply USE.\n    if (0 <= target_item_x < grid_width and 0 <= target_item_y < grid_height and\n        grid[target_item_x, target_item_y, primitive_idx] > 0):\n      return path_actions + [USE_ACTION] # Path found, return actions including final USE.\n    \n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # A movement action changes the agent's facing direction to the direction of movement.\n    # The agent's position updates *only if* the target cell is traversable.\n    for move_action in range(4): # Actions 0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT\n      dx_move, dy_move = _ACTION_TO_COORD_DIFF[move_action]\n      attempt_next_x, attempt_next_y = curr_x + dx_move, curr_y + dy_move\n      next_dir = move_action # Agent's direction changes to the direction of movement\n\n      actual_next_x, actual_next_y = curr_x, curr_y # Default: agent stays put if move fails\n\n      # Check if the attempted move target is within grid boundaries\n      is_valid_move_target = (0 <= attempt_next_x < grid_width and 0 <= attempt_next_y < grid_height)\n      \n      is_blocked_by_obstacle = False\n      if is_valid_move_target:\n          # Check if the target cell for movement is blocked by an obstacle\n          for k in obstacle_kinds:\n              if grid[attempt_next_x, attempt_next_y, k] > 0:\n                  is_blocked_by_obstacle = True\n                  break\n      \n      # If the target is valid and not blocked, the move succeeds.\n      if is_valid_move_target and not is_blocked_by_obstacle:\n          actual_next_x, actual_next_y = attempt_next_x, attempt_next_y\n      \n      next_state_tuple = ((actual_next_x, actual_next_y), next_dir)\n      \n      # If this new state (combination of position and direction) has not been visited yet\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple) # Mark the new state as visited\n        # Add the new state and its path to the queue for further exploration\n        queue.append(((actual_next_x, actual_next_y), next_dir, path_actions + [move_action]))\n\n  # If the queue becomes empty and no path was found, it means the primitive\n  # is unreachable from the current state.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:15:27.278761", "function_name": "collect", "function_body": "  _ACTION_TO_COORD_DIFF = {\n      0: (0, 1),  # DOWN: dx=0, dy=+1 (y increases)\n      1: (0, -1), # UP: dx=0, dy=-1 (y decreases)\n      2: (-1, 0), # LEFT: dx=-1, dy=0 (x decreases)\n      3: (1, 0)   # RIGHT: dx=+1, dy=0 (x increases)\n  }\n  USE_ACTION = 4 # From CraftLab.action_specs\n\n  # 1. Get the integer index for the given primitive name\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Check if the primitive is grabbable. If not, it cannot be collected via USE.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, no actions needed.\n\n  # 4. Retrieve grid dimensions and identify obstacle kinds.\n  grid = current_state.grid\n  grid_width, grid_height, n_kinds = grid.shape\n  \n  # Define obstacle kinds: these are non-grabbable entities that are not workshops.\n  # The agent cannot move into cells containing these kinds.\n  obstacle_kinds = set()\n  for k in range(n_kinds):\n      if k in env.world.non_grabbable_indices and k not in env.world.workshop_indices:\n          obstacle_kinds.add(k)\n\n  # 5. Perform a Breadth-First Search (BFS) to find the shortest sequence of actions.\n  #    The BFS state includes (agent_position_x, agent_position_y, agent_direction).\n  #    We store the path taken to reach each state.\n  \n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  # queue stores (pos_tuple, direction_int, list_of_actions_taken)\n  queue = [(start_pos, start_dir, [])]\n  # visited stores ((x, y), direction) tuples to prevent redundant exploration\n  visited = {(start_pos, start_dir)}\n\n  while queue:\n    (curr_x, curr_y), curr_dir, path_actions = queue.pop(0) # Dequeue the current state\n\n    # Check if the current state allows the 'USE' action to collect the primitive\n    dx_facing, dy_facing = _ACTION_TO_COORD_DIFF[curr_dir]\n    target_item_x, target_item_y = curr_x + dx_facing, curr_y + dy_facing\n\n    # If the cell directly in front is within bounds and contains the primitive,\n    # we've found our target state to apply USE.\n    if (0 <= target_item_x < grid_width and 0 <= target_item_y < grid_height and\n        grid[target_item_x, target_item_y, primitive_idx] > 0):\n      return path_actions + [USE_ACTION] # Path found, stop BFS\n\n    # Explore all possible movement actions (DOWN, UP, LEFT, RIGHT) from the current state.\n    # An agent attempts to move in the direction of the action, but always turns to face it.\n    for move_action in range(4): # Actions 0, 1, 2, 3\n      dx_attempt, dy_attempt = _ACTION_TO_COORD_DIFF[move_action]\n      attempt_next_x, attempt_next_y = curr_x + dx_attempt, curr_y + dy_attempt\n      \n      actual_next_x, actual_next_y = curr_x, curr_y # Agent's position if move is blocked\n      \n      can_move = True\n      # Check if the attempted move is within grid boundaries\n      if not (0 <= attempt_next_x < grid_width and 0 <= attempt_next_y < grid_height):\n        can_move = False # Out of bounds\n      else:\n        # Check if the target cell for movement is blocked by an obstacle\n        for k in obstacle_kinds:\n            if grid[attempt_next_x, attempt_next_y, k] > 0:\n                can_move = False # Blocked by an obstacle\n                break\n        \n      # If the move is possible, update the agent's actual position\n      if can_move:\n          actual_next_x, actual_next_y = attempt_next_x, attempt_next_y\n      \n      # The agent's direction always changes to the direction of the action taken.\n      next_dir = move_action\n      \n      next_state_tuple = ((actual_next_x, actual_next_y), next_dir)\n      \n      # If this new state has not been visited, add it to the queue.\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple)\n        queue.append((next_state_tuple[0], next_state_tuple[1], path_actions + [move_action]))\n\n  # If the queue is exhausted and no path was found, the primitive is unreachable.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:16:49.299049", "function_name": "collect", "function_body": "  # This function aims to find a path to a primitive item and collect it.\n  # It uses a Breadth-First Search (BFS) to find the shortest path to a cell\n  # adjacent to the primitive, then adds the 'USE' action.\n\n  # Get initial observations and necessary constants\n  obs = env.observations()\n  initial_inventory = obs['features_dict']['inventory']\n\n  # Check if the primitive is already in inventory\n  if initial_inventory[primitive] > 0:\n    return []\n\n  action_map = env.action_specs()\n  grid = obs['features_dict']['features_global']\n  \n  grid_height, grid_width, _ = grid.shape\n\n  # Convert normalized agent position to grid coordinates\n  agent_pos = (int(round(obs['features_dict']['pos'][0] * (grid_height - 1))),\n               int(round(obs['features_dict']['pos'][1] * (grid_width - 1))))\n\n  # Get indices of non-grabbable (obstacle) entities\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  actions_to_take = []\n\n  # 1. Find all locations of the primitive on the grid\n  # np.argwhere returns (row, col) for non-zero elements\n  primitive_cells = np.argwhere(grid[:, :, primitive] > 0)\n\n  # 2. Identify all \"collect-from\" cells (adjacent to primitive cells)\n  # and map them back to the primitive location they are adjacent to.\n  collect_from_targets = {}  # {(collect_r, collect_c): (primitive_r, primitive_c)}\n  \n  # Relative directions for neighbors (Up, Down, Left, Right)\n  directions_rc = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  for pr, pc in primitive_cells:\n    for dr, dc in directions_rc:\n      cr, cc = pr + dr, pc + dc  # Candidate collect-from cell\n\n      # Check if candidate cell is within grid bounds\n      if not (0 <= cr < grid_height and 0 <= cc < grid_width):\n        continue\n\n      # Check if candidate cell is an obstacle\n      is_obstacle = False\n      for idx in non_grabbable_indices:\n        if grid[cr, cc, idx] > 0:\n          is_obstacle = True\n          break\n      if is_obstacle:\n        continue # Cannot move into an obstacle cell\n\n      collect_from_targets[(cr, cc)] = (pr, pc)\n\n  # If no primitive or reachable collect-from cells are found, return empty\n  if not collect_from_targets:\n    return []\n\n  # 3. Perform BFS to find the shortest path to any \"collect-from\" cell\n  queue = [(agent_pos, [])]  # (current_position, path_of_positions_to_get_here)\n  visited = {agent_pos}\n\n  found_path_positions = None\n  target_primitive_pos_for_path = None # The specific primitive instance we're aiming for\n\n  # Use a list as a basic queue; collections.deque would be more efficient but requires import\n  head = 0\n  while head < len(queue):\n    curr_pos, path = queue[head]\n    head += 1\n\n    if curr_pos in collect_from_targets:\n      found_path_positions = path\n      target_primitive_pos_for_path = collect_from_targets[curr_pos]\n      break # Found the shortest path\n\n    for dr, dc in directions_rc:\n      next_r, next_c = curr_pos[0] + dr, curr_pos[1] + dc\n      next_pos = (next_r, next_c)\n\n      # Check bounds\n      if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n        continue\n\n      # Check if next cell is an obstacle\n      is_obstacle = False\n      for idx in non_grabbable_indices:\n        if grid[next_r, next_c, idx] > 0:\n          is_obstacle = True\n          break\n      if is_obstacle:\n        continue\n\n      if next_pos not in visited:\n        visited.add(next_pos)\n        queue.append((next_pos, path + [next_pos]))\n\n  # If no path was found, return empty actions\n  if found_path_positions is None:\n    return []\n\n  # 4. Convert the path of positions into a sequence of actions\n  # Map (dr, dc) to their corresponding action integer\n  action_from_vec = {\n      (-1, 0): action_map['UP'],\n      (1, 0): action_map['DOWN'],\n      (0, -1): action_map['LEFT'],\n      (0, 1): action_map['RIGHT']\n  }\n\n  current_agent_pos = agent_pos\n  for next_pos in found_path_positions:\n    dr, dc = next_pos[0] - current_agent_pos[0], next_pos[1] - current_agent_pos[1]\n    actions_to_take.append(action_from_vec[(dr, dc)])\n    current_agent_pos = next_pos # Update current position for next step in path\n\n  # 5. Add the 'USE' action after reaching the collect-from cell\n  actions_to_take.append(action_map['USE'])\n\n  return actions_to_take", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:16:49.368219", "function_name": "collect", "function_body": "    # Get action mappings from the environment's action_specs\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n    \n    # 1. Get the integer ID of the primitive\n    # The CookBook.index.index(item) method returns the index for a name.\n    # If the primitive name is not known, it cannot be collected.\n    try:\n        primitive_id = env.world.cookbook.index.index(primitive)\n    except Exception: # Catch any exception if the primitive name is invalid\n        return []\n\n    current_state = env._current_state\n    \n    # 2. Check if the primitive is already in inventory\n    if current_state.inventory[primitive_id] > 0:\n        return [] # Already collected\n\n    # 3. Pathfinding using BFS to find a cell adjacent to the primitive\n    grid = current_state.grid\n    start_pos = current_state.pos\n    grid_height, grid_width, _ = grid.shape\n\n    # Queue for BFS: (current_pos, actions_to_reach_pos_list)\n    # Each element is a tuple: (position_tuple, list_of_actions_to_reach_that_position)\n    queue = collections.deque([(start_pos, [])])\n    visited_cells = {start_pos} # Set of visited (row, col) tuples to prevent cycles\n\n    # Define movement directions and corresponding actions\n    # (dr, dc) -> action_value. Agent moves from current_pos to next_pos by taking action_value\n    move_directions_actions = [\n        ((1, 0), DOWN),   # Down\n        ((-1, 0), UP),    # Up\n        ((0, -1), LEFT),  # Left\n        ((0, 1), RIGHT),  # Right\n    ]\n\n    target_cell_for_use_found = False\n    final_path_actions = []\n\n    while queue:\n        current_pos, current_path = queue.popleft()\n\n        # Check if any cardinal neighbor of current_pos contains the primitive\n        for (dr, dc), _ in move_directions_actions: # We only need (dr, dc) here\n            neighbor_of_current = (current_pos[0] + dr, current_pos[1] + dc)\n\n            # Check bounds for neighbor\n            if 0 <= neighbor_of_current[0] < grid_height and \\\n               0 <= neighbor_of_current[1] < grid_width:\n                \n                # Check if the primitive is present at this neighbor location\n                # grid[r, c, kind_id] > 0 indicates presence\n                if grid[neighbor_of_current[0], neighbor_of_current[1], primitive_id] > 0:\n                    # Found a cell (neighbor_of_current) that contains the primitive.\n                    # The agent is at current_pos, and can collect it from here by 'USE'.\n                    final_path_actions = current_path\n                    target_cell_for_use_found = True\n                    break # Found the primitive adjacent to current_pos, exit inner loop\n        \n        if target_cell_for_use_found:\n            break # Found the path to a collection spot, exit BFS loop\n\n        # If not found adjacent to current_pos, explore its traversable neighbors\n        for (dr, dc), action in move_directions_actions:\n            next_pos = (current_pos[0] + dr, current_pos[1] + dc)\n\n            if 0 <= next_pos[0] < grid_height and \\\n               0 <= next_pos[1] < grid_width and \\\n               next_pos not in visited_cells:\n                \n                # Traversability: Assuming agent can move into any cell that isn't the primitive itself.\n                # If a cell contains the primitive we are looking for, we want to path *adjacent* to it,\n                # not directly *into* it as a traversable cell.\n                if grid[next_pos[0], next_pos[1], primitive_id] > 0:\n                    continue # Do not path *into* the primitive's cell directly\n\n                # Add to visited and queue to explore further\n                visited_cells.add(next_pos)\n                queue.append((next_pos, current_path + [action]))\n\n    if not target_cell_for_use_found:\n        # Primitive not found or not reachable by walking adjacent to it\n        return []\n    else:\n        # Path found, add the USE action at the end to collect the primitive\n        return final_path_actions + [USE]", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:18:13.717948", "function_name": "collect", "function_body": "    all_actions = []\n    MAX_COLLECT_STEPS = 500  # A safety limit to prevent excessively long runs\n\n    # Helper function for Breadth-First Search to find a path to the primitive\n    def _find_path_to_primitive_location(current_grid, start_pos, target_kind_idx):\n        rows, cols, _ = current_grid.shape\n        # Agent's position is (col, row)\n        start_col, start_row = start_pos\n\n        # Queue stores ( (col, row), list_of_actions_to_get_here )\n        q = collections.deque([( (start_col, start_row), [] )])\n        visited = { (start_col, start_row) } # Set of visited (col, row) positions\n\n        # Define possible movement actions and their corresponding (d_col, d_row) changes\n        # Assuming constants UP, DOWN, LEFT, RIGHT are globally defined (0, 1, 2, 3)\n        action_deltas = {\n            UP: (0, -1),\n            DOWN: (0, 1),\n            LEFT: (-1, 0),\n            RIGHT: (1, 0)\n        }\n\n        # BFS aims to find a path to any cell that contains the target primitive.\n        # It assumes all cells are traversable. Obstacles are not explicitly handled\n        # as the problem description does not specify unwalkable cells beyond grabbable/non-grabbable types.\n        while q:\n            (curr_col, curr_row), path_actions = q.popleft()\n\n            # If path becomes too long, prune to avoid excessive computation\n            if len(path_actions) > MAX_COLLECT_STEPS: # Reuse MAX_COLLECT_STEPS for path length limit\n                continue\n\n            # Check if the current cell contains the target primitive\n            # grid access is [row, col, kind_idx]\n            if current_grid[curr_row, curr_col, target_kind_idx] > 0:\n                return path_actions # Found a path to a cell with the primitive\n\n            # Explore all four neighbors\n            for action, (dcol, drow) in action_deltas.items():\n                next_col, next_row = curr_col + dcol, curr_row + drow\n                next_pos = (next_col, next_row)\n\n                # Check if the next position is within grid boundaries\n                if not (0 <= next_col < cols and 0 <= next_row < rows):\n                    continue\n                \n                # If the next position has not been visited yet\n                if next_pos not in visited:\n                    visited.add(next_pos)\n                    q.append((next_pos, path_actions + [action]))\n        \n        return None # No path found to the primitive within the search limits\n\n    # Get the initial state of the environment\n    # Accessing env._current_state is a common pattern in environments for direct state manipulation\n    # and is more efficient than parsing observations dict for repeated access.\n    current_state = env._current_state \n\n    # Loop to try and collect the primitive\n    # Assuming USE is 4, and other actions are 0-3\n    # Assuming constants UP, DOWN, LEFT, RIGHT, USE are globally defined\n    for _ in range(MAX_COLLECT_STEPS):\n        # 1. Check if the primitive is already in the inventory\n        if current_state.inventory[primitive] > 0:\n            break # Goal achieved: primitive collected\n\n        # 2. Check if the primitive is in an adjacent cell (or the current cell)\n        # The `next_to` method checks the 3x3 neighborhood. If true, `USE` action should work.\n        if current_state.next_to(primitive):\n            all_actions.append(USE) # Add USE action to the list\n            # Execute the USE action and update the environment state\n            reward, done, obs = env.step(USE)\n            current_state = env._current_state # Update current_state reference\n            \n            # After trying to USE, check again if the primitive was collected\n            if current_state.inventory[primitive] > 0:\n                break # Goal achieved after USE action\n            # If not collected, continue to next iteration (e.g., might need to re-position or multiple items)\n            continue \n\n        # 3. If the primitive is not adjacent, try to find a path to it using BFS\n        path_to_primitive = _find_path_to_primitive_location(\n            current_state.grid, current_state.pos, primitive\n        )\n\n        if path_to_primitive:\n            # If a path is found, take the first action from that path\n            next_action = path_to_primitive[0]\n            all_actions.append(next_action) # Add the action to our list\n            \n            # Execute the movement action and update the environment state\n            reward, done, obs = env.step(next_action)\n            current_state = env._current_state # Update current_state reference\n            \n            # Check if the environment signals that the episode is done (e.g., max_steps reached)\n            if done:\n                break # Terminate if episode is over\n\n        else:\n            # If no path is found (e.g., primitive is not on the grid, unreachable,\n            # or BFS search limit was hit before finding it)\n            # Fallback to a simple random movement to explore.\n            # This makes the agent more robust if the primitive is hidden or out of immediate sight.\n            \n            # Randomly choose one of the four movement actions (0, 1, 2, 3)\n            random_movement_action = env.random.randint(0, 4) \n            all_actions.append(random_movement_action) # Add the random action\n            \n            # Execute the random action and update the environment state\n            reward, done, obs = env.step(random_movement_action)\n            current_state = env._current_state # Update current_state reference\n\n            # Check if episode is done\n            if done:\n                break # Terminate if episode is over\n\n    return all_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:18:13.788565", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Define action constants based on CraftLab.action_specs()\n    # As per problem description: DOWN->0, UP->1, LEFT->2, RIGHT->3, USE->4\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    # ACTION_USE = 4 # Not used for basic movement/collection of primitives\n\n    initial_state = env._current_state\n    grid = initial_state.grid\n    start_pos = initial_state.pos\n    grid_height, grid_width, _ = grid.shape\n\n    # Identify target cells: any cell containing the desired primitive.\n    target_cells = []\n    for r in range(grid_height):\n        for c in range(grid_width):\n            if grid[r, c, primitive] > 0:\n                target_cells.append((r, c))\n\n    if not target_cells:\n        # If the primitive is not found on the map (or has already been collected),\n        # no actions are needed to collect it.\n        return []\n\n    # BFS setup for pathfinding\n    # Queue stores (current_row, current_col, list_of_actions_to_reach_here)\n    queue = collections.deque([(start_pos[0], start_pos[1], [])])\n    # Visited set for (row, col) coordinates to avoid cycles and redundant paths\n    visited = {(start_pos[0], start_pos[1])}\n\n    # Movement deltas corresponding to UP, DOWN, LEFT, RIGHT actions.\n    # CraftLab actions are absolute grid directions, not relative to agent's facing direction.\n    dr = {ACTION_UP: -1, ACTION_DOWN: 1, ACTION_LEFT: 0, ACTION_RIGHT: 0}\n    dc = {ACTION_UP: 0, ACTION_DOWN: 0, ACTION_LEFT: -1, ACTION_RIGHT: 1}\n    # List of cardinal movement actions to iterate through\n    action_labels = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]\n\n    # Get indices of known impassable entities from the world configuration.\n    # These are typically terrain features that entirely block movement.\n    water_idx = env.world.water_index\n    stone_idx = env.world.stone_index \n\n    def is_walkable(r, c):\n        \"\"\"\n        Checks if a given grid cell (r, c) is walkable by the agent.\n        \"\"\"\n        # Check grid boundaries\n        if not (0 <= r < grid_height and 0 <= c < grid_width):\n            return False\n\n        # Check for impassable terrain features.\n        # Water is generally always impassable.\n        if grid[r, c, water_idx] > 0:\n            return False\n        \n        # Stone can be both an impassable terrain feature and a collectable primitive.\n        # If the cell contains stone AND the primitive we are looking for is NOT stone,\n        # then it's considered an impassable obstacle.\n        # If the primitive *is* stone, we assume the agent can walk onto it to collect it.\n        if grid[r, c, stone_idx] > 0 and stone_idx != primitive:\n            return False\n        \n        # Other non-grabbable items (e.g., workshops, trees depending on configuration)\n        # are typically considered walkable or require specific interaction.\n        # This function focuses on universally impassable terrain.\n        return True\n\n    while queue:\n        r, c, path = queue.popleft()\n\n        # If the current cell contains the primitive, we have found a path to collect it.\n        # Primitives are typically collected in CraftWorld by moving onto their square.\n        if grid[r, c, primitive] > 0:\n            return path\n\n        # Explore neighboring cells\n        for action in action_labels:\n            nr, nc = r + dr[action], c + dc[action]\n\n            # If the neighbor is walkable and has not been visited yet\n            if (nr, nc) not in visited and is_walkable(nr, nc):\n                visited.add((nr, nc))\n                queue.append((nr, nc, path + [action]))\n\n    # If the queue becomes empty and no path to any target cell was found,\n    # it means the primitive is unreachable from the current position.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:19:43.336902", "function_name": "collect", "function_body": "    # Action definitions for CraftLab\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Map actions to delta (dr, dc) for grid movement\n    # (dr, dc) corresponds to (delta_row, delta_column)\n    ACTION_DELTAS = {\n        ACTION_DOWN: (1, 0),\n        ACTION_UP: (-1, 0),\n        ACTION_LEFT: (0, -1),\n        ACTION_RIGHT: (0, 1),\n    }\n    \n    # 1. Check if primitive is already in inventory\n    current_obs = env.observations()\n    current_inventory = current_obs['features_dict']['inventory']\n    if current_inventory[primitive] > 0:\n        return [] # Already collected\n\n    # Get current state from the environment\n    # CraftLab exposes _current_state as a reference to the current CraftState\n    current_state = env._current_state\n    current_pos = current_state.pos # This is (row, col) tuple of integers\n    current_grid = current_state.grid # numpy.ndarray (WIDTH, HEIGHT, n_kinds)\n    \n    # Grid dimensions (using the terminology from the class description for consistency)\n    WIDTH, HEIGHT, _ = current_grid.shape\n    \n    # Get world constants from the CraftWorld instance\n    world = env.world\n    water_index = world.water_index\n    # Convert lists to sets for faster `in` checks, if they aren't already sets\n    grabbable_indices = set(world.grabbable_indices)\n    non_grabbable_indices = world.non_grabbable_indices # This is already a set\n    \n    is_grabbable = primitive in grabbable_indices\n    is_non_grabbable = primitive in non_grabbable_indices\n\n    if not (is_grabbable or is_non_grabbable):\n        # The 'primitive' might be something not meant for collection,\n        # e.g., the agent itself, or a workshop building.\n        # In such cases, no actions can collect it.\n        return [] \n\n    # BFS Setup for shortest path\n    queue = collections.deque([(current_pos, [])]) # Stores (position (r,c), list of actions to reach it)\n    visited = {current_pos} # Stores visited (r,c) positions\n\n    best_path_actions = None # To store the shortest sequence of actions\n\n    while queue:\n        (r, c), path_actions = queue.popleft()\n\n        # Check for target found conditions\n        # If primitive is grabbable, we need to be ON its cell\n        if is_grabbable and current_grid[r, c, primitive] > 0:\n            best_path_actions = path_actions\n            break # Found a path to a grabbable item's cell\n        \n        # If primitive is non-grabbable, we need to be ADJACENT to its cell and USE it\n        if is_non_grabbable:\n            # Check all 4 direct neighbors (UP, DOWN, LEFT, RIGHT) of the current agent position (r,c)\n            # to see if any of them contain the non-grabbable primitive.\n            for dr_adj, dc_adj in ACTION_DELTAS.values(): \n                nr_adj, nc_adj = r + dr_adj, c + dc_adj\n                \n                # Check if this adjacent cell is within bounds and contains the primitive\n                if 0 <= nr_adj < WIDTH and 0 <= nc_adj < HEIGHT:\n                    if current_grid[nr_adj, nc_adj, primitive] > 0:\n                        # Found a path to a cell (r,c) from which the agent can USE\n                        # the non-grabbable item located at (nr_adj, nc_adj).\n                        best_path_actions = path_actions + [ACTION_USE]\n                        break # Path found, including the final USE action\n            if best_path_actions:\n                break # Break outer BFS loop as path is found\n\n        # If not at target (or adjacent to target), explore neighbors\n        for action, (dr, dc) in ACTION_DELTAS.items():\n            nr, nc = r + dr, c + dc # New potential agent position\n\n            # Check if the new position is within grid boundaries\n            if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n                continue\n            \n            # Check if the new position is walkable (e.g., not water or other obstacles)\n            # A cell is considered blocked if it contains water.\n            if current_grid[nr, nc, water_index] > 0:\n                continue\n\n            # Check if the new position has already been visited to avoid cycles and redundant paths\n            if (nr, nc) not in visited:\n                visited.add((nr, nc))\n                queue.append(((nr, nc), path_actions + [action]))\n\n    if best_path_actions is not None:\n        return best_path_actions\n    else:\n        # No path found to the primitive on the map\n        return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:19:43.407803", "function_name": "collect", "function_body": "    # Action mappings (from env.action_specs())\n    # DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3, USE: 4\n\n    actions = []\n    max_total_steps = 1000  # Safety limit to prevent infinite loops\n\n    for _ in range(max_total_steps):\n        obs = env.observations()\n        features_dict = obs['features_dict']\n        \n        # 1. Check if the primitive is already in the inventory\n        inventory = features_dict['inventory']\n        if inventory[primitive] > 0:\n            return actions # Primitive collected!\n\n        grid = features_dict['features_global']\n        \n        # Get current agent position and grid dimensions\n        # features_dict['pos'] is normalized (0-1 range), convert back to grid (row, col)\n        current_pos_normalized = features_dict['pos']\n        height, width, _ = grid.shape\n        \n        # Use round for robustness when converting float to int\n        r_agent = int(round(current_pos_normalized[0] * (height - 1)))\n        c_agent = int(round(current_pos_normalized[1] * (width - 1)))\n\n        # 2. Find all locations of the primitive on the global grid\n        primitive_locations_rows, primitive_locations_cols = np.where(grid[:, :, primitive] == 1)\n        \n        if len(primitive_locations_rows) == 0:\n            # Primitive not found on the grid. Cannot collect.\n            # This handles cases where the primitive might not be spawned,\n            # or it's a craftable item not meant to be \"collected\" directly from the grid.\n            return actions\n\n        # 3. Find the closest primitive target location using Manhattan distance\n        closest_target_loc = None\n        min_dist = float('inf')\n\n        for i in range(len(primitive_locations_rows)):\n            r_target, c_target = primitive_locations_rows[i], primitive_locations_cols[i]\n            dist = abs(r_target - r_agent) + abs(c_target - c_agent)\n            if dist < min_dist:\n                min_dist = dist\n                closest_target_loc = (r_target, c_target)\n        \n        # This condition is a defensive check; it should only be None if primitive_locations_rows was empty\n        if closest_target_loc is None:\n            return actions\n\n        r_target, c_target = closest_target_loc\n\n        # Determine if the agent is \"next to\" the primitive using the egocentric view\n        # The agent is typically at the center of the egocentric view (H//2, W//2)\n        # We check the 3x3 neighborhood around this center point.\n        ego_grid = features_dict['features_ego']\n        ego_h, ego_w, _ = ego_grid.shape\n        agent_ego_r, agent_ego_c = ego_h // 2, ego_w // 2\n\n        is_next_to_primitive = False\n        for dr_ego in [-1, 0, 1]:\n            for dc_ego in [-1, 0, 1]:\n                check_r = agent_ego_r + dr_ego\n                check_c = agent_ego_c + dc_ego\n                # Ensure the checked coordinate is within the bounds of the egocentric grid\n                if 0 <= check_r < ego_h and 0 <= check_c < ego_w:\n                    if ego_grid[check_r, check_c, primitive] == 1:\n                        is_next_to_primitive = True\n                        break\n            if is_next_to_primitive:\n                break\n        \n        current_action = None\n        if is_next_to_primitive:\n            current_action = 4 # USE action\n        else:\n            # 4. Move towards the target using a greedy Manhattan distance approach\n            dr = r_target - r_agent\n            dc = c_target - c_agent\n\n            # Prioritize movement along the axis with the larger difference\n            if abs(dr) > abs(dc):\n                if dr > 0:\n                    current_action = 0 # DOWN\n                else: # dr < 0\n                    current_action = 1 # UP\n            else: # abs(dc) >= abs(dr)\n                if dc > 0:\n                    current_action = 3 # RIGHT\n                else: # dc < 0\n                    current_action = 2 # LEFT\n            \n            # If for some reason an action couldn't be determined (unlikely with this logic,\n            # unless r_agent == r_target and c_agent == c_target, which `is_next_to_primitive`\n            # should have handled), then give up.\n            if current_action is None:\n                return actions\n\n        # Execute the determined action in the environment and record it\n        env.step(current_action)\n        actions.append(current_action)\n    \n    # If max_total_steps is reached without collecting the primitive,\n    # return the actions taken so far. This indicates the primitive might be unreachable.\n    return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:20:14.881640", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action constants (from CraftLab's action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Relative movements for each action (dr, dc) for (row_change, col_change)\n  MOVES = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1),\n  }\n\n  # Retrieve current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  # Agent's current position from observation features, converted to integer tuple (row, col).\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  world = env.world\n  # Indices of entities that cannot be picked up or walked through (obstacles).\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  # Grid dimensions: H (rows), W (columns), K (kinds)\n  H, W, K = grid.shape\n\n  # 1. Determine traversable cells. A cell is traversable if it does not contain any non-grabbable item.\n  # Initialize all cells as traversable.\n  traversable_mask = np.ones((H, W), dtype=bool) \n  if non_grabbable_indices:\n      # Convert set of non-grabbable indices to a list/array for efficient NumPy slicing.\n      non_grabbable_array = np.array(list(non_grabbable_indices))\n      # Identify cells containing any non-grabbable obstacle.\n      # np.any along axis=2 checks if any of the specified 'kinds' are present in a cell.\n      obstacles_present = np.any(grid[:, :, non_grabbable_array] > 0, axis=2)\n      # Invert the mask: where obstacles are present, it's NOT traversable.\n      traversable_mask = ~obstacles_present\n  \n  # Edge case: If the agent starts on an untraversable cell, no path is possible.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return []\n\n  # Helper function to check if a given position is adjacent to (or on) the primitive.\n  # This aligns with the 3x3 neighborhood effect of the 'USE' action.\n  def _can_use_primitive_from_pos(pos_to_check, grid_data, primitive_idx, grid_H, grid_W):\n      r_check, c_check = pos_to_check\n      # Iterate over 3x3 neighborhood (including the center cell)\n      for dr in [-1, 0, 1]:\n          for dc in [-1, 0, 1]:\n              nr, nc = r_check + dr, c_check + dc\n              # Check bounds and if the cell contains the primitive\n              if (0 <= nr < grid_H and 0 <= nc < grid_W and\n                  grid_data[nr, nc, primitive_idx] > 0):\n                  return True\n      return False\n\n  # 2. Perform Breadth-First Search (BFS) to find the shortest path to any location\n  #    from which the target primitive can be collected (i.e., a position adjacent to it).\n  # The queue stores tuples: (current_position_tuple, list_of_actions_taken_to_reach_this_position).\n  queue = deque([(current_pos, [])])\n  # Keep track of visited positions to avoid cycles and redundant checks.\n  visited = {current_pos} \n  \n  path_to_collect_pos = [] # This list will store the movement actions.\n\n  while queue:\n      (r, c), actions_so_far = queue.popleft() # Dequeue the current position and its path\n\n      # Check if the current position is a valid spot to use the primitive.\n      if _can_use_primitive_from_pos((r, c), grid, primitive, H, W):\n          path_to_collect_pos = actions_so_far\n          break # Shortest path found, exit BFS.\n\n      # Explore all four cardinal neighbors (UP, DOWN, LEFT, RIGHT)\n      for action, (dr, dc) in MOVES.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # Validate the next position: within grid bounds, traversable, and not yet visited.\n          if (0 <= next_r < H and 0 <= next_c < W and\n              traversable_mask[next_r, next_c] and\n              next_pos not in visited):\n              \n              visited.add(next_pos) # Mark as visited\n              # Enqueue the new position with the updated path (append the new action).\n              queue.append((next_pos, actions_so_far + [action]))\n  \n  # 3. Construct the final sequence of actions.\n  # If `path_to_collect_pos` is empty, it means either:\n  #   a) The agent started at a position from which it can use the primitive (BFS loop broke immediately).\n  #   b) The primitive is unreachable via any traversable path.\n  # We distinguish these cases by checking `_can_use_primitive_from_pos` for the starting position.\n  if not path_to_collect_pos and not _can_use_primitive_from_pos(current_pos, grid, primitive, H, W):\n      return [] # Primitive is unreachable from the current position.\n\n  # Append the 'USE' action after all movement actions.\n  # If `path_to_collect_pos` is empty, it correctly results in just `[USE]`.\n  return path_to_collect_pos + [USE]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:20:15.861963", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action constants (assuming they are not globally available in this scope)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Relative movements for each action in (row_change, col_change)\n  MOVES = {\n      UP: (-1, 0),    # Moving up decreases row index\n      DOWN: (1, 0),   # Moving down increases row index\n      LEFT: (0, -1),  # Moving left decreases col index\n      RIGHT: (0, 1),  # Moving right increases col index\n  }\n\n  # Retrieve current state information from the environment\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  # Agent's position from observation features, converted to integer tuple (row, col).\n  current_pos = tuple(obs['features_dict']['pos'].astype(int)) \n  \n  world = env.world\n  # Indices of entities that cannot be picked up or walked through (obstacles).\n  non_grabbable_indices = world.non_grabbable_indices\n  \n  H, W, _ = grid.shape # Grid dimensions (Height, Width, Kinds)\n\n  # 1. Determine traversable cells: a cell is traversable if it does not contain any non-grabbable item.\n  # Initialize all cells as traversable.\n  traversable_mask = np.ones((H, W), dtype=bool) \n  if non_grabbable_indices:\n      # Convert set of non-grabbable indices to a list/array for efficient NumPy slicing.\n      non_grabbable_array = np.array(list(non_grabbable_indices))\n      # Identify cells containing any non-grabbable obstacle.\n      # np.any along axis=2 checks if any of the specified 'kinds' are present in a cell.\n      obstacles_present = np.any(grid[:, :, non_grabbable_array] > 0, axis=2)\n      # Invert the mask: where obstacles are present, it's NOT traversable.\n      traversable_mask = ~obstacles_present\n  \n  # Edge case: If the agent starts on an untraversable cell, no path is possible.\n  if not traversable_mask[current_pos[0], current_pos[1]]:\n      return []\n\n  # Helper function to check if the primitive can be collected from a given position.\n  # Based on the CraftState.next_to description, USE works on a 3x3 neighborhood.\n  def _is_collectable_from_pos(pos_to_check, grid_data, primitive_idx, grid_H, grid_W):\n      r_check, c_check = pos_to_check\n      # Iterate over 3x3 neighborhood (including the center cell itself)\n      for dr in [-1, 0, 1]:\n          for dc in [-1, 0, 1]:\n              nr, nc = r_check + dr, c_check + dc\n              # Check bounds and if the cell contains the primitive\n              if 0 <= nr < grid_H and 0 <= nc < grid_W and grid_data[nr, nc, primitive_idx] > 0:\n                  return True\n      return False\n\n  # 2. Perform Breadth-First Search (BFS) to find the shortest path to any location\n  #    from which the target primitive can be collected (i.e., it's in the 3x3 neighborhood).\n  # The queue stores tuples: (current_position_tuple, list_of_actions_taken_to_reach_this_position).\n  queue = deque([(current_pos, [])])\n  # Keep track of visited positions to avoid cycles and redundant checks.\n  visited = {current_pos} \n  \n  path_to_collectable_pos = [] # This list will store the movement actions to the target position.\n\n  while queue:\n      (r, c), actions_so_far = queue.popleft() # Dequeue the current position and its path\n\n      # Check if the current position allows collection of the primitive.\n      if _is_collectable_from_pos((r, c), grid, primitive, H, W):\n          path_to_collectable_pos = actions_so_far\n          break # Shortest path to a collectable position found, exit BFS.\n\n      # Explore all four cardinal neighbors (UP, DOWN, LEFT, RIGHT)\n      for action, (dr, dc) in MOVES.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # Validate the next position: within grid bounds, traversable, and not yet visited.\n          if (0 <= next_r < H and 0 <= next_c < W and\n              traversable_mask[next_r, next_c] and\n              next_pos not in visited):\n              \n              visited.add(next_pos) # Mark as visited\n              # Enqueue the new position with the updated path (append the new action).\n              queue.append((next_pos, actions_so_far + [action]))\n  \n  # 3. Construct the final sequence of actions.\n  # If `path_to_collectable_pos` is empty, it means either:\n  #   a) The agent started at a position from which the primitive is collectable (BFS loop broke immediately).\n  #   b) The primitive is unreachable via any traversable path.\n  # We must distinguish between these two cases for the return value.\n  if not path_to_collectable_pos and not _is_collectable_from_pos(current_pos, grid, primitive, H, W):\n      return [] # Primitive is unreachable from the current position.\n\n  # Append the 'USE' action after all movement actions.\n  # If `path_to_collectable_pos` is empty, it correctly results in just `[USE]`.\n  return path_to_collectable_pos + [USE]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T10:21:45.273039", "function_name": "collect", "function_body": "    \"\"\"Improved version of `collect_v1` using BFS to find the closest primitive.\"\"\"\n\n    # Action constants (from CraftLab.action_specs())\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Map actions to coordinate changes (dr, dc) for (row, col)\n    # Assuming row increases downwards, col increases rightwards\n    # So UP is row-1, DOWN is row+1, LEFT is col-1, RIGHT is col+1\n    ACTION_VECTORS = {\n        ACTION_UP: (-1, 0),\n        ACTION_DOWN: (1, 0),\n        ACTION_LEFT: (0, -1),\n        ACTION_RIGHT: (0, 1),\n    }\n\n    initial_state = env._current_state\n    current_pos = initial_state.pos\n    grid = initial_state.grid\n    grid_height, grid_width, n_kinds = grid.shape\n\n    # Check if the primitive is already in inventory\n    if initial_state.inventory[primitive] > 0:\n        return []  # Already collected\n\n    # Get non-grabbable indices from the world, used to identify obstacles.\n    # The world is available via env.world (CraftLab -> CraftWorld).\n    # Items in non_grabbable_indices (like water, stone, workshops) are generally not traversable.\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # Determine obstacle cells upfront for faster lookup.\n    # A cell is an obstacle for movement if it contains:\n    # 1. The target `primitive` itself (agent cannot walk INTO it, must be adjacent).\n    # 2. Any other item that is marked as `non_grabbable`.\n    obstacles = set()\n    for r in range(grid_height):\n        for c in range(grid_width):\n            if grid[r, c, primitive] == 1:\n                # The primitive itself is considered an obstacle for movement,\n                # as the agent needs to be adjacent to it to 'USE'.\n                obstacles.add((r, c))\n            else:\n                # Check for other non-grabbable items that are not the primitive\n                for k in non_grabbable_indices:\n                    if k != primitive and grid[r, c, k] == 1:\n                        obstacles.add((r, c))\n                        break  # Found an obstacle in this cell, no need to check further kinds\n\n    # Find all locations of the target primitive\n    primitive_locations = []\n    for r in range(grid_height):\n        for c in range(grid_width):\n            if grid[r, c, primitive] == 1:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        # Primitive not found in the initial grid\n        return []\n\n    # Find all \"access points\": cells adjacent to a primitive that are not obstacles.\n    # The agent needs to reach one of these cells to use the 'USE' action.\n    target_access_points = set()\n    for pr, pc in primitive_locations:\n        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Neighbors (Up, Down, Left, Right)\n            nar, nac = pr + dr, pc + dc  # Neighbor Access Point row, col\n            if 0 <= nar < grid_height and 0 <= nac < grid_width and (nar, nac) not in obstacles:\n                target_access_points.add((nar, nac))\n\n    if not target_access_points:\n        # No walkable access points found (e.g., primitive is completely surrounded by obstacles)\n        return []\n\n    # BFS to find the shortest path from current_pos to any target_access_point.\n    q = collections.deque([(current_pos)])  # Queue stores (row, col)\n    visited = {current_pos}                 # Set of visited (row, col) positions\n    predecessors = {current_pos: None}      # To reconstruct the path: {current_pos: (prev_pos, action_taken_to_reach_current)}\n\n    found_target_pos = None\n\n    while q:\n        r, c = q.popleft()\n\n        if (r, c) in target_access_points:\n            found_target_pos = (r, c)\n            break  # Found the shortest path to *an* access point\n\n        # Explore neighbors\n        for action_val, (dr, dc) in ACTION_VECTORS.items():\n            nr, nc = r + dr, c + dc  # Next row, next col\n\n            # Check bounds, if cell is not visited, and if it's not an obstacle\n            if (0 <= nr < grid_height and 0 <= nc < grid_width and\n                    (nr, nc) not in visited and (nr, nc) not in obstacles):\n                \n                visited.add((nr, nc))\n                predecessors[(nr, nc)] = ((r, c), action_val)\n                q.append(((nr, nc)))\n\n    if found_target_pos is None:\n        # No path found to any access point\n        return []\n\n    # Reconstruct the path using the predecessors dictionary\n    path_actions = []\n    curr = found_target_pos\n    # Traverse back from the found_target_pos to the current_pos\n    while predecessors[curr] is not None:\n        prev_pos, action = predecessors[curr]\n        path_actions.append(action)\n        curr = prev_pos\n    \n    # The path is built in reverse order, so reverse it to get the correct sequence\n    path_actions.reverse()\n\n    # Once at the access point, use the 'USE' action to collect the primitive\n    return path_actions + [ACTION_USE]", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:21:46.276509", "function_name": "collect", "function_body": "  import collections\n\n  # Get action constants from env.action_specs()\n  action_specs = env.action_specs()\n  ACTION_UP = action_specs['UP']\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n\n  state = env._current_state\n  world = state.world\n  grid = state.grid\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n  agent_pos = state.pos  # (x, y)\n  current_inventory = state.inventory\n\n  # 1. Check if primitive is already in inventory\n  if current_inventory[primitive] > 0:\n    return []\n\n  # Define possible moves (dx, dy) and corresponding actions\n  # (dx, dy) represent change in (x, y) coordinates\n  MOVES = {\n      ACTION_UP: (0, -1),   # y decreases\n      ACTION_DOWN: (0, 1),  # y increases\n      ACTION_LEFT: (-1, 0), # x decreases\n      ACTION_RIGHT: (1, 0), # x increases\n  }\n\n  # Use a deque for efficient BFS\n  # Each element in the queue is (current_position, list_of_actions_to_reach_here)\n  queue = collections.deque([(agent_pos, [])])\n  # Keep track of visited positions to avoid cycles and redundant paths\n  visited = {agent_pos}\n\n  # Identify obstacle kinds.\n  # We assume any non-grabbable item at a cell makes it an obstacle for movement.\n  obstacle_kinds = world.non_grabbable_indices\n\n  while queue:\n    current_pos, path_actions = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if the current position contains the primitive\n    # grid[cx, cy, primitive] == 1 means the primitive exists at this (x,y) coordinate.\n    # For primitives (which are grabbable), we assume reaching the cell collects them.\n    if grid[cx, cy, primitive] == 1:\n      return path_actions\n\n    # Explore neighbors\n    for action, (dx, dy) in MOVES.items():\n      next_x, next_y = cx + dx, cy + dy\n      next_pos = (next_x, next_y)\n\n      # 1. Check if next_pos is within grid bounds\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # 2. Check if next_pos has already been visited on a shorter or equal path\n      if next_pos in visited:\n        continue\n\n      # 3. Check for obstacles at next_pos\n      is_obstacle = False\n      # Iterate over all obstacle kinds and check if any are present at next_pos\n      for k_idx in obstacle_kinds:\n        if grid[next_x, next_y, k_idx] == 1:\n          is_obstacle = True\n          break\n      if is_obstacle:\n        continue\n\n      # If next_pos is valid and not an obstacle, add it to the queue\n      visited.add(next_pos)\n      queue.append((next_pos, path_actions + [action]))\n\n  # If the queue becomes empty and the primitive was not found on any reachable square,\n  # it means it's unreachable or doesn't exist in the current grid.\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:23:12.277337", "function_name": "collect", "function_body": "    import numpy as np\n    from collections import deque\n\n    # Define actions based on CraftLab.action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Direction vectors for movement actions.\n    # These represent (dx, dy) for a given action, and the action itself implicitly\n    # sets the new facing direction of the agent.\n    # For example, ACTION_DOWN (0) means move (0, 1) and face direction 0 (DOWN).\n    DIR_VECS = {\n        ACTION_DOWN: (0, 1),\n        ACTION_UP: (0, -1),\n        ACTION_LEFT: (-1, 0),\n        ACTION_RIGHT: (1, 0),\n    }\n\n    current_state = env._current_state  # Access the internal CraftState\n    grid = current_state.grid\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir  # Initial facing direction of the agent\n\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # Get indices of non-grabbable items (obstacles) that block movement\n    # These are typically found in env.world.non_grabbable_indices\n    blocking_indices = env.world.non_grabbable_indices\n\n    def is_valid_pos(pos):\n        \"\"\"Checks if a given position is within the grid boundaries.\"\"\"\n        x, y = pos\n        return 0 <= x < WIDTH and 0 <= y < HEIGHT\n\n    def is_walkable(pos):\n        \"\"\"\n        Checks if a cell at 'pos' is traversable.\n        A cell is walkable if it's within bounds and does not contain any blocking items.\n        The agent's current position is always considered walkable for itself.\n        \"\"\"\n        if not is_valid_pos(pos):\n            return False\n        \n        # The agent's initial position is always traversable by the agent itself.\n        if pos == initial_pos:\n            return True\n        \n        # Check if the cell contains any entity from the blocking_indices set.\n        # If any blocking item is present (grid value is 1.0 for that kind), it's not walkable.\n        for blocking_idx in blocking_indices:\n            if grid[pos[0], pos[1], blocking_idx] == 1.0:\n                return False\n        \n        # If no blocking items are found, the cell is walkable.\n        # This implicitly means the agent can walk over 'empty' spaces or other grabbable items.\n        return True\n\n    # Find all locations of the target primitive on the grid\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] == 1.0:\n                primitive_locations.append((x, y))\n\n    if not primitive_locations:\n        return []  # Primitive not found on the map\n\n    # BFS state: (current_position, current_facing_direction, list_of_actions_taken_so_far)\n    q = deque([(initial_pos, initial_dir, [])])\n    # visited set stores (position, direction) tuples to avoid cycles and redundant states\n    visited = set([(initial_pos, initial_dir)])\n\n    while q:\n        curr_pos, curr_dir, path_actions = q.popleft()\n\n        # Check if the agent is now in a position to USE the primitive\n        # Calculate the position directly in front of the agent based on current_dir\n        fwd_vec = DIR_VECS[curr_dir]\n        fwd_pos = (curr_pos[0] + fwd_vec[0], curr_pos[1] + fwd_vec[1])\n\n        # If the position in front is valid and contains the target primitive,\n        # we have found a path. Add the USE action and return.\n        if is_valid_pos(fwd_pos) and fwd_pos in primitive_locations:\n            return path_actions + [ACTION_USE]\n\n        # Explore possible next movement actions (DOWN, UP, LEFT, RIGHT)\n        for action_move in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n            dx, dy = DIR_VECS[action_move]\n            next_pos = (curr_pos[0] + dx, curr_pos[1] + dy)\n            next_dir = action_move  # Agent's facing direction becomes the direction of movement\n\n            # If the next position is valid and the (next_pos, next_dir) state has not been visited\n            if (is_valid_pos(next_pos) and \n                (next_pos, next_dir) not in visited and \n                is_walkable(next_pos)):\n                \n                visited.add((next_pos, next_dir))\n                q.append((next_pos, next_dir, path_actions + [action_move]))\n    \n    # If the queue becomes empty and no path to collect the primitive was found\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:23:12.347523", "function_name": "collect", "function_body": "    # Action mappings for CraftLab (from action_specs)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Relative (dr, dc) for each move action\n    MOVE_DELTAS = {\n        ACTION_UP: (-1, 0),\n        ACTION_DOWN: (1, 0),\n        ACTION_LEFT: (0, -1),\n        ACTION_RIGHT: (0, 1),\n    }\n\n    # 1. Get initial observations from the environment\n    obs = env.observations()\n    current_inventory = obs['features_dict']['inventory']\n\n    # If the primitive is already in inventory, no actions are needed.\n    if current_inventory[primitive] > 0:\n        return []\n\n    # Get current grid and agent position for pathfinding\n    current_grid = obs['features_dict']['features_global']\n    current_pos = tuple(obs['features_dict']['pos']) # Convert numpy array to tuple for hashability\n\n    # Get grid dimensions\n    HEIGHT, WIDTH, _ = current_grid.shape\n\n    # Identify blocking entities (e.g., water) from the world configuration\n    world = env.world\n    blocking_indices = {world.water_index} # Water is typically a movement blocker\n\n    # 2. Use Breadth-First Search (BFS) to find the primitive and a path to it\n    # Queue stores tuples of (current_position, list_of_actions_to_reach_here)\n    queue = collections.deque([(current_pos, [])])\n    # Visited set to prevent cycles and redundant exploration\n    visited = {current_pos}\n\n    while queue:\n        (r, c), actions = queue.popleft()\n\n        # Check if the current cell contains the primitive\n        if current_grid[r, c, primitive] > 0:\n            # Primitive found! Append the USE action and return the complete path.\n            return actions + [ACTION_USE]\n\n        # Explore neighboring cells\n        for action_id, (dr, dc) in MOVE_DELTAS.items():\n            new_r, new_c = r + dr, c + dc\n            new_pos = (new_r, new_c)\n\n            # Check boundary conditions: ensure the new position is within the grid\n            if not (0 <= new_r < HEIGHT and 0 <= new_c < WIDTH):\n                continue\n\n            # Check if this position has already been visited\n            if new_pos in visited:\n                continue\n\n            # Check for obstacles: determine if the new cell is blocked\n            is_blocked = False\n            for block_idx in blocking_indices:\n                if current_grid[new_r, new_c, block_idx] > 0:\n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue\n            \n            # If the new position is valid, not visited, and not blocked, add it to the queue\n            visited.add(new_pos)\n            queue.append((new_pos, actions + [action_id]))\n\n    # If the BFS queue is exhausted and the primitive was not found, it's unreachable.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:24:45.259637", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Constants for actions (as defined in CraftLab.action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Mapping of CraftState's `dir` attribute (0:N, 1:E, 2:S, 3:W) to (dr, dc)\n  # This mapping is used to calculate the cell coordinates \"in front\" of the agent.\n  CARDINAL_DIRECTIONS_DR_DC = {\n      0: (-1, 0),  # North (Up)\n      1: (0, 1),   # East (Right)\n      2: (1, 0),   # South (Down)\n      3: (0, -1)   # West (Left)\n  }\n\n  def _get_coords_in_front(pos, facing_dir, grid_shape):\n      \"\"\"\n      Calculates the coordinates of the cell directly in front of the agent.\n      Args:\n          pos (tuple): Agent's current (row, column) position.\n          facing_dir (int): Agent's current facing direction (0:N, 1:E, 2:S, 3:W).\n          grid_shape (tuple): Shape of the grid (height, width, n_kinds).\n      Returns:\n          tuple: (row, column) of the cell in front, or None if out of bounds.\n      \"\"\"\n      r, c = pos\n      dr, dc = CARDINAL_DIRECTIONS_DR_DC.get(facing_dir, (0, 0)) # Default (0,0) if dir is invalid\n\n      front_r, front_c = r + dr, c + dc\n\n      # Check if the calculated coordinates are within grid boundaries\n      if 0 <= front_r < grid_shape[0] and 0 <= front_c < grid_shape[1]:\n          return front_r, front_c\n      return None # Out of bounds\n\n  # Initialize BFS queue and visited set\n  q = deque()\n  # `visited` set stores (pos_tuple, dir_int) to avoid revisiting the same agent configuration.\n  # This assumes that for collecting a single primitive, the grid state only relevantly changes\n  # upon successful collection (which is the goal state).\n  visited = set()\n\n  # Get the initial state from the CraftLab environment\n  initial_craft_state = env._current_state\n\n  # Check if the primitive is already in the inventory at the start\n  if initial_craft_state.inventory[primitive] > 0:\n      return [] # Primitive is already collected, no actions needed\n\n  # Add initial state to the queue: (CraftState instance, list_of_actions_to_reach_this_state)\n  q.append((initial_craft_state, []))\n  # Mark the initial position and direction as visited\n  visited.add((initial_craft_state.pos, initial_craft_state.dir))\n\n  # Get grid shape for bounds checking and helper function usage\n  grid_height, grid_width, _ = initial_craft_state.grid.shape\n\n  # Safety limit for BFS to prevent excessively long searches in complex or unreachable scenarios\n  max_search_iterations = 2000 \n\n  while q and max_search_iterations > 0:\n      current_state, current_path = q.popleft()\n      max_search_iterations -= 1\n\n      # Check if the primitive is now in inventory at the current state.\n      # This is the primary success condition and also handles cases where a `USE` action\n      # in a prior step of `current_path` might have collected the item.\n      if current_state.inventory[primitive] > 0:\n          return current_path\n\n      # --- Attempt the USE action from the current state ---\n      # This check is crucial to attempt collection whenever possible.\n      is_primitive_grabbable = primitive in current_state.world.grabbable_indices\n      front_coords = _get_coords_in_front(current_state.pos, current_state.dir, (grid_height, grid_width))\n\n      if is_primitive_grabbable and front_coords:\n          fr, fc = front_coords\n          # Check if the primitive entity is located at the cell directly in front\n          if current_state.grid[fr, fc, primitive] > 0:\n              # Attempt to perform the USE action (action 4)\n              _reward, state_after_use_action = current_state.step(ACTION_USE)\n              # If the primitive was successfully collected after this USE action, return the path\n              if state_after_use_action.inventory[primitive] > 0:\n                  return current_path + [ACTION_USE]\n              # If USE did not collect the primitive (e.g., it was a workshop, or not enough resources for crafting),\n              # we do not add `state_after_use_action` to the queue for this path, as it didn't advance the goal.\n\n      # --- Explore movement actions (DOWN, UP, LEFT, RIGHT) ---\n      # Iterate through possible movement actions (0 to 3)\n      for action in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n          # Take the movement action and get the resulting new state\n          _reward, next_state = current_state.step(action)\n\n          # Create a hashable signature of the next state's position and direction.\n          # Crucial assumption: the `step` method for movement actions (0-3) updates\n          # `CraftState.dir` to match the direction of movement. For example, moving 'UP'\n          # (action 1) sets `dir` to 0 (North). This allows `USE` to be effective after movement.\n          next_state_signature = (next_state.pos, next_state.dir)\n\n          # If this position-direction configuration hasn't been visited, add it to the queue\n          if next_state_signature not in visited:\n              visited.add(next_state_signature)\n              q.append((next_state, current_path + [action]))\n\n  # If the queue becomes empty and the maximum search iterations are exhausted without\n  # finding the primitive, it means no path was found within the defined search limits.\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:24:46.226815", "function_name": "collect", "function_body": "  # Action mappings: These are typically defined globally or retrieved from the env.\n  # We retrieve them inside the function to ensure they are available.\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Get initial state info from the environment.\n  # `env._current_state` is a Data Attribute of `CraftLab`.\n  current_state = env._current_state\n\n  # 1. Check if primitive is already collected\n  if current_state.inventory[primitive] > 0:\n    return []\n\n  # 2. Find all locations of the primitive on the grid\n  grid = current_state.grid\n  primitive_kind_idx = primitive # `primitive` is given as an int index.\n\n  primitive_locations = []\n  # grid shape is (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = grid.shape\n\n  # Iterate through the grid to find all cells containing the primitive\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If there's at least one instance of the primitive at (x,y)\n      if grid[x, y, primitive_kind_idx] > 0:\n        primitive_locations.append((x, y))\n\n  if not primitive_locations:\n    # Primitive not found anywhere on the grid\n    return []\n\n  # 3. Determine the target location (closest primitive using Manhattan distance)\n  agent_x, agent_y = current_state.pos\n\n  def manhattan_distance(p1, p2):\n    return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  # Select the closest primitive location as the target\n  target_x, target_y = min(primitive_locations, key=lambda p: manhattan_distance(current_state.pos, p))\n\n  # 4. Perform BFS to find the shortest path to the target location\n  # BFS setup\n  # Queue stores tuples: ((current_x, current_y), list_of_actions_to_reach_here)\n  # Using collections.deque for efficient pop from left\n  from collections import deque # This import should ideally be at the top of the file.\n  queue = deque([((agent_x, agent_y), [])])\n  visited = {(agent_x, agent_y)} # Set of visited positions\n\n  path_found = None # Will store the list of actions if a path is found\n\n  # Possible moves (dx, dy) and corresponding actions\n  # (delta_x, delta_y) from current position to next.\n  moves = {\n      (0, -1): ACTION_UP,\n      (0, 1): ACTION_DOWN,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT,\n  }\n\n  # BFS loop\n  while queue:\n    (curr_x, curr_y), path = queue.popleft() # Use popleft for BFS\n\n    # If current position is the target position, we found a path\n    if (curr_x, curr_y) == (target_x, target_y):\n      path_found = path\n      break\n\n    # Explore neighbors\n    for (dx, dy), action in moves.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check bounds\n      if 0 <= next_x < grid_width and 0 <= next_y < grid_height:\n        if (next_x, next_y) not in visited:\n          # Assuming all grid cells are traversable for this simple implementation.\n          visited.add((next_x, next_y))\n          queue.append(((next_x, next_y), path + [action]))\n\n  if path_found is None:\n    # No path found to the target. This could happen if the target is unreachable.\n    return []\n\n  final_actions = list(path_found)\n\n  # 5. After reaching the primitive's location, add the 'USE' action to pick it up.\n  final_actions.append(ACTION_USE)\n\n  return final_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:26:15.549280", "function_name": "collect", "function_body": "    state = env._current_state\n    world = env.world\n    grid = state.grid\n    current_pos = state.pos\n    grid_width, grid_height, _ = grid.shape\n    \n    # Get action mappings from the environment's action specifications\n    action_specs = env.action_specs()\n    DOWN = action_specs['DOWN']\n    UP = action_specs['UP']\n    LEFT = action_specs['LEFT']\n    RIGHT = action_specs['RIGHT']\n    USE = action_specs['USE']\n\n    # Map (dx, dy) movement deltas to their corresponding action integer\n    delta_to_action = {\n        (0, 1): DOWN,\n        (0, -1): UP,\n        (-1, 0): LEFT,\n        (1, 0): RIGHT\n    }\n    \n    # Define 4-directional movement deltas (dx, dy)\n    move_deltas = [\n        (0, 1),  # Down\n        (0, -1), # Up\n        (-1, 0), # Left\n        (1, 0)   # Right\n    ]\n\n    # Helper function to check if a cell (x, y) is within grid bounds and walkable.\n    # Assuming water is the only explicit unwalkable obstacle given the provided attributes.\n    def is_valid_and_walkable(x, y):\n        # Check if the coordinates are within the grid boundaries\n        if not (0 <= x < grid_width and 0 <= y < grid_height):\n            return False\n        # Check if the cell contains water, which is assumed to be unwalkable.\n        # `world.water_index` is an attribute of `CraftWorld`.\n        if world.water_index is not None and grid[x, y, world.water_index] == 1:\n            return False\n        # No other explicit 'wall' or unwalkable indices are provided,\n        # so assume other cells are traversable unless they are water.\n        return True\n\n    # Find all grid locations where the desired primitive is present.\n    # `np.argwhere` returns a list of (row, col) tuples where the condition is true.\n    primitive_locations = np.argwhere(grid[:, :, primitive] == 1)\n    \n    if len(primitive_locations) == 0:\n        # If the primitive is not found on the grid, no actions can be generated.\n        return []\n\n    # Determine target cells for the agent to move to.\n    # The agent needs to be directly adjacent (4-way connected) to a primitive location\n    # to be able to 'USE' it.\n    target_use_positions = set()\n    for px, py in primitive_locations:\n        for dx, dy in move_deltas: # Check all 4 neighbors of the primitive location\n            nx, ny = px + dx, py + dy\n            # If the neighboring cell is valid and walkable, add it to our set of targets\n            if is_valid_and_walkable(nx, ny):\n                target_use_positions.add((nx, ny))\n    \n    if not target_use_positions:\n        # If no accessible spots are found adjacent to any primitive (e.g., all primitives\n        # are surrounded by unwalkable terrain), no path can be found.\n        return []\n\n    # Use Breadth-First Search (BFS) to find the shortest sequence of actions (path)\n    # from the agent's current position to any of the `target_use_positions`.\n    # The queue stores tuples: (current_x, current_y, list_of_actions_taken_to_reach_here).\n    queue = [(current_pos[0], current_pos[1], [])]\n    # Keep track of visited cells to avoid cycles and redundant exploration.\n    visited = {(current_pos[0], current_pos[1])}\n\n    head = 0 # Manual queue head for list-based queue (since `collections.deque` import is forbidden)\n    while head < len(queue):\n        cx, cy, current_path = queue[head]\n        head += 1\n\n        # If the current cell is one of our target positions, we have found the shortest path.\n        if (cx, cy) in target_use_positions:\n            return current_path + [USE] # Append the 'USE' action after reaching the target position.\n\n        # Explore neighboring cells\n        for dx, dy in move_deltas:\n            nx, ny = cx + dx, cy + dy\n            \n            # If the neighbor is valid, walkable, and has not been visited yet\n            if is_valid_and_walkable(nx, ny) and (nx, ny) not in visited:\n                visited.add((nx, ny))\n                action_for_move = delta_to_action[(dx, dy)]\n                queue.append((nx, ny, current_path + [action_for_move]))\n    \n    # If the BFS queue becomes empty and no path to a target position was found, return an empty list.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:26:16.500022", "function_name": "collect", "function_body": "  # Assuming env_factory provides these constants\n  ACTION_DOWN = env_factory.ACTION_DOWN\n  ACTION_UP = env_factory.ACTION_UP\n  ACTION_LEFT = env_factory.ACTION_LEFT\n  ACTION_RIGHT = env_factory.ACTION_RIGHT\n  ACTION_USE = env_factory.ACTION_USE\n\n  # Get current state from the environment\n  current_state = env._current_state\n  initial_pos = current_state.pos\n  grid = current_state.grid\n  n_kinds = grid.shape[2] # Number of item kinds\n\n  # Get grid dimensions (assuming grid is WIDTH x HEIGHT)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Find the target primitive's location on the grid\n  target_pos = None\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          if grid[x, y, primitive] > 0:\n              target_pos = (x, y)\n              break\n      if target_pos:\n          break\n\n  if target_pos is None:\n      # Primitive not found on the grid, return an empty list of actions\n      return []\n\n  # Pathfinding using Breadth-First Search (BFS)\n  # Using a list to simulate a queue. `head` pointer for efficiency.\n  queue = [(initial_pos, [])] # (current_pos: (x,y), path_so_far: list of actions)\n  visited = {initial_pos} # Set of visited (x,y) tuples to prevent cycles and re-exploring\n\n  path_to_target = []\n\n  # Get non-grabbable items which act as obstacles from the CraftWorld instance\n  # The `env` object is a CraftLab, which has a `world` attribute, which is a CraftWorld.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a cell is traversable\n  def is_traversable(x, y):\n      # 1. Bounds check: Ensure the coordinates are within the grid\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return False # Out of bounds\n      \n      # 2. Obstacle check: If the cell contains any non-grabbable item, it's generally an obstacle.\n      for k_idx in range(n_kinds):\n          if grid[x, y, k_idx] > 0 and k_idx in non_grabbable_indices:\n              # Allow moving onto the target cell itself, even if it contains a non-grabbable item.\n              # This assumes we can stand on the target primitive's cell regardless of other contents,\n              # which is necessary to collect it with the USE action.\n              if (x, y) != target_pos:\n                  return False # Contains an obstacle and is not the target location\n      return True\n\n  head = 0 # Pointer for the list acting as a queue (dequeue from the front)\n  while head < len(queue):\n      (current_x, current_y), path = queue[head]\n      head += 1\n\n      if (current_x, current_y) == target_pos:\n          path_to_target = path\n          break\n\n      # Define possible moves (dx, dy, action) for adjacent cells\n      # (dx, dy) represents the change in (x, y) coordinates\n      move_options = [\n          (0, 1, ACTION_DOWN),  # Move down (increase y)\n          (0, -1, ACTION_UP),   # Move up (decrease y)\n          (-1, 0, ACTION_LEFT), # Move left (decrease x)\n          (1, 0, ACTION_RIGHT)  # Move right (increase x)\n      ]\n\n      for dx, dy, action in move_options:\n          next_x, next_y = current_x + dx, current_y + dy\n          next_pos = (next_x, next_y)\n\n          # If the next position is traversable and hasn't been visited yet, add it to the queue\n          if is_traversable(next_x, next_y) and next_pos not in visited:\n              visited.add(next_pos)\n              queue.append((next_pos, path + [action]))\n\n  if not path_to_target:\n      # If BFS did not find a path to the primitive, it's unreachable\n      return []\n\n  # After moving to the target_pos, the agent needs to use the ACTION_USE to collect the primitive\n  actions = path_to_target + [ACTION_USE]\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:27:42.727668", "function_name": "collect", "function_body": "  import collections # collections is not imported globally, so import it here.\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  DIR_VEC = {\n      0: (0, -1),  # UP (decreases y)\n      1: (1, 0),   # RIGHT (increases x)\n      2: (0, 1),   # DOWN (increases y)\n      3: (-1, 0)   # LEFT (decreases x)\n  }\n\n  initial_state = env._current_state\n\n  # Improvement: If the primitive is already in the inventory, no actions are needed.\n  if initial_state.inventory[primitive] > 0:\n    return []\n\n  # Pre-check: If the primitive is not a grabbable item, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Get the initial state details for the BFS starting point\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir  # Agent's initial facing direction\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Identify indices of entities that block movement (non-grabbable items like water, workshops etc.)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to determine if a cell is traversable.\n  def is_walkable(x, y):\n    # Check if the coordinates are within grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if the cell contains any non-grabbable item that acts as an obstacle.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False  # Cell is blocked by an obstacle\n    return True\n\n  # Initialize Breadth-First Search (BFS)\n  # Using collections.deque for efficient append/popleft operations.\n  queue = collections.deque([(start_x, start_y, start_dir)])\n\n  # Parent map: {(x, y, dir): ((parent_x, parent_y, parent_dir), action_to_reach_this_state)}\n  # This map stores the immediate parent state and the action taken from that parent\n  # to reach the current state, enabling path reconstruction.\n  parent_map = {}\n\n  # Set to keep track of visited states (position and direction) to avoid cycles and redundant paths.\n  visited = set([(start_x, start_y, start_dir)])\n\n  # Variable to store the state from which the 'USE' action can be taken\n  goal_reached_state = None\n\n  while queue: # Loop while the queue is not empty\n    curr_x, curr_y, curr_dir = queue.popleft() # Dequeue the current state\n\n    # Check if the primitive can be collected from the current state.\n    # The 'USE' action affects the cell directly in front of the agent.\n    faced_dx, faced_dy = DIR_VEC[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # If the cell in front is within bounds and contains the target primitive:\n    if (0 <= faced_x < grid_width and 0 <= faced_y < grid_height and\n        grid[faced_x, faced_y, primitive] == 1):\n      # Goal reached! Store this state and break BFS.\n      goal_reached_state = (curr_x, curr_y, curr_dir)\n      break\n\n    # Explore all possible movement actions from the current state.\n    # Each movement action also sets the agent's new facing direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new position after performing this action.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action]  # The agent's new facing direction\n\n      # If the next cell is walkable and this new (position, direction) state has not been visited yet:\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir))\n        # Store how we reached this new state for path reconstruction.\n        parent_map[(next_x, next_y, next_dir)] = ((curr_x, curr_y, curr_dir), action)\n\n  # If the BFS completes and no path to collect the primitive is found, return an empty list.\n  if goal_reached_state is None:\n    return []\n\n  # Path Reconstruction:\n  # Start with the final 'USE' action.\n  path = [ACTION_USE]\n  # Backtrack from the state from which the 'USE' action was performed.\n  current_path_state = goal_reached_state\n\n  # Reconstruct the path by traversing back through the parent_map until the start state is reached.\n  while current_path_state != (start_x, start_y, start_dir):\n    # Retrieve the parent state and the action taken from that parent to reach current_path_state.\n    parent_state, action_from_parent = parent_map[current_path_state]\n\n    # Prepend the action to the path list (since we are building it backwards).\n    path.insert(0, action_from_parent)\n\n    # Move to the parent state for the next iteration of backtracking.\n    current_path_state = parent_state\n\n  return path", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T10:27:43.687847", "function_name": "collect", "function_body": "  import collections\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  ACTION_TO_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3\n  }\n\n  DIR_VEC = {\n      0: (0, -1),  # UP (decreases y)\n      1: (1, 0),   # RIGHT (increases x)\n      2: (0, 1),   # DOWN (increases y)\n      3: (-1, 0)   # LEFT (decreases x)\n  }\n\n  # In collect_v1, there was an initial check:\n  # if primitive not in env.world.grabbable_indices:\n  #   return []\n  # This check is removed in collect_v2. The \"improvement\" allows for collecting\n  # primitives that might not be directly grabbable but can be obtained by\n  # using a workshop or another resource node.\n\n  initial_state = env._current_state\n  start_x, start_y = initial_state.pos\n  start_dir = initial_state.dir\n  grid = initial_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Identify indices of entities that block movement (e.g., water, workshops).\n  # These are cells the agent cannot step *into*.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to determine if a cell is traversable.\n  def is_walkable(x, y):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False  # Outside grid boundaries\n    # A cell is not walkable if it contains any non-grabbable item.\n    for k_idx in non_grabbable_indices:\n      if grid[x, y, k_idx] == 1:\n        return False  # Cell is blocked by an obstacle\n    return True\n\n  # Initialize Breadth-First Search (BFS)\n  queue = collections.deque([(start_x, start_y, start_dir)])\n  # parent_map: {(x, y, dir): ((parent_x, parent_y, parent_dir), action_to_reach_this_state)}\n  parent_map = {}\n  # visited: set of (x, y, dir) states to avoid cycles and redundant exploration.\n  visited = set([(start_x, start_y, start_dir)])\n  goal_reached_state = None # To store the state from which 'USE' can be performed.\n\n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Calculate the cell directly in front of the agent (where ACTION_USE would apply).\n    faced_dx, faced_dy = DIR_VEC[curr_dir]\n    faced_x, faced_y = curr_x + faced_dx, curr_y + faced_dy\n\n    # Check if the faced cell is within grid boundaries.\n    if 0 <= faced_x < grid_width and 0 <= faced_y < grid_height:\n      is_target_collectible_at_faced_cell = False\n\n      # Condition 1: The primitive itself is directly present at the faced cell.\n      if grid[faced_x, faced_y, primitive] == 1:\n        is_target_collectible_at_faced_cell = True\n      \n      # Condition 2 (Improvement for v2): A workshop is at the faced cell.\n      # This assumes that a primitive might be obtainable by 'USE'ing a workshop.\n      # This generalizes collection beyond only directly grabbable items on the ground.\n      for workshop_idx in env.world.workshop_indices:\n        if grid[faced_x, faced_y, workshop_idx] == 1:\n          is_target_collectible_at_faced_cell = True\n          break # Found a workshop, no need to check other workshops for this cell.\n      \n      # Additional potential sources for specific primitives (e.g., \"stone\" from a \"stone_index\" block)\n      # This part could be expanded based on game specifics, but general workshop check covers many cases.\n      # Example: if primitive == env.world.stone_index and grid[faced_x, faced_y, env.world.stone_index] == 1:\n      #   is_target_collectible_at_faced_cell = True\n\n      # If the primitive is collectible (either directly or via a workshop) from this position.\n      if is_target_collectible_at_faced_cell:\n        goal_reached_state = (curr_x, curr_y, curr_dir)\n        break # Goal found, terminate BFS.\n\n    # Explore all possible movement actions from the current state.\n    # Each movement action updates the agent's position and sets its new facing direction.\n    for action in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      # Calculate the new position based on the direction implied by the action.\n      move_dx, move_dy = DIR_VEC[ACTION_TO_DIR[action]]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = ACTION_TO_DIR[action] # The agent's new facing direction after this move.\n\n      # If the next cell is walkable and this state (position + direction) has not been visited:\n      if is_walkable(next_x, next_y) and (next_x, next_y, next_dir) not in visited:\n        visited.add((next_x, next_y, next_dir))\n        queue.append((next_x, next_y, next_dir))\n        # Store how we reached this new state for path reconstruction.\n        parent_map[(next_x, next_y, next_dir)] = ((curr_x, curr_y, curr_dir), action)\n\n  # If the BFS completes and no path to collect the primitive is found.\n  if goal_reached_state is None:\n    return []\n\n  # Path Reconstruction:\n  # Start with the final 'ACTION_USE' which collects the primitive.\n  path = [ACTION_USE]\n  # Backtrack from the state from which the 'ACTION_USE' was performed.\n  current_path_state = goal_reached_state\n\n  # Reconstruct the path by traversing back through the parent_map\n  # until the initial start state is reached.\n  while current_path_state != (start_x, start_y, start_dir):\n    # Retrieve the parent state and the action taken from that parent\n    # to reach the `current_path_state`.\n    parent_state, action_from_parent = parent_map[current_path_state]\n\n    # Prepend the action to the path list (since we are building it backwards).\n    path.insert(0, action_from_parent)\n\n    # Move to the parent state for the next iteration of backtracking.\n    current_path_state = parent_state\n\n  return path", "island_id": 6, "scores": {"3": -1}}
