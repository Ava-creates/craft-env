{"timestamp": "2025-07-30T17:46:35.370818", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Action and Direction Constants\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  # Map agent's facing direction to (dx, dy) delta for moving \"forward\" in that direction.\n  # (dx, dy) represents the change in (x, y) coordinates.\n  # Assuming (x,y) corresponds to (column, row) in the grid, where +x is right, +y is down.\n  DIR_DELTAS = {\n      DIR_UP: (0, -1),   # Moving up: x constant, y decreases\n      DIR_RIGHT: (1, 0),  # Moving right: x increases, y constant\n      DIR_DOWN: (0, 1),   # Moving down: x constant, y increases\n      DIR_LEFT: (-1, 0),  # Moving left: x decreases, y constant\n  }\n\n  # Pre-compute a reverse mapping: map (dx, dy) vector to the corresponding direction constant.\n  # This allows for direct lookup of the required agent direction when adjacent to a primitive.\n  VECTOR_TO_DIR = {v: k for k, v in DIR_DELTAS.items()}\n\n  # Map a movement action to the agent's resulting facing direction.\n  # In CraftWorld, movement actions also orient the agent in the direction of movement.\n  ACTION_TO_RESULTING_DIR = {\n      ACTION_UP: DIR_UP,\n      ACTION_RIGHT: DIR_RIGHT,\n      ACTION_DOWN: DIR_DOWN,\n      ACTION_LEFT: DIR_LEFT,\n  }\n\n  # List of all movement actions (excluding USE).\n  MOVEMENT_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # 1. Get current state information from the environment.\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Extract current agent position (x, y) and direction.\n  current_pos_x, current_pos_y = obs['features_dict']['pos'].astype(int)\n  current_dir = np.argmax(obs['features_dict']['direction'])\n\n  # Get world configuration, specifically non-grabbable entities that act as obstacles.\n  world = env.world\n  non_grabbable_indices = world.non_grabbable_indices\n\n  grid_width, grid_height, _ = grid.shape\n\n  # 2. Determine traversable cells on the grid.\n  # A cell is considered NOT traversable if it contains any non-grabbable item.\n  traversable_mask = np.ones((grid_width, grid_height), dtype=bool)\n  if non_grabbable_indices:\n      # Create a boolean mask where True indicates an obstacle of any non-grabbable kind.\n      # `grid[:, :, list(non_grabbable_indices)]` selects all cells for these specific kinds.\n      # `np.any(..., axis=2)` checks if any of these non-grabbable kinds are present in a cell.\n      cells_with_obstacles = np.any(grid[:, :, list(non_grabbable_indices)] > 0, axis=2)\n      traversable_mask[cells_with_obstacles] = False\n  \n  # The agent's starting position must be traversable to begin the search.\n  if not traversable_mask[current_pos_x, current_pos_y]:\n      return [] # Cannot move from an untraversable starting point.\n\n  # 3. Identify all locations on the grid where the target primitive exists.\n  primitive_locations_on_grid = []\n  # `np.where` returns (row_indices, col_indices) for elements matching the condition.\n  # Since grid is `(WIDTH, HEIGHT, K)`, row_indices are y-coordinates and col_indices are x-coordinates.\n  y_coords_of_primitive, x_coords_of_primitive = np.where(grid[:, :, primitive] > 0)\n  for x, y in zip(x_coords_of_primitive, y_coords_of_primitive):\n      primitive_locations_on_grid.append((x, y))\n\n  if not primitive_locations_on_grid:\n      return [] # The primitive is not present anywhere on the map.\n\n  # 4. Identify \"collectable target states\" for the agent.\n  # A target state is (agent_x, agent_y, agent_direction) from which the ACTION_USE\n  # can successfully collect the primitive. This requires the agent to be adjacent\n  # to the primitive and facing it.\n  collectable_target_states = set()\n  for p_x, p_y in primitive_locations_on_grid:\n      # Iterate over the four cells adjacent to the primitive.\n      # `delta_x_from_primitive, delta_y_from_primitive` define the relative position of the agent\n      # if the agent were to be at one of the four cardinal neighbors of the primitive.\n      for delta_x_from_primitive, delta_y_from_primitive in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          # Calculate the agent's potential position (a_x, a_y).\n          a_x, a_y = p_x + delta_x_from_primitive, p_y + delta_y_from_primitive\n\n          # Check if this potential agent position is within grid boundaries and is traversable.\n          if not (0 <= a_x < grid_width and 0 <= a_y < grid_height and traversable_mask[a_x, a_y]):\n              continue\n          \n          # Determine the required direction the agent must face from (a_x, a_y) to collect (p_x, p_y).\n          # This is the vector from the agent's position to the primitive's position.\n          vector_to_primitive_x, vector_to_primitive_y = p_x - a_x, p_y - a_y\n\n          # Use the pre-computed VECTOR_TO_DIR map for a more direct lookup.\n          required_agent_dir = VECTOR_TO_DIR.get((vector_to_primitive_x, vector_to_primitive_y), -1)\n          \n          if required_agent_dir != -1:\n              collectable_target_states.add((a_x, a_y, required_agent_dir))\n\n  if not collectable_target_states:\n      return [] # No valid states exist from which the primitive can be collected.\n\n  # 5. Perform a Breadth-First Search (BFS) on the state space.\n  # A state is defined by (agent_x, agent_y, agent_direction).\n  start_state = (current_pos_x, current_pos_y, current_dir)\n  \n  # The queue stores tuples: ((current_x, current_y, current_dir), [list_of_actions_taken_to_reach_this_state]).\n  q = deque([(start_state, [])]) \n  \n  # The `visited_states` set keeps track of states already explored to prevent cycles and redundant paths.\n  visited_states = {start_state}\n\n  while q:\n      (curr_x, curr_y, curr_dir), path_actions = q.popleft()\n\n      # Check if the current state is one of our desired collectable target states.\n      if (curr_x, curr_y, curr_dir) in collectable_target_states:\n          # If it is, we've found the shortest path. Append the USE action and return.\n          return path_actions + [ACTION_USE]\n\n      # Explore all possible next states by applying movement actions.\n      for action_taken in MOVEMENT_ACTIONS:\n          # Determine the agent's new direction and position after taking this action.\n          next_dir = ACTION_TO_RESULTING_DIR[action_taken]\n          dx_move, dy_move = DIR_DELTAS[next_dir]\n          \n          next_x, next_y = curr_x + dx_move, curr_y + dy_move\n\n          next_state = (next_x, next_y, next_dir)\n\n          # Check if the next cell is within grid boundaries, is traversable,\n          # and this specific (position, direction) state has not been visited yet.\n          if (0 <= next_x < grid_width and 0 <= next_y < grid_height and\n              traversable_mask[next_x, next_y] and\n              next_state not in visited_states):\n              \n              # Mark the new state as visited and add it to the queue for further exploration.\n              visited_states.add(next_state)\n              q.append((next_state, path_actions + [action_taken]))\n  \n  # If the BFS queue becomes empty and no path to a target state was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:47:49.981321", "function_name": "collect", "function_body": "    import collections\n\n    _actions_map = env.action_specs()\n    _DOWN = _actions_map['DOWN']\n    _UP = _actions_map['UP']\n    _LEFT = _actions_map['LEFT']\n    _RIGHT = _actions_map['RIGHT']\n    _USE = _actions_map['USE']\n\n    # Define direction constants (assuming 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n    _DIR_UP = 0\n    _DIR_RIGHT = 1\n    _DIR_DOWN = 2\n    _DIR_LEFT = 3\n\n    actions_to_take = []\n\n    # Get current state information from the environment's observations\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    \n    current_grid = features_dict['features_global'] # Full allocentric grid\n    \n    # Get grid dimensions from the scenario\n    WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n    # Denormalize current agent position\n    current_pos_normalized = features_dict['pos']\n    current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n    current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n    current_pos = (current_px, current_py)\n\n    # Get current agent direction (convert one-hot array to integer)\n    current_dir_int = np.argmax(features_dict['direction'])\n\n    # Check if the primitive is grabbable. If not, it cannot be collected.\n    if primitive not in env.world.grabbable_indices:\n        return []\n\n    # Find all locations where the primitive exists on the grid\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            # Check if the primitive kind exists at this cell\n            if current_grid[x, y, primitive] == 1:\n                primitive_locations.append((x, y))\n\n    # If no primitive is found on the grid, return an empty list of actions\n    if not primitive_locations:\n        return []\n\n    # BFS state: (x, y, direction, path_actions)\n    queue = collections.deque([(current_px, current_py, current_dir_int, [])])\n    # Visited set to avoid cycles and redundant processing: (x, y, direction)\n    visited = set([(current_px, current_py, current_dir_int)]) \n\n    # Define how each move action changes position and the agent's resulting direction\n    directional_moves = {\n        _UP: (0, -1, _DIR_UP),\n        _DOWN: (0, 1, _DIR_DOWN),\n        _LEFT: (-1, 0, _DIR_LEFT),\n        _RIGHT: (1, 0, _DIR_RIGHT)\n    }\n\n    # Breadth-First Search to find the shortest action sequence\n    while queue:\n        px, py, pdir, path_actions = queue.popleft()\n\n        # Check for goal condition: Have we reached a position adjacent to a primitive\n        # and are we facing it correctly?\n        for target_x, target_y in primitive_locations:\n            # Define the 4 possible interaction points and the required facing direction\n            interaction_points = []\n            # Agent needs to be at (target_x - 1, target_y) and face RIGHT\n            if target_x - 1 >= 0: interaction_points.append((target_x - 1, target_y, _DIR_RIGHT))\n            # Agent needs to be at (target_x + 1, target_y) and face LEFT\n            if target_x + 1 < WIDTH: interaction_points.append((target_x + 1, target_y, _DIR_LEFT))\n            # Agent needs to be at (target_x, target_y - 1) and face DOWN\n            if target_y - 1 >= 0: interaction_points.append((target_x, target_y - 1, _DIR_DOWN))\n            # Agent needs to be at (target_x, target_y + 1) and face UP\n            if target_y + 1 < HEIGHT: interaction_points.append((target_x, target_y + 1, _DIR_UP))\n            \n            for adj_x, adj_y, face_dir in interaction_points:\n                if (px, py) == (adj_x, adj_y) and pdir == face_dir:\n                    # Goal reached: return the path plus the USE action\n                    return path_actions + [_USE]\n\n        # Explore possible next states:\n        \n        # 1. Try moving to adjacent cells\n        for move_action, (dx, dy, resulting_dir_after_move) in directional_moves.items():\n            nx, ny = px + dx, py + dy\n\n            # Check if the new position is within grid bounds\n            if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n                continue\n\n            # Check walkability: a cell is an obstacle if it contains any non-grabbable item\n            is_obstacle = False\n            for k_idx in env.world.non_grabbable_indices:\n                if current_grid[nx, ny, k_idx] == 1:\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n            \n            # Calculate the sequence of turn actions needed to face the direction of the move\n            # (if not already facing it)\n            turn_actions_for_move = []\n            diff = (resulting_dir_after_move - pdir + 4) % 4\n            if diff == 1: # One clockwise turn needed (e.g., UP -> RIGHT)\n                turn_actions_for_move.append(_RIGHT)\n            elif diff == 2: # Two turns needed (180 degrees, e.g., UP -> DOWN)\n                turn_actions_for_move.extend([_RIGHT, _RIGHT]) \n            elif diff == 3: # One counter-clockwise turn needed (e.g., UP -> LEFT)\n                turn_actions_for_move.append(_LEFT)\n            \n            # The full sequence of actions to reach the new state: turns + move\n            next_actions = turn_actions_for_move + [move_action]\n            \n            # The key for the visited set includes the new position and the resulting direction\n            new_state_key = (nx, ny, resulting_dir_after_move)\n\n            if new_state_key not in visited:\n                visited.add(new_state_key)\n                queue.append((nx, ny, resulting_dir_after_move, path_actions + next_actions))\n\n        # 2. Try turning without moving (staying at current position)\n        \n        # Turn Left action\n        new_dir_left = (pdir - 1 + 4) % 4\n        new_state_key_left = (px, py, new_dir_left)\n        if new_state_key_left not in visited:\n            visited.add(new_state_key_left)\n            queue.append((px, py, new_dir_left, path_actions + [_LEFT]))\n        \n        # Turn Right action\n        new_dir_right = (pdir + 1) % 4\n        new_state_key_right = (px, py, new_dir_right)\n        if new_state_key_right not in visited:\n            visited.add(new_state_key_right)\n            queue.append((px, py, new_dir_right, path_actions + [_RIGHT]))\n\n    # If the queue becomes empty and no path was found, return an empty list\n    return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:47:51.016165", "function_name": "collect", "function_body": "  import collections # Must be imported inside the function as per instructions\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n  \n  # Define direction constants (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  _DIR_UP = 0\n  _DIR_RIGHT = 1\n  _DIR_DOWN = 2\n  _DIR_LEFT = 3\n  \n  # Map directions to (delta_x, delta_y) for movement\n  _DIR_TO_DELTA = {\n      _DIR_UP: (0, -1),\n      _DIR_RIGHT: (1, 0),\n      _DIR_DOWN: (0, 1),\n      _DIR_LEFT: (-1, 0),\n  }\n\n  # Map directions to the corresponding move action\n  _DIR_TO_MOVE_ACTION = {\n      _DIR_UP: _UP,\n      _DIR_RIGHT: _RIGHT,\n      _DIR_DOWN: _DOWN,\n      _DIR_LEFT: _LEFT,\n  }\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Get current agent direction (convert one-hot array to integer)\n  current_dir_int = np.argmax(features_dict['direction'])\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Identify obstacle indices. Assuming water and stone are obstacles.\n  obstacle_indices = {env.world.water_index, env.world.stone_index}\n\n  def _is_blocked(x, y):\n      \"\"\"Checks if a given grid cell (x, y) is out of bounds or contains an obstacle.\"\"\"\n      # Check if out of bounds\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return True\n      # Check if the cell contains any obstacle kind\n      for obstacle_kind in obstacle_indices:\n          if current_grid[x, y, obstacle_kind] == 1:\n              return True\n      return False\n  \n  # Find all locations where the primitive exists on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell\n      if current_grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  # Pre-compute all target interaction states (x, y, facing_direction)\n  # These are the states from which the agent can successfully _USE the primitive.\n  target_interaction_states = set()\n  for target_x, target_y in primitive_locations:\n      # Candidate 1: Agent at (target_x - 1, target_y) needs to face RIGHT\n      if not _is_blocked(target_x - 1, target_y):\n          target_interaction_states.add((target_x - 1, target_y, _DIR_RIGHT))\n      \n      # Candidate 2: Agent at (target_x + 1, target_y) needs to face LEFT\n      if not _is_blocked(target_x + 1, target_y):\n          target_interaction_states.add((target_x + 1, target_y, _DIR_LEFT))\n\n      # Candidate 3: Agent at (target_x, target_y - 1) needs to face DOWN\n      if not _is_blocked(target_x, target_y - 1):\n          target_interaction_states.add((target_x, target_y - 1, _DIR_DOWN))\n      \n      # Candidate 4: Agent at (target_x, target_y + 1) needs to face UP\n      if not _is_blocked(target_x, target_y + 1):\n          target_interaction_states.add((target_x, target_y + 1, _DIR_UP))\n  \n  if not target_interaction_states:\n      # This can happen if all primitive locations are completely surrounded by obstacles\n      # and there's no valid adjacent cell to stand on.\n      return []\n\n  # BFS Initialization\n  # Queue stores (x, y, direction, path_actions_list)\n  q = collections.deque()\n  # Visited set stores (x, y, direction) tuples to avoid cycles and redundant paths\n  visited = set() \n\n  # Add the agent's current state to the queue\n  start_state = (current_px, current_py, current_dir_int)\n  q.append((current_px, current_py, current_dir_int, []))\n  visited.add(start_state)\n\n  while q:\n      px, py, pdir, path_so_far = q.popleft()\n\n      # Check if the current state (position and direction) is a target interaction point.\n      # If it is, we have found the shortest path to an interaction point.\n      if (px, py, pdir) in target_interaction_states:\n          # Append the USE action and return the path\n          return path_so_far + [_USE]\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n\n      # 1. Try to Move Forward\n      dx, dy = _DIR_TO_DELTA[pdir]\n      nx, ny = px + dx, py + dy\n      \n      # Check if the new position is valid (within bounds and not blocked by an obstacle)\n      if not _is_blocked(nx, ny):\n          next_state_move = (nx, ny, pdir)\n          # If this new state (position and direction) hasn't been visited yet\n          if next_state_move not in visited:\n              visited.add(next_state_move)\n              q.append((nx, ny, pdir, path_so_far + [_DIR_TO_MOVE_ACTION[pdir]]))\n\n      # 2. Try to Turn Left\n      new_dir_left = (pdir - 1 + 4) % 4 # Ensure direction wraps around (0-3)\n      next_state_left = (px, py, new_dir_left)\n      # If this new state (same position, new direction) hasn't been visited yet\n      if next_state_left not in visited:\n          visited.add(next_state_left)\n          q.append((px, py, new_dir_left, path_so_far + [_LEFT]))\n\n      # 3. Try to Turn Right\n      new_dir_right = (pdir + 1) % 4 # Ensure direction wraps around (0-3)\n      next_state_right = (px, py, new_dir_right)\n      # If this new state (same position, new direction) hasn't been visited yet\n      if next_state_right not in visited:\n          visited.add(next_state_right)\n          q.append((px, py, new_dir_right, path_so_far + [_RIGHT]))\n            \n  # If the BFS queue becomes empty and no path was found to any target interaction state\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:49:20.940968", "function_name": "collect", "function_body": "  # Action constants (these are typically defined globally, but placed here due to \"only return code inside the function\" constraint)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n  ALL_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n  # The initial state from which to plan the collection\n  initial_craft_state = env._current_state\n\n  # Queue for Breadth-First Search (BFS)\n  # Each element in the queue is a tuple: (current_CraftState_object, list_of_actions_taken_to_reach_this_state)\n  q = collections.deque()\n  q.append((initial_craft_state, []))\n\n  # Visited set to prevent revisiting states and cycles in the search.\n  # A state is uniquely identified by (agent_position, agent_direction, inventory_tuple, flattened_grid_tuple).\n  # We convert numpy arrays to tuples to make them hashable for the set.\n  visited = set()\n  visited.add((\n      initial_craft_state.pos,\n      initial_craft_state.dir,\n      tuple(initial_craft_state.inventory),\n      tuple(initial_craft_state.grid.flatten())\n  ))\n\n  # Maximum number of BFS nodes to explore to prevent excessively long searches,\n  # especially if the goal is unreachable or the environment is very large.\n  MAX_BFS_NODES_TO_EXPLORE = 10000 \n  nodes_explored = 0\n\n  while q and nodes_explored < MAX_BFS_NODES_TO_EXPLORE:\n    current_state, actions_taken = q.popleft()\n    nodes_explored += 1\n\n    # Check if the primitive has been successfully collected in the current state's inventory.\n    # The `satisfies` method of CraftState checks if `inventory[goal_arg] > 0`.\n    # `goal_name` is ignored, so we pass None. `primitive` is the `goal_arg`.\n    if current_state.satisfies(None, primitive):\n      return actions_taken  # Goal achieved, return the sequence of actions that led to it\n\n    # Explore all possible actions from the current state\n    for action in ALL_ACTIONS:\n      # Simulate the action. CraftState.step returns a new CraftState instance,\n      # which is crucial for BFS as it doesn't modify the current_state in place.\n      _reward, next_state = current_state.step(action)\n\n      # Create a hashable representation of the new state for the 'visited' set\n      next_state_hashable = (\n          next_state.pos,\n          next_state.dir,\n          tuple(next_state.inventory),\n          tuple(next_state.grid.flatten())\n      )\n\n      # If this next_state has not been visited before, add it to the queue and the visited set\n      if next_state_hashable not in visited:\n        visited.add(next_state_hashable)\n        q.append((next_state, actions_taken + [action]))\n\n  # If the queue becomes empty (all reachable states explored) or the maximum\n  # number of nodes is explored without finding a path to collect the primitive,\n  # it means the primitive is unreachable or requires too many steps within the limit.\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:49:21.011075", "function_name": "collect", "function_body": "    import collections\n\n    actions_map = env.action_specs()\n    DOWN, UP, LEFT, RIGHT, USE = (\n        actions_map['DOWN'],\n        actions_map['UP'],\n        actions_map['LEFT'],\n        actions_map['RIGHT'],\n        actions_map['USE']\n    )\n\n    # Maps (dr, dc) to the action that performs that move AND the direction that move results in\n    # (dy, dx): (action, resulting_dir)\n    # Assuming directions: 0=N, 1=E, 2=S, 3=W for (row-1, col), (col+1), (row+1, col), (col-1) respectively.\n    MOVE_DELTAS = {\n        (-1, 0): (UP, 0),    # Move North (row-1), face North (0)\n        (1, 0): (DOWN, 2),   # Move South (row+1), face South (2)\n        (0, -1): (LEFT, 3),  # Move West (col-1), face West (3)\n        (0, 1): (RIGHT, 1)   # Move East (col+1), face East (1)\n    }\n\n    # Maps (dr, dc) from agent position to target item position to the required facing direction\n    FACE_DELTAS = {\n        (-1, 0): 0, # Target is North of agent, agent must face North\n        (1, 0): 2,  # Target is South of agent, agent must face South\n        (0, -1): 3, # Target is West of agent, agent must face West\n        (0, 1): 1   # Target is East of agent, agent must face East\n    }\n\n    # Maps relative direction difference to turning actions\n    # diff = (target_dir - current_dir + 4) % 4\n    # 0: no turn\n    # 1: right turn\n    # 2: two turns (e.g., right-right or left-left)\n    # 3: left turn\n    TURN_ACTIONS_MAP = {\n        0: [],\n        1: [RIGHT],\n        2: [RIGHT, RIGHT], # Can also be [LEFT, LEFT]\n        3: [LEFT]\n    }\n\n    current_state = env._current_state\n    start_pos = current_state.pos\n    start_dir = current_state.dir\n    grid = current_state.grid\n    HEIGHT, WIDTH, _ = grid.shape # grid is (HEIGHT, WIDTH, n_kinds)\n\n    # 1. Find all locations of the primitive on the grid\n    primitive_locs = []\n    for r in range(HEIGHT):\n        for c in range(WIDTH):\n            if grid[r, c, primitive] == 1:\n                primitive_locs.append((r, c))\n\n    if not primitive_locs:\n        return [] # Primitive not found on the map\n\n    # BFS state: ((row, col), current_direction, [list_of_actions_to_reach_this_state])\n    queue = collections.deque([(start_pos, start_dir, [])])\n    visited = set([(start_pos, start_dir)]) # Keep track of (position, direction) pairs visited\n\n    final_path_actions = []\n    found_path = False\n\n    while queue:\n        current_pos, current_dir, path_so_far = queue.popleft()\n        r, c = current_pos\n\n        # Check if the current state allows us to collect the primitive\n        # Iterate over all primitive locations to see if any are adjacent\n        for pr, pc in primitive_locs:\n            dr, dc = pr - r, pc - c # Delta from agent to primitive (row_delta, col_delta)\n            \n            # If the primitive is a direct neighbor (North, South, East, or West)\n            if (dr, dc) in FACE_DELTAS: \n                required_dir_to_face_primitive = FACE_DELTAS[(dr, dc)]\n                \n                # Calculate turns needed to face the primitive\n                dir_diff = (required_dir_to_face_primitive - current_dir + 4) % 4\n                turn_actions = TURN_ACTIONS_MAP[dir_diff]\n                \n                # Found a path! Add turns and the USE action\n                final_path_actions = path_so_far + turn_actions + [USE]\n                found_path = True\n                break # Exit inner loop (found an adjacent primitive)\n        \n        if found_path:\n            break # Exit BFS (shortest path found)\n\n        # 2. Explore movement actions\n        for (dr, dc), (move_action, new_dir_after_move) in MOVE_DELTAS.items():\n            nr, nc = r + dr, c + dc\n            next_pos = (nr, nc)\n\n            # Check bounds\n            if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n                continue\n\n            # Check if the next position is blocked for movement\n            is_blocked = False\n            # If the cell contains the primitive we want to collect, we generally cannot move onto it.\n            if grid[nr, nc, primitive] == 1:\n                is_blocked = True\n            else: # Check for other non-grabbable items\n                for k_idx in range(current_state.world.n_kinds):\n                    if grid[nr, nc, k_idx] == 1 and k_idx in current_state.world.non_grabbable_indices:\n                        is_blocked = True\n                        break\n            \n            if not is_blocked:\n                if (next_pos, new_dir_after_move) not in visited:\n                    visited.add((next_pos, new_dir_after_move))\n                    queue.append((next_pos, new_dir_after_move, path_so_far + [move_action]))\n\n        # 3. Explore turning actions (no position change)\n        for turn_action in [LEFT, RIGHT]:\n            if turn_action == RIGHT:\n                next_dir = (current_dir + 1) % 4\n            else: # LEFT\n                next_dir = (current_dir - 1 + 4) % 4 # Ensure positive result for modulo\n\n            if (current_pos, next_dir) not in visited:\n                visited.add((current_pos, next_dir))\n                queue.append((current_pos, next_dir, path_so_far + [turn_action]))\n\n    return final_path_actions # Returns empty list if no path found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:50:34.883520", "function_name": "collect", "function_body": "  import collections\n  import numpy as np # Used for current_grid, inventory which are numpy arrays.\n\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  _ACTION_DELTAS = {\n      _UP: (0, -1),\n      _DOWN: (0, 1),\n      _LEFT: (-1, 0),\n      _RIGHT: (1, 0),\n  }\n\n  # Get current state information\n  obs = env.observations()\n  features_dict = obs['features_dict']\n\n  current_grid = features_dict['features_global']\n  inventory = features_dict['inventory']\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape # Get dimensions from scenario\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # 1. Initial Checks\n  # If primitive already in inventory, no need to collect more (for single collection)\n  if inventory[primitive] > 0:\n    return []\n\n  # If primitive is not grabbable, it cannot be collected\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Impassable kinds (e.g., environment objects like water, stone if they block movement)\n  # Assuming environment entities are obstacles that agent cannot move onto.\n  impassable_kinds = env.world.cookbook.environment\n\n  def is_valid_and_traversable(x, y, grid, width, height, impassable_set):\n    \"\"\"Checks if a cell is within bounds and does not contain impassable objects.\"\"\"\n    if not (0 <= x < width and 0 <= y < height):\n      return False\n    # Check if the cell contains any impassable kind\n    for kind_idx in impassable_set:\n      if grid[x, y, kind_idx] == 1:\n        return False\n    return True\n\n  # 2. Find all cells containing the primitive and their traversable adjacent cells\n  # This dictionary maps (adjacent_x, adjacent_y) -> (primitive_x, primitive_y)\n  # An (adjacent_x, adjacent_y) can be the same as (primitive_x, primitive_y)\n  # if the agent can move onto the primitive's cell and interact from there.\n  potential_bfs_targets = {}\n  # Directions including (0,0) for the cell itself, and 4 cardinal neighbors\n  # This covers the 3x3 neighborhood in terms of reachability from a cardinal-moved position.\n  relative_target_positions = [(0, 0), (0, -1), (0, 1), (-1, 0), (1, 0)]\n\n  for px in range(WIDTH):\n    for py in range(HEIGHT):\n      if current_grid[px, py, primitive] == 1:\n        # This cell (px, py) contains the primitive.\n        # Find all valid and traversable cells from which the agent can interact with (px, py).\n        for dx, dy in relative_target_positions:\n            ax, ay = px + dx, py + dy # Adjacent/reachable cell coordinates\n            if is_valid_and_traversable(ax, ay, current_grid, WIDTH, HEIGHT, impassable_kinds):\n                # Store the reachable cell (ax, ay) and the primitive's location (px, py) it serves\n                potential_bfs_targets[(ax, ay)] = (px, py)\n\n  # If no primitive is found or no reachable/traversable interaction points, return empty.\n  if not potential_bfs_targets:\n    return []\n\n  # 3. BFS to find the shortest path to an adjacent cell\n  queue = collections.deque([(current_pos, [])]) # (current_node=(x, y), path_actions=[])\n  visited = set([current_pos])\n\n  best_path_actions = None\n\n  while queue:\n    curr_node, path_actions = queue.popleft()\n\n    # Check if current node is one of the desired adjacent/target locations\n    if curr_node in potential_bfs_targets:\n      best_path_actions = path_actions\n      break # Found the shortest path to any suitable interaction point\n\n    # Explore neighbors\n    for action, delta in _ACTION_DELTAS.items():\n      next_x, next_y = curr_node[0] + delta[0], curr_node[1] + delta[1]\n      next_node = (next_x, next_y)\n\n      if is_valid_and_traversable(next_x, next_y, current_grid, WIDTH, HEIGHT, impassable_kinds) and \\\n         next_node not in visited:\n        visited.add(next_node)\n        queue.append((next_node, path_actions + [action]))\n\n  # 4. Reconstruct actions\n  if best_path_actions is None:\n    return [] # No path found to any suitable interaction point\n\n  final_actions = best_path_actions\n\n  # After moving to the target cell (which is either on or adjacent to the primitive), use the item.\n  # We assume _USE works if the primitive is in the 3x3 neighborhood of the agent's final position,\n  # as suggested by CraftState.next_to. Explicit facing logic is not implemented here.\n  final_actions.append(_USE)\n\n  return final_actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:50:35.852698", "function_name": "collect", "function_body": "  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  actions_to_take = []\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell\n      if current_grid[x, y, primitive] == 1:\n        primitive_locations.append((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  # Find the closest *reachable* cell that is in the 3x3 neighborhood of any primitive location.\n  # This is an improvement over collect_v0, which only targets the primitive's exact cell,\n  # recognizing that _USE works when adjacent (within 3x3 neighborhood).\n  closest_agent_target_pos = None\n  min_distance = float('inf')\n\n  for prim_x, prim_y in primitive_locations:\n    # Iterate over the 3x3 neighborhood around the primitive's location\n    for dx in range(-1, 2):\n      for dy in range(-1, 2):\n        target_x = prim_x + dx\n        target_y = prim_y + dy\n\n        # Ensure the potential target cell for the agent is within grid boundaries\n        if 0 <= target_x < WIDTH and 0 <= target_y < HEIGHT:\n          dist = abs(target_x - current_px) + abs(target_y - current_py)\n          \n          if dist < min_distance:\n            min_distance = dist\n            closest_agent_target_pos = (target_x, target_y)\n\n  # This should not happen if primitive_locations is not empty and grid is valid, but for safety\n  if closest_agent_target_pos is None:\n    return []\n\n  target_px, target_py = closest_agent_target_pos\n\n  # Simulate agent movement to generate path actions to the determined target cell\n  sim_px, sim_py = current_pos\n\n  # Move horizontally first\n  while sim_px != target_px:\n    if sim_px < target_px:\n      actions_to_take.append(_RIGHT)\n      sim_px += 1\n    else: # sim_px > target_px\n      actions_to_take.append(_LEFT)\n      sim_px -= 1\n\n  # Then move vertically\n  while sim_py != target_py:\n    if sim_py < target_py:\n      actions_to_take.append(_DOWN)\n      sim_py += 1\n    else: # sim_py > target_py\n      actions_to_take.append(_UP)\n      sim_py -= 1\n\n  # Once the agent is at the target cell (which is in the 3x3 neighborhood of a primitive), use the item\n  actions_to_take.append(_USE)\n\n  return actions_to_take", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:52:11.553141", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dy == 1 and dx == 0: return SOUTH_DIR\n    if dy == -1 and dx == 0: return NORTH_DIR\n    return None # Should not happen if agent_pos and item_pos are cardinally adjacent\n\n  # Helper function: Checks if a cell is traversable (no non-grabbable items)\n  def _is_traversable(grid, x, y, non_grabbable_indices, grid_width, grid_height):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item (obstacle) is at (x, y)\n    for k_idx in non_grabbable_indices:\n      if grid[y, x, k_idx] == 1:\n        return False\n    return True\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Improvement for v2: Check if the primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Get non-grabbable indices for traversability check\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Prepare BFS goal states: (agent_x, agent_y, agent_facing_dir)\n  # These are the states from which the 'USE' action can be performed to collect the primitive.\n  bfs_target_agent_states = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells for the agent to stand on\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (dx_adj, dy_adj) from item to agent\n      adj_x, adj_y = item_x + dx_adj, item_y + dy_adj\n\n      if _is_traversable(grid, adj_x, adj_y, non_grabbable_indices, grid_width, grid_height):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_target_agent_states.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_target_agent_states:\n    return [] # No traversable adjacent positions from which to collect the primitive\n\n  # BFS setup\n  # Queue stores (x, y, dir) tuples representing agent's state\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Parent map to reconstruct the path: {child_state: (parent_state, action_to_child)}\n  parent_map = {} \n  \n  found_goal_state = None # Stores the (x, y, dir) of the goal state once found\n\n  # Movement actions and their effects: (dx, dy, resulting_direction)\n  movement_actions_map = {\n      UP_ACTION: (0, -1, NORTH_DIR),\n      DOWN_ACTION: (0, 1, SOUTH_DIR),\n      LEFT_ACTION: (-1, 0, WEST_DIR),\n      RIGHT_ACTION: (1, 0, EAST_DIR)\n  }\n  \n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state is one of the goal states\n    if (curr_x, curr_y, curr_dir) in bfs_target_agent_states:\n      found_goal_state = (curr_x, curr_y, curr_dir)\n      break # Found the shortest path to a goal\n    \n    # Explore movement actions: agent moves and its direction is set by the movement\n    for action, (dx, dy, resulting_dir) in movement_actions_map.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = resulting_dir\n\n      next_state = (next_x, next_y, next_dir)\n      if _is_traversable(grid, next_x, next_y, non_grabbable_indices, grid_width, grid_height):\n        if next_state not in visited:\n          visited.add(next_state)\n          parent_map[next_state] = ((curr_x, curr_y, curr_dir), action)\n          queue.append(next_state)\n    \n    # Explore turning actions: agent changes direction without changing position\n    # This assumes LEFT_ACTION and RIGHT_ACTION can also function as in-place turns\n    # when no movement occurs.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]: \n      next_x, next_y = curr_x, curr_y # Position does not change for a pure turn\n      \n      # Calculate new direction based on the turn action\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4 # Turn clockwise\n      \n      next_state = (next_x, next_y, next_dir)\n      if next_state not in visited: # No traversability check needed as position doesn't change\n        visited.add(next_state)\n        parent_map[next_state] = ((curr_x, curr_y, curr_dir), turn_action)\n        queue.append(next_state)\n\n  if found_goal_state is None:\n    return [] # No path found to any primitive's collection point\n\n  # Reconstruct the path from the goal state back to the initial state\n  actions = []\n  curr_state = found_goal_state\n  initial_state = (initial_agent_x, initial_agent_y, initial_agent_dir)\n\n  while curr_state != initial_state:\n    parent_state, action = parent_map[curr_state]\n    actions.insert(0, action) # Prepend action to build path in correct order\n    curr_state = parent_state\n  \n  # Finally, append the USE action after reaching the correct position and facing direction.\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:52:12.534992", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dy == 1 and dx == 0: return SOUTH_DIR\n    if dy == -1 and dx == 0: return NORTH_DIR\n    return None # Should not happen if agent_pos and item_pos are cardinally adjacent\n\n  # Helper function: Checks if a cell is traversable (no non-grabbable items)\n  def _is_traversable(grid, x, y, non_grabbable_indices, grid_width, grid_height):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item (obstacle) is at (x, y)\n    for k_idx in non_grabbable_indices:\n      if grid[y, x, k_idx] == 1:\n        return False\n    return True\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Optimization: Check if the primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Get non-grabbable indices for traversability check\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Prepare BFS goal states: (agent_x, agent_y, agent_facing_dir)\n  # These are the states from which the 'USE' action can be performed to collect the primitive.\n  bfs_target_agent_states = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells for the agent to stand on\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (dx_adj, dy_adj) from item to agent\n      adj_x, adj_y = item_x + dx_adj, item_y + dy_adj\n\n      if _is_traversable(grid, adj_x, adj_y, non_grabbable_indices, grid_width, grid_height):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_target_agent_states.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_target_agent_states:\n    return [] # No traversable adjacent positions from which to collect the primitive\n\n  # BFS setup\n  # Queue stores (x, y, dir) tuples\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Parent map to reconstruct the path: {child_state: (parent_state, action_to_child)}\n  parent_map = {} \n  \n  found_goal_state = None # Stores the (x, y, dir) of the goal state once found\n\n  # Action definitions for BFS exploration:\n  # Movement actions and their corresponding (dx, dy)\n  movement_deltas = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n  \n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state is one of the goal states\n    if (curr_x, curr_y, curr_dir) in bfs_target_agent_states:\n      found_goal_state = (curr_x, curr_y, curr_dir)\n      break # Found the shortest path to a goal\n    \n    # Explore movement actions (UP, DOWN, LEFT, RIGHT)\n    for action, (dx, dy) in movement_deltas.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      \n      # Determine the new direction after taking a movement action\n      # The agent's direction is set to match the direction of movement\n      if action == UP_ACTION: next_dir = NORTH_DIR\n      elif action == DOWN_ACTION: next_dir = SOUTH_DIR\n      elif action == LEFT_ACTION: next_dir = WEST_DIR\n      elif action == RIGHT_ACTION: next_dir = EAST_DIR\n      else: next_dir = curr_dir # Should not be reached for these actions\n\n      next_state = (next_x, next_y, next_dir)\n      if _is_traversable(grid, next_x, next_y, non_grabbable_indices, grid_width, grid_height):\n        if next_state not in visited:\n          visited.add(next_state)\n          parent_map[next_state] = ((curr_x, curr_y, curr_dir), action)\n          queue.append(next_state)\n    \n    # Explore turning actions (LEFT, RIGHT) - position doesn't change\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]:\n      next_x, next_y = curr_x, curr_y # Position remains the same\n      \n      # Calculate new direction based on the turn action\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4 # Turn clockwise\n      \n      next_state = (next_x, next_y, next_dir)\n      if next_state not in visited:\n        visited.add(next_state)\n        parent_map[next_state] = ((curr_x, curr_y, curr_dir), turn_action)\n        queue.append(next_state)\n\n  if found_goal_state is None:\n    return [] # No path found to any primitive's collection point\n\n  # Reconstruct the path from the goal state back to the initial state\n  actions = []\n  curr_state = found_goal_state\n  initial_state = (initial_agent_x, initial_agent_y, initial_agent_dir)\n\n  while curr_state != initial_state:\n    parent_state, action = parent_map[curr_state]\n    actions.insert(0, action) # Prepend action to build path in correct order\n    curr_state = parent_state\n  \n  # Finally, append the USE action after reaching the correct position and facing direction.\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:53:24.431905", "function_name": "collect", "function_body": "  import collections\n\n  # Constants for actions based on CraftLab.action_specs\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  all_actions = []\n  max_total_steps = 500\n\n  # Reset the environment to a fresh state for this collection attempt\n  obs = env.reset()\n\n  # Action mapping for BFS movement\n  ACTION_DR_DC = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  for step_count in range(max_total_steps):\n      # 1. Check if the primitive is already collected in the inventory\n      inventory = obs['features_dict']['inventory']\n      if inventory[primitive] > 0:\n          break  # Goal achieved, exit the loop\n\n      # 2. Get current state information from observations\n      grid = obs['features_dict']['features_global']\n      H, W, n_kinds = grid.shape  # Grid dimensions\n      \n      # Agent's current position (row, col) from normalized coordinates\n      current_pos_normalized = obs['features_dict']['pos']\n      current_pos = (int(current_pos_normalized[0] * H), int(current_pos_normalized[1] * W))\n\n      # 3. Identify obstacles: cells containing any non-grabbable entity (e.g., water, stone, walls)\n      # These cells are generally not traversable by the agent.\n      obstacles = set()\n      for r in range(H):\n          for c in range(W):\n              is_obstacle_cell = False\n              # Check all kinds present at (r,c)\n              for k_idx in range(n_kinds):\n                  # An obstacle cell is one that contains an entity that cannot be picked up,\n                  # and thus is likely impassable terrain.\n                  if grid[r, c, k_idx] == 1 and k_idx in env.world.non_grabbable_indices:\n                      is_obstacle_cell = True\n                      break\n              if is_obstacle_cell:\n                  obstacles.add((r, c))\n      \n      # If the agent starts on an obstacle, it cannot move or interact\n      if current_pos in obstacles:\n          return [] # Cannot proceed from an obstacle location\n\n      # 4. Locate all instances of the 'primitive' entity on the grid.\n      # This 'primitive' could be a grabbable item directly on the floor\n      # or a non-grabbable environmental feature that yields the item upon 'USE' (e.g., water, stone).\n      entity_locations = []\n      for r in range(H):\n          for c in range(W):\n              if grid[r, c, primitive] == 1: # Check if the 'primitive' entity is at this grid cell\n                  entity_locations.append((r, c))\n\n      if not entity_locations:\n          # The primitive entity is not found on the grid and not in inventory.\n          # Cannot collect by interacting with a grid entity.\n          break # Exit loop, returning collected actions so far (likely empty)\n\n      # 5. Determine valid \"agent target positions\" for 'USE' action.\n      # A 'USE' action is effective if the agent is within a 3x3 neighborhood of the target entity.\n      # We find all traversable cells (not in 'obstacles') from which 'USE' could be effective.\n      target_agent_positions_for_use = set()\n      for entity_r, entity_c in entity_locations:\n          # Iterate over the 3x3 neighborhood around the entity's location\n          for dr_use in [-1, 0, 1]:\n              for dc_use in [-1, 0, 1]:\n                  potential_agent_r, potential_agent_c = entity_r + dr_use, entity_c + dc_use\n                  \n                  # Check bounds\n                  if 0 <= potential_agent_r < H and 0 <= potential_agent_c < W:\n                      # An agent can stand here IF this cell is traversable (not an obstacle)\n                      if (potential_agent_r, potential_agent_c) not in obstacles:\n                          target_agent_positions_for_use.add((potential_agent_r, potential_agent_c))\n\n      if not target_agent_positions_for_use:\n          # No safe or reachable spots from which to 'USE' the entity\n          break\n\n      # 6. Pathfinding (BFS) to reach the closest valid agent target position.\n      queue = collections.deque([(current_pos, [])])  # (position: (r, c), path_actions: list)\n      visited = {current_pos}\n      path_to_target = None\n\n      while queue:\n          (r, c), path_actions = queue.popleft()\n\n          # If current position is one of the valid 'USE' positions, we found a path\n          if (r, c) in target_agent_positions_for_use:\n              path_to_target = path_actions\n              break\n\n          # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n          for action_val, (dr, dc) in ACTION_DR_DC.items():\n              nr, nc = r + dr, c + dc\n\n              # Check bounds, if already visited, and if the cell is an obstacle\n              if 0 <= nr < H and 0 <= nc < W and (nr, nc) not in visited:\n                  if (nr, nc) not in obstacles: # Only add to queue if it's traversable\n                      visited.add((nr, nc))\n                      queue.append(((nr, nc), path_actions + [action_val]))\n\n      if path_to_target is None:\n          # Cannot reach any valid 'USE' position from current location\n          break # Exit loop, cannot collect\n\n      # 7. Execute movement actions found by BFS\n      for action in path_to_target:\n          reward, done, obs = env.step(action)\n          all_actions.append(action)\n          if done:\n              return all_actions # Episode ended prematurely\n\n          # Check if collected *during* movement (unlikely for most 'USE' interactions but good for robustness)\n          inventory = obs['features_dict']['inventory']\n          if inventory[primitive] > 0:\n              return all_actions # Collected already\n\n      # 8. After movement, execute USE action.\n      # The agent should now be at a cell from which USE is effective.\n      reward, done, obs = env.step(USE)\n      all_actions.append(USE)\n      if done:\n          return all_actions # Episode ended prematurely\n\n      # Re-check inventory after USE action to confirm collection\n      inventory = obs['features_dict']['inventory']\n      if inventory[primitive] > 0:\n          break  # Primitive collected, break outer loop\n\n  return all_actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:53:25.437509", "function_name": "collect", "function_body": "  import collections\n\n  # Constants for actions based on CraftLab.action_specs\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  all_actions = []\n  max_total_steps = 500 # A safety limit to prevent infinite loops\n\n  # Reset environment to get the initial observation\n  obs = env.reset()\n\n  # Pre-check: If the primitive is not grabbable, this function cannot collect it.\n  # Grabbable indices are found in env.world.grabbable_indices (a set of int IDs).\n  if primitive not in env.world.grabbable_indices:\n      return [] # Return empty actions if the item cannot be directly collected\n\n  for step_count in range(max_total_steps):\n      # 1. Check if the primitive is already in the agent's inventory\n      inventory = obs['features_dict']['inventory']\n      if inventory[primitive] > 0:\n          break # Goal achieved: primitive collected, exit loop\n\n      # 2. Get current state information from the observation\n      grid = obs['features_dict']['features_global']\n      H, W, _ = grid.shape # H = grid height (rows), W = grid width (columns)\n      \n      # Agent's current position (row, col) from normalized coordinates\n      current_pos_normalized = obs['features_dict']['pos']\n      current_pos = (int(current_pos_normalized[0] * H), int(current_pos_normalized[1] * W))\n\n      # 3. Identify obstacles on the grid. Obstacles are cells containing any non-grabbable entity.\n      # These cells are impassable for the agent.\n      obstacles = set()\n      # Get the set of non-grabbable kind indices once for efficiency\n      non_grabbable_kinds = env.world.non_grabbable_indices \n      \n      for r in range(H):\n          for c in range(W):\n              # Iterate directly over known non-grabbable kinds to check for obstacles\n              for k_idx in non_grabbable_kinds:\n                  if grid[r, c, k_idx] == 1: # If this cell contains a non-grabbable item\n                      obstacles.add((r, c))\n                      break # Mark as obstacle and move to next cell\n\n      # Edge case: If the agent starts on an obstacle, it cannot move or collect.\n      if current_pos in obstacles:\n          return [] # Indicate inability to proceed\n\n      # 4. Locate all instances of the target primitive on the grid\n      primitive_locations = []\n      for r in range(H):\n          for c in range(W):\n              if grid[r, c, primitive] == 1:\n                  primitive_locations.append((r, c))\n\n      if not primitive_locations:\n          # Primitive not found on the grid and not in inventory. Nothing left to collect.\n          break # Exit loop, as no more items to target\n\n      # 5. Determine valid \"agent target positions\" for the 'USE' action.\n      # The 'USE' action is effective if the agent is within a 3x3 neighborhood of the item.\n      # We need to find traversable cells from which the 'USE' action can be performed.\n      target_agent_positions_for_use = set()\n      for prim_r, prim_c in primitive_locations:\n          # Check the 3x3 neighborhood around the primitive's location\n          for dr_use in [-1, 0, 1]:\n              for dc_use in [-1, 0, 1]:\n                  potential_agent_r, potential_agent_c = prim_r + dr_use, prim_c + dc_use\n                  \n                  # Ensure the potential agent position is within grid boundaries\n                  if 0 <= potential_agent_r < H and 0 <= potential_agent_c < W:\n                      # An agent can stand here IF this cell is traversable (not an obstacle)\n                      if (potential_agent_r, potential_agent_c) not in obstacles:\n                          target_agent_positions_for_use.add((potential_agent_r, potential_agent_c))\n\n      if not target_agent_positions_for_use:\n          # No reachable and safe spots from which to 'USE' the primitive (e.g., all surrounding cells are obstacles)\n          break # Cannot collect this primitive in the current environment\n\n      # 6. Pathfinding (BFS) to find the shortest path to any valid agent target position.\n      # The queue stores (current_position: (r, c), path_taken_so_far: list_of_actions)\n      queue = collections.deque([(current_pos, [])])\n      visited = {current_pos} # Keep track of visited cells to prevent cycles and redundant work\n      path_to_target = None\n\n      # Mapping for movement actions to row/column changes\n      ACTION_DR_DC = {\n          DOWN: (1, 0),\n          UP: (-1, 0),\n          LEFT: (0, -1),\n          RIGHT: (0, 1)\n      }\n\n      while queue:\n          (r, c), path_actions = queue.popleft()\n\n          # If the current position is one of the target 'USE' spots, we've found a path\n          if (r, c) in target_agent_positions_for_use:\n              path_to_target = path_actions\n              break # Shortest path found\n\n          # Explore neighboring cells (UP, DOWN, LEFT, RIGHT)\n          for action_val, (dr, dc) in ACTION_DR_DC.items():\n              nr, nc = r + dr, c + dc # Calculate new row, new column\n\n              # Check if the new cell is valid: within bounds, not yet visited, and not an obstacle\n              if (0 <= nr < H and 0 <= nc < W and\n                  (nr, nc) not in visited and\n                  (nr, nc) not in obstacles):\n                  \n                  visited.add((nr, nc)) # Mark as visited\n                  queue.append(((nr, nc), path_actions + [action_val])) # Add to queue with updated path\n\n      if path_to_target is None:\n          # No path could be found to any valid 'USE' position.\n          break # Cannot reach the primitive\n\n      # 7. Execute the movement actions found by BFS\n      for action in path_to_target:\n          reward, done, obs = env.step(action)\n          all_actions.append(action)\n          if done:\n              return all_actions # Episode terminated prematurely (e.g., max_steps reached)\n          \n          # Check inventory after each movement step. In case the primitive was collected by moving onto it.\n          inventory = obs['features_dict']['inventory']\n          if inventory[primitive] > 0:\n              return all_actions # Primitive collected, return actions\n\n      # 8. After reaching the vicinity, execute the 'USE' action to attempt collection.\n      reward, done, obs = env.step(USE)\n      all_actions.append(USE)\n      if done:\n          return all_actions # Episode terminated prematurely\n\n      # Final check of inventory after the 'USE' action\n      inventory = obs['features_dict']['inventory']\n      if inventory[primitive] > 0:\n          break # Primitive successfully collected, exit the main loop\n\n  return all_actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:55:14.768110", "function_name": "collect", "function_body": "  actions_taken = []\n  \n  # Reset the environment to get initial state\n  _ = env.reset()\n\n  # Action mappings as per CraftWorld/env_factory.py for consistency\n  _MOVE_NORTH = 0\n  _MOVE_EAST = 1\n  _MOVE_SOUTH = 2\n  _MOVE_WEST = 3\n  _USE = 4\n\n  # Mapping of relative movements (forward, backward, left, right)\n  # to absolute actions based on current agent direction (N, E, S, W)\n  # Rows: 0=Relative Forward, 1=Relative Backward, 2=Relative Left, 3=Relative Right\n  # Cols: Agent Direction (0:N, 1:E, 2:S, 3:W)\n  RELATIVE_TO_ABS_ACTION = np.array([\n      [_MOVE_NORTH, _MOVE_EAST,  _MOVE_SOUTH, _MOVE_WEST],  # Relative Forward (dr_ego < 0)\n      [_MOVE_SOUTH, _MOVE_WEST,  _MOVE_NORTH, _MOVE_EAST],  # Relative Backward (dr_ego > 0)\n      [_MOVE_WEST,  _MOVE_NORTH, _MOVE_EAST,  _MOVE_SOUTH], # Relative Left (dc_ego < 0)\n      [_MOVE_EAST,  _MOVE_SOUTH, _MOVE_WEST,  _MOVE_NORTH]   # Relative Right (dc_ego > 0)\n  ])\n\n  # Max iterations for the collection attempt to prevent infinite loops in search.\n  # This is separate from env.max_steps, which governs the episode duration.\n  MAX_SEARCH_ITERATIONS = 500 \n\n  current_state = env._current_state\n\n  for _ in range(MAX_SEARCH_ITERATIONS):\n      # 1. Check if the primitive is already in inventory\n      if current_state.inventory[primitive] > 0:\n          break\n\n      # 2. Check if the primitive is in the agent's immediate vicinity (3x3 neighborhood)\n      if current_state.next_to(primitive):\n          actions_taken.append(_USE)\n          _, done, _ = env.step(_USE)\n          current_state = env._current_state # Update current state after action\n          if done or current_state.inventory[primitive] > 0:\n              break # Goal achieved or episode ended\n      else:\n          # 3. Primitive not next to agent, need to move towards it or explore\n          obs_dict = env.observations()['features_dict']\n          features_ego = obs_dict['features_ego'] # Egocentric view (ego_h, ego_w, n_kinds)\n          current_dir_one_hot = obs_dict['direction'] # One-hot array [N, E, S, W]\n\n          ego_h, ego_w, _ = features_ego.shape\n          agent_ego_r, agent_ego_c = ego_h // 2, ego_w // 2\n\n          # Find the primitive in the egocentric view\n          primitive_coords_ego = np.where(features_ego[:, :, primitive] == 1)\n          \n          target_r_ego, target_c_ego = -1, -1\n          min_dist_sq = float('inf')\n\n          if primitive_coords_ego[0].size > 0:\n              # If primitive is visible, find the closest instance in egocentric view\n              for r, c in zip(*primitive_coords_ego):\n                  dist_sq = (r - agent_ego_r)**2 + (c - agent_ego_c)**2\n                  if dist_sq < min_dist_sq:\n                      min_dist_sq = dist_sq\n                      target_r_ego, target_c_ego = r, c\n          \n          action_to_take = None\n\n          if target_r_ego != -1: # Primitive found in egocentric view\n              # Calculate relative displacement in egocentric coordinates\n              # dr_ego < 0 means target is \"forward\" relative to agent's view\n              # dr_ego > 0 means target is \"backward\" relative to agent's view\n              # dc_ego < 0 means target is \"left\" relative to agent's view\n              # dc_ego > 0 means target is \"right\" relative to agent's view\n              dr_ego = target_r_ego - agent_ego_r\n              dc_ego = target_c_ego - agent_ego_c\n              \n              # Convert agent's one-hot direction to index (0:N, 1:E, 2:S, 3:W)\n              agent_abs_dir_idx = np.argmax(current_dir_one_hot)\n\n              # Prioritize movement in the direction with larger egocentric displacement\n              if abs(dr_ego) > abs(dc_ego): # Prioritize forward/backward movement\n                  if dr_ego < 0: # Target is forward\n                      action_to_take = RELATIVE_TO_ABS_ACTION[0, agent_abs_dir_idx]\n                  else: # Target is backward\n                      action_to_take = RELATIVE_TO_ABS_ACTION[1, agent_abs_dir_idx]\n              elif abs(dc_ego) > 0: # Prioritize left/right movement if not primarily forward/backward\n                  if dc_ego < 0: # Target is left\n                      action_to_take = RELATIVE_TO_ABS_ACTION[2, agent_abs_dir_idx]\n                  else: # Target is right\n                      action_to_take = RELATIVE_TO_ABS_ACTION[3, agent_abs_dir_idx]\n              else: # dr_ego == 0 and dc_ego == 0: Primitive is at agent's exact egocentric position\n                  # This implies it should have been picked up already or is non-grabbable/unreachable.\n                  # As a fallback, try to move North to escape potential loop.\n                  action_to_take = _MOVE_NORTH\n\n          if action_to_take is None:\n              # Fallback: Primitive not visible or no clear action determined. Simple exploration.\n              # Try moving North, if blocked, try East, then South, then West.\n              # This ensures basic movement and coverage if target is not in view.\n              possible_moves = [_MOVE_NORTH, _MOVE_EAST, _MOVE_SOUTH, _MOVE_WEST]\n              moved = False\n              for move_action in possible_moves:\n                  temp_pos = current_state.pos # Store current position to check if move was successful\n                  _, done, _ = env.step(move_action)\n                  actions_taken.append(move_action)\n                  current_state = env._current_state\n                  if done: return actions_taken # Episode ended (e.g., max_steps reached)\n                  if current_state.pos != temp_pos: # Agent successfully moved\n                      moved = True\n                      break\n              if not moved:\n                  # Agent is stuck and cannot move in any cardinal direction. Break to prevent infinite loop.\n                  break\n          else:\n              # Execute the determined action\n              actions_taken.append(action_to_take)\n              _, done, _ = env.step(action_to_take)\n              current_state = env._current_state\n              if done:\n                  break # Episode ended (e.g., max_steps reached)\n\n  return actions_taken", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:55:14.837112", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Constants for actions and movement deltas, defined here to be self-contained within the function\n    # based on CraftLab.action_specs(): DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    _DELTA_TO_ACTION = {\n        (1, 0): 0,  # (dr, dc): action_id (e.g., (1,0) is DOWN)\n        (-1, 0): 1,  # UP\n        (0, -1): 2,  # LEFT\n        (0, 1): 3,  # RIGHT\n    }\n    _MOVE_DELTAS = list(_DELTA_TO_ACTION.keys()) # List of (dr, dc) tuples for iterating neighbors\n    _USE_ACTION = 4\n\n    # Helper function to check if a position is within grid boundaries\n    def _is_valid_pos(r, c, grid_shape):\n        width, height, _ = grid_shape\n        return 0 <= r < width and 0 <= c < height\n\n    # Helper function to check if a position is 4-way adjacent to the primitive\n    def _is_adjacent_to_primitive(agent_pos, grid, primitive_idx):\n        r, c = agent_pos\n        grid_shape = grid.shape\n        for dr, dc in _MOVE_DELTAS:\n            nr, nc = r + dr, c + dc\n            # Check if neighbor is valid and contains the primitive\n            if _is_valid_pos(nr, nc, grid_shape) and grid[nr, nc, primitive_idx] == 1:\n                return True\n        return False\n\n    # Access the current state from the CraftLab environment\n    current_state = env._current_state\n\n    # Get grid and agent's current position\n    grid = current_state.grid\n    agent_pos = current_state.pos\n\n    # Check if the agent is already adjacent to the primitive\n    if _is_adjacent_to_primitive(agent_pos, grid, primitive):\n        return [_USE_ACTION]\n\n    # Initialize BFS queue with (position, path_to_reach_position)\n    q = collections.deque([(agent_pos, [])])\n    # Keep track of visited positions to avoid cycles and redundant exploration\n    visited = {agent_pos}\n\n    while q:\n        curr_pos, path_so_far = q.popleft()\n        r, c = curr_pos\n\n        # Explore all 4 possible movement directions\n        for dr, dc in _MOVE_DELTAS:\n            next_r, next_c = r + dr, c + dc\n            next_pos = (next_r, next_c)\n\n            # Check if the next position is valid (within grid boundaries) and not yet visited\n            # Assuming all valid cells are walkable. If there were \"wall\" or \"water\" types that block movement,\n            # an additional check for grid[next_r, next_c, blocked_kind_idx] == 0 would be needed.\n            if _is_valid_pos(next_r, next_c, grid.shape) and next_pos not in visited:\n                visited.add(next_pos)\n                \n                # Determine the action required to move to next_pos\n                action_to_reach = _DELTA_TO_ACTION[(dr, dc)]\n                new_path = path_so_far + [action_to_reach]\n\n                # If this new position is adjacent to the primitive, we found the shortest path\n                if _is_adjacent_to_primitive(next_pos, grid, primitive):\n                    return new_path + [_USE_ACTION]\n                else:\n                    # Otherwise, add to queue for further exploration\n                    q.append((next_pos, new_path))\n\n    # If the queue is exhausted and no path was found (e.g., primitive not on the map or unreachable)\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:56:34.968656", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:56:35.895043", "function_name": "collect", "function_body": "  # Assuming 'from collections import deque' is present at the module level of the file.\n\n  actions_taken = []\n  \n  action_map = env.action_specs()\n  # Unpack action IDs for clarity and direct use\n  UP, DOWN, LEFT, RIGHT, USE = (action_map['UP'], action_map['DOWN'],\n                                action_map['LEFT'], action_map['RIGHT'],\n                                action_map['USE'])\n  \n  # Map (dx, dy) coordinate changes to their corresponding action IDs\n  # CraftWorld typically uses (x, y) where x is horizontal, y is vertical.\n  # UP: y decreases, DOWN: y increases, LEFT: x decreases, RIGHT: x increases.\n  move_actions_deltas = {\n      (0, -1): UP,\n      (0, 1): DOWN,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT\n  }\n  \n  world = env.world # Get reference to the CraftWorld instance for environment details\n  \n  # Primitives are items that can be picked up. If the goal `primitive` is not\n  # in the list of grabbable items, this function cannot collect it.\n  if primitive not in world.grabbable_indices:\n      return []\n\n  MAX_COLLECT_STEPS = 200 # A safety limit to prevent infinite loops\n\n  def find_path_bfs(start_pos, target_primitive_idx, current_grid, world_ref):\n      \"\"\"\n      Performs a Breadth-First Search (BFS) to find the shortest path from `start_pos`\n      to any cell containing `target_primitive_idx`.\n      \n      Args:\n          start_pos (tuple): Agent's current (x, y) position.\n          target_primitive_idx (int): The index of the primitive kind to find.\n          current_grid (numpy.ndarray): The current state of the grid.\n          world_ref (CraftWorld): Reference to the CraftWorld instance for obstacle info.\n\n      Returns:\n          list: A list of action IDs representing the shortest path, or None if no path found.\n      \"\"\"\n      grid_width, grid_height, _ = current_grid.shape\n\n      # Define what entity types act as obstacles (cannot be walked through).\n      # This typically includes non-grabbable environment items (like water, stone)\n      # and workshop locations (like workbench, furnace).\n      obstacle_indices = world_ref.non_grabbable_indices.union(world_ref.workshop_indices)\n\n      def is_walkable(x, y):\n          \"\"\"Checks if a given grid cell (x, y) is within bounds and contains no obstacles.\"\"\"\n          if not (0 <= x < grid_width and 0 <= y < grid_height):\n              return False # Out of bounds\n          # Check if the cell contains any obstacle kind\n          for idx in obstacle_indices:\n              if current_grid[x, y, idx] == 1:\n                  return False # Contains an obstacle\n          return True # The cell is within bounds and free of obstacles\n\n      # BFS queue: stores (current_coordinates, path_actions_taken_to_reach_here)\n      queue = deque([(start_pos, [])])\n      visited = {start_pos} # Set to keep track of visited coordinates to avoid loops\n\n      while queue:\n          (curr_x, curr_y), path = queue.popleft()\n\n          # If the current cell contains the target primitive, we've found a path to it.\n          # The agent can then use the 'USE' action once it arrives at this cell.\n          if current_grid[curr_x, curr_y, target_primitive_idx] == 1:\n              return path\n\n          # Explore all four cardinal neighbors (UP, DOWN, LEFT, RIGHT)\n          for (dx, dy), action_id in move_actions_deltas.items():\n              next_x, next_y = curr_x + dx, curr_y + dy\n              next_pos = (next_x, next_y)\n\n              if is_walkable(next_x, next_y) and next_pos not in visited:\n                  visited.add(next_pos)\n                  queue.append((next_pos, path + [action_id]))\n      \n      return None # No path found to any instance of the primitive on the grid\n\n  # Main loop for the collection process\n  for _ in range(MAX_COLLECT_STEPS):\n      # Access the current state of the environment\n      current_state = env._current_state \n      \n      # 1. Check if the primitive is already in the agent's inventory\n      if current_state.inventory[primitive] > 0:\n          return actions_taken # Goal achieved, primitive collected\n\n      current_pos = current_state.pos\n      grid = current_state.grid\n      \n      # 2. Check if the primitive is in the agent's 3x3 neighborhood (including its own cell).\n      # If so, the next action should be 'USE' to pick it up.\n      if current_state.next_to(primitive):\n          _reward, done, _observations = env.step(USE) # Perform the USE action\n          actions_taken.append(USE)\n          if done:\n              break # Episode ended (e.g., max_steps reached)\n          continue # Re-check inventory in the next iteration after using\n\n      # 3. If not in inventory and not next to, find the shortest path to an instance of the primitive.\n      path_to_primitive = find_path_bfs(current_pos, primitive, grid, world)\n\n      if path_to_primitive:\n          # If a path is found, take the first step on that path.\n          next_action = path_to_primitive[0]\n          _reward, done, _observations = env.step(next_action) # Perform the movement action\n          actions_taken.append(next_action)\n          if done:\n              break # Episode ended\n      else:\n          # No path found to any instance of the primitive on the grid.\n          # This means it might be unreachable, or all instances have been collected/are gone.\n          break # Cannot collect the primitive, terminate\n\n  return actions_taken # Return the sequence of actions taken", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:58:24.701916", "function_name": "collect", "function_body": "  # Action constants (copied from problem description context)\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Direction constants (0=N, 1=E, 2=S, 3=W clockwise from North)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Get primitive's integer ID\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir \n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Impassable items are those that cannot be picked up or moved through.\n  impassable_kinds = env.world.non_grabbable_indices\n\n  def is_walkable(x, y):\n    \"\"\"Checks if a cell (x, y) is within bounds and does not contain impassable objects.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    \n    # Check if the cell contains any impassable kind\n    for kind_idx in impassable_kinds:\n      if grid[y, x, kind_idx] == 1: # Assuming 1 indicates presence\n        return False # Contains an impassable object\n    return True\n\n  # Find all locations of the primitive on the grid\n  # np.where returns (row_indices, col_indices) which correspond to (y_coords, x_coords)\n  primitive_locations = set() # Store as a set for faster lookup\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n\n  if not primitive_locations:\n    return [] # Primitive not found on the grid\n\n  # --- BFS to find the shortest path to a state from which the primitive can be 'USE'd ---\n  # BFS state: (x, y, dir) - current position and facing direction\n  # Queue stores (current_x, current_y, current_dir, list_of_actions_taken_to_reach_this_state)\n  q = collections.deque([(start_pos_x, start_pos_y, start_dir, [])])\n  # Visited set stores (x, y, dir) tuples to prevent cycles and redundant exploration\n  visited = set([(start_pos_x, start_pos_y, start_dir)])\n\n  # Define effects of movement actions: (dx, dy) change and resulting agent direction.\n  # This assumes moving UP/DOWN/LEFT/RIGHT also sets the agent's facing direction.\n  move_action_map = {\n      UP_ACTION: ((0, -1), NORTH_DIR),    # Move up (y-1), face North\n      DOWN_ACTION: ((0, 1), SOUTH_DIR),   # Move down (y+1), face South\n      LEFT_ACTION: ((-1, 0), WEST_DIR),   # Move left (x-1), face West\n      RIGHT_ACTION: ((1, 0), EAST_DIR)    # Move right (x+1), face East\n  }\n  \n  # Define effects of turning actions (position remains the same, only direction changes).\n  # This assumes LEFT_ACTION/RIGHT_ACTION can also function as pure turns when needed,\n  # consistent with how `collect_v1` implicitly uses them for turning.\n  turn_action_map = {\n      LEFT_ACTION: lambda current_dir: (current_dir - 1 + 4) % 4, # Turn counter-clockwise\n      RIGHT_ACTION: lambda current_dir: (current_dir + 1) % 4     # Turn clockwise\n  }\n\n  while q:\n    curr_x, curr_y, curr_dir, path_actions = q.popleft()\n\n    # 1. Check if the current state allows for immediate 'USE' of the primitive.\n    # Calculate the cell directly in front of the agent based on its current direction.\n    target_x_for_use, target_y_for_use = curr_x, curr_y\n    if curr_dir == NORTH_DIR:\n        target_y_for_use -= 1\n    elif curr_dir == EAST_DIR:\n        target_x_for_use += 1\n    elif curr_dir == SOUTH_DIR:\n        target_y_for_use += 1\n    elif curr_dir == WEST_DIR:\n        target_x_for_use -= 1\n    \n    # If the cell in front is within bounds and contains the target primitive.\n    if (0 <= target_x_for_use < grid_width and \n        0 <= target_y_for_use < grid_height and\n        (target_x_for_use, target_y_for_use) in primitive_locations):\n      # We have found a path to a state from which USE is possible.\n      return path_actions + [USE_ACTION]\n\n    # 2. Explore next states from the current state via available actions.\n\n    # 2a. Explore movement actions (change position AND facing direction).\n    for action, ((dx, dy), resulting_dir) in move_action_map.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = resulting_dir # Agent's direction aligns with movement.\n\n      if is_walkable(next_x, next_y):\n        next_state_key = (next_x, next_y, next_dir)\n        if next_state_key not in visited:\n          visited.add(next_state_key)\n          q.append((next_x, next_y, next_dir, path_actions + [action]))\n\n    # 2b. Explore turning actions (change facing direction ONLY, position stays the same).\n    # This covers scenarios where the agent needs to turn in place,\n    # ensuring full state space exploration for optimal pathfinding.\n    for action, get_next_dir_func in turn_action_map.items():\n      next_x, next_y = curr_x, curr_y # Position does not change.\n      next_dir = get_next_dir_func(curr_dir)\n      \n      next_state_key = (next_x, next_y, next_dir)\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_x, next_y, next_dir, path_actions + [action]))\n  \n  # If the queue becomes empty and no path was found to any collectible primitive.\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:58:25.730844", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from problem description context)\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Direction constants (0=N, 1=E, 2=S, 3=W clockwise from North)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper for movement deltas based on current direction (dx, dy)\n  # When moving FORWARD (UP_ACTION)\n  FORWARD_DELTAS = {\n      NORTH_DIR: (0, -1),  # North: move up (decrease y)\n      EAST_DIR: (1, 0),    # East: move right (increase x)\n      SOUTH_DIR: (0, 1),   # South: move down (increase y)\n      WEST_DIR: (-1, 0)    # West: move left (decrease x)\n  }\n\n  # When moving BACKWARD (DOWN_ACTION)\n  BACKWARD_DELTAS = {\n      NORTH_DIR: (0, 1),   # North: move down (increase y)\n      EAST_DIR: (-1, 0),   # East: move left (decrease x)\n      SOUTH_DIR: (0, -1),  # South: move up (decrease y)\n      WEST_DIR: (1, 0)     # West: move right (increase x)\n  }\n\n  # Get primitive's integer ID\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir \n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape \n\n  # Get non-grabbable entity indices to identify obstacles\n  # Agent cannot walk through these, consistent with how obstacles are handled.\n  impassable_kinds = env.world.non_grabbable_indices\n\n  def is_walkable(x, y):\n    \"\"\"Checks if a given grid cell is within bounds and does not contain impassable items.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False # Out of bounds\n    \n    # Check if the cell (y, x) contains any impassable kind\n    for kind_idx in impassable_kinds:\n      if grid[y, x, kind_idx] > 0: # > 0 means the item is present in that cell\n        return False # Contains an impassable object\n    return True\n\n  # Find all locations of the primitive on the grid\n  # np.where returns (row_indices, col_indices) which correspond to (y_coords, x_coords)\n  primitive_locations = set() # Store as a set for efficient lookup\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n\n  if not primitive_locations:\n    return [] # Primitive not found on the grid\n\n  # BFS to find the shortest path in terms of total actions (including moves and turns)\n  # BFS state: (x, y, dir) - position and facing direction\n  # Queue stores: (current_x, current_y, current_dir, list_of_actions_taken_to_reach_this_state)\n  q = collections.deque([(start_pos_x, start_pos_y, start_dir, [])])\n  \n  # Visited set stores (x, y, dir) tuples to prevent cycles and redundant exploration.\n  # This ensures we find the shortest path in terms of actions.\n  visited = set([(start_pos_x, start_pos_y, start_dir)])\n\n  while q:\n    curr_x, curr_y, curr_dir, path = q.popleft()\n\n    # --- Check if the current state allows for immediate 'USE' of the primitive ---\n    # Calculate the cell directly in front of the agent based on its current direction.\n    # The cell in front is determined by the FORWARD_DELTAS based on current direction.\n    dx_front, dy_front = FORWARD_DELTAS[curr_dir]\n    item_x_in_front, item_y_in_front = curr_x + dx_front, curr_y + dy_front\n    \n    # If the cell in front is within bounds and contains the target primitive\n    if (0 <= item_x_in_front < grid_width and \n        0 <= item_y_in_front < grid_height and\n        (item_x_in_front, item_y_in_front) in primitive_locations):\n      # We have found a path to a state from which the USE action is possible.\n      return path + [USE_ACTION]\n\n    # --- Explore next states from the current state by applying possible actions ---\n\n    # 1. Explore turning actions (LEFT_ACTION, RIGHT_ACTION)\n    # These actions change direction but not position.\n    for action in [LEFT_ACTION, RIGHT_ACTION]:\n      next_x, next_y = curr_x, curr_y # Position does not change for a pure turn\n      if action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn 90 degrees counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4 # Turn 90 degrees clockwise\n      \n      next_state = (next_x, next_y, next_dir)\n      if next_state not in visited:\n        visited.add(next_state)\n        q.append((next_x, next_y, next_dir, path + [action]))\n\n    # 2. Explore movement actions (UP_ACTION: move forward, DOWN_ACTION: move backward)\n    # These actions change position but not direction.\n\n    # Try moving Forward (UP_ACTION)\n    dx_fwd, dy_fwd = FORWARD_DELTAS[curr_dir]\n    next_x_fwd, next_y_fwd = curr_x + dx_fwd, curr_y + dy_fwd\n    next_dir_fwd = curr_dir # Direction does not change when moving forward/backward\n\n    if is_walkable(next_x_fwd, next_y_fwd):\n      next_state_fwd = (next_x_fwd, next_y_fwd, next_dir_fwd)\n      if next_state_fwd not in visited:\n        visited.add(next_state_fwd)\n        q.append((next_x_fwd, next_y_fwd, next_dir_fwd, path + [UP_ACTION]))\n\n    # Try moving Backward (DOWN_ACTION)\n    dx_bwd, dy_bwd = BACKWARD_DELTAS[curr_dir]\n    next_x_bwd, next_y_bwd = curr_x + dx_bwd, curr_y + dy_bwd\n    next_dir_bwd = curr_dir # Direction does not change when moving forward/backward\n\n    if is_walkable(next_x_bwd, next_y_bwd):\n      next_state_bwd = (next_x_bwd, next_y_bwd, next_dir_bwd)\n      if next_state_bwd not in visited:\n        visited.add(next_state_bwd)\n        q.append((next_x_bwd, next_y_bwd, next_dir_bwd, path + [DOWN_ACTION]))\n  \n  # If the queue becomes empty and no path was found to any primitive collectable state\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T17:59:40.093289", "function_name": "collect", "function_body": "    action_mapping = env.action_specs()\n    ACTION_DOWN = action_mapping[\"DOWN\"]\n    ACTION_UP = action_mapping[\"UP\"]\n    ACTION_LEFT = action_mapping[\"LEFT\"]\n    ACTION_RIGHT = action_mapping[\"RIGHT\"]\n    ACTION_USE = action_mapping[\"USE\"]\n\n    actions_taken = []\n    max_total_steps = 200 # A reasonable upper bound for actions to prevent infinite loops\n\n    # Get initial observation to check current state\n    obs = env.observations()\n    inventory = obs['features_dict']['inventory']\n\n    if inventory[primitive] > 0:\n        # Primitive is already in inventory\n        return actions_taken\n\n    steps_count = 0\n    # Simple exploration sequence of movements if the primitive isn't immediately visible\n    # This tries to cover some ground systematically in a square pattern.\n    exploration_sequence = [\n        ACTION_RIGHT, ACTION_RIGHT, ACTION_UP, ACTION_UP,\n        ACTION_LEFT, ACTION_LEFT, ACTION_DOWN, ACTION_DOWN\n    ]\n    seq_idx = 0\n\n    while steps_count < max_total_steps:\n        # Get the current CraftState instance (exposed by CraftLab)\n        current_craft_state = env._current_state\n        # Get updated observations for current decision-making\n        obs = env.observations()\n        \n        # Check if primitive is now in inventory after previous actions\n        inventory = obs['features_dict']['inventory']\n        if inventory[primitive] > 0:\n            return actions_taken # Successfully collected\n\n        action_to_perform = None\n\n        # Priority 1: If primitive is in the 3x3 neighborhood, try to USE it.\n        if current_craft_state.next_to(primitive):\n            action_to_perform = ACTION_USE\n        else:\n            # Priority 2: If primitive is visible in immediate cardinal directions\n            # within the egocentric view, move towards it.\n            ego_grid = obs['features_dict']['features_ego']\n            center_h, center_w = ego_grid.shape[0] // 2, ego_grid.shape[1] // 2\n\n            # Check neighbors: Left, Right, Up, Down relative to agent's absolute position\n            # This assumes agent's view is always aligned with global N/S/E/W.\n            # (center_h, center_w-1) is to the agent's absolute Left.\n            if center_w > 0 and ego_grid[center_h, center_w - 1, primitive] > 0:\n                action_to_perform = ACTION_LEFT\n            # (center_h, center_w+1) is to the agent's absolute Right.\n            elif center_w < ego_grid.shape[1] - 1 and ego_grid[center_h, center_w + 1, primitive] > 0:\n                action_to_perform = ACTION_RIGHT\n            # (center_h-1, center_w) is to the agent's absolute Up (North).\n            elif center_h > 0 and ego_grid[center_h - 1, center_w, primitive] > 0:\n                action_to_perform = ACTION_UP\n            # (center_h+1, center_w) is to the agent's absolute Down (South).\n            elif center_h < ego_grid.shape[0] - 1 and ego_grid[center_h + 1, center_w, primitive] > 0:\n                action_to_perform = ACTION_DOWN\n            \n            # Priority 3: If not immediately adjacent and not visible in cardinal directions,\n            # fall back to the pre-defined exploration sequence.\n            if action_to_perform is None:\n                action_to_perform = exploration_sequence[seq_idx]\n                seq_idx = (seq_idx + 1) % len(exploration_sequence)\n\n        # Execute the chosen action\n        _reward, _done, new_obs_after_step = env.step(action_to_perform)\n        actions_taken.append(action_to_perform)\n        steps_count += 1\n\n        # Check if the environment itself terminated the episode (e.g., reached its own max_steps)\n        if _done:\n            # This implies failure to collect within environment's limits.\n            return [] # Return empty list to indicate failure\n\n    # If max_total_steps for this function is reached without collecting the primitive\n    return [] # Return empty list to indicate failure", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T17:59:40.164200", "function_name": "collect", "function_body": "    current_state = env._current_state\n\n    # Check if the primitive is already in the inventory\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    grid = current_state.grid\n    start_pos = current_state.pos\n    start_dir = current_state.dir\n    world_info = current_state.world  # This is the CraftWorld instance\n\n    rows, cols, _ = grid.shape\n\n    # BFS queue: stores ( (current_position, current_direction), list_of_actions_to_reach_here )\n    from collections import deque\n    q = deque([((start_pos, start_dir), [])])\n\n    # Visited set: stores (position, direction) tuples to avoid cycles and redundant exploration\n    visited = set([(start_pos, start_dir)])\n\n    # Define impassable entities. These are typically the 'environment' items\n    # that cannot be picked up and block movement.\n    impassable_indices = world_info.non_grabbable_indices\n\n    # Define action mappings to (delta_row, delta_column) and the resulting new direction\n    # Directions: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n    # (dr, dc), new_dir_val\n    move_options = {\n        env_factory.UP: ((-1, 0), 0),\n        env_factory.DOWN: ((1, 0), 2),\n        env_factory.LEFT: ((0, -1), 3),\n        env_factory.RIGHT: ((0, 1), 1),\n    }\n\n    while q:\n        (current_pos, current_dir), path_so_far = q.popleft()\n        r, c = current_pos\n\n        # Check if the current state allows for the 'USE' action to collect the primitive\n        # Calculate the coordinates of the cell directly in front of the agent\n        front_r, front_c = r, c\n        if current_dir == 0:  # UP\n            front_r -= 1\n        elif current_dir == 1:  # RIGHT\n            front_c += 1\n        elif current_dir == 2:  # DOWN\n            front_r += 1\n        elif current_dir == 3:  # LEFT\n            front_c -= 1\n\n        # Check if the cell in front is within bounds and contains the primitive\n        if 0 <= front_r < rows and 0 <= front_c < cols:\n            if grid[front_r, front_c, primitive] > 0:\n                # Agent is in a position to collect the primitive; return the path plus the USE action\n                return path_so_far + [env_factory.USE]\n\n        # Explore possible movement actions from the current state\n        for move_action, ((dr, dc), new_dir_val) in move_options.items():\n            nr, nc = r + dr, c + dc  # New row and column after move\n            new_pos = (nr, nc)\n            new_state_tuple = (new_pos, new_dir_val)\n\n            # Check boundary conditions\n            if not (0 <= nr < rows and 0 <= nc < cols):\n                continue\n\n            # Check if the new position is impassable\n            is_blocked = False\n            for k_idx in impassable_indices:\n                if grid[nr, nc, k_idx] > 0:  # If this kind of entity is present at the new cell\n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue\n\n            # If the new state (position and direction) has not been visited, add it to the queue\n            if new_state_tuple not in visited:\n                visited.add(new_state_tuple)\n                q.append((new_state_tuple, path_so_far + [move_action]))\n\n    # If the BFS completes and no path to collect the primitive is found\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:01:29.253765", "function_name": "collect", "function_body": "    import collections\n\n    state = env._current_state\n    \n    grid = state.grid\n    start_x, start_y = state.pos\n    \n    WIDTH, HEIGHT, n_kinds = grid.shape\n    \n    # Retrieve indices for impassable terrain from the world configuration\n    water_idx = state.world.water_index\n    stone_idx = state.world.stone_index\n    \n    # Map action indices to coordinate changes (dx, dy)\n    # These correspond to DOWN=0, UP=1, LEFT=2, RIGHT=3\n    ACTION_DELTAS = {\n        0: (0, 1),   # DOWN\n        1: (0, -1),  # UP\n        2: (-1, 0),  # LEFT\n        3: (1, 0),   # RIGHT\n    }\n    USE = 4 # The USE action constant\n    \n    # Find all grid locations where the primitive exists\n    primitive_locations = []\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] > 0:\n                primitive_locations.append((x, y))\n    \n    if not primitive_locations:\n        # If the primitive is not found anywhere on the map, it's unreachable.\n        return []\n\n    # Initialize BFS queue with (current_x, current_y, list_of_actions_taken)\n    queue = collections.deque([(start_x, start_y, [])])\n    # Keep track of visited cells to avoid cycles and redundant paths\n    visited = {(start_x, start_y)}\n    \n    while queue:\n        curr_x, curr_y, path_actions = queue.popleft()\n        \n        # Check if the current position is adjacent to any of the primitive locations.\n        # An adjacent cell has a Manhattan distance of 1 from the target primitive.\n        for p_x, p_y in primitive_locations:\n            if abs(curr_x - p_x) + abs(curr_y - p_y) == 1:\n                # Found the shortest path to a cell adjacent to the primitive.\n                # Now, append the USE action to collect it.\n                return path_actions + [USE]\n        \n        # Explore possible moves (UP, DOWN, LEFT, RIGHT)\n        for action_val, (dx, dy) in ACTION_DELTAS.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n            \n            # Check if the next position is within grid boundaries\n            if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                continue\n            \n            # Check if the next position has already been visited in this BFS\n            if (next_x, next_y) in visited:\n                continue\n            \n            # Check if the next position is an obstacle (water or stone)\n            # Agents cannot move into water or stone cells.\n            is_obstacle = False\n            if grid[next_x, next_y, water_idx] > 0 or \\\n               grid[next_x, next_y, stone_idx] > 0:\n                is_obstacle = True\n            \n            if is_obstacle:\n                continue # Skip this move as it leads to an impassable cell\n            \n            # If the cell is valid and not visited, add it to the queue and mark as visited\n            visited.add((next_x, next_y))\n            queue.append((next_x, next_y, path_actions + [action_val]))\n            \n    # If the queue becomes empty and no path to an adjacent primitive was found,\n    # it means the primitive is unreachable from the current position (e.g., completely\n    # surrounded by obstacles or not present in a reachable part of the map).\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:01:29.325238", "function_name": "collect", "function_body": "    actions_list = []\n    state = env._current_state\n\n    # 1. Check if primitive is already in inventory\n    if state.inventory[primitive] > 0:\n        return []\n\n    # Max steps to prevent infinite loops or excessively long paths\n    # Using env.max_steps from the environment (e.g., CraftLab) as a base\n    # If not available, default to a reasonable large number.\n    max_episode_steps = getattr(env, 'max_steps', 1000)\n    max_actions_limit = max_episode_steps * 2 # Safety limit for pathfinding within this function\n\n    grid_height, grid_width, _ = state.grid.shape\n    \n    # 2. Use BFS to find a path to a cell *adjacent* to the primitive.\n    # The agent must be adjacent to the item to 'USE' it, and typically not on the same cell.\n    \n    # Queue for BFS: (current_position, path_taken_to_reach_here)\n    queue = collections.deque([(state.pos, [])])\n    # Set to keep track of visited positions to avoid cycles and redundant checks\n    visited = {state.pos}\n    \n    path_to_adjacent_cell = None\n\n    # BFS loop\n    while queue and len(actions_list) < max_actions_limit:\n        current_bfs_pos, current_bfs_path = queue.popleft()\n        r, c = current_bfs_pos\n        \n        # Check if the current BFS cell (r, c) is adjacent to the primitive\n        # We also need to ensure the agent is not trying to path onto the primitive's cell itself,\n        # unless it's a type of item that can be picked up by standing on it.\n        # Given `next_to` checks \"around pos\", it implies agent needs to be adjacent, not on.\n        is_adjacent_to_primitive = False\n        # Iterate over cardinal neighbors of the current BFS cell\n        for dr_p, dc_p in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # North, South, West, East\n            primitive_check_r, primitive_check_c = r + dr_p, c + dc_p\n            \n            if (0 <= primitive_check_r < grid_height and \n                0 <= primitive_check_c < grid_width and\n                state.grid[primitive_check_r, primitive_check_c, primitive] > 0):\n                \n                # Found a primitive in a cardinal direction from the current BFS cell.\n                # This means current_bfs_pos is a valid adjacent cell.\n                # Ensure the current BFS cell itself doesn't contain the primitive to avoid ambiguity\n                if state.grid[r, c, primitive] == 0: \n                    is_adjacent_to_primitive = True\n                    break # Found a target adjacent cell, stop checking neighbors\n        \n        if is_adjacent_to_primitive:\n            path_to_adjacent_cell = current_bfs_path\n            break # BFS found the shortest path to an adjacent empty cell\n\n        # If not adjacent to primitive yet, explore neighbors for next BFS step\n        # These correspond to the agent's movement actions\n        for action, dr_move, dc_move in [(ACTION_UP, -1, 0), (ACTION_DOWN, 1, 0),\n                                         (ACTION_LEFT, 0, -1), (ACTION_RIGHT, 0, 1)]:\n            next_r, next_c = r + dr_move, c + dc_move\n            next_bfs_pos = (next_r, next_c)\n\n            if (0 <= next_r < grid_height and \n                0 <= next_c < grid_width and \n                next_bfs_pos not in visited):\n                # Add to queue if within bounds and not visited\n                visited.add(next_bfs_pos)\n                queue.append((next_bfs_pos, current_bfs_path + [action]))\n\n    if not path_to_adjacent_cell:\n        # No path found to an adjacent cell (e.g., primitive unreachable or not present)\n        return []\n\n    # 3. Execute the actions to move the agent to the determined adjacent cell.\n    for action in path_to_adjacent_cell:\n        if len(actions_list) >= max_actions_limit:\n            # Reached action limit during path execution, return empty as failed\n            return [] \n        \n        actions_list.append(action)\n        _reward, _done, _obs = env.step(action)\n        state = env._current_state # Update the internal state of the environment\n\n        # Check if primitive was collected during movement (e.g., by walking over it, or if multiple items)\n        if state.inventory[primitive] > 0:\n            return actions_list # Successfully collected, return path\n\n    # 4. Agent is now at the calculated adjacent cell. Confirm it's indeed adjacent.\n    if not state.next_to(primitive):\n        # This implies something went wrong (e.g., primitive moved, or pathfinding issue)\n        return []\n\n    # 5. Perform the USE action.\n    # Assumption for collect_v2: The USE action collects any adjacent item\n    # regardless of the agent's current facing direction. This simplifies the logic\n    # as no explicit turn actions are provided in the DMLab-style action space\n    # (i.e., LEFT/RIGHT are assumed to be movements, not pure turns in this context).\n    actions_list.append(ACTION_USE)\n    _reward, _done, _obs = env.step(ACTION_USE)\n    state = env._current_state # Update state to check inventory after USE\n\n    # 6. Final check: verify if the primitive has been collected.\n    if state.inventory[primitive] > 0:\n        return actions_list # Successfully collected\n        \n    return [] # Failed to collect for any other reason", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:02:37.612980", "function_name": "collect", "function_body": "        import collections\n        import numpy as np\n\n        # Action constants based on CraftLab's action_specs\n        DOWN = 0\n        UP = 1\n        LEFT = 2\n        RIGHT = 3\n        USE = 4\n\n        # 1. Check if the primitive is already in inventory\n        obs = env.observations()\n        inventory = obs['features_dict']['inventory']\n        if inventory[primitive] > 0:\n            return []  # Already collected\n\n        current_grid = obs['features_dict']['features_global']\n        grid_width, grid_height, _ = current_grid.shape\n        current_pos_normalized = obs['features_dict']['pos']\n\n        # Convert normalized position back to integer grid coordinates\n        current_pos_int = (int(round(current_pos_normalized[0] * (grid_width - 1))),\n                           int(round(current_pos_normalized[1] * (grid_height - 1))))\n\n        # Get non-grabbable (and assumed non-traversable) entities from the world\n        non_traversable_indices = env.world.non_grabbable_indices\n\n        # Helper function to determine if a cell is traversable\n        def is_traversable(r, c):\n            # Check bounds\n            if not (0 <= r < grid_width and 0 <= c < grid_height):\n                return False\n\n            # Check if the cell contains any non-traversable (e.g., non-grabbable) items\n            for k in non_traversable_indices:\n                if current_grid[r, c, k] > 0:\n                    return False  # Cell contains an impassable obstacle\n\n            return True  # Cell is traversable\n\n        # Helper function to check if a position is adjacent to (or on) the primitive\n        # This aligns with CraftState.next_to, which checks the 3x3 neighborhood\n        def is_collect_adjacent(r, c):\n            for dr in [-1, 0, 1]:\n                for dc in [-1, 0, 1]:\n                    nr, nc = r + dr, c + dc\n                    # Check bounds for the neighbor cell\n                    if 0 <= nr < grid_width and 0 <= nc < grid_height:\n                        # Check if the primitive is present at this neighbor cell\n                        if current_grid[nr, nc, primitive] > 0:\n                            return True\n            return False\n\n        # BFS for pathfinding to a location where the primitive can be collected\n        queue = collections.deque([(current_pos_int, [])])  # (position, list_of_actions_to_reach_pos)\n        visited = {current_pos_int}  # Set of visited (r, c) tuples\n        path_to_collect_spot = None\n\n        while queue:\n            (r, c), actions_so_far = queue.popleft()\n\n            # If this position allows us to collect the primitive (i.e., it's adjacent to it)\n            if is_collect_adjacent(r, c):\n                path_to_collect_spot = actions_so_far\n                break  # Shortest path found\n\n            # Explore all four cardinal neighbors (UP, DOWN, LEFT, RIGHT movements)\n            for dr, dc, action in [(-1, 0, UP), (1, 0, DOWN), (0, -1, LEFT), (0, 1, RIGHT)]:\n                new_r, new_c = r + dr, c + dc\n\n                if is_traversable(new_r, new_c) and (new_r, new_c) not in visited:\n                    visited.add((new_r, new_c))\n                    queue.append(((new_r, new_c), actions_so_far + [action]))\n\n        if path_to_collect_spot is not None:\n            # We found a path to a cell from which the primitive can be collected.\n            # Append the USE action to the path to actually collect it.\n            return path_to_collect_spot + [USE]\n        else:\n            # Primitive not found or unreachable from the current position\n            return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:02:37.683343", "function_name": "collect", "function_body": "    actions_taken = []\n    max_steps = 200  # Arbitrary limit to prevent infinite loops\n\n    # Get action mappings\n    action_map = env.action_specs()\n    DOWN = action_map['DOWN']\n    UP = action_map['UP']\n    LEFT = action_map['LEFT']\n    RIGHT = action_map['RIGHT']\n    USE = action_map['USE']\n\n    for step_count in range(max_steps):\n        current_state = env._current_state  # Direct access to CraftState\n\n        # 1. Check if the primitive is already in inventory\n        if current_state.inventory[primitive] > 0:\n            return actions_taken\n\n        # 2. Check if the primitive is adjacent (in 3x3 neighborhood) and can be used\n        if current_state.next_to(primitive):\n            # Attempt to use the item\n            _, _, _ = env.step(USE)\n            actions_taken.append(USE)\n            # Re-check inventory in the next loop iteration (after action effect)\n            continue\n\n        # 3. If not collected and not adjacent, find the primitive and move towards it\n        agent_pos = current_state.pos  # (x, y) tuple\n        current_grid = current_state.grid  # (WIDTH, HEIGHT, n_kinds)\n\n        # Find all locations of the primitive on the grid\n        # np.argwhere returns (row, col), which corresponds to (y, x)\n        primitive_locations_yx = np.argwhere(current_grid[:, :, primitive] == 1)\n\n        if len(primitive_locations_yx) == 0:\n            # Primitive not found on the grid, perform a random move to explore\n            # This is a simple heuristic; a real planner would do more sophisticated exploration\n            random_action = np.random.choice([DOWN, UP, LEFT, RIGHT])\n            _, _, _ = env.step(random_action)\n            actions_taken.append(random_action)\n            continue\n\n        # Find the closest primitive location\n        min_dist = float('inf')\n        closest_target_yx = None\n        for p_loc_yx in primitive_locations_yx:\n            # Convert (y, x) from argwhere to (x, y) for distance calculation\n            p_loc_xy = (p_loc_yx[1], p_loc_yx[0])\n            dist = np.linalg.norm(np.array(agent_pos) - np.array(p_loc_xy))\n            if dist < min_dist:\n                min_dist = dist\n                closest_target_yx = p_loc_yx\n\n        # Convert the closest target from (y, x) to (x, y)\n        target_x, target_y = closest_target_yx[1], closest_target_yx[0]\n        agent_x, agent_y = agent_pos\n\n        # Determine the best move towards the target\n        action_to_take = None\n\n        # Prioritize movement in the x-direction\n        if target_x > agent_x:\n            action_to_take = RIGHT\n        elif target_x < agent_x:\n            action_to_take = LEFT\n        # If x-aligned, move in the y-direction\n        elif target_y > agent_y:\n            action_to_take = DOWN\n        elif target_y < agent_y:\n            action_to_take = UP\n        \n        # If agent is already at the target position, and next_to didn't trigger USE\n        # (which shouldn't happen if it's grabbable and present), then we might be stuck\n        # For simplicity, if action_to_take is None here, it means we are at (target_x, target_y)\n        # and the item is still there, but not collected via next_to/USE. This indicates an issue\n        # (e.g., item not grabbable, or state update delay). We'll break or try USE again.\n        # However, the `next_to` check should handle this, so `action_to_take` should typically not be `None`\n        # if there's a valid path. If it is `None`, it's an edge case where movement isn't needed.\n\n        if action_to_take is not None:\n            _, _, _ = env.step(action_to_take)\n            actions_taken.append(action_to_take)\n        else:\n            # This case means agent_pos == (target_x, target_y).\n            # If the primitive is truly at this spot and grabbable, `next_to` should have already handled it.\n            # If we reach here, it implies `next_to` either failed or the item isn't grabbable.\n            # For this simple function, we'll consider it unable to collect further and break.\n            break\n\n    return actions_taken", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:03:51.964048", "function_name": "collect", "function_body": "", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:03:52.980032", "function_name": "collect", "function_body": "  # Define symbolic direction constants for internal logic, aligning with\n  # the implied order of features_dict['direction'] one-hot array:\n  # [DOWN_facing, UP_facing, LEFT_facing, RIGHT_facing]\n  DIR_DOWN_INT = 0\n  DIR_UP_INT = 1\n  DIR_LEFT_INT = 2\n  DIR_RIGHT_INT = 3\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Mapping from a movement action_id to the resulting agent facing direction (DIR_INT)\n  # This assumes that taking an action like _UP will make the agent face DIR_UP_INT.\n  # Based on `action_specs`: DOWN->0, UP->1, LEFT->2, RIGHT->3.\n  # And `features_dict['direction']` uses the same ordering for one-hot (0 for DOWN, 1 for UP, etc.)\n  ACTION_ID_TO_FACING_DIR = {\n      _UP: DIR_UP_INT,\n      _DOWN: DIR_DOWN_INT,\n      _LEFT: DIR_LEFT_INT,\n      _RIGHT: DIR_RIGHT_INT,\n  }\n\n  # Mapping from internal direction integer to (dx, dy) for the cell *in front*\n  # If agent is at (x,y) facing UP (DIR_UP_INT), cell in front is (x, y-1).\n  DELTA_FRONT = {\n      DIR_UP_INT: (0, -1),\n      DIR_DOWN_INT: (0, 1),\n      DIR_LEFT_INT: (-1, 0),\n      DIR_RIGHT_INT: (1, 0),\n  }\n\n  actions_to_take = []\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Convert one-hot direction from features_dict to an integer\n  # Assuming features_dict['direction'] is one-hot [DOWN, UP, LEFT, RIGHT]\n  current_dir = np.argmax(features_dict['direction']) \n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # The `_USE` action interacts with the cell *in front* of the agent.\n  # Therefore, the agent cannot pick up an item it is standing on directly.\n  # We need to find a path to a cell *adjacent* to the primitive, then turn and use.\n\n  # Breadth-First Search (BFS) to find the shortest path.\n  # Queue stores tuples: (current_x, current_y, current_direction_int, [path_actions_to_reach_here])\n  q = collections.deque() \n  q.append((current_px, current_py, current_dir, [])) \n  \n  # Set to store visited states (position + direction) to avoid cycles and re-processing longer paths\n  visited = {(current_px, current_py, current_dir)} \n\n  # Define possible movements as (dx, dy) relative to current position, and their corresponding action_id\n  # These are fixed grid movements, not relative to agent's facing direction.\n  moves = [\n      ((0, -1), _UP),    # Move North/Up\n      ((0, 1), _DOWN),   # Move South/Down\n      ((-1, 0), _LEFT),  # Move West/Left\n      ((1, 0), _RIGHT)   # Move East/Right\n  ]\n\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid_data, non_grabbable_kinds_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle).\"\"\"\n    if not non_grabbable_kinds_set: # Optimization: if set is empty, no obstacles can exist.\n        return False\n    for k_idx in non_grabbable_kinds_set:\n      if grid_data[x, y, k_idx] == 1: # If any non-grabbable item is at this cell\n        return True\n    return False\n\n  target_found_path = None\n\n  while q:\n    cx, cy, cdir, current_path = q.popleft()\n\n    # --- GOAL CHECK ---\n    # After moving to (cx, cy) and facing cdir, check if the cell *in front* contains the primitive.\n    delta_x_front, delta_y_front = DELTA_FRONT[cdir]\n    fx, fy = cx + delta_x_front, cy + delta_y_front\n\n    # Check if the \"in front\" cell is within grid bounds and contains the target primitive\n    if (0 <= fx < WIDTH and 0 <= fy < HEIGHT and\n        current_grid[fx, fy, primitive] == 1):\n      target_found_path = current_path + [_USE]\n      break # Found the shortest path to a state from which the item can be used.\n\n    # --- EXPLORE NEIGHBORS ---\n    # For each possible movement action\n    for (dx_move, dy_move), action_id in moves:\n      nx, ny = cx + dx_move, cy + dy_move # Calculate new position\n\n      # The agent's new direction `ndir` will be determined by the `action_id` taken.\n      # (e.g., if action_id is _UP, the agent will face DIR_UP_INT after moving).\n      ndir = ACTION_ID_TO_FACING_DIR[action_id]\n      n_action_path = current_path + [action_id] # Path to the new state\n\n      # Check boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if this new (position, direction) state has already been visited\n      if (nx, ny, ndir) in visited:\n        continue\n\n      # Check if the neighbor cell (nx, ny) is an obstacle\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n\n      # If the neighbor is valid and not an obstacle, add it to the queue\n      q.append((nx, ny, ndir, n_action_path))\n      visited.add((nx, ny, ndir))\n  \n  # Return the found path, or an empty list if no path was found\n  return actions_to_take if target_found_path is None else target_found_path", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:05:27.494617", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action IDs mapping (consistent with CraftWorld's _ACTIONS)\n  _ACTION_IDS = {\n      'DOWN': 0, # S\n      'UP': 1,   # N\n      'LEFT': 2, # W\n      'RIGHT': 3,# E\n      'USE': 4\n  }\n\n  # (dx, dy) tuples for each cardinal direction action ID\n  # (dx, dy) represents change in (x_coordinate, y_coordinate)\n  _CARDINAL_DELTAS = {\n      0: (0, 1),  # DOWN (increase y)\n      1: (0, -1), # UP (decrease y)\n      2: (-1, 0), # LEFT (decrease x)\n      3: (1, 0)   # RIGHT (increase x)\n  }\n\n  # Reverse mapping: (dx, dy) -> action ID for cardinal movements\n  _DELTA_TO_CARDINAL_ACTION_ID = {v: k for k, v in _CARDINAL_DELTAS.items()}\n\n  def _find_path_to_adjacent(start_pos, target_pos, current_state, world):\n      \"\"\"\n      Finds the shortest path from start_pos to any cell cardinally adjacent to target_pos\n      using BFS, considering non-grabbable entities as obstacles.\n      Returns a list of action IDs representing the path, or None if no path found.\n      \"\"\"\n      grid_width, grid_height, _ = current_state.grid.shape\n      queue = collections.deque([(start_pos, [])]) # (current_x, current_y), path_actions\n      visited = {start_pos}\n\n      non_grabbable_indices = world.non_grabbable_indices # Obstacles\n\n      px, py = target_pos\n\n      while queue:\n          (cx, cy), path = queue.popleft()\n\n          # Check if current_node is cardinally adjacent to the target_pos\n          # We want to find a path to a cell from which we can USE the primitive.\n          # USE action only works on cardinally adjacent cells.\n          if abs(cx - px) + abs(cy - py) == 1:\n              # Ensure the target_pos actually contains the primitive (it should by design)\n              # and that the current position is a valid spot to perform USE\n              # (i.e. not an obstacle itself, which is handled by BFS).\n              return path # Found a path to a cardinally adjacent cell\n\n          for action_id, (dx, dy) in _CARDINAL_DELTAS.items():\n              nx, ny = cx + dx, cy + dy\n              next_pos = (nx, ny)\n\n              # Check bounds\n              if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n                  continue\n\n              # Check if visited\n              if next_pos in visited:\n                  continue\n\n              # Check for obstacles: cells with non-grabbable entities\n              is_obstacle = False\n              # A cell is an obstacle if it contains any non-grabbable entity\n              for kind_idx in non_grabbable_indices:\n                  if current_state.grid[nx, ny, kind_idx] > 0:\n                      is_obstacle = True\n                      break\n              if is_obstacle:\n                  continue\n\n              visited.add(next_pos)\n              queue.append((next_pos, path + [action_id]))\n\n      return None # No path found\n\n  actions_taken = []\n  \n  current_state = env._current_state\n  world = env.world # Access CraftWorld instance for obstacle information\n\n  # A safeguard to prevent infinite loops in unachievable scenarios\n  # The maximum number of steps allowed for the agent to find and collect.\n  MAX_COLLECT_STEPS = 500 \n\n  for _ in range(MAX_COLLECT_STEPS):\n    # 1. Check if the primitive is already collected in inventory\n    if current_state.inventory[primitive] > 0:\n      break # Goal achieved\n\n    current_x, current_y = current_state.pos\n    \n    # 2. Find the closest instance of the primitive on the grid\n    primitive_pos = None\n    min_dist = float('inf')\n    grid_width, grid_height, _ = current_state.grid.shape\n\n    for x in range(grid_width):\n      for y in range(grid_height):\n        if current_state.grid[x, y, primitive] > 0:\n          # Calculate Manhattan distance\n          dist = abs(x - current_x) + abs(y - current_y)\n          if dist < min_dist:\n            min_dist = dist\n            primitive_pos = (x, y)\n    \n    if primitive_pos is None:\n      # Primitive not found on the map. This might mean it's an invalid primitive\n      # for this scenario, or all instances have been collected (already checked above).\n      break # Cannot collect\n\n    action_to_take = None\n\n    # 3. Determine action: USE or move\n    \n    # Check if agent is cardinally adjacent to the primitive\n    is_cardinal_adjacent = False\n    target_dx, target_dy = None, None\n    \n    for dx, dy in _CARDINAL_DELTAS.values(): # Iterate over (dx,dy) tuples for cardinal moves\n        nx, ny = current_x + dx, current_y + dy\n        # Check bounds and if the neighbor cell contains the primitive\n        if 0 <= nx < grid_width and 0 <= ny < grid_height and current_state.grid[nx, ny, primitive] > 0:\n            is_cardinal_adjacent = True\n            target_dx, target_dy = dx, dy\n            break # Found a cardinally adjacent primitive instance\n\n    if is_cardinal_adjacent:\n      # Agent is cardinally adjacent to the primitive, now try to USE it.\n      required_dir = _DELTA_TO_CARDINAL_ACTION_ID[(target_dx, target_dy)]\n\n      if current_state.dir != required_dir:\n        # Need to turn to face the primitive\n        action_to_take = required_dir\n      else:\n        # Already facing, perform USE action\n        action_to_take = _ACTION_IDS['USE']\n            \n    if action_to_take is None: # Not cardinally adjacent or could not determine target for USE\n        # Find path to a cell cardinally adjacent to the primitive\n        path_to_adj = _find_path_to_adjacent(current_state.pos, primitive_pos, current_state, world)\n        \n        if path_to_adj:\n            action_to_take = path_to_adj[0] # Take the first step in the shortest path\n        else:\n            # No path found to primitive (e.g., blocked by unmovable obstacles)\n            break # Give up on collecting this primitive\n\n    # 4. Execute the chosen action\n    if action_to_take is not None:\n      reward, done, obs = env.step(action_to_take)\n      actions_taken.append(action_to_take)\n      current_state = env._current_state # Update current state after step\n      \n      if done:\n        # Episode ended, either goal achieved (checked at start of loop) or max_steps reached.\n        break # Exit loop as episode is over\n    else:\n        # No action could be determined (e.g., primitive not found or path blocked).\n        break # Exit loop\n\n  return actions_taken", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:05:27.563309", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants (assuming these are globally defined or imported elsewhere in the project)\n    # e.g., from a 'constants' module or similar. If not, they would need to be defined here.\n    # DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    # Direction constants and mappings based on CraftState internal logic.\n    # _DIRECTIONS maps a numerical direction index to its corresponding (dx, dy) vector.\n    # 0: North/Up (y-coordinate decreases)\n    # 1: East/Right (x-coordinate increases)\n    # 2: South/Down (y-coordinate increases)\n    # 3: West/Left (x-coordinate decreases)\n    _DIRECTIONS = [(0, -1), (1, 0), (0, 1), (-1, 0)]\n\n    # _ACTION_TO_DIR maps a movement action to the direction the agent will be facing\n    # after performing that action (assuming movement actions also set the agent's facing direction).\n    _ACTION_TO_DIR = {\n        UP: 0,    # Agent moves up, faces North\n        RIGHT: 1, # Agent moves right, faces East\n        DOWN: 2,  # Agent moves down, faces South\n        LEFT: 3   # Agent moves left, faces West\n    }\n\n    state = env._current_state\n    world = state.world\n    grid = state.grid\n    inventory = state.inventory\n    init_pos = state.pos\n    init_dir = state.dir # Initial facing direction of the agent\n\n    WIDTH, HEIGHT, _ = grid.shape\n    \n    # 1. Early exit: If the primitive is already in the agent's inventory, no actions are needed.\n    if inventory[primitive] > 0:\n        return []\n\n    # Get the index for \"water\" to identify non-walkable terrain.\n    # Assuming water is the primary obstacle that blocks movement.\n    water_idx = world.water_index\n\n    # Helper function to check if a given (x, y) coordinate is within grid boundaries\n    # and does not contain water (i.e., is walkable).\n    def is_walkable(x, y):\n        # grid[x, y, kind_idx] where x is column index, y is row index.\n        return 0 <= x < WIDTH and 0 <= y < HEIGHT and grid[x, y, water_idx] == 0\n\n    # 2. Identify all locations on the grid where the target primitive exists.\n    # Using a set for efficient lookup during the BFS goal check.\n    primitive_locations = set()\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, primitive] > 0:\n                primitive_locations.add((x, y))\n\n    # If the primitive is not found anywhere on the map, it cannot be collected.\n    if not primitive_locations:\n        return []\n    \n    # Check if the primitive is actually an item that can be picked up using the 'USE' action.\n    # The 'USE' action only works for items in `world.grabbable_indices`.\n    if primitive not in world.grabbable_indices:\n        # If it's not grabbable, it implies it might be an environment object or requires crafting,\n        # not direct collection via 'USE'.\n        return []\n\n    # 3. BFS (Breadth-First Search) setup for finding the shortest path to collect the primitive.\n    # Each state in the queue is a tuple: ((current_x, current_y), current_direction, [list_of_actions_taken_to_reach_this_state]).\n    queue = collections.deque([(init_pos, init_dir, [])])\n    \n    # The 'visited' set keeps track of (x, y, direction) states that have already been explored\n    # to prevent cycles and redundant path computations.\n    visited = {(init_pos[0], init_pos[1], init_dir)}\n\n    # BFS loop continues as long as there are states to explore\n    while queue:\n        (cx, cy), cdir, path = queue.popleft()\n\n        # 4. Check goal condition: Can the primitive be collected from the current state?\n        # The 'USE' action collects an item from the cell directly in front of the agent.\n        # Calculate the coordinates of the cell in front of the agent based on its current position and direction.\n        fx, fy = cx + _DIRECTIONS[cdir][0], cy + _DIRECTIONS[cdir][1]\n        \n        # If the cell in front (fx, fy) contains the primitive (and we already confirmed it's grabbable),\n        # then we have found a valid path. Append 'USE' to the path and return.\n        if (fx, fy) in primitive_locations:\n            return path + [USE]\n\n        # 5. Explore possible next states by performing movement actions (DOWN, UP, LEFT, RIGHT).\n        for action in [DOWN, UP, LEFT, RIGHT]:\n            # Determine the new direction the agent will be facing after performing this movement action.\n            next_dir = _ACTION_TO_DIR[action]\n            \n            # Determine the new position the agent will move to.\n            # Movement is typically in the direction determined by the action itself.\n            nx, ny = cx + _DIRECTIONS[next_dir][0], cy + _DIRECTIONS[next_dir][1]\n\n            # Check if the calculated new position is valid (within bounds) and walkable (not water).\n            if is_walkable(nx, ny):\n                # If this new (position, direction) state has not been visited before,\n                # add it to the visited set and enqueue it for further exploration.\n                if (nx, ny, next_dir) not in visited:\n                    visited.add((nx, ny, next_dir))\n                    queue.append(((nx, ny), next_dir, path + [action]))\n\n    # If the BFS loop completes and the queue becomes empty, it means no path was found\n    # to reach a position from which the primitive could be collected.\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:06:36.069270", "function_name": "collect", "function_body": "  from collections import deque\n\n  actions_taken = []\n  \n  # Get action integer IDs from the environment's action_specs\n  action_map = env.action_specs()\n  \n  # Get references to world for item type information\n  world = env.world\n  \n  # Define a reasonable max number of steps to prevent infinite loops\n  MAX_COLLECT_STEPS = 200 \n\n  # Map movement actions to (dx, dy) coordinate changes for BFS\n  # CraftWorld agent position `pos` is (column, row).\n  # UP: decreases row (y), column (x) stays same -> (0, -1)\n  # DOWN: increases row (y), column (x) stays same -> (0, 1)\n  # LEFT: decreases column (x), row (y) stays same -> (-1, 0)\n  # RIGHT: increases column (x), row (y) stays same -> (1, 0)\n  move_deltas = {\n      action_map['UP']: (0, -1),\n      action_map['DOWN']: (0, 1),\n      action_map['LEFT']: (-1, 0),\n      action_map['RIGHT']: (1, 0),\n  }\n  \n  # Helper to check if a position is within grid bounds\n  def _is_valid_pos(x, y, grid_shape):\n      width, height, _ = grid_shape\n      return 0 <= x < width and 0 <= y < height\n\n  # Check if the primitive is a known grabbable item.\n  # If it's not grabbable, this function cannot collect it.\n  if primitive not in world.grabbable_indices:\n      return []\n\n  # Main loop for finding and collecting the primitive\n  for _ in range(MAX_COLLECT_STEPS):\n    current_state = env._current_state # Direct access to the internal CraftState\n    \n    # 1. Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n      return actions_taken # Goal achieved\n\n    # 2. Check if the agent is currently next to the primitive, and if so, orient and use it\n    primitive_location_nearby = None\n    agent_x, agent_y = current_state.pos\n    grid = current_state.grid # Use the current grid state for checks\n    \n    # Iterate through 3x3 neighborhood (excluding center) to find primitive\n    for dx_nb in [-1, 0, 1]:\n        for dy_nb in [-1, 0, 1]:\n            if dx_nb == 0 and dy_nb == 0: # Skip agent's own cell (agent is not 'next to' itself)\n                continue\n            \n            nx_nb, ny_nb = agent_x + dx_nb, agent_y + dy_nb\n            if _is_valid_pos(nx_nb, ny_nb, grid.shape) and grid[nx_nb, ny_nb, primitive] == 1:\n                primitive_location_nearby = (nx_nb, ny_nb)\n                break\n        if primitive_location_nearby:\n            break\n            \n    if primitive_location_nearby:\n        # Agent is next to a primitive. Now orient and USE.\n        target_x, target_y = primitive_location_nearby\n        \n        # Calculate required direction from agent_x, agent_y to target_x, target_y\n        dx_rel = target_x - agent_x\n        dy_rel = target_y - agent_y\n\n        required_dir = -1\n        # Map (dx, dy) to a direction integer (0=N, 1=E, 2=S, 3=W)\n        if dy_rel < 0: # Target is North (UP)\n            required_dir = 0\n        elif dx_rel > 0: # Target is East (RIGHT)\n            required_dir = 1\n        elif dy_rel > 0: # Target is South (DOWN)\n            required_dir = 2\n        elif dx_rel < 0: # Target is West (LEFT)\n            required_dir = 3\n        \n        # Orient the agent if not already facing the required direction\n        current_dir = current_state.dir\n        if required_dir != -1: # Ensure a valid target direction was found\n            while current_dir != required_dir:\n                # Calculate shorter turn (right or left)\n                turn_right_steps = (required_dir - current_dir + 4) % 4\n                turn_left_steps = (current_dir - required_dir + 4) % 4\n\n                turn_action = action_map['RIGHT'] if turn_right_steps <= turn_left_steps else action_map['LEFT']\n                \n                _reward, done, _observations = env.step(turn_action)\n                actions_taken.append(turn_action)\n                current_state = env._current_state # Update state after turn\n                current_dir = current_state.dir\n                if done:\n                    return actions_taken\n\n        # Now agent is oriented (or was already), perform USE\n        _reward, done, _observations = env.step(action_map['USE'])\n        actions_taken.append(action_map['USE'])\n        if done:\n            return actions_taken\n        continue # Successfully used, go to next iteration to re-check inventory\n\n    # 3. If not adjacent/used, proceed with BFS to find a path to an adjacent cell\n    current_pos = current_state.pos\n    # grid is already fetched as current_state.grid above.\n    grid_width, grid_height, _ = grid.shape\n\n    queue = deque([(current_pos[0], current_pos[1], [])]) # (x, y, path_of_actions_to_reach_here)\n    visited = {(current_pos[0], current_pos[1])} # Keep track of visited positions to avoid cycles\n    \n    path_to_target_adj = None # Stores the action sequence from BFS\n    \n    while queue:\n        px, py, path_so_far = queue.popleft()\n\n        # Check if the current BFS position (px, py) is suitable to be adjacent to the primitive\n        # This means checking the 8 neighbors of (px, py) for the primitive.\n        target_primitive_found_by_bfs = False\n        for dx_nb in [-1, 0, 1]:\n            for dy_nb in [-1, 0, 1]:\n                if dx_nb == 0 and dy_nb == 0: # Exclude the current BFS position itself\n                    continue\n                nx_nb, ny_nb = px + dx_nb, py + dy_nb\n                if _is_valid_pos(nx_nb, ny_nb, grid.shape) and grid[nx_nb, ny_nb, primitive] == 1:\n                    target_primitive_found_by_bfs = True\n                    break\n            if target_primitive_found_by_bfs:\n                break\n        \n        if target_primitive_found_by_bfs:\n            path_to_target_adj = path_so_far\n            break # Path found, exit BFS\n            \n        # Explore valid and unvisited neighboring cells for movement\n        for action_val, (dx, dy) in move_deltas.items():\n            next_x, next_y = px + dx, py + dy\n            # Ensure within bounds and not visited\n            if _is_valid_pos(next_x, next_y, grid.shape) and (next_x, next_y) not in visited:\n                visited.add((next_x, next_y))\n                queue.append((next_x, next_y, path_so_far + [action_val]))\n    \n    # 4. Execute the first action from the determined path\n    action_to_take = None\n    if path_to_target_adj is not None and len(path_to_target_adj) > 0:\n        action_to_take = path_to_target_adj[0] # Take the first step found by BFS\n    \n    if action_to_take is not None:\n        # Perform the step in the environment\n        _reward, done, _observations = env.step(action_to_take)\n        actions_taken.append(action_to_take)\n        \n        # If the environment indicates the episode is done (e.g., max_steps reached)\n        if done:\n          return actions_taken\n    else:\n        # If no valid action could be determined (e.g., primitive unreachable, or gone from map)\n        break\n            \n  return actions_taken", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:06:37.136665", "function_name": "collect", "function_body": "  from collections import deque\n\n  actions_taken = []\n  \n  # Get action integer IDs from the environment's action_specs\n  action_map = env.action_specs()\n  \n  # Get references to world for item type information\n  world = env.world\n  \n  # Define a reasonable max number of steps to prevent infinite loops\n  MAX_COLLECT_STEPS = 200 \n\n  # Map movement actions to (dx, dy) coordinate changes for BFS\n  # CraftWorld agent position `pos` is (column, row).\n  # UP: decreases row (y), column (x) stays same -> (0, -1)\n  # DOWN: increases row (y), column (x) stays same -> (0, 1)\n  # LEFT: decreases column (x), row (y) stays same -> (-1, 0)\n  # RIGHT: increases column (x), row (y) stays same -> (1, 0)\n  move_deltas = {\n      action_map['UP']: (0, -1),\n      action_map['DOWN']: (0, 1),\n      action_map['LEFT']: (-1, 0),\n      action_map['RIGHT']: (1, 0),\n  }\n  \n  # Helper to check if a position is within grid bounds\n  def _is_valid_pos(x, y, grid_shape):\n      width, height, _ = grid_shape\n      return 0 <= x < width and 0 <= y < height\n\n  # Helper function to find the shortest path to a cell adjacent to the target primitive\n  def _find_path_to_adjacent(start_pos, target_kind_idx, current_grid, grid_shape):\n      \"\"\"\n      Performs a BFS to find the shortest sequence of movement actions from start_pos\n      to any cell that is adjacent (8-directional) to an instance of target_kind_idx.\n      Returns the list of actions or None if no such path exists.\n      \"\"\"\n      queue = deque([(start_pos[0], start_pos[1], [])]) # (x, y, path_of_actions_to_reach_here)\n      visited = {(start_pos[0], start_pos[1])} # Keep track of visited positions to avoid cycles\n      \n      while queue:\n          px, py, path_so_far = queue.popleft()\n\n          # Check if the current BFS position (px, py) is adjacent to the primitive\n          is_adjacent_to_primitive = False\n          # Iterate over a 3x3 neighborhood, excluding the current cell (px, py) itself\n          for dx_nb in [-1, 0, 1]:\n              for dy_nb in [-1, 0, 1]:\n                  if dx_nb == 0 and dy_nb == 0: # Skip the current cell\n                      continue\n                  nx_nb, ny_nb = px + dx_nb, py + dy_nb\n                  if _is_valid_pos(nx_nb, ny_nb, grid_shape) and current_grid[nx_nb, ny_nb, target_kind_idx] == 1:\n                      is_adjacent_to_primitive = True\n                      break\n              if is_adjacent_to_primitive:\n                  break\n          \n          if is_adjacent_to_primitive:\n              # This (px, py) is a target position for the agent to move to.\n              # path_so_far is the shortest sequence of actions to reach this position.\n              return path_so_far # Path found, exit BFS\n              \n          # Explore valid and unvisited neighboring cells for movement\n          for action_val, (dx, dy) in move_deltas.items():\n              next_x, next_y = px + dx, py + dy\n              if _is_valid_pos(next_x, next_y, grid_shape) and (next_x, next_y) not in visited:\n                  # Assuming agents can move into any valid empty cell.\n                  # CraftWorld typically does not have explicit untraversable obstacles beyond grid boundaries.\n                  visited.add((next_x, next_y))\n                  queue.append((next_x, next_y, path_so_far + [action_val]))\n      \n      return None # No path found to any cell adjacent to the primitive\n\n  # Check if the primitive is a known grabbable item.\n  # If it's not grabbable, this function cannot collect it.\n  if primitive not in world.grabbable_indices:\n      return []\n\n  path_to_primitive_adj = None # Stores the pre-computed sequence of movement actions\n\n  # Main loop for finding and collecting the primitive\n  for _ in range(MAX_COLLECT_STEPS):\n    current_state = env._current_state # Direct access to the internal CraftState\n    \n    # 1. Check if the primitive is already in the agent's inventory\n    if current_state.inventory[primitive] > 0:\n      return actions_taken # Goal achieved\n\n    # 2. If the agent is currently next to the primitive, use it\n    if current_state.next_to(primitive):\n      _reward, done, _observations = env.step(action_map['USE'])\n      actions_taken.append(action_map['USE'])\n      path_to_primitive_adj = None # Invalidate the path, as the primitive might have been collected or grid changed\n      if done:\n        break # Episode finished\n      continue # Go to next iteration to re-check inventory immediately\n\n    # 3. Path Planning or Path Following\n    if path_to_primitive_adj is None or len(path_to_primitive_adj) == 0:\n        # If no path is currently planned or the existing path is exhausted, find a new one\n        path_to_primitive_adj = _find_path_to_adjacent(\n            current_state.pos, \n            primitive, \n            current_state.grid, \n            current_state.grid.shape\n        )\n        \n        if path_to_primitive_adj is None:\n            # If no path can be found to the primitive, it's unreachable or doesn't exist.\n            break # Cannot collect\n\n    # 4. Execute the next action in the pre-computed path\n    if path_to_primitive_adj: # Check if path is not empty after potential replanning\n        action_to_take = path_to_primitive_adj.pop(0) # Take the first step and remove it from the planned path\n        _reward, done, _observations = env.step(action_to_take)\n        actions_taken.append(action_to_take)\n        \n        # If the environment indicates the episode is done (e.g., max_steps reached)\n        if done:\n          break\n    else:\n        # This branch should ideally not be reached if the logic for `path_to_primitive_adj is None or len(...) == 0`\n        # and the subsequent `_find_path_to_adjacent` call are working correctly.\n        # It's a fallback if `path_to_primitive_adj` becomes empty unexpectedly.\n        break\n            \n  return actions_taken", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:07:58.052009", "function_name": "collect", "function_body": "  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Define internal direction mapping for consistency with (dx, dy) deltas\n  # Assuming 0:North (UP), 1:East (RIGHT), 2:South (DOWN), 3:West (LEFT)\n  DIR_N = 0\n  DIR_E = 1\n  DIR_S = 2\n  DIR_W = 3\n\n  # Map movement actions to the direction the agent will face after the action\n  action_to_new_dir = {\n      _UP: DIR_N,\n      _RIGHT: DIR_E,\n      _DOWN: DIR_S,\n      _LEFT: DIR_W,\n  }\n\n  # Map direction indices to their (dx, dy) deltas for the cell \"in front\"\n  # (0,-1) for North (Up), (1,0) for East (Right), (0,1) for South (Down), (-1,0) for West (Left)\n  dir_to_delta = {\n      DIR_N: (0, -1),\n      DIR_E: (1, 0),\n      DIR_S: (0, 1),\n      DIR_W: (-1, 0)\n  }\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario (or current grid shape)\n  WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Convert one-hot initial direction to an integer index\n  initial_dir_idx = np.argmax(features_dict['direction'])\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Identify non-grabbable items that act as obstacles\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle) that blocks movement.\"\"\"\n    # A cell is an obstacle if it contains any non-grabbable item\n    for k in non_grabbable_items_set:\n      if grid[x, y, k] == 1:\n        return True\n    return False\n\n  # Use Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples: (current_x, current_y, current_direction_idx, [path_actions_to_reach_here])\n  q = collections.deque() # Assumes 'collections' module is imported globally\n  q.append((current_px, current_py, initial_dir_idx, []))\n  \n  # Set to store visited states to avoid cycles and re-processing longer paths.\n  # A state is defined by (x, y, direction_idx).\n  visited = {(current_px, current_py, initial_dir_idx)}\n\n  while q:\n    cx, cy, c_dir_idx, c_path = q.popleft()\n\n    # 1. Check if the primitive can be collected from the current state (position + direction)\n    # The _USE action typically applies to the cell directly in front of the agent.\n    target_dx, target_dy = dir_to_delta[c_dir_idx]\n    tx, ty = cx + target_dx, cy + target_dy\n\n    # Check if the cell in front is within bounds and contains the primitive\n    if (0 <= tx < WIDTH and 0 <= ty < HEIGHT and\n        current_grid[tx, ty, primitive] == 1):\n      # If the primitive is in front, we found a solution!\n      return c_path + [_USE]\n\n    # 2. Explore movement actions (UP, DOWN, LEFT, RIGHT)\n    # Each movement action updates both position and facing direction.\n    for action, new_dir_idx in action_to_new_dir.items():\n      # Calculate new position based on the action's implicit direction\n      move_dx, move_dy = dir_to_delta[new_dir_idx]\n      nx, ny = cx + move_dx, cy + move_dy\n\n      # Check boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if the new cell is an obstacle\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n\n      # If this new state (position and direction) has not been visited\n      if (nx, ny, new_dir_idx) not in visited:\n        new_path = c_path + [action]\n        q.append((nx, ny, new_dir_idx, new_path))\n        visited.add((nx, ny, new_dir_idx))\n  \n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:07:59.041800", "function_name": "collect", "function_body": "  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  actions_to_take = []\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive kind exists at this cell\n      if current_grid[x, y, primitive] == 1: # Assuming 1 for presence\n        primitive_locations.append((x, y))\n\n  # If no primitive is found on the grid, return an empty list of actions\n  if not primitive_locations:\n    return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path to any primitive location\n  # Queue stores tuples: ((current_x, current_y), [path_actions_to_reach_here])\n  # Assuming `collections` is already imported or available in the execution environment.\n  import collections # Explicitly add import for deque if not globally available\n  q = collections.deque()\n  q.append((current_pos, [])) \n  \n  # Set to store visited positions to avoid cycles and re-processing longer paths\n  visited = {current_pos} \n\n  # Define possible movements and their corresponding actions\n  # (dx, dy): action\n  moves = {\n      (0, -1): _UP,\n      (0, 1): _DOWN,\n      (-1, 0): _LEFT,\n      (1, 0): _RIGHT\n  }\n\n  # --- IMPROVEMENT: Refined obstacle definition ---\n  # `collect_v0`'s `is_obstacle` treated ALL `non_grabbable_indices` as impassable.\n  # This might incorrectly block paths through traversable entities like workshops.\n  # For `v2`, we define a more precise set of truly impassable movement obstacles.\n  # `water_index` is a clear candidate for an impassable terrain feature.\n  # Other entities might be non-grabbable (e.g., workshops) but are usually traversable.\n  \n  impassable_movement_terrain_indices = {env.world.water_index} \n  # If `env.world.stone_index` is intended as an impassable wall, add it here:\n  # impassable_movement_terrain_indices.add(env.world.stone_index)\n\n  def is_obstacle_v2(x, y, grid, impassable_kinds_set):\n    \"\"\"\n    Checks if the cell (x,y) contains any truly impassable item for movement.\n    This version distinguishes between non-grabbable items and actual movement obstacles.\n    \"\"\"\n    for k in impassable_kinds_set:\n      if grid[x, y, k] == 1: # Check if the impassable kind is present\n        return True\n    return False\n  # --- END IMPROVEMENT ---\n\n  target_found_path = None\n\n  while q:\n    (cx, cy), current_path = q.popleft()\n\n    # If the current position contains the primitive, we found a path.\n    # Since it's BFS, this is guaranteed to be the shortest path to *a* primitive.\n    if current_grid[cx, cy, primitive] == 1:\n      target_found_path = current_path\n      break # Exit BFS as the shortest path is found\n\n    # Explore neighbors\n    for (dx, dy), action in moves.items():\n      nx, ny = cx + dx, cy + dy\n\n      # Check boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if already visited\n      if (nx, ny) in visited:\n        continue\n\n      # --- IMPROVEMENT: Use the refined obstacle check ---\n      if is_obstacle_v2(nx, ny, current_grid, impassable_movement_terrain_indices):\n        continue\n      # --- END IMPROVEMENT ---\n\n      # If the neighbor is valid and not an obstacle, add it to the queue\n      new_path = current_path + [action]\n      q.append(((nx, ny), new_path))\n      visited.add((nx, ny))\n  \n  # If a path was found, append the USE action and return it\n  if target_found_path is not None:\n    actions_to_take = target_found_path + [_USE]\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:09:41.275114", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (assuming these are globally defined or accessible)\n  # If not, they would need to be defined within the function or passed in,\n  # but typical DMLab-style environments have these as module-level constants.\n  # For this specific context, let's assume they are available or defined in `env_factory`.\n  # For robust self-containment, defining them here if not guaranteed global:\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  ACTION_DELTAS = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  def _is_valid_pos(pos, grid_shape):\n      \"\"\"Helper to check if a position is within grid boundaries.\"\"\"\n      y, x = pos\n      height, width, _ = grid_shape\n      return 0 <= y < height and 0 <= x < width\n\n  def _is_adjacent_3x3(agent_pos, target_pos):\n      \"\"\"Helper to check if agent_pos is in the 3x3 neighborhood of target_pos (excluding itself).\"\"\"\n      ay, ax = agent_pos\n      ty, tx = target_pos\n      return (abs(ay - ty) <= 1 and abs(ax - tx) <= 1 and (ay != ty or ax != tx))\n\n\n  # Get initial state information from the environment\n  current_craft_state = env._current_state\n  initial_pos = current_craft_state.pos\n  initial_grid = current_craft_state.grid.copy() # Copy grid for simulation\n  initial_inventory = current_craft_state.inventory.copy() # Copy inventory for simulation\n  height, width, n_kinds = initial_grid.shape\n  world_config = env.world # Reference to CraftWorld for obstacle information\n\n  # 1. Check if the primitive is already in the inventory\n  if initial_inventory[primitive] > 0:\n      return [] # Already collected, no actions needed\n\n  # 2. Find all initial locations of the primitive on the grid\n  primitive_locations_on_grid = set()\n  for y in range(height):\n      for x in range(width):\n          if initial_grid[y, x, primitive] == 1:\n              primitive_locations_on_grid.add((y, x))\n\n  if not primitive_locations_on_grid:\n      # Primitive not found on the grid. If it's a \"primitive resource\",\n      # it must be on the grid to be collected directly.\n      return []\n\n  # 3. BFS to find a path to collect the primitive\n  # State for BFS: (current_agent_pos, frozenset_of_remaining_primitive_locations, collected_primitive_count)\n  # The frozenset tracks which primitive instances are still \"on the grid\" in our simulation.\n  q = collections.deque([\n      (initial_pos, frozenset(primitive_locations_on_grid), initial_inventory[primitive], [])\n  ])\n\n  # Visited set: (agent_pos_tuple, frozenset_of_remaining_primitive_locations, collected_primitive_count)\n  # This ensures we don't revisit the same agent position with the same set of remaining items\n  # and the same collection status, preventing cycles and redundant exploration.\n  visited = {\n      (initial_pos, frozenset(primitive_locations_on_grid), initial_inventory[primitive])\n  }\n\n  MAX_PATH_LENGTH = 100 # A reasonable limit to prevent excessively long searches for simple collection tasks\n\n  while q:\n      curr_pos, remaining_primitive_locs, collected_count, actions_taken = q.popleft()\n\n      # Goal check: Is the primitive now collected in the simulated state?\n      if collected_count > 0:\n          return actions_taken\n\n      # Pruning: If the current path is too long, stop exploring this branch\n      if len(actions_taken) >= MAX_PATH_LENGTH:\n          continue\n\n      # Try movement actions (UP, DOWN, LEFT, RIGHT)\n      for action_val, (dy, dx) in ACTION_DELTAS.items():\n          next_y, next_x = curr_pos[0] + dy, curr_pos[1] + dx\n          next_pos = (next_y, next_x)\n\n          # Check if the next position is valid (within grid boundaries)\n          if not _is_valid_pos(next_pos, initial_grid.shape):\n              continue\n\n          # Check for obstacles at the next position\n          # Common obstacles like water and stone are typically not traversable.\n          is_obstacle = False\n          if initial_grid[next_y, next_x, world_config.water_index] == 1 or \\\n             initial_grid[next_y, next_x, world_config.stone_index] == 1:\n              is_obstacle = True\n          if is_obstacle:\n              continue\n\n          # Create the next simulated state tuple for visited check\n          next_state_tuple = (next_pos, remaining_primitive_locs, collected_count)\n          if next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              q.append((next_pos, remaining_primitive_locs, collected_count, actions_taken + [action_val]))\n\n      # Try USE action\n      # Check if the agent is adjacent to any of the *remaining* primitive locations\n      # The `USE` action is assumed to work on any adjacent primitive within the 3x3 neighborhood.\n      used_primitive_in_this_state = False # Flag to avoid multiple USE actions from one state if multiple primitives are adjacent\n      for p_loc in list(remaining_primitive_locs): # Iterate over a copy of the set\n          if _is_adjacent_3x3(curr_pos, p_loc):\n              # Simulate picking up this primitive instance\n              new_collected_count = collected_count + 1\n              # Remove this specific instance from the set of remaining primitive locations\n              new_remaining_primitive_locs = frozenset(loc for loc in remaining_primitive_locs if loc != p_loc)\n\n              next_state_tuple = (curr_pos, new_remaining_primitive_locs, new_collected_count)\n              if next_state_tuple not in visited:\n                  visited.add(next_state_tuple)\n                  q.append((curr_pos, new_remaining_primitive_locs, new_collected_count, actions_taken + [USE]))\n                  # If we just collected the primitive, and this is the first one needed,\n                  # this is the shortest path by BFS property.\n                  # If we need to collect more than one, the loop would continue until `collected_count` reaches target.\n                  # For `collect_v2`, we typically assume collecting *one* instance is sufficient.\n                  if new_collected_count > 0: # Assuming we target collecting at least one primitive\n                      return actions_taken + [USE]\n                  # Set flag so we don't try to \"use\" other adjacent primitives in the same state\n                  # if only one USE action is allowed per step. However, the BFS queue handles this\n                  # by exploring distinct next states. For now, let it try all valid USE actions if multiple are adjacent.\n                  # For simplicity, if one USE leads to success, we're done.\n                  used_primitive_in_this_state = True\n                  break # Break after successfully queuing a USE action for one adjacent primitive instance\n      # This break is crucial if we only want one USE action to be considered from one state,\n      # which is typically how single-step actions work in envs.\n\n\n  # If the BFS completes and no path to collect the primitive is found\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:09:42.289499", "function_name": "collect", "function_body": "  # Constants for actions\n  _DOWN, _UP, _LEFT, _RIGHT, _USE = 0, 1, 2, 3, 4\n\n  # Map internal direction index to (dx, dy) offset\n  # CraftState dir: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT\n  _DIR_TO_OFFSETS = {\n      0: (0, 1),   # DOWN\n      1: (0, -1),  # UP\n      2: (-1, 0),  # LEFT\n      3: (1, 0)    # RIGHT\n  }\n\n  # Map (dx, dy) offset to internal direction index\n  _OFFSETS_TO_DIR = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3    # RIGHT\n  }\n\n  def _get_turn_actions(current_dir, target_dir):\n      \"\"\"\n      Calculates the sequence of turn actions (_LEFT/_RIGHT) to go from current_dir to target_dir.\n      Assumes current_dir and target_dir are 0,1,2,3 for DOWN, UP, LEFT, RIGHT.\n      Returns a tuple: (list of actions, new_dir).\n      \"\"\"\n      if current_dir == target_dir:\n          return [], current_dir\n\n      # Number of right turns needed\n      num_right_turns = (current_dir - target_dir + 4) % 4\n      # Number of left turns needed\n      num_left_turns = (target_dir - current_dir + 4) % 4\n\n      if num_right_turns <= num_left_turns:\n          actions = [_RIGHT] * num_right_turns\n      else:\n          actions = [_LEFT] * num_left_turns\n      \n      return actions, target_dir\n\n\n  actions = []\n  state = env._current_state\n\n  # 1. Check if primitive is already in inventory\n  if state.inventory[primitive] > 0:\n      return actions\n\n  # 2. Find the closest primitive on the grid\n  WIDTH, HEIGHT, _ = state.grid.shape\n  \n  target_primitive_pos = None\n  min_dist_to_primitive = float('inf')\n\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          if state.grid[x, y, primitive] == 1:\n              dist = abs(x - state.pos[0]) + abs(y - state.pos[1])\n              if dist < min_dist_to_primitive:\n                  min_dist_to_primitive = dist\n                  target_primitive_pos = (x, y)\n\n  if target_primitive_pos is None:\n      # Primitive not found on the grid\n      return actions\n\n  # 3. Determine the optimal adjacent position for the agent to stand and the direction to face\n  best_agent_adj_pos = None\n  best_face_dir = None\n  min_dist_to_adj_pos = float('inf')\n\n  # Candidate adjacent cells and the direction the agent should face from there\n  adj_candidates = {\n      (target_primitive_pos[0] - 1, target_primitive_pos[1]): _OFFSETS_TO_DIR[(1, 0)],   # Agent at (tx-1, ty) faces RIGHT\n      (target_primitive_pos[0] + 1, target_primitive_pos[1]): _OFFSETS_TO_DIR[(-1, 0)],  # Agent at (tx+1, ty) faces LEFT\n      (target_primitive_pos[0], target_primitive_pos[1] - 1): _OFFSETS_TO_DIR[(0, 1)],   # Agent at (tx, ty-1) faces DOWN\n      (target_primitive_pos[0], target_primitive_pos[1] + 1): _OFFSETS_TO_DIR[(0, -1)]   # Agent at (tx, ty+1) faces UP\n  }\n\n  for adj_pos, face_dir in adj_candidates.items():\n      ax, ay = adj_pos\n      if 0 <= ax < WIDTH and 0 <= ay < HEIGHT: # Check if adjacent position is within grid bounds\n          dist = abs(ax - state.pos[0]) + abs(ay - state.pos[1])\n          if dist < min_dist_to_adj_pos:\n              min_dist_to_adj_pos = dist\n              best_agent_adj_pos = adj_pos\n              best_face_dir = face_dir\n\n  if best_agent_adj_pos is None:\n      # This case implies the primitive is in a 1x1 grid or unreachable due to map bounds.\n      # For practical purposes, if a primitive is found, an adjacent spot should exist.\n      return actions \n\n  # 4. Generate movement actions to reach best_agent_adj_pos\n  current_px, current_py = state.pos\n  current_dir = state.dir\n  target_px, target_py = best_agent_adj_pos\n\n  # Move horizontally first\n  dx = target_px - current_px\n  if dx != 0:\n      target_move_dir_x = _OFFSETS_TO_DIR[(1, 0)] if dx > 0 else _OFFSETS_TO_DIR[(-1, 0)]\n      turn_acts, current_dir = _get_turn_actions(current_dir, target_move_dir_x)\n      actions.extend(turn_acts)\n      actions.extend([current_dir] * abs(dx))\n      # Simulate current position update for next movement segment\n      current_px = target_px\n\n  # Then move vertically\n  dy = target_py - current_py\n  if dy != 0:\n      target_move_dir_y = _OFFSETS_TO_DIR[(0, 1)] if dy > 0 else _OFFSETS_TO_DIR[(0, -1)]\n      turn_acts, current_dir = _get_turn_actions(current_dir, target_move_dir_y)\n      actions.extend(turn_acts)\n      actions.extend([current_dir] * abs(dy))\n      # Simulate current position update\n      current_py = target_py\n  \n  # 5. Generate turn and USE actions\n  turn_acts, _ = _get_turn_actions(current_dir, best_face_dir)\n  actions.extend(turn_acts)\n  actions.append(_USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:10:45.240571", "function_name": "collect", "function_body": "  import collections\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 0 and dy == 0:\n      return None\n\n    # Determine primary axis movement (horizontal or vertical) for facing\n    if abs(dx) >= abs(dy): # Prioritize horizontal if magnitude is greater or equal\n      return EAST_DIR if dx > 0 else WEST_DIR\n    else: # abs(dy) > abs(dx)\n      return SOUTH_DIR if dy > 0 else NORTH_DIR\n\n  # Helper function: Returns actions to turn from current_dir to target_dir.\n  # Assumes LEFT_ACTION and RIGHT_ACTION are used for turning.\n  def _get_turn_actions(current_dir, target_dir):\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION) # Turn right\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION) # Turn left\n    return actions\n\n  primitive_id = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n  agent_grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir # Agent's initial facing direction\n\n  grid_height, grid_width, _ = agent_grid.shape\n\n  # Define all indices that act as obstacles for movement.\n  # This includes non-grabbable items, workshops, and the primitive itself (cannot walk onto it).\n  movement_obstacle_indices = set()\n  movement_obstacle_indices.update(env.world.non_grabbable_indices)\n  movement_obstacle_indices.update(env.world.workshop_indices)\n  movement_obstacle_indices.add(primitive_id) # Cannot move onto the item we want to collect\n\n  def is_traversable(x, y, grid_data, obstacles_set):\n    \"\"\"Checks if a given grid cell (x, y) is within bounds and contains no obstacles.\"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    for kind_idx in obstacles_set:\n      if grid_data[y, x, kind_idx] == 1: # Assuming 1 means presence\n        return False\n    return True\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(agent_grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Step 1: Identify all potential collection points.\n  # These are cells from which the agent can be adjacent to *any* instance of the primitive\n  # and perform a USE action.\n  primitive_locations = set()\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n  \n  potential_collection_points = set()\n  # Define deltas for checking cardinal adjacency\n  ADJACENCY_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n\n  for px, py in primitive_locations:\n    for dx, dy in ADJACENCY_DELTAS:\n      adj_x, adj_y = px + dx, py + dy\n      # A cell is a valid collection point if it's within bounds AND it's traversable\n      # (i.e., not an obstacle for movement).\n      if is_traversable(adj_x, adj_y, agent_grid, movement_obstacle_indices):\n          potential_collection_points.add((adj_x, adj_y))\n  \n  if not potential_collection_points:\n      return [] # No valid collection points (e.g., item might be completely surrounded by obstacles)\n\n  # Step 2: BFS Pathfinding to *any* of the potential_collection_points.\n  # Using collections.deque for efficient popleft().\n  queue = collections.deque([(agent_pos_x, agent_pos_y, [])]) # (x, y, path_actions)\n  visited = set([(agent_pos_x, agent_pos_y)])\n  \n  path_to_adj_pos = []\n  chosen_adj_pos = None # The specific adjacent position the agent will move to\n  target_item_pos_for_facing = None # The specific primitive instance to face (for facing direction)\n\n  # Define movement deltas for BFS. These actions move the agent cardinally.\n  # They do NOT change the agent's facing direction.\n  ACTION_MOVES = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0),\n  }\n\n  while queue:\n    curr_x, curr_y, current_path = queue.popleft() # Efficient pop from left\n\n    # Check if the current position is one of the potential collection points\n    if (curr_x, curr_y) in potential_collection_points:\n      path_to_adj_pos = current_path\n      chosen_adj_pos = (curr_x, curr_y)\n      \n      # Now, identify *which* primitive instance this chosen_adj_pos is adjacent to.\n      # Any adjacent primitive will do for the USE action, so pick the first one found.\n      for dx, dy in ADJACENCY_DELTAS:\n          item_x, item_y = curr_x + dx, curr_y + dy\n          if 0 <= item_x < grid_width and 0 <= item_y < grid_height and\\\n             agent_grid[item_y, item_x, primitive_id] == 1:\n              target_item_pos_for_facing = (item_x, item_y)\n              break # Found the target item for facing\n      break # Path found to a valid collection point, exit BFS\n\n    # Explore possible moves from current position\n    for action, (dx, dy) in ACTION_MOVES.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      if (next_x, next_y) not in visited: # Check visited set before traversability for slight efficiency\n        # If the cell is traversable (not an obstacle for movement)\n        if is_traversable(next_x, next_y, agent_grid, movement_obstacle_indices):\n            visited.add((next_x, next_y))\n            queue.append((next_x, next_y, current_path + [action]))\n\n  # If no path was found to any collection point (queue exhausted before finding a target)\n  if chosen_adj_pos is None:\n    return []\n\n  final_actions = list(path_to_adj_pos)\n\n  # After moving to the chosen_adj_pos, determine the direction the agent needs to face\n  # the primitive and add the necessary turning actions.\n  # The agent's `dir` (initial direction) is used as `current_dir` because the movement actions\n  # (UP, DOWN, LEFT, RIGHT) do not change the agent's facing direction.\n  if target_item_pos_for_facing is not None:\n    target_face_dir = _get_target_facing_direction(chosen_adj_pos[0], chosen_adj_pos[1], \n                                                   target_item_pos_for_facing[0], target_item_pos_for_facing[1])\n    if target_face_dir is not None:\n      # Pass the agent's *initial* direction here, as movement actions don't change it.\n      # The turn actions will then adjust from this initial direction.\n      final_actions.extend(_get_turn_actions(agent_dir, target_face_dir)) \n  \n  # Finally, add the USE action to collect the primitive\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:10:46.251406", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  # Direction constants (assuming 0=N, 1=E, 2=S, 3=W clockwise from North)\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    \"\"\"Calculates the direction the agent needs to face to look at the item.\"\"\"\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 0 and dy == 0:\n      return None # Agent is on top of item, should not happen when targeting an adjacent cell\n\n    # Prioritize cardinal directions based on largest component\n    if abs(dx) >= abs(dy): # Prioritize horizontal if magnitude is greater or equal\n      return EAST_DIR if dx > 0 else WEST_DIR\n    else: # abs(dy) > abs(dx)\n      return SOUTH_DIR if dy > 0 else NORTH_DIR\n\n  def _get_turn_actions(current_dir, target_dir):\n    \"\"\"Returns a list of actions to turn from current_dir to target_dir.\n    Assumes LEFT_ACTION and RIGHT_ACTION are turn actions.\"\"\"\n    actions = []\n    if current_dir == target_dir:\n      return []\n\n    # Calculate shortest turns (clockwise vs. counter-clockwise)\n    clockwise_turns = (target_dir - current_dir + 4) % 4\n    counter_clockwise_turns = (current_dir - target_dir + 4) % 4\n\n    if clockwise_turns <= counter_clockwise_turns:\n      for _ in range(clockwise_turns):\n        actions.append(RIGHT_ACTION) # Turn right\n    else:\n      for _ in range(counter_clockwise_turns):\n        actions.append(LEFT_ACTION) # Turn left\n    return actions\n\n  primitive_id = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n  agent_grid = current_state.grid\n  agent_pos_x, agent_pos_y = current_state.pos\n  agent_dir = current_state.dir # Agent's initial facing direction\n\n  grid_height, grid_width, _ = agent_grid.shape\n\n  # Define general obstacles that cannot be traversed by the agent.\n  # These are entities that are not the target primitive, but still block movement.\n  general_obstacle_kind_ids = env.world.non_grabbable_indices.union(env.world.workshop_indices)\n\n  def is_cell_traversable(x, y):\n    \"\"\"\n    Checks if a given grid cell (x,y) is within bounds and can be traversed by the agent.\n    A cell is not traversable if:\n    1. It's out of bounds.\n    2. It contains the target primitive itself (agent cannot move onto the item it wants to collect).\n    3. It contains any other identified general obstacle (non-grabbable items, workshops).\n    \"\"\"\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Agent cannot move onto the primitive it's trying to collect.\n    if agent_grid[y, x, primitive_id] > 0:\n      return False\n    \n    # Agent cannot move onto any other general obstacle.\n    for obs_idx in general_obstacle_kind_ids:\n      if agent_grid[y, x, obs_idx] > 0:\n        return False\n    \n    return True\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(agent_grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Identify all potential collection points. These are cells from which the agent\n  # can be adjacent to *any* instance of the primitive and perform a USE action.\n  primitive_locations = set()\n  for i in range(len(x_coords)):\n    primitive_locations.add((x_coords[i], y_coords[i]))\n  \n  potential_collection_points = set()\n  ADJACENCY_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Cardinal adjacency\n\n  for px, py in primitive_locations:\n    for dx, dy in ADJACENCY_DELTAS:\n      adj_x, adj_y = px + dx, py + dy\n      if is_cell_traversable(adj_x, adj_y):\n        potential_collection_points.add((adj_x, adj_y))\n  \n  if not potential_collection_points:\n      return [] # No valid collection points (e.g., item might be completely surrounded by obstacles)\n\n  # BFS Pathfinding to *any* of the potential_collection_points.\n  # Using collections.deque for efficient popleft() (O(1)).\n  queue = collections.deque([(agent_pos_x, agent_pos_y, [])]) # (x, y, path_actions)\n  visited = set([(agent_pos_x, agent_pos_y)])\n  \n  path_to_adj_pos = []\n  chosen_adj_pos = None # The specific adjacent position the agent will move to\n  target_item_pos_for_facing = None # The specific primitive instance to face (for facing direction)\n\n  ACTION_MOVES = { # These actions move the agent but do NOT change its facing direction.\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0),\n  }\n\n  while queue:\n    curr_x, curr_y, current_path = queue.popleft()\n\n    # If the current position is one of the potential collection points, we found a path.\n    if (curr_x, curr_y) in potential_collection_points:\n      path_to_adj_pos = current_path\n      chosen_adj_pos = (curr_x, curr_y)\n      \n      # Determine *which* primitive instance this chosen_adj_pos is adjacent to,\n      # for calculating the final facing direction.\n      for dx, dy in ADJACENCY_DELTAS:\n          item_x, item_y = curr_x + dx, curr_y + dy\n          # Check bounds and if it contains the primitive\n          if 0 <= item_x < grid_width and 0 <= item_y < grid_height and \\\n             agent_grid[item_y, item_x, primitive_id] == 1:\n              target_item_pos_for_facing = (item_x, item_y)\n              break # Found the target item for facing\n      break # Path found, exit BFS\n\n    # Explore possible moves from current position\n    for action, (dx, dy) in ACTION_MOVES.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      if (next_x, next_y) not in visited and is_cell_traversable(next_x, next_y):\n        visited.add((next_x, next_y))\n        queue.append((next_x, next_y, current_path + [action]))\n\n  if chosen_adj_pos is None:\n    return [] # No path found to any valid collection point\n\n  final_actions = list(path_to_adj_pos)\n\n  # After moving to the chosen_adj_pos, determine the direction the agent needs to face\n  # the primitive and add the necessary turning actions.\n  # The agent's `dir` (initial direction) is used as `current_dir` because the movement actions\n  # (UP, DOWN, LEFT, RIGHT) do not change the agent's facing direction.\n  if target_item_pos_for_facing is not None:\n    target_face_dir = _get_target_facing_direction(chosen_adj_pos[0], chosen_adj_pos[1], \n                                                   target_item_pos_for_facing[0], target_item_pos_for_facing[1])\n    if target_face_dir is not None:\n      final_actions.extend(_get_turn_actions(agent_dir, target_face_dir))\n  \n  # Finally, add the USE action to collect the primitive\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:11:47.468355", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n\n  NORTH_DIR = 0\n  EAST_DIR = 1\n  SOUTH_DIR = 2\n  WEST_DIR = 3\n\n  # Helper function: Calculates direction agent needs to face to look at an item\n  # Assumes agent_pos and item_pos are cardinally adjacent.\n  def _get_target_facing_direction(agent_x, agent_y, item_x, item_y):\n    dx = item_x - agent_x\n    dy = item_y - agent_y\n\n    if dx == 1 and dy == 0: return EAST_DIR\n    if dx == -1 and dy == 0: return WEST_DIR\n    if dy == 1 and dx == 0: return SOUTH_DIR\n    if dy == -1 and dx == 0: return NORTH_DIR\n    return None # Should not happen if agent_pos and item_pos are cardinally adjacent\n\n  # Helper function: Checks if a cell is traversable (no non-grabbable items)\n  def _is_traversable(grid, x, y, non_grabbable_indices, grid_width, grid_height):\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    # Check if any non-grabbable item (obstacle) is at (x, y)\n    for k_idx in non_grabbable_indices:\n      if grid[y, x, k_idx] == 1:\n        return False\n    return True\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n\n  # Check if the primitive is already in inventory. This is an improvement\n  # over collect_v1 by avoiding unnecessary pathfinding if the goal is already met.\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already have the primitive, no actions needed.\n\n  grid = current_state.grid\n  initial_agent_x, initial_agent_y = current_state.pos\n  initial_agent_dir = current_state.dir\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Get non-grabbable indices for traversability check\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find all locations of the primitive on the grid\n  y_coords, x_coords = np.where(grid[:, :, primitive_id] == 1)\n\n  if len(x_coords) == 0:\n    return [] # Primitive not found on the grid\n\n  # Prepare BFS goal states: (agent_x, agent_y, agent_facing_dir)\n  # These are the states from which the 'USE' action can be performed to collect the primitive.\n  bfs_target_agent_states = set()\n  for i in range(len(x_coords)):\n    item_x, item_y = x_coords[i], y_coords[i]\n    \n    # Consider all 4 cardinal adjacent cells for the agent to stand on\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (dx_adj, dy_adj) from item to agent\n      adj_x, adj_y = item_x + dx_adj, item_y + dy_adj\n\n      if _is_traversable(grid, adj_x, adj_y, non_grabbable_indices, grid_width, grid_height):\n        # Calculate the direction the agent needs to face from (adj_x, adj_y) to look at (item_x, item_y)\n        required_dir = _get_target_facing_direction(adj_x, adj_y, item_x, item_y)\n        if required_dir is not None:\n          bfs_target_agent_states.add((adj_x, adj_y, required_dir))\n  \n  if not bfs_target_agent_states:\n    return [] # No traversable adjacent positions from which to collect the primitive\n\n  # BFS setup\n  # Queue stores (x, y, dir) tuples representing agent's state\n  queue = collections.deque([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Visited set to store (x, y, dir) states to avoid cycles and redundant processing\n  visited = set([(initial_agent_x, initial_agent_y, initial_agent_dir)])\n  \n  # Parent map to reconstruct the path: {child_state: (parent_state, action_to_child)}\n  parent_map = {} \n  \n  found_goal_state = None # Stores the (x, y, dir) of the goal state once found\n\n  # Movement actions and their effects: (dx, dy, resulting_direction)\n  movement_actions_map = {\n      UP_ACTION: (0, -1, NORTH_DIR),\n      DOWN_ACTION: (0, 1, SOUTH_DIR),\n      LEFT_ACTION: (-1, 0, WEST_DIR),\n      RIGHT_ACTION: (1, 0, EAST_DIR)\n  }\n  \n  while queue:\n    curr_x, curr_y, curr_dir = queue.popleft()\n\n    # Check if the current state is one of the goal states\n    if (curr_x, curr_y, curr_dir) in bfs_target_agent_states:\n      found_goal_state = (curr_x, curr_y, curr_dir)\n      break # Found the shortest path to a goal\n    \n    # Explore movement actions: agent moves and its direction is set by the movement\n    for action, (dx, dy, resulting_dir) in movement_actions_map.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_dir = resulting_dir # Direction is fixed by the move action type\n\n      next_state = (next_x, next_y, next_dir)\n      if _is_traversable(grid, next_x, next_y, non_grabbable_indices, grid_width, grid_height):\n        if next_state not in visited:\n          visited.add(next_state)\n          parent_map[next_state] = ((curr_x, curr_y, curr_dir), action)\n          queue.append(next_state)\n    \n    # Explore turning actions: agent changes direction without changing position\n    # The actions LEFT_ACTION and RIGHT_ACTION can be used for pure turns.\n    for turn_action in [LEFT_ACTION, RIGHT_ACTION]: \n      next_x, next_y = curr_x, curr_y # Position does not change for a pure turn\n      \n      # Calculate new direction based on the turn action\n      if turn_action == LEFT_ACTION:\n        next_dir = (curr_dir - 1 + 4) % 4 # Turn counter-clockwise\n      else: # RIGHT_ACTION\n        next_dir = (curr_dir + 1) % 4 # Turn clockwise\n      \n      next_state = (next_x, next_y, next_dir)\n      if next_state not in visited: # No traversability check needed as position doesn't change\n        visited.add(next_state)\n        parent_map[next_state] = ((curr_x, curr_y, curr_dir), turn_action)\n        queue.append(next_state)\n\n  if found_goal_state is None:\n    return [] # No path found to any primitive's collection point\n\n  # Reconstruct the path from the goal state back to the initial state\n  actions = []\n  curr_state = found_goal_state\n  initial_state = (initial_agent_x, initial_agent_y, initial_agent_dir)\n\n  while curr_state != initial_state:\n    # If initial state is the goal state, we don't need to look up a parent.\n    # The loop condition handles this correctly.\n    parent_state, action = parent_map[curr_state]\n    actions.insert(0, action) # Prepend action to build path in correct order\n    curr_state = parent_state\n  \n  # Finally, append the USE action after reaching the correct position and facing direction.\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:11:48.455194", "function_name": "collect", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:14:05.021770", "function_name": "collect", "function_body": "    actions = []\n    MAX_COLLECT_STEPS = 500  # Safety limit to prevent infinite loops\n\n    # Get the number of kinds from the world for interpreting grid features\n    # This assumes `env` is a CraftLab instance and `env.world` is a CraftWorld instance\n    # which in turn has a `cookbook` with `n_kinds`.\n    # Based on the class definitions, this access path is valid.\n    n_kinds = env.world.cookbook.n_kinds\n\n    for _ in range(MAX_COLLECT_STEPS):\n        # Access the current state and observations\n        # _current_state is a CraftState instance\n        current_state = env._current_state\n        # observations() provides the features_dict needed for egocentric view and agent direction\n        current_obs = env.observations()\n\n        # 1. Check if the primitive is already collected in the inventory\n        if current_state.inventory[primitive] > 0:\n            break  # Goal achieved, exit loop\n\n        # Get agent's current absolute position and direction\n        agent_pos_r, agent_pos_c = current_state.pos\n        # Agent direction is one-hot encoded, so argmax gives the index (0-3)\n        agent_dir_idx = np.argmax(current_obs['features_dict']['direction'])\n\n        action_to_take = None  # Initialize action for the current step\n\n        # Define cardinal direction vectors for global grid coordinates\n        # These map direction index (0=N, 1=E, 2=S, 3=W) to (row_change, col_change)\n        DIR_VECS_GLOBAL = {\n            0: (-1, 0),  # North: row decreases, col same\n            1: (0, 1),   # East: row same, col increases\n            2: (1, 0),   # South: row increases, col same\n            3: (0, -1)   # West: row same, col decreases\n        }\n        # Invert the mapping to find direction index from a relative vector\n        INV_DIR_VECS_GLOBAL = {v: k for k, v in DIR_VECS_GLOBAL.items()}\n\n        # 2. Check if the primitive is in the 3x3 neighborhood for immediate 'USE'\n        # Iterate over 3x3 neighborhood around the agent's position\n        target_r, target_c = -1, -1\n        grid = current_state.grid  # The full grid of the current state\n        found_adjacent_primitive = False\n        for r_offset in [-1, 0, 1]:\n            for c_offset in [-1, 0, 1]:\n                if r_offset == 0 and c_offset == 0: continue  # Skip agent's own cell\n\n                check_r, check_c = agent_pos_r + r_offset, agent_pos_c + c_offset\n\n                # Ensure checked coordinates are within grid bounds\n                if 0 <= check_r < grid.shape[0] and 0 <= check_c < grid.shape[1]:\n                    # Check if the primitive kind is present at this location\n                    if grid[check_r, check_c, primitive] == 1.0:\n                        target_r, target_c = check_r, check_c\n                        found_adjacent_primitive = True\n                        break  # Found an adjacent primitive, no need to check further neighbors\n            if found_adjacent_primitive: break\n\n        if found_adjacent_primitive:\n            # Calculate the relative position from the agent to the primitive\n            rel_r, rel_c = target_r - agent_pos_r, target_c - agent_pos_c\n\n            # If the primitive is directly in a cardinal direction (N, E, S, W)\n            if (rel_r, rel_c) in INV_DIR_VECS_GLOBAL:\n                required_dir = INV_DIR_VECS_GLOBAL[(rel_r, rel_c)]\n                # If already facing the primitive, use it\n                if agent_dir_idx == required_dir:\n                    action_to_take = env_factory.ACTIONS['USE']\n                else:\n                    # Turn to face the primitive\n                    diff = (required_dir - agent_dir_idx + 4) % 4  # Calculate difference in direction (0-3)\n                    if diff == 1:  # If target is 90 degrees right\n                        action_to_take = env_factory.ACTIONS['RIGHT']\n                    elif diff == 3:  # If target is 90 degrees left\n                        action_to_take = env_factory.ACTIONS['LEFT']\n                    else:  # diff == 2, target is 180 degrees opposite, take one right turn\n                        action_to_take = env_factory.ACTIONS['RIGHT']\n            # If the primitive is diagonal in the 3x3, action_to_take remains None,\n            # and it will be handled by the egocentric view logic below, which prioritizes movement.\n\n        # 3. If no immediate 'USE' action is determined, look for the primitive in the egocentric view\n        if action_to_take is None:\n            ego_grid = current_obs['features_dict']['features_ego']\n            # Find all locations in the egocentric grid where the primitive exists\n            primitive_cells_in_ego = np.argwhere(ego_grid[:, :, primitive] == 1.0)\n\n            # Determine the agent's position within its egocentric view.\n            # CraftWorld's egocentric view typically places the agent at the center of the window.\n            ego_window_size_h, ego_window_size_w = ego_grid.shape[0], ego_grid.shape[1]\n            agent_ego_r, agent_ego_c = ego_window_size_h // 2, ego_window_size_w // 2\n\n            if primitive_cells_in_ego.size > 0:\n                # Prioritize the first visible primitive (e.g., closest in the view)\n                prim_ego_r, prim_ego_c = primitive_cells_in_ego[0]\n\n                # Calculate the relative position of the primitive from the agent in its egocentric view\n                dr_ego = prim_ego_r - agent_ego_r\n                dc_ego = prim_ego_c - agent_ego_c\n\n                # Determine action based on relative egocentric position\n                if dc_ego < 0:  # Primitive is to the left in the egocentric view\n                    action_to_take = env_factory.ACTIONS['LEFT']\n                elif dc_ego > 0:  # Primitive is to the right in the egocentric view\n                    action_to_take = env_factory.ACTIONS['RIGHT']\n                else:  # Primitive is in the same column in the egocentric view (directly ahead or behind)\n                    if dr_ego < 0:  # Primitive is ahead (higher row number in view if agent faces N)\n                        action_to_take = env_factory.ACTIONS['UP']  # Move forward\n                    elif dr_ego > 0:  # Primitive is behind\n                        # To turn 180 degrees, perform two turns. Execute the first turn now.\n                        action_to_take = env_factory.ACTIONS['RIGHT']\n                        # Perform the first turn immediately so the agent's direction updates for the next loop.\n                        # This ensures the agent will re-evaluate its situation and turn again if needed.\n                        reward, done, obs = env.step(action_to_take)\n                        actions.append(action_to_take)\n                        if done: return actions  # Exit if task done/failed after this partial action\n                        action_to_take = None # Reset action_to_take so the main loop's step uses its own determined action\n\n        # 4. If primitive is not found in vicinity or egocentric view, explore randomly\n        if action_to_take is None:\n            # Simple exploration strategy: alternate between moving forward and turning right\n            # This helps cover ground and avoid getting stuck in corners.\n            if len(actions) % 5 < 3:  # Move forward more often\n                action_to_take = env_factory.ACTIONS['UP']\n            else:  # Turn right occasionally\n                action_to_take = env_factory.ACTIONS['RIGHT']\n\n        # Execute the chosen action for this step\n        reward, done, obs = env.step(action_to_take)\n        actions.append(action_to_take)\n\n        # If the environment signals 'done', the task is either completed or failed (e.g., max_steps reached)\n        if done:\n            break\n\n    return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:14:05.995627", "function_name": "collect", "function_body": "", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:15:46.253632", "function_name": "collect", "function_body": "    all_actions_taken = []\n    \n    # Get action mappings\n    action_map = env.action_specs()\n    ACTION_UP = action_map['UP']\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    def is_traversable(r: int, c: int, current_grid: np.ndarray, non_grabbable_indices: set) -> bool:\n        \"\"\"Checks if a cell (r, c) is traversable.\"\"\"\n        grid_width, grid_height, _ = current_grid.shape\n        if not (0 <= r < grid_width and 0 <= c < grid_height):\n            return False # Out of bounds\n        \n        # Check if cell contains any non-grabbable item (obstacle)\n        # Assuming that if a cell has any non-grabbable item, it's an obstacle.\n        for k_idx in non_grabbable_indices:\n            if current_grid[r, c, k_idx] > 0:\n                return False # Contains an obstacle\n        return True\n\n    # Loop until the primitive is collected or determined unreachable\n    while True:\n        current_state = env._current_state\n\n        # 1. Check if primitive is already collected\n        if current_state.inventory[primitive] > 0:\n            break # Goal achieved\n\n        # 2. Check if next to primitive and can use\n        if current_state.next_to(primitive):\n            all_actions_taken.append(ACTION_USE)\n            reward, done, _ = env.step(ACTION_USE)\n            if done: # If env signals done, we should stop\n                return all_actions_taken\n            # After USE, the inventory should be updated. The loop will re-check it.\n            continue # Re-evaluate the state after the USE action\n\n        # 3. If not collected and not adjacent, find a path to an access location\n        current_grid = current_state.grid\n        current_pos = current_state.pos\n        grid_width, grid_height, _ = current_grid.shape\n        non_grabbable_indices = env.world.non_grabbable_indices\n        \n        primitive_locations = []\n        for r in range(grid_width):\n            for c in range(grid_height):\n                # If the cell contains the primitive\n                if current_grid[r, c, primitive] > 0:\n                    primitive_locations.append((r, c))\n        \n        if not primitive_locations:\n            # Primitive not found on the current map. It's unreachable or does not exist.\n            # Return actions taken so far, as no path can be found.\n            return all_actions_taken\n\n        # Find all cells adjacent to any primitive location (access locations)\n        access_locations = set()\n        for pr, pc in primitive_locations:\n            # Iterate over 3x3 neighborhood including itself, then filter\n            for dr in [-1, 0, 1]:\n                for dc in [-1, 0, 1]:\n                    if dr == 0 and dc == 0: continue # Skip the primitive cell itself\n                    ar, ac = pr + dr, pc + dc\n                    if is_traversable(ar, ac, current_grid, non_grabbable_indices):\n                        access_locations.add((ar, ac))\n        \n        if not access_locations:\n            # Cannot find any traversable cell adjacent to any primitive.\n            # This implies the primitive is completely surrounded by obstacles or off-map.\n            return all_actions_taken\n\n        # BFS to find the shortest path from current_pos to any access_location\n        # Queue stores tuples: (current_position, path_of_coords_leading_to_current_position)\n        q = deque([(current_pos, [])])\n        visited = {current_pos}\n        path_to_access = None # Will store the sequence of coordinates to follow\n\n        while q:\n            curr_pos_bfs, path_coords_bfs = q.popleft()\n            \n            if curr_pos_bfs in access_locations:\n                path_to_access = path_coords_bfs\n                break # Found the shortest path to an access location\n\n            # Define possible moves (cardinal directions)\n            move_deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)] # UP, DOWN, LEFT, RIGHT\n            for dr, dc in move_deltas:\n                next_r, next_c = curr_pos_bfs[0] + dr, curr_pos_bfs[1] + dc\n                next_pos_bfs = (next_r, next_c)\n\n                if next_pos_bfs not in visited and \\\n                   is_traversable(next_r, next_c, current_grid, non_grabbable_indices):\n                    visited.add(next_pos_bfs)\n                    # When adding to queue, append the next position to the path\n                    q.append((next_pos_bfs, path_coords_bfs + [next_pos_bfs]))\n        \n        if path_to_access is None:\n            # No path found to any access location. Primitive is unreachable on this grid.\n            return all_actions_taken\n        \n        # Convert path of coordinates to a sequence of actions\n        actions_for_path = []\n        temp_current_pos = current_pos # Track agent's conceptual position for action conversion\n\n        for next_coord in path_to_access:\n            dr = next_coord[0] - temp_current_pos[0]\n            dc = next_coord[1] - temp_current_pos[1]\n\n            if dr == -1 and dc == 0:\n                action = ACTION_UP\n            elif dr == 1 and dc == 0:\n                action = ACTION_DOWN\n            elif dr == 0 and dc == -1:\n                action = ACTION_LEFT\n            elif dr == 0 and dc == 1:\n                action = ACTION_RIGHT\n            else:\n                # This should ideally not happen with cardinal movements and valid path\n                # Could indicate a bug in BFS or non-cardinal path.\n                raise ValueError(f\"Invalid movement delta {dr, dc} in path conversion. From {temp_current_pos} to {next_coord}\")\n            \n            actions_for_path.append(action)\n            temp_current_pos = next_coord # Update temp position for next step in path\n\n        # Execute the path actions in the environment\n        for action in actions_for_path:\n            all_actions_taken.append(action)\n            reward, done, _ = env.step(action)\n            if done: # If the environment signals done during path execution, stop\n                return all_actions_taken", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:15:46.323907", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Access the current state from the CraftLab environment\n    current_state = env._current_state \n    primitive_idx = primitive\n\n    # Check if the primitive is already in the inventory\n    if current_state.inventory[primitive_idx] > 0:\n        return [] # No actions needed if already collected\n\n    # Get grid dimensions for boundary checks\n    # grid.shape returns (height, width, kinds)\n    grid_height, grid_width, _ = current_state.grid.shape\n\n    # Find the target primitive's position on the grid\n    # np.where returns (row_indices, col_indices) where the condition is true\n    # We are looking for cells where the primitive_idx layer is 1\n    primitive_y_coords, primitive_x_coords = np.where(current_state.grid[:, :, primitive_idx] == 1)\n\n    if not primitive_x_coords.size > 0:\n        # Primitive not found on the grid, cannot be collected\n        return [] \n\n    # Take the first instance of the primitive found as the target\n    target_primitive_pos = (primitive_x_coords[0], primitive_y_coords[0]) # (x, y)\n\n    # Define possible movement actions and their corresponding (dx, dy) deltas\n    # (dx, dy) represents (change in x, change in y) for each action\n    # Assuming actions UP, DOWN, LEFT, RIGHT correspond to absolute grid directions.\n    move_deltas = {\n        env_factory.UP: (0, -1),    # (dx, dy): moving north (y-1)\n        env_factory.DOWN: (0, 1),   # (dx, dy): moving south (y+1)\n        env_factory.LEFT: (-1, 0),  # (dx, dy): moving west (x-1)\n        env_factory.RIGHT: (1, 0),  # (dx, dy): moving east (x+1)\n    }\n\n    # BFS Initialization\n    q = collections.deque()\n    start_pos = current_state.pos # Agent's current (x, y) position\n    \n    # The queue stores tuples: (current_x, current_y, list_of_actions_taken_to_reach_here)\n    q.append((start_pos[0], start_pos[1], []))\n    visited = {(start_pos[0], start_pos[1])} # Keep track of visited (x, y) cells to avoid cycles and redundant paths\n\n    path_to_adjacent_cell = None\n\n    # Perform BFS to find the shortest path to a cell adjacent to the primitive\n    while q:\n        curr_x, curr_y, path_so_far = q.popleft()\n\n        # Check if the current cell (curr_x, curr_y) is 4-directionally adjacent to the primitive\n        # This means the agent can execute the 'USE' action from this position.\n        # `abs(dx) + abs(dy) == 1` checks for direct (up, down, left, right) adjacency.\n        if abs(curr_x - target_primitive_pos[0]) + abs(curr_y - target_primitive_pos[1]) == 1:\n            path_to_adjacent_cell = path_so_far\n            break # Found the shortest path to a usable position, exit BFS\n\n        # Explore all four neighboring cells\n        for action_id, (dx, dy) in move_deltas.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n                continue\n            \n            # Check if the cell has already been visited by a shorter path\n            if (next_x, next_y) not in visited:\n                visited.add((next_x, next_y))\n                # Add the next state to the queue with the updated path\n                q.append((next_x, next_y, path_so_far + [action_id]))\n\n    # If no path to an adjacent cell was found (e.g., primitive is unreachable)\n    if path_to_adjacent_cell is None:\n        return []\n\n    # If a path to an adjacent cell is found, append the USE action as the final step\n    actions_to_take = path_to_adjacent_cell + [env_factory.USE]\n\n    return actions_to_take", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T18:17:28.457512", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      ACTION_UP: DIR_NORTH,\n      ACTION_DOWN: DIR_SOUTH,\n      ACTION_LEFT: DIR_WEST,\n      ACTION_RIGHT: DIR_EAST\n  }\n\n  # Mapping of target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction to collect that target via ACTION_USE.\n  # This focuses on cardinal directions, as ACTION_USE typically applies to what's directly in front.\n  RELATIVE_TO_REQUIRED_DIR = {\n      (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n      (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n      (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n      (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_cell_in_front(pos, direction):\n      y, x = pos\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return None # Should not happen with valid directions\n\n  # Breadth-First Search (BFS) to find a path to the primitive, ensuring the agent\n  # ends up at a position AND orientation suitable for collection.\n  def _find_path_and_orientation_for_collection(start_pos, start_dir, full_grid, primitive_id, world, max_steps):\n      grid_height, grid_width, _ = full_grid.shape\n      impassable_kinds = world.non_grabbable_indices\n      # A primitive is \"traversable\" if it's not in the set of impassable kinds.\n      # Agent can stand on a traversable primitive to collect it.\n      primitive_is_traversable = primitive_id not in impassable_kinds\n\n      # BFS state: (current_y, current_x, current_dir, path_of_actions)\n      q = collections.deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n      # These moves are cardinal and also determine the new facing direction.\n      moves_options = [\n          (-1, 0, ACTION_UP, DIR_NORTH),\n          (1, 0, ACTION_DOWN, DIR_SOUTH),\n          (0, -1, ACTION_LEFT, DIR_WEST),\n          (0, 1, ACTION_RIGHT, DIR_EAST)\n      ]\n\n      while q:\n          curr_y, curr_x, curr_dir, path_actions = q.popleft()\n          \n          # Check for path length limit (reserving at least 1 step for ACTION_USE)\n          if len(path_actions) >= max_steps - 1:\n              continue # Skip expanding paths that are already too long\n\n          # --- Goal Check 1: Primitive is on the current cell and agent can pick it up directly ---\n          if primitive_is_traversable and full_grid[curr_y, curr_x, primitive_id] > 0:\n              # If agent can move onto the primitive and it's present, this is a direct collection point.\n              # Relative coordinates (0,0) indicates target is at agent's current position.\n              return (path_actions, (0, 0)) \n\n          # --- Goal Check 2: Primitive is cardinally adjacent AND agent is facing it correctly ---\n          for rel_dy, rel_dx in RELATIVE_TO_REQUIRED_DIR.keys(): \n              adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n              # Check bounds for the adjacent cell\n              if not (0 <= adj_y < grid_height and 0 <= adj_x < grid_width):\n                  continue\n\n              # Check if the adjacent cell contains the primitive\n              if full_grid[adj_y, adj_x, primitive_id] > 0:\n                  # Primitive found at (adj_y, adj_x). Now, verify agent's orientation.\n                  required_dir_for_collection = RELATIVE_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n                  if curr_dir == required_dir_for_collection:\n                      # Found a path that leads to a position AND ensures the agent is oriented correctly.\n                      return (path_actions, (rel_dy, rel_dx))\n\n          # --- Explore neighboring cells for movement ---\n          for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n              # Check bounds for the next movement cell\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if the next cell is traversable (i.e., does not contain any impassable kinds)\n              is_traversable_for_movement = True\n              for k_idx in impassable_kinds:\n                  if full_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable_for_movement = False\n                      break\n              if not is_traversable_for_movement:\n                  continue\n              \n              # Add to queue only if this new state (position and direction) hasn't been visited\n              if (next_y, next_x, new_dir_after_move) not in visited:\n                  visited.add((next_y, next_x, new_dir_after_move))\n                  q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n      return (None, None) # No path found to the primitive with correct orientation\n\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state for planning.\n  # This ensures the planning starts from a consistent base.\n  current_obs = env.reset() \n  current_state = env._current_state # Access the underlying CraftState instance\n\n  # Initial checks for early exit\n  if primitive not in current_state.world.cookbook.kinds:\n      # The specified primitive ID is not a recognized kind in the world.\n      return [] \n  if current_state.inventory[primitive] > 0:\n      # The primitive has already been collected or is present in inventory.\n      return [] \n\n  full_grid = current_state.features_dict()['features_global']\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  \n  # Find the sequence of movements and the relative target coordinates for collection.\n  path_of_moves, relative_target_coords = _find_path_and_orientation_for_collection(\n      start_pos, start_dir, full_grid, primitive, current_state.world, MAX_COLLECT_STEPS\n  )\n\n  if path_of_moves is None:\n      # No valid path was found to reach a position/orientation suitable for collection.\n      return [] \n\n  # Execute the found path of movements\n  for action in path_of_moves:\n      actions_taken.append(action)\n      # Step the environment with the current action.\n      # We ignore reward and done status as this function's goal is just to return the action sequence.\n      _, _, _ = env.step(action) \n      current_state = env._current_state # Always update the internal state after a step\n\n  # After executing all movement actions, the agent should be at the correct position\n  # and facing the correct direction as determined by the BFS. Now, perform the USE action.\n  \n  # Before attempting USE, verify the primitive is still at the expected location.\n  # This guards against dynamic environments or planning inconsistencies, though for CraftWorld\n  # the grid is generally static during movement.\n  grid_height, grid_width, _ = full_grid.shape # Get dimensions from the initial grid\n  is_primitive_reachable_by_use = False\n\n  if relative_target_coords == (0,0):\n      # Target is on the current cell (agent is standing on it)\n      if (0 <= current_state.pos[0] < grid_height and\n          0 <= current_state.pos[1] < grid_width and\n          full_grid[current_state.pos[0], current_state.pos[1], primitive] > 0):\n          is_primitive_reachable_by_use = True\n  else:\n      # Target is adjacent to the current cell, in the direction agent is facing.\n      target_cell_y, target_cell_x = _get_cell_in_front(current_state.pos, current_state.dir)\n      if (target_cell_y is not None and\n          0 <= target_cell_y < grid_height and 0 <= target_cell_x < grid_width and\n          full_grid[target_cell_y, target_cell_x, primitive] > 0):\n          is_primitive_reachable_by_use = True\n\n  if is_primitive_reachable_by_use:\n      # If the primitive is still present and reachable, append and execute the ACTION_USE.\n      if len(actions_taken) < MAX_COLLECT_STEPS: # Ensure there's still capacity for the USE action\n          actions_taken.append(ACTION_USE)\n          _, _, _ = env.step(ACTION_USE)\n          current_state = env._current_state # Update state after USE\n\n          # Final verification: Confirm the primitive was successfully collected into inventory.\n          if current_state.inventory[primitive] > 0:\n              return actions_taken # Successfully collected!\n          else:\n              # Collection failed even after reaching and attempting USE.\n              # This might happen if specific tools are needed, or the resource depleted, etc.\n              return [] \n      else:\n          # Max steps reached, no space left for the final USE action.\n          return [] \n  else:\n      # Discrepancy: BFS found a path, but primitive is not in the expected location for collection\n      # after executing the path. This indicates a stale plan or dynamic environment changes not\n      # accounted for in the initial static grid planning.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T18:17:29.439024", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  ACTION_DOWN = Action.DOWN\n  ACTION_UP = Action.UP\n  ACTION_LEFT = Action.LEFT\n  ACTION_RIGHT = Action.RIGHT\n  ACTION_USE = Action.USE\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of movement action to the resulting facing direction of the agent\n  # (assuming agent faces the direction of its last movement)\n  ACTION_TO_DIR = {\n      ACTION_UP: DIR_NORTH,\n      ACTION_DOWN: DIR_SOUTH,\n      ACTION_LEFT: DIR_WEST,\n      ACTION_RIGHT: DIR_EAST\n  }\n\n  # Mapping of target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction to collect that target via ACTION_USE.\n  # This focuses on cardinal directions, as ACTION_USE typically applies to what's directly in front.\n  RELATIVE_TO_REQUIRED_DIR = {\n      (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n      (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n      (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n      (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function to determine the grid cell directly in front of the agent\n  def _get_cell_in_front(pos, direction):\n      y, x = pos\n      if direction == DIR_EAST:\n          return (y, x + 1)\n      elif direction == DIR_SOUTH:\n          return (y + 1, x)\n      elif direction == DIR_WEST:\n          return (y, x - 1)\n      elif direction == DIR_NORTH:\n          return (y - 1, x)\n      return None # Should not happen with valid directions\n\n  # Breadth-First Search (BFS) to find a path to the primitive, ensuring the agent\n  # ends up at a position AND orientation suitable for collection.\n  # Improvement: Removed logic for collecting primitives by standing on them (target_coords = (0,0)),\n  # as ACTION_USE typically applies to adjacent cells for primitive collection in CraftWorld.\n  def _find_path_and_orientation_for_collection(start_pos, start_dir, full_grid, primitive_id, world):\n      grid_height, grid_width, _ = full_grid.shape\n      impassable_kinds = world.non_grabbable_indices\n\n      # BFS state: (current_y, current_x, current_dir, path_of_actions)\n      q = collections.deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n      moves_options = [\n          (-1, 0, ACTION_UP, DIR_NORTH),\n          (1, 0, ACTION_DOWN, DIR_SOUTH),\n          (0, -1, ACTION_LEFT, DIR_WEST),\n          (0, 1, ACTION_RIGHT, DIR_EAST)\n      ]\n\n      while q:\n          curr_y, curr_x, curr_dir, path_actions = q.popleft()\n          \n          # Check if the primitive is cardinally adjacent to the current cell AND agent is facing it\n          for rel_dy, rel_dx in RELATIVE_TO_REQUIRED_DIR.keys(): # Iterate through cardinal relative positions\n              adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n              # Check bounds and if the adjacent cell contains the primitive\n              if (0 <= adj_y < grid_height and 0 <= adj_x < grid_width and\n                      full_grid[adj_y, adj_x, primitive_id] > 0):\n                  \n                  # Primitive found at (adj_y, adj_x).\n                  # Now, check if the agent's current direction matches the direction required to collect it.\n                  required_dir_for_collection = RELATIVE_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n                  if curr_dir == required_dir_for_collection:\n                      # Found a path that leads to a position AND ensures the agent is oriented correctly.\n                      # In v2, collection always implies an adjacent target.\n                      return (path_actions, (rel_dy, rel_dx))\n\n          # Explore neighboring cells\n          for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n              # Check bounds\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if the next cell is traversable for movement (i.e., does not contain any impassable kinds)\n              is_traversable_for_movement = True\n              for k_idx in impassable_kinds:\n                  if full_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable_for_movement = False\n                      break\n              if not is_traversable_for_movement:\n                  continue\n              \n              # Add to queue only if this new state (position and direction) hasn't been visited\n              if (next_y, next_x, new_dir_after_move) not in visited:\n                  visited.add((next_y, next_x, new_dir_after_move))\n                  q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n      return (None, None) # No path found to the primitive with correct orientation\n\n  actions_taken = []\n  \n  # Reset the environment to get the initial state\n  current_obs = env.reset() \n  current_state = env._current_state # Access the underlying CraftState instance\n\n  # Initial checks\n  if primitive not in current_state.world.cookbook.kinds:\n      return [] # The specified primitive ID is not recognized\n  if current_state.inventory[primitive] > 0:\n      return [] # The primitive has already been collected\n\n  full_grid = current_state.features_dict()['features_global']\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  grid_height, grid_width, _ = full_grid.shape # Get grid dimensions for validation\n\n  # Find the sequence of movements and the relative target coordinates.\n  # In v2, `relative_target_coords` will always indicate an adjacent cell.\n  path_of_moves, relative_target_coords = _find_path_and_orientation_for_collection(\n      start_pos, start_dir, full_grid, primitive, current_state.world\n  )\n\n  if path_of_moves is None:\n      return [] # No path found that leads to the primitive with correct orientation\n\n  # Execute the found path of movements\n  for action in path_of_moves:\n      # Check if adding this movement action would exceed the total allowed steps\n      # (reserving at least one slot for the final ACTION_USE)\n      if len(actions_taken) + 1 >= MAX_COLLECT_STEPS: \n          return [] # Prevent excessively long action sequences\n      actions_taken.append(action)\n      _, _, _ = env.step(action) # Take the step, update state (reward, done, obs are ignored for this func)\n      current_state = env._current_state # Always update the internal state after a step\n\n  # After executing all movement actions, the agent should be at the correct position\n  # and facing the correct direction as determined by the BFS. Now, perform the USE action.\n  \n  # Verify that the primitive is indeed located where the agent expects to collect it from (in front of agent).\n  is_primitive_reachable_by_use = False\n\n  target_cell_y, target_cell_x = _get_cell_in_front(current_state.pos, current_state.dir)\n  \n  # Check if the cell directly in front contains the primitive\n  if target_cell_y is not None and \\\n     0 <= target_cell_y < grid_height and 0 <= target_cell_x < grid_width: # Check bounds\n      if full_grid[target_cell_y, target_cell_x, primitive] > 0:\n          is_primitive_reachable_by_use = True\n\n  if is_primitive_reachable_by_use:\n      # If the primitive is reachable, append and execute the ACTION_USE\n      if len(actions_taken) < MAX_COLLECT_STEPS: # Ensure there's still capacity for the USE action\n          actions_taken.append(ACTION_USE)\n          _, _, _ = env.step(ACTION_USE)\n          current_state = env._current_state # Update state after USE\n\n          # Final check: Confirm the primitive was successfully collected into inventory\n          if current_state.inventory[primitive] > 0:\n              return actions_taken # Successfully collected!\n          else:\n              # Collection failed even after reaching and attempting USE (e.g., requires specific tool,\n              # resource depleted, environmental constraint not modeled by simple traversability, etc.)\n              return [] \n      else:\n          # Max steps reached, no space left for the final USE action\n          return [] \n  else:\n      # This case indicates a discrepancy: BFS found a path, but the primitive is not\n      # in the expected location (directly in front) after executing the path. This should\n      # ideally not happen if the environment state is deterministic and the BFS logic\n      # is perfectly aligned with the game mechanics.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
