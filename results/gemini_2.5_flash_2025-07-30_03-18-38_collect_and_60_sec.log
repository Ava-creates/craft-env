{"timestamp": "2025-07-30T05:35:42.084175", "function_name": "collect", "function_body": "    current_state = env._current_state\n\n    # 1. Check if primitive is already in inventory\n    if current_state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    grid_height, grid_width, _ = current_state.grid.shape\n    agent_x, agent_y = current_state.pos\n\n    # Find all locations where the primitive is present on the grid\n    primitive_grid_locations = [] # List of (x, y) tuples\n    for y_idx in range(grid_height):\n        for x_idx in range(grid_width):\n            if current_state.grid[y_idx, x_idx, primitive] > 0:\n                primitive_grid_locations.append((x_idx, y_idx))\n\n    if not primitive_grid_locations:\n        return [] # Primitive not found on the grid at all\n\n    # Define actions and their corresponding (dx, dy) deltas\n    # CraftLab actions: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    # Note: the order of iterating through these deltas can affect path found\n    # For a general BFS, order doesn't matter for optimality, but consistency is good.\n    # Preferring a common order like cardinal directions.\n    # (dx, dy) -> action value mapping\n    action_to_delta = {\n        0: (0, 1),  # DOWN\n        1: (0, -1), # UP\n        2: (-1, 0), # LEFT\n        3: (1, 0)   # RIGHT\n    }\n    # Reverse mapping for BFS: (dx, dy) -> action\n    delta_to_action = {v: k for k, v in action_to_delta.items()}\n\n    # BFS setup using a simple list as a queue (to avoid 'collections' import)\n    q = [((agent_x, agent_y), [])] # Queue stores (current_pos, path_actions_to_reach_here)\n    visited = {(agent_x, agent_y)} # Set of visited positions to avoid cycles\n\n    MAX_SEARCH_DEPTH = 50 # Limit search depth to prevent very long computations\n\n    path_to_adjacent_cell = [] # This will store the sequence of move actions\n\n    head = 0 # Manual pointer for the front of the queue\n    while head < len(q):\n        (cx, cy), current_path = q[head]\n        head += 1\n\n        if len(current_path) >= MAX_SEARCH_DEPTH:\n            continue # Prune paths that are too long\n\n        # Check if the current position (cx, cy) is adjacent to any primitive location\n        # This is the goal condition for our BFS: find a walkable cell adjacent to the primitive\n        is_adjacent_to_primitive = False\n        for px, py in primitive_grid_locations:\n            # Check if (cx, cy) is adjacent to (px, py) by Manhattan distance of 1\n            if (abs(cx - px) == 1 and cy == py) or (abs(cy - py) == 1 and cx == px):\n                is_adjacent_to_primitive = True\n                break\n        \n        if is_adjacent_to_primitive:\n            path_to_adjacent_cell = current_path\n            break # Found the shortest path to an adjacent cell\n\n        # Explore neighbors\n        # Iterate through possible movement deltas (e.g., (-1,0) for LEFT, (0,-1) for UP, etc.)\n        # Order doesn't strictly matter for shortest path in unweighted graph, but consistent traversal helps.\n        # We need to iterate over (dx,dy) pairs that map to valid actions.\n        # Using a fixed list of (dx, dy) and then looking up their actions.\n        move_deltas_ordered = [\n            (0, 1),   # DOWN\n            (0, -1),  # UP\n            (-1, 0),  # LEFT\n            (1, 0)    # RIGHT\n        ]\n\n        for dx, dy in move_deltas_ordered:\n            nx, ny = cx + dx, cy + dy\n            next_pos = (nx, ny)\n\n            # Check bounds and if already visited\n            if not (0 <= nx < grid_width and 0 <= ny < grid_height and next_pos not in visited):\n                continue # Skip invalid or already visited cells\n\n            # Check if the next cell (nx, ny) is walkable\n            # A cell is walkable if it doesn't contain a blocking non-grabbable item.\n            # Also, we cannot walk INTO a cell that *is* the primitive itself (we want to be adjacent).\n            is_walkable = True\n            \n            # Check for blocking non-grabbable items (walls, etc.)\n            for kind_idx in current_state.world.non_grabbable_indices:\n                if current_state.grid[ny, nx, kind_idx] > 0:\n                    # If it contains a non-grabbable item, it's not walkable.\n                    # This assumes the 'primitive' itself is grabbable, hence not in non_grabbable_indices.\n                    is_walkable = False\n                    break # No need to check other non-grabbables for this cell\n\n            # Additional check: if the cell (nx, ny) itself contains the primitive, it's not a path cell.\n            # We must be *adjacent* to the primitive to collect it, not on its square.\n            if current_state.grid[ny, nx, primitive] > 0:\n                is_walkable = False\n\n            if is_walkable:\n                visited.add(next_pos)\n                action_to_take = delta_to_action[(dx, dy)]\n                q.append((next_pos, current_path + [action_to_take]))\n    \n    if path_to_adjacent_cell:\n        # If a path was found, add the USE action (action 4) at the end\n        return path_to_adjacent_cell + [4] \n    else:\n        # No path found within the search limits or grid constraints\n        return []", "island_id": 4, "scores": {"3": -1}}
