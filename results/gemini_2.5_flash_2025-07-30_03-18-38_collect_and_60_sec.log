{"timestamp": "2025-07-31T00:16:43.221616", "function_name": "collect", "function_body": "    actions_list = []\n    \n    # Get current observations from the environment\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    \n    # Extract relevant state information\n    grid = features_dict['features_global']\n    normalized_pos = features_dict['pos']\n    inventory = features_dict['inventory']\n    \n    # Get grid dimensions from the scenario\n    # env is CraftLab, scenario is a public attribute of CraftLab\n    WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape \n    \n    # Convert normalized position (float) to integer grid coordinates (x, y)\n    current_pos = (int(normalized_pos[0] * WIDTH), int(normalized_pos[1] * HEIGHT))\n    \n    # Check if the primitive is already collected\n    if inventory[primitive] > 0:\n        return []\n        \n    # Define actions map from env_factory, as suggested by the problem context\n    ACTIONS = env_factory.ACTIONS \n    \n    # Find the closest instance of the primitive on the grid\n    target_pos = None\n    min_dist = float('inf')\n    \n    # Iterate through the grid to find the primitive's location\n    # Assuming grid[x, y, kind] == 1 means the item of 'kind' is at (x, y)\n    for y in range(HEIGHT):\n        for x in range(WIDTH):\n            if grid[x, y, primitive] == 1:\n                # Calculate Manhattan distance to find the closest instance\n                dist = abs(x - current_pos[0]) + abs(y - current_pos[1])\n                if dist < min_dist:\n                    min_dist = dist\n                    target_pos = (x, y)\n    \n    # If the primitive is not found on the grid, it cannot be collected\n    if target_pos is None:\n        return []\n        \n    # Generate a sequence of movement actions to reach the target position\n    cx, cy = current_pos\n    tx, ty = target_pos\n    \n    # First, move horizontally to align x-coordinate\n    while cx != tx:\n        if cx < tx:\n            actions_list.append(ACTIONS['RIGHT'])\n            cx += 1\n        else: # cx > tx\n            actions_list.append(ACTIONS['LEFT'])\n            cx -= 1\n            \n    # Then, move vertically to align y-coordinate\n    while cy != ty:\n        if cy < ty:\n            actions_list.append(ACTIONS['DOWN'])\n            cy += 1\n        else: # cy > ty\n            actions_list.append(ACTIONS['UP'])\n            cy -= 1\n            \n    # Once at the target position (the same cell as the primitive), \n    # perform the USE action to collect the primitive. This assumes 'USE'\n    # on the same tile as the agent collects the item.\n    actions_list.append(ACTIONS['USE'])\n    \n    return actions_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:16:44.190126", "function_name": "collect", "function_body": "  import collections\n  \n  current_state = env._current_state\n\n  # Check if the primitive is already in the inventory\n  if current_state.inventory[primitive] > 0:\n    return [] # Already collected\n\n  action_map = env.action_specs()\n  # Define actions that can change the agent's position or direction\n  # Assuming UP/DOWN move, LEFT/RIGHT turn.\n  ALL_POSSIBLE_ACTIONS = [action_map['DOWN'], action_map['UP'], action_map['LEFT'], action_map['RIGHT']]\n  USE_ACTION = action_map['USE']\n\n  # Directions deltas for calculating the cell the agent is facing\n  # Assuming 0: North (-1, 0), 1: East (0, 1), 2: South (1, 0), 3: West (0, -1)\n  _DELTAS = {0: (-1, 0), 1: (0, 1), 2: (1, 0), 3: (0, -1)}\n\n  # BFS Queue: stores (current_state_object, list_of_actions_to_reach_this_state)\n  q = collections.deque([(current_state, [])])\n  # Visited set: stores (position_tuple, direction_int) to avoid cycles and redundant exploration\n  visited = set([(current_state.pos, current_state.dir)])\n\n  # Maximum number of actions to explore to prevent infinite loops for unreachable goals\n  # This acts as a safety break; BFS naturally finds shortest path first.\n  MAX_SEARCH_DEPTH = 500 \n\n  while q:\n    state, actions_so_far = q.popleft()\n\n    # If path is too long, stop exploring this branch\n    if len(actions_so_far) > MAX_SEARCH_DEPTH:\n      continue\n\n    # Calculate the cell the agent is currently facing\n    dr, dc = _DELTAS[state.dir]\n    facing_r = state.pos[0] + dr\n    facing_c = state.pos[1] + dc\n\n    # Get grid dimensions from the current state's grid\n    grid_width, grid_height, _ = state.grid.shape\n\n    # Check if the facing cell is within grid bounds\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n      # Check if the primitive is in the cell the agent is facing\n      # Assuming grid is one-hot encoded for kinds\n      if state.grid[facing_r, facing_c, primitive] == 1:\n        # Found the primitive and are facing it, return actions to reach and use it\n        return actions_so_far + [USE_ACTION]\n\n    # Explore all possible next states by trying each action\n    for action in ALL_POSSIBLE_ACTIONS:\n      # step() returns a new CraftState object, not modifying the original\n      reward, next_s = state.step(action)\n\n      # Check if the new state is actually different (i.e., action was valid and moved/turned)\n      # and if this (pos, dir) combination hasn't been visited yet\n      if (next_s.pos, next_s.dir) not in visited:\n        visited.add((next_s.pos, next_s.dir))\n        q.append((next_s, actions_so_far + [action]))\n      # Note: If next_s is the same as state (e.g., hit a wall), it means no change occurred.\n      # The 'visited' check implicitly handles this as (state.pos, state.dir) would already be visited.\n\n  # If the queue becomes empty and the primitive was not found\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:18:11.180716", "function_name": "collect", "function_body": "    import collections\n\n    current_state = env._current_state\n    grid = current_state.grid\n    start_pos = current_state.pos\n    world = current_state.world\n    non_grabbable_indices = world.non_grabbable_indices\n\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n\n    # Define movements: (dr, dc, action_id)\n    # Action IDs: 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT, 4:USE\n    MOVES = [\n        (-1, 0, 1),  # UP\n        (1, 0, 0),   # DOWN\n        (0, -1, 2),  # LEFT\n        (0, 1, 3)    # RIGHT\n    ]\n    USE_ACTION = 4\n\n    queue = collections.deque([(start_pos, [])])  # (position, path_actions)\n    visited = {start_pos}\n\n    while queue:\n        (r, c), path = queue.popleft()\n\n        # Check if the current position (r, c) allows using the primitive.\n        # This is true if the primitive is in the 3x3 neighborhood around (r, c),\n        # including (r, c) itself, matching CraftState.next_to logic.\n        can_use_primitive = False\n        for dr_check in [-1, 0, 1]:\n            for dc_check in [-1, 0, 1]:\n                nr_check, nc_check = r + dr_check, c + dc_check\n                if 0 <= nr_check < WIDTH and 0 <= nc_check < HEIGHT:\n                    # Check if the cell contains the primitive\n                    if grid[nr_check, nc_check, primitive] > 0:\n                        can_use_primitive = True\n                        break\n            if can_use_primitive:\n                break\n        \n        if can_use_primitive:\n            return path + [USE_ACTION] # Found a position from which primitive can be used\n\n        # Explore neighbors for pathfinding\n        for dr, dc, action in MOVES:\n            nr, nc = r + dr, c + dc\n            next_pos = (nr, nc)\n\n            # Check bounds\n            if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n                continue\n\n            # Check traversability: the next cell must not contain any non-grabbable item\n            is_traversable = True\n            for non_grabbable_idx in non_grabbable_indices:\n                if grid[nr, nc, non_grabbable_idx] > 0:\n                    is_traversable = False\n                    break\n            \n            if not is_traversable:\n                continue\n\n            # If the next position has not been visited, add it to the queue\n            if next_pos not in visited:\n                visited.add(next_pos)\n                queue.append((next_pos, path + [action]))\n\n    return [] # No path found to the primitive", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:18:11.260904", "function_name": "collect", "function_body": "    import numpy as np\n\n    # Action mappings, defined inside the function scope to ensure self-containment\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Max steps to attempt collection to prevent infinite loops\n    MAX_COLLECT_STEPS = 500\n\n    # Helper function to find coordinates of a kind on the grid\n    # This helper is defined locally within collect_v2\n    def _find_kind_on_grid(grid, kind_idx):\n        # `grid` is assumed to be of shape (WIDTH, HEIGHT, n_kinds)\n        # `np.argwhere` on `kind_layer` (2D slice) returns (row, col) which corresponds to (x, y)\n        kind_layer = grid[:, :, kind_idx]\n        coords = np.argwhere(kind_layer > 0) # Returns (N, 2) array of (x_coord, y_coord)\n        if coords.size > 0:\n            return tuple(coords[0]) # Return the first found coordinate (x, y)\n        return None\n\n    actions_taken = []\n    \n    for step_count in range(MAX_COLLECT_STEPS):\n        # Always get fresh observations and the current CraftState instance\n        # `env.step()` updates `env._current_state`, so we can access it directly for its methods.\n        craft_state = env._current_state\n        obs = env.observations()\n        \n        current_inventory = obs['features_dict']['inventory']\n        current_pos = tuple(obs['features_dict']['pos']) \n        current_grid = obs['features_dict']['features_global'] \n\n        # 1. Check if the primitive is already in the inventory\n        if current_inventory[primitive] > 0:\n            return actions_taken\n\n        # 2. Check if the primitive is in the agent's 3x3 neighborhood (including the agent's cell)\n        if craft_state.next_to(primitive):\n            # Attempt to USE the item to collect it\n            _, _, _ = env.step(ACTION_USE) \n            actions_taken.append(ACTION_USE)\n            continue # Continue loop to re-check inventory (and potentially exit if collected)\n\n        # 3. If not collected and not in the immediate vicinity, find its position on the global grid\n        primitive_pos = _find_kind_on_grid(current_grid, primitive)\n\n        if primitive_pos is None:\n            # The primitive is not found anywhere on the map, implying it's not present or accessible.\n            return actions_taken # Indicate failure to collect\n\n        # Calculate the displacement vector from current position to the primitive's position\n        dx = primitive_pos[0] - current_pos[0]\n        dy = primitive_pos[1] - current_pos[1]\n\n        # If the agent is at the exact same location as the primitive, but it hasn't been collected,\n        # it implies it's uncollectible this way (e.g., USE failed, or it's a non-grabbable item).\n        # In a well-defined \"primitive\" collection task, this should ideally not be reached.\n        if dx == 0 and dy == 0:\n            break # Break loop, as agent is stuck on the target without collection\n\n        action_to_take = None\n        \n        # Determine the primary direction to move based on the larger absolute displacement\n        if abs(dx) > abs(dy): # Prioritize horizontal movement\n            action_to_take = ACTION_RIGHT if dx > 0 else ACTION_LEFT\n        else: # Prioritize vertical movement (or if displacements are equal)\n            action_to_take = ACTION_DOWN if dy > 0 else ACTION_UP\n        \n        # Attempt to move in the chosen primary direction\n        original_pos_before_move = tuple(env.observations()['features_dict']['pos']) # Get position before move\n        _, _, _ = env.step(action_to_take)\n        actions_taken.append(action_to_take)\n        new_pos_after_move = tuple(env.observations()['features_dict']['pos'])\n        \n        # If the primary move was blocked (position did not change), try a perpendicular alternative\n        if new_pos_after_move == original_pos_before_move:\n            actions_taken.pop() # Remove the blocked action from the list\n            alternative_action = None\n\n            if abs(dx) > abs(dy): # Was trying horizontal, now try vertical if vertical displacement exists\n                if dy > 0:\n                    alternative_action = ACTION_DOWN\n                elif dy < 0:\n                    alternative_action = ACTION_UP\n            else: # Was trying vertical, now try horizontal if horizontal displacement exists\n                if dx > 0:\n                    alternative_action = ACTION_RIGHT\n                elif dx < 0:\n                    alternative_action = ACTION_LEFT\n            \n            if alternative_action is not None:\n                # Attempt the alternative (perpendicular) move\n                original_pos_re_check = tuple(env.observations()['features_dict']['pos']) # Get position before alternative move\n                _, _, _ = env.step(alternative_action)\n                actions_taken.append(alternative_action)\n                new_pos_after_alternative_move = tuple(env.observations()['features_dict']['pos'])\n                \n                if new_pos_after_alternative_move == original_pos_re_check:\n                    actions_taken.pop() # Remove the blocked alternative action\n                    break # Both primary and alternative moves blocked, agent is stuck or path is truly impassable\n            else:\n                # No useful alternative move to get closer to target from this position.\n                # This can happen if, for example, dx or dy is 0 and the primary path is blocked.\n                break # Agent is stuck\n        \n    return actions_taken", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:18:39.061835", "function_name": "collect", "function_body": "  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  actions_to_take = []\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario (CraftLab has a scenario attribute)\n  WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # If the agent is already on the primitive, just use it.\n  if current_grid[current_px, current_py, primitive] == 1:\n      return [_USE]\n\n  # Find all locations where the primitive exists on the grid.\n  # This list isn't strictly necessary for BFS, but can be used for debugging\n  # or specific optimizations (e.g., if we want to target a specific instance).\n  # BFS will find the closest one naturally.\n  # primitive_locations = []\n  # for x in range(WIDTH):\n  #   for y in range(HEIGHT):\n  #     if current_grid[x, y, primitive] == 1:\n  #       primitive_locations.append((x, y))\n\n  # Use Breadth-First Search (BFS) to find the shortest path to any primitive location.\n  # Queue stores tuples: ((current_x, current_y), [path_actions_to_reach_here])\n  import collections # This import should ideally be at the module level\n  q = collections.deque()\n  q.append((current_pos, [])) \n  \n  # Set to store visited positions to avoid cycles and re-processing longer paths\n  visited = {current_pos} \n\n  # Define possible movements and their corresponding actions\n  # (dx, dy): action\n  moves = {\n      (0, -1): _UP,\n      (0, 1): _DOWN,\n      (-1, 0): _LEFT,\n      (1, 0): _RIGHT\n  }\n\n  # Obstacle check function: A cell is considered an obstacle if it contains\n  # any non-grabbable item. The target primitive itself is grabbable,\n  # so it will not be in `non_grabbable_indices`.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle).\"\"\"\n    for k in non_grabbable_items_set:\n      if grid[x, y, k] == 1:\n        return True\n    return False\n\n  target_found_path = None\n\n  while q:\n    (cx, cy), current_path = q.popleft()\n\n    # If the current position contains the primitive, we found a path.\n    # Since it's BFS, this is guaranteed to be the shortest path to *a* primitive.\n    if current_grid[cx, cy, primitive] == 1:\n      target_found_path = current_path\n      break # Exit BFS as the shortest path is found\n\n    # Explore neighbors\n    for (dx, dy), action in moves.items():\n      nx, ny = cx + dx, cy + dy\n\n      # Check boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if already visited\n      if (nx, ny) in visited:\n        continue\n\n      # Check if the neighbor cell is an obstacle (non-grabbable item)\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n\n      # If the neighbor is valid and not an obstacle, add it to the queue\n      new_path = current_path + [action]\n      q.append(((nx, ny), new_path))\n      visited.add((nx, ny))\n  \n  # If a path was found, append the USE action and return it\n  if target_found_path is not None:\n    actions_to_take = target_found_path + [_USE]\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:18:40.040073", "function_name": "collect", "function_body": "  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  actions_to_take = []\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  current_pos = (current_px, current_py)\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # If the agent is already on the primitive, just use it.\n  if current_grid[current_px, current_py, primitive] == 1:\n      return [_USE]\n\n  # Check if any instance of the primitive exists on the grid at all.\n  # This serves as a quick exit if the primitive isn't present in the world.\n  primitive_exists_on_grid = False\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      if current_grid[x, y, primitive] == 1:\n        primitive_exists_on_grid = True\n        break\n    if primitive_exists_on_grid:\n        break\n\n  if not primitive_exists_on_grid:\n    return []\n\n  # Use Breadth-First Search (BFS) to find the shortest *navigable* path to any primitive location\n  # Queue stores tuples: ((current_x, current_y), [path_actions_to_reach_here])\n  # 'collections' is assumed to be imported at the module level.\n  q = collections.deque() \n  q.append((current_pos, [])) \n  \n  # Set to store visited positions to avoid cycles and re-processing longer paths\n  visited = {current_pos} \n\n  # Define possible movements and their corresponding actions\n  # (dx, dy): action mapping\n  moves = {\n      (0, -1): _UP,\n      (0, 1): _DOWN,\n      (-1, 0): _LEFT,\n      (1, 0): _RIGHT\n  }\n\n  # Obstacle check function: A cell is considered an obstacle if it contains\n  # any non-grabbable item that the agent cannot pass through.\n  # The target primitive itself is grabbable, so it will not be in `non_grabbable_indices`.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item (obstacle).\"\"\"\n    for k in non_grabbable_items_set:\n      if grid[x, y, k] == 1:\n        return True\n    return False\n\n  target_found_path = None\n\n  while q:\n    (cx, cy), current_path = q.popleft()\n\n    # If the current position contains the primitive, we found a path.\n    # Since it's BFS, this path is guaranteed to be the shortest path to *a* primitive.\n    if current_grid[cx, cy, primitive] == 1:\n      target_found_path = current_path\n      break # Exit BFS as the shortest path is found\n\n    # Explore neighbors\n    for (dx, dy), action in moves.items():\n      nx, ny = cx + dx, cy + dy\n\n      # Check boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if already visited\n      if (nx, ny) in visited:\n        continue\n\n      # Check if the neighbor cell is an obstacle\n      # Agent cannot move into cells with non-grabbable items.\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n\n      # If the neighbor is valid and not an obstacle, add it to the queue\n      new_path = current_path + [action]\n      q.append(((nx, ny), new_path))\n      visited.add((nx, ny))\n  \n  # If a path was found, append the USE action and return it\n  if target_found_path is not None:\n    actions_to_take = target_found_path + [_USE]\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:19:47.558506", "function_name": "collect", "function_body": "    import collections\n    \n    # Define action constants based on CraftLab.action_specs\n    # These are internal to the function as they are not globally defined in the problem description.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n    ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n    # Reset the environment to its initial state to start planning from a consistent point.\n    # The `_` is used to ignore the observation dict returned by reset, as we access the state directly.\n    _ = env.reset()\n    \n    # Access the internal CraftState object from the CraftLab environment.\n    # This CraftState object allows simulation of steps without modifying the actual environment.\n    initial_state = env._current_state \n\n    # Define a helper function to check if the goal (primitive in inventory) is satisfied.\n    def is_goal_satisfied(state, target_primitive_idx):\n        return state.inventory[target_primitive_idx] > 0\n\n    # Initialize the Breadth-First Search (BFS) queue.\n    # Each element in the queue is a tuple: (current_CraftState_object, list_of_actions_taken_to_reach_this_state).\n    queue = collections.deque([(initial_state, [])])\n\n    # Initialize a set to keep track of visited states to prevent cycles and redundant exploration.\n    # State representation for `visited` set needs to be hashable.\n    # We use a tuple of (grid.tobytes(), pos_tuple, direction_int, inventory.tobytes()).\n    # numpy arrays (`grid`, `inventory`) are converted to bytes for hashing.\n    visited = set()\n    initial_state_repr = (\n        initial_state.grid.tobytes(),\n        initial_state.pos,\n        initial_state.dir,\n        initial_state.inventory.tobytes()\n    )\n    visited.add(initial_state_repr)\n\n    # Perform BFS\n    while queue:\n        current_state, path_actions = queue.popleft()\n\n        # Check if the current state satisfies the goal condition.\n        if is_goal_satisfied(current_state, primitive):\n            return path_actions  # Goal reached, return the sequence of actions.\n\n        # Explore all possible actions from the current state.\n        for action in ACTIONS:\n            # Simulate the action to get the next state.\n            # CraftState.step returns (reward, new_state); reward is always 0.0 in this problem.\n            _reward, next_state = current_state.step(action)\n\n            # Create a hashable representation of the next state.\n            next_state_repr = (\n                next_state.grid.tobytes(),\n                next_state.pos,\n                next_state.dir,\n                next_state.inventory.tobytes()\n            )\n\n            # If this next state has not been visited before, add it to the queue.\n            if next_state_repr not in visited:\n                visited.add(next_state_repr)\n                # Append the new state and the extended action path to the queue.\n                queue.append((next_state, path_actions + [action]))\n\n    # If the queue becomes empty and the goal was not reached, it means no path exists\n    # to collect the primitive from the initial state within the explored space.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:19:47.632129", "function_name": "collect", "function_body": "    import collections # This import is needed but should be at the top of the file, assuming it exists.\n    import numpy as np # This import is needed but should be at the top of the file, assuming it exists.\n\n    # Action constants (assuming these are defined globally in the module)\n    # DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    actions_list = []\n\n    # Get the current state from the CraftLab environment\n    # CraftLab exposes _current_state as a data attribute\n    state = env._current_state \n\n    # 1. Check if the primitive is already in inventory\n    if state.inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # Get grid dimensions and current position\n    grid = state.grid\n    grid_width, grid_height, _ = grid.shape # grid (cols, rows, kinds)\n    current_pos = state.pos # (col, row)\n    \n    # 2. Find the primitive on the grid\n    # np.argwhere returns (col_idx, row_idx) since grid is (cols, rows, kinds)\n    primitive_coords = np.argwhere(grid[:, :, primitive] == 1)\n\n    if not primitive_coords.size:\n        # Primitive not found on the grid\n        return []\n\n    # For simplicity, pick the first found instance of the primitive\n    target_primitive_pos = tuple(primitive_coords[0]) # (target_col, target_row)\n\n    # 3. Determine if the primitive is grabbable or requires 'USE' action\n    is_grabbable = primitive in env.world.grabbable_indices\n\n    # Define the target cells for pathfinding\n    # If grabbable, agent needs to move onto the item's cell\n    # If non-grabbable (requires USE), agent needs to move next to the item's cell\n    target_cells = []\n    if is_grabbable:\n        target_cells.append(target_primitive_pos)\n    else:\n        # Check all 4 neighboring cells\n        px, py = target_primitive_pos\n        for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]: # (delta_col, delta_row)\n            nx, ny = px + dx, py + dy\n            # Ensure neighbor is within grid bounds\n            if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                target_cells.append((nx, ny))\n    \n    # If there are no valid target cells (e.g., primitive on edge and only surrounded by walls)\n    if not target_cells:\n        return []\n\n    # 4. Pathfinding using BFS\n    # Queue stores (current_pos, list_of_actions_to_reach_here)\n    queue = collections.deque([(current_pos, [])])\n    visited = {current_pos}\n    \n    # Map (delta_col, delta_row) to movement action\n    # (0, 1) means row increases (down), (0, -1) means row decreases (up)\n    # (1, 0) means col increases (right), (-1, 0) means col decreases (left)\n    move_action_map = {\n        (0, 1): DOWN,\n        (0, -1): UP,\n        (1, 0): RIGHT,\n        (-1, 0): LEFT\n    }\n\n    path_found = False\n    final_reachable_pos = None # The cell the agent will end up on before potentially using\n    \n    while queue and not path_found:\n        (cx, cy), current_path = queue.popleft()\n\n        for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]: # Possible moves (delta_col, delta_row)\n            nx, ny = cx + dx, cy + dy\n\n            if 0 <= nx < grid_width and 0 <= ny < grid_height and (nx, ny) not in visited:\n                new_path = current_path + [move_action_map[(dx, dy)]]\n                if (nx, ny) in target_cells:\n                    actions_list.extend(new_path)\n                    final_reachable_pos = (nx, ny)\n                    path_found = True\n                    break # Found the shortest path to a target cell\n                \n                visited.add((nx, ny))\n                queue.append(((nx, ny), new_path))\n    \n    if not path_found:\n        # Primitive is unreachable\n        return []\n\n    # 5. Handle 'USE' action for non-grabbable items\n    if not is_grabbable:\n        # Simulate agent's final position and direction after path movements\n        sim_pos = state.pos\n        sim_dir = state.dir # Initial direction of the agent\n\n        # Function to simulate a single movement action\n        # Assumes agent's direction updates to face the direction of movement\n        def simulate_move_and_dir(pos, current_dir_val, action):\n            cx, cy = pos\n            if action == UP:    return (cx, cy - 1), 0 # N (dir 0)\n            if action == DOWN:  return (cx, cy + 1), 2 # S (dir 2)\n            if action == LEFT:  return (cx - 1, cy), 3 # W (dir 3)\n            if action == RIGHT: return (cx + 1, cy), 1 # E (dir 1)\n            return pos, current_dir_val # For non-movement actions or if not recognized\n        \n        for action in actions_list:\n            # Only simulate movement actions; USE is added after all moves\n            if action in [UP, DOWN, LEFT, RIGHT]:\n                sim_pos, sim_dir = simulate_move_and_dir(sim_pos, sim_dir, action)\n            # No need to clamp sim_pos, BFS ensures it's within bounds\n\n        # Determine the desired direction to face the primitive from final_reachable_pos\n        # (delta_col, delta_row) from agent's final position to the primitive's position\n        delta_col = target_primitive_pos[0] - sim_pos[0]\n        delta_row = target_primitive_pos[1] - sim_pos[1]\n\n        # Map (delta_col, delta_row) to the integer direction value the agent needs to face\n        # Assuming 0:North, 1:East, 2:South, 3:West for agent.dir\n        desired_dir_mapping = {\n            (0, -1): 0, # Target is North (row smaller)\n            (1, 0): 1,  # Target is East (col larger)\n            (0, 1): 2,  # Target is South (row larger)\n            (-1, 0): 3  # Target is West (col smaller)\n        }\n        \n        desired_dir = desired_dir_mapping.get((delta_col, delta_row))\n\n        if desired_dir is not None and sim_dir != desired_dir:\n            # Calculate minimal turns needed\n            diff = (desired_dir - sim_dir + 4) % 4\n            if diff == 1: # 90 degrees clockwise\n                actions_list.append(RIGHT)\n            elif diff == 2: # 180 degrees\n                actions_list.extend([RIGHT, RIGHT]) # Or [LEFT, LEFT] for 180 turn\n            elif diff == 3: # 90 degrees counter-clockwise\n                actions_list.append(LEFT)\n            \n        actions_list.append(USE)\n\n    return actions_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:21:30.516265", "function_name": "collect", "function_body": "    actions = env.action_specs()\n    ACTION_UP = actions['UP']\n    ACTION_DOWN = actions['DOWN']\n    ACTION_LEFT = actions['LEFT']\n    ACTION_RIGHT = actions['RIGHT']\n    ACTION_USE = actions['USE']\n\n    # Movement deltas corresponding to actions and resulting new directions.\n    # Assuming actions move the agent and set its direction to match the movement.\n    # Direction mapping: 0:North/Up, 1:East/Right, 2:South/Down, 3:West/Left\n    # DIR_DELTAS[0] = (-1, 0) (for UP/North)\n    # DIR_DELTAS[1] = (0, 1)  (for RIGHT/East)\n    # DIR_DELTAS[2] = (1, 0)  (for DOWN/South)\n    # DIR_DELTAS[3] = (0, -1) (for LEFT/West)\n    \n    # Define directional deltas for agent facing.\n    DIR_DELTAS = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n\n    # Map movement actions to (delta_row, delta_col) and the resulting new direction index.\n    MOVE_ACTION_MAP = {\n        ACTION_UP: ((-1, 0), 0),   # (dr, dc), new_dir (North)\n        ACTION_RIGHT: ((0, 1), 1),  # (dr, dc), new_dir (East)\n        ACTION_DOWN: ((1, 0), 2),   # (dr, dc), new_dir (South)\n        ACTION_LEFT: ((0, -1), 3),  # (dr, dc), new_dir (West)\n    }\n\n    # Get current state information from the environment.\n    initial_state = env._current_state\n    grid = initial_state.grid\n    start_pos = initial_state.pos\n    start_dir = initial_state.dir  # Default 0 (North/Up)\n    inventory = initial_state.inventory\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # Check if the primitive is already in the agent's inventory.\n    if inventory[primitive] > 0:\n        return []\n\n    # Get indices of entities that block movement (e.g., walls, water).\n    # These are typically \"environment\" items as defined in the Cookbook.\n    blocking_kinds = initial_state.world.cookbook.environment\n\n    # BFS state: (current_row, current_col, current_direction, path_taken_actions)\n    # Initialize queue with the starting state.\n    q = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n    # Keep track of visited states to prevent loops and redundant exploration.\n    visited = {(start_pos[0], start_pos[1], start_dir)}\n\n    while q:\n        r, c, d, path = q.popleft()\n\n        # Check if the primitive is at the cell directly in front of the agent.\n        dr_facing, dc_facing = DIR_DELTAS[d]\n        target_r, target_c = r + dr_facing, c + dc_facing\n\n        # Check if the target cell is within grid bounds.\n        if 0 <= target_r < WIDTH and 0 <= target_c < HEIGHT:\n            # If the primitive is found at the target cell, we can collect it.\n            if grid[target_r, target_c, primitive] == 1:\n                # Add the USE action to the current path and return.\n                return path + [ACTION_USE]\n\n        # Explore possible movement actions from the current state.\n        for action_val, ((dr_move, dc_move), new_dir) in MOVE_ACTION_MAP.items():\n            new_r, new_c = r + dr_move, c + dc_move\n\n            # Check if the new position is within grid bounds.\n            if not (0 <= new_r < WIDTH and 0 <= new_c < HEIGHT):\n                continue\n\n            # Check if the new position is blocked by an impassable object.\n            is_blocked = False\n            for kind_idx in blocking_kinds:\n                if grid[new_r, new_c, kind_idx] == 1:\n                    is_blocked = True\n                    break\n            if is_blocked:\n                continue\n\n            # Construct the new state tuple (position and direction).\n            new_state_tuple = (new_r, new_c, new_dir)\n\n            # If this new state has not been visited, add it to the queue.\n            if new_state_tuple not in visited:\n                visited.add(new_state_tuple)\n                q.append((new_r, new_c, new_dir, path + [action_val]))\n    \n    # If the BFS queue becomes empty and no path to collect the primitive was found,\n    # it means the primitive is unreachable from the current state.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:21:30.584579", "function_name": "collect", "function_body": "    if not hasattr(env, '_current_state') or env._current_state is None:\n        # If env is not properly initialized or _current_state is not accessible.\n        # This implies an inability to perform grid-based pathfinding without egocentric mapping.\n        # For this completion, we assume _current_state is available for direct access to grid and agent state.\n        return []\n\n    current_state = env._current_state\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir\n    initial_inventory = current_state.inventory\n\n    # Check if the primitive is already in the inventory\n    if initial_inventory[primitive] > 0:\n        return []  # Already collected, no actions needed\n\n    initial_grid = current_state.grid\n    width, height, _ = initial_grid.shape\n\n    # Get action mappings dynamically from the environment\n    action_map = env.action_specs()\n    ACT_DOWN = action_map['down']\n    ACT_UP = action_map['up']\n    ACT_LEFT = action_map['left']\n    ACT_RIGHT = action_map['right']\n    ACT_USE = action_map['use']\n\n    # Define movement deltas (dx, dy) for each action\n    # (dx, dy) where x is horizontal (column), y is vertical (row)\n    _ACTION_DELTAS_XY = {\n        ACT_DOWN: (0, 1),   # Move +1 in y (down)\n        ACT_UP: (0, -1),    # Move -1 in y (up)\n        ACT_LEFT: (-1, 0),  # Move -1 in x (left)\n        ACT_RIGHT: (1, 0),  # Move +1 in x (right)\n    }\n\n    # Define how agent's `dir` (facing direction) updates after movement.\n    # Assuming `dir` updates to match the last movement direction.\n    # Common convention: 0: East (Right), 1: South (Down), 2: West (Left), 3: North (Up)\n    DIR_RIGHT = 0\n    DIR_DOWN = 1\n    DIR_LEFT = 2\n    DIR_UP = 3\n\n    _ACTION_TO_DIR = {\n        ACT_RIGHT: DIR_RIGHT,\n        ACT_DOWN: DIR_DOWN,\n        ACT_LEFT: DIR_LEFT,\n        ACT_UP: DIR_UP,\n    }\n\n    # Mapping from relative (dx, dy) vector (from agent to target) to the required facing direction constant\n    _FACE_MAPPING = {\n        (1, 0): DIR_RIGHT,\n        (-1, 0): DIR_LEFT,\n        (0, 1): DIR_DOWN,\n        (0, -1): DIR_UP,\n    }\n\n    # Find all locations of the primitive on the grid\n    target_locations = []\n    for x in range(width):\n        for y in range(height):\n            if initial_grid[x, y, primitive] > 0:\n                target_locations.append((x, y))\n\n    if not target_locations:\n        # Primitive not found anywhere on the initial grid\n        return []\n\n    # Generate all possible \"pre-USE\" states (agent_x, agent_y, agent_facing_direction)\n    # A pre-USE state is where the agent can perform ACT_USE to collect the primitive.\n    pre_use_targets = set()\n    for tx, ty in target_locations:\n        # Check all 4 adjacent cells around the target (tx, ty)\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            px, py = tx + dx, ty + dy  # Candidate agent position (px, py)\n\n            # Ensure agent position is within grid boundaries\n            if not (0 <= px < width and 0 <= py < height):\n                continue\n\n            # Determine the direction the agent must face to interact with (tx, ty)\n            # This is the vector from agent's position (px, py) to target's position (tx, ty)\n            vec_to_target = (tx - px, ty - py)\n\n            if vec_to_target in _FACE_MAPPING:\n                required_dir = _FACE_MAPPING[vec_to_target]\n                pre_use_targets.add((px, py, required_dir))\n\n    if not pre_use_targets:\n        # This could happen if targets are at grid edges with no valid adjacent spots inside.\n        return []\n\n    # BFS for pathfinding\n    # State in queue: ((current_x, current_y), current_direction, list_of_actions_taken)\n    queue = collections.deque([((initial_pos[0], initial_pos[1]), initial_dir, [])])\n\n    # Visited set: (x, y, direction) to avoid cycles and redundant exploration\n    visited = set([(initial_pos[0], initial_pos[1], initial_dir)])\n\n    while queue:\n        (curr_x, curr_y), curr_dir, path = queue.popleft()\n\n        # Check if the current state is one of the desired \"pre-USE\" states\n        if (curr_x, curr_y, curr_dir) in pre_use_targets:\n            # If so, we've found a path to be next to and facing the primitive.\n            # Append the USE action and return the full action sequence.\n            return path + [ACT_USE]\n\n        # Explore possible next states by applying movement actions\n        for action, (dx, dy) in _ACTION_DELTAS_XY.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n\n            # Check if the next position is within grid boundaries\n            if not (0 <= next_x < width and 0 <= next_y < height):\n                continue\n\n            # Check for impassable terrain (e.g., water).\n            # env.world provides access to scenario details like water_index.\n            water_index = env.world.water_index if hasattr(env, 'world') and hasattr(env.world, 'water_index') else -1\n            if water_index != -1 and initial_grid[next_x, next_y, water_index] > 0:\n                continue  # Cannot move into water\n\n            # The agent's facing direction typically updates to the direction of movement\n            next_dir = _ACTION_TO_DIR.get(action, curr_dir)\n\n            next_state_key = (next_x, next_y, next_dir)\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                queue.append(((next_x, next_y), next_dir, path + [action]))\n\n    # If the queue becomes empty and no path to a pre-USE target was found\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:22:47.550745", "function_name": "collect", "function_body": "  import collections\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Define internal direction indices based on the order expected for agent's direction:\n  # Assuming 0: Down (South), 1: Up (North), 2: Left (West), 3: Right (East)\n  # This mapping is derived from how `features_dict['direction']` one-hot array works\n  # and how movement actions typically affect facing.\n  _DIR_DOWN = 0\n  _DIR_UP = 1\n  _DIR_LEFT = 2\n  _DIR_RIGHT = 3\n\n  # Mapping from a movement action_id to the resulting agent facing direction.\n  # Taking action _UP makes the agent face _DIR_UP.\n  action_to_new_dir = {\n      _UP: _DIR_UP,\n      _DOWN: _DIR_DOWN,\n      _LEFT: _DIR_LEFT,\n      _RIGHT: _DIR_RIGHT,\n  }\n\n  # Mapping from internal direction integer to (dx, dy) for the cell *moved into* by that direction,\n  # AND for the cell *in front* of the agent when facing that direction.\n  # (0,0) is top-left. positive X is right, positive Y is down.\n  dir_to_delta = {\n      _DIR_DOWN: (0, 1),   # Agent moves/faces Down: Y increases by 1\n      _DIR_UP: (0, -1),    # Agent moves/faces Up: Y decreases by 1\n      _DIR_LEFT: (-1, 0),  # Agent moves/faces Left: X decreases by 1\n      _DIR_RIGHT: (1, 0),  # Agent moves/faces Right: X increases by 1\n  }\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario (or current grid shape)\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n\n  # Convert one-hot initial direction from features_dict to an integer index\n  initial_dir_idx = np.argmax(features_dict['direction'])\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Identify non-grabbable items that act as obstacles (cannot be moved into).\n  # Assuming any non-grabbable item (as defined by `env.world.non_grabbable_indices`)\n  # acts as an obstacle that blocks movement. If specific items like 'water' or 'workshop'\n  # are non-grabbable but traversable, this logic would need refinement based on\n  # additional information about traversable non-grabbable entities.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item that blocks movement.\"\"\"\n    # Optimization: if set is empty, no obstacles can exist.\n    if not non_grabbable_items_set:\n        return False\n    # Check if the cell contains *any* non-grabbable item that is an obstacle\n    for k_idx in non_grabbable_items_set:\n      if grid[x, y, k_idx] == 1:\n        return True\n    return False\n\n  # Use Breadth-First Search (BFS) to find the shortest path.\n  # Queue stores tuples: (current_x, current_y, current_direction_idx, [path_actions_to_reach_here])\n  q = collections.deque()\n  q.append((current_px, current_py, initial_dir_idx, []))\n  \n  # Set to store visited states to avoid cycles and re-processing longer paths.\n  # A state is defined by (x, y, direction_idx).\n  visited = {(current_px, current_py, initial_dir_idx)}\n\n  while q:\n    cx, cy, c_dir_idx, c_path = q.popleft()\n\n    # --- Goal Check 1: Primitive on the agent's current square ---\n    # In some CraftWorld setups, grabbable items on the same square as the agent\n    # can be collected directly with _USE, regardless of facing direction.\n    if current_grid[cx, cy, primitive] == 1:\n      return c_path + [_USE]\n\n    # --- Goal Check 2: Primitive in front of the agent (directional _USE) ---\n    # Calculate the coordinates of the cell directly in front of the agent.\n    facing_dx, facing_dy = dir_to_delta[c_dir_idx]\n    fx, fy = cx + facing_dx, cy + facing_dy\n\n    # Check boundaries for the cell in front\n    if (0 <= fx < WIDTH and 0 <= fy < HEIGHT):\n        # If the cell in front contains the primitive\n        if current_grid[fx, fy, primitive] == 1:\n            return c_path + [_USE] # Found a solution: path to position, then _USE.\n\n    # --- Explore Movement Actions (UP, DOWN, LEFT, RIGHT) ---\n    # Each movement action updates both position and facing direction.\n    for action_id, new_dir_idx in action_to_new_dir.items():\n      # Calculate new position: the agent moves one step in the direction implied by the action.\n      # The `dir_to_delta` mapping tells us the (dx, dy) for moving in a given direction.\n      move_dx, move_dy = dir_to_delta[new_dir_idx] # new_dir_idx is the direction after the move\n      nx, ny = cx + move_dx, cy + move_dy\n\n      # Check validity: within bounds, not an obstacle, and not previously visited state\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n      \n      # If this new state (position and direction) has not been visited\n      if (nx, ny, new_dir_idx) not in visited:\n        new_path = c_path + [action_id]\n        q.append((nx, ny, new_dir_idx, new_path))\n        visited.add((nx, ny, new_dir_idx))\n  \n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:22:48.513868", "function_name": "collect", "function_body": "  import collections\n  # numpy is implicitly available from top-level imports and used as np\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions\n  WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape\n\n  # Denormalize current agent position to get starting coordinates\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n  start_pos = (current_px, current_py)\n\n  # Check if the primitive is grabbable. If not, it cannot be collected via this method.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Identify non-grabbable items that act as obstacles (cannot be moved into)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item that blocks movement.\"\"\"\n    # Optimization: if set is empty, no obstacles can exist.\n    if not non_grabbable_items_set:\n        return False\n    # Check if the cell contains *any* non-grabbable item that is an obstacle\n    for k_idx in non_grabbable_items_set:\n      if grid[x, y, k_idx] == 1:\n        return True\n    return False\n\n  # Use Breadth-First Search (BFS) to find the shortest path.\n  # For `collect_v2`, we assume the _USE action for a primitive can collect\n  # it if the primitive is anywhere in the 3x3 neighborhood (including the agent's current square).\n  # This makes the agent's facing direction irrelevant for the `_USE` action's success,\n  # simplifying the BFS state.\n\n  # Queue stores tuples: (current_x, current_y, [path_actions_to_reach_here])\n  q = collections.deque()\n  q.append((start_pos[0], start_pos[1], []))\n  \n  # Set to store visited states to avoid cycles and re-processing longer paths.\n  # A state is defined only by (x, y) as direction is not crucial for collection success.\n  visited = {start_pos}\n\n  # Define possible movement actions and their corresponding (dx, dy) deltas\n  move_options = [\n      (_UP, (0, -1)),    # Action _UP moves agent one square up (y-1)\n      (_DOWN, (0, 1)),   # Action _DOWN moves agent one square down (y+1)\n      (_LEFT, (-1, 0)),  # Action _LEFT moves agent one square left (x-1)\n      (_RIGHT, (1, 0)),  # Action _RIGHT moves agent one square right (x+1)\n  ]\n\n  while q:\n    cx, cy, c_path = q.popleft()\n\n    # Check if the primitive can be collected from the current position (cx, cy)\n    # This involves checking the 3x3 neighborhood around (cx, cy) for the primitive.\n    # The `CraftState.next_to` method implies this range for interaction.\n    for dx_adj in [-1, 0, 1]:\n        for dy_adj in [-1, 0, 1]:\n            target_x, target_y = cx + dx_adj, cy + dy_adj\n\n            # Check bounds for the cell in the neighborhood\n            if not (0 <= target_x < WIDTH and 0 <= target_y < HEIGHT):\n                continue\n            \n            # If the primitive is found in the 3x3 neighborhood, a path is found.\n            if current_grid[target_x, target_y, primitive] == 1:\n                return c_path + [_USE] # Append _USE action and return the path\n\n    # If not collected from current position, explore movement actions to new cells\n    for action_id, (move_dx, move_dy) in move_options:\n      nx, ny = cx + move_dx, cy + move_dy\n\n      # Check validity:\n      # 1. Within grid boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n      # 2. Not already visited in this (x, y) state\n      if (nx, ny) in visited:\n        continue\n      # 3. Not an obstacle\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n\n      # If valid, add the new state to the queue and mark as visited\n      new_path = c_path + [action_id]\n      q.append((nx, ny, new_path))\n      visited.add((nx, ny))\n  \n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:24:25.849417", "function_name": "collect", "function_body": "    import collections\n    from enum import IntEnum\n    import numpy as np\n\n    class Action(IntEnum):\n        DOWN = 0\n        UP = 1\n        LEFT = 2\n        RIGHT = 3\n        USE = 4\n\n    ACTION_DOWN = Action.DOWN\n    ACTION_UP = Action.UP\n    ACTION_LEFT = Action.LEFT\n    ACTION_RIGHT = Action.RIGHT\n    ACTION_USE = Action.USE\n\n    # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n    DIR_EAST = 0\n    DIR_SOUTH = 1\n    DIR_WEST = 2\n    DIR_NORTH = 3\n\n    # Mapping of movement action to the resulting facing direction of the agent\n    ACTION_TO_DIR = {\n        ACTION_UP: DIR_NORTH,\n        ACTION_DOWN: DIR_SOUTH,\n        ACTION_LEFT: DIR_WEST,\n        ACTION_RIGHT: DIR_EAST\n    }\n\n    # Mapping of target's relative coordinates (dy, dx) from the agent to the\n    # required agent facing direction to collect that target via ACTION_USE.\n    RELATIVE_TO_REQUIRED_DIR = {\n        (0, 1): DIR_EAST,   # Target is to the East, agent must face East\n        (1, 0): DIR_SOUTH,  # Target is to the South, agent must face South\n        (0, -1): DIR_WEST,  # Target is to the West, agent must face West\n        (-1, 0): DIR_NORTH  # Target is to the North, agent must face North\n    }\n\n    # Maximum number of actions allowed for collection, including movements and the final USE.\n    MAX_COLLECT_STEPS = 100 \n\n    # Helper function to find a path and orientation for collection using BFS.\n    # This version optimizes by precomputing traversable cells.\n    def _find_path_and_orientation_for_collection_v2(start_pos, start_dir, full_grid, primitive_id, world, max_steps):\n        grid_height, grid_width, _ = full_grid.shape\n        impassable_kinds = world.non_grabbable_indices\n\n        # V2 Improvement: Precompute a boolean grid indicating traversable cells.\n        # A cell is traversable if it does not contain any kind listed as 'impassable'.\n        traversable_cells = np.ones((grid_height, grid_width), dtype=bool)\n        for y in range(grid_height):\n            for x in range(grid_width):\n                for k_idx in impassable_kinds:\n                    if full_grid[y, x, k_idx] > 0:\n                        traversable_cells[y, x] = False\n                        break\n        \n        # Determine if the primitive itself is a kind the agent can stand on\n        # (i.e., not an \"impassable\" type like a wall, water, or workshop).\n        primitive_is_traversable = primitive_id not in impassable_kinds\n\n        # BFS state: (current_y, current_x, current_dir, path_of_actions)\n        q = collections.deque()\n        q.append((start_pos[0], start_pos[1], start_dir, []))\n        \n        # Visited set: (y, x, dir) to avoid revisiting the same state (position + orientation)\n        visited = {(start_pos[0], start_pos[1], start_dir)}\n\n        # Movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n        moves_options = [\n            (-1, 0, ACTION_UP, DIR_NORTH),\n            (1, 0, ACTION_DOWN, DIR_SOUTH),\n            (0, -1, ACTION_LEFT, DIR_WEST),\n            (0, 1, ACTION_RIGHT, DIR_EAST)\n        ]\n\n        while q:\n            curr_y, curr_x, curr_dir, path_actions = q.popleft()\n            \n            # Pruning: If path is already too long (reserving at least 1 step for the final USE action).\n            if len(path_actions) >= max_steps - 1:\n                continue\n\n            # Goal Check 1: Primitive is on the current cell and agent can pick it up directly.\n            # This applies if the primitive itself is a traversable item and is under the agent.\n            if primitive_is_traversable and full_grid[curr_y, curr_x, primitive_id] > 0:\n                return (path_actions, (0, 0)) # Target is at agent's current position, no relative movement needed.\n\n            # Goal Check 2: Primitive is cardinally adjacent AND agent is facing it correctly.\n            for rel_dy, rel_dx in RELATIVE_TO_REQUIRED_DIR.keys(): \n                adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n                # Check if the adjacent cell is within grid boundaries\n                if not (0 <= adj_y < grid_height and 0 <= adj_x < grid_width):\n                    continue\n\n                # Check if the adjacent cell contains the primitive we're looking for\n                if full_grid[adj_y, adj_x, primitive_id] > 0:\n                    required_dir_for_collection = RELATIVE_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n                    # If agent is currently facing the primitive, we found a collection spot.\n                    if curr_dir == required_dir_for_collection:\n                        return (path_actions, (rel_dy, rel_dx)) # Path to reach this spot, and relative target coords.\n\n            # Explore neighboring cells by trying all movement actions\n            for dy_move, dx_move, action_move, new_dir_after_move in moves_options:\n                next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n                # Check bounds for the proposed next cell\n                if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                    continue\n\n                # V2 Improvement: Use the precomputed `traversable_cells` array for faster check.\n                if not traversable_cells[next_y, next_x]:\n                    continue # Cannot move into an impassable cell\n                \n                # Add the new state to the queue if it hasn't been visited before (position and direction)\n                if (next_y, next_x, new_dir_after_move) not in visited:\n                    visited.add((next_y, next_x, new_dir_after_move))\n                    q.append((next_y, next_x, new_dir_after_move, path_actions + [action_move]))\n\n        return (None, None) # No path found to the primitive with correct orientation within max_steps\n\n    actions_taken = []\n    \n    # Reset the environment to get the initial state for planning.\n    current_obs = env.reset() \n    current_state = env._current_state # Access the underlying CraftState instance\n\n    # Initial checks for early exit\n    if primitive not in current_state.world.cookbook.kinds:\n        # The specified primitive ID is not a recognized kind in the world.\n        return [] \n    if current_state.inventory[primitive] > 0:\n        # The primitive has already been collected or is present in inventory.\n        return [] \n\n    full_grid = current_state.features_dict()['features_global']\n    start_pos = current_state.pos\n    start_dir = current_state.dir\n    \n    # Find the sequence of movements and the relative target coordinates for collection.\n    path_of_moves, relative_target_coords = _find_path_and_orientation_for_collection_v2(\n        start_pos, start_dir, full_grid, primitive, current_state.world, MAX_COLLECT_STEPS\n    )\n\n    if path_of_moves is None:\n        # No valid path was found to reach a position/orientation suitable for collection.\n        return [] \n\n    # Execute the found path of movements\n    for action in path_of_moves:\n        actions_taken.append(action)\n        # Step the environment with the current action.\n        # We ignore reward and done status as this function's goal is just to return the action sequence.\n        _, _, _ = env.step(action) \n        current_state = env._current_state # Always update the internal state after a step\n\n    # After executing all movement actions, the agent should be at the correct position\n    # and facing the correct direction as determined by the BFS.\n    # The final step is to use the ACTION_USE to collect the primitive.\n    if len(actions_taken) < MAX_COLLECT_STEPS: # Ensure there's still capacity for the USE action\n        actions_taken.append(ACTION_USE)\n        _, _, _ = env.step(ACTION_USE)\n        current_state = env._current_state # Update state after USE\n\n        # Final verification: Confirm the primitive was successfully collected into inventory.\n        if current_state.inventory[primitive] > 0:\n            return actions_taken # Successfully collected!\n    \n    # If path was too long to include USE, or USE failed (inventory not updated)\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:24:26.864590", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:25:40.588517", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map movement vectors (dx, dy) to action IDs.\n  # These actions move the agent AND set its facing direction.\n  MOVE_VEC_TO_ACTION = {\n      (0, -1): UP,    # Move North (along -Y), requires UP action\n      (0, 1): DOWN,   # Move South (along +Y), requires DOWN action\n      (-1, 0): LEFT,  # Move West (along -X), requires LEFT action\n      (1, 0): RIGHT   # Move East (along +X), requires RIGHT action\n  }\n\n  # Map agent's internal direction ID to its corresponding facing vector (dx, dy).\n  # 0: North (-Y)\n  # 1: East (+X)\n  # 2: South (+Y)\n  # 3: West (-X)\n  DIR_TO_VEC = {\n      0: (0, -1),  # North\n      1: (1, 0),   # East\n      2: (0, 1),   # South\n      3: (-1, 0)   # West\n  }\n\n  # Map movement vector to the corresponding internal direction ID the agent will face\n  # after taking that move. This fixes a bug in collect_v0 where the direction ID was\n  # incorrectly set to the action ID.\n  DIR_VEC_TO_DIR_ID = {\n      (0, -1): 0,  # Moving North (vec (0,-1)) sets facing direction to North (dir ID 0)\n      (1, 0): 1,   # Moving East (vec (1,0)) sets facing direction to East (dir ID 1)\n      (0, 1): 2,   # Moving South (vec (0,1)) sets facing direction to South (dir ID 2)\n      (-1, 0): 3   # Moving West (vec (-1,0)) sets facing direction to West (dir ID 3)\n  }\n\n  initial_obs = env.observations()\n  initial_grid = initial_obs['features_dict']['features_global']\n  initial_pos_tuple = tuple(initial_obs['features_dict']['pos'].astype(int))\n  # Agent's direction is a one-hot vector, convert to integer (0-3)\n  initial_dir = np.argmax(initial_obs['features_dict']['direction'])\n\n  # Grid dimensions: grid is (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = initial_grid.shape\n\n  # Get indices of non-grabbable items (obstacles) from the world\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a coordinate is within grid bounds\n  def is_valid_coord(x, y):\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  # Helper function to check if a cell is traversable.\n  # A cell is not traversable if it contains any non-grabbable entity.\n  def is_traversable(x, y, current_grid):\n      if not is_valid_coord(x, y):\n          return False\n      for idx in non_grabbable_indices:\n          if current_grid[x, y, idx] > 0:\n              return False # Contains an obstacle\n      return True # Traversable\n\n  # BFS search to find the shortest path to a position from which the primitive can be collected.\n  # The state in BFS is ((x, y), direction_int).\n  # We use parent_map to reconstruct the path later, avoiding large memory usage by not storing full paths in the queue.\n  queue = collections.deque([(initial_pos_tuple, initial_dir)])\n  # Visited set stores (position, direction) tuples to prevent cycles and redundant exploration.\n  visited = set([(initial_pos_tuple, initial_dir)])\n  # parent_map stores: (child_pos, child_dir) -> ((parent_pos, parent_dir), action_taken_to_reach_child)\n  parent_map = {}\n\n  target_reached_state = None # To store the state from which USE action can be applied\n\n  while queue:\n      (curr_x, curr_y), curr_dir_int = queue.popleft()\n      current_bfs_state = ((curr_x, curr_y), curr_dir_int)\n\n      # Check if the target primitive is directly in front of the current position and direction.\n      facing_vec = DIR_TO_VEC[curr_dir_int]\n      front_x, front_y = curr_x + facing_vec[0], curr_y + facing_vec[1]\n\n      if is_valid_coord(front_x, front_y) and initial_grid[front_x, front_y, primitive] > 0:\n          # Found the primitive in front, this is our target state.\n          target_reached_state = current_bfs_state\n          break # Found the shortest path, exit BFS\n\n      # Explore possible moves (UP, DOWN, LEFT, RIGHT).\n      # Each move action also changes the agent's direction to the direction of movement.\n      for move_vec, move_action in MOVE_VEC_TO_ACTION.items():\n          next_x, next_y = curr_x + move_vec[0], curr_y + move_vec[1]\n          # The new direction should be based on the direction of movement, not the action ID.\n          next_dir_int = DIR_VEC_TO_DIR_ID[move_vec]\n          next_pos_tuple = (next_x, next_y)\n\n          # Check if the next cell is traversable.\n          if is_traversable(next_x, next_y, initial_grid):\n              next_bfs_state = (next_pos_tuple, next_dir_int)\n              if next_bfs_state not in visited:\n                  visited.add(next_bfs_state)\n                  # Store the parent and the action taken to reach this state\n                  parent_map[next_bfs_state] = (current_bfs_state, move_action)\n                  queue.append(next_bfs_state)\n\n  # If target_reached_state is found, reconstruct the path\n  if target_reached_state:\n      actions_path = [USE] # The last action is always USE\n      current_path_state = target_reached_state\n\n      # Backtrack from the target_reached_state to the initial_state\n      while current_path_state != (initial_pos_tuple, initial_dir):\n          # Get parent state and action from parent_map\n          parent_state, action_to_reach_curr = parent_map[current_path_state]\n          actions_path.append(action_to_reach_curr)\n          current_path_state = parent_state\n      \n      # The path was built in reverse, so reverse it back\n      return actions_path[::-1]\n\n  # If the queue becomes empty and no path was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:25:41.576623", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map movement vectors (dx, dy) to action IDs.\n  # These actions move the agent AND set its facing direction.\n  MOVE_VEC_TO_ACTION = {\n      (0, -1): UP,    # Move North, face North\n      (0, 1): DOWN,   # Move South, face South\n      (-1, 0): LEFT,  # Move West, face West\n      (1, 0): RIGHT   # Move East, face East\n  }\n\n  # Map agent's internal direction ID to its corresponding facing vector (dx, dy).\n  # 0: North (-Y), 1: East (+X), 2: South (+Y), 3: West (-X)\n  DIR_TO_VEC = {\n      0: (0, -1),\n      1: (1, 0),\n      2: (0, 1),\n      3: (-1, 0)\n  }\n\n  initial_observation = env.observations()\n  # The grid is static for planning a path to a primitive.\n  current_grid = initial_observation['features_dict']['features_global']\n  initial_pos_x, initial_pos_y = initial_observation['features_dict']['pos'].astype(int)\n  # Agent's direction is a one-hot vector, convert to integer (0-3)\n  initial_direction = np.argmax(initial_observation['features_dict']['direction'])\n\n  grid_width, grid_height, _ = current_grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a coordinate is within grid bounds\n  def is_valid_coordinate(x, y):\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  # Helper function to check if a cell is traversable.\n  # A cell is not traversable if it contains any non-grabbable entity.\n  def is_traversable(x, y):\n      if not is_valid_coordinate(x, y):\n          return False\n      for idx in non_grabbable_indices:\n          if current_grid[x, y, idx] > 0:\n              return False # Contains an obstacle\n      return True # Traversable\n\n  # BFS state: ((x, y), direction_int)\n  # Queue stores (position_tuple, direction_int) for states to explore.\n  queue = collections.deque([((initial_pos_x, initial_pos_y), initial_direction)])\n  # Visited set stores (position_tuple, direction_int) to avoid redundant exploration and cycles.\n  visited = set([((initial_pos_x, initial_pos_y), initial_direction)])\n  \n  # parent_map stores: (current_pos, current_dir) -> ((parent_pos, parent_dir), action_taken_to_reach_current)\n  parent_map = {}\n  \n  # Stores the BFS state from which the 'USE' action can be applied to collect the primitive.\n  found_target_bfs_state = None\n\n  while queue:\n      (current_x, current_y), current_dir = queue.popleft()\n      current_bfs_state_key = ((current_x, current_y), current_dir)\n\n      # Check if the target primitive is directly in front of the current position and direction.\n      facing_vector = DIR_TO_VEC[current_dir]\n      front_cell_x, front_cell_y = current_x + facing_vector[0], current_y + facing_vector[1]\n\n      if is_valid_coordinate(front_cell_x, front_cell_y) and current_grid[front_cell_x, front_cell_y, primitive] > 0:\n          # Found the primitive in front, this is our target state for the BFS.\n          found_target_bfs_state = current_bfs_state_key\n          break # Shortest path found due to BFS, exit search\n\n      # Explore possible movement actions (UP, DOWN, LEFT, RIGHT).\n      # Each move action also changes the agent's facing direction.\n      for move_vector, move_action_id in MOVE_VEC_TO_ACTION.items():\n          next_x, next_y = current_x + move_vector[0], current_y + move_vector[1]\n          next_direction = move_action_id # The new direction is set by the move action itself.\n          next_bfs_state_key = ((next_x, next_y), next_direction)\n\n          # Check if the next cell is traversable and if this state hasn't been visited.\n          if is_traversable(next_x, next_y) and next_bfs_state_key not in visited:\n              visited.add(next_bfs_state_key)\n              # Store the parent state and the action taken to reach this new state\n              parent_map[next_bfs_state_key] = (current_bfs_state_key, move_action_id)\n              queue.append(next_bfs_state_key)\n\n  # If a path to the target was found, reconstruct the action sequence.\n  if found_target_bfs_state:\n      action_sequence = [USE] # The very last action is always 'USE' to collect the primitive\n      \n      # Backtrack from the found target state to the initial state.\n      current_backtrack_state = found_target_bfs_state\n      initial_bfs_state_key = ((initial_pos_x, initial_pos_y), initial_direction)\n\n      while current_backtrack_state != initial_bfs_state_key:\n          # Get the parent state and the action that led from parent to current_backtrack_state\n          parent_state, action_to_reach_current = parent_map[current_backtrack_state]\n          action_sequence.append(action_to_reach_current)\n          current_backtrack_state = parent_state\n      \n      # The path was built in reverse order (from goal to start), so reverse it to get chronological order.\n      return action_sequence[::-1]\n\n  # If the queue became empty and no path was found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:27:09.070371", "function_name": "collect", "function_body": "    # Define action constants\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Delta for cardinal directions (row_delta, col_delta)\n    # Mapping to actual movements on a grid where (0,0) is top-left\n    # UP: decreases row\n    # DOWN: increases row\n    # LEFT: decreases col\n    # RIGHT: increases col\n    MOVE_DELTAS = {\n        UP: (-1, 0),\n        DOWN: (1, 0),\n        LEFT: (0, -1),\n        RIGHT: (0, 1)\n    }\n\n    # Get current state from the environment\n    current_state = env._current_state\n    current_grid = current_state.grid\n    current_row, current_col = current_state.pos\n    \n    # Check if primitive is already collected\n    if current_state.inventory[primitive] > 0:\n        return []\n\n    # Get world specific information\n    world = env.world\n    non_grabbable_indices = world.non_grabbable_indices\n    HEIGHT, WIDTH, _ = current_grid.shape # N_KINDS not directly used here\n\n    def is_in_bounds(r, c):\n        return 0 <= r < HEIGHT and 0 <= c < WIDTH\n\n    def is_walkable(r, c):\n        # A cell is walkable if it does not contain any non-grabbable items.\n        # This assumes the agent can move onto empty cells or cells containing grabbable items.\n        for kind_idx in non_grabbable_indices:\n            if current_grid[r, c, kind_idx] == 1:\n                return False\n        return True\n    \n    # 1. Find all locations of the primitive on the grid\n    primitive_locations = []\n    for r in range(HEIGHT):\n        for c in range(WIDTH):\n            if current_grid[r, c, primitive] == 1:\n                primitive_locations.append((r, c))\n\n    if not primitive_locations:\n        return [] # Primitive not found in the world\n\n    # 2. Determine target agent positions (cells adjacent to a primitive where agent can stand)\n    # Stores (agent_adj_r, agent_adj_c)\n    target_agent_positions_set = set() \n    \n    # Iterate through primitive locations and their cardinal neighbors\n    for pr, pc in primitive_locations:\n        for dr, dc in MOVE_DELTAS.values(): # Check N, S, E, W neighbors\n            ar, ac = pr + dr, pc + dc # Candidate agent adjacent position\n            \n            # Check if the candidate agent position is in bounds and walkable.\n            # Also, ensure the agent does not try to stand on the primitive itself,\n            # as collection usually happens from an adjacent square.\n            if is_in_bounds(ar, ac) and is_walkable(ar, ac) and current_grid[ar, ac, primitive] == 0:\n                target_agent_positions_set.add((ar, ac))\n\n    if not target_agent_positions_set:\n        return [] # No reachable adjacent spots for any primitive\n\n    # 3. BFS to find the shortest path to any target_agent_position\n    # Queue stores tuples: (row, col, list_of_actions_to_reach_here)\n    q = collections.deque([(current_row, current_col, [])]) \n    \n    # Visited set to avoid cycles and redundant paths: (row, col)\n    visited = set([(current_row, current_col)])\n    \n    best_path_to_adj = None\n\n    while q:\n        r, c, path_actions = q.popleft()\n\n        # If this position is one of our target agent positions\n        if (r, c) in target_agent_positions_set:\n            best_path_to_adj = path_actions\n            break # Found the shortest path to an adjacent cell\n\n        # Explore neighbors (possible moves)\n        for action, (dr, dc) in MOVE_DELTAS.items():\n            nr, nc = r + dr, c + dc # New potential position\n\n            if is_in_bounds(nr, nc) and is_walkable(nr, nc) and (nr, nc) not in visited:\n                visited.add((nr, nc))\n                q.append((nr, nc, path_actions + [action]))\n\n    if best_path_to_adj is None:\n        return [] # No path found to any adjacent cell\n\n    # 4. Add the USE action after reaching the adjacent position\n    final_actions = list(best_path_to_adj) + [USE]\n\n    return final_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:27:09.148782", "function_name": "collect", "function_body": "    from collections import deque\n    # Assuming Actions, WIDTH, and HEIGHT are available from env_factory or similar global scope.\n    # If not, they would typically be imported at the module level.\n    # For this completion, we'll assume direct access or local import where permitted.\n    try:\n        from env_factory import Actions, WIDTH, HEIGHT\n    except ImportError:\n        # Fallback if env_factory is not structured this way or missing\n        # Define dummy constants for completion purposes if needed,\n        # but in a real scenario, these would come from the environment setup.\n        class Actions:\n            DOWN = 0\n            UP = 1\n            LEFT = 2\n            RIGHT = 3\n            USE = 4\n        WIDTH = 7  # Common default for CraftWorld\n        HEIGHT = 7 # Common default for CraftWorld\n\n\n    # Get the initial state of the environment\n    initial_state = env._current_state\n\n    # If the primitive is already in inventory, no actions are needed\n    if initial_state.inventory[primitive] > 0:\n        return []\n\n    # BFS Queue: stores tuples of (current_craft_state, list_of_actions_taken)\n    # We use CraftState objects directly as CraftState.step is expected to return a new instance.\n    q = deque([(initial_state, [])])\n\n    # Visited set: stores hashable representations of states to avoid cycles and redundant work.\n    # A state is defined by (pos_x, pos_y, dir, tuple(inventory)).\n    # The inventory is included to differentiate states where the agent is at the same\n    # position/direction but has picked up different items.\n    visited = set()\n    initial_state_representation = (\n        initial_state.pos[0],\n        initial_state.pos[1],\n        initial_state.dir,\n        tuple(initial_state.inventory)\n    )\n    visited.add(initial_state_representation)\n\n    # All possible actions that the agent can take, including USE.\n    possible_actions = [\n        Actions.UP.value,\n        Actions.DOWN.value,\n        Actions.LEFT.value,\n        Actions.RIGHT.value,\n        Actions.USE.value\n    ]\n\n    while q:\n        current_state, path = q.popleft()\n\n        # Check if the goal (primitive in inventory) is satisfied in the current state.\n        # This means the last action in the 'path' must have successfully collected the primitive.\n        if current_state.inventory[primitive] > 0:\n            return path # Goal reached, return the sequence of actions.\n\n        # Explore all possible next actions from the current state\n        for action in possible_actions:\n            # Simulate the action on the current state.\n            # CraftState.step is assumed to return a *new* CraftState instance.\n            # The reward is not relevant for pathfinding in this context.\n            _, next_state = current_state.step(action)\n\n            # Create a hashable representation of the next state\n            next_state_representation = (\n                next_state.pos[0],\n                next_state.pos[1],\n                next_state.dir,\n                tuple(next_state.inventory)\n            )\n\n            # If this state has not been visited before, add it to the queue and visited set\n            if next_state_representation not in visited:\n                visited.add(next_state_representation)\n                q.append((next_state, path + [action]))\n\n    # If the queue becomes empty and the goal was not reached (e.g., primitive is unreachable\n    # or not present in a collectable way), return an empty list.\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:29:28.485327", "function_name": "collect", "function_body": "    from collections import deque\n\n    # Constants for actions and directions (defined locally for strict adherence to instructions)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    DIR_NORTH = 0\n    DIR_EAST = 1\n    DIR_SOUTH = 2\n    DIR_WEST = 3\n\n    actions_taken = []\n    \n    # Reset environment to get initial state. The observations are immediately available\n    # via env.observations() or env._current_state.\n    _ = env.reset() \n    \n    # Access the CraftState directly for current grid, inventory, and pos/dir.\n    # This provides a more direct way to query the state for planning.\n    current_state = env._current_state \n    \n    # Get relevant world properties for BFS pathfinding\n    world = current_state.world\n    \n    # Determine which entities block movement (non-grabbables that are not workshops)\n    obstacle_indices = set(world.non_grabbable_indices) - set(world.workshop_indices)\n\n    # Max steps to prevent infinite loops in case of unachievable goals or poor pathing\n    max_planning_steps = 200 \n\n    for _ in range(max_planning_steps):\n        # 1. Check if the primitive is already collected\n        if current_state.inventory[primitive] > 0:\n            return actions_taken\n\n        # Get current observations details (features_dict provides egocentric and global views)\n        obs_dict = current_state.features_dict()\n        ego_grid = obs_dict['features_ego'] # Egocentric view (rows, cols, n_kinds)\n        agent_dir_one_hot = obs_dict['direction'] # Agent's facing direction as one-hot\n        agent_dir = np.argmax(agent_dir_one_hot) # Convert one-hot to integer direction\n\n        # Agent's position within the egocentric view (center)\n        ego_rows, ego_cols, _ = ego_grid.shape\n        agent_ego_y, agent_ego_x = ego_rows // 2, ego_cols // 2\n\n        action_to_take = None\n\n        # 2. Check the cell directly in front of the agent for the primitive\n        front_y, front_x = -1, -1 # Relative coordinates of the cell in front\n        if agent_dir == DIR_NORTH: # Facing UP\n            front_y, front_x = agent_ego_y - 1, agent_ego_x\n        elif agent_dir == DIR_EAST: # Facing RIGHT\n            front_y, front_x = agent_ego_y, agent_ego_x + 1\n        elif agent_dir == DIR_SOUTH: # Facing DOWN\n            front_y, front_x = agent_ego_y + 1, agent_ego_x\n        elif agent_dir == DIR_WEST: # Facing LEFT\n            front_y, front_x = agent_ego_y, agent_ego_x - 1\n\n        # If the front cell is within egocentric view bounds and contains the primitive, USE it.\n        if 0 <= front_y < ego_rows and 0 <= front_x < ego_cols:\n            if ego_grid[front_y, front_x, primitive] == 1:\n                action_to_take = ACTION_USE\n        \n        # 3. If not ready to USE, find the primitive using Breadth-First Search (BFS) on the global map\n        if action_to_take is None:\n            global_grid = obs_dict['features_global'] # Full allocentric grid copy\n            agent_global_y, agent_global_x = current_state.pos # Agent's global (y, x) position\n\n            # Check if the primitive exists anywhere on the global map\n            if np.any(global_grid[:, :, primitive] == 1):\n                \n                # BFS to find the shortest path to any instance of the primitive\n                # Queue stores (current_y, current_x, list_of_actions_to_reach_here)\n                q = deque([(agent_global_y, agent_global_x, [])])\n                \n                # Set to store visited grid cells to prevent cycles\n                visited = set([(agent_global_y, agent_global_x)])\n\n                path_to_primitive = None\n\n                # Define possible moves and their corresponding actions\n                # Assuming actions are absolute grid directions (UP moves North, etc.)\n                move_deltas = {\n                    ACTION_UP: (-1, 0),    # (dy, dx) for moving UP\n                    ACTION_DOWN: (1, 0),   # (dy, dx) for moving DOWN\n                    ACTION_LEFT: (0, -1),  # (dy, dx) for moving LEFT\n                    ACTION_RIGHT: (0, 1)   # (dy, dx) for moving RIGHT\n                }\n                \n                while q:\n                    curr_y, curr_x, path = q.popleft()\n\n                    # If the current cell contains the primitive, we found a path\n                    if global_grid[curr_y, curr_x, primitive] == 1:\n                        path_to_primitive = path\n                        break \n\n                    # Explore neighboring cells\n                    for action, (dy, dx) in move_deltas.items():\n                        next_y, next_x = curr_y + dy, curr_x + dx\n                        \n                        # Check if the next cell is within grid bounds\n                        if not (0 <= next_y < global_grid.shape[0] and 0 <= next_x < global_grid.shape[1]):\n                            continue\n                        \n                        # Check if the next cell is blocked by an obstacle\n                        is_blocked = False\n                        for obstacle_idx in obstacle_indices:\n                            if global_grid[next_y, next_x, obstacle_idx] == 1:\n                                is_blocked = True\n                                break\n                        if is_blocked:\n                            continue\n\n                        # If the cell hasn't been visited, add it to the queue\n                        if (next_y, next_x) not in visited:\n                            visited.add((next_y, next_x))\n                            new_path = list(path) # Create a copy of the path\n                            new_path.append(action)\n                            q.append((next_y, next_x, new_path))\n                \n                # If a path was found, take the first action in that path\n                if path_to_primitive:\n                    action_to_take = path_to_primitive[0]\n                # Else (path_to_primitive is None), primitive exists but is unreachable.\n                # In this case, action_to_take remains None, leading to loop termination.\n            # Else (primitive not found on map), action_to_take remains None.\n\n        # 4. Execute the chosen action\n        if action_to_take is not None:\n            actions_taken.append(action_to_take)\n            # Apply the action and update the internal current state reference\n            reward, done, obs = env.step(action_to_take)\n            current_state = env._current_state \n            \n            # If the environment indicates the episode is done (e.g., max steps reached), exit\n            if done: \n                return actions_taken\n        else:\n            # No action could be determined (e.g., primitive not found or unreachable)\n            break \n            \n    # If the loop finishes (e.g., max_planning_steps reached) and primitive is not collected\n    return actions_taken", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:29:28.554340", "function_name": "collect", "function_body": "    # Map actions to coordinate changes (dr, dc) for a grid where pos = (row, col)\n    # Positive row is \"down\", positive col is \"right\"\n    ACTION_DELTAS = {\n        UP: (-1, 0),    # row decreases, col same (move up)\n        DOWN: (1, 0),   # row increases, col same (move down)\n        LEFT: (0, -1),  # row same, col decreases (move left)\n        RIGHT: (0, 1)   # row same, col increases (move right)\n    }\n\n    actions_taken = []\n\n    # Use a dynamic limit based on environment's max_steps to prevent infinite loops,\n    # or a reasonable hardcoded maximum number of actions to attempt collection.\n    # Allowing more steps than a typical episode since this is a planning function.\n    MAX_COLLECT_ACTIONS_LIMIT = env.max_steps * 2 \n    if MAX_COLLECT_ACTIONS_LIMIT == 0: # Fallback if max_steps is undefined or 0\n        MAX_COLLECT_ACTIONS_LIMIT = 500 # Default reasonable limit\n\n    for _ in range(MAX_COLLECT_ACTIONS_LIMIT):\n        obs = env.observations()\n        current_state = env._current_state # Access the internal CraftState instance\n        \n        # 1. Check if primitive is already collected in inventory\n        current_inventory = obs['features_dict']['inventory']\n        if current_inventory[primitive] > 0:\n            return actions_taken # Goal achieved\n\n        # 2. Check if primitive is next to the agent (within 3x3 neighborhood, including current cell)\n        # CraftState.next_to() handles this check efficiently.\n        if current_state.next_to(primitive):\n            actions_taken.append(USE)\n            reward, done, _ = env.step(USE) # Perform the USE action\n            \n            # After USE, re-check inventory. If it increased, collection was successful.\n            # This check is crucial as USE might fail or target something else.\n            if env.observations()['features_dict']['inventory'][primitive] > current_inventory[primitive]:\n                return actions_taken # Successfully collected the primitive\n            else:\n                # USE action might have failed (e.g., target not grabbable, no tool, etc.).\n                # We continue the loop; it might re-evaluate and find another primitive or path.\n                # The MAX_COLLECT_ACTIONS_LIMIT will eventually terminate if stuck.\n                continue \n\n        # 3. If not next to, find a path to the primitive using BFS\n        agent_row, agent_col = current_state.pos\n        \n        # Determine grid dimensions from current_state.grid.shape\n        # Assuming grid.shape is (num_rows, num_cols, num_kinds)\n        map_rows, map_cols, _ = current_state.grid.shape \n        \n        # Build an obstacle map for BFS\n        # Cells containing any non-grabbable item are considered obstacles for movement.\n        # This assumes the primitive itself is grabbable and walkable.\n        obstacle_map = np.zeros((map_rows, map_cols), dtype=bool)\n        for r in range(map_rows):\n            for c in range(map_cols):\n                # Get the kinds present at this cell\n                cell_kinds = np.where(current_state.grid[r, c, :] == 1)[0]\n                # If any of the kinds in this cell are in the world's non_grabbable_indices set\n                if any(k in env.world.non_grabbable_indices for k in cell_kinds):\n                    obstacle_map[r, c] = True\n        \n        # Find all locations where the primitive exists on the grid\n        primitive_locations = np.argwhere(current_state.grid[:, :, primitive] == 1)\n\n        if len(primitive_locations) == 0:\n            # Primitive not found anywhere on the map in the global view.\n            # This implies it might be unreachable or not spawned.\n            return actions_taken # Cannot find, give up.\n\n        # BFS algorithm to find shortest path to any primitive location\n        # Queue stores (current_row, current_col, path_to_here)\n        queue = deque([(agent_row, agent_col, [])]) \n        # Keep track of visited cells to avoid loops and redundant processing\n        visited = set([(agent_row, agent_col)])\n        \n        path_to_primitive_cell = None\n        \n        while queue:\n            curr_r, curr_c, path = queue.popleft()\n\n            # If the current cell contains the primitive, we've found a path to it.\n            # CraftState.next_to() implies that if we are ON the primitive, we can USE it.\n            if current_state.grid[curr_r, curr_c, primitive] == 1:\n                path_to_primitive_cell = path\n                break # Found shortest path to a primitive cell, exit BFS\n\n            # Explore all 4 cardinal neighbors\n            for action_val, (dr, dc) in ACTION_DELTAS.items():\n                next_r, next_c = curr_r + dr, curr_c + dc\n\n                # Check boundary conditions and if the cell has already been visited\n                if 0 <= next_r < map_rows and 0 <= next_c < map_cols and \\\n                   (next_r, next_c) not in visited:\n                    \n                    # Check if the next cell is an obstacle\n                    if not obstacle_map[next_r, next_c]: # Only traverse if not an obstacle\n                        visited.add((next_r, next_c))\n                        queue.append((next_r, next_c, path + [action_val]))\n        \n        # If BFS found a path to a primitive cell\n        if path_to_primitive_cell:\n            # Take the first action in the calculated path\n            next_action = path_to_primitive_cell[0]\n            actions_taken.append(next_action)\n            reward, done, _ = env.step(next_action) # Perform the movement action\n            \n            if done:\n                # Episode ended after this step. Check if goal was achieved before breaking.\n                if env.observations()['features_dict']['inventory'][primitive] > 0:\n                    return actions_taken\n                break # Cannot continue, episode is done.\n        else:\n            # No path found to any primitive on the current map within traversable areas.\n            # This means all primitives are unreachable (e.g., behind walls, or no path exists).\n            return actions_taken # Give up and return current actions\n\n    return actions_taken # Max actions limit reached or couldn't collect within limits", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:30:46.852757", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants (from env.action_specs())\n    # Assuming the following integer mappings based on the problem description:\n    # DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3, USE: 4\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    # Direction constants (assuming 0=N, 1=E, 2=S, 3=W from CraftState init_dir)\n    # These represent the direction the agent is facing.\n    _DIR_N = 0\n    _DIR_E = 1\n    _DIR_S = 2\n    _DIR_W = 3\n\n    actions = []\n\n    # Get initial state information from the environment\n    initial_obs = env.observations()\n    initial_features_dict = initial_obs['features_dict']\n    grid = initial_features_dict['features_global']\n    start_pos = tuple(initial_features_dict['pos']) # Convert numpy array (r,c) to tuple\n    start_dir = np.argmax(initial_features_dict['direction']) # Convert one-hot direction to int\n\n    height, width, _ = grid.shape\n\n    # Check if primitive is already collected in the initial state\n    if initial_features_dict['inventory'][primitive] > 0:\n        return [] # Already have it, no actions needed\n\n    # BFS state: (current_pos (tuple), current_dir (int), path_actions (list))\n    queue = collections.deque([(start_pos, start_dir, [])])\n    # Visited states: (pos, dir) to prevent cycles and re-exploring the same state\n    visited = set([(start_pos, start_dir)])\n\n    # Mapping of movement action to (dr, dc) and the resulting agent direction\n    # When an agent moves, its facing direction typically updates to the direction of movement.\n    move_map = {\n        _UP: ((-1, 0), _DIR_N),   # Move North (row - 1, col), face North\n        _DOWN: ((1, 0), _DIR_S),  # Move South (row + 1, col), face South\n        _LEFT: ((0, -1), _DIR_W), # Move West (row, col - 1), face West\n        _RIGHT: ((0, 1), _DIR_E)  # Move East (row, col + 1), face East\n    }\n\n    # BFS search\n    while queue:\n        (r, c), current_d, current_path = queue.popleft()\n\n        # Check if the primitive is at the current position or any adjacent cell (3x3 neighborhood)\n        # Based on CraftState.next_to and common conventions, assuming USE works for any primitive\n        # in the 3x3 neighborhood, regardless of facing direction.\n        found_primitive_adjacent = False\n        \n        # Check current cell first\n        if grid[r, c, primitive] == 1:\n            actions = current_path + [_USE]\n            found_primitive_adjacent = True\n        else:\n            # Check 4 cardinal neighbors\n            for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < height and 0 <= nc < width:\n                    if grid[nr, nc, primitive] == 1:\n                        # Found a primitive at (nr, nc) which is adjacent to current (r, c)\n                        actions = current_path + [_USE]\n                        found_primitive_adjacent = True\n                        break # Break from neighbor loop once a target is found\n            \n        if found_primitive_adjacent:\n            return actions # Return the path including the USE action\n\n        # If primitive is not yet adjacent, explore movement actions\n        for move_action, ((dr, dc), new_dir) in move_map.items():\n            nr, nc = r + dr, c + dc # Calculate new position\n\n            # Check if the new position is within grid boundaries\n            if 0 <= nr < height and 0 <= nc < width:\n                # The agent's direction updates to the direction corresponding to the move action.\n                next_state_tuple = ((nr, nc), new_dir)\n                \n                # Only add to queue if this state (position and direction) hasn't been visited\n                if next_state_tuple not in visited:\n                    visited.add(next_state_tuple)\n                    queue.append(((nr, nc), new_dir, current_path + [move_action]))\n\n    # If BFS completes and no primitive was found or reachable\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:30:47.835334", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:32:37.722757", "function_name": "collect", "function_body": "  all_actions_taken = []\n  \n  # Dynamically get action values from the environment to be robust\n  action_values = env.action_specs()\n  _ACTION_DOWN = action_values['DOWN']\n  _ACTION_UP = action_values['UP']\n  _ACTION_LEFT = action_values['LEFT']\n  _ACTION_RIGHT = action_values['RIGHT']\n  _ACTION_USE = action_values['USE']\n  \n  # Ensure the environment is reset to get a clean start and initial observations.\n  # For a \"terminal function\" in a DSL, starting from a fresh state is often desired.\n  obs = env.reset() \n\n  # --- Start of _find_path_and_actions_helper ---\n  # This helper function uses Breadth-First Search (BFS) to find a path to the target item.\n  # It is defined inside the main function as per the prompt's instruction to return\n  # only code that fits inside the function.\n  import collections # Import collections for deque\n\n  def _find_path_and_actions_helper(grid, start_pos_int, target_kind_idx, WIDTH, HEIGHT, grabbable_indices):\n      \"\"\"\n      Finds a sequence of movement actions to reach an interactable position for the target item.\n      An 'interactable' position means:\n      - On the target item's cell if it's grabbable.\n      - Adjacent to the target item's cell if it's non-grabbable.\n\n      Args:\n          grid (np.ndarray): The current grid state (WIDTH, HEIGHT, n_kinds).\n          start_pos_int (tuple): Agent's current integer position (x, y).\n          target_kind_idx (int): The index of the item to collect.\n          WIDTH (int): Grid width.\n          HEIGHT (int): Grid height.\n          grabbable_indices (set): Set of indices for grabbable items.\n\n      Returns:\n          list: A list of actions (integers) to reach the interactable position, or None if no path.\n      \"\"\"\n      # Queue stores (current_pos, list_of_actions_to_reach_this_pos)\n      q = collections.deque([(start_pos_int, [])])\n      visited = {start_pos_int}\n\n      # Identify all cells containing the target item\n      target_item_locations = []\n      for x in range(WIDTH):\n          for y in range(HEIGHT):\n              if grid[x, y, target_kind_idx] == 1:\n                  target_item_locations.append((x, y))\n\n      if not target_item_locations: # Target not found on the grid\n          return None\n\n      # Define movement directions and corresponding actions\n      # (dx, dy, action)\n      MOVES = [\n          (0, -1, _ACTION_UP),    # Move up (decrease y)\n          (0, 1, _ACTION_DOWN),   # Move down (increase y)\n          (-1, 0, _ACTION_LEFT),  # Move left (decrease x)\n          (1, 0, _ACTION_RIGHT)   # Move right (increase x)\n      ]\n\n      is_target_grabbable = target_kind_idx in grabbable_indices\n\n      while q:\n          (curr_x, curr_y), actions_path = q.popleft()\n\n          # Check if the current position is an 'interactable' position for the target item\n          is_interactable = False\n          if is_target_grabbable:\n              # If grabbable, the agent needs to be ON the item's cell.\n              if (curr_x, curr_y) in target_item_locations:\n                  is_interactable = True\n          else: \n              # If non-grabbable (e.g., workshop), the agent needs to be ADJACENT to the item's cell.\n              for tx, ty in target_item_locations:\n                  # Check 4-directional adjacency\n                  if (abs(curr_x - tx) == 1 and curr_y == ty) or \\\n                     (abs(curr_y - ty) == 1 and curr_x == tx):\n                      is_interactable = True\n                      break\n          \n          if is_interactable:\n              return actions_path # Found path to an interactable cell\n\n          # Explore neighbors\n          for dx, dy, action in MOVES:\n              next_x, next_y = curr_x + dx, curr_y + dy\n              next_pos = (next_x, next_y)\n\n              # Check bounds and if already visited\n              if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT and next_pos not in visited:\n                  # Assume all valid cells are traversable unless explicitly defined as obstacles.\n                  visited.add(next_pos)\n                  q.append((next_pos, actions_path + [action]))\n\n      return None # No path found to any interactable location\n  # --- End of _find_path_and_actions_helper ---\n  \n  # Main logic for collect_v2\n  while True:\n    current_obs_dict = obs['features_dict']\n    current_grid = current_obs_dict['features_global']\n    current_inventory = current_obs_dict['inventory']\n    \n    # 1. Check if the primitive is already collected\n    if current_inventory[primitive] > 0:\n      break # Goal achieved\n\n    # Get current agent position (denormalize from features_dict 'pos' array)\n    grid_shape = current_grid.shape\n    WIDTH, HEIGHT, _ = grid_shape\n    \n    norm_pos = current_obs_dict['pos']\n    current_pos_x = int(round(norm_pos[0] * (WIDTH - 1)))\n    current_pos_y = int(round(norm_pos[1] * (HEIGHT - 1)))\n    current_pos_int = (current_pos_x, current_pos_y)\n\n    # Get grabbable indices from the CraftWorld instance via the CraftLab instance\n    grabbable_indices = env.world.grabbable_indices\n    \n    # 2. Find path to an interactable position for the primitive using BFS\n    path_actions = _find_path_and_actions_helper(\n        current_grid, current_pos_int, primitive, WIDTH, HEIGHT, grabbable_indices\n    )\n\n    if path_actions is None:\n      # Primitive not found on the grid, or unreachable. \n      # If not found and not already collected, implies an impossible state for this task.\n      return all_actions_taken # Cannot collect, return actions taken so far (might be empty)\n\n    # 3. Execute movement actions to reach the interactable position\n    for action in path_actions:\n      reward, done, obs = env.step(action)\n      all_actions_taken.append(action)\n      \n      # Check if done early (e.g., max_steps reached)\n      if done:\n          # Even if done, check if goal was achieved by movement (e.g., walking over a grabbable item)\n          if obs['features_dict']['inventory'][primitive] > 0:\n              break # Goal achieved before all path actions completed or done flag means max steps.\n          else:\n              return all_actions_taken # Environment terminated before collection.\n\n    # Re-check inventory after movement, in case the primitive was collected by just walking over it\n    current_inventory = obs['features_dict']['inventory']\n    if current_inventory[primitive] > 0:\n        break # Goal achieved by movement, no need for explicit USE action\n\n    # 4. Perform the USE action at the interactable position\n    reward, done, obs = env.step(_ACTION_USE)\n    all_actions_taken.append(_ACTION_USE)\n\n    # 5. Check if goal is satisfied after USE, or if environment is done\n    if obs['features_dict']['inventory'][primitive] > 0:\n      break # Goal achieved\n    \n    if done:\n      break # Environment done for some other reason (e.g., max steps)\n\n  return all_actions_taken", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:32:37.793944", "function_name": "collect", "function_body": "    all_actions = []\n    MAX_TOTAL_STEPS = 200 # Safety limit for the entire collection process\n\n    # Loop to try collecting until successful or max steps reached.\n    # This allows for retries if an attempt fails (e.g., primitive exhausted)\n    # and another instance needs to be found.\n    for _ in range(MAX_TOTAL_STEPS): \n        current_obs = env.observations()\n        current_state_dict = current_obs['features_dict']\n        current_inventory = current_state_dict['inventory']\n\n        # 1. Check if primitive is already collected\n        if current_inventory[primitive] > 0:\n            return all_actions # Already have it, return actions taken so far\n\n        current_pos = tuple(current_state_dict['pos']) # (x, y)\n        current_dir_idx = np.argmax(current_state_dict['direction']) # 0-3\n        grid = current_state_dict['features_global'] # (WIDTH, HEIGHT, n_kinds)\n        grid_width, grid_height, _ = grid.shape\n\n        # Helper to check if a position is valid and traversable for movement\n        def is_traversable_for_movement(x, y):\n            if not (0 <= x < grid_width and 0 <= y < grid_height):\n                return False\n            \n            # Get the set of currently impassable kinds from the world configuration.\n            # These are typically obstacles like walls.\n            impassable_kinds = env.world.non_grabbable_indices \n            \n            # Check if this cell contains any impassable entity.\n            # A special case: if the primitive itself is in impassable_kinds (e.g., water),\n            # but the agent can move onto it to collect, it should still be traversable.\n            for k_idx in range(grid.shape[2]):\n                if grid[x, y, k_idx] > 0 and k_idx in impassable_kinds:\n                    if k_idx != primitive: # If it's another non-grabbable obstacle\n                        return False # This cell is blocked by an unrelated impassable object\n            return True\n\n        # BFS to find the nearest *agent position* from which the primitive can be 'USE'd\n        q = collections.deque([(current_pos, [])]) # (pos, path_to_get_here)\n        visited = {current_pos}\n        \n        target_agent_pos = None # The (ax, ay) where the agent should stand\n        # target_primitive_pos is the (px, py) of the actual primitive block to 'USE'\n        target_primitive_pos = None \n\n        while q:\n            (x, y), path = q.popleft()\n\n            # Check if (x, y) is adjacent to a primitive block or is on the primitive itself.\n            # A cell (x, y) is a candidate target_agent_pos if:\n            # 1. It contains the primitive (e.g., for water, agent stands on it).\n            # 2. One of its cardinal neighbors contains the primitive (e.g., for wood, agent stands next to it).\n\n            # Case 1: Agent stands on the primitive to collect it\n            if grid[x, y, primitive] > 0 and primitive in env.world.grabbable_indices:\n                target_agent_pos = (x, y)\n                target_primitive_pos = (x, y) # Primitive is at agent's current location\n                break # Found a target\n\n            # Case 2: Agent stands adjacent to the primitive to collect it\n            for dx_check, dy_check in _DIRECTIONS.values(): # Check cardinal neighbors\n                nx_check, ny_check = x + dx_check, y + dy_check\n                if 0 <= nx_check < grid_width and 0 <= ny_check < grid_height and grid[nx_check, ny_check, primitive] > 0:\n                    # Found a primitive at (nx_check, ny_check) adjacent to (x, y)\n                    target_agent_pos = (x, y)\n                    target_primitive_pos = (nx_check, ny_check)\n                    break \n            if target_agent_pos: # If a target was found in either case\n                break \n\n            # If not a target, continue BFS by exploring neighbors\n            for dx, dy in _DIRECTIONS.values():\n                next_x, next_y = x + dx, y + dy\n                next_pos = (next_x, next_y)\n\n                if is_traversable_for_movement(next_x, next_y) and next_pos not in visited:\n                    visited.add(next_pos)\n                    q.append((next_pos, path + [ (dx, dy) ])) \n\n        if not target_agent_pos:\n            # No reachable position found to collect the primitive.\n            return all_actions \n\n        # Execute movement actions to get to target_agent_pos\n        current_x, current_y = current_pos \n        for dx, dy in path: # `path` is the sequence of (dx, dy) moves from BFS\n            action = _MOVE_ACTIONS[(dx, dy)]\n            _, _, obs = env.step(action)\n            all_actions.append(action)\n            \n            # Update agent's internal state after each action\n            current_state_dict = obs['features_dict']\n            current_x, current_y = tuple(current_state_dict['pos'])\n            current_dir_idx = np.argmax(current_state_dict['direction'])\n            inventory = current_state_dict['inventory']\n            if inventory[primitive] > 0:\n                return all_actions # Collected during movement (unlikely but possible)\n\n        # Agent is now at `target_agent_pos` (which is `(current_x, current_y)`).\n        # Need to face `target_primitive_pos` and USE.\n\n        px, py = target_primitive_pos\n\n        # Only rotate if the primitive is not directly under the agent\n        if (px, py) != (current_x, current_y):\n            # Calculate vector from agent's current position to primitive's position\n            vec_to_primitive = (px - current_x, py - current_y)\n\n            # Determine the required facing direction index\n            required_dir_idx = -1\n            for idx, (dx_dir, dy_dir) in _DIRECTIONS.items():\n                if (dx_dir, dy_dir) == vec_to_primitive:\n                    required_dir_idx = idx\n                    break\n            \n            # This should ideally not happen if target_primitive_pos is directly adjacent\n            if required_dir_idx == -1:\n                return all_actions \n\n            # Rotate agent until it faces the primitive\n            while current_dir_idx != required_dir_idx:\n                diff = (required_dir_idx - current_dir_idx + 4) % 4\n                if diff == 1: # Turn right (shortest path: +90 deg)\n                    action = _ACTION_RIGHT\n                elif diff == 3: # Turn left (shortest path: -90 deg)\n                    action = _ACTION_LEFT\n                else: # diff == 2 (180 deg turn), either left or right works, pick one\n                    action = _ACTION_LEFT \n                \n                _, _, obs = env.step(action)\n                all_actions.append(action)\n                current_state_dict = obs['features_dict']\n                current_dir_idx = np.argmax(current_state_dict['direction'])\n                inventory = current_state_dict['inventory']\n                if inventory[primitive] > 0:\n                    return all_actions # Collected during rotation (very unlikely)\n\n        # Agent is now at target_agent_pos and facing target_primitive_pos (if applicable)\n        # Use the primitive\n        _, _, obs = env.step(_ACTION_USE)\n        all_actions.append(_ACTION_USE)\n        inventory = obs['features_dict']['inventory']\n        if inventory[primitive] > 0:\n            return all_actions\n        \n        # If 'USE' failed (e.g., primitive exhausted, or not the right tool/context),\n        # the loop will continue. On the next iteration, the grid will be re-evaluated\n        # and BFS will search for the next nearest primitive instance or confirm it's\n        # uncollectable.\n\n    return all_actions # If MAX_TOTAL_STEPS reached and not collected", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:33:32.854772", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement vectors (dx, dy) to action IDs.\n  # These actions move the agent AND set its facing direction.\n  MOVE_VEC_TO_ACTION = {\n      (0, -1): ACTION_UP,    # Move North, face North\n      (0, 1): ACTION_DOWN,   # Move South, face South\n      (-1, 0): ACTION_LEFT,  # Move West, face West\n      (1, 0): ACTION_RIGHT   # Move East, face East\n  }\n\n  # Map agent's internal direction ID to its corresponding facing vector (dx, dy).\n  # 0: North (-Y), 1: East (+X), 2: South (+Y), 3: West (-X)\n  DIR_TO_VEC = {\n      0: (0, -1),  # North\n      1: (1, 0),   # East\n      2: (0, 1),   # South\n      3: (-1, 0)   # West\n  }\n\n  def _find_path_bfs_internal(\n      start_state, \n      is_goal_func, \n      get_neighbors_func\n  ):\n      \"\"\"\n      Generic BFS implementation to find the shortest path.\n      This is a nested helper function for `collect_v2`.\n\n      Args:\n          start_state: The initial state for the BFS.\n          is_goal_func: A callable that takes a state and returns True if it's a goal state.\n          get_neighbors_func: A callable that takes a state and returns an iterable\n                              of (neighbor_state, action_to_reach_neighbor).\n\n      Returns:\n          A list of actions representing the path from start_state to a goal state,\n          or None if no path is found.\n      \"\"\"\n      queue = collections.deque([(start_state)])\n      visited = {start_state}\n      parent_map = {} # (child_state) -> (parent_state, action_taken_to_reach_child)\n\n      target_found_state = None\n\n      while queue:\n          current_state = queue.popleft()\n\n          # Check if the current state is a goal state\n          if is_goal_func(current_state):\n              target_found_state = current_state\n              break # Shortest path found\n\n          # Explore possible next states (neighbors)\n          for next_state, action_to_reach_next in get_neighbors_func(current_state):\n              if next_state not in visited:\n                  visited.add(next_state)\n                  parent_map[next_state] = (current_state, action_to_reach_next)\n                  queue.append(next_state)\n      \n      # If a target state was found, reconstruct the path by backtracking\n      if target_found_state:\n          actions_path = []\n          current = target_found_state\n          while current != start_state:\n              parent, action = parent_map[current]\n              actions_path.append(action)\n              current = parent\n          return actions_path[::-1] # Reverse the path to get actions in correct order\n      \n      return None # No path found\n\n  # Get initial observations and extract relevant state information\n  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  start_pos = tuple(obs['features_dict']['pos'].astype(int))\n  start_dir = np.argmax(obs['features_dict']['direction']) # Convert one-hot direction to int (0-3)\n\n  grid_width, grid_height, _ = grid.shape\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a coordinate is within grid bounds\n  def is_valid_coord(x, y):\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  # Helper function to check if a cell is traversable.\n  # A cell is not traversable if it contains any non-grabbable entity.\n  def is_traversable(x, y):\n      if not is_valid_coord(x, y):\n          return False\n      for idx in non_grabbable_indices:\n          if grid[x, y, idx] > 0:\n              return False # Contains an obstacle\n      return True # Traversable\n\n  # Define the specific components for the BFS needed for this problem:\n\n  # 1. Starting state for BFS: agent's initial position and direction\n  start_bfs_state = (start_pos, start_dir) # State is represented as ((x, y), direction_int)\n\n  # 2. Goal check function: True if the primitive is directly in front of the agent\n  def is_goal_state(state):\n      (curr_x, curr_y), curr_dir = state\n      facing_vec = DIR_TO_VEC[curr_dir]\n      front_x, front_y = curr_x + facing_vec[0], curr_y + facing_vec[1]\n      # A state is a goal if the primitive is in the cell directly in front\n      return is_valid_coord(front_x, front_y) and grid[front_x, front_y, primitive] > 0\n\n  # 3. Neighbors (next states) generation function: possible moves from current state\n  def get_next_states(current_state):\n      (curr_x, curr_y), _ = current_state # We don't use curr_dir for generating moves\n      neighbors = []\n      # Explore possible moves (UP, DOWN, LEFT, RIGHT).\n      # Each move action also sets the agent's facing direction.\n      for move_vec, move_action in MOVE_VEC_TO_ACTION.items():\n          next_x, next_y = curr_x + move_vec[0], curr_y + move_vec[1]\n          next_dir = move_action # The new direction is automatically set by the move action\n          next_pos = (next_x, next_y)\n\n          if is_traversable(next_x, next_y):\n              neighbors.append(((next_pos, next_dir), move_action))\n      return neighbors\n\n  # Use the generic BFS to find the path to a state from which the 'USE' action can be applied\n  path_to_pre_use = _find_path_bfs_internal(start_bfs_state, is_goal_state, get_next_states)\n\n  # If a path was found, append the 'USE' action and return\n  if path_to_pre_use is not None:\n      return path_to_pre_use + [ACTION_USE]\n  else:\n      # If no path was found to any position adjacent to the primitive, return an empty list\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:33:33.822975", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from action_specs)\n  # These constants define the agent's possible actions.\n  ACTION_MOVE_SOUTH = 0 # Corresponds to DOWN\n  ACTION_MOVE_NORTH = 1 # Corresponds to UP\n  ACTION_MOVE_WEST = 2  # Corresponds to LEFT\n  ACTION_MOVE_EAST = 3  # Corresponds to RIGHT\n  ACTION_USE = 4\n\n  # Map movement vectors (dx, dy) to the corresponding action ID and the resulting facing direction.\n  # The direction ID mapping is: 0: North (-Y), 1: East (+X), 2: South (+Y), 3: West (-X).\n  # Moving in a direction also sets the agent's facing direction to that same direction.\n  MOVE_ACTIONS_AND_DIRECTIONS = {\n      (0, -1): (ACTION_MOVE_NORTH, 0), # Move North, face North\n      (1, 0): (ACTION_MOVE_EAST, 1),   # Move East, face East\n      (0, 1): (ACTION_MOVE_SOUTH, 2),  # Move South, face South\n      (-1, 0): (ACTION_MOVE_WEST, 3)   # Move West, face West\n  }\n\n  # Map agent's internal direction ID to its corresponding (dx, dy) facing vector.\n  # This is used to determine what cell is directly \"in front\" of the agent for the USE action.\n  DIRECTION_TO_VECTOR = {\n      0: (0, -1),  # North (up)\n      1: (1, 0),   # East (right)\n      2: (0, 1),   # South (down)\n      3: (-1, 0)   # West (left)\n  }\n\n  # Get the current state information from the environment.\n  current_obs = env.observations()\n  # The global grid representation is needed to check cell contents (primitive, obstacles).\n  current_grid = current_obs['features_dict']['features_global']\n  # Agent's starting position (x, y) as a tuple of integers.\n  start_position = tuple(current_obs['features_dict']['pos'].astype(int))\n  # Agent's starting direction, converted from one-hot vector to an integer (0-3).\n  start_direction = np.argmax(current_obs['features_dict']['direction'])\n\n  # Extract grid dimensions.\n  grid_width, grid_height, _ = current_grid.shape\n  # Get indices of entities that block movement (e.g., water, stone if not breakable).\n  impassable_entity_indices = env.world.non_grabbable_indices\n\n  # --- Helper Functions for Grid and Movement Checks ---\n\n  def is_coordinate_valid(x, y):\n      \"\"\"Checks if a given (x, y) coordinate is within the grid boundaries.\"\"\"\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  def is_cell_passable(x, y):\n      \"\"\"Checks if the cell at (x, y) is traversable by the agent.\"\"\"\n      if not is_coordinate_valid(x, y):\n          return False # Outside grid is not passable.\n      # A cell is impassable if it contains any of the non-grabbable entities.\n      for entity_idx in impassable_entity_indices:\n          if current_grid[x, y, entity_idx] > 0:\n              return False # Cell contains an obstacle.\n      return True # Cell is clear and traversable.\n\n  # --- Breadth-First Search (BFS) for Pathfinding ---\n\n  # BFS queue: stores states to explore. A state is ((x, y), direction_id).\n  bfs_queue = collections.deque([(start_position, start_direction)])\n  # Set of visited states to prevent revisiting and cycles, ensuring shortest path.\n  visited_states = set([(start_position, start_direction)])\n  # Parent map: used to reconstruct the path after BFS.\n  # Maps child_state -> (parent_state, action_taken_to_reach_child).\n  path_reconstruction_map = {}\n\n  # This will store the state ((x, y), direction_id) from which the primitive can be collected.\n  target_collection_state = None\n\n  while bfs_queue:\n      (current_x, current_y), current_dir = bfs_queue.popleft()\n      current_bfs_state = ((current_x, current_y), current_dir)\n\n      # Check if the desired primitive is located in the cell directly in front of the agent.\n      dir_vector = DIRECTION_TO_VECTOR[current_dir]\n      front_x, front_y = current_x + dir_vector[0], current_y + dir_vector[1]\n\n      if is_coordinate_valid(front_x, front_y) and current_grid[front_x, front_y, primitive] > 0:\n          # The primitive is found! This is the goal state for our pathfinding.\n          target_collection_state = current_bfs_state\n          break # Exit BFS, as we found the shortest path to a valid collection point.\n\n      # Explore all possible movement actions from the current state.\n      for (dx, dy), (action_id, new_dir) in MOVE_ACTIONS_AND_DIRECTIONS.items():\n          next_x, next_y = current_x + dx, current_y + dy\n          next_position = (next_x, next_y)\n          next_bfs_state = (next_position, new_dir)\n\n          # Only proceed if the next cell is passable and the state hasn't been visited before.\n          if is_cell_passable(next_x, next_y) and next_bfs_state not in visited_states:\n              visited_states.add(next_bfs_state)\n              # Record the action taken to reach this new state from the current state.\n              path_reconstruction_map[next_bfs_state] = (current_bfs_state, action_id)\n              bfs_queue.append(next_bfs_state)\n\n  # --- Path Reconstruction ---\n\n  # If a path to the primitive was found:\n  if target_collection_state:\n      # The final action is always 'USE' to collect the primitive.\n      actions_to_primitive = [ACTION_USE]\n      current_state_in_path = target_collection_state\n\n      # Backtrack from the target state to the initial state using the parent map.\n      # The loop continues until we reach the original starting position and direction.\n      while current_state_in_path != (start_position, start_direction):\n          # Get the parent state and the action that led to current_state_in_path.\n          parent_state, action_from_parent = path_reconstruction_map[current_state_in_path]\n          actions_to_primitive.append(action_from_parent)\n          current_state_in_path = parent_state\n      \n      # The actions were collected in reverse order (from goal to start), so reverse the list.\n      return actions_to_primitive[::-1]\n  else:\n      # If the BFS completed without finding the primitive (queue became empty), return an empty list.\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:34:41.153807", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:34:42.130886", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n  # numpy is already available due to its prior import in the file's global scope.\n\n  # Define actions based on CraftLab.action_specs() mapping:\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  # Agent directions (matches CraftState.dir attribute: 0=East, 1=South, 2=West, 3=North)\n  DIR_EAST = 0\n  DIR_SOUTH = 1\n  DIR_WEST = 2\n  DIR_NORTH = 3\n\n  # Mapping of a target's relative coordinates (dy, dx) from the agent to the\n  # required agent facing direction for the ACTION_USE to be effective.\n  # This assumes ACTION_USE applies to the immediately adjacent cell in the facing direction.\n  RELATIVE_TO_REQUIRED_DIR = {\n      (0, 1): DIR_EAST,   # Target: East (dx=+1); Agent must face East.\n      (1, 0): DIR_SOUTH,  # Target: South (dy=+1); Agent must face South.\n      (0, -1): DIR_WEST,  # Target: West (dx=-1); Agent must face West.\n      (-1, 0): DIR_NORTH  # Target: North (dy=-1); Agent must face North.\n  }\n\n  # Mapping of movement actions to (dy, dx, resulting_direction_after_move).\n  # The resulting direction is the orientation of the agent after performing the move.\n  MOVEMENT_ACTIONS = {\n      Action.UP:    (-1, 0, DIR_NORTH),  # Move North (dy=-1), agent faces North.\n      Action.DOWN:  (1, 0, DIR_SOUTH),   # Move South (dy=+1), agent faces South.\n      Action.LEFT:  (0, -1, DIR_WEST),   # Move West (dx=-1), agent faces West.\n      Action.RIGHT: (0, 1, DIR_EAST)     # Move East (dx=+1), agent faces East.\n  }\n\n  MAX_COLLECT_STEPS = 100 # Maximum number of actions allowed for collection, including movements and the final USE.\n\n  # --- Initial State & Goal Checks ---\n  current_state = env._current_state\n  world = current_state.world\n\n  # 1. Validate if the `primitive` is a recognized entity kind in the world's cookbook.\n  if primitive not in world.cookbook.kinds:\n      return []\n\n  # 2. Crucially, the primitive must be a 'grabbable' item to be collected via ACTION_USE\n  # and subsequently appear in the agent's inventory. If it's a non-grabbable entity\n  # (like a wall, water, or a non-interactable structure), 'collect' is not applicable.\n  if primitive not in world.grabbable_indices:\n      return []\n\n  # 3. Optimization: If the `primitive` is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # --- Environment Data Extraction ---\n  # Use the global grid view for comprehensive pathfinding.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, n_kinds = full_grid.shape # Get total number of kinds for bounds checking\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir\n\n  # Determine which entity kinds are impassable for agent movement.\n  # Agent cannot move into cells containing these kinds.\n  impassable_for_movement = set()\n  \n  # Water is typically impassable for agent movement.\n  if world.water_index in world.cookbook.kinds:\n      impassable_for_movement.add(world.water_index)\n  \n  # Non-grabbable entities that are *not* workshops are usually impassable.\n  # Workshops (e.g., workbench, furnace) are often traversable even if non-grabbable.\n  for k_idx in world.non_grabbable_indices:\n      if k_idx not in world.workshop_indices:\n          impassable_for_movement.add(k_idx)\n  \n  # Pre-compute all locations of the target primitive on the grid for quick lookup during BFS.\n  primitive_locations = set()\n  for y in range(grid_height):\n      for x in range(grid_width):\n          if full_grid[y, x, primitive] > 0:\n              primitive_locations.add((y, x))\n\n  # If the primitive is not present anywhere on the grid, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # --- BFS Setup ---\n  q = collections.deque()\n  # BFS queue state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  # The agent's direction (curr_dir) is crucial because ACTION_USE depends on agent orientation.\n  q.append((start_y, start_x, start_dir, []))\n\n  # `visited` set tracks (y, x, direction) states to avoid redundant exploration and cycles.\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None  # This will store the final sequence of actions if a valid path is found.\n\n  # --- Breadth-First Search (BFS) Algorithm ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Pruning: If the current path length already equals or exceeds MAX_COLLECT_STEPS,\n      # this path (or any further extension of it) cannot be a valid solution within limits.\n      # We check `len(path)` here because the final `ACTION_USE` will add one more step.\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # 1. Check if the primitive can be collected from the current (y, x, dir) state.\n      # Iterate through all cardinal relative positions where the primitive could be,\n      # and check if the agent is currently facing the required direction to USE it.\n      for (rel_dy, rel_dx), required_dir in RELATIVE_TO_REQUIRED_DIR.items():\n          adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n          # Check if the adjacent cell is within grid boundaries, contains the primitive,\n          # and the agent is currently facing the correct direction.\n          if (0 <= adj_y < grid_height and 0 <= adj_x < grid_width and\n              (adj_y, adj_x) in primitive_locations and\n              curr_dir == required_dir):\n              \n              candidate_path = path + [Action.USE]\n\n              # Ensure the complete path (including the final ACTION_USE) is within the step limit.\n              if len(candidate_path) <= MAX_COLLECT_STEPS:\n                  path_to_execute = candidate_path\n                  break # Found the shortest path to collection, exit the inner loop.\n      \n      if path_to_execute: # If a valid path was found and assigned, break the outer BFS loop too.\n          break\n\n      # 2. Explore all possible next states by trying each movement action from the current state.\n      for action_move, (dy_move, dx_move, new_dir_after_move) in MOVEMENT_ACTIONS.items():\n          next_y, next_x = curr_y + dy_move, curr_x + dx_move\n          next_state_tuple = (next_y, next_x, new_dir_after_move)\n\n          # Pruning: If performing this move makes the path too long (considering potential final USE).\n          if len(path) + 1 >= MAX_COLLECT_STEPS: # +1 for the movement action itself\n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable based on `impassable_for_movement`.\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              # Ensure `k_idx` is within the bounds of the grid's kind dimension\n              if k_idx < n_kinds and full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # Check if this new state (position + orientation) has already been visited.\n          if next_state_tuple in visited:\n              continue\n\n          # If all checks pass, add the new state to the queue for further exploration.\n          visited.add(next_state_tuple)\n          q.append((next_y, next_x, new_dir_after_move, path + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      # If no valid path to collect the primitive was found within the step limits.\n      return []\n\n  actions_executed = []\n  for action in path_to_execute:\n      # If the primitive is already collected mid-execution, stop and return.\n      # This can happen in dynamic environments or if multiple items are collected by one USE.\n      if current_state.inventory[primitive] > 0:\n          break\n\n      actions_executed.append(action)\n      \n      # Perform the action in the environment and update the current state.\n      _, done, _ = env.step(action)\n      current_state = env._current_state\n\n      # If the episode terminates prematurely and the primitive is not collected, the path failed.\n      if done and current_state.inventory[primitive] <= 0:\n          return [] # Episode ended, but the collection goal was not satisfied.\n\n  # Final check: After executing all planned actions, confirm the primitive was collected.\n  if current_state.inventory[primitive] > 0:\n      return actions_executed\n  else:\n      # This case should ideally not be reached if the BFS found a valid path and the\n      # environment mechanics are consistent. It might indicate dynamic changes in the\n      # environment (e.g., primitive disappeared) or a mismatch in simulation.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:35:56.556418", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants, derived from CraftLab.action_specs()\n  ACTION_MOVE_DOWN = 0\n  ACTION_MOVE_UP = 1\n  ACTION_MOVE_LEFT = 2\n  ACTION_MOVE_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement vectors (dx, dy) to their corresponding action ID.\n  # These actions not only move the agent but also set its facing direction.\n  MOVE_VECTOR_TO_ACTION = {\n      (0, -1): ACTION_MOVE_UP,    # Moving North (y decreases)\n      (0, 1): ACTION_MOVE_DOWN,   # Moving South (y increases)\n      (-1, 0): ACTION_MOVE_LEFT,  # Moving West (x decreases)\n      (1, 0): ACTION_MOVE_RIGHT   # Moving East (x increases)\n  }\n\n  # Map movement vectors to the resulting agent direction ID after the move.\n  # The agent's internal direction ID mapping is: 0: North (-Y), 1: East (+X), 2: South (+Y), 3: West (-X).\n  # This is crucial for correctly tracking agent orientation for the USE action.\n  MOVE_VECTOR_TO_DIRECTION_ID = {\n      (0, -1): 0,  # Moving North results in facing North (dir ID 0)\n      (1, 0): 1,   # Moving East results in facing East (dir ID 1)\n      (0, 1): 2,   # Moving South results in facing South (dir ID 2)\n      (-1, 0): 3   # Moving West results in facing West (dir ID 3)\n  }\n\n  # Map agent's internal direction ID to its corresponding (dx, dy) facing vector.\n  # Used to determine the cell \"in front\" of the agent for interaction.\n  DIRECTION_ID_TO_VECTOR = {\n      0: (0, -1),  # North (upwards on a typical grid display)\n      1: (1, 0),   # East (rightwards)\n      2: (0, 1),   # South (downwards)\n      3: (-1, 0)   # West (leftwards)\n  }\n\n  # Get current state information from the environment.\n  initial_obs = env.observations()\n  # The global grid gives the layout of all entities.\n  current_grid_state = initial_obs['features_dict']['features_global']\n  # Agent's starting position (x, y) as integer tuple.\n  initial_agent_pos = tuple(initial_obs['features_dict']['pos'].astype(int))\n  # Agent's starting direction, converted from one-hot vector to an integer (0-3).\n  initial_agent_dir = np.argmax(initial_obs['features_dict']['direction'])\n\n  # Extract grid dimensions for boundary checks.\n  grid_width, grid_height, _ = current_grid_state.shape\n  # Get indices of entities that are obstacles and cannot be traversed.\n  impassable_entity_indices = env.world.non_grabbable_indices\n\n  # --- Helper Functions ---\n\n  def is_within_bounds(x, y):\n      \"\"\"Checks if a given (x, y) coordinate is within the grid boundaries.\"\"\"\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  def is_cell_traversable(x, y):\n      \"\"\"Checks if the cell at (x, y) is traversable by the agent.\"\"\"\n      if not is_within_bounds(x, y):\n          return False # Coordinates outside bounds are not traversable.\n      # A cell is impassable if it contains any of the non-grabbable entities.\n      for entity_idx in impassable_entity_indices:\n          if current_grid_state[x, y, entity_idx] > 0:\n              return False # Cell contains an obstacle.\n      return True # Cell is clear for movement.\n\n  # --- Breadth-First Search (BFS) for Pathfinding ---\n\n  # BFS state: ((x, y), direction_id) - both position and orientation matter for the 'USE' action.\n  # Queue for BFS: stores states to explore.\n  bfs_queue = collections.deque([(initial_agent_pos, initial_agent_dir)])\n  # Set of visited states to prevent cycles and redundant exploration, ensuring shortest path.\n  visited_states = set([(initial_agent_pos, initial_agent_dir)])\n  # Parent map: (child_state) -> ((parent_state), action_taken_to_reach_child)\n  # This allows reconstruction of the path.\n  path_reconstruction_map = {}\n\n  # This will store the final state from which the primitive can be collected (i.e., immediately\n  # before the 'USE' action).\n  goal_collection_state = None\n\n  while bfs_queue:\n      (current_x, current_y), current_dir = bfs_queue.popleft()\n      current_bfs_state = ((current_x, current_y), current_dir)\n\n      # Check if the desired primitive is located in the cell directly in front of the agent\n      # from the current position and direction.\n      facing_vector = DIRECTION_ID_TO_VECTOR[current_dir]\n      front_x, front_y = current_x + facing_vector[0], current_y + facing_vector[1]\n\n      if is_within_bounds(front_x, front_y) and current_grid_state[front_x, front_y, primitive] > 0:\n          # The primitive is found! This `current_bfs_state` is where the agent needs to be\n          # to apply the `USE` action.\n          goal_collection_state = current_bfs_state\n          break # Exit BFS, as we found the shortest path to a valid collection point.\n\n      # Explore all possible movement actions from the current state.\n      for move_vec, move_action in MOVE_VECTOR_TO_ACTION.items():\n          next_x, next_y = current_x + move_vec[0], current_y + move_vec[1]\n          # The new direction is determined by the direction of the move.\n          next_dir = MOVE_VECTOR_TO_DIRECTION_ID[move_vec]\n          next_agent_pos = (next_x, next_y)\n          next_bfs_state = (next_agent_pos, next_dir)\n\n          # Only proceed if the next cell is traversable and this state hasn't been visited.\n          if is_cell_traversable(next_x, next_y) and next_bfs_state not in visited_states:\n              visited_states.add(next_bfs_state)\n              # Record the action taken to reach this new state from the current state.\n              path_reconstruction_map[next_bfs_state] = (current_bfs_state, move_action)\n              bfs_queue.append(next_bfs_state)\n\n  # --- Path Reconstruction ---\n\n  # If a path to the primitive collection point was found:\n  if goal_collection_state:\n      # The last action to collect the primitive is always 'USE'.\n      actions_sequence = [ACTION_USE]\n      current_state_in_path_reconstruction = goal_collection_state\n\n      # Backtrack from the goal state to the initial state using the parent map.\n      # The loop continues until we reach the original starting position and direction.\n      while current_state_in_path_reconstruction != (initial_agent_pos, initial_agent_dir):\n          # Get the parent state and the action that led to current_state_in_path_reconstruction.\n          parent_state, action_from_parent = path_reconstruction_map[current_state_in_path_reconstruction]\n          actions_sequence.append(action_from_parent)\n          current_state_in_path_reconstruction = parent_state\n      \n      # The actions were collected in reverse order (from goal to start), so reverse the list.\n      return actions_sequence[::-1]\n  else:\n      # If the BFS completed without finding the primitive (queue became empty),\n      # it means the primitive is unreachable. Return an empty list of actions.\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:35:57.543411", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # --- Constants for actions and directions ---\n  # Action IDs (from env.action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Maps movement vectors (dx, dy) to the corresponding action ID.\n  # These actions move the agent and also implicitly set its facing direction\n  # based on the direction of movement.\n  MOVE_VEC_TO_ACTION = {\n      (0, -1): ACTION_UP,    # Move North (along -Y axis) using UP action\n      (0, 1): ACTION_DOWN,   # Move South (along +Y axis) using DOWN action\n      (-1, 0): ACTION_LEFT,  # Move West (along -X axis) using LEFT action\n      (1, 0): ACTION_RIGHT   # Move East (along +X axis) using RIGHT action\n  }\n\n  # Maps agent's internal direction ID to its corresponding (dx, dy) facing vector.\n  # Direction ID mapping: 0: North (-Y), 1: East (+X), 2: South (+Y), 3: West (-X).\n  DIR_ID_TO_VEC = {\n      0: (0, -1),  # Facing North\n      1: (1, 0),   # Facing East\n      2: (0, 1),   # Facing South\n      3: (-1, 0)   # Facing West\n  }\n\n  # Maps a movement vector (dx, dy) to the internal direction ID the agent will face\n  # after completing that move. This ensures the agent's internal direction state\n  # correctly reflects its orientation after a movement action.\n  MOVE_VEC_TO_DIR_ID = {\n      (0, -1): 0,  # Moving North results in facing North\n      (1, 0): 1,   # Moving East results in facing East\n      (0, 1): 2,   # Moving South results in facing South\n      (-1, 0): 3   # Moving West results in facing West\n  }\n\n  # --- Extract initial state information from the environment ---\n  initial_obs = env.observations()\n  # The global grid representation is needed to check cell contents (primitive, obstacles).\n  initial_grid = initial_obs['features_dict']['features_global']\n  # Agent's starting position (x, y) as a tuple of integers for consistent hashing in sets/dicts.\n  initial_pos = tuple(initial_obs['features_dict']['pos'].astype(int))\n  # Agent's starting direction, converted from one-hot vector to an integer ID (0-3).\n  initial_dir = np.argmax(initial_obs['features_dict']['direction'])\n\n  # Determine grid dimensions (grid is typically WIDTH x HEIGHT x N_KINDS).\n  grid_width, grid_height, _ = initial_grid.shape\n  # Get indices of entities that cannot be picked up or moved through (obstacles).\n  impassable_entity_indices = env.world.non_grabbable_indices\n\n  # --- Helper functions for grid and movement checks ---\n\n  def _is_valid_coord(x, y):\n      \"\"\"Checks if a given (x, y) coordinate is within the grid boundaries.\"\"\"\n      return 0 <= x < grid_width and 0 <= y < grid_height\n\n  def _is_traversable(x, y, grid_data):\n      \"\"\"Checks if the cell at (x, y) is traversable by the agent.\n      A cell is considered impassable if it's out of bounds or contains any non-grabbable entity.\n      \"\"\"\n      if not _is_valid_coord(x, y):\n          return False # Coordinate is outside the grid\n      # Check if the cell contains any entity that blocks movement\n      for entity_idx in impassable_entity_indices:\n          if grid_data[x, y, entity_idx] > 0:\n              return False # Cell contains an obstacle\n      return True # Cell is clear and traversable\n\n  # --- Breadth-First Search (BFS) for pathfinding ---\n\n  # BFS queue: stores states to explore. A state is represented as (position_tuple, direction_id).\n  bfs_queue = collections.deque([(initial_pos, initial_dir)])\n  # Set of visited states to prevent revisiting and cycles, ensuring the shortest path.\n  visited_states = set([(initial_pos, initial_dir)])\n  # Parent map: used to reconstruct the path after BFS.\n  # Maps child_state -> (parent_state, action_taken_to_reach_child).\n  parent_path_map = {}\n\n  # This variable will store the state (position, direction) from which the\n  # primitive can be collected (i.e., it is directly in front of the agent).\n  collection_ready_state = None\n\n  while bfs_queue:\n      current_pos, current_dir = bfs_queue.popleft()\n      current_bfs_state = (current_pos, current_dir)\n\n      # Determine the coordinates of the cell directly in front of the agent\n      facing_vector = DIR_ID_TO_VEC[current_dir]\n      front_x, front_y = current_pos[0] + facing_vector[0], current_pos[1] + facing_vector[1]\n\n      # Check if the desired primitive is located in the cell directly in front.\n      if _is_valid_coord(front_x, front_y) and initial_grid[front_x, front_y, primitive] > 0:\n          # The primitive is found! This is the goal state for our pathfinding.\n          collection_ready_state = current_bfs_state\n          break # Exit BFS, as we found the shortest path to a valid collection point.\n\n      # Explore all possible movement actions from the current state.\n      for move_vector, action_id in MOVE_VEC_TO_ACTION.items():\n          next_x, next_y = current_pos[0] + move_vector[0], current_pos[1] + move_vector[1]\n          next_pos = (next_x, next_y)\n          # The agent's direction changes to match the direction of movement.\n          next_dir = MOVE_VEC_TO_DIR_ID[move_vector]\n          next_bfs_state = (next_pos, next_dir)\n\n          # Only proceed if the next cell is traversable and this state hasn't been visited before.\n          if _is_traversable(next_x, next_y, initial_grid) and next_bfs_state not in visited_states:\n              visited_states.add(next_bfs_state)\n              # Record the action taken to reach this new state from the current state.\n              parent_path_map[next_bfs_state] = (current_bfs_state, action_id)\n              bfs_queue.append(next_bfs_state)\n\n  # --- Path Reconstruction ---\n\n  # If a path to the primitive was found (i.e., a collection_ready_state was identified):\n  if collection_ready_state:\n      # The final action in the sequence is always 'USE' to collect the primitive.\n      actions_sequence = [ACTION_USE]\n      current_state_in_path = collection_ready_state\n\n      # Backtrack from the target collection-ready state to the initial state\n      # using the parent map. The loop continues until we reach the original\n      # starting position and direction.\n      while current_state_in_path != (initial_pos, initial_dir):\n          # Retrieve the parent state and the action that led to the current state.\n          parent_state, action_from_parent = parent_path_map[current_state_in_path]\n          actions_sequence.append(action_from_parent)\n          current_state_in_path = parent_state\n      \n      # The actions were collected in reverse order (from goal to start),\n      # so reverse the list to get the correct chronological sequence.\n      return actions_sequence[::-1]\n  else:\n      # If the BFS completed without finding the primitive (queue became empty),\n      # it means the primitive is unreachable. Return an empty list of actions.\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:37:54.377672", "function_name": "collect", "function_body": "    # Action constants, as per problem description\n    _ACTION_DOWN = 0\n    _ACTION_UP = 1\n    _ACTION_LEFT = 2\n    _ACTION_RIGHT = 3\n    _ACTION_USE = 4\n\n    # 1. Get current state observations\n    obs = env.observations()\n    features_dict = obs['features_dict']\n    \n    current_grid = features_dict['features_global']\n    # Convert normalized numpy array position to integer tuple (r, c)\n    current_pos = tuple(int(x) for x in features_dict['pos'])\n    current_inventory = features_dict['inventory']\n\n    # 2. Check if primitive is already collected\n    if current_inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    grid_height, grid_width, _ = current_grid.shape\n\n    # Access CraftWorld and Cookbook from the CraftLab environment\n    world = env.world\n    \n    # Define permanent obstacles (things that generally block movement)\n    # This includes non-grabbable items and workshops.\n    permanent_obstacles = world.non_grabbable_indices.union(world.workshop_indices)\n\n    def is_traversable(r, c, target_primitive_index):\n        \"\"\"\n        Checks if a cell (r, c) is traversable for the agent.\n        A cell is not traversable if it's out of bounds or contains a blocking item.\n        A blocking item is any item in `permanent_obstacles`, UNLESS it's the `target_primitive_index`\n        and the target primitive is grabbable (meaning you can walk onto it).\n        \"\"\"\n        if not (0 <= r < grid_height and 0 <= c < grid_width):\n            return False # Out of bounds\n        \n        # Get all kinds (items/entities) present at this cell (r,c)\n        cell_kinds_present = np.where(current_grid[r, c] > 0)[0]\n\n        for kind_idx in cell_kinds_present:\n            if kind_idx == target_primitive_index:\n                # If the cell contains the target primitive\n                if target_primitive_index in world.grabbable_indices:\n                    # If the target primitive is grabbable, we can walk onto its cell.\n                    # It's not an obstacle in this case. Continue checking for other obstacles.\n                    continue\n                else:\n                    # If the target primitive is non-grabbable (e.g., a tree to be chopped),\n                    # we cannot walk onto its cell. It is an obstacle.\n                    return False\n            \n            # If it's any other kind that is a permanent obstacle, this cell is blocked.\n            if kind_idx in permanent_obstacles:\n                return False # Blocking obstacle present\n        \n        return True # No blocking items found, cell is traversable\n\n    # 3. Find all locations of the primitive on the grid\n    primitive_locations = []\n    for r_scan in range(grid_height):\n        for c_scan in range(grid_width):\n            if current_grid[r_scan, c_scan, primitive] > 0:\n                primitive_locations.append((r_scan, c_scan))\n    \n    if not primitive_locations:\n        return [] # Primitive not found on the map, cannot collect\n\n    is_primitive_grabbable = primitive in world.grabbable_indices\n\n    # 4. BFS to find the shortest path to a collectable position\n    queue = collections.deque([(current_pos, [])]) # (current_position, actions_taken_to_reach_here)\n    visited = {current_pos}\n\n    # Movement deltas and corresponding actions\n    # (dr, dc) -> action\n    moves = {\n        (-1, 0): _ACTION_UP,    # Move North\n        (1, 0): _ACTION_DOWN,   # Move South\n        (0, -1): _ACTION_LEFT,  # Move West\n        (0, 1): _ACTION_RIGHT,  # Move East\n    }\n\n    while queue:\n        (r, c), path_actions = queue.popleft()\n\n        # Check if the current position (r, c) allows collecting the primitive\n        can_collect_from_here = False\n\n        if is_primitive_grabbable:\n            # If the primitive is grabbable, we need to be on its cell to pick it up.\n            if current_grid[r, c, primitive] > 0:\n                can_collect_from_here = True\n        else:\n            # If the primitive is non-grabbable, we need to be adjacent to it\n            # (within a 3x3 neighborhood, excluding the primitive's exact cell).\n            for pr, pc in primitive_locations:\n                # Check for adjacency: Manhattan distance 1 or diagonal, but not the same spot\n                if abs(r - pr) <= 1 and abs(c - pc) <= 1 and (r, c) != (pr, pc):\n                    can_collect_from_here = True\n                    break\n        \n        if can_collect_from_here:\n            # Found a position from which the primitive can be collected.\n            # Append the USE action and return the complete action path.\n            return path_actions + [_ACTION_USE]\n\n        # Explore neighbors\n        for (dr, dc), action in moves.items():\n            nr, nc = r + dr, c + dc\n            \n            if is_traversable(nr, nc, primitive) and (nr, nc) not in visited:\n                visited.add((nr, nc))\n                queue.append(((nr, nc), path_actions + [action]))\n    \n    # If the BFS completes and no path was found to any collectable position,\n    # the primitive is deemed unreachable from the current state.\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:37:55.351497", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from CraftLab.action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map action to its corresponding (dr, dc) move delta\n  ACTION_TO_MOVE_DELTA = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  actions_to_return = []\n\n  # Get the current state information from the environment\n  obs = env.observations()\n  # `features_global` gives the full grid view\n  current_grid = obs['features_dict']['features_global']\n  # `pos` gives the agent's current (row, col) position\n  current_pos = tuple(obs['features_dict']['pos'].astype(int))\n\n  grid_height, grid_width, _ = current_grid.shape\n\n  def is_valid(r, c):\n      \"\"\"Checks if a given (row, column) is within grid boundaries.\"\"\"\n      return 0 <= r < grid_height and 0 <= c < grid_width\n\n  # 1. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for r in range(grid_height):\n      for c in range(grid_width):\n          if current_grid[r, c, primitive] == 1:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      # If the primitive is not found anywhere, no actions can be taken to collect it\n      return []\n\n  # 2. Determine all \"target agent positions\" where the agent can perform a USE action.\n  # Based on the description of CraftState.next_to, we assume USE works if the primitive\n  # is in the 3x3 neighborhood (including the agent's current cell if primitive is there).\n  target_agent_positions = set()\n  for pr, pc in primitive_locations:\n      # Iterate over 3x3 neighborhood around the primitive location\n      for dr_offset in [-1, 0, 1]:\n          for dc_offset in [-1, 0, 1]:\n              ar, ac = pr + dr_offset, pc + dc_offset\n              if is_valid(ar, ac):\n                  target_agent_positions.add((ar, ac))\n\n  # 3. Use Breadth-First Search (BFS) to find the shortest path from the agent's\n  # current position to any of the valid `target_agent_positions`.\n  q = collections.deque([(current_pos, [])]) # (agent_pos, list_of_actions_taken)\n  visited = {current_pos} # Set of visited (row, col) positions\n\n  best_path_to_primitive_area = None\n\n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # If the current position is one of the target agent positions, we found a path\n      if (r, c) in target_agent_positions:\n          best_path_to_primitive_area = path_so_far\n          break # Found the shortest path, no need to explore further\n\n      # Explore neighboring cells\n      for move_action, (dr, dc) in ACTION_TO_MOVE_DELTA.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          if is_valid(next_r, next_c) and next_pos not in visited:\n              visited.add(next_pos)\n              q.append((next_pos, path_so_far + [move_action]))\n\n  if best_path_to_primitive_area is None:\n      # No path found to any cell from which the primitive can be collected\n      return []\n\n  # 4. Once a path to a suitable position is found, append the USE action\n  actions_to_return.extend(best_path_to_primitive_area)\n  actions_to_return.append(USE)\n\n  return actions_to_return", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:39:30.093337", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants (standard for CraftWorld environment)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Map (dx, dy) to action for navigation\n    _DELTAS_TO_ACTIONS = {\n        (0, 1): ACTION_DOWN,\n        (0, -1): ACTION_UP,\n        (-1, 0): ACTION_LEFT,\n        (1, 0): ACTION_RIGHT,\n    }\n\n    actions = []\n\n    # 1. Get current state information from the environment\n    obs = env.observations()\n    # The 'pos' is typically (x, y) coordinates of the agent.\n    # Convert to tuple for hashing in visited set.\n    current_pos = tuple(obs['features_dict']['pos'].astype(int))\n    \n    # Get the global grid view (allocentric map of the world)\n    grid = obs['features_dict']['features_global']\n    WIDTH, HEIGHT, _ = grid.shape\n\n    # Get non-grabbable indices from the world instance, which defines impassable terrain\n    # This assumes env.world is a CraftWorld instance with the non_grabbable_indices attribute.\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # 2. Find the closest location of the target primitive\n    # np.argwhere returns (row, col) which corresponds to (y, x) if grid is (rows, cols)\n    # However, common numpy array indexing for spatial data is (height, width) or (y, x).\n    # Assuming (WIDTH, HEIGHT) implies (x, y) in grid indexing here to match (dx, dy) logic.\n    # If the grid is indexed (y, x), then `p_loc[0]` is y and `p_loc[1]` is x.\n    # Let's assume grid[:,:,primitive] is (x, y) indexed based on common game grid usage.\n    primitive_locs = np.argwhere(grid[:, :, primitive] == 1)\n\n    if len(primitive_locs) == 0:\n        return [] # Primitive not found anywhere in the environment\n\n    # Find the closest primitive location using Manhattan distance\n    target_primitive_pos = None\n    min_dist = float('inf')\n\n    for p_loc in primitive_locs:\n        # p_loc is a numpy array [x, y], convert to tuple for consistent handling\n        p_loc_tuple = tuple(p_loc)\n        dist = abs(current_pos[0] - p_loc_tuple[0]) + abs(current_pos[1] - p_loc_tuple[1])\n        if dist < min_dist:\n            min_dist = dist\n            target_primitive_pos = p_loc_tuple \n\n    if target_primitive_pos is None:\n        # This case should ideally not be reached if primitive_locs was not empty,\n        # but included for robustness.\n        return []\n\n    # 3. Perform a Breadth-First Search (BFS) to find the shortest path\n    # The queue stores tuples: (current_coordinates, list_of_actions_to_reach_here)\n    queue = collections.deque([(current_pos, [])])\n    visited = {current_pos} # Set to keep track of visited coordinates to avoid cycles\n\n    path_to_target = [] # This will store the sequence of actions if a path is found\n\n    while queue:\n        curr_coord, current_actions = queue.popleft()\n\n        # If we have reached the target primitive's location\n        if curr_coord == target_primitive_pos:\n            path_to_target = current_actions\n            break # Path found, exit BFS\n\n        # Explore all 4 possible neighboring cells (Up, Down, Left, Right)\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # (dx, dy) for Left, Right, Up, Down respectively\n            next_x, next_y = curr_coord[0] + dx, curr_coord[1] + dy\n            next_coord = (next_x, next_y)\n            action_to_take = _DELTAS_TO_ACTIONS.get((dx, dy))\n\n            # Check if the next_coord is within grid boundaries\n            if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                continue\n\n            # Check if the next_coord has already been visited\n            if next_coord in visited:\n                continue\n\n            # Check if the next_coord is traversable (does not contain non-grabbable items)\n            is_traversable_cell = True\n            for idx in non_grabbable_indices:\n                if grid[next_x, next_y, idx] == 1:\n                    is_traversable_cell = False\n                    break\n            \n            if is_traversable_cell:\n                visited.add(next_coord) # Mark as visited\n                # Add the next_coord and the updated list of actions to the queue\n                queue.append((next_coord, current_actions + [action_to_take]))\n\n    # If no path was found to the target primitive, and it's not at the current location\n    if not path_to_target and current_pos != target_primitive_pos:\n        return [] # Primitive is unreachable\n\n    # 4. Append the USE action after all movement actions\n    # This assumes that once the agent reaches the primitive's cell, a single USE action\n    # is sufficient to collect it.\n    actions.extend(path_to_target)\n    actions.append(ACTION_USE)\n\n    return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:39:30.165493", "function_name": "collect", "function_body": "    actions_taken = []\n\n    # Get action mappings from the environment\n    action_map = env.action_specs()\n    ACTION_DOWN = action_map['DOWN']\n    ACTION_UP = action_map['UP']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_USE = action_map['USE']\n\n    # Reset environment to get initial state.\n    # We don't directly use the returned observations here, as _current_state is more direct.\n    _ = env.reset()\n\n    # Use max_steps from the environment (if available) to prevent infinite loops,\n    # otherwise set a reasonable default.\n    MAX_COLLECT_STEPS_DEFAULT = 200\n    max_steps_allowed = env.max_steps if hasattr(env, 'max_steps') and env.max_steps else MAX_COLLECT_STEPS_DEFAULT\n\n    for step_count in range(max_steps_allowed):\n        current_state = env._current_state\n\n        # 1. Check if the primitive is already collected\n        if current_state.inventory[primitive] > 0:\n            break # Goal achieved, exit loop\n\n        # 2. Check if the agent is next to the primitive and can use it\n        if current_state.next_to(primitive):\n            action = ACTION_USE\n            reward, done, _ = env.step(action)\n            actions_taken.append(action)\n\n            # Re-check inventory after attempting USE action.\n            # If collected or environment is done (e.g., max_steps reached), break.\n            if current_state.inventory[primitive] > 0 or done:\n                break\n            continue # If not collected but USE action was taken (e.g., used a workshop), re-evaluate state\n\n        # 3. If not next to the primitive, find it on the grid and move towards it\n        current_x, current_y = current_state.pos\n        grid = current_state.grid\n        # grid.shape is (WIDTH, HEIGHT, n_kinds) as per problem description\n        grid_width, grid_height, _ = grid.shape\n\n        primitive_locations = []\n        # Iterate through the grid to find all instances of the primitive\n        for x in range(grid_width): # x corresponds to column index\n            for y in range(grid_height): # y corresponds to row index\n                if grid[x, y, primitive] > 0: # Check if this primitive kind exists at (x,y)\n                    primitive_locations.append((x, y))\n\n        if not primitive_locations:\n            # Primitive not found anywhere on the map.\n            # In a collect task, this usually implies failure or the item is no longer present.\n            return [] # Indicate failure to find/collect\n\n        # Find the closest primitive location using Manhattan distance\n        closest_target = None\n        min_dist = float('inf')\n        for tx, ty in primitive_locations:\n            dist = abs(tx - current_x) + abs(ty - current_y)\n            if dist < min_dist:\n                min_dist = dist\n                closest_target = (tx, ty)\n\n        # Determine the best single movement action towards the closest target\n        target_x, target_y = closest_target\n\n        action_to_take = -1\n        dx = target_x - current_x\n        dy = target_y - current_y\n\n        # Prioritize movement along the axis with the greater absolute difference.\n        # This simple greedy approach helps progress faster in one direction.\n        if abs(dx) >= abs(dy) and dx != 0:\n            if dx < 0:\n                action_to_take = ACTION_LEFT\n            else: # dx > 0\n                action_to_take = ACTION_RIGHT\n        elif dy != 0: # Only consider Y movement if X difference is zero or smaller\n            if dy < 0:\n                action_to_take = ACTION_UP # Smaller y-coordinate means moving \"up\" on the grid\n            else: # dy > 0\n                action_to_take = ACTION_DOWN # Larger y-coordinate means moving \"down\" on the grid\n        else:\n            # This case implies dx=0 and dy=0, meaning current_pos == closest_target.\n            # This should theoretically be caught by `current_state.next_to(primitive)` and lead to `ACTION_USE`.\n            # If we reach here, it suggests the primitive is at the current position but cannot be interacted with,\n            # or there's an unforeseen obstacle/condition.\n            return actions_taken # Indicate failure to make progress\n\n        # Perform the chosen movement action\n        reward, done, _ = env.step(action_to_take)\n        actions_taken.append(action_to_take)\n\n        if done:\n            # Environment terminated before collection (e.g., max_steps reached or task failed)\n            break\n\n    # Final check after the loop finishes (either collected or max_steps reached)\n    if current_state.inventory[primitive] > 0:\n        return actions_taken\n    else:\n        return [] # Failed to collect the primitive", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:40:47.591338", "function_name": "collect", "function_body": "  import collections\n\n  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Define internal direction indices based on the order expected for agent's direction:\n  # Assuming 0: Down (South), 1: Up (North), 2: Left (West), 3: Right (East)\n  # This mapping is derived from how `features_dict['direction']` one-hot array works\n  # and how movement actions typically affect facing.\n  _DIR_DOWN = 0\n  _DIR_UP = 1\n  _DIR_LEFT = 2\n  _DIR_RIGHT = 3\n\n  # Mapping from a movement action_id to the resulting agent facing direction.\n  # Taking action _UP makes the agent face _DIR_UP.\n  action_to_new_dir = {\n      _UP: _DIR_UP,\n      _DOWN: _DIR_DOWN,\n      _LEFT: _DIR_LEFT,\n      _RIGHT: _DIR_RIGHT,\n  }\n\n  # Mapping from internal direction integer to (dx, dy) for the cell *moved into* by that direction,\n  # AND for the cell *in front* of the agent when facing that direction.\n  # (0,0) is top-left. positive X is right, positive Y is down.\n  dir_to_delta = {\n      _DIR_DOWN: (0, 1),   # Agent moves/faces Down: Y increases by 1\n      _DIR_UP: (0, -1),    # Agent moves/faces Up: Y decreases by 1\n      _DIR_LEFT: (-1, 0),  # Agent moves/faces Left: X decreases by 1\n      _DIR_RIGHT: (1, 0),  # Agent moves/faces Right: X increases by 1\n  }\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario (or current grid shape)\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_px = int(round(features_dict['pos'][0] * (WIDTH - 1)))\n  current_py = int(round(features_dict['pos'][1] * (HEIGHT - 1)))\n\n  # Convert one-hot initial direction from features_dict to an integer index\n  initial_dir_idx = np.argmax(features_dict['direction'])\n\n  # Check if the primitive is grabbable. If not, it cannot be collected.\n  if primitive not in env.world.grabbable_indices:\n    return []\n\n  # Identify non-grabbable items that act as obstacles (cannot be moved into).\n  # Assuming any non-grabbable item acts as an obstacle that blocks movement.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item that blocks movement.\"\"\"\n    if not non_grabbable_items_set:\n        return False\n    for k_idx in non_grabbable_items_set:\n      if grid[x, y, k_idx] == 1:\n        return True\n    return False\n\n  # Use Breadth-First Search (BFS) to find the shortest path.\n  # Queue stores tuples: (current_x, current_y, current_direction_idx, [path_actions_to_reach_here])\n  q = collections.deque()\n  q.append((current_px, current_py, initial_dir_idx, []))\n  \n  # Set to store visited states to avoid cycles and re-processing longer paths.\n  # A state is defined by (x, y, direction_idx).\n  visited = {(current_px, current_py, initial_dir_idx)}\n\n  while q:\n    cx, cy, c_dir_idx, c_path = q.popleft()\n\n    # --- Goal Check 1: Primitive on the agent's current square ---\n    # If the primitive is on the agent's current square, and it's grabbable,\n    # it can often be collected directly with _USE, regardless of facing direction.\n    if current_grid[cx, cy, primitive] == 1:\n      return c_path + [_USE]\n\n    # --- Goal Check 2: Primitive in front of the agent (directional _USE) ---\n    # Calculate the coordinates of the cell directly in front of the agent.\n    facing_dx, facing_dy = dir_to_delta[c_dir_idx]\n    fx, fy = cx + facing_dx, cy + facing_dy\n\n    # Check boundaries for the cell in front\n    if (0 <= fx < WIDTH and 0 <= fy < HEIGHT):\n        # If the cell in front contains the primitive\n        if current_grid[fx, fy, primitive] == 1:\n            return c_path + [_USE] # Found a solution: path to position, then _USE.\n\n    # --- Explore Movement Actions (UP, DOWN, LEFT, RIGHT) ---\n    # Each movement action updates both position and facing direction.\n    for action_id, new_dir_idx in action_to_new_dir.items():\n      # Calculate new position: the agent moves one step in the direction implied by the action.\n      # The `dir_to_delta` mapping tells us the (dx, dy) for moving in a given direction.\n      move_dx, move_dy = dir_to_delta[new_dir_idx] \n      nx, ny = cx + move_dx, cy + move_dy\n\n      # Check validity: within bounds, not an obstacle, and not previously visited state\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n      if is_obstacle(nx, ny, current_grid, non_grabbable_indices):\n        continue\n      \n      # If this new state (position and direction) has not been visited\n      if (nx, ny, new_dir_idx) not in visited:\n        new_path = c_path + [action_id]\n        q.append((nx, ny, new_dir_idx, new_path))\n        visited.add((nx, ny, new_dir_idx))\n  \n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:40:48.599803", "function_name": "collect", "function_body": "  _actions_map = env.action_specs()\n  _DOWN = _actions_map['DOWN']\n  _UP = _actions_map['UP']\n  _LEFT = _actions_map['LEFT']\n  _RIGHT = _actions_map['RIGHT']\n  _USE = _actions_map['USE']\n\n  # Define internal direction indices based on the order expected for agent's direction:\n  # Assuming 0: Down (South), 1: Up (North), 2: Left (West), 3: Right (East)\n  _DIR_DOWN = 0\n  _DIR_UP = 1\n  _DIR_LEFT = 2\n  _DIR_RIGHT = 3\n\n  # Mapping from a movement action_id to the resulting agent facing direction.\n  # Taking action _UP makes the agent face _DIR_UP.\n  action_to_new_dir = {\n      _UP: _DIR_UP,\n      _DOWN: _DIR_DOWN,\n      _LEFT: _DIR_LEFT,\n      _RIGHT: _DIR_RIGHT,\n  }\n\n  # Mapping from internal direction integer to (dx, dy) for the cell *moved into* by that direction,\n  # AND for the cell *in front* of the agent when facing that direction.\n  # (0,0) is top-left. positive X is right, positive Y is down.\n  dir_to_delta = {\n      _DIR_DOWN: (0, 1),   # Agent moves/faces Down: Y increases by 1\n      _DIR_UP: (0, -1),    # Agent moves/faces Up: Y decreases by 1\n      _DIR_LEFT: (-1, 0),  # Agent moves/faces Left: X decreases by 1\n      _DIR_RIGHT: (1, 0),  # Agent moves/faces Right: X increases by 1\n  }\n\n  # Get current state information from the environment's observations\n  obs = env.observations()\n  features_dict = obs['features_dict']\n  \n  current_grid = features_dict['features_global'] # Full allocentric grid\n  \n  # Get grid dimensions from the scenario (CraftLab has a scenario attribute)\n  WIDTH, HEIGHT, _ = env.scenario.init_grid.shape\n\n  # Denormalize current agent position\n  current_pos_normalized = features_dict['pos']\n  current_px = int(round(current_pos_normalized[0] * (WIDTH - 1)))\n  current_py = int(round(current_pos_normalized[1] * (HEIGHT - 1)))\n\n  # Convert one-hot initial direction from features_dict to an integer index\n  initial_dir_idx = np.argmax(features_dict['direction'])\n\n  # Determine if the primitive is grabbable (picked up on same square)\n  # or minable/drawable (used directionally when adjacent).\n  is_grabbable = primitive in env.world.grabbable_indices\n  is_minable_drawable = (primitive == env.world.stone_index or \n                         primitive == env.world.water_index)\n\n  # If the primitive is not a known grabbable, minable, or drawable item, it cannot be collected.\n  if not is_grabbable and not is_minable_drawable:\n    return []\n\n  # Identify non-grabbable items that act as obstacles (cannot be moved into).\n  # This set typically includes workshop, stone, water, etc.\n  non_grabbable_items_set = env.world.non_grabbable_indices\n\n  def is_obstacle(x, y, grid, non_grabbable_items_set):\n    \"\"\"Checks if the cell (x,y) contains any non-grabbable item that blocks movement.\n    A cell is an obstacle if it contains any entity from the `non_grabbable_items_set`.\n    \"\"\"\n    if not non_grabbable_items_set:\n        return False\n    for k_idx in non_grabbable_items_set:\n        if grid[x, y, k_idx] == 1:\n            return True\n    return False\n\n  # Use Breadth-First Search (BFS) to find the shortest path.\n  # Queue stores tuples: (current_x, current_y, current_direction_idx, [path_actions_to_reach_here])\n  import collections # Ensure collections is imported\n  q = collections.deque()\n  q.append((current_px, current_py, initial_dir_idx, []))\n  \n  # Set to store visited states to avoid cycles and re-processing longer paths.\n  # A state is defined by (x, y, direction_idx).\n  visited = {(current_px, current_py, initial_dir_idx)}\n\n  while q:\n    cx, cy, c_dir_idx, c_path = q.popleft()\n\n    # --- Goal Check 1: Primitive on the agent's current square ---\n    # This applies if the item is grabbable (e.g., wood, iron ore)\n    if is_grabbable and current_grid[cx, cy, primitive] == 1:\n      return c_path + [_USE]\n\n    # --- Goal Check 2: Primitive in front of the agent (directional _USE) ---\n    # This applies if the item is minable/drawable (e.g., stone, water)\n    if is_minable_drawable:\n        # Calculate the coordinates of the cell directly in front of the agent.\n        facing_dx, facing_dy = dir_to_delta[c_dir_idx]\n        fx, fy = cx + facing_dx, cy + facing_dy\n\n        # Check boundaries for the cell in front\n        if (0 <= fx < WIDTH and 0 <= fy < HEIGHT):\n            # If the cell in front contains the primitive\n            if current_grid[fx, fy, primitive] == 1:\n                return c_path + [_USE] # Found a solution: path to position, then _USE.\n\n    # --- Explore Movement Actions (UP, DOWN, LEFT, RIGHT) ---\n    # Each movement action updates both position and facing direction.\n    for action_id, new_dir_idx in action_to_new_dir.items():\n      # Calculate new position: the agent moves one step in the direction implied by the action.\n      # The `dir_to_delta` mapping tells us the (dx, dy) for moving in a given direction.\n      move_dx, move_dy = dir_to_delta[new_dir_idx] # new_dir_idx is the direction after the move\n      nx, ny = cx + move_dx, cy + move_dy\n\n      # Check validity: within bounds, not an obstacle, and not previously visited state\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n      # Check for obstacle in the *new* cell (nx, ny)\n      if is_obstacle(nx, ny, current_grid, non_grabbable_items_set):\n        continue\n      \n      # If this new state (position and direction) has not been visited\n      if (nx, ny, new_dir_idx) not in visited:\n        new_path = c_path + [action_id]\n        q.append((nx, ny, new_dir_idx, new_path))\n        visited.add((nx, ny, new_dir_idx))\n  \n  # If the queue becomes empty and no path to collect the primitive was found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T00:42:32.283785", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  init_pos = current_state.pos\n  world = current_state.world\n\n  # Grid dimensions\n  WIDTH, HEIGHT, _ = grid.shape\n  NON_GRABBABLE_INDICES = world.non_grabbable_indices\n\n  # Define action constants (assuming these are defined at the module level)\n  # DOWN_ACTION = 0\n  # UP_ACTION = 1\n  # LEFT_ACTION = 2\n  # RIGHT_ACTION = 3\n  # USE_ACTION = 4\n\n  # Map movement actions to their (dr, dc) deltas (assuming module-level)\n  # ACTION_DELTAS = {\n  #     UP_ACTION: (-1, 0),\n  #     DOWN_ACTION: (1, 0),\n  #     LEFT_ACTION: (0, -1),\n  #     RIGHT_ACTION: (0, 1),\n  # }\n\n  # MOVEMENT_ACTIONS = [UP_ACTION, DOWN_ACTION, LEFT_ACTION, RIGHT_ACTION]\n\n  # Helper functions (assuming these are defined at the module level)\n  def _is_valid_pos(r, c, width, height):\n      \"\"\"Checks if a given (r, c) position is within grid boundaries.\"\"\"\n      return 0 <= r < width and 0 <= c < height\n\n  def _is_walkable(grid, r, c, non_grabbable_indices, width, height):\n      \"\"\"\n      Checks if a cell is walkable.\n      Assumes anything in non_grabbable_indices blocks movement.\n      \"\"\"\n      if not _is_valid_pos(r, c, width, height):\n          return False\n      \n      # Check if the cell contains any non-grabbable item that blocks movement\n      for idx in non_grabbable_indices:\n          if grid[r, c, idx] > 0:\n              return False \n      return True \n\n  def _is_next_to(grid, r_agent, c_agent, target_kind, width, height):\n      \"\"\"\n      Checks if any cell in the 3x3 neighborhood around (r_agent, c_agent)\n      contains the target_kind. This mimics CraftState.next_to logic.\n      \"\"\"\n      for dr in [-1, 0, 1]:\n          for dc in [-1, 0, 1]:\n              nr, nc = r_agent + dr, c_agent + dc\n              if _is_valid_pos(nr, nc, width, height):\n                  if grid[nr, nc, target_kind] > 0:\n                      return True\n      return False\n\n  # BFS for shortest path to a position where the primitive can be collected\n  q = collections.deque([(init_pos[0], init_pos[1], [])]) # (row, col, path_to_here)\n  visited = set([(init_pos[0], init_pos[1])]) # Store (row, col) tuples\n\n  while q:\n      r, c, path = q.popleft()\n\n      # If the current position is next to the primitive, then we can USE.\n      if _is_next_to(grid, r, c, primitive, WIDTH, HEIGHT):\n          return path + [USE_ACTION]\n\n      # Explore neighbors\n      for action, (dr, dc) in ACTION_DELTAS.items(): # Use .items() for cleaner iteration over actions and deltas\n          nr, nc = r + dr, c + dc\n\n          if _is_valid_pos(nr, nc, WIDTH, HEIGHT) and (nr, nc) not in visited:\n              # Check if the next cell is walkable (does not contain blocking non-grabbable items)\n              if _is_walkable(grid, nr, nc, NON_GRABBABLE_INDICES, WIDTH, HEIGHT):\n                  visited.add((nr, nc))\n                  q.append((nr, nc, path + [action]))\n\n  # If BFS completes without finding a path to a primitive\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-31T00:42:32.357893", "function_name": "collect", "function_body": "    # Define action mappings and deltas within the function scope as per instructions\n    _ACTION_NAMES = {\n        0: 'DOWN',\n        1: 'UP',\n        2: 'LEFT',\n        3: 'RIGHT',\n        4: 'USE'\n    }\n    _ACTIONS_MAP = {v: k for k, v in _ACTION_NAMES.items()}\n    _DELTAS = {\n        'RIGHT': (1, 0),\n        'LEFT': (-1, 0),\n        'DOWN': (0, 1),\n        'UP': (0, -1),\n    }\n\n    # Helper for BFS, nested inside the function to fit the \"only return code inside the function\" constraint\n    import collections # This import would typically be at the top of the file\n\n    def _find_path_bfs(start_pos, target_kind_index, grid, blocking_kinds=None):\n        \"\"\"\n        Performs BFS to find a path from start_pos to any cell containing target_kind_index.\n        Returns a list of (x, y) coordinates representing the path, including start_pos.\n        Returns None if no path found.\n        blocking_kinds: set of indices that block movement (e.g., walls, water for non-swimmers).\n        \"\"\"\n        if blocking_kinds is None:\n            blocking_kinds = set()\n\n        width, height, _ = grid.shape\n        queue = collections.deque([(start_pos, [start_pos])]) # (current_pos, path_to_current_pos)\n        visited = {start_pos}\n\n        while queue:\n            (curr_x, curr_y), path = queue.popleft()\n\n            # If the current cell contains the target, we found a path to it.\n            # This path leads directly ONTO the primitive.\n            if grid[curr_x, curr_y, target_kind_index] > 0:\n                return path\n\n            # Explore neighbors\n            for _, (dx, dy) in _DELTAS.items(): # Iterate over delta values for neighbors\n                next_x, next_y = curr_x + dx, curr_y + dy\n\n                # Check bounds\n                if not (0 <= next_x < width and 0 <= next_y < height):\n                    continue\n\n                next_pos = (next_x, next_y)\n\n                # Check if visited\n                if next_pos in visited:\n                    continue\n\n                # Check for blocking kinds in the next cell\n                is_blocked = False\n                for kind_idx in blocking_kinds:\n                    if grid[next_x, next_y, kind_idx] > 0:\n                        is_blocked = True\n                        break\n                if is_blocked:\n                    continue\n\n                visited.add(next_pos)\n                queue.append((next_pos, path + [next_pos]))\n\n        return None # No path found\n\n    actions_taken = []\n    # Reset the environment to a known initial state\n    _ = env.reset()\n    # Access the internal CraftState for current grid, position, inventory etc.\n    # This allows direct access to grid, pos, and inventory without parsing observations dict.\n    current_state = env._current_state\n\n    # A safety limit to prevent infinite loops in cases where primitive might be unreachable\n    max_collection_steps = 1000\n\n    for _ in range(max_collection_steps):\n        # 1. Check if the primitive is already in inventory\n        if current_state.inventory[primitive] > 0:\n            return actions_taken\n\n        # 2. Determine blocking kinds for pathfinding\n        # We assume 'primitive' refers to a grabbable item that can be walked onto.\n        # 'non_grabbable_indices' are assumed to be impassable terrain (e.g., water, solid walls).\n        blocking_kinds = set(current_state.world.non_grabbable_indices)\n\n        # 3. Find a path to the primitive using BFS\n        path = _find_path_bfs(\n            current_state.pos,\n            primitive,\n            current_state.grid,\n            blocking_kinds=blocking_kinds\n        )\n\n        if path:\n            # If path exists:\n            # If path length is 1, it means the primitive is at current_state.pos.\n            # In this case, perform the USE action to pick it up.\n            if len(path) == 1:\n                action = _ACTIONS_MAP['USE']\n                _reward, _done, _ = env.step(action) # Execute the action\n                actions_taken.append(action)\n                current_state = env._current_state # Update internal state reference\n                continue # Re-check inventory in the next loop iteration\n\n            # If path length is greater than 1, we need to move towards the primitive.\n            # Get the next position on the shortest path.\n            next_pos_on_path = path[1]\n\n            # Calculate the direction of movement (dx, dy)\n            dx = next_pos_on_path[0] - current_state.pos[0]\n            dy = next_pos_on_path[1] - current_state.pos[1]\n\n            action_to_take = None\n            if dx == 1:\n                action_to_take = _ACTIONS_MAP['RIGHT']\n            elif dx == -1:\n                action_to_take = _ACTIONS_MAP['LEFT']\n            elif dy == 1:\n                action_to_take = _ACTIONS_MAP['DOWN']\n            elif dy == -1:\n                action_to_take = _ACTIONS_MAP['UP']\n\n            if action_to_take is not None:\n                _reward, _done, _ = env.step(action_to_take) # Execute the movement action\n                actions_taken.append(action_to_take)\n                current_state = env._current_state # Update internal state reference\n            else:\n                # This case implies that `next_pos_on_path` is not a direct neighbor,\n                # which should not happen if BFS is correctly implemented and environment is a grid.\n                # If it does happen, we are stuck, so return collected actions.\n                return actions_taken\n\n        else:\n            # No path found to the primitive. It might be unreachable or not present on the map.\n            # Return the actions taken so far, indicating failure to collect.\n            return actions_taken\n\n    # If the loop finishes without collecting the primitive (e.g., max_collection_steps reached),\n    # return the actions performed up to that point.\n    return actions_taken", "island_id": 5, "scores": {"3": -1}}
