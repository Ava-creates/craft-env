{"timestamp": "2025-07-31T01:29:57.220774", "function_name": "collect", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants (from CraftLab.action_specs and CraftState.step)\n    ACTION_MOVE_FORWARD = 0  # DOWN in Lab's action_specs, but it's \"move forward\"\n    ACTION_TURN_LEFT = 1     # UP in Lab's action_specs, but it's \"turn left\"\n    ACTION_TURN_RIGHT = 2    # LEFT in Lab's action_specs, but it's \"turn right\"\n    ACTION_MOVE_BACKWARD = 3 # RIGHT in Lab's action_specs, but it's \"move backward\"\n    ACTION_USE = 4\n\n    # Direction constants (from CraftState.dir: 0=N, 1=E, 2=S, 3=W)\n    # Movement deltas based on direction (DX, DY)\n    _DX = [0, 1, 0, -1]  # Change in X for (N, E, S, W)\n    _DY = [-1, 0, 1, 0]  # Change in Y for (N, E, S, W)\n\n    # Get the current state from the CraftLab environment\n    state = env._current_state\n    \n    current_grid = state.grid\n    current_pos = state.pos\n    current_dir = state.dir # 0=N, 1=E, 2=S, 3=W\n\n    world = state.world\n    non_grabbable_indices = world.non_grabbable_indices\n    \n    grid_width, grid_height, n_kinds = current_grid.shape\n\n    # BFS setup\n    queue = collections.deque([(current_pos, current_dir, [])]) # (pos_x, pos_y), direction, actions_taken\n    visited = set([(current_pos, current_dir)]) # Store (pos, dir) to avoid revisiting same state\n\n    # Helper function to check if a position is valid and not an obstacle\n    def is_valid_and_passable(pos):\n        x, y = pos\n        if not (0 <= x < grid_width and 0 <= y < grid_height):\n            return False # Out of bounds\n        \n        # Check for non-grabbable obstacles at this position\n        # If any of the non_grabbable_indices are present at pos, it's an obstacle\n        if np.any(current_grid[x, y, list(non_grabbable_indices)] > 0):\n            return False # Contains an unpassable obstacle\n        return True\n\n    while queue:\n        (curr_x, curr_y), curr_dir, curr_actions = queue.popleft()\n\n        # Check if the primitive is within the 3x3 neighborhood of the current agent position.\n        # This mirrors CraftState.next_to logic.\n        # Ensure slicing stays within grid boundaries\n        min_x, max_x = max(0, curr_x - 1), min(grid_width, curr_x + 2)\n        min_y, max_y = max(0, curr_y - 1), min(grid_height, curr_y + 2)\n        \n        # Check if the primitive exists in the sliced 3x3 view around the current position\n        if np.any(current_grid[min_x:max_x, min_y:max_y, primitive] > 0):\n            # If the primitive is within reach, we can use it.\n            return curr_actions + [ACTION_USE]\n\n        # Explore possible next states (movements and turns)\n\n        # 1. Move Forward (ACTION_MOVE_FORWARD)\n        next_pos_fwd = (curr_x + _DX[curr_dir], curr_y + _DY[curr_dir])\n        if is_valid_and_passable(next_pos_fwd):\n            if (next_pos_fwd, curr_dir) not in visited:\n                visited.add((next_pos_fwd, curr_dir))\n                queue.append((next_pos_fwd, curr_dir, curr_actions + [ACTION_MOVE_FORWARD]))\n\n        # 2. Move Backward (ACTION_MOVE_BACKWARD)\n        next_pos_bwd = (curr_x - _DX[curr_dir], curr_y - _DY[curr_dir])\n        if is_valid_and_passable(next_pos_bwd):\n            if (next_pos_bwd, curr_dir) not in visited:\n                visited.add((next_pos_bwd, curr_dir))\n                queue.append((next_pos_bwd, curr_dir, curr_actions + [ACTION_MOVE_BACKWARD]))\n\n        # 3. Turn Left (ACTION_TURN_LEFT)\n        next_dir_left = (curr_dir - 1) % 4\n        if ((curr_x, curr_y), next_dir_left) not in visited:\n            visited.add(((curr_x, curr_y), next_dir_left))\n            queue.append(((curr_x, curr_y), next_dir_left, curr_actions + [ACTION_TURN_LEFT]))\n\n        # 4. Turn Right (ACTION_TURN_RIGHT)\n        next_dir_right = (curr_dir + 1) % 4\n        if ((curr_x, curr_y), next_dir_right) not in visited:\n            visited.add(((curr_x, curr_y), next_dir_right))\n            queue.append(((curr_x, curr_y), next_dir_right, curr_actions + [ACTION_TURN_RIGHT]))\n            \n    # If the queue is exhausted and no path to a primitive was found\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:29:57.294143", "function_name": "collect", "function_body": "    actions_taken = []\n    max_total_steps = 200 # Safety limit to prevent infinite loops\n\n    # Initial observations and state\n    # Calling reset ensures a clean start and current_state is set.\n    _ = env.reset()\n    current_state = env._current_state\n\n    # Check if primitive is grabbable, otherwise it's an invalid request for 'collect'\n    # Primitives are generally assumed to be grabbable.\n    if primitive not in current_state.world.grabbable_indices:\n        return [] # Cannot collect non-grabbable items\n\n    # Action constants (assuming these are globally available or can be inferred)\n    # Define them locally for self-containment for this completion,\n    # though typically they'd be module-level constants.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Map (dr, dc) to an action (movement)\n    MOVE_ACTION_MAP = {\n        (1, 0): ACTION_DOWN,\n        (-1, 0): ACTION_UP,\n        (0, -1): ACTION_LEFT,\n        (0, 1): ACTION_RIGHT,\n    }\n\n    # Define directions for neighbors (dr, dc)\n    NEIGHBOR_DELTAS = [(1, 0), (-1, 0), (0, -1), (0, 1)] # DOWN, UP, LEFT, RIGHT relative moves\n\n    # Helper function for BFS pathfinding. Defined locally as per strict interpretation\n    # of \"only return code that will fit in that function\".\n    # In a real module, this would be a top-level helper.\n    from collections import deque\n    def _find_path_bfs_and_target(start_pos, target_kind_index, current_state_for_bfs):\n        \"\"\"\n        Finds a path (list of actions) from start_pos to a cell *adjacent* to target_kind_index.\n        Returns (path_actions, final_agent_pos, target_item_pos) or None if no path found.\n        final_agent_pos is the cell the agent moves to, which is adjacent to target_item_pos.\n        \"\"\"\n        grid = current_state_for_bfs.grid\n        world = current_state_for_bfs.world\n        # Assuming `world.environment` contains indices of impassable entities for movement\n        impassable_indices = world.environment # Set of indices for impassable entities\n\n        height, width, _ = grid.shape\n\n        q = deque([(start_pos, [])]) # (current_position, actions_path_so_far)\n        visited = {start_pos}\n\n        # First, find all locations of the target_kind_index on the grid\n        all_target_locations = []\n        for r in range(height):\n            for c in range(width):\n                if grid[r, c, target_kind_index] == 1:\n                    all_target_locations.append((r, c))\n\n        if not all_target_locations:\n            return None # Target not on grid\n\n        best_path_info = None\n        min_path_length = float('inf')\n\n        while q:\n            (r, c), path_actions = q.popleft()\n\n            # Optimization: If current path is already longer than best found, prune.\n            if len(path_actions) > min_path_length:\n                continue # This path is already longer than the best found\n\n            # Check if the current position (r,c) is adjacent to any of the target locations\n            for tr, tc in all_target_locations:\n                dr, dc = tr - r, tc - c\n                # If (r,c) and (tr,tc) are direct neighbors (Manhattan distance 1)\n                if abs(dr) + abs(dc) == 1:\n                    # Found a path to an adjacent cell!\n                    if len(path_actions) < min_path_length:\n                        min_path_length = len(path_actions)\n                        best_path_info = (path_actions, (r, c), (tr, tc))\n                    # If current path is equal to min_path_length, it's also a shortest path.\n                    # We can pick any of them; the first one found is fine for BFS.\n                    # If we wanted to, e.g., prefer certain (agent_final_pos, target_object_pos) pairs,\n                    # we'd collect all with min_path_length and apply a secondary sort.\n                    # For now, simply finding the shortest path to *any* adjacent cell is sufficient.\n\n            # Explore neighbors for movement\n            for move_dr, move_dc in NEIGHBOR_DELTAS:\n                nr, nc = r + move_dr, c + move_dc\n\n                if not (0 <= nr < height and 0 <= nc < width):\n                    continue # Out of bounds\n\n                if (nr, nc) in visited:\n                    continue # Already visited this cell in a shorter or equal path\n\n                # Check if the new cell (nr, nc) is impassable for movement\n                is_impassable = False\n                for k_idx in impassable_indices:\n                    if grid[nr, nc, k_idx] == 1:\n                        is_impassable = True\n                        break\n                if is_impassable:\n                    continue\n\n                visited.add((nr, nc))\n                q.append(((nr, nc), path_actions + [MOVE_ACTION_MAP[(move_dr, move_dc)]]))\n        \n        # After BFS completes, best_path_info holds the shortest path to an adjacent cell.\n        return best_path_info\n\n    # Main logic for collect_v2\n    while current_state.inventory[primitive] == 0 and len(actions_taken) < max_total_steps:\n        # Find path to a cell adjacent to the primitive\n        path_info = _find_path_bfs_and_target(\n            current_state.pos,\n            primitive,\n            current_state\n        )\n\n        if path_info is None:\n            # No path found to the primitive, or primitive not on grid\n            break # Cannot reach/collect\n\n        path_actions, agent_final_pos, target_object_pos = path_info\n\n        # Execute path actions to move to the cell adjacent to the primitive\n        for action in path_actions:\n            # Step in the environment\n            _, done, _ = env.step(action)\n            actions_taken.append(action)\n            current_state = env._current_state # Update state reference\n\n            # Check if goal achieved or episode ended after each step\n            if current_state.inventory[primitive] > 0 or done:\n                return actions_taken\n\n        # After all movement actions, agent is at `agent_final_pos`.\n        # Now, perform the USE action.\n        # This implementation assumes that the USE action works when the agent is\n        # in a cell adjacent to the target, regardless of explicit facing direction,\n        # or that the agent implicitly faces the closest interactable object.\n        # The `CraftState.next_to()` method supports this interpretation (3x3 neighborhood).\n\n        # Perform the USE action\n        _, done, _ = env.step(ACTION_USE)\n        actions_taken.append(ACTION_USE)\n        current_state = env._current_state # Update state reference\n\n        # Check if goal achieved or episode ended after USE\n        if current_state.inventory[primitive] > 0 or done:\n            break # Goal achieved or episode ended\n\n    return actions_taken", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-31T01:31:32.657977", "function_name": "collect", "function_body": "  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  # Agent directions (consistent with CraftState.dir, where 0 is typically North/Up)\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Mapping of movement action to the resulting agent facing direction *after* the move.\n  # Assumes agent turns to face the direction it moved towards.\n  ACTION_TO_DIR = {\n      Action.UP: DIR_NORTH,\n      Action.RIGHT: DIR_EAST,\n      Action.DOWN: DIR_SOUTH,\n      Action.LEFT: DIR_WEST\n  }\n\n  # Mapping from a target's (dy, dx) relative coordinates to the *required*\n  # agent facing direction for ACTION_USE to succeed on that target.\n  # For example, if target is (-1, 0) (North of agent), agent must face North.\n  RELATIVE_POS_TO_REQUIRED_DIR = {\n      (-1, 0): DIR_NORTH,  # Target is North of agent (row - 1)\n      (1, 0): DIR_SOUTH,   # Target is South of agent (row + 1)\n      (0, -1): DIR_WEST,   # Target is West of agent (col - 1)\n      (0, 1): DIR_EAST     # Target is East of agent (col + 1)\n  }\n\n  # Maximum number of actions allowed for collection, including movements and the final USE action.\n  MAX_COLLECT_STEPS = 100 \n\n  actions_taken = []\n\n  # IMPORTANT: Do NOT call env.reset() here. `collect` should operate from the *current*\n  # state of the environment, allowing it to be chained with other actions.\n  # Access the internal CraftState instance directly to get current state information.\n  current_state = env._current_state\n\n  # Basic validation: Ensure the `primitive` is a recognized primitive resource in the cookbook.\n  # Using `cookbook.primitives` is more accurate than `cookbook.kinds` for collectable items.\n  if primitive not in current_state.world.cookbook.primitives:\n      return []\n\n  # Optimization: If the `primitive` is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Retrieve necessary environment information for pathfinding.\n  full_grid = current_state.features_dict()['features_global']\n  grid_height, grid_width, _ = full_grid.shape\n  start_y, start_x = current_state.pos\n  start_dir = current_state.dir \n  world = current_state.world # Shortcut to the CraftWorld instance\n\n  # Define what is considered impassable for agent movement.\n  # This typically includes water and any non-grabbable items that are *not* workshops.\n  # Primitive resources (the target of this function) are generally grabbable and thus traversable.\n  impassable_for_movement = set()\n  if world.water_index in world.kinds: # Check if water entity exists in this world\n      impassable_for_movement.add(world.water_index)\n  \n  # Convert workshop_indices to a set for efficient lookups\n  workshop_indices_set = set(world.workshop_indices)\n  for k_idx in world.non_grabbable_indices:\n      # If a non-grabbable item is NOT a workshop, assume it blocks movement.\n      if k_idx not in workshop_indices_set:\n          impassable_for_movement.add(k_idx)\n\n  # Define movement options: (delta_y, delta_x, action_id, resulting_direction_after_move)\n  move_options = [\n      (-1, 0, Action.UP,    DIR_NORTH),\n      (1, 0, Action.DOWN,   DIR_SOUTH),\n      (0, -1, Action.LEFT,  DIR_WEST),\n      (0, 1, Action.RIGHT,  DIR_EAST)\n  ]\n\n  q = collections.deque()\n  # BFS queue state: (current_y, current_x, current_direction, path_of_actions_so_far)\n  # Storing current_direction is crucial because `ACTION_USE` depends on agent orientation.\n  q.append((start_y, start_x, start_dir, []))\n  \n  # Keep track of visited states to prevent redundant exploration and infinite loops.\n  # A state is defined by (position_y, position_x, direction).\n  visited = {(start_y, start_x, start_dir)}\n\n  path_to_execute = None  # This will store the final sequence of actions if a path is found.\n\n  # --- Breadth-First Search (BFS) to find the shortest action sequence to collect the primitive ---\n  while q:\n      curr_y, curr_x, curr_dir, path = q.popleft()\n\n      # Pruning: If the current path length already exceeds MAX_COLLECT_STEPS,\n      # this branch cannot lead to a valid solution within the specified limits\n      # (reserving at least one slot for the final ACTION_USE).\n      if len(path) >= MAX_COLLECT_STEPS:\n          continue\n\n      # Check if the primitive is in an adjacent cell AND agent is correctly oriented to collect it.\n      for rel_dy, rel_dx in RELATIVE_POS_TO_REQUIRED_DIR.keys():\n          adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n          # Check if the adjacent cell is within grid boundaries.\n          if not (0 <= adj_y < grid_height and 0 <= adj_x < grid_width):\n              continue\n\n          # Check if the adjacent cell contains the target primitive.\n          if full_grid[adj_y, adj_x, primitive] > 0:\n              # Primitive found at (adj_y, adj_x). Now, check agent's orientation.\n              required_dir_for_collection = RELATIVE_POS_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n\n              if curr_dir == required_dir_for_collection:\n                  # Found a state (position AND orientation) from which ACTION_USE can be performed.\n                  candidate_path = path + [Action.USE]\n                  # Ensure the complete path (including final ACTION_USE) is within the step limit.\n                  if len(candidate_path) <= MAX_COLLECT_STEPS:\n                      path_to_execute = candidate_path\n                      break # BFS guarantees shortest path, so we can stop.\n      \n      if path_to_execute: # If a path was found and stored, break out of the main BFS loop.\n          break\n\n      # Explore all possible next states from the current (y, x, dir) state via movement actions.\n      for dy_move, dx_move, action_move, new_dir_after_move in move_options:\n          next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n          # Pruning: If adding this move makes the path too long (considering the final USE).\n          if len(path) + 1 >= MAX_COLLECT_STEPS: \n              continue\n\n          # Check if the proposed next position is within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the proposed next cell is traversable based on `impassable_for_movement`.\n          is_traversable = True\n          for k_idx in impassable_for_movement:\n              if full_grid[next_y, next_x, k_idx] > 0:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # Check if this new (position, direction) state has already been visited.\n          if (next_y, next_x, new_dir_after_move) not in visited:\n              visited.add((next_y, next_x, new_dir_after_move))\n              q.append((next_y, next_x, new_dir_after_move, path + [action_move]))\n\n  # --- Execute the found path (if any) and monitor for successful collection ---\n  if path_to_execute is None:\n      # If no valid path was found within the step limit, return an empty list.\n      return []\n\n  for action in path_to_execute:\n      actions_taken.append(action)\n      # Perform the action in the environment.\n      reward, done, _ = env.step(action)\n      # Always update the internal state reference after each step to reflect the current environment.\n      current_state = env._current_state\n\n      # Check for early termination of the episode or if the goal was satisfied.\n      # If the episode ended but the primitive was not collected, return failure.\n      if done and current_state.inventory[primitive] <= 0:\n          return []  # Episode ended prematurely, goal not achieved.\n\n      # If the primitive is collected, we can stop executing remaining actions.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n  # Final check after executing all actions in `path_to_execute`.\n  # This handles cases where the primitive is collected on the very last action (i.e., ACTION_USE).\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # If the full path was executed but the primitive was not collected,\n      # it indicates a discrepancy (e.g., primitive disappeared dynamically,\n      # or USE failed for an unmodeled reason).\n      return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-31T01:31:33.656122", "function_name": "collect", "function_body": "  actions_taken = []\n\n  # Define action and direction constants using IntEnum for clarity.\n  # These must be defined inside the function per the prompt's constraints.\n  import collections\n  from enum import IntEnum\n\n  class Action(IntEnum):\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n\n  class Direction(IntEnum):\n      # DMLab-style directions: 0=East, 1=South, 2=West, 3=North\n      EAST = 0\n      SOUTH = 1\n      WEST = 2\n      NORTH = 3\n\n  # Mapping of movement action to the resulting agent direction after the move.\n  # The agent's direction (CraftState.dir) is updated based on the movement.\n  ACTION_TO_NEW_DIR = {\n      Action.UP:    Direction.NORTH,\n      Action.RIGHT: Direction.EAST,\n      Action.DOWN:  Direction.SOUTH,\n      Action.LEFT:  Direction.WEST,\n  }\n\n  # (dy, dx) deltas for each movement action.\n  MOVE_DELTAS = {\n      Action.UP:    (-1, 0),\n      Action.RIGHT: (0, 1),\n      Action.DOWN:  (1, 0),\n      Action.LEFT:  (0, -1),\n  }\n\n  # Mapping of a target's relative position (dy, dx) to the required agent facing direction\n  # for ACTION_USE to be effective. This assumes ACTION_USE targets the cell directly in front.\n  RELATIVE_POS_TO_REQUIRED_DIR = {\n      (0, 1): Direction.EAST,   # Target to the agent's right requires agent to face East\n      (1, 0): Direction.SOUTH,  # Target below requires agent to face South\n      (0, -1): Direction.WEST,  # Target to the agent's left requires agent to face West\n      (-1, 0): Direction.NORTH  # Target above requires agent to face North\n  }\n\n  # Maximum number of actions allowed for the collection path (movements + final USE).\n  # This prevents excessively long search times and limits the length of the generated sequence.\n  MAX_COLLECT_STEPS = 100 \n\n  # Helper function: Determines which entity kinds block agent movement.\n  # Placed inside to fit the single-function return constraint.\n  def _get_impassable_for_movement_kinds(world):\n      \"\"\"\n      Identifies entity kinds that the agent cannot move onto.\n      This includes water and non-grabbable items that are not workshops (which are traversable).\n      \"\"\"\n      impassable_kinds = set()\n      # Water is typically an impassable terrain feature.\n      if world.water_index in world.kinds:\n          impassable_kinds.add(world.water_index)\n      \n      # Non-grabbable items generally block movement, but workshops (e.g., workbench, furnace)\n      # are common exceptions that agents can typically walk over.\n      for k_idx in world.non_grabbable_indices:\n          if k_idx not in world.workshop_indices:\n              impassable_kinds.add(k_idx)\n      return impassable_kinds\n\n  # Helper function: Performs a BFS to find the shortest action sequence.\n  # Placed inside to fit the single-function return constraint.\n  def _find_collection_path(start_pos, start_dir, full_grid, primitive_id, world):\n      \"\"\"\n      Finds the shortest sequence of actions (moves + a final USE) to collect the primitive.\n      \n      Args:\n          start_pos (tuple[int, int]): Agent's starting (y, x) coordinates.\n          start_dir (int): Agent's starting facing direction.\n          full_grid (np.ndarray): The full grid representation (height, width, n_kinds).\n          primitive_id (int): The integer ID of the primitive to collect.\n          world (CraftWorld): Reference to the CraftWorld instance for world data.\n\n      Returns:\n          list[int]: A list of actions (including the final Action.USE) if a path is found,\n                     otherwise None.\n      \"\"\"\n      grid_height, grid_width, _ = full_grid.shape\n      impassable_for_movement = _get_impassable_for_movement_kinds(world)\n\n      q = collections.deque()\n      # BFS state: (current_y, current_x, current_direction, path_of_actions_so_far)\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      \n      # Visited set: (y, x, dir) to avoid revisiting the same state and prevent cycles.\n      visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      while q:\n          curr_y, curr_x, curr_dir, path = q.popleft()\n\n          # Pruning: If the current path length is already at or exceeds MAX_COLLECT_STEPS,\n          # this branch cannot lead to a valid solution within the limits (reserving one slot for Action.USE).\n          if len(path) >= MAX_COLLECT_STEPS:\n              continue\n\n          # --- Check if the primitive can be collected from the current position and orientation ---\n\n          # Case 1: Primitive is on the agent's current cell.\n          # This applies if the primitive is a 'grabbable' type that can be picked up by standing on it.\n          # It must also not be an item that blocks movement (i.e., not in impassable_for_movement).\n          if full_grid[curr_y, curr_x, primitive_id] > 0:\n              if primitive_id not in impassable_for_movement:\n                  # If the item is on the current cell and not a blocker, we can \"use\" it to collect.\n                  return path + [Action.USE]\n\n          # Case 2: Primitive is on an adjacent cell and the agent is facing it correctly.\n          for rel_dy, rel_dx in RELATIVE_POS_TO_REQUIRED_DIR.keys():\n              adj_y, adj_x = curr_y + rel_dy, curr_x + rel_dx\n\n              # Check if the adjacent cell is within grid boundaries.\n              if not (0 <= adj_y < grid_height and 0 <= adj_x < grid_width):\n                  continue\n\n              # Check if the adjacent cell contains the target primitive.\n              if full_grid[adj_y, adj_x, primitive_id] > 0:\n                  # Determine the direction the agent needs to be facing to collect from this adjacent cell.\n                  required_dir = RELATIVE_POS_TO_REQUIRED_DIR[(rel_dy, rel_dx)]\n                  \n                  # If the agent is currently facing the required direction, this is a valid collection point.\n                  if curr_dir == required_dir:\n                      return path + [Action.USE]\n\n          # --- Explore all possible movement actions from the current state ---\n          for action_move, (dy_move, dx_move) in MOVE_DELTAS.items():\n              next_y, next_x = curr_y + dy_move, curr_x + dx_move\n              next_dir = ACTION_TO_NEW_DIR[action_move] # New direction after this movement action.\n\n              # Check if the proposed next position is within grid boundaries.\n              if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n                  continue\n\n              # Check if the proposed next cell is traversable for movement.\n              # An agent cannot move into a cell containing an 'impassable' kind.\n              is_traversable = True\n              for k_idx in impassable_for_movement:\n                  if full_grid[next_y, next_x, k_idx] > 0:\n                      is_traversable = False\n                      break\n              if not is_traversable:\n                  continue\n\n              # If the new state (position + direction) has not been visited, add it to the queue.\n              if (next_y, next_x, next_dir) not in visited:\n                  visited.add((next_y, next_x, next_dir))\n                  q.append((next_y, next_x, next_dir, path + [action_move]))\n      \n      return None # No valid path to collect the primitive was found within MAX_COLLECT_STEPS.\n\n\n  # --- Main logic for collect_v2 ---\n\n  # IMPORTANT: This function operates on the *current* state of the environment.\n  # Do NOT call env.reset() here, as it would reset the episode and break task chaining.\n  current_state = env._current_state\n\n  # Basic validation: Ensure the `primitive` ID is recognized in the world's cookbook.\n  if primitive not in current_state.world.cookbook.kinds:\n      return []\n\n  # Optimization: If the `primitive` is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive] > 0:\n      return []\n\n  # Retrieve necessary environment information from the current state for pathfinding.\n  full_grid = current_state.features_dict()['features_global']\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n\n  # Find the shortest sequence of actions (movement + a final ACTION_USE) to collect the primitive.\n  # The helper function handles the BFS and ensures the final action is ACTION_USE if a path is found.\n  path_to_execute = _find_collection_path(start_pos, start_dir, full_grid, primitive, current_state.world)\n\n  if path_to_execute is None:\n      # If no valid path was found within the step limit, or the primitive is inaccessible.\n      return []\n\n  # Execute the found path step by step in the environment.\n  for action in path_to_execute:\n      actions_taken.append(action)\n      \n      # Perform the action in the environment.\n      reward, done, _ = env.step(action)\n      \n      # Always update the internal state reference after each step to reflect the current environment.\n      current_state = env._current_state\n\n      # Check for early termination: If the episode ends for any reason (e.g., max_steps reached by CraftLab)\n      # AND the primitive has not been collected, it indicates the collection failed despite planning.\n      if done and current_state.inventory[primitive] <= 0:\n          return []  # Episode ended, but the goal was not satisfied.\n\n      # If the primitive is successfully collected, we can stop executing the remaining actions.\n      # This optimization prevents unnecessary steps if the primitive is acquired mid-path.\n      if current_state.inventory[primitive] > 0:\n          return actions_taken\n\n  # Final check: After executing the entire planned path, confirm the primitive was collected.\n  # This covers the case where the primitive is collected on the very last action (ACTION_USE) of the path.\n  if current_state.inventory[primitive] > 0:\n      return actions_taken\n  else:\n      # This case should ideally not happen if the `_find_collection_path` function correctly\n      # identifies a reachable primitive and the environment behaves deterministically.\n      # It might occur if:\n      # 1. The primitive was dynamic and disappeared before the agent reached it.\n      # 2. The primitive required a tool not possessed by the agent (a factor not considered by this planner).\n      # 3. There's an inconsistency between the planning model and the actual environment mechanics.\n      return []", "island_id": 0, "scores": {"3": 0.0}}
