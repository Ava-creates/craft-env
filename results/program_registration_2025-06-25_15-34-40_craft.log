{"timestamp": "2025-06-26T12:36:18.780509", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of steps to reach the nearest workshop if inventory is empty\n      if state.inventory[goal_item] == 0:\n          min_distance = float('inf')\n          for pos in state.world.workshop_indices:\n              distance = abs(pos[0] - state.pos[0]) + abs(pos[1] - state.pos[1])\n              min_distance = min(min_distance, distance)\n          return min_distance\n      else:\n          return 0\n\n  def astar_search(initial_state, goal_item, max_steps=500):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item) or len(path) >= max_steps:\n              return path\n          \n          # Prioritize actions that involve using items (USE action)\n          priority_actions = [4] + list(range(env.world.n_actions - 1))  # Use action first, then others\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heappush(open_set, (len(path) + 1 + heuristic(new_state, goal_item), new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:36:28.914245", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item) or len(path) >= max_steps:\n              return path\n          \n          # Prioritize actions that involve using items (USE action)\n          priority_actions = [4] + list(range(env.world.n_actions - 1))  # Use action first, then others\n\n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n\n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:37:05.857992", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that involve using items\n          actions = [4] + list(range(4))  # Prioritize USE action (index 4)\n          \n          for action in actions:\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              state_hash = hash(new_state)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-06-26T12:37:06.843581", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from current state to goal.\"\"\"\n      # Simple heuristic: number of items needed\n      primitives_needed = env.world.cookbook.primitives_for(goal_item)\n      inventory_primitives = {k: state.inventory[k] for k in primitives_needed}\n      return sum(max(0, primitives_needed[k] - inventory_primitives.get(k, 0)) for k in primitives_needed)\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue of (cost + heuristic, cost, path)\n      priority_queue = [(heuristic(initial_state, goal_item), 0, initial_state, [])]\n      visited = set()\n      \n      while priority_queue:\n          _, current_cost, current_state, path = heapq.heappop(priority_queue)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  cost = current_cost - reward  # Higher rewards mean lower costs\n                  heapq.heappush(priority_queue, \n                                 (cost + heuristic(new_state, goal_item), cost, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start A* search to find the action sequence\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:38:23.455658", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of non-zero inventory slots\n      # This can be improved based on specific knowledge about the game.\n      return sum(1 for count in state.inventory if count == 0)\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue to store (cost, path, state)\n      queue = []\n      start_cost = 0\n      start_path = []\n      start_hash = (tuple(initial_state.grid.flatten()), \n                    tuple(initial_state.inventory), \n                    initial_state.pos, \n                    initial_state.dir)\n      \n      heapq.heappush(queue, (start_cost, start_path, initial_state))\n      visited = set([start_hash])\n      \n      while queue:\n          current_cost, path, current_state = heapq.heappop(queue)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n\n                  # Calculate cost with heuristic\n                  h_cost = heuristic(new_state, goal_item)\n                  cost = current_cost + 1 + h_cost  # Increase cost by 1 step\n\n                  new_path = path + [action]\n                  heapq.heappush(queue, (cost, new_path, new_state))\n\n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:38:41.383948", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic based on distance to nearest ingredient if needed\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      grid = current_state.grid\n      \n      def get_distance_to_closest(grid, kind_index):\n          pos = np.argwhere(grid[:, :, kind_index] > 0)\n          if pos.size == 0:\n              return float('inf')\n          agent_pos = np.array(current_state.pos)\n          distances = np.linalg.norm(pos - agent_pos, axis=1)\n          return min(distances) if distances.size > 0 else float('inf')\n      \n      # Calculate heuristic based on distance to closest primitive ingredient\n      total_distance = sum(get_distance_to_closest(grid, kind_index) for kind_index in primitives.keys())\n      return total_distance\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      queue = []\n      start_cost = 0\n      start_path = []\n      start_hash = (tuple(initial_state.grid.flatten()), \n                    tuple(initial_state.inventory), \n                    initial_state.pos, \n                    initial_state.dir)\n      \n      heapq.heappush(queue, (start_cost + heuristic(initial_state, goal_item), start_cost, start_path, initial_state))\n      visited = set([start_hash])\n      \n      while queue:\n          _, current_cost, path, current_state = heapq.heappop(queue)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n\n                  new_cost = current_cost + 1  # Increase cost by 1 step\n                  new_path = path + [action]\n                  heapq.heappush(queue, (new_cost + heuristic(new_state, goal_item), new_cost, new_path, new_state))\n\n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:39:31.942341", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue for A* search\n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      \n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Skip invalid actions that incur penalties\n              if reward < 0:\n                  continue\n              \n              tentative_g_score = g_score[current_state] + 1\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited or tentative_g_score < g_score.get(new_state, float('inf')):\n                  came_from[new_state] = current_state\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score[new_state], new_state, path + [action]))\n                  visited.add(state_hash)\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic based on the number of items still needed\n      primitives_needed = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = current_state.inventory\n      \n      missing_count = sum(primitives_needed.get(kind, 0) - current_inventory[kind] for kind in primitives_needed)\n      \n      return max(1, missing_count)\n\n  def reconstruct_path(came_from, current, path):\n      if current in came_from:\n          path = reconstruct_path(came_from, came_from[current], path)\n      return path + [current]\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start A* search to find the action sequence\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if action_sequence:\n      # Extract actions from state transitions\n      action_list = []\n      current_state = initial_state\n      \n      for next_state in action_sequence[1:]:\n          found_action = None\n          for action in range(env.world.n_actions):\n              _, new_state = current_state.step(action)\n              if new_state == next_state:\n                  found_action = action\n                  break\n          if found_action is not None:\n              action_list.append(found_action)\n          current_state = next_state\n      \n      return action_list\n  \n  return []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:39:47.556085", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions: use (index 4), then movement actions\n          priority_actions = [4] + list(range(4))\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Skip invalid actions that incur penalties\n              if reward < 0:\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:40:33.545686", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_reachable_items(state, cookbook):\n      \"\"\"Determine which items can be crafted or used from the current inventory.\"\"\"\n      reachable_items = set()\n      \n      for i in range(len(cookbook.index)):\n          recipe = cookbook.recipes.get(i, {})\n          \n          # Check if all ingredients are available in the inventory\n          if all(state.inventory[ingredient] >= count for ingredient, count in recipe.items()):\n              reachable_items.add(i)\n      \n      return reachable_items\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          cookbook = env.world.cookbook\n          reachable_items = get_reachable_items(current_state, cookbook)\n          \n          # Prioritize actions that lead to crafting or using items\n          priority_actions = []\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  \n                  if action == 4:  # USE action\n                      new_inventory = new_state.inventory.copy()\n                      \n                      # Check if any reachable items are crafted or used\n                      for i in reachable_items:\n                          if current_state.inventory[i] < new_inventory[i]:\n                              priority_actions.append((new_state, path + [action]))\n                              break\n                  else:  # Movement actions\n                      queue.append((new_state, path + [action]))\n          \n          # Add prioritized actions to the front of the queue\n          for action in reversed(priority_actions):\n              queue.appendleft(action)\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:40:34.520241", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions: 4 (USE) > 0-3 (Movement)\n          priority_actions = [4] + list(range(4))\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              state_hash = hash_state(new_state)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def hash_state(state):\n      \"\"\"Create a hashable representation of the state.\"\"\"\n      grid_tuple = tuple(map(tuple, map(tuple, state.grid)))\n      inventory_tuple = tuple(state.inventory)\n      pos_tuple = tuple(state.pos)\n      dir_value = state.dir\n      \n      return (grid_tuple, inventory_tuple, pos_tuple, dir_value)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:41:47.987038", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def prioritize_actions(current_state):\n      priority_actions = []\n      \n      # Prioritize the USE action\n      reward, use_state = current_state.step(4)\n      if not np.array_equal(use_state.grid, current_state.grid) or\\\n         not np.array_equal(use_state.inventory, current_state.inventory) or\\\n         use_state.pos != current_state.pos or\\\n         use_state.dir != current_state.dir:\n          priority_actions.append((4, use_state))\n      \n      # Prioritize moving actions\n      for action in range(4):\n          reward, move_state = current_state.step(action)\n          if not np.array_equal(move_state.grid, current_state.grid) or\\\n             not np.array_equal(move_state.inventory, current_state.inventory) or\\\n             move_state.pos != current_state.pos or\\\n             move_state.dir != current_state.dir:\n              priority_actions.append((action, move_state))\n      \n      return [action for action, _ in sorted(priority_actions, key=lambda x: -x[1].inventory[item])]\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          priority_actions = prioritize_actions(current_state)\n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      # Heuristic function that estimates the cost from the current state to the goal\n      # Here, we assume a simple heuristic based on inventory count\n      return -state.inventory[goal_item]\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          priority_actions = prioritize_actions(current_state)\n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Cost is 1 for each step\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
