{"timestamp": "2025-06-27T12:57:28.741220", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          action_candidates = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  new_primitives = get_primitive_counts(goal_item, new_state.world.cookbook)\n                  progress_towards_goal = any(new_primitives[primitive] < goal_primitives[primitive] for primitive in new_primitives)\n                  \n                  if not progress_towards_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              action_candidates.append((new_state, path + [action]))\n          \n          # Prioritize actions that move towards the goal primitives\n          for new_state, path in sorted(action_candidates, key=lambda x: len(get_primitive_counts(goal_item, x[0].world.cookbook))):\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-06-27T12:57:29.962044", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_item):\n      # Calculate the number of missing primitives needed to craft the goal item\n      goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n      inventory_primitives = {prim: state.inventory[prim] for prim in goal_primitives}\n      \n      missing_primitives = {prim: goal_primitives[prim] - inventory_primitives.get(prim, 0) \n                            for prim in goal_primitives if goal_primitives[prim] > inventory_primitives.get(prim, 0)}\n      \n      return sum(missing_primitives.values())\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          state_hash = (tuple(current_state.grid.flatten()), \n                        tuple(current_state.inventory), \n                        current_state.pos, \n                        current_state.dir)\n          \n          if state_hash in visited:\n              continue\n          \n          visited.add(state_hash)\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          action_candidates = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              action_candidates.append((new_state, path + [action]))\n          \n          for new_state, path in action_candidates:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  heappush(open_set, (heuristic(new_state, goal_item) + len(path), new_state, path))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-27T12:59:11.318256", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def find_item_on_grid(grid, item):\n      \"\"\"Finds the position of an item on the grid.\"\"\"\n      positions = np.argwhere(grid[:, :, item] > 0)\n      if len(positions) > 0:\n          return tuple(positions[0])\n      return None\n\n  def move_to_position(current_pos, target_pos, dir, world):\n      \"\"\"Generates actions to move from current_pos to target_pos.\"\"\"\n      actions = []\n      dx, dy = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n      \n      # Adjust direction to face the correct way\n      if dx > 0:\n          target_dir = 3  # RIGHT\n      elif dx < 0:\n          target_dir = 2  # LEFT\n      elif dy > 0:\n          target_dir = 1  # UP\n      elif dy < 0:\n          target_dir = 0  # DOWN\n      \n      if dir != target_dir:\n          actions.append((target_dir - dir) % 4)\n      \n      # Move to the target position\n      for _ in range(abs(dx)):\n          actions.append(3 if dx > 0 else 2)\n      for _ in range(abs(dy)):\n          actions.append(1 if dy > 0 else 0)\n      \n      return actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def plan_actions(env, goal_item):\n      initial_state = env._current_state\n      action_sequence = []\n      max_attempts = 50  # Increase the maximum attempts to handle complex scenarios\n      \n      while not satisfies_goal(initial_state, goal_item) and len(action_sequence) < 100:  # Limit the total number of actions\n          path = bfs_search(initial_state, goal_item)\n          if path is None:\n              break\n          \n          action_sequence.extend(path)\n          \n          # Apply the found actions to the environment\n          for action in path:\n              reward, done, observations = env.step(action)\n              \n              if done or satisfies_goal(env._current_state, goal_item):\n                  return action_sequence\n          \n          initial_state = env._current_state\n\n      return action_sequence if satisfies_goal(env._current_state, goal_item) else []\n\n  # Plan and execute the actions to craft the item\n  return plan_actions(env, item)", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T12:59:21.499685", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      possible_actions.append((action, new_state))\n              else:  # MOVEMENT actions\n                  possible_actions.append((action, new_state))\n          \n          for action, new_state in possible_actions:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T13:00:52.954039", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_action_sequence(actions):\n      # Simple heuristic: remove consecutive moves in opposite directions\n      optimized_actions = []\n      i = 0\n      \n      while i < len(actions):\n          current_action = actions[i]\n          \n          if current_action == 0:  # DOWN\n              if i + 1 < len(actions) and actions[i + 1] == 1:  # UP\n                  i += 2  # Skip both actions\n                  continue\n          elif current_action == 1:  # UP\n              if i + 1 < len(actions) and actions[i + 1] == 0:  # DOWN\n                  i += 2  # Skip both actions\n                  continue\n          elif current_action == 2:  # LEFT\n              if i + 1 < len(actions) and actions[i + 1] == 3:  # RIGHT\n                  i += 2  # Skip both actions\n                  continue\n          elif current_action == 3:  # RIGHT\n              if i + 1 < len(actions) and actions[i + 1] == 2:  # LEFT\n                  i += 2  # Skip both actions\n                  continue\n          \n          optimized_actions.append(current_action)\n          i += 1\n      \n      return optimized_actions\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n      optimized_sequence = optimize_action_sequence(action_sequence)\n      return optimized_sequence\n  \n  return []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T13:00:54.202148", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_primitives):\n      # Calculate a simple heuristic based on the number of missing primitives\n      missing_count = 0\n      for primitive, required in goal_primitives.items():\n          missing_count += max(required - state.inventory[primitive], 0)\n      return missing_count\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))  # (f_score, state, path)\n      g_scores = {initial_state: 0}\n      \n      cookbook = initial_state.world.cookbook\n      goal_primitives = get_primitive_counts(goal_item, cookbook)\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              g_score_new = g_scores[current_state] + 1\n              h_score_new = heuristic(new_state, goal_primitives)\n              f_score_new = g_score_new + h_score_new\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if new_state not in g_scores or g_score_new < g_scores[new_state]:\n                  g_scores[new_state] = g_score_new\n                  heapq.heappush(open_set, (f_score_new, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-27T13:02:01.078986", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient != \"_key\":\n            dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    from heapq import heappush, heappop\n\n    # Priority queue for BFS with heuristic (number of primitives still needed)\n    queue = []\n    heappush(queue, (0, initial_state, []))\n    visited = set()\n\n    while queue:\n      _, current_state, path = heappop(queue)\n\n      if satisfies_goal(current_state, goal_item):\n        return path\n\n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      valid_actions = []\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n          \n          if can_make_goal:\n            valid_actions.append(action)\n        else:\n          valid_actions.append(action)\n\n      # Prioritize actions that could lead to making the goal item\n      for action in valid_actions:\n        reward, new_state = current_state.step(action)\n        \n        # Calculate heuristic: number of primitives still needed\n        current_primitives = get_primitive_counts(new_state.world.cookbook.index.get(\"_key\", -1), new_state.world.cookbook)\n        heuristic = sum(max(0, goal_primitives[p] - current_primitives.get(p, 0)) for p in goal_primitives)\n\n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          heappush(queue, (heuristic, new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
