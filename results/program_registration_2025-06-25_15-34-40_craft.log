not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T11:14:38.815642", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Prioritize actions that can contribute to making the goal item\n          priority_actions = []\n          regular_actions = []\n          \n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      priority_actions.append((action, reward, new_state))\n                  else:\n                      regular_actions.append((action, reward, new_state))\n              else:\n                  regular_actions.append((action, reward, new_state))\n          \n          # Prioritize actions that lead to states closer to the goal\n          def is_closer_to_goal(state):\n              new_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n              current_inventory = state.inventory\n              for primitive, count in goal_primitives.items():\n                  if current_inventory[primitive] < count:\n                      return True\n              return False\n          \n          # Sort priority actions by proximity to the goal\n          priority_actions.sort(key=lambda x: is_closer_to_goal(x[2]), reverse=True)\n          \n          # Sort regular actions randomly (or based on another heuristic if needed)\n          np.random.shuffle(regular_actions)\n          \n          for action, reward, new_state in priority_actions + regular_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-27T11:15:44.730482", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def is_reachable(current_state, goal_item):\n      # Check if the goal item can be crafted from available items and primitives\n      goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n      for primitive, count in goal_primitives.items():\n          if current_state.inventory[primitive] < count:\n              return False\n      \n      return True\n\n  def find_path(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited_states = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Check if the new state is reachable to the goal item\n              if action == 4 and not is_reachable(new_state, goal_item):\n                  continue  # Skip this action as it doesn't help make the goal item\n\n              state_hash = hash_state(new_state)\n              \n              if state_hash not in visited_states:\n                  visited_states.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def hash_state(state):\n      # Create a unique hash for the state based on grid and inventory\n      grid_tuple = tuple(map(tuple, state.grid.reshape(-1, initial_state.world.n_kinds)))\n      inventory_tuple = tuple(state.inventory)\n      position_tuple = tuple(state.pos)\n      direction_tuple = (state.dir,)\n      \n      return (grid_tuple, inventory_tuple, position_tuple, direction_tuple)\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = find_path(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
