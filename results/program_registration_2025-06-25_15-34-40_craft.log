{"timestamp": "2025-06-26T17:33:48.505553", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=50):  # Added max depth to prevent infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= max_depth:  # Check against the maximum depth allowed\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def retry_bfs_search(env, goal_item, max_retries=5):\n    for _ in range(max_retries):\n        env.reset()\n        initial_state = env._current_state\n        action_sequence = bfs_search(initial_state, goal_item)\n        if action_sequence:\n            return action_sequence\n    return None\n\n  def optimize_action_sequence(action_sequence):\n      # Implement optimization logic here (e.g., remove redundant movements)\n      from collections import defaultdict\n      \n      # Remove consecutive opposite actions (e.g., LEFT RIGHT)\n      optimized_actions = []\n      i = 0\n      while i < len(action_sequence):\n          if action_sequence[i] == 0 and i + 1 < len(action_sequence) and action_sequence[i + 1] == 1:\n              i += 2\n          elif action_sequence[i] == 1 and i + 1 < len(action_sequence) and action_sequence[i + 1] == 0:\n              i += 2\n          elif action_sequence[i] == 2 and i + 1 < len(action_sequence) and action_sequence[i + 1] == 3:\n              i += 2\n          elif action_sequence[i] == 3 and i + 1 < len(action_sequence) and action_sequence[i + 1] == 2:\n              i += 2\n          else:\n              optimized_actions.append(action_sequence[i])\n              i += 1\n\n      # Further optimization can be done based on specific rules or heuristics\n      return optimized_actions\n\n  goal_item = item\n  action_sequence = retry_bfs_search(env, goal_item)\n\n  if action_sequence:\n    optimized_actions = optimize_action_sequence(action_sequence)\n    return optimized_actions\n  \n  return []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 1.5}}
