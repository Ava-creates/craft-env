{"timestamp": "2025-06-27T15:51:05.634868", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n    \n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n    \n    dfs(goal_index)\n    return primitives\n\n  def find_useable_workshops(state, goal_primitives):\n    usable_workshops = []\n    workshop_indices = state.world.workshop_indices\n    \n    for workshop in workshop_indices:\n      pos = np.argwhere(state.grid[:, :, workshop] == 1)[0]\n      if state.next_to(workshop):\n        # Check if there are enough primitives around the workshop\n        can_use = True\n        for primitive, count in goal_primitives.items():\n          nearby_primitives_count = np.sum(state.grid[pos[0]-1:pos[0]+2, pos[1]-1:pos[1]+2, primitive])\n          if nearby_primitives_count < count:\n            can_use = False\n            break\n        if can_use:\n          usable_workshops.append(workshop)\n    \n    return usable_workshops\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      # Find usable workshops based on available primitives around them\n      usable_workshops = find_useable_workshops(current_state, goal_primitives)\n      \n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n          \n          if not can_make_goal or (new_state.world.index.get(new_state.grid[new_state.pos[0], new_state.pos[1], :].argmax()) not in usable_workshops):\n            continue  # Skip this action as it doesn't help make the goal item\n      \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-27T15:52:40.812929", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_recipe_path(goal_index, cookbook):\n      from collections import deque\n      \n      parents = {}\n      recipe_queue = deque([goal_index])\n      \n      while recipe_queue:\n          current_index = recipe_queue.popleft()\n          \n          if current_index in cookbook.recipes:\n              for ingredient in cookbook.recipes[current_index]:\n                  if ingredient != \"_key\" and ingredient not in parents:\n                      parents[ingredient] = current_index\n                      recipe_queue.append(ingredient)\n      \n      path = []\n      current_index = goal_index\n      \n      while current_index in parents:\n          path.append(current_index)\n          current_index = parents[current_index]\n      \n      return path[::-1]\n\n  initial_state = env._current_state\n  goal_item = item\n  recipe_path = get_recipe_path(goal_item, initial_state.world.cookbook)\n\n  action_sequence = []\n\n  for required_item in recipe_path:\n      sub_action_sequence = bfs_search(initial_state, required_item)\n      \n      if sub_action_sequence is None:\n          return []  # Return empty list if any sub-sequence fails\n      \n      action_sequence.extend(sub_action_sequence)\n      initial_state = env._current_state\n\n  final_action_sequence = bfs_search(initial_state, goal_item)\n\n  if final_action_sequence is not None:\n      action_sequence.extend(final_action_sequence)\n  \n  return action_sequence", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T15:52:42.050647", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of missing primitives needed to make the goal item\n      goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n      current_primitives = {i: state.inventory[i] for i in goal_primitives}\n      \n      return sum(max(0, count - current_primitives.get(i, 0)) for i, count in goal_primitives.items())\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {hash(initial_state): 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              state_hash = hash(new_state)\n              tentative_g_score = g_score[hash(current_state)] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (hash(current_state), action)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Add hash method to CraftState for use in the A* algorithm\n  def hash_state(state):\n      grid_tuple = tuple(map(tuple, state.grid))\n      inventory_tuple = tuple(state.inventory)\n      return hash((grid_tuple, inventory_tuple, state.pos, state.dir))\n  \n  env._current_state.__hash__ = lambda s: hash_state(s)\n\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-27T15:54:24.877704", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          action_sequence = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  action_sequence.append((new_state, path + [action]))\n          \n          # Sort action sequences by heuristic: prioritize states closer to having required primitives\n          action_sequence.sort(key=lambda x: sum(min(new_state.inventory[prim], goal_primitives[prim]) for prim in goal_primitives))\n          queue.extend(action_sequence)\n      \n      return None  # Return None if no sequence is found\n\n  def get_goal_actions(initial_state, goal_item):\n      actions = []\n      current_state = initial_state\n      \n      while not satisfies_goal(current_state, goal_item):\n          action_sequence = bfs_search(current_state, goal_item)\n          if not action_sequence:\n              break\n          \n          for action in action_sequence:\n              _, current_state = current_state.step(action)\n              actions.append(action)\n      \n      return actions\n\n  def optimize_action_sequence(actions, initial_state, goal_item):\n      # Placeholder for optimization logic (e.g., removing redundant moves)\n      # Currently returns the original sequence\n      return actions\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = get_goal_actions(initial_state, goal_item)\n  \n  optimized_actions = optimize_action_sequence(action_sequence, initial_state, goal_item)\n\n  return optimized_actions if optimized_actions else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 2.0}}
