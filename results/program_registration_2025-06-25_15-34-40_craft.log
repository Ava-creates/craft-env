{"timestamp": "2025-06-26T17:27:58.420577", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Consider only valid actions (e.g., not walking into walls)\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              # If the state is unchanged, skip adding it to the queue\n              if np.array_equal(new_state.grid, current_state.grid) and\\\n                 np.array_equal(new_state.inventory, current_state.inventory) and\\\n                 new_state.pos == current_state.pos and\\\n                 new_state.dir == current_state.dir:\n                  continue\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T17:28:11.944751", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          if not (np.array_equal(new_state.grid, state.grid) and\n                  np.array_equal(new_state.inventory, state.inventory) and\n                  new_state.pos == state.pos and\n                  new_state.dir == state.dir):\n              valid_actions.append((action, new_state))\n      return valid_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, new_state in get_valid_actions(current_state):\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T17:29:17.722755", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              # Skip USE action if there's nothing to use in the 3x3 grid around the agent or if inventory is full\n              if (action == 4 and \n                  not any(current_state.grid[\n                      max(0, current_state.pos[0]-1):min(env.scenario.init_grid.shape[0], current_state.pos[0]+2),\n                      max(0, current_state.pos[1]-1):min(env.scenario.init_grid.shape[1], current_state.pos[1]+2)\n                  ].flatten()) or\n                  np.sum(current_state.inventory) >= env.world.cookbook.n_kinds):\n                  continue\n              \n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T17:29:32.394024", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos, grid_shape):\n      x, y = pos\n      neighbors = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              neighbors.append((nx, ny))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              new_pos = current_state.pos\n              new_dir = current_state.dir\n              \n              if action == 0:  # DOWN\n                  new_pos = (new_pos[0] + 1, new_pos[1])\n              elif action == 1:  # UP\n                  new_pos = (new_pos[0] - 1, new_pos[1])\n              elif action == 2:  # LEFT\n                  new_pos = (new_pos[0], new_pos[1] - 1)\n              elif action == 3:  # RIGHT\n                  new_pos = (new_pos[0], new_pos[1] + 1)\n              elif action == 4:  # USE\n                  # Check if there's something to use in the 3x3 grid around the agent\n                  neighbors = get_neighbors(current_state.pos, current_state.grid.shape[:2])\n                  if not any(current_state.grid[nx, ny].any() for nx, ny in neighbors):\n                      continue\n\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T17:31:32.015264", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          action_sequence = []\n          can_make_goal = False\n\n          # First, try to make primitives that are needed\n          for primitive, count in goal_primitives.items():\n              if current_state.inventory[primitive] < count:\n                  new_action_seq = bfs_search_recursive(current_state, primitive)\n                  if new_action_seq is not None:\n                      action_sequence.extend(new_action_seq)\n                      can_make_goal = True\n\n          # If we have made all primitives, try to make the goal item\n          if can_make_goal or satisfies_goal(current_state, goal_item):\n              for action in range(initial_state.world.n_actions):\n                  reward, new_state = current_state.step(action)\n                  if action == 4:  # USE action\n                      # Check if the use action can contribute to making the goal item\n                      for primitive, count in goal_primitives.items():\n                          if new_state.inventory[primitive] < count:\n                              continue  # Skip this action as it doesn't help make the goal item\n                      \n                      if satisfies_goal(new_state, goal_item):\n                          action_sequence.append(action)\n                          return path + action_sequence\n      \n          # If we can't make the goal directly, explore other actions\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def bfs_search_recursive(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          action_sequence = []\n\n          # Try to make primitives that are needed\n          for primitive, count in goal_primitives.items():\n              if current_state.inventory[primitive] < count:\n                  for action in range(initial_state.world.n_actions):\n                      reward, new_state = current_state.step(action)\n                      \n                      if action == 4:  # USE action\n                          # Check if the use action can contribute to making the goal item\n                          for primitive, count in goal_primitives.items():\n                              if new_state.inventory[primitive] < count:\n                                  continue  # Skip this action as it doesn't help make the goal item\n                          \n                          if satisfies_goal(new_state, goal_item):\n                              return path + [action]\n                      \n                      # Convert the new state to a hashable form using a tuple of its attributes\n                      state_hash = (tuple(new_state.grid.flatten()), \n                                    tuple(new_state.inventory), \n                                    new_state.pos, \n                                    new_state.dir)\n                      \n                      if state_hash not in visited:\n                          visited.add(state_hash)\n                          queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 2.0}}
{"timestamp": "2025-06-26T17:31:32.993158", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def get_next_states(current_state):\n      next_states = []\n      for action in range(env.world.n_actions):\n          reward, new_state = current_state.step(action)\n          if new_state is not None:\n              next_states.append((action, new_state))\n      return next_states\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: count of primitives needed to make the goal\n      primitives_needed = get_primitive_counts(goal_item, state.world.cookbook)\n      inventory_primitives = {i: state.inventory[i] for i in state.world.primitives}\n      \n      total_cost = 0\n      for primitive, count in primitives_needed.items():\n          if inventory_primitives.get(primitive, 0) < count:\n              total_cost += count - inventory_primitives.get(primitive, 0)\n      \n      return total_cost\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Convert the current state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(current_state.grid.flatten()), \n                        tuple(current_state.inventory), \n                        current_state.pos, \n                        current_state.dir)\n          \n          if state_hash in visited:\n              continue\n          \n          visited.add(state_hash)\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action, new_state in get_next_states(current_state):\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  cost = len(path) + heuristic(new_state, goal_item)\n                  heappush(open_set, (cost, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-26T17:32:31.837212", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_possible_actions(state):\n      actions = []\n      \n      # Prioritize USE action (index 4)\n      _, new_state_after_use = state.step(4)\n      if not np.array_equal(new_state_after_use.grid, state.grid) or not np.array_equal(new_state_after_use.inventory, state.inventory):\n          actions.append(4)\n      \n      # Explore movement actions\n      for action in range(4):\n          _, new_state_after_move = state.step(action)\n          if not np.array_equal(new_state_after_move.pos, state.pos) or not np.array_equal(new_state_after_move.dir, state.dir):\n              actions.append(action)\n      \n      return actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Get possible actions based on the current state\n          actions = get_possible_actions(current_state)\n          \n          for action in actions:\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
