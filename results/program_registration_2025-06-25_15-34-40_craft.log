{"timestamp": "2025-06-26T09:13:59.783856", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_next_states(current_state):\n      next_states = []\n      for action in range(env.world.n_actions):\n          reward, new_state = current_state.step(action)\n          next_states.append((action, new_state))\n      return next_states\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))  # (f_score, state, path)\n      \n      g_scores = {initial_state: 0}\n      f_scores = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, new_state in get_next_states(current_state):\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_scores[current_state] + 1  # Each action has cost 1\n              \n              if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n                  g_scores[state_hash] = tentative_g_score\n                  f_scores[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_scores[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of items needed to craft the goal\n      item_count = state.inventory[goal_item]\n      return 1 if item_count == 0 else 0\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if action_sequence is not None:\n      # Execute the actions to reach the goal state\n      for action in action_sequence:\n          reward, done, observations = env.step(action)\n          if done:\n              break\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-26T09:14:52.280267", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic: number of primitives required to craft the goal\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      \n      count = 0\n      for primitive, required_count in primitives.items():\n          if current_state.inventory[primitive] < required_count:\n              count += required_count - current_state.inventory[primitive]\n      \n      return count\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[current_state] + 1\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if tentative_g_score < g_score.get(state_hash, float('inf')):\n                  came_from[state_hash] = (current_state, path + [action])\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T09:14:53.256036", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item, cookbook):\n      # Simple heuristic: distance from any ingredient to the agent\n      ingredients = cookbook.recipes.get(goal_item, {})\n      min_distance = float('inf')\n      \n      for ingredient in ingredients:\n          if ingredient == \"_key\":\n              continue\n          \n          ingredient_pos = np.argwhere(state.grid[:, :, ingredient] > 0)\n          if ingredient_pos.size > 0:\n              # Calculate Manhattan distance to the nearest ingredient\n              agent_pos = np.array(state.pos)\n              distances = np.sum(np.abs(ingredient_pos - agent_pos), axis=1)\n              min_distance = min(min_distance, distances.min())\n      \n      return min_distance\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item, env.world.cookbook)}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each action has a cost of 1\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, path + [action])\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item, env.world.cookbook)\n                  heappush(open_set, (f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T09:15:37.074163", "function_name": "craft", "function_body": "  def heuristic(state, goal_index):\n      # Simple heuristic: count how many items are still needed in the inventory to satisfy the goal\n      current_inventory = state.inventory.copy()\n      goal_primitives = env.world.cookbook.primitives_for(goal_index)\n      \n      remaining_items = sum(\n          max(0, required - current_inventory[primitive]) \n          for primitive, required in goal_primitives.items()\n      )\n      \n      return remaining_items\n\n  def state_representation(state):\n      return (\n          tuple(state.grid.flatten()),\n          tuple(state.pos),\n          state.dir,\n          tuple(state.inventory)\n      )\n\n  current_state = env._current_state\n  goal_index = item\n\n  # Priority queue for A* search with the initial state and an empty action sequence, heuristic value\n  open_set = [(heuristic(current_state, goal_index), current_state, [])]\n  visited_states = set()\n\n  while open_set:\n      _, current_state, actions_taken = open_set.pop(0)\n\n      # Check if the goal is satisfied in the current state\n      if current_state.satisfies(\"dummy_goal_name\", goal_index):\n          return actions_taken\n\n      # Create a unique hashable representation of the state to check if it's visited\n      state_repr = state_representation(current_state)\n      \n      if state_repr not in visited_states:\n          visited_states.add(state_repr)\n\n          # Get the next possible states by taking each action\n          for action in range(env.world.n_actions):  # Assuming there are n_actions available actions\n              reward, new_state = current_state.step(action)\n\n              # Check if the goal is satisfied after the step (early exit)\n              if new_state.satisfies(\"dummy_goal_name\", goal_index):\n                  return actions_taken + [action]\n\n              # Create a unique hashable representation of the new state to check if it's visited\n              new_state_repr = state_representation(new_state)\n\n              if new_state_repr not in visited_states:\n                  h = heuristic(new_state, goal_index)\n                  open_set.append((len(actions_taken) + h, new_state, actions_taken + [action]))\n\n      # Sort the open set by f(n) = g(n) + h(n), where g(n) is the length of the path taken so far\n      open_set.sort()\n\n  # If no solution is found within the search limit, return an empty list\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-26T09:15:48.799325", "function_name": "craft", "function_body": "  def state_representation(state):\n      return (tuple(state.grid.flatten()), \n              tuple(state.pos), \n              state.dir,\n              tuple(state.inventory))\n\n  current_state = env._current_state\n  goal_index = item\n\n  # Define a queue for BFS with the initial state and an empty action sequence\n  queue = [(state_representation(current_state), [], current_state)]\n\n  # Set to track visited states (using unique hashable representation)\n  visited_states = set()\n\n  while queue:\n      rep, actions_taken, current_state = queue.pop(0)\n\n      # Check if the goal is satisfied in the current state\n      if current_state.satisfies(\"dummy_goal_name\", goal_index):\n          return actions_taken\n\n      if rep not in visited_states:\n          visited_states.add(rep)\n\n          # Get the next possible states by taking each action\n          for action in range(env.world.n_actions):  # Assuming there are n_actions available actions\n              reward, new_state = current_state.step(action)\n\n              # Check if the goal is satisfied after the step (early exit)\n              if new_state.satisfies(\"dummy_goal_name\", goal_index):\n                  return actions_taken + [action]\n\n              new_rep = state_representation(new_state)\n\n              if new_rep not in visited_states:\n                  queue.append((new_rep, actions_taken + [action], new_state))\n\n  # If no solution is found within the BFS limit, return an empty list\n  return []", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T09:16:51.242351", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Limit the number of steps to prevent infinite loops\n          if len(path) >= max_steps:\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Try crafting the item directly first\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If direct crafting fails, try collecting primitives and then crafting\n      cookbook = env.world.cookbook\n      primitives_needed = cookbook.primitives_for(goal_item)\n      \n      for primitive in primitives_needed:\n          primitive_index = next(iter(primitives_needed))\n          \n          # Collect the primitive\n          collect_action_sequence = bfs_search(initial_state, primitive_index)\n          if collect_action_sequence:\n              action_sequence.extend(collect_action_sequence)\n              \n              # After collecting, try crafting again\n              new_state = initial_state\n              for action in collect_action_sequence:\n                  _, new_state = new_state.step(action)\n              \n              craft_action_sequence = bfs_search(new_state, goal_item)\n              if craft_action_sequence:\n                  action_sequence.extend(craft_action_sequence)\n                  return action_sequence\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T09:16:51.311438", "function_name": "craft", "function_body": "    def satisfies_goal(state, goal_item):\n        return state.inventory[goal_item] > 0\n\n    def bfs_search(initial_state, goal_item, visited=None):\n        from collections import deque\n        \n        if visited is None:\n            visited = set()\n        \n        queue = deque([(initial_state, [])])\n        \n        while queue:\n            current_state, path = queue.popleft()\n            \n            if satisfies_goal(current_state, goal_item):\n                return path\n            \n            for action in range(env.world.n_actions):\n                reward, new_state = current_state.step(action)\n                \n                # Convert the new state to a hashable form using a tuple of its attributes\n                state_hash = (tuple(new_state.grid.flatten()), \n                              tuple(new_state.inventory), \n                              new_state.pos, \n                              new_state.dir)\n                \n                if state_hash not in visited:\n                    visited.add(state_hash)\n                    queue.append((new_state, path + [action]))\n        \n        return None  # Return None if no sequence is found\n\n    initial_state = env._current_state\n    goal_item = item\n    \n    # Try crafting the item directly first\n    action_sequence = bfs_search(initial_state, goal_item)\n\n    if not action_sequence:\n        # If direct crafting fails, try collecting primitives and then crafting\n        cookbook = env.world.cookbook\n        primitives_needed = cookbook.primitives_for(goal_item)\n        \n        for primitive_index in primitives_needed:\n            # Collect the primitive\n            collect_action_sequence = bfs_search(initial_state, primitive_index)\n            if collect_action_sequence:\n                action_sequence.extend(collect_action_sequence)\n                \n                # After collecting, try crafting again\n                new_state = initial_state\n                for action in collect_action_sequence:\n                    _, new_state = new_state.step(action)\n                \n                craft_action_sequence = bfs_search(new_state, goal_item, visited=set())\n                if craft_action_sequence:\n                    action_sequence.extend(craft_action_sequence)\n                    return action_sequence\n    \n    return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-26T09:17:33.724443", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic_cost_estimate(current_state, goal_item):\n      # Heuristic based on the number of steps taken and inventory status\n      return -sum(current_state.inventory) + len(env._current_state.step(4)[1].inventory)\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory): 0}\n      \n      while open_set:\n          current_f_score, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in [4] + list(range(4)):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              new_state_hash = (tuple(new_state.grid.flatten()), tuple(new_state.inventory))\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory)] + 1\n              \n              if new_state_hash not in g_score or tentative_g_score < g_score[new_state_hash]:\n                  g_score[new_state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic_cost_estimate(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-06-26T09:17:34.694591", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      \"\"\"Estimate the cost from current state to the goal.\"\"\"\n      # Simple heuristic: number of items needed for the goal item\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory\n      missing_items = sum(max(0, count - current_inventory[i]) for i, count in primitives.items())\n      return missing_items\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          current_cost, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE actions to speed up crafting\n          for action in [4] + list(range(4)):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  cost = current_cost + 1 + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (cost, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T09:18:23.115325", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item) or len(path) >= max_steps:\n              return path\n          \n          # Consider only valid actions (movements and USE)\n          for action in [0, 1, 2, 3, 4]:  \n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T09:18:24.102890", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue for A* search\n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      \n      # Set to track visited states\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in [0, 1, 2, 3, 4]:  # Consider all possible actions\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n\n                  # Calculate heuristic (here we use the inventory count as a simple heuristic)\n                  h = -new_state.inventory[goal_item]\n                  \n                  heapq.heappush(open_set, (h, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T09:20:13.744922", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def a_star_search(initial_pos, goal_pos):\n      from heapq import heappush, heappop\n      from collections import defaultdict\n      \n      open_set = []\n      heappush(open_set, (0, initial_pos, []))\n      came_from = {}\n      g_score = defaultdict(lambda: float('inf'))\n      g_score[initial_pos] = 0\n      f_score = defaultdict(lambda: float('inf'))\n      f_score[initial_pos] = heuristic(initial_pos, goal_pos)\n      \n      while open_set:\n          _, current_pos, path = heappop(open_set)\n          \n          if current_pos == goal_pos:\n              return path\n      \n          for neighbor in get_neighbors(current_pos):\n              tentative_g_score = g_score[current_pos] + 1\n              \n              if tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = (current_pos, path)\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  heappush(open_set, (f_score[neighbor], neighbor, path + [neighbor]))\n      \n      return None\n      \n  def heuristic(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0: \n          neighbors.append((x - 1, y))\n      if x < env.world.scenario.init_grid.shape[0] - 1: \n          neighbors.append((x + 1, y))\n      if y > 0: \n          neighbors.append((x, y - 1))\n      if y < env.world.scenario.init_grid.shape[1] - 1: \n          neighbors.append((x, y + 1))\n      return neighbors\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Find positions of resources needed for the goal in the grid\n  required_resources = env.world.cookbook.primitives_for(goal_item).keys()\n  resource_positions = [(x, y) \n                        for x in range(env.world.scenario.init_grid.shape[0]) \n                        for y in range(env.world.scenario.init_grid.shape[1]) \n                        if any(env.world.scenario.init_grid[x, y, res] > 0 for res in required_resources)]\n  \n  if not resource_positions:\n      return []  # No resources found to move towards\n  \n  closest_resource = min(resource_positions, key=lambda pos: heuristic(pos, initial_state.pos))\n  \n  # Perform A* search to move closer to the closest resource\n  resource_path = a_star_search(initial_state.pos, closest_resource)\n  \n  if not resource_path:\n      return []  # No path found to the resource\n  \n  action_sequence = []\n  current_pos = initial_state.pos\n  direction_mapping = {0: (0, -1), 1: (0, 1), 2: (-1, 0), 3: (1, 0)}\n  \n  for next_pos in resource_path:\n      dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n      \n      # Determine the direction to move\n      if dx == 1:\n          action_sequence.append(3)  # RIGHT\n      elif dx == -1:\n          action_sequence.append(2)  # LEFT\n      elif dy == 1:\n          action_sequence.append(1)  # DOWN\n      elif dy == -1:\n          action_sequence.append(0)  # UP\n      \n      current_pos = next_pos\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-26T09:20:14.701569", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos, width, height):\n      x, y = pos\n      neighbors = []\n      if x > 0: \n          neighbors.append((x - 1, y))\n      if x < width - 1: \n          neighbors.append((x + 1, y))\n      if y > 0: \n          neighbors.append((x, y - 1))\n      if y < height - 1: \n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def heuristic(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def a_star_search(start_pos, goal_pos, grid):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, start_pos, []))\n      came_from = {}\n      g_score = {start_pos: 0}\n      f_score = {start_pos: heuristic(start_pos, goal_pos)}\n      \n      while open_set:\n          _, current_pos, path = heappop(open_set)\n          \n          if current_pos == goal_pos:\n              return path\n          \n          for neighbor in get_neighbors(current_pos, grid.shape[0], grid.shape[1]):\n              tentative_g_score = g_score[current_pos] + 1\n              \n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = (current_pos, path)\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  heappush(open_set, (f_score[neighbor], neighbor, path + [neighbor]))\n      \n      return None\n\n  def find_resource_positions(grid, required_resources):\n      width, height, _ = grid.shape\n      resource_positions = [(x, y) \n                            for x in range(width) \n                            for y in range(height) \n                            if any(grid[x, y, res] > 0 for res in required_resources)]\n      return resource_positions\n\n  def convert_position_to_action(current_pos, next_pos):\n      dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n      \n      if dx == 1:\n          return 3  # RIGHT\n      elif dx == -1:\n          return 2  # LEFT\n      elif dy == 1:\n          return 1  # DOWN\n      elif dy == -1:\n          return 0  # UP\n      \n      return None\n\n  def move_to_position(current_state, target_pos):\n      resource_path = a_star_search(current_state.pos, target_pos, current_state.grid)\n      \n      if not resource_path:\n          return []\n      \n      action_sequence = []\n      current_pos = current_state.pos\n      \n      for next_pos in resource_path:\n          action = convert_position_to_action(current_pos, next_pos)\n          if action is not None:\n              action_sequence.append(action)\n              current_pos = next_pos\n      \n      return action_sequence\n\n  def craft_item(env, goal_item):\n      initial_state = env._current_state\n      required_resources = env.world.cookbook.primitives_for(goal_item).keys()\n      \n      while not satisfies_goal(initial_state, goal_item):\n          resource_positions = find_resource_positions(initial_state.grid, required_resources)\n          \n          if not resource_positions:\n              return []  # No resources found to move towards\n          \n          closest_resource = min(resource_positions, key=lambda pos: heuristic(pos, initial_state.pos))\n          \n          action_sequence_to_move = move_to_position(initial_state, closest_resource)\n          \n          if not action_sequence_to_move:\n              return []\n          \n          for action in action_sequence_to_move:\n              env._current_state, _ = env._current_state.step(action)\n          \n          # Try to pick up the resource\n          env._current_state, _ = env._current_state.step(4)  # Assuming action 4 is USE/PICKUP\n      \n          initial_state = env._current_state\n      \n      return bfs_search(initial_state, goal_item)\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = craft_item(env, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-26T09:21:07.007266", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that involve using items or interacting with the environment\n          priority_actions = [4] + list(range(env.world.n_actions - 1))  # Use action first, then others\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T09:21:24.157203", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def prioritize_actions(current_state):\n      priority_actions = []\n      \n      # Prioritize the USE action\n      reward, use_state = current_state.step(4)\n      if not np.array_equal(use_state.grid, current_state.grid) or \\\n         not np.array_equal(use_state.inventory, current_state.inventory) or \\\n         use_state.pos != current_state.pos or \\\n         use_state.dir != current_state.dir:\n          priority_actions.append((4, use_state))\n      \n      # Prioritize moving actions\n      for action in range(4):\n          reward, move_state = current_state.step(action)\n          if not np.array_equal(move_state.grid, current_state.grid) or \\\n             not np.array_equal(move_state.inventory, current_state.inventory) or \\\n             move_state.pos != current_state.pos or \\\n             move_state.dir != current_state.dir:\n              priority_actions.append((action, move_state))\n      \n      return [action for action, _ in priority_actions]\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          priority_actions = prioritize_actions(current_state)\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T09:22:17.883857", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item) or len(path) >= max_steps:\n              return path\n          \n          # Prioritize actions that involve using items (USE action)\n          priority_actions = [4] + list(range(env.world.n_actions - 1))  # Use action first, then others\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T09:22:18.902418", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      # Calculate the Manhattan distance to the nearest workshop\n      min_distance = float('inf')\n      \n      for pos in current_state.world.workshop_indices:\n          x1, y1 = current_state.pos\n          x2, y2 = divmod(pos, env.scenario.init_grid.shape[0])\n          distance = abs(x1 - x2) + abs(y1 - y2)\n          min_distance = min(min_distance, distance)\n      \n      return min_distance\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      \n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + initial_state.pos + (initial_state.dir,): 0}\n      f_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + initial_state.pos + (initial_state.dir,): heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in [0, 1, 2, 3, 4]:  \n              reward, new_state = current_state.step(action)\n              \n              state_tuple = tuple(new_state.grid.flatten()) + tuple(new_state.inventory) + new_state.pos + (new_state.dir,)\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + current_state.pos + (current_state.dir,)] + 1\n              \n              if state_tuple not in g_score or tentative_g_score < g_score[state_tuple]:\n                  g_score[state_tuple] = tentative_g_score\n                  f_score[state_tuple] = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score[state_tuple], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T09:23:09.472831", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Check if the current depth exceeds the maximum allowed depth\n          if len(path) >= max_depth:\n              continue\n\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def retry_bfs_search(env, goal_item):\n    print(\"First BFS search failed. Resetting environment and retrying...\")\n    \n    # Reset the environment to a new scenario with the same goal\n    env.world.sample_scenario()\n    initial_state = env._current_state\n    \n    action_sequence = bfs_search(initial_state, goal_item)\n    \n    return action_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      action_sequence = retry_bfs_search(env, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 1.5}}
