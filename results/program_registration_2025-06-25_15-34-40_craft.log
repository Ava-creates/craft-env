{"timestamp": "2025-06-27T13:05:05.259219", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      possible_actions.append((action, new_state))\n              else:  # MOVEMENT actions\n                  # Ensure movement actions only add to the path if they lead to new states with primitives or closer to goal\n                  for primitive in goal_primitives:\n                      if new_state.next_to(primitive):\n                          possible_actions.append((action, new_state))\n          \n          for action, new_state in possible_actions:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-06-27T13:05:15.655572", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      possible_actions.append((action, reward, new_state))\n              else:  # MOVEMENT actions\n                  possible_actions.append((action, reward, new_state))\n          \n          # Sort actions based on the number of primitives collected or used\n          possible_actions.sort(key=lambda x: sum(x[2].inventory), reverse=True)\n          \n          for action, _, new_state in possible_actions:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = []\n  max_attempts = 10  # Increase attempts to handle more complex recipes\n  attempts = 0\n      \n  while not satisfies_goal(initial_state, goal_item) and attempts < max_attempts:\n      path = bfs_search(initial_state, goal_item)\n      if path is None:\n          break\n      \n      action_sequence.extend(path)\n      \n      # Apply the found actions to the environment\n      for action in path:\n          reward, done, observations = env.step(action)\n          \n          if done or satisfies_goal(env._current_state, goal_item):\n              return action_sequence\n      \n      initial_state = env._current_state\n      attempts += 1\n\n  return action_sequence if satisfies_goal(env._current_state, goal_item) else []", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T13:07:50.152162", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_action_sequence(actions):\n      # Simple heuristic: remove consecutive moves in opposite directions\n      optimized_actions = []\n      i = 0\n      \n      while i < len(actions):\n          current_action = actions[i]\n          \n          if current_action == 0:  # DOWN\n              if i + 1 < len(actions) and actions[i + 1] == 1:  # UP\n                  i += 2  # Skip both actions\n                  continue\n          elif current_action == 1:  # UP\n              if i + 1 < len(actions) and actions[i + 1] == 0:  # DOWN\n                  i += 2  # Skip both actions\n                  continue\n          elif current_action == 2:  # LEFT\n              if i + 1 < len(actions) and actions[i + 1] == 3:  # RIGHT\n                  i += 2  # Skip both actions\n                  continue\n          elif current_action == 3:  # RIGHT\n              if i + 1 < len(actions) and actions[i + 1] == 2:  # LEFT\n                  i += 2  # Skip both actions\n                  continue\n          \n          optimized_actions.append(current_action)\n          i += 1\n      \n      return optimized_actions\n\n  def greedy_pickup_strategy(state, goal_primitives):\n      \"\"\"\n      Greedily picks up primitives needed for the goal item.\n      This strategy helps in reducing unnecessary movements by picking up all required items at once if possible.\n      \"\"\"\n      actions = []\n      \n      for primitive, count_needed in goal_primitives.items():\n          while state.inventory[primitive] < count_needed:\n              # Find a path to the nearest primitive\n              path_to_primitive = bfs_search(state, primitive)\n              \n              if not path_to_primitive:\n                  break  # If no path found, continue with other primitives or return as is.\n              \n              actions.extend(path_to_primitive)\n              \n              # Execute the path and collect the primitive\n              for action in path_to_primitive:\n                  reward, state = state.step(action)\n      \n      return actions, state\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Greedily pick up all required primitives first\n  goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n  pickup_actions, updated_state = greedy_pickup_strategy(initial_state, goal_primitives)\n  \n  # Now search for the sequence to make the goal item using the updated state\n  action_sequence = bfs_search(updated_state, goal_item)\n\n  if action_sequence:\n      optimized_sequence = optimize_action_sequence(pickup_actions + action_sequence)\n      return optimized_sequence\n  \n  return []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T13:07:51.398139", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_action_sequence(actions):\n      # Simple heuristic: remove consecutive moves in opposite directions\n      optimized_actions = []\n      i = 0\n      \n      while i < len(actions):\n          current_action = actions[i]\n          \n          if current_action == 0:  # DOWN\n              if i + 1 < len(actions) and actions[i + 1] == 1:  # UP\n                  i += 2  # Skip both actions\n                  continue\n          elif current_action == 1:  # UP\n              if i + 1 < len(actions) and actions[i + 1] == 0:  # DOWN\n                  i += 2  # Skip both actions\n                  continue\n          elif current_action == 2:  # LEFT\n              if i + 1 < len(actions) and actions[i + 1] == 3:  # RIGHT\n                  i += 2  # Skip both actions\n                  continue\n          elif current_action == 3:  # RIGHT\n              if i + 1 < len(actions) and actions[i + 1] == 2:  # LEFT\n                  i += 2  # Skip both actions\n                  continue\n          \n          optimized_actions.append(current_action)\n          i += 1\n      \n      return optimized_actions\n\n  def heuristic(state, goal_item):\n      \"\"\"Estimate the cost to reach the goal based on available primitives.\"\"\"\n      goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n      missing_primitives = sum(\n          max(0, goal_primitives[primitive] - state.inventory[primitive])\n          for primitive in goal_primitives\n      )\n      return missing_primitives\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  \n                  state_hash = (tuple(new_state.grid.flatten()), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir)\n                  \n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # First try A* search\n  action_sequence = a_star_search(initial_state, goal_item)\n  \n  if not action_sequence:\n      # Fallback to BFS if A* fails\n      action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n      optimized_sequence = optimize_action_sequence(action_sequence)\n      return optimized_sequence\n  \n  return []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-27T13:09:53.503130", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n    \"\"\"Finds the shortest path to achieve the goal item using BFS.\"\"\"\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        # Collect primitives needed for the goal item\n        goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n        \n        # Prioritize actions based on available inventory and required primitives\n        priority_actions = prioritize_actions(current_state, goal_primitives)\n        \n        for action in priority_actions:\n            reward, new_state = current_state.step(action)\n            \n            if action == 4:  # USE action\n                # Check if the use action can contribute to making the goal item\n                can_make_goal = True\n                for primitive, count in goal_primitives.items():\n                    if new_state.inventory[primitive] < count:\n                        can_make_goal = False\n                        break\n                \n                if not can_make_goal:\n                    continue  # Skip this action as it doesn't help make the goal item\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def prioritize_actions(current_state, goal_primitives):\n    \"\"\"Prioritize actions based on the current state and required primitives.\"\"\"\n    priority_actions = []\n    \n    for action in range(current_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n            # Check if the use action can contribute to making the goal item\n            can_make_goal = True\n            for primitive, count in goal_primitives.items():\n                if new_state.inventory[primitive] < count:\n                    can_make_goal = False\n                    break\n            \n            if not can_make_goal:\n                continue  # Skip this action as it doesn't help make the goal item\n        \n        # Calculate a score based on the amount of primitives collected or used\n        score = sum(new_state.inventory)\n        priority_actions.append((action, reward, new_state, score))\n    \n    # Sort actions based on the score (higher score means more progress towards the goal)\n    priority_actions.sort(key=lambda x: x[3], reverse=True)\n    return [action for action, _, _, _ in priority_actions]\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = []\n  max_attempts = 10  # Increase attempts to handle more complex recipes\n  attempts = 0\n      \n  while not satisfies_goal(initial_state, goal_item) and attempts < max_attempts:\n      path = bfs_search(initial_state, goal_item)\n      if path is None:\n          break\n      \n      action_sequence.extend(path)\n      \n      # Apply the found actions to the environment\n      for action in path:\n          reward, done, observations = env.step(action)\n          \n          if done or satisfies_goal(env._current_state, goal_item):\n              return action_sequence\n      \n      initial_state = env._current_state\n      attempts += 1\n\n  return action_sequence if satisfies_goal(env._current_state, goal_item) else []", "island_id": 3, "scores": {"3": 2.0}}
