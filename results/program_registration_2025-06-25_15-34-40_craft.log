{"timestamp": "2025-06-26T14:22:46.053006", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_possible_actions(state):\n      possible_actions = []\n      for action in range(env.world.n_actions):\n          _, new_state = state.step(action)\n          if any(new_state.grid.flatten()) or any(new_state.inventory) or new_state.pos != state.pos:\n              possible_actions.append(action)\n      return possible_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          possible_actions = get_possible_actions(current_state)\n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_path(path):\n      \"\"\"Optimizes the given path by removing unnecessary movements.\"\"\"\n      optimized_path = []\n      for i in range(len(path)):\n          action = path[i]\n          if i < len(path) - 1:\n              next_action = path[i + 1]\n              \n              # Combine consecutive opposite moves\n              if (action == 0 and next_action == 1) or (action == 1 and next_action == 0):\n                  continue\n              elif (action == 2 and next_action == 3) or (action == 3 and next_action == 2):\n                  continue\n              \n          optimized_path.append(action)\n      return optimized_path\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n      action_sequence = optimize_path(action_sequence)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:22:47.052130", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_possible_actions(state):\n      possible_actions = []\n      for action in range(env.world.n_actions):\n          _, new_state = state.step(action)\n          if any(new_state.grid.flatten()) or any(new_state.inventory) or new_state.pos != state.pos:\n              possible_actions.append(action)\n      return possible_actions\n\n  def heuristic(state, goal_item):\n      \"\"\"Simple heuristic: Manhattan distance to the nearest required item.\"\"\"\n      required_items = env.world.cookbook.primitives_for(goal_item).keys()\n      grid = state.grid\n      pos = state.pos\n      \n      min_dist = float('inf')\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if any(grid[x, y, list(required_items)]):\n                  dist = abs(x - pos[0]) + abs(y - pos[1])\n                  min_dist = min(min_dist, dist)\n      \n      return min_dist\n\n  def astar_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))  # (f_score, state, path)\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          possible_actions = get_possible_actions(current_state)\n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assume all actions have cost 1\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:24:33.825084", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Limit the number of steps to prevent infinite loops\n          if len(path) >= 500:\n              continue\n          \n          for action in range(env.world.n_actions):\n              _, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_primitives_needed(env, goal_item):\n      cookbook = env.world.cookbook\n      primitives_needed = {}\n      to_process = [(goal_item, 1)]\n\n      while to_process:\n          item, count = to_process.pop()\n          \n          if item in cookbook.primitives:\n              primitives_needed[item] = primitives_needed.get(item, 0) + count\n              continue\n\n          recipe = cookbook.recipes.get(item)\n          if not recipe:\n              continue\n\n          for ingredient, amount in recipe.items():\n              if ingredient == \"_key\":\n                  continue\n              to_process.append((ingredient, amount * count))\n      \n      return primitives_needed\n\n  def collect_primitives(env, initial_state, primitives_needed):\n      action_sequence = []\n      \n      for primitive, needed_count in primitives_needed.items():\n          while initial_state.inventory[primitive] < needed_count:\n              collect_action_sequence = bfs_search(initial_state, primitive)\n              if not collect_action_sequence:\n                  return None  # Unable to find a sequence to collect the primitive\n              \n              action_sequence.extend(collect_action_sequence)\n              for action in collect_action_sequence:\n                  _, initial_state = initial_state.step(action)\n      \n      return action_sequence\n\n  def craft_with_primitives(env, state, goal_item):\n      primitives_needed = get_primitives_needed(env, goal_item)\n      \n      # Check if we have all required primitives\n      for primitive, needed_count in primitives_needed.items():\n          if state.inventory[primitive] < needed_count:\n              return None  # Not enough primitives to craft the item\n      \n      action_sequence = []\n      to_process = [(goal_item, 1)]\n\n      while to_process:\n          item, count = to_process.pop()\n          \n          if item in env.world.cookbook.primitives:\n              continue\n\n          recipe = env.world.cookbook.recipes.get(item)\n          if not recipe:\n              return None\n\n          for ingredient, amount in recipe.items():\n              if ingredient == \"_key\":\n                  continue\n              \n              # Find a way to craft the ingredient using available primitives\n              ingredient_sequence = bfs_search(state, ingredient)\n              if not ingredient_sequence:\n                  return None  # Unable to find a sequence to craft the ingredient\n              \n              action_sequence.extend(ingredient_sequence)\n              for action in ingredient_sequence:\n                  _, state = state.step(action)\n              \n              to_process.append((ingredient, amount * count))\n      \n      return action_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Try crafting the item directly first\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If direct crafting fails, try collecting primitives and then crafting\n      collect_action_sequence = collect_primitives(env, initial_state, get_primitives_needed(env, goal_item))\n      if not collect_action_sequence:\n          return []  # Unable to find a sequence to collect all primitives\n      \n      action_sequence.extend(collect_action_sequence)\n      \n      # After collecting, try crafting again\n      new_state = initial_state\n      for action in collect_action_sequence:\n          _, new_state = new_state.step(action)\n      \n      craft_action_sequence = bfs_search(new_state, goal_item)\n      if not craft_action_sequence:\n          return []  # Unable to find a sequence to craft the item\n      \n      action_sequence.extend(craft_action_sequence)\n\n  else:\n      # If direct crafting is possible, verify if primitives are available\n      new_state = initial_state\n      for action in action_sequence:\n          _, new_state = new_state.step(action)\n      \n      if not satisfies_goal(new_state, goal_item):\n          return []  # Direct crafting failed\n\n  return action_sequence", "island_id": 3, "scores": {"3": 1.5}}
