{"timestamp": "2025-06-26T18:39:14.973326", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=500, timeout=60):  # Timeout in seconds\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      start_time = time.time()\n      \n      while queue:\n          if time.time() - start_time > timeout:\n              print(\"Timeout reached.\")\n              break\n          \n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Check if the current depth exceeds the maximum allowed depth\n          if len(path) >= max_depth:\n              continue\n\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T18:39:15.980901", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: count the number of steps needed to collect all required primitives\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      \n      steps_to_collect_primitives = sum(\n          primitives.get(primitive_index, 0) \n          for primitive_index in primitives\n      )\n      \n      return steps_to_collect_primitives\n\n  def a_star_search(initial_state, goal_item, max_depth=500):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0 + heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          # Check if the current depth exceeds the maximum allowed depth\n          if len(path) >= max_depth:\n              continue\n\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each step costs 1\n      \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = current_state\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n      while current_state in came_from:\n          state_hash = (tuple(current_state.grid.flatten()), \n                        tuple(current_state.inventory), \n                        current_state.pos, \n                        current_state.dir)\n          current_state = came_from[state_hash]\n          path.append(action)  # Append the action taken to reach this state\n      return path[::-1]  # Reverse the path to get it from start to goal\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:39:56.764285", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      from collections import defaultdict\n      import heapq\n      \n      open_set = []\n      closed_set = set()\n      \n      # Priority queue to store (f_score, g_score, state, path)\n      heapq.heappush(open_set, (0, 0, initial_state, []))\n      \n      g_scores = {hash(initial_state): 0}\n      f_scores = {hash(initial_state): heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_g_score, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          closed_set.add(hash(current_state))\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = hash(new_state)\n              \n              if state_hash in closed_set:\n                  continue\n              \n              tentative_g_score = current_g_score + 1  # Assuming each action has cost 1\n            \n              if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n                  g_scores[state_hash] = tentative_g_score\n                  f_scores[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  \n                  heapq.heappush(open_set, (f_scores[state_hash], tentative_g_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      \"\"\"Estimates the cost to reach the goal from the current state.\"\"\"\n      # Simple heuristic: count how many more items are needed\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      required_counts = sum(primitives.get(kind_index, 0) for kind_index in env.world.grabbable_indices)\n      return required_counts - sum(state.inventory[kind_index] for kind_index in env.world.grabbable_indices)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
