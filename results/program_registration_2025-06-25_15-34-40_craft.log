{"timestamp": "2025-06-26T22:35:20.043292", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n\n          # If the state is unchanged, skip adding it to the queue\n          if np.array_equal(new_state.grid, state.grid) and\\\n             np.array_equal(new_state.inventory, state.inventory) and\\\n             new_state.pos == state.pos and\\\n             new_state.dir == state.dir:\n              continue\n\n          valid_actions.append((action, new_state))\n      return valid_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, new_state in get_valid_actions(current_state):\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic to estimate the cost from the current state to the goal.\"\"\"\n      # Simple heuristic: number of steps required to collect all primitives needed for the goal item\n      # This can be further refined based on actual recipe requirements and distances to resources.\n      \n      # Get the primitives needed for the goal item\n      def get_primitives(primitives_dict, item):\n          if item in primitives_dict:\n              return primitives_dict[item]\n          \n          # If not directly available, calculate recursively\n          ingredients = env.world.cookbook.recipes.get(item, {}).copy()\n          ingredients.pop(\"_key\", None)\n          primitives = {}\n          \n          for ingredient, count in ingredients.items():\n              sub_primitives = get_primitives(primitives_dict, ingredient)\n              for k, v in sub_primitives.items():\n                  if k not in primitives:\n                      primitives[k] = 0\n                  primitives[k] += v * count\n          \n          # Cache the result to avoid redundant calculations\n          primitives_dict[item] = primitives.copy()\n          return primitives\n      \n      primitives_needed = get_primitives({}, goal_item)\n      \n      def calculate_distance_to_primitive(primitive):\n          \"\"\"Calculate an estimate of the distance from the current position to a primitive.\"\"\"\n          # Simple heuristic: find the closest primitive on the grid and use Manhattan distance\n          min_distance = float('inf')\n          \n          for x in range(env.world.WIDTH):\n              for y in range(env.world.HEIGHT):\n                  if state.grid[x, y, primitive] > 0:\n                      distance = abs(x - state.pos[0]) + abs(y - state.pos[1])\n                      if distance < min_distance:\n                          min_distance = distance\n          \n          return min_distance\n      \n      # Estimate the total heuristic cost as the sum of distances to all primitives needed\n      total_cost = 0\n      for primitive, count in primitives_needed.items():\n          total_cost += calculate_distance_to_primitive(primitive) * count\n      \n      return total_cost\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid and can be crafted or is a primitive\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  if goal_item in env.world.non_grabbable_indices:\n      raise ValueError(f\"Goal item {goal_item} is non-grabbable and cannot be crafted.\")\n\n  # If the goal item is already available, return an empty path\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  # Use A* search with the heuristic function to find the optimal path\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))  # (f_score, state, path)\n      g_scores = {initial_state: 0}\n      f_scores = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, new_state in get_valid_actions(current_state):\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_scores[current_state] + 1  # Assuming each action has cost 1\n\n              if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n                  g_scores[state_hash] = tentative_g_score\n                  f_scores[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_scores[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
