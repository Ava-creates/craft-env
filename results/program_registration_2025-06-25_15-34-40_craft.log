{"timestamp": "2025-06-26T15:05:04.785146", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(pos, grid, target_kind):\n      \"\"\"Heuristic based on Manhattan distance to the nearest accessible cell with the target kind.\"\"\"\n      min_distance = float('inf')\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x, y, target_kind] > 0:\n                  distance = abs(x - pos[0]) + abs(y - pos[1])\n                  min_distance = min(min_distance, distance)\n      return min_distance\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      from collections import defaultdict\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      \n      g_score = defaultdict(lambda: float('inf'))\n      g_score[(tuple(initial_state.grid.flatten()), \n                tuple(initial_state.inventory), \n                initial_state.pos, \n                initial_state.dir)] = 0\n      \n      came_from = {}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()), \n                                          tuple(current_state.inventory), \n                                          current_state.pos, \n                                          current_state.dir] + 1  # Assuming each action has a cost of 1\n              \n              if tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state.pos, new_state.grid, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n      total_path = path\n      state_hash = (tuple(current_state.grid.flatten()), \n                    tuple(current_state.inventory), \n                    current_state.pos, \n                    current_state.dir)\n      while state_hash in came_from:\n          (previous_state, previous_path) = came_from[state_hash]\n          total_path = previous_path + [path[-1]]\n          state_hash = (tuple(previous_state.grid.flatten()), \n                        tuple(previous_state.inventory), \n                        previous_state.pos, \n                        previous_state.dir)\n          path = previous_path\n      return total_path\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
