{"timestamp": "2025-06-26T14:58:41.945911", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_next_states(current_state):\n    next_states = []\n    for action in range(env.world.n_actions):\n      reward, new_state = current_state.step(action)\n      if new_state is not None:\n        next_states.append((action, new_state))\n    return next_states\n\n  def bfs_search(initial_state, goal_item, max_depth=None):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # If a maximum depth is specified and the current depth exceeds it, skip further expansion\n      if max_depth is not None and len(path) >= max_depth:\n        continue\n      \n      for action, new_state in get_next_states(current_state):\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from the current state to the goal.\n      This is a simple heuristic that returns 1 if the inventory has less than 2 items,\n      otherwise it returns 0.\"\"\"\n      return 1 if sum(state.inventory) < 2 else 0\n\n  def a_star_search(initial_state, goal_item):\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, initial_state, []))\n    \n    g_score = {tuple(initial_state.grid.flatten()): 0}\n    f_score = {tuple(initial_state.grid.flatten()): heuristic(initial_state, goal_item)}\n    came_from = {}\n    \n    while open_set:\n      _, current_state, path = heapq.heappop(open_set)\n      \n      if satisfies_goal(current_state, goal_item):\n        return reconstruct_path(came_from, current_state)\n      \n      for action, new_state in get_next_states(current_state):\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        tentative_g_score = g_score[tuple(current_state.grid.flatten())] + 1\n        \n        if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n          came_from[new_state] = (current_state, path + [action])\n          g_score[state_hash] = tentative_g_score\n          f_score[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n          heapq.heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state):\n      total_path = []\n      while current_state in came_from:\n          previous_state, actions_to_current = came_from[current_state]\n          total_path = actions_to_current + total_path\n          current_state = previous_state\n      return total_path\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    print(\"Goal not reachable.\")\n    return []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:59:05.141067", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_next_states(current_state):\n    next_states = []\n    for action in range(env.world.n_actions):\n      reward, new_state = current_state.step(action)\n      if new_state is not None and not (any(new_state.grid.flatten() == env.world.water_index) or any(new_state.grid.flatten() == env.world.stone_index)):\n        next_states.append((action, new_state))\n    return next_states\n\n  def bfs_search(initial_state, goal_item, max_depth=None):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # If a maximum depth is specified and the current depth exceeds it, skip further expansion\n      if max_depth is not None and len(path) >= max_depth:\n        continue\n      \n      for action, new_state in get_next_states(current_state):\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Use a reasonable maximum depth to avoid excessive search space exploration.\n  max_depth = 50  \n  action_sequence = bfs_search(initial_state, goal_item, max_depth)\n\n  if action_sequence:\n    return action_sequence\n  else:\n    print(\"Goal not reachable.\")\n    return []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T15:00:31.456939", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      \n      # Check USE action\n      reward, use_state = state.step(4)\n      if not np.array_equal(use_state.grid, state.grid) or\\\n         not np.array_equal(use_state.inventory, state.inventory) or\\\n         use_state.pos != state.pos or\\\n         use_state.dir != state.dir:\n          valid_actions.append(4)\n      \n      # Check movement actions\n      for action in range(4):\n          reward, move_state = state.step(action)\n          if not np.array_equal(move_state.grid, state.grid) or\\\n             not np.array_equal(move_state.inventory, state.inventory) or\\\n             move_state.pos != state.pos or\\\n             move_state.dir != state.dir:\n              valid_actions.append(action)\n      \n      return valid_actions\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item) or len(path) >= max_steps:\n              return path\n          \n          valid_actions = get_valid_actions(current_state)\n          for action in valid_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T15:00:32.477793", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n    \"\"\"\n    Heuristic function to estimate the cost from the current state to the goal.\n    Here, we use a simple heuristic based on the presence of primitive resources\n    required for the goal item in the inventory or nearby grid cells.\n    \n    Args:\n        state (CraftState): Current state.\n        goal_item (int): Index of the goal item.\n\n    Returns:\n        int: Estimated cost to reach the goal.\n    \"\"\"\n    # Retrieve the cookbook index for primitives needed to craft the goal\n    primitive_counts = env.world.cookbook.primitives_for(goal_item)\n    \n    # Calculate the total count of required primitives in the inventory\n    inventory_primitives_count = sum(state.inventory[primitive_idx] for primitive_idx in primitive_counts.keys())\n    \n    # Determine how many more primitives are needed to craft the goal item\n    missing_primitives_count = sum(primitive_counts.values()) - inventory_primitives_count\n    \n    if missing_primitives_count <= 0:\n        return 1  # Goal is almost reachable or already met\n\n    # Estimate additional steps based on nearby grid cells (3x3 window around agent)\n    pos_x, pos_y = state.pos\n    neighborhood_size = 1  # 1 means a 3x3 window\n    total_nearby_primitives_count = 0\n    \n    for dx in range(-neighborhood_size, neighborhood_size + 1):\n        for dy in range(-neighborhood_size, neighborhood_size + 1):\n            nx, ny = pos_x + dx, pos_y + dy\n            \n            # Check bounds to ensure we are within the grid\n            if 0 <= nx < env.world.scenario.init_grid.shape[0] and 0 <= ny < env.world.scenario.init_grid.shape[1]:\n                nearby_cell = state.grid[nx, ny]\n                \n                # Count primitives in the nearby cell (assuming only one kind per cell)\n                for primitive_idx, count in primitive_counts.items():\n                    if nearby_cell[primitive_idx] > 0:\n                        total_nearby_primitives_count += nearby_cell[primitive_idx]\n\n    # Estimate heuristic based on missing and nearby primitives\n    estimated_cost = missing_primitives_count - total_nearby_primitives_count\n    \n    return max(estimated_cost, 1)  # Ensure the cost is at least 1\n\n  def a_star_search(initial_state, goal_item, max_steps=500):\n      from heapq import heappush, heappop\n      from collections import deque\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))  # Priority queue with (f_score, state, path)\n      \n      g_scores = {hash(initial_state): 0}  # Cost from start to current node\n      f_scores = {hash(initial_state): heuristic(initial_state, goal_item)}  # Estimated total cost from start to goal through current node\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item) or len(path) >= max_steps:\n              return path\n          \n          for action in [0, 1, 2, 3, 4]:  # Consider only valid actions (movements and USE)\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]  # Directly return the successful path\n              \n              tentative_g_score = g_scores[hash(current_state)] + 1  # Assuming each action has a cost of 1\n              state_hash = hash(new_state)\n              \n              if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n                  g_scores[state_hash] = tentative_g_score\n                  f_scores[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_scores[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:01:49.097632", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def is_workshop(pos):\n      x, y = pos\n      return env.world.workshop_indices[x, y]\n\n  def heuristic(pos, goal_item):\n      # Simple Manhattan distance to nearest workshop that has the required item\n      min_distance = float('inf')\n      for x in range(env.world.grid.shape[0]):\n          for y in range(env.world.grid.shape[1]):\n              if env.world.workshop_indices[x, y]:\n                  distance = abs(x - pos[0]) + abs(y - pos[1])\n                  min_distance = min(min_distance, distance)\n      return min_distance\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state.pos, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, path + [action])\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state.pos, goal_item)\n                  heapq.heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:01:50.086860", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def is_workshop(pos):\n      x, y = pos\n      return env.world.workshop_indices[x, y]\n\n  def heuristic(current_pos, goal_item):\n      # Calculate the minimum Manhattan distance to any workshop that has the required item\n      min_distance = float('inf')\n      for x in range(env.world.grid.shape[0]):\n          for y in range(env.world.grid.shape[1]):\n              if is_workshop((x, y)) and env.world.cookbook.primitives_for(goal_item):\n                  distance = abs(x - current_pos[0]) + abs(y - current_pos[1])\n                  min_distance = min(min_distance, distance)\n      return min_distance\n\n  def get_valid_actions(state):\n      actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          # Only add the action if it leads to a different state\n          if not np.array_equal(new_state.grid, state.grid) or \\\n             not np.array_equal(new_state.inventory, state.inventory) or \\\n             new_state.pos != state.pos or \\\n             new_state.dir != state.dir:\n              actions.append((action, new_state))\n      return actions\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import itertools\n      \n      # Priority queue for A* search\n      open_set = []\n      heappush(open_set, (0, initial_state, []))  # (f_score, state, path)\n      \n      # Costs and paths\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + (initial_state.pos, initial_state.dir): 0}\n      f_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + (initial_state.pos, initial_state.dir): heuristic(initial_state.pos, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, new_state in get_valid_actions(current_state):\n              # Calculate tentative g_score\n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos, current_state.dir)] + 1\n              \n              state_hash = tuple(new_state.grid.flatten()) + tuple(new_state.inventory) + (new_state.pos, new_state.dir)\n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  # This path to neighbor is better than any previous one. Record it!\n                  came_from = {}\n                  came_from[state_hash] = (current_state, action)\n                  \n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state.pos, goal_item)\n                  heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:02:46.981242", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(new_state, goal_item):\n      \"\"\"Heuristic function to prioritize states that are closer to the goal.\"\"\"\n      # Calculate the difference in inventory towards the goal item\n      current_inventory = new_state.inventory.copy()\n      # Ignore stone for heuristic purposes as it's often abundant and not a limiting resource\n      current_inventory[env.world.stone_index] = 0\n      return np.linalg.norm(current_inventory - initial_inventory)\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, [], initial_state))  # Store (priority, path, state)\n      \n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + initial_state.pos: 0}\n      \n      while open_set:\n          _, path, current_state = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE actions to speed up crafting\n          for action in [4] + list(range(4)):\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              state_hash = tuple(new_state.grid.flatten()) + tuple(new_state.inventory) + new_state.pos\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + current_state.pos] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + current_state.pos, action)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, path + [action], new_state))\n      \n      return None  # Return None if no sequence is found\n\n  initial_inventory = env._current_state.inventory.copy()\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T15:02:51.190614", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(new_state, goal_item):\n      # Heuristic: prioritize states where the inventory has increased towards the goal item\n      current_inventory = new_state.inventory.copy()\n      if new_state.world.stone_index is not None:\n          current_inventory[new_state.world.stone_index] = 0  # Ignore stone for heuristic purposes\n      return np.linalg.norm(current_inventory - initial_inventory)\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, [], initial_state))  # Store (priority, path, state)\n      \n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + initial_state.pos: 0}\n      \n      while open_set:\n          _, path, current_state = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE actions to speed up crafting\n          for action in [4] + list(range(4)):\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              state_hash = tuple(new_state.grid.flatten()) + tuple(new_state.inventory) + new_state.pos\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + current_state.pos] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + current_state.pos, action)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, path + [action], new_state))\n      \n      return None  # Return None if no sequence is found\n\n  initial_inventory = env._current_state.inventory.copy()\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  ", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T15:03:48.586225", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize certain actions to improve efficiency\n          priority_actions = [4]  # Assuming 4 corresponds to the USE action\n          other_actions = list(range(env.world.n_actions))\n          other_actions.remove(4)\n          action_order = priority_actions + other_actions\n\n          for action in action_order:\n              _, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
