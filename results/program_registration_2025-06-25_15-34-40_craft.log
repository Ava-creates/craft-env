not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_closest_item_position(state, item_index):\n      \"\"\"Find the closest position of an item within the grid.\"\"\"\n      grid = state.grid\n      positions = np.argwhere(grid[:, :, item_index] > 0)\n      if len(positions) == 0:\n          return None\n      player_pos = np.array(state.pos)\n      distances = [np.linalg.norm(pos - player_pos, ord=1) for pos in positions]\n      closest_position = tuple(positions[np.argmin(distances)])\n      return closest_position\n\n  def move_to_position(state, target_position):\n      \"\"\"Generate a sequence of actions to move the player to the target position.\"\"\"\n      current_pos = np.array(state.pos)\n      target_pos = np.array(target_position)\n      \n      # Calculate direction vector\n      direction_vector = target_pos - current_pos\n      \n      action_sequence = []\n      if direction_vector[0] > 0:\n          action_sequence.extend([1] * abs(direction_vector[0]))  # Move right\n      elif direction_vector[0] < 0:\n          action_sequence.extend([3] * abs(direction_vector[0]))  # Move left\n      \n      if direction_vector[1] > 0:\n          action_sequence.extend([2] * abs(direction_vector[1]))  # Move down\n      elif direction_vector[1] < 0:\n          action_sequence.extend([0] * abs(direction_vector[1]))  # Move up\n      \n      return action_sequence\n\n  def preprocess_initial_inventory(initial_state, goal_item, cookbook):\n      \"\"\"Preprocess to determine if initial inventory can directly contribute to making the goal item.\"\"\"\n      goal_primitives = get_primitive_counts(goal_item, cookbook)\n      available_primitives = {i: count for i, count in enumerate(initial_state.inventory) if count > 0}\n      \n      # Check if initial inventory satisfies all primitives needed\n      satisfied_primitives = {}\n      for primitive, required_count in goal_primitives.items():\n          if primitive in available_primitives:\n              if available_primitives[primitive] >= required_count:\n                  satisfied_primitives[primitive] = available_primitives[primitive]\n              else:\n                  satisfied_primitives[primitive] = 0\n          else:\n              satisfied_primitives[primitive] = 0\n      \n      return satisfied_primitives\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Preprocess: Collect all possible primitives needed for the goal item and check initial inventory satisfaction\n  goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n  initial_satisfied_primitives = preprocess_initial_inventory(initial_state, goal_item, initial_state.world.cookbook)\n\n  action_sequence = []\n  \n  # Check if any primitive is available in the initial inventory and move to it\n  for primitive_index, count in initial_satisfied_primitives.items():\n      if count > 0:\n          closest_position = get_closest_item_position(initial_state, primitive_index)\n          if closest_position:\n              action_sequence.extend(move_to_position(initial_state, closest_position))\n              # Simulate moving to the position\n              for _ in range(len(action_sequence)):\n                  reward, initial_state = initial_state.step(action_sequence[-1])\n\n  # Perform BFS search to craft the goal item\n  final_action_sequence = bfs_search(initial_state, goal_item)\n  \n  if final_action_sequence:\n      action_sequence.extend(final_action_sequence)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T15:18:30.713533", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n\n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n          # Prepare a list to hold valid actions and their rewards\n          possible_actions = []\n\n          # Evaluate each action (DOWN, UP, LEFT, RIGHT, USE)\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Check if the new state has been visited\n              state_hash = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos, new_state.dir)\n              \n              if state_hash in visited:\n                  continue  # Skip already visited states to avoid loops\n\n              # Store the action and its reward for later sorting\n              possible_actions.append((action, reward))\n\n          # Sort actions by reward descending (USE actions with higher rewards first)\n          sorted_actions = sorted(possible_actions, key=lambda x: -x[1])\n\n          # Enqueue states in the order of their actions\n          for action, _ in sorted_actions:\n              _, new_state = current_state.step(action)\n\n              state_hash = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos, new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n\n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []", "island_id": 9, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T15:18:41.482210", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n\n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n          possible_actions = []\n          use_actions = []\n\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if can_make_goal:\n                      use_actions.append((action, reward))\n              else:  # MOVEMENT actions (DOWN, UP, LEFT, RIGHT)\n                  possible_actions.append((action, reward))\n\n          # Sort USE actions by reward in descending order\n          sorted_use_actions = sorted(use_actions, key=lambda x: -x[1])\n          \n          # Combine all sorted actions\n          sorted_actions = sorted_use_actions + possible_actions\n\n          for action, _ in sorted_actions:\n              _, new_state = current_state.step(action)\n\n              state_hash = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos, new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n\n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []", "island_id": 9, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T15:20:19.968575", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n    \n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n    \n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      possible_actions = []\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n          \n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        possible_actions.append((new_state, action))\n      \n      for new_state, action in possible_actions:\n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n      \n    return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of missing primitives\n      goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n      current_primitives = {i: count for i, count in enumerate(state.inventory) if count > 0}\n      \n      missing_count = 0\n      for primitive, needed in goal_primitives.items():\n          if primitive not in current_primitives:\n              missing_count += needed\n          elif current_primitives[primitive] < needed:\n              missing_count += (needed - current_primitives[primitive])\n      \n      return missing_count\n\n  def a_star_search(initial_state, goal_item):\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0, initial_state, []))  # priority, state, path\n    came_from = {}\n    g_score = {initial_state: 0}\n    f_score = {initial_state: heuristic(initial_state, goal_item)}\n    \n    while not open_set.empty():\n        current_f, current_state, path = open_set.get()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        for action in range(initial_state.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            tentative_g_score = g_score[current_state] + 1\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                came_from[state_hash] = (current_state, action)\n                g_score[new_state] = tentative_g_score\n                f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                open_set.put((f_score[new_state], new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-27T15:20:21.069760", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of missing primitives needed to make the goal item\n      goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n      missing_primitives = sum(\n          max(0, count - state.inventory[primitive])\n          for primitive, count in goal_primitives.items()\n      )\n      return missing_primitives\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))  # (f_score, state, path)\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  \n                  g_score = len(path) + 1\n                  h_score = heuristic(new_state, goal_item)\n                  f_score = g_score + h_score\n                  \n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-27T15:21:43.358765", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_item):\n    \"\"\"Estimate the cost from the current state to the goal.\"\"\"\n    # Simple heuristic: number of missing primitive items.\n    goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n    missing_count = sum(max(0, count - state.inventory[primitive]) for primitive, count in goal_primitives.items())\n    return missing_count\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))  # f_score, state, path\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each action has a cost of 1\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = current_state, path + [action]\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-27T15:21:44.592963", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_item, cookbook):\n    \"\"\"Heuristic function to estimate the cost from the current state to the goal.\"\"\"\n    # Calculate the number of primitive items needed for the goal\n    goal_primitives = get_primitive_counts(goal_item, cookbook)\n    \n    # Calculate the missing primitives in the current inventory\n    missing_primitives = {prim: count - state.inventory[prim] for prim, count in goal_primitives.items() if count > state.inventory[prim]}\n    \n    # Sum up the counts of missing primitives as a heuristic cost\n    return sum(missing_primitives.values())\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item, initial_state.world.cookbook), 0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_cost, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heappush(open_set, (current_cost + 1 + heuristic(new_state, goal_item, initial_state.world.cookbook), current_cost + 1, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-27T15:23:54.134177", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def find_item_on_grid(grid, item):\n      \"\"\"Finds the position of an item on the grid.\"\"\"\n      positions = np.argwhere(grid[:, :, item] > 0)\n      if len(positions) > 0:\n          return tuple(positions[0])\n      return None\n\n  def move_to_position(current_pos, target_pos, dir, world):\n      \"\"\"Generates actions to move from current_pos to target_pos.\"\"\"\n      actions = []\n      dx, dy = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n      # Adjust direction to face the correct way\n      if dx > 0:\n          target_dir = 3  # RIGHT\n      elif dx < 0:\n          target_dir = 2  # LEFT\n      elif dy > 0:\n          target_dir = 1  # UP\n      elif dy < 0:\n          target_dir = 0  # DOWN\n\n      current_directions = [(0, -1), (1, 0), (0, 1), (-1, 0)]  # DOWN, RIGHT, UP, LEFT\n      dir_index = current_directions.index(current_directions[dir])\n\n      if dx != 0:\n          new_dir_index = 3 if dx > 0 else 2\n      elif dy != 0:\n          new_dir_index = 1 if dy > 0 else 0\n\n      # Calculate the number of right turns needed to face the correct direction\n      turns = (new_dir_index - dir_index) % 4\n      actions.extend([3] * turns)  # Right turn is action 3\n\n      # Move to the target position\n      for _ in range(abs(dx)):\n          actions.append(3 if dx > 0 else 2)\n      for _ in range(abs(dy)):\n          actions.append(1 if dy > 0 else 0)\n\n      return actions, new_dir_index\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n\n      queue = deque([(initial_state, [])])\n      visited = set()\n\n      while queue:\n          current_state, path = queue.popleft()\n\n          if satisfies_goal(current_state, goal_item):\n              return path\n\n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()),\n                            tuple(new_state.inventory),\n                            new_state.pos,\n                            new_state.dir)\n\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n\n      return None  # Return None if no sequence is found\n\n  def plan_actions(env, goal_item):\n      initial_state = env._current_state\n      action_sequence = []\n      max_attempts = 50  # Increase the maximum attempts to handle complex scenarios\n\n      while not satisfies_goal(initial_state, goal_item) and len(action_sequence) < 100:  # Limit the total number of actions\n          path = bfs_search(initial_state, goal_item)\n          if path is None:\n              break\n\n          action_sequence.extend(path)\n\n          # Apply the found actions to the environment\n          for action in path:\n              reward, done, observations = env.step(action)\n\n              if done or satisfies_goal(env._current_state, goal_item):\n                  return action_sequence\n\n          initial_state = env._current_state\n\n      return action_sequence if satisfies_goal(env._current_state, goal_item) else []\n\n  # Plan and execute the actions to craft the item\n  return plan_actions(env, item)", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T15:24:04.674523", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def find_item_on_grid(grid, item):\n      \"\"\"Finds the positions of an item on the grid.\"\"\"\n      positions = np.argwhere(grid[:, :, item] > 0)\n      return [tuple(pos) for pos in positions]\n\n  def move_to_position(current_pos, target_pos, dir, world):\n      \"\"\"Generates actions to move from current_pos to target_pos.\"\"\"\n      actions = []\n      dx, dy = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n      \n      # Adjust direction to face the correct way\n      if dx > 0:\n          target_dir = 3  # RIGHT\n      elif dx < 0:\n          target_dir = 2  # LEFT\n      elif dy > 0:\n          target_dir = 1  # UP\n      elif dy < 0:\n          target_dir = 0  # DOWN\n      \n      if dir != target_dir:\n          actions.append((target_dir - dir) % 4)\n      \n      # Move to the target position\n      for _ in range(abs(dx)):\n          actions.append(3 if dx > 0 else 2)\n      for _ in range(abs(dy)):\n          actions.append(1 if dy > 0 else 0)\n      \n      return actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def plan_actions(env, goal_item):\n      initial_state = env._current_state\n      action_sequence = []\n      max_attempts = 50  # Increase the maximum attempts to handle complex scenarios\n      \n      while not satisfies_goal(initial_state, goal_item) and len(action_sequence) < 100:  # Limit the total number of actions\n          path = bfs_search(initial_state, goal_item)\n          if path is None:\n              break\n          \n          action_sequence.extend(path)\n          \n          # Apply the found actions to the environment\n          for action in path:\n              reward, done, observations = env.step(action)\n              \n              if done or satisfies_goal(env._current_state, goal_item):\n                  return action_sequence\n          \n          initial_state = env._current_state\n\n      return action_sequence if satisfies_goal(env._current_state, goal_item) else []\n\n  # Plan and execute the actions to craft the item\n  return plan_actions(env, item)", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T15:25:15.887969", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n\n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n          possible_actions = []\n          use_actions = []  # Separate list for USE actions\n\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      use_actions.append((action, reward))  # Include reward with the action\n\n              else:  # MOVEMENT actions (DOWN, UP, LEFT, RIGHT)\n                  possible_actions.append(action)\n\n          # Sort USE actions by reward descending\n          sorted_use_actions = sorted(use_actions, key=lambda x: -x[1])\n          \n          # Combine all sorted actions\n          sorted_actions = [action for _, action in sorted_use_actions] + possible_actions\n\n          for action in sorted_actions:\n              _, new_state = current_state.step(action)  # Execute the action to get the new state\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (\n                  tuple(new_state.grid.flatten()), \n                  tuple(new_state.inventory), \n                  new_state.pos, \n                  new_state.dir\n              )\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-06-27T15:25:26.600312", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n\n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Sort actions based on potential to make progress towards goal\n          possible_actions = []\n          use_actions = []\n\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n                  \n                  use_actions.append((action, reward))\n              else:  # MOVEMENT actions (DOWN, UP, LEFT, RIGHT)\n                  possible_actions.append((action, reward))\n\n          # Sort USE actions by reward descending\n          sorted_use_actions = sorted(use_actions, key=lambda x: -x[1])\n          \n          # Combine all sorted actions\n          sorted_actions = sorted_use_actions + possible_actions\n\n          for action, _ in sorted_actions:\n              _, new_state = current_state.step(action)  # Execute the action to get the new state\n\n              state_hash = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos, new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n\n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []", "island_id": 9, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T15:26:40.086429", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient != \"_key\":\n            dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    from heapq import heappush, heappop\n\n    # Priority queue for BFS with heuristic prioritization\n    priority_queue = []\n    heappush(priority_queue, (0, initial_state, []))\n    visited = set()\n\n    while priority_queue:\n      _, current_state, path = heappop(priority_queue)\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      valid_actions = []\n      \n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          can_make_goal = True\n          \n          # Check if the use action can contribute to making the goal item\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n\n          if can_make_goal:\n            valid_actions.append((action, reward))  # Include reward for prioritization\n        else:\n          valid_actions.append((action, reward))  # Include reward for prioritization\n      \n      # Sort actions based on the reward (descending)\n      valid_actions.sort(key=lambda x: -x[1])\n      \n      # Prioritize actions that could lead to making the goal item\n      for action, _ in valid_actions:\n        reward, new_state = current_state.step(action)\n\n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          \n          # Heuristic: prioritize states that are closer to having required primitives\n          heuristic_cost = sum(min(count - new_state.inventory[primitive], 0) for primitive, count in goal_primitives.items())\n          total_cost = len(path) + heuristic_cost  # Encourage shorter paths but also consider heuristic cost\n          \n          heappush(priority_queue, (total_cost, new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
