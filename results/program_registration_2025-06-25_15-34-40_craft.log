{"timestamp": "2025-06-27T07:41:57.366672", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          action_queue = list(range(initial_state.world.n_actions))\n          \n          while action_queue:\n              action = action_queue.pop(0)\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_primitive_positions(goal_item, current_state):\n      positions = []\n      goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n      \n      for primitive_index in goal_primitives:\n          x, y = np.where(current_state.grid[:, :, primitive_index] > 0)\n          for i in range(len(x)):\n              positions.append((x[i], y[i]))\n      \n      return positions\n\n  def prioritize_actions(action_queue, current_state, goal_item):\n      # Sort actions based on proximity to primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n      primitive_positions = get_primitive_positions(goal_item, current_state)\n\n      def action_score(action):\n          reward, new_state = current_state.step(action)\n          if action == 4:  # USE action\n              return -1  # Prioritize move actions over use actions for exploration\n          \n          pos_x, pos_y = current_state.pos\n          dir_offset = [(0, -1), (-1, 0), (0, 1), (1, 0)]\n          dx, dy = dir_offset[current_state.dir]\n          next_pos = (pos_x + dx, pos_y + dy)\n          \n          # Calculate the distance to the nearest primitive\n          min_distance = float('inf')\n          for px, py in primitive_positions:\n              distance = abs(px - next_pos[0]) + abs(py - next_pos[1])\n              if distance < min_distance:\n                  min_distance = distance\n          \n          return min_distance\n      \n      action_queue.sort(key=action_score)\n      return action_queue\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T07:43:47.430865", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = [a for a in range(initial_state.world.n_actions)]\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n  