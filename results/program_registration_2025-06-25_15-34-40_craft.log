{"timestamp": "2025-06-26T18:13:42.919800", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(action, current_state, goal_item):\n      # Higher priority for USE action if an ingredient is next to the agent\n      if action == 4:  # Assuming USE is represented by 4\n          for i_kind in env.world.cookbook.primitives:\n              if current_state.next_to(i_kind):\n                  return 1\n      return 0\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          current_cost, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Use a heuristic to prioritize actions that involve using items (action == USE)\n          use_actions = [4]  # Assuming USE is represented by 4\n          other_actions = list(range(env.world.n_actions))\n          other_actions.remove(4) if 4 in other_actions else None\n\n          all_actions = sorted(use_actions + other_actions, key=lambda action: heuristic(action, current_state, goal_item), reverse=True)\n          \n          for action in all_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heapq.heappush(open_set, (current_cost + 1, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Reset the environment to ensure a clean starting point\n  env.reset()\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
