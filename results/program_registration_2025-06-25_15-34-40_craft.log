{"timestamp": "2025-06-26T16:27:47.091681", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def dfs_search(initial_state, goal_item, path=[], visited=set()):\n      # Convert the current state to a hashable form using a tuple of its attributes\n      state_hash = (tuple(initial_state.grid.flatten()), \n                    tuple(initial_state.inventory), \n                    initial_state.pos, \n                    initial_state.dir)\n      \n      if satisfies_goal(initial_state, goal_item):\n          return path\n      \n      visited.add(state_hash)\n      \n      for action in range(env.world.n_actions):\n          reward, new_state = initial_state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          new_state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n          \n          if new_state_hash not in visited:\n              result_path = dfs_search(new_state, goal_item, path + [action], visited)\n              if result_path is not None:\n                  return result_path\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  action_sequence = dfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:28:48.927652", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(pos, grid, target_kind):\n      \"\"\"Heuristic based on Manhattan distance to the nearest accessible cell with the target kind.\"\"\"\n      min_distance = float('inf')\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x, y, target_kind] > 0:\n                  distance = abs(x - pos[0]) + abs(y - pos[1])\n                  min_distance = min(min_distance, distance)\n      return min_distance\n\n  def astar_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state.pos, initial_state.grid, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming cost of each action is 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[new_state] = (current_state, path + [action])\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state.pos, new_state.grid, goal_item)\n                  heapq.heappush(open_set, (f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current, path):\n      total_path = path\n      while current in came_from:\n          current, action_sequence = came_from[current]\n          total_path = action_sequence + total_path\n      return total_path\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
