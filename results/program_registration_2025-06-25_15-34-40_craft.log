{"timestamp": "2025-06-27T11:36:49.173607", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = all(new_state.inventory[primitive] >= count \n                                      for primitive, count in goal_primitives.items())\n                  \n                  if can_make_goal:\n                      possible_actions.append((action, reward))  # Include reward with the action\n              else:  # MOVEMENT actions (DOWN, UP, LEFT, RIGHT)\n                  possible_actions.append((action, reward))\n          \n          # Prioritize movement actions that lead to areas with more primitives and higher rewards\n          sorted_possible_actions = []\n          for action, reward in possible_actions:\n              _, new_state = current_state.step(action)\n              primitive_count = sum(new_state.inventory[i] for i in goal_primitives.keys())\n              sorted_possible_actions.append((action, reward, primitive_count))\n          \n          # Sort by reward and then by number of primitives descending\n          sorted_possible_actions.sort(key=lambda x: (x[1], x[2]), reverse=True)\n\n          for action, _, _ in sorted_possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              state_hash = hash((new_state.grid.tobytes(), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir))\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T11:36:50.442042", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_primitives):\n      # Heuristic: sum of available primitives needed to craft the goal item\n      return sum(min(state.inventory[primitive], count) for primitive, count in goal_primitives.items())\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if can_make_goal:\n                      possible_actions.append((action, reward))  # Include reward with the action\n              else:  # MOVEMENT actions (DOWN, UP, LEFT, RIGHT)\n                  possible_actions.append((action, reward))\n\n          # Prioritize movement actions that lead to areas with more primitives and higher rewards\n          sorted_possible_actions = []\n          for action, reward in possible_actions:\n              _, new_state = current_state.step(action)\n              primitive_count = sum(new_state.inventory[i] for i in goal_primitives.keys())\n              sorted_possible_actions.append((action, reward, primitive_count))\n          \n          # Sort by reward and then by number of primitives descending\n          sorted_possible_actions.sort(key=lambda x: (x[1], x[2]), reverse=True)\n\n          for action, _, _ in sorted_possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              state_hash = hash((new_state.grid.tobytes(), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir))\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  cost = len(path) + heuristic(new_state, goal_primitives)\n                  heapq.heappush(open_set, (cost, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-27T11:39:00.818667", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      \n      g_scores = {initial_state: 0}\n      f_scores = {initial_state: heuristic(initial_state, goal_item, get_primitive_counts(goal_item, initial_state.world.cookbook), initial_state.world.cookbook)}\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          action_sequence = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  action_sequence.append((new_state, path + [action]))\n          \n          for new_state, new_path in action_sequence:\n              tentative_g_score = g_scores[current_state] + 1\n              if new_state not in g_scores or tentative_g_score < g_scores[new_state]:\n                  g_scores[new_state] = tentative_g_score\n                  f_scores[new_state] = tentative_g_score + heuristic(new_state, goal_item, goal_primitives, initial_state.world.cookbook)\n                  heappush(open_set, (f_scores[new_state], new_state, new_path))\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_actions(action_sequence):\n      optimized_sequence = []\n      i = 0\n      \n      while i < len(action_sequence):\n          current_action = action_sequence[i]\n          \n          if current_action == 4:  # USE action\n              use_count = 1\n              while (i + 1 < len(action_sequence) and \n                     action_sequence[i + 1] == 4):\n                  i += 1\n                  use_count += 1\n              optimized_sequence.append(current_action)\n          else:\n              optimized_sequence.append(current_action)\n          \n          i += 1\n      \n      return optimized_sequence\n\n  def get_available_primitives(state, cookbook):\n      primitives = {}\n      \n      for item_index in range(len(state.inventory)):\n          if state.inventory[item_index] > 0:\n              dfs(item_index, state.inventory[item_index])\n      \n      def dfs(current_index, count):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      return primitives\n\n  def heuristic(state, goal_item, goal_primitives, cookbook):\n      available_primitives = get_available_primitives(state, cookbook)\n      return sum(min(available_primitives.get(primitive, 0), goal_primitives[primitive]) for primitive in goal_primitives)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already in inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if not action_sequence:\n      return []\n\n  # Optimize the action sequence by merging consecutive USE actions\n  optimized_action_sequence = optimize_actions(action_sequence)\n  \n  return optimized_action_sequence", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-27T11:39:10.672033", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          action_sequence = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip th