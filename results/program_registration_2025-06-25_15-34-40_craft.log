{"timestamp": "2025-06-27T14:54:40.200328", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_actions(action_sequence):\n      \"\"\"Optimize the action sequence to minimize unnecessary movements.\"\"\"\n      optimized_path = []\n      i = 0\n      while i < len(action_sequence) - 1:\n          current_action = action_sequence[i]\n          next_action = action_sequence[i + 1]\n          \n          # Check for consecutive opposite moves and remove them\n          if (current_action == 0 and next_action == 1) or \\\n             (current_action == 1 and next_action == 0) or \\\n             (current_action == 2 and next_action == 3) or \\\n             (current_action == 3 and next_action == 2):\n              i += 2  # Skip both actions\n          else:\n              optimized_path.append(current_action)\n              i += 1\n      \n      if i < len(action_sequence):  # Add the last action if not skipped\n          optimized_path.append(action_sequence[-1])\n      \n      return optimized_path\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n  \n  if action_sequence:\n      action_sequence = optimize_actions(action_sequence)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T14:55:59.741177", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def heuristic(state, goal_item):\n    # Simple heuristic: distance to the nearest workshop needed for any recipe\n    workshops = state.world.workshop_indices\n    grid_size = state.grid.shape[0] * state.grid.shape[1]\n    \n    def manhattan_distance(pos1, pos2):\n        return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n    \n    min_dist = grid_size  # Initialize to a large number\n    for workshop in workshops:\n      x, y = divmod(workshop, state.grid.shape[0])\n      dist = manhattan_distance(state.pos, (x, y))\n      if dist < min_dist:\n        min_dist = dist\n    \n    return min_dist\n\n  def a_star_search(initial_state, goal_item):\n    import heapq\n    from collections import deque\n\n    # Priority queue for A* algorithm\n    priority_queue = []\n    heapq.heappush(priority_queue, (0, initial_state, []))\n    visited = set()\n\n    while priority_queue:\n      _, current_state, path = heapq.heappop(priority_queue)\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n          \n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          cost = len(path) + heuristic(new_state, goal_item)\n          heapq.heappush(priority_queue, (cost, new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item exists in the cookbook's recipes or primitives\n  if goal_item not in initial_state.world.cookbook.recipes and goal_item not in initial_state.world.cookbook.primitives:\n    raise ValueError(f\"Goal item with index {goal_item} does not exist in the recipe book.\")\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
