is action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  action_sequence.append((new_state, path + [action]))\n          \n          # Sort actions by heuristic: prioritize states with more primitive ingredients available\n          action_sequence.sort(key=lambda x: sum(\n              min(x[0].inventory[primitive], goal_primitives.get(primitive, 0)) \n              for primitive in goal_primes\n          ), reverse=True)\n          \n          queue.extend(action_sequence)\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_actions(action_sequence):\n      optimized_sequence = []\n      i = 0\n      \n      while i < len(action_sequence):\n          current_action = action_sequence[i]\n          \n          if current_action == 4:  # USE action\n              use_count = 1\n              while (i + 1 < len(action_sequence) and \n                     action_sequence[i + 1] == 4):\n                  i += 1\n                  use_count += 1\n              optimized_sequence.append(current_action)\n          else:\n              optimized_sequence.append(current_action)\n          \n          i += 1\n      \n      return optimized_sequence\n\n  def get_available_primitives(state, cookbook):\n      primitives = {}\n      \n      for item_index in range(len(state.inventory)):\n          if state.inventory[item_index] > 0:\n              dfs(item_index, state.inventory[item_index])\n      \n      def dfs(current_index, count):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      return primitives\n\n  def heuristic(state, goal_item, goal_primitives, cookbook):\n      available_primitives = get_available_primitives(state, cookbook)\n      return sum(min(available_primitives.get(primitive, 0), goal_primitives[primitive]) for primitive in goal_primitives)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already in inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  # Precompute the set of all primitives required for the goal item\n  goal_primes = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      return []\n\n  # Optimize the action sequence by merging consecutive USE actions\n  optimized_action_sequence = optimize_actions(action_sequence)\n  \n  return optimized_action_sequence", "island_id": 5, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T10:57:04.850202", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def is_valid_use_action(state, goal_primitives):\n      new_state = state.copy()  # Assuming CraftState has a copy method\n      reward, _ = new_state.step(4)  # Simulate USE action\n      \n      for primitive, required_count in goal_primitives.items():\n          if new_state.inventory[primitive] < required_count:\n              return False\n      return True\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n\n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        if action == 4:  # USE action\n          if not is_valid_use_action(current_state, goal_primitives):\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        reward, new_state = current_state.step(action)\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-27T10:57:21.355113", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n\n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n          \n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def get_initial_state_with_primitives(env, primitives):\n    initial_state = env._current_state\n    for primitive, count in primitives.items():\n      initial_state.inventory[primitive] += count\n    return initial_state\n\n  goal_item = item\n  cookbook = env.world.cookbook\n  \n  # Collect all primitives needed for the goal item\n  primitives = get_primitive_counts(goal_item, cookbook)\n  \n  # Initialize state with necessary primitives\n  initial_state = get_initial_state_with_primitives(env, primitives)\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-27T10:58:59.461989", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import itertools\n      \n      open_set = []\n      open_heap_counter = itertools.count()  # Unique sequence count for heap stability\n      heappush(open_set, (0, next(open_heap_counter), initial_state, []))\n      \n      visited = set()\n      \n      while open_set:\n          _, _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  cost = len(path) + heuristic(new_state, goal_item)\n                  heappush(open_set, (cost, next(open_heap_counter), new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(current_state, goal_item):\n      primitives_needed = get_primitive_counts(goal_item, current_state.world.cookbook)\n      current_primitives = {i: count for i, count in enumerate(current_state.inventory) if count > 0 and i in primitives_needed}\n      \n      steps_needed = 0\n      for primitive, required_count in primitives_needed.items():\n          available_count = current_primitives.get(primitive, 0)\n          # Calculate the number of additional gatherings needed\n          additional_gatherings = max(0, (required_count - available_count) // (primitives_needed[primitive] / (available_count + 1)))\n          steps_needed += additional_gatherings\n      \n      return steps_needed\n\n  def can_make_goal_with_primitives(current_state, goal_item):\n      \"\"\"Check if the current state has enough primitives to make the goal item.\"\"\"\n      primitives_needed = get_primitive_counts(goal_item, current_state.world.cookbook)\n      for primitive, count in primitives_needed.items():\n          if current_state.inventory[primitive] < count:\n              return False\n      return True\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is a primitive or can be made with current inventory\n  if goal_item in initial_state.world.cookbook.primitives or can_make_goal_with_primitives(initial_state, goal_item):\n      action_sequence = a_star_search(initial_state, goal_item)\n  else:\n      action_sequence = []\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-06-27T10:59:00.761224", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import itertools\n      \n      open_set = []\n      open_heap_counter = itertools.count()  # Unique sequence count for heap stability\n      heappush(open_set, (0, next(open_heap_counter), initial_state, []))\n      \n      visited = set()\n      \n      while open_set:\n          _, _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  cost = len(path) + heuristic(new_state, goal_item, goal_primitives)\n                  heappush(open_set, (cost, next(open_heap_counter), new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(current_state, goal_item, goal_primitives):\n      primitives_needed = {k: v for k, v in goal_primitives.items() if k not in current_state.world.environment}\n      current_primitives = {i: count for i, count in enumerate(current_state.inventory) if count > 0 and i in primitives_needed}\n      \n      steps_needed = 0\n      for primitive, required_count in primitives_needed.items():\n          available_count = current_primitives.get(primitive, 0)\n          # Calculate the number of additional gatherings needed\n          additional_gatherings = max(0, (required_count - available_count) // (primitives_needed[primitive] / (available_count + 1)))\n          steps_needed += additional_gatherings\n      \n      return steps_needed\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-27T11:00:36.439851", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = all(new_state.inventory[primitive] >= count for primitive, count in goal_primitives.items())\n                  if can_make_goal:\n                      possible_actions.append(action)\n              else:  # MOVEMENT actions (DOWN, UP, LEFT, RIGHT)\n                  # Check if movement action leads to a useful position\n                  next_to_primitives = any(new_state.next_to(primitive) for primitive in goal_primitives)\n                  if next_to_primitives or new_state.inventory[goal_item] > 0:\n                      possible_actions.append(action)\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-06-27T11:00:37.727209", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def get_neighboring_positions(pos):\n      x, y = pos\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n      neighbors = [(x + dx, y + dy) for dx, dy in directions]\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = all(new_state.inventory[primitive] >= count for primitive, count in goal_primitives.items())\n                  if can_make_goal:\n                      possible_actions.append(action)\n              else:  # MOVEMENT actions (DOWN, UP, LEFT, RIGHT)\n                  possible_actions.append(action)\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def optimized_bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = all(new_state.inventory[primitive] >= count for primitive, count in goal_primitives.items())\n                  if can_make_goal:\n                      possible_actions.append(action)\n              else:  # MOVEMENT actions (DOWN, UP, LEFT, RIGHT)\n                  new_pos = get_neighboring_positions(new_state.pos)[action]\n                  if (0 <= new_pos[0] < initial_state.world.scenario.grid.shape[0] and\n                      0 <= new_pos[1] < initial_state.world.scenario.grid.shape[1]):\n                      possible_actions.append(action)\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Attempt to find an initial action sequence using optimized BFS\n  action_sequence = optimized_bfs_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-27T11:02:52.807427", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    if goal_index in primitive_counts_cache:\n      return primitive_counts_cache[goal_index]\n    \n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    primitive_counts_cache[goal_index] = primitives\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n\n    while queue:\n      current_state, path = queue.popleft()\n\n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Prioritize movement actions over USE action\n      sorted_actions = [i for i in range(initial_state.world.n_actions) if i != 4] + [4]\n\n      for action in sorted_actions:\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n\n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n\n    return None  # Return None if no sequence is found\n\n  def optimize_action_sequence(action_sequence):\n    optimized_sequence = []\n    i = 0\n    while i < len(action_sequence):\n      current_action = action_sequence[i]\n      \n      if current_action == 4:  # USE action\n        use_count = 1\n        while (i + 1 < len(action_sequence) and \n               action_sequence[i + 1] == 4):\n          i += 1\n          use_count += 1\n        optimized_sequence.append(current_action)\n      else:\n        optimized_sequence.append(current_action)\n      \n      i += 1\n    \n    return optimized_sequence\n\n  def heuristic(state, goal_item, primitive_counts_cache, cookbook):\n    # Calculate the number of missing primitives required to craft the goal item\n    needed_primitives = get_primitive_counts(goal_item, cookbook)\n    current_inventory = state.inventory\n    missing_count = 0\n\n    for primitive, count in needed_primitives.items():\n      if current_inventory[primitive] < count:\n        missing_count += (count - current_inventory[primitive])\n\n    return missing_count\n\n  def a_star_search(initial_state, goal_item):\n    from queue import PriorityQueue\n\n    open_set = PriorityQueue()\n    open_set.put((0, initial_state, []))  # Priority, state, path\n    came_from = {}\n    g_score = {initial_state: 0}\n    f_score = {initial_state: heuristic(initial_state, goal_item, primitive_counts_cache, initial_state.world.cookbook)}\n\n    while not open_set.empty():\n      _, current_state, path = open_set.get()\n\n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n\n      # Prioritize movement actions over USE action\n      sorted_actions = [i for i in range(initial_state.world.n_actions) if i != 4] + [4]\n\n      for action in sorted_actions:\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n\n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        tentative_g_score = g_score[current_state] + 1\n\n        if new_state not in g_score or tentative_g_score < g_score[new_state]:\n          came_from[state_hash] = (current_state, path)\n          g_score[new_state] = tentative_g_score\n          f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item, primitive_counts_cache, initial_state.world.cookbook)\n          open_set.put((f_score[new_state], new_state, path + [action]))\n\n    return None  # Return None if no sequence is found\n\n  # Precompute primitive counts for all items\n  primitive_counts_cache = {}\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if satisfies_goal(initial_state, goal_item):\n    return []  # Goal already satisfied\n\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(\"No sequence found to craft the item.\")\n    return []\n\n  # Optimize the action sequence by merging consecutive USE actions\n  optimized_action_sequence = optimize_action_sequence(action_sequence)\n  \n  return optimized_action_sequence", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-27T11:03:03.000074", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    if goal_index in primitive_counts_cache:\n      return primitive_counts_cache[goal_index]\n    \n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    primitive_counts_cache[goal_index] = primitives\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n\n    while queue:\n      current_state, path = queue.popleft()\n\n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Prioritize movement actions over USE action\n      sorted_actions = [i for i in range(initial_state.world.n_actions) if i != 4] + [4]\n\n      for action in sorted_actions:\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n\n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n\n    return None  # Return None if no sequence is found\n\n  def optimize_action_sequence(action_sequence):\n    optimized_sequence = []\n    i = 0\n    while i < len(action_sequence):\n      current_action = action_sequence[i]\n      \n      if current_action == 4:  # USE action\n        use_count = 1\n        while (i + 1 < len(action_sequence) and \n               action_sequence[i + 1] == 4):\n          i += 1\n          use_count += 1\n        optimized_sequence.append(current_action)\n      else:\n        optimized_sequence.append(current_action)\n      \n      i += 1\n    \n    return optimized_sequence\n\n  def heuristic(state, goal_item):\n    # Simple heuristic based on the number of primitives missing to craft the goal item\n    goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n    missing_count = 0\n    for primitive, count in goal_primitives.items():\n      if state.inventory[primitive] < count:\n        missing_count += count - state.inventory[primitive]\n    return missing_count\n\n  # Precompute primitive counts for all items\n  primitive_counts_cache = {}\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if satisfies_goal(initial_state, goal_item):\n    return []  # Goal already satisfied\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(\"No sequence found to craft the item.\")\n    return []\n\n  # Optimize the action sequence by merging consecutive USE actions\n  optimized_action_sequence = optimize_action_sequence(action_sequence)\n  \n  return optimized_action_sequence", "island_id": 5, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T11:04:56.312036", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter and prioritize actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal, satisfied_primitives_count = can_make_use_action(new_state, goal_primitives)\n                  if can_make_goal:\n                      possible_actions.append((action, 'use', satisfied_primitives_count))\n              else:\n                  possible_actions.append((action, 'move', 0))\n          \n          # Prioritize USE actions over MOVE actions based on how many primitives are satisfied\n          def prioritize_action(action_tuple):\n              action_type = action_tuple[1]\n              if action_type == 'use':\n                  return (-action_tuple[2],)  # Negative to sort descending\n              return (0,)  # Move actions have priority 0\n      \n          prioritized_actions = [action for action, _, _ in sorted(possible_actions, key=prioritize_action)]\n          \n          for action in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]  # Return immediately upon achieving the goal\n      \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def can_make_use_action(state, goal_primitives):\n      satisfied_primitives_count = sum(\n          state.inventory[primitive] >= count \n          for primitive, count in goal_primitives.items()\n      )\n      can_make_goal = satisfied_primitives_count == len(goal_primitives)\n      return can_make_goal, satisfied_primitives_count\n\n  def find_primitives_for_goal(initial_state, goal_item):\n      primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      return primitives\n\n  def collect_primitives(env, primitive_counts):\n      actions = []\n      for primitive, count in primitive_counts.items():\n          while env._current_state.inventory[primitive] < count:\n              # Find actions to gather the required primitive\n              sub_actions = bfs_search(env._current_state, primitive)\n              if not sub_actions:\n                  raise ValueError(f\"Could not find a way to collect {count} of item index {primitive}\")\n              actions.extend(sub_actions)\n              for action in sub_actions:\n                  env.step(action)  # Execute the action to progress\n      return actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  primitive_counts = find_primitives_for_goal(initial_state, goal_item)\n  collection_actions = collect_primitives(env, primitive_counts)\n\n  # Attempt to craft the goal item after collecting all primitives\n  crafting_actions = bfs_search(env._current_state, goal_item)\n  \n  if not crafting_actions:\n      raise ValueError(f\"Could not find a way to craft item index {goal_item} after collecting primitives\")\n\n  return collection_actions + crafting_actions", "island_id": 0, "scores": {"3": 2.0}}
