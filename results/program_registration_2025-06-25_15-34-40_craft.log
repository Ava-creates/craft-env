{"timestamp": "2025-06-27T04:45:26.323678", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      possible_actions.append((action, 'use', primitives_satisfied(new_state, goal_primitives)))\n              else:\n                  possible_actions.append((action, 'move', 0))\n          \n          # Prioritize USE actions over MOVE actions based on how many primitives are satisfied\n          def prioritize_action(action_tuple):\n              action_type = action_tuple[1]\n              if action_type == 'use':\n                  return (-action_tuple[2],)  # Negative to sort descending\n              return (0,)  # Move actions have priority 0\n      \n          prioritized_actions = [action for action, _, _ in sorted(possible_actions, key=prioritize_action)]\n          \n          for action in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def primitives_satisfied(state, goal_primitives):\n      return sum(\n          state.inventory[primitive] >= count \n          for primitive, count in goal_primitives.items()\n      )\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T04:45:27.615052", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      possible_actions.append((action, 'use'))\n              else:\n                  possible_actions.append((action, 'move'))\n          \n          # Prioritize USE actions over MOVE actions based on how many primitives are satisfied\n          def prioritize_action(action_tuple):\n              action, _ = action_tuple\n              reward, new_state = current_state.step(action)\n              if action == 4:  # Only consider USE actions for prioritization\n                  primitives_satisfied = sum(\n                      new_state.inventory[primitive] >= count \n                      for primitive, count in goal_primitives.items()\n                  )\n                  return (-primitives_satisfied,)  # Negative to sort descending\n              return (0,)  # Move actions have priority 0\n      \n          prioritized_actions = [action for action, _ in sorted(possible_actions, key=prioritize_action)]\n          \n          for action in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def a_star_search(initial_state, goal_item):\n      from collections import deque\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          cost, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      possible_actions.append((action, 'use'))\n              else:\n                  possible_actions.append((action, 'move'))\n          \n          # Prioritize USE actions over MOVE actions based on how many primitives are satisfied\n          def prioritize_action(action_tuple):\n              action, _ = action_tuple\n              reward, new_state = current_state.step(action)\n              if action == 4:  # Only consider USE actions for prioritization\n                  primitives_satisfied = sum(\n                      new_state.inventory[primitive] >= count \n                      for primitive, count in goal_primitives.items()\n                  )\n                  return -primitives_satisfied  # Negative to sort descending\n              return 0  # Move actions have priority 0\n      \n          possible_actions.sort(key=prioritize_action)\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heappush(open_set, (cost + 1, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-27T04:47:41.779742", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def get_next_to_counts(state, goal_primitives):\n      next_to_counts = {primitive: 0 for primitive in goal_primitives}\n      x, y = state.pos\n      directions = [(0, -1), (1, 0), (0, 1), (-1, 0)]\n\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n              cell_contents = np.where(state.grid[nx, ny])[0]\n              for content in cell_contents:\n                  if content in next_to_counts:\n                      next_to_counts[content] += 1\n      return next_to_counts\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = all(new_state.inventory[primitive] >= count for primitive, count in goal_primitives.items())\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  possible_actions.append((new_state, action))\n          \n          # Prioritize actions that use resources needed for the goal or move towards them\n          next_to_counts = get_next_to_counts(current_state, goal_primitives)\n          sorted_possible_actions = sorted(\n              possible_actions,\n              key=lambda x: (\n                  -sum(x[0].inventory[primitive] > 0 for primitive in goal_primitives),  # More primitives available first\n                  sum(next_to_counts[primitive] for primitive in goal_primitives if x[0].next_to(primitive)),  # Closer to required ingredients second\n              )\n          )\n          \n          queue.extend((new_state, path + [action]) for new_state, action in sorted_possible_actions)\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 2.0}}
