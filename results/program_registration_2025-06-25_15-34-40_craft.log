{"timestamp": "2025-06-26T16:18:04.653123", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos, grid_shape):\n      x, y = pos\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      neighbors = []\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              neighbors.append((nx, ny))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Determine the agent's position and grid shape\n          pos = current_state.pos\n          grid_shape = current_state.grid.shape[:2]\n          \n          # Consider moving to adjacent cells or using an item\n          for action in range(env.world.n_actions):\n              if action < 4:  # Movement actions (DOWN, UP, LEFT, RIGHT)\n                  new_pos = get_neighbors(pos, grid_shape)[action]\n                  # Check if the movement is valid and within bounds\n                  if 0 <= new_pos[0] < grid_shape[0] and 0 <= new_pos[1] < grid_shape[1]:\n                      reward, new_state = current_state.step(action)\n              else:  # USE action\n                  reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T16:18:05.623043", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_requirements(cookbook, goal_item):\n    primitives = {}\n    \n    def _get_primitives(item_index, count=1):\n        if item_index in cookbook.primitives:\n            if item_index not in primitives:\n                primitives[item_index] = 0\n            primitives[item_index] += count\n        elif item_index in cookbook.recipes:\n            recipe = cookbook.recipes[item_index]\n            for ingredient, quantity in recipe.items():\n                if ingredient == \"_key\":\n                    continue\n                _get_primitives(ingredient, quantity * count)\n    \n    _get_primitives(goal_item)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  primitives_needed = get_primitive_requirements(env.world.cookbook, goal_item)\n  \n  for primitive, count in primitives_needed.items():\n      while initial_state.inventory[primitive] < count:\n          action_sequence = bfs_search(initial_state, primitive)\n          if action_sequence:\n              yield from action_sequence\n              # Update the state after performing the actions\n              env._current_state = initial_state\n              for action in action_sequence:\n                  reward, initial_state = initial_state.step(action)\n          else:\n              raise ValueError(f\"Cannot obtain primitive {primitive} needed to craft {goal_item}.\")\n  \n  final_action_sequence = bfs_search(initial_state, goal_item)\n  if final_action_sequence:\n      yield from final_action_sequence\n  else:\n      raise ValueError(f\"Cannot craft item {goal_item}.\")", "island_id": 4, "scores": {"3": -1}}
