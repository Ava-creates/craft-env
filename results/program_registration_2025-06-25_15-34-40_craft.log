{"timestamp": "2025-06-26T14:25:52.713084", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_possible_actions(state):\n      possible_actions = []\n      for action in range(env.world.n_actions):\n          _, new_state = state.step(action)\n          if any(new_state.grid.flatten()) or any(new_state.inventory) or new_state.pos != state.pos:\n              possible_actions.append(action)\n      return possible_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          possible_actions = get_possible_actions(current_state)\n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_path(path):\n      \"\"\"Optimizes the given path by removing unnecessary movements.\"\"\"\n      optimized_path = []\n      for i in range(len(path)):\n          action = path[i]\n          if i < len(path) - 1:\n              next_action = path[i + 1]\n              \n              # Combine consecutive opposite moves\n              if (action == 0 and next_action == 1) or (action == 1 and next_action == 0):\n                  continue\n              elif (action == 2 and next_action == 3) or (action == 3 and next_action == 2):\n                  continue\n              \n          optimized_path.append(action)\n      return optimized_path\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n      action_sequence = optimize_path(action_sequence)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:25:53.722528", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic: distance to nearest required ingredient\n      ingredients = env.world.cookbook.primitives_for(goal_item)\n      min_distance = float('inf')\n      \n      for i_kind in ingredients:\n          if not current_state.inventory[i_kind]:\n              distances = []\n              for dx in range(-1, 2):\n                  for dy in range(-1, 2):\n                      x, y = current_state.pos[0] + dx, current_state.pos[1] + dy\n                      if 0 <= x < env.world.scenario.init_grid.shape[0] and 0 <= y < env.world.scenario.init_grid.shape[1]:\n                          distances.append(abs(x - current_state.pos[0]) + abs(y - current_state.pos[1]))\n              min_distance = min(min_distance, min(distances))\n      \n      return min_distance\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current, path):\n      total_path = []\n      while current in came_from:\n          current, action = came_from[current]\n          total_path.insert(0, action)\n      return path + total_path\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:26:35.571370", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic_cost_estimate(current_state, goal_item):\n      # Heuristic: Estimate based on the number of primitives needed for the goal\n      cookbook = env.world.cookbook\n      primitives_needed = cookbook.primitives_for(goal_item)\n      \n      current_inventory = {env.world.cookbook.index.get(name): count \n                           for name, count in zip(env.world.cookbook.index.ordered_contents, current_state.inventory) \n                           if count > 0}\n      \n      heuristic_cost = 0\n      for primitive, needed_count in primitives_needed.items():\n          current_count = current_inventory.get(primitive, 0)\n          heuristic_cost += max(needed_count - current_count, 0)\n      \n      return heuristic_cost\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (heuristic_cost_estimate(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming all actions have cost 1\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if tentative_g_score < g_score.get(state_hash, float('inf')):\n                  came_from[state_hash] = (current_state, path + [action])\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic_cost_estimate(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:26:51.140258", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited_states = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate possible next states and actions\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited_states:\n                  visited_states.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      print(f\"Failed to find a sequence for crafting item index: {goal_item}\")\n      return []\n\n  return action_sequence", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:27:52.137148", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence is not None:\n    for action in action_sequence:\n        _, _ = env.step(action)  # Execute the actions in the environment\n      \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:27:53.124470", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # A simple heuristic: distance to nearest required ingredient if it's not in inventory\n      # For now, we'll assume a Manhattan distance to the nearest required ingredient\n      needed_ingredients = env.world.cookbook.primitives_for(goal_item)\n      \n      for ingredient_idx, count in needed_ingredients.items():\n          if state.inventory[ingredient_idx] < count:\n              # Find the nearest cell with this ingredient\n              distances = []\n              for x in range(env.world.scenario.init_grid.shape[0]):\n                  for y in range(env.world.scenario.init_grid.shape[1]):\n                      if state.grid[x, y, ingredient_idx] > 0:\n                          dist = abs(x - state.pos[0]) + abs(y - state.pos[1])\n                          distances.append(dist)\n              if distances:\n                  return min(distances) + 1  # Add 1 to ensure non-zero heuristic\n      return 0  # No ingredients needed or all in inventory\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each action has cost 1\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, path + [action])\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:28:54.389237", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def is_workshop(pos):\n      x, y = pos\n      return env.world.workshop_indices[x, y]\n\n  def a_star_search(initial_state, goal_item):\n      from collections import defaultdict\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = defaultdict(lambda: float('inf'))\n      g_score[(tuple(initial_state.grid.flatten()), \n                tuple(initial_state.inventory), \n                initial_state.pos, \n                initial_state.dir)] = 0\n      f_score = defaultdict(lambda: float('inf'))\n      f_score[(tuple(initial_state.grid.flatten()), \n                tuple(initial_state.inventory), \n                initial_state.pos, \n                initial_state.dir)] = heuristic(initial_state.pos, goal_item)\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[(tuple(current_state.grid.flatten()), \n                                          tuple(current_state.inventory), \n                                          current_state.pos, \n                                          current_state.dir)] + 1\n              \n              if tentative_g_score < g_score[state_hash]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state.pos, goal_item)\n                  heapq.heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(pos, goal_item):\n      # Simple Manhattan distance to nearest workshop that has the required item\n      min_distance = float('inf')\n      for x in range(env.world.grid.shape[0]):\n          for y in range(env.world.grid.shape[1]):\n              if env.world.workshop_indices[x, y] and env.world.cookbook.primitives_for(goal_item):\n                  distance = abs(x - pos[0]) + abs(y - pos[1])\n                  min_distance = min(min_distance, distance)\n      return min_distance\n\n  def reconstruct_path(came_from, current_state, path):\n      total_path = []\n      while current_state in came_from:\n          prev_state, action = came_from[current_state]\n          total_path.append(action)\n          current_state = prev_state\n      return path + total_path[::-1]\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:29:10.055101", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(pos, grid, target_kind):\n      \"\"\"Heuristic based on Manhattan distance to the nearest accessible cell with the target kind.\"\"\"\n      min_distance = float('inf')\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x, y, target_kind] > 0:\n                  distance = abs(x - pos[0]) + abs(y - pos[1])\n                  min_distance = min(min_distance, distance)\n      return min_distance\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:30:02.244691", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that might lead to crafting or moving closer to resources\n          action_priority = [4] + list(range(4))  # Use action first, then move directions\n          \n          for action in action_priority:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:30:03.210166", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic based on the number of items needed to satisfy the goal\n      if state.inventory[goal_item] > 0:\n          return 0\n      else:\n          return 1\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      came_from = {}", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:31:02.276836", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_next_states(current_state):\n    next_states = []\n    for action in range(env.world.n_actions):\n      reward, new_state = current_state.step(action)\n      if new_state is not None:\n        next_states.append((action, new_state))\n    return next_states\n\n  def heuristic(state, goal_item):\n    # A simple heuristic: number of items needed to craft the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_item)\n    current_inventory = state.inventory\n    \n    # Count how many more of each primitive is needed\n    additional_items_needed = sum(primitives_needed.get(kind, 0) - current_inventory[kind] for kind in primitives_needed)\n    \n    # Return the number of additional items needed as a heuristic value\n    return max(additional_items_needed, 0)\n\n  def astar_search(initial_state, goal_item):\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n    came_from = {}\n    g_score = {initial_state: 0}\n    \n    while open_set:\n      _, current_state, path = heapq.heappop(open_set)\n      \n      if satisfies_goal(current_state, goal_item):\n        return reconstruct_path(came_from, current_state, path)\n      \n      for action, new_state in get_next_states(current_state):\n        tentative_g_score = g_score[current_state] + 1\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n          came_from[new_state] = current_state\n          g_score[new_state] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal_item)\n          heapq.heappush(open_set, (f_score, new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n    total_path = path\n    while current_state in came_from:\n      current_state = came_from[current_state]\n      total_path = path[:-1]  # Remove the last action as it leads to the goal state\n    return total_path\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  if action_sequence is not None:\n    print(\"Action sequence found:\", action_sequence)\n    return action_sequence\n  else:\n    print(\"Goal not reachable.\")\n    return []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:31:03.246119", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_next_states(current_state):\n      next_states = []\n      for action in range(env.world.n_actions):\n          reward, new_state = current_state.step(action)\n          if new_state is not None:\n              next_states.append((action, new_state))\n      return next_states\n\n  def heuristic(state, goal_item):\n      # Heuristic: Estimate the cost based on how many items of the goal are already in inventory\n      return max(0, state.world.cookbook.primitives_for(goal_item).get(goal_item, 0) - state.inventory[goal_item])\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))  # (f_score, state, path)\n      \n      g_scores = {tuple(initial_state.grid.flatten()): 0}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, new_state in get_next_states(current_state):\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_scores[tuple(current_state.grid.flatten())] + 1\n              \n              if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n                  g_scores[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if action_sequence is not None:\n      for action in action_sequence:\n          reward, done, observations = env.step(action)\n          if done:\n              break\n\n      return action_sequence\n  else:\n      print(\"Goal not reachable.\")\n      return []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:32:31.294322", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate and prioritize actions based on heuristics\n          for action in prioritize_actions(env.world.n_actions, current_state, path[-1] if path else None):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_actions(n_actions, current_state, last_action=None):\n      \"\"\"Prioritize actions based on heuristics.\"\"\"\n      priority = []\n      \n      # Always try to USE first\n      if current_state.next_to(env.world.workshop_indices) or any(current_state.inventory[workshop] > 0 for workshop in env.world.workshop_indices):\n          priority.append(4)\n      \n      # Avoid repeating the same movement action consecutively\n      move_actions = list(range(n_actions - 1))  # Assuming last action is USE (index 4)\n      if last_action in move_actions:\n          move_actions.remove(last_action)\n      \n      # Prioritize actions that lead to adjacent resources or workshops\n      adjacent_resources = [i for i, count in enumerate(current_state.grid[current_state.pos]) if count > 0]\n      adjacent_workshops = env.world.workshop_indices\n      \n      # Heuristic: prioritize actions that move towards resources or workshops\n      def distance(action):\n          new_pos = get_new_position(current_state.pos, current_state.dir, action)\n          return min([abs(new_pos[0] - res_pos % current_state.grid.shape[1]) + abs(new_pos[1] - res_pos // current_state.grid.shape[1])\n                      for res_pos in adjacent_resources if i_kind_from_index(res_pos, env) in adjacent_workshops], default=float('inf'))\n      \n      move_actions.sort(key=distance)\n      priority.extend(move_actions)\n      \n      return priority\n\n  def get_new_position(pos, dir, action):\n      \"\"\"Calculate the new position based on current position, direction, and action.\"\"\"\n      directions = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # RIGHT, LEFT, UP, DOWN\n      new_dir = dir\n      \n      if action < 4:  # Movement actions\n          new_pos = tuple(p + d for p, d in zip(pos, directions[action]))\n      elif action == 4:  # USE action\n          new_pos = pos\n      else:\n          raise ValueError(\"Invalid action\")\n      \n      # Ensure the new position is within grid bounds\n      width, height = current_state.grid.shape[:2]\n      new_pos = (max(0, min(new_pos[0], width - 1)), max(0, min(new_pos[1], height - 1)))\n      \n      return new_pos\n\n  def i_kind_from_index(index, env):\n      \"\"\"Convert a grid index to its corresponding kind index.\"\"\"\n      x, y = divmod(index, env.scenario.init_grid.shape[1])\n      return np.argmax(env.scenario.init_grid[x, y])\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:32:32.258767", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate and prioritize actions based on heuristics\n          for action in prioritize_actions(env.world.n_actions, current_state, last_action=path[-1] if path else None):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_actions(n_actions, current_state, last_action=None):\n      \"\"\"Prioritize actions based on heuristics.\"\"\"\n      priority = []\n      \n      # Always try to USE first\n      priority.append(4)\n      \n      # Avoid repeating the same movement action consecutively\n      move_actions = list(range(4))\n      if last_action in move_actions:\n          move_actions.remove(last_action)\n      \n      # Heuristic: prioritize actions that lead to adjacent resources or workshops\n      def distance(action):\n          new_pos = get_new_position(current_state.pos, current_state.dir, action)\n          adjacent_resources = [i for i, count in enumerate(current_state.grid[new_pos]) if count > 0]\n          adjacent_workshops = env.world.workshop_indices\n          \n          # Calculate the minimum Manhattan distance to any adjacent resource that can be used in a workshop\n          return min([abs(new_pos[0] - res_x) + abs(new_pos[1] - res_y)\n                      for res_x, res_y in [(i % current_state.grid.shape[1], i // current_state.grid.shape[1]) for i in adjacent_resources]\n                      if env.world.index.get(i_kind_from_index((res_x, res_y), current_state)) in adjacent_workshops],\n                     default=float('inf'))\n      \n      move_actions.sort(key=distance)\n      priority.extend(move_actions)\n      \n      return priority\n\n  def get_new_position(pos, dir, action):\n      \"\"\"Calculate the new position based on current position, direction, and action.\"\"\"\n      directions = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # RIGHT, LEFT, UP, DOWN\n      new_dir = dir\n      \n      if action < 4:  # Movement actions\n          new_pos = tuple(p + d for p, d in zip(pos, directions[action]))\n      elif action == 4:  # USE action\n          new_pos = pos\n      else:\n          raise ValueError(\"Invalid action\")\n      \n      return new_pos\n\n  def i_kind_from_index(index, state):\n      \"\"\"Convert a grid index to its corresponding kind index.\"\"\"\n      x, y = divmod(index, state.grid.shape[1])\n      return np.argmax(state.grid[x, y])\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:34:04.947787", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        for action in range(env.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def collect_primitives(env, initial_state, goal_item):\n      cookbook = env.world.cookbook\n      primitives_needed = cookbook.primitives_for(goal_item)\n      \n      action_sequence = []\n      current_state = initial_state\n      \n      for primitive, count in primitives_needed.items():\n          while count > 0:\n              # Collect the primitive\n              collect_action_sequence = bfs_search(current_state, primitive)\n              if not collect_action_sequence:\n                  return None  # If we can't collect a required primitive, fail\n              \n              action_sequence.extend(collect_action_sequence)\n              current_state = initial_state\n              for action in collect_action_sequence:\n                  _, current_state = current_state.step(action)\n          \n              count -= 1\n      \n      return action_sequence\n\n  def craft_item(env, initial_state, goal_item):\n      # First try crafting the item directly\n      direct_craft_sequence = bfs_search(initial_state, goal_item)\n      if direct_craft_sequence:\n          return direct_craft_sequence\n      \n      # If direct crafting fails, collect primitives and then try crafting again\n      primitive_action_sequence = collect_primitives(env, initial_state, goal_item)\n      if not primitive_action_sequence:\n          return None  # If we can't collect required primitives, fail\n      \n      action_sequence = primitive_action_sequence\n      new_state = initial_state\n      \n      for action in primitive_action_sequence:\n          _, new_state = new_state.step(action)\n      \n      craft_after_collect_sequence = bfs_search(new_state, goal_item)\n      if not craft_after_collect_sequence:\n          return None  # If crafting fails after collecting primitives, fail\n      \n      action_sequence.extend(craft_after_collect_sequence)\n      return action_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = craft_item(env, initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:34:20.629301", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        for action in range(env.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def collect_primitives(env, initial_state, goal_item):\n    cookbook = env.world.cookbook\n    primitives_needed = cookbook.primitives_for(goal_item)\n    action_sequence = []\n    current_state = initial_state\n    \n    for primitive in primitives_needed:\n        while primitives_needed[primitive] > 0:\n            # Collect the primitive\n            collect_action_sequence = bfs_search(current_state, primitive)\n            if not collect_action_sequence:\n                return None  # If we can't collect a required primitive, fail\n            \n            action_sequence.extend(collect_action_sequence)\n            \n            # Simulate the actions to get to the next state\n            current_state = initial_state\n            for action in collect_action_sequence:\n                _, current_state = current_state.step(action)\n            \n            primitives_needed[primitive] -= 1\n    \n    return action_sequence\n\n  def craft_item(env, initial_state, goal_item):\n    cookbook = env.world.cookbook\n    recipes = cookbook.recipes\n    primitives_set = cookbook.primitives\n    \n    # If the item is a primitive, we need to collect it\n    if goal_item in primitives_set:\n        return collect_primitives(env, initial_state, goal_item)\n    \n    # Check if the recipe for the item requires any primitives\n    if goal_item in recipes:\n      ingredients_needed = {k: v for k, v in recipes[goal_item].items() if k != \"_key\"}\n      \n      action_sequence = []\n      current_state = initial_state\n      \n      for ingredient in ingredients_needed:\n          ingredient_count = ingredients_needed[ingredient]\n          \n          # If the ingredient is a primitive, collect it\n          if ingredient in primitives_set:\n              while ingredient_count > 0:\n                  collect_action_sequence = bfs_search(current_state, ingredient)\n                  if not collect_action_sequence:\n                      return None  # If we can't collect a required primitive, fail\n                  \n                  action_sequence.extend(collect_action_sequence)\n                  \n                  # Simulate the actions to get to the next state\n                  current_state = initial_state\n                  for action in collect_action_sequence:\n                      _, current_state = current_state.step(action)\n                  \n                  ingredient_count -= 1\n      \n      # After collecting all required primitives, try crafting again\n      craft_action_sequence = bfs_search(current_state, goal_item)\n      if not craft_action_sequence:\n          return None  # If we can't craft the item after collecting primitives, fail\n      \n      action_sequence.extend(craft_action_sequence)\n      \n      return action_sequence\n    \n    return None\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Try crafting the item directly first\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If direct crafting fails, try collecting primitives and then crafting\n      craft_action_sequence = craft_item(env, initial_state, goal_item)\n      \n      if not craft_action_sequence:\n          return []  # Return empty list if no actions found\n      \n      action_sequence.extend(craft_action_sequence)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:35:44.854150", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=None):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if max_depth is not None and len(path) >= max_depth:\n              continue\n          \n          # Prioritize USE actions to speed up crafting\n          use_actions = [4]  # Assuming USE action is indexed as 4\n          other_actions = list(set(range(env.world.n_actions)) - set(use_actions))\n          \n          for action in use_actions + other_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def collect_primitives(env, initial_state, goal_item):\n      cookbook = env.world.cookbook\n      primitives_needed = cookbook.primitives_for(goal_item)\n      \n      action_sequence = []\n      \n      for primitive in primitives_needed:\n          primitive_index = next(iter(primitives_needed))\n          \n          # Collect the primitive\n          collec