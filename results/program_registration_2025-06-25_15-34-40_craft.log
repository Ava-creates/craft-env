, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T10:59:55.517597", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      \n      # Check USE action\n      reward, use_state = state.step(4)\n      if not np.array_equal(use_state.grid, state.grid) or\\\n         not np.array_equal(use_state.inventory, state.inventory) or\\\n         use_state.pos != state.pos or\\\n         use_state.dir != state.dir:\n          valid_actions.append(4)\n      \n      # Check movement actions\n      for action in range(4):\n          reward, move_state = state.step(action)\n          if not np.array_equal(move_state.grid, state.grid) or\\\n             not np.array_equal(move_state.inventory, state.inventory) or\\\n             move_state.pos != state.pos or\\\n             move_state.dir != state.dir:\n              valid_actions.append(action)\n      \n      return valid_actions\n\n  def heuristic(state, goal_item):\n    # Simple heuristic: distance from any nearby ingredient to the agent\n    nearest_distance = float('inf')\n    for x in range(-1, 2):\n        for y in range(-1, 2):\n            nx, ny = state.pos[0] + x, state.pos[1] + y\n            if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                for ingredient in env.world.cookbook.recipes.get(goal_item, {}).keys():\n                    if ingredient != \"_key\" and state.grid[nx, ny, ingredient] > 0:\n                        nearest_distance = min(nearest_distance, abs(x) + abs(y))\n    \n    # Penalize if the USE action is not effective\n    reward, use_state = state.step(4)\n    use_effective = not (np.array_equal(use_state.grid, state.grid) and \n                         np.array_equal(use_state.inventory, state.inventory) and \n                         use_state.pos == state.pos and \n                         use_state.dir == state.dir)\n    \n    return nearest_distance + int(not use_effective)\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          valid_actions = get_valid_actions(current_state)\n          for action in valid_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  g_score = len(path) + 1\n                  h_score = heuristic(new_state, goal_item)\n                  f_score = g_score + h_score\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T10:59:56.480838", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      \n      # Check USE action\n      reward, use_state = state.step(4)\n      if not np.array_equal(use_state.grid, state.grid) or\\\n         not np.array_equal(use_state.inventory, state.inventory) or\\\n         use_state.pos != state.pos or\\\n         use_state.dir != state.dir:\n          valid_actions.append(4)\n      \n      # Check movement actions\n      for action in range(4):\n          reward, move_state = state.step(action)\n          if not np.array_equal(move_state.grid, state.grid) or\\\n             not np.array_equal(move_state.inventory, state.inventory) or\\\n             move_state.pos != state.pos or\\\n             move_state.dir != state.dir:\n              valid_actions.append(action)\n      \n      return valid_actions\n\n  def heuristic(state, goal_item):\n      # Heuristic based on distance to nearest required ingredient and inventory count\n      recipe = env.world.cookbook.recipes.get(goal_item, {})\n      required_ingredients = set(recipe.keys()) - {\"_key\"}\n      \n      min_distance = float('inf')\n      for ingredient in required_ingredients:\n          if state.inventory[ingredient] > 0:\n              continue\n          \n          # Find nearest cell with the required ingredient\n          ingredient_positions = np.argwhere(state.grid[:, :, ingredient])\n          distances = [np.linalg.norm(np.array(pos) - np.array(state.pos)) for pos in ingredient_positions]\n          \n          if distances:\n              min_distance = min(min_distance, min(distances))\n      \n      return min_distance\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          valid_actions = get_valid_actions(current_state)\n          # Sort actions based on heuristic: prioritize closer ingredients and using items first\n          sorted_actions = sorted(valid_actions, key=lambda a: heuristic(current_state, goal_item) if a != 4 else float('inf'))\n          \n          for action in sorted_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
