not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(current_state, goal_item):\n      \"\"\"Heuristic function to estimate cost from current state to goal.\"\"\"\n      current_inventory = current_state.inventory.copy()\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      steps_required = 0\n      \n      for primitive, required_count in goal_primitives.items():\n          if primitive not in current_inventory:\n              current_inventory[primitive] = 0\n          \n          if current_inventory[primitive] < required_count:\n              # Calculate the difference needed\n              difference = required_count - current_inventory[primitive]\n              \n              # Estimate steps to gather or produce this difference\n              # For simplicity, assume one step per item (this can be improved)\n              steps_required += difference\n      \n      return steps_required\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      \n      g_scores = {tuple(initial_state.grid.flatten()): 0}\n      f_scores = {tuple(initial_state.grid.flatten()): heuristic(initial_state, goal_item)}\n      came_from = {}\n      \n      while open_set:\n          _, current_state, path = 