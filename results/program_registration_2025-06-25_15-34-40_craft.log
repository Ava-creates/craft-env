{"timestamp": "2025-06-26T16:14:09.656308", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from current state to goal.\"\"\"\n      # Simple heuristic: count of items needed for the recipe\n      primitives_needed = env.world.cookbook.primitives_for(goal_item)\n      inventory_count = current_state.inventory[list(primitives_needed.keys())]\n      return sum(list(primitives_needed.values())) - np.sum(inventory_count)\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import collections\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      \n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if tentative_g_score < g_score.get(state_hash, float('inf')):\n                  came_from[state_hash] = (current_state, path + [action])\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:14:18.809654", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 2.0}}
{"timestamp": "2025-06-26T16:15:13.994171", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n    \"\"\"\n    Heuristic function to estimate the cost from the current state to the goal.\n    Here we use a simple distance-based heuristic (Manhattan distance) based on \n    whether the necessary items are in the vicinity or not.\n    \"\"\"\n    # Check if all required ingredients are nearby\n    recipe = env.world.cookbook.recipes.get(goal_item, {})\n    for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n        continue  # Skip key ingredients that don't need to be in inventory\n      if state.inventory[ingredient] < count:\n        return float('inf')  # If an ingredient is missing, set a high cost\n    \n    # If all required items are nearby, the heuristic value can be zero or low\n    return 0\n\n  def astar_search(initial_state, goal_item):\n    from collections import deque\n    from heapq import heappop, heappush\n    \n    open_set = []\n    heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n    came_from = {}\n    g_score = {initial_state: 0}\n    \n    while open_set:\n        _, current_state, path = heappop(open_set)\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        for action in range(env.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            tentative_g_score = g_score[current_state] + 1\n            \n            if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                came_from[state_hash] = (current_state, path)\n                g_score[state_hash] = tentative_g_score\n                f_score = tentative_g_score + heuristic(new_state, goal_item)\n                \n                heappush(open_set, (f_score, new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:15:14.966581", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n    # Simple Manhattan distance heuristic for demonstration purposes\n    # Can be replaced with a more informed heuristic if needed\n    workshop_positions = [(x, y) for x in range(env.world.grid.shape[0]) \n                            for y in range(env.world.grid.shape[1]) \n                            if current_state.grid[x, y, env.world.workshop_indices] > 0]\n    \n    min_distance = float('inf')\n    for x, y in workshop_positions:\n        distance = abs(x - current_state.pos[0]) + abs(y - current_state.pos[1])\n        min_distance = min(min_distance, distance)\n    \n    return min_distance\n\n  def a_star_search(initial_state, goal_item):\n    from heapq import heappop, heappush\n    \n    open_set = []\n    heappush(open_set, (0, initial_state, []))  # Priority queue with (f_score, state, path)\n    g_scores = {initial_state: 0}  # Cost to reach each state\n    visited = set()\n    \n    while open_set:\n        f_score, current_state, path = heappop(open_set)\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        for action in range(env.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            tentative_g_score = g_scores[current_state] + 1\n            \n            if state_hash not in visited or tentative_g_score < g_scores.get(state_hash, float('inf')):\n                g_scores[state_hash] = tentative_g_score\n                f_score = tentative_g_score + heuristic(new_state, goal_item)\n                heappush(open_set, (f_score, new_state, path + [action]))\n                \n                visited.add(state_hash)\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:16:48.665545", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate all possible actions for the current state\n          actions = generate_actions(current_state)\n          \n          for action in actions:\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def generate_actions(current_state):\n      actions = []\n      actions.append(4)  # Prioritize USE action (index 4)\n      \n      # Explore movement actions only if not blocked\n      for move_action in range(4):\n          new_pos = move_position(current_state.pos, current_state.dir, move_action)\n          if is_valid_move(new_pos, current_state.grid.shape[:2]):\n              actions.append(move_action)\n      \n      return actions\n\n  def move_position(pos, direction, action):\n      x, y = pos\n      directions = [(0, -1), (1, 0), (0, 1), (-1, 0)]  # UP, RIGHT, DOWN, LEFT\n      \n      if action < 4:  # Movement actions\n          dx, dy = directions[action]\n          new_x, new_y = x + dx, y + dy\n          \n          # Rotate direction based on movement action\n          if action == (direction + 1) % 4:\n              direction = (direction - 1) % 4\n          elif action == (direction - 1) % 4:\n              direction = (direction + 1) % 4\n      \n      else:  # USE action\n          new_x, new_y = x, y\n          \n      return (new_x, new_y)\n\n  def is_valid_move(pos, grid_shape):\n      x, y = pos\n      width, height = grid_shape\n      \n      # Check if the position is within grid bounds\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      \n      # Check if the cell is traversable (non-grabbable entities should be avoided)\n      kind_index = np.argmax(env._current_state.grid[x, y])\n      if kind_index in env.world.non_grabbable_indices:\n          return False\n      \n      return True\n\n  def prioritize_use_actions(actions):\n      use_action_index = 4\n      if use_action_index in actions:\n          actions.remove(use_action_index)\n          actions.insert(0, use_action_index)\n      return actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n      action_sequence = prioritize_use_actions(action_sequence)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 0.5}}
