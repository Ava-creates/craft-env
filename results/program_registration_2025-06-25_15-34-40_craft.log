{"timestamp": "2025-06-26T17:48:48.046344", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos, grid_shape):\n      x, y = pos\n      neighbors = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              neighbors.append((nx, ny))\n      return neighbors\n\n  def get_valid_moves(state):\n      valid_moves = []\n      for action in range(env.world.n_actions):\n          # Skip USE action if there's nothing to use\n          if action == 4:\n              neighbors = get_neighbors(state.pos, state.grid.shape[:2])\n              if not any(state.grid[nx, ny].any() for nx, ny in neighbors):\n                  continue\n\n          valid_moves.append(action)\n      return valid_moves\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in get_valid_moves(current_state):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T17:49:03.675094", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos, grid_shape):\n      x, y = pos\n      neighbors = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              neighbors.append((nx, ny))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              # Simulate the next state without actually changing the environment\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T17:49:54.866319", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n      return [n for n in neighbors if 0 <= n[0] < env.scenario.init_grid.shape[0] and 0 <= n[1] < env.scenario.init_grid.shape[1]]\n\n  def heuristic(pos):\n      # Simple Manhattan distance to the goal position (arbitrary here, as we don't know the exact goal position)\n      return abs(goal_pos[0] - pos[0]) + abs(goal_pos[1] - pos[1])\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      \n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state.pos)}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Cost is always 1 for each step\n      \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state.pos)\n                  heappush(open_set, (f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item has a known recipe\n  if goal_item not in env.world.cookbook.recipes:\n      raise ValueError(f\"Goal item {goal_item} does not have a known recipe.\")\n  \n  # Set an arbitrary goal position for heuristic calculation (here, we just use the initial position)\n  global goal_pos\n  goal_pos = initial_state.pos\n\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T17:50:04.930360", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that involve using resources or crafting\n          action_priorities = [4] + list(set(range(env.world.n_actions)) - {4})\n          \n          for action in action_priorities:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item has a known recipe\n  if goal_item not in env.world.cookbook.recipes:\n      raise ValueError(f\"Goal item {goal_item} does not have a known recipe.\")\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 1.5}}
