{"timestamp": "2025-06-26T22:17:43.762038", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Skip unchanged states to reduce search space\n              if np.array_equal(new_state.grid, current_state.grid) and\\\n                 np.array_equal(new_state.inventory, current_state.inventory) and\\\n                 new_state.pos == current_state.pos and\\\n                 new_state.dir == current_state.dir:\n                  continue\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Validate the goal item index\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T22:20:00.034188", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(action, current_state, goal_item):\n      # Higher priority for USE action if an ingredient is next to the agent\n      if action == 4:  # Assuming 'USE' is the action with index 4\n          for i_kind in env.world.cookbook.primitives:\n              if current_state.next_to(i_kind):\n                  return 1\n      return 0\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that involve using items (action == USE)\n          use_actions = [4]  # Assuming 'USE' is the action with index 4\n          other_actions = list(range(env.world.n_actions))\n          other_actions.remove(4) if 4 in other_actions else None\n\n          all_actions = sorted(use_actions + other_actions, key=lambda action: heuristic(action, current_state, goal_item), reverse=True)\n          \n          for action in all_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Cost of each action is 1 for simplicity\n\n              if state_hash not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, path + [action])\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(action, new_state, goal_item)\n                  open_set.put((f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  goal_item = item\n  \n  # Reset the environment to ensure a clean starting point\n  env.reset()\n  \n  initial_state = env._current_state\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T22:20:15.809244", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(action, current_state, goal_item):\n      # Higher priority for 'USE' action if an ingredient is next to the agent\n      if action == 4:  # Assuming 'USE' is represented by 4\n          for i_kind in env.world.cookbook.primitives:\n              if current_state.next_to(i_kind):\n                  return 1\n      return 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that involve using items (action == USE)\n          use_actions = [4]  # Assuming 'USE' is the action with index 4\n          other_actions = list(range(env.world.n_actions))\n          other_actions.remove(4) if 4 in other_actions else None\n\n          all_actions = sorted(use_actions + other_actions, key=lambda action: heuristic(action, current_state, goal_item), reverse=True)\n          \n          for action in all_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  goal_item = item\n  \n  # Reset the environment to ensure a clean starting point\n  env.reset()\n  \n  initial_state = env._current_state\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T22:22:51.318755", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue for A* search\n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      \n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + (initial_state.pos,) + (initial_state.dir,): 0}\n      f_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + (initial_state.pos,) + (initial_state.dir,): heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = tuple(new_state.grid.flatten()) + tuple(new_state.inventory) + (new_state.pos,) + (new_state.dir,)\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = current_state\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of primitives still needed to craft the goal item\n      primitives_required = env.world.cookbook.primitives_for(goal_item)\n      available_primitives = {idx: state.inventory[idx] for idx in env.world.grabbable_indices}\n      \n      remaining_count = 0\n      \n      for primitive, count in primitives_required.items():\n          if primitive not in available_primitives:\n              remaining_count += count\n          else:\n              remaining_count += max(0, count - available_primitives[primitive])\n      \n      return remaining_count\n\n  def reconstruct_path(came_from, current_state, path):\n      while current_state in came_from:\n          current_state = came_from[current_state]\n          path.insert(0, action)\n      return path\n  \n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Check if the goal item can be crafted based on available primitives and environment items\n  primitives_required = env.world.cookbook.primitives_for(goal_item)\n  available_primitives = {idx: initial_state.inventory[idx] for idx in env.world.grabbable_indices}\n  \n  if not all(primitive in available_primitives or primitive in env.world.environment for primitive in primitives_required):\n      raise ValueError(\"Goal item cannot be crafted with the available items and environment.\")\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
