             visited.add(state_hash)\n                  stack.append((new_state, path + [action]))\n      \n      return None  # Return None if no actions found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  # If BFS fails, try a depth-first search with backtracking as a fallback\n  if not action_sequence:\n      action_sequence = depth_first_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T11:23:04.019004", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Filter actions that lead to a change in the state (useful for reducing search space)\n          possible_actions = filter_valid_actions(current_state)\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def filter_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          _, new_state = state.step(action)\n          \n          # Check if the new state is different from the current state\n          if (not np.array_equal(new_state.grid, state.grid) or \n              not np.array_equal(new_state.inventory, state.inventory) or \n              new_state.pos != state.pos or \n              new_state.dir != state.dir):\n              valid_actions.append(action)\n      return valid_actions\n\n  def ensure_reachability(item_index):\n      # Check if the item is already in the inventory\n      if satisfies_goal(env._current_state, item_index):\n          return True\n      \n      cookbook = env.world.cookbook\n      if item_index not in cookbook.recipes and item_index not in cookbook.primitives:\n          raise ValueError(f\"Goal item {item_index} cannot be crafted or is unknown.\")\n      \n      # Check if the item can be reached through crafting\n      to_visit = set(cookbook.recipes.keys())\n      reachable_items = set()\n      \n      while to_visit:\n          current_item = to_visit.pop()\n          if satisfies_goal(env._current_state, current_item):\n              reachable_items.add(current_item)\n          else:\n              ingredients_needed = cookbook.primitives_for(current_item)\n              if all(ingredient in env.world.grabbable_indices or ingredient in reachable_items for ingredient in ingredients_needed):\n                  reachable_items.add(current_item)\n                  to_visit.update(cookbook.recipes.keys() - reachable_items)\n      \n      return item_index in reachable_items\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is reachable through crafting or is already in inventory\n  if not ensure_reachability(goal_item):\n      raise ValueError(f\"Goal item {goal_item} cannot be reached with the current setup.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T11:23:18.057232", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Filter actions that lead to a change in the state (useful for reducing search space)\n          possible_actions = filter_valid_actions(current_state)\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def filter_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          _, new_state = state.step(action)\n          \n          # Check if the new state is different from the current state\n          if (not np.array_equal(new_state.grid, state.grid) or \n              not np.array_equal(new_state.inventory, state.inventory) or \n              new_state.pos != state.pos or \n              new_state.dir != state.dir):\n              valid_actions.append(action)\n      return valid_actions\n\n  def generate_initial_state(env, item):\n      scenario = env.scenario\n      initial_state = scenario.init()\n      \n      # Ensure the goal item is not already in the inventory\n      if satisfies_goal(initial_state, item):\n          raise ValueError(f\"Goal item {item} is already in the inventory.\")\n      \n      return initial_state\n\n  initial_state = generate_initial_state(env, item)\n  goal_item = item\n  \n  # Ensure the goal item has a recipe or is a primitive\n  cookbook = env.world.cookbook\n  if goal_item not in cookbook.recipes and goal_item not in cookbook.primitives:\n      raise ValueError(f\"Goal item {goal_item} cannot be crafted or is unknown.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T11:24:10.818620", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action first for crafting efficiency\n          use_action = 4\n          reward_use, new_use_state = current_state.step(use_action)\n          state_hash_use = (tuple(new_use_state.grid.flatten()), \n                            tuple(new_use_state.inventory), \n                            new_use_state.pos, \n                            new_use_state.dir)\n          \n          if satisfies_goal(new_use_state, goal_item):\n              return path + [use_action]\n          \n          if state_hash_use not in visited:\n              visited.add(state_hash_use)\n              queue.append((new_use_state, path + [use_action]))\n              \n          # Explore other movement actions\n          for action in range(env.world.n_actions - 1):  # Exclude USE action (4) here\n              reward_move, new_move_state = current_state.step(action)\n              state_hash_move = (tuple(new_move_state.grid.flatten()), \n                                 tuple(new_move_state.inventory), \n                                 new_move_state.pos, \n                                 new_move_state.dir)\n              \n              if satisfies_goal(new_move_state, goal_item):\n                  return path + [action]\n              \n              if state_hash_move not in visited:\n                  visited.add(state_hash_move)\n                  queue.append((new_move_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
