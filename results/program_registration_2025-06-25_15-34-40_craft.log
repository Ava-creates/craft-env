       else:  # MOVEMENT actions (DOWN, UP, LEFT, RIGHT)\n                  possible_actions.append((action, reward))\n\n          # Sort USE actions by reward descending\n          sorted_use_actions = sorted(use_actions, key=lambda x: -x[1])\n          \n          # Combine all sorted actions\n          sorted_actions = sorted_use_actions + possible_actions\n\n          for action, _ in sorted_actions:\n              _, new_state = current_state.step(action)  # Execute the action to get the new state\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (\n                  tuple(new_state.grid.flatten()), \n                  tuple(new_state.inventory), \n                  new_state.pos, \n                  new_state.dir\n              )\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state.copy()  # Ensure a fresh copy of the state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-27T15:33:49.735067", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n\n      if satisfies_goal(current_state, goal_item):\n        return path\n\n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      valid_actions = []\n      for action in range(initial_state.world.n_actions):\n          reward, new_state = current_state.step(action)\n\n          if action == 4:  # USE action\n              can_make_goal = all(new_state.inventory[primitive] >= count for primitive, count in goal_primitives.items())\n              if not can_make_goal:\n                  continue\n\n          valid_actions.append((action, new_state))\n      \n      for action, new_state in valid_actions:\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          if state_hash not in visited:\n              visited.add(state_hash)\n              queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in env.world.cookbook.recipes and goal_item not in env.world.cookbook.primitives:\n      print(f\"Warning: Item {goal_item} not recognized in the cookbook.\")\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T15:34:00.389229", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n\n      if satisfies_goal(current_state, goal_item):\n        return path\n\n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      valid_actions = []\n      for action in range(initial_state.world.n_actions):\n          reward, new_state = current_state.step(action)\n\n          if action == 4:  # USE action\n              can_make_goal = all(new_state.inventory[primitive] >= count for primitive, count in goal_primitives.items())\n              if not can_make_goal:\n                  continue\n\n          valid_actions.append((action, new_state))\n      \n      for action, new_state in valid_actions:\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          if state_hash not in visited:\n              visited.add(state_hash)\n              queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in env.world.cookbook.recipes and goal_item not in env.world.cookbook.primitives:\n      print(f\"Warning: Item {goal_item} not recognized in the cookbook.\")\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T15:35:14.204414", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_primitives):\n      # Heuristic based on the difference between required and available primitives\n      current_inventory = state.inventory.copy()\n      total_cost = 0\n      \n      for primitive, required_count in goal_primitives.items():\n          if current_inventory[primitive] < required_count:\n              additional_needed = required_count - current_inventory[primitive]\n              total_cost += additional_needed\n          \n          # Penalize having excess of non-primitive items that are not needed\n          if state.world.cookbook.index.reverse_contents.get(primitive) not in state.world.primitives:\n              total_cost += current_inventory[primitive] * 0.1\n      \n      return total_cost\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          current_cost, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          actions_to_try = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              actions_to_try.append((state_hash, action, reward, new_state))\n          \n          for state_hash, action, reward, new_state in actions_to_try:\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  cost = current_cost - reward + heuristic(new_state, goal_primitives)\n                  heappush(open_set, (cost, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in initial_state.world.cookbook.index.reverse_contents:\n      raise ValueError(\"Goal item index not found in cookbook.\")\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
