{"timestamp": "2025-06-26T10:49:35.058956", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of items needed to craft the goal\n      primitives_needed = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory\n      \n      cost = 0\n      for item_idx, count in primitives_needed.items():\n          if current_inventory[item_idx] < count:\n              cost += (count - current_inventory[item_idx])\n      \n      return cost\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heapq.heappush(open_set, \n                                 (len(path) + 1 + heuristic(new_state, goal_item), \n                                  new_state, \n                                  path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # First attempt A* search with a simple heuristic\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T10:50:32.162503", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(new_state, goal_item):\n      # Heuristic: prioritize states where the inventory has increased towards the goal item\n      current_inventory = new_state.inventory.copy()\n      current_inventory[new_state.world.stone_index] = 0  # Ignore stone for heuristic purposes\n      return np.linalg.norm(current_inventory - initial_inventory)\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0 + heuristic(initial_state, goal_item), 0, initial_state, []))\n      \n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      came_from = {}\n      \n      while not open_set.empty():\n          _, current_cost, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          for action in [1, 0, 2, 3, 4]:  # Try actions in a specific order: UP, DOWN, LEFT, RIGHT, USE\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming uniform cost of 1 for each action\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = current_state\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score[new_state], tentative_g_score, new_state, path + [action]))\n      \n      return None\n\n  def reconstruct_path(came_from, current, total_path):\n      while current in came_from:\n          total_path.insert(0, came_from[current])\n          current = came_from[current]\n      return total_path\n\n  initial_inventory = env._current_state.inventory.copy()\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if not action_sequence:\n      return []\n  \n  # Convert states to actions\n  current_state = initial_state\n  actions = []\n  for next_state in action_sequence[1:]:\n      found_action = None\n      for action in [0, 1, 2, 3, 4]:  # Try all actions\n          _, new_state = current_state.step(action)\n          if np.array_equal(new_state.grid.flatten(), next_state.grid.flatten()) and \\\n             np.array_equal(new_state.inventory, next_state.inventory) and \\\n             new_state.pos == next_state.pos and \\\n             new_state.dir == next_state.dir:\n              found_action = action\n              break\n      \n      if found_action is not None:\n          actions.append(found_action)\n      \n      current_state = next_state\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T10:50:35.411968", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(new_state, goal_item):\n      # Heuristic: prioritize states where the inventory has increased towards the goal item\n      current_inventory = new_state.inventory.copy()\n      current_inventory[new_state.world.stone_index] = 0  # Ignore stone for heuristic purposes\n      return np.linalg.norm(current_inventory - initial_inventory)\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in [4] + list(range(4)):  # Prioritize USE actions\n              reward, new_state = current_state.step(action)\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Avoid revisiting states that have been visited with the same inventory and position\n              state_key = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos)\n              if state_key not in visited:\n                  visited.add(state_key)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_inventory = env._current_state.inventory.copy()\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T10:51:29.392536", "function_name": "craft", "function_body": "  def heuristic(state: CraftState, goal_index: int):\n      \"\"\"A simple heuristic to estimate the number of steps required to reach the goal.\"\"\"\n      # Calculate the number of missing primitives needed for the goal\n      primitives_needed = env.world.cookbook.primitives_for(goal_index)\n      current_inventory = state.inventory\n      \n      # Calculate the difference in counts for each primitive\n      missing_primitives_count = sum(\n          max(0, count - current_inventory[i_kind])\n          for i_kind, count in primitives_needed.items()\n      )\n      \n      return missing_primitives_count\n\n  current_state = env._current_state\n  world = env.world\n\n  # Define a priority queue for A* with the initial state, cost (0), and an empty action sequence\n  import heapq\n  open_set = [(heuristic(current_state, item), 0, [], current_state)]\n\n  # Set to track visited states (using tuple representation of grid, pos, dir)\n  visited_states = set()\n\n  while open_set:\n      _, cost_so_far, actions_taken, current_state = heapq.heappop(open_set)\n\n      # Check if the goal is satisfied in the current state\n      if current_state.satisfies(\"dummy_goal_name\", item):\n          return actions_taken\n\n      # Create a unique hashable representation of the state to check if it's visited\n      state_representation = (\n          tuple(current_state.grid.flatten()),\n          current_state.pos,\n          current_state.dir,\n          tuple(current_state.inventory)\n      )\n      \n      if state_representation not in visited_states:\n          visited_states.add(state_representation)\n\n          # Get the next possible states by taking each action\n          for action in range(world.n_actions):  # Assuming there are n_actions available actions\n              reward, new_state = current_state.step(action)\n\n              # Check if the goal is satisfied after the step (early exit)\n              if new_state.satisfies(\"dummy_goal_name\", item):\n                  return actions_taken + [action]\n\n              # Calculate cost to reach the new state and estimated total cost\n              new_cost_so_far = cost_so_far + 1\n              priority = new_cost_so_far + heuristic(new_state, item)\n\n              # Create a unique hashable representation of the new state\n              state_representation_new = (\n                  tuple(new_state.grid.flatten()),\n                  tuple(new_state.pos),\n                  new_state.dir,\n                  tuple(new_state.inventory)\n              )\n              \n              if state_representation_new not in visited_states:\n                  heapq.heappush(open_set, (priority, new_cost_so_far, actions_taken + [action], new_state))\n\n  # If no solution is found, return an empty list\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-26T10:51:39.546323", "function_name": "craft", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # Define a queue for BFS with the initial state and an empty action sequence\n  queue = [(current_state, [])]\n\n  # Set to track visited states (using tuple representation of grid, pos, dir)\n  visited_states = set()\n\n  while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      # Check if the goal is satisfied in the current state\n      if current_state.satisfies(\"dummy_goal_name\", item):\n          return actions_taken\n\n      # Get the next possible states by taking each action\n      for action in range(world.n_actions):  # Assuming there are n_actions available actions\n          reward, new_state = current_state.step(action)\n\n          # Check if the goal is satisfied after the step (early exit)\n          if new_state.satisfies(\"dummy_goal_name\", item):\n              return actions_taken + [action]\n\n          # Create a unique hashable representation of the state to check if it's visited\n          state_representation = (\n              tuple(new_state.grid.flatten()),\n              tuple(new_state.pos),\n              new_state.dir,\n              tuple(new_state.inventory)\n          )\n          \n          if state_representation not in visited_states:\n              visited_states.add(state_representation)\n              queue.append((new_state, actions_taken + [action]))\n\n  # If no solution is found, try to return the closest path based on inventory count\n  best_actions = None\n  max_inventory_count = 0\n\n  for state_repr in visited_states:\n      grid_flat, pos, dir, inventory_tuple = state_repr\n      state = CraftState(\n          scenario=env.scenario,\n          grid=np.array(grid_flat).reshape((world.WIDTH, world.HEIGHT, world.n_kinds)),\n          pos=pos,\n          dir=dir,\n          inventory=np.array(inventory_tuple)\n      )\n      \n      if state.inventory[item] > max_inventory_count:\n          max_inventory_count = state.inventory[item]\n          best_actions = actions_taken  # Extract the action sequence from the tuple\n\n  return best_actions if best_actions else []", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T10:53:12.719765", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Filter actions that lead to a change in the state (useful for reducing search space)\n          possible_actions = filter_valid_actions(current_state)\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def filter_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          # Check if the new state is different from the current state\n          if (not np.array_equal(new_state.grid, state.grid) or \n              not np.array_equal(new_state.inventory, state.inventory) or \n              new_state.pos != state.pos or \n              new_state.dir != state.dir):\n              valid_actions.append(action)\n      \n      # Prefer 'USE' action to speed up the process if possible\n      use_action = 4  # Assuming USE is mapped to 4 as per your previous code\n      \n      preferred_actions = []\n      if use_action in valid_actions:\n          preferred_actions.append(use_action)\n      \n      # Prioritize move actions that lead closer to a workshop or water source\n      for action in range(env.world.n_actions - 1):  # Exclude 'USE' action from move actions\n          _, new_state = state.step(action)\n          if any(new_state.next_to(i) for i in env.world.workshop_indices):\n              preferred_actions.append(action)\n      \n      return preferred_actions + [action for action in valid_actions if action not in preferred_actions]\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: prioritize states where the inventory count of the goal item is higher\n      return -state.inventory[goal_item]\n  \n  initial_state = env._current_state\n  goal_item = item\n\n  from heapq import heappush, heappop\n  \n  open_set = []\n  heappush(open_set, (heuristic(initial_state, goal_item), initial_state, []))\n  visited = set()\n  \n  while open_set:\n      _, current_state, path = heappop(open_set)\n      \n      if satisfies_goal(current_state, goal_item):\n          return path\n      \n      possible_actions = filter_valid_actions(current_state)\n      \n      for action in possible_actions:\n          reward, new_state = current_state.step(action)\n          \n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          if state_hash not in visited:\n              visited.add(state_hash)\n              heappush(open_set, (heuristic(new_state, goal_item), new_state, path + [action]))\n  \n  return None  # Return None if no sequence is found", "island_id": 7, "scores": {"3": -1}}
