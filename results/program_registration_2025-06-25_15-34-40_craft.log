ions\n\n  def heuristic(state, goal_item):\n      # Heuristic based on the number of items needed to craft the goal item\n      if satisfies_goal(state, goal_item):\n          return 0\n      \n      required_items = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory.copy()\n      \n      steps_needed = 0\n      for primitive, count in required_items.items():\n          while current_inventory[primitive] < count:\n              # Simulate crafting the primitive item if it's not available\n              _, new_state = state.step(4)  # Assume USE action crafts an item\n              current_inventory = new_state.inventory.copy()\n              steps_needed += 1\n      \n      return steps_needed\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          possible_actions = filter_valid_actions(current_state)\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = current_state\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n      total_path = path\n      while current_state in came_from:\n          current_state = came_from[current_state]\n          total_path.append(path)\n      return total_path[::-1]\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T10:37:51.138730", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), 0, initial_state, []))\n      came_from = {}\n      g_score = {state_to_tuple(initial_state): 0}\n      \n      while open_set:\n          _, current_cost, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state)\n          \n          possible_actions = filter_valid_actions(current_state)\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[state_to_tuple(current_state)] + 1\n              new_state_tuple = state_to_tuple(new_state)\n              \n              if new_state_tuple not in g_score or tentative_g_score < g_score[new_state_tuple]:\n                  came_from[new_state_tuple] = (current_state, action)\n                  g_score[new_state_tuple] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, tentative_g_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def filter_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          _, new_state = state.step(action)\n          \n          # Check if the new state is different from the current state\n          if (not np.array_equal(new_state.grid, state.grid) or \n              not np.array_equal(new_state.inventory, state.inventory) or \n              new_state.pos != state.pos or \n              new_state.dir != state.dir):\n              valid_actions.append(action)\n      return valid_actions\n\n  def heuristic(state, goal_item):\n      # Heuristic based on the number of items needed to craft the goal item\n      if satisfies_goal(state, goal_item):\n          return 0\n      \n      required_items = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory.copy()\n      \n      steps_needed = 0\n      for primitive, count in required_items.items():\n          while current_inventory[primitive] < count:\n              # Simulate crafting the primitive item if it's not available\n              _, new_state = state.step(4)  # Assume USE action crafts an item\n              current_inventory = new_state.inventory.copy()\n              steps_needed += 1\n      \n      return steps_needed\n\n  def state_to_tuple(state):\n      # Convert the state to a hashable form using a tuple of its attributes\n      return (tuple(state.grid.flatten()), \n              tuple(state.inventory), \n              state.pos, \n              state.dir)\n\n  def reconstruct_path(came_from, current_state):\n      total_path = []\n      current_state_tuple = state_to_tuple(current_state)\n      \n      while current_state_tuple in came_from:\n          previous_state, action = came_from[current_state_tuple]\n          total_path.append(action)\n          current_state_tuple = state_to_tuple(previous_state)\n      \n      return list(reversed(total_path))\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T10:39:22.979643", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def a_star_search(start_pos, goal_pos, grid, width, height):\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (0, start_pos, []))\n    came_from = {}\n    g_score = {start_pos: 0}\n    f_score = {start_pos: heuristic(start_pos, goal_pos)}\n    \n    while open_set:\n        _, current_pos, path = heappop(open_set)\n        \n        if current_pos == goal_pos:\n            return path\n        \n        for action in range(env.world.n_actions):\n          reward, new_state = env._current_state.step(action)\n          \n          next_pos = (new_state.pos[0], new_state.pos[1])\n          tentative_g_score = g_score[current_pos] + 1\n          \n          if next_pos not in 