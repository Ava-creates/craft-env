      prioritized_actions.append(action)\n      \n      return list(set(prioritized_actions))  # Remove duplicates\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        required_resources = env.world.cookbook.primitives_for(goal_item).keys()\n        prioritized_actions = prioritize_actions(current_state, required_resources)\n        \n        for action in prioritized_actions + [a for a in range(env.world.n_actions) if a not in prioritized_actions]:\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If BFS doesn't find a solution, try to move closer to the nearest resource needed for the goal.\n      initial_grid = initial_state.grid\n      width, height, _ = initial_grid.shape\n      \n      # Find positions of resources needed for the goal in the grid\n      required_resources = env.world.cookbook.primitives_for(goal_item).keys()\n      resource_positions = [(x, y) \n                            for x in range(width) \n                            for y in range(height) \n                            if any(initial_grid[x, y, res] > 0 for res in required_resources)]\n      \n      if not resource_positions:\n          return []  # No resources found to move towards\n      \n      closest_resource = min(resource_positions, key=lambda pos: heuristic(pos, initial_state.pos))\n      \n      # Perform A* search to move closer to the closest resource\n      resource_path = a_star_search(initial_state.pos, closest_resource, initial_state)\n      \n      if not resource_path:\n          return []  # No path found to the resource\n      \n      action_sequence = []\n      current_pos = initial_state.pos\n      direction_mapping = {0: (0, -1), 1: (0, 1), 2: (-1, 0), 3: (1, 0)}\n      \n      for next_pos in resource_path:\n          dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n          \n          # Determine the direction to move\n          if dx == 1:\n              action_sequence.append(3)  # RIGHT\n          elif dx == -1:\n              action_sequence.append(2)  # LEFT\n          elif dy == 1:\n              action_sequence.append(1)  # DOWN\n          elif dy == -1:\n              action_sequence.append(0)  # UP\n          \n          current_pos = next_pos\n      \n      return action_sequence\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T09:35:02.314399", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, depth_limit=50):  # Added depth limit to prevent infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= depth_limit:  # Skip paths exceeding the depth limit\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Prioritize USE action to speed up crafting\n  def prioritize_use_actions(action_sequence):\n      return sorted(action_sequence, key=lambda x: 0 if x == 4 else 1)\n\n  action_sequence = bfs_search(initial_state, goal_item)\n  \n  if action_sequence is not None:\n      prioritized_action_sequence = prioritize_use_actions(action_sequence)\n      return prioritized_action_sequence\n  \n  return []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-06-26T09:35:07.946470", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue to store (estimated_cost, path, current_state)\n      open_set = []\n      heapq.heappush(open_set, (0, [], initial_state))\n      \n      # Dictionary to keep track of the cheapest path found so far to each state\n      g_scores = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + initial_state.pos: 0}\n      \n      while open_set:\n          estimated_cost, path, current_state = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate successors and update the priority queue\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              state_tuple = tuple(new_state.grid.flatten()) + tuple(new_state.inventory) + new_state.pos\n              tentative_g_score = g_scores.get(state_tuple, float('inf'))\n              \n              # Compute the estimated cost using a simple heuristic: distance to goal item\n              h_cost = 0  # Placeholder for actual heuristic implementation if needed\n              f_cost = g_scores[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + current_state.pos] + 1 + h_cost\n              \n              if f_cost < tentative_g_score:\n                  g_scores[state_tuple] = f_cost\n                  new_path = path + [action]\n                  heapq.heappush(open_set, (f_cost, new_path, new_state))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T09:36:19.497113", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def collect_primitives(env, initial_state):\n      cookbook = env.world.cookbook\n      goal_item = item\n      primitives_needed = cookbook.primitives_for(goal_item)\n      \n      action_sequence = []\n      current_state = initial_state\n      \n      for primitive_index in primitives_needed:\n          # Collect the primitive\n          collect_action_sequence = bfs_search(current_state, primitive_index)\n          if collect_action_sequence:\n              action_sequence.extend(collect_action_sequence)\n              \n              # Update the state after collecting the primitive\n              for action in collect_action_sequence:\n                  _, current_state = current_state.step(action)\n      \n      return action_sequence, current_state\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Try crafting the item directly first\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If direct crafting fails, try collecting primitives and then crafting\n      collect_action_sequence, updated_state = collect_primitives(env, initial_state)\n      \n      if collect_action_sequence:\n          action_sequence.extend(collect_action_sequence)\n          \n          # Try crafting again after collecting primitives\n          craft_action_sequence = bfs_search(updated_state, goal_item)\n          if craft_action_sequence:\n              action_sequence.extend(craft_action_sequence)\n              return action_sequence\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T09:36:35.153561", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def collect_primitives(env, initial_state, goal_item):\n      cookbook = env.world.cookbook\n      primitives_needed = cookbook.primitives_for(goal_item)\n      \n      action_sequence = []\n      \n      for primitive in primitives_needed:\n          primitive_index = next(iter(primitives_needed))\n          \n          # Collect the primitive\n          collect_action_sequence = bfs_search(initial_state, primitive_index)\n          if not collect_action_sequence:\n              return None  # If we can't collect a required primitive, fail\n      \n          action_sequence.extend(collect_action_sequence)\n          \n          # After collecting, try crafting again\n          new_state = initial_state\n          for action in collect_action_sequence:\n              _, new_state = new_state.step(action)\n      \n      return action_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Try crafting the item directly first\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If direct crafting fails, try collecting primitives and then crafting\n      primitive_action_sequence = collect_primitives(env, initial_state, goal_item)\n      \n      if not primitive_action_sequence:\n          return []  # Return empty list if no actions found\n      \n      action_sequence.extend(primitive_action_sequence)\n      \n      # After collecting primitives, try crafting again\n      new_state = initial_state\n      for action in primitive_action_sequence:\n          _, new_state = new_state.step(action)\n      \n      craft_action_sequence = bfs_search(new_state, goal_item)\n      if not craft_action_sequence:\n          return []  # Return empty list if no actions found\n      \n      action_sequence.extend(craft_action_sequence)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T09:38:07.534572", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=None):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        if max_depth is not None and len(path) >= max_depth:\n            continue\n        \n        for action in range(env.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def collect_primitives(env, initial_state, goal_item):\n    cookbook = env.world.cookbook\n    primitives_needed = cookbook.primitives_for(goal_item)\n    \n    action_sequence = []\n    \n    for primitive in primitives_needed:\n        primitive_index = next(iter(primitives_needed))\n        \n        # Collect the primitive\n        collect_action_sequence = bfs_search(initial_state, primitive_index, max_depth=20)  # Limit depth to 20 steps\n        if not collect_action_sequence:\n            return None  # If we can't collect a required primitive, fail\n        \n        action_sequence.extend(collect_action_sequence)\n        \n        # After collecting, try crafting again\n        new_state = initial_state\n        for action in collect_action_sequence:\n            _, new_state = new_state.step(action)\n    \n    return action_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Try crafting the item directly first\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If direct crafting fails, try collecting primitives and then crafting\n      primitive_action_sequence = collect_primitives(env, initial_state, goal_item)\n      \n      if not primitive_action_sequence:\n          return []  # Return empty list if no actions found\n      \n      action_sequence.extend(primitive_action_sequence)\n      \n      # After collecting primitives, try crafting again\n      new_state = initial_state\n      for action in primitive_action_sequence:\n          _, new_state = new_state.step(action)\n      \n      craft_action_sequence = bfs_search(new_state, goal_item, max_depth=20)  # Limit depth to 20 steps\n      if not craft_action_sequence:\n          return []  # Return empty list if no actions found\n      \n      action_sequence.extend(craft_action_sequence)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T09:38:23.253754", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        for action in range(env.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def collect_primitives(env, initial_state, goal_item):\n    cookbook = env.world.cookbook\n    primitives_needed = cookbook.primitives_for(goal_item)\n    \n    action_sequence = []\n    \n    for primitive in primitives_needed:\n        primitive_index = next(iter(primitives_needed))\n        \n        # Collect the primitive\n        collect_action_sequence = bfs_search(initial_state, primitive_index)\n        if not collect_action_sequence:\n            return None  # If we can't collect a required primitive, fail\n        \n        action_sequence.extend(collect_action_sequence)\n        \n        # After collecting, try crafting again\n        new_state = initial_state\n        for action in collect_action_sequence:\n            _, new_state = new_state.step(action)\n    \n    return action_sequence\n\n  def craft_with_primitives(env, initial_state, goal_item):\n    cookbook = env.world.cookbook\n    recipes = cookbook.recipes\n    \n    if goal_item not in recipes:\n      return None  # No recipe for the goal item\n    \n    recipe = recipes[goal_item]\n    action_sequence = []\n    \n    # Ensure all ingredients are available\n    for ingredient, count in recipe.items():\n        if ingredient == \"_key\":\n            continue\n        \n        while initial_state.inventory[ingredient] < count:\n            collect_action_sequence = bfs_search(initial_state, ingredient)\n            if not collect_action_sequence:\n                return None  # If we can't collect an ingredient, fail\n            \n            action_sequence.extend(collect_action_sequence)\n            \n            # Update the state after collecting\n            new_state = initial_state\n            for action in collect_action_sequence:\n                _, new_state = new_state.step(action)\n            initial_state = new_state\n    \n    # Craft the item\n    craft_action_sequence = bfs_search(initial_state, goal_item)\n    if not craft_action_sequence:\n        return None  # If we can't craft the item, fail\n    \n    action_sequence.extend(craft_action_sequence)\n    \n    return action_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Try crafting the item directly first\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If direct crafting fails, try collecting primitives and then crafting\n      primitive_action_sequence = collect_primitives(env, initial_state, goal_item)\n      \n      if not primitive_action_sequence:\n          return []  # Return empty list if no actions found\n      \n      action_sequence.extend(primitive_action_sequence)\n      \n      # After collecting primitives, try crafting again\n      new_state = initial_state\n      for action in primitive_action_sequence:\n          _, new_state = new_state.step(action)\n      \n      craft_action_sequence = craft_with_primitives(env, new_state, goal_item)\n      if not craft_action_sequence:\n          return []  # Return empty list if no actions found\n      \n      action_sequence.extend(craft_action_sequence)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T09:39:45.318767", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, depth_limit=50):  # Added depth limit to prevent infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= depth_limit:  # Skip paths exceeding the depth limit\n              continue\n          \n          # Try actions in a specific order with heuristics\n          for action in prioritize_actions(env.world.n_actions, current_state, path[-1] if path else None):\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_actions(n_actions, current_state, last_action=None):\n      \"\"\"Prioritize actions based on heuristics.\"\"\"\n      priority = []\n      \n      # Always try to USE first\n      if last_action != 4:  # Avoid consecutive USE actions\n          priority.append(4)\n      \n      # Prioritize movement towards resources or workshops\n      for action in range(n_actions - 1):  # Exclude USE action (index 4)\n          new_pos = move_position(current_state.pos, current_state.dir, action)\n          if is_next_to_resource_or_workshop(new_pos, current_state):\n              priority.append(action)\n      \n      # Avoid repeating the same movement action consecutively\n      move_actions = list(range(n_actions - 1))  # Exclude USE action (index 4)\n      if last_action in move_actions:\n          move_actions.remove(last_action)\n      \n      return priority + move_actions\n\n  def move_position(pos, direction, action):\n      \"\"\"Calculate the new position based on current position, direction, and action.\"\"\"\n      directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # UP, DOWN, LEFT, RIGHT\n      dx, dy = directions[direction]\n      \n      if action == 0:  # DOWN\n          return pos[0] + dy, pos[1] + dx\n      elif action == 1:  # UP\n          return pos[0] - dy, pos[1] - dx\n      elif action == 2:  # LEFT\n          return pos[0] - dx, pos[1] - dy\n      elif action == 3:  # RIGHT\n          return pos[0] + dx, pos[1] + dy\n      \n      return pos\n\n  def is_next_to_resource_or_workshop(pos, state):\n      \"\"\"Check if the position is next to any resource or workshop.\"\"\"\n      for i_kind in range(state.world.n_kinds):\n          if state.next_to(i_kind) and (i_kind in state.world.grabbable_indices or i_kind in state.world.workshop_indices):\n              return True\n      return False\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T09:39:46.309773", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, depth_limit=50):  # Added depth limit to prevent infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= depth_limit:  # Skip paths exceeding the depth limit\n              continue\n          \n          for action in prioritize_actions(env.world.n_actions, current_state, path[-1] if path else None):\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_actions(n_actions, current_state, last_action=None):\n      \"\"\"Prioritize actions based on heuristics.\"\"\"\n      priority = []\n      \n      # Always try to USE first\n      if last_action != 4:  # Avoid consecutive USE actions\n          priority.append(4)\n      \n      # Prioritize moving towards items needed for crafting\n      items_needed = items_required_for_goal(current_state, env.world.cookbook.primitives_for(item))\n      move_towards_actions = prioritize_movement(current_state, items_needed)\n      if move_towards_actions:\n          priority.extend(move_towards_actions)\n      \n      # Avoid repeating the same movement action consecutively\n      move_actions = list(range(n_actions))\n      if last_action in move_actions:\n          move_actions.remove(last_action)\n      \n      return priority + move_actions\n\n  def items_required_for_goal(state, primitives):\n      \"\"\"Determine which primitive items are needed to craft the goal.\"\"\"\n      required_items = []\n      for item, count in primitives.items():\n          if state.inventory[item] < count:\n              required_items.append(item)\n      return required_items\n\n  def prioritize_movement(current_state, items_needed):\n      \"\"\"Prioritize movement actions towards items needed.\"\"\"\n      move_actions = list(range(env.world.n_actions - 1))  # Exclude USE action\n      prioritized_moves = []\n      \n      for item in items_needed:\n          if current_state.next_to(item):\n              # If item is next to the agent, prioritize USE action\n              return [4]\n          \n          # Check which move actions bring the agent closer to the item\n          for action in move_actions:\n              new_pos = tuple(np.array(current_state.pos) + np.array(env.world.ACTIONS[action]))\n              if any(new_pos == np.array(item) for item in items_needed):\n                  prioritized_moves.append(action)\n      \n      return prioritized_moves\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T09:42:02.179108", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def get_neighbors(pos, width, height):\n      x, y = pos\n      neighbors = []\n      if x > 0: \n          neighbors.append((x - 1, y))\n      if x < width - 1: \n          neighbors.append((x + 1, y))\n      if y > 0: \n          neighbors.append((x, y - 1))\n      if y < height - 1: \n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def a_star_search(start_pos, goal_pos, initial_state):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, start_pos, []))\n      came_from = {}\n      g_score = {start_pos: 0}\n      f_score = {start_pos: heuristic(start_pos, goal_pos)}\n      \n      while open_set:\n          _, current_pos, path = heappop(open_set)\n          \n          if current_pos == goal_pos:\n              return path\n          \n          for neighbor in get_neighbors(current_pos, width, height):\n              tentative_g_score = g_score[current_pos] + 1\n              \n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = (current_pos, path)\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  heappush(open_set, (f_score[neighbor], neighbor, path + [neighbor]))\n          \n      return None\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that might lead to the goal item more directly\n          prioritized_actions = prioritize_actions(current_state, goal_item)\n          for action in prioritized_actions + [a for a in range(env.world.n_actions) if a not in prioritized_actions]:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_actions(current_state, goal_item):\n      \"\"\"Prioritize actions that might lead to the goal item more directly.\"\"\"\n      prioritized_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = current_state.step(action)\n          \n          # Check if any of the neighboring cells contain ingredients needed for the goal item\n          primitives_needed = env.world.cookbook.primitives_for(goal_item).keys()\n          for primitive_idx, count in primitives_needed.items():\n              if current_state.next_to(primitive_idx):\n                  prioritized_actions.append(action)\n      \n      return list(set(prioritized_actions))  # Remove duplicates\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n    # If BFS doesn't find a solution, try to move closer to the nearest resource needed for the goal.\n    initial_grid = initial_state.grid\n    width, height, _ = initial_grid.shape\n    \n    # Find positions of resources needed for the goal in the grid\n    required_resources = env.world.cookbook.primitives_for(goal_item).keys()\n    resource_positions = [(x, y) \n                          for x in range(width) \n                          for y in range(height) \n                          if any(initial_grid[x, y, res] > 0 for res in required_resources)]\n    \n    if not resource_positions:\n        return []  # No resources found to move towards\n    \n    closest_resource = min(resource_positions, key=lambda pos: heuristic(pos, initial_state.pos))\n    \n    # Perform A* search to move closer to the closest resource\n    resource_path = a_star_search(initial_state.pos, closest_resource, initial_state)\n    \n    if not resource_path:\n        return []  # No path found to the resource\n    \n    action_sequence = []\n    current_pos = initial_state.pos\n    direction_mapping = {0: (0, -1), 1: (0, 1), 2: (-1, 0), 3: (1, 0)}\n    \n    for next_pos in resource_path:\n        dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n        \n        # Determine the direction to move\n        if dx == 1:\n            action_sequence.append(3)  # RIGHT\n        elif dx == -1:\n            action_sequence.append(2)  # LEFT\n        elif dy == 1:\n            action_sequence.append(1)  # DOWN\n        elif dy == -1:\n            action_sequence.append(0)  # UP\n        \n        current_pos = next_pos\n    \n    return action_sequence\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
