     \n      for item_index in range(len(cookbook.index)):\n          primitives = {}\n          dfs(item_index)\n          primitive_counts_cache[item_index] = primitives\n      \n      return primitive_counts_cache\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Precompute primitive counts for all items\n  primitive_counts_cache = precompute_primitive_counts(initial_state.world.cookbook)\n\n  def get_primitive_counts_cached(goal_index, cookbook):\n      return primitive_counts_cache[goal_index]\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      return []\n\n  # Optimize the action sequence by merging consecutive USE actions\n  optimized_action_sequence = optimize_actions(action_sequence)\n  \n  return optimized_action_sequence", "island_id": 5, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T02:49:11.662190", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  possible_actions.append((new_state, action))\n          \n          # Prioritize actions that move towards primitives or use them\n          sorted_possible_actions = sorted(\n              possible_actions,\n              key=lambda x: (\n                  -sum(x[0].inventory[primitive] > 0 for primitive in goal_primitives), \n                  sum(x[0].next_to(primitive) for primitive in goal_primitives), \n                  -x[1]  # Prioritize USE action over movement\n              )\n          )\n          \n          queue.extend((new_state, path + [action]) for new_state, action in sorted_possible_actions)\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of primitives needed that are not yet in inventory\n      goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n      required_primitives_count = sum(\n          count for primitive, count in goal_primitives.items() \n          if state.inventory[primitive] < count\n      )\n      return required_primitives_count\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          current_f_score, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  possible_actions.append((new_state, action))\n          \n          # Prioritize actions using A* heuristic\n          for new_state, action in possible_actions:\n              g_score = len(path) + 1\n              h_score = heuristic(new_state, goal_item)\n              f_score = g_score + h_score\n              \n              heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-27T02:49:13.062447", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  possible_actions.append((new_state, action))\n          \n          # Prioritize actions that move towards primitives or use them\n          sorted_possible_actions = sorted(\n              possible_actions,\n              key=lambda x: (\n                  -sum(x[0].inventory[primitive] > 0 for primitive in goal_primitives), \n                  sum(x[0].next_to(primitive) for primitive in goal_primitives), \n                  -x[1]  # Prioritize USE action over movement\n              )\n          )\n          \n          queue.extend((new_state, path + [action]) for new_state, action in sorted_possible_actions)\n      \n      return None  # Return None if no sequence is found\n\n  def get_closest_primitive(initial_state, goal_primitives):\n      min_distance = float('inf')\n      closest_primitive = None\n      \n      for primitive in goal_primitives:\n          for dx in range(-1, 2):\n              for dy in range(-1, 2):\n                  pos = (initial_state.pos[0] + dx, initial_state.pos[1] + dy)\n                  if 0 <= pos[0] < initial_state.world.scenario.init_grid.shape[0] and \\\n                     0 <= pos[1] < initial_state.world.scenario.init_grid.shape[1]:\n                      if initial_state.grid[pos][primitive] > 0:\n                          distance = abs(dx) + abs(dy)\n                          if distance < min_distance:\n                              min_distance = distance\n                              closest_primitive = primitive\n      \n      return closest_primitive\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = []\n\n  while not satisfies_goal(initial_state, goal_item):\n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      if not goal_primitives:\n          return []  # No primitives found to make the goal item\n      \n      closest_primitive = get_closest_primitive(initial_state, goal_primitives)\n      \n      if closest_primitive is None:\n          return []  # No reachable primitive found\n      \n      # Move towards the closest primitive\n      target_pos = None\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              pos = (initial_state.pos[0] + dx, initial_state.pos[1] + dy)\n              if 0 <= pos[0] < initial_state.world.scenario.init_grid.shape[0] and \\\n                 0 <= pos[1] < initial_state.world.scenario.init_grid.shape[1]:\n                  if initial_state.grid[pos][closest_primitive] > 0:\n                      target_pos = pos\n                      break\n      \n      if target_pos is None:\n          return []  # No reachable position found for the closest primitive\n      \n      # Calculate path to the target position\n      path_to_target = bfs_search(initial_state, target_pos)\n      \n      if not path_to_target:\n          return []  # No path found to the target position\n      \n      action_sequence.extend(path_to_target)\n      initial_state = env._current_state\n      \n      for _ in range(len(path_to_target)):\n          reward, new_state = initial_state.step(action_sequence[-1])\n          initial_state = new_state\n      \n      # Collect and use primitives\n      if satisfies_goal(initial_state, closest_primitive):\n          action_sequence.append(4)  # Use action to collect the primitive\n\n  return action_sequence", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-27T02:50:29.009054", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):  # Added a max_steps parameter to prevent infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum number of steps\n          if len(path) >= max_steps:\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  # Helper function to get primitives required for a goal item\n  def get_primitives_for(goal_item):\n      return set(env.world.cookbook.primitives_for(goal_item).keys())\n\n  # Get all primitives needed for the goal item\n  required_primitives = get_primitives_for(goal_item)\n\n  # Check if we already have all required primitives in inventory or environment\n  available_primitives = {idx: initial_state.inventory[idx] for idx in env.world.grabbable_indices}\n  available_in_env = [env.world.cookbook.index.get(name) for name, idx in env.world.cookbook.environment.items()]\n  \n  if all(primitive in available_primitives or primitive in available_in_env for primitive in required_primitives):\n      action_sequence = bfs_search(initial_state, goal_item)\n      \n      if action_sequence is None:\n          raise ValueError(\"No sequence of actions found to craft the item.\")\n      \n      return action_sequence\n\n  # If not all primitives are available, prioritize actions that lead to required primitives\n  def heuristic(action, state):\n      _, new_state = state.step(action)\n      new_inventory_count = sum(new_state.inventory[primitive] for primitive in env.world.cookbook.primitives_for(goal_item))\n      return -new_inventory_count\n\n  # Collect all primitives needed before proceeding with crafting the goal item\n  action_sequence = []\n  current_state = initial_state\n  \n  for primitive in required_primitives:\n      if not (available_primitives.get(primitive, 0) > 0 or primitive in available_in_env):\n          primitive_action_sequence = bfs_search(current_state, primitive)\n          \n          if primitive_action_sequence is None:\n              raise ValueError(f\"No sequence of actions found to obtain the required primitive: {primitive}\")\n          \n          action_sequence.extend(primitive_action_sequence)\n          _, current_state = current_state.step(primitive_action_sequence[-1])\n\n  # Now that all primitives are collected, craft the goal item\n  final_action_sequence = bfs_search(current_state, goal_item)\n  \n  if final_action_sequence is None:\n      raise ValueError(\"No sequence of actions found to craft the item after collecting required primitives.\")\n  \n  action_sequence.extend(final_action_sequence)\n\n  return action_sequence", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-27T02:50:30.241628", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(action, state):\n      _, new_state = state.step(action)\n      # Calculate the number of primitives required for the goal item\n      required_primitives = env.world.cookbook.primitives_for(goal_item)\n      # Calculate the number of available primitives after taking the action\n      available_primitives_count = sum(\n          new_state.inventory[primitive] \n          for primitive in required_primitives\n      )\n      return -available_primitives_count\n\n  def a_star_search(initial_state, goal_item, max_steps=500):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))  # (f_score, state, path)\n      visited = set()\n      \n      while open_set:\n          f_score, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum number of steps\n          if len(path) >= max_steps:\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  \n                  g_score = len(path) + 1  # Cost from start to current node\n                  h_score = heuristic(action, current_state)  # Heuristic cost estimate to goal\n                  f_score = g_score + h_score\n                  \n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if action_sequence is None:\n      raise ValueError(\"No sequence of actions found to craft the item.\")\n\n  return action_sequence", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-27T02:51:54.445635", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_primitives):\n      # Calculate the number of required primitives already available in inventory\n      available_primitives = sum(\n          min(state.inventory[primitive], goal_primitives[primitive])\n          for primitive in goal_primitives\n      )\n      return len(goal_primitives) - available_primitives\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))  # (f_score, state, path)\n      \n      g_scores = {initial_state: 0}\n      visited = set()\n      \n      while open_set:\n          f_score, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  tentative_g_score = g_scores[current_state] + 1\n                  \n                  if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n                      g_scores[state_hash] = tentative_g_score\n                      f_score = tentative_g_score + heuristic(new_state, goal_primitives)\n                      heapq.heappush(open_set, (f_score, new_state, path + [action]))\n                      \n                  visited.add(state_hash)\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-27T02:51:55.796498", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from the current state to the goal.\"\"\"\n      goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n      missing_primitives = sum(max(0, goal_primitives[prim] - state.inventory[prim]) for prim in goal_primitives)\n      return missing_primitives\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      from collections import defaultdict\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      g_score = defaultdict(lambda: float('inf'))\n      g_score[tuple(initial_state.grid.flatten()), tuple(initial_state.inventory), initial_state.pos, initial_state.dir] = 0\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)