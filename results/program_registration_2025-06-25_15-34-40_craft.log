{"timestamp": "2025-06-26T20:28:45.419120", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      \"\"\"\n      A simple heuristic function that could be based on the number of items\n      required to craft the goal item minus the current inventory.\n      \"\"\"\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      total_missing = sum(primitives.get(i, 0) for i in range(env.world.n_kinds) if state.inventory[i] < primitives.get(i, 0))\n      return max(1, total_missing)\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      from collections import defaultdict\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T20:29:45.699942", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Store the state attributes that uniquely identify the state\n          state_hash = (tuple(current_state.grid.flatten()), \n                        tuple(current_state.inventory), \n                        current_state.pos, \n                        current_state.dir)\n              \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form\n              new_state_hash = (tuple(new_state.grid.flatten()), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir)\n              \n              if new_state_hash not in visited:\n                  visited.add(new_state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 1.5}}
