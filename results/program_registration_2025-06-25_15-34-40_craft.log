{"timestamp": "2025-06-26T18:06:03.436730", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Consider only valid actions (e.g., not walking into walls)\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              # If the state is unchanged, skip adding it to the queue\n              if np.array_equal(new_state.grid, current_state.grid) and\\\n                 np.array_equal(new_state.inventory, current_state.inventory) and\\\n                 new_state.pos == current_state.pos and\\\n                 new_state.dir == current_state.dir:\n                  continue\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_neighbors(pos, grid_shape):\n      x, y = pos\n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      neighbors = []\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              neighbors.append((nx, ny))\n      return neighbors\n\n  def heuristic(pos, goal_pos):\n      return abs(pos[0] - goal_pos[0]) + abs(pos[1] - goal_pos[1])\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + (initial_state.pos, initial_state.dir): 0}\n      \n      goal_pos = None\n      for x in range(env.world.cookbook.index.get(goal_item)):\n          for y in range(env.world.cookbook.index.get(goal_item)):\n              if env._current_state.grid[x, y, env.world.cookbook.index.get(goal_item)] > 0:\n                  goal_pos = (x, y)\n                  break\n          if goal_pos is not None:\n              break\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              # If the state is unchanged, skip adding it to the queue\n              if np.array_equal(new_state.grid, current_state.grid) and\\\n                 np.array_equal(new_state.inventory, current_state.inventory) and\\\n                 new_state.pos == current_state.pos and\\\n                 new_state.dir == current_state.dir:\n                  continue\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos, current_state.dir)] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (tuple(current_state.grid.flatten()), \n                                           tuple(current_state.inventory), \n                                           current_state.pos, \n                                           current_state.dir)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state.pos, goal_pos) if goal_pos else 0\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:06:58.171664", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      from collections import defaultdict\n      import heapq\n      \n      # Priority queue for A* search\n      open_set = []\n      heapq.heappush(open_set, (0, initial_state))\n      \n      # Dictionaries to store the cost and came_from information\n      g_score = defaultdict(lambda: float('inf'))\n      g_score[initial_state] = 0\n      f_score = defaultdict(lambda: float('inf'))\n      f_score[initial_state] = heuristic(initial_state, goal_item)\n      \n      came_from = {}\n      \n      while open_set:\n          _, current_state = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state)\n          \n          for action in range(env.world.n_actions):\n              # Skip USE action if there's nothing to use in the 3x3 grid around the agent\n              if action == 4:\n                  if not any(current_state.grid[\n                      max(0, current_state.pos[0]-1):min(env.scenario.init_grid.shape[0], current_state.pos[0]+2),\n                      max(0, current_state.pos[1]-1):min(env.scenario.init_grid.shape[1], current_state.pos[1]+2)\n                  ].flatten()):\n                      continue\n              \n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[current_state] + 1  # Cost of each action is assumed to be 1\n              \n              if tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score[new_state], new_state))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      \"\"\"Simple heuristic function that returns the number of steps required to collect all primitives needed for the goal.\"\"\"\n      cookbook = env.world.cookbook\n      primitive_counts = cookbook.primitives_for(goal_item)\n      \n      steps = 0\n      \n      # Check if the inventory already has the required primitives\n      for i, count in primitive_counts.items():\n          missing_count = max(0, count - state.inventory[i])\n          steps += missing_count\n      \n      return steps\n\n  def reconstruct_path(came_from, current_state):\n      total_path = []\n      \n      while current_state in came_from:\n          prev_state, action = came_from[current_state]\n          total_path.append(action)\n          current_state = prev_state\n      \n      total_path.reverse()\n      return total_path\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:07:13.979497", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              # Skip USE action if there's nothing to use in the 3x3 grid around the agent\n              if action == 4:\n                  neighborhood = current_state.grid[\n                      max(0, current_state.pos[0]-1):min(env.scenario.init_grid.shape[0], current_state.pos[0]+2),\n                      max(0, current_state.pos[1]-1):min(env.scenario.init_grid.shape[1], current_state.pos[1]+2)\n                  ]\n                  if not np.any(neighborhood):\n                      continue\n              \n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T18:07:59.121004", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n    # Implement a heuristic function to estimate the cost from current_state to reach the goal.\n    # For simplicity, we can use the number of items missing from the inventory as a heuristic.\n    # This is just a placeholder and can be improved based on domain knowledge.\n    \n    cookbook = env.world.cookbook\n    primitives_needed = cookbook.primitives_for(goal_item)\n    current_inventory = current_state.inventory\n    \n    missing_items_count = 0\n    for primitive, count in primitives_needed.items():\n        if current_inventory[primitive] < count:\n            missing_items_count += (count - current_inventory[primitive])\n    \n    return missing_items_count\n\n  def a_star_search(initial_state, goal_item):\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, initial_state, []))  # (f_score, state, path)\n    came_from = {}\n    g_score = {initial_state: 0}\n    f_score = {initial_state: heuristic(initial_state, goal_item)}\n    \n    while open_set:\n        _, current_state, path = heapq.heappop(open_set)\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        for action in range(env.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            tentative_g_score = g_score[current_state] + 1  # Assuming each action has the same cost\n            \n            if state_hash not in g_score or tentative_g_score < g_score[new_state]:\n                came_from[state_hash] = (current_state, path)\n                g_score[new_state] = tentative_g_score\n                f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                heapq.heappush(open_set, (f_score[new_state], new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:08:14.713475", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        for action in range(env.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid and a recipe exists for it or it's a primitive\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T18:09:26.447910", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, depth_limit=50):  # Added depth limit to prevent infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [], heuristic(initial_state, goal_item))])\n      visited = set()\n      \n      while queue:\n          current_state, path, _ = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= depth_limit:  # Skip paths exceeding the depth limit\n              continue\n          \n          for action in prioritize_actions(env.world.n_actions, path[-1] if path else None):\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  h_value = heuristic(new_state, goal_item)\n                  queue.append((new_state, path + [action], h_value))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_actions(n_actions, last_action=None):\n      \"\"\"Prioritize actions based on heuristics.\"\"\"\n      priority = []\n      \n      # Always try to USE first\n      if last_action != 4:  # Avoid consecutive USE actions\n          priority.append(4)\n      \n      # Avoid repeating the same movement action consecutively\n      move_actions = list(range(n_actions))\n      if last_action in move_actions:\n          move_actions.remove(last_action)\n      \n      return priority + move_actions\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function to estimate distance to goal.\"\"\"\n      # Simple heuristic: count the number of ingredients needed that are not in inventory\n      recipe = env.world.cookbook.primitives_for(goal_item)\n      required_ingredients = set(recipe.keys())\n      available_ingredients = set(np.where(state.inventory > 0)[0])\n      \n      missing_ingredients = required_ingredients - available_ingredients\n      \n      return len(missing_ingredients)\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T18:09:27.409903", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item, heuristic_func=None, depth_limit=50):  \n      from heapq import heappush, heappop\n      from collections import defaultdict\n      \n      # Priority queue to hold states with their estimated costs\n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      \n      # Set to track visited states\n      visited = set()\n      \n      while open_set:\n          current_cost, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= depth_limit:  # Skip paths exceeding the depth limit\n              continue\n\n          for action in prioritize_actions(env.world.n_actions, path[-1] if path else None):\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n\n                  # Calculate the cost to reach this new state\n                  action_cost = 1 + (reward * -1)  # Assuming negative rewards are penalties\n                  \n                  # Estimate total cost with heuristic\n                  if heuristic_func:\n                      estimated_total_cost = current_cost + action_cost + heuristic_func(new_state, goal_item)\n                  else:\n                      estimated_total_cost = current_cost + action_cost\n\n                  heappush(open_set, (estimated_total_cost, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_actions(n_actions, last_action=None):\n      \"\"\"Prioritize actions based on heuristics.\"\"\"\n      priority = []\n      \n      # Always try to USE first\n      if last_action != 4:  # Avoid consecutive USE actions\n          priority.append(4)\n      \n      # Avoid repeating the same movement action consecutively\n      move_actions = list(range(n_actions))\n      if last_action in move_actions:\n          move_actions.remove(last_action)\n      \n      return priority + move_actions\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function to estimate distance to goal.\"\"\"\n      recipe = env.world.cookbook.primitives_for(goal_item)\n      required_ingredients = set(recipe.keys())\n      available_ingredients = set(np.where(state.inventory > 0)[0])\n      \n      missing_ingredients = required_ingredients - available_ingredients\n      \n      return len(missing_ingredients)\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item, heuristic_func=heuristic)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:10:17.492174", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reset_and_get_initial_state(env):\n      env.reset(seed=0)\n      return env._current_state\n  \n  initial_state = reset_and_get_initial_state(env)\n  goal_item = item\n  \n  # Ensure the goal item is within the cookbook's index range\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item index {goal_item} not found in the cookbook.\")\n      \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T18:10:33.041344", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is within the cookbook's index range\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item index {goal_item} not found in the cookbook.\")\n      \n  # Reset environment to a deterministic state for consistent search results\n  env.reset(seed=0)\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T18:11:33.999806", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= max_steps:  # Limit the search depth to avoid infinite loops\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(current_state, goal_item):\n    \"\"\"Simple heuristic: number of items needed to craft the goal.\"\"\"\n    primitives = env.world.cookbook.primitives_for(goal_item)\n    current_inventory = current_state.inventory\n    \n    total_needed = 0\n    for primitive_idx, count in primitives.items():\n        if current_inventory[primitive_idx] < count:\n            total_needed += (count - current_inventory[primitive_idx])\n    \n    return total_needed\n\n  def a_star_search(initial_state, goal_item, max_steps=500):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      \n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= max_steps:  # Limit the search depth to avoid infinite loops\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  cost = len(path) + heuristic(new_state, goal_item)\n                  heappush(open_set, (cost, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # Reset the environment and try again\n      env.reset()\n      initial_state = env._current_state\n      action_sequence = a_star_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:11:49.524423", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= max_steps:  # Limit the search depth to avoid infinite loops\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # Reset the environment and try again\n      env.reset()\n      initial_state = env._current_state\n      action_sequence = bfs_search(initial_state, goal_item)\n      \n      if not action_sequence:\n          # Perform a heuristic search to find a partial sequence towards the goal\n          # This could involve breaking down the crafting steps into smaller sub-goals\n          # For simplicity, we'll just perform a few random actions and see if it helps\n          max_random_steps = 10\n          for _ in range(max_random_steps):\n              action_sequence = bfs_search(initial_state, goal_item)\n              if action_sequence:\n                  break\n              else:\n                  random_action = env.world.random.randint(env.world.n_actions)\n                  reward, new_state = initial_state.step(random_action)\n                  initial_state = new_state\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 1.5}}
