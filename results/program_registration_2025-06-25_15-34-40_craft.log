{"timestamp": "2025-06-27T02:53:02.806284", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic_cost_estimate(current_state, goal_state):\n      # Simple Manhattan distance between the agent's position and any available ingredient\n      # or workshop in the current state grid.\n      goal_item_indices = np.argwhere(goal_state.grid[:, :, item] > 0)\n      if goal_item_indices.size == 0:\n          return float('inf')  # No path to the goal\n      \n      agent_pos = current_state.pos\n      distances = [abs(agent_pos[0] - x) + abs(agent_pos[1] - y) for x, y in goal_item_indices]\n      return min(distances)\n\n  def a_star_search(initial_state, goal_item):\n      from collections import deque\n      import heapq\n      \n      # Priority queue for A* search\n      open_set = []\n      heapq.heappush(open_set, (0, initial_state))\n      \n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + (initial_state.pos,) + (initial_state.dir,): 0}\n      f_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + (initial_state.pos,) + (initial_state.dir,): heuristic_cost_estimate(initial_state, initial_state)}\n      \n      while open_set:\n          _, current_state = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (tuple(current_state.grid.flatten()), \n                                          tuple(current_state.inventory), \n                                          current_state.pos, \n                                          current_state.dir)\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic_cost_estimate(new_state, initial_state)\n                  heapq.heappush(open_set, (f_score[state_hash], new_state))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state):\n      total_path = []\n      state_hash = (tuple(current_state.grid.flatten()), \n                    tuple(current_state.inventory), \n                    current_state.pos, \n                    current_state.dir)\n      \n      while state_hash in came_from:\n          total_path.append(state_hash)\n          state_hash = came_from[state_hash]\n      \n      # Convert the path to actions\n      action_sequence = []\n      for i in range(len(total_path) - 1):\n          prev_state = total_path[i]\n          current_state = total_path[i + 1]\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = env._current_state.step(action)\n              \n              if (tuple(new_state.grid.flatten()), \n                  tuple(new_state.inventory), \n                  new_state.pos, \n                  new_state.dir) == current_state:\n                  action_sequence.append(action)\n                  break\n      \n      return list(reversed(action_sequence))\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-27T02:53:04.074905", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic_search(initial_state, goal_item, max_depth=50):\n      from queue import PriorityQueue\n      \n      # Define a simple heuristic function\n      def heuristic(state, goal_item):\n          # Simple heuristic: number of steps taken so far (depth)\n          return len(path)\n      \n      pq = PriorityQueue()\n      pq.put((heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      \n      while not pq.empty():\n          _, current_state, path = pq.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if len(path) < max_depth and state_hash not in visited:\n                  visited.add(state_hash)\n                  pq.put((heuristic(new_state, goal_item), new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = heuristic_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-27T02:54:49.652661", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      state_to_goal_primitives = {state_hash(initial_state): get_primitive_counts(goal_item, initial_state.world.cookbook)}\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item from the cache or compute them\n          goal_primitives = state_to_goal_primitives[state_hash(current_state)]\n          \n          # Filter actions based on available inventory and required primitives\n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              valid_actions.append((new_state, action))\n          \n          # Heuristic: Prioritize actions that move closer to having required primitives\n          valid_actions.sort(\n              key=lambda x: sum(min(get_primitive_counts(goal_item, x[0].world.cookbook).get(primitive, 0) - current_primitives, 0)\n                                  for primitive, current_primitives in goal_primitives.items()),\n              reverse=True\n          )\n          \n          for new_state, action in valid_actions:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash_value = state_hash(new_state)\n              \n              if state_hash_value not in visited:\n                  visited.add(state_hash_value)\n                  queue.append((new_state, path + [action]))\n                  state_to_goal_primitives[state_hash_value] = get_primitive_counts(goal_item, new_state.world.cookbook)\n      \n      return None  # Return None if no sequence is found\n\n  def state_hash(state):\n      \"\"\"Returns a hashable representation of the state.\"\"\"\n      grid_tuple = tuple(state.grid.flatten())\n      inventory_tuple = tuple(state.inventory)\n      pos_tuple = (state.pos[0], state.pos[1])\n      return (grid_tuple, inventory_tuple, pos_tuple, state.dir)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is a valid index in the cookbook\n  if not (0 <= goal_item < initial_state.world.cookbook.n_kinds):\n      raise ValueError(f\"Goal item index {goal_item} is out of bounds.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3