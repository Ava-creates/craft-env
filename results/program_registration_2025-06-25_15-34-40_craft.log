{"timestamp": "2025-06-27T15:14:03.968141", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def get_closest_resource(state, resource_indices):\n      \"\"\"Find the closest resource of any given type using BFS.\"\"\"\n      from collections import deque\n      \n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      queue = deque([(state.pos, [])])\n      visited = set([state.pos])\n\n      while queue:\n          current_pos, path = queue.popleft()\n\n          if any(state.grid[current_pos[0], current_pos[1], resource_index] > 0 for resource_index in resource_indices):\n              return path\n\n          for d in directions:\n              new_pos = (current_pos[0] + d[0], current_pos[1] + d[1])\n\n              if (0 <= new_pos[0] < state.grid.shape[0] and \n                  0 <= new_pos[1] < state.grid.shape[1] and \n                  new_pos not in visited):\n                  visited.add(new_pos)\n                  move = move_towards(state.pos, new_pos)\n                  queue.append((new_pos, path + [move]))\n\n      return None\n\n  def move_towards(current_pos, target_pos) -> int:\n      \"\"\"Determine the action to move towards the target position.\"\"\"\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          return 2 if dx < 0 else 3\n      else:\n          return 0 if dy < 0 else 1\n\n  def find_path_to_use_action(state, goal_item):\n      \"\"\"Find a path to an action that can contribute to making the goal item.\"\"\"\n      from collections import deque\n      \n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      queue = deque([(state.pos, [])])\n      visited = set([state.pos])\n      \n      while queue:\n          current_pos, path = queue.popleft()\n          \n          # Check if USE action at current position can contribute to making the goal item\n          reward, new_state = state.step(4)\n          if satisfies_goal(new_state, goal_item):\n              return path + [4]\n          \n          for d in directions:\n              new_pos = (current_pos[0] + d[0], current_pos[1] + d[1])\n              \n              if (0 <= new_pos[0] < state.grid.shape[0] and \n                  0 <= new_pos[1] < state.grid.shape[1] and \n                  new_pos not in visited):\n                  visited.add(new_pos)\n                  move = move_towards(state.pos, new_pos)\n                  queue.append((new_pos, path + [move]))\n      \n      return None\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def execute_actions(env, actions):\n      for action in actions:\n          env.step(action)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available in inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n  \n  if not action_sequence:\n      return []  # Return empty list if no actions found\n\n  execute_actions(env, action_sequence)\n  return action_sequence", "island_id": 4, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T15:14:34.029470", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def get_closest_resource(state, resource_indices):\n      \"\"\"Find the closest resource of any given type using BFS.\"\"\"\n      from collections import deque\n      \n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      queue = deque([(state.pos, [])])\n      visited = set([state.pos])\n\n      while queue:\n          current_pos, path = queue.popleft()\n\n          if any(state.grid[current_pos[0], current_pos[1], resource_index] > 0 for resource_index in resource_indices):\n              return path\n\n          for d in directions:\n              new_pos = (current_pos[0] + d[0], current_pos[1] + d[1])\n\n              if (0 <= new_pos[0] < state.grid.shape[0] and \n                  0 <= new_pos[1] < state.grid.shape[1] and \n                  new_pos not in visited):\n                  visited.add(new_pos)\n                  move = move_towards(state.pos, new_pos)\n                  queue.append((new_pos, path + [move]))\n\n      return None\n\n  def move_towards(current_pos, target_pos) -> int:\n      \"\"\"Determine the action to move towards the target position.\"\"\"\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          return 2 if dx < 0 else 3\n      else:\n          return 0 if dy < 0 else 1\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Add logic to collect resources if inventory is insufficient\n              if not all(new_state.inventory[resource] >= count for resource, count in goal_primitives.items()):\n                  # Find closest resource and move towards it\n                  resource_indices = [res for res in goal_primitives.keys() if new_state.inventory[res] < goal_primitives[res]]\n                  resource_path = get_closest_resource(current_state, resource_indices)\n                  \n                  if not resource_path:\n                      continue  # Skip this action if no resource path is found\n\n                  queue.append((current_state, path + resource_path))\n              else:\n                  # Convert the new state to a hashable form using a tuple of its attributes\n                  state_hash = (tuple(new_state.grid.flatten()), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir)\n                  \n                  if state_hash not in visited:\n                      visited.add(state_hash)\n                      queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def execute_actions(env, actions):\n      for action in actions:\n          env.step(action)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available in inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n  \n  if not action_sequence:\n      return []  # Return empty list if no actions found\n\n  execute_actions(env, action_sequence)\n  return action_sequence", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-27T15:16:57.931516", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_closest_item_position(state, item_index):\n      \"\"\"Find the closest position of an item within the grid.\"\"\"\n      grid = state.grid\n      positions = np.argwhere(grid[:, :, item_index] > 0)\n      if len(positions) == 0:\n          return None\n      player_pos = state.pos\n      distances = [np.linalg.norm(pos - player_pos, ord=1) for pos in positions]\n      closest_position = positions[np.argmin(distances)]\n      return tuple(closest_position)\n\n  def move_to_position(state, target_position):\n      \"\"\"Generate a sequence of actions to move the player to the target position.\"\"\"\n      current_pos = np.array(state.pos)\n      target_pos = np.array(target_position)\n      \n      # Calculate direction vector\n      direction_vector = target_pos - current_pos\n      \n      action_sequence = []\n      if direction_vector[0] > 0:\n          action_sequence.extend([1] * abs(direction_vector[0]))  # Move right\n      elif direction_vector[0] < 0:\n          action_sequence.extend([3] * abs(direction_vector[0]))  # Move left\n      \n      if direction_vector[1] > 0:\n          action_sequence.extend([2] * abs(direction_vector[1]))  # Move down\n      elif direction_vector[1] < 0:\n          action_sequence.extend([0] * abs(direction_vector[1]))  # Move up\n      \n      return action_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Collect all possible primitives needed for the goal item\n  goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n  \n  action_sequence = []\n  \n  # Preprocess: Move to and collect any available primitives in the initial inventory that can contribute to making the goal item\n  for primitive_index, required_count in goal_primitives.items():\n      if initial_state.inventory[primitive_index] >= required_count:\n          continue  # Skip if already satisfied\n  \n      closest_position = get_closest_item_position(initial_state, primitive_index)\n      if closest_position:\n          action_sequence.extend(move_to_position(initial_state, closest_position))\n          # Simulate moving to the position and collecting the item\n          for _ in range(len(action_sequence)):\n              reward, initial_state = initial_state.step(action_sequence[-1])\n  \n  # Perform BFS search to craft the goal item\n  final_action_sequence = bfs_search(initial_state, goal_item)\n  \n  if final_action_sequence:\n      action_sequence.extend(final_action_sequence)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 0.0}}
