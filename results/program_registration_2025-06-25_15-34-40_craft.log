{"timestamp": "2025-06-26T22:06:31.728967", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Try to make primitives that are needed\n          for primitive, count in goal_primitives.items():\n              if current_state.inventory[primitive] < count:\n                  new_action_seq = bfs_search_recursive(current_state, primitive)\n                  if new_action_seq is not None:\n                      action_sequence.extend(new_action_seq)\n\n          action_sequence = []\n          # Explore all actions to find a path to make the goal item\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_use = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_use = False\n                          break\n                  \n                  if not can_use:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def bfs_search_recursive(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          action_sequence = []\n\n          # Try to make primitives that are needed\n          for primitive, count in goal_primitives.items():\n              if current_state.inventory[primitive] < count:\n                  for action in range(initial_state.world.n_actions):\n                      reward, new_state = current_state.step(action)\n                      \n                      if action == 4:  # USE action\n                          # Check if the use action can contribute to making the goal item\n                          can_use = True\n                          for primitive, count in goal_primitives.items():\n                              if new_state.inventory[primitive] < count:\n                                  can_use = False\n                                  break\n                          \n                          if can_use and satisfies_goal(new_state, goal_item):\n                              return path + [action]\n                      \n                      # Convert the new state to a hashable form using a tuple of its attributes\n                      state_hash = (tuple(new_state.grid.flatten()), \n                                    tuple(new_state.inventory), \n                                    new_state.pos, \n                                    new_state.dir)\n                      \n                      if state_hash not in visited:\n                          visited.add(state_hash)\n                          queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = []\n\n  # Check if the goal item can be crafted (i.e., it's in the cookbook)\n  if goal_item not in initial_state.world.cookbook.recipes and goal_item not in initial_state.world.cookbook.primitives:\n      return []  # Return empty list if the goal item is uncraftable\n\n  while not satisfies_goal(initial_state, goal_item):\n      new_action_seq = bfs_search(initial_state, goal_item)\n      if new_action_seq is None:\n          break\n      action_sequence.extend(new_action_seq)\n      for action in new_action_seq:\n          reward, done, observations = env.step(action)\n          initial_state = env._current_state\n          if done:\n              break\n\n  return action_sequence if satisfies_goal(initial_state, goal_item) else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-26T22:06:32.720279", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Create a copy of the current state to explore actions without modifying the original state\n          def try_make_primitive(state, primitive):\n              temp_path = []\n              queue = deque([(state, [])])\n              visited_temp = set()\n              \n              while queue:\n                  curr_state, curr_path = queue.popleft()\n                  \n                  if curr_state.inventory[primitive] > 0:\n                      return curr_path\n                  \n                  for action in range(curr_state.world.n_actions):\n                      reward, new_state = curr_state.step(action)\n                      \n                      # Convert the new state to a hashable form using a tuple of its attributes\n                      state_hash = (tuple(new_state.grid.flatten()), \n                                    tuple(new_state.inventory), \n                                    new_state.pos, \n                                    new_state.dir)\n                      \n                      if action == 4:  # USE action\n                          can_use = True\n                          for p in goal_primitives:\n                              if new_state.inventory[p] < goal_primitives[p]:\n                                  can_use = False\n                                  break\n                          \n                          if not can_use:\n                              continue  # Skip this action as it doesn't help make the goal item\n                      \n                      if state_hash not in visited_temp:\n                          visited_temp.add(state_hash)\n                          queue.append((new_state, curr_path + [action]))\n              \n              return None  # Return None if no sequence is found to make the primitive\n      \n          # Try to make all primitives that are needed\n          for primitive, count in goal_primitives.items():\n              if current_state.inventory[primitive] < count:\n                  new_action_seq = try_make_primitive(current_state.copy(), primitive)\n                  if new_action_seq is not None:\n                      path.extend(new_action_seq)\n                      current_state = env._current_state  # Update the state after making primitives\n          \n          # If we have made all primitives, try to make the goal item\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_use = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_use = False\n                          break\n                  \n                  if can_use and satisfies_goal(new_state, goal_item):\n                      path.append(action)\n                      return path\n      \n          # If we can't make the goal directly, explore other actions\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_use = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_use = False\n                          break\n                  \n                  if not can_use:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state.copy()\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n      execute_actions(env, action_sequence)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-26T22:09:34.443999", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbor_states(current_state):\n      neighbor_states = []\n      \n      for action in range(env.world.n_actions):  # Assuming actions are enumerated from 0 to n_actions-1\n          reward, new_state = current_state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          neighbor_states.append((new_state, action, state_hash))\n      \n      return neighbor_states\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          neighbor_states = get_neighbor_states(current_state)\n          \n          for new_state, action, state_hash in neighbor_states:\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T22:09:35.515659", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbor_states(current_state):\n      neighbor_states = []\n      \n      for action in range(env.world.n_actions):  # Assuming actions are enumerated from 0 to n_actions-1\n          reward, new_state = current_state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          neighbor_states.append((new_state, action, state_hash))\n      \n      return neighbor_states\n\n  def heuristic(state):\n      \"\"\"Estimate the cost to reach the goal based on missing primitives.\"\"\"\n      primitives_required = env.world.cookbook.primitives_for(goal_item)\n      available_primitives = {idx: state.inventory[idx] for idx in env.world.grabbable_indices}\n      missing_count = sum(max(0, count - available_primitives.get(idx, 0)) for idx, count in primitives_required.items())\n      \n      return missing_count\n\n  def astar_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0 + heuristic(initial_state), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          for new_state, action, state_hash in get_neighbor_states(current_state):\n              tentative_g_score = g_score[current_state] + 1\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state)\n                  open_set.put((f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n      while current_state in came_from:\n          (prev_state, action) = came_from[current_state]\n          path.append(action)\n          current_state = prev_state\n      return path[::-1]  # Reverse the path to start from initial state\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Check if the goal item can be crafted based on available primitives and environment items\n  primitives_required = env.world.cookbook.primitives_for(goal_item)\n  available_primitives = {idx: initial_state.inventory[idx] for idx in env.world.grabbable_indices}\n  \n  if not all(primitive in available_primitives or primitive in env.world.environment for primitive in primitives_required):\n      raise ValueError(\"Goal item cannot be crafted with the available items and environment.\")\n  \n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-26T22:13:06.748001", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              possible_actions.append((new_state, action))\n          \n          # Prioritize actions that use resources needed for the goal\n          sorted_possible_actions = sorted(\n              possible_actions,\n              key=lambda x: -sum(new_state.inventory[primitive] > 0 for primitive in goal_primitives)\n          )\n          \n          # Add new states to queue with prioritized actions\n          for new_state, action in sorted_possible_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.appendleft((new_state, path + [action]))  # Use appendleft to prioritize this path\n          \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
