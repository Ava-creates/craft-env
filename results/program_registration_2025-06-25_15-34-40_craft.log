else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T09:31:03.212891", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Limit the number of steps to prevent infinite loops\n      if len(path) >= max_steps:\n          continue\n      \n      for action in range(env.world.n_actions):\n          reward, new_state = current_state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          if state_hash not in visited:\n              visited.add(state_hash)\n              queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def collect_primitives(env, initial_state, goal_item):\n      cookbook = env.world.cookbook\n      primitives_needed = cookbook.primitives_for(goal_item)\n      \n      collected_actions = []\n      current_state = initial_state\n      \n      for primitive in primitives_needed:\n          primitive_index = next(iter(primitives_needed))\n          \n          # Collect the primitive\n          collect_action_sequence = bfs_search(current_state, primitive_index)\n          if collect_action_sequence:\n              collected_actions.extend(collect_action_sequence)\n              \n              # Apply actions to reach the primitive\n              new_state = current_state\n              for action in collect_action_sequence:\n                  _, new_state = new_state.step(action)\n              \n              current_state = new_state\n      \n      return collected_actions, current_state\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # First attempt to find a direct path to the goal item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(\"Direct path not found. Attempting alternative strategies.\")\n    \n    # Collect necessary primitives first\n    collected_actions, new_state = collect_primitives(env, initial_state, goal_item)\n    \n    if collected_actions:\n        # After collecting primitives, try again to find a path to the goal item\n        action_sequence_after_collection = bfs_search(new_state, goal_item)\n        \n        if action_sequence_after_collection:\n            return collected_actions + action_sequence_after_collection\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T09:31:18.841690", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Limit the number of steps to prevent infinite loops\n      if len(path) >= max_steps:\n          continue\n      \n      for action in range(env.world.n_actions):\n          reward, new_state = current_state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          if state_hash not in visited:\n              visited.add(state_hash)\n              queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # First attempt to find a direct path\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(\"Direct path not found. Attempting alternative strategies.\")\n    \n    # Strategy: Collect primitives needed for the goal item\n    cookbook = env.world.cookbook\n    primitives_needed = cookbook.primitives_for(goal_item)\n    \n    print(f\"Primitives needed for {env.world.cookbook.index.get(goal_item)}: {primitives_needed}\")\n    \n    current_state = initial_state\n    \n    for primitive, count in primitives_needed.items():\n      print(f\"Collecting {count} of {env.world.cookbook.index.get(primitive)}\")\n      \n      # Collect the required amount of each primitive\n      collected_count = 0\n      \n      while collected_count < count:\n        action_sequence_to_primitive = bfs_search(current_state, primitive)\n        \n        if not action_sequence_to_primitive:\n          print(f\"Could not find a path to collect {env.world.cookbook.index.get(primitive)}\")\n          break\n        \n        for action in action_sequence_to_primitive:\n            reward, current_state = current_state.step(action)\n        \n        collected_count += 1\n        action_sequence.extend(action_sequence_to_primitive)\n        print(f\"Collected {collected_count}/{count} of {env.world.cookbook.index.get(primitive)}\")\n    \n    # After collecting all primitives, try to craft the goal item again\n    print(\"Primitives collected. Attempting to craft goal item.\")\n    action_sequence_to_goal = bfs_search(current_state, goal_item)\n    \n    if action_sequence_to_goal:\n      action_sequence.extend(action_sequence_to_goal)\n    else:\n      print(f\"Could not find a path to craft {env.world.cookbook.index.get(goal_item)}\")\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T09:33:47.742635", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def heuristic(pos1, pos2):\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def get_neighbors(pos, width, height):\n    x, y = pos\n    neighbors = []\n    if x > 0: \n        neighbors.append((x - 1, y))\n    if x < width - 1: \n        neighbors.append((x + 1, y))\n    if y > 0: \n        neighbors.append((x, y - 1))\n    if y < height - 1: \n        neighbors.append((x, y + 1))\n    return neighbors\n\n  def a_star_search(start_pos, goal_pos, initial_state):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, start_pos, []))\n      came_from = {}\n      g_score = {start_pos: 0}\n      f_score = {start_pos: heuristic(start_pos, goal_pos)}\n      \n      while open_set:\n          _, current_pos, path = heappop(open_set)\n          \n          if current_pos == goal_pos:\n              return path\n          \n          for neighbor in get_neighbors(current_pos, width, height):\n              tentative_g_score = g_score[current_pos] + 1\n              \n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = (current_pos, path)\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_pos)\n                  heappush(open_set, (f_score[neighbor], neighbor, path + [neighbor]))\n          \n      return None\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        # Prioritize actions that might lead to the goal item more directly\n        prioritized_actions = prioritize_actions(current_state, goal_item)\n        for action in prioritized_actions + [a for a in range(env.world.n_actions) if a not in prioritized_actions]:\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def prioritize_actions(current_state, goal_item):\n      \"\"\"Prioritize actions that might lead to the goal item more directly.\"\"\"\n      prioritized_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = current_state.step(action)\n          \n          # Check if any of the neighboring cells contain ingredients needed for the goal item\n          primitives_needed = env.world.cookbook.primitives_for(goal_item)\n          for primitive_idx, count in primitives_needed.items():\n              if current_state.next_to(primitive_idx):\n                  prioritized_actions.append(action)\n      \n      return list(set(prioritized_actions))  # Remove duplicates\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # First, try BFS to find a direct path to craft the item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n    # If BFS doesn't find a solution, try to move closer to the nearest resource needed for the goal.\n    initial_grid = initial_state.grid\n    width, height, _ = initial_grid.shape\n    \n    # Find positions of resources needed for the goal in the grid\n    required_resources = env.world.cookbook.primitives_for(goal_item).keys()\n    resource_positions = [(x, y) \n                          for x in range(width) \n                          for y in range(height) \n                          if any(initial_grid[x, y, res] > 0 for res in required_resources)]\n    \n    if not resource_positions:\n        return []  # No resources found to move towards\n    \n    closest_resource = min(resource_positions, key=lambda pos: heuristic(pos, initial_state.pos))\n    \n    # Perform A* search to move closer to the closest resource\n    resource_path = a_star_search(initial_state.pos, closest_resource, initial_state)\n    \n    if not resource_path:\n        return []  # No path found to the resource\n    \n    action_sequence = []\n    current_pos = initial_state.pos\n    direction_mapping = {0: (0, -1), 1: (0, 1), 2: (-1, 0), 3: (1, 0)}\n    \n    for next_pos in resource_path:\n        dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n        \n        # Determine the direction to move\n        if dx == 1:\n            action_sequence.append(3)  # RIGHT\n        elif dx == -1:\n            action_sequence.append(2)  # LEFT\n        elif dy == 1:\n            action_sequence.append(1)  # DOWN\n        elif dy == -1:\n            action_sequence.append(0)  # UP\n        \n        current_pos = next_pos\n    \n    return action_sequence\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 1.5}}
