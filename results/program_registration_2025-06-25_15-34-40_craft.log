oal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Prioritize actions that move towards collecting primitives\n              prioritize_move_towards_primitives(new_state, path + [action], goal_primitives)\n\n          # Sort the queue to prioritize states with more collected primitives\n          queue = deque(sorted(queue, key=lambda x: len([i for i in get_primitive_counts(x[0].world.cookbook.index.get(i_kind), x[0].world.cookbook) if x[0].inventory[i] > 0]), reverse=True))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_move_towards_primitives(state, path, goal_primitives):\n      from collections import deque\n      \n      queue = deque([(state, path)])\n      visited = set()\n      \n      while queue:\n          current_state, current_path = queue.popleft()\n          \n          # Check if the current state has collected all required primitives\n          all_collected = True\n          for primitive, count in goal_primitives.items():\n              if current_state.inventory[primitive] < count:\n                  all_collected = False\n                  break\n          \n          if all_collected:\n              return current_path  # Return the path if all primitives are collected\n\n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(current_state.grid.flatten()), \n                        tuple(current_state.inventory), \n                        current_state.pos, \n                        current_state.dir)\n          \n          if state_hash not in visited:\n              visited.add(state_hash)\n              \n              for action in range(initial_state.world.n_actions):\n                  reward, new_state = current_state.step(action)\n\n                  # Prioritize actions that move towards collecting primitives\n                  if action != 4:  # Non-USE actions (movement)\n                      queue.append((new_state, current_path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-06-27T13:44:02.963474", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def get_all_reachable_states(current_state, depth_limit):\n      from collections import deque\n      \n      queue = deque([(current_state, [])])\n      visited = set()\n      reachable_states = []\n\n      while queue:\n          current_state, path = queue.popleft()\n          \n          # Convert the state to a hashable form\n          state_hash = (tuple(current_state.grid.flatten()), \n                        tuple(current_state.inventory), \n                        current_state.pos, \n                        current_state.dir)\n          \n          if state_hash in visited or len(path) > depth_limit:\n              continue\n          \n          reachable_states.append((current_state, path))\n          visited.add(state_hash)\n\n          # Generate next states by applying all possible actions\n          for action in range(current_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              queue.append((new_state, path + [action]))\n\n      return reachable_states\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          reachable_states = get_all_reachable_states(current_state, depth_limit=3)\n          \n          for new_state, action_path in reachable_states:\n              if action_path[-1] == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + action_path))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-27T13:44:13.403813", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from current_state to reach the goal_item.\"\"\"\n      primitives_needed = get_primitive_counts(goal_item, state.world.cookbook)\n      current_primitives = {i: count for i, count in enumerate(state.inventory) if count > 0 and i in primitives_needed}\n\n      steps_needed = 0\n      for primitive, required_count in primitives_needed.items():\n          available_count = current_primitives.get(primitive, 0)\n          steps_needed += max(0, (required_count - available_count) // primitives_needed[primitive])\n      \n      return steps_needed\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import itertools\n      \n      open_set = []\n      open_heap_counter = itertools.count()  # Unique sequence count for heap stability\n      heappush(open_set, (heuristic(initial_state, goal_item), next(open_heap_counter), initial_state, []))\n      \n      visited = set()\n      \n      while open_set:\n          _, _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n\n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heappush(open_set, (\n                      len(path) + heuristic(new_state, goal_item),\n                      next(open_heap_counter),\n                      new_state,\n                      path + [action]\n                  ))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T13:45:53.888574", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def get_closest_resource(state, resource_indices):\n      \"\"\"Find the closest resource of any given type using BFS.\"\"\"\n      from collections import deque\n      \n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      queue = deque([(state.pos, [])])\n      visited = set([state.pos])\n\n      while queue:\n          current_pos, path = queue.popleft()\n\n          if any(state.grid[current_pos[0], current_pos[1], resource_index] > 0 for resource_index in resource_indices):\n              return path\n\n          for d in directions:\n              new_pos = (current_pos[0] + d[0], current_pos[1] + d[1])\n\n              if (0 <= new_pos[0] < state.grid.shape[0] and \n                  0 <= new_pos[1] < state.grid.shape[1] and \n                  new_pos not in visited):\n                  visited.add(new_pos)\n                  move = move_towards(state.pos, new_pos)\n                  queue.append((new_pos, path + [move]))\n\n      return None\n\n  def move_towards(current_pos, target_pos) -> int:\n      \"\"\"Determine the action to move towards the target position.\"\"\"\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          return 2 if dx < 0 else 3\n      else:\n          return 0 if dy < 0 else 1\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def execute_actions(env, actions):\n      for action in actions:\n          env.step(action)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available in inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n  \n  if not action_sequence:\n      return []  # Return empty list if no actions found\n\n  execute_actions(env, action_sequence)\n  return action_sequence", "island_id": 4, "scores": {"3": 2.0}}
