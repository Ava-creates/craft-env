ctions.append((action, 'use'))\n              else:\n                  possible_actions.append((action, 'move'))\n          \n          # Prioritize USE actions over MOVE actions\n          prioritized_actions = [action for action, _ in sorted(possible_actions, key=lambda x: ('move', 'use').index(x[1]))]\n          \n          for action in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T00:58:47.763044", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already in inventory\n  if satisfies_goal(initial_state, goal_item):\n      print(f\"Item {goal_item} is already in your inventory.\")\n      return []\n\n  # Validate that the goal item has a recipe or is a primitive\n  if goal_item not in env.world.cookbook.primitives and goal_item not in env.world.cookbook.recipes:\n      print(f\"Item {goal_item} does not have a recipe or is not a primitive.\")\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  # If no sequence is found, try to craft the item's ingredients recursively\n  if action_sequence is None:\n      print(f\"No direct way to craft item {goal_item}. Trying to craft its ingredients...\")\n      \n      # Get the recipe for the goal item\n      recipe = env.world.cookbook.recipes.get(goal_item)\n      if not recipe:\n          print(f\"Recipe not found for item {goal_item}.\")\n          return []\n      \n      all_actions = []\n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              continue  # Skip the key (if any)\n          \n          # Recursively craft the ingredient\n          actions = craft_v2(env, ingredient)\n          if not actions:\n              print(f\"Could not find a way to obtain ingredient {ingredient} for item {goal_item}.\")\n              return []\n          \n          all_actions.extend(actions)\n      \n      # Retry crafting the goal item after obtaining ingredients\n      action_sequence = bfs_search(initial_state, goal_item)\n      if action_sequence is None:\n          print(f\"Still could not craft item {goal_item} even after obtaining its ingredients.\")\n          return []\n\n  return action_sequence", "island_id": 8, "scores": {}}
{"timestamp": "2025-06-27T00:59:07.464560", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_prerequisites(item):\n      \"\"\"Get all prerequisites for crafting an item recursively.\"\"\"\n      if item in env.world.cookbook.primitives:\n          return {item}\n      \n      prerequisites = set()\n      if item in env.world.cookbook.recipes:\n          recipe = env.world.cookbook.recipes[item]\n          for ingredient, count in recipe.items():\n              if ingredient != \"_key\":\n                  prerequisites.update(get_prerequisites(ingredient))\n      return prerequisites\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Get all prerequisites for the goal item\n  prerequisites = get_prerequisites(goal_item)\n  \n  action_sequences = []\n  \n  for prerequisite in prerequisites:\n      if not satisfies_goal(initial_state, prerequisite):\n          path = bfs_search(initial_state, prerequisite)\n          if path:\n              action_sequences.extend(path)\n          else:\n              print(f\"Cannot craft prerequisite {prerequisite} for item {goal_item}.\")\n              return []\n\n  # Finally, craft the goal item\n  if not satisfies_goal(initial_state, goal_item):\n      final_path = bfs_search(initial_state, goal_item)\n      if final_path:\n          action_sequences.extend(final_path)\n      else:\n          print(f\"Cannot craft goal item {goal_item} after crafting prerequisites.\")\n          return []\n\n  return action_sequences", "island_id": 8, "scores": {"3": 0.2}}
{"timestamp": "2025-06-27T01:01:05.682392", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def get_next_to_counts(state, goal_primitives):\n      next_to_counts = {primitive: 0 for primitive in goal_primitives}\n      x, y = state.pos\n      directions = [(0, -1), (1, 0), (0, 1), (-1, 0)]\n\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n              cell_contents = np.where(state.grid[nx, ny])[0]\n              for content in cell_contents:\n                  if content in next_to_counts:\n                      next_to_counts[content] += 1\n      return next_to_counts\n\n  def heuristic(state, goal_item):\n      # Calculate the number of primitives needed that are already available\n      goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n      available_primitives = {primitive: min(state.inventory[primitive], count) for primitive, count in goal_primitives.items()}\n      return sum(available_primitives.values()) / len(goal_primitives)\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      from collections import defaultdict\n\n      priority_queue = []\n      heappush(priority_queue, (-heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      \n      while priority_queue:\n          _, current_state, path = heappop(priority_queue)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = all(new_state.inventory[primitive] >= count for primitive, count in goal_primitives.items())\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  possible_actions.append((new_state, action))\n          \n          # Prioritize actions that use resources needed for the goal or move towards them\n          next_to_counts = get_next_to_counts(current_state, goal_primitives)\n          sorted_possible_actions = sorted(\n              possible_actions,\n              key=lambda x: (\n                  -sum(x[0].inventory[primitive] > 0 for primitive in goal_primitives),\n                  sum(next_to_counts[primitive] for primitive in goal_primitives if x[0].next_to(primitive))\n              )\n          )\n\n          for new_state, action in sorted_possible_actions:\n              heappush(priority_queue, (-heuristic(new_state, goal_item), new_state, path + [action]))\n\n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-27T01:01:17.963631", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def get_next_to_counts(state, goal_primitives):\n      next_to_counts = {primitive: 0 for primitive in goal_primitives}\n      x, y = state.pos\n      directions = [(0, -1), (1, 0), (0, 1), (-1, 0)]\n\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n              cell_contents = np.where(state.grid[nx, ny])[0]\n              for content in cell_contents:\n                  if content in next_to_counts:\n                      next_to_counts[content] += 1\n      return next_to_counts\n\n  def get_pickup_actions(state):\n      x, y = state.pos\n      actions = []\n      directions = [(0, -1), (1, 0), (0, 1), (-1, 0)]\n      \n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n              cell_contents = np.where(state.grid[nx, ny])[0]\n              for content in cell_contents:\n                  actions.append((content, (dx, dy)))\n      return actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          possible_actions = []\n          \n          # Consider pickup actions first\n          pickup_actions = get_pickup_actions(current_state)\n          for content, (dx, dy) in pickup_actions:\n              if dx == 0 and dy == -1: action = 2  # LEFT\n              elif dx == 1 and dy == 0: action = 3  # DOWN\n              elif dx == 0 and dy == 1: action = 4  # RIGHT\n              elif dx == -1 and dy == 0: action = 1  # UP\n\n              reward, new_state = current_state.step(action)\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  possible_actions.append((new_state, action))\n          \n          # Consider movement actions\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = all(new_state.inventory[primitive] >= count for primitive, count in goal_primitives.items())\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  possible_actions.append((new_state, action))\n          \n          # Prioritize actions that use resources needed for the goal or move towards them\n          next_to_counts = get_next_to_counts(current_state, goal_primitives)\n          sorted_possible_actions = sorted(\n              possible_actions,\n              key=lambda x: (\n                  -sum(x[0].inventory[primitive] > 0 for primitive in goal_primitives),\n                  sum(next_to_counts[primitive] for primitive in goal_primitives if x[0].next_to(primitive))\n              )\n          )\n          \n          queue.extend((new_state, path + [action]) for new_state, action in sorted_possible_actions)\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-27T01:03:14.106893", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter and prioritize actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      possible_actions.append((action, 'use'))\n              else:\n                  possible_actions.append((action, 'move'))\n          \n          # Prioritize USE actions over MOVE actions\n          prioritized_actions = [action for action, _ in sorted(possible_actions, key=lambda x: ('move', 'use').index(x[1]))]\n          \n          for action in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(current_state, goal_item, cookbook):\n      \"\"\"Estimate the cost to reach the goal based on remaining primitives.\"\"\"\n      current_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      for primitive in current_primitives:\n          count_needed = current_primitives[primitive]\n          if count_needed <= current_state.inventory[primitive]:\n              current_primitives[primitive] = 0\n          \n      return sum(current_primitives.values())\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item, initial_state.world.cookbook), initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter and prioritize actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      possible_actions.append((action, 'use'))\n              else:\n                  possible_actions.append((action, 'move'))\n          \n          # Prioritize USE actions over MOVE actions\n          prioritized_actions = [action for action, _ in sorted(possible_actions, key=lambda x: ('move', 'use').index(x[1]))]\n          \n          for action in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heappush(open_set, (len(path) + 1 + heuristic(new_state, goal_item, initial_state.world.cookbook), new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
