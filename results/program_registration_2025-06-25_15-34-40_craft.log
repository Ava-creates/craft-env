rn 0\n\n  def astar_search(initial_state, goal_item, max_steps=500):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))  # Priority queue with (f_score, state, path)\n      \n      g_scores = {hash((tuple(initial_state.grid.flatten()), \n                         tuple(initial_state.inventory), \n                         initial_state.pos, \n                         initial_state.dir)): 0}\n      \n      f_scores = {hash((tuple(initial_state.grid.flatten()), \n                         tuple(initial_state.inventory), \n                         initial_state.pos, \n                         initial_state.dir)): heuristic(initial_state, goal_item)}\n      \n      came_from = {}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum number of steps\n          if len(path) >= max_steps:\n              continue\n          \n          neighbor_states = get_neighbor_states(current_state)\n          \n          for new_state, action, state_hash in neighbor_states:\n              tentative_g_score = g_scores[hash((tuple(initial_state.grid.flatten()), \n                                                tuple(initial_state.inventory), \n                                                initial_state.pos, \n                                                initial_state.dir))] + 1\n              \n              if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n                  came_from[state_hash] = (current_state, action)\n                  g_scores[state_hash] = tentative_g_score\n                  f_scores[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_scores[state_hash], new_state, path + [action]))\n      \n      return None  # Return Non