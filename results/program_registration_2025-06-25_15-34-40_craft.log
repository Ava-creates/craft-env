{"timestamp": "2025-06-26T14:04:57.046908", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item, heuristic=None):\n      import heapq\n      \n      if heuristic is None:\n          heuristic = lambda _, __: 0  # Default to zero heuristic (uniform cost search)\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming uniform cost per action\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[new_state] = (current_state, path + [action])\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic_manhattan(state, goal_item):\n      # Simple heuristic that estimates the number of steps to collect all primitives needed for the goal\n      cookbook = env.world.cookbook\n      primitive_counts = cookbook.primitives_for(goal_item)\n      \n      total_steps = 0\n      \n      for prim_index, count in primitive_counts.items():\n          if state.inventory[prim_index] < count:\n              # Find nearest primitive on the grid\n              distances = []\n              for x in range(env.world.WIDTH):\n                  for y in range(env.world.HEIGHT):\n                      if state.grid[x, y, prim_index] > 0:\n                          distance = abs(x - state.pos[0]) + abs(y - state.pos[1])\n                          distances.append(distance)\n              \n              if distances:\n                  total_steps += min(distances) * (count - state.inventory[prim_index])\n      \n      return total_steps\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item, heuristic=heuristic_manhattan)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
