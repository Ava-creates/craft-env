{"timestamp": "2025-06-27T07:33:30.636763", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_primitives):\n      # Heuristic based on the number of primitives already available\n      satisfied_count = sum(\n          state.inventory[primitive] >= count \n          for primitive, count in goal_primitives.items()\n      )\n      return -satisfied_count  # Negative to sort descending\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-27T07:33:31.801382", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      possible_actions.append((action, 'use'))\n              else:\n                  possible_actions.append((action, 'move'))\n          \n          # Prioritize USE actions over MOVE actions based on how many primitives are satisfied\n          def prioritize_action(action_tuple):\n              action, _ = action_tuple\n              reward, new_state = current_state.step(action)\n              if action == 4:  # Only consider USE actions for prioritization\n                  primitives_satisfied = sum(\n                      new_state.inventory[primitive] >= count \n                      for primitive, count in goal_primitives.items()\n                  )\n                  return (-primitives_satisfied,)  # Negative to sort descending\n              return (0,)  # Move actions have priority 0\n      \n          prioritized_actions = [action for action, _ in sorted(possible_actions, key=prioritize_action)]\n          \n          for action in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_initial_actions(initial_state):\n      actions = []\n      for action in range(initial_state.world.n_actions):\n          reward, new_state = initial_state.step(action)\n          \n          if action == 4:  # USE action\n              continue  # Skip USE actions initially as they require specific conditions to be met.\n          \n          actions.append((action, new_state))\n      \n      return actions\n\n  def find_closest_primitive(primitives, current_state):\n      distances = []\n      for primitive in primitives:\n          # Find the closest position of the primitive on the grid\n          positions = np.argwhere(current_state.grid == primitive)\n          if len(positions) > 0:\n              closest_position = min(\n                  positions,\n                  key=lambda pos: abs(pos[0] - current_state.pos[0]) + abs(pos[1] - current_state.pos[1])\n              )\n              distance = abs(closest_position[0] - current_state.pos[0]) + abs(closest_position[1] - current_state.pos[1])\n              distances.append((primitive, distance))\n      \n      if distances:\n          return min(distances, key=lambda x: x[1])[0]\n      else:\n          return None\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  # Collect all primitives needed for the goal item\n  goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n  \n  # Initialize a list to store actions\n  action_sequence = []\n  \n  while not satisfies_goal(initial_state, goal_item):\n      # Find the closest primitive that is needed and hasn't been collected yet\n      closest_primitive = find_closest_primitive(\n          [p for p in goal_primitives if initial_state.inventory[p] < goal_primitives[p]],\n          initial_state\n      )\n      \n      if closest_primitive is None:\n          # If no primitives are left to collect, break the loop (this should not happen ideally)\n          break\n      \n      # Perform BFS to find a path to the closest primitive\n      path_to_primitive = bfs_search(initial_state, closest_primitive)\n      \n      if path_to_primitive:\n          action_sequence.extend(path_to_primitive)\n          initial_state = env._current_state  # Update state after performing actions\n          \n          # Collect the primitive by using the USE action\n          use_action = [action for action in range(env.world.n_actions) \n                        if initial_state.step(action)[1].inventory[closest_primitive] > initial_state.inventory[closest_primitive]]\n          if use_action:\n              action_sequence.append(use_action[0])\n              initial_state = env._current_state  # Update state after performing actions\n      else:\n          # If no path to the primitive is found, break the loop (this should not happen ideally)\n          break\n  \n  return action_sequence", "island_id": 0, "scores": {"3": 0.0}}
