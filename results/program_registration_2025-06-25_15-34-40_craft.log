{"timestamp": "2025-06-27T15:57:17.283774", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n\n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Sort actions by their likelihood to contribute to making the goal item\n      def action_score(action, state):\n        if action == 4:  # USE action\n          new_state, _ = state.step(action)\n          score = sum(new_state.inventory[primitive] - state.inventory[primitive] for primitive in goal_primitives)\n          return score\n        else:\n          # Move actions can be prioritized based on proximity to primitives\n          if action == 0:  # DOWN\n            new_pos = (state.pos[0], state.pos[1] + 1)\n          elif action == 1:  # UP\n            new_pos = (state.pos[0], state.pos[1] - 1)\n          elif action == 2:  # LEFT\n            new_pos = (state.pos[0] - 1, state.pos[1])\n          elif action == 3:  # RIGHT\n            new_pos = (state.pos[0] + 1, state.pos[1])\n          \n          score = sum(state.grid[new_pos[0], new_pos[1], primitive] for primitive in goal_primitives)\n          return score\n        return 0\n      \n      actions = [(action, action_score(action, current_state)) for action in range(initial_state.world.n_actions)]\n      # Prioritize actions that move towards making the goal item\n      actions.sort(key=lambda x: x[1], reverse=True)\n\n      for action, _ in actions:\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n          \n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-27T15:57:27.739045", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n\n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      valid_actions = []\n      for action in range(initial_state.world.n_actions):\n          reward, new_state = current_state.step(action)\n\n          if action == 4:  # USE action\n              can_make_goal = all(new_state.inventory[primitive] >= count for primitive, count in goal_primitives.items())\n              if not can_make_goal:\n                  continue\n\n          valid_actions.append((action, new_state))\n      \n      # Prioritize actions that move towards making the goal item\n      valid_actions.sort(key=lambda x: any(x[1].inventory[primitive] > current_state.inventory[primitive] for primitive in goal_primitives))\n\n      for action, new_state in valid_actions:\n          state_hash = 