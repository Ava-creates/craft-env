\n      raise ValueError(\"Goal item cannot be crafted with the available items and environment.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-27T02:01:55.308400", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Get all possible actions from the current state\n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              valid_actions.append((action, new_state))\n          \n          for action, new_state in valid_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = []\n  while not satisfies_goal(initial_state, goal_item) and len(action_sequence) < env.max_steps:\n      sub_action_sequence = bfs_search(initial_state, goal_item)\n      if sub_action_sequence is None:\n          break\n      \n      for action in sub_action_sequence:\n          reward, new_state = initial_state.step(action)\n          action_sequence.append(action)\n          initial_state = new_state\n          \n          # Check if the goal has been satisfied within the current sequence of actions\n          if satisfies_goal(new_state, goal_item):\n              return action_sequence\n  \n  return action_sequence if satisfies_goal(initial_state, goal_item) else []  # Return empty list if no valid sequence found", "island_id": 9, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T02:01:56.522139", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Get all possible actions from the current state\n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              valid_actions.append((action, new_state))\n          \n          for action, new_state in valid_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(current_state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from current_state to goal_item.\"\"\"\n      goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n      missing_primitives = {primitive: count - current_state.inventory[primitive] for primitive, count in goal_primitives.items() if count > current_state.inventory[primitive]}\n      return sum(missing_primitives.values())\n\n  initial_state = env._current_state\n  goal_item = item\n\n  # Use A* search with the heuristic function\n  from queue import PriorityQueue\n  \n  open_set = PriorityQueue()\n  open_set.put((0, initial_state, []))  # (f_score, state, path)\n  g_scores = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + (initial_state.pos[0], initial_state.pos[1], initial_state.dir): 0}\n  \n  while not open_set.empty():\n      _, current_state, path = open_set.get()\n      \n      if satisfies_goal(current_state, goal_item):\n          return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n      \n      # Get all possible actions from the current state\n      valid_actions = []\n      for action in range(initial_state.world.n_actions):\n          reward, new_state = current_state.step(action)\n          \n          if action == 4:  # USE action\n              # Check if the use action can contribute to making the goal item\n              can_make_goal = True\n              for primitive, count in goal_primitives.items():\n                  if new_state.inventory[primitive] < count:\n                      can_make_goal = False\n                      break\n              \n              if not can_make_goal:\n                  continue  # Skip this action as it doesn't help make the goal item\n          \n          valid_actions.append((action, new_state))\n      \n      for action, new_state in valid_actions:\n          state_hash = tuple(new_state.grid.flatten()) + tuple(new_state.inventory) + (new_state.pos[0], new_state.pos[1], new_state.dir)\n          tentative_g_score = g_scores.get(tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos[0], current_state.pos[1], current_state.dir), float('inf')) + 1\n          \n          if tentative_g_score < g_scores.get(state_hash, float('inf')):\n              g_scores[state_hash] = tentative_g_score\n              f_score = tentative_g_score + heuristic(new_state, goal_item)\n              open_set.put((f_score, new_state, path + [action]))\n  \n  return []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-27T02:03:04.548878", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          # Check if the state has changed\n          if (not np.array_equal(new_state.grid, state.grid) or\n              not np.array_equal(new_state.inventory, state.inventory) or\n              new_state.pos != state.pos or\n              new_state.dir != state.dir):\n              valid_actions.append((action, new_state))\n      return valid_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, new_state in get_valid_actions(current_state):\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Attempt to find a path to craft the goal item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-27T02:03:23.218834", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          _, new_state = state.step(action)\n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          valid_actions.append((action, state_hash, new_state))\n      return valid_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, state_hash, new_state in get_valid_actions(current_state):\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Attempt to find a path to craft the goal item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-27T02:05:59.093285", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum number of steps\n          if len(path) >= max_steps:\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def dfs_search(initial_state, goal_item, max_depth=50):\n      from collections import deque\n      \n      stack = [(initial_state, [])]\n      visited = set()\n      \n      while stack:\n          current_state, path = stack.pop()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum depth\n          if len(path) >= max_depth:\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  stack.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from the current state to the goal.\"\"\"\n      # Simple heuristic: count the number of primitives required but not available\n      primitives_required = env.world.cookbook.primitives_for(goal_item)\n      available_primitives = {idx: state.inventory[idx] for idx in env.world.grabbable_indices}\n      missing_primitives_count = sum(primitives_required.get(idx, 0) - available_primitives.get(idx, 0) for idx in primitives_required)\n      \n      return missing_primitives_count\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  cost = len(path) + 1 + heuristic(new_state, goal_item)\n                  heappush(open_set, (cost, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Check if the goal item can be crafted based on available primitives and environment items\n  primitives_required = env.world.cookbook.primitives_for(goal_item)\n  available_primitives = {idx: initial_state.inventory[idx] for idx in env.world.grabbable_indices}\n  \n  if not all(primitive in available_primitives or primitive in env.world.environment for primitive in primitives_required):\n      raise ValueError(\"Goal item cannot be crafted with the available items and environment.\")\n  \n  # Try A* search first, then BFS as a fallback\n  action_sequence = a_star_search(initial_state, goal_item)\n  if action_sequence is None:\n      action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-27T02:06:00.328594", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):  \n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= max_steps:\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None\n\n  def dfs_search(initial_state, goal_item, max_depth=50):  \n      from collections import deque\n      \n      stack = [(initial_state, [])]\n      visited = set()\n      \n      while stack:\n          current_state, path = stack.pop()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= max_depth:\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  stack.append((new_state, path + [action]))\n      \n      return None\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function based on the distance to the nearest resource needed for the goal item.\"\"\"\n      required_primitives = env.world.cookbook.primitives_for(goal_item)\n      min_distance = float('inf')\n      \n      # Find the nearest primitive or environment item needed for the goal\n      for idx in required_primitives:\n          if state.inventory[idx] > 0:  # Already have this primitive in inventory\n              continue\n          \n          for x in range(env.world.scenario.init_grid.shape[0]):\n              for y in range(env.world.scenario.init_grid.shape[1]):\n                  if env.world.scenario.init_grid[x, y, idx] > 0:\n                      distance = abs(x - state.pos[0]) + abs(y - state.pos[1])\n                      min_distance = min(min_distance, distance)\n      \n      return min_distance\n\n  def astar_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          current_f, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[current_state] + 1\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = current_state\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score[new_state], new_state, path + [action]))\n      \n      return None\n\n  def reconstruct_path(came_from, current_state, path):\n      while current_state in came_from:\n          current_state = came_from[current_state]\n          path.insert(0, action)\n      return path\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  primitives_required = env.world.cookbook.primitives_for(goal_item)\n  available_primitives = {idx: initial_state.inventory[idx] for idx in env.world.grabbable_indices}\n  \n  if not all(primitive in available_primitives or primitive in env.world.environment for primitive in primitives_required):\n      raise ValueError(\"Goal item cannot be crafted with the available items and environment.\")\n  \n  # Try A* search first, then BFS as a fallback\n  action_sequence = astar_search(initial_state, goal_item)\n  if action_sequence is None:\n      action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-27T02:08:20.667252", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic to estimate the number of steps needed to reach the goal.\"\"\"\n      primitives_needed = get_primitive_counts(goal_item, state.world.cookbook)\n      inventory_primitives = {i: cnt for i, cnt in enumerate(state.inventory) if i in primitives_needed}\n      \n      # Calculate the difference between needed and available primitives\n      diff = sum(max(primitives_needed[i] - inventory_primitives.get(i, 0), 0) for i in primitives_needed)\n      \n      return diff\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = [(heuristic(initial_state, goal_item), 0, initial_state, [])]\n      visited = set()\n      \n      while open_set:\n          _, cost_so_far, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      possible_actions.append((action, 'use'))\n              else:\n                  possible_actions.append((action, 'move'))\n          \n          # Prioritize USE actions over MOVE actions based on how many primitives are satisfied\n          def prioritize_action(action_tuple):\n              action, _ = action_tuple\n              reward, new_state = current_state.step(action)\n              if action == 4:  # Only consider USE actions for prioritization\n                  primitives_satisfied = sum(\n                      new_state.inventory[primitive] >= count \n                      for primitive, count in goal_primitives.items()\n                  )\n                  return (-primitives_satisfied,)  # Negative to sort descending\n              return (0,)  # Move actions have priority 0\n      \n          prioritized_actions = [action for action, _ in sorted(possible_actions, key=prioritize_action)]\n          \n          for action in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heappush(open_set, (heuristic(new_state, goal_item) + cost_so_far + 1, cost_so_far + 1, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-27T02:08:21.932499", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_item):\n      # Calculate the number of primitive ingredients still needed to make the goal item\n      required_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n      current_inventory = state.inventory\n      missing_count = sum(max(0, required - current) for required, current in zip(required_primitives.values(), current_inventory[list(required_primitives.keys())]))\n      return missing_count\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (heuristic(initial_state, goal_item), 0, initial_state, []))  # (f_score, g_score, state, path)\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_g_score, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      possible_actions.append((action, 'use'))\n              else:\n                  possible_actions.append((action, 'move'))\n          \n          # Prioritize USE actions over MOVE actions based on how many primitives are satisfied\n          def prioritize_action(action_tuple):\n              action, _ = action_tuple\n              reward, new_state = current_state.step(action)\n              if action == 4:  # Only consider USE actions for prioritization\n                  primitives_satisfied = sum(\n                      new_state.inventory[primitive] >= count \n                      for primitive, count in goal_primitives.items()\n                  )\n                  return (-primitives_satisfied,)  # Negative to sort descending\n              return (0,)  # Move actions have priority 0\n      \n          prioritized_actions = [action for action, _ in sorted(possible_actions, key=prioritize_action)]\n          \n          for action in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[current_state] + 1\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = current_state\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score[new_state], tentative_g_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-27T02:09:34.596092", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          if not np.array_equal(new_state.grid, state.grid) or \\\n             not np.array_equal(new_state.inventory, state.inventory) or \\\n             new_state.pos != state.pos or \\\n             new_state.dir != state.dir:\n              valid_actions.append((action, new_state))\n      return valid_actions\n\n  def heuristic(state, goal_item):\n      # Heuristic function to estimate the cost from current state to goal\n      # Here we use a simple heuristic based on the number of items needed in inventory\n      primitives_needed = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory\n      missing_items = sum(max(0, count - current_inventory[prim]) for prim, count in primitives_needed.items())\n      return missing_items\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue to store states with their priority (f-value)\n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      \n      # Set to track visited states\n      visited = set()\n      \n      while open_set:\n          f_value, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, new_state in get_valid_actions(current_state):\n              g_value = len(path) + 1  # Cost to reach this state from start (depth of the search tree)\n              h_value = heuristic(new_state, goal_item)  # Estimated cost from this state to goal\n              f_value = g_value + h_value  # Total estimated cost\n            \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n            \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heapq.heappush(open_set, (f_value, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-27T02:09:38.581348", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          # Check if the state has changed\n          if not np.array_equal(new_state.grid, state.grid) or \\\n             not np.array_equal(new_state.inventory, state.inventory) or \\\n             new_state.pos != state.pos or \\\n             new_state.dir != state.dir:\n              valid_actions.append((action, new_state))\n      return valid_actions\n\n  def dfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      stack = [(initial_state, [])]\n      visited = set()\n      \n      while stack:\n          current_state, path = stack.pop()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, new_state in get_valid_actions(current_state):\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  stack.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = dfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-27T02:11:49.271947", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = True\n                  # Check if the use action can contribute to making the goal item\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def execute_actions(env, actions):\n      for action in actions:\n          reward, done, observations = env.step(action)\n          if done:\n              break\n      return satisfies_goal(env._current_state, item)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item can be crafted (i.e., it's in the cookbook)\n  if goal_item not in initial_state.world.cookbook.recipes and goal_item not in initial_state.world.cookbook.primitives:\n      return []  # Return empty list if the goal item is uncraftable\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence is None:\n      return []\n\n  # Execute the actions to reach the goal state\n  success = execute_actions(env, action_sequence)\n  \n  if success:\n    print(f\"Successfully crafted item {item}.\")\n  else:\n    print(f\"Failed to craft item {item}.\")\n\n  return action_sequence", "island_id": 6, "scores": {"3": -1}}
