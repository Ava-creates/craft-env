tate.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T11:59:46.973358", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient != \"_key\":\n            dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n\n      if satisfies_goal(current_state, goal_item):\n        return path\n\n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n\n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n\n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n\n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n\n    return None  # Return None if no sequence is found\n\n  def get_reachable_items(state):\n      \"\"\"Determine which items can be crafted given the current inventory.\"\"\"\n      reachable = set()\n      \n      def dfs(current_index):\n          if current_index in state.world.cookbook.primitives:\n              if state.inventory[current_index] > 0:\n                  reachable.add(current_index)\n              return\n          \n          if current_index in state.world.cookbook.recipes:\n              recipe = state.world.cookbook.recipes[current_index]\n              can_craft = True\n              for ingredient, amount in recipe.items():\n                  if ingredient != \"_key\":\n                      if state.inventory[ingredient] < amount and ingredient not in reachable:\n                          can_craft = False\n                          break\n              \n              if can_craft:\n                  reachable.add(current_index)\n                  for ingredient in recipe.keys():\n                      if ingredient != \"_key\":\n                          dfs(ingredient)\n      \n      # Start DFS from all primitives\n      for primitive in state.world.cookbook.primitives:\n          dfs(primitive)\n      \n      return reachable\n\n  initial_state = env._current_state\n  goal_item = item\n\n  # Check if the goal item is already in reach\n  if satisfies_goal(initial_state, goal_item):\n    return []\n\n  reachable_items = get_reachable_items(initial_state)\n\n  if goal_item not in reachable_items:\n    raise ValueError(f\"Goal item {goal_item} cannot be crafted with the given inventory and environment.\")\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence is None:\n    raise RuntimeError(\"No valid sequence of actions found to craft the goal item.\")\n\n  return action_sequence", "island_id": 8, "scores": {"3": -1}}
