                  new_state.dir)\n                  \n                  if state_hash not in visited:\n                      visited.add(state_hash)\n                      stack.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      queue = []\n      heapq.heappush(queue, (0, initial_state, []))\n      visited = set()\n      \n      while queue:\n          _, current_state, path = heapq.heappop(queue)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Heuristic: Number of items needed to craft the goal (this is a placeholder heuristic)\n              heuristic_value = 0  # Placeholder; replace with actual heuristic if available\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heapq.heappush(queue, (heuristic_value + len(path) + 1, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(\"BFS search failed. Attempting DFS search...\")\n    \n    action_sequence = dfs_search(initial_state, goal_item)\n  \n  if not action_sequence:\n    print(\"DFS search failed. Attempting A* search...\")\n    \n    action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T15:28:10.003127", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_possible_actions(state):\n    possible_actions = []\n    for action in range(env.world.n_actions):\n      _, new_state = state.step(action)\n      if any(new_state.grid.flatten()) or any(new_state.inventory) or new_state.pos != state.pos:\n        possible_actions.append(action)\n    return possible_actions\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      possible_actions = get_possible_actions(current_state)\n      for action in possible_actions:\n        reward, new_state = current_state.step(action)\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def optimize_path(path):\n    \"\"\"Optimizes the given path by removing unnecessary movements.\"\"\"\n    optimized_path = []\n    i = 0\n    while i < len(path):\n      action = path[i]\n      \n      # Check for consecutive opposite moves and skip them\n      if (action == 0 and i + 1 < len(path) and path[i + 1] == 1) or \\\n         (action == 1 and i + 1 < len(path) and path[i + 1] == 0) or \\\n         (action == 2 and i + 1 < len(path) and path[i + 1] == 3) or \\\n         (action == 3 and i + 1 < len(path) and path[i + 1] == 2):\n        i += 2  # Skip both opposite moves\n      else:\n        optimized_path.append(action)\n        i += 1\n    \n    return optimized_path\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n    action_sequence = optimize_path(action_sequence)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T15:28:18.262348", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_possible_actions(state):\n      possible_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          # Check if the action changes the grid or inventory\n          if not np.array_equal(new_state.grid, state.grid) or not np.array_equal(new_state.inventory, state.inventory) or new_state.pos != state.pos:\n              possible_actions.append((action, new_state))\n      \n      return possible_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          possible_actions = get_possible_actions(current_state)\n          for action, new_state in possible_actions:\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_path(path):\n      \"\"\"Optimizes the given path by removing unnecessary movements.\"\"\"\n      optimized_path = []\n      for i in range(len(path)):\n          action = path[i]\n          if i < len(path) - 1:\n              next_action = path[i + 1]\n              \n              # Combine consecutive opposite moves\n              if (action == 0 and next_action == 1) or (action == 1 and next_action == 0):\n                  continue\n              elif (action == 2 and next_action == 3) or (action == 3 and next_action == 2):\n                  continue\n              \n          optimized_path.append(action)\n      return optimized_path\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n      action_sequence = optimize_path(action_sequence)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T15:29:28.455401", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize moving towards the goal item if available in the grid\n          move_actions = []\n          use_action = None\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if action == 4 and reward != 0.0:  # USE action that results in change\n                  use_action = (action, reward, new_state)\n              else:\n                  move_actions.append((action, reward, new_state))\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n          \n          # Prioritize the USE action if available\n          if use_action is not None:\n              queue.appendleft((use_action[2], path + [use_action[0]]))\n          \n          # Add move actions to the end of the queue\n          for _, _, state in sorted(move_actions, key=lambda x: -x[1]):\n              queue.append((state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
