if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:31:44.601134", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos, width, height):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < width - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < height - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          width, height = current_state.grid.shape[:2]\n          \n          # Explore movement actions first\n          for action in [0, 1, 2, 3]:  # DOWN, UP, LEFT, RIGHT\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n          \n          # Explore USE action after movement\n          reward, use_state = current_state.step(4)  # USE\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          use_state_hash = (tuple(use_state.grid.flatten()), \n                            tuple(use_state.inventory), \n                            use_state.pos, \n                            use_state.dir)\n          \n          if use_state_hash not in visited:\n              visited.add(use_state_hash)\n              queue.append((use_state, path + [4]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:32:01.053844", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos, width, height):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < width - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < height - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          width, height = current_state.grid.shape[:2]\n          \n          # Explore movement actions first\n          for action in [0, 1, 2, 3]:  # DOWN, UP, LEFT, RIGHT\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n          \n          # Explore USE action after movement\n          reward, use_state = current_state.step(4)  # USE\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          use_state_hash = (tuple(use_state.grid.flatten()), \n                            tuple(use_state.inventory), \n                            use_state.pos, \n                            use_state.dir)\n          \n          if use_state_hash not in visited:\n              visited.add(use_state_hash)\n              queue.append((use_state, path + [4]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:32:41.809678", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic based on the number of items in inventory\n      return -np.sum(current_state.inventory)\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (heuristic(initial_state, goal_item), 0, initial_state, []))\n      visited_states = set()\n      \n      while open_set:\n          _, cost, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate possible next states and actions\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited_states:\n                  visited_states.add(state_hash)\n                  heapq.heappush(open_set, (heuristic(new_state, goal_item) + cost + 1, cost + 1, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
