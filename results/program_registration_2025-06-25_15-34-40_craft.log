h[::-1])  # Reverse the path to go from primitives to goal\n  else:\n      actions = []\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:22:07.659141", "function_name": "craft", "function_body": "  def bfs_paths(starts, goals):\n    queue = [(start, []) for start in starts]\n    visited = set()\n    while queue:\n        (node, path) = queue.pop(0)\n        if node not in visited:\n            neighbors = get_neighbors(node)\n            for neighbor in neighbors:\n                new_path = path + [neighbor]\n                if neighbor in goals:\n                    return new_path\n                else:\n                    queue.append((neighbor, new_path))\n            visited.add(node)\n    return None\n\n  def get_neighbors(node):\n      \"\"\"Generate the list of nodes that can be directly reached from the current node.\"\"\"\n      neighbors = []\n      \n      # Get all recipes with `node` as an ingredient\n      for output, ingredients in env.world.cookbook.recipes.items():\n          if node in ingredients:\n              neighbors.append(output)\n              \n      return neighbors\n\n  def actions_to_reach_goal(path):\n      \"\"\"Generate the list of actions required to reach the goal from the path.\"\"\"\n      actions = []\n      \n      # For each step in the path, determine the action required\n      for i in range(len(path) - 1):\n          current_node = path[i]\n          next_node = path[i + 1]\n          \n          # Find recipe that produces `next_node` using `current_node`\n          for output, ingredients in env.world.cookbook.recipes.items():\n              if output == next_node and current_node in ingredients:\n                  actions.append(env.world.index.get(output))  # Assuming USE action to craft\n                  break\n      \n      return actions\n\n  def find_primitive_paths(item):\n    \"\"\"Finds all paths from primitives to the item.\"\"\"\n    goals = [item]\n    starts = list(env.world.cookbook.primitives)\n    path = bfs_paths(starts, goals)\n    \n    if path:\n        return [path[::-1]]  # Reverse the path to go from primitives to goal\n    else:\n        return []\n\n  def plan_actions(paths):\n      \"\"\"Generates actions for each path.\"\"\"\n      all_actions = []\n      \n      for path in paths:\n          actions = actions_to_reach_goal(path)\n          all_actions.append(actions)\n      \n      return all_actions\n\n  # Find all paths from primitives to the item\n  paths = find_primitive_paths(item)\n  \n  if paths:\n      actions_list = plan_actions(paths)\n  else:\n      actions_list = []\n  \n  # Return the first valid path's actions (for simplicity, could optimize further)\n  if actions_list:\n      return actions_list[0]\n  else:\n      return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T23:23:41.118225", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      \n      # Check USE action\n      reward, new_state = state.step(4)\n      if new_state != state:\n          valid_actions.append(4)\n      \n      # Check movement actions (DOWN, UP, LEFT, RIGHT)\n      for action in range(4):\n          reward, new_state = state.step(action)\n          if new_state != state:\n              valid_actions.append(action)\n      \n      return valid_actions\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from the current state to the goal.\"\"\"\n      # For simplicity, use the number of items in the inventory as a proxy for progress\n      # You can enhance this heuristic based on specific game mechanics or knowledge\n      return -state.inventory[goal_item]\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))  # (f_score, state, path)\n      g_scores = {initial_state: 0}\n      \n      while open_set:\n          current_f, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in get_valid_actions(current_state):\n              reward, new_state = current_state.step(action)\n              \n              if new_state == current_state:  # Skip invalid moves (e.g., moving into walls or using an empty inventory)\n                  continue\n              \n              tentative_g_score = g_scores[current_state] + 1\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if new_state not in g_scores or tentative_g_score < g_scores[new_state]:\n                  g_scores[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # If the item is already in the inventory, return an empty list of actions\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:23:42.177359", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      \n      # Check USE action\n      reward, new_state = state.step(4)\n      if new_state != state:\n          valid_actions.append(4)\n      \n      # Check movement actions (DOWN, UP, LEFT, RIGHT)\n      for action in range(4):\n          reward, new_state = state.step(action)\n          if new_state != state:\n              valid_actions.append(action)\n      \n      return valid_actions\n\n  def heuristic(state, goal_item):\n      \"\"\"Estimate the cost from the current state to the goal.\"\"\"\n      # A simple heuristic could be based on the distance to a known resource or workshop\n      # For simplicity, we'll use the number of items in the inventory as a heuristic\n      return sum(state.inventory) - state.inventory[goal_item]\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      \n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in get_valid_actions(current_state):\n              reward, new_state = current_state.step(action)\n              \n              if new_state == current_state:  # Skip invalid moves\n                  continue\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each action has a cost of 1\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # If the item is already in the inventory, return an empty list of actions\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:25:05.813616", "function_name": "craft", "function_body": "  def find_primitives(primitive_indices):\n    for index in primitive_indices:\n      if index not in env.world.grabbable_indices or env.world.cookbook.index.get(index) == \"water\":\n        continue\n      # Add code to find the closest instance of this primitive on the map and return actions to pick it up\n      yield from move_to_closest_item(env, index)\n      yield env_factory.PICKUP\n\n  def move_to_closest_item(env, item_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # Down, Right, Up, Left\n\n    def is_valid(x, y):\n        return 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]\n\n    queue = [(pos[0], pos[1], [])]\n    visited = set()\n    while queue:\n        x, y, path = queue.pop(0)\n        if (x, y) in visited:\n            continue\n        visited.add((x, y))\n        if grid[x, y, item_index] > 0:\n            return path\n        for dx, dy in directions:\n            nx, ny = x + dx, y + dy\n            if is_valid(nx, ny):\n                queue.append((nx, ny, path + [env_factory.MOVE_DOWN if dx == 0 and dy == 1 else env_factory.MOVE_RIGHT if dx == 1 and dy == 0 else env_factory.MOVE_UP if dx == 0 and dy == -1 else env_factory.MOVE_LEFT]))\n    return []\n\n  def use_workshop():\n      for workshop_index in env.world.workshop_indices:\n          if env._current_state.next_to(workshop_index):\n              yield env_factory.USE\n              return\n      yield from move_to_closest_item(env, env.world.water_index)  # Assuming water is the default workshop placeholder\n      yield env_factory.USE\n\n  goal_primitives = env.world.cookbook.primitives_for(item)\n  actions = []\n\n  for primitive, count in goal_primitives.items():\n    for _ in range(count):\n      actions.extend(find_primitives([primitive]))\n\n  if item not in env.world.grabbable_indices:\n    actions.extend(use_workshop())\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:25:06.795221", "function_name": "craft", "function_body": "  # Constants\n  DOWN, UP, LEFT, RIGHT, USE = range(5)\n  WIDTH, HEIGHT = env.world.grid.shape[0], env.world.grid.shape[1]\n  \n  # Initialize an empty path list\n  actions = []\n\n  def move_to(x, y):\n    \"\"\"Helper function to move the agent to a specific grid position.\"\"\"\n    current_x, current_y = env._current_state.pos\n    \n    while current_x < x:\n      actions.append(RIGHT)\n      current_x += 1\n    while current_x > x:\n      actions.append(LEFT)\n      current_x -= 1\n    while current_y < y:\n      actions.append(DOWN)\n      current_y += 1\n    while current_y > y:\n      actions.append(UP)\n      current_y -= 1\n\n  # Placeholder function to check inventory for an item\n  def has_item(index):\n    return env._current_state.inventory[index] > 0\n  \n  # Placeholder function to gather an item at the agent's position\n  def gather_item():\n    actions.append(USE)\n\n  # Determine if the goal item can be crafted directly or requires more ingredients\n  goal_index = item\n\n  # Example of a simple gathering task:\n  # If the goal is water (assuming water_index is known)\n  if goal_index == env.world.water_index:\n      move_to(WIDTH // 2, HEIGHT - 1)  # Move to the bottom middle where water is often found\n      gather_item()  # Gather water\n  \n  # Example of a simple crafting task:\n  # If the goal is stone (assuming stone_index is known)\n  elif goal_index == env.world.stone_index:\n      move_to(WIDTH // 2, HEIGHT - 1)  # Move to the bottom middle where stone is often found\n      gather_item()  # Gather stone\n  \n  # Example of a compound crafting task:\n  # If the goal requires multiple ingredients (e.g., cooking food)\n  else:\n      recipe = env.world.cookbook.primitives_for(goal_index)\n      \n      for ingredient, count in recipe.items():\n          if not has_item(ingredient):\n              move_to(WIDTH // 2, HEIGHT - 1)  # Move to the bottom middle where ingredients are often found\n              gather_item()  # Gather ingredient\n      \n      # Once all ingredients are gathered, use the workshop (assuming it's at a specific location)\n      move_to(WIDTH // 2, HEIGHT // 2)  # Move to the center where the workshop is often located\n      actions.append(USE)  # Use the workshop to craft the goal item\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:26:30.593938", "function_name": "craft", "function_body": "  def bfs_paths(starts, goal):\n      queue = [(start, [])]\n      visited = set()\n      while queue:\n          (node, path) = queue.pop(0)\n          if node not in visited:\n              neighbors = get_neighbors(node)\n              for neighbor in neighbors:\n                  new_path = path + [neighbor]\n                  if neighbor == goal:\n                      return new_path\n                  else:\n                      queue.append((neighbor, new_path))\n              visited.add(node)\n      return None\n\n  def get_neighbors(node):\n      \"\"\"Generate the list of nodes that can be directly reached from the current node.\"\"\"\n      neighbors = []\n      \n      # Get all recipes with `node` as an ingredient\n      for output, ingredients in env.world.cookbook.recipes.items():\n          if node in ingredients:\n              neighbors.append(output)\n              \n      return neighbors\n\n  def actions_to_reach_goal(path):\n      \"\"\"Generate the list of actions required to reach the goal from the path.\"\"\"\n      actions = []\n      \n      # For each step in the path, determine the action required\n      for i in range(len(path) - 1):\n          current_node = path[i]\n          next_node = path[i + 1]\n          \n          # Find recipe that produces `next_node` using `current_node`\n          for output, ingredients in env.world.cookbook.recipes.items():\n              if output == next_node and current_node in ingredients:\n                  actions.append(env.world.index.get(next_node))  # Assuming USE action to craft\n                  break\n      \n      return actions\n\n  def gather_primitives(actions, goal):\n      \"\"\"Simulate gathering primitives required for the actions.\"\"\"\n      current_inventory = np.zeros(env.world.n_kinds)\n      for action in actions:\n          if action in env.world.cookbook.primitives:\n              # Simulate picking up primitive\n              current_inventory[action] += 1\n      return current_inventory\n\n  def simulate_actions(actions, inventory):\n      \"\"\"Simulate performing the actions given an initial inventory.\"\"\"\n      current_state = env._current_state\n      for action in actions:\n          reward, new_state = current_state.step(action)\n          current_state = new_state\n      return current_state.inventory\n\n  # Start from the desired item (goal) and perform BFS to find the path back to primitives\n  goal = item\n  starts = list(env.world.cookbook.primitives)  # Choose all primitives as starting points\n  path = bfs_paths(starts, goal)\n  \n  if path:\n      actions = actions_to_reach_goal(path[::-1])  # Reverse the path to go from primitives to goal\n      primitives_inventory = gather_primitives(actions, goal)\n      \n      # Simulate performing the actions with the gathered primitives\n      final_inventory = simulate_actions(actions, primitives_inventory)\n      \n      return actions if final_inventory[goal] > 0 else []\n  else:\n      return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:26:31.580482", "function_name": "craft", "function_body": "  # Define the action types\n  MOVE_ACTIONS = [env_factory.DOWN, env_factory.UP, env_factory.LEFT, env_factory.RIGHT]\n  USE_ACTION = env_factory.USE\n\n  def bfs_paths(starts, goal):\n      queue = [(start, []) for start in starts]\n      visited = set()\n      while queue:\n          (node, path) = queue.pop(0)\n          if node not in visited:\n              neighbors = get_neighbors(node)\n              for neighbor, actions in neighbors:\n                  new_path = path + [neighbor]\n                  new_actions = actions\n                  if neighbor == goal:\n                      return new_path, new_actions\n                  else:\n                      queue.append((neighbor, new_actions))\n              visited.add(node)\n      return None, []\n\n  def get_neighbors(node):\n      \"\"\"Generate the list of nodes that can be directly reached from the current node along with the required actions.\"\"\"\n      neighbors = []\n      \n      # Get all recipes with `node` as an ingredient\n      for output, ingredients in env.world.cookbook.recipes.items():\n          if node in ingredients:\n              actions = [USE_ACTION]  # Assuming USE action to craft\n              neighbors.append((output, actions))\n              \n      return neighbors\n\n  def actions_to_reach_goal(path):\n      \"\"\"Generate the list of actions required to reach the goal from the path.\"\"\"\n      actions = []\n      \n      # For each step in the path, determine the action required\n      for i in range(len(path) - 1):\n          current_node = path[i]\n          next_node = path[i + 1]\n          \n          # Find recipe that produces `next_node` using `current_node`\n          for output, ingredients in env.world.cookbook.recipes.items():\n              if output == next_node and current_node in ingredients:\n                  actions.append(USE_ACTION)  # Assuming USE action to craft\n                  break\n      \n      return actions\n\n  # Start from the desired item (goal) and perform BFS to find the path back to primitives\n  goal = item\n  starts = list(env.world.cookbook.primitives)  # Choose all primitives as starting points\n  path, actions = bfs_paths(starts, goal)\n  \n  if path:\n      final_actions = actions_to_reach_goal(path[::-1])  # Reverse the path to go from primitives to goal\n  else:\n      final_actions = []\n  \n  return final_actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:28:07.368932", "function_name": "craft", "function_body": "  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Initialize a list to store the sequence of actions\n  actions = []\n\n  def move_to(x: int, y: int):\n      current_x, current_y = env._current_state.pos\n      delta_x = x - current_x\n      delta_y = y - current_y\n\n      if delta_y > 0:\n          actions.extend([DOWN] * abs(delta_y))\n      elif delta_y < 0:\n          actions.extend([UP] * abs(delta_y))\n\n      if delta_x > 0:\n          actions.extend([RIGHT] * abs(delta_x))\n      elif delta_x < 0:\n          actions.extend([LEFT] * abs(delta_x))\n\n  def pickup_items(item_index: int, count: int):\n      while env._current_state.inventory[item_index] < count and env._current_state.next_to(item_index):\n          actions.append(USE)\n\n  goal = env.world.cookbook.index.get(item)\n  if not goal:\n      raise ValueError(f\"Unknown item: {item}\")\n\n  primitives_needed = env.world.cookbook.primitives_for(env.world.cookbook.index[item])\n\n  # Search for ingredient locations in the grid\n  ingredient_locations = {}\n  for i in range(env._current_state.grid.shape[0]):\n      for j in range(env._current_state.grid.shape[1]):\n          for kind, quantity in enumerate(env._current_state.grid[i, j]):\n              if quantity > 0:\n                  if kind not in ingredient_locations:\n                      ingredient_locations[kind] = []\n                  ingredient_locations[kind].append((i, j))\n\n  # Move to each location and pick up the required items\n  for primitive_index, count in primitives_needed.items():\n      if primitive_index not in ingredient_locations:\n          raise ValueError(f\"Unknown ingredient location for index {primitive_index}\")\n      \n      # Prioritize closer locations first\n      ingredient_locations[primitive_index].sort(key=lambda loc: abs(loc[0] - env._current_state.pos[0]) + abs(loc[1] - env._current_state.pos[1]))\n      \n      current_quantity = 0\n      for loc in ingredient_locations[primitive_index]:\n          if current_quantity >= count:\n              break\n          \n          move_to(*loc)\n          pickup_items(primitive_index, count - current_quantity)\n          current_quantity += (count - current_quantity)\n\n  # Craft the item at a specific workshop location (assuming it's at 3, 3)\n  move_to(3, 3)\n  actions.append(USE)\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T23:28:08.337448", "function_name": "craft", "function_body": "  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Initialize a list to store the sequence of actions\n  actions = []\n\n  # Function to move to a specific position (x, y)\n  def move_to(x: int, y: int):\n      current_x, current_y = env._current_state.pos\n      delta_x = x - current_x\n      delta_y = y - current_y\n\n      if delta_y > 0:\n          actions.extend([DOWN] * abs(delta_y))\n      elif delta_y < 0:\n          actions.extend([UP] * abs(delta_y))\n\n      if delta_x > 0:\n          actions.extend([RIGHT] * abs(delta_x))\n      elif delta_x < 0:\n          actions.extend([LEFT] * abs(delta_x))\n\n  # Function to pick up items until the required count is met\n  def pickup_items(item_index: int, count: int):\n      while env._current_state.inventory[item_index] < count and env._current_state.next_to(item_index):\n          actions.append(USE)\n\n  # Get the list of primitive ingredients needed for the desired item\n  goal = env.world.cookbook.index.get(item)\n  if not goal:\n      raise ValueError(f\"Unknown item: {item}\")\n\n  primitives_needed = env.world.cookbook.primitives_for(env.world.cookbook.index[item])\n\n  # Search for ingredient locations in the grid\n  ingredient_locations = {}\n  for i in range(env._current_state.grid.shape[0]):\n      for j in range(env._current_state.grid.shape[1]):\n          for kind, quantity in enumerate(env._current_state.grid[i, j]):\n              if quantity > 0:\n                  if kind not in ingredient_locations:\n                      ingredient_locations[kind] = []\n                  ingredient_locations[kind].append((i, j))\n\n  # Move to each location and pick up the required items\n  for primitive_index, count in primitives_needed.items():\n      if primitive_index not in ingredient_locations:\n          raise ValueError(f\"Unknown ingredient location for index {primitive_index}\")\n      \n      # Prioritize closer locations first\n      ingredient_locations[primitive_index].sort(key=lambda loc: abs(loc[0] - env._current_state.pos[0]) + abs(loc[1] - env._current_state.pos[1]))\n      \n      for loc in ingredient_locations[primitive_index]:\n          move_to(*loc)\n          pickup_items(primitive_index, count)\n\n  # Craft the item at a specific workshop location (assuming it's at 3, 3)\n  move_to(3, 3)\n  actions.append(USE)\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T23:30:10.057092", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      \n      # Check if USE action is valid and prioritize it\n      reward, new_state_use = state.step(4)\n      if new_state_use != state:\n          valid_actions.append(4)\n      \n      # Check movement actions (DOWN, UP, LEFT, RIGHT) in the order they are defined\n      for action in range(4):\n          reward, new_state_move = state.step(action)\n          if new_state_move != state:\n              valid_actions.append(action)\n      \n      return valid_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Get valid actions and prioritize USE action\n          for action in get_valid_actions(current_state):\n              reward, new_state = current_state.step(action)\n              \n              if new_state == current_state:  # Skip invalid moves (e.g., moving into walls or using an empty inventory)\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (\n                  tuple(new_state.grid.flatten()), \n                  tuple(new_state.inventory), \n                  new_state.pos, \n                  new_state.dir\n              )\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # If the item is already in the inventory, return an empty list of actions\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T23:30:11.072432", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      \n      # Prioritize the USE action\n      reward, new_state = state.step(4)\n      if new_state != state:\n          valid_actions.append(4)\n      \n      for action in range(4):  # MOVEMENT ACTIONS: DOWN, UP, LEFT, RIGHT\n          reward, new_state = state.step(action)\n          if new_state != state:\n              valid_actions.append(action)\n      \n      return valid_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Get valid actions and prioritize USE action\n          for action in [4] + list(range(4)):\n              reward, new_state = current_state.step(action)\n              \n              if new_state == current_state:  # Skip invalid moves (e.g., moving into walls or using an empty inventory)\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      # Simple heuristic based on the number of items needed to craft the goal\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = {idx: count for idx, count in enumerate(state.inventory) if count > 0}\n      \n      missing_primitives = sum(primitives.get(idx, 0) - current_inventory.get(idx, 0) for idx in primitives)\n      return max(0, missing_primitives)\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import sys\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      \n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      came_from = {}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          for action in [4] + list(range(4)):\n              reward, new_state = current_state.step(action)\n              \n              if new_state == current_state:  # Skip invalid moves (e.g., moving into walls or using an empty inventory)\n                  continue\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = current_state, action\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n      total_path = []\n      while current_state in came_from:\n          prev_state, action = came_from[current_state]\n          total_path.append(action)\n          current_state = prev_state\n      return list(reversed(path + total_path))\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # If the item is already in the inventory, return an empty list of actions\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:33:15.921850", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=50):  # Limit search depth to avoid infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if len(path) > max_depth:\n              continue  # Skip paths that exceed the maximum depth\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def gather_primitives(env, initial_state, goal_item):\n      \"\"\"Gather all primitives needed to craft the goal item.\"\"\"\n      primitive_actions = []\n      required_prims = env.world.cookbook.primitives_for(goal_item)\n      \n      for prim_index in required_prims:\n          if satisfies_goal(initial_state, prim_index):\n              continue  # Skip gathering if already have the primitive\n          \n          # Find an action sequence to gather each primitive\n          prim_action_seq = bfs_search(initial_state, prim_index)\n          if not prim_action_seq:\n              raise ValueError(f\"Cannot find a path to gather {env.world.cookbook.index.get(prim_index)}\")\n          \n          primitive_actions.extend(prim_action_seq)\n          \n          # Update initial state after gathering primitives\n          current_state = initial_state\n          for action in prim_action_seq:\n              _, current_state = current_state.step(action)\n      \n      return primitive_actions\n\n  def craft_item(env, initial_state, goal_item):\n      \"\"\"Craft the item using gathered primitives.\"\"\"\n      action_sequence = bfs_search(initial_state, goal_item)\n      if action_sequence:\n          return action_sequence\n      \n      # If direct crafting fails, try to gather prerequisites\n      try:\n          primitive_actions = gather_primitives(env, initial_state, goal_item)\n      except ValueError as e:\n          print(e)\n          return None  # No actions found to gather primitives\n      \n      if not primitive_actions:\n          return None  # No actions found to gather primitives\n      \n      # After gathering primitives, attempt to craft the goal item again\n      new_initial_state = initial_state\n      for action in primitive_actions:\n          _, new_initial_state = new_initial_state.step(action)\n      \n      final_sequence = bfs_search(new_initial_state, goal_item)\n      \n      if final_sequence:\n          return primitive_actions + final_sequence\n      \n      return None  # No sequence found to craft the item\n\n  def refine_action_sequence(actions):\n      \"\"\"Refine action sequences by removing redundant movements.\"\"\"\n      refined_actions = []\n      last_pos = env._current_state.pos\n      last_dir = env._current_state.dir\n      \n      for action in actions:\n          if action == env.world.action_map['DOWN']:\n              new_pos = (last_pos[0], last_pos[1] + 1)\n          elif action == env.world.action_map['UP']:\n              new_pos = (last_pos[0], last_pos[1] - 1)\n          elif action == env.world.action_map['LEFT']:\n              new_pos = (last_pos[0] - 1, last_pos[1])\n          elif action == env.world.action_map['RIGHT']:\n              new_pos = (last_pos[0] + 1, last_pos[1])\n          else:\n              new_pos = last_pos\n      \n          if new_pos != last_pos or action == env.world.action_map['USE']:\n              refined_actions.append(action)\n              last_pos = new_pos\n          \n          # Update direction if needed\n          if action in [env.world.action_map['LEFT'], env.world.action_map['RIGHT']]:\n              last_dir = (last_dir + (1 if action == env.world.action_map['RIGHT'] else -1)) % 4\n      \n      return refined_actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = craft_item(env, initial_state, goal_item)\n\n  if action_sequence:\n      refined_actions = refine_action_sequence(action_sequence)\n      return refined_actions\n  \n  return []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
