{"timestamp": "2025-06-26T12:50:12.221169", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Skip invalid actions that incur penalties\n              if reward < 0:\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:50:27.923027", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action (index 4)\n          actions = [4] + list(range(4))\n          \n          for action in actions:\n              reward, new_state = current_state.step(action)\n              \n              # Skip invalid actions that incur penalties\n              if reward < 0:\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:51:14.987288", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(new_state, goal_item):\n      # Heuristic: prioritize states where the inventory has increased towards the goal item\n      current_inventory = new_state.inventory.copy()\n      current_inventory[new_state.world.stone_index] = 0  # Ignore stone for heuristic purposes\n      return np.linalg.norm(current_inventory - initial_inventory)\n\n  def dfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      stack = [(initial_state, [])]\n      visited_states = set()\n      \n      while stack:\n          current_state, path = stack.pop()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE actions to speed up crafting\n          for action in [4] + list(range(4)):\n              reward, new_state = current_state.step(action)\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Avoid revisiting states that have been visited with the same inventory and position\n              state_key = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos)\n              if state_key not in visited_states:\n                  visited_states.add(state_key)\n                  stack.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_inventory = env._current_state.inventory.copy()\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = dfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  ", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:51:19.640295", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(new_state, goal_item):\n      # Heuristic: prioritize states where the inventory has increased towards the goal item\n      current_inventory = new_state.inventory.copy()\n      current_inventory[new_state.world.stone_index] = 0  # Ignore stone for heuristic purposes\n      return np.linalg.norm(current_inventory - initial_inventory)\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, [], initial_state))  # Store (priority, path, state)\n      \n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + initial_state.pos: 0}\n      \n      while open_set:\n          _, path, current_state = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in [1, 0, 2, 3, 4]:  # Try actions in a specific order: UP, DOWN, LEFT, RIGHT, USE\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              state_hash = tuple(new_state.grid.flatten()) + tuple(new_state.inventory) + new_state.pos\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + current_state.pos] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + current_state.pos, action)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, path + [action], new_state))\n      \n      return None  # Return None if no sequence is found\n\n  initial_inventory = env._current_state.inventory.copy()\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  ", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:52:50.257722", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Limit the number of steps to prevent infinite loops\n      if len(path) >= max_steps:\n          continue\n      \n      for action in range(env.world.n_actions):\n          reward, new_state = current_state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          if state_hash not in visited:\n              visited.add(state_hash)\n              queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # First attempt to find a direct path\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      print(\"Direct path not found. Attempting alternative strategies.\")\n      \n      # Strategy: Collect primitives needed for the goal item\n      cookbook = env.world.cookbook\n      primitives_needed = cookbook.primitives_for(goal_item)\n      \n      print(f\"Primitives needed for {env.world.cookbook.index.get(goal_item)}: {primitives_needed}\")\n      \n      current_state = initial_state\n      \n      collected_primitives = {}\n      \n      for primitive, count in primitives_needed.items():\n          print(f\"Collecting {count} of {env.world.cookbook.index.get(primitive)}\")\n          \n          # Collect the required amount of each primitive\n          collected_count = 0\n          \n          while collected_count < count:\n              action_sequence_to_primitive = bfs_search(current_state, primitive)\n              \n              if not action_sequence_to_primitive:\n                  print(f\"Could not find a path to collect {env.world.cookbook.index.get(primitive)}\")\n                  break\n              \n              for action in action_sequence_to_primitive:\n                  reward, current_state = current_state.step(action)\n              \n              collected_count += 1\n              action_sequence.extend(action_sequence_to_primitive)\n              print(f\"Collected {collected_count}/{count} of {env.world.cookbook.index.get(primitive)}\")\n          \n          # Track the number of primitives collected for this type\n          collected_primitives[primitive] = collected_count\n      \n      # After collecting all primitives, try to craft the goal item again\n      print(\"Primitives collected. Attempting to craft goal item.\")\n      action_sequence_to_goal = bfs_search(current_state, goal_item)\n      \n      if action_sequence_to_goal:\n          action_sequence.extend(action_sequence_to_goal)\n      else:\n          print(f\"Could not find a path to craft {env.world.cookbook.index.get(goal_item)}\")\n          # Attempt to use collected primitives in crafting steps\n          for primitive, count in collected_primitives.items():\n              if count > 0:\n                  print(f\"Using collected {count} of {env.world.cookbook.index.get(primitive)} in crafting.\")\n                  # Placeholder for more sophisticated logic to integrate collected items into crafting process\n                  # This might involve modifying the BFS search to include these items in intermediate steps.\n      \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:53:05.936371", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Limit the number of steps to prevent infinite loops\n      if len(path) >= max_steps:\n          continue\n      \n      for action in range(env.world.n_actions):\n          reward, new_state = current_state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          if state_hash not in visited:\n              visited.add(state_hash)\n              queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # First attempt to find a direct path\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(\"Direct path not found. Attempting alternative strategies.\")\n    \n    # Strategy: Collect primitives needed for the goal item\n    cookbook = env.world.cookbook\n    primitives_needed = cookbook.primitives_for(goal_item)\n    \n    print(f\"Primitives needed for {env.world.cookbook.index.get(goal_item)}: {primitives_needed}\")\n    \n    current_state = initial_state\n    \n    for primitive, count in primitives_needed.items():\n      print(f\"Collecting {count} of {env.world.cookbook.index.get(primitive)}\")\n      \n      # Collect the required amount of each primitive\n      collected_count = 0\n      \n      while collected_count < count:\n        action_sequence_to_primitive = bfs_search(current_state, primitive)\n        \n        if not action_sequence_to_primitive:\n          print(f\"Could not find a path to collect {env.world.cookbook.index.get(primitive)}\")\n          break\n        \n        for action in action_sequence_to_primitive:\n            reward, current_state = current_state.step(action)\n        \n        collected_count += 1\n        action_sequence.extend(action_sequence_to_primitive)\n        print(f\"Collected {collected_count}/{count} of {env.world.cookbook.index.get(primitive)}\")\n    \n    # After collecting all primitives, try to craft the goal item again\n    print(\"Primitives collected. Attempting to craft goal item.\")\n    action_sequence_to_goal = bfs_search(current_state, goal_item)\n    \n    if action_sequence_to_goal:\n      action_sequence.extend(action_sequence_to_goal)\n    else:\n      print(f\"Could not find a path to craft {env.world.cookbook.index.get(goal_item)}\")\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:53:48.552894", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic based on the number of items needed\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      required_items = sum(primitives.values())\n      current_items = np.sum(current_state.inventory[list(primitives.keys())])\n      return required_items - current_items\n\n  def astar_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0 + heuristic(initial_state, goal_item), 0, initial_state, []))\n      \n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while not open_set.empty():\n          _, current_cost, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Each step costs 1\n      \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  \n                  open_set.put((f_score[new_state], tentative_g_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:54:04.366635", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(state):\n      neighbors = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          neighbors.append((new_state, state_hash, action))\n      \n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for new_state, state_hash, action in get_neighbors(current_state):\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n  \n  # If the action sequence is not found, attempt to reset the environment and try again\n  if not action_sequence:\n      env.reset()\n      initial_state = env._current_state\n      action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:54:53.585993", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic based on the number of items in inventory\n      return len([i for i in range(len(state.inventory)) if i != goal_item and state.inventory[i] > 0])\n\n  def astar_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      \n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory): 0}\n      f_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory): heuristic(initial_state, goal_item)}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory)] + 1  # Assume cost of 1 for each action\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n      total_path = path\n      while current_state in came_from:\n          current_state, path = came_from[current_state]\n          total_path = path + total_path\n      return total_path\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:54:54.586121", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: the number of steps required to reach the goal item\n      # For now, we'll use a simple approach based on inventory count.\n      return max(0, 1 - state.inventory[goal_item])\n\n  def astar_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory): 0}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = tuple(new_state.grid.flatten()) + tuple(new_state.inventory)\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory)] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, action)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-06-26T12:55:45.787957", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is valid and has a recipe or is primitive\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item index {goal_item} is not recognized.\")\n  \n  # Check if the goal item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []  # No actions needed\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence is None:\n      raise ValueError(f\"No crafting sequence found for item index {goal_item}.\")\n  \n  return action_sequence", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:56:01.765410", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prune paths that are too long to be practical\n          if len(path) > 50:  # Arbitrary depth limit for this example\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is valid and has a recipe or is primitive\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item index {goal_item} is not recognized.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:58:16.778771", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=50):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        # Check if the current depth exceeds the maximum allowed depth\n        if len(path) >= max_depth:\n            continue\n\n        for action in range(env.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def retry_bfs_search(env, goal_item, max_retries=5):\n    for _ in range(max_retries):\n        env.reset()\n        initial_state = env._current_state\n        action_sequence = bfs_search(initial_state, goal_item)\n        if action_sequence:\n            return action_sequence\n    return None\n\n  def optimize_action_sequence(action_sequence):\n    # Implement optimization logic here (e.g., remove redundant movements)\n    from collections import defaultdict\n    \n    # Remove consecutive opposite actions (e.g., LEFT RIGHT)\n    optimized_actions = []\n    i = 0\n    while i < len(action_sequence):\n        if action_sequence[i] == 0 and i + 1 < len(action_sequence) and action_sequence[i + 1] == 1:\n            i += 2\n        elif action_sequence[i] == 1 and i + 1 < len(action_sequence) and action_sequence[i + 1] == 0:\n            i += 2\n        elif action_sequence[i] == 2 and i + 1 < len(action_sequence) and action_sequence[i + 1] == 3:\n            i += 2\n        elif action_sequence[i] == 3 and i + 1 < len(action_sequence) and action_sequence[i + 1] == 2:\n            i += 2\n        else:\n            optimized_actions.append(action_sequence[i])\n            i += 1\n\n    # Further optimization can be done based on specific rules or heuristics\n    return optimized_actions\n\n  def find_closest_resource(env, resource_index):\n    \"\"\"Finds the closest resource to the current agent's position.\"\"\"\n    state = env._current_state\n    grid = state.grid\n    pos_x, pos_y = state.pos\n    \n    min_distance = float('inf')\n    target_pos = None\n    \n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if grid[x, y, resource_index] > 0:\n                distance = abs(x - pos_x) + abs(y - pos_y)\n                if distance < min_distance:\n                    min_distance = distance\n                    target_pos = (x, y)\n    \n    return target_pos\n\n  def move_to_position(env, current_state, target_pos):\n    \"\"\"Generates actions to move the agent to the target position.\"\"\"\n    from collections import deque\n    \n    queue = deque([(current_state.pos, [])])\n    visited = set([current_state.pos])\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    action_map = {(0, 1): 2, (1, 0): 0, (0, -1): 3, (-1, 0): 1}  # Action indices for RIGHT, DOWN, LEFT, UP\n    \n    while queue:\n        current_pos, path = queue.popleft()\n        \n        if current_pos == target_pos:\n            return path\n        \n        for direction in directions:\n            new_x = current_pos[0] + direction[0]\n            new_y = current_pos[1] + direction[1]\n            \n            if 0 <= new_x < env.world.grid.shape[0] and 0 <= new_y < env.world.grid.shape[1]:\n                new_state, _ = current_state.step(action_map[direction])\n                \n                # Convert the new state to a hashable form using a tuple of its attributes\n                state_hash = (tuple(new_state.grid.flatten()), \n                              tuple(new_state.inventory), \n                              new_state.pos, \n                              new_state.dir)\n                \n                if new_state.pos not in visited:\n                    visited.add(new_state.pos)\n                    queue.append(((new_x, new_y), path + [action_map[direction]]))\n    \n    return None  # Return None if no path is found\n\n  def find_and_pickup_resource(env, resource_index):\n    \"\"\"Finds the closest resource and generates actions to pick it up.\"\"\"\n    target_pos = find_closest_resource(env, resource_index)\n    if not target_pos:\n        return []\n    \n    current_state = env._current_state\n    move_actions = move_to_position(env, current_state, target_pos)\n    if not move_actions:\n        return []\n    \n    # Add the action to pick up the resource (assuming USE/INTERACT is action 4)\n    pickup_action = [4]\n    \n    return move_actions + pickup_action\n\n  def plan_action_sequence(env, goal_item):\n    \"\"\"Plans the sequence of actions needed to craft the item.\"\"\"\n    from collections import defaultdict\n    \n    cookbook = env.world.cookbook\n    primitives = {item: [] for item in range(cookbook.index.size())}\n    \n    # Define primitive actions for gathering resources\n    for resource_index in cookbook.grabbables:\n        primitives[resource_index] = find_and_pickup_resource(env, resource_index)\n    \n    # Define recipes as sequences of actions\n    for recipe_item, ingredients in cookbook.recipes.items():\n        sequence = []\n        for ingredient in ingredients:\n            sequence.extend(primitives[ingredient])\n        \n        # Add the craft action (assuming CRAFT is action 5)\n        craft_action = [5]\n        sequence.extend(craft_action)\n        \n        primitives[recipe_item] = sequence\n    \n    return primitives[goal_item]\n\n  goal_item = item\n  action_sequence = plan_action_sequence(env, goal_item)\n\n  if action_sequence:\n      optimized_actions = optimize_action_sequence(action_sequence)\n      return optimized_actions\n  \n  return []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
