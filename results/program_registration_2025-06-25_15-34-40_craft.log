{"timestamp": "2025-06-27T04:36:18.133385", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_primitives):\n      \"\"\"Heuristic function to estimate the cost from state to goal.\"\"\"\n      required_primitives = {primitive: count - state.inventory[primitive] \n                             for primitive, count in goal_primitives.items() \n                             if count > state.inventory[primitive]}\n      total_cost = sum(required_primitives.values())\n      return total_cost\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = [(0, initial_state, [])]  # (f_score, state, path)\n      came_from = {}", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-27T04:36:19.309239", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      heuristic_factor = 1.0  # Factor to adjust the heuristic influence\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Sort actions based on a heuristic (e.g., proximity to required items)\n          actions_sorted = sorted(range(initial_state.world.n_actions), key=lambda action: action_heuristic(action, current_state, goal_primitives))\n          \n          for action in actions_sorted:\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def action_heuristic(action, state, goal_primitives):\n      \"\"\"Heuristic function to prioritize actions that bring the agent closer to the required items.\"\"\"\n      pos = np.array(state.pos)\n      directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n      \n      if action < 4:  # Movement actions\n          new_pos = pos + np.array(directions[action])\n          return heuristic_factor * min_distance_to_primitives(new_pos, state.world, goal_primitives)\n      \n      elif action == 4:  # USE action\n          # Prioritize the USE action if it can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n              if state.inventory[primitive] < count:\n                  can_make_goal = False\n                  break\n          \n          return 0 if can_make_goal else heuristic_factor * min_distance_to_primitives(pos, state.world, goal_primitives)\n      \n      return float('inf')  # Default to a high cost for invalid actions\n\n  def min_distance_to_primitives(pos, world, primitives):\n      \"\"\"Calculate the minimum Manhattan distance from the current position to any of the required primitives.\"\"\"\n      grid = np.any(world._current_state.grid[..., list(primitives.keys())], axis=-1)\n      if not np.any(grid):\n          return float('inf')\n      \n      distances = abs(np.array(pos)[:, None, None] - np.indices(grid.shape))\n      total_distances = distances.sum(axis=0)\n      return np.min(total_distances[grid])\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-27T04:37:55.770216", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n\n  start_time = time.time()\n  action_sequence = bfs_search(initial_state, goal_item)\n  end_time = time.time()\n\n  print(f\"Time taken to find action sequence: {end_time - start_time} seconds\")\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-27T04:37:56.960621", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic: number of missing primitives\n      current_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n      available_inventory = {i: count for i, count in enumerate(current_state.inventory) if count > 0}\n      \n      missing_count = 0\n      for primitive, required_amount in current_primitives.items():\n          available_amount = available_inventory.get(primitive, 0)\n          missing_count += max(0, required_amount - available_amount)\n      \n      return missing_count\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))  # f_score, state, path\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  f_score = len(path) + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
