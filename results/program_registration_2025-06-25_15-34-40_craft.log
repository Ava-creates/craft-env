l_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = all(new_state.inventory[primitive] >= count for primitive, count in goal_primitives.items())\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  possible_actions.append((new_state, action))\n          \n          # Prioritize actions that use resources needed for the goal or move towards them\n          next_to_counts = get_next_to_counts(current_state, goal_primitives)\n          sorted_possible_actions = sorted(\n              possible_actions,\n              key=lambda x: (\n                  -sum(x[0].inventory[primitive] > 0 for primitive in goal_primitives),\n                  sum(next_to_counts[primitive] for primitive in goal_primitives if x[0].next_to(primitive)),\n                  -len(path)  # Shorter paths last\n              )\n          )\n          \n          queue.extend((new_state, path + [action]) for new_state, action in sorted_possible_actions)\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T04:50:25.791237", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n\n      queue = deque([(initial_state, [])])\n      visited = set()\n      action_sequence_cache = {}\n\n      while queue:\n          current_state, path = queue.popleft()\n\n          if satisfies_goal(current_state, goal_item):\n              return path\n\n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n\n      return None  # Return None if no sequence is found\n\n  def heuristic(current_state, goal_item):\n      \"\"\"Estimate the cost to reach the goal from the current state.\"\"\"\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      current_primitives = {i: count for i, count in enumerate(current_state.inventory) if count > 0}\n\n      # Calculate the number of missing primitives\n      missing_primitives = sum(max(0, goal_primitives.get(i, 0) - current_primitives.get(i, 0)) for i in goal_primitives)\n      return missing_primitives\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      from collections import defaultdict\n\n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))  # (f_score, state, path)\n      came_from = {}\n      g_score = defaultdict(lambda: float('inf'))\n      g_score[(tuple(initial_state.grid.flatten()), tuple(initial_state.inventory), initial_state.pos, initial_state.dir)] = 0\n\n      while open_set:\n          _, current_state, path = heappop(open_set)\n\n          if satisfies_goal(current_state, goal_item):\n              return path\n\n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n\n              tentative_g_score = g_score[(tuple(current_state.grid.flatten()), tuple(current_state.inventory), current_state.pos, current_state.dir)] + 1\n\n              if tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n\n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if not action_sequence:\n    # Fallback: Try a different approach or heuristic if needed\n    # For now, we can just return an empty list as a placeholder\n    return []\n\n  return action_sequence", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-27T04:50:27.050884", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n    \n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n    \n    dfs(goal_index)\n    return primitives\n\n  def heuristic(state, goal_item):\n    \"\"\"Heuristic function to estimate the cost from current state to reach the goal.\"\"\"\n    # Simple heuristic: Count of missing required primitives.\n    goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n    missing_count = sum(max(0, count - state.inventory[primitive]) for primitive, count in goal_primitives.items())\n    return missing_count\n\n  def a_star_search(initial_state, goal_item):\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), 0, initial_state, []))\n    \n    came_from = {}\n    g_score = {initial_state: 0}\n    f_score = {initial_state: heuristic(initial_state, goal_item)}\n    \n    while open_set:\n      _, current_cost, current_state, path = heapq.heappop(open_set)\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n          \n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        tentative_g_score = g_score[current_state] + 1  # Assuming each step has a cost of 1\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if new_state not in g_score or tentative_g_score < g_score[new_state]:\n          came_from[state_hash] = (current_state, path + [action])\n          g_score[new_state] = tentative_g_score\n          f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n          heapq.heappush(open_set, (f_score[new_state], tentative_g_score, new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if not action_sequence:\n    # Fallback: Try a different approach or heuristic if needed\n    # For now, we can just return an empty list as a placeholder\n    return []\n\n  return action_sequence", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-27T04:52:23.533399", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      use_actions = []\n      other_actions = []\n\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          can_make_goal = all(new_state.inventory[primitive] >= count \n                              for primitive, count in goal_primitives.items())\n          \n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n\n          use_actions.append((action, reward, new_state))\n        else:\n          other_actions.append((action, reward, new_state))\n\n      # Prioritize USE actions that make progress\n      for action, _, new_state in sorted(use_actions, key=lambda x: -x[1]):  # Sort by negative reward to prioritize higher rewards\n        state_hash = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos, new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n      \n      # Then add other actions\n      for action, _, new_state in other_actions:\n        state_hash = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos, new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def get_item_index(item_name, cookbook):\n    try:\n      return cookbook.index[item_name]\n    except KeyError:\n      raise ValueError(f\"Item '{item_name}' not found in the cookbook.\")\n\n  initial_state = env._current_state\n  goal_item_name = item\n  \n  # Convert item name to index if it's a string\n  if isinstance(item, str):\n    try:\n      goal_item = get_item_index(goal_item_name, initial_state.world.cookbook)\n    except ValueError as e:\n      print(e)\n      return []\n  else:\n    goal_item = item\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 2.0}}
