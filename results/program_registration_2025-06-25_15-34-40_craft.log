{"timestamp": "2025-06-26T06:59:02.565354", "function_name": "craft", "function_body": "  def hashable_state(state):\n      grid_flat = tuple(state.grid.flatten())\n      pos_tuple = state.pos\n      dir_value = state.dir\n      inventory_tuple = tuple(state.inventory)\n      return (grid_flat, pos_tuple, dir_value, inventory_tuple)\n\n  current_state = env._current_state\n\n  from collections import deque\n  queue = deque([(current_state, [])])\n\n  visited_states = set()\n  visited_states.add(hashable_state(current_state))\n\n  while queue:\n      current_state, actions_taken = queue.popleft()\n\n      # Check if the goal is satisfied in the current state\n      if current_state.satisfies(\"dummy_goal_name\", item):\n          return actions_taken\n\n      # Try all possible actions\n      for action in range(env.world.n_actions):  \n          reward, new_state = current_state.step(action)\n\n          # Check if the goal is satisfied after taking this action (early exit)\n          if new_state.satisfies(\"dummy_goal_name\", item):\n              return actions_taken + [action]\n\n          state_representation = hashable_state(new_state)\n\n          if state_representation not in visited_states:\n              visited_states.add(state_representation)\n              queue.append((new_state, actions_taken + [action]))\n\n  # Return an empty list or a specific action sequence indicating failure to find a solution\n  return []", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T06:59:31.532289", "function_name": "craft", "function_body": "  current_state = env._current_state\n  goal_index = item\n  \n  # Priority queue for A* search with estimated cost\n  priority_queue = [(0, current_state, [])]\n  visited_states = set()\n\n  while priority_queue:\n      _, current_state, actions_taken = priority_queue.pop(0)\n\n      if current_state.satisfies(\"dummy_goal_name\", goal_index):\n          return actions_taken\n\n      for action in [4] + list(range(4)):  \n          reward, new_state = current_state.step(action)\n          \n          # Estimate the cost to reach the goal using a heuristic (e.g., Manhattan distance to nearest ingredient or workshop)\n          estimated_cost = estimate_cost_to_goal(new_state, goal_index)\n\n          state_representation = (tuple(new_state.grid.flatten()), \n                                  tuple(new_state.pos), \n                                  new_state.dir)\n          \n          if state_representation not in visited_states:\n              visited_states.add(state_representation)\n              priority_queue.append((len(actions_taken) + estimated_cost, new_state, actions_taken + [action]))\n              # Sort the queue to ensure the lowest cost path is always expanded first\n              priority_queue.sort()\n\n  return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-26T06:59:40.536429", "function_name": "craft", "function_body": "  current_state = env._current_state\n  queue = [(current_state, [])]\n  visited_states = set()\n\n  # Add a priority for using items first\n  action_priorities = [4] + list(range(4))  # Assuming USE (action 4) is the priority action\n\n  while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(\"dummy_goal_name\", item):\n          return actions_taken\n\n      for action in action_priorities:  \n          reward, new_state = current_state.step(action)\n\n          # Check if the goal is satisfied after taking the action\n          if new_state.satisfies(\"dummy_goal_name\", item):\n              return actions_taken + [action]\n\n          state_representation = (tuple(new_state.grid.flatten()), \n                                  tuple(new_state.pos), \n                                  new_state.dir)\n          \n          if state_representation not in visited_states:\n              visited_states.add(state_representation)\n              queue.append((new_state, actions_taken + [action]))\n\n  # If no path is found\n  return []", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T07:00:36.705709", "function_name": "craft", "function_body": "  def heuristic(state):\n      \"\"\"Heuristic function to estimate the cost from current state to goal.\"\"\"\n      # Simple heuristic: count of missing items in inventory needed for goal\n      primitives = env.world.cookbook.primitives_for(item)\n      return sum(max(0, primitives.get(kind, 0) - state.inventory[kind]) for kind in primitives)\n\n  current_state = env._current_state\n\n  # Priority queue for A* with the initial state and an empty action sequence\n  import heapq\n  priority_queue = [(heuristic(current_state), current_state, [])]\n\n  # Set to track visited states (using tuple representation of grid, pos, dir)\n  visited_states = set()\n\n  while priority_queue:\n      _, current_state, actions_taken = heapq.heappop(priority_queue)\n\n      # Check if the goal is satisfied in the current state\n      if current_state.satisfies(\"dummy_goal_name\", item):\n          return actions_taken\n\n      # Get the next possible states by taking each action\n      for action in range(env.world.n_actions):  # Assuming there are n_actions available actions\n          reward, new_state = current_state.step(action)\n\n          # Check if the goal is satisfied after the step (early exit)\n          if new_state.satisfies(\"dummy_goal_name\", item):\n              return actions_taken + [action]\n\n          # Create a unique hashable representation of the state to check if it's visited\n          state_representation = (tuple(new_state.grid.flatten()), \n                                  tuple(new_state.pos), \n                                  new_state.dir)\n          \n          if state_representation not in visited_states:\n              visited_states.add(state_representation)\n              heapq.heappush(priority_queue, (heuristic(new_state) + len(actions_taken) + 1, new_state, actions_taken + [action]))\n\n  # Return an empty list or a specific action sequence indicating failure to find a solution\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-26T07:00:37.669099", "function_name": "craft", "function_body": "  def heuristic(state):\n      # Simple heuristic: count the number of required items in the inventory\n      # and subtract the number of available items on the grid.\n      cookbook = env.world.cookbook\n      primitives_needed = cookbook.primitives_for(item)\n      \n      # Count the required primitives in the inventory\n      required_in_inventory = sum(primitives_needed.get(i, 0) for i in range(len(state.inventory)) if state.inventory[i] > 0)\n      \n      # Count the available primitives on the grid\n      available_on_grid = 0\n      for x in range(env.world.WIDTH):\n          for y in range(env.world.HEIGHT):\n              for kind in primitives_needed.keys():\n                  if state.grid[x, y, kind] > 0:\n                      available_on_grid += state.grid[x, y, kind]\n      \n      # Heuristic value: required items - available items\n      return len(primitives_needed) - (required_in_inventory + available_on_grid)\n\n  current_state = env._current_state\n\n  # Priority queue for A* with the initial state and an empty action sequence\n  import heapq\n  priority_queue = [(heuristic(current_state), current_state, [])]\n\n  # Set to track visited states (using tuple representation of grid, pos, dir)\n  visited_states = set()\n\n  while priority_queue:\n      _, current_state, actions_taken = heapq.heappop(priority_queue)\n\n      # Check if the goal is satisfied in the current state\n      if current_state.satisfies(\"dummy_goal_name\", item):\n          return actions_taken\n\n      # Get the next possible states by taking each action\n      for action in range(env.world.n_actions):  # Assuming there are n_actions available actions\n          reward, new_state = current_state.step(action)\n\n          # Check if the goal is satisfied after the step (early exit)\n          if new_state.satisfies(\"dummy_goal_name\", item):\n              return actions_taken + [action]\n\n          # Create a unique hashable representation of the state to check if it's visited\n          state_representation = (tuple(new_state.grid.flatten()), \n                                  tuple(new_state.pos), \n                                  new_state.dir)\n          \n          if state_representation not in visited_states:\n              visited_states.add(state_representation)\n              heapq.heappush(priority_queue, (heuristic(new_state) + len(actions_taken) + 1, new_state, actions_taken + [action]))\n\n  # Return an empty list or a specific action sequence indicating failure to find a solution\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-26T07:01:40.170980", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      # Priority queue for A* search\n      open_set = []\n      \n      # Add initial state with zero cost and heuristic (estimated) cost of 0\n      start_cost = 0\n      start_heuristic = heuristic(initial_state, goal_item)\n      start_f_cost = start_cost + start_heuristic\n      heappush(open_set, (start_f_cost, start_cost, initial_state, []))\n      \n      # Set to keep track of visited states\n      visited = set()\n      \n      while open_set:\n          _, current_cost, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Convert the current state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(current_state.grid.flatten()), \n                        tuple(current_state.inventory), \n                        current_state.pos, \n                        current_state.dir)\n          \n          if state_hash in visited:\n              continue\n          \n          visited.add(state_hash)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              new_state_hash = (tuple(new_state.grid.flatten()), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir)\n              \n              if new_state_hash not in visited:\n                  action_cost = 1 + current_cost  # Assuming each action has cost 1\n                  heuristic_value = heuristic(new_state, goal_item)\n                  f_cost = action_cost + heuristic_value\n                  \n                  heappush(open_set, (f_cost, action_cost, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: count of goal item in inventory\n      return max(0, 1 - state.inventory[goal_item])\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T07:01:41.214465", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n      return [(nx, ny) for nx, ny in neighbors if 0 <= nx < env.scenario.init_grid.shape[0] and 0 <= ny < env.scenario.init_grid.shape[1]]\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize moving to neighboring cells with useful items or workbenches\n          neighbors = get_neighbors(current_state.pos)\n          neighbor_actions = []\n          for nx, ny in neighbors:\n              kind_at_cell = np.argmax(current_state.grid[nx, ny])\n              if kind_at_cell in current_state.world.grabbable_indices or kind_at_cell in current_state.world.workshop_indices:\n                  direction = (np.array([nx, ny]) - np.array(current_state.pos)).argmax()\n                  neighbor_actions.append(direction)\n          \n          # Add the USE action if on a workbench\n          if np.argmax(current_state.grid[current_state.pos[0], current_state.pos[1]]) in current_state.world.workshop_indices:\n              neighbor_actions.append(4)  # Use action\n\n          # Explore all actions, including movements and using items\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action not in neighbor_actions:\n                  continue  # Prioritize neighbor actions first\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-06-26T07:03:21.769454", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that involve using the inventory or moving towards known resources\n          actions = prioritize_actions(current_state)\n          \n          for action in actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_actions(state):\n      from random import shuffle\n      \n      # Define actions: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = list(range(env.world.n_actions))\n      \n      # Prioritize USE action to attempt crafting or using items\n      use_action_id = 4  # Assuming USE is represented by index 4\n      if use_action_id in action_ids:\n          prioritized_actions = [use_action_id]\n      else:\n          prioritized_actions = []\n      \n      # Prioritize moving towards known resources\n      resource_indices = env.world.grabbable_indices\n      for idx in resource_indices:\n          if state.next_to(idx):\n              move_towards_resource_action_id = find_move_towards_resource_action(state, idx)\n              if move_towards_resource_action_id is not None and move_towards_resource_action_id in action_ids:\n                  prioritized_actions.append(move_towards_resource_action_id)\n      \n      # Shuffle other actions to avoid deterministic behavior\n      shuffle(action_ids)\n      for action_id in action_ids:\n          if action_id not in prioritized_actions:\n              prioritized_actions.append(action_id)\n      \n      return prioritized_actions\n\n  def find_move_towards_resource_action(state, resource_idx):\n      from random import choice\n      \n      # Define actions: DOWN, UP, LEFT, RIGHT\n      move_action_ids = list(range(env.world.n_actions - 1))  # Exclude USE action\n      \n      # Check adjacent cells for the resource\n      adj_positions = [(state.pos[0] + dx, state.pos[1] + dy) \n                       for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n      \n      for pos, action_id in zip(adj_positions, move_action_ids):\n          if is_valid_position(pos) and state.grid[pos[0], pos[1], resource_idx] > 0:\n              return action_id\n      \n      # If not adjacent, choose a random direction\n      return choice(move_action_ids)\n\n  def is_valid_position(pos):\n      width, height = env.world.WIDTH, env.world.HEIGHT\n      return 0 <= pos[0] < width and 0 <= pos[1] < height\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T07:03:22.742883", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that involve using the inventory or moving towards known resources\n          actions = prioritize_actions(current_state)\n          \n          for action in actions:\n              reward, new_state = current_state.step(action)\n              \n              # Skip invalid moves (e.g., moving into walls or using an empty inventory)\n              if new_state == current_state:\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_actions(state):\n      from random import shuffle\n      \n      # Define actions: DOWN, UP, LEFT, RIGHT, USE\n      action_ids = list(range(env.world.n_actions))\n      \n      # Prioritize USE action to attempt crafting or using items\n      use_action_id = 4  # Assuming USE is represented by index 4\n      if use_action_id in action_ids:\n          action_ids.remove(use_action_id)\n          prioritized_actions = [use_action_id]\n      else:\n          prioritized_actions = []\n      \n      # Prioritize moving towards known resources or workshops\n      move_actions = prioritize_movement(state)\n      prioritized_actions.extend(move_actions)\n      \n      # Shuffle remaining actions to avoid deterministic behavior\n      shuffle(action_ids)\n      prioritized_actions.extend(action_ids)\n      \n      return prioritized_actions\n\n  def prioritize_movement(state):\n      from random import sample\n      \n      # Define actions: DOWN, UP, LEFT, RIGHT, USE\n      move_action_ids = list(range(4))  # Assuming move actions are indices 0 to 3\n      \n      # Sample a subset of move actions with higher probability towards resources or workshops\n      prioritize_move_prob = 0.5\n      if np.random.rand() < prioritize_move_prob:\n          target_indices = state.world.grabbable_indices + state.world.workshop_indices\n          \n          # Find positions of known targets in the grid\n          known_targets = set()\n          for idx in target_indices:\n              pos = find_nearest_target(state.grid, idx)\n              if pos is not None:\n                  known_targets.add(pos)\n          \n          if known_targets:\n              # Prioritize moving towards nearest known targets\n              move_directions = []\n              for target_pos in known_targets:\n                  direction = get_movement_direction(state.pos, target_pos)\n                  if direction is not None:\n                      move_directions.append(direction)\n              \n              return sample(move_directions, min(2, len(move_directions)))  # Sample up to 2 directions\n      \n      # If no prioritized moves found, return all move actions\n      return move_action_ids\n\n  def find_nearest_target(grid, target_idx):\n      positions = np.argwhere(grid[..., target_idx] > 0)\n      if not positions.size:\n          return None\n      agent_pos = np.array(state.pos)\n      distances = np.linalg.norm(positions - agent_pos, axis=1)\n      nearest_idx = np.argmin(distances)\n      return tuple(positions[nearest_idx])\n\n  def get_movement_direction(current_pos, target_pos):\n      dx, dy = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n      \n      # Define actions: DOWN, UP, LEFT, RIGHT\n      action_map = {\n          (0, 1): 3,  # RIGHT\n          (0, -1): 2, # LEFT\n          (-1, 0): 1, # UP\n          (1, 0): 0   # DOWN\n      }\n      \n      direction = (np.sign(dx), np.sign(dy))\n      return action_map.get(direction)\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T07:04:28.598470", "function_name": "craft", "function_body": "  current_state = env._current_state\n\n  # Define a queue for BFS with the initial state and an empty action sequence\n  queue = [(current_state, [])]\n\n  # Set to track visited states (using tuple representation of grid, pos, dir)\n  visited_states = set()\n  \n  # Track the best actions found that lead to the closest to the goal item in inventory\n  best_actions = None\n  max_inventory_count = 0\n\n  while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      # Check if the goal is satisfied in the current state\n      if current_state.satisfies(\"dummy_goal_name\", item):\n          return actions_taken\n\n      # Create a unique hashable representation of the state to check if it's visited\n      state_representation = (tuple(current_state.grid.flatten()), \n                              tuple(current_state.pos), \n                              current_state.dir,\n                              tuple(current_state.inventory))\n      \n      if state_representation not in visited_states:\n          visited_states.add(state_representation)\n\n          # Get the next possible states by taking each action\n          for action in range(env.world.n_actions):  # Assuming there are n_actions available actions\n              reward, new_state = current_state.step(action)\n\n              # Check if the goal is satisfied after the step (early exit)\n              if new_state.satisfies(\"dummy_goal_name\", item):\n                  return actions_taken + [action]\n\n              # Update best actions based on inventory count of the goal item\n              inventory_count = new_state.inventory[item]\n              if inventory_count > max_inventory_count:\n                  max_inventory_count = inventory_count\n                  best_actions = actions_taken + [action]\n\n              state_representation_new = (tuple(new_state.grid.flatten()), \n                                          tuple(new_state.pos), \n                                          new_state.dir,\n                                          tuple(new_state.inventory))\n              if state_representation_new not in visited_states:\n                  queue.append((new_state, actions_taken + [action]))\n\n  # Return the best actions found or an empty list if no solution was found\n  return best_actions if best_actions else []", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T07:04:29.608587", "function_name": "craft", "function_body": "  current_state = env._current_state\n\n  # Define a queue for BFS with the initial state and an empty action sequence\n  queue = [(current_state, [])]\n\n  # Set to track visited states (using tuple representation of grid, pos, dir)\n  visited_states = set()\n  \n  # Track the best actions found that lead to the closest to the goal item in inventory\n  best_actions = None\n  max_inventory_count = 0\n\n  while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      # Check if the goal is satisfied in the current state\n      if current_state.satisfies(\"dummy_goal_name\", item):\n          return actions_taken\n\n      # Create a unique hashable representation of the state to check if it's visited\n      state_representation = (tuple(current_state.grid.flatten()), \n                              tuple(current_state.pos), \n                              current_state.dir)\n      \n      if state_representation not in visited_states:\n          visited_states.add(state_representation)\n\n          # Prioritize actions that involve using items or interacting with the environment\n          prioritized_actions = []\n          other_actions = []\n\n          for action in range(env.world.n_actions):  # Assuming there are n_actions available actions\n              if action == env.world.USE:  # Example of an action code for USE, adjust as necessary\n                  prioritized_actions.append(action)\n              else:\n                  other_actions.append(action)\n\n          all_actions = prioritized_actions + other_actions\n\n          for action in all_actions:\n              reward, new_state = current_state.step(action)\n\n              # Check if the goal is satisfied after the step (early exit)\n              if new_state.satisfies(\"dummy_goal_name\", item):\n                  return actions_taken + [action]\n\n              # Update best actions based on inventory count of the goal item\n              inventory_count = new_state.inventory[item]\n              if inventory_count > max_inventory_count:\n                  max_inventory_count = inventory_count\n                  best_actions = actions_taken + [action]\n\n              state_representation_new = (tuple(new_state.grid.flatten()), \n                                          tuple(new_state.pos), \n                                          new_state.dir)\n              if state_representation_new not in visited_states:\n                  queue.append((new_state, actions_taken + [action]))\n\n  # Return the best actions found or an empty list if no solution was found\n  return best_actions if best_actions else []", "island_id": 4, "scores": {"3": -1}}
