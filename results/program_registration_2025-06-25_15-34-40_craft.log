{"timestamp": "2025-06-26T19:56:35.028044", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from current_state to goal.\"\"\"\n      # Simple heuristic: number of actions taken so far\n      # This can be improved with domain-specific knowledge if needed.\n      return len(current_state.scenario.world.cookbook.primitives_for(goal_item)) - sum(current_state.inventory)\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          # Pre-compute possible actions for efficiency\n          possible_actions = [action for action in range(env.world.n_actions) \n                              if env.world.cookbook.index.get(action) != \"USE\" or current_state.next_to(item)]\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Cost of taking this step is 1\n            \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n      state_hash = (tuple(current_state.grid.flatten()), \n                    tuple(current_state.inventory), \n                    current_state.pos, \n                    current_state.dir)\n      total_path = path\n      while state_hash in came_from:\n          prev_state, prev_path = came_from[state_hash]\n          total_path = prev_path + [total_path[-1]]\n          state_hash = (tuple(prev_state.grid.flatten()), \n                        tuple(prev_state.inventory), \n                        prev_state.pos, \n                        prev_state.dir)\n      return total_path\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T19:58:05.646595", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos, grid_shape):\n      x, y = pos\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      neighbors = []\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              neighbors.append((nx, ny))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Determine the agent's position and grid shape\n          pos = current_state.pos\n          grid_shape = current_state.grid.shape[:2]\n          \n          # Consider moving to adjacent cells or using an item\n          for action in range(env.world.n_actions):\n              if action < 4:  # Movement actions (DOWN, UP, LEFT, RIGHT)\n                  new_pos = get_neighbors(pos, grid_shape)[action % 4]  # Ensure valid index\n                  reward, new_state = current_state.step(action)\n              else:  # USE action\n                  reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T19:58:22.348706", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos, grid_shape):\n      x, y = pos\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      neighbors = []\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              neighbors.append((nx, ny))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Determine the agent's position and grid shape\n          pos = current_state.pos\n          grid_shape = current_state.grid.shape[:2]\n          \n          # Consider moving to adjacent cells or using an item\n          for action in range(env.world.n_actions):\n              if action < 4:  # Movement actions (DOWN, UP, LEFT, RIGHT)\n                  new_pos = get_neighbors(pos, grid_shape)[action % 4]  # Ensure valid index for neighbors\n                  # Check if the movement is valid and within bounds\n                  if 0 <= new_pos[0] < grid_shape[0] and 0 <= new_pos[1] < grid_shape[1]:\n                      reward, new_state = current_state.step(action)\n              else:  # USE action\n                  reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 1.5}}
