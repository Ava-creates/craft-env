goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              else:\n                  # For movement actions, prioritize actions that lead to primitives needed for the goal\n                  if new_state.pos in available_primitives:\n                      primitive_index = [i for i, pos in enumerate(initial_state.world.ordered_contents) if initial_state.world.get(pos) in available_primitives][0]\n                      if current_state.grid[new_state.pos[0], new_state.pos[1], primitive_index] > 0:\n                          queue.appendleft((new_state, path + [action]))\n                          continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T00:55:32.027517", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Get all possible actions for the current state\n          possible_actions = get_all_possible_actions(current_state)\n          \n          for action, new_state in possible_actions:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_all_possible_actions(state):\n      actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          # Check if the new state is different from the current state\n          if not np.array_equal(new_state.grid, state.grid) or\\\n             not np.array_equal(new_state.inventory, state.inventory) or\\\n             new_state.pos != state.pos or\\\n             new_state.dir != state.dir:\n              actions.append((action, new_state))\n      return actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in env.world.cookbook.primitives and goal_item not in env.world.cookbook.recipes:\n      print(f\"Item {goal_item} does not have a recipe or is not a primitive.\")\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      print(\"No valid sequence of actions found to craft the item.\")\n\n  return action_sequence", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-27T00:55:48.869182", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n    x, y = pos\n    neighbors = []\n    if x > 0:\n      neighbors.append((x - 1, y))\n    if x < env.world.grid.shape[0] - 1:\n      neighbors.append((x + 1, y))\n    if y > 0:\n      neighbors.append((x, y - 1))\n    if y < env.world.grid.shape[1] - 1:\n      neighbors.append((x, y + 1))\n    return neighbors\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        possible_actions = get_all_possible_actions(current_state)\n        \n        for action, new_state in possible_actions:\n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def get_all_possible_actions(state):\n      actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          # Check if the new state is different from the current state\n          if not np.array_equal(new_state.grid, state.grid) or\\\n             not np.array_equal(new_state.inventory, state.inventory) or\\\n             new_state.pos != state.pos or\\\n             new_state.dir != state.dir:\n              actions.append((action, new_state))\n      return actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in env.world.cookbook.primitives and goal_item not in env.world.cookbook.recipes:\n      print(f\"Item {goal_item} does not have a recipe or is not a primitive.\")\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      print(\"No valid sequence of actions found to craft the item.\")\n\n  return action_sequence", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-27T00:57:16.967886", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_item):\n      \"\"\"Estimate the cost to reach the goal from the current state.\"\"\"\n      goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n      missing_primitives_cost = sum(\n          max(0, goal_primitives[primitive] - state.inventory[primitive])\n          for primitive in goal_primitives\n      )\n      return missing_primitives_cost\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          # Filter and prioritize actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      possible_actions.append((action, 'use'))\n              else:\n                  possible_actions.append((action, 'move'))\n          \n          # Prioritize USE actions over MOVE actions\n          prioritized_actions = [action for action, _ in sorted(possible_actions, key=lambda x: ('move', 'use').index(x[1]))]\n          \n          for action in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, path + [action])\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
