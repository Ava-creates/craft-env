as per your previous code\n      if use_action in valid_actions:\n          return [use_action] + [action for action in valid_actions if action != use_action]\n      \n      return valid_actions\n\n  def heuristic(state, goal_item):\n      \"\"\"Estimate the number of steps required to reach the goal.\"\"\"\n      # Simple heuristic: count how many ingredients are missing\n      cookbook = state.world.cookbook\n      primitives_needed = cookbook.primitives_for(goal_item)\n      \n      missing_ingredients = 0\n      for prim, count in primitives_needed.items():\n          if state.inventory[prim] < count:\n              missing_ingredients += (count - state.inventory[prim])\n      \n      # Consider the distance to a workshop if 'USE' action is required\n      if any(primitive not in state.world.grabbable_indices for primitive in primitives_needed.keys()):\n          # Find nearest workshop\n          min_distance = float('inf')\n          workshops = state.world.workshop_indices\n          pos_x, pos_y = state.pos\n          \n          for workshop_pos in state.grid[:, :, workshops].nonzero()[0:2]:\n              distance = abs(workshop_pos[0] - pos_x) + abs(workshop_pos[1] - pos_y)\n              min_distance = min(min_distance, distance)\n          \n          missing_ingredients += min_distance\n      \n      return missing_ingredients\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      \n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      came_from = {}\n      \n      while open_set:\n          current_f, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          possible_actions = filter_valid_actions(current_state)\n          \n       