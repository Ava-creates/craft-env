{"timestamp": "2025-06-26T11:52:14.414334", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Heuristic based on the number of items in inventory that are needed for the goal\n      required_items = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = {idx: count for idx, count in enumerate(state.inventory) if count > 0}\n      \n      # Calculate how many primitives are already available\n      available_primitives = sum(min(required_items.get(idx, 0), current_inventory.get(idx, 0)) for idx in required_items)\n      \n      # Return the number of primitives still needed\n      return len(required_items) - available_primitives\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      \n      g_score = {initial_state: 0}\n      came_from = {}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          for action in [4] + list(range(env.world.n_actions))[:-1]:\n              reward, new_state = current_state.step(action)\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1 - reward  # Penalize for not picking up items\n      \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[new_state] = current_state\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n      total_path = []\n      while current_state in came_from:\n          current_state = came_from[current_state]\n          total_path.append(path[len(total_path)])\n      return list(reversed(total_path))\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T11:52:44.742283", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action over movement actions and prioritize actions that lead to pickup or craft progress\n          for action in [4] + list(range(env.world.n_actions))[:-1]:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  \n                  # Give higher priority to actions that lead to pickups or craft progress\n                  if reward > 0 or (new_state.inventory != current_state.inventory).any():\n                      queue.appendleft((new_state, path + [action]))\n                  else:\n                      queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T11:53:31.751666", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize moving to nearby workshops and primitives first\n          prioritize_movement = []\n          prioritize_use = []\n\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n\n                  # Check if new position is near a workshop or primitive\n                  if action < 4:  # Movement actions (DOWN, UP, LEFT, RIGHT)\n                      if any(new_state.grid[x, y] > 0 for x in range(max(0, new_state.pos[0]-1), min(env.world.craft_world.WIDTH, new_state.pos[0]+2))\n                                                    for y in range(max(0, new_state.pos[1]-1), min(env.world.craft_world.HEIGHT, new_state.pos[1]+2))):\n                          prioritize_movement.append((new_state, path + [action]))\n                  else:  # USE action\n                      if any(new_state.grid[x, y] > 0 for x in range(max(0, new_state.pos[0]-1), min(env.world.craft_world.WIDTH, new_state.pos[0]+2))\n                                                    for y in range(max(0, new_state.pos[1]-1), min(env.world.craft_world.HEIGHT, new_state.pos[1]+2))):\n                          prioritize_use.append((new_state, path + [action]))\n\n          # Add prioritized states to the queue first\n          queue.extendleft(reversed(prioritize_movement))\n          queue.extendleft(reversed(prioritize_use))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is valid and has a recipe or is primitive\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item index {goal_item} is not recognized.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": -1}}
