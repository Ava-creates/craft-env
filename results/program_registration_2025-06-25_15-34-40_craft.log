{"timestamp": "2025-06-26T18:23:32.357613", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              # Skip USE action if there's nothing to use in the 3x3 grid around the agent\n              if action == env.world.N_ACTIONS - 1:  # Assuming N_ACTIONS is a constant in CraftWorld\n                  neighborhood = current_state.grid[\n                      max(0, current_state.pos[0]-1):min(env.scenario.init_grid.shape[0], current_state.pos[0]+2),\n                      max(0, current_state.pos[1]-1):min(env.scenario.init_grid.shape[1], current_state.pos[1]+2)\n                  ]\n                  if not any(neighborhood.flatten()):\n                      continue\n              \n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:23:33.349386", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: distance to the nearest required ingredient\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes.get(goal_item)\n      \n      if not recipe:\n          return float('inf')\n      \n      grid = state.grid\n      pos = np.array(state.pos)\n\n      distances = []\n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              continue\n\n          ingredient_positions = np.argwhere(grid[:, :, ingredient] > 0)\n          if len(ingredient_positions) == 0:\n              return float('inf')\n\n          min_distance = min(np.linalg.norm(pos - ing_pos, ord=1) for ing_pos in ingredient_positions)\n          distances.append(min_distance)\n\n      return max(distances) if distances else float('inf')\n  \n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {hash(tuple((initial_state.grid.flatten(), tuple(initial_state.inventory), initial_state.pos, initial_state.dir))): 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              # Skip USE action if there's nothing to use in the 3x3 grid around the agent\n              if action == 4 and not any(current_state.grid[\n                  max(0, current_state.pos[0]-1):min(env.scenario.init_grid.shape[0], current_state.pos[0]+2),\n                  max(0, current_state.pos[1]-1):min(env.scenario.init_grid.shape[1], current_state.pos[1]+2)\n              ].flatten()):\n                  continue\n              \n              reward, new_state = current_state.step(action)\n\n              state_hash = hash(tuple((new_state.grid.flatten(), tuple(new_state.inventory), new_state.pos, new_state.dir)))\n              \n              tentative_g_score = g_score[hash(tuple((current_state.grid.flatten(), tuple(current_state.inventory), current_state.pos, current_state.dir)))] + 1\n\n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (hash(tuple((current_state.grid.flatten(), tuple(current_state.inventory), current_state.pos, current_state.dir))), action)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:24:24.028572", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the environment is reset for a fresh start with a deterministic state\n  env.reset(seed=0)\n\n  # Ensure the goal item is within the cookbook's index range\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item index {goal_item} not found in the cookbook.\")\n      \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 1.5}}
