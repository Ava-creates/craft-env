is action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  action_sequence.append((new_state, path + [action]))\n          \n          # Sort actions by heuristic: prioritize states with more primitive ingredients available\n          action_sequence.sort(key=lambda x: sum(\n              min(x[0].inventory[primitive], goal_primitives.get(primitive, 0)) \n              for primitive in goal_primitives\n          ), reverse=True)\n          \n          queue.extend(action_sequence)\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_actions(action_sequence):\n      optimized_sequence = []\n      i = 0\n      \n      while i < len(action_sequence):\n          current_action = action_sequence[i]\n          \n          if current_action == 4:  # USE action\n              use_count = 1\n              while (i + 1 < len(action_sequence) and \n                     action_sequence[i + 1] == 4):\n                  i += 1\n                  use_count += 1\n              optimized_sequence.append(current_action)\n          else:\n              optimized_sequence.append(current_action)\n          \n          i += 1\n      \n      return optimized_sequence\n\n  def get_available_primitives(state, cookbook):\n      primitives = {}\n      \n      for item_index in range(len(state.inventory)):\n          if state.inventory[item_index] > 0:\n              dfs(item_index, state.inventory[item_index])\n      \n      def dfs(current_index, count):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      return primitives\n\n  def heuristic(state, goal_item, goal_primitives, cookbook):\n      available_primitives = get_available_primitives(state, cookbook)\n      return sum(min(available_primitives.get(primitive, 0), goal_primitives[primitive]) for primitive in goal_primitives)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already in inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      return []\n\n  # Optimize the action sequence by merging consecutive USE actions\n  optimized_action_sequence = optimize_actions(action_sequence)\n  \n  return optimized_action_sequence", "island_id": 5, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T08:51:44.251152", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      seen_primitives = set()  # Track the set of primitives already considered\n      initial_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      while queue:\n          current_state, path = queue.popleft()\n\n          if satisfies_goal(current_state, goal_item):\n              return path\n\n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          # Check if all required primitives are available or can be obtained from the environment\n          if all(primitive in seen_primitives or primitive in current_state.inventory \n                 or (primitive in initial_state.world.environment and current_state.next_to(primitive))\n                 for primitive in initial_primitives):\n              continue  # Skip this state as it doesn't have new information about primitives\n\n          seen_primitives.update(current_state.inventory)\n\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              possible_actions.append((new_state, action))\n          \n          sorted_possible_actions = sorted(\n              possible_actions,\n              key=lambda x: (\n                  -sum(new_state.inventory[primitive] > 0 for primitive in goal_primitives),  # More primitives used first\n                  sum(current_state.next_to(primitive) for primitive in goal_primitives),    # Closer to ingredients first\n                  len([ingredient for ingredient, count in goal_primitives.items() if new_state.inventory[ingredient] < count]) # Fewer missing primitives first\n              )\n          )\n\n          for new_state, action in sorted_possible_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item can be crafted or obtained from the environment\n  if goal_item not in initial_state.world.cookbook.recipes and goal_item not in initial_state.world.cookbook.primitives:\n      return []  # Return empty list if the goal item is neither a primitive nor can it be crafted\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-27T08:51:55.151512", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              possible_actions.append((new_state, action))\n          \n          # Prioritize actions that use resources needed for the goal and move closer to required ingredients\n          sorted_possible_actions = sorted(\n              possible_actions,\n              key=lambda x: (\n                  -sum(new_state.inventory[primitive] > 0 for primitive in goal_primitives),  # More primitives used first\n                  sum(current_state.next_to(primitive) for primitive in goal_primitives),   # Closer to ingredients first\n                  len([ingredient for ingredient, count in goal_primitives.items() if new_state.inventory[ingredient] < count])  # Fewer missing primitives first\n              )\n          )\n          \n          for new_state, action in sorted_possible_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item can be crafted or is a primitive\n  if goal_item not in initial_state.world.cookbook.recipes and goal_item not in initial_state.world.cookbook.primitives:\n      return []  # Return empty list if the goal item is neither a primitive nor can it be crafted\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T08:53:51.314231", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def get_closest_resource(state, resource_index):\n      \"\"\"Find the closest resource of a given type using BFS.\"\"\"\n      from collections import deque\n      \n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      queue = deque([(state.pos, [])])\n      visited = set([state.pos])\n      \n      while queue:\n          current_pos, path = queue.popleft()\n          \n          if state.grid[current_pos[0], current_pos[1], resource_index] > 0:\n              return path\n          \n          for d in directions:\n              new_pos = (current_pos[0] + d[0], current_pos[1] + d[1])\n              \n              if (0 <= new_pos[0] < state.grid.shape[0] and \n                  0 <= new_pos[1] < state.grid.shape[1] and \n                  new_pos not in visited):\n                  visited.add(new_pos)\n                  queue.append((new_pos, path + [move_towards(state.pos, new_pos)]))\n      \n      return None\n\n  def move_towards(current_pos, target_pos) -> int:\n      \"\"\"Determine the action to move towards the target position.\"\"\"\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      \n      if abs(dx) > abs(dy):\n          return 2 if dx < 0 else 3\n      else:\n          return 0 if dy < 0 else 1\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          for resource_index in goal_primitives.keys():\n              # Find the closest resource\n              resource_path = get_closest_resource(current_state, resource_index)\n              if resource_path:\n                  new_state = current_state\n                  for action in resource_path:\n                      reward, new_state = new_state.step(action)\n                  \n                  # Collect and use the resource to make progress towards the goal item\n                  if satisfies_goal(new_state, goal_item):\n                      return path + resource_path\n                  \n                  queue.append((new_state, path + resource_path))\n      \n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue\n      \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []", "island_id": 4, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T08:54:02.123861", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def get_closest_resource(state, resource_indices):\n      \"\"\"Find the closest resource of any given type using BFS.\"\"\"\n      from collections import deque\n      \n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      queue = deque([(state.pos, [])])\n      visited = set([state.pos])\n      \n      while queue:\n          current_pos, path = queue.popleft()\n          \n          if any(state.grid[current_pos[0], current_pos[1], resource_index] > 0 for resource_index in resource_indices):\n              return path\n          \n          for d in directions:\n              new_pos = (current_pos[0] + d[0], current_pos[1] + d[1])\n              \n              if (0 <= new_pos[0] < state.grid.shape[0] and \n                  0 <= new_pos[1] < state.grid.shape[1] and \n                  new_pos not in visited):\n                  visited.add(new_pos)\n                  queue.append((new_pos, path + [move_towards(state.pos, new_pos)]))\n      \n      return None\n\n  def move_towards(current_pos, target_pos) -> int:\n      \"\"\"Determine the action to move towards the target position.\"\"\"\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      \n      if abs(dx) > abs(dy):\n          return 2 if dx < 0 else 3\n      else:\n          return 0 if dy < 0 else 1\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available in inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T08:55:46.920499", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n\n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n\n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_primitives):\n      \"\"\"Estimate the cost to reach the goal based on missing primitives.\"\"\"\n      current_inventory = state.inventory\n      missing_count = sum(max(0, required - current_inventory[primitive]) for primitive, required in goal_primitives.items())\n      return missing_count * 2  # Penalize twice as much as a single action\n\n  initial_state = env._current_state\n  goal_item = item\n  goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_primitives), initial_state, []))\n      \n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + initial_state.pos + (initial_state.dir,): 0}\n      f_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + initial_state.pos + (initial_state.dir,): heuristic(initial_state, goal_primitives)}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n\n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + current_state.pos + (current_state.dir,)] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (tuple(current_state.grid.flatten()), \n                                          tuple(current_state.inventory), \n                                          current_state.pos, \n                                          current_state.dir)\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state, goal_primitives)\n                  heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
