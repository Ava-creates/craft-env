{"timestamp": "2025-06-26T03:58:45.073053", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n    valid_actions = []\n    \n    # Prioritize the USE action\n    reward, new_state = state.step(4)\n    if new_state != state:\n      valid_actions.append(4)\n    \n    for action in range(4):  # MOVEMENT ACTIONS: DOWN, UP, LEFT, RIGHT\n      reward, new_state = state.step(action)\n      if new_state != state:\n        valid_actions.append(action)\n    \n    return valid_actions\n\n  def heuristic(state, goal_item):\n    \"\"\"Heuristic function to estimate the cost from current state to goal.\"\"\"\n    # Simple heuristic: prioritize states with more items in inventory\n    return -state.inventory[goal_item]\n\n  def astar_search(initial_state, goal_item):\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, initial_state, []))  # Priority queue of tuples (f_score, state, path)\n    \n    g_scores = {hashable_state(initial_state): 0}\n    f_scores = {hashable_state(initial_state): heuristic(initial_state, goal_item)}\n    came_from = {}\n    \n    while open_set:\n      _, current_state, path = heapq.heappop(open_set)\n      \n      if satisfies_goal(current_state, goal_item):\n        return reconstruct_path(came_from, current_state, path)\n      \n      for action in get_valid_actions(current_state):\n        reward, new_state = current_state.step(action)\n        \n        if new_state == current_state:  # Skip invalid moves\n          continue\n        \n        tentative_g_score = g_scores[hashable_state(current_state)] + 1  # Cost is always 1 for a move\n        \n        state_hash = hashable_state(new_state)\n        \n        if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n          came_from[new_state] = current_state\n          g_scores[state_hash] = tentative_g_score\n          f_scores[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n          heapq.heappush(open_set, (f_scores[state_hash], new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def hashable_state(state):\n    \"\"\"Convert the state to a hashable form.\"\"\"\n    return tuple([\n        tuple(state.grid.flatten()), \n        tuple(state.inventory), \n        state.pos, \n        state.dir\n    ])\n\n  def reconstruct_path(came_from, current_state, path):\n    \"\"\"Reconstructs the path from start to goal.\"\"\"\n    total_path = path\n    while current_state in came_from:\n      current_state = came_from[current_state]\n      total_path.insert(0, action_taken(current_state, came_from[current_state]))\n    return total_path\n\n  def action_taken(from_state, to_state):\n    \"\"\"Determine the action taken from one state to another.\"\"\"\n    for action in range(5):  # All possible actions: DOWN, UP, LEFT, RIGHT, USE\n      reward, new_state = from_state.step(action)\n      if new_state == to_state:\n        return action\n    raise ValueError(\"No valid action found between states\")\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # If the item is already in the inventory, return an empty list of actions\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = astar_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
