step(action)\n              action_sequence.append(action)\n      \n      return initial_state, action_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the environment is already at a satisfied state for the goal item\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Identify required primitives for the goal item\n  required_primitives = env.world.cookbook.primitives_for(goal_item)\n  \n  # Gather required primitives/resources first\n  initial_state, action_sequence_gathering = gather_primitives(env, initial_state, required_primitives)\n  \n  # After gathering primitives, try to find a path to the goal item\n  action_sequence_crafting = bfs_search(initial_state, goal_item)\n\n  if action_sequence_crafting:\n      return action_sequence_gathering + action_sequence_crafting\n\n  print(\"Unable to craft the goal item after gathering primitives.\")\n  return []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:34:05.697640", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_requirements(cookbook, goal_item, inventory):\n      \"\"\"Recursively calculate the primitive requirements for crafting a goal item.\"\"\"\n      if inventory[goal_item] >= 1:\n          return {}\n      \n      recipe = cookbook.recipes.get(goal_item)\n      if not recipe:\n          return {}  # No recipe for this item\n      \n      total_requirements = {}\n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              continue\n          \n          needed_count = max(count - inventory[ingredient], 0)\n          ingredient_requirements = get_primitive_requirements(cookbook, ingredient, inventory)\n          \n          # Aggregate requirements\n          for primitive, req_count in ingredient_requirements.items():\n              total_requirements[primitive] = total_requirements.get(primitive, 0) + (req_count * needed_count)\n      \n      return total_requirements\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Get primitive requirements for the goal item based on the current inventory\n          primitive_requirements = get_primitive_requirements(env.world.cookbook, goal_item, current_state.inventory)\n          \n          action_priority = [4] + list(range(4))  # Use action first, then move directions\n          \n          for action in action_priority:\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:34:06.672147", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from current state to goal.\"\"\"\n      # Simple heuristic: number of items needed for the goal\n      primitives_needed = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory\n      return sum(max(0, primitives_needed.get(primitive, 0) - current_inventory[primitive]) for primitive in primitives_needed)\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      \n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      came_from = {}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state)\n          \n          action_priority = [4] + list(range(4))  # Use action first, then move directions\n          \n          for action in action_priority:\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming all actions have a cost of 1\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = current_state, action\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state):\n      total_path = []\n      while current_state in came_from:\n          previous_state, action = came_from[current_state]\n          total_path.append(action)\n          current_state = previous_state\n      return list(reversed(total_path))  # Return the path in correct order\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:34:54.712787", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of items needed to craft the goal\n      required_items = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory\n      return sum(required_items.get(i, 0) - current_inventory[i] for i in required_items)\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), 0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_cost, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each action has cost 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score[new_state], tentative_g_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:34:55.695862", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic: return 0 if the current state already has the goal item\n      return 0 if current_state.inventory[goal_item] > 0 else 1\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:36:04.890797", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      \"\"\"Estimate the cost to reach the goal using a simple heuristic.\"\"\"\n      # Heuristic: prioritize states with more inventory items towards the goal\n      return -np.sum([state.inventory[i] for i in env.world.cookbook.primitives_for(goal_item)])\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue to store (estimated_total_cost, cost_so_far, path, state)\n      queue = []\n      start_cost = 0\n      start_path = []\n      start_hash = (tuple(initial_state.grid.flatten()), \n                    tuple(initial_state.inventory), \n                    initial_state.pos, \n                    initial_state.dir)\n      \n      heapq.heappush(queue, (heuristic(initial_state, goal_item), start_cost, start_path, initial_state))\n      visited = set([start_hash])\n      \n      while queue:\n          _, current_cost, path, current_state = heapq.heappop(queue)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n\n                  # Calculate cost for the next state\n                  new_cost = current_cost + 1\n\n                  # Heuristic: prioritize actions that increase inventory counts towards the goal\n                  h = heuristic(new_state, goal_item)\n                  \n                  new_path = path + [action]\n                  heapq.heappush(queue, (new_cost + h, new_cost, new_path, new_state))\n\n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T15:36:15.046252", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(new_state, goal_item):\n      # Reward states that increase the count of the goal item in inventory\n      return -new_state.inventory[goal_item]\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue to store (cost, path, state)\n      queue = []\n      start_cost = 0\n      start_path = []\n      start_hash = (tuple(initial_state.grid.flatten()), \n                    tuple(initial_state.inventory), \n                    initial_state.pos, \n                    initial_state.dir)\n      \n      heapq.heappush(queue, (start_cost, start_path, initial_state))\n      visited = set([start_hash])\n      \n      while queue:\n          current_cost, path, current_state = heapq.heappop(queue)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n\n                  cost = current_cost + 1  # Cost for each action is the same\n\n                  # Calculate heuristic based on inventory counts towards the goal\n                  heur_value = heuristic(new_state, goal_item)\n\n                  new_path = path + [action]\n                  heapq.heappush(queue, (cost + heur_value, new_path, new_state))\n\n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T15:37:15.021994", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_path(path):\n      \"\"\"Optimizes the given path by removing unnecessary movements.\"\"\"\n      optimized_path = []\n      for i in range(len(path)):\n          action = path[i]\n          if i < len(path) - 1:\n              next_action = path[i + 1]\n              \n              # Combine consecutive opposite moves\n              if (action == 0 and next_action == 1) or (action == 1 and next_action == 0):\n                  continue\n              elif (action == 2 and next_action == 3) or (action == 3 and next_action == 2):\n                  continue\n              \n          optimized_path.append(action)\n      return optimized_path\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n      action_sequence = optimize_path(action_sequence)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T15:37:16.010180", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic based on the count of the goal item in the inventory\n      # Higher counts indicate closer to achieving the goal\n      return -current_state.inventory[goal_item]\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          current_fscore, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assume each action has cost 1\n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, path + [action])\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:38:31.564547", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def is_workshop(pos):\n      x, y = pos\n      return env.world.workshop_indices[x, y]\n\n  def heuristic(current_pos, goal_item):\n      # Simple Manhattan distance to nearest workshop that has the required item\n      min_distance = float('inf')\n      for x in range(env.world.grid.shape[0]):\n          for y in range(env.world.grid.shape[1]):\n              if is_workshop((x, y)):\n                  distance = abs(x - current_pos[0]) + abs(y - current_pos[1])\n                  min_distance = min(min_distance, distance)\n      return min_distance\n\n  def get_all_possible_actions(state):\n      actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          # Check if the state has changed\n          if not np.array_equal(new_state.grid, state.grid) or\\\n             not np.array_equal(new_state.inventory, state.inventory) or\\\n             new_state.pos != state.pos or\\\n             new_state.dir != state.dir:\n              actions.append((action, new_state))\n      return actions\n\n  def a_star_search(initial_state, goal_item):\n      from collections import deque\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))  # Priority queue based on f-score\n      came_from = {}\n      \n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state.pos, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, new_state in get_all_possible_actions(current_state):\n              tentative_g_score = g_score[current_state] + 1  # Cost of each step is 1\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if tentative_g_score < g_score.get(state_hash, float('inf')):\n                  came_from[state_hash] = (current_state, action)\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state.pos, goal_item)\n                  heapq.heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already in inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
