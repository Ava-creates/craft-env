ive not found\n          elif current_item in env.world.cookbook.recipes:\n              recipe = env.world.cookbook.recipes[current_item]\n              for ingredient, count in recipe.items():\n                  if ingredient != \"_key\":\n                      while inventory[ingredient] < count:\n                          actions.extend(plan_crafting(ingredient))\n                          # After crafting the ingredient, pick it up\n                          path = bfs_find_path(env._current_state.grid, env._current_state.pos, ingredient)\n                          if path is not None:\n                              actions.extend(path)\n                              actions.append(4)  # USE to pick up the item\n                              inventory[ingredient] += 1\n                      inventory[ingredient] -= count  # Use the ingredient in the recipe\n      \n              # Craft the current item\n              actions.append(4)  # USE to craft the item\n      \n      return actions\n\n  action_sequence = plan_crafting(item)\n  return action_sequence", "island_id": 9, "scores": {"3": -1}}
