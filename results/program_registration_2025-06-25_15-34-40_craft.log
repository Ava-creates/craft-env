return primitive_actions\n\n  def craft_item(env, initial_state, goal_item):\n      \"\"\"Craft the item using gathered primitives.\"\"\"\n      # Attempt to find a direct path first\n      action_sequence = bfs_search(initial_state, goal_item)\n\n      if not action_sequence:\n          # Fallback: Try to gather prerequisites\n          primitive_actions = gather_primitives(env, initial_state, goal_item)\n          \n          if not primitive_actions:\n              return None  # Cannot craft the item\n      \n          new_initial_state = initial_state\n          for action in primitive_actions:\n              _, new_initial_state = new_initial_state.step(action)\n          \n          final_sequence = bfs_search(new_initial_state, goal_item)\n          \n          if final_sequence:\n              action_sequence = primitive_actions + final_sequence\n          else:\n              return None  # Cannot craft the item after gathering primitives\n      \n      return action_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = craft_item(env, initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T01:03:27.867298", "function_name": "craft", "function_body": "  def bfs_paths(starts, goal):\n    queue = [(start, []) for start in starts]\n    visited = set()\n    while queue:\n        (node, path) = queue.pop(0)\n        if node not in visited:\n            neighbors = get_neighbors(node)\n            for neighbor in neighbors:\n                new_path = path + [neighbor]\n                if neighbor == goal:\n                    return new_path\n                else:\n                    queue.append((new_path[-1], new_path))\n            visited.add(node)\n    return None\n\n  def get_neighbors(node):\n      # Get all recipes with `node` as an ingredient\n      neighbors = []\n      for output, ingredients in env.world.cookbook.recipes.items():\n          if node in ingredients:\n              neighbors.append(output)\n      return neighbors\n\n  def actions_to_reach_goal(path):\n      actions = []\n      current_state = CraftState(scenario=env.scenario, grid=np.copy(env.scenario.init_grid), pos=tuple(env.scenario.init_pos), dir=0, inventory=np.zeros(env.world.n_kinds, dtype=int))\n      \n      for i in range(len(path) - 1):\n          current_node = path[i]\n          next_node = path[i + 1]\n          \n          # Find recipe that produces `next_node` using `current_node`\n          for output, ingredients in env.world.cookbook.recipes.items():\n              if output == next_node:\n                  # Gather required ingredients\n                  for ingredient, count in ingredients.items():\n                      if ingredient != \"_key\":\n                          while current_state.inventory[ingredient] < count:\n                              actions.extend(gather(current_state, ingredient))\n                              current_state = step_and_update(env, current_state, actions[-1])\n                          \n                          # Subtract the used ingredients from inventory\n                          current_state.inventory[ingredient] -= count\n                  \n                  # Craft the item (USE action)\n                  actions.append(USE)  # Assuming USE action to craft\n                  current_state.inventory[next_node] += 1\n      \n      return actions\n\n  def gather(current_state, ingredient):\n      \"\"\"Generate actions to gather an ingredient from the grid.\"\"\"\n      actions = []\n      pos_to_ingredient = find_item_positions(current_state.grid, ingredient)\n      \n      for pos in pos_to_ingredient:\n          x, y = pos\n          while current_state.pos != (x, y):\n              move_action = move_towards(current_state, x, y)\n              actions.append(move_action)\n              current_state = step_and_update(env, current_state, move_action)\n          \n          # Once at the ingredient's position, use it\n          actions.append(USE)  # Assuming USE action to gather\n          current_state.inventory[ingredient] += 1\n      \n      return actions\n\n  def find_item_positions(grid, item):\n      \"\"\"Find all positions of an item in the grid.\"\"\"\n      positions = []\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if np.argmax(grid[x, y]) == item:\n                  positions.append((x, y))\n      return positions\n\n  def move_towards(current_state, target_x, target_y):\n      \"\"\"Generate a move action to get closer to the target position.\"\"\"\n      current_x, current_y = current_state.pos\n      if current_x < target_x:\n          return RIGHT\n      elif current_x > target_x:\n          return LEFT\n      elif current_y < target_y:\n          return DOWN\n      else:\n          return UP\n\n  def step_and_update(env, state, action):\n      \"\"\"Take a step in the environment and update the state.\"\"\"\n      reward, new_state = state.step(action)\n      return new_state\n\n  # Constants for actions\n  LEFT = 2\n  RIGHT = 3\n  DOWN = 0\n  UP = 1\n  USE = 4\n  \n  # Start from the desired item (goal) and perform BFS to find the path back to primitives\n  goal = item\n  starts = list(env.world.cookbook.primitives)  # Use all primitives as starting points\n  path = bfs_paths(starts, goal)\n  \n  if path:\n      actions = actions_to_reach_goal(path[::-1])  # Reverse the path to go from primitives to goal\n  else:\n      actions = []\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T01:03:28.857578", "function_name": "craft", "function_body": "  def bfs_paths(starts, goal):\n    queue = [(start, []) for start in starts]\n    visited = set()\n    while queue:\n        (node, path) = queue.pop(0)\n        if node not in visited:\n            neighbors = get_neighbors(node)\n            for neighbor in neighbors:\n                new_path = path + [neighbor]\n                if neighbor == goal:\n                    return new_path\n                else:\n                    queue.append((neighbor, new_path))\n            visited.add(node)\n    return None\n\n  def get_neighbors(node):\n      # Get all recipes with `node` as an ingredient\n      neighbors = []\n      for output, ingredients in env.world.cookbook.recipes.items():\n          if node in ingredients and output not in path:\n              neighbors.append(output)\n      return neighbors\n\n  def gather(current_state, ingredient):\n      \"\"\"Generate actions to gather an ingredient from the grid.\"\"\"\n      actions = []\n      pos_to_ingredient = find_item_positions(current_state.grid, ingredient)\n      \n      for pos in pos_to_ingredient:\n          x, y = pos\n          while current_state.pos != (x, y):\n              move_action = move_towards(current_state, x, y)\n              actions.append(move_action)\n              current_state = step_and_update(env, current_state, move_action)\n          \n          # Once at the ingredient's position, use it\n          actions.append(USE)  # Assuming USE action to gather\n          current_state.inventory[ingredient] += 1\n      \n      return actions\n\n  def find_item_positions(grid, item):\n      \"\"\"Find all positions of an item in the grid.\"\"\"\n      positions = []\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if np.argmax(grid[x, y]) == item:\n                  positions.append((x, y))\n      return positions\n\n  def move_towards(current_state, target_x, target_y):\n      \"\"\"Generate a move action to get closer to the target position.\"\"\"\n      current_x, current_y = current_state.pos\n      direction = None\n      \n      if current_x < target_x and not is_blocked(current_state.grid, current_x + 1, current_y):\n          direction = RIGHT\n      elif current_x > target_x and not is_blocked(current_state.grid, current_x - 1, current_y):\n          direction = LEFT\n      elif current_y < target_y and not is_blocked(current_state.grid, current_x, current_y + 1):\n          direction = DOWN\n      elif current_y > target_y and not is_blocked(current_state.grid, current_x, current_y - 1):\n          direction = UP\n      \n      return direction\n\n  def is_blocked(grid, x, y):\n      \"\"\"Check if a cell is blocked (e.g., by an obstacle).\"\"\"\n      # For simplicity, assume any non-zero cell is an obstacle\n      return np.sum(grid[x, y]) > 0 and np.argmax(grid[x, y]) not in env.world.cookbook.primitives\n\n  def step_and_update(env, state, action):\n      \"\"\"Take a step in the environment and update the state.\"\"\"\n      reward, new_state = state.step(action)\n      return new_state\n\n  # Constants for actions\n  LEFT = 2\n  RIGHT = 3\n  DOWN = 0\n  UP = 1\n  USE = 4\n  \n  # Start from the desired item (goal) and perform BFS to find the path back to primitives\n  goal = item\n  starts = list(env.world.cookbook.primitives)\n  path = bfs_paths(starts, goal)\n\n  if path:\n      actions = []\n      current_state = CraftState(scenario=env.scenario, grid=np.copy(env.scenario.init_grid), pos=tuple(env.scenario.init_pos), dir=0, inventory=np.zeros(env.world.n_kinds, dtype=int))\n      \n      for i in range(len(path) - 1):\n          current_node = path[i]\n          next_node = path[i + 1]\n          \n          # Find recipe that produces `next_node` using `current_node`\n          for output, ingredients in env.world.cookbook.recipes.items():\n              if output == next_node:\n                  # Gather required ingredients\n                  for ingredient, count in ingredients.items():\n                      if ingredient != \"_key\":\n                          while current_state.inventory[ingredient] < count:\n                              actions.extend(gather(current_state, ingredient))\n                              current_state = step_and_update(env, current_state, actions[-1])\n                          \n                          # Subtract the used ingredients from inventory\n                          current_state.inventory[ingredient] -= count\n                  \n                  # Craft the item (USE action)\n                  actions.append(USE)  # Assuming USE action to craft\n                  current_state.inventory[next_node] += 1\n      \n      return actions\n  else:\n      return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T01:04:45.851196", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      \n      # Check USE action\n      reward, new_state = state.step(4)\n      if new_state != state:\n          valid_actions.append(4)\n      \n      # Check movement actions (DOWN, UP, LEFT, RIGHT)\n      for action in range(4):\n          reward, new_state = state.step(action)\n          if new_state != state:\n              valid_actions.append(action)\n      \n      return valid_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Get valid actions and prioritize USE action if it leads to a new state\n          for action in get_valid_actions(current_state):\n              reward, new_state = current_state.step(action)\n              \n              if new_state == current_state:  # Skip invalid moves (e.g., moving into walls or using an empty inventory)\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # If the item is already in the inventory, return an empty list of actions\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T01:04:46.858929", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      \n      # Check USE action\n      reward, new_state = state.step(4)\n      if new_state != state:\n          valid_actions.append(4)\n      \n      # Check movement actions (DOWN, UP, LEFT, RIGHT)\n      for action in range(4):\n          reward, new_state = state.step(action)\n          if new_state != state:\n              valid_actions.append(action)\n      \n      return valid_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Get valid actions and prioritize USE action\n          for action in get_valid_actions(current_state):\n              reward, new_state = current_state.step(action)\n              \n              if new_state == current_state:  # Skip invalid moves (e.g., moving into walls or using an empty inventory)\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            current_state.pos, \n                            current_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # If the item is already in the inventory, return an empty list of actions\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-06-26T01:05:40.194149", "function_name": "craft", "function_body": "  def _is_valid_position(pos):\n    x, y = pos\n    return 0 <= x < env.world.scenario.grid.shape[0] and 0 <= y < env.world.scenario.grid.shape[1]\n\n  def _get_neighbors(pos):\n    x, y = pos\n    return [(x + dx, y + dy) for dx in (-1, 0, 1) for dy in (-1, 0, 1)]\n\n  def _next_to(pos, i_kind):\n    return any(env._current_state.grid[nx, ny, i_kind] > 0 for nx, ny in _get_neighbors(pos))\n\n  goal_name, goal_arg = \"craft\", item\n  inventory = env._current_state.inventory.copy()\n  action_sequence = []\n  \n  # Check if the goal is already satisfied\n  if env._current_state.satisfies(goal_name, goal_arg):\n    return action_sequence\n\n  primitives_needed = env.world.cookbook.primitives_for(item)\n  for primitive_index, count in primitives_needed.items():\n    while inventory[primitive_index] < count:\n      # Find a nearby source of the primitive\n      found_source = False\n      for dx in range(-5, 6):\n        for dy in range(-5, 6):\n          neighbor_pos = (env._current_state.pos[0] + dx, env._current_state.pos[1] + dy)\n          if _is_valid_position(neighbor_pos) and env._current_state.grid[neighbor_pos].argmax() == primitive_index:\n            path_to_primitive = a_star(env._current_state.pos, neighbor_pos)\n            action_sequence.extend(path_to_primitive)\n            action_sequence.append(4)  # USE to pick up the primitive\n            found_source = True\n            inventory[primitive_index] += 1\n            break\n        if found_source:\n          break\n      if not found_source:\n        raise ValueError(f\"Primitive {primitive_index} is not available in the environment.\")\n\n  while not env._current_state.satisfies(goal_name, goal_arg):\n    # Use a simple heuristic to find the nearest workshop for crafting\n    nearest_workshop = None\n    min_distance = float('inf')\n    for workshop_pos in env.world.workshop_indices:\n      distance = abs(workshop_pos[0] - env._current_state.pos[0]) + abs(workshop_pos[1] - env._current_state.pos[1])\n      if distance < min_distance:\n        nearest_workshop = workshop_pos\n        min_distance = distance\n\n    path_to_workshop = a_star(env._current_state.pos, nearest_workshop)\n    action_sequence.extend(path_to_workshop)\n\n    # Craft the item at the workshop\n    action_sequence.append(4)  # USE to craft the item\n\n  return action_sequence", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T01:06:10.208510", "function_name": "craft", "function_body": "  # Extracting relevant information from the environment and cookbook\n  cookbook = env.world.cookbook\n  primitives = cookbook.primitives_for(item)\n  inventory = env._current_state.inventory.copy()\n  \n  def get_primitives_needed(primitive_dict, inventory):\n    return {i: count - inventory[i] for i, count in primitive_dict.items() if inventory[i] < count}\n  \n  # Calculate the primitives needed\n  primitives_needed = get_primitives_needed(primitives, inventory)\n\n  actions = []\n  \n  # Collecting primitives\n  for item_index, count in primitives_needed.items():\n    while inventory[item_index] < count:\n      # Simulate picking up the primitive (This is a simplified action and might need more detailed logic)\n      pos = env._current_state.pos\n      grid = env._current_state.grid\n\n      # Find nearest position with the required item\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_pos = (pos[0] + dx, pos[1] + dy)\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n          if grid[new_pos][item_index] > 0:\n            actions.append(env.world.random.choice([env.ACTION_LEFT, env.ACTION_RIGHT, env.ACTION_UP, env.ACTION_DOWN])) # Move towards the item\n            actions.append(env.ACTION_USE) # Pick up the item\n            inventory[item_index] += 1\n            break\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T01:08:13.061498", "function_name": "craft", "function_body": "  def bfs(start_item, goal_item):\n    queue = [(start_item, [])]\n    visited = set()\n    \n    while queue:\n        current_item, path = queue.pop(0)\n        if current_item == goal_item:\n            return path + [goal_item]\n        \n        if current_item in visited:\n            continue\n        \n        visited.add(current_item)\n        \n        # Find all the ingredients that can be crafted to reach the current item\n        for ingredient_index, count in env.world.cookbook.primitives_for(current_item).items():\n            queue.append((ingredient_index, path + [current_item]))\n    \n    return None  # If no path is found\n\n  def move_to_ingredient(env, ingredient_index):\n    \"\"\"Helper function to generate a sequence of actions to move to an ingredient.\"\"\"\n    # Find all positions of the ingredient in the grid\n    pos = np.argwhere(env._current_state.grid[:, :, ingredient_index] > 0)\n    \n    if len(pos) == 0:\n        return []  # Ingredient not found\n    \n    moves = []\n    for x, y in pos:\n        # Move to the position of the ingredient\n        moves.extend(move_to(x, y))\n        \n        # Pick up the ingredient\n        moves.append(USE)\n        \n        # Check if we have enough ingredients in inventory\n        if env._current_state.inventory[ingredient_index] >= env.world.cookbook.primitives_for(item)[ingredient_index]:\n            break\n    \n    return moves\n  \n  def move_to(x: int, y: int) -> list[int]:\n    \"\"\"Helper function to generate a sequence of actions to move to a given position.\"\"\"\n    current_x, current_y = env._current_state.pos\n    dx = x - current_x\n    dy = y - current_y\n    \n    moves = []\n    \n    # Move vertically\n    if dy > 0:\n        moves.extend([DOWN] * abs(dy))\n    elif dy < 0:\n        moves.extend([UP] * abs(dy))\n        \n    # Move horizontally\n    if dx > 0:\n        moves.extend([RIGHT] * abs(dx))\n    elif dx < 0:\n        moves.extend([LEFT] * abs(dx))\n    \n    return moves\n\n  \n  def find_workshop():\n      \"\"\"Helper function to find the position of a workshop.\"\"\"\n      pos = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] > 0)\n      if len(pos) == 0:\n          return None\n      return tuple(pos[0])\n  \n  def move_to_workshop():\n      \"\"\"Helper function to generate a sequence of actions to move to the nearest workshop.\"\"\"\n      workshop_pos = find_workshop()\n      if not workshop_pos:\n          return []\n      \n      x, y = workshop_pos\n      \n      # Move to the workshop\n      return move_to(x, y) + [USE]\n  \n  DOWN, UP, LEFT, RIGHT, USE, CRAFT = 0, 1, 2, 3, 4, 5\n\n  def gather_ingredients(env, goal_item):\n    \"\"\"Helper function to gather all ingredients needed to craft the goal item.\"\"\"\n    required_ingredients = env.world.cookbook.primitives_for(goal_item)\n    actions = []\n    \n    for ingredient_index, count in required_ingredients.items():\n        if not env._current_state.inventory[ingredient_index]:\n            # If the ingredient is not in the inventory, move to collect it\n            actions.extend(move_to_ingredient(env, ingredient_index))\n        \n        # Use the ingredient from the inventory\n        actions.append(USE)\n    \n    return actions\n\n  start_item = env._current_state.scenario.init_pos\n  goal_item = item\n  \n  path = bfs(start_item, goal_item)\n  \n  if not path:\n      return []  # Return an empty list if the goal cannot be crafted\n\n  actions = []\n  \n  for step in range(len(path) - 1):\n      current_item = path[step]\n      next_item = path[step + 1]\n\n      # Collect all ingredients needed to craft the next item\n      actions.extend(gather_ingredients(env, next_item))\n      \n      # Move to a workshop and use it to craft the next item\n      actions.extend(move_to_workshop())\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
