{"timestamp": "2025-06-26T16:07:48.290826", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of items needed to craft the goal\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory\n      missing_items_count = sum(max(0, count - current_inventory[idx]) for idx, count in primitives.items())\n      return missing_items_count\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that involve using items (action == USE)\n          use_actions = [action for action in range(env.world.n_actions) if action == 4]\n          other_actions = [action for action in range(env.world.n_actions) if action != 4]\n          \n          all_actions = use_actions + other_actions\n          \n          for action in all_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assume each action costs 1 for now\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Reset the environment to ensure a clean starting point\n  env.reset()\n  \n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:07:49.310646", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue for A* search\n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      \n      # Set to keep track of visited states\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Convert the current state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(current_state.grid.flatten()), \n                        tuple(current_state.inventory), \n                        current_state.pos, \n                        current_state.dir)\n          \n          visited.add(state_hash)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              new_state_hash = (tuple(new_state.grid.flatten()), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir)\n              \n              if new_state_hash not in visited:\n                  # Calculate the cost and heuristic for A* search\n                  cost = len(path) + 1  # Cost is the number of actions taken so far\n                  heuristic = estimate_heuristic(new_state, goal_item)\n                  \n                  heapq.heappush(open_set, (cost + heuristic, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def estimate_heuristic(state, goal_item):\n      # Simple heuristic: count the number of items needed for the goal item\n      cookbook = env.world.cookbook\n      primitives = cookbook.primitives_for(goal_item)\n      inventory = state.inventory\n      \n      heuristic_cost = 0\n      for primitive, required_count in primitives.items():\n          current_count = inventory[primitive]\n          if current_count < required_count:\n              heuristic_cost += (required_count - current_count)\n      \n      return heuristic_cost\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Reset the environment to ensure a clean starting point\n  env.reset()\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:08:56.515616", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          # Skip USE action if there's nothing to use in the 3x3 grid around the agent\n          if action == 4:\n              x, y = state.pos\n              neighborhood = state.grid[max(0, x-1):min(state.scenario.init_grid.shape[0], x+2),\n                                         max(0, y-1):min(state.scenario.init_grid.shape[1], y+2)]\n              if not any(neighborhood.flatten()):\n                  continue\n          valid_actions.append(action)\n      return valid_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in get_valid_actions(current_state):\n              \n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T16:08:57.489094", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          if action == 4:  # USE action\n              # Check if there's something to use in the 3x3 grid around the agent\n              surrounding_grid = state.grid[\n                  max(0, state.pos[0]-1):min(state.scenario.init_grid.shape[0], state.pos[0]+2),\n                  max(0, state.pos[1]-1):min(env.scenario.init_grid.shape[1], state.pos[1]+2)\n              ]\n              if not any(surrounding_grid.flatten()):\n                  continue\n          valid_actions.append(action)\n      return valid_actions\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: count the number of primitives needed to craft the goal item\n      cookbook = env.world.cookbook\n      if goal_item in cookbook.primitives:\n          return 0\n      elif goal_item not in cookbook.recipes:\n          return float('inf')\n      \n      recipe = cookbook.recipes[goal_item]\n      primitive_count = 0\n      \n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              continue\n          if ingredient in cookbook.primitives:\n              primitive_count += count\n          else:\n              primitive_count += heuristic(state, ingredient) * count\n      return primitive_count\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      \n      while open_set:\n          f_score, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in get_valid_actions(current_state):\n              \n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  g_score = len(path) + 1\n                  f_score = g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:10:23.805767", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def is_workshop(pos):\n      x, y = pos\n      return env.world.workshop_indices[x, y]\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(pos, goal_item):\n      # Simple Manhattan distance to nearest workshop that has the required item\n      min_distance = float('inf')\n      for x in range(env.world.grid.shape[0]):\n          for y in range(env.world.grid.shape[1]):\n              if env.world.workshop_indices[x, y]:\n                  distance = abs(x - pos[0]) + abs(y - pos[1])\n                  min_distance = min(min_distance, distance)\n      return min_distance\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is a primitive or has a recipe\n  if goal_item not in env.world.cookbook.primitives and goal_item not in env.world.cookbook.recipes:\n      print(f\"Item {goal_item} does not have a recipe or is not a primitive.\")\n      return []\n\n  # Initialize pathfinding with BFS\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      print(\"No valid sequence of actions found to craft the item.\")\n\n  return action_sequence", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T16:10:24.855027", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(pos, grid, goal_item, world):\n      # Simple Manhattan distance to nearest workshop that has the required item\n      min_distance = float('inf')\n      for x in range(world.grid.shape[0]):\n          for y in range(world.grid.shape[1]):\n              if world.workshop_indices[x, y]:\n                  distance = abs(x - pos[0]) + abs(y - pos[1])\n                  min_distance = min(min_distance, distance)\n      return min_distance\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      from collections import namedtuple\n      \n      StateNode = namedtuple('StateNode', ['pos', 'grid', 'inventory', 'dir', 'g_cost', 'h_cost', 'path'])\n      \n      open_set = []\n      closed_set = set()\n      \n      start_node = StateNode(\n          pos=initial_state.pos,\n          grid=tuple(initial_state.grid.flatten()),\n          inventory=tuple(initial_state.inventory),\n          dir=initial_state.dir,\n          g_cost=0,\n          h_cost=heuristic(initial_state.pos, initial_state.grid, goal_item, env.world),\n          path=[]\n      )\n      \n      heappush(open_set, (start_node.g_cost + start_node.h_cost, start_node))\n      \n      while open_set:\n          current_f_cost, current_node = heappop(open_set)\n          \n          if satisfies_goal(current_node, goal_item):\n              return current_node.path\n          \n          closed_set.add((current_node.pos, current_node.grid, current_node.inventory, current_node.dir))\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = env._current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (new_state.pos, tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.dir)\n              \n              if state_hash not in closed_set:\n                  g_cost = current_node.g_cost + 1\n                  h_cost = heuristic(new_state.pos, new_state.grid, goal_item, env.world)\n                  path = current_node.path + [action]\n                  \n                  new_node = StateNode(pos=new_state.pos, grid=tuple(new_state.grid.flatten()), inventory=tuple(new_state.inventory), dir=new_state.dir, g_cost=g_cost, h_cost=h_cost, path=path)\n                  heappush(open_set, (g_cost + h_cost, new_node))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in env.world.cookbook.primitives and goal_item not in env.world.cookbook.recipes:\n      print(f\"Item {goal_item} does not have a recipe or is not a primitive.\")\n      return []\n\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if not action_sequence:\n      print(\"No valid sequence of actions found to craft the item.\")\n  \n  return action_sequence", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:11:24.519619", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate all possible actions for the current state\n          actions = generate_actions(current_state)\n          \n          for action in actions:\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def generate_actions(current_state):\n      actions = []\n      actions.append(4)  # Prioritize USE action (index 4)\n      \n      # Explore movement actions only if not blocked\n      for move_action in range(4):\n          new_pos = move_position(current_state.pos, current_state.dir, move_action)\n          if is_valid_move(new_pos, current_state.grid.shape[:2]):\n              actions.append(move_action)\n      \n      return actions\n\n  def move_position(pos, direction, action):\n      x, y = pos\n      directions = [(0, -1), (1, 0), (0, 1), (-1, 0)]  # UP, RIGHT, DOWN, LEFT\n      \n      if action < 4:  # Movement actions\n          dx, dy = directions[action]\n          new_x, new_y = x + dx, y + dy\n          \n          # Rotate direction based on movement action\n          if action == (direction + 1) % 4:\n              direction = (direction - 1) % 4\n          elif action == (direction - 1) % 4:\n              direction = (direction + 1) % 4\n      \n      else:  # USE action\n          new_x, new_y = x, y\n          \n      return (new_x, new_y)\n\n  def is_valid_move(pos, grid_shape):\n      x, y = pos\n      width, height = grid_shape\n      \n      # Check if the position is within grid bounds\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      \n      # Check if the cell is traversable (non-grabbable entities should be avoided)\n      kind_index = np.argmax(env._current_state.grid[x, y])\n      if kind_index in env.world.non_grabbable_indices:\n          return False\n      \n      return True\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T16:11:34.972101", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions to improve efficiency\n          actions = [4] + list(range(4))  # Prioritize USE action (index 4)\n          \n          for action in actions:\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              state_hash = hash((tuple(new_state.grid.flatten()), \n                                 tuple(new_state.inventory), \n                                 new_state.pos, \n                                 new_state.dir))\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T16:12:18.930050", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of items needed for the goal\n      # This is a placeholder and can be improved based on domain knowledge.\n      goal_recipe = env.world.cookbook.recipes.get(goal_item, {})\n      missing_items = sum(count - state.inventory[item] for item, count in goal_recipe.items() if item != \"_key\")\n      return max(0, missing_items)\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  cost = len(path) + 1\n                  heappush(open_set, (cost + heuristic(new_state, goal_item), new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:12:19.928859", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: count the number of missing ingredients needed to make the goal item\n      cookbook = env.world.cookbook.recipes.get(goal_item, {})\n      inventory_counts = {env.world.cookbook.index.get(item_name): count for item_name, count in state.inventory_dict().items() if item_name in env.world.cookbook.index}\n      \n      missing_ingredients = 0\n      for ingredient_idx, required_count in cookbook.items():\n          if isinstance(ingredient_idx, int):\n              missing_ingredients += max(required_count - inventory_counts.get(ingredient_idx, 0), 0)\n      \n      return missing_ingredients\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = [(heuristic(initial_state, goal_item), initial_state, [])]\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heappush(open_set, (heuristic(new_state, goal_item) + len(path) + 1, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:13:03.347725", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n      # Ensure neighbors are within grid bounds\n      return [(nx, ny) for nx, ny in neighbors if 0 <= nx < env.world.scenario.init_grid.shape[0] and 0 <= ny < env.world.scenario.init_grid.shape[1]]\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Determine possible actions based on grid and inventory state\n          for action in range(env.world.n_actions):\n              # Skip USE action if there's nothing to use\n              if action == 4:\n                  if not any(current_state.grid[current_state.pos[0]-1:current_state.pos[0]+2,\n                                                             current_state.pos[1]-1:current_state.pos[1]+2].flatten()):\n                      continue\n                  else:\n                      # Check if there's a valid use target in the grid\n                      valid_use_target = False\n                      for neighbor in get_neighbors(current_state.pos):\n                          if any(current_state.grid[neighbor]):\n                              valid_use_target = True\n                              break\n                      if not valid_use_target:\n                          continue\n              \n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n  