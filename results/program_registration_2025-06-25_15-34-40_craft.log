{"timestamp": "2025-06-26T13:57:50.067931", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic: distance to nearest required resource\n      recipe = env.world.cookbook.recipes.get(goal_item)\n      if not recipe:\n          return float('inf')\n      \n      min_distance = float('inf')\n      for ingredient_index in recipe.keys():\n          if ingredient_index == \"_key\":\n              continue  # Skip the key if it exists (e.g., workshop requirement)\n          \n          # Find nearest cell with the required ingredient\n          required_kind = env.world.cookbook.index.get(ingredient_index, None)\n          if required_kind is None:\n              continue  # If kind not found in index, skip this ingredient\n      \n          for dx in range(-1, 2):\n              for dy in range(-1, 2):\n                  neighbor_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n                  if 0 <= neighbor_pos[0] < env.world.cookbook.index.n_kinds and 0 <= neighbor_pos[1] < env.world.cookbook.index.n_kinds:\n                      if current_state.grid[neighbor_pos[0], neighbor_pos[1], required_kind] > 0:\n                          min_distance = min(min_distance, abs(dx) + abs(dy))\n      \n      return min_distance\n\n  def a_star_search(initial_state, goal_item):\n      from collections import deque\n      \n      # Priority queue for A* search\n      open_set = []\n      heapq.heappush(open_set, (heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action (index 4)\n          actions = [4] + list(range(4))\n          \n          for action in actions:\n   