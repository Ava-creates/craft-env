not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Optimize by filtering out non-reachable actions based on grid and inventory\n  reachable_actions = []\n  \n  for action in range(initial_state.world.n_actions):\n      reward, new_state = initial_state.step(action)\n      \n      if action == 4:  # USE action\n          # Check if the use action can contribute to making any primitive\n          for primitive_index in goal_primitives:\n              if new_state.inventory[primitive_index] > initial_state.inventory[primitive_index]:\n                  reachable_actions.append(action)\n                  break\n      else:  # MOVEMENT actions\n          # Check if the movement is within grid bounds and not into non-grabbable entities\n          x, y = initial_state.pos\n          direction = initial_state.dir\n          \n          if direction == 0:  # UP\n              new_pos = (x, y - 1)\n          elif direction == 1:  # DOWN\n              new_pos = (x, y + 1)\n          elif direction == 2:  # LEFT\n              new_pos = (x - 1, y)\n          else:  # RIGHT\n              new_pos = (x + 1, y)\n          \n          if (0 <= new_pos[0] < initial_state.grid.shape[0] and \n              0 <= new_pos[1] < initial_state.grid.shape[1] and \n              initial_state.world.index.get(new_state.grid[new_pos]) not in initial_state.world.non_grabbable_indices):\n              reachable_actions.append(action)\n  \n  action_sequence = None\n  for action in reachable_actions:\n      reward, new_state = initial_state.step(action)\n      \n      # Continue BFS from this state\n      result_path = bfs_search(new_state, goal_item)\n      if result_path is not None:\n          action_sequence = [action] + result_path\n          break\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-27T12:04:13.026906", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_primitives):\n      # Calculate the cost based on how many primitives are already available\n      cost = 0\n      for primitive, required in goal_primitives.items():\n          if state.inventory[primitive] < required:\n              cost += (required - state.inventory[primitive])\n      return cost\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {state_hash(initial_state): 0}\n      f_score = {state_hash(initial_state): heuristic(initial_state, get_primitive_counts(goal_item, initial_state))}\n      \n      while open_set:\n          current_f, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              state_hash_new = state_hash(new_state)\n              \n              tentative_g_score = g_score[state_hash(current_state)] + 1\n              \n              if state_hash_new not in g_score or tentative_g_score < g_score[state_hash_new]:\n                  came_from[state_hash_new] = (current_state, action, path)\n                  g_score[state_hash_new] = tentative_g_score\n                  f_score[state_hash_new] = tentative_g_score + heuristic(new_state, goal_primitives)\n                  heapq.heappush(open_set, (f_score[state_hash_new], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def state_hash(state):\n      return (tuple(state.grid.flatten()), \n              tuple(state.inventory), \n              state.pos, \n              state.dir)\n\n  def reconstruct_path(came_from, current, path):\n      while current in came_from:\n          _, action, path = came_from[current]\n          path.append(action)\n          current = came_from[(state_hash(current[0]), state_hash(current[1]))][0]\n      return list(reversed(path))\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-27T12:05:55.065522", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(current_state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from current_state to reach the goal_item.\"\"\"\n      primitives_needed = get_primitive_counts(goal_item, current_state.world.cookbook)\n      current_primitives = {i: count for i, count in enumerate(current_state.inventory) if count > 0 and i in primitives_needed}\n      \n      # Calculate the total number of steps needed based on available primitives\n      steps_needed = 0\n      for primitive, required_count in primitives_needed.items():\n          available_count = current_primitives.get(primitive, 0)\n          steps_needed += max(0, (required_count - available_count) // primitives_needed[primitive])\n      \n      return steps_needed\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import itertools\n      \n      open_set = []\n      open_heap_counter = itertools.count()  # Unique sequence count for heap stability\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), next(open_heap_counter), initial_state, []))\n      \n      visited = set()\n      \n      while open_set:\n          _, _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heappush(open_set, (\n                      len(path) + heuristic(new_state, goal_item),\n                      next(open_heap_counter),\n                      new_state,\n                      path + [action]\n                  ))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 2.0}}
