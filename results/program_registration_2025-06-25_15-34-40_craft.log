e(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item can be crafted (i.e., it's in the cookbook or is a primitive)\n  if goal_item not in initial_state.world.cookbook.recipes and goal_item not in initial_state.world.cookbook.primitives:\n    return []  # Return empty list if the goal item is uncraftable\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  # Execute the actions to reach the goal state\n  for action in action_sequence:\n    reward, done, observations = env.step(action)\n    if done:\n      break\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T02:32:38.011891", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          # Check if the state has changed\n          if (not np.array_equal(new_state.grid, state.grid) or\n              not np.array_equal(new_state.inventory, state.inventory) or\n              new_state.pos != state.pos or\n              new_state.dir != state.dir):\n              valid_actions.append((action, new_state))\n      return valid_actions\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: return the number of items needed to craft the goal item minus the items in inventory\n      if satisfies_goal(state, goal_item):\n          return 0\n      \n      # Calculate missing items based on recipe\n      recipe = env.world.cookbook.recipes.get(goal_item, {})\n      required_items = {i: count for i, count in recipe.items() if i != \"_key\"}\n      \n      missing_count = sum(max(0, required_items[i] - state.inventory[i]) for i in required_items)\n      return missing_count\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state)\n          \n          for action, new_state in get_valid_actions(current_state):\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, action)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current):\n      total_path = []\n      state_hash = (tuple(current.grid.flatten()), \n                    tuple(current.inventory), \n                    current.pos, \n                    current.dir)\n      while state_hash in came_from:\n          previous_state, action = came_from[state_hash]\n          total_path.append(action)\n          state_hash = (tuple(previous_state.grid.flatten()), \n                        tuple(previous_state.inventory), \n                        previous_state.pos, \n                        previous_state.dir)\n      return list(reversed(total_path))\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Attempt to find a path to craft the goal item using A* search\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-27T02:32:39.295388", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          # Check if the state has changed\n          if (not np.array_equal(new_state.grid, state.grid) or\n              not np.array_equal(new_state.inventory, state.inventory) or\n              new_state.pos != state.pos or\n              new_state.dir != state.dir):\n              valid_actions.append((action, new_state))\n      return valid_actions\n\n  def heuristic(state, goal_item):\n      # Heuristic based on the number of items needed to craft the goal item\n      if satisfies_goal(state, goal_item):\n          return 0\n      \n      # Estimate based on the difference in inventory counts for required items\n      recipe = env.world.cookbook.recipes.get(goal_item, {})\n      missing_items = sum(max(0, recipe[i] - state.inventory[i]) for i in recipe)\n      \n      return missing_items\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import itertools\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), 0, next(itertools.count()), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_cost, _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, new_state in get_valid_actions(current_state):\n              tentative_g_score = g_score[current_state] + 1  # Assuming cost of each action is 1\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, tentative_g_score, next(itertools.count()), new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Attempt to find a path to craft the goal item using A* search\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-27T02:33:49.137010", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          # Only add actions that change the state\n          if not np.array_equal(new_state.grid, state.grid) or\\\n             not np.array_equal(new_state.inventory, state.inventory) or\\\n             new_state.pos != state.pos or\\\n             new_state.dir != state.dir:\n              valid_actions.append((action, new_state))\n      return valid_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited_states = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Get valid actions and resulting states\n          for action, new_state in get_valid_actions(current_state):\n              \n              # Create a hashable form of the state using tuples\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited_states:\n                  visited_states.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: distance to nearest required item\n      required_items = env.world.cookbook.primitives_for(goal_item).keys()\n      min_distance = float('inf')\n      \n      for i_kind in required_items:\n          pos = np.argwhere(state.grid[:, :, i_kind] > 0)\n          if len(pos) == 0:\n              continue\n          nearest_pos = pos[np.argmin(np.sum((pos - state.pos)**2, axis=1))]\n          distance = np.sqrt(np.sum((nearest_pos - state.pos)**2))\n          min_distance = min(min_distance, distance)\n      \n      return min_distance\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), 0, initial_state, []))  # (f, g, state, path)\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_g, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, new_state in get_valid_actions(current_state):\n              tentative_g_score = current_g + 1\n              \n              # Create a hashable form of the state using tuples\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, tentative_g_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
