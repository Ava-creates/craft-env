not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Check if movement actions are valid (i.e., within grid bounds)\n              elif action in [0, 1, 2, 3]:  # DOWN, UP, LEFT, RIGHT\n                  new_pos = list(new_state.pos)\n                  if action == 0:  # DOWN\n                      new_pos[1] += 1\n                  elif action == 1:  # UP\n                      new_pos[1] -= 1\n                  elif action == 2:  # LEFT\n                      new_pos[0] -= 1\n                  elif action == 3:  # RIGHT\n                      new_pos[0] += 1\n\n                  # Ensure the new position is within grid bounds\n                  if (0 <= new_pos[0] < initial_state.grid.shape[0] and \n                      0 <= new_pos[1] < initial_state.grid.shape[1]):\n                      action_sequence = path + [action]\n                  else:\n                      continue  # Skip invalid movement actions\n\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 2.0}}
