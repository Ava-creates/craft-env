{"timestamp": "2025-06-25T23:05:53.661979", "function_name": "craft", "function_body": "  def bfs_paths(starts, goals):\n    queue = [(start, []) for start in starts]\n    visited = set()\n    while queue:\n        (node, path) = queue.pop(0)\n        if node not in visited:\n            neighbors = get_neighbors(node)\n            for neighbor in neighbors:\n                new_path = path + [neighbor]\n                if neighbor in goals:\n                    return new_path\n                else:\n                    queue.append((neighbor, new_path))\n            visited.add(node)\n    return None\n\n  def get_neighbors(node):\n      \"\"\"Generate the list of nodes that can be directly reached from the current node.\"\"\"\n      neighbors = []\n      \n      # Get all recipes with `node` as an ingredient\n      for output, ingredients in env.world.cookbook.recipes.items():\n          if node in ingredients and ingredients[node] > 0:\n              neighbors.append(output)\n              \n      return neighbors\n\n  def actions_to_reach_goal(path):\n      \"\"\"Generate the list of actions required to reach the goal from the path.\"\"\"\n      actions = []\n      \n      # For each step in the path, determine the action required\n      for i in range(len(path) - 1):\n          current_node = path[i]\n          next_node = path[i + 1]\n          \n          # Find recipe that produces `next_node` using `current_node`\n          for output, ingredients in env.world.cookbook.recipes.items():\n              if output == next_node and current_node in ingredients:\n                  actions.append(env.world.index.get(next_node))  # Assuming USE action to craft\n                  break\n      \n      return actions\n\n  def gather_primitive(primitive):\n      \"\"\"Generate the list of actions required to gather a primitive.\"\"\"\n      actions = []\n      \n      # Find all positions of the primitive in the grid\n      pos_to_ingredient = find_item_positions(env._current_state.grid, primitive)\n      \n      for pos in pos_to_ingredient:\n          x, y = pos\n          while env._current_state.pos != (x, y):\n              move_action = move_towards(env._current_state, x, y)\n              actions.append(move_action)\n              env._current_state = step_and_update(env, env._current_state, move_action)\n          \n          # Once at the ingredient's position, use it\n          actions.append(env.world.index.get(primitive))  # Assuming USE action to gather\n          env._current_state.inventory[primitive] += 1\n      \n      return actions\n\n  def find_item_positions(grid, item):\n      \"\"\"Find all positions of an item in the grid.\"\"\"\n      positions = []\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if np.argmax(grid[x, y]) == item:\n                  positions.append((x, y))\n      return positions\n\n  def move_towards(current_state, target_x, target_y):\n      \"\"\"Generate a move action to get closer to the target position.\"\"\"\n      current_x, current_y = current_state.pos\n      if current_x < target_x:\n          return RIGHT\n      elif current_x > target_x:\n          return LEFT\n      elif current_y < target_y:\n          return DOWN\n      else:\n          return UP\n\n  def step_and_update(env, state, action):\n      \"\"\"Take a step in the environment and update the state.\"\"\"\n      reward, new_state = state.step(action)\n      return new_state\n  \n  # Start from the desired item (goal) and perform BFS to find the path back to primitives\n  goal = item\n  starts = list(env.world.cookbook.primitives)  # Choose all primitives as starting points\n  path = bfs_paths(starts, [goal])\n  \n  if path:\n      actions = []\n      \n      # Gather primitives required for the first step in the path\n      first_step_primitives = env.world.cookbook.recipes[path[0]]\n      for primitive, count in first_step_primitives.items():\n          if primitive != \"_key\":\n              while env._current_state.inventory[primitive] < count:\n                  actions.extend(gather_primitive(primitive))\n      \n      # Convert the path to actions\n      actions.extend(actions_to_reach_goal(path[::-1]))  # Reverse the path to go from primitives to goal\n      \n  else:\n      actions = []\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:07:18.954456", "function_name": "craft", "function_body": "  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Initialize a list to store the sequence of actions\n  actions = []\n\n  def move_to(x: int, y: int):\n      current_x, current_y = env._current_state.pos\n      delta_x = x - current_x\n      delta_y = y - current_y\n\n      direction_map = {\n          (0, 1): DOWN,\n          (0, -1): UP,\n          (1, 0): RIGHT,\n          (-1, 0): LEFT\n      }\n\n      # Determine the order of movement based on Manhattan distance\n      steps = []\n      if delta_x != 0:\n          steps.extend([(np.sign(delta_x), 0)] * abs(delta_x))\n      if delta_y != 0:\n          steps.extend([(0, np.sign(delta_y))] * abs(delta_y))\n\n      for dx, dy in steps:\n          actions.append(direction_map[(dx, dy)])\n\n  def pickup_items(item_index: int, count: int):\n      while env._current_state.inventory[item_index] < count and env._current_state.next_to(item_index):\n          actions.append(USE)\n\n  goal = env.world.cookbook.index.get(item)\n  if not goal:\n      raise ValueError(f\"Unknown item: {item}\")\n\n  primitives_needed = env.world.cookbook.primitives_for(env.world.cookbook.index[item])\n\n  # Define ingredient locations based on the grid setup\n  ingredient_locations = {\n      5: (2, 1),  # oak planks\n      6: (4, 0)   # sticks\n  }\n\n  for primitive_index, count in primitives_needed.items():\n      if primitive_index not in ingredient_locations:\n          raise ValueError(f\"Unknown ingredient location for index {primitive_index}\")\n      \n      move_to(*ingredient_locations[primitive_index])\n      pickup_items(primitive_index, count)\n\n  # Find the nearest workshop (assuming there's only one at position 3, 3)\n  workshop_location = (3, 3)  \n  move_to(*workshop_location)\n  actions.append(USE)\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T23:07:19.938425", "function_name": "craft", "function_body": "  # Define constants for movement and use actions\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Initialize a list to store the sequence of actions\n  actions = []\n\n  def move_to(x: int, y: int):\n      current_x, current_y = env._current_state.pos\n      delta_x = x - current_x\n      delta_y = y - current_y\n\n      direction_map = {\n          (0, 1): DOWN,\n          (0, -1): UP,\n          (1, 0): RIGHT,\n          (-1, 0): LEFT\n      }\n\n      # Determine the order of movement based on Manhattan distance\n      if abs(delta_x) > abs(delta_y):\n          steps = [(np.sign(delta_x), 0)] * abs(delta_x)\n          steps.extend([(0, np.sign(delta_y))] * abs(delta_y))\n      else:\n          steps = [(0, np.sign(delta_y))] * abs(delta_y)\n          steps.extend([(np.sign(delta_x), 0)] * abs(delta_x))\n\n      for dx, dy in steps:\n          actions.append(direction_map[(dx, dy)])\n\n  def pickup_items(item_index: int, count: int):\n      while env._current_state.inventory[item_index] < count and env._current_state.next_to(item_index):\n          actions.append(USE)\n\n  # Get the goal item's index\n  goal = env.world.cookbook.index.get(item)\n  if not goal:\n      raise ValueError(f\"Unknown item: {item}\")\n\n  # Get the list of primitive ingredients needed for the desired item\n  primitives_needed = env.world.cookbook.primitives_for(env.world.cookbook.index[item])\n\n  # Define ingredient locations based on the grid setup\n  ingredient_locations = {\n      5: (2, 1),  # oak planks\n      6: (4, 0)   # sticks\n  }\n\n  for primitive_index, count in primitives_needed.items():\n      if primitive_index not in ingredient_locations:\n          raise ValueError(f\"Unknown ingredient location for index {primitive_index}\")\n      \n      move_to(*ingredient_locations[primitive_index])\n      pickup_items(primitive_index, count)\n\n  # Find the nearest workshop to craft the item\n  workshop_location = find_nearest_workshop(env)\n  move_to(*workshop_location)\n  actions.append(USE)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:08:09.142889", "function_name": "craft", "function_body": "  current_state = env._current_state\n  cookbook = env.world.cookbook\n\n  # Define a queue for BFS with the initial state and an empty action sequence\n  queue = [(current_state, [])]\n\n  # Set to track visited states (using tuple representation of grid, pos, dir)\n  visited_states = set()\n\n  while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      # Check if the goal is satisfied in the current state\n      if current_state.satisfies(\"dummy_goal_name\", item):\n          return actions_taken\n\n      # Get the next possible states by taking each action\n      for action in range(env.world.n_actions):  # Assuming there are n_actions available actions\n          reward, new_state = current_state.step(action)\n\n          # Create a unique hashable representation of the state to check if it's visited\n          state_representation = (tuple(current_state.grid.flatten()), \n                                  tuple(current_state.pos), \n                                  current_state.dir)\n          \n          if state_representation not in visited_states:\n              visited_states.add(state_representation)\n\n              # Check for craft actions that might lead to the desired item\n              if action == USE_ACTION_INDEX:  # Assuming USE_ACTION_INDEX is defined for the use action\n                  # If the new_state has the item we need, add it to the queue\n                  inventory_diff = new_state.inventory - current_state.inventory\n                  if inventory_diff[item] > 0:\n                      return actions_taken + [action]\n              else:\n                  queue.append((new_state, actions_taken + [action]))\n\n  # Return an empty list or a specific action sequence indicating failure to find a solution\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:08:18.031350", "function_name": "craft", "function_body": "  current_state = env._current_state\n\n  # Define a queue for BFS with the initial state and an empty action sequence\n  queue = [(current_state, [])]\n\n  # Set to track visited states (using tuple representation of grid, pos, dir)\n  visited_states = set()\n\n  while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      # Check if the goal is satisfied in the current state\n      if current_state.satisfies(\"dummy_goal_name\", item):\n          return actions_taken\n\n      # Get the next possible states by taking each action\n      for action in range(env.world.n_actions):  # Assuming there are n_actions available actions\n          reward, new_state = current_state.step(action)\n\n          # Check if the goal is satisfied after the step (early exit)\n          if new_state.satisfies(\"dummy_goal_name\", item):\n              return actions_taken + [action]\n\n          # Create a unique hashable representation of the state to check if it's visited\n          state_representation = (tuple(new_state.grid.flatten()), \n                                  tuple(new_state.pos), \n                                  new_state.dir)\n          \n          if state_representation not in visited_states:\n              visited_states.add(state_representation)\n              queue.append((new_state, actions_taken + [action]))\n\n  # Return an empty list or a specific action sequence indicating failure to find a solution\n  return []", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T23:11:16.266372", "function_name": "craft", "function_body": "  def depth_first_search(graph, start):\n      stack = [(start, [])]\n      visited = set()\n      while stack:\n          node, path = stack.pop()\n          if node not in visited:\n              visited.add(node)\n              path = path + [node]\n              if node == item:\n                  return path\n              neighbors = graph.get(node, [])\n              for neighbor in reversed(neighbors):\n                  if neighbor not in visited:\n                      stack.append((neighbor, path))\n      return []\n\n  def find_closest_ingredient(grid, pos, ingredient_index):\n      # Find all positions of the ingredient in the grid\n      ingredient_positions = np.argwhere(grid[:, :, ingredient_index] > 0)\n      if len(ingredient_positions) == 0:\n          return None\n      \n      # Calculate distances from the agent's current position to each ingredient position\n      distances = np.linalg.norm(ingredient_positions - pos, axis=1)\n      \n      # Find the nearest ingredient position\n      closest_position = tuple(ingredient_positions[np.argmin(distances)])\n      return closest_position\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Calculate the required direction to move towards the target position\n      if dx > 0:\n          target_direction = 3  # RIGHT\n      elif dx < 0:\n          target_direction = 2  # LEFT\n      elif dy > 0:\n          target_direction = 1  # UP\n      else:\n          target_direction = 0  # DOWN\n\n      # Turn to the required direction if necessary\n      while env.current_state.dir != target_direction:\n          actions.append((env.current_state.dir + 1) % 4)\n          env.step((env.current_state.dir + 1) % 4)\n\n      # Move forward until reaching the target position\n      while tuple(env.current_state.pos) != tuple(target_pos):\n          actions.append(4)  # Assuming USE action is represented by 4\n          env.step(4)\n\n      return actions\n\n  def gather_ingredient(ingredient, count):\n      actions = []\n      grid = env.state.grid\n      pos = env.state.pos\n\n      while env.state.inventory[ingredient] < count:\n          closest_position = find_closest_ingredient(grid, pos, ingredient)\n          if closest_position is None:\n              break\n          \n          # Move towards the nearest ingredient position\n          actions.extend(move_to_position(pos, closest_position))\n          \n          # Pick up the ingredient (USE action)\n          actions.append(4)  # Assuming USE action is represented by 4\n          \n          # Update state after picking up the ingredient\n          env.step(4)\n\n      return actions\n\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  primitives = cookbook.primitives\n  recipes = cookbook.recipes\n\n  # Create a reverse graph where keys are ingredients and values are lists of items that can be crafted with those ingredients\n  reverse_graph = {}\n  for output, recipe in recipes.items():\n      for ingredient in recipe:\n          if ingredient != \"_key\":\n              if ingredient not in reverse_graph:\n                  reverse_graph[ingredient] = []\n              reverse_graph[ingredient].append(output)\n\n  # Find the path from the primitives to the goal item using depth-first search\n  path = depth_first_search(reverse_graph, item)\n  \n  if not path:\n      return []\n\n  actions = []\n\n  # Traverse the path and generate actions to craft each item in the path\n  for i in range(1, len(path)):\n      current_item = path[i]\n      recipe = recipes[current_item]\n\n      # Add actions to gather all required ingredients\n      for ingredient, count in recipe.items():\n          if ingredient != \"_key\":\n              actions.extend(gather_ingredient(ingredient, count))\n\n      # Add action to craft the current item\n      actions.append(4)  # Assuming USE action is represented by 4\n\n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T23:11:17.283683", "function_name": "craft", "function_body": "  def depth_first_search(graph, start):\n      stack = [(start, [])]\n      visited = set()\n      paths = []\n      while stack:\n          node, path = stack.pop()\n          if node not in visited:\n              visited.add(node)\n              path = path + [node]\n              if node == item:\n                  paths.append(path)\n              neighbors = graph.get(node, [])\n              for neighbor in reversed(neighbors):\n                  if neighbor not in visited:\n                      stack.append((neighbor, path))\n      return paths\n\n  def find_closest_ingredient(grid, pos, ingredient_index):\n      # Find all positions of the ingredient in the grid\n      ingredient_positions = np.argwhere(grid[:, :, ingredient_index] > 0)\n      if len(ingredient_positions) == 0:\n          return None\n      \n      # Calculate distances from the agent's current position to each ingredient position\n      distances = np.linalg.norm(ingredient_positions - pos, axis=1)\n      \n      # Find the nearest ingredient position\n      closest_position = tuple(ingredient_positions[np.argmin(distances)])\n      return closest_position\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Calculate the required direction to move towards the target position\n      if dx > 0:\n          target_direction = 3  # RIGHT\n      elif dx < 0:\n          target_direction = 2  # LEFT\n      elif dy > 0:\n          target_direction = 1  # UP\n      else:\n          target_direction = 0  # DOWN\n\n      # Turn to the required direction if necessary\n      while env.current_state.dir != target_direction:\n          actions.append((env.current_state.dir + 1) % 4)\n          env.step((env.current_state.dir + 1) % 4)\n\n      # Move forward until reaching the target position\n      while tuple(env.current_state.pos) != tuple(target_pos):\n          actions.append(4)  # Assuming USE action is represented by 4\n          env.step(4)\n\n      return actions\n\n  def gather_ingredient(ingredient, count):\n      actions = []\n      grid = env.state.grid\n      pos = env.state.pos\n\n      while env.state.inventory[ingredient] < count:\n          closest_position = find_closest_ingredient(grid, pos, ingredient)\n          if closest_position is None:\n              break\n          \n          # Move towards the nearest ingredient position\n          actions.extend(move_to_position(pos, closest_position))\n          \n          # Pick up the ingredient (USE action)\n          actions.append(4)  # Assuming USE action is represented by 4\n          \n          # Update state after picking up the ingredient\n          env.step(4)\n\n      return actions\n\n  def get_ingredient_indices(recipe):\n      \"\"\"Returns a list of ingredient indices for the given recipe.\"\"\"\n      return [ingredient for ingredient in recipe if ingredient != \"_key\"]\n\n  def find_crafting_station(grid, pos, crafting_stations):\n      \"\"\"Finds the closest crafting station in the grid.\"\"\"\n      # Find all positions of the crafting stations in the grid\n      station_positions = np.array([(x, y) for x in range(grid.shape[0]) for y in range(grid.shape[1]) if any(grid[x, y, station] > 0 for station in crafting_stations)])\n      if len(station_positions) == 0:\n          return None\n      \n      # Calculate distances from the agent's current position to each station position\n      distances = np.linalg.norm(station_positions - pos, axis=1)\n      \n      # Find the nearest station position\n      closest_position = tuple(station_positions[np.argmin(distances)])\n      return closest_position\n\n  def move_to_station(pos, target_pos):\n      actions = []\n      dx = target_pos[0] - pos[0]\n      dy = target_pos[1] - pos[1]\n\n      # Calculate the required direction to move towards the target position\n      if dx > 0:\n          target_direction = 3  # RIGHT\n      elif dx < 0:\n          target_direction = 2  # LEFT\n      elif dy > 0:\n          target_direction = 1  # UP\n      else:\n          target_direction = 0  # DOWN\n\n      # Turn to the required direction if necessary\n      while env.current_state.dir != target_direction:\n          actions.append((env.current_state.dir + 1) % 4)\n          env.step((env.current_state.dir + 1) % 4)\n\n      # Move forward until reaching the target position\n      while tuple(env.current_state.pos) != tuple(target_pos):\n          actions.append(4)  # Assuming USE action is represented by 4\n          env.step(4)\n\n      return actions\n\n  def craft_item(output, recipe, crafting_stations):\n      actions = []\n      grid = env.state.grid\n      pos = env.state.pos\n      \n      # Find the closest crafting station\n      closest_station = find_crafting_station(grid, pos, crafting_stations)\n      if closest_station is None:\n          return []\n\n      # Move towards the nearest crafting station\n      actions.extend(move_to_station(pos, closest_station))\n      \n      # Gather all required ingredients\n      ingredient_indices = get_ingredient_indices(recipe)\n      for ingredient in ingredient_indices:\n          count = recipe[ingredient]\n          actions.extend(gather_ingredient(ingredient, count))\n\n      # Craft the item (USE action at crafting station)\n      actions.append(4)  # Assuming USE action is represented by 4\n      env.step(4)\n\n      return actions\n\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  primitives = cookbook.primitives\n  recipes = cookbook.recipes\n  workshop_index = index['workshop'] if 'workshop' in index else None\n\n  # Create a reverse graph where keys are ingredients and values are lists of items that can be crafted with those ingredients\n  reverse_graph = {}\n  for output, recipe in recipes.items():\n      for ingredient in recipe:\n          if ingredient != \"_key\":\n              if ingredient not in reverse_graph:\n                  reverse_graph[ingredient] = []\n              reverse_graph[ingredient].append(output)\n\n  # Find all paths from the primitives to the goal item using depth-first search\n  paths = depth_first_search(reverse_graph, item)\n\n  if not paths:\n      return []\n\n  # Choose the shortest path\n  path = min(paths, key=len)\n\n  actions = []\n  \n  crafting_stations = [workshop_index] if workshop_index is not None else []\n\n  # Traverse the path and generate actions to craft each item in the path\n  for i in range(1, len(path)):\n      current_item = path[i]\n      recipe = recipes[current_item]\n\n      # Craft the current item\n      actions.extend(craft_item(current_item, recipe, crafting_stations))\n\n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T23:12:22.825561", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      \"\"\"\n      Heuristic function to estimate the cost from the current state to the goal.\n      For simplicity, we use a constant heuristic of 0 for now.\n      This can be improved by estimating the number of steps required based on the inventory and grid.\n      \"\"\"\n      return 0\n\n  def astar_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0 + heuristic(initial_state, goal_item), initial_state, []))  # (f_score, state, path)\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Cost of moving from current_state to new_state is 1\n      \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:12:38.490319", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=50):  # Limit search depth to avoid infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if len(path) > max_depth:\n              continue  # Skip paths that exceed the maximum depth\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n    print(f\"Action sequence to craft {env.world.cookbook.index.get(goal_item)}: {action_sequence}\")\n  else:\n    print(f\"No action sequence found to craft {env.world.cookbook.index.get(goal_item)}\")\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:13:57.548851", "function_name": "craft", "function_body": "  # Ensure the goal is valid\n  if item not in env.world.cookbook.kinds:\n    raise ValueError(f\"Invalid goal: {item} is not a known item.\")\n\n  # Initialize action sequence\n  actions = []\n\n  # Sample a scenario with the desired goal\n  scenario = env.world.sample_scenario_with_goal(item)\n  state = scenario.init()\n\n  # Helper function to find and pick up an item nearby\n  def pickup_item(index):\n    nonlocal actions, state\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        new_pos = (state.pos[0] + dx, state.pos[1] + dy)\n        if not (0 <= new_pos[0] < env.world.grid_width and 0 <= new_pos[1] < env.world.grid_height):\n          continue\n        if state.grid[new_pos[0], new_pos[1], index] > 0:\n          # Move to the position of the item\n          actions.extend(move_to(state.pos, new_pos))\n          # Pick up the item\n          actions.append(env_factory.USE)\n          state = state.step(env_factory.USE)[1]\n          return True\n    return False\n\n  # Helper function to move to a specific position\n  def move_to(current_pos, target_pos):\n    nonlocal state\n    path_actions = []\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      if dx < 0:\n        path_actions.append(env_factory.LEFT)\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif dx > 0:\n        path_actions.append(env_factory.RIGHT)\n        current_pos = (current_pos[0] + 1, current_pos[1])\n      if dy < 0:\n        path_actions.append(env_factory.DOWN)\n        current_pos = (current_pos[0], current_pos[1] - 1)\n      elif dy > 0:\n        path_actions.append(env_factory.UP)\n        current_pos = (current_pos[0], current_pos[1] + 1)\n    return path_actions\n\n  # Recursive function to craft an item\n  def craft_item(index):\n    nonlocal actions, state\n    if index in env.world.cookbook.primitives:\n      if not pickup_item(index):\n        raise ValueError(f\"Primitive {index} cannot be found.\")\n      return\n\n    recipe = env.world.cookbook.recipes.get(index)\n    if not recipe:\n      raise ValueError(f\"No recipe for item {index}.\")\n\n    # Craft all required ingredients\n    for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n        continue  # Skip the key\n      for _ in range(count):\n        craft_item(ingredient)\n\n    # Move to a workshop\n    workshop_found = False\n    for x in range(env.world.grid_width):\n      for y in range(env.world.grid_height):\n        if index in env.world.workshop_indices and state.grid[x, y, index] > 0:\n          actions.extend(move_to(state.pos, (x, y)))\n          # Use the workshop to craft the item\n          actions.append(env_factory.USE)\n          state = state.step(env_factory.USE)[1]\n          workshop_found = True\n          break\n      if workshop_found:\n        break\n\n    if not workshop_found:\n      raise ValueError(\"No workshop found.\")\n\n  # Craft the desired item\n  craft_item(item)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:13:58.545134", "function_name": "craft", "function_body": "  def dfs_search(start_state, goal_index):\n    visited_states = set()\n    state_queue = [(start_state, [])]\n\n    while state_queue:\n      current_state, path = state_queue.pop(0)\n      \n      # Check if the goal item is in the inventory\n      if current_state.inventory[goal_index] > 0:\n        return path\n      \n      # Add current state to visited states (using a hashable representation of grid and inventory)\n      state_representation = (tuple(map(tuple, current_state.grid.flatten())), tuple(current_state.inventory))\n      if state_representation in visited_states:\n        continue\n      visited_states.add(state_representation)\n\n      for action_index in range(env.world.n_actions):\n        reward, new_state = current_state.step(action_index)\n        path_to_new_state = path + [action_index]\n        \n        # Add the new state to the queue with updated path\n        state_queue.append((new_state, path_to_new_state))\n\n    return None  # If no path is found\n\n  # Get initial state from the scenario\n  start_state = env.scenario.init()\n  \n  # Perform DFS search for crafting the item\n  actions_sequence = dfs_search(start_state, item)\n  \n  if actions_sequence:\n    return actions_sequence\n  else:\n    raise ValueError(\"No sequence of actions could be found to craft the desired item.\")", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:15:15.327888", "function_name": "craft", "function_body": "  def bfs(start, goal):\n    queue = [(start, [])]\n    visited = set()\n    \n    while queue:\n        current, path = queue.pop(0)\n        if current == goal:\n            return path\n        \n        if current in visited:\n            continue\n        \n        visited.add(current)\n        \n        # Find all the neighbors (ingredients) that can be crafted to reach the current item\n        for ingredient, count in env.world.cookbook.primitives_for(current).items():\n            queue.append((ingredient, path + [current]))\n    \n    return None  # If no path is found\n\n  def move_to_ingredient(env, ingredient):\n      # Implement a function to navigate to an ingredient\n      # This will involve moving the agent to a cell containing the ingredient and picking it up\n      actions = []\n      \n      # Placeholder logic for demonstration purposes\n      # Replace with actual navigation logic based on the environment's grid and agent's position\n      while not env._current_state.inventory[ingredient]:\n          x, y = env._current_state.pos\n          \n          # Example of a simple random walk to find the ingredient\n          if env._current_state.grid[x + 1][y].any():\n              actions.append(DOWN)\n          elif env._current_state.grid[x - 1][y].any():\n              actions.append(UP)\n          elif env._current_state.grid[x][y + 1].any():\n              actions.append(RIGHT)\n          elif env._current_state.grid[x][y - 1].any():\n              actions.append(LEFT)\n          \n          actions.append(PICKUP)  # Assuming PICKUP is the action to pick up an item\n      \n      return actions\n\n  start = env._current_state.scenario.init_pos\n  goal = item\n  \n  path = bfs(start, goal)\n  \n  if not path:\n      return []  # Return an empty list if the goal cannot be crafted\n\n  actions = []\n  \n  for step in range(len(path) - 1):\n      current_item = path[step]\n      next_item = path[step + 1]\n\n      # Collect all ingredients needed to craft the next item\n      required_ingredients = env.world.cookbook.primitives_for(next_item)\n      \n      for ingredient, count in required_ingredients.items():\n          if not env._current_state.inventory[ingredient]:\n              # If the ingredient is not in the inventory, move to collect it\n              actions.extend(move_to_ingredient(env, ingredient))\n          \n          # Use the ingredient from the inventory\n          actions.append(USE)\n\n      # Craft the next item\n      actions.append(CRAFT)\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T23:15:16.283368", "function_name": "craft", "function_body": "  def bfs(start_item, goal_item):\n    queue = [(start_item, [])]\n    visited = set()\n    \n    while queue:\n        current_item, path = queue.pop(0)\n        \n        if current_item == goal_item:\n            return path + [goal_item]\n        \n        if current_item in visited:\n            continue\n        \n        visited.add(current_item)\n\n        # Find all items that can be crafted from the current item\n        possible_items = []\n        for output_item, ingredients in env.world.cookbook.recipes.items():\n          if current_item in ingredients:\n              possible_items.append(output_item)\n        \n        for next_item in possible_items:\n            queue.append((next_item, path + [current_item]))\n    \n    return None  # If no path is found\n\n  start_item = item  # Starting from the goal item and working backward\n  goal_item = 0  # Assuming we want to reach a basic primitive or environment item (e.g., index 0)\n\n  path = bfs(start_item, goal_item)\n  \n  if not path:\n      return []  # Return an empty list if the goal cannot be crafted\n\n  actions = []\n  \n  for step in range(len(path) - 1):\n      current_item = path[step]\n      next_item = path[step + 1]\n\n      # Collect all ingredients needed to craft the next item\n      required_ingredients = env.world.cookbook.primitives_for(next_item)\n      \n      for ingredient, count in required_ingredients.items():\n          if not env._current_state.inventory[ingredient]:\n              # If the ingredient is not in the inventory, move to collect it\n              actions.extend(move_to_ingredient(env, ingredient))\n          \n          # Use the ingredient from the inventory\n          actions.append(USE)\n\n      # Craft the next item\n      actions.append(CRAFT)\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T23:16:50.004603", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      \n      # Prioritize the USE action\n      reward, new_state = state.step(4)\n      if new_state != state:\n          valid_actions.append(4)\n      \n      for action in range(4):  # MOVEMENT ACTIONS: DOWN, UP, LEFT, RIGHT\n          reward, new_state = state.step(action)\n          if new_state != state:\n              valid_actions.append(action)\n      \n      return valid_actions\n\n  def heuristic(state, goal_item):\n      # Simple heuristic based on the distance to nearby ingredients or tools\n      # This can be further refined based on the specific scenario and environment\n      goal_index = env.world.cookbook.index.get(goal_item)\n      primitives_needed = env.world.cookbook.primitives_for(goal_index)\n\n      total_distance = 0\n      \n      for i_kind, count in primitives_needed.items():\n          if state.inventory[i_kind] >= count:\n              continue\n          \n          # Find the nearest occurrence of this ingredient/tool\n          min_dist = float('inf')\n          for y in range(state.grid.shape[0]):\n              for x in range(state.grid.shape[1]):\n                  if state.grid[y, x, i_kind] > 0:\n                      dist = abs(y - state.pos[0]) + abs(x - state.pos[1])\n                      min_dist = min(min_dist, dist)\n          \n          total_distance += min_dist\n      \n      return total_distance\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      from collections import defaultdict\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = defaultdict(lambda: float('inf'))\n      g_score[initial_state] = 0\n      f_score = defaultdict(lambda: float('inf'))\n      f_score[initial_state] = heuristic(initial_state, goal_item)\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Get valid actions\n          for action in get_valid_actions(current_state):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each step has a cost of 1\n              \n              if tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # If the goal item is already in the inventory, no actions are needed\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:16:50.969806", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      \n      # Prioritize the USE action\n      reward, new_state = state.step(4)\n      if new_state != state:\n          valid_actions.append(4)\n      \n      for action in range(4):  # MOVEMENT ACTIONS: DOWN, UP, LEFT, RIGHT\n          reward, new_state = state.step(action)\n          if new_state != state:\n              valid_actions.append(action)\n      \n      return valid_actions\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))  # priority, state, path\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          current_f, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in get_valid_actions(current_state):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[current_state] + 1  # Cost of each step is assumed to be 1\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = current_state\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      # Simple heuristic based on the number of items needed to craft the goal\n      cookbook = env.world.cookbook\n      primitives_needed = cookbook.primitives_for(goal_item)\n      \n      # Calculate the cost based on missing primitive items in the inventory\n      cost = sum(count for item_index, count in primitives_needed.items() if state.inventory[item_index] == 0)\n      \n      return cost\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # If the goal item is already in the inventory, no actions are needed\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:18:00.145129", "function_name": "craft", "function_body": "  def bfs_paths(starts, goal):\n    queue = [(start, []) for start in starts]\n    visited = set()\n    while queue:\n        (node, path) = queue.pop(0)\n        if node not in visited:\n            neighbors = get_neighbors(node)\n            for neighbor in neighbors:\n                new_path = path + [neighbor]\n                if neighbor == goal:\n                    return new_path\n                else:\n                    queue.append((neighbor, new_path))\n            visited.add(node)\n    return None\n\n  def get_neighbors(node):\n    \"\"\"Generate the list of nodes that can be directly reached from the current node.\"\"\"\n    neighbors = []\n    \n    # Get all recipes with `node` as an ingredient\n    for output, ingredients in env.world.cookbook.recipes.items():\n        if node in ingredients:\n            neighbors.append(output)\n            \n    return neighbors\n\n  def actions_to_reach_goal(path):\n    \"\"\"Generate the list of actions required to reach the goal from the path.\"\"\"\n    actions = []\n    \n    # For each step in the path, determine the action required\n    for i in range(len(path) - 1):\n        current_node = path[i]\n        next_node = path[i + 1]\n        \n        # Find recipe that produces `next_node` using `current_node`\n        for output, ingredients in env.world.cookbook.recipes.items():\n            if output == next_node and current_node in ingredients:\n                actions.append(env.world.index.get(next_node))  # Assuming USE action to craft\n                break\n    \n    return actions\n\n  def find_paths_to_primitives(goal):\n      paths = []\n      for start in env.world.cookbook.primitives:\n          path = bfs_paths([start], goal)\n          if path:\n              paths.append(path[::-1])  # Reverse the path to go from primitives to goal\n      return paths\n\n  # Start from the desired item (goal) and perform BFS to find all paths back to primitives\n  goal = item\n  paths = find_paths_to_primitives(goal)\n  \n  if not paths:\n      return []\n  \n  # Choose the shortest path\n  optimal_path = min(paths, key=len)\n  actions = actions_to_reach_goal(optimal_path)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T23:18:01.108731", "function_name": "craft", "function_body": "  def bfs_paths(starts, goal):\n      queue = [(start, []) for start in starts]\n      visited = set()\n      while queue:\n          (node, path) = queue.pop(0)\n          if node not in visited:\n              neighbors = get_neighbors(node)\n              for neighbor in neighbors:\n                  new_path = path + [neighbor]\n                  if neighbor == goal:\n                      return new_path\n                  else:\n                      queue.append((neighbor, new_path))\n              visited.add(node)\n      return None\n\n  def get_neighbors(node):\n      \"\"\"Generate the list of nodes that can be directly reached from the current node.\"\"\"\n      neighbors = []\n      \n      # Get all recipes with `node` as an ingredient\n      for output, ingredients in env.world.cookbook.recipes.items():\n          if node in ingredients:\n              neighbors.append(output)\n              \n      return neighbors\n\n  def actions_to_reach_goal(path):\n      \"\"\"Generate the list of actions required to reach the goal from the path.\"\"\"\n      actions = []\n      \n      # For each step in the path, determine the action required\n      for i in range(len(path) - 1):\n          current_node = path[i]\n          next_node = path[i + 1]\n          \n          # Find recipe that produces `next_node` using `current_node`\n          for output, ingredients in env.world.cookbook.recipes.items():\n              if output == next_node and current_node in ingredients:\n                  actions.append(env.world.index.get(next_node))  # Assuming USE action to craft\n                  break\n      \n      return actions\n\n  # Start from the desired item (goal) and perform BFS to find the path back to primitives\n  goal = item\n  starts = list(env.world.cookbook.primitives)  # Choose all primitives as starting points\n  path = bfs_paths(starts, goal)\n  \n  if path:\n      actions = actions_to_reach_goal(path[::-1])  # Reverse the path to go from primitives to goal\n  else:\n      actions = []\n  \n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T23:19:33.938408", "function_name": "craft", "function_body": "  actions = []\n  \n  # Define constants for actions\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  \n  def move_to(x: int, y: int) -> list[int]:\n    \"\"\"Helper function to generate a sequence of actions to move to a given position.\"\"\"\n    current_x, current_y = env._current_state.pos\n    dx = x - current_x\n    dy = y - current_y\n    \n    moves = []\n    \n    # Move vertically\n    if dy > 0:\n      moves.extend([DOWN] * abs(dy))\n    elif dy < 0:\n      moves.extend([UP] * abs(dy))\n      \n    # Move horizontally\n    if dx > 0:\n      moves.extend([RIGHT] * abs(dx))\n    elif dx < 0:\n      moves.extend([LEFT] * abs(dx))\n    \n    return moves\n  \n  \n  def pick_up(item_index: int) -> list[int]:\n    \"\"\"Helper function to generate a sequence of actions to pick up an item.\"\"\"\n    # Find all positions of the item in the grid\n    pos = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n    \n    moves = []\n    for x, y in pos:\n      # Move to the position of the item\n      moves.extend(move_to(x, y))\n      \n      # Pick up the item\n      moves.append(USE)\n      \n      # Check if we have enough items in inventory\n      if env._current_state.inventory[item_index] >= env.world.cookbook.primitives_for(item)[item_index]:\n        break\n    \n    return moves\n  \n  \n  def use_workshop() -> list[int]:\n    \"\"\"Helper function to generate a sequence of actions to use a workshop.\"\"\"\n    # Find a workshop (for simplicity, we assume there's at least one)\n    pos = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] > 0)\n    \n    moves = []\n    for x, y in pos:\n      # Move to the workshop\n      moves.extend(move_to(x, y))\n      \n      # Use the workshop\n      moves.append(USE)\n    \n    return moves\n  \n  \n  def craft_item(item_index: int) -> list[int]:\n    \"\"\"Helper function to generate a sequence of actions to craft an item.\"\"\"\n    primitives = env.world.cookbook.primitives_for(item_index)\n    if not primitives:\n      return []\n    \n    # Collect all required primitives\n    for primitive, count in primitives.items():\n      moves = pick_up(primitive)\n      \n      # Check inventory\n      if env._current_state.inventory[primitive] < count:\n        raise ValueError(f\"Not enough {env.world.cookbook.index.get(primitive)} to craft {env.world.cookbook.index.get(item_index)}.\")\n      \n      actions.extend(moves)\n    \n    # Use workshop to craft the item\n    moves = use_workshop()\n    actions.extend(moves)\n    \n    return actions\n  \n  try:\n    # Generate the sequence of actions to craft the item\n    craft_item(item)\n  except ValueError as e:\n    print(e)\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:19:34.996801", "function_name": "craft", "function_body": "  def move_to(x: int, y: int) -> list[int]:\n    current_x, current_y = env._current_state.pos\n    dx = x - current_x\n    dy = y - current_y\n    \n    moves = []\n    \n    if dx > 0:\n      moves.extend([env.ACTIONS.RIGHT] * abs(dx))\n    elif dx < 0:\n      moves.extend([env.ACTIONS.LEFT] * abs(dx))\n      \n    if dy > 0:\n      moves.extend([env.ACTIONS.DOWN] * abs(dy))\n    elif dy < 0:\n      moves.extend([env.ACTIONS.UP] * abs(dy))\n    \n    return moves\n\n  def pick_up(item_index: int) -> list[int]:\n    pos = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n    if len(pos) == 0:\n      return []\n    \n    moves = []\n    for x, y in pos:\n      moves.extend(move_to(x, y))\n      moves.append(env.ACTIONS.USE)\n      \n      if env._current_state.inventory[item_index] >= env.world.cookbook.primitives_for(item)[item_index]:\n        break\n    \n    return moves\n\n  def use_workshop() -> list[int]:\n    pos = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] > 0)\n    if len(pos) == 0:\n      return []\n    \n    x, y = pos[0]\n    moves = move_to(x, y)\n    moves.append(env.ACTIONS.USE)\n    \n    return moves\n\n  def craft_item(item_index: int) -> list[int]:\n    primitives = env.world.cookbook.primitives_for(item_index)\n    if not primitives:\n      return []\n    \n    actions = []\n    for primitive, count in primitives.items():\n      while env._current_state.inventory[primitive] < count:\n        moves = pick_up(primitive)\n        actions.extend(moves)\n        \n        if primitive in env.world.workshop_indices:\n          moves = use_workshop()\n          actions.extend(moves)\n    \n    return actions\n\n  # Generate the sequence of actions to craft the item\n  return craft_item(item)", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T23:20:45.134976", "function_name": "craft", "function_body": "  def heuristic(state, goal):\n    # Calculate the minimum number of steps required to gather all missing primitives\n    current_inventory = state.inventory.copy()\n    required_primitives = env.world.cookbook.primitives_for(goal)\n    \n    total_steps = 0\n    \n    for primitive, count in required_primitives.items():\n      if current_inventory[primitive] < count:\n        # Calculate the number of steps needed to gather each missing primitive\n        steps_needed = (count - current_inventory[primitive])\n        \n        # Prioritize primitives that are closer or more frequently available\n        if env.world.grabbable_indices and primitive in env.world.grabbable_indices:\n          # Example: prioritize primitives that can be picked up from the grid\n          # You might have additional logic here based on grid positions and distances\n          steps_needed = max(1, steps_needed // 2)  # Hypothetical adjustment\n        \n        total_steps += steps_needed\n    \n    return total_steps\n\n  def astar(start_state, goal):\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (heuristic(start_state, goal), start_state, []))\n    \n    visited = set()\n    \n    while open_set:\n      _, current_state, path = heapq.heappop(open_set)\n      \n      if current_state.satisfies(None, goal):\n        return path\n      \n      visited.add(tuple(current_state.grid.flatten()) + tuple(current_state.inventory))\n      \n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Avoid revisiting the same state\n        state_tuple = (tuple(next_state.grid.flatten()) + tuple(next_state.inventory))\n        if state_tuple not in visited:\n          cost = len(path) + 1\n          heapq.heappush(open_set, (cost + heuristic(next_state, goal), next_state, path + [action]))\n    \n    return None\n  \n  start_state = env._current_state\n  actions_sequence = astar(start_state, item)\n  \n  return actions_sequence if actions_sequence is not None else []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T23:20:46.128455", "function_name": "craft", "function_body": "  def heuristic(state, goal):\n    current_inventory = state.inventory.copy()\n    required_primitives = env.world.cookbook.primitives_for(goal)\n    \n    total_steps = 0\n    \n    for primitive, count in required_primitives.items():\n      if current_inventory[primitive] < count:\n        total_steps += (count - current_inventory[primitive])\n    \n    # Additional heuristic: prioritize actions that lead to immediate progress\n    next_state_progress = {}\n    for action in range(env.world.n_actions):\n      _, next_state = state.step(action)\n      next_state_key = tuple(next_state.grid.flatten()) + tuple(next_state.inventory)\n      \n      if any(next_state.inventory[kind] > current_inventory[kind] for kind in required_primitives):\n        total_steps -= 1  # Favor actions that increase the count of required primitives\n        next_state_progress[next_state_key] = True\n    \n    return max(total_steps, 0)  # Ensure non-negative heuristic\n\n  def astar(start_state, goal):\n    from queue import PriorityQueue\n    open_set = PriorityQueue()\n    open_set.put((heuristic(start_state, goal), start_state, []))\n    \n    came_from = {}\n    g_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory): 0}\n    \n    while not open_set.empty():\n      _, current_state, path = open_set.get()\n      \n      if current_state.satisfies(None, goal):\n        return path\n      \n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        next_state_key = tuple(next_state.grid.flatten()) + tuple(next_state.inventory)\n        tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(start_state.inventory)] + 1\n        \n        if (next_state_key not in g_score or\n            tentative_g_score < g_score[next_state_key]):\n          \n          came_from[next_state_key] = (current_state, action)\n          g_score[next_state_key] = tentative_g_score\n          f_score = tentative_g_score + heuristic(next_state, goal)\n          open_set.put((f_score, next_state, path + [action]))\n    \n    return None\n  \n  start_state = env._current_state\n  actions_sequence = astar(start_state, item)\n  \n  return actions_sequence if actions_sequence is not None else []", "island_id": 2, "scores": {"3": 0.0}}
