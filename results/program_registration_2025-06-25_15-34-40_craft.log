{"timestamp": "2025-06-27T10:41:12.146272", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def find_primitives_for_goal(initial_state, goal_item):\n      primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      return primitives\n\n  def collect_primitives(env, primitive_counts):\n      actions = []\n      for primitive, count in primitive_counts.items():\n          while env._current_state.inventory[primitive] < count:\n              # Find actions to gather the required primitive\n              sub_actions = bfs_search(env._current_state, primitive)\n              if not sub_actions:\n                  raise ValueError(f\"Could not find a way to collect {count} of item index {primitive}\")\n              actions.extend(sub_actions)\n              for action in sub_actions:\n                  env.step(action)  # Execute the action to progress\n      return actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  primitive_counts = find_primitives_for_goal(initial_state, goal_item)\n  collection_actions = collect_primitives(env, primitive_counts)\n\n  # Attempt to craft the goal item after collecting all primitives\n  crafting_actions = bfs_search(env._current_state, goal_item)\n  \n  if not crafting_actions:\n      raise ValueError(f\"Could not find a way to craft item index {goal_item} after collecting primitives\")\n\n  return collection_actions + crafting_actions", "island_id": 0, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T10:41:23.351126", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      possible_actions.append((action, 'use', len([p for p in goal_primitives if new_state.inventory[p] >= goal_primitives[p]])))\n              else:\n                  possible_actions.append((action, 'move', 0))\n          \n          # Prioritize USE actions over MOVE actions based on how many primitives are satisfied\n          def prioritize_action(action_tuple):\n              action_type = action_tuple[1]\n              if action_type == 'use':\n                  return (-action_tuple[2],)  # Negative to sort descending by number of satisfied primitives\n              return (0,)  # Move actions have priority 0\n      \n          prioritized_actions = [action for action, _, _ in sorted(possible_actions, key=prioritize_action)]\n          \n          for action in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T10:44:00.918110", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def preprocess_initial_inventory(initial_state, goal_item, cookbook):\n      \"\"\"Preprocess to determine if initial inventory can directly contribute to making the goal item.\"\"\"\n      goal_primitives = get_primitive_counts(goal_item, cookbook)\n      available_primitives = {i: count for i, count in enumerate(initial_state.inventory) if count > 0}\n      \n      # Check if initial inventory satisfies all primitives needed\n      satisfied_primitives = {}\n      for primitive, required_count in goal_primitives.items():\n          if primitive in available_primitives:\n              if available_primitives[primitive] >= required_count:\n                  satisfied_primitives[primitive] = available_primitives[primitive]\n              else:\n                  satisfied_primitives[primitive] = 0\n          else:\n              satisfied_primitives[primitive] = 0\n      \n      return satisfied_primitives\n\n  def get_closest_item_position(state, item_index):\n      \"\"\"Find the closest position of an item within the grid.\"\"\"\n      grid = state.grid\n      positions = np.argwhere(grid[:, :, item_index] > 0)\n      if len(positions) == 0:\n          return None\n      player_pos = state.pos\n      distances = [np.linalg.norm(pos - player_pos, ord=1) for pos in positions]\n      closest_position = positions[np.argmin(distances)]\n      return tuple(closest_position)\n\n  def move_to_position(state, target_position):\n      \"\"\"Generate a sequence of actions to move the player to the target position.\"\"\"\n      current_pos = np.array(state.pos)\n      target_pos = np.array(target_position)\n      \n      # Calculate direction vector\n      direction_vector = target_pos - current_pos\n      \n      action_sequence = []\n      if direction_vector[0] > 0:\n          action_sequence.extend([1] * abs(direction_vector[0]))  # Move right\n      elif direction_vector[0] < 0:\n          action_sequence.extend([3] * abs(direction_vector[0]))  # Move left\n      \n      if direction_vector[1] > 0:\n          action_sequence.extend([2] * abs(direction_vector[1]))  # Move down\n      elif direction_vector[1] < 0:\n          action_sequence.extend([0] * abs(direction_vector[1]))  # Move up\n      \n      return action_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Preprocess: Collect all possible primitives needed for the goal item and check initial inventory satisfaction\n  goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n  initial_satisfied_primitives = preprocess_initial_inventory(initial_state, goal_item, initial_state.world.cookbook)\n\n  action_sequence = []\n  \n  # Check if any primitive is available in the initial inventory and move to it\n  for primitive_index, count in initial_satisfied_primitives.items():\n      if count > 0:\n          closest_position = get_closest_item_position(initial_state, primitive_index)\n          if closest_position:\n              action_sequence.extend(move_to_position(initial_state, closest_position))\n              # Simulate moving to the position\n              for _ in range(len(action_sequence)):\n                  reward, initial_state = initial_state.step(action_sequence[-1])\n  \n  # Perform BFS search to craft the goal item\n  final_action_sequence = bfs_search(initial_state, goal_item)\n  \n  if final_action_sequence:\n      action_sequence.extend(final_action_sequence)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T10:44:02.172996", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def preprocess_initial_inventory(initial_state, goal_item, cookbook):\n      \"\"\"Preprocess to determine if initial inventory can directly contribute to making the goal item.\"\"\"\n      goal_primitives = get_primitive_counts(goal_item, cookbook)\n      available_primitives = {i: count for i, count in enumerate(initial_state.inventory) if count > 0}\n      \n      # Check if initial inventory satisfies all primitives needed\n      satisfied_primitives = {}\n      for primitive, required_count in goal_primitives.items():\n          if primitive in available_primitives:\n              if available_primitives[primitive] >= required_count:\n                  satisfied_primitives[primitive] = available_primitives[primitive]\n              else:\n                  satisfied_primitives[primitive] = 0\n          else:\n              satisfied_primitives[primitive] = 0\n      \n      return satisfied_primitives\n\n  def heuristic(state, goal_item, cookbook):\n      \"\"\"Estimate the minimum number of steps required to reach the goal item.\"\"\"\n      # Calculate the primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, cookbook)\n      \n      # Calculate the current state's contribution towards these primitives\n      available_primitives = {i: count for i, count in enumerate(state.inventory) if count > 0}\n      steps_required = 0\n      \n      for primitive, required_count in goal_primitives.items():\n          if primitive in available_primitives:\n              steps_required += max(0, required_count - available_primitives[primitive])\n          else:\n              steps_required += required_count\n      \n      return steps_required\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          current_cost, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  cost = current_cost + 1 + heuristic(new_state, goal_item, initial_state.world.cookbook)\n                  heapq.heappush(open_set, (cost, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
