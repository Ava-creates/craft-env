is action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  action_sequence.append((new_state, path + [action]))\n          \n          # Sort actions by heuristic: prioritize states closer to having required primitives\n          action_sequence.sort(key=lambda x: sum(\n              min(x[0].inventory[primitive], goal_primitives.get(primitive, 0)) \n              for primitive in goal_primes\n          ), reverse=True)\n          \n          queue.extend(action_sequence)\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_actions(action_sequence):\n      optimized_sequence = []\n      i = 0\n      while i < len(action_sequence):\n          current_action = action_sequence[i]\n          \n          # Check for consecutive USE actions and merge them into a single step\n          if current_action == 4:  # USE action\n              use_count = 1\n              while (i + 1 < len(action_sequence) and \n                     action_sequence[i + 1] == 4):\n                  i += 1\n                  use_count += 1\n              optimized_sequence.append(current_action)\n          else:\n              optimized_sequence.append(current_action)\n          \n          i += 1\n      \n      return optimized_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Precompute the set of all primitives required for the goal item\n  goal_primes = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      return