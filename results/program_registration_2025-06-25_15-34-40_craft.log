{"timestamp": "2025-06-27T12:50:24.147284", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient != \"_key\":\n            dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    from itertools import product\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n\n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      possible_pickups = find_possible_pickups(current_state)\n      possible_use_actions = find_possible_use_actions(current_state)\n      \n      # Prioritize use actions that can contribute to making the goal item\n      for kind, dx, dy in possible_use_actions:\n          action = get_action_from_movement(kind, dx, dy, is_use=True)\n          if action is not None:\n              reward, new_state = current_state.step(action)\n              \n              # Check if the use action can contribute to making the goal item\n              can_make_goal = True\n              for primitive, count in goal_primitives.items():\n                  if new_state.inventory[primitive] < count:\n                      can_make_goal = False\n                      break\n\n              if not can_make_goal:\n                  continue  # Skip this action as it doesn't help make the goal item\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      # Consider pickup actions\n      for kind, dx, dy in possible_pickups:\n          action = get_action_from_movement(kind, dx, dy, is_use=False)\n          if action is not None:\n              reward, new_state = current_state.step(action)\n\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def find_possible_pickups(current_state):\n      possible_actions = []\n      for dx, dy in product([-1, 0, 1], repeat=2):\n          x, y = current_state.pos[0] + dx, current_state.pos[1] + dy\n          if (0 <= x < current_state.grid.shape[0] and \n              0 <= y < current_state.grid.shape[1] and \n              not (dx == 0 and dy == 0)):\n              cell_contents = np.nonzero(current_state.grid[x, y])[0]\n              for kind in cell_contents:\n                  if kind not in current_state.world.non_grabbable_indices:\n                      possible_actions.append((kind, dx, dy))\n      return possible_actions\n\n  def find_possible_use_actions(current_state):\n      possible_actions = []\n      for dx, dy in product([-1, 0, 1], repeat=2):\n          x, y = current_state.pos[0] + dx, current_state.pos[1] + dy\n          if (0 <= x < current_state.grid.shape[0] and \n              0 <= y < current_state.grid.shape[1]):\n              cell_contents = np.nonzero(current_state.grid[x, y])[0]\n              for kind in cell_contents:\n                  possible_actions.append((kind, dx, dy))\n      return possible_actions\n\n  def get_action_from_movement(kind, dx, dy, is_use):\n      import env_factory\n      directions = [(0, -1), (-1, 0), (0, 1), (1, 0)]  # UP, LEFT, DOWN, RIGHT\n      \n      if kind in current_state.world.grab_items:\n          action_index = 2  # GRAB\n      elif kind in current_state.world.use_items and is_use:\n          action_index = 4  # USE\n      else:\n          return None\n      \n      for i, direction in enumerate(directions):\n          if (direction[0] == dx) and (direction[1] == dy):\n              return action_index + i * 5\n      \n      return None\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is a valid index and exists in the cookbook\n  if goal_item < 0 or goal_item >= len(env.world.cookbook.index.ordered_contents):\n    raise ValueError(f\"Invalid goal item index: {goal_item}\")\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-27T12:50:25.473969", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient != \"_key\":\n            dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    from itertools import product\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n\n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      possible_pickups = find_possible_pickups(current_state)\n      possible_use_actions = find_possible_use_actions(current_state)\n      \n      for kind, dx, dy in possible_pickups:\n        new_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n        reward, new_state = current_state.step(4 if current_state.dir == 0 and dx == 0 and dy == -1 else calculate_movement_action(new_pos))\n        \n        # Check if the pickup action can contribute to making the goal item\n        can_make_goal = True\n        for primitive, count in goal_primitives.items():\n          if new_state.inventory[primitive] < count:\n            can_make_goal = False\n            break\n        \n        if can_make_goal:\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_pos, \n                        new_state.dir)\n          \n          if state_hash not in visited:\n            visited.add(state_hash)\n            queue.append((new_state, path + [calculate_movement_action(new_pos)]))\n      \n      for kind, dx, dy in possible_use_actions:\n        new_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n        reward, new_state = current_state.step(4 if current_state.dir == 0 and dx == 0 and dy == -1 else calculate_movement_action(new_pos))\n        \n        # Check if the use action can contribute to making the goal item\n        can_make_goal = True\n        for primitive, count in goal_primitives.items():\n          if new_state.inventory[primitive] < count:\n            can_make_goal = False\n            break\n        \n        if can_make_goal:\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_pos, \n                        new_state.dir)\n          \n          if state_hash not in visited:\n            visited.add(state_hash)\n            queue.append((new_state, path + [calculate_movement_action(new_pos)]))\n    \n    return None  # Return None if no sequence is found\n\n  def find_possible_pickups(current_state):\n      possible_actions = []\n      for dx, dy in product([-1, 0, 1], repeat=2):\n          x, y = current_state.pos[0] + dx, current_state.pos[1] + dy\n          if (0 <= x < current_state.grid.shape[0] and \n              0 <= y < current_state.grid.shape[1] and \n              not (dx == 0 and dy == 0)):\n              cell_contents = np.nonzero(current_state.grid[x, y])[0]\n              for kind in cell_contents:\n                  if kind not in current_state.world.non_grabbable_indices:\n                      possible_actions.append((kind, dx, dy))\n      return possible_actions\n\n  def find_possible_use_actions(current_state):\n      possible_actions = []\n      for dx, dy in product([-1, 0, 1], repeat=2):\n          x, y = current_state.pos[0] + dx, current_state.pos[1] + dy\n          if (0 <= x < current_state.grid.shape[0] and \n              0 <= y < current_state.grid.shape[1]):\n              cell_contents = np.nonzero(current_state.grid[x, y])[0]\n              for kind in cell_contents:\n                  possible_actions.append((kind, dx, dy))\n      return possible_actions\n\n  def calculate_movement_action(new_pos):\n      x_diff = new_pos[0] - env._current_state.pos[0]\n      y_diff = new_pos[1] - env._current_state.pos[1]\n\n      # Define direction mappings\n      directions = {\n          (0, -1): 0,  # North\n          (-1, 0): 1,  # West\n          (0, 1): 2,   # South\n          (1, 0): 3    # East\n      }\n      \n      if x_diff == 0 and y_diff == 0:\n          return 4  # Use action\n      \n      direction = directions.get((x_diff, y_diff))\n      if direction is not None:\n          return direction\n      \n      raise ValueError(f\"Invalid movement direction: {x_diff}, {y_diff}\")\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is a valid index and exists in the cookbook\n  if goal_item < 0 or goal_item >= len(env.world.cookbook.index.ordered_contents):\n    raise ValueError(f\"Invalid goal item index: {goal_item}\")\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-27T12:51:52.049208", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        # Collect primitives needed for the goal item\n        goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n        \n        # Filter actions based on available inventory and required primitives\n        for action in range(initial_state.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            if action == 4:  # USE action\n                # Check if the use action can contribute to making the goal item\n                can_make_goal = True\n                for primitive, count in goal_primitives.items():\n                    if new_state.inventory[primitive] < count:\n                        can_make_goal = False\n                        break\n                \n                if not can_make_goal:\n                    continue  # Skip this action as it doesn't help make the goal item\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def generate_plan(initial_state, goal_item):\n      plan = []\n      \n      while not satisfies_goal(initial_state, goal_item):\n          path = bfs_search(initial_state, goal_item)\n          if path is None:\n              break\n          \n          plan.extend(path)\n          for action in path:\n              reward, done, observations = env.step(action)\n              initial_state = env._current_state\n              if done or satisfies_goal(initial_state, goal_item):\n                  return plan\n      \n      return plan\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = generate_plan(initial_state, goal_item)\n\n  return action_sequence if satisfies_goal(env._current_state, goal_item) else []", "island_id": 3, "scores": {"3": 0.0}}
