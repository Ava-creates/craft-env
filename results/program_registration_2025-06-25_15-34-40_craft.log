    \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:06:41.400830", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_possible_actions(state):\n      possible_actions = []\n      for action in range(env.world.n_actions):\n          _, new_state = state.step(action)\n          if any(new_state.grid.flatten()) or any(new_state.inventory) or new_state.pos != state.pos:\n              possible_actions.append(action)\n      return possible_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          possible_actions = get_possible_actions(current_state)\n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_path(path):\n      \"\"\"Optimizes the given path by removing unnecessary movements.\"\"\"\n      optimized_path = []\n      for i in range(len(path)):\n          action = path[i]\n          if i < len(path) - 1:\n              next_action = path[i + 1]\n              \n              # Combine consecutive opposite moves\n              if (action == 0 and next_action == 1) or (action == 1 and next_action == 0):\n                  continue\n              elif (action == 2 and next_action == 3) or (action == 3 and next_action == 2):\n                  continue\n              \n          optimized_path.append(action)\n      return optimized_path\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + initial_state.pos: 0}\n      f_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + initial_state.pos: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          current_f_score, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          possible_actions = get_possible_actions(current_state)\n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + current_state.pos] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (tuple(current_state.grid.flatten()), \n                                          tuple(current_state.inventory), \n                                          current_state.pos, \n                                          current_state.dir)\n                  g_score[state_hash] = tentative_g_score\n            