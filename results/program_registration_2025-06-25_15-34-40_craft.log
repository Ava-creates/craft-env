{"timestamp": "2025-06-26T08:35:09.121481", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, depth_limit=50):  # Added depth limit to prevent infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= depth_limit:  # Skip paths exceeding the depth limit\n              continue\n          \n          # Prioritize useful actions by checking the next cell for resources or workstations\n          current_pos = current_state.pos\n          current_dir = current_state.dir\n          \n          # Define possible movements and USE action\n          movement_actions = [0, 1, 2, 3]  # UP, DOWN, LEFT, RIGHT\n          use_action = 4\n\n          # Prioritize actions based on the next cell's contents\n          possible_actions = []\n          \n          for move in movement_actions:\n              if current_dir == 0:  # UP\n                  next_pos = (current_pos[0], current_pos[1] - 1)\n              elif current_dir == 1:  # DOWN\n                  next_pos = (current_pos[0], current_pos[1] + 1)\n              elif current_dir == 2:  # LEFT\n                  next_pos = (current_pos[0] - 1, current_pos[1])\n              elif current_dir == 3:  # RIGHT\n                  next_pos = (current_pos[0] + 1, current_pos[1])\n              \n              if env.world.grid_valid(next_pos):\n                  cell_contents = np.argmax(current_state.grid[next_pos], axis=-1)\n                  \n                  # Check if the next cell contains a resource or workstation\n                  if cell_contents in env.world.grabbable_indices:\n                      possible_actions.append(move)\n                      possible_actions.append(use_action)  # Prioritize USE action\n                  elif cell_contents in env.world.workshop_indices:\n                      possible_actions.append(move)\n                      possible_actions.append(use_action)  # Prioritize USE action\n                  else:\n                      possible_actions.append(move)\n          \n          # If no specific actions are found, add general movement and USE actions\n          if not possible_actions:\n              possible_actions = movement_actions + [use_action]\n          \n          # Avoid duplicate actions\n          possible_actions = list(set(possible_actions))\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
