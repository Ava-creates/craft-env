       \n                  if can_make_goal:\n                      valid_actions.append((action, new_state))\n              else:\n                  # For movement actions, only consider them if they lead to a cell with an item needed for the goal\n                  if action == 0:  # DOWN\n                      next_pos = (current_state.pos[0], current_state.pos[1] + 1)\n                  elif action == 1:  # UP\n                      next_pos = (current_state.pos[0], current_state.pos[1] - 1)\n                  elif action == 2:  # LEFT\n                      next_pos = (current_state.pos[0] - 1, current_state.pos[1])\n                  elif action == 3:  # RIGHT\n                      next_pos = (current_state.pos[0] + 1, current_state.pos[1])\n\n                  if 0 <= next_pos[0] < initial_state.world.cookbook.index.n_kinds and 0 <= next_pos[1] < initial_state.world.cookbook.index.n_kinds:\n                      item_index = np.argmax(new_state.grid[next_pos[0], next_pos[1]])\n                      if item_index in goal_primitives or item_index in new_state.inventory:\n                          valid_actions.append((action, new_state))\n\n          # Prioritize USE actions that contribute to making the goal item\n          valid_actions.sort(key=lambda x: 0 if x[0] == 4 else 1)\n          \n          for action, new_state in valid_actions:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
