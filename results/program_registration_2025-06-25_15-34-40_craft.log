{"timestamp": "2025-06-27T14:33:19.466112", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          next_actions = get_next_actions(current_state, goal_item, goal_primitives)\n          \n          for action, new_state in next_actions:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_next_actions(current_state, goal_item, goal_primitives):\n      actions = []\n      \n      for action in range(current_state.world.n_actions):\n          reward, new_state = current_state.step(action)\n          \n          if action == 4:  # USE action\n              # Check if the use action can contribute to making the goal item\n              can_make_goal = True\n              for primitive, count in goal_primitives.items():\n                  available_primitive_count = current_state.inventory[primitive] + (new_state.inventory[primitive] - current_state.inventory[primitive])\n                  if available_primitive_count < count:\n                      can_make_goal = False\n                      break\n              \n              if not can_make_goal:\n                  continue  # Skip this action as it doesn't help make the goal item\n      \n          actions.append((action, new_state))\n      \n      return actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      return []  # Return empty list if no actions found\n\n  # Post-process: Validate the sequence of actions to ensure they lead to the goal item\n  state = initial_state\n  for action in action_sequence:\n      _, state = state.step(action)\n      \n  if satisfies_goal(state, goal_item):\n      return action_sequence\n  else:\n      return []  # Return empty list if the sequence is invalid", "island_id": 2, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T14:36:00.605445", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(current_state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from current_state to reach the goal_item.\"\"\"\n      primitives_needed = get_primitive_counts(goal_item, current_state.world.cookbook)\n      current_primitives = {i: count for i, count in enumerate(current_state.inventory) if count > 0 and i in primitives_needed}\n      \n      # Calculate the total number of steps needed based on available primitives\n      steps_needed = 0\n      for primitive, required_count in primitives_needed.items():\n          available_count = current_primitives.get(primitive, 0)\n          steps_needed += max(0, (required_count - available_count) // primitives_needed[primitive])\n      \n      return steps_needed\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import itertools\n      \n      open_set = []\n      open_heap_counter = itertools.count()  # Unique sequence count for heap stability\n      heappush(open_set, (heuristic(initial_state, goal_item), next(open_heap_counter), initial_state, []))\n      \n      visited = set()\n      \n      while open_set:\n          _, _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heappush(open_set, (\n                      len(path) + 1 + heuristic(new_state, goal_item),\n                      next(open_heap_counter),\n                      new_state,\n                      path + [action]\n                  ))\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_path(path, initial_state):\n      \"\"\"Optimize the given action sequence to minimize unnecessary movements.\"\"\"\n      optimized_path = []\n      current_state = initial_state\n      last_action = -1\n      \n      for action in path:\n          reward, new_state = current_state.step(action)\n          \n          if action != last_action or len(optimized_path) == 0:\n              optimized_path.append(action)\n          \n          current_state = new_state\n          last_action = action\n      \n      return optimized_path\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in initial_state.world.cookbook.index.reverse_contents:\n      raise ValueError(f\"Goal item index {goal_item} not recognized by the cookbook.\")\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n  \n  if action_sequence is None:\n      return []  # Return empty list if no actions found\n  \n  optimized_action_sequence = optimize_path(action_sequence, initial_state)\n\n  return optimized_action_sequence", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-06-27T14:36:01.956619", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(current_state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from current_state to reach the goal_item.\"\"\"\n      primitives_needed = get_primitive_counts(goal_item, current_state.world.cookbook)\n      current_primitives = {i: count for i, count in enumerate(current_state.inventory) if count > 0 and i in primitives_needed}\n      \n      # Calculate the total number of steps needed based on available primitives\n      steps_needed = 0\n      for primitive, required_count in primitives_needed.items():\n          available_count = current_primitives.get(primitive, 0)\n          steps_needed += max(0, (required_count - available_count) // primitives_needed[primitive])\n      \n      return steps_needed\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import itertools\n      \n      open_set = []\n      open_heap_counter = itertools.count()  # Unique sequence count for heap stability\n      heappush(open_set, (heuristic(initial_state, goal_item), next(open_heap_counter), initial_state, []))\n      \n      visited = set()\n      \n      while open_set:\n          _, _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heappush(open_set, (\n                      len(path) + 1 + heuristic(new_state, goal_item),\n                      next(open_heap_counter),\n                      new_state,\n                      path + [action]\n                  ))\n      \n      return None  # Return None if no sequence is found\n\n  def dynamic_heuristic(current_state, goal_item):\n      \"\"\"Dynamic heuristic function to estimate the cost from current_state to reach the goal_item.\"\"\"\n      primitives_needed = get_primitive_counts(goal_item, current_state.world.cookbook)\n      current_primitives = {i: count for i, count in enumerate(current_state.inventory) if count > 0 and i in primitives_needed}\n      \n      # Calculate the total number of steps needed based on available primitives\n      steps_needed = 0\n      \n      # Check if there are any workbenches nearby that can help reduce the cost\n      workbench_positions = [(x, y) for x in range(current_state.world.grid.shape[0]) \n                             for y in range(current_state.world.grid.shape[1]) \n                             if current_state.world.grid[x, y] == 3]  # Assuming 3 represents a workbench\n      \n      for primitive, required_count in primitives_needed.items():\n          available_count = current_primitives.get(primitive, 0)\n          \n          # If there are enough primitives, no need to add extra steps\n          if available_count >= required_count:\n              continue\n          \n          # Calculate the closest workbench distance (if any) that can provide the required primitive\n          min_distance = float('inf')\n          for wx, wy in workbench_positions:\n              dx = abs(wx - current_state.pos[0])\n              dy = abs(wy - current_state.pos[1])\n              distance = dx + dy  # Manhattan distance\n              \n              if distance < min_distance:\n                  min_distance = distance\n          \n          # Add the distance to the heuristic cost if there is a workbench nearby\n          if min_distance != float('inf'):\n              steps_needed += min_distance\n      \n      return steps_needed\n\n  def dynamic_a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import itertools\n      \n      open_set = []\n      open_heap_counter = itertools.count()  # Unique sequence count for heap stability\n      heappush(open_set, (dynamic_heuristic(initial_state, goal_item), next(open_heap_counter), initial_state, []))\n      \n      visited = set()\n      \n      while open_set:\n          _, _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heappush(open_set, (\n                      len(path) + 1 + dynamic_heuristic(new_state, goal_item),\n                      next(open_heap_counter),\n                      new_state,\n                      path + [action]\n                  ))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in initial_state.world.cookbook.index.reverse_contents:\n      raise ValueError(f\"Goal item index {goal_item} not recognized by the cookbook.\")\n  \n  action_sequence = dynamic_a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
