{"timestamp": "2025-06-27T15:01:31.644987", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = [a for a in range(initial_state.world.n_actions)]\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def preprocess_goal(initial_state, goal_item):\n      # Collect all possible primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      return goal_primitives\n\n  def get_nearest_resource(state, resource_index):\n      from scipy.spatial.distance import cdist\n      \n      positions = np.argwhere(state.grid[:, :, resource_index] == 1)\n      if not positions.size:\n          return None\n      agent_pos = np.array(state.pos).reshape(1, -1)\n      distances = cdist(agent_pos, positions)\n      nearest_position = tuple(positions[np.argmin(distances)].tolist())\n      return nearest_position\n\n  def move_to_and_pick_up(state, resource_index):\n      target_pos = get_nearest_resource(state, resource_index)\n      if not target_pos:\n          return []\n      \n      actions = []\n      current_pos = state.pos\n      \n      while current_pos != target_pos:\n          dx = target_pos[0] - current_pos[0]\n          dy = target_pos[1] - current_pos[1]\n          \n          if dx < 0 and state.dir == 3:  # Move left\n              actions.append(2)\n          elif dx > 0 and state.dir == 1:  # Move right\n              actions.append(3)\n          elif dy < 0 and state.dir == 0:  # Move up\n              actions.append(1)\n          elif dy > 0 and state.dir == 2:  # Move down\n              actions.append(0)\n          \n          reward, new_state = state.step(actions[-1])\n          current_pos = new_state.pos\n      \n      # Pick up the resource\n      actions.append(4)\n      \n      return actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Preprocess: Collect all possible primitives needed for the goal item\n  goal_primitives = preprocess_goal(initial_state, goal_item)\n  \n  action_sequence = []\n  \n  while not satisfies_goal(env._current_state, goal_item):\n      state = env._current_state\n      \n      # Check if we have enough resources to make the goal item\n      can_make_goal = True\n      for primitive, count in goal_primitives.items():\n          if state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n      \n      if not can_make_goal:\n          # Find and pick up missing resources\n          for primitive, required_count in goal_primitives.items():\n              while state.inventory[primitive] < required_count:\n                  actions_to_pick_up = move_to_and_pick_up(state, primitive)\n                  action_sequence.extend(actions_to_pick_up)\n                  reward, new_state = env._current_state.step(4)  # Pick up the resource\n          continue\n      \n      # If we have enough resources, try to make the goal item using BFS\n      actions_to_make_goal = bfs_search(env._current_state, goal_item)\n      \n      if actions_to_make_goal:\n          action_sequence.extend(actions_to_make_goal)\n      else:\n          break  # Unable to find a sequence to make the goal item\n  \n  return action_sequence", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-27T15:03:30.803627", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              for ingredient, amount in cookbook.recipes[current_index].items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_required_primitives(primitive_counts, current_inventory):\n      \"\"\"Determine which primitives are still needed based on current inventory.\"\"\"\n      required_primitives = {}\n      for primitive, count in primitive_counts.items():\n          needed = count - current_inventory[primitive]\n          if needed > 0:\n              required_primitives[primitive] = needed\n      return required_primitives\n\n  def gather_primitive(initial_state, primitive_index):\n      \"\"\"Gather the specified primitive and return the sequence of actions.\"\"\"\n      return bfs_search(initial_state, primitive_index)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = []\n\n  # Determine primitives needed for the goal item\n  primitive_counts = get_primitive_counts(goal_item, initial_state.world.cookbook)\n  \n  while not satisfies_goal(initial_state, goal_item):\n      required_primitives = get_required_primitives(primitive_counts, initial_state.inventory)\n      \n      if not required_primitives:\n          break\n      \n      # Collect actions to gather each required primitive\n      for primitive, needed_count in required_primitives.items():\n          # Perform a BFS to find actions needed to gather the current primitive\n          while initial_state.inventory[primitive] < needed_count:\n              primitive_path = bfs_search(initial_state, primitive)\n              \n              if primitive_path is None:\n                  return []  # Unable to gather the primitive, return empty list\n      \n              action_sequence.extend(primitive_path)\n              \n              # Simulate taking the actions to update the state\n              for action in primitive_path:\n                  reward, initial_state = initial_state.step(action)\n\n      # Attempt to make the goal item using the collected primitives\n      goal_path = bfs_search(initial_state, goal_item)\n      \n      if goal_path is None:\n          return []  # Unable to make the goal item, return empty list\n      \n      action_sequence.extend(goal_path)\n      \n      # Simulate taking the actions to update the state\n      for action in goal_path:\n          reward, initial_state = initial_state.step(action)\n\n  return action_sequence if satisfies_goal(initial_state, goal_item) else []  # Return empty list if goal not satisfied", "island_id": 2, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T15:03:39.314075", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_required_primitives(primitive_counts, current_inventory):\n      \"\"\"Determine which primitives are still needed based on current inventory.\"\"\"\n      required_primitives = {}\n      for primitive, count in primitive_counts.items():\n          needed = count - current_inventory[primitive]\n          if needed > 0:\n              required_primitives[primitive] = needed\n      return required_primitives\n\n  def gather_primitives(env, initial_state, required_primitives):\n      action_sequence = []\n      current_state = initial_state\n      \n      for primitive in required_primitives:\n          # Perform a BFS to find actions needed to gather the current primitive\n          primitive_path = bfs_search(current_state, primitive)\n          \n          if primitive_path is None:\n              return None, []  # Unable to gather the primitive, return None and empty list\n      \n          action_sequence.extend(primitive_path)\n          \n          # Simulate taking the actions to update the state\n          for action in primitive_path:\n              reward, current_state = current_state.step(action)\n      \n      return current_state, action_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = []\n\n  while not satisfies_goal(initial_state, goal_item):\n      # Determine primitives needed for the goal item\n      primitive_counts = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      required_primitives = get_required_primitives(primitive_counts, initial_state.inventory)\n      \n      if not required_primitives:\n          break\n      \n      # Gather the required primitives\n      new_state, gather_actions = gather_primitives(env, initial_state, required_primitives)\n      \n      if new_state is None:\n          return []  # Unable to gather the primitive, return empty list\n      \n      action_sequence.extend(gather_actions)\n      initial_state = new_state\n      \n      # Attempt to make the goal item using the collected primitives\n      goal_path = bfs_search(initial_state, goal_item)\n      \n      if goal_path is None:\n          return []  # Unable to make the goal item, return empty list\n      \n      action_sequence.extend(goal_path)\n      \n      # Simulate taking the actions to update the state\n      for action in goal_path:\n          reward, initial_state = initial_state.step(action)\n\n  return action_sequence if satisfies_goal(initial_state, goal_item) else []  # Return empty list if goal not satisfied", "island_id": 2, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T15:05:54.540777", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n    \n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n    \n    dfs(goal_index)\n    return primitives\n\n  def get_closest_resource(state, resource_indices):\n    \"\"\"Find the closest resource of any given type using BFS.\"\"\"\n    from collections import deque\n    \n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    queue = deque([(state.pos, [])])\n    visited = set([state.pos])\n    \n    while queue:\n      current_pos, path = queue.popleft()\n      \n      if any(state.grid[current_pos[0], current_pos[1], resource_index] > 0 for resource_index in resource_indices):\n        return path\n      \n      for d in directions:\n        new_pos = (current_pos[0] + d[0], current_pos[1] + d[1])\n        \n        if (0 <= new_pos[0] < state.grid.shape[0] and \n            0 <= new_pos[1] < state.grid.shape[1] and \n            new_pos not in visited):\n          visited.add(new_pos)\n          queue.append((new_pos, path + [move_towards(state.pos, new_pos)]))\n    \n    return None\n\n  def move_towards(current_pos, target_pos) -> int:\n    \"\"\"Determine the action to move towards the target position.\"\"\"\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n    \n    if abs(dx) > abs(dy):\n      return 2 if dx < 0 else 3\n    else:\n      return 0 if dy < 0 else 1\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n          \n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def execute_actions(env, actions):\n    for action in actions:\n      env.step(action)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available in inventory\n  if satisfies_goal(initial_state, goal_item):\n    return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n    return []  # Return empty list if no actions found\n\n  execute_actions(env, action_sequence)\n  return action_sequence", "island_id": 4, "scores": {"3": 2.0}}
