ep(action)\n              \n              current_state = new_state\n      \n      return action_sequence\n\n  def craft_item(env, initial_state, goal_item):\n      action_sequence = []\n      current_state = initial_state\n      \n      while not satisfies_goal(current_state, goal_item):\n          craft_action_sequence = bfs_search(current_state, goal_item)\n          if not craft_action_sequence:\n              return None  # Crafting failed\n          \n          action_sequence.extend(craft_action_sequence)\n          new_state = current_state\n          for action in craft_action_sequence:\n              _, new_state = new_state.step(action)\n          \n          current_state = new_state\n      \n      return action_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  cookbook = env.world.cookbook\n  \n  # First, collect all required primitives\n  primitives_needed = cookbook.primitives_for(goal_item)\n  \n  collect_action_sequence = collect_primitives(env, initial_state, primitives_needed)\n  if not collect_action_sequence:\n      return []  # Primitive collection failed\n  \n  action_sequence = collect_action_sequence\n  new_state = initial_state\n  for action in collect_action_sequence:\n      _, new_state = new_state.step(action)\n  \n  # After collecting primitives, craft the item\n  craft_action_sequence = craft_item(env, new_state, goal_item)\n  if not craft_action_sequence:\n      return []  # Crafting failed\n  \n  action_sequence.extend(craft_action_sequence)\n  return action_sequence", "island_id": 3, "scores": {"3": 0.9}}
{"timestamp": "2025-06-26T10:29:06.068392", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_next_states(current_state):\n      next_states = []\n      for action in range(env.world.n_actions):\n          reward, new_state = current_state.step(action)\n          # Only add to the queue if the agent's position or inventory has changed\n          if (new_state.pos != current_state.pos or \n              not np.array_equal(new_state.inventory, current_state.inventory)):\n              next_states.append((action, new_state))\n      return next_states\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, new_state in get_next_states(current_state):\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence is not None:\n      # Execute the actions to reach the goal state\n      for action in action_sequence:\n          reward, done, observations = env.step(action)\n          if done:\n              break\n\n  return action_sequence if action_sequence 