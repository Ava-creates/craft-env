{"timestamp": "2025-06-27T08:30:21.790300", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_item):\n      # Estimate the cost to reach the goal based on missing primitives\n      goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n      current_inventory = state.inventory\n      \n      total_cost = 0\n      for primitive, required_count in goal_primitives.items():\n          if current_inventory[primitive] < required_count:\n              total_cost += (required_count - current_inventory[primitive])\n      \n      return total_cost\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + (initial_state.pos, initial_state.dir): 0}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              state_hash = tuple(new_state.grid.flatten()) + tuple(new_state.inventory) + (new_state.pos, new_state.dir)\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos, current_state.dir)] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (tuple(current_state.grid.flatten()), tuple(current_state.inventory), current_state.pos, current_state.dir), action\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-27T08:31:44.759293", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          possible_actions = []\n          actions_considered = set()  # To avoid duplicate action consideration\n\n          for action in range(initial_state.world.n_actions):\n              if action in actions_considered:\n                  continue\n              \n              reward, new_state = current_state.step(action)\n\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n                            \n              # If this state has been visited before, skip it to avoid cycles\n              if state_hash in visited:\n                  continue\n\n              actions_considered.add(action)  # Mark this action as considered for this state\n\n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              possible_actions.append((action, new_state))\n          \n          # Sort actions to prioritize USE actions that bring us closer to the goal\n          possible_actions.sort(key=lambda x: (x[0] != 4) or not satisfies_goal(x[1], goal_item))\n\n          for action, new_state in possible_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 2.0}}
