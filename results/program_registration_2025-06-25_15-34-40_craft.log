{"timestamp": "2025-06-26T16:01:34.920801", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate actions prioritizing crafting and using items\n          actions = generate_actions(current_state)\n          \n          for action in actions:\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_reachable_items(state):\n      \"\"\"Determine which items can be crafted or used from the current inventory.\"\"\"\n      cookbook = env.world.cookbook\n      reachable_items = set()\n      \n      for i in range(len(cookbook.index)):\n          recipe = cookbook.recipes.get(i, {})\n          \n          # Check if all ingredients are available in the inventory\n          if all(state.inventory[ingredient] >= count for ingredient, count in recipe.items()):\n              reachable_items.add(i)\n      \n      return reachable_items\n\n  def generate_actions(state):\n      \"\"\"Generate a list of actions prioritizing crafting and using items.\"\"\"\n      cookbook = env.world.cookbook\n      actions = []\n      \n      # Prioritize USE action if any item can be crafted or used\n      reachable_items = get_reachable_items(state)\n      if reachable_items:\n          actions.append(4)  # Append USE action\n      \n      # Add movement actions in a strategic order (e.g., prioritize moving towards workshops)\n      workshop_indices = env.world.workshop_indices\n      current_pos = state.pos\n      directions = [(0, -1), (-1, 0), (0, 1), (1, 0)]  # UP, LEFT, DOWN, RIGHT\n      \n      for d in range(4):\n          new_pos = (current_pos[0] + directions[d][0], current_pos[1] + directions[d][1])\n          \n          if any(state.grid[new_pos] == w for w in workshop_indices):\n              actions.append(d)\n      \n      # Add remaining movement actions\n      actions.extend([d for d in range(4) if d not in actions])\n      \n      return actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:01:35.902390", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate actions in a more strategic order to prioritize crafting and using items\n          for action in generate_actions(current_state):\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_reachable_items(state):\n      \"\"\"Determine which items can be crafted or used from the current inventory.\"\"\"\n      cookbook = env.world.cookbook\n      reachable_items = set()\n      \n      for i in range(len(cookbook.index)):\n          recipe = cookbook.recipes.get(i, {})\n          \n          # Check if all ingredients are available in the inventory\n          if all(state.inventory[ingredient] >= count for ingredient, count in recipe.items()):\n              reachable_items.add(i)\n      \n      return reachable_items\n\n  def generate_actions(state):\n      \"\"\"Generate a list of actions prioritizing crafting and using items.\"\"\"\n      cookbook = env.world.cookbook\n      actions = []\n      \n      # Prioritize USE action if any item can be crafted or used\n      reachable_items = get_reachable_items(state)\n      if reachable_items:\n          actions.append(4)  # Append USE action\n      \n      # Add movement actions in a strategic order (e.g., prioritize moving towards workshops and primitive resources)\n      workshop_indices = env.world.workshop_indices\n      primitive_indices = env.world.primitives\n      current_pos = state.pos\n      directions = [(0, -1), (-1, 0), (0, 1), (1, 0)]  # UP, LEFT, DOWN, RIGHT\n      \n      for d in range(4):\n          new_pos = (current_pos[0] + directions[d][0], current_pos[1] + directions[d][1])\n          \n          if any(state.grid[new_pos] == w for w in workshop_indices) or \\\n             any(state.grid[new_pos] == p for p in primitive_indices):\n              actions.append(d)\n      \n      # Add remaining movement actions\n      actions.extend([d for d in range(4) if d not in actions])\n      \n      return actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:02:27.166252", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic based on the number of primitives required\n      needed_primitives = env.world.cookbook.primitives_for(goal_item)\n      current_primitives = {k: current_state.inventory[k] for k in needed_primitives}\n      return sum(max(0, needed_primitives[k] - current_primitives.get(k, 0)) for k in needed_primitives)\n\n  def astar_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory): 0}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              state_hash = tuple(new_state.grid.flatten()) + tuple(new_state.inventory)\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory)] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[new_state] = (current_state, path)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current, path):\n      while current in came_from:\n          (current, path) = came_from[current]\n      return path[::-1]  # Reverse the path to start from initial state\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-06-26T16:02:28.142304", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: distance to the nearest primitive needed for the goal\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      grid_primitives = np.any([state.grid[:, :, p] for p in primitives], axis=0)\n\n      if not np.any(grid_primitives):\n          return float('inf')  # No primitive found on the grid\n\n      pos = np.array(state.pos)\n      distances = np.linalg.norm(np.argwhere(grid_primitives) - pos, axis=1)\n      return min(distances)\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      \n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each action has cost 1\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, path + [action])\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:04:02.747217", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate actions in a more strategic order to prioritize crafting and using items\n          prioritized_actions = [4]  # Prioritize USE action (index 4)\n          non_prioritized_actions = list(range(4))  # Move, turn actions\n\n          for action in prioritized_actions + non_prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def dfs_search(initial_state, goal_item, max_depth=50):\n      from collections import deque\n      \n      stack = deque([(initial_state, [])])\n      visited = set()\n      \n      while stack:\n          current_state, path = stack.pop()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate actions in a more strategic order to prioritize crafting and using items\n          prioritized_actions = [4]  # Prioritize USE action (index 4)\n          non_prioritized_actions = list(range(4))  # Move, turn actions\n\n          if len(path) < max_depth:\n              for action in prioritized_actions + non_prioritized_actions:\n                  reward, new_state = current_state.step(action)\n                  \n                  if reward < 0:  # Skip invalid actions that incur penalties\n                      continue\n                  \n                  # Convert the new state to a hashable form using a tuple of its attributes\n                  state_hash = (tuple(new_state.grid.flatten()), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir)\n                  \n                  if state_hash not in visited:\n                      visited.add(state_hash)\n                      stack.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function to estimate the cost to reach the goal.\"\"\"\n      # Simple heuristic: check if the item is already in inventory\n      if state.inventory[goal_item] > 0:\n          return 0\n      else:\n          return 1  # A simple non-zero heuristic value\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          current_cost, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate actions in a more strategic order to prioritize crafting and using items\n          prioritized_actions = [4]  # Prioritize USE action (index 4)\n          non_prioritized_actions = list(range(4))  # Move, turn actions\n\n          for action in prioritized_actions + non_prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  cost = current_cost + 1  # Increment the step count\n                  estimated_cost = cost + heuristic(new_state, goal_item)  # Use the heuristic to estimate the total cost\n                  heapq.heappush(open_set, (estimated_cost, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start A* search to find the action sequence\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:04:32.886748", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic: prioritize states with more items in inventory\n      return -sum(current_state.inventory)\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import itertools\n      \n      open_set = []\n      open_dict = {}\n      \n      closed_set = set()\n      \n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      count = itertools.count()  # Unique counter to break ties in the priority queue\n      heappush(open_set, (f_score[initial_state], next(count), initial_state))\n      open_dict[initial_state] = (f_score[initial_state], next(count))\n      \n      came_from = {}\n      \n      while open_set:\n          _, __, current_state = heappop(open_set)\n          del open_dict[current_state]\n          \n          if satisfies_goal(current_state, goal_item):\n              path = []\n              while current_state in came_from:\n                  path.append(came_from[current_state][1])\n                  current_state = came_from[current_state][0]\n              return list(reversed(path))\n          \n          closed_set.add(tuple((tuple(current_state.grid.flatten()), \n                                tuple(current_state.inventory), \n                                current_state.pos, \n                                current_state.dir)))\n          \n          # Generate actions in a more strategic order to prioritize crafting and using items\n          prioritized_actions = [4]  # Prioritize USE action (index 4)\n          non_prioritized_actions = list(range(4))  # Move, turn actions\n\n          for action in prioritized_actions + non_prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assume each action has a cost of 1\n              \n              if state_hash not in closed_set and (\n                  state_hash not in open_dict or \n                  tentative_g_score < g_score[new_state]\n              ):\n                  came_from[tuple(state_hash)] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  \n                  if state_hash in open_dict:\n                      del open_dict[state_hash]\n                  \n                  count_val = next(count)\n                  heappush(open_set, (f_score[new_state], count_val, new_state))\n                  open_dict[new_state] = (f_score[new_state], count_val)\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start A* search to find the action sequence\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:05:31.118076", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the environment is reset for a fresh start\n  env.reset()\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T16:05:32.148358", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      from collections import namedtuple\n      \n      # Define the node structure\n      Node = namedtuple('Node', ['state', 'path', 'cost'])\n      \n      open_set = PriorityQueue()\n      open_set.put(Node(state=initial_state, path=[], cost=0))\n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + initial_state.pos + (initial_state.dir,): 0}\n      \n      while not open_set.empty():\n          current_node = open_set.get()\n          \n          if satisfies_goal(current_node.state, goal_item):\n              return current_node.path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_node.state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[tuple(current_node.state.grid.flatten()) + tuple(current_node.state.inventory) + current_node.state.pos + (current_node.state.dir,)] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (tuple(current_node.state.grid.flatten()), \n                                          tuple(current_node.state.inventory), \n                                          current_node.state.pos, \n                                          current_node.state.dir)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put(Node(state=new_state, path=current_node.path + [action], cost=f_score))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: count the number of resources needed to craft the goal\n      primitives_needed = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory.copy()\n      \n      total_cost = 0\n      for primitive_index, count in primitives_needed.items():\n          if current_inventory[primitive_index] < count:\n              total_cost += (count - current_inventory[primitive_index])\n      \n      return total_cost\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
