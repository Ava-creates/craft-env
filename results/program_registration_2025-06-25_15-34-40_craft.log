{"timestamp": "2025-06-27T01:57:52.348011", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          if not np.array_equal(new_state.grid, state.grid) or not np.array_equal(new_state.inventory, state.inventory) or new_state.pos != state.pos or new_state.dir != state.dir:\n              valid_actions.append((action, new_state))\n      return valid_actions\n\n  def heuristic(state, goal_item):\n      # A simple heuristic: distance to the closest workshop\n      if goal_item in env.world.workshop_indices:\n          workshops = np.argwhere(state.grid[:, :, goal_item] == 1)\n          if len(workshops) > 0:\n              agent_pos = np.array(state.pos)\n              distances = [np.linalg.norm(agent_pos - workshop, ord=1) for workshop in workshops]\n              return min(distances)\n      return 0\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))  # (f_score, state, path)\n      g_scores = {hash(initial_state): 0}\n      \n      while open_set:\n          f_score, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, new_state in get_valid_actions(current_state):\n              tentative_g_score = g_scores[hash(current_state)] + 1  # Cost of each step is 1\n              \n              state_hash = hash(new_state)\n              if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n                  g_scores[state_hash] = tentative_g_score\n                  f_scores[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_scores[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-27T01:59:27.233908", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos, grid_shape):\n      x, y = pos\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      neighbors = []\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              neighbors.append((nx, ny))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Determine the agent's position and grid shape\n          pos = current_state.pos\n          grid_shape = current_state.grid.shape[:2]\n          \n          # Consider moving to adjacent cells or using an item\n          for action in range(env.world.n_actions):\n              if action < 4:  # Movement actions (DOWN, UP, LEFT, RIGHT)\n                  new_pos = get_neighbors(pos, grid_shape)[action % 4]  # Ensure valid index\n                  reward, new_state = current_state.step(action)\n              else:  # USE action\n                  reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Ensure the goal item is a valid index\n  if goal_item not in range(env.world.cookbook.n_kinds):\n      raise ValueError(\"Invalid goal item index.\")\n  \n  # Check if the goal item can be crafted based on available primitives and environment items\n  primitives_required = env.world.cookbook.primitives_for(goal_item)\n  available_primitives = {idx: initial_state.inventory[idx] for idx in env.world.grabbable_indices}\n  \n  # Verify that all required primitives are either in inventory or the environment\n  if not all(primitive in available_primitives or primitive in env.world.environment for primitive in primitives_required):\n      raise ValueError(\"Goal item cannot be crafted with the available items and environment.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 1.5}}
