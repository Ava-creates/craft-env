{"timestamp": "2025-06-27T08:35:01.598972", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def plan_actions(env, goal_item):\n      initial_state = env._current_state\n      action_sequence = []\n      max_attempts = 5  # To prevent infinite loops in case of unsolvable goals or bugs\n      attempts = 0\n      \n      while not satisfies_goal(initial_state, goal_item) and attempts < max_attempts:\n          path = bfs_search(initial_state, goal_item)\n          if path is None:\n              break\n          \n          action_sequence.extend(path)\n          \n          # Apply the found actions to the environment\n          for action in path:\n              reward, done, observations = env.step(action)\n              \n              if done or satisfies_goal(env._current_state, goal_item):\n                  return action_sequence\n          \n          initial_state = env._current_state\n          attempts += 1\n\n      return action_sequence if satisfies_goal(env._current_state, goal_item) else []\n\n  # Plan and execute the actions to craft the item\n  return plan_actions(env, item)", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T08:35:12.194237", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        # Collect primitives needed for the goal item\n        goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n        \n        # Filter actions based on available inventory and required primitives\n        for action in range(initial_state.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            if action == 4:  # USE action\n                # Check if the use action can contribute to making the goal item\n                can_make_goal = True\n                for primitive, count in goal_primitives.items():\n                    if new_state.inventory[primitive] < count:\n                        can_make_goal = False\n                        break\n                \n                if not can_make_goal:\n                    continue  # Skip this action as it doesn't help make the goal item\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = []\n  max_attempts = 10  # Increase attempts to handle more complex recipes\n  attempts = 0\n      \n  while not satisfies_goal(initial_state, goal_item) and attempts < max_attempts:\n      path = bfs_search(initial_state, goal_item)\n      if path is None:\n          break\n      \n      action_sequence.extend(path)\n      \n      # Apply the found actions to the environment\n      for action in path:\n          reward, done, observations = env.step(action)\n          \n          if done or satisfies_goal(env._current_state, goal_item):\n              return action_sequence\n      \n      initial_state = env._current_state\n      attempts += 1\n\n  return action_sequence if satisfies_goal(env._current_state, goal_item) else []", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T08:36:40.047259", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          \n          # Prioritize USE action if any primitive is next to the agent\n          use_action_possible = False\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = all(new_state.inventory[primitive] >= count for primitive, count in goal_primitives.items())\n                  if can_make_goal and any(current_state.next_to(primitive) for primitive in goal_primitives):\n                      possible_actions.insert(0, action)\n                      use_action_possible = True\n              else:  # MOVEMENT actions (DOWN, UP, LEFT, RIGHT)\n                  if not use_action_possible:\n                      possible_actions.append(action)\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.7}}
{"timestamp": "2025-06-27T08:36:55.714861", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def is_next_to(state, kind):\n      x, y = state.pos\n      neighborhood = [\n          (x-1, y), (x+1, y),\n          (x, y-1), (x, y+1),\n          (x-1, y-1), (x-1, y+1),\n          (x+1, y-1), (x+1, y+1)\n      ]\n      for nx, ny in neighborhood:\n          if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n              if state.grid[nx, ny, kind] > 0:\n                  return True\n      return False\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = all(new_state.inventory[primitive] >= count for primitive, count in goal_primitives.items())\n                  # Check if any required primitive is next to the agent\n                  primitives_next_to_agent = [is_next_to(current_state, primitive) for primitive in goal_primitives]\n                  if can_make_goal and any(primitives_next_to_agent):\n                      possible_actions.insert(0, action)  # Prioritize USE actions\n              else:  # MOVEMENT actions (DOWN, UP, LEFT, RIGHT)\n                  possible_actions.append(action)\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.7}}
