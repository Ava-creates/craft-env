{"timestamp": "2025-06-26T06:35:50.505998", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action and then MOVEMENTS (DOWN, UP, LEFT, RIGHT)\n          for action in [4] + list(range(4)):\n              reward, new_state = current_state.step(action)\n\n              # Skip invalid moves and penalized actions\n              if reward < 0 or new_state == current_state:\n                  continue\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T06:36:06.326862", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos, grid_width, grid_height):\n      x, y = pos\n      neighbors = []\n      if x > 0: neighbors.append((x-1, y))\n      if x < grid_width - 1: neighbors.append((x+1, y))\n      if y > 0: neighbors.append((x, y-1))\n      if y < grid_height - 1: neighbors.append((x, y+1))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          grid_width = current_state.grid.shape[0]\n          grid_height = current_state.grid.shape[1]\n          pos = current_state.pos\n          \n          # Get neighbors to move to\n          neighbors = get_neighbors(pos, grid_width, grid_height)\n          \n          for action in [4] + list(range(4)):  # Prioritize USE action\n              reward, new_state = current_state.step(action)\n\n              # Skip invalid moves and penalized actions\n              if reward < 0 or new_state == current_state:\n                  continue\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T06:37:08.056806", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic: count the number of items in the inventory that are not needed for the goal\n      recipe = env.world.cookbook.primitives_for(goal_item)\n      required_items = set(recipe.keys())\n      total_inventory_value = sum(current_state.inventory)\n\n      if total_inventory_value == 0:\n          return float('inf')  # No items in inventory, heuristic is high\n\n      unused_items_count = sum(count for idx, count in enumerate(current_state.inventory) \n                               if idx not in required_items)\n      \n      return unused_items_count\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action and then MOVEMENTS (DOWN, UP, LEFT, RIGHT)\n          for action in [4] + list(range(4)):\n              reward, new_state = current_state.step(action)\n\n              # Skip invalid moves and penalized actions\n              if reward < 0 or new_state == current_state:\n                  continue\n\n              tentative_g_score = g_score[current_state] + 1\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T06:37:09.031899", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: distance to nearest workshop\n      world = state.world\n      pos_x, pos_y = state.pos\n      \n      min_distance = float('inf')\n      for x, y in world.workshop_indices:\n          distance = abs(x - pos_x) + abs(y - pos_y)\n          if distance < min_distance:\n              min_distance = distance\n\n      return min_distance\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n\n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action and then MOVEMENTS (DOWN, UP, LEFT, RIGHT)\n          for action in [4] + list(range(4)):\n              reward, new_state = current_state.step(action)\n\n              # Skip invalid moves and penalized actions\n              if reward < 0 or new_state == current_state:\n                  continue\n\n              tentative_g_score = g_score[current_state] + 1\n\n              if tentative_g_score < g_score.get(new_state, float('inf')):\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T06:38:52.651571", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(state):\n      neighbors = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          neighbors.append((new_state, action, state_hash))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for new_state, action, state_hash in get_neighbors(current_state):\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def dfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      stack = deque([(initial_state, [])])\n      visited = set()\n      \n      while stack:\n          current_state, path = stack.pop()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for new_state, action, state_hash in get_neighbors(current_state):\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  stack.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: count the number of items still needed to craft the goal\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory\n      total_needed = sum(primitives.get(p, 0) for p in primitives)\n      already_have = sum(current_inventory[p] for p in primitives)\n      return max(total_needed - already_have, 0)\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      from collections import defaultdict\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      \n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      came_from = {}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          for new_state, action, state_hash in get_neighbors(current_state):\n              tentative_g_score = g_score[current_state] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, action, path)\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n      total_path = path\n      while current_state in came_from:\n          _, action, parent_path = came_from[current_state]\n          total_path = parent_path + [action]\n          current_state = (tuple(current_state.grid.flatten()), \n                           tuple(current_state.inventory), \n                           current_state.pos, \n                           current_state.dir)\n      return total_path\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # First attempt A* search with heuristic to find the shortest path efficiently\n  action_sequence = astar_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If A* fails, try a depth-first search with backtracking as a fallback\n      action_sequence = dfs_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T06:38:53.685649", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(state):\n      neighbors = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          neighbors.append((new_state, action, state_hash))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for new_state, action, state_hash in get_neighbors(current_state):\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of items needed to craft the goal item\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory\n      missing_items = sum(primitives.get(item_idx, 0) - current_inventory[item_idx] for item_idx in primitives)\n      return max(1, missing_items)\n\n  def astar_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          state_hash = (tuple(current_state.grid.flatten()), \n                        tuple(current_state.inventory), \n                        current_state.pos, \n                        current_state.dir)\n          \n          if state_hash not in visited:\n              visited.add(state_hash)\n              \n              for new_state, action, new_state_hash in get_neighbors(current_state):\n                  if new_state_hash not in visited:\n                      heapq.heappush(open_set, (heuristic(new_state, goal_item) + len(path) + 1, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # First attempt A* search to find the shortest path efficiently\n  action_sequence = astar_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If A* fails, try a breadth-first search as a fallback\n      action_sequence = bfs_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T06:40:16.637847", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_neighbors(state):\n    neighbors = []\n    for action in range(env.world.n_actions):\n      reward, new_state = state.step(action)\n      if reward >= 0:  # Allow actions with non-negative rewards\n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        neighbors.append((new_state, action, state_hash))\n    return neighbors\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      for new_state, action, state_hash in get_neighbors(current_state):\n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def dfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    stack = deque([(initial_state, [])])\n    visited = set()\n    \n    while stack:\n      current_state, path = stack.pop()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      for new_state, action, state_hash in get_neighbors(current_state):\n        if state_hash not in visited:\n          visited.add(state_hash)\n          stack.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # First attempt BFS search to find the shortest path\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If BFS fails, try DFS as a fallback\n      action_sequence = dfs_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
