{"timestamp": "2025-06-27T00:17:10.569684", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n    \n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n    \n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n\n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n    # Simple heuristic: count the number of primitives missing to make the goal item\n    goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n    missing_count = 0\n    \n    for primitive, count in goal_primitives.items():\n      if state.inventory[primitive] < count:\n        missing_count += count - state.inventory[primitive]\n    \n    return missing_count\n\n  def a_star_search(initial_state, goal_item):\n    from heapq import heappop, heappush\n    \n    open_set = []\n    heappush(open_set, (0, initial_state, []))\n    came_from = {}\n    g_score = {initial_state: 0}\n    f_score = {initial_state: heuristic(initial_state, goal_item)}\n    \n    while open_set:\n      _, current_state, path = heappop(open_set)\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n\n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        tentative_g_score = g_score[current_state] + 1\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if tentative_g_score < g_score.get(new_state, float('inf')):\n          came_from[new_state] = (current_state, action)\n          g_score[new_state] = tentative_g_score\n          f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n          heappush(open_set, (f_score[new_state], new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # Fallback: Try BFS search as a backup\n      action_sequence = bfs_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-27T00:18:53.877619", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      state_to_goal_primitives = {state_hash(initial_state): get_primitive_counts(goal_item, initial_state.world.cookbook)}\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item from the cache or compute them\n          goal_primitives = state_to_goal_primitives[state_hash(current_state)]\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              possible_actions.append((new_state, path + [action]))\n\n          # Heuristic: Prioritize actions that move closer to having required primitives\n          possible_actions.sort(\n              key=lambda x: sum(min(get_primitive_counts(goal_item, x[0].world.cookbook).get(primitive, 0) - current_primitives, 0)\n                                  for primitive, current_primitives in goal_primitives.items()),\n              reverse=True\n          )\n\n          for new_state, path_with_action in possible_actions:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash_value = state_hash(new_state)\n              \n              if state_hash_value not in visited:\n                  visited.add(state_hash_value)\n                  queue.append((new_state, path_with_action))\n                  state_to_goal_primitives[state_hash_value] = get_primitive_counts(goal_item, new_state.world.cookbook)\n      \n      return None  # Return None if no sequence is found\n\n  def state_hash(state):\n      \"\"\"Returns a hashable representation of the state.\"\"\"\n      grid_tuple = tuple(state.grid.flatten())\n      inventory_tuple = tuple(state.inventory)\n      return (grid_tuple, inventory_tuple, state.pos, state.dir)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is a valid index in the cookbook\n  if not (0 <= goal_item < initial_state.world.cookbook.n_kinds):\n      raise ValueError(f\"Goal item index {goal_item} is out of bounds.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T00:19:03.742395", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [], get_primitive_counts(goal_item, initial_state.world.cookbook))])\n      visited = set()\n      \n      while queue:\n          current_state, path, goal_primitives = queue.popleft()\n\n          # Check if the current state satisfies the goal\n          if satisfies_goal(current_state, goal_item):\n              return path\n\n          # Generate possible actions based on the current state and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              # For USE actions, check if they can contribute to making the goal item\n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              possible_actions.append((new_state, path + [action]))\n\n          # Sort actions by heuristic score: prioritize actions that move closer to having required primitives\n          possible_actions.sort(\n              key=lambda x: sum(min(get_primitive_counts(goal_item, x[0].world.cookbook).get(primitive, 0) - current_primitives, 0)\n                                  for primitive, current_primitives in goal_primitives.items()),\n              reverse=True\n          )\n\n          # Process each new state resulting from possible actions\n          for new_state, path_with_action in possible_actions:\n              # Generate a hashable representation of the new state\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n\n                  # Calculate the primitives needed for the goal item at this new state\n                  new_goal_primitives = get_primitive_counts(goal_item, new_state.world.cookbook)\n                  queue.append((new_state, path_with_action, new_goal_primitives))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 2.0}}
