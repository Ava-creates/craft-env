):\n      cookbook = env.world.cookbook\n      goal_item = item\n      \n      # Check if we already have enough primitives to craft the goal\n      primitives_needed = cookbook.primitives_for(goal_item)\n      current_inventory = initial_state.inventory\n      \n      missing_primitives = {primitive: count for primitive, count in primitives_needed.items() \n                            if current_inventory[primitive] < count}\n      \n      action_sequence = []\n      current_state = initial_state\n      \n      # Collect any missing primitives\n      if missing_primitives:\n          for primitive_index, count in missing_primitives.items():\n              for _ in range(count - current_inventory[primitive]):\n                  collect_action_sequence, updated_state = collect_primitives(env, current_state)\n                  \n                  if collect_action_sequence:\n                      action_sequence.extend(collect_action_sequence)\n                      \n                      # Update the state after collecting the primitive\n                      for action in collect_action_sequence:\n                          _, current_state = current_state.step(action)\n      \n      # Try crafting the item with collected primitives\n      craft_action_sequence = bfs_search(current_state, goal_item)\n      if craft_action_sequence:\n          action_sequence.extend(craft_action_sequence)\n          return action_sequence\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Try crafting the item directly first\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If direct crafting fails, try collecting primitives and then crafting\n      action_sequence = craft_with_primitives(env, initial_state)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T15:25:12.364182", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic: the number of items needed to reach the goal\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = current_state.inventory\n      steps_to_goal = sum(max(primitives.get(i, 0) - current_inventory[i], 0) for i in primitives)\n      return steps_to_goal\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each action has a cost of 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:25:13.330877", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: prioritize states where the inventory count is higher\n      return -state.inventory[goal_item]\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), 0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, cost, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heapq.heappush(open_set, (cost + 1 + heuristic(new_state, goal_item), cost + 1, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:26:43.115079", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=5000):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) < max_steps:\n              for action in range(env.world.n_actions):\n                  reward, new_state = current_state.step(action)\n                  \n                  # Convert the new state to a hashable form using a tuple of its attributes\n                  state_hash = (tuple(new_state.grid.flatten()), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir)\n                  \n                  if state_hash not in visited:\n                      visited.add(state_hash)\n                      queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def dfs_search(initial_state, goal_item, max_depth=100):\n      from collections import deque\n      \n      stack = deque([(initial_state, [])])\n      visited = set()\n      \n      while stack:\n          current_state, path = stack.pop()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) < max_depth:\n              for action in range(env.world.n_actions):\n                  reward, new_state = current_state.step(action)\n                  \n                  # Convert the new state to a hashable form using a tuple of its attributes\n                  state_hash = (tuple(new_state.grid.flatten()), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir)\n                  \n                  if state_hash not in visited:\n                      visited.add(state_hash)\n                      stack.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def a_star_search(initial_state, goal_item):\n    from queue import PriorityQueue\n    import heapq\n    \n    open_set = PriorityQueue()\n    open_set.put((0, initial_state, []))  # (priority, state, path)\n    came_from = {}\n    g_score = {initial_state: 0}\n    \n    while not open_set.empty():\n        _, current_state, path = open_set.get()\n        \n        if satisfies_goal(current_state, goal_item):\n            return reconstruct_path(came_from, current_state, path)\n        \n        for action in range(env.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            tentative_g_score = g_score[current_state] + 1\n            \n            if state_hash not in g_score or tentative_g_score < g_score[new_state]:\n                came_from[state_hash] = (current_state, path)\n                g_score[state_hash] = tentative_g_score\n                f_score = tentative_g_score + heuristic(new_state, goal_item)\n                open_set.put((f_score, new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n    \"\"\"Heuristic function to estimate the cost from current state to goal.\"\"\"\n    # Simple heuristic: number of steps taken so far (no heuristic)\n    return 0\n\n  def reconstruct_path(came_from, current_state, path):\n    total_path = []\n    \n    while current_state in came_from:\n        _, prev_path = came_from[current_state]\n        total_path.extend(prev_path)\n        current_state = came_from[current_state][0]\n    \n    total_path.append(path[-1])\n    return total_path\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(\"A* search failed. Attempting BFS search...\")\n    \n    action_sequence = bfs_search(initial_state, goal_item)\n  \n  if not action_sequence:\n    print(\"BFS search failed. Attempting DFS search...\")\n    \n    action_sequence = dfs_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
