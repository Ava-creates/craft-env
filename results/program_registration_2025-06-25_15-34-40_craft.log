))\n              else:  # MOVEMENT actions (DOWN, UP, LEFT, RIGHT)\n                  possible_actions.append((action, reward))\n\n          for action, _ in sorted(possible_actions, key=lambda x: x[1], reverse=True):  # Sort by reward descending\n              _, new_state = current_state.step(action)\n\n              state_hash = hash((new_state.grid.tobytes(), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir))\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def apply_actions(initial_state, actions):\n      current_state = initial_state\n      for action in actions:\n          reward, new_state = current_state.step(action)\n          current_state = new_state\n      return current_state\n\n  def improve_action_sequence(env, initial_actions):\n      \"\"\"Improve the initial action sequence by removing redundant moves.\"\"\"\n      improved_actions = []\n      last_pos = None\n      \n      for action in initial_actions:\n          if action < 4:  # MOVEMENT actions (DOWN, UP, LEFT, RIGHT)\n              new_state = env._current_state\n              _, new_state = new_state.step(action)\n              \n              if new_state.pos != last_pos:\n                  improved_actions.append(action)\n                  last_pos = new_state.pos\n          else:  # USE action\n              improved_actions.append(action)\n      \n      return improved_actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Attempt to find an initial action sequence using BFS\n  action_sequence = bfs_search(initial_state, goal_item)\n  \n  if not action_sequence:\n      return []  # Return empty list if no actions found\n\n  # Validate the action sequence by simulating it\