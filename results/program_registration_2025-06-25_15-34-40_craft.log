{"timestamp": "2025-06-27T07:12:19.802599", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def get_required_primitives_for_goal(primitive_counts, current_inventory):\n      required_primitives = {}\n      for primitive, count_needed in primitive_counts.items():\n          count_held = current_inventory[primitive]\n          if count_needed > count_held:\n              required_primitives[primitive] = count_needed - count_held\n      return required_primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      target_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)  # Precompute goal primitives\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Calculate required primitives based on current inventory\n          required_primitives = get_required_primitives_for_goal(target_primitives, current_state.inventory)\n          \n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(act