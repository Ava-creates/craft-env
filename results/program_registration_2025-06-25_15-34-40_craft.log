     return actions\n\n  def can_use_item(state, cookbook):\n      \"\"\"Check if there's an item in the inventory that can be used.\"\"\"\n      for i, count in enumerate(state.inventory):\n          if count > 0 and i in cookbook.recipes:\n              recipe = cookbook.recipes[i]\n              # Check if all ingredients are available in the inventory\n              if all(state.inventory[ingredient] >= count for ingredient, count in recipe.items()):\n                  return True\n      return False\n\n  def move_position(pos, direction, action):\n      x, y = pos\n      directions = [(0, -1), (1, 0), (0, 1), (-1, 0)]  # UP, RIGHT, DOWN, LEFT\n      \n      if action < 4:  # Movement actions\n          dx, dy = directions[action]\n          new_x, new_y = x + dx, y + dy\n          \n          # Rotate direction based on movement action\n          if action == (direction + 1) % 4:\n              direction = (direction - 1) % 4\n          elif action == (direction - 1) % 4:\n              direction = (direction + 1) % 4\n      \n      else:  # USE action\n          new_x, new_y = x, y\n          \n      return (new_x, new_y)\n\n  def is_valid_move(pos, grid_shape, direction, move_action):\n      x, y = pos\n      width, height = grid_shape\n      \n      # Check if the position is within grid bounds\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      \n      # Check if the cell is traversable (non-grabbable entities should be avoided)\n      kind_index = np.argmax(env._current_state.grid[x, y])\n      if kind_index in env.world.non_grabbable_indices:\n          return False\n      \n      # Optionally, add more checks based on direction and action\n      # For example, check if the movement is blocked by an obstacle\n      \n      return True\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_se