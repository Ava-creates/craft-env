{"timestamp": "2025-06-27T09:49:13.143131", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def plan_actions(env, goal_item):\n      initial_state = env._current_state\n      action_sequence = []\n      max_attempts = 10  # To prevent infinite loops in case of unsolvable goals or bugs\n      attempts = 0\n      \n      while not satisfies_goal(initial_state, goal_item) and attempts < max_attempts:\n          path = bfs_search(initial_state, goal_item)\n          if path is None:\n              break\n          \n          action_sequence.extend(path)\n          \n          # Apply the found actions to the environment\n          for action in path:\n              reward, done, observations = env.step(action)\n              \n              if done or satisfies_goal(env._current_state, goal_item):\n                  return action_sequence\n          \n          initial_state = env._current_state\n          attempts += 1\n\n      return action_sequence if satisfies_goal(env._current_state, goal_item) else []\n\n  # Plan and execute the actions to craft the item\n  return plan_actions(env, item)", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T09:50:50.036959", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def heuristic(state, goal_item):\n    # Simple heuristic: number of missing primitives needed to make the goal item\n    goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n    missing_count = 0\n    \n    for primitive, required in goal_primitives.items():\n      if state.inventory[primitive] < required:\n        missing_count += (required - state.inventory[primitive])\n    \n    return missing_count\n\n  def astar_search(initial_state, goal_item):\n    from heapq import heappush, heappop\n\n    open_set = []\n    heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n    visited = set()\n\n    while open_set:\n      _, current_state, path = heappop(open_set)\n\n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n\n      # Prioritize movement actions over USE action\n      sorted_actions = [i for i in range(initial_state.world.n_actions) if i != 4] + [4]\n\n      for action in sorted_actions:\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n\n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          heappush(open_set, (len(path) + 1 + heuristic(new_state, goal_item), new_state, path + [action]))\n\n    return None  # Return None if no sequence is found\n\n  def optimize_action_sequence(action_sequence):\n    optimized_sequence = []\n    i = 0\n    while i < len(action_sequence):\n      current_action = action_sequence[i]\n      \n      if current_action == 4:  # USE action\n        use_count = 1\n        while (i + 1 < len(action_sequence) and \n               action_sequence[i + 1] == 4):\n          i += 1\n          use_count += 1\n        optimized_sequence.append(current_action)\n      else:\n        optimized_sequence.append(current_action)\n      \n      i += 1\n    \n    return optimized_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if satisfies_goal(initial_state, goal_item):\n      return []  # Goal already satisfied\n\n  action_sequence = astar_search(initial_state, goal_item)\n\n  if not action_sequence:\n    return []\n\n  # Optimize the action sequence by merging consecutive USE actions\n  optimized_action_sequence = optimize_action_sequence(action_sequence)\n  \n  return optimized_action_sequence", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-27T09:51:00.405201", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    if goal_index in primitive_counts_cache:\n      return primitive_counts_cache[goal_index]\n    \n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    primitive_counts_cache[goal_index] = primitives\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n\n    while queue:\n      current_state, path = queue.popleft()\n\n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Prioritize movement actions over USE action\n      sorted_actions = [i for i in range(initial_state.world.n_actions) if i != 4] + [4]\n\n      for action in sorted_actions:\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n\n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n\n    return None  # Return None if no sequence is found\n\n  def optimize_action_sequence(action_sequence):\n    optimized_sequence = []\n    i = 0\n    while i < len(action_sequence):\n      current_action = action_sequence[i]\n      \n      if current_action == 4:  # USE action\n        use_count = 1\n        while (i + 1 < len(action_sequence) and \n               action_sequence[i + 1] == 4):\n          i += 1\n          use_count += 1\n        optimized_sequence.append(current_action)\n      else:\n        optimized_sequence.append(current_action)\n      \n      i += 1\n    \n    return optimized_sequence\n\n  # Precompute primitive counts for all items\n  primitive_counts_cache = {}\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if satisfies_goal(initial_state, goal_item):\n    return []  # Goal already satisfied\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(\"No sequence found to craft the item.\")\n    return []\n\n  # Optimize the action sequence by merging consecutive USE actions\n  optimized_action_sequence = optimize_action_sequence(action_sequence)\n  \n  return optimized_action_sequence", "island_id": 5, "scores": {"3": 2.0}}
