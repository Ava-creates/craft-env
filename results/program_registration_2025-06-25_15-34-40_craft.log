{"timestamp": "2025-06-26T19:37:43.450319", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      \"\"\"Simple heuristic based on the number of items required in the recipe.\"\"\"\n      # This is a placeholder heuristic. A more sophisticated one could be implemented.\n      required_items = env.world.cookbook.primitives_for(goal_item)\n      return sum(required_items.values())\n\n  def astar_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      \n      g_scores = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory): 0}\n      f_scores = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory): heuristic(initial_state, goal_item)}\n      came_from = {}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = tuple(new_state.grid.flatten()) + tuple(new_state.inventory) + (new_state.pos, new_state.dir)\n              \n              tentative_g_score = g_scores.get(tuple(current_state.grid.flatten()) + tuple(current_state.inventory), float('inf')) + 1\n              \n              if tentative_g_score < g_scores.get(state_hash, float('inf')):\n                  came_from[state_hash] = (current_state, path)\n                  g_scores[state_hash] = tentative_g_score\n                  f_scores[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_scores[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n          _, path = came_from[current]\n          total_path = path + total_path\n          current = came_from[current][0]\n      return total_path\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Reset the environment to ensure a clean starting point\n  env.reset()\n  \n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T19:39:36.876427", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbor_states(current_state):\n      neighbor_states = []\n      \n      for action in range(env.world.n_actions):  # Assuming actions are enumerated from 0 to n_actions-1\n          reward, new_state = current_state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          neighbor_states.append((new_state, action, state_hash))\n      \n      return neighbor_states\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          neighbor_states = get_neighbor_states(current_state)\n          \n          for new_state, action, state_hash in neighbor_states:\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from current state to goal.\"\"\"\n      # Simple heuristic: number of steps taken so far (can be improved)\n      return len(state.inventory) - state.inventory[goal_item]\n  \n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          neighbor_states = get_neighbor_states(current_state)\n          \n          for new_state, action, state_hash in neighbor_states:\n              tentative_g_score = g_score[current_state] + 1  # Cost of moving to the next state is assumed to be 1\n      \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Check if the goal item can be crafted based on available primitives and environment items\n  primitives_required = env.world.cookbook.primitives_for(goal_item)\n  available_primitives = {idx: initial_state.inventory[idx] for idx in env.world.grabbable_indices}\n  \n  if not all(primitive in available_primitives or primitive in env.world.environment for primitive in primitives_required):\n      raise ValueError(\"Goal item cannot be crafted with the available items and environment.\")\n  \n  # Use A* search to find the optimal sequence of actions\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
