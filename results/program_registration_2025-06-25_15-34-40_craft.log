new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              actions_to_try.append((state_hash, action, reward, new_state))\n          \n          for state_hash, action, reward, new_state in sorted(actions_to_try, key=lambda x: -x[2]):\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def greedy_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          actions_to_try = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              actions_to_try.append((state_hash, action, reward, new_state))\n          \n          for state_hash, action, reward, new_state in sorted(actions_to_try, key=lambda x: -x[2]):\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.appendleft((new_state, path + [action]))  # Add to the front for greedy behavior\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in initial_state.world.cookbook.index.reverse_contents:\n      raise ValueError(\"Goal item index not found in cookbook.\")\n  \n  action_sequence = greedy_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-27T15:41:44.641964", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        # Collect primitives needed for the goal item\n        goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n        \n        # Filter actions based on available inventory and required primitives\n        for action in range(initial_state.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            if action == 4:  # USE action\n                # Check if the use action can contribute to making the goal item\n                can_make_goal = True\n                for primitive, count in goal_primitives.items():\n                    if new_state.inventory[primitive] < count:\n                        can_make_goal = False\n                        break\n                \n                if not can_make_goal:\n                    continue  # Skip this action as it doesn't help make the goal item\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def optimize_action_sequence(actions):\n      # Simple heuristic: remove consecutive moves in opposite directions\n      optimized_actions = []\n      i = 0\n      \n      while i < len(actions):\n          current_action = actions[i]\n          \n          if current_action == 0:  # DOWN\n              if i + 1 < len(actions) and actions[i + 1] == 1:  # UP\n                  i += 2  # Skip both actions\n                  continue\n          elif current_action == 1:  # UP\n              if i + 1 < len(actions) and actions[i + 1] == 0:  # DOWN\n                  i += 2  # Skip both actions\n                  continue\n          elif current_action == 2:  # LEFT\n              if i + 1 < len(actions) and actions[i + 1] == 3:  # RIGHT\n                  i += 2  # Skip both actions\n                  continue\n          elif current_action == 3:  # RIGHT\n              if i + 1 < len(actions) and actions[i + 1] == 2:  # LEFT\n                  i += 2  # Skip both actions\n                  continue\n          \n          optimized_actions.append(current_action)\n          i += 1\n      \n      return optimized_actions\n\n  def find_shortest_path(initial_state, goal_item):\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0, [], initial_state))\n    came_from = {}\n    g_score = {initial_state: 0}\n    \n    while not open_set.empty():\n        _, path, current_state = open_set.get()\n        \n        if satisfies_goal(current_state, goal_item):\n            return reconstruct_path(came_from, current_state, path)\n        \n        for action in range(initial_state.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            tentative_g_score = g_score[current_state] + 1\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                came_from[new_state] = (current_state, action)\n                g_score[new_state] = tentative_g_score\n                f_score = tentative_g_score  # Assuming a heuristic of zero for simplicity\n                open_set.put((f_score, path + [action], new_state))\n    \n    return None\n\n  def reconstruct_path(came_from, current_state, initial_path):\n      total_path = []\n      while current_state in came_from:\n          prev_state, action = came_from[current_state]\n          total_path.append(action)\n          current_state = prev_state\n      return initial_path + total_path[::-1]\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item can be crafted\n  if goal_item not in initial_state.world.cookbook.recipes:\n      raise ValueError(f\"Goal item {goal_item} cannot be crafted.\")\n  \n  action_sequence = find_shortest_path(initial_state, goal_item)\n\n  if action_sequence:\n      optimized_sequence = optimize_action_sequence(action_sequence)\n      return optimized_sequence\n  \n  return []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-27T15:41:55.041682", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = all(new_state.inventory[primitive] >= count for primitive, count in goal_primitives.items())\n          \n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n\n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def optimize_action_sequence(actions):\n    \"\"\"Optimizes the action sequence by removing redundant moves and consecutive opposite direction movements.\"\"\"\n    optimized_actions = []\n    i = 0\n    \n    while i < len(actions):\n      current_action = actions[i]\n      \n      if current_action == 0:  # DOWN\n        if i + 1 < len(actions) and actions[i + 1] == 1:  # UP\n          i += 2  # Skip both actions\n          continue\n      elif current_action == 1:  # UP\n        if i + 1 < len(actions) and actions[i + 1] == 0:  # DOWN\n          i += 2  # Skip both actions\n          continue\n      elif current_action == 2:  # LEFT\n        if i + 1 < len(actions) and actions[i + 1] == 3:  # RIGHT\n          i += 2  # Skip both actions\n          continue\n      elif current_action == 3:  # RIGHT\n        if i + 1 < len(actions) and actions[i + 1] == 2:  # LEFT\n          i += 2  # Skip both actions\n          continue\n      \n      optimized_actions.append(current_action)\n      i += 1\n    \n    return optimized_actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item can be crafted\n  if goal_item not in initial_state.world.cookbook.recipes:\n    raise ValueError(f\"Goal item {goal_item} cannot be crafted.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n    optimized_sequence = optimize_action_sequence(action_sequence)\n    return optimized_sequence\n  \n  return []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 2.0}}
