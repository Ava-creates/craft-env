\n  \n  # Reset the environment to ensure a clean starting point\n  env.reset()\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T18:14:48.761993", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def astar_search(initial_state, goal_item):\n      import heapq\n      \n      def heuristic(state, goal_item):\n          # Simple heuristic: prioritize states with more inventory items\n          return -sum(state.inventory)\n          \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))  # (f_score, state, path)\n      visited = set()\n      \n      while open_set:\n          current_fscore, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  \n                  g_score = len(path) + 1\n                  h_score = heuristic(new_state, goal_item)\n                  f_score = g_score + h_score\n                  \n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def retry_astar_search(env, goal_item, max_retries=3):\n      for _ in range(max_retries):\n          env.reset()\n          initial_state = env._current_state\n          action_sequence = astar_search(initial_state, goal_item)\n          if action_sequence:\n              return action_sequence\n      return None\n\n  goal_item = item\n  action_sequence = retry_astar_search(env, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:14:49.761284", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue for A* search\n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      \n      # Set to keep track of visited states\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  \n                  # Calculate heuristic (e.g., number of items needed to craft the goal)\n                  heuristic = calculate_heuristic(new_state, goal_item)\n                  \n                  heapq.heappush(open_set, (len(path) + heuristic, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def calculate_heuristic(state, goal_item):\n      \"\"\"Calculate a heuristic value for the current state towards achieving the goal.\"\"\"\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      inventory = state.inventory\n      \n      # Calculate the number of primitive items needed\n      needed_primitives = sum(primitives.get(i_kind, 0) - inventory[i_kind] for i_kind in primitives.keys())\n      \n      return max(needed_primitives, 1)\n\n  def retry_a_star_search(env, goal_item, max_retries=3):\n      for _ in range(max_retries):\n          env.reset()\n          initial_state = env._current_state\n          action_sequence = a_star_search(initial_state, goal_item)\n          if action_sequence:\n              return action_sequence\n      return None\n\n  goal_item = item\n  action_sequence = retry_a_star_search(env, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:15:51.496990", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          # Skip adding unchanged state to the queue\n          if np.array_equal(new_state.grid, state.grid) and\\\n             np.array_equal(new_state.inventory, state.inventory) and\\\n             new_state.pos == state.pos and\\\n             new_state.dir == state.dir:\n              continue\n          valid_actions.append((action, reward, new_state))\n      return valid_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Consider only valid actions (e.g., not walking into walls or invalid moves)\n          for action, reward, new_state in get_valid_actions(current_state):\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid and can be crafted or is a primitive\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T18:16:05.282831", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n\n          # Skip adding unchanged states to the queue\n          if np.array_equal(new_state.grid, state.grid) and\\\n             np.array_equal(new_state.inventory, state.inventory) and\\\n             new_state.pos == state.pos and\\\n             new_state.dir == state.dir:\n              continue\n\n          valid_actions.append(action)\n      return valid_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in get_valid_actions(current_state):\n              reward, new_state = current_state.step(action)\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid and can be crafted or is a primitive\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  if goal_item in env.world.non_grabbable_indices:\n      raise ValueError(f\"Goal item {goal_item} is non-grabbable and cannot be crafted.\")\n\n  # If the goal item is already available, return an empty path\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T18:17:06.107907", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic: number of items needed for the goal\n      current_inv = np.copy(current_state.inventory)\n      primitives_needed = env.world.cookbook.primitives_for(goal_item)\n\n      count = 0\n      for i_kind, required in primitives_needed.items():\n          if current_inv[i_kind] < required:\n              count += required - current_inv[i_kind]\n      \n      return count\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each step costs 1\n      \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, action)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(\"First A* search failed. Attempting to find a path with different scenarios...\")\n    \n    max_retries = 5\n    for retry in range(max_retries):\n        env.world.sample_scenario()\n        initial_state = env._current_state\n        \n        action_sequence = a_star_search(initial_state, goal_item)\n        \n        if action_sequence:\n            print(f\"Path found after {retry + 1} retries.\")\n            break\n    \n    else:\n      print(\"All retries failed. No path found.\")\n\n  return action_sequence", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:17:16.205946", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that involve using resources or crafting\n          action_priorities = [4] + list(set(range(env.world.n_actions)) - {4})\n          \n          for action in action_priorities:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(\"First BFS search failed. Attempting to find a path with different scenarios...\")\n    \n    max_retries = 5\n    for retry in range(max_retries):\n        env.world.sample_scenario()\n        initial_state = env._current_state\n        \n        action_sequence = bfs_search(initial_state, goal_item)\n        \n        if action_sequence:\n            print(f\"Path found after {retry + 1} retries.\")\n            break\n    \n    else:\n      print(\"All retries failed. No path found.\")\n\n  return action_sequence", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T18:18:18.806155", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(action, current_state, goal_item, env):\n      # Higher priority for USE action if an ingredient is next to the agent\n      if action == 4:  # Assuming USE is represented by 4\n          for i_kind in env.world.cookbook.primitives:\n              if current_state.next_to(i_kind):\n                  return 10  # High priority for USE actions when ingredients are nearby\n      \n      # Higher priority for moving towards items needed to craft the goal item\n      recipe = env.world.cookbook.recipes.get(goal_item, {})\n      if \"_key\" in recipe:  # Skip key-only recipes (e.g., no ingredients needed)\n          return 0\n      \n      ingredient_counts = {i_kind: count for i_kind, count in recipe.items() if i_kind != \"_key\"}\n      \n      if not ingredient_counts:\n          return 0\n      \n      # Calculate a heuristic based on proximity to the nearest required ingredient\n      min_distance = float('inf')\n      for i_kind in ingredient_counts:\n          if current_state.next_to(i_kind):\n              return 5  # Medium priority for moving towards ingredients\n      \n          # Check nearby cells (3x3 neighborhood) for ingredients\n          x, y = current_state.pos\n          for dx in [-1, 0, 1]:\n              for dy in [-1, 0, 1]:\n                  nx, ny = x + dx, y + dy\n                  if 0 <= nx < env.world.grid.shape[0] and 0 <= ny < env.world.grid.shape[1]:\n                      if env._current_state.grid[nx, ny, i_kind] > 0:\n                          distance = abs(dx) + abs(dy)\n                          min_distance = min(min_distance, distance)\n      \n      return -min_distance if min_distance < float('inf') else 0\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Use a heuristic to prioritize actions that involve using items (action == USE)\n          all_actions = list(range(env.world.n_actions))\n          \n          for action in all_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  g_cost = len(path) + 1\n                  h_cost = heuristic(action, current_state, goal_item, env)\n                  f_cost = g_cost + h_cost\n                  heappush(open_set, (f_cost, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Reset the environment to ensure a clean starting point\n  env.reset()\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:18:34.519022", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(action, current_state, goal_item):\n      # Higher priority for USE action if an ingredient is next to the agent\n      if action == 4:  # Assuming USE is represented by 4\n          for i_kind in env.world.cookbook.primitives:\n              if current_state.next_to(i_kind):\n                  return 1\n      return 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Use a heuristic to prioritize actions that involve using items (action == USE)\n          use_actions = [4]  # Assuming USE is represented by 4\n          other_actions = list(range(env.world.n_actions))\n          other_actions.remove(4) if 4 in other_actions else None\n\n          all_actions = sorted(use_actions + other_actions, key=lambda action: heuristic(action, current_state, goal_item), reverse=True)\n          \n          for action in all_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T18:19:33.858484", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              # Skip USE action if there's nothing to use nearby or on the grid\n              if action == 4 and not any(\n                  current_state.grid[\n                      max(0, current_state.pos[0]-1):min(env.scenario.init_grid.shape[0], current_state.pos[0]+2),\n                      max(0, current_state.pos[1]-1):min(env.scenario.init_grid.shape[1], current_state.pos[1]+2)\n                  ].flatten()):\n                  continue\n\n              reward, new_state = current_state.step(action)\n\n              # Check if the environment is in a valid state\n              if not isinstance(new_state.grid, np.ndarray) or not isinstance(new_state.inventory, np.ndarray):\n                  print(f\"Invalid state after action {action}: grid={new_state.grid}, inventory={new_state.inventory}\")\n                  continue\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
