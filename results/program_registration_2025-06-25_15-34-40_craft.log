ound", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:11:13.449351", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate actions in a more strategic order to prioritize crafting and using items\n          actions = [4] + list(range(4))  # Prioritize USE action (index 4)\n          \n          for action in actions:\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:11:14.501334", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function based on Manhattan distance to nearest required item.\"\"\"\n      cookbook = env.world.cookbook\n      primitives = cookbook.primitives_for(goal_item)\n      grid = state.grid\n      pos = np.array(state.pos)\n      \n      total_distance = 0\n      \n      for primitive, count in primitives.items():\n          if count == 0:\n              continue\n          \n          # Find the nearest required primitive on the grid\n          primitive_grid = grid[..., primitive]\n          non_zero_positions = np.argwhere(primitive_grid > 0)\n          \n          if non_zero_positions.size == 0:\n              total_distance += float('inf')  # No required item found\n              continue\n          \n          distances = np.linalg.norm(non_zero_positions - pos, axis=1)\n          nearest_distance = np.min(distances)\n          \n          total_distance += nearest_distance * count\n      \n      return total_distance\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each action has cost 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, path + [action])\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start A* search to find the action sequence\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:12:39.416915", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (heuristic(initial_state), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state):\n      \"\"\"Heuristic function using Manhattan distance to the nearest required item.\"\"\"\n      distances = []\n      for i_kind in range(len(env.world.cookbook.primitives)):\n          goal_idx = env.world.cookbook.index.get(i_kind)\n          \n          if goal_idx is not None and state.inventory[goal_idx] == 0:\n              min_dist = float('inf')\n              \n              # Find the nearest required item\n              for x in range(env.world.grid.shape[0]):\n                  for y in range(env.world.grid.shape[1]):\n                      if state.grid[x, y, goal_idx] > 0:\n                          dist = abs(x - state.pos[0]) + abs(y - state.pos[1])\n                          min_dist = min(min_dist, dist)\n              \n              distances.append(min_dist)\n          else:\n              distances.append(0)\n      \n      return sum(distances)\n\n  def heuristic_v2(state):\n      \"\"\"Heuristic function using a combination of item availability and distance.\"\"\"\n      total_distance = 0\n      \n      for i_kind in range(len(env.world.cookbook.primitives)):\n          goal_idx = env.world.cookbook.index.get(i_kind)\n          \n          if goal_idx is not None and state.inventory[goal_idx] == 0:\n              # Calculate the Manhattan distance to the nearest required item\n              min_dist = float('inf')\n              \n              for x in range(env.world.grid.shape[0]):\n                  for y in range(env.world.grid.shape[1]):\n                      if state.grid[x, y, goal_idx] > 0:\n                          dist = abs(x - state.pos[0]) + abs(y - state.pos[1])\n                          min_dist = min(min_dist, dist)\n              \n              # Adjust distance by the availability of required items\n              available_count = np.sum(state.grid[:, :, goal_idx])\n              if available_count == 0:\n                  total_distance += float('inf')  # No item available\n              else:\n                  total_distance += (min_dist / available_count) * 1.5  # Penalize distance by availability\n      \n      return total_distance\n\n  initial_state = env._current_state\n  goal_item = item\n\n  # Attempt A* search with the improved heuristic\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:12:40.380982", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state):\n      \"\"\"Heuristic function using Manhattan distance to the nearest required item.\"\"\"\n      distances = []\n      cookbook = env.world.cookbook\n      goal_primitives = primitives_for(cookbook, item)\n\n      for primitive_idx in goal_primitives:\n          if state.inventory[primitive_idx] == 0:\n              min_dist = float('inf')\n              \n              # Find the nearest required item\n              for x in range(env.world.grid.shape[0]):\n                  for y in range(env.world.grid.shape[1]):\n                      if state.grid[x, y, primitive_idx] > 0:\n                          dist = abs(x - state.pos[0]) + abs(y - state.pos[1])\n                          min_dist = min(min_dist, dist)\n              \n              distances.append(min_dist)\n          else:\n              distances.append(0)\n      \n      return sum(distances)\n\n  def primitives_for(cookbook: env_factory.Cookbook, goal: int) -> dict:\n    \"\"\"Extracts the set of primitives required to craft a given goal item from the cookbook.\"\"\"\n    \n    # Initialize primitives dictionary\n    primitives = {}\n\n    # Helper function for recursive depth-first search\n    def dfs(current_item):\n        if current_item in cookbook.primitives or current_item in cookbook.environment:\n            # Base case: current item is a primitive or environment entity\n            if current_item not in primitives:\n                primitives[current_item] = 1\n            else:\n                primitives[current_item] += 1\n        elif current_item in cookbook.recipes:\n            # Recursive case: current item has a recipe; find required ingredients\n            for ingredient, count in cookbook.recipes[current_item].items():\n                if ingredient == \"_key\":\n                    continue  # Skip the key ingredient which is the output itself\n                dfs(ingredient)\n                if ingredient not in primitives:\n                    primitives[ingredient] = count\n                else:\n                    primitives[ingredient] += count\n\n    # Start DFS from the goal item index\n    dfs(goal)\n\n    return primitives\n  \n  initial_state = env._current_state\n  goal_item = item\n\n  # Attempt to find a path using A* search with heuristic\n  action_sequence = a_star_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:13:42.769031", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that might lead to progress in crafting the item\n          prioritized_actions = []\n          other_actions = []\n\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n\n                  # Heuristic: prioritize actions that increase inventory counts towards the goal\n                  if any(count > current_state.inventory[i] for i, count in enumerate(new_state.inventory)):\n                      prioritized_actions.append((new_state, path + [action]))\n                  else:\n                      other_actions.append((new_state, path + [action]))\n          \n          # Add prioritized actions first to the queue\n          queue.extend(prioritized_actions)\n          queue.extend(other_actions)\n\n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:13:43.812382", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic based on the distance to a workshop\n      grid = state.grid[:, :, goal_item]\n      x, y = state.pos\n      min_dist = float('inf')\n      \n      for wx, wy in env.world.workshop_indices:\n          dist = abs(wx - x) + abs(wy - y)\n          if grid[wx, wy] > 0 and dist < min_dist:\n              min_dist = dist\n      \n      return min_dist\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      import heapq\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      came_from = {}\n      g_score = {hash_state(initial_state): 0}\n      f_score = {hash_state(initial_state): heuristic(initial_state, goal_item)}\n      \n      while not open_set.empty():\n          current_f, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[hash_state(current_state)] + 1\n              new_state_hash = hash_state(new_state)\n              \n              if new_state_hash not in g_score or tentative_g_score < g_score[new_state_hash]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state_hash] = tentative_g_score\n                  f_score[new_state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score[new_state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def hash_state(state):\n      return (tuple(state.grid.flatten()), \n              tuple(state.inventory), \n              state.pos, \n              state.dir)\n\n  def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n          previous, action = came_from[current]\n          total_path.append(action)\n          current = previous\n      return list(reversed(total_path))\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:14:26.045684", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import numpy as np\n      \n      def heuristic(state):\n          # A simple heuristic based on the number of missing items in inventory to satisfy the recipe.\n          cookbook = env.world.cookbook\n          if goal_item not in cookbook.recipes:\n              return 0\n          \n          recipe = cookbook.recipes[goal_item]\n          current_inventory = np.copy(state.inventory)\n          \n          missing_counts = []\n          for ingredient, count in recipe.items():\n              if ingredient == \"_key\":\n                  continue\n              missing_count = max(0, count - current_inventory[ingredient])\n              missing_counts.append(missing_count)\n          \n          return sum(missing_counts)\n      \n      open_set = [(heuristic(initial_state), initial_state, [])]\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  priority = heuristic(new_state) + len(path)  # g(n) + h(n)\n                  heappush(open_set, (priority, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:14:41.969044", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:15:57.562426", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue to store (cost, path, state)\n      queue = []\n      start_cost = 0\n      start_path = []\n      start_hash = (tuple(initial_state.grid.flatten()), \n                    tuple(initial_state.inventory), \n                    initial_state.pos, \n                    initial_state.dir)\n      \n      heapq.heappush(queue, (start_cost, start_path, initial_state))\n      visited = set([start_hash])\n      \n      while queue:\n          current_cost, path, current_state = heapq.heappop(queue)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n\n                  # Heuristic: prioritize actions that increase inventory counts towards the goal\n                  if any(count > current_state.inventory[i] for i, count in enumerate(new_state.inventory)):\n                      cost = current_cost + 1  # Increase cost by 1 step\n                  else:\n                      cost = current_cost + 2  # Penalize non-progress actions\n\n                  new_path = path + [action]\n                  heapq.heappush(queue, (cost, new_path, new_state))\n\n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:15:58.531859", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic_cost_estimate(current_state, goal_item):\n      # Simple heuristic based on inventory counts\n      missing_items = sum(env.world.cookbook.primitives_for(goal_item).get(i, 0) - current_state.inventory[i] for i in env.world.cookbook.primitives_for(goal_item))\n      return max(0, missing_items)\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))  # (f_cost, state, path)\n      \n      g_costs = {initial_state: 0}\n      came_from = {}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_cost = g_costs[current_state] + 1  # Cost of moving to the new state is assumed to be 1\n\n              if state_hash not in g_costs or tentative_g_cost < g_costs[state_hash]:\n                  came_from[new_state] = (current_state, action)\n                  g_costs[new_state] = tentative_g_cost\n                  f_cost = tentative_g_cost + heuristic_cost_estimate(new_state, goal_item)\n                  heapq.heappush(open_set, (f_cost, new_state, path + [action]))\n\n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n      total_path = path\n      while current_state in came_from:\n          previous_state, action = came_from[current_state]\n          total_path.append(action)\n          current_state = previous_state\n      return list(reversed(total_path))\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
