{"timestamp": "2025-06-26T15:10:10.778409", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate actions in a more strategic order to prioritize crafting and using items\n          prioritized_actions = [4]  # Prioritize USE action (index 4)\n          non_prioritized_actions = list(range(4))  # Move, turn actions\n\n          for action in prioritized_actions + non_prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def dfs_search(initial_state, goal_item, max_depth=50):\n      from collections import deque\n      \n      stack = deque([(initial_state, [])])\n      visited = set()\n      \n      while stack:\n          current_state, path = stack.pop()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate actions in a more strategic order to prioritize crafting and using items\n          prioritized_actions = [4]  # Prioritize USE action (index 4)\n          non_prioritized_actions = list(range(4))  # Move, turn actions\n\n          if len(path) < max_depth:\n              for action in prioritized_actions + non_prioritized_actions:\n                  reward, new_state = current_state.step(action)\n                  \n                  if reward < 0:  # Skip invalid actions that incur penalties\n                      continue\n                  \n                  # Convert the new state to a hashable form using a tuple of its attributes\n                  state_hash = (tuple(new_state.grid.flatten()), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir)\n                  \n                  if state_hash not in visited:\n                      visited.add(state_hash)\n                      stack.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If BFS fails, try DFS with a reasonable depth limit\n      action_sequence = dfs_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T15:11:00.433389", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=None):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # If a maximum depth is specified and the current depth exceeds it, skip further expansion\n          if max_depth is not None and len(path) >= max_depth:\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  max_depth = 50  # Set a reasonable maximum depth to avoid excessive search space exploration\n  action_sequence = bfs_search(initial_state, goal_item, max_depth)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T15:11:01.401888", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue for A* search\n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      \n      # Set to keep track of visited states\n      closed_set = set()\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          state_hash = (tuple(current_state.grid.flatten()), \n                        tuple(current_state.inventory), \n                        current_state.pos, \n                        current_state.dir)\n          \n          if state_hash in closed_set:\n              continue\n          \n          closed_set.add(state_hash)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Calculate the cost to reach the new state (heuristic can be adjusted as needed)\n              cost = len(path) + 1  # Simple heuristic: number of actions taken so far\n              heapq.heappush(open_set, (cost, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:12:01.376727", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: count the number of items needed in the recipe\n      if goal_item not in env.world.cookbook.recipes:\n          return float('inf')  # No recipe for this item\n      \n      recipe = env.world.cookbook.recipes[goal_item]\n      total_cost = 0\n      \n      # Calculate the cost to gather all required ingredients\n      for ingredient, count in recipe.items():\n          if isinstance(ingredient, int):\n              if state.inventory[ingredient] >= count:\n                  continue\n              else:\n                  missing_count = count - state.inventory[ingredient]\n                  total_cost += missing_count * 10  # Arbitrary high cost for gathering resources\n      \n      return total_cost\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action (index 4) and actions that involve picking up resources\n          actions = [4] + [i for i in range(5) if i != 4]\n          \n          for action in actions:\n              reward, new_state = current_state.step(action)\n              \n              # Skip invalid actions that incur penalties\n              if reward < 0:\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Cost is assumed to be 1 per action\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, path + [action])\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start A* search to find the action sequence\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:12:02.345359", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue for A* search\n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))  # (f_score, current_state, path)\n      \n      # Set to keep track of visited states\n      closed_set = set()\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(current_state.grid.flatten()), \n                        tuple(current_state.inventory), \n                        current_state.pos, \n                        current_state.dir)\n          \n          if state_hash in closed_set:\n              continue\n          \n          closed_set.add(state_hash)\n          \n          # Prioritize USE action (index 4) and actions that involve picking up resources\n          actions = [4] + [i for i in range(5) if i != 4]\n          \n          for action in actions:\n              reward, new_state = current_state.step(action)\n              \n              # Skip invalid actions that incur penalties\n              if reward < 0:\n                  continue\n              \n              # Calculate the heuristic (e.g., Manhattan distance to goal based on inventory counts)\n              heuristic = sum(abs(new_state.inventory[i] - goal_item) for i in range(env.world.n_kinds))\n              g_score = len(path) + 1  # Cost from start to current state\n              f_score = g_score + heuristic  # Estimated total cost from start to goal through current state\n              \n              new_state_hash = (tuple(new_state.grid.flatten()), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir)\n              \n              if new_state_hash not in closed_set:\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start A* search to find the action sequence\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:13:01.834257", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Cache the features_dict to avoid recomputation in step()\n          cached_features_dict = current_state.features_dict()\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Use the cached features_dict for the new state\n              new_state._cached_features_dict = {key: value.copy() for key, value in cached_features_dict.items()}\n              new_state._cached_features_dict['features_ego'] = np.roll(new_state._cached_features_dict['features_ego'], \n                                                                      (action - 2) % 4, axis=0)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (\n                  tuple(new_state.grid.flatten()), \n                  tuple(new_state.inventory), \n                  new_state.pos, \n                  new_state.dir\n              )\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T15:13:02.805253", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Cache the features_dict to avoid recomputation in step()\n          cached_features_dict = current_state.features_dict()\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Use the cached features_dict for the new state\n              new_state._cached_features_dict = {key: value.copy() for key, value in cached_features_dict.items()}\n              new_state._cached_features_dict['features_ego'] = np.roll(new_state._cached_features_dict['features_ego'], \n                                                                      (action - 2) % 4, axis=0)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (\n                  tuple(new_state.grid.flatten()), \n                  tuple(new_state.inventory), \n                  new_state.pos, \n                  new_state.dir\n              )\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state.clone()  # Clone the initial state to avoid modifying it\n  goal_item = item\n  \n  # Check if the goal item is already available in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      print(f\"Item {goal_item} already in inventory.\")\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      print(f\"No actions found to craft {goal_item}.\")\n      return []\n\n  # Execute the action sequence\n  for action in action_sequence:\n      env.step(action)\n      \n  return action_sequence", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:13:53.352204", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def astar_search(initial_state, goal_item):\n    import heapq\n    \n    # Priority queue for A* search\n    priority_queue = []\n    \n    # Cost from start to current state (g)\n    g_costs = {}\n    \n    # Estimated cost from current state to goal (f)\n    f_costs = {}\n    \n    # Dictionary to store the path leading to each state\n    came_from = {}\n    \n    # Add initial state to queue with priority 0\n    heapq.heappush(priority_queue, (0, initial_state))\n    \n    g_costs[initial_state] = 0\n    f_costs[initial_state] = heuristic(initial_state, goal_item)\n    \n    while priority_queue:\n        _, current_state = heapq.heappop(priority_queue)\n        \n        if satisfies_goal(current_state, goal_item):\n            return reconstruct_path(came_from, current_state)\n        \n        for action in range(env.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            tentative_g_cost = g_costs[current_state] + 1\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            new_state_hash = (tuple(new_state.grid.flatten()), \n                              tuple(new_state.inventory), \n                              new_state.pos, \n                              new_state.dir)\n            \n            if new_state not in g_costs or tentative_g_cost < g_costs[new_state]:\n                came_from[new_state] = (current_state, action)\n                g_costs[new_state] = tentative_g_cost\n                f_costs[new_state] = tentative_g_cost + heuristic(new_state, goal_item)\n                heapq.heappush(priority_queue, (f_costs[new_state], new_state))\n    \n    return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function using Manhattan distance to estimate remaining cost.\"\"\"\n      new_inventory = state.inventory.copy()\n      total_cost = 0\n      \n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          increase = new_state.inventory[goal_item] - new_inventory[goal_item]\n          if increase > 0:\n              # Estimate cost based on number of steps to reach goal\n              total_cost += (1 / increase) * 1\n      \n      return total_cost\n\n  def reconstruct_path(came_from, current_state):\n      path = []\n      \n      while current_state in came_from:\n          previous_state, action = came_from[current_state]\n          path.append(action)\n          current_state = previous_state\n      \n      path.reverse()\n      return path\n  \n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:13:54.319180", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n    new_inventory = state.inventory.copy()\n    best_action = None\n    max_increase = 0\n    \n    for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        increase = new_state.inventory[goal_item] - current_state.inventory[goal_item]\n        \n        if increase > max_increase:\n            max_increase = increase\n            best_action = action\n    \n    return best_action\n\n  def greedy_search(initial_state, goal_item):\n      path = []\n      current_state = initial_state\n      \n      while not satisfies_goal(current_state, goal_item):\n          best_action = heuristic(current_state, goal_item)\n          \n          if best_action is None:\n              print(f\"No progress made. Current inventory: {current_state.inventory}\")\n              return path  # Return the partial path if no further progress can be made\n      \n          path.append(best_action)\n          current_state, _ = current_state.step(best_action)\n      \n      return path\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = greedy_search(initial_state, goal_item)\n\n  return action_sequence", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:14:53.602627", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic_cost_estimate(current_state, goal_item):\n      # Estimate cost based on the number of ingredients needed\n      if satisfies_goal(current_state, goal_item):\n          return 0\n      \n      # Check primitives required for the goal item\n      recipe = env.world.cookbook.recipes.get(goal_item)\n      if not recipe:\n          return float('inf')  # No recipe available\n      \n      cost = 0\n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              continue\n          \n          if current_state.inventory[ingredient] >= count:\n              continue\n          \n          additional_needed = count - current_state.inventory[ingredient]\n          ingredient_recipe = env.world.cookbook.recipes.get(ingredient)\n          \n          # If the ingredient is a primitive, directly add to cost\n          if not ingredient_recipe or all(item in current_state.inventory for item in ingredient_recipe):\n              cost += additional_needed\n          else:\n              # Recursively estimate cost of making the ingredient\n              cost += heuristic_cost_estimate(current_state, ingredient) + 1\n      \n      return cost\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Try actions in a specific order: USE, UP, DOWN, LEFT, RIGHT\n          for action in [4, 1, 0, 2, 3]:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T15:15:01.849138", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions based on heuristics: USE first, then movement actions\n          for action in prioritize_actions(env.world.n_actions, path[-1] if path else None):\n              reward, new_state = current_state.step(action)\n              \n              # If the USE action results in goal satisfaction, return immediately\n              if satisfies_goal(new_state, goal_item) and action == 4:\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_actions(n_actions, last_action=None):\n      \"\"\"Prioritize actions based on heuristics.\"\"\"\n      # Always try to USE first\n      priority = [4]\n      \n      # Avoid repeating the same movement action consecutively\n      move_actions = list(range(4))\n      if last_action in move_actions:\n          move_actions.remove(last_action)\n      \n      return priority + move_actions\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T15:15:52.729743", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(state):\n      neighbors = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          # Convert the new state to a hashable form\n          state_hash = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos, new_state.dir)\n          neighbors.append((new_state, state_hash, action))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for new_state, state_hash, action in get_neighbors(current_state):\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  # Add a check to prevent revisiting states with the same inventory and position but different direction\n                  if (tuple(new_state.inventory), new_state.pos) not in visited:\n                      queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T15:15:53.698780", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(state):\n      neighbors = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          # Convert the new state to a hashable form\n          state_hash = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos, new_state.dir)\n          neighbors.append((new_state, state_hash, action))\n      return neighbors\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of steps taken so far (A* becomes BFS in this case)\n      return len(state._cached_features) if state._cached_features is not None else 0\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for new_state, state_hash, action in get_neighbors(current_state):\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  f_score = heuristic(new_state, goal_item) + len(path) + 1\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:16:32.402805", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of items missing in the inventory to reach the goal\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory[list(primitives.keys())]\n      required_counts = np.array(list(primitives.values()))\n      return np.sum(required_counts - current_inventory)\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = [(0, initial_state, [])]  # (f_score, state, path)\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:16:48.085007", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=50):  # Added max depth to prevent infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= max_depth:  # Check against the maximum depth allowed\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 1.5}}
