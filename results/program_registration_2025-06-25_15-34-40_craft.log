{"timestamp": "2025-06-27T14:59:15.276647", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n\n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      valid_actions = []\n      for action in range(initial_state.world.n_actions):\n          reward, new_state = current_state.step(action)\n\n          if action == 4:  # USE action\n              can_make_goal = all(new_state.inventory[primitive] >= count for primitive, count in goal_primitives.items())\n              if not can_make_goal:\n                  continue\n\n          valid_actions.append((action, new_state))\n      \n      for action, new_state in valid_actions:\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          if state_hash not in visited:\n              visited.add(state_hash)\n              queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def find_pickup_actions(initial_state, primitives):\n      \"\"\"Finds actions to pickup required primitives.\"\"\"\n      actions = []\n      for primitive_index in primitives.keys():\n          while initial_state.inventory[primitive_index] < primitives[primitive_index]:\n              # Check if the primitive is next to the agent\n              if initial_state.next_to(primitive_index):\n                  # Find the action to pick up the primitive\n                  for action in range(initial_state.world.n_actions - 1):  # Exclude USE action\n                      reward, new_state = initial_state.step(action)\n                      if new_state.inventory[primitive_index] > initial_state.inventory[primitive_index]:\n                          actions.append(action)\n                          initial_state = new_state\n                          break\n              else:\n                  # Move towards the primitive (simple strategy)\n                  for action in range(initial_state.world.n_actions - 1):  # Exclude USE action\n                      reward, new_state = initial_state.step(action)\n                      if any(new_state.grid[new_pos] == primitive_index for new_pos in get_neighbors(initial_state.pos)):\n                          actions.append(action)\n                          initial_state = new_state\n                          break\n      return actions\n\n  def get_neighbors(pos):\n      \"\"\"Returns the neighbors of a given position.\"\"\"\n      x, y = pos\n      return [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already available in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []  # No actions needed as the goal item is already in the inventory\n\n  # Find the sequence of actions to craft the goal item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      return None  # Return None if no crafting sequence found\n\n  # Extract primitives needed for the goal item\n  goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n  \n  # Find actions to pickup required primitives\n  pickup_actions = find_pickup_actions(initial_state, goal_primitives)\n\n  return pickup_actions + action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
