{"timestamp": "2025-06-27T05:22:24.368869", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_item, primitive_counts):\n      # Simple heuristic: Count how many of the required primitives are still needed\n      needed_primitives = {primitive: max(0, primitive_counts[primitive] - state.inventory[primitive]) \n                           for primitive in primitive_counts}\n      return sum(needed_primitives.values())\n\n  def a_star_search(initial_state, goal_item, primitive_counts):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          f_cost, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          state_hash = (tuple(current_state.grid.flatten()), \n                        tuple(current_state.inventory), \n                        current_state.pos, \n                        current_state.dir)\n          \n          if state_hash in visited:\n              continue\n          \n          visited.add(state_hash)\n          \n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in primitive_counts.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              g_cost = len(path) + 1  # Cost from start to current state plus one for the next step\n              h_cost = heuristic(new_state, goal_item, primitive_counts)\n              f_cost = g_cost + h_cost  # Total cost\n            \n              new_path = path + [action]\n              heapq.heappush(open_set, (f_cost, new_state, new_path))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Preprocess: Collect all possible primitives needed for the goal item\n  primitive_counts = get_primitive_counts(goal_item, initial_state.world.cookbook)\n  \n  action_sequence = a_star_search(initial_state, goal_item, primitive_counts)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
