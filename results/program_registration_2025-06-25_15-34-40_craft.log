{"timestamp": "2025-06-26T14:52:48.722740", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic based on the count of the goal item in the inventory\n      return -state.inventory[goal_item]\n\n  def a_star_search(initial_state, goal_item, max_steps=500):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item) or len(path) >= max_steps:\n              return path\n          \n          # Prioritize actions that involve using items (USE action)\n          priority_actions = [4] + list(range(env.world.n_actions - 1))  # Use action first, then others\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heapq.heappush(open_set, (len(path) + 1 + heuristic(new_state, goal_item), new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:52:49.700936", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n    # Heuristic based on distance from primitive resources\n    primitives = env.world.cookbook.primitives_for(goal_item).keys()\n    min_distance = float('inf')\n    \n    for p in primitives:\n      if state.next_to(p):\n        return 0\n      else:\n        distances = []\n        for i in range(env.world.WIDTH):\n          for j in range(env.world.HEIGHT):\n            if state.grid[i, j, p] > 0:\n              distance = abs(state.pos[0] - i) + abs(state.pos[1] - j)\n              distances.append(distance)\n        \n        min_distance = min(min_distance, min(distances) if distances else float('inf'))\n    \n    return min_distance\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      \n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that involve using items (USE action) and moving towards primitives\n          priority_actions = [4] + list(range(env.world.n_actions - 1))  # Use action first, then others\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each action has a cost of 1\n            \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n            \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:54:04.202667", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, depth_limit=50):  # Added depth limit to prevent infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= depth_limit:  # Skip paths exceeding the depth limit\n              continue\n          \n          # Generate and prioritize actions based on heuristics\n          for action in prioritize_actions(env.world.n_actions, current_state, path[-1] if path else None, goal_item):\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_actions(n_actions, current_state, last_action=None, goal_item=None):\n      \"\"\"Prioritize actions based on heuristics.\"\"\"\n      priority = []\n      \n      # Always try to USE first\n      priority.append(4)\n      \n      # Avoid repeating the same movement action consecutively\n      move_actions = list(range(4))\n      if last_action in move_actions:\n          move_actions.remove(last_action)\n      \n      # Heuristic: prioritize actions that lead towards adjacent resources or workshops for goal item\n      def distance(action):\n          new_pos = get_new_position(current_state.pos, current_state.dir, action)\n          grid_size_x, grid_size_y = current_state.grid.shape[:2]\n          \n          # Find positions of adjacent resources and workshops needed to craft the goal item\n          required_resources = set()\n          for ingredient_index in env.world.cookbook.recipes.get(goal_item, {}).keys():\n              if isinstance(ingredient_index, int) and ingredient_index not in env.world.environment:\n                  required_resources.add(ingredient_index)\n          \n          # Calculate distances to these resources\n          distances = []\n          for res_index in required_resources:\n              resource_positions = np.argwhere(current_state.grid[:, :, res_index] > 0)\n              for x, y in resource_positions:\n                  dist = abs(new_pos[0] - x) + abs(new_pos[1] - y)\n                  distances.append(dist)\n          \n          return min(distances, default=float('inf'))\n      \n      move_actions.sort(key=distance)\n      priority.extend(move_actions)\n      \n      return priority\n\n  def get_new_position(pos, dir, action):\n      \"\"\"Calculate the new position based on current position, direction, and action.\"\"\"\n      directions = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # RIGHT, LEFT, UP, DOWN\n      new_dir = dir\n      \n      if action < 4:  # Movement actions\n          new_pos = tuple(p + d for p, d in zip(pos, directions[action]))\n      elif action == 4:  # USE action\n          new_pos = pos\n      else:\n          raise ValueError(\"Invalid action\")\n      \n      return new_pos\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:54:05.177459", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      \"\"\"Simple heuristic: number of steps to reach the nearest resource or workshop.\"\"\"\n      grid = state.grid\n      pos = state.pos\n      \n      # Find positions of resources and workshops related to the goal item\n      cookbook = env.world.cookbook\n      primitives = cookbook.primitives_for(goal_item)\n      \n      target_positions = []\n      for i_kind, count in primitives.items():\n          if i_kind not in grid[pos].nonzero()[0]:  # If the resource is not already at the current position\n              positions = np.argwhere(grid[:, :, i_kind] > 0)\n              for x, y in positions:\n                  target_positions.append((x, y))\n      \n      if not target_positions:\n          return 0\n      \n      # Calculate Manhattan distance to the nearest target position\n      distances = [abs(pos[0] - x) + abs(pos[1] - y) for x, y in target_positions]\n      return min(distances)\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      from heapq import heappush, heappop\n      \n      priority_queue = []\n      heappush(priority_queue, (0, initial_state, []))  # Priority queue based on heuristic cost\n      visited = set()\n      \n      while priority_queue:\n          _, current_state, path = heappop(priority_queue)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Try actions in a specific order: UP, DOWN, LEFT, RIGHT, USE\n          for action in [1, 0, 2, 3, 4]:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  cost = heuristic(new_state, goal_item) + len(path)  # Heuristic cost\n                  heappush(priority_queue, (cost, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:55:25.533641", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_actions(actions):\n      \"\"\"Prioritize actions to move towards known resources.\"\"\"\n      prioritized_actions = []\n      \n      # Define a heuristic for moving towards known resources\n      def heuristic(state, resource_idx):\n          x, y = state.pos\n          grid_size = env.world.cookbook.n_kinds\n          grid_width = env._current_state.grid.shape[0]\n          \n          distances = []\n          for i in range(grid_width):\n              for j in range(grid_width):\n                  if state.grid[i, j, resource_idx] > 0:\n                      dist = abs(i - x) + abs(j - y)\n                      distances.append(dist)\n          \n          return min(distances) if distances else float('inf')\n      \n      # Prioritize actions based on heuristic\n      for action in actions:\n          reward, new_state = initial_state.step(action)\n          # Move towards water or stone\n          resource_heuristics = [\n              heuristic(new_state, env.world.water_index),\n              heuristic(new_state, env.world.stone_index)\n          ]\n          if min(resource_heuristics) < float('inf'):\n              prioritized_actions.append((action, min(resource_heuristics)))\n      \n      # Sort actions by the lowest heuristic value\n      prioritized_actions.sort(key=lambda x: x[1])\n      return [action for action, _ in prioritized_actions]\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Try to find a direct path first\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      print(\"Direct path not found. Attempting alternative strategies.\")\n      \n      # Get all possible actions and prioritize them\n      actions = list(range(env.world.n_actions))\n      prioritized_actions = prioritize_actions(actions)\n      \n      for action in prioritized_actions:\n          reward, new_state = initial_state.step(action)\n          \n          if satisfies_goal(new_state, goal_item):\n              return [action]\n          \n          # If not satisfied, try to find a path from the new state\n          action_sequence_from_new_state = bfs_search(new_state, goal_item)\n          \n          if action_sequence_from_new_state:\n              return [action] + action_sequence_from_new_state\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:55:41.453704", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the environment is already at a satisfied state for the goal item\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  # If no direct path found, try to gather primitives and resources first\n  if not action_sequence:\n      print(\"Direct path not found. Attempting to gather required primitives/resources.\")\n      \n      # Identify required primitives for the goal item\n      required_primitives = env.world.cookbook.primitives_for(goal_item)\n      \n      # For each required primitive, find a sequence of actions to obtain it\n      for primitive_idx in required_primitives:\n          if satisfies_goal(initial_state, primitive_idx):\n              continue  # Skip if already have this primitive\n      \n          print(f\"Gathering {env.world.cookbook.index.get(primitive_idx)}\")\n          \n          action_sequence_to_primitive = bfs_search(initial_state, primitive_idx)\n          \n          if not action_sequence_to_primitive:\n              print(f\"Unable to gather {env.world.cookbook.index.get(primitive_idx)}. Skipping.\")\n              continue\n          \n          # Execute the actions to gather the primitive\n          for action in action_sequence_to_primitive:\n              reward, initial_state = initial_state.step(action)\n      \n      # After gathering primitives, try again to find a path to the goal item\n      action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:56:32.666362", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action (index 4) and actions that involve picking up resources\n          actions = [4] + [i for i in range(5) if i != 4]\n          \n          for action in actions:\n              reward, new_state = current_state.step(action)\n              \n              # Skip invalid actions that incur penalties\n              if reward < 0:\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:56:44.168281", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action (index 4) and avoid repeated actions if possible\n          actions = [4] + list(range(4))\n          last_action = path[-1] if path else None\n          \n          for action in actions:\n              if action == last_action:\n                  continue  # Avoid repeating the same action consecutively\n              \n              reward, new_state = current_state.step(action)\n              \n              # Skip invalid actions that incur penalties\n              if reward < 0:\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:57:26.830358", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that involve using items or interacting with the environment\n          priority_actions = [4] + list(range(env.world.n_actions - 1))  # Use action first, then others\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
