{"timestamp": "2025-06-26T20:39:54.180206", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Prioritize actions that can contribute to making the goal item\n          priority_actions = []\n          other_actions = []\n          \n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      priority_actions.append((new_state, path + [action]))\n                  else:\n                      other_actions.append((new_state, path + [action]))\n              else:\n                  other_actions.append((new_state, path + [action]))\n          \n          # Add priority actions first to the queue\n          for new_state, action_path in priority_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.appendleft((new_state, action_path))\n          \n          # Add other actions to the queue\n          for new_state, action_path in other_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, action_path))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T20:43:00.263504", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def a_star_search(start_pos, goal_pos):\n      from heapq import heappush, heappop\n      \n      open_set = [(heuristic(start_pos, goal_pos), start_pos, [])]\n      came_from = {}\n      g_score = {start_pos: 0}\n      \n      while open_set:\n          _, current_pos, path = heappop(open_set)\n          \n          if current_pos == goal_pos:\n              return path\n          \n          for neighbor in get_neighbors(current_pos):\n              tentative_g_score = g_score[current_pos] + 1\n              \n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = (current_pos, path)\n                  g_score[neighbor] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(neighbor, goal_pos)\n                  heappush(open_set, (f_score, neighbor, path + [neighbor]))\n      \n      return None  # Return None if no path is found\n\n  def move_to_workshop(initial_state):\n      start_pos = initial_state.pos\n      target_workshops = [(x, y) for x in range(env.world.grid.shape[0]) \n                          for y in range(env.world.grid.shape[1]) if env.world.workshop_indices[x, y]]\n      \n      min_cost_path = None\n      \n      for workshop in target_workshops:\n          path = a_star_search(start_pos, workshop)\n          if path and (min_cost_path is None or len(path) < len(min_cost_path)):\n              min_cost_path = path\n      \n      # Convert the move-to-workshop path to action sequence\n      if min_cost_path:\n          action_sequence = []\n          current_pos = start_pos\n          for next_pos in min_cost_path:\n              dx = next_pos[0] - current_pos[0]\n              dy = next_pos[1] - current_pos[1]\n              \n              if dx == -1 and dy == 0:  # LEFT\n                  action_sequence.append(2)\n              elif dx == 1 and dy == 0:  # RIGHT\n                  action_sequence.append(3)\n              elif dx == 0 and dy == -1:  # DOWN\n                  action_sequence.append(0)\n              elif dx == 0 and dy == 1:  # UP\n                  action_sequence.append(1)\n              \n              current_pos = next_pos\n      \n      return action_sequence\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n  \n  if action_sequence:\n      return action_sequence\n  else:\n      # Attempt to move towards a workshop using A* search\n      workshop_action_sequence = move_to_workshop(initial_state)\n      \n      if workshop_action_sequence:\n          return workshop_action_sequence\n      \n      return []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 1.5}}
