{"timestamp": "2025-06-26T20:02:23.684715", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize certain actions (e.g., USE) over others\n          action_order = [4] + list(range(4))  # USE first, then other movements\n          \n          for action in action_order:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T20:03:26.428842", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic: count the number of missing ingredients\n      if satisfies_goal(current_state, goal_item):\n          return 0\n      \n      primitives = env.world.cookbook.primitives_for(goal_item)\n      missing_count = sum(primitives.get(i_kind, 0) - current_state.inventory[i_kind] for i_kind in primitives)\n      return missing_count\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), 0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, cost_so_far, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  new_cost = cost_so_far + 1  # Assuming each action has a cost of 1\n                  heappush(open_set, (new_cost + heuristic(new_state, goal_item), new_cost, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T20:03:54.977679", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: count the number of steps to gather all primitives needed\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory\n      additional_steps = 0\n      \n      for primitive_index, required_count in primitives.items():\n          if current_inventory[primitive_index] < required_count:\n              # Assuming each step can either pick up one item or move towards it\n              additional_steps += (required_count - current_inventory[primitive_index]) * 2\n      \n      return additional_steps\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import itertools\n      \n      # Priority queue entry: (total estimated cost, counter to break ties, state, path)\n      pq = []\n      counter = itertools.count()\n      \n      start_cost = heuristic(initial_state, goal_item)\n      start_entry = [start_cost, next(counter), initial_state, []]\n      heappush(pq, start_entry)\n      \n      visited = set()\n      \n      while pq:\n          _, __, current_state, path = heappop(pq)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  cost = len(path) + heuristic(new_state, goal_item)\n                  entry = [cost, next(counter), new_state, path + [action]]\n                  heappush(pq, entry)\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T20:05:51.267248", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: count the number of steps to gather all primitives needed\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory\n      additional_steps = 0\n      \n      for primitive_index, required_count in primitives.items():\n          if current_inventory[primitive_index] < required_count:\n              # Assuming each step can either pick up one item or move towards it\n              additional_steps += (required_count - current_inventory[primitive_index]) * 2\n      \n      return additional_steps\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import itertools\n      \n      # Priority queue entry: (total estimated cost, counter to break ties, state, path)\n      pq = []\n      counter = itertools.count()\n      \n      start_cost = heuristic(initial_state, goal_item)\n      start_entry = [start_cost, next(counter), initial_state, []]\n      heappush(pq, start_entry)\n      \n      visited = set()\n      \n      while pq:\n          _, __, current_state, path = heappop(pq)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  cost = len(path) + heuristic(new_state, goal_item)\n                  entry = [cost, next(counter), new_state, path + [action]]\n                  heappush(pq, entry)\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_action_sequence(actions):\n      \"\"\"Optimize the action sequence by removing redundant movements.\"\"\"\n      optimized_actions = []\n      current_direction = 0  # Assuming direction 0 as default (can be set to initial state's direction)\n      \n      for action in actions:\n          if action < 4:  # Directional movement\n              current_direction = action\n          else:  # USE action\n              optimized_actions.append(current_direction)  # Move towards the item before using it\n              optimized_actions.append(action)\n          \n      return optimized_actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  raw_action_sequence = a_star_search(initial_state, goal_item)\n\n  if not raw_action_sequence:\n      return []  # Return empty list if no actions found\n  \n  action_sequence = optimize_action_sequence(raw_action_sequence)\n\n  return action_sequence", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-06-26T20:05:52.244699", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: count the number of steps to gather all primitives needed\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory\n      \n      additional_steps = 0\n      \n      for primitive_index, required_count in primitives.items():\n          if current_inventory[primitive_index] < required_count:\n              # Assuming each step can either pick up one item or move towards it\n              missing_items = required_count - current_inventory[primitive_index]\n              \n              # Check if there are nearby primitives that can be picked up\n              for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                  x, y = state.pos[0] + dx, state.pos[1] + dy\n                  if (x >= 0 and x < env.world.grid.shape[0] and \n                      y >= 0 and y < env.world.grid.shape[1] and \n                      np.argmax(state.grid[x, y]) == primitive_index):\n                      additional_steps += missing_items\n                      break\n              else:\n                  # If no nearby primitives, assume more steps to move towards them\n                  additional_steps += missing_items * 2\n      \n      return additional_steps\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import itertools\n      \n      # Priority queue entry: (total estimated cost, counter to break ties, state, path)\n      pq = []\n      counter = itertools.count()\n      \n      start_cost = heuristic(initial_state, goal_item)\n      start_entry = [start_cost, next(counter), initial_state, []]\n      heappush(pq, start_entry)\n      \n      visited = set()\n      \n      while pq:\n          _, __, current_state, path = heappop(pq)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  cost = len(path) + heuristic(new_state, goal_item)\n                  entry = [cost, next(counter), new_state, path + [action]]\n                  heappush(pq, entry)\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T20:07:05.058569", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Optimize by considering only valid actions (e.g., not walking into walls)\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # If the state is unchanged, skip adding it to the queue\n              if np.array_equal(new_state.grid, current_state.grid) and\\\n                 np.array_equal(new_state.inventory, current_state.inventory) and\\\n                 new_state.pos == current_state.pos and\\\n                 new_state.dir == current_state.dir:\n                  continue\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid and is a primitive or can be crafted\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  if goal_item not in env.world.cookbook.primitives and goal_item not in env.world.cookbook.recipes:\n      raise ValueError(f\"Goal item {goal_item} cannot be crafted or collected.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
