{"timestamp": "2025-06-26T20:09:42.055611", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory to avoid unnecessary computation\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T20:11:25.620409", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Heuristic: Prioritize actions that move closer to having required primitives\n              new_primitives = get_primitive_counts(goal_item, new_state.world.cookbook)\n              heuristic_score = sum(min(new_primitives.get(primitive, 0) - current_primitives, 0)\n                                    for primitive, current_primitives in goal_primitives.items())\n\n              valid_actions.append((new_state, action, heuristic_score))\n          \n          # Sort actions by heuristic score (descending order)\n          valid_actions.sort(key=lambda x: x[2], reverse=True)\n          \n          for new_state, action, _ in valid_actions:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-26T20:11:35.435109", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              possible_actions.append((new_state, path + [action]))\n\n          # Heuristic: Prioritize actions that move closer to having required primitives\n          possible_actions.sort(\n              key=lambda x: sum(min(get_primitive_counts(goal_item, x[0].world.cookbook).get(primitive, 0) - current_primitives, 0)\n                                  for primitive, current_primitives in goal_primitives.items()),\n              reverse=True\n          )\n\n          for new_state, path_with_action in possible_actions:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path_with_action))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-26T20:12:46.215900", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      # Priority queue to store (cost, state, path)\n      pq = PriorityQueue()\n      start_cost = 0\n      pq.put((start_cost, initial_state, []))\n      \n      # Dictionary to keep track of visited states and their costs\n      visited = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + initial_state.pos: 0}\n      \n      while not pq.empty():\n          current_cost, current_state, path = pq.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Calculate the cost of moving to the new state\n              new_cost = current_cost + 1  # Assuming each action has a cost of 1\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = tuple(new_state.grid.flatten()) + tuple(new_state.inventory) + new_state.pos\n              \n              if state_hash not in visited or new_cost < visited[state_hash]:\n                  visited[state_hash] = new_cost\n                  priority = new_cost  # In A*, priority is the cost so far (g)\n                  pq.put((priority, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T20:13:01.349978", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          possible_actions = get_all_possible_actions(current_state)\n          \n          for action, new_state in possible_actions:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_all_possible_actions(state):\n      actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          if not np.array_equal(new_state.grid, state.grid) or\\\n             not np.array_equal(new_state.inventory, state.inventory) or\\\n             new_state.pos != state.pos or\\\n             new_state.dir != state.dir:\n              actions.append((action, new_state))\n      return actions\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T20:16:20.297824", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          action_sequence = []\n          \n          # Try to make primitives that are needed\n          for primitive, count in goal_primitives.items():\n              if current_state.inventory[primitive] < count:\n                  new_action_seq = bfs_search_recursive(current_state, primitive)\n                  if new_action_seq is not None:\n                      action_sequence.extend(new_action_seq)\n      \n          # If we have made all primitives, try to make the goal item\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def bfs_search_recursive(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          action_sequence = []\n\n          # Try to make primitives that are needed\n          for primitive, count in goal_primitives.items():\n              if current_state.inventory[primitive] < count:\n                  for action in range(initial_state.world.n_actions):\n                      reward, new_state = current_state.step(action)\n                      \n                      if action == 4:  # USE action\n                          # Check if the use action can contribute to making the goal item\n                          for primitive, count in goal_primitives.items():\n                              if new_state.inventory[primitive] < count:\n                                  continue  # Skip this action as it doesn't help make the goal item\n                          \n                          if satisfies_goal(new_state, goal_item):\n                              return path + [action]\n                      \n                      # Convert the new state to a hashable form using a tuple of its attributes\n                      state_hash = (tuple(new_state.grid.flatten()), \n                                    tuple(new_state.inventory), \n                                    new_state.pos, \n                                    new_state.dir)\n                      \n                      if state_hash not in visited:\n                          visited.add(state_hash)\n                          queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_inventory_counts(state):\n      return {index: count for index, count in enumerate(state.inventory) if count > 0}\n\n  initial_state = env._current_state\n  goal_item = item\n\n  # Collect all items needed to make the goal item and their counts\n  required_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n  # Check current inventory for any items that can be used directly\n  current_inventory = get_inventory_counts(initial_state)\n\n  # Calculate the net requirements by subtracting current inventory from required primitives\n  net_requirements = {item: required_primitives[item] - current_inventory.get(item, 0) for item in required_primitives if required_primitives[item] > current_inventory.get(item, 0)}\n\n  action_sequence = []\n\n  # Try to make each required primitive\n  for primitive, count in net_requirements.items():\n      if count <= 0:\n          continue\n      \n      # BFS search to find actions to create the required primitive\n      new_action_seq = bfs_search_recursive(initial_state, primitive)\n      \n      if new_action_seq is not None:\n          action_sequence.extend(new_action_seq)\n\n  # After making all primitives, try to make the goal item\n  final_action_seq = bfs_search(initial_state, goal_item)\n  \n  if final_action_seq is not None:\n      action_sequence.extend(final_action_seq)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 1.1}}
