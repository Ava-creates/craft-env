{"timestamp": "2025-06-26T12:18:06.758967", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def heuristic(state, goal_item):\n      # Calculate the number of steps needed to gather all primitives\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      \n      total_steps = 0\n      for prim, count in primitives.items():\n          if state.inventory[prim] < count:\n              diff = count - state.inventory[prim]\n              \n              # Find the nearest workshop or resource\n              min_distance = float('inf')\n              for i in range(env.world.grid.shape[0]):\n                  for j in range(env.world.grid.shape[1]):\n                      if env.world.grid[i, j, prim] > 0:\n                          distance = abs(i - state.pos[0]) + abs(j - state.pos[1])\n                          min_distance = min(min_distance, distance)\n              \n              total_steps += diff * (min_distance + 1)  # Add one for the use action\n      \n      return total_steps\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import itertools\n      \n      open_heap = []\n      heap_counter = itertools.count()\n      \n      start_hash = (tuple(initial_state.grid.flatten()), \n                    tuple(initial_state.inventory), \n                    initial_state.pos, \n                    initial_state.dir)\n      \n      entry = (0, next(heap_counter), initial_state, [], start_hash)\n      heappush(open_heap, entry)\n      visited = set([start_hash])\n      \n      while open_heap:\n          current_cost, _, current_state, path, state_hash = heappop(open_heap)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              next_hash = (tuple(new_state.grid.flatten()), \n                           tuple(new_state.inventory), \n                           new_state.pos, \n                           new_state.dir)\n              \n              if next_hash not in visited:\n                  g_cost = current_cost + 1  # Assume each action has cost 1\n                  h_cost = heuristic(new_state, goal_item)\n                  f_cost = g_cost + h_cost\n                  \n                  entry = (f_cost, next(heap_counter), new_state, path + [action], next_hash)\n                  heappush(open_heap, entry)\n                  visited.add(next_hash)\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
