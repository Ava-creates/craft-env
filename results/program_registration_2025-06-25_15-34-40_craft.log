{"timestamp": "2025-06-27T12:44:21.793105", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T12:46:35.593877", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import itertools\n      \n      open_set = []\n      open_heap_counter = itertools.count()  # Unique sequence count for heap stability\n      heappush(open_set, (0, next(open_heap_counter), initial_state, []))\n      \n      visited = set()\n      \n      while open_set:\n          _, _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  cost = len(path) + heuristic(new_state, goal_item)\n                  heappush(open_set, (cost, next(open_heap_counter), new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(current_state, goal_item):\n      primitives_needed = get_primitive_counts(goal_item, current_state.world.cookbook)\n      current_primitives = {i: count for i, count in enumerate(current_state.inventory) if count > 0 and i in primitives_needed}\n      \n      steps_needed = 0\n      for primitive, required_count in primitives_needed.items():\n          available_count = current_primitives.get(primitive, 0)\n          # Calculate the number of additional gatherings needed\n          additional_gatherings = max(0, (required_count - available_count) // (primitives_needed[primitive] / (available_count + 1)))\n          steps_needed += additional_gathering\n      \n      return steps_needed\n\n  def get_primitive_actions(current_state, primitive_index):\n      actions = []\n      \n      # Check all possible moves and USE actions to gather the primitive\n      for action in range(current_state.world.n_actions):\n          reward, new_state = current_state.step(action)\n          \n          if action == 4:  # USE action\n              if new_state.inventory[primitive_index] > current_state.inventory[primitive_index]:\n                  actions.append(action)\n          else:\n              # Check if the primitive is available in the vicinity after moving\n              if primitive_index in get_available_primitives(new_state):\n                  actions.append(action)\n      \n      return actions\n\n  def get_available_primitives(state):\n      # Implement a function to determine which primitives are available in the vicinity of the current state\n      # This can be based on the grid and the position of the agent\n      available_primitives = []\n      # Example: Check nearby cells in the grid for primitives\n      x, y = state.pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < state.world.scenario.grid.shape[0] and 0 <= ny < state.world.scenario.grid.shape[1]:\n              cell_type = state.world.scenario.grid[nx, ny]\n              # Check if the cell contains a primitive\n              if cell_type in state.world.cookbook.primitives:\n                  available_primitives.append(cell_type)\n      return available_primitives\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
