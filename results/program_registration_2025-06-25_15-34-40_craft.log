Item {goal_item} does not have a recipe or is not a primitive.\")\n      return []\n\n  # Check if the goal item is already in inventory\n  if satisfies_goal(initial_state, goal_item):\n    return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T21:54:31.099035", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              if is_valid_action(current_state, action):\n                  reward, new_state = current_state.step(action)\n                  \n                  # Convert the new state to a hashable form using a tuple of its attributes\n                  state_hash = (tuple(new_state.grid.flatten()), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir)\n                  \n                  if state_hash not in visited:\n                      visited.add(state_hash)\n                      queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def is_valid_action(state, action):\n      if action == env.world.N_ACTIONS['USE']:\n          # Check if the agent can use an item at the current position\n          return state.next_to(env.world.workshop_indices) or state.inventory[state.index.get(env.world.cookbook.recipes[item].get(\"_key\"))] > 0\n      elif action in [env.world.N_ACTIONS['DOWN'], env.world.N_ACTIONS['UP'], env.world.N_ACTIONS['LEFT'], env.world.N_ACTIONS['RIGHT']]:\n          # Check if the agent can move in the specified direction\n          return True\n      return False\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in env.world.cookbook.primitives and goal_item not in env.world.cookbook.recipes:\n      print(f\"Item {goal_item} does not have a recipe or is not a primitive.\")\n      return []\n\n  # Check if the goal item is already in inventory\n  if satisfies_goal(initial_state, goal_item):\n    return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T22:00:42.577472", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = True\n                  # Check if the use action can contribute to making the goal item\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def bfs_search_recursive(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          action_sequence = []\n\n          # Try to make primitives that are needed\n          for primitive, count in goal_primitives.items():\n              if current_state.inventory[primitive] < count:\n                  for action in range(initial_state.world.n_actions):\n                      reward, new_state = current_state.step(action)\n                      \n                      if action == 4:  # USE action\n                          # Check if the use action can contribute to making the goal item\n                          can_use = True\n                          for primitive, count in goal_primitives.items():\n                              if new_state.inventory[primitive] < count:\n                                  can_use = False\n                                  break\n                          \n                          if can_use and satisfies_goal(new_state, goal_item):\n                              return path + [action]\n                      \n                      # Convert the new state to a hashable form using a tuple of its attributes\n                      state_hash = (tuple(new_state.grid.flatten()), \n                                    tuple(new_state.inventory), \n                                    new_state.pos, \n                                    new_state.dir)\n                      \n                      if state_hash not in visited:\n                          visited.add(state_hash)\n                          queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def bfs_search_optimized(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          actions_to_try = []\n          \n          # Prioritize USE action to make progress towards the goal\n          for action in range(initial_state.world.n_actions):\n              if action == 4:\n                  reward, new_state = current_state.step(action)\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  if can_make_goal and satisfies_goal(new_state, goal_item):\n                      return path + [action]\n                  actions_to_try.append((new_state, action))\n              else:\n                  reward, new_state = current_state.step(action)\n                  actions_to_try.append((new_state, action))\n          \n          # Add new states to the queue\n          for new_state, action in actions_to_try:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item can be crafted (i.e., it's in the cookbook)\n  if goal_item not in initial_state.world.cookbook.recipes and goal_item not in initial_state.world.cookbook.primitives:\n      return []  # Return empty list if the goal item is uncraftable\n\n  action_sequence = bfs_search_optimized(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 1.5}}
