{"timestamp": "2025-06-27T07:37:14.959335", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n\n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              possible_actions.append((action, new_state))\n          \n          for action, new_state in sorted(possible_actions, key=lambda x: len(get_primitive_counts(goal_item, initial_state.world.cookbook))):\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_sub_goals(initial_state, goal_item):\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      return [(primitive, count) for primitive, count in goal_primitives.items()]\n\n  def execute_sub_goal(env, sub_goal, count):\n      action_sequence = []\n      current_state = env._current_state\n      \n      while count > 0:\n          path_to_primitive = bfs_search(current_state, sub_goal)\n          \n          if not path_to_primitive:\n              return None  # Unable to find a sequence to obtain the primitive\n          \n          action_sequence.extend(path_to_primitive)\n          for action in path_to_primitive:\n              _, current_state = current_state.step(action)\n          \n          # Check if we have enough of the primitive now\n          primitives_needed = get_primitive_counts(sub_goal, env.world.cookbook)[sub_goal]\n          if current_state.inventory[sub_goal] >= primitives_needed:\n              break\n      \n      return action_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # First try to find a direct path to the goal item\n  action_sequence = bfs_search(initial_state, goal_item)\n  if action_sequence:\n      return action_sequence\n  \n  # If no direct path is found, break down the goal into sub-goals (primitives)\n  sub_goals = get_sub_goals(initial_state, goal_item)\n  \n  full_action_sequence = []\n  for primitive, count in sub_goals:\n      sub_goal_path = execute_sub_goal(env, primitive, count)\n      \n      if not sub_goal_path:\n          return []  # If any sub-goal cannot be achieved, return an empty sequence\n      \n      full_action_sequence.extend(sub_goal_path)\n      \n      # Update the environment state after achieving each sub-goal\n      for action in sub_goal_path:\n          _, initial_state = initial_state.step(action)\n  \n      if satisfies_goal(initial_state, goal_item):\n          break\n  \n  # Final attempt to get the main goal after executing all sub-goals\n  final_goal_path = bfs_search(initial_state, goal_item)\n  if final_goal_path:\n      full_action_sequence.extend(final_goal_path)\n  \n  return full_action_sequence if full_action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 2.0}}
