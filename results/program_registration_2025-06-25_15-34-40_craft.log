_state = initial_state\n              for action in prim_action_seq:\n                  _, current_state = current_state.step(action)\n          \n          initial_state = current_state\n      \n      return primitive_actions\n\n  def craft_item(initial_state, goal_item):\n      \"\"\"Craft the item using gathered primitives.\"\"\"\n      # Try to find a direct path first\n      action_sequence = bfs_search(initial_state, goal_item)\n\n      if not action_sequence and env.world.cookbook.primitives_for(goal_item):\n          # Fallback: Try to gather prerequisites\n          primitive_actions = gather_primitives(initial_state, goal_item)\n          \n          if not primitive_actions:\n              return None  # No actions found to gather primitives\n          \n          # After gathering primitives, attempt to craft the goal item again\n          new_initial_state, _ = initial_state.step(primitive_actions[-1])\n          final_sequence = bfs_search(new_initial_state, goal_item)\n          \n          if final_sequence:\n              action_sequence = primitive_actions + final_sequence\n\n      return action_sequence if action_sequence else []  # Return empty list if no actions found\n\n  def optimize_action_sequence(actions):\n      \"\"\"Optimize the sequence of actions to remove redundant movements.\"\"\"\n      optimized_actions = []\n      current_pos = env._current_state.pos\n      current_dir = env._current_state.dir\n      \n      for action in actions:\n          new_state, _ = env._current_state.step(action)\n          \n          # Check if the position and direction changed\n          pos_changed = new_state.pos != current_pos\n          dir_changed = new_state.dir != current_dir\n          \n          if pos_changed or dir_changed or action == 4:  # USE action should always be kept\n              optimized_actions.append(action)\n          \n          current_pos = new_state.pos\n          current_dir = new_state.dir\n      \n      return optimized_actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = craft_item(initial_state, goal_item)\n\n  if not action_sequence:\n      return []  # Return empty list if no actions found\n  \n  optimized_action_sequence = optimize_action_sequence(action_sequence)\n  \n  return optimized_action_sequence", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T11:04:00.335619", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=50):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Check if the current depth exceeds the maximum allowed depth\n          if len(path) >= max_depth:\n              continue\n\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T11:04:16.013630", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=50):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Check if the current depth exceeds the maximum allowed depth\n          if len(path) >= max_depth:\n              continue\n\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def retry_bfs_search(env, goal_item, max_retries=5):\n      for _ in range(max_retries):\n          env.reset()\n          initial_state = env._current_state\n          action_sequence = bfs_search(initial_state, goal_item)\n          if action_sequence:\n              return action_sequence\n\n          print(f\"Retry {_+1} failed. Resetting environment and retrying...\")\n          env.world.sample_scenario()\n\n      return None  # Return None if all retries fail\n\n  goal_item = item\n  action_sequence = retry_bfs_search(env, goal_item)\n\n  return action_sequence if action_sequence else []", "island_id": 1, "scores": {"3": 1.5}}
