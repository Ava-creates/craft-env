{"timestamp": "2025-06-26T17:01:13.570982", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Heuristic based on the number of primitives needed to craft the goal\n      cookbook = env.world.cookbook\n      if goal_item not in cookbook.recipes:\n          return float('inf')\n      \n      # Calculate the number of primitive resources required\n      primitives_needed = {p: 0 for p in cookbook.primitives}\n      \n      def dfs(recipe_output, count):\n          if recipe_output in cookbook.primitives:\n              primitives_needed[recipe_output] += count\n              return\n          \n          recipe = cookbook.recipes.get(recipe_output, {})\n          key_ingredient = recipe.pop(\"_key\", None)\n          \n          for ingredient, amount in recipe.items():\n              dfs(ingredient, amount * count)\n          \n          if key_ingredient is not None:\n              dfs(key_ingredient, 1 * count)\n      \n      dfs(goal_item, 1)\n      \n      # Calculate the cost based on missing primitives\n      cost = sum(primitives_needed[p] - state.inventory[p] for p in cookbook.primitives if state.inventory[p] < primitives_needed[p])\n      return cost\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      \n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory): 0}\n      \n      while open_set:\n          current_f, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              state_hash = tuple(new_state.grid.flatten()) + tuple(new_state.inventory)\n              \n              tentative_g_score = g_score.get(state_hash, float('inf'))\n              current_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory)] + 1\n              \n              if current_g_score < tentative_g_score:\n                  came_from[state_hash] = (tuple(current_state.grid.flatten()) + tuple(current_state.inventory), action)\n                  g_score[state_hash] = current_g_score\n                  f_score = current_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-06-26T17:01:58.068234", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action over movement actions and avoid revisiting states\n          priority_actions = [4] + list(range(env.world.n_actions))[:-1]\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]  # Return immediately upon reaching the goal\n\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T17:02:08.200532", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action over movement actions and avoid revisiting states\n          priority_actions = [4] + list(range(env.world.n_actions))[:-1]\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T17:03:00.403706", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        # Optimize by considering only valid actions (e.g., not walking into walls)\n        for action in range(env.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            # Skip adding unchanged states to the queue\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T17:03:13.485231", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        # Optimize by considering only valid actions (e.g., not walking into walls)\n        for action in range(env.world.n_actions):\n            reward, new_state = current_state.step(action)\n\n            # Skip actions that do not change the state\n            if np.array_equal(new_state.grid, current_state.grid) and \\\n               np.array_equal(new_state.inventory, current_state.inventory) and \\\n               new_state.pos == current_state.pos and \\\n               new_state.dir == current_state.dir:\n                continue\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T17:04:03.988227", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic: count how many primitives are missing\n      cookbook = env.world.cookbook\n      primitive_counts = cookbook.primitives_for(goal_item)\n      \n      missing_primitives = 0\n      for primitive, required in primitive_counts.items():\n          if current_state.inventory[primitive] < required:\n              missing_primitives += required - current_state.inventory[primitive]\n      \n      return missing_primitives\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + initial_state.pos + (initial_state.dir,): 0}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + current_state.pos + (current_state.dir,)] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (tuple(current_state.grid.flatten()), \n                                           tuple(current_state.inventory), \n                                           current_state.pos, \n                                           current_state.dir)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T17:04:04.956464", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # A simple heuristic that could be based on the number of steps taken or other domain-specific knowledge\n      return 0  # Placeholder heuristic, replace with a meaningful one if needed\n\n  def astar_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0 + heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + initial_state.pos: 0}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score.get(tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + current_state.pos, float('inf')) + 1\n              \n              if tentative_g_score < g_score.get(state_hash, float('inf')):\n                  came_from[state_hash] = (current_state, path + [action])\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T17:04:48.456796", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n      valid_neighbors = [(nx, ny) for nx, ny in neighbors if 0 <= nx < env.world.WIDTH and 0 <= ny < env.world.HEIGHT]\n      return valid_neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Consider only valid actions (e.g., don't move out of bounds)\n          for action in range(env.world.n_actions):\n              # Skip USE action if there's nothing to use within the immediate vicinity\n              if action == 4:\n                  neighbors = get_neighbors(current_state.pos)\n                  if not any(current_state.grid[nx, ny].any() for nx, ny in neighbors):\n                      continue\n              \n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(f\"No valid crafting sequence found for item index {item}.\")\n    return []  # Return empty list if no actions found\n  \n  return action_sequence", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-26T17:04:49.435499", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              # Skip USE action if there's nothing to use nearby or the agent is on water or stone.\n              if (action == 4 and not any(\n                  current_state.grid[current_state.pos[0]-1:current_state.pos[0]+2,\n                                     current_state.pos[1]-1:current_state.pos[1]+2].flatten()) or\n                  current_state.grid[current_state.pos] in [env.world.water_index, env.world.stone_index]):\n                  continue\n              \n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(f\"No valid crafting sequence found for item index {item}.\")\n    return []  # Return empty list if no actions found\n  \n  return action_sequence", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-26T17:05:43.845439", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate actions in a more strategic order to prioritize crafting and using items\n          prioritized_actions = [4]  # Prioritize USE action (index 4)\n          non_prioritized_actions = list(range(4))  # Move, turn actions\n\n          for action in prioritized_actions + non_prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is valid and known to the cookbook\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item index {goal_item} is not a valid kind in the cookbook.\")\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T17:05:59.449757", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action to speed up crafting process and move actions to explore the environment\n          prioritized_actions = [4]  # Prioritize USE action (index 4)\n          non_prioritized_actions = list(range(4))  # Move, turn actions\n\n          for action in prioritized_actions + non_prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T17:07:02.538792", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(action, current_state, goal_item):\n      # Higher priority for USE action if an ingredient is next to the agent\n      if action == 4:  # Assuming USE is represented by 4\n          # Check if any of the primitives or ingredients are next to the agent\n          required_ingredients = env.world.cookbook.primitives_for(goal_item)\n          for i_kind in required_ingredients:\n              if current_state.next_to(i_kind):\n                  return 1\n      return 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Use a heuristic to prioritize actions that involve using items (action == USE)\n          use_actions = [4]  # Assuming USE is represented by 4\n          other_actions = list(range(env.world.n_actions))\n          other_actions.remove(4) if 4 in other_actions else None\n\n          all_actions = sorted(use_actions + other_actions, key=lambda action: heuristic(action, current_state, goal_item), reverse=True)\n          \n          for action in all_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Reset the environment to ensure a clean starting point\n  env.reset()\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
