{"timestamp": "2025-06-26T18:48:33.901381", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # A simple heuristic that considers the number of steps taken\n      return len([i for i in range(len(state.inventory)) if state.inventory[i] == 0])\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (heuristic(initial_state, goal_item), 0, initial_state, []))\n      \n      came_from = {}\n      g_score = {hash((tuple(initial_state.grid.flatten()), \n                        tuple(initial_state.inventory), \n                        initial_state.pos, \n                        initial_state.dir)): 0}\n      \n      while open_set:\n          _, current_cost, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions to improve efficiency\n          actions = [4] + list(range(4))  # Prioritize USE action (index 4)\n          \n          for action in actions:\n              reward, new_state = current_state.step(action)\n              \n              if reward < 0:  # Skip invalid actions that incur penalties\n                  continue\n              \n              state_hash = hash((tuple(new_state.grid.flatten()), \n                                 tuple(new_state.inventory), \n                                 new_state.pos, \n                                 new_state.dir))\n              \n              tentative_g_score = g_score[hash(current_state)] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (hash(current_state), action)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + h