{"timestamp": "2025-06-27T12:33:37.132503", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_item):\n      # Estimate the number of steps needed to collect all primitives required for the goal item\n      goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n      current_primitives = {i: state.inventory[i] for i in goal_primitives.keys()}\n      \n      # Calculate the total deficit for each primitive\n      total_deficit = 0\n      for primitive, required_count in goal_primitives.items():\n          current_count = current_primitives.get(primitive, 0)\n          if required_count > current_count:\n              total_deficit += required_count - current_count\n      \n      return total_deficit\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      from collections import defaultdict\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      \n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory): 0}\n      f_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory): heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          current_f_score, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              state_hash = (tuple(new_state.grid.flatten()), tuple(new_state.inventory))\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory)] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-06-27T12:33:38.225649", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_item, cookbook):\n      # Calculate the number of steps needed to collect all primitives required to craft the goal item\n      goal_primitives = get_primitive_counts(goal_item, cookbook)\n      steps_needed = 0\n      \n      for primitive, count in goal_primitives.items():\n          if state.inventory[primitive] < count:\n              steps_needed += (count - state.inventory[primitive])\n      \n      return steps_needed\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item, initial_state.world.cookbook), \n                                  initial_state, []))\n      came_from = {}\n      g_score = {tuple((initial_state.grid.flatten(), tuple(initial_state.inventory), initial_state.pos, initial_state.dir)): 0}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[tuple((current_state.grid.flatten(), tuple(current_state.inventory), current_state.pos, current_state.dir))] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, action)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item, initial_state.world.cookbook)\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-27T12:35:52.461833", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient != \"_key\":\n            dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    from itertools import product\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n\n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      valid_actions = []\n      pickup_actions = []\n      \n      for dx, dy in product([-1, 0, 1], repeat=2):\n          x, y = current_state.pos[0] + dx, current_state.pos[1] + dy\n          if (0 <= x < current_state.grid.shape[0] and \n              0 <= y < current_state.grid.shape[1] and \n              not (dx == 0 and dy == 0)):\n              cell_contents = np.nonzero(current_state.grid[x, y])[0]\n              for kind in cell_contents:\n                  if kind not in current_state.world.non_grabbable_indices:\n                      action = compute_pickup_action(dx, dy)\n                      pickup_actions.append((kind, action))\n\n      # Prioritize use actions that could contribute to making the goal item\n      use_actions = []\n      for dx, dy in product([-1, 0, 1], repeat=2):\n          x, y = current_state.pos[0] + dx, current_state.pos[1] + dy\n          if (0 <= x < current_state.grid.shape[0] and \n              0 <= y < current_state.grid.shape[1]):\n              cell_contents = np.nonzero(current_state.grid[x, y])[0]\n              for kind in cell_contents:\n                  action = compute_use_action(dx, dy)\n                  use_actions.append((kind, action))\n      \n      # Filter pickup actions based on inventory and required primitives\n      for _, action in pickup_actions:\n          reward, new_state = current_state.step(action)\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n              if new_state.inventory[primitive] < count:\n                  can_make_goal = False\n                  break\n          \n          if can_make_goal:\n              valid_actions.append(action)\n      \n      # Add all use actions to the list of valid actions\n      for _, action in use_actions:\n          valid_actions.append(action)\n\n      # Prioritize actions that could lead to making the goal item\n      for action in valid_actions:\n        reward, new_state = current_state.step(action)\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def compute_pickup_action(dx, dy):\n      if dx == -1 and dy == 0:  # left\n          return 0\n      elif dx == 1 and dy == 0:   # right\n          return 2\n      elif dx == 0 and dy == -1:  # down\n          return 3\n      elif dx == 0 and dy == 1:   # up\n          return 4\n      else:\n          raise ValueError(\"Invalid direction for pickup action\")\n\n  def compute_use_action(dx, dy):\n      if dx == -1 and dy == 0:  # left\n          return 5\n      elif dx == 1 and dy == 0:   # right\n          return 7\n      elif dx == 0 and dy == -1:  # down\n          return 8\n      elif dx == 0 and dy == 1:   # up\n          return 6\n      else:\n          raise ValueError(\"Invalid direction for use action\")\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is a valid index and exists in the cookbook\n  if goal_item < 0 or goal_item >= len(env.world.cookbook.index.ordered_contents):\n    raise ValueError(f\"Invalid goal item index: {goal_item}\")\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
