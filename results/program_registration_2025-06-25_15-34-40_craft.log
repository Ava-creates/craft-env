rn priority + move_actions\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-06-26T10:33:26.862559", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action and then prioritize movement actions based on proximity to required items\n          for action in prioritize_actions(env.world, env._current_state, current_state, goal_item):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Avoid revisiting states that have been visited with the same inventory and position\n              state_key = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos)\n              if state_key not in visited:\n                  visited.add(state_key)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_actions(world, initial_state, current_state, goal_item):\n      \"\"\"Prioritize actions based on heuristics and proximity to required items.\"\"\"\n      priority = []\n      \n      # Always try to USE first\n      priority.append(4)\n      \n      # Identify required items for the goal\n      primitives_needed = world.cookbook.primitives_for(goal_item)\n      \n      # Calculate distances from the current position to all primitives needed in the inventory\n      dists_to_primitives = {}\n      for primitive_index, count in primitives_needed.items():\n          if current_state.inventory[primitive_index] < count:\n              dists_to_primitives[primitive_index] = float('inf')\n              for x in range(world.world.width):\n                  for y in range(world.world.height):\n                      if initial_state.grid[x, y, primitive_index] > 0:\n                          # Manhattan distance to the closest cell containing the required primitive\n                          dists_to_primitives[primitive_index] = min(dists_to_primitives[primitive_index], \n                                                                    abs(x - current_state.pos[0]) + abs(y - current_state.pos[1]))\n      \n      # Prioritize movement actions based on proximity to the closest required item\n      move_actions = list(range(4))\n      move_actions.sort(key=lambda action: dists_to_primitives.get(next(iter(dists_to_primitives)), float('inf')))\n      \n      return priority + move_actions\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
