{"timestamp": "2025-06-27T03:00:24.170370", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          # Check if the new state is different from the current state\n          if (not np.array_equal(new_state.grid, state.grid) or \n              not np.array_equal(new_state.inventory, state.inventory) or \n              new_state.pos != state.pos or \n              new_state.dir != state.dir):\n              valid_actions.append(action)\n      return valid_actions\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: distance to the nearest required item\n      if satisfies_goal(state, goal_item):\n          return 0\n      \n      # Find all positions of items needed for crafting the goal\n      required_items = env.world.cookbook.primitives_for(goal_item)\n      positions = np.argwhere(state.grid.sum(axis=2) > 0)\n      \n      min_distance = float('inf')\n      for pos in positions:\n          x, y = pos\n          for i_kind in required_items.keys():\n              if state.grid[x, y, i_kind] > 0:\n                  # Calculate Manhattan distance to the nearest item needed\n                  distances = [abs(x - p[0]) + abs(y - p[1]) for p in positions if state.grid[p[0], p[1], i_kind] > 0]\n                  min_distance = min(min_distance, min(distances))\n      \n      return min_distance\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in get_valid_actions(current_state):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Cost is always 1 for each action\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, path + [action])\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-27T03:00:25.324113", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          # Check if the action changes the grid, inventory, position, or direction\n          if (not np.array_equal(new_state.grid, state.grid) or \n              not np.array_equal(new_state.inventory, state.inventory) or \n              new_state.pos != state.pos or \n              new_state.dir != state.dir):\n              valid_actions.append(action)\n      return valid_actions\n\n  def heuristic(state, goal_item):\n      # Heuristic: the number of items needed for the goal minus items already in inventory\n      if goal_item not in env.world.cookbook.primitives_for(goal_item):\n          return 0\n      return sum(env.world.cookbook.primitives_for(goal_item).values()) - state.inventory[goal_item]\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      \n      g_scores = {initial_state: 0}\n      f_scores = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in get_valid_actions(current_state):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_scores[current_state] + 1\n              \n              if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n                  g_scores[new_state] = tentative_g_score\n                  f_scores[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_scores[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-27T03:01:58.637615", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      seen_primitives = set()  # Track the set of primitives already considered\n      initial_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.inventory)\n          \n          # Check if all required primitives are available\n          if all(primitive in seen_primitives or primitive in current_state.inventory \n                 for primitive in initial_primitives):\n              continue  # Skip this state as it doesn't have new information about primitives\n\n          seen_primitives.update(current_state.inventory)\n\n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n      