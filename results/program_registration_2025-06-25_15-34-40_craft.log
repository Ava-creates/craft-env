{"timestamp": "2025-06-26T06:44:36.980276", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      import itertools\n      \n      # Priority queue with the following items: (priority, count, state, path)\n      priority_queue = []\n      heappush(priority_queue, (0, next(itertools.count()), initial_state, []))\n      \n      visited = set()\n      \n      while priority_queue:\n          _, __, current_state, path = heappop(priority_queue)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  \n                  # Calculate priority based on estimated distance to goal (heuristic + cost so far)\n                  priority = len(path) + heuristic(new_state, goal_item)\n                  heappush(priority_queue, (priority, next(itertools.count()), new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: count the missing ingredients for the goal item\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = {env.world.cookbook.index[i]: state.inventory[i] for i in range(env.world.n_kinds) if state.inventory[i] > 0}\n      \n      missing_count = 0\n      for primitive, required_count in primitives.items():\n          current_count = current_inventory.get(primitive, 0)\n          missing_count += max(0, required_count - current_count)\n      \n      return missing_count\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T06:45:21.513232", "function_name": "craft", "function_body": "  def is_goal_satisfied(state):\n      return state.satisfies(\"dummy_goal_name\", item)\n\n  # BFS with priority on states that are closer to the goal\n  current_state = env._current_state\n  queue = [(0, current_state, [])]\n  visited_states = set()\n\n  while queue:\n      steps_taken, current_state, actions_taken = queue.pop(0)\n\n      # Check if the goal is satisfied in the current state\n      if is_goal_satisfied(current_state):\n          return actions_taken\n\n      # Get the next possible states by taking each action\n      for action in range(env.world.n_actions):  # Assuming there are n_actions available actions\n          reward, new_state = current_state.step(action)\n\n          # Check if the goal is satisfied after the step (early exit)\n          if is_goal_satisfied(new_state):\n              return actions_taken + [action]\n\n          # Create a unique hashable representation of the state to check if it's visited\n          state_representation = (tuple(new_state.grid.flatten()), \n                                  tuple(new_state.pos), \n                                  new_state.dir)\n          \n          if state_representation not in visited_states:\n              visited_states.add(state_representation)\n              queue.append((steps_taken + 1, new_state, actions_taken + [action]))\n\n      # Sort the queue to prioritize states with fewer steps taken\n      queue.sort(key=lambda x: x[0])\n\n  # Return an empty list or a specific action sequence indicating failure to find a solution\n  return []", "island_id": 0, "scores": {"3": 1.5}}
