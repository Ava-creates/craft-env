{"timestamp": "2025-06-26T13:11:15.577545", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=None):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        if max_depth is not None and len(path) >= max_depth:\n            continue\n        \n        # Prioritize USE actions to speed up crafting\n        use_actions = [4]  # Assuming USE action is indexed as 4\n        other_actions = list(set(range(env.world.n_actions)) - set(use_actions))\n        \n        for action in use_actions + other_actions:\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def collect_primitives(env, initial_state, goal_item):\n    cookbook = env.world.cookbook\n    primitives_needed = cookbook.primitives_for(goal_item)\n    \n    action_sequence = []\n    \n    for primitive in primitives_needed:\n        primitive_index = next(iter(primitives_needed))\n        \n        # Collect the primitive\n        collect_action_sequence = bfs_search(initial_state, primitive_index, max_depth=20)  # Limit depth to 20 steps\n        if not collect_action_sequence:\n            return None  # If we can't collect a required primitive, fail\n        \n        action_sequence.extend(collect_action_sequence)\n        \n        # After collecting, try crafting again\n        new_state = initial_state\n        for action in collect_action_sequence:\n            _, new_state = new_state.step(action)\n    \n    return action_sequence\n\n  def get_neighbors(pos, width, height):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < width - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < height - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def find_path_to_position(initial_state, target_pos):\n    from collections import deque\n    \n    queue = deque([(initial_state.pos, [])])\n    visited = set()\n    \n    while queue:\n        current_pos, path = queue.popleft()\n        \n        if current_pos == target_pos:\n            return path\n        \n        # Get neighboring positions\n        neighbors = get_neighbors(current_pos, env.world.scenario.init_grid.shape[0], env.world.scenario.init_grid.shape[1])\n        \n        for neighbor in neighbors:\n            new_state = initial_state._replace(pos=neighbor)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((neighbor, path + [get_action_to_move(initial_state.pos, neighbor)]))\n    \n    return None  # Return None if no sequence is found\n\n  def get_action_to_move(current_pos, target_pos):\n      x1, y1 = current_pos\n      x2, y2 = target_pos\n      \n      if x1 < x2:\n          return 0  # RIGHT\n      elif x1 > x2:\n          return 3  # LEFT\n      elif y1 < y2:\n          return 1  # DOWN\n      elif y1 > y2:\n          return 2  # UP\n      \n      return None  # No movement needed\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Try crafting the item directly first\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If direct crafting fails, try collecting primitives and then crafting\n      cookbook = env.world.cookbook\n      primitives_needed = cookbook.primitives_for(goal_item)\n      \n      for primitive in primitives_needed:\n          primitive_index = next(iter(primitives_needed))\n          \n          # Find the position of the primitive on the grid\n          primitive_pos = None\n          for x in range(env.world.scenario.init_grid.shape[0]):\n              for y in range(env.world.scenario.init_grid.shape[1]):\n                  if env.world.scenario.init_grid[x, y] == primitive_index:\n                      primitive_pos = (x, y)\n                      break\n              if primitive_pos is not None:\n                  break\n          \n          if not primitive_pos:\n              return []  # If we can't find the required primitive on the grid, fail\n          \n          # Find path to the primitive position\n          move_to_primitive_sequence = find_path_to_position(initial_state, primitive_pos)\n          if not move_to_primitive_sequence:\n              return []  # If we can't reach the required primitive, fail\n          \n          action_sequence.extend(move_to_primitive_sequence)\n          \n          # After reaching the primitive, try collecting it\n          new_state = initial_state\n          for action in move_to_primitive_sequence:\n              _, new_state = new_state.step(action)\n          \n          collect_action_sequence = bfs_search(new_state, goal_item, max_depth=20)  # Limit depth to 20 steps\n          if not collect_action_sequence:\n              return []  # If we can't collect a required primitive, fail\n          \n          action_sequence.extend(collect_action_sequence)\n          \n          # After collecting primitives, try crafting again\n          new_state = initial_state\n          for action in collect_action_sequence:\n              _, new_state = new_state.step(action)\n          \n          craft_action_sequence = bfs_search(new_state, goal_item, max_depth=20)  # Limit depth to 20 steps\n          if not craft_action_sequence:\n              return []  # If no actions found\n      \n          action_sequence.extend(craft_action_sequence)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T13:11:16.615109", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=None):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        if max_depth is not None and len(path) >= max_depth:\n            continue\n        \n        # Prioritize USE actions to speed up crafting\n        use_actions = [4]  # Assuming USE action is indexed as 4\n        other_actions = list(set(range(env.world.n_actions)) - set(use_actions))\n        \n        for action in use_actions + other_actions:\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def collect_primitives(env, initial_state, goal_item):\n    cookbook = env.world.cookbook\n    primitives_needed = cookbook.primitives_for(goal_item)\n    \n    action_sequence = []\n    \n    for primitive in primitives_needed:\n      primitive_index = primitive\n      \n      # Collect the primitive\n      collect_action_sequence = bfs_search(initial_state, primitive_index, max_depth=20)  # Limit depth to 20 steps\n      if not collect_action_sequence:\n          return None  # If we can't collect a required primitive, fail\n      \n      action_sequence.extend(collect_action_sequence)\n      \n      # After collecting, try crafting again\n      new_state = initial_state\n      for action in collect_action_sequence:\n          _, new_state = new_state.step(action)\n    \n    return action_sequence\n\n  def get_neighbors(pos, width, height):\n    x, y = pos\n    neighbors = []\n    if x > 0:\n        neighbors.append((x - 1, y))\n    if x < width - 1:\n        neighbors.append((x + 1, y))\n    if y > 0:\n        neighbors.append((x, y - 1))\n    if y < height - 1:\n        neighbors.append((x, y + 1))\n    return neighbors\n\n  def heuristic(pos1, pos2):\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def astar_search(initial_state, goal_item, max_depth=None):\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, initial_state, []))\n    came_from = {}\n    g_score = {initial_state: 0}\n    f_score = {initial_state: heuristic(initial_state.pos, goal_item)}\n    \n    while open_set:\n        _, current_state, path = heapq.heappop(open_set)\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        if max_depth is not None and len(path) >= max_depth:\n            continue\n        \n        # Prioritize USE actions to speed up crafting\n        use_actions = [4]  # Assuming USE action is indexed as 4\n        other_actions = list(set(range(env.world.n_actions)) - set(use_actions))\n        \n        for action in use_actions + other_actions:\n            reward, new_state = current_state.step(action)\n            \n            tentative_g_score = g_score[current_state] + 1\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                came_from[new_state] = (current_state, action)\n                g_score[new_state] = tentative_g_score\n                f_score[new_state] = tentative_g_score + heuristic(new_state.pos, goal_item)\n                heapq.heappush(open_set, (f_score[new_state], new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Try crafting the item directly first using A*\n  action_sequence = astar_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If direct crafting fails, try collecting primitives and then crafting\n      primitive_action_sequence = collect_primitives(env, initial_state, goal_item)\n      \n      if not primitive_action_sequence:\n          return []  # Return empty list if no actions found\n      \n      action_sequence.extend(primitive_action_sequence)\n      \n      # After collecting primitives, try crafting again\n      new_state = initial_state\n      for action in primitive_action_sequence:\n          _, new_state = new_state.step(action)\n      \n      craft_action_sequence = astar_search(new_state, goal_item, max_depth=20)  # Limit depth to 20 steps\n      if not craft_action_sequence:\n          return []  # Return empty list if no actions found\n      \n      action_sequence.extend(craft_action_sequence)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": -1}}
