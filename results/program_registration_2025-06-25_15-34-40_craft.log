not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_actions(action_sequence):\n      \"\"\"Optimize the action sequence to reduce unnecessary movements.\"\"\"\n      optimized_sequence = []\n      i = 0\n      while i < len(action_sequence):\n          action = action_sequence[i]\n          \n          # Check for consecutive moves in the same direction\n          if action in [0, 1, 2, 3]:  # DOWN, UP, LEFT, RIGHT\n              j = i + 1\n              while j < len(action_sequence) and action_sequence[j] == action:\n                  j += 1\n              \n              optimized_sequence.append(action)\n              i = j\n          else:  # USE action or other actions\n              optimized_sequence.append(action)\n              i += 1\n      \n      return optimized_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      return []  # Return empty list if no actions found\n\n  # Optimize the action sequence\n  optimized_action_sequence = optimize_actions(action_sequence)\n  \n  return optimized_action_sequence", "island_id": 2, "scores": {"3": 0.0}}
