ew_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(pos, goal_item):\n      # Simple Manhattan distance to nearest workshop that has the required item\n      min_distance = float('inf')\n      for x in range(env.world.grid.shape[0]):\n          for y in range(env.world.grid.shape[1]):\n              if env.world.workshop_indices[x, y]:\n                  distance = abs(x - pos[0]) + abs(y - pos[1])\n                  min_distance = min(min_distance, distance)\n      return min_distance\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is a primitive or has a recipe\n  if goal_item not in env.world.cookbook.primitives and goal_item not in env.world.cookbook.recipes:\n      print(f\"Item {goal_item} does not have a recipe or is not a primitive.\")\n      return []\n\n  # Initialize pathfinding with A*\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if not action_sequence:\n      print(\"No valid sequence of actions found to craft the item.\")\n\n  return action_sequence", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:31:25.009095", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos, dir, action):\n      x, y = pos\n      directions = [(0, -1), (1, 0), (0, 1), (-1, 0)]\n      \n      if action < 4:  # Movement actions (DOWN, UP, LEFT, RIGHT)\n          new_dir = action\n          dx, dy = directions[new_dir]\n          new_pos = (x + dx, y + dy)\n          return [new_pos], new_dir\n      elif action == 4:  # USE action\n          return [(x + dx, y + dy) for dx, dy in directions], dir\n      else:\n          raise ValueError(\"Invalid action\")\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 1.5}}
