{"timestamp": "2025-06-27T11:17:21.721022", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        # Collect primitives needed for the goal item\n        goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n        \n        # Filter actions based on available inventory and required primitives\n        for action in range(initial_state.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            if action == 4:  # USE action\n                # Check if the use action can contribute to making the goal item\n                can_make_goal = True\n                for primitive, count in goal_primitives.items():\n                    if new_state.inventory[primitive] < count:\n                        can_make_goal = False\n                        break\n                \n                if not can_make_goal:\n                    continue  # Skip this action as it doesn't help make the goal item\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = []\n  \n  while not satisfies_goal(initial_state, goal_item):\n      path = bfs_search(initial_state, goal_item)\n      \n      if path is None:\n          print(\"No solution found.\")\n          break\n      \n      action_sequence.extend(path)\n      \n      # Apply the found actions to the environment\n      for action in path:\n          reward, done, observations = env.step(action)\n          \n          if done or satisfies_goal(env._current_state, goal_item):\n              return action_sequence\n      \n      initial_state = env._current_state\n\n  return action_sequence if satisfies_goal(env._current_state, goal_item) else []", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T11:17:32.432185", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        # Collect primitives needed for the goal item\n        goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n        \n        # Filter actions based on available inventory and required primitives\n        for action in range(initial_state.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            if action == 4:  # USE action\n                # Check if the use action can contribute to making the goal item\n                can_make_goal = True\n                for primitive, count in goal_primitives.items():\n                    if new_state.inventory[primitive] < count:\n                        can_make_goal = False\n                        break\n                \n                if not can_make_goal:\n                    continue  # Skip this action as it doesn't help make the goal item\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = []\n  max_attempts = 10  # Increase attempts to handle more complex recipes\n  attempts = 0\n      \n  while not satisfies_goal(initial_state, goal_item) and attempts < max_attempts:\n      path = bfs_search(initial_state, goal_item)\n      if path is None:\n          break\n      \n      action_sequence.extend(path)\n      \n      # Apply the found actions to the environment\n      for action in path:\n          reward, done, observations = env.step(action)\n          \n          if done or satisfies_goal(env._current_state, goal_item):\n              return action_sequence\n      \n      initial_state = env._current_state\n      attempts += 1\n\n  # If the goal is not satisfied, try to gather missing primitives\n  if not satisfies_goal(initial_state, goal_item):\n      primitives_needed = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      for primitive, count in primitives_needed.items():\n          while initial_state.inventory[primitive] < count:\n              action_sequence.extend(craft_v2(env, primitive))\n              if env._current_state.inventory[primitive] >= count:\n                  break\n\n  return action_sequence", "island_id": 3, "scores": {}}
{"timestamp": "2025-06-27T11:19:22.860389", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    if goal_index in primitive_counts_cache:\n      return primitive_counts_cache[goal_index]\n    \n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    primitive_counts_cache[goal_index] = primitives\n    return primitives\n\n  def a_star_search(initial_state, goal_item):\n    from heapq import heappush, heappop\n\n    # Priority queue for A*\n    open_set = []\n    heappush(open_set, (0, initial_state, []))\n    \n    # Dictionary to store the cost of reaching each state\n    g_score = {initial_state: 0}\n    \n    while open_set:\n      _, current_state, path = heappop(open_set)\n\n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Prioritize movement actions over USE action\n      sorted_actions = [i for i in range(initial_state.world.n_actions) if i != 4] + [4]\n\n      for action in sorted_actions:\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n\n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        tentative_g_score = g_score[current_state] + 1\n        \n        if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n          g_score[new_state] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal_item)\n          heappush(open_set, (f_score, new_state, path + [action]))\n\n    return None  # Return None if no sequence is found\n\n  def optimize_action_sequence(action_sequence):\n    optimized_sequence = []\n    i = 0\n    while i < len(action_sequence):\n      current_action = action_sequence[i]\n      \n      if current_action == 4:  # USE action\n        use_count = 1\n        while (i + 1 < len(action_sequence) and \n               action_sequence[i + 1] == 4):\n          i += 1\n          use_count += 1\n        optimized_sequence.append(current_action)\n      else:\n        optimized_sequence.append(current_action)\n      \n      i += 1\n    \n    return optimized_sequence\n\n  def heuristic(state, goal_item):\n    # Simple heuristic based on the number of primitives missing to craft the goal item\n    goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n    missing_count = 0\n    for primitive, count in goal_primitives.items():\n      if state.inventory[primitive] < count:\n        missing_count += count - state.inventory[primitive]\n    return missing_count\n\n  # Precompute primitive counts for all items\n  primitive_counts_cache = {}\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if satisfies_goal(initial_state, goal_item):\n    return []  # Goal already satisfied\n\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(\"No sequence found to craft the item.\")\n    return []\n\n  # Optimize the action sequence by merging consecutive USE actions\n  optimized_action_sequence = optimize_action_sequence(action_sequence)\n  \n  return optimized_action_sequence", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-27T11:19:24.122233", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    if goal_index in primitive_counts_cache:\n      return primitive_counts_cache[goal_index]\n    \n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    primitive_counts_cache[goal_index] = primitives\n    return primitives\n\n  def a_star_search(initial_state, goal_item):\n    from heapq import heappush, heappop\n\n    open_set = []\n    heappush(open_set, (0, initial_state, []))\n    closed_set = set()\n\n    while open_set:\n      _, current_state, path = heappop(open_set)\n\n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n\n      sorted_actions = [i for i in range(initial_state.world.n_actions) if i != 4] + [4]\n\n      for action in sorted_actions:\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n\n          if not can_make_goal:\n            continue\n        \n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash in closed_set:\n          continue\n        \n        g_score = len(path) + 1\n        h_score = heuristic(new_state, goal_item)\n        f_score = g_score + h_score\n\n        heappush(open_set, (f_score, new_state, path + [action]))\n        closed_set.add(state_hash)\n\n    return None  # Return None if no sequence is found\n\n  def optimize_action_sequence(action_sequence):\n    optimized_sequence = []\n    i = 0\n    while i < len(action_sequence):\n      current_action = action_sequence[i]\n      \n      if current_action == 4:  # USE action\n        use_count = 1\n        while (i + 1 < len(action_sequence) and \n               action_sequence[i + 1] == 4):\n          i += 1\n          use_count += 1\n        optimized_sequence.append(current_action)\n      else:\n        optimized_sequence.append(current_action)\n      \n      i += 1\n    \n    return optimized_sequence\n\n  def heuristic(state, goal_item):\n    goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n    missing_count = 0\n    for primitive, count in goal_primitives.items():\n      if state.inventory[primitive] < count:\n        missing_count += count - state.inventory[primitive]\n    return missing_count\n\n  # Precompute primitive counts for all items\n  primitive_counts_cache = {}\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if satisfies_goal(initial_state, goal_item):\n    return []  # Goal already satisfied\n\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(\"No sequence found to craft the item.\")\n    return []\n\n  # Optimize the action sequence by merging consecutive USE actions\n  optimized_action_sequence = optimize_action_sequence(action_sequence)\n  \n  return optimized_action_sequence", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-27T11:20:39.725337", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          use_actions = []\n          move_actions = []\n\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      use_actions.append((action, reward, new_state))\n              else:  # Move actions (DOWN, UP, LEFT, RIGHT)\n                  move_actions.append((action, reward, new_state))\n\n          # Prioritize USE actions that contribute to the goal\n          all_actions = sorted(use_actions, key=lambda x: len([k for k, v in get_primitive_counts(x[2].index, initial_state.world.cookbook).items() if v > 0])) + move_actions\n\n          for action, _, new_state in all_actions:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in initial_state.world.cookbook.kinds:\n      raise ValueError(f\"Goal item with index {goal_item} is not recognized.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-27T11:20:50.310808", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Sort actions based on potential to contribute to making the goal item\n          actions = []\n          use_actions = []\n\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if can_make_goal:\n                      use_actions.append((action, reward, new_state))\n              else:\n                  actions.append((action, reward, new_state))\n\n          # Prioritize USE actions that contribute to the goal\n          sorted_actions = sorted(use_actions + actions, key=lambda x: (x[0] != 4, -sum(new_state.inventory[p] >= count for p, count in goal_primitives.items())))\n\n          for action, _, new_state in sorted_actions:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in initial_state.world.cookbook.kinds:\n      raise ValueError(f\"Goal item with index {goal_item} is not recognized.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T11:22:23.260582", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient != \"_key\":\n            dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    from itertools import product\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n\n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n\n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def find_possible_pickups(current_state):\n      possible_actions = []\n      for dx, dy in product([-1, 0, 1], repeat=2):\n          x, y = current_state.pos[0] + dx, current_state.pos[1] + dy\n          if (0 <= x < current_state.grid.shape[0] and \n              0 <= y < current_state.grid.shape[1] and \n              not (dx == 0 and dy == 0)):\n              cell_contents = np.nonzero(current_state.grid[x, y])[0]\n              for kind in cell_contents:\n                  if kind not in current_state.world.non_grabbable_indices:\n                      possible_actions.append((kind, dx, dy))\n      return possible_actions\n\n  def find_possible_use_actions(current_state):\n      possible_actions = []\n      for dx, dy in product([-1, 0, 1], repeat=2):\n          x, y = current_state.pos[0] + dx, current_state.pos[1] + dy\n          if (0 <= x < current_state.grid.shape[0] and \n              0 <= y < current_state.grid.shape[1]):\n              cell_contents = np.nonzero(current_state.grid[x, y])[0]\n              for kind in cell_contents:\n                  possible_actions.append((kind, dx, dy))\n      return possible_actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is a valid index and exists in the cookbook\n  if goal_item < 0 or goal_item >= len(env.world.cookbook.index.ordered_contents):\n    raise ValueError(f\"Invalid goal item index: {goal_item}\")\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T11:22:24.610192", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient != \"_key\":\n            dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    import heapq\n    \n    queue = []  # Priority queue based on cost (number of steps)\n    heapq.heappush(queue, (0, initial_state, []))  # (cost, state, path)\n    visited = set()\n\n    while queue:\n      cost, current_state, path = heapq.heappop(queue)\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n\n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          heapq.heappush(queue, (cost + 1, new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is a valid index and exists in the cookbook\n  if goal_item < 0 or goal_item >= len(env.world.cookbook.index.ordered_contents):\n    raise ValueError(f\"Invalid goal item index: {goal_item}\")\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-27T11:23:57.761784", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      possible_actions.append((action, 'use'))\n              else:\n                  possible_actions.append((action, 'move'))\n          \n          # Prioritize USE actions over MOVE actions based on how many primitives are satisfied\n          def prioritize_action(action_tuple):\n              action, _ = action_tuple\n              reward, new_state = current_state.step(action)\n              if action == 4:  # Only consider USE actions for prioritization\n                  primitives_satisfied = sum(\n                      new_state.inventory[primitive] >= count \n                      for primitive, count in goal_primitives.items()\n                  )\n                  return (-primitives_satisfied,)  # Negative to sort descending\n              return (0,)  # Move actions have priority 0\n      \n          prioritized_actions = [action for action, _ in sorted(possible_actions, key=prioritize_action)]\n          \n          # Filter out moves that don't lead to any progress\n          filtered_actions = []\n          for action in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              if action == 4 or not satisfies_goal(new_state, goal_item):\n                  state_hash = (tuple(new_state.grid.flatten()), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir)\n                  \n                  if state_hash not in visited:\n                      filtered_actions.append((action, new_state))\n                      visited.add(state_hash)\n          \n          for action, new_state in filtered_actions:\n              path_to_goal = bfs_search(new_state, goal_item)\n              \n              if path_to_goal is not None:\n                  return path + [action] + path_to_goal\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
