{"timestamp": "2025-06-26T16:59:07.151023", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic: number of items needed for the goal\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = current_state.inventory\n      \n      cost = 0\n      for prim, required in primitives.items():\n          if current_inventory[prim] < required:\n              cost += (required - current_inventory[prim])\n      \n      return cost\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          f_cost, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              # Skip USE action if there's nothing to use\n              if action == 4 and not any(current_state.grid[current_state.pos[0]-1:current_state.pos[0]+2,\n                                                             current_state.pos[1]-1:current_state.pos[1]+2].flatten()):\n                  continue\n\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  g_cost = len(path) + 1  # Cost is the number of actions taken\n                  h_cost = heuristic(new_state, goal_item)\n                