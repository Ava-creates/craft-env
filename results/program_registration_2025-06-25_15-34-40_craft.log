{"timestamp": "2025-06-27T09:08:52.472411", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def can_make_goal(current_state, goal_primitives):\n      # Check if the current state has enough of each primitive to make the goal item\n      for primitive, required_count in goal_primitives.items():\n          if current_state.inventory[primitive] < required_count:\n              return False\n      return True\n\n  def get_possible_actions(current_state, goal_primitives, cookbook):\n      actions = []\n      # Check USE action first as it is more specific to crafting\n      for ingredient_index in goal_primitives.keys():\n          if ingredient_index in current_state.world.workshop_indices and can_make_goal(current_state, {ingredient_index: goal_primitives[ingredient_index]}):\n              reward, new_state = current_state.step(4)  # USE action\n              if satisfies_goal(new_state, ingredient_index):\n                  actions.append(4)\n      # Check MOVEMENT actions (DOWN, UP, LEFT, RIGHT)\n      for action in range(4):  # Actions 0 to 3 are movement actions\n          reward, new_state = current_state.step(action)\n          actions.append(action)\n      return actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = get_possible_actions(current_state, goal_primitives, initial_state.world.cookbook)\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 0.0}}
