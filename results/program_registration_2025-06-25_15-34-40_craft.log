{"timestamp": "2025-06-26T18:50:42.231919", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n\n      queue = deque([(initial_state, [])])\n      visited = set()\n\n      while queue:\n          current_state, path = queue.popleft()\n\n          if satisfies_goal(current_state, goal_item):\n              return path\n\n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n          # Create a priority list of actions to try based on making progress towards required primitives\n          action_priority = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_use = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_use = False\n                          break\n                  if can_use:\n                      action_priority.append((action, reward, new_state))\n              else:\n                  # Check if the action moves towards obtaining required primitives\n                  for primitive, count in goal_primitives.items():\n                      if current_state.inventory[primitive] < count and new_state.inventory[primitive] > current_state.inventory[primitive]:\n                          action_priority.append((action, reward, new_state))\n\n          # Sort actions by priority: prioritize USE actions that contribute to the goal and then other actions that progress towards primitives\n          action_priority.sort(key=lambda x: (x[0] != 4, -x[1]))\n\n          for action, _, new_state in action_priority:\n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_use = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_use = False\n                          break\n                  if not can_use:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n\n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-06-26T18:52:04.844039", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action (index 4) and avoid repeated actions if possible\n          actions = [4] + list(range(4))\n          last_action = path[-1] if path else None\n          \n          for action in actions:\n              if action == last_action:\n                  continue  # Avoid repeating the same action consecutively\n              \n              reward, new_state = current_state.step(action)\n              \n              # Skip invalid actions that incur penalties\n              if reward < 0:\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(current_state, goal_item):\n      # Implement a heuristic to guide the BFS (e.g., Manhattan distance to nearest required ingredient)\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      min_distance = float('inf')\n      \n      for primitive_idx in primitives:\n          if current_state.next_to(primitive_idx):\n              return 0  # If next to a required primitive, no cost\n      \n      for i in range(env.world.WIDTH):\n          for j in range(env.world.HEIGHT):\n              if any(current_state.grid[i, j] == prim for prim in primitives):\n                  distance = abs(i - current_state.pos[0]) + abs(j - current_state.pos[1])\n                  min_distance = min(min_distance, distance)\n      \n      return min_distance\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  queue = [(initial_state, [], 0)]\n  visited = set()\n  \n  while queue:\n      current_state, path, cost = heapq.heappop(queue)\n      \n      if satisfies_goal(current_state, goal_item):\n          return path\n      \n      actions = [4] + list(range(4))\n      last_action = path[-1] if path else None\n      \n      for action in actions:\n          if action == last_action:\n              continue  # Avoid repeating the same action consecutively\n          \n          reward, new_state = current_state.step(action)\n          \n          # Skip invalid actions that incur penalties\n          if reward < 0:\n              continue\n          \n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          if state_hash not in visited:\n              visited.add(state_hash)\n              heapq.heappush(queue, (cost + heuristic(new_state, goal_item), new_state, path + [action]))\n  \n  return []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:52:05.823562", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action (index 4) and avoid repeated actions if possible\n          actions = [4] + list(range(4))\n          last_action = path[-1] if path else None\n          \n          for action in actions:\n              if action == last_action:\n                  continue  # Avoid repeating the same action consecutively\n              \n              reward, new_state = current_state.step(action)\n              \n              # Skip invalid actions that incur penalties\n              if reward < 0:\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from current state to goal.\"\"\"\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      total_primitives_needed = sum(primitives.values())\n      inventory_count = sum(state.inventory[i] for i in primitives.keys() if i in range(len(state.inventory)))\n      \n      # Estimate based on missing primitive resources\n      return max(total_primitives_needed - inventory_count, 0)\n\n  def astar_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state)\n          \n          # Prioritize USE action (index 4) and avoid repeated actions if possible\n          actions = [4] + list(range(4))\n          last_action = path[-1] if path else None\n          \n          for action in actions:\n              if action == last_action:\n                  continue  # Avoid repeating the same action consecutively\n              \n              reward, new_state = current_state.step(action)\n              \n              # Skip invalid actions that incur penalties\n              if reward < 0:\n                  continue\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state):\n      total_path = []\n      while current_state in came_from:\n          (prev_state, action) = came_from[current_state]\n          total_path.append(action)\n          current_state = prev_state\n      return total_path[::-1]\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start A* search to find the action sequence\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:53:19.097399", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(path, state, goal_item):\n      # A more sophisticated heuristic: prioritize paths that bring the agent closer to having all necessary ingredients\n      cookbook = env.world.cookbook\n      if goal_item in cookbook.recipes:\n          recipe = cookbook.recipes[goal_item]\n          missing_ingredients = sum(\n              count - state.inventory[i_kind] for i_kind, count in recipe.items() \n              if isinstance(i_kind, int)\n          )\n          return -missing_ingredients  # fewer missing ingredients is better\n      else:\n          return 0  # No heuristic value if the item has no recipe\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [], 0)])  # (state, path, cost)\n      visited = set()\n      \n      while queue:\n          current_state, path, cost = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Use a heuristic to prioritize actions that involve using items (action == USE)\n          use_actions = [4]  # Assuming USE is represented by 4\n          other_actions = list(range(env.world.n_actions))\n          other_actions.remove(4) if 4 in other_actions else None\n\n          all_actions = sorted(use_actions + other_actions, key=lambda action: heuristic(path, current_state, goal_item), reverse=True)\n          \n          for action in all_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  \n                  # Calculate the heuristic cost and add to the queue\n                  h_cost = heuristic(path, new_state, goal_item)\n                  total_cost = cost + 1 + h_cost  # Assuming all actions have unit cost of 1 for simplicity\n                  queue.append((new_state, path + [action], total_cost))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Reset the environment to ensure a clean starting point\n  env.reset()\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T18:53:35.820337", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # A simple heuristic: prioritize paths that increase the count of the goal item in inventory\n      # Also consider proximity to ingredients if next to any primitive ingredient\n      base_heuristic = -state.inventory[goal_item]\n      \n      for i_kind in env.world.cookbook.primitives:\n          if state.next_to(i_kind):\n              base_heuristic += 1\n      \n      return base_heuristic\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [], 0)])  # (state, path, cost)\n      visited = set()\n      \n      while queue:\n          current_state, path, cost = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Use a heuristic to prioritize actions that involve using items (action == USE)\n          use_actions = [4]  # Assuming USE is represented by 4\n          other_actions = list(range(env.world.n_actions))\n          other_actions.remove(4) if 4 in other_actions else None\n\n          all_actions = sorted(use_actions + other_actions, key=lambda action: heuristic(current_state, goal_item), reverse=True)\n          \n          for action in all_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  \n                  # Calculate the heuristic cost and add to the queue\n                  h_cost = heuristic(new_state, goal_item)\n                  total_cost = cost + 1 + h_cost  # Assuming all actions have unit cost of 1 for simplicity\n                  queue.append((new_state, path + [action], total_cost))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Reset the environment to ensure a clean starting point\n  env.reset()\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T18:54:27.460093", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: the number of items needed to craft the goal\n      # This can be improved by considering the shortest path in terms of actions\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory.copy()\n      steps_needed = 0\n\n      for primitive, count in primitives.items():\n          while current_inventory[primitive] < count:\n              # Simulate crafting or picking up primitives\n              steps_needed += 1\n              current_inventory[primitive] += 1\n          \n          current_inventory[primitive] -= count\n      \n      return steps_needed\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import collections\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      \n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in [4] + list(set(range(env.world.n_actions)) - {4}):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n\n              tentative_g_score = g_score[current_state] + 1\n              if state_hash not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:54:43.385532", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize using the resource or crafting action\n          for action in [4] + list(set(range(env.world.n_actions)) - {4}):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def retry_bfs_search(env, goal_item, max_retries=3):\n      for _ in range(max_retries):\n          env.reset()\n          initial_state = env._current_state\n          action_sequence = bfs_search(initial_state, goal_item)\n          if action_sequence:\n              return action_sequence\n      return None\n\n  def prioritize_pickup_actions(action_sequence):\n      # Prioritize picking up resources over movement actions\n      pickup_actions = [action for action in action_sequence if action == 4]\n      other_actions = [action for action in action_sequence if action != 4]\n      return pickup_actions + other_actions\n\n  goal_item = item\n  action_sequence = retry_bfs_search(env, goal_item)\n\n  if not action_sequence:\n      return []  # Return empty list if no actions found\n  \n  # Prioritize the order of actions to optimize resource gathering\n  optimized_action_sequence = prioritize_pickup_actions(action_sequence)\n  \n  return optimized_action_sequence", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-06-26T18:55:37.604272", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              # Skip USE action if there's nothing to use in the 3x3 grid around the agent\n              if action == 4:\n                  neighborhood = current_state.grid[\n                      max(0, current_state.pos[0]-1):min(env.scenario.init_grid.shape[0], current_state.pos[0]+2),\n                      max(0, current_state.pos[1]-1):min(env.scenario.init_grid.shape[1], current_state.pos[1]+2)\n                  ]\n                  if not any(neighborhood.flatten()):\n                      continue\n              \n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
